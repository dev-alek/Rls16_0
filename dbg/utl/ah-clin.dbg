      352   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   define variable v-waitfram-action01         as character   no-undo .
      354   define variable v-waitfram-action02         as character   no-undo .
      355   define variable v-waitfram-action03         as character   no-undo .
      356   define variable mWaitFramTextBeg            as character   no-undo.
      357   define variable mWaitFramTextEnd            as character   no-undo.
      358   define variable mWaitFramView               as logical     no-undo.
      359   define variable mWaitProcEvent              as logical     no-undo init yes.
      360   define variable mWaitFramInterval           as integer     no-undo init 1 .
      361   define variable mWaitFramStop               as logical     no-undo.
      362   define variable mWaitFramStopUser           as logical     no-undo.
      363   define variable mWaitFramStopTimeOut        as logical     no-undo.
      364   define variable mWaitFramStartProc          as datetime-tz no-undo.
      365   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      366   define button B-WaitFramStop auto-end-key
      367        label "Стоп"
      368        size 10 by 1 tooltip "Остоновить процесс".
      369   define button B-viewProcInfo
      370        label "Информация"
      371        size 15 by 1 tooltip "Информация о процесс".
      372   define frame waitfram
      373     v-waitfram-action01 format "x(72)" no-label skip
      374     v-waitfram-action02 format "x(72)" no-label skip
      375     v-waitfram-action03 format "x(72)" no-label skip
      376     B-viewProcInfo
      377     B-WaitFramStop at row 4 col 30
      378     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      379     .
      380   define new global shared variable mBatchMode as logical no-undo init ?.
      381   define variable mFramBachModHandle as handle no-undo.
      382   mFramBachModHandle = frame waitfram:handle.
      383   define variable mFameOldVis as logical no-undo.
      384   define variable mVisCUrentVin as logical no-undo.
      385   if session:batch-mode
      386   then
      387      mBatchMode = yes.
      388   if mBatchMode = ? then do:
      389     mVisCUrentVin = current-window:visible.
      390     mFameOldVis = mFramBachModHandle:visible.
      391     mFramBachModHandle:visible  = yes.
      392     mBatchMode = mFramBachModHandle:visible ne yes.
      393     mFramBachModHandle:visible = mFameOldVis.
      394     current-window:visible = mVisCUrentVin.
      395   end.
      396    if  log-manager:logfile-name ne ?
      397     then DO:
      398         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      399         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      400         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      401     end.
      402   on choose of B-WaitFramStop in frame waitfram
      403   do:
      404     mWaitFramStop = yes.
      405     mWaitFramStopUser = yes.
      406   end.
      407   function waitfram-check-timeout returns logical():
      408      define variable vtime as int64 no-undo.
      409      if mWaitFramStopTimeOut
      410      then
      411         return yes.
      412      vtime = ( now - mWaitFramStartProc ) / 1000 .
      413      if     mWaitFramTimeOut ne ?
      414         and mWaitFramTimeOut ne 0
      415         and mWaitFramTimeOut lt vtime
      416      then do:
      417         mWaitFramStopTimeOut = yes.
      418      end.
      419      return mWaitFramStopTimeOut.
      420   end.
      421   procedure waitfram-hide :
      422     if not session:batch-mode
      423     then do
      424     on error undo, return error return-value
      425     :
      426       pause 0 before-hide .
      427       if not mBatchMode then
      428         hide frame waitfram .
      429     if     not mWaitFramView
      430        and mWaitProcEvent
      431     then
      432       process events .
      433     end.
      434   end procedure.
      435   procedure waitfram-show :
      436     define input  parameter p-message as character no-undo .
      437     define variable v-left-margin as integer   no-undo .
      438     if not session:batch-mode
      439     then do
      440     on error undo, return error return-value
      441     :
      442       if length(p-message) <= 70 then do:
      443         assign
      444           v-left-margin = integer((70 - length(p-message)) / 2)
      445         .
      446         assign
      447           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      448         .
      449         assign
      450           v-waitfram-action01 = " "
      451           v-waitfram-action02 = " "
      452                                    + fill(" ", v-left-margin)
      453                                    + p-message
      454           v-waitfram-action03 = " "
      455         .
      456       end.
      457       else do:
      458         define variable vRindex1 as integer no-undo.
      459         define variable vRindex2 as integer no-undo.
      460         vRindex1 = r-index(p-message," ",70).
      461         if vRindex1 = 0
      462         then
      463            vRindex1 = 70.
      464         if length(p-message)  <= vRindex1 + 70 then do:
      465           assign
      466             v-waitfram-action01 = " "
      467             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      468             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      469           .
      470         end.
      471         else do:
      472           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      473           if vRindex2 <= vRindex1
      474           then
      475              vRindex2 = vRindex1 + 70.
      476           assign
      477             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      478             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      479             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      480           .
      481         end.
      482       end.
      483       B-viewProcInfo:visible   in frame waitfram = no.
      484       B-viewProcInfo:sensitive in frame waitfram = no.
      485       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      486       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      487       if  (   mWaitFramView
      488          or  mWaitProcEvent)
      489          and not mBatchMode
      490       then
      491          display
      492             v-waitfram-action01 skip
      493             v-waitfram-action02 skip
      494             v-waitfram-action03 skip
      495          with frame waitfram .
      496       if     mWaitFramView
      497          then do:
      498             if     mWaitFramInterval ne ?
      499                and not mBatchMode
      500             then
      501                wait-for go of frame waitfram pause mWaitFramInterval.
      502          end.
      503          else
      504             if     mWaitProcEvent
      505                and not mBatchMode
      506             then
      507                process events .
      508     end.
      509   end procedure.
      510      procedure waitfram-show-this:
      511         define input  parameter iInterval as int64 no-undo.
      512         define variable vtime as int64 no-undo.
      513         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      514         mWaitFramInterval = iInterval.
      515         run waitfram-show (substitute("&1&2 &3&4" ,
      516                                       mWaitFramTextBeg ,
      517                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      518                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      519                                       mWaitFramTextEnd
      520                                      )
      521                           ).
      522      end.
      523      procedure WaitFramRunPause:
      524         define input  parameter iInterval as dec no-undo.
      525         define variable vStart  as datetime-tz no-undo.
      526         define variable vend    as datetime-tz no-undo.
      527         define variable vint as int64 no-undo.
      528         define variable vOk as logical no-undo.
      529         vStart = now.
      530         vend   = vStart.
      531         publish "WaitFramPause" (iInterval,output vOk).
      532         vend   =  now.
      533         vint = vend - vStart.
      534         vint = iInterval - vint / 1000.
      535         if     not mWaitFramStop
      536            and (   vint > 0
      537                 or (    not vOk
      538                     and iInterval eq ?
      539                     )
      540                 )
      541         then
      542            run waitfram-show-this (iInterval).
      543         vend   =  now.
      544         vint = vend - vStart.
      545         vint = iInterval - vint / 1000.
      546         if     not mWaitFramStop
      547            and vint > 0
      548         then do:
      549            run gbl/pause.p (vint * 1000).
      550         end.
      551         if iInterval ne ?
      552         then
      553            publish "WaitFramStop".
      554         waitfram-check-timeout().
      555      end.
      556      procedure WaitFramWaitFor:
      557         define input  parameter iInterval as dec no-undo.
      558         assign
      559            mWaitFramStartProc   = now
      560            mWaitFramStopUser    = no
      561            mWaitFramStopTimeOut = no
      562         .
      563         block-wait:
      564         do while not mWaitFramStop:
      565            run WaitFramRunPause (iInterval).
      566            if  waitfram-check-timeout()
      567            then do:
      568               leave block-wait.
      569            end.
      570         end.
      571         run waitfram-hide.
      572      end.
      573   procedure waitfram-join :
      574     define input  parameter p-line-1  as character no-undo .
      575     define input  parameter p-line-2  as character no-undo .
      576     define input  parameter p-line-3  as character no-undo .
      577     define output parameter p-message as character no-undo .
      578     do
      579     on error undo, return error return-value
      580     :
      581       assign
      582         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      583                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      584                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      585       .
      586     end.
      587   end procedure.
      588   function waitfram-join-function returns character
      589     (input p-line-1 as character
      590     ,input p-line-2 as character
      591     ,input p-line-3 as character
      592     ).
      593     define variable v-message as character no-undo .
      594     run waitfram-join in this-procedure
      595       (input  p-line-1
      596       ,input  p-line-2
      597       ,input  p-line-3
      598       ,output v-message
      599       ) .
      600     return v-message .
      601   end function .
      602   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603     define variable v-cntxt-db-num        as integer   no-undo .
      604     define variable v-cntxt-userid        as character no-undo .
      605     define variable v-cntxt-level         as character no-undo .
      606     define variable v-cntxt-host-code-obj as integer   no-undo .
      607     define variable v-cntxt-obj-type      as character no-undo .
      608     define variable v-cntxt-obj-code      as integer   no-undo .
      609     define variable v-cntxt-db-num-obj    as integer   no-undo .
      610     define variable v-cntxt-is-admin      as logical   no-undo .
      611   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   define temp-table userobjs_temp-user-obj no-undo
      613     field obj-type as character
      614     field obj-code as integer
      615     index xpk is primary unique obj-type obj-code
      616     .
      617   procedure userobjs_clear :
      618     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      619     do
      620     on error undo, return error return-value
      621     :
      622       for each buf_userobjs_temp-user-obj
      623       on error undo, return error return-value
      624       :
      625         delete buf_userobjs_temp-user-obj .
      626       end.
      627     end.
      628   end .
      629   procedure userobjs_object-count :
      630     define output parameter p-total-count as integer   no-undo .
      631     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      632     do
      633     on error undo, return error return-value
      634     :
      635       assign
      636         p-total-count = 0
      637       .
      638       for each buf_userobjs_temp-user-obj
      639       on error undo, return error return-value
      640       :
      641         assign
      642           p-total-count = p-total-count + 1
      643         .
      644       end.
      645     end.
      646   end.
      647   procedure userobjs_append :
      648      define input  parameter p-obj-type as character no-undo .
      649      define input  parameter p-obj-code as integer   no-undo .
      650     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      651     do
      652     on error undo, return error return-value
      653     :
      654       find first buf_userobjs_temp-user-obj
      655         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      656           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      657         no-error .
      658       if not available buf_userobjs_temp-user-obj
      659       then do:
      660         create buf_userobjs_temp-user-obj .
      661         assign
      662           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      663           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      664         .
      665       end.
      666     end.
      667   end.
      668   procedure userobjs_object-exist :
      669     define output parameter p-object-exist as logical   no-undo .
      670     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      671     do
      672     on error undo, return error return-value
      673     :
      674       find first buf_userobjs_temp-user-obj
      675         no-error .
      676       if not available buf_userobjs_temp-user-obj
      677       then do:
      678         assign
      679           p-object-exist = false
      680         .
      681       end.
      682       else do:
      683         assign
      684           p-object-exist = true
      685         .
      686       end.
      687     end.
      688   end.
      689   procedure userobjs_transfer :
      690     define input  parameter p-callback-handle as handle no-undo .
      691     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      692     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      693     do
      694     on error undo, return error return-value
      695     :
      696       if valid-handle(p-callback-handle) <> true
      697       then do:
      698         message
      699           vss-workfile vss-revision vss-description skip
      700           "Ошибка задания входных параметров" skip
      701           "Неизвестный указатель на процедуру" skip
      702           view-as alert-box error .
      703         undo, return error return-value .
      704       end.
      705       if p-callback-handle :get-signature("userobjs_append") = ""
      706       then do:
      707         message
      708           vss-workfile vss-revision vss-description skip
      709           "Ошибка задания входных параметров" skip
      710           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      711                     ,p-callback-handle :file-name
      712                     ) skip
      713           view-as alert-box error .
      714         undo, return error return-value .
      715       end.
      716       for each buf_userobjs_temp-user-obj
      717       on error undo, return error return-value
      718       :
      719         run userobjs_append in p-callback-handle
      720           (input  buf_userobjs_temp-user-obj.obj-type
      721           ,input  buf_userobjs_temp-user-obj.obj-code
      722           ) .
      723       end.
      724     end.
      725   end procedure.
      726   procedure userobjs_select-one :
      727      define input  parameter parparentproc     as widget-handle no-undo .
      728      define input  parameter p-db-num          as integer   no-undo .
      729      define input  parameter p-user-id         as character no-undo .
      730      define input  parameter p-host-code-obj   as integer   no-undo .
      731      define input  parameter p-obj-type        as character no-undo .
      732      define input  parameter p-obj-code        as integer   no-undo .
      733      define output parameter p-user-select     as logical   no-undo .
      734      define output parameter p-select-obj-type as character no-undo .
      735      define output parameter p-select-obj-code as character no-undo .
      736     do
      737     on error undo, return error return-value
      738     :
      739       run gbl/userobjs.w
      740         (input  parparentproc
      741         ,input  this-procedure :handle
      742         ,input  p-db-num
      743         ,input  p-user-id
      744         ,input  p-host-code-obj
      745         ,input  p-obj-type
      746         ,input  p-obj-code
      747         ,INPUT  "b-sel"
      748         ,output p-user-select
      749         ,output p-select-obj-type
      750         ,output p-select-obj-code
      751         ) .
      752     end.
      753   end.
      754   procedure userobjs_select-many :
      755     define input  parameter parparentproc   as widget-handle no-undo .
      756     define input  parameter p-db-num        as integer   no-undo .
      757     define input  parameter p-user-id       as character no-undo .
      758     define input  parameter p-host-code-obj as integer   no-undo .
      759     define input  parameter p-obj-type      as character no-undo .
      760     define input  parameter p-obj-code      as integer   no-undo .
      761     define output parameter p-user-select   as logical   no-undo .
      762     define variable v-select-obj-type as character no-undo .
      763     define variable v-select-obj-code as integer   no-undo .
      764     do
      765     on error undo, return error return-value
      766     :
      767       run gbl/userobjs.w
      768         (input  parparentproc
      769         ,input  this-procedure :handle
      770         ,input  p-db-num
      771         ,input  p-user-id
      772         ,input  p-host-code-obj
      773         ,input  p-obj-type
      774         ,input  p-obj-code
      775         ,INPUT  "b-sel,b-mark"
      776         ,output p-user-select
      777         ,output v-select-obj-type
      778         ,output v-select-obj-code
      779         ) .
      780     end.
      781   end.
      782   procedure thobjs :
      783      define input        parameter parparentproc     as widget-handle no-undo .
      784      define input        parameter i-bttns           as character     no-undo .
      785      define input        parameter i-list-mode       as character     no-undo.
      786      define input        parameter i-obj-type        as character     no-undo.
      787      define input        parameter i-db-num          as integer       no-undo.
      788      define input        parameter i-host-code       as integer       no-undo.
      789      define input-output parameter p-rid-list        as character     no-undo .
      790   run ref/thobjs.p
      791           ( input parparentproc
      792            ,input  this-procedure :handle
      793           , input i-bttns
      794           , input i-list-mode
      795           , input i-obj-type
      796           , input i-db-num
      797           , input i-host-code
      798           , input-output p-rid-list ) no-error .
      799   end.
      800   define variable v-all-object    as logical   no-undo .
      801   define variable v-total-process as integer   no-undo .
      802   do
      803   on error undo, return error
      804   :
      805     define variable v-num as integer   no-undo .
      806   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      807     run mainmenu_getcntxt in parparentproc
      808       (output v-cntxt-db-num
      809       ,output v-cntxt-userid
      810       ,output v-cntxt-level
      811       ,output v-cntxt-host-code-obj
      812       ,output v-cntxt-obj-type
      813       ,output v-cntxt-obj-code
      814       ,output v-cntxt-db-num-obj
      815       ,output v-cntxt-is-admin
      816       ) .
      817     run gbl/d-askw.w
      818       (input "Вопрос 1/3"
      819       ,input "Пометить складские архивы, как нерассчитанные" + chr(10)
      820       ,input "|^"
      821       ,input "Все объекты^confirm|Выбрать объекты|Отмена"
      822       ,input "|"
      823           + "|"
      824           + ""
      825       ,input 1
      826       ,input 3
      827       ,output v-num
      828       ).
      829     case v-num :
      830       when 1
      831       then do:
      832         assign
      833           v-all-object = true
      834         .
      835       end.
      836       when 2
      837       then do:
      838         define variable v-user-select as logical   no-undo .
      839   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      840   run userobjs_select-many in this-procedure
      841     (input  parparentproc
      842     ,input  v-cntxt-db-num
      843     ,input  v-cntxt-userid
      844     ,input  v-cntxt-host-code-obj
      845     ,input  v-cntxt-obj-type
      846     ,input  v-cntxt-obj-code
      847     ,output v-user-select
      848     )  .
      849         if v-user-select <> true
      850         then do:
      851           message
      852             "Объект не выбран"
      853             view-as alert-box information .
      854           return .
      855         end.
      856         assign
      857           v-all-object = false
      858         .
      859       end.
      860       otherwise do:
      861         return .
      862       end.
      863     end.
      864     run gbl/d-askw.w
      865       (input "Вопрос 2/3"
      866       ,input "Пометить складские архивы как требующие первоначального расчета"
      867       ,input "|^"
      868       ,input "Складской архив по товарам" + '|':u
      869         + "Складской архив по поставщикам" + '|':u
      870         + "Складской архив по типам приобретения" + '|':u
      871         + "Отказ"
      872       ,input '|':u
      873         + '|':u
      874         + '|':u
      875         + ''
      876       ,input 1
      877       ,input 4
      878       ,output v-num
      879       ).
      880     define variable v-calc-arh  as logical   no-undo .
      881     define variable v-calc-ahsp as logical   no-undo .
      882     define variable v-calc-aht as logical   no-undo .
      883     assign
      884       v-calc-arh  = false
      885       v-calc-ahsp = false
      886       v-calc-aht  = false
      887     .
      888     case v-num :
      889       when 1
      890       then do:
      891         assign
      892           v-calc-arh = true
      893         .
      894       end.
      895       when 2
      896       then do:
      897         assign
      898           v-calc-ahsp = true
      899         .
      900       end.
      901       when 3
      902       then do:
      903         assign
      904           v-calc-aht = true
      905         .
      906       end.
      907       when 4
      908       then do:
      909         return .
      910       end.
      911       otherwise do:
      912         message
      913           vss-workfile vss-revision vss-description skip
      914           "Ошибка при выборе" skip
      915           "Неизвестная опция" v-num skip
      916           view-as alert-box error .
      917         undo, return error .
      918       end.
      919     end case .
      920     run gbl/d-askw.w
      921       (input "Вопрос 3/3"
      922       ,input "Пометить складские архивы"
      923       ,input "|^"
      924       ,input "Как требующие инициализации и первоначального расчета" + '|':u
      925         + "Как требующие первоначального расчета" + '|':u
      926         + "Отказ"
      927       ,input '|':u
      928         + '|':u
      929         + ''
      930       ,input 1
      931       ,input 3
      932       ,output v-num
      933       ).
      934     define variable v-mark-del  as logical   no-undo .
      935     define variable v-mark-calc as logical   no-undo .
      936     assign
      937       v-mark-del  = false
      938       v-mark-calc = false
      939     .
      940     case v-num :
      941       when 1
      942       then do:
      943         assign
      944           v-mark-del  = true
      945           v-mark-calc = true
      946         .
      947       end.
      948       when 2
      949       then do:
      950         assign
      951           v-mark-calc = true
      952         .
      953       end.
      954       when 3
      955       then do:
      956         return .
      957       end.
      958       otherwise do:
      959         message
      960           vss-workfile vss-revision vss-description skip
      961           "Ошибка при выборе" skip
      962           "Неизвестная опция" v-num skip
      963           view-as alert-box error .
      964         undo, return error .
      965       end.
      966     end case .
      967     define variable v-ok as logical   no-undo .
      968     assign
      969       v-ok = false
      970     .
      971     message
      972       "ВНИМАНИЕ!" skip
      973       "Это последний вопрос перед выполнением операции." skip
      974       "Складские архивы будут помечены, как нерассчитанные." skip
      975       "Если у вас уже были рассчитанные складские архивы, то после выполнения данной" skip
      976       "операции вы не сможете собирать отчеты." skip
      977       "" skip
      978       "Объекты" skip
      979       "" ( if v-all-object  = true then "ВСЕ" else "Выбранные" ) skip
      980       "" skip
      981       "Складские архивы" skip
      982       "" ( if v-calc-arh  = true then "Складской архив по товарам"            else "" ) skip
      983       "" ( if v-calc-ahsp = true then "Складской архив по поставщикам"        else "" ) skip
      984       "" ( if v-calc-aht  = true then "Складской архив по типам приобретения" else "" ) skip
      985       "" skip
      986       "Будут установлены следующие атрибуты:" skip
      987       "" ( if v-mark-del  = true then "Необходима инициализации"             else "" ) skip
      988       "" ( if v-mark-calc = true then "Необходим расчет"                     else "" ) skip
      989       view-as alert-box question buttons yes-no update v-ok .
      990     if v-ok <> true
      991     then do:
      992       return .
      993     end.
      994     define buffer buf_sys-ctrl for ub.sys-ctrl .
      995     define buffer buf_db       for ub.db .
      996     define buffer buf_clients  for ub.clients .
      997     find first buf_sys-ctrl .
      998     if v-all-object = true
      999     then do:
     1000       for each buf_db
     1001         where (buf_sys-ctrl.db-num = 0
     1002               or
     1003               buf_db.db-num = buf_sys-ctrl.db-num
     1004               )
     1005       ,each buf_clients no-lock
     1006         where buf_clients.db-num = buf_db.db-num
     1007       on error undo, return error
     1008       :
     1009         run process-object in this-procedure
     1010           (input buf_clients.obj-type
     1011           ,input buf_clients.obj-code
     1012           ,input v-calc-arh
     1013           ,input v-calc-ahsp
     1014           ,input v-calc-aht
     1015           ,input v-mark-calc
     1016           ,input v-mark-del
     1017           ) .
     1018       end.
     1019     end.
     1020     else do:
     1021       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1022       for each buf_userobjs_temp-user-obj
     1023       on error undo, return error return-value
     1024       :
     1025         find first buf_clients no-lock
     1026           where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     1027             and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     1028           .
     1029         if buf_sys-ctrl.db-num = 0
     1030         or buf_clients.db-num = buf_sys-ctrl.db-num
     1031         then do:
     1032           run process-object in this-procedure
     1033             (input buf_clients.obj-type
     1034             ,input buf_clients.obj-code
     1035             ,input v-calc-arh
     1036             ,input v-calc-ahsp
     1037             ,input v-calc-aht
     1038             ,input v-mark-calc
     1039             ,input v-mark-del
     1040             ) .
     1041         end.
     1042       end.
     1043     end.
     1044     run waitfram-hide in this-procedure
     1045       .
     1046     message
     1047       "Простановка атрибутов завершена" skip
     1048       "" skip
     1049       "Обработано объектов" v-total-process skip
     1050       "" skip
     1051       "Объекты" skip
     1052       "" ( if v-all-object  = true then "ВСЕ" else "Выбранные" ) skip
     1053       "" skip
     1054       "Складские архивы" skip
     1055       "" ( if v-calc-arh  = true then "Складской архив по товарам"            else "" ) skip
     1056       "" ( if v-calc-ahsp = true then "Складской архив по поставщикам"        else "" ) skip
     1057       "" ( if v-calc-aht  = true then "Складской архив по типам приобретения" else "" ) skip
     1058       "" skip
     1059       "Были установлены следующие атрибуты:" skip
     1060       "" ( if v-mark-del  = true then "Необходима инициализации"             else "" ) skip
     1061       "" ( if v-mark-calc = true then "Необходим расчет"                     else "" ) skip
     1062       view-as alert-box information .
     1063   end.
     1064   procedure process-object :
     1065     define input  parameter p-obj-type  as character no-undo .
     1066     define input  parameter p-obj-code  as integer   no-undo .
     1067     define input  parameter p-calc-arh  as logical   no-undo .
     1068     define input  parameter p-calc-ahsp as logical   no-undo .
     1069     define input  parameter p-calc-aht  as logical   no-undo .
     1070     define input  parameter p-mark-calc as logical   no-undo .
     1071     define input  parameter p-mark-del  as logical   no-undo .
     1072     define variable v-create-chip-num as integer   no-undo .
     1073     do
     1074     on error undo, return error return-value
     1075     :
     1076       run waitfram-show in this-procedure
     1077         (input substitute("Объект &1 &2", p-obj-type, p-obj-code)
     1078         ) .
     1079       if p-calc-arh = true
     1080       then do:
     1081         if p-mark-calc = true
     1082         then do:
     1083           run utl/arhiscr.p
     1084             (input  p-obj-type
     1085             ,input  p-obj-code
     1086             ,input  'arh':U
     1087             ,input  'set-calc':U
     1088             ,input  ""
     1089             ,input  ""
     1090             ,input  0
     1091             ,input  ""
     1092             ,input  ""
     1093             ,input  ?
     1094             ,output v-create-chip-num
     1095             ) .
     1096           run clntattr-write in this-procedure
     1097             (input buf_clients.obj-type
     1098             ,input buf_clients.obj-code
     1099             ,input 'arh-calc':U
     1100             ,input true
     1101             ) .
     1102         end.
     1103         if p-mark-del = true
     1104         then do:
     1105           run utl/arhiscr.p
     1106             (input  p-obj-type
     1107             ,input  p-obj-code
     1108             ,input  'arh':U
     1109             ,input  'set-del':U
     1110             ,input  ""
     1111             ,input  ""
     1112             ,input  0
     1113             ,input  ""
     1114             ,input  ""
     1115             ,input  ?
     1116             ,output v-create-chip-num
     1117             ) .
     1118           run invalidate-md5-signature in this-procedure
     1119             (input  p-obj-type
     1120             ,input  p-obj-code
     1121             ,input  'arh':U
     1122             ,input  v-create-chip-num
     1123             ) .
     1124           run clntattr-write in this-procedure
     1125             (input buf_clients.obj-type
     1126             ,input buf_clients.obj-code
     1127             ,input 'arh-del':U
     1128             ,input true
     1129             ) .
     1130         end.
     1131       end.
     1132       if p-calc-ahsp = true
     1133       then do:
     1134         if p-mark-calc = true
     1135         then do:
     1136           run utl/arhiscr.p
     1137             (input  p-obj-type
     1138             ,input  p-obj-code
     1139             ,input  'ahsp':U
     1140             ,input  'set-calc':U
     1141             ,input  ""
     1142             ,input  ""
     1143             ,input  0
     1144             ,input  ""
     1145             ,input  ""
     1146             ,input  ?
     1147             ,output v-create-chip-num
     1148             ) .
     1149           run clntattr-write in this-procedure
     1150             (input buf_clients.obj-type
     1151             ,input buf_clients.obj-code
     1152             ,input 'ahsp-calc':U
     1153             ,input true
     1154             ) .
     1155         end.
     1156         if p-mark-del = true
     1157         then do:
     1158           run utl/arhiscr.p
     1159             (input  p-obj-type
     1160             ,input  p-obj-code
     1161             ,input  'ahsp':U
     1162             ,input  'set-del':U
     1163             ,input  ""
     1164             ,input  ""
     1165             ,input  0
     1166             ,input  ""
     1167             ,input  ""
     1168             ,input  ?
     1169             ,output v-create-chip-num
     1170             ) .
     1171           run invalidate-md5-signature in this-procedure
     1172             (input  p-obj-type
     1173             ,input  p-obj-code
     1174             ,input  'ahsp':U
     1175             ,input  v-create-chip-num
     1176             ) .
     1177           run clntattr-write in this-procedure
     1178             (input buf_clients.obj-type
     1179             ,input buf_clients.obj-code
     1180             ,input 'ahsp-del':U
     1181             ,input true
     1182             ) .
     1183         end.
     1184       end.
     1185       if p-calc-aht = true
     1186       then do:
     1187         if p-mark-calc = true
     1188         then do:
     1189           run utl/arhiscr.p
     1190             (input  p-obj-type
     1191             ,input  p-obj-code
     1192             ,input  'aht':U
     1193             ,input  'set-calc':U
     1194             ,input  ""
     1195             ,input  ""
     1196             ,input  0
     1197             ,input  ""
     1198             ,input  ""
     1199             ,input  ?
     1200             ,output v-create-chip-num
     1201             ) .
     1202           run clntattr-write in this-procedure
     1203             (input buf_clients.obj-type
     1204             ,input buf_clients.obj-code
     1205             ,input 'aht-calc':U
     1206             ,input true
     1207             ) .
     1208         end.
     1209         if p-mark-del = true
     1210         then do:
     1211           run utl/arhiscr.p
     1212             (input  p-obj-type
     1213             ,input  p-obj-code
     1214             ,input  'aht':U
     1215             ,input  'set-del':U
     1216             ,input  ""
     1217             ,input  ""
     1218             ,input  0
     1219             ,input  ""
     1220             ,input  ""
     1221             ,input  ?
     1222             ,output v-create-chip-num
     1223             ) .
     1224           run invalidate-md5-signature in this-procedure
     1225             (input  p-obj-type
     1226             ,input  p-obj-code
     1227             ,input  'aht':U
     1228             ,input  v-create-chip-num
     1229             ) .
     1230           run clntattr-write in this-procedure
     1231             (input buf_clients.obj-type
     1232             ,input buf_clients.obj-code
     1233             ,input 'aht-del':U
     1234             ,input true
     1235             ) .
     1236         end.
     1237       end.
     1238       assign
     1239         v-total-process = v-total-process + 1
     1240       .
     1241     end.
     1242   end procedure.
     1243   procedure invalidate-md5-signature :
     1244     define input  parameter p-obj-type     as character no-undo .
     1245     define input  parameter p-obj-code     as integer   no-undo .
     1246     define input  parameter p-archive-type as character no-undo .
     1247     define input  parameter p-chip-num     as integer   no-undo .
     1248     define buffer buf_archive-history for ub.archive-history .
     1249     do
     1250     on error undo, return error return-value
     1251     :
     1252       for each buf_archive-history exclusive-lock
     1253         where buf_archive-history.obj-type     = p-obj-type
     1254           and buf_archive-history.obj-code     = p-obj-code
     1255           and buf_archive-history.archive-type = p-archive-type
     1256           and buf_archive-history.file-valid   = true
     1257       on error undo, return error return-value
     1258       :
     1259         assign
     1260           buf_archive-history.file-valid            = false
     1261           buf_archive-history.file-invalid-chip-num = p-chip-num
     1262         .
     1263       end.
     1264     end.
     1265   end procedure.
