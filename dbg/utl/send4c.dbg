        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define  shared stream vProtTest.
       18   define  shared variable testId as rowid no-undo.
       19   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
       20       then run str/lib-trn.p persistent no-error .
       21   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn2)
       22       then run str/lib-trn2.p persistent no-error .
       23   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
       24       then run str/lib-trn3.p persistent no-error .
       25   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn4)
       26       then run str/lib-trn4.p persistent no-error .
       27   define temp-table tt-price-doc like ub.price-doc.
       28   define var v-doc-code as char no-undo.
       29   if testId <> ? then
       30   do:
       31     find first ub.price-doc where rowid(ub.price-doc) = testId no-lock no-error.
       32     if not avail ub.price-doc then return.
       33   end.
       34   else
       35   do:
       36   DEFINE FRAME frame1
       37     v-doc-code format "x(15)"
       38     with view-as dialog-box
       39     title "Введите номер переоценки"
       40   .
       41   update v-doc-code with frame frame1.
       42   find first ub.price-doc where ub.price-doc.doc-num = v-doc-code no-error.
       43   if not available (ub.price-doc)
       44     then do:
       45       message "Документ переоценки не найден: номер " v-doc-code view-as alert-box.
       46       return.
       47     end.
       48   end.
       49   buffer-copy ub.price-doc except ub.price-doc.status_ to tt-price-doc  assign tt-price-doc.status_ = "приказ".
       50   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
       51     (input ?
       52     ,input this-procedure:handle
       53     ,input ?
       54     ,input 'event_price-doc':U
       55     ,input  buffer tt-price-doc:handle
       56     ,input  buffer ub.price-doc:handle
       57     ,input ''
       58     ,input ''
       59     ) no-error .
       60   if error-status:error
       61   then do:
       62     message return-value view-as alert-box.
       63   end.
       64   else do:
       65     if testId <> ? then
       66       put stream vProtTest unformatted
       67         "Документ переоценки " ub.price-doc.doc-num " отправлен"
       68         skip.
       69     else
       70     message ub.price-doc.doc-num " отправлен" view-as alert-box.
       71   end.
