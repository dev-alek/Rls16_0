        1   block-level on error undo, throw.
        2   using ibs.th.bge.egais.*.
        3   define input parameter parparentproc    as widget-handle no-undo.
        4   define input parameter p-parent-handle  as widget-handle no-undo.
        5   define input parameter p-log-handle     as handle        no-undo.
        6   define input parameter p-cre-db-num     as integer       no-undo.
        7   define input parameter p-task-type      as character     no-undo.
        8   define input parameter p-task-num       as integer       no-undo.
        9   define input parameter p-db-num         as integer       no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision: 54e7b0cc03ed, 638, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
