       44   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       45   procedure cur-time :
       46      define output parameter p-today as date      no-undo .
       47      define output parameter p-time  as integer   no-undo .
       48     do
       49     on error undo, return error
       50     :
       51       define variable v-date1 as date      no-undo .
       52       define variable v-date2 as date      no-undo .
       53       define variable v-time  as integer   no-undo .
       54       assign
       55         v-date1 = today
       56         v-time  = time
       57         v-date2 = today
       58       .
       59       if v-date1 <> v-date2
       60       then do:
       61         assign
       62           v-date1 = today
       63           v-time  = v-time
       64         .
       65       end.
       66       assign
       67         p-today = v-date1
       68         p-time  = v-time
       69       .
       70     end.
       71   end.
       72   function cur-time-date returns character
       73   :
       74     return string(today, '99/99/9999':U) .
       75   end.
       76   function cur-time-mjd returns decimal
       77   :
       78     define variable v-date as date      no-undo .
       79     define variable v-time as integer   no-undo .
       80     run cur-time in this-procedure
       81       (output v-date
       82       ,output v-time
       83       ) .
       84     return integer(v-date) - 2400002 + (v-time / 86400) .
       85   end.
       86   function cur-time-get-ending-index returns integer
       87   (input p-number as integer
       88   )
       89   :
       90     if p-number < 0
       91     or p-number = ?
       92     then do:
       93       return 1 .
       94     end.
       95     define variable v-rest as integer   no-undo .
       96     assign
       97       p-number = p-number modulo 100
       98     .
       99     if p-number < 20
      100     then do:
      101       assign
      102         v-rest = p-number
      103       .
      104     end.
      105     else do:
      106       assign
      107         v-rest = p-number modulo 10
      108       .
      109     end.
      110     case v-rest :
      111       when 1
      112       then do:
      113         return 2 .
      114       end.
      115       when 2 or
      116       when 3 or
      117       when 4
      118       then do:
      119         return 3 .
      120       end.
      121       otherwise do:
      122         return 1 .
      123       end.
      124     end case .
      125   end.
      126   procedure cur-time-mjd-to-date :
      127      define input  parameter i-mjd-diff as decimal no-undo.
      128      define output parameter o-Date     as date    no-undo.
      129      define output parameter o-Time     as integer no-undo.
      130      define variable v-day-number as integer   no-undo .
      131      if    i-mjd-diff < 0
      132         or i-mjd-diff = ?
      133      then do:
      134         return "?" .
      135      end.
      136      assign
      137         v-day-number = truncate(i-mjd-diff,0).
      138         o-Date = date(v-day-number + 2400002).
      139         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      140     .
      141   end.
      142   function cur-time-mjd-to-string returns character
      143   (input p-mjd-diff as decimal
      144   )
      145   :
      146     define variable v-day-number as integer   no-undo .
      147     define variable v-seconds    as integer   no-undo .
      148     define variable v-hour       as integer   no-undo .
      149     define variable v-min        as integer   no-undo .
      150     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      151     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      152     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      153     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      154     if p-mjd-diff < 0
      155     or p-mjd-diff = ?
      156     then do:
      157       return "?" .
      158     end.
      159     assign
      160       v-day-number = integer(truncate(p-mjd-diff,0))
      161       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      162     .
      163     if v-seconds > 86400
      164     then do:
      165       assign
      166         v-seconds = 86400 - 1
      167       .
      168     end.
      169     if v-seconds < 0
      170     then do:
      171       assign
      172         v-seconds = 0
      173       .
      174     end.
      175     assign
      176       v-hour = truncate(v-seconds / 3600, 0)
      177     .
      178     assign
      179       v-seconds = v-seconds modulo 3600
      180     .
      181     assign
      182       v-min = truncate(v-seconds / 60, 0)
      183     .
      184     assign
      185       v-seconds = v-seconds modulo 60
      186     .
      187     return
      188         (if v-day-number <> 0
      189           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      190           else ""
      191         )
      192       + (if v-day-number <> 0 or v-hour <> 0
      193           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      194           else ""
      195         )
      196       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      197           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      198           else ""
      199         )
      200       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      201       .
      202   end.
      203   function cur-time-string returns character
      204   :
      205     define variable v-date as date      no-undo .
      206     define variable v-time as integer   no-undo .
      207     run cur-time in this-procedure
      208       (output v-date
      209       ,output v-time
      210       ) .
      211     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      212   end.
      213   function cur-time-string-sec returns character
      214   :
      215     define variable v-date as date      no-undo .
      216     define variable v-time as integer   no-undo .
      217     run cur-time in this-procedure
      218       (output v-date
      219       ,output v-time
      220       ) .
      221     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      222   end.
      223   function cur-time-custom  returns character
      224   (input p-prefix as character
      225   ,input p-date-format as character
      226   ,input p-delimiter as character
      227   ,input p-time-format as character
      228   ,input p-suffix as character
      229   )
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return
      238       p-prefix
      239       + string(v-date, p-date-format)
      240       + p-delimiter
      241       + string(v-time, p-time-format)
      242       + p-suffix
      243       .
      244   end.
      245   function cur-time-print  returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-datetime returns datetime
      256   :
      257     define variable v-char as character no-undo .
      258     define variable v-datetime as datetime no-undo .
      259     v-char = cur-time-string().
      260     v-datetime = datetime(v-char).
      261     return  v-datetime.
      262   end.
      263   function cur-time-string-msec returns character
      264   :
      265     define variable v-date as datetime  no-undo .
      266     v-date = now.
      267     return string(v-date) .
      268   end.
      269   define stream LogStream .
      270   define variable mNoTime as logical no-undo.
      271   procedure write-to-log-notime :
      272     define input param i-str as character no-undo .
      273     mNoTime = yes.
      274     run write-to-log (i-str).
      275     mNoTime = no.
      276   end.
      277   procedure write-to-log :
      278     define input param p-str as character no-undo .
      279     do
      280     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      281     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      282     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      283     :
      284       define variable log-res        as logical   no-undo .
      285       define variable v-jj           as integer   no-undo .
      286       if    mNoTime
      287          or writelogvalue eq "AsyncProc"
      288       then
      289          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      290       else
      291          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      292       if auto-log-msg-h <> ? then do:
      293         log-res = auto-log-msg-h:move-to-eof( ) .
      294         log-res = auto-log-msg-h:insert-string( p-str ).
      295       end.
      296       if hand-log-msg-h <> ? then do:
      297         log-res = hand-log-msg-h:move-to-eof( ) .
      298         log-res = hand-log-msg-h:insert-string( p-str ).
      299       end.
      300       assign
      301         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      302         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      303         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      304       .
      305       if add-log-file-name <> ? then do:
      306         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      307           run gbl/fileapnd.p
      308             ( input entry(v-jj, add-log-file-name, chr(1) )
      309             ,input p-str
      310             ,input 20
      311             ) no-error .
      312           if error-status:error then do:
      313             return error return-value .
      314           end.
      315         end.
      316       end.
      317       if writelogvalue eq "AsyncProc"
      318       then do:
      319          p-str = trim(p-str, (chr(13) + chr(10)) )
      320       .
      321          Publish "WriteLogAsunc" (p-str,yes).
      322       end.
      323       else if writelogvalue <> "yes" then do:
      324         run gbl/fileapnd.p
      325           ( input log-file-name
      326           ,input p-str
      327           ,input 20
      328           ) no-error .
      329         if error-status:error then do:
      330           return error return-value .
      331         end.
      332       end.
      333     end.
      334   end procedure.
      335   procedure write-to-screen :
      336     define input param p-str as character no-undo .
      337     do
      338     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      339     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      340     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      341     :
      342       define variable log-res as logical no-undo.
      343       assign
      344         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      345       .
      346       if auto-log-msg-h <> ?
      347       then do:
      348         log-res = auto-log-msg-h:move-to-eof( ) .
      349         log-res = auto-log-msg-h:insert-string( p-str ).
      350       end.
      351       if hand-log-msg-h <> ?
      352       then do:
      353         log-res = hand-log-msg-h:move-to-eof( ) .
      354         log-res = hand-log-msg-h:insert-string( p-str ).
      355       end.
      356     end.
      357   end procedure.
      358   procedure send-msg-to-email :
      359     define input  parameter p-subject      as character no-undo .
      360     define input  parameter p-text-err     as character no-undo .
      361     define input  parameter p-attach-files as character no-undo .
      362     do
      363     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      364     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      365     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      366     :
      367       define variable v-tth             as handle    no-undo .
      368       define variable v-value-character as character no-undo .
      369       define variable v-value-date      as date      no-undo .
      370       define variable v-value-decimal   as decimal   no-undo .
      371       define variable v-value-integer   as integer   no-undo .
      372       define variable v-value-logical   as logical   no-undo .
      373       define variable v-param-type      as character no-undo .
      374       define variable v-email       as character no-undo .
      375       define variable v-tmp-str     as character no-undo .
      376       define variable v-tmp1-str    as character no-undo .
      377       define variable v-ind         as integer   no-undo .
      378       define variable v-num-entries as integer   no-undo .
      379       delete object v-tth no-error.
      380       run adm/shattri.p
      381         ( input "get":U
      382          ,input  "":U
      383          ,input  0
      384          ,input  'auto-task':U
      385          ,input  'send-msg-to-email':U
      386          ,output v-value-character
      387          ,output v-value-date
      388          ,output v-value-decimal
      389          ,output v-value-integer
      390          ,output v-value-logical
      391          ,output v-param-type
      392          ,input-output table-handle v-tth
      393         ) no-error .
      394       if not error-status :error  then do:
      395         assign
      396           v-tmp-str = v-value-character
      397         .
      398       end.
      399       delete object v-tth no-error.
      400       assign
      401         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      402         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      403         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      404         v-num-entries = num-entries( v-tmp-str, chr(44) )
      405         v-email       = "":U
      406       .
      407       do v-ind = 1 to v-num-entries
      408       :
      409         assign
      410           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      411         .
      412         if trim( v-tmp1-str ) <> "":U then do:
      413           if v-email = "":U then do:
      414             assign
      415               v-email = v-tmp1-str
      416             .
      417           end.
      418           else do:
      419             assign
      420               v-email = v-email + chr(44) + v-tmp1-str
      421             .
      422           end.
      423         end.
      424       end.
      425       if v-email <> "":U then do:
      426         run gbl/sendmail.p
      427           ( input v-email
      428           , input p-subject
      429           , input p-text-err
      430           , input p-attach-files
      431           ) no-error .
      432         if error-status :error
      433           or return-value <> "":U
      434         then do:
      435           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      436         end.
      437       end.
      438     end.
      439   end procedure.
      440   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   define new global shared variable g#attr-lib  as handle no-undo .
      442   define variable v-attr-lib-variable as handle no-undo .
      443   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      444   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      445   procedure thbjattr_code :
      446      define input  parameter p-upper-code     as character no-undo .
      447      define input  parameter p-code           as character no-undo .
      448      define output parameter p-label          as character no-undo .
      449      define output parameter p-user-can-edit  as logical   no-undo .
      450      define output parameter p-output-display as logical   no-undo .
      451      define output parameter p-other          as character no-undo .
      452      define output parameter p-prop-list      as character no-undo .
      453      define output parameter p-prop-type-list as character no-undo .
      454      define output parameter p-prop-label-list as character no-undo .
      455      define output parameter p-global          as logical no-undo .
      456      define output parameter p-host           as logical no-undo .
      457      define output parameter p-shop           as logical no-undo .
      458      define output parameter p-store          as logical no-undo .
      459      define output parameter p-db             as logical no-undo .
      460      define variable p-region as logical no-undo.
      461      run thbjattr_code_reg in this-procedure (
      462                                               p-upper-code,
      463                                               p-code,
      464                                               output p-label,
      465                                               output p-user-can-edit,
      466                                               output p-output-display,
      467                                               output p-other,
      468                                               output p-prop-list,
      469                                               output p-prop-type-list,
      470                                               output p-prop-label-list,
      471                                               output p-global,
      472                                               output p-host,
      473                                               output p-shop,
      474                                               output p-store,
      475                                               output p-db,
      476                                               output p-region
      477                                               ).
      478   end procedure.
      479   procedure thbjattr_code_reg :
      480   define input  parameter p-upper-code     as character no-undo .
      481   define input  parameter p-code           as character no-undo .
      482   define output parameter p-label          as character no-undo .
      483   define output parameter p-user-can-edit  as logical   no-undo .
      484   define output parameter p-output-display as logical   no-undo .
      485   define output parameter p-other          as character no-undo .
      486   define output parameter p-prop-list      as character no-undo .
      487   define output parameter p-prop-type-list as character no-undo .
      488   define output parameter p-prop-label-list as character no-undo .
      489   define output parameter p-global          as logical no-undo .
      490   define output parameter p-host           as logical no-undo .
      491   define output parameter p-shop           as logical no-undo .
      492   define output parameter p-store          as logical no-undo .
      493   define output parameter p-db             as logical no-undo .
      494   define output parameter p-region         as logical no-undo .
      495   do
      496   on error undo, return error return-value
      497   :
      498       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      499       (input  p-upper-code
      500       ,input  p-code
      501       ,output p-label
      502       ,output p-user-can-edit
      503       ,output p-output-display
      504       ,output p-other
      505       ,output p-prop-list
      506       ,output p-prop-type-list
      507       ,output p-prop-label-list
      508       ,output p-global
      509       ,output p-host
      510       ,output p-shop
      511       ,output p-store
      512       ,output p-db
      513       ,output p-region
      514       ) no-error .
      515     if error-status :error
      516     then do:
      517       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      518     end.
      519   end.
      520   end procedure.
      521   procedure thbjattr_tooltip :
      522   define input  parameter p-upper-code  as character no-undo .
      523   define input  parameter p-code      as character no-undo .
      524   define output parameter p-tooltip   as character no-undo .
      525   define output parameter p-label     as character no-undo .
      526   define output parameter p-tooltip-code as character no-undo .
      527   do
      528   on error undo, return error return-value
      529   :
      530       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_tooltip in g#attr-lib
      531       (input  p-upper-code
