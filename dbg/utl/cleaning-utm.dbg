      713   procedure thbjattr_manual-edit :
      714   define input  parameter p-ucode          as character no-undo .
      715   define input  parameter p-code           as character no-undo .
      716   define output parameter p-section-num    as integer no-undo .
      717   do
      718   on error undo, return error return-value
      719   :
      720       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      721       (input  p-ucode
      722       ,input  p-code
      723       ,output  p-section-num
      724       ) no-error .
      725     if error-status :error
      726     then do:
      727       undo, return error return-value .
      728     end.
      729   end.
      730   end procedure.
      731   do
      732   on error undo, return error return-value
      733   :
      734     log-file-name = "shd-free.log".
      735     for each ub.clients where ub.clients.db-num = p-db-num no-lock:
      736       empty temp-table thbjattr_thbj-attr .
      737       run adm/shattri.p (
      738            input "get":U
      739           ,input ub.clients.obj-type
      740           ,input ub.clients.obj-code
      741           ,input 'egais':U
      742           ,input 'egais-fsrar':U
      743           ,output v-value-character
      744           ,output v-value-date
      745           ,output v-value-decimal
      746           ,output v-value-integer
      747           ,output v-value-logical
      748           ,output v-value-type
      749           ,input-output TABLE thbjattr_thbj-attr
      750           ) no-error .
      751       assign
      752         v-fs-rar = v-value-character
      753       .
      754       run adm/shattri.p (
      755            input "get":U
      756           ,input '':U
      757           ,input 0
      758           ,input 'egais':U
      759           ,input 'egais-exsys':U
      760           ,output v-value-character
      761           ,output v-value-date
      762           ,output v-value-decimal
      763           ,output v-value-integer
      764           ,output v-value-logical
      765           ,output v-value-type
      766           ,input-output TABLE thbjattr_thbj-attr
      767           ) no-error .
      768       assign v-ext-sys = v-value-integer .
      769       admUtmObj = new admutm (ub.clients.obj-type, ub.clients.obj-code, v-fs-rar, v-ext-sys).
      770       if admUtmObj:ConPar = "" or v-fs-rar = "" or v-ext-sys = 0
      771       then do:
      772         delete object admUtmObj.
      773         next.
      774       end.
      775       run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input ("Начало очистки УТМ" + chr(10) + "Адрес: " + admUtmObj:ConPar + chr(10) + "FSRAR: " + v-fs-rar + chr(10) + "ВС: " + string (v-ext-sys) +  chr(10) + "Объект: " + ub.clients.obj-type + string (ub.clients.obj-code))).
      776       find first ub.ext-system-attr where ub.ext-system-attr.db-num = 0
      777         and ub.ext-system-attr.esys-id = v-ext-sys and ub.ext-system-attr.esya-attr-code = 'save-oxml-pck':U no-lock.
      778       admUtmObj = new admutm (ub.clients.obj-type, ub.clients.obj-code, v-fs-rar, v-ext-sys).
      779       admUtmObj:Cleaning(integer (ub.ext-system-attr.esya-attr-value), p-log-handle).
      780       delete object admUtmObj.
      781           run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input "Окончание очистки УТМ").
      782     end.
      783   end.
