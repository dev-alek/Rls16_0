       20   define variable v-value-decimal   as decimal   no-undo .
       21   define variable v-value-integer   as integer   no-undo .
       22   define variable v-value-logical   as logical   no-undo .
       23   define variable v-value-type      as character no-undo .
       24   define variable v-value-date      as date      no-undo .
       25   define variable v-ext-sys         as integer   no-undo .
       26   define new global shared variable g#language as character no-undo .
       27   if g#language <> '' and g#language <> 'rus':U then do:
       28     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       29   end.
       30   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       31   define  shared variable g#auto-pid           as integer   no-undo .
