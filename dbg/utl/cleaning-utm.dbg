       36   define  shared variable v-socket             as logical   no-undo .
       37   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       38   define  shared variable auto-window-h     as handle    no-undo .
       39   define  shared variable auto-log-msg-h    as handle    no-undo .
       40   define  shared variable hand-log-msg-h    as handle    no-undo .
       41   define  shared variable log-file-name     as character no-undo initial ? .
       42   define  shared variable add-log-file-name as character no-undo initial ? .
