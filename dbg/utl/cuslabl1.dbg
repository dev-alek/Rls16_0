        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter p-tbl-name as character no-undo .
        6   define input parameter p-fld-name as character no-undo .
        7   define input parameter p-call-type as character no-undo .
        8   define input parameter p-call-point as character no-undo .
        9   define input parameter p-language as character no-undo .
       10   define input parameter p-fld-data-type as character no-undo .
       11   define input parameter p-custom-label as character no-undo .
       12   define input parameter p-custom-view-func as character no-undo .
       13   define input parameter p-reference-proc as character no-undo .
       14   define input parameter p-custom-format as character no-undo .
       15   define input parameter p-custom-tooltip as character no-undo .
       16   define input parameter p-init-value-character as character no-undo .
       17   define input parameter p-init-value-date as date no-undo .
       18   define input parameter p-init-value-decimal as decimal no-undo .
       19   define input parameter p-init-value-integer as integer no-undo .
       20   define input parameter p-init-value-logical as logical no-undo .
       21   define input parameter p-widget-type as character no-undo .
       22   define input parameter p-widget-width as decimal no-undo .
       23   define input parameter p-widget-list-items as character no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       25   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       26   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile: cuslabl1.p $":U .
       28   define variable vss-archive     as character no-undo init "$Archive: utl/cuslabl1.p $":U .
       29   define variable vss-description as character no-undo init "Сохранение настраиваемых полей".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable v-mess as character no-undo .
      100   define variable v-entry as character no-undo .
      101   define buffer buf_custom-labels for ub.custom-labels.
      102   if p-mode <> 'ДОБАВЛЕНИЕ':U
      103   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      104     message vss-workfile vss-revision vss-description skip
      105             "Неверный параметр p-mode - " p-mode
      106     view-as alert-box error .
      107     return error '':u.
      108   end.
      109   if g#db-num <> 0 then do:
      110     message vss-workfile vss-revision vss-description skip
      111             "Запрещено вызывать процедуру в УБД"
      112     view-as alert-box error .
      113     return error '':u.
      114   end.
      115   _main:
      116   do for buf_custom-labels
      117   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      118   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      119   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      120   :
      121      if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      122       find first buf_custom-labels no-lock where
      123                 buf_custom-labels.tbl-name  = p-tbl-name
      124             and buf_custom-labels.fld-name  = p-fld-name
      125             and buf_custom-labels.call-type  = p-call-type
      126             and buf_custom-labels.call-point  = p-call-point
      127             and buf_custom-labels.language  = p-language no-error.
      128       if available buf_custom-labels then do:
      129         assign
      130         v-mess = substitute("Уже есть такое настраемваемое поле").
      131         run err-mess in this-procedure ( input-output v-mess).
      132         return error (if p-silent = yes then v-mess else '':U).
      133       end.
      134       create buf_custom-labels.
      135       assign
      136       buf_custom-labels.tbl-name = p-tbl-name
      137       buf_custom-labels.fld-name = p-fld-name
      138       buf_custom-labels.call-type = p-call-type
      139       buf_custom-labels.call-point = p-call-point
      140       buf_custom-labels.language = p-language
      141       .
      142     end.
      143     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      144       find first buf_custom-labels exclusive-lock where
      145               recid(buf_custom-labels) = p-rec no-error.
      146       if not available buf_custom-labels then do:
      147         assign
      148         v-mess = substitute("Нет такого настраиваемого поля").
      149         run err-mess in this-procedure ( input-output v-mess).
      150         return error (if p-silent = yes then v-mess else '':U).
      151       end.
      152       if p-tbl-name <> buf_custom-labels.tbl-name
      153       or p-fld-name <> buf_custom-labels.fld-name
      154       or p-call-type <> buf_custom-labels.call-type
      155       or p-call-point <> buf_custom-labels.call-point
      156       or p-language <> buf_custom-labels.language then do:
      157         assign
      158         v-mess = substitute("Для уже существующего настраиваемого поля невозможно изменение названия таблицы,&1" +
      159                                 "названия поля, типа вызова, точки вызова и языка"
      160                                 , chr(10)
      161                                 )
      162         .
      163         run err-mess in this-procedure ( input-output v-mess).
      164         return error (if p-silent = yes then v-mess else '':U).
      165       end.
      166     end.
      167     assign
      168     buf_custom-labels.custom-format = p-custom-format
      169     buf_custom-labels.custom-label = p-custom-label
      170     buf_custom-labels.custom-view-func = p-custom-view-func
      171     buf_custom-labels.reference-proc = p-reference-proc
      172     buf_custom-labels.custom-tooltip = p-custom-tooltip
      173     buf_custom-labels.fld-data-type = p-fld-data-type
      174     buf_custom-labels.init-value-character = p-init-value-character
      175     buf_custom-labels.init-value-date = p-init-value-date
      176     buf_custom-labels.init-value-decimal = p-init-value-decimal
      177     buf_custom-labels.init-value-integer = p-init-value-integer
      178     buf_custom-labels.init-value-logical = p-init-value-logical
      179     buf_custom-labels.widget-type = p-widget-type
      180     buf_custom-labels.widget-width = p-widget-width
      181     buf_custom-labels.widget-list-items = p-widget-list-items
      182     p-rec = recid(buf_custom-labels)
      183     .
      184   end.
      185   PROCEDURE err-mess:
      186     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      187     CASE p-silent:
      188       when yes then do:
      189         assign
      190         p-mess = substitute("custom-label&1tbl-name=&2&1" +
      191                             "fld-name=&3&1" +
      192                             "call-type=&4&1" +
      193                             "call-point=&5&1" +
      194                             "language=&6&1&7"
      195                            , chr(10)
      196                            , p-tbl-name
      197                            , p-fld-name
      198                            , p-call-type
      199                            , p-call-point
      200                            , p-language
      201                            , p-mess)
      202         .
      203       end.
      204       when no then do:
      205         message
      206         p-mess
      207         view-as alert-box error .
      208       end.
      209     end.
      210   END PROCEDURE.
