        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define  shared stream vProtTest.
       18   define  shared variable testId as rowid no-undo.
       19   // define temp-table tt-trn like ub.shift-obj .
       20   define buffer buf_shift-obj for ub.shift-obj .
       21   define variable v-obj-type as character no-undo .
       22   define variable v-obj-code as integer no-undo .
       23   define variable v-sht-date as date no-undo .
       24   define variable v-sht-num  as integer no-undo .
       25   define button btnOk auto-go label "Ok" .
       26   define button btnCancel auto-endkey label "Cancel".
       27   if testId ne ? then
       28   do:
       29     find first buf_shift-obj where rowid(buf_shift-obj) = testId no-lock no-error.
       30     if not avail buf_shift-obj then return.
       31   end.
       32   else
       33   do:
       34   DEFINE FRAME frame1
       35     skip
       36                      v-obj-code format ">>>>>>>>9"  label "Код магазина"
       37     skip    space(2) v-sht-date format "99/99/9999" label "Дата смены"
       38             space(2) v-sht-num                      label "Порядок смены"
       39     skip(1) space(2) btnOk
       40             space(2) btnCancel
       41     with
       42       side-labels
       43       default-button btnOk
       44       cancel-button btnCancel
       45       view-as dialog-box
       46       title "Введите номер код магазина, дату и номер смены"
       47   .
       48   update v-obj-code v-sht-date v-sht-num btnOk btnCancel with frame frame1.
       49   find first buf_shift-obj no-lock
       50        where buf_shift-obj.obj-type = 'маг'
       51          and buf_shift-obj.obj-code = v-obj-code
       52          and buf_shift-obj.shift-date = v-sht-date
       53          and buf_shift-obj.shift-num  = v-sht-num no-error .
       54   if not available (buf_shift-obj) then do:
       55       message substitute("Отсутствует смена №&1 от &2 в магазине &3",
       56                          v-sht-num, v-sht-date, v-obj-code) view-as alert-box.
       57       return.
       58   end.
       59   if buf_shift-obj.status_ <> 'зкр':U
       60   then do :
       61     message substitute("Смена №&1 от &2 в магазине &3 не закрыта. Укажите закрытую смену.",
       62                        v-sht-num, v-sht-date, v-obj-code) view-as alert-box.
       63     return.
       64   end .
       65   end.
       66   run str/prep1C-shift-period.p (input ?,
       67                                  input buf_shift-obj.obj-type,
       68                                  input buf_shift-obj.obj-code,
       69                                  input buf_shift-obj.shift-date,
       70                                  input buf_shift-obj.shift-num)
       71                                  no-error .
       72   if error-status:error
       73   then do:
       74     message return-value view-as alert-box.
       75   end.
       76   else do:
       77     if testId <> ? then
       78       put stream vProtTest unformatted
       79         substitute("Контрольная плотность НП по cмене №&1 от &2 в магазине &3 отправлена",
       80                    buf_shift-obj.shift-num, buf_shift-obj.shift-date, buf_shift-obj.obj-code)
       81         skip.
       82     else
       83       message substitute("Контрольная плотность НП по Cмене №&1 от &2 в магазине &3 отправлена",
       84                        v-sht-num, v-sht-date, v-obj-code) view-as alert-box.
       85   end.
