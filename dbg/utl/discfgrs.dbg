      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   procedure cur-time :
      378      define output parameter p-today as date      no-undo .
      379      define output parameter p-time  as integer   no-undo .
      380     do
      381     on error undo, return error
      382     :
      383       define variable v-date1 as date      no-undo .
      384       define variable v-date2 as date      no-undo .
      385       define variable v-time  as integer   no-undo .
      386       assign
      387         v-date1 = today
      388         v-time  = time
      389         v-date2 = today
      390       .
      391       if v-date1 <> v-date2
      392       then do:
      393         assign
      394           v-date1 = today
      395           v-time  = v-time
      396         .
      397       end.
      398       assign
      399         p-today = v-date1
      400         p-time  = v-time
      401       .
      402     end.
      403   end.
      404   function cur-time-date returns character
      405   :
      406     return string(today, '99/99/9999':U) .
      407   end.
      408   function cur-time-mjd returns decimal
      409   :
      410     define variable v-date as date      no-undo .
      411     define variable v-time as integer   no-undo .
      412     run cur-time in this-procedure
      413       (output v-date
      414       ,output v-time
      415       ) .
      416     return integer(v-date) - 2400002 + (v-time / 86400) .
      417   end.
      418   function cur-time-get-ending-index returns integer
      419   (input p-number as integer
      420   )
      421   :
      422     if p-number < 0
      423     or p-number = ?
      424     then do:
      425       return 1 .
      426     end.
      427     define variable v-rest as integer   no-undo .
      428     assign
      429       p-number = p-number modulo 100
      430     .
      431     if p-number < 20
      432     then do:
      433       assign
      434         v-rest = p-number
      435       .
      436     end.
      437     else do:
      438       assign
      439         v-rest = p-number modulo 10
      440       .
      441     end.
      442     case v-rest :
      443       when 1
      444       then do:
      445         return 2 .
      446       end.
      447       when 2 or
      448       when 3 or
      449       when 4
      450       then do:
      451         return 3 .
      452       end.
      453       otherwise do:
      454         return 1 .
      455       end.
      456     end case .
      457   end.
      458   procedure cur-time-mjd-to-date :
      459      define input  parameter i-mjd-diff as decimal no-undo.
      460      define output parameter o-Date     as date    no-undo.
      461      define output parameter o-Time     as integer no-undo.
      462      define variable v-day-number as integer   no-undo .
      463      if    i-mjd-diff < 0
      464         or i-mjd-diff = ?
      465      then do:
      466         return "?" .
      467      end.
      468      assign
      469         v-day-number = truncate(i-mjd-diff,0).
      470         o-Date = date(v-day-number + 2400002).
      471         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      472     .
      473   end.
      474   function cur-time-mjd-to-string returns character
      475   (input p-mjd-diff as decimal
      476   )
      477   :
      478     define variable v-day-number as integer   no-undo .
      479     define variable v-seconds    as integer   no-undo .
      480     define variable v-hour       as integer   no-undo .
      481     define variable v-min        as integer   no-undo .
      482     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      483     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      484     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      485     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      486     if p-mjd-diff < 0
      487     or p-mjd-diff = ?
      488     then do:
      489       return "?" .
      490     end.
      491     assign
      492       v-day-number = integer(truncate(p-mjd-diff,0))
      493       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      494     .
      495     if v-seconds > 86400
      496     then do:
      497       assign
      498         v-seconds = 86400 - 1
      499       .
      500     end.
      501     if v-seconds < 0
      502     then do:
      503       assign
      504         v-seconds = 0
      505       .
      506     end.
      507     assign
      508       v-hour = truncate(v-seconds / 3600, 0)
      509     .
      510     assign
      511       v-seconds = v-seconds modulo 3600
      512     .
      513     assign
      514       v-min = truncate(v-seconds / 60, 0)
      515     .
      516     assign
      517       v-seconds = v-seconds modulo 60
      518     .
      519     return
      520         (if v-day-number <> 0
      521           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      522           else ""
      523         )
      524       + (if v-day-number <> 0 or v-hour <> 0
      525           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      526           else ""
      527         )
      528       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      529           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      530           else ""
      531         )
      532       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      533       .
      534   end.
      535   function cur-time-string returns character
      536   :
      537     define variable v-date as date      no-undo .
      538     define variable v-time as integer   no-undo .
      539     run cur-time in this-procedure
      540       (output v-date
      541       ,output v-time
      542       ) .
      543     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      544   end.
      545   function cur-time-string-sec returns character
      546   :
      547     define variable v-date as date      no-undo .
      548     define variable v-time as integer   no-undo .
      549     run cur-time in this-procedure
      550       (output v-date
      551       ,output v-time
      552       ) .
      553     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      554   end.
      555   function cur-time-custom  returns character
      556   (input p-prefix as character
      557   ,input p-date-format as character
      558   ,input p-delimiter as character
      559   ,input p-time-format as character
      560   ,input p-suffix as character
      561   )
      562   :
      563     define variable v-date as date      no-undo .
      564     define variable v-time as integer   no-undo .
      565     run cur-time in this-procedure
      566       (output v-date
      567       ,output v-time
      568       ) .
      569     return
      570       p-prefix
      571       + string(v-date, p-date-format)
      572       + p-delimiter
      573       + string(v-time, p-time-format)
      574       + p-suffix
      575       .
      576   end.
      577   function cur-time-print  returns character
      578   :
      579     define variable v-date as date      no-undo .
      580     define variable v-time as integer   no-undo .
      581     run cur-time in this-procedure
      582       (output v-date
      583       ,output v-time
      584       ) .
      585     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      586   end.
      587   function cur-time-datetime returns datetime
      588   :
      589     define variable v-char as character no-undo .
      590     define variable v-datetime as datetime no-undo .
      591     v-char = cur-time-string().
      592     v-datetime = datetime(v-char).
      593     return  v-datetime.
      594   end.
      595   function cur-time-string-msec returns character
      596   :
      597     define variable v-date as datetime  no-undo .
      598     v-date = now.
      599     return string(v-date) .
      600   end.
      601   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      603   define new shared variable RepPathName        as character no-undo .
      604   define new shared variable PrintRubl          as logical   no-undo .
      605   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   define  stream PrnLibStream.
      607   procedure prn-lib-prn-file :
      608     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      609     define input parameter p-DIsabledoptions as integer no-undo .
      610     define variable v-report-name as character no-undo .
      611     define variable v-user-action as character no-undo .
      612     define variable v-printed     as logical   no-undo .
      613     define variable v-exist       as logical   no-undo .
      614     do
      615       on error undo, return error
      616       :
      617       run prn-lib-get-report-name  in this-procedure (
      618         input parParentProc
      619         ,output v-report-name
      620         ).
      621   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      623     (input  v-report-name
      624     ,input  2
      625     ,output v-exist
      626     )  .
      627       if NOT v-exist then
      628       DO:
      629         Message
      630           "Нет заданий на печать ! "
      631           view-as alert-box .
      632         Return  .
      633       End.
      634       run gbl/prnfilen.w
      635         (input  ""
      636         ,input  p-DisabledOptions
      637         ,input  string(v-report-name )
      638         ,input  7
      639         ,output v-user-action
      640         ,output v-printed
      641         ) .
      642       if v-printed then
      643       do:
      644         return "YES" .
      645       end.
      646       else
      647       do:
      648         return "NO" .
      649       end.
      650     end.
      651   end procedure.
      652   procedure prn-lib-open-stream :
      653     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      654     define input parameter p-page-size    as integer no-undo .
      655     define input parameter p-is-stream    as logical no-undo .
      656     define input parameter p-append       as logical no-undo .
      657     define variable v-report-name as character no-undo .
      658     do
      659       on error undo, return error
      660       :
      661       run prn-lib-get-report-name  in this-procedure (
      662         input parParentProc
      663         ,output v-report-name
      664         ).
      665       if p-is-stream then
      666       do:
      667         if p-append then
      668         do:
      669           output stream PrnLibStream to value( v-report-name )
      670             page-size value(p-page-size) append .
      671         end.
      672         if not p-append then
      673         do:
      674           output stream PrnLibStream to value( v-report-name )
      675             page-size value(p-page-size) .
      676         end.
      677       end.
      678       if not p-is-stream then
      679       do:
      680         if p-append then
      681         do:
      682           output to value( v-report-name )
      683             page-size value(p-page-size) append .
      684         end.
      685         if not p-append then
      686         do:
      687           output to value( v-report-name )
      688             page-size value(p-page-size) .
      689         end.
      690       end.
      691     end.
      692   end procedure.
      693   procedure prn-lib-open-exp :
      694     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      695     define input parameter p-is-stream    as logical no-undo .
      696     define input parameter p-is-append    as logical no-undo .
      697     define output parameter p-ReportFileName as char init "report" no-undo.
      698     define output parameter p-process as logical no-undo .
      699     define variable glog as logical no-undo .
      700     do
      701       on error undo, return error
      702       :
      703       SYSTEM-DIALOG GET-FILE p-ReportFileName
      704         TITLE      "Укажите путь"
      705         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      706         ASK-OVERWRITE
      707         CREATE-TEST-FILE
      708         SAVE-AS
      709         USE-FILENAME
      710         DEFAULT-EXTENSION "txt"
      711         UPDATE glog
      712         .
      713       if not glog then  return.
      714       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      715       if p-is-stream then
      716       do:
      717         if p-is-append then
      718         do:
      719           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      720         end.
      721         else
      722         do:
      723           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      724         end.
      725       end.
      726       else
      727       do:
      728         if p-is-append then
      729         do:
      730           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      731         end.
      732         else
      733         do:
      734           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      735         end.
      736       end.
      737       p-process = yes.
      738     end.
      739   end procedure.
      740   procedure prn-lib-get-report-name :
      741     define input parameter parParentProc  as widget-handle no-undo.
      742     define output parameter p-report-name as character no-undo .
      743     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      744   end procedure.
      745   procedure prn-lib-reportviewer-report-name :
      746     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      747     define input parameter p-report-name-html as character no-undo .
      748     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      749   end procedure.
      750   procedure prn-lib-reportviewer :
      751     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      752     define input parameter p-report-name-html as character no-undo .
      753     define input parameter p-param        as character no-undo .
      754     define variable v-excel           as character no-undo init 'TRUE' .
      755     define variable v-value-character as character no-undo .
      756     define variable v-value-integer   as character no-undo .
      757     define variable v-value-date      as date      no-undo .
      758     define variable v-value-decimal   as decimal   no-undo .
      759     define variable rep-excel         as logical   no-undo .
      760     define variable excel-string      as character no-undo .
      761     define variable v-param-type      as character no-undo .
      762     define variable v-tth             as handle    no-undo .
      763     run adm/shattri.p (
      764       input "get":U
      765       ,input  ""
      766       ,input  0
      767       ,input  'report-glob':U
      768       ,input  'rep-excel':U
      769       ,output v-value-character
      770       ,output v-value-date
      771       ,output v-value-decimal
      772       ,output v-value-integer
      773       ,output rep-excel
      774       ,output v-param-type
      775       ,INPUT-OUTPUT table-handle v-tth
      776       )  .
      777     if rep-excel then v-excel = "TRUE" .
      778     else v-excel = "FALSE" .
      779     if p-param eq ""
      780     then
      781        p-param = "EXCEL:" + v-excel.
      782     else
      783        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      784     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      785   end procedure.
      786   define variable conf-par as character no-undo .
      787   define variable par-type as character no-undo .
      788   define variable v-ibs as logical no-undo .
      789   define variable glog as logical no-undo .
      790   define variable v-cd   as character no-undo INIT ?.
      791   define variable v-table-name  as character no-undo INIT ?.
      792   define variable v-templ-rl-root as integer no-undo .
      793   define variable v-time-templ-rl-root as integer no-undo .
      794   DEFINE BUFFER buf_file FOR dictdb._file.
      795   define variable v-rid-list as character no-undo .
      796   FUNCTION rule-name RETURNS CHARACTER
      797     ( INPUT p-subject AS character, INPUT p-self-nonunique AS character, input p-discnt-role AS character )  FORWARD.
      798   DEFINE BUTTON b-add
      799        LABEL "&Добавить"
      800        SIZE 10 BY 1.
      801   DEFINE BUTTON b-chg
      802        LABEL "&Изменить"
      803        SIZE 10 BY 1.
      804   DEFINE BUTTON b-copy
      805        LABEL "&Копировать"
      806        SIZE 10 BY 1.
      807   DEFINE BUTTON b-del
      808        LABEL "&Удалить"
      809        SIZE 10 BY 1.
      810   DEFINE BUTTON b-dis-ruls
      811        IMAGE-UP FILE "btn-down-arrow":U
      812        IMAGE-DOWN FILE "btn-down-arrow":U
      813        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      814        LABEL "Btn 5"
      815        SIZE 4 BY 1.
      816   DEFINE BUTTON b-dist-rls
      817        IMAGE-UP FILE "btn-down-arrow":U
      818        IMAGE-DOWN FILE "btn-down-arrow":U
      819        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      820        LABEL "Btn 5"
      821        SIZE 4 BY 1.
      822   DEFINE BUTTON B-Help
      823        LABEL "Помо&щь"
      824        SIZE 3 BY 1
      825        BGCOLOR 8 .
      826   DEFINE BUTTON b-lkp
      827        LABEL "&Просмотр"
      828        SIZE 10 BY 1.
      829   DEFINE BUTTON b-mark
      830        LABEL "&*"
      831        SIZE 4 BY 1.
      832   DEFINE BUTTON b-print
      833        LABEL "&Печать"
      834        SIZE 3 BY 1.
      835   DEFINE BUTTON b-quit AUTO-END-KEY
      836        LABEL "&Выход"
      837        SIZE 10 BY 1
      838        BGCOLOR 8 .
      839   DEFINE BUTTON b-sel AUTO-GO
      840        LABEL "Выбор"
      841        SIZE 10 BY 1.
      842   DEFINE VARIABLE Cb-pos-type AS CHARACTER FORMAT "X(256)":U
      843        VIEW-AS COMBO-BOX INNER-LINES 15
      844        LIST-ITEM-PAIRS "Item 1","Item 1"
      845        DROP-DOWN-LIST
      846        SIZE 15 BY 1 NO-UNDO.
      847   DEFINE VARIABLE Cb-table-name AS CHARACTER FORMAT "X(256)":U
      848        VIEW-AS COMBO-BOX INNER-LINES 5
      849        LIST-ITEM-PAIRS "Item 1","Item 1"
      850        DROP-DOWN-LIST
      851        SIZE 62.5 BY 1 NO-UNDO.
      852   DEFINE VARIABLE f-dis-rule-des AS CHARACTER FORMAT "X(256)":U
      853        VIEW-AS FILL-IN NATIVE
      854        SIZE 83.5 BY 1
      855        FGCOLOR 4  NO-UNDO.
      856   DEFINE VARIABLE f-dis-time-rule-des AS CHARACTER FORMAT "X(256)":U
      857        VIEW-AS FILL-IN NATIVE
      858        SIZE 83.5 BY 1
      859        FGCOLOR 4  NO-UNDO.
      860   DEFINE VARIABLE f-templ-rl-root AS INTEGER FORMAT ">,>>9":U INITIAL 0
      861        VIEW-AS FILL-IN NATIVE
      862        SIZE 8 BY 1 NO-UNDO.
      863   DEFINE VARIABLE f-time-templ-rl-root AS INTEGER FORMAT ">,>>9":U INITIAL 0
      864        VIEW-AS FILL-IN NATIVE
      865        SIZE 8 BY 1 NO-UNDO.
      866   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      867         VIEW-AS TEXT
      868        SIZE 6 BY 1
      869        FGCOLOR 4  NO-UNDO.
      870   DEFINE QUERY br-dis-cfg-rule FOR
      871         X_dis-cfg-rule,
      872         X_dis-rule SCROLLING.
      873   DEFINE BROWSE br-dis-cfg-rule
      874     QUERY br-dis-cfg-rule NO-LOCK DISPLAY
      875         X_dis-cfg-rule.pos-type FORMAT "X(15)":U COLUMN-LABEL "Место использ"
      876   X_dis-cfg-rule.discnt-role  COLUMN-LABEL "Роль скидки" FORMAT "X(255)":U WIDTH 15
      877   rule-name( INPUT X_dis-cfg-rule.table-name, INPUT X_dis-cfg-rule.self-nonunique, INPUT X_dis-cfg-rule.discnt-role) COLUMN-LABEL "Роль скидки" FORMAT "X(255)":U WIDTH 35
      878   X_dis-cfg-rule.templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!шаблона"
      879   X_dis-cfg-rule.time-templ-rl-root FORMAT "->>>>>>>>9":U COLUMN-LABEL "Код!шаблона!распис"
      880   X_dis-rule.des FORMAT "X(255)":U WIDTH 45
      881   logical(X_dis-cfg-rule.has-global) FORMAT "+/" COLUMN-LABEL "Глоб"
      882   logical(X_dis-cfg-rule.has-host) FORMAT "+/" COLUMN-LABEL "Фирма"
      883   logical(X_dis-cfg-rule.has-obj) FORMAT "+/" COLUMN-LABEL "Объ"
      884   X_dis-cfg-rule.self-nonunique FORMAT "X(20)" COLUMN-LABEL "Собств.Неуник"
      885   X_dis-cfg-rule.nonunique FORMAT "X(20)" COLUMN-LABEL "Неуник"
      886   X_dis-cfg-rule.table-name FORMAT "X(12)" COLUMN-LABEL "Таблица связи"
      887   entry (lookup (STRING(X_dis-cfg-rule.link-prop), '0,1,2,3,-2,-1':U) + 1, ',':U + 'Объект<=>правило,->Условие правила,Объект<=>Ветка правила,Объект<=>Ссылка на правило,Объект<=>Свойство<=>правило,Объект<=>Нет правила':U) FORMAT "X(30)" COLUMN-LABEL "Вид связи"
      888       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.
      889   DEFINE FRAME Dialog-Frame
      890        b-quit AT ROW 1 COL 1
      891        b-mark AT ROW 1 COL 21 WIDGET-ID 32
      892        b-sel AT ROW 1 COL 25 WIDGET-ID 34
      893        b-add AT ROW 1 COL 35 WIDGET-ID 2
      894        b-copy AT ROW 1 COL 45 WIDGET-ID 30
      895        b-chg AT ROW 1 COL 55 WIDGET-ID 4
      896        b-del AT ROW 1 COL 65 WIDGET-ID 6
      897        b-lkp AT ROW 1 COL 75 WIDGET-ID 8
      898        b-print AT ROW 1 COL 92 WIDGET-ID 36
      899        B-Help AT ROW 1 COL 95
      900        Cb-pos-type AT ROW 2.07 COL 2.5 NO-LABEL WIDGET-ID 12
      901        Cb-table-name AT ROW 2.07 COL 19 NO-LABEL WIDGET-ID 14
      902        b-dis-ruls AT ROW 3 COL 2.5 WIDGET-ID 18
      903        f-templ-rl-root AT ROW 3 COL 5.5 COLON-ALIGNED NO-LABEL WIDGET-ID 20
      904        f-dis-rule-des AT ROW 3 COL 15.5 NO-LABEL WIDGET-ID 26
      905        b-dist-rls AT ROW 4 COL 2.5 WIDGET-ID 24
      906        f-time-templ-rl-root AT ROW 4 COL 5.5 COLON-ALIGNED NO-LABEL WIDGET-ID 22
      907        f-dis-time-rule-des AT ROW 4 COL 15.5 NO-LABEL WIDGET-ID 28
      908        br-dis-cfg-rule AT ROW 5 COL 1
      909        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      910        SPACE(78.50) SKIP(21.09)
      911       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      912            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      913            TITLE "Конфигурация тип скидки-POS-расписание"
      914            CANCEL-BUTTON b-quit.
      915   ASSIGN
      916          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      917          FRAME Dialog-Frame:HIDDEN           = TRUE.
      918   ASSIGN
      919          f-dis-rule-des:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      920   ASSIGN
      921          f-dis-time-rule-des:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      922   ASSIGN
      923          f-templ-rl-root:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      924   ASSIGN
      925          f-time-templ-rl-root:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      926   ON GO OF FRAME Dialog-Frame
      927   DO:
      928     p-rid-list = v-rid-list.
      929   END.
      930   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      931   DO:
      932     APPLY "END-ERROR":U TO SELF.
      933   END.
      934   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      935   DO:
      936   define variable v-rec as recid no-undo .
      937     run utl/discfgri.w ( input parparentproc
      938                         ,INPUT 'ДОБАВЛЕНИЕ':U
      939                         ,INPUT '':U
      940                         ,INPUT '':U
      941                         ,INPUT 0
      942                         ,INPUT 0
      943                         ,INPUT '':U
      944                         ,INPUT '':U
      945                         ,output v-rec
      946                         ) no-error .
      947     RUN openbr IN THIS-PROCEDURE ( input v-cd
      948                                  ,INPUT v-table-name
      949                                  ,INPUT v-templ-rl-root
      950                                  ,INPUT v-time-templ-rl-root) NO-ERROR.
      951     reposition br-dis-cfg-rule to recid(v-rec) no-error .
      952   END.
      953   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      954   DO:
      955   define variable v-rec as recid no-undo .
      956   v-rec = recid(X_dis-cfg-rule).
      957     if not available X_dis-cfg-rule then return no-apply.
      958     run utl/discfgri.w ( input parparentproc
      959                         ,INPUT 'ИЗМЕНЕНИЕ':U
      960                         ,INPUT X_dis-cfg-rule.table-name
      961                         ,INPUT X_dis-cfg-rule.pos-type
      962                         ,INPUT X_dis-cfg-rule.templ-rl-root
      963                         ,INPUT X_dis-cfg-rule.time-templ-rl-root
      964                         ,INPUT X_dis-cfg-rule.discnt-role
      965                         ,INPUT X_dis-cfg-rule.self-nonunique
      966                         ,output v-rec
      967                         ) no-error .
      968     RUN openbr IN THIS-PROCEDURE ( input v-cd
      969                                  ,INPUT v-table-name
      970                                  ,INPUT v-templ-rl-root
      971                                  ,INPUT v-time-templ-rl-root) NO-ERROR.
      972     reposition br-dis-cfg-rule to recid(v-rec) no-error .
      973   END.
      974   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
      975   DO:
      976   define variable v-rec as recid no-undo .
      977   IF NOT AVAILABLE X_dis-cfg-rule THEN RETURN NO-APPLY.
      978     run utl/discfgri.w ( input parparentproc
      979                         ,INPUT 'КОПИРОВАНИЕ':U
      980                          ,INPUT X_dis-cfg-rule.table-name
      981                          ,INPUT X_dis-cfg-rule.pos-type
      982                          ,INPUT X_dis-cfg-rule.templ-rl-root
      983                          ,INPUT X_dis-cfg-rule.time-templ-rl-root
      984                          ,INPUT X_dis-cfg-rule.discnt-role
      985                          ,INPUT X_dis-cfg-rule.self-nonunique
      986                          ,output v-rec
      987                         ) no-error .
      988     RUN openbr IN THIS-PROCEDURE ( input v-cd
      989                                  ,INPUT v-table-name
      990                                  ,INPUT v-templ-rl-root
      991                                  ,INPUT v-time-templ-rl-root) NO-ERROR.
      992     reposition br-dis-cfg-rule to recid(v-rec) no-error .
      993   END.
      994   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      995   DO:
      996     define variable glog as logical no-undo .
      997     if not available X_dis-cfg-rule then return no-apply.
      998     message
      999     "Вы уверены, что хотите стереть?"
     1000     view-as alert-box question buttons yes-no update glog.
     1001     if not glog then return no-apply.
     1002     run utl/discfgr3.p ( input no
     1003                         ,input recid(X_dis-cfg-rule)) no-error.
     1004     if not error-status:error then do:
     1005       RUN openbr IN THIS-PROCEDURE ( input v-cd
     1006                                   ,INPUT v-table-name
     1007                                   ,INPUT v-templ-rl-root
     1008                                   ,INPUT v-time-templ-rl-root) NO-ERROR.
     1009       reposition br-dis-cfg-rule to row 1 no-error .
     1010     end.
     1011   END.
     1012   ON CHOOSE OF b-dis-ruls IN FRAME Dialog-Frame
     1013   DO:
     1014   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1015   DEFINE VARIABLE v-sts AS CHARACTER NO-UNDO.
     1016   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     1017   if available X_dis-cfg-rule then do:
     1018     find first buf_dis-rule no-lock where
     1019               buf_dis-rule.rule-num = X_dis-cfg-rule.templ-rl-root no-error.
     1020     if available buf_dis-rule then do:
     1021       v-rid-list = string(recid(buf_dis-rule)).
     1022     end.
     1023   end.
     1024   run ref/dis-ruls.w (
     1025               input parparentproc
     1026             ,input 0
     1027             ,INPUT "":U
     1028             ,INPUT 0
     1029             ,input "b-sel":U
     1030             ,INPUT "template"
     1031             ,INPUT 0
     1032             ,input ?
     1033             ,input 0
     1034             ,input-output v-sts
     1035             ,input-output v-rid-list ) no-error .
     1036   IF v-rid-list <> '':U THEN DO:
     1037     FIND FIRST buf_dis-rule NO-LOCK WHERE recid(buf_dis-rule) = INTEGER(v-rid-list) NO-ERROR.
     1038     IF NOT AVAILABLE buf_dis-rule THEN RETURN NO-APPLY.
     1039     ASSIGN
     1040     f-templ-rl-root = buf_dis-rule.templ-rl-root
     1041     f-dis-rule-des = buf_dis-rule.des
     1042     v-templ-rl-root = f-templ-rl-root
     1043     .
     1044   END.
     1045   ELSE DO:
     1046     ASSIGN
     1047     f-templ-rl-root = 0
     1048     f-dis-rule-des = '':U
     1049     v-templ-rl-root = 0
     1050     .
     1051   END.
     1052   DISPLAY
     1053   f-dis-rule-des
     1054   f-templ-rl-root
     1055   WITH FRAME Dialog-Frame.
     1056    RUN openbr IN THIS-PROCEDURE ( input v-cd
     1057                                  ,INPUT v-table-name
     1058                                  ,INPUT v-templ-rl-root
     1059                                  ,INPUT v-time-templ-rl-root) NO-ERROR.
     1060     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1061   END.
     1062   ON CHOOSE OF b-dist-rls IN FRAME Dialog-Frame
     1063   DO:
     1064   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1065   DEFINE VARIABLE v-sts AS CHARACTER NO-UNDO.
     1066   DEFINE BUFFER buf_dis-time-rule FOR ub.dis-rule.
     1067       run ref/dist-rls.w (
     1068                      input parparentproc
     1069                     ,input ""
     1070                     ,input "template"
     1071                     ,input X_dis-rule.templ-rl-root
     1072                     ,input 0
     1073                     ,input ''
     1074                     ,input-output v-sts
     1075                     ,input-output v-rid-list) no-error .
     1076   IF v-rid-list <> '':U THEN DO:
     1077     FIND FIRST buf_dis-time-rule NO-LOCK WHERE recid(buf_dis-time-rule) = INTEGER(v-rid-list) NO-ERROR.
     1078     IF NOT AVAILABLE buf_dis-time-rule THEN RETURN NO-APPLY.
     1079     ASSIGN
     1080     f-time-templ-rl-root = buf_dis-time-rule.templ-rl-root
     1081     f-dis-time-rule-des = buf_dis-time-rule.des
     1082     v-time-templ-rl-root = f-time-templ-rl-root
     1083     .
     1084   END.
     1085   ELSE DO:
     1086     ASSIGN
     1087     f-time-templ-rl-root = 0
     1088     f-dis-time-rule-des = '':U
     1089     v-time-templ-rl-root = 0
     1090     .
     1091   END.
     1092   DISPLAY
     1093   f-dis-time-rule-des
     1094   f-time-templ-rl-root
     1095   WITH FRAME Dialog-Frame.
     1096    RUN openbr IN THIS-PROCEDURE ( input v-cd
     1097                                  ,INPUT v-table-name
     1098                                  ,INPUT v-templ-rl-root
     1099                                  ,INPUT v-time-templ-rl-root) NO-ERROR.
     1100     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1101   END.
     1102   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1103   DO:
     1104    define variable v-rec as recid no-undo .
     1105     if not available X_dis-cfg-rule then return no-apply.
     1106     run utl/discfgri.w ( input parparentproc
     1107                         ,INPUT 'ПРОСМОТР':U
     1108                         ,INPUT X_dis-cfg-rule.table-name
     1109                         ,INPUT X_dis-cfg-rule.pos-type
     1110                         ,INPUT X_dis-cfg-rule.templ-rl-root
     1111                         ,INPUT X_dis-cfg-rule.time-templ-rl-root
     1112                         ,INPUT X_dis-cfg-rule.discnt-role
     1113                         ,INPUT X_dis-cfg-rule.self-nonunique
     1114                         ,output v-rec
     1115                         ) no-error .
     1116   END.
     1117   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1118   DO:
     1119     define variable glog as logical no-undo .
     1120     if available X_dis-cfg-rule then do:
     1121   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1122   define variable v-str-recid7 as character no-undo .
     1123   define variable v-num-entry7 as integer   no-undo .
     1124   assign
     1125     v-str-recid7 = trim( string( recid( X_dis-cfg-rule ) , "->>>>>>>>>>>9":U ) )
     1126     v-num-entry7 = lookup( v-str-recid7 , v-rid-list )
     1127   .
     1128   if v-num-entry7 > 0 then do:
     1129     assign
     1130       entry( v-num-entry7, v-rid-list ) = "":U
     1131       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1132     .
     1133   end.
     1134   else do:
     1135     assign
     1136       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid7
     1137     .
     1138   end.
     1139     glog = br-dis-cfg-rule:refresh() .
     1140     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1141         glog = br-dis-cfg-rule:select-next-row ().
     1142         apply "VALUE-CHANGED" to br-dis-cfg-rule in frame Dialog-Frame.
     1143     end.
     1144     if num-entries( v-rid-list ) = 0
     1145     then
     1146         hide mark-num in frame Dialog-Frame.
     1147     else
     1148         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1149   end.
     1150   apply "entry" to br-dis-cfg-rule in frame Dialog-Frame.
     1151   END.
     1152   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1153   DO:
     1154     RUN proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1155     IF ERROR-STATUS:ERROR THEN UNDO, RETURN NO-APPLY.
     1156   END.
     1157   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1158   DO:
     1159     if available X_dis-cfg-rule then do:
     1160       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1161       then  v-rid-list = string( recid( X_dis-cfg-rule ) ) .
     1162     end.
     1163   END.
     1164   ON VALUE-CHANGED OF Cb-pos-type IN FRAME Dialog-Frame
     1165   DO:
     1166     assign
     1167       cb-pos-type
     1168       v-cd = ( if cb-pos-type = "":U then ? else cb-pos-type )
     1169     .
     1170     RUN openbr IN THIS-PROCEDURE ( input v-cd
     1171                                  ,INPUT v-table-name
     1172                                  ,INPUT v-templ-rl-root
     1173                                  ,INPUT v-time-templ-rl-root) NO-ERROR.
     1174     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1175   END.
     1176   ON VALUE-CHANGED OF Cb-table-name IN FRAME Dialog-Frame
     1177   DO:
     1178     assign
     1179       cb-table-name
     1180       v-table-name = ( if cb-table-name = "":U then ? else cb-table-name )
     1181     .
     1182     RUN openbr IN THIS-PROCEDURE ( input v-cd
     1183                                  ,INPUT v-table-name
     1184                                  ,INPUT v-templ-rl-root
     1185                                  ,INPUT v-time-templ-rl-root) NO-ERROR.
     1186     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1187   END.
     1188   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1189   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1190   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   on help of frame Dialog-Frame
     1192   do:
     1193     run gbl/app_help.p
     1194       (input this-procedure :file-name
     1195       ,input ''
     1196       ,input ?
     1197       ) no-error.
     1198     if error-status :error then do:
     1199       message
     1200         "Ошибка при вызове помощи"
     1201         error-status :get-message(1)
     1202         view-as alert-box .
     1203     end.
     1204   end.
     1205   run minbtn-set in this-procedure .
     1206   on choose of b-help in frame Dialog-Frame
     1207   do:
     1208     apply "help":u to frame Dialog-Frame .
     1209   end.
     1210   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1211   procedure minbtn-set :
     1212       do
     1213           on error undo, return error return-value
     1214           :
     1215           define variable ii              as integer       no-undo .
     1216           define variable fh              as widget-handle no-undo .
     1217           define variable hh              as widget-handle no-undo .
     1218           define variable v-h             as handle        extent 4 no-undo .
     1219           define variable v-name-button   as character     no-undo .
     1220           define variable v-help-old-x    as decimal       no-undo .
     1221           define variable v-help-old-y    as decimal       no-undo .
     1222           define variable v-help-old-size as decimal       no-undo .
     1223           define variable v-frame-width   as decimal       no-undo .
     1224           define variable jj              as integer       no-undo .
     1225           do
     1226               on error undo, return error
     1227               :
     1228               assign
     1229                   v-frame-width = frame Dialog-Frame:width - 0.3
     1230                   fh            = frame Dialog-Frame:first-child
     1231                   hh            = fh:first-child
     1232                   ii            = 1
     1233                   .
     1234               do while valid-handle(hh):
     1235                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1236                   do:
     1237                       case lc(hh:name) :
     1238                           when "b-help" then
     1239                               do:
     1240                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1241                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1242                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1243                                   hh:TOOLTIP = "Помощь" .
     1244                                   v-help-old-x = hh:column .
     1245                                   v-help-old-y = hh:row    .
     1246                                   v-help-old-size = hh:width .
     1247                                   hh:width-chars = 2.5 .
     1248                               end.
     1249                           when "b-print" then
     1250                               do:
     1251                                   hh:load-image("cmp/b-print.bmp":u) .
     1252                                   hh:TOOLTIP = "Печать" .
     1253                                   v-h[ii] = hh:handle .
     1254                                   ii = ii + 1 .
     1255                                   hh:width-chars = 3 .
     1256                               end.
     1257                           when "b-history" or
     1258                           when "b-hist" then
     1259                               do:
     1260                                   hh:load-image("cmp/b-hist.bmp":u) .
     1261                                   hh:TOOLTIP = "История" .
     1262                                   v-h[ii] = hh:handle .
     1263                                   ii = ii + 1 .
     1264                                   hh:width-chars = 3 .
     1265                               end.
     1266                           when "b-sch" then
     1267                               do:
     1268                                   hh:load-image("cmp/b-sch.bmp":u) .
     1269                                   hh:TOOLTIP = "Установка Фильтра" .
     1270                                   v-h[ii] = hh:handle .
     1271                                   ii = ii + 1 .
     1272                                   hh:width-chars = 3 .
     1273                               end.
     1274                           when "b-hist-user" then
     1275                               do:
     1276                                   hh:load-image("cmp/b-hist.bmp":u) .
     1277                                   hh:TOOLTIP = "История пользователя" .
     1278                                   ii = ii + 1 .
     1279                               end.
     1280                       end case.
     1281                   end.
     1282                   hh = hh:next-sibling.
     1283               end.
     1284               b-help:column = v-frame-width - b-help:width-chars.
     1285               jj = 0.
     1286               repeat ii = 4 to 1 by -1 :
     1287                   if valid-handle (v-h[ii] ) then
     1288                   do:
     1289                       jj  = jj + 1 .
     1290                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1291                       v-h[ii]:row    = v-help-old-y .
     1292                   end.
     1293               end.
     1294           end.
     1295       end.
     1296   end procedure.
     1297   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1298   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1299   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1300   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1301   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1302   define variable v-diasize-current-frame-height as decimal   no-undo .
     1303   define variable v-diasize-change-size          as logical   no-undo .
     1304   define variable v-diasize-resize-button        as handle    no-undo .
     1305   define variable v-diasize-wndmax               as logical   no-undo .
     1306   define variable v-diasize-wndstore             as logical   no-undo .
     1307   define variable v-diasize-proc-name            as character no-undo .
     1308   define variable v-diasize-browse-handle        as handle    no-undo .
     1309   define variable v-diasize-browse-number        as integer   no-undo .
     1310   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1311   define temp-table temp-diasize-handle no-undo
     1312     field handle-value  as handle
     1313     field save-position as decimal
     1314     index xpk is primary unique handle-value
     1315     .
     1316   define temp-table temp-browse-handle no-undo
     1317     field browse-type   as character
     1318     field browse-number as integer
     1319     field browse-handle as handle
     1320     field original-size as decimal
     1321     index xpk is primary unique browse-type browse-number
     1322     index xie browse-type browse-handle
     1323   .
     1324   procedure diasize_change-height :
     1325     define input  parameter p-change-value  as decimal   no-undo .
     1326     define input  parameter p-move-resize   as logical   no-undo .
     1327     define variable v-field-group-handle    as handle    no-undo .
     1328     define variable v-object-handle         as handle    no-undo .
     1329     define variable v-frame-height          as decimal   no-undo .
     1330     define variable v-frame-virtual-height  as decimal   no-undo .
     1331     define variable v-browse-height         as decimal   no-undo .
     1332     define variable v-window-height         as decimal   no-undo .
     1333     define variable v-window-virtual-height as decimal   no-undo .
     1334     define variable v-change-sign           as integer   no-undo .
     1335     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1336     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1337     if p-change-value > 0
     1338     then do:
     1339       if frame Dialog-Frame :height + p-change-value
     1340           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1341       then do:
     1342         assign
     1343           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1344                           - (frame Dialog-Frame :height-chars)
     1345         .
     1346         if p-change-value <= 0
     1347         then do:
     1348           run diasize_position-resize-button in this-procedure .
     1349           return .
     1350         end.
     1351       end.
     1352     end.
     1353     if p-change-value < 0
     1354     then do:
     1355       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1356       then do:
     1357         assign
     1358           p-change-value = v-diasize-orig-frame-height
     1359                          - (frame Dialog-Frame :height-chars)
     1360         .
     1361         if p-change-value >= 0
     1362         then do:
     1363           run diasize_position-resize-button in this-procedure .
     1364           return .
     1365         end.
     1366       end.
     1367     end.
     1368     if p-change-value >= 0
     1369     then do:
     1370       assign
     1371         v-change-sign = 1
     1372       .
     1373     end.
     1374     else do:
     1375       assign
     1376         v-change-sign = -1
     1377       .
     1378     end.
     1379     assign
     1380       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1381     .
     1382     if p-change-value = 0
     1383     then do:
     1384       run diasize_position-resize-button in this-procedure .
     1385       return .
     1386     end.
     1387     move_block:
     1388     do
     1389     on error undo move_block, retry move_block
     1390     :
     1391       if retry
     1392       then do:
     1393         do
     1394         on error undo move_block, leave move_block
     1395         :
     1396           if p-change-value > 0
     1397           then do:
     1398             for each buf_temp-diasize-handle
     1399             on error undo, next
     1400             :
     1401               assign
     1402                 v-object-handle = buf_temp-diasize-handle.handle-value
     1403               .
     1404               if v-object-handle <> v-diasize-resize-button
     1405               then do:
     1406                 assign
     1407                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1408                 .
     1409               end.
     1410             end.
     1411             assign
     1412               v-diasize-browse-handle :height = v-browse-height
     1413             .
     1414             for each buf_temp-browse-handle
     1415               where buf_temp-browse-handle.browse-type = 'height':u
     1416             on error undo, next
     1417             :
     1418               assign
     1419                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1420               .
     1421             end.
     1422             assign
     1423               frame Dialog-Frame :height = v-frame-height
     1424             .
     1425             if frame Dialog-Frame :scrollable = true
     1426             then do:
     1427               assign
     1428                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1429               .
     1430             end.
     1431             run diasize_position-resize-button in this-procedure .
     1432           end.
     1433           else do:
     1434             if frame Dialog-Frame :scrollable = true
     1435             then do:
     1436               assign
     1437                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1438               .
     1439             end.
     1440             assign
     1441               frame Dialog-Frame :height = v-frame-height
     1442             .
     1443             assign
     1444               v-diasize-browse-handle :height = v-browse-height
     1445             .
     1446             for each buf_temp-browse-handle
     1447               where buf_temp-browse-handle.browse-type = 'height':u
     1448             on error undo, next
     1449             :
     1450               assign
     1451                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1452               .
     1453             end.
     1454             for each buf_temp-diasize-handle
     1455             on error undo, next
     1456             :
     1457               assign
     1458                 v-object-handle = buf_temp-diasize-handle.handle-value
     1459               .
     1460               if v-object-handle <> v-diasize-resize-button
     1461               then do:
     1462                 assign
     1463                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1464                 .
     1465               end.
     1466             end.
     1467             run diasize_position-resize-button in this-procedure .
     1468           end.
     1469           assign
     1470             v-diasize-change-size = false
     1471           .
     1472           leave move_block .
     1473         end.
     1474       end.
     1475       assign
     1476         v-diasize-need-full-display = true
     1477       .
     1478       if v-diasize-change-size = false
     1479       then do:
     1480         assign
     1481           v-diasize-change-size = true
     1482         .
     1483       end.
     1484       else do:
     1485         return .
     1486       end.
     1487       assign
     1488         v-frame-height = frame Dialog-Frame :height
     1489         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1490         v-browse-height = v-diasize-browse-handle :height
     1491       .
     1492       for each buf_temp-browse-handle
     1493         where buf_temp-browse-handle.browse-type = 'height':u
     1494       :
     1495         assign
     1496           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1497         .
     1498       end.
     1499       for each buf_temp-diasize-handle
     1500       :
     1501         delete buf_temp-diasize-handle .
     1502       end.
     1503       assign
     1504         v-field-group-handle = frame Dialog-Frame :first-child
     1505       .
     1506       do while valid-handle(v-field-group-handle)
     1507       :
     1508         assign
     1509           v-object-handle = v-field-group-handle :first-child
     1510         .
     1511         do while valid-handle(v-object-handle)
     1512         :
     1513           if  v-object-handle <> v-diasize-browse-handle :handle
     1514           and can-query(v-object-handle, "row")
     1515           and can-query(v-object-handle, "height")
     1516           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1517           then do:
     1518             find first buf_temp-browse-handle
     1519               where buf_temp-browse-handle.browse-type   = 'height':u
     1520                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1521               no-error .
     1522             if available buf_temp-browse-handle
     1523             then do:
     1524             end.
     1525             else do:
     1526               create buf_temp-diasize-handle .
     1527               assign
     1528                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1529                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1530               .
     1531             end.
     1532           end.
     1533           assign
     1534             v-object-handle = v-object-handle :next-sibling
     1535           .
     1536         end.
     1537         assign
     1538           v-field-group-handle = v-field-group-handle :next-sibling
     1539         .
     1540       end.
     1541       do with frame Dialog-Frame
     1542       :
     1543         hide v-diasize-resize-button .
     1544         assign
     1545           v-diasize-resize-button :row    = 1
     1546           v-diasize-resize-button :column = 1
     1547         .
     1548       end.
     1549       if p-change-value > 0
     1550       then do:
     1551         if frame Dialog-Frame :scrollable = true
     1552         then do:
     1553           assign
     1554             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1555             no-error .
     1556           if error-status :error
     1557           or error-status :get-message(1) <> ""
     1558           then do:
     1559             undo move_block, retry move_block .
     1560           end.
     1561         end.
     1562         assign
     1563           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1564           no-error .
     1565         if error-status :error
     1566         or error-status :get-message(1) <> ""
     1567         then do:
     1568           undo move_block, retry move_block .
     1569         end.
     1570         assign
     1571           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1572           no-error .
     1573         if error-status :error
     1574         or error-status :get-message(1) <> ""
     1575         then do:
     1576           undo move_block, retry move_block .
     1577         end.
     1578         for each buf_temp-browse-handle
     1579           where buf_temp-browse-handle.browse-type = 'height':u
     1580         on error undo move_block, retry move_block
     1581         :
     1582           assign
     1583             buf_temp-browse-handle.browse-handle :height
     1584               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1585             no-error .
     1586           if error-status :error
     1587           or error-status :get-message(1) <> ""
     1588           then do:
     1589             undo move_block, retry move_block .
     1590           end.
     1591         end.
     1592         for each buf_temp-diasize-handle
     1593         on error undo move_block, retry move_block
     1594         :
     1595           assign
     1596             v-object-handle = buf_temp-diasize-handle.handle-value
     1597           .
     1598           if v-object-handle <> v-diasize-resize-button
     1599           then do:
     1600             assign
     1601               v-object-handle :row = v-object-handle :row + p-change-value
     1602               no-error .
     1603             if error-status :error
     1604             or error-status :get-message(1) <> ""
     1605             then do:
     1606               undo move_block, retry move_block .
     1607             end.
     1608           end.
     1609         end.
     1610       end.
     1611       else do:
     1612         for each buf_temp-diasize-handle
     1613         on error undo move_block, retry move_block
     1614         :
     1615           assign
     1616             v-object-handle = buf_temp-diasize-handle.handle-value
     1617           .
     1618           if v-object-handle <> v-diasize-resize-button
     1619           then do:
     1620             assign
     1621               v-object-handle :row = v-object-handle :row + p-change-value
     1622               no-error .
     1623             if error-status :error
     1624             or error-status :get-message(1) <> ""
     1625             then do:
     1626               undo move_block, retry move_block .
     1627             end.
     1628           end.
     1629         end.
     1630         assign
     1631           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1632           no-error .
     1633         if error-status :error
     1634         or error-status :get-message(1) <> ""
     1635         then do:
     1636           undo move_block, retry move_block .
     1637         end.
     1638         for each buf_temp-browse-handle
     1639           where buf_temp-browse-handle.browse-type = 'height':u
     1640         on error undo move_block, retry move_block
     1641         :
     1642           assign
     1643             buf_temp-browse-handle.browse-handle :height
     1644               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1645             no-error .
     1646           if error-status :error
     1647           or error-status :get-message(1) <> ""
     1648           then do:
     1649             undo move_block, retry move_block .
     1650           end.
     1651         end.
     1652         assign
     1653           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1654           no-error .
     1655         if error-status :error
     1656         or error-status :get-message(1) <> ""
     1657         then do:
     1658           undo move_block, retry move_block .
     1659         end.
     1660         if frame Dialog-Frame :scrollable = true
     1661         then do:
     1662           assign
     1663             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1664             no-error .
     1665           if error-status :error
     1666           or error-status :get-message(1) <> ""
     1667           then do:
     1668             undo move_block, retry move_block .
     1669           end.
     1670         end.
     1671       end.
     1672       if p-move-resize = true
     1673       then do:
     1674         run diasize_position-resize-button in this-procedure .
     1675       end.
     1676       if v-diasize-wndstore = true
     1677       then do:
     1678         if connected("ub") = true
     1679         then do:
     1680           define variable v-cntxt-db-num        as integer   no-undo .
     1681           define variable v-cntxt-userid        as character no-undo .
     1682           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1683                                             , OUTPUT v-cntxt-userid
     1684                                             ) .
     1685           run gbl/wndsizew.p
     1686             (input  v-cntxt-db-num
     1687             ,input  v-cntxt-userid
     1688             ,input  v-diasize-proc-name
     1689             ,input  'height':u
     1690             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1691             ) .
     1692         end.
     1693       end.
     1694     end.
     1695     assign
     1696       v-diasize-change-size = false
     1697     .
     1698   end procedure.
     1699   procedure diasize_set-height :
     1700     define input  parameter p-new-height  as decimal   no-undo .
     1701     define input  parameter p-move-resize as logical   no-undo .
     1702     do
     1703     on error undo, return error return-value
     1704     :
     1705       run diasize_change-height in this-procedure
     1706         (input  (p-new-height - frame Dialog-Frame :height)
     1707         ,input  p-move-resize
     1708         ) .
     1709     end.
     1710   end procedure.
     1711   procedure diasize_change-width :
     1712     define input  parameter p-change-value as decimal   no-undo .
     1713     define input  parameter p-move-resize  as logical   no-undo .
     1714     define variable v-field-group-handle   as handle    no-undo .
     1715     define variable v-object-handle        as handle    no-undo .
     1716     define variable v-frame-width          as decimal   no-undo .
     1717     define variable v-frame-virtual-width  as decimal   no-undo .
     1718     define variable v-browse-width         as decimal   no-undo .
     1719     define variable v-window-width         as decimal   no-undo .
     1720     define variable v-window-virtual-width as decimal   no-undo .
     1721     define variable v-change-sign          as integer   no-undo .
     1722     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1723     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1724     if p-change-value > 0
     1725     then do:
     1726       if frame Dialog-Frame :width + p-change-value >
     1727           session :width-chars
     1728       then do:
     1729         assign
     1730           p-change-value = session :width-chars - frame Dialog-Frame :width
     1731         .
     1732         if p-change-value <= 0
     1733         then do:
     1734           run diasize_position-resize-button in this-procedure .
     1735           return .
     1736         end.
     1737       end.
     1738     end.
     1739     if p-change-value < 0
     1740     then do:
     1741       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1742       then do:
     1743         assign
     1744           p-change-value = v-diasize-orig-frame-width
     1745                          - frame Dialog-Frame :width
     1746         .
     1747         if p-change-value >= 0
     1748         then do:
     1749           run diasize_position-resize-button in this-procedure .
     1750           return .
     1751         end.
     1752       end.
     1753     end.
     1754     if p-change-value >= 0
     1755     then do:
     1756       assign
     1757         v-change-sign = 1
     1758       .
     1759     end.
     1760     else do:
     1761       assign
     1762         v-change-sign = -1
     1763       .
     1764     end.
     1765     assign
     1766       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1767     .
     1768     if p-change-value = 0
     1769     then do:
     1770       run diasize_position-resize-button in this-procedure .
     1771       return .
     1772     end.
     1773     move_block:
     1774     do
     1775     on error undo move_block, leave move_block
     1776     :
     1777       if retry
     1778       then do:
     1779         do
     1780         on error undo move_block, leave move_block
     1781         :
     1782           if p-change-value > 0
     1783           then do:
     1784             for each buf_temp-diasize-handle
     1785             on error undo, next
     1786             :
     1787               assign
     1788                 v-object-handle = buf_temp-diasize-handle.handle-value
     1789               .
     1790               if v-object-handle <> v-diasize-resize-button
     1791               then do:
     1792                 assign
     1793                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1794                 .
     1795               end.
     1796             end.
     1797             assign
     1798               v-diasize-browse-handle :width = v-browse-width
     1799             .
     1800             for each buf_temp-browse-handle
     1801               where buf_temp-browse-handle.browse-type = 'width':u
     1802             on error undo, next
     1803             :
     1804               assign
     1805                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1806               .
     1807             end.
     1808             assign
     1809               frame Dialog-Frame :width = v-frame-width
     1810             .
     1811             if frame Dialog-Frame :scrollable = true
     1812             then do:
     1813               assign
     1814                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1815               .
     1816             end.
     1817             run diasize_position-resize-button in this-procedure .
     1818           end.
     1819           else do:
     1820             if frame Dialog-Frame :scrollable = true
     1821             then do:
     1822               assign
     1823                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1824               .
     1825             end.
     1826             assign
     1827               frame Dialog-Frame :width = v-frame-width
     1828             .
     1829             for each buf_temp-browse-handle
     1830               where buf_temp-browse-handle.browse-type = 'width':u
     1831             on error undo, next
     1832             :
     1833               assign
     1834                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1835               .
     1836             end.
     1837             assign
     1838               v-diasize-browse-handle :width = v-browse-width
     1839             .
     1840             for each buf_temp-diasize-handle
     1841             on error undo, next
     1842             :
     1843               assign
     1844                 v-object-handle = buf_temp-diasize-handle.handle-value
     1845               .
     1846               if v-object-handle <> v-diasize-resize-button
     1847               then do:
     1848                 assign
     1849                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1850                 .
     1851               end.
     1852             end.
     1853             run diasize_position-resize-button in this-procedure .
     1854           end.
     1855           assign
     1856             v-diasize-change-size = false
     1857           .
     1858           leave move_block .
     1859         end.
     1860       end.
     1861       assign
     1862         v-diasize-need-full-display = true
     1863       .
     1864       if v-diasize-change-size = false
     1865       then do:
     1866         assign
     1867           v-diasize-change-size = true
     1868         .
     1869       end.
     1870       else do:
     1871         return .
     1872       end.
     1873       assign
     1874         v-frame-width = frame Dialog-Frame :width
     1875         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1876         v-browse-width = v-diasize-browse-handle :width
     1877       .
     1878       for each buf_temp-browse-handle
     1879         where buf_temp-browse-handle.browse-type = 'width':u
     1880       :
     1881         assign
     1882           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1883         .
     1884       end.
     1885       for each buf_temp-diasize-handle
     1886       :
     1887         delete buf_temp-diasize-handle .
     1888       end.
     1889       assign
     1890         v-field-group-handle = frame Dialog-Frame :first-child
     1891       .
     1892       do while valid-handle(v-field-group-handle)
     1893       :
     1894         assign
     1895           v-object-handle = v-field-group-handle :first-child
     1896         .
     1897         do while valid-handle(v-object-handle)
     1898         :
     1899           if  v-object-handle <> v-diasize-browse-handle :handle
     1900           and v-object-handle <> v-diasize-resize-button
     1901           and can-query(v-object-handle, "row")
     1902           and can-query(v-object-handle, "height")
     1903           and ( v-object-handle :col + v-object-handle :width
     1904                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1905               )
     1906           then do:
     1907             find first buf_temp-browse-handle
     1908               where buf_temp-browse-handle.browse-type   = 'width':u
     1909                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1910               no-error .
     1911             if available buf_temp-browse-handle
     1912             then do:
     1913             end.
     1914             else do:
     1915               create buf_temp-diasize-handle .
     1916               assign
     1917                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1918                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1919               .
     1920             end.
     1921           end.
     1922           assign
     1923             v-object-handle = v-object-handle :next-sibling
     1924           .
     1925         end.
     1926         assign
     1927           v-field-group-handle = v-field-group-handle :next-sibling
     1928         .
     1929       end.
     1930       do with frame Dialog-Frame
     1931       :
     1932         hide v-diasize-resize-button .
     1933         v-diasize-resize-button :row = 1.
     1934         v-diasize-resize-button :column = 1.
     1935       end.
     1936       if p-change-value > 0
     1937       then do:
     1938         if frame Dialog-Frame :scrollable = true
     1939         then do:
     1940           assign
     1941             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1942             no-error .
     1943           if error-status :error
     1944           or error-status :get-message(1) <> ""
     1945           then do:
     1946             undo move_block, retry move_block.
     1947           end.
     1948         end.
     1949         assign
     1950           frame Dialog-Frame :width = v-frame-width + p-change-value
     1951           no-error .
     1952         if error-status :error
     1953         or error-status :get-message(1) <> ""
     1954         then do:
     1955           undo move_block, retry move_block.
     1956         end.
     1957         assign
     1958           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1959         no-error .
     1960         if error-status :error
     1961         or error-status :get-message(1) <> ""
     1962         then do:
     1963           undo move_block, retry move_block.
     1964         end.
     1965         for each buf_temp-browse-handle
     1966           where buf_temp-browse-handle.browse-type = 'width':u
     1967         on error undo move_block, retry move_block
     1968         :
     1969           assign
     1970             buf_temp-browse-handle.browse-handle :width
     1971               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1972             no-error .
     1973           if error-status :error
     1974           or error-status :get-message(1) <> ""
     1975           then do:
     1976             undo move_block, retry move_block .
     1977           end.
     1978         end.
     1979         for each buf_temp-diasize-handle
     1980         on error undo move_block, retry move_block
     1981         :
     1982           assign
     1983             v-object-handle = buf_temp-diasize-handle.handle-value
     1984           .
     1985           if v-object-handle <> v-diasize-resize-button
     1986           then do:
     1987             assign
     1988               v-object-handle :col = v-object-handle :col + p-change-value
     1989               no-error .
     1990             if error-status :error
     1991             or error-status :get-message(1) <> ""
     1992             then do:
     1993               undo move_block, retry move_block .
     1994             end.
     1995           end.
     1996         end.
     1997       end.
     1998       else do:
     1999         for each buf_temp-diasize-handle
     2000         on error undo move_block, retry move_block
     2001         :
     2002           assign
     2003             v-object-handle = buf_temp-diasize-handle.handle-value
     2004           .
     2005           if v-object-handle <> v-diasize-resize-button
     2006           then do:
     2007             assign
     2008               v-object-handle :col = v-object-handle :col + p-change-value
     2009               no-error .
     2010             if error-status :error
     2011             or error-status :get-message(1) <> ""
     2012             then do:
     2013               undo move_block, retry move_block .
     2014             end.
     2015           end.
     2016         end.
     2017         for each buf_temp-browse-handle
     2018           where buf_temp-browse-handle.browse-type = 'width':u
     2019         on error undo move_block, retry move_block
     2020         :
     2021           assign
     2022             buf_temp-browse-handle.browse-handle :width
     2023               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2024             no-error .
     2025           if error-status :error
     2026           or error-status :get-message(1) <> ""
     2027           then do:
     2028             undo move_block, retry move_block .
     2029           end.
     2030         end.
     2031         assign
     2032           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2033           no-error .
     2034         if error-status :error
     2035         or error-status :get-message(1) <> ""
     2036         then do:
     2037           undo move_block, retry move_block.
     2038         end.
     2039         assign
     2040           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2041         no-error .
     2042         if error-status :error
     2043         or error-status :get-message(1) <> ""
     2044         then do:
     2045           undo move_block, retry move_block.
     2046         end.
     2047         if frame Dialog-Frame :scrollable = true
     2048         then do:
     2049           assign
     2050             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2051           no-error .
     2052           if error-status :error
     2053           or error-status :get-message(1) <> ""
     2054           then do:
     2055             undo move_block, retry move_block.
     2056           end.
     2057         end.
     2058       end.
     2059       if p-move-resize
     2060       then do:
     2061         run diasize_position-resize-button in this-procedure .
     2062       end.
     2063       if v-diasize-wndstore = true
     2064       then do:
     2065         if connected("ub") = true
     2066         then do:
     2067           define variable v-cntxt-db-num        as integer   no-undo .
     2068           define variable v-cntxt-userid        as character no-undo .
     2069           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2070                                             , OUTPUT v-cntxt-userid
     2071                                             ) .
     2072           run gbl/wndsizew.p
     2073             (input  v-cntxt-db-num
     2074             ,input  v-cntxt-userid
     2075             ,input  v-diasize-proc-name
     2076             ,input  'width':u
     2077             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2078             ) .
     2079         end.
     2080       end.
     2081     end.
     2082     assign
     2083       v-diasize-change-size = false
     2084     .
     2085   end procedure.
     2086   procedure diasize_set-width :
     2087     define input  parameter p-new-width  as decimal   no-undo .
     2088     define input  parameter p-move-resize as logical   no-undo .
     2089     do
     2090     on error undo, return error return-value
     2091     :
     2092       run diasize_change-width in this-procedure
     2093         (input  (p-new-width - frame Dialog-Frame :width)
     2094         ,input  p-move-resize
     2095         ) .
     2096     end.
     2097   end procedure.
     2098   procedure diasize_position-resize-button :
     2099     do with frame Dialog-Frame
     2100     :
     2101       hide v-diasize-resize-button .
     2102       assign
     2103         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2104                     - 1
     2105                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2106         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2107                     - 1
     2108                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2109       .
     2110       view v-diasize-resize-button .
     2111     end.
     2112   end procedure.
     2113   on alt-right anywhere
     2114   do:
     2115     run diasize_change-width in this-procedure
     2116       (input 1
     2117       ,input true
     2118       ) .
     2119     return no-apply .
     2120   end.
     2121   on alt-left anywhere
     2122   do:
     2123     run diasize_change-width in this-procedure
     2124       (input -1
     2125       ,input true
     2126       ) .
     2127     return no-apply .
     2128   end.
     2129   on alt-down anywhere
     2130   do:
     2131     run diasize_change-height in this-procedure
     2132       (input 1
     2133       ,input true
     2134       ) .
     2135     return no-apply .
     2136   end.
     2137   on alt-up anywhere
     2138   do:
     2139     run diasize_change-height in this-procedure
     2140       (input -1
     2141       ,input true
     2142       ) .
     2143     return no-apply .
     2144   end.
     2145   on alt-enter of frame Dialog-Frame
     2146   do:
     2147     run diasize_maximize in this-procedure
     2148       (input  ?
     2149       ).
     2150     return no-apply .
     2151   end.
     2152   procedure diasize_end-move :
     2153     do
     2154     on error undo, return error return-value
     2155     :
     2156       define variable v-row-delta as decimal   no-undo .
     2157       define variable v-col-delta as decimal   no-undo .
     2158       define variable v-new-row as decimal   no-undo .
     2159       define variable v-new-col as decimal   no-undo .
     2160       assign
     2161         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2162         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2163       .
     2164       assign
     2165         v-row-delta = v-new-row - frame Dialog-Frame :height
     2166         v-col-delta = v-new-col - frame Dialog-Frame :width
     2167       .
     2168       run diasize_change-height in this-procedure
     2169         (input v-row-delta
     2170         ,input true
     2171         ) .
     2172       run diasize_change-width in this-procedure
     2173         (input v-col-delta
     2174         ,input true
     2175         ) .
     2176     end.
     2177   end procedure.
     2178   procedure diasize_maximize :
     2179     define input  parameter p-action as logical   no-undo .
     2180     do
     2181     on error undo, return error return-value
     2182     :
     2183       if p-action = ?
     2184       then do:
     2185         if v-diasize-need-maximize = true
     2186         then do:
     2187           assign
     2188             p-action = true
     2189           .
     2190         end.
     2191         else do:
     2192           assign
     2193             p-action = false
     2194           .
     2195         end.
     2196       end.
     2197       if p-action = true
     2198       then do:
     2199         run diasize_change-height in this-procedure
     2200           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2201               - frame Dialog-Frame :height-chars
     2202           ,input true
     2203           ) .
     2204         run diasize_change-width in this-procedure
     2205           (input session :width-chars
     2206               - frame Dialog-Frame :width-chars
     2207           ,input true
     2208           ) .
     2209         assign
     2210           v-diasize-need-maximize = false
     2211         .
     2212       end.
     2213       else do:
     2214         run diasize_change-width in this-procedure
     2215           (input v-diasize-orig-frame-width
     2216               - frame Dialog-Frame :width-chars
     2217           ,input true
     2218           ) .
     2219         run diasize_change-height in this-procedure
     2220           (input v-diasize-orig-frame-height
     2221               - frame Dialog-Frame :height-chars
     2222           ,input true
     2223           ) .
     2224         assign
     2225           v-diasize-need-maximize = true
     2226         .
     2227       end.
     2228     end.
     2229   end procedure.
     2230   procedure diasize_restore-orig-size :
     2231     do
     2232     on error undo, return error return-value
     2233     :
     2234       assign
     2235         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2236         v-diasize-current-frame-height = frame Dialog-Frame :height
     2237       .
     2238       run diasize_set-height in this-procedure
     2239         (input  v-diasize-orig-frame-height
     2240         ,input  true
     2241         ) .
     2242       run diasize_set-width in this-procedure
     2243         (input  v-diasize-orig-frame-width
     2244         ,input  true
     2245         ) .
     2246     end.
     2247   end procedure.
     2248   procedure diasize_restore-current-size :
     2249     do
     2250     on error undo, return error return-value
     2251     :
     2252       run diasize_set-height in this-procedure
     2253         (input  v-diasize-current-frame-height
     2254         ,input  true
     2255         ) .
     2256       run diasize_set-width in this-procedure
     2257         (input  v-diasize-current-frame-width
     2258         ,input  true
     2259         ) .
     2260     end.
     2261   end procedure.
     2262   procedure diasize_set-browse-handle :
     2263     define input  parameter p-browse-handle as handle   no-undo .
     2264     define buffer buf_temp-browse-handle for temp-browse-handle .
     2265     do
     2266     on error undo, return error return-value
     2267     :
     2268       assign
     2269         v-diasize-browse-handle = p-browse-handle
     2270       .
     2271       for each buf_temp-browse-handle
     2272       on error undo, return error return-value
     2273       :
     2274         delete buf_temp-browse-handle .
     2275       end.
     2276     end.
     2277   end procedure.
     2278   procedure diasize_add_browse :
     2279     define input  parameter p-browse-type   as character no-undo .
     2280     define input  parameter p-browse-handle as handle    no-undo .
     2281     define buffer buf_temp-browse-handle for temp-browse-handle .
     2282     do
     2283     on error undo, return error return-value
     2284     :
     2285       assign
     2286         v-diasize-browse-number = v-diasize-browse-number + 1
     2287       .
     2288       create buf_temp-browse-handle .
     2289       assign
     2290         buf_temp-browse-handle.browse-type   = p-browse-type
     2291         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2292         buf_temp-browse-handle.browse-handle = p-browse-handle
     2293       .
     2294     end.
     2295   end procedure.
     2296   procedure diasize_init :
     2297     define variable v-default-value    as logical   no-undo .
     2298     define variable v-restore-saved    as logical   no-undo .
     2299     define variable v-resize-value-str as character no-undo .
     2300     do
     2301     on error undo, return error return-value
     2302     :
     2303       do with frame Dialog-Frame
     2304       :
     2305         assign
     2306           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2307           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2308           v-diasize-browse-handle     = browse br-dis-cfg-rule :handle
     2309         .
     2310         create button v-diasize-resize-button
     2311         assign
     2312           parent        = frame Dialog-Frame :first-child
     2313           label         = "s"
     2314           height-pixels = 16
     2315           width-pixels  = 16
     2316           visible       = true
     2317           sensitive     = true
     2318           movable       = true
     2319           triggers:
     2320             on end-move persistent run diasize_end-move in this-procedure .
     2321           end triggers.
     2322         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2323         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2324         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2325         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2326         assign
     2327           v-diasize-wndmax = false
     2328         .
     2329         if connected("ub") = true
     2330         then do:
     2331           define variable v-cntxt-db-num        as integer   no-undo .
     2332           define variable v-cntxt-userid        as character no-undo .
     2333           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2334                                             , OUTPUT v-cntxt-userid
     2335                                             ) .
     2336           run gbl/wndpar_r.p
     2337             (input  v-cntxt-db-num
     2338             ,input  v-cntxt-userid
     2339             ,input  'wndmax':U
     2340             ,output v-diasize-wndmax
     2341             ,output v-default-value
     2342             ) .
     2343         end.
     2344         assign
     2345           v-diasize-wndstore = false
     2346         .
     2347         if connected("ub") = true
     2348         then do:
     2349           run gbl/wndpar_r.p
     2350             (input  v-cntxt-db-num
     2351             ,input  v-cntxt-userid
     2352             ,input  'wndstore':U
     2353             ,output v-diasize-wndstore
     2354             ,output v-default-value
     2355             ) .
     2356         end.
     2357         assign
     2358           v-diasize-proc-name = entry(1, program-name(2), '.')
     2359         .
     2360         if v-diasize-wndstore = true
     2361         then do:
     2362           assign
     2363             v-restore-saved = false
     2364           .
     2365           if connected("ub") = true
     2366           then do:
     2367             run gbl/wndsizer.p
     2368               (input  v-cntxt-db-num
     2369               ,input  v-cntxt-userid
     2370               ,input  v-diasize-proc-name
     2371               ,input  'height':u
     2372               ,output v-resize-value-str
     2373               ) .
     2374             if v-resize-value-str <> '':U
     2375             then do:
     2376               run diasize_change-height in this-procedure
     2377                 (input  integer(v-resize-value-str)
     2378                 ,input  true
     2379                 ) .
     2380               assign
     2381                 v-restore-saved = true
     2382               .
     2383             end.
     2384           end.
     2385           if connected("ub") = true
     2386           then do:
     2387             run gbl/wndsizer.p
     2388               (input  v-cntxt-db-num
     2389               ,input  v-cntxt-userid
     2390               ,input  v-diasize-proc-name
     2391               ,input  'width':u
     2392               ,output v-resize-value-str
     2393               ) .
     2394             if v-resize-value-str <> '':U
     2395             then do:
     2396               run diasize_change-width in this-procedure
     2397                 (input  integer(v-resize-value-str)
     2398                 ,input  true
     2399                 ) .
     2400               assign
     2401                 v-restore-saved = true
     2402               .
     2403             end.
     2404           end.
     2405           if v-restore-saved <> true
     2406           then do:
     2407             if v-diasize-wndmax = true
     2408             then do:
     2409               run diasize_maximize in this-procedure
     2410                 (input  true
     2411                 ) .
     2412             end.
     2413           end.
     2414         end.
     2415         else do:
     2416           if v-diasize-wndmax = true
     2417           then do:
     2418             run diasize_maximize in this-procedure
     2419               (input  true
     2420               ) .
     2421           end.
     2422         end.
     2423       end.
     2424     end.
     2425   end procedure.
     2426   procedure diasize_need-full-display :
     2427     define output parameter p-need-full-display as logical   no-undo .
     2428     do
     2429     on error undo, return error return-value
     2430     :
     2431       assign
     2432         p-need-full-display = v-diasize-need-full-display
     2433       .
     2434       assign
     2435         v-diasize-need-full-display = false
     2436       .
     2437     end.
     2438   end procedure.
     2439   procedure get-context :
     2440      define output parameter p-db-num as integer          no-undo.
     2441      define output parameter p-user-id as character        no-undo.
     2442      define variable v-login               as character    no-undo.
     2443      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2444      define buffer buf_user-login  for ub.user-login .
     2445      do
     2446      on error undo, return error
     2447      :
     2448            FIND FIRST buf_sys-ctrl no-lock.
     2449            ASSIGN
     2450               v-login = USERID("ub")
     2451               p-db-num = buf_sys-ctrl.db-num
     2452            .
     2453            FIND FIRST buf_user-login
     2454                 WHERE buf_user-login.db-num = p-db-num
     2455                   AND buf_user-login.user-login = v-login
     2456                 no-lock
     2457                 no-error
     2458                 .
     2459            IF AVAILABLE buf_user-login
     2460            THEN DO:
     2461               assign
     2462                  p-user-id = buf_user-login.user-id
     2463               .
     2464            END.
     2465      end.
     2466   end procedure.
     2467       run diasize_init in this-procedure .
     2468   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2469   on F2 of frame Dialog-Frame anywhere do:
     2470     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2471     return no-apply.
     2472   end.
     2473   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2474   on F3 of frame Dialog-Frame anywhere do:
     2475     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2476     return no-apply.
     2477   end.
     2478   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2479   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2480     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2481     return no-apply.
     2482   end.
     2483   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2484   on F4 of frame Dialog-Frame anywhere do:
     2485     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     2486     return no-apply.
     2487   end.
     2488   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2489   on F8 of frame Dialog-Frame anywhere do:
     2490     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     2491     return no-apply.
     2492   end.
     2493   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2494   on INS of frame Dialog-Frame anywhere do:
     2495     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2496     return no-apply.
     2497   end.
     2498   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2499   on F2 of frame Dialog-Frame anywhere do:
     2500     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2501     return no-apply.
     2502   end.
     2503   MAIN-BLOCK:
     2504   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2505      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2506   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2507     run mainmenu_getcntxt in parparentproc
     2508       (output v-cntxt-db-num
     2509       ,output v-cntxt-userid
     2510       ,output v-cntxt-level
     2511       ,output v-cntxt-host-code-obj
     2512       ,output v-cntxt-obj-type
     2513       ,output v-cntxt-obj-code
     2514       ,output v-cntxt-db-num-obj
     2515       ,output v-cntxt-is-admin
     2516       ) .
     2517     v-rid-list = p-rid-list.
     2518     RUN Myenable IN THIS-PROCEDURE .
     2519     run openbr in this-procedure ( INPUT ?, INPUT ?, INPUT 0, INPUT 0).
     2520     WAIT-FOR GO OF FRAME Dialog-Frame.
     2521   END.
     2522   RUN disable_UI.
     2523   PROCEDURE disable_UI :
     2524     HIDE FRAME Dialog-Frame.
     2525   END PROCEDURE.
     2526   PROCEDURE enable_UI :
     2527     DISPLAY Cb-pos-type Cb-table-name f-templ-rl-root f-dis-rule-des
     2528             f-time-templ-rl-root f-dis-time-rule-des mark-num
     2529         WITH FRAME Dialog-Frame.
     2530     ENABLE b-quit b-mark b-sel b-add b-copy b-chg b-del b-lkp b-print B-Help
     2531            Cb-pos-type Cb-table-name b-dis-ruls f-templ-rl-root f-dis-rule-des
     2532            b-dist-rls f-time-templ-rl-root f-dis-time-rule-des br-dis-cfg-rule
     2533            mark-num
     2534         WITH FRAME Dialog-Frame.
     2535     VIEW FRAME Dialog-Frame.
     2536   END PROCEDURE.
     2537   PROCEDURE MyEnable :
     2538   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2539   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     2540   DEFINE VARIABLE v-list-items AS CHARACTER NO-UNDO.
     2541   DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
     2542   ch = br-dis-cfg-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     2543   DO ii = 1 TO br-dis-cfg-rule:NUM-COLUMNS IN FRAME Dialog-Frame:
     2544       ASSIGN
     2545       ch:RESIZABLE = YES.
     2546       ch = ch:NEXT-COLUMN.
     2547   END.
     2548   assign
     2549   v-list-items = "Все":U + chr(44) + "":U.
     2550   DO v-ii = 1 TO NUM-ENTRIES('IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U):
     2551       ASSIGN
     2552       v-list-items = v-list-items +  chr(44) +
     2553                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,MARIA,Накладная,Бэкофис':U) + chr(44) +
     2554                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U).
     2555   END.
     2556   assign
     2557   cb-pos-type:list-item-pairs in frame Dialog-Frame = v-list-items.
     2558   assign
     2559   cb-table-name:list-item-pairs in frame Dialog-Frame =
     2560   "Все":U + chr(44) + "":U + chr(44) +
     2561   'Скидка Товара на объ.':U + chr(44) +
     2562   'dis-gds-rule':U + chr(44) +
     2563   'Общие скидки':U + chr(44) +
     2564   'dis-thbj-rule':U + chr(44) +
     2565   'Скидки на платеж':U + chr(44) +
     2566   'dis-cp-rule':U + chr(44) +
     2567   'Скидки для ДК':U + chr(44) +
     2568   'dis-dc-rule':U + chr(44) +
     2569   'Скидки на типы ДК':U + chr(44) +
     2570   'dis-dct-rule':U + chr(44) +
     2571   'Скидки по группе':U + chr(44) +
     2572   'dis-grp-rule':U
     2573   .
     2574   DISPLAY mark-num
     2575   WITH FRAME Dialog-Frame.
     2576   ENABLE
     2577   b-quit
     2578   B-add WHEn (v-cntxt-db-num = 0)
     2579   B-copy WHEn (v-cntxt-db-num = 0)
     2580   B-chg WHEn (v-cntxt-db-num = 0)
     2581   B-del WHEn (v-cntxt-db-num = 0)
     2582   B-mark WHEn LOOKUP("b-mark", bttns) > 0
     2583   B-sel WHEN LOOKUP("b-sel", bttns) > 0
     2584   b-print
     2585   B-Help
     2586   b-lkp
     2587   br-dis-cfg-rule
     2588   mark-num
     2589   cb-pos-type
     2590   cb-table-name
     2591   b-dis-ruls
     2592   b-dist-rls
     2593   WITH FRAME Dialog-Frame.
     2594   VIEW FRAME Dialog-Frame.
     2595   HIDE
     2596   mark-num
     2597   IN FRAME Dialog-Frame.
     2598   END PROCEDURE.
     2599   PROCEDURE openbr :
     2600   DEFINE INPUT PARAMETER p-pos-type AS CHARACTER NO-UNDO.
     2601   DEFINE INPUT PARAMETER p-table-name AS CHARACTER NO-UNDO.
     2602   DEFINE INPUT PARAMETER p-templ-rl-root AS integer NO-UNDO.
     2603   DEFINE INPUT PARAMETER p-time-templ-rl-root AS integer NO-UNDO.
     2604   OPEN QUERY br-dis-cfg-rule
     2605   FOR EACH X_dis-cfg-rule NO-LOCK WHERE X_dis-cfg-rule.table-name > '':U and
     2606           (p-pos-type = ? OR X_dis-cfg-rule.pos-type = p-pos-type)
     2607       AND (p-table-name = ? OR X_dis-cfg-rule.table-name = p-table-name)
     2608       AND (p-templ-rl-root = 0 OR X_dis-cfg-rule.templ-rl-root = p-templ-rl-root)
     2609       AND (p-time-templ-rl-root = 0 OR X_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     2610       ,
     2611             first X_dis-rule NO-LOCK WHERE
     2612             X_dis-rule.rule-num  = X_dis-cfg-rule.templ-rl-root
     2613             INDEXED-REPOSITION.
     2614   END PROCEDURE.
     2615   PROCEDURE proc-b-print :
     2616   define variable v-doc-rec as recid no-undo .
     2617   define variable accum-count as integer.
     2618   define variable date_string     as      char    no-undo.
     2619   define variable Line            as      char    no-undo.
     2620   DEFINE VARIABLE v-rule-name AS CHARACTER no-undo.
     2621   DEFINE VARIABLE v-has-global AS logical NO-UNDO.
     2622   DEFINE VARIABLE v-has-host AS logical NO-UNDO.
     2623   DEFINE VARIABLE v-has-obj AS logical NO-UNDO.
     2624   DEFINE VARIABLE v-link-name AS CHARACTER NO-UNDO.
     2625   DEFINE FRAME dis-cfg-rule-list
     2626   X_dis-cfg-rule.pos-type FORMAT "X(15)":U COLUMN-LABEL "Место использ"
     2627   X_dis-cfg-rule.discnt-role  COLUMN-LABEL "Роль скидки" FORMAT "X(20)":U
     2628   v-rule-name COLUMN-LABEL "Роль скидки" FORMAT "X(35)":U
     2629   X_dis-cfg-rule.templ-rl-root FORMAT ">>>>9":U COLUMN-LABEL "Код!шабл"
     2630   X_dis-cfg-rule.time-templ-rl-root FORMAT "->>>>9":U COLUMN-LABEL "Код!шабл!распис"
     2631   X_dis-rule.des FORMAT "X(45)":U
     2632   v-has-global  FORMAT "+/" COLUMN-LABEL "Глоб"
     2633   v-has-host FORMAT "+/" COLUMN-LABEL "Фирма"
     2634   v-has-obj FORMAT "+/" COLUMN-LABEL "Объ"
     2635   X_dis-cfg-rule.self-nonunique FORMAT "X(18)" COLUMN-LABEL "Собств.Неуник"
     2636   X_dis-cfg-rule.nonunique FORMAT "X(20)" COLUMN-LABEL "Неуник"
     2637   X_dis-cfg-rule.table-name FORMAT "X(12)" COLUMN-LABEL "Таблица!связи"
     2638   v-link-name FORMAT "X(30)" COLUMN-LABEL "Вид связи"
     2639   HEADER  date_string AT 5 format "X(35)"
     2640    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     2641   Line format "X(195)" AT 1
     2642   with width 232 down stream-io use-text    .
     2643   Line = fill("-", 195).
     2644   date_string = cur-time-print() .
     2645   run prn-lib-open-stream  in this-procedure (
     2646                                                input parParentProc
     2647                                               ,input 43
     2648                                               ,input yes
     2649                                               ,input no
     2650                                               ).
     2651   PUT  STREAM PrnLibStream
     2652   SPACE(25) ( frame Dialog-Frame:title )
     2653   format "x(90)" SKIP(1) .
     2654   FORM HEADER
     2655   Line format "X(195)" AT 1 SKIP
     2656   "Продолжение - на следующей странице" AT 30 SKIP
     2657   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2658   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2659   FORM with FRAME dis-cfg-rule-list  .
     2660   run waitfram-show in this-procedure ("Ждите...").
     2661   v-doc-rec = recid(X_dis-cfg-rule).
     2662   DO WHILE available X_dis-cfg-rule :
     2663     GET prev br-dis-cfg-rule.
     2664   END.
     2665   GET next br-dis-cfg-rule.
     2666   DO WHILE available X_dis-cfg-rule :
     2667     Display STREAM PrnLibStream
     2668     X_dis-cfg-rule.pos-type
     2669     X_dis-cfg-rule.discnt-role
     2670     rule-name( INPUT X_dis-cfg-rule.table-name, INPUT X_dis-cfg-rule.self-nonunique, INPUT X_dis-cfg-rule.discnt-role) @ v-rule-name
     2671     X_dis-cfg-rule.templ-rl-root
     2672     X_dis-cfg-rule.time-templ-rl-root
     2673     X_dis-rule.des
     2674     logical(X_dis-cfg-rule.has-global) @ v-has-global
     2675     logical(X_dis-cfg-rule.has-host) @ v-has-host
     2676     logical(X_dis-cfg-rule.has-obj) @ v-has-obj
     2677     X_dis-cfg-rule.self-nonunique
     2678     X_dis-cfg-rule.nonunique
     2679     X_dis-cfg-rule.table-name
     2680     entry (lookup (STRING(X_dis-cfg-rule.link-prop), '0,1,2,3,-2,-1':U) + 1, ',':U + 'Объект<=>правило,->Условие правила,Объект<=>Ветка правила,Объект<=>Ссылка на правило,Объект<=>Свойство<=>правило,Объект<=>Нет правила':U) @ v-link-name
     2681     with FRAME dis-cfg-rule-list .
     2682     DOWN STREAM PrnLibStream 1
     2683     with FRAME dis-cfg-rule-list  .
     2684     assign
     2685     accum-count = accum-count + 1
     2686     .
     2687     GET next br-dis-cfg-rule.
     2688   END.
     2689   UNDERLINE  STREAM PrnLibStream
     2690   X_dis-cfg-rule.pos-type
     2691   X_dis-cfg-rule.discnt-role
     2692   v-rule-name
     2693   X_dis-cfg-rule.templ-rl-root
     2694   X_dis-cfg-rule.time-templ-rl-root
     2695   X_dis-rule.des
     2696   v-has-global
     2697   v-has-host
     2698   v-has-obj
     2699   X_dis-cfg-rule.self-nonunique
     2700   X_dis-cfg-rule.nonunique
     2701   X_dis-cfg-rule.table-name
     2702   v-link-name
     2703   with FRAME dis-cfg-rule-list .
     2704   DISPLAY STREAM PrnLibStream
     2705   "ИТОГО" @ X_dis-cfg-rule.pos-type
     2706   accum-count @ X_dis-cfg-rule.templ-rl-root
     2707   with frame dis-cfg-rule-list.
     2708   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2709   HIDE  STREAM PrnLibStream FRAME dis-cfg-rule-List.
     2710   output  STREAM PrnLibStream CLOSE.
     2711   REPOSITION br-dis-cfg-rule to recid v-doc-rec no-error.
     2712   APPLY "entry" to br-dis-cfg-rule.
     2713   run waitfram-hide in this-procedure .
     2714   run prn-lib-prn-file in this-procedure (
     2715                                             input parParentProc
     2716                                             ,input 8
     2717                                             ).
     2718   END PROCEDURE.
     2719   FUNCTION rule-name RETURNS CHARACTER
     2720     ( INPUT p-subject AS character, INPUT p-self-nonunique AS character, input p-discnt-role AS character ) :
     2721   DEFINE VARIABLE v-rule-name AS CHARACTER NO-UNDO.
     2722   CASE p-subject :
     2723     WHEN 'dis-gds-rule':U THEN DO:
     2724       v-rule-name = entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     2725     END.
     2726     WHEN 'dis-thbj-rule':U THEN DO:
     2727       v-rule-name = entry (lookup (p-discnt-role, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u).
     2728     END.
     2729     WHEN 'dis-cp-rule':U THEN DO:
     2730       v-rule-name = entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u).
     2731     END.
     2732     WHEN 'dis-dc-rule':U THEN DO:
     2733       v-rule-name = entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u).
     2734     END.
     2735     WHEN 'dis-dct-rule':U THEN DO:
     2736       v-rule-name = entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u).
     2737     END.
     2738     WHEN 'dis-grp-rule':U THEN DO:
     2739       if p-self-nonunique = 'sum-grp':U then do:
     2740         v-rule-name = entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u).
     2741       end.
     2742       if p-self-nonunique = 'cli-grp':U then do:
     2743         v-rule-name = entry (lookup (p-discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u).
     2744       end.
     2745     END.
     2746   END CASE.
     2747   RETURN v-RULE-name.
     2748   END FUNCTION.
