      427   on error undo, return error return-value
      428   :
      429       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      430       (input  p-ucode
      431       ,input  p-code
      432       ,output  p-section-num
      433       ) no-error .
      434     if error-status :error
      435     then do:
      436       undo, return error return-value .
      437     end.
      438   end.
      439   end procedure.
      440   define buffer buf_clob-bind for ub.clob-bind.
      441   define buffer buf_clob-data for ub.clob-data.
      442   define variable extFormF1Obj        as class ExtFormF1         no-undo.
      443   define variable parserWBObj      as class ParserXMLDocWB no-undo.
      444   define variable v-objCode         as integer   no-undo.
      445   define variable ii                as integer   no-undo.
      446   define variable v-objType         as character no-undo.
      447   define variable v-FormF1-code     as character no-undo.
      448   define variable v-alc-code        as character no-undo.
      449   define variable hDoc              as handle    no-undo.
      450   define stream out.
      451   output stream out to formF1.txt.
      452   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      453   define variable v-waitfram-action01         as character   no-undo .
      454   define variable v-waitfram-action02         as character   no-undo .
      455   define variable v-waitfram-action03         as character   no-undo .
      456   define variable mWaitFramTextBeg            as character   no-undo.
      457   define variable mWaitFramTextEnd            as character   no-undo.
      458   define variable mWaitFramView               as logical     no-undo.
      459   define variable mWaitProcEvent              as logical     no-undo init yes.
      460   define variable mWaitFramInterval           as integer     no-undo init 1 .
      461   define variable mWaitFramStop               as logical     no-undo.
      462   define variable mWaitFramStopUser           as logical     no-undo.
      463   define variable mWaitFramStopTimeOut        as logical     no-undo.
      464   define variable mWaitFramStartProc          as datetime-tz no-undo.
      465   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      466   define button B-WaitFramStop auto-end-key
      467        label "Стоп"
      468        size 10 by 1 tooltip "Остоновить процесс".
      469   define button B-viewProcInfo
      470        label "Информация"
      471        size 15 by 1 tooltip "Информация о процесс".
      472   define frame waitfram
      473     v-waitfram-action01 format "x(72)" no-label skip
      474     v-waitfram-action02 format "x(72)" no-label skip
      475     v-waitfram-action03 format "x(72)" no-label skip
      476     B-viewProcInfo
      477     B-WaitFramStop at row 4 col 30
      478     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      479     .
      480   define new global shared variable mBatchMode as logical no-undo init ?.
      481   define variable mFramBachModHandle as handle no-undo.
      482   mFramBachModHandle = frame waitfram:handle.
      483   define variable mFameOldVis as logical no-undo.
      484   define variable mVisCUrentVin as logical no-undo.
      485   if session:batch-mode
      486   then
      487      mBatchMode = yes.
      488   if mBatchMode = ? then do:
      489     mVisCUrentVin = current-window:visible.
      490     mFameOldVis = mFramBachModHandle:visible.
      491     mFramBachModHandle:visible  = yes.
      492     mBatchMode = mFramBachModHandle:visible ne yes.
      493     mFramBachModHandle:visible = mFameOldVis.
      494     current-window:visible = mVisCUrentVin.
      495   end.
      496    if  log-manager:logfile-name ne ?
      497     then DO:
      498         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      499         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      500         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      501     end.
      502   on choose of B-WaitFramStop in frame waitfram
      503   do:
      504     mWaitFramStop = yes.
      505     mWaitFramStopUser = yes.
      506   end.
      507   function waitfram-check-timeout returns logical():
      508      define variable vtime as int64 no-undo.
      509      if mWaitFramStopTimeOut
      510      then
      511         return yes.
      512      vtime = ( now - mWaitFramStartProc ) / 1000 .
      513      if     mWaitFramTimeOut ne ?
      514         and mWaitFramTimeOut ne 0
      515         and mWaitFramTimeOut lt vtime
      516      then do:
      517         mWaitFramStopTimeOut = yes.
      518      end.
      519      return mWaitFramStopTimeOut.
      520   end.
      521   procedure waitfram-hide :
      522     if not session:batch-mode
      523     then do
      524     on error undo, return error return-value
      525     :
      526       pause 0 before-hide .
      527       if not mBatchMode then
      528         hide frame waitfram .
      529     if     not mWaitFramView
      530        and mWaitProcEvent
      531     then
      532       process events .
      533     end.
      534   end procedure.
      535   procedure waitfram-show :
      536     define input  parameter p-message as character no-undo .
      537     define variable v-left-margin as integer   no-undo .
      538     if not session:batch-mode
      539     then do
      540     on error undo, return error return-value
      541     :
      542       if length(p-message) <= 70 then do:
      543         assign
      544           v-left-margin = integer((70 - length(p-message)) / 2)
      545         .
      546         assign
      547           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      548         .
      549         assign
      550           v-waitfram-action01 = " "
      551           v-waitfram-action02 = " "
      552                                    + fill(" ", v-left-margin)
      553                                    + p-message
      554           v-waitfram-action03 = " "
      555         .
      556       end.
      557       else do:
      558         define variable vRindex1 as integer no-undo.
      559         define variable vRindex2 as integer no-undo.
      560         vRindex1 = r-index(p-message," ",70).
      561         if vRindex1 = 0
      562         then
      563            vRindex1 = 70.
      564         if length(p-message)  <= vRindex1 + 70 then do:
      565           assign
      566             v-waitfram-action01 = " "
      567             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      568             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      569           .
      570         end.
      571         else do:
      572           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      573           if vRindex2 <= vRindex1
      574           then
      575              vRindex2 = vRindex1 + 70.
      576           assign
      577             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      578             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      579             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      580           .
      581         end.
      582       end.
      583       B-viewProcInfo:visible   in frame waitfram = no.
      584       B-viewProcInfo:sensitive in frame waitfram = no.
      585       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      586       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      587       if  (   mWaitFramView
      588          or  mWaitProcEvent)
      589          and not mBatchMode
      590       then
      591          display
      592             v-waitfram-action01 skip
      593             v-waitfram-action02 skip
      594             v-waitfram-action03 skip
      595          with frame waitfram .
      596       if     mWaitFramView
      597          then do:
      598             if     mWaitFramInterval ne ?
      599                and not mBatchMode
      600             then
      601                wait-for go of frame waitfram pause mWaitFramInterval.
      602          end.
      603          else
      604             if     mWaitProcEvent
      605                and not mBatchMode
      606             then
      607                process events .
      608     end.
      609   end procedure.
      610      procedure waitfram-show-this:
      611         define input  parameter iInterval as int64 no-undo.
      612         define variable vtime as int64 no-undo.
      613         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      614         mWaitFramInterval = iInterval.
      615         run waitfram-show (substitute("&1&2 &3&4" ,
      616                                       mWaitFramTextBeg ,
      617                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      618                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      619                                       mWaitFramTextEnd
      620                                      )
      621                           ).
      622      end.
      623      procedure WaitFramRunPause:
      624         define input  parameter iInterval as dec no-undo.
      625         define variable vStart  as datetime-tz no-undo.
      626         define variable vend    as datetime-tz no-undo.
      627         define variable vint as int64 no-undo.
      628         define variable vOk as logical no-undo.
      629         vStart = now.
      630         vend   = vStart.
      631         publish "WaitFramPause" (iInterval,output vOk).
      632         vend   =  now.
      633         vint = vend - vStart.
      634         vint = iInterval - vint / 1000.
      635         if     not mWaitFramStop
      636            and (   vint > 0
      637                 or (    not vOk
      638                     and iInterval eq ?
      639                     )
      640                 )
      641         then
      642            run waitfram-show-this (iInterval).
      643         vend   =  now.
      644         vint = vend - vStart.
      645         vint = iInterval - vint / 1000.
      646         if     not mWaitFramStop
      647            and vint > 0
      648         then do:
      649            run gbl/pause.p (vint * 1000).
      650         end.
      651         if iInterval ne ?
      652         then
      653            publish "WaitFramStop".
      654         waitfram-check-timeout().
      655      end.
      656      procedure WaitFramWaitFor:
      657         define input  parameter iInterval as dec no-undo.
      658         assign
      659            mWaitFramStartProc   = now
      660            mWaitFramStopUser    = no
      661            mWaitFramStopTimeOut = no
      662         .
      663         block-wait:
      664         do while not mWaitFramStop:
      665            run WaitFramRunPause (iInterval).
      666            if  waitfram-check-timeout()
      667            then do:
      668               leave block-wait.
      669            end.
      670         end.
      671         run waitfram-hide.
      672      end.
      673   procedure waitfram-join :
      674     define input  parameter p-line-1  as character no-undo .
      675     define input  parameter p-line-2  as character no-undo .
      676     define input  parameter p-line-3  as character no-undo .
      677     define output parameter p-message as character no-undo .
      678     do
      679     on error undo, return error return-value
      680     :
      681       assign
      682         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      683                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      684                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      685       .
      686     end.
      687   end procedure.
      688   function waitfram-join-function returns character
      689     (input p-line-1 as character
      690     ,input p-line-2 as character
      691     ,input p-line-3 as character
      692     ).
      693     define variable v-message as character no-undo .
      694     run waitfram-join in this-procedure
      695       (input  p-line-1
      696       ,input  p-line-2
      697       ,input  p-line-3
      698       ,output v-message
      699       ) .
      700     return v-message .
      701   end function .
      702   do:
      703     run waitfram-show in this-procedure
      704     (input substitute("Идет создание справок 1")
      705     ) .
      706     extFormF1Obj = new extFormF1 (true).
      707     parserWBObj = new ParserXMLDocWB (extFormF1Obj:ExtSystem).
      708     for each buf_clob-bind no-lock where buf_clob-bind.resource-type = 'egais-wb':U:
      709       find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      710       run createhDoc(recid (buf_clob-data), "utl-egais-wb-temp.xml", output hDoc).
      711       if error-status:error
      712         then next.
      713       parserWBObj:ParseRec(hDoc, ?, input-output table tt-wb-header, input-output table tt-wb-gds-EG, input-output table tt-wb-info-client).
      714       find first tt-wb-header.
      715       for each tt-wb-gds-EG:
      716         if (tt-wb-gds-EG.importer-list <> "" and tt-wb-gds-EG.importer-list <> chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)) or entry (7, tt-wb-gds-EG.prod-list, chr(5)) = 'FO'
      717         then do:
      718           do trans:
      719             if extFormF1Obj:CreateExtFormF1(tt-wb-gds-EG.refA, tt-wb-gds-EG.alc-code)
      720             then do:
      721               put stream out unformatted substitute ("Создана запись: &1/&2 на основе накладной &3 от &4", tt-wb-gds-EG.refA, tt-wb-gds-EG.alc-code, tt-wb-header.num, tt-wb-header.wb-date) chr(10).
      722               ii = ii + 1.
      723             end.
      724           end.
      725         end.
      726       end.
      727     end.
      728     message "Завершено. Добавлено справок 1 - " ii " См. лог - " search ('formF1.txt')  view-as alert-box.
      729     run waitfram-hide in this-procedure .
      730   end.
      731   procedure createhDoc:
      732     define input parameter inRecCD as recid no-undo.
      733     define input parameter inFileName as char no-undo.
      734     define output parameter outhDoc as handle no-undo.
      735     define buffer buf_cd for ub.clob-data.
      736     find first buf_cd where recid (buf_cd) = inRecCD no-lock no-error.
      737     if not available (buf_cd)
      738      then return error.
      739     copy-lob
      740       from  object buf_cd.cdata
      741       to  file inFileName
      742       no-convert
      743       no-error .
      744     create x-document outhDoc.
      745     outhDoc:encoding = 'utf-8'.
      746     outhDoc:load("file", search (inFileName), false).
      747     release buf_cd.
      748   end.
