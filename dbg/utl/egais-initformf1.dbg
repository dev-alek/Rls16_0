      154   procedure thbjattr_code :
      155      define input  parameter p-upper-code     as character no-undo .
      156      define input  parameter p-code           as character no-undo .
      157      define output parameter p-label          as character no-undo .
      158      define output parameter p-user-can-edit  as logical   no-undo .
      159      define output parameter p-output-display as logical   no-undo .
      160      define output parameter p-other          as character no-undo .
      161      define output parameter p-prop-list      as character no-undo .
      162      define output parameter p-prop-type-list as character no-undo .
      163      define output parameter p-prop-label-list as character no-undo .
      164      define output parameter p-global          as logical no-undo .
      165      define output parameter p-host           as logical no-undo .
      166      define output parameter p-shop           as logical no-undo .
      167      define output parameter p-store          as logical no-undo .
      168      define output parameter p-db             as logical no-undo .
      169      define variable p-region as logical no-undo.
      170      run thbjattr_code_reg in this-procedure (
      171                                               p-upper-code,
      172                                               p-code,
      173                                               output p-label,
      174                                               output p-user-can-edit,
      175                                               output p-output-display,
      176                                               output p-other,
      177                                               output p-prop-list,
      178                                               output p-prop-type-list,
      179                                               output p-prop-label-list,
      180                                               output p-global,
      181                                               output p-host,
      182                                               output p-shop,
      183                                               output p-store,
      184                                               output p-db,
      185                                               output p-region
      186                                               ).
      187   end procedure.
      188   procedure thbjattr_code_reg :
      189   define input  parameter p-upper-code     as character no-undo .
      190   define input  parameter p-code           as character no-undo .
      191   define output parameter p-label          as character no-undo .
      192   define output parameter p-user-can-edit  as logical   no-undo .
      193   define output parameter p-output-display as logical   no-undo .
      194   define output parameter p-other          as character no-undo .
      195   define output parameter p-prop-list      as character no-undo .
      196   define output parameter p-prop-type-list as character no-undo .
      197   define output parameter p-prop-label-list as character no-undo .
      198   define output parameter p-global          as logical no-undo .
      199   define output parameter p-host           as logical no-undo .
      200   define output parameter p-shop           as logical no-undo .
      201   define output parameter p-store          as logical no-undo .
      202   define output parameter p-db             as logical no-undo .
      203   define output parameter p-region         as logical no-undo .
      204   do
      205   on error undo, return error return-value
      206   :
      207       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      208       (input  p-upper-code
      209       ,input  p-code
      210       ,output p-label
      211       ,output p-user-can-edit
      212       ,output p-output-display
      213       ,output p-other
      214       ,output p-prop-list
      215       ,output p-prop-type-list
      216       ,output p-prop-label-list
      217       ,output p-global
      218       ,output p-host
      219       ,output p-shop
      220       ,output p-store
      221       ,output p-db
      222       ,output p-region
      223       ) no-error .
      224     if error-status :error
      225     then do:
      226       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      227     end.
      228   end.
      229   end procedure.
