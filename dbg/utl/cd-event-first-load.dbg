      215   procedure load-line :
      216   define input parameter p-id            as integer          no-undo.
      217   define input parameter p-level         as integer          no-undo.
      218   define input parameter p-name          as character        no-undo.
      219   define input parameter p-status        as integer          no-undo.
      220   define input parameter p-type          as character        no-undo.
      221   define input parameter p-description   as character        no-undo.
      222   define buffer buf_cd-events      for ub.cd-events .
      223   do
      224   on error undo, return error
      225   :
      226      FIND FIRST buf_cd-events
      227           WHERE buf_cd-events.event-id = p-id
      228           NO-LOCK
      229           NO-ERROR
      230           .
      231      IF AVAILABLE buf_cd-events
      232      THEN DO:
      233         RETURN ERROR SUBSTITUTE("Уже есть событие с номером &1", p-id).
      234      END.
      235      CREATE buf_cd-events.
      236      ASSIGN
      237         buf_cd-events.event-id          = p-id
      238         buf_cd-events.event-level       = p-level
      239         buf_cd-events.event-name        = p-name
      240         buf_cd-events.event-status      = p-status
      241         buf_cd-events.event-type        = p-type
      242         buf_cd-events.event-description = p-description
      243      NO-ERROR .
      244      IF ERROR-STATUS:ERROR
      245      THEN DO:
      246         RETURN ERROR SUBSTITUTE("Ошибка создания записи &1&2&3", p-id, chr(10), error-status :get-message (1)).
      247      END.
      248      RETURN.
      249   end.
      250   end procedure.
