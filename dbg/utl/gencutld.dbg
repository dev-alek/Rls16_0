        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: gencutld.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/gencutld.p $":U .
        7   define variable vss-description as character no-undo init "Генерация include-файлов по пирогу обрезания".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define stream upgstream.
       67   define stream genstream.
       68   define temp-table list-action no-undo
       69     field action         as character format "x(15)" label "Процедура"
       70     field file-name      as character
       71     index pi is unique primary
       72       file-name ascending
       73     .
       74   define variable v-gen-dir       as character no-undo .
       75   define variable v-dir-name      as character no-undo .
       76   define variable v-gen-file      as character no-undo .
       77   define variable v-type          as character no-undo .
       78   define variable v-filename     as character no-undo.
       79   define variable v-fullfilename as character no-undo.
       80   define variable v-can-write     as logical   no-undo .
       81   define variable v-gen-file-list as character no-undo .
       82   run gbl/d-prompt.w (
       83       'title=':u + "Введите имя директории" + '\':u
       84     + 'text1=':u + "Введите имя директории" + '\':u
       85     + 'text2=':u + "где будут созданы файлы по структуре 'пирога' обрезания" + '\':u
       86     + 'format=x(256)\':u
       87     + 'type=char\':u
       88     ,input-output v-gen-dir
       89     ).
       90   if return-value = 'false':u then do:
       91     return .
       92   end.
       93   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   if trim( v-gen-dir ) = "":U then do:
       95     assign
       96       v-gen-dir = ".":U
       97     .
       98   end.
       99   assign
      100     file-info:file-name = v-gen-dir
      101   .
      102   if file-info :full-pathname = ""
      103   or file-info :full-pathname = ?  then do:
      104     message
      105       vss-workfile vss-revision vss-description skip
      106       substitute( "Уазанный каталог (&1) не найден!", v-gen-dir ) skip
      107       view-as alert-box error .
      108     undo, return error .
      109   end.
      110   assign
      111     v-gen-dir = file-info:full-pathname + "/":U
      112   .
      113     run gbl/dir-cre.p ( input v-gen-dir + "utl":U ) no-error .
      114     if error-status:error then do:
      115       message
      116         vss-workfile vss-revision vss-description skip
      117         substitute( "Ошибка при создании каталога &1", v-gen-dir + "utl":U ) skip
      118         error-status :get-message(1) skip
      119         return-value skip
      120         view-as alert-box error .
      121       undo, return error.
      122     end.
      123   run gbl/d-prompt.w (
      124       'title=':u + "Введите имя каталога" + '\':u
      125     + 'text1=':u + "Введите имя каталога 'пирога' обрезания" + '\':u
      126     + 'format=x(256)\':u
      127     + 'type=char\':u
      128     ,input-output v-dir-name
      129     ).
      130   if return-value = 'false':u then do:
      131     return .
      132   end.
      133   assign
      134     file-info :file-name = v-dir-name
      135   .
      136   if file-info :full-pathname = ""
      137   or file-info :full-pathname = ?  then do:
      138     message
      139       vss-workfile vss-revision vss-description skip
      140       substitute( "Каталог: &1 ('пирог') не найден !!!", v-dir-name ) skip
      141       return-value skip
      142       error-status :get-message ( error-status :num-messages )
      143       view-as alert-box error
      144     .
      145     undo, return error .
      146   end.
      147   assign
      148     v-dir-name = file-info :full-pathname
      149   .
      150   input stream upgstream from os-dir ( v-dir-name ) .
      151   repeat:
      152     import stream upgstream v-filename v-fullfilename v-type.
      153     if v-type = "f" then do:
      154       if num-entries( v-filename, "." ) > 1
      155         and lookup(entry( num-entries( v-filename, "." ), v-filename, "." ), "p,w") > 0
      156       then do:
      157         create list-action .
      158         assign
      159           list-action.action    = entry( num-entries( v-filename, "." ), v-filename, "." )
      160           list-action.file-name = (if entry(num-entries(v-dir-name,"\"),v-dir-name,"\") = "cut" then "cut":U else "cleandb")
      161                                 + "/" + v-filename
      162         .
      163       end.
      164       else do:
      165         message
      166           substitute( 'В каталоге пирога есть недопустимый файл &1', v-filename ) skip
      167           "Файл будет проигнорирован!!!"
      168           view-as alert-box information
      169           .
      170       end.
      171     end.
      172   end.
      173   input stream upgstream close.
      174   assign
      175     v-gen-file = if entry(num-entries(v-dir-name,"\"),v-dir-name,"\") = "cut" then "utl/cutld.i":U else "utl/clean_db.i":U.
      176     v-gen-file-list = v-gen-file-list + "," + v-gen-file
      177   .
      178   output stream genstream to value( v-gen-dir + v-gen-file ) .
      179   put stream genstream unformatted
      180     chr(47) + chr(42) + chr(10) + chr(10) + chr(36) + 'Revision: ':U + chr(36) + chr(10) + chr(36) + 'Author: ':U + chr(36) + chr(10) + chr(36) + 'Date: ':U + chr(36) + chr(10) + chr(36) + 'Workfile: ':U + chr(36) + chr(10) + chr(36) + 'Archive: ':U + chr(36) + chr(10) + chr(10) + 'ФАЙЛ ГЕНЕРИРУЕТСЯ ПРОЦЕДУРОЙ ' + program-name(1) + chr(10) + chr(10) + chr(10) + "Автор: Уханов Дмитрий Юрьевич":U + chr(10) + "Дата создания: 11/29/01":U + chr(10) + "Author: Dmitry Ukhanov":U + chr(10) + "Creation date: 11/29/01":U + chr(10) + chr(10) + chr(42) + chr(47) + chr(10) skip
      181     chr(47) + chr(42) + ' Список утилит пирога обрезания ' + chr(42) + chr(47) skip(2)
      182   .
      183   for each list-action
      184     by file-name
      185   on error undo, return error
      186   :
      187     put stream genstream unformatted
      188       "create list-action .                                  " skip
      189       "assign                                                " skip
      190       "  list-action.action    = '" list-action.action    "' " skip
      191       "  list-action.file-name = '" list-action.file-name "' " skip
      192       "  .                                                   " skip
      193       .
      194   end.
      195   output stream genstream close .
      196   message
      197     "В каталоге" v-gen-dir "сгенерированы файлы:" skip
      198     v-gen-file-list skip
      199     view-as alert-box information .
