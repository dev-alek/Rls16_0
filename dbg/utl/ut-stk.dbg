     1084   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1085                                             INPUT iFlagEmpty AS INTEGER).
     1086       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1087       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1088           DO:
     1089               IF iFlagEmpty = 0                           THEN RETURN "".
     1090               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1091               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1092               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1093               ELSE RETURN "".
     1094           END.
     1095       ELSE DO:
     1096           run xmlchar-encode in this-procedure (
     1097                 input sToPlace
     1098               , output sToPlace
     1099           ).
     1100           ASSIGN
     1101               sToPlace = sParName + '="' + sToPlace + '"'
     1102           .
     1103           RETURN sToPlace.
     1104       END.
     1105   END FUNCTION.
     1106   function bge-xml-date returns character
     1107   ( input p-date as date )
     1108   :
     1109     define variable v-date-str as character no-undo .
     1110     run bge-xml-date-to-str in this-procedure ( input   p-date
     1111                                               , output  v-date-str
     1112                                               ) .
     1113     return v-date-str.
     1114   end function.
     1115   function bge-xml-str-date returns character
     1116   ( input p-date-str as character )
     1117   :
     1118     define variable v-date-str as character no-undo .
     1119     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1120                                                   , output  v-date-str
     1121                                                   ) .
     1122     return v-date-str.
     1123   end function.
     1124   function bge-xml-normalize-dec returns decimal
     1125   ( input p-val as decimal )
     1126   :
     1127     return (if p-val = ? then 0 else p-val) .
     1128   end function.
     1129   PROCEDURE wp-XMLTagOpen:
     1130   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1131   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1132   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1133       define variable v-out-string    as character    no-undo.
     1134   do
     1135   on error undo, return error
     1136   :
     1137       if v-bge-xml-bgefmt = "dbf":U
     1138       then do:
     1139       end.
     1140       else do:
     1141           assign
     1142               v-out-string = substitute( "&1&2<&3&4>"
     1143                                       , chr(10)
     1144                                       , fill( " ":U, 4 * iTagLevel)
     1145                                       , sTagName
     1146                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1147                               )
     1148           .
     1149           put stream stmXMLOut unformatted
     1150               v-out-string
     1151           .
     1152       end.
     1153   end.
     1154   END PROCEDURE.
     1155   PROCEDURE wp-XMLTagPut:
     1156     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1157     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1158     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1159     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1160       define variable v-out-string    as character    no-undo.
     1161   do
     1162   on error undo, return error
     1163   :
     1164       if v-bge-xml-bgefmt = "dbf":U
     1165       then do:
     1166           if v-bge-xml-dbf-file-name <> "":U
     1167           then do:
     1168               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1169               export stream stmXMLOut
     1170                   sTagName
     1171                   sParValue
     1172               .
     1173               output stream stmXMLOut close.
     1174           end.
     1175       end.
     1176       else do:
     1177           IF  iFlagEmpty = 1
     1178           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1179           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1180           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1181           THEN DO:
     1182               run xmlchar-encode in this-procedure (
     1183                   input sParValue
     1184                   , output sParValue
     1185               ).
     1186               assign
     1187                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1188                                               , chr(10)
     1189                                               , FILL(" ", 4 * iTagLevel)
     1190                                               , sTagName
     1191                                               , sParValue
     1192                               )
     1193               .
     1194               PUT STREAM stmXMLOut UNFORMATTED
     1195                   v-out-string
     1196               .
     1197           END.
     1198       end.
     1199   end.
     1200   END PROCEDURE.
     1201   PROCEDURE wp-XMLTagClose:
     1202   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1203   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1204       define variable v-out-string    as character    no-undo.
     1205   do
     1206   on error undo, return error
     1207   :
     1208       if v-bge-xml-bgefmt = "dbf":U
     1209       then do:
     1210       end.
     1211       else do:
     1212           assign
     1213               v-out-string = substitute( "&1&2</&3>"
     1214                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1215                                   , fill( " ", 4 * iTagLevel )
     1216                                   , sTagName
     1217                           )
     1218           .
     1219           PUT STREAM stmXMLOut UNFORMATTED
     1220               v-out-string
     1221           .
     1222       end.
     1223   end.
     1224   END PROCEDURE.
     1225   PROCEDURE wp-XMLWriteLog:
     1226     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1227     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1228     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1229   define variable v-str              as character no-undo .
     1230   define variable v-error-append     as logical   no-undo .
     1231   define variable v-error-append-msg as character no-undo .
     1232   assign
     1233     v-str = chr(10)
     1234             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1235             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1236     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1237     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1238     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1239   .
     1240   run bge/bge-log.p (input v-str) no-error .
     1241   if error-status:error then do:
     1242     assign
     1243       v-error-append     = yes
     1244       v-error-append-msg = return-value
     1245     .
     1246   end.
     1247   run gbl/fileapnd.p
     1248     ( input sFileName
     1249     , input v-str
     1250     , input 10
     1251     ) no-error .
     1252   if error-status:error then do:
     1253     assign
     1254       v-error-append     = yes
     1255       v-error-append-msg = substitute( "&1&2&3"
     1256                                       , v-error-append-msg
     1257                                       , chr(10)
     1258                                       , return-value
     1259                                       )
     1260     .
     1261   end.
     1262   if v-error-append
     1263   then do:
     1264     return error substitute( "&1" , v-error-append-msg ) .
     1265   end.
     1266   END PROCEDURE.
     1267   PROCEDURE wp-XMLWriteEDT:
     1268     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1269     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1270     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1271       if valid-handle ( hEDT )
     1272       then do:
     1273           hEDT :move-to-eof().
     1274           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1275                                           OR sToWrite = "&Line") THEN "" ELSE
     1276                                           cur-time-string-sec() + " ").
     1277           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1278                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1279                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1280           hEDT :insert-string(chr(10)).
     1281       end.
     1282       process events.
     1283       output to 'bgescn.txt' append.
     1284           put unformatted
     1285               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1286                                           OR sToWrite = "&Line") THEN "" ELSE
     1287                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1288               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1289                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1290                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1291           .
     1292       output close.
     1293   END PROCEDURE.
     1294   PROCEDURE wp-XMLShowCNT:
     1295     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1296       if valid-handle( hCNT )
     1297       then do:
     1298           ASSIGN hCNT :VISIBLE = TRUE.
     1299       end.
     1300   END PROCEDURE.
     1301   PROCEDURE wp-XMLHideCNT:
     1302     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1303       if valid-handle( hCNT )
     1304       then do:
     1305           ASSIGN hCNT :VISIBLE = FALSE.
     1306       end.
     1307   END PROCEDURE.
     1308   PROCEDURE wp-XMLWriteCNT:
     1309     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1310     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1311       if valid-handle( hCNT )
     1312       then do:
     1313           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1314       end.
     1315   END PROCEDURE.
     1316   procedure bge-xml-write-header:
     1317   do
     1318   on error undo, return error
     1319   :
     1320   define input parameter p-xml-file-name  as character        no-undo.
     1321   define input parameter p-doc-name       as character        no-undo.
     1322   define input parameter p-version        as character        no-undo.
     1323   define input parameter p-db-num         as integer          no-undo.
     1324   define input parameter p-date-from      as date             no-undo.
     1325   define input parameter p-shift-num-from as integer          no-undo.
     1326   define input parameter p-date-to        as date             no-undo.
     1327   define input parameter p-shift-num-to   as integer          no-undo.
     1328   define input parameter p-obj-list       as character        no-undo.
     1329   define input parameter p-doc-type-list  as character        no-undo.
     1330   define input parameter p-pay-code       as logical          no-undo.
     1331   define input parameter p-cst            as logical          no-undo.
     1332   define input parameter p-parts          as logical          no-undo.
     1333   define input parameter p-chk-pay-code   as logical          no-undo.
     1334   define input parameter p-pay-desk       as logical          no-undo.
     1335   define input parameter p-pay-desk-cards as logical          no-undo.
     1336   define input parameter p-deleted        as logical          no-undo.
     1337   define input parameter p-opened-docs    as logical          no-undo.
     1338   define variable v-out-string    as character    no-undo.
     1339   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1340   assign
     1341       v-out-string = substitute( "&1&2&3"
     1342                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1343                           , chr(10)
     1344                           , "<IBS_Trade_House>":U )
     1345   .
     1346   put stream stmXMLOut unformatted
     1347       v-out-string
     1348   .
     1349   run wp-XMLTagOpen(1, "header","").
     1350   if v-bge-xml-bgeflold = "oracle":u
     1351   then do:
     1352     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1353     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1354     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1355     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1356     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1357   end.
     1358   run wp-XMLTagOpen( 2, "manifest", "").
     1359   run wp-XMLTagOpen( 3, "document", "").
     1360   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1361   run wp-XMLTagput( 4, "description", "", 0).
     1362   run wp-XMLTagput( 4, "version", p-version, 0).
     1363   run wp-XMLTagclose( 3, "document" ).
     1364   run wp-XMLTagclose( 2, "manifest" ).
     1365   run wp-XMLTagclose( 1, "header" ).
     1366   run wp-XMLTagOpen(1, "options","").
     1367   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1368   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1369   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1370   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1371   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1372   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1373   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1374   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1375   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1376   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1377   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1378   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1379   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1380   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1381   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1382   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1383   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1384   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1385   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1386   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1387   run wp-XMLTagClose(1, "options").
     1388   run wp-XMLTagOpen( 1, "body", "" ).
     1389   output stream stmXMLOut close.
     1390   end.
     1391   end procedure.
     1392   procedure xml-bge-write-footer:
     1393   do
     1394   on error undo, return error return-value
     1395   :
     1396   define input parameter p-xml-file-name as character    no-undo.
     1397   define variable v-error-num     as integer           no-undo.
     1398   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1399   run wp-XMLTagClose( 1, "body" ).
     1400   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1401   output stream stmXMLOut close.
     1402   if v-bge-xml-bgeflold = "oracle":u
     1403   then do:
     1404     define variable v-tmp-file-name         as character no-undo .
     1405     define variable v-zip-file-name         as character no-undo .
     1406     define variable v-exch-file-name        as character no-undo .
     1407     define variable v-heap-file-name        as character no-undo .
     1408     define variable v-i                     as integer   no-undo .
     1409     define variable v-file-name             as character no-undo .
     1410     define variable v-arc                   as character no-undo .
     1411     define variable v-str                   as character no-undo .
     1412     define variable v-exch-tmp-file-name    as character no-undo .
     1413     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1414     define variable v-bge-xml-exch-dir      as character no-undo .
     1415     define variable v-bge-xml-heap-dir      as character no-undo .
     1416     define variable v-bge-xml-compress-heap as logical   no-undo .
     1417     define variable v-home-dir              as character no-undo .
     1418     define variable v-os-command            as character no-undo .
     1419     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1420     if v-home-dir = ?
     1421     then do:
     1422       undo, return error substitute( "&1&2&3"
     1423                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1424                                     , chr(10)
     1425                                     , "Обратитесь к администратору.":u
     1426                                     ).
     1427     end.
     1428     assign
     1429       v-home-dir = v-home-dir
     1430     .
     1431     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1432     if error-status :error
     1433     then do:
     1434       undo, return error substitute( "&1&2&3"
     1435                                     , "Неверно задан каталог экспорта.":u
     1436                                     , chr(10)
     1437                                     , "Обратитесь к администратору.":u
     1438                                     ).
     1439     end.
     1440     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1441     if v-bge-xml-exch-dir = ?
     1442     then do:
     1443       undo, return error substitute( "&1&2&3"
     1444                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1445                                     , chr(10)
     1446                                     , "Обратитесь к администратору.":u
     1447                                     ).
     1448     end.
     1449     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1450     if error-status :error
     1451     then do:
     1452       undo, return error substitute( "&1&2&3"
     1453                                     , "Неверно задан каталог экспорта (exch).":u
     1454                                     , chr(10)
     1455                                     , "Обратитесь к администратору.":u
     1456                                     ).
     1457     end.
     1458     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1459     if v-bge-xml-heap-dir = ?
     1460     then do:
     1461       undo, return error substitute( "&1&2&3"
     1462                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1463                                     , chr(10)
     1464                                     , "Обратитесь к администратору.":u
     1465                                     ).
     1466     end.
     1467     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1468     if error-status :error
     1469     then do:
     1470       undo, return error substitute( "&1&2&3"
     1471                                     , "Неверно задан каталог экспорта (heap).":u
     1472                                     , chr(10)
     1473                                     , "Обратитесь к администратору.":u
     1474                                     ).
     1475     end.
     1476     get-key-value section "BGE" key "heap-compress" value v-str.
     1477     assign
     1478       v-i = int(v-str)
     1479     no-error .
     1480     if v-i = ? or v-i = 0
     1481     then do:
     1482       assign
     1483         v-bge-xml-compress-heap = no
     1484       .
     1485     end.
     1486     else do:
     1487       assign
     1488         v-bge-xml-compress-heap = yes
     1489       .
     1490     end.
     1491     assign
     1492       v-arc = search( "exe/7za.exe":u )
     1493     .
     1494     if v-arc = ? or v-arc = ""
     1495     then do:
     1496       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1497     end.
     1498     assign
     1499       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1500       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1501       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1502       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1503       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1504       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1505       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1506     .
     1507     run gbl/del-file.p (input v-tmp-file-name) .
     1508     run gbl/del-file.p (input v-zip-file-name) .
     1509     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1510     if v-error-num > 0
     1511     then do:
     1512         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1513                                      , p-xml-file-name + "xm1":u
     1514                                      , v-tmp-file-name
     1515                                      , v-error-num
     1516                                      ).
     1517     end.
     1518     assign
     1519       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1520                                    , v-arc
     1521                                    , v-zip-file-name
     1522                                    , v-tmp-file-name
     1523                                    )
     1524     .
     1525     os-command silent value ( v-os-command ) .
     1526     run gbl/del-file.p (input v-heap-file-name) .
     1527     if v-bge-xml-compress-heap = no
     1528     then do:
     1529       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1530       if v-error-num > 0
     1531       then do:
     1532           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1533                                        , v-tmp-file-name
     1534                                        , v-heap-file-name
     1535                                        , v-error-num
     1536                                        ) .
     1537       end.
     1538     end.
     1539     else do:
     1540       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1541       if v-error-num > 0
     1542       then do:
     1543           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1544                                        , v-zip-file-name
     1545                                        , v-heap-file-name
     1546                                        , v-error-num
     1547                                        ) .
     1548       end.
     1549     end.
     1550     run gbl/del-file.p (input v-tmp-file-name) .
     1551     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1552     if error-status :error then do:
     1553       undo, return error substitute( "&1&2&3"
     1554                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1555                                     , chr(10)
     1556                                     , "Обратитесь к администратору."
     1557                                     ).
     1558     end.
     1559     run gbl/del-file.p (input v-exch-file-name) .
     1560     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1561     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1562     if v-error-num > 0
     1563     then do:
     1564       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1565                                     , v-zip-file-name
     1566                                     , v-exch-tmp-file-name
     1567                                     , v-error-num
     1568                                     ) .
     1569     end.
     1570     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1571     if v-error-num > 0
     1572     then do:
     1573       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1574                                     , v-exch-tmp-file-name
     1575                                     , v-exch-file-name
     1576                                     , v-error-num
     1577                                     ) .
     1578     end.
     1579     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1580   end.
     1581   else do:
     1582     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1583     if v-error-num > 0
     1584     then do:
     1585       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1586                                     , p-xml-file-name + "xm1"
     1587                                     , p-xml-file-name + "xml"
     1588                                     , v-error-num
     1589                                     ) .
     1590     end.
     1591   end.
     1592   if opsys = "unix"
     1593   then do:
     1594       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1595   end.
     1596   end.
     1597   end procedure.
     1598   procedure xml-bge-filename0:
     1599   define input parameter p-prefix   as character no-undo .
     1600   define input parameter p-name     as character no-undo .
     1601   define input parameter p-shared-process as logical no-undo .
     1602   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1603   define output parameter p-xml-file-name  as character no-undo .
     1604   // define output parameter p-fullfnamenoext as character no-undo .
     1605   define output parameter p-locked         as logical      no-undo.
     1606   define variable v-fullfnamenoext as character no-undo .
     1607   define variable v-fileext        as character no-undo .
     1608   define variable v-fullfname      as character no-undo .
     1609   define variable v-error-num      as integer   no-undo .
     1610   do
     1611   on error undo, return error
     1612   :
     1613     case v-bge-xml-bgeflold :
     1614       when "old" then do:
     1615         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1616         v-fileext       = ".xml":U .
     1617         v-fullfname     = v-fullfnamenoext + v-fileext .
     1618         p-xml-file-name = v-fullfname .
     1619         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1620         if v-error-num > 0 then do:
     1621           return error.
     1622         end.
     1623       end.
     1624       when "var" then do:
     1625         case p-prefix :
     1626           when "doc" then do:
     1627             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1628             v-fileext       = ".xml":U .
     1629             v-fullfname     = v-fullfnamenoext + v-fileext .
     1630             p-xml-file-name = v-fullfname .
     1631           end.
     1632           when "day" then do:
     1633             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1634             v-fileext       = ".xml":U .
     1635             v-fullfname     = v-fullfnamenoext + v-fileext .
     1636             p-xml-file-name = v-fullfname .
     1637           end.
     1638           otherwise do:
     1639             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1640             v-fileext       = ".xml":U .
     1641             v-fullfname     = v-fullfnamenoext + v-fileext .
     1642             p-xml-file-name = v-fullfname .
     1643           end.
     1644         end case.
     1645         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1646         if v-error-num > 0 then do:
     1647           return error.
     1648         end.
     1649       end.
     1650       when "new" then do:
     1651                   run bge/genfname.p (
     1652                       input p-home-dir
     1653                       , input p-prefix
     1654                       , input ""
     1655                       , input "xml"
     1656                       , input ""
     1657                       , output p-xml-file-name
     1658                   ).
     1659       end.
     1660       when "no-parameter" then do:
     1661         if p-shared-process then do:
     1662                       run bge/genfname.p (
     1663                           input p-home-dir
     1664                           , input "d"
     1665                           , input ""
     1666                           , input "xml"
     1667                           , input ""
     1668                           , output p-xml-file-name
     1669                       ).
     1670         end.
     1671         else do:
     1672           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1673           v-fileext       = ".xml":U .
     1674           v-fullfname     = v-fullfnamenoext + v-fileext .
     1675           p-xml-file-name = v-fullfname .
     1676           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1677           if v-error-num > 0 then do:
     1678             return error.
     1679           end.
     1680         end.
     1681       end.
     1682     end case.
     1683     assign
     1684       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1685       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1686     .
     1687   end .
     1688   end procedure .
     1689   procedure xml-bge-filename :
     1690   do
     1691   on error undo, return error
     1692   :
     1693   define input parameter p-prefix             as character    no-undo.
     1694   define input parameter p-name               as character    no-undo.
     1695   define input parameter p-shared-process     as logical      no-undo.
     1696   define output parameter p-xml-file-name     as character    no-undo.
     1697   define output parameter p-log-file-name     as character    no-undo.
     1698   define output parameter p-locked            as logical      no-undo.
     1699   define variable v-home-dir          as character no-undo .
     1700   define variable v-error-num         as integer   no-undo .
     1701   define variable v-bge-xml-heap-dir  as character no-undo .
     1702       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1703       if v-home-dir = ?
     1704       then do:
     1705           message
     1706             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1707             skip(1)
     1708             skip "Обратитесь к администратору."
     1709           view-as alert-box error.
     1710           undo, return error .
     1711       end.
     1712       if v-bge-xml-bgeflold <> "oracle"
     1713       then do:
     1714         assign
     1715             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1716         .
     1717       end.
     1718       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1719       if error-status :error
     1720       then do:
     1721           message
     1722             skip "Неверно задан каталог экспорта."
     1723             skip(1)
     1724             skip "Обратитесь к администратору."
     1725           view-as alert-box error.
     1726           undo, return error .
     1727       end.
     1728       if v-bge-xml-bgefmt = "dbf":U
     1729       then do:
     1730           assign
     1731               p-xml-file-name = v-home-dir
     1732               p-locked        = no
     1733           .
     1734       end.
     1735       else do:
     1736           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1737             output p-xml-file-name, output p-locked) .
     1738       end.
     1739       if v-bge-xml-bgeflold = "oracle"
     1740       then do:
     1741         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1742         if v-bge-xml-heap-dir = ?
     1743         then do:
     1744           undo, return error substitute( "&1&2&3"
     1745                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1746                                         , chr(10)
     1747                                         , "Обратитесь к администратору.":u
     1748                                         ).
     1749         end.
     1750         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1751         if error-status :error
     1752         then do:
     1753           undo, return error substitute( "&1&2&3"
     1754                                         , "Неверно задан каталог экспорта (heap).":u
     1755                                         , chr(10)
     1756                                         , "Обратитесь к администратору.":u
     1757                                         ).
     1758         end.
     1759         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1760           assign
     1761             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1762           .
     1763         end.
     1764         else do:
     1765           assign
     1766             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1767           .
     1768         end.
     1769       end.
     1770       else do:
     1771         assign
     1772             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1773         .
     1774       end.
     1775       assign
     1776          v-bge-xml-static-log-file-name = p-log-file-name
     1777       .
     1778   end.
     1779   end procedure.
     1780   procedure bge-xml-read-config :
     1781   do
     1782   on error undo, return error return-value
     1783   :
     1784   define input  parameter p-last-date as date      no-undo .
     1785   define input  parameter p-db-num    as integer   no-undo .
     1786       define variable v-bgeclall      as character     no-undo.
     1787       define variable v-bgedict       as character     no-undo.
     1788       define variable v-bgeshift      as character     no-undo.
     1789       define variable v-par-type      as character     no-undo.
     1790       define variable v-bgeflnm       as character     no-undo.
     1791       define variable v-bgecliiv      as character     no-undo .
     1792       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1793       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1794       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1795       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1796       define variable v-db-num-str    as character     no-undo .
     1797       define variable v-param-type      as character  no-undo .
     1798       define variable v-value-character as character  no-undo .
     1799       define variable v-value-date      as date       no-undo .
     1800       define variable v-value-decimal   as decimal    no-undo .
     1801       define variable v-value-integer   as integer    no-undo .
     1802       define variable v-value-logical   as logical    no-undo .
     1803       define variable v-tth             as handle      no-undo .
     1804       run adm/shattri.p ( input "get":U
     1805                         , input  '':u
     1806                         , input  0
     1807                         , input  'bge-export':U
     1808                         , input  'bgeclall':U
     1809                         , output v-bgecliiv
     1810                         , output v-value-date
     1811                         , output v-value-decimal
     1812                         , output v-value-integer
     1813                         , output v-value-logical
     1814                         , output v-param-type
     1815                         , input-output table-handle v-tth
     1816                         ) no-error .
     1817       if error-status :error
     1818       then do:
     1819         assign
     1820           v-bge-xml-bgecliiv = no
     1821         .
     1822       end.
     1823       else do:
     1824         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1825       end.
     1826       delete object v-tth.
     1827       assign
     1828           v-bge-xml-bgeclall = no
     1829           v-bge-xml-bgedict  = no
     1830       .
     1831       run adm/shattri.p ( input "get":U
     1832                         , input  '':u
     1833                         , input  0
     1834                         , input  'bge-export':U
     1835                         , input  'bgeclall':U
     1836                         , output v-value-character
     1837                         , output v-value-date
     1838                         , output v-value-decimal
     1839                         , output v-value-integer
     1840                         , output v-value-logical
     1841                         , output v-param-type
     1842                         , input-output table-handle v-tth
     1843                         ) no-error .
     1844       if error-status :error
     1845       then do:
     1846         assign
     1847           v-bge-xml-bgeclall = no
     1848         .
     1849       end.
     1850       else do:
     1851         assign
     1852           v-bge-xml-bgeclall = v-value-logical
     1853         .
     1854       end.
     1855       delete object v-tth.
     1856       run adm/shattri.p ( input "get":U
     1857                         , input  '':u
     1858                         , input  0
     1859                         , input  'bge-export':U
     1860                         , input  'bgedict':U
     1861                         , output v-value-character
     1862                         , output v-value-date
     1863                         , output v-value-decimal
     1864                         , output v-value-integer
     1865                         , output v-value-logical
     1866                         , output v-param-type
     1867                         , input-output table-handle v-tth
     1868                         ) no-error .
     1869       if error-status :error
     1870       then do:
     1871         assign
     1872           v-bge-xml-bgedict = no
     1873         .
     1874       end.
     1875       else do:
     1876         assign
     1877           v-bge-xml-bgedict = v-value-logical
     1878         .
     1879       end.
     1880       delete object v-tth.
     1881       run adm/shattri.p ( input "get":U
     1882                         , input  '':u
     1883                         , input  0
     1884                         , input  'bge-export':U
     1885                         , input  'bgefmt':U
     1886                         , output v-value-character
     1887                         , output v-value-date
     1888                         , output v-value-decimal
     1889                         , output v-value-integer
     1890                         , output v-value-logical
     1891                         , output v-param-type
     1892                         , input-output table-handle v-tth
     1893                         ) no-error .
     1894       if error-status :error
     1895       then do:
     1896         assign
     1897           v-bge-xml-bgefmt  = "xml":U
     1898         .
     1899       end.
     1900       else do:
     1901         assign
     1902           v-bge-xml-bgefmt  = v-value-character
     1903         .
     1904       end.
     1905       delete object v-tth.
     1906       run adm/shattri.p ( input "get":U
     1907                         , input  '':u
     1908                         , input  0
     1909                         , input  'bge-export':U
     1910                         , input  'bgeshift':U
     1911                         , output v-value-character
     1912                         , output v-value-date
     1913                         , output v-value-decimal
     1914                         , output v-value-integer
     1915                         , output v-value-logical
     1916                         , output v-param-type
     1917                         , input-output table-handle v-tth
     1918                         ) no-error .
     1919       if error-status :error
     1920       then do:
     1921         assign
     1922             v-bge-xml-shift-mode = no
     1923         .
     1924       end.
     1925       else do:
     1926         assign
     1927             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1928         .
     1929       end.
     1930       delete object v-tth.
     1931       run adm/shattri.p ( input "get":U
     1932                         , input  '':u
     1933                         , input  0
     1934                         , input  'bge-export':U
     1935                         , input  'bgeflold':U
     1936                         , output v-value-character
     1937                         , output v-value-date
     1938                         , output v-value-decimal
     1939                         , output v-value-integer
     1940                         , output v-value-logical
     1941                         , output v-param-type
     1942                         , input-output table-handle v-tth
     1943                         ) no-error .
     1944       if error-status :error
     1945       then do:
     1946         assign
     1947           v-bge-xml-bgeflold = "no-parameter":U
     1948         .
     1949       end.
     1950       else do:
     1951         assign
     1952           v-bge-xml-bgeflold  = v-value-character
     1953         .
     1954       end.
     1955       delete object v-tth.
     1956       assign
     1957         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1958         v-bge-xml-db-num-str  = v-db-num-str
     1959       .
     1960       if p-last-date <> ?
     1961       then do:
     1962           run adm/shattri.p ( input "get":U
     1963                             , input  '':u
     1964                             , input  0
     1965                             , input  'bge-export':U
     1966                             , input  'bgeflnm':U
     1967                             , output v-value-character
     1968                             , output v-value-date
     1969                             , output v-value-decimal
     1970                             , output v-value-integer
     1971                             , output v-value-logical
     1972                             , output v-param-type
     1973                             , input-output table-handle v-tth
     1974                             ) no-error .
     1975           if error-status :error
     1976           then do:
     1977             assign
     1978               v-bgeflnm = '':U
     1979             .
     1980           end.
     1981           else do:
     1982             assign
     1983               v-bgeflnm = v-value-character
     1984             .
     1985           end.
     1986           delete object v-tth.
     1987           if v-bge-xml-bgeflold = "var"
     1988           then do:
     1989               if v-bgeflnm = ?
     1990               or num-entries( v-bgeflnm ) < 2
     1991               then do:
     1992                   assign
     1993                       v-bge-xml-bgeflold = "new"
     1994                   .
     1995               end.
     1996               else do:
     1997                   assign
     1998                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1999                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2000                   .
     2001                   assign
     2002                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2003                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2004                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2005                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2006                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2007                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2008                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2009                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2010                   .
     2011               end.
     2012           end.
     2013       end.
     2014   end.
     2015   end procedure.
     2016   procedure bge-xml-get-ref-filename :
     2017   define input parameter p-in-file-name       as character        no-undo.
     2018   define output parameter p-home-dir          as character        no-undo.
     2019   define output parameter p-out-file-name     as character        no-undo.
     2020   define output parameter p-locked            as logical          no-undo.
     2021       define variable v-counter       as integer      no-undo.
     2022       define variable v-error-level   as integer      no-undo.
     2023   do
     2024   on error undo, return error
     2025   :
     2026       run bge/bge-ini.p (
     2027             input "bge"
     2028           , output p-home-dir
     2029       ).
     2030       if return-value <> "OK"
     2031       then do:
     2032           undo, return error.
     2033       end.
     2034       assign
     2035           p-home-dir = p-home-dir + "\dict":U
     2036       .
     2037       run bge/dir_cd.p (
     2038           input p-home-dir
     2039           , input "CA"
     2040       ).
     2041       if return-value = "ERROR"
     2042       then do:
     2043           undo, return error.
     2044       end.
     2045       assign
     2046           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2047       .
     2048       assign
     2049           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2050       .
     2051       wait-lock:
     2052       do v-counter = 1 TO 3
     2053       :
     2054           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2055           if p-locked = no
     2056           then do:
     2057               leave wait-lock.
     2058           end.
     2059           else do:
     2060               readkey pause 1.
     2061           end.
     2062       END.
     2063       if p-locked = yes
     2064       then do:
     2065           undo, return error.
     2066       end.
     2067       run bge/os_copy.p (
     2068             input "D":U
     2069           , input p-out-file-name + "xml":U
     2070           , input "":U
     2071           , output v-error-level
     2072       ).
     2073       if v-error-level > 0
     2074       then do:
     2075           undo, return error.
     2076       end.
     2077   end.
     2078   end procedure.
     2079   procedure bge-xml-write-ref-header :
     2080   define input parameter p-bge-name as character        no-undo.
     2081   define input parameter p-file-name as character        no-undo.
     2082       define variable v-out-string    as character    no-undo.
     2083   do
     2084   on error undo, return error
     2085   :
     2086       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2087       put stream stmXMLOut unformatted
     2088           "<?xml version='1.0' encoding='windows-1251'?>":U
     2089       .
     2090       assign
     2091           v-out-string = substitute( "&1&2"
     2092                               , chr(10)
     2093                               , "<IBS_Trade_House>":U )
     2094       .
     2095       put stream stmXMLOut unformatted
     2096           v-out-string
     2097       .
     2098       run wp-XMLTagOpen( 1, "header", "" ).
     2099       if v-bge-xml-bgeflold = "oracle":u
     2100       then do:
     2101         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2102         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2103         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2104         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2105         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2106       end.
     2107       else do:
     2108         run wp-XMLTagOpen( 2, "delivery", "" ).
     2109         run wp-XMLTagOpen( 3, "to", "" ).
     2110         run wp-XMLTagClose( 3, "to" ).
     2111         run wp-XMLTagOpen( 3, "from", "" ).
     2112         run wp-XMLTagClose( 3, "from" ).
     2113         run wp-XMLTagClose( 2, "delivery" ).
     2114       end.
     2115       run wp-XMLTagOpen( 2, "manifest", "" ).
     2116       run wp-XMLTagOpen( 3, "document", "" ).
     2117       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2118       run wp-XMLTagPut( 4, "description", "", 0 ).
     2119       run wp-XMLTagClose( 3, "document" ).
     2120       run wp-XMLTagClose( 2, "manifest" ).
     2121       run wp-XMLTagClose( 1, "header" ).
     2122       run wp-XMLTagOpen( 1, "body", "" ).
     2123   end.
     2124   end procedure.
     2125   procedure bge-xml-write-ref-footer :
     2126   define input parameter p-file-name as character        no-undo.
     2127       define variable v-error-level   as integer      no-undo.
     2128   do
     2129   on error undo, return error
     2130   :
     2131       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2132       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2133       output stream stmXMLOut close.
     2134       run bge/os_copy.p (
     2135             input "M":U
     2136           , input p-file-name + "xm1":U
     2137           , input p-file-name + "xml":U
     2138           , output v-error-level
     2139       ).
     2140       if v-error-level > 0
     2141       then do:
     2142           undo, return error.
     2143       end.
     2144   end.
     2145   end procedure.
     2146   procedure bge-xml-out-dir :
     2147   define output parameter p-out-dir       as character    no-undo.
     2148   define output parameter p-log-file-name as character    no-undo.
     2149   do
     2150   on error undo, return error
     2151   :
     2152       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2153       if p-out-dir = ?
     2154       then do:
     2155           message
     2156             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2157                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2158             skip(1)
     2159             skip "Обратитесь к администратору."
     2160           view-as alert-box error.
     2161           undo, return error .
     2162       end.
     2163       if v-bge-xml-bgeflold <> "oracle" then assign
     2164         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2165       .
     2166       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2167       if error-status :error  then do:
     2168           run wp-XMLWriteLog in this-procedure (
     2169                 input p-log-file-name
     2170               , input 0
     2171               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2172                                   , p-out-dir
     2173                                   , return-value
     2174                                   , trim( error-status :get-message( 1 ) )
     2175                                   )
     2176           ).
     2177           undo, return error.
     2178       end.
     2179       assign
     2180           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2181           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2182       .
     2183   end.
     2184   end procedure.
     2185   procedure bge-xml-out-dir2 :
     2186   define output parameter p-out-dir       as character    no-undo.
     2187   define output parameter p-out-dirR      as character    no-undo.
     2188   define output parameter p-log-file-name as character    no-undo.
     2189   do
     2190   on error undo, return error
     2191   :
     2192       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2193       if p-out-dir = ?
     2194       then do:
     2195           message
     2196             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2197                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2198             skip(1)
     2199             skip "Обратитесь к администратору."
     2200           view-as alert-box error.
     2201           undo, return error .
     2202       end.
     2203       if v-bge-xml-bgeflold <> "oracle" then assign
     2204             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2205             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2206         .
     2207       else p-out-dirR = p-out-dir .
     2208       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2209       if error-status :error  then do:
     2210           run wp-XMLWriteLog in this-procedure (
     2211                 input p-log-file-name
     2212               , input 0
     2213               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2214                                   , p-out-dir
     2215                                   , return-value
     2216                                   , error-status :get-message( 1 )
     2217                                   )
     2218           ).
     2219           undo, return error.
     2220       end.
     2221       if p-out-dirR <> p-out-dir then do:
     2222         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2223         if error-status :error then do:
     2224           run wp-XMLWriteLog in this-procedure (
     2225                 input p-log-file-name
     2226               , input 0
     2227               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2228                                   , p-out-dirR
     2229                                   , return-value
     2230                                   , error-status :get-message( 1 )
     2231                                   )
     2232           ).
     2233           p-out-dirR = p-out-dir .
     2234         end.
     2235       end .
     2236       assign
     2237         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2238         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2239       .
     2240   end.
     2241   end procedure.
     2242   procedure bge-xml-out-file :
     2243   do
     2244   on error undo, return error
     2245   :
     2246   define input parameter p-out-dir            as character        no-undo.
     2247   define input parameter p-prefix             as character        no-undo.
     2248   define input parameter p-sheduled           as logical          no-undo.
     2249   define output parameter p-xml-file-name     as character        no-undo.
     2250   define output parameter p-locked            as logical          no-undo.
     2251   define variable v-home-dir      as character     no-undo.
     2252   define variable v-error-num     as integer       no-undo.
     2253   define variable v-today             as date         no-undo.
     2254   define variable v-time              as integer      no-undo.
     2255       if v-bge-xml-bgefmt = "dbf":U
     2256       then do:
     2257           assign
     2258               p-xml-file-name = p-out-dir
     2259               p-locked        = no
     2260           .
     2261       end.
     2262       else do:
     2263           if v-bge-xml-bgeflold = "firm":U
     2264           then do:
     2265               run bge/genfname.p (
     2266                     input p-out-dir
     2267                   , input p-prefix
     2268                   , input "":U
     2269                   , input "arj":U
     2270                   , input "":U
     2271                   , output p-xml-file-name
     2272               ).
     2273           end.
     2274           else do:
     2275               run bge/genfname.p (
     2276                     input p-out-dir
     2277                   , input p-prefix
     2278                   , input "":U
     2279                   , input "xml":U
     2280                   , input "":U
     2281                   , output p-xml-file-name
     2282               ).
     2283           end.
     2284           assign
     2285               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2286               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2287           .
     2288       end.
     2289   end.
     2290   end procedure.
     2291   procedure bge-xml-init-ext-doc-type :
     2292       define variable v-counter    as integer      no-undo.
     2293       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2294   do
     2295   for buf_temp_ext-doc-type
     2296   on error undo, return error
     2297   :
     2298       empty temp-table buf_temp_ext-doc-type.
     2299       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2300       :
     2301           create buf_temp_ext-doc-type.
     2302           assign
     2303               buf_temp_ext-doc-type.edt-key               = v-counter
     2304               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2305               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2306           .
     2307       end.
     2308   end.
     2309   end procedure.
     2310   procedure bge-xml-get-decimal-shift-num :
     2311   define input parameter p-shift-date     as date             no-undo.
     2312   define input parameter p-shift-num      as integer          no-undo.
     2313   define output parameter p-shift-decimal as decimal          no-undo.
     2314   do
     2315   on error undo, return error
     2316   :
     2317       assign
     2318           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2319       .
     2320   end.
     2321   end procedure.
     2322   procedure bge-xml-ora-exp-filename :
     2323     define input  parameter p-table-name  as character no-undo .
     2324     define input  parameter p-doc-code    as character no-undo .
     2325     define input  parameter p-obj-code    as integer   no-undo .
     2326     define output parameter p-filename    as character no-undo .
     2327     define output parameter p-seq-num     as integer   no-undo .
     2328     define variable v-ora-exp-seq     as integer   no-undo .
     2329     define variable v-ora-exp-seq-str as character no-undo .
     2330     define variable v-home-dir        as character no-undo.
     2331   do
     2332   on error undo, return error return-value
     2333   :
     2334     if v-bge-xml-bgeflold = "oracle":u
     2335     then do:
     2336       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2337       if v-home-dir = ?
     2338       then do:
     2339         undo, return error substitute( "&1&2&3":U
     2340                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2341                                       , chr(10)
     2342                                       , "Обратитесь к администратору.":U
     2343                                       ).
     2344       end.
     2345       assign
     2346           v-home-dir = v-home-dir
     2347       .
     2348       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2349       if error-status :error
     2350       then do:
     2351         undo, return error substitute( "&1&2&3":U
     2352                                       , "Неверно задан каталог экспорта.":U
     2353                                       , chr(10)
     2354                                       , "Обратитесь к администратору.":U
     2355                                       ).
     2356       end.
     2357       assign
     2358         v-ora-exp-seq = ?
     2359       .
     2360       if  p-table-name <> ? and
     2361           p-doc-code <> ?
     2362       then do:
     2363         run bge/get-oesq.p ( input p-table-name
     2364                            , input p-doc-code
     2365                            , output v-ora-exp-seq
     2366                            ) no-error .
     2367         if error-status :error = yes
     2368         then do:
     2369           undo, return error return-value .
     2370         end.
     2371       end.
     2372       if v-ora-exp-seq = ?
     2373       then do:
     2374         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2375         if error-status :error
     2376         then do:
     2377           undo, return error return-value .
     2378         end.
     2379       end.
     2380       if p-table-name <> ? and
     2381          p-doc-code   <> ?
     2382       then do:
     2383         run bge/oesqdoc.p ( input p-table-name
     2384                           , input p-doc-code
     2385                           , input v-ora-exp-seq
     2386                           ) no-error .
     2387         if error-status :error = yes
     2388         then do:
     2389           undo, return error return-value .
     2390         end.
     2391       end.
     2392       assign
     2393         p-seq-num  = v-ora-exp-seq
     2394         p-filename = substitute("&1/&2-000_&3."
     2395                                , v-home-dir
     2396                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2397                                , string(v-ora-exp-seq , "999999999")
     2398                                )
     2399       .
     2400     end.
     2401   end.
     2402   end procedure.
     2403   procedure bge-xml-date-to-str :
     2404     define input  parameter p-date  as date      no-undo .
     2405     define output parameter p-str   as character no-undo .
     2406   do
     2407   on error undo, return error return-value
     2408   :
     2409     if p-date <> ?
     2410     then do:
     2411       assign
     2412         p-str = substitute( "&1-&2-&3"
     2413                           , string( year(p-date)  , "9999")
     2414                           , string( month(p-date) , "99"  )
     2415                           , string( day(p-date)   , "99"  )
     2416                           )
     2417       .
     2418     end.
     2419     else do:
     2420       assign
     2421         p-str = ?
     2422       .
     2423     end.
     2424   end.
     2425   end procedure.
     2426   procedure bge-xml-date-str-to-str :
     2427     define input  parameter p-date-str  as character no-undo .
     2428     define output parameter p-str       as character no-undo .
     2429     define variable v-date          as date      no-undo .
     2430     define variable v-date-valid    as logical   no-undo .
     2431     define variable v-error-message as character no-undo .
     2432   do
     2433   on error undo, return error return-value
     2434   :
     2435     assign
     2436       p-str = ?
     2437     .
     2438     if p-date-str = ? or p-date-str = ""
     2439     then do:
     2440       return .
     2441     end.
     2442     run strtdate in this-procedure ( input  p-date-str
     2443                                    , output v-date
     2444                                    , output v-date-valid
     2445                                    , output v-error-message
     2446                                    ).
     2447     if v-date-valid <> true
     2448     then do:
     2449       return .
     2450     end.
     2451     assign
     2452       p-str = substitute( "&1-&2-&3"
     2453                         , string( year(v-date)  , "9999")
     2454                         , string( month(v-date) , "99"  )
     2455                         , string( day(v-date)   , "99"  )
     2456                         )
     2457     .
     2458   end.
     2459   end procedure.
     2460   procedure bge-xml-fill-tt-bgecliiv :
     2461     define input  parameter p-str as character no-undo .
     2462     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2463     define buffer buf_clients             for ub.clients.
     2464     define variable v-i         as integer   no-undo .
     2465     define variable v-count     as integer   no-undo .
     2466     define variable v-cli-count as integer   no-undo .
     2467     define variable v-client    as character no-undo .
     2468     define variable v-obj-type  as character no-undo .
     2469     define variable v-obj-code  as integer   no-undo .
     2470   do
     2471   on error undo, return error return-value
     2472   :
     2473     empty temp-table buf_tt-bge-xml-bgecliiv.
     2474     assign
     2475       v-bge-xml-bgecliiv = no
     2476       v-cli-count        = num-entries(p-str,';')
     2477     .
     2478     if v-cli-count > 0
     2479     then do:
     2480       _cli-cycle:
     2481       do v-i = 1 to v-cli-count
     2482       :
     2483         assign
     2484           v-client = entry(v-i , p-str, ';')
     2485         .
     2486         if num-entries(v-client) <> 2
     2487         then do:
     2488           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2489         end.
     2490         assign
     2491           v-obj-type = entry(1, v-client)
     2492         .
     2493         assign
     2494           v-obj-code = integer(entry(2, v-client))
     2495         no-error .
     2496         if error-status :error
     2497         then do:
     2498           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2499         end.
     2500         find first buf_clients no-lock
     2501           where buf_clients.obj-type = v-obj-type
     2502             and buf_clients.obj-code = v-obj-code
     2503         no-error.
     2504         if not available buf_clients
     2505         then do:
     2506           next _cli-cycle.
     2507         end.
     2508         find first buf_tt-bge-xml-bgecliiv no-lock
     2509           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2510             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2511         no-error .
     2512         if available buf_tt-bge-xml-bgecliiv
     2513         then do:
     2514           next _cli-cycle.
     2515         end.
     2516         create buf_tt-bge-xml-bgecliiv.
     2517         assign
     2518           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2519           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2520         .
     2521       end.
     2522     end.
     2523     else do:
     2524       assign
     2525         v-bge-xml-bgecliiv = no
     2526       .
     2527       return .
     2528     end.
     2529     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2530     if available buf_tt-bge-xml-bgecliiv
     2531     then do:
     2532       assign
     2533         v-bge-xml-bgecliiv = yes
     2534       .
     2535     end.
     2536   end.
     2537   end procedure.
     2538   procedure bge-xml-resolve-ext-doc-type :
     2539     define input  parameter p-ext-doc-type      as character no-undo .
     2540     define input  parameter p-obj-type          as character no-undo .
     2541     define input  parameter p-obj-code          as integer   no-undo .
     2542     define output parameter p-out-ext-doc-type  as character no-undo .
     2543     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2544   do
     2545   on error undo, return error return-value
     2546   :
     2547     assign
     2548       p-out-ext-doc-type = p-ext-doc-type
     2549     .
     2550     if p-ext-doc-type <> 'ie':U
     2551     then do:
     2552       return .
     2553     end.
     2554     if v-bge-xml-bgecliiv = yes
     2555     then do:
     2556       find first buf_tt-bge-xml-bgecliiv no-lock
     2557         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2558           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2559       no-error .
     2560       if available buf_tt-bge-xml-bgecliiv
     2561       then do:
     2562         assign
     2563           p-out-ext-doc-type = 'iv':U
     2564         .
     2565       end.
     2566     end.
     2567   end.
     2568   end procedure.
     2569   procedure safe-wp-xmltagput :
     2570     define input  parameter pTagLevel   as integer   no-undo .
     2571     define input  parameter pTagName    as character no-undo .
     2572     define input  parameter pParValue   as character no-undo .
     2573     define input  parameter pFlagEmpty  as integer   no-undo .
     2574   do
     2575   on error undo, return error return-value
     2576   :
     2577     if v-bge-xml-bgeflold = "oracle":u
     2578     then do:
     2579       return .
     2580     end.
     2581     run wp-xmltagput in this-procedure ( input pTagLevel
     2582                                        , input pTagName
     2583                                        , input pParValue
     2584                                        , input pFlagEmpty
     2585                                        ).
     2586   end.
     2587   end procedure.
     2588   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2589   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     2590      IF parundefine-var = ? THEN RETURN 0.00.
     2591                             ELSE RETURN parundefine-var.
     2592   END FUNCTION.
     2593   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     2594      IF p-undef-char = ? THEN do:
     2595        RETURN "?".
     2596      end.
     2597      ELSE do:
     2598        RETURN p-undef-char .
     2599      end.
     2600   END FUNCTION.
     2601   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2602       def var log-file-name as char no-undo.
     2603       assign
     2604           log-file-name = ''
     2605       .
     2606       if log-file-name <> "":U
     2607       then do:
     2608           if search( '' ) = ?
     2609           then do:
     2610               output to value( '' ).
     2611               output close.
     2612           end.
     2613       end.
     2614       DEF STREAM stm-log.
     2615       PROCEDURE writelog:
     2616       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     2617       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     2618       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     2619       if p-file-name <> ""
     2620       then do:
     2621       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     2622           PUT STREAM stm-log UNFORMATTED chr(10).
     2623           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     2624                                           OR p-log-string = "&Line") THEN "" ELSE
     2625                                           cur-time-string-sec() + " ").
     2626           PUT STREAM stm-log UNFORMATTED
     2627                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     2628                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     2629                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     2630       OUTPUT STREAM stm-log CLOSE.
     2631       end.
     2632       END PROCEDURE.
     2633       define variable parparentproc    as handle       no-undo.
     2634       assign
     2635           parparentproc = p-mainmenu-handle
     2636       .
     2637   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2638     define variable v-cntxt-db-num        as integer   no-undo .
     2639     define variable v-cntxt-userid        as character no-undo .
     2640     define variable v-cntxt-level         as character no-undo .
     2641     define variable v-cntxt-host-code-obj as integer   no-undo .
     2642     define variable v-cntxt-obj-type      as character no-undo .
     2643     define variable v-cntxt-obj-code      as integer   no-undo .
     2644     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2645     define variable v-cntxt-is-admin      as logical   no-undo .
     2646       define variable v-date-from             as date                     no-undo.
     2647       define variable v-date-to               as date                     no-undo.
     2648       define variable v-file-name             as char                     no-undo.
     2649       define variable v-fact-order-from       like ub.stk-tot.fact-order     no-undo.
     2650       define variable v-fact-order-to         like ub.stk-tot.fact-order     no-undo.
     2651       define variable v-fo-from               like ub.stk-tot.fact-order     no-undo.
     2652       define variable v-fo-to                 like ub.stk-tot.fact-order     no-undo.
     2653       define variable v-docs-exists           as logical                  no-undo.
     2654       define variable v-last-tmp-obj          as logical                  no-undo.
     2655       define variable v-temp-exists           as logical                  no-undo.
     2656       define variable v-first-in-gds-obj      as logical  init yes        no-undo.
     2657       define variable v-bar-code              like ub.bar-code.b-code        no-undo.
     2658       define variable v-doc-num               as character                no-undo.
     2659       define variable v-price-sale            like ub.stk-line.sum-base      no-undo.
     2660       define variable v-road-tax              like ub.stk-line.road-tax-base no-undo.
     2661       define variable v-excise                like ub.stk-line.excise-base   no-undo.
     2662       define variable v-last-sum              like ub.stk-line.sum-base      no-undo.
     2663       define variable v-last-qnty             like ub.stk-line.fact-qnty     no-undo.
     2664       define variable v-good-counter          as int          init 0      no-undo.
     2665       define variable v-was-changed           as logical      init no     no-undo.
     2666       define variable v-today                 as date                     no-undo.
     2667       define variable v-time                  as integer                  no-undo.
     2668       define variable v-void-logical          as logical                  no-undo.
     2669       define variable v-void-integer          as integer                  no-undo.
     2670       define variable v-void-character        as character                no-undo.
     2671           define variable v-g-ut-stk-host-code    as integer      no-undo.
     2672           define variable v-g-ut-stk-store-type   as character    no-undo.
     2673           define variable v-g-ut-stk-store-code   as integer      no-undo.
     2674       define stream out-stream.
     2675       define temp-table temp-fact-ord no-undo
     2676           field obj-type         like ub.stk-tot.obj-type
     2677           field obj-code         like ub.stk-tot.obj-code
     2678           field min-fact-order   like ub.stk-tot.fact-order
     2679           field max-fact-order   like ub.stk-tot.fact-order
     2680           index fo is primary unique obj-type obj-code
     2681       .
     2682       define temp-table temp-good no-undo
     2683           field gds-code          like ub.goods.gds-code
     2684           field artic             like ub.goods.artic
     2685           field prod-type         like ub.goods.prod-type
     2686           field prod-code         like ub.goods.prod-code
     2687           field gds-name          like ub.goods.gds-name
     2688           field current-price     like ub.stk-line.sum-base
     2689           field qnty-first        like ub.stk-line.fact-qnty
     2690           field sum-first         like ub.stk-line.sum-base
     2691           field qnty-last         like ub.stk-line.fact-qnty
     2692           field sum-last          like ub.stk-line.sum-base
