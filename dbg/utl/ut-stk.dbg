      185   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   procedure cur-time :
      187      define output parameter p-today as date      no-undo .
      188      define output parameter p-time  as integer   no-undo .
      189     do
      190     on error undo, return error
      191     :
      192       define variable v-date1 as date      no-undo .
      193       define variable v-date2 as date      no-undo .
      194       define variable v-time  as integer   no-undo .
      195       assign
      196         v-date1 = today
      197         v-time  = time
      198         v-date2 = today
      199       .
      200       if v-date1 <> v-date2
      201       then do:
      202         assign
      203           v-date1 = today
      204           v-time  = v-time
      205         .
      206       end.
      207       assign
      208         p-today = v-date1
      209         p-time  = v-time
      210       .
      211     end.
      212   end.
      213   function cur-time-date returns character
      214   :
      215     return string(today, '99/99/9999':U) .
      216   end.
      217   function cur-time-mjd returns decimal
      218   :
      219     define variable v-date as date      no-undo .
      220     define variable v-time as integer   no-undo .
      221     run cur-time in this-procedure
      222       (output v-date
      223       ,output v-time
      224       ) .
      225     return integer(v-date) - 2400002 + (v-time / 86400) .
      226   end.
      227   function cur-time-get-ending-index returns integer
      228   (input p-number as integer
      229   )
      230   :
      231     if p-number < 0
      232     or p-number = ?
      233     then do:
      234       return 1 .
      235     end.
      236     define variable v-rest as integer   no-undo .
      237     assign
      238       p-number = p-number modulo 100
      239     .
      240     if p-number < 20
      241     then do:
      242       assign
      243         v-rest = p-number
      244       .
      245     end.
      246     else do:
      247       assign
      248         v-rest = p-number modulo 10
      249       .
      250     end.
      251     case v-rest :
      252       when 1
      253       then do:
      254         return 2 .
      255       end.
      256       when 2 or
      257       when 3 or
      258       when 4
      259       then do:
      260         return 3 .
      261       end.
      262       otherwise do:
      263         return 1 .
      264       end.
      265     end case .
      266   end.
      267   procedure cur-time-mjd-to-date :
      268      define input  parameter i-mjd-diff as decimal no-undo.
      269      define output parameter o-Date     as date    no-undo.
      270      define output parameter o-Time     as integer no-undo.
      271      define variable v-day-number as integer   no-undo .
      272      if    i-mjd-diff < 0
      273         or i-mjd-diff = ?
      274      then do:
      275         return "?" .
      276      end.
      277      assign
      278         v-day-number = truncate(i-mjd-diff,0).
      279         o-Date = date(v-day-number + 2400002).
      280         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      281     .
      282   end.
      283   function cur-time-mjd-to-string returns character
      284   (input p-mjd-diff as decimal
      285   )
      286   :
      287     define variable v-day-number as integer   no-undo .
      288     define variable v-seconds    as integer   no-undo .
      289     define variable v-hour       as integer   no-undo .
      290     define variable v-min        as integer   no-undo .
      291     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      292     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      293     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      294     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      295     if p-mjd-diff < 0
      296     or p-mjd-diff = ?
      297     then do:
      298       return "?" .
      299     end.
      300     assign
      301       v-day-number = integer(truncate(p-mjd-diff,0))
      302       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      303     .
      304     if v-seconds > 86400
      305     then do:
      306       assign
      307         v-seconds = 86400 - 1
      308       .
      309     end.
      310     if v-seconds < 0
      311     then do:
      312       assign
      313         v-seconds = 0
      314       .
      315     end.
      316     assign
      317       v-hour = truncate(v-seconds / 3600, 0)
      318     .
      319     assign
      320       v-seconds = v-seconds modulo 3600
      321     .
      322     assign
      323       v-min = truncate(v-seconds / 60, 0)
      324     .
      325     assign
      326       v-seconds = v-seconds modulo 60
      327     .
      328     return
      329         (if v-day-number <> 0
      330           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      331           else ""
      332         )
      333       + (if v-day-number <> 0 or v-hour <> 0
      334           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      335           else ""
      336         )
      337       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      338           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      339           else ""
      340         )
      341       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      342       .
      343   end.
      344   function cur-time-string returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      353   end.
      354   function cur-time-string-sec returns character
      355   :
      356     define variable v-date as date      no-undo .
      357     define variable v-time as integer   no-undo .
      358     run cur-time in this-procedure
      359       (output v-date
      360       ,output v-time
      361       ) .
      362     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      363   end.
      364   function cur-time-custom  returns character
      365   (input p-prefix as character
      366   ,input p-date-format as character
      367   ,input p-delimiter as character
      368   ,input p-time-format as character
      369   ,input p-suffix as character
      370   )
      371   :
      372     define variable v-date as date      no-undo .
      373     define variable v-time as integer   no-undo .
      374     run cur-time in this-procedure
      375       (output v-date
      376       ,output v-time
      377       ) .
      378     return
      379       p-prefix
      380       + string(v-date, p-date-format)
      381       + p-delimiter
      382       + string(v-time, p-time-format)
      383       + p-suffix
      384       .
      385   end.
      386   function cur-time-print  returns character
      387   :
      388     define variable v-date as date      no-undo .
      389     define variable v-time as integer   no-undo .
      390     run cur-time in this-procedure
      391       (output v-date
      392       ,output v-time
      393       ) .
      394     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      395   end.
      396   function cur-time-datetime returns datetime
      397   :
      398     define variable v-char as character no-undo .
      399     define variable v-datetime as datetime no-undo .
      400     v-char = cur-time-string().
      401     v-datetime = datetime(v-char).
      402     return  v-datetime.
      403   end.
      404   function cur-time-string-msec returns character
      405   :
      406     define variable v-date as datetime  no-undo .
      407     v-date = now.
      408     return string(v-date) .
      409   end.
      410   define variable vss-include-info4 as character format "X(65)" no-undo
      411   initial "@(#)$Workfile$ $Revision$".
      412   procedure xmlchar-test :
      413   define input parameter p-in-string          as character        no-undo.
      414   define output parameter p-out-string-enc    as character        no-undo.
      415   define output parameter p-out-string-dec    as character        no-undo.
      416   do
      417   on error undo, return error
      418   :
      419          run xmlchar-encode in this-procedure
      420       (
      421             input p-in-string
      422           , output p-out-string-enc
      423       ).
      424          run xmlchar-decode in this-procedure
      425       (
      426             input p-out-string-enc
      427           , output p-out-string-dec
      428       ).
      429   end.
      430   end .
      431   procedure xmlchar-encode :
      432   define input parameter p-in-string      as character        no-undo.
      433   define output parameter p-out-string    as character        no-undo.
      434       define variable v-position      as integer      no-undo.
      435       define variable v-current-char  as character    no-undo.
      436   do
      437   on error undo, return error
      438   :
      439       assign
      440           p-out-string = "":U
      441       .
      442       case p-in-string
      443       :
      444           when ?
      445           then do:
      446               assign
      447                   p-out-string = "?":U
      448               .
      449           end.
      450           when "?":U
      451           then do:
      452               assign
      453                   p-out-string = "&#63;":U
      454               .
      455           end.
      456           otherwise do:
      457               do v-position = 1 to length( p-in-string )
      458               :
      459                   assign
      460                       v-current-char = substring( p-in-string, v-position, 1 )
      461                   .
      462                   case v-current-char
      463                   :
      464                       when "&":U
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "&amp;":U
      468                           .
      469                       end.
      470                       when ">":U
      471                       then do:
      472                           assign
      473                               p-out-string = p-out-string + "&gt;":U
      474                           .
      475                       end.
      476                       when "<":U
      477                       then do:
      478                           assign
      479                               p-out-string = p-out-string + "&lt;":U
      480                           .
      481                       end.
      482                       when "'":U
      483                       then do:
      484                           assign
      485                               p-out-string = p-out-string + "&apos;":U
      486                           .
      487                       end.
      488                       when '"':U
      489                       then do:
      490                           assign
      491                               p-out-string = p-out-string + "&quot;":U
      492                           .
      493                       end.
      494                       when chr(1)
      495                       then do:
      496                           assign
      497                               p-out-string = p-out-string + "":U
      498                           .
      499                       end.
      500                       when chr(2)
      501                       then do:
      502                           assign
      503                               p-out-string = p-out-string + "":U
      504                           .
      505                       end.
      506                       when chr(3)
      507                       then do:
      508                           assign
      509                               p-out-string = p-out-string + "":U
      510                           .
      511                       end.
      512                       when chr(4)
      513                       then do:
      514                           assign
      515                               p-out-string = p-out-string + "":U
      516                           .
      517                       end.
      518                       when chr(5)
      519                       then do:
      520                           assign
      521                               p-out-string = p-out-string + "":U
      522                           .
      523                       end.
      524                       when chr(6)
      525                       then do:
      526                           assign
      527                               p-out-string = p-out-string + "":U
      528                           .
      529                       end.
      530                       when chr(7)
      531                       then do:
      532                           assign
      533                               p-out-string = p-out-string + "":U
      534                           .
      535                       end.
      536                       when chr(8)
      537                       then do:
      538                           assign
      539                               p-out-string = p-out-string + "":U
      540                           .
      541                       end.
      542                       when chr(9)
      543                       then do:
      544                           assign
      545                               p-out-string = p-out-string + "":U
      546                           .
      547                       end.
      548                       when chr(29)
      549                       then do:
      550                           assign
      551                               p-out-string = p-out-string + "":U
      552                           .
      553                       end.
      554                       when chr(10)
      555                       then do:
      556                           assign
      557                               p-out-string = p-out-string + "&#10;":U
      558                           .
      559                       end.
      560                       when chr(13)
      561                       then do:
      562                           assign
      563                               p-out-string = p-out-string + "&#13;":U
      564                           .
      565                       end.
      566                       otherwise do:
      567                           assign
      568                               p-out-string = p-out-string + v-current-char
      569                           .
      570                       end.
      571                   end case.
      572               end.
      573           end.
      574       end case.
      575   end.
      576   end .
      577   procedure xmlchar-encode-1c :
      578   define input parameter p-in-string      as character        no-undo.
      579   define output parameter p-out-string    as character        no-undo.
      580       define variable v-position      as integer      no-undo.
      581       define variable v-current-char  as character    no-undo.
      582   do
      583   on error undo, return error
      584   :
      585       assign
      586           p-out-string = "":U
      587       .
      588       case p-in-string
      589       :
      590           when ?
      591           then do:
      592               assign
      593                   p-out-string = "?":U
      594               .
      595           end.
      596           otherwise do:
      597               do v-position = 1 to length( p-in-string )
      598               :
      599                   assign
      600                       v-current-char = substring( p-in-string, v-position, 1 )
      601                   .
      602                   case v-current-char
      603                   :
      604                       when chr(1)
      605                       then do:
      606                           assign
      607                               p-out-string = p-out-string + " ":U
      608                           .
      609                       end.
      610                       when chr(2)
      611                       then do:
      612                           assign
      613                               p-out-string = p-out-string + " ":U
      614                           .
      615                       end.
      616                       when chr(3)
      617                       then do:
      618                           assign
      619                               p-out-string = p-out-string + " ":U
      620                           .
      621                       end.
      622                       when chr(4)
      623                       then do:
      624                           assign
      625                               p-out-string = p-out-string + " ":U
      626                           .
      627                       end.
      628                       when chr(5)
      629                       then do:
      630                           assign
      631                               p-out-string = p-out-string + " ":U
      632                           .
      633                       end.
      634                       when chr(6)
      635                       then do:
      636                           assign
      637                               p-out-string = p-out-string + " ":U
      638                           .
      639                       end.
      640                       when chr(7)
      641                       then do:
      642                           assign
      643                               p-out-string = p-out-string + " ":U
      644                           .
      645                       end.
      646                       when chr(8)
      647                       then do:
      648                           assign
      649                               p-out-string = p-out-string + " ":U
      650                           .
      651                       end.
      652                       when chr(9)
      653                       then do:
      654                           assign
      655                               p-out-string = p-out-string + " ":U
      656                           .
      657                       end.
      658                       when chr(29)
      659                       then do:
      660                           assign
      661                               p-out-string = p-out-string + " ":U
      662                           .
      663                       end.
      664                       when chr(10)
      665                       then do:
      666                           assign
      667                               p-out-string = p-out-string + " ":U
      668                           .
      669                       end.
      670                       when chr(13)
      671                       then do:
      672                           assign
      673                               p-out-string = p-out-string + " ":U
      674                           .
      675                       end.
      676                       otherwise do:
      677                           assign
      678                               p-out-string = p-out-string + v-current-char
      679                           .
      680                       end.
      681                   end case.
      682               end.
      683           end.
      684       end case.
      685   end.
      686   end .
      687   procedure xmlchar-decode :
      688   define input parameter p-in-string      as character        no-undo.
      689   define output parameter p-out-string    as character        no-undo.
      690       define variable v-position      as integer      no-undo.
      691       define variable v-last-position as integer      no-undo.
      692       define variable v-temp-integer  as integer      no-undo.
      693       define variable v-current-char  as character    no-undo.
      694       define variable v-next-char     as character    no-undo.
      695       define variable v-success       as logical      no-undo.
      696   do
      697   on error undo, return error
      698   :
      699       assign
      700           p-out-string = "":U
      701           v-position   = 0
      702       .
      703       replace-cycle:
      704       do while yes
      705       on error undo, return error
      706       :
      707           assign
      708               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      709           .
      710           if v-last-position <= v-position
      711           then do:
      712               if v-position = 0
      713               then do:
      714                   assign
      715                       p-out-string = p-in-string
      716                   .
      717               end.
      718               else do:
      719                   assign
      720                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      721                   .
      722               end.
      723               leave replace-cycle.
      724           end.
      725           else do:
      726               assign
      727                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      728                   v-position      = v-last-position
      729                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      730               .
      731               if v-current-char = "#":U
      732               then do:
      733                   assign
      734                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      735                   .
      736                   if v-last-position > 0
      737                   then do:
      738                       run xmlchar-read-integer in this-procedure
      739                        (
      740                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      741                           , output v-temp-integer
      742                           , output v-success
      743                       ).
      744                       if v-success = yes
      745                       and v-temp-integer >= 1
      746                       and v-temp-integer <= 255
      747                       then do:
      748                           assign
      749                               p-out-string = p-out-string + chr( v-temp-integer )
      750                               v-position   = v-last-position + 1
      751                           .
      752                       end.
      753                       else do:
      754                           assign
      755                               p-out-string = p-out-string + "&":U
      756                               v-position   = v-position   + 1
      757                           .
      758                       end.
      759                   end.
      760                   else do:
      761                       assign
      762                           p-out-string = p-out-string + "&":U
      763                           v-position   = v-position   + 1
      764                       .
      765                   end.
      766               end.
      767               else do:
      768                   case substring( p-in-string, v-position + 1, 3 )
      769                   :
      770                       when "lt;":U
      771                       then do:
      772                           assign
      773                               p-out-string = p-out-string + "<":U
      774                               v-position   = v-position   + 3
      775                           .
      776                       end.
      777                       when "gt;":U
      778                       then do:
      779                           assign
      780                               p-out-string = p-out-string + ">":U
      781                               v-position   = v-position   + 3
      782                           .
      783                       end.
      784                       otherwise do:
      785                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      786                           then do:
      787                               assign
      788                                   p-out-string = p-out-string + "&":U
      789                                   v-position   = v-position   + 4
      790                               .
      791                           end.
      792                           else do:
      793                               case substring( p-in-string, v-position + 1, 5 )
      794                               :
      795                                   when "quot;":U
      796                                   then do:
      797                                       assign
      798                                           p-out-string = p-out-string + '"':U
      799                                           v-position   = v-position   + 5
      800                                       .
      801                                   end.
      802                                   when "apos;":U
      803                                   then do:
      804                                       assign
      805                                           p-out-string = p-out-string + "'":U
      806                                           v-position   = v-position   + 5
      807                                       .
      808                                   end.
      809                                   otherwise do:
      810                                       assign
      811                                           p-out-string = p-out-string + "&":U
      812                                       .
      813                                   end.
      814                               end case.
      815                           end.
      816                       end.
      817                   end case.
      818               end.
      819           end.
      820       end.
      821   end.
      822   end .
      823   procedure xmlchar-read-integer :
      824   define input parameter p-input-string      as character        no-undo.
      825   define output parameter p-output-integer   as integer          no-undo.
      826   define output parameter p-success       as logical          no-undo.
      827   do
      828   on error undo, return error
      829   :
      830       assign
      831           p-output-integer = integer( p-input-string )
      832       no-error.
      833       if error-status :error
      834       then do:
      835           assign
      836               p-success           = no
      837               p-output-integer    = 0
      838           .
      839       end.
      840       else do:
      841           assign
      842               p-success           = yes
      843           .
      844       end.
      845   end.
      846   end.
      847   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   procedure strtdate :
      849     define input  parameter p-str         as character no-undo .
      850     define output parameter p-value       as date      no-undo .
      851     define output parameter p-data-valid  as logical   no-undo .
      852     define output parameter p-message     as character no-undo .
      853   do
      854   on error undo, return error return-value
      855   :
      856     define variable v-value       as date      no-undo .
      857     define variable v-i           as integer   no-undo .
      858     define variable v-num         as integer   no-undo .
      859     define variable v-delim       as character no-undo .
      860     define variable v-delim-list  as character no-undo .
      861     define variable v-day         as integer   no-undo .
      862     define variable v-month       as integer   no-undo .
      863     define variable v-year        as integer   no-undo .
      864     define variable v-day-str     as character no-undo .
      865     define variable v-month-str   as character no-undo .
      866     define variable v-year-str    as character no-undo .
      867     assign
      868       p-value       = ?
      869       p-data-valid  = false
      870     .
      871     if p-str = ?
      872     then do:
      873       assign
      874         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      875       .
      876       return .
      877     end.
      878     if p-str = ""
      879     then do:
      880       assign
      881         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      882       .
      883       return .
      884     end.
      885     if length(p-str)  > 10
      886     then do:
      887       assign
      888         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      889       .
      890       return .
      891     end.
      892     assign
      893       v-delim-list = '/,-,.':U
      894     .
      895     _delim:
      896     do v-i = 1 to num-entries( v-delim-list )
      897     :
      898       assign
      899         v-delim = entry( v-i , v-delim-list )
      900         v-num   = num-entries( p-str , v-delim )
      901       .
      902       if v-num <> 3
      903       then do:
      904         assign
      905           v-delim = ''
      906         .
      907       end.
      908       else do:
      909         leave _delim.
      910       end.
      911     end.
      912     if v-delim = ''
      913     then do:
      914       assign
      915         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      916       .
      917       return .
      918     end.
      919     assign
      920       v-day-str   = entry( 1, p-str , v-delim)
      921       v-month-str = entry( 2, p-str , v-delim)
      922       v-year-str  = entry( 3, p-str , v-delim)
      923     .
      924     if  length(v-day-str) > 2   or
      925         length(v-day-str) < 1   or
      926         length(v-month-str) > 2 or
      927         length(v-month-str) < 1 or
      928         (
      929           length(v-year-str) <> 2 and
      930           length(v-year-str) <> 4
      931         )
      932     then do:
      933       assign
      934         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      935       .
      936       return .
      937     end.
      938     if length( v-year-str ) = 2
      939     then do:
      940       assign
      941         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      942       .
      943     end.
      944     assign
      945       v-day   = integer( v-day-str )
      946       v-month = integer( v-month-str)
      947       v-year  = integer( v-year-str)
      948     no-error .
      949     if error-status :error
      950     then do:
      951       assign
      952         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      953       .
      954       return .
      955     end.
      956     if v-day < 1  or
      957        v-day > 31 or
      958        v-month < 1 or
      959        v-month > 12 or
      960        v-year < 0   or
      961        v-year > 5000
      962     then do:
      963       assign
      964         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      965       .
      966       return .
      967     end.
      968     assign
      969       v-value = date( v-month, v-day, v-year )
      970     no-error .
      971     if error-status :error
      972     then do:
      973       assign
      974         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      975       .
      976       return .
      977     end.
      978     assign
      979       p-value       = v-value
      980       p-data-valid  = true
      981     .
      982   end.
      983   end procedure.
      984   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      985   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
