     2812           run writelog in this-procedure ( log-file-name, 1,
     2813                                                       temp-fact-ord.obj-type
     2814                                                       + "   " + dtm-char( string(temp-fact-ord.obj-code) )
     2815                                                       + "   " + dtm-char( string(temp-fact-ord.min-fact-order) )
     2816                                                       + "   " + dtm-char( string(temp-fact-ord.max-fact-order) )
     2817                                               ).
     2818       end.
     2819   if session :set-wait-state( "compiler" ) then.
     2820       run cur-time in this-procedure ( output v-today
     2821                                      , output v-time
     2822                                      ).
     2823       assign
     2824           v-file-name = "g_" + substring(string(year(v-today)),3,2) + string(month(v-today)) + string(day(v-today))
     2825       .
     2826       os-delete value(v-file-name + ".txt").
     2827       output stream out-stream to value(v-file-name + ".txt") convert target "1251" append.
     2828       good-on-object:
     2829       for each buf_gds-obj no-lock
     2830       break by buf_gds-obj.gds-code
     2831       :
     2832           if first-of( buf_gds-obj.gds-code )
     2833           then do:
     2834               assign
     2835                   v-last-tmp-obj = no
     2836                   v-temp-exists  = no
     2837                   v-last-qnty    = 0
     2838                   v-last-sum     = 0
     2839               .
     2840           end.
     2841           if last-of( buf_gds-obj.gds-code )
     2842           then do:
     2843               assign
     2844                   v-last-tmp-obj = yes
     2845               .
     2846           end.
     2847           find first temp-fact-ord
     2848                where temp-fact-ord.obj-type = buf_gds-obj.obj-type
     2849                  and temp-fact-ord.obj-code = buf_gds-obj.obj-code
     2850           no-error.
     2851           if not available temp-fact-ord
     2852           then do:
     2853               if v-last-tmp-obj = yes and v-temp-exists = yes
     2854               then do:
     2855                   run eval-sum-and-write-result in this-procedure (
     2856                         input buf_gds-obj.obj-type
     2857                       , input buf_gds-obj.obj-code
     2858                       , input buf_gds-obj.artic
     2859                       , input buf_gds-obj.prod-type
     2860                       , input buf_gds-obj.prod-code
     2861                   ).
     2862               end.
     2863               next good-on-object.
     2864           end.
     2865           find first temp-obj
     2866                where temp-obj.host-code = v-g-ut-stk-host-code
     2867                  and temp-obj.obj-type  = buf_gds-obj.obj-type
     2868                  and temp-obj.obj-code  = buf_gds-obj.obj-code
     2869           no-error.
     2870           if not available temp-obj
     2871           then do:
     2872               if v-last-tmp-obj = yes and v-temp-exists = yes
     2873               then do:
     2874                   run eval-sum-and-write-result in this-procedure (
     2875                         input buf_gds-obj.obj-type
     2876                       , input buf_gds-obj.obj-code
     2877                       , input buf_gds-obj.artic
     2878                       , input buf_gds-obj.prod-type
     2879                       , input buf_gds-obj.prod-code
     2880                   ).
     2881               end.
     2882               next good-on-object.
     2883           end.
     2884           find first buf_goods no-lock
     2885                where buf_goods.gds-code = buf_gds-obj.gds-code
     2886           .
     2887           if    buf_gds-obj.last-doc  < v-date-from
     2888              or buf_gds-obj.first-doc > v-date-to
     2889           then do:
     2890               if v-temp-exists = no
     2891               then do:
     2892                   run create-temp-good in this-procedure (
     2893                         input buf_gds-obj.obj-type
     2894                       , input buf_gds-obj.obj-code
     2895                       , input buf_gds-obj.artic
     2896                       , input buf_gds-obj.prod-type
     2897                       , input buf_gds-obj.prod-code
     2898                       , input buf_goods.gds-name
     2899                   ).
     2900               end.
     2901               if buf_gds-obj.last-doc  < v-date-from
     2902               then do:
     2903                   for each ub.stk-line
     2904                   where ub.stk-line.obj-type  = buf_gds-obj.obj-type
     2905                       and ub.stk-line.obj-code  = buf_gds-obj.obj-code
     2906                       and ub.stk-line.artic     = buf_gds-obj.artic
     2907                       and ub.stk-line.prod-type = buf_gds-obj.prod-type
     2908                       and ub.stk-line.prod-code = buf_gds-obj.prod-code
     2909                       and ub.stk-line.sum-type  = 'cost':U
     2910                       and ub.stk-line.cat-id    = '##,##'
     2911                       and ub.stk-line.fact-order <= temp-fact-ord.max-fact-order
     2912                   break by ub.stk-line.fact-order descending
     2913                   :
     2914                       assign
     2915                           v-last-qnty          = v-last-qnty  + ub.stk-line.fact-qnty
     2916                           v-last-sum           = v-last-sum   + ub.stk-line.sum-rubl
     2917                       .
     2918                       leave.
     2919                   end.
     2920               end.
     2921               if v-last-tmp-obj = yes and v-temp-exists = yes
     2922               then do:
     2923                   run eval-sum-and-write-result in this-procedure (
     2924                         input buf_gds-obj.obj-type
     2925                       , input buf_gds-obj.obj-code
     2926                       , input buf_gds-obj.artic
     2927                       , input buf_gds-obj.prod-type
     2928                       , input buf_gds-obj.prod-code
     2929                   ).
     2930               end.
     2931               next good-on-object.
     2932           end.
     2933           find first temp-good no-lock
     2934                where temp-good.gds-code = buf_gds-obj.gds-code
     2935           no-error.
     2936           if not available temp-good
     2937           then do:
     2938               run create-temp-good in this-procedure (
     2939                     input buf_gds-obj.obj-type
     2940                   , input buf_gds-obj.obj-code
     2941                   , input buf_gds-obj.artic
     2942                   , input buf_gds-obj.prod-type
     2943                   , input buf_gds-obj.prod-code
     2944                   , input buf_goods.gds-name
     2945               ).
     2946           end.
     2947           for each ub.stk-line
     2948              where ub.stk-line.obj-type  = buf_gds-obj.obj-type
     2949                and ub.stk-line.obj-code  = buf_gds-obj.obj-code
     2950                and ub.stk-line.artic     = buf_gds-obj.artic
     2951                and ub.stk-line.prod-type = buf_gds-obj.prod-type
     2952                and ub.stk-line.prod-code = buf_gds-obj.prod-code
     2953                and ub.stk-line.sum-type  = 'cost':U
     2954                and ub.stk-line.cat-id    = '##,##'
     2955                and ub.stk-line.fact-order <= temp-fact-ord.max-fact-order
     2956           break by ub.stk-line.fact-order descending
     2957           :
     2958               assign
     2959                   temp-good.qnty-last  = temp-good.qnty-last + ub.stk-line.fact-qnty
     2960                   temp-good.sum-last = temp-good.sum-last +  ub.stk-line.sum-rubl
     2961               .
     2962               leave.
     2963           end.
     2964           for each ub.stk-line
     2965              where ub.stk-line.obj-type  = buf_gds-obj.obj-type
     2966                and ub.stk-line.obj-code  = buf_gds-obj.obj-code
     2967                and ub.stk-line.artic     = buf_gds-obj.artic
     2968                and ub.stk-line.prod-type = buf_gds-obj.prod-type
     2969                and ub.stk-line.prod-code = buf_gds-obj.prod-code
     2970                and ub.stk-line.sum-type  = 'cost':U
     2971                and ub.stk-line.cat-id    = '##,##'
     2972                and ub.stk-line.fact-order <= temp-fact-ord.min-fact-order
     2973           break by ub.stk-line.fact-order descending
     2974           :
     2975               assign
     2976                   temp-good.qnty-first    = temp-good.qnty-first + ub.stk-line.fact-qnty
     2977                   temp-good.sum-first     = temp-good.sum-first +  ub.stk-line.sum-rubl
     2978               .
     2979               leave.
     2980           end.
     2981           if v-last-tmp-obj = yes and v-temp-exists = yes
     2982           then do:
     2983               run eval-sum-and-write-result in this-procedure (
     2984                     input buf_gds-obj.obj-type
     2985                   , input buf_gds-obj.obj-code
     2986                   , input buf_gds-obj.artic
     2987                   , input buf_gds-obj.prod-type
     2988                   , input buf_gds-obj.prod-code
     2989               ).
     2990           end.
     2991       end.
     2992   if session :set-wait-state( "" ) then.
     2993       message
     2994         "Экспорт остатков завершен. Файл с результатами находится в каталоге запуска Trade House"
     2995       view-as alert-box.
     2996   end.
     2997     procedure eval-sum-and-write-result :
     2998     define input parameter p-obj-type   as character        no-undo.
     2999     define input parameter p-obj-code   as integer          no-undo.
     3000     define input parameter p-artic      as character        no-undo.
     3001     define input parameter p-prod-type  as character        no-undo.
     3002     define input parameter p-prod-code  as integer          no-undo.
     3003       define buffer buf_gds-obj       for ub.gds-obj.
     3004   do
     3005   for buf_gds-obj
     3006   on error undo, return error
     3007   :
     3008       find first buf_gds-obj no-lock
     3009            where buf_gds-obj.obj-type     = p-obj-type
     3010              and buf_gds-obj.obj-code     = p-obj-code
     3011              and buf_gds-obj.artic        = p-artic
     3012              and buf_gds-obj.prod-type    = p-prod-type
     3013              and buf_gds-obj.prod-code    = p-prod-code
     3014       .
     3015           assign
     3016               temp-good.qnty-first    = temp-good.qnty-first  + v-last-qnty
     3017               temp-good.sum-first     = temp-good.sum-first   + v-last-sum
     3018               temp-good.qnty-last    = temp-good.qnty-last    + v-last-qnty
     3019               temp-good.sum-last     = temp-good.sum-last     + v-last-sum
     3020           .
     3021               for each temp-obj no-lock
     3022                  where temp-obj.host-code = v-g-ut-stk-host-code
     3023                 , each ub.ot-line no-lock
     3024                  where ub.ot-line.obj-type   = temp-obj.obj-type
     3025                    and ub.ot-line.obj-code   = temp-obj.obj-code
     3026                    and ub.ot-line.artic      = buf_gds-obj.artic
     3027                    and ub.ot-line.prod-type  = buf_gds-obj.prod-type
     3028                    and ub.ot-line.prod-code  = buf_gds-obj.prod-code
     3029                    and ub.ot-line.sum-type   = 'sale':U
     3030                    and ub.ot-line.fact-order >= temp-fact-ord.min-fact-order
     3031                    and ub.ot-line.fact-order <= temp-fact-ord.max-fact-order
     3032               :
     3033                   if   ub.ot-line.ext-doc-type = 'ee':U
     3034                     or ub.ot-line.ext-doc-type = 'es':U
     3035                     or ub.ot-line.ext-doc-type = 're':U
     3036                     or ub.ot-line.ext-doc-type = 'rs':U
     3037                   then do:
     3038                       assign
     3039                           temp-good.qnty-ras-vnesh = temp-good.qnty-ras-vnesh + ub.ot-line.fact-qnty
     3040                           temp-good.sum-ras-vnesh  = temp-good.sum-ras-vnesh  + ub.ot-line.sum-rubl
     3041                       .
     3042                       run writelog in this-procedure ( log-file-name, 4,
     3043                                                  "Расходный документ ( " + dtm-char( string( ub.ot-line.doc-code ) )
     3044                                                  + " ). Количество ( " + dtm-char( string( temp-good.qnty-ras-vnesh ) )
     3045                                                  + " ). Сумма ( " + dtm-char( string( temp-good.sum-ras-vnesh ) )
     3046                                                  + " )"
     3047                                                           ).
     3048                   end.
     3049               end.
     3050               if      temp-good.qnty-ras-vnesh <> 0
     3051                   or  temp-good.sum-ras-vnesh <> 0
     3052               then do:
     3053                   run writelog in this-procedure ( log-file-name, 3,
     3054                                       "Количество ( " + dtm-char( string( temp-good.qnty-ras-vnesh ) )
     3055                                       + " ) и сумма ( " + dtm-char( string( temp-good.sum-ras-vnesh ) )
     3056                                       + " ) по расходу за период"
     3057                                                       ).
     3058               end.
     3059               if      temp-good.qnty-first <> 0
     3060                   or  temp-good.qnty-last <> 0
     3061                   or  temp-good.sum-first <> 0
     3062                   or  temp-good.sum-last <> 0
     3063                   or  temp-good.qnty-ras-vnesh <> 0
     3064                   or  temp-good.sum-ras-vnesh <> 0
     3065               then do:
     3066                   for each temp-fact-ord
     3067                   :
     3068   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3069   gp-fact-order = 0 .
     3070   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3071     (input  buf_gds-obj.gds-code
     3072     ,input  ?
     3073     ,output gp-b-code
     3074     ) no-error .
     3075   if error-status:error then do:
     3076     message
     3077       error-status :get-message(1) skip
     3078       return-value skip
     3079       view-as alert-box error .
     3080     return error.
     3081   end.
     3082   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3083   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3084     (input  temp-fact-ord.obj-type
     3085     ,input  temp-fact-ord.obj-code
     3086     ,input  gp-b-code
     3087     ,input  0
     3088     ,input  gp-fact-order
     3089     ,output gp-doc-num
     3090     ,output gp-price-sale
     3091     ,output gp-road-tax
     3092     ,output gp-excise
     3093     ) no-error .
     3094   if error-status:error then do:
     3095     return error.
     3096   end.
     3097   gp-price-sale-parts = gp-price-sale.
     3098   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3099   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     3100     (input  temp-fact-ord.obj-type
     3101     ,input  temp-fact-ord.obj-code
     3102     ,input  gp-b-code
     3103     ,input  0
     3104     ,input  gp-fact-order
     3105     ,output gp-doc-num
     3106     ,output gp-price-sale-parts
     3107     ,output gp-road-tax
     3108     ,output gp-excise
     3109     ) no-error .
     3110   if error-status:error then do:
     3111     return error.
     3112   end.
     3113   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     3114       gp-price-sale = gp-price-sale-parts.
     3115    end.
     3116                       if temp-good.current-price = ? or temp-good.current-price <  gp-price-sale
     3117                       then do:
     3118                           assign
     3119                               temp-good.current-price =  gp-price-sale
     3120                           .
     3121                       end.
     3122                       run writelog in this-procedure ( log-file-name, 3,
     3123                                   "Определили максимальную текущую цену ( " + dtm-char( string(temp-good.current-price) )
     3124                                   + " ) для товара ( "  + string(buf_gds-obj.artic)
     3125                                   + " ) на объекте ( " + temp-fact-ord.obj-type + string(temp-fact-ord.obj-code)
     3126                                   + " )"
     3127                       ).
     3128                   end.
     3129                   export stream out-stream delimiter ";"
     3130                       temp-good
     3131                   .
     3132                   assign
     3133                       v-good-counter = v-good-counter + 1
     3134                   .
     3135               end.
     3136               else do:
     3137                   delete temp-good.
     3138               end.
     3139   end.
     3140   end procedure.
     3141   procedure create-temp-good :
     3142   define input parameter p-obj-type   as character        no-undo.
     3143   define input parameter p-obj-code   as integer          no-undo.
     3144   define input parameter p-artic      as character        no-undo.
     3145   define input parameter p-prod-type  as character        no-undo.
     3146   define input parameter p-prod-code  as integer          no-undo.
     3147   define input parameter p-gds-name   as character        no-undo.
     3148       define buffer buf_gds-obj       for ub.gds-obj.
     3149   do
     3150   for buf_gds-obj
     3151   on error undo, return error
     3152   :
     3153       find first buf_gds-obj no-lock
     3154            where buf_gds-obj.obj-type     = p-obj-type
     3155              and buf_gds-obj.obj-code     = p-obj-code
     3156              and buf_gds-obj.artic        = p-artic
     3157              and buf_gds-obj.prod-type    = p-prod-type
     3158              and buf_gds-obj.prod-code    = p-prod-code
     3159       .
     3160           for each temp-good
     3161           :
     3162               delete temp-good.
     3163           end.
     3164           create temp-good.
     3165           assign
     3166               temp-good.gds-code          = buf_gds-obj.gds-code
     3167               temp-good.artic             = buf_gds-obj.artic
     3168               temp-good.prod-type         = buf_gds-obj.prod-type
     3169               temp-good.prod-code         = buf_gds-obj.prod-code
     3170               temp-good.gds-name          = p-gds-name
     3171               temp-good.current-price     = ?
     3172               temp-good.qnty-first        = 0
     3173               temp-good.sum-first         = 0
     3174               temp-good.qnty-last         = 0
     3175               temp-good.sum-last          = 0
     3176               temp-good.qnty-ras-vnesh    = 0
     3177               temp-good.sum-ras-vnesh     = 0
     3178           .
     3179           assign
     3180               v-temp-exists = yes
     3181           .
     3182   end.
     3183   end procedure.
