      991   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      992   define variable v-bge-xml-log-file-name as character    no-undo.
      993   define variable v-bge-xml-dbf-file-name as character    no-undo.
      994   define variable v-bge-xml-db-num-str    as character    no-undo .
      995   define variable v-bge-xml-static-log-file-name as character    no-undo.
