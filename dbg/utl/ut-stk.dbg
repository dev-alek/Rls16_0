      174   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      175   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      176   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      177   define variable gp-excise     like ub.price-list.excise     no-undo.
      178   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      179   define variable gp-fact-order as decimal   no-undo .
