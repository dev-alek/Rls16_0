       83   define  temp-table temp-host no-undo
       84     field host-code like ub.store.host-code
       85     index xpk host-code
       86   .
       87   define  temp-table temp-obj no-undo
       88     field obj-type  like ub.clients.obj-type
       89     field obj-code  like ub.clients.obj-code
       90     field host-code like ub.store.host-code
       91     field db-num    like ub.clients.db-num
       92     index xpk  obj-type obj-code
       93     index xie1 host-code
       94     index xie2 db-num host-code
       95   .
       96   procedure init-temphost:
       97     define buffer buf_store   for ub.store .
       98     define buffer buf_shop    for ub.shop .
       99     define buffer buf_clients for ub.clients .
      100     define buffer buf_db for ub.db .
      101     define buffer buf_temp-host for temp-host .
      102     define buffer buf_temp-obj for temp-obj .
      103     do
      104     on error undo, return error return-value
      105     :
      106       for each buf_store
      107       on error undo, return error
      108       :
      109         find first buf_temp-host
      110           where buf_temp-host.host-code = buf_store.host-code
      111           no-error .
      112         if not available buf_temp-host
      113         then do:
      114           create buf_temp-host .
      115           assign
      116             buf_temp-host.host-code = buf_store.host-code
      117           .
      118         end.
      119         find first buf_clients no-lock
      120           where buf_clients.obj-type = 'скл':U
      121             and buf_clients.obj-code = buf_store.obj-code
      122           no-error .
      123         if not available buf_clients
      124         then do:
      125           message
      126             "Ошибка при поиске клиента" skip
      127             "Клиент" 'скл':U buf_store.obj-code skip
      128             view-as alert-box error .
      129           undo, return error .
      130         end.
      131         create buf_temp-obj .
      132         assign
      133           buf_temp-obj.obj-type  = 'скл':U
      134           buf_temp-obj.obj-code  = buf_store.obj-code
      135           buf_temp-obj.host-code = buf_store.host-code
      136           buf_temp-obj.db-num    = buf_clients.db-num
      137         .
      138       end.
      139       for each buf_shop
      140       on error undo, return error
      141       :
      142         find first buf_temp-host
      143           where buf_temp-host.host-code = buf_shop.host-code
      144           no-error .
      145         if not available buf_temp-host
      146         then do:
      147           create buf_temp-host .
      148           assign
      149             buf_temp-host.host-code = buf_shop.host-code
      150           .
      151         end.
      152         find first buf_clients no-lock
      153           where buf_clients.obj-type = 'маг':U
      154             and buf_clients.obj-code = buf_shop.obj-code
      155           no-error .
      156         if not available buf_clients then do:
      157           message
      158             "Ошибка при поиске клиента" skip
      159             "Клиент" 'маг':U buf_shop.obj-code skip
      160             view-as alert-box error .
      161           undo, return error .
      162         end.
      163         create buf_temp-obj .
      164         assign
      165           buf_temp-obj.obj-type  = 'маг':U
      166           buf_temp-obj.obj-code  = buf_shop.obj-code
      167           buf_temp-obj.host-code = buf_shop.host-code
      168           buf_temp-obj.db-num    = buf_clients.db-num
      169         .
      170       end.
      171     end.
      172   end.
