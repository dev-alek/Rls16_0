        1   block-level on error undo, throw.
        2   define input  parameter p-contract-num     as integer   no-undo .
        3   define input  parameter p-host-code as integer   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: uspemgrp.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/uspemgrp.p $":U .
        9   define variable vss-description as character no-undo init "Пересчет По группам товара + Спецификации".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define variable vss-include-info1 as character format "X(65)" no-undo
      319   initial "@(#)$Workfile$ $Revision$".
      320   define temp-table temp_grplib_grp no-undo
      321       field sel           as character
      322       field nabor         as character
      323       field full-name     as character
      324       field print-code    as character
      325       field sort-name     as character
      326       field node-code     as integer
      327       field upper-code    as integer
      328       field calc-method   as character
      329       field round-method  as character
      330       field increase-pc   as decimal
      331       field min-marg      as character
      332       field max-marg      as character
      333       field cli-type      as character
      334       field cli-code      as integer
      335       field notcorr      as character
      336       field name          as character
      337       field level         as integer
      338       field mark          as character
      339       index pi is primary unique sort-name
      340       index fn full-name
      341       index nc is unique node-code
      342       index sl sel
      343       index uc upper-code
      344   .
      345   define temp-table temp_grplib_found-grp no-undo
      346       field full-name   as character
      347       field sort-name   as character
      348       field node-code   as integer
      349       field level       as integer
      350       field is-terminal as logical
      351       index pi is primary unique sort-name
      352       index fn full-name
      353       index lv level
      354       index it is-terminal
      355   .
      356   define temp-table temp_found-result-nodelist no-undo
      357       field node-code     as recid
      358       field processed     as logical
      359       field sort-name     as character
      360       field full-name     as character
      361       index pi is primary unique node-code
      362       index ps processed
      363   .
      364   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      365   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      366   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      367   procedure grplib-get-parameters :
      368   define input parameter p-store-type     as character        no-undo.
      369   define input parameter p-store-code     as integer          no-undo.
      370   do
      371   on error undo, return error
      372   :
      373       assign
      374           v-grplib-not-fill-extra-info = no
      375       .
      376   end.
      377   end procedure.
      378   procedure grplib-get-sort-name :
      379   do
      380   on error undo, return error
      381   :
      382   define input parameter p-node-code  as integer      no-undo.
      383   define output parameter p-sort-name as character    no-undo.
      384       define variable v-upper-code    as integer           no-undo.
      385       define buffer buf_gds-grp       for ub.gds-grp.
      386       define buffer buf_upper_gds-grp for ub.gds-grp.
      387       find first buf_gds-grp no-lock
      388            where buf_gds-grp.node-code = p-node-code
      389       no-error.
      390       if not available buf_gds-grp
      391       then do:
      392           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      393       end.
      394       assign
      395           p-sort-name  = ""
      396           v-upper-code = 1
      397       .
      398       do while buf_gds-grp.upper-code <> 0
      399       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      400       :
      401           assign
      402               p-sort-name  = buf_gds-grp.node-name
      403                            + (if p-sort-name <> "" then chr(2) else "")
      404                            + p-sort-name
      405               v-upper-code = buf_gds-grp.upper-code
      406           .
      407           find first buf_gds-grp no-lock
      408                where buf_gds-grp.node-code = v-upper-code
      409           no-error.
      410           if not available buf_gds-grp
      411           then do:
      412               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      413                                   + string( v-upper-code )
      414                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      415           end.
      416       end.
      417   end.
      418   end procedure.
      419   define variable vss-include-info2 as character format "X(65)" no-undo
      420   initial "@(#)$Workfile$ $Revision$".
      421   procedure grplib-get-full-name :
      422      define input parameter p-node-code  as integer      no-undo.
      423      define output parameter p-full-name as character    no-undo.
      424      do
      425   on error undo, return error
      426   :
      427       define variable v-upper-code    as integer           no-undo.
      428       define buffer buf_gds-grp       for ub.gds-grp.
      429       define buffer buf_upper_gds-grp for ub.gds-grp.
      430       find first buf_gds-grp no-lock
      431            where buf_gds-grp.node-code = p-node-code
      432       no-error.
      433       if not available buf_gds-grp
      434       then do:
      435           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      436       end.
      437       assign
      438           p-full-name  = ""
      439           v-upper-code = 1
      440       .
      441       do while buf_gds-grp.upper-code <> 0
      442       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      443       :
      444           assign
      445               p-full-name  = buf_gds-grp.node-name
      446                            + (if p-full-name <> "" then chr(47) else "")
      447                            + p-full-name
      448               v-upper-code = buf_gds-grp.upper-code
      449           .
      450           find first buf_gds-grp no-lock
      451                where buf_gds-grp.node-code = v-upper-code
      452           no-error.
      453           if not available buf_gds-grp
      454           then do:
      455               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      456                                   + string( v-upper-code )
      457                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      458           end.
      459       end.
      460       assign
      461       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      462       .
      463   end.
      464   end .
      465   procedure grplib-get-node-from-full-name :
      466   define input parameter p-full-name as character no-undo .
      467   define output parameter p-node-code as integer no-undo .
      468   define variable v-ii as integer no-undo .
      469   define variable v-upper-code as integer no-undo .
      470   define variable v-root-code as integer no-undo .
      471   define variable v-entry as character no-undo .
      472   define buffer buf_gds-grp       for ub.gds-grp.
      473   do
      474   on error undo, return error
      475   :
      476     find first buf_gds-grp no-lock
      477         where buf_gds-grp.upper-code = 0
      478     no-error .
      479     if not available buf_gds-grp
      480     then do:
      481         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      482     end.
      483     else do:
      484       assign
      485       v-root-code = buf_gds-grp.node-code
      486       .
      487     end.
      488     v-upper-code = v-root-code.
      489     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      490       assign
      491       v-entry = entry(v-ii, p-full-name, chr(47)).
      492       if v-entry = '' then leave.
      493       find first buf_gds-grp no-lock where
      494                 buf_gds-grp.node-name = v-entry
      495             and buf_gds-grp.upper-code = v-upper-code
      496             no-error.
      497       if not available buf_gds-grp then do:
      498         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      499       end.
      500       else do:
      501         p-node-code = buf_gds-grp.node-code.
      502         v-upper-code = buf_gds-grp.node-code.
      503       end.
      504     end.
      505   end.
      506   end .
      507   procedure grplib-get-root-code :
      508   do
      509   on error undo, return error
      510   :
      511   define output parameter p-root-code as integer      no-undo.
      512       define buffer buf_gds-grp       for ub.gds-grp.
      513       find first buf_gds-grp no-lock
      514           where buf_gds-grp.upper-code = 0
      515       no-error .
      516       if not available buf_gds-grp
      517       then do:
      518           undo, return error .
      519       end.
      520       else do:
      521           assign
      522               p-root-code = buf_gds-grp.node-code
      523           .
      524       end.
      525   end.
      526   end procedure.
      527   procedure grplib-find-grp-by-full-name :
      528   do
      529   on error undo, return error
      530   :
      531   define input parameter p-search-name  as character    no-undo.
      532   define input parameter p-fill-path    as logical      no-undo.
      533   define output parameter p-found       as logical      no-undo.
      534       define variable v-upper-code    as integer          no-undo.
      535       define variable v-counter       as integer           no-undo.
      536       define variable v-level         as integer           no-undo.
      537       define variable v-full-name     as character         no-undo.
      538       define variable v-sort-name     as character         no-undo.
      539       define buffer buf_gds-grp       for ub.gds-grp.
      540       assign
      541           p-search-name = replace( p-search-name, chr(47), chr(2) )
      542       .
      543       run grplib-get-root-code ( output v-upper-code ) no-error .
      544       if error-status :error
      545       then do:
      546           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      547       end.
      548       assign
      549           v-full-name  = ""
      550           v-level      = num-entries( p-search-name, chr(2) )
      551       .
      552       for each temp_grplib_found-grp
      553       :
      554           delete temp_grplib_found-grp.
      555       end.
      556       start-name-analyze:
      557       do v-counter = 1 to v-level
      558       :
      559           if v-counter < v-level
      560           then do:
      561               find first buf_gds-grp no-lock
      562                    where buf_gds-grp.upper-code = v-upper-code
      563                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      564               no-error .
      565               if not available buf_gds-grp
      566               then do:
      567                   assign
      568                       v-full-name  = p-search-name
      569                       v-sort-name  = p-search-name
      570                   .
      571                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      572               end.
      573               else do:
      574                   assign
      575                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      576                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      577                       v-upper-code = buf_gds-grp.node-code
      578                   .
      579                   if p-fill-path = yes
      580                   then do:
      581                       create temp_grplib_found-grp.
      582                       assign
      583                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      584                           temp_grplib_found-grp.sort-name = v-sort-name
      585                           temp_grplib_found-grp.node-code = v-upper-code
      586                           temp_grplib_found-grp.level     = v-counter
      587                       .
      588                   end.
      589               end.
      590           end.
      591           else do:
      592               for each buf_gds-grp no-lock
      593                  where buf_gds-grp.upper-code = v-upper-code
      594                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      595               :
      596                   assign
      597                       p-found = yes
      598                   .
      599                   create temp_grplib_found-grp.
      600                   assign
      601                       temp_grplib_found-grp.full-name = v-full-name
      602                                                           + (if v-full-name = "" then "" else chr(47) )
      603                                                           + buf_gds-grp.node-name + chr(47)
      604                       temp_grplib_found-grp.sort-name = v-sort-name
      605                                                           + ( if v-sort-name = "" then "" else chr(2) )
      606                                                           + buf_gds-grp.node-name
      607                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      608                       temp_grplib_found-grp.level     = v-level
      609                   .
      610               end.
      611               if p-found = no
      612               then do:
      613                   assign
      614                       v-full-name  = p-search-name
      615                       v-sort-name  = p-search-name
      616                   .
      617                   for each temp_grplib_found-grp
      618                   :
      619                       delete temp_grplib_found-grp.
      620                   end.
      621                   assign
      622                       p-found = no
      623                   .
      624               end.
      625           end.
      626       end.
      627   end.
      628   end procedure.
      629   procedure grplib-find-all-subgroup :
      630   do
      631   on error undo, return error
      632   :
      633   define input parameter p-start-node-code    as integer      no-undo.
      634   define input parameter p-terminal-only      as logical      no-undo.
      635       define variable v-start-full-name   as character     no-undo.
      636       define variable v-start-sort-name   as character     no-undo.
      637       define variable v-not-found         as logical       no-undo.
      638       define variable v-is-terminal       as logical       no-undo.
      639       define buffer buf_gds-grp           for ub.gds-grp.
      640       create temp_found-result-nodelist.
      641       assign
      642           temp_found-result-nodelist.node-code = p-start-node-code
      643           temp_found-result-nodelist.processed = no
      644       .
      645       run grplib-get-full-name in this-procedure (
      646             input p-start-node-code
      647           , output v-start-full-name
      648       ).
      649       run grplib-get-full-name in this-procedure (
      650             input p-start-node-code
      651           , output v-start-sort-name
      652       ).
      653       process-nodes:
      654       do while yes
      655       :
      656           find first temp_found-result-nodelist
      657                where temp_found-result-nodelist.node-code = p-start-node-code
      658           .
      659           assign
      660               temp_found-result-nodelist.processed = yes
      661           .
      662           for each buf_gds-grp no-lock
      663              where buf_gds-grp.upper-code = p-start-node-code
      664           on error undo, return error
      665           :
      666               run grplib-is-terminal in this-procedure (
      667                     input buf_gds-grp.node-code
      668                   , output v-is-terminal
      669               ).
      670               if v-is-terminal = yes
      671               then do:
      672                   create temp_grplib_found-grp.
      673                   assign
      674                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      675                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      676                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      677                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      678                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      679                       temp_grplib_found-grp.is-terminal = yes
      680                   .
      681               end.
      682               else do:
      683                   create temp_found-result-nodelist.
      684                   assign
      685                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      686                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      687                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      688                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      689                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      690                       temp_found-result-nodelist.processed = no
      691                   .
      692                   if p-terminal-only = no
      693                   then do:
      694                       create temp_grplib_found-grp.
      695                       assign
      696                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      697                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      698                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      699                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      700                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      701                           temp_grplib_found-grp.is-terminal = no
      702                       .
      703                   end.
      704               end.
      705           end.
      706           find first temp_found-result-nodelist
      707                where temp_found-result-nodelist.processed = no
      708           no-error.
      709           if not available temp_found-result-nodelist
      710           then do:
      711               leave process-nodes.
      712           end.
      713           else do:
      714               assign
      715                   p-start-node-code = temp_found-result-nodelist.node-code
      716                   v-start-full-name = temp_found-result-nodelist.full-name
      717                   v-start-sort-name = temp_found-result-nodelist.sort-name
      718               .
      719           end.
      720       end.
      721   end.
      722   end procedure.
      723   procedure grplib-expand-name :
      724   define input parameter p-start-name as character        no-undo.
      725   define output parameter p-end-name  as character        no-undo.
      726       define variable v-is-terminal   as logical      no-undo.
      727       define variable v-found         as character    no-undo.
      728       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      729   do
      730   for buf_temp_grplib_found-grp
      731   on error undo, return error
      732   :
      733       run grplib-find-grp-by-full-name in this-procedure (
      734             input p-start-name
      735           , input no
      736           , output v-found
      737       ) no-error.
      738       run grplib-get-max-substring in this-procedure (
      739                   input length( p-start-name )
      740                 , output p-end-name
      741       ) no-error .
      742       if error-status :error
      743       then do:
      744           assign
      745               p-end-name = ""
      746           .
      747       end.
      748       else do:
      749           find first temp_grplib_found-grp
      750               where temp_grplib_found-grp.full-name = p-end-name
      751           no-error.
      752           if available temp_grplib_found-grp
      753           then do:
      754               find first buf_temp_grplib_found-grp
      755                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      756                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      757               no-error.
      758               if not available buf_temp_grplib_found-grp
      759               then do:
      760                   run grplib-is-terminal in this-procedure (
      761                       input temp_grplib_found-grp.node-code
      762                       , output v-is-terminal
      763                   ).
      764               end.
      765           end.
      766       end.
      767   end.
      768   end procedure.
      769   procedure grplib-get-max-substring :
      770   do
      771   on error undo, return error
      772   :
      773   define input parameter p-min-substring-length   as integer      no-undo.
      774   define output parameter p-substring             as character    no-undo.
      775           define variable v-char-counter  as integer           no-undo.
      776           define variable v-current-char  as character         no-undo.
      777           define variable v-names-counter  as integer           no-undo.
      778           define variable v-base-string   as character         no-undo.
      779           assign
      780               v-char-counter  = p-min-substring-length
      781           .
      782           find first temp_grplib_found-grp no-error.
      783           if not available temp_grplib_found-grp
      784           then do:
      785               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      786           end.
      787           else do:
      788               assign
      789                   v-base-string  = temp_grplib_found-grp.full-name
      790                   v-char-counter = 0
      791               .
      792               counter-block:
      793               do while yes
      794               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      795               :
      796                   assign
      797                       v-char-counter  = v-char-counter + 1
      798                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      799                       v-names-counter = 0
      800                   .
      801                   compare-block:
      802                   for each temp_grplib_found-grp
      803                   :
      804                       assign
      805                           v-names-counter = v-names-counter + 1
      806                       .
      807                       if v-names-counter = 1
      808                       then do:
      809                           next compare-block.
      810                       end.
      811                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      812                       then do:
      813                           leave counter-block.
      814                       end.
      815                   end.
      816                   if v-names-counter = 1
      817                   then do:
      818                       assign
      819                           p-substring = v-base-string
      820                       .
      821                       return.
      822                   end.
      823               end.
      824               assign
      825                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      826               .
      827           end.
      828   end.
      829   end procedure.
      830   procedure grplib-is-terminal :
      831   do
      832   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      833   :
      834   define input parameter p-node-code      as integer      no-undo.
      835   define output parameter p-is-terminal   as logical      no-undo.
      836       define buffer buf_gds-grp       for ub.gds-grp.
      837       find first buf_gds-grp no-lock
      838           where buf_gds-grp.upper-code = p-node-code
      839       no-error .
      840       if not available buf_gds-grp
      841       then do:
      842           assign
      843               p-is-terminal = yes
      844           .
      845       end.
      846       else do:
      847           assign
      848               p-is-terminal = no
      849           .
      850       end.
      851   end.
      852   end procedure.
      853   procedure grplib-have-goods :
      854   do
      855   on error undo, return error
      856   :
      857   define input parameter p-node-code      as integer      no-undo.
      858   define output parameter p-have-goods   as logical      no-undo.
      859       define buffer buf_goods         for ub.goods.
      860       find first buf_goods no-lock
      861            where buf_goods.grp-code = p-node-code
      862       no-error .
      863       if available buf_goods
      864       then do:
      865           assign
      866               p-have-goods = yes
      867           .
      868       end.
      869       else do:
      870           assign
      871               p-have-goods = no
      872           .
      873       end.
      874   end.
      875   end procedure.
      876   procedure grplib-find-by-substring :
      877   do
      878   on error undo, return error
      879   :
      880   define input parameter p-start-code         as integer      no-undo.
      881   define input parameter p-full-search-string as character    no-undo.
      882   define output parameter p-found-code        as integer      no-undo.
      883   define output parameter p-full-name         as character    no-undo.
      884       define variable v-start-code     as integer           no-undo.
      885       define variable v-found          as logical  init no  no-undo.
      886       define buffer buf_gds-grp       for ub.gds-grp.
      887       search-grp:
      888       for each buf_gds-grp no-lock
      889           where buf_gds-grp.node-code > p-start-code
      890       :
      891           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      892           then do:
      893               assign
      894                   p-found-code = buf_gds-grp.node-code
      895                   v-found      = yes
      896               .
      897               run grplib-get-full-name in this-procedure (
      898                     input p-found-code
      899                   , output p-full-name
      900               ) no-error .
      901               if error-status :error
      902               then do:
      903                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      904               end.
      905               leave search-grp.
      906           end.
      907       end.
      908       if v-found = yes
      909       then do:
      910       end.
      911       else do:
      912           assign
      913               p-full-name  = ""
      914               p-found-code = 0
      915           .
      916       end.
      917   end.
      918   end procedure.
      919   procedure grplib-analyze-grp-name :
      920   do
      921   on error undo, return error
      922   :
      923   define input parameter p-grp-name       as character            no-undo.
      924   define input parameter p-upper-code     as integer              no-undo.
      925   define output parameter p-error-message as character init ""    no-undo.
      926       define variable v-char-list     as character    no-undo.
      927       define variable v-char-counter  as integer      no-undo.
      928       define variable v-full-name     as character    no-undo.
      929       if p-grp-name = "" then do:
      930           assign
      931               p-error-message = "Название группы не может быть пустым.".
      932           .
      933       end.
      934       else do:
      935           assign
      936               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      937           .
      938           do v-char-counter = 1 to num-entries( v-char-list )
      939           :
      940               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      941               then do:
      942                   assign
      943                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      944                   .
      945                   return.
      946               end.
      947           end.
      948           if p-upper-code > 0
      949           then do:
      950               run grplib-get-full-name in this-procedure (
      951                     input p-upper-code
      952                   , output v-full-name
      953               ) no-error .
      954               if error-status :error
      955               then do:
      956                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      957               end.
      958               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      959               then do:
      960                   assign
      961                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      962                   .
      963               end.
      964           end.
      965       end.
      966   end.
      967   end procedure.
      968   procedure grplib-get-lvl-num :
      969   define input parameter p-node-code  as integer      no-undo.
      970   define output parameter p-lvl-num   as integer      no-undo.
      971       define variable v-full-name    as character    no-undo.
      972   do
      973   on error undo, return error
      974   :
      975       run grplib-get-full-name in this-procedure (
      976             input p-node-code
      977           , output v-full-name
      978       ).
      979       assign
      980           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      981       .
      982       if p-lvl-num = -1
      983       then do:
      984           assign
      985               p-lvl-num = 0
      986           .
      987       end.
      988   end.
      989   end procedure.
      990   run waitfram-show in this-procedure (substitute("Ждите. Идет пересчет ассортимента по группам в Спецификации &1" , p-contract-num)).
      991   define buffer buf_gds-grp for ub.gds-grp  .
      992   define buffer buf_contract-specif for ub.contract-specif  .
      993   define buffer buf_goods for ub.goods  .
      994   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      995   define variable kk as integer   no-undo .
      996   define variable v-full-name as character no-undo .
      997   for each buf_gds-grp no-lock :
      998         kk = 0 .
      999         if buf_gds-grp.lvl-num = 0 then do:
     1000           for each buf_contract-specif no-lock where
     1001                    buf_contract-specif.host-code = p-host-code and
     1002                    buf_contract-specif.contract-num = p-contract-num :
     1003                    kk = kk + 1 .
     1004           end.
     1005         end.
     1006         else do:
     1007             run grplib-get-full-name ( input buf_gds-grp.node-code , output v-full-name).
     1008             run waitfram-show in this-procedure (substitute("Ждите. Идет пересчет ассортимента по группам в Спецификации &1" , v-full-name)).
     1009             for each buf_contract-specif no-lock where
     1010                      buf_contract-specif.host-code = p-host-code and
     1011                      buf_contract-specif.contract-num = p-contract-num ,
     1012                first buf_goods no-lock where
     1013                      buf_goods.gds-code = buf_contract-specif.gds-code and
     1014                    ( buf_goods.grp-name begins v-full-name )
     1015                     :
     1016                     kk = kk + 1 .
     1017             end.
     1018         end.
     1019         find first buf_gds-grp-obj-attr exclusive-lock where
     1020                     buf_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
     1021                     buf_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
     1022                     buf_gds-grp-obj-attr.obj-code  = p-host-code and
     1023                     buf_gds-grp-obj-attr.host-code = 0 and
     1024                     buf_gds-grp-obj-attr.node-code = buf_gds-grp.node-code no-error .
     1025         if not available buf_gds-grp-obj-attr then do:
     1026             create buf_gds-grp-obj-attr.
     1027                  assign
     1028                     buf_gds-grp-obj-attr.attr-code = 'QntySpecGr':U
     1029                     buf_gds-grp-obj-attr.obj-type  = string(p-contract-num)
     1030                     buf_gds-grp-obj-attr.obj-code  = p-host-code
     1031                     buf_gds-grp-obj-attr.host-code = 0
     1032                     buf_gds-grp-obj-attr.node-code = buf_gds-grp.node-code
     1033                     buf_gds-grp-obj-attr.attr-value = string(kk)
     1034             .
     1035         end.
     1036         else do:
     1037             if int(buf_gds-grp-obj-attr.attr-value) <> kk then buf_gds-grp-obj-attr.attr-value = string(kk) .
     1038         end.
     1039   end.
     1040   run waitfram-hide in this-procedure .
