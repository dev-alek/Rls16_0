        1   block-level on error undo, throw.
        2   using ibs.th.skt.ControlledClients.GisMtOffline.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle as handle no-undo .
        6   define input parameter p-param-run as char no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Создание автоматического задания".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   function objExists return character
       68   (input  ifolder as character,
       69    input  iType   as character  ):
       70       define variable vFileType as character no-undo init "D,F".
       71       define variable vi        as integer no-undo.
       72       define variable vtype as character no-undo.
       73       if iType ne ?
       74       then
       75          vFileType = iType.
       76       do vi = 1 to num-entries(vFileType):
       77          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       78          vtype = file-information:file-type.
       79          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       80             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       81             index(vtype , entry(vi,vFileType )) > 0
       82          then return file-information:full-pathname .
       83          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       84          vtype = file-information:file-type.
       85          if file-information:file-name <> "" and
       86             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       87             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       88             index( vtype, entry(vi,vFileType )) > 0
       89          then return file-information:full-pathname .
       90       end.
       91       return ? .
       92   end.
       93   function SearchFile return character
       94   (input  ifile as character):
       95      return objExists(ifile,?).
       96   end.
       97   function SearchPFile return character
       98   (input inFile as char):
       99        define variable oFile       as character no-undo.
      100        define variable vFileSearch as character no-undo.
      101        define variable vNumEntry   as integer no-undo.
      102        if inFile = "" then return ?.
      103        vNumEntry = num-entries(inFile,".").
      104        vFileSearch = inFile.
      105        if    vNumEntry > 0
      106           and (   entry(vNumEntry,inFile,".") eq "p"
      107                or entry(vNumEntry,inFile,".") eq "w")
      108        then do:
      109           entry(vNumEntry,vFileSearch, ".") = "r".
      110           oFile = search(vFileSearch ).
      111           if oFile eq ?
      112           then
      113              oFile = search(inFile).
      114        end.
      115        else
      116           oFile = search(vFileSearch).
      117        return oFile.
      118     end.
      119   define variable thGisMtOff as class GisMtOffline no-undo .
      120   thGisMtOff =  new GisMtOffline() no-error.
      121   thGisMtOff:ProcInit() no-error.
      122   if error-status:error then
      123   run write-to-log in p-log-handle (
      124        substitute("Ошибка запуска инициализации ЛМЧЗ. Утилита &1"
      125                    , program-name(1)
      126                    )).
      127   else
      128   run write-to-log in p-log-handle (
      129        substitute("Запущена инициализация ЛМЧЗ. Утилита &1"
      130                    , program-name(1)
      131                    )).
      132   delete object thGisMtOff no-error.
