        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: mntusrkl.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/mntusrkl.p $":U .
        7   define variable vss-description as character no-undo init "Мониторинг за работой пользователей.".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure cur-time :
       68      define output parameter p-today as date      no-undo .
       69      define output parameter p-time  as integer   no-undo .
       70     do
       71     on error undo, return error
       72     :
       73       define variable v-date1 as date      no-undo .
       74       define variable v-date2 as date      no-undo .
       75       define variable v-time  as integer   no-undo .
       76       assign
       77         v-date1 = today
       78         v-time  = time
       79         v-date2 = today
       80       .
       81       if v-date1 <> v-date2
       82       then do:
       83         assign
       84           v-date1 = today
       85           v-time  = v-time
       86         .
       87       end.
       88       assign
       89         p-today = v-date1
       90         p-time  = v-time
       91       .
       92     end.
       93   end.
       94   function cur-time-date returns character
       95   :
       96     return string(today, '99/99/9999':U) .
       97   end.
       98   function cur-time-mjd returns decimal
       99   :
      100     define variable v-date as date      no-undo .
      101     define variable v-time as integer   no-undo .
      102     run cur-time in this-procedure
      103       (output v-date
      104       ,output v-time
      105       ) .
      106     return integer(v-date) - 2400002 + (v-time / 86400) .
      107   end.
      108   function cur-time-get-ending-index returns integer
      109   (input p-number as integer
      110   )
      111   :
      112     if p-number < 0
      113     or p-number = ?
      114     then do:
      115       return 1 .
      116     end.
      117     define variable v-rest as integer   no-undo .
      118     assign
      119       p-number = p-number modulo 100
      120     .
      121     if p-number < 20
      122     then do:
      123       assign
      124         v-rest = p-number
      125       .
      126     end.
      127     else do:
      128       assign
      129         v-rest = p-number modulo 10
      130       .
      131     end.
      132     case v-rest :
      133       when 1
      134       then do:
      135         return 2 .
      136       end.
      137       when 2 or
      138       when 3 or
      139       when 4
      140       then do:
      141         return 3 .
      142       end.
      143       otherwise do:
      144         return 1 .
      145       end.
      146     end case .
      147   end.
      148   procedure cur-time-mjd-to-date :
      149      define input  parameter i-mjd-diff as decimal no-undo.
      150      define output parameter o-Date     as date    no-undo.
      151      define output parameter o-Time     as integer no-undo.
      152      define variable v-day-number as integer   no-undo .
      153      if    i-mjd-diff < 0
      154         or i-mjd-diff = ?
      155      then do:
      156         return "?" .
      157      end.
      158      assign
      159         v-day-number = truncate(i-mjd-diff,0).
      160         o-Date = date(v-day-number + 2400002).
      161         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      162     .
      163   end.
      164   function cur-time-mjd-to-string returns character
      165   (input p-mjd-diff as decimal
      166   )
      167   :
      168     define variable v-day-number as integer   no-undo .
      169     define variable v-seconds    as integer   no-undo .
      170     define variable v-hour       as integer   no-undo .
      171     define variable v-min        as integer   no-undo .
      172     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      173     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      174     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      175     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      176     if p-mjd-diff < 0
      177     or p-mjd-diff = ?
      178     then do:
      179       return "?" .
      180     end.
      181     assign
      182       v-day-number = integer(truncate(p-mjd-diff,0))
      183       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185     if v-seconds > 86400
      186     then do:
      187       assign
      188         v-seconds = 86400 - 1
      189       .
      190     end.
      191     if v-seconds < 0
      192     then do:
      193       assign
      194         v-seconds = 0
      195       .
      196     end.
      197     assign
      198       v-hour = truncate(v-seconds / 3600, 0)
      199     .
      200     assign
      201       v-seconds = v-seconds modulo 3600
      202     .
      203     assign
      204       v-min = truncate(v-seconds / 60, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 60
      208     .
      209     return
      210         (if v-day-number <> 0
      211           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      212           else ""
      213         )
      214       + (if v-day-number <> 0 or v-hour <> 0
      215           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      219           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      220           else ""
      221         )
      222       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      223       .
      224   end.
      225   function cur-time-string returns character
      226   :
      227     define variable v-date as date      no-undo .
      228     define variable v-time as integer   no-undo .
      229     run cur-time in this-procedure
      230       (output v-date
      231       ,output v-time
      232       ) .
      233     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      234   end.
      235   function cur-time-string-sec returns character
      236   :
      237     define variable v-date as date      no-undo .
      238     define variable v-time as integer   no-undo .
      239     run cur-time in this-procedure
      240       (output v-date
      241       ,output v-time
      242       ) .
      243     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      244   end.
      245   function cur-time-custom  returns character
      246   (input p-prefix as character
      247   ,input p-date-format as character
      248   ,input p-delimiter as character
      249   ,input p-time-format as character
      250   ,input p-suffix as character
      251   )
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return
      260       p-prefix
      261       + string(v-date, p-date-format)
      262       + p-delimiter
      263       + string(v-time, p-time-format)
      264       + p-suffix
      265       .
      266   end.
      267   function cur-time-print  returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      276   end.
      277   function cur-time-datetime returns datetime
      278   :
      279     define variable v-char as character no-undo .
      280     define variable v-datetime as datetime no-undo .
      281     v-char = cur-time-string().
      282     v-datetime = datetime(v-char).
      283     return  v-datetime.
      284   end.
      285   function cur-time-string-msec returns character
      286   :
      287     define variable v-date as datetime  no-undo .
      288     v-date = now.
      289     return string(v-date) .
      290   end.
      291   define variable vartimeout as integer no-undo.
      292   define stream strlog.
      293   define stream strvip.
      294   define temp-table tt-user no-undo like _UserIO
      295      field TimeLastWork as decimal .
      296   define temp-table tt-vipuser no-undo
      297     field user-name as character
      298     index pi is primary user-name.
      299   define variable vartimework    as int64         no-undo.
      300   define variable varpause       as integer       no-undo.
      301   define variable vardb-name     as character     no-undo.
      302   define variable varprogress    as character     no-undo.
      303   define variable varexefile     as character     no-undo .
      304   define variable varinifile     as character     no-undo .
      305   define variable varcomstring   as character     no-undo.
      306   define variable vartime-string as character     no-undo.
      307   define variable w-monitor      as widget-handle no-undo.
      308   define variable varstr         as character     no-undo.
      309   define frame fr-a
      310   "Время последней проверки:" vartime-string no-label skip
      311   "Выход из программы CTRL-BREAK"
      312   WITH 1 DOWN NO-BOX OVERLAY
      313        SIDE-LABELS THREE-D
      314        AT COL 1 ROW 1
      315        SIZE 37 BY 2.
      316   CREATE WINDOW w-monitor ASSIGN
      317          HIDDEN             = YES
      318          TITLE              = "Монитор работы пользователей"
      319          COLUMN             = 25.25
      320          ROW                = 8.5
      321          HEIGHT             = 2
      322          WIDTH              = 37
      323          MAX-HEIGHT         = 2
      324          MAX-WIDTH          = 37
      325          VIRTUAL-HEIGHT     = 2
      326          VIRTUAL-WIDTH      = 37
      327          RESIZE             = no
      328          SCROLL-BARS        = yes
      329          STATUS-AREA        = no
      330          BGCOLOR            = ?
      331          FGCOLOR            = ?
      332          THREE-D            = yes
      333          MESSAGE-AREA       = no
      334          SENSITIVE          = yes.
      335   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-monitor)
      336   THEN w-monitor:HIDDEN = no.
      337   ASSIGN
      338     CURRENT-WINDOW             = w-monitor
      339     SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO)
      340     session:three-d = yes
      341   .
      342   PAUSE 0 BEFORE-HIDE.
      343   VIEW w-monitor.
      344   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME fr-a:PARENT eq ?
      345   THEN FRAME fr-a:PARENT = ACTIVE-WINDOW.
      346   assign
      347     vartimeout = INTEGER(session:parameter) no-error.
      348   if error-status:error or vartimeout <= 0 then do:
      349     message "Указаны неверные параметры сессии при запуске монитора просмотра работы пользователей mntusrkl.p." skip
      350             "Это должно быть целое число большее нуля (Время работы пользователя без обращения к базе данных в секундах)." skip
      351             "Указаны параметры сессии: "  session:parameter
      352     view-as alert-box error.
      353     output stream strlog to "./mntusrkl.log" append.
      354     put stream strlog unformatted today " " string(time, "hh:mm:ss") " " substitute("Указаны неверные параметры сессии при запуске монитора просмотра работы пользователей mntusrkl.p. Это должно быть целое число большее нуля (Время работы пользователя без обращения к базе данных в секундах). Указаны параметры сессии: &1 ",  session:parameter) skip.
      355     output stream strlog close.
      356     QUIT.
      357   end.
      358   if INDEX(PDBNAME("ub"), "\") > 0 or INDEX(PDBNAME("ub"), "/") > 0 then do:
      359     assign
      360       vardb-name = PDBNAME("ub") + ".db".
      361   end.
      362   else do:
      363     assign
      364       vardb-name = ".\" + PDBNAME("ub") + ".db".
      365   end.
      366   if search (vardb-name) = ? then do:
      367     message "Не найдена база данных " vardb-name "."
      368     view-as alert-box error.
      369     output stream strlog to "./mntusrkl.log" append.
      370     put stream strlog unformatted today " " string(time, "hh:mm:ss") " " substitute("Не найдена база данных &1.", vardb-name ) skip.
      371     output stream strlog close.
      372     QUIT.
      373   end.
      374   if search ("./vipuser.txt") <> ? then do:
      375     input stream strvip from "./vipuser.txt".
      376     repeat :
      377       assign
      378         varstr = "":u.
      379       import stream strvip unformatted varstr.
      380       if varstr <> ? and varstr <> "":u then do:
      381         create tt-vipuser.
      382         assign
      383           tt-vipuser.user-name = varstr.
      384       end.
      385     end.
      386   end.
      387   run main-procedure in this-procedure no-error.
      388   QUIT.
      389   procedure main-procedure:
      390   do
      391   on stop undo, return error
      392   :
      393   define buffer buf_sys-ctrl   for ub.sys-ctrl .
      394   define buffer buf_user-login for ub.user-login .
      395   run gbl/getexini.p
      396       (output varexefile
      397       ,output varinifile
      398       ).
      399   assign
      400     varprogress = replace (varexefile, "prowin32.exe", "proshut.bat").
      401   output stream strlog to "./mntusrkl.log" append.
      402   put stream strlog unformatted today " " string(time, "hh:mm:ss") " Начало работы монитора." skip.
      403   output stream strlog close.
      404   find first tt-vipuser no-error.
      405   if available tt-vipuser then do:
      406     for each tt-vipuser :
      407       output stream strlog to "./mntusrkl.log" append.
      408       put stream strlog unformatted today " " string(time, "hh:mm:ss") substitute("Пользователь &1 объявлен неотключаемым.", tt-vipuser.user-name) skip.
      409       output stream strlog close.
      410     end.
      411   end.
      412   repeat on stop   undo, return error
      413          on error  undo, retry
      414          on endkey undo, retry :
      415   assign
      416     vartime-string = STRING(TIME, "HH:MM:SS").
      417   display vartime-string with frame fr-a.
      418   assign
      419     varTimeWork = etime.
      420   find first buf_sys-ctrl no-lock .
      421   for each _UserIO no-lock
      422   :
      423     find first buf_user-login no-lock
      424       where buf_user-login.db-num     = buf_sys-ctrl.db-num
      425         and buf_user-login.status_    = 0
      426         and buf_user-login.user-login = _UserIO._UserIO-Name
      427       no-error .
      428     if available buf_user-login
      429       and trim(buf_user-login.user-login) <> "":U
      430     then do:
      431       find first tt-vipuser where tt-vipuser.user-name = buf_user-login.user-login no-error.
      432       if not available tt-vipuser then do:
      433         find first tt-user where tt-user._UserIO-ID = _UserIO._UserIO-ID no-error.
      434         if not available tt-user then do:
      435           create tt-user.
      436           buffer-copy _UserIO to tt-user.
      437           assign
      438             tt-user.TimeLastWork = cur-time-mjd().
      439           output stream strlog to "./mntusrkl.log" append.
      440           put stream strlog unformatted today " " string(time, "hh:mm:ss") " " substitute("Пользователь &1 начал работу с базой данных.", _UserIO._UserIO-Name) skip.
      441           output stream strlog close.
      442         end.
      443         else do:
      444           if _UserIO._UserIO-Name <> tt-user._UserIO-Name then do:
      445             output stream strlog to "./mntusrkl.log" append.
      446             put stream strlog unformatted today " " string(time, "hh:mm:ss") " " substitute("Пользователь &1 самостоятельно отключился от базы данных.", tt-user._UserIO-Name) skip.
      447             output stream strlog close.
      448             delete tt-user.
      449             create tt-user.
      450             buffer-copy _UserIO to tt-user.
      451             assign
      452               tt-user.TimeLastWork = cur-time-mjd().
      453             output stream strlog to "./mntusrkl.log" append.
      454             put stream strlog unformatted today " " string(time, "hh:mm:ss") " " substitute("Пользователь &1 начал работу с базой данных.", _UserIO._UserIO-Name) skip.
      455             output stream strlog close.
      456           end.
      457           else do:
      458             if _UserIO._UserIO-DbAccess <> tt-user._UserIO-DbAccess then do:
      459               buffer-copy _UserIO to tt-user.
      460               assign
      461                 tt-user.TimeLastWork = cur-time-mjd().
      462             end.
      463             else do:
      464               if cur-time-mjd() - tt-user.TimeLastWork > vartimeout / 86400 then do:
      465                 find first _Connect where _Connect._Connect-Id = _UserIO._UserIO-ID no-lock no-error.
      466                 if available _Connect then do:
      467                   os-command silent value("net send " + _Connect._Connect-device + " Вы были отключены от базы данных монитором слежения за работой пользователей.").
      468                 end.
      469                 assign
      470                   varcomstring = varprogress + " " + vardb-name + " -C disconnect " + string(_UserIO._UserIO-Usr).
      471                 os-command silent value(varcomstring).
      472                 output stream strlog to "./mntusrkl.log" append.
      473                 put stream strlog unformatted today " " string(time, "hh:mm:ss") " " substitute("Был отключен пользователь &1. Время без обращения к БД &2.", _UserIO._UserIO-Name, cur-time-mjd-to-string( cur-time-mjd() - tt-user.TimeLastWork) ) skip.
      474                 output stream strlog close.
      475                 delete tt-user.
      476               end.
      477             end.
      478           end.
      479         end.
      480       end.
      481     end.
      482   end.
      483   for each tt-user :
      484     find first _UserIO where _UserIO._UserIO-ID = tt-user._UserIO-ID no-lock no-error.
      485     if not available _UserIO or _UserIO._UserIO-Name <> tt-user._UserIO-Name then do:
      486       output stream strlog to "./mntusrkl.log" append.
      487       put stream strlog unformatted today " " string(time, "hh:mm:ss") " " substitute("Пользователь &1 самостоятельно отключился от базы данных.", tt-user._UserIO-Name) skip.
      488       output stream strlog close.
      489       delete tt-user.
      490     end.
      491   end.
      492   assign
      493     varTimeWork = (etime - varTimeWork) / 1000.
      494   if 60 - varTimeWork > 0 then do:
      495     assign
      496       varPause = 60 - varTimeWork.
      497   end.
      498   else do:
      499     assign
      500       varPause = 0.
      501   end.
      502   pause varPause no-message.
      503   end.
      504   end.
      505   end procedure.
