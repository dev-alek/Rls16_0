        1   define input parameter parParentProc   as   handle             no-undo .
        2   define input parameter p-old-artic     like ub.goods.artic     no-undo .
        3   define input parameter p-old-prod-type like ub.goods.prod-type no-undo .
        4   define input parameter p-old-prod-code like ub.goods.prod-code no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Процедура переименования артикула товара".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   procedure progs-name :
      127     define input  parameter p-action-code         as character no-undo .
      128     define output parameter p-main-prog-name      as character no-undo .
      129     define output parameter p-list-db-proc-name   as character no-undo .
      130     define output parameter p-commit-proc-name    as character no-undo .
      131     define output parameter p-execution-proc-name as character no-undo .
      132     define output parameter p-recover-proc-name   as character no-undo .
      133     define output parameter p-after-proc-name     as character no-undo .
      134     do
      135     on error undo, return error
      136     :
      137       case p-action-code :
      138               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
      139               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      140               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      141               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      142               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      143               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      144               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      145               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      146               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      147               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      148               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      149               otherwise do:
      150           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      151         end.
      152       end case.
      153     end.
      154     return.
      155   end procedure.
      156   procedure progs-title :
      157     define input  parameter p-action-code         as character no-undo .
      158     define output parameter p-action-title      as character no-undo .
      159     do
      160     on error undo, return error
      161     :
      162       case p-action-code :
      163               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      164               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      165               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      166               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      167               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      168               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      169               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      170               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      171               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      172               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      173               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      174               otherwise do:
      175           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      176         end.
      177       end case.
      178     end.
      179     return.
      180   end procedure.
      181   FUNCTION progs-title-function returns character(
      182      input  p-action-code         as character):
      183   define variable p-action-title      as character no-undo .
      184     do
      185     on error undo, return error
      186     :
      187       case p-action-code :
      188               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      189               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      190               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      191               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      192               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      193               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      194               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      195               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      196               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      197               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      198               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      199               otherwise do:
      200           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      201         end.
      202       end case.
      203     end.
      204     return p-action-title.
      205   end FUNCTION.
      206   procedure get-row-keyr-string :
      207    define input  parameter p-key-rec  as character no-undo.
      208    define output parameter p-tbl-title as character no-undo.
      209    define output parameter p-rec-string  as character no-undo.
      210     do
      211     on error undo, return error
      212     :
      213       define variable v-full-tbl-name as character no-undo .
      214       define variable bh_tbl-name     as handle    no-undo .
      215       define variable fh              as handle    no-undo .
      216       define variable v-ok            as logical   no-undo .
      217       define variable v-field-num     as integer   no-undo .
      218       define variable v-count-fld     as integer   no-undo .
      219       define variable v-tbl-name as character no-undo.
      220       if p-key-rec = ?
      221         or p-key-rec = "":U
      222       then do:
      223         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      224       end.
      225       assign
      226         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      227         v-full-tbl-name = "ub.":U + v-tbl-name
      228         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      229         p-rec-string         = "":U
      230         v-count-fld     = 0
      231       .
      232       find ub._file
      233         where ub._file._file-name = v-tbl-name
      234         no-error.
      235       if not available ub._file then do:
      236         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info0, v-tbl-name ).
      237       end.
      238       assign
      239       p-tbl-title = ub._file._file-label
      240       .
      241       find ub._index
      242         where recid( ub._index  ) = ub._file._prime-index
      243         no-error.
      244       if not available ub._index
      245         or LC( ub._index._index-name ) = "default":U
      246       then do:
      247         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      248       end.
      249       block_where :
      250       for each ub._index-field of ub._index  ,
      251           each ub._field of _index-field
      252           break by _index-seq
      253       on error undo, return error
      254       :
      255         assign
      256           v-count-fld = v-count-fld + 1
      257         .
      258         if v-count-fld > v-field-num then do:
      259           leave block_where.
      260         end.
      261         if p-rec-string = "":U then do:
      262           assign
      263             p-rec-string = "":U
      264           .
      265         end.
      266         else do:
      267           assign
      268             p-rec-string = p-rec-string + chr(32) + chr(44)
      269           .
      270         end.
      271         assign
      272           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      273         .
      274       end.
      275       if v-count-fld <> v-field-num then do:
      276         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      277       end.
      278     end.
      279     return.
      280   end procedure.
      281   FUNCTION uniq-key-rec-string-f returns character(
      282      input  p-uniq-key-rec         as character):
      283   define variable v-tbl-title as character no-undo .
      284   define variable v-rec-string as character no-undo .
      285     do
      286     on error undo, return error
      287     :
      288       run get-row-keyr-string in this-procedure (
      289                                                 input p-uniq-key-rec
      290                                                 ,output v-tbl-title
      291                                                 ,output v-rec-string).
      292       assign
      293       v-rec-string = (if v-tbl-title <> ? and
      294                       v-tbl-title <> "":U
      295                       then (v-tbl-title + ":")
      296                      else "":U) + chr(32) + v-rec-string
      297       .
      298     end.
      299     return v-rec-string.
      300   end FUNCTION.
      301   procedure create_db-rec_route :
      302     define input parameter p1-uniq-key-rec as character no-undo .
      303     define input parameter p1-action       as character no-undo .
      304     define input parameter p1-operation    as character no-undo .
      305     define input parameter p1-send-db-list as character no-undo .
      306     define input parameter p1-db-init      as integer   no-undo .
      307     define input parameter p1-parameters   as character no-undo .
      308     define input parameter p1-answer-code  as integer   no-undo .
      309     define input parameter p1-answer-msg   as character no-undo .
      310     do
      311     on error undo, return error
      312     :
      313       define variable v-command     as character no-undo .
      314       define variable v-ind         as integer   no-undo .
      315       define variable v-num-entries as integer   no-undo .
      316       define variable v-curr-db     as integer   no-undo .
      317       define variable v-db-for-send as character no-undo .
      318       define variable v-db-num      as integer   no-undo .
      319       define variable v-db-num-char as character no-undo .
      320       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      321       find first buf_sys-ctrl no-lock .
      322       assign
      323         v-curr-db     = buf_sys-ctrl.db-num
      324         v-db-for-send = "":U
      325       .
      326       if v-curr-db = 0 then do:
      327         if p1-answer-code >= 0 then do:
      328           if v-curr-db <> p1-db-init then do:
      329             assign
      330               v-db-for-send = string( p1-db-init )
      331             .
      332           end.
      333         end.
      334         else do:
      335           assign
      336             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      337           .
      338           do v-ind = 1 to v-num-entries:
      339             assign
      340               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      341               v-db-num      = integer( v-db-num-char )
      342             .
      343             if v-db-num <> v-curr-db
      344               and v-db-num <> p1-db-init
      345             then do:
      346               if v-db-for-send = "":U then do:
      347                 assign
      348                   v-db-for-send = v-db-num-char
      349                 .
      350               end.
      351               else do:
      352                 assign
      353                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      354                 .
      355               end.
      356             end.
      357           end.
      358         end.
      359       end.
      360       else do:
      361         assign
      362           v-db-for-send = "0":U
      363         .
      364       end.
      365       if v-db-for-send <> "":U then do:
      366         assign
      367           v-command = "command":U + chr(1)
      368                       + "two-commit":U + chr(1)
      369                       + p1-action + chr(1)
      370                       + p1-operation + chr(1)
      371                       + p1-uniq-key-rec + chr(1)
      372                       + string( p1-db-init ) + chr(1)
      373                       + p1-parameters + chr(1)
      374                       + string( p1-answer-code ) + chr(1)
      375                       + p1-answer-msg
      376         .
      377         run nws/cr-route.p ( input 'send-cmd':U
      378                       ,input v-command
      379                       ,input ?
      380                       ,input v-db-for-send
      381                       ) no-error .
      382         if error-status :error then do:
      383           return error return-value.
      384         end.
      385       end.
      386     end.
      387     return.
      388   end procedure.
      389   procedure create_msg_route :
      390     define input parameter p2-send-db-list as character no-undo .
      391     define input parameter p2-msg          as character no-undo .
      392     do
      393     on error undo, return error
      394     :
      395       define variable v-msg-command as character no-undo .
      396       define variable v-ind         as integer   no-undo .
      397       define variable v-num-entries as integer   no-undo .
      398       define variable v-curr-db     as integer   no-undo .
      399       define variable v-db-for-send as character no-undo .
      400       define variable v-db-num      as integer   no-undo .
      401       define variable v-db-num-char as character no-undo .
      402       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      403       find first buf_sys-ctrl no-lock .
      404       assign
      405         v-curr-db     = buf_sys-ctrl.db-num
      406         v-db-for-send = "":U
      407       .
      408       if v-curr-db = 0 then do:
      409         assign
      410           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      411         .
      412         do v-ind = 1 to v-num-entries:
      413           assign
      414             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      415             v-db-num      = integer( v-db-num-char )
      416           .
      417           if v-db-num <> v-curr-db then do:
      418             if v-db-for-send = "":U then do:
      419               assign
      420                 v-db-for-send = v-db-num-char
      421               .
      422             end.
      423             else do:
      424               assign
      425                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      426               .
      427             end.
      428           end.
      429         end.
      430       end.
      431       else do:
      432         assign
      433           v-db-for-send = "0":U
      434         .
      435       end.
      436       if v-db-for-send <> "":U then do:
      437         assign
      438           v-msg-command = "command":U + chr(1)
      439                           + "message-to-log":U + chr(1)
      440                           + p2-msg
      441         .
      442         run nws/cr-route.p ( input 'send-cmd':U
      443                       ,input v-msg-command
      444                       ,input ?
      445                       ,input v-db-for-send
      446                       ) no-error .
      447         if error-status :error then do:
      448           return error substitute( "&1&2&3"
      449                                     , return-value
      450                                     , chr(10)
      451                                     , error-status :get-message(1)
      452                                   ).
      453         end.
      454       end.
      455     end.
      456     return.
      457   end procedure.
      458   function get-send-db-list returns character
      459     ( input p-curr-db     as integer
      460      ,input p-all-db-list as character
      461     )
      462   :
      463     define variable v-send-db-list as character no-undo .
      464     if p-curr-db = 0 then do:
      465       assign
      466         v-send-db-list = p-all-db-list
      467       .
      468     end.
      469     else do:
      470       assign
      471         v-send-db-list = string(p-curr-db)
      472       .
      473     end.
      474     return v-send-db-list .
      475   end function .
      476   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   procedure gen-key-rec :
      478     define input  parameter p-tbl-name    as character no-undo.
      479     define input  parameter p-bh_tbl-name as handle    no-undo.
      480     define output parameter p-key-rec     as character no-undo.
      481     do
      482     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      483     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      484     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      485     :
      486       define variable fh               as handle    no-undo .
      487       define variable v-ok             as logical   no-undo .
      488       define variable v-inform         as character no-undo .
      489       define variable v-ind            as integer   no-undo .
      490       define variable v-idx-field-qnty as integer   no-undo .
      491       if p-tbl-name = ?
      492         or p-tbl-name = "":U
      493       then do:
      494         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      495       end.
      496       if not p-bh_tbl-name:available then do:
      497         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      498       end.
      499       assign
      500         p-key-rec = p-tbl-name
      501         v-inform  = p-bh_tbl-name:index-information(1)
      502         v-ind     = 2
      503       .
      504       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      505       on error undo, return error
      506       :
      507         assign
      508           v-inform = p-bh_tbl-name:index-information( v-ind )
      509           v-ind    = v-ind + 1
      510         .
      511       end.
      512       if v-inform = ?
      513         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      514         or entry( 3, v-inform, ",":U ) <> "1":U
      515       then do:
      516         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      517       end.
      518       else do:
      519         assign
      520           v-idx-field-qnty = num-entries( v-inform ) - 4
      521         .
      522         if v-idx-field-qnty < 2 then do:
      523           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      524         end.
      525         do v-ind = 1 to v-idx-field-qnty by 2
      526         on error undo, return error
      527         :
      528           assign
      529             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      530             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      531           .
      532         end.
      533       end.
      534       if p-key-rec = ? then do:
      535         assign
      536           p-key-rec = "":U
      537         .
      538         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      539       end.
      540     end.
      541     return.
      542   end procedure.
      543   procedure gen-where-keyr-tab :
      544     define input  parameter i-tableSerach as character no-undo.
      545     define input  parameter i-tablekey   as character  no-undo.
      546     define input  parameter p-key-rec    as character  no-undo.
      547     define input  parameter p-key-handle as handle     no-undo .
      548     define input  parameter p-db-name    as character  no-undo .
      549     define input  parameter p-tt-handle  as handle     no-undo .
      550     define output parameter o-Where      as character  no-undo.
      551     do
      552     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      553     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      554     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      555     :
      556       define variable v-full-tbl-name  as character no-undo .
      557       define variable bh_tbl-name      as handle    no-undo .
      558       define variable fh_key           as handle    no-undo .
      559       define variable fh_search        as handle    no-undo .
      560       define variable v-field-num      as integer   no-undo .
      561       define variable v-count-fld      as integer   no-undo .
      562       define variable v-inform         as character no-undo .
      563       define variable v-ind            as integer   no-undo .
      564       define variable v-idx-field-qnty as integer   no-undo .
      565       define variable v-field-name     as character no-undo .
      566       define variable v-field-val      as character no-undo .
      567       define variable v-word-link      as character no-undo .
      568       define variable vTable           as character no-undo.
      569       define variable bh_tbl-key       as handle    no-undo .
      570       assign
      571         p-key-rec = trim( p-key-rec )
      572       .
      573       if p-key-handle <> ? then do:
      574         if not valid-handle(p-key-handle)
      575            or p-key-handle:type <> "buffer"
      576         then do:
      577           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      578         end.
      579         if num-entries( p-key-rec, chr(3) ) > 1
      580           or p-key-rec = ?
      581           or p-key-rec = "":U
      582         then do:
      583           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      584         end.
      585       end.
      586       else do:
      587         if p-key-rec = ?
      588           or p-key-rec = "":U
      589         then do:
      590           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      591         end.
      592       end.
      593       assign
      594         vTable = entry( 1 , p-key-rec, chr(3) )
      595       .
      596       if p-tt-handle <> ?
      597         and ( not valid-handle(p-tt-handle)
      598               or p-tt-handle:type <> "buffer"
      599             )
      600       then do:
      601         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      602       end.
      603       if p-tt-handle = ? then do:
      604         assign
      605           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      606         .
      607         create buffer bh_tbl-name for table v-full-tbl-name .
      608       end.
      609       else do:
      610         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      611       end.
      612       assign
      613         v-inform = bh_tbl-name:index-information(1)
      614         v-ind    = 2
      615       .
      616       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      617       on error undo, return error
      618       :
      619         assign
      620           v-inform = bh_tbl-name:index-information( v-ind )
      621           v-ind    = v-ind + 1
      622         .
      623       end.
      624       if v-inform = ?
      625         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      626         or entry( 3, v-inform, ",":U ) <> "1":U
      627       then do:
      628         delete object bh_tbl-name no-error.
      629         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      630       end.
      631       assign
      632         v-idx-field-qnty = num-entries( v-inform ) - 4
      633       .
      634       if v-idx-field-qnty < 2 then do:
      635         delete object bh_tbl-name no-error.
      636         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      637       end.
      638       assign
      639         o-where     = "where":U
      640         v-word-link = "":U
      641         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      642         v-count-fld = 0
      643       .
      644       if i-tablekey ne "" and i-tablekey ne ?
      645       then do:
      646         assign
      647           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      648         .
      649         create buffer bh_tbl-key for table v-full-tbl-name .
      650       end.
      651       if i-tableSerach ne "" and i-tableSerach ne ?
      652       then do:
      653         delete object bh_tbl-name no-error.
      654         assign
      655           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      656         .
      657         create buffer bh_tbl-name for table v-full-tbl-name .
      658       end.
      659       block_where:
      660       do v-ind = 1 to v-idx-field-qnty by 2
      661       on error undo, return error
      662       :
      663         assign
      664           v-count-fld = v-count-fld + 1
      665         .
      666         if p-key-handle = ?
      667           and v-count-fld > v-field-num
      668         then do:
      669           leave block_where.
      670         end.
      671         define variable VfieldKeyTable as handle no-undo.
      672         assign
      673           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      674           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      675         .
      676         if     bh_tbl-key ne ?
      677         then do:
      678            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      679            if VfieldKeyTable eq ?
      680            then next block_where.
      681         end.
      682         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      683         then
      684            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      685         else
      686            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      687         if p-key-handle = ? then do:
      688           assign
      689             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      690           .
      691         end.
      692         else do:
      693           assign
      694             fh_key = p-key-handle:buffer-field( v-field-name )
      695           .
      696           if fh_key = ?
      697             or not valid-handle( fh_key )
      698           then do:
      699             delete object bh_tbl-name.
      700             if     bh_tbl-key ne ?
      701             then
      702                delete object bh_tbl-key.
      703             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      704           end.
      705           assign
      706             v-field-val = fh_key:buffer-value
      707           .
      708         end.
      709         if fh_search:data-type ="character":U then do:
      710           assign
      711             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      712             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      713             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      714             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      715             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      716             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      717             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      718             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      719             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      720             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      721             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      722             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      723             v-field-val = substitute( '"&1"', v-field-val )
      724           .
      725         end.
      726         assign
      727           o-where = substitute( "&1 &2", o-where, v-field-val )
      728         .
      729         if v-word-link = "":U then do:
      730           assign
      731             v-word-link = "and":U
      732           .
      733         end.
      734       end.
      735       delete object bh_tbl-name.
      736       if     bh_tbl-key ne ?
      737       then
      738          delete object bh_tbl-key.
      739       if p-key-handle = ?
      740         and v-count-fld <> v-field-num
      741       then do:
      742         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      743       end.
      744     end.
      745   end procedure.
      746   procedure gen-hn-keyr-tab :
      747     define input  parameter i-tableSerach as character no-undo.
      748     define input  parameter i-tablekey   as character no-undo.
      749     define input  parameter p-key-rec    as character no-undo.
      750     define input  parameter p-key-handle as handle    no-undo .
      751     define input  parameter p-db-name    as character no-undo .
      752     define input  parameter p-tt-handle  as handle    no-undo .
      753     define input  parameter p-stts-lock  as integer   no-undo .
      754     define output parameter o-hn         as handle    no-undo.
      755     define variable v-full-tbl-name as character no-undo.
      756     define variable v-where         as character no-undo.
      757     define variable bh_tbl-name     as handle    no-undo.
      758     define variable vTable          as character no-undo.
      759     do
      760     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      761     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      762     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      763         run gen-where-keyr-tab(i-tableSerach,
      764                                i-tablekey,
      765                                p-key-rec,
      766                                p-key-handle,
      767                                p-db-name,
      768                                p-tt-handle,
      769                                output v-where).
      770         if i-tableSerach ne "" and i-tableSerach ne ?
      771         then do:
      772            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      773            create buffer bh_tbl-name for table v-full-tbl-name .
      774         end.
      775         else do:
      776            if p-tt-handle = ? then do:
      777               assign
      778                  vTable = entry( 1 , p-key-rec, chr(3) )
      779               .
      780               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      781               create buffer bh_tbl-name for table v-full-tbl-name .
      782            end.
      783            else do:
      784               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      785            end.
      786         end.
      787         if p-tt-handle = ? then do:
      788            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      789         end.
      790         else do:
      791            bh_tbl-name:find-first( v-where ) no-error .
      792         end.
      793         o-hn = bh_tbl-name.
      794      end.
      795   end procedure.
      796   procedure gen-hn-keyr :
      797     define input  parameter p-key-rec    as character no-undo.
      798     define input  parameter p-key-handle as handle    no-undo .
      799     define input  parameter p-db-name    as character no-undo .
      800     define input  parameter p-tt-handle  as handle    no-undo .
      801     define input  parameter p-stts-lock  as integer   no-undo .
      802     define output parameter o-hn         as handle    no-undo.
      803     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      804   end.
      805   procedure gen-row-keyr :
      806     define input  parameter p-key-rec    as character no-undo.
      807     define input  parameter p-key-handle as handle    no-undo .
      808     define input  parameter p-db-name    as character no-undo .
      809     define input  parameter p-tt-handle  as handle    no-undo .
      810     define input  parameter p-stts-lock  as integer   no-undo .
      811     define output parameter p-tbl-row    as rowid     no-undo.
      812     define output parameter p-tbl-name   as character no-undo.
      813     define variable vHn as handle no-undo.
      814       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      815       p-tbl-row = if vHn:available then vHn:rowid else ?.
      816       p-tbl-name =  vHn:table.
      817       delete object vHn no-error.
      818     if p-tbl-row = ? then do:
      819       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      820     end.
      821     else do:
      822       return.
      823     end.
      824   end procedure.
      825   procedure gen-key-fv :
      826     define input  parameter p-key-rec    as character no-undo .
      827     define output parameter p-field-list as character no-undo .
      828     define output parameter p-value-list as character no-undo.
      829     do
      830     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      831     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      832     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      833     :
      834       define variable v-full-tbl-name  as character no-undo .
      835       define variable bh_tbl-name      as handle    no-undo .
      836       define variable v-tbl-name       as character no-undo .
      837       define variable v-field-num      as integer   no-undo .
      838       define variable v-count-fld      as integer   no-undo .
      839       define variable v-inform         as character no-undo .
      840       define variable v-ind            as integer   no-undo .
      841       define variable v-idx-field-qnty as integer   no-undo .
      842       define variable v-delim-key      as character no-undo .
      843       if p-key-rec = ?
      844         or p-key-rec = "":U
      845       then do:
      846         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      847       end.
      848       assign
      849         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      850         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      851       .
      852       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      853       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      854       assign
      855         v-inform = bh_tbl-name:index-information(1)
      856         v-ind    = 2
      857       .
      858       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      859       on error undo, return error
      860       :
      861         assign
      862           v-inform = bh_tbl-name:index-information( v-ind )
      863           v-ind    = v-ind + 1
      864         .
      865       end.
      866       if v-inform = ?
      867         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      868         or entry( 3, v-inform, ",":U ) <> "1":U
      869       then do:
      870         delete object bh_tbl-name no-error.
      871         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      872       end.
      873       assign
      874         v-idx-field-qnty = num-entries( v-inform ) - 4
      875       .
      876       if v-idx-field-qnty < 2 then do:
      877         delete object bh_tbl-name no-error.
      878         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      879       end.
      880       assign
      881         p-field-list = "":U
      882         p-value-list = "":U
      883         v-delim-key  = "":U
      884         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      885         v-count-fld  = 0
      886       .
      887       block_where:
      888       do v-ind = 1 to v-idx-field-qnty by 2
      889       on error undo, return error
      890       :
      891         assign
      892           v-count-fld = v-count-fld + 1
      893         .
      894         if v-count-fld > v-field-num then do:
      895           leave block_where.
      896         end.
      897         assign
      898           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      899           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      900         .
      901         if v-ind = 1 then do:
      902           assign
      903             v-delim-key = chr(3)
      904           .
      905         end.
      906       end.
      907       delete object bh_tbl-name.
      908       if v-count-fld <> v-field-num then do:
      909         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      910       end.
      911     end.
      912   end procedure.
      913   procedure gen-key-field :
      914     define input  parameter p-table      as character no-undo .
      915     define output parameter p-field-list as character no-undo .
      916     do
      917     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      918     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      919     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      920     :
      921       define variable v-full-tbl-name  as character no-undo .
      922       define variable bh_tbl-name      as handle    no-undo .
      923       define variable v-tbl-name       as character no-undo .
      924       define variable v-field-num      as integer   no-undo .
      925       define variable v-count-fld      as integer   no-undo .
      926       define variable v-inform         as character no-undo .
      927       define variable v-ind            as integer   no-undo .
      928       define variable v-idx-field-qnty as integer   no-undo .
      929       define variable v-delim-key      as character no-undo .
      930       if p-table = ?
      931         or p-table = "":U
      932       then do:
      933         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      934       end.
      935       assign
      936         v-tbl-name      = p-table
      937         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      938       .
      939       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      940       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      941       assign
      942         v-inform = bh_tbl-name:index-information(1)
      943         v-ind    = 2
      944       .
      945       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      946       on error undo, return error
      947       :
      948         assign
      949           v-inform = bh_tbl-name:index-information( v-ind )
      950           v-ind    = v-ind + 1
      951         .
      952       end.
      953       if v-inform = ?
      954         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      955         or entry( 3, v-inform, ",":U ) <> "1":U
      956       then do:
      957         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      958       end.
      959       assign
      960         v-idx-field-qnty = num-entries( v-inform ) - 4
      961       .
      962       if v-idx-field-qnty < 2 then do:
      963         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      964       end.
      965       assign
      966         p-field-list = "":U
      967         v-delim-key  = "":U
      968         v-count-fld  = 0
      969       .
      970       block_where:
      971       do v-ind = 1 to v-idx-field-qnty by 2
      972       on error undo, return error
      973       :
      974         assign
      975           v-count-fld = v-count-fld + 1
      976         .
      977         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      978         if v-ind = 1 then do:
      979           assign
      980             v-delim-key = chr(3)
      981           .
      982         end.
      983       end.
      984       delete object bh_tbl-name.
      985     end.
      986   end procedure.
      987   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988   define variable v-waitfram-action01         as character   no-undo .
      989   define variable v-waitfram-action02         as character   no-undo .
      990   define variable v-waitfram-action03         as character   no-undo .
      991   define variable mWaitFramTextBeg            as character   no-undo.
      992   define variable mWaitFramTextEnd            as character   no-undo.
      993   define variable mWaitFramView               as logical     no-undo.
      994   define variable mWaitProcEvent              as logical     no-undo init yes.
      995   define variable mWaitFramInterval           as integer     no-undo init 1 .
      996   define variable mWaitFramStop               as logical     no-undo.
      997   define variable mWaitFramStopUser           as logical     no-undo.
      998   define variable mWaitFramStopTimeOut        as logical     no-undo.
      999   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1000   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1001   define button B-WaitFramStop auto-end-key
     1002        label "Стоп"
     1003        size 10 by 1 tooltip "Остоновить процесс".
     1004   define button B-viewProcInfo
     1005        label "Информация"
     1006        size 15 by 1 tooltip "Информация о процесс".
     1007   define frame waitfram
     1008     v-waitfram-action01 format "x(72)" no-label skip
     1009     v-waitfram-action02 format "x(72)" no-label skip
     1010     v-waitfram-action03 format "x(72)" no-label skip
     1011     B-viewProcInfo
     1012     B-WaitFramStop at row 4 col 30
     1013     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1014     .
     1015   define new global shared variable mBatchMode as logical no-undo init ?.
     1016   define variable mFramBachModHandle as handle no-undo.
     1017   mFramBachModHandle = frame waitfram:handle.
     1018   define variable mFameOldVis as logical no-undo.
     1019   define variable mVisCUrentVin as logical no-undo.
     1020   if session:batch-mode
     1021   then
     1022      mBatchMode = yes.
     1023   if mBatchMode = ? then do:
     1024     mVisCUrentVin = current-window:visible.
     1025     mFameOldVis = mFramBachModHandle:visible.
     1026     mFramBachModHandle:visible  = yes.
     1027     mBatchMode = mFramBachModHandle:visible ne yes.
     1028     mFramBachModHandle:visible = mFameOldVis.
     1029     current-window:visible = mVisCUrentVin.
     1030   end.
     1031    if  log-manager:logfile-name ne ?
     1032     then DO:
     1033         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1034         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1035         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1036     end.
     1037   on choose of B-WaitFramStop in frame waitfram
     1038   do:
     1039     mWaitFramStop = yes.
     1040     mWaitFramStopUser = yes.
     1041   end.
     1042   function waitfram-check-timeout returns logical():
     1043      define variable vtime as int64 no-undo.
     1044      if mWaitFramStopTimeOut
     1045      then
     1046         return yes.
     1047      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1048      if     mWaitFramTimeOut ne ?
     1049         and mWaitFramTimeOut ne 0
     1050         and mWaitFramTimeOut lt vtime
     1051      then do:
     1052         mWaitFramStopTimeOut = yes.
     1053      end.
     1054      return mWaitFramStopTimeOut.
     1055   end.
     1056   procedure waitfram-hide :
     1057     if not session:batch-mode
     1058     then do
     1059     on error undo, return error return-value
     1060     :
     1061       pause 0 before-hide .
     1062       if not mBatchMode then
     1063         hide frame waitfram .
     1064     if     not mWaitFramView
     1065        and mWaitProcEvent
     1066     then
     1067       process events .
     1068     end.
     1069   end procedure.
     1070   procedure waitfram-show :
     1071     define input  parameter p-message as character no-undo .
     1072     define variable v-left-margin as integer   no-undo .
     1073     if not session:batch-mode
     1074     then do
     1075     on error undo, return error return-value
     1076     :
     1077       if length(p-message) <= 70 then do:
     1078         assign
     1079           v-left-margin = integer((70 - length(p-message)) / 2)
     1080         .
     1081         assign
     1082           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1083         .
     1084         assign
     1085           v-waitfram-action01 = " "
     1086           v-waitfram-action02 = " "
     1087                                    + fill(" ", v-left-margin)
     1088                                    + p-message
     1089           v-waitfram-action03 = " "
     1090         .
     1091       end.
     1092       else do:
     1093         define variable vRindex1 as integer no-undo.
     1094         define variable vRindex2 as integer no-undo.
     1095         vRindex1 = r-index(p-message," ",70).
     1096         if vRindex1 = 0
     1097         then
     1098            vRindex1 = 70.
     1099         if length(p-message)  <= vRindex1 + 70 then do:
     1100           assign
     1101             v-waitfram-action01 = " "
     1102             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1103             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1104           .
     1105         end.
     1106         else do:
     1107           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1108           if vRindex2 <= vRindex1
     1109           then
     1110              vRindex2 = vRindex1 + 70.
     1111           assign
     1112             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1113             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1114             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1115           .
     1116         end.
     1117       end.
     1118       B-viewProcInfo:visible   in frame waitfram = no.
     1119       B-viewProcInfo:sensitive in frame waitfram = no.
     1120       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1121       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1122       if  (   mWaitFramView
     1123          or  mWaitProcEvent)
     1124          and not mBatchMode
     1125       then
     1126          display
     1127             v-waitfram-action01 skip
     1128             v-waitfram-action02 skip
     1129             v-waitfram-action03 skip
     1130          with frame waitfram .
     1131       if     mWaitFramView
     1132          then do:
     1133             if     mWaitFramInterval ne ?
     1134                and not mBatchMode
     1135             then
     1136                wait-for go of frame waitfram pause mWaitFramInterval.
     1137          end.
     1138          else
     1139             if     mWaitProcEvent
     1140                and not mBatchMode
     1141             then
     1142                process events .
     1143     end.
     1144   end procedure.
     1145      procedure waitfram-show-this:
     1146         define input  parameter iInterval as int64 no-undo.
     1147         define variable vtime as int64 no-undo.
     1148         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1149         mWaitFramInterval = iInterval.
     1150         run waitfram-show (substitute("&1&2 &3&4" ,
     1151                                       mWaitFramTextBeg ,
     1152                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1153                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1154                                       mWaitFramTextEnd
     1155                                      )
     1156                           ).
     1157      end.
     1158      procedure WaitFramRunPause:
     1159         define input  parameter iInterval as dec no-undo.
     1160         define variable vStart  as datetime-tz no-undo.
     1161         define variable vend    as datetime-tz no-undo.
     1162         define variable vint as int64 no-undo.
     1163         define variable vOk as logical no-undo.
     1164         vStart = now.
     1165         vend   = vStart.
     1166         publish "WaitFramPause" (iInterval,output vOk).
     1167         vend   =  now.
     1168         vint = vend - vStart.
     1169         vint = iInterval - vint / 1000.
     1170         if     not mWaitFramStop
     1171            and (   vint > 0
     1172                 or (    not vOk
     1173                     and iInterval eq ?
     1174                     )
     1175                 )
     1176         then
     1177            run waitfram-show-this (iInterval).
     1178         vend   =  now.
     1179         vint = vend - vStart.
     1180         vint = iInterval - vint / 1000.
     1181         if     not mWaitFramStop
     1182            and vint > 0
     1183         then do:
     1184            run gbl/pause.p (vint * 1000).
     1185         end.
     1186         if iInterval ne ?
     1187         then
     1188            publish "WaitFramStop".
     1189         waitfram-check-timeout().
     1190      end.
     1191      procedure WaitFramWaitFor:
     1192         define input  parameter iInterval as dec no-undo.
     1193         assign
     1194            mWaitFramStartProc   = now
     1195            mWaitFramStopUser    = no
     1196            mWaitFramStopTimeOut = no
     1197         .
     1198         block-wait:
     1199         do while not mWaitFramStop:
     1200            run WaitFramRunPause (iInterval).
     1201            if  waitfram-check-timeout()
     1202            then do:
     1203               leave block-wait.
     1204            end.
     1205         end.
     1206         run waitfram-hide.
     1207      end.
     1208   procedure waitfram-join :
     1209     define input  parameter p-line-1  as character no-undo .
     1210     define input  parameter p-line-2  as character no-undo .
     1211     define input  parameter p-line-3  as character no-undo .
     1212     define output parameter p-message as character no-undo .
     1213     do
     1214     on error undo, return error return-value
     1215     :
     1216       assign
     1217         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1218                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1219                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1220       .
     1221     end.
     1222   end procedure.
     1223   function waitfram-join-function returns character
     1224     (input p-line-1 as character
     1225     ,input p-line-2 as character
     1226     ,input p-line-3 as character
     1227     ).
     1228     define variable v-message as character no-undo .
     1229     run waitfram-join in this-procedure
     1230       (input  p-line-1
     1231       ,input  p-line-2
     1232       ,input  p-line-3
     1233       ,output v-message
     1234       ) .
     1235     return v-message .
     1236   end function .
     1237   define stream log .
     1238   define temp-table temp-goods no-undo
     1239     field artic     like ub.goods.artic
     1240     field prod-type like ub.goods.prod-type
     1241     field prod-code like ub.goods.prod-code
     1242     field new-artic like ub.goods.artic label "Новый артикул" column-label "Новый артикул"
     1243     field gds-code  like ub.goods.gds-code
     1244     index xpk is primary artic prod-type prod-code
     1245   .
     1246   define variable rid-list as character no-undo.
     1247   def buffer new-clients for ub.clients.
     1248   define variable v-key-rec      as character no-undo .
     1249   define variable v-param        as character no-undo .
     1250   define variable v-not-two-commit as logical no-undo .
     1251   DEFINE BUTTON b-help
     1252        LABEL "Помо&щь"
     1253        SIZE 10 BY 1.
     1254   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1255        LABEL "Выход "
     1256        SIZE 10 BY 1
     1257        BGCOLOR 8 .
     1258   DEFINE BUTTON Btn_OK
     1259        LABEL "Переименовать"
     1260        SIZE 20 BY 1
     1261        BGCOLOR 8 .
     1262   DEFINE BUTTON Btn_RenameAll
     1263        LABEL "Все Автоматически"
     1264        SIZE 20 BY 1
     1265        BGCOLOR 8 .
     1266   DEFINE BUTTON sel-gds
     1267        IMAGE-UP FILE "btn-down-arrow":U
     1268        IMAGE-DOWN FILE "btn-down-arrow":U
     1269        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1270        LABEL "Button 1"
     1271        SIZE 2.63 BY 1.
     1272   DEFINE BUTTON sel-new-prod
     1273        IMAGE-UP FILE "btn-down-arrow":U
     1274        IMAGE-DOWN FILE "btn-down-arrow":U
     1275        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1276        LABEL ""
     1277        SIZE 2.5 BY .96.
     1278   DEFINE VARIABLE new-artic AS CHARACTER FORMAT "X(16)"
     1279        LABEL "Новый Артикул"
     1280        VIEW-AS FILL-IN
     1281        SIZE 14 BY 1 NO-UNDO.
     1282   DEFINE VARIABLE new-clobjname AS CHARACTER FORMAT "X(256)":U
     1283        VIEW-AS FILL-IN
     1284        SIZE 43 BY 1 NO-UNDO.
     1285   DEFINE VARIABLE new-prod-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1286        LABEL "Новый производитель"
     1287        VIEW-AS FILL-IN
     1288        SIZE 10 BY 1 NO-UNDO.
     1289   DEFINE VARIABLE new-prod-type AS CHARACTER FORMAT "X(3)":U
     1290        VIEW-AS FILL-IN
     1291        SIZE 4.5 BY 1 NO-UNDO.
     1292   DEFINE VARIABLE old-artic AS CHARACTER FORMAT "X(16)"
     1293        LABEL "Артикул"
     1294        VIEW-AS FILL-IN
     1295        SIZE 14 BY 1 NO-UNDO.
     1296   DEFINE VARIABLE old-clobjname AS CHARACTER FORMAT "X(40)"
     1297        VIEW-AS FILL-IN
     1298        SIZE 43 BY 1 NO-UNDO.
     1299   DEFINE VARIABLE old-prod-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL 0
     1300        LABEL "Производитель"
     1301        VIEW-AS FILL-IN
     1302        SIZE 10 BY 1 NO-UNDO.
     1303   DEFINE VARIABLE old-prod-type AS CHARACTER FORMAT "X(3)"
     1304        VIEW-AS FILL-IN
     1305        SIZE 4.25 BY 1 NO-UNDO.
     1306   DEFINE VARIABLE v-gds-name LIKE ub.goods.gds-name
     1307        VIEW-AS FILL-IN
     1308        SIZE 43 BY 1 NO-UNDO.
     1309   DEFINE QUERY Dialog-Frame FOR
     1310         ub.clients SCROLLING.
     1311   DEFINE FRAME Dialog-Frame
     1312        Btn_Cancel AT ROW 1 COL 1
     1313        Btn_OK AT ROW 1 COL 11
     1314        Btn_RenameAll AT ROW 1 COL 31
     1315        b-help AT ROW 1 COL 51
     1316        old-artic AT ROW 2.5 COL 22 COLON-ALIGNED
     1317        v-gds-name AT ROW 2.5 COL 41 COLON-ALIGNED NO-LABEL
     1318        old-prod-code AT ROW 3.67 COL 22 COLON-ALIGNED
     1319        old-prod-type AT ROW 3.67 COL 32.25 COLON-ALIGNED NO-LABEL
     1320        old-clobjname AT ROW 3.67 COL 41 COLON-ALIGNED HELP
     1321             "Укажите название объекта учета товаров" NO-LABEL
     1322        sel-gds AT ROW 3.75 COL 39.63
     1323        new-artic AT ROW 4.83 COL 22 COLON-ALIGNED
     1324        new-prod-code AT ROW 6.04 COL 22 COLON-ALIGNED
     1325        new-prod-type AT ROW 6.04 COL 32.25 COLON-ALIGNED NO-LABEL
     1326        new-clobjname AT ROW 6.04 COL 41 COLON-ALIGNED NO-LABEL
     1327        sel-new-prod AT ROW 6.08 COL 39.63
     1328        SPACE(45.36) SKIP(0.53)
     1329       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1330            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1331            TITLE "Изменение артикула"
     1332            DEFAULT-BUTTON Btn_Cancel CANCEL-BUTTON Btn_Cancel.
     1333   ASSIGN
     1334          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1335          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1336   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1337   DO:
     1338     APPLY "END-ERROR":U TO SELF.
     1339   END.
     1340   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     1341   DO:
     1342   END.
     1343   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1344   DO:
     1345     assign
     1346       old-artic
     1347       old-prod-type
     1348       old-prod-code
     1349       new-artic
     1350       new-prod-type
     1351       new-prod-code
     1352     .
     1353     run validate-prod in this-procedure
     1354       ( input new-prod-type
     1355        ,input new-prod-code
     1356       ) no-error.
     1357     if error-status :error then do:
     1358       apply "entry" to new-prod-code in frame Dialog-Frame.
     1359       return no-apply.
     1360     end.
     1361     run rename-artic in this-procedure
     1362       ( input old-artic
     1363        ,input old-prod-type
     1364        ,input old-prod-code
     1365        ,input new-artic
     1366        ,input new-prod-type
     1367        ,input new-prod-code
     1368       ) no-error .
     1369     if error-status :error then do:
     1370       return no-apply .
     1371     end.
     1372   END.
     1373   ON CHOOSE OF Btn_RenameAll IN FRAME Dialog-Frame
     1374   DO:
     1375     run process-goods in this-procedure .
     1376   END.
     1377   ON RETURN OF new-artic IN FRAME Dialog-Frame
     1378   DO:
     1379     APPLY "CHOOSE":U TO btn_Ok IN FRAME Dialog-Frame.
     1380   END.
     1381   ON RETURN OF new-prod-code IN FRAME Dialog-Frame
     1382   OR LEAVE OF new-prod-code IN FRAME Dialog-Frame
     1383   OR RETURN OF new-prod-type IN FRAME Dialog-Frame
     1384   OR LEAVE OF new-prod-type IN FRAME Dialog-Frame
     1385   DO:
     1386     define buffer buf_clients for ub.clients.
     1387     assign
     1388       new-prod-code
     1389       new-prod-type
     1390     .
     1391     find first buf_clients no-lock
     1392       where buf_clients.obj-type = new-prod-type
     1393         and buf_clients.obj-code = new-prod-code
     1394       no-error
     1395     .
     1396     if available buf_clients then do:
     1397       assign
     1398         new-clobjname:screen-value = buf_clients.obj-name
     1399       .
     1400     end.
     1401     else do:
     1402       assign
     1403         new-clobjname:screen-value = '???'
     1404       .
     1405     end.
     1406   END.
     1407   ON RETURN OF old-prod-code IN FRAME Dialog-Frame
     1408   OR LEAVE OF old-prod-code IN FRAME Dialog-Frame
     1409   OR RETURN OF old-prod-type IN FRAME Dialog-Frame
     1410   OR LEAVE OF old-prod-type IN FRAME Dialog-Frame
     1411   DO:
     1412     define buffer buf_clients for ub.clients.
     1413     assign
     1414       old-prod-code
     1415       old-prod-type
     1416     .
     1417     find first buf_clients no-lock
     1418       where buf_clients.obj-type = old-prod-type
     1419         and buf_clients.obj-code = old-prod-code
     1420       no-error
     1421     .
     1422     if available buf_clients then do:
     1423       assign
     1424         old-clobjname:screen-value = buf_clients.obj-name
     1425       .
     1426     end.
     1427     else do:
     1428       assign
     1429         old-clobjname:screen-value = '???'
     1430       .
     1431     end.
     1432   END.
     1433   ON CHOOSE OF sel-gds IN FRAME Dialog-Frame
     1434   DO:
     1435     define buffer buf-sel_goods for ub.goods .
     1436     define buffer buf_clients for ub.clients .
     1437     run ref/gds-ref.p ( input parParentProc
     1438                   ,input "'ПРОСМОТР':U,b-sel"
     1439                   ,input ?
     1440                   ,input ?
     1441                   ,input ?
     1442                   ,input ?
     1443                   ,input ?
     1444                   ,input ?
     1445                   ,input ?
     1446                   ,input ?
     1447                   ,input ?
     1448                   ,input ?
     1449                   ,output rid-list
     1450                  ).
     1451     find first buf-sel_goods share-lock
     1452       where recid(buf-sel_goods) = integer(rid-list)
     1453       no-error
     1454       .
     1455     if not available buf-sel_goods then do:
     1456       assign
     1457         v-gds-name   :screen-value = ''
     1458         old-artic    :screen-value = ''
     1459         old-prod-type:screen-value = ''
     1460         old-prod-code:screen-value = ''
     1461         old-clobjname:screen-value = ''
     1462         new-artic    :screen-value = ''
     1463         new-prod-type:screen-value = ''
     1464         new-prod-code:screen-value = ''
     1465         new-clobjname:screen-value = ''
     1466       .
     1467       return .
     1468     end.
     1469     find first buf_clients share-lock
     1470       where buf_clients.obj-type = buf-sel_goods.prod-type
     1471         and buf_clients.obj-code = buf-sel_goods.prod-code
     1472       .
     1473     assign
     1474       v-gds-name    = buf-sel_goods.gds-name
     1475       old-artic     = buf-sel_goods.artic
     1476       old-prod-type = buf-sel_goods.prod-type
     1477       old-prod-code = buf-sel_goods.prod-code
     1478       old-clobjname = buf_clients.obj-name
     1479       new-artic     = buf-sel_goods.artic
     1480       new-prod-type = buf-sel_goods.prod-type
     1481       new-prod-code = buf-sel_goods.prod-code
     1482       new-clobjname = buf_clients.obj-name
     1483     .
     1484     display
     1485       v-gds-name
     1486       old-artic
     1487       old-prod-type
     1488       old-prod-code
     1489       old-clobjname
     1490       new-clobjname
     1491       new-prod-type
     1492       new-prod-code
     1493       new-artic
     1494     with frame Dialog-Frame.
     1495   END.
     1496   ON CHOOSE OF sel-new-prod IN FRAME Dialog-Frame
     1497   DO:
     1498     assign
     1499       rid-list = ""
     1500     .
     1501     run ref/cli-all.w ( parParentProc, "b-sel", 'про':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,,", "news", output rid-list ) no-error.
     1502     if error-status :error then do:
     1503       message
     1504         vss-workfile vss-revision vss-description skip
     1505         "Ошибка при выборе клиента" skip
     1506         view-as alert-box error .
     1507       return no-apply .
     1508     end.
     1509     find new-clients no-lock
     1510       where recid(new-clients) = integer(rid-list)
     1511       no-error .
     1512     if available new-clients then do:
     1513       assign
     1514         new-prod-type = new-clients.obj-type
     1515         new-prod-code = new-clients.obj-code
     1516         new-clobjname = new-clients.obj-name
     1517       .
     1518       disp
     1519         new-prod-type
     1520         new-prod-code
     1521         new-clobjname
     1522         with frame Dialog-Frame.
     1523     end.
     1524   END.
     1525   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1526   on help of frame Dialog-Frame
     1527   do:
     1528     run gbl/app_help.p
     1529       (input this-procedure :file-name
     1530       ,input ''
     1531       ,input ?
     1532       ) no-error.
     1533     if error-status :error then do:
     1534       message
     1535         "Ошибка при вызове помощи"
     1536         error-status :get-message(1)
     1537         view-as alert-box .
     1538     end.
     1539   end.
     1540   run minbtn-set in this-procedure .
     1541   on choose of b-help in frame Dialog-Frame
     1542   do:
     1543     apply "help":u to frame Dialog-Frame .
     1544   end.
     1545   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1546   procedure minbtn-set :
     1547       do
     1548           on error undo, return error return-value
     1549           :
     1550           define variable ii              as integer       no-undo .
     1551           define variable fh              as widget-handle no-undo .
     1552           define variable hh              as widget-handle no-undo .
     1553           define variable v-h             as handle        extent 4 no-undo .
     1554           define variable v-name-button   as character     no-undo .
     1555           define variable v-help-old-x    as decimal       no-undo .
     1556           define variable v-help-old-y    as decimal       no-undo .
     1557           define variable v-help-old-size as decimal       no-undo .
     1558           define variable v-frame-width   as decimal       no-undo .
     1559           define variable jj              as integer       no-undo .
     1560           do
     1561               on error undo, return error
     1562               :
     1563               assign
     1564                   v-frame-width = frame Dialog-Frame:width - 0.3
     1565                   fh            = frame Dialog-Frame:first-child
     1566                   hh            = fh:first-child
     1567                   ii            = 1
     1568                   .
     1569               do while valid-handle(hh):
     1570                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1571                   do:
     1572                       case lc(hh:name) :
     1573                           when "b-help" then
     1574                               do:
     1575                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1576                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1577                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1578                                   hh:TOOLTIP = "Помощь" .
     1579                                   v-help-old-x = hh:column .
     1580                                   v-help-old-y = hh:row    .
     1581                                   v-help-old-size = hh:width .
     1582                                   hh:width-chars = 2.5 .
     1583                               end.
     1584                           when "b-print" then
     1585                               do:
     1586                                   hh:load-image("cmp/b-print.bmp":u) .
     1587                                   hh:TOOLTIP = "Печать" .
     1588                                   v-h[ii] = hh:handle .
     1589                                   ii = ii + 1 .
     1590                                   hh:width-chars = 3 .
     1591                               end.
     1592                           when "b-history" or
     1593                           when "b-hist" then
     1594                               do:
     1595                                   hh:load-image("cmp/b-hist.bmp":u) .
     1596                                   hh:TOOLTIP = "История" .
     1597                                   v-h[ii] = hh:handle .
     1598                                   ii = ii + 1 .
     1599                                   hh:width-chars = 3 .
     1600                               end.
     1601                           when "b-sch" then
     1602                               do:
     1603                                   hh:load-image("cmp/b-sch.bmp":u) .
     1604                                   hh:TOOLTIP = "Установка Фильтра" .
     1605                                   v-h[ii] = hh:handle .
     1606                                   ii = ii + 1 .
     1607                                   hh:width-chars = 3 .
     1608                               end.
     1609                           when "b-hist-user" then
     1610                               do:
     1611                                   hh:load-image("cmp/b-hist.bmp":u) .
     1612                                   hh:TOOLTIP = "История пользователя" .
     1613                                   ii = ii + 1 .
     1614                               end.
     1615                       end case.
     1616                   end.
     1617                   hh = hh:next-sibling.
     1618               end.
     1619               b-help:column = v-frame-width - b-help:width-chars.
     1620               jj = 0.
     1621               repeat ii = 4 to 1 by -1 :
     1622                   if valid-handle (v-h[ii] ) then
     1623                   do:
     1624                       jj  = jj + 1 .
     1625                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1626                       v-h[ii]:row    = v-help-old-y .
     1627                   end.
     1628               end.
     1629           end.
     1630       end.
     1631   end procedure.
     1632   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1633   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1634   MAIN-BLOCK:
     1635   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1636   :
     1637     define buffer buf_db for ub.db .
     1638     define buffer buf-main_goods for ub.goods .
     1639     assign
     1640       v-not-two-commit = true
     1641     .
     1642     if  p-old-artic <> ?
     1643     and p-old-prod-type <> ?
     1644     and p-old-prod-code <> ?
     1645     then do:
     1646       do transaction
     1647       on error undo main-block, return error return-value
     1648       :
     1649         find buf-main_goods exclusive-lock
     1650           where buf-main_goods.artic     = p-old-artic
     1651             and buf-main_goods.prod-type = p-old-prod-type
     1652             and buf-main_goods.prod-code = p-old-prod-code
     1653           no-error
     1654         .
     1655         if not available buf-main_goods
     1656           and g#news = true
     1657         then do:
     1658           return error substitute( "Не найден товар:", p-old-artic, p-old-prod-type, p-old-prod-code ) .
     1659         end.
     1660         else do:
     1661           assign
     1662             old-artic     = p-old-artic
     1663             old-prod-type = p-old-prod-type
     1664             old-prod-code = p-old-prod-code
     1665             new-prod-type = p-old-prod-type
     1666             new-prod-code = p-old-prod-code
     1667           .
     1668         end.
     1669       end.
     1670     end.
     1671     RUN enable_UI.
     1672     if g#news = true then do:
     1673       assign
     1674         v-not-two-commit = true
     1675       .
     1676       DISABLE sel-gds Btn_RenameAll Btn_Cancel with frame Dialog-Frame.
     1677       HIDE sel-gds Btn_RenameAll Btn_Cancel in frame Dialog-Frame.
     1678     end.
     1679     else do:
     1680       find first buf_db no-lock
     1681         where buf_db.db-num > 0
     1682         no-error .
     1683       if available buf_db then do:
     1684         assign
     1685           v-not-two-commit = false
     1686         .
     1687       end.
     1688     end.
     1689     if p-old-artic <> ?
     1690       and p-old-prod-type <> ?
     1691       and p-old-prod-code <> ?
     1692     then do:
     1693       DISABLE sel-gds Btn_RenameAll with frame Dialog-Frame.
     1694       HIDE sel-gds Btn_RenameAll in frame Dialog-Frame.
     1695     end.
     1696     if g#news = true then do:
     1697       WAIT-FOR "CHOOSE" OF Btn_OK IN FRAME Dialog-Frame.
     1698     end.
     1699     else do:
     1700       WAIT-FOR "CHOOSE" OF Btn_Cancel IN FRAME Dialog-Frame.
     1701     end.
     1702   END.
     1703   RUN disable_UI.
     1704   PROCEDURE disable_UI :
     1705     HIDE FRAME Dialog-Frame.
     1706   END PROCEDURE.
     1707   PROCEDURE enable_UI :
     1708     OPEN QUERY Dialog-Frame FOR EACH ub.clients SHARE-LOCK.
     1709     GET FIRST Dialog-Frame.
     1710     DISPLAY old-artic v-gds-name old-prod-code old-prod-type old-clobjname
     1711             new-artic new-prod-code new-prod-type new-clobjname
     1712         WITH FRAME Dialog-Frame.
     1713     ENABLE Btn_Cancel Btn_OK Btn_RenameAll b-help sel-gds new-artic new-prod-code
     1714            new-prod-type sel-new-prod
     1715         WITH FRAME Dialog-Frame.
     1716     VIEW FRAME Dialog-Frame.
     1717   END PROCEDURE.
     1718   PROCEDURE process-goods :
     1719     define variable error-message as character no-undo .
     1720     define variable v-new-artic as character no-undo .
     1721     define variable icount as integer no-undo .
     1722     define variable i-rename-count as integer no-undo init 0 .
     1723     define variable v-bar-code like ub.bar-code.b-code no-undo .
     1724     define buffer buf_gds-prt for ub.gds-prt .
     1725     define buffer buf_bar-code for ub.bar-code .
     1726     define buffer buf-all_goods for ub.goods .
     1727     define variable lOK as logical no-undo init false .
     1728     message
     1729       "Просмотреть все товары, для определения товаров," skip
     1730       "которые не имеют автоматического артикула?" skip
     1731       view-as alert-box question
     1732       buttons ok-cancel update lOK.
     1733     if lOK <> true then do:
     1734       return .
     1735     end.
     1736     run waitfram-show in this-procedure
     1737       (INPUT "Просмотр товаров ... "
     1738       ).
     1739     for each temp-goods
     1740     :
     1741       delete temp-goods .
     1742     end.
     1743     for each buf-all_goods no-lock
     1744     on error undo, next
     1745     on end-key undo, return
     1746     :
     1747       assign
     1748         icount = icount + 1
     1749       .
     1750       run waitfram-show in this-procedure
     1751         (input "Просмотрено товаров: " + string(icount)
     1752         ).
     1753       process events .
     1754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1755     (input  buf-all_goods.gds-code
     1756     ,input  ?
     1757     ,output v-bar-code
     1758     ) no-error .
     1759       if error-status :error then do:
     1760         message
     1761           vss-workfile vss-revision vss-description skip
     1762           "Ошибка при определении бар-кода товара" skip
     1763           substitute( "Код товара: &1", buf-all_goods.gds-code ) skip
     1764           view-as alert-box error .
     1765         undo, return error .
     1766       end.
     1767       assign
     1768         v-new-artic = string(v-bar-code)
     1769       .
     1770       if buf-all_goods.artic <> v-new-artic then do:
     1771         create temp-goods .
     1772         assign
     1773           temp-goods.gds-code   = buf-all_goods.gds-code
     1774           temp-goods.artic      = buf-all_goods.artic
     1775           temp-goods.prod-type  = buf-all_goods.prod-type
     1776           temp-goods.prod-code  = buf-all_goods.prod-code
     1777           temp-goods.new-artic  = v-new-artic
     1778         .
     1779         assign
     1780           i-rename-count = i-rename-count + 1
     1781         .
     1782       end.
     1783     end.
     1784     run waitfram-hide in this-procedure .
     1785     output stream log to new-art.txt .
     1786     put stream log
     1787       'Старый артикул        Тип произв.       Код произв      Новый артикул'
     1788       skip.
     1789     for each temp-goods
     1790     :
     1791       put stream log
     1792         temp-goods.artic ' '
     1793         temp-goods.prod-type ' '
     1794         temp-goods.prod-code ' '
     1795         temp-goods.new-artic
     1796         skip.
     1797     end.
     1798     output stream log close .
     1799     message
     1800       "Вы действительно хотите переименовать все товары, имеющие неавтоматические артикулы," skip
     1801       "присвоив им автоматические артикулы, равные внутреннему бар-коду?" skip
     1802       "Всего будет переименовано " i-rename-count " товаров из " icount "."
     1803       skip (2)
     1804       "ВНИМАНИЕ!" skip
     1805       "Сделайте архивную копию базы данных перед выполнением данной операции!" skip
     1806       "Пользователи не должны работать с базой данных!" skip
     1807       "Лучше всего данную утилиту запускать в однопользовательском режиме." skip
     1808       "Список товаров подлежащих переименованию можно посмотреть в файле new-art.txt."
     1809       view-as alert-box question
     1810       buttons ok-cancel update lOK.
     1811     if lOK <> true then do:
     1812       return .
     1813     end.
     1814     define variable i-good-count as integer no-undo .
     1815     define variable i-bad-count  as integer no-undo .
     1816     assign
     1817       i-good-count = 0
     1818       i-bad-count  = 0
     1819     .
     1820     for each temp-goods
     1821     :
     1822       if v-not-two-commit = false then do:
     1823         find first buf-all_goods exclusive-lock
     1824           where buf-all_goods.artic     = temp-goods.artic
     1825             and buf-all_goods.prod-type = temp-goods.prod-type
     1826             and buf-all_goods.prod-code = temp-goods.prod-code
     1827           no-error
     1828         .
     1829         if not available buf-all_goods then do:
     1830           message
     1831             substitute( "Товар с артикулом &1 и производителем &2 &3 не найден!", temp-goods.artic, temp-goods.prod-type, temp-goods.prod-code ) skip
     1832             substitute( "Возможно он был уже переименован." ) skip
     1833             view-as alert-box error
     1834           .
     1835           next .
     1836         end.
     1837         run gen-key-rec( input 'goods':U
     1838                         ,input (buffer buf-all_goods:handle )
     1839                         ,output v-key-rec
     1840                       ) no-error.
     1841         if error-status :error then do:
     1842           assign
     1843             i-bad-count = i-bad-count + 1
     1844           .
     1845         end.
     1846         else do:
     1847           assign
     1848             v-param = substitute( "&1&2&3&2&4&2&5&2&6&2&7&2&8"
     1849                                   ,buf-all_goods.gds-code
     1850                                   ,chr(4)
     1851                                   ,temp-goods.artic
     1852                                   ,temp-goods.prod-type
     1853                                   ,temp-goods.prod-code
     1854                                   ,temp-goods.new-artic
     1855                                   ,temp-goods.prod-type
     1856                                   ,temp-goods.prod-code
     1857                                 ).
     1858           run nws/db-rec.p ( input 'ren-art':U
     1859                         ,input v-key-rec
     1860                         ,input v-param
     1861                       ) no-error .
     1862           if error-status :error
     1863             or return-value <> "":U
     1864           then do:
     1865             assign
     1866               i-bad-count = i-bad-count + 1
     1867             .
     1868           end.
     1869           else do:
     1870             assign
     1871               i-good-count = i-good-count + 1
     1872             .
     1873           end.
     1874         end.
     1875       end.
     1876       else do:
     1877         run utl/ren-art.p
     1878           (INPUT  temp-goods.gds-code
     1879           ,INPUT  temp-goods.artic
     1880           ,INPUT  temp-goods.prod-type
     1881           ,INPUT  temp-goods.prod-code
     1882           ,INPUT  temp-goods.new-artic
     1883           ,INPUT  temp-goods.prod-type
     1884           ,INPUT  temp-goods.prod-code
     1885           ) no-error.
     1886         if error-status:error
     1887         or return-value <> "" then do:
     1888           assign
     1889             i-bad-count = i-bad-count + 1
     1890           .
     1891         end.
     1892         else do:
     1893           assign
     1894             i-good-count = i-good-count + 1
     1895           .
     1896         end.
     1897       end.
     1898     end.
     1899     message
     1900       "Переименование артикулов завершено. " SKIP
     1901       "Переименовано артикулов " i-good-count SKIP
     1902       "Непереименовано артикулов (из-за ошибок выполнения) " i-bad-count SKIP
     1903       view-as alert-box .
     1904   END PROCEDURE.
     1905   PROCEDURE rename-artic :
     1906     define input parameter p-old-artic     like ub.goods.artic     no-undo .
     1907     define input parameter p-old-prod-type like ub.goods.prod-type no-undo .
     1908     define input parameter p-old-prod-code like ub.goods.prod-code no-undo .
     1909     define input parameter p-new-artic     like ub.goods.artic     no-undo .
     1910     define input parameter p-new-prod-type like ub.goods.prod-type no-undo .
     1911     define input parameter p-new-prod-code like ub.goods.prod-code no-undo .
     1912     define buffer buf-rename_goods for ub.goods .
     1913     define variable v-error-message as character no-undo .
     1914     define variable v-bar-code like ub.bar-code.b-code no-undo .
     1915     define variable v-gds-code like ub.goods.gds-code no-undo .
     1916     do transaction
     1917     on error undo, return no-apply
     1918     :
     1919       find first buf-rename_goods exclusive-lock
     1920         where buf-rename_goods.artic     = old-artic
     1921           and buf-rename_goods.prod-type = old-prod-type
     1922           and buf-rename_goods.prod-code = old-prod-code
     1923         no-error
     1924       .
     1925       if not available buf-rename_goods then do:
     1926         message
     1927           substitute( "Товар с артикулом &1 и производителем &2 &3 не найден!", old-artic, old-prod-type, old-prod-code ) skip
     1928           substitute( "Возможно он был уже переименован." ) skip
     1929           view-as alert-box error
     1930         .
     1931         return error .
     1932       end.
     1933       assign
     1934         v-gds-code = buf-rename_goods.gds-code
     1935       .
     1936   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1937     (input  v-gds-code
     1938     ,input  ?
     1939     ,output v-bar-code
     1940     ) no-error .
     1941       if error-status :error then do:
     1942         message
     1943           vss-workfile vss-revision vss-description skip
     1944           "Ошибка при определении бар-кода товара" skip
     1945           "Код товара" skip
     1946           view-as alert-box error .
     1947         undo, return error .
     1948       end.
     1949       if v-not-two-commit = false then do:
     1950         run gen-key-rec( input 'goods':U
     1951                         ,input (buffer buf-rename_goods:handle )
     1952                         ,output v-key-rec
     1953                       ) no-error.
     1954         if error-status :error then do:
     1955           message
     1956             vss-workfile vss-revision vss-description skip
     1957             "Ошибка при генерации уникального ключа для товара" skip
     1958             substitute( "код &1", v-gds-code ) skip
     1959             return-value
     1960             view-as alert-box error .
     1961           return error .
     1962         end.
     1963         assign
     1964           v-param = substitute( "&1&2&3&2&4&2&5&2&6&2&7&2&8"
     1965                                 ,v-gds-code
     1966                                 ,chr(4)
     1967                                 ,p-old-artic
     1968                                 ,p-old-prod-type
     1969                                 ,p-old-prod-code
     1970                                 ,p-new-artic
     1971                                 ,p-new-prod-type
     1972                                 ,p-new-prod-code
     1973                               ).
     1974         run nws/db-rec.p ( input 'ren-art':U
     1975                       ,input v-key-rec
     1976                       ,input v-param
     1977                     ) no-error .
     1978         if error-status :error then do:
     1979           message
     1980             vss-workfile vss-revision vss-description skip
     1981             "Ошибка при переименовании артикула и(или) производителя для товара" skip
     1982             substitute( "код &1", v-gds-code ) skip
     1983             return-value skip
     1984             error-status :get-message(1)
     1985             view-as alert-box error .
     1986           return error .
     1987         end.
     1988         if return-value <> "":U then do:
     1989           message
     1990             return-value
     1991             view-as alert-box error .
     1992           return no-apply.
     1993         end.
     1994         message
     1995           "Операция переименования артикула и(или) производителя начата" skip
     1996           "Направлен запрос во все БД" skip
     1997           "После получения положительного ответа артикул и(или) производитель будет переименован"
     1998           view-as alert-box information.
     1999       end.
     2000       else do:
     2001         run utl/ren-art.p
     2002           (input  v-gds-code
     2003           ,input  p-old-artic
     2004           ,input  p-old-prod-type
     2005           ,input  p-old-prod-code
     2006           ,input  p-new-artic
     2007           ,input  p-new-prod-type
     2008           ,input  p-new-prod-code
     2009           ) no-error.
     2010         if error-status :error
     2011         or return-value <> "" then do:
     2012           message
     2013             "Артикул не изменен:" skip
     2014             v-error-message skip
     2015             view-as alert-box error.
     2016         end.
     2017         else do:
     2018           message
     2019             "Завершено изменение артикула" skip
     2020             "Старый артикул" p-old-artic p-old-prod-type p-old-prod-code skip
     2021             "Новый артикул" p-new-artic p-new-prod-type p-new-prod-code  skip
     2022             view-as alert-box information .
     2023         end.
     2024       end.
     2025     end.
     2026   END PROCEDURE.
     2027   PROCEDURE validate-prod :
     2028     define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2029     define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2030     define buffer buf_clients for ub.clients.
     2031     find first buf_clients no-lock
     2032       where buf_clients.obj-type = p-obj-type
     2033         and buf_clients.obj-code = p-obj-code
     2034       no-error
     2035     .
     2036     if not available buf_clients then do:
     2037       message
     2038         vss-workfile vss-revision vss-description skip
     2039         "Ошибка при задании нового производителя!" skip
     2040         view-as alert-box error .
     2041       undo, return error.
     2042     end.
     2043     if buf_clients.obj-type = 'скл':U
     2044     or buf_clients.obj-type = 'маг':U
     2045     then do:
     2046       message
     2047         "Склад/магазин не может быть производителем !" skip
     2048         "Производитель" p-obj-type p-obj-code skip
     2049         view-as alert-box error .
     2050       undo, return error.
     2051     end.
     2052   END PROCEDURE.
