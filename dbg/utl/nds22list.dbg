        1   define input  parameter iKey     as integer no-undo.
        2   define output parameter oChekSum as character no-undo.
        3   if userid("ub") eq ""
        4   then do:
        5      oChekSum = encode(string(iKey * 13)) + string(index(encode(string(iKey)), "k"))
        6    .
        7      return.
        8   end.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
       11   define variable vss-date        as character no-undo init "$Date: Jan 19 2026 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: nds22list.p.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: FixProc/nds22list.p $".
       14   define variable vss-description as character no-undo init "Ручной запуск утилиты для BTS-2205 без корректировки ставок (только лог).".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure factord :
       77     define input  parameter p-fact-date            as date    no-undo .
       78     define input  parameter p-fact-time            as integer no-undo .
       79     define input  parameter p-fact-num             as integer no-undo .
       80     define input  parameter p-shift-date           as date    no-undo .
       81     define input  parameter p-shift-num            as integer no-undo .
       82     define input  parameter p-shift-on             as logical no-undo .
       83     define output parameter p-fact-order           as decimal no-undo .
       84     define output parameter p-shift-end-fact-order as decimal no-undo .
       85     define output parameter p-day-end-fact-order   as decimal no-undo .
       86     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       87     if p-fact-date = ?
       88     then do:
       89       return error "Не указана фактическая дата" .
       90     end.
       91     define variable v-fact-date-num as integer no-undo .
       92     assign
       93       v-fact-date-num = integer(p-fact-date)
       94     .
       95     if p-fact-num = ?
       96     or p-fact-num = 0
       97     then do:
       98       return error "Не задан p-fact-num " + string(p-fact-num) .
       99     end.
      100     if p-fact-num < 0
      101     then do:
      102       return error "Отрицательный fact-num " + string(p-fact-num) .
      103     end.
      104     if p-fact-num >= 100000000
      105     then do:
      106       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      107     end.
      108     if p-shift-on = true
      109     then do:
      110       if p-shift-date = ?
      111       then do:
      112         return error "Не задана дата смены" .
      113       end.
      114       if p-shift-num = ?
      115       or p-shift-num = 0
      116       then do:
      117         return error "Не задан номер смены" .
      118       end.
      119     end.
      120     else do:
      121       assign
      122         p-shift-date = p-fact-date
      123         p-shift-num  = 24
      124       .
      125     end.
      126     define variable v-shift-offset as integer no-undo .
      127     if p-shift-date = p-fact-date
      128     then do:
      129       assign
      130         v-shift-offset = 1
      131       .
      132     end.
      133     if p-shift-date < p-fact-date
      134     then do:
      135       assign
      136         v-shift-offset = 0
      137       .
      138     end.
      139     if p-shift-date > p-fact-date
      140     then do:
      141       message
      142         vss-workfile vss-revision vss-description skip
      143         "Неправильная дата закрытия смены" skip
      144         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      145         view-as alert-box error .
      146       undo, return error
      147         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      148           ,string(p-fact-date, '99/99/9999':U)
      149           ,string(p-shift-date, '99/99/9999':U)
      150           )
      151       .
      152     end.
      153     if p-shift-num < 1
      154     or p-shift-num > 24
      155     then do:
      156       message
      157         vss-workfile vss-revision vss-description skip
      158         "Неправильный номер смены" skip
      159         "p-shift-num" p-shift-num skip
      160         view-as alert-box error .
      161       undo, return error return-value .
      162     end.
      163     assign
      164       p-fact-order           = v-fact-date-num
      165                              + v-shift-offset * 0.5
      166                              + p-shift-num    * 0.02 - 0.01
      167                              + p-fact-num     * 0.0000000001
      168       p-shift-end-fact-order = v-fact-date-num
      169                              + v-shift-offset * 0.5
      170                              + p-shift-num    * 0.02
      171       p-day-end-fact-order   = v-fact-date-num
      172                              + 0.99
      173     .
      174     if p-fact-order           <= v-fact-date-num
      175     or p-shift-end-fact-order <= v-fact-date-num
      176     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      177     or p-shift-end-fact-order >= p-day-end-fact-order
      178     then do:
      179       message
      180         vss-workfile vss-revision vss-description skip
      181         "Внутренняя ошибка при генерации фактического номера" skip
      182         "p-fact-date"            p-fact-date            skip
      183         "p-fact-time"            p-fact-time            skip
      184         "p-fact-num"             p-fact-num             skip
      185         "p-shift-date"           p-shift-date           skip
      186         "p-shift-num"            p-shift-num            skip
      187         "p-shift-on"             p-shift-on             skip
      188         "p-shift-end-fact-order" p-shift-end-fact-order skip
      189         "p-day-end-fact-order"   p-day-end-fact-order   skip
      190         "v-fact-date-num"        v-fact-date-num        skip
      191         view-as alert-box error .
      192       undo, return error return-value .
      193     end.
      194   end procedure.
      195   procedure day-begin-fact-order :
      196     define input  parameter p-fact-date            as date    no-undo .
      197     define output parameter p-day-begin-fact-order as decimal no-undo .
      198     do
      199     on error undo, return error return-value
      200     :
      201       if p-fact-date = ?
      202       then do:
      203         assign
      204           p-day-begin-fact-order = 0
      205         .
      206       end.
      207       else do:
      208         assign
      209           p-day-begin-fact-order = integer(p-fact-date)
      210         .
      211       end.
      212     end.
      213   end procedure.
      214   procedure factord-max-fact-order :
      215     define output parameter p-max-fact-order as decimal   no-undo .
      216     do
      217     on error undo, return error return-value
      218     :
      219       run day-begin-fact-order in this-procedure
      220         (input  date(1, 1, 5000)
      221         ,output p-max-fact-order
      222         ) .
      223     end.
      224   end procedure.
      225   procedure factord-cut-archive :
      226     define input  parameter p-obj-type             as character no-undo .
      227     define input  parameter p-obj-code             as integer   no-undo .
      228     define input  parameter p-fact-date            as date      no-undo .
      229     define output parameter p-shift-on             as logical   no-undo .
      230     define output parameter p-shift-date           as date      no-undo .
      231     define output parameter p-shift-num            as integer   no-undo .
      232     define output parameter p-day-end-fact-order   as decimal   no-undo .
      233     define output parameter p-shift-end-fact-order as decimal   no-undo .
      234     define variable v-fact-order as decimal   no-undo .
      235     define buffer buf_shift-obj for ub.shift-obj .
      236     do
      237     on error undo, return error return-value
      238     :
      239   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      241     (input  p-obj-type
      242     ,input  p-obj-code
      243     ,input  'shift-on=request'
      244     ,output p-shift-on
      245     ) no-error .
      246       if error-status :error
      247       then do:
      248         message
      249           vss-workfile vss-revision vss-description skip
      250           "Ошибка при определении атрибута объекта" skip
      251           "Объект" p-obj-type p-obj-code skip
      252           error-status :get-message(1) skip
      253           return-value skip
      254           view-as alert-box error .
      255         undo, return error return-value .
      256       end.
      257       if p-shift-on = false
      258       then do:
      259         assign
      260           p-shift-date               = ?
      261           p-shift-num                = 0
      262         .
      263       end.
      264       else do:
      265         find first buf_shift-obj share-lock
      266           where buf_shift-obj.obj-type   = p-obj-type
      267             and buf_shift-obj.obj-code   = p-obj-code
      268             and buf_shift-obj.shift-date > p-fact-date
      269           use-index pi
      270           no-error .
      271         if not available buf_shift-obj
      272         or buf_shift-obj.status_ <> 'зкр':U
      273         then do:
      274           message
      275             vss-workfile vss-revision vss-description skip
      276             "Невозможно вычислить последнюю смену" skip
      277             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      278             "Объект" p-obj-type p-obj-code skip
      279             "Дата" p-fact-date skip
      280             view-as alert-box error .
      281           undo, return error return-value .
      282         end.
      283         find last buf_shift-obj share-lock
      284           where buf_shift-obj.obj-type = p-obj-type
      285             and buf_shift-obj.obj-code = p-obj-code
      286             and buf_shift-obj.shift-date <= p-fact-date
      287           use-index pi
      288           no-error .
      289         if available buf_shift-obj
      290         then do:
      291           if  buf_shift-obj.status_ = 'зкр':U
      292           then do:
      293             assign
      294               p-shift-date = buf_shift-obj.shift-date
      295               p-shift-num  = buf_shift-obj.shift-num
      296             .
      297           end.
      298           else do:
      299             message
      300               vss-workfile vss-revision vss-description skip
      301               "Невозможно вычислить последнюю смену" skip
      302               "Статус смены отличен от статуса" 'зкр':U skip
      303               "Объект" p-obj-type p-obj-code skip
      304               "Дата" p-fact-date skip
      305               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      306               view-as alert-box error .
      307             undo, return error return-value .
      308           end.
      309         end.
      310         else do:
      311           assign
      312             p-shift-date = p-fact-date - 1
      313             p-shift-num  = 1
      314           .
      315         end.
      316       end.
      317       run factord in this-procedure
      318         (input  p-fact-date
      319         ,input  1
      320         ,input  1
      321         ,input  p-shift-date
      322         ,input  p-shift-num
      323         ,input  p-shift-on
      324         ,output v-fact-order
      325         ,output p-shift-end-fact-order
      326         ,output p-day-end-fact-order
      327         ) no-error .
      328       if error-status :error
      329       then do:
      330         message
      331           vss-workfile vss-revision vss-description skip
      332           "Ошибка при вызове процедуры factord"
      333           error-status :get-message(1) skip
      334           return-value skip
      335           view-as alert-box error .
      336         undo, return error return-value .
      337       end.
      338     end.
      339   end procedure.
      340   procedure factord-lock-shift :
      341     define input  parameter p-obj-type  as character no-undo .
      342     define input  parameter p-obj-code  as integer   no-undo .
      343     define input  parameter p-fact-date as date      no-undo .
      344     define parameter buffer buf_shift-obj for ub.shift-obj .
      345     define variable v-shift-on      as logical   no-undo .
      346     define variable v-extra-message as character no-undo .
      347     define variable v-error as character no-undo .
      348     do
      349     on error undo, return error return-value
      350     :
      351   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      352   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      353     (input  p-obj-type
      354     ,input  p-obj-code
      355     ,input  'shift-on=request'
      356     ,output v-shift-on
      357     ) no-error .
      358       if error-status :error
      359       then do:
      360         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      361         undo, return error v-error .
      362       end.
      363       if v-shift-on = true
      364       then do:
      365         find first buf_shift-obj share-lock
      366           where buf_shift-obj.obj-type   = p-obj-type
      367             and buf_shift-obj.obj-code   = p-obj-code
      368             and buf_shift-obj.shift-date > p-fact-date
      369           use-index pi
      370           no-error .
      371         if not available buf_shift-obj
      372         or buf_shift-obj.status_ <> 'зкр':U
      373         then do:
      374           find last buf_shift-obj
      375             where buf_shift-obj.obj-type = p-obj-type
      376               and buf_shift-obj.obj-code = p-obj-code
      377               and buf_shift-obj.status_  = 'зкр':U
      378             use-index stts
      379             no-error .
      380           if available buf_shift-obj
      381           then do:
      382             assign
      383               v-extra-message =
      384                     substitute("Дата начала последеней закрытой смены на объекте &1"
      385                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      386                               )
      387             .
      388           end.
      389           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      390           undo, return error v-error .
      391         end.
      392       end.
      393     end.
      394   end procedure.
      395   procedure factord-end-day :
      396     define input  parameter p-fact-date            as date    no-undo .
      397     define output parameter p-day-end-fact-order   as decimal no-undo .
      398     do
      399     on error undo, return error return-value
      400     :
      401       if p-fact-date = ?
      402       then do:
      403         return error "Не указана фактическая дата" .
      404       end.
      405       assign
      406         p-day-end-fact-order = integer(p-fact-date) + 0.99
      407       .
      408     end.
      409   end procedure.
      410   procedure factord-to-date :
      411     define input  parameter p-fact-order as decimal no-undo .
      412     define output parameter p-fact-date  as date    no-undo .
      413     define variable v-ref-date  as date      no-undo .
      414     define variable v-ref-delta as integer   no-undo .
      415     do
      416     on error undo, return error return-value
      417     :
      418       if p-fact-order = ?
      419       or p-fact-order = 0
      420       then do:
      421         return error "Не указан fact-order" .
      422       end.
      423       assign
      424         v-ref-date  = date(1, 1, 2000)
      425       .
      426       assign
      427         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      428       .
      429       assign
      430         p-fact-date = v-ref-date + v-ref-delta
      431       .
      432     end.
      433   end procedure.
      434   procedure factord-to-fact-num :
      435     define input  parameter p-fact-order as decimal no-undo .
      436     define output parameter p-fact-num   as integer no-undo .
      437     define variable v-fact-order-trunc as decimal no-undo .
      438     do
      439     on error undo, return error return-value
      440     :
      441       if p-fact-order = ?
      442       or p-fact-order = 0
      443       then do:
      444         return error "Не указан fact-order" .
      445       end.
      446       assign
      447        v-fact-order-trunc = truncate(p-fact-order, 2)
      448       .
      449       assign
      450         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      451       .
      452     end.
      453   end procedure.
      454   procedure factord-to-shift-num :
      455     define input  parameter p-fact-order as decimal no-undo .
      456     define output parameter p-shift-num   as integer no-undo .
      457     define variable  p-shift-numd  as decimal   no-undo .
      458     define variable v-fact-order-trunc as decimal no-undo .
      459     do
      460     on error undo, return error return-value
      461     :
      462       if p-fact-order = ?
      463       or p-fact-order = 0
      464       then do:
      465         return error "Не указан fact-order" .
      466       end.
      467       assign
      468        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      469       .
      470       if v-fact-order-trunc < 0.5 then do:
      471         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      472       end.
      473       assign
      474         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      475         .
      476        assign
      477         p-shift-num = truncate (p-shift-numd , 0)
      478       .
      479     end.
      480   end procedure.
      481   find first sys-ctrl no-lock .
      482   define stream sProt.
      483   output stream sProt to value("utl_2205_" + string(sys-ctrl.db-num) + ".txt").
      484   define variable v-fact-date  as date no-undo init 01/01/2026.
      485   define variable v-fact-order as decimal no-undo .
      486   define buffer tax-rate-gds      for ub.tax-rate-gds.
      487   define buffer buf_tax-rate-gds  for ub.tax-rate-gds.
      488   define buffer last_tax-rate-gds for ub.tax-rate-gds.
      489   define buffer curr_tax-rate-gds for ub.tax-rate-gds.
      490   define buffer tax-rate-gds-grp  for ub.tax-rate-gds-grp.
      491   define buffer sys-ctrl          for ub.sys-ctrl.
      492   define buffer buf_code          for ub.code.
      493   on delete of ub.tax-rate-gds override do: end.
      494   find first sys-ctrl no-lock.
      495   run factord-end-day in this-procedure (
      496       input v-fact-date
      497      ,output v-fact-order).
      498   for each tax-rate-gds no-lock where
      499            tax-rate-gds.tax-code  = 1
      500        and tax-rate-gds.rate-code = 1
      501        and tax-rate-gds.fact-order < v-fact-order
      502        break by tax-rate-gds.gds-code by tax-rate-gds.fact-order
      503   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      504   :
      505     if last-of(tax-rate-gds.gds-code) then
      506     do:
      507       for last last_tax-rate-gds no-lock where
      508                last_tax-rate-gds.gds-code  = tax-rate-gds.gds-code
      509            and last_tax-rate-gds.tax-code   = tax-rate-gds.tax-code
      510            and last_tax-rate-gds.host-code  = tax-rate-gds.host-code
      511            and last_tax-rate-gds.obj-type   = tax-rate-gds.obj-type
      512            and last_tax-rate-gds.obj-code   = tax-rate-gds.obj-code
      513            and last_tax-rate-gds.fact-order > tax-rate-gds.fact-order
      514            and last_tax-rate-gds.fact-order < v-fact-order
      515            and last_tax-rate-gds.rate-code <> 11
      516       :
      517         find first buf_tax-rate-gds exclusive-lock where
      518                    buf_tax-rate-gds.gds-code = tax-rate-gds.gds-code
      519                and buf_tax-rate-gds.tax-code = tax-rate-gds.tax-code
      520                and buf_tax-rate-gds.rate-code = 11
      521                and buf_tax-rate-gds.host-code = tax-rate-gds.host-code
      522                and buf_tax-rate-gds.obj-type = tax-rate-gds.obj-type
      523                and buf_tax-rate-gds.obj-code = tax-rate-gds.obj-code
      524                and buf_tax-rate-gds.fact-order = v-fact-order
      525         no-error.
      526         if avail buf_tax-rate-gds then
      527         do:
      528           for last curr_tax-rate-gds no-lock where
      529                    curr_tax-rate-gds.gds-code  = tax-rate-gds.gds-code
      530                and curr_tax-rate-gds.tax-code   = tax-rate-gds.tax-code
      531                and curr_tax-rate-gds.host-code  = tax-rate-gds.host-code
      532                and curr_tax-rate-gds.obj-type   = tax-rate-gds.obj-type
      533                and curr_tax-rate-gds.obj-code   = tax-rate-gds.obj-code
      534           :
      535             put stream sProt unformatted
      536               "result;" string(sys-ctrl.db-num) ";"
      537               string(tax-rate-gds.gds-code) ";"
      538               string(last_tax-rate-gds.rate-code) ";"
      539               string(curr_tax-rate-gds.rate-code)
      540               skip
      541             .
      542           end.
      543         end.
      544       end.
      545     end.
      546   end.
      547   output stream sProt close.
      548   MESSAGE "Успешно!" VIEW-AS ALERT-BOX.
