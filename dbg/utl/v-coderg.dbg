        1   define input parameter p-db-num     like ub.code-range.db-num     no-undo .
        2   define input parameter p-range-type like ub.code-range.range-type no-undo .
        3   define input parameter p-type-code  as   character                no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Список диапазонов кодов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   procedure gen-key-rec :
      115     define input  parameter p-tbl-name    as character no-undo.
      116     define input  parameter p-bh_tbl-name as handle    no-undo.
      117     define output parameter p-key-rec     as character no-undo.
      118     do
      119     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      120     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      121     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      122     :
      123       define variable fh               as handle    no-undo .
      124       define variable v-ok             as logical   no-undo .
      125       define variable v-inform         as character no-undo .
      126       define variable v-ind            as integer   no-undo .
      127       define variable v-idx-field-qnty as integer   no-undo .
      128       if p-tbl-name = ?
      129         or p-tbl-name = "":U
      130       then do:
      131         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      132       end.
      133       if not p-bh_tbl-name:available then do:
      134         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      135       end.
      136       assign
      137         p-key-rec = p-tbl-name
      138         v-inform  = p-bh_tbl-name:index-information(1)
      139         v-ind     = 2
      140       .
      141       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      142       on error undo, return error
      143       :
      144         assign
      145           v-inform = p-bh_tbl-name:index-information( v-ind )
      146           v-ind    = v-ind + 1
      147         .
      148       end.
      149       if v-inform = ?
      150         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      151         or entry( 3, v-inform, ",":U ) <> "1":U
      152       then do:
      153         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      154       end.
      155       else do:
      156         assign
      157           v-idx-field-qnty = num-entries( v-inform ) - 4
      158         .
      159         if v-idx-field-qnty < 2 then do:
      160           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      161         end.
      162         do v-ind = 1 to v-idx-field-qnty by 2
      163         on error undo, return error
      164         :
      165           assign
      166             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      167             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      168           .
      169         end.
      170       end.
      171       if p-key-rec = ? then do:
      172         assign
      173           p-key-rec = "":U
      174         .
      175         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      176       end.
      177     end.
      178     return.
      179   end procedure.
      180   procedure gen-where-keyr-tab :
      181     define input  parameter i-tableSerach as character no-undo.
      182     define input  parameter i-tablekey   as character  no-undo.
      183     define input  parameter p-key-rec    as character  no-undo.
      184     define input  parameter p-key-handle as handle     no-undo .
      185     define input  parameter p-db-name    as character  no-undo .
      186     define input  parameter p-tt-handle  as handle     no-undo .
      187     define output parameter o-Where      as character  no-undo.
      188     do
      189     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      190     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      191     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      192     :
      193       define variable v-full-tbl-name  as character no-undo .
      194       define variable bh_tbl-name      as handle    no-undo .
      195       define variable fh_key           as handle    no-undo .
      196       define variable fh_search        as handle    no-undo .
      197       define variable v-field-num      as integer   no-undo .
      198       define variable v-count-fld      as integer   no-undo .
      199       define variable v-inform         as character no-undo .
      200       define variable v-ind            as integer   no-undo .
      201       define variable v-idx-field-qnty as integer   no-undo .
      202       define variable v-field-name     as character no-undo .
      203       define variable v-field-val      as character no-undo .
      204       define variable v-word-link      as character no-undo .
      205       define variable vTable           as character no-undo.
      206       define variable bh_tbl-key       as handle    no-undo .
      207       assign
      208         p-key-rec = trim( p-key-rec )
      209       .
      210       if p-key-handle <> ? then do:
      211         if not valid-handle(p-key-handle)
      212            or p-key-handle:type <> "buffer"
      213         then do:
      214           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      215         end.
      216         if num-entries( p-key-rec, chr(3) ) > 1
      217           or p-key-rec = ?
      218           or p-key-rec = "":U
      219         then do:
      220           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      221         end.
      222       end.
      223       else do:
      224         if p-key-rec = ?
      225           or p-key-rec = "":U
      226         then do:
      227           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      228         end.
      229       end.
      230       assign
      231         vTable = entry( 1 , p-key-rec, chr(3) )
      232       .
      233       if p-tt-handle <> ?
      234         and ( not valid-handle(p-tt-handle)
      235               or p-tt-handle:type <> "buffer"
      236             )
      237       then do:
      238         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      239       end.
      240       if p-tt-handle = ? then do:
      241         assign
      242           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      243         .
      244         create buffer bh_tbl-name for table v-full-tbl-name .
      245       end.
      246       else do:
      247         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      248       end.
      249       assign
      250         v-inform = bh_tbl-name:index-information(1)
      251         v-ind    = 2
      252       .
      253       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      254       on error undo, return error
      255       :
      256         assign
      257           v-inform = bh_tbl-name:index-information( v-ind )
      258           v-ind    = v-ind + 1
      259         .
      260       end.
      261       if v-inform = ?
      262         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      263         or entry( 3, v-inform, ",":U ) <> "1":U
      264       then do:
      265         delete object bh_tbl-name no-error.
      266         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      267       end.
      268       assign
      269         v-idx-field-qnty = num-entries( v-inform ) - 4
      270       .
      271       if v-idx-field-qnty < 2 then do:
      272         delete object bh_tbl-name no-error.
      273         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      274       end.
      275       assign
      276         o-where     = "where":U
      277         v-word-link = "":U
      278         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      279         v-count-fld = 0
      280       .
      281       if i-tablekey ne "" and i-tablekey ne ?
      282       then do:
      283         assign
      284           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      285         .
      286         create buffer bh_tbl-key for table v-full-tbl-name .
      287       end.
      288       if i-tableSerach ne "" and i-tableSerach ne ?
      289       then do:
      290         delete object bh_tbl-name no-error.
      291         assign
      292           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      293         .
      294         create buffer bh_tbl-name for table v-full-tbl-name .
      295       end.
      296       block_where:
      297       do v-ind = 1 to v-idx-field-qnty by 2
      298       on error undo, return error
      299       :
      300         assign
      301           v-count-fld = v-count-fld + 1
      302         .
      303         if p-key-handle = ?
      304           and v-count-fld > v-field-num
      305         then do:
      306           leave block_where.
      307         end.
      308         define variable VfieldKeyTable as handle no-undo.
      309         assign
      310           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      311           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      312         .
      313         if     bh_tbl-key ne ?
      314         then do:
      315            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      316            if VfieldKeyTable eq ?
      317            then next block_where.
      318         end.
      319         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      320         then
      321            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      322         else
      323            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      324         if p-key-handle = ? then do:
      325           assign
      326             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      327           .
      328         end.
      329         else do:
      330           assign
      331             fh_key = p-key-handle:buffer-field( v-field-name )
      332           .
      333           if fh_key = ?
      334             or not valid-handle( fh_key )
      335           then do:
      336             delete object bh_tbl-name.
      337             if     bh_tbl-key ne ?
      338             then
      339                delete object bh_tbl-key.
      340             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      341           end.
      342           assign
      343             v-field-val = fh_key:buffer-value
      344           .
      345         end.
      346         if fh_search:data-type ="character":U then do:
      347           assign
      348             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      349             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      350             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      351             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      352             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      353             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      354             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      355             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      356             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      357             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      358             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      359             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      360             v-field-val = substitute( '"&1"', v-field-val )
      361           .
      362         end.
      363         assign
      364           o-where = substitute( "&1 &2", o-where, v-field-val )
      365         .
      366         if v-word-link = "":U then do:
      367           assign
      368             v-word-link = "and":U
      369           .
      370         end.
      371       end.
      372       delete object bh_tbl-name.
      373       if     bh_tbl-key ne ?
      374       then
      375          delete object bh_tbl-key.
      376       if p-key-handle = ?
      377         and v-count-fld <> v-field-num
      378       then do:
      379         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      380       end.
      381     end.
      382   end procedure.
      383   procedure gen-hn-keyr-tab :
      384     define input  parameter i-tableSerach as character no-undo.
      385     define input  parameter i-tablekey   as character no-undo.
      386     define input  parameter p-key-rec    as character no-undo.
      387     define input  parameter p-key-handle as handle    no-undo .
      388     define input  parameter p-db-name    as character no-undo .
      389     define input  parameter p-tt-handle  as handle    no-undo .
      390     define input  parameter p-stts-lock  as integer   no-undo .
      391     define output parameter o-hn         as handle    no-undo.
      392     define variable v-full-tbl-name as character no-undo.
      393     define variable v-where         as character no-undo.
      394     define variable bh_tbl-name     as handle    no-undo.
      395     define variable vTable          as character no-undo.
      396     do
      397     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      398     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      399     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      400         run gen-where-keyr-tab(i-tableSerach,
      401                                i-tablekey,
      402                                p-key-rec,
      403                                p-key-handle,
      404                                p-db-name,
      405                                p-tt-handle,
      406                                output v-where).
      407         if i-tableSerach ne "" and i-tableSerach ne ?
      408         then do:
      409            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      410            create buffer bh_tbl-name for table v-full-tbl-name .
      411         end.
      412         else do:
      413            if p-tt-handle = ? then do:
      414               assign
      415                  vTable = entry( 1 , p-key-rec, chr(3) )
      416               .
      417               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      418               create buffer bh_tbl-name for table v-full-tbl-name .
      419            end.
      420            else do:
      421               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      422            end.
      423         end.
      424         if p-tt-handle = ? then do:
      425            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      426         end.
      427         else do:
      428            bh_tbl-name:find-first( v-where ) no-error .
      429         end.
      430         o-hn = bh_tbl-name.
      431      end.
      432   end procedure.
      433   procedure gen-hn-keyr :
      434     define input  parameter p-key-rec    as character no-undo.
      435     define input  parameter p-key-handle as handle    no-undo .
      436     define input  parameter p-db-name    as character no-undo .
      437     define input  parameter p-tt-handle  as handle    no-undo .
      438     define input  parameter p-stts-lock  as integer   no-undo .
      439     define output parameter o-hn         as handle    no-undo.
      440     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      441   end.
      442   procedure gen-row-keyr :
      443     define input  parameter p-key-rec    as character no-undo.
      444     define input  parameter p-key-handle as handle    no-undo .
      445     define input  parameter p-db-name    as character no-undo .
      446     define input  parameter p-tt-handle  as handle    no-undo .
      447     define input  parameter p-stts-lock  as integer   no-undo .
      448     define output parameter p-tbl-row    as rowid     no-undo.
      449     define output parameter p-tbl-name   as character no-undo.
      450     define variable vHn as handle no-undo.
      451       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      452       p-tbl-row = if vHn:available then vHn:rowid else ?.
      453       p-tbl-name =  vHn:table.
      454       delete object vHn no-error.
      455     if p-tbl-row = ? then do:
      456       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      457     end.
      458     else do:
      459       return.
      460     end.
      461   end procedure.
      462   procedure gen-key-fv :
      463     define input  parameter p-key-rec    as character no-undo .
      464     define output parameter p-field-list as character no-undo .
      465     define output parameter p-value-list as character no-undo.
      466     do
      467     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      468     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      469     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      470     :
      471       define variable v-full-tbl-name  as character no-undo .
      472       define variable bh_tbl-name      as handle    no-undo .
      473       define variable v-tbl-name       as character no-undo .
      474       define variable v-field-num      as integer   no-undo .
      475       define variable v-count-fld      as integer   no-undo .
      476       define variable v-inform         as character no-undo .
      477       define variable v-ind            as integer   no-undo .
      478       define variable v-idx-field-qnty as integer   no-undo .
      479       define variable v-delim-key      as character no-undo .
      480       if p-key-rec = ?
      481         or p-key-rec = "":U
      482       then do:
      483         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      484       end.
      485       assign
      486         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      487         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      488       .
      489       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      490       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      491       assign
      492         v-inform = bh_tbl-name:index-information(1)
      493         v-ind    = 2
      494       .
      495       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      496       on error undo, return error
      497       :
      498         assign
      499           v-inform = bh_tbl-name:index-information( v-ind )
      500           v-ind    = v-ind + 1
      501         .
      502       end.
      503       if v-inform = ?
      504         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      505         or entry( 3, v-inform, ",":U ) <> "1":U
      506       then do:
      507         delete object bh_tbl-name no-error.
      508         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      509       end.
      510       assign
      511         v-idx-field-qnty = num-entries( v-inform ) - 4
      512       .
      513       if v-idx-field-qnty < 2 then do:
      514         delete object bh_tbl-name no-error.
      515         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      516       end.
      517       assign
      518         p-field-list = "":U
      519         p-value-list = "":U
      520         v-delim-key  = "":U
      521         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      522         v-count-fld  = 0
      523       .
      524       block_where:
      525       do v-ind = 1 to v-idx-field-qnty by 2
      526       on error undo, return error
      527       :
      528         assign
      529           v-count-fld = v-count-fld + 1
      530         .
      531         if v-count-fld > v-field-num then do:
      532           leave block_where.
      533         end.
      534         assign
      535           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      536           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      537         .
      538         if v-ind = 1 then do:
      539           assign
      540             v-delim-key = chr(3)
      541           .
      542         end.
      543       end.
      544       delete object bh_tbl-name.
      545       if v-count-fld <> v-field-num then do:
      546         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      547       end.
      548     end.
      549   end procedure.
      550   procedure gen-key-field :
      551     define input  parameter p-table      as character no-undo .
      552     define output parameter p-field-list as character no-undo .
      553     do
      554     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      555     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      556     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      557     :
      558       define variable v-full-tbl-name  as character no-undo .
      559       define variable bh_tbl-name      as handle    no-undo .
      560       define variable v-tbl-name       as character no-undo .
      561       define variable v-field-num      as integer   no-undo .
      562       define variable v-count-fld      as integer   no-undo .
      563       define variable v-inform         as character no-undo .
      564       define variable v-ind            as integer   no-undo .
      565       define variable v-idx-field-qnty as integer   no-undo .
      566       define variable v-delim-key      as character no-undo .
      567       if p-table = ?
      568         or p-table = "":U
      569       then do:
      570         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      571       end.
      572       assign
      573         v-tbl-name      = p-table
      574         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      575       .
      576       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      577       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      578       assign
      579         v-inform = bh_tbl-name:index-information(1)
      580         v-ind    = 2
      581       .
      582       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      583       on error undo, return error
      584       :
      585         assign
      586           v-inform = bh_tbl-name:index-information( v-ind )
      587           v-ind    = v-ind + 1
      588         .
      589       end.
      590       if v-inform = ?
      591         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      592         or entry( 3, v-inform, ",":U ) <> "1":U
      593       then do:
      594         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      595       end.
      596       assign
      597         v-idx-field-qnty = num-entries( v-inform ) - 4
      598       .
      599       if v-idx-field-qnty < 2 then do:
      600         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      601       end.
      602       assign
      603         p-field-list = "":U
      604         v-delim-key  = "":U
      605         v-count-fld  = 0
      606       .
      607       block_where:
      608       do v-ind = 1 to v-idx-field-qnty by 2
      609       on error undo, return error
      610       :
      611         assign
      612           v-count-fld = v-count-fld + 1
      613         .
      614         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      615         if v-ind = 1 then do:
      616           assign
      617             v-delim-key = chr(3)
      618           .
      619         end.
      620       end.
      621       delete object bh_tbl-name.
      622     end.
      623   end procedure.
      624   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625   procedure progs-name :
      626     define input  parameter p-action-code         as character no-undo .
      627     define output parameter p-main-prog-name      as character no-undo .
      628     define output parameter p-list-db-proc-name   as character no-undo .
      629     define output parameter p-commit-proc-name    as character no-undo .
      630     define output parameter p-execution-proc-name as character no-undo .
      631     define output parameter p-recover-proc-name   as character no-undo .
      632     define output parameter p-after-proc-name     as character no-undo .
      633     do
      634     on error undo, return error
      635     :
      636       case p-action-code :
      637               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
      638               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      639               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      640               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      641               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      642               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      643               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      644               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      645               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      646               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      647               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      648               otherwise do:
      649           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info1, p-action-code ).
      650         end.
      651       end case.
      652     end.
      653     return.
      654   end procedure.
      655   procedure progs-title :
      656     define input  parameter p-action-code         as character no-undo .
      657     define output parameter p-action-title      as character no-undo .
      658     do
      659     on error undo, return error
      660     :
      661       case p-action-code :
      662               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      663               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      664               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      665               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      666               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      667               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      668               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      669               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      670               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      671               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      672               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      673               otherwise do:
      674           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info1, p-action-code ).
      675         end.
      676       end case.
      677     end.
      678     return.
      679   end procedure.
      680   FUNCTION progs-title-function returns character(
      681      input  p-action-code         as character):
      682   define variable p-action-title      as character no-undo .
      683     do
      684     on error undo, return error
      685     :
      686       case p-action-code :
      687               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      688               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      689               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      690               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      691               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      692               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      693               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      694               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      695               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      696               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      697               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      698               otherwise do:
      699           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info1, p-action-code ).
      700         end.
      701       end case.
      702     end.
      703     return p-action-title.
      704   end FUNCTION.
      705   procedure get-row-keyr-string :
      706    define input  parameter p-key-rec  as character no-undo.
      707    define output parameter p-tbl-title as character no-undo.
      708    define output parameter p-rec-string  as character no-undo.
      709     do
      710     on error undo, return error
      711     :
      712       define variable v-full-tbl-name as character no-undo .
      713       define variable bh_tbl-name     as handle    no-undo .
      714       define variable fh              as handle    no-undo .
      715       define variable v-ok            as logical   no-undo .
      716       define variable v-field-num     as integer   no-undo .
      717       define variable v-count-fld     as integer   no-undo .
      718       define variable v-tbl-name as character no-undo.
      719       if p-key-rec = ?
      720         or p-key-rec = "":U
      721       then do:
      722         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      723       end.
      724       assign
      725         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      726         v-full-tbl-name = "ub.":U + v-tbl-name
      727         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      728         p-rec-string         = "":U
      729         v-count-fld     = 0
      730       .
      731       find ub._file
      732         where ub._file._file-name = v-tbl-name
      733         no-error.
      734       if not available ub._file then do:
      735         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info1, v-tbl-name ).
      736       end.
      737       assign
      738       p-tbl-title = ub._file._file-label
      739       .
      740       find ub._index
      741         where recid( ub._index  ) = ub._file._prime-index
      742         no-error.
      743       if not available ub._index
      744         or LC( ub._index._index-name ) = "default":U
      745       then do:
      746         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      747       end.
      748       block_where :
      749       for each ub._index-field of ub._index  ,
      750           each ub._field of _index-field
      751           break by _index-seq
      752       on error undo, return error
      753       :
      754         assign
      755           v-count-fld = v-count-fld + 1
      756         .
      757         if v-count-fld > v-field-num then do:
      758           leave block_where.
      759         end.
      760         if p-rec-string = "":U then do:
      761           assign
      762             p-rec-string = "":U
      763           .
      764         end.
      765         else do:
      766           assign
      767             p-rec-string = p-rec-string + chr(32) + chr(44)
      768           .
      769         end.
      770         assign
      771           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      772         .
      773       end.
      774       if v-count-fld <> v-field-num then do:
      775         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      776       end.
      777     end.
      778     return.
      779   end procedure.
      780   FUNCTION uniq-key-rec-string-f returns character(
      781      input  p-uniq-key-rec         as character):
      782   define variable v-tbl-title as character no-undo .
      783   define variable v-rec-string as character no-undo .
      784     do
      785     on error undo, return error
      786     :
      787       run get-row-keyr-string in this-procedure (
      788                                                 input p-uniq-key-rec
      789                                                 ,output v-tbl-title
      790                                                 ,output v-rec-string).
      791       assign
      792       v-rec-string = (if v-tbl-title <> ? and
      793                       v-tbl-title <> "":U
      794                       then (v-tbl-title + ":")
      795                      else "":U) + chr(32) + v-rec-string
      796       .
      797     end.
      798     return v-rec-string.
      799   end FUNCTION.
      800   procedure create_db-rec_route :
      801     define input parameter p1-uniq-key-rec as character no-undo .
      802     define input parameter p1-action       as character no-undo .
      803     define input parameter p1-operation    as character no-undo .
      804     define input parameter p1-send-db-list as character no-undo .
      805     define input parameter p1-db-init      as integer   no-undo .
      806     define input parameter p1-parameters   as character no-undo .
      807     define input parameter p1-answer-code  as integer   no-undo .
      808     define input parameter p1-answer-msg   as character no-undo .
      809     do
      810     on error undo, return error
      811     :
      812       define variable v-command     as character no-undo .
      813       define variable v-ind         as integer   no-undo .
      814       define variable v-num-entries as integer   no-undo .
      815       define variable v-curr-db     as integer   no-undo .
      816       define variable v-db-for-send as character no-undo .
      817       define variable v-db-num      as integer   no-undo .
      818       define variable v-db-num-char as character no-undo .
      819       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      820       find first buf_sys-ctrl no-lock .
      821       assign
      822         v-curr-db     = buf_sys-ctrl.db-num
      823         v-db-for-send = "":U
      824       .
      825       if v-curr-db = 0 then do:
      826         if p1-answer-code >= 0 then do:
      827           if v-curr-db <> p1-db-init then do:
      828             assign
      829               v-db-for-send = string( p1-db-init )
      830             .
      831           end.
      832         end.
      833         else do:
      834           assign
      835             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      836           .
      837           do v-ind = 1 to v-num-entries:
      838             assign
      839               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      840               v-db-num      = integer( v-db-num-char )
      841             .
      842             if v-db-num <> v-curr-db
      843               and v-db-num <> p1-db-init
      844             then do:
      845               if v-db-for-send = "":U then do:
      846                 assign
      847                   v-db-for-send = v-db-num-char
      848                 .
      849               end.
      850               else do:
      851                 assign
      852                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      853                 .
      854               end.
      855             end.
      856           end.
      857         end.
      858       end.
      859       else do:
      860         assign
      861           v-db-for-send = "0":U
      862         .
      863       end.
      864       if v-db-for-send <> "":U then do:
      865         assign
      866           v-command = "command":U + chr(1)
      867                       + "two-commit":U + chr(1)
      868                       + p1-action + chr(1)
      869                       + p1-operation + chr(1)
      870                       + p1-uniq-key-rec + chr(1)
      871                       + string( p1-db-init ) + chr(1)
      872                       + p1-parameters + chr(1)
      873                       + string( p1-answer-code ) + chr(1)
      874                       + p1-answer-msg
      875         .
      876         run nws/cr-route.p ( input 'send-cmd':U
      877                       ,input v-command
      878                       ,input ?
      879                       ,input v-db-for-send
      880                       ) no-error .
      881         if error-status :error then do:
      882           return error return-value.
      883         end.
      884       end.
      885     end.
      886     return.
      887   end procedure.
      888   procedure create_msg_route :
      889     define input parameter p2-send-db-list as character no-undo .
      890     define input parameter p2-msg          as character no-undo .
      891     do
      892     on error undo, return error
      893     :
      894       define variable v-msg-command as character no-undo .
      895       define variable v-ind         as integer   no-undo .
      896       define variable v-num-entries as integer   no-undo .
      897       define variable v-curr-db     as integer   no-undo .
      898       define variable v-db-for-send as character no-undo .
      899       define variable v-db-num      as integer   no-undo .
      900       define variable v-db-num-char as character no-undo .
      901       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      902       find first buf_sys-ctrl no-lock .
      903       assign
      904         v-curr-db     = buf_sys-ctrl.db-num
      905         v-db-for-send = "":U
      906       .
      907       if v-curr-db = 0 then do:
      908         assign
      909           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      910         .
      911         do v-ind = 1 to v-num-entries:
      912           assign
      913             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      914             v-db-num      = integer( v-db-num-char )
      915           .
      916           if v-db-num <> v-curr-db then do:
      917             if v-db-for-send = "":U then do:
      918               assign
      919                 v-db-for-send = v-db-num-char
      920               .
      921             end.
      922             else do:
      923               assign
      924                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      925               .
      926             end.
      927           end.
      928         end.
      929       end.
      930       else do:
      931         assign
      932           v-db-for-send = "0":U
      933         .
      934       end.
      935       if v-db-for-send <> "":U then do:
      936         assign
      937           v-msg-command = "command":U + chr(1)
      938                           + "message-to-log":U + chr(1)
      939                           + p2-msg
      940         .
      941         run nws/cr-route.p ( input 'send-cmd':U
      942                       ,input v-msg-command
      943                       ,input ?
      944                       ,input v-db-for-send
      945                       ) no-error .
      946         if error-status :error then do:
      947           return error substitute( "&1&2&3"
      948                                     , return-value
      949                                     , chr(10)
      950                                     , error-status :get-message(1)
      951                                   ).
      952         end.
      953       end.
      954     end.
      955     return.
      956   end procedure.
      957   function get-send-db-list returns character
      958     ( input p-curr-db     as integer
      959      ,input p-all-db-list as character
      960     )
      961   :
      962     define variable v-send-db-list as character no-undo .
      963     if p-curr-db = 0 then do:
      964       assign
      965         v-send-db-list = p-all-db-list
      966       .
      967     end.
      968     else do:
      969       assign
      970         v-send-db-list = string(p-curr-db)
      971       .
      972     end.
      973     return v-send-db-list .
      974   end function .
      975   define variable v-curr-db as integer no-undo .
      976   define variable v-Ok      as logical no-undo .
      977   DEFINE BUTTON b-crush DEFAULT
      978        LABEL "&Разбить"
      979        SIZE 10 BY 1
      980        BGCOLOR 8 .
      981   DEFINE BUTTON b-del
      982        LABEL "&Удалить"
      983        SIZE 10 BY 1.
      984   DEFINE BUTTON b-help DEFAULT
      985        LABEL "Помо&щь"
      986        SIZE 10 BY 1
      987        BGCOLOR 8 .
      988   DEFINE BUTTON b-quit AUTO-GO DEFAULT
      989        LABEL "&Выход"
      990        SIZE 10 BY 1
      991        BGCOLOR 8 .
      992   DEFINE BUTTON b-viewcode DEFAULT
      993        LABEL "&Коды"
      994        SIZE 10 BY 1
      995        BGCOLOR 8 .
      996   DEFINE QUERY BROWSE-1 FOR
      997         ub.code-range SCROLLING.
      998   DEFINE BROWSE BROWSE-1
      999     QUERY BROWSE-1 DISPLAY
     1000         ub.code-range.first-code FORMAT ">,>>>,>>>,>>9":U
     1001         ub.code-range.last-code FORMAT ">,>>>,>>>,>>9":U
     1002         ub.code-range.stts COLUMN-LABEL "Ст." FORMAT "X(3)":U
     1003         ub.code-range.PS FORMAT "X(50)":U
     1004       WITH NO-ROW-MARKERS SEPARATORS SIZE 83.8 BY 17.
     1005   DEFINE FRAME v-coderg
     1006        b-quit AT ROW 1.27 COL 2
     1007        b-viewcode AT ROW 1.27 COL 12
     1008        b-crush AT ROW 1.27 COL 22
     1009        b-del AT ROW 1.27 COL 32 WIDGET-ID 2
     1010        b-help AT ROW 1.27 COL 75.8
     1011        BROWSE-1 AT ROW 2.57 COL 2
     1012        SPACE(1.69) SKIP(0.42)
     1013       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1014            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1015            TITLE "Диапазоны кодов"
     1016            CANCEL-BUTTON b-quit.
     1017   ASSIGN
     1018          FRAME v-coderg:SCROLLABLE       = FALSE
     1019          FRAME v-coderg:HIDDEN           = TRUE.
     1020   ON WINDOW-CLOSE OF FRAME v-coderg
     1021   DO:
     1022     APPLY "END-ERROR":U TO SELF.
     1023   END.
     1024   ON CHOOSE OF b-crush IN FRAME v-coderg
     1025   DO:
     1026     define variable v-log            as logical   no-undo .
     1027     define variable v-cfg-param-code as character no-undo .
     1028     define variable v-length-new     as integer   no-undo .
     1029     define variable v-key-rec        as character no-undo .
     1030     define variable v-param          as character no-undo .
     1031     define variable v-rowid          as rowid     no-undo .
     1032     define variable v-param-type as character no-undo .
     1033     define variable v-value-character as INTEGER no-undo .
     1034     define variable v-value-date as date no-undo .
     1035     define variable v-value-decimal as decimal no-undo .
     1036     define variable v-value-logical AS LOGICAL no-undo .
     1037     define variable v-tth as handle no-undo .
     1038     if not available ub.code-range then do:
     1039       message
     1040         "Необходимо выбрать диапазон!"
     1041         view-as alert-box error.
     1042       return no-apply.
     1043     end.
     1044     if ub.code-range.stts = "a":U then do:
     1045       message
     1046         "Нельзя дробить активный диапазон!"
     1047         view-as alert-box error.
     1048       return no-apply.
     1049     end.
     1050     message
     1051       "Вы действительно хотите разбить диапазон" skip
     1052       substitute( "c &1 по &2", ub.code-range.first-code, ub.code-range.last-code )
     1053       view-as alert-box question buttons yes-no update v-log.
     1054     if v-log <> true then do:
     1055       return no-apply.
     1056     end.
     1057     assign
     1058       v-cfg-param-code = "":U
     1059     .
     1060     run trg/getpcode.p ( input  ub.code-range.range-type
     1061                    ,output v-cfg-param-code
     1062                   ) no-error .
     1063     if error-status :error
     1064       or v-cfg-param-code = "":U
     1065       or v-cfg-param-code = ?
     1066     then do:
     1067       message
     1068         vss-workfile vss-revision vss-description skip
     1069         substitute( "Ошибка при определении имени параметра для диапазона &1", ub.code-range.range-type ) skip
     1070         error-status :get-message(1) skip
     1071         return-value skip
     1072         view-as alert-box error .
     1073       return no-apply .
     1074     end.
     1075     run adm/shattri.p (
     1076         input "get":U
     1077         ,input  'БД':U
     1078         ,input  ub.code-range.db-num
     1079         ,input  'code-range':U
     1080         ,input  v-cfg-param-code
     1081         ,output v-value-character
     1082         ,output v-value-date
     1083         ,output v-value-decimal
     1084         ,output v-length-new
     1085         ,output v-value-logical
     1086         ,output v-param-type
     1087         ,INPUT-OUTPUT table-handle v-tth
     1088         ) no-error .
     1089     if error-status :error then do:
     1090       delete object v-tth.
     1091       message
     1092       vss-workfile vss-revision vss-description skip
     1093       substitute( "Ошибка при чтении значения параметра &1", v-cfg-param-code ) skip
     1094       error-status :get-message(1) skip
     1095       return-value skip
     1096       view-as alert-box error .
     1097       return no-apply .
     1098     end.
     1099     delete object v-tth.
     1100     if v-length-new >= ( ub.code-range.last-code - ub.code-range.first-code + 1 )
     1101     then do:
     1102       message
     1103         vss-workfile vss-revision vss-description skip
     1104         "Новая длина диапазона(ов) должна быть меньше текущей" skip
     1105         substitute( "новая длина (из конфигурационного параметра): &1", v-length-new ) skip
     1106         substitute( "текущая длина диапазона: &1", ( ub.code-range.last-code - ub.code-range.first-code + 1 ) )
     1107         view-as alert-box error .
     1108       return no-apply.
     1109     end.
     1110     run gen-key-rec( input 'code-range':U
     1111                     ,input (buffer ub.code-range:handle )
     1112                     ,output v-key-rec
     1113                    ) no-error.
     1114     if error-status :error then do:
     1115       message
     1116         vss-workfile vss-revision vss-description skip
     1117         "Ошибка при генерации уникального ключа для диапазона" skip
     1118         substitute( "тип &1", ub.code-range.range-type ) skip
     1119         substitute( "начало диапазона &1", ub.code-range.first-code ) skip
     1120         return-value
     1121         view-as alert-box error .
     1122       return no-apply.
     1123     end.
     1124     assign
     1125       v-Ok    = BROWSE-1 :set-repositioned-row( BROWSE-1 :focused-row, 'CONDITIONAL':u)
     1126       v-rowid = rowid( ub.code-range )
     1127       v-param = ub.code-range.range-type + chr(4)
     1128                 + string( ub.code-range.first-code ) + chr(4)
     1129                 + string( ub.code-range.last-code ) + chr(4)
     1130                 + string( v-length-new )
     1131     .
     1132     run nws/db-rec.p ( input "crush_code-range":U
     1133                   ,input v-key-rec
     1134                   ,input v-param
     1135                  ) no-error .
     1136     if error-status :error then do:
     1137       message
     1138         vss-workfile vss-revision vss-description skip
     1139         "Ошибка при разбиении диапазона" skip
     1140         substitute( "Тип &1", ub.code-range.range-type ) skip
     1141         substitute( "Начало диапазона &1", ub.code-range.first-code ) skip
     1142         return-value skip
     1143         error-status :get-message(1)
     1144         view-as alert-box error .
     1145       return no-apply.
     1146     end.
     1147     if return-value <> "":U then do:
     1148       message
     1149         return-value
     1150         view-as alert-box error .
     1151       return no-apply.
     1152     end.
     1153     message
     1154       "Операция разбиения диапазона начата" skip
     1155       "Направлен запрос во все БД" skip
     1156       "После получения положительного ответа диапазон будет разбит"
     1157       view-as alert-box information.
     1158     OPEN QUERY BROWSE-1 FOR EACH ub.code-range       WHERE code-range.db-num = p-db-num  AND code-range.range-type = p-range-type NO-LOCK     BY ub.code-range.first-code.
     1159     reposition BROWSE-1 to rowid v-rowid .
     1160   END.
     1161   ON CHOOSE OF b-del IN FRAME v-coderg
     1162   DO:
     1163     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1164     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1165   END.
     1166   ON CHOOSE OF b-viewcode IN FRAME v-coderg
     1167   DO:
     1168     if not available ub.code-range then do:
     1169       message
     1170         "Необходимо выбрать диапазон!"
     1171         view-as alert-box error.
     1172       return no-apply.
     1173     end.
     1174     run utl/v-codes.w ( input ub.code-range.range-type
     1175                    ,input ub.code-range.first-code
     1176                    ,input p-type-code
     1177                   ) .
     1178   END.
     1179   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   on help of frame v-coderg
     1181   do:
     1182     run gbl/app_help.p
     1183       (input this-procedure :file-name
     1184       ,input ''
     1185       ,input ?
     1186       ) no-error.
     1187     if error-status :error then do:
     1188       message
     1189         "Ошибка при вызове помощи"
     1190         error-status :get-message(1)
     1191         view-as alert-box .
     1192     end.
     1193   end.
     1194   run minbtn-set in this-procedure .
     1195   on choose of b-help in frame v-coderg
     1196   do:
     1197     apply "help":u to frame v-coderg .
     1198   end.
     1199   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   procedure minbtn-set :
     1201       do
     1202           on error undo, return error return-value
     1203           :
     1204           define variable ii              as integer       no-undo .
     1205           define variable fh              as widget-handle no-undo .
     1206           define variable hh              as widget-handle no-undo .
     1207           define variable v-h             as handle        extent 4 no-undo .
     1208           define variable v-name-button   as character     no-undo .
     1209           define variable v-help-old-x    as decimal       no-undo .
     1210           define variable v-help-old-y    as decimal       no-undo .
     1211           define variable v-help-old-size as decimal       no-undo .
     1212           define variable v-frame-width   as decimal       no-undo .
     1213           define variable jj              as integer       no-undo .
     1214           do
     1215               on error undo, return error
     1216               :
     1217               assign
     1218                   v-frame-width = frame v-coderg:width - 0.3
     1219                   fh            = frame v-coderg:first-child
     1220                   hh            = fh:first-child
     1221                   ii            = 1
     1222                   .
     1223               do while valid-handle(hh):
     1224                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1225                   do:
     1226                       case lc(hh:name) :
     1227                           when "b-help" then
     1228                               do:
     1229                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1230                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1231                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1232                                   hh:TOOLTIP = "Помощь" .
     1233                                   v-help-old-x = hh:column .
     1234                                   v-help-old-y = hh:row    .
     1235                                   v-help-old-size = hh:width .
     1236                                   hh:width-chars = 2.5 .
     1237                               end.
     1238                           when "b-print" then
     1239                               do:
     1240                                   hh:load-image("cmp/b-print.bmp":u) .
     1241                                   hh:TOOLTIP = "Печать" .
     1242                                   v-h[ii] = hh:handle .
     1243                                   ii = ii + 1 .
     1244                                   hh:width-chars = 3 .
     1245                               end.
     1246                           when "b-history" or
     1247                           when "b-hist" then
     1248                               do:
     1249                                   hh:load-image("cmp/b-hist.bmp":u) .
     1250                                   hh:TOOLTIP = "История" .
     1251                                   v-h[ii] = hh:handle .
     1252                                   ii = ii + 1 .
     1253                                   hh:width-chars = 3 .
     1254                               end.
     1255                           when "b-sch" then
     1256                               do:
     1257                                   hh:load-image("cmp/b-sch.bmp":u) .
     1258                                   hh:TOOLTIP = "Установка Фильтра" .
     1259                                   v-h[ii] = hh:handle .
     1260                                   ii = ii + 1 .
     1261                                   hh:width-chars = 3 .
     1262                               end.
     1263                           when "b-hist-user" then
     1264                               do:
     1265                                   hh:load-image("cmp/b-hist.bmp":u) .
     1266                                   hh:TOOLTIP = "История пользователя" .
     1267                                   ii = ii + 1 .
     1268                               end.
     1269                       end case.
     1270                   end.
     1271                   hh = hh:next-sibling.
     1272               end.
     1273               b-help:column = v-frame-width - b-help:width-chars.
     1274               jj = 0.
     1275               repeat ii = 4 to 1 by -1 :
     1276                   if valid-handle (v-h[ii] ) then
     1277                   do:
     1278                       jj  = jj + 1 .
     1279                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1280                       v-h[ii]:row    = v-help-old-y .
     1281                   end.
     1282               end.
     1283           end.
     1284       end.
     1285   end procedure.
     1286   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1287   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1288   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1289   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1290   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1291   define variable v-diasize-current-frame-height as decimal   no-undo .
     1292   define variable v-diasize-change-size          as logical   no-undo .
     1293   define variable v-diasize-resize-button        as handle    no-undo .
     1294   define variable v-diasize-wndmax               as logical   no-undo .
     1295   define variable v-diasize-wndstore             as logical   no-undo .
     1296   define variable v-diasize-proc-name            as character no-undo .
     1297   define variable v-diasize-browse-handle        as handle    no-undo .
     1298   define variable v-diasize-browse-number        as integer   no-undo .
     1299   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1300   define temp-table temp-diasize-handle no-undo
     1301     field handle-value  as handle
     1302     field save-position as decimal
     1303     index xpk is primary unique handle-value
     1304     .
     1305   define temp-table temp-browse-handle no-undo
     1306     field browse-type   as character
     1307     field browse-number as integer
     1308     field browse-handle as handle
     1309     field original-size as decimal
     1310     index xpk is primary unique browse-type browse-number
     1311     index xie browse-type browse-handle
     1312   .
     1313   procedure diasize_change-height :
     1314     define input  parameter p-change-value  as decimal   no-undo .
     1315     define input  parameter p-move-resize   as logical   no-undo .
     1316     define variable v-field-group-handle    as handle    no-undo .
     1317     define variable v-object-handle         as handle    no-undo .
     1318     define variable v-frame-height          as decimal   no-undo .
     1319     define variable v-frame-virtual-height  as decimal   no-undo .
     1320     define variable v-browse-height         as decimal   no-undo .
     1321     define variable v-window-height         as decimal   no-undo .
     1322     define variable v-window-virtual-height as decimal   no-undo .
     1323     define variable v-change-sign           as integer   no-undo .
     1324     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1325     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1326     if p-change-value > 0
     1327     then do:
     1328       if frame v-coderg :height + p-change-value
     1329           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1330       then do:
     1331         assign
     1332           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1333                           - (frame v-coderg :height-chars)
     1334         .
     1335         if p-change-value <= 0
     1336         then do:
     1337           run diasize_position-resize-button in this-procedure .
     1338           return .
     1339         end.
     1340       end.
     1341     end.
     1342     if p-change-value < 0
     1343     then do:
     1344       if frame v-coderg :height + p-change-value < v-diasize-orig-frame-height
     1345       then do:
     1346         assign
     1347           p-change-value = v-diasize-orig-frame-height
     1348                          - (frame v-coderg :height-chars)
     1349         .
     1350         if p-change-value >= 0
     1351         then do:
     1352           run diasize_position-resize-button in this-procedure .
     1353           return .
     1354         end.
     1355       end.
     1356     end.
     1357     if p-change-value >= 0
     1358     then do:
     1359       assign
     1360         v-change-sign = 1
     1361       .
     1362     end.
     1363     else do:
     1364       assign
     1365         v-change-sign = -1
     1366       .
     1367     end.
     1368     assign
     1369       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1370     .
     1371     if p-change-value = 0
     1372     then do:
     1373       run diasize_position-resize-button in this-procedure .
     1374       return .
     1375     end.
     1376     move_block:
     1377     do
     1378     on error undo move_block, retry move_block
     1379     :
     1380       if retry
     1381       then do:
     1382         do
     1383         on error undo move_block, leave move_block
     1384         :
     1385           if p-change-value > 0
     1386           then do:
     1387             for each buf_temp-diasize-handle
     1388             on error undo, next
     1389             :
     1390               assign
     1391                 v-object-handle = buf_temp-diasize-handle.handle-value
     1392               .
     1393               if v-object-handle <> v-diasize-resize-button
     1394               then do:
     1395                 assign
     1396                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1397                 .
     1398               end.
     1399             end.
     1400             assign
     1401               v-diasize-browse-handle :height = v-browse-height
     1402             .
     1403             for each buf_temp-browse-handle
     1404               where buf_temp-browse-handle.browse-type = 'height':u
     1405             on error undo, next
     1406             :
     1407               assign
     1408                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1409               .
     1410             end.
     1411             assign
     1412               frame v-coderg :height = v-frame-height
     1413             .
     1414             if frame v-coderg :scrollable = true
     1415             then do:
     1416               assign
     1417                 frame v-coderg :virtual-height = v-frame-virtual-height
     1418               .
     1419             end.
     1420             run diasize_position-resize-button in this-procedure .
     1421           end.
     1422           else do:
     1423             if frame v-coderg :scrollable = true
     1424             then do:
     1425               assign
     1426                 frame v-coderg :virtual-height = v-frame-virtual-height
     1427               .
     1428             end.
     1429             assign
     1430               frame v-coderg :height = v-frame-height
     1431             .
     1432             assign
     1433               v-diasize-browse-handle :height = v-browse-height
     1434             .
     1435             for each buf_temp-browse-handle
     1436               where buf_temp-browse-handle.browse-type = 'height':u
     1437             on error undo, next
     1438             :
     1439               assign
     1440                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1441               .
     1442             end.
     1443             for each buf_temp-diasize-handle
     1444             on error undo, next
     1445             :
     1446               assign
     1447                 v-object-handle = buf_temp-diasize-handle.handle-value
     1448               .
     1449               if v-object-handle <> v-diasize-resize-button
     1450               then do:
     1451                 assign
     1452                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1453                 .
     1454               end.
     1455             end.
     1456             run diasize_position-resize-button in this-procedure .
     1457           end.
     1458           assign
     1459             v-diasize-change-size = false
     1460           .
     1461           leave move_block .
     1462         end.
     1463       end.
     1464       assign
     1465         v-diasize-need-full-display = true
     1466       .
     1467       if v-diasize-change-size = false
     1468       then do:
     1469         assign
     1470           v-diasize-change-size = true
     1471         .
     1472       end.
     1473       else do:
     1474         return .
     1475       end.
     1476       assign
     1477         v-frame-height = frame v-coderg :height
     1478         v-frame-virtual-height = frame v-coderg :virtual-height
     1479         v-browse-height = v-diasize-browse-handle :height
     1480       .
     1481       for each buf_temp-browse-handle
     1482         where buf_temp-browse-handle.browse-type = 'height':u
     1483       :
     1484         assign
     1485           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1486         .
     1487       end.
     1488       for each buf_temp-diasize-handle
     1489       :
     1490         delete buf_temp-diasize-handle .
     1491       end.
     1492       assign
     1493         v-field-group-handle = frame v-coderg :first-child
     1494       .
     1495       do while valid-handle(v-field-group-handle)
     1496       :
     1497         assign
     1498           v-object-handle = v-field-group-handle :first-child
     1499         .
     1500         do while valid-handle(v-object-handle)
     1501         :
     1502           if  v-object-handle <> v-diasize-browse-handle :handle
     1503           and can-query(v-object-handle, "row")
     1504           and can-query(v-object-handle, "height")
     1505           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1506           then do:
     1507             find first buf_temp-browse-handle
     1508               where buf_temp-browse-handle.browse-type   = 'height':u
     1509                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1510               no-error .
     1511             if available buf_temp-browse-handle
     1512             then do:
     1513             end.
     1514             else do:
     1515               create buf_temp-diasize-handle .
     1516               assign
     1517                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1518                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1519               .
     1520             end.
     1521           end.
     1522           assign
     1523             v-object-handle = v-object-handle :next-sibling
     1524           .
     1525         end.
     1526         assign
     1527           v-field-group-handle = v-field-group-handle :next-sibling
     1528         .
     1529       end.
     1530       do with frame v-coderg
     1531       :
     1532         hide v-diasize-resize-button .
     1533         assign
     1534           v-diasize-resize-button :row    = 1
     1535           v-diasize-resize-button :column = 1
     1536         .
     1537       end.
     1538       if p-change-value > 0
     1539       then do:
     1540         if frame v-coderg :scrollable = true
     1541         then do:
     1542           assign
     1543             frame v-coderg :virtual-height = frame v-coderg :virtual-height + p-change-value
     1544             no-error .
     1545           if error-status :error
     1546           or error-status :get-message(1) <> ""
     1547           then do:
     1548             undo move_block, retry move_block .
     1549           end.
     1550         end.
     1551         assign
     1552           frame v-coderg :height = frame v-coderg :height + p-change-value
     1553           no-error .
     1554         if error-status :error
     1555         or error-status :get-message(1) <> ""
     1556         then do:
     1557           undo move_block, retry move_block .
     1558         end.
     1559         assign
     1560           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1561           no-error .
     1562         if error-status :error
     1563         or error-status :get-message(1) <> ""
     1564         then do:
     1565           undo move_block, retry move_block .
     1566         end.
     1567         for each buf_temp-browse-handle
     1568           where buf_temp-browse-handle.browse-type = 'height':u
     1569         on error undo move_block, retry move_block
     1570         :
     1571           assign
     1572             buf_temp-browse-handle.browse-handle :height
     1573               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1574             no-error .
     1575           if error-status :error
     1576           or error-status :get-message(1) <> ""
     1577           then do:
     1578             undo move_block, retry move_block .
     1579           end.
     1580         end.
     1581         for each buf_temp-diasize-handle
     1582         on error undo move_block, retry move_block
     1583         :
     1584           assign
     1585             v-object-handle = buf_temp-diasize-handle.handle-value
     1586           .
     1587           if v-object-handle <> v-diasize-resize-button
     1588           then do:
     1589             assign
     1590               v-object-handle :row = v-object-handle :row + p-change-value
     1591               no-error .
     1592             if error-status :error
     1593             or error-status :get-message(1) <> ""
     1594             then do:
     1595               undo move_block, retry move_block .
     1596             end.
     1597           end.
     1598         end.
     1599       end.
     1600       else do:
     1601         for each buf_temp-diasize-handle
     1602         on error undo move_block, retry move_block
     1603         :
     1604           assign
     1605             v-object-handle = buf_temp-diasize-handle.handle-value
     1606           .
     1607           if v-object-handle <> v-diasize-resize-button
     1608           then do:
     1609             assign
     1610               v-object-handle :row = v-object-handle :row + p-change-value
     1611               no-error .
     1612             if error-status :error
     1613             or error-status :get-message(1) <> ""
     1614             then do:
     1615               undo move_block, retry move_block .
     1616             end.
     1617           end.
     1618         end.
     1619         assign
     1620           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1621           no-error .
     1622         if error-status :error
     1623         or error-status :get-message(1) <> ""
     1624         then do:
     1625           undo move_block, retry move_block .
     1626         end.
     1627         for each buf_temp-browse-handle
     1628           where buf_temp-browse-handle.browse-type = 'height':u
     1629         on error undo move_block, retry move_block
     1630         :
     1631           assign
     1632             buf_temp-browse-handle.browse-handle :height
     1633               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1634             no-error .
     1635           if error-status :error
     1636           or error-status :get-message(1) <> ""
     1637           then do:
     1638             undo move_block, retry move_block .
     1639           end.
     1640         end.
     1641         assign
     1642           frame v-coderg :height = frame v-coderg :height + p-change-value
     1643           no-error .
     1644         if error-status :error
     1645         or error-status :get-message(1) <> ""
     1646         then do:
     1647           undo move_block, retry move_block .
     1648         end.
     1649         if frame v-coderg :scrollable = true
     1650         then do:
     1651           assign
     1652             frame v-coderg :virtual-height = frame v-coderg :virtual-height + p-change-value
     1653             no-error .
     1654           if error-status :error
     1655           or error-status :get-message(1) <> ""
     1656           then do:
     1657             undo move_block, retry move_block .
     1658           end.
     1659         end.
     1660       end.
     1661       if p-move-resize = true
     1662       then do:
     1663         run diasize_position-resize-button in this-procedure .
     1664       end.
     1665       if v-diasize-wndstore = true
     1666       then do:
     1667         if connected("ub") = true
     1668         then do:
     1669           define variable v-cntxt-db-num        as integer   no-undo .
     1670           define variable v-cntxt-userid        as character no-undo .
     1671           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1672                                             , OUTPUT v-cntxt-userid
     1673                                             ) .
     1674           run gbl/wndsizew.p
     1675             (input  v-cntxt-db-num
     1676             ,input  v-cntxt-userid
     1677             ,input  v-diasize-proc-name
     1678             ,input  'height':u
     1679             ,input  string(frame v-coderg :height - v-diasize-orig-frame-height)
     1680             ) .
     1681         end.
     1682       end.
     1683     end.
     1684     assign
     1685       v-diasize-change-size = false
     1686     .
     1687   end procedure.
     1688   procedure diasize_set-height :
     1689     define input  parameter p-new-height  as decimal   no-undo .
     1690     define input  parameter p-move-resize as logical   no-undo .
     1691     do
     1692     on error undo, return error return-value
     1693     :
     1694       run diasize_change-height in this-procedure
     1695         (input  (p-new-height - frame v-coderg :height)
     1696         ,input  p-move-resize
     1697         ) .
     1698     end.
     1699   end procedure.
     1700   procedure diasize_change-width :
     1701     define input  parameter p-change-value as decimal   no-undo .
     1702     define input  parameter p-move-resize  as logical   no-undo .
     1703     define variable v-field-group-handle   as handle    no-undo .
     1704     define variable v-object-handle        as handle    no-undo .
     1705     define variable v-frame-width          as decimal   no-undo .
     1706     define variable v-frame-virtual-width  as decimal   no-undo .
     1707     define variable v-browse-width         as decimal   no-undo .
     1708     define variable v-window-width         as decimal   no-undo .
     1709     define variable v-window-virtual-width as decimal   no-undo .
     1710     define variable v-change-sign          as integer   no-undo .
     1711     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1712     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1713     if p-change-value > 0
     1714     then do:
     1715       if frame v-coderg :width + p-change-value >
     1716           session :width-chars
     1717       then do:
     1718         assign
     1719           p-change-value = session :width-chars - frame v-coderg :width
     1720         .
     1721         if p-change-value <= 0
     1722         then do:
     1723           run diasize_position-resize-button in this-procedure .
     1724           return .
     1725         end.
     1726       end.
     1727     end.
     1728     if p-change-value < 0
     1729     then do:
     1730       if frame v-coderg :width + p-change-value < v-diasize-orig-frame-width
     1731       then do:
     1732         assign
     1733           p-change-value = v-diasize-orig-frame-width
     1734                          - frame v-coderg :width
     1735         .
     1736         if p-change-value >= 0
     1737         then do:
     1738           run diasize_position-resize-button in this-procedure .
     1739           return .
     1740         end.
     1741       end.
     1742     end.
     1743     if p-change-value >= 0
     1744     then do:
     1745       assign
     1746         v-change-sign = 1
     1747       .
     1748     end.
     1749     else do:
     1750       assign
     1751         v-change-sign = -1
     1752       .
     1753     end.
     1754     assign
     1755       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1756     .
     1757     if p-change-value = 0
     1758     then do:
     1759       run diasize_position-resize-button in this-procedure .
     1760       return .
     1761     end.
     1762     move_block:
     1763     do
     1764     on error undo move_block, leave move_block
     1765     :
     1766       if retry
     1767       then do:
     1768         do
     1769         on error undo move_block, leave move_block
     1770         :
     1771           if p-change-value > 0
     1772           then do:
     1773             for each buf_temp-diasize-handle
     1774             on error undo, next
     1775             :
     1776               assign
     1777                 v-object-handle = buf_temp-diasize-handle.handle-value
     1778               .
     1779               if v-object-handle <> v-diasize-resize-button
     1780               then do:
     1781                 assign
     1782                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1783                 .
     1784               end.
     1785             end.
     1786             assign
     1787               v-diasize-browse-handle :width = v-browse-width
     1788             .
     1789             for each buf_temp-browse-handle
     1790               where buf_temp-browse-handle.browse-type = 'width':u
     1791             on error undo, next
     1792             :
     1793               assign
     1794                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1795               .
     1796             end.
     1797             assign
     1798               frame v-coderg :width = v-frame-width
     1799             .
     1800             if frame v-coderg :scrollable = true
     1801             then do:
     1802               assign
     1803                 frame v-coderg :virtual-width = v-frame-virtual-width
     1804               .
     1805             end.
     1806             run diasize_position-resize-button in this-procedure .
     1807           end.
     1808           else do:
     1809             if frame v-coderg :scrollable = true
     1810             then do:
     1811               assign
     1812                 frame v-coderg :virtual-width = v-frame-virtual-width
     1813               .
     1814             end.
     1815             assign
     1816               frame v-coderg :width = v-frame-width
     1817             .
     1818             for each buf_temp-browse-handle
     1819               where buf_temp-browse-handle.browse-type = 'width':u
     1820             on error undo, next
     1821             :
     1822               assign
     1823                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1824               .
     1825             end.
     1826             assign
     1827               v-diasize-browse-handle :width = v-browse-width
     1828             .
     1829             for each buf_temp-diasize-handle
     1830             on error undo, next
     1831             :
     1832               assign
     1833                 v-object-handle = buf_temp-diasize-handle.handle-value
     1834               .
     1835               if v-object-handle <> v-diasize-resize-button
     1836               then do:
     1837                 assign
     1838                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1839                 .
     1840               end.
     1841             end.
     1842             run diasize_position-resize-button in this-procedure .
     1843           end.
     1844           assign
     1845             v-diasize-change-size = false
     1846           .
     1847           leave move_block .
     1848         end.
     1849       end.
     1850       assign
     1851         v-diasize-need-full-display = true
     1852       .
     1853       if v-diasize-change-size = false
     1854       then do:
     1855         assign
     1856           v-diasize-change-size = true
     1857         .
     1858       end.
     1859       else do:
     1860         return .
     1861       end.
     1862       assign
     1863         v-frame-width = frame v-coderg :width
     1864         v-frame-virtual-width = frame v-coderg :virtual-width
     1865         v-browse-width = v-diasize-browse-handle :width
     1866       .
     1867       for each buf_temp-browse-handle
     1868         where buf_temp-browse-handle.browse-type = 'width':u
     1869       :
     1870         assign
     1871           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1872         .
     1873       end.
     1874       for each buf_temp-diasize-handle
     1875       :
     1876         delete buf_temp-diasize-handle .
     1877       end.
     1878       assign
     1879         v-field-group-handle = frame v-coderg :first-child
     1880       .
     1881       do while valid-handle(v-field-group-handle)
     1882       :
     1883         assign
     1884           v-object-handle = v-field-group-handle :first-child
     1885         .
     1886         do while valid-handle(v-object-handle)
     1887         :
     1888           if  v-object-handle <> v-diasize-browse-handle :handle
     1889           and v-object-handle <> v-diasize-resize-button
     1890           and can-query(v-object-handle, "row")
     1891           and can-query(v-object-handle, "height")
     1892           and ( v-object-handle :col + v-object-handle :width
     1893                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1894               )
     1895           then do:
     1896             find first buf_temp-browse-handle
     1897               where buf_temp-browse-handle.browse-type   = 'width':u
     1898                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1899               no-error .
     1900             if available buf_temp-browse-handle
     1901             then do:
     1902             end.
     1903             else do:
     1904               create buf_temp-diasize-handle .
     1905               assign
     1906                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1907                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1908               .
     1909             end.
     1910           end.
     1911           assign
     1912             v-object-handle = v-object-handle :next-sibling
     1913           .
     1914         end.
     1915         assign
     1916           v-field-group-handle = v-field-group-handle :next-sibling
     1917         .
     1918       end.
     1919       do with frame v-coderg
     1920       :
     1921         hide v-diasize-resize-button .
     1922         v-diasize-resize-button :row = 1.
     1923         v-diasize-resize-button :column = 1.
     1924       end.
     1925       if p-change-value > 0
     1926       then do:
     1927         if frame v-coderg :scrollable = true
     1928         then do:
     1929           assign
     1930             frame v-coderg :virtual-width = frame v-coderg :virtual-width + p-change-value
     1931             no-error .
     1932           if error-status :error
     1933           or error-status :get-message(1) <> ""
     1934           then do:
     1935             undo move_block, retry move_block.
     1936           end.
     1937         end.
     1938         assign
     1939           frame v-coderg :width = v-frame-width + p-change-value
     1940           no-error .
     1941         if error-status :error
     1942         or error-status :get-message(1) <> ""
     1943         then do:
     1944           undo move_block, retry move_block.
     1945         end.
     1946         assign
     1947           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1948         no-error .
     1949         if error-status :error
     1950         or error-status :get-message(1) <> ""
     1951         then do:
     1952           undo move_block, retry move_block.
     1953         end.
     1954         for each buf_temp-browse-handle
     1955           where buf_temp-browse-handle.browse-type = 'width':u
     1956         on error undo move_block, retry move_block
     1957         :
     1958           assign
     1959             buf_temp-browse-handle.browse-handle :width
     1960               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1961             no-error .
     1962           if error-status :error
     1963           or error-status :get-message(1) <> ""
     1964           then do:
     1965             undo move_block, retry move_block .
     1966           end.
     1967         end.
     1968         for each buf_temp-diasize-handle
     1969         on error undo move_block, retry move_block
     1970         :
     1971           assign
     1972             v-object-handle = buf_temp-diasize-handle.handle-value
     1973           .
     1974           if v-object-handle <> v-diasize-resize-button
     1975           then do:
     1976             assign
     1977               v-object-handle :col = v-object-handle :col + p-change-value
     1978               no-error .
     1979             if error-status :error
     1980             or error-status :get-message(1) <> ""
     1981             then do:
     1982               undo move_block, retry move_block .
     1983             end.
     1984           end.
     1985         end.
     1986       end.
     1987       else do:
     1988         for each buf_temp-diasize-handle
     1989         on error undo move_block, retry move_block
     1990         :
     1991           assign
     1992             v-object-handle = buf_temp-diasize-handle.handle-value
     1993           .
     1994           if v-object-handle <> v-diasize-resize-button
     1995           then do:
     1996             assign
     1997               v-object-handle :col = v-object-handle :col + p-change-value
     1998               no-error .
     1999             if error-status :error
     2000             or error-status :get-message(1) <> ""
     2001             then do:
     2002               undo move_block, retry move_block .
     2003             end.
     2004           end.
     2005         end.
     2006         for each buf_temp-browse-handle
     2007           where buf_temp-browse-handle.browse-type = 'width':u
     2008         on error undo move_block, retry move_block
     2009         :
     2010           assign
     2011             buf_temp-browse-handle.browse-handle :width
     2012               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2013             no-error .
     2014           if error-status :error
     2015           or error-status :get-message(1) <> ""
     2016           then do:
     2017             undo move_block, retry move_block .
     2018           end.
     2019         end.
     2020         assign
     2021           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2022           no-error .
     2023         if error-status :error
     2024         or error-status :get-message(1) <> ""
     2025         then do:
     2026           undo move_block, retry move_block.
     2027         end.
     2028         assign
     2029           frame v-coderg :width = frame v-coderg :width + p-change-value
     2030         no-error .
     2031         if error-status :error
     2032         or error-status :get-message(1) <> ""
     2033         then do:
     2034           undo move_block, retry move_block.
     2035         end.
     2036         if frame v-coderg :scrollable = true
     2037         then do:
     2038           assign
     2039             frame v-coderg :virtual-width = frame v-coderg :virtual-width + p-change-value
     2040           no-error .
     2041           if error-status :error
     2042           or error-status :get-message(1) <> ""
     2043           then do:
     2044             undo move_block, retry move_block.
     2045           end.
     2046         end.
     2047       end.
     2048       if p-move-resize
     2049       then do:
     2050         run diasize_position-resize-button in this-procedure .
     2051       end.
     2052       if v-diasize-wndstore = true
     2053       then do:
     2054         if connected("ub") = true
     2055         then do:
     2056           define variable v-cntxt-db-num        as integer   no-undo .
     2057           define variable v-cntxt-userid        as character no-undo .
     2058           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2059                                             , OUTPUT v-cntxt-userid
     2060                                             ) .
     2061           run gbl/wndsizew.p
     2062             (input  v-cntxt-db-num
     2063             ,input  v-cntxt-userid
     2064             ,input  v-diasize-proc-name
     2065             ,input  'width':u
     2066             ,input  string(frame v-coderg :width - v-diasize-orig-frame-width)
     2067             ) .
     2068         end.
     2069       end.
     2070     end.
     2071     assign
     2072       v-diasize-change-size = false
     2073     .
     2074   end procedure.
     2075   procedure diasize_set-width :
     2076     define input  parameter p-new-width  as decimal   no-undo .
     2077     define input  parameter p-move-resize as logical   no-undo .
     2078     do
     2079     on error undo, return error return-value
     2080     :
     2081       run diasize_change-width in this-procedure
     2082         (input  (p-new-width - frame v-coderg :width)
     2083         ,input  p-move-resize
     2084         ) .
     2085     end.
     2086   end procedure.
     2087   procedure diasize_position-resize-button :
     2088     do with frame v-coderg
     2089     :
     2090       hide v-diasize-resize-button .
     2091       assign
     2092         v-diasize-resize-button :row = frame v-coderg :height - v-diasize-resize-button :height
     2093                     - 1
     2094                     - (frame v-coderg :border-bottom-pixels / session :pixels-per-row)
     2095         v-diasize-resize-button :col = frame v-coderg :width - v-diasize-resize-button :width
     2096                     - 1
     2097                     - (frame v-coderg :border-right-pixels / session :pixels-per-column)
     2098       .
     2099       view v-diasize-resize-button .
     2100     end.
     2101   end procedure.
     2102   on alt-right anywhere
     2103   do:
     2104     run diasize_change-width in this-procedure
     2105       (input 1
     2106       ,input true
     2107       ) .
     2108     return no-apply .
     2109   end.
     2110   on alt-left anywhere
     2111   do:
     2112     run diasize_change-width in this-procedure
     2113       (input -1
     2114       ,input true
     2115       ) .
     2116     return no-apply .
     2117   end.
     2118   on alt-down anywhere
     2119   do:
     2120     run diasize_change-height in this-procedure
     2121       (input 1
     2122       ,input true
     2123       ) .
     2124     return no-apply .
     2125   end.
     2126   on alt-up anywhere
     2127   do:
     2128     run diasize_change-height in this-procedure
     2129       (input -1
     2130       ,input true
     2131       ) .
     2132     return no-apply .
     2133   end.
     2134   on alt-enter of frame v-coderg
     2135   do:
     2136     run diasize_maximize in this-procedure
     2137       (input  ?
     2138       ).
     2139     return no-apply .
     2140   end.
     2141   procedure diasize_end-move :
     2142     do
     2143     on error undo, return error return-value
     2144     :
     2145       define variable v-row-delta as decimal   no-undo .
     2146       define variable v-col-delta as decimal   no-undo .
     2147       define variable v-new-row as decimal   no-undo .
     2148       define variable v-new-col as decimal   no-undo .
     2149       assign
     2150         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2151         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2152       .
     2153       assign
     2154         v-row-delta = v-new-row - frame v-coderg :height
     2155         v-col-delta = v-new-col - frame v-coderg :width
     2156       .
     2157       run diasize_change-height in this-procedure
     2158         (input v-row-delta
     2159         ,input true
     2160         ) .
     2161       run diasize_change-width in this-procedure
     2162         (input v-col-delta
     2163         ,input true
     2164         ) .
     2165     end.
     2166   end procedure.
     2167   procedure diasize_maximize :
     2168     define input  parameter p-action as logical   no-undo .
     2169     do
     2170     on error undo, return error return-value
     2171     :
     2172       if p-action = ?
     2173       then do:
     2174         if v-diasize-need-maximize = true
     2175         then do:
     2176           assign
     2177             p-action = true
     2178           .
     2179         end.
     2180         else do:
     2181           assign
     2182             p-action = false
     2183           .
     2184         end.
     2185       end.
     2186       if p-action = true
     2187       then do:
     2188         run diasize_change-height in this-procedure
     2189           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2190               - frame v-coderg :height-chars
     2191           ,input true
     2192           ) .
     2193         run diasize_change-width in this-procedure
     2194           (input session :width-chars
     2195               - frame v-coderg :width-chars
     2196           ,input true
     2197           ) .
     2198         assign
     2199           v-diasize-need-maximize = false
     2200         .
     2201       end.
     2202       else do:
     2203         run diasize_change-width in this-procedure
     2204           (input v-diasize-orig-frame-width
     2205               - frame v-coderg :width-chars
     2206           ,input true
     2207           ) .
     2208         run diasize_change-height in this-procedure
     2209           (input v-diasize-orig-frame-height
     2210               - frame v-coderg :height-chars
     2211           ,input true
     2212           ) .
     2213         assign
     2214           v-diasize-need-maximize = true
     2215         .
     2216       end.
     2217     end.
     2218   end procedure.
     2219   procedure diasize_restore-orig-size :
     2220     do
     2221     on error undo, return error return-value
     2222     :
     2223       assign
     2224         v-diasize-current-frame-width  = frame v-coderg :width
     2225         v-diasize-current-frame-height = frame v-coderg :height
     2226       .
     2227       run diasize_set-height in this-procedure
     2228         (input  v-diasize-orig-frame-height
     2229         ,input  true
     2230         ) .
     2231       run diasize_set-width in this-procedure
     2232         (input  v-diasize-orig-frame-width
     2233         ,input  true
     2234         ) .
     2235     end.
     2236   end procedure.
     2237   procedure diasize_restore-current-size :
     2238     do
     2239     on error undo, return error return-value
     2240     :
     2241       run diasize_set-height in this-procedure
     2242         (input  v-diasize-current-frame-height
     2243         ,input  true
     2244         ) .
     2245       run diasize_set-width in this-procedure
     2246         (input  v-diasize-current-frame-width
     2247         ,input  true
     2248         ) .
     2249     end.
     2250   end procedure.
     2251   procedure diasize_set-browse-handle :
     2252     define input  parameter p-browse-handle as handle   no-undo .
     2253     define buffer buf_temp-browse-handle for temp-browse-handle .
     2254     do
     2255     on error undo, return error return-value
     2256     :
     2257       assign
     2258         v-diasize-browse-handle = p-browse-handle
     2259       .
     2260       for each buf_temp-browse-handle
     2261       on error undo, return error return-value
     2262       :
     2263         delete buf_temp-browse-handle .
     2264       end.
     2265     end.
     2266   end procedure.
     2267   procedure diasize_add_browse :
     2268     define input  parameter p-browse-type   as character no-undo .
     2269     define input  parameter p-browse-handle as handle    no-undo .
     2270     define buffer buf_temp-browse-handle for temp-browse-handle .
     2271     do
     2272     on error undo, return error return-value
     2273     :
     2274       assign
     2275         v-diasize-browse-number = v-diasize-browse-number + 1
     2276       .
     2277       create buf_temp-browse-handle .
     2278       assign
     2279         buf_temp-browse-handle.browse-type   = p-browse-type
     2280         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2281         buf_temp-browse-handle.browse-handle = p-browse-handle
     2282       .
     2283     end.
     2284   end procedure.
     2285   procedure diasize_init :
     2286     define variable v-default-value    as logical   no-undo .
     2287     define variable v-restore-saved    as logical   no-undo .
     2288     define variable v-resize-value-str as character no-undo .
     2289     do
     2290     on error undo, return error return-value
     2291     :
     2292       do with frame v-coderg
     2293       :
     2294         assign
     2295           v-diasize-orig-frame-height = frame v-coderg :height
     2296           v-diasize-orig-frame-width  = frame v-coderg :width
     2297           v-diasize-browse-handle     = browse BROWSE-1 :handle
     2298         .
     2299         create button v-diasize-resize-button
     2300         assign
     2301           parent        = frame v-coderg :first-child
     2302           label         = "s"
     2303           height-pixels = 16
     2304           width-pixels  = 16
     2305           visible       = true
     2306           sensitive     = true
     2307           movable       = true
     2308           triggers:
     2309             on end-move persistent run diasize_end-move in this-procedure .
     2310           end triggers.
     2311         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2312         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2313         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2314         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2315         assign
     2316           v-diasize-wndmax = false
     2317         .
     2318         if connected("ub") = true
     2319         then do:
     2320           define variable v-cntxt-db-num        as integer   no-undo .
     2321           define variable v-cntxt-userid        as character no-undo .
     2322           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2323                                             , OUTPUT v-cntxt-userid
     2324                                             ) .
     2325           run gbl/wndpar_r.p
     2326             (input  v-cntxt-db-num
     2327             ,input  v-cntxt-userid
     2328             ,input  'wndmax':U
     2329             ,output v-diasize-wndmax
     2330             ,output v-default-value
     2331             ) .
     2332         end.
     2333         assign
     2334           v-diasize-wndstore = false
     2335         .
     2336         if connected("ub") = true
     2337         then do:
     2338           run gbl/wndpar_r.p
     2339             (input  v-cntxt-db-num
     2340             ,input  v-cntxt-userid
     2341             ,input  'wndstore':U
     2342             ,output v-diasize-wndstore
     2343             ,output v-default-value
     2344             ) .
     2345         end.
     2346         assign
     2347           v-diasize-proc-name = entry(1, program-name(2), '.')
     2348         .
     2349         if v-diasize-wndstore = true
     2350         then do:
     2351           assign
     2352             v-restore-saved = false
     2353           .
     2354           if connected("ub") = true
     2355           then do:
     2356             run gbl/wndsizer.p
     2357               (input  v-cntxt-db-num
     2358               ,input  v-cntxt-userid
     2359               ,input  v-diasize-proc-name
     2360               ,input  'height':u
     2361               ,output v-resize-value-str
     2362               ) .
     2363             if v-resize-value-str <> '':U
     2364             then do:
     2365               run diasize_change-height in this-procedure
     2366                 (input  integer(v-resize-value-str)
     2367                 ,input  true
     2368                 ) .
     2369               assign
     2370                 v-restore-saved = true
     2371               .
     2372             end.
     2373           end.
     2374           if connected("ub") = true
     2375           then do:
     2376             run gbl/wndsizer.p
     2377               (input  v-cntxt-db-num
     2378               ,input  v-cntxt-userid
     2379               ,input  v-diasize-proc-name
     2380               ,input  'width':u
     2381               ,output v-resize-value-str
     2382               ) .
     2383             if v-resize-value-str <> '':U
     2384             then do:
     2385               run diasize_change-width in this-procedure
     2386                 (input  integer(v-resize-value-str)
     2387                 ,input  true
     2388                 ) .
     2389               assign
     2390                 v-restore-saved = true
     2391               .
     2392             end.
     2393           end.
     2394           if v-restore-saved <> true
     2395           then do:
     2396             if v-diasize-wndmax = true
     2397             then do:
     2398               run diasize_maximize in this-procedure
     2399                 (input  true
     2400                 ) .
     2401             end.
     2402           end.
     2403         end.
     2404         else do:
     2405           if v-diasize-wndmax = true
     2406           then do:
     2407             run diasize_maximize in this-procedure
     2408               (input  true
     2409               ) .
     2410           end.
     2411         end.
     2412       end.
     2413     end.
     2414   end procedure.
     2415   procedure diasize_need-full-display :
     2416     define output parameter p-need-full-display as logical   no-undo .
     2417     do
     2418     on error undo, return error return-value
     2419     :
     2420       assign
     2421         p-need-full-display = v-diasize-need-full-display
     2422       .
     2423       assign
     2424         v-diasize-need-full-display = false
     2425       .
     2426     end.
     2427   end procedure.
     2428   procedure get-context :
     2429      define output parameter p-db-num as integer          no-undo.
     2430      define output parameter p-user-id as character        no-undo.
     2431      define variable v-login               as character    no-undo.
     2432      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2433      define buffer buf_user-login  for ub.user-login .
     2434      do
     2435      on error undo, return error
     2436      :
     2437            FIND FIRST buf_sys-ctrl no-lock.
     2438            ASSIGN
     2439               v-login = USERID("ub")
     2440               p-db-num = buf_sys-ctrl.db-num
     2441            .
     2442            FIND FIRST buf_user-login
     2443                 WHERE buf_user-login.db-num = p-db-num
     2444                   AND buf_user-login.user-login = v-login
     2445                 no-lock
     2446                 no-error
     2447                 .
     2448            IF AVAILABLE buf_user-login
     2449            THEN DO:
     2450               assign
     2451                  p-user-id = buf_user-login.user-id
     2452               .
     2453            END.
     2454      end.
     2455   end procedure.
     2456       run diasize_init in this-procedure .
     2457   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-coderg:PARENT eq ?
     2458   THEN FRAME v-coderg:PARENT = ACTIVE-WINDOW.
     2459   MAIN-BLOCK:
     2460   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2461      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2462     define buffer buf_sys-ctrl for ub.sys-ctrl .
     2463     find first buf_sys-ctrl no-lock .
     2464     assign
     2465       v-curr-db = buf_sys-ctrl.db-num
     2466     .
     2467     if p-db-num = ? then do:
     2468       assign
     2469         p-db-num = 0
     2470       .
     2471       assign
     2472         FRAME v-coderg:title = substitute( "Диапазоны &1 в БД &2", p-type-code, v-curr-db )
     2473       .
     2474     end.
     2475     else do:
     2476       assign
     2477         FRAME v-coderg:title = substitute( "Диапазоны &1 для БД &2 в БД &3", p-type-code, p-db-num, v-curr-db )
     2478       .
     2479     end.
     2480     RUN enable_UI.
     2481     case p-range-type:
     2482       when 'sclc':U
     2483       or when 'pglc':U then do:
     2484         if v-curr-db = 0 then do:
     2485           enable
     2486           b-del
     2487           with frame v-coderg .
     2488         end.
     2489         else do:
     2490           disable
     2491           b-del
     2492           with frame v-coderg .
     2493         end.
     2494       end.
     2495       otherwise do:
     2496         disable
     2497         b-del
     2498         with frame v-coderg .
     2499       end.
     2500     end case.
     2501     WAIT-FOR GO OF FRAME v-coderg focus browse BROWSE-1.
     2502   END.
     2503   RUN disable_UI.
     2504   PROCEDURE disable_UI :
     2505     HIDE FRAME v-coderg.
     2506   END PROCEDURE.
     2507   PROCEDURE enable_UI :
     2508     ENABLE b-quit b-viewcode b-crush b-del b-help BROWSE-1
     2509         WITH FRAME v-coderg.
     2510     VIEW FRAME v-coderg.
     2511     OPEN QUERY BROWSE-1 FOR EACH ub.code-range       WHERE code-range.db-num = p-db-num  AND code-range.range-type = p-range-type NO-LOCK     BY ub.code-range.first-code.
     2512   END PROCEDURE.
     2513   PROCEDURE proc-b-del :
     2514   define variable v-key-rec as character no-undo .
     2515   define variable glog as logical no-undo .
     2516   define variable v-param as character no-undo .
     2517   define variable v-rowid as rowid no-undo .
     2518   define buffer buf_code-range for ub.code-range.
     2519   define buffer buf_route for ub.route.
     2520   if not available ub.code-range then do:
     2521     message
     2522     "Не определен диапазон!"
     2523     view-as alert-box error .
     2524     undo, return error .
     2525   end.
     2526   v-rowid = rowid(ub.code-range).
     2527   find first buf_code-range share-lock where
     2528         buf_code-range.first-code = ub.code-range.first-code no-error.
     2529   if not available buf_code-range then do:
     2530     message
     2531     substitute("Диапазон кодов с типом &1 для БД &2 (&3-&4) уже недоступен&5ОБНОВИТЕ ДАННЫЕ (выберите тип диапазона еще раз)"
     2532                ,p-range-type
     2533                ,ub.code-range.db-num
     2534                ,ub.code-range.first-code
     2535                ,ub.code-range.last-code
     2536                , chr(10)
     2537                )
     2538     view-as alert-box error .
     2539     undo, return error .
     2540   end.
     2541   if not (p-db-num = buf_code-range.db-num
     2542           and
     2543           integer(ub.code-range.last-code:screen-value in browse browse-1) = buf_code-range.last-code) then do:
     2544     message
     2545     substitute("Диапазон кодов с типом &1 для БД &2 (&3-&4) уже изменился&5ОБНОВИТЕ ДАННЫЕ (выберите тип диапазона еще раз)"
     2546                ,p-range-type
     2547                ,ub.code-range.db-num
     2548                ,ub.code-range.first-code
     2549                ,ub.code-range.last-code
     2550                , chr(10)
     2551                )
     2552     view-as alert-box error .
     2553     undo, return error .
     2554   end.
     2555   case p-range-type :
     2556     when 'sclc':U
     2557     or when 'pglc':U then do:
     2558       run gen-key-rec in this-procedure  ( input 'code-range':U
     2559                                             ,input ( buffer buf_code-range:handle )
     2560                                             ,output v-key-rec
     2561                                           ) no-error.
     2562       assign
     2563       v-param = buf_code-range.range-type + chr(4)  +
     2564                 string(buf_code-range.first-code) + chr(4) +
     2565                 string(buf_code-range.last-code) + chr(4) +
     2566                 buf_code-range.stts + chr(4) +
     2567                 string(buf_code-range.db-num) + chr(4) +
     2568                 buf_code-range.ps
     2569     .
     2570     if v-curr-db > 0 then do:
     2571         find first buf_route no-lock where
     2572                   buf_route.name-rec = ("command":U + chr(1)
     2573                                         + "inquiry-two-commit":U + chr(1)
     2574                                         + 'delete_code-range':U + chr(1)
     2575                                         + v-key-rec + chr(1)
     2576                                         + v-param) no-error.
     2577         if available buf_route then do:
     2578           message
     2579           substitute("Команда <Запуск удаления диапазона с типом &1 для БД &2 (&3-&4) из ГБД> уже отослана"
     2580                     , buf_code-range.range-type
     2581                     , buf_code-range.db-num
     2582                     , buf_code-range.first-code
     2583                     , buf_code-range.last-code
     2584                     )
     2585           view-as alert-box warning.
     2586           return .
     2587         end.
     2588       end.
     2589       message
     2590       substitute("Удалить диапазон с типом &1 для БД &2 (&3-&4)?"
     2591                     , buf_code-range.range-type
     2592                     , buf_code-range.db-num
     2593                     , buf_code-range.first-code
     2594                     , buf_code-range.last-code
     2595                     ) skip(0)
     2596     (if v-curr-db = 0
     2597      then  substitute("(удаление будет проведено только после подтверждения от всех БД)")
     2598      else  substitute("(Будет отослана в ГБД команда <Запуск удаления диапазона из ГБД>)")
     2599      ) skip(0)
     2600       view-as alert-box question buttons OK-Cancel update glog.
     2601       if not glog then return.
     2602       if can-find(first ub.db no-lock where ub.db.db-num > 0 ) then do:
     2603         run nws/db-rec.p ( input 'delete_code-range':U
     2604                       ,input v-key-rec
     2605                       ,input v-param
     2606                     ) no-error .
     2607         if not error-status:error
     2608         and return-value = "":U
     2609         then do:
     2610         end.
     2611         else do:
     2612           message
     2613           "Не удается послать на все БД команду удаления диапазона" skip
     2614           string(if error-status:error
     2615           then (error-status:get-message(1) + chr(10) + return-value )
     2616           else return-value )
     2617           view-as alert-box error .
     2618         end.
     2619       end.
     2620     end.
     2621     otherwise do:
     2622       message
     2623       "НЕ РАЗРЕШЕНО УДАЛЕНИЕ ТАКИХ ДИАПАЗОНОВ!!!"
     2624       view-as alert-box error .
     2625       undo, return error .
     2626     end.
     2627   end case.
     2628   OPEN QUERY BROWSE-1 FOR EACH ub.code-range       WHERE code-range.db-num = p-db-num  AND code-range.range-type = p-range-type NO-LOCK     BY ub.code-range.first-code.
     2629   reposition BROWSE-1 to rowid v-rowid .
     2630   END PROCEDURE.
