      935                     buf-recalc-cli-doc.out-sum-rubl = buf-recalc-cli-doc.out-sum-rubl + tt-parts-cli-doc.out-sum-rubl
      936                     buf-recalc-cli-doc.out-sum-base = buf-recalc-cli-doc.out-sum-base + tt-parts-cli-doc.out-sum-base
      937                     buf-recalc-cli-doc.in-qnty       = buf-recalc-cli-doc.in-qnty + tt-parts-cli-doc.in-qnty
      938                     buf-recalc-cli-doc.in-sum-rubl = buf-recalc-cli-doc.in-sum-rubl + tt-parts-cli-doc.in-sum-rubl
      939                     buf-recalc-cli-doc.in-sum-base = buf-recalc-cli-doc.in-sum-base + tt-parts-cli-doc.in-sum-base
      940                     .
