        1   block-level on error undo, throw.
        2   define input parameter parobj-type like ub.clients.obj-type no-undo.
        3   define input parameter parobj-code like ub.clients.obj-code no-undo.
        4   define input parameter par-date as date no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: rclarhwth.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/rclarhwth.p $":U .
       10   define variable vss-description as character no-undo init "Пересчет архивов МЦ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define variable v-waitfram-action01         as character   no-undo .
       82   define variable v-waitfram-action02         as character   no-undo .
       83   define variable v-waitfram-action03         as character   no-undo .
       84   define variable mWaitFramTextBeg            as character   no-undo.
       85   define variable mWaitFramTextEnd            as character   no-undo.
       86   define variable mWaitFramView               as logical     no-undo.
       87   define variable mWaitProcEvent              as logical     no-undo init yes.
       88   define variable mWaitFramInterval           as integer     no-undo init 1 .
       89   define variable mWaitFramStop               as logical     no-undo.
       90   define variable mWaitFramStopUser           as logical     no-undo.
       91   define variable mWaitFramStopTimeOut        as logical     no-undo.
       92   define variable mWaitFramStartProc          as datetime-tz no-undo.
       93   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       94   define button B-WaitFramStop auto-end-key
       95        label "Стоп"
       96        size 10 by 1 tooltip "Остоновить процесс".
       97   define button B-viewProcInfo
       98        label "Информация"
       99        size 15 by 1 tooltip "Информация о процесс".
      100   define frame waitfram
      101     v-waitfram-action01 format "x(72)" no-label skip
      102     v-waitfram-action02 format "x(72)" no-label skip
      103     v-waitfram-action03 format "x(72)" no-label skip
      104     B-viewProcInfo
      105     B-WaitFramStop at row 4 col 30
      106     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      107     .
      108   define new global shared variable mBatchMode as logical no-undo init ?.
      109   define variable mFramBachModHandle as handle no-undo.
      110   mFramBachModHandle = frame waitfram:handle.
      111   define variable mFameOldVis as logical no-undo.
      112   define variable mVisCUrentVin as logical no-undo.
      113   if session:batch-mode
      114   then
      115      mBatchMode = yes.
      116   if mBatchMode = ? then do:
      117     mVisCUrentVin = current-window:visible.
      118     mFameOldVis = mFramBachModHandle:visible.
      119     mFramBachModHandle:visible  = yes.
      120     mBatchMode = mFramBachModHandle:visible ne yes.
      121     mFramBachModHandle:visible = mFameOldVis.
      122     current-window:visible = mVisCUrentVin.
      123   end.
      124    if  log-manager:logfile-name ne ?
      125     then DO:
      126         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      127         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      128         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      129     end.
      130   on choose of B-WaitFramStop in frame waitfram
      131   do:
      132     mWaitFramStop = yes.
      133     mWaitFramStopUser = yes.
      134   end.
      135   function waitfram-check-timeout returns logical():
      136      define variable vtime as int64 no-undo.
      137      if mWaitFramStopTimeOut
      138      then
      139         return yes.
      140      vtime = ( now - mWaitFramStartProc ) / 1000 .
      141      if     mWaitFramTimeOut ne ?
      142         and mWaitFramTimeOut ne 0
      143         and mWaitFramTimeOut lt vtime
      144      then do:
      145         mWaitFramStopTimeOut = yes.
      146      end.
      147      return mWaitFramStopTimeOut.
      148   end.
      149   procedure waitfram-hide :
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       pause 0 before-hide .
      155       if not mBatchMode then
      156         hide frame waitfram .
      157     if     not mWaitFramView
      158        and mWaitProcEvent
      159     then
      160       process events .
      161     end.
      162   end procedure.
      163   procedure waitfram-show :
      164     define input  parameter p-message as character no-undo .
      165     define variable v-left-margin as integer   no-undo .
      166     if not session:batch-mode
      167     then do
      168     on error undo, return error return-value
      169     :
      170       if length(p-message) <= 70 then do:
      171         assign
      172           v-left-margin = integer((70 - length(p-message)) / 2)
      173         .
      174         assign
      175           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      176         .
      177         assign
      178           v-waitfram-action01 = " "
      179           v-waitfram-action02 = " "
      180                                    + fill(" ", v-left-margin)
      181                                    + p-message
      182           v-waitfram-action03 = " "
      183         .
      184       end.
      185       else do:
      186         define variable vRindex1 as integer no-undo.
      187         define variable vRindex2 as integer no-undo.
      188         vRindex1 = r-index(p-message," ",70).
      189         if vRindex1 = 0
      190         then
      191            vRindex1 = 70.
      192         if length(p-message)  <= vRindex1 + 70 then do:
      193           assign
      194             v-waitfram-action01 = " "
      195             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      197           .
      198         end.
      199         else do:
      200           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      201           if vRindex2 <= vRindex1
      202           then
      203              vRindex2 = vRindex1 + 70.
      204           assign
      205             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      206             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      207             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      208           .
      209         end.
      210       end.
      211       B-viewProcInfo:visible   in frame waitfram = no.
      212       B-viewProcInfo:sensitive in frame waitfram = no.
      213       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      215       if  (   mWaitFramView
      216          or  mWaitProcEvent)
      217          and not mBatchMode
      218       then
      219          display
      220             v-waitfram-action01 skip
      221             v-waitfram-action02 skip
      222             v-waitfram-action03 skip
      223          with frame waitfram .
      224       if     mWaitFramView
      225          then do:
      226             if     mWaitFramInterval ne ?
      227                and not mBatchMode
      228             then
      229                wait-for go of frame waitfram pause mWaitFramInterval.
      230          end.
      231          else
      232             if     mWaitProcEvent
      233                and not mBatchMode
      234             then
      235                process events .
      236     end.
      237   end procedure.
      238      procedure waitfram-show-this:
      239         define input  parameter iInterval as int64 no-undo.
      240         define variable vtime as int64 no-undo.
      241         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      242         mWaitFramInterval = iInterval.
      243         run waitfram-show (substitute("&1&2 &3&4" ,
      244                                       mWaitFramTextBeg ,
      245                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      246                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      247                                       mWaitFramTextEnd
      248                                      )
      249                           ).
      250      end.
      251      procedure WaitFramRunPause:
      252         define input  parameter iInterval as dec no-undo.
      253         define variable vStart  as datetime-tz no-undo.
      254         define variable vend    as datetime-tz no-undo.
      255         define variable vint as int64 no-undo.
      256         define variable vOk as logical no-undo.
      257         vStart = now.
      258         vend   = vStart.
      259         publish "WaitFramPause" (iInterval,output vOk).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and (   vint > 0
      265                 or (    not vOk
      266                     and iInterval eq ?
      267                     )
      268                 )
      269         then
      270            run waitfram-show-this (iInterval).
      271         vend   =  now.
      272         vint = vend - vStart.
      273         vint = iInterval - vint / 1000.
      274         if     not mWaitFramStop
      275            and vint > 0
      276         then do:
      277            run gbl/pause.p (vint * 1000).
      278         end.
      279         if iInterval ne ?
      280         then
      281            publish "WaitFramStop".
      282         waitfram-check-timeout().
      283      end.
      284      procedure WaitFramWaitFor:
      285         define input  parameter iInterval as dec no-undo.
      286         assign
      287            mWaitFramStartProc   = now
      288            mWaitFramStopUser    = no
      289            mWaitFramStopTimeOut = no
      290         .
      291         block-wait:
      292         do while not mWaitFramStop:
      293            run WaitFramRunPause (iInterval).
      294            if  waitfram-check-timeout()
      295            then do:
      296               leave block-wait.
      297            end.
      298         end.
      299         run waitfram-hide.
      300      end.
      301   procedure waitfram-join :
      302     define input  parameter p-line-1  as character no-undo .
      303     define input  parameter p-line-2  as character no-undo .
      304     define input  parameter p-line-3  as character no-undo .
      305     define output parameter p-message as character no-undo .
      306     do
      307     on error undo, return error return-value
      308     :
      309       assign
      310         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      312                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      313       .
      314     end.
      315   end procedure.
      316   function waitfram-join-function returns character
      317     (input p-line-1 as character
      318     ,input p-line-2 as character
      319     ,input p-line-3 as character
      320     ).
      321     define variable v-message as character no-undo .
      322     run waitfram-join in this-procedure
      323       (input  p-line-1
      324       ,input  p-line-2
      325       ,input  p-line-3
      326       ,output v-message
      327       ) .
      328     return v-message .
      329   end function .
      330   define temp-table tt-parts-cli    no-undo like ub.arh-wth-cli
      331    .
      332   define temp-table tt-parts-cli-tot    no-undo like ub.arh-wth-cli-tot
      333    .
      334   define temp-table tt-parts-cli-doc no-undo like ub.arh-wth-cli-doc
      335   .
      336   define temp-table tt-parts-tot    no-undo like ub.arh-wth-tot.
      337   define temp-table tt-parts-wp     no-undo like ub.arh-wth-w-p.
      338   define buffer buf-prev_arh-wth-cli   for ub.arh-wth-cli.
      339   define buffer buf-arh-wth-cli        for ub.arh-wth-cli.
      340   define buffer buf-recalc-cli         for ub.arh-wth-cli.
      341   define buffer buf-prev_arh-wth-cli-doc   for ub.arh-wth-cli-doc.
      342   define buffer buf-arh-wth-cli-doc    for ub.arh-wth-cli-doc.
      343   define buffer buf-recalc-cli-doc     for ub.arh-wth-cli-doc.
      344   define buffer buf-prev_arh-wth-tot   for ub.arh-wth-tot.
      345   define buffer buf-arh-wth-tot        for ub.arh-wth-tot.
      346   define buffer buf-recalc-tot         for ub.arh-wth-tot.
      347   define buffer buf-prev_arh-wth-wp    for ub.arh-wth-w-p.
      348   define buffer buf-arh-wth-wp         for ub.arh-wth-w-p.
      349   define buffer buf-recalc-wp          for ub.arh-wth-w-p.
      350   define buffer buf-arh_wth-doc        for ub.wth-doc.
      351   define buffer buf-prev_arh-wth-cli-tot   for ub.arh-wth-cli-tot.
      352   define buffer buf-arh-wth-cli-tot        for ub.arh-wth-cli-tot.
      353   define buffer buf-recalc-cli-tot         for ub.arh-wth-cli-tot.
      354   procedure wth-arh-mode:
      355     define input  parameter parext-doc-type like ub.wth-doc.ext-doc-type no-undo.
      356     define input  parameter pardoc-code like ub.wth-doc.doc-code no-undo.
      357     define output parameter parinc-exp      as   integer                 no-undo.
      358     define buffer buf_wth-parts   for ub.wth-parts.
      359     case parext-doc-type:
      360       when 'ee':U
      361       or when 'pc':U
      362       or when 'ps':U
      363       or when 'pz':U
      364       or when 'dc':U
      365       or when 'xc':U
      366       then do:
      367         if can-find(first buf_wth-parts where buf_wth-parts.out-code = pardoc-code)
      368         then parinc-exp = 1.
      369         else parinc-exp = 0.
      370       end.
      371     end case.
      372   end procedure.
      373    procedure wth-arh-calctt-loc:
      374     define input parameter pardoc-code as char no-undo.
      375     define input parameter par-lock as log no-undo.
      376     define var vararh-mode as int no-undo.
      377     define buffer buf_wth-parts   for ub.wth-parts.
      378     define variable v-cli-type    as character    no-undo.
      379     define variable v-cli-code    as integer      no-undo.
      380     define variable v-zone        as character    no-undo.
      381     do on error undo, return error substitute ("Создание архивов по документу &4 &1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2),pardoc-code) :
      382     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
      383     if not available buf-arh_wth-doc then do:
      384       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
      385     end.
      386     run wth-arh-mode(input buf-arh_wth-doc.ext-doc-type
      387             ,input buf-arh_wth-doc.doc-code
      388             ,output vararh-mode).
      389     empty temp-table tt-parts-cli.
      390     empty temp-table tt-parts-cli-tot.
      391     empty temp-table tt-parts-wp.
      392     empty temp-table tt-parts-cli-doc.
      393     empty temp-table tt-parts-tot   .
      394     for each buf_wth-parts no-lock where
      395              buf_wth-parts.out-code = pardoc-code
      396          and buf_wth-parts.stts = 0 :
      397      if  not g#news
      398          or (g#news and  g#db-num  = 0)
      399      then do:
      400         find first tt-parts-tot where
      401                   tt-parts-tot.wth-code = buf_wth-parts.wth-code
      402               and tt-parts-tot.par-code = buf_wth-parts.par-code
      403               and tt-parts-tot.obj-type = buf_wth-parts.obj-type
      404               and tt-parts-tot.obj-code = buf_wth-parts.obj-code
      405               and tt-parts-tot.ext-doc-type = buf_wth-parts.ext-doc-type
      406               and tt-parts-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
      407               no-error.
      408         if not available tt-parts-tot then do:
      409           create tt-parts-tot.
      410           assign tt-parts-tot.wth-code = buf_wth-parts.wth-code
      411                 tt-parts-tot.par-code = buf_wth-parts.par-code
      412                 tt-parts-tot.gds-code = buf_wth-parts.gds-code
      413                 tt-parts-tot.w-p-code = buf_wth-parts.w-p-code
      414                 tt-parts-tot.obj-type = buf_wth-parts.obj-type
      415                 tt-parts-tot.obj-code = buf_wth-parts.obj-code
      416                 tt-parts-tot.ext-doc-type = buf_wth-parts.ext-doc-type
      417                 tt-parts-tot.doc-code = buf_wth-parts.out-code
      418                 tt-parts-tot.host-code = buf_wth-parts.host-code
      419                 tt-parts-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
      420           .
      421         end.
      422         if buf-arh_wth-doc.doc-type = 'при':U or (buf-arh_wth-doc.doc-type = 'обмен':U and  buf_wth-parts.type = 'при':U) or  buf_wth-parts.type = 'возврат':U then      assign tt-parts-tot.in-qnty     = tt-parts-tot.in-qnty     + buf_wth-parts.fact-qnty            tt-parts-tot.in-sum-rubl = tt-parts-tot.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl           tt-parts-tot.in-sum-base = tt-parts-tot.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .    else   assign tt-parts-tot.out-qnty  = tt-parts-tot.out-qnty + buf_wth-parts.fact-qnty                               tt-parts-tot.out-sum-rubl = tt-parts-tot.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl            tt-parts-tot.out-sum-base = tt-parts-tot.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
      423         if lookup(buf-arh_wth-doc.ext-doc-type,'ie,ff,rf':U) > 0
      424         or (buf-arh_wth-doc.ext-doc-type = 'xc':U  and buf_wth-parts.type = 'рас':U)
      425         or lookup (buf-arh_wth-doc.ext-doc-type,'ee,ef,df':u) > 0 then
      426         v-zone = 'free-zone':U.
      427         else if lookup(buf-arh_wth-doc.ext-doc-type,'ip,pc,ps,pz,rp':u) > 0
      428         or (buf-arh_wth-doc.ext-doc-type = 'xc':U  and buf_wth-parts.type = 'при':U)
      429         or lookup (buf-arh_wth-doc.ext-doc-type,'ep,dp':u) > 0 then
      430         v-zone = 'put-zone':U.
      431         if v-zone = 'free-zone':U or  v-zone = 'put-zone':U then do:
      432           find first tt-parts-wp where
      433                     tt-parts-wp.obj-type = buf_wth-parts.obj-type
      434                 and tt-parts-wp.obj-code = buf_wth-parts.obj-code
      435                 and tt-parts-wp.w-p-code = buf_wth-parts.w-p-code
      436                 and tt-parts-wp.wth-code = buf_wth-parts.wth-code
      437                 and tt-parts-wp.par-code = buf_wth-parts.par-code
      438                 and tt-parts-wp.out-code = v-zone
      439                 no-error.
      440           if not available tt-parts-wp then do:
      441             create tt-parts-wp.
      442             assign tt-parts-wp.wth-code = buf_wth-parts.wth-code
      443                   tt-parts-wp.par-code = buf_wth-parts.par-code
      444                   tt-parts-wp.gds-code = buf_wth-parts.gds-code
      445                   tt-parts-wp.w-p-code = buf_wth-parts.w-p-code
      446                   tt-parts-wp.obj-type = buf_wth-parts.obj-type
      447                   tt-parts-wp.obj-code = buf_wth-parts.obj-code
      448                   tt-parts-wp.out-code = v-zone
      449                   tt-parts-wp.ext-doc-type = buf_wth-parts.ext-doc-type
      450                   tt-parts-wp.doc-code = buf_wth-parts.out-code
      451                   tt-parts-wp.host-code = buf_wth-parts.host-code
      452             .
      453           end.
      454           if buf-arh_wth-doc.doc-type = 'при':U or (buf-arh_wth-doc.doc-type = 'обмен':U and  buf_wth-parts.type = 'при':U) then
      455       assign tt-parts-wp.in-qnty     = tt-parts-wp.in-qnty     + buf_wth-parts.fact-qnty
      456              tt-parts-wp.in-sum-rubl = tt-parts-wp.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
      457              tt-parts-wp.in-sum-base = tt-parts-wp.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
      458       else   assign tt-parts-wp.out-qnty  = tt-parts-wp.out-qnty + buf_wth-parts.fact-qnty
      459              tt-parts-wp.out-sum-rubl = tt-parts-wp.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
      460              tt-parts-wp.out-sum-base = tt-parts-wp.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
      461         end.
      462       end.
      463       if vararh-mode = 1 then do:
      464         if buf_wth-parts.in-code = 'фальшивый':U then
      465         assign v-cli-type = '':U
      466                v-cli-code = 0.
      467         else assign v-cli-type = buf_wth-parts.cli-type
      468                v-cli-code = buf_wth-parts.cli-code.
      469         find first tt-parts-cli where
      470                   tt-parts-cli.wth-code = buf_wth-parts.wth-code
      471               and tt-parts-cli.par-code = buf_wth-parts.par-code
      472               and tt-parts-cli.ser-code = buf_wth-parts.ser-code
      473               and tt-parts-cli.db-num   = buf_wth-parts.db-num
      474               and tt-parts-cli.cli-type = v-cli-type
      475               and tt-parts-cli.cli-code = v-cli-code
      476               and tt-parts-cli.obj-type = buf_wth-parts.obj-type
      477               and tt-parts-cli.obj-code = buf_wth-parts.obj-code
      478               and tt-parts-cli.ext-doc-type = buf_wth-parts.ext-doc-type
      479               and tt-parts-cli.gds-code = buf_wth-parts.gds-code
      480               and tt-parts-cli.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
      481               no-error.
      482         if not available tt-parts-cli then do:
      483           create tt-parts-cli.
      484           assign tt-parts-cli.wth-code = buf_wth-parts.wth-code
      485                 tt-parts-cli.par-code = buf_wth-parts.par-code
      486                 tt-parts-cli.ser-code = buf_wth-parts.ser-code
      487                 tt-parts-cli.db-num   = buf_wth-parts.db-num
      488                 tt-parts-cli.cli-type = v-cli-type
      489                 tt-parts-cli.cli-code = v-cli-code
      490                 tt-parts-cli.obj-type = buf_wth-parts.obj-type
      491                 tt-parts-cli.obj-code = buf_wth-parts.obj-code
      492                 tt-parts-cli.doc-code  = buf_wth-parts.out-code
      493                 tt-parts-cli.ext-doc-type = buf_wth-parts.ext-doc-type
      494                 tt-parts-cli.gds-code = buf_wth-parts.gds-code
      495                 tt-parts-cli.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
      496           .
      497         end.
      498       if buf-arh_wth-doc.doc-type = 'при':U
      499       or buf-arh_wth-doc.doc-type = 'возврат':U
      500       or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U)
      501       then
      502       assign tt-parts-cli.in-qnty     = tt-parts-cli.in-qnty     + buf_wth-parts.fact-qnty
      503              tt-parts-cli.in-sum-rubl = tt-parts-cli.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
      504              tt-parts-cli.in-sum-base = tt-parts-cli.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
      505       else   assign tt-parts-cli.out-qnty  = tt-parts-cli.out-qnty + buf_wth-parts.fact-qnty
      506              tt-parts-cli.out-sum-rubl = tt-parts-cli.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
      507              tt-parts-cli.out-sum-base = tt-parts-cli.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
      508         find first tt-parts-cli-doc where
      509                   tt-parts-cli-doc.wth-code = buf_wth-parts.wth-code
      510               and tt-parts-cli-doc.par-code = buf_wth-parts.par-code
      511               and tt-parts-cli-doc.cli-type = v-cli-type
      512               and tt-parts-cli-doc.cli-code = v-cli-code
      513               and tt-parts-cli-doc.host-code = buf_wth-parts.host-code
      514               and tt-parts-cli-doc.contract-code = buf_wth-parts.contract-code
      515               and tt-parts-cli-doc.gds-code = buf_wth-parts.gds-code
      516               and tt-parts-cli-doc.obj-type = buf_wth-parts.obj-type
      517               and tt-parts-cli-doc.obj-code = buf_wth-parts.obj-code
      518               and tt-parts-cli-doc.w-p-code = buf_wth-parts.w-p-code
      519               and tt-parts-cli-doc.ext-doc-type = buf_wth-parts.ext-doc-type
      520               and tt-parts-cli-doc.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
      521               no-error.
      522         if not available tt-parts-cli-doc then do:
      523           create tt-parts-cli-doc.
      524           buffer-copy buf_wth-parts using wth-code
      525                                           par-code
      526                                           host-code
      527                                           contract-code
      528                                           gds-code
      529                                           obj-type
      530                                           obj-code
      531                                           w-p-code
      532                                           ext-doc-type
      533                       to tt-parts-cli-doc.
      534           assign tt-parts-cli-doc.doc-code = buf_wth-parts.out-code
      535                  tt-parts-cli-doc.cli-code = v-cli-code
      536                  tt-parts-cli-doc.cli-type = v-cli-type
      537                  tt-parts-cli-doc.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
      538           .
      539         end.
      540         if buf-arh_wth-doc.doc-type = 'при':U
      541         or buf-arh_wth-doc.doc-type = 'возврат':U
      542         or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U )
      543         then
      544       assign tt-parts-cli-doc.in-qnty     = tt-parts-cli-doc.in-qnty     + buf_wth-parts.fact-qnty
      545              tt-parts-cli-doc.in-sum-rubl = tt-parts-cli-doc.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
      546              tt-parts-cli-doc.in-sum-base = tt-parts-cli-doc.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
      547       else   assign tt-parts-cli-doc.out-qnty  = tt-parts-cli-doc.out-qnty + buf_wth-parts.fact-qnty
      548              tt-parts-cli-doc.out-sum-rubl = tt-parts-cli-doc.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
      549              tt-parts-cli-doc.out-sum-base = tt-parts-cli-doc.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
      550         find first tt-parts-cli-tot where
      551                   tt-parts-cli-tot.cli-type = v-cli-type
      552               and tt-parts-cli-tot.cli-code = v-cli-code
      553               and tt-parts-cli-tot.obj-type = buf_wth-parts.obj-type
      554               and tt-parts-cli-tot.obj-code = buf_wth-parts.obj-code
      555               and tt-parts-cli-tot.ext-doc-type = buf_wth-parts.ext-doc-type
      556               and tt-parts-cli-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
      557         no-error.
      558         if not available tt-parts-cli-tot then do:
      559           create tt-parts-cli-tot.
      560           assign tt-parts-cli-tot.cli-type = v-cli-type
      561                 tt-parts-cli-tot.cli-code  = v-cli-code
      562                 tt-parts-cli-tot.obj-type  = buf_wth-parts.obj-type
      563                 tt-parts-cli-tot.obj-code  = buf_wth-parts.obj-code
      564                 tt-parts-cli-tot.doc-code  = buf_wth-parts.out-code
      565                 tt-parts-cli-tot.host-code = buf_wth-parts.host-code
      566                 tt-parts-cli-tot.ext-doc-type = buf_wth-parts.ext-doc-type
      567                 tt-parts-cli-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
      568           .
      569         end.
      570         if buf-arh_wth-doc.doc-type = 'при':U
      571         or buf-arh_wth-doc.doc-type = 'возврат':U
      572         or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U )
      573         then
      574         assign tt-parts-cli-tot.in-qnty     = tt-parts-cli-tot.in-qnty     + buf_wth-parts.fact-qnty
      575               tt-parts-cli-tot.in-sum-rubl = tt-parts-cli-tot.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
      576               tt-parts-cli-tot.in-sum-base = tt-parts-cli-tot.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
      577         else   assign tt-parts-cli-tot.out-qnty = tt-parts-cli-tot.out-qnty  + buf_wth-parts.fact-qnty
      578               tt-parts-cli-tot.out-sum-rubl = tt-parts-cli-tot.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
      579               tt-parts-cli-tot.out-sum-base = tt-parts-cli-tot.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
      580       end.
      581     end.
      582     if par-lock then do:
      583       for each tt-parts-tot:
      584         find last   buf-arh-wth-tot exclusive-lock  where
      585                     buf-arh-wth-tot.wth-code =  tt-parts-tot.wth-code
      586                 and buf-arh-wth-tot.par-code =  tt-parts-tot.par-code
      587                 and buf-arh-wth-tot.obj-type = tt-parts-tot.obj-type
      588                 and buf-arh-wth-tot.obj-code = tt-parts-tot.obj-code
      589                 and buf-arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
      590                 and buf-arh-wth-tot.sum-type = tt-parts-tot.sum-type     no-error.
      591         if not available buf-arh-wth-tot then do:
      592           create buf-arh-wth-tot.
      593           buffer-copy tt-parts-tot using
      594                       wth-code
      595                       par-code
      596                       gds-code
      597                       obj-type
      598                       obj-code
      599                       w-p-code
      600                       sum-type
      601                       ext-doc-type
      602           to buf-arh-wth-tot.
      603         end.
      604       end.
      605       for each tt-parts-wp:
      606         find last   buf-arh-wth-wp exclusive-lock  where
      607                     buf-arh-wth-wp.wth-code =  tt-parts-wp.wth-code
      608                 and buf-arh-wth-wp.par-code =  tt-parts-wp.par-code
      609                 and buf-arh-wth-wp.obj-type = tt-parts-wp.obj-type
      610                 and buf-arh-wth-wp.obj-code = tt-parts-wp.obj-code
      611                 and buf-arh-wth-wp.w-p-code = tt-parts-wp.w-p-code
      612                 and buf-arh-wth-wp.out-code = tt-parts-wp.out-code     no-error.
      613         if not available buf-arh-wth-wp then do:
      614           create buf-arh-wth-wp.
      615           buffer-copy tt-parts-wp using
      616                       wth-code
      617                       par-code
      618                       gds-code
      619                       obj-type
      620                       obj-code
      621                       w-p-code
      622                       doc-code
      623                       out-code
      624                       ext-doc-type
      625           to buf-arh-wth-wp.
      626         end.
      627       end.
      628       for each tt-parts-cli:
      629         find last  buf-arh-wth-cli exclusive-lock where
      630                    buf-arh-wth-cli.wth-code =  tt-parts-cli.wth-code
      631               and  buf-arh-wth-cli.par-code =  tt-parts-cli.par-code
      632               and  buf-arh-wth-cli.ser-code =  tt-parts-cli.ser-code
      633               and  buf-arh-wth-cli.db-num   =  tt-parts-cli.db-num
      634               and  buf-arh-wth-cli.cli-type =  tt-parts-cli.cli-type
      635               and  buf-arh-wth-cli.cli-code =  tt-parts-cli.cli-code
      636               and  buf-arh-wth-cli.obj-type =  tt-parts-cli.obj-type
      637               and  buf-arh-wth-cli.obj-code =  tt-parts-cli.obj-code
      638               and  buf-arh-wth-cli.sum-type = tt-parts-cli.sum-type
      639               and  buf-arh-wth-cli.ext-doc-type =  tt-parts-cli.ext-doc-type
      640               and  buf-arh-wth-cli.gds-code =  tt-parts-cli.gds-code
      641                no-error.
      642         if not available buf-arh-wth-cli then do:
      643           create buf-arh-wth-cli.
      644           buffer-copy tt-parts-cli using wth-code
      645                                          sum-type
      646                                          par-code
      647                                          ser-code
      648                                          db-num
      649                                          cli-type
      650                                          cli-code
      651                                          obj-type
      652                                          obj-code
      653                                          ext-doc-type
      654                                          gds-code to buf-arh-wth-cli.
      655         end.
      656       end.
      657       for each tt-parts-cli-doc:
      658         find last buf-arh-wth-cli-doc exclusive-lock  where
      659                    buf-arh-wth-cli-doc.wth-code = tt-parts-cli-doc.wth-code
      660               and  buf-arh-wth-cli-doc.par-code = tt-parts-cli-doc.par-code
      661               and  buf-arh-wth-cli-doc.cli-type = tt-parts-cli-doc.cli-type
      662               and  buf-arh-wth-cli-doc.cli-code = tt-parts-cli-doc.cli-code
      663               and  buf-arh-wth-cli-doc.host-code     = tt-parts-cli-doc.host-code
      664               and  buf-arh-wth-cli-doc.contract-code = tt-parts-cli-doc.contract-code
      665               and  buf-arh-wth-cli-doc.gds-code      = tt-parts-cli-doc.gds-code
      666               and  buf-arh-wth-cli-doc.obj-type      = tt-parts-cli-doc.obj-type
      667               and  buf-arh-wth-cli-doc.obj-code      = tt-parts-cli-doc.obj-code
      668               and  buf-arh-wth-cli-doc.w-p-code      = tt-parts-cli-doc.w-p-code
      669               and  buf-arh-wth-cli-doc.sum-type      = tt-parts-cli-doc.sum-type
      670               and  buf-arh-wth-cli-doc.ext-doc-type  = tt-parts-cli-doc.ext-doc-type
      671               no-error.
      672         if not available buf-arh-wth-cli-doc then do:
      673           create buf-arh-wth-cli-doc.
      674           buffer-copy tt-parts-cli-doc using
      675                       wth-code
      676                       par-code
      677                       cli-type
      678                       cli-code
      679                       host-code
      680                       contract-code
      681                       gds-code
      682                       obj-type
      683                       obj-code
      684                       w-p-code
      685                       ext-doc-type
      686                       sum-type
      687                       to buf-arh-wth-cli-doc.
      688         end.
      689       end.
      690       for each tt-parts-cli-tot:
      691         find last  buf-arh-wth-cli-tot exclusive-lock where
      692                    buf-arh-wth-cli-tot.cli-type =  tt-parts-cli-tot.cli-type
      693               and  buf-arh-wth-cli-tot.cli-code =  tt-parts-cli-tot.cli-code
      694               and  buf-arh-wth-cli-tot.obj-type =  tt-parts-cli-tot.obj-type
      695               and  buf-arh-wth-cli-tot.obj-code =  tt-parts-cli-tot.obj-code
      696               and  buf-arh-wth-cli-tot.sum-type = tt-parts-cli-tot.sum-type
      697               and  buf-arh-wth-cli-tot.ext-doc-type =  tt-parts-cli-tot.ext-doc-type
      698         no-error.
      699         if not available buf-arh-wth-cli-tot then do:
      700           create buf-arh-wth-cli-tot.
      701           buffer-copy tt-parts-cli-tot using cli-type sum-type cli-code obj-type obj-code ext-doc-type host-code to buf-arh-wth-cli-tot.
      702         end.
      703       end.
      704     end.
      705     end.
      706    end procedure.
      707    procedure wth-arhdoc-close:
      708    define input parameter pardoc-code as char no-undo.
      709    define variable vararh-mode  as integer      no-undo.
      710     do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      711     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
      712     if not available buf-arh_wth-doc then do:
      713       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
      714     end.
      715     run wth-arh-mode(input buf-arh_wth-doc.ext-doc-type
      716             ,input buf-arh_wth-doc.doc-code
      717             ,output vararh-mode).
      718     if buf-arh_wth-doc.status_ <> 'факт':U then do:
      719       return error substitute ("Документ МЦ с номером &1 не в статусе факт. Создание архивов невозможно.", pardoc-code).
      720     end.
      721     if buf-arh_wth-doc.fact-order = 0 or
      722       buf-arh_wth-doc.fact-order = ? then do:
      723       return error substitute ("В документе МЦ с номером &1 не проставлен fact-order.", buf-arh_wth-doc.doc-code).
      724     end.
      725     if  not g#news
      726          or (g#news and  g#db-num  = 0)
      727     then do:
      728       for each  tt-parts-tot on error undo, return error:
      729           find last  buf-prev_arh-wth-tot where buf-prev_arh-wth-tot.wth-code =  tt-parts-tot.wth-code
      730                                             and buf-prev_arh-wth-tot.par-code =  tt-parts-tot.par-code
      731                                             and buf-prev_arh-wth-tot.obj-type = tt-parts-tot.obj-type
      732                                             and buf-prev_arh-wth-tot.obj-code = tt-parts-tot.obj-code
      733                                             and buf-prev_arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
      734                                             and buf-prev_arh-wth-tot.sum-type = tt-parts-tot.sum-type
      735                                             and buf-prev_arh-wth-tot.fact-order < buf-arh_wth-doc.fact-order
      736                                             no-error.
      737           if available buf-prev_arh-wth-tot and buf-prev_arh-wth-tot.fact-order = 0 then do:
      738               find first buf-arh-wth-tot where recid(buf-arh-wth-tot) = recid(buf-prev_arh-wth-tot) exclusive-lock.
      739           end.
      740           else do:
      741             create buf-arh-wth-tot.
      742             buffer-copy tt-parts-tot to buf-arh-wth-tot .
      743           end.
      744           assign  buf-arh-wth-tot.doc-code = buf-arh_wth-doc.doc-code
      745                   buf-arh-wth-tot.fact-order = buf-arh_wth-doc.fact-order
      746                   buf-arh-wth-tot.in-qnty     = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-qnty  else 0)    + tt-parts-tot.in-qnty
      747                   buf-arh-wth-tot.in-sum-rubl = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-sum-rubl else 0) + tt-parts-tot.in-sum-rubl
      748                   buf-arh-wth-tot.in-sum-base = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-sum-base else 0) + tt-parts-tot.in-sum-base
      749                   buf-arh-wth-tot.out-qnty    = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-qnty else 0)    + tt-parts-tot.out-qnty
      750                   buf-arh-wth-tot.out-sum-rubl = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-sum-rubl else 0) + tt-parts-tot.out-sum-rubl
      751                   buf-arh-wth-tot.out-sum-base = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-sum-base else 0) + tt-parts-tot.out-sum-base
      752                   .
      753           for each buf-recalc-tot where buf-recalc-tot.fact-order > buf-arh_wth-doc.fact-order
      754                 and buf-recalc-tot.wth-code = tt-parts-tot.wth-code
      755                 and buf-recalc-tot.par-code = tt-parts-tot.par-code
      756                 and buf-recalc-tot.obj-type = tt-parts-tot.obj-type
      757                 and buf-recalc-tot.obj-code = tt-parts-tot.obj-code
      758                 and buf-recalc-tot.ext-doc-type = tt-parts-tot.ext-doc-type
      759                 and buf-recalc-tot.sum-type = tt-parts-tot.sum-type
      760                 on error undo, return error :
      761                 assign buf-recalc-tot.out-qnty    = buf-recalc-tot.out-qnty     + tt-parts-tot.out-qnty
      762                       buf-recalc-tot.out-sum-rubl = buf-recalc-tot.out-sum-rubl + tt-parts-tot.out-sum-rubl
      763                       buf-recalc-tot.out-sum-base = buf-recalc-tot.out-sum-base + tt-parts-tot.out-sum-base
      764                       buf-recalc-tot.in-qnty      = buf-recalc-tot.in-qnty    + tt-parts-tot.in-qnty
      765                       buf-recalc-tot.in-sum-rubl = buf-recalc-tot.in-sum-rubl + tt-parts-tot.in-sum-rubl
      766                       buf-recalc-tot.in-sum-base = buf-recalc-tot.in-sum-base + tt-parts-tot.in-sum-base
      767                       .
      768           end.
      769        end.
      770        for each  tt-parts-wp on error undo, return error:
      771           find last  buf-prev_arh-wth-wp where buf-prev_arh-wth-wp.wth-code  = tt-parts-wp.wth-code
      772                                             and buf-prev_arh-wth-wp.par-code = tt-parts-wp.par-code
      773                                             and buf-prev_arh-wth-wp.obj-type = tt-parts-wp.obj-type
      774                                             and buf-prev_arh-wth-wp.obj-code = tt-parts-wp.obj-code
      775                                             and buf-prev_arh-wth-wp.out-code = tt-parts-wp.out-code
      776                                             and buf-prev_arh-wth-wp.w-p-code = tt-parts-wp.w-p-code
      777                                             and buf-prev_arh-wth-wp.fact-order < buf-arh_wth-doc.fact-order
