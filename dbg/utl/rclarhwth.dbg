      998   procedure wth-arhdoc-delete:
      999    define input parameter pardoc-code as char no-undo.
     1000     do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     1001     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
     1002     if not available buf-arh_wth-doc then do:
     1003       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
     1004     end.
     1005     if buf-arh_wth-doc.status_ <> 'факт':U then do:
     1006       return error substitute ("Документ МЦ с номером &1 не в статусе факт. Создание архивов невозможно.", pardoc-code).
     1007     end.
     1008     if buf-arh_wth-doc.fact-order = 0 or
     1009       buf-arh_wth-doc.fact-order = ? then do:
     1010       return error substitute ("В документе МЦ с номером &1 не проставлен fact-order.", buf-arh_wth-doc.doc-code).
     1011     end.
     1012     run wth-arh-calctt-loc(input buf-arh_wth-doc.doc-code
     1013                           ,input no) no-error.
     1014     if error-status:error then  return error return-value + error-status:get-message(1).
     1015     for each  tt-parts-tot on error undo, return error return-value:
     1016         find first  buf-arh-wth-tot where buf-arh-wth-tot.wth-code =  tt-parts-tot.wth-code
     1017                                           and buf-arh-wth-tot.par-code =  tt-parts-tot.par-code
     1018                                           and buf-arh-wth-tot.obj-type = tt-parts-tot.obj-type
     1019                                           and buf-arh-wth-tot.obj-code = tt-parts-tot.obj-code
     1020                                           and buf-arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     1021                                           and buf-arh-wth-tot.sum-type = tt-parts-tot.sum-type
     1022                                           and buf-arh-wth-tot.fact-order = buf-arh_wth-doc.fact-order
     1023                                           no-error.
     1024         if available buf-arh-wth-tot then do:
     1025             delete buf-arh-wth-tot.
     1026         end.
     1027         for each buf-recalc-tot where buf-recalc-tot.fact-order > buf-arh_wth-doc.fact-order
     1028               and buf-recalc-tot.wth-code = tt-parts-tot.wth-code
     1029               and buf-recalc-tot.par-code = tt-parts-tot.par-code
     1030               and buf-recalc-tot.obj-type = tt-parts-tot.obj-type
     1031               and buf-recalc-tot.obj-code = tt-parts-tot.obj-code
     1032               and buf-recalc-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     1033               and buf-recalc-tot.sum-type = tt-parts-tot.sum-type
     1034                :
     1035               assign buf-recalc-tot.out-qnty     = buf-recalc-tot.out-qnty - tt-parts-tot.out-qnty
     1036                     buf-recalc-tot.out-sum-rubl = buf-recalc-tot.out-sum-rubl - tt-parts-tot.out-sum-rubl
     1037                     buf-recalc-tot.out-sum-base = buf-recalc-tot.out-sum-base - tt-parts-tot.out-sum-base
     1038                     buf-recalc-tot.in-qnty       = buf-recalc-tot.in-qnty - tt-parts-tot.in-qnty
     1039                     buf-recalc-tot.in-sum-rubl = buf-recalc-tot.in-sum-rubl - tt-parts-tot.in-sum-rubl
     1040                     buf-recalc-tot.in-sum-base = buf-recalc-tot.in-sum-base - tt-parts-tot.in-sum-base
     1041                     .
     1042         end.
     1043     end.
     1044     for each  tt-parts-wp on error undo, return error return-value:
     1045         find first  buf-arh-wth-wp where buf-arh-wth-wp.wth-code =  tt-parts-wp.wth-code
     1046                                           and buf-arh-wth-wp.par-code =  tt-parts-wp.par-code
     1047                                           and buf-arh-wth-wp.obj-type = tt-parts-wp.obj-type
     1048                                           and buf-arh-wth-wp.obj-code = tt-parts-wp.obj-code
     1049                                           and buf-arh-wth-wp.out-code = tt-parts-wp.out-code
     1050                                           and buf-arh-wth-wp.w-p-code = tt-parts-wp.w-p-code
     1051                                           and buf-arh-wth-wp.sum-type = tt-parts-wp.sum-type
     1052                                           and buf-arh-wth-wp.fact-order = buf-arh_wth-doc.fact-order
     1053                                           no-error.
     1054         if available buf-arh-wth-wp then do:
     1055             delete buf-arh-wth-wp.
     1056         end.
     1057         for each buf-recalc-wp where buf-recalc-wp.fact-order > buf-arh_wth-doc.fact-order
     1058               and buf-recalc-wp.wth-code = tt-parts-wp.wth-code
     1059               and buf-recalc-wp.par-code = tt-parts-wp.par-code
     1060               and buf-recalc-wp.obj-type = tt-parts-wp.obj-type
     1061               and buf-recalc-wp.obj-code = tt-parts-wp.obj-code
     1062               and buf-recalc-wp.out-code = tt-parts-wp.out-code
     1063               and buf-recalc-wp.w-p-code = tt-parts-wp.w-p-code
     1064               and buf-recalc-wp.sum-type = tt-parts-wp.sum-type
     1065                :
     1066               assign buf-recalc-wp.out-qnty     = buf-recalc-wp.out-qnty - tt-parts-wp.out-qnty
     1067                     buf-recalc-wp.out-sum-rubl = buf-recalc-wp.out-sum-rubl - tt-parts-wp.out-sum-rubl
     1068                     buf-recalc-wp.out-sum-base = buf-recalc-wp.out-sum-base - tt-parts-wp.out-sum-base
     1069                     buf-recalc-wp.in-qnty       = buf-recalc-wp.in-qnty - tt-parts-wp.in-qnty
     1070                     buf-recalc-wp.in-sum-rubl = buf-recalc-wp.in-sum-rubl - tt-parts-wp.in-sum-rubl
     1071                     buf-recalc-wp.in-sum-base = buf-recalc-wp.in-sum-base - tt-parts-wp.in-sum-base
     1072                     .
     1073         end.
     1074     end.
     1075     for each  tt-parts-cli:
     1076       find last  buf-arh-wth-cli where  buf-arh-wth-cli.wth-code =  tt-parts-cli.wth-code
     1077                                         and  buf-arh-wth-cli.par-code =  tt-parts-cli.par-code
     1078                                         and  buf-arh-wth-cli.cli-type =  tt-parts-cli.cli-type
     1079                                         and  buf-arh-wth-cli.ser-code =  tt-parts-cli.ser-code
     1080                                         and  buf-arh-wth-cli.db-num   =  tt-parts-cli.db-num
     1081                                         and  buf-arh-wth-cli.cli-code =  tt-parts-cli.cli-code
     1082                                         and  buf-arh-wth-cli.obj-type =  tt-parts-cli.obj-type
     1083                                         and  buf-arh-wth-cli.obj-code =  tt-parts-cli.obj-code
     1084                                         and  buf-arh-wth-cli.ext-doc-type =  tt-parts-cli.ext-doc-type
     1085                                         and buf-arh-wth-cli.sum-type = tt-parts-cli.sum-type
     1086                                         and  buf-arh-wth-cli.gds-code =  tt-parts-cli.gds-code
     1087                                         and  buf-arh-wth-cli.fact-order = buf-arh_wth-doc.fact-order
     1088                                         no-error.
     1089       if available buf-arh-wth-cli then do:
     1090           delete buf-arh-wth-cli.
     1091       end.
     1092       for each buf-recalc-cli where buf-recalc-cli.fact-order > buf-arh_wth-doc.fact-order
     1093             and buf-recalc-cli.wth-code = tt-parts-cli.wth-code
     1094             and buf-recalc-cli.par-code = tt-parts-cli.par-code
     1095             and buf-recalc-cli.ser-code = tt-parts-cli.ser-code
     1096             and buf-recalc-cli.db-num   = tt-parts-cli.db-num
     1097             and buf-recalc-cli.cli-type = tt-parts-cli.cli-type
     1098             and buf-recalc-cli.cli-code = tt-parts-cli.cli-code
     1099             and buf-recalc-cli.obj-type = tt-parts-cli.obj-type
     1100             and buf-recalc-cli.obj-code = tt-parts-cli.obj-code
     1101             and buf-recalc-cli.ext-doc-type = tt-parts-cli.ext-doc-type
     1102             and buf-recalc-cli.sum-type = tt-parts-cli.sum-type
     1103             and buf-recalc-cli.gds-code = tt-parts-cli.gds-code:
     1104             assign buf-recalc-cli.out-qnty     = buf-recalc-cli.out-qnty - tt-parts-cli.out-qnty
     1105                   buf-recalc-cli.out-sum-rubl = buf-recalc-cli.out-sum-rubl - tt-parts-cli.out-sum-rubl
     1106                   buf-recalc-cli.out-sum-base = buf-recalc-cli.out-sum-base - tt-parts-cli.out-sum-base
     1107                   buf-recalc-cli.in-qnty       = buf-recalc-cli.in-qnty - tt-parts-cli.in-qnty
     1108                   buf-recalc-cli.in-sum-rubl = buf-recalc-cli.in-sum-rubl - tt-parts-cli.in-sum-rubl
     1109                   buf-recalc-cli.in-sum-base = buf-recalc-cli.in-sum-base - tt-parts-cli.in-sum-base
     1110                   .
     1111       end.
     1112     end.
     1113     for each  tt-parts-cli-doc:
     1114       find last  buf-arh-wth-cli-doc where  buf-arh-wth-cli-doc.wth-code =  tt-parts-cli-doc.wth-code
     1115                                         and  buf-arh-wth-cli-doc.par-code = tt-parts-cli-doc.par-code
     1116                                         and  buf-arh-wth-cli-doc.cli-type = tt-parts-cli-doc.cli-type
     1117                                         and  buf-arh-wth-cli-doc.cli-code = tt-parts-cli-doc.cli-code
     1118                                         and  buf-arh-wth-cli-doc.host-code     = tt-parts-cli-doc.host-code
     1119                                         and  buf-arh-wth-cli-doc.contract-code = tt-parts-cli-doc.contract-code
     1120                                         and  buf-arh-wth-cli-doc.gds-code      = tt-parts-cli-doc.gds-code
     1121                                         and  buf-arh-wth-cli-doc.obj-type      = tt-parts-cli-doc.obj-type
     1122                                         and  buf-arh-wth-cli-doc.obj-code      = tt-parts-cli-doc.obj-code
     1123                                         and  buf-arh-wth-cli-doc.w-p-code      = tt-parts-cli-doc.w-p-code
     1124                                         and  buf-arh-wth-cli-doc.ext-doc-type  = tt-parts-cli-doc.ext-doc-type
     1125                                         and buf-arh-wth-cli-doc.sum-type = tt-parts-cli-doc.sum-type
     1126                                         and  buf-arh-wth-cli-doc.fact-order < buf-arh_wth-doc.fact-order
     1127                                         no-error.
     1128       if available  buf-arh-wth-cli-doc then do:
     1129         delete buf-arh-wth-cli-doc.
     1130       end.
     1131       for each  buf-recalc-cli-doc where buf-recalc-cli-doc.fact-order > buf-arh_wth-doc.fact-order
     1132             and buf-recalc-cli-doc.wth-code = tt-parts-cli-doc.wth-code
     1133             and buf-recalc-cli-doc.par-code = tt-parts-cli-doc.par-code
     1134             and buf-recalc-cli-doc.cli-type = tt-parts-cli-doc.cli-type
     1135             and buf-recalc-cli-doc.cli-code = tt-parts-cli-doc.cli-code
     1136             and buf-recalc-cli-doc.host-code     = tt-parts-cli-doc.host-code
     1137             and buf-recalc-cli-doc.contract-code = tt-parts-cli-doc.contract-code
     1138             and buf-recalc-cli-doc.gds-code      = tt-parts-cli-doc.gds-code
     1139             and buf-recalc-cli-doc.obj-type      = tt-parts-cli-doc.obj-type
     1140             and buf-recalc-cli-doc.obj-code      = tt-parts-cli-doc.obj-code
     1141             and buf-recalc-cli-doc.w-p-code      = tt-parts-cli-doc.w-p-code
     1142             and buf-recalc-cli-doc.sum-type      = tt-parts-cli-doc.sum-type
     1143             and buf-recalc-cli-doc.ext-doc-type  = tt-parts-cli-doc.ext-doc-type:
     1144             assign buf-recalc-cli-doc.out-qnty     = buf-recalc-cli-doc.out-qnty - tt-parts-cli-doc.out-qnty
     1145                   buf-recalc-cli-doc.out-sum-rubl = buf-recalc-cli-doc.out-sum-rubl - tt-parts-cli-doc.out-sum-rubl
     1146                   buf-recalc-cli-doc.out-sum-base = buf-recalc-cli-doc.out-sum-base - tt-parts-cli-doc.out-sum-base
     1147                   buf-recalc-cli-doc.in-qnty       = buf-recalc-cli-doc.in-qnty - tt-parts-cli-doc.in-qnty
     1148                   buf-recalc-cli-doc.in-sum-rubl  = buf-recalc-cli-doc.in-sum-rubl - tt-parts-cli-doc.in-sum-rubl
     1149                   buf-recalc-cli-doc.in-sum-base  = buf-recalc-cli-doc.in-sum-base - tt-parts-cli-doc.in-sum-base
     1150                   .
     1151       end.
     1152     end.
     1153     for each  tt-parts-cli-tot:
     1154       find last  buf-arh-wth-cli-tot where   buf-arh-wth-cli-tot.cli-type =  tt-parts-cli-tot.cli-type
     1155                                         and  buf-arh-wth-cli-tot.cli-code =  tt-parts-cli-tot.cli-code
     1156                                         and  buf-arh-wth-cli-tot.obj-type =  tt-parts-cli-tot.obj-type
     1157                                         and  buf-arh-wth-cli-tot.obj-code =  tt-parts-cli-tot.obj-code
     1158                                         and  buf-arh-wth-cli-tot.ext-doc-type =  tt-parts-cli-tot.ext-doc-type
     1159                                         and  buf-arh-wth-cli-tot.sum-type = tt-parts-cli-tot.sum-type
     1160                                         and  buf-arh-wth-cli-tot.fact-order = buf-arh_wth-doc.fact-order
     1161                                         no-error.
     1162       if available buf-arh-wth-cli-tot then do:
     1163           delete buf-arh-wth-cli-tot.
     1164       end.
     1165       for each buf-recalc-cli-tot where buf-recalc-cli-tot.fact-order > buf-arh_wth-doc.fact-order
     1166             and buf-recalc-cli-tot.cli-type = tt-parts-cli-tot.cli-type
     1167             and buf-recalc-cli-tot.cli-code = tt-parts-cli-tot.cli-code
     1168             and buf-recalc-cli-tot.obj-type = tt-parts-cli-tot.obj-type
     1169             and buf-recalc-cli-tot.obj-code = tt-parts-cli-tot.obj-code
     1170             and buf-recalc-cli-tot.sum-type = tt-parts-cli-tot.sum-type
     1171             and buf-recalc-cli-tot.ext-doc-type = tt-parts-cli-tot.ext-doc-type
     1172             :
     1173             assign buf-recalc-cli-tot.out-qnty     = buf-recalc-cli-tot.out-qnty - tt-parts-cli-tot.out-qnty
     1174                   buf-recalc-cli-tot.out-sum-rubl = buf-recalc-cli-tot.out-sum-rubl - tt-parts-cli-tot.out-sum-rubl
     1175                   buf-recalc-cli-tot.out-sum-base = buf-recalc-cli-tot.out-sum-base - tt-parts-cli-tot.out-sum-base
     1176                   buf-recalc-cli-tot.in-qnty       = buf-recalc-cli-tot.in-qnty - tt-parts-cli-tot.in-qnty
     1177                   buf-recalc-cli-tot.in-sum-rubl = buf-recalc-cli-tot.in-sum-rubl - tt-parts-cli-tot.in-sum-rubl
     1178                   buf-recalc-cli-tot.in-sum-base = buf-recalc-cli-tot.in-sum-base - tt-parts-cli-tot.in-sum-base
     1179                   .
     1180       end.
     1181     end.
     1182   end.
     1183   end procedure.
     1184   define variable varhost-code like ub.store.host-code no-undo.
     1185   def var i as int.
     1186   def buffer buf_wth-doc for ub.wth-doc.
     1187   def var fact-order-from like ub.wth-doc.fact-order.
     1188   find first ub.clients where ub.clients.obj-type = parobj-type and
     1189                            ub.clients.obj-code = parobj-code no-lock no-error.
     1190   if not available ub.clients then do:
     1191      message "Нет такого объекта " ub.clients.obj-type " " ub.clients.obj-code
     1192      view-as alert-box error.
     1193      return error.
     1194   end.
     1195   if ub.clients.obj-type = 'скл':U then do:
     1196      find first ub.store where ub.store.obj-code = ub.clients.obj-code no-lock.
     1197      assign varhost-code = ub.store.host-code.
     1198   end.
     1199   else do:
     1200      if ub.clients.obj-type = 'маг':U then do:
     1201         find first ub.shop where ub.shop.obj-code = ub.clients.obj-code no-lock.
     1202         assign varhost-code = ub.shop.host-code.
     1203      end.
     1204      else do:
     1205           message "Недопустимый тип объекта пересчета " ub.clients.obj-type
     1206           view-as alert-box error.
     1207           return error.
     1208      end.
     1209   end.
     1210   run waitfram-show in this-procedure ("").
     1211   tr:
     1212   do transaction on error undo tr, return error:
     1213   run waitfram-show in this-procedure ("Очищаем остатки").
     1214   for each        buf_wth-doc where
     1215   buf_wth-doc.obj-type = parobj-type and
     1216   buf_wth-doc.obj-code = parobj-code and
     1217   buf_wth-doc.fact-date <   par-date by buf_wth-doc.fact-order desc:
     1218       fact-order-from =   buf_wth-doc.fact-order.
     1219       leave.
     1220   end.
     1221   if fact-order-from = 0 then
     1222   for each        buf_wth-doc where
     1223   buf_wth-doc.obj-type = parobj-type and
     1224   buf_wth-doc.obj-code = parobj-code and
     1225   buf_wth-doc.fact-date >=   par-date by buf_wth-doc.fact-order:
     1226       fact-order-from =   buf_wth-doc.fact-order.
     1227       leave.
     1228   end.
     1229   for each ub.arh-wth-tot where ub.arh-wth-tot.obj-type = parobj-type and
     1230     ub.arh-wth-tot.obj-code = parobj-code and
     1231     ub.arh-wth-tot.fact-order >  fact-order-from:
     1232      delete ub.arh-wth-tot.
     1233   end.
     1234   for each ub.arh-wth-cli where ub.arh-wth-cli.obj-type = parobj-type and
     1235     ub.arh-wth-cli.obj-code = parobj-code and
     1236     ub.arh-wth-cli.fact-order >  fact-order-from:
     1237      delete ub.arh-wth-cli.
     1238   end.
     1239   for each ub.arh-wth-cli-doc where ub.arh-wth-cli-doc.obj-type = parobj-type and
     1240     ub.arh-wth-cli-doc.obj-code = parobj-code and
     1241     ub.arh-wth-cli-doc.fact-order >  fact-order-from:
     1242      delete ub.arh-wth-cli-doc.
     1243   end.
     1244   for each ub.arh-wth-cli-tot where ub.arh-wth-cli-tot.obj-type = parobj-type and
     1245     ub.arh-wth-cli-tot.obj-code = parobj-code and
     1246     ub.arh-wth-cli-tot.fact-order >  fact-order-from:
     1247      delete ub.arh-wth-cli-tot.
     1248   end.
     1249   for each ub.arh-wth-w-p where ub.arh-wth-w-p.obj-type = parobj-type and
     1250     ub.arh-wth-w-p.obj-code = parobj-code and
     1251     ub.arh-wth-w-p.fact-order >  fact-order-from:
     1252      delete ub.arh-wth-w-p.
     1253   end.
     1254   for each ub.arh-wth-tot-attr where ub.arh-wth-tot-attr.obj-type = parobj-type and
     1255     ub.arh-wth-tot-attr.obj-code = parobj-code and
     1256     ub.arh-wth-tot-attr.fact-order >  fact-order-from:
     1257      delete ub.arh-wth-tot-attr.
     1258   end.
     1259   for each ub.arh-wth-cli-attr where ub.arh-wth-cli-attr.obj-type = parobj-type and
     1260     ub.arh-wth-cli-attr.obj-code = parobj-code and
     1261     ub.arh-wth-cli-attr.fact-order >  fact-order-from:
     1262      delete ub.arh-wth-cli-attr.
     1263   end.
     1264   for each ub.arh-wth-cli-doc-attr where ub.arh-wth-cli-doc-attr.obj-type = parobj-type and
     1265     ub.arh-wth-cli-doc-attr.obj-code = parobj-code and
     1266     ub.arh-wth-cli-doc-attr.fact-order >  fact-order-from:
     1267      delete ub.arh-wth-cli-doc-attr.
     1268   end.
     1269   for each ub.arh-wth-cli-tot-attr where ub.arh-wth-cli-tot-attr.obj-type = parobj-type and
     1270     ub.arh-wth-cli-tot-attr.obj-code = parobj-code and
     1271     ub.arh-wth-cli-tot-attr.fact-order >  fact-order-from:
     1272      delete ub.arh-wth-cli-tot-attr.
     1273   end.
     1274   for each ub.arh-wth-w-p-attr where ub.arh-wth-w-p-attr.obj-type = parobj-type and
     1275     ub.arh-wth-w-p-attr.obj-code = parobj-code and
     1276     ub.arh-wth-w-p-attr.fact-order >  fact-order-from:
     1277      delete ub.arh-wth-w-p-attr.
     1278   end.
     1279   for each ub.wth-doc where ub.wth-doc.host-code = varhost-code and
     1280                          ub.wth-doc.obj-type  = parobj-type  and
     1281                          ub.wth-doc.obj-code  = parobj-code  and
     1282                          ub.wth-doc.status_   = 'факт':U  and
     1283                          ub.wth-doc.fact-order > fact-order-from
     1284                          USE-INDEX stat-fact:
     1285       run waitfram-show in this-procedure ("Пересчитываем архивы по документу " + ub.wth-doc.doc-code + " .").
     1286           run wth-arh-calctt-loc(input ub.wth-doc.doc-code
     1287                             ,input yes) no-error.
     1288           if error-status:error then undo tr, return error return-value + error-status:get-message(1).
     1289       run wth-arhdoc-close(input ub.wth-doc.doc-code) no-error.
     1290           if error-status:error then undo tr, return error return-value + error-status:get-message(1).
     1291   end.
     1292   end.
