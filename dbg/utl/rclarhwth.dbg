      809                       buf-recalc-wp.in-sum-rubl = buf-recalc-wp.in-sum-rubl + tt-parts-wp.in-sum-rubl
      810                       buf-recalc-wp.in-sum-base = buf-recalc-wp.in-sum-base + tt-parts-wp.in-sum-base
