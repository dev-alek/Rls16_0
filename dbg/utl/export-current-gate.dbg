        1   block-level on error undo, throw.
        2   define input parameter p-file-name as character no-undo .
        3   define input parameter p-old-file-name as character no-undo .
        4   define input parameter p-mode as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: export-current-gate.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/export-current-gate.p $":U .
       10   define variable vss-description as character no-undo init "Экспорт конфигурации gate в формате СПН".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable v-gate-exp-tables as character no-undo .
       70   define variable v-gate-exp-table-names as character no-undo .
       71   define variable err-count as integer no-undo .
       72   define variable rec-count as integer no-undo .
       73   define variable v-ii as integer no-undo .
       74   define variable v-prepare-phrase as character no-undo .
       75   define variable num-rec as integer no-undo .
       76   define variable num-err as integer no-undo .
       77   assign
       78   v-gate-exp-tables =  'clob-bind':U +
       79                       ";" + ('clob-bind':U + chr(44) + 'clob-data':U) +
       80                       ";" + ('clob-bind':U + chr(44) + 'clob-bind':U)
       81                       .
       82   assign
       83   v-gate-exp-table-names = 'Связка clob с владельцем':U +
       84                           ";" + 'CLOB-data':U +
       85                           ";" + 'Связка clob с владельцем':U
       86                           .
       87   do v-ii = 1 to num-entries( v-gate-exp-tables, ";"):
       88     CASE entry(v-ii, v-gate-exp-tables, ";"):
       89       when 'clob-bind':U then do:
       90         v-prepare-phrase = substitute(" for each &1 where &1.resource-type = '&2' and &1.db-num = 0 and &1.int64-id > 0 by &1.field-name_"
       91                                       , entry(v-ii, v-gate-exp-tables, ";")
       92                                       , 'gate':U).
       93       end.
       94       when ('clob-bind':U + chr(44) + 'clob-data':U) then do:
       95         v-prepare-phrase = substitute(" for each clob-bind where clob-bind.resource-type = '&1', first &2 where " +
       96                                       " &2.db-num = clob-bind.db-num   and &2.int64-id = clob-bind.int64-id  by clob-bind.uniq-key-rec"
       97                                       , 'gate':U
       98                                       ,entry(2, entry(v-ii, v-gate-exp-tables, ";"))).
       99       end.
      100       when ('clob-bind':U + chr(44) + 'clob-bind':U) then do:
      101         v-prepare-phrase = substitute(" for each &1 where &1.db-num = 0 and &1.int64-id = 0 ", entry(1, entry(v-ii, v-gate-exp-tables, ";"))).
      102         entry(v-ii, v-gate-exp-tables, ";") = entry(1, entry(v-ii, v-gate-exp-tables, ";")).
      103       end.
      104       otherwise do:
      105         v-prepare-phrase = substitute(" for each &1 ", entry(v-ii, v-gate-exp-tables, ";")).
      106       end.
      107    END CASE.
      108     rec-count = num-rec.
      109     err-count = num-err.
      110     run utl/upg-exp.p ( input p-file-name
      111                        ,input p-old-file-name
      112                        ,input p-mode
      113                        ,input (if v-ii = 1 then no else yes)
      114                        ,input (if v-ii = 1 then yes else no)
      115                        ,input ( if v-ii = num-entries(v-gate-exp-tables, ";") then yes else no)
      116                        ,input entry(v-ii, v-gate-exp-tables, ";")
      117                        ,input (if num-entries(entry(v-ii, v-gate-exp-tables, ";")) > 1
      118                                then num-entries(entry(v-ii, v-gate-exp-tables, ";"))
      119                                else 1)
      120                        ,input v-prepare-phrase
      121                        ,input-output rec-count
      122                        ,input-output err-count
      123                        ) no-error.
      124     if not error-status:error then do:
      125       num-rec = rec-count.
      126       num-err = err-count.
      127     end.
      128   end.
