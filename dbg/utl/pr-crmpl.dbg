        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: pr-crmpl.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/pr-crmpl.p $":U .
        8   define variable vss-description as character no-undo init "Процедура перехода на 15 версию по переоценкам".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     run mainmenu_getcntxt in parparentproc
       80       (output v-cntxt-db-num
       81       ,output v-cntxt-userid
       82       ,output v-cntxt-level
       83       ,output v-cntxt-host-code-obj
       84       ,output v-cntxt-obj-type
       85       ,output v-cntxt-obj-code
       86       ,output v-cntxt-db-num-obj
       87       ,output v-cntxt-is-admin
       88       ) .
       89   define variable v-sec as integer   no-undo .
       90   PROCEDURE obji-add :
       91   define input  parameter p-db-num       as integer   no-undo .
       92   define input  parameter p-id           as integer   no-undo .
       93   define input  parameter p-dgo-db-num   as integer   no-undo .
       94   define input  parameter p-stts         as integer   no-undo .
       95   define input  parameter p-db-num-usr   as integer   no-undo .
       96   define input  parameter p-userid       as character no-undo .
       97   define output parameter p-recid as recid no-undo .
       98     do
       99     on error undo, return error return-value
      100     :
      101   find first ub.grp-obj-price exclusive-lock where
      102           ub.grp-obj-price.gop-db-num   = p-db-num  and
      103           ub.grp-obj-price.gop-id       = p-id
      104           no-error .
      105     if error-status :error then do:
      106         message
      107           vss-workfile vss-revision vss-description skip
      108           error-status :get-message(1) skip
      109           return-value skip
      110           ""
      111           view-as alert-box error
      112         .
      113         return error .
      114     end.
      115   find first ub.db-grp-obj-price exclusive-lock where
      116           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
      117           ub.db-grp-obj-price.gop-id       = p-id      and
      118           ub.db-grp-obj-price.dgo-db-num   = p-dgo-db-num
      119           no-error .
      120         if not available ub.db-grp-obj-price then do:
      121             create ub.db-grp-obj-price.
      122               assign
      123                   ub.db-grp-obj-price.gop-db-num = p-db-num
      124                   ub.db-grp-obj-price.gop-id     = p-id
      125                   ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
      126               .
      127         end.
      128         assign
      129           ub.db-grp-obj-price.num-chg    = p-db-num-usr
      130           ub.db-grp-obj-price.stts          = p-stts
      131           ub.db-grp-obj-price.sys-date      = today
      132           ub.db-grp-obj-price.sys-time      = time
      133           ub.db-grp-obj-price.sys-time-chr  = string ( ub.db-grp-obj-price.sys-time,"hh:mm" )
      134           ub.db-grp-obj-price.who           = p-userid
      135           p-recid = recid ( ub.db-grp-obj-price )
      136         .
      137         ub.grp-obj-price.sys-time = time .
      138         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
      139     end.
      140   end procedure.
      141   PROCEDURE obji-del :
      142   define input  parameter p-db-num       as integer   no-undo .
      143   define input  parameter p-id           as integer   no-undo .
      144   define input  parameter p-dgo-db-num   as integer   no-undo .
      145   define input  parameter p-db-num-usr   as integer   no-undo .
      146   define input  parameter p-userid       as character no-undo .
      147     do
      148     on error undo, return error return-value
      149     :
      150   find first ub.grp-obj-price exclusive-lock where
      151           ub.grp-obj-price.gop-db-num   = p-db-num  and
      152           ub.grp-obj-price.gop-id       = p-id
      153           .
      154   find first ub.db-grp-obj-price exclusive-lock where
      155           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
      156           ub.db-grp-obj-price.gop-id       = p-id      and
      157           ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
      158           no-error .
      159    if not available ub.db-grp-obj-price then  return error .
      160         assign
      161           ub.db-grp-obj-price.num-chg    = p-db-num-usr
      162           ub.db-grp-obj-price.stts          = 1
      163           ub.db-grp-obj-price.sys-date      = today
      164           ub.db-grp-obj-price.sys-time      = time
      165           ub.db-grp-obj-price.sys-time-chr  = string(ub.db-grp-obj-price.sys-time,"hh:mm")
      166           ub.db-grp-obj-price.who           = p-userid
      167         .
      168         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
      169         ub.grp-obj-price.sys-time = time .
      170     end.
      171   end procedure.
      172   PROCEDURE objf-add :
      173   define input  parameter p-db-num       as integer   no-undo .
      174   define input  parameter p-id           as integer   no-undo .
      175   define input  parameter p-host-code    as integer   no-undo .
      176   define input  parameter p-stts         as integer   no-undo .
      177   define input  parameter p-db-num-usr   as integer   no-undo .
      178   define input  parameter p-userid       as character no-undo .
      179   define output parameter p-recid as recid no-undo .
      180     do
      181     on error undo, return error return-value
      182     :
      183   find first ub.sysconf no-lock where recid(ub.sysconf) = p-host-code .
      184   if available ub.sysconf then do:
      185      p-host-code = ub.sysconf.host-code .
      186   end.
      187   find first ub.grp-obj-price exclusive-lock where
      188           ub.grp-obj-price.gop-db-num   = p-db-num  and
      189           ub.grp-obj-price.gop-id       = p-id
      190           .
      191   find first ub.host-grp-obj-price exclusive-lock where
      192           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
      193           ub.host-grp-obj-price.gop-id       = p-id      and
      194           ub.host-grp-obj-price.host-code    = p-host-code
      195           no-error .
      196         if not available ub.host-grp-obj-price then do:
      197             create ub.host-grp-obj-price.
      198               assign
      199                   ub.host-grp-obj-price.gop-db-num   = p-db-num
      200                   ub.host-grp-obj-price.gop-id       = p-id
      201                   ub.host-grp-obj-price.host-code    = p-host-code
      202               .
      203         end.
      204         assign
      205           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
      206           ub.host-grp-obj-price.stts          = p-stts
      207           ub.host-grp-obj-price.sys-date      = today
      208           ub.host-grp-obj-price.sys-time      = time
      209           ub.host-grp-obj-price.sys-time-chr  = string ( ub.host-grp-obj-price.sys-time,"hh:mm" )
      210           ub.host-grp-obj-price.who           = p-userid
      211           p-recid = recid ( ub.host-grp-obj-price )
      212         .
      213         ub.grp-obj-price.sys-time = time .
      214         run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
      215     end.
      216   end procedure.
