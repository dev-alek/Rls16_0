      385   define variable v-text as character no-undo .
      386   define buffer buf_price-list-type for ub.price-list-type  .
      387     do
      388     on error undo, return error return-value
      389     :
      390   if p-plt-main-id                     = ? then p-plt-main-id = 0 .
      391   if p-bgr-id                          = ? then p-bgr-id                        = 0 .
      392   if p-gop-id                          = ? then p-gop-id                        = 0 .
      393   if p-gop-id-for-calc-turnover        = ? then p-gop-id-for-calc-turnover      = 0 .
      394   if p-qgr-db-num                      = ? then p-qgr-db-num                    = 0 .
      395   if p-qgr-id                          = ? then p-qgr-id                        = 0 .
      396   if p-sgr-db-num                      = ? then p-sgr-db-num                    = 0 .
      397   if p-sgr-id                          = ? then p-sgr-id                        = 0 .
      398   if p-tog-db-num                      = ? then p-tog-db-num                    = 0 .
      399   if p-tog-id                          = ? then p-tog-id                        = 0 .
      400   if p-gop-db-num                      = ? then p-gop-db-num                    = 0 .
      401   if p-gop-db-num-for-calc-turnover    = ? then p-gop-db-num-for-calc-turnover  = 0 .
      402   if p-have-tog-db-num                 = ? then p-have-tog-db-num  = 0 .
      403   if p-have-tog-id                     = ? then p-have-tog-id      = 0 .
      404   if p-gop-id = 0  then  p-use-obj = 1 .
      405   if p-gop-id-for-calc-turnover  = 0  then  p-obj-turnover = false  .
      406   if p-tog-id = 0   then  p-obj-turnover = false  .
      407   if p-tog-id = 0 and  p-bgr-id = 0   then  p-rs-buyer = 0.
      408   if p-name = ? or p-name = ""  then do:
      409     return error "Название типа прайс-листа не должно быть пустым!" .
      410   end.
      411   if logical(p-have-rs-qnty-group) = true and  ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
      412     return error "Не задана количественная группа!" .
      413   end.
      414   if p-have-rs-sum-group = true and  ( p-sgr-id = 0 or p-sgr-id = ? ) then do:
      415     return error "Не задана суммовая группа!" .
      416   end.
      417   if logical(p-under-type-list) = true and  ( p-plt-main-id = 0 or p-plt-main-id = ? ) then do:
      418     return error "Не задан родительский прайс-лист !" .
      419   end.
      420   define buffer parent_price-list-type for ub.price-list-type  .
      421   if  logical(p-under-type-list) = true and p-main = true  then do:
      422       find first parent_price-list-type  no-lock where
      423                  parent_price-list-type.plt-id = p-plt-main-id  and
      424                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
      425       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
      426       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
      427       if parent_price-list-type.main = false  then  return error "Родительский прайс-лист должен быть ГЛАВНЫМ !" .
      428       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
      429   end.
      430   if  logical(p-under-type-list) = true and p-main = false   then do:
      431       find first parent_price-list-type  no-lock where
      432                  parent_price-list-type.plt-id = p-plt-main-id  and
      433                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
      434       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
      435       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
      436       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
      437   end.
      438   if logical(p-have-rs-qnty-group) = false  and not ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
      439      p-qgr-id = 0.
      440      p-qgr-db-num = 0.
      441   end.
      442   if p-have-rs-sum-group = false  and  not( p-sgr-id = 0 or p-sgr-id = ? ) then do:
      443     p-sgr-id = 0.
      444     p-sgr-db-num = 0.
      445   end.
      446   if logical(p-have-rs-turn-group) = false  and not ( p-have-tog-id = 0 or p-have-tog-id = ? ) then do:
      447      p-have-tog-id = 0.
      448      p-have-tog-db-num = 0.
      449   end.
      450   if p-priority  = 0  and p-main = false  and p-under-type-list = 0 then do:
      451      return error "Не задан ПРИОРИТЕТ типа прайс-листа"   .
      452   end.
      453   if p-priority > 0 and p-main = false and p-under-type-list = 0 then do:
      454       if can-find (
      455             first buf_price-list-type no-lock where
      456                   buf_price-list-type.under-type-list = 0          and
      457                   buf_price-list-type.priority        = p-priority and
      458                   buf_price-list-type.main            = false      and
      459                   buf_price-list-type.stts            = integer('0':U)          and
      460               not
      461                 ( buf_price-list-type.plt-db-num = p-db-num and
      462                   buf_price-list-type.plt-id     = p-id )
      463                 ) then
      464       return error "Уже есть тип прайс-листа с приоритетом " + string ( p-priority ) .
      465   end.
      466   find first ub.price-list-type exclusive-lock where
      467              ub.price-list-type.plt-db-num   = p-db-num and
      468              ub.price-list-type.plt-id       = p-id
      469              no-error .
      470       if not available ub.price-list-type then do:
      471         if p-main = true and p-only-gbd = 1 then do:
      472           if can-find ( first buf_price-list-type no-lock where
      473                             buf_price-list-type.main = true and
      474                             buf_price-list-type.only-gbd = 1 and
      475                             buf_price-list-type.stts = integer('0':U) and
      476                             buf_price-list-type.gop-id = p-gop-id and
      477                             buf_price-list-type.gop-db-num = p-gop-db-num ) then  do:
      478               if p-gop-id = 0 or p-gop-id = ? then do:
      479                 v-text  = "для всех объектов" .
      480                 end.
      481                 else do:
      482                 v-text  = "для объектов из группы №"  + string(p-gop-id) + " БД:" + string(p-gop-db-num).
      483                 end.
      484               release ub.price-list-type no-error .
      485               return error "Уже существует ГЛАВНЫЙ ПРАЙС-ЛИСТ для автопереоценок " + v-text .
      486               end.
      487         end.
      488         create ub.price-list-type .
      489         assign
      490             ub.price-list-type.plt-db-num   = p-db-num
      491             ub.price-list-type.plt-id       = p-id
      492         .
      493       end.
      494          assign
      495             ub.price-list-type.plt-db-num                     = p-db-num
      496             ub.price-list-type.plt-id                         = p-id
      497             ub.price-list-type.name                           = p-name
      498             ub.price-list-type.ban-discnt                     = p-ban-discnt
      499             ub.price-list-type.calc-round-method              = p-calc-round-method
      500             ub.price-list-type.calc-round-base                = p-calc-round-base
      501             ub.price-list-type.calc-increase-pc               = p-calc-increase-pc
      502             ub.price-list-type.calc-method                    = p-calc-method
      503             ub.price-list-type.create-price-doc               = p-create-price-doc
      504             ub.price-list-type.fix-cource-crc-base            = p-fix-cource-crc-base
      505             ub.price-list-type.fix-cource-crc-doc             = p-fix-cource-crc-doc
      506             ub.price-list-type.have-rs-qnty-group             = p-have-rs-qnty-group
      507             ub.price-list-type.have-rs-sum-group              = p-have-rs-sum-group
      508             ub.price-list-type.main                           = p-main
      509             ub.price-list-type.only-gbd                       = p-only-gbd
      510             ub.price-list-type.plt-main-db-num                = if p-plt-main-id = 0 then p-db-num else p-plt-main-db-num
      511             ub.price-list-type.plt-main-id                    = if p-plt-main-id = 0 then p-id else p-plt-main-id
      512             ub.price-list-type.priority                       = p-priority
      513             ub.price-list-type.rs-buyer                       = p-rs-buyer
      514             ub.price-list-type.send-cassa                     = p-send-cassa
      515             ub.price-list-type.under-hand-corr                = p-under-hand-corr
      516             ub.price-list-type.under-round-method             = p-under-round-method
      517             ub.price-list-type.under-perc                     = p-under-perc
      518             ub.price-list-type.under-type-list                = p-under-type-list
      519             ub.price-list-type.use-cassa                      = p-use-cassa
      520             ub.price-list-type.use-gds-group                  = p-use-gds-group
      521             ub.price-list-type.use-obj                        = p-use-obj
      522             ub.price-list-type.work-date                      = p-work-date
      523             ub.price-list-type.bgr-db-num                     = p-bgr-db-num
      524             ub.price-list-type.bgr-id                         = p-bgr-id
      525             ub.price-list-type.curr-code                      = p-curr-code
      526             ub.price-list-type.gop-db-num                     = p-gop-db-num
      527             ub.price-list-type.gop-db-num-for-calc-turnover   = p-gop-db-num-for-calc-turnover
      528             ub.price-list-type.gop-id                         = p-gop-id
      529             ub.price-list-type.gop-id-for-calc-turnover       = p-gop-id-for-calc-turnover
      530             ub.price-list-type.qgr-db-num                     = p-qgr-db-num
      531             ub.price-list-type.qgr-id                         = p-qgr-id
      532             ub.price-list-type.sgr-db-num                     = p-sgr-db-num
      533             ub.price-list-type.sgr-id                         = p-sgr-id
      534             ub.price-list-type.tog-db-num                     = p-tog-db-num
      535             ub.price-list-type.tog-id                         = p-tog-id
      536             ub.price-list-type.obj-turnover                   = p-obj-turnover
      537             ub.price-list-type.ttg-summa                      = p-ttg-summa
      538             ub.price-list-type.have-rs-turn-group             =   p-have-rs-turn-group
      539             ub.price-list-type.have-tog-db-num                =   p-have-tog-db-num
      540             ub.price-list-type.have-tog-id                    =   p-have-tog-id
      541             ub.price-list-type.use-cash-pay                   =   p-use-cash-pay
      542             ub.price-list-type.use-pay-type                   =   p-use-pay-type
      543             ub.price-list-type.stts                           = integer('0':U)
      544             ub.price-list-type.sys-date                       = today
      545             ub.price-list-type.sys-time                       = time
      546             ub.price-list-type.sys-time-chr                   = string ( ub.price-list-type.sys-time,"hh:mm" )
      547             ub.price-list-type.who                            = p-userid
      548             ub.price-list-type.db-num-chg                     = p-db-num-usr
      549             p-recid = recid ( ub.price-list-type )
      550         .
      551     if p-use-cassa < 3 then do:
      552        for each tt_cassa : delete tt_cassa . end.
      553     end.
      554     if p-use-gds-group = 0  then do:
      555        for each tt_grp : delete tt_grp . end.
      556     end.
      557     for each ub.price-list-type-gds-grp exclusive-lock where
      558              ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
      559              ub.price-list-type-gds-grp.plt-id      = p-id :
      560          if not can-find (first  tt_grp where tt_grp.node-code = ub.price-list-type-gds-grp.node-code ) then
      561          ub.price-list-type-gds-grp.stts   = integer('1':U) .
      562     end.
      563     for each tt_grp :
      564         find first  ub.price-list-type-gds-grp exclusive-lock where
      565                 ub.price-list-type-gds-grp.node-code  = tt_grp.node-code and
      566                 ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
      567                 ub.price-list-type-gds-grp.plt-id      = p-id no-error .
      568         if not available ub.price-list-type-gds-grp then do:
      569                create ub.price-list-type-gds-grp.
      570                 assign
      571                   ub.price-list-type-gds-grp.node-code  = tt_grp.node-code
      572                   ub.price-list-type-gds-grp.plt-db-num     = p-db-num
      573                   ub.price-list-type-gds-grp.plt-id         = p-id
      574                   ub.price-list-type-gds-grp.stts       = integer('0':U)
      575                   ub.price-list-type-gds-grp.sys-date     = today
      576                   ub.price-list-type-gds-grp.sys-time     = time
      577                   ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
      578                   ub.price-list-type-gds-grp.who          = p-userid
      579                   ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
      580                 .
      581                end.
      582         else do:
      583            assign
      584             ub.price-list-type-gds-grp.stts   = integer('0':U)
      585             ub.price-list-type-gds-grp.sys-date     = today
      586             ub.price-list-type-gds-grp.sys-time     = time
      587             ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
      588             ub.price-list-type-gds-grp.who          = p-userid
      589             ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
      590            .
      591         end.
      592     end.
      593     for each ub.price-list-type-cassa exclusive-lock where
      594              ub.price-list-type-cassa.plt-db-num  = p-db-num and
      595              ub.price-list-type-cassa.plt-id      = p-id :
      596          if not can-find (first tt_cassa where
      597                                 tt_cassa.cash-num = ub.price-list-type-cassa.cash-num and
      598                                 tt_cassa.obj-code = ub.price-list-type-cassa.obj-code and
      599                                 tt_cassa.pos-type = ub.price-list-type-cassa.pos-type
      600                                 ) then
      601          ub.price-list-type-cassa.stts   = integer('1':U)  .
      602     end.
      603     for each tt_cassa :
      604         find first  ub.price-list-type-cassa exclusive-lock where
      605                     ub.price-list-type-cassa.cash-num = tt_cassa.cash-num and
      606                     ub.price-list-type-cassa.obj-code = tt_cassa.obj-code and
      607                     ub.price-list-type-cassa.pos-type = tt_cassa.pos-type and
      608                     ub.price-list-type-cassa.plt-db-num        = p-db-num and
      609                     ub.price-list-type-cassa.plt-id            = p-id     no-error .
      610         if not available ub.price-list-type-cassa then do :
      611                create ub.price-list-type-cassa.
      612                 assign
      613                   ub.price-list-type-cassa.cash-num     = tt_cassa.cash-num
      614                   ub.price-list-type-cassa.obj-code     = tt_cassa.obj-code
      615                   ub.price-list-type-cassa.pos-type     = tt_cassa.pos-type
      616                   ub.price-list-type-cassa.plt-db-num   = p-db-num
      617                   ub.price-list-type-cassa.plt-id       = p-id
      618                   ub.price-list-type-cassa.stts         = integer('0':U)
      619                   ub.price-list-type-cassa.sys-date     = today
      620                   ub.price-list-type-cassa.sys-time     = time
      621                   ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
      622                   ub.price-list-type-cassa.who          = p-userid
      623                   ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
      624                   ub.price-list-type-cassa.db-num       = p-db-num-usr
      625                 .
      626                end.
      627         else do:
      628            assign
      629             ub.price-list-type-cassa.stts   = integer('0':U)
      630             ub.price-list-type-cassa.sys-date     = today
      631             ub.price-list-type-cassa.sys-time     = time
      632             ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
      633             ub.price-list-type-cassa.who          = p-userid
      634             ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
      635            .
      636         end.
      637     end.
      638     for each ub.price-list-type-pay-type exclusive-lock where
      639              ub.price-list-type-pay-type.plt-db-num  = p-db-num and
      640              ub.price-list-type-pay-type.plt-id      = p-id :
      641          if not can-find (first tt_pay-type where
      642                                 tt_pay-type.pay-code = ub.price-list-type-pay-type.pay-code
      643                                 ) then
      644          ub.price-list-type-pay-type.stts   = integer('1':U)  .
      645     end.
      646     for each tt_pay-type :
      647         find first  ub.price-list-type-pay-type exclusive-lock where
      648                     ub.price-list-type-pay-type.pay-code = tt_pay-type.pay-code and
      649                     ub.price-list-type-pay-type.plt-db-num        = p-db-num and
      650                     ub.price-list-type-pay-type.plt-id            = p-id     no-error .
      651         if not available ub.price-list-type-pay-type then do :
      652                create ub.price-list-type-pay-type.
      653                 assign
      654                   ub.price-list-type-pay-type.pay-code     = tt_pay-type.pay-code
      655                   ub.price-list-type-pay-type.plt-db-num   = p-db-num
      656                   ub.price-list-type-pay-type.plt-id       = p-id
      657                   ub.price-list-type-pay-type.stts         = integer('0':U)
      658                   ub.price-list-type-pay-type.sys-date     = today
      659                   ub.price-list-type-pay-type.sys-time     = time
      660                   ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
      661                   ub.price-list-type-pay-type.who          = p-userid
      662                   ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
      663                   ub.price-list-type-pay-type.db-num       = p-db-num-usr
      664                 .
      665                end.
      666         else do:
      667            assign
      668             ub.price-list-type-pay-type.stts   = integer('0':U)
      669             ub.price-list-type-pay-type.sys-date     = today
      670             ub.price-list-type-pay-type.sys-time     = time
      671             ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
      672             ub.price-list-type-pay-type.who          = p-userid
      673             ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
      674            .
      675         end.
      676     end.
      677     for each ub.price-list-type-cash-pay exclusive-lock where
      678              ub.price-list-type-cash-pay.plt-db-num  = p-db-num and
      679              ub.price-list-type-cash-pay.plt-id      = p-id :
      680          if not can-find (first tt_cash-pay where
      681                                 tt_cash-pay.cdpay-code = ub.price-list-type-cash-pay.cdpay-code and
      682                                 tt_cash-pay.curr-code  = ub.price-list-type-cash-pay.curr-code
      683                                 ) then
      684          ub.price-list-type-cash-pay.stts   = 1 .
      685     end.
      686     for each tt_cash-pay :
      687         find first  ub.price-list-type-cash-pay exclusive-lock where
      688                     ub.price-list-type-cash-pay.cdpay-code = tt_cash-pay.cdpay-code and
      689                     ub.price-list-type-cash-pay.curr-code  = tt_cash-pay.curr-code and
      690                     ub.price-list-type-cash-pay.plt-db-num        = p-db-num and
      691                     ub.price-list-type-cash-pay.plt-id            = p-id     no-error .
      692         if not available ub.price-list-type-cash-pay then do :
      693                create ub.price-list-type-cash-pay.
      694                 assign
      695                   ub.price-list-type-cash-pay.cdpay-code     = tt_cash-pay.cdpay-code
      696                   ub.price-list-type-cash-pay.curr-code     = tt_cash-pay.curr-code
      697                   ub.price-list-type-cash-pay.plt-db-num   = p-db-num
      698                   ub.price-list-type-cash-pay.plt-id       = p-id
      699                   ub.price-list-type-cash-pay.stts         = integer('0':U)
      700                   ub.price-list-type-cash-pay.sys-date     = today
      701                   ub.price-list-type-cash-pay.sys-time     = time
      702                   ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
      703                   ub.price-list-type-cash-pay.who          = p-userid
      704                   ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
      705                   ub.price-list-type-cash-pay.db-num       = p-db-num-usr
      706                 .
      707                end.
      708         else do:
      709            assign
      710             ub.price-list-type-cash-pay.stts   = integer('0':U)
      711             ub.price-list-type-cash-pay.sys-date     = today
      712             ub.price-list-type-cash-pay.sys-time     = time
      713             ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
      714             ub.price-list-type-cash-pay.who          = p-userid
      715             ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
      716            .
      717         end.
      718     end.
      719     end.
      720   end procedure.
      721   PROCEDURE type-price-list-delete :
      722   define input  parameter p-db-num       as integer   no-undo .
      723   define input  parameter p-id           as integer   no-undo .
      724   define input  parameter p-db-num-usr   as integer   no-undo .
      725   define input  parameter p-userid       as character no-undo .
      726   define buffer child_price-list-type for ub.price-list-type  .
      727     do
      728     on error undo, return error return-value
      729     :
      730   find first ub.price-list-type exclusive-lock where
      731           ub.price-list-type.plt-db-num   = p-db-num  and
      732           ub.price-list-type.plt-id       = p-id
      733           no-error .
      734    if not available ub.price-list-type then  return error .
      735    if ub.price-list-type.ban-discnt > 0 then do:
      736    define buffer buf_dis-rule for ub.dis-rule  .
      737    find first buf_dis-rule no-lock where
      738               buf_dis-rule.templ-rl-root = ub.price-list-type.ban-discnt and
      739               buf_dis-rule.charkey_one   = substitute("&1-&2", ub.price-list-type.plt-id, ub.price-list-type.plt-db-num)
      740               no-error .
      741        if available buf_dis-rule then do:
      742           message  substitute
      743             ( "Удалить этот тип нельзя, так как есть ссылка на ПРАВИЛО СКИДОК &1 &2" ,
      744                ub.price-list-type.ban-discnt  ,
      745                buf_dis-rule.des
      746               ) view-as alert-box error .
      747           return .
      748        end.
      749    end.
      750    find first ub.price-doc-forming no-lock where
      751               ub.price-doc-forming.plt-id = ub.price-list-type.plt-id and
      752               ub.price-doc-forming.plt-db-num = ub.price-list-type.plt-db-num and
      753               ub.price-doc-forming.stts = integer('0':U) no-error .
      754    if available ub.price-doc-forming then do:
      755           message "Удалить этот тип нельзя, так как есть незакрытые ДНЦ " ub.price-doc-forming.pdf-id "БД:" ub.price-doc-forming.pdf-db
      756           view-as alert-box error .
      757           return .
      758    end.
      759         assign
      760           ub.price-list-type.db-num-chg    = p-db-num-usr
      761           ub.price-list-type.stts          = integer('1':U)
      762           ub.price-list-type.sys-date      = today
      763           ub.price-list-type.sys-time      = time
      764           ub.price-list-type.sys-time-chr  = string ( ub.price-list-type.sys-time,"hh:mm" )
      765           ub.price-list-type.who           = p-userid
      766         .
      767         for each child_price-list-type exclusive-lock where
      768                  child_price-list-type.plt-main-db-num = p-db-num  and
      769                  child_price-list-type.plt-main-id     = p-id
      770                  :
      771               assign
      772                 child_price-list-type.db-num-chg    = p-db-num-usr
      773                 child_price-list-type.stts          = integer('1':U)
      774                 child_price-list-type.sys-date      = today
      775                 child_price-list-type.sys-time      = time
      776                 child_price-list-type.sys-time-chr  = string ( child_price-list-type.sys-time , "hh:mm" )
      777                 child_price-list-type.who           = p-userid
      778               .
      779         end.
      780     end.
      781   end procedure.
      782   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   define variable v-waitfram-action01         as character   no-undo .
      784   define variable v-waitfram-action02         as character   no-undo .
      785   define variable v-waitfram-action03         as character   no-undo .
      786   define variable mWaitFramTextBeg            as character   no-undo.
      787   define variable mWaitFramTextEnd            as character   no-undo.
      788   define variable mWaitFramView               as logical     no-undo.
      789   define variable mWaitProcEvent              as logical     no-undo init yes.
      790   define variable mWaitFramInterval           as integer     no-undo init 1 .
      791   define variable mWaitFramStop               as logical     no-undo.
      792   define variable mWaitFramStopUser           as logical     no-undo.
      793   define variable mWaitFramStopTimeOut        as logical     no-undo.
      794   define variable mWaitFramStartProc          as datetime-tz no-undo.
      795   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      796   define button B-WaitFramStop auto-end-key
      797        label "Стоп"
      798        size 10 by 1 tooltip "Остоновить процесс".
      799   define button B-viewProcInfo
      800        label "Информация"
      801        size 15 by 1 tooltip "Информация о процесс".
      802   define frame waitfram
      803     v-waitfram-action01 format "x(72)" no-label skip
      804     v-waitfram-action02 format "x(72)" no-label skip
      805     v-waitfram-action03 format "x(72)" no-label skip
      806     B-viewProcInfo
      807     B-WaitFramStop at row 4 col 30
      808     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      809     .
      810   define new global shared variable mBatchMode as logical no-undo init ?.
      811   define variable mFramBachModHandle as handle no-undo.
      812   mFramBachModHandle = frame waitfram:handle.
      813   define variable mFameOldVis as logical no-undo.
      814   define variable mVisCUrentVin as logical no-undo.
      815   if session:batch-mode
      816   then
      817      mBatchMode = yes.
      818   if mBatchMode = ? then do:
      819     mVisCUrentVin = current-window:visible.
      820     mFameOldVis = mFramBachModHandle:visible.
      821     mFramBachModHandle:visible  = yes.
      822     mBatchMode = mFramBachModHandle:visible ne yes.
      823     mFramBachModHandle:visible = mFameOldVis.
      824     current-window:visible = mVisCUrentVin.
      825   end.
      826    if  log-manager:logfile-name ne ?
      827     then DO:
      828         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      829         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      830         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      831     end.
      832   on choose of B-WaitFramStop in frame waitfram
      833   do:
      834     mWaitFramStop = yes.
      835     mWaitFramStopUser = yes.
      836   end.
      837   function waitfram-check-timeout returns logical():
      838      define variable vtime as int64 no-undo.
      839      if mWaitFramStopTimeOut
      840      then
      841         return yes.
      842      vtime = ( now - mWaitFramStartProc ) / 1000 .
      843      if     mWaitFramTimeOut ne ?
      844         and mWaitFramTimeOut ne 0
      845         and mWaitFramTimeOut lt vtime
      846      then do:
      847         mWaitFramStopTimeOut = yes.
      848      end.
      849      return mWaitFramStopTimeOut.
      850   end.
      851   procedure waitfram-hide :
      852     if not session:batch-mode
      853     then do
      854     on error undo, return error return-value
      855     :
      856       pause 0 before-hide .
      857       if not mBatchMode then
      858         hide frame waitfram .
      859     if     not mWaitFramView
      860        and mWaitProcEvent
      861     then
      862       process events .
      863     end.
      864   end procedure.
      865   procedure waitfram-show :
      866     define input  parameter p-message as character no-undo .
      867     define variable v-left-margin as integer   no-undo .
      868     if not session:batch-mode
      869     then do
      870     on error undo, return error return-value
      871     :
      872       if length(p-message) <= 70 then do:
      873         assign
      874           v-left-margin = integer((70 - length(p-message)) / 2)
      875         .
      876         assign
      877           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      878         .
      879         assign
      880           v-waitfram-action01 = " "
      881           v-waitfram-action02 = " "
      882                                    + fill(" ", v-left-margin)
      883                                    + p-message
      884           v-waitfram-action03 = " "
      885         .
      886       end.
      887       else do:
      888         define variable vRindex1 as integer no-undo.
      889         define variable vRindex2 as integer no-undo.
      890         vRindex1 = r-index(p-message," ",70).
      891         if vRindex1 = 0
      892         then
      893            vRindex1 = 70.
      894         if length(p-message)  <= vRindex1 + 70 then do:
      895           assign
      896             v-waitfram-action01 = " "
      897             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      898             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      899           .
      900         end.
      901         else do:
      902           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      903           if vRindex2 <= vRindex1
      904           then
      905              vRindex2 = vRindex1 + 70.
      906           assign
      907             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      908             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      909             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      910           .
      911         end.
      912       end.
      913       B-viewProcInfo:visible   in frame waitfram = no.
      914       B-viewProcInfo:sensitive in frame waitfram = no.
      915       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      916       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      917       if  (   mWaitFramView
      918          or  mWaitProcEvent)
      919          and not mBatchMode
      920       then
      921          display
      922             v-waitfram-action01 skip
      923             v-waitfram-action02 skip
      924             v-waitfram-action03 skip
      925          with frame waitfram .
      926       if     mWaitFramView
      927          then do:
      928             if     mWaitFramInterval ne ?
      929                and not mBatchMode
      930             then
      931                wait-for go of frame waitfram pause mWaitFramInterval.
      932          end.
      933          else
      934             if     mWaitProcEvent
      935                and not mBatchMode
      936             then
      937                process events .
      938     end.
      939   end procedure.
      940      procedure waitfram-show-this:
      941         define input  parameter iInterval as int64 no-undo.
      942         define variable vtime as int64 no-undo.
      943         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      944         mWaitFramInterval = iInterval.
      945         run waitfram-show (substitute("&1&2 &3&4" ,
      946                                       mWaitFramTextBeg ,
      947                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      948                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      949                                       mWaitFramTextEnd
      950                                      )
      951                           ).
      952      end.
      953      procedure WaitFramRunPause:
      954         define input  parameter iInterval as dec no-undo.
      955         define variable vStart  as datetime-tz no-undo.
      956         define variable vend    as datetime-tz no-undo.
      957         define variable vint as int64 no-undo.
      958         define variable vOk as logical no-undo.
      959         vStart = now.
      960         vend   = vStart.
      961         publish "WaitFramPause" (iInterval,output vOk).
      962         vend   =  now.
      963         vint = vend - vStart.
      964         vint = iInterval - vint / 1000.
      965         if     not mWaitFramStop
      966            and (   vint > 0
      967                 or (    not vOk
      968                     and iInterval eq ?
      969                     )
      970                 )
      971         then
      972            run waitfram-show-this (iInterval).
      973         vend   =  now.
      974         vint = vend - vStart.
      975         vint = iInterval - vint / 1000.
      976         if     not mWaitFramStop
      977            and vint > 0
      978         then do:
      979            run gbl/pause.p (vint * 1000).
      980         end.
      981         if iInterval ne ?
      982         then
      983            publish "WaitFramStop".
      984         waitfram-check-timeout().
      985      end.
      986      procedure WaitFramWaitFor:
      987         define input  parameter iInterval as dec no-undo.
      988         assign
      989            mWaitFramStartProc   = now
      990            mWaitFramStopUser    = no
      991            mWaitFramStopTimeOut = no
      992         .
      993         block-wait:
      994         do while not mWaitFramStop:
      995            run WaitFramRunPause (iInterval).
      996            if  waitfram-check-timeout()
      997            then do:
      998               leave block-wait.
      999            end.
     1000         end.
     1001         run waitfram-hide.
     1002      end.
     1003   procedure waitfram-join :
     1004     define input  parameter p-line-1  as character no-undo .
     1005     define input  parameter p-line-2  as character no-undo .
     1006     define input  parameter p-line-3  as character no-undo .
     1007     define output parameter p-message as character no-undo .
     1008     do
     1009     on error undo, return error return-value
     1010     :
     1011       assign
     1012         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1013                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1014                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1015       .
     1016     end.
     1017   end procedure.
     1018   function waitfram-join-function returns character
     1019     (input p-line-1 as character
     1020     ,input p-line-2 as character
     1021     ,input p-line-3 as character
     1022     ).
     1023     define variable v-message as character no-undo .
     1024     run waitfram-join in this-procedure
     1025       (input  p-line-1
     1026       ,input  p-line-2
     1027       ,input  p-line-3
     1028       ,output v-message
     1029       ) .
     1030     return v-message .
     1031   end function .
