     1199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1200     (input  'pr-rndbs'
     1201     ,input  buf_store.host-code
     1202     ,input  'скл':U
     1203     ,input  buf_store.obj-code
     1204     ,input  ''
     1205     ,input  ''
     1206     ,input  ''
     1207     ,input  no
     1208     ,output vcalc-round-base
     1209     ,output par-type
     1210     ) no-error .
     1211    .
     1212      loc_calc-increase-pc = decimal ( vcalc-increase-pc ) .
     1213      loc_calc-round-base  = decimal ( vcalc-round-base  ) .
     1214     case loc_calc-round-method:
     1215       when "pr-round-9end" then
     1216         loc_calc-round-method = '9-окончание':U.
     1217       when "pr-round-9-99end" then
     1218         loc_calc-round-method = '9-99окончание':U.
     1219       when "pr-round-integer" then
     1220         loc_calc-round-method = 'Без-дробных':U.
     1221       when "pr-round-select" then
     1222         loc_calc-round-method = 'Произвольно':U.
     1223       when "pr-round-up" then
     1224         loc_calc-round-method = 'Вверх':U.
     1225       when "pr-round-coef" then
     1226         loc_calc-round-method = 'Коэффициент':U.
     1227       when "pr-round-off" then
     1228         loc_calc-round-method = 'Отключено':U.
     1229       otherwise
     1230         loc_calc-round-method = 'Отключено':U.
     1231     end case.
     1232      run proc-b in this-procedure ('скл':U , buf_store.obj-code ) .
     1233   end.
     1234   run waitfram-hide in this-procedure.
     1235   t2 = time.
     1236   message "Все"  string ( t2 - t1  , "hh:mm:ss" ) .
     1237   procedure proc-b :
     1238   define input  parameter p-type as character no-undo .
     1239   define input  parameter p-code as integer   no-undo .
     1240     do
     1241     on error undo, return error return-value
     1242     :
     1243   define variable  p-gop-id as integer no-undo .
     1244   define variable  p-recid  as recid   no-undo .
     1245   do
     1246   on error undo :
     1247   p-gop-id = next-value ( s-gop , ub ) .
     1248   create ub.grp-obj-price.
     1249   assign
     1250     ub.grp-obj-price.gop-db-num   = v-cntxt-db-num
     1251     ub.grp-obj-price.gop-id       = p-gop-id
     1252     ub.grp-obj-price.db-num-chg   = v-cntxt-db-num
     1253     ub.grp-obj-price.stts         = 0
     1254     ub.grp-obj-price.sys-date     = today
     1255     ub.grp-obj-price.sys-time     = time
     1256     ub.grp-obj-price.sys-time-chr = string(ub.grp-obj-price.sys-time,"hh:mm")
     1257     ub.grp-obj-price.who          = v-cntxt-userid
     1258     ub.grp-obj-price.name-group   = "По объекту " + p-type + string ( p-code )
     1259     .
     1260     run  objo-ADD (
     1261       input  v-cntxt-db-num  ,
     1262       input  p-gop-id            ,
     1263       input  p-type  ,
     1264       input  p-code  ,
     1265       input  0               ,
     1266       input  v-cntxt-db-num  ,
     1267       input  v-cntxt-userid  ,
     1268       output p-recid ) .
     1269   define variable v-plt-id as integer   no-undo .
     1270   find first ub.price-list-type no-lock where
     1271              ub.price-list-type.main = true and
     1272              ub.price-list-type.gop-id = p-gop-id and
     1273              ub.price-list-type.gop-db-num = v-cntxt-db-num and
     1274              ub.price-list-type.stts       = integer('0':U) and
     1275              ub.price-list-type.plt-db-num = v-cntxt-db-num no-error .
     1276       if available ub.price-list-type then do:
     1277          v-plt-id = ub.price-list-type.plt-id .
     1278       end.
     1279       else do:
     1280       v-plt-id = next-value (s-plt, ub)  .
     1281           run type-price-list-ADD (
     1282               v-cntxt-db-num
     1283             , v-plt-id
     1284             , "ГТПЛ по объекту " + p-type + string (p-code)
     1285             , int ( true )
     1286             , loc_calc-round-method
     1287             , loc_calc-round-base
     1288             , loc_calc-increase-pc
     1289             , loc_calc-method
     1290             , int ( true )
     1291             , false
     1292             , false
     1293             , int ( false )
     1294             , false
     1295             , true
     1296             , int ( false )
     1297             , v-cntxt-db-num
     1298             ,  ?
     1299             ,  0
     1300             ,  0
     1301             ,  true
     1302             ,  int  ( true  )
     1303             ,  ?
     1304             ,  ?
     1305             ,  int ( false )
     1306             ,  0
     1307             ,  int ( false )
     1308             ,  2
     1309             ,  0
     1310             ,  v-cntxt-db-num
     1311             ,  ?
     1312             ,  v-curr-code
     1313             ,  v-cntxt-db-num
     1314             ,  v-cntxt-db-num
     1315             ,  p-gop-id
     1316             ,  ?
     1317             ,  v-cntxt-db-num
     1318             ,  ?
     1319             ,  v-cntxt-db-num
     1320             ,  ?
     1321             ,  v-cntxt-db-num
     1322             ,  ?
     1323             ,  ?
     1324             ,  v-cntxt-db-num
     1325             ,  v-cntxt-userid
     1326             ,  v-cntxt-db-num
     1327             ,  int( false )
     1328             ,  0
     1329             ,  ?
     1330             ,  int( false  )
     1331             ,  int( false  )
     1332             ,  output p-recid
     1333             ,  input table TT_cassa
     1334             ,  input table TT_grp
     1335             ,  input table TT_pay-type
     1336             ,  input table TT_cash-pay
     1337             ) no-error .
     1338             find first ub.price-list-type no-lock where recid(ub.price-list-type) =  p-recid no-error .
     1339        end.
     1340    end.
     1341   define variable v-pdf as integer   no-undo .
     1342   define variable v-line-num   as integer   no-undo .
     1343   define variable v-excise-base       as decimal   no-undo .
     1344   define variable v-excise-doc        as decimal   no-undo .
     1345   define variable v-excise-rubl       as decimal   no-undo .
     1346   define variable v-price-calc-base   as decimal   no-undo .
     1347   define variable v-price-calc-doc    as decimal   no-undo .
     1348   define variable v-price-calc-rubl   as decimal   no-undo .
     1349   define variable v-price-prev-base   as decimal   no-undo .
     1350   define variable v-price-prev-doc    as decimal   no-undo .
     1351   define variable v-price-prev-rubl   as decimal   no-undo .
     1352   define variable v-price-sale-base   as decimal   no-undo .
     1353   define variable v-price-sale-doc    as decimal   no-undo .
     1354   define variable v-price-sale-rubl   as decimal   no-undo .
     1355   define variable v-road-tax-base     as decimal   no-undo .
     1356   define variable v-road-tax-doc      as decimal   no-undo .
     1357   define variable v-road-tax-rubl     as decimal   no-undo .
     1358   define variable   v-b-code          as integer   no-undo .
     1359   define variable   v-doc-num         as character no-undo .
     1360   define variable   v-price-sale      as decimal   no-undo .
     1361   define variable   v-road-tax        as decimal   no-undo .
     1362   define variable   v-excise          as decimal   no-undo .
     1363   v-line-num = 0 .
     1364   find first ub.price-doc-forming no-lock where
     1365              ub.price-doc-forming.stts       = integer('0':U) and
     1366              ub.price-doc-forming.plt-id     = ub.price-list-type.plt-id and
     1367              ub.price-doc-forming.plt-db-num = ub.price-list-type.plt-db-num no-error .
     1368     if available ub.price-doc-forming then do:
     1369       v-pdf = ub.price-doc-forming.plt-id .
     1370     end.
     1371     else do:
     1372      v-pdf = next-value ( s-pdf , ub ) .
     1373      create ub.price-doc-forming.
     1374      assign
     1375         ub.price-doc-forming.plt-id            = v-plt-id
     1376         ub.price-doc-forming.plt-db-num        = v-cntxt-db-num
     1377         ub.price-doc-forming.pdf-id            = v-pdf
     1378         ub.price-doc-forming.pdf-db            = v-cntxt-db-num
     1379         ub.price-doc-forming.base-rate         = v-base-rate
     1380         ub.price-doc-forming.base-scale        = v-base-scale
     1381         ub.price-doc-forming.db-num-chg        = v-cntxt-db-num
     1382         ub.price-doc-forming.exch-rate         = v-exch-rate
     1383         ub.price-doc-forming.exch-scale        = v-exch-scale
     1384         ub.price-doc-forming.stts              = integer('0':U)
     1385         ub.price-doc-forming.sys-date          = today
     1386         ub.price-doc-forming.sys-time          = time
     1387         ub.price-doc-forming.sys-time-chr      = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1388         ub.price-doc-forming.who               = v-cntxt-userid
     1389         ub.price-doc-forming.name              = "ДНЦ при переходе на 15v "  + p-type + string (p-code)
     1390         ub.price-doc-forming.have-start-period = int( false )
     1391         ub.price-doc-forming.start-sys-date    = ?
     1392         ub.price-doc-forming.start-shift-num   = ?
     1393         ub.price-doc-forming.start-shift-date  = ?
     1394         ub.price-doc-forming.have-end-period   = int ( false  )
     1395         ub.price-doc-forming.end-sys-date      = ?
     1396         ub.price-doc-forming.end-shift-num     = ?
     1397         ub.price-doc-forming.end-date          = ?
     1398         ub.price-doc-forming.end-shift-date    = ?
     1399         ub.price-doc-forming.out-code          = if available ub.price-doc then ub.price-doc.out-code else ""
     1400         ub.price-doc-forming.start-date        = if available ub.price-doc then ub.price-doc.fact-date  else ?
     1401         .
     1402     end.
     1403   define variable v-main-b-code as integer   no-undo .
     1404   define variable v-type-price as integer   no-undo .
     1405   define buffer buf_goods    for ub.goods     .
     1406   define buffer buf_gds-prt  for ub.gds-prt   .
     1407     for each ub.gds-obj no-lock where
     1408              ub.gds-obj.obj-type = p-type and
     1409              ub.gds-obj.obj-code = p-code :
     1410          find first buf_goods    no-lock where buf_goods.gds-code   = ub.gds-obj.gds-code .
     1411          run waitfram-show in this-procedure ( buf_goods.artic + " " + p-type + string(p-code) ) .
     1412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1413     (input  ub.gds-obj.gds-code
     1414     ,input  ?
     1415     ,output v-main-b-code
     1416     )  .
     1417          for each ub.bar-code no-lock where
     1418              ub.bar-code.gds-code = ub.gds-obj.gds-code:
     1419   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1420   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1421     (input  p-type
     1422     ,input  p-code
     1423     ,input  ub.bar-code.b-code
     1424     ,input  0
     1425     ,input  0
     1426     ,output v-doc-num
     1427     ,output v-price-sale
     1428     ,output v-road-tax
     1429     ,output v-excise
     1430     ) no-error .
     1431           if error-status :error = false and v-doc-num <> ?  then do:
     1432            find first ub.price-list no-lock where
     1433                       ub.price-list.doc-num = v-doc-num and
     1434                       ub.price-list.price-type = ""     and
     1435                       ub.price-list.b-code  = ub.bar-code.b-code no-error .
     1436            if not available ub.price-list then next.
     1437         find first ub.price-doc no-lock where
     1438                    ub.price-doc.doc-num = v-doc-num and
     1439               not (
     1440               ub.price-doc.pdf-id               = v-pdf and
     1441               ub.price-doc.pdf-db               = v-cntxt-db-num and
     1442               ub.price-doc.plt-id               = v-plt-id and
     1443               ub.price-doc.plt-db-num           = v-cntxt-db-num ) no-error .
     1444          if available ub.price-doc then do:
     1445              find current ub.price-doc exclusive-lock no-error .
     1446              assign
     1447               ub.price-doc.pdf-id               = v-pdf
     1448               ub.price-doc.pdf-db               = v-cntxt-db-num
     1449               ub.price-doc.plt-id               = v-plt-id
     1450               ub.price-doc.plt-db-num           = v-cntxt-db-num
     1451               ub.price-doc-forming.start-date   = ub.price-doc.fact-date
     1452              .
     1453          end.
     1454         if v-is-base = true then do:
     1455         assign
     1456           v-excise-base      = ub.price-list.excise
     1457           v-price-calc-base  = ub.price-list.price-calc
     1458           v-price-prev-base  = ub.price-list.price-prev
     1459           v-price-sale-base  = ub.price-list.price-sale
     1460           v-road-tax-base    = ub.price-list.road-tax
     1461           v-excise-rubl       = v-excise-base       * v-base-rate / v-base-scale
     1462           v-price-calc-rubl   = v-price-calc-base   * v-base-rate / v-base-scale
     1463           v-price-prev-rubl   = v-price-prev-base   * v-base-rate / v-base-scale
     1464           v-price-sale-rubl   = v-price-sale-base   * v-base-rate / v-base-scale
     1465           v-road-tax-rubl     = v-road-tax-base     * v-base-rate / v-base-scale
     1466           v-excise-doc      = v-excise-base
     1467           v-price-calc-doc  = v-price-calc-base
     1468           v-price-prev-doc  = v-price-prev-base
     1469           v-price-sale-doc  = v-price-sale-base
     1470           v-road-tax-doc    = v-road-tax-base
     1471         .
     1472         end.
     1473         else do:
     1474         assign
     1475           v-excise-rubl     = ub.price-list.excise
     1476           v-price-calc-rubl = ub.price-list.price-calc
     1477           v-price-prev-rubl = ub.price-list.price-prev
     1478           v-price-sale-rubl = ub.price-list.price-sale
     1479           v-road-tax-rubl   = ub.price-list.road-tax
     1480           v-excise-base     = v-excise-rubl     / v-base-rate * v-base-scale
     1481           v-price-calc-base = v-price-calc-rubl / v-base-rate * v-base-scale
     1482           v-price-prev-base = v-price-prev-rubl / v-base-rate * v-base-scale
     1483           v-price-sale-base = v-price-sale-rubl / v-base-rate * v-base-scale
     1484           v-road-tax-base   = v-road-tax-rubl   / v-base-rate * v-base-scale
     1485           v-excise-doc      = v-excise-rubl
     1486           v-price-calc-doc  = v-price-calc-rubl
     1487           v-price-prev-doc  = v-price-prev-rubl
     1488           v-price-sale-doc  = v-price-sale-rubl
     1489           v-road-tax-doc    = v-road-tax-rubl
     1490         .
     1491         end.
     1492         find first ub.price-doc no-lock where
     1493                    ub.price-doc.doc-num = ub.price-list.doc-num no-error .
     1494         v-line-num  = v-line-num   + 1.
     1495         create ub.price-doc-forming-gds.
     1496         buffer-copy ub.price-doc-forming to ub.price-doc-forming-gds
     1497         assign
     1498             ub.price-doc-forming-gds.line-num        = v-line-num
     1499             ub.price-doc-forming-gds.b-code          = ub.price-list.b-code
     1500             ub.price-doc-forming-gds.artic           = ub.price-list.artic
     1501             ub.price-doc-forming-gds.prod-code       = ub.price-list.prod-code
     1502             ub.price-doc-forming-gds.prod-type       = ub.price-list.prod-type
     1503             ub.price-doc-forming-gds.calc-method     = ub.price-list.calc-method
     1504             ub.price-doc-forming-gds.d-pcnt          = ub.price-list.d-pcnt
     1505             ub.price-doc-forming-gds.excise-base     = v-excise-base
     1506             ub.price-doc-forming-gds.excise-doc      = v-excise-doc
     1507             ub.price-doc-forming-gds.excise-rubl     = v-excise-rubl
     1508             ub.price-doc-forming-gds.price-calc-base = v-price-calc-base
     1509             ub.price-doc-forming-gds.price-calc-doc  = v-price-calc-doc
     1510             ub.price-doc-forming-gds.price-calc-rubl = v-price-calc-rubl
     1511             ub.price-doc-forming-gds.price-prev-base = v-price-prev-base
     1512             ub.price-doc-forming-gds.price-prev-doc  = v-price-prev-doc
     1513             ub.price-doc-forming-gds.price-prev-rubl = v-price-prev-rubl
     1514             ub.price-doc-forming-gds.price-sale-base = v-price-sale-base
     1515             ub.price-doc-forming-gds.price-sale-doc  = v-price-sale-doc
     1516             ub.price-doc-forming-gds.price-sale-rubl = v-price-sale-rubl
     1517             ub.price-doc-forming-gds.road-tax-base   = v-road-tax-base
     1518             ub.price-doc-forming-gds.road-tax-doc    = v-road-tax-doc
     1519             ub.price-doc-forming-gds.road-tax-rubl   = v-road-tax-rubl
     1520             ub.price-doc-forming-gds.slt-pc          = ub.price-list.slt-pc
     1521             ub.price-doc-forming-gds.vat-pc          = ub.price-list.vat-pc
     1522         .
     1523            find first buf_gds-prt  no-lock where buf_gds-prt.node-code = ub.bar-code.node-code.
     1524            if buf_goods.unit-base = ub.bar-code.unit-cli then do:
     1525                if buf_gds-prt.upper-code = buf_goods.prt-root
     1526                  then v-type-price  = integer ('0':U) .
     1527                  else v-type-price  = integer ('2':U) .
     1528            end.
     1529            else do:
     1530                if buf_gds-prt.upper-code = buf_goods.prt-root
     1531                  then v-type-price  = integer ('0':U) .
     1532                  else v-type-price  = integer ('1':U) .
     1533            end.
     1534            create ub.price-all.
     1535            assign
     1536               ub.price-all.main-indication = 0
     1537               ub.price-all.type-price      = if ub.bar-code.b-code = v-main-b-code then 0  else 1
     1538               ub.price-all.pal-db-num      = v-cntxt-db-num
     1539               ub.price-all.pal-id          = next-value ( s-pal , ub )
     1540               ub.price-all.b-code          = ub.price-doc-forming-gds.b-code
     1541               ub.price-all.gds-code        = ub.bar-code.gds-code
     1542               ub.price-all.obj-code        = p-code
     1543               ub.price-all.obj-type        = p-TYPE
     1544               ub.price-all.bgr-db-num      = 0
     1545               ub.price-all.bgr-id          = 0
     1546               ub.price-all.curr-code       = ub.price-list-type.curr-code
     1547               ub.price-all.pdf-id               = ub.price-doc-forming-gds.pdf-id
     1548               ub.price-all.pdf-db               = ub.price-doc-forming-gds.pdf-db
     1549               ub.price-all.pdf-base-rate        = v-base-rate
     1550               ub.price-all.pdf-base-scale       = v-base-scale
     1551               ub.price-all.pdf-exch-rate        = v-exch-rate
     1552               ub.price-all.pdf-exch-scale       = v-exch-scale
     1553               ub.price-all.plt-id               = ub.price-doc-forming-gds.plt-id
     1554               ub.price-all.plt-db-num           = ub.price-doc-forming-gds.plt-db-num
     1555               ub.price-all.plt-fix-cource-crc-base   = ub.price-list-type.fix-cource-crc-base
     1556               ub.price-all.plt-fix-cource-crc-doc    = ub.price-list-type.fix-cource-crc-doc
     1557               ub.price-all.plt-priority           = ub.price-list-type.priority
     1558               ub.price-all.plt-work-date          = ub.price-list-type.work-date
     1559               ub.price-all.qnty-from              = ?
     1560               ub.price-all.qnty-to                = ?
     1561               ub.price-all.sum-from               = ?
     1562               ub.price-all.sum-to                 = ?
     1563               ub.price-all.turnover-from          = ?
     1564               ub.price-all.turnover-to            = ?
     1565               ub.price-all.tog-db-num             = 0
     1566               ub.price-all.tog-id                 = 0
     1567               ub.price-all.use-cash-pay           = ub.price-list-type.use-cash-pay
     1568               ub.price-all.use-pay-type           = ub.price-list-type.use-pay-type
     1569               ub.price-all.price-sale             = ub.price-list.price-sale
     1570               ub.price-all.start-date             =  ub.price-doc-forming.start-date
     1571               ub.price-all.start-shift-date       =  ub.price-doc-forming.start-shift-date
     1572               ub.price-all.start-shift-name       =  ub.price-doc-forming.start-shift-name
     1573               ub.price-all.start-shift-num        =  ub.price-doc-forming.start-shift-num
     1574               ub.price-all.start-sys-date         =  ub.price-doc-forming.start-sys-date
     1575               ub.price-all.start-sys-time         =  ub.price-doc-forming.start-sys-time
     1576               ub.price-all.end-date               =  ub.price-doc-forming.end-date
     1577               ub.price-all.end-shift-date         =  ub.price-doc-forming.end-shift-date
     1578               ub.price-all.end-shift-name         =  ub.price-doc-forming.end-shift-name
     1579               ub.price-all.end-shift-num          =  ub.price-doc-forming.end-shift-num
     1580               ub.price-all.end-sys-date           =  ub.price-doc-forming.end-sys-date
     1581               ub.price-all.end-sys-time           =  ub.price-doc-forming.end-sys-time
     1582               ub.price-all.fact-order-shift-from  = ?
     1583               ub.price-all.fact-order-shift-to   = ?
     1584               ub.price-all.fact-order-sys-from   = ?
     1585               ub.price-all.fact-order-sys-to     = ?
     1586               ub.price-all.extra-pcnt            = ?
     1587               ub.price-all.extra-round           = ?
     1588               ub.price-all.work-acc-price        = ?
     1589               ub.price-all.work-acc-price        = ?
     1590               ub.price-all.out-code    =  v-doc-num
     1591               ub.price-all.status_     =  ub.price-doc.status_
     1592               ub.price-all.last-pr     = true
     1593               ub.price-all.fact-order  =  ub.price-doc.fact-order
     1594               .
     1595         end.
     1596      end.
     1597      end.
     1598      find current ub.price-doc-forming exclusive-lock .
     1599      if not can-find (first ub.price-doc-forming-gds no-lock   where
     1600               ub.price-doc-forming-gds.pdf-id               = ub.price-doc-forming.pdf-id and
     1601               ub.price-doc-forming-gds.pdf-db               = ub.price-doc-forming.pdf-db and
     1602               ub.price-doc-forming-gds.plt-id               = ub.price-doc-forming.plt-id   and
     1603               ub.price-doc-forming-gds.plt-db-num           = ub.price-doc-forming.plt-db-num ) then
     1604                    delete ub.price-doc-forming .
     1605               else ub.price-doc-forming.stts = integer('3':U)  .
     1606     end.
     1607   end procedure.
