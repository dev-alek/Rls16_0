        1   block-level on error undo, throw.
        2   define input parameter pardoc-code               like ub.trn-doc.doc-code no-undo.
        3   define variable vss-revision    as character no-undo initial "$Revision: 2df3cb32ffae, 112, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Tue Dec 23 19:14:15 2014 +0300 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: invddsum.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: utl/invddsum.p $":U .
        8   define variable vss-description as character no-undo initial "Утилита по расчету дополнительных сумм по документу":U .
        9   def var p-ok as log no-undo.
       10   for first ub.trn-doc where ub.trn-doc.doc-code = pardoc-code:
       11      p-ok = yes.
       12      for each ub.doc-line-sum where  ub.doc-line-sum.doc-code = pardoc-code:
       13         delete ub.doc-line-sum.
       14      end.
       15      run utl/uaddsum.p(pardoc-code,yes,yes,no) no-error.
       16      if error-status:error then do:
       17          message error-status:get-message(1) view-as alert-box.
       18          return.
       19      end.
       20   end.
       21     if not p-ok then message "Документ не найден" view-as alert-box error.
