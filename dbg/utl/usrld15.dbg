        1   block-level on error undo, throw.
        2   define input parameter p-install as logical no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: usrld15.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/usrld15.p $":U .
        8   define variable vss-description as character no-undo init "Перенос информации о пользователях из таблицы userconf в таблицы user-account, user-login".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115     define variable v-cntxt-db-num        as integer   no-undo .
      116     define variable v-cntxt-userid        as character no-undo .
      117     define variable v-cntxt-level         as character no-undo .
      118     define variable v-cntxt-host-code-obj as integer   no-undo .
      119     define variable v-cntxt-obj-type      as character no-undo .
      120     define variable v-cntxt-obj-code      as integer   no-undo .
      121     define variable v-cntxt-db-num-obj    as integer   no-undo .
      122     define variable v-cntxt-is-admin      as logical   no-undo .
      123   define variable v-ok                          as logical   no-undo .
      124   define variable v-db-num                      as integer   no-undo .
      125   define variable v-user-id                     as character no-undo .
      126   define variable v-user-login                  as character no-undo .
      127   define variable v-last-name                   as character no-undo .
      128   define variable v-user-password-encoded       as character no-undo .
      129   define variable v-cntxt-menu-group-id         as character no-undo .
      130   define variable v1-cntxt-level                 as character no-undo .
      131   define variable v1-cntxt-host-code-obj         as integer   no-undo .
      132   define variable v1-cntxt-obj-type              as character no-undo .
      133   define variable v1-cntxt-obj-code              as integer   no-undo .
      134   define variable v-arm-code-list               as character no-undo .
      135   define variable v-arm-code-lookup-index       as integer   no-undo .
      136   define variable v-menu-group-id-list          as character no-undo .
      137   define variable v-menu-group-id               as character no-undo .
      138   define variable v-ind                         as integer   no-undo .
      139   define variable v-err-count                   as integer   no-undo .
      140   define variable v-userconf-filename           as character no-undo .
      141   define temp-table temp-userconf no-undo
      142      field user-name      as character
      143      field obj-code       as integer
      144      field obj-type       as character
      145      field ARM            as character  format "X(12)"
      146      field on-line        as logical
      147      field max-discnt     as decimal
      148      field quest-print    as logical
      149      field arm-host-code  as integer
      150      index pu is primary unique
      151            user-name
      152   .
      153   define buffer buf_temp-userconf        for temp-userconf .
      154   define buffer buf__user                for ub._user .
      155   define buffer buf_db                   for ub.db .
      156   define buffer buf_user-account         for ub.user-account .
      157   define buffer buf_user-login           for ub.user-login .
      158   define buffer buf_user-context-history for ubflt.user-context-history .
      159   define buffer buf_clients              for ub.clients .
      160   define buffer buf_menu-group           for ub.menu-group .
      161   define stream sinp .
      162   on write of ub.user-account         override do: end.
      163   on write of ub.user-login           override do: end.
      164   on write of ubflt.user-context-history override do: end.
      165   do
      166   on error undo, return error return-value
      167   :
      168     if p-install = false
      169     then do:
      170       message
      171         vss-description skip
      172         "Продолжить?" skip
      173         view-as alert-box question buttons yes-no update v-ok .
      174       if v-ok <> true
      175       then do:
      176         return .
      177       end.
      178     end.
      179     assign
      180       v-db-num = v-cntxt-db-num
      181     .
      182     if "rus" = "rus":U
      183     then do:
      184       assign
      185         v-arm-code-list = 'офи':U
      186                         + chr(44) + 'скл':U
      187                         + chr(44) + 'маг':U
      188                         + chr(44) + 'рес':U
      189                         + chr(44) + 'фин':U
      190                         + chr(44) + 'бгх':U
      191                         + chr(44) + 'бух':U
      192                         + chr(44) + 'осн':U
      193                         + chr(44) + 'адм':U
      194       .
      195     end.
      196     else do:
      197       assign
      198         v-arm-code-list = 'off':U
      199                         + chr(44) + 'str':U
      200                         + chr(44) + 'shp':U
      201                         + chr(44) + 'res':U
      202                         + chr(44) + 'fin':U
      203                         + chr(44) + 'eac':U
      204                         + chr(44) + 'acc':U
      205                         + chr(44) + 'fas':U
      206                         + chr(44) + 'adm':U
      207       .
      208     end.
      209     assign
      210       v-menu-group-id-list = 'off,str,shp,res,fin,bge,buh,fas,adm':U
      211     .
      212       assign
      213         v-userconf-filename = search('usr-conf.142':U)
      214       .
      215       if v-userconf-filename = ?
      216       or v-userconf-filename = '':U
      217       then do:
      218         undo, return error substitute("Не найден файл с пользователями &1"
      219                                      ,'usr-conf.142':U
      220                                      ) .
      221       end.
      222       for each buf_temp-userconf
      223       on error undo, return error return-value
      224       :
      225         delete buf_temp-userconf .
      226       end.
      227       input stream sinp from value(v-userconf-filename) .
      228       repeat
      229       :
      230         create buf_temp-userconf .
      231         import stream sinp buf_temp-userconf .
      232       end.
      233       input stream sinp close .
      234     for each buf_temp-userconf
      235     on error undo, return error return-value
      236     :
      237       assign
      238         v-ind = v-ind + 1
      239       .
      240       find first buf__user
      241         where buf__user._userid = buf_temp-userconf.user-name
      242         no-error .
      243       if available buf__user
      244       then do:
      245         assign
      246           v-user-login            = buf__user._userid
      247           v-last-name             = buf__user._user-name
      248           v-user-password-encoded = buf__user._password
      249         .
      250       end.
      251       else do:
      252         assign
      253           v-user-login            = '':U
      254           v-last-name             = '':U
      255           v-user-password-encoded = '':U
      256         .
      257       end.
      258       assign
      259         v-user-id = substitute('&1-&2':U
      260                               ,v-db-num
      261                               ,next-value(s-user-id)
      262                               )
      263       .
      264       create buf_user-account .
      265       assign
      266         buf_user-account.user-id               = v-user-id
      267         buf_user-account.status_               = 0
      268         buf_user-account.first-name            = '':U
      269         buf_user-account.second-name           = '':U
      270         buf_user-account.last-name             = v-last-name
      271         buf_user-account.company               = '':U
      272         buf_user-account.department            = '':U
      273         buf_user-account.e-mail                = '':U
      274         buf_user-account.internal-phone-number = '':U
      275         buf_user-account.mobile-phone-number   = '':U
      276         buf_user-account.phone-number          = '':U
      277         buf_user-account.position              = '':U
      278         buf_user-account.PS                    = '':U
      279         buf_user-account.room                  = '':U
      280         buf_user-account.parent-user-id        = '':U
      281         buf_user-account.check-parent          = false
      282       .
      283       assign
      284         v-cntxt-menu-group-id        = '':U
      285         v1-cntxt-level                = 'global':U
      286         v1-cntxt-host-code-obj        = ?
      287         v1-cntxt-obj-type             = '':U
      288         v1-cntxt-obj-code             = ?
      289       .
      290       assign
      291         v-arm-code-lookup-index = lookup(buf_temp-userconf.ARM, v-arm-code-list)
      292       .
      293       if v-arm-code-lookup-index > 0
      294       then do:
      295         assign
      296           v-menu-group-id = entry(v-arm-code-lookup-index
      297                                  ,v-menu-group-id-list
      298                                  ,chr(44)
      299                                  )
      300         .
      301         find first buf_menu-group no-lock
      302           where buf_menu-group.menu-code     = 0
      303             and buf_menu-group.menu-group-id = v-menu-group-id
      304           no-error .
      305         if available buf_menu-group
      306         then do:
      307           assign
      308             v-cntxt-menu-group-id = buf_menu-group.menu-group-id
      309           .
      310         end.
      311       end.
      312       find first buf_clients no-lock
      313         where buf_clients.obj-type = buf_temp-userconf.obj-type
      314           and buf_clients.obj-code = buf_temp-userconf.obj-code
      315         no-error .
      316       if available buf_clients
      317       then do:
      318         assign
      319           v1-cntxt-level         = 'object':U
      320           v1-cntxt-host-code-obj = buf_clients.host-code
      321           v1-cntxt-obj-type      = buf_clients.obj-type
      322           v1-cntxt-obj-code      = buf_clients.obj-code
      323         .
      324       end.
      325       else do:
      326         find first buf_clients no-lock
      327           where buf_clients.obj-type = 'орг':U
      328             and buf_clients.obj-code = buf_temp-userconf.arm-host-code
      329           no-error .
      330         if available buf_clients
      331         then do:
      332           assign
      333             v1-cntxt-level         = 'firm':U
      334             v1-cntxt-host-code-obj = buf_clients.host-code
      335             v1-cntxt-obj-type      = buf_clients.obj-type
      336             v1-cntxt-obj-code      = buf_clients.obj-code
      337           .
      338         end.
      339       end.
      340       create buf_user-login .
      341       assign
      342         buf_user-login.db-num                     = v-db-num
      343         buf_user-login.user-id                    = v-user-id
      344         buf_user-login.last-login-computer-name   = '':U
      345         buf_user-login.last-login-computer-userid = '':U
      346         buf_user-login.last-login-mjd             = 0.0
      347         buf_user-login.last-login-process-id      = 0
      348         buf_user-login.login-error-count          = 0
      349         buf_user-login.max-discnt                 = buf_temp-userconf.max-discnt
      350         buf_user-login.quest-print                = buf_temp-userconf.quest-print
      351         buf_user-login.status_                    = 1
      352         buf_user-login.user-administrator         = (if v-user-login = 'адм':U
      353                                                      then true
      354                                                      else false
      355                                                     )
      356         buf_user-login.user-login                 = v-user-login
      357         buf_user-login.user-password-encoded      = v-user-password-encoded
      358       .
      359       create buf_user-context-history .
      360       assign
      361         buf_user-context-history.db-num                  = v-db-num
      362         buf_user-context-history.user-id                 = v-user-id
      363         buf_user-context-history.user-context-history-id = 1
      364         buf_user-context-history.cntxt-menu-code         = 0
      365         buf_user-context-history.cntxt-menu-group-id     = v-cntxt-menu-group-id
      366         buf_user-context-history.cntxt-level             = v1-cntxt-level
      367         buf_user-context-history.cntxt-host-code         = v1-cntxt-host-code-obj
      368         buf_user-context-history.cntxt-obj-type          = v1-cntxt-obj-type
      369         buf_user-context-history.cntxt-obj-code          = v1-cntxt-obj-code
      370         buf_user-context-history.cntxt-change-mjd        = 0
      371       .
      372     end.
      373     if p-install = false
      374     then do:
      375       for each buf_user-login
      376       on error undo, return error return-value
      377       :
      378         assign
      379           buf_user-login.status_ = 0
      380         .
      381       end.
      382     end.
      383     return substitute("Обработано записей &1. Ошибок &2"
      384                      ,v-ind
      385                      ,v-err-count
      386                      ) .
      387   end.
