        1   define input parameter p-range-type like ub.code-range.range-type no-undo .
        2   define input parameter p-first-code like ub.code-range.first-code no-undo .
        3   define input parameter p-type-code  as   character                no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Коды используемые в диапазонах".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define temp-table list-code no-undo
      114    field gds-name as character column-label "Товар" format "X(40)"
      115    field b-code   as character column-label "Код" format "X(10)"
      116    field bc-on    as logical   column-label "Вкл" format "+/-"
      117    index bc b-code
      118   .
      119   DEFINE BUTTON b-help DEFAULT
      120        LABEL "Помо&щь"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON b-quit AUTO-GO DEFAULT
      124        LABEL "&Выход"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE VARIABLE f-find-code AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      128        LABEL "Найдено"
      129         VIEW-AS TEXT
      130        SIZE 14 BY .67 NO-UNDO.
      131   DEFINE QUERY BROWSE-1 FOR
      132         list-code SCROLLING.
      133   DEFINE BROWSE BROWSE-1
      134     QUERY BROWSE-1 DISPLAY
      135         list-code.bc-on
      136   list-code.b-code
      137   list-code.gds-name
      138       WITH NO-ROW-MARKERS SEPARATORS SIZE 57.25 BY 17.
      139   DEFINE FRAME v-codes
      140        b-quit AT ROW 1.17 COL 2
      141        b-help AT ROW 1.17 COL 45.5
      142        BROWSE-1 AT ROW 2.5 COL 2.13
      143        f-find-code AT ROW 1.42 COL 21.88 COLON-ALIGNED
      144        SPACE(22.36) SKIP(17.90)
      145       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      146            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      147            TITLE "Коды"
      148            CANCEL-BUTTON b-quit.
      149   ASSIGN
      150          FRAME v-codes:SCROLLABLE       = FALSE
      151          FRAME v-codes:HIDDEN           = TRUE.
      152   ASSIGN
      153          f-find-code:HIDDEN IN FRAME v-codes           = TRUE.
      154   ON WINDOW-CLOSE OF FRAME v-codes
      155   DO:
      156     APPLY "END-ERROR":U TO SELF.
      157   END.
      158   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      159   on help of frame v-codes
      160   do:
      161     run gbl/app_help.p
      162       (input this-procedure :file-name
      163       ,input ''
      164       ,input ?
      165       ) no-error.
      166     if error-status :error then do:
      167       message
      168         "Ошибка при вызове помощи"
      169         error-status :get-message(1)
      170         view-as alert-box .
      171     end.
      172   end.
      173   run minbtn-set in this-procedure .
      174   on choose of b-help in frame v-codes
      175   do:
      176     apply "help":u to frame v-codes .
      177   end.
      178   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   procedure minbtn-set :
      180       do
      181           on error undo, return error return-value
      182           :
      183           define variable ii              as integer       no-undo .
      184           define variable fh              as widget-handle no-undo .
      185           define variable hh              as widget-handle no-undo .
      186           define variable v-h             as handle        extent 4 no-undo .
      187           define variable v-name-button   as character     no-undo .
      188           define variable v-help-old-x    as decimal       no-undo .
      189           define variable v-help-old-y    as decimal       no-undo .
      190           define variable v-help-old-size as decimal       no-undo .
      191           define variable v-frame-width   as decimal       no-undo .
      192           define variable jj              as integer       no-undo .
      193           do
      194               on error undo, return error
      195               :
      196               assign
      197                   v-frame-width = frame v-codes:width - 0.3
      198                   fh            = frame v-codes:first-child
      199                   hh            = fh:first-child
      200                   ii            = 1
      201                   .
      202               do while valid-handle(hh):
      203                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      204                   do:
      205                       case lc(hh:name) :
      206                           when "b-help" then
      207                               do:
      208                                   hh:load-image-up("cmp/b-help.bmp":u) .
      209                                   hh:load-image-down("cmp/b-help.bmp":u) .
      210                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      211                                   hh:TOOLTIP = "Помощь" .
      212                                   v-help-old-x = hh:column .
      213                                   v-help-old-y = hh:row    .
      214                                   v-help-old-size = hh:width .
      215                                   hh:width-chars = 2.5 .
      216                               end.
      217                           when "b-print" then
      218                               do:
      219                                   hh:load-image("cmp/b-print.bmp":u) .
      220                                   hh:TOOLTIP = "Печать" .
      221                                   v-h[ii] = hh:handle .
      222                                   ii = ii + 1 .
      223                                   hh:width-chars = 3 .
      224                               end.
      225                           when "b-history" or
      226                           when "b-hist" then
      227                               do:
      228                                   hh:load-image("cmp/b-hist.bmp":u) .
      229                                   hh:TOOLTIP = "История" .
      230                                   v-h[ii] = hh:handle .
      231                                   ii = ii + 1 .
      232                                   hh:width-chars = 3 .
      233                               end.
      234                           when "b-sch" then
      235                               do:
      236                                   hh:load-image("cmp/b-sch.bmp":u) .
      237                                   hh:TOOLTIP = "Установка Фильтра" .
      238                                   v-h[ii] = hh:handle .
      239                                   ii = ii + 1 .
      240                                   hh:width-chars = 3 .
      241                               end.
      242                           when "b-hist-user" then
      243                               do:
      244                                   hh:load-image("cmp/b-hist.bmp":u) .
      245                                   hh:TOOLTIP = "История пользователя" .
      246                                   ii = ii + 1 .
      247                               end.
      248                       end case.
      249                   end.
      250                   hh = hh:next-sibling.
      251               end.
      252               b-help:column = v-frame-width - b-help:width-chars.
      253               jj = 0.
      254               repeat ii = 4 to 1 by -1 :
      255                   if valid-handle (v-h[ii] ) then
      256                   do:
      257                       jj  = jj + 1 .
      258                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      259                       v-h[ii]:row    = v-help-old-y .
      260                   end.
      261               end.
      262           end.
      263       end.
      264   end procedure.
      265   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      266   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      267   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      268   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      269   define variable v-diasize-current-frame-width  as decimal   no-undo .
      270   define variable v-diasize-current-frame-height as decimal   no-undo .
      271   define variable v-diasize-change-size          as logical   no-undo .
      272   define variable v-diasize-resize-button        as handle    no-undo .
      273   define variable v-diasize-wndmax               as logical   no-undo .
      274   define variable v-diasize-wndstore             as logical   no-undo .
      275   define variable v-diasize-proc-name            as character no-undo .
      276   define variable v-diasize-browse-handle        as handle    no-undo .
      277   define variable v-diasize-browse-number        as integer   no-undo .
      278   define variable v-diasize-need-full-display    as logical   no-undo init false .
      279   define temp-table temp-diasize-handle no-undo
      280     field handle-value  as handle
      281     field save-position as decimal
      282     index xpk is primary unique handle-value
      283     .
      284   define temp-table temp-browse-handle no-undo
      285     field browse-type   as character
      286     field browse-number as integer
      287     field browse-handle as handle
      288     field original-size as decimal
      289     index xpk is primary unique browse-type browse-number
      290     index xie browse-type browse-handle
      291   .
      292   procedure diasize_change-height :
      293     define input  parameter p-change-value  as decimal   no-undo .
      294     define input  parameter p-move-resize   as logical   no-undo .
      295     define variable v-field-group-handle    as handle    no-undo .
      296     define variable v-object-handle         as handle    no-undo .
      297     define variable v-frame-height          as decimal   no-undo .
      298     define variable v-frame-virtual-height  as decimal   no-undo .
      299     define variable v-browse-height         as decimal   no-undo .
      300     define variable v-window-height         as decimal   no-undo .
      301     define variable v-window-virtual-height as decimal   no-undo .
      302     define variable v-change-sign           as integer   no-undo .
      303     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      304     define buffer buf_temp-browse-handle  for temp-browse-handle .
      305     if p-change-value > 0
      306     then do:
      307       if frame v-codes :height + p-change-value
      308           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      309       then do:
      310         assign
      311           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      312                           - (frame v-codes :height-chars)
      313         .
      314         if p-change-value <= 0
      315         then do:
      316           run diasize_position-resize-button in this-procedure .
      317           return .
      318         end.
      319       end.
      320     end.
      321     if p-change-value < 0
      322     then do:
      323       if frame v-codes :height + p-change-value < v-diasize-orig-frame-height
      324       then do:
      325         assign
      326           p-change-value = v-diasize-orig-frame-height
      327                          - (frame v-codes :height-chars)
      328         .
      329         if p-change-value >= 0
      330         then do:
      331           run diasize_position-resize-button in this-procedure .
      332           return .
      333         end.
      334       end.
      335     end.
      336     if p-change-value >= 0
      337     then do:
      338       assign
      339         v-change-sign = 1
      340       .
      341     end.
      342     else do:
      343       assign
      344         v-change-sign = -1
      345       .
      346     end.
      347     assign
      348       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      349     .
      350     if p-change-value = 0
      351     then do:
      352       run diasize_position-resize-button in this-procedure .
      353       return .
      354     end.
      355     move_block:
      356     do
      357     on error undo move_block, retry move_block
      358     :
      359       if retry
      360       then do:
      361         do
      362         on error undo move_block, leave move_block
      363         :
      364           if p-change-value > 0
      365           then do:
      366             for each buf_temp-diasize-handle
      367             on error undo, next
      368             :
      369               assign
      370                 v-object-handle = buf_temp-diasize-handle.handle-value
      371               .
      372               if v-object-handle <> v-diasize-resize-button
      373               then do:
      374                 assign
      375                   v-object-handle :row = buf_temp-diasize-handle.save-position
      376                 .
      377               end.
      378             end.
      379             assign
      380               v-diasize-browse-handle :height = v-browse-height
      381             .
      382             for each buf_temp-browse-handle
      383               where buf_temp-browse-handle.browse-type = 'height':u
      384             on error undo, next
      385             :
      386               assign
      387                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      388               .
      389             end.
      390             assign
      391               frame v-codes :height = v-frame-height
      392             .
      393             if frame v-codes :scrollable = true
      394             then do:
      395               assign
      396                 frame v-codes :virtual-height = v-frame-virtual-height
      397               .
      398             end.
      399             run diasize_position-resize-button in this-procedure .
      400           end.
      401           else do:
      402             if frame v-codes :scrollable = true
      403             then do:
      404               assign
      405                 frame v-codes :virtual-height = v-frame-virtual-height
      406               .
      407             end.
      408             assign
      409               frame v-codes :height = v-frame-height
      410             .
      411             assign
      412               v-diasize-browse-handle :height = v-browse-height
      413             .
      414             for each buf_temp-browse-handle
      415               where buf_temp-browse-handle.browse-type = 'height':u
      416             on error undo, next
      417             :
      418               assign
      419                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      420               .
      421             end.
      422             for each buf_temp-diasize-handle
      423             on error undo, next
      424             :
      425               assign
      426                 v-object-handle = buf_temp-diasize-handle.handle-value
      427               .
      428               if v-object-handle <> v-diasize-resize-button
      429               then do:
      430                 assign
      431                   v-object-handle :row = buf_temp-diasize-handle.save-position
      432                 .
      433               end.
      434             end.
      435             run diasize_position-resize-button in this-procedure .
      436           end.
      437           assign
      438             v-diasize-change-size = false
      439           .
      440           leave move_block .
      441         end.
      442       end.
      443       assign
      444         v-diasize-need-full-display = true
      445       .
      446       if v-diasize-change-size = false
      447       then do:
      448         assign
      449           v-diasize-change-size = true
      450         .
      451       end.
      452       else do:
      453         return .
      454       end.
      455       assign
      456         v-frame-height = frame v-codes :height
      457         v-frame-virtual-height = frame v-codes :virtual-height
      458         v-browse-height = v-diasize-browse-handle :height
      459       .
      460       for each buf_temp-browse-handle
      461         where buf_temp-browse-handle.browse-type = 'height':u
      462       :
      463         assign
      464           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      465         .
      466       end.
      467       for each buf_temp-diasize-handle
      468       :
      469         delete buf_temp-diasize-handle .
      470       end.
      471       assign
      472         v-field-group-handle = frame v-codes :first-child
      473       .
      474       do while valid-handle(v-field-group-handle)
      475       :
      476         assign
      477           v-object-handle = v-field-group-handle :first-child
      478         .
      479         do while valid-handle(v-object-handle)
      480         :
      481           if  v-object-handle <> v-diasize-browse-handle :handle
      482           and can-query(v-object-handle, "row")
      483           and can-query(v-object-handle, "height")
      484           and ( v-object-handle :row > v-diasize-browse-handle :row )
      485           then do:
      486             find first buf_temp-browse-handle
      487               where buf_temp-browse-handle.browse-type   = 'height':u
      488                 and buf_temp-browse-handle.browse-handle = v-object-handle
      489               no-error .
      490             if available buf_temp-browse-handle
      491             then do:
      492             end.
      493             else do:
      494               create buf_temp-diasize-handle .
      495               assign
      496                 buf_temp-diasize-handle.handle-value  = v-object-handle
      497                 buf_temp-diasize-handle.save-position = v-object-handle :row
      498               .
      499             end.
      500           end.
      501           assign
      502             v-object-handle = v-object-handle :next-sibling
      503           .
      504         end.
      505         assign
      506           v-field-group-handle = v-field-group-handle :next-sibling
      507         .
      508       end.
      509       do with frame v-codes
      510       :
      511         hide v-diasize-resize-button .
      512         assign
      513           v-diasize-resize-button :row    = 1
      514           v-diasize-resize-button :column = 1
      515         .
      516       end.
      517       if p-change-value > 0
      518       then do:
      519         if frame v-codes :scrollable = true
      520         then do:
      521           assign
      522             frame v-codes :virtual-height = frame v-codes :virtual-height + p-change-value
      523             no-error .
      524           if error-status :error
      525           or error-status :get-message(1) <> ""
      526           then do:
      527             undo move_block, retry move_block .
      528           end.
      529         end.
      530         assign
      531           frame v-codes :height = frame v-codes :height + p-change-value
      532           no-error .
      533         if error-status :error
      534         or error-status :get-message(1) <> ""
      535         then do:
      536           undo move_block, retry move_block .
      537         end.
      538         assign
      539           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      540           no-error .
      541         if error-status :error
      542         or error-status :get-message(1) <> ""
      543         then do:
      544           undo move_block, retry move_block .
      545         end.
      546         for each buf_temp-browse-handle
      547           where buf_temp-browse-handle.browse-type = 'height':u
      548         on error undo move_block, retry move_block
      549         :
      550           assign
      551             buf_temp-browse-handle.browse-handle :height
      552               = buf_temp-browse-handle.browse-handle :height + p-change-value
      553             no-error .
      554           if error-status :error
      555           or error-status :get-message(1) <> ""
      556           then do:
      557             undo move_block, retry move_block .
      558           end.
      559         end.
      560         for each buf_temp-diasize-handle
      561         on error undo move_block, retry move_block
      562         :
      563           assign
      564             v-object-handle = buf_temp-diasize-handle.handle-value
      565           .
      566           if v-object-handle <> v-diasize-resize-button
      567           then do:
      568             assign
      569               v-object-handle :row = v-object-handle :row + p-change-value
      570               no-error .
      571             if error-status :error
      572             or error-status :get-message(1) <> ""
      573             then do:
      574               undo move_block, retry move_block .
      575             end.
      576           end.
      577         end.
      578       end.
      579       else do:
      580         for each buf_temp-diasize-handle
      581         on error undo move_block, retry move_block
      582         :
      583           assign
      584             v-object-handle = buf_temp-diasize-handle.handle-value
      585           .
      586           if v-object-handle <> v-diasize-resize-button
      587           then do:
      588             assign
      589               v-object-handle :row = v-object-handle :row + p-change-value
      590               no-error .
      591             if error-status :error
      592             or error-status :get-message(1) <> ""
      593             then do:
      594               undo move_block, retry move_block .
      595             end.
      596           end.
      597         end.
      598         assign
      599           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      600           no-error .
      601         if error-status :error
      602         or error-status :get-message(1) <> ""
      603         then do:
      604           undo move_block, retry move_block .
      605         end.
      606         for each buf_temp-browse-handle
      607           where buf_temp-browse-handle.browse-type = 'height':u
      608         on error undo move_block, retry move_block
      609         :
      610           assign
      611             buf_temp-browse-handle.browse-handle :height
      612               = buf_temp-browse-handle.browse-handle :height + p-change-value
      613             no-error .
      614           if error-status :error
      615           or error-status :get-message(1) <> ""
      616           then do:
      617             undo move_block, retry move_block .
      618           end.
      619         end.
      620         assign
      621           frame v-codes :height = frame v-codes :height + p-change-value
      622           no-error .
      623         if error-status :error
      624         or error-status :get-message(1) <> ""
      625         then do:
      626           undo move_block, retry move_block .
      627         end.
      628         if frame v-codes :scrollable = true
      629         then do:
      630           assign
      631             frame v-codes :virtual-height = frame v-codes :virtual-height + p-change-value
      632             no-error .
      633           if error-status :error
      634           or error-status :get-message(1) <> ""
      635           then do:
      636             undo move_block, retry move_block .
      637           end.
      638         end.
      639       end.
      640       if p-move-resize = true
      641       then do:
      642         run diasize_position-resize-button in this-procedure .
      643       end.
      644       if v-diasize-wndstore = true
      645       then do:
      646         if connected("ub") = true
      647         then do:
      648           define variable v-cntxt-db-num        as integer   no-undo .
      649           define variable v-cntxt-userid        as character no-undo .
      650           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      651                                             , OUTPUT v-cntxt-userid
      652                                             ) .
      653           run gbl/wndsizew.p
      654             (input  v-cntxt-db-num
      655             ,input  v-cntxt-userid
      656             ,input  v-diasize-proc-name
      657             ,input  'height':u
      658             ,input  string(frame v-codes :height - v-diasize-orig-frame-height)
      659             ) .
      660         end.
      661       end.
      662     end.
      663     assign
      664       v-diasize-change-size = false
      665     .
      666   end procedure.
      667   procedure diasize_set-height :
      668     define input  parameter p-new-height  as decimal   no-undo .
      669     define input  parameter p-move-resize as logical   no-undo .
      670     do
      671     on error undo, return error return-value
      672     :
      673       run diasize_change-height in this-procedure
      674         (input  (p-new-height - frame v-codes :height)
      675         ,input  p-move-resize
      676         ) .
      677     end.
      678   end procedure.
      679   procedure diasize_change-width :
      680     define input  parameter p-change-value as decimal   no-undo .
      681     define input  parameter p-move-resize  as logical   no-undo .
      682     define variable v-field-group-handle   as handle    no-undo .
      683     define variable v-object-handle        as handle    no-undo .
      684     define variable v-frame-width          as decimal   no-undo .
      685     define variable v-frame-virtual-width  as decimal   no-undo .
      686     define variable v-browse-width         as decimal   no-undo .
      687     define variable v-window-width         as decimal   no-undo .
      688     define variable v-window-virtual-width as decimal   no-undo .
      689     define variable v-change-sign          as integer   no-undo .
      690     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      691     define buffer buf_temp-browse-handle  for temp-browse-handle .
      692     if p-change-value > 0
      693     then do:
      694       if frame v-codes :width + p-change-value >
      695           session :width-chars
      696       then do:
      697         assign
      698           p-change-value = session :width-chars - frame v-codes :width
      699         .
      700         if p-change-value <= 0
      701         then do:
      702           run diasize_position-resize-button in this-procedure .
      703           return .
      704         end.
      705       end.
      706     end.
      707     if p-change-value < 0
      708     then do:
      709       if frame v-codes :width + p-change-value < v-diasize-orig-frame-width
      710       then do:
      711         assign
      712           p-change-value = v-diasize-orig-frame-width
      713                          - frame v-codes :width
      714         .
      715         if p-change-value >= 0
      716         then do:
      717           run diasize_position-resize-button in this-procedure .
      718           return .
      719         end.
      720       end.
      721     end.
      722     if p-change-value >= 0
      723     then do:
      724       assign
      725         v-change-sign = 1
      726       .
      727     end.
      728     else do:
      729       assign
      730         v-change-sign = -1
      731       .
      732     end.
      733     assign
      734       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      735     .
      736     if p-change-value = 0
      737     then do:
      738       run diasize_position-resize-button in this-procedure .
      739       return .
      740     end.
      741     move_block:
      742     do
      743     on error undo move_block, leave move_block
      744     :
      745       if retry
      746       then do:
      747         do
      748         on error undo move_block, leave move_block
      749         :
      750           if p-change-value > 0
      751           then do:
      752             for each buf_temp-diasize-handle
      753             on error undo, next
      754             :
      755               assign
      756                 v-object-handle = buf_temp-diasize-handle.handle-value
      757               .
      758               if v-object-handle <> v-diasize-resize-button
      759               then do:
      760                 assign
      761                   v-object-handle :col = buf_temp-diasize-handle.save-position
      762                 .
      763               end.
      764             end.
      765             assign
      766               v-diasize-browse-handle :width = v-browse-width
      767             .
      768             for each buf_temp-browse-handle
      769               where buf_temp-browse-handle.browse-type = 'width':u
      770             on error undo, next
      771             :
      772               assign
      773                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      774               .
      775             end.
      776             assign
      777               frame v-codes :width = v-frame-width
      778             .
      779             if frame v-codes :scrollable = true
      780             then do:
      781               assign
      782                 frame v-codes :virtual-width = v-frame-virtual-width
      783               .
      784             end.
      785             run diasize_position-resize-button in this-procedure .
      786           end.
      787           else do:
      788             if frame v-codes :scrollable = true
      789             then do:
      790               assign
      791                 frame v-codes :virtual-width = v-frame-virtual-width
      792               .
      793             end.
      794             assign
      795               frame v-codes :width = v-frame-width
      796             .
      797             for each buf_temp-browse-handle
      798               where buf_temp-browse-handle.browse-type = 'width':u
      799             on error undo, next
      800             :
      801               assign
      802                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      803               .
      804             end.
      805             assign
      806               v-diasize-browse-handle :width = v-browse-width
      807             .
      808             for each buf_temp-diasize-handle
      809             on error undo, next
      810             :
      811               assign
      812                 v-object-handle = buf_temp-diasize-handle.handle-value
      813               .
      814               if v-object-handle <> v-diasize-resize-button
      815               then do:
      816                 assign
      817                   v-object-handle :col = buf_temp-diasize-handle.save-position
      818                 .
      819               end.
      820             end.
      821             run diasize_position-resize-button in this-procedure .
      822           end.
      823           assign
      824             v-diasize-change-size = false
      825           .
      826           leave move_block .
      827         end.
      828       end.
      829       assign
      830         v-diasize-need-full-display = true
      831       .
      832       if v-diasize-change-size = false
      833       then do:
      834         assign
      835           v-diasize-change-size = true
      836         .
      837       end.
      838       else do:
      839         return .
      840       end.
      841       assign
      842         v-frame-width = frame v-codes :width
      843         v-frame-virtual-width = frame v-codes :virtual-width
      844         v-browse-width = v-diasize-browse-handle :width
      845       .
      846       for each buf_temp-browse-handle
      847         where buf_temp-browse-handle.browse-type = 'width':u
      848       :
      849         assign
      850           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      851         .
      852       end.
      853       for each buf_temp-diasize-handle
      854       :
      855         delete buf_temp-diasize-handle .
      856       end.
      857       assign
      858         v-field-group-handle = frame v-codes :first-child
      859       .
      860       do while valid-handle(v-field-group-handle)
      861       :
      862         assign
      863           v-object-handle = v-field-group-handle :first-child
      864         .
      865         do while valid-handle(v-object-handle)
      866         :
      867           if  v-object-handle <> v-diasize-browse-handle :handle
      868           and v-object-handle <> v-diasize-resize-button
      869           and can-query(v-object-handle, "row")
      870           and can-query(v-object-handle, "height")
      871           and ( v-object-handle :col + v-object-handle :width
      872                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      873               )
      874           then do:
      875             find first buf_temp-browse-handle
      876               where buf_temp-browse-handle.browse-type   = 'width':u
      877                 and buf_temp-browse-handle.browse-handle = v-object-handle
      878               no-error .
      879             if available buf_temp-browse-handle
      880             then do:
      881             end.
      882             else do:
      883               create buf_temp-diasize-handle .
      884               assign
      885                 buf_temp-diasize-handle.handle-value  = v-object-handle
      886                 buf_temp-diasize-handle.save-position = v-object-handle :col
      887               .
      888             end.
      889           end.
      890           assign
      891             v-object-handle = v-object-handle :next-sibling
      892           .
      893         end.
      894         assign
      895           v-field-group-handle = v-field-group-handle :next-sibling
      896         .
      897       end.
      898       do with frame v-codes
      899       :
      900         hide v-diasize-resize-button .
      901         v-diasize-resize-button :row = 1.
      902         v-diasize-resize-button :column = 1.
      903       end.
      904       if p-change-value > 0
      905       then do:
      906         if frame v-codes :scrollable = true
      907         then do:
      908           assign
      909             frame v-codes :virtual-width = frame v-codes :virtual-width + p-change-value
      910             no-error .
      911           if error-status :error
      912           or error-status :get-message(1) <> ""
      913           then do:
      914             undo move_block, retry move_block.
      915           end.
      916         end.
      917         assign
      918           frame v-codes :width = v-frame-width + p-change-value
      919           no-error .
      920         if error-status :error
      921         or error-status :get-message(1) <> ""
      922         then do:
      923           undo move_block, retry move_block.
      924         end.
      925         assign
      926           v-diasize-browse-handle :width = v-browse-width + p-change-value
      927         no-error .
      928         if error-status :error
      929         or error-status :get-message(1) <> ""
      930         then do:
      931           undo move_block, retry move_block.
      932         end.
      933         for each buf_temp-browse-handle
      934           where buf_temp-browse-handle.browse-type = 'width':u
      935         on error undo move_block, retry move_block
      936         :
      937           assign
      938             buf_temp-browse-handle.browse-handle :width
      939               = buf_temp-browse-handle.browse-handle :width + p-change-value
      940             no-error .
      941           if error-status :error
      942           or error-status :get-message(1) <> ""
      943           then do:
      944             undo move_block, retry move_block .
      945           end.
      946         end.
      947         for each buf_temp-diasize-handle
      948         on error undo move_block, retry move_block
      949         :
      950           assign
      951             v-object-handle = buf_temp-diasize-handle.handle-value
      952           .
      953           if v-object-handle <> v-diasize-resize-button
      954           then do:
      955             assign
      956               v-object-handle :col = v-object-handle :col + p-change-value
      957               no-error .
      958             if error-status :error
      959             or error-status :get-message(1) <> ""
      960             then do:
      961               undo move_block, retry move_block .
      962             end.
      963           end.
      964         end.
      965       end.
      966       else do:
      967         for each buf_temp-diasize-handle
      968         on error undo move_block, retry move_block
      969         :
      970           assign
      971             v-object-handle = buf_temp-diasize-handle.handle-value
      972           .
      973           if v-object-handle <> v-diasize-resize-button
      974           then do:
      975             assign
      976               v-object-handle :col = v-object-handle :col + p-change-value
      977               no-error .
      978             if error-status :error
      979             or error-status :get-message(1) <> ""
      980             then do:
      981               undo move_block, retry move_block .
      982             end.
      983           end.
      984         end.
      985         for each buf_temp-browse-handle
      986           where buf_temp-browse-handle.browse-type = 'width':u
      987         on error undo move_block, retry move_block
      988         :
      989           assign
      990             buf_temp-browse-handle.browse-handle :width
      991               = buf_temp-browse-handle.browse-handle :width + p-change-value
      992             no-error .
      993           if error-status :error
      994           or error-status :get-message(1) <> ""
      995           then do:
      996             undo move_block, retry move_block .
      997           end.
      998         end.
      999         assign
     1000           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1001           no-error .
     1002         if error-status :error
     1003         or error-status :get-message(1) <> ""
     1004         then do:
     1005           undo move_block, retry move_block.
     1006         end.
     1007         assign
     1008           frame v-codes :width = frame v-codes :width + p-change-value
     1009         no-error .
     1010         if error-status :error
     1011         or error-status :get-message(1) <> ""
     1012         then do:
     1013           undo move_block, retry move_block.
     1014         end.
     1015         if frame v-codes :scrollable = true
     1016         then do:
     1017           assign
     1018             frame v-codes :virtual-width = frame v-codes :virtual-width + p-change-value
     1019           no-error .
     1020           if error-status :error
     1021           or error-status :get-message(1) <> ""
     1022           then do:
     1023             undo move_block, retry move_block.
     1024           end.
     1025         end.
     1026       end.
     1027       if p-move-resize
     1028       then do:
     1029         run diasize_position-resize-button in this-procedure .
     1030       end.
     1031       if v-diasize-wndstore = true
     1032       then do:
     1033         if connected("ub") = true
     1034         then do:
     1035           define variable v-cntxt-db-num        as integer   no-undo .
     1036           define variable v-cntxt-userid        as character no-undo .
     1037           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1038                                             , OUTPUT v-cntxt-userid
     1039                                             ) .
     1040           run gbl/wndsizew.p
     1041             (input  v-cntxt-db-num
     1042             ,input  v-cntxt-userid
     1043             ,input  v-diasize-proc-name
     1044             ,input  'width':u
     1045             ,input  string(frame v-codes :width - v-diasize-orig-frame-width)
     1046             ) .
     1047         end.
     1048       end.
     1049     end.
     1050     assign
     1051       v-diasize-change-size = false
     1052     .
     1053   end procedure.
     1054   procedure diasize_set-width :
     1055     define input  parameter p-new-width  as decimal   no-undo .
     1056     define input  parameter p-move-resize as logical   no-undo .
     1057     do
     1058     on error undo, return error return-value
     1059     :
     1060       run diasize_change-width in this-procedure
     1061         (input  (p-new-width - frame v-codes :width)
     1062         ,input  p-move-resize
     1063         ) .
     1064     end.
     1065   end procedure.
     1066   procedure diasize_position-resize-button :
     1067     do with frame v-codes
     1068     :
     1069       hide v-diasize-resize-button .
     1070       assign
     1071         v-diasize-resize-button :row = frame v-codes :height - v-diasize-resize-button :height
     1072                     - 1
     1073                     - (frame v-codes :border-bottom-pixels / session :pixels-per-row)
     1074         v-diasize-resize-button :col = frame v-codes :width - v-diasize-resize-button :width
     1075                     - 1
     1076                     - (frame v-codes :border-right-pixels / session :pixels-per-column)
     1077       .
     1078       view v-diasize-resize-button .
     1079     end.
     1080   end procedure.
     1081   on alt-right anywhere
     1082   do:
     1083     run diasize_change-width in this-procedure
     1084       (input 1
     1085       ,input true
     1086       ) .
     1087     return no-apply .
     1088   end.
     1089   on alt-left anywhere
     1090   do:
     1091     run diasize_change-width in this-procedure
     1092       (input -1
     1093       ,input true
     1094       ) .
     1095     return no-apply .
     1096   end.
     1097   on alt-down anywhere
     1098   do:
     1099     run diasize_change-height in this-procedure
     1100       (input 1
     1101       ,input true
     1102       ) .
     1103     return no-apply .
     1104   end.
     1105   on alt-up anywhere
     1106   do:
     1107     run diasize_change-height in this-procedure
     1108       (input -1
     1109       ,input true
     1110       ) .
     1111     return no-apply .
     1112   end.
     1113   on alt-enter of frame v-codes
     1114   do:
     1115     run diasize_maximize in this-procedure
     1116       (input  ?
     1117       ).
     1118     return no-apply .
     1119   end.
     1120   procedure diasize_end-move :
     1121     do
     1122     on error undo, return error return-value
     1123     :
     1124       define variable v-row-delta as decimal   no-undo .
     1125       define variable v-col-delta as decimal   no-undo .
     1126       define variable v-new-row as decimal   no-undo .
     1127       define variable v-new-col as decimal   no-undo .
     1128       assign
     1129         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1130         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1131       .
     1132       assign
     1133         v-row-delta = v-new-row - frame v-codes :height
     1134         v-col-delta = v-new-col - frame v-codes :width
     1135       .
     1136       run diasize_change-height in this-procedure
     1137         (input v-row-delta
     1138         ,input true
     1139         ) .
     1140       run diasize_change-width in this-procedure
     1141         (input v-col-delta
     1142         ,input true
     1143         ) .
     1144     end.
     1145   end procedure.
     1146   procedure diasize_maximize :
     1147     define input  parameter p-action as logical   no-undo .
     1148     do
     1149     on error undo, return error return-value
     1150     :
     1151       if p-action = ?
     1152       then do:
     1153         if v-diasize-need-maximize = true
     1154         then do:
     1155           assign
     1156             p-action = true
     1157           .
     1158         end.
     1159         else do:
     1160           assign
     1161             p-action = false
     1162           .
     1163         end.
     1164       end.
     1165       if p-action = true
     1166       then do:
     1167         run diasize_change-height in this-procedure
     1168           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1169               - frame v-codes :height-chars
     1170           ,input true
     1171           ) .
     1172         run diasize_change-width in this-procedure
     1173           (input session :width-chars
     1174               - frame v-codes :width-chars
     1175           ,input true
     1176           ) .
     1177         assign
     1178           v-diasize-need-maximize = false
     1179         .
     1180       end.
     1181       else do:
     1182         run diasize_change-width in this-procedure
     1183           (input v-diasize-orig-frame-width
     1184               - frame v-codes :width-chars
     1185           ,input true
     1186           ) .
     1187         run diasize_change-height in this-procedure
     1188           (input v-diasize-orig-frame-height
     1189               - frame v-codes :height-chars
     1190           ,input true
     1191           ) .
     1192         assign
     1193           v-diasize-need-maximize = true
     1194         .
     1195       end.
     1196     end.
     1197   end procedure.
     1198   procedure diasize_restore-orig-size :
     1199     do
     1200     on error undo, return error return-value
     1201     :
     1202       assign
     1203         v-diasize-current-frame-width  = frame v-codes :width
     1204         v-diasize-current-frame-height = frame v-codes :height
     1205       .
     1206       run diasize_set-height in this-procedure
     1207         (input  v-diasize-orig-frame-height
     1208         ,input  true
     1209         ) .
     1210       run diasize_set-width in this-procedure
     1211         (input  v-diasize-orig-frame-width
     1212         ,input  true
     1213         ) .
     1214     end.
     1215   end procedure.
     1216   procedure diasize_restore-current-size :
     1217     do
     1218     on error undo, return error return-value
     1219     :
     1220       run diasize_set-height in this-procedure
     1221         (input  v-diasize-current-frame-height
     1222         ,input  true
     1223         ) .
     1224       run diasize_set-width in this-procedure
     1225         (input  v-diasize-current-frame-width
     1226         ,input  true
     1227         ) .
     1228     end.
     1229   end procedure.
     1230   procedure diasize_set-browse-handle :
     1231     define input  parameter p-browse-handle as handle   no-undo .
     1232     define buffer buf_temp-browse-handle for temp-browse-handle .
     1233     do
     1234     on error undo, return error return-value
     1235     :
     1236       assign
     1237         v-diasize-browse-handle = p-browse-handle
     1238       .
     1239       for each buf_temp-browse-handle
     1240       on error undo, return error return-value
     1241       :
     1242         delete buf_temp-browse-handle .
     1243       end.
     1244     end.
     1245   end procedure.
     1246   procedure diasize_add_browse :
     1247     define input  parameter p-browse-type   as character no-undo .
     1248     define input  parameter p-browse-handle as handle    no-undo .
     1249     define buffer buf_temp-browse-handle for temp-browse-handle .
     1250     do
     1251     on error undo, return error return-value
     1252     :
     1253       assign
     1254         v-diasize-browse-number = v-diasize-browse-number + 1
     1255       .
     1256       create buf_temp-browse-handle .
     1257       assign
     1258         buf_temp-browse-handle.browse-type   = p-browse-type
     1259         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1260         buf_temp-browse-handle.browse-handle = p-browse-handle
     1261       .
     1262     end.
     1263   end procedure.
     1264   procedure diasize_init :
     1265     define variable v-default-value    as logical   no-undo .
     1266     define variable v-restore-saved    as logical   no-undo .
     1267     define variable v-resize-value-str as character no-undo .
     1268     do
     1269     on error undo, return error return-value
     1270     :
     1271       do with frame v-codes
     1272       :
     1273         assign
     1274           v-diasize-orig-frame-height = frame v-codes :height
     1275           v-diasize-orig-frame-width  = frame v-codes :width
     1276           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1277         .
     1278         create button v-diasize-resize-button
     1279         assign
     1280           parent        = frame v-codes :first-child
     1281           label         = "s"
     1282           height-pixels = 16
     1283           width-pixels  = 16
     1284           visible       = true
     1285           sensitive     = true
     1286           movable       = true
     1287           triggers:
     1288             on end-move persistent run diasize_end-move in this-procedure .
     1289           end triggers.
     1290         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1291         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1292         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1293         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1294         assign
     1295           v-diasize-wndmax = false
     1296         .
     1297         if connected("ub") = true
     1298         then do:
     1299           define variable v-cntxt-db-num        as integer   no-undo .
     1300           define variable v-cntxt-userid        as character no-undo .
     1301           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1302                                             , OUTPUT v-cntxt-userid
     1303                                             ) .
     1304           run gbl/wndpar_r.p
     1305             (input  v-cntxt-db-num
     1306             ,input  v-cntxt-userid
     1307             ,input  'wndmax':U
     1308             ,output v-diasize-wndmax
     1309             ,output v-default-value
     1310             ) .
     1311         end.
     1312         assign
     1313           v-diasize-wndstore = false
     1314         .
     1315         if connected("ub") = true
     1316         then do:
     1317           run gbl/wndpar_r.p
     1318             (input  v-cntxt-db-num
     1319             ,input  v-cntxt-userid
     1320             ,input  'wndstore':U
     1321             ,output v-diasize-wndstore
     1322             ,output v-default-value
     1323             ) .
     1324         end.
     1325         assign
     1326           v-diasize-proc-name = entry(1, program-name(2), '.')
     1327         .
     1328         if v-diasize-wndstore = true
     1329         then do:
     1330           assign
     1331             v-restore-saved = false
     1332           .
     1333           if connected("ub") = true
     1334           then do:
     1335             run gbl/wndsizer.p
     1336               (input  v-cntxt-db-num
     1337               ,input  v-cntxt-userid
     1338               ,input  v-diasize-proc-name
     1339               ,input  'height':u
     1340               ,output v-resize-value-str
     1341               ) .
     1342             if v-resize-value-str <> '':U
     1343             then do:
     1344               run diasize_change-height in this-procedure
     1345                 (input  integer(v-resize-value-str)
     1346                 ,input  true
     1347                 ) .
     1348               assign
     1349                 v-restore-saved = true
     1350               .
     1351             end.
     1352           end.
     1353           if connected("ub") = true
     1354           then do:
     1355             run gbl/wndsizer.p
     1356               (input  v-cntxt-db-num
     1357               ,input  v-cntxt-userid
     1358               ,input  v-diasize-proc-name
     1359               ,input  'width':u
     1360               ,output v-resize-value-str
     1361               ) .
     1362             if v-resize-value-str <> '':U
     1363             then do:
     1364               run diasize_change-width in this-procedure
     1365                 (input  integer(v-resize-value-str)
     1366                 ,input  true
     1367                 ) .
     1368               assign
     1369                 v-restore-saved = true
     1370               .
     1371             end.
     1372           end.
     1373           if v-restore-saved <> true
     1374           then do:
     1375             if v-diasize-wndmax = true
     1376             then do:
     1377               run diasize_maximize in this-procedure
     1378                 (input  true
     1379                 ) .
     1380             end.
     1381           end.
     1382         end.
     1383         else do:
     1384           if v-diasize-wndmax = true
     1385           then do:
     1386             run diasize_maximize in this-procedure
     1387               (input  true
     1388               ) .
     1389           end.
     1390         end.
     1391       end.
     1392     end.
     1393   end procedure.
     1394   procedure diasize_need-full-display :
     1395     define output parameter p-need-full-display as logical   no-undo .
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399       assign
     1400         p-need-full-display = v-diasize-need-full-display
     1401       .
     1402       assign
     1403         v-diasize-need-full-display = false
     1404       .
     1405     end.
     1406   end procedure.
     1407   procedure get-context :
     1408      define output parameter p-db-num as integer          no-undo.
     1409      define output parameter p-user-id as character        no-undo.
     1410      define variable v-login               as character    no-undo.
     1411      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1412      define buffer buf_user-login  for ub.user-login .
     1413      do
     1414      on error undo, return error
     1415      :
     1416            FIND FIRST buf_sys-ctrl no-lock.
     1417            ASSIGN
     1418               v-login = USERID("ub")
     1419               p-db-num = buf_sys-ctrl.db-num
     1420            .
     1421            FIND FIRST buf_user-login
     1422                 WHERE buf_user-login.db-num = p-db-num
     1423                   AND buf_user-login.user-login = v-login
     1424                 no-lock
     1425                 no-error
     1426                 .
     1427            IF AVAILABLE buf_user-login
     1428            THEN DO:
     1429               assign
     1430                  p-user-id = buf_user-login.user-id
     1431               .
     1432            END.
     1433      end.
     1434   end procedure.
     1435       run diasize_init in this-procedure .
     1436   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-codes:PARENT eq ?
     1437   THEN FRAME v-codes:PARENT = ACTIVE-WINDOW.
     1438   MAIN-BLOCK:
     1439   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1440      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1441     define buffer buf1_code-range for ub.code-range .
     1442     find first buf1_code-range no-lock
     1443       where buf1_code-range.range-type = p-range-type
     1444         and buf1_code-range.first-code = p-first-code
     1445     .
     1446     assign
     1447       FRAME v-codes:title = substitute( "Коды в диапазоне &1 c &2 по &3", p-type-code, p-first-code, buf1_code-range.last-code )
     1448     .
     1449     RUN enable_UI.
     1450     run fill-tt in this-procedure
     1451       ( input p-range-type
     1452        ,input p-first-code
     1453        ,output f-find-code
     1454       )
     1455     .
     1456     display
     1457       f-find-code
     1458       with frame v-codes
     1459     .
     1460     OPEN QUERY BROWSE-1 FOR EACH list-code BY b-code.
     1461     WAIT-FOR GO OF FRAME v-codes focus browse BROWSE-1.
     1462   END.
     1463   RUN disable_UI.
     1464   PROCEDURE disable_UI :
     1465     HIDE FRAME v-codes.
     1466   END PROCEDURE.
     1467   PROCEDURE enable_UI :
     1468     ENABLE b-quit b-help BROWSE-1
     1469         WITH FRAME v-codes.
     1470     VIEW FRAME v-codes.
     1471     OPEN QUERY BROWSE-1 FOR EACH list-code BY b-code.
     1472   END PROCEDURE.
     1473   PROCEDURE fill-tt :
     1474   define input  parameter p1-range-type like ub.code-range.range-type no-undo .
     1475     define input  parameter p1-first-code like ub.code-range.first-code no-undo .
     1476     define output parameter p-find-code   as   integer                  no-undo .
     1477     do
     1478     on error undo, return error
     1479     :
     1480       define variable v-integer   as integer   no-undo .
     1481       define variable v-ind       as integer   no-undo .
     1482       define variable v-str       as character no-undo .
     1483       define variable v-view-code as integer   no-undo .
     1484       define variable v-find-code as integer   no-undo .
     1485       define frame inf
     1486         v-view-code label "Просмотрено" skip
     1487         v-find-code label "Найдено" skip
     1488         with view-as dialog-box side-labels 1 columns three-d title "Поиск кодов".
     1489       define buffer buf_code-range for ub.code-range .
     1490       define buffer buf_goods for ub.goods .
     1491       define buffer buf_bar-code for ub.bar-code .
     1492       define buffer buf_prod-bc for ub.prod-bc .
     1493       define buffer buf_dis-card for ub.dis-card.
     1494       define buffer buf_dis-rule for ub.dis-rule.
     1495       define buffer buf_dis-time-rule for ub.dis-time-rule.
     1496       define buffer buf_firm  for ub.firm .
     1497       define buffer buf_person  for ub.person .
     1498       define buffer buf_clients for ub.clients.
     1499       define buffer buf_contract for ub.contract .
     1500       define buffer buf_rule-by-call for ub.rule-by-call.
     1501       define buffer buf_sysconf for ub.sysconf.
     1502       define buffer buf_fin-doc for ub.fin-doc.
     1503       find first buf_code-range no-lock
     1504         where buf_code-range.range-type = p1-range-type
     1505           and buf_code-range.first-code = p1-first-code
     1506       .
     1507       assign
     1508         v-view-code = 0
     1509         v-find-code = 0
     1510       .
     1511       view frame inf.
     1512       case buf_code-range.range-type :
     1513         when 'bcgb':U
     1514         then do:
     1515           for each buf_bar-code no-lock
     1516             where buf_bar-code.b-code >= buf_code-range.first-code
     1517               and buf_bar-code.b-code <= buf_code-range.last-code
     1518           on error undo, return error
     1519           :
     1520             find first buf_goods no-lock
     1521               where buf_goods.gds-code = buf_bar-code.gds-code
     1522               no-error
     1523             .
     1524             create list-code .
     1525             assign
     1526               list-code.gds-name = (if available buf_goods then buf_goods.gds-name else "":U)
     1527               list-code.b-code   = string( buf_bar-code.b-code )
     1528               list-code.bc-on    = true
     1529               v-find-code = v-find-code + 1
     1530               v-view-code = v-view-code + 1
     1531             .
     1532             if ( v-view-code modulo 100 ) = 0 then do:
     1533               display
     1534                 v-view-code
     1535                 v-find-code
     1536                 with frame inf.
     1537             end.
     1538           end.
     1539         end.
     1540         when 'scgb':U
     1541         or when 'sclc':U
     1542         or when 'pglc':U
     1543         or when 'ptlc':U
     1544         or when 'sslc':U
     1545         or when 'ssgb':U
     1546         then do:
     1547           for each buf_prod-bc no-lock
     1548           on error undo, return error
     1549           :
     1550             if length( buf_prod-bc.b-str ) < 6 then do:
     1551               find first buf_bar-code no-lock
     1552                 where buf_bar-code.b-code = buf_prod-bc.b-code
     1553               .
     1554               if available buf_bar-code then do:
     1555                 find first buf_goods no-lock
     1556                   where buf_goods.gds-code = buf_bar-code.gds-code
     1557                   no-error
     1558                 .
     1559               end.
     1560               assign
     1561                 v-integer = integer( buf_prod-bc.b-str ) no-error
     1562               .
     1563               assign
     1564                 v-str     = buf_prod-bc.b-str
     1565                 v-ind     = 6 - length( v-str )
     1566               .
     1567               do while v-ind > 0
     1568               on error undo, return error
     1569               :
     1570                 assign
     1571                   v-str = "0" + v-str
     1572                   v-ind = v-ind - 1
     1573                 .
     1574               end.
     1575               if string( v-integer, "999999" ) = v-str
     1576                 and v-integer >= buf_code-range.first-code
     1577                 and v-integer <= buf_code-range.last-code
     1578               then do:
     1579                 create list-code .
     1580                 assign
     1581                   list-code.gds-name = (if available buf_goods then buf_goods.gds-name else "":U)
     1582                   list-code.b-code   = string( buf_prod-bc.b-str )
     1583                   list-code.bc-on    = buf_prod-bc.bc-on
     1584                   v-find-code = v-find-code + 1
     1585                 .
     1586               end.
     1587             end.
     1588             assign
     1589               v-view-code = v-view-code + 1
     1590             .
     1591             if ( v-view-code modulo 100 ) = 0 then do:
     1592               display
     1593                 v-view-code
     1594                 v-find-code
     1595                 with frame inf.
     1596             end.
     1597           end.
     1598         end.
     1599         when 'dcgb':U
     1600         then do:
     1601           for each buf_dis-card no-lock
     1602             where buf_dis-card.card-num >= buf_code-range.first-code
     1603               and buf_dis-card.card-num <= buf_code-range.last-code
     1604           on error undo, return error
     1605           :
     1606             create list-code .
     1607             assign
     1608               list-code.gds-name = buf_dis-card.d-card  + chr(32) + buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1609               list-code.b-code   = string( buf_dis-card.card-num )
     1610               list-code.bc-on    = true
     1611               v-find-code = v-find-code + 1
     1612               v-view-code = v-view-code + 1
     1613             .
     1614             if ( v-view-code modulo 100 ) = 0 then do:
     1615               display
     1616                 v-view-code
     1617                 v-find-code
     1618                 with frame inf.
     1619             end.
     1620           end.
     1621         end.
     1622         when 'ctgb':U
     1623         then do:
     1624           for each buf_contract no-lock
     1625             where buf_contract.contract-code >= buf_code-range.first-code
     1626               and buf_contract.contract-code <= buf_code-range.last-code
     1627           on error undo, return error
     1628           :
     1629             create list-code .
     1630             assign
     1631               list-code.gds-name = buf_contract.contract-prn-code  + chr(32) + buf_contract.cli-type + string(buf_contract.cli-code)
     1632               list-code.b-code   = string( buf_contract.contract-code )
     1633               list-code.bc-on    = true
     1634               v-find-code = v-find-code + 1
     1635               v-view-code = v-view-code + 1
     1636             .
     1637             if ( v-view-code modulo 100 ) = 0 then do:
     1638               display
     1639                 v-view-code
     1640                 v-find-code
     1641                 with frame inf.
     1642             end.
     1643           end.
     1644         end.
     1645         when 'fmgb':U
     1646         then do:
     1647           for each buf_firm no-lock
     1648             where buf_firm.firm-code >= buf_code-range.first-code
     1649               and buf_firm.firm-code <= buf_code-range.last-code
     1650           on error undo, return error
     1651           :
     1652             find first buf_clients no-lock where
     1653                       buf_clients.obj-type = 'орг':U
     1654                   and buf_clients.obj-code = buf_firm.firm-code.
     1655             create list-code .
     1656             assign
     1657               list-code.gds-name = substitute("&1&2 &3"
     1658                                                , buf_clients.obj-type
     1659                                                , buf_clients.obj-code
     1660                                                , buf_clients.obj-name)
     1661               list-code.b-code   = string( buf_firm.firm-code )
     1662               list-code.bc-on    = true
     1663               v-find-code = v-find-code + 1
     1664               v-view-code = v-view-code + 1
     1665             .
     1666             if ( v-view-code modulo 100 ) = 0 then do:
     1667               display
     1668                 v-view-code
     1669                 v-find-code
     1670                 with frame inf.
     1671             end.
     1672           end.
     1673         end.
     1674         when 'pngb':U
     1675         then do:
     1676           for each buf_person no-lock
     1677             where buf_person.psn-code >= buf_code-range.first-code
     1678               and buf_person.psn-code <= buf_code-range.last-code
     1679           on error undo, return error
     1680           :
     1681             find first buf_clients no-lock where
     1682                       buf_clients.obj-type = 'чел':U
     1683                   and buf_clients.obj-code = buf_person.psn-code.
     1684             create list-code .
     1685             assign
     1686               list-code.gds-name = substitute("&1&2 &3"
     1687                                                , buf_clients.obj-type
     1688                                                , buf_clients.obj-code
     1689                                                , buf_clients.obj-name)
     1690               list-code.b-code   = string( buf_person.psn-code )
     1691               list-code.bc-on    = true
     1692               v-find-code = v-find-code + 1
     1693               v-view-code = v-view-code + 1
     1694             .
     1695             if ( v-view-code modulo 100 ) = 0 then do:
     1696               display
     1697                 v-view-code
     1698                 v-find-code
     1699                 with frame inf.
     1700             end.
     1701           end.
     1702         end.
     1703         when 'drgb':U then do:
     1704           for each buf_dis-rule no-lock
     1705             where buf_dis-rule.rule-num >= buf_code-range.first-code
     1706               and buf_dis-rule.rule-num <= buf_code-range.last-code
     1707           on error undo, return error
     1708           :
     1709             create list-code .
     1710             assign
     1711               list-code.gds-name = buf_dis-rule.des
     1712               list-code.b-code   = string( buf_dis-rule.rule-num )
     1713               list-code.bc-on    = true
     1714               v-find-code = v-find-code + 1
     1715               v-view-code = v-view-code + 1
     1716             .
     1717             if ( v-view-code modulo 100 ) = 0 then do:
     1718               display
     1719                 v-view-code
     1720                 v-find-code
     1721                 with frame inf.
     1722             end.
     1723           end.
     1724           for each buf_dis-time-rule no-lock
     1725             where buf_dis-time-rule.time-rule-num >= buf_code-range.first-code
     1726               and buf_dis-time-rule.time-rule-num <= buf_code-range.last-code
     1727           on error undo, return error
     1728           :
     1729             create list-code .
     1730             assign
     1731               list-code.gds-name = buf_dis-time-rule.des
     1732               list-code.b-code   = string( buf_dis-time-rule.time-rule-num )
     1733               list-code.bc-on    = true
     1734               v-find-code = v-find-code + 1
     1735               v-view-code = v-view-code + 1
     1736             .
     1737             if ( v-view-code modulo 100 ) = 0 then do:
     1738               display
     1739                 v-view-code
     1740                 v-find-code
     1741                 with frame inf.
     1742             end.
     1743           end.
     1744         end.
     1745         when 'cagb':U
     1746         then do:
     1747           for each buf_rule-by-call no-lock
     1748             where buf_rule-by-call.call#_id >= buf_code-range.first-code
     1749               and buf_rule-by-call.call#_id <= buf_code-range.last-code
     1750           on error undo, return error
     1751           :
     1752             create list-code .
     1753             assign
     1754               list-code.gds-name = buf_rule-by-call.call_id
     1755               list-code.b-code   = string( buf_rule-by-call.call#_id )
     1756               list-code.bc-on    = true
     1757               v-find-code = v-find-code + 1
     1758               v-view-code = v-view-code + 1
     1759             .
     1760             if ( v-view-code modulo 100 ) = 0 then do:
     1761               display
     1762                 v-view-code
     1763                 v-find-code
     1764                 with frame inf.
     1765             end.
     1766           end.
     1767         end.
     1768        when 'fdgb':U
     1769         then do:
     1770           for each buf_sysconf no-lock,
     1771              each buf_fin-doc no-lock where
     1772                   buf_fin-doc.host-code = buf_sysconf.host-code
     1773               and buf_fin-doc.fin-doc-code >= buf_code-range.first-code
     1774               and buf_fin-doc.fin-doc-code <= buf_code-range.last-code
     1775           on error undo, return error
     1776           :
     1777             create list-code .
     1778             assign
     1779               list-code.gds-name = substitute("Фирма &1 фин.док-нт &2 (&3)"
     1780                                              ,buf_fin-doc.host-code
     1781                                              ,buf_fin-doc.prn-doc-code
     1782                                              ,buf_fin-doc.fin-doc-code
     1783                                              )
     1784               list-code.b-code   = string( buf_fin-doc.fin-doc-code )
     1785               list-code.bc-on    = true
     1786               v-find-code = v-find-code + 1
     1787               v-view-code = v-view-code + 1
     1788             .
     1789             if ( v-view-code modulo 100 ) = 0 then do:
     1790               display
     1791                 v-view-code
     1792                 v-find-code
     1793                 with frame inf.
     1794             end.
     1795           end.
     1796         end.
     1797         otherwise do:
     1798           message
     1799             vss-workfile vss-revision vss-description skip
     1800             substitute( "Нет обработки диапазонов с типом &1", buf_code-range.range-type )
     1801             view-as alert-box error .
     1802           return error .
     1803         end.
     1804       end case.
     1805       assign
     1806         p-find-code = v-find-code
     1807       .
     1808       hide frame inf.
     1809     end.
     1810   END PROCEDURE.
