        1   block-level on error undo, throw.
        2   DEFINE VARIABLE p-install as logical no-undo init false .
        3   define variable vss-revision    as character no-undo initial "$Revision: 8d6ad4ee6014, 1102, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Thu Dec 14 02:13:52 2017 +0300 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: imp-ggr.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: utl/imp-ggr.p $":U .
        8   define variable vss-description as character no-undo initial "Импорт групп товаров ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define stream sinp .
       79   define variable f-name as character no-undo .
       80   define variable v-ok   as logical   no-undo .
       81   DEFINE VARIABLE v-level-name as character no-undo .
       82   DEFINE VARIABLE v-level-num as integer no-undo .
       83   DEFINE VARIABLE v-full-level-name as character no-undo .
       84   DEFINE VARIABLE v-node-code like ub.gds-grp.node-code no-undo .
       85   DEFINE VARIABLE v-calc-method like ub.gds-grp.calc-method no-undo .
       86   DEFINE VARIABLE v-increase-pc like ub.gds-grp.increase-pc no-undo .
       87   DEFINE VARIABLE v-print-code  like ub.gds-grp.print-code  no-undo .
       88   DEFINE VARIABLE v-d-pcnt like ub.gds-grp.d-pcnt no-undo .
       89   DEFINE VARIABLE v-new-node-code like ub.gds-grp.node-code no-undo .
       90   DEFINE VARIABLE v-rid as recid no-undo.
       91   DEFINE VARIABLE v-ask as logical no-undo init yes.
       92   DEFINE VARIABLE choice as integer no-undo .
       93   define stream slog.
       94   define buffer buf_gds-grp for ub.gds-grp.
       95   do
       96   on error undo, return
       97   :
       98     assign
       99       v-ok = false
      100     .
      101     if p-install = false then do:
      102       message
      103         "Импорт групп товаров" skip
      104         "Продолжить ?" skip
      105         view-as alert-box question buttons ok-cancel update v-ok .
      106       if not v-ok then do:
      107         return .
      108       end.
      109     end.
      110     assign
      111       f-name = 'gds-grp.ggr'
      112     .
      113     if p-install = false then do:
      114       system-dialog get-file f-name
      115         title "Выберите файл c группами товаров"
      116         filters "Файлы групп товаров *.ggr" "*.ggr",
      117                   "Все файлы  *.*" "*.*"
      118         INITIAL-DIR "."
      119         return-to-start-dir
      120         must-exist
      121         update v-ok
      122         default-extension "ggr".
      123       if v-ok <> true then do:
      124         return .
      125       end.
      126     end.
      127     input stream sinp from value (f-name).
      128     define variable v-file-format as character no-undo .
      129     find first ub.sys-ctrl no-lock .
      130     if ub.sys-ctrl.db-num <> 0 then do:
      131       if not p-install then do:
      132         message
      133         "Утилиту импорта групп товаров можно запускать только в ГБД"
      134         view-as alert-box error .
      135       end.
      136       return error "Утилиту импорта групп товаров можно запускать только в ГБД".
      137     end.
      138     import stream sinp v-file-format .
      139     if v-file-format <> "GOODS_GRP_1_0" then do:
      140       input stream sinp close.
      141       message
      142         "Неправильный формат файла" skip
      143         "Первая строка файла" v-file-format skip
      144         "Файл" f-name skip
      145         view-as alert-box error .
      146       undo, return error .
      147     end.
      148     run write-to-log in this-procedure(chr(10) + string(today, "99/99/9999") + chr(32) +
      149                                        string(time, "HH:MM:SS") + chr(32) +
      150                                        g#userid) .
      151     repeat
      152     :
      153       define variable v-full-name as character no-undo .
      154       import stream sinp v-full-name .
      155       assign
      156         v-ok = true
      157       .
      158       if v-ask then
      159       run gbl/d-askw.w (input "Создание групп товаров",
      160                 input "Группа" + chr(10) + v-full-name,
      161                 input "|",
      162                 input "Создать|Не создавать|Создать все|Отмена",
      163                 input "Создать группу (если такой еще нет)|Не создавать группу|Перестать спрашивать и по возможности создать все|Прекратить загрузку групп товаров",
      164                 input 1,
      165                 input 4,
      166                 output choice).
      167      CASE choice:
      168       when 1 then do:
      169         assign
      170         v-ok = yes.
      171       end.
      172       when 2 then do:
      173         assign
      174         v-ok = no
      175         .
      176       end.
      177       when 3 then do:
      178         assign
      179         v-ok = yes
      180         v-ask = no
      181         .
      182       end.
      183       when 4 then do:
      184         leave.
      185       end.
      186      END CASE.
      187       if v-ok = true then do:
      188         assign
      189         v-full-name = trim(v-full-name, chr(47))
      190         v-full-level-name = "":U
      191         .
      192         find first buf_gds-grp no-lock where
      193                    buf_gds-grp.upper-code = 0 no-error .
      194         assign
      195         v-node-code = buf_gds-grp.node-code
      196         v-calc-method = buf_gds-grp.calc-method
      197         v-increase-pc = buf_gds-grp.increase-pc
      198         v-d-pcnt = buf_gds-grp.d-pcnt
      199         v-print-code = buf_gds-grp.print-code
      200         .
      201         _cycle:
      202         do v-level-num = 1 to num-entries(v-full-name, chr(47)):
      203           assign
      204           v-level-name =  entry(v-level-num, v-full-name, chr(47))
      205           v-full-level-name = v-full-level-name + v-level-name + chr(47)
      206           .
      207           find first buf_gds-grp no-lock where
      208                      buf_gds-grp.upper-code = v-node-code
      209                  and buf_gds-grp.node-name = v-level-name no-error .
      210           if not avail buf_gds-grp then do:
      211            run ref/gdsgrp01.p (
      212                            input 'ДОБАВЛЕНИЕ':U
      213                           ,input p-install
      214                           ,input no
      215                           ,input yes
      216                           ,input-output v-new-node-code
      217                           ,input-output v-node-code
      218                           ,input v-level-name
      219                           ,input v-calc-method
      220                           ,input v-increase-pc
      221                           ,input v-print-code
      222                           ,input 'Отключено':U
      223                           ,input 0
      224                           ,output v-rid
      225                           ) no-error.
      226             if error-status:error then do:
      227               run write-to-log in this-procedure("error in creating group" + chr(32) + v-full-level-name) .
      228               next _cycle.
      229             end.
      230             if error-status:error then do:
      231               run write-to-log in this-procedure("error in creating group" + chr(32) + v-full-level-name) .
      232             end.
      233             else do:
      234               run write-to-log in this-procedure("new group" + chr(32) + v-full-level-name) .
      235             end.
      236             assign
      237             v-node-code = v-new-node-code
      238             .
      239           end.
      240           else do:
      241             run write-to-log in this-procedure("exists group" + chr(32) + v-full-level-name) .
      242             assign
      243             v-node-code = buf_gds-grp.node-code
      244             v-calc-method = buf_gds-grp.calc-method
      245             v-increase-pc = buf_gds-grp.increase-pc
      246             v-print-code  = buf_gds-grp.print-code
      247             v-d-pcnt = buf_gds-grp.d-pcnt
      248             .
      249             next _cycle.
      250           end.
      251         end.
      252       end.
      253   if session :set-wait-state( "" ) then.
      254     end.
      255     input stream sinp close.
      256   end.
      257   message "Импорт групп товаров закончен.".
      258   procedure write-to-log :
      259   define input parameter P-MESSAGE as character no-undo .
      260     do
      261     on error undo, return error
      262     :
      263       output STREAM SLOG TO imp-ggr.log append.
      264       put STREAM SLOG unformatted
      265       P-MESSAGE SKIP.
      266       OUTPUT STREAM SLOG CLOSE.
      267     end.
      268   end procedure.
