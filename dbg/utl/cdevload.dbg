        1   block-level on error undo, throw.
        2   define input        parameter parparentproc as widget-handle  no-undo .
        3   define input-output parameter p-base-version as integer          no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: cdevload.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/cdevload.p $":U .
        9   define variable vss-description as character no-undo init "Загрузка справочника событий на кассе".
       10   define buffer bf_cd-events      for ub.cd-events .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   DEFINE VARIABLE v-in-string  AS CHARACTER NO-UNDO .
      117   DEFINE VARIABLE v-out-string AS CHARACTER NO-UNDO .
      118   DEFINE VARIABLE v-count      AS INTEGER   NO-UNDO .
      119   DEFINE VARIABLE v-count-2    AS INTEGER   NO-UNDO .
      120   define variable v-file-version    as integer   no-undo.
      121   define variable v-file-name    as character    no-undo.
      122   DEFINE STREAM st-in .
      123   do
      124   on error undo, return error
      125   :
      126      SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      127      assign
      128         v-file-name    = search("cmp/cd-event.enc").
      129      .
      130      if v-file-name = ?
      131      or v-file-name = "":U
      132      then do:
      133         return error "Не найден файл со списком событий на кассе".
      134      end.
      135      INPUT STREAM st-in FROM VALUE(v-file-name) .
      136      IMPORT STREAM st-in UNFORMATTED
      137         v-in-string
      138         .
      139   define variable vss-include-info0 as character format "X(65)" no-undo
      140   initial "@(#)$Workfile$ $Revision$".
      141   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      142     (input  v-in-string
      143     ,output v-out-string
      144     )  .
      145      ASSIGN
      146         v-file-version = INTEGER(v-out-string)
      147      .
      148      IF v-file-version = p-base-version
      149      THEN DO:
      150         RETURN.
      151      END.
      152      else IF v-file-version < p-base-version
      153      THEN DO:
      154         RETURN SUBSTITUTE( "В файле более старая версия &1, текущая &2" , v-file-version, p-base-version) .
      155      END.
      156      do
      157      TRANSACTION
      158      on error undo, return error
      159      :
      160         FOR EACH bf_cd-events
      161            EXCLUSIVE-LOCK
      162            :
      163            DELETE bf_cd-events.
      164         END.
      165         ASSIGN
      166            v-count     = 0
      167            v-count-2   = 0
      168         .
      169         SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      170         REPEAT:
      171            ASSIGN
      172               v-out-string = ""
      173               v-in-string  = ""
      174            .
      175            IMPORT STREAM st-in UNFORMATTED
      176               v-in-string
      177               .
      178   define variable vss-include-info1 as character format "X(65)" no-undo
      179   initial "@(#)$Workfile$ $Revision$".
      180   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      181     (input  v-in-string
      182     ,output v-out-string
      183     ) NO-ERROR .
      184            IF (NUM-ENTRIES(v-out-string, chr(4)) < 6)
      185            THEN DO:
      186               IF NUM-ENTRIES(v-out-string, chr(4)) = 1
      187               THEN DO:
      188                  ASSIGN
      189                     v-count-2 = INTEGER(v-out-string)
      190                  NO-ERROR
      191                  .
      192                  IF ERROR-STATUS:ERROR
      193                  THEN DO:
      194                     RETURN ERROR SUBSTITUTE( "Неправильный конец файла &1" , v-out-string) .
      195                  END.
      196                  IF v-count-2 <> v-count
      197                  THEN DO:
      198                     RETURN ERROR SUBSTITUTE( "Неправильное количество строк в файле &1, должно быть &2" , v-count, v-count-2) .
      199                  END.
      200               END.
      201               ELSE DO:
      202                  RETURN ERROR "Не хватает параметров " + v-out-string.
      203               END.
      204            END.
      205            RUN load-line ( INPUT v-file-version, INPUT v-out-string ) .
      206            ASSIGN
      207               v-count = v-count + 1
      208            .
      209         END.
      210      END.
      211   end.
      212   procedure load-line :
      213   define input parameter p-file-version    as integer          no-undo.
      214   define input parameter p-line       as character        no-undo.
      215   define VARIABLE p-id            as integer          no-undo.
      216   define VARIABLE p-level         as integer          no-undo.
      217   define VARIABLE p-name          as character        no-undo.
      218   define VARIABLE p-status        as integer          no-undo.
      219   define VARIABLE p-type          as character        no-undo.
      220   define VARIABLE p-description   as character        no-undo.
      221   define buffer buf_cd-events      for ub.cd-events .
      222   do
      223   on error undo, return error
      224   :
      225      ASSIGN
      226         p-id          = INTEGER(ENTRY(1, p-line, chr(4)))
      227         p-level       = INTEGER(ENTRY(2, p-line, chr(4)))
      228         p-name        = ENTRY(3, p-line, chr(4))
      229         p-status      = INTEGER(ENTRY(4, p-line, chr(4)))
      230         p-type        = ENTRY(5, p-line, chr(4))
      231         p-description = ENTRY(6, p-line, chr(4))
      232      NO-ERROR.
      233      IF ERROR-STATUS:ERROR
      234      THEN DO:
      235         RETURN ERROR SUBSTITUTE( "Ошибка типов данных &1&2" , chr(10), ERROR-STATUS:GET-MESSAGE (1)) .
      236      END.
      237      FIND FIRST buf_cd-events
      238           WHERE buf_cd-events.event-id = p-id
      239           NO-LOCK
      240           NO-ERROR
      241           .
      242      IF AVAILABLE buf_cd-events
      243      THEN DO:
      244         RETURN ERROR SUBSTITUTE("Уже есть событие с номером &1", p-id).
      245      END.
      246      CREATE buf_cd-events.
      247      ASSIGN
      248         buf_cd-events.version           = p-file-version
      249         buf_cd-events.event-id          = p-id
      250         buf_cd-events.event-level       = p-level
      251         buf_cd-events.event-name        = p-name
      252         buf_cd-events.event-status      = p-status
      253         buf_cd-events.event-type        = p-type
      254         buf_cd-events.event-description = p-description
      255      NO-ERROR .
      256      IF ERROR-STATUS:ERROR
      257      THEN DO:
      258         RETURN ERROR SUBSTITUTE("Ошибка создания записи &1&2&3", p-id, chr(10), error-status :get-message (1)).
      259      END.
      260      RETURN.
      261   end.
      262   end procedure.
