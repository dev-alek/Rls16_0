        1   block-level on error undo, throw.
        2   define input  parameter old-gds-code  like ub.goods.gds-code  no-undo .
        3   define input  parameter new-gds-code  like ub.goods.gds-code  no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: ren-gdsc.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/ren-gdsc.p $":U .
        9   define variable vss-description as character no-undo init "Изменение gds-code для одного товара".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2':u,old-gds-code,new-gds-code)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure gen-key-rec :
       84     define input  parameter p-tbl-name    as character no-undo.
       85     define input  parameter p-bh_tbl-name as handle    no-undo.
       86     define output parameter p-key-rec     as character no-undo.
       87     do
       88     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       89     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       90     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       91     :
       92       define variable fh               as handle    no-undo .
       93       define variable v-ok             as logical   no-undo .
       94       define variable v-inform         as character no-undo .
       95       define variable v-ind            as integer   no-undo .
       96       define variable v-idx-field-qnty as integer   no-undo .
       97       if p-tbl-name = ?
       98         or p-tbl-name = "":U
       99       then do:
      100         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      101       end.
      102       if not p-bh_tbl-name:available then do:
      103         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      104       end.
      105       assign
      106         p-key-rec = p-tbl-name
      107         v-inform  = p-bh_tbl-name:index-information(1)
      108         v-ind     = 2
      109       .
      110       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      111       on error undo, return error
      112       :
      113         assign
      114           v-inform = p-bh_tbl-name:index-information( v-ind )
      115           v-ind    = v-ind + 1
      116         .
      117       end.
      118       if v-inform = ?
      119         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      120         or entry( 3, v-inform, ",":U ) <> "1":U
      121       then do:
      122         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      123       end.
      124       else do:
      125         assign
      126           v-idx-field-qnty = num-entries( v-inform ) - 4
      127         .
      128         if v-idx-field-qnty < 2 then do:
      129           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      130         end.
      131         do v-ind = 1 to v-idx-field-qnty by 2
      132         on error undo, return error
      133         :
      134           assign
      135             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      136             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      137           .
      138         end.
      139       end.
      140       if p-key-rec = ? then do:
      141         assign
      142           p-key-rec = "":U
      143         .
      144         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      145       end.
      146     end.
      147     return.
      148   end procedure.
      149   procedure gen-where-keyr-tab :
      150     define input  parameter i-tableSerach as character no-undo.
      151     define input  parameter i-tablekey   as character  no-undo.
      152     define input  parameter p-key-rec    as character  no-undo.
      153     define input  parameter p-key-handle as handle     no-undo .
      154     define input  parameter p-db-name    as character  no-undo .
      155     define input  parameter p-tt-handle  as handle     no-undo .
      156     define output parameter o-Where      as character  no-undo.
      157     do
      158     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      159     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      160     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      161     :
      162       define variable v-full-tbl-name  as character no-undo .
      163       define variable bh_tbl-name      as handle    no-undo .
      164       define variable fh_key           as handle    no-undo .
      165       define variable fh_search        as handle    no-undo .
      166       define variable v-field-num      as integer   no-undo .
      167       define variable v-count-fld      as integer   no-undo .
      168       define variable v-inform         as character no-undo .
      169       define variable v-ind            as integer   no-undo .
      170       define variable v-idx-field-qnty as integer   no-undo .
      171       define variable v-field-name     as character no-undo .
      172       define variable v-field-val      as character no-undo .
      173       define variable v-word-link      as character no-undo .
      174       define variable vTable           as character no-undo.
      175       define variable bh_tbl-key       as handle    no-undo .
      176       assign
      177         p-key-rec = trim( p-key-rec )
      178       .
      179       if p-key-handle <> ? then do:
      180         if not valid-handle(p-key-handle)
      181            or p-key-handle:type <> "buffer"
      182         then do:
      183           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      184         end.
      185         if num-entries( p-key-rec, chr(3) ) > 1
      186           or p-key-rec = ?
      187           or p-key-rec = "":U
      188         then do:
      189           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      190         end.
      191       end.
      192       else do:
      193         if p-key-rec = ?
      194           or p-key-rec = "":U
      195         then do:
      196           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      197         end.
      198       end.
      199       assign
      200         vTable = entry( 1 , p-key-rec, chr(3) )
      201       .
      202       if p-tt-handle <> ?
      203         and ( not valid-handle(p-tt-handle)
      204               or p-tt-handle:type <> "buffer"
      205             )
      206       then do:
      207         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      208       end.
      209       if p-tt-handle = ? then do:
      210         assign
      211           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      212         .
      213         create buffer bh_tbl-name for table v-full-tbl-name .
      214       end.
      215       else do:
      216         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      217       end.
      218       assign
      219         v-inform = bh_tbl-name:index-information(1)
      220         v-ind    = 2
      221       .
      222       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      223       on error undo, return error
      224       :
      225         assign
      226           v-inform = bh_tbl-name:index-information( v-ind )
      227           v-ind    = v-ind + 1
      228         .
      229       end.
      230       if v-inform = ?
      231         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      232         or entry( 3, v-inform, ",":U ) <> "1":U
      233       then do:
      234         delete object bh_tbl-name no-error.
      235         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      236       end.
      237       assign
      238         v-idx-field-qnty = num-entries( v-inform ) - 4
      239       .
      240       if v-idx-field-qnty < 2 then do:
      241         delete object bh_tbl-name no-error.
      242         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      243       end.
      244       assign
      245         o-where     = "where":U
      246         v-word-link = "":U
      247         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      248         v-count-fld = 0
      249       .
      250       if i-tablekey ne "" and i-tablekey ne ?
      251       then do:
      252         assign
      253           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      254         .
      255         create buffer bh_tbl-key for table v-full-tbl-name .
      256       end.
      257       if i-tableSerach ne "" and i-tableSerach ne ?
      258       then do:
      259         delete object bh_tbl-name no-error.
      260         assign
      261           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      262         .
      263         create buffer bh_tbl-name for table v-full-tbl-name .
      264       end.
      265       block_where:
      266       do v-ind = 1 to v-idx-field-qnty by 2
      267       on error undo, return error
      268       :
      269         assign
      270           v-count-fld = v-count-fld + 1
      271         .
      272         if p-key-handle = ?
      273           and v-count-fld > v-field-num
      274         then do:
      275           leave block_where.
      276         end.
      277         define variable VfieldKeyTable as handle no-undo.
      278         assign
      279           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      280           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      281         .
      282         if     bh_tbl-key ne ?
      283         then do:
      284            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      285            if VfieldKeyTable eq ?
      286            then next block_where.
      287         end.
      288         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      289         then
      290            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      291         else
      292            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      293         if p-key-handle = ? then do:
      294           assign
      295             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      296           .
      297         end.
      298         else do:
      299           assign
      300             fh_key = p-key-handle:buffer-field( v-field-name )
      301           .
      302           if fh_key = ?
      303             or not valid-handle( fh_key )
      304           then do:
      305             delete object bh_tbl-name.
      306             if     bh_tbl-key ne ?
      307             then
      308                delete object bh_tbl-key.
      309             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      310           end.
      311           assign
      312             v-field-val = fh_key:buffer-value
      313           .
      314         end.
      315         if fh_search:data-type ="character":U then do:
      316           assign
      317             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      318             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      319             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      320             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      321             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      322             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      323             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      324             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      325             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      326             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      327             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      328             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      329             v-field-val = substitute( '"&1"', v-field-val )
      330           .
      331         end.
      332         assign
      333           o-where = substitute( "&1 &2", o-where, v-field-val )
      334         .
      335         if v-word-link = "":U then do:
      336           assign
      337             v-word-link = "and":U
      338           .
      339         end.
      340       end.
      341       delete object bh_tbl-name.
      342       if     bh_tbl-key ne ?
      343       then
      344          delete object bh_tbl-key.
      345       if p-key-handle = ?
      346         and v-count-fld <> v-field-num
      347       then do:
      348         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      349       end.
      350     end.
      351   end procedure.
      352   procedure gen-hn-keyr-tab :
      353     define input  parameter i-tableSerach as character no-undo.
      354     define input  parameter i-tablekey   as character no-undo.
      355     define input  parameter p-key-rec    as character no-undo.
      356     define input  parameter p-key-handle as handle    no-undo .
      357     define input  parameter p-db-name    as character no-undo .
      358     define input  parameter p-tt-handle  as handle    no-undo .
      359     define input  parameter p-stts-lock  as integer   no-undo .
      360     define output parameter o-hn         as handle    no-undo.
      361     define variable v-full-tbl-name as character no-undo.
      362     define variable v-where         as character no-undo.
      363     define variable bh_tbl-name     as handle    no-undo.
      364     define variable vTable          as character no-undo.
      365     do
      366     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      367     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      368     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      369         run gen-where-keyr-tab(i-tableSerach,
      370                                i-tablekey,
      371                                p-key-rec,
      372                                p-key-handle,
      373                                p-db-name,
      374                                p-tt-handle,
      375                                output v-where).
      376         if i-tableSerach ne "" and i-tableSerach ne ?
      377         then do:
      378            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      379            create buffer bh_tbl-name for table v-full-tbl-name .
      380         end.
      381         else do:
      382            if p-tt-handle = ? then do:
      383               assign
      384                  vTable = entry( 1 , p-key-rec, chr(3) )
      385               .
      386               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      387               create buffer bh_tbl-name for table v-full-tbl-name .
      388            end.
      389            else do:
      390               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      391            end.
      392         end.
      393         if p-tt-handle = ? then do:
      394            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      395         end.
      396         else do:
      397            bh_tbl-name:find-first( v-where ) no-error .
      398         end.
      399         o-hn = bh_tbl-name.
      400      end.
      401   end procedure.
      402   procedure gen-hn-keyr :
      403     define input  parameter p-key-rec    as character no-undo.
      404     define input  parameter p-key-handle as handle    no-undo .
      405     define input  parameter p-db-name    as character no-undo .
      406     define input  parameter p-tt-handle  as handle    no-undo .
      407     define input  parameter p-stts-lock  as integer   no-undo .
      408     define output parameter o-hn         as handle    no-undo.
      409     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      410   end.
      411   procedure gen-row-keyr :
      412     define input  parameter p-key-rec    as character no-undo.
      413     define input  parameter p-key-handle as handle    no-undo .
      414     define input  parameter p-db-name    as character no-undo .
      415     define input  parameter p-tt-handle  as handle    no-undo .
      416     define input  parameter p-stts-lock  as integer   no-undo .
      417     define output parameter p-tbl-row    as rowid     no-undo.
      418     define output parameter p-tbl-name   as character no-undo.
      419     define variable vHn as handle no-undo.
      420       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      421       p-tbl-row = if vHn:available then vHn:rowid else ?.
      422       p-tbl-name =  vHn:table.
      423       delete object vHn no-error.
      424     if p-tbl-row = ? then do:
      425       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      426     end.
      427     else do:
      428       return.
      429     end.
      430   end procedure.
      431   procedure gen-key-fv :
      432     define input  parameter p-key-rec    as character no-undo .
      433     define output parameter p-field-list as character no-undo .
      434     define output parameter p-value-list as character no-undo.
      435     do
      436     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      437     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      438     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      439     :
      440       define variable v-full-tbl-name  as character no-undo .
      441       define variable bh_tbl-name      as handle    no-undo .
      442       define variable v-tbl-name       as character no-undo .
      443       define variable v-field-num      as integer   no-undo .
      444       define variable v-count-fld      as integer   no-undo .
      445       define variable v-inform         as character no-undo .
      446       define variable v-ind            as integer   no-undo .
      447       define variable v-idx-field-qnty as integer   no-undo .
      448       define variable v-delim-key      as character no-undo .
      449       if p-key-rec = ?
      450         or p-key-rec = "":U
      451       then do:
      452         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      453       end.
      454       assign
      455         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      456         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      457       .
      458       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      459       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      460       assign
      461         v-inform = bh_tbl-name:index-information(1)
      462         v-ind    = 2
      463       .
      464       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      465       on error undo, return error
      466       :
      467         assign
      468           v-inform = bh_tbl-name:index-information( v-ind )
      469           v-ind    = v-ind + 1
      470         .
      471       end.
      472       if v-inform = ?
      473         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      474         or entry( 3, v-inform, ",":U ) <> "1":U
      475       then do:
      476         delete object bh_tbl-name no-error.
      477         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      478       end.
      479       assign
      480         v-idx-field-qnty = num-entries( v-inform ) - 4
      481       .
      482       if v-idx-field-qnty < 2 then do:
      483         delete object bh_tbl-name no-error.
      484         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      485       end.
      486       assign
      487         p-field-list = "":U
      488         p-value-list = "":U
      489         v-delim-key  = "":U
      490         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      491         v-count-fld  = 0
      492       .
      493       block_where:
      494       do v-ind = 1 to v-idx-field-qnty by 2
      495       on error undo, return error
      496       :
      497         assign
      498           v-count-fld = v-count-fld + 1
      499         .
      500         if v-count-fld > v-field-num then do:
      501           leave block_where.
      502         end.
      503         assign
      504           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      505           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      506         .
      507         if v-ind = 1 then do:
      508           assign
      509             v-delim-key = chr(3)
      510           .
      511         end.
      512       end.
      513       delete object bh_tbl-name.
      514       if v-count-fld <> v-field-num then do:
      515         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      516       end.
      517     end.
      518   end procedure.
      519   procedure gen-key-field :
      520     define input  parameter p-table      as character no-undo .
      521     define output parameter p-field-list as character no-undo .
      522     do
      523     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      524     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      525     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      526     :
      527       define variable v-full-tbl-name  as character no-undo .
      528       define variable bh_tbl-name      as handle    no-undo .
      529       define variable v-tbl-name       as character no-undo .
      530       define variable v-field-num      as integer   no-undo .
      531       define variable v-count-fld      as integer   no-undo .
      532       define variable v-inform         as character no-undo .
      533       define variable v-ind            as integer   no-undo .
      534       define variable v-idx-field-qnty as integer   no-undo .
      535       define variable v-delim-key      as character no-undo .
      536       if p-table = ?
      537         or p-table = "":U
      538       then do:
      539         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      540       end.
      541       assign
      542         v-tbl-name      = p-table
      543         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      544       .
      545       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      546       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      547       assign
      548         v-inform = bh_tbl-name:index-information(1)
      549         v-ind    = 2
      550       .
      551       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      552       on error undo, return error
      553       :
      554         assign
      555           v-inform = bh_tbl-name:index-information( v-ind )
      556           v-ind    = v-ind + 1
      557         .
      558       end.
      559       if v-inform = ?
      560         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      561         or entry( 3, v-inform, ",":U ) <> "1":U
      562       then do:
      563         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      564       end.
      565       assign
      566         v-idx-field-qnty = num-entries( v-inform ) - 4
      567       .
      568       if v-idx-field-qnty < 2 then do:
      569         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      570       end.
      571       assign
      572         p-field-list = "":U
      573         v-delim-key  = "":U
      574         v-count-fld  = 0
      575       .
      576       block_where:
      577       do v-ind = 1 to v-idx-field-qnty by 2
      578       on error undo, return error
      579       :
      580         assign
      581           v-count-fld = v-count-fld + 1
      582         .
      583         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      584         if v-ind = 1 then do:
      585           assign
      586             v-delim-key = chr(3)
      587           .
      588         end.
      589       end.
      590       delete object bh_tbl-name.
      591     end.
      592   end procedure.
      593   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   procedure cur-time :
      595      define output parameter p-today as date      no-undo .
      596      define output parameter p-time  as integer   no-undo .
      597     do
      598     on error undo, return error
      599     :
      600       define variable v-date1 as date      no-undo .
      601       define variable v-date2 as date      no-undo .
      602       define variable v-time  as integer   no-undo .
      603       assign
      604         v-date1 = today
      605         v-time  = time
      606         v-date2 = today
      607       .
      608       if v-date1 <> v-date2
      609       then do:
      610         assign
      611           v-date1 = today
      612           v-time  = v-time
      613         .
      614       end.
      615       assign
      616         p-today = v-date1
      617         p-time  = v-time
      618       .
      619     end.
      620   end.
      621   function cur-time-date returns character
      622   :
      623     return string(today, '99/99/9999':U) .
      624   end.
      625   function cur-time-mjd returns decimal
      626   :
      627     define variable v-date as date      no-undo .
      628     define variable v-time as integer   no-undo .
      629     run cur-time in this-procedure
      630       (output v-date
      631       ,output v-time
      632       ) .
      633     return integer(v-date) - 2400002 + (v-time / 86400) .
      634   end.
      635   function cur-time-get-ending-index returns integer
      636   (input p-number as integer
      637   )
      638   :
      639     if p-number < 0
      640     or p-number = ?
      641     then do:
      642       return 1 .
      643     end.
      644     define variable v-rest as integer   no-undo .
      645     assign
      646       p-number = p-number modulo 100
      647     .
      648     if p-number < 20
      649     then do:
      650       assign
      651         v-rest = p-number
      652       .
      653     end.
      654     else do:
      655       assign
      656         v-rest = p-number modulo 10
      657       .
      658     end.
      659     case v-rest :
      660       when 1
      661       then do:
      662         return 2 .
      663       end.
      664       when 2 or
      665       when 3 or
      666       when 4
      667       then do:
      668         return 3 .
      669       end.
      670       otherwise do:
      671         return 1 .
      672       end.
      673     end case .
      674   end.
      675   procedure cur-time-mjd-to-date :
      676      define input  parameter i-mjd-diff as decimal no-undo.
      677      define output parameter o-Date     as date    no-undo.
      678      define output parameter o-Time     as integer no-undo.
      679      define variable v-day-number as integer   no-undo .
      680      if    i-mjd-diff < 0
      681         or i-mjd-diff = ?
      682      then do:
      683         return "?" .
      684      end.
      685      assign
      686         v-day-number = truncate(i-mjd-diff,0).
      687         o-Date = date(v-day-number + 2400002).
      688         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      689     .
      690   end.
      691   function cur-time-mjd-to-string returns character
      692   (input p-mjd-diff as decimal
      693   )
      694   :
      695     define variable v-day-number as integer   no-undo .
      696     define variable v-seconds    as integer   no-undo .
      697     define variable v-hour       as integer   no-undo .
      698     define variable v-min        as integer   no-undo .
      699     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      700     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      701     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      702     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      703     if p-mjd-diff < 0
      704     or p-mjd-diff = ?
      705     then do:
      706       return "?" .
      707     end.
      708     assign
      709       v-day-number = integer(truncate(p-mjd-diff,0))
      710       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      711     .
      712     if v-seconds > 86400
      713     then do:
      714       assign
      715         v-seconds = 86400 - 1
      716       .
      717     end.
      718     if v-seconds < 0
      719     then do:
      720       assign
      721         v-seconds = 0
      722       .
      723     end.
      724     assign
      725       v-hour = truncate(v-seconds / 3600, 0)
      726     .
      727     assign
      728       v-seconds = v-seconds modulo 3600
      729     .
      730     assign
      731       v-min = truncate(v-seconds / 60, 0)
      732     .
      733     assign
      734       v-seconds = v-seconds modulo 60
      735     .
      736     return
      737         (if v-day-number <> 0
      738           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      739           else ""
      740         )
      741       + (if v-day-number <> 0 or v-hour <> 0
      742           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      743           else ""
      744         )
      745       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      746           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      747           else ""
      748         )
      749       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      750       .
      751   end.
      752   function cur-time-string returns character
      753   :
      754     define variable v-date as date      no-undo .
      755     define variable v-time as integer   no-undo .
      756     run cur-time in this-procedure
      757       (output v-date
      758       ,output v-time
      759       ) .
      760     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      761   end.
      762   function cur-time-string-sec returns character
      763   :
      764     define variable v-date as date      no-undo .
      765     define variable v-time as integer   no-undo .
      766     run cur-time in this-procedure
      767       (output v-date
      768       ,output v-time
      769       ) .
      770     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      771   end.
      772   function cur-time-custom  returns character
      773   (input p-prefix as character
      774   ,input p-date-format as character
      775   ,input p-delimiter as character
      776   ,input p-time-format as character
      777   ,input p-suffix as character
      778   )
      779   :
      780     define variable v-date as date      no-undo .
      781     define variable v-time as integer   no-undo .
      782     run cur-time in this-procedure
      783       (output v-date
      784       ,output v-time
      785       ) .
      786     return
      787       p-prefix
      788       + string(v-date, p-date-format)
      789       + p-delimiter
      790       + string(v-time, p-time-format)
      791       + p-suffix
      792       .
      793   end.
      794   function cur-time-print  returns character
      795   :
      796     define variable v-date as date      no-undo .
      797     define variable v-time as integer   no-undo .
      798     run cur-time in this-procedure
      799       (output v-date
      800       ,output v-time
      801       ) .
      802     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      803   end.
      804   function cur-time-datetime returns datetime
      805   :
      806     define variable v-char as character no-undo .
      807     define variable v-datetime as datetime no-undo .
      808     v-char = cur-time-string().
      809     v-datetime = datetime(v-char).
      810     return  v-datetime.
      811   end.
      812   function cur-time-string-msec returns character
      813   :
      814     define variable v-date as datetime  no-undo .
      815     v-date = now.
      816     return string(v-date) .
      817   end.
      818   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      819   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   define new global shared variable g#lib-nws as handle no-undo .
      821   procedure goodsh_write-goods-proc  :
      822   define parameter buffer buf_goods for ub.goods .
      823   define input parameter p-action as integer no-undo .
      824   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      825   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      826   define variable v-date as date      no-undo.
      827   define variable v-time  as integer   no-undo.
      828   define buffer buf_c-gds-hist for ub.c-gds-hist.
      829   define buffer buf_c-goods for ub.c-goods.
      830     do
      831     on error undo, return error
      832     :
      833       if not available buf_goods then do:
      834         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      835                       "Ошибка задания входных параметров:Не определен товар" ).
      836       end.
      837       if g#news then do:
      838         define variable v-send as integer no-undo .
      839         v-send = integer('0':U).
      840   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      842     (input  g#db-num
      843     ,input  'goods':U
      844     ,input  0
      845     ,input  '':U
      846     ,input  0
      847     ,input  '':U
      848     ,input  '':U
      849     ,input  '':U
      850     ,input  0
      851     ,input  0
      852     ,input  0
      853     ,input  'nws-to-hist'
      854     ,output v-send
      855     ) no-error .
      856         if v-send < 0 then return.
      857       end.
      858       run cur-time in this-procedure(output v-date, output v-time).
      859       create buf_c-goods.
      860       buffer-copy buf_goods to buf_c-goods
      861       assign
      862       buf_c-goods.gds-code             = buf_goods.gds-code
      863       buf_c-goods.chip-num           = next-value (s-gds-chip, ub)
      864       buf_c-goods.corr-time          = v-time
      865       buf_c-goods.corr-user-db-num   = g#db-num
      866       buf_c-goods.corr-user-name     = (if g#news then (chr(4) +  'СПН':U)
      867                                         else (if g#esys
      868                                               then (chr(4) +  'ВС':U)
      869                                               else g#userid)
      870                                               )
      871       buf_c-goods.corr-date          = v-date
      872       .
      873       create buf_c-gds-hist.
      874       buffer-copy buf_c-goods to buf_c-gds-hist
      875       assign
      876       buf_c-gds-hist.action =  p-action
      877       buf_c-gds-hist.subject = 'goods':U
      878       buf_c-gds-hist.is-news = g#news
      879       buf_c-gds-hist.source-type = p-source-type
      880       buf_c-gds-hist.source-ref = p-source-ref
      881       .
      882     end.
      883   end procedure.
      884   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885   define variable v-waitfram-action01         as character   no-undo .
      886   define variable v-waitfram-action02         as character   no-undo .
      887   define variable v-waitfram-action03         as character   no-undo .
      888   define variable mWaitFramTextBeg            as character   no-undo.
      889   define variable mWaitFramTextEnd            as character   no-undo.
      890   define variable mWaitFramView               as logical     no-undo.
      891   define variable mWaitProcEvent              as logical     no-undo init yes.
      892   define variable mWaitFramInterval           as integer     no-undo init 1 .
      893   define variable mWaitFramStop               as logical     no-undo.
      894   define variable mWaitFramStopUser           as logical     no-undo.
      895   define variable mWaitFramStopTimeOut        as logical     no-undo.
      896   define variable mWaitFramStartProc          as datetime-tz no-undo.
      897   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      898   define button B-WaitFramStop auto-end-key
      899        label "Стоп"
      900        size 10 by 1 tooltip "Остоновить процесс".
      901   define button B-viewProcInfo
      902        label "Информация"
      903        size 15 by 1 tooltip "Информация о процесс".
      904   define frame waitfram
      905     v-waitfram-action01 format "x(72)" no-label skip
      906     v-waitfram-action02 format "x(72)" no-label skip
      907     v-waitfram-action03 format "x(72)" no-label skip
      908     B-viewProcInfo
      909     B-WaitFramStop at row 4 col 30
      910     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      911     .
      912   define new global shared variable mBatchMode as logical no-undo init ?.
      913   define variable mFramBachModHandle as handle no-undo.
      914   mFramBachModHandle = frame waitfram:handle.
      915   define variable mFameOldVis as logical no-undo.
      916   define variable mVisCUrentVin as logical no-undo.
      917   if session:batch-mode
      918   then
      919      mBatchMode = yes.
      920   if mBatchMode = ? then do:
      921     mVisCUrentVin = current-window:visible.
      922     mFameOldVis = mFramBachModHandle:visible.
      923     mFramBachModHandle:visible  = yes.
      924     mBatchMode = mFramBachModHandle:visible ne yes.
      925     mFramBachModHandle:visible = mFameOldVis.
      926     current-window:visible = mVisCUrentVin.
      927   end.
      928    if  log-manager:logfile-name ne ?
      929     then DO:
      930         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      931         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      932         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      933     end.
      934   on choose of B-WaitFramStop in frame waitfram
      935   do:
      936     mWaitFramStop = yes.
      937     mWaitFramStopUser = yes.
      938   end.
      939   function waitfram-check-timeout returns logical():
      940      define variable vtime as int64 no-undo.
      941      if mWaitFramStopTimeOut
      942      then
      943         return yes.
      944      vtime = ( now - mWaitFramStartProc ) / 1000 .
      945      if     mWaitFramTimeOut ne ?
      946         and mWaitFramTimeOut ne 0
      947         and mWaitFramTimeOut lt vtime
      948      then do:
      949         mWaitFramStopTimeOut = yes.
      950      end.
      951      return mWaitFramStopTimeOut.
      952   end.
      953   procedure waitfram-hide :
      954     if not session:batch-mode
      955     then do
      956     on error undo, return error return-value
      957     :
      958       pause 0 before-hide .
      959       if not mBatchMode then
      960         hide frame waitfram .
      961     if     not mWaitFramView
      962        and mWaitProcEvent
      963     then
      964       process events .
      965     end.
      966   end procedure.
      967   procedure waitfram-show :
      968     define input  parameter p-message as character no-undo .
      969     define variable v-left-margin as integer   no-undo .
      970     if not session:batch-mode
      971     then do
      972     on error undo, return error return-value
      973     :
      974       if length(p-message) <= 70 then do:
      975         assign
      976           v-left-margin = integer((70 - length(p-message)) / 2)
      977         .
      978         assign
      979           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      980         .
      981         assign
      982           v-waitfram-action01 = " "
      983           v-waitfram-action02 = " "
      984                                    + fill(" ", v-left-margin)
      985                                    + p-message
      986           v-waitfram-action03 = " "
      987         .
      988       end.
      989       else do:
      990         define variable vRindex1 as integer no-undo.
      991         define variable vRindex2 as integer no-undo.
      992         vRindex1 = r-index(p-message," ",70).
      993         if vRindex1 = 0
      994         then
      995            vRindex1 = 70.
      996         if length(p-message)  <= vRindex1 + 70 then do:
      997           assign
      998             v-waitfram-action01 = " "
      999             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1000             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1001           .
     1002         end.
     1003         else do:
     1004           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1005           if vRindex2 <= vRindex1
     1006           then
     1007              vRindex2 = vRindex1 + 70.
     1008           assign
     1009             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1010             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1011             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1012           .
     1013         end.
     1014       end.
     1015       B-viewProcInfo:visible   in frame waitfram = no.
     1016       B-viewProcInfo:sensitive in frame waitfram = no.
     1017       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1018       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1019       if  (   mWaitFramView
     1020          or  mWaitProcEvent)
     1021          and not mBatchMode
     1022       then
     1023          display
     1024             v-waitfram-action01 skip
     1025             v-waitfram-action02 skip
     1026             v-waitfram-action03 skip
     1027          with frame waitfram .
     1028       if     mWaitFramView
     1029          then do:
     1030             if     mWaitFramInterval ne ?
     1031                and not mBatchMode
     1032             then
     1033                wait-for go of frame waitfram pause mWaitFramInterval.
     1034          end.
     1035          else
     1036             if     mWaitProcEvent
     1037                and not mBatchMode
     1038             then
     1039                process events .
     1040     end.
     1041   end procedure.
     1042      procedure waitfram-show-this:
     1043         define input  parameter iInterval as int64 no-undo.
     1044         define variable vtime as int64 no-undo.
     1045         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1046         mWaitFramInterval = iInterval.
     1047         run waitfram-show (substitute("&1&2 &3&4" ,
     1048                                       mWaitFramTextBeg ,
     1049                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1050                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1051                                       mWaitFramTextEnd
     1052                                      )
     1053                           ).
     1054      end.
     1055      procedure WaitFramRunPause:
     1056         define input  parameter iInterval as dec no-undo.
     1057         define variable vStart  as datetime-tz no-undo.
     1058         define variable vend    as datetime-tz no-undo.
     1059         define variable vint as int64 no-undo.
     1060         define variable vOk as logical no-undo.
     1061         vStart = now.
     1062         vend   = vStart.
     1063         publish "WaitFramPause" (iInterval,output vOk).
     1064         vend   =  now.
     1065         vint = vend - vStart.
     1066         vint = iInterval - vint / 1000.
     1067         if     not mWaitFramStop
     1068            and (   vint > 0
     1069                 or (    not vOk
     1070                     and iInterval eq ?
     1071                     )
     1072                 )
     1073         then
     1074            run waitfram-show-this (iInterval).
     1075         vend   =  now.
     1076         vint = vend - vStart.
     1077         vint = iInterval - vint / 1000.
     1078         if     not mWaitFramStop
     1079            and vint > 0
     1080         then do:
     1081            run gbl/pause.p (vint * 1000).
     1082         end.
     1083         if iInterval ne ?
     1084         then
     1085            publish "WaitFramStop".
     1086         waitfram-check-timeout().
     1087      end.
     1088      procedure WaitFramWaitFor:
     1089         define input  parameter iInterval as dec no-undo.
     1090         assign
     1091            mWaitFramStartProc   = now
     1092            mWaitFramStopUser    = no
     1093            mWaitFramStopTimeOut = no
     1094         .
     1095         block-wait:
     1096         do while not mWaitFramStop:
     1097            run WaitFramRunPause (iInterval).
     1098            if  waitfram-check-timeout()
     1099            then do:
     1100               leave block-wait.
     1101            end.
     1102         end.
     1103         run waitfram-hide.
     1104      end.
     1105   procedure waitfram-join :
     1106     define input  parameter p-line-1  as character no-undo .
     1107     define input  parameter p-line-2  as character no-undo .
     1108     define input  parameter p-line-3  as character no-undo .
     1109     define output parameter p-message as character no-undo .
     1110     do
     1111     on error undo, return error return-value
     1112     :
     1113       assign
     1114         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1115                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1116                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1117       .
     1118     end.
     1119   end procedure.
     1120   function waitfram-join-function returns character
     1121     (input p-line-1 as character
     1122     ,input p-line-2 as character
     1123     ,input p-line-3 as character
     1124     ).
     1125     define variable v-message as character no-undo .
     1126     run waitfram-join in this-procedure
     1127       (input  p-line-1
     1128       ,input  p-line-2
     1129       ,input  p-line-3
     1130       ,output v-message
     1131       ) .
     1132     return v-message .
     1133   end function .
