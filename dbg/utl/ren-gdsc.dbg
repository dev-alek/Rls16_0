     2570   procedure invalidate-md5-signature :
     2571     define buffer buf_archive-history for ub.archive-history .
     2572     do
     2573     on error undo, return error return-value
     2574     :
     2575       define variable v-create-chip-num as integer   no-undo .
     2576       for each buf_archive-history exclusive-lock
     2577         where buf_archive-history.file-valid = true
     2578       break
     2579       by buf_archive-history.obj-type
     2580       by buf_archive-history.obj-code
     2581       by buf_archive-history.archive-type
     2582       on error undo, return error return-value
     2583       :
     2584         if first-of(buf_archive-history.archive-type)
     2585         then do:
     2586           run utl/arhiscr.p
     2587             (input  buf_archive-history.obj-type
     2588             ,input  buf_archive-history.obj-code
     2589             ,input  buf_archive-history.archive-type
     2590             ,input  'ren-gds-code':U
     2591             ,input  ""
     2592             ,input  ""
     2593             ,input  0
     2594             ,input  ""
     2595             ,input  ""
     2596             ,input  ?
     2597             ,output v-create-chip-num
     2598             ) .
     2599         end.
     2600         assign
     2601           buf_archive-history.file-valid            = false
     2602           buf_archive-history.file-invalid-chip-num = v-create-chip-num
     2603         .
     2604       end.
     2605     end.
     2606   end procedure.
