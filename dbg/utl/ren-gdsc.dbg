     2207   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2208       define variable v-ind         as integer   no-undo .
     2209       define variable v-num-entries as integer   no-undo .
     2210       define variable v-inform      as character no-undo .
     2211       define variable bh_tbl-name   as handle    no-undo .
     2212       define variable v-tbl-not-idx as character no-undo .
     2213       define variable v-idx-avail   as logical   no-undo .
     2214       define variable new-tbl-list  as character no-undo .
     2215       define variable old-tbl-list  as character no-undo .
     2216       define variable old-tbl-avail as logical   no-undo .
     2217       define variable v-double-tbl  as character no-undo .
     2218       define variable v-tbl-name    as character no-undo .
     2219       define variable v-msg         as character no-undo .
     2220       assign
     2221         v-msg         = "":U
     2222         v-tbl-not-idx = "":U
     2223         new-tbl-list  = "":U
     2224       .
     2225       for each ub._Field no-lock
     2226         where ub._Field._Field-Name = 'gds-code':U
     2227       ,first ub._File of ub._Field
     2228       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2229       :
     2230         if  lookup( ub._File._File-Name, v-std-list     ) = 0
     2231         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
     2232         and lookup( ub._File._File-Name, v-special-list ) = 0
     2233         then do:
     2234           assign
     2235             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
     2236           .
     2237         end.
     2238         if lookup( ub._File._File-Name, v-std-list ) <> 0
     2239           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
     2240         then do:
     2241           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
     2242           assign
     2243             v-idx-avail = false
     2244             v-inform    = bh_tbl-name:index-information(1)
     2245             v-ind       = 2
     2246           .
     2247           block_chk-idx:
     2248           do while v-inform <> ?
     2249           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2250           :
     2251             if v-inform <> ?
     2252                 and lookup( entry( 5, v-inform, ",":U ), 'gds-code':U ) > 0
     2253             then do:
     2254               assign
     2255                 v-idx-avail = true
     2256               .
     2257               leave block_chk-idx.
     2258             end.
     2259             assign
     2260               v-inform = bh_tbl-name:index-information( v-ind )
     2261               v-ind    = v-ind + 1
     2262             .
     2263           end.
     2264           if v-idx-avail = false then do:
     2265             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
     2266               assign
     2267                 new-tbl-list = new-tbl-list + " (индекса нет)"
     2268               .
     2269             end.
     2270             else do:
     2271               assign
     2272                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
     2273               .
     2274             end.
     2275           end.
     2276           delete object bh_tbl-name.
     2277         end.
     2278       end.
     2279       assign
     2280         old-tbl-list  = "":U
     2281         v-double-tbl  = "":U
     2282         v-num-entries = num-entries( v-std-list )
     2283       .
     2284       do v-ind = 1 to v-num-entries
     2285       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2286       :
     2287         assign
     2288           v-tbl-name    = entry( v-ind, v-std-list )
     2289           old-tbl-avail = false
     2290         .
     2291         find first ub._File no-lock
     2292           where ub._File._File-Name = v-tbl-name
     2293           no-error .
     2294         if not available ub._File then do:
     2295           assign
     2296             old-tbl-avail = true
     2297           .
     2298         end.
     2299         else do:
     2300           find first ub._Field no-lock
     2301             where ub._Field._File-recid = recid( ub._File )
     2302               and ub._Field._Field-Name = 'gds-code':U
     2303             no-error .
     2304           if not available ub._Field then do:
     2305             assign
     2306               old-tbl-avail = true
     2307             .
     2308           end.
     2309         end.
     2310         if old-tbl-avail = true then do:
     2311           assign
     2312             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2313           .
     2314         end.
     2315         if ( lookup( v-tbl-name, v-std-list ) > v-ind
     2316              or lookup( v-tbl-name, v-ignore-list ) > 0
     2317              or lookup( v-tbl-name, v-special-list ) > 0
     2318            )
     2319           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2320         then do:
     2321           assign
     2322             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2323           .
     2324         end.
     2325       end.
     2326       assign
     2327         v-num-entries = num-entries( v-ignore-list )
     2328       .
     2329       do v-ind = 1 to v-num-entries
     2330       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2331       :
     2332         assign
     2333           v-tbl-name = entry( v-ind, v-ignore-list )
     2334           old-tbl-avail = false
     2335         .
     2336         find first ub._File no-lock
     2337           where ub._File._File-Name = v-tbl-name
     2338           no-error .
     2339         if not available ub._File then do:
     2340           assign
     2341             old-tbl-avail = true
     2342           .
     2343         end.
     2344         else do:
     2345           find first ub._Field no-lock
     2346             where ub._Field._File-recid = recid( ub._File )
     2347               and ub._Field._Field-Name = 'gds-code':U
     2348             no-error .
     2349           if not available ub._Field then do:
     2350             assign
     2351               old-tbl-avail = true
     2352             .
     2353           end.
     2354         end.
     2355         if old-tbl-avail = true then do:
     2356           assign
     2357             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2358           .
     2359         end.
     2360         if ( lookup( v-tbl-name, v-std-list ) > 0
     2361              or lookup( v-tbl-name, v-ignore-list ) > v-ind
     2362              or lookup( v-tbl-name, v-special-list ) > 0
     2363            )
     2364           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2365         then do:
     2366           assign
     2367             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2368           .
     2369         end.
     2370       end.
     2371       assign
     2372         v-num-entries = num-entries( v-special-list )
     2373       .
     2374       do v-ind = 1 to v-num-entries
     2375       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2376       :
     2377         assign
     2378           v-tbl-name = entry( v-ind, v-special-list )
     2379         .
     2380         find first ub._File no-lock
     2381           where ub._File._File-Name = v-tbl-name
     2382           no-error .
     2383         if available ub._File then do:
     2384           find first ub._Field no-lock
     2385             where ub._Field._File-recid = recid( ub._File )
     2386               and ub._Field._Field-Name = 'gds-code':U
     2387             no-error .
     2388         end.
     2389         if not available ub._File
     2390           or ( available ub._File
     2391                and not available ub._Field
     2392              )
     2393         then do:
     2394           assign
     2395             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2396           .
     2397         end.
     2398         if ( lookup( v-tbl-name, v-std-list ) > 0
     2399              or lookup( v-tbl-name, v-ignore-list ) > 0
     2400              or lookup( v-tbl-name, v-special-list ) > v-ind
     2401            )
     2402           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2403         then do:
     2404           assign
     2405             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2406           .
     2407         end.
     2408       end.
     2409       if v-tbl-not-idx <> "" then do:
     2410         assign
     2411           v-msg = v-msg + substitute( "Таблицы не имеют индекса с полями &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'gds-code':U )
     2412         .
     2413       end.
     2414       if new-tbl-list <> "":U then do:
     2415         assign
     2416           v-msg = v-msg + substitute( "Нет обработки таблиц: &2&1&1", chr(10), new-tbl-list )
     2417         .
     2418       end.
     2419       if v-double-tbl <> "":U then do:
     2420         assign
     2421           v-msg = v-msg + substitute( "В списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
     2422         .
     2423       end.
     2424       if old-tbl-list <> "":U then do:
     2425         assign
     2426           v-msg = v-msg + substitute( "В списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые поля: &2&1&1", chr(10), old-tbl-list )
     2427         .
     2428       end.
     2429       if v-msg <> "":U then do:
     2430         return error substitute( "Утилита переименования &3 не корректна.&1&1&2", chr(10), v-msg, 'gds-code':U ) .
     2431       end.
     2432     end.
     2433   end procedure.
     2434   do
     2435   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2436   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2437   on quit   undo, return error substitute( "&1. quit", vss-workfile )
     2438   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2439   :
     2440     define buffer buf_rename_goods for ub.goods .
     2441     define buffer b-goods for ub.goods .
     2442     define buffer buf_lock_batchprocess for ub.batchprocess .
     2443     define variable old-gds-key-rec like ub.route.uniq-key-rec  no-undo.
     2444     define variable v-ind         as integer   no-undo .
     2445     define variable v-num-entries as integer   no-undo .
     2446     define variable v-tbl-name    as character no-undo .
     2447     run gbl/lockrngd.p
     2448       (input 'grgc':U
     2449       ,input 'enable':U
     2450       ,buffer buf_lock_batchprocess
     2451       ) no-error .
     2452     if error-status :error then do:
     2453       undo, return error substitute( "&1. Ошибка при блокировании функции переименования кода товара&2&3&2&4"
     2454                                     ,vss-workfile
     2455                                     ,chr(10)
     2456                                     ,error-status :get-message(1)
     2457                                     ,return-value
     2458                                     ) .
     2459     end.
     2460     update_block:
     2461     do transaction
     2462     on error  undo update_block, return error substitute( "&1 (update_block). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2463     on stop   undo update_block, return error substitute( "&1 (update_block). stop", vss-workfile )
     2464     on quit   undo update_block, return error substitute( "&1 (update_block). quit", vss-workfile )
     2465     on endkey undo update_block, return error substitute( "&1 (update_block). endkey", vss-workfile )
     2466     :
     2467       find first buf_rename_goods exclusive-lock
     2468         where buf_rename_goods.gds-code = old-gds-code
     2469         no-error .
     2470       if not available buf_rename_goods then do:
     2471         if g#news
     2472         then do:
     2473           return.
     2474         end.
     2475         else do:
     2476           return error "Товар не доступен".
     2477         end.
     2478       end.
     2479       if buf_rename_goods.gds-code <> old-gds-code then do:
     2480         return error substitute( "Товарa с gds-code &1 НЕСУЩЕСТВУЕТ! Переименование не возможно.", old-gds-code ) .
     2481       end.
     2482       if new-gds-code = old-gds-code then do:
     2483         if g#news then do:
     2484           return.
     2485         end.
     2486         else do:
     2487           return error "Новый код товара должен отличаться от старого" .
     2488         end.
     2489       end.
     2490       if can-find(first b-goods no-lock where b-goods.gds-code  = new-gds-code) then do:
     2491         return error substitute( "Уже существует товар с кодом &1", new-gds-code ) .
     2492       end.
     2493       RUN gen-key-rec
     2494         (input 'goods':U
     2495         ,input (buffer buf_rename_goods:handle)
     2496         ,output old-gds-key-rec
     2497         ).
     2498       run waitfram-show in this-procedure
     2499         (input 'Переименование кода товара ' + string( buf_rename_goods.gds-code )
     2500         ).
