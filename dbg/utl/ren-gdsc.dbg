     2161         assign
     2162           fh_gds-code = ?
     2163         .
     2164         qh_tbl-name:get-next( exclusive-lock ).
     2165       END.
     2166       qh_tbl-name:query-close() .
     2167       delete object qh_tbl-name.
     2168       delete object bh_tbl-name.
     2169       if g#news = true
     2170         and lookup( p-tbl-name, ( news-list + ",":U + attach-list ) ) <> 0
     2171       then do:
     2172         run ren-route-dump in this-procedure
     2173           ( input "ren-gds-code":U
     2174            ,input p-old-gds-key-rec
     2175            ,input p-tbl-name
     2176            ,input ?
     2177            ,input ?
     2178            ,input ?
     2179            ,input ?
     2180            ,input ?
     2181            ,input ?
     2182            ,input p-old-gds-code
     2183            ,input p-new-gds-code
     2184           ) no-error .
