     2187         end.
     2188       end.
     2189     end.
     2190     return .
     2191   end procedure.
     2192   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2193   procedure valid-ren-gdsc-tbl-list :
