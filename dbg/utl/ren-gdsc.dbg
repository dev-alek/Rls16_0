     1973   ':U .
     1974   define variable oth-list1 as character no-undo .
     1975   define variable oth-list2 as character no-undo .
     1976   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1977   procedure ren-route-dump :
     1978     define input parameter p-action          as character no-undo .
     1979     define input parameter p-old-gds-key-rec as character no-undo .
     1980     define input parameter p-tbl-name        as character no-undo .
     1981     define input parameter p-old-artic       as character no-undo .
     1982     define input parameter p-old-prod-type   as character no-undo .
     1983     define input parameter p-old-prod-code   as integer   no-undo .
     1984     define input parameter p-new-artic       as character no-undo .
     1985     define input parameter p-new-prod-type   as character no-undo .
     1986     define input parameter p-new-prod-code   as integer   no-undo .
     1987     define input parameter p-old-gds-code    as integer   no-undo .
     1988     define input parameter p-new-gds-code    as integer   no-undo .
     1989     do
     1990     on error  undo, return error substitute( "&1 (ren-route-dump). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1991     on stop   undo, return error substitute( "&1 (ren-route-dump). stop", vss-workfile )
     1992     on endkey undo, return error substitute( "&1 (ren-route-dump). endkey", vss-workfile )
     1993     :
     1994       define buffer buf_route-dump      for ub.route-dump .
     1995       define buffer buf_route-dump-link for ub.route-dump-link .
     1996       define variable v-is-change as logical no-undo .
     1997       define variable tth           as handle    no-undo .
     1998       define variable tt-name       as character no-undo .
     1999       define variable v-ok          as logical   no-undo .
     2000       define variable bh_tt         as handle    no-undo .
     2001       define variable bh_route-dump as handle    no-undo .
     2002       define variable fh_artic      as handle    no-undo .
     2003       define variable fh_prod-type  as handle    no-undo .
     2004       define variable fh_prod-code  as handle    no-undo .
     2005       define variable fh_gds-code   as handle    no-undo .
     2006       create temp-table tth.
     2007       assign
     2008         tt-name = "tt_" + p-tbl-name
     2009       .
     2010       assign
     2011         v-ok = tth:create-like( "ub.":U + p-tbl-name ) no-error
     2012       .
     2013       if v-ok <> true then do:
     2014         undo, return error substitute( "&1 (ren-route-dump). Ошибка при создании временной таблицы &2 (1)", vss-workfile, tt-name ) .
     2015       end.
     2016       assign
     2017         v-ok = tth:temp-table-prepare( tt-name ) no-error
     2018       .
     2019       if v-ok <> true then do:
     2020         undo, return error substitute( "&1 (ren-route-dump). Ошибка при создании временной таблицы &2 (2)", vss-workfile, tt-name ) .
     2021       end.
     2022       assign
     2023         bh_tt = tth:default-buffer-handle
     2024       .
     2025       assign
     2026         v-ok = bh_tt:buffer-create no-error
     2027       .
     2028       if v-ok <> true then do:
     2029         undo, return error substitute( "&1 (ren-route-dump). Ошибка при создании буфера временной таблицы.", vss-workfile, tt-name ).
     2030       end.
     2031       for each buf_route-dump-link exclusive-lock
     2032         where buf_route-dump-link.uniq-key-rec = p-old-gds-key-rec
     2033           and buf_route-dump-link.dump-name    = p-tbl-name
     2034       on error undo, return error
     2035       :
     2036         for each buf_route-dump exclusive-lock
     2037           where buf_route-dump.dump-ord = buf_route-dump-link.dump-ord
     2038             and buf_route-dump.rec-ord  = buf_route-dump-link.rec-ord
     2039         on error  undo, return error
     2040         :
     2041           assign
     2042             bh_route-dump = buffer buf_route-dump:handle
     2043           .
     2044           assign
     2045             v-ok = bh_tt:raw-transfer ( false, bh_route-dump:buffer-field("value-rec":U) ) no-error
     2046           .
     2047           if v-ok <> true then do:
     2048             undo, return error substitute( "&1 (ren-route-dump). RAW-TRANSFER -> не прошел для таблицы &2. Rowid записи &3", vss-workfile, tt-name, bh_route-dump:rowid ).
     2049           end.
     2050           assign
     2051             v-is-change = false
     2052           .
     2053           case p-action :
     2054             when "ren-art":U then do:
     2055               assign
     2056                 fh_artic     = bh_tt:buffer-field("artic":U)
     2057                 fh_prod-type = bh_tt:buffer-field("prod-type":U)
     2058                 fh_prod-code = bh_tt:buffer-field("prod-code":U)
     2059               .
     2060               if fh_artic:buffer-value  = p-old-artic
     2061                 and fh_prod-type:buffer-value = p-old-prod-type
     2062                 and fh_prod-code:buffer-value = p-old-prod-code
     2063               then do:
     2064                 assign
     2065                   fh_artic:buffer-value     = p-new-artic
     2066                   fh_prod-type:buffer-value = p-new-prod-type
     2067                   fh_prod-code:buffer-value = p-new-prod-code
     2068                   v-is-change               = true
     2069                 .
     2070               end.
     2071             end.
     2072             when "ren-gds-code":U then do:
     2073               assign
     2074                 fh_gds-code = bh_tt:buffer-field("gds-code":U)
     2075               .
     2076               if fh_gds-code:buffer-value = p-old-gds-code then do:
     2077                 assign
     2078                   fh_gds-code:buffer-value = p-new-gds-code
     2079                   v-is-change              = true
     2080                 .
     2081               end.
     2082             end.
     2083           end case.
     2084           if v-is-change = true then do:
     2085             assign
     2086               v-ok = bh_tt:raw-transfer ( true, bh_route-dump:buffer-field("value-rec":U) ) no-error
     2087             .
     2088             if v-ok <> true then do:
     2089               undo, return error substitute( "&1 (ren-route-dump). RAW-TRANSFER <- не прошел для таблицы &2. Rowid записи &3", vss-workfile, tt-name, bh_route-dump:rowid ).
     2090             end.
     2091           end.
     2092         end.
     2093       end.
     2094       assign
     2095         v-ok = bh_tt:buffer-delete no-error
     2096       .
     2097       if v-ok <> true then do:
     2098         undo, return error substitute( "&1 (ren-route-dump). Ошибка при удалении буфера временной таблицы.", vss-workfile, tt-name ).
     2099       end.
     2100       assign
     2101         v-ok = tth:clear() no-error
     2102       .
     2103       if v-ok <> true then do:
     2104         undo, return error substitute( "&1 (ren-route-dump). Ошибка при очистке временной таблицы &2", vss-workfile, tt-name ) .
     2105       end.
     2106       delete object tth no-error .
     2107       if error-status:error then do:
     2108         undo, return error substitute( "&1 (ren-route-dump). Ошибка при удалении временной таблицы для &2", vss-workfile, tt-name ).
     2109       end.
     2110     end.
     2111     return.
     2112   end procedure.
     2113   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2114   procedure ren-gds-code :
     2115     define input parameter p-tbl-name        as character no-undo .
     2116     define input parameter p-old-gds-key-rec as character no-undo .
     2117     define input parameter p-old-gds-code    as integer   no-undo .
     2118     define input parameter p-new-gds-code    as integer   no-undo .
     2119     define input parameter p-search-bufs     as character no-undo .
     2120     define input parameter p-search-prefix   as character no-undo .
     2121     define input parameter p-search-suffix   as character no-undo .
     2122     do
     2123     on error  undo, return error substitute( "&1 (ren-gds-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
