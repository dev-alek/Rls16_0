      237   define variable ret-err              as logical   no-undo .
      238   define variable err-msg              as character no-undo .
      239   define variable sel-rid-list         as character no-undo .
      240   define variable answ-rid-list        as character no-undo .
      241   define variable v-cut-type           as integer   no-undo .
      242   define variable v-cut-run            as logical   no-undo .
      243   define variable v-db-list            as character no-undo .
      244   define variable v-not-answer-db-list as character no-undo .
      245   define variable v-ind                as integer   no-undo .
      246   define variable v-num-entries        as integer   no-undo .
      247   define buffer buf_BatchProcess for ub.BatchProcess .
      248   define buffer buf_db for ub.db .
      249   DEFINE VAR cut-load AS WIDGET-HANDLE NO-UNDO.
      250   DEFINE BUTTON b-exit DEFAULT
      251        LABEL "&Ввод"
      252        SIZE 10 BY 1.
      253   DEFINE BUTTON b-mark DEFAULT
      254        LABEL "&*"
      255        SIZE 3 BY 1.
      256   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      257        LABEL "&Отмена"
      258        SIZE 10 BY 1.
      259   DEFINE BUTTON b-refresh DEFAULT
      260        LABEL "&Обновить"
      261        SIZE 10 BY 1.
      262   DEFINE VARIABLE type-cut AS CHARACTER FORMAT "X(256)":U INITIAL "Полное"
      263        LABEL "Тип усечения БД"
      264        VIEW-AS COMBO-BOX INNER-LINES 2
      265        LIST-ITEMS "Полное" ,"Усечение документов по БД"
      266        DROP-DOWN-LIST
      267        SIZE 28.38 BY 1 NO-UNDO.
      268   DEFINE VARIABLE log-edit AS CHARACTER
      269        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      270        SIZE 96.38 BY 9.88 NO-UNDO.
      271   DEFINE VARIABLE date-actual-docs AS DATE FORMAT "99/99/9999":U
      272        LABEL "Дата актуальности документов и архивов"
      273        VIEW-AS FILL-IN
      274        SIZE 11 BY 1 NO-UNDO.
      275   DEFINE VARIABLE date-actual-findoc AS DATE FORMAT "99/99/9999":U
      276        LABEL "Дата актуальности финансовых документов"
      277        VIEW-AS FILL-IN
      278        SIZE 11.13 BY .92 NO-UNDO.
      279   DEFINE VARIABLE date-actual-goods AS DATE FORMAT "99/99/9999":U
      280        LABEL "Дата актуальности товаров"
      281        VIEW-AS FILL-IN
      282        SIZE 11 BY 1 NO-UNDO.
      283   DEFINE VARIABLE date-output-zone AS DATE FORMAT "99/99/9999":U
      284        LABEL "Дата расходной зоны"
      285        VIEW-AS FILL-IN
      286        SIZE 11.13 BY .92 NO-UNDO.
      287   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>9":U INITIAL 0
      288         VIEW-AS TEXT
      289        SIZE 3 BY .67 NO-UNDO.
      290   DEFINE RECTANGLE RECT-1
      291        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      292        SIZE 57 BY 9.58.
      293   DEFINE RECTANGLE RECT-2
      294        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      295        SIZE 40 BY 9.54.
      296   DEFINE VARIABLE not-copy-del-goods AS LOGICAL INITIAL yes
      297        LABEL "Не копировать удаленные товары с ненулевыми остатками"
      298        VIEW-AS TOGGLE-BOX
      299        SIZE 55.75 BY 1 NO-UNDO.
      300   DEFINE VARIABLE stay-history AS LOGICAL INITIAL no
      301        LABEL "Переносить историю по всем таблицам"
      302        VIEW-AS TOGGLE-BOX
      303        SIZE 38.25 BY 1 NO-UNDO.
      304   DEFINE VARIABLE stay-recipe-goods AS LOGICAL INITIAL yes
      305        LABEL "Оставить товары для рецептов"
      306        VIEW-AS TOGGLE-BOX
      307        SIZE 31.75 BY 1 NO-UNDO.
      308   DEFINE VARIABLE stay-weight-goods AS LOGICAL INITIAL yes
      309        LABEL "Оставить все весовые товары"
      310        VIEW-AS TOGGLE-BOX
      311        SIZE 30.25 BY 1 NO-UNDO.
      312   DEFINE QUERY br_db FOR
      313         ub.db SCROLLING.
      314   DEFINE BROWSE br_db
      315     QUERY br_db NO-LOCK DISPLAY
      316         (if ( lookup( string( recid( ub.db ) ), answ-rid-list ) <> 0 )
      317     then "+":U
      318     else (if ( lookup( string( recid( ub.db ) ), sel-rid-list ) <> 0 )
      319           then "*":U
      320           else "":U )
      321   ) COLUMN-LABEL "*" FORMAT "x(1)":U
      322         ub.db.db-num FORMAT ">>>>9":U
      323         ub.db.db-name FORMAT "X(40)":U
      324       WITH NO-ROW-MARKERS SEPARATORS SIZE 37.75 BY 7.83.
      325   DEFINE FRAME DEFAULT-FRAME
      326        b-exit AT ROW 1.17 COL 2.5
      327        b-quit AT ROW 1.17 COL 12.5
      328        type-cut AT ROW 2.46 COL 19.38 COLON-ALIGNED
      329        stay-weight-goods AT ROW 3.96 COL 1.75
      330        b-mark AT ROW 4.04 COL 62.25
      331        b-refresh AT ROW 4.04 COL 87.5
      332        not-copy-del-goods AT ROW 5.13 COL 1.75
      333        br_db AT ROW 5.21 COL 60.25
      334        stay-recipe-goods AT ROW 6.21 COL 1.75
      335        date-actual-goods AT ROW 7.42 COL 41.13 COLON-ALIGNED
      336        date-actual-docs AT ROW 8.54 COL 41.13 COLON-ALIGNED
      337        date-actual-findoc AT ROW 9.71 COL 41.13 COLON-ALIGNED
      338        date-output-zone AT ROW 10.83 COL 41.13 COLON-ALIGNED
      339        stay-history AT ROW 11.88 COL 2.88
      340        log-edit AT ROW 13.5 COL 2.38 NO-LABEL
      341        mark-num AT ROW 4.25 COL 64.25 COLON-ALIGNED NO-LABEL
      342        RECT-1 AT ROW 3.71 COL 1
      343        RECT-2 AT ROW 3.71 COL 59
      344       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      345            SIDE-LABELS THREE-D
      346            AT COL 1 ROW 1
      347            SIZE 98.88 BY 22.63
      348            CANCEL-BUTTON b-quit.
      349   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      350     CREATE WINDOW cut-load ASSIGN
      351            HIDDEN             = YES
      352            TITLE              = "'Запуск"
      353            HEIGHT             = 22.63
      354            WIDTH              = 98.88
      355            MAX-HEIGHT         = 23.63
      356            MAX-WIDTH          = 98.88
      357            VIRTUAL-HEIGHT     = 23.63
      358            VIRTUAL-WIDTH      = 98.88
      359            RESIZE             = no
      360            SCROLL-BARS        = no
      361            STATUS-AREA        = no
      362            BGCOLOR            = ?
      363            FGCOLOR            = ?
      364            KEEP-FRAME-Z-ORDER = yes
      365            THREE-D            = yes
      366            MESSAGE-AREA       = no
      367            SENSITIVE          = yes.
      368   ELSE cut-load = CURRENT-WINDOW.
      369   ASSIGN
      370          FRAME DEFAULT-FRAME:HIDDEN           = TRUE.
      371   ASSIGN
      372          date-actual-findoc:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
      373   ASSIGN
      374          log-edit:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
      375   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(cut-load)
      376   THEN cut-load:HIDDEN = no.
      377   ON END-ERROR OF cut-load
      378   OR ENDKEY OF cut-load ANYWHERE DO:
      379     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
      380   END.
      381   ON WINDOW-CLOSE OF cut-load
      382   DO:
      383     APPLY "CLOSE":U TO THIS-PROCEDURE.
      384     RETURN NO-APPLY.
      385   END.
      386   ON CHOOSE OF b-exit IN FRAME DEFAULT-FRAME
      387   DO:
      388     define variable v-ok               as logical   no-undo .
      389     define variable v-date             as date      no-undo .
      390     define variable v-time             as integer   no-undo .
      391     define variable v-db-send          as character no-undo .
      392     define variable v-db-num-str       as character no-undo .
      393     define variable v-deleted          as logical   no-undo .
      394     define variable v-unload-after-cut as character no-undo .
      395     define variable v-ready            as logical   no-undo .
      396     assign frame DEFAULT-FRAME
      397       date-actual-goods
      398       date-actual-docs
      399       date-output-zone
      400       stay-recipe-goods
      401       stay-weight-goods
      402       stay-history
      403       not-copy-del-goods
      404       type-cut
      405     .
      406     if date-actual-docs = ? then do:
      407       assign
      408         date-actual-docs = TODAY
      409       .
      410     end.
      411     assign
      412       date-actual-findoc = date-actual-docs
      413     .
      414     assign
      415       v-ok = false
      416     .
      417     if ( v-cut-type = 1 and v-cut-run <> true )
      418        or v-cut-type <> 1
      419     then do:
      420       message
      421         'Вы уверены, что хотите произвести "обрезание" базы данных?' skip
      422         view-as alert-box question buttons yes-no update v-ok .
      423       if v-ok <> true then do:
      424         return no-apply .
      425       end.
      426     end.
      427     if v-cut-type = 1 then do:
      428       if v-cut-run = true then do:
      429         run scan-ready in this-procedure
      430           ( input v-db-list
      431            ,input date-actual-docs
      432            ,input date-actual-findoc
      433            ,output answ-rid-list
      434            ,output v-not-answer-db-list
      435           ).
      436         if v-not-answer-db-list <> "":U then do:
      437           message
      438             substitute( "УБД &1 еще не прислали подтверждения о готовности!", v-not-answer-db-list ) skip
      439             view-as alert-box error
      440           .
      441           return no-apply.
      442         end.
      443         assign
      444           v-ok               = true
      445           not-copy-del-goods = false
      446           stay-weight-goods  = true
      447           stay-recipe-goods  = true
      448           date-actual-goods  = 01/01/1900
      449           date-output-zone   = 01/01/1900
      450         .
      451       end.
      452       else do:
      453         do transaction
      454         on error undo, return no-apply
      455         :
      456           assign
      457             v-num-entries = num-entries( sel-rid-list )
      458             v-db-list     = "":U
      459             v-db-send     = "":U
      460             v-ok          = false
      461           .
      462           do v-ind = 1 to v-num-entries
      463           on error undo, return no-apply
      464           :
      465             find first buf_db no-lock
      466               where recid( buf_db ) = integer( entry( v-ind, sel-rid-list ) )
      467               .
      468             assign
      469               v-db-num-str = string( buf_db.db-num )
      470               v-db-list    = ( if v-db-list <> "":U then (v-db-list + chr(44)) else "":U ) + v-db-num-str
      471               v-ready      = false
      472             .
      473             if buf_db.db-num <> 0 then do:
      474               assign
      475                 v-unload-after-cut = "no":U
      476               .
      477               if trim( buf_db.db-key ) = "":U then do:
      478                 assign
      479                   v-ready = true
      480                 .
      481               end.
      482               else do:
      483                 assign
      484                   v-db-send = ( if v-db-send <> "":U then (v-db-send + chr(1)) else "":U ) + v-db-num-str
      485                   v-ready   = false
      486                 .
      487               end.
      488             end.
      489             else do:
      490               if lookup( "0":U, v-db-list, chr(44) ) <> 0 then do:
      491                 assign
      492                   v-unload-after-cut = "yes":U
      493                   v-ready            = true
      494                 .
      495               end.
      496               else do:
      497                 assign
      498                   v-unload-after-cut = "":U
      499                   v-ready            = false
      500                 .
      501               end.
      502             end.
      503             if v-unload-after-cut <> "":U then do:
      504               run db-attr-write
      505                 ( input buf_db.db-num
      506                  ,input 'unload-after-cut':U
      507                  ,input v-unload-after-cut
      508                 ) no-error.
      509               if error-status :error then do:
      510                 message
      511                   vss-workfile vss-revision vss-description skip
      512                   substitute( "Ошибка при записи значения атрибута 'выгрузка после обрезания' для БД &1", buf_db.db-num ) skip
      513                   return-value skip
      514                   error-status :get-message ( error-status :num-messages )
      515                   view-as alert-box error
      516                 .
      517                 return no-apply.
      518               end.
      519               if v-ready = true then do:
      520                 run db-attr-write in this-procedure
      521                   ( input buf_db.db-num
      522                    ,input 'cut-date':U
      523                    ,input string( date-actual-docs, "99/99/9999" )
      524                   ) no-error.
      525                 if error-status :error then do:
      526                   message
      527                     vss-workfile vss-revision vss-description skip
      528                     substitute( "Ошибка при записи значения атрибута 'дата обрезания складских документов' для БД &1", buf_db.db-num ) skip
      529                     return-value skip
      530                     error-status :get-message ( error-status :num-messages )
      531                     view-as alert-box error
      532                   .
      533                   undo, return no-apply.
      534                 end.
      535                 run db-attr-write in this-procedure
      536                   ( input buf_db.db-num
      537                    ,input 'cut-fin-date':U
      538                    ,input string( date-actual-findoc, "99/99/9999" )
      539                   ) no-error.
      540                 if error-status :error then do:
      541                   message
      542                     vss-workfile vss-revision vss-description skip
      543                     substitute( "Ошибка при записи значения атрибута 'дата обрезания финансовых документов' для БД &1", buf_db.db-num ) skip
      544                     return-value skip
      545                     error-status :get-message ( error-status :num-messages )
      546                     view-as alert-box error
      547                   .
      548                   undo, return no-apply.
      549                 end.
      550               end.
      551             end.
      552           end.
      553           assign
      554             v-date    = TODAY
      555             v-time    = TIME
      556             v-cut-run = true
      557           .
      558           run db-attr-write in this-procedure
      559             ( input 0
      560              ,input 'cut-db-list':U
      561              ,input v-db-list
      562             ) no-error.
      563           if error-status :error then do:
      564             message
      565               vss-workfile vss-revision vss-description skip
      566               substitute( "Ошибка при записи значения атрибута 'Список БД для обрезания' для БД 0" ) skip
      567               return-value skip
      568               error-status :get-message ( error-status :num-messages )
      569               view-as alert-box error
      570             .
      571             undo, return no-apply.
      572           end.
      573           create buf_BatchProcess.
      574           assign
      575             buf_BatchProcess.BatchProcess#     = next-value (s-btpr, ub)
      576             buf_BatchProcess.BP_Type           = 'cutdbs':U
      577             buf_BatchProcess.CharKey_Two       = string( date-actual-docs, "99/99/9999" )
      578             buf_BatchProcess.CharKey_Three     = string( date-actual-findoc, "99/99/9999" )
      579             buf_BatchProcess.User_ID           = "cut-load":U
      580             buf_BatchProcess.BP_SysDate        = v-date
      581             buf_BatchProcess.BP_SysTimeInt     = v-time
      582             buf_BatchProcess.BP_SysTime        = string(v-time, 'HH:MM:SS':U)
      583             buf_BatchProcess.BP_ExecSysDate    = v-date
      584             buf_BatchProcess.BP_ExecSysTimeInt = v-time
      585             buf_BatchProcess.BP_ExecSysTime    = string(v-time, 'HH:MM:SS':U)
      586           .
      587           run nws/cr-route.p
      588             ( input 'send-cmd':U
      589              ,input "command" + chr(1) + "cut-doc" + chr(1) + string( date-actual-docs, "99/99/9999" ) + chr(1) + string( date-actual-findoc, "99/99/9999" )
      590              ,input ?
      591              ,input v-db-send
      592             ).
      593         end.
      594         apply "value-changed" to type-cut in frame DEFAULT-FRAME.
      595         message
      596           "Команда о начале процесса усечения документов отправлена в выбранные БД." skip
      597           "Обменяйтесь новостями." skip
      598           "После получения подтверждения запустите процесс усечения документов."
      599           view-as alert-box information.
      600       end.
      601     end.
      602     else do:
      603       assign
      604         v-ok = true
      605       .
      606     end.
      607     if v-ok = true then do:
      608       run utl/cutld.p
      609         ( input v-cut-type
      610          ,input v-db-list
      611          ,input date-actual-goods
      612          ,input date-actual-docs
      613          ,input date-actual-findoc
      614          ,input date-output-zone
      615          ,input stay-recipe-goods
      616          ,input stay-weight-goods
      617          ,input not-copy-del-goods
      618          ,input stay-history
      619          ,input this-procedure :handle
      620         ) no-error.
      621       if error-status :error then do:
      622         assign
      623           ret-err = TRUE
      624           err-msg = return-value
      625         .
      626         message
      627           vss-workfile vss-revision vss-description skip
      628           substitute( "Ошибка при работе утилит!" ) skip
      629           return-value skip
      630           error-status :get-message ( error-status :num-messages )
      631           view-as alert-box error
      632         .
      633       end.
      634       else do:
      635         if v-cut-type = 1 then do:
      636           for each buf_BatchProcess
      637             where buf_BatchProcess.BP_type = 'cutdbs':U
      638           on error undo, return no-apply
      639           :
      640             delete buf_BatchProcess .
      641           end.
      642           run db-attr-delete in this-procedure
      643             ( input 0
      644              ,input 'cut-db-list':U
      645              ,output v-deleted
      646             ).
      647         end.
      648         message
      649           substitute( "Усечение завершено." ) skip
      650           view-as alert-box information
      651         .
      652       end.
      653       apply "close":u to this-procedure.
      654       return no-apply.
      655     end.
      656   END.
      657   ON CHOOSE OF b-mark IN FRAME DEFAULT-FRAME
      658   OR MOUSE-SELECT-DBLCLICK OF br_db IN FRAME DEFAULT-FRAME
      659   DO:
      660     define variable v-log as logical no-undo.
      661     if available ub.db then do:
      662   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   define variable v-str-recid2 as character no-undo .
      664   define variable v-num-entry2 as integer   no-undo .
      665   assign
      666     v-str-recid2 = trim( string( recid( ub.db ) , "->>>>>>>>>>>9":U ) )
      667     v-num-entry2 = lookup( v-str-recid2 , sel-rid-list )
      668   .
      669   if v-num-entry2 > 0 then do:
      670     assign
      671       entry( v-num-entry2, sel-rid-list ) = "":U
      672       sel-rid-list = trim( replace( sel-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      673     .
      674   end.
      675   else do:
      676     assign
      677       sel-rid-list = sel-rid-list + ( if sel-rid-list = "":U then "":U else chr(44) ) + v-str-recid2
      678     .
      679   end.
      680       v-log = br_db:refresh() .
      681       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      682         v-log = br_db:select-next-row ().
      683         apply "iteration-changed" to br_db in frame DEFAULT-FRAME.
      684       end.
      685       if num-entries( sel-rid-list ) = 0 then do:
      686         hide mark-num in frame DEFAULT-FRAME.
      687       end.
      688       else do:
      689         disp num-entries( sel-rid-list ) @ mark-num with frame DEFAULT-FRAME.
      690       end.
      691     end.
      692     apply "entry" to br_db in frame DEFAULT-FRAME.
      693   END.
      694   ON CHOOSE OF b-quit IN FRAME DEFAULT-FRAME
      695   DO:
      696     APPLY "CLOSE":U TO THIS-PROCEDURE.
      697     RETURN NO-APPLY.
      698   END.
      699   ON CHOOSE OF b-refresh IN FRAME DEFAULT-FRAME
      700   DO:
      701     define variable v-log as logical no-undo.
      702     run scan-ready in this-procedure
      703       ( input  v-db-list
      704        ,input  date-actual-docs
      705        ,input  date-actual-findoc
      706        ,output answ-rid-list
      707        ,output v-not-answer-db-list
      708       ).
      709     v-log = br_db:refresh() .
      710   END.
      711   ON VALUE-CHANGED OF type-cut IN FRAME DEFAULT-FRAME
      712   DO:
      713     assign
      714       type-cut
      715     .
      716     case type-cut :
      717       when "Полное" then do:
      718         assign
      719           v-cut-type = 0
      720         .
      721         HIDE
      722           br_db
      723           b-mark
      724           b-refresh
      725           mark-num
      726           IN FRAME DEFAULT-FRAME IN WINDOW cut-load.
      727         ENABLE
      728           stay-weight-goods
      729           not-copy-del-goods
      730           stay-recipe-goods
      731           stay-history
      732           date-actual-goods
      733           date-output-zone
      734           WITH FRAME DEFAULT-FRAME IN WINDOW cut-load.
      735       end.
      736       when "Усечение документов по БД" then do:
      737         assign
      738           v-cut-type = 1
      739         .
      740         HIDE
      741           stay-weight-goods
      742           not-copy-del-goods
      743           stay-recipe-goods
      744           date-actual-goods
      745           date-output-zone
      746           IN FRAME DEFAULT-FRAME IN WINDOW cut-load.
      747         ENABLE
      748           br_db
      749           b-mark
      750           b-refresh
      751           stay-history
      752           WITH FRAME DEFAULT-FRAME IN WINDOW cut-load.
      753         if v-cut-run = true then do:
      754           DISABLE
      755             b-mark
      756             date-actual-docs
      757             date-actual-findoc
      758             type-cut
      759             WITH FRAME DEFAULT-FRAME .
      760         end.
      761         assign
      762           mark-num = num-entries( sel-rid-list )
      763         .
      764         if mark-num <> 0 then do:
      765           DISPLAY
      766             mark-num
      767             WITH FRAME DEFAULT-FRAME IN WINDOW cut-load.
      768         end.
      769         else do:
      770           HIDE
      771             mark-num
      772             IN FRAME DEFAULT-FRAME IN WINDOW cut-load.
      773         end.
      774       end.
      775     end case.
      776   END.
      777   ASSIGN CURRENT-WINDOW                = cut-load
      778          THIS-PROCEDURE:CURRENT-WINDOW = cut-load.
      779   ON CLOSE OF THIS-PROCEDURE
      780      RUN disable_UI.
      781   PAUSE 0 BEFORE-HIDE.
