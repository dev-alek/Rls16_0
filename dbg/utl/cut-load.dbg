      137     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      138     define input parameter p-value     like ub.db-attr.attr-value no-undo .
      139     do
      140     on error undo, return error
      141     :
      142           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
      143         (input p-db-num
      144         ,input p-code
      145         ,input p-value
      146         ) no-error .
      147       if error-status :error
      148       then do:
      149         undo, return error return-value .
      150       end.
      151     end.
      152   end procedure.
      153   procedure db-attr-exist :
      154     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      155     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      156     define output parameter p-exist    as logical  no-undo .
      157     do
      158     on error undo, return error
      159     :
      160           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
      161         (input  p-db-num
      162         ,input  p-code
      163         ,output p-exist
      164         ) no-error .
      165       if error-status :error
      166       then do:
      167         undo, return error return-value .
