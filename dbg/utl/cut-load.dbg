     1674   MAIN-BLOCK:
     1675   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1676      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1677     define buffer buf_sys-ctrl     for ub.sys-ctrl .
     1678     define variable v-attr-type as character no-undo .
     1679     define variable v-log       as logical   no-undo .
     1680     find first buf_sys-ctrl no-lock .
     1681     if buf_sys-ctrl.db-num <> 0 then do:
     1682       message
     1683         vss-workfile vss-revision vss-description skip
     1684         substitute( "Данная утилита может запускаться только в ГБД" ) skip
     1685         view-as alert-box error
     1686       .
     1687       return error .
     1688     end.
     1689     find first buf_BatchProcess no-lock
     1690       where buf_BatchProcess.BP_type = 'cutdbs':U
     1691       no-error .
     1692     if available buf_BatchProcess then do:
     1693       run db-attr-value in this-procedure
     1694         ( input 0
     1695          ,input 'cut-db-list':U
     1696          ,output v-db-list
     1697          ,output v-attr-type
     1698         ) no-error.
     1699       if error-status :error then do:
     1700         message
     1701           vss-workfile vss-revision vss-description skip
     1702           substitute( "Ошибка при чтении значения атрибута 'Список БД для обрезания'" ) skip
     1703           return-value skip
     1704           error-status :get-message ( error-status :num-messages )
     1705           view-as alert-box error
     1706         .
     1707         undo, return error .
     1708       end.
     1709       if v-db-list = "":U then do:
     1710         message
     1711           substitute( "Список БД для обрезания пуст!!!" ) skip
     1712           view-as alert-box error
     1713         .
     1714         undo, return error .
     1715       end.
     1716       assign
     1717         v-cut-run          = true
     1718         type-cut           = "Усечение документов по БД"
     1719         date-actual-docs   = date( buf_BatchProcess.CharKey_Two )
     1720         date-actual-findoc = date( buf_BatchProcess.CharKey_Three )
     1721         v-num-entries      = num-entries( v-db-list )
     1722       .
     1723       do v-ind = 1 to v-num-entries
     1724       on error undo, return error
     1725       :
     1726         find first buf_db no-lock
     1727           where buf_db.db-num = integer( entry( v-ind, v-db-list ) )
     1728           .
     1729         if sel-rid-list = "":U then do:
     1730           assign
     1731             sel-rid-list = string( recid( buf_db ) )
     1732           .
     1733         end.
     1734         else do:
     1735           assign
     1736             sel-rid-list = sel-rid-list + chr(44) + string( recid( buf_db ) )
     1737           .
     1738         end.
     1739       end.
     1740     end.
     1741     find first buf_sys-ctrl .
     1742     if trim( buf_sys-ctrl.status_ ) = 'sttsDB-cutld':u then do:
     1743       message
     1744         substitute( "Предыдущая попытка запуска усечения не была завершена!" ) skip
     1745         substitute( "Вы желаете повторить усечение?" ) skip
     1746         view-as alert-box question buttons yes-no update v-log.
     1747       if v-log <> true then do:
     1748         do transaction
     1749         on error undo, return error return-value
     1750         on stop  undo, return error return-value
     1751         :
     1752           find first buf_sys-ctrl exclusive-lock .
     1753           assign
     1754             buf_sys-ctrl.status_ = "":U
     1755           .
     1756           release buf_sys-ctrl.
     1757         end.
     1758         QUIT .
     1759       end.
     1760     end.
     1761     run scan-ready in this-procedure
     1762       ( input  v-db-list
     1763        ,input  date-actual-docs
     1764        ,input  date-actual-findoc
     1765        ,output answ-rid-list
     1766        ,output v-not-answer-db-list
     1767       ).
     1768     RUN enable_UI.
     1769     assign
     1770       ret-err = FALSE
     1771     .
     1772     apply "value-changed" to type-cut in frame DEFAULT-FRAME.
     1773     create alias src for database ub .
     1774     create alias ubfltsrc for database ub .
     1775     create alias ubfltdst for database dst .
     1776     IF NOT THIS-PROCEDURE:PERSISTENT THEN
     1777       WAIT-FOR CLOSE OF THIS-PROCEDURE.
     1778     QUIT .
     1779   END.
     1780   PROCEDURE callback-write-to-log :
     1781     define input parameter p-msg-str as character no-undo .
     1782     define variable lok as logical   no-undo .
     1783     do with frame DEFAULT-FRAME
     1784     on error undo, return error return-value
     1785     :
     1786       assign
     1787         lok = log-edit :move-to-eof( )
     1788         lok = log-edit :insert-string( p-msg-str )
     1789         lok = log-edit :move-to-eof( )
     1790       .
     1791     end.
     1792   END PROCEDURE.
     1793   PROCEDURE disable_UI :
     1794     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(cut-load)
     1795     THEN DELETE WIDGET cut-load.
     1796     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1797   END PROCEDURE.
     1798   PROCEDURE enable_UI :
     1799     DISPLAY type-cut stay-weight-goods not-copy-del-goods stay-recipe-goods
     1800             date-actual-goods date-actual-docs date-output-zone stay-history
     1801             log-edit mark-num
     1802         WITH FRAME DEFAULT-FRAME IN WINDOW cut-load.
     1803     ENABLE RECT-1 RECT-2 b-exit b-quit type-cut stay-weight-goods b-mark
     1804            b-refresh not-copy-del-goods br_db stay-recipe-goods date-actual-goods
     1805            date-actual-docs date-output-zone stay-history log-edit
     1806         WITH FRAME DEFAULT-FRAME IN WINDOW cut-load.
     1807     VIEW FRAME DEFAULT-FRAME IN WINDOW cut-load.
     1808     OPEN QUERY br_db FOR EACH ub.db NO-LOCK.
     1809     VIEW cut-load.
     1810   END PROCEDURE.
     1811   PROCEDURE scan-ready :
     1812     define input  parameter p-db-list            as character no-undo.
     1813     define input  parameter p-cut-date           as date      no-undo .
     1814     define input  parameter p-cut-fin-date       as date      no-undo .
     1815     define output parameter p-ready-db-rid-list  as character no-undo .
     1816     define output parameter p-not-answer-db-list as character no-undo .
     1817     define variable v-db-num          as integer   no-undo .
     1818     define variable v-attr-exist      as logical   no-undo .
     1819     define variable v-cut-date        as character no-undo .
     1820     define variable v-attr-fin-exist  as logical   no-undo .
     1821     define variable v-cut-fin-date    as character no-undo .
     1822     define variable v-attr-type       as character no-undo .
     1823     assign
     1824       v-num-entries        = num-entries( p-db-list )
     1825       p-not-answer-db-list = "":U
     1826       p-ready-db-rid-list  = "":U
     1827     .
     1828     do v-ind = 1 to v-num-entries
     1829     on error undo, return no-apply
     1830     :
     1831       assign
     1832         v-db-num = integer( entry( v-ind, p-db-list ) )
     1833       .
     1834       find first buf_db no-lock
     1835         where buf_db.db-num = v-db-num
     1836         .
     1837       run db-attr-exist ( input v-db-num
     1838                          ,input 'cut-date':U
     1839                          ,output v-attr-exist
     1840                         ) no-error.
     1841       if error-status :error then do:
     1842         message
     1843           vss-workfile vss-revision vss-description skip
     1844           substitute( "Ошибка при определении наличия атрибута 'дата обрезания' для БД &1", v-db-num ) skip
     1845           return-value skip
     1846           error-status :get-message ( error-status :num-messages )
     1847           view-as alert-box error
     1848         .
     1849         return no-apply.
     1850       end.
     1851       run db-attr-value ( input v-db-num
     1852                          ,input 'cut-date':U
     1853                          ,output v-cut-date
     1854                          ,output v-attr-type
     1855                         ) no-error.
     1856       if error-status :error then do:
     1857         message
     1858           vss-workfile vss-revision vss-description skip
     1859           substitute( "Ошибка при чтении значения атрибута 'дата обрезания' для БД &1", v-db-num ) skip
     1860           return-value skip
     1861           error-status :get-message ( error-status :num-messages )
     1862           view-as alert-box error
     1863         .
     1864         return no-apply.
     1865       end.
     1866       run db-attr-exist ( input v-db-num
     1867                          ,input 'cut-fin-date':U
     1868                          ,output v-attr-fin-exist
     1869                         ) no-error.
     1870       if error-status :error then do:
     1871         message
     1872           vss-workfile vss-revision vss-description skip
     1873           substitute( "Ошибка при определении наличия атрибута 'дата обрезания фин.документов' для БД &1", v-db-num ) skip
     1874           return-value skip
     1875           error-status :get-message ( error-status :num-messages )
     1876           view-as alert-box error
     1877         .
     1878         return no-apply.
     1879       end.
     1880       run db-attr-value ( input v-db-num
     1881                          ,input 'cut-fin-date':U
     1882                          ,output v-cut-fin-date
     1883                          ,output v-attr-type
     1884                         ) no-error.
     1885       if error-status :error then do:
     1886         message
     1887           vss-workfile vss-revision vss-description skip
     1888           substitute( "Ошибка при чтении значения атрибута 'дата обрезания фин.документов' для БД &1", v-db-num ) skip
     1889           return-value skip
     1890           error-status :get-message ( error-status :num-messages )
     1891           view-as alert-box error
     1892         .
     1893         return no-apply.
     1894       end.
     1895       if v-attr-exist <> true
     1896         or date( v-cut-date ) <> p-cut-date
     1897         or v-attr-fin-exist <> true
     1898         or date( v-cut-fin-date ) <> p-cut-fin-date
     1899       then do:
     1900         if p-not-answer-db-list = "":U then do:
     1901           assign
     1902             p-not-answer-db-list = string( v-db-num )
     1903           .
     1904         end.
     1905         else do:
     1906           assign
     1907             p-not-answer-db-list = p-not-answer-db-list + chr(44) + string( v-db-num )
     1908           .
     1909         end.
     1910       end.
     1911       else do:
     1912         if p-ready-db-rid-list = "":U then do:
     1913           assign
     1914             p-ready-db-rid-list = string( recid( buf_db ) )
     1915           .
     1916         end.
     1917         else do:
     1918           assign
     1919             p-ready-db-rid-list = p-ready-db-rid-list + chr(44) + string( recid( buf_db ) )
     1920           .
     1921         end.
     1922       end.
     1923     end.
     1924   END PROCEDURE.
