        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define new global shared variable g#library  as handle no-undo .
       13   define new global shared variable g#library2 as handle no-undo .
       14   define new  shared variable g#auto as logical no-undo.
       15   define new  shared variable g#news as logical no-undo.
       16   define new  shared variable g#oxml as logical no-undo.
       17   define new  shared variable g#esys as logical no-undo.
       18   define new  shared variable g#news-source-db as integer no-undo.
       19   define new  shared variable g#esys-source-esys as integer no-undo.
       20   define new  shared variable g#db-num as integer   no-undo .
       21   define new  shared variable g#userid as character no-undo .
       22   define new  shared variable g#passwd as character no-undo .
       23   procedure proc-alt-shift-f2:
       24     if not ibs.th.gbl.gbl-var:rcode
       25   then
       26     run gbl\inidebug.p .
       27   end.
       28   procedure proc-alt-shift-f3:
       29     run gbl/prvssinf.p
       30       ( input this-procedure
       31       ) .
       32   end.
       33   define variable v-inform-launched as logical no-undo initial false .
       34   procedure proc-alt-shift-f4:
       35     define variable v-action as character no-undo .
       36     if v-inform-launched = false then do:
       37       assign
       38         v-inform-launched = true
       39       .
       40       run gbl/d-inform.w
       41         (  input self
       42         ,  input this-procedure
       43         , output v-action
       44         ) no-error .
       45       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       46       assign
       47         v-inform-launched = false
       48       .
       49     end.
       50   end.
       51   procedure proc-alt-f1:
       52     run gbl/corrhelp.p
       53       (input this-procedure
       54       ) .
       55   end .
       56   on alt-shift-f2 anywhere do:
       57     run proc-alt-shift-f2.
       58   end.
       59   on alt-shift-f3 anywhere do:
       60     run proc-alt-shift-f3 in this-procedure .
       61   end.
       62   on alt-shift-f4 anywhere do:
       63     run proc-alt-shift-f4 in this-procedure.
       64   end.
       65   on alt-f1 anywhere do:
       66     run proc-alt-f1 in this-procedure .
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define new global shared variable g#attr-lib  as handle no-undo .
       70   define variable v-attr-lib-variable as handle no-undo .
       71   procedure db-attr-code :
       72     define input  parameter p-code           as character no-undo .
       73     define output parameter p-type           as character no-undo .
       74     define output parameter p-format         as character no-undo .
       75     define output parameter p-label          as character no-undo .
       76     define output parameter p-user-can-edit  as logical   no-undo .
       77     define output parameter p-output-display as logical   no-undo .
       78     define output parameter p-other          as character no-undo .
       79     do
       80     on error undo, return error
       81     :
       82           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
       83         (input  p-code
       84         ,output p-type
       85         ,output p-format
       86         ,output p-label
       87         ,output p-user-can-edit
       88         ,output p-output-display
       89         ,output p-other
       90         ) no-error .
       91       if error-status :error
       92       then do:
       93         undo, return error return-value .
       94       end.
       95     end.
       96   end procedure.
       97   procedure db-attr-tooltip :
       98     define input  parameter p-code    as character no-undo .
       99     define output parameter p-tooltip as character no-undo .
      100     define output parameter p-label   as character no-undo .
      101     do
      102     on error undo, return error
      103     :
      104           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-tooltip in g#attr-lib
      105         (input  p-code
      106         ,output p-tooltip
      107         ,output p-label
      108         ) no-error .
      109       if error-status :error
      110       then do:
      111         undo, return error return-value .
      112       end.
      113     end.
      114   end procedure.
      115   procedure db-attr-value :
      116     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      117     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      118     define output parameter p-value     like ub.db-attr.attr-value no-undo .
      119     define output parameter p-type      as character no-undo .
      120     do
      121     on error undo, return error
      122     :
      123           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
      124         (input  p-db-num
      125         ,input  p-code
      126         ,output p-value
      127         ,output p-type
      128         ) no-error .
      129       if error-status :error
      130       then do:
      131         undo, return error return-value .
      132       end.
      133     end.
