        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: 9ebe6f343c82, 149, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Feb 16 20:50:30 2015 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: i-alcref.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/i-alcref.p $":U .
        8   define variable vss-description as character no-undo init "Утилита закачки видов алкоголя".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable v-account as integer init 0 no-undo .
       68   define variable v-account-lavel as character no-undo .
       69   define variable v-button-stop as logical no-undo .
       70   define variable v-kol-spice as integer no-undo .
       71   define variable v-kol-spice2 as integer no-undo .
       72   define variable v-kol-spice3 as integer no-undo .
       73   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
       74   DEFINE BUTTON StopBtn AUTO-END-KEY
       75        LABEL "Стоп"
       76        SIZE 10 BY 1.
       77   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
       78        LABEL "Обработано записей"
       79         VIEW-AS TEXT
       80        SIZE 14 BY .67 NO-UNDO.
       81   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
       82         VIEW-AS TEXT
       83        SIZE 53.25 BY .67
       84        FGCOLOR 1  NO-UNDO.
       85   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
       86         VIEW-AS TEXT
       87        SIZE 53.25 BY .67
       88        FGCOLOR 1  NO-UNDO.
       89   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
       90         VIEW-AS TEXT
       91        SIZE 53.25 BY .67
       92        FGCOLOR 1  NO-UNDO.
       93   DEFINE RECTANGLE RECT-1
       94        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
       95        SIZE 55.13 BY 4.46.
       96   DEFINE FRAME InfoFrame
       97        StopBtn AT ROW 4.25 COL 21.75
       98        RecordsString AT ROW 1.21 COL 2 NO-LABEL
       99        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      100        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      101        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      102        RECT-1 AT ROW 1 COL 1
      103       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      104            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      105            TITLE "Процесс"
      106            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      107   define variable mFrameView      as logical   no-undo init yes.
      108     define variable mFramHandle as handle no-undo.
      109     mFramHandle = frame InfoFrame:handle.
      110     if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      115     end.
      116     mFrameView = not session:batch-mode and mFramHandle:visible.
      117     if mFrameView
      118     then do:
      119       ASSIGN
      120          FRAME InfoFrame:HIDDEN                           = TRUE
      121          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      122     end.
      123   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      124   DO:
      125     IF not StopProcessing THEN
      126       Message "Вы действительно хотите прервать" SKIP
      127               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      128                 UPDATE StopProcessing.
      129     IF StopProcessing THEN do:
      130        if mFrameView
      131        then do:
      132           HIDE FRAME InfoFrame.
      133        end.
      134     End.
      135   END.
      136   define new global shared variable g#library  as handle no-undo .
      137   define new global shared variable g#library2 as handle no-undo .
      138   define   shared variable g#auto as logical no-undo.
      139   define   shared variable g#news as logical no-undo.
      140   define   shared variable g#oxml as logical no-undo.
      141   define   shared variable g#esys as logical no-undo.
      142   define   shared variable g#news-source-db as integer no-undo.
      143   define   shared variable g#esys-source-esys as integer no-undo.
      144   define   shared variable g#db-num as integer   no-undo .
      145   define   shared variable g#userid as character no-undo .
      146   define   shared variable g#passwd as character no-undo .
      147   procedure proc-alt-shift-f2:
      148     if not ibs.th.gbl.gbl-var:rcode
      149   then
      150     run gbl\inidebug.p .
      151   end.
      152   procedure proc-alt-shift-f3:
      153     run gbl/prvssinf.p
      154       ( input this-procedure
      155       ) .
      156   end.
      157   define variable v-inform-launched as logical no-undo initial false .
      158   procedure proc-alt-shift-f4:
      159     define variable v-action as character no-undo .
      160     if v-inform-launched = false then do:
      161       assign
      162         v-inform-launched = true
      163       .
      164       run gbl/d-inform.w
      165         (  input self
      166         ,  input this-procedure
      167         , output v-action
      168         ) no-error .
      169       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      170       assign
      171         v-inform-launched = false
      172       .
      173     end.
      174   end.
      175   procedure proc-alt-f1:
      176     run gbl/corrhelp.p
      177       (input this-procedure
      178       ) .
      179   end .
      180   on alt-shift-f2 anywhere do:
      181     run proc-alt-shift-f2.
      182   end.
      183   on alt-shift-f3 anywhere do:
      184     run proc-alt-shift-f3 in this-procedure .
      185   end.
      186   on alt-shift-f4 anywhere do:
      187     run proc-alt-shift-f4 in this-procedure.
      188   end.
      189   on alt-f1 anywhere do:
      190     run proc-alt-f1 in this-procedure .
      191   end.
      192   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193     define variable v-cntxt-db-num        as integer   no-undo .
      194     define variable v-cntxt-userid        as character no-undo .
      195     define variable v-cntxt-level         as character no-undo .
      196     define variable v-cntxt-host-code-obj as integer   no-undo .
      197     define variable v-cntxt-obj-type      as character no-undo .
      198     define variable v-cntxt-obj-code      as integer   no-undo .
      199     define variable v-cntxt-db-num-obj    as integer   no-undo .
      200     define variable v-cntxt-is-admin      as logical   no-undo .
      201   define temp-table tt-alc-type no-undo like ub.alc-type.
      202   define stream in-stream.
      203   DEFINE STREAM log-stream.
      204   define buffer buf_alc-type      for ub.alc-type.
      205   define buffer buf_tt-alc-type   for tt-alc-type.
      206   define buffer buf_alc-type-gds  for ub.alc-type-gds.
      207   define variable v-log             as logical   no-undo .
      208   define variable v-repfrm-str      as character no-undo .
      209   define variable v-filename        as character no-undo .
      210   define variable v-alc-type-code   as character no-undo .
      211   define variable v-alc-type-name   as character no-undo .
      212   define variable v-sea-sort        as character no-undo .
      213   define variable v-str             as character no-undo .
      214   define variable v-error           as character no-undo .
      215   define variable v-alc-type-status as integer   no-undo .
      216   define variable v-counter         as integer   no-undo .
      217   define variable v-file-str-num    as integer   no-undo .
      218   define variable v-i               as integer   no-undo .
      219   define variable v-num             as integer   no-undo .
      220   PROCEDURE write-log:
      221      define input parameter p-log-message as character no-undo.
      222      define input parameter p-error       as logical no-undo.
      223      define input parameter p-message     as logical no-undo.
      224      if p-message then do:
      225         MESSAGE p-log-message
      226         VIEW-AS ALERT-BOX INFORMATION .
      227      end.
      228      EXPORT STREAM log-stream DELIMITER "~t"
      229            TODAY
      230            TIME
      231            g#userid
      232            g#db-num
      233            p-log-message
      234      .
      235      if p-error then DO:
      236         OUTPUT STREAM log-stream CLOSE.
      237         return error p-log-message.
      238      end.
      239   end procedure.
      240   do
      241   on error  undo, return error return-value
      242   on endkey undo, return error return-value
      243   on stop   undo, return error return-value
      244     :
      245   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      246     run mainmenu_getcntxt in parparentproc
      247       (output v-cntxt-db-num
      248       ,output v-cntxt-userid
      249       ,output v-cntxt-level
      250       ,output v-cntxt-host-code-obj
      251       ,output v-cntxt-obj-type
      252       ,output v-cntxt-obj-code
      253       ,output v-cntxt-db-num-obj
      254       ,output v-cntxt-is-admin
      255       ) .
      256     OUTPUT STREAM log-stream TO VALUE( "alctype-log.ref":U ) CONVERT SOURCE "1251" APPEND.
      257         run write-log in this-procedure
      258               ( input "Начат импорт справочника видов алкоголя"
      259               , input no
      260               , input no
      261               ) .
      262        .
      263     message
      264       "Импорт справочника видов алкогольной продукции." skip
      265       "Начать импорт?"
      266     view-as alert-box question
      267     buttons yes-no update v-log.
      268     IF v-log <> YES THEN DO:
      269        run write-log in this-procedure
      270               ( input "отказ от импорта справочника"
      271               , input yes
      272               , input yes
      273               ) .
      274     END.
      275     ASSIGN
      276       v-filename     = SEARCH ("cmp/alctype.ref":U)
      277       v-counter      = 0
      278       v-file-str-num = 0
      279       v-repfrm-str   = "Чтение файла...":U
      280     .
      281     if v-filename = ? then do :
      282        run write-log in this-procedure
      283               ( input substitute( "Не найден файл &1.", "cmp/alctype.ref":U )
      284               , input yes
      285               , input yes
      286               ) .
      287     END.
      288     EMPTY TEMP-TABLE tt-alc-type.
      289     INPUT STREAM in-stream FROM VALUE( v-filename ) CONVERT SOURCE "1251".
      290         run write-log in this-procedure
      291               ( input substitute("открыт файл &1", v-filename)
      292               , input no
      293               , input no
      294               ) .
      295   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
      296     if  log-manager:logfile-name ne ?
      297     then DO:
      298         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      299     end.
      300     if not session:batch-mode then
      301     do:
      302       VIEW FRAME InfoFrame.
      303       mFrameView = true.
      304     end.
      305      v-button-stop = false .
      306         if mFrameView
      307         then do:
      308         if v-button-stop then view STOPBTN in frame InfoFrame.
      309                          else Hide STOPBTN in frame InfoFrame.
      310         end.
      311     REPEAT
      312     :
      313       ASSIGN
      314         v-str           = ""
      315         v-alc-type-code = ""
      316         v-alc-type-name = ""
      317         v-sea-sort      = ""
      318         v-alc-type-status      = 0
      319         v-num           = 0
      320       .
      321       IMPORT STREAM in-stream UNFORMATTED v-str NO-ERROR .
      322       IF ERROR-STATUS :ERROR THEN DO:
      323         INPUT  STREAM in-stream  CLOSE.
      324         run write-log in this-procedure
      325               ( input SUBSTITUTE( "Ошибка при импорте данных из файла &1."
      326                                 , "cmp/alctype.ref":U )
      327               , input yes
      328               , input yes
      329               ) .
      330       END.
      331       ASSIGN
      332         v-num          = NUM-ENTRIES( v-str , ";":U )
      333         v-file-str-num = v-file-str-num + 1
      334       .
      335       if v-num <> 4 then do:
      336         INPUT  STREAM in-stream  CLOSE.
      337         run write-log in this-procedure
      338               ( input SUBSTITUTE( "В файле &1 неверный формат строки &2."
      339                                , "cmp/alctype.ref":U
      340                                , v-file-str-num
      341                                )
      342               , input yes
      343               , input yes
      344               ) .
      345       END.
      346       ASSIGN
      347          v-alc-type-code = ENTRY( 1 , v-str , ";":U )
      348          v-alc-type-name = ENTRY( 2 , v-str , ";":U )
      349          v-sea-sort      = STRING( INTEGER( ENTRY( 3 , v-str , ";":U ) ) , "9999" )
      350          v-alc-type-status      = INTEGER( entry( 4 , v-str , ";":U ) )
      351          NO-ERROR
      352       .
      353       IF ERROR-STATUS :ERROR THEN DO :
      354         INPUT  STREAM in-stream  CLOSE.
      355         run write-log in this-procedure
      356               ( input SUBSTITUTE( "Ошибка при импорте данных из файла &1 в строке &2.&3&4"
      357                                , "cmp/alctype.ref":U
      358                                , v-file-str-num)
      359               , input yes
      360               , input yes
      361               ) .
      362       END.
      363       IF CAN-FIND( FIRST buf_tt-alc-type WHERE buf_tt-alc-type.alc-type-code = v-alc-type-code
      364                                          NO-LOCK)
      365       THEN DO:
      366         INPUT  STREAM in-stream  CLOSE.
      367         run write-log in this-procedure
      368               ( input SUBSTITUTE( "В файле &1 присутствует более одного вида алкогольной продукции с кодом: &2."
      369                                 , "cmp/alctype.ref":U
      370                                 , v-alc-type-code
      371                                 )
      372               , input yes
      373               , input yes
      374               ) .
      375       END.
      376       CREATE tt-alc-type.
      377       ASSIGN
      378         v-counter                   = v-counter + 1
      379         tt-alc-type.alc-type-code   = v-alc-type-code
      380         tt-alc-type.alc-type-name   = v-alc-type-name
      381         tt-alc-type.alc-type-status = v-alc-type-status
      382       .
      383         run write-log in this-procedure
      384               ( input substitute("Импортирован &1, &2", v-alc-type-code, v-alc-type-code)
      385               , input no
      386               , input no
      387               ) .
      388        .
      389   IF ( v-counter modulo v-account = 0 )  then DO:
      390    Assign
      391       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
      392       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
      393       .
      394             if  log-manager:logfile-name ne ?
      395             then DO:
      396                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      397             end.
      398              if mFrameView
      399              then do:
      400               DISPLAY
      401                 v-counter @ RecordsDone
      402                 RecordsString   @ RecordsString
      403                 WITH FRAME InfoFrame.
      404              end.
      405   End.
      406      if v-button-stop then  DO:
      407            if mFrameView
      408            then
      409               PROCESS EVENTS.
      410            IF StopProcessing THEN DO:
      411            RETURN error.
      412            End.
      413      end.
      414     END.
      415     INPUT STREAM in-stream CLOSE.
      416   if mFrameView
      417   then do:
      418      HIDE FRAME InfoFrame.
      419   end.
      420      run write-log in this-procedure
      421            ( input "Достигнут конец файла"
      422            , input no
      423            , input no
      424            ) .
      425     FOR EACH buf_alc-type
      426                           EXCLUSIVE-LOCK
      427                           :
      428         IF NOT CAN-FIND( FIRST tt-alc-type
      429                          WHERE tt-alc-type.alc-type-code = buf_alc-type.alc-type-code
      430                          NO-LOCK )
      431         THEN DO:
      432            if can-find ( first buf_alc-type-gds
      433                          where buf_alc-type-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
      434                          no-lock
      435                        ) then do:
      436               ASSIGN
      437                  buf_alc-type.alc-type-status = 1
      438               .
      439               run write-log in this-procedure
      440                  ( input SUBSTITUTE("В файле &1 отсутствовал вид алкогольной продукции с кодом: &2. Ему изменен статус с 0 на 1. Не забудьте открепить товары."
      441                        , "cmp/alctype.ref":U
      442                        , buf_alc-type.alc-type-code
      443                        )
      444                  , input no
      445                  , input yes
      446                  ) .
      447            end.
      448            else DO:
      449               delete buf_alc-type.
      450            end.
      451         END.
      452     END.
      453     ASSIGN
      454       v-counter     = 0
      455       v-repfrm-str  = "Загрузка видов алкогольной продукции...":U
      456     .
      457     FOR EACH tt-alc-type NO-LOCK :
      458         ASSIGN
      459           v-counter = v-counter + 1
      460         .
      461         FIND FIRST buf_alc-type WHERE buf_alc-type.alc-type-code = tt-alc-type.alc-type-code
      462                                 NO-LOCK
      463                                 NO-ERROR
      464                                 .
      465         IF AVAILABLE buf_alc-type THEN DO:
      466           FIND CURRENT buf_alc-type EXCLUSIVE-LOCK NO-WAIT.
      467           IF LOCKED buf_alc-type THEN DO :
      468            run write-log in this-procedure
      469               ( input SUBSTITUTE ( "Запись вида алкогольной продукции <&1. &2> редактируется.&3Изменение записи невозможно."
      470                          , tt-alc-type.alc-type-code
      471                          , tt-alc-type.alc-type-name
      472                          , chr(10)
      473                          )
      474               , input yes
      475               , input yes
      476               ) .
      477           END.
      478           ELSE DO :
      479             IF tt-alc-type.alc-type-status <> 0 THEN DO:
      480                FIND FIRST buf_alc-type-gds WHERE buf_alc-type-gds.alc-type-inner-code = tt-alc-type.alc-type-inner-code
      481                                              AND buf_alc-type-gds.alc-type-inner-code = tt-alc-type.alc-type-inner-code
      482                                            NO-LOCK
      483                                            NO-ERROR
      484                                            .
      485                IF AVAILABLE buf_alc-type-gds THEN do:
      486                  run write-log in this-procedure
      487                     ( input SUBSTITUTE( "К виду алкогольной продукции <&1. &2> есть привязаные товары.&3Удаление вида невозможно."
      488                                    , tt-alc-type.alc-type-code
      489                                    , tt-alc-type.alc-type-name
      490                                    , chr(10)
      491                                    )
      492                     , input no
      493                     , input yes
      494                     ) .
      495                END.
      496                ELSE DO :
      497                  DELETE buf_alc-type.
      498                END.
      499             END.
      500             ELSE DO:
      501               ASSIGN
      502                 buf_alc-type.alc-type-name = tt-alc-type.alc-type-name
      503               .
      504             END.
      505           END.
      506         END.
      507         ELSE DO:
      508           IF tt-alc-type.alc-type-status = 0 THEN DO:
      509             v-num = next-value ( s-alc-type , ub).
      510             CREATE buf_alc-type.
      511             ASSIGN
      512                buf_alc-type.alc-type-inner-code = v-num
      513                buf_alc-type.create-user-db-num  = v-cntxt-db-num
      514                buf_alc-type.alc-type-code       = tt-alc-type.alc-type-code
      515                buf_alc-type.alc-type-name       = tt-alc-type.alc-type-name
      516                buf_alc-type.alc-type-status     = tt-alc-type.alc-type-status
      517                buf_alc-type.create-user         = ''
      518                buf_alc-type.create-date         = TODAY
      519                buf_alc-type.create-time         = TIME
      520                buf_alc-type.corr-user-name      = ''
      521                buf_alc-type.corr-date           = TODAY
      522                buf_alc-type.corr-time           = TIME
      523             .
      524           END.
      525         END.
      526   IF ( v-counter modulo v-account = 0 )  then DO:
      527    Assign
      528       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
      529       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
      530       .
      531             if  log-manager:logfile-name ne ?
      532             then DO:
      533                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      534             end.
      535              if mFrameView
      536              then do:
      537               DISPLAY
      538                 v-counter @ RecordsDone
      539                 RecordsString   @ RecordsString
      540                 WITH FRAME InfoFrame.
      541              end.
      542   End.
      543      if v-button-stop then  DO:
      544            if mFrameView
      545            then
      546               PROCESS EVENTS.
      547            IF StopProcessing THEN DO:
      548            RETURN error.
      549            End.
      550      end.
      551     END.
      552   if mFrameView
      553   then do:
      554      HIDE FRAME InfoFrame.
      555   end.
      556     EMPTY TEMP-TABLE tt-alc-type.
      557     run write-log in this-procedure
      558         ( input "Импорт справочника завершен!"
      559         , input NO
      560         , input yes
      561         ) .
      562     OUTPUT STREAM log-stream CLOSE.
      563   END.
