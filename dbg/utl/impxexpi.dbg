     6206                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) +  " ошибка при сохранении записи ГРУППЫ ПРАВ (action-role):"                                             + STRING(temp-action-role.db-num)                                             + STRING(temp-action-role.action-head-code)                                             + STRING(temp-action-role.action-role-code)                                             ) )) .                NEXT _action-role.
