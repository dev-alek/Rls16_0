     7032                                 buf_user-host.host-code = buf_user-obj.host-code
     7033                              .
     7034                           end.
     7035                        end.
     7036                  end.
     7037                  end.
     7038               end.
     7039            end.
     7040                              _temp-grpa:
     7041            for each temp-grpa no-lock
     7042            on error undo, return error return-value
     7043            :
     7044               FIND FIRST buf_action-role
     7045                    WHERE buf_action-role.db-num              = g#db-num
     7046                      and buf_action-role.action-head-code    = 0
     7047                      and buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     7048                    no-lock
     7049                    no-error
     7050                    .
     7051               IF NOT AVAILABLE buf_action-role then do:
     7052                  next _temp-grpa.
     7053               end.
     7054               assign
     7055                  v-object-action-role-code = 0
     7056                  v-global-action-role-code = 0
     7057                  v-firm-action-role-code   = 0
     7058               .
     7059               case buf_action-role.action-role-context:
     7060                  when 'object':U then do:
     7061                     assign
     7062                        v-object-action-role-code = buf_action-role.action-role-code
     7063                     .
     7064                  end.
     7065                  when 'firm':U then do:
     7066                     assign
     7067                        v-firm-action-role-code = buf_action-role.action-role-code
     7068                     .
