     6729               assign
     6730                  buf_user-account.user-id               = v-user-id
     6731                  buf_user-account.nik                   = v-user-id
     6732                  buf_user-account.status_               = 0
     6733                  buf_user-account.first-name            = '':U
     6734                  buf_user-account.second-name           = '':U
     6735                  buf_user-account.last-name             = v-last-name
     6736                  buf_user-account.company               = '':U
     6737                  buf_user-account.department            = '':U
     6738                  buf_user-account.e-mail                = '':U
     6739                  buf_user-account.internal-phone-number = '':U
     6740                  buf_user-account.mobile-phone-number   = '':U
     6741                  buf_user-account.phone-number          = '':U
     6742                  buf_user-account.position              = '':U
     6743                  buf_user-account.PS                    = '':U
     6744                  buf_user-account.room                  = '':U
     6745                  buf_user-account.parent-user-id        = '':U
     6746                  buf_user-account.check-parent          = false
     6747               .
     6748               assign
     6749                  v-cntxt-menu-group-id        = '':U
     6750                  v-cntxt-level                = 'global':U
     6751                  v-cntxt-host-code-obj        = ?
     6752                  v-cntxt-obj-type             = '':U
     6753                  v-cntxt-obj-code             = ?
     6754               .
     6755               assign
     6756                  v-arm-code-lookup-index = lookup(temp-userconf.ARM, v-arm-code-list)
     6757               .
     6758               if v-arm-code-lookup-index > 0
     6759               then do:
