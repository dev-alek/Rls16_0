     5955         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     5956               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) +  " ошибка при сохранении записи ПИСТОЛЕТ(nozzle):" +                                       " номер " + string(temp-nozzle.nozzle-code) +                                       er-mes) )) .                NEXT _nozzlev.
     5957       end.
     5958     end.
     5959         _nozzlev:
     5960     for each temp-pump-nozzle:
     5961       FIND FIRST ub.nozzle No-LOCK WHERE
     5962                  ub.nozzle.obj-type = temp-pump-nozzle.obj-type  AND
     5963                  ub.nozzle.obj-code = temp-pump-nozzle.obj-code  AND
     5964                  ub.nozzle.nozzle-code = temp-pump-nozzle.nozzle-code
     5965                  NO-ERROR.
     5966       IF not AVAILABLE ub.nozzle then do:
     5967                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + " Не найден ПИСТОЛЕТ для ПРИВЯЗКИ ТРК К ПИСТОЛЕТУ(pump-nozzle):" +                          " пистолет" + string(temp-pump-nozzle.nozzle-code) + " код ТРК " + string(temp-pump-nozzle.pump-code )) )) .              delete temp-pump-nozzle.                   NEXT _nozzlev.
     5968       end.
     5969       FIND FIRST ub.pump No-LOCK WHERE
     5970                  ub.pump.obj-type = temp-pump-nozzle.obj-type  AND
     5971                  ub.pump.obj-code = temp-pump-nozzle.obj-code  AND
     5972                  ub.pump.pump-code = temp-pump-nozzle.pump-code
     5973                  NO-ERROR.
     5974       IF not AVAILABLE ub.pump then do:
     5975                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + " Не найдено ТРК для ПРИВЯЗКИ ТРК к ПИСТОЛЕТУ(pump-nozzle):" +                          " код пистолета " + string(temp-pump-nozzle.nozzle-code)  + " код ТРК " + string(temp-pump-nozzle.pump-code )) )) .              delete temp-pump-nozzle.                   NEXT _nozzlev.
     5976       end.
     5977       FIND FIRST ub.pump-nozzle share-LOCK WHERE
     5978                  ub.pump-nozzle.obj-type = temp-pump-nozzle.obj-type  AND
     5979                  ub.pump-nozzle.obj-code = temp-pump-nozzle.obj-code  AND
     5980                  ub.pump-nozzle.nozzle-code = temp-pump-nozzle.nozzle-code AND
     5981                  ub.pump-nozzle.pump-code = temp-pump-nozzle.pump-code
     5982                  NO-ERROR.
     5983       IF not AVAILABLE ub.pump-nozzle then do:
     5984         create ub.pump-nozzle.
     5985       end.
     5986       buffer-copy  temp-pump-nozzle to ub.pump-nozzle.
     5987       release ub.pump-nozzle no-error.
     5988       if error-status:error then do:
     5989         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     5990               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) +  " ошибка при сохранении записи СВЯЗКИ ТРК-ПИСТОЛЕТ(pump-nozzle):" +                                       " ПИСТОЛЕТ " + string(temp-pump-nozzle.nozzle-code) +                                       " ТРК " + string(temp-pump-nozzle.pump-code) +                                       er-mes) )) .                NEXT _nozzlev.
     5991       end.
     5992     end.
     5993         _pl-gdsv:
     5994     for each temp-pl-gds:
     5995       find first ub.goods no-lock where
     5996                 ub.goods.gds-code = temp-pl-gds.gds-code no-error.
     5997       if not avail ub.goods then do:
     5998                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + " Нет товара для товара на скл.месте(pl-gds):" +                          " код товара " + string(temp-pl-gds.gds-code)  + " код скл.места " + string(temp-pl-gds.pl-code) ) )) .              delete temp-pl-gds.                   NEXT _pl-gdsv.
     5999       end.
     6000       FIND FIRST ub.place No-LOCK WHERE
     6001                  ub.place.obj-type = temp-pl-gds.obj-type  AND
     6002                  ub.place.obj-code = temp-pl-gds.obj-code  AND
     6003                  ub.place.pl-code = temp-pl-gds.pl-code
     6004                  NO-ERROR.
     6005       IF not AVAILABLE ub.place then do:
     6006                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + " Не найдено СКЛ.МЕСТО для ПРИВЯЗКИ ТОВАРА К СКЛ.МЕСТУ(pl-gds):" +                          " код товара " + string(temp-pl-gds.gds-code)  + " код скл.места " + string(temp-pl-gds.pl-code) ) )) .              delete temp-pl-gds.                   NEXT _pl-gdsv.
     6007       end.
     6008       FIND FIRST ub.pl-gds No-LOCK WHERE
     6009                  ub.pl-gds.obj-type = temp-pl-gds.obj-type  AND
     6010                  ub.pl-gds.obj-code = temp-pl-gds.obj-code  AND
     6011                  ub.pl-gds.gds-code = temp-pl-gds.gds-code  AND
     6012                  ub.pl-gds.pl-code = temp-pl-gds.pl-code
     6013                  NO-ERROR.
     6014       IF AVAILABLE ub.pl-gds then do:
     6015                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + " Уже есть ПРИВЯЗКА ЭТОГО ТОВАРА К ЭТОМУ СКЛ.МЕСТУ(pl-gds):" +                          " код товара " + string(temp-pl-gds.gds-code)  + " код скл.места " + string(temp-pl-gds.pl-code) ) )) .              delete temp-pl-gds.                   NEXT _pl-gdsv.
     6016       end.
     6017       define variable individ as logical no-undo .
     6018       define variable glog as logical no-undo .
     6019       define buffer buf_units for ub.units.
     6020       define buffer buf_pl-gds for ub.pl-gds.
     6021       FIND FIRST buf_units No-LOCK where
     6022                 buf_units.unit-name = ub.goods.unit-base No-ERROR.
     6023       if not avail buf_units then NEXT.
     6024       if LOOKUP('топ':U, buf_units.type) > 0  and lookup('дро':U, buf_units.type) > 0
     6025       then
     6026       assign
     6027       individ = yes.
     6028       else
     6029       assign
     6030       individ = no.
     6031       do transaction on error undo, next :
     6032         find first buf_pl-gds no-lock
     6033               where buf_pl-gds.obj-type = temp-pl-gds.obj-type
     6034                 and buf_pl-gds.obj-code = temp-pl-gds.obj-code
     6035                 and buf_pl-gds.pl-code  = temp-pl-gds.pl-code
     6036                 and buf_pl-gds.gds-code = temp-pl-gds.pl-code no-error.
     6037         if not available buf_pl-gds then do:
     6038           if lookup('топ':U, buf_units.type) > 0
     6039           and lookup('дро':U, buf_units.type) > 0 then do:
     6040             run trg/plgdpmvc.p (
     6041                              input  temp-pl-gds.obj-type
     6042                             ,input  temp-pl-gds.obj-code
     6043                             ,input  temp-pl-gds.pl-code
     6044                             ,input  temp-pl-gds.gds-code
     6045                             ,output glog) no-error.
     6046             if error-status:error
     6047             or not glog
     6048             then do:
     6049                           run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + "Ошибка при привязке товара к резервуару(pl-gds):" +                              " код товара " + string(temp-pl-gds.gds-code)  + " код скл.места " + string(temp-pl-gds.pl-code) +                             error-status:get-message(1) + chr(10) + return-value ) )) .              delete temp-pl-gds.                   NEXT _pl-gdsv.
     6050             end.
     6051           END.
     6052           else do:
     6053             run trg/plgdpmv0.p (
     6054                              input temp-pl-gds.obj-type
     6055                             ,input temp-pl-gds.obj-code
     6056                             ,input temp-pl-gds.pl-code
     6057                             ,input temp-pl-gds.gds-code
     6058                             ,output glog) no-error.
     6059             if error-status:error
     6060             or not glog
     6061             then do:
     6062                           run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + "Ошибка при привязке товара к резервуару(pl-gds):" +                              " код товара " + string(temp-pl-gds.gds-code)  + " код скл.места " + string(temp-pl-gds.pl-code) +                             error-status:get-message(1) + chr(10) + return-value ) )) .              delete temp-pl-gds.                   NEXT _pl-gdsv.
     6063             end.
     6064           end.
     6065         end.
     6066       end.
     6067     end.
