     6658         create alias restseq    for database value( ldbname( "ub":U ) ) .
     6659         create alias restseqflt for database value( ldbname( "ubflt":U ) ) .
     6660         run adm/restseq.p
     6661           ( input "rest":U
     6662           , input "s-user-login-action-role":U
     6663           , input no
     6664           ) no-error .
     6665         if error-status :error then do:
     6666           delete alias restseqflt.
     6667           delete alias restseq.
     6668           return error return-value .
     6669         end.
     6670         delete alias restseqflt.
     6671         delete alias restseq.
     6672         end.
     6673         otherwise do:
     6674            if "rus" = "rus":U
     6675            then do:
     6676               assign
     6677                  v-arm-code-list = 'офи':U
     6678                  + chr(44) + 'скл':U
     6679                  + chr(44) + 'маг':U
     6680                  + chr(44) + 'рес':U
     6681                  + chr(44) + 'фин':U
     6682                  + chr(44) + 'бгх':U
     6683                  + chr(44) + 'адм':U
     6684                  v-obj-name      = 'объ':U
     6685                  .
     6686            end.
     6687            else do:
     6688               assign
     6689                  v-arm-code-list = 'off':U
     6690                  + chr(44) + 'str':U
     6691                  + chr(44) + 'shp':U
     6692                  + chr(44) + 'res':U
     6693                  + chr(44) + 'fin':U
     6694                  + chr(44) + 'eac':U
     6695                  + chr(44) + 'adm':U
     6696                  v-obj-name      = 'object':U
     6697               .
     6698            end.
     6699            assign
     6700               v-menu-group-id-list = 'off,str,shp,res,fin,bge,adm':U
     6701            .
     6702                              _userconf:
     6703            FOR EACH temp-userconf:
     6704               find first buf__user
     6705                  where buf__user._userid = temp-userconf.user-name
     6706                  no-error .
     6707               if available buf__user
     6708               then do:
     6709                  assign
     6710                  v-user-login            = buf__user._userid
     6711                  v-last-name             = buf__user._user-name
     6712                  v-user-password-encoded = buf__user._password
     6713                  .
     6714               end.
     6715               else do:
     6716                  assign
     6717                  v-user-login            = temp-userconf.userid_
     6718                  v-last-name             = temp-userconf.user-name_
     6719                  v-user-password-encoded = temp-userconf.password_
     6720                  .
     6721               end.
     6722               assign
     6723                  v-user-id = substitute('&1-&2':U
     6724                                       ,g#db-num
     6725                                       ,dynamic-next-value("s-user-id":U, "ub":U)
     6726                                       )
     6727               .
