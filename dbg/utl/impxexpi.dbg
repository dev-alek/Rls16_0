     6591                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении фирмы ПОЛЬЗОВАТЕЛЯ(user-host): "                                             + temp-user-host.user-id                                             + "БД:" + string(temp-user-host.db-num) + " "                                             + STRING(temp-user-host.host-code)                                                   + " " + er-mes) )) .                NEXT _user-host.
     6592               end.
