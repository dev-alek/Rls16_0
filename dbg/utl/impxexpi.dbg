     3293   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3294   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3295   procedure gen-key-rec :
     3296     define input  parameter p-tbl-name    as character no-undo.
     3297     define input  parameter p-bh_tbl-name as handle    no-undo.
     3298     define output parameter p-key-rec     as character no-undo.
     3299     do
     3300     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3301     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     3302     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     3303     :
     3304       define variable fh               as handle    no-undo .
     3305       define variable v-ok             as logical   no-undo .
     3306       define variable v-inform         as character no-undo .
     3307       define variable v-ind            as integer   no-undo .
     3308       define variable v-idx-field-qnty as integer   no-undo .
     3309       if p-tbl-name = ?
     3310         or p-tbl-name = "":U
     3311       then do:
     3312         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info14 ).
     3313       end.
     3314       if not p-bh_tbl-name:available then do:
     3315         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info14, p-tbl-name ).
     3316       end.
     3317       assign
     3318         p-key-rec = p-tbl-name
     3319         v-inform  = p-bh_tbl-name:index-information(1)
     3320         v-ind     = 2
     3321       .
     3322       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3323       on error undo, return error
     3324       :
     3325         assign
     3326           v-inform = p-bh_tbl-name:index-information( v-ind )
     3327           v-ind    = v-ind + 1
     3328         .
     3329       end.
     3330       if v-inform = ?
     3331         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3332         or entry( 3, v-inform, ",":U ) <> "1":U
     3333       then do:
     3334         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, p-tbl-name ).
     3335       end.
     3336       else do:
     3337         assign
     3338           v-idx-field-qnty = num-entries( v-inform ) - 4
     3339         .
     3340         if v-idx-field-qnty < 2 then do:
     3341           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, p-tbl-name ).
     3342         end.
     3343         do v-ind = 1 to v-idx-field-qnty by 2
     3344         on error undo, return error
     3345         :
     3346           assign
     3347             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     3348             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     3349           .
     3350         end.
     3351       end.
     3352       if p-key-rec = ? then do:
     3353         assign
     3354           p-key-rec = "":U
     3355         .
     3356         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info14, p-tbl-name ).
     3357       end.
     3358     end.
     3359     return.
     3360   end procedure.
     3361   procedure gen-where-keyr-tab :
     3362     define input  parameter i-tableSerach as character no-undo.
     3363     define input  parameter i-tablekey   as character  no-undo.
     3364     define input  parameter p-key-rec    as character  no-undo.
     3365     define input  parameter p-key-handle as handle     no-undo .
     3366     define input  parameter p-db-name    as character  no-undo .
     3367     define input  parameter p-tt-handle  as handle     no-undo .
     3368     define output parameter o-Where      as character  no-undo.
     3369     do
     3370     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3371     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3372     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     3373     :
     3374       define variable v-full-tbl-name  as character no-undo .
     3375       define variable bh_tbl-name      as handle    no-undo .
     3376       define variable fh_key           as handle    no-undo .
     3377       define variable fh_search        as handle    no-undo .
     3378       define variable v-field-num      as integer   no-undo .
     3379       define variable v-count-fld      as integer   no-undo .
     3380       define variable v-inform         as character no-undo .
     3381       define variable v-ind            as integer   no-undo .
     3382       define variable v-idx-field-qnty as integer   no-undo .
     3383       define variable v-field-name     as character no-undo .
     3384       define variable v-field-val      as character no-undo .
     3385       define variable v-word-link      as character no-undo .
     3386       define variable vTable           as character no-undo.
     3387       define variable bh_tbl-key       as handle    no-undo .
     3388       assign
     3389         p-key-rec = trim( p-key-rec )
     3390       .
     3391       if p-key-handle <> ? then do:
     3392         if not valid-handle(p-key-handle)
     3393            or p-key-handle:type <> "buffer"
     3394         then do:
     3395           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info14 ).
     3396         end.
     3397         if num-entries( p-key-rec, chr(3) ) > 1
     3398           or p-key-rec = ?
     3399           or p-key-rec = "":U
     3400         then do:
     3401           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info14, p-key-rec ).
     3402         end.
     3403       end.
     3404       else do:
     3405         if p-key-rec = ?
     3406           or p-key-rec = "":U
     3407         then do:
     3408           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     3409         end.
     3410       end.
     3411       assign
     3412         vTable = entry( 1 , p-key-rec, chr(3) )
     3413       .
     3414       if p-tt-handle <> ?
     3415         and ( not valid-handle(p-tt-handle)
     3416               or p-tt-handle:type <> "buffer"
     3417             )
     3418       then do:
     3419         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info14, vTable, chr(10) ).
     3420       end.
     3421       if p-tt-handle = ? then do:
     3422         assign
     3423           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     3424         .
     3425         create buffer bh_tbl-name for table v-full-tbl-name .
     3426       end.
     3427       else do:
     3428         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3429       end.
     3430       assign
     3431         v-inform = bh_tbl-name:index-information(1)
     3432         v-ind    = 2
     3433       .
     3434       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3435       on error undo, return error
     3436       :
     3437         assign
     3438           v-inform = bh_tbl-name:index-information( v-ind )
     3439           v-ind    = v-ind + 1
     3440         .
     3441       end.
     3442       if v-inform = ?
     3443         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3444         or entry( 3, v-inform, ",":U ) <> "1":U
     3445       then do:
     3446         delete object bh_tbl-name no-error.
     3447         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info14, vTable ).
     3448       end.
     3449       assign
     3450         v-idx-field-qnty = num-entries( v-inform ) - 4
     3451       .
     3452       if v-idx-field-qnty < 2 then do:
     3453         delete object bh_tbl-name no-error.
     3454         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, vTable ).
     3455       end.
     3456       assign
     3457         o-where     = "where":U
     3458         v-word-link = "":U
     3459         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3460         v-count-fld = 0
     3461       .
     3462       if i-tablekey ne "" and i-tablekey ne ?
     3463       then do:
     3464         assign
     3465           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3466         .
     3467         create buffer bh_tbl-key for table v-full-tbl-name .
     3468       end.
     3469       if i-tableSerach ne "" and i-tableSerach ne ?
     3470       then do:
     3471         delete object bh_tbl-name no-error.
     3472         assign
     3473           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3474         .
     3475         create buffer bh_tbl-name for table v-full-tbl-name .
     3476       end.
     3477       block_where:
     3478       do v-ind = 1 to v-idx-field-qnty by 2
     3479       on error undo, return error
     3480       :
     3481         assign
     3482           v-count-fld = v-count-fld + 1
     3483         .
     3484         if p-key-handle = ?
     3485           and v-count-fld > v-field-num
     3486         then do:
     3487           leave block_where.
     3488         end.
     3489         define variable VfieldKeyTable as handle no-undo.
     3490         assign
     3491           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3492           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3493         .
     3494         if     bh_tbl-key ne ?
     3495         then do:
     3496            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3497            if VfieldKeyTable eq ?
     3498            then next block_where.
     3499         end.
     3500         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3501         then
     3502            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3503         else
     3504            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3505         if p-key-handle = ? then do:
     3506           assign
     3507             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3508           .
     3509         end.
     3510         else do:
     3511           assign
     3512             fh_key = p-key-handle:buffer-field( v-field-name )
     3513           .
     3514           if fh_key = ?
     3515             or not valid-handle( fh_key )
     3516           then do:
     3517             delete object bh_tbl-name.
     3518             if     bh_tbl-key ne ?
     3519             then
     3520                delete object bh_tbl-key.
     3521             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info14, p-key-handle:name, v-field-name ).
     3522           end.
     3523           assign
     3524             v-field-val = fh_key:buffer-value
     3525           .
     3526         end.
     3527         if fh_search:data-type ="character":U then do:
     3528           assign
     3529             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3530             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3531             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3532             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3533             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3534             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3535             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3536             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3537             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3538             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3539             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3540             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3541             v-field-val = substitute( '"&1"', v-field-val )
     3542           .
     3543         end.
     3544         assign
     3545           o-where = substitute( "&1 &2", o-where, v-field-val )
     3546         .
     3547         if v-word-link = "":U then do:
     3548           assign
     3549             v-word-link = "and":U
     3550           .
     3551         end.
     3552       end.
     3553       delete object bh_tbl-name.
     3554       if     bh_tbl-key ne ?
     3555       then
     3556          delete object bh_tbl-key.
     3557       if p-key-handle = ?
     3558         and v-count-fld <> v-field-num
     3559       then do:
     3560         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info14, vTable ).
     3561       end.
     3562     end.
     3563   end procedure.
     3564   procedure gen-hn-keyr-tab :
     3565     define input  parameter i-tableSerach as character no-undo.
     3566     define input  parameter i-tablekey   as character no-undo.
     3567     define input  parameter p-key-rec    as character no-undo.
     3568     define input  parameter p-key-handle as handle    no-undo .
     3569     define input  parameter p-db-name    as character no-undo .
     3570     define input  parameter p-tt-handle  as handle    no-undo .
     3571     define input  parameter p-stts-lock  as integer   no-undo .
     3572     define output parameter o-hn         as handle    no-undo.
     3573     define variable v-full-tbl-name as character no-undo.
     3574     define variable v-where         as character no-undo.
     3575     define variable bh_tbl-name     as handle    no-undo.
     3576     define variable vTable          as character no-undo.
     3577     do
     3578     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3579     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3580     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3581         run gen-where-keyr-tab(i-tableSerach,
     3582                                i-tablekey,
     3583                                p-key-rec,
     3584                                p-key-handle,
     3585                                p-db-name,
     3586                                p-tt-handle,
     3587                                output v-where).
     3588         if i-tableSerach ne "" and i-tableSerach ne ?
     3589         then do:
     3590            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3591            create buffer bh_tbl-name for table v-full-tbl-name .
     3592         end.
     3593         else do:
     3594            if p-tt-handle = ? then do:
     3595               assign
     3596                  vTable = entry( 1 , p-key-rec, chr(3) )
     3597               .
     3598               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3599               create buffer bh_tbl-name for table v-full-tbl-name .
     3600            end.
     3601            else do:
     3602               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3603            end.
     3604         end.
     3605         if p-tt-handle = ? then do:
     3606            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3607         end.
     3608         else do:
     3609            bh_tbl-name:find-first( v-where ) no-error .
     3610         end.
     3611         o-hn = bh_tbl-name.
     3612      end.
     3613   end procedure.
     3614   procedure gen-hn-keyr :
     3615     define input  parameter p-key-rec    as character no-undo.
     3616     define input  parameter p-key-handle as handle    no-undo .
     3617     define input  parameter p-db-name    as character no-undo .
     3618     define input  parameter p-tt-handle  as handle    no-undo .
     3619     define input  parameter p-stts-lock  as integer   no-undo .
     3620     define output parameter o-hn         as handle    no-undo.
     3621     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3622   end.
     3623   procedure gen-row-keyr :
     3624     define input  parameter p-key-rec    as character no-undo.
     3625     define input  parameter p-key-handle as handle    no-undo .
     3626     define input  parameter p-db-name    as character no-undo .
     3627     define input  parameter p-tt-handle  as handle    no-undo .
     3628     define input  parameter p-stts-lock  as integer   no-undo .
     3629     define output parameter p-tbl-row    as rowid     no-undo.
     3630     define output parameter p-tbl-name   as character no-undo.
     3631     define variable vHn as handle no-undo.
     3632       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3633       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3634       p-tbl-name =  vHn:table.
     3635       delete object vHn no-error.
     3636     if p-tbl-row = ? then do:
     3637       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info14, p-tbl-name, p-key-rec ).
     3638     end.
     3639     else do:
     3640       return.
     3641     end.
     3642   end procedure.
     3643   procedure gen-key-fv :
     3644     define input  parameter p-key-rec    as character no-undo .
     3645     define output parameter p-field-list as character no-undo .
     3646     define output parameter p-value-list as character no-undo.
     3647     do
     3648     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3649     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3650     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3651     :
     3652       define variable v-full-tbl-name  as character no-undo .
     3653       define variable bh_tbl-name      as handle    no-undo .
     3654       define variable v-tbl-name       as character no-undo .
     3655       define variable v-field-num      as integer   no-undo .
     3656       define variable v-count-fld      as integer   no-undo .
     3657       define variable v-inform         as character no-undo .
     3658       define variable v-ind            as integer   no-undo .
     3659       define variable v-idx-field-qnty as integer   no-undo .
     3660       define variable v-delim-key      as character no-undo .
     3661       if p-key-rec = ?
     3662         or p-key-rec = "":U
     3663       then do:
     3664         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     3665       end.
     3666       assign
     3667         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3668         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3669       .
     3670       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3671       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info14 ).
     3672       assign
     3673         v-inform = bh_tbl-name:index-information(1)
     3674         v-ind    = 2
     3675       .
     3676       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3677       on error undo, return error
     3678       :
     3679         assign
     3680           v-inform = bh_tbl-name:index-information( v-ind )
     3681           v-ind    = v-ind + 1
     3682         .
     3683       end.
     3684       if v-inform = ?
     3685         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3686         or entry( 3, v-inform, ",":U ) <> "1":U
     3687       then do:
     3688         delete object bh_tbl-name no-error.
     3689         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     3690       end.
     3691       assign
     3692         v-idx-field-qnty = num-entries( v-inform ) - 4
     3693       .
     3694       if v-idx-field-qnty < 2 then do:
     3695         delete object bh_tbl-name no-error.
     3696         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     3697       end.
     3698       assign
     3699         p-field-list = "":U
     3700         p-value-list = "":U
     3701         v-delim-key  = "":U
     3702         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3703         v-count-fld  = 0
     3704       .
     3705       block_where:
     3706       do v-ind = 1 to v-idx-field-qnty by 2
     3707       on error undo, return error
     3708       :
     3709         assign
     3710           v-count-fld = v-count-fld + 1
     3711         .
     3712         if v-count-fld > v-field-num then do:
     3713           leave block_where.
     3714         end.
     3715         assign
     3716           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3717           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3718         .
     3719         if v-ind = 1 then do:
     3720           assign
     3721             v-delim-key = chr(3)
     3722           .
     3723         end.
     3724       end.
     3725       delete object bh_tbl-name.
     3726       if v-count-fld <> v-field-num then do:
     3727         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info14, v-tbl-name ).
     3728       end.
     3729     end.
     3730   end procedure.
     3731   procedure gen-key-field :
     3732     define input  parameter p-table      as character no-undo .
     3733     define output parameter p-field-list as character no-undo .
     3734     do
     3735     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3736     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3737     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3738     :
     3739       define variable v-full-tbl-name  as character no-undo .
     3740       define variable bh_tbl-name      as handle    no-undo .
     3741       define variable v-tbl-name       as character no-undo .
     3742       define variable v-field-num      as integer   no-undo .
     3743       define variable v-count-fld      as integer   no-undo .
     3744       define variable v-inform         as character no-undo .
     3745       define variable v-ind            as integer   no-undo .
     3746       define variable v-idx-field-qnty as integer   no-undo .
     3747       define variable v-delim-key      as character no-undo .
     3748       if p-table = ?
     3749         or p-table = "":U
     3750       then do:
     3751         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info14 ).
     3752       end.
     3753       assign
     3754         v-tbl-name      = p-table
     3755         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3756       .
     3757       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3758       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info14 ).
     3759       assign
     3760         v-inform = bh_tbl-name:index-information(1)
     3761         v-ind    = 2
     3762       .
     3763       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3764       on error undo, return error
     3765       :
     3766         assign
     3767           v-inform = bh_tbl-name:index-information( v-ind )
     3768           v-ind    = v-ind + 1
     3769         .
     3770       end.
     3771       if v-inform = ?
     3772         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3773         or entry( 3, v-inform, ",":U ) <> "1":U
     3774       then do:
     3775         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     3776       end.
     3777       assign
     3778         v-idx-field-qnty = num-entries( v-inform ) - 4
     3779       .
     3780       if v-idx-field-qnty < 2 then do:
     3781         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     3782       end.
     3783       assign
     3784         p-field-list = "":U
     3785         v-delim-key  = "":U
     3786         v-count-fld  = 0
     3787       .
     3788       block_where:
     3789       do v-ind = 1 to v-idx-field-qnty by 2
     3790       on error undo, return error
     3791       :
     3792         assign
     3793           v-count-fld = v-count-fld + 1
     3794         .
     3795         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3796         if v-ind = 1 then do:
     3797           assign
     3798             v-delim-key = chr(3)
     3799           .
     3800         end.
     3801       end.
     3802       delete object bh_tbl-name.
     3803     end.
     3804   end procedure.
     3805   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3806   procedure cd-attr-code :
     3807     define input  parameter p-ucode          as character no-undo .
     3808     define input  parameter p-code           as character no-undo .
     3809     define output parameter p-type           as character no-undo .
     3810     define output parameter p-format         as character no-undo .
     3811     define output parameter p-label          as character no-undo .
     3812     define output parameter p-user-can-edit  as logical   no-undo .
     3813     define output parameter p-output-display as logical   no-undo .
     3814     define output parameter p-other          as character no-undo .
     3815     define output parameter p-prop-list      as character no-undo .
     3816     do
     3817     on error undo, return error return-value
     3818     :
     3819           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-code in g#attr-lib
     3820         (input  p-ucode
