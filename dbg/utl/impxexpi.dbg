     7550                                   temp-thbj-attr.prop-code = buf-thbj-attr.prop-code AND
     7551                                   temp-thbj-attr.upper-prop-code = buf-thbj-attr.upper-prop-code AND
     7552                                   temp-thbj-attr.obj-type = buf-thbj-attr.obj-type AND
     7553                                   temp-thbj-attr.obj-code = buf-thbj-attr.obj-code
     7554                                    )
     7555                                   then do:
     7556                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПАРАМЕТРЫ O БД, СТРОКА " + string(ii) + chr(10)) + " Уже есть запись ПАРАМЕТРА(thbj-attr)" +                                   " Секция " + string(buf-thbj-attr.upper-prop-code) +                                   " параметр " + buf-thbj-attr.prop-code +                                   " тип объекта " + buf-thbj-attr.obj-type +                                   " код объекта " + string(buf-thbj-attr.obj-code) ) )) .              delete buf-thbj-attr.                   NEXT _thb.
     7557                 end.
     7558                 create temp-thbj-attr.
     7559                 buffer-copy buf-thbj-attr to temp-thbj-attr.
     7560                 delete buf-thbj-attr.
     7561               end.
     7562             end CASE.
     7563           end.
     7564           otherwise do:
     7565           end.
     7566         END CASE.
     7567       END.
     7568       input stream InStream close.
     7569     end.
     7570     end.
     7571   end procedure.
     7572   procedure p-flt-i :
     7573     do
     7574     on error undo, return error
     7575     :
     7576     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ФИЛЬТРЫ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "flt":U) )) .
     7577     run check-iefile in this-procedure(input p-dir-name,                                      input "flt":U,                                      input "import":U,                                      output loc#log).
     7578     ii = 0.
     7579     if loc#log then do:
     7580       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ФИЛЬТРЫ" ) ).
     7581       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "flt":U).
     7582       _flt:
     7583       REPEAT:
     7584         import stream Instream unformatted ss.
     7585         CASE ss:
     7586           when "filter":U then do:
     7587             current-table = ss.
     7588             case current-table:
     7589               when "filter":U then do:
     7590                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     7591                 create buf-filter.
     7592                 import stream Instream buf-Filter.Fields-sort-rus                                 buf-Filter.Fields-sort                                 buf-Filter.Flds                                 buf-Filter.Naim                                 buf-Filter.Num-flt                                 buf-Filter.Tbl                                 buf-Filter.Where-ysl-rus                                 buf-Filter.Where-ysl                                 buf-Filter.call-point                                 buf-Filter.lst-cend no-error.
     7593                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ФИЛЬТРЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _flt.                   end.
     7594                               assign
     7595                 buf-filter.where-ysl = replace(buf-filter.where-ysl, chr(1), chr(4))
     7596                 buf-filter.where-ysl-rus = replace(buf-filter.where-ysl-rus, chr(1), chr(4))
     7597                 buf-filter.fields-sort-rus = replace(buf-filter.fields-sort-rus, chr(1), chr(4))
     7598                 buf-filter.fields-sort = replace(buf-filter.fields-sort, chr(1), chr(4))
     7599                 buf-filter.call-point = replace(buf-filter.call-point, chr(1), chr(4))
     7600                 .
     7601                 IF CAN-FIND(FIRST temp-filter No-LOCK WHERE
     7602                                   temp-filter.call-point = buf-filter.call-point AND
     7603                                   temp-filter.NAIM = buf-filter.NAIM
     7604                                   )
     7605                                   then do:
     7606                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ФИЛЬТРЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ФИЛЬТР(filter):" +                                  " название " + string(buf-filter.Naim) +                                  " точка вызова " + buf-filter.call-point) )) .              delete buf-filter.                   NEXT _flt.
     7607                 end.
     7608                 create temp-filter.
     7609                 buffer-copy buf-filter to temp-filter.
     7610                 delete buf-filter.
     7611               end.
     7612             end CASE.
     7613           end.
     7614           otherwise do:
     7615           end.
     7616         END CASE.
     7617       END.
     7618       input stream InStream close.
     7619     end.
     7620     end.
     7621   end procedure.
     7622   procedure p-pbc-i :
     7623   define variable v-b-code as integer no-undo .
     7624   define variable v-rowid as rowid no-undo .
     7625   define variable v-tbl-name as character no-undo .
     7626   define buffer buf_ext-classif for ub.ext-classif.
     7627   define buffer buf_goods for ub.goods.
     7628     do
     7629     on error undo, return error
     7630     :
     7631     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "pbc":U) )) .
     7632     run check-iefile in this-procedure(input p-dir-name,                                      input "pbc":U,                                      input "import":U,                                      output loc#log).
     7633     ii = 0.
     7634     if loc#log then do:
     7635       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ" ) ).
     7636       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "pbc":U).
     7637       _pbc:
     7638       REPEAT:
     7639         import stream Instream unformatted ss.
     7640         CASE ss:
     7641           when "prod-bc":U then do:
     7642             current-table = ss.
     7643             case current-table:
     7644               when "prod-bc":U then do:
     7645                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     7646                 create buf-prod-bc.
     7647                 import stream Instream buf-prod-bc.b-code                                 buf-prod-bc.b-str                                 buf-prod-bc.bc-on
     7648                 buf-prod-bc.old-gds-code
     7649                 buf-prod-bc.unit-base
     7650                 buf-prod-bc.unit-cli
     7651                 no-error.
     7652                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pbc.                   end.
     7653                               find first buf_ext-classif no-lock where
     7654                           buf_ext-classif.classif-subject = 'goods':U
     7655                      and  buf_ext-classif.classif-name = v-classif-name
     7656                      and buf_ext-classif.key#_one = buf-prod-bc.old-gds-code no-error.
     7657                 if not available buf_ext-classif then do:
     7658                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Не найдена запись для баркода в таблице соответствия(prod-bc):" +                                  " ДопБК " + string(buf-prod-bc.b-str) +                                  " Баркод " + string(buf-prod-bc.b-code)) )) .              delete buf-prod-bc.                   NEXT _pbc.
     7659                 end.
     7660                 RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT buf_ext-classif.uniq-key-rec
     7661                                                     ,input ?
     7662                                                     ,INPUT "ub"
     7663                                                     ,INPUT ?
     7664                                                     ,INPUT NO-LOCK
     7665                                                     ,OUTPUT v-rowid
     7666                                                     ,OUTPUT v-tbl-name) no-error.
     7667                 if error-status:error then do:
     7668                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Ошибка при восстановлении баркода полученного из таблицы соответствия(prod-bc):" +                                  " ДопБК " + string(buf-prod-bc.b-str) +                                  " Баркод " + string(buf-prod-bc.b-code)) )) .              delete buf-prod-bc.                   NEXT _pbc.
     7669                 end.
     7670                 find first buf_goods no-lock where
     7671                           rowid(buf_goods) = v-rowid no-error.
     7672                 if not available buf_goods then do:
     7673                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Не найден товар, полученный из таблицы соответствия(prod-bc):" +                                  " ДопБК " + string(buf-prod-bc.b-str) +                                  " Баркод " + string(buf-prod-bc.b-code)) )) .              delete buf-prod-bc.                   NEXT _pbc.
     7674                 end.
     7675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7676     (input  buf_goods.gds-code
     7677     ,input  ?
     7678     ,output v-b-code
     7679     ) no-error .
     7680                 if error-status:error then do:
     7681                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Ошибка при определении главного баркода товара, полученный из таблицы соответствия(prod-bc):" +                                  " ДопБК " + string(buf-prod-bc.b-str) +                                  " Баркод " + string(buf-prod-bc.b-code)) )) .              delete buf-prod-bc.                   NEXT _pbc.
     7682                 end.
     7683                 IF CAN-FIND(FIRST temp-prod-bc No-LOCK WHERE
     7684                                   temp-prod-bc.b-str = buf-prod-bc.b-str
     7685                               AND temp-prod-bc.b-code = buf-prod-bc.b-code )
     7686                                   then do:
     7687                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ДопБК(prod-bc):" +                                  " ДопБК " + string(buf-prod-bc.b-str) +                                  " новый Баркод " + string(v-b-code)  +                                  " старый Баркод " + string(buf-prod-bc.b-code)) )) .              delete buf-prod-bc.                   NEXT _pbc.
     7688                 end.
     7689                 create temp-prod-bc.
     7690                 buffer-copy buf-prod-bc
     7691                 except b-code
     7692                 to temp-prod-bc
     7693                 assign
     7694                 temp-prod-bc.b-code = v-b-code
     7695                 temp-prod-bc.gds-code = buf_goods.gds-code
     7696                 .
     7697                 delete buf-prod-bc.
     7698               end.
     7699               when "gds-obj-attr":U then do:
     7700                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     7701                 if not (buf-gds-obj-attr.obj-type = p-old-obj-type
     7702                        and
     7703                        buf-gds-obj-attr.obj-code = p-old-obj-code) then do:
     7704                   delete buf-gds-obj-attr.
     7705                   next _pbc.
     7706                 end.
     7707                 assign
     7708                 buf-gds-obj-attr.obj-type = p-new-obj-type
     7709                 buf-gds-obj-attr.obj-code = p-new-obj-code
     7710                 .
     7711                 create buf-gds-obj-attr.
     7712                 import stream Instream buf-gds-obj-attr.gds-code                                 buf-gds-obj-attr.obj-type                                 buf-gds-obj-attr.obj-code                                 buf-gds-obj-attr.attr-code                                 buf-gds-obj-attr.attr-value no-error.
     7713                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pbc.                   end.
     7714                               find first buf_ext-classif no-lock where
     7715                           buf_ext-classif.classif-subject = 'goods':U
     7716                      and  buf_ext-classif.classif-name = v-classif-name
     7717                      and buf_ext-classif.key#_one = buf-gds-obj-attr.gds-code no-error.
     7718                 if not available buf_ext-classif then do:
     7719                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Не найдена запись для баркода в таблице соответствия(gds-obj-attr):" +                                  " Код товара " + string(buf-gds-obj-attr.gds-code) +                                  " Объект " + buf-gds-obj-attr.obj-type + string(buf-gds-obj-attr.obj-code) +                                  " Весовой код " + string(buf-gds-obj-attr.attr-value) ) )) .              delete buf-gds-obj-attr.                   NEXT _pbc.
     7720                 end.
     7721                 RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT buf_ext-classif.uniq-key-rec
     7722                                                     ,input ?
     7723                                                     ,INPUT "ub"
     7724                                                     ,INPUT ?
     7725                                                     ,INPUT NO-LOCK
     7726                                                     ,OUTPUT v-rowid
     7727                                                     ,OUTPUT v-tbl-name) no-error.
     7728                 if error-status:error then do:
     7729                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Ошибка при восстановлении баркода полученного из таблицы соответствия(gds-obj-attr):" +                                  " Код товара " + string(buf-gds-obj-attr.gds-code) +                                  " Объект " + buf-gds-obj-attr.obj-type + string(buf-gds-obj-attr.obj-code) +                                  " Весовой код " + string(buf-gds-obj-attr.attr-value) ) )) .              delete buf-gds-obj-attr.                   NEXT _pbc.
     7730                 end.
     7731                 find first buf_goods no-lock where
     7732                           rowid(buf_goods) = v-rowid no-error.
     7733                 if not available buf_goods then do:
     7734                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Не найден товар, полученный из таблицы соответствия(gds-obj-attr):" +                                  " Код товара " + string(buf-gds-obj-attr.gds-code) +                                  " Объект " + buf-gds-obj-attr.obj-type + string(buf-gds-obj-attr.obj-code) +                                  " Весовой код " + string(buf-gds-obj-attr.attr-value) ) )) .              delete buf-gds-obj-attr.                   NEXT _pbc.
     7735                 end.
     7736                 IF CAN-FIND(FIRST temp-gds-obj-attr No-LOCK WHERE
     7737                                   temp-gds-obj-attr.gds-code = buf_goods.gds-code
     7738                               AND temp-gds-obj-attr.obj-type = buf-gds-obj-attr.obj-type
     7739                               AND temp-gds-obj-attr.obj-code = buf-gds-obj-attr.obj-code
     7740                               AND temp-gds-obj-attr.attr-code = buf-gds-obj-attr.attr-code )
     7741                                   then do:
     7742                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС,ВЗВЕШ и ТОП КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть атрибут товара ВЕСОВОЙ КОД НА ОБЪЕКТЕ(gds-obj-attr):" +                                  " Старый Код товара " + string(buf-gds-obj-attr.gds-code) +                                  " новый Код товара " + string(buf_goods.gds-code) +                                  " Объект " + buf-gds-obj-attr.obj-type + string(buf-gds-obj-attr.obj-code) +                                  " Весовой код " + string(buf-gds-obj-attr.attr-value) ) )) .              delete buf-gds-obj-attr.                   NEXT _pbc.
     7743                 end.
     7744                 create temp-gds-obj-attr.
     7745                 buffer-copy buf-gds-obj-attr except gds-code to temp-gds-obj-attr
     7746                 assign
     7747                 temp-gds-obj-attr.gds-code = buf_goods.gds-code
     7748                 .
     7749                 delete buf-gds-obj-attr.
     7750               end.
     7751             end CASE.
     7752           end.
     7753           otherwise do:
     7754           end.
     7755         END CASE.
     7756       END.
     7757       input stream InStream close.
     7758     end.
     7759     end.
     7760   end procedure.
     7761   procedure p-scl-i :
     7762   define variable v-b-code as integer no-undo .
     7763   define variable v-rowid as rowid no-undo .
     7764   define variable v-tbl-name as character no-undo .
     7765   define buffer buf_ext-classif for ub.ext-classif.
     7766   define buffer buf_goods for ub.goods.
     7767     do
     7768     on error undo, return error
     7769     :
     7770     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ВЕСЫ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "scl":U) )) .
     7771     run check-iefile in this-procedure(input p-dir-name,                                      input "scl":U,                                      input "import":U,                                      output loc#log).
     7772     ii = 0.
     7773     if loc#log then do:
     7774       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ВЕСЫ" ) ).
     7775       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "scl":U).
     7776       _scl:
     7777       REPEAT:
     7778         import stream Instream unformatted ss.
     7779         CASE ss:
     7780           when "scales":U or when "scales-gds":U or when "scales-grp":U then do:
     7781             current-table = ss.
     7782             case current-table:
     7783               when "scales":U then do:
     7784                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     7785                 create buf-scales.
     7786                 CASE p-version:
     7787                   when "12.3" then do:
     7788                     import stream Instream buf-scales.address                                 buf-scales.master                                 buf-scales.max-gds                                 buf-scales.max-plu                                 buf-scales.scales-name                                 buf-scales.scales-num                                 buf-scales.scales-type                                 buf-scales.to-send                                 buf-scales.tot-gds                                 buf-scales.unit-base                                 buf-scales.wt-cart no-error.
     7789                   end.
     7790                   when "14.1" then do:
     7791                     import stream Instream buf-scales.address                                 buf-scales.master                                 buf-scales.max-gds                                 buf-scales.max-plu                                 buf-scales.scales-name                                 buf-scales.scales-num                                 buf-scales.scales-type                                 buf-scales.to-send                                 buf-scales.tot-gds                                 buf-scales.unit-base                                 buf-scales.wt-cart                                  buf-scales.remote no-error.
     7792                   end.
     7793                   when "15.0" then do:
     7794                     import stream Instream buf-scales.address                                 buf-scales.db-num                                 buf-scales.master                                 buf-scales.max-gds                                 buf-scales.max-plu                                 buf-scales.scales-name                                 buf-scales.scales-num                                 buf-scales.scales-type                                 buf-scales.to-send                                 buf-scales.tot-gds                                 buf-scales.unit-base                                 buf-scales.wt-cart                                  buf-scales.remote no-error.
     7795                   end.
     7796                 END CASE.
     7797                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _scl.                   end.
     7798                 assign
     7799                 buf-scales.db-num = g#db-num
     7800                 .
     7801                               IF CAN-FIND(FIRST temp-scales No-LOCK WHERE
     7802                                   temp-scales.db-num = buf-scales.db-num AND
     7803                                   temp-scales.scales-num = buf-scales.scales-num )
     7804                                   then do:
     7805                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ВЕСЫ(scales):" +                                  " номер " + string(buf-scales.scales-num)) )) .              delete buf-scales.                   NEXT _scl.
     7806                 end.
     7807                 create temp-scales.
     7808                 buffer-copy buf-scales to temp-scales.
     7809                 assign
     7810                 temp-scales.db-num = (if p-version < "15.0"
     7811                                       then g#db-num
     7812                                       else temp-scales.db-num)
     7813                 .
     7814                 delete buf-scales.
     7815               end.
     7816               when "scales-gds":U then do:
     7817                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     7818                 create buf-scales-gds.
     7819                 CASE p-version:
     7820                   when "15.0" then do:
     7821                      import stream Instream buf-scales-gds.PLU-code                                 buf-scales-gds.b-code                                 buf-scales-gds.db-num                                 buf-scales-gds.deadline                                 buf-scales-gds.obj-code                                 buf-scales-gds.obj-type                                 buf-scales-gds.scales-num                                 buf-scales-gds.to-del                                 buf-scales-gds.to-send                                 buf-scales-gds.wt-cart                                 buf-scales-gds.deaddate                                 buf-scales-gds.deadflag                                 buf-scales-gds.deadtime buf-scales-gds.old-gds-code no-error.
     7822                   end.
     7823                   otherwise do:
     7824                     import stream Instream buf-scales-gds.PLU-code                                 buf-scales-gds.b-code                                 buf-scales-gds.deadline                                 buf-scales-gds.obj-code                                 buf-scales-gds.obj-type                                 buf-scales-gds.scales-num                                 buf-scales-gds.to-del                                 buf-scales-gds.to-send                                 buf-scales-gds.wt-cart no-error.
     7825                   end.
     7826                 END CASE.
     7827                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _scl.                   end.
     7828                 if not (buf-scales-gds.obj-type = p-old-obj-type
     7829                         and
     7830                         buf-scales-gds.obj-code = p-old-obj-code) then do:
     7831                   delete buf-scales-gds.
     7832                   next _scl.
     7833                 end.
     7834                 assign
     7835                 buf-scales-gds.obj-type = p-new-obj-type
     7836                 buf-scales-gds.obj-code = p-new-obj-code
     7837                 buf-scales-gds.db-num = g#db-num
     7838                 .
     7839                               find first buf_ext-classif no-lock where
     7840                           buf_ext-classif.classif-subject = 'goods':U
     7841                      and  buf_ext-classif.classif-name = v-classif-name
     7842                      and buf_ext-classif.key#_one = buf-scales-gds.old-gds-code no-error.
     7843                 if not available buf_ext-classif then do:
     7844                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Не найдена запись для баркода в таблице соответствия(scales-gds):" +                                  " номер весов " + string(buf-scales-gds.scales-num) +                                  " PLU " + string(buf-scales-gds.PLU-code)) )) .              delete buf-scales-gds.                   NEXT _scl.
     7845                 end.
     7846                 RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT buf_ext-classif.uniq-key-rec
     7847                                                     ,input ?
     7848                                                     ,INPUT "ub"
     7849                                                     ,INPUT ?
     7850                                                     ,INPUT NO-LOCK
     7851                                                     ,OUTPUT v-rowid
     7852                                                     ,OUTPUT v-tbl-name) no-error.
     7853                 if error-status:error then do:
     7854                     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Ошибка при восстановлении баркода полученного из таблицы соответствия(scaels-gds):" +                                  " номер весов " + string(buf-scales-gds.scales-num) +                                  " PLU " + string(buf-scales-gds.PLU-code)) )) .              delete buf-scales-gds.                   NEXT _scl.
     7855                 end.
     7856                 find first buf_goods no-lock where
     7857                           rowid(buf_goods) = v-rowid no-error.
     7858                 if not available buf_goods then do:
     7859                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Не найден товар, полученный из таблицы соответствия(scales-gds):" +                                  " номер весов " + string(buf-scales-gds.scales-num) +                                  " PLU " + string(buf-scales-gds.PLU-code)) )) .              delete buf-scales-gds.                   NEXT _scl.
     7860                 end.
     7861                 IF CAN-FIND(FIRST temp-scales-gds No-LOCK WHERE
     7862                                   temp-scales-gds.db-num = buf-scales-gds.db-num AND
     7863                                   temp-scales-gds.scales-num = buf-scales-gds.scales-num AND
     7864                                   temp-scales-gds.PLU-code = buf-scales-gds.PLU-code)
     7865                                   then do:
     7866                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ТОВАР НА ВЕСАХ(scales-gds):" +                                  " номер весов " + string(buf-scales-gds.scales-num) +                                  " PLU " + string(buf-scales-gds.PLU-code)) )) .              delete buf-scales-gds.                   NEXT _scl.
     7867                 end.
     7868   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7869     (input  buf_goods.gds-code
     7870     ,input  ?
     7871     ,output v-b-code
     7872     ) no-error .
     7873                 if error-status:error then do:
     7874                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Ошибка при определении главного баркода товара, полученный из таблицы соответствия(prod-bc):" +                                  " номер весов " + string(buf-scales-gds.scales-num) +                                  " PLU " + string(buf-scales-gds.PLU-code)) )) .              delete buf-scales-gds.                   NEXT _scl.
     7875                 end.
     7876                 IF CAN-FIND(FIRST temp-scales-gds No-LOCK WHERE
     7877                                   temp-scales-gds.db-num = buf-scales-gds.db-num AND
     7878                                   temp-scales-gds.scales-num = buf-scales-gds.scales-num AND
     7879                                   temp-scales-gds.b-code = v-b-code)
     7880                                   then do:
     7881                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ТОВАР НА ВЕСАХ(scales-gds):" +                                  " номер весов " + string(buf-scales-gds.scales-num) +                                  " баркод новый" + string(v-b-code) +                                  " баркод старый" + string(buf-scales-gds.b-code)) )) .              delete buf-scales-gds.                   NEXT _scl.
     7882                 end.
     7883                 create temp-scales-gds.
     7884                 buffer-copy buf-scales-gds except b-code to temp-scales-gds
     7885                 assign
     7886                 temp-scales-gds.b-code = v-b-code
     7887                 temp-scales-gds.db-num = (if p-version < "15.0"
     7888                                       then g#db-num
     7889                                       else temp-scales-gds.db-num)
     7890                 .
     7891                 delete buf-scales-gds.
     7892               end.
     7893               when "scales-grp":U then do:
     7894                 next _scl.
     7895               end.
     7896             end CASE.
     7897           end.
     7898           otherwise do:
     7899           end.
     7900         END CASE.
     7901       END.
     7902       input stream InStream close.
     7903     end.
     7904     end.
     7905   end procedure.
     7906   procedure p-cdk-i :
     7907   define variable v-b-code as integer no-undo .
     7908   define variable v-rowid as rowid no-undo .
     7909   define variable v-tbl-name as character no-undo .
     7910   define variable v-fr-type as character no-undo .
     7911     do
     7912     on error undo, return error
     7913     :
     7914     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных КАССЫ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "cdk":U) )) .
     7915     run check-iefile in this-procedure(input p-dir-name,                                      input "cdk":U,                                      input "import":U,                                      output loc#log).
     7916     ii = 0.
     7917     if loc#log then do:
     7918       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных КАССЫ" ) ).
     7919       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "cdk":U).
     7920       _cdk:
     7921       REPEAT:
     7922         import stream Instream unformatted ss.
     7923         CASE ss:
     7924           when 'cash-desk':U then do:
     7925             current-table = ss.
     7926             case current-table:
     7927               when 'cash-desk':U then do:
     7928                 if p-new-obj-type <> 'маг':U
     7929                 then do:
     7930                   next _cdk.
     7931                 end.
     7932                 v-fr-type = ''.
     7933                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     7934                 create buf-cash-desk.
     7935                 import stream Instream buf-cash-desk.addr-path                                 buf-cash-desk.autonomy                                 buf-cash-desk.cash-num                                 buf-cash-desk.cash-on                                 buf-cash-desk.cash-os                                 buf-cash-desk.obj-code                                 buf-cash-desk.pos-type                                 buf-cash-desk.registration-code                                 buf-cash-desk.remote                                 buf-cash-desk.serial-code                                 buf-cash-desk.version                                 buf-cash-desk.fr-type no-error.
     7936                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КАССЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _cdk.                   end.
     7937                 if not (buf-cash-desk.obj-code = p-old-obj-code) then do:
     7938                   delete buf-cash-desk.
     7939                   next _cdk.
     7940                 end.
     7941                 assign
     7942                 buf-cash-desk.db-num = g#db-num
     7943                 buf-cash-desk.obj-code = p-new-obj-code
     7944                 .
     7945                               IF CAN-FIND(FIRST temp-cash-desk No-LOCK WHERE
     7946                                   temp-cash-desk.db-num = buf-cash-desk.db-num AND
     7947                                   temp-cash-desk.obj-code = buf-cash-desk.obj-code AND
     7948                                   temp-cash-desk.cash-num = buf-cash-desk.cash-num )
     7949                                   then do:
     7950                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КАССЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть КАССА(cash-desk):" +                                  " номер " + string(buf-cash-desk.cash-num)) )) .              delete buf-cash-desk.                   NEXT _cdk.
     7951                 end.
     7952                 create temp-cash-desk.
     7953                 buffer-copy buf-cash-desk to temp-cash-desk
     7954                 assign
     7955                 temp-cash-desk.fr-type = v-fr-type
     7956                 .
     7957                 delete buf-cash-desk.
     7958               end.
     7959             end CASE.
     7960           end.
     7961           otherwise do:
     7962           end.
     7963         END CASE.
     7964       END.
     7965       input stream InStream close.
     7966     end.
     7967   end.
     7968   end procedure.
     7969   procedure p-pet-i :
     7970   define variable v-b-code as integer no-undo .
     7971   define variable v-rowid as rowid no-undo .
     7972   define variable v-tbl-name as character no-undo .
     7973   define buffer buf_ext-classif for ub.ext-classif.
     7974   define buffer buf_goods for ub.goods.
     7975     do
     7976     on error undo, return error
     7977     :
     7978     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных КОНФИГУРАЦИЯ АЗК" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "pet":U) )) .
     7979     run check-iefile in this-procedure(input p-dir-name,                                      input "pet":U,                                      input "import":U,                                      output loc#log).
     7980     ii = 0.
     7981     if loc#log then do:
     7982       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных КОНФИГУРАЦИЯ АЗК" ) ).
     7983       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "pet":U).
     7984       _pet:
     7985       REPEAT:
     7986         import stream Instream unformatted ss.
     7987         CASE ss:
     7988           when 'place':U then do:
     7989             current-table = ss.
     7990             case current-table:
     7991               when 'place':U then do:
     7992                 if p-new-obj-type <> 'маг':U then do:
     7993                   next _pet.
     7994                 end.
     7995                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     7996                 create buf-place.
     7997                 import stream Instream buf-place.add-qnty                                 buf-place.is-meas                                  buf-place.loc1                                 buf-place.loc2                                  buf-place.loc3                                  buf-place.loc4                                  buf-place.max-qnty                                 buf-place.obj-code                                 buf-place.obj-type                                 buf-place.pl-code                                  buf-place.pl-name                                  buf-place.PS                                       buf-place.status_ no-error.
     7998                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pet.                   end.
     7999                 if not (buf-place.obj-type = p-old-obj-type
     8000                         and
     8001                         buf-place.obj-code = p-old-obj-code) then do:
     8002                   delete buf-place.
     8003                   next _pet.
     8004                 end.
     8005                 assign
     8006                 buf-place.obj-code = p-new-obj-code
     8007                 buf-place.obj-type = p-new-obj-type
     8008                 .
     8009                               IF CAN-FIND(FIRST temp-place No-LOCK WHERE
     8010                                   temp-place.obj-code = buf-place.obj-code AND
     8011                                   temp-place.obj-type = buf-place.obj-type AND
     8012                                   temp-place.pl-code = buf-place.pl-code
     8013                                   )
     8014                                   then do:
     8015                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Уже есть СКЛ.МЕСТО(place):" +                                  " номер " + string(buf-place.pl-code) + " на " + buf-place.obj-type + string(buf-place.obj-code)) )) .              delete buf-place.                   NEXT _pet.
     8016                 end.
     8017                 IF CAN-FIND(FIRST temp-place No-LOCK WHERE
     8018                                   temp-place.pl-code = buf-place.pl-code
     8019                                   )
     8020                                   then do:
     8021                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Уже есть СКЛ.МЕСТО(place):" +                                  " номер " + string(buf-place.pl-code) + " на " + buf-place.obj-type + string(buf-place.obj-code)) )) .              delete buf-place.                   NEXT _pet.
     8022                 end.
     8023                 create temp-place.
     8024                 buffer-copy buf-place to temp-place
     8025                 .
     8026                 delete buf-place.
     8027               end.
     8028             end CASE.
     8029           end.
     8030           when 'pump':U then do:
     8031             current-table = ss.
     8032             case current-table:
     8033               when 'pump':U then do:
     8034                 if p-new-obj-type <> 'маг':U then do:
     8035                   next _pet.
     8036                 end.
     8037                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8038                 create buf-pump.
     8039                 import stream Instream buf-pump.obj-code                                  buf-pump.obj-type                                  buf-pump.PS                                 buf-pump.pump-code                                 buf-pump.status_ no-error.
     8040                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pet.                   end.
     8041                 if not (buf-pump.obj-type = p-old-obj-type
     8042                         and
     8043                         buf-pump.obj-code = p-old-obj-code) then do:
     8044                   delete buf-pump.
     8045                   next _pet.
     8046                 end.
     8047                 assign
     8048                 buf-pump.obj-code = p-new-obj-code
     8049                 buf-pump.obj-type = p-new-obj-type
     8050                 .
     8051                               IF CAN-FIND(FIRST temp-pump No-LOCK WHERE
     8052                                   temp-pump.obj-code = buf-pump.obj-code AND
     8053                                   temp-pump.obj-type = buf-pump.obj-type AND
     8054                                   temp-pump.pump-code = buf-pump.pump-code
     8055                                   )
     8056                                   then do:
     8057                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Уже есть ТРК(pump):" +                                   " номер " + string(buf-pump.pump-code) + " на " + buf-pump.obj-type + string(buf-pump.obj-code)) )) .              delete buf-pump.                   NEXT _pet.
     8058                 end.
     8059                 IF CAN-FIND(FIRST temp-pump No-LOCK WHERE
     8060                                   temp-pump.pump-code = buf-pump.pump-code
     8061                                   )
     8062                                   then do:
     8063                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Уже есть ТРК(pump):" +                                   " номер " + string(buf-pump.pump-code) + " на " + buf-pump.obj-type + string(buf-pump.obj-code)) )) .              delete buf-pump.                   NEXT _pet.
     8064                 end.
     8065                 create temp-pump.
     8066                 buffer-copy buf-pump to temp-pump
     8067                 .
     8068                 delete buf-pump.
     8069               end.
     8070             end case.
     8071           end.
     8072           when 'nozzle':U then do:
     8073             current-table = ss.
     8074             case current-table:
     8075               when 'nozzle':U then do:
     8076                 if p-new-obj-type <> 'маг':U then do:
     8077                   next _pet.
     8078                 end.
     8079                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8080                 create buf-nozzle.
     8081                 import stream Instream buf-nozzle.nozzle-code                                 buf-nozzle.obj-code                                 buf-nozzle.obj-type                                 buf-nozzle.PS                                 buf-nozzle.status_ no-error.
     8082                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pet.                   end.
     8083                 if not (buf-nozzle.obj-type = p-old-obj-type
     8084                         and
     8085                         buf-nozzle.obj-code = p-old-obj-code) then do:
     8086                   delete buf-nozzle.
     8087                   next _pet.
     8088                 end.
     8089                 assign
     8090                 buf-nozzle.obj-code = p-new-obj-code
     8091                 buf-nozzle.obj-type = p-new-obj-type
     8092                 .
     8093                               IF CAN-FIND(FIRST temp-nozzle No-LOCK WHERE
     8094                                   temp-nozzle.obj-code = buf-nozzle.obj-code AND
     8095                                   temp-nozzle.obj-type = buf-nozzle.obj-type AND
     8096                                   temp-nozzle.nozzle-code = buf-nozzle.nozzle-code
     8097                                   )
     8098                                   then do:
     8099                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Уже есть пистолет(nozzle):" +                                   " номер " + string(buf-nozzle.nozzle-code) + " на " + buf-nozzle.obj-type + string(buf-nozzle.obj-code)) )) .              delete buf-nozzle.                   NEXT _pet.
     8100                 end.
     8101                 IF CAN-FIND(FIRST temp-nozzle No-LOCK WHERE
     8102                                   temp-nozzle.nozzle-code = buf-nozzle.nozzle-code
     8103                                   )
     8104                                   then do:
     8105                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Уже есть пистолет(nozzle):" +                                   " номер " + string(buf-nozzle.nozzle-code) + " на " + buf-nozzle.obj-type + string(buf-nozzle.obj-code)) )) .              delete buf-nozzle.                   NEXT _pet.
     8106                 end.
     8107                 create temp-nozzle.
     8108                 buffer-copy buf-nozzle to temp-nozzle
     8109                 .
     8110                 delete buf-nozzle.
     8111               end.
     8112             end case.
     8113           end.
     8114           when 'pl-gds':U then do:
     8115             current-table = ss.
     8116             case current-table:
     8117               when 'pl-gds':U then do:
     8118                 if p-new-obj-type <> 'маг':U then do:
     8119                   next _pet.
     8120                 end.
     8121                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8122                 create buf-pl-gds.
     8123                 import stream Instream buf-pl-gds.gds-code                                 buf-pl-gds.max-qnty                                 buf-pl-gds.obj-code                                 buf-pl-gds.obj-type                                 buf-pl-gds.pl-code                                  buf-pl-gds.PS                                       buf-pl-gds.status_                                  buf-pl-gds.tolerance no-error.
     8124                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pet.                   end.
     8125                 if not (buf-pl-gds.obj-type = p-old-obj-type
     8126                         and
     8127                         buf-pl-gds.obj-code = p-old-obj-code) then do:
     8128                   delete buf-pl-gds.
     8129                   next _pet.
     8130                 end.
     8131                 assign
     8132                 buf-pl-gds.obj-code = p-new-obj-code
     8133                 buf-pl-gds.obj-type = p-new-obj-type
     8134                 .
     8135                               IF CAN-FIND(FIRST temp-pl-gds No-LOCK WHERE
     8136                                   temp-pl-gds.obj-code = buf-pl-gds.obj-code AND
     8137                                   temp-pl-gds.obj-type = buf-pl-gds.obj-type AND
     8138                                   temp-pl-gds.pl-code = buf-pl-gds.pl-code AND
     8139                                   temp-pl-gds.gds-code = buf-pl-gds.gds-code
     8140                                   )
     8141                                   then do:
     8142                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПРИВЯЗКА К СКЛ.МЕСТУ(pl-gds):" +                                   " код скл.места " + string(buf-pl-gds.pl-code) +  " код товара " + string(buf-pl-gds.gds-code) + " на " + buf-pl-gds.obj-type + string(buf-pl-gds.obj-code)) )) .              delete buf-pl-gds.                   NEXT _pet.
     8143                 end.
     8144                 create temp-pl-gds.
     8145                 buffer-copy buf-pl-gds to temp-pl-gds
     8146                 .
     8147                 delete buf-pl-gds.
     8148                 find first buf_ext-classif no-lock where
     8149                           buf_ext-classif.classif-subject = 'goods':U
     8150                       and  buf_ext-classif.classif-name = v-classif-name
     8151                       and buf_ext-classif.key#_one = temp-pl-gds.gds-code no-error.
     8152                 if not available buf_ext-classif then do:
     8153                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Не найдена запись для товара на скл.месте  в таблице соответствия(pl-gds):" +                                   " СклМесто " + string(temp-pl-gds.pl-code) +                                   " Товар " + string(temp-pl-gds.gds-code)) )) .              delete buf-pl-gds.                   NEXT _pet.
     8154                 end.
     8155                 RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT buf_ext-classif.uniq-key-rec
     8156                                                     ,input ?
     8157                                                     ,INPUT "ub"
     8158                                                     ,INPUT ?
     8159                                                     ,INPUT NO-LOCK
     8160                                                     ,OUTPUT v-rowid
     8161                                                     ,OUTPUT v-tbl-name) no-error.
     8162                 if error-status:error then do:
     8163                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Ошибка при восстановлении товара на скл.месте полученного из таблицы соответствия(pl-gds):" +                                   " СклМесто " + string(temp-pl-gds.pl-code) +                                   " Товар " + string(temp-pl-gds.gds-code)) )) .              delete buf-pl-gds.                   NEXT _pet.
     8164                 end.
     8165                 find first buf_goods no-lock where
     8166                           rowid(buf_goods) = v-rowid no-error.
     8167                 if not available buf_goods then do:
     8168                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Не найден товар, полученный из таблицы соответствия(pl-gds):" +                                   " СклМесто " + string(temp-pl-gds.pl-code) +                                   " Товар " + string(temp-pl-gds.gds-code)) )) .              delete buf-pl-gds.                   NEXT _pet.
     8169                 end.
     8170                 else do:
     8171                   temp-pl-gds.gds-code = buf_goods.gds-code.
     8172                 end.
     8173               end.
     8174             end case.
     8175           end.
     8176           when 'pl-gds-pump':U then do:
     8177             current-table = ss.
     8178             case current-table:
     8179               when 'pl-gds-pump':U then do:
     8180                 if p-new-obj-type <> 'маг':U then do:
     8181                   next _pet.
     8182                 end.
     8183                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8184                 create buf-pl-gds-pump.
     8185                 import stream Instream buf-pl-gds-pump.gds-code                                 buf-pl-gds-pump.obj-code                                 buf-pl-gds-pump.obj-type                                 buf-pl-gds-pump.pl-code                                  buf-pl-gds-pump.PS                                       buf-pl-gds-pump.pump-code                                 buf-pl-gds-pump.status_ no-error.
     8186                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pet.                   end.
     8187                 if not (buf-pl-gds-pump.obj-type = p-old-obj-type
     8188                         and
     8189                         buf-pl-gds-pump.obj-code = p-old-obj-code) then do:
     8190                   delete buf-pl-gds-pump.
     8191                   next _pet.
     8192                 end.
     8193                 assign
     8194                 buf-pl-gds-pump.obj-code = p-new-obj-code
     8195                 buf-pl-gds-pump.obj-type = p-new-obj-type
     8196                 .
     8197                               IF CAN-FIND(FIRST temp-pl-gds-pump No-LOCK WHERE
     8198                                   temp-pl-gds-pump.obj-code = buf-pl-gds-pump.obj-code AND
     8199                                   temp-pl-gds-pump.obj-type = buf-pl-gds-pump.obj-type AND
     8200                                   temp-pl-gds-pump.pl-code = buf-pl-gds-pump.pl-code AND
     8201                                   temp-pl-gds-pump.gds-code = buf-pl-gds-pump.gds-code AND
     8202                                   temp-pl-gds-pump.pump-code = buf-pl-gds-pump.pump-code
     8203                                   )
     8204                                   then do:
