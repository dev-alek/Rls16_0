     6105               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) +  " ошибка при сохранении записи ПРИВЯЗКИ ТОВАРА К СКЛ.МЕСТУ и ТРК(pl-gds-pump):" +             " код товара " + string(temp-pl-gds-pump.gds-code)  + " код скл.места " + string(temp-pl-gds-pump.pl-code) + " код ТРК " + string(temp-pl-gds-pump.pump-code ) +                                       er-mes) )) .                NEXT _pl-gds-pumpv.
