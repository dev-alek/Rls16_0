     8800                                 import stream Instream buf-userconf.ARM                                 buf-userconf.max-discnt                                 buf-userconf.obj-code                                 buf-userconf.obj-type                                 buf-userconf.on-line                                 buf-userconf.user-name                                 buf-userconf.userid_                                 buf-userconf.user-name_                                 buf-userconf.password_ no-error.
     8801                              end.
     8802                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _usr.                   end.
     8803                                                         IF CAN-FIND(FIRST temp-userconf No-LOCK WHERE
     8804                                                temp-userconf.user-name = buf-userconf.user-name) then do:
     8805                                                                     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПОЛЬЗОВАТЕЛЬ(userconf):" +                                                 " имя " + buf-userconf.user-name) )) .              delete buf-userconf.                   NEXT _usr.
     8806                              end.
     8807                              create temp-userconf.
     8808                              buffer-copy
     8809                              buf-userconf to temp-userconf.
     8810                              delete buf-userconf.
     8811                           end.
     8812                           when "usr-flt":U then do:
     8813                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8814                              create buf-usr-flt.
     8815                              import stream Instream buf-usr-flt.Naim                                 buf-usr-flt.call-point                                 buf-usr-flt.user-name no-error.
     8816                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _usr.                   end.
     8817                                                         assign
     8818                              buf-usr-flt.call-point = replace(buf-usr-flt.call-point, chr(1), chr(4))
     8819                              .
     8820                              IF CAN-FIND(FIrst temp-usr-flt NO-LOCK WHERE
     8821                                                temp-usr-flt.user-name = buf-usr-flt.user-name AND
     8822                                                temp-usr-flt.call-point = buf-usr-flt.call-point) then do:
     8823                                                                     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ФИЛЬТР ДЛЯ ПОЛЬЗОВАТЕЛЯ(usr-flt):" +                                                 " имя пользователя " + buf-usr-flt.user-name +                                                 " точка вызова фильтра " + buf-usr-flt.call-point) )) .              delete buf-usr-flt.                   NEXT _usr.
     8824                              end.
     8825                              create temp-usr-flt.
     8826                              buffer-copy buf-usr-flt to temp-usr-flt.
     8827                              delete buf-usr-flt.
     8828                           end.
     8829                           when "usr-grpa":U then do:
     8830                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8831                              create buf-usr-grpa.
     8832                              import stream Instream buf-usr-grpa.arm-code                                 buf-usr-grpa.grp-name                                 buf-usr-grpa.host-code                                 buf-usr-grpa.user-name no-error.
     8833                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _usr.                   end.
     8834                                                         IF CAN-FIND(FIRST temp-usr-grpa NO-LOCK WHERE
     8835                                                temp-usr-grpa.user-name = buf-usr-grpa.user-name AND
     8836                                                temp-usr-grpa.host-code = buf-usr-grpa.host-code AND
     8837                                                temp-usr-grpa.arm-code = buf-usr-grpa.arm-code) then do:
     8838                                                                  run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПРАВА В АРМЕ ДЛЯ ПОЛЬЗОВАТЕЛЯ(usr-grpa):" +                                                 " имя пользователя " + buf-usr-grpa.user-name +                                                 " фирма " + string(buf-usr-grpa.host-code) +                                                 " АРМ " + buf-usr-grpa.arm-code) )) .              delete buf-usr-grpa.                   NEXT _usr.
     8839                              END.
     8840                              create temp-usr-grpa.
     8841                              buffer-copy buf-usr-grpa to temp-usr-grpa.
     8842                              delete buf-usr-grpa.
     8843                           end.
     8844                           when "usr-grpo":U then do:
     8845                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8846                              create buf-usr-grpo.
     8847                              import stream Instream buf-usr-grpo.grp-name                                 buf-usr-grpo.obj-code                                 buf-usr-grpo.obj-type                                 buf-usr-grpo.user-name no-error.
     8848                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _usr.                   end.
     8849                                                         IF CAN-FIND(FIRST temp-usr-grpo NO-LOCK WHERE
