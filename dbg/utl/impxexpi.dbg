     6762                                          ,v-menu-group-id-list
     6763                                          ,chr(44)
     6764                                          )
     6765                  .
     6766                  find first buf_menu-group
     6767                       where buf_menu-group.menu-code     = 0
     6768                         and buf_menu-group.menu-group-id = v-menu-group-id
     6769                       no-lock
     6770                       no-error
     6771                       .
     6772                  if available buf_menu-group
     6773                  then do:
