     7088                          where buf_user-login.db-num     = g#db-num
     7089                            and buf_user-login.user-login = temp-usr-grpo.user-name
     7090                          no-lock
     7091                          no-error
     7092                          .
     7093                     if not available buf_user-login
     7094                     then do:
     7095                                                   next _temp-grpo.
     7096                     end.
     7097                     else do:
     7098                        find first buf_clients
     7099                             where buf_clients.obj-type = temp-usr-grpo.obj-type
     7100                               and buf_clients.obj-code = temp-usr-grpo.obj-code
     7101                             no-lock
     7102                             no-error
     7103                             .
     7104                        if not available buf_clients
     7105                        then do:
     7106                                                   next _temp-grpo.
     7107                        end.
     7108                        else do:
     7109                           if v-global-action-role-code <> 0
     7110                           then do:
     7111                              assign
