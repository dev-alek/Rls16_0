     8359   procedure p-seq-i :
     8360     do
     8361     on error undo, return error
     8362     :
     8363     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных СЧЕТЧИКИ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "seq":U) )) .
     8364     run check-iefile in this-procedure(input p-dir-name,                                      input "seq":U,                                      input "import":U,                                      output loc#log).
     8365     ii = 0.
     8366     if loc#log then do:
     8367       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных СЧЕТЧИКИ" ) ).
     8368       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "seq":U).
     8369       _seq:
     8370       REPEAT:
     8371         import stream Instream unformatted ss.
     8372         CASE ss:
     8373           when "_sequence":U then do:
     8374             current-table = ss.
     8375             case current-table:
     8376               when "sequence":U then do:
     8377                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8378                 create buf_sequence.
     8379                 import stream Instream  no-error.
     8380                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных СЧЕТЧИКИ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _seq.                   end.
     8381                               if LOOKUP(buf_sequence.seq-name, 'next-report,s-doc,s-doc-type,s-file-num,':U +                                 's-line-num,s-petrol-code,s-reserve2':U +                                 ',s-spool,s-task-num,s-tax-rate,synch-cli-grp,synch-gds-grp' ) = 0 then next _seq.
     8382                 IF CAN-FIND(FIRST temp_sequence No-LOCK WHERE
     8383                                   temp_sequence.seq-name = buf_sequence.seq-name
     8384                                   )
     8385                                   then do:
     8386                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных СЧЕТЧИКИ, СТРОКА " + string(ii) + chr(10)) + " Уже есть СЧЕТЧИК(sequence):" +                                  " название " + string(buf_sequence.seq-name)) )) .              delete buf_sequence.                   NEXT _seq.
     8387                 end.
     8388                 create temp_sequence.
     8389                 buffer-copy buf_sequence to temp_sequence.
     8390                 delete buf_sequence.
     8391               end.
     8392             end CASE.
     8393           end.
     8394           otherwise do:
     8395           end.
     8396         END CASE.
     8397       END.
     8398       input stream InStream close.
     8399     end.
     8400     end.
     8401   end procedure.
     8402   procedure p-rht-i :
     8403   define variable v-curr-seek as integer no-undo .
     8404     do
     8405     on error undo, return error
     8406     :
     8407      run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ПРАВА" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "rht":U) )) .
     8408      run check-iefile in this-procedure(input p-dir-name,                                      input "rht":U,                                      input "import":U,                                      output loc#log).
     8409      ii = 0.
     8410      if loc#log then do:
     8411         run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ПРАВА" ) ).
     8412         input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "rht":U).
     8413         CASE p-version:
     8414            when "15.0" then do:
     8415                  _rht:
     8416                  REPEAT:
     8417                     import stream Instream unformatted ss.
     8418                     ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8419                     CASE ss:
     8420                     when "action-role":U or
     8421                     when "action-role-item":U
     8422                     then do:
     8423                        current-table = ss.
     8424                        case current-table:
     8425                           when "action-role":U then do:
     8426                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8427                              create buf-action-role.
     8428                              v-curr-seek = seek(instream).
     8429                              import stream Instream buf-action-role.db-num                                  buf-action-role.action-head-code                                  buf-action-role.action-role-code                                  buf-action-role.action-role-context                                  buf-action-role.action-role-name                                  buf-action-role.action-role-description                                  buf-action-role.whole-send-news no-error.
     8430                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _rht.                   end.
     8431                              buf-action-role.db-num = g#db-num.
     8432                                                         IF CAN-FIND(FIRST temp-action-role No-LOCK
     8433                                          WHERE temp-action-role.db-num    = buf-action-role.db-num
     8434                                            and temp-action-role.action-head-code = buf-action-role.action-head-code
     8435                                            and temp-action-role.action-role-code = buf-action-role.action-role-code
     8436                                          )
     8437                                                then do:
     8438                                                                     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПОЛЬЗОВАТЕЛЬ(action-role): "                                                               + STRING(buf-action-role.db-num) + " "                                                               + STRING(buf-action-role.action-head-code) + " "                                                               + STRING(buf-action-role.action-role-code)                                                               ) )) .              delete buf-action-role.                   NEXT _rht.
     8439                              end.
     8440                              create temp-action-role.
     8441                              buffer-copy
     8442                              buf-action-role to temp-action-role.
     8443                              delete buf-action-role.
     8444                           end.
     8445                           when "action-role-item":U then do:
     8446                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8447                              create buf-action-role-item.
     8448                              v-curr-seek = seek(instream).
     8449                              import stream Instream buf-action-role-item.db-num                                  buf-action-role-item.action-head-code                                  buf-action-role-item.action-role-code                                  buf-action-role-item.action-role-item-code                                  buf-action-role-item.action-item-code                                  buf-action-role-item.action-item-id                                  buf-action-role-item.whole-send-news no-error.
     8450                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _rht.                   end.
     8451                              buf-action-role-item.db-num = g#db-num.
     8452                                                         IF CAN-FIND(FIRST temp-action-role-item No-LOCK
     8453                                          WHERE temp-action-role-item.db-num                = buf-action-role-item.db-num
     8454                                            and temp-action-role-item.action-head-code      = buf-action-role-item.action-head-code
     8455                                            and temp-action-role-item.action-role-code      = buf-action-role-item.action-role-code
     8456                                            and temp-action-role-item.action-role-item-code = buf-action-role-item.action-role-item-code
     8457                                          )
     8458                                                then do:
     8459                                                                     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПОЛЬЗОВАТЕЛЬ(action-role-item): "                                                               + STRING(buf-action-role-item.db-num) + " "                                                               + STRING(buf-action-role-item.action-head-code) + " "                                                               + STRING(buf-action-role-item.action-role-code) + " "                                                               + STRING(buf-action-role-item.action-role-item-code)                                                               ) )) .              delete buf-action-role-item.                   NEXT _rht.
     8460                              end.
     8461                              create temp-action-role-item.
     8462                              buffer-copy
     8463                              buf-action-role-item to temp-action-role-item.
     8464                              delete buf-action-role-item.
     8465                           end.
     8466                        end CASE.
     8467                     end.
     8468                     otherwise do:
     8469                     end.
     8470                     END CASE.
     8471                  END.
     8472            end.
     8473            otherwise do:
     8474               _rht:
     8475               REPEAT:
     8476                  import stream Instream unformatted ss.
     8477                  CASE ss:
     8478                  when "grpa":U or when "grp-acta":U then do:
     8479                     current-table = ss.
     8480                     case current-table:
     8481                        when "grpa":U then do:
     8482                        ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8483                        create buf-grpa.
     8484                        import stream Instream buf-grpa.arm-code                                 buf-grpa.grp-name no-error.
     8485                                             if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _rht.                   end.
     8486                                             IF CAN-FIND(FIRST temp-grpa NO-LOCK WHERE
     8487                                          temp-grpa.grp-name = buf-grpa.grp-name AND
     8488                                          temp-grpa.arm-code = buf-grpa.arm-code) then do:
     8489                                                      run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + " Уже есть ГРУППЫ ПРАВ(grpa):" +                                           " группа " + buf-grpa.grp-name +                                           " АРМ " + buf-grpa.arm-code) )) .              delete buf-grpa.                   NEXT _rht.
     8490                        END.
     8491                        create temp-grpa.
     8492                        buffer-copy buf-grpa to temp-grpa.
     8493                        delete buf-grpa.
     8494                        end.
     8495                        when "grp-acta":U then do:
     8496                        ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8497                        create buf-grp-acta.
     8498                        import stream Instream buf-grp-acta.act                                 buf-grp-acta.arm-code                                 buf-grp-acta.grp-name                                 buf-grp-acta.object no-error.
     8499                                             if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _rht.                   end.
     8500                                             IF CAN-FIND(FIRST temp-grp-acta NO-LOCK WHERE
     8501                                          temp-grp-acta.grp-name = buf-grp-acta.grp-name AND
     8502                                          temp-grp-acta.arm-code = buf-grp-acta.arm-code AND
     8503                                          temp-grp-acta.object = buf-grp-acta.object AND
     8504                                          temp-grp-acta.act = buf-grp-acta.act) then do:
     8505                                                      run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПРАВА ДЛЯ ГРУППЫ(grp-acta):" +                                           " АРМ " + buf-grp-acta.arm-code +                                           " группа " + buf-grp-acta.grp-name +                                           " объект " + buf-grp-acta.object +                                           " действие " + buf-grp-acta.act) )) .              delete buf-grp-acta.                   NEXT _rht.
