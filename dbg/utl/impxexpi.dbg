        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: 00d8465b63c9, 1823, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        8   define variable vss-date        as character no-undo init "$Date: Wed Apr 03 10:04:52 2019 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: impxexpi.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/impxexpi.p $":U .
       11   define variable vss-description as character no-undo init "Процедура экспорта локальных таблиц УБД".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable p-rht  as logical no-undo .
       67   define variable p-gen  as logical no-undo .
       68   define variable p-flt  as logical no-undo .
       69   define variable p-pbc  as logical no-undo .
       70   define variable p-scl  as logical no-undo .
       71   define variable p-usr  as logical no-undo .
       72   define variable p-seq  as logical no-undo .
       73   define variable p-cdrg as logical no-undo .
       74   define variable p-cdk as logical no-undo .
       75   define variable p-thb as logical no-undo .
       76   define variable p-pet as logical no-undo .
       77   define variable p-db-key as character no-undo .
       78   define variable p-dir-name as character no-undo .
       79   define variable p-version as character no-undo .
       80   define variable p-glb as logical no-undo .
       81   define variable p-old-host-code as integer no-undo .
       82   define variable p-new-host-code as integer no-undo .
       83   define variable p-old-obj-type as character no-undo .
       84   define variable p-new-obj-type as character no-undo .
       85   define variable p-old-obj-code as integer no-undo .
       86   define variable p-new-obj-code as integer no-undo .
       87   define variable p-from-version as character no-undo .
       88   define variable v-rid as recid no-undo .
       89   define new global shared variable g#language as character no-undo .
       90   if g#language <> '' and g#language <> 'rus':U then do:
       91     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       92   end.
       93   define new global shared variable g#library  as handle no-undo .
       94   define new global shared variable g#library2 as handle no-undo .
       95   define   shared variable g#auto as logical no-undo.
       96   define   shared variable g#news as logical no-undo.
       97   define   shared variable g#oxml as logical no-undo.
       98   define   shared variable g#esys as logical no-undo.
       99   define   shared variable g#news-source-db as integer no-undo.
      100   define   shared variable g#esys-source-esys as integer no-undo.
      101   define   shared variable g#db-num as integer   no-undo .
      102   define   shared variable g#userid as character no-undo .
      103   define   shared variable g#passwd as character no-undo .
      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   function corr-file-name returns character (
      106    input p-file-name as character)
      107    .
      108   DEFINE variable v-corr-file-name as character no-undo.
      109   DEFINE VARIABLE ii as integer no-undo .
      110   DEFINE VARIABLE v-char-name-list as character no-undo .
      111   assign
      112   v-corr-file-name = p-file-name
      113   .
      114   do ii = 1 to length('\/:*?"<>|':U):
      115     assign
      116     v-corr-file-name = replace(
      117                                   v-corr-file-name
      118                                  , substr('\/:*?"<>|':U, ii, 1 )
      119                                  , entry(ii, 'b-slash,slash,colon,star,question,d-quote,d-quote,less-t,great-t,pipe':U)
      120                              )
      121     .
      122   end.
      123   return v-corr-file-name.
      124   end function.
      125   define variable log-file-name as character no-undo init "imp-exp.log".
      126   define variable v-view-log as logical no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define variable v-log-gap as logical no-undo .
      129   define variable v-user-name    as character    no-undo.
      130   define variable v-grp-name    as character    no-undo.
      131   define variable v-arm-code    as character    no-undo.
      132   Procedure check-iefile:
      133   DEFINE INPUT PARAMETER p-dir-name as character no-undo.
      134   DEFINE INPUT PARAMETER p-file-extension as character no-undo.
      135   DEFINE INPUT PARAMETER p-mode as character no-undo.
      136   define output parameter p-ok as logical no-undo.
      137   define variable full_name as character no-undo.
      138   find first ub.sys-ctrl No-LOCK No-ERROR.
      139   if not avail ub.sys-ctrl then do:
      140       run write-log-and-file in p-log-handle (
      141             input 1
      142           , input log-file-name
      143           , input 1
      144           , input substitute( "!!!Отсутствует информация в таблице sys-ctrl"
      145                             )
      146                                             ).
      147       return error.
      148   end.
      149   FIND FIRST ub.db No-LOCK WHERE
      150              ub.db.db-num = ub.sys-ctrl.db-num NO-ERROR.
      151   if not avail ub.db then do:
      152       run write-log-and-file in p-log-handle (
      153             input 1
      154           , input log-file-name
      155           , input 1
      156           , input substitute( "!!!Отсутствует информация в таблице db"
      157                             )
      158                                             ).
      159       return error.
      160   end.
      161   full_name = p-dir-name + "\":U + corr-file-name(string(ub.db.db-key)) + "." + p-file-extension.
      162   if p-mode = "import":U then do:
      163       if search(full_name) = ? then do:
      164         run write-log-and-file in p-log-handle (
      165               input 1
      166             , input log-file-name
      167             , input 1
      168             , input substitute( "!!!Не найден файл данных &1", full_name
      169                               )
      170                                               ).
      171           p-ok = no.
      172           return.
      173       end.
      174       p-ok = yes.
      175       return.
      176   end.
      177   if p-mode = "export":U then do:
      178       if search(full_name) <> ? then do:
      179       message substitute("Уже имеется в выбранной директории файл с именем &1&2" +
      180                          "совпадающим с именем одного из файлов экспорта&2" +
      181                          "Перезаписывать?"
      182                          ,full_name
      183                          , chr(10))
      184       view-as alert-box QUESTION buttons YES-NO update p-ok.
      185       return.
      186     end.
      187     p-ok = yes.
      188     return.
      189   end.
      190   END PROCEDURE.
      191   function diff-list returns character (
      192     input parfirst-list  as character,
      193     input parsecond-list as character,
      194     input pardelim       as character).
      195     if pardelim = ""
      196     or pardelim = ?
      197     then do:
      198       assign
      199         pardelim = ","
      200       .
      201     end.
      202     def var ind as integer no-undo .
      203     def var v-elem as character no-undo .
      204     def var v-result-list as character no-undo init "".
      205     def var v-num-parfirst-list as integer no-undo .
      206     assign
      207       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      208     .
      209     do ind = 1 to v-num-parfirst-list
      210     :
      211       assign
      212         v-elem = entry(ind, parfirst-list, pardelim)
      213       .
      214       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      215         assign
      216           v-result-list = v-result-list
      217                         + (if v-result-list > "" then pardelim else "")
      218                         + v-elem
      219         .
      220       end.
      221     end.
      222     return v-result-list .
      223   end function.
      224   function add-list returns character (
      225    input parfirst-list  as character,
      226    input parsecond-list as character,
      227    input pardelim       as character).
      228     if pardelim = ""
      229     or pardelim = ?
      230     then do:
      231       assign
      232         pardelim = ","
      233       .
      234     end.
      235     def var ind as integer no-undo .
      236     def var v-elem as character no-undo .
      237     def var v-result-list as character no-undo init "".
      238     def var v-num-parfirst-list as integer no-undo .
      239     assign
      240       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      241     .
      242     do ind = 1 to v-num-parfirst-list
      243     :
      244       assign
      245         v-elem = entry(ind, parfirst-list, pardelim)
      246       .
      247       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      248         assign
      249           v-result-list = v-result-list
      250                         + (if v-result-list > "" then pardelim else "")
      251                         + v-elem
      252         .
      253       end.
      254     end.
      255     def var v-num-parsecond-list as integer no-undo .
      256     assign
      257       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      258     .
      259     do ind = 1 to v-num-parsecond-list
      260     :
      261       assign
      262         v-elem = entry(ind, parsecond-list, pardelim)
      263       .
      264       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      265         assign
      266           v-result-list = v-result-list
      267                         + (if v-result-list > "" then pardelim else "")
      268                         + v-elem
      269         .
      270       end.
      271     end.
      272     return v-result-list .
      273   end function.
      274   function cross-list returns character (
      275    input parfirst-list  as character,
      276    input parsecond-list as character,
      277    input pardelim       as character).
      278     if pardelim = ""
      279     or pardelim = ?
      280     then do:
      281       assign
      282         pardelim = ","
      283       .
      284     end.
      285     def var ind as integer no-undo .
      286     def var v-elem as character no-undo .
      287     def var v-result-list as character no-undo init "".
      288     def var v-num-parfirst-list as integer no-undo .
      289     assign
      290       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      291     .
      292     do ind = 1 to v-num-parfirst-list
      293     :
      294       assign
      295         v-elem = entry(ind, parfirst-list, pardelim)
      296       .
      297       if lookup(v-elem, v-result-list, pardelim) = 0
      298       and lookup(v-elem, parsecond-list, pardelim) > 0
      299       then do:
      300         assign
      301           v-result-list = v-result-list
      302                         + (if v-result-list > "" then pardelim else "")
      303                         + v-elem
      304         .
      305       end.
      306     end.
      307     return v-result-list .
      308   end function.
      309   function radio-label returns character (
      310    input par-rs-value  as character,
      311    input par-rs-radio-buttons as character)
      312    .
      313    DEFINE variable v-result-label as character no-undo.
      314    assign
      315    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      316                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      317                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      318                             ), par-rs-radio-buttons
      319                           )
      320    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      321    .
      322   return v-result-label.
      323   end function.
      324   function m-radio-label returns character (
      325    input par-rs-value  as character,
      326    input par-rs-radio-buttons as character,
      327    input par-delim as character
      328    )
      329    .
      330    DEFINE variable v-result-label as character no-undo.
      331    assign
      332    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      333                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      334                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      335                             ), par-rs-radio-buttons, par-delim
      336                           )
      337    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      338    .
      339   return v-result-label.
      340   end function.
      341   FUNCTION mixlist returns character
      342   (
      343    input parfirst-list  as character
      344    ,input parsecond-list as character
      345    ,input pardelim       as character
      346    ,input pardelim-result as character ) :
      347     if pardelim = ""
      348     or pardelim = ?
      349     then do:
      350       assign
      351         pardelim = ","
      352       .
      353     end.
      354     def var ind as integer no-undo .
      355     def var v-elem1 as character no-undo .
      356     def var v-elem2 as character no-undo .
      357     def var v-result-list as character no-undo init "".
      358     do ind = 1 to num-entries(parfirst-list, pardelim)
      359     :
      360       assign
      361         v-elem1 = entry(ind, parfirst-list, pardelim)
      362         v-elem2 = entry(ind, parsecond-list, pardelim)
      363       .
      364         assign
      365           v-result-list = v-result-list
      366                         + (if v-result-list > "" then pardelim-result else "")
      367                         + v-elem1 + pardelim-result + v-elem2
      368         .
      369     end.
      370     return v-result-list .
      371   END FUNCTION.
      372   define stream getmc-stream .
      373   procedure get-max-code :
      374     define input  parameter p-action         as   character                 no-undo .
      375     define input  parameter p-db-num         like ub.db.db-num             no-undo .
      376     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
      377     define input  parameter p-first-code     like ub.code-range.first-code no-undo .
      378     define input  parameter p-last-code      like ub.code-range.last-code  no-undo .
      379     define input  parameter p-view-mess      as   logical                   no-undo .
      380     define output parameter v-b-code         as   integer                   no-undo .
      381     do
      382     on error undo, return error return-value
      383     :
      384       define variable v-main-bcode     like ub.bar-code.b-code no-undo .
      385       define variable l-prod-bc-global as   logical             no-undo .
      386       define variable l-prod-bc-weight as   logical             no-undo .
      387       define variable l-prod-bc-pgweight as   logical             no-undo .
      388       define variable rec-cnt          as   integer             no-undo .
      389       define variable str-u-f          as   character           no-undo .
      390       define variable str-u-f-rng      as   character           no-undo .
      391       define variable ind              as   integer             no-undo .
      392       define variable v-msg              as   character           no-undo initial "":U.
      393       define variable v-ret-msg          as   character           no-undo initial "":U.
      394       define frame get-max-code-inf
      395         rec-cnt label "Просмотрено"
      396         with view-as dialog-box side-labels row 11 centered
      397         title "..........................................." three-d
      398       .
      399       define buffer buf_code-range   for ub.code-range .
      400       define buffer buf-c_code-range for ub.code-range .
      401       define buffer buf_bar-code     for ub.bar-code .
      402       define buffer buf_place        for ub.place .
      403       define buffer buf_goods        for ub.goods .
      404       define buffer buf_units        for ub.units .
      405       define buffer buf_prod-bc      for ub.prod-bc .
      406       define buffer buf_dis-card     for ub.dis-card .
      407       define buffer buf_dis-rule     for ub.dis-rule .
      408       define buffer buf_dis-time-rule     for ub.dis-time-rule .
      409       define buffer buf_firm         for ub.firm .
      410       define buffer buf_person       for ub.person .
      411       define buffer buf_contract     for ub.contract .
      412       if p-curr-type-cdrg = 'sslc':U
      413       or p-curr-type-cdrg = 'ssgb':U
      414       then do:
      415         assign
      416           v-b-code = ?
      417         .
      418         return.
      419       end.
      420       if p-curr-type-cdrg = 'sclc':U
      421       or p-curr-type-cdrg = 'pglc':U
      422         or p-curr-type-cdrg = 'sslc':U
      423       then do:
      424         assign
      425           p-db-num = 0
      426         .
      427       end.
      428       case p-action :
      429         when "get-m-code":U then do:
      430           assign
      431             v-b-code = p-first-code
      432           .
      433         end.
      434         when "f-u":U then do:
      435           assign
      436             v-b-code = 0
      437           .
      438         end.
      439       end case.
      440       case p-curr-type-cdrg :
      441         when 'dcgb':U then do:
      442   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   define variable v-ii2 as integer   no-undo .
      444   define variable v-table-name2 as character no-undo .
      445   define variable v-field-name2 as character no-undo .
      446   define variable buf_h2 as handle no-undo .
      447   define variable q_h2 as handle no-undo .
      448   define variable v-avail2 as integer   no-undo .
      449   define variable v-code-mess2 as character no-undo .
      450   define variable glog2 as logical   no-undo .
      451   define variable v-code_2 as integer   no-undo .
      452   case p-action :
      453     when "get-m-code":U then do:
      454       do v-ii2 = 1 to num-entries('ub.dis-card'):
      455         assign
      456         v-table-name2 = entry(v-ii2, 'ub.dis-card')
      457         v-field-name2 = entry(v-ii2, 'card-num')
      458         .
      459         create buffer buf_h2 for table v-table-name2.
      460         create query q_h2.
      461         q_h2:SET-BUFFERS(buf_h2).
      462         q_h2:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      463                           ,v-table-name2
      464                           ,v-field-name2
      465                           ,p-first-code
      466                           ,p-last-code)
      467                           ).
      468         q_h2:QUERY-OPEN.
      469         REPEAT while  q_h2:get-next().
      470           assign
      471             v-code_2 = buf_h2:buffer-field(v-field-name2):buffer-value
      472           .
      473           leave .
      474         END.
      475         q_h2:QUERY-CLOSE().
      476         delete object q_h2.
      477         delete object buf_h2.
      478         v-b-code = max(v-code_2, v-b-code).
      479       end.
      480     end.
      481     when "f-u":U then do:
      482       for each buf_code-range share-lock
      483           where ( buf_code-range.range-type = p-curr-type-cdrg
      484                   and buf_code-range.db-num = p-db-num
      485                   and buf_code-range.stts = "f":U
      486                 ) or
      487                 ( buf_code-range.range-type = p-curr-type-cdrg
      488                   and buf_code-range.db-num = p-db-num
      489                   and buf_code-range.stts = "u":U
      490                 )
      491       on error undo, return error
      492       :
      493         v-avail2 = 0.
      494         do v-ii2 = 1 to num-entries('ub.dis-card'):
      495           assign
      496           v-table-name2 = entry(v-ii2, 'ub.dis-card')
      497           v-field-name2 = entry(v-ii2, 'card-num')
      498           .
      499           create buffer buf_h2 for table v-table-name2.
      500           glog2 = buf_h2:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      501                                   , v-table-name2
      502                                   , v-field-name2
      503                                   , buf_code-range.first-code
      504                                   , buf_code-range.last-code)
      505                                   ) no-error .
      506           if buf_h2:available then do:
      507             assign
      508             v-avail2 = v-avail2 + 1
      509             .
      510             if v-avail2 = 1 then do:
      511               v-code-mess2 = string(buf_h2:buffer-field(v-field-name2):buffer-value)
      512               .
      513             end.
      514           end.
      515           delete object buf_h2.
      516        end.
      517        if v-avail2 > 0
      518           and buf_code-range.stts = "f":U
      519         then do:
      520           assign
      521             buf_code-range.stts = "u":U
      522             v-b-code            = v-b-code + 1
      523             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      524                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
      525                                               , chr(10)
      526                                               , buf_code-range.first-code
      527                                               , buf_code-range.last-code
      528                                               , v-code-mess2
      529                                             )
      530           .
      531           if p-view-mess = true then do:
      532             message
      533               v-msg
      534               view-as alert-box information.
      535           end.
      536           else do:
      537             output stream getmc-stream to "getmc.log" append.
      538             put stream getmc-stream unformatted
