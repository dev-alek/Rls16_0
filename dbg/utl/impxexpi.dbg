     7367       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ПАРАМЕТРЫ" ) ).
     7368       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "thb":U).
     7369       _thb:
     7370       REPEAT:
     7371         import stream Instream unformatted ss.
