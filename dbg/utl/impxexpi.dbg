     8249                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pet.                   end.
