     6086                  ub.pump.pump-code = temp-pl-gds-pump.pump-code
     6087                  NO-ERROR.
     6088       IF not AVAILABLE ub.pump then do:
     6089                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + " Не найдено ТРК для ПРИВЯЗКИ ТОВАРА К СКЛ.МЕСТУ и ТРК(pl-gds-pump):" +                          " код товара " + string(temp-pl-gds-pump.gds-code)  + " код скл.места " + string(temp-pl-gds-pump.pl-code) + " код ТРК " + string(temp-pl-gds-pump.pump-code )) )) .              delete temp-pl-gds-pump.                   NEXT _pl-gds-pumpv.
     6090       end.
