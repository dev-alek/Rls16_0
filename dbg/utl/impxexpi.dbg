     6092                  ub.pl-gds-pump.obj-type = temp-pl-gds-pump.obj-type  AND
     6093                  ub.pl-gds-pump.obj-code = temp-pl-gds-pump.obj-code  AND
     6094                  ub.pl-gds-pump.gds-code = temp-pl-gds-pump.gds-code  AND
     6095                  ub.pl-gds-pump.pl-code = temp-pl-gds-pump.pl-code AND
     6096                  ub.pl-gds-pump.pump-code = temp-pl-gds-pump.pump-code
     6097                  NO-ERROR.
     6098       IF not AVAILABLE ub.pl-gds-pump then do:
     6099         create ub.pl-gds-pump.
     6100       end.
     6101       buffer-copy temp-pl-gds-pump to ub.pl-gds-pump.
     6102       release ub.pl-gds-pump no-error.
     6103       if error-status:error then do:
