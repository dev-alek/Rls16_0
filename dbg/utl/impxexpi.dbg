     4981   DEFINE VARIABLE  hnum as logical no-undo init no.
     4982   DEFINE VARIABLE  b-hnum as logical no-undo init no.
     4983   DEFINE VARIABLE  conf-par as char no-undo.
     4984   DEFINE VARIABLE  par-type as char no-undo.
     4985   DEFINE VARIABLE jj as integer no-undo .
     4986   DEFINE VARIABLE er-mes as character no-undo .
     4987   DEFINE VARIABLE v-b-code as integer no-undo .
     4988   define variable v-pbc-rid as recid no-undo .
     4989   define variable v-b-str as character no-undo .
     4990   define variable v-cdrg-type as character no-undo .
     4991   define variable v-mode as character no-undo .
     4992   define variable v-classif-name as character no-undo .
     4993   define variable v-cli-classif-name as character no-undo .
     4994   define buffer cli_units for ub.units.
     4995   define buffer buf_code-range for ub.code-range.
