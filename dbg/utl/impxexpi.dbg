     6860            _user-login:
     6861            for each buf_user-login no-lock
     6862            on error undo, return error return-value
     6863            :
     6864               _usr-grpa:
     6865               for each  temp-usr-grpa no-lock
     6866                   where temp-usr-grpa.user-name = buf_user-login.user-login
     6867               on error undo, return error return-value
     6868               :
     6869                  IF lookup( temp-usr-grpa.arm-code, v-arm-code-list) > 0 then do:
     6870                  assign
     6871                     v-menu-group-id = entry( lookup( temp-usr-grpa.arm-code, v-arm-code-list), v-menu-group-id-list)
     6872                  .
     6873                  end.
     6874                  else do:
     6875                     next _usr-grpa.
     6876                  end.
     6877                  FIND FIRST buf_menu-group
     6878                       where buf_menu-group.menu-code     = 0
     6879                         AND buf_menu-group.menu-group-id = v-menu-group-id
     6880                       no-lock
     6881                       no-error
     6882                       .
     6883                  IF NOT AVAILABLE buf_menu-group
     6884                  THEN DO:
     6885                     next _usr-grpa.
     6886                  END.
     6887                  find first buf_user-menu-group
     6888                  where buf_user-menu-group.db-num          = g#db-num
     6889                     and buf_user-menu-group.user-id         = buf_user-login.user-id
     6890                     and buf_user-menu-group.menu-code       = 0
     6891                     and buf_user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     6892                     and buf_user-menu-group.menu-group-context = 'firm':U
     6893                     and buf_user-menu-group.host-code       = temp-usr-grpa.host-code
     6894                     and buf_user-menu-group.obj-type        = "":U
     6895                     and buf_user-menu-group.obj-code        = 0
     6896                     and buf_user-menu-group.menu-group-id   = v-menu-group-id
     6897                  no-error .
     6898                  if not available buf_user-menu-group then do:
     6899                     ASSIGN
     6900                        v-user-menu-group-code = dynamic-next-value("s-user-menu-group":U, "ub":U)
     6901                     .
     6902                     create buf_user-menu-group.
     6903                     assign
     6904                        buf_user-menu-group.db-num        = g#db-num
     6905                        buf_user-menu-group.user-id       = buf_user-login.user-id
     6906                        buf_user-menu-group.menu-code     = 0
     6907                        buf_user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     6908                        buf_user-menu-group.menu-group-id = v-menu-group-id
     6909                        buf_user-menu-group.menu-group-context       = 'firm':U
     6910                        buf_user-menu-group.user-menu-group-code      = v-user-menu-group-code
     6911                        buf_user-menu-group.host-code     = temp-usr-grpa.host-code
     6912                        buf_user-menu-group.obj-type      = "":U
     6913                        buf_user-menu-group.obj-code      = 0
     6914                     .
     6915                     for each temp-usr-grpo no-lock
     6916                        where temp-usr-grpo.user-name = buf_user-login.user-login
     6917                     on error undo, return error return-value
     6918                     :
     6919                        find first buf_clients no-lock
     6920                           where buf_clients.obj-type   = temp-usr-grpo.obj-type
     6921                              and buf_clients.obj-code  = temp-usr-grpo.obj-code
     6922                              and buf_clients.host-code = temp-usr-grpa.host-code
     6923                           no-error .
     6924                        find first buf_user-menu-group
     6925                           where buf_user-menu-group.db-num          = g#db-num
     6926                              and buf_user-menu-group.user-id         = buf_user-login.user-id
     6927                              and buf_user-menu-group.menu-code       = 0
     6928                              and buf_user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     6929                              and buf_user-menu-group.menu-group-context = 'object':U
     6930                              and buf_user-menu-group.host-code       = temp-usr-grpa.host-code
     6931                              and buf_user-menu-group.obj-type        = temp-usr-grpo.obj-type
     6932                              and buf_user-menu-group.obj-code        = temp-usr-grpo.obj-code
     6933                              and buf_user-menu-group.menu-group-id   = v-menu-group-id
     6934                           no-error .
     6935                        if  available buf_clients
     6936                        and not available buf_user-menu-group
     6937                        then DO:
     6938                           ASSIGN
     6939                              v-user-menu-group-code = dynamic-next-value("s-user-menu-group":U, "ub":U)
     6940                           .
     6941                           create buf_user-menu-group.
     6942                           assign
