     3892   procedure cd-attr-write :
     3893     define input parameter p-db-num    like ub.cash-desk-attr.db-num     no-undo .
     3894     define input parameter p-obj-code  like ub.cash-desk-attr.obj-code   no-undo .
     3895     define input parameter p-pos-type  like ub.cash-desk-attr.pos-type   no-undo .
     3896     define input parameter p-cash-num  like ub.cash-desk-attr.cash-num   no-undo .
     3897     define input parameter p-ucode     like ub.cash-desk-attr.upper-attr-code  no-undo .
     3898     define input parameter p-code      like ub.cash-desk-attr.attr-code  no-undo .
     3899     define input parameter p-character like ub.cash-desk-attr.attr-value-character no-undo .
     3900     define input parameter p-date      like ub.cash-desk-attr.attr-value-date      no-undo .
     3901     define input parameter p-decimal   like ub.cash-desk-attr.attr-value-decimal   no-undo .
     3902     define input parameter p-integer   like ub.cash-desk-attr.attr-value-integer   no-undo .
     3903     define input parameter p-logical   like ub.cash-desk-attr.attr-value-logical   no-undo .
     3904     do
     3905     on error undo, return error return-value
     3906     :
     3907           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-write in g#attr-lib
     3908         (input p-db-num
     3909         ,input p-obj-code
     3910         ,input p-pos-type
     3911         ,input p-cash-num
     3912         ,input p-ucode
     3913         ,input p-code
