     5727                  ub.bar-code.b-code = temp-scales-gds.b-code No-ERROR.
     5728       IF NOT AVAIL ub.bar-code then do:
     5729                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Не найден БАРКОД для ТОВАРА НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-gds.scales-num) +                         " баркод " + string(temp-scales-gds.b-code)) )) .              delete temp-scales-gds.                   NEXT _scales-gdsv.
     5730       END.
     5731       FIND FIRST ub.goods No-LOCK WHERE
     5732                  ub.goods.gds-code = ub.bar-code.gds-code NO-ERROR.
     5733       IF NOT AVAILABLE ub.goods then do:
     5734                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Не найден ТОВАР для ТОВАРА НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-gds.scales-num) +                         " баркод " + string(temp-scales-gds.b-code)) )) .              delete temp-scales-gds.                   NEXT _scales-gdsv.
     5735       END.
     5736       FIND FIRST ub.units No-LOCK WHERE
     5737                  ub.units.unit-name = ub.goods.unit-base No-ERROR.
     5738       IF NOT AVAIL ub.units then do:
     5739                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Не найдена ЕДИНИЦА ИЗМЕРЕНИЯ для ТОВАРА НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-gds.scales-num) +                         " баркод " + string(temp-scales-gds.b-code)) )) .              delete temp-scales-gds.                   NEXT _scales-gdsv.
     5740       END.
     5741       if ub.units.unit-name <> scales-unit
     5742       and ub.units.type = 'вес':U
     5743       then do:
     5744                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " ЕДИНИЦА ИЗМЕРЕНИЯ ТОВАРА НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-gds.scales-num) +                         " баркод " + string(temp-scales-gds.b-code) +                         " единица измерения товара " + ub.units.unit-name +                         " единица измерения весов " + scales-unit ) )) .              delete temp-scales-gds.                   NEXT _scales-gdsv.
     5745       END.
     5746       FIND FIRST ub.gds-prt No-LOCK WHERE
     5747                  ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
     5748       IF NOT AVAIL(ub.gds-prt) then do:
     5749                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Не найдена ШКАЛА ПРИЗНАКОВ(пустая шкала) для ТОВАРА НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-gds.scales-num) +                         " баркод " + string(temp-scales-gds.b-code)) )) .              delete temp-scales-gds.                   NEXT _scales-gdsv.
     5750       END.
     5751       if ub.bar-code.node-code <> ub.gds-prt.node-code OR
     5752         ub.bar-code.in-code <> "":U OR
     5753         ub.bar-code.part-code <> "":U OR
     5754         ub.bar-code.unit-cli <> ub.goods.unit-base then do:
     5755                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Баркод не является главным баркодом товара для ТОВАРА НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-gds.scales-num) +                         " баркод " + string(temp-scales-gds.b-code)) )) .              delete temp-scales-gds.                   NEXT _scales-gdsv.
     5756       END.
     5757       run create-scales-gds in this-procedure (
     5758                                                 buffer ub.bar-code
     5759                                                ,buffer ub.scales
     5760                                                ,buffer ub.goods
     5761                                                ,buffer temp-scales-gds
     5762                                                ) no-error .
     5763       if error-status:error then dO:
     5764                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Ошибка при создании ТОВАРА НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-gds.scales-num) +                         " баркод " + string(temp-scales-gds.b-code) +                         return-value) )) .              delete temp-scales-gds.                   NEXT _scales-gdsv.
     5765       end.
     5766       FIND LAST scales-gds WHERE
     5767                  scales-gds.db-num = g#db-num
     5768            AND scales-gds.scales-num = ub.scales.scales-num NO-LOCK use-index pi no-error .
     5769       if available scales-gds and ub.scales.max-plu < ub.scales-gds.PLU-code then
     5770       ub.scales.max-plu = scales-gds.PLU-code .
     5771     END.
     5772         _scales-grpv:
     5773       FOR EACH temp-scales-grp:
     5774       assign
     5775       dopi = temp-scales-grp.scales-num
     5776       .
     5777       FIND FIRST ub.scales  NO-LOCK where
     5778                  ub.scales.db-num = g#db-num AND
     5779                  ub.scales.scales-num = dopi NO-ERROR.
     5780       IF NOT AVAIL ub.scales then do:
     5781         FIND FIRST temp-scales NO-LOCK WHERE
     5782                    temp-scales.db-num = g#db-num
     5783               AND temp-scales.scales-num = dopi No-ERROR.
     5784         IF NOT AVAIL temp-scales then do:
     5785                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Не найдены ВЕСЫ для ГРУППЫ ТОВАРОВ НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-grp.scales-num) +                         " код группы " + string(temp-scales-grp.node-code)) )) .              delete temp-scales-grp.                   NEXT _scales-grpv.
     5786         END.
     5787       END.
     5788       FIND FIRST ub.Scales-grp No-LOCK WHERE
     5789                 ub.scales-grp.db-num = temp-scales-grp.db-num AND
     5790                 ub.scales-grp.scales-num = temp-scales-grp.scales-num AND
     5791                 ub.scales-grp.node-code = temp-scales-grp.node-code NO-ERROR.
     5792       IF  AVAILABLE ub.scales-grp then do:
     5793                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Уже есть ГРУППА ТОВАРА НА ВЕСАХ(scales-grp):" +                           " номер группы " + string(temp-scales-grp.node-code) +                           " номер весов " + string(temp-scales-grp.scales-num)) )) .              delete temp-scales-grp.                   NEXT _scales-grpv.
     5794       end.
     5795       dopi = 0.
     5796       FIND FIRST ub.gds-grp No-LOCK WHERE
     5797                  ub.gds-grp.node-code = temp-scales-grp.node-code No-ERROR.
     5798       if avail ub.gds-grp then dopi = ub.gds-grp.node-code.
     5799       IF dopi = 0 or (CAN-find(FIRST ub.gds-grp NO-LOCK WHERE
     5800                                      ub.gds-grp.upper-code = dopi)) then do:
     5801               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Не найдена ГРУППА ТОВАРОВ или нетерминальная для ГРУППЫ ТОВАРОВ НА ВЕСАХ(scales-grp):" +                       " номер группы " + string(temp-scales-grp.node-code) +                       " номер весов " + string(temp-scales-grp.scales-num)) )) .              delete temp-scales-grp.                   NEXT _scales-grpv.
     5802       END.
     5803       create ub.scales-grp.
     5804       buffer-copy temp-scales-grp to ub.scales-grp.
     5805       release ub.scales-grp no-error.
     5806       if error-status:error then do:
     5807         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     5808               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) +  " ошибка при сохранении записи ГРУППА ТОВАРОВ НА ВЕСАХ(scales-grp):" +                                       " номер группы " + string(temp-scales-grp.node-code) +                                       " номер весов " + string(temp-scales-grp.scales-num) +                                       er-mes) )) .                NEXT _scales-grpv.
     5809       end.
     5810     END.
     5811   end.
     5812   if p-cdk then do:
     5813           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных КАССЫ" ) ).
     5814         _cash-deskv:
     5815     FOR EACH temp-cash-desk:
     5816       FIND FIRST ub.cash-desk No-LOCK WHERE
     5817                  ub.cash-desk.db-num = temp-cash-desk.db-num  AND
     5818                  ub.cash-desk.obj-code = temp-cash-desk.obj-code  AND
