     8302                                   )
     8303                                   then do:
     8304                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных КОНФИГУРАЦИЯ АЗК, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПРИВЯЗКА ТРК К ПИСТОЛЕТУ(pump-nozzle):" +                                   " пистолет " + string(buf-pump-nozzle.nozzle-code) +                                   " ТРК " + string(buf-pump-nozzle.pump-code) + " на " + buf-pump-nozzle.obj-type + string(buf-pump-nozzle.obj-code)) )) .              delete buf-pump-nozzle.                   NEXT _pet.
     8305                 end.
     8306                 create temp-pump-nozzle.
     8307                 buffer-copy buf-pump-nozzle to temp-pump-nozzle
     8308                 .
     8309                 delete buf-pump-nozzle.
     8310               end.
     8311             end case.
     8312           end.
     8313           when 'pl-pump-nozzle':U then do:
     8314             current-table = ss.
