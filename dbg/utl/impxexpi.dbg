     6789                  v-cntxt-host-code-obj = buf_clients.host-code
     6790                  v-cntxt-obj-type      = buf_clients.obj-type
     6791                  v-cntxt-obj-code      = buf_clients.obj-code
     6792                  .
     6793               end.
     6794               else do:
     6795                  find first buf_clients
     6796                       where buf_clients.obj-type = 'орг':U
     6797                         and buf_clients.obj-code = temp-userconf.arm-host-code
     6798                       no-lock
     6799                       no-error
     6800                       .
     6801                  if available buf_clients
     6802                  then do:
     6803                  assign
     6804                     v-cntxt-level         = 'firm':U
     6805                     v-cntxt-host-code-obj = buf_clients.host-code
     6806                     v-cntxt-obj-type      = buf_clients.obj-type
     6807                     v-cntxt-obj-code      = buf_clients.obj-code
     6808                  .
     6809                  end.
