     8553                     then do:
     8554                        current-table = ss.
     8555                        case current-table:
     8556                           when "user-account":U then do:
     8557                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8558                              create buf-user-account.
     8559                              v-curr-seek = seek(instream).
     8560                              import stream Instream buf-user-account.user-id                                  buf-user-account.status_                                  buf-user-account.first-name                                  buf-user-account.second-name                                  buf-user-account.last-name                                  buf-user-account.company                                  buf-user-account.department                                  buf-user-account.e-mail                                  buf-user-account.internal-phone-number                                  buf-user-account.mobile-phone-number                                  buf-user-account.phone-number                                  buf-user-account.position                                  buf-user-account.PS                                  buf-user-account.room                                  buf-user-account.parent-user-id                                  buf-user-account.check-parent                                  buf-user-account.nik no-error.
     8561                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _usr.                   end.
     8562                                                         buf-user-account.user-id = substitute("&1-&2"
     8563                                                                    ,g#db-num
     8564                                                                    , entry(2, buf-user-account.user-id, "-")).
     8565                              IF CAN-FIND(FIRST temp-user-account No-LOCK WHERE
     8566                                                temp-user-account.user-id = buf-user-account.user-id) then do:
     8567                                                                     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПОЛЬЗОВАТЕЛЬ(user-account): " + buf-user-account.user-id) )) .              delete buf-user-account.                   NEXT _usr.
     8568                              end.
     8569                              create temp-user-account.
     8570                              buffer-copy
     8571                              buf-user-account to temp-user-account.
     8572                              delete buf-user-account.
     8573                           end.
     8574                           when "user-login":U then do:
     8575                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
