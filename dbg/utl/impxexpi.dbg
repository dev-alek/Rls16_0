     6228                      and ub.action-role-item.action-role-code = temp-action-role-item.action-role-code
     6229                      and ub.action-role-item.action-role-item-code = temp-action-role-item.action-role-item-code
     6230                    NO-ERROR
     6231                    .
     6232               IF AVAILABLE ub.action-role-item then do:
     6233                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) + " Уже есть привязка к ГРУППЕ ПРАВ (action-role-item):"                                             + STRING(temp-action-role-item.db-num)                                             + STRING(temp-action-role-item.action-head-code)                                             + STRING(temp-action-role-item.action-role-code)                                             + STRING(temp-action-role-item.action-role-item-code)                                             ) )) .              delete temp-action-role-item.                   NEXT _action-role-item.
     6234               END.
     6235               create ub.action-role-item.
     6236               buffer-copy temp-action-role-item to ub.action-role-item.
     6237               release ub.action-role-item No-error.
     6238               if error-status:error then do:
     6239                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     6240                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) +  " ошибка при сохранении привязки к ГРУППЕ ПРАВ (action-role-item):"                                             + STRING(temp-action-role-item.db-num)                                             + STRING(temp-action-role-item.action-head-code)                                             + STRING(temp-action-role-item.action-role-code)                                             + STRING(temp-action-role-item.action-role-item-code)                                             ) )) .                NEXT _action-role-item.
     6241               end.
     6242            END.
     6243            create alias restseq    for database value( ldbname( "ub":U ) ) .
     6244            create alias restseqflt for database value( ldbname( "ubflt":U ) ) .
     6245            run adm/restseq.p
     6246              ( input "rest":U
     6247              , input "s-action-role-item":U
     6248              , input no
     6249              ) no-error .
     6250            if error-status :error then do:
     6251              delete alias restseqflt.
     6252              delete alias restseq.
     6253              return error return-value .
     6254            end.
     6255            delete alias restseqflt.
     6256            delete alias restseq.
     6257         end.
     6258         otherwise do:
     6259            define variable v-global-action-role-code     as integer   no-undo .
     6260            define variable v-firm-action-role-code       as integer   no-undo .
     6261            define variable v-object-action-role-code     as integer   no-undo .
     6262            define variable v-action-role-code            as integer   no-undo .
     6263            define variable v-action-role-item-code       as integer   no-undo .
     6264            define buffer buf_action-role       for ub.action-role .
     6265            define buffer buf_action-role-item  for ub.action-role-item .
     6266            run p-right-i in this-procedure .
     6267            _gpr:
     6268            for each temp-grpa no-lock
     6269            on error undo, return error return-value
     6270            :
     6271               assign
     6272                  v-global-action-role-code = 0
     6273                  v-firm-action-role-code   = 0
     6274                  v-object-action-role-code = 0
     6275               .
     6276               for each temp-grp-acta no-lock
     6277                  where temp-grp-acta.grp-name = temp-grpa.grp-name
     6278                  and temp-grp-acta.arm-code = temp-grpa.arm-code
     6279               on error undo, return error return-value
     6280               :
     6281                  find first temp-action-item
     6282                  where temp-action-item.grp-acta-arm-code = temp-grp-acta.arm-code
     6283                     and temp-action-item.grp-acta-object   = temp-grp-acta.object
     6284                     and temp-action-item.grp-acta-act      = temp-grp-acta.act
     6285                  no-error .
     6286                  if not available temp-action-item
     6287                  then do:
     6288                  end.
     6289                  else do:
     6290                  case temp-action-item.action-context
     6291                  :
     6292                     when 'global':U
     6293                     then do:
     6294                        if v-global-action-role-code = 0
     6295                        then do:
     6296                           IF NOT CAN-FIND ( FIRST buf_action-role
     6297                                             WHERE buf_action-role.db-num            = g#db-num
     6298                                             and buf_action-role.action-head-code    = 0
     6299                                             and buf_action-role.action-role-context = 'global':U
     6300                                             and buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     6301                                          )
     6302                           THEN DO:
     6303                              assign
     6304                                 v-action-role-code = dynamic-next-value("s-action-role":U, "ub":U)
     6305                              .
     6306                              create buf_action-role .
     6307                              assign
     6308                                 buf_action-role.db-num              = g#db-num
     6309                                 buf_action-role.action-head-code    = 0
     6310                                 buf_action-role.action-role-code    = v-action-role-code
     6311                                 buf_action-role.action-role-context = temp-action-item.action-context
     6312                                 buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     6313                              .
     6314                              assign
     6315                                 v-global-action-role-code = v-action-role-code
     6316                              .
     6317                           END.
     6318                        end.
     6319                        IF NOT CAN-FIND ( FIRST buf_action-role-item
     6320                                          WHERE buf_action-role-item.db-num              = g#db-num
     6321                                            and buf_action-role-item.action-head-code    = 0
     6322                                            and buf_action-role-item.action-role-code    = v-global-action-role-code
     6323                                            and buf_action-role-item.action-item-id      = temp-action-item.action-item-id
     6324                                        )
     6325                        THEN DO:
     6326                           assign
     6327                              v-action-role-item-code = dynamic-next-value("s-action-role-item":U, "ub":U)
     6328                           .
     6329                           create buf_action-role-item .
     6330                           assign
     6331                              buf_action-role-item.db-num                = g#db-num
     6332                              buf_action-role-item.action-head-code      = 0
     6333                              buf_action-role-item.action-role-code      = v-global-action-role-code
     6334                              buf_action-role-item.action-role-item-code = v-action-role-item-code
     6335                              buf_action-role-item.action-item-id        = temp-action-item.action-item-id
     6336                           .
     6337                           find first buf_action-item
     6338                              where buf_action-item.action-head-code = buf_action-role-item.action-head-code
     6339                                 and buf_action-item.action-item-id  = buf_action-role-item.action-item-id
     6340                              no-lock
     6341                              no-error
     6342                              .
     6343                           if available buf_action-item then do:
     6344                              assign
     6345                                 buf_action-role-item.action-item-code = buf_action-item.action-item-code
     6346                              .
     6347                           end.
     6348                        end.
     6349                     end.
     6350                     when 'firm':U
     6351                     then do:
     6352                        if v-firm-action-role-code = 0
     6353                        then do:
     6354                           assign
     6355                              v-action-role-code = dynamic-next-value("s-action-role":U, "ub":U)
     6356                           .
     6357                           create buf_action-role .
     6358                           assign
     6359                              buf_action-role.db-num              = g#db-num
     6360                              buf_action-role.action-head-code    = 0
     6361                              buf_action-role.action-role-code    = v-action-role-code
     6362                              buf_action-role.action-role-context = temp-action-item.action-context
     6363                              buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     6364                           .
     6365                           assign
     6366                              v-firm-action-role-code = v-action-role-code
     6367                           .
     6368                           end.
     6369                           assign
     6370                              v-action-role-item-code = dynamic-next-value("s-action-role-item":U, "ub":U)
     6371                           .
     6372                           create buf_action-role-item .
     6373                           assign
     6374                              buf_action-role-item.db-num                = g#db-num
     6375                              buf_action-role-item.action-head-code      = 0
     6376                              buf_action-role-item.action-role-code      = v-firm-action-role-code
     6377                              buf_action-role-item.action-role-item-code = v-action-role-item-code
     6378                              buf_action-role-item.action-item-id        = temp-action-item.action-item-id
     6379                           .
     6380                           find first buf_action-item
     6381                              where buf_action-item.action-head-code = buf_action-role-item.action-head-code
     6382                                 and buf_action-item.action-item-id  = buf_action-role-item.action-item-id
     6383                              no-lock
     6384                              no-error
     6385                              .
     6386                           if available buf_action-item then do:
     6387                              assign
     6388                                 buf_action-role-item.action-item-code = buf_action-item.action-item-code
     6389                              .
     6390                           end.
     6391                     end.
     6392                     when 'object':U
     6393                     then do:
     6394                        if v-object-action-role-code = 0
     6395                        then do:
     6396                           assign
     6397                              v-action-role-code = dynamic-next-value("s-action-role":U, "ub":U)
     6398                           .
     6399                           create buf_action-role .
     6400                           assign
     6401                              buf_action-role.db-num              = g#db-num
     6402                              buf_action-role.action-head-code    = 0
     6403                              buf_action-role.action-role-code    = v-action-role-code
     6404                              buf_action-role.action-role-context = temp-action-item.action-context
     6405                              buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     6406                           .
     6407                           assign
     6408                              v-object-action-role-code = v-action-role-code
     6409                           .
     6410                           end.
     6411                           assign
     6412                              v-action-role-item-code = dynamic-next-value("s-action-role-item":U, "ub":U)
     6413                           .
     6414                           create buf_action-role-item .
     6415                           assign
     6416                              buf_action-role-item.db-num                = g#db-num
     6417                              buf_action-role-item.action-head-code      = 0
     6418                              buf_action-role-item.action-role-code      = v-object-action-role-code
     6419                              buf_action-role-item.action-role-item-code = v-action-role-item-code
     6420                              buf_action-role-item.action-item-id        = temp-action-item.action-item-id
     6421                           .
     6422                           find first buf_action-item
     6423                              where buf_action-item.action-head-code = buf_action-role-item.action-head-code
     6424                                 and buf_action-item.action-item-id  = buf_action-role-item.action-item-id
     6425                              no-lock
     6426                              no-error
     6427                              .
     6428                           if available buf_action-item then do:
     6429                              assign
     6430                                 buf_action-role-item.action-item-code = buf_action-item.action-item-code
     6431                              .
     6432                           end.
     6433                     end.
     6434                     otherwise do:
     6435                     end.
     6436                  end.
     6437                  end.
     6438               end.
     6439            end.
     6440         end.
     6441      END CASE.
     6442   end.
     6443   if p-usr then do:
     6444      define buffer buf__user          for ub._user.
     6445      define buffer buf_user-account   for ub.user-account.
     6446      define buffer buf_menu-group     for ub.menu-group.
     6447      define buffer buf_user-login     for ub.user-login.
     6448      define buffer buf_user-context-history    for ubflt.user-context-history.
     6449      define buffer buf_user-login-action-role  for ub.user-login-action-role.
     6450      define buffer buf_user-menu-group      for ub.user-menu-group.
     6451      define buffer buf_user-host      for ub.user-host.
     6452      define buffer buf_user-obj       for ub.user-obj.
     6453           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ПОЛЬЗОВАТЕЛИ" ) ).
     6454      define variable v-ok                          as logical   no-undo .
     6455      define variable v-user-id                     as character no-undo .
     6456      define variable v-user-login                  as character no-undo .
     6457      define variable v-last-name                   as character no-undo .
     6458      define variable v-user-password-encoded       as character no-undo .
     6459      define variable v-cntxt-menu-group-id         as character no-undo .
     6460      define variable v-cntxt-level                 as character no-undo .
     6461      define variable v-cntxt-host-code-obj         as integer   no-undo .
     6462      define variable v-cntxt-obj-type              as character no-undo .
     6463      define variable v-cntxt-obj-code              as integer   no-undo .
     6464      define variable v-arm-code-list               as character no-undo .
     6465      define variable v-arm-code-lookup-index       as integer   no-undo .
     6466      define variable v-menu-group-id-list          as character no-undo .
     6467      define variable v-menu-group-id               as character no-undo .
     6468      define variable v-user-login-role-code        as integer   no-undo .
     6469      define variable v-obj-name                    as character no-undo .
     6470      define variable v-user-menu-group-code        as integer   no-undo .
     6471      CASE p-version:
     6472         when "15.0" then do:
     6473                              _user-account:
     6474            FOR EACH temp-user-account:
     6475               FIND FIRST ub.user-account No-LOCK
     6476                    WHERE ub.user-account.user-id = temp-user-account.user-id
     6477                    NO-ERROR
     6478                    .
     6479               IF AVAILABLE ub.user-account then do:
     6480                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть ПОЛЬЗОВАТЕЛЬ(user-account):" + temp-user-account.user-id) )) .              delete temp-user-account.                   NEXT _user-account.
     6481               END.
     6482               create ub.user-account.
     6483               buffer-copy temp-user-account to ub.user-account.
     6484               release ub.user-account No-error.
     6485               if error-status:error then do:
     6486                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     6487                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении записи ПОЛЬЗОВАТЕЛЯ(user-account): " + temp-user-account.user-id + " " + er-mes) )) .                NEXT _user-account.
     6488               end.
     6489            END.
     6490         create alias restseq    for database value( ldbname( "ub":U ) ) .
     6491         create alias restseqflt for database value( ldbname( "ubflt":U ) ) .
     6492         run adm/restseq.p
     6493           ( input "rest":U
     6494           , input "s-user-id":U
     6495           , input no
     6496           ) no-error .
     6497         if error-status :error then do:
     6498           delete alias restseqflt.
     6499           delete alias restseq.
     6500           return error return-value .
     6501         end.
     6502         delete alias restseqflt.
     6503         delete alias restseq.
     6504                              _user-login:
     6505            FOR EACH temp-user-login:
     6506               FIND FIRST ub.user-login No-LOCK
     6507                    WHERE ub.user-login.user-id = temp-user-login.user-id
     6508                      AND ub.user-login.db-num  = temp-user-login.db-num
     6509                    NO-ERROR
     6510                    .
     6511               IF AVAILABLE ub.user-login then do:
     6512                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть логин ПОЛЬЗОВАТЕЛЯ(user-login): "                                             + temp-user-login.user-id                                             + "БД:" + string(temp-user-login.db-num)                                             ) )) .              delete temp-user-login.                   NEXT _user-login.
     6513               END.
     6514               FIND FIRST ub.user-account No-LOCK
     6515                    WHERE ub.user-account.user-id = temp-user-login.user-id
     6516                    NO-ERROR
     6517                    .
     6518               IF NOT AVAILABLE ub.user-account then do:
     6519                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден ПОЛЬЗОВАТЕЛЬ(user-account):" + temp-user-login.user-id) )) .              delete temp-user-login.                   NEXT _user-login.
     6520               END.
     6521               create ub.user-login.
     6522               buffer-copy temp-user-login to ub.user-login.
     6523               release ub.user-login No-error.
     6524               if error-status:error then do:
     6525                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     6526                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении догина ПОЛЬЗОВАТЕЛЯ(user-login): " + temp-user-login.user-id + "БД:" + string(temp-user-login.db-num) + " " + er-mes) )) .                NEXT _user-login.
     6527               end.
     6528            END.
     6529                              _user-obj:
     6530            FOR EACH temp-user-obj:
     6531               FIND FIRST ub.user-obj No-LOCK
     6532                    WHERE ub.user-obj.user-id  = temp-user-obj.user-id
     6533                      AND ub.user-obj.db-num   = temp-user-obj.db-num
     6534                      AND ub.user-obj.obj-type = temp-user-obj.obj-type
     6535                      AND ub.user-obj.obj-code = temp-user-obj.obj-code
     6536                    NO-ERROR
     6537                    .
     6538               IF AVAILABLE ub.user-obj then do:
     6539                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть объект ПОЛЬЗОВАТЕЛЯ(user-obj): "                                             + temp-user-obj.user-id                                             + "БД:" + string(temp-user-obj.db-num) + " "                                             + temp-user-obj.obj-type + ","                                             + STRING(temp-user-obj.obj-code)                                                   ) )) .              delete temp-user-obj.                   NEXT _user-obj.
     6540               END.
     6541               FIND FIRST ub.user-login No-LOCK
     6542                    WHERE ub.user-login.user-id = temp-user-obj.user-id
     6543                      AND ub.user-login.db-num  = temp-user-obj.db-num
     6544                    NO-ERROR
     6545                    .
     6546               IF NOT AVAILABLE ub.user-login then do:
     6547                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден логин ПОЛЬЗОВАТЕЛЬ(user-obj):" + temp-user-obj.user-id + "БД:" + string(temp-user-obj.db-num)) )) .              delete temp-user-obj.                   NEXT _user-obj.
     6548               END.
     6549               if not can-find(first ub.clients no-lock where
     6550                                     ub.clients.obj-type = temp-user-obj.obj-type
     6551                                 and ub.clients.obj-code = temp-user-obj.obj-code) then do:
     6552                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден объект ПОЛЬЗОВАТЕЛЬ(user-obj):" + temp-user-obj.user-id + "БД:" + string(temp-user-obj.db-num)) )) .              delete temp-user-obj.                   NEXT _user-obj.
     6553               end.
     6554               create ub.user-obj.
     6555               buffer-copy temp-user-obj to ub.user-obj.
     6556               release ub.user-obj No-error.
     6557               if error-status:error then do:
     6558                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     6559                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении объекта ПОЛЬЗОВАТЕЛЯ(user-obj): "                                            + temp-user-obj.user-id                                             + "БД:" + string(temp-user-obj.db-num) + " "                                             + temp-user-obj.obj-type + ","                                             + STRING(temp-user-obj.obj-code)                                                   ) )) .                NEXT _user-obj.
     6560               end.
     6561            END.
     6562                              _user-host:
     6563            FOR EACH temp-user-host:
     6564               FIND FIRST ub.user-host No-LOCK
     6565                    WHERE ub.user-host.user-id  = temp-user-host.user-id
     6566                      AND ub.user-host.db-num   = temp-user-host.db-num
     6567                      AND ub.user-host.host-code = temp-user-host.host-code
     6568                    NO-ERROR
     6569                    .
     6570               IF AVAILABLE ub.user-host then do:
     6571                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть фирма ПОЛЬЗОВАТЕЛЯ(user-host): "                                             + temp-user-host.user-id                                             + "БД:" + string(temp-user-host.db-num) + " "                                             + STRING(temp-user-host.host-code)                                                   ) )) .              delete temp-user-host.                   NEXT _user-host.
     6572               END.
     6573               FIND FIRST ub.user-login No-LOCK
     6574                    WHERE ub.user-login.user-id = temp-user-host.user-id
     6575                      AND ub.user-login.db-num  = temp-user-host.db-num
     6576                    NO-ERROR
     6577                    .
     6578               IF NOT AVAILABLE ub.user-login then do:
