     3863     define output parameter p-character like ub.cash-desk-attr.attr-value-character    no-undo .
     3864     define output parameter p-date      like ub.cash-desk-attr.attr-value-date         no-undo .
     3865     define output parameter p-decimal   like ub.cash-desk-attr.attr-value-decimal      no-undo .
