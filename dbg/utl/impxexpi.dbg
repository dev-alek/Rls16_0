     6775                     v-cntxt-menu-group-id = buf_menu-group.menu-group-id
     6776                  .
     6777                  end.
     6778               end.
     6779               find first buf_clients
     6780                    where buf_clients.obj-type = temp-userconf.obj-type
     6781                      and buf_clients.obj-code = temp-userconf.obj-code
     6782                    no-lock
     6783                    no-error
