     4392         end.
     4393       end.
     4394     end.
     4395   end procedure.
     4396   procedure thth150-db-attr-value :
     4397     do
     4398     on error undo, return error
     4399     :
     4400       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     4401       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     4402       define output parameter p-value     like ub.db-attr.attr-value no-undo .
     4403       define output parameter p-type      as character no-undo .
     4404       define buffer buf_db-attr for ub.db-attr .
     4405       define variable v-format         as character no-undo .
     4406       define variable v-label          as character no-undo .
     4407       define variable v-user-can-edit  as logical   no-undo .
     4408       define variable v-output-display as logical   no-undo .
     4409       define variable v-other          as character no-undo .
     4410       run thth150-db-attr-code in this-procedure
     4411         (input  p-code
     4412         ,output p-type
     4413         ,output v-format
     4414         ,output v-label
     4415         ,output v-user-can-edit
     4416         ,output v-output-display
     4417         ,output v-other
     4418         ) no-error .
     4419       if error-status :error then do:
     4420         undo, return error return-value .
     4421       end.
     4422       find first buf_db-attr no-lock
     4423         where buf_db-attr.db-num    = p-db-num
     4424           and buf_db-attr.attr-code = p-code
     4425         no-error .
     4426       if avail buf_db-attr then do:
     4427         assign
     4428           p-value =  buf_db-attr.attr-value
     4429         .
     4430       end.
     4431       else do:
     4432         assign
     4433           p-value = if p-type = 'L':U then "no":U else ""
     4434         .
     4435       end.
     4436     end.
     4437   end procedure.
     4438   procedure thth150-db-attr-write :
     4439     do
     4440     on error undo, return error
     4441     :
     4442       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     4443       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     4444       define input parameter p-value     like ub.db-attr.attr-value no-undo .
     4445       define buffer buf_db-attr for ub.db-attr .
     4446       define variable v-type           as character no-undo .
     4447       define variable v-format         as character no-undo .
     4448       define variable v-label          as character no-undo .
     4449       define variable v-user-can-edit  as logical   no-undo .
     4450       define variable v-output-display as logical   no-undo .
     4451       define variable v-other          as character no-undo .
     4452       run thth150-db-attr-code in this-procedure
     4453         (input  p-code
     4454         ,output v-type
     4455         ,output v-format
     4456         ,output v-label
     4457         ,output v-user-can-edit
     4458         ,output v-output-display
     4459         ,output v-other
     4460         ) no-error .
     4461       if error-status :error then do:
     4462         undo, return error return-value .
     4463       end.
     4464       find first buf_db-attr exclusive-lock
     4465         where buf_db-attr.db-num    = p-db-num
     4466           and buf_db-attr.attr-code = p-code
     4467         no-error .
     4468       if not available buf_db-attr then do:
     4469         create buf_db-attr .
     4470         assign
     4471           buf_db-attr.db-num    = p-db-num
     4472           buf_db-attr.attr-code = p-code
     4473         .
     4474       end.
     4475       assign
     4476         buf_db-attr.attr-value = p-value
     4477       .
     4478     end.
     4479   end procedure.
     4480   procedure thth150-db-attr-exist :
     4481     do
     4482     on error undo, return error
     4483     :
     4484       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     4485       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     4486       define output parameter p-exist    as logical  no-undo .
     4487       define buffer buf_db-attr for ub.db-attr .
     4488       define variable v-type           as character no-undo .
     4489       define variable v-format         as character no-undo .
     4490       define variable v-label          as character no-undo .
     4491       define variable v-user-can-edit  as logical   no-undo .
     4492       define variable v-output-display as logical   no-undo .
     4493       define variable v-other          as character no-undo .
     4494       run thth150-db-attr-code in this-procedure
     4495         (input  p-code
     4496         ,output v-type
     4497         ,output v-format
     4498         ,output v-label
     4499         ,output v-user-can-edit
     4500         ,output v-output-display
     4501         ,output v-other
     4502         ) no-error .
     4503       if error-status :error then do:
     4504         undo, return error return-value .
     4505       end.
     4506       find first buf_db-attr no-lock
     4507         where buf_db-attr.db-num    = p-db-num
     4508           and buf_db-attr.attr-code = p-code
     4509         no-error .
     4510       if  available buf_db-attr then do:
     4511         p-exist = yes.
     4512       end.
     4513     end.
     4514   end procedure.
     4515   procedure thth150-db-attr-delete :
     4516     do
     4517     on error undo, return error
     4518     :
     4519       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
     4520       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     4521       define output parameter p-deleted  as logical no-undo.
     4522       define buffer buf_db-attr for ub.db-attr .
     4523       define variable v-type           as character no-undo .
     4524       define variable v-format         as character no-undo .
     4525       define variable v-label          as character no-undo .
     4526       define variable v-user-can-edit  as logical   no-undo .
     4527       define variable v-output-display as logical   no-undo .
     4528       define variable v-other          as character no-undo .
     4529       run thth150-db-attr-code in this-procedure
     4530         (input  p-code
     4531         ,output v-type
     4532         ,output v-format
     4533         ,output v-label
     4534         ,output v-user-can-edit
     4535         ,output v-output-display
     4536         ,output v-other
     4537         ) no-error .
     4538       if error-status :error then do:
     4539         undo, return error return-value .
     4540       end.
     4541       find first buf_db-attr exclusive-lock
     4542         where buf_db-attr.db-num    = p-db-num
     4543           and buf_db-attr.attr-code = p-code
     4544         no-error NO-WAIT.
     4545       if not available buf_db-attr then do:
     4546         p-deleted = no.
     4547       end.
     4548       else do:
     4549         delete buf_db-attr.
     4550         p-deleted = yes.
     4551       end.
     4552     end.
     4553   end procedure.
     4554   procedure thth150-db-attr-news :
     4555     do
     4556     on error undo, return error
     4557     :
     4558       define input  parameter p-code           as character no-undo .
     4559       define output parameter p-news           as logical   no-undo .
     4560       case p-code :
     4561               when 'thth150-cli-grp':U then do:     assign     p-news = no.   end.
     4562               when 'thth150-gds-grp':U then do:     assign     p-news = no.   end.
     4563               when 'thth150-clients':U then do:     assign     p-news = no.   end.
     4564               when 'thth150-goods':U then do:     assign     p-news = no.   end.
     4565               when 'thth150-dis-card':U then do:     assign     p-news = no.   end.
     4566               when 'thth150-qnty-dis-card':U then do:     assign     p-news = no.   end.
     4567               when 'thth150-shop':U then do:     assign     p-news = no.   end.
     4568               when 'thth150-contract':U then do:     assign     p-news = no.   end.
     4569               when 'thth150-price-doc':U then do:     assign     p-news = no.   end.
     4570               when 'thth150-trn-doc':U then do:     assign     p-news = no.   end.
     4571         otherwise do:
     4572           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     4573         end.
     4574       end.
     4575     end.
     4576   end procedure.
