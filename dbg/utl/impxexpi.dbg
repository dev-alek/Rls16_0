     6832                        ub.user-login.last-login-process-id      = 0
     6833                        ub.user-login.login-error-count          = 0
     6834                        ub.user-login.max-discnt                 = temp-userconf.max-discnt
     6835                        ub.user-login.quest-print                = temp-userconf.quest-print
     6836                        ub.user-login.status_                    = 0
     6837                        ub.user-login.user-administrator         = (if v-user-login = 'адм':U
