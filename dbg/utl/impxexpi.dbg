     7381                 if (buf-thbj-attr.obj-type = 'маг':U
     7382                 or buf-thbj-attr.obj-type = 'скл':U )
     7383                 and not (p-old-obj-type = buf-thbj-attr.obj-type
     7384                          and
     7385                          p-old-obj-code = buf-thbj-attr.obj-code)
     7386                 then do:
     7387                   delete buf-thbj-attr.
     7388                   next _thb.
     7389                 end.
     7390                 if buf-thbj-attr.obj-type = 'орг':U
     7391                 and p-old-host-code <> buf-thbj-attr.obj-code then do:
     7392                   delete buf-thbj-attr.
     7393                   next _thb.
     7394                 end.
     7395                 if lookup(buf-thbj-attr.upper-prop-code, "autosale,get-chk,chk-view,cd-sending,cd-inf-send," + "scale-inf,cd-type-ibm,abc-sale-day,abc-global," + "ord-global,ord-obj,fin-global,contr-in,nakl_par," + "rt-trn-doc,gds-ref,gds-ref_obj,cli-all," + "auto-task,Ass-obj") = 0 then do:
     7396                    delete buf-thbj-attr.
     7397                    next _thb.
     7398                  end.
     7399                 if buf-thbj-attr.obj-type = 'орг':U then do:
     7400                   assign
     7401                   buf-thbj-attr.obj-code = p-new-host-code.
     7402                 end.
     7403                 if buf-thbj-attr.obj-type = 'маг':U
     7404                 or buf-thbj-attr.obj-type = 'скл':U  then do:
     7405                   assign
     7406                   buf-thbj-attr.obj-type = p-new-obj-type
     7407                   buf-thbj-attr.obj-code = p-new-obj-code
     7408                   .
     7409                 end.
     7410                 case buf-thbj-attr.upper-prop-code:
     7411                   when 'autosale':U then do:
     7412                     case buf-thbj-attr.prop-code:
     7413                       when 'neg-tpsi-weight':U then do:
     7414                         next _thb.
     7415                       end.
     7416                       when 'neg-tpsi-qnty':U then do:
     7417                         next _thb.
     7418                       end.
     7419                       when 'neg-tpsi-oper':U then do:
     7420                         next _thb.
