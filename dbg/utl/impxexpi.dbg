     8509                        delete buf-grp-acta.
     8510                        end.
     8511                     end CASE.
     8512                  end.
     8513                  otherwise do:
     8514                  end.
     8515                  END CASE.
     8516               END.
     8517               end.
     8518         END CASE.
     8519         input stream InStream close.
     8520        end.
     8521        else do:
     8522            return error.
     8523        end.
     8524     end.
     8525   end procedure.
     8526   procedure p-usr-i :
     8527   define variable v-curr-seek as integer no-undo .
     8528     do
     8529     on error undo, return error
     8530     :
     8531      run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ПОЛЬЗОВАТЕЛИ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "usr":U) )) .
     8532      run check-iefile in this-procedure(input p-dir-name,                                      input "usr":U,                                      input "import":U,                                      output loc#log).
     8533      ii = 0.
     8534      if loc#log then do:
     8535         run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ПОЛЬЗОВАТЕЛИ" ) ).
     8536         input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "usr":U).
     8537         CASE p-version:
     8538            when "15.0" then do:
     8539                  _usr:
     8540                  REPEAT:
     8541                     import stream Instream unformatted ss.
     8542                     ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8543                     CASE ss:
     8544                     when "user-account":U or
     8545                     when "user-login":U or
     8546                     when "user-obj":U or
     8547                     when "user-host":U or
     8548                     when "user-menu-group":U or
     8549                     when "user-action-role":U or
