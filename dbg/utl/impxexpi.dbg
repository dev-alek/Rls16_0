     6620                                 and ub.clients.obj-code = temp-user-menu-group.obj-code) then do:
     6621                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден объект ПОЛЬЗОВАТЕЛЬ(user-menu-group):" + temp-user-menu-group.user-id + "БД:" + string(temp-user-menu-group.db-num)) )) .              delete temp-user-menu-group.                   NEXT _user-menu-group.
     6622               end.
     6623               create ub.user-menu-group.
