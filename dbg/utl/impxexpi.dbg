     5872       end.
     5873       else do:
     5874         assign
     5875         v-mode = 'ДОБАВЛЕНИЕ':U
     5876         v-rid = ?
     5877         .
     5878       end.
     5879       run ref/place01.p (
     5880                       input-output v-rid
     5881                       ,INPUT v-mode
     5882                       ,INPUT yes
     5883                       ,input temp-place.obj-type
     5884                       ,input temp-place.obj-code
     5885                       ,input temp-place.pl-code
     5886                       ,input temp-place.loc1
     5887                       ,input temp-place.loc2
     5888                       ,input temp-place.loc3
     5889                       ,input temp-place.loc4
     5890                       ,input temp-place.pl-name
     5891                       ,input temp-place.ps
     5892                       ,input temp-place.add-qnty
     5893                       ,input temp-place.is-meas
     5894                       ,input temp-place.max-qnty
     5895                       ,input temp-place.issue-year
     5896                       ,input temp-place.start-date
     5897                       ,input temp-place.chk-max-qnty
     5898                       ) no-error.
     5899       if error-status:error then do:
     5900         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     5901               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) +  " ошибка при сохранении записи СКЛ.МЕСТО(place):" +                                       " номер " + string(temp-place.pl-code) +                                       er-mes) )) .                NEXT _placev.
     5902       end.
     5903       find first ub.place no-lock where
     5904                 recid(ub.place) = v-rid.
     5905       for each temp-pl-gds :
     5906         if temp-pl-gds.pl-code = temp-place.pl-code then do:
     5907           temp-pl-gds.pl-code = ub.place.pl-code.
     5908         end.
     5909       end.
     5910       for each temp-pl-pump:
     5911         if temp-pl-pump.pl-code = temp-place.pl-code then do:
     5912           temp-pl-pump.pl-code = ub.place.pl-code.
     5913         end.
     5914       end.
     5915       for each temp-pl-gds-pump :
     5916         if temp-pl-gds-pump.pl-code = temp-place.pl-code then do:
     5917           temp-pl-gds-pump.pl-code = ub.place.pl-code.
     5918         end.
     5919       end.
     5920       for each temp-pl-pump-nozzle:
     5921         if temp-pl-pump-nozzle.pl-code = temp-place.pl-code then do:
     5922           temp-pl-pump-nozzle.pl-code = ub.place.pl-code.
     5923         end.
     5924       end.
     5925     END.
     5926         _pumpv:
     5927     for each temp-pump:
     5928       FIND FIRST ub.pump share-LOCK WHERE
     5929                  ub.pump.obj-type = temp-pump.obj-type  AND
     5930                  ub.pump.obj-code = temp-pump.obj-code  AND
     5931                  ub.pump.pump-code = temp-pump.pump-code  NO-ERROR.
     5932       IF not AVAILABLE ub.pump then do:
     5933        create ub.pump.
     5934         buffer-copy temp-pump to ub.pump.
     5935       end.
     5936       buffer-copy  temp-pump to ub.pump.
     5937       release ub.pump no-error.
     5938       if error-status:error then do:
     5939         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     5940               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КОНФИГУРАЦИЯ АЗК" + chr(10) +  " ошибка при сохранении записи ТРК(pump):" +                                       " номер " + string(temp-pump.pump-code) +                                       er-mes) )) .                NEXT _pumpv.
     5941       end.
     5942     end.
     5943         _nozzlev:
     5944     for each temp-nozzle:
     5945       FIND FIRST ub.nozzle share-LOCK WHERE
     5946                  ub.nozzle.obj-type = temp-nozzle.obj-type  AND
     5947                  ub.nozzle.obj-code = temp-nozzle.obj-code  AND
     5948                  ub.nozzle.nozzle-code = temp-nozzle.nozzle-code  NO-ERROR.
