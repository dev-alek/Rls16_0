     5231                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ" + chr(10) + " ошибка при сохранении записи ДИАПАЗОН КОДОВ (code-range):" +                           " тип " + temp-code-range.range-type +                           " начало " + string(temp-code-range.first-code) +                           " окончание " + string(temp-code-range.last-code) +                           er-mes) )) .                NEXT _code-rg.
     5232           end.
     5233         END.
     5234       end.
     5235       else do:
     5236               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ" + chr(10) + " в файле импорта нет ни одной записи типа ДИАПАЗОН КОДОВ (code-range)" ) )) .
     5237       end.
     5238     end.
     5239     else do:
     5240           run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ" + chr(10) + " импорт записей типа ДИАПАЗОН КОДОВ (code-range) разрешен только в ГБД" ) )) .
     5241     end.
     5242   end.
     5243   if p-flt then do:
     5244           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ФИЛЬТРЫ" ) ).
     5245         _filterv:
     5246     FOR EACH temp-filter NO-LOCK:
     5247       FIND FIRST ubflt.filter No-LOCK WHERE
