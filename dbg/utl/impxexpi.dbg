     6628                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении группы меню ПОЛЬЗОВАТЕЛЯ(user-menu-group): "                                             + temp-user-menu-group.user-id                                             + "БД:" + string(temp-user-menu-group.db-num) + " "                                             + STRING(temp-user-menu-group.user-menu-group-code)                                                   + " " + er-mes) )) .                NEXT _user-menu-group.
