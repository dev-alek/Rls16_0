     8270                 buffer-copy buf-pl-pump to temp-pl-pump
     8271                 .
     8272                 delete buf-pl-pump.
     8273               end.
     8274             end case.
     8275           end.
     8276           when 'pump-nozzle':U then do:
     8277             current-table = ss.
     8278             case current-table:
