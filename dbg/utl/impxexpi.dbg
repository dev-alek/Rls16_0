     5860           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных КОНФИГУРАЦИЯ АЗК" ) ).
     5861         _placev:
     5862     FOR EACH temp-place:
     5863       FIND FIRST ub.place No-LOCK WHERE
     5864                  ub.place.obj-type = temp-place.obj-type  AND
     5865                  ub.place.obj-code = temp-place.obj-code  AND
     5866                  ub.place.loc1 = temp-place.loc1  NO-ERROR.
