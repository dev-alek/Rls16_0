     6816                               where ub.user-login.db-num  = g#db-num
     6817                                 and ub.user-login.user-login = v-user-login)
     6818                  THEN DO:
     6819                     message
     6820                        "В системе уже есть пользователь с логином" v-user-login
     6821                        skip
     6822                     view-as alert-box information.
     6823                  END.
     6824                  ELSE DO:
     6825                     create ub.user-login .
