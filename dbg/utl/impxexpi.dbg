     7433                         end.
     7434                         else do:
     7435                           buf-thbj-attr.property-value-integer = v-int1.
     7436                         end.
     7437                       end.
     7438                       when 'agnt':U then do:
     7439                         run convert-thbj-attr-integer-1 in this-procedure ( input buf-thbj-attr.property-value-integer
     7440                                                                            ,output v-int1) no-error.
     7441                         if error-status:error then do:
     7442                                                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПАРАМЕТРЫ O БД, СТРОКА " + string(ii) + chr(10)) + " Для значения параметра не найдено соответствие в таблице соответствий: ПАРАМЕТРА(thbj-attr)" +                                         " Секция " + string(buf-thbj-attr.upper-prop-code) +                                         " параметр " + buf-thbj-attr.prop-code +                                         " тип объекта " + buf-thbj-attr.obj-type +                                         " код объекта " + string(buf-thbj-attr.obj-code) ) )) .              delete buf-config.                   NEXT _thb.
     7443                         end.
     7444                         else do:
     7445                           buf-thbj-attr.property-value-integer = v-int1.
     7446                         end.
     7447                       end.
     7448                       when 'boss':U then do:
     7449                         run convert-thbj-attr-integer-1 in this-procedure ( input buf-thbj-attr.property-value-integer
     7450                                                                            ,output v-int1) no-error.
     7451                         if error-status:error then do:
     7452                                                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПАРАМЕТРЫ O БД, СТРОКА " + string(ii) + chr(10)) + " Для значения параметра не найдено соответствие в таблице соответствий: ПАРАМЕТРА(thbj-attr)" +                                         " Секция " + string(buf-thbj-attr.upper-prop-code) +                                         " параметр " + buf-thbj-attr.prop-code +                                         " тип объекта " + buf-thbj-attr.obj-type +                                         " код объекта " + string(buf-thbj-attr.obj-code) ) )) .              delete buf-config.                   NEXT _thb.
     7453                         end.
     7454                         else do:
     7455                           buf-thbj-attr.property-value-integer = v-int1.
     7456                         end.
     7457                       end.
     7458                       when 'one-sale-per-day':U then do:
     7459                         next _thb.
     7460                       end.
     7461                       when 'close-day-period':U then do:
     7462                         next _thb.
     7463                       end.
     7464                     end case.
     7465                   end.
     7466                   when 'get-chk':U then do:
     7467                     case buf-thbj-attr.prop-code:
     7468                       when 'zero-cashier':U then do:
     7469                         next _thb.
     7470                       end.
     7471                     end case.
     7472                   end.
     7473                   when 'cd-inf-send':U then do:
     7474                     case buf-thbj-attr.prop-code:
     7475                       when 'how-temp-disc':U then do:
     7476                         next _thb.
     7477                       end.
     7478                       when 'how-pcnt-kat':U then do:
     7479                         next _thb.
     7480                       end.
     7481                     end case.
     7482                   end.
     7483                   when 'cd-type-ibm':U then do:
     7484                     case buf-thbj-attr.prop-code:
     7485                       when 'specgrp':U then do:
     7486                         next _thb.
     7487                       end.
     7488                     end case.
     7489                   end.
     7490                   when 'ord-obj':U then do:
     7491                     case buf-thbj-attr.prop-code:
     7492                       when 'ord-askp':U then do:
     7493                         next _thb.
     7494                       end.
     7495                       when 'ord-obj-rc':U then do:
     7496                         next _thb.
     7497                       end.
     7498                     end case.
     7499                   end.
     7500                   when 'rt-trn-doc':U then do:
     7501                     case buf-thbj-attr.prop-code:
     7502                       when 'wrkr':U then do:
     7503                         run convert-thbj-attr-integer-1 in this-procedure ( input buf-thbj-attr.property-value-integer
     7504                                                                            ,output v-int1) no-error.
     7505                         if error-status:error then do:
     7506                                                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПАРАМЕТРЫ O БД, СТРОКА " + string(ii) + chr(10)) + " Для значения параметра не найдено соответствие в таблице соответствий: ПАРАМЕТРА(thbj-attr)" +                                         " Секция " + string(buf-thbj-attr.upper-prop-code) +                                         " параметр " + buf-thbj-attr.prop-code +                                         " тип объекта " + buf-thbj-attr.obj-type +                                         " код объекта " + string(buf-thbj-attr.obj-code) ) )) .              delete buf-config.                   NEXT _thb.
     7507                         end.
     7508                         else do:
     7509                           buf-thbj-attr.property-value-integer = v-int1.
     7510                         end.
     7511                       end.
     7512                       when 'agnt':U then do:
     7513                         run convert-thbj-attr-integer-1 in this-procedure ( input buf-thbj-attr.property-value-integer
     7514                                                                            ,output v-int1) no-error.
     7515                         if error-status:error then do:
     7516                                                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПАРАМЕТРЫ O БД, СТРОКА " + string(ii) + chr(10)) + " Для значения параметра не найдено соответствие в таблице соответствий: ПАРАМЕТРА(thbj-attr)" +                                         " Секция " + string(buf-thbj-attr.upper-prop-code) +                                         " параметр " + buf-thbj-attr.prop-code +                                         " тип объекта " + buf-thbj-attr.obj-type +                                         " код объекта " + string(buf-thbj-attr.obj-code) ) )) .              delete buf-config.                   NEXT _thb.
     7517                         end.
     7518                         else do:
     7519                           buf-thbj-attr.property-value-integer = v-int1.
     7520                         end.
     7521                       end.
     7522                       when 'boss':U then do:
     7523                         run convert-thbj-attr-integer-1 in this-procedure ( input buf-thbj-attr.property-value-integer
     7524                                                                            ,output v-int1) no-error.
     7525                         if error-status:error then do:
     7526                                                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПАРАМЕТРЫ O БД, СТРОКА " + string(ii) + chr(10)) + " Для значения параметра не найдено соответствие в таблице соответствий: ПАРАМЕТРА(thbj-attr)" +                                         " Секция " + string(buf-thbj-attr.upper-prop-code) +                                         " параметр " + buf-thbj-attr.prop-code +                                         " тип объекта " + buf-thbj-attr.obj-type +                                         " код объекта " + string(buf-thbj-attr.obj-code) ) )) .              delete buf-config.                   NEXT _thb.
     7527                         end.
     7528                         else do:
