     5258               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ФИЛЬТРЫ" + chr(10) + " ошибка при сохранении записи ФИЛЬТР(filter):" +                       " название " + string(temp-filter.Naim) +                       " точка вызова " + temp-filter.call-point +                       er-mes) )) .                NEXT _filterv.
     5259       end.
     5260       create alias restseq    for database value( ldbname( "ub":U ) ) .
     5261       create alias restseqflt for database value( ldbname( "ubflt":U ) ) .
     5262       run adm/restseq.p
     5263         ( input "rest":U
     5264          ,input "next-num-filter":U
     5265          ,input no
     5266         ) no-error .
     5267       if error-status :error then do:
     5268         delete alias restseqflt.
     5269         delete alias restseq.
     5270         return error return-value .
     5271       end.
     5272       delete alias restseqflt.
     5273       delete alias restseq.
     5274     END.
     5275   end.
     5276   if p-pbc then do:
     5277           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ВЕС и ВЗВЕШ КОДЫ" ) ).
     5278         _prod-bcv:
     5279     FOR EACH temp-prod-bc:
     5280       assign
     5281       v-is-global = no
     5282       v-is-weight = no
     5283       v-is-pgweight = no
     5284       v-is-scaleable = no
     5285       v-is-petrolium = no
     5286       .
     5287       FIND FIRST ub.prod-bc No-LOCK WHERE
     5288                  ub.prod-bc.b-str = temp-prod-bc.b-str
     5289             AND  ub.prod-bc.b-code = temp-prod-bc.b-code NO-ERROR.
     5290       IF AVAILABLE ub.prod-bc then do:
     5291                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Уже есть ДопБК(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Баркод " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     5292       end.
     5293       find first ub.prod-bc no-lock where
     5294                 ub.prod-bc.b-str = temp-prod-bc.b-str
     5295             AND ub.prod-bc.bc-on = yes no-error.
     5296       IF AVAILABLE ub.prod-bc then do:
     5297                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Уже есть такой включенный ДопБК(prod-bc) на другом товаре:" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Баркод имеющегося включенного ДопБК" + string(ub.prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     5298       end.
     5299       find first ub.bar-code no-lock where
