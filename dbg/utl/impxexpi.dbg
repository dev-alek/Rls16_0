     6951                              buf_user-menu-group.obj-type      = buf_clients.obj-type
     6952                              buf_user-menu-group.obj-code      = buf_clients.obj-code
     6953                           .
     6954                        end.
     6955                     END.
     6956                  end.
     6957                  find first buf_user-host
     6958                  where buf_user-host.db-num    = g#db-num
     6959                     and buf_user-host.user-id   = buf_user-login.user-id
     6960                     and buf_user-host.host-code = temp-usr-grpa.host-code
     6961                  no-error .
