     9932   procedure convert-thbj-attr-integer-1 :
     9933   define input parameter p-old-int as integer no-undo .
     9934   define output parameter p-new-int as integer no-undo .
     9935   define variable v-tbl-row as rowid no-undo .
     9936   define variable v-tbl-name as character no-undo .
     9937   define buffer buf_ext-classif for ub.ext-classif.
     9938   define buffer buf_clients for ub.clients.
     9939   find first buf_ext-classif no-lock where
     9940             buf_ext-classif.classif-subject = 'clients':U
     9941       and  buf_ext-classif.classif-name = v-cli-classif-name
     9942       and buf_ext-classif.key#_one = p-old-int
     9943       and buf_ext-classif.charkey_one = 'чел':U no-error.
     9944   if not available buf_ext-classif then do:
     9945     return error.
     9946   end.
     9947   else do:
     9948     run gen-row-keyr in this-procedure (
     9949                                         input  buf_ext-classif.uniq-key-rec
     9950                                         ,input  ?
     9951                                       , input  "ub"
     9952                                       , input  ?
     9953                                       , input  NO-LOCK
     9954                                       , output v-tbl-row
     9955                                       , output v-tbl-name   ) no-error.
     9956     if error-status:error then do:
     9957       return error.
     9958     end.
     9959     find first buf_Clients no-lock where
     9960               rowid(buf_clients) = v-tbl-row no-error.
     9961     if not available buf_clients then do:
     9962       return error.
     9963     end.
     9964     else do:
     9965       assign
     9966       p-new-int = buf_clients.obj-code.
     9967     end.
     9968   end.
     9969   end procedure.
