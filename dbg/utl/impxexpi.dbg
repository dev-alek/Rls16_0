     8860                     end.
     8861                     otherwise do:
     8862                     end.
     8863                     END CASE.
     8864                  END.
     8865               end.
     8866         END CASE.
     8867         input stream InStream close.
     8868        end.
     8869     end.
     8870   end procedure.
     8871   procedure p-cdrg-i :
     8872     do
     8873     on error undo, return error
     8874     :
     8875     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "cdr":U) )) .
     8876     run check-iefile in this-procedure(input p-dir-name,                                      input "cdr":U,                                      input "import":U,                                      output loc#log).
     8877     ii = 0.
     8878     if loc#log then do:
     8879       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ" ) ).
     8880       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "cdr":U).
     8881       _cdrg:
     8882       REPEAT:
     8883         import stream Instream unformatted ss.
     8884         CASE ss:
     8885           when "code-range":U then do:
     8886             current-table = ss.
     8887             case current-table:
     8888               when "code-range":U then do:
     8889                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     8890                 create buf-code-range.
     8891                 import stream Instream  no-error.
     8892                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _cdrg.                   end.
     8893                 find first temp-code-range No-LOCK
     8894                   WHERE ( temp-code-range.range-type     = buf-code-range.range-type
     8895                           AND temp-code-range.first-code = buf-code-range.first-code
     8896                         )
     8897                         or
     8898                         ( temp-code-range.range-type     = buf-code-range.range-type
     8899                           AND temp-code-range.last-code = buf-code-range.last-code
     8900                         )
     8901                   no-error .
     8902                 if available temp-code-range then do:
     8903                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ДИАПАЗОН КОДОВ (code-range):" +                                  " тип " + buf-code-range.range-type +                                  " начало " + string(buf-code-range.first-code) +                                  " и/или " +                                  " тип " + buf-code-range.range-type +                                  " окончание " + string(buf-code-range.last-code)                                 ) )) .              delete buf-code-range.                   NEXT _cdrg.
     8904                 end.
     8905                 create temp-code-range.
     8906                 buffer-copy buf-code-range to temp-code-range.
     8907                 delete buf-code-range.
     8908               end.
     8909             end CASE.
     8910           end.
     8911           otherwise do:
     8912           end.
     8913         END CASE.
     8914       END.
     8915       input stream InStream close.
     8916     end.
     8917     end.
     8918   end procedure.
     8919   procedure create-scales-gds :
     8920   define parameter buffer bc for ub.bar-code.
     8921   define parameter buffer sc for ub.scales.
     8922   define parameter buffer goods for ub.goods.
     8923   define parameter buffer ltemp-scales-gds  for temp-scales-gds.
     8924   define variable ii as integer no-undo.
     8925   define variable sc-code like ub.bar-code.b-code no-undo .
     8926   define variable v-found as logical no-undo .
     8927   define variable v-on as logical no-undo .
     8928   define variable v-b-str like ub.prod-bc.b-str no-undo .
     8929   define variable f-sc-code as integer no-undo .
     8930   define buffer for-pbc for ub.prod-bc.
     8931   define buffer dubl_prod-bc for ub.prod-bc.
     8932   define buffer buf_units for ub.units.
     8933     do
     8934     on error undo, return error
     8935     :
     8936       if sc.tot-gds + 1 > sc.max-gds then do:
     8937         undo, return error ("Превышено максимальное количество товаров на весах" + chr(32) + string(sc.scales-num)).
     8938       end.
     8939       find first buf_units no-lock where buf_units.unit-name = goods.unit-base.
     8940   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8941   define variable v-rid24 as recid no-undo .
     8942   v-found = no.
     8943   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8944   define buffer locK-batchprocess25 for ub.batchprocess.
     8945   run gbl/lock-prc.p
     8946       (input 'lscc':U
     8947       ,input 0
     8948       ,input 0
     8949       ,input 0
     8950       ,input ""
     8951       ,input ""
     8952       ,input ""
     8953       ,input (
     8954               ",,,Вкл/выкл лок. вес. кодов"
     8955              )
     8956       ,input true
     8957       ,buffer lock-batchprocess25
     8958       ) no-error .
     8959     if error-status :error then do:
     8960       message
     8961         vss-workfile vss-revision vss-description skip
     8962         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     8963         view-as alert-box error .
     8964       undo, return error .
     8965     end.
     8966   if lookup('вес':U, buf_units.type) > 0 then do:
     8967     run trg/isvescod.p ( input bc.b-code
     8968                         ,input yes
     8969                         ,input no
     8970                         ,input yes
     8971                         ,input ""
     8972                         ,output v-found
     8973                         ,output v-on
     8974                         ,output v-b-str) no-error.
     8975   end.
     8976   else do:
     8977     run trg/ispgwcod.p (input bc.b-code
     8978                       ,input yes
     8979                       ,input no
     8980                       ,input yes
     8981                       ,input ""
     8982                       ,output v-found
     8983                       ,output v-on
     8984                       ,output v-b-str ) no-error.
     8985   end.
     8986   if error-status:error then do:
     8987     return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     8988   end.
     8989   if v-found and v-on = no then do:
     8990     find first ub.prod-bc exclusive-lock where
     8991                ub.prod-bc.b-code = bc.b-code
     8992           AND  ub.prod-bc.b-str = v-b-str no-error no-wait.
     8993     if not avail prod-bc then do:
     8994       assign
     8995       v-found = no
     8996       .
     8997     end.
     8998     else do:
     8999       if prod-bc.bc-on = no then do:
     9000         run trg/bc-upd.p (
     9001                                  input parparentproc
     9002                   ,input bc.b-code
     9003                   ,input  ub.prod-bc.b-str
     9004                   ,input yes
     9005                   ,input yes
     9006                   ,input no
     9007                   ,input ?
     9008                   ,input ?
     9009                   ) no-error.
     9010         if error-status:error then do:
     9011           assign
     9012           v-found = no
     9013           .
     9014         end.
     9015       end.
     9016     end.
     9017   end.
     9018   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9019   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     9020     (input  ltemp-scales-gds.obj-type
     9021     ,input  ltemp-scales-gds.obj-code
     9022     ,input  goods.artic
     9023     ,input  goods.prod-type
     9024     ,input  goods.prod-code
     9025     ,buffer ub.gds-obj
     9026     ) no-error .
     9027   release ub.gds-obj.
     9028   if lookup('вес':U, buf_units.type) = 0
     9029   or v-found = yes
     9030   then do:
     9031     define variable v-exist24 as logical no-undo .
     9032     run gdsoattr-exist in this-procedure (
     9033                                           input goods.gds-code
     9034                                          ,input ltemp-scales-gds.obj-type
     9035                                          ,input ltemp-scales-gds.obj-code
     9036                                          ,input 'scales-code':U
     9037                                          ,output v-exist24
     9038                                         ) .
     9039     if not v-exist24 then do:
     9040   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run sclcdattr in g#library
     9042     (input  goods.gds-code
     9043     ,input  ltemp-scales-gds.obj-type
     9044     ,input  ltemp-scales-gds.obj-code
     9045     ,input  v-b-str
     9046     ,input  no
     9047     ) no-error .
     9048   end.
     9049   if error-status:error then do:
     9050     return error '':U.
     9051   end.
     9052   end.
     9053   if not v-found
     9054   and lookup('вес':U, buf_units.type) > 0
     9055   then do:
     9056     v-rid24 = ?.
     9057     run trg/prod-bc1.p ( input parparentproc
     9058                         ,input yes
     9059                         ,input ?
     9060                         ,input ?
     9061                         ,input no
     9062                         ,input 'sclc':U
     9063                         ,input ""
     9064                         ,buffer goods
     9065                         ,input bc.b-code
     9066                         ,input-output v-b-str
     9067                         ,output v-rid24
     9068                         ) no-error.
     9069     if error-status:error
     9070     or v-rid24 = ? then do:
     9071       return error substitute("Ошибка при сохранении ДопБК для весов&2&1&2&3", error-status:get-message(1) , chr(10), return-value ).
     9072     end.
     9073     find first prod-bc exclusive-lock where
     9074               recid(prod-bc) = v-rid24.
     9075   end.
     9076       _main:
     9077       DO ON ERROR undo, return error on stop undo, return error:
     9078         create ub.scales-gds.
     9079         assign
     9080         sc.tot-gds  = sc.tot-gds + 1
     9081         ub.scales-gds.db-num    = g#db-num
     9082         ub.scales-gds.obj-type  = ltemp-scales-gds.obj-type
     9083         ub.scales-gds.obj-code = ltemp-scales-gds.obj-code
     9084         ub.scales-gds.b-code = ltemp-scales-gds.b-code
     9085         ub.scales-gds.scales-num = ltemp-scales-gds.scales-num
     9086         ub.scales-gds.to-send = TRUE
     9087         sc.to-send = TRUE
     9088         ub.scales-gds.to-del = FALSE
     9089         ub.scales-gds.deadline = ltemp-scales-gds.deadline
     9090         ub.scales-gds.wt-cart = ltemp-scales-gds.wt-cart
     9091         ub.scales-gds.plu-code = ltemp-scales-gds.plu-code
     9092         ub.scales-gds.whole-send-news = ltemp-scales-gds.whole-send-news
     9093         .
     9094       END.
     9095     end.
     9096   end procedure.
     9097   procedure add-right :
     9098     define input parameter p-grp-acta-arm-code  as character no-undo .
     9099     define input parameter p-grp-acta-object    as character no-undo .
     9100     define input parameter p-grp-acta-act       as character no-undo .
     9101     define input parameter p-action-item-id     as character no-undo .
     9102     define input parameter p-action-context     as character no-undo .
     9103     define buffer buf_temp-action-item for temp-action-item .
     9104     do transaction
     9105     on error undo, return error return-value
     9106     :
     9107         create buf_temp-action-item .
     9108         assign
     9109           buf_temp-action-item.grp-acta-arm-code  = p-grp-acta-arm-code
     9110           buf_temp-action-item.grp-acta-object    = p-grp-acta-object
     9111           buf_temp-action-item.grp-acta-act       = p-grp-acta-act
     9112           buf_temp-action-item.action-item-id     = p-action-item-id
     9113           buf_temp-action-item.action-context     = p-action-context
     9114         .
     9115     end.
     9116   end procedure.
     9117   procedure p-right-i :
     9118   do
     9119   on error undo, return error
     9120   :
     9121     if "rus" = "rus":U
     9122     then do:
     9123       run fill-right-rus in this-procedure .
     9124     end.
     9125     else do:
     9126       run fill-right-eng in this-procedure .
     9127     end.
     9128   end.
     9129   end procedure.
