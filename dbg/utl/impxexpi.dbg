     5535               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " ошибка при получении max кода диапазона взвешиваемых кодов(prod-bc):" +                       er-mes) )) .
