     5852               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных КАССЫ" + chr(10) +  " ошибка при сохранении записи КАССА(cash-desk):" +                                       " номер " + string(temp-cash-desk.cash-num) +                                       er-mes) )) .                NEXT _cash-deskv.
     5853       end.
     5854     END.
     5855   end.
     5856   if p-pet then do:
