     7120                                 buf_user-login-action-role.action-role-code     = v-global-action-role-code
     7121                                 buf_user-login-action-role.action-role-context  = 'global':U
     7122                                 buf_user-login-action-role.host-code            = 0
     7123                                 buf_user-login-action-role.obj-type             = '':U
     7124                                 buf_user-login-action-role.obj-code             = 0
     7125                                 buf_user-login-action-role.gds-grp-code         = ?
     7126                                 buf_user-login-action-role.gds-code             = ?
     7127                                 buf_user-login-action-role.cli-grp-code         = ?
     7128                              .
     7129                           end.
     7130                           if v-firm-action-role-code <> 0
     7131                           then do:
     7132                           assign
     7133                             v-user-login-role-code = dynamic-next-value("s-user-login-action-role":U, "ub":U)
     7134                           .
     7135                           create buf_user-login-action-role .
     7136                           assign
     7137                              buf_user-login-action-role.db-num               = g#db-num
     7138                              buf_user-login-action-role.action-head-code     = 0
     7139                              buf_user-login-action-role.user-login-role-code = v-user-login-role-code
     7140                              buf_user-login-action-role.user-id              = buf_user-login.user-id
     7141                              buf_user-login-action-role.action-role-code     = v-firm-action-role-code
     7142                              buf_user-login-action-role.action-role-context  = 'firm':U
     7143                              buf_user-login-action-role.host-code            = buf_clients.host-code
     7144                              buf_user-login-action-role.obj-type             = '':U
     7145                              buf_user-login-action-role.obj-code             = 0
     7146                              buf_user-login-action-role.gds-grp-code         = ?
     7147                              buf_user-login-action-role.gds-code             = ?
     7148                              buf_user-login-action-role.cli-grp-code         = ?
     7149                           .
     7150                           end.
     7151                           if v-object-action-role-code <> 0
     7152                           then do:
     7153                           assign
     7154                             v-user-login-role-code = dynamic-next-value("s-user-login-action-role":U, "ub":U)
     7155                           .
     7156                           create buf_user-login-action-role .
     7157                           assign
     7158                              buf_user-login-action-role.db-num               = g#db-num
     7159                              buf_user-login-action-role.action-head-code     = 0
     7160                              buf_user-login-action-role.user-login-role-code = v-user-login-role-code
     7161                              buf_user-login-action-role.user-id              = buf_user-login.user-id
     7162                              buf_user-login-action-role.action-role-code     = v-object-action-role-code
     7163                              buf_user-login-action-role.action-role-context  = 'object':U
     7164                              buf_user-login-action-role.host-code            = buf_clients.host-code
     7165                              buf_user-login-action-role.obj-type             = buf_clients.obj-type
     7166                              buf_user-login-action-role.obj-code             = buf_clients.obj-code
     7167                              buf_user-login-action-role.gds-grp-code         = ?
     7168                              buf_user-login-action-role.gds-code             = ?
     7169                              buf_user-login-action-role.cli-grp-code         = ?
     7170                           .
     7171                           end.
     7172                        end.
     7173                     end.
     7174                  end.
     7175               end.
     7176               else do:
     7177                  _temp-usr-grpa:
     7178                  for each  temp-usr-grpa
     7179                      where temp-usr-grpa.grp-name = temp-grpa.grp-name
     7180                        and temp-usr-grpa.arm-code = temp-grpa.arm-code
     7181                      no-lock
     7182                  on error undo, return error return-value
     7183                  :
     7184                     find first buf_user-login
     7185                          where buf_user-login.db-num     = g#db-num
     7186                            and buf_user-login.user-login = temp-usr-grpa.user-name
     7187                          no-lock
     7188                          no-error .
     7189                     if not available buf_user-login
     7190                     then do:
     7191                                                   next _temp-usr-grpa.
     7192                     end.
     7193                     else do:
     7194                        find first buf_clients no-lock
     7195                           where buf_clients.obj-type = 'орг':U
     7196                           and buf_clients.obj-code = temp-usr-grpa.host-code
     7197                           no-error .
     7198                        if not available buf_clients
     7199                        then do:
     7200                        end.
     7201                        else do:
     7202                           if v-global-action-role-code <> 0
     7203                           then do:
     7204                           assign
     7205                             v-user-login-role-code = dynamic-next-value("s-user-login-action-role":U, "ub":U)
     7206                           .
     7207                           create buf_user-login-action-role .
     7208                           assign
     7209                              buf_user-login-action-role.db-num               = g#db-num
     7210                              buf_user-login-action-role.action-head-code     = 0
     7211                              buf_user-login-action-role.user-login-role-code = v-user-login-role-code
     7212                              buf_user-login-action-role.user-id              = buf_user-login.user-id
     7213                              buf_user-login-action-role.action-role-code     = v-global-action-role-code
     7214                              buf_user-login-action-role.action-role-context  = 'global':U
     7215                              buf_user-login-action-role.host-code            = 0
     7216                              buf_user-login-action-role.obj-type             = '':U
     7217                              buf_user-login-action-role.obj-code             = 0
     7218                              buf_user-login-action-role.gds-grp-code         = ?
     7219                              buf_user-login-action-role.gds-code             = ?
     7220                              buf_user-login-action-role.cli-grp-code         = ?
     7221                           .
     7222                           end.
     7223                           if v-firm-action-role-code <> 0
     7224                           then do:
     7225                           assign
     7226                             v-user-login-role-code = dynamic-next-value("s-user-login-action-role":U, "ub":U)
     7227                           .
     7228                           create buf_user-login-action-role .
     7229                           assign
     7230                              buf_user-login-action-role.db-num               = g#db-num
     7231                              buf_user-login-action-role.action-head-code     = 0
     7232                              buf_user-login-action-role.user-login-role-code = v-user-login-role-code
     7233                              buf_user-login-action-role.user-id              = buf_user-login.user-id
     7234                              buf_user-login-action-role.action-role-code     = v-firm-action-role-code
     7235                              buf_user-login-action-role.action-role-context  = 'firm':U
     7236                              buf_user-login-action-role.host-code            = buf_clients.obj-code
     7237                              buf_user-login-action-role.obj-type             = '':U
     7238                              buf_user-login-action-role.obj-code             = 0
     7239                              buf_user-login-action-role.gds-grp-code         = ?
     7240                              buf_user-login-action-role.gds-code             = ?
     7241                              buf_user-login-action-role.cli-grp-code         = ?
     7242                           .
     7243                           end.
     7244                        end.
     7245                     end.
     7246                  end.
     7247               end.
     7248            end.
     7249         end.
     7250      end case.
     7251      _usr-flt:
     7252      FOR EACH temp-usr-flt:
     7253      END.
     7254   end.
     7255   if p-seq then do:
     7256           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных СЧЕТЧИКИ" ) ).
     7257         _sequencev:
     7258     FOR EACH temp_sequence NO-LOCK:
     7259       FIND FIRST ub._sequence No-LOCK WHERE
     7260                 ub._sequence._seq-name = temp_sequence.seq-name NO-ERROR.
     7261       IF NOT AVAILABLE ubflt.filter then do:
     7262               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных СЧЕТЧИКИ" + chr(10) + " В БД нет СЧЕТЧИКА(sequence):" +                       " название " + string(temp_sequence.seq-name)) )) .              delete temp_sequence.                   NEXT _sequencev.
     7263       end.
     7264       if dynamic-current-value( temp_sequence.seq-name, "ub":U ) < temp_sequence.seq-val then do:
     7265         assign
     7266           dynamic-current-value( temp_sequence.seq-name, "ub":U ) = temp_sequence.seq-val
     7267         .
     7268       end.
     7269     END.
     7270   end.
     7271   session:system-alert-boxes = loc-alert-box.
     7272   procedure p-gen-i :
     7273     do
     7274     on error undo, return error
     7275     :
     7276     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ИНФОРМАЦИЯ O БД" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "gen":U) )) .
     7277     run check-iefile in this-procedure(input p-dir-name,                                      input "gen":U,                                      input "import":U,                                      output loc#log).
     7278     ii = 0.
     7279     if loc#log then do:
     7280       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ИНФОРМАЦИЯ O БД" ) ).
     7281       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "gen":U).
     7282       _gen:
     7283       REPEAT:
     7284         import stream Instream unformatted ss.
     7285         CASE ss:
     7286           when "config":U then do:
     7287             current-table = ss.
     7288             case current-table:
     7289               when "config":U then do:
     7290                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     7291                 create buf-config.
     7292                 CASE p-version:
     7293                   when "12.3" then do:
     7294                     import stream Instream buf-config.conf-type                                 v-log-gap                                            buf-config.host-code                                 buf-config.obj-code                                 buf-config.obj-type                                 buf-config.param-code                                 buf-config.param-encoded                                 buf-config.param-type                                 buf-config.param-value no-error.
     7295                   end.
     7296                   when "14.1" then do:
     7297                     import stream Instream v-arm-code                                 buf-config.conf-type                                 v-grp-name                                 buf-config.host-code                                 buf-config.obj-code                                 buf-config.obj-type                                 buf-config.param-code                                 buf-config.param-encoded                                 buf-config.param-type                                 buf-config.param-value                                 v-user-name no-error.
     7298                   end.
     7299                   otherwise do:
     7300                     import stream Instream buf-config.conf-type                                 buf-config.host-code                                 buf-config.obj-code                                 buf-config.obj-type                                 buf-config.param-code                                 buf-config.param-encoded                                 buf-config.param-type                                 buf-config.param-value no-error.
     7301                   end.
     7302                 END CASE.
     7303                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ИНФОРМАЦИЯ O БД, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _gen.                   end.
     7304                 buf-config.db-num = g#db-num.
     7305                 if buf-config.host-code <> 0
     7306                 and buf-config.host-code <> p-old-host-code then do:
     7307                   delete buf-config.
     7308                   next _gen.
     7309                 end.
     7310                 if buf-config.obj-code <> 0
     7311                 and not (buf-config.obj-type = p-old-obj-type
     7312                         and
     7313                         buf-config.obj-code = p-old-obj-code)
     7314                 then do:
     7315                   delete buf-config.
     7316                   next _gen.
     7317                 end.
     7318                 if buf-config.host-code = p-old-host-code then do:
     7319                   assign
     7320                   buf-config.host-code = p-new-host-code.
     7321                 end.
     7322                 if buf-config.obj-code <> 0
     7323                 and (buf-config.obj-type = p-old-obj-type
     7324                     and
     7325                     buf-config.obj-code = p-old-obj-code)
     7326                 then do:
     7327                   assign
     7328                   buf-config.obj-type = p-new-obj-type
     7329                   buf-config.obj-code = p-new-obj-code
     7330                   .
     7331                 end.
     7332                               IF CAN-FIND(FIRST temp-config No-LOCK WHERE
     7333                                   temp-config.param-code = buf-config.param-code AND
     7334                                   temp-config.host-code = buf-config.host-code AND
     7335                                   temp-config.obj-type = buf-config.obj-type AND
     7336                                   temp-config.obj-code = buf-config.obj-code
     7337                                    )
     7338                                   then do:
     7339                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ИНФОРМАЦИЯ O БД, СТРОКА " + string(ii) + chr(10)) + " Уже есть запись НАСТРОЕЧНОГО ПАРАМЕТРА(config)" +                                   " параметр " + buf-config.param-code +                                   " Фирма " + string(buf-config.host-code) +                                   " тип объекта " + buf-config.obj-type +                                   " код объекта " + string(buf-config.obj-code) ) )) .              delete buf-config.                   NEXT _gen.
     7340                 end.
     7341                 if lookup( buf-config.conf-type, 'к,п':U ) > 0 then do:
     7342                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ИНФОРМАЦИЯ O БД, СТРОКА " + string(ii) + chr(10)) + " НАСТРОЕЧНОГО ПАРАМЕТРА(config) является кодированным" +                                   " параметр " + buf-config.param-code +                                   " Фирма " + string(buf-config.host-code) +                                   " тип объекта " + buf-config.obj-type +                                   " код объекта " + string(buf-config.obj-code) ) )) .              delete buf-config.                   NEXT _gen.
     7343                 end.
     7344                 create temp-config.
     7345                 buffer-copy buf-config to temp-config.
     7346                 delete buf-config.
     7347               end.
     7348             end CASE.
     7349           end.
     7350           otherwise do:
     7351           end.
     7352         END CASE.
     7353       END.
     7354       input stream InStream close.
     7355     end.
     7356     end.
     7357   end procedure.
     7358   procedure p-thb-i :
     7359   define variable v-int1 as integer no-undo .
     7360     do
     7361     on error undo, return error
     7362     :
