     4617               when 'thth14-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
     4618               when 'thth14-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
     4619               when 'thth14-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
     4620               when 'thth14-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
     4621               when 'thth14-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
     4622               when 'thth14-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
     4623               when 'thth14-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
     4624         otherwise do:
     4625           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     4626         end.
     4627       end.
     4628     end.
     4629   end procedure.
     4630   procedure thth14-db-attr-value :
     4631     do
     4632     on error undo, return error
     4633     :
     4634       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     4635       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     4636       define output parameter p-value     like ub.db-attr.attr-value no-undo .
     4637       define output parameter p-type      as character no-undo .
     4638       define buffer buf_db-attr for ub.db-attr .
     4639       define variable v-format         as character no-undo .
     4640       define variable v-label          as character no-undo .
     4641       define variable v-user-can-edit  as logical   no-undo .
     4642       define variable v-output-display as logical   no-undo .
     4643       define variable v-other          as character no-undo .
     4644       run thth14-db-attr-code in this-procedure
     4645         (input  p-code
     4646         ,output p-type
     4647         ,output v-format
     4648         ,output v-label
     4649         ,output v-user-can-edit
     4650         ,output v-output-display
     4651         ,output v-other
     4652         ) no-error .
     4653       if error-status :error then do:
     4654         undo, return error return-value .
     4655       end.
     4656       find first buf_db-attr no-lock
     4657         where buf_db-attr.db-num    = p-db-num
     4658           and buf_db-attr.attr-code = p-code
     4659         no-error .
     4660       if avail buf_db-attr then do:
     4661         assign
     4662           p-value =  buf_db-attr.attr-value
     4663         .
     4664       end.
     4665       else do:
     4666         assign
     4667           p-value = if p-type = 'L':U then "no":U else ""
     4668         .
     4669       end.
     4670     end.
     4671   end procedure.
     4672   procedure thth14-db-attr-write :
     4673     do
     4674     on error undo, return error
     4675     :
     4676       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     4677       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     4678       define input parameter p-value     like ub.db-attr.attr-value no-undo .
     4679       define buffer buf_db-attr for ub.db-attr .
     4680       define variable v-type           as character no-undo .
     4681       define variable v-format         as character no-undo .
     4682       define variable v-label          as character no-undo .
     4683       define variable v-user-can-edit  as logical   no-undo .
     4684       define variable v-output-display as logical   no-undo .
     4685       define variable v-other          as character no-undo .
     4686       run thth14-db-attr-code in this-procedure
     4687         (input  p-code
     4688         ,output v-type
     4689         ,output v-format
     4690         ,output v-label
     4691         ,output v-user-can-edit
     4692         ,output v-output-display
     4693         ,output v-other
     4694         ) no-error .
     4695       if error-status :error then do:
     4696         undo, return error return-value .
     4697       end.
     4698       find first buf_db-attr exclusive-lock
     4699         where buf_db-attr.db-num    = p-db-num
     4700           and buf_db-attr.attr-code = p-code
     4701         no-error .
     4702       if not available buf_db-attr then do:
     4703         create buf_db-attr .
     4704         assign
     4705           buf_db-attr.db-num    = p-db-num
     4706           buf_db-attr.attr-code = p-code
     4707         .
     4708       end.
     4709       assign
     4710         buf_db-attr.attr-value = p-value
     4711       .
     4712     end.
     4713   end procedure.
     4714   procedure thth14-db-attr-exist :
     4715     do
     4716     on error undo, return error
     4717     :
     4718       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     4719       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     4720       define output parameter p-exist    as logical  no-undo .
     4721       define buffer buf_db-attr for ub.db-attr .
     4722       define variable v-type           as character no-undo .
     4723       define variable v-format         as character no-undo .
     4724       define variable v-label          as character no-undo .
     4725       define variable v-user-can-edit  as logical   no-undo .
     4726       define variable v-output-display as logical   no-undo .
     4727       define variable v-other          as character no-undo .
     4728       run thth14-db-attr-code in this-procedure
     4729         (input  p-code
     4730         ,output v-type
     4731         ,output v-format
     4732         ,output v-label
     4733         ,output v-user-can-edit
     4734         ,output v-output-display
     4735         ,output v-other
     4736         ) no-error .
     4737       if error-status :error then do:
     4738         undo, return error return-value .
     4739       end.
     4740       find first buf_db-attr no-lock
     4741         where buf_db-attr.db-num    = p-db-num
     4742           and buf_db-attr.attr-code = p-code
     4743         no-error .
     4744       if  available buf_db-attr then do:
     4745         p-exist = yes.
     4746       end.
     4747     end.
     4748   end procedure.
     4749   procedure thth14-db-attr-delete :
     4750     do
     4751     on error undo, return error
     4752     :
     4753       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
     4754       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     4755       define output parameter p-deleted  as logical no-undo.
     4756       define buffer buf_db-attr for ub.db-attr .
     4757       define variable v-type           as character no-undo .
     4758       define variable v-format         as character no-undo .
     4759       define variable v-label          as character no-undo .
     4760       define variable v-user-can-edit  as logical   no-undo .
     4761       define variable v-output-display as logical   no-undo .
     4762       define variable v-other          as character no-undo .
     4763       run thth14-db-attr-code in this-procedure
     4764         (input  p-code
     4765         ,output v-type
     4766         ,output v-format
     4767         ,output v-label
     4768         ,output v-user-can-edit
     4769         ,output v-output-display
     4770         ,output v-other
     4771         ) no-error .
     4772       if error-status :error then do:
     4773         undo, return error return-value .
     4774       end.
     4775       find first buf_db-attr exclusive-lock
     4776         where buf_db-attr.db-num    = p-db-num
     4777           and buf_db-attr.attr-code = p-code
     4778         no-error NO-WAIT.
     4779       if not available buf_db-attr then do:
     4780         p-deleted = no.
     4781       end.
     4782       else do:
     4783         delete buf_db-attr.
     4784         p-deleted = yes.
     4785       end.
     4786     end.
     4787   end procedure.
     4788   procedure thth14-db-attr-news :
     4789     do
     4790     on error undo, return error
     4791     :
     4792       define input  parameter p-code           as character no-undo .
     4793       define output parameter p-news           as logical   no-undo .
     4794       case p-code :
     4795               when 'thth14-cli-grp':U then do:     assign     p-news = no.   end.
     4796               when 'thth14-gds-grp':U then do:     assign     p-news = no.   end.
     4797               when 'thth14-clients':U then do:     assign     p-news = no.   end.
     4798               when 'thth14-goods':U then do:     assign     p-news = no.   end.
     4799               when 'thth14-dis-card':U then do:     assign     p-news = no.   end.
     4800               when 'thth14-qnty-dis-card':U then do:     assign     p-news = no.   end.
     4801               when 'thth14-shop':U then do:     assign     p-news = no.   end.
     4802               when 'thth14-contract':U then do:     assign     p-news = no.   end.
     4803               when 'thth14-price-doc':U then do:     assign     p-news = no.   end.
     4804               when 'thth14-trn-doc':U then do:     assign     p-news = no.   end.
     4805         otherwise do:
     4806           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     4807         end.
     4808       end.
     4809     end.
     4810   end procedure.
