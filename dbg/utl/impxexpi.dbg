     4999   define buffer buf_thbj-attr for ub.thbj-attr.
     5000   assign
     5001   p-rht  = logical(entry(1 , p-parameter, chr(4)))
     5002   p-gen  = logical(entry(2 , p-parameter, chr(4)))
     5003   p-flt  = logical(entry(3 , p-parameter, chr(4)))
     5004   p-pbc  = logical(entry(4 , p-parameter, chr(4)))
     5005   p-scl  = logical(entry(5 , p-parameter, chr(4)))
     5006   p-usr  = logical(entry(6 , p-parameter, chr(4)))
     5007   p-seq  = logical(entry(7 , p-parameter, chr(4)))
     5008   p-cdrg = logical(entry(8, p-parameter, chr(4)))
     5009   p-cdk = logical(entry(9, p-parameter, chr(4)))
     5010   p-thb = logical(entry(10, p-parameter, chr(4)))
     5011   p-pet = logical(entry(11, p-parameter, chr(4)))
     5012   p-db-key = entry(12, p-parameter, chr(4))
     5013   p-dir-name  = entry(13, p-parameter, chr(4))
     5014   p-glb       = logical(entry(14, p-parameter, chr(4)))
     5015   p-version   = entry(15, p-parameter, chr(4))
     5016   p-old-host-code = integer(entry(16, p-parameter, chr(4)))
     5017   p-new-host-code = integer(entry(17, p-parameter, chr(4)))
     5018   p-old-obj-type  = entry(18, p-parameter, chr(4))
     5019   p-new-obj-type  = entry(19, p-parameter, chr(4))
     5020   p-old-obj-code  = integer(entry(20, p-parameter, chr(4)))
     5021   p-new-obj-code  = integer(entry(21, p-parameter, chr(4)))
     5022   p-from-version = entry(22, p-parameter, chr(4))
     5023   no-error
     5024   .
     5025   if error-status:error then return error substitute("&1 &2", error-status:get-message(1) , return-value ).
     5026   case p-from-version:
     5027     when 'v15_0000':U then do:
     5028       v-classif-name = 'th-th150_goods':U.
     5029       v-cli-classif-name = 'th-th150_goods':U.
     5030     end.
     5031     when 'v14_0':U then do:
     5032       v-classif-name = 'th-th14_goods':U.
     5033       v-cli-classif-name = 'th-th14_goods':U.
     5034     end.
     5035     otherwise do:
     5036       message
     5037       substitute("Неверное значение параметра p-from-version=&1", p-from-version)
     5038       view-as alert-box error .
     5039       undo, return error .
     5040     end.
     5041   end case.
     5042   define buffer buf_clients for ub.clients.
     5043   find first buf_clients no-lock where
     5044             buf_clients.obj-type = p-new-obj-type
     5045        and  buf_clients.obj-code = p-new-obj-code no-error.
     5046   if not available buf_clients then do:
     5047     message
     5048     substitute("Не найден объект &1&2 указанный как НОВЫЙ", p-new-obj-type, p-new-obj-code)
     5049     view-as alert-box error .
     5050     return .
     5051   end.
     5052   if buf_clients.db-num <> g#db-num then do:
     5053     message
     5054     substitute("Импорт локальных данных возможен только в БД объекта &1&2 указанного как НОВЫЙ", p-new-obj-type, p-new-obj-code)
     5055     view-as alert-box error .
     5056     return .
     5057   end.
     5058   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", " Импорт локальных таблиц" )) .
     5059   if p-gen then do:
     5060     run p-gen-i in this-procedure .
     5061   end.
     5062   if p-cdrg then do:
     5063     run p-cdrg-i in this-procedure .
     5064   end.
     5065   if p-thb then do:
     5066     run p-thb-i in this-procedure.
     5067   end.
     5068   if p-flt then do:
     5069     run p-flt-i in this-procedure .
     5070   end.
     5071   if p-scl then do:
     5072     run p-scl-i in this-procedure .
     5073   end.
     5074   if p-seq then do:
     5075     run p-seq-i in this-procedure .
     5076   end.
     5077   if p-pbc then do:
     5078     run p-pbc-i in this-procedure .
     5079   end.
     5080   if p-cdk then do:
     5081     run p-cdk-i in this-procedure.
     5082   end.
     5083   if p-rht then do:
     5084     run p-rht-i in this-procedure .
     5085   end.
     5086   if p-usr then do:
     5087      run p-usr-i in this-procedure .
     5088   end.
     5089   ii = 0.
     5090   if p-gen then do:
     5091           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ИНФОРМАЦИЯ О БД (НАСТРОЙКИ)" ) ).
     5092         _configv:
     5093     FOR EACH temp-config:
     5094       find first ub.config no-lock where
     5095                 ub.config.param-code = temp-config.param-code
     5096             AND ub.config.host-code = 0
     5097             AND ub.config.obj-type = '':U
     5098             AND ub.config.obj-code = 0
     5099       NO-ERROR.
     5100       if not available ub.config then do:
     5101                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД (НАСТРОЙКИ)" + chr(10) + " НАСТРОЕЧНЫЙ ПАРАМЕТР(config)" +                                         " " + temp-config.param-code +                                         " Фирма " + string(temp-config.host-code) +                                         " тип объекта " + temp-config.obj-type +                                         " код объекта " + string(temp-config.obj-code) +                                         " не является валидным в данной конфигурации" ) )) .              delete temp-config.                   NEXT _configv.
     5102       end.
     5103       if lookup(ub.config.conf-type, 'к,п':U) > 0
     5104       then do:
     5105                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД (НАСТРОЙКИ)" + chr(10) + " НАСТРОЕЧНЫЙ ПАРАМЕТР(config)" +                                         " " + temp-config.param-code +                                         " является кодированным - импорт запрещен" ) )) .              delete temp-config.                   NEXT _configv.
     5106       end.
     5107       FIND FIRST ext_config No-LOCK WHERE
     5108                 ext_config.param-code = temp-config.param-code AND
     5109                 ext_config.host-code = temp-config.host-code AND
     5110                 ext_config.obj-type = temp-config.obj-type AND
     5111                 ext_config.obj-code = temp-config.obj-code
     5112       NO-ERROR.
     5113       IF AVAILABLE ext_config then do:
     5114                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД (НАСТРОЙКИ)" + chr(10) + " Уже есть запись НАСТРОЕЧНОГО ПАРАМЕТРА(config)" +                                         " параметр " + temp-config.param-code +                                         " Фирма " + string(temp-config.host-code) +                                         " тип объекта " + temp-config.obj-type +                                         " код объекта " + string(temp-config.obj-code) ) )) .              delete temp-config.                   NEXT _configv.
     5115       end.
     5116       if temp-config.host-code > 0 then do:
     5117         FIND FIRST ub.sysconf No-LOCK WHERE
     5118                   ub.sysconf.host-code = temp-config.host-code No-ERROR.
     5119         IF NOT AVAIL ub.sysconf then do:
     5120                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД (НАСТРОЙКИ)" + chr(10) + " Отсутствует фирма для НАСТРОЕЧНОГО ПАРАМЕТРА(config)" +                                           " параметр " + temp-config.param-code +                                           " Фирма " + string(temp-config.host-code) +                                           " тип объекта " + temp-config.obj-type +                                           " код объекта " + string(temp-config.obj-code) ) )) .              delete temp-config.                   NEXT _configv.
     5121         END.
     5122       end.
     5123       if temp-config.obj-type <> "" or temp-config.obj-code > 0 then do:
     5124         FIND FIRST ub.clients No-LOCK WHERE
     5125                   ub.clients.obj-type = temp-config.obj-type AND
     5126                   ub.clients.obj-code = temp-config.obj-code NO-ERROR.
     5127         IF NOT AVAIL ub.clients then do:
     5128                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД (НАСТРОЙКИ)" + chr(10) + " Отсутствует объект для НАСТРОЕЧНОГО ПАРАМЕТРА(config)" +                                           " параметр " + temp-config.param-code +                                           " Фирма " + string(temp-config.host-code) +                                           " тип объекта " + temp-config.obj-type +                                           " код объекта " + string(temp-config.obj-code) ) )) .              delete temp-config.                   NEXT _configv.
     5129         END.
     5130         IF ub.clients.db-num <> ub.db.db-num then do:
     5131                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД (НАСТРОЙКИ)" + chr(10) + " Объект для НАСТРОЕЧНОГО ПАРАМЕТРА(config) принадлежит другой БД" +                                           " параметр " + temp-config.param-code +                                           " Фирма " + string(temp-config.host-code) +                                           " тип объекта " + temp-config.obj-type +                                           " код объекта " + string(temp-config.obj-code) ) )) .              delete temp-config.                   NEXT _configv.
     5132         END.
     5133       end.
     5134       create buf_config.
     5135       buffer-copy ub.config to buf_config
     5136       assign
     5137       buf_config.host-code = temp-config.host-code
     5138       buf_config.obj-type = temp-config.obj-type
     5139       buf_config.obj-code = temp-config.obj-code
     5140       buf_config.param-value = temp-config.param-value
     5141       .
     5142       release buf_config no-error.
     5143       if error-status:error then do:
     5144         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     5145               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД (НАСТРОЙКИ)" + chr(10) +  " ошибка при сохранении НАСТРОЕЧНОГО ПАРАМЕТРA(config):" +                                       " параметр " + temp-config.param-code +                                       " Фирма " + string(temp-config.host-code) +                                       " тип объекта " + temp-config.obj-type +                                       " код объекта " + string(temp-config.obj-code) +                                       er-mes) )) .                NEXT _configv.
     5146       end.
     5147     END.
     5148   end.
     5149   if p-thb then do:
     5150           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ПАРАМЕТРЫ" ) ).
     5151         _thbj-attrv:
     5152     FOR EACH temp-thbj-attr:
     5153       if temp-thbj-attr.obj-type <> "" or temp-thbj-attr.obj-code > 0 then do:
     5154         FIND FIRST ub.clients No-LOCK WHERE
     5155                   ub.clients.obj-type = temp-thbj-attr.obj-type AND
     5156                   ub.clients.obj-code = temp-thbj-attr.obj-code NO-ERROR.
     5157         IF NOT AVAIL ub.clients then do:
     5158                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПАРАМЕТРЫ" + chr(10) + " Отсутствует объект для НАСТРОЕЧНОГО ПАРАМЕТРА(thbj-attr)" +                                          " секция " + temp-thbj-attr.upper-prop-code +                                           " параметр " + temp-thbj-attr.prop-code +                                           " тип объекта " + temp-thbj-attr.obj-type +                                           " код объекта " + string(temp-thbj-attr.obj-code) ) )) .              delete temp-thbj-attr.                   NEXT _thbj-attrv.
     5159         END.
     5160         IF (ub.clients.obj-type = 'маг':U
     5161         or ub.clients.obj-type = 'скл':U)
     5162         and ub.clients.db-num <> ub.db.db-num then do:
     5163                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПАРАМЕТРЫ" + chr(10) + " Объект для НАСТРОЕЧНОГО ПАРАМЕТРА(thbj-attr) принадлежит другой БД" +                                          " секция " + temp-thbj-attr.upper-prop-code +                                           " параметр " + temp-thbj-attr.prop-code +                                           " тип объекта " + temp-thbj-attr.obj-type +                                           " код объекта " + string(temp-thbj-attr.obj-code) ) )) .              delete temp-thbj-attr.                   NEXT _thbj-attrv.
     5164         END.
     5165       end.
     5166       FIND FIRST buf_thbj-attr WHERE
     5167                 buf_thbj-attr.prop-code = temp-thbj-attr.prop-code AND
     5168                 buf_thbj-attr.upper-prop-code = temp-thbj-attr.upper-prop-code AND
     5169                 buf_thbj-attr.obj-type = temp-thbj-attr.obj-type AND
     5170                 buf_thbj-attr.obj-code = temp-thbj-attr.obj-code
     5171       NO-ERROR.
     5172       if not available buf_thbj-attr then do:
     5173         create buf_thbj-attr.
     5174         assign
     5175         buf_thbj-attr.upper-prop-code = temp-thbj-attr.upper-prop-code
     5176         buf_thbj-attr.prop-code = temp-thbj-attr.prop-code
     5177         buf_thbj-attr.obj-type = temp-thbj-attr.obj-type
     5178         buf_thbj-attr.obj-code = temp-thbj-attr.obj-code
     5179         buf_thbj-attr.prop-value-type = temp-thbj-attr.prop-value-type
     5180         .
     5181       end.
     5182       assign
     5183       buf_thbj-attr.property-value-character = temp-thbj-attr.property-value-character
     5184       buf_thbj-attr.property-value-date = temp-thbj-attr.property-value-date
     5185       buf_thbj-attr.property-value-decimal = temp-thbj-attr.property-value-decimal
     5186       buf_thbj-attr.property-value-integer = temp-thbj-attr.property-value-integer
     5187       buf_thbj-attr.property-value-logical = temp-thbj-attr.property-value-logical
     5188       .
     5189       release buf_thbj-attr no-error.
     5190       if error-status:error then do:
     5191         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     5192               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПАРАМЕТРЫ" + chr(10) +  " ошибка при сохранении НАСТРОЕЧНОГО ПАРАМЕТРA(thbj-attr):" +                                       " параметр " + temp-thbj-attr.prop-code +                                       " тип объекта " + temp-thbj-attr.obj-type +                                       " код объекта " + string(temp-thbj-attr.obj-code) +                                       er-mes) )) .                NEXT _thbj-attrv.
     5193       end.
     5194     END.
     5195   end.
     5196   if p-cdrg then do:
     5197     find first ub.sys-ctrl no-lock .
     5198     if ub.sys-ctrl.db-num = 0 then do:
     5199                   run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ" ) ).
     5200               find first temp-code-range no-lock
     5201         where temp-code-range.range-type = 'sclc':U
     5202            or temp-code-range.range-type = 'scgb':U
     5203            or temp-code-range.range-type = 'pglc':U
     5204         no-error .
     5205       if available temp-code-range then do:
     5206         on delete of ub.code-range override do: end.
     5207         for each ub.code-range exclusive-lock
     5208           where ub.code-range.range-type = 'sclc':U
     5209              or ub.code-range.range-type = 'scgb':U
     5210              or ub.code-range.range-type = 'pglc':U
     5211         on error  undo, retry
     5212         on stop   undo, retry
     5213         on endkey undo, retry
     5214         :
     5215           if retry then do:
     5216                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ" + chr(10) + " Ошибка при удалении диапазонов кодов (code-range)" ) )) .
     5217           end.
     5218           delete ub.code-range .
     5219         end.
     5220         _code-rg:
     5221         FOR EACH temp-code-range NO-LOCK
     5222           where temp-code-range.range-type = 'sclc':U
     5223              or temp-code-range.range-type = 'scgb':U
     5224              or temp-code-range.range-type = 'pglc':U
     5225         :
     5226           create ub.code-range.
     5227           buffer-copy temp-code-range to ub.code-range.
     5228           release ub.code-range no-error.
