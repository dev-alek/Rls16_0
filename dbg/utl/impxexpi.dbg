     1596           case p-action :
     1597             when "get-m-code":U then do:
     1598               assign
     1599                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1600               .
     1601             end.
     1602             when "f-u":U then do:
     1603               assign
     1604                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1605               .
     1606               run mark-all-used-as-free in this-procedure (
     1607                                          input  p-db-num
     1608                                         ,input  p-curr-type-cdrg
     1609                                         ,output str-u-f
     1610                                         ,output str-u-f-rng
     1611                                       ).
     1612             end.
     1613           end case.
     1614           view frame get-max-code-inf.
     1615           assign
     1616             rec-cnt = 0
     1617           .
     1618           display
     1619             rec-cnt
     1620             with frame get-max-code-inf
     1621           .
     1622           for each buf_units no-lock
     1623               where lookup('вес':U, buf_units.type) > 0
     1624           on error undo, return error
     1625           :
     1626             for each buf_goods no-lock
     1627               where buf_goods.unit-base = buf_units.unit-name
     1628             on error undo, return error
     1629             :
     1630               assign
     1631                 rec-cnt = rec-cnt + 1
     1632               .
     1633               if ( rec-cnt modulo 10 ) = 0 then do:
     1634                 display
     1635                   rec-cnt
     1636                   with frame get-max-code-inf
     1637                 .
     1638               end.
     1639               run mc_gdsbcode in this-procedure (
     1640                                input  buf_goods.gds-code
     1641                               ,input  ?
     1642                               ,output v-main-bcode
     1643                             ) no-error .
     1644               if error-status :error then do:
     1645                 message
     1646                   vss-workfile vss-revision vss-description skip
     1647                   "Ошибка при поиске корневого бар-кода" skip
     1648                   "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     1649                   error-status :get-message(1) skip
     1650                   return-value skip
     1651                   view-as alert-box error .
     1652                 undo, return error .
     1653               end.
     1654               for each buf_prod-bc no-lock
     1655                   where buf_prod-bc.b-code = v-main-bcode
     1656               on error undo, return error
     1657               :
     1658                 if p-curr-type-cdrg = 'sclc':U
     1659                   and buf_prod-bc.bc-on = FALSE
     1660                 then do:
     1661                   next.
     1662                 end.
     1663                 run mc_prodbcat in this-procedure (
     1664                                  buffer buf_prod-bc
     1665                                 ,input  'global=request':u
     1666                                 ,output l-prod-bc-global
     1667                               ) no-error .
     1668                 if error-status :error then do:
     1669                   message
     1670                     vss-workfile vss-revision vss-description skip
     1671                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1672                     "Основной бар-код" buf_prod-bc.b-code skip
     1673                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1674                     "Действие global=request" skip
     1675                     error-status :get-message(1) skip
     1676                     return-value skip
     1677                     view-as alert-box error .
     1678                   undo, return error .
     1679                 end.
     1680                 run mc_prodbcat in this-procedure (
     1681                                  buffer buf_prod-bc
     1682                                 ,input  'weight=request':u
     1683                                 ,output l-prod-bc-weight
     1684                               ) no-error .
     1685                 if error-status :error then do:
     1686                   message
     1687                     vss-workfile vss-revision vss-description skip
     1688                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1689                     "Основной бар-код" buf_prod-bc.b-code skip
     1690                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1691                     "Действие weight=request" skip
     1692                     error-status :get-message(1) skip
     1693                     return-value skip
     1694                     view-as alert-box error .
     1695                   undo, return error .
     1696                 end.
     1697                 if l-prod-bc-weight
     1698                   and ( ( l-prod-bc-global
     1699                           and p-curr-type-cdrg = 'scgb':U
     1700                         )
     1701                         or
     1702                         ( not l-prod-bc-global
     1703                           and p-curr-type-cdrg = 'sclc':U
     1704                         )
     1705                       )
     1706                 then do:
     1707                   case p-action :
     1708                     when "get-m-code":U then do:
     1709                       if integer( buf_prod-bc.b-str ) >= p-first-code
     1710                         and integer( buf_prod-bc.b-str ) <= p-last-code
     1711                         and integer( buf_prod-bc.b-str ) > v-b-code
     1712                       then do:
     1713                         assign
     1714                           v-b-code = integer( buf_prod-bc.b-str )
     1715                         .
     1716                       end.
     1717                     end.
     1718                     when "f-u":U then do:
     1719                       for each buf_code-range
     1720                         where buf_code-range.db-num     = p-db-num
     1721                           and buf_code-range.range-type = p-curr-type-cdrg
     1722                           and buf_code-range.stts       = "f":U
     1723                           and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1724                           and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1725                       on error undo, return error
     1726                       :
     1727                         assign
     1728                           buf_code-range.stts = "u":U
     1729                         .
     1730                         if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1731                           assign
     1732                             str-u-f-rng = diff-list( str-u-f-rng
     1733                                                     ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1734                                                     ,",":U
     1735                                                     )
     1736                           .
     1737                         end.
     1738                         if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1739                           assign
     1740                             v-b-code = v-b-code + 1
     1741                             v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1742                                                     + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1743                                                     , chr(10)
     1744                                                     , buf_code-range.first-code
     1745                                                     , buf_code-range.last-code
     1746                                                     , buf_prod-bc.b-str
     1747                                                   )
     1748                             v-ret-msg = v-ret-msg + v-msg
     1749                           .
     1750                           if p-view-mess = true then do:
     1751                             message
     1752                               v-msg
     1753                               view-as alert-box information.
     1754                           end.
     1755                         end.
     1756                       end.
     1757                     end.
     1758                   end case.
     1759                 end.
     1760               end.
     1761             end.
     1762           end.
     1763           if p-action = "f-u":U then do:
     1764             do ind = 1 to num-entries( str-u-f-rng ):
     1765               assign
     1766                 v-b-code  = v-b-code + 1
     1767                 v-msg     = substitute( "Диапазон кодов &2&1"
     1768                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1769                                         , chr(10)
     1770                                         , entry( ind, str-u-f-rng )
     1771                                       )
     1772                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1773               .
     1774               if p-view-mess = true then do:
     1775                 message
     1776                   v-msg
     1777                   view-as alert-box information.
     1778               end.
     1779             end.
     1780           end.
     1781           hide frame get-max-code-inf no-pause .
     1782         end.
     1783         when 'pglc':U
     1784         then do:
     1785           case p-action :
     1786             when "get-m-code":U then do:
     1787               assign
     1788                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1789               .
     1790             end.
     1791             when "f-u":U then do:
     1792               assign
     1793                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1794               .
     1795               run mark-all-used-as-free in this-procedure (
     1796                                          input  p-db-num
     1797                                         ,input  p-curr-type-cdrg
     1798                                         ,output str-u-f
     1799                                         ,output str-u-f-rng
     1800                                       ).
     1801             end.
     1802           end case.
     1803           view frame get-max-code-inf.
     1804           assign
     1805             rec-cnt = 0
     1806           .
     1807           display
     1808             rec-cnt
     1809             with frame get-max-code-inf
     1810           .
     1811           for each buf_prod-bc no-lock where
     1812                   buf_prod-bc.b-str >= "00100"
     1813               and buf_prod-bc.b-str <= "99999"
     1814               and buf_prod-bc.bc-on-type = 'pglc':U
     1815               and length(buf_prod-bc.b-str) = 5
     1816           on error undo, return error
     1817           :
     1818               assign
     1819                 rec-cnt = rec-cnt + 1
     1820               .
     1821               if ( rec-cnt modulo 10 ) = 0 then do:
     1822                 display
     1823                   rec-cnt
     1824                   with frame get-max-code-inf
     1825                 .
     1826               end.
     1827               if p-curr-type-cdrg = 'pglc':U
     1828                 and buf_prod-bc.bc-on = FALSE
     1829               then do:
     1830                 next.
     1831               end.
     1832               run mc_prodbcat in this-procedure (
     1833                                 buffer buf_prod-bc
     1834                               ,input  'pgweight=request':u
     1835                               ,output l-prod-bc-pgweight
     1836                             ) no-error .
     1837               if error-status :error then do:
     1838                 message
     1839                   vss-workfile vss-revision vss-description skip
     1840                   "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1841                   "Основной бар-код" buf_prod-bc.b-code skip
     1842                   "Дополнительный бар-код" buf_prod-bc.b-str skip
     1843                   "Действие weight=request" skip
     1844                   error-status :get-message(1) skip
     1845                   return-value skip
     1846                   view-as alert-box error .
     1847                 undo, return error .
     1848               end.
     1849               if l-prod-bc-pgweight
     1850               and p-curr-type-cdrg = 'pglc':U
     1851               then do:
     1852                 case p-action :
     1853                   when "get-m-code":U then do:
     1854                     if integer( buf_prod-bc.b-str ) >= p-first-code
     1855                       and integer( buf_prod-bc.b-str ) <= p-last-code
     1856                       and integer( buf_prod-bc.b-str ) > v-b-code
     1857                     then do:
     1858                       assign
     1859                         v-b-code = integer( buf_prod-bc.b-str )
     1860                       .
     1861                     end.
     1862                   end.
     1863                   when "f-u":U then do:
     1864                     for each buf_code-range
     1865                       where buf_code-range.db-num     = p-db-num
     1866                         and buf_code-range.range-type = p-curr-type-cdrg
     1867                         and buf_code-range.stts       = "f":U
     1868                         and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1869                         and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1870                     on error undo, return error
     1871                     :
     1872                     assign
     1873                     buf_code-range.stts = "u":U
     1874                       .
     1875                     if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1876                         assign
     1877                           str-u-f-rng = diff-list( str-u-f-rng
     1878                                                   ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1879                                                   ,",":U
     1880                                                   )
     1881                         .
     1882                     end.
     1883                     if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1884                         assign
     1885                           v-b-code = v-b-code + 1
     1886                           v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1887                                                   + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1888                                                   , chr(10)
     1889                                                   , buf_code-range.first-code
     1890                                                   , buf_code-range.last-code
     1891                                                   , buf_prod-bc.b-str
     1892                                                 )
     1893                           v-ret-msg = v-ret-msg + v-msg
     1894                         .
     1895                       if p-view-mess = true then do:
     1896                         message
     1897                           v-msg
     1898                           view-as alert-box information.
     1899                       end.
     1900                     end.
     1901                   end.
     1902                 end.
     1903               end case.
     1904             end.
     1905           end.
     1906           if p-action = "f-u":U then do:
     1907             do ind = 1 to num-entries( str-u-f-rng ):
     1908               assign
     1909                 v-b-code = v-b-code + 1
     1910                 v-msg     = substitute( "Диапазон кодов &2&1"
     1911                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1912                                         , chr(10)
     1913                                         , entry( ind, str-u-f-rng )
     1914                                       )
     1915                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1916               .
     1917               if p-view-mess = true then do:
     1918                 message
     1919                   v-msg
     1920                   view-as alert-box information.
     1921               end.
     1922             end.
     1923           end.
     1924           hide frame get-max-code-inf no-pause .
     1925         end.
     1926         otherwise do:
     1927           message
     1928             vss-workfile vss-revision vss-description skip
     1929             "get-max-code" skip
     1930             "Непредусмотрена обработка диапазона кодов " p-curr-type-cdrg
     1931             view-as alert-box error.
     1932           return error.
     1933         end.
     1934       end case.
     1935     end.
     1936     return v-ret-msg.
     1937   end procedure.
     1938   procedure mark-all-used-as-free :
     1939     define input  parameter p-db-num         like ub.db.db-num             no-undo .
     1940     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
     1941     define output parameter p-str-u-f        as   character                 no-undo .
     1942     define output parameter p-str-u-f-rng    as   character                 no-undo .
     1943     do
     1944     on error undo, return error
     1945     :
     1946       define buffer buf_code-range   for ub.code-range.
     1947       define buffer buf-c_code-range for ub.code-range .
     1948       assign
     1949         p-str-u-f     = "":U
     1950         p-str-u-f-rng = "":U
     1951       .
     1952       for each buf_code-range share-lock
     1953           where buf_code-range.db-num     = p-db-num
     1954             and buf_code-range.range-type = p-curr-type-cdrg
     1955             and buf_code-range.stts       = "u":U
     1956       on error undo, return error
     1957       :
     1958         find first buf-c_code-range exclusive-lock
     1959           where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1960         .
     1961         assign
     1962           buf-c_code-range.stts = "c":U
     1963         .
     1964         release buf-c_code-range .
     1965         assign
     1966           buf_code-range.stts = "f":U
     1967           p-str-u-f     = p-str-u-f + ",":U + buf_code-range.range-type + chr(3) + string( buf_code-range.first-code )
     1968           p-str-u-f-rng = p-str-u-f-rng + ",":U + string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1969         .
     1970       end.
     1971       assign
     1972         p-str-u-f     = substring( p-str-u-f, 2, length( p-str-u-f ) - 1 )
     1973         p-str-u-f-rng = substring( p-str-u-f-rng, 2, length( p-str-u-f-rng ) - 1 )
     1974       .
     1975     end.
     1976   end procedure.
     1977   procedure mc_prodbcat :
     1978     do
     1979     on error undo, return error
     1980     :
     1981       define parameter buffer buf_prod-bc  for ub.prod-bc .
     1982       define input  parameter p-action           as character no-undo .
     1983       define output parameter p-return-attribute as logical no-undo .
     1984       def var vss-description as character no-undo init "prodbcat-01: определение параметров дополнительного бар-кода".
     1985       define buffer buf_bar-code   for ub.bar-code   .
     1986       define buffer buf_units      for ub.units      .
     1987       define buffer buf_code-range for ub.code-range .
     1988       define variable p-code-int as integer no-undo .
     1989       define variable v-cdrg-type as character no-undo .
     1990       if not available buf_prod-bc then do:
     1991         message
     1992           vss-workfile vss-revision vss-description skip
     1993           "Ошибка задания входных параметров" skip
     1994           "Не задан дополнительный бар-код" skip
     1995           view-as alert-box error .
     1996         undo, return error .
     1997       end.
     1998       find first buf_bar-code no-lock
     1999         where buf_bar-code.b-code = buf_prod-bc.b-code
     2000         no-error .
     2001       if not available buf_bar-code then do:
     2002         message
     2003           vss-workfile vss-revision vss-description skip
     2004           "Неправильная ссылка на основной бар-код" skip
     2005           "Основной бар-код" buf_prod-bc.b-code skip
     2006           "Дополнительный бар-код" buf_prod-bc.b-str skip
     2007           view-as alert-box error .
     2008         undo, return error .
     2009       end.
     2010       find first buf_units no-lock
     2011         where buf_units.unit-name = buf_bar-code.unit-cli
     2012         no-error .
     2013       if not available buf_units then do:
     2014         message
     2015           vss-workfile vss-revision vss-description skip
     2016           "Не найдена единица измерения основного бар-кода" skip
     2017           "Основной бар-код" buf_bar-code.b-code skip
     2018           "Единица измерения" buf_bar-code.unit-cli skip
     2019           view-as alert-box error .
     2020         undo, return error .
     2021       end.
     2022       def var ind                    as integer   no-undo .
     2023       def var v-num-entries-p-action as integer   no-undo .
     2024       def var v-action               as character no-undo .
     2025       assign
     2026         v-num-entries-p-action = num-entries(p-action)
     2027       .
     2028       assign
     2029         p-return-attribute = true
     2030       .
     2031       _ind:
     2032       do ind = 1 to v-num-entries-p-action
     2033       :
     2034        if ind > 1 and p-return-attribute = false then return.
     2035         assign
     2036           v-action = entry(ind, p-action)
     2037         .
     2038         case v-action :
     2039           when "global=request":u
     2040           then do:
     2041             if not (buf_prod-bc.bc-on-type = ''
     2042             or buf_prod-bc.bc-on-type = 'scgb':U
     2043             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2044               assign
     2045                 p-return-attribute = false
     2046               .
     2047             end.
     2048           end.
     2049           when "weight=request":u
     2050           then do:
     2051             if not (buf_prod-bc.bc-on-type = 'sclc':U
     2052             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     2053               assign
     2054                 p-return-attribute = false.
     2055             end.
     2056           end.
     2057           when "pgweight=request":u
     2058           then do:
     2059             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     2060               assign
     2061                 p-return-attribute = false.
     2062             end.
     2063           end.
     2064           when "petrolium=request":u
     2065           then do:
     2066             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     2067               assign
     2068                 p-return-attribute = false.
     2069             end.
     2070           end.
     2071           when "scaleable=request":u
     2072           then do:
     2073             if not (buf_prod-bc.bc-on-type = 'sslc':U
     2074             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2075               assign
     2076                 p-return-attribute = false.
     2077             end.
     2078           end.
     2079           otherwise do:
     2080             message
     2081               vss-workfile vss-revision vss-description skip
     2082               "Неизвестное значение параметра v-action " skip
     2083               "v-action" v-action skip
     2084               "p-action" p-action skip
     2085               view-as alert-box error .
     2086             undo, return error .
     2087           end.
     2088         end case.
     2089       end.
     2090     end.
     2091   end procedure.
     2092   procedure mc_gdsbcode :
     2093     define input  parameter p-gds-code  like ub.bar-code.gds-code  no-undo .
     2094     define input  parameter p-node-code like ub.bar-code.node-code no-undo .
     2095     define output parameter p-b-code    like ub.bar-code.b-code    no-undo .
     2096     def var vss-description as character no-undo init "gdsbcode-01: определение первичного бар-кода признака".
     2097     def var vss-proc-revision as character no-undo init "library.p gdsbcode-01" .
     2098     define buffer buf_bar-code for ub.bar-code .
     2099     def var v-unit-base like ub.goods.unit-base no-undo .
     2100     do
     2101     on error undo, return error
     2102     :
     2103       if p-node-code = ? then do:
     2104         run mc_gdsrootnode in this-procedure (
     2105            input  p-gds-code
     2106           ,output p-node-code
     2107           ) no-error .
     2108         if error-status :error then do:
     2109           message
     2110             vss-workfile vss-revision vss-description skip
     2111             "Ошибка при определении корневого признака товара" skip
     2112             "Код товара" p-gds-code skip
     2113             error-status :get-message(1) skip
     2114             return-value skip
     2115             view-as alert-box error .
     2116           undo, return error .
     2117         end.
     2118       end.
     2119       run mc_unitbase in this-procedure (
     2120          input  p-gds-code
     2121         ,output v-unit-base
     2122         ) no-error .
     2123       if error-status :error then do:
     2124         message
     2125           vss-workfile vss-revision vss-description skip
     2126           "Ошибка определения базовой единицы измерения товара" skip
     2127           "Код товара" p-gds-code skip
     2128           view-as alert-box error .
     2129         undo, return error .
     2130       end.
     2131       find first buf_bar-code no-lock
     2132         where buf_bar-code.gds-code  = p-gds-code
     2133           and buf_bar-code.node-code = p-node-code
     2134           and buf_bar-code.part-code = ""
     2135           and buf_bar-code.in-code   = ""
     2136           and buf_bar-code.unit-cli  = v-unit-base
     2137         no-error .
     2138       if not available buf_bar-code then do:
     2139         undo, return error vss-proc-revision + ":" + chr(10)
     2140           + "Не найден первичный бар-кода признака " + chr(10)
     2141           + "Код товара " + string(p-gds-code) + chr(10)
     2142           + "Код признака " + string(p-node-code) + chr(10)
     2143           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     2144           .
     2145       end.
     2146       assign
     2147         p-b-code = buf_bar-code.b-code
     2148       .
     2149     end.
     2150   end procedure.
     2151   procedure mc_gdsrootnode :
     2152     define input  parameter p-gds-code  like ub.goods.gds-code no-undo .
     2153     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2154     def var vss-description as character no-undo init "gdsrootnode-01: определение корневого признака товара по коду товара".
     2155     define buffer buf_goods   for ub.goods .
     2156     do
     2157     on error undo, return error
     2158     :
     2159       find first buf_goods no-lock
     2160         where buf_goods.gds-code  = p-gds-code
     2161         no-error .
     2162       if not available buf_goods then do:
     2163         message
     2164           vss-workfile vss-revision vss-description skip
     2165           "Не найден товар" skip
     2166           "Код товара" p-gds-code skip
     2167           view-as alert-box error .
     2168         undo, return error .
     2169       end.
     2170       run mc_prt-root-to-node-code in this-procedure (
     2171          input  buf_goods.prt-root
     2172         ,output p-root-node
     2173         ) no-error .
     2174       if error-status :error then do:
     2175         message
     2176           vss-workfile vss-revision vss-description skip
     2177           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     2178           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2179           "Указатель на корень шкалы" buf_goods.prt-root skip
     2180           error-status :get-message(1) skip
     2181           return-value skip
     2182           view-as alert-box error .
     2183         undo, return error .
     2184       end.
     2185     end.
     2186   end procedure.
     2187   procedure mc_prt-root-to-node-code :
     2188     define input  parameter p-prt-root  like ub.goods.prt-root no-undo .
     2189     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2190     def var vss-description as character no-undo init "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     2191     define buffer buf_gds-prt for ub.gds-prt .
     2192     do
     2193     on error undo, return error
     2194     :
     2195       find buf_gds-prt no-lock
     2196         where buf_gds-prt.upper-code = p-prt-root
     2197         no-error .
     2198       if not available buf_gds-prt then do:
     2199         message
     2200           vss-workfile vss-revision vss-description skip
     2201           "Не найден корень шкалы" skip
     2202           "Указатель на корень шкалы" p-prt-root skip
     2203           view-as alert-box error .
     2204         undo, return error .
     2205       end.
     2206       assign
     2207         p-root-node = buf_gds-prt.node-code
     2208       .
     2209     end.
     2210   end procedure.
     2211   procedure mc_unitbase :
     2212     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
     2213     define output parameter p-unit-base like ub.goods.unit-base no-undo .
     2214     def var vss-description as character no-undo init "unitbase-01: определение базовой единицы измерения товара".
     2215     define buffer buf_goods for ub.goods .
     2216     do
     2217     on error undo, return error
     2218     :
     2219       find first buf_goods no-lock
     2220         where buf_goods.gds-code = p-gds-code
     2221         no-error .
     2222       if not available buf_goods then do:
     2223         message
     2224           vss-workfile vss-revision vss-description skip
     2225           "Не найден товар" skip
     2226           "Код товара" p-gds-code skip
     2227           view-as alert-box error .
     2228         undo, return error .
     2229       end.
     2230       assign
     2231         p-unit-base = buf_goods.unit-base
     2232       .
     2233     end.
     2234   end procedure.
     2235   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2236   procedure gen-b-code :
     2237     define input  parameter type-code like ub.code-range.range-type no-undo .
     2238     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     2239     do
     2240     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2241     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     2242     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     2243     :
     2244       define buffer buf_thbj-attr     for ub.thbj-attr .
     2245       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     2246       define buffer buf_code-range for ub.code-range .
     2247       define variable l-code         as   integer              no-undo .
     2248       define variable v-db-num       like ub.db.db-num         no-undo .
     2249       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     2250       if type-code = 'sslc':U
     2251       or type-code = 'ssgb':U
     2252       then do:
     2253         message
     2254           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     2255           "Обратитесь к администратору системы."
     2256           view-as alert-box error .
     2257         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     2258       end.
     2259       run trg/getpcode.p ( input  type-code
     2260                      ,output cfg-param-code
     2261                     ).
     2262       run get-next-seq( input  type-code,
     2263                         output l-code
     2264                       ).
     2265       find first buf_sys-ctrl no-lock.
     2266       if type-code = 'sclc':U
     2267       or type-code = 'pglc':U
     2268       then do:
     2269         assign
     2270           v-db-num = 0
     2271         .
     2272       end.
     2273       else do:
     2274         assign
     2275           v-db-num = buf_sys-ctrl.db-num
     2276         .
     2277       end.
     2278       find first buf_code-range no-lock
     2279         where buf_code-range.db-num     = v-db-num
     2280           and buf_code-range.range-type = type-code
     2281           and buf_code-range.stts       = "a"
     2282         use-index stts
     2283         no-error .
     2284       if available buf_code-range
     2285          and l-code <= buf_code-range.last-code
     2286          and l-code >= buf_code-range.first-code then do:
     2287         assign
     2288           p-b-code = l-code
     2289         .
     2290       end.
     2291       else do:
     2292         if available buf_code-range
     2293            and l-code < buf_code-range.last-code then do:
     2294           message
     2295             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     2296             "Обратитесь к администратору системы."
     2297             view-as alert-box error .
     2298           undo, return error "sequence":U .
     2299         end.
     2300         do transaction
     2301         on error undo, return error
     2302         :
     2303           find first buf_thbj-attr exclusive-lock
     2304             where buf_thbj-attr.upper-prop-code = 'code-range':U
     2305               and buf_thbj-attr.prop-code = cfg-param-code
     2306               and buf_thbj-attr.obj-type   = 'БД':U
     2307               and buf_thbj-attr.obj-code   = v-db-num
     2308             no-error .
     2309           if not available buf_thbj-attr then do:
     2310             find first buf_thbj-attr exclusive-lock
     2311               where buf_thbj-attr.upper-prop-code = 'code-range':U
     2312                 and buf_thbj-attr.prop-code = cfg-param-code
     2313                 and buf_thbj-attr.obj-type   = ''
     2314                 and buf_thbj-attr.obj-code   = 0
     2315               no-error .
     2316             if not available buf_thbj-attr then do:
     2317               if not locked buf_thbj-attr then do:
     2318                 message
     2319                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     2320                   "Обратитесь к администратору системы."
     2321                   view-as alert-box error .
     2322               end.
     2323               undo, return error "config":U .
     2324             end.
     2325           end.
     2326           run get-next-seq( input type-code,
     2327                             output l-code
     2328                           ).
     2329           find first buf_code-range
     2330             where buf_code-range.db-num     = v-db-num
     2331               and buf_code-range.range-type = type-code
     2332               and buf_code-range.stts       = "a"
     2333             use-index stts
     2334             no-error .
     2335           if available buf_code-range
     2336           and l-code <= buf_code-range.last-code
     2337           and l-code >= buf_code-range.first-code
     2338           then do:
     2339             assign
     2340               p-b-code = l-code
     2341             .
     2342           end.
     2343           else do:
     2344             if available buf_code-range then do:
     2345               assign
     2346                 buf_code-range.stts = "u"
     2347               .
     2348             end.
     2349             find first buf_code-range
     2350               where buf_code-range.db-num     = v-db-num
     2351                 and buf_code-range.range-type = type-code
     2352                 and buf_code-range.stts       = "f"
     2353               use-index stts
     2354               no-error .
     2355             if not available buf_code-range then do:
     2356               message
     2357                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     2358                 "Обратитесь к администратору системы"
     2359                 view-as alert-box error .
     2360               undo, return error "code-range":U .
     2361             end.
     2362             assign
     2363               buf_code-range.stts           = "a"
     2364             .
     2365             if buf_code-range.first-code = 1 then do:
     2366               run set-seq-cr( input type-code,
     2367                               input buf_code-range.first-code
     2368                             ).
     2369               assign
     2370                 p-b-code = 1
     2371               .
     2372             end.
     2373             else do:
     2374               run set-seq-cr( input type-code,
     2375                               input ( buf_code-range.first-code - 1 )
     2376                             ).
     2377               run get-next-seq( input type-code,
     2378                                 output p-b-code
     2379                               ).
     2380             end.
     2381           end.
     2382         end.
     2383       end.
     2384     end.
     2385   end procedure.
     2386   procedure get-next-seq :
     2387     define input  parameter type-code like ub.code-range.range-type no-undo .
     2388     define output parameter next-seq  as   integer                  no-undo .
     2389     do
     2390     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2391     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     2392     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     2393     :
     2394       case type-code:
     2395         when 'bcgb':U then do:
     2396           assign
     2397             next-seq = next-value(s-bcgb-code, ub)
     2398           .
     2399         end.
     2400         when 'scgb':U then do:
     2401           assign
     2402             next-seq = next-value(s-scgb-code, ub)
     2403           .
     2404         end.
     2405         when 'sclc':U then do:
     2406           assign
     2407             next-seq = next-value(s-sclc-code, ub)
     2408           .
     2409         end.
     2410         when 'pglc':U then do:
     2411           assign
     2412             next-seq = next-value(s-pglc-code, ub)
     2413           .
     2414         end.
     2415         when 'dcgb':U then do:
     2416           assign
     2417             next-seq = next-value(s-dcgb-code, ub)
     2418           .
     2419         end.
     2420         when 'ctgb':U then do:
     2421           assign
     2422             next-seq = next-value(s-ctgb-code, ub)
     2423           .
     2424         end.
     2425         when 'drgb':U then do:
     2426           assign
     2427             next-seq = next-value(s-drgb-code, ub)
     2428           .
     2429         end.
     2430         when 'fmgb':U then do:
     2431           assign
     2432             next-seq = next-value(s-fmgb-code, ub)
     2433           .
     2434         end.
     2435         when 'pngb':U then do:
     2436           assign
     2437             next-seq = next-value(s-pngb-code, ub)
     2438           .
     2439         end.
     2440         when 'cagb':U then do:
     2441           assign
     2442             next-seq = next-value(s-cagb-code, ub)
     2443           .
     2444         end.
     2445         when 'fdgb':U then do:
     2446           assign
     2447             next-seq = next-value(s-fin-doc, ub)
     2448           .
     2449         end.
     2450       end case.
     2451     end.
     2452   end procedure.
     2453   procedure set-seq-cr :
     2454     define input parameter type-code like ub.code-range.range-type no-undo .
     2455     define input parameter set-val   like ub.code-range.first-code no-undo .
     2456     do
     2457     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2458     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     2459     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     2460     :
     2461       case type-code:
     2462         when 'bcgb':U then do:
     2463           assign
     2464             current-value(s-bcgb-code, ub) = set-val
     2465           .
     2466         end.
     2467         when 'scgb':U then do:
     2468           assign
     2469             current-value(s-scgb-code, ub) = set-val
     2470           .
     2471         end.
     2472         when 'sclc':U then do:
     2473           assign
     2474             current-value(s-sclc-code, ub) = set-val
     2475           .
     2476         end.
     2477         when 'pglc':U then do:
     2478           assign
     2479             current-value(s-pglc-code, ub) = set-val
     2480           .
     2481         end.
     2482         when 'dcgb':U then do:
     2483           assign
     2484             current-value(s-dcgb-code, ub) = set-val
     2485           .
     2486         end.
     2487         when 'ctgb':U then do:
     2488           assign
     2489             current-value(s-ctgb-code, ub) = set-val
     2490           .
     2491         end.
     2492         when 'drgb':U then do:
     2493           assign
     2494             current-value(s-drgb-code, ub) = set-val
     2495           .
     2496         end.
     2497         when 'fmgb':U then do:
     2498           assign
     2499             current-value(s-fmgb-code, ub) = set-val
     2500           .
     2501         end.
     2502         when 'pngb':U then do:
     2503           assign
     2504             current-value(s-pngb-code, ub) = set-val
     2505           .
     2506         end.
     2507         when 'cagb':U then do:
     2508           assign
     2509             current-value(s-cagb-code, ub) = set-val
     2510           .
     2511         end.
     2512         when 'fdgb':U then do:
     2513           assign
     2514             current-value(s-fin-doc, ub) = set-val
     2515           .
     2516         end.
     2517       end case.
     2518     end.
     2519   end procedure.
     2520   procedure new-bcod-gen-code-range :
     2521     do
     2522     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2523     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     2524     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     2525     :
     2526       define input parameter p-db-num  like ub.db.db-num             no-undo .
     2527       define input parameter type-code like ub.code-range.range-type no-undo .
     2528       define buffer buf_code-range      for ub.code-range .
     2529       define buffer last_code-range     for ub.code-range .
     2530       define buffer last-1_code-range   for ub.code-range .
     2531       define buffer last-2_code-range   for ub.code-range .
     2532       define buffer last-3_code-range   for ub.code-range .
     2533       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     2534       define variable conf-par       as character no-undo .
     2535       define variable par-type       as character no-undo .
     2536       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     2537       define variable v-cre-cdrg as logical   no-undo .
     2538       define variable v-cre-str  as character no-undo .
     2539       define variable v-cr1      as integer no-undo .
     2540       define variable v-cr2      as integer no-undo .
     2541       define variable v-cr3      as integer no-undo .
     2542       define variable v-cmax     as integer no-undo .
     2543       find first buf_sys-ctrl no-lock .
     2544       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     2545         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     2546                                       ,vss-workfile
     2547                                       ,vss-revision
     2548                                       ,vss-description
     2549                                       ,chr(10)
     2550                                       , p-db-num
     2551                                      ).
     2552       end.
     2553       run trg/getpcode.p ( input  type-code
     2554                      ,output cfg-param-code
     2555                     ).
     2556       for each buf_code-range
     2557         where buf_code-range.db-num     = -1
     2558           and buf_code-range.range-type = type-code
     2559           and buf_code-range.stts       = "f"
     2560       by buf_code-range.first-code
     2561       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2562       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     2563       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     2564       :
     2565         assign
     2566           buf_code-range.db-num = p-db-num
     2567         .
     2568         return .
     2569       end.
     2570       assign
     2571         v-cre-cdrg = TRUE
     2572       .
     2573       case type-code:
     2574         when 'sclc':U
     2575         or when 'scgb':U
     2576         or when 'pglc':U
     2577         then do:
     2578           find last last-1_code-range no-lock
     2579             where last-1_code-range.range-type = 'sclc':U
     2580             no-error .
     2581           if available last-1_code-range then do:
     2582             v-cr1 = last-1_code-range.last-code.
     2583           end.
     2584           find last last-2_code-range no-lock
     2585             where last-2_code-range.range-type = 'scgb':U
     2586             no-error .
     2587           if available last-2_code-range then do:
     2588             v-cr2 = last-2_code-range.last-code.
     2589             end.
     2590           find last last-3_code-range no-lock
     2591             where last-3_code-range.range-type = 'pglc':U
     2592             no-error .
     2593           if available last-3_code-range then do:
     2594             v-cr3 = last-3_code-range.last-code.
     2595           end.
     2596           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     2597           .
     2598           if v-cmax = v-cr1  then do:
     2599               find last last_code-range no-lock
     2600                 where recid( last_code-range ) = recid( last-1_code-range )
     2601                 .
     2602             end.
     2603           if v-cmax = v-cr2  then do:
     2604               find last last_code-range no-lock
     2605                 where recid( last_code-range ) = recid( last-2_code-range )
     2606                 .
     2607             end.
     2608           if v-cmax = v-cr3  then do:
     2609             find last last_code-range no-lock
     2610               where recid( last_code-range ) = recid( last-3_code-range )
     2611               .
     2612           end.
     2613           if last_code-range.last-code + 1 > 99999 then do:
     2614             assign
     2615               v-cre-cdrg = FALSE
     2616             .
     2617           end.
     2618         end.
     2619         when 'bcgb':U
     2620         or when 'sslc':U
     2621         or when 'ssgb':U
     2622         then do:
     2623           find last last-1_code-range no-lock
     2624             where last-1_code-range.range-type = 'sslc':U
     2625             no-error .
     2626           if available last-1_code-range then do:
     2627             v-cr1 = last-1_code-range.last-code.
     2628           end.
     2629           find last last-2_code-range no-lock
     2630             where last-2_code-range.range-type = 'bcgb':U
     2631             no-error .
     2632           if available last-2_code-range then do:
     2633             v-cr2 = last-2_code-range.last-code.
     2634             end.
     2635           find last last-3_code-range no-lock
     2636             where last-3_code-range.range-type = 'ssgb':U
     2637             no-error .
     2638           if available last-3_code-range then do:
     2639             v-cr3 = last-3_code-range.last-code.
     2640           end.
     2641           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     2642           .
     2643           if v-cmax = v-cr1  then do:
     2644               find last last_code-range no-lock
     2645                 where recid( last_code-range ) = recid( last-1_code-range )
     2646                 .
     2647             end.
     2648           if v-cmax = v-cr2  then do:
     2649               find last last_code-range no-lock
     2650                 where recid( last_code-range ) = recid( last-2_code-range )
     2651                 .
     2652             end.
     2653           if v-cmax = v-cr3  then do:
     2654             find last last_code-range no-lock
     2655               where recid( last_code-range ) = recid( last-3_code-range )
     2656               .
     2657           end.
     2658         end.
     2659         otherwise do:
     2660           find last last_code-range no-lock
     2661             where last_code-range.range-type = type-code
     2662             no-error .
     2663         end.
     2664       end case.
     2665       if not available last_code-range then do:
     2666         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     2667                                       ,vss-workfile
     2668                                       ,vss-revision
     2669                                       ,vss-description
     2670                                       , chr(10)
     2671                                       , type-code
     2672                                      ) .
     2673       end.
     2674       define variable v-mes10 as character no-undo .
     2675       define variable v-param-type10 as character no-undo .
     2676       define variable v-value-character10 as INTEGER no-undo .
     2677       define variable v-value-date10 as date no-undo .
     2678       define variable v-value-decimal10 as decimal no-undo .
     2679       define variable v-value-integer10 AS integer no-undo .
     2680       define variable v-value-logical10 AS LOGICAL no-undo .
     2681       define variable v-tth10 as handle no-undo .
     2682       run adm/shattri.p (
     2683           input "get":U
     2684           ,input  'БД':U
     2685           ,input  p-db-num
     2686           ,input  'code-range':U
     2687           ,input  cfg-param-code
     2688           ,output v-value-character10
     2689           ,output v-value-date10
     2690           ,output v-value-decimal10
     2691           ,output v-value-integer10
     2692           ,output v-value-logical10
     2693           ,output v-param-type10
     2694           ,INPUT-OUTPUT table-handle v-tth10
     2695           ) no-error .
     2696       if error-status :error then do:
     2697         delete object v-tth10.
     2698         v-mes10 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     2699                            , error-status:get-message(1)
     2700                            , chr(10)
     2701                            , return-value ).
     2702         undo, return error v-mes10.
     2703       end.
     2704       delete object v-tth10.
     2705       if v-cre-cdrg = TRUE then do:
     2706         create buf_code-range .
     2707         assign
     2708           buf_code-range.db-num     = p-db-num
     2709           buf_code-range.range-type = type-code
     2710           buf_code-range.stts       = "f"
     2711           buf_code-range.first-code = last_code-range.last-code + 1
     2712           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer10)
     2713           v-cre-str = "Свободный диапазон успешно создан"
     2714         .
     2715       end.
     2716       else do:
     2717         assign
     2718           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     2719                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     2720         .
     2721       end.
     2722     end.
     2723     return v-cre-str .
     2724   end procedure.
     2725   procedure gen-new-code-range-if-neces :
     2726     define input parameter v-db-num           like ub.db.db-num             no-undo .
     2727     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     2728     define input parameter v-cur-code         as   integer                  no-undo .
     2729     define input parameter v-g#news           as   logical                  no-undo .
     2730     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     2731     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     2732     do
     2733     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2734     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     2735     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     2736     :
     2737       define variable l-code-range-exist as logical   no-undo init false .
     2738       define variable v-db-for-send      as character no-undo .
     2739       define buffer buf_code-range  for ub.code-range .
     2740       define buffer buf1_code-range for ub.code-range .
     2741       define buffer buf_db          for ub.db .
     2742       find first buf_code-range
     2743         where buf_code-range.range-type = v-range-type
     2744           and buf_code-range.last-code >= v-cur-code
     2745         use-index last-codei
     2746         no-error .
     2747       if
     2748       (
     2749          available buf_code-range
     2750          and
     2751         (buf_code-range.db-num = v-db-num
     2752           and
     2753         buf_code-range.first-code <= v-cur-code
     2754         )
     2755       or
     2756         (
     2757           v-range-type = 'drgb':U
     2758           AND
     2759           v-cur-code = 0
     2760         )
     2761      )
     2762      then do:
     2763         assign
     2764           l-code-range-exist = true
     2765         .
     2766         if v-g#news
     2767         and buf_code-range.stts = "f" then do:
     2768           assign
     2769             buf_code-range.stts = "u"
     2770           .
     2771         end.
     2772       end.
     2773       if not l-code-range-exist
     2774          and v-g#news-source-db <> 0
     2775       then do:
     2776         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     2777                                       ,vss-workfile
     2778                                       ,vss-revision
     2779                                       ,vss-description
     2780                                       ,chr(10)
     2781                                       ,v-db-num
     2782                                       ,v-range-type
     2783                                       ,v-cur-code
     2784                                      ).
     2785       end.
     2786       if (not l-code-range-exist
     2787           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     2788          )
     2789       and ( not can-find (first buf1_code-range no-lock
     2790                           where buf1_code-range.db-num = v-db-num
     2791                             and buf1_code-range.range-type = v-range-type
     2792                             and buf1_code-range.stts = "f"
     2793                          )
     2794           )
     2795       then do:
     2796         if v-g#db-num = 0 then do:
     2797           run new-bcod-gen-code-range in this-procedure
     2798             (input v-db-num,
     2799              input v-range-type
     2800             ) no-error .
     2801           if error-status :error then do:
     2802             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     2803                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     2804                                           ,v-db-num
     2805                                           ,v-range-type
     2806                                           ,v-cur-code
     2807                                           ,chr(10)
     2808                                           ,error-status:get-message(1)
     2809                                           ,return-value
     2810                                          ).
     2811           end.
     2812         end.
     2813         else do:
     2814           if v-range-type = 'sclc':U
     2815           or v-range-type = 'pglc':U
     2816           then do:
     2817             assign
     2818               v-db-for-send = "":U
     2819             .
     2820             if v-g#db-num = 0 then do:
     2821               for each buf_db no-lock
     2822                 where buf_db.db-num > 0
     2823                   and buf_db.db-num <> v-g#news-source-db
     2824               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2825               :
     2826                 assign
     2827                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     2828                 .
     2829               end.
     2830               assign
     2831                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     2832               .
     2833             end.
     2834             else do:
     2835               if not v-g#news then do:
     2836                 assign
     2837                   v-db-for-send = "0":U
     2838                 .
     2839               end.
     2840             end.
     2841             run nws/cr-route.p ( input 'send-cmd':U
     2842                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     2843                                  "code-range":U + chr(1) +
     2844                                  (if v-range-type = 'sclc':U
     2845                                   then string( current-value(s-sclc-code, ub))
     2846                                   else string( current-value(s-pglc-code, ub))
     2847                                   ) + chr(1) +
     2848                                   v-range-type)
     2849                           ,input ?
     2850                           ,input v-db-for-send
     2851                           ) no-error .
     2852             if error-status :error then do:
     2853               undo, return error return-value.
     2854             end.
     2855           end.
     2856         end.
     2857       end.
     2858     end.
     2859   end procedure.
     2860   procedure cre-loc-sc-code-range :
     2861     define input parameter v-cur-code as integer no-undo .
     2862   define input parameter p-cdrg-type as character no-undo .
     2863     do
     2864     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2865     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     2866     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     2867     :
     2868       define buffer buf_code-range for ub.code-range .
     2869       find first buf_code-range
     2870            where buf_code-range.range-type = p-cdrg-type
     2871              and buf_code-range.first-code >= v-cur-code
     2872            no-error .
     2873       if not available buf_code-range then do:
     2874         run new-bcod-gen-code-range in this-procedure
     2875           ( input 0,
     2876             input p-cdrg-type
     2877           ) no-error .
     2878         if error-status :error then do:
     2879           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     2880                                          + "Код &2&1&3 &4"
     2881                                         , chr(10)
     2882                                         , v-cur-code
     2883                                         , error-status:get-message(1)
     2884                                         , return-value
     2885                                        ) .
     2886         end.
     2887       end.
     2888     end.
     2889   end procedure.
     2890   procedure mark-used-if-need :
     2891   define input parameter p-cur-code as integer no-undo .
     2892   define input parameter p-range-type like ub.code-range.range-type no-undo .
     2893   define input parameter p-db-num like ub.code-range.db-num no-undo .
     2894     do
     2895     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2896     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     2897     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     2898     :
     2899       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     2900       define buffer buf_code-range for ub.code-range .
     2901       assign
     2902       v-db-num = if p-range-type = 'sclc':U
     2903                  then 0
     2904                  else p-db-num
     2905       .
     2906   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2907   define buffer locK-batchprocess11 for ub.batchprocess.
     2908   run gbl/lock-prc.p
     2909       (input 'lscc':U
     2910       ,input 0
     2911       ,input 0
     2912       ,input 0
     2913       ,input ""
     2914       ,input ""
     2915       ,input ""
     2916       ,input (
     2917               ",,,Вкл/выкл лок. вес. кодов"
     2918              )
     2919       ,input true
     2920       ,buffer lock-batchprocess11
     2921       ) no-error .
     2922     if error-status :error then do:
     2923       message
     2924         vss-workfile vss-revision vss-description skip
     2925         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     2926         view-as alert-box error .
     2927       undo, return error .
     2928     end.
     2929       find first buf_code-range
     2930            where buf_code-range.range-type = p-range-type
     2931              and buf_code-range.first-code >= p-cur-code
     2932              and buf_code-range.last-code <= p-cur-code
     2933              and buf_code-range.db-num = v-db-num
     2934            no-error .
     2935       if not available buf_code-range then do:
     2936         message
     2937           vss-workfile vss-revision vss-description skip
     2938           "Ошибка при создании поиске диапазона" skip
     2939           "База данных" p-db-num skip
     2940           "Код" p-cur-code skip
     2941           "Тип" p-range-type
     2942           error-status :get-message(1) skip
     2943           return-value skip
     2944           view-as alert-box error .
     2945         undo, return error .
     2946       end.
     2947       if buf_code-range.stts = "f":U then do:
     2948         assign
     2949         buf_code-range.stts = "u":U
     2950         .
     2951       end.
     2952     end.
     2953   end procedure.
     2954   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2955   define new global shared variable g#attr-lib  as handle no-undo .
     2956   define variable v-attr-lib-variable as handle no-undo .
     2957   procedure gdsoattr-name :
     2958     define input  parameter p-code           as character no-undo .
     2959     define output parameter p-type           as character no-undo .
     2960     define output parameter p-format         as character no-undo .
     2961     define output parameter p-label          as character no-undo .
     2962     define output parameter p-user-can-edit  as logical   no-undo .
     2963     define output parameter p-output-display as logical   no-undo .
     2964     define output parameter p-other          as character no-undo .
     2965     do
     2966     on error undo, return error
     2967     :
     2968           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     2969         (input  p-code
     2970         ,output p-type
     2971         ,output p-format
     2972         ,output p-label
     2973         ,output p-user-can-edit
     2974         ,output p-output-display
     2975         ,output p-other
     2976         ) no-error .
     2977       if error-status :error
     2978       then do:
     2979         undo, return error return-value .
     2980       end.
     2981     end.
     2982   end.
