        1   block-level on error undo, throw.
        2   .session:debug-alert = yes.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define variable mAsyncProc as class ibs.th.file.AsyncProc.
        8   run ibs\th\file\getasyncproc.p (output mAsyncProc).
        9   define variable mstopAsunc as logical no-undo.
       10   function StopCheck returns logical:
       11      define variable oFlag as logical no-undo.
       12      run StopCheckAsync (output oFlag).
       13      return oFlag.
       14   end.
       15   procedure StopCheckAsync:
       16       define output  parameter oFlag as logical no-undo.
       17       if mstopAsunc
       18       then
       19          oFlag = mstopAsunc.
       20       else do:
       21          oFlag = mAsyncProc:CheckStop().
       22          mstopAsunc = oFlag.
       23       end.
       24   end.
       25   function GetParamAsunc returns character
       26   (input iNumPar as integer  ):
       27      return mAsyncProc:GetPARAM(iNumPar).
       28   end.
       29   function GetParamAsuncStr returns ibs.th.file.asyncparam
       30   (input iParamName as character ):
       31      return mAsyncProc:GetPARAM(iParamName).
       32   end.
       33   procedure PutMesAsunc:
       34       define input  parameter Itext as character no-undo.
       35       define variable vflag as logical no-undo.
       36       Publish "WriteLogAsunc" (Itext, yes)  .
       37   end.
       38   procedure PutMesAsuncNoTime:
       39       define input  parameter Itext as character no-undo.
       40       define variable vflag as logical no-undo.
       41       Publish "WriteLogAsunc" (Itext,no)  .
       42   end.
       43   procedure PutStatAsunc:
       44       define input  parameter Itext as character no-undo.
       45       Publish "PutStatAsunc" (Itext,no) .
       46        run
       47       PutMesAsunc (itext).
       48   end.
       49   procedure PutStatAsuncNoTime:
       50       define input  parameter Itext as character no-undo.
       51       Publish "PutStatAsunc" (Itext,no)  .
       52        run
       53       PutMesAsuncNoTime (itext).
       54   end.
       55   procedure PutStatAsuncAdd:
       56       define input  parameter Itext as character no-undo.
       57       Publish "PutStatAsunc" (Itext,yes)  .
       58   end.
       59   procedure PutFileLogAsunc:
       60       define input  parameter IFile as character no-undo.
       61       Publish "PutFileLogAsunc" (ifile)  .
       62   end.
       63          mAsyncProc:mProcPublish = this-procedure.
       64   if    StopCheck()
       65   then do:
       66      run PutstatAsunc(substitute("error   Получение счетчика было преврвано пользователем или по TimeOut.") ).
       67      return.
       68   end.
       69   define variable  mfilename as character no-undo.
       70   mfilename = GetPARAMAsunc(1).
       71   define variable mKey as character   no-undo.
       72   mkey = GetPARAMAsunc(2).
       73   define variable  mCode as character no-undo.
       74   mCode  = GetPARAMAsunc(3).
       75   define variable  mParam as character no-undo.
       76   mParam  = GetPARAMAsunc(4).
       77   if     mfilename ne ?
       78      and mkey      ne ?
       79      and mCode     ne ?
       80   then do:
       81      define variable mCounterValue as int64 no-undo.
       82      define variable mCounterStor as class ibs.th.ref.counter.counterstorage.
       83      mCounterStor = new ibs.th.ref.counter.counterstorage().
       84      mCounterValue = mCounterStor:GetNextcount(mFileName, mKey, mcode,mParam).
       85      delete object mCounterStor.
       86      run PutMesAsuncNoTime(string(mCounterValue)).
       87   end.
