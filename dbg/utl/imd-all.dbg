     9949                                     bf_doc-line-attr.gds-code  = ub.goods.gds-code    and
     9950                                     bf_doc-line-attr.attr-code = "last-date"        no-error.
     9951   if not available bf_doc-line-attr and i-last-date <> ? then do:
     9952      create bf_doc-line-attr.
     9953      assign
     9954        bf_doc-line-attr.doc-code   = ub.doc-line.doc-code
     9955        bf_doc-line-attr.gds-code   = ub.goods.gds-code
     9956        bf_doc-line-attr.attr-code  = "last-date"
     9957        bf_doc-line-attr.attr-value = string(i-last-date)
     9958      .
     9959   end.
     9960   find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = ub.doc-line.doc-code and
     9961                                     bf_doc-line-attr.gds-code  = ub.goods.gds-code    and
     9962                                     bf_doc-line-attr.attr-code = "cst-code"        no-error.
     9963   if not available bf_doc-line-attr then do:
     9964      create bf_doc-line-attr.
