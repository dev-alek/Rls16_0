     4300             output vd  ,
     4301             output cost-base   ,
     4302             output cost-rubl   ,
     4303             output cur-rt-base ,
     4304             output cur-rt-rubl
     4305             ).
     4306             cost-rubl = vd * p-exch-rate / p-exch-scale .
     4307             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4308             p-new-calc-method = 'Отсутствует':U .
     4309      end.
     4310      when 'Основная':U then do:
     4311      end.
     4312       when 'ПорогПр-НДС':U then do:
     4313         find first x_obj-group.
     4314             run calc-price-levelprod (
     4315               input 2          ,
     4316               input var-pr-r-b ,
     4317               input p-b-code   ,
     4318               input x_obj-group.obj-type ,
     4319               input x_obj-group.obj-code ,
     4320               output vd,
     4321               output v-descript
     4322             ) no-error.
     4323         if vd = 0 or vd = ?  then do:
     4324           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4325                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4326                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4327                   view-as alert-box question buttons OK-Cancel title "#4" update g#log1 as logical .
     4328         end.
     4329         else do:
     4330             cost-rubl = vd .
     4331             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4332             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4333         end.
     4334       end.
     4335       when 'ПорогПр+НДС':U then do:
     4336         find first x_obj-group.
     4337             run calc-price-levelprod (
     4338               input 1          ,
     4339               input var-pr-r-b ,
     4340               input p-b-code   ,
     4341               input x_obj-group.obj-type ,
     4342               input x_obj-group.obj-code ,
     4343               output vd ,
     4344               output v-descript
     4345             ) no-error.
     4346         if vd = 0 or vd = ?  then do:
     4347           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4348                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4349                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4350                   view-as alert-box information .
     4351         end.
     4352         else do:
     4353             cost-rubl = vd .
     4354             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4355             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4356         end.
     4357       end.
     4358       when 'Производит':U
     4359       then do:
     4360         find first x_obj-group.
     4361   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4363   (  input  p-b-code
     4364    , input  x_obj-group.obj-type
     4365    , input  x_obj-group.obj-code
     4366    , output v-PriceWithVat
     4367    , output vd
     4368    , output v-prod-vat
     4369    , output v-str1
     4370    , output v-str1
     4371           ) no-error .
     4372         if error-status :error then
     4373         message
     4374           vss-workfile vss-revision vss-description skip
     4375           error-status :get-message(1) skip
     4376           return-value skip
     4377           "proprice.i"
     4378           view-as alert-box error
     4379         .
     4380         if vd = 0 or vd = ?  then do:
     4381           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4382                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4383                   "- расчет по производителю от последней приходной накладной невозможен."
     4384                   view-as alert-box question buttons OK-Cancel title "#3" update g#log as logical .
     4385         end.
     4386         else do:
     4387             cost-rubl = vd .
     4388             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4389             p-new-calc-method = p-calc-method .
     4390         end.
     4391       end.
     4392       when 'Произв-НДС':U
     4393       then do:
     4394         find first x_obj-group.
     4395   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4397   (  input  p-b-code
     4398    , input  x_obj-group.obj-type
     4399    , input  x_obj-group.obj-code
     4400    , output vd
     4401    , output v-PriceWithVat
     4402    , output v-prod-vat
     4403    , output v-str1
     4404    , output v-str1
     4405           ) no-error .
     4406         if error-status :error then
     4407         message
     4408           vss-workfile vss-revision vss-description skip
     4409           error-status :get-message(1) skip
     4410           return-value skip
     4411           "proprice.i"
