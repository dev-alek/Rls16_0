     9420       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Товар весовой : Тип строки должен быть ITEM, PART, либо CODE для товара. Пропускаем." chr(10).
     9421       next file-line.
     9422     end.
     9423     if lookup ('сер':U, goods-units.type) > 0 and
     9424        not lookup (string-type, "ITEM,PART") > 0 then do:
     9425       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Товар серийный : Тип строки должен быть ITEM, PART, либо CODE для товара. Пропускаем." chr(10).
     9426       next file-line.
     9427     end.
     9428     if lookup ('топ':U, goods-units.type) > 0 and
     9429        lookup ('дро':U, goods-units.type) > 0 and
     9430        ub.goods.gds-type = 'т':U then do:
     9431       if not lookup (string-type, "ITEM") > 0 then do:
     9432         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Товар топливный : Тип строки должен быть ITEM, либо CODE для товара. Пропускаем." chr(10).
     9433         next file-line.
     9434       end.
     9435       if i-unit-cli <> ub.goods.unit-base then do:
     9436         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Товар топливный : Единица измерения должна совпадать с основной. Пропускаем." chr(10).
     9437         next file-line.
     9438       end.
     9439     end.
     9440     find ub.units where ub.units.unit-name = i-unit-cli no-lock no-error.
     9441     if not available ub.units then do:
     9442       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Единица измерения отсутствует в справочнике. Пропускаем." chr(10).
     9443       next file-line.
     9444     end.
     9445     if i-cli-base-rate <= 0 then do:
     9446       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Коэффициент должен быть больше 0. Пропускаем." chr(10).
     9447       next file-line.
     9448     end.
     9449     if i-cli-base-rate = ? then do:
     9450       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Коэффициент не должен иметь неопределенное значение. Пропускаем." chr(10).
     9451       next file-line.
     9452     end.
     9453     if i-unit-cli <> ub.goods.unit-base and
     9454        i-cli-base-rate = 1 then do:
     9455       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Единица измерения не совпадает с основной - а коэффициент 1! Пропускаем. " chr(10).
     9456       next file-line.
     9457     end.
     9458     if i-unit-cli = ub.goods.unit-base and
     9459        i-cli-base-rate <> 1 then do:
     9460       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Единица измерения совпадает с основной. Коэффициент должен быть равен 1. Пропускаем." chr(10).
     9461       next file-line.
     9462     end.
     9463     run get-bar-code no-error.
     9464     if error-status:error then
     9465       next file-line.
     9466     if  i-cli-base-rate = 1 and
     9467         i-d-pcnt <> 0 then do:
     9468       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Коэффициент равен 1. Скидка должна быть равна 0. Пропускаем." chr(10).
     9469       next file-line.
     9470     end.
     9471     if i-cli-base-rate > 1 and
     9472         i-d-pcnt < 0 then do:
     9473       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Коэффициент больше 1. Скидка должна быть больше или равна 0. Пропускаем." chr(10).
     9474       next file-line.
     9475     end.
     9476     if i-cli-base-rate < 1 and
     9477         i-d-pcnt > 0 then do:
     9478       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Коэффициент меньше 1. Скидка должна быть меньше или равна 0. Пропускаем." chr(10).
     9479       next file-line.
     9480     end.
     9481     if  i-price < 0 then do:
     9482       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Цена неправильная. Пропускаем." chr(10).
     9483       next file-line.
     9484     end.
     9485     if lookup (InputMode, "prod-bc,all") > 0 then do:
     9486       run imp-prod-bc no-error.
     9487       if error-status:error then do:
     9488         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted SUBSTITUTE("Ошибка при вызове внутренней процедуры imp-prod-bc &1 &2 &3",
     9489                               return-value,
     9490                               error-status:get-message(1),
     9491                               error-status:get-message(2))  + chr(10).
     9492         next file-line.
     9493       end.
     9494     end.
     9495     if lookup (InputMode, "input-way-bill,all") > 0 then do:
     9496       if i-price = ? or
     9497          i-price = 0 then do:
     9498         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Цена неправильная. Пропускаем." chr(10).
     9499         next file-line.
     9500       end.
     9501       run imp-input-way-bill no-error.
     9502       if error-status:error then do:
     9503          if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted SUBSTITUTE("Ошибка при вызове внутренней процедуры imp-input-way-bill &1 &2 &3",
     9504                                                       return-value,
     9505                                                       error-status:get-message(1),
     9506                                                       error-status:get-message(2))  + chr(10).
     9507          next file-line.
     9508        end.
     9509     end.
     9510     if lookup (InputMode, "overvalue,all") > 0 then do:
     9511       if  i-price = ? or
     9512           i-price = 0 then do:
     9513         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Цена неправильная. Пропускаем." chr(10).
     9514         next file-line.
     9515       end.
     9516       run imp-overvalue no-error.
     9517       if error-status:error then do:
     9518         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted SUBSTITUTE("Ошибка при вызове внутренней процедуры imp-overvalue &1 &2 &3",
     9519                                                   return-value,
     9520                                                   error-status:get-message(1),
     9521                                                   error-status:get-message(2))  + chr(10).
     9522         next file-line.
     9523      end.
     9524     end.
     9525   END.
     9526   hide frame a .
     9527   procedure get-bar-code:
     9528   define variable s-in-code   like ub.parts.in-code   no-undo.
     9529   define variable s-part-code like ub.parts.part-code no-undo.
     9530   define variable new-bar-code as log              no-undo.
     9531     assign
     9532       s-in-code   = ""
     9533       s-part-code = ""
     9534       .
     9535   find-create-bc:
     9536   do transaction
     9537   on error undo find-create-bc, return error
     9538   on stop  undo find-create-bc, return error:
     9539   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     9541     (input  ub.goods.gds-code
     9542     ,input  ub.gds-prt.node-code
     9543     ,input  s-part-code
     9544     ,input  s-in-code
     9545     ,input  i-unit-cli
     9546     ,input  i-cli-base-rate
     9547     ,output new-bar-code
     9548     ,buffer ub.bar-code
     9549     ) no-error .
     9550     if error-status:error then do:
     9551       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   " Собственный код : "                     ub.bar-code.b-code   " Единица измерения собственного кода : " ub.bar-code.unit-cli   " коэффициент собственного кода : "        ub.bar-code.cli-base-rate   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Ошибка при поиске / создании собственного кода. Пропускаем." chr(10).
     9552       undo find-create-bc, return error.
     9553     end.
     9554     if new-bar-code then do:
     9555       if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   " Собственный код : "                     ub.bar-code.b-code   " Единица измерения собственного кода : " ub.bar-code.unit-cli   " коэффициент собственного кода : "        ub.bar-code.cli-base-rate   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Создан собственный код с единицей измерения из входного файла." chr(10).
     9556     end.
     9557     if ub.bar-code.cli-base-rate <> i-cli-base-rate then do:
     9558       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   " Собственный код : "                     ub.bar-code.b-code   " Единица измерения собственного кода : " ub.bar-code.unit-cli   " коэффициент собственного кода : "        ub.bar-code.cli-base-rate   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Коэффициент в собственном коде не совпадает с указанным в файле. Пропускаем." chr(10).
     9559       undo find-create-bc, return error.
     9560     end.
     9561   end.
     9562   end procedure.
     9563   procedure imp-prod-bc:
     9564   def buffer same-prod-bc  for ub.prod-bc.
     9565   def buffer same-bar-code for ub.bar-code.
     9566   def buffer same-goods    for ub.goods.
     9567   define buffer buf_prod-bc-attr for prod-bc-attr.
     9568   define variable vMarkType as integer no-undo.
     9569   vMarkType = int(i-cst-code)no-error.
     9570   tr:
     9571   do on error undo tr, return error SUBSTITUTE("Ошибка при импорте доп. бар-кода &1 &2 &3 ", i-prod-bc, error-status:get-message(1), error-status:get-message(2)):
     9572   if  length (i-prod-bc) > 13  and
     9573       not is-numeral (i-prod-bc,
     9574                       "letter,digit") or
     9575       length (i-prod-bc) <= 13  and
     9576       not is-numeral (i-prod-bc,
     9577                       "digit") then do:
     9578     if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Доп. БК содержит пробелы или недопустимые символы. Пропускаем." chr(10).
     9579     return.
     9580   end.
     9581   if  i-prod-bc begins par-bc-pfx and
     9582       (length (i-prod-bc) = 13 and
     9583       par-bc-frmt = "EAN13" or
     9584       length (i-prod-bc) = 8 and
     9585       par-bc-frmt = "EAN8") or
     9586       (i-prod-bc begins par-pl-pfx and
     9587       par-pl-pfx <> ? and
     9588       par-pl-frmt <> ?) and
     9589       (length (i-prod-bc) = 13 and
     9590       par-pl-frmt = "EAN13" or
     9591       length (i-prod-bc) = 8 and
     9592       par-pl-frmt = "EAN8") then do:
