     7531                                        in-vatp-goods.prod-type = b_doc-line.prod-type and
     7532                                        in-vatp-goods.prod-code = b_doc-line.prod-code no-lock.
     7533      if (not b_trn-doc.internal and
     7534              b_trn-doc.doc-type = 'при':U) or
     7535         in-vatp-goods.gds-type = 'у':U then do:
     7536         if varinvprb = "base":u then do:
     7537           assign
     7538             road-tax-base-loc = b_doc-line.road-tax
     7539             road-tax-rubl-loc = b_doc-line.road-tax * b_trn-doc.base-rate / b_trn-doc.base-scale.
     7540         end.
     7541         else do:
     7542           ASSIGN
     7543             road-tax-rubl-loc = b_doc-line.road-tax
     7544             road-tax-base-loc = b_doc-line.road-tax / b_trn-doc.base-rate * b_trn-doc.base-scale.
     7545         end.
     7546         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     7547         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     7548         assign
     7549           road-tax-cli-loc = ?.
     7550         ASSIGN
     7551           transport-base-loc = (if b_doc-line.transport-base = ? then 0 else b_doc-line.transport-base)
     7552           transport-rubl-loc = (if b_doc-line.transport-rubl = ? then 0 else b_doc-line.transport-rubl)
     7553           transport-cli-loc  = 0
     7554           other-base-loc     = (if b_doc-line.other-base     = ? then 0 else b_doc-line.other-base)
     7555           other-rubl-loc     = (if b_doc-line.other-rubl     = ? then 0 else b_doc-line.other-rubl)
     7556           other-cli-loc      = 0
     7557           vat-pc-loc         = (if b_doc-line.vat-pc         = ? then 0 else b_doc-line.vat-pc)
     7558           slt-pc-loc         = (if b_doc-line.slt-pc         = ? then 0 else b_doc-line.slt-pc).
     7559                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     7560               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     7561         assign
     7562           vat-cli-loc            = ?
     7563           slt-cli-loc            = ?
     7564           price-cli-with-tax-loc = ?.
     7565      end.
     7566      else do:
     7567                                                   for each in-vatp-parts where in-vatp-parts.out-code  = b_doc-line.doc-code  and
     7568                                         in-vatp-parts.obj-type  = b_doc-line.obj-type  and
     7569                                         in-vatp-parts.obj-code  = b_doc-line.obj-code  and
     7570                                         in-vatp-parts.artic     = b_doc-line.artic     and
     7571                                         in-vatp-parts.prod-type = b_doc-line.prod-type and
     7572                                         in-vatp-parts.prod-code = b_doc-line.prod-code
     7573                            use-index out-code no-lock:
     7574             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     7575                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     7576                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     7577                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     7578                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     7579                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     7580                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     7581                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     7582                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     7583                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     7584                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     7585                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     7586                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     7587                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     7588                         .
     7589         end.
     7590         ASSIGN
     7591           road-tax-base-loc   = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7592           road-tax-rubl-loc   = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7593           transport-base-loc  = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7594           transport-rubl-loc  = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7595           other-base-loc      = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7596           other-rubl-loc      = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7597                                           vat-base-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b_doc-line.fact-qnty   else 0
     7598           slt-base-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     7599                   vat-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b_doc-line.fact-qnty   else 0
     7600           slt-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     7601           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     7602           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     7603         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     7604         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     7605         if transport-base-loc = ? then transport-base-loc = 0.
     7606         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     7607         if other-base-loc     = ? then other-base-loc     = 0.
     7608         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     7609         assign
     7610           transport-cli-loc      = 0
     7611           other-cli-loc          = 0
     7612           road-tax-cli-loc       = ?
     7613           vat-cli-loc            = ?
     7614           slt-cli-loc            = ?
     7615           price-cli-with-tax-loc = ?.
     7616      end.
     7617   ASSIGN
     7618             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     7619       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     7620   .
     7621                if var-pr-r-b = "rubl" then
     7622                    s-cost = price-rubl-with-tax-loc.
     7623                  else
     7624                    s-cost = price-base-with-tax-loc.
     7625                s-qnty = b_doc-line.fact-qnty .
     7626              end.
     7627              else do:
     7628                assign
     7629                 s-cost = 0
     7630                 s-qnty = 0
     7631                .
     7632              end.
     7633              l_price  =  (f-cost * f-qnty + s-cost * s-qnty ) / (f-qnty + s-qnty)  .
     7634           end.
     7635           when "cost-vat":u then do:
     7636                run str/gdsnovat.p ('Уч+накл-НДС':U,
     7637                        b_trn-doc.obj-type,
     7638                        b_trn-doc.obj-code,
     7639                        b_trn-doc.host-code,
     7640                        b_doc-line.artic,
     7641                        b_doc-line.prod-type,
     7642                        b_doc-line.prod-code,
     7643                        0 ,
     7644                        b_doc-line.doc-code,
     7645                        ?,
     7646                        ?,
     7647                        output cost-base   ,
     7648                        output cost-rubl   ,
     7649                        output v-price-base  ,
     7650                        output v-price-rubl  ,
     7651                        output cur-rt-base ,
     7652                        output cur-rt-rubl ).
     7653                        if var-pr-r-b = "rubl"
     7654                           then l_price = v-price-rubl.
     7655                           else l_price = v-price-base.
     7656           end.
     7657           when "sale":u then do:
     7658                 l_price = ( if var-pr-r-b = "rubl"
     7659                                then b_doc-line.price-rubl
     7660                                else b_doc-line.price-base ).
     7661           end.
     7662           when "prod":u then do:
     7663   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7664   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     7665   (  input  b_price-doc-forming-gds.b-code
     7666    , input  p-obj-type
     7667    , input  p-obj-code
     7668    , output l_pricewithoutvat
     7669    , output l_price
     7670    , output l_prod-vat
     7671    , output v-str2
     7672    , output v-str2
     7673           )  .
     7674       end.
     7675      when "prod-vat":u then do:
     7676   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     7678   (  input  b_price-doc-forming-gds.b-code
     7679    , input  p-obj-type
     7680    , input  p-obj-code
     7681    , output l_price
     7682    , output l_pricewithvat
     7683    , output l_prod-vat
     7684    , output v-str2
     7685    , output v-str2
     7686           )  .
     7687       end.
     7688         end case.
     7689           tt-price-sale = b_price-doc-forming-gds.price-sale-rubl .
     7690           t-prc = (( tt-price-sale /  v-koff ) / l_price - 1) * 100.
     7691      end.
     7692   end.
     7693     if  p-prc-max <> ? then do:
     7694       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
     7695       then do:
     7696         message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     7697             else "По признаку"  )
     7698             b_price-doc-forming-gds.artic
     7699             b_price-doc-forming-gds.prod-type
     7700             b_price-doc-forming-gds.prod-code skip
     7701             "бар-код: " b_price-doc-forming-gds.b-code
     7702              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     7703                else "" ) skip
     7704             fnc-pr  (buffer b_price-doc-forming-gds)
     7705             skip
     7706           "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     7707           "Процент не менее :" p-prc-min "%" skip
     7708           "Процент не более :" p-prc-max "%" skip
     7709           "Процент фактический :" t-prc  "%"  skip
     7710           "ДНЦ №: " b_price-doc-forming-gds.pdf-id         skip
     7711           "БД" b_price-doc-forming-gds.pdf-db
     7712             view-as alert-box error .
     7713                 p-err = true .
     7714                 undo , return error .
     7715       end.
     7716       else do:
     7717          if  t-prc = ? then  do:
     7718             message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     7719             else "По признаку"  )
     7720             b_price-doc-forming-gds.artic
     7721             b_price-doc-forming-gds.prod-type
     7722             b_price-doc-forming-gds.prod-code skip
     7723             "бар-код: " b_price-doc-forming-gds.b-code
     7724              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     7725                else "" ) skip
     7726             fnc-pr  (buffer b_price-doc-forming-gds)
     7727             skip
     7728             "Нет базовой цены для расчета процента наценки !" skip
     7729             "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     7730             "Процент не менее :" p-prc-min "%" skip
     7731             "Процент не более :" p-prc-max "%" skip
     7732             "Процент фактический :" t-prc  "%"  skip
     7733             "ДНЦ №_: " b_price-doc-forming-gds.pdf-id         skip
     7734             "БД" b_price-doc-forming-gds.pdf-db
     7735             view-as alert-box error .
     7736             p-err = true .
     7737             undo , return error .
     7738          end.
     7739       end.
     7740     end.
     7741   end.
     7742     end.
     7743   end procedure.
     7744   procedure del-doc-line :
     7745   define input  parameter p-recid as recid no-undo .
     7746     do
     7747     on error undo, return error return-value
     7748     :
     7749     find first ub.price-doc-forming-gds exclusive-lock where
     7750          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     7751      if available ub.price-doc-forming-gds then do:
     7752         delete ub.price-doc-forming-gds no-error .
     7753      end.
     7754     end.
     7755   end procedure.
