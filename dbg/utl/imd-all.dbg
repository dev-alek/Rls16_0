     6868   old-price = ? .
     6869     for each buf_price-doc-forming-gds-tnv no-lock where
     6870              buf_price-doc-forming-gds-tnv.plt-id     = buf_price-doc-forming-gds.plt-id and
     6871              buf_price-doc-forming-gds-tnv.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
