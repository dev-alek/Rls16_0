     6884     if buf_price-list-type.main = false then do:
     6885        for each old_price-doc-forming no-lock where
     6886                 old_price-doc-forming.plt-id     = buf_price-list-type.plt-id     and
     6887                 old_price-doc-forming.plt-db-num = buf_price-list-type.plt-db-num and
     6888                 old_price-doc-forming.stts       = integer('3':U)  ,
     6889                 each old_price-doc-forming-gds no-lock where
     6890                       old_price-doc-forming-gds.plt-id     = buf_price-list-type.plt-id      and
     6891                       old_price-doc-forming-gds.plt-db-num = buf_price-list-type.plt-db-num  and
     6892                       old_price-doc-forming-gds.pdf-id     = old_price-doc-forming.pdf-id    and
     6893                       old_price-doc-forming-gds.pdf-db     = old_price-doc-forming.pdf-db    and
     6894                       old_price-doc-forming-gds.b-code     = buf_price-doc-forming-gds.b-code :
     6895                for each old_price-all no-lock where
     6896                         old_price-all.plt-id     = old_price-doc-forming-gds.plt-id      and
     6897                         old_price-all.plt-db-num = old_price-doc-forming-gds.plt-db-num  and
     6898                         old_price-all.pdf-id     = old_price-doc-forming-gds.pdf-id      and
     6899                         old_price-all.pdf-db     = old_price-doc-forming-gds.pdf-db      and
     6900                         old_price-all.b-code     = old_price-doc-forming-gds.b-code      and
     6901                         old_price-all.fact-order-sys-to   >= v-fact-order-sys-from       and
     6902                         old_price-all.fact-order-sys-from <= v-fact-order-sys-to         :
     6903                        return error substitute ("По товару &1 &2 &3 есть цена &6 в пересекающийся период с таким же приоритетом &7 (ДНЦ &4 &5) " ,
     6904                                                  buf_price-doc-forming-gds.artic ,
     6905                                                  buf_price-doc-forming-gds.prod-type ,
