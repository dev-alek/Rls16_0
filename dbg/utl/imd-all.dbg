     5596   procedure create-calc-bc :
     5597   define input parameter  v-new-recid as recid no-undo .
     5598   define input parameter  p-calc-method  as character no-undo .
     5599   define input parameter  p-increase-pc  as decimal   no-undo .
     5600   define input parameter  round-method as character no-undo .
     5601   define input parameter  round-base   as decimal   no-undo .
     5602   define input parameter  p-b-code     as integer   no-undo .
     5603   define input parameter  p-gds-code   as integer   no-undo .
     5604   define input parameter  p-artic      as character no-undo .
     5605   define input parameter  p-prod-type  as character no-undo .
     5606   define input parameter  p-prod-code  as integer   no-undo .
     5607   define input parameter  v-base-rate  as decimal   no-undo .
     5608   define input parameter  v-base-scale as decimal   no-undo .
     5609   define input parameter  v-exch-scale as decimal   no-undo .
     5610   define input parameter  v-exch-rate  as decimal   no-undo .
     5611   define input parameter  v-doc-code   as character no-undo .
     5612   define input parameter  v-common-price as decimal   no-undo .
     5613   define input parameter  v-copy-type as character no-undo .
     5614   define input parameter  v-copy-code as integer   no-undo .
     5615   define input-output parameter v-line-num as integer   no-undo .
     5616   define input-output parameter v-sec     as integer   no-undo .
     5617   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     5618   define variable v-price-calc-base as decimal   no-undo .
     5619   define variable v-price-calc-doc  as decimal   no-undo .
     5620   define variable v-price-calc-rubl as decimal   no-undo .
     5621   define variable v-price-prev-base as decimal   no-undo .
     5622   define variable v-price-prev-doc  as decimal   no-undo .
     5623   define variable v-price-prev-rubl as decimal   no-undo .
     5624   define variable v-price-sale-base as decimal   no-undo .
     5625   define variable v-price-sale-doc  as decimal   no-undo .
     5626   define variable v-price-sale-rubl as decimal   no-undo .
     5627   define variable v-road-tax-base   as decimal   no-undo .
     5628   define variable v-road-tax-doc    as decimal   no-undo .
     5629   define variable v-road-tax-rubl   as decimal   no-undo .
     5630   define variable v-excise-base     as decimal   no-undo .
     5631   define variable v-excise-doc      as decimal   no-undo .
     5632   define variable v-excise-rubl     as decimal   no-undo .
     5633   define variable v-vat-pc          as decimal   no-undo .
     5634   define variable v-slt-pc          as decimal   no-undo .
     5635   define variable v-prev-doc-code   as character no-undo .
     5636   define variable v-d-pcnt as decimal   no-undo .
     5637     do
     5638     on error undo, return error return-value
     5639     :
     5640     find  buf_price-doc-forming no-lock where
     5641           recid(buf_price-doc-forming) = v-new-recid no-error .
     5642      if error-status :error then return error error-status :get-message(1) .
     5643      v-line-num = v-line-num + 1.
     5644      run calc-price-line  in this-procedure (
     5645        input  p-calc-method
     5646      , input  p-increase-pc
     5647      , input  round-method
     5648      , input  round-base
     5649      , input  p-b-code
     5650      , input  p-gds-code
     5651      , input  p-artic
     5652      , input  p-prod-type
     5653      , input  p-prod-code
     5654      , input  v-base-rate
     5655      , input  v-base-scale
     5656      , input  v-exch-scale
     5657      , input  v-exch-rate
     5658      , input  v-doc-code
     5659      , input  v-common-price
     5660      , input  v-copy-type
     5661      , input  v-copy-code
     5662      , output p-calc-method
     5663      , output v-price-calc-base
     5664      , output v-price-calc-doc
     5665      , output v-price-calc-rubl
     5666      , output v-price-prev-base
     5667      , output v-price-prev-doc
     5668      , output v-price-prev-rubl
     5669      , output v-price-sale-base
     5670      , output v-price-sale-doc
     5671      , output v-price-sale-rubl
     5672      , output v-road-tax-base
     5673      , output v-road-tax-doc
     5674      , output v-road-tax-rubl
     5675      , output v-excise-base
     5676      , output v-excise-doc
     5677      , output v-excise-rubl
     5678      , output v-vat-pc
     5679      , output v-slt-pc
     5680      , output v-prev-doc-code
     5681      , output v-d-pcnt
     5682      ) no-error .
     5683      if error-status :error then
     5684      message
     5685        vss-workfile vss-revision vss-description skip
     5686        error-status :get-message(1) skip
     5687        return-value skip
     5688        "123calc-price-line"
     5689        "p-calc-method     "  p-calc-method     skip
     5690        "p-increase-pc     "  p-increase-pc     skip
     5691        "round-method      "    round-method    skip
     5692        "round-base        "    round-base      skip
     5693        "p-b-code          "    p-b-code        skip
     5694        "p-gds-code        "    p-gds-code      skip
     5695        "p-artic           "    p-artic         skip
     5696        "p-prod-type       "    p-prod-type     skip
     5697        "p-prod-code       "    p-prod-code     skip
     5698        "v-base-rate       "   v-base-rate     skip
     5699        "v-base-scale      "  v-base-scale    skip
     5700        "v-exch-scale      "  v-exch-scale    skip
     5701        "v-exch-rate       "  v-exch-rate     skip
     5702        "v-doc-code        "  v-doc-code      skip
     5703        "v-common-price    "  v-common-price  skip
     5704        "v-copy-type       "  v-copy-type     skip
     5705        "v-copy-code       "  v-copy-code     skip
     5706        "v-d-pcnt          "  v-d-pcnt
     5707        view-as alert-box error
     5708      .
     5709      run create-line  in this-procedure (
     5710        buf_price-doc-forming.plt-db-num
     5711       ,buf_price-doc-forming.plt-id
     5712       ,buf_price-doc-forming.pdf-db
     5713       ,buf_price-doc-forming.pdf-id
     5714       ,v-line-num
     5715       ,p-b-code
     5716       ,p-artic
     5717       ,p-prod-type
     5718       ,p-prod-code
     5719       ,p-calc-method
     5720       ,v-d-pcnt
     5721       ,buf_price-doc-forming.have-start-period
     5722       ,buf_price-doc-forming.start-date
     5723       ,buf_price-doc-forming.start-shift-date
     5724       ,buf_price-doc-forming.start-shift-name
     5725       ,buf_price-doc-forming.start-shift-num
     5726       ,buf_price-doc-forming.start-sys-date
     5727       ,buf_price-doc-forming.start-sys-time
     5728       ,buf_price-doc-forming.have-end-period
     5729       ,buf_price-doc-forming.end-date
     5730       ,buf_price-doc-forming.end-shift-date
     5731       ,buf_price-doc-forming.end-shift-name
     5732       ,buf_price-doc-forming.end-shift-num
     5733       ,buf_price-doc-forming.end-sys-date
     5734       ,buf_price-doc-forming.end-sys-time
     5735       ,v-price-calc-base
     5736       ,v-price-calc-doc
     5737       ,v-price-calc-rubl
     5738       ,v-price-prev-base
     5739       ,v-price-prev-doc
     5740       ,v-price-prev-rubl
     5741       ,v-price-sale-base
     5742       ,v-price-sale-doc
     5743       ,v-price-sale-rubl
     5744       ,v-road-tax-base
     5745       ,v-road-tax-doc
     5746       ,v-road-tax-rubl
     5747       ,v-excise-base
     5748       ,v-excise-doc
     5749       ,v-excise-rubl
     5750       ,v-vat-pc
     5751       ,v-slt-pc
     5752       ,v-prev-doc-code
     5753       ,0
     5754       ,input-output v-sec
     5755        ) no-error  .
     5756        if error-status :error then
     5757        message
     5758          vss-workfile vss-revision vss-description skip
     5759          error-status :get-message(1) skip
     5760          return-value skip
     5761          "4567"
     5762          view-as alert-box error
     5763        .
     5764     end.
     5765   end procedure.
     5766   procedure re-define :
     5767   define input-output parameter p-calc-method      as character no-undo .
     5768   define input        parameter p-gds-code         as integer   no-undo .
     5769     do
     5770     on error undo, return error return-value
     5771     :
     5772   define buffer buf_goods for ub.goods  .
     5773   define buffer buf_gds-grp for ub.gds-grp  .
     5774       case p-calc-method :
     5775         when 'Товар':U then do:
     5776              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     5777                   case buf_goods.calc-method:
     5778                     when 'Группа':U then do:
     5779                       find first buf_gds-grp no-lock where
     5780                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     5781                       p-calc-method  = buf_gds-grp.calc-method.
     5782                     end.
     5783                   otherwise do:
     5784                       p-calc-method  =  buf_goods.calc-method .
     5785                   end.
     5786                   end case.
     5787              run  re-define in this-procedure (
     5788                         input-output  p-calc-method ,
     5789                         input p-gds-code )  .
     5790         end.
     5791         when 'Группа':U then do:
     5792              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     5793              find first buf_gds-grp no-lock where
     5794                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     5795              run re-define in this-procedure (
     5796                         input-output buf_gds-grp.calc-method ,
     5797                         input p-gds-code )  .
     5798         end.
     5799         when 'Учетная':U or
     5800         when 'Учет-объект':U then do:
     5801              p-calc-method = 'УчетнаяS':U .
     5802         end.
     5803         when 'Учет-резерв':U then do:
     5804              p-calc-method = 'Учет-рзрвS':U.
     5805         end.
     5806         when 'Приходная':U or
     5807         when 'Прих-объект':U then do:
     5808              p-calc-method = 'ПриходнаяS':U.
     5809         end.
     5810         when 'Учет-безНДС':U then do:
     5811              p-calc-method = 'Учет-НДСS':U .
     5812         end.
     5813       end case.
     5814     end.
     5815   end procedure.
     5816   procedure create-line-pdf-mpl-lib :
     5817   define input  parameter  p-plt-db-num as integer   no-undo .
     5818   define input  parameter  p-plt-id     as integer   no-undo .
     5819   define input  parameter  p-pdf-db     as integer   no-undo .
     5820   define input  parameter  p-pdf-id     as integer   no-undo .
     5821   define input  parameter  p-line-num   as integer   no-undo .
     5822   define input  parameter  p-b-code     as integer   no-undo .
     5823   define input  parameter  p-artic      as character no-undo .
     5824   define input  parameter  p-prod-type  as character no-undo .
     5825   define input  parameter  p-prod-code  as integer   no-undo .
     5826   define input  parameter  p-met    as character no-undo .
     5827   define input  parameter  p-d-pcnt as decimal   no-undo .
     5828   define input  parameter  p-price  as decimal   no-undo .
     5829   define input  parameter  p-out-code as character no-undo .
     5830   define input  parameter  p-stts as integer   no-undo .
     5831   define input-output  parameter v-sec   as integer   no-undo .
     5832   define variable v-price-calc-base  as decimal   no-undo .
     5833   define variable v-price-calc-doc   as decimal   no-undo .
     5834   define variable v-price-calc-rubl  as decimal   no-undo .
     5835   define variable v-price-prev-base  as decimal   no-undo .
     5836   define variable v-price-prev-doc   as decimal   no-undo .
     5837   define variable v-price-prev-rubl  as decimal   no-undo .
     5838   define variable v-price-sale-base  as decimal   no-undo .
     5839   define variable v-price-sale-doc   as decimal   no-undo .
     5840   define variable v-price-sale-rubl  as decimal   no-undo .
     5841   define variable v-road-tax-base    as decimal   no-undo .
     5842   define variable v-road-tax-doc     as decimal   no-undo .
     5843   define variable v-road-tax-rubl    as decimal   no-undo .
     5844   define variable v-excise-base      as decimal   no-undo .
     5845   define variable v-excise-doc       as decimal   no-undo .
     5846   define variable v-excise-rubl      as decimal   no-undo .
     5847   define variable V-base-rate       as decimal   no-undo .
     5848   define variable V-base-scale      as decimal   no-undo .
     5849   define variable V-exch-scale      as decimal   no-undo .
     5850   define variable V-exch-rate       as decimal   no-undo .
     5851   define variable v-curr-abbr as character no-undo .
     5852   define variable p-vat-pc as decimal   no-undo .
     5853   define variable p-slt-pc as decimal   no-undo .
     5854     do
     5855     on error undo, return error return-value
     5856     :
     5857   find first ub.price-list-type  no-lock  where
     5858              ub.price-list-type.plt-db-num = p-plt-db-num  and
     5859              ub.price-list-type.plt-id     = p-plt-id
     5860              no-error .
     5861   if error-status :error then message
     5862     vss-workfile vss-revision vss-description skip
     5863     error-status :get-message(1) skip
     5864     return-value skip
     5865     "Ошибка!"
     5866     view-as alert-box error
     5867   .
     5868   find first ub.price-doc-forming no-lock  where
     5869              ub.price-doc-forming.plt-db-num = p-plt-db-num and
     5870              ub.price-doc-forming.plt-id     = p-plt-id     and
     5871              ub.price-doc-forming.pdf-db     = p-pdf-db     and
     5872              ub.price-doc-forming.pdf-id     = p-pdf-id
     5873               no-error .
     5874   if error-status :error then message
     5875     vss-workfile vss-revision vss-description skip
     5876     error-status :get-message(1) skip
     5877     return-value skip
     5878     "Ошибка!"
     5879     view-as alert-box error
     5880   .
     5881   find first ub.goods no-lock where
     5882    ub.goods.artic = p-artic and
     5883    ub.goods.prod-type = p-prod-type and
     5884    ub.goods.prod-code = p-prod-code no-error .
     5885   if error-status :error then message
     5886     vss-workfile vss-revision vss-description skip
     5887     error-status :get-message(1) skip
     5888     return-value skip
     5889     "Ошибка!"
     5890     view-as alert-box error
     5891   .
     5892   if ub.price-list-type.fix-cource-crc-base = true then do:
     5893       assign
     5894         V-base-rate  = ub.price-doc-forming.base-rate
     5895         V-base-scale = ub.price-doc-forming.base-scale
