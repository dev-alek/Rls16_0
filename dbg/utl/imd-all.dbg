     5472         assign
     5473            temp-exp-partbc.b-code = buf-bar-code.b-code
     5474         .
     5475    end.
     5476   end.
     5477   for each  buf-price-list where
     5478             buf-price-list.pdf-id     = buf-price-doc-forming.pdf-id and
     5479             buf-price-list.plt-id     = buf-price-doc-forming.plt-id and
     5480             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5481             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5482             buf-price-list.b-code     <> p-main-code         and
     5483             buf-price-list.artic       = buf-goods.artic     and
     5484             buf-price-list.prod-type   = buf-goods.prod-type and
     5485             buf-price-list.prod-code   = buf-goods.prod-code ,
     5486       first buf-bar-code no-lock where
     5487             buf-bar-code.b-code   = buf-price-list.b-code and
     5488             buf-bar-code.unit-cli = buf-goods.unit-base and
     5489             buf-bar-code.in-code <> "" ,
     5490       first buf_parts no-lock where
     5491             buf_parts.out-code    = 'free-zone':U and
     5492             buf_parts.rsrv-free   = true  and
     5493             buf_parts.status_     = false and
     5494             buf_parts.artic       = buf-goods.artic and
     5495             buf_parts.prod-type   = buf-goods.prod-type and
     5496             buf_parts.prod-code   = buf-goods.prod-code and
     5497             buf_parts.obj-type   = v-cntxt-obj-type and
     5498             buf_parts.obj-code   = v-cntxt-obj-code and
     5499             buf_parts.part-code   = buf-bar-code.part-code and
     5500             buf_parts.in-code     = buf-bar-code.in-code
     5501             :
     5502             find first temp-exp-partbc where
     5503                        temp-exp-partbc.b-code = buf-bar-code.b-code no-error .
     5504           if available temp-exp-partbc then next.
     5505      run create-calc-bc in this-procedure
     5506          ( input  recid( new-price-doc-forming )
     5507           ,input  'Старая':U
     5508           ,input  0
     5509           ,input  'Отключено':U
     5510           ,input  0
     5511           ,input  buf-bar-code.b-code
     5512           ,input  buf-goods.gds-code
     5513           ,input  buf-goods.artic
     5514           ,input  buf-goods.prod-type
     5515           ,input  buf-goods.prod-code
     5516           ,input  new-price-doc-forming.base-rate
     5517           ,input  new-price-doc-forming.base-scale
     5518           ,input  new-price-doc-forming.exch-scale
     5519           ,input  new-price-doc-forming.exch-rate
     5520           ,input v-doc-code
     5521           ,input v-common-price
     5522           ,input v-copy-type
     5523           ,input v-copy-code
     5524           ,input-output v-line-num
     5525           ,input-output v-sec
     5526         ) no-error .
