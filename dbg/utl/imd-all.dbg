    10181                   end.
    10182                   imp-save = imp-save + 1.
    10183                   v-sec =  v-sec + 1 .
    10184                     run create-line-pdf-mpl-lib (
    10185                         input buf_price-doc-forming.plt-db-num
    10186                         ,input buf_price-doc-forming.plt-id
    10187                         ,input buf_price-doc-forming.pdf-db
    10188                         ,input buf_price-doc-forming.pdf-id
    10189                         ,input imp-save
    10190                         ,input bf_bar-code.b-code
    10191                         ,input buf_goods.artic
    10192                         ,input buf_goods.prod-type
    10193                         ,input buf_goods.prod-code
    10194                         ,input ""
    10195                         ,input 0
    10196                         ,input v-price
    10197                         ,input ""
    10198                         ,input 0
    10199                         ,input-output v-sec ) no-error .
    10200               end.
    10201           end.
    10202           else do:
    10203           find first main_price-doc-forming-gds no-lock where
    10204                      main_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
    10205                      main_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
    10206                      main_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
    10207                      main_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      and
    10208                      main_price-doc-forming-gds.b-code     = main-b-code no-error .
    10209           if not available main_price-doc-forming-gds then do:
    10210           find first buf_gds-obj no-lock where
    10211                      buf_gds-obj.obj-type = v-cntxt-obj-type  and
    10212                      buf_gds-obj.obj-code = v-cntxt-obj-code  and
    10213                      buf_gds-obj.gds-code = buf_goods.gds-code     no-error .
    10214           run prcreate-new-price-doc-forming-gds in this-procedure (
    10215               input recid ( buf_price-doc-forming )
    10216             , input v-cntxt-obj-type
    10217             , input v-cntxt-obj-code
