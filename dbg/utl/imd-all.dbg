     5528           message
     5529             "Ошибка cre-pr-list.3" skip
     5530             "Код:" buf-bar-code.b-code
     5531             view-as alert-box.
     5532           next.
     5533         end.
     5534       end.
     5535     for each buf_parts no-lock where
     5536             buf_parts.out-code    = 'free-zone':U and
     5537             buf_parts.rsrv-free   = true  and
     5538             buf_parts.status_     = false and
     5539             buf_parts.artic       = buf-goods.artic and
     5540             buf_parts.prod-type   = buf-goods.prod-type and
     5541             buf_parts.prod-code   = buf-goods.prod-code and
     5542             buf_parts.obj-type    = v-cntxt-obj-type and
     5543             buf_parts.obj-code    = v-cntxt-obj-code and
     5544             buf_parts.part-code   = buf-bar-code.part-code and
     5545             buf_parts.in-code     = buf-bar-code.in-code,
     5546           first buf-bar-code no-lock where
     5547                 buf-bar-code.gds-code  = buf-goods.gds-code and
     5548                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     5549                 buf-bar-code.in-code   = buf_parts.in-code and
     5550                 buf-bar-code.part-code = buf_parts.part-code
     5551             :
     5552             find first temp-exp-partbc where
     5553                        temp-exp-partbc.b-code = buf-bar-code.b-code no-error .
     5554           if available temp-exp-partbc then next.
     5555             find first new-price-doc-forming-gds where
     5556                        new-price-doc-forming-gds.pdf-id     = new-price-doc-forming.pdf-id and
     5557                        new-price-doc-forming-gds.pdf-db     = new-price-doc-forming.pdf-db and
     5558                        new-price-doc-forming-gds.plt-id     = new-price-doc-forming.plt-id and
     5559                        new-price-doc-forming-gds.plt-db-num = new-price-doc-forming.plt-db-num  and
     5560                        new-price-doc-forming-gds.b-code = buf-bar-code.b-code
     5561                        no-error .
     5562           if available new-price-doc-forming-gds then next.
     5563      run create-calc-bc in this-procedure
     5564          ( input recid( new-price-doc-forming )
     5565           ,input 'Старая':U
     5566           ,input 0
     5567           ,input 'Отключено':U
     5568           ,input 0
     5569           ,input buf-bar-code.b-code
     5570           ,input buf-goods.gds-code
     5571           ,input buf-goods.artic
     5572           ,input buf-goods.prod-type
     5573           ,input buf-goods.prod-code
     5574           ,input new-price-doc-forming.base-rate
     5575           ,input new-price-doc-forming.base-scale
     5576           ,input new-price-doc-forming.exch-scale
     5577           ,input new-price-doc-forming.exch-rate
     5578           ,input v-doc-code
