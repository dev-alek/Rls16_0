      927   procedure copy_new_price-doc-forming :
      928   define input  parameter       p-recid      as recid no-undo .
      929   define input-output parameter p-plt-db-num as integer   no-undo .
      930   define input-output parameter p-plt-id     as integer   no-undo .
      931   define output parameter       p-pdf-db-num as integer   no-undo .
      932   define output parameter       p-pdf-id     as integer   no-undo .
      933   define buffer buf_price-list-type        for ub.price-list-type  .
      934   define buffer buf_price-doc-forming      for ub.price-doc-forming .
      935   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
      936   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
      937   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
      938   define variable v-host-code  as integer   no-undo .
      939   define variable v-base-rate  as decimal   no-undo .
      940   define variable v-base-scale as integer   no-undo .
      941   define variable v-exch-rate  as decimal   no-undo .
      942   define variable v-exch-scale as integer   no-undo .
      943   define variable v-base as logical   no-undo .
      944   define variable v-name as character no-undo .
      945     do
      946     on error undo, return error return-value
      947     :
      948   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      950     (output v-base
      951     )  .
      952   find first buf_price-list-type no-lock where
      953              buf_price-list-type.plt-db-num = p-plt-db-num and
      954              buf_price-list-type.plt-id     = p-plt-id no-error .
      955   if error-status :error then return error "Не найден ТПЛ".
      956   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
      957   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
      958       if available buf_price-doc-forming then do :
      959           assign
      960             v-base-rate  = buf_price-doc-forming.base-rate
      961             v-base-scale = buf_price-doc-forming.base-scale
      962             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
      963           .
      964       end.
      965       else do:
      966           assign
      967             v-base-rate  = 1
      968             v-base-scale = 1
      969             v-name       = "Автосоздание"
      970           .
      971       end.
      972      create ub.price-doc-forming.
      973      assign
      974         ub.price-doc-forming.plt-id       = p-plt-id
      975         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      976         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      977         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      978         ub.price-doc-forming.base-rate    = v-base-rate
      979         ub.price-doc-forming.base-scale   = v-base-scale
      980         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      981         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
      982         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
      983         ub.price-doc-forming.stts         = 0
      984         ub.price-doc-forming.sys-date     = today
      985         ub.price-doc-forming.sys-time     = time
      986         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
      987         ub.price-doc-forming.who          = v-cntxt-userid
      988         ub.price-doc-forming.name         = v-name
      989      .
      990      assign
      991       p-pdf-db-num  = ub.price-doc-forming.pdf-db
      992       p-pdf-id      = ub.price-doc-forming.pdf-id
      993       p-plt-db-num  = ub.price-doc-forming.plt-db-num
      994       p-plt-id      = ub.price-doc-forming.plt-id
      995      .
      996     end.
      997     if not available buf_price-doc-forming then return .
      998   for each buf_price-doc-forming-attr no-lock where
      999            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1000            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1001            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1002            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1003       create ub.price-doc-forming-attr.
     1004       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1005       assign
     1006         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1007         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1008         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1009         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1010         .
     1011   end.
     1012   for each buf_price-doc-forming-gds no-lock where
     1013            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1014            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1015            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1016            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1017       create ub.price-doc-forming-gds.
     1018       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1019       assign
     1020         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1021         ub.price-doc-forming-gds.plt-id      = p-plt-id
     1022         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     1023         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     1024       .
     1025   end.
     1026   for each buf_pd-forming-gds-attr no-lock where
     1027            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1028            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1029            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1030            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1031       create ub.price-doc-forming-gdsattr.
     1032       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     1033       assign
     1034         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     1035         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     1036         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     1037         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     1038       .
     1039   end.
     1040   end procedure.
     1041   define variable par-pr-incpc as character no-undo.
