     2709   FUNCTION fnc-base-price-doc RETURN decimal
     2710     ( local-bc as integer, p-recid as recid ).
     2711   define buffer   base-price       for ub.price-doc-forming-gds .
     2712   define variable local-main-code like ub.bar-code.b-code no-undo.
     2713   define variable local-base-code like ub.bar-code.b-code no-undo.
     2714   define buffer   buf_main-pdf     for ub.price-doc-forming .
     2715   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     2716     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     2717     find base-price no-lock where
     2718          base-price.pdf-id = buf_main-pdf.pdf-id and
     2719          base-price.pdf-db = buf_main-pdf.pdf-db and
     2720          base-price.plt-id = buf_main-pdf.plt-id and
     2721          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     2722          base-price.b-code  = local-base-code
     2723          no-error.
     2724     if not available base-price then do:
     2725       run prc-main-code in this-procedure
     2726          ( input local-bc, output local-main-code ).
     2727       find  base-price no-lock where
     2728             base-price.pdf-id = buf_main-pdf.pdf-id and
     2729             base-price.pdf-db = buf_main-pdf.pdf-db and
     2730             base-price.plt-id = buf_main-pdf.plt-id and
     2731             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     2732             base-price.b-code  = local-main-code
     2733             no-error.
     2734     end.
     2735     if available base-price then
     2736       return (base-price.price-sale-doc).
     2737     else
     2738       return (?).
     2739   END FUNCTION.
