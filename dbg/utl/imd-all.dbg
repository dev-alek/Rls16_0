     3685   define output parameter  p-price-prev-doc   as decimal   no-undo .
     3686   define output parameter  p-price-prev-rubl  as decimal   no-undo .
     3687   define output parameter  p-price-sale-base  as decimal   no-undo .
     3688   define output parameter  p-price-sale-doc   as decimal   no-undo .
     3689   define output parameter  p-price-sale-rubl  as decimal   no-undo .
     3690   define output parameter  p-road-tax-base    as decimal   no-undo .
     3691   define output parameter  p-road-tax-doc     as decimal   no-undo .
     3692   define output parameter  p-road-tax-rubl    as decimal   no-undo .
     3693   define output parameter  p-excise-base      as decimal   no-undo .
