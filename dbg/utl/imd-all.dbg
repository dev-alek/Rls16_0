     8445   def var vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8446   procedure check-use-bar-code :
     8447     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     8448     do
     8449     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info82, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8450     on stop   undo, return error substitute( "&1. stop", vss-include-info82 )
     8451     on endkey undo, return error substitute( "&1. endkey", vss-include-info82 )
     8452     :
     8453       define buffer buf_bar-code for ub.bar-code .
     8454       find first buf_bar-code no-lock
     8455         where buf_bar-code.b-code     = p-b-code
     8456         no-error .
     8457       if not available buf_bar-code then do:
     8458         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info82, p-b-code ) .
     8459       end.
     8460       if buf_bar-code.stts = integer('99':U) then do:
     8461         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     8462                                 + "Выполняется удаление бар-кода"
     8463                                 ,vss-include-info82
     8464                                 ,p-b-code
     8465                                 ,chr(10)
     8466                               ) .
     8467       end.
     8468       if buf_bar-code.stts = integer('79':U) then do:
     8469         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     8470                                 + "Бар-код выключен"
     8471                                 ,vss-include-info82
     8472                                 ,p-b-code
     8473                                 ,chr(10)
     8474                               ) .
     8475       end.
     8476       return .
     8477     end.
     8478   end procedure.
     8479   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8480   function octal-to-char return character
     8481   ( p-string as character ) :
     8482     def var v-asc     as integer no-undo .
     8483     def var v-new-asc as integer no-undo .
     8484     def var ind       as integer no-undo .
     8485     if length(p-string) <> 3 then do:
     8486       return ? .
     8487     end.
     8488     assign
     8489       v-asc = 0
     8490     .
     8491     do ind = 1 to length(p-string)
     8492     :
     8493       assign
     8494         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     8495       .
     8496       if v-new-asc < 0 or v-new-asc >= 8 then do:
     8497         return ? .
     8498       end.
     8499       assign
     8500         v-asc = v-asc * 8 + v-new-asc
     8501       .
     8502     end.
     8503     return chr(v-asc) .
     8504   end function .
     8505   function char-to-octal return character
     8506   ( p-chr as character ) :
     8507     def var v-asc    as integer   no-undo .
     8508     def var ind      as integer   no-undo .
     8509     def var v-string as character no-undo .
     8510     if length(p-chr) <> 1 then do:
     8511       return ? .
     8512     end.
     8513     assign
     8514       v-asc    = asc(p-chr)
     8515       v-string = ""
     8516     .
     8517     do ind = 1 to 3
     8518     :
     8519       assign
     8520         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     8521       .
     8522       assign
     8523         v-asc = truncate(v-asc / 8, 0)
     8524       .
     8525     end.
     8526     return v-string .
     8527   end.
     8528   function str-encode return character
     8529   (   p-init-string       as character
     8530     , p-encode-char       as character
     8531     , p-special-char-list as character
     8532   ) :
     8533     def var p-encode-string as character no-undo .
     8534     def var ind                as integer no-undo .
     8535     def var v-num-special-char as integer no-undo .
     8536     def var v-special-char     as character no-undo .
     8537     if p-encode-char = ?
     8538     or p-encode-char = "" then do:
     8539       assign
     8540         p-encode-char = "~~"
     8541       .
     8542     end.
     8543     if p-init-string = ? then do:
     8544       return "?" .
     8545     end.
     8546     if p-init-string = "?" then do:
     8547       return p-encode-char + char-to-octal("?") .
     8548     end.
     8549     assign
     8550       v-num-special-char = length(p-special-char-list)
     8551       p-encode-string    = replace(p-init-string
     8552                                   ,p-encode-char
     8553                                   ,p-encode-char + char-to-octal(p-encode-char)
     8554                                   )
     8555     .
     8556     do ind = 1 to v-num-special-char
     8557     :
     8558       assign
     8559         v-special-char = substring(p-special-char-list, ind, 1)
     8560       .
     8561       if v-special-char <> p-encode-char then do:
     8562         assign
     8563           p-encode-string = replace (p-encode-string
     8564                                     ,v-special-char
     8565                                     ,p-encode-char + char-to-octal(v-special-char)
     8566                                     )
     8567         .
     8568       end.
     8569     end.
     8570     return p-encode-string .
     8571   end.
     8572   function str-decode returns character
     8573     (p-init-string   as character
     8574     ,p-encode-char   as character
     8575     ) :
     8576     def var p-decode-string as character no-undo .
     8577     def var ind                       as integer no-undo .
     8578     def var v-num-entries-init-string as integer no-undo .
     8579     def var v-sub-phrase              as character no-undo .
     8580     def var v-special-char            as character no-undo .
     8581     if p-encode-char = ?
     8582     or p-encode-char = "" then do:
     8583       assign
     8584         p-encode-char = "~~"
     8585       .
     8586     end.
     8587     if p-init-string = "?" then do:
     8588       return ? .
     8589     end.
     8590     assign
     8591       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     8592     .
     8593     if v-num-entries-init-string > 1 then do:
     8594       assign
     8595         p-decode-string = entry(1, p-init-string, p-encode-char)
     8596       .
     8597       do ind = 2 to v-num-entries-init-string
     8598       :
     8599         assign
     8600           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     8601         .
     8602         assign
     8603           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     8604         .
     8605         if v-special-char <> ? then do:
     8606           assign
     8607             p-decode-string = p-decode-string
     8608                             + v-special-char
     8609                             + substring(v-sub-phrase, 4)
     8610           .
     8611         end.
     8612         else do:
     8613           assign
     8614             p-decode-string = p-decode-string
     8615                             + p-encode-char
     8616                             + v-sub-phrase
     8617           .
     8618         end.
     8619       end.
     8620     end.
     8621     else do:
     8622       assign
     8623         p-decode-string = p-init-string
     8624       .
     8625     end.
     8626     return p-decode-string .
     8627   end.
