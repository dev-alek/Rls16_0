    10244               ,input buf_price-doc-forming.plt-id
    10245               ,input buf_price-doc-forming.pdf-db
    10246               ,input buf_price-doc-forming.pdf-id
    10247               ,input imp-save
    10248               ,input bf_bar-code.b-code
    10249               ,input buf_goods.artic
    10250               ,input buf_goods.prod-type
    10251               ,input buf_goods.prod-code
    10252               ,input ""
    10253               ,input 0
    10254               ,input v-price
    10255               ,input ""
    10256               ,input 0
    10257               ,input-output v-sec ) no-error .
    10258               if error-status :error then do:
    10259                   if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted SUBSTITUTE("неосновной код: &1 &2",
    10260                             return-value,
