     6925   end.
     6926   end procedure.
     6927   procedure ver-pr-equ-qS :
     6928   define input parameter  p-plt-id      as integer   no-undo .
     6929   define input parameter  p-plt-db-num  as integer   no-undo .
     6930   define input parameter  p-pdf-id      as integer   no-undo .
     6931   define input parameter  p-pdf-db      as integer   no-undo .
     6932     do
     6933     on error undo, return error return-value
     6934     :
     6935   define variable  l-doc-num2   like ub.price-list.doc-num    no-undo .
     6936   define buffer pdf_price-list  for ub.price-doc-forming-gds .
     6937   define buffer pp_price-list   for ub.price-doc-forming-gds .
     6938   define buffer main_price-list for ub.price-doc-forming-gds .
     6939   define buffer alt_price-list  for ub.price-doc-forming-gds .
