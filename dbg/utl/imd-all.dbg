      775       p-plt-db-num  = ub.price-doc-forming.plt-db-num
      776       p-plt-id      = ub.price-doc-forming.plt-id
      777      .
      778     end.
      779   end procedure.
      780   procedure prcreate-new-price-doc-forming-gds :
      781   define input  parameter p-price-doc-forming-recid as recid  no-undo.
      782   define input  parameter p-obj-type   as character no-undo .
      783   define input  parameter p-obj-code   as integer   no-undo .
      784   define input  parameter par-pr-notls as character no-undo .
      785   define input  parameter par-pr-altex as character no-undo .
      786   define input  parameter par-pr-sclex as character no-undo .
      787   define input  parameter p-line-num    as integer   no-undo .
      788   define input  parameter p-gds-code    as integer   no-undo .
      789   define input  parameter p-price-sale  as decimal   no-undo .
      790   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      791   define buffer buf_goods for ub.goods  .
      792   define buffer buf_bar-code for ub.bar-code  .
      793   define buffer main_bar-code for ub.bar-code  .
      794   define variable main-b-code as integer   no-undo .
      795   define variable v-sec as integer   no-undo .
      796     do
      797     on error undo, return error return-value
      798     :
      799   define variable v-cur-dn as character no-undo .
      800   define variable v-cur-pr as decimal   no-undo .
      801   define variable v-cur-rt as decimal   no-undo .
      802   define variable v-cur-ex as decimal   no-undo .
      803   find first buf_price-doc-forming no-lock where
      804              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
      805              if error-status :error then return error .
      806   find first buf_goods no-lock where
      807              buf_goods.gds-code  = p-gds-code no-error .
      808              if error-status :error then return error .
      809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      810     (input  buf_goods.gds-code
