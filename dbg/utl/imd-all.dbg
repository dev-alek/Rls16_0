     4767   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     4768   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     4769   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     4770   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     4771   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     4772   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     4773   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     4774   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     4775   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     4776   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     4777   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     4778   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     4779   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     4780   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     4781   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     4782   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     4783   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     4784   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     4785   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     4786   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     4787   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     4788   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     4789   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     4790   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     4791   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     4792   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     4793   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     4794   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     4795   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     4796   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     4797   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     4798   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     4799   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     4800   define input  parameter p-prev-doc-code     as character no-undo .
     4801   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     4802   define input-output parameter  v-sec        as integer   no-undo .
     4803     run check-use-bar-code ( p-b-code ) no-error .
     4804     if error-status :error then do:
     4805       message
     4806         return-value skip
     4807         "Ошибка !"
     4808         view-as alert-box error
     4809       .
     4810       undo, return error return-value.
     4811     end.
     4812   find first ub.price-doc-forming-gds exclusive-lock where
     4813              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     4814              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     4815              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     4816              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     4817              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     4818       if not available ub.price-doc-forming-gds then
     4819       do:
     4820         create ub.price-doc-forming-gds .
     4821          assign
     4822           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     4823           ub.price-doc-forming-gds.plt-id     = p-plt-id
     4824           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     4825           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     4826           ub.price-doc-forming-gds.b-code     = p-b-code
     4827           ub.price-doc-forming-gds.line-num   = p-line-num
     4828          .
     4829       end.
     4830     assign
     4831       ub.price-doc-forming-gds.artic            = p-artic
     4832       ub.price-doc-forming-gds.prod-type        = p-prod-type
     4833       ub.price-doc-forming-gds.prod-code        = p-prod-code
     4834       ub.price-doc-forming-gds.calc-method      = p-calc-method
     4835       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     4836       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     4837       ub.price-doc-forming-gds.start-date       = p-start-date
     4838       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     4839       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     4840       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     4841       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     4842       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     4843       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     4844       ub.price-doc-forming-gds.end-date         = p-end-date
     4845       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     4846       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     4847       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     4848       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     4849       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     4850       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     4851       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     4852       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     4853       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     4854       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     4855       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     4856       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     4857       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     4858       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     4859       ub.price-doc-forming-gds.excise-base      = p-excise-base
     4860       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     4861       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     4862       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     4863       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     4864       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     4865       ub.price-doc-forming-gds.stts             = p-stts
     4866       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     4867       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     4868       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     4869       .
     4870     run ref/h-pdfgds.p
     4871       ( buffer ub.price-doc-forming-gds ,
     4872         input p-price-sale-doc ,
     4873         input-output v-sec
     4874         ) .
     4875   END PROCEDURE.
     4876   PROCEDURE last-num :
     4877   define input  parameter p-recid as recid no-undo .
     4878   define output parameter p-last-id as integer   no-undo .
     4879   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     4880   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     4881   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     4882         if error-status :error then do:
     4883           p-last-id = ? .
     4884           return .
     4885         end.
     4886       for each buf2_price-doc-forming-gds no-lock  where
     4887               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     4888               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     4889               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     4890               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     4891               by buf2_price-doc-forming-gds.line-num
     4892               :
     4893               p-last-id = buf2_price-doc-forming-gds.line-num .
     4894       end.
     4895   END PROCEDURE.
     4896   PROCEDURE calc-price-alt :
     4897   define input parameter bc         like ub.bar-code.b-code   no-undo.
     4898   define input parameter p-recid as recid no-undo .
     4899   define input parameter d-pcnt as decimal   no-undo .
     4900   define input parameter r-method   as character no-undo .
     4901   define input parameter r-base     as decimal   no-undo .
     4902   define output parameter pa-price-sale-base  as decimal   no-undo .
     4903   define output parameter pa-price-sale-doc   as decimal   no-undo .
     4904   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     4905   pr-alt:
     4906   do on error undo pr-alt, return error:
     4907     if r-method = ? or
     4908        r-base = ? then do:
     4909       message
     4910         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     4911         "Код:" bc skip
     4912         view-as alert-box error.
     4913       undo pr-alt, return error.
     4914     end.
     4915   define buffer buf_bar-code for ub.bar-code  .
     4916   define buffer buf_main_bar-code for ub.bar-code  .
     4917   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     4918   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     4919   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     4920   if error-status :error then
     4921   message
     4922     vss-workfile vss-revision vss-description skip
     4923     error-status :get-message(1) skip
     4924     return-value skip
     4925     "Ошибка "
     4926     view-as alert-box error
     4927   .
     4928   find first buf_bar-code no-lock where
     4929              buf_bar-code.b-code = bc no-error .
     4930   if error-status :error then
     4931   message
     4932     vss-workfile vss-revision vss-description skip
     4933     error-status :get-message(1) skip
     4934     return-value skip
     4935     "3"
     4936     view-as alert-box error
     4937   .
     4938         assign
     4939           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     4940                               buf_bar-code.cli-base-rate *
     4941                               (1 - d-pcnt / 100)
     4942                                 .
     4943     if pa-price-sale-doc <> 0 then do:
     4944   case r-method :
     4945     when '9-окончание':U then do:
     4946       if pa-price-sale-doc < 29 then do:
     4947         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     4948           assign
     4949             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     4950           .
     4951         end.
     4952       end.
     4953       else do:
     4954         if (pa-price-sale-doc modulo 10) < 3 then do:
     4955           assign
     4956             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     4957                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     4958                   - 1 ) * 10
     4959                 + 9
     4960           .
     4961         end.
     4962         else do:
     4963           assign
     4964             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     4965                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     4966                   ) * 10
     4967                 + 9
     4968           .
     4969         end.
     4970         assign
     4971           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     4972         .
     4973       end.
     4974     end.
     4975     when '9-99окончание':U then do:
     4976       if pa-price-sale-doc < r-base then do:
     4977         assign
     4978           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     4979         .
     4980       end.
     4981       else do:
     4982         assign
     4983           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     4984         .
     4985       end.
     4986     end.
     4987     when 'Без-дробных':U then do:
     4988       assign
     4989         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     4990       .
     4991     end.
     4992     when 'Произвольно':U then do:
     4993       if r-base <> 0 then do:
     4994         assign
     4995           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     4996         .
     4997         if pa-price-sale-doc = 0 then do:
     4998           assign
     4999             pa-price-sale-doc = r-base
     5000           .
     5001         end.
     5002       end.
     5003     end.
     5004     when 'Вверх':U then do:
     5005       if r-base <> 0 then do:
     5006         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     5007           assign
     5008             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     5009           .
     5010         end.
     5011       end.
     5012       if pa-price-sale-doc = 0 then do:
     5013         assign
     5014           pa-price-sale-doc = r-base
     5015         .
     5016       end.
     5017     end.
     5018     when 'Коэффициент':U then do:
     5019       if r-base <> 0 then do:
     5020         assign
     5021           pa-price-sale-doc = pa-price-sale-doc * r-base
     5022         .
     5023       end.
     5024     end.
     5025     when 'Отключено':U then do:
     5026     end.
     5027     otherwise do:
     5028       message
     5029         vss-workfile vss-revision vss-description skip
     5030         "Неизвестный метод округления продажной цены" skip
     5031         "round-method" r-method skip
     5032         "round-base"   r-base   skip
     5033         "price"        pa-price-sale-doc             skip
     5034         view-as alert-box error .
     5035     end.
     5036   end.
     5037     end.
     5038     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     5039     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     5040   end.
     5041   END PROCEDURE.
     5042   procedure calc-price-discnt :
     5043     do
     5044     on error undo, return error return-value
     5045     :
     5046   define input parameter p-recid as recid no-undo .
     5047   define input parameter bc    like ub.bar-code.b-code   no-undo.
     5048   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     5049   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5050   define buffer buf-bar-code                      for ub.bar-code.
     5051   define buffer buf-goods                         for ub.goods.
     5052   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     5053   define variable pr-rec   as   recid                     no-undo.
     5054   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     5055   pr-discnt:
     5056   do on error undo pr-discnt, return error:
     5057     find  buf-price-doc-forming no-lock where
     5058           recid(buf-price-doc-forming) = p-recid .
     5059     find  buf-bar-code no-lock where
     5060           buf-bar-code.b-code = bc.
     5061     find  buf-goods no-lock where
     5062           buf-goods.gds-code = buf-bar-code.gds-code.
     5063     find  buf-price-doc-forming-gds exclusive-lock where
     5064           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5065           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5066           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5067           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5068           buf-price-doc-forming-gds.b-code  = bc.
     5069      if available buf-price-doc-forming-gds then do:
     5070         buf-price-doc-forming-gds.d-pcnt =
     5071         (1 - buf-price-doc-forming-gds.price-sale-doc /
     5072               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     5073               buf-bar-code.cli-base-rate) * 100 .
     5074      end.
     5075   end.
     5076     end.
     5077   end procedure.
     5078   procedure calc-price-sub :
     5079   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     5080   define  input  parameter p-recid      as recid no-undo .
     5081   define  input  parameter calc-method  as character         no-undo.
     5082   define  input  parameter increase-pc  as decimal           no-undo.
     5083   define  input  parameter round-method as character         no-undo.
     5084   define  input  parameter round-base   as decimal           no-undo.
     5085   define  input  parameter doc-code     as character no-undo .
     5086   define  input  parameter common-price as decimal   no-undo .
     5087   define  input  parameter copy-type    as character no-undo .
     5088   define  input  parameter copy-code    as integer   no-undo .
     5089   define  output parameter calc-rec     as recid             no-undo.
     5090   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5091   define  buffer buf-bar-code              for ub.bar-code.
     5092   define  buffer buf-goods                 for ub.goods.
     5093   define  buffer buf-gds-prt               for ub.gds-prt.
     5094   define  buffer buf-gds-grp               for ub.gds-grp.
     5095   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     5096   calc-sub:
     5097   do on error undo calc-sub, return error:
     5098     find  buf-price-doc-forming no-lock where
     5099           recid (buf-price-doc-forming) =  p-recid .
     5100     find  buf-bar-code no-lock where
     5101           buf-bar-code.b-code = bc.
     5102     find  buf-goods no-lock where
     5103           buf-goods.gds-code = buf-bar-code.gds-code.
     5104     find  buf-gds-prt no-lock where
     5105           buf-gds-prt.node-code = buf-bar-code.node-code.
     5106     find  buf-price-doc-forming-gds where
     5107           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5108           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5109           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5110           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5111           buf-price-doc-forming-gds.b-code      = bc no-error .
     5112     calc-rec = recid (buf-price-doc-forming-gds).
     5113     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     5114       for each  buf-price-doc-forming-gds exclusive-lock where
     5115                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5116                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5117                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5118                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5119                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5120                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5121                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5122           first buf-bar-code no-lock where
     5123                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     5124                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     5125           first buf-gds-prt no-lock where
     5126                 buf-gds-prt.node-code = buf-bar-code.node-code and
     5127                 buf-gds-prt.upper-code <> buf-goods.prt-root
     5128           on error undo calc-sub, return error:
     5129             run calc-price-line  in this-procedure
     5130               ( input  calc-method
     5131               , input  increase-pc
     5132               , input  round-method
     5133               , input  round-base
     5134               , input  buf-bar-code.b-code
     5135               , input  buf-goods.gds-code
     5136               , input  buf-goods.artic
     5137               , input  buf-goods.prod-type
     5138               , input  buf-goods.prod-code
     5139               , input  buf-price-doc-forming.base-rate
     5140               , input  buf-price-doc-forming.base-scale
     5141               , input  buf-price-doc-forming.exch-scale
     5142               , input  buf-price-doc-forming.exch-rate
     5143               , input  doc-code
     5144               , input  common-price
     5145               , input  copy-type
     5146               , input  copy-code
     5147               , output buf-price-doc-forming-gds.calc-method
     5148               , output buf-price-doc-forming-gds.price-calc-base
     5149               , output buf-price-doc-forming-gds.price-calc-doc
     5150               , output buf-price-doc-forming-gds.price-calc-rubl
     5151               , output buf-price-doc-forming-gds.price-prev-base
     5152               , output buf-price-doc-forming-gds.price-prev-doc
     5153               , output buf-price-doc-forming-gds.price-prev-rubl
     5154               , output buf-price-doc-forming-gds.price-sale-base
     5155               , output buf-price-doc-forming-gds.price-sale-doc
     5156               , output buf-price-doc-forming-gds.price-sale-rubl
     5157               , output buf-price-doc-forming-gds.road-tax-base
     5158               , output buf-price-doc-forming-gds.road-tax-doc
     5159               , output buf-price-doc-forming-gds.road-tax-rubl
     5160               , output buf-price-doc-forming-gds.excise-base
     5161               , output buf-price-doc-forming-gds.excise-doc
     5162               , output buf-price-doc-forming-gds.excise-rubl
     5163               , output buf-price-doc-forming-gds.vat-pc
     5164               , output buf-price-doc-forming-gds.slt-pc
     5165               , output buf-price-doc-forming-gds.prev-doc-code
     5166               , output buf-price-doc-forming-gds.d-pcnt
     5167               ) no-error .
     5168             if error-status :error then do :
     5169               message
     5170                 vss-workfile vss-revision vss-description skip
     5171                 error-status :get-message(1) skip
     5172                 return-value skip
     5173                 "calc-price-line"
     5174                 view-as alert-box error
     5175               .
     5176               undo calc-sub, return error.
     5177               end.
     5178         calc-rec = recid (buf-price-doc-forming-gds).
     5179       end.
     5180       for each  buf-price-doc-forming-gds exclusive-lock where
     5181                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5182                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5183                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5184                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5185                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5186                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5187                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5188           first buf-bar-code no-lock where
     5189                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     5190                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     5191           first buf-gds-prt no-lock where
     5192                 buf-gds-prt.node-code = buf-bar-code.node-code
     5193           on error undo calc-sub, return error:
     5194       end.
     5195     end.
     5196     else do:
     5197     end.
     5198   end.
     5199   end procedure.
     5200   procedure calc-base-update :
     5201   define input parameter bc           like ub.bar-code.b-code   no-undo.
     5202   define input parameter p-recid      as recid no-undo .
     5203   define input parameter round-method as character    no-undo.
     5204   define input parameter round-base   as decimal      no-undo.
     5205   define buffer alt-bar-code              for ub.bar-code.
     5206   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     5207   define buffer buf-bar-code              for ub.bar-code.
     5208   define buffer buf-goods                 for ub.goods.
     5209   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     5210   calc-base:
     5211   do on error undo calc-base, return error :
     5212     find  buf-price-doc-forming no-lock where
     5213           recid (buf-price-doc-forming) =  p-recid .
     5214     find  buf-bar-code no-lock where
     5215           buf-bar-code.b-code = bc.
     5216     find  buf-goods no-lock where
     5217           buf-goods.gds-code = buf-bar-code.gds-code.
     5218     for each  alt-bar-code no-lock where
     5219               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     5220               alt-bar-code.node-code = buf-bar-code.node-code and
     5221               alt-bar-code.part-code = buf-bar-code.part-code and
     5222               alt-bar-code.in-code   = buf-bar-code.in-code and
     5223               alt-bar-code.unit-cli <> buf-goods.unit-base,
     5224         each  alt-price-doc-forming-gds exclusive-lock where
     5225               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     5226               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     5227               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     5228               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5229               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     5230         on error undo calc-base, return error:
     5231     run calc-price-alt in this-procedure
     5232         ( input  alt-price-doc-forming-gds.b-code
     5233         , input  p-recid
     5234         , input  alt-price-doc-forming-gds.d-pcnt
     5235         , input  round-method
     5236         , input  round-base
     5237         , output alt-price-doc-forming-gds.price-sale-base
     5238         , output alt-price-doc-forming-gds.price-sale-doc
     5239         , output alt-price-doc-forming-gds.price-sale-rubl
     5240         ) no-error .
     5241       if error-status:error then do:
     5242       message
     5243         vss-workfile vss-revision vss-description skip
     5244         error-status :get-message(1) skip
     5245         return-value skip
     5246         "calc-price-alt"
     5247         view-as alert-box error
     5248       .
     5249         undo calc-base, return error.
     5250       end.
     5251     end.
     5252   end.
     5253   end procedure.
     5254   define temp-table temp-exp-partbc no-undo
     5255   field b-code  as integer
     5256   index pi b-code
     5257   .
     5258   procedure expose-prt :
     5259   define input  parameter p-calc-method  as character no-undo .
     5260   define input  parameter p-increase-pc as decimal   no-undo .
     5261   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     5262   define input  parameter old-recid      as recid no-undo .
     5263   define input  parameter new-recid      as recid no-undo .
     5264   define input  parameter p-round-method as character no-undo .
     5265   define input  parameter p-round-base   as decimal   no-undo .
     5266   define input  parameter v-doc-code     as character no-undo .
     5267   define input  parameter v-common-price as decimal   no-undo .
     5268   define input  parameter v-copy-type    as character no-undo .
     5269   define input  parameter v-copy-code    as integer   no-undo .
     5270   define input-output parameter v-line-num as integer   no-undo .
     5271   define input-output parameter v-sec      as integer   no-undo .
     5272   define output parameter new-rec-str      as recid   no-undo.
     5273   define buffer buf-bar-code              for ub.bar-code.
     5274   define buffer buf-goods                 for ub.goods.
     5275   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5276   define buffer buf-price-list            for ub.price-doc-forming-gds.
     5277   define buffer buf-price-doc-forming     for ub.price-doc-forming.
     5278   define buffer new-price-doc-forming     for ub.price-doc-forming.
     5279   define buffer new-price-doc-forming-gds for ub.price-doc-forming-gds  .
     5280   define buffer buf-gds-prt               for ub.gds-prt  .
     5281   define buffer buf_parts for ub.parts  .
     5282   define buffer buf_goods for ub.goods  .
     5283     do
     5284     on error undo, return error return-value
     5285     :
     5286     find  buf-price-doc-forming no-lock where
     5287           recid(buf-price-doc-forming) = old-recid .
     5288     find  new-price-doc-forming no-lock where
     5289           recid(new-price-doc-forming) = new-recid .
     5290     find  buf-bar-code no-lock where
     5291           buf-bar-code.b-code = p-main-code.
     5292     find  buf-goods no-lock where
     5293           buf-goods.gds-code = buf-bar-code.gds-code.
     5294     find  buf-price-doc-forming-gds no-lock  where
     5295           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5296           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5297           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5298           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5299           buf-price-doc-forming-gds.b-code  = p-main-code no-error .
     5300     if error-status :error then return .
     5301     find  buf-gds-prt no-lock where
     5302           buf-gds-prt.node-code = buf-bar-code.node-code.
     5303   if par-pr-altex = "yes" and
     5304      par-pr-notls = "yes" then do:
     5305   for each  buf-price-list where
     5306             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     5307             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     5308             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5309             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5310             buf-price-list.b-code     <> p-main-code and
     5311             buf-price-list.artic       = buf-goods.artic  and
     5312             buf-price-list.prod-type   = buf-goods.prod-type and
     5313             buf-price-list.prod-code   = buf-goods.prod-code
     5314             ,
     5315       first buf-bar-code no-lock where
     5316             buf-bar-code.b-code   = buf-price-list.b-code and
     5317             buf-bar-code.unit-cli <> buf-goods.unit-base:
     5318      run create-calc-bc in this-procedure
     5319          ( input  recid( new-price-doc-forming )
     5320           ,input  p-calc-method
     5321           ,input  p-increase-pc
     5322           ,input  p-round-method
     5323           ,input  p-round-base
     5324           ,input  buf-bar-code.b-code
     5325           ,input  buf-goods.gds-code
     5326           ,input  buf-goods.artic
     5327           ,input  buf-goods.prod-type
     5328           ,input  buf-goods.prod-code
     5329           ,input  new-price-doc-forming.base-rate
     5330           ,input  new-price-doc-forming.base-scale
     5331           ,input  new-price-doc-forming.exch-scale
     5332           ,input  new-price-doc-forming.exch-rate
     5333           ,input  v-doc-code
     5334           ,input  v-common-price
     5335           ,input  v-copy-type
     5336           ,input  v-copy-code
     5337           ,input-output v-line-num
     5338           ,input-output v-sec
     5339         ) no-error .
     5340     if error-status:error then do:
     5341       message
     5342         "Ошибка cre-pr-list."                skip
     5343         "Код:" buf-bar-code.b-code           skip
     5344         error-status :get-message(1)         skip
     5345         return-value                         skip
     5346          "pdf" new-price-doc-forming.pdf-id  skip
     5347         view-as alert-box.
     5348       next.
     5349     end.
     5350   end.
     5351   end.
     5352   if par-pr-sclex = "yes" and
     5353      par-pr-notls = "yes" then do:
     5354   for each  buf-price-list where
     5355             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     5356             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     5357             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5358             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5359             buf-price-list.b-code     <> p-main-code and
     5360             buf-price-list.artic       = buf-goods.artic  and
     5361             buf-price-list.prod-type   = buf-goods.prod-type and
     5362             buf-price-list.prod-code   = buf-goods.prod-code  ,
     5363       first buf-bar-code no-lock where
     5364             buf-bar-code.b-code   = buf-price-list.b-code and
     5365             buf-bar-code.unit-cli = buf-goods.unit-base and
     5366             buf-bar-code.in-code = ""
     5367             :
     5368      run create-calc-bc in this-procedure
     5369          ( input  recid( new-price-doc-forming )
     5370           ,input  p-calc-method
     5371           ,input  p-increase-pc
     5372           ,input  p-round-method
     5373           ,input  p-round-base
     5374           ,input  buf-bar-code.b-code
     5375           ,input  buf-goods.gds-code
     5376           ,input  buf-goods.artic
     5377           ,input  buf-goods.prod-type
     5378           ,input  buf-goods.prod-code
     5379           ,input  new-price-doc-forming.base-rate
     5380           ,input  new-price-doc-forming.base-scale
     5381           ,input  new-price-doc-forming.exch-scale
     5382           ,input  new-price-doc-forming.exch-rate
     5383           ,input v-doc-code
     5384           ,input v-common-price
     5385           ,input v-copy-type
     5386           ,input v-copy-code
     5387           ,input-output v-line-num
     5388           ,input-output v-sec
     5389         ) no-error .
     5390         if error-status:error then do:
     5391           message
     5392             "Ошибка cre-pr-list.2" skip
     5393             "Код:" buf-bar-code.b-code
     5394             view-as alert-box.
     5395           next.
     5396         end.
     5397       end.
     5398   end.
     5399   if par-pr-parex = "yes" and
     5400      par-pr-notls = "yes" then do:
     5401   define buffer bt_trn-doc  for ub.trn-doc  .
     5402   define buffer bf_parts    for ub.parts  .
     5403   define buffer free_parts  for ub.parts  .
     5404   define buffer buf_gds-obj for ub.gds-obj  .
     5405   find first buf_gds-obj no-lock where
     5406              buf_gds-obj.gds-code = buf-goods.gds-code and
     5407              buf_gds-obj.obj-type = v-cntxt-obj-type   and
     5408              buf_gds-obj.obj-code = v-cntxt-obj-code   and
     5409              buf_gds-obj.cash-parts = true
     5410              no-error .
     5411   if not available buf_gds-obj then return .
     5412    find first bt_trn-doc no-lock where
     5413               bt_trn-doc.doc-code = v-doc-code no-error .
     5414    if v-doc-code <> "" and available bt_trn-doc then do:
     5415    for each temp-exp-partbc :
     5416        delete temp-exp-partbc.
     5417    end.
     5418    for each bf_parts no-lock where
     5419             bf_parts.out-code   = bt_trn-doc.doc-code and
     5420             bf_parts.obj-type   = bt_trn-doc.obj-type and
     5421             bf_parts.obj-code   = bt_trn-doc.obj-code and
     5422             bf_parts.artic      = buf-goods.artic     and
     5423             bf_parts.prod-type  = buf-goods.prod-type and
     5424             bf_parts.prod-code  = buf-goods.prod-code  ,
     5425           first free_parts no-lock where
     5426                 free_parts.in-code   = bf_parts.in-code   and
     5427                 free_parts.part-code = bf_parts.part-code and
     5428                 free_parts.out-code  = 'free-zone':U       and
     5429                 free_parts.rsrv-free = true               and
     5430                 free_parts.status_   = false              and
     5431                 free_parts.obj-type  = bf_parts.obj-type  and
     5432                 free_parts.obj-code  = bf_parts.obj-code  and
     5433                 free_parts.artic     = bf_parts.artic     and
     5434                 free_parts.prod-type = bf_parts.prod-type and
     5435                 free_parts.prod-code = bf_parts.prod-code ,
     5436           first buf-bar-code no-lock where
     5437                 buf-bar-code.gds-code  = buf-goods.gds-code and
     5438                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     5439                 buf-bar-code.in-code   = bf_parts.in-code and
     5440                 buf-bar-code.part-code = bf_parts.part-code
     5441                 :
     5442      run create-calc-bc in this-procedure
     5443          ( input  recid( new-price-doc-forming )
     5444           ,input  p-calc-method
     5445           ,input  p-increase-pc
     5446           ,input  p-round-method
     5447           ,input  p-round-base
     5448           ,input  buf-bar-code.b-code
     5449           ,input  buf-goods.gds-code
     5450           ,input  buf-goods.artic
     5451           ,input  buf-goods.prod-type
     5452           ,input  buf-goods.prod-code
     5453           ,input  new-price-doc-forming.base-rate
     5454           ,input  new-price-doc-forming.base-scale
     5455           ,input  new-price-doc-forming.exch-scale
     5456           ,input  new-price-doc-forming.exch-rate
     5457           ,input v-doc-code
     5458           ,input v-common-price
     5459           ,input v-copy-type
     5460           ,input v-copy-code
     5461           ,input-output v-line-num
     5462           ,input-output v-sec
     5463         ) no-error .
     5464         if error-status:error then do:
