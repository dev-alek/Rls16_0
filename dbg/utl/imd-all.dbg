     4292             input  p-artic     ,
     4293             input  p-prod-type ,
     4294             input  p-prod-code ,
     4295             input  0 ,
     4296             input  v-doc-code ,
     4297             input  p-vat-pc      ,
     4298             input  p-slt-pc      ,
