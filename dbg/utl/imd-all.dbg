       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   function is-numeral return logical
       82     (input p-string   as character ,
       83      input char-avail as character) :
       84     define variable p-replace-string as character no-undo .
       85     define variable log-result       as logical  no-undo .
       86     if p-string = ? then
       87       return false .
       88     p-replace-string = p-string.
       89     if lookup ("*", char-avail) > 0 then
       90         p-replace-string = replace (p-replace-string, '*', '9').
       91     if lookup ("digit", char-avail) > 0 then
       92       assign
       93         p-replace-string = replace (p-replace-string, '0', '9')
       94         p-replace-string = replace (p-replace-string, '1', '9')
       95         p-replace-string = replace (p-replace-string, '2', '9')
       96         p-replace-string = replace (p-replace-string, '3', '9')
       97         p-replace-string = replace (p-replace-string, '4', '9')
       98         p-replace-string = replace (p-replace-string, '5', '9')
       99         p-replace-string = replace (p-replace-string, '6', '9')
      100         p-replace-string = replace (p-replace-string, '7', '9')
      101         p-replace-string = replace (p-replace-string, '8', '9')
      102         .
      103     else
      104        p-replace-string = replace (p-replace-string, '9', chr(15))
      105         .
      106     if lookup ("letter", char-avail) > 0 then
      107       assign
      108         p-replace-string = replace (p-replace-string, 'A', '9')
      109         p-replace-string = replace (p-replace-string, 'B', '9')
      110         p-replace-string = replace (p-replace-string, 'C', '9')
      111         p-replace-string = replace (p-replace-string, 'D', '9')
      112         p-replace-string = replace (p-replace-string, 'E', '9')
      113         p-replace-string = replace (p-replace-string, 'F', '9')
      114         p-replace-string = replace (p-replace-string, 'G', '9')
      115         p-replace-string = replace (p-replace-string, 'H', '9')
      116         p-replace-string = replace (p-replace-string, 'I', '9')
      117         p-replace-string = replace (p-replace-string, 'J', '9')
      118         p-replace-string = replace (p-replace-string, 'K', '9')
      119         p-replace-string = replace (p-replace-string, 'L', '9')
      120         p-replace-string = replace (p-replace-string, 'M', '9')
      121         p-replace-string = replace (p-replace-string, 'N', '9')
      122         p-replace-string = replace (p-replace-string, 'O', '9')
      123         p-replace-string = replace (p-replace-string, 'P', '9')
      124         p-replace-string = replace (p-replace-string, 'Q', '9')
      125         p-replace-string = replace (p-replace-string, 'R', '9')
      126         p-replace-string = replace (p-replace-string, 'S', '9')
      127         p-replace-string = replace (p-replace-string, 'T', '9')
      128         p-replace-string = replace (p-replace-string, 'U', '9')
      129         p-replace-string = replace (p-replace-string, 'V', '9')
      130         p-replace-string = replace (p-replace-string, 'W', '9')
      131         p-replace-string = replace (p-replace-string, 'X', '9')
      132         p-replace-string = replace (p-replace-string, 'Y', '9')
      133         p-replace-string = replace (p-replace-string, 'Z', '9')
      134         p-replace-string = replace (p-replace-string, '_', '9')
      135         .
      136     return p-replace-string = fill ('9', length (p-string)).
      137   end.
      138   define new global shared variable g#lib-trn  as handle no-undo .
      139   define new global shared variable g#lib-trn2 as handle no-undo .
