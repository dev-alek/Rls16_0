     9997   find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = doc-line.doc-code and
     9998                                     bf_doc-line-attr.gds-code  = goods.gds-code    and
     9999                                     bf_doc-line-attr.attr-code = 'price-prodvat':U    no-error.
    10000   if not available bf_doc-line-attr and i-price-prod-vat <> 0 then do:
    10001      create bf_doc-line-attr.
    10002      assign
    10003        bf_doc-line-attr.doc-code   = doc-line.doc-code
    10004        bf_doc-line-attr.gds-code   = goods.gds-code
    10005        bf_doc-line-attr.attr-code  = 'price-prodvat':U
