      747     (input  ?
      748     ,input  p-obj-type
      749     ,input  p-obj-code
      750     ,input  yes
      751     ,output p-plt-id
      752     ,output p-plt-db-num
      753     )  .
      754      create ub.price-doc-forming.
      755      assign
      756         ub.price-doc-forming.plt-id       = p-plt-id
      757         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      758         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      759         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      760         ub.price-doc-forming.base-rate    = v-base-rate
      761         ub.price-doc-forming.base-scale   = v-base-scale
      762         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      763         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
      764         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
      765         ub.price-doc-forming.stts         = 0
      766         ub.price-doc-forming.sys-date     = today
      767         ub.price-doc-forming.sys-time     = time
      768         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
      769         ub.price-doc-forming.who          = v-cntxt-userid
      770         ub.price-doc-forming.name         = "автосоздание"
      771      .
