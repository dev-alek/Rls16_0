     9835                         ,input if i-cst-code eq "1" then 'GTIN':U else (if lookup ('вес':U, goods-units.type) > 0 then 'sclc':U else '')
     9836                         ,input ""
     9837                         ,buffer goods
     9838                         ,input bar-code.b-code
     9839                         ,input i-cst-code eq "2"
     9840                         ,input-output i-prod-bc
     9841                         ,output rid
     9842                         ) no-error.
     9843         if error-status :error
     9844         then do:
     9845             if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Ошибка при импорте доп. БК для товара: арт. : " goods.artic ", пр-ль : " goods.prod-code chr(10)
     9846                        error-status:get-message(1) chr(10) return-value  chr(10).
     9847             return.
     9848         end.
     9849         else if rid = ? then do:
     9850             if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Невозможно импортировать доп. БК для товара: арт. : " goods.artic ", пр-ль : " goods.prod-code chr(10)
     9851                        error-status:get-message(1) chr(10) return-value  chr(10).
     9852             return.
     9853         end.
     9854         else do :
     9855             find first  prod-bc where recid(prod-bc) eq rid
     9856             exclusive-lock no-error.
     9857             if available prod-bc
     9858             then do:
     9859                prod-bc.bc-on = i-bc-on.
     9860             end.
     9861         end.
     9862       end.
     9863   end.
     9864   assign
     9865     counter = counter + 1.
     9866   end.
     9867   end procedure.
     9868   procedure imp-input-way-bill:
