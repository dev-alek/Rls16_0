     4165             no-error .
     4166             if not v-base then do:
     4167               run str/pr-wbil.p
     4168               ( input ""            ,
     4169                 input 'Накладная':U ,
     4170                 input v1               ,
     4171                 input v2               ,
     4172                 input v3               ,
     4173                 input v-doc-code       ,
     4174                 input ""               ,
     4175                 input p-gds-code       ,
     4176                 input p-artic          ,
     4177                 input p-prod-type      ,
     4178                 input p-prod-code      ,
     4179                 input v4               ,
     4180                 input 0                ,
     4181                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4182                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4183                 output cost-rubl       ,
     4184                 output v4
     4185                 ) no-error .
     4186             end.
     4187             else do:
     4188               run str/pr-wbil.p
     4189               ( input ""            ,
     4190                 input 'Накладная':U ,
     4191                 input v1               ,
     4192                 input v2               ,
     4193                 input v3               ,
     4194                 input v-doc-code       ,
     4195                 input ""               ,
     4196                 input p-gds-code       ,
     4197                 input p-artic          ,
     4198                 input p-prod-type      ,
     4199                 input p-prod-code      ,
     4200                 input v4               ,
     4201                 input 0                ,
     4202                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4203                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4204                 output cost-base       ,
     4205                 output v4
     4206                 ) no-error .
     4207             end.
     4208             if not error-status :error then
     4209                 assign
     4210                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     4211                .
     4212       end.
     4213       when 'Переоценка':U then do:
     4214         find prev-list where
     4215              prev-list.b-code     = p-b-code and
     4216              prev-list.price-type = "" and
     4217              prev-list.doc-num    = v-doc-code no-lock no-error.
     4218         if available prev-list then
     4219           assign
     4220             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     4221             cur-rt-base = prev-list.road-tax
     4222             cur-rt-rubl = prev-list.road-tax
     4223             cost-rubl = prev-list.price-sale
     4224             cost-base = prev-list.price-sale
     4225             .
     4226         else
     4227           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     4228                   "- расчет невозможен."
     4229                   view-as alert-box information .
     4230       end.
     4231       when 'ДокФормЦены':U then do:
     4232       find first b_price-doc-forming no-lock where
     4233                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     4234                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     4235                  no-error .
     4236         find b_price-doc-forming-gds no-lock where
     4237              b_price-doc-forming-gds.b-code     = p-b-code and
     4238              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     4239              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     4240              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     4241              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     4242              no-error.
     4243         if available b_price-doc-forming-gds then
     4244           assign
     4245             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     4246             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     4247             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     4248             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     4249             cost-base   = b_price-doc-forming-gds.price-sale-base
     4250             .
     4251         else
     4252           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     4253                   "для товара :" skip
     4254                    "Бар-код" p-b-code     skip
     4255                    "Артикул" p-artic      skip
     4256                     p-prod-type  skip
     4257                     p-prod-code  skip
     4258                   "- расчет невозможен."
     4259                   view-as alert-box information .
     4260       end.
     4261       when 'Единая':U then do:
     4262           assign
     4263             p-new-calc-method = 'Единая':U + " " + string(common-price)
     4264             cost-rubl = common-price
     4265             cost-base = common-price
     4266             .
     4267       end.
     4268       when 'Объект':U then do:
     4269       find first buf_gds-obj no-lock where
     4270                  buf_gds-obj.gds-code = p-gds-code and
     4271                  buf_gds-obj.obj-type = v-copy-type and
     4272                  buf_gds-obj.obj-code = v-copy-code no-error .
     4273           if available buf_gds-obj then do:
     4274           assign
     4275             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     4276             cost-rubl = buf_gds-obj.price-sale
     4277             cost-base = buf_gds-obj.price-sale
     4278             .
     4279           end.
     4280           else do:
     4281               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     4282                       "для товара :" p-artic  "- расчет невозможен."
     4283                       view-as alert-box information .
     4284           end.
     4285       end.
     4286      when 'Отсутствует':U or
     4287      when "" then do:
     4288         run str/mplnovat.p
     4289           ( input  'Отсутствует':U    ,
     4290             input  table x_obj-group ,
