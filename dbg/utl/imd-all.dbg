     2616            assign
     2617                 ub.contract-specif-attr.contract-num = p-contract-num
     2618                 ub.contract-specif-attr.host-code    = p-host-code
     2619                 ub.contract-specif-attr.gds-code     = p-gds-code
     2620                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2621                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2622            .
     2623         end.
     2624         else do:
     2625            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2626         end.
     2627       find first ub.contract-specif exclusive-lock where
     2628           ub.contract-specif.contract-num = p-contract-num and
     2629           ub.contract-specif.host-code    = p-host-code    and
     2630           ub.contract-specif.gds-code     = p-gds-code.
     2631           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2632   end.
