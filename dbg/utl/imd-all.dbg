    10117        no-lock no-error.
    10118        if not available bf_bar-code then do:
    10119             if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted SUBSTITUTE("Отсутствует БК для товара с bar-code: &1 &2 &3",
    10120                       return-value,
