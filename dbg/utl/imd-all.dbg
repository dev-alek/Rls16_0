    10007      .
    10008   end.
    10009   else do:
    10010     if  available bf_doc-line-attr and i-price-prod-vat <> 0 then do:
    10011       assign
    10012         bf_doc-line-attr.attr-value = string(i-price-prod-vat)
    10013       .
    10014      end.
    10015   end.
    10016   if string-type = "SCALE" OR
    10017      string-type = "CODE"  then do:
    10018     n-c = ub.gds-prt.node-code.
    10019   end.
    10020   if string-type = "ITEM" then do:
    10021     find first ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root
    10022          use-index level no-lock no-error.
    10023     do while true:
    10024       n-c = ub.gds-prt.node-code.
    10025       find first ub.gds-prt where ub.gds-prt.upper-code = n-c
    10026            use-index level no-lock no-error.
    10027       if not available ub.gds-prt then
    10028         leave.
    10029     end.
    10030   end.
    10031   find ub.gds-dtl where
    10032        ub.gds-dtl.doc-code  = ub.trn-doc.doc-code and
    10033        ub.gds-dtl.artic     = ub.goods.artic and
    10034        ub.gds-dtl.prod-code = ub.goods.prod-code and
    10035        ub.gds-dtl.prod-type = ub.goods.prod-type and
    10036        ub.gds-dtl.prt-code  = n-c no-error.
    10037   if not available ub.gds-dtl then do:
    10038     assign counter = counter + 1.
    10039     create ub.gds-dtl .
    10040     assign
    10041       ub.gds-dtl.obj-type      = ub.trn-doc.obj-type
    10042       ub.gds-dtl.obj-code      = ub.trn-doc.obj-code
    10043       ub.gds-dtl.doc-code      = ub.trn-doc.doc-code
    10044       ub.gds-dtl.artic         = ub.goods.artic
    10045       ub.gds-dtl.prod-code     = ub.goods.prod-code
    10046       ub.gds-dtl.prod-type     = ub.goods.prod-type
    10047       ub.gds-dtl.prt-code      = n-c
    10048     .
    10049   end.
    10050   assign
    10051     ub.doc-line.obj-type      = v-obj-type
    10052     ub.doc-line.obj-code      = v-obj-code
    10053     ub.doc-line.doc-qnty      = ub.doc-line.doc-qnty + (i-qnty * i-cli-base-rate)
    10054     ub.doc-line.fact-qnty     = ub.doc-line.doc-qnty
    10055     ub.doc-line.cli-base-rate = ub.doc-line.doc-qnty / ub.doc-line.cli-qnty
    10056     ub.gds-dtl.doc-qnty       = ub.gds-dtl.doc-qnty + (i-qnty * i-cli-base-rate)
    10057     ub.gds-dtl.fact-qnty      = ub.gds-dtl.doc-qnty
    10058     count-upd              = count-upd + 1
    10059     .
    10060   if string-type = "PART" then do:
    10061     create ub.parts .
    10062     buffer-copy   ub.doc-line  EXCEPT status_ to ub.parts
    10063     assign
    10064       ub.parts.out-code  = ub.doc-line.doc-code
    10065       ub.parts.part-code = i-part-code
    10066       ub.parts.cst-code  = i-cst-code
    10067       ub.parts.last-date = i-last-date
    10068       ub.parts.cli-qnty  = i-qnty
    10069       ub.parts.qnty      = i-qnty * ub.doc-line.cli-base-rate
    10070       ub.parts.fact-qnty = ub.parts.qnty
    10071       ub.parts.dop       = substitute("&1;&2" ,i-price-prod,i-price-prod-vat )
    10072     .
    10073   end.
    10074   for each ub.gds-dtl exclusive-lock where
    10075           ub.gds-dtl.doc-code  = ub.trn-doc.doc-code and
    10076           ub.gds-dtl.obj-type  = ub.trn-doc.obj-type and
    10077           ub.gds-dtl.obj-code  = ub.trn-doc.obj-code and
    10078           ub.gds-dtl.doc-code  = ub.trn-doc.doc-code and
    10079           ub.gds-dtl.artic     = ub.goods.artic      and
    10080           ub.gds-dtl.prod-code = ub.goods.prod-code  and
    10081           ub.gds-dtl.prod-type = ub.goods.prod-type
    10082           :
    10083     find first ub.gds-prt no-lock  where ub.gds-prt.node-code = ub.gds-dtl.prt-code no-error .
    10084     if not available ub.gds-prt then do:
    10085       delete ub.gds-dtl .
    10086     end.
    10087   end.
    10088   end procedure.
    10089   procedure imp-overvalue:
    10090   define variable v-price like ub.price-list.price-sale no-undo.
    10091   define variable v-bar-code as integer no-undo.
    10092   define variable  main-b-code  as integer   no-undo .
