     1370   procedure grp-obj-notcorr-value :
     1371   do
     1372   on error undo, return error
     1373   :
     1374   define input parameter p-node-code             as integer      no-undo.
     1375   define input parameter p-obj-type              as character    no-undo.
     1376   define input parameter p-obj-code              as integer      no-undo.
     1377   define output parameter p-notcorr              as character    no-undo init ?.
     1378   define output parameter p-range-notcorr     as integer      no-undo.
     1379   define output parameter p-exists-notcorr    as logical      no-undo.
     1380   define variable v-host-code as integer      no-undo.
     1381   DEFINE VARIABLE v-found as logical no-undo .
     1382   DEFINE VARIABLE v-exists as logical no-undo .
     1383   DEFINE VARIABLE v-range as integer no-undo .
     1384   DEFINE VARIABLE jj as integer no-undo .
     1385   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1386   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1387   define buffer buf_gds-grp for ub.gds-grp.
     1388   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1389   find first buf_gds-grp no-lock where
     1390              buf_gds-grp.node-code = p-node-code no-error .
     1391   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1392     message
     1393       vss-workfile vss-revision vss-description
     1394       skip "Не удалось найти группу товаров с кодом" p-node-code
     1395       view-as alert-box error .
     1396     undo, return error .
     1397   end.
     1398   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1400     (input  p-obj-type
     1401     ,input  p-obj-code
     1402     ,output v-host-code
     1403     ) no-error .
     1404   if error-status :error
     1405   then do:
     1406       message
     1407         vss-workfile vss-revision vss-description
     1408         skip "Не удалось найти фирму объекта"
     1409         skip p-obj-type p-obj-code
     1410         skip return-value
     1411         skip trim(error-status :get-message(1))
     1412       view-as alert-box error.
     1413       undo, return error .
     1414   end.
     1415   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1416   do while v-found = no and jj < 2:
     1417     if v-range <> 3 then do:
     1418       find first buf_gds-grp-obj no-lock
     1419           where buf_gds-grp-obj.node-code = p-node-code
     1420             and buf_gds-grp-obj.host-code = v-host-code
     1421             and buf_gds-grp-obj.obj-type  = p-obj-type
     1422             and buf_gds-grp-obj.obj-code  = p-obj-code
     1423       no-error .
     1424     end.
     1425     if v-range = 3 or not available buf_gds-grp-obj
     1426     then do:
     1427        if v-range <> 2 then do:
     1428           find first buf_gds-grp-obj no-lock
     1429               where buf_gds-grp-obj.node-code = p-node-code
     1430                 and buf_gds-grp-obj.host-code = v-host-code
     1431                 and buf_gds-grp-obj.obj-type  = ""
     1432                 and buf_gds-grp-obj.obj-code  = 0
     1433           no-error .
     1434         end.
     1435         if v-range = 2 or not available buf_gds-grp-obj
     1436         then do:
     1437             if v-range <> 1 then do:
     1438               find first buf_gds-grp-obj no-lock
     1439                   where buf_gds-grp-obj.node-code = p-node-code
     1440                   and buf_gds-grp-obj.host-code = 0
     1441                   and buf_gds-grp-obj.obj-type  = ""
     1442                   and buf_gds-grp-obj.obj-code  = 0
     1443               no-error .
     1444             end.
     1445             if v-range = 1 or not available buf_gds-grp-obj
     1446             then do:
     1447                 assign
     1448                     v-exists = no
     1449                 .
     1450             end.
     1451             else do:
     1452                 assign
     1453                     v-exists = yes
     1454                     v-range = 1
     1455                 .
     1456             end.
     1457         end.
     1458         else do:
     1459             assign
     1460                 v-exists = yes
     1461                 v-range  = 2
     1462             .
     1463         end.
     1464     end.
     1465     else do:
     1466         assign
     1467             v-exists = yes
     1468             v-range  = 3
     1469         .
     1470     end.
     1471     if available buf_gds-grp-obj
     1472     then do:
     1473       find first buf_gds-grp-obj-attr no-lock
     1474         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1475           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1476           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1477           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1478           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1479         no-error .
     1480       if available buf_gds-grp-obj-attr then do:
     1481         assign
     1482           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1483         .
     1484       end.
     1485       else do:
     1486         assign
     1487           v-notcorr-value = ?
     1488         .
     1489       end.
     1490       assign
     1491       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1492                           then yes
     1493                           else p-exists-notcorr)
     1494       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1495                         then v-range
     1496                         else p-range-notcorr
     1497       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1498                         then v-notcorr-value
     1499                         else p-notcorr
     1500       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1501       jj = jj + 1
     1502       .
     1503     end.
     1504     else do:
     1505       assign
     1506       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1507       jj = jj + 1
     1508       .
     1509     end.
     1510   end.
     1511   end.
     1512   end procedure.
     1513   define variable vss-include-info24 as character format "X(65)" no-undo
     1514   initial "@(#)$Workfile$ $Revision$".
     1515   procedure grplib-get-full-name :
     1516      define input parameter p-node-code  as integer      no-undo.
     1517      define output parameter p-full-name as character    no-undo.
     1518      do
     1519   on error undo, return error
     1520   :
     1521       define variable v-upper-code    as integer           no-undo.
     1522       define buffer buf_gds-grp       for ub.gds-grp.
     1523       define buffer buf_upper_gds-grp for ub.gds-grp.
     1524       find first buf_gds-grp no-lock
     1525            where buf_gds-grp.node-code = p-node-code
     1526       no-error.
     1527       if not available buf_gds-grp
     1528       then do:
     1529           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1530       end.
     1531       assign
     1532           p-full-name  = ""
     1533           v-upper-code = 1
     1534       .
     1535       do while buf_gds-grp.upper-code <> 0
     1536       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1537       :
     1538           assign
     1539               p-full-name  = buf_gds-grp.node-name
     1540                            + (if p-full-name <> "" then chr(47) else "")
     1541                            + p-full-name
     1542               v-upper-code = buf_gds-grp.upper-code
     1543           .
     1544           find first buf_gds-grp no-lock
     1545                where buf_gds-grp.node-code = v-upper-code
     1546           no-error.
     1547           if not available buf_gds-grp
     1548           then do:
     1549               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1550                                   + string( v-upper-code )
     1551                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1552           end.
     1553       end.
     1554       assign
     1555       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1556       .
     1557   end.
     1558   end .
     1559   procedure grplib-get-node-from-full-name :
     1560   define input parameter p-full-name as character no-undo .
     1561   define output parameter p-node-code as integer no-undo .
     1562   define variable v-ii as integer no-undo .
     1563   define variable v-upper-code as integer no-undo .
     1564   define variable v-root-code as integer no-undo .
     1565   define variable v-entry as character no-undo .
     1566   define buffer buf_gds-grp       for ub.gds-grp.
     1567   do
     1568   on error undo, return error
     1569   :
     1570     find first buf_gds-grp no-lock
     1571         where buf_gds-grp.upper-code = 0
     1572     no-error .
     1573     if not available buf_gds-grp
     1574     then do:
     1575         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1576     end.
     1577     else do:
     1578       assign
     1579       v-root-code = buf_gds-grp.node-code
     1580       .
     1581     end.
     1582     v-upper-code = v-root-code.
     1583     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1584       assign
     1585       v-entry = entry(v-ii, p-full-name, chr(47)).
     1586       if v-entry = '' then leave.
     1587       find first buf_gds-grp no-lock where
     1588                 buf_gds-grp.node-name = v-entry
     1589             and buf_gds-grp.upper-code = v-upper-code
     1590             no-error.
     1591       if not available buf_gds-grp then do:
     1592         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1593       end.
     1594       else do:
     1595         p-node-code = buf_gds-grp.node-code.
     1596         v-upper-code = buf_gds-grp.node-code.
     1597       end.
     1598     end.
     1599   end.
     1600   end .
     1601   procedure  chec-par :
     1602   define output parameter l-par as logical no-undo .
     1603   define input parameter l-host like ub.clients.obj-code no-undo .
     1604   define input parameter l-type like ub.clients.obj-type no-undo .
     1605   define input parameter l-code like ub.clients.obj-code no-undo .
     1606   define variable par-type          as character no-undo.
     1607   define variable v-value-character as character no-undo .
     1608   define variable v-value-date      as date      no-undo .
     1609   define variable v-value-decimal   as decimal   no-undo .
     1610   define variable v-value-integer   as integer   no-undo .
     1611   define variable v-value-logical   as logical   no-undo .
     1612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1613     (input  'alcohol'
     1614     ,input  l-host
     1615     ,input  l-type
     1616     ,input  l-code
     1617     ,input  ''
     1618     ,input  ''
     1619     ,input  ''
     1620     ,input  no
     1621     ,output par-alcohol
     1622     ,output par-type
     1623     ) no-error .
     1624    .
     1625   empty temp-table thbjattr_thbj-attr.
     1626   run adm/shattri.p (
     1627      input "get":U
     1628     ,input l-type
     1629     ,input l-code
     1630     ,input 'overval':U
     1631     ,input  ""
     1632     ,output v-value-character
     1633     ,output v-value-date
     1634     ,output v-value-decimal
     1635     ,output v-value-integer
     1636     ,output v-value-logical
     1637     ,output par-type
     1638     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1639     ) no-error .
     1640   for each thbjattr_thbj-attr :
     1641       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1642       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1643       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1644       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     1645       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     1646       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     1647       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     1648       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     1649       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     1650       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     1651       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     1652       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1653       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1654       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     1655       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1656       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     1657       if v-cntxt-db-num = 0 then do:
     1658         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1659         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1660       end.
     1661       else do:
     1662         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1663         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1664       end.
     1665   end.
     1666   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1667   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     1668     (input  ?
     1669     ,input  l-type
     1670     ,input  l-code
     1671     ,output par-gen-mrgn-ie
     1672     ,output par-gen-mrgn-iv
     1673     ,output par-gen-mrgn-im
     1674     ) no-error .
     1675      IF error-status :error THEN message
     1676        vss-workfile vss-revision vss-description skip
     1677        error-status :get-message(1) skip
     1678        return-value skip
     1679        "gbl/gtplmrgn.i"
     1680        view-as alert-box error
     1681      .
     1682   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     1684     (input  ?
     1685     ,input  l-type
     1686     ,input  l-code
     1687     ,output par-pr-nakl-ie
     1688     ,output par-pr-nakl-iv
     1689     ,output par-pr-nakl-im
     1690     ) no-error .
     1691      define variable ii as integer   no-undo .
     1692      define variable nn as integer   no-undo .
     1693      define variable v-fullname as character no-undo .
     1694      nn = num-entries ( par-pr-nogds ).
     1695      par-pr-nogds-long = "".
     1696      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     1697         repeat ii = 1 to nn :
     1698           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     1699           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     1700         end.
     1701         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     1702      end.
     1703   l-par = true .
     1704   end procedure.
     1705   PROCEDURE cre-pr-list:
     1706   define input  parameter bc      like ub.price-list.b-code no-undo.
     1707   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     1708   define output parameter new-rec as recid             no-undo.
     1709   define buffer buf-price-list for ub.price-list.
     1710   define buffer buf-price-doc  for ub.price-doc.
     1711   define buffer buf-bar-code   for ub.bar-code.
     1712   define buffer buf-goods      for ub.goods.
     1713   define buffer buf-gds-prt    for ub.gds-prt.
     1714   define buffer root-gds-prt   for ub.gds-prt.
     1715   define variable cur-pr like ub.price-list.price-sale no-undo.
     1716   define variable cur-rt like ub.price-list.road-tax   no-undo.
     1717   define variable cur-ex like ub.price-list.excise     no-undo.
     1718   define variable cur-dn like ub.price-list.doc-num    no-undo.
     1719   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1720   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1721   define variable cur-rt-base as decimal no-undo .
     1722   define variable cur-rt-rubl as decimal no-undo .
     1723   define variable p-hostcode as int no-undo .
     1724   define variable v-line-num as integer no-undo .
     1725   define variable v-skip-del-gds as logical no-undo initial no .
     1726   cre-pr:
     1727   do on error undo cre-pr, return error:
     1728     find  buf-bar-code no-lock where
     1729           buf-bar-code.b-code = bc.
     1730     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     1731     if error-status :error then do:
     1732       message
     1733         return-value skip
     1734         "Ошибка !"
     1735         view-as alert-box error
     1736       .
     1737       undo cre-pr, return.
     1738     end.
     1739     find  buf-goods no-lock where
     1740           buf-goods.gds-code = buf-bar-code.gds-code.
     1741     find first root-gds-prt no-lock where
     1742               root-gds-prt.upper-code = buf-goods.prt-root.
     1743     if root-gds-prt.node-name <> '_Пустая шкала':U and
     1744       buf-bar-code.in-code <> "" then do:
     1745       message
     1746         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1747         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1748         view-as alert-box error.
     1749       undo cre-pr, return.
     1750     end.
     1751     find  buf-gds-prt no-lock where
     1752           buf-gds-prt.node-code = buf-bar-code.node-code.
     1753     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     1754       message
     1755         "Не допускается создавать цены на удаленные товары!" skip (2)
     1756         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1757         view-as alert-box error.
     1758       undo cre-pr, return.
     1759     end.
     1760     find  buf-price-doc where
     1761           buf-price-doc.doc-num = new-num.
     1762   define variable v-ret as logical no-undo .
     1763      run ver-modificator-price-is-null (
     1764             input    buf-goods.artic        ,
     1765             input    buf-goods.prod-type    ,
     1766             input    buf-goods.prod-code    ,
     1767             input    buf-price-doc.obj-type   ,
     1768             input    buf-price-doc.obj-code   ,
     1769             output   v-ret ).
     1770         if v-ret = false then dO:
     1771             message
     1772               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     1773               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1774               view-as alert-box error.
     1775             undo cre-pr, return.
     1776           end.
     1777   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1779     (input  buf-price-doc.obj-type
     1780     ,input  buf-price-doc.obj-code
     1781     ,output p-hostcode
     1782     ) no-error .
     1783   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1784   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1785     (input  buf-goods.gds-code
     1786     ,input  '1':U
     1787     ,input  ?
     1788     ,input  p-hostcode
     1789     ,input  buf-price-doc.obj-type
     1790     ,input  buf-price-doc.obj-code
     1791     ,output local_vat-pc
     1792     ) no-error .
     1793   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1794   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1795     (input  buf-goods.gds-code
     1796     ,input  '2':U
     1797     ,input  ?
     1798     ,input  p-hostcode
     1799     ,input  buf-price-doc.obj-type
     1800     ,input  buf-price-doc.obj-code
     1801     ,output local_slt-pc
     1802     ) no-error .
     1803   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1804   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1805     (input  buf-price-doc.obj-type
     1806     ,input  buf-price-doc.obj-code
     1807     ,input  bc
     1808     ,input  0
     1809     ,input  0
     1810     ,output cur-dn
     1811     ,output cur-pr
     1812     ,output cur-rt
     1813     ,output cur-ex
     1814     ) no-error .
     1815     find first buf-price-list where
     1816               buf-price-list.b-code  = buf-bar-code.b-code and
     1817               buf-price-list.doc-num = new-num  and
     1818               buf-price-list.price-type = ""    no-error .
     1819     if not available buf-price-list then do:
     1820       run calc-price-line-num (input  new-num , output v-line-num) .
     1821       create buf-price-list.
     1822       assign
     1823         buf-price-list.line-num  = v-line-num
     1824         buf-price-list.b-code    = buf-bar-code.b-code
     1825         buf-price-list.doc-num   = buf-price-doc.doc-num
     1826         buf-price-list.prod-type = buf-goods.prod-type
     1827         buf-price-list.prod-code = buf-goods.prod-code
     1828         buf-price-list.artic     = buf-goods.artic
     1829         buf-price-list.obj-type  = buf-price-doc.obj-type
     1830         buf-price-list.obj-code  = buf-price-doc.obj-code
     1831         buf-price-list.vat-pc    = local_vat-pc
     1832         buf-price-list.slt-pc    = local_slt-pc
     1833         buf-price-list.price-prev = cur-pr
     1834         .
     1835       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     1836           buf-bar-code.in-code   = "" and
     1837           buf-bar-code.part-code = "" and
     1838           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     1839         buf-price-list.main-price = yes.
     1840         if cur-pr <> ? then do:
     1841           run exp-prt (input buf-goods.gds-code,
     1842                       input cur-dn,
     1843                       input new-num,
     1844                       output new-rec) no-error.
     1845           if error-status :error then do:
     1846             message
     1847               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     1848               view-as alert-box error.
     1849             undo cre-pr, return error.
     1850           end.
     1851         end.
     1852       end.
     1853       else do:
     1854         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1855           buf-price-list.d-pcnt = ?.
     1856         end.
     1857         buf-price-list.main-price = no.
     1858       end.
     1859     end.
     1860   end.
     1861   new-rec = recid (buf-price-list).
     1862   END PROCEDURE.
     1863   procedure calc-price-line-num :
     1864    do
     1865    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1866    :
     1867   define input parameter p-doc-num as character no-undo .
     1868   define output parameter p-num  as integer no-undo .
     1869   define variable v-fact as integer no-undo .
     1870   define buffer buf_1_price-list for ub.price-list .
     1871   p-num = 1 .
     1872   find last  buf_1_price-list no-lock where
     1873              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     1874              if available buf_1_price-list then
     1875                   assign
     1876                     v-fact = buf_1_price-list.line-num
     1877                   .
     1878   v-fact = v-fact + 1.
     1879   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     1880    end.
     1881   end procedure.
     1882   PROCEDURE del-pr-list:
     1883   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1884   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1885   define input parameter round-method as character         no-undo.
     1886   define input parameter round-base   as decimal      no-undo.
     1887   define buffer buf-price-list for ub.price-list.
     1888   define buffer buf-bar-code   for ub.bar-code.
     1889   define buffer buf-goods      for ub.goods.
     1890   define variable l-ov-on as logical no-undo .
     1891   del-pr:
     1892   do on error undo del-pr, return error:
     1893     find first  buf-price-list no-lock where
     1894                 buf-price-list.doc-num    = d-num and
     1895                 buf-price-list.b-code     = bc and
     1896                 buf-price-list.price-type = "" no-error.
     1897     if not available buf-price-list then
     1898       undo del-pr, return error.
     1899     find  buf-goods no-lock where
     1900           buf-goods.prod-type = buf-price-list.prod-type and
     1901           buf-goods.prod-code = buf-price-list.prod-code and
     1902           buf-goods.artic     = buf-price-list.artic.
     1903     if buf-price-list.main-price then do:
     1904       for each  buf-price-list exclusive-lock where
     1905                 buf-price-list.doc-num   = d-num and
     1906                 buf-price-list.artic     = buf-goods.artic and
     1907                 buf-price-list.prod-type = buf-goods.prod-type and
     1908                 buf-price-list.prod-code = buf-goods.prod-code,
     1909           first buf-bar-code no-lock where
     1910                 buf-bar-code.b-code = buf-price-list.b-code
     1911       on error undo del-pr, return error:
     1912   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1914     (input  ub.buf-price-list.obj-type
     1915     ,input  ub.buf-price-list.obj-code
     1916     ,input  ub.buf-price-list.artic
     1917     ,input  ub.buf-price-list.prod-type
     1918     ,input  ub.buf-price-list.prod-code
     1919     ,input  'ov-on=request:exclusive'
     1920     ,output l-ov-on
     1921     ) no-error .
     1922         if error-status:error then do:
     1923           message
     1924             vss-workfile vss-revision vss-description skip
     1925             "Ошибка получения признака товара на объекте" skip
     1926             error-status :get-message(1) skip
     1927             return-value skip
     1928             view-as alert-box error .
     1929         end.
     1930         if l-ov-on then do:
     1931   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1933     (input  ub.buf-price-list.obj-type
     1934     ,input  ub.buf-price-list.obj-code
     1935     ,input  ub.buf-price-list.artic
     1936     ,input  ub.buf-price-list.prod-type
     1937     ,input  ub.buf-price-list.prod-code
     1938     ,input  'ov-on=false'
     1939     ,output l-ov-on
     1940     ) no-error .
     1941           if error-status :error then do:
     1942           end.
     1943          end.
     1944         delete buf-price-list.
     1945       end.
     1946     end.
     1947     else do:
     1948       find  buf-bar-code no-lock where
     1949             buf-bar-code.b-code = buf-price-list.b-code.
     1950       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1951         message
     1952           "Нельзя удалить неосновную цену." skip
     1953           "Неосновная цена (скидка) не может быть неопределенной." skip
     1954           "Код:" bc skip
     1955           "Переоценка:" d-num
     1956           view-as alert-box error.
     1957         undo del-pr, return error.
     1958       end.
     1959       find current buf-price-list exclusive-lock no-error .
     1960       delete buf-price-list.
     1961       run calc-base-upd (input buf-bar-code.b-code,
     1962                         input d-num,
     1963                         input round-method,
     1964                         input round-base) no-error.
     1965       if error-status :error then
     1966         undo del-pr, return error.
     1967     end.
     1968   end.
     1969   END PROCEDURE.
     1970   PROCEDURE calc-base-upd:
     1971   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1972   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1973   define input parameter round-method as character         no-undo.
     1974   define input parameter round-base   as decimal      no-undo.
     1975   define buffer alt-bar-code   for ub.bar-code.
     1976   define buffer alt-price-list for ub.price-list.
     1977   define buffer buf-bar-code   for ub.bar-code.
     1978   define buffer buf-goods      for ub.goods.
     1979   calc-base:
     1980   do on error undo calc-base, return error:
     1981     find  buf-bar-code no-lock where
     1982           buf-bar-code.b-code = bc.
     1983     find  buf-goods no-lock where
     1984           buf-goods.gds-code = buf-bar-code.gds-code.
     1985     for each  alt-bar-code no-lock where
     1986               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     1987               alt-bar-code.node-code = buf-bar-code.node-code and
     1988               alt-bar-code.part-code = buf-bar-code.part-code and
     1989               alt-bar-code.in-code   = buf-bar-code.in-code and
     1990               alt-bar-code.unit-cli <> buf-goods.unit-base,
     1991         each  alt-price-list where
     1992               alt-price-list.doc-num    = d-num and
     1993               alt-price-list.b-code     = alt-bar-code.b-code and
     1994               alt-price-list.price-type = ""
     1995         on error undo calc-base, return error:
     1996       run calc-pr-alt (input d-num,
     1997                       input alt-bar-code.b-code,
     1998                       input round-method,
     1999                       input round-base) no-error.
     2000       if error-status:error then
     2001         undo calc-base, return error.
     2002     end.
     2003   end.
     2004   END PROCEDURE.
     2005   PROCEDURE calc-pr-alt:
     2006   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2007   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2008   define input parameter r-method as character             no-undo.
     2009   define input parameter r-base   as decimal              no-undo.
     2010   define buffer buf-price-doc  for ub.price-doc.
     2011   define buffer buf-price-list for ub.price-list.
     2012   define buffer buf-bar-code   for ub.bar-code.
     2013   define buffer buf-goods      for ub.goods.
     2014   define buffer old-price-list for ub.price-list.
     2015   define variable pr-rec   as   recid                  no-undo.
     2016   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2017   pr-alt:
     2018   do on error undo pr-alt, return error:
     2019     if r-method = ? or
     2020        r-base = ? then do:
     2021       message
     2022         "Нельзя удалить основную цену." skip
     2023         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2024         "Код:" bc skip
     2025         "Переоценка:" d-num
     2026         view-as alert-box error.
     2027       undo pr-alt, return error.
     2028     end.
     2029     find  buf-price-doc where
     2030           buf-price-doc.doc-num = d-num.
     2031     find  buf-bar-code no-lock where
     2032           buf-bar-code.b-code = bc.
     2033     find  buf-goods no-lock where
     2034           buf-goods.gds-code = buf-bar-code.gds-code.
     2035     find  buf-price-list where
     2036           buf-price-list.doc-num = buf-price-doc.doc-num and
     2037           buf-price-list.b-code  = bc.
     2038     if buf-price-list.d-pcnt = ? then do:
     2039   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2041     (input  buf-price-doc.obj-type
     2042     ,input  buf-price-doc.obj-code
     2043     ,input  bc
     2044     ,input  0
     2045     ,input  0
     2046     ,output pr-rec
     2047     ,output pr-c-b-r
     2048     )  .
     2049       find old-price-list no-lock where
     2050           recid (old-price-list) = pr-rec no-error.
     2051       if available old-price-list and
     2052         old-price-list.b-code = bc then
     2053         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2054       else
     2055         buf-price-list.d-pcnt = 0.
     2056     end.
     2057      if buf-price-list.d-pcnt = ? then do:
     2058         assign
     2059           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2060           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2061           .
     2062     end.
     2063     else do:
     2064         assign
     2065           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2066                                         buf-bar-code.cli-base-rate *
     2067                                         (1 - buf-price-list.d-pcnt / 100)
     2068           buf-price-list.calc-method =  'Основная':U
     2069           .
     2070   case r-method :
     2071     when '9-окончание':U then do:
     2072       if buf-price-list.price-sale < 29 then do:
     2073         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2074           assign
     2075             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2076           .
     2077         end.
     2078       end.
     2079       else do:
     2080         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2081           assign
     2082             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2083                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2084                   - 1 ) * 10
     2085                 + 9
     2086           .
     2087         end.
     2088         else do:
     2089           assign
     2090             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2091                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2092                   ) * 10
     2093                 + 9
     2094           .
     2095         end.
     2096         assign
     2097           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2098         .
     2099       end.
     2100     end.
     2101     when '9-99окончание':U then do:
     2102       if buf-price-list.price-sale < r-base then do:
     2103         assign
     2104           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2105         .
     2106       end.
     2107       else do:
     2108         assign
     2109           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2110         .
     2111       end.
     2112     end.
     2113     when 'Без-дробных':U then do:
     2114       assign
     2115         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2116       .
     2117     end.
     2118     when 'Произвольно':U then do:
     2119       if r-base <> 0 then do:
     2120         assign
     2121           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2122         .
     2123         if buf-price-list.price-sale = 0 then do:
     2124           assign
     2125             buf-price-list.price-sale = r-base
     2126           .
     2127         end.
     2128       end.
     2129     end.
     2130     when 'Вверх':U then do:
     2131       if r-base <> 0 then do:
     2132         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2133           assign
     2134             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2135           .
     2136         end.
     2137       end.
     2138       if buf-price-list.price-sale = 0 then do:
     2139         assign
     2140           buf-price-list.price-sale = r-base
     2141         .
     2142       end.
     2143     end.
     2144     when 'Коэффициент':U then do:
     2145       if r-base <> 0 then do:
     2146         assign
     2147           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2148         .
     2149       end.
     2150     end.
     2151     when 'Отключено':U then do:
     2152     end.
     2153     otherwise do:
     2154       message
     2155         vss-workfile vss-revision vss-description skip
     2156         "Неизвестный метод округления продажной цены" skip
     2157         "round-method" r-method skip
     2158         "round-base"   r-base   skip
     2159         "price"        buf-price-list.price-sale             skip
     2160         view-as alert-box error .
     2161     end.
     2162   end.
     2163     end.
     2164   end.
     2165   END PROCEDURE.
     2166   PROCEDURE calc-pr-discnt:
     2167   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2168   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2169   define buffer buf-price-doc  for ub.price-doc.
     2170   define buffer buf-price-list for ub.price-list.
     2171   define buffer buf-bar-code   for ub.bar-code.
     2172   define buffer buf-goods      for ub.goods.
     2173   define buffer old-price-list for ub.price-list.
     2174   define variable pr-rec   as   recid                  no-undo.
     2175   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2176   pr-discnt:
     2177   do on error undo pr-discnt, return error:
     2178     find  buf-price-doc where
     2179           buf-price-doc.doc-num = d-num.
     2180     find  buf-bar-code no-lock where
     2181           buf-bar-code.b-code = bc.
     2182     find  buf-goods no-lock where
     2183           buf-goods.gds-code = buf-bar-code.gds-code.
     2184     find  buf-price-list where
     2185           buf-price-list.doc-num = buf-price-doc.doc-num and
     2186           buf-price-list.b-code  = bc.
     2187     buf-price-list.d-pcnt = (1 -
     2188                              buf-price-list.price-sale /
     2189                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2190                              buf-bar-code.cli-base-rate) *
     2191                              100
     2192                              .
     2193   end.
     2194   END PROCEDURE.
     2195   PROCEDURE calc-pr-sub :
     2196   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2197   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2198   define  input  parameter calc-method  as character    no-undo.
     2199   define  input  parameter increase-pc  as decimal      no-undo.
     2200   define  input  parameter round-method as character    no-undo.
     2201   define  input  parameter round-base   as decimal      no-undo.
     2202   define  output parameter calc-rec     as recid        no-undo.
     2203   define  buffer buf-price-list for ub.price-list.
     2204   define  buffer buf-bar-code   for ub.bar-code.
     2205   define  buffer buf-goods      for ub.goods.
     2206   define  buffer buf-gds-prt    for ub.gds-prt.
     2207   define  buffer buf-gds-grp    for ub.gds-grp.
     2208   define  buffer buf-price-doc  for ub.price-doc.
     2209   calc-sub:
     2210   do on error undo calc-sub, return error:
     2211     find  buf-bar-code no-lock where
     2212           buf-bar-code.b-code = bc.
     2213     find  buf-goods no-lock where
     2214           buf-goods.gds-code = buf-bar-code.gds-code.
     2215     find  buf-gds-prt no-lock where
     2216           buf-gds-prt.node-code = buf-bar-code.node-code.
     2217     find  buf-price-list where
     2218           buf-price-list.doc-num    = d-num and
     2219           buf-price-list.b-code     = bc and
     2220           buf-price-list.price-type = "".
     2221     find  buf-price-doc where
     2222           buf-price-doc.doc-num = d-num.
     2223     calc-rec = recid (buf-price-list).
     2224     if buf-price-list.main-price then do:
     2225       for each  buf-price-list where
     2226                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2227                 buf-price-list.main-price = no and
     2228                 buf-price-list.artic      = buf-goods.artic and
     2229                 buf-price-list.prod-type  = buf-goods.prod-type and
     2230                 buf-price-list.prod-code  = buf-goods.prod-code,
     2231           first buf-bar-code no-lock where
     2232                 buf-bar-code.b-code   = buf-price-list.b-code and
     2233                 buf-bar-code.unit-cli = buf-goods.unit-base
     2234           on error undo calc-sub, return error:
     2235         run calc-pr-list (input  buf-bar-code.b-code,
     2236                           input  buf-price-list.doc-num,
     2237                           input  calc-method,
     2238                           input  increase-pc,
     2239                           input  round-method,
     2240                           input  round-base,
     2241                           input ? ,
     2242                           input ? ,
     2243                           input ? ,
     2244                           input ? ,
     2245                           output calc-rec) no-error.
     2246         if error-status :error then
     2247           undo calc-sub, return error.
     2248         calc-rec = recid (buf-price-list).
     2249       end.
     2250       for each  buf-price-list where
     2251                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2252                 buf-price-list.main-price = no and
     2253                 buf-price-list.artic      = buf-goods.artic and
     2254                 buf-price-list.prod-type  = buf-goods.prod-type and
     2255                 buf-price-list.prod-code  = buf-goods.prod-code,
     2256           first buf-bar-code no-lock where
     2257                 buf-bar-code.b-code    = buf-price-list.b-code and
     2258                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2259           on error undo calc-sub, return error:
     2260         run calc-pr-alt (input buf-price-doc.doc-num,
     2261                         input buf-bar-code.b-code,
     2262                         input round-method,
     2263                         input round-base) no-error.
     2264         if error-status :error then
     2265           undo calc-sub, return error.
     2266       end.
     2267     end.
     2268     else do:
     2269       run calc-base-upd (input buf-bar-code.b-code,
     2270                         input buf-price-doc.doc-num,
     2271                         input round-method,
     2272                         input round-base) no-error.
     2273       if error-status :error then
     2274         undo calc-sub, return error.
     2275     end.
     2276   end.
     2277   END PROCEDURE.
     2278   procedure ver-pr-nogds :
     2279   define input  parameter p-gds-code      as integer   no-undo .
     2280   define input  parameter p-par-pr-nogds  as character no-undo .
     2281   define output parameter p-not           as logical   no-undo .
     2282   define output parameter p-str           as character no-undo .
     2283   define buffer buf_goods for ub.goods  .
     2284   define variable nn as integer   no-undo .
     2285   define variable ii as integer   no-undo .
     2286   define variable v-namegrp as character no-undo .
     2287     do
     2288     on error undo, return error return-value
     2289     :
     2290     if p-par-pr-nogds = "1" then do:
     2291        assign
     2292         p-not = true
     2293         p-str = ""
     2294        .
     2295        return .
     2296     end.
     2297     assign
     2298       p-not = false
     2299       p-str = ""
     2300     .
     2301     find first buf_goods no-lock where
     2302                buf_goods.gds-code = p-gds-code no-error .
     2303     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2304     repeat ii = 1 to nn:
     2305        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2306        if buf_goods.grp-name  begins v-namegrp  then do:
     2307           assign
     2308             p-not = true
     2309             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2310           .
     2311           leave .
     2312        end.
     2313     end.
     2314     end.
     2315   end procedure.
     2316   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2317   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2318   define temp-table tt-level-dis-attr no-undo
     2319         field attr-code   like global-state-attr.attr-code
     2320         field attr-value  like global-state-attr.attr-value
     2321         index pi   attr-value descending
     2322         index pi1 is unique attr-value
     2323               attr-code .
     2324   procedure lvldsc-byattr :
     2325   define input  parameter p-attr-code  as character no-undo .
     2326   define input  parameter p-attr-value as character no-undo .
     2327   define output parameter p-val1       as decimal   no-undo .
     2328   define output parameter p-val2       as decimal   no-undo .
     2329   define output parameter p-prc        as decimal   no-undo .
     2330     do
     2331     on error undo, return error return-value
     2332     :
     2333     define variable v-str1 as character no-undo .
     2334     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     2335     v-str1 = trim ( v-str1 , chr(4) ) .
     2336    run lvldsc-bytt (
     2337         input   v-str1
     2338       , input   p-attr-value
     2339       , output  p-val1
     2340       , output  p-val2
     2341       , output  p-prc )
     2342         no-error .
     2343     end.
     2344   end procedure.
     2345   procedure lvldsc-bytt :
     2346   define input  parameter p-attr-code as character no-undo .
     2347   define input  parameter p-attr-value as character no-undo .
     2348   define output parameter p-val1 as decimal   no-undo .
     2349   define output parameter p-val2 as decimal   no-undo .
     2350   define output parameter p-prc  as decimal   no-undo .
     2351   define variable v-str1 as character no-undo .
     2352     do
     2353     on error undo, return error return-value
     2354     :
     2355     assign
     2356        v-str1 = trim ( p-attr-code , "[]()" )
     2357        p-val1 = decimal(entry(1,v-str1, ";"))
     2358        p-val2 = decimal(entry(2,v-str1, ";"))
     2359        p-prc  = decimal(p-attr-value)
     2360        no-error
     2361     .
     2362     end.
     2363   end procedure.
     2364   procedure level-dis-value :
     2365   define input  parameter p-price-prod as decimal   no-undo .
     2366   define input  parameter p-b-code     as integer   no-undo .
     2367   define input  parameter p-obj-type   as character no-undo .
     2368   define input  parameter p-obj-code   as integer   no-undo .
     2369   define output parameter p-prc as decimal   no-undo .
     2370   define variable v-level-dis-attr as character no-undo .
     2371   define variable v-type as character no-undo .
     2372   define variable v-val1 as decimal   no-undo .
     2373   define variable v-val2 as decimal   no-undo .
     2374   define variable v-prc  as decimal   no-undo .
     2375   define variable ix     as integer   no-undo .
     2376   do
     2377    on error undo, return error return-value
     2378    :
     2379   define buffer buf_goods for ub.goods  .
     2380   define buffer buf_bar-code for ub.bar-code  .
     2381   find first buf_bar-code no-lock where
     2382              buf_bar-code.b-code = p-b-code
     2383              no-error .
     2384   find first buf_goods no-lock where
     2385              buf_goods.gds-code = buf_bar-code.gds-code
     2386              no-error .
     2387   run ggoattr-value (
     2388      input   buf_goods.grp-code
     2389     ,input   v-cntxt-host-code-obj
     2390     ,input   p-obj-type
     2391     ,input   p-obj-code
     2392     ,input   'level-dis':U
     2393     ,output  v-level-dis-attr
     2394     ,output  v-type ) no-error .
     2395   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     2396     create
     2397       tt-level-dis-attr
     2398     .
     2399     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2400     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2401   end.
     2402   p-prc = 0 .
     2403     if p-price-prod = 0 then do:
     2404         for each tt-level-dis-attr no-lock
     2405                 :
     2406               run lvldsc-bytt (
     2407                 input   tt-level-dis-attr.attr-code
     2408               , input   tt-level-dis-attr.attr-value
     2409               , output  v-val1
     2410               , output  v-val2
     2411               , output  v-prc  )
     2412               .
     2413               if v-val1  = 0  then do:
     2414                  p-prc = v-prc .
     2415                 leave.
     2416               end.
     2417         end.
     2418     end.
     2419     else do:
     2420         for each tt-level-dis-attr no-lock
     2421                 :
     2422               run lvldsc-bytt (
     2423                 input   tt-level-dis-attr.attr-code
     2424               , input   tt-level-dis-attr.attr-value
     2425               , output  v-val1
     2426               , output  v-val2
     2427               , output  v-prc  )
     2428               .
     2429               if p-price-prod   > v-val1 and
     2430                  p-price-prod  <= v-val2 then do:
     2431                  p-prc = v-prc .
     2432                 leave.
     2433               end.
     2434         end.
     2435     end.
     2436   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     2437    end.
     2438   end procedure.
     2439   procedure calc-price-levelprod :
     2440   define input  parameter p-mode     as integer   no-undo .
     2441   define input  parameter p-rb       as character no-undo .
     2442   define input  parameter p-b-code   as integer   no-undo .
     2443   define input  parameter p-obj-type as character no-undo .
     2444   define input  parameter p-obj-code as integer   no-undo .
     2445   define output parameter p-price-sale as decimal   no-undo .
     2446   define output parameter p-descript-calc as character no-undo .
     2447   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     2448   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     2449   define variable  v-prod-vat        as decimal   no-undo init 0.
     2450   define variable  v-discnt          as decimal   no-undo init 0.
     2451   define buffer buf_goods for ub.goods  .
     2452   define buffer buf_bar-code for ub.bar-code  .
     2453   define buffer buf_parts for ub.parts  .
     2454   define variable v-part-code as character no-undo .
     2455   define variable v-in-code   as character no-undo .
     2456     do
     2457     on error undo, return error return-value
     2458     :
     2459   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2460   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     2461   (  input  p-b-code
     2462    , input  p-obj-type
     2463    , input  p-obj-code
     2464    , output v-PriceWithoutVat
     2465    , output v-PriceWithVat
     2466    , output v-prod-vat
     2467    , output v-part-code
     2468    , output v-in-code
     2469           ) no-error .
     2470         if error-status :error then do:
     2471           return error "Нет цены производителя!".
     2472         end.
     2473   find first buf_bar-code no-lock where
     2474              buf_bar-code.b-code = p-b-code
     2475              no-error .
     2476   find first buf_goods no-lock where
     2477              buf_goods.gds-code = buf_bar-code.gds-code
     2478              no-error .
     2479   find first buf_parts no-lock where
     2480              buf_parts.artic      = buf_goods.artic        and
     2481              buf_parts.prod-type  = buf_goods.prod-type    and
     2482              buf_parts.prod-code  = buf_goods.prod-code    and
     2483              buf_parts.in-code    = buf_bar-code.in-code   and
     2484              buf_parts.out-code   = buf_bar-code.in-code   and
     2485              buf_parts.part-code  = buf_bar-code.part-code
     2486              no-error .
     2487               if error-status :error then do:
     2488                   find first buf_parts no-lock where
     2489                             buf_parts.artic      = buf_goods.artic        and
     2490                             buf_parts.prod-type  = buf_goods.prod-type    and
     2491                             buf_parts.prod-code  = buf_goods.prod-code    and
     2492                             buf_parts.in-code    = v-in-code              and
     2493                             buf_parts.out-code   = v-in-code              and
     2494                             buf_parts.part-code  = v-part-code
     2495                             no-error .
     2496                   if error-status :error then do:
     2497                      message
     2498                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     2499                                   v-in-code,
     2500                                   v-part-code ,
     2501                                   buf_goods.artic   ,
     2502                                   buf_goods.prod-type,
     2503                                   buf_goods.prod-code ) .
     2504                      return error "Нет цены производителя !!!".
     2505                   end.
     2506               end.
     2507   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     2508   define variable v-postWithoutVat-rubl as decimal   no-undo .
     2509   define variable v-postWithoutVat-base as decimal   no-undo .
     2510      case p-mode :
     2511       when 1 then do:
     2512          if p-rb = "rubl" then do:
     2513             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     2514          end.
     2515          else do:
     2516             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     2517          end.
     2518       end.
     2519       when 2 then do:
     2520         if p-rb = "rubl" then do:
     2521           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     2522           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     2523         end.
     2524         else do:
     2525           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     2526           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     2527         end.
     2528       end.
     2529      end case.
     2530   p-descript-calc =
     2531     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     2532     buf_goods.gds-name                  +  chr(10) +
     2533     buf_goods.artic +
     2534     buf_goods.prod-type +
     2535     string(buf_goods.prod-code)         + chr(10) +
     2536     "бар-код " +  string(p-b-code)      + chr(10)  +
     2537     'ПН    ' + v-in-code  +
     2538     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     2539     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     2540     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     2541     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     2542     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     2543     chr(10) +
     2544     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     2545     chr(10) +
     2546     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     2547     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     2548     chr(10) +
     2549     string(p-price-sale)                                                               +  chr(10) +
     2550     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     2551     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     2552   .
     2553     end.
     2554   end procedure.
     2555   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2556   PROCEDURE write-bonus :
     2557   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2558   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2559   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2560   define input  parameter v-bonus as decimal   no-undo .
     2561     do
     2562     on error undo, return error return-value
     2563     :
     2564       find first ub.contract-specif-attr exclusive-lock  where
     2565                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2566                  ub.contract-specif-attr.host-code    = p-host-code     and
     2567                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2568                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2569                 no-error .
     2570         if not available ub.contract-specif-attr then do:
     2571            create ub.contract-specif-attr .
     2572            assign
     2573                 ub.contract-specif-attr.contract-num = p-contract-num
     2574                 ub.contract-specif-attr.host-code    = p-host-code
     2575                 ub.contract-specif-attr.gds-code     = p-gds-code
     2576                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2577            .
     2578         end.
     2579         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2580   end.
     2581   END PROCEDURE.
     2582   PROCEDURE read-bonus :
     2583   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2584   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2585   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2586   define output parameter v-bonus as decimal   no-undo .
     2587     do
     2588     on error undo, return error return-value
     2589     :
     2590   find first ub.contract-specif-attr no-lock  where
     2591              ub.contract-specif-attr.contract-num = p-contract-num  and
     2592              ub.contract-specif-attr.host-code    = p-host-code     and
     2593              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2594              ub.contract-specif-attr.attr-code    = 'bonus':U
     2595              no-error .
     2596      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2597                                           else  v-bonus = 0 .
     2598   end.
     2599   END PROCEDURE.
