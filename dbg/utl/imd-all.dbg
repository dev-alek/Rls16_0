    10125        find first buf_goods where buf_goods.gds-code = bf_bar-code.gds-code  no-lock no-error.
    10126        if not available buf_goods then do:
    10127             if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted SUBSTITUTE("Отсутствует товар с gds-code: &1 &2 &3",
    10128                       bf_bar-code.gds-code ,
