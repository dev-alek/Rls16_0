     7033                           buf_goods.prod-type =  pdf_price-list.prod-type and
     7034                           buf_goods.prod-code =  pdf_price-list.prod-code no-error .
     7035               check-par = false .
     7036                  for each pp_price-list no-lock where
     7037                           pp_price-list.plt-id     = p-plt-id     and
     7038                           pp_price-list.plt-db-num = p-plt-db-num and
     7039                           pp_price-list.pdf-id     = p-pdf-id     and
     7040                           pp_price-list.pdf-db     = p-pdf-db     and
     7041                           pp_price-list.artic      = pdf_price-list.artic and
     7042                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     7043                           pp_price-list.prod-code  = pdf_price-list.prod-code ,
     7044                        first buf1-bar-code no-lock where
