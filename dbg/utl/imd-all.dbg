     9916   ,input 0
     9917   ,input 0
     9918   ,input 0
     9919   ) no-error
     9920   .
     9921     if error-status:error then do:
     9922         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted SUBSTITUTE("Ошибка при вызове процедуры crdoclin &1 &2 &3",
     9923                               return-value,
     9924                               error-status:get-message(1),
     9925                               error-status:get-message(2))  + chr(10).
     9926         return error.
     9927     end.
     9928     find first ub.doc-line where ub.doc-line.doc-code  = ub.trn-doc.doc-code and
     9929                               ub.doc-line.artic     = ub.goods.artic      and
     9930                               ub.doc-line.prod-type = ub.goods.prod-type  and
     9931                               ub.doc-line.prod-code = ub.goods.prod-code .
     9932     assign
     9933       ub.doc-line.cli-qnty      = 0
     9934       ub.doc-line.doc-qnty      = 0
