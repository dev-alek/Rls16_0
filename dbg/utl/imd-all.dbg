     7046                             buf1-bar-code.unit-cli <> buf_goods.unit-base
     7047                       :
     7048                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     7049                       check-par = true  .
     7050                       leave.
     7051                   end.
     7052                  for each pp_price-list no-lock where
     7053                           pp_price-list.plt-id     = p-plt-id     and
     7054                           pp_price-list.plt-db-num = p-plt-db-num and
     7055                           pp_price-list.pdf-id     = p-pdf-id     and
     7056                           pp_price-list.pdf-db     = p-pdf-db     and
     7057                           pp_price-list.artic      = pdf_price-list.artic and
     7058                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     7059                           pp_price-list.prod-code  = pdf_price-list.prod-code and
     7060                           pp_price-list.price-sale-doc <> pdf_price-list.price-sale-doc  ,
     7061                        first buf1-bar-code no-lock where
     7062                             buf1-bar-code.b-code   = pp_price-list.b-code and
     7063                             buf1-bar-code.unit-cli = buf_goods.unit-base
     7064                       :
     7065                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     7066                       check-par = true  .
     7067                       leave.
     7068                   end.
     7069               if check-par = true then next.
     7070               if par-pr-equ-dq = 2 then do:
     7071                     if  ( v-num <= 2  and check-par = false ) then
     7072                         run gbl/d-askw.w
     7073                           (input "Удалить строку?"
     7074                           ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     7075                                       + " Объект "  + v-cntxt-obj-type + String(v-cntxt-obj-code)
     7076                                       + " Артикул " + pdf_price-list.artic + " " +  buf_goods.gds-name + chr(10)
     7077                                       + " Бар-код " + string(pdf_price-list.b-code)
     7078                                       + " Цена по предыдущему документу переоценки № " + l-doc-num2 + " = "
     7079                                       + string(pdf_price-list.price-sale-doc) + chr(10)
     7080                                       + " Удалить строку? "
     7081                           ,input "|^"
     7082                           ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     7083                           ,input "Удалить строку|"
     7084                               + "Не удалять строку|"
     7085                               + "Удалять у всех товаров, цена на которые не изменилась|"
     7086                               + "Не удалять у всех товаров, цена на которые не изменилась"
     7087                           ,input 1
     7088                           ,input 2
     7089                           ,output v-num
     7090                           ).
     7091                 end.
     7092                 else do:
     7093                   v-num = 3 .
     7094                 end.
     7095                   if v-num = 1 then do:
     7096                     run del-doc-line ( input recid(pdf_price-list)) no-error  .
     7097                                     if error-status :error then do:
     7098                                             message  vss-workfile vss-revision vss-description skip
     7099                                             "Ошибка при удаление строки ДНЦ"
     7100                                             pdf_price-list.b-code skip
     7101                                             error-status :get-message(1) .
     7102                                             return error.
     7103                                     end.
     7104                   end.
     7105                   if v-num = 3  then do:
     7106                      run del-doc-line ( input recid(pdf_price-list)) no-error  .
     7107                   end.
     7108           end.
     7109          end.
     7110   end.
     7111     for each main_price-list no-lock where
     7112                 main_price-list.plt-id      = p-plt-id and
     7113                 main_price-list.plt-db-num  = p-plt-db-num and
     7114                 main_price-list.pdf-id      = p-pdf-id and
     7115                 main_price-list.pdf-db      = p-pdf-db
     7116                 :
     7117                 if main_price-list.b-code <> f-base-code (main_price-list.b-code) then next.
     7118                   for each pp_price-list no-lock where
     7119                             pp_price-list.plt-id       = main_price-list.plt-id     and
     7120                             pp_price-list.plt-db-num   = main_price-list.plt-db-num and
     7121                             pp_price-list.pdf-id       = main_price-list.pdf-id     and
     7122                             pp_price-list.pdf-db       = main_price-list.pdf-db     and
     7123                             pp_price-list.artic        = main_price-list.artic      and
     7124                             pp_price-list.prod-type    = main_price-list.prod-type  and
     7125                             pp_price-list.prod-code    = main_price-list.prod-code  and
     7126                             pp_price-list.b-code      <> main_price-list.b-code     and
     7127                             pp_price-list.price-sale-doc = main_price-list.price-sale-doc  ,
     7128                       first buf_goods no-lock where
     7129                             buf_goods.artic     =  pp_price-list.artic and
     7130                             buf_goods.prod-type =  pp_price-list.prod-type and
     7131                             buf_goods.prod-code =  pp_price-list.prod-code ,
     7132                       first buf1-bar-code no-lock where
