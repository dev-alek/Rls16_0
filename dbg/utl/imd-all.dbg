     7301     if v-ok = true then return .
     7302   if trim(par-pr-discm) = "" then return .
     7303   if par-pr-discm = 'sale-' then par-pr-discm = 'sale' .
     7304   for each  b_price-doc-forming-gds no-lock where
     7305             b_price-doc-forming-gds.plt-id     = p-plt-id      and
