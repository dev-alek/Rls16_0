     3313             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     3314             cur-rt-base = prev-list.road-tax
     3315             cur-rt-rubl = prev-list.road-tax
     3316             cost-rubl = prev-list.price-sale
     3317             cost-base = prev-list.price-sale
     3318             .
     3319         else
     3320           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     3321                   "- расчет невозможен."
     3322                   view-as alert-box information .
     3323       end.
     3324       when 'ДокФормЦены':U then do:
     3325       find first b_price-doc-forming no-lock where
     3326                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     3327                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     3328                  no-error .
     3329         find b_price-doc-forming-gds no-lock where
     3330              b_price-doc-forming-gds.b-code     = p-b-code and
     3331              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     3332              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     3333              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     3334              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     3335              no-error.
     3336         if available b_price-doc-forming-gds then
     3337           assign
     3338             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     3339             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     3340             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     3341             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     3342             cost-base   = b_price-doc-forming-gds.price-sale-base
     3343             .
     3344         else
     3345           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     3346                   "для товара :" skip
     3347                    "Бар-код" p-b-code     skip
     3348                    "Артикул" p-artic      skip
     3349                     p-prod-type  skip
     3350                     p-prod-code  skip
     3351                   "- расчет невозможен."
     3352                   view-as alert-box information .
     3353       end.
     3354       when 'Единая':U then do:
     3355           assign
     3356             p-new-calc-method = 'Единая':U + " " + string(common-price)
     3357             cost-rubl = common-price
     3358             cost-base = common-price
     3359             .
     3360       end.
     3361       when 'Объект':U then do:
     3362       find first buf_gds-obj no-lock where
     3363                  buf_gds-obj.gds-code = p-gds-code and
     3364                  buf_gds-obj.obj-type = v-copy-type and
     3365                  buf_gds-obj.obj-code = v-copy-code no-error .
     3366           if available buf_gds-obj then do:
     3367           assign
     3368             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     3369             cost-rubl = buf_gds-obj.price-sale
     3370             cost-base = buf_gds-obj.price-sale
     3371             .
     3372           end.
     3373           else do:
     3374               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     3375                       "для товара :" p-artic  "- расчет невозможен."
     3376                       view-as alert-box information .
     3377           end.
     3378       end.
     3379      when 'Отсутствует':U or
     3380      when "" then do:
     3381         run str/mplnovat.p
     3382           ( input  'Отсутствует':U    ,
     3383             input  table x_obj-group ,
     3384             input  p-b-code    ,
     3385             input  p-artic     ,
     3386             input  p-prod-type ,
     3387             input  p-prod-code ,
     3388             input  0 ,
     3389             input  v-doc-code ,
     3390             input  p-vat-pc      ,
     3391             input  p-slt-pc      ,
     3392             output vd  ,
     3393             output vd  ,
     3394             output cost-base   ,
     3395             output cost-rubl   ,
     3396             output cur-rt-base ,
     3397             output cur-rt-rubl
     3398             ).
     3399             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3400             cost-base = cost-rubl / p-base-rate * p-base-scale .
     3401             p-new-calc-method = 'Отсутствует':U .
     3402      end.
     3403      when 'Основная':U then do:
     3404      end.
     3405     when 'ПорогПр-НДС':U then do:
     3406       message 1.
     3407     end.
     3408     when 'ПорогПр+НДС':U then do:
     3409       message 2.
     3410     end.
     3411     when 'Производит':U
     3412        then do:
     3413         find first x_obj-group .
     3414   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3416   (  input  p-b-code
     3417    , input  x_obj-group.obj-type
     3418    , input  x_obj-group.obj-code
     3419    , output v-PriceWithVat
     3420    , output vd
     3421    , output v-prod-vat
     3422    , output v-str1
     3423    , output v-str1
     3424           ) no-error .
     3425         if vd = 0 or vd = ?  then do:
     3426           message "Нет ПН для товара :" p-artic  p-b-code
     3427                   "- расчет по производителю от последней приходной накладной невозможен."
     3428                   view-as alert-box question buttons OK-Cancel title "#2" update g#log as logical .
     3429         end.
     3430         else do:
     3431             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3432             cost-base = cost-rubl / p-base-rate * p-base-scale .
     3433         end.
     3434     end.
     3435     when 'Произв-НДС':U
     3436       then do:
     3437         find first x_obj-group .
     3438   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3440   (  input  p-b-code
     3441    , input  x_obj-group.obj-type
     3442    , input  x_obj-group.obj-code
     3443    , output vd
     3444    , output v-PriceWithVat
     3445    , output v-prod-vat
     3446    , output v-str1
     3447    , output v-str1
     3448           ) no-error .
     3449         if vd = 0 or vd = ?  then do:
     3450           message "Нет ПН для товара :" p-artic  p-b-code
     3451                   "- расчет по производителю от последней приходной накладной невозможен."
     3452                   view-as alert-box .
     3453         end.
     3454         else do:
     3455             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3456             cost-base = cost-rubl / p-base-rate * p-base-scale .
     3457         end.
     3458       end.
     3459      otherwise do:
     3460        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     3461                  p-new-calc-method  skip
     3462                 "p-price-prev-doc " p-price-prev-doc  skip
     3463                 "mpl-lib ERR !!! " skip
     3464                 'артикул ' p-artic skip
     3465                 view-as alert-box information .
     3466      end.
     3467    end case.
     3468   run main-road-taxs in this-procedure
     3469     ( input p-artic     ,
     3470       input p-prod-type ,
     3471       input p-prod-code ,
     3472       input-output cur-rt-base ,
     3473       input-output cur-rt-rubl )
     3474       no-error .
     3475       if error-status :error then do:
     3476          message
     3477            error-status :get-message(1) skip
     3478            return-value skip
     3479            "main-road-taxs"
     3480            view-as alert-box error
     3481          .
     3482       end.
     3483     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     3484       return error "Не определен курс валюты документа" .
     3485     end.
     3486     if p-base-scale = 0  or  p-base-scale = ?  then do:
     3487        return error "Не определен курс базовой валюты " .
     3488     end.
     3489   if v-base = false then var-pr-r-b = "rubl":U .
     3490                     else var-pr-r-b =  "base":U .
     3491       if var-pr-r-b = "rubl":U then do:
     3492           case p-calc-method :
     3493            when 'ПорогПр-НДС':U then do:
     3494               message 3.
     3495            end.
     3496            when 'ПорогПр+НДС':U then do:
     3497                message 4.
     3498            end.
     3499            when 'Производит':U then do:
     3500               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)   .
     3501            end.
     3502            when 'Произв-НДС':U then do:
     3503               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 +  p-vat-pc / 100)  .
     3504            end.
     3505            otherwise do:
     3506               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     3507            end.
     3508           end case.
     3509           assign
     3510             p-price-calc-rubl  =  cost-rubl
     3511             p-road-tax-rubl    =  cur-rt-rubl
     3512             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     3513             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     3514             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     3515           .
     3516       end.
     3517       else dO:
     3518            case p-calc-method :
     3519            when 'ПорогПр-НДС':U then do:
     3520               message 5.
     3521            end.
     3522            when 'ПорогПр+НДС':U then do:
     3523                message 6.
     3524            end.
     3525            when 'Производит':U then do:
     3526               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     3527            end.
     3528            when 'Произв-НДС':U then do:
     3529               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     3530            end.
     3531            otherwise do:
     3532               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     3533            end.
     3534            end case.
     3535           assign
     3536             p-price-calc-base  =  cost-base
     3537             p-road-tax-base    =  cur-rt-base
     3538             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     3539             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     3540             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     3541             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     3542             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     3543             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     3544           .
     3545       end.
     3546   case p-round-method :
     3547     when '9-окончание':U then do:
     3548       if p-price-sale-doc < 29 then do:
     3549         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     3550           assign
     3551             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     3552           .
     3553         end.
     3554       end.
     3555       else do:
     3556         if (p-price-sale-doc modulo 10) < 3 then do:
     3557           assign
     3558             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     3559                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     3560                   - 1 ) * 10
     3561                 + 9
     3562           .
     3563         end.
     3564         else do:
     3565           assign
     3566             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     3567                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     3568                   ) * 10
     3569                 + 9
     3570           .
     3571         end.
     3572         assign
     3573           p-price-sale-doc = round (p-price-sale-doc, 0)
     3574         .
     3575       end.
     3576     end.
     3577     when '9-99окончание':U then do:
     3578       if p-price-sale-doc < p-round-base then do:
     3579         assign
     3580           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     3581         .
     3582       end.
     3583       else do:
     3584         assign
     3585           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     3586         .
     3587       end.
     3588     end.
     3589     when 'Без-дробных':U then do:
     3590       assign
     3591         p-price-sale-doc = round (p-price-sale-doc, 0)
     3592       .
     3593     end.
     3594     when 'Произвольно':U then do:
     3595       if p-round-base <> 0 then do:
     3596         assign
     3597           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     3598         .
     3599         if p-price-sale-doc = 0 then do:
     3600           assign
     3601             p-price-sale-doc = p-round-base
     3602           .
     3603         end.
     3604       end.
     3605     end.
     3606     when 'Вверх':U then do:
     3607       if p-round-base <> 0 then do:
     3608         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     3609           assign
     3610             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     3611           .
     3612         end.
     3613       end.
     3614       if p-price-sale-doc = 0 then do:
     3615         assign
     3616           p-price-sale-doc = p-round-base
     3617         .
     3618       end.
     3619     end.
     3620     when 'Коэффициент':U then do:
     3621       if p-round-base <> 0 then do:
     3622         assign
     3623           p-price-sale-doc = p-price-sale-doc * p-round-base
     3624         .
     3625       end.
     3626     end.
     3627     when 'Отключено':U then do:
     3628     end.
     3629     otherwise do:
     3630       message
     3631         vss-workfile vss-revision vss-description skip
     3632         "Неизвестный метод округления продажной цены" skip
     3633         "round-method" p-round-method skip
     3634         "round-base"   p-round-base   skip
     3635         "price"        p-price-sale-doc             skip
     3636         view-as alert-box error .
     3637     end.
     3638   end.
     3639       if error-status :error then do:
     3640       message
     3641         error-status :get-message(1) skip
     3642         return-value skip
     3643         "pr-99"
     3644         view-as alert-box error
     3645       .
     3646       end.
     3647     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     3648     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     3649     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     3650     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     3651     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     3652     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     3653     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     3654     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     3655     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     3656     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     3657     p-prev-doc-code = if available bufold_price-doc-forming
     3658                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     3659                          else "" .
     3660     end.
     3661   end procedure.
     3662   PROCEDURE calc-price-line :
