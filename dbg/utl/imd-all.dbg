      142   function hvrdtax return logical (input parrecid as recid):
      143   define variable varresult as logical no-undo.
      144   run hvrdtax-proc (input parrecid, output varresult).
      145   return varresult.
      146   end function.
      147   procedure hvrdtax-proc:
      148   define input  parameter parrecid  as recid   no-undo.
      149   define output parameter parresult as logical no-undo.
      150   define buffer bf_goods for ub.goods.
      151   define buffer bf_units for ub.units.
      152   define buffer rt_tax   for ub.tax.
      153   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      154   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      155   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      156   if available rt_tax and
      157       can-find(first ub.tax-units No-LOCK WHERE
      158                      ub.tax-units.tax-code = rt_tax.tax-code AND
      159                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      160                                                       else assign parresult = no.
      161   end procedure.
      162   define new global shared variable g#libbcrcn as handle no-undo .
      163   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      164     define variable v-cntxt-db-num        as integer   no-undo .
      165     define variable v-cntxt-userid        as character no-undo .
      166     define variable v-cntxt-level         as character no-undo .
      167     define variable v-cntxt-host-code-obj as integer   no-undo .
      168     define variable v-cntxt-obj-type      as character no-undo .
      169     define variable v-cntxt-obj-code      as integer   no-undo .
      170     define variable v-cntxt-db-num-obj    as integer   no-undo .
      171     define variable v-cntxt-is-admin      as logical   no-undo .
      172   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173     run mainmenu_getcntxt in parparentproc
      174       (output v-cntxt-db-num
      175       ,output v-cntxt-userid
      176       ,output v-cntxt-level
      177       ,output v-cntxt-host-code-obj
      178       ,output v-cntxt-obj-type
      179       ,output v-cntxt-obj-code
      180       ,output v-cntxt-db-num-obj
      181       ,output v-cntxt-is-admin
      182       ) .
      183   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      186   define variable par-type          as character no-undo.
      187   define variable v-value-character as character no-undo .
      188   define variable v-value-date      as date      no-undo .
      189   define variable v-value-decimal   as decimal   no-undo .
      190   define variable v-value-integer   as integer   no-undo .
      191   define variable v-value-logical   as logical   no-undo .
      192   DEFINE BUFFER buf_price-doc-forming FOR ub.price-doc-forming.
      193   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   define temp-table x_obj-group no-undo like ub.clients  .
      195   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      196   procedure metod-gop-obj :
      197     do
      198     on error undo, return error return-value
      199     :
      200   define input  parameter p-cntxt-db-num as integer   no-undo .
      201   define input  parameter p-gop-id       as integer   no-undo .
      202   define input  parameter p-gop-db-num   as integer   no-undo .
      203   define buffer buf1_clients for ub.clients  .
      204   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      205   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      206   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      207   for each  x_obj-group : delete x_obj-group. end.
      208   if p-gop-id = 0 or p-gop-id = ?  then do:
      209      if p-cntxt-db-num = 0  then do:
      210           for each buf1_clients no-lock where
      211                   (buf1_clients.obj-type = 'маг':U  or
      212                    buf1_clients.obj-type = 'скл':U  )
      213                   and
      214                   buf1_clients.db-num >= 0  and
      215                   buf1_clients.stts = 0
      216                   :
      217             create x_obj-group .
      218             assign
      219               x_obj-group.obj-code   = buf1_clients.obj-code
      220               x_obj-group.obj-type   = buf1_clients.obj-type
      221               x_obj-group.obj-name   = buf1_clients.obj-name
      222               x_obj-group.db-num     = buf1_clients.db-num
      223             .
      224           end.
      225      end.
      226      else do:
      227           for each buf1_clients no-lock where
      228                   (buf1_clients.obj-type = 'маг':U  or
      229                    buf1_clients.obj-type = 'скл':U  ) and
      230                    buf1_clients.db-num = p-cntxt-db-num  and
      231                    buf1_clients.stts = 0
      232                   :
      233             create x_obj-group .
      234             assign
      235               x_obj-group.obj-code   = buf1_clients.obj-code
      236               x_obj-group.obj-type   = buf1_clients.obj-type
      237               x_obj-group.obj-name   = buf1_clients.obj-name
      238               x_obj-group.db-num     = buf1_clients.db-num
      239             .
      240           end.
      241      end.
      242   end.
      243   else do:
      244         for each buf_db-grp-obj-price  where
      245                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      246                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      247                 buf_db-grp-obj-price.stts = 0  no-lock :
      248           for each buf1_clients no-lock where
      249                  (buf1_clients.obj-type = 'маг':U  or
      250                   buf1_clients.obj-type = 'скл':U  ) and
      251                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      252                   buf1_clients.stts = 0
      253                   :
      254             create x_obj-group .
      255             assign
      256               x_obj-group.obj-code   = buf1_clients.obj-code
      257               x_obj-group.obj-type   = buf1_clients.obj-type
      258               x_obj-group.obj-name   = buf1_clients.obj-name
      259               x_obj-group.db-num     = buf1_clients.db-num
      260             .
      261           end.
      262         end.
      263       for each buf_host-grp-obj-price where
      264               buf_host-grp-obj-price.gop-id     = p-gop-id and
      265               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      266               buf_host-grp-obj-price.stts = 0
      267               no-lock :
      268         for each buf1_clients no-lock where
      269                (buf1_clients.obj-type = 'маг':U  or
      270                 buf1_clients.obj-type = 'скл':U  ) and
      271                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      272                 buf1_clients.stts = 0
      273                 :
      274             find first x_obj-group no-lock  where
      275                       x_obj-group.obj-code   = buf1_clients.obj-code and
      276                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      277             if not available  x_obj-group then   create x_obj-group .
      278             assign
      279               x_obj-group.obj-code   = buf1_clients.obj-code
      280               x_obj-group.obj-type   = buf1_clients.obj-type
      281               x_obj-group.obj-name   = buf1_clients.obj-name
      282               x_obj-group.db-num     = buf1_clients.db-num
      283             .
      284         end.
      285       end.
      286       for each buf_obj-grp-obj-price where
      287               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      288               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      289               buf_obj-grp-obj-price.stts = 0
      290               no-lock :
      291         for each buf1_clients no-lock where
      292                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      293                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      294                   buf1_clients.stts     = 0
      295                   :
      296             find first  x_obj-group no-lock  where
      297                         x_obj-group.obj-code   = buf1_clients.obj-code and
      298                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      299             if not available  x_obj-group then   create x_obj-group .
      300             assign
      301               x_obj-group.obj-code   = buf1_clients.obj-code
      302               x_obj-group.obj-type   = buf1_clients.obj-type
      303               x_obj-group.obj-name   = buf1_clients.obj-name
      304               x_obj-group.db-num     = buf1_clients.db-num
      305             .
      306         end.
      307       end.
      308   end.
      309   end.
      310   end procedure.
      311   procedure metod-obj-in-gop :
      312   define input  parameter p-curr-db-num as integer   no-undo .
      313   define input  parameter p-obj-type as character no-undo .
      314   define input  parameter p-obj-code as integer   no-undo .
      315   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      316     do
      317     on error undo, return error return-value
      318     :
      319       empty temp-table x_grp-obj-price.
      320       for each buf_grp-obj-price where
      321                buf_grp-obj-price.stts = 0
      322                no-lock :
      323                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      324                  for each x_obj-group where
      325                           x_obj-group.obj-type = p-obj-type and
      326                           x_obj-group.obj-code = p-obj-code :
      327                       create  x_grp-obj-price.
      328                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      329                  end.
      330       end.
      331     end.
      332   end procedure.
      333   procedure metod-delobj-usr :
      334   define input  parameter p-pdf-id  as integer   no-undo .
      335   define input  parameter p-pdf-db  as integer   no-undo .
      336   define input  parameter p-plt-id  as integer   no-undo .
      337   define input  parameter p-plt-db-num as integer   no-undo .
      338   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      339     do
      340     on error undo, return error return-value
      341     :
      342   for each buf_price-doc-forming-attr no-lock  where
      343            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      344            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      345            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      346            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      347            buf_price-doc-forming-attr.attr-code begins "obj" :
      348      for each x_obj-group  where
      349               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      350               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      351        delete x_obj-group.
      352      end.
      353   end.
      354     if not can-find (first x_obj-group) then do:
      355        return "nullobj" .
      356     end.
      357   end.
      358   end procedure.
      359   procedure metod-obj-pdf :
      360   define input  parameter p-cntxt-db-num as integer   no-undo .
      361   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      362   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      363   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      364   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      365   define buffer buf_price-list-type for ub.price-list-type  .
      366   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      367     do
      368     on error undo, return error return-value
      369     :
      370    for each  x_obj-group : delete x_obj-group. end.
      371    find first buf_price-list-type no-lock where
      372               buf_price-list-type.plt-id = p-plt-id and
      373               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      374   if error-status :error then return error return-value .
      375    find first buf_price-doc-forming no-lock where
      376               buf_price-doc-forming.plt-id     = p-plt-id and
      377               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      378               buf_price-doc-forming.pdf-id     = p-pdf-id and
      379               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      380               no-error .
      381   if error-status :error then return error return-value .
      382     run metod-gop-obj in this-procedure (
      383         p-cntxt-db-num,
      384         buf_price-list-type.gop-id ,
      385         buf_price-list-type.gop-db-num
      386         ) no-error .
      387     run metod-delobj-usr in this-procedure (
      388       buf_price-doc-forming.pdf-id ,
      389       buf_price-doc-forming.pdf-db ,
      390       buf_price-doc-forming.plt-id ,
      391       buf_price-doc-forming.plt-db-num
      392       ) no-error .
      393     end.
      394   end procedure.
      395   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
      397                                           local-doc-num as char).
      398   define buffer base-price        for ub.price-list.
      399   define variable local-main-code like ub.bar-code.b-code no-undo.
      400   define variable local-base-code like ub.bar-code.b-code no-undo.
      401     run prc-base-code (input local-bc, output local-base-code).
      402     find base-price no-lock where
      403          base-price.doc-num = local-doc-num and
      404          base-price.b-code  = local-base-code and
      405          base-price.price-type = "" no-error.
      406     if not available base-price then do:
      407       run prc-main-code (input local-bc, output local-main-code).
      408       find  base-price no-lock where
      409             base-price.doc-num = local-doc-num and
      410             base-price.b-code  = local-main-code and
      411             base-price.price-type = "" no-error.
      412     end.
      413     if available base-price then
      414       return (base-price.price-sale).
      415     else
      416       return (?).
      417   END FUNCTION.
      418   procedure prc-main-code:
      419   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      420   define output parameter local-main-code like ub.bar-code.b-code no-undo.
      421   define buffer local-bar-code        for ub.bar-code.
      422   define buffer local-goods           for ub.goods.
      423   define buffer main-code             for ub.bar-code.
      424   define buffer main-prt              for ub.gds-prt.
      425     local-main-code = ?.
      426     find local-bar-code no-lock where
      427          local-bar-code.b-code = local-bc no-error.
      428     if not available local-bar-code then
      429       return.
      430     find local-goods no-lock where
      431          local-goods.gds-code = local-bar-code.gds-code.
      432     find first  main-prt no-lock where
      433                 main-prt.upper-code = local-goods.prt-root.
      434     find  main-code no-lock where
      435           main-code.gds-code  = local-bar-code.gds-code and
      436           main-code.in-code   = "" and
      437           main-code.part-code = "" and
      438           main-code.unit-cli  = local-goods.unit-base and
      439           main-code.node-code = main-prt.node-code.
      440     local-main-code = main-code.b-code.
      441   end procedure.
      442   procedure prc-base-code:
      443   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      444   define output parameter local-base-code like ub.bar-code.b-code no-undo.
      445   define buffer local-bar-code for ub.bar-code.
      446   define buffer local-goods    for ub.goods.
      447   define buffer base-code      for ub.bar-code.
      448     local-base-code = ?.
      449     find local-bar-code no-lock where
      450          local-bar-code.b-code = local-bc no-error.
      451     if not available local-bar-code then
      452       return.
      453     find local-goods no-lock where
      454          local-goods.gds-code = local-bar-code.gds-code.
      455     find base-code no-lock where
      456          base-code.gds-code  = local-bar-code.gds-code and
      457          base-code.node-code = local-bar-code.node-code and
      458          base-code.in-code   = local-bar-code.in-code and
      459          base-code.part-code = local-bar-code.part-code and
      460          base-code.unit-cli  = local-goods.unit-base.
      461     local-base-code = base-code.b-code.
      462   end procedure.
      463   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      464   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      465   procedure prcreate-new-price-doc :
      466   do
      467   on error undo, return error return-value
      468   :
      469   define input  parameter p-curr-db-num  as integer   no-undo .
      470   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
      471   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
      472   define input  parameter p-plt-id       as integer   no-undo .
      473   define input  parameter p-plt-db-num   as integer   no-undo .
      474   define input  parameter p-pdf-id       as integer   no-undo .
      475   define input  parameter p-pdf-db-num   as integer   no-undo .
      476   define output parameter p-price-doc-recid  as recid                no-undo.
      477   define variable v-host-code         like ub.sysconf.host-code        no-undo.
      478   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
      479   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
      480   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
      481   define buffer buf_price-doc-forming for ub.price-doc-forming.
      482   define buffer buf_price-doc         for ub.price-doc.
      483   find first buf_price-doc-forming no-lock where
      484              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      485              buf_price-doc-forming.pdf-id     = p-pdf-id     and
      486              buf_price-doc-forming.plt-db-num = p-plt-db-num and
      487              buf_price-doc-forming.plt-id     = p-plt-id
      488              no-error .
      489   if not available buf_price-doc-forming and p-plt-id = ? then do:
      490      run create_new_price-doc-forming
      491           ( input p-obj-type ,
      492             input p-obj-code ,
      493             output p-pdf-db-num ,
      494             output p-pdf-id ,
      495             output p-plt-db-num ,
      496             output p-plt-id
      497             ).
      498       find first buf_price-doc-forming no-lock where
      499                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      500                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
      501                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
      502                 buf_price-doc-forming.plt-id     = p-plt-id
      503                 no-error .
      504   end.
      505       create buf_price-doc .
      506       run doc-code in this-procedure
      507       (input  "main",
      508        input  p-obj-type  ,
      509        input  p-obj-code  ,
      510        input  ?,
      511        output buf_price-doc.doc-num) no-error.
      512       if error-status:error then do:
      513         message vss-workfile vss-revision vss-description skip
      514                error-status :get-message(1)
      515               "Ошибка при генерации номера документа." return-value view-as alert-box error.
      516         return error.
      517       end.
      518   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      520     (input  p-obj-type
      521     ,input  p-obj-code
      522     ,output v-host-code
      523     )  .
      524       v-obj-current-date  = today .
      525       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
      526           v-base-rate   =  buf_price-doc-forming.base-rate  .
      527           v-base-scale  =  buf_price-doc-forming.base-scale .
      528       end.
      529       else do:
      530   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      532     (input  v-host-code
      533     ,input  v-obj-current-date
      534     ,output v-base-rate
      535     ,output v-base-scale
      536     )  .
      537       end.
      538      assign
      539       buf_price-doc.base-rate      = v-base-rate
      540       buf_price-doc.base-scale     = v-base-scale
      541       buf_price-doc.cr-db-num      = p-curr-db-num
      542       buf_price-doc.doc-date       = v-obj-current-date
      543       buf_price-doc.fact-num       = 0
      544       buf_price-doc.host-code      = v-host-code
      545       buf_price-doc.is-corr        = false
      546       buf_price-doc.is-del         = false
      547       buf_price-doc.obj-code       = p-obj-code
      548       buf_price-doc.obj-type       = p-obj-type
      549       buf_price-doc.out-code       = ""
      550       buf_price-doc.pdf-db         = p-pdf-db-num
      551       buf_price-doc.pdf-id         = p-pdf-id
      552       buf_price-doc.plt-db-num     = p-plt-db-num
      553       buf_price-doc.plt-id         = p-plt-id
      554       buf_price-doc.PS             = "@ "
      555       buf_price-doc.rest-base      = 0
      556       buf_price-doc.rest-last      = 0
      557       buf_price-doc.rest-qnty      = 0
      558       buf_price-doc.rest-sale      = 0
      559       buf_price-doc.sale-base      = 0
      560       buf_price-doc.status_        = 'новый':U
      561       .
      562       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
      563       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
      564       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
      565       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
      566       assign
      567           p-price-doc-recid = recid ( buf_price-doc )
      568       .
      569   end.
      570   end procedure.
      571   procedure prcreate-new-price-list :
      572   do
      573   on error undo, return error return-value
      574   :
      575   define input parameter p-price-doc-recid   as recid                    no-undo.
      576   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
      577   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
      578   define output parameter p-update           as logical                  no-undo.
      579   define variable kk as integer no-undo .
      580   define var v-b-code    like ub.bar-code.b-code     no-undo.
      581   define variable p-hostcode as int no-undo .
      582   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
      583   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
      584   define buffer buf_price-doc        for ub.price-doc.
      585   define buffer buf_price-list       for ub.price-list.
      586   define buffer buf_bar-code         for ub.bar-code.
      587   define buffer buf_goods            for ub.goods.
      588   define buffer buf_root_gds-prt     for ub.gds-prt.
      589   define buffer buf_gds-prt          for ub.gds-prt.
      590   find first buf_price-doc no-lock
      591        where recid( buf_price-doc ) = p-price-doc-recid
      592   .
      593   find first buf_goods no-lock
      594        where buf_goods.gds-code = p-gds-code
      595   .
      596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      597     (input  p-gds-code
      598     ,input  ?
      599     ,output v-b-code
      600     ) no-error .
      601   if error-status :error
      602   then do:
      603       message
      604           "Не найден основной бар-код"
      605           skip "для товара "
      606           skip string(buf_goods.artic)
      607           skip buf_goods.gds-name
      608       view-as alert-box
      609       title "Ошибка при выполнении prcreate.i".
      610       undo, return error .
      611   end.
      612   find first buf_bar-code no-lock
      613        where buf_bar-code.b-code = v-b-code
      614   no-error.
      615   if error-status :error
      616   then do:
      617       message
      618           "Не найдена запись bar-code"
      619           skip "для товара "
      620           skip string(buf_goods.artic)
      621           skip buf_goods.gds-name
      622           skip "С основным бар-кодом"
      623           skip string(v-b-code)
      624       view-as alert-box
      625       title "Ошибка при выполнении prcreate.i".
      626       undo, return error .
      627   end.
      628   find first buf_root_gds-prt no-lock
      629        where buf_root_gds-prt.upper-code = buf_goods.prt-root
      630   .
      631   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
      632     and buf_bar-code.in-code <> ""
      633   then do:
      634       message
      635           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
      636           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
      637           view-as alert-box error.
      638       undo, return error.
      639   end.
      640   find first buf_gds-prt no-lock
      641        where buf_gds-prt.node-code = buf_bar-code.node-code
      642   .
      643   find first buf_price-list
      644        where buf_price-list.doc-num = buf_price-doc.doc-num
      645          and buf_price-list.b-code  = v-b-code
      646   no-error.
      647   if available buf_price-list
      648   then do:
      649       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
      650          skip "  Цена:   " buf_price-list.price-sale
      651          skip "Цена будет изменена"
      652       view-as alert-box warning.
      653       assign
      654           p-update = yes
      655       .
      656   end.
      657   else do:
      658   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      660     (input  buf_price-doc.obj-type
      661     ,input  buf_price-doc.obj-code
      662     ,output p-hostcode
      663     ) no-error .
      664   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      666     (input  buf_goods.gds-code
      667     ,input  '1':U
      668     ,input  ?
      669     ,input  p-hostcode
      670     ,input  buf_price-doc.obj-type
      671     ,input  buf_price-doc.obj-code
      672     ,output local_vat-pc
      673     ) no-error .
      674   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      676     (input  buf_goods.gds-code
      677     ,input  '2':U
      678     ,input  ?
      679     ,input  p-hostcode
      680     ,input  buf_price-doc.obj-type
      681     ,input  buf_price-doc.obj-code
      682     ,output local_slt-pc
      683     ) no-error .
      684       kk = kk + 1.
      685   define variable v-main-bar-code as integer   no-undo .
      686   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      687     (input  buf_goods.gds-code
      688     ,input  ?
      689     ,output v-main-bar-code
      690     )  .
      691       create buf_price-list.
      692       assign
      693           buf_price-list.line-num    = kk
      694           buf_price-list.doc-num     = buf_price-doc.doc-num
      695           buf_price-list.b-code      = buf_bar-code.b-code
      696           buf_price-list.artic       = buf_goods.artic
      697           buf_price-list.prod-type   = buf_goods.prod-type
      698           buf_price-list.prod-code   = buf_goods.prod-code
      699           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
      700           buf_price-list.calc-method = 'Отсутствует':U
      701           buf_price-list.obj-type    = buf_price-doc.obj-type
      702           buf_price-list.obj-code    = buf_price-doc.obj-code
      703           buf_price-list.price-sale  = p-price-sale
      704           buf_price-list.vat-pc      = local_vat-pc
      705           buf_price-list.slt-pc      = local_slt-pc
      706           p-update                   = no
      707       .
      708   end.
      709   end.
      710   end procedure.
      711   procedure create_new_price-doc-forming :
      712   define input  parameter p-obj-type   as character no-undo .
      713   define input  parameter p-obj-code   as integer   no-undo .
      714   define output parameter p-pdf-db-num as integer   no-undo .
      715   define output parameter p-pdf-id     as integer   no-undo .
      716   define output parameter p-plt-db-num as integer   no-undo .
      717   define output parameter p-plt-id     as integer   no-undo .
      718   define buffer buf_price-list-type for ub.price-list-type  .
      719   define variable v-host-code  as integer   no-undo .
      720   define variable v-base-rate  as decimal   no-undo .
      721   define variable v-base-scale as integer   no-undo .
      722   define variable v-exch-rate  as decimal   no-undo .
      723   define variable v-exch-scale as integer   no-undo .
      724   define variable v-base as logical   no-undo .
      725     do
