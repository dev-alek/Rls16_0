     6945   define variable bbb   as logical no-undo .
     6946   define variable l-price-sale like ub.price-list.price-sale no-undo .
     6947   define variable l-road-tax   like ub.price-list.road-tax   no-undo .
     6948   define variable l-excise     like ub.price-list.excise     no-undo .
     6949   define variable l-ok          as logical no-undo .
     6950   define variable check-par     as logical no-undo .
     6951   define variable main-b-code   as integer no-undo .
     6952   define variable par-pr-equ-dq as integer no-undo .
     6953   define variable v-price-sale  as decimal no-undo .
     6954   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6955   empty temp-table thbjattr_thbj-attr.
     6956   run adm/shattri.p (
     6957      input "get":U
     6958     ,input v-cntxt-obj-type
     6959     ,input v-cntxt-obj-code
     6960     ,input 'overval':U
     6961     ,input  ""
     6962     ,output v-value-character
     6963     ,output v-value-date
     6964     ,output v-value-decimal
     6965     ,output v-value-integer
     6966     ,output v-value-logical
     6967     ,output par-type
     6968     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6969     ) no-error .
     6970   for each thbjattr_thbj-attr :
     6971       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     6972   end.
     6973   if par-pr-equ-dq = 1 then return .
     6974   for each pdf_price-list exclusive-lock where
     6975            pdf_price-list.plt-id     = p-plt-id     and
     6976            pdf_price-list.plt-db-num = p-plt-db-num and
     6977            pdf_price-list.pdf-id     = p-pdf-id     and
     6978            pdf_price-list.pdf-db     = p-pdf-db     by pdf_price-list.line-num
     6979           :
     6980       if not (pdf_price-list.b-code     = f-base-code (pdf_price-list.b-code) ) then next .
     6981       check-par = false .
     6982      find first x_obj-group no-error .
     6983   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     6985     (input  x_obj-group.obj-type
     6986     ,input  x_obj-group.obj-code
     6987     ,input  pdf_price-list.b-code
     6988     ,input  0
     6989     ,input  0
     6990     ,output l-doc-num2
     6991     ,output l-price-sale
     6992     ,output l-road-tax
     6993     ,output l-excise
     6994     ) no-error .
     6995       v-price-sale = l-price-sale .
     6996      for each x_obj-group :
     6997   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     6999     (input  x_obj-group.obj-type
