      894                    old_price-list.doc-num    = v-cur-dn and
      895                    old_price-list.artic      = buf_goods.artic and
      896                    old_price-list.prod-type  = buf_goods.prod-type and
      897                    old_price-list.prod-code  = buf_goods.prod-code and
      898                    old_price-list.main-price = no,
      899                   first buf_bar-code no-lock where
      900                         buf_bar-code.b-code   = old_price-list.b-code and
      901                         buf_bar-code.in-code  = "" and
      902                         buf_bar-code.unit-cli = buf_goods.unit-base
      903                         :
      904                          run check-use-bar-code (buf_bar-code.b-code) no-error .
      905                          if error-status :error then next.
      906                    run create-line-pdf-mpl-lib (
      907                          input buf_price-doc-forming.plt-db-num
      908                         ,input buf_price-doc-forming.plt-id
      909                         ,input buf_price-doc-forming.pdf-db
      910                         ,input buf_price-doc-forming.pdf-id
      911                         ,input p-line-num
      912                         ,input old_price-list.b-code
      913                         ,input buf_goods.artic
      914                         ,input buf_goods.prod-type
      915                         ,input buf_goods.prod-code
      916                         ,input ""
      917                         ,input 0
      918                         ,input old_price-list.price-sale
      919                         ,input ""
      920                         ,input 0
      921                       ,input-output v-sec ) no-error .
      922           end.
      923       end.
