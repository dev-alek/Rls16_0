     9977   end.
     9978   find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = doc-line.doc-code and
     9979                                     bf_doc-line-attr.gds-code  = goods.gds-code    and
     9980                                     bf_doc-line-attr.attr-code = 'price-prod':U    no-error.
     9981   if not available bf_doc-line-attr and i-price-prod <> 0 then do:
     9982      create bf_doc-line-attr.
     9983      assign
     9984        bf_doc-line-attr.doc-code   = doc-line.doc-code
     9985        bf_doc-line-attr.gds-code   = goods.gds-code
     9986        bf_doc-line-attr.attr-code  = 'price-prod':U
