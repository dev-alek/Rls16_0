     6323                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     6324                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     6325                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     6326                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     6327                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     6328                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6329                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6330                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6331                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     6332                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6333                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6334                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6335                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     6336                         .
     6337         end.
     6338         ASSIGN
     6339           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6340           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6341           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6342           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6343           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6344           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6345                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     6346           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     6347                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     6348           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     6349           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     6350           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     6351         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     6352         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     6353         if transport-base-loc = ? then transport-base-loc = 0.
     6354         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     6355         if other-base-loc     = ? then other-base-loc     = 0.
     6356         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     6357         assign
     6358           transport-cli-loc      = 0
     6359           other-cli-loc          = 0
     6360           road-tax-cli-loc       = ?
     6361           vat-cli-loc            = ?
     6362           slt-cli-loc            = ?
     6363           price-cli-with-tax-loc = ?.
     6364      end.
     6365   ASSIGN
     6366             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6367       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6368   .
     6369                 assign
     6370                   p-road-tax-rubl =  road-tax-rubl-loc
     6371                   p-road-tax-base =  road-tax-base-loc
     6372                   .
     6373               end.
     6374         end.
     6375     end.
     6376   end procedure.
     6377   procedure calc-sigma :
     6378    do
     6379    on error undo, return error return-value
     6380    :
     6381   define input parameter l-bcode like ub.price-list.b-code no-undo .
     6382   define input-output parameter new-price as decimal no-undo .
     6383   define input parameter l-host as integer no-undo .
     6384   define input parameter l-code as integer no-undo .
     6385   define input parameter l-type as character no-undo .
     6386   define output parameter p-ret as logical no-undo .
     6387   define variable conf-par     as character no-undo.
     6388   define variable par-type     as character no-undo.
     6389   define variable i-sigma as decimal no-undo .
     6390   define variable cur-pr like ub.price-list.price-sale no-undo.
     6391   define variable cur-rt like ub.price-list.road-tax   no-undo.
     6392   define variable cur-ex like ub.price-list.excise     no-undo.
     6393   define variable cur-dn like ub.price-list.doc-num    no-undo.
     6394   define variable old-price as decimal no-undo .
     6395   p-ret = true  .
     6396   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     6397   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     6399     (input  l-type
     6400     ,input  l-code
     6401     ,input  l-bcode
     6402     ,input  0
     6403     ,input  0
     6404     ,output cur-dn
     6405     ,output cur-pr
     6406     ,output cur-rt
     6407     ,output cur-ex
     6408     )  .
     6409   old-price = cur-pr .
     6410   if old-price =  new-price then do:
     6411      p-ret = true .
     6412      return.
     6413   end.
     6414      i-sigma = decimal(par-pr-sigma) .
     6415      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     6416          p-ret = false .
     6417          new-price = old-price.
     6418          end.
     6419      else p-ret = true .
     6420   end.
     6421    end.
     6422   end procedure.
     6423   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6424   define variable var-pr-r-b as character no-undo .
     6425   define variable v-str2 as character no-undo .
     6426   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6427   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6428     (output var-pr-r-b
     6429     )  .
     6430   function f-base-code return integer ( p-b-code as integer ).
     6431     define variable main-b-code as integer   no-undo .
     6432     define buffer buf_bar-code for ub.bar-code  .
     6433     find first buf_bar-code no-lock where
     6434               buf_bar-code.b-code = p-b-code no-error .
     6435   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6436     (input  buf_bar-code.gds-code
     6437     ,input  ?
     6438     ,output main-b-code
     6439     )  .
     6440     return (main-b-code).
     6441   end function.
     6442   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     6443     define variable f-cost     as decimal no-undo .
     6444     define variable f-cost-pc  as decimal no-undo .
     6445     define variable v-qnty     as decimal no-undo .
     6446     define variable v-sum      as decimal no-undo .
     6447     define variable fact_price as decimal no-undo .
     6448     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     6449                               ub.goods.prod-type = local-price-list.prod-type and
     6450                               ub.goods.prod-code = local-price-list.prod-code no-lock
     6451                               no-error .
     6452     assign
     6453       v-sum  =  0
     6454       v-qnty =  0
     6455       .
     6456     for each x_obj-group :
     6457         find ub.gds-obj no-lock where
     6458             ub.gds-obj.gds-code = ub.goods.gds-code and
     6459             ub.gds-obj.obj-type = x_obj-group.obj-type and
     6460             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     6461         if  available ub.gds-obj then
     6462           if ub.goods.gds-type = 'т':U then
     6463             assign
     6464               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     6465               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     6466               .
     6467             else  v-sum = ?.
     6468         else v-sum = ?.
     6469     end.
     6470     f-cost = v-sum / v-qnty .
     6471     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     6472     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     6473     return (f-cost-pc).
     6474   end function.
     6475   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     6476   define variable f-pr     as decimal no-undo .
     6477   define variable f-pr-pc  as decimal no-undo.
     6478   define variable v-qnty as decimal   no-undo .
     6479   define variable v-sum as decimal   no-undo .
     6480   define variable fact_price as decimal   no-undo .
     6481   find first ub.goods where ub.goods.artic = local-price-list.artic and
     6482                          ub.goods.prod-type = local-price-list.prod-type and
     6483                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     6484    assign
     6485      v-sum  =  0
     6486      v-qnty =  0
     6487      .
     6488   for each x_obj-group :
     6489   find ub.gds-obj no-lock where
     6490        ub.gds-obj.gds-code = ub.goods.gds-code and
     6491        ub.gds-obj.obj-type = x_obj-group.obj-type and
     6492        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     6493   if  available ub.gds-obj then do:
     6494     if ub.goods.gds-type = 'т':U then
     6495       assign
     6496         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     6497         .
     6498       else f-pr = ?.
     6499   end.
     6500   else f-pr = ?.
     6501   end.
     6502     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     6503     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     6504     return (f-pr-pc).
     6505   end function.
     6506   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     6507   define variable f-cost   as decimal no-undo .
     6508   find first  x_obj-group.
     6509   find first ub.goods where ub.goods.artic = local-price-list.artic and
     6510                          ub.goods.prod-type = local-price-list.prod-type and
     6511                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     6512   find ub.gds-obj no-lock where
     6513        ub.gds-obj.gds-code = ub.goods.gds-code  and
     6514        ub.gds-obj.obj-type = x_obj-group.obj-type and
     6515        ub.gds-obj.obj-code = x_obj-group.obj-code
     6516        no-error.
     6517   if  available ub.gds-obj then
     6518     if ub.goods.gds-type = 'т':U then
     6519       assign
     6520         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     6521         .
     6522       else  f-cost = ?.
     6523   else f-cost = ?.
     6524     return ( f-cost ).
     6525   end function.
     6526   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     6527   define variable f-pr   as decimal no-undo .
     6528   find first x_obj-group .
     6529   find first ub.goods where ub.goods.artic = local-price-list.artic and
     6530                          ub.goods.prod-type = local-price-list.prod-type and
     6531                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     6532   find ub.gds-obj no-lock where
     6533        ub.gds-obj.gds-code = ub.goods.gds-code and
     6534        ub.gds-obj.obj-type = x_obj-group.obj-type and
     6535        ub.gds-obj.obj-code = x_obj-group.obj-code
     6536        no-error.
     6537   if  available ub.gds-obj then
     6538     if ub.goods.gds-type = 'т':U then
     6539       assign
     6540         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     6541         .
     6542       else  f-pr = ?.
     6543   else f-pr = ?.
     6544      return ( f-pr ).
     6545   end function.
     6546   procedure make-fact-order-lib3 :
     6547   define input  parameter p-recid as recid no-undo .
     6548   define output parameter p-fact-order-sys-from as decimal   no-undo .
     6549   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     6550   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     6551   define buffer buf_price-list-type for ub.price-list-type  .
     6552   define variable v-shift-end-fact-order as decimal no-undo .
     6553   define variable v-day-end-fact-order   as decimal no-undo .
     6554   define variable v-fact-order           as decimal no-undo .
     6555     do
     6556     on error undo, return error return-value
     6557     :
     6558   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     6559     if error-status :error then return error error-status :get-message(1) .
     6560   find first buf_price-list-type  no-lock where
     6561              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     6562              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     6563     if error-status :error then return error error-status :get-message(1) .
     6564    if buf_price-doc-forming.have-start-period = 1 then do:
     6565       case buf_price-list-type.work-date :
     6566         when int('1':U)  then
     6567           do :
     6568              run day-begin-fact-order
     6569                   ( buf_price-doc-forming.start-date ,
     6570                    output p-fact-order-sys-from ) no-error .
     6571                    if error-status :error then
     6572                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     6573                                               error-status :get-message(1) ,
     6574                                               return-value ).
     6575           end.
     6576         when int('2':U)   then
     6577           do :
     6578             run factord (
     6579                input   buf_price-doc-forming.start-shift-date
     6580               ,input   buf_price-doc-forming.sys-time
     6581               ,input   1
     6582               ,input   buf_price-doc-forming.start-shift-date
     6583               ,input   buf_price-doc-forming.start-shift-num
     6584               ,input   true
     6585               ,output  p-fact-order-sys-from
     6586               ,output  v-shift-end-fact-order
     6587               ,output  v-day-end-fact-order
     6588               ) no-error  .
     6589               if error-status :error then
     6590                    return error substitute ( "Ошибка из factord &1 &2" ,
     6591                                               error-status :get-message(1) ,
     6592                                               return-value ).
     6593           end.
     6594         when int('3':U)   then
     6595           do :
     6596             run factord (
     6597               input    buf_price-doc-forming.start-sys-date
     6598               ,input   buf_price-doc-forming.start-sys-time
     6599               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     6600               ,input   ?
     6601               ,input   ?
     6602               ,input   false
     6603               ,output  p-fact-order-sys-from
     6604               ,output  v-shift-end-fact-order
     6605               ,output  v-day-end-fact-order
     6606               ) no-error .
     6607               if error-status :error then
     6608                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     6609                                               error-status :get-message(1) ,
     6610                                               return-value ).
     6611           end.
     6612       end case.
     6613     end.
     6614    if buf_price-doc-forming.have-end-period = 1 then do:
     6615       case buf_price-list-type.work-date :
     6616         when int('1':U)   then
     6617           do :
     6618              run factord-end-day
     6619                 ( buf_price-doc-forming.end-date ,
     6620                   output p-fact-order-sys-to ) no-error .
     6621                   if error-status :error then
     6622                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     6623                                               error-status :get-message(1) ,
     6624                                               return-value ).
     6625           end.
     6626         when int('2':U)   then
     6627           do :
     6628             run factord (
     6629                input   buf_price-doc-forming.end-shift-date
     6630               ,input   buf_price-doc-forming.sys-time
     6631               ,input   1
     6632               ,input   buf_price-doc-forming.end-shift-date
     6633               ,input   buf_price-doc-forming.end-shift-num
     6634               ,input   true
     6635               ,output  v-fact-order
     6636               ,output  p-fact-order-sys-to
     6637               ,output  v-day-end-fact-order
     6638               ) no-error .
     6639               if error-status :error then
     6640                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     6641                                           error-status :get-message(1) ,
     6642                                           return-value ).
     6643           end.
     6644         when int('3':U)   then
     6645           do :
     6646             run factord (
     6647                input   buf_price-doc-forming.end-sys-date
     6648               ,input   buf_price-doc-forming.end-sys-time
     6649               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     6650               ,input   ?
     6651               ,input   ?
     6652               ,input   false
     6653               ,output  p-fact-order-sys-to
     6654               ,output  v-shift-end-fact-order
     6655               ,output  v-day-end-fact-order
     6656               ) no-error .
     6657               if error-status :error then
     6658                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     6659                                           error-status :get-message(1) ,
     6660                                           return-value ).
     6661           end.
     6662       end case.
     6663     end.
     6664     end.
     6665   end procedure.
     6666   procedure ver-dfc-mpl-lib3 :
     6667   define input  parameter p-recid as recid no-undo .
     6668   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     6669   define buffer buf_price-list-type for ub.price-list-type  .
     6670   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     6671   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     6672   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     6673   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     6674   define variable v-fact-order-sys-from   as decimal   no-undo .
     6675   define variable v-fact-order-sys-to     as decimal   no-undo .
     6676     do
     6677     on error undo, return error return-value
     6678    :
     6679   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     6680     if error-status :error then return error error-status :get-message(1) .
     6681   find first buf_price-list-type  no-lock where
     6682              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     6683              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     6684     if error-status :error then return error error-status :get-message(1) .
     6685     if buf_price-list-type.stts = integer('1':U) then do:
     6686        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     6687     end.
     6688     if buf_price-list-type.bgr-id > 0 then do:
     6689         find ub.buyer-group where
     6690               ub.buyer-group.stts       = 0  and
     6691               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     6692               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     6693               no-lock no-error .
     6694         if not available ub.buyer-group then
     6695         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     6696     end.
     6697     if buf_price-list-type.sgr-id > 0 then do:
     6698         find ub.sum-group where
     6699               ub.sum-group.stts       = 0  and
     6700               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     6701               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     6702               no-lock no-error .
     6703         if not available ub.sum-group then
     6704         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     6705     end.
     6706     if buf_price-list-type.qgr-id > 0 then do:
     6707         find ub.qnty-group where
     6708              ub.qnty-group.stts       = 0  and
     6709              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     6710              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     6711              no-lock no-error .
     6712         if not available ub.qnty-group then
     6713         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     6714     end.
     6715     if buf_price-list-type.tog-id > 0 then do:
     6716         find ub.turnover-group where
     6717              ub.turnover-group.stts       = 0  and
     6718              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     6719              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     6720             no-lock no-error .
     6721         if not available ub.turnover-group then
     6722         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     6723     end.
     6724     if buf_price-list-type.gop-id > 0 then do:
     6725         find ub.grp-obj-price where
     6726               ub.grp-obj-price.stts       = 0  and
     6727               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num and
     6728               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id
     6729               no-lock no-error .
     6730         if not available ub.grp-obj-price then
     6731         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id,buf_price-list-type.gop-db-num )  .
     6732     end.
     6733     if buf_price-list-type.gop-id-for-calc-turnover > 0 then do:
     6734         find ub.grp-obj-price where
     6735               ub.grp-obj-price.stts       = 0  and
     6736               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num-for-calc-turnover and
     6737               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id-for-calc-turnover
     6738               no-lock no-error .
     6739         if not available ub.grp-obj-price then
     6740         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id-for-calc-turnover,buf_price-list-type.gop-db-num-for-calc-turnover )  .
     6741     end.
     6742      if buf_price-doc-forming.have-start-period = integer(true) then do:
     6743         case buf_price-list-type.work-date :
     6744             when int('1':U)     then
     6745               do :
     6746                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     6747               end.
     6748             when int('2':U)   then
     6749               do :
     6750                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
     6751                   if buf_price-doc-forming.start-shift-num  = ? or
     6752                      buf_price-doc-forming.start-shift-num = 0  then return error "Не задан порядок смены начала действия цен !" .
     6753               end.
     6754             when int('3':U)     then
     6755               do :
     6756                   if buf_price-doc-forming.start-sys-date = ? then return error "Не задана дата начала действия цен !" .
     6757                   if buf_price-doc-forming.start-sys-time = ? then return error "Не задано время начала действия цен !" .
     6758               end.
     6759         end case.
     6760      end.
     6761      if buf_price-doc-forming.have-end-period = integer(true) then do:
     6762         case buf_price-list-type.work-date :
     6763             when int('1':U)     then
     6764               do :
     6765                  if buf_price-doc-forming.end-date = ? then return error "Не задана дата окончания действия цен !" .
     6766               end.
     6767             when int('2':U)   then
     6768               do :
     6769                   if buf_price-doc-forming.end-shift-date = ? then return error "Не задана сменная дата окончания действия цен !" .
     6770                   if buf_price-doc-forming.end-shift-num  = ? or
     6771                      buf_price-doc-forming.end-shift-num = 0  then return error "Не задан порядок смены окончания  действия цен !" .
     6772               end.
     6773             when int('3':U)     then
     6774               do :
     6775                   if buf_price-doc-forming.end-sys-date = ? then return error "Не задана дата окончания действия цен !" .
     6776                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     6777               end.
     6778         end case.
     6779      end.
     6780      if buf_price-doc-forming.have-start-period = integer(true) and
     6781         buf_price-doc-forming.have-end-period = integer(true) then do:
     6782         case buf_price-list-type.work-date :
     6783             when int('1':U)     then
     6784               do :
     6785                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     6786               end.
     6787             when int('2':U)   then
     6788               do :
     6789                   if buf_price-doc-forming.end-shift-date < buf_price-doc-forming.start-shift-date then return error "Не верно задан интервал дат !" .
     6790                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     6791                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     6792                   end.
     6793               end.
     6794             when int('3':U)     then
     6795               do :
     6796                   if buf_price-doc-forming.end-sys-date < buf_price-doc-forming.start-sys-date then return error "Не верно задан интервал дат !" .
     6797                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     6798                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     6799                   end.
     6800               end.
     6801         end case.
     6802      end.
     6803   if buf_price-doc-forming.name = "" then return error "Не задано название ДНЦ !" .
     6804   if buf_price-list-type.main = false then do:
     6805       run make-fact-order-lib3 in this-procedure
     6806           ( input  p-recid ,
     6807             output v-fact-order-sys-from ,
     6808             output v-fact-order-sys-to   ) .
     6809   end.
     6810   define variable old-price as decimal   no-undo .
     6811   define variable v-kol-rec as integer   no-undo .
     6812   define variable v-gds-null-price as character no-undo initial "" .
     6813   define variable v-type as character no-undo .
     6814   v-kol-rec = 0.
     6815   for each buf_price-doc-forming-gds no-lock where
     6816            buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
     6817            buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
     6818            buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
     6819            buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      :
     6820       find first ub.bar-code no-lock where
     6821                  ub.bar-code.b-code = buf_price-doc-forming-gds.b-code no-error .
     6822                  if error-status :error then return error substitute ("Не найден бар-код &1" ,  buf_price-doc-forming-gds.b-code ) .
     6823       find first ub.goods no-lock where
     6824                  ub.goods.artic = buf_price-doc-forming-gds.artic         and
     6825                  ub.goods.prod-type = buf_price-doc-forming-gds.prod-type and
     6826                  ub.goods.prod-code = buf_price-doc-forming-gds.prod-code no-error .
     6827                  if error-status :error then return error substitute ("Не найден товар &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     6828       if ub.bar-code.gds-code <> ub.goods.gds-code then return error substitute ("Бар-код &4 не соответствует товару &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.b-code ) .
     6829       run gds-attr-value in this-procedure (input ub.goods.gds-code
     6830                                            ,input 'null-price':U
     6831                                            ,output v-gds-null-price
     6832                                            ,output v-type ) no-error .
     6833       if buf_price-doc-forming-gds.price-sale-doc   = ? or (buf_price-doc-forming-gds.price-sale-doc   = 0 and not logical(v-gds-null-price) )
     6834                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-doc  ) .
     6835       if buf_price-doc-forming-gds.price-sale-rubl  = ? or (buf_price-doc-forming-gds.price-sale-rubl  = 0 and not logical(v-gds-null-price) )
     6836                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-rubl ) .
     6837       if buf_price-doc-forming-gds.price-sale-base  = ? or (buf_price-doc-forming-gds.price-sale-base  = 0 and not logical(v-gds-null-price) )
     6838                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-base ) .
     6839       if buf_price-doc-forming-gds.slt-pc = ? then return error substitute ("НсП по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     6840       if buf_price-doc-forming-gds.vat-pc = ? then return error substitute ("НДС по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     6841   old-price = ? .
