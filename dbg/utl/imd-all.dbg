     3712   define variable v-plt-db-num   as integer   no-undo .
     3713   define variable v-pdf-id       as integer   no-undo .
     3714   define variable v-pdf-db-num   as integer   no-undo .
     3715   define variable v-plt-id2      as integer   no-undo .
     3716   define variable v-plt-db-num2  as integer   no-undo .
     3717   define variable v1-recid       as recid no-undo .
     3718   define variable v1-cur-rt      as decimal   no-undo .
     3719   define variable v1-cur-ex      as decimal   no-undo .
     3720   define variable v1 as integer   no-undo .
     3721   define variable v2 as integer   no-undo .
     3722   define variable v3 as integer   no-undo .
