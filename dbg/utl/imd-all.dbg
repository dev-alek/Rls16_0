     4413         .
     4414         if vd = 0 or vd = ?  then do:
     4415           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4416                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4417                   "- расчет по производителю от последней приходной накладной невозможен."
     4418                   view-as alert-box  .
     4419         end.
     4420         else do:
     4421             cost-rubl = vd .
     4422             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4423             p-new-calc-method = p-calc-method .
     4424         end.
     4425       end.
     4426      when 'Спецификация':U
     4427      then do:
     4428         find first x_obj-group.
     4429         assign
     4430           v-num-specif    = 0
     4431           v-contract-code = 0
     4432         .
     4433         for each buf_contract no-lock
     4434         where buf_contract.host-code = v-cntxt-host-code-obj
     4435         :
     4436   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4437   ASSIGN
     4438      i-gl-Host-Code      = 0
     4439      i-gl-Contract-Code  = 0
     4440      i-gl-Extent3        = 0
     4441      .
     4442   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4443       INPUT  v-cntxt-host-code-obj,
     4444       INPUT  buf_contract.contract-code,
     4445       OUTPUT i-gl-Extent3
     4446      ).
     4447   IF i-gl-Extent3[1] = 2 THEN DO:
     4448      ASSIGN
     4449         i-gl-Host-Code      = i-gl-Extent3[2]
     4450         i-gl-Contract-Code  = i-gl-Extent3[3]
     4451         .
     4452   END. ELSE DO:
     4453      ASSIGN
     4454         i-gl-Host-Code      = v-cntxt-host-code-obj
     4455         i-gl-Contract-Code  = buf_contract.contract-code
     4456         .
     4457   END.
     4458   FOR EACH
     4459       buf_contract-specif
     4460        NO-LOCK
     4461        WHERE
     4462            buf_contract-specif.Host-code    = i-gl-Host-Code
     4463        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     4464              :
     4465               if buf_contract-specif.gds-code = p-gds-code then do:
     4466                 assign
     4467                   v-num-specif = v-num-specif + 1
     4468                   v-contract-code = buf_contract.contract-code
     4469                 .
     4470               end.
     4471           end.
     4472         end.
     4473         if v-num-specif > 1 then do:
     4474            run str/gds-cnts.w
     4475               (input parparentproc
     4476               ,input p-gds-code
     4477               , "b-sel":U
     4478               ,output v-spis
     4479             ) no-error.
     4480           find first buf_contract-specif no-lock
     4481           where recid(buf_contract-specif) = integer(v-spis)
     4482             no-error.
     4483             if available buf_contract-specif then do:
     4484                 run read-bonus (
     4485                     input  buf_contract-specif.contract-num  ,
     4486                     input  buf_contract-specif.host-code     ,
     4487                     input  buf_contract-specif.gds-code      ,
     4488                     output v-bonus  ) .
     4489                 assign
     4490                   cost-rubl = buf_contract-specif.price-cli
     4491                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     4492                   p-new-calc-method = 'Спецификация':U
     4493                 .
     4494                 if v-bonus <> ? and v-bonus <> 0 then do:
     4495                    assign
     4496                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     4497                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     4498                    .
     4499                 end.
     4500             end.
     4501             else do:
     4502               message "Не найдена спецификация с recid " v-spis skip
     4503                       "для товара с артикулом " p-artic skip
     4504                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     4505                       view-as alert-box information .
     4506             end.
     4507         end.
     4508         if v-num-specif = 0 then do:
     4509             message "Не найдена ни одна спецификация" skip
     4510                     "для товара с артикулом " p-artic skip
     4511                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     4512                     view-as alert-box information .
     4513         end.
     4514         if v-num-specif = 1 then do:
     4515   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4516   ASSIGN
     4517      i-gl-Host-Code      = 0
     4518      i-gl-Contract-Code  = 0
     4519      i-gl-Extent3        = 0
     4520      .
     4521   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4522       INPUT  v-cntxt-host-code-obj,
     4523       INPUT  v-contract-code,
     4524       OUTPUT i-gl-Extent3
     4525      ).
     4526   IF i-gl-Extent3[1] = 2 THEN DO:
     4527      ASSIGN
     4528         i-gl-Host-Code      = i-gl-Extent3[2]
     4529         i-gl-Contract-Code  = i-gl-Extent3[3]
     4530         .
     4531   END. ELSE DO:
     4532      ASSIGN
     4533         i-gl-Host-Code      = v-cntxt-host-code-obj
     4534         i-gl-Contract-Code  = v-contract-code
     4535         .
     4536   END.
     4537   FOR EACH
     4538       buf_contract-specif
     4539        NO-LOCK
     4540        WHERE
     4541            buf_contract-specif.Host-code    = i-gl-Host-Code
     4542        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     4543               :
     4544               if buf_contract-specif.gds-code = p-gds-code then do:
     4545                 run read-bonus (
     4546                     input  buf_contract-specif.contract-num  ,
     4547                     input  buf_contract-specif.host-code     ,
     4548                     input  buf_contract-specif.gds-code      ,
     4549                     output v-bonus  ) .
     4550                 assign
     4551                   cost-rubl = buf_contract-specif.price-cli
     4552                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     4553                   p-new-calc-method = 'Спецификация':U
     4554                 .
     4555                 if v-bonus <> ? and v-bonus <> 0 then do:
     4556                    assign
     4557                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     4558                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     4559                    .
     4560                 end.
     4561               end.
     4562             end.
     4563         end.
     4564      end.
     4565      otherwise do:
     4566        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     4567                  p-new-calc-method  skip
     4568                 "p-price-prev-doc " p-price-prev-doc  skip
     4569                 "mpl-lib ERR !!! " skip
     4570                 'артикул ' p-artic skip
     4571                 view-as alert-box information .
     4572      end.
     4573    end case.
     4574   run main-road-taxs in this-procedure
     4575     ( input p-artic     ,
     4576       input p-prod-type ,
     4577       input p-prod-code ,
     4578       input-output cur-rt-base ,
     4579       input-output cur-rt-rubl )
     4580       .
     4581     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     4582       return error "Не определен курс валюты документа" .
     4583     end.
     4584     if p-base-scale = 0  or  p-base-scale = ?  then do:
     4585        return error "Не определен курс базовой валюты " .
     4586     end.
     4587   if v-base = false then var-pr-r-b = "rubl":U .
     4588                     else var-pr-r-b =  "base":U .
     4589       if var-pr-r-b = "rubl":U then do:
     4590            case p-calc-method :
     4591            when 'ПорогПр-НДС':U then do:
     4592               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     4593            end.
     4594            when 'ПорогПр+НДС':U then do:
     4595               p-price-sale-rubl  =  cost-rubl .
     4596            end.
     4597            when  'Производит':U then do:
     4598               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     4599            end.
     4600            when  'Произв-НДС':U then do:
     4601               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     4602            end.
     4603            otherwise do:
     4604               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     4605            end.
     4606           end case.
     4607           assign
     4608             p-price-calc-rubl  =  cost-rubl
     4609             p-road-tax-rubl    =  cur-rt-rubl
     4610             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4611             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4612             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4613           .
     4614       end.
     4615       else do:
     4616            case p-calc-method:
     4617               when 'ПорогПр-НДС':U then do:
     4618                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     4619               end.
     4620               when 'ПорогПр+НДС':U then do:
     4621                   p-price-sale-base  =  cost-base .
     4622               end.
     4623               when 'Производит':U then do:
     4624                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     4625               end.
     4626               when 'Произв-НДС':U then do:
     4627                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     4628               end.
     4629               otherwise do:
     4630                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     4631               end.
     4632            end case.
     4633           assign
     4634             p-price-calc-base  =  cost-base
     4635             p-road-tax-base    =  cur-rt-base
     4636             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     4637             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     4638             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     4639             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4640             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4641             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4642           .
     4643       end.
     4644      if p-price-sale-doc <> 0 then do:
     4645   case p-round-method :
     4646     when '9-окончание':U then do:
     4647       if p-price-sale-doc < 29 then do:
     4648         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     4649           assign
     4650             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     4651           .
     4652         end.
     4653       end.
     4654       else do:
     4655         if (p-price-sale-doc modulo 10) < 3 then do:
     4656           assign
     4657             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4658                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4659                   - 1 ) * 10
     4660                 + 9
     4661           .
     4662         end.
     4663         else do:
     4664           assign
     4665             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4666                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4667                   ) * 10
     4668                 + 9
     4669           .
     4670         end.
     4671         assign
     4672           p-price-sale-doc = round (p-price-sale-doc, 0)
     4673         .
     4674       end.
     4675     end.
     4676     when '9-99окончание':U then do:
     4677       if p-price-sale-doc < p-round-base then do:
     4678         assign
     4679           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     4680         .
     4681       end.
     4682       else do:
     4683         assign
     4684           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     4685         .
     4686       end.
     4687     end.
     4688     when 'Без-дробных':U then do:
     4689       assign
     4690         p-price-sale-doc = round (p-price-sale-doc, 0)
     4691       .
     4692     end.
     4693     when 'Произвольно':U then do:
     4694       if p-round-base <> 0 then do:
     4695         assign
     4696           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     4697         .
     4698         if p-price-sale-doc = 0 then do:
     4699           assign
     4700             p-price-sale-doc = p-round-base
     4701           .
     4702         end.
     4703       end.
     4704     end.
     4705     when 'Вверх':U then do:
     4706       if p-round-base <> 0 then do:
     4707         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     4708           assign
     4709             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     4710           .
     4711         end.
     4712       end.
     4713       if p-price-sale-doc = 0 then do:
     4714         assign
     4715           p-price-sale-doc = p-round-base
     4716         .
     4717       end.
     4718     end.
     4719     when 'Коэффициент':U then do:
     4720       if p-round-base <> 0 then do:
     4721         assign
     4722           p-price-sale-doc = p-price-sale-doc * p-round-base
     4723         .
     4724       end.
     4725     end.
     4726     when 'Отключено':U then do:
     4727     end.
     4728     otherwise do:
     4729       message
     4730         vss-workfile vss-revision vss-description skip
     4731         "Неизвестный метод округления продажной цены" skip
     4732         "round-method" p-round-method skip
     4733         "round-base"   p-round-base   skip
     4734         "price"        p-price-sale-doc             skip
     4735         view-as alert-box error .
     4736     end.
     4737   end.
     4738     end.
     4739     assign
     4740       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     4741       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     4742       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     4743       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     4744      .
     4745     assign
     4746       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     4747       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     4748       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     4749       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     4750     .
     4751     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     4752     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     4753     p-prev-doc-code = if available bufold_price-doc-forming
     4754                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     4755                          else "" .
     4756   END PROCEDURE.
     4757   PROCEDURE create-line :
     4758   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     4759   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     4760   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     4761   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     4762   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     4763   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     4764   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     4765   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
