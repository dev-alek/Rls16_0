     6066   procedure main-road-taxs :
     6067   define input param p-artic     like ub.gds-obj.artic     no-undo .
     6068   define input param p-prod-type like ub.gds-obj.prod-type no-undo .
     6069   define input param p-prod-code like ub.gds-obj.prod-code no-undo .
     6070   define input-output param p-road-tax-base as decimal no-undo .
     6071   define input-output param p-road-tax-rubl as decimal no-undo .
     6072       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     6073       define buffer   in-vatp-parts    for ub.parts   .
     6074       define buffer   in-vatp-doc      for ub.trn-doc .
     6075       define buffer   in-vatp-goods    for ub.goods   .
     6076       define buffer   in-vatp-sysconf  for ub.sysconf .
     6077       define buffer   in-vatp_doc-attr for ub.doc-attr.
     6078       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     6079       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     6080       define variable varinvprb                  as   character              no-undo.
     6081       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     6082       define variable cli-base-rate              as   decimal                no-undo.
     6083       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     6084       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     6085       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     6086       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     6087       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6088       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6089       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6090       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6091       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6092       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6093       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6094       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     6095       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     6096       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6097       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6098       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6099       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6100       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6101       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6102       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6103       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6104       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6105       define variable varinvatp-envd             as   character              no-undo.
     6106       define variable varinvatp-type             as   character              no-undo.
     6107     do
     6108     on error undo, return error return-value
     6109     :
     6110   define buffer buff-goods   for ub.goods    .
     6111   define buffer buf_gds-obj  for ub.gds-obj  .
     6112   define buffer buf_parts    for ub.parts    .
     6113   define buffer buf_trn-doc  for ub.trn-doc  .
     6114   define buffer buf_doc-line for ub.doc-line .
     6115   define variable is-petrolium as logical   no-undo .
     6116   define variable is-pieces   as  logical   no-undo .
     6117   define variable p-in-code   as  character no-undo .
     6118   define variable p-obj-type  as  character no-undo .
     6119   define variable p-obj-code  as  integer   no-undo .
     6120   define variable v-rec as recid no-undo .
     6121   define variable t-ret as logical no-undo .
     6122   define variable v-total-avrg-base as decimal no-undo .
     6123   define variable v-total-avrg-rubl as decimal no-undo .
     6124   define variable v-total-avrg-qnty as decimal no-undo .
     6125   define variable v-total-road-tax-base     as decimal no-undo .
     6126   define variable v-total-road-tax-rubl     as decimal no-undo .
     6127   define variable v-all-total-road-tax-base as decimal no-undo .
     6128   define variable v-all-total-road-tax-rubl as decimal no-undo .
     6129   assign
     6130     p-road-tax-base = 0
     6131     p-road-tax-rubl = 0
     6132     .
     6133     Find first buff-goods no-lock where
     6134                buff-goods.artic     = p-artic and
     6135                buff-goods.prod-type = p-prod-type and
     6136                buff-goods.prod-code = p-prod-code
     6137         no-error .
     6138         if available buff-goods then do:
     6139            v-rec = recid (buff-goods).
     6140            t-ret =  session:SET-WAIT-STATE("GENERAL") .
     6141   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     6142     (
     6143        input p-artic
     6144     ,  input p-prod-type
     6145     ,  input p-prod-code
     6146     , output is-petrolium
     6147     , output is-pieces
     6148     ) .
     6149              t-ret =  session:SET-WAIT-STATE("") .
     6150              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     6151                 assign
     6152                   p-road-tax-base = 0
     6153                   p-road-tax-rubl = 0
     6154                   .
     6155                  return.
     6156              end.
     6157         end.
     6158         assign
     6159             v-total-avrg-qnty = 0
     6160             v-total-road-tax-base =  0
     6161             v-total-road-tax-rubl =  0
     6162             v-all-total-road-tax-base =  0
     6163             v-all-total-road-tax-rubl =  0
     6164             .
     6165       for each  x_obj-group ,
     6166           each buf_parts no-lock
     6167           where buf_parts.obj-type  = x_obj-group.obj-type
     6168             and buf_parts.obj-code  = x_obj-group.obj-code
     6169             and buf_parts.artic     = p-artic
     6170             and buf_parts.prod-type = p-prod-type
     6171             and buf_parts.prod-code = p-prod-code
     6172             and buf_parts.status_   = no
     6173             and buf_parts.out-code  = 'free-zone':U
     6174             and buf_parts.qnty      > 0
     6175         on error undo, return error
     6176         :
     6177            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     6178   assign
     6179     price-rubl-with-tax-loc = buf_parts.price-rubl
     6180     price-base-with-tax-loc = buf_parts.price-base
     6181   .
     6182   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6184     (output varinvprb
     6185     )  .
     6186     if buf_parts.out-code = 'free-zone':U     or
     6187        buf_parts.out-code = 'out-zone':U   or
     6188        buf_parts.doc-type = 'акт':U then do:
     6189       assign
     6190         in-vatp-have-vat-slt = yes.
     6191     end.
     6192     else do:
     6193       find first in-vatp_doc-attr no-lock
     6194         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     6195           and in-vatp_doc-attr.attr-code = 'envd':U
     6196         no-error .
     6197       if not available in-vatp_doc-attr then do:
     6198         assign
     6199           in-vatp-have-vat-slt = yes.
     6200       end.
     6201       else do:
     6202            in-vatp-have-vat-slt = no.
     6203       end.
     6204     end.
     6205     assign
     6206      price-cli-with-tax-loc = buf_parts.price-cli
     6207      cli-base-rate          = buf_parts.cli-base-rate.
     6208     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     6209              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     6210     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     6211             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     6212             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     6213             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     6214             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     6215             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     6216             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6217       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6218     assign
     6219       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     6220     assign
     6221       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6222       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6223       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6224       transport-cli-loc  = 0
     6225       other-cli-loc      = 0
     6226     .
     6227   ASSIGN
     6228             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6229       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6230   .
     6231           assign
     6232             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     6233             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     6234            .
     6235        end.
     6236         if v-total-avrg-qnty > 0 then  do :
     6237         assign
     6238             p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     6239             p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     6240             .
     6241         end.
     6242         if v-total-avrg-qnty <= 0 then do :
     6243             run last-incom-S in this-procedure
     6244                ( input p-artic
     6245                 ,input p-prod-type
     6246                 ,input p-prod-code
     6247                 ,output p-in-code
     6248                 ,output p-obj-type
     6249                 ,output p-obj-code ).
     6250               find first  buf_trn-doc no-lock  where buf_trn-doc.doc-code  = p-in-code no-error .
     6251               find first  buf_doc-line no-lock where  buf_doc-line.doc-code = p-in-code
     6252                       and buf_doc-line.artic     = p-artic
     6253                       and buf_doc-line.prod-type = p-prod-type
     6254                       and buf_doc-line.prod-code = p-prod-code
     6255               no-error.
     6256               if available buf_doc-line then do :
     6257   assign
     6258     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     6259     price-base-with-tax-loc = buf_doc-line.price-base
     6260   .
     6261   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6262   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6263     (output varinvprb
     6264     )  .
     6265      find first in-vatp_doc-attr no-lock
     6266       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     6267         and in-vatp_doc-attr.attr-code = 'envd':U
     6268       no-error .
     6269       if available in-vatp_doc-attr
     6270          then do:
     6271          assign
     6272            in-vatp-have-vat-slt = no.
     6273      end.
     6274      else do:
     6275        assign
     6276          in-vatp-have-vat-slt = yes.
     6277      end.
     6278      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     6279                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     6280                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     6281      if (not buf_trn-doc.internal and
     6282              buf_trn-doc.doc-type = 'при':U) or
     6283         in-vatp-goods.gds-type = 'у':U then do:
     6284         if varinvprb = "base":u then do:
     6285           assign
     6286             road-tax-base-loc = buf_doc-line.road-tax
     6287             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     6288         end.
     6289         else do:
     6290           ASSIGN
     6291             road-tax-rubl-loc = buf_doc-line.road-tax
     6292             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     6293         end.
     6294         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     6295         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     6296         assign
     6297           road-tax-cli-loc = ?.
