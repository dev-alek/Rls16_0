     8740   def frame a
     8741   counter   label "Закачано"
     8742   count-upd label "Изменено"
     8743   count-all label "Просмотрено"
     8744   with side-labels view-as dialog-box.
     8745   view frame a.
     8746   case InputMode:
     8747     when "prod-bc" then do:
     8748       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "", yes, output par-bc-pfx, output par-type) no-error.
     8749       if error-status:error or
     8750         par-type <> "C":U then do:
     8751         message "Ошибка параметра bc-pfx."
     8752                 view-as alert-box error.
     8753         hide frame a.
     8754         return error.
     8755       end.
     8756       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "", yes, output par-bc-frmt, output par-type) no-error.
     8757       if error-status:error or
     8758         par-type <> "C":U then do:
     8759         message "Ошибка параметра bc-frmt."
     8760                 view-as alert-box error.
     8761         hide frame a.
     8762         return error.
     8763       end.
     8764       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "", no, output par-pl-pfx, output par-type) no-error.
     8765       if error-status:error or
     8766         par-type <> "C":U then
     8767         par-pl-pfx = ?.
     8768       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "", no, output par-pl-frmt, output par-type) no-error.
     8769       if error-status:error or
     8770         par-type <> "C":U then
     8771         par-pl-frmt = ?.
     8772       run adm/shattri.p (
     8773           input "get":U
     8774           ,input  '':U
     8775           ,input  0
     8776           ,input  'gds-ref':U
     8777           ,input  'dif-pdbc':U
     8778           ,output v-value-character
     8779           ,output v-value-date
     8780           ,output v-value-decimal
     8781           ,output v-value-integer
     8782           ,output par-dif-pdbc
     8783           ,output v-param-type
     8784           ,INPUT-OUTPUT table-handle v-tth
     8785           ) no-error.
     8786       delete object v-tth.
     8787       run adm/shattri.p (
     8788           input "get":U
     8789           ,input  '':U
     8790           ,input  0
     8791           ,input  'gds-ref':U
     8792           ,input  'dpl-off':U
     8793           ,output v-value-character
     8794           ,output v-value-date
     8795           ,output v-value-decimal
     8796           ,output v-value-integer
     8797           ,output par-dpl-off
     8798           ,output v-param-type
     8799           ,INPUT-OUTPUT table-handle v-tth
     8800           ) no-error.
     8801       delete object v-tth.
     8802     end.
     8803     when "input-way-bill" then do:
     8804       on write of ub.trn-doc override do: end.
     8805       clear-imp:
     8806       do transaction
     8807         on error undo clear-imp, return error
     8808         on stop  undo clear-imp, return error :
     8809         find ub.trn-doc where ub.trn-doc.doc-code = pardoc-code no-error.
     8810         if available ub.trn-doc then do:
     8811           run delete-trn-doc in this-procedure .
     8812         end.
     8813         create ub.trn-doc .
     8814         assign
     8815           ub.trn-doc.doc-code  = pardoc-code
     8816           ub.trn-doc.cr-db-num = v-cntxt-db-num
     8817           ub.trn-doc.doc-type  = 'при':U
     8818           ub.trn-doc.internal  = no
     8819           ub.trn-doc.exch-code = e-code
     8820           ub.trn-doc.obj-type = v-cntxt-obj-type
     8821           ub.trn-doc.obj-code = v-cntxt-obj-code
     8822         .
     8823         assign
     8824             v-obj-type = v-cntxt-obj-type
     8825             v-obj-code = v-cntxt-obj-code
     8826         .
     8827       end.
     8828     end.
     8829     when "way-bill-delete" then do:
     8830       del-imp:
     8831       do transaction
     8832         on error undo del-imp, return error
     8833         on stop  undo del-imp, return error :
     8834         find ub.trn-doc where ub.trn-doc.doc-code = pardoc-code no-error.
     8835         if available ub.trn-doc then do:
     8836           run delete-trn-doc in this-procedure .
     8837         end.
     8838       end.
     8839       return.
     8840     end.
     8841     when "overvalue" then do:
     8842       find buf_price-doc-forming where recid( buf_price-doc-forming) = dfc-recid .
     8843       assign
     8844           pdf-id = buf_price-doc-forming.pdf-id
     8845           pdf-db = buf_price-doc-forming.pdf-db
     8846           plt-id      = buf_price-doc-forming.plt-id
     8847           plt-db-num  = buf_price-doc-forming.plt-db-num
     8848       .
     8849     end.
     8850     otherwise do:
     8851       message
     8852         "Неправильное значение параметра InputMode:" InputMode
     8853         view-as alert-box error.
     8854       hide frame a.
     8855       return error.
     8856     end.
     8857   end case.
     8858   frame a :title = frame-title.
     8859   put stream err unformatted fill (chr(10), 2) frame a :title fill (chr(10), 3).
     8860   assign varfile-scan = ?
     8861          vararticle-supplier = no.
     8862   file-line:
     8863   repeat on endkey undo, leave :
     8864     disp count-upd counter count-all with frame a.
     8865     do on endkey undo, leave:
     8866       import stream  inp unformatted source-string no-error.
     8867     end.
     8868     if error-status:error then undo, leave.
     8869     if source-string = "" then
     8870       next file-line.
     8871     count-all = count-all + 1.
     8872     if source-string = "ARTICLE-SUPPLIER" then do:
     8873       assign
     8874         vararticle-supplier = yes.
     8875       if parcli-type = ? and
     8876          parcli-code = ? then do:
     8877         message "Из данного интерфейса нельзя обрабатывать данные по артикулу поставщика."
     8878         view-as alert-box error.
     8879         return error.
     8880       end.
     8881       else do:
     8882         find first bf_clients where bf_clients.obj-type = parcli-type and
     8883                                     bf_clients.obj-code = parcli-code no-lock no-error.
     8884         if not available bf_clients then do:
     8885           message "Ведем импорт по артикулу поставщика." skip
     8886                   "Не найден поставщик " parcli-type parcli-code " ."
     8887           view-as alert-box error.
     8888           return error.
     8889         end.
     8890       end.
     8891       next file-line.
     8892     end.
     8893     if varfile-scan = ?              and
     8894        index (source-string, ",") > 0 then do:
     8895        message "Формат строки " source-string " содержит запятую." skip
     8896                "Будем разбирать все необработаные строки файла как формат сканера?"
     8897        view-as alert-box question buttons yes-no update varlog.
     8898        if varlog = yes then do:
     8899             if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Начиная со строки " + source-string + " разбираем данные по формату сканера." skip.
     8900             assign varfile-scan = yes.
     8901          end.
     8902          else do:
     8903             assign varfile-scan = no.
     8904          end.
     8905     end.
     8906     if varfile-scan = yes then do:
     8907        ASSIGN varcode-scan  = ENTRY(1, source-string, ",")
     8908               varqnty-scan  = ENTRY(2, source-string, ",")
     8909               varprice-scan = ENTRY(3, source-string, ",").
     8910        if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Строка " + source-string + " сконвертирована в CODE:" + varcode-scan + ";;;;;" + varprice-scan + ";" + varqnty-scan + ";;;;;;;" skip.
     8911        source-string = "CODE:" + varcode-scan + ";;;;;" + varprice-scan + ";" + varqnty-scan + ";;;;;;;".
     8912     end.
     8913     else do:
     8914        if index (source-string, ":") = 0 then do:
     8915           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Не указан тип строки (ITEM,SCALE,PART,CODE) или отсутствует двоеточие. Пропускаем." chr(10).
     8916           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     8917           next file-line.
     8918         end.
     8919     end.
     8920     assign
     8921       string-type     = substring (source-string, 1, index (source-string, ":") - 1)
     8922       text-string     = substring (source-string, index (source-string, ":") + 1)
     8923       i-artic-supp    = ""
     8924       i-artic         = ""
     8925       i-code          = ""
     8926       i-prod-code     = 0
     8927       i-scale         = ""
     8928       i-doc-code      = ""
     8929       i-part-code     = ""
     8930       i-prod-bc       = ""
     8931       i-price         = 0
     8932       i-qnty          = 0
     8933       i-unit-cli      = ""
     8934       i-cli-base-rate = 1
     8935       i-d-pcnt        = 0
     8936       i-VAT           = 0
     8937       i-SLT           = 0
     8938       size            = 1
     8939       i-bc-on         = ?
     8940       i-cst-code      = ""
     8941       i-wt-brutto     = 0
     8942       i-num-place     = 0
     8943       i-last-date     = ?
     8944       i-price-prod     = 0
     8945       i-price-prod-vat     = 0
     8946       .
     8947     if num-entries (text-string, ";") <> 14 and
     8948        num-entries (text-string, ";") <> 16 and
     8949        num-entries (text-string, ";") <> 17 and
     8950        num-entries (text-string, ";") <> 18 and
     8951        num-entries (text-string, ";") <> 19
     8952        then do:
     8953       if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Неправильное число параметров: " string (num-entries (text-string, ";"))
     8954                     " (должно быть 14,16,17,18 или 19). Пропускаем." chr(10).
     8955       if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     8956       next file-line.
     8957     end.
     8958     if string-type = "CODE" then do:
     8959       assign
     8960         i-code = trim (entry (1, text-string, ";")).
     8961     end.
     8962     else do:
     8963       if vararticle-supplier = yes then do:
     8964         assign
     8965           i-artic-supp =  trim (entry (1, text-string, ";")).
     8966         find first bf_cli-gds where bf_cli-gds.cli-type  = parcli-type  and
     8967                                     bf_cli-gds.cli-code  = parcli-code  and
     8968                                     bf_cli-gds.host-code = parhost-code and
     8969                                     bf_cli-gds.cli-art   = i-artic-supp no-lock no-error.
     8970         if not available bf_cli-gds then do:
     8971           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) substitute ("Не найден артикул поставщика &1 по фирме &2 для поставщика &3 &4. Пропускаем.", i-artic-supp, parhost-code, parcli-type, parcli-code) chr(10).
     8972           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     8973           next file-line.
     8974         end.
     8975         assign
     8976           i-artic     = bf_cli-gds.artic
     8977           i-prod-code = bf_cli-gds.prod-code.
     8978       end.
     8979       else do:
     8980         assign
     8981           i-artic     = trim (entry (1, text-string, ";"))
     8982           i-prod-code = integer (trim (entry (2, text-string, ";"))).
     8983       end.
     8984     end.
     8985     assign
     8986       i-scale         = trim    (entry (3, text-string, ";"))
     8987       i-doc-code      = trim    (entry (3, text-string, ";"))
     8988       i-part-code     = trim    (entry (4, text-string, ";"))
     8989       i-prod-bc       = trim    (entry (5, text-string, ";"))
     8990       i-price         = decimal (entry (6, text-string, ";"))
     8991       i-qnty          = decimal (entry (7, text-string, ";"))
     8992       i-unit-cli      =          entry (8, text-string, ";")
     8993       i-cli-base-rate = decimal (entry (9, text-string, ";"))
     8994       i-d-pcnt        = decimal (entry (10, text-string, ";"))
     8995       i-VAT           = decimal (entry (11, text-string, ";"))
     8996       i-SLT           = decimal (entry (12, text-string, ";"))
     8997       .
     8998       if entry (13, text-string, ";") = "yes" then do:
     8999          assign i-bc-on = yes.
     9000       end.
     9001       else do:
     9002          if entry (13, text-string, ";") = "no" then do:
     9003             assign i-bc-on = no.
     9004          end.
     9005          else do:
     9006            if lookup (InputMode, "prod-bc,all") > 0 then do:
     9007               if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Неверный параметр 13. Должен быть yes или no." chr(10).
     9008               if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     9009               next file-line.
     9010            end.
     9011          end.
     9012       end.
     9013       assign i-cst-code = entry (14, text-string, ";").
     9014       if num-entries (text-string, ";") = 16 then do:
     9015         assign
     9016           i-wt-brutto = decimal(entry (15, text-string, ";"))
     9017           i-num-place = decimal(entry (16, text-string, ";"))
     9018         .
     9019       end.
     9020       if num-entries (text-string, ";") = 17 then do:
     9021         assign
     9022           i-wt-brutto = decimal(entry (15, text-string, ";"))
     9023           i-num-place = decimal(entry (16, text-string, ";"))
     9024           i-last-date = date(entry (17, text-string, ";"))
     9025         .
     9026       end.
     9027       if num-entries (text-string, ";") = 18 then do:
     9028         assign
     9029           i-wt-brutto = decimal(entry (15, text-string, ";"))
     9030           i-num-place = decimal(entry (16, text-string, ";"))
     9031           i-last-date = date(entry (17, text-string, ";"))
     9032           i-price-prod = decimal(entry (18, text-string, ";"))
     9033         .
     9034       end.
     9035       if num-entries (text-string, ";") = 19 then do:
     9036         assign
     9037           i-wt-brutto = decimal(entry (15, text-string, ";"))
     9038           i-num-place = decimal(entry (16, text-string, ";"))
     9039           i-last-date = date(entry (17, text-string, ";"))
     9040           i-price-prod = decimal(entry (18, text-string, ";"))
     9041           i-price-prod-vat = decimal(entry (19, text-string, ";"))
     9042         .
     9043       end.
     9044     case string-type:
     9045       when "ITEM" then do:
     9046         if i-artic = "" then do:
     9047           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Пустой артикул. Пропускаем." chr(10).
     9048           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     9049           next file-line.
     9050         end.
     9051         assign
     9052           i-code = ""
     9053           i-doc-code = ""
     9054           i-part-code = ""
     9055           .
     9056       end.
     9057       when "SCALE" then do:
     9058         if i-artic = "" then do:
     9059           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Пустой артикул. Пропускаем." chr(10).
     9060           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     9061           next file-line.
     9062         end.
     9063         if i-scale = "" then do:
     9064           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Пустое название признака. Пропускаем." chr(10).
     9065           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     9066           next file-line.
     9067         end.
     9068         assign
     9069           i-code = ""
     9070           i-doc-code = ""
     9071           i-part-code = ""
     9072           .
     9073       end.
     9074       when "PART" then do:
     9075         if i-artic = "" then do:
     9076           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Пустой артикул. Пропускаем." chr(10).
     9077           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     9078           next file-line.
     9079         end.
     9080         i-code = "".
     9081       end.
     9082       when "CODE" then do:
     9083         if i-code = "" then do:
     9084           if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Пустой код. Пропускаем." chr(10).
     9085           if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     9086           next file-line.
     9087         end.
     9088         i-artic = "".
     9089       end.
     9090       otherwise do:
     9091         if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10) "Неправильный тип строки (должно быть ITEM,SCALE,PART,CODE). Пропускаем." chr(10).
     9092         if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.
     9093         next file-line.
     9094       end.
     9095     end case.
     9096     release ub.goods.
     9097     release ub.gds-prt.
     9098     release ub.parts.
     9099     if lookup (string-type, "ITEM,SCALE,PART") > 0 then do:
     9100       if i-prod-code = 0 then do:
     9101         FIND first ub.goods WHERE
     9102                    ub.goods.artic = i-artic and
     9103                    ub.goods.stts = 0 no-lock no-error.
     9104         if available ub.goods then do:
     9105           find first other-goods where
     9106                      other-goods.artic = i-artic and
     9107                      other-goods.stts  = 0       and
     9108                      recid (other-goods) <> recid (goods) no-lock no-error.
     9109           if available other-goods then do:
     9110             if msg-line <> count-all then     put stream err unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if msg-line <> count-all then do:     put stream err unformatted     source-string     chr(10).     msg-line = count-all.   end.   put stream err unformatted "Производитель не указан. Есть больше одного включенного товара с этим артикулом. Взят первый подходящий." chr(10).
     9111           end.
     9112           find first other-goods where
     9113                      other-goods.artic = i-artic and
     9114                      recid (other-goods) <> recid (goods) no-lock no-error.
     9115           if available other-goods then do:
     9116             if wrn-line <> count-all then     put stream wrn unformatted     "------------------------------------------------------------------------------------" chr(10)     "Строка №: " count-all chr(10)   " Артикул : "                      ub.goods.artic   " Производитель : "                ub.goods.prod-type   " "                                ub.goods.prod-code   " Код товара : "                   ub.goods.gds-code   " Основная единица измерения : "   ub.goods.unit-base chr(10)   chr(10).   if wrn-line <> count-all then do:     put stream wrn unformatted     source-string     chr(10).     wrn-line = count-all.   end.   put stream wrn unformatted "Производитель не указан. Есть больше одного товара с этим артикулом. Взят первый неудаленный." chr(10).
