     1072   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1073   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1075   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1076   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1077   ASSIGN
     1078      v-S_CONTRACT                = "Contract":U
     1079      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1080      v-DELIM_CHR_3               = ","
     1081      .
     1082   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1083   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1084   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1085   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1086      INPUT iHost-Code    AS INTEGER,
     1087      INPUT iContract-Num AS INTEGER,
     1088      INPUT iGds-Code     AS INTEGER ):
     1089      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1090      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1091      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1092      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1093      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1094      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1095          INPUT  iHost-Code,
     1096          INPUT  iContract-Num,
     1097          OUTPUT iTmp-Extent3
     1098          ).
     1099      IF iTmp-Extent3[1] = 2 THEN DO:
     1100         ASSIGN
     1101            iTmp-Host-Code      = iTmp-Extent3[2]
     1102            iTmp-Contract-Num   = iTmp-Extent3[3]
     1103            .
     1104      END. ELSE DO:
     1105         ASSIGN
     1106            iTmp-Host-Code      = iHost-Code
     1107            iTmp-Contract-Num   = iContract-Num
     1108            .
     1109      END.
     1110      IF iGds-Code = ? THEN DO:
     1111         ASSIGN
     1112            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1113                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1114                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1115                           ).
     1116      END. ELSE DO:
     1117            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1118                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1119                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1120                              AND buf_Spec.Gds-Code      = iGds-Code
     1121                            ).
     1122      END.
     1123      RETURN (lRet).
     1124   END FUNCTION.
     1125   PROCEDURE MS-Contract-EXTENT-3:
     1126      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1127      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1128      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1129      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1130      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1131      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1132      FIND FIRST buf_Cont-2 WHERE
     1133                 buf_Cont-2.Host-Code      = i-Host-Code
     1134             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1135           NO-LOCK NO-ERROR.
     1136      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1137         RETURN.
     1138      END.
     1139      FOR FIRST buf_Ext-Classif WHERE
     1140                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1141           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1142                                               STRING(i-Contract-code)
     1143           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1144          NO-LOCK,
     1145          EACH buf_Cont WHERE
     1146               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1147           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1148          NO-LOCK:
     1149          ASSIGN
     1150             i-Ret[1] = 1
     1151             i-Ret[2] = buf_Cont.Host-code
     1152             i-Ret[3] = buf_Cont.Contract-code
     1153             .
     1154          LEAVE.
     1155      END.
     1156      IF i-Ret[1] <> 1 THEN DO:
     1157         FOR FIRST buf_Ext-Classif WHERE
     1158                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1159              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1160                                                  STRING(i-Contract-code)
     1161              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1162             NO-LOCK,
     1163             EACH buf_Cont WHERE
     1164                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1165              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1166             NO-LOCK:
     1167             ASSIGN
     1168                i-Ret[1] = 2
     1169                i-Ret[2] = buf_Cont.Host-code
     1170                i-Ret[3] = buf_Cont.Contract-code
     1171                .
     1172             LEAVE.
     1173         END.
     1174      END.
     1175      RETURN.
     1176   END PROCEDURE.
     1177   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
