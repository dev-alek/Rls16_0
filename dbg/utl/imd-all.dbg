    10168                             return-value,
    10169                             error-status:get-message(1))  + chr(10).
    10170               end.
    10171               end.
    10172               if main-b-code  <>  bf_bar-code.b-code then do:
    10173                   find first buf_price-doc-forming-gds exclusive-lock where
    10174                             buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
    10175                             buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
    10176                             buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
    10177                             buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      and
    10178                             buf_price-doc-forming-gds.b-code     = bf_bar-code.b-code no-error .
    10179                   if available buf_price-doc-forming-gds then do:
