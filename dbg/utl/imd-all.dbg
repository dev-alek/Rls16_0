     1190     :
     1191           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-code in g#attr-lib
     1192         (input  p-code
     1193         ,output p-type
     1194         ,output p-format
     1195         ,output p-label
     1196         ,output p-user-can-edit
     1197         ,output p-output-display
     1198         ,output p-other
     1199         ) no-error .
     1200       if error-status :error
     1201       then do:
     1202         undo, return error return-value .
     1203       end.
     1204     end.
     1205   end procedure.
