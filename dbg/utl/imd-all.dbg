     7134                             buf1-bar-code.unit-cli = buf_goods.unit-base
     7135                             :
     7136                             bbb = true .
     7137                             for each alt_price-list no-lock where
     7138                                     alt_price-list.plt-id     = pp_price-list.plt-id     and
     7139                                     alt_price-list.plt-db-num = pp_price-list.plt-db-num and
     7140                                     alt_price-list.pdf-id     = pp_price-list.pdf-id     and
     7141                                     alt_price-list.pdf-db     = pp_price-list.pdf-db     and
     7142                                     alt_price-list.artic      = pp_price-list.artic      and
     7143                                     alt_price-list.prod-type  = pp_price-list.prod-type  and
     7144                                     alt_price-list.b-code     <> main_price-list.b-code  and
     7145                                     alt_price-list.b-code     <> pp_price-list.b-code    and
     7146                                     alt_price-list.prod-code  = pp_price-list.prod-code ,
     7147                               first buf2_goods no-lock where
     7148                                     buf2_goods.artic     =  pp_price-list.artic     and
     7149                                     buf2_goods.prod-type =  pp_price-list.prod-type and
     7150                                     buf2_goods.prod-code =  pp_price-list.prod-code ,
     7151                               first buf2-bar-code no-lock where
     7152                                     buf2-bar-code.b-code   = alt_price-list.b-code and
     7153                                     buf2-bar-code.unit-cli <> buf2_goods.unit-base and
     7154                                     buf2-bar-code.node-code = buf1-bar-code.node-code
     7155                                   :
