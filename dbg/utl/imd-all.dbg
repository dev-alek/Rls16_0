     8093   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8094   procedure last-incom-S :
     8095   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
     8096   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
     8097   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
     8098   define output parameter p-in-code   as character no-undo .
     8099   define output parameter p-obj-type  as character no-undo .
     8100   define output parameter p-obj-code  as integer   no-undo .
     8101     do
     8102     on error undo, return error return-value
     8103     :
     8104     define buffer buf_trn-doc for ub.trn-doc .
     8105     define buffer buf_gds-obj for ub.gds-obj  .
     8106     do
     8107     on error undo, return error
     8108     :
     8109       assign
     8110         p-in-code  = ""
     8111         p-obj-type = ""
     8112         p-obj-code = 0
     8113       .
     8114        for each x_obj-group ,
     8115         each buf_gds-obj no-lock
     8116         where buf_gds-obj.obj-type  = x_obj-group.obj-type
     8117           and buf_gds-obj.obj-code  = x_obj-group.obj-code
     8118           and buf_gds-obj.artic     = p-artic
     8119           and buf_gds-obj.prod-type = p-prod-type
     8120           and buf_gds-obj.prod-code = p-prod-code
     8121       , first buf_trn-doc no-lock
     8122         where buf_trn-doc.doc-code = buf_gds-obj.in-code
     8123           and buf_trn-doc.status_  = 'факт':U
     8124       on error undo, return error
     8125       by buf_trn-doc.fact-order descending
     8126       :
     8127         assign
     8128           p-in-code  = buf_gds-obj.in-code
     8129           p-obj-type = buf_gds-obj.obj-type
     8130           p-obj-code = buf_gds-obj.obj-code
     8131         .
     8132         leave .
     8133       end.
     8134     end.
     8135     end.
     8136   end procedure.
     8137   procedure main-road-tax :
     8138   def input param p-obj-type  like ub.gds-obj.obj-type  no-undo .
     8139   def input param p-obj-code  like ub.gds-obj.obj-code  no-undo .
     8140   def input param p-artic     like ub.gds-obj.artic     no-undo .
