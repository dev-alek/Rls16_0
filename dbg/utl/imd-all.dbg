     4153           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     4154           find first buf_gds-dtl no-lock where
     4155                      buf_gds-dtl.doc-code  = v-doc-code   and
     4156                      buf_gds-dtl.artic     = p-artic      and
     4157                      buf_gds-dtl.prod-type = p-prod-type  and
     4158                      buf_gds-dtl.prod-code = p-prod-code  and
     4159                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     4160           assign
     4161             v1 = recid (buf_trn-doc)
