     7023     ,output l-price-sale
     7024     ,output l-road-tax
     7025     ,output l-excise
     7026     ) no-error .
     7027         if l-doc-num2 <> ? then do :
     7028           if l-price-sale = pdf_price-list.price-sale-doc
     7029           and v-price-sale = pdf_price-list.price-sale-doc
     7030           then do:
     7031                find first buf_goods no-lock where
