    10276                      no-error .
    10277           if available buf_price-doc-forming-gds then do:
    10278              buf_price-doc-forming-gds.d-pcnt =
    10279              (( (main_price-doc-forming-gds.price-sale-doc * bf_bar-code.cli-base-rate) - v-price  ) * 100) /
    10280                ( main_price-doc-forming-gds.price-sale-doc * bf_bar-code.cli-base-rate) no-error .
    10281           end.
    10282           end.
    10283   end procedure.
    10284   procedure delete-trn-doc :
    10285     do
    10286     on error undo, return error
    10287     :
    10288       for each ub.doc-line
    10289         where ub.doc-line.doc-code = ub.trn-doc.doc-code
    10290       on error undo, return error
    10291       :
    10292         delete ub.doc-line .
    10293       end.
    10294       for each ub.gds-dtl
    10295         where ub.gds-dtl.doc-code = ub.trn-doc.doc-code
    10296       on error undo, return error
    10297       :
    10298         delete ub.gds-dtl .
    10299       end.
    10300       delete ub.trn-doc .
    10301     end.
    10302   end procedure.
