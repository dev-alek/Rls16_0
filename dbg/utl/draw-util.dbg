        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable mDraw-util as class ibs.th.utl.draw_utility no-undo.
        4   mDraw-util = new ibs.th.utl.draw_utility().
        5   mDraw-util:parparentproc = parparentproc.
        6   wait-for  mDraw-util:ShowDialog() .
        7   delete object mDraw-util.
