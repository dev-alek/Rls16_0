        1   block-level on error undo, throw.
        2   define input  parameter p-item-id        as character no-undo .
        3   define input  parameter p-item-procedure as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: meopen.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/meopen.p $":U .
        9   define variable vss-description as character no-undo init "Открыть файл на основании строки запуска меню".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable v-search-file-name    as character no-undo .
       69   define variable v-line-number         as integer   no-undo .
       70   define variable v-output-file-name    as character no-undo .
       71   define variable v-grep-line           as character no-undo .
       72   define variable v-command-line-option as character no-undo .
       73   define variable v-full-path           as character no-undo .
       74   define variable v-path                as character no-undo .
       75   define variable v-file-name           as character no-undo .
       76   define variable v-file-name-no-ext    as character no-undo .
       77   define variable v-file-name-ext       as character no-undo .
       78   define variable v-command-line        as character no-undo .
       79   define variable v-grep-file-name      as character no-undo .
       80   do
       81   on error undo, return error return-value
       82   :
       83     run open-file-in-me in this-procedure
       84       (input  'cmp/menu.txt':U
       85       ,input  p-item-id
       86       ) .
       87     if p-item-procedure begins 'int,':U
       88     then do:
       89       run open-file-in-me in this-procedure
       90         (input  'gbl/dm-menu.p':U
       91         ,input  p-item-procedure
       92         ) .
       93     end.
       94     else do:
       95       run open-file-in-me in this-procedure
       96         (input  search(entry(2, p-item-procedure, chr(44)))
       97         ,input  '':U
       98         ) .
       99     end.
      100   end.
      101   procedure open-file-in-me :
      102     define input  parameter p-file-name     as character no-undo .
      103     define input  parameter p-search-string as character no-undo .
      104     do
      105     on error undo, return error return-value
      106     :
      107       assign
      108         file-info :file-name = search(p-file-name)
      109         v-search-file-name = file-info :full-pathname
      110       .
      111       if  p-search-string <> ?
      112       and p-search-string <> '':U
      113       then do:
      114         assign
      115           file-info :file-name = search('exe/grep.bat':U)
      116           v-grep-file-name = file-info :full-pathname
      117         .
      118         run gbl/filename.p
      119           (input  v-grep-file-name
      120           ,output v-full-path
      121           ,output v-path
      122           ,output v-file-name
      123           ,output v-file-name-no-ext
      124           ,output v-file-name-ext
      125           ) .
      126         run gbl/_tmpfile.p
      127           (input  '':U
      128           ,input  '':U
      129           ,output v-output-file-name
      130           ) .
      131         output to value(v-output-file-name) .
      132         output close .
      133         assign
      134           file-info :file-name = v-output-file-name
      135           v-output-file-name = file-info :full-pathname
      136         .
      137         assign
      138           v-command-line = substitute ("&1 &2 &3 &4 &5"
      139                                     ,v-grep-file-name
      140                                     ,v-path
      141                                     ,entry(2, p-item-procedure, chr(44))
      142                                     ,v-search-file-name
      143                                     ,v-output-file-name
      144                                     )
      145         .
      146         os-command value(v-command-line) .
      147         input from value(v-output-file-name) .
      148         import unformatted v-grep-line .
      149         input close .
      150         os-delete value(v-output-file-name) .
      151         assign
      152           v-line-number = integer(entry(1, v-grep-line, ':':u))
      153         .
      154         assign
      155           v-command-line-option = substitute(' /L&1':U
      156                                             ,v-line-number
      157                                             )
      158         .
      159       end.
      160       else do:
      161         assign
      162           v-command-line-option = '':U
      163         .
      164       end.
      165       run gbl/_tmpfile.p
      166         (input  '':U
      167         ,input  'bat':U
      168         ,output v-output-file-name
      169         ) .
      170       output to value(v-output-file-name) .
      171       put unformatted substitute("C:\MEW8.0\MEW32.exe -SNWORK15_0 &1&2"
      172                                   ,v-search-file-name
      173                                   ,v-command-line-option
      174                                   ) + chr(10) .
      175       put unformatted 'exit' + chr(10) .
      176       output close .
      177       assign
      178         file-info :file-name = v-output-file-name
      179         v-output-file-name = file-info :full-pathname
      180       .
      181       os-command value(v-output-file-name) .
      182       os-delete value(v-output-file-name) .
      183     end.
      184   end procedure.
