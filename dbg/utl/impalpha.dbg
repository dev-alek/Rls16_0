        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: impalpha.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/impalpha.p $":U .
        8   define variable vss-description as character no-undo init "Закачка стран происхождения в карточку товара".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define new shared temp-table gds-list no-undo like ub.goods
       80     field qnty   as decimal
       81     field to-del as logical
       82     field order-num as integer
       83     field to-sel as logical
       84     field promo-code as character
       85     field ActionId  as int64
       86     field db-num as integer
       87     index art  is primary unique artic prod-type prod-code
       88     index code is         unique gds-code
       89     index oi order-num
       90     index isel to-sel
       91     .
       92   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define  new shared  temp-table gds-list-hist no-undo
       94   field list-table as character
       95   field id as integer
       96   field line as integer
       97   field hist-mode as character
       98   field des as character
       99   field num-recs as integer
      100   field option_ as character
      101   field item_ as character
      102   field status_ as character
      103   field num-add as integer
      104   field num-ignored as integer
      105   field done as logical
      106   field err_ as logical
      107   field err-mes as character
      108   index pi is primary
      109   id
      110   line
      111   index isdone
      112   done
      113   .
      114     define new shared temp-table  tt-tax no-undo
      115   field tax-code    like ub.tax.tax-code
      116   FIELD individual  like ub.tax.individual
      117   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      118   field rate-code   like ub.tax-rate.rate-code
      119   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      120   FIELD tax-type    like ub.tax.tax-type
      121   field rate-value  like ub.tax-rate-value.rate-value
      122   FIELD tax-rate-gds-rc  as recid
      123   FIELD to-cashdesk like ub.tax.to-cashdesk
      124   FIELD fact-date like ub.tax-rate-value.fact-date
      125   FIELD fact-order like ub.tax-rate-value.fact-order
      126   FIELD next-order like ub.tax-rate-value.fact-order
      127   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      128   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      129   FIELD corr-date like ub.tax-rate-gds.corr-date
      130   FIELD corr-time like ub.tax-rate-gds.corr-time
      131   index tax-code is unique primary tax-code fact-order descending rate-code.
      132   define variable InputFileName as char                 no-undo.
      133   define variable glog as logical no-undo .
      134   define variable v-parameter   as character no-undo .
      135   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136     run mainmenu_getcntxt in parparentproc
      137       (output v-cntxt-db-num
      138       ,output v-cntxt-userid
      139       ,output v-cntxt-level
      140       ,output v-cntxt-host-code-obj
      141       ,output v-cntxt-obj-type
      142       ,output v-cntxt-obj-code
      143       ,output v-cntxt-db-num-obj
      144       ,output v-cntxt-is-admin
      145       ) .
      146   if ( v-cntxt-db-num > 0 ) then do:
      147     message "Данная утилита может работать только в ГБД.".
      148     return.
      149   end.
      150   SYSTEM-DIALOG GET-FILE InputFileName
      151                 TITLE   "Файл для заполнения поля страны происхождения"
      152                 FILTERS "Текстовый файл (*.txt)" "*.txt",
      153                         "Все файлы (*.*)"        "*.*"
      154                 MUST-EXIST
      155                 USE-FILENAME
      156                 UPDATE glog.
      157   if not glog then return.
      158   InputFileName = trim (string (InputFileName)) .
      159   glog = yes.
      160   message
      161   "Выберите кодировку входного файла: YES - 1251, NO - KOI8-R"
      162   view-as alert-box question buttons YES-NO update glog.
      163   define variable v-encoding as character no-undo .
      164   if glog then
      165   v-encoding = "1251".
      166   else
      167   v-encoding = "KOI8-R".
      168   glog = yes.
      169   message "Выберите режим импорта:" skip
      170           "YES - замена" skip
      171           "NO - добавление (заполняются только пустые)"
      172           view-as alert-box question buttons YES-NO update glog.
      173   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174     run mainmenu_getcntxt in parparentproc
      175       (output v-cntxt-db-num
      176       ,output v-cntxt-userid
      177       ,output v-cntxt-level
      178       ,output v-cntxt-host-code-obj
      179       ,output v-cntxt-obj-type
      180       ,output v-cntxt-obj-code
      181       ,output v-cntxt-db-num-obj
      182       ,output v-cntxt-is-admin
      183       ) .
      184   assign
      185   v-parameter =
      186                 "alpha1":U + chr(1) +
      187                 (if glog then "replace" else 'ДОБАВЛЕНИЕ':U) + chr(4) + inputfilename + chr(4) + v-encoding +
      188                               chr(1) +
      189                 v-cntxt-obj-type                                                                                    + chr(4) +
      190                 string(v-cntxt-obj-code)                                                                            + chr(4) +
      191                 "":U                                                                              + chr(4) +
      192                 "":U                                                                                   + chr(4) +
      193                 "":U                                                                                  + chr(4) +
      194                 "":U                                                                                 + chr(4) +
      195                 "":U                                                                                   + chr(4) +
      196                 "":U                                                                                     + chr(4) +
      197                 "":U                                                                                   + chr(4) +
      198                 "":U                                                                                   + chr(4) +
