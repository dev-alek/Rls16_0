        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":u .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
        6   define variable vss-workfile    as character no-undo init "$Workfile: ini-labl.p $":u .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/ini-labl.p $":u .
        8   define variable vss-description as character no-undo init "Инициализация поля label-name" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     define variable v-cntxt-db-num        as integer   no-undo .
       80     define variable v-cntxt-userid        as character no-undo .
       81     define variable v-cntxt-level         as character no-undo .
       82     define variable v-cntxt-host-code-obj as integer   no-undo .
       83     define variable v-cntxt-obj-type      as character no-undo .
       84     define variable v-cntxt-obj-code      as integer   no-undo .
       85     define variable v-cntxt-db-num-obj    as integer   no-undo .
       86     define variable v-cntxt-is-admin      as logical   no-undo .
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define new shared temp-table gds-list no-undo like ub.goods
       89     field qnty   as decimal
       90     field to-del as logical
       91     field order-num as integer
       92     field to-sel as logical
       93     field promo-code as character
       94     field ActionId  as int64
       95     field db-num as integer
       96     index art  is primary unique artic prod-type prod-code
       97     index code is         unique gds-code
       98     index oi order-num
       99     index isel to-sel
      100     .
      101   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   define  new shared  temp-table gds-list-hist no-undo
      103   field list-table as character
      104   field id as integer
      105   field line as integer
      106   field hist-mode as character
      107   field des as character
      108   field num-recs as integer
      109   field option_ as character
      110   field item_ as character
      111   field status_ as character
      112   field num-add as integer
      113   field num-ignored as integer
      114   field done as logical
      115   field err_ as logical
      116   field err-mes as character
      117   index pi is primary
      118   id
      119   line
      120   index isdone
      121   done
      122   .
      123   define variable ii as integer no-undo.
      124   define variable kk as integer no-undo.
      125   define variable choice as integer no-undo.
      126   define variable glog as logical no-undo .
      127   def frame b
      128   ii label "Обработано товаров"
      129   with side-labels title "Заполнение поля НАЗВАНИЕ НА ЭТИКЕТКЕ" view-as dialog-box.
      130   run gbl/d-askw.w (input "Выбор товаров для изменения",
      131                         input "Вы хотите заполнить поле НАЗВАНИЕ НА ЭТИКЕТКЕ ДЛЯ:",
      132                         input "|",
      133                         input "Всех товаров|Выборочно|Отказ",
      134                         input "||",
      135                         input 1,
      136                         input 3,
      137                         output choice).
      138   if choice = 3 then return.
      139   if choice = 2 then do:
      140   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141     run mainmenu_getcntxt in parparentproc
      142       (output v-cntxt-db-num
      143       ,output v-cntxt-userid
      144       ,output v-cntxt-level
      145       ,output v-cntxt-host-code-obj
      146       ,output v-cntxt-obj-type
      147       ,output v-cntxt-obj-code
      148       ,output v-cntxt-db-num-obj
      149       ,output v-cntxt-is-admin
      150       ) .
      151       run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
      152       glog = yes.
      153       message "Заполнить поле НАЗВАНИЕ НА ЭТИКЕТКЕ по всем товарам списка ?  Вы уверены ?"
      154                   view-as alert-box question buttons OK-Cancel update glog.
      155       if glog <> true then return.
      156       view frame b.
      157       ii = 0.
      158       for each gds-list ON STOP UNDO, NEXT
      159                               ON ERROR UNDO, NEXT:
      160         ii = ii + 1.
      161         find ub.goods where ub.goods.artic = gds-list.artic
      162                               and ub.goods.prod-type = gds-list.prod-type
      163                               and ub.goods.prod-code = gds-list.prod-code.
      164         if ub.goods.label-name = "" then ub.goods.label-name = ub.goods.gds-name.
      165         disp ii with frame b.
      166         process events.
      167         kk = kk + 1.
      168       end.
      169   end.
      170   else do:
      171       glog = yes.
      172       message "Заполнить поле НАЗВАНИЕ НА ЭТИКЕТКЕ по ВСЕМ ТОВАРАМ  ?  Вы уверены ?"
      173                   view-as alert-box question buttons OK-Cancel update glog.
      174       if glog <> true then return.
      175       view frame b.
      176       ii = 0.
      177       for each ub.goods ON STOP UNDO, NEXT
      178                               ON ERROR UNDO, NEXT:
      179         ii = ii + 1.
      180         if ub.goods.label-name = "" then ub.goods.label-name = ub.goods.gds-name.
      181         disp ii with frame b.
      182         process events.
      183         kk = kk + 1.
      184       end.
      185   end.
      186   if ii = kk then
      187   message "Заполнение поля НАЗВАНИЕ НА ЭТИКЕТКЕ закончено успешно."
      188   view-as alert-box.
      189   else
      190   message "Из " ii " товаров, выбранных для изменения удалось изменить" kk " !" view-as
      191   alert-box WARNING.
