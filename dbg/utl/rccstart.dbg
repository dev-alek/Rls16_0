        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Вызов программы сравнения директорий *.r кодов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "X(65)" no-undo
       69   initial "@(#)$Workfile$ $Revision$".
       70   define temp-table temp_testXML-node no-undo
       71       field xmh-key       as integer
       72       field xmhNodName    as character
       73       index pi is primary unique
       74           xmh-key
       75       index nnm
       76           xmhNodName
       77   .
       78   define temp-table temp_testXML-entity no-undo
       79       field xme-key       as integer
       80       field xmh-key       as integer
       81       field xmeEntName    as character
       82       field xmeEntValue   as character
       83       index pi is primary unique
       84           xme-key
       85       index enm
       86           xmh-key
       87           xmeEntName
       88   .
       89   define temp-table temp_testXML-atribut no-undo
       90       field xme-key       as integer
       91       field xmeAtrName    as character
       92       field xmeAtrValue   as character
       93       index pi is primary unique
       94           xme-key
       95           xmeAtrName
       96   .
       97   define variable mRoot  as character no-undo init "Root".
       98   define stream xmldom-out.
       99   define variable mverfile_text as character   no-undo.
      100   define variable mverfile      as integer  no-undo.
      101   define variable v-xmldom-key       as integer      no-undo.
      102     define variable mTransaction  as logical no-undo init yes.
      103   procedure xmldom-clear :
      104       define buffer buf_temp_testXML-node         for temp_testXML-node.
      105       define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      106       define buffer buf_temp_testXML-atribut      for temp_testXML-atribut.
      107   do
      108   for buf_temp_testXML-node
      109     , buf_temp_testXML-entity
      110     , buf_temp_testXML-atribut
      111   on error undo, return error
      112   :
      113       empty temp-table buf_temp_testXML-node   .
      114       empty temp-table buf_temp_testXML-entity .
      115       empty temp-table buf_temp_testXML-atribut.
      116       assign
      117           v-xmldom-key = 0
      118           mTransaction = yes
      119       .
      120   end.
      121   end .
      122   procedure xmldom-add :
      123   define input parameter p-node-name      as character        no-undo.
      124   define input parameter p-entity-name    as character        no-undo.
      125   define input parameter p-entity-value   as character        no-undo.
      126       define buffer buf_temp_testXML-node         for temp_testXML-node.
      127       define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      128   do
      129   for buf_temp_testXML-node
      130     , buf_temp_testXML-entity
      131   on error undo, return error
      132   :
      133       find last buf_temp_testXML-node
      134       use-index pi no-error.
      135       if not available buf_temp_testXML-node
      136       then do:
      137           assign
      138               v-xmldom-key = 0
      139           .
      140       end.
      141       else do:
      142           assign
      143               v-xmldom-key = buf_temp_testXML-node.xmh-key
      144           .
      145       end.
      146       find last buf_temp_testXML-entity
      147       use-index pi
      148       no-error.
      149       if available buf_temp_testXML-entity
      150       then do:
      151           assign
      152               v-xmldom-key = max(v-xmldom-key,buf_temp_testXML-entity.xme-key)
      153           .
      154       end.
      155       find first buf_temp_testXML-node
      156            where buf_temp_testXML-node.xmhNodName = p-node-name
      157       no-error.
      158       if not available buf_temp_testXML-node
      159       then do:
      160           assign
      161               v-xmldom-key = v-xmldom-key + 1
      162           .
      163           create buf_temp_testXML-node.
      164           assign
      165               buf_temp_testXML-node.xmh-key    = v-xmldom-key
      166               buf_temp_testXML-node.xmhNodName = p-node-name
      167           .
      168       end.
      169       assign
      170           v-xmldom-key = v-xmldom-key + 1
      171       .
      172       create buf_temp_testXML-entity.
      173       assign
      174           buf_temp_testXML-entity.xme-key      = v-xmldom-key
      175           buf_temp_testXML-entity.xmh-key      = buf_temp_testXML-node.xmh-key
      176           buf_temp_testXML-entity.xmeEntName   = p-entity-name
      177           buf_temp_testXML-entity.xmeEntValue  = p-entity-value
      178       .
      179   end.
      180   end.
      181   function  xmldom-save-next-level  returns character
      182      ( iKey         as integer,
      183      i-doc-handle as handle,
      184      i-row-handle as handle):
      185      define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      186      define buffer temp_testXML-atribut          for temp_testXML-atribut.
      187      define variable v-field-handle  as handle           no-undo.
      188      define variable v-text-handle   as handle           no-undo.
      189      create x-noderef v-field-handle.
      190      create x-noderef v-text-handle.
      191      for each buf_temp_testXML-entity
      192         where buf_temp_testXML-entity.xmh-key = iKey
      193           and not buf_temp_testXML-entity.xmeEntName begins "#"
      194      on error undo, return error:
      195         i-doc-handle :create-node ( v-field-handle, buf_temp_testXML-entity.xmeEntName , "ELEMENT" ).
      196         for each temp_testXML-atribut where temp_testXML-atribut.xme-key eq buf_temp_testXML-entity.xme-key
      197         no-lock:
      198            v-field-handle:SET-ATTRIBUTE(temp_testXML-atribut.xmeatrName,temp_testXML-atribut.xmeAtrValue).
      199         end.
      200         i-row-handle :append-child ( v-field-handle ).
      201         i-doc-handle :create-node ( v-text-handle, buf_temp_testXML-entity.xmeEntValue, "TEXT" ).
      202         v-field-handle :append-child ( v-text-handle ).
      203         if buf_temp_testXML-entity.xmeEntValue eq ?  then buf_temp_testXML-entity.xmeEntValue = "unknown_value".
      204         v-text-handle :node-value = buf_temp_testXML-entity.xmeEntValue.
      205        xmldom-save-next-level(buf_temp_testXML-entity.xme-key, i-doc-handle,v-field-handle).
      206      end.
      207      delete object v-field-handle.
      208      delete object v-text-handle.
      209   end.
      210   procedure xmldom-save :
      211   define input parameter result  as character        no-undo.
      212   define variable iType  as character no-undo init "file".
      213       define variable v-doc-handle    as handle           no-undo.
      214       define variable v-root-handle   as handle           no-undo.
      215       define variable v-row-handle    as handle           no-undo.
      216       define variable v-buf-handle    as handle           no-undo.
      217       define buffer buf_temp_testXML-node         for temp_testXML-node.
      218   do
      219   for buf_temp_testXML-node
      220   on error undo, return error
      221   :
      222       create x-document v-doc-handle.
      223       assign
      224           v-doc-handle :encoding = "windows-1251":U
      225       .
      226       create x-noderef v-root-handle.
      227       v-doc-handle :create-node ( v-root-handle, mRoot, "ELEMENT" ).
      228       v-doc-handle :append-child ( v-root-handle ).
      229       for each buf_temp_testXML-node where not buf_temp_testXML-node.xmhNodName begins "#"
      230       on error undo, return error
      231       :
      232           assign
      233               v-buf-handle = buffer buf_temp_testxml-node :handle
      234           .
      235           create x-noderef v-row-handle.
      236           v-doc-handle :create-node ( v-row-handle, buf_temp_testXML-node.xmhNodName, "ELEMENT" ).
      237           for each temp_testXML-atribut where temp_testXML-atribut.xme-key eq buf_temp_testXML-node.xmh-key
      238           no-lock:
      239              v-row-handle:SET-ATTRIBUTE(temp_testXML-atribut.xmeatrName,temp_testXML-atribut.xmeAtrValue).
      240           end.
      241           v-root-handle :append-child ( v-row-handle ).
      242           xmldom-save-next-level(buf_temp_testXML-node.xmh-key,v-doc-handle,v-row-handle).
      243           delete object v-row-handle.
      244       end.
      245       if    iType eq "file"
      246       then do:
      247          os-delete result.
      248          v-doc-handle :save ( iType, result ).
      249          output stream xmldom-out to value( result ) append.
      250          put stream xmldom-out unformatted chr(10).
      251          output stream xmldom-out close.
      252       end.
      253       else if iType eq "memptr"
      254       then
      255          v-doc-handle :save ( iType, result ).
      256       else
      257          v-doc-handle :save ( "file", iType ).
      258       delete object v-doc-handle.
      259       delete object v-root-handle.
      260   end.
      261   end .
      262   function  xmldom-load-atribut returns logical
      263      (IParent    as handle,
      264      iParentkey as integer
      265      ):
      266      def var vanames as char no-undo.
      267      def var vname as char no-undo.
      268      define buffer temp_testXML-atribut          for temp_testXML-atribut.
      269      def var vi      as integer  no-undo.
      270      vanames = IParent:ATTRIBUTE-NAMES.
      271      do vi = 1 TO NUM-ENTRIES(vanames):
      272         vname = ENTRY(vi, vanames).
      273         create temp_testXML-atribut.
      274         assign
      275            temp_testXML-atribut.xme-key     = iParentkey
      276            temp_testXML-atribut.xmeatrName  = vname
      277            temp_testXML-atribut.xmeAtrValue = IParent:GET-ATTRIBUTE(vname)
      278         .
      279      END.
      280   end.
      281   define variable m-xme-key       as integer      no-undo.
      282   function  xmldom-load-next-level returns logical
      283      (IParent    as handle,
      284      iParentkey as integer ,
      285      ifilever as int):
      286      define variable v-field-handle  as handle           no-undo.
      287      define variable v-text-handle   as handle           no-undo.
      288      define variable v-field-counter as integer          no-undo.
      289      define variable v-field-amount  as integer          no-undo.
      290      define variable vDateActive as date no-undo.
      291      define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      292      create x-noderef v-field-handle.
      293      create x-noderef v-text-handle.
      294      assign
      295         v-field-amount = IParent :num-children
      296      .
      297      repeat v-field-counter = 1 to v-field-amount:
      298         IParent :get-child ( v-field-handle, v-field-counter ).
      299         if v-field-handle :num-children < 1
      300         then do:
      301            next.
      302         end.
      303         create buf_temp_testXML-entity.
      304         assign
      305            m-xme-key = m-xme-key + 1
      306            buf_temp_testXML-entity.xme-key     = m-xme-key
      307            buf_temp_testXML-entity.xmh-key     = iParentkey
      308         .
      309         v-field-handle :get-child ( v-text-handle, 1 ).
      310         if     IParent:name         eq "file-info"
      311            and v-field-handle :name eq "version"
      312         then do:
      313            mverfile = int(v-text-handle :node-value)no-error.
      314            if     ifilever ne ?
      315            then do:
      316               if  mverfile  eq ifilever
      317               then do:
      318                  for each buf_temp_testXML-entity:
      319                     delete buf_temp_testXML-entity.
      320                  end.
      321                  return yes.
      322               end.
      323            end.
      324         end.
      325         else if     IParent:name         eq "file-info"
      326                 and v-field-handle :name eq "DateActive"
      327         then do:
      328            vDateActive = date(v-text-handle :node-value)no-error.
      329            if     vDateActive ne ?
      330            then do:
      331               if  vDateActive  lt today
      332               then do:
      333                  for each buf_temp_testXML-entity:
      334                     delete buf_temp_testXML-entity.
      335                  end.
      336                  return yes.
      337               end.
      338            end.
      339         end.
      340         else if     IParent:name         eq "file-info"
      341                 and v-field-handle :name eq "NoTransaction"
      342         then do:
      343           mTransaction = no.
      344         end.
      345         assign
      346            buf_temp_testXML-entity.xmeEntName   = v-field-handle :name
      347            buf_temp_testXML-entity.xmeEntValue  = v-text-handle :node-value
      348         .
      349         if buf_temp_testXML-entity.xmeEntValue eq "unknown_value"  then buf_temp_testXML-entity.xmeEntValue = ?.
      350         xmldom-load-atribut(v-field-handle,buf_temp_testXML-entity.xme-key).
      351         xmldom-load-next-level (v-field-handle,buf_temp_testXML-entity.xme-key, ifilever ).
      352      end.
      353      delete object v-text-handle.
      354      delete object v-field-handle.
      355   end.
      356   function  xmldom-load-ver returns character
      357    (i-full-filename    as character ,
      358      ifilever as integer ):
      359      define variable v-doc-handle    as handle           no-undo.
      360      define variable v-root-handle   as handle           no-undo.
      361      define variable v-table-handle  as handle           no-undo.
      362      define variable v-table-counter as integer      no-undo.
      363      define variable v-table-amount  as integer      no-undo.
      364      define buffer buf_temp_testXML-node         for temp_testXML-node.
      365      mverfile = ?.
      366      mverfile_text = ?.
      367      do
      368      for buf_temp_testXML-node
      369      on error undo, return error
      370      :
      371         assign
      372            i-full-filename = search( i-full-filename )
      373         .
      374         if i-full-filename = ?
      375         then do:
      376            undo, return "Загружаемый файл не найден.".
      377         end.
      378         create x-document v-doc-handle.
      379         v-doc-handle :encoding = "windows-1251":U.
      380         create x-noderef v-root-handle.
      381         create x-noderef v-table-handle.
      382         v-doc-handle :load ( "file", i-full-filename, true ) no-error.
      383         if    error-status :error
      384            or not valid-handle ( v-doc-handle )
      385            or v-doc-handle = ?
      386         then do:
      387            undo, return error vss-description + substitute( "Ошибка загрузки XML-файла &1", i-full-filename ).
      388         end.
      389         v-doc-handle :get-document-element ( v-root-handle ) no-error.
      390         if    error-status :error
      391            or not valid-handle ( v-root-handle )
      392            or v-root-handle = ?
      393         then do:
      394            undo, return error vss-description + substitute( "Ошибка чтения корневого тэга XML-файла &1", i-full-filename ).
      395         end.
      396         assign
      397            v-table-amount = v-root-handle :num-children
      398         no-error.
      399         if    error-status :error
      400            or v-table-amount = ?
      401         then do:
      402            undo, return error vss-description + substitute( ".&1Неверная структура XML-файла &2", chr(10), i-full-filename ).
      403         end.
      404         m-xme-key = v-table-amount +  1.
      405           repeat v-table-counter = 1 to v-table-amount:
      406            v-root-handle :get-child ( v-table-handle, v-table-counter ).
      407            create buf_temp_testXML-node.
      408            assign
      409               buf_temp_testXML-node.xmh-key       = v-table-counter
      410               buf_temp_testXML-node.xmhNodName    = v-table-handle :name
      411            .
      412            xmldom-load-atribut(v-table-handle,buf_temp_testXML-node.xmh-key).
      413            if xmldom-load-next-level (v-table-handle,buf_temp_testXML-node.xmh-key,ifilever)
      414            then do:
      415               for each buf_temp_testXML-node:
      416                  delete buf_temp_testXML-node.
      417               end.
      418               undo, return "Данные уже загружены.".
      419            end.
      420         end.
      421         delete object v-root-handle.
      422         delete object v-doc-handle.
      423         return mverfile_text.
      424      end.
      425   end .
      426   procedure xmldom-load :
      427   define input parameter p-full-filename  as character        no-undo.
      428    xmldom-load-ver(p-full-filename,?) .
      429   end.
      430   function getEnties returns character
      431   (input  i-parkey      as integer ,
      432                                            input i-entity-name    as character ,
      433                                            output o-entity-value  as character,
      434                                            output o-found         as logical ):
      435       define variable v-entity-name       as character no-undo.
      436       define variable v-entity-name-next  as character no-undo.
      437       define buffer buf_temp_testXML-entity    for temp_testXML-entity.
      438       v-entity-name     = entry(1,i-entity-name).
      439       if num-entries(i-entity-name) > 1
      440       then
      441          assign
      442             v-entity-name-next =  substring (i-entity-name,length(v-entity-name) + 2)
      443          .
      444       find first buf_temp_testXML-entity
      445                where buf_temp_testXML-entity.xmh-key      = i-parkey
      446                  and buf_temp_testXML-entity.xmeEntName   = v-entity-name
      447           no-error.
      448       if available buf_temp_testXML-entity
      449       then do:
      450          if v-entity-name-next eq ""
      451          then assign
      452             o-entity-value = buf_temp_testXML-entity.xmeEntValue
      453             o-found        = yes
      454          .
      455          else do :
      456              getEnties(buf_temp_testXML-entity.xme-key,v-entity-name-next,output o-entity-value,output o-found).
      457          end.
      458       end.
      459   end .
      460   procedure xmldom-read-unique :
      461   define input parameter i-node-name      as character        no-undo.
      462   define input parameter i-entity-name    as character        no-undo.
      463   define output parameter o-entity-value  as character        no-undo.
      464   define output parameter o-found         as logical          no-undo.
      465   define variable v-entity-l1-name  as character no-undo.
      466   define variable v-entity-l2-name  as character no-undo.
      467       define buffer buf_temp_testXML-node         for temp_testXML-node.
      468   do
      469   for buf_temp_testXML-node
      470   on error undo, return error
      471   :
      472       assign
      473           o-found = no
      474       .
      475       search-all-nodes:
      476       for each buf_temp_testXML-node
      477          where buf_temp_testXML-node.xmhNodName = i-node-name
      478       :
      479           getEnties(buf_temp_testXML-node.xmh-key,i-entity-name,output o-entity-value,output o-found).
      480      end.
      481   end.
      482   end .
      483   define variable v-file-name as character no-undo .
      484   define variable v-old-dir1  as character no-undo .
      485   define variable v-old-dir2  as character no-undo .
      486   define variable v-old-dir3  as character no-undo .
      487   define stream sinp .
      488   DEFINE VAR upg-load AS WIDGET-HANDLE NO-UNDO.
      489   DEFINE BUTTON b-compare DEFAULT
      490        LABEL "&Сравнение"
      491        SIZE 13 BY 1.
      492   DEFINE BUTTON b-quit DEFAULT
      493        LABEL "Вы&ход"
      494        SIZE 10 BY 1.
      495   DEFINE VARIABLE log-edit AS CHARACTER
      496        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      497        SIZE 76.13 BY 13.92 NO-UNDO.
      498   DEFINE FRAME DEFAULT-FRAME
      499        b-compare AT ROW 1 COL 1
      500        b-quit AT ROW 1 COL 14
      501        log-edit AT ROW 2.29 COL 2.5 NO-LABEL
      502       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      503            SIDE-LABELS THREE-D
      504            AT COL 1 ROW 1
      505            SIZE 78.63 BY 15.92.
      506   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      507     CREATE WINDOW upg-load ASSIGN
      508            HIDDEN             = YES
      509            TITLE              = "Сравнение *.r кодов"
      510            HEIGHT             = 15.92
      511            WIDTH              = 78.63
      512            MAX-HEIGHT         = 23.04
      513            MAX-WIDTH          = 100
      514            VIRTUAL-HEIGHT     = 23.04
      515            VIRTUAL-WIDTH      = 100
      516            RESIZE             = no
      517            SCROLL-BARS        = no
      518            STATUS-AREA        = no
      519            BGCOLOR            = ?
      520            FGCOLOR            = ?
      521            KEEP-FRAME-Z-ORDER = yes
      522            THREE-D            = yes
      523            MESSAGE-AREA       = no
      524            SENSITIVE          = yes.
      525   ELSE upg-load = CURRENT-WINDOW.
      526   ASSIGN
      527          FRAME DEFAULT-FRAME:HIDDEN           = TRUE.
      528   ASSIGN
      529          log-edit:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
      530   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(upg-load)
      531   THEN upg-load:HIDDEN = no.
      532   ON END-ERROR OF upg-load
      533   OR ENDKEY OF upg-load ANYWHERE DO:
      534     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
      535   END.
      536   ON WINDOW-CLOSE OF upg-load
      537   DO:
      538     APPLY "CLOSE":U TO THIS-PROCEDURE.
      539     RETURN NO-APPLY.
      540   END.
      541   ON CHOOSE OF b-compare IN FRAME DEFAULT-FRAME
      542   DO:
      543     run start-compile in this-procedure .
      544   END.
      545   ON CHOOSE OF b-quit IN FRAME DEFAULT-FRAME
      546   DO:
      547     QUIT .
      548   END.
      549   ASSIGN CURRENT-WINDOW                = upg-load
      550          THIS-PROCEDURE:CURRENT-WINDOW = upg-load.
      551   ON CLOSE OF THIS-PROCEDURE
      552      RUN disable_UI.
      553   PAUSE 0 BEFORE-HIDE.
      554   MAIN-BLOCK:
      555   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      556      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      557     RUN enable_UI.
      558     IF NOT THIS-PROCEDURE:PERSISTENT THEN
      559       WAIT-FOR CLOSE OF THIS-PROCEDURE.
      560     quit .
      561   END.
      562   PROCEDURE callback-write-to-log :
      563     define input parameter p-msg-str as character no-undo .
      564     define variable lok as logical   no-undo .
      565     do with frame DEFAULT-FRAME
      566     on error undo, return error
      567     :
      568       assign
      569         lok = log-edit :move-to-eof( )
      570         lok = log-edit :insert-string( p-msg-str )
      571         lok = log-edit :move-to-eof( )
      572       .
      573     end.
      574   END PROCEDURE.
      575   PROCEDURE disable_UI :
      576     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(upg-load)
      577     THEN DELETE WIDGET upg-load.
      578     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      579   END PROCEDURE.
      580   PROCEDURE enable_UI :
      581     DISPLAY log-edit
      582         WITH FRAME DEFAULT-FRAME IN WINDOW upg-load.
      583     ENABLE b-compare b-quit log-edit
      584         WITH FRAME DEFAULT-FRAME IN WINDOW upg-load.
      585     VIEW FRAME DEFAULT-FRAME IN WINDOW upg-load.
      586     VIEW upg-load.
      587   END PROCEDURE.
      588   PROCEDURE read-parameters :
      589   define input  parameter p-file-name    as character no-undo .
      590   define output parameter p-dir1         as character no-undo .
      591   define output parameter p-dir2         as character no-undo .
      592   define output parameter p-dir3         as character no-undo .
      593       define variable v-tag-value as character    no-undo.
      594       define variable v-found     as logical      no-undo.
      595   do
      596   on error undo, return error return-value
      597   :
      598       run xmldom-clear in this-procedure.
      599       run xmldom-load in this-procedure ( p-file-name ) no-error.
      600       if error-status :error
      601       then do:
      602           message
      603                    vss-workfile vss-revision vss-description
      604               skip(1)
      605               skip "Ошибка чтения файла конфигурации."
      606               skip return-value
      607               skip trim( error-status :get-message( 1 ) )
      608                    trim( error-status :get-message( 2 ) )
      609                    trim( error-status :get-message( 3 ) )
      610           view-as alert-box error.
      611           undo, return error.
      612       end.
      613       run xmldom-read-unique in this-procedure ( input "comparer":U, input "version":U, output v-tag-value, output v-found   ).
      614       if v-found = no
      615       or v-tag-value <> "2.0":U
      616       then do:
      617           message
      618               "Несовместимый формат файла параметров компиляции"
      619               skip "Файл параметров компиляции:"
      620               skip p-file-name
      621               skip (1)
      622               skip "Программа рассчитана на считывание файла параметров "
      623               skip "Версии 2.0 "
      624           view-as alert-box error
      625           title "Параметры компиляции".
      626           return .
      627       end.
      628       run xmldom-read-unique in this-procedure ( input "comparer":U, input "directory_old":U      , output p-dir1, output v-found   ).
      629       run xmldom-read-unique in this-procedure ( input "comparer":U, input "directory_new":U      , output p-dir2, output v-found   ).
      630       run xmldom-read-unique in this-procedure ( input "comparer":U, input "directory_patch":U    , output p-dir3, output v-found   ).
      631   end.
      632   END PROCEDURE.
      633   PROCEDURE save-parameters :
      634     define input  parameter p-file-name as character no-undo .
      635     define input  parameter p-dir1      as character no-undo .
      636     define input  parameter p-dir2      as character no-undo .
      637     define input  parameter p-dir3      as character no-undo .
      638     define variable v-full-path        as character no-undo .
      639     define variable v-path             as character no-undo .
      640     define variable v-file-name        as character no-undo .
      641     define variable v-file-name-no-ext as character no-undo .
      642     define variable v-file-name-ext    as character no-undo .
      643     define variable v-backup-file-name as character no-undo .
      644   do
      645   on error undo, return error return-value
      646   :
      647       run xmldom-clear in this-procedure .
      648       run xmldom-add in this-procedure ( input "comparer":U, input "version":U        , input "2.0":U ).
      649       run xmldom-add in this-procedure ( input "comparer":U, input "directory_old":U  , input p-dir1  ).
      650       run xmldom-add in this-procedure ( input "comparer":U, input "directory_new":U  , input p-dir2  ).
      651       run xmldom-add in this-procedure ( input "comparer":U, input "directory_patch":U, input p-dir3  ).
      652       run xmldom-save in this-procedure ( input p-file-name ).
      653   end.
      654   END PROCEDURE.
      655   PROCEDURE start-compile :
      656     define variable v-dir1 as character no-undo .
      657     define variable v-dir2 as character no-undo .
      658     define variable v-dir3 as character no-undo .
      659     define variable v-ok   as logical   no-undo .
      660     assign
      661       v-file-name = session :parameter
      662     .
      663     if v-file-name <> ""
      664     then do:
      665       if  search(v-file-name) <> ""
      666       and search(v-file-name) <> ?
      667       then do:
      668         run read-parameters in this-procedure
      669           (input  search(v-file-name)
      670           ,output v-dir1
      671           ,output v-dir2
      672           ,output v-dir3
      673           ) .
      674       end.
      675       else do:
      676         message
      677           "Не найден файл параметров" skip
      678           "Имя файла" v-file-name skip
      679           view-as alert-box error .
      680       end.
      681     end.
      682     assign
      683       v-old-dir1 = v-dir1
      684       v-old-dir2 = v-dir2
      685       v-old-dir3 = v-dir3
      686     .
      687     run utl/d-dirinp.w
      688       (input-output v-dir1
      689       ,input-output v-dir2
      690       ,input-output v-dir3
      691       ) .
      692     if v-dir1 = ""
      693     or v-dir2 = ""
      694     or v-dir3 = ""
      695     then do:
      696       return .
      697     end.
      698     if v-dir1 <> v-old-dir1
      699     or v-dir2 <> v-old-dir2
      700     or v-dir3 <> v-old-dir3
      701     then do:
      702       if v-file-name <> ""
      703       then do:
      704         assign
      705           v-ok = true
      706         .
      707         message
      708           "Файл с параметрами по умолчанию" search(v-file-name) skip
      709           "Вы изменили параметры сравнения файлов" skip
      710           "Сохранить новые значения параметров?" skip
      711           view-as alert-box question buttons yes-no update v-ok .
      712         if v-ok = true
      713         then do:
      714           run save-parameters in this-procedure
      715             (input  ( if search( v-file-name ) = ? then v-file-name else search( v-file-name ) )
      716             ,input  v-dir1
      717             ,input  v-dir2
      718             ,input  v-dir3
      719             ) .
      720         end.
      721       end.
      722     end.
      723     if  v-file-name <> ""
      724     and v-file-name <> ?
      725     and (search(v-file-name) = ""
      726          or search(v-file-name) = ?
      727         )
      728     then do:
      729       assign
      730         v-ok = true
      731       .
      732       message
      733         "Имя файла" v-file-name skip
      734         "Файл с параметрами по умолчанию отсутствует" skip
      735         "Создать файл с параметрами?" skip
      736         view-as alert-box question buttons yes-no update v-ok .
      737       if v-ok = true
      738       then do:
      739         run save-parameters in this-procedure
      740           (input  v-file-name
      741           ,input  v-dir1
      742           ,input  v-dir2
      743           ,input  v-dir3
      744           ) .
      745       end.
      746     end.
      747     run utl/rcodecmp.p
      748       (input v-dir1
      749       ,input v-dir2
      750       ,input v-dir3
      751       ) .
      752   END PROCEDURE.
