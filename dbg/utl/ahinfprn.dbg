        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-ah-infov-handle as handle    no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: ahinfprn.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: utl/ahinfprn.p $":U .
        9   define variable vss-description as character no-undo initial "Печать информации по архивам по товарам, по поставщикам, по типам приобретени".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define  shared variable RepPathName        as character no-undo .
       73   define  shared variable PrintRubl          as logical   no-undo .
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  stream PrnLibStream.
       76   procedure prn-lib-prn-file :
       77     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       78     define input parameter p-DIsabledoptions as integer no-undo .
       79     define variable v-report-name as character no-undo .
       80     define variable v-user-action as character no-undo .
       81     define variable v-printed     as logical   no-undo .
       82     define variable v-exist       as logical   no-undo .
       83     do
       84       on error undo, return error
       85       :
       86       run prn-lib-get-report-name  in this-procedure (
       87         input parParentProc
       88         ,output v-report-name
       89         ).
       90   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       92     (input  v-report-name
       93     ,input  2
       94     ,output v-exist
       95     )  .
       96       if NOT v-exist then
       97       DO:
       98         Message
       99           "Нет заданий на печать ! "
      100           view-as alert-box .
      101         Return  .
      102       End.
      103       run gbl/prnfilen.w
      104         (input  ""
      105         ,input  p-DisabledOptions
      106         ,input  string(v-report-name )
      107         ,input  7
      108         ,output v-user-action
      109         ,output v-printed
      110         ) .
      111       if v-printed then
      112       do:
      113         return "YES" .
      114       end.
      115       else
      116       do:
      117         return "NO" .
      118       end.
      119     end.
      120   end procedure.
      121   procedure prn-lib-open-stream :
      122     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      123     define input parameter p-page-size    as integer no-undo .
      124     define input parameter p-is-stream    as logical no-undo .
      125     define input parameter p-append       as logical no-undo .
      126     define variable v-report-name as character no-undo .
      127     do
      128       on error undo, return error
      129       :
      130       run prn-lib-get-report-name  in this-procedure (
      131         input parParentProc
      132         ,output v-report-name
      133         ).
      134       if p-is-stream then
      135       do:
      136         if p-append then
      137         do:
      138           output stream PrnLibStream to value( v-report-name )
      139             page-size value(p-page-size) append .
      140         end.
      141         if not p-append then
      142         do:
      143           output stream PrnLibStream to value( v-report-name )
      144             page-size value(p-page-size) .
      145         end.
      146       end.
      147       if not p-is-stream then
      148       do:
      149         if p-append then
      150         do:
      151           output to value( v-report-name )
      152             page-size value(p-page-size) append .
      153         end.
      154         if not p-append then
      155         do:
      156           output to value( v-report-name )
      157             page-size value(p-page-size) .
      158         end.
      159       end.
      160     end.
      161   end procedure.
      162   procedure prn-lib-open-exp :
      163     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      164     define input parameter p-is-stream    as logical no-undo .
      165     define input parameter p-is-append    as logical no-undo .
      166     define output parameter p-ReportFileName as char init "report" no-undo.
      167     define output parameter p-process as logical no-undo .
      168     define variable glog as logical no-undo .
      169     do
      170       on error undo, return error
      171       :
      172       SYSTEM-DIALOG GET-FILE p-ReportFileName
      173         TITLE      "Укажите путь"
      174         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      175         ASK-OVERWRITE
      176         CREATE-TEST-FILE
      177         SAVE-AS
      178         USE-FILENAME
      179         DEFAULT-EXTENSION "txt"
      180         UPDATE glog
      181         .
      182       if not glog then  return.
      183       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      184       if p-is-stream then
      185       do:
      186         if p-is-append then
      187         do:
      188           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      189         end.
      190         else
      191         do:
      192           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      193         end.
      194       end.
      195       else
      196       do:
      197         if p-is-append then
      198         do:
      199           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      200         end.
      201         else
      202         do:
      203           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      204         end.
      205       end.
      206       p-process = yes.
      207     end.
      208   end procedure.
      209   procedure prn-lib-get-report-name :
      210     define input parameter parParentProc  as widget-handle no-undo.
      211     define output parameter p-report-name as character no-undo .
      212     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      213   end procedure.
      214   procedure prn-lib-reportviewer-report-name :
      215     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      216     define input parameter p-report-name-html as character no-undo .
      217     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      218   end procedure.
      219   procedure prn-lib-reportviewer :
      220     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      221     define input parameter p-report-name-html as character no-undo .
      222     define input parameter p-param        as character no-undo .
      223     define variable v-excel           as character no-undo init 'TRUE' .
      224     define variable v-value-character as character no-undo .
      225     define variable v-value-integer   as character no-undo .
      226     define variable v-value-date      as date      no-undo .
      227     define variable v-value-decimal   as decimal   no-undo .
      228     define variable rep-excel         as logical   no-undo .
      229     define variable excel-string      as character no-undo .
      230     define variable v-param-type      as character no-undo .
      231     define variable v-tth             as handle    no-undo .
      232     run adm/shattri.p (
      233       input "get":U
      234       ,input  ""
      235       ,input  0
      236       ,input  'report-glob':U
      237       ,input  'rep-excel':U
      238       ,output v-value-character
      239       ,output v-value-date
      240       ,output v-value-decimal
      241       ,output v-value-integer
      242       ,output rep-excel
      243       ,output v-param-type
      244       ,INPUT-OUTPUT table-handle v-tth
      245       )  .
      246     if rep-excel then v-excel = "TRUE" .
      247     else v-excel = "FALSE" .
      248     if p-param eq ""
      249     then
      250        p-param = "EXCEL:" + v-excel.
      251     else
      252        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      253     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      254   end procedure.
      255   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   procedure arhisatr_encode-attr :
      257     define input  parameter p-attr-calc        as logical   no-undo .
      258     define input  parameter p-attr-del         as logical   no-undo .
      259     define input  parameter p-attr-disable     as logical   no-undo .
      260     define input  parameter p-attr-rest        as logical   no-undo .
      261     define output parameter p-attr-encode-calc as logical   no-undo .
      262     define output parameter p-attr-encode-del  as logical   no-undo .
      263     define output parameter p-attr-encode-ps   as character no-undo .
      264     do
      265     on error undo, return error return-value
      266     :
      267       if p-attr-calc = ?
      268       then do:
      269         message
      270           vss-workfile vss-revision vss-description skip
      271           "Внутренняя ошибка" skip
      272           "Атрибут 'Рассчёт архива' имеет неопределённое значение" skip
      273           view-as alert-box error .
      274         undo, return error return-value .
      275       end.
      276       if p-attr-del = ?
      277       then do:
      278         message
      279           vss-workfile vss-revision vss-description skip
      280           "Внутренняя ошибка" skip
      281           "Атрибут 'Требуется первоначальный расчёт архива' имеет неопределённое значение" skip
      282           view-as alert-box error .
      283         undo, return error return-value .
      284       end.
      285       if p-attr-disable = ?
      286       then do:
      287         message
      288           vss-workfile vss-revision vss-description skip
      289           "Внутренняя ошибка" skip
      290           "Атрибут 'Расчет архива выключен' имеет неопределённое значение" skip
      291           view-as alert-box error .
      292         undo, return error return-value .
      293       end.
      294       if p-attr-rest = ?
      295       then do:
      296         message
      297           vss-workfile vss-revision vss-description skip
      298           "Внутренняя ошибка" skip
      299           "Атрибут 'Удаление восстановление архива' имеет неопределённое значение" skip
      300           view-as alert-box error .
      301         undo, return error return-value .
      302       end.
      303       define variable v-total-value    as integer   no-undo .
      304       define variable v-encode-value-1 as integer   no-undo .
      305       define variable v-encode-value-2 as integer   no-undo .
      306       assign
      307         v-total-value = (if p-attr-calc
      308                          then 1
      309                          else 0
      310                         )
      311                         +
      312                         (if p-attr-del
      313                          then 2
      314                          else 0
      315                         )
      316                         +
      317                         (if p-attr-rest
      318                          then 4
      319                          else 0
      320                         )
      321       .
      322       assign
      323         v-encode-value-1 = truncate(v-total-value / 3, 0)
      324         v-encode-value-2 = v-total-value modulo 3
      325       .
      326       case v-encode-value-1
      327       :
      328         when 0
      329         then do:
      330           assign
      331             p-attr-encode-calc = false
      332           .
      333         end.
      334         when 1
      335         then do:
      336           assign
      337             p-attr-encode-calc = true
      338           .
      339         end.
      340         when 2
      341         then do:
      342           assign
      343             p-attr-encode-calc = ?
      344           .
      345         end.
      346         otherwise do:
      347           message
      348             vss-workfile vss-revision vss-description skip
      349             "Внутренняя ошибка" skip
      350             "Неизвестное значение v-encode-value-1" v-encode-value-1 skip
      351             view-as alert-box error .
      352           undo, return error return-value .
      353         end.
      354       end case .
      355       case v-encode-value-2
      356       :
      357         when 0
      358         then do:
      359           assign
      360             p-attr-encode-del = false
      361           .
      362         end.
      363         when 1
      364         then do:
      365           assign
      366             p-attr-encode-del = true
      367           .
      368         end.
      369         when 2
      370         then do:
      371           assign
      372             p-attr-encode-del = ?
      373           .
      374         end.
      375         otherwise do:
      376           message
      377             vss-workfile vss-revision vss-description skip
      378             "Внутренняя ошибка" skip
      379             "Неизвестное значение v-encode-value-2" v-encode-value-2 skip
      380             view-as alert-box error .
      381           undo, return error return-value .
      382         end.
      383       end case .
      384       assign
      385         p-attr-encode-ps = string(p-attr-disable)
      386       .
      387       define variable v-check-p-attr-calc    as logical   no-undo .
      388       define variable v-check-p-attr-del     as logical   no-undo .
      389       define variable v-check-p-attr-disable as logical   no-undo .
      390       define variable v-check-p-attr-rest    as logical   no-undo .
      391       run arhisatr_decode-attr in this-procedure
      392         (input  p-attr-encode-calc
      393         ,input  p-attr-encode-del
      394         ,input  p-attr-encode-ps
      395         ,output v-check-p-attr-calc
      396         ,output v-check-p-attr-del
      397         ,output v-check-p-attr-disable
      398         ,output v-check-p-attr-rest
      399         ) .
      400       if p-attr-calc    <> v-check-p-attr-calc
      401       or p-attr-del     <> v-check-p-attr-del
      402       or p-attr-disable <> v-check-p-attr-disable
      403       or p-attr-rest    <> v-check-p-attr-rest
      404       then do:
      405         message
      406           vss-workfile vss-revision vss-description skip
      407           "Внутренняя ошибка" skip
      408           "Не совпадают раскодированные значения" skip
      409           "p-attr-calc"    p-attr-calc    skip
      410           "p-attr-del"     p-attr-del     skip
      411           "p-attr-disable" p-attr-disable skip
      412           "p-attr-rest"    p-attr-rest    skip
      413           "v-check-p-attr-calc"    v-check-p-attr-calc    skip
      414           "v-check-p-attr-del"     v-check-p-attr-del     skip
      415           "v-check-p-attr-disable" v-check-p-attr-disable skip
      416           "v-check-p-attr-rest"    v-check-p-attr-rest    skip
      417           view-as alert-box error .
      418         undo, return error return-value .
      419       end.
      420     end.
      421   end procedure.
      422   procedure arhisatr_decode-attr :
      423     define input  parameter p-attr-decode-calc as logical   no-undo .
      424     define input  parameter p-attr-decode-del  as logical   no-undo .
      425     define input  parameter p-attr-decode-ps   as character no-undo .
      426     define output parameter p-attr-calc        as logical   no-undo .
      427     define output parameter p-attr-del         as logical   no-undo .
      428     define output parameter p-attr-disable     as logical   no-undo .
      429     define output parameter p-attr-rest        as logical   no-undo .
      430     do
      431     on error undo, return error return-value
      432     :
      433       define variable v-total-value    as integer   no-undo .
      434       define variable v-encode-value-1 as integer   no-undo .
      435       define variable v-encode-value-2 as integer   no-undo .
      436       case p-attr-decode-calc
      437       :
      438         when false
      439         then do:
      440           assign
      441             v-encode-value-1 = 0
      442           .
      443         end.
      444         when true
      445         then do:
      446           assign
      447             v-encode-value-1 = 1
      448           .
      449         end.
      450         when ?
      451         then do:
      452           assign
      453             v-encode-value-1 = 2
      454           .
      455         end.
      456         otherwise do:
      457           message
      458             vss-workfile vss-revision vss-description skip
      459             "Внутренняя ошибка" skip
      460             "Неизвестное значение p-attr-decode-calc" p-attr-decode-calc skip
      461             view-as alert-box error .
      462           undo, return error return-value .
      463         end.
      464       end case .
      465       case p-attr-decode-del
      466       :
      467         when false
      468         then do:
      469           assign
      470             v-encode-value-2 = 0
      471           .
      472         end.
      473         when true
      474         then do:
      475           assign
      476             v-encode-value-2 = 1
      477           .
      478         end.
      479         when ?
      480         then do:
      481           assign
      482             v-encode-value-2 = 2
      483           .
      484         end.
      485         otherwise do:
      486           message
      487             vss-workfile vss-revision vss-description skip
      488             "Внутренняя ошибка" skip
      489             "Неизвестное значение p-attr-decode-del" p-attr-decode-del skip
      490             view-as alert-box error .
      491           undo, return error return-value .
      492         end.
      493       end case .
      494       assign
      495         v-total-value = v-encode-value-1 * 3
      496                       + v-encode-value-2
      497       .
      498       define variable v-decode-value-1 as integer   no-undo .
      499       define variable v-decode-value-2 as integer   no-undo .
      500       define variable v-decode-value-3 as integer   no-undo .
      501       assign
      502         v-decode-value-1 = v-total-value modulo 2
      503       .
      504       assign
      505         v-total-value = truncate(v-total-value / 2, 0)
      506       .
      507       assign
      508         v-decode-value-2 = v-total-value modulo 2
      509       .
      510       assign
      511         v-total-value = truncate(v-total-value / 2, 0)
      512       .
      513       assign
      514         v-decode-value-3 = v-total-value
      515       .
      516       case v-decode-value-1
      517       :
      518         when 0
      519         then do:
      520           assign
      521             p-attr-calc = false
      522           .
      523         end.
      524         when 1
      525         then do:
      526           assign
      527             p-attr-calc = true
      528           .
      529         end.
      530         otherwise do:
      531           message
      532             vss-workfile vss-revision vss-description skip
      533             "Внутренняя ошибка" skip
      534             "Неизвестное значение v-decode-value-1" v-decode-value-1 skip
      535             view-as alert-box error .
      536           undo, return error return-value .
      537         end.
      538       end case .
      539       case v-decode-value-2
      540       :
      541         when 0
      542         then do:
      543           assign
      544             p-attr-del = false
      545           .
      546         end.
      547         when 1
      548         then do:
      549           assign
      550             p-attr-del = true
      551           .
      552         end.
      553         otherwise do:
      554           message
      555             vss-workfile vss-revision vss-description skip
      556             "Внутренняя ошибка" skip
      557             "Неизвестное значение v-decode-value-2" v-decode-value-2 skip
      558             view-as alert-box error .
      559           undo, return error return-value .
      560         end.
      561       end case .
      562       case v-decode-value-3
      563       :
      564         when 0
      565         then do:
      566           assign
      567             p-attr-rest = false
      568           .
      569         end.
      570         when 1
      571         then do:
      572           assign
      573             p-attr-rest = true
      574           .
      575         end.
      576         otherwise do:
      577           message
      578             vss-workfile vss-revision vss-description skip
      579             "Внутренняя ошибка" skip
      580             "Неизвестное значение v-decode-value-3" v-decode-value-3 skip
      581             view-as alert-box error .
      582           undo, return error return-value .
      583         end.
      584       end case .
      585       assign
      586         p-attr-disable = lookup(p-attr-decode-ps, 'true,yes':u) > 0
      587       .
      588     end.
      589   end procedure.
      590   function arhisatr_get-calc returns logical
      591   (input p-attr-decode-calc as logical
      592   ,input p-attr-decode-del  as logical
      593   ,input p-attr-decode-ps   as character
      594   )
      595   :
      596     define variable v-attr-calc    as logical   no-undo .
      597     define variable v-attr-del     as logical   no-undo .
      598     define variable v-attr-disable as logical   no-undo .
      599     define variable v-attr-rest    as logical   no-undo .
      600     run arhisatr_decode-attr in this-procedure
      601       (input  p-attr-decode-calc
      602       ,input  p-attr-decode-del
      603       ,input  p-attr-decode-ps
      604       ,output v-attr-calc
      605       ,output v-attr-del
      606       ,output v-attr-disable
      607       ,output v-attr-rest
      608       ) .
      609     return v-attr-calc .
      610   end function .
      611   function arhisatr_get-del returns logical
      612   (input p-attr-decode-calc as logical
      613   ,input p-attr-decode-del  as logical
      614   ,input p-attr-decode-ps   as character
      615   )
      616   :
      617     define variable v-attr-calc    as logical   no-undo .
      618     define variable v-attr-del     as logical   no-undo .
      619     define variable v-attr-disable as logical   no-undo .
      620     define variable v-attr-rest    as logical   no-undo .
      621     run arhisatr_decode-attr in this-procedure
      622       (input  p-attr-decode-calc
      623       ,input  p-attr-decode-del
      624       ,input  p-attr-decode-ps
      625       ,output v-attr-calc
      626       ,output v-attr-del
      627       ,output v-attr-disable
      628       ,output v-attr-rest
      629       ) .
      630     return v-attr-del .
      631   end function .
      632   function arhisatr_get-disable returns logical
      633   (input p-attr-decode-calc as logical
      634   ,input p-attr-decode-del  as logical
      635   ,input p-attr-decode-ps   as character
      636   )
      637   :
      638     define variable v-attr-calc    as logical   no-undo .
      639     define variable v-attr-del     as logical   no-undo .
      640     define variable v-attr-disable as logical   no-undo .
      641     define variable v-attr-rest    as logical   no-undo .
      642     run arhisatr_decode-attr in this-procedure
      643       (input  p-attr-decode-calc
      644       ,input  p-attr-decode-del
      645       ,input  p-attr-decode-ps
      646       ,output v-attr-calc
      647       ,output v-attr-del
      648       ,output v-attr-disable
      649       ,output v-attr-rest
      650       ) .
      651     return v-attr-disable .
      652   end function .
      653   function arhisatr_get-rest returns logical
      654   (input p-attr-decode-calc as logical
      655   ,input p-attr-decode-del  as logical
      656   ,input p-attr-decode-ps   as character
      657   )
      658   :
      659     define variable v-attr-calc    as logical   no-undo .
      660     define variable v-attr-del     as logical   no-undo .
      661     define variable v-attr-disable as logical   no-undo .
      662     define variable v-attr-rest    as logical   no-undo .
      663     run arhisatr_decode-attr in this-procedure
      664       (input  p-attr-decode-calc
      665       ,input  p-attr-decode-del
      666       ,input  p-attr-decode-ps
      667       ,output v-attr-calc
      668       ,output v-attr-del
      669       ,output v-attr-disable
      670       ,output v-attr-rest
      671       ) .
      672     return v-attr-rest .
      673   end function .
      674   do
      675   on error undo, return error return-value
      676   :
      677     define variable v-available                as logical   no-undo .
      678     define variable v-db-num                   as integer   no-undo .
      679     define variable v-obj-type                 as character no-undo .
      680     define variable v-obj-code                 as integer   no-undo .
      681     define variable v-archive-type             as character no-undo .
      682     define variable v-deleted                  as logical   no-undo .
      683     define variable v-archive-calc             as logical   no-undo .
      684     define variable v-archive-del              as logical   no-undo .
      685     define variable v-archive-disable          as logical   no-undo .
      686     define variable v-archive-rest             as logical   no-undo .
      687     define variable v-archive-bpexist          as logical   no-undo .
      688     define variable v-archive-detail-date      as date      no-undo .
      689     define variable v-archive-start-date       as date      no-undo .
      690     define variable v-archive-date-recalc      as date      no-undo .
      691     define variable v-archive-lock-prc         as logical   no-undo .
      692     define variable v-archive-execuser         as character no-undo .
      693     define variable v-archive-execsysdate      as date      no-undo .
      694     define variable v-archive-execsystime      as character no-undo .
      695     define variable v-archive-rest-lock-prc    as logical   no-undo .
      696     define variable v-archive-rest-execuser    as character no-undo .
      697     define variable v-archive-rest-execsysdate as date      no-undo .
      698     define variable v-archive-rest-execsystime as character no-undo .
      699     define variable v-archive-type-name     as character no-undo .
      700     define variable v-description           as character no-undo .
      701     if valid-handle(p-ah-infov-handle) <> true
      702     then do:
      703       message
      704         vss-workfile vss-revision vss-description skip
      705         "Ошибка задания входных параметров" skip
      706         "Неправильный указатель на процедуру p-ah-infov-handle" skip
      707         "p-ah-infov-handle" p-ah-infov-handle skip
      708         view-as alert-box error .
      709       undo, return error return-value .
      710     end.
      711     run ah-infov_get-current in p-ah-infov-handle
      712       (output v-available
      713       ,output v-db-num
      714       ,output v-obj-type
      715       ,output v-obj-code
      716       ,output v-archive-type
      717       ,output v-deleted
      718       ,output v-archive-calc
      719       ,output v-archive-del
      720       ,output v-archive-disable
      721       ,output v-archive-rest
      722       ,output v-archive-bpexist
      723       ,output v-archive-detail-date
      724       ,output v-archive-start-date
      725       ,output v-archive-date-recalc
      726       ,output v-archive-lock-prc
      727       ,output v-archive-execuser
      728       ,output v-archive-execsysdate
      729       ,output v-archive-execsystime
      730       ,output v-archive-rest-lock-prc
      731       ,output v-archive-rest-execuser
      732       ,output v-archive-rest-execsysdate
      733       ,output v-archive-rest-execsystime
      734       ) .
      735     if v-available <> true
      736     then do:
      737       message
      738         vss-workfile vss-revision vss-description skip
      739         "Ошибка задания входных параметров" skip
      740         "Недоступна запись информации об архиве" skip
      741         error-status :get-message(1) skip
      742         return-value skip
      743         view-as alert-box error .
      744       return .
      745     end.
      746     run ah-infov_archive-type-name-proc in p-ah-infov-handle
      747       (input  v-archive-type
      748       ,output v-archive-type-name
      749       ) .
      750     run ah-infov_get-description in p-ah-infov-handle
      751       (output v-description
      752       ) .
      753     run prn-lib-open-stream  in this-procedure (
      754                                                 input parParentProc
      755                                                 ,input 43
      756                                                 ,input yes
      757                                                 ,input no
      758                                                 ).
      759     put stream PrnLibStream unformatted
      760       "Складской архив " + v-archive-type-name + ". " + v-description
      761       skip
      762       .
      763     put stream PrnLibStream unformatted
      764       " "
      765       skip
      766       .
      767     define buffer buf_sys-ctrl for ub.sys-ctrl .
      768     define buffer buf_db for ub.db .
      769     find buf_sys-ctrl .
      770     find first buf_db no-lock
      771       where buf_db.db-num = buf_sys-ctrl.db-num
      772       .
      773     put stream PrnLibStream unformatted
      774       "Текущая база данных:     " + string(buf_db.db-num) + " " + buf_db.db-name
      775       skip
      776       .
      777     define buffer buf_clients for ub.clients .
      778     find first buf_clients no-lock
      779       where buf_clients.obj-type = v-obj-type
      780         and buf_clients.obj-code = v-obj-code
      781       .
      782     put stream PrnLibStream unformatted
      783       "Объект:                  " + v-obj-type + " " + string(v-obj-code) + "  " + buf_clients.obj-name
      784       skip
      785       .
      786     find first buf_db no-lock
      787       where buf_db.db-num = v-db-num
      788       .
      789     put stream PrnLibStream unformatted
      790       "База данных объекта:     " + string(v-db-num) + " " + buf_db.db-name
      791       skip
      792       .
      793     if v-deleted = true
      794     then do:
      795       put stream PrnLibStream unformatted
      796         "                         " + "Объект удалён"
      797         skip
      798         .
      799     end.
      800     put stream PrnLibStream unformatted
      801       " "
      802       skip
      803       .
      804     if v-archive-del = true
      805     then do:
      806       if v-archive-disable = true
      807       then do:
      808         put stream PrnLibStream unformatted
      809           "                         " + "РАСЧЕТ АРХИВА ВЫКЛЮЧЕН"
      810           skip
      811           .
      812       end.
      813       else do:
      814         put stream PrnLibStream unformatted
      815           "                         " + "НЕ РАССЧИТАН НАЧАЛЬНЫЙ ОСТАТОК"
      816           skip
      817           .
      818       end.
      819     end.
      820     if v-archive-calc = true
      821     then do:
      822       put stream PrnLibStream unformatted
      823         "                         " + "НЕ РАССЧИТАН ОБОРОТ"
      824         skip
      825         .
      826     end.
      827     if v-archive-rest = true
      828     then do:
      829       put stream PrnLibStream unformatted
      830         "                         " + "СБОЙ УДАЛЕНИЯ/ВОССТАНОВЛЕНИЯ"
      831         skip
      832         .
      833     end.
      834     put stream PrnLibStream unformatted
      835       "Начало подробного:       " + substitute('&1', string(v-archive-detail-date, '99/99/9999':u))
      836       skip
      837       .
      838     put stream PrnLibStream unformatted
      839       "Начало сжатого:          " + substitute('&1', string(v-archive-start-date, '99/99/9999':u))
      840       skip
      841       .
      842     put stream PrnLibStream unformatted
      843       "Дата перерасчёта:        " + substitute('&1', string(v-archive-date-recalc, '99/99/9999':u))
      844       skip
      845       .
      846     if v-archive-lock-prc = true
      847     then do:
      848       put stream PrnLibStream unformatted
      849         " "
      850         skip
      851         .
      852       put stream PrnLibStream unformatted
      853         "                         " + "РАСЧЁТ АРХИВА"
      854         skip
      855         .
      856       put stream PrnLibStream unformatted
      857         "Пользователь:            " + substitute('&1', string(v-archive-execuser, '99/99/9999':u))
      858         skip
      859         .
      860       put stream PrnLibStream unformatted
      861         "Дата и время:            " + substitute('&1', string(v-archive-execsysdate, '99/99/9999':u))
      862                                     + substitute('&1', string(v-archive-execsystime, 'HH:MM:SS':u))
      863         skip
      864         .
      865     end.
      866     if v-archive-bpexist = true
      867     then do:
      868       put stream PrnLibStream unformatted
      869         " "
      870         skip
      871         .
      872       put stream PrnLibStream unformatted
      873         "Имеются задания на расчет архива"
      874         skip
      875         .
      876     end.
      877     put stream PrnLibStream unformatted
      878       " "
      879       skip
      880       .
      881     define buffer buf_archive-history for archive-history .
      882     define query q-hist for buf_archive-history scrolling .
      883     open query q-hist for each buf_archive-history no-lock
      884       where buf_archive-history.archive-type  = v-archive-type
      885         and buf_archive-history.obj-type      = v-obj-type
      886         and buf_archive-history.obj-code      = v-obj-code
      887       use-index ishow
      888       by buf_archive-history.chip-num descending
      889       .
      890     get first q-hist .
      891     put stream PrnLibStream unformatted
      892       " "
      893       skip
      894       .
      895     put stream PrnLibStream unformatted
      896       "История операций"
      897       skip
      898       .
      899     define variable v-print-header as logical   no-undo .
      900     assign
      901       v-print-header = true
      902     .
      903     define variable v-delimiter as character no-undo .
      904     assign
      905       v-delimiter = fill('-':u, 197)
      906     .
      907     do while available buf_archive-history
      908     :
      909       if line-counter(PrnLibStream) > page-size(PrnLibStream) - 2
      910       then do:
      911         put stream PrnLibStream unformatted
      912           v-delimiter skip
      913           fill(" ", 54) + "Продолжение на следующей странице" skip
      914           .
      915         page stream PrnLibStream .
      916         assign
      917           v-print-header = true
      918         .
      919         put stream PrnLibStream unformatted
      920           "Складской архив " + v-archive-type-name + ". "
      921           + substitute("Объект &1 &2. ", v-obj-type, v-obj-code)
      922           + v-description + ". "
      923           + substitute("Страница &1", page-number(PrnLibStream))
      924           skip
      925           .
      926       end.
      927       if v-print-header
      928       then do:
      929         put stream PrnLibStream unformatted
      930           v-delimiter skip
      931           "Дата       : Время    : Действие             : БД : Польз.   : Подробный  : Сжатый     : Перерасчёт :НеО:НеН:Вык:СбУ:Файл                  :Пра:Контрольная сумма MD5             : Номер   : Причина"
      932           skip
      933           v-delimiter skip
      934           .
      935         assign
      936           v-print-header = false
      937         .
      938       end.
      939       define variable v-history-description as character no-undo .
      940       run ah-infov_history-description in p-ah-infov-handle
      941         (input  buf_archive-history.action-type
      942         ,output v-history-description
      943         ) .
      944       define variable v-attr-calc    as logical   no-undo .
      945       define variable v-attr-del     as logical   no-undo .
      946       define variable v-attr-disable as logical   no-undo .
      947       define variable v-attr-rest    as logical   no-undo .
      948       run arhisatr_decode-attr in this-procedure
      949         (input  buf_archive-history.archive-calc
      950         ,input  buf_archive-history.archive-del
      951         ,input  buf_archive-history.ps
      952         ,output v-attr-calc
      953         ,output v-attr-del
      954         ,output v-attr-disable
      955         ,output v-attr-rest
      956         ) .
      957       put stream PrnLibStream unformatted
      958           (if buf_archive-history.corr-date <> ?
      959            then string(buf_archive-history.corr-date, '99/99/9999':u)
      960            else fill(' ':u, 10)
      961           )
      962         + " : "
      963         + (if buf_archive-history.corr-time-str <> ?
      964            then string(buf_archive-history.corr-time-str, 'x(8)':u)
      965            else fill(' ':u, 8)
      966           )
      967         + " : "
      968         + (if v-history-description <> ?
      969            then string(v-history-description, 'x(20)':u)
      970            else fill(' ':u, 20)
      971           )
      972         + " : "
      973         + (if buf_archive-history.corr-user-db-num <> ?
      974            then string(buf_archive-history.corr-user-db-num, '>9':u)
      975            else fill(' ':u, 2)
      976           )
      977         + " : "
      978         + (if buf_archive-history.corr-user-name <> ?
      979            then string(buf_archive-history.corr-user-name, 'x(8)':u)
      980            else fill(' ':u, 8)
      981           )
      982         + " : "
      983         + (if buf_archive-history.archive-detail-date <> ?
      984            then string(buf_archive-history.archive-detail-date, '99/99/9999':u)
      985            else fill(' ':u, 10)
      986           )
      987         + " : "
      988         + (if buf_archive-history.archive-start-date <> ?
      989            then string(buf_archive-history.archive-start-date, '99/99/9999':u)
      990            else fill(' ':u, 10)
      991           )
      992         + " : "
      993         + (if buf_archive-history.archive-recalc-date <> ?
      994            then string(buf_archive-history.archive-recalc-date, '99/99/9999':u)
      995            else fill(' ':u, 10)
      996           )
      997         + " : "
      998         + (if v-attr-calc <> ?
      999            then string(v-attr-calc, '+/-':u)
     1000            else fill(' ':u, 1)
     1001           )
     1002         + " : "
     1003         + (if v-attr-del <> ?
     1004            then string(v-attr-del, '+/-':u)
     1005            else fill(' ':u, 1)
     1006           )
     1007         + " : "
     1008         + (if v-attr-disable <> ?
     1009            then string(v-attr-disable, '+/-':u)
     1010            else fill(' ':u, 1)
     1011           )
     1012         + " : "
     1013         + (if v-attr-rest <> ?
     1014            then string(v-attr-rest, '+/-':u)
     1015            else fill(' ':u, 1)
     1016           )
     1017         + " : "
     1018         + (if buf_archive-history.file-name <> ?
     1019            then string(buf_archive-history.file-name, 'x(20)':u)
     1020            else fill(' ':u, 20)
     1021           )
     1022         + " : "
     1023         + (if buf_archive-history.file-valid <> ?
     1024            then string(buf_archive-history.file-valid, '+/-':u)
     1025            else fill(' ':u, 1)
     1026           )
     1027         + " : "
     1028         + (if buf_archive-history.file-md5 <> ?
     1029            then string(buf_archive-history.file-md5, 'x(32)':u)
     1030            else fill(' ':u, 32)
     1031           )
     1032         + " : "
     1033         + (if buf_archive-history.chip-num <> ?
     1034            then string(buf_archive-history.chip-num, '>>>>>>9':u)
     1035            else fill(' ':u, 6)
     1036           )
     1037         + " : "
     1038         + (if buf_archive-history.file-invalid-chip-num <> ?
     1039            then string(buf_archive-history.file-invalid-chip-num, '>>>>>>9':u)
     1040            else fill(' ':u, 6)
     1041           )
     1042         skip
     1043         .
     1044       get next q-hist .
     1045     end.
     1046     put stream PrnLibStream unformatted
     1047       v-delimiter skip
     1048       .
     1049     output stream PrnLibStream close .
     1050     run prn-lib-prn-file in this-procedure (
     1051                                               input parParentProc
     1052                                               ,input 8
     1053                                               ).
     1054   end.
