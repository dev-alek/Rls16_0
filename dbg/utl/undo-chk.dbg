        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define stream imp-str.
      112   DEFINE BUTTON b-help
      113        LABEL "Помо&щь"
      114        SIZE 10 BY 1.
      115   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      116        LABEL "Отмена"
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON Btn_OK
      120        LABEL "&Ввод"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON BUTTON-1
      124        IMAGE-UP FILE "btn-down-arrow":U
      125        IMAGE-DOWN FILE "btn-down-arrow":U
      126        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      127        LABEL ""
      128        SIZE 3 BY 1.
      129   DEFINE VARIABLE filename AS CHARACTER FORMAT "X(256)":U
      130        LABEL "Имя файла"
      131        VIEW-AS FILL-IN
      132        SIZE 51 BY 1 NO-UNDO.
      133   DEFINE VARIABLE ii AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      134        LABEL "Просмотрено чеков"
      135        VIEW-AS FILL-IN
      136        SIZE 14 BY 1 NO-UNDO.
      137   DEFINE VARIABLE ii-ok AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      138        LABEL "Импортировано чеков"
      139        VIEW-AS FILL-IN
      140        SIZE 14 BY 1.
      141   DEFINE FRAME Dialog-Frame
      142        Btn_OK AT ROW 1 COL 1
      143        Btn_Cancel AT ROW 1 COL 11
      144        b-help AT ROW 1 COL 58 WIDGET-ID 2
      145        filename AT ROW 2.6 COL 11 COLON-ALIGNED
      146        BUTTON-1 AT ROW 2.6 COL 65.5
      147        ii AT ROW 4.07 COL 19.6 COLON-ALIGNED
      148        ii-ok AT ROW 5.4 COL 20 COLON-ALIGNED
      149        SPACE(32.89) SKIP(2.62)
      150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      152            TITLE "Загрузка Архивов по чекам"
      153            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      154   ASSIGN
      155          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      156          FRAME Dialog-Frame:HIDDEN           = TRUE.
      157   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      158   DO:
      159     APPLY "END-ERROR":U TO SELF.
      160   END.
      161   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      162   DO:
      163       if filename = ""  then   do:
      164           message "Неправильно введено имя дампа" view-as alert-box message.
      165           return no-apply.
      166       end.
      167       RUN exp-arh(filename).
      168   END.
      169   ON CHOOSE OF BUTTON-1 IN FRAME Dialog-Frame
      170   DO:
      171     DEFINE VARIABLE OKpressed AS LOGICAL INITIAL TRUE.
      172     system-dialog get-file filename
      173     SAVE-AS
      174            USE-FILENAME
      175           UPDATE OKpressed.
      176     if okpressed then
      177       disp filename with frame dialog-frame.
      178   END.
      179   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      180   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      181   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   on help of frame Dialog-Frame
      183   do:
      184     run gbl/app_help.p
      185       (input this-procedure :file-name
      186       ,input ''
      187       ,input ?
      188       ) no-error.
      189     if error-status :error then do:
      190       message
      191         "Ошибка при вызове помощи"
      192         error-status :get-message(1)
      193         view-as alert-box .
      194     end.
      195   end.
      196   run minbtn-set in this-procedure .
      197   on choose of b-help in frame Dialog-Frame
      198   do:
      199     apply "help":u to frame Dialog-Frame .
      200   end.
      201   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      202   procedure minbtn-set :
      203       do
      204           on error undo, return error return-value
      205           :
      206           define variable ii              as integer       no-undo .
      207           define variable fh              as widget-handle no-undo .
      208           define variable hh              as widget-handle no-undo .
      209           define variable v-h             as handle        extent 4 no-undo .
      210           define variable v-name-button   as character     no-undo .
      211           define variable v-help-old-x    as decimal       no-undo .
      212           define variable v-help-old-y    as decimal       no-undo .
      213           define variable v-help-old-size as decimal       no-undo .
      214           define variable v-frame-width   as decimal       no-undo .
      215           define variable jj              as integer       no-undo .
      216           do
      217               on error undo, return error
      218               :
      219               assign
      220                   v-frame-width = frame Dialog-Frame:width - 0.3
      221                   fh            = frame Dialog-Frame:first-child
      222                   hh            = fh:first-child
      223                   ii            = 1
      224                   .
      225               do while valid-handle(hh):
      226                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      227                   do:
      228                       case lc(hh:name) :
      229                           when "b-help" then
      230                               do:
      231                                   hh:load-image-up("cmp/b-help.bmp":u) .
      232                                   hh:load-image-down("cmp/b-help.bmp":u) .
      233                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      234                                   hh:TOOLTIP = "Помощь" .
      235                                   v-help-old-x = hh:column .
      236                                   v-help-old-y = hh:row    .
      237                                   v-help-old-size = hh:width .
      238                                   hh:width-chars = 2.5 .
      239                               end.
      240                           when "b-print" then
      241                               do:
      242                                   hh:load-image("cmp/b-print.bmp":u) .
      243                                   hh:TOOLTIP = "Печать" .
      244                                   v-h[ii] = hh:handle .
      245                                   ii = ii + 1 .
      246                                   hh:width-chars = 3 .
      247                               end.
      248                           when "b-history" or
      249                           when "b-hist" then
      250                               do:
      251                                   hh:load-image("cmp/b-hist.bmp":u) .
      252                                   hh:TOOLTIP = "История" .
      253                                   v-h[ii] = hh:handle .
      254                                   ii = ii + 1 .
      255                                   hh:width-chars = 3 .
      256                               end.
      257                           when "b-sch" then
      258                               do:
      259                                   hh:load-image("cmp/b-sch.bmp":u) .
      260                                   hh:TOOLTIP = "Установка Фильтра" .
      261                                   v-h[ii] = hh:handle .
      262                                   ii = ii + 1 .
      263                                   hh:width-chars = 3 .
      264                               end.
      265                           when "b-hist-user" then
      266                               do:
      267                                   hh:load-image("cmp/b-hist.bmp":u) .
      268                                   hh:TOOLTIP = "История пользователя" .
      269                                   ii = ii + 1 .
      270                               end.
      271                       end case.
      272                   end.
      273                   hh = hh:next-sibling.
      274               end.
      275               b-help:column = v-frame-width - b-help:width-chars.
      276               jj = 0.
      277               repeat ii = 4 to 1 by -1 :
      278                   if valid-handle (v-h[ii] ) then
      279                   do:
      280                       jj  = jj + 1 .
      281                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      282                       v-h[ii]:row    = v-help-old-y .
      283                   end.
      284               end.
      285           end.
      286       end.
      287   end procedure.
      288   MAIN-BLOCK:
      289   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      290      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      291     RUN enable_UI.
      292     WAIT-FOR GO OF FRAME Dialog-Frame.
      293   END.
      294   RUN disable_UI.
      295   PROCEDURE disable_UI :
      296     HIDE FRAME Dialog-Frame.
      297   END PROCEDURE.
      298   PROCEDURE enable_UI :
      299     DISPLAY filename ii ii-ok
      300         WITH FRAME Dialog-Frame.
      301     ENABLE Btn_OK Btn_Cancel b-help BUTTON-1
      302         WITH FRAME Dialog-Frame.
      303     VIEW FRAME Dialog-Frame.
      304   END PROCEDURE.
      305   PROCEDURE exp-arh :
      306       def input param filename as char no-undo.
      307       define variable t-name as char no-undo.
      308       define variable date-ga as char no-undo.
      309   disable triggers for  load   of ub.chk-doc.
      310   disable triggers for  load   of ub.chk-gds.
      311   disable triggers for  load   of ub.chk-pay.
      312   disable triggers for  load   of ub.chk-discnt.
      313   disable triggers for  load   of ub.chk-doc-attr.
      314   define buffer buf_chk-doc for ub.chk-doc.
      315   define buffer buf_inkas   for ub.inkas.
      316   define variable v-import as logical no-undo .
      317   define variable v-doc-code   like ub.chk-doc.doc-code no-undo .
      318   define variable v-inkas-code like ub.inkas.inkas-code no-undo .
      319   define variable v-skip as character no-undo .
      320   define variable v-version as decimal no-undo .
      321   define variable glog as logical no-undo .
      322   message
      323   "Внимание!" skip
      324   "Файл-источник" filename
      325   "после импорта будет уничтожен, сделайте резервную копию" skip
      326   "Продолжить?"
      327   view-as alert-box question update glog.
      328   if not glog then return.
      329   assign
      330   ii = 0
      331   ii-ok = 0
      332   .
      333       input stream imp-str from value(filename).
      334       import stream imp-str unformatted t-name.
      335       if index(t-name, "v1.01":U) > 0 then do:
      336         assign
      337         v-version = 1.01
      338         .
      339       end.
      340       else do:
      341         assign
      342         v-inkas-code = "":U
      343         v-import = yes
      344         .
      345       end.
      346       DO ON ERROR   UNDO, RETURN ERROR
      347         ON ENDKEY UNDO, RETURN ERROR
      348         ON STOP      UNDO, RETURN ERROR:
      349           _repeat:
      350           repeat:
      351               disp ii ii-ok with frame Dialog-Frame.
      352               if v-version = 0 then do:
      353                 import stream imp-str t-name.
      354               end.
      355               if v-version = 1.01 then do:
      356                 import stream imp-str t-name v-inkas-code v-doc-code.
      357               end.
      358               case t-name:
      359       when "chk-doc" then do:
      360   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361             assign
      362             v-import = no
      363             ii = ii + 1
      364             .
      365             if v-inkas-code = "":U then do:
      366               assign
      367               v-import = yes
      368               ii-ok = ii-ok + 1
      369               .
      370             end.
      371             else do:
      372               if v-inkas-code = ? then do:
      373                 assign
      374                 v-import = no
      375                 .
      376               end.
      377               else do:
      378                 find first buf_inkas where
      379                           buf_inkas.inkas-code = v-inkas-code no-error .
      380                 if available buf_inkas
      381                 and (buf_inkas.status_ = 'факт':U
      382                     or
      383                 buf_inkas.status_ = 'запрос':U  )
      384                 then do:
      385                   find first buf_chk-doc no-lock where
      386                             buf_chk-doc.doc-code = v-doc-code no-error.
      387                   if not available buf_chk-doc then do:
      388                     assign
      389                     v-import = yes
      390                     ii-ok = ii-ok + 1
      391                     .
      392                   end.
      393                 end.
      394               end.
      395             end.
      396           if v-import = yes then do:
      397             create chk-doc.
      398             import stream imp-str chk-doc no-error .
      399             if error-status:error then do:
      400                undo _repeat, next _repeat.
      401             end.
      402           end.
      403           else do:
      404             import stream imp-str unformatted v-skip.
      405           end.
      406       end.
      407       when "chk-pay" then do:
      408   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      409           if v-import = yes then do:
      410             create chk-pay.
      411             import stream imp-str chk-pay no-error .
      412             if error-status:error then do:
      413                undo _repeat, next _repeat.
      414             end.
      415           end.
      416           else do:
      417             import stream imp-str unformatted v-skip.
      418           end.
      419       end.
      420       when "chk-gds" then do:
      421   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422           if v-import = yes then do:
      423             create chk-gds.
      424             import stream imp-str chk-gds no-error .
      425             if error-status:error then do:
      426                undo _repeat, next _repeat.
      427             end.
      428           end.
      429           else do:
      430             import stream imp-str unformatted v-skip.
      431           end.
      432       end.
      433       when "chk-discnt" then do:
      434   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      435           if v-import = yes then do:
      436             create chk-discnt.
      437             import stream imp-str chk-discnt no-error .
      438             if error-status:error then do:
      439                undo _repeat, next _repeat.
      440             end.
      441           end.
      442           else do:
      443             import stream imp-str unformatted v-skip.
      444           end.
      445       end.
      446       when "chk-doc-attr" then do:
      447   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448           if v-import = yes then do:
      449             create chk-doc-attr.
      450             import stream imp-str chk-doc-attr no-error .
      451             if error-status:error then do:
      452                undo _repeat, next _repeat.
      453             end.
      454           end.
      455           else do:
      456             import stream imp-str unformatted v-skip.
      457           end.
      458       end.
      459               end case.
      460           end.
      461       end.
      462       input stream imp-str close.
      463       os-delete value(filename).
      464       message "Загрузка чеков закончена. "  view-as alert-box message.
      465   END PROCEDURE.
