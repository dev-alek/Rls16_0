        1   block-level on error undo, throw.
        2   define input parameter iDumpDir as character no-undo.
        3   define input parameter iDbRec   as character no-undo.
        4   define input parameter p-handle-callback     as handle    no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        7   define variable vss-date        as character no-undo init "$Date: 20/01/2026 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: pressdbdump.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/pressdbdump.p $":U .
       10   define variable vss-description as character no-undo init "Сжатие БД. Выгрузка данных таблиц БД.".
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   define stream LogStream .
       16   define variable ttd        as character no-undo .
       17   define variable v-old-time as int64     no-undo .
       18   PROCEDURE write-to-log :
       19     define input parameter p-msg-str   as character no-undo .
       20     define input parameter p-call-back as handle    no-undo .
       21     do
       22     on error undo, return error
       23     :
       24       output stream LogStream to "press_db.log" page-size 0 append.
       25       put stream LogStream unformatted p-msg-str .
       26       output stream LogStream close.
       27       if  valid-handle(p-call-back)
       28       and lookup('callback-write-to-log', p-call-back :internal-entries) > 0
       29       then do:
       30         run callback-write-to-log in p-call-back
       31           (input p-msg-str
       32           ) no-error .
       33       end.
       34     end.
       35   END PROCEDURE.
       36   FUNCTION format-etime RETURNS CHARACTER
       37   (INPUT p-etime AS INT64  )
       38   :
       39     if p-etime = ?
       40     then do:
       41       return "?????????????" .
       42     end.
       43     assign
       44       p-etime = p-etime / 1000
       45     .
       46     return
       47       string( p-etime, '->>>>>>>9')
       48       + ' '
       49       + string( p-etime, 'HH:MM:SS')
       50     .
       51   END FUNCTION.
       52   define variable vNameFull  as character no-undo.
       53   define variable vNameShort as character no-undo.
       54   define variable vType      as character no-undo.
       55   define variable vCmd       as character no-undo.
       56   define variable vLetter    as character no-undo.
       57   define variable vError     as integer   no-undo.
       58   define stream sFromDir.
       59   input stream sFromDir from os-dir(".\" + iDumpDir).
       60   run write-to-log in this-procedure
       61      ( "Загружаем данные в новую БД." + chr(10)
       62      ,p-handle-callback
       63   ).
       64   repeat:
       65     import stream sFromDir vNameShort vNameFull vType.
       66     if vType <> "F" or entry(2,vNameShort,".") <> "bd" then
       67       next.
       68     if vLetter ne substring(vNameShort, 1, 1) then
       69     do:
       70       vLetter= substring(vNameShort, 1, 1).
       71       run write-to-log in this-procedure
       72          ( string(today, '99/99/9999') + " " + string(time, 'HH:MM') +
       73            " Загружаем таблицы " + vLetter + "*." + chr(10)
       74          ,p-handle-callback
       75       ).
       76     end.
       77     vCmd = substitute(
       78       "&3 &1 -C load &2 build indexes",
       79       iDbRec,
       80       vNameFull,
       81       entry(1,search("proutil.bat"),".")).
       82     os-command silent value(vCmd).
       83     vError = os-error.
       84     if vError <> 0 then
       85       return error substitute("Таблица &1; Ошибка &2.", entry(1,vNameShort,"."), vError).
       86   end.
       87   input stream sFromDir close.
