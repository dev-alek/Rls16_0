     3804   procedure clear-tt :
     3805     do
     3806     on error undo, return error return-value
     3807     :
     3808      for each tt-trn-doc:
     3809       delete tt-trn-doc.
     3810      end.
     3811       for each tt2-doc-line :
     3812           delete tt2-doc-line .
