      820   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   function octal-to-char return character
      822   ( p-string as character ) :
      823     def var v-asc     as integer no-undo .
      824     def var v-new-asc as integer no-undo .
      825     def var ind       as integer no-undo .
      826     if length(p-string) <> 3 then do:
      827       return ? .
      828     end.
      829     assign
      830       v-asc = 0
      831     .
      832     do ind = 1 to length(p-string)
      833     :
      834       assign
      835         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      836       .
      837       if v-new-asc < 0 or v-new-asc >= 8 then do:
      838         return ? .
      839       end.
      840       assign
      841         v-asc = v-asc * 8 + v-new-asc
      842       .
      843     end.
      844     return chr(v-asc) .
      845   end function .
      846   function char-to-octal return character
      847   ( p-chr as character ) :
      848     def var v-asc    as integer   no-undo .
      849     def var ind      as integer   no-undo .
      850     def var v-string as character no-undo .
      851     if length(p-chr) <> 1 then do:
      852       return ? .
      853     end.
      854     assign
      855       v-asc    = asc(p-chr)
      856       v-string = ""
      857     .
      858     do ind = 1 to 3
      859     :
      860       assign
      861         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      862       .
      863       assign
      864         v-asc = truncate(v-asc / 8, 0)
      865       .
      866     end.
      867     return v-string .
      868   end.
      869   function str-encode return character
      870   (   p-init-string       as character
      871     , p-encode-char       as character
      872     , p-special-char-list as character
      873   ) :
      874     def var p-encode-string as character no-undo .
      875     def var ind                as integer no-undo .
      876     def var v-num-special-char as integer no-undo .
      877     def var v-special-char     as character no-undo .
      878     if p-encode-char = ?
      879     or p-encode-char = "" then do:
      880       assign
      881         p-encode-char = "~~"
      882       .
      883     end.
      884     if p-init-string = ? then do:
      885       return "?" .
      886     end.
      887     if p-init-string = "?" then do:
      888       return p-encode-char + char-to-octal("?") .
      889     end.
      890     assign
      891       v-num-special-char = length(p-special-char-list)
      892       p-encode-string    = replace(p-init-string
      893                                   ,p-encode-char
      894                                   ,p-encode-char + char-to-octal(p-encode-char)
      895                                   )
      896     .
      897     do ind = 1 to v-num-special-char
      898     :
      899       assign
      900         v-special-char = substring(p-special-char-list, ind, 1)
      901       .
      902       if v-special-char <> p-encode-char then do:
      903         assign
      904           p-encode-string = replace (p-encode-string
      905                                     ,v-special-char
      906                                     ,p-encode-char + char-to-octal(v-special-char)
      907                                     )
      908         .
      909       end.
      910     end.
      911     return p-encode-string .
      912   end.
      913   function str-decode returns character
      914     (p-init-string   as character
      915     ,p-encode-char   as character
      916     ) :
      917     def var p-decode-string as character no-undo .
      918     def var ind                       as integer no-undo .
      919     def var v-num-entries-init-string as integer no-undo .
      920     def var v-sub-phrase              as character no-undo .
      921     def var v-special-char            as character no-undo .
      922     if p-encode-char = ?
      923     or p-encode-char = "" then do:
      924       assign
      925         p-encode-char = "~~"
      926       .
      927     end.
      928     if p-init-string = "?" then do:
      929       return ? .
      930     end.
      931     assign
      932       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      933     .
      934     if v-num-entries-init-string > 1 then do:
      935       assign
      936         p-decode-string = entry(1, p-init-string, p-encode-char)
      937       .
      938       do ind = 2 to v-num-entries-init-string
      939       :
      940         assign
      941           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      942         .
      943         assign
      944           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      945         .
      946         if v-special-char <> ? then do:
      947           assign
      948             p-decode-string = p-decode-string
      949                             + v-special-char
      950                             + substring(v-sub-phrase, 4)
      951           .
      952         end.
      953         else do:
      954           assign
      955             p-decode-string = p-decode-string
      956                             + p-encode-char
      957                             + v-sub-phrase
      958           .
      959         end.
      960       end.
      961     end.
      962     else do:
      963       assign
      964         p-decode-string = p-init-string
      965       .
      966     end.
      967     return p-decode-string .
      968   end.
      969   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      970   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      971   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      972     field cst-code                like ub.trn-doc.cst-code
      973     field part-code               like ub.parts.part-code
      974     .
      975   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      976   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      977   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      978   function hvrdtax return logical (input parrecid as recid):
      979   define variable varresult as logical no-undo.
      980   run hvrdtax-proc (input parrecid, output varresult).
      981   return varresult.
      982   end function.
      983   procedure hvrdtax-proc:
      984   define input  parameter parrecid  as recid   no-undo.
      985   define output parameter parresult as logical no-undo.
      986   define buffer bf_goods for ub.goods.
      987   define buffer bf_units for ub.units.
      988   define buffer rt_tax   for ub.tax.
      989   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      990   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      991   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      992   if available rt_tax and
      993       can-find(first ub.tax-units No-LOCK WHERE
      994                      ub.tax-units.tax-code = rt_tax.tax-code AND
      995                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      996                                                       else assign parresult = no.
      997   end procedure.
      998   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      999   define new global shared variable g#lib-calc as handle no-undo .
     1000   procedure plgdsfnd :
     1001     define input  parameter p-chk-and-chs    as logical               no-undo .
     1002     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1003     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1004     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1005     define output parameter p-reserv-pl-code as   logical             no-undo .
     1006     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1007     define buffer buf_goods         for ub.goods .
     1008     define buffer buf_pl-gds        for ub.pl-gds .
     1009     define buffer buf_second_pl-gds for ub.pl-gds .
     1010     find first buf_goods no-lock where
     1011                buf_goods.gds-code = p-gds-code no-error .
     1012     if not available buf_goods
     1013     then do:
     1014       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1015     end.
     1016   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1018     (input  p-obj-type
     1019     ,input  p-obj-code
     1020     ,input  buf_goods.artic
     1021     ,input  buf_goods.prod-type
     1022     ,input  buf_goods.prod-code
     1023     ,input  'place-rsrv=request'
     1024     ,output p-reserv-pl-code
     1025     ) no-error .
     1026     if error-status :error
     1027     then do:
     1028       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1029     end.
     1030     if p-reserv-pl-code = no
     1031     then do:
     1032       return .
     1033     end.
     1034     if p-chk-and-chs <> yes
     1035     then do:
     1036       return .
     1037     end.
     1038     find first buf_pl-gds no-lock where
     1039                buf_pl-gds.obj-type = p-obj-type and
     1040                buf_pl-gds.obj-code = p-obj-code and
     1041                buf_pl-gds.gds-code = p-gds-code no-error .
     1042     if not available buf_pl-gds
     1043     then do:
     1044       return error "К товару не привязано ни одного места хранения" .
     1045     end.
     1046     find first buf_second_pl-gds no-lock where
     1047                buf_second_pl-gds.obj-type  = p-obj-type          and
     1048                buf_second_pl-gds.obj-code  = p-obj-code          and
     1049                buf_second_pl-gds.gds-code  = p-gds-code          and
     1050                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1051     if not available buf_second_pl-gds
     1052     then do:
     1053       assign
     1054         p-pl-code = buf_pl-gds.pl-code
     1055       .
     1056     end.
     1057     else do:
     1058       if not valid-handle( parparentproc )
     1059       then do:
     1060         return error "Не выбрано место хранения " + chr(10) .
     1061       end.
     1062       run str/plgdssel.p
     1063         (
     1064            input parparentproc
     1065         ,  input p-obj-type
     1066         ,  input p-obj-code
     1067         ,  input p-gds-code
     1068         , output p-pl-code
     1069         ) no-error .
     1070       if error-status :error
     1071       then do:
     1072         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1073                                , 'plgdssel.p':U
     1074                                , chr(10)
     1075                                , error-status :get-message( 1 )
     1076                                , return-value
     1077                                ) .
     1078       end.
     1079       if p-pl-code = ? or
     1080          p-pl-code = 0
     1081       then do:
     1082         return error "Не выбрано место хранения " + chr(10) .
     1083       end.
     1084     end.
     1085   end procedure.
     1086   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1087   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1088   define temp-table tt-doc-line no-undo like ub.doc-line
     1089   field cst-code like ub.trn-doc.cst-code
     1090   .
     1091   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1092   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1093   define temp-table tt-parts    no-undo like ub.parts.
     1094   procedure lib-trn_copy-inqu :
     1095   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1096   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1097   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1098   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1099   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1100   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1101   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1102   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1103   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1104   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1105   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1106   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1107   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1108   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1109   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1110   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1111   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1112   define input parameter parinp-discnt-type as   logical                no-undo.
     1113   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1114   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1115   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1116   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1117   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1118   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1119   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1120   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1121   define input parameter table for tt-doc-line.
     1122   define input parameter table for tt-gds-dtl.
     1123   define input parameter table for tt-parts.
     1124   define input parameter paruse-parts       as   logical                no-undo.
     1125   define input parameter parall-qnty        as   logical                no-undo.
     1126   define input parameter parfix-price       as   logical                no-undo.
     1127   define buffer crt_trn-doc  for ub.trn-doc.
     1128   define buffer crt_goods    for ub.goods.
     1129   define buffer crt_doc-line for ub.doc-line.
     1130   define buffer crt_gds-dtl  for ub.gds-dtl.
     1131   define variable end-price    as   logical              no-undo.
     1132   define variable real-type    like ub.goods.gds-type    no-undo.
     1133   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1134   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1135   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1136   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1137   define variable g-log        as   logical              no-undo.
     1138   define variable mem-qnty like chg-qnty no-undo.
     1139   define variable dflt-cd as character no-undo .
     1140   c-l:
     1141   do on error undo, return error return-value :
     1142   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1143   assign
     1144       paruse-parts = false
     1145       .
     1146   assign
     1147     end-price = no.
     1148   if parinp-discnt-type = yes and
     1149      parinp-discnt-pc   = 0   and
     1150      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1151      then do:
     1152     assign
     1153       crt_trn-doc.tot-calc    = partot-calc
     1154       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1155       crt_trn-doc.discnt-type = pardiscnt-type.
     1156   end.
     1157   if parinp-agnt = ? then do:
     1158     assign
     1159       crt_trn-doc.agnt = paragnt.
     1160   end.
     1161   if parinp-boss = ? then do:
     1162     assign
     1163       crt_trn-doc.boss = parboss.
     1164   end.
     1165   if parinp-wrkr = ? then do:
     1166     assign
     1167       crt_trn-doc.wrkr = parwrkr.
     1168   end.
     1169   if parinp-base-rate  = ? then do:
     1170     assign
     1171       crt_trn-doc.base-rate  = parbase-rate.
     1172   end.
     1173   if parinp-base-scale = ? then do:
     1174     assign
     1175       crt_trn-doc.base-scale = parbase-scale.
     1176   end.
     1177   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1178   if available tt-doc-line then do:
     1179     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1180                      and crt_goods.prod-type = tt-doc-line.prod-type
     1181                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1182     if crt_goods.gds-type = 'у':U and
     1183        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1184       return error "В данный документ нельзя копировать услуги.".
     1185     end.
     1186     assign
     1187       real-type = crt_goods.gds-type.
     1188     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1189     if available crt_doc-line then do:
     1190       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1191                        and crt_goods.prod-type = crt_doc-line.prod-type
     1192                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1193       if crt_goods.gds-type <> real-type then do:
     1194         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1195       end.
     1196     end.
     1197     else do:
     1198       assign
     1199         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1200     end.
     1201   end.
     1202   r-l:
     1203   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1204     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1205                      and crt_goods.prod-type = tt-doc-line.prod-type
     1206                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1207   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1208      (
     1209       input crt_trn-doc.doc-code
     1210      ,input crt_trn-doc.obj-type
     1211      ,input crt_trn-doc.obj-code
     1212      ,input crt_goods.artic
     1213      ,input crt_goods.prod-type
     1214      ,input crt_goods.prod-code
     1215      ,input crt_goods.gds-name
     1216      ,input crt_goods.prt-root
     1217      ,input ?
     1218      ,input ?
     1219      ,input parcash-pay      ) no-error.
     1220     if error-status:error then do:
     1221       undo c-l, return error return-value.
     1222     end.
     1223     if return-value = "next" then do:
     1224       next r-l.
     1225     end.
     1226     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1227                                   crt_doc-line.artic     = crt_goods.artic      and
     1228                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1229                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1230     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1231                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1232                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1233                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1234                               break by tt-gds-dtl.artic
     1235                                     by tt-gds-dtl.prod-type
     1236                                     by tt-gds-dtl.prod-code
     1237                               :
     1238   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1239     ( input  tt-gds-dtl.artic
     1240      ,input  tt-gds-dtl.prod-type
     1241      ,input  tt-gds-dtl.prod-code
     1242      ,input  tt-gds-dtl.prt-code
     1243      ,input  tt-doc-line.obj-type
     1244      ,input  tt-doc-line.obj-code
     1245      ,output legal-node
     1246     ) no-error .
     1247       if error-status:error then do:
     1248          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1249       end.
     1250   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1251     ( input crt_trn-doc.obj-code
     1252      ,input crt_trn-doc.obj-type
     1253      ,input crt_trn-doc.doc-code
     1254      ,input crt_goods.artic
     1255      ,input crt_goods.prod-code
     1256      ,input crt_goods.prod-type
     1257      ,input legal-node
     1258      ,input yes
     1259     ) no-error .
     1260        if error-status:error then do:
     1261           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1262        end.
     1263        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1264                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1265                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1266                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1267                                     crt_gds-dtl.prt-code  = legal-node.
     1268       assign
     1269         crt_gds-dtl.ov             = parfix-price
     1270         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1271         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1272         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1273         .
     1274       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1275         assign
     1276           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1277           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1278           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1279           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1280       end.
     1281       if end-price then do:
     1282         assign
     1283           crt_gds-dtl.ov             = yes
     1284           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1285           crt_gds-dtl.discnt-base    = 0
     1286           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1287           crt_gds-dtl.discnt-rubl    = 0
     1288           crt_gds-dtl.discnt-pc      = 0
     1289           crt_gds-dtl.discnt-type    = yes.
     1290       end.
     1291   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1293     ( input recid(crt_gds-dtl)
     1294     , input no
     1295     , input ?
     1296     ) no-error.
     1297           if error-status:error then do:
     1298             undo c-l, return error return-value.
     1299           end.
     1300       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1301          crt_gds-dtl.ov then do:
     1302         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1303       end.
     1304       if paruse-parts then do:
     1305          if first-of (tt-gds-dtl.prod-code) then do:
     1306            for each tt-parts :
     1307              assign
     1308                chg-qnty = tt-parts.fact-qnty
     1309                mem-qnty = chg-qnty.
     1310              assign
     1311              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1312              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1313            end.
     1314            assign
     1315              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1316              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1317            assign
     1318              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1319              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1320            if crt_gds-dtl.doc-qnty = 0 then do:
     1321              delete crt_gds-dtl.
     1322            end.
     1323          end.
     1324       end.
     1325       else do:
     1326         assign
     1327           chg-qnty = tt-gds-dtl.fact-qnty
     1328           mem-qnty = chg-qnty.
     1329         assign
     1330           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1331           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1332           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1333           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1334         assign
     1335         varchg-qnty  = varchg-qnty  + chg-qnty
     1336         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1337         if crt_gds-dtl.doc-qnty = 0 then do:
     1338           delete crt_gds-dtl.
     1339         end.
     1340       end.
     1341     end.
     1342     if crt_doc-line.doc-qnty = 0 then do:
     1343       delete crt_doc-line.
     1344     end.
     1345   end.
     1346   end.
     1347   end procedure.
     1348   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
