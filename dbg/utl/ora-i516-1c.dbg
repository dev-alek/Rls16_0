     3851   procedure calc-cost-price :
     3852   define input  parameter p-doc-code as character no-undo .
     3853   define buffer cur-doc-line  for ub.doc-line.
     3854   define buffer cur-goods     for ub.goods.
     3855   define buffer cur-gds-dtl   for ub.gds-dtl.
     3856   define buffer t-doc         for ub.trn-doc  .
     3857   define variable varnew-price like ub.doc-line.price-base no-undo.
     3858     do
     3859     on error undo, return error return-value
     3860     :
     3861     v-end-message = substitute("Просчет учетной цены для расходной накладной &1" , p-doc-code) .
     3862     run pcall-log-file in p-log-handle ( input v-end-message ) .
     3863     find first t-doc no-lock where t-doc.doc-code = p-doc-code .
     3864      for each  cur-doc-line where cur-doc-line.doc-code   = t-doc.doc-code         ,
     3865          first cur-goods    where cur-goods.artic         = cur-doc-line.artic     and
     3866                                   cur-goods.prod-type     = cur-doc-line.prod-type and
     3867                                   cur-goods.prod-code     = cur-doc-line.prod-code no-lock,
     3868          each  cur-gds-dtl  where cur-gds-dtl.doc-code    = cur-doc-line.doc-code  and
     3869                                   cur-gds-dtl.artic       = cur-doc-line.artic     and
     3870                                   cur-gds-dtl.prod-type   = cur-doc-line.prod-type and
     3871                                   cur-gds-dtl.prod-code   = cur-doc-line.prod-code no-lock :
     3872          assign
     3873            line-rec = recid(cur-doc-line)
     3874          .
     3875   assign
     3876     price-rubl-with-tax-loc = cur-doc-line.price-rubl
     3877     price-base-with-tax-loc = cur-doc-line.price-base
     3878   .
     3879   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3881     (output varinvprb
     3882     )  .
     3883      find first in-vatp_doc-attr no-lock
     3884       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     3885         and in-vatp_doc-attr.attr-code = 'envd':U
     3886       no-error .
     3887       if available in-vatp_doc-attr
     3888          then do:
     3889          assign
     3890            in-vatp-have-vat-slt = no.
     3891      end.
     3892      else do:
     3893        assign
     3894          in-vatp-have-vat-slt = yes.
     3895      end.
     3896      find first in-vatp-goods where in-vatp-goods.artic     = cur-doc-line.artic     and
     3897                                        in-vatp-goods.prod-type = cur-doc-line.prod-type and
     3898                                        in-vatp-goods.prod-code = cur-doc-line.prod-code no-lock.
     3899      if (not t-doc.internal and
     3900              t-doc.doc-type = 'при':U) or
     3901         in-vatp-goods.gds-type = 'у':U then do:
     3902         if varinvprb = "base":u then do:
     3903           assign
     3904             road-tax-base-loc = cur-doc-line.road-tax
     3905             road-tax-rubl-loc = cur-doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     3906         end.
     3907         else do:
     3908           ASSIGN
     3909             road-tax-rubl-loc = cur-doc-line.road-tax
     3910             road-tax-base-loc = cur-doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     3911         end.
     3912         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     3913         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     3914         assign
     3915           road-tax-cli-loc = ?.
     3916         ASSIGN
     3917           transport-base-loc = (if cur-doc-line.transport-base = ? then 0 else cur-doc-line.transport-base)
     3918           transport-rubl-loc = (if cur-doc-line.transport-rubl = ? then 0 else cur-doc-line.transport-rubl)
     3919           transport-cli-loc  = 0
     3920           other-base-loc     = (if cur-doc-line.other-base     = ? then 0 else cur-doc-line.other-base)
     3921           other-rubl-loc     = (if cur-doc-line.other-rubl     = ? then 0 else cur-doc-line.other-rubl)
     3922           other-cli-loc      = 0
     3923           vat-pc-loc         = (if cur-doc-line.vat-pc         = ? then 0 else cur-doc-line.vat-pc)
     3924           slt-pc-loc         = (if cur-doc-line.slt-pc         = ? then 0 else cur-doc-line.slt-pc).
     3925                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3926               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3927         assign
     3928           vat-cli-loc            = ?
     3929           slt-cli-loc            = ?
     3930           price-cli-with-tax-loc = ?.
     3931      end.
     3932      else do:
     3933                                                   for each in-vatp-parts where in-vatp-parts.out-code  = cur-doc-line.doc-code  and
     3934                                         in-vatp-parts.obj-type  = cur-doc-line.obj-type  and
     3935                                         in-vatp-parts.obj-code  = cur-doc-line.obj-code  and
     3936                                         in-vatp-parts.artic     = cur-doc-line.artic     and
     3937                                         in-vatp-parts.prod-type = cur-doc-line.prod-type and
     3938                                         in-vatp-parts.prod-code = cur-doc-line.prod-code
     3939                            use-index out-code no-lock:
     3940             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     3941                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     3942                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     3943                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     3944                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     3945                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     3946                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3947                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3948                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3949                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3950                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3951                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3952                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3953                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3954                         .
     3955         end.
     3956         ASSIGN
     3957           road-tax-base-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3958           road-tax-rubl-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3959           transport-base-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3960           transport-rubl-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3961           other-base-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3962           other-rubl-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3963                                           vat-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     3964           slt-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     3965                   vat-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     3966           slt-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     3967           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     3968           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     3969         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     3970         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     3971         if transport-base-loc = ? then transport-base-loc = 0.
     3972         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     3973         if other-base-loc     = ? then other-base-loc     = 0.
     3974         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     3975         assign
     3976           transport-cli-loc      = 0
     3977           other-cli-loc          = 0
     3978           road-tax-cli-loc       = ?
     3979           vat-cli-loc            = ?
     3980           slt-cli-loc            = ?
     3981           price-cli-with-tax-loc = ?.
     3982      end.
     3983   ASSIGN
     3984             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3985       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3986   .
     3987       assign
     3988         varnew-price = (if t-doc.print-rubl then price-rubl-with-tax-loc
     3989                                             else price-base-with-tax-loc ) .
     3990          run str/out-add.p ( this-procedure ,
     3991                         recid (t-doc),
     3992                         recid (cur-doc-line),
     3993                         recid (cur-gds-dtl),
     3994                         recid (cur-goods),
     3995                         "update-sale-price",
     3996                         string(varnew-price)) no-error.
     3997          if error-status :error then do:
     3998           v-end-message = substitute(" Ошибка при вызове программы out-add &1 &2" , error-status :get-message(1)  , return-value) .
     3999           run pcall-log-file in p-log-handle ( input v-end-message ) .
     4000           undo, return error v-end-message.
     4001          end.
     4002      end.
     4003       if not is-tsd then do:
     4004         run gbl/calc-trn.p (  this-procedure , recid(new_trn-doc)) no-error .
     4005         if error-status :error then do:
     4006           v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     4007           run pcall-log-file in p-log-handle ( input v-end-message ) .
     4008           undo, return error v-end-message.
     4009         end.
     4010       end.
     4011     end.
     4012   end procedure.
     4013   procedure cb_cloce-quest-neg :
     4014   define output parameter p-is-negostmess as logical   no-undo .
     4015     do
     4016     on error undo, return error return-value
     4017     :
     4018      p-is-negostmess = false .
     4019     end.
     4020   end procedure.
     4021   procedure unitqnty1 :
     4022     define input parameter  p-unit-name        like ub.units.unit-name no-undo .
     4023     define input parameter  p-artic            like ub.goods.artic     no-undo .
     4024     define input parameter  p-prod-type        like ub.goods.prod-type no-undo .
     4025     define input parameter  p-prod-code        like ub.goods.prod-code no-undo .
     4026     define input parameter  p-unit-description as character            no-undo .
     4027     define input parameter  p-qnty             as decimal              no-undo .
     4028     define buffer buf_units for ub.units .
     4029     define buffer buf_goods for ub.goods .
     4030     define variable v-artic as character no-undo .
     4031     define variable v-msg   as character no-undo .
     4032     if p-unit-description = ''
     4033     or p-unit-description = ?
     4034     then do:
     4035       assign
     4036         p-unit-description = "Единица измерения "
     4037       .
     4038     end.
     4039     if  p-unit-name <> ''
     4040     and p-unit-name <> ?
     4041     then do:
     4042       find first buf_units no-lock
     4043         where buf_units.unit-name = p-unit-name
     4044         no-error .
     4045       if not available buf_units
     4046       then do:
     4047         v-msg =
     4048           "Не найдена единица измерения " + chr(10) +
     4049           "p-unit-name" +   p-unit-name + chr(10) +
     4050           "p-artic" +       p-artic +  chr(10) +
     4051           "p-prod-type" +   p-prod-type + chr(10) +
     4052           "p-proc-code" +   string (p-prod-code) + chr(10) +
     4053           "p-qnty" +        string (p-qnty) + chr(10)
     4054            .
     4055         undo, return error v-msg .
     4056       end.
     4057     end.
     4058     else do:
     4059       find first buf_goods no-lock
     4060         where buf_goods.artic     = p-artic
     4061           and buf_goods.prod-type = p-prod-type
     4062           and buf_goods.prod-code = p-prod-code
     4063         no-error .
     4064       if not available buf_goods
     4065       then do:
     4066         v-msg =
     4067           "Не найден товар" + chr(10) +
     4068           "p-unit-name" +   p-unit-name + chr(10) +
     4069           "p-artic" +       p-artic +  chr(10) +
     4070           "p-prod-type" +   p-prod-type + chr(10) +
     4071           "p-proc-code" +   string (p-prod-code) + chr(10) +
     4072           "p-qnty" +        string (p-qnty) + chr(10)
     4073           .
     4074         undo, return error v-msg .
     4075       end.
     4076       find first buf_units no-lock
     4077         where buf_units.unit-name = buf_goods.unit-base
     4078         no-error .
     4079       if not available buf_units
     4080       then do:
     4081         v-msg =
     4082           "Не найдена единица измерения " + chr(10) +
     4083           "p-unit-name" +   p-unit-name + chr(10) +
     4084           "p-artic" +       p-artic +  chr(10) +
     4085           "p-prod-type" +   p-prod-type + chr(10) +
     4086           "p-proc-code" +   string (p-prod-code) + chr(10) +
     4087           "p-qnty" +        string (p-qnty) + chr(10)
     4088           .
     4089         undo, return error v-msg .
     4090       end.
     4091       assign
     4092         v-artic = "Артикул " + string(p-artic) + " " + string(p-prod-type)
     4093                 + " " + string(p-prod-code)
     4094         p-unit-description = "Базовая единица измерения"
     4095       .
     4096     end.
     4097     if lookup('шту':U, buf_units.type) > 0
     4098     or lookup('сер':U, buf_units.type) > 0
     4099     then do:
     4100       if p-qnty <> truncate(p-qnty, 0)
     4101       then do:
     4102         v-msg =
     4103           "Для штучного и серийного товаров резервируемое количество должно быть целым" + chr(10) +
     4104           v-artic + chr(10) +
     4105           p-unit-description + buf_units.unit-name + chr(10) +
     4106           "Запрошено количество " + string (p-qnty) + chr(10).
     4107         undo, return error v-msg .
     4108       end.
     4109     end.
     4110   end procedure.
     4111   procedure create-line:
     4112       define input parameter p-doc-code as character no-undo.
     4113       define input-output parameter table for tt2-doc-line.
     4114       def var gds-code as int no-undo.
     4115       def var cli-qnty as dec no-undo.
     4116       def var v-root-node as int no-undo.
     4117       def var vat-pc as dec no-undo.
     4118       find first ub.trn-doc no-lock
     4119           where ub.trn-doc.doc-code = p-doc-code
     4120           no-error.
     4121       if error-status:error then
     4122           return error subst("Не найден документ с кодом &1", p-doc-code).
     4123   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclin in g#lib-trn
     4124   (input ub.trn-doc.doc-code
     4125   ,input tt2-doc-line.artic
     4126   ,input tt2-doc-line.prod-type
     4127   ,input tt2-doc-line.prod-code
     4128   ,input ub.trn-doc.obj-type
     4129   ,input ub.trn-doc.obj-code
     4130   ,input ''
     4131   ,input trn-doc.ext-doc-type
     4132   ,input tt2-doc-line.prt-root
     4133   ,input tt2-doc-line.vat-pc
     4134   ,input 0
     4135   ,input 0
     4136   ) no-error
     4137   .
     4138       if error-status:error then
     4139           return error substitute("Ошибка при создании линии накладной &1, &2", ub.trn-doc.doc-code, return-value).
     4140       find first ub.doc-line
     4141           where ub.doc-line.doc-code = ub.trn-doc.doc-code
     4142           and ub.doc-line.artic = tt2-doc-line.artic
     4143           and ub.doc-line.prod-type = tt2-doc-line.prod-type
     4144           and ub.doc-line.prod-code = tt2-doc-line.prod-code
     4145           share-lock.
     4146       buffer-copy tt2-doc-line to ub.doc-line.
     4147   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4148   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4149     (input  ub.doc-line.artic
     4150     ,input  ub.doc-line.prod-type
     4151     ,input  ub.doc-line.prod-code
     4152     ,output v-root-node
     4153     )  .
     4154   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     4155     ( input ub.trn-doc.obj-code
     4156      ,input ub.trn-doc.obj-type
     4157      ,input ub.trn-doc.doc-code
     4158      ,input ub.doc-line.artic
     4159      ,input ub.doc-line.prod-code
     4160      ,input ub.doc-line.prod-type
     4161      ,input v-root-node
     4162      ,input true
     4163     )  .
     4164       find first ub.gds-dtl share-lock
     4165           where ub.gds-dtl.doc-code = ub.trn-doc.doc-code
     4166           and ub.gds-dtl.artic = tt2-doc-line.artic
     4167           and ub.gds-dtl.prod-type = tt2-doc-line.prod-type
     4168           and ub.gds-dtl.prod-code = tt2-doc-line.prod-code
     4169           and ub.gds-dtl.prt-code = v-root-node.
     4170       buffer-copy ub.doc-line to ub.gds-dtl.
     4171       for each tt-parts
     4172         where tt-parts.artic = tt2-doc-line.artic
     4173           and tt-parts.prod-type = tt2-doc-line.prod-type
     4174           and tt-parts.prod-code = tt2-doc-line.prod-code:
     4175         create ub.parts.
     4176           buffer-copy tt-parts except tt-parts.supp-type tt-parts.supp-code to ub.parts
     4177             assign ub.parts.pl-code = 0.
     4178       end.
     4179   end.
