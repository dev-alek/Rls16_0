     3285                   run create-line(new_trn-doc.doc-code, input-output table tt2-doc-line).
     3286                 end.
     3287               end.
     3288               if is-tsd then do:
     3289                 for each ub.doc-line exclusive-lock where new_trn-doc.doc-code = ub.doc-line.doc-code:
     3290                   find first buf_goods where ub.doc-line.artic = buf_goods.artic and
     3291                     ub.doc-line.prod-type = buf_goods.prod-type  and
     3292                     ub.doc-line.prod-code = buf_goods.prod-code
     3293                     no-lock no-error .
     3294                   find first ub.gds-dtl exclusive-lock where ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     3295                     ub.gds-dtl.artic = buf_goods.artic and
     3296                     ub.gds-dtl.prod-type = buf_goods.prod-type  and
     3297                     ub.gds-dtl.prod-code = buf_goods.prod-code.
     3298                   find first temp_doc-line where temp_doc-line.gds-code = buf_goods.gds-code.
     3299                   ub.gds-dtl.doc-qnty  = temp_doc-line.doc-qnty.
     3300                   ub.gds-dtl.fact-qnty = temp_doc-line.fact-qnty.
     3301                   ub.doc-line.fact-qnty = temp_doc-line.fact-qnty.
     3302                   ub.doc-line.doc-qnty = temp_doc-line.doc-qnty.
     3303                   ub.doc-line.cli-qnty = temp_doc-line.cli-qnty.
     3304                 end.
     3305               end.
     3306               if not is-tsd then do:
     3307                 run gbl/calc-trn.p (  this-procedure , recid(new_trn-doc)) no-error .
     3308                 if error-status :error then do:
     3309                   v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     3310                   run pcall-log-file in p-log-handle ( input v-end-message ) .
     3311                   undo, return error v-end-message.
     3312                 end.
     3313               end.
     3314               if v-ext-doc-type = 'ee':U and not is-tsd then do:
     3315               run clos-trn in this-procedure (new_trn-doc.doc-code) no-error .
     3316                   if error-status:error then do :
     3317                      v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3318                      run pcall-log-file in p-log-handle ( input v-end-message ) .
     3319                      undo, return error v-end-message.
     3320                   end.
     3321                   if is-unit-error then do:
     3322                     new_trn-doc.flag_ = false.
     3323                   end.
     3324                   if temp_trn-doc.price-type   = 'TSFCST':U then do:
     3325                     run calc-cost-price (new_trn-doc.doc-code) no-error .
     3326                     if error-status :error then do:
     3327                         v-end-message = substitute(" Ошибка пересчета учетных цен &1 &2" , error-status :get-message(1)  , return-value) .
     3328                         run pcall-log-file in p-log-handle ( input v-end-message ) .
     3329                         undo, return error v-end-message.
     3330                     end.
     3331                   end.
     3332      run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     3333           if error-status:error then do :
     3334              v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3335              run pcall-log-file in p-log-handle ( input v-end-message ) .
     3336              undo, return error v-end-message.
     3337           end.
     3338               end.
     3339             assign
     3340               new_trn-doc.PS  = trim(new_trn-doc.PS) + " " + v-str-txt .
     3341         end.
     3342      end case.
     3343     if new_trn-doc.vat-type = "" or new_trn-doc.vat-type = ? or
     3344        new_trn-doc.slt-type = "" or new_trn-doc.slt-type = ? then do:
     3345           v-end-message = substitute(" Не настроено значение тип НДС или тип НсП !!! АРМ Администратор/Глобальные параметры/ &1 &2" , error-status :get-message(1)  , return-value) .
     3346           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3347           undo, return error v-end-message.
     3348     end.
     3349      run add-nn (new_trn-doc.doc-code , temp_trn-doc.doc-id ) no-error .
     3350       if error-status:error then do :
     3351           v-end-message = substitute(" Ошибка записи атрибута документа &1 &2" , error-status :get-message(1)  , return-value) .
     3352           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3353           undo, return error v-end-message.
     3354       end.
     3355      if temp_trn-doc.cargo-from <> ""
     3356      then do:
     3357       find first ub.doc-attr exclusive-lock where
     3358                ub.doc-attr.doc-code = new_trn-doc.doc-code and
     3359                ub.doc-attr.attr-code = 'Shipper':U no-error .
     3360       if not available ub.doc-attr then create ub.doc-attr.
     3361       assign
     3362         ub.doc-attr.doc-code = new_trn-doc.doc-code
     3363         ub.doc-attr.attr-code = 'Shipper':U
     3364         ub.doc-attr.attr-value = temp_trn-doc.cargo-from
     3365       .
     3366     end.
     3367       if is-egais then do:
     3368         for each  ub.doc-line where ub.doc-line.doc-code = new_trn-doc.doc-code:
     3369           find first buf_goods where ub.doc-line.artic = buf_goods.artic and
     3370             ub.doc-line.prod-type = buf_goods.prod-type  and
     3371             ub.doc-line.prod-code = buf_goods.prod-code
     3372             no-lock no-error .
     3373           release temp_doc-line.
     3374           for each ub.parts exclusive-lock
     3375             where ub.parts.in-code   = new_trn-doc.doc-code
     3376               and ub.parts.artic     = ub.doc-line.artic
     3377               and ub.parts.prod-type = ub.doc-line.prod-type
     3378               and ub.parts.prod-code = ub.doc-line.prod-code
     3379               by ub.parts.qnty:
     3380             find next temp_doc-line where temp_doc-line.gds-code = buf_goods.gds-code and temp_doc-line.doc-qnty =  ub.parts.qnty no-lock use-index qntyIndex no-error.
     3381             if not available (temp_doc-line) then do:
     3382               find first temp_doc-line where  temp_doc-line.gds-code = buf_goods.gds-code and temp_doc-line.doc-qnty =  ub.parts.qnty no-lock use-index qntyIndex no-error.
     3383             end.
     3384             ub.parts.price-cli = temp_doc-line.price-cli.
     3385             ub.parts.price-rubl = (temp_doc-line.price-cli  * new_trn-doc.exch-rate / new_trn-doc.exch-scale) / ub.parts.cli-base-rate.
     3386             ub.parts.price-base = ub.parts.price-rubl / new_trn-doc.base-rate * new_trn-doc.base-scale.
     3387             run trg/partps.p ( input buf_goods.gds-code
     3388                              , input parts.in-code
     3389                              , ?
     3390                              , input parts.part-code
     3391                              , input g#db-num
     3392                              , input ?
     3393                              , input ?
     3394                              , input temp_doc-line.refA + ',' + temp_doc-line.refB + ',' + temp_doc-line.alc-code  + ',' + temp_doc-line.alc-type-code
     3395                              , input ""
     3396                              , input ""
     3397                              , if temp_doc-line.importer <> "" then substring (temp_doc-line.importer-th, 1, 3) else ""
     3398                              , if temp_doc-line.importer <> "" then substring (temp_doc-line.importer-th, 4) else ""
     3399                              ) no-error .
     3400             if error-status :error
     3401             then do:
     3402               message
     3403                 vss-workfile vss-revision vss-description skip
     3404                 "Ошибка при вызове процедуры partps.p" skip
     3405                 error-status :get-message(1) skip
     3406                 return-value skip
     3407                 view-as alert-box error .
     3408               run waitfram-hide.
     3409               undo, return error .
     3410             end.
     3411           end.
     3412         end.
     3413       end.
     3414       assign
     3415           v-end-message =  string(temp_trn-doc.obj-type) + string(temp_trn-doc.obj-code)
     3416                       + chr(9) + "Документ:" + string(new_trn-doc.doc-code) + " / " + string(temp_trn-doc.doc-code) + chr(9) + string( k ) + " товаров"
     3417                       .
     3418        run pcall-log-file in p-log-handle (input v-end-message) .
     3419        p-ok-doc = p-ok-doc + 1.
     3420        p-doc-code = new_trn-doc.doc-code.
     3421       def var chg-qnty as decimal no-undo.
     3422       if can-find (first temp_doc-mark no-lock where temp_doc-mark.mark <> ? and trim(temp_doc-mark.mark) > "")
     3423         then
     3424       do:
     3425         for each ub.doc-line where ub.doc-line.doc-code = new_trn-doc.doc-code:
     3426           find first ub.gds-dtl where ub.gds-dtl.doc-code = ub.doc-line.doc-code
     3427             and ub.doc-line.artic = ub.gds-dtl.artic
     3428             and ub.doc-line.prod-type = ub.gds-dtl.prod-type
     3429             and ub.doc-line.prod-code = ub.gds-dtl.prod-code.
     3430           chg-qnty = 0 - ub.doc-line.fact-qnty.
     3431           run trg/rsrv-dtl.p
     3432             ( input        ParParentProc
     3433             , input        'reserv':U
     3434             , buffer       ub.gds-dtl
     3435             , input-output chg-qnty
     3436             , input-output ub.doc-line.price-base
     3437             , input-output ub.doc-line.price-rubl
     3438             , input        -1
     3439             , input         "" ) no-error .
     3440           if error-status :error
     3441             then
     3442           do:
     3443             undo, return error return-value .
     3444           end.
     3445           assign
     3446             ub.gds-dtl.fact-qnty  = 0
     3447             ub.doc-line.fact-qnty = 0
     3448           .
     3449           run gbl/calc-trn.p (input parparentproc, input recid(new_trn-doc)) no-error.
     3450         end.
     3451       end.
     3452   end.
     3453   end.
     3454   do trans:
     3455     run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     3456     if error-status:error then do :
     3457         v-end-message = substitute(" Ошибка при закрытиии документа &1 &2" , error-status :get-message(1)  , return-value) .
     3458         run pcall-log-file in p-log-handle ( input v-end-message ) .
     3459         return.
     3460     end.
     3461     if new_trn-doc.ext-doc-type = 'ie':U and new_trn-doc.cli-type ne 'маг'   then do:
     3462       run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     3463       if error-status:error then do :
     3464           v-end-message = substitute(" Ошибка при закрытиии внешнего прихода &1 на факт: &2" , error-status :get-message(1)  , return-value) .
     3465           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3466           return.
     3467       end.
     3468     end.
     3469     if new_trn-doc.ext-doc-type = 're':U    then do:
     3470         v-end-message = substitute("Закрытиии внешнего возврата &1 на статус РАЗР " , new_trn-doc.doc-code) .
     3471         run pcall-log-file in p-log-handle ( input v-end-message ) .
     3472         run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     3473         if error-status:error then do :
     3474             v-end-message = substitute(" Ошибка при закрытиии внешнего возврата на статус РАЗР &1 &2" , error-status :get-message(1)  , return-value) .
     3475             run pcall-log-file in p-log-handle ( input v-end-message ) .
     3476             undo, return error v-end-message.
     3477         end.
     3478         if not is-egais
     3479         then do:
     3480           v-end-message = substitute("Закрытиии внешнего возврата &1 на статус ФАКТ ", new_trn-doc.doc-code ) .
     3481           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3482           run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     3483           if error-status:error then do :
     3484               v-end-message = substitute(" Ошибка при закрытиии внешнего возврата на статус ФАКТ &1 &2" , error-status :get-message(1)  , return-value) .
     3485               run pcall-log-file in p-log-handle ( input v-end-message ) .
     3486               undo, return error v-end-message.
     3487           end.
     3488         end.
     3489     end.
     3490     if new_trn-doc.ext-doc-type = 'ee':U    then do:
     3491       new_trn-doc.fact-date = now.
     3492       run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     3493       if error-status:error then do :
     3494           v-end-message = substitute(" Ошибка при закрытиии &1 на факт: &2" , error-status :get-message(1)  , return-value) .
     3495           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3496           return.
     3497       end.
     3498     end.
     3499   end.
     3500   procedure clos-trn :
     3501     do
     3502     on error undo, return error return-value
     3503     :
     3504   define input parameter p-trn-code as character no-undo .
     3505   define buffer buf_s-trn-doc for ub.trn-doc.
     3506   define variable varmode            as   character           no-undo.
     3507   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3508   define variable varflag            like ub.trn-doc.flag     no-undo.
     3509   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3510   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3511   define variable varcheck-return as logical no-undo .
     3512   define variable varchg-inv      as logical no-undo .
     3513   assign
     3514     varmode         = '<закрытие документа>':U
     3515     varstatus       = 'запрос':U
     3516     varflag         = true
     3517     varcopystatus   = 'новый':U
     3518     varcopyflag     = false
     3519     varcheck-return = true
     3520     varchg-inv      = true
     3521     .
     3522   for each tt2-doc-line where is-tsd and doc-code = p-trn-code no-lock:
     3523     run unitqnty1 (
     3524         input tt2-doc-line.unit-cli,
     3525         input "",
     3526         input "",
     3527         input 0,
     3528         input "",
     3529         input tt2-doc-line.doc-qnty)
     3530     no-error.
     3531     if error-status:error then do:
     3532       run pcall-log-file in p-log-handle (input return-value) .
     3533       is-unit-error  = true.
     3534     end.
     3535     run unitqnty1 (
     3536         input tt2-doc-line.unit-cli,
     3537         input "",
     3538         input "",
     3539         input 0,
     3540         input "",
     3541         input tt2-doc-line.fact-qnty)
     3542     no-error.
     3543     if error-status:error then do:
     3544       run pcall-log-file in p-log-handle (input return-value) .
     3545       is-unit-error  = true.
     3546     end.
     3547   end.
     3548   if is-unit-error then do:
     3549     run pcall-log-file in p-log-handle (input "Невозможно перевести накладную в статус накл") .
     3550     return.
     3551   end.
     3552   run str/trn-graf.p
     3553     ( input  p-trn-code ,
     3554       input  v-cntxt-db-num ,
     3555       input  varmode ,
     3556       output varstatus ,
     3557       output varflag ,
     3558       output varcopystatus ,
     3559       output varcopyflag
     3560     ) no-error .
     3561       if error-status:error then do :
     3562           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3563           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3564           undo, return error v-end-message.
     3565       end.
     3566   run str/trn-stat.p (
     3567       input  parparentproc ,
     3568       input  this-procedure ,
     3569       input  varmode,
     3570       input  p-trn-code,
     3571       input  varcheck-return,
     3572       input  v-cntxt-db-num,
     3573       input  v-cntxt-in-ov,
     3574       input  v-cntxt-rsrv-time,
     3575       input  v-cntxt-load-time,
     3576       input  v-cntxt-holidays,
     3577       input  NO,
     3578       output varchg-inv,
     3579       output table gds-list)
     3580       no-error.
     3581       if error-status:error then do :
     3582           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3583           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3584           return error v-end-message.
     3585       end.
     3586     end.
     3587     if is-tsd then do:
     3588       for each ub.doc-line exclusive-lock where new_trn-doc.doc-code = ub.doc-line.doc-code:
     3589         find first buf_goods where ub.doc-line.artic = buf_goods.artic and
     3590           ub.doc-line.prod-type = buf_goods.prod-type  and
     3591           ub.doc-line.prod-code = buf_goods.prod-code
     3592           no-lock no-error .
     3593         find first ub.gds-dtl exclusive-lock where ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     3594           ub.gds-dtl.artic = buf_goods.artic and
     3595           ub.gds-dtl.prod-type = buf_goods.prod-type  and
     3596           ub.gds-dtl.prod-code = buf_goods.prod-code.
     3597         find first temp_doc-line where temp_doc-line.gds-code = buf_goods.gds-code.
     3598         ub.gds-dtl.doc-qnty  = temp_doc-line.doc-qnty.
     3599         ub.gds-dtl.fact-qnty = temp_doc-line.fact-qnty.
     3600         ub.doc-line.fact-qnty = temp_doc-line.fact-qnty.
     3601         ub.doc-line.doc-qnty = temp_doc-line.doc-qnty.
     3602         ub.doc-line.cli-qnty = temp_doc-line.cli-qnty.
     3603       end.
     3604     end.
     3605   end procedure.
     3606   procedure clos-trn2 :
     3607   define input parameter p-trn-code as character no-undo .
     3608     do
     3609     on error undo, return error return-value
     3610     :
     3611   define buffer buf_s-trn-doc for ub.trn-doc.
     3612   define variable varmode            as   character           no-undo.
     3613   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3614   define variable varflag            like ub.trn-doc.flag     no-undo.
     3615   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3616   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3617   define variable varcheck-return as logical no-undo .
     3618   define variable varchg-inv as logical no-undo .
     3619   define variable v-root-b-code like ub.bar-code.b-code no-undo .
     3620   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3621   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     3622   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     3623   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     3624   define variable gp-excise     like ub.price-list.excise     no-undo.
     3625   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     3626   define variable gp-fact-order as decimal   no-undo .
     3627   define variable gp-price-sale-parts as decimal   no-undo .
     3628   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3629     run mainmenu_getcntxt in this-procedure
     3630       (output v-cntxp-db-num
     3631       ,output v-cntxp-userid
     3632       ,output v-cntxp-level
     3633       ,output v-cntxp-curr-host-code
     3634       ,output v-cntxp-obj-type
     3635       ,output v-cntxp-obj-code
     3636       ,output v-cntxp-db-num-obj
     3637       ,output v-cntxp-is-admin
     3638       ) .
     3639     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     3640        v-cntxp-obj-code <> 0 then do:
     3641   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3642     (input  'is-prt'
     3643     ,input  0
     3644     ,input  ''
     3645     ,input  0
     3646     ,input  ''
     3647     ,input  ''
     3648     ,input  ''
     3649     ,input  yes
     3650     ,output v-cntxp-conf-par
     3651     ,output v-cntxp-par-type
     3652     ) no-error .
     3653       case v-cntxp-obj-type :
     3654         when 'скл':U then do:
     3655           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     3656           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     3657           assign
     3658             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     3659             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     3660             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     3661             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     3662             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     3663             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     3664             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     3665             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     3666             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     3667             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     3668             v-cntxp-load-time       = bf-cntxp_store.load-time
     3669             v-cntxp-holidays        = bf-cntxp_store.holidays
     3670             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     3671             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     3672             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     3673             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     3674             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     3675             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     3676             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     3677             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3678             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3679             .
     3680         end.
     3681         when 'маг':U then do:
     3682           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     3683           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     3684           assign
     3685             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     3686             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     3687             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     3688             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     3689             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     3690             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     3691             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     3692             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     3693             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     3694             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     3695             v-cntxp-load-time       = bf-cntxp_shop.load-time
     3696             v-cntxp-holidays        = bf-cntxp_shop.holidays
     3697             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     3698             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     3699             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     3700             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     3701             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     3702             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     3703             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     3704             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3705             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3706             .
     3707         end.
     3708       end case.
     3709     end.
     3710   if v-cntxp-no-eq
     3711   then do:
     3712     for each ub.doc-line no-lock where ub.doc-line.doc-code = p-trn-code:
     3713       find first ub.goods where ub.doc-line.artic = ub.goods.artic and
     3714         ub.doc-line.prod-type = ub.goods.prod-type  and
     3715         ub.doc-line.prod-code = ub.goods.prod-code
     3716         no-lock no-error .
     3717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3718     (input  ub.goods.gds-code
     3719     ,input  ?
     3720     ,output v-root-b-code
     3721     )  .
     3722   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3723   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3724     (input  ub.doc-line.obj-type
     3725     ,input  ub.doc-line.obj-code
     3726     ,input  v-root-b-code
     3727     ,input  0
     3728     ,input  0
     3729     ,output gp-doc-num
     3730     ,output gp-price-sale
     3731     ,output gp-road-tax
     3732     ,output gp-excise
     3733     ) no-error .
     3734         if gp-price-sale = ?
     3735         then do:
     3736           v-end-message = "Артикул:" + ub.goods.artic + "Производитель:" + ub.goods.prod-type + string (ub.goods.prod-code) +
     3737           ub.goods.gds-name + "Продажная цена отсутствует запрещено закрывать такой приход. Сделайте переоценку по этой накладной.".
     3738         run pcall-log-file in p-log-handle ( input v-end-message ) .
     3739         return v-end-message.
     3740       end.
     3741     end.
     3742   end.
     3743   run str/trn-stat.p (
     3744       input  parparentproc ,
     3745       input  this-procedure ,
     3746       input  '<закрытие документа>':U ,
     3747       input  p-trn-code,
     3748       input  false  ,
     3749       input  v-cntxt-db-num,
     3750       input  false ,
     3751       input  v-cntxt-rsrv-time,
     3752       input  v-cntxt-load-time,
     3753       input  v-cntxt-holidays,
     3754       input  false ,
     3755       output varchg-inv ,
     3756       output table gds-list)
     3757       no-error.
     3758       if error-status:error then do :
     3759           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3760           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3761           return error v-end-message.
     3762       end.
     3763     end.
     3764   end procedure.
     3765   procedure mainmenu_getcntxt :
