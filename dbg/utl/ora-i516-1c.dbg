       79   define input  PARAMETER TABLE FOR  temp_trn-doc.
       80   define input  PARAMETER TABLE FOR  temp_doc-line.
       81   define input  PARAMETER TABLE FOR  temp_doc-mark.
       82   define output parameter p-doc-code as character   no-undo .
       83   define output parameter p-ok-doc as integer   no-undo .
       84   define variable vss-revision    as character no-undo init "$Revision: 7c9dcd0c265b, 3134, rls $":U .
       85   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       86   define variable vss-date        as character no-undo init "$Date: 2022/09/15 11:05:54 $":U .
       87   define variable vss-workfile    as character no-undo init "$Workfile: ora-i516-1c.p $":U .
       88   define variable vss-archive     as character no-undo init "$Archive: utl/ora-i516-1c.p $":U .
       89   define variable vss-description as character no-undo init "Импорт накладных из временной таблицы".
       90   procedure vss-get-info :
       91     define output parameter p-vss-revision    like vss-revision    no-undo .
       92     define output parameter p-vss-author      like vss-author      no-undo .
       93     define output parameter p-vss-date        like vss-date        no-undo .
       94     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       95     define output parameter p-vss-archive     like vss-archive     no-undo .
       96     define output parameter p-vss-description like vss-description no-undo .
       97     assign
       98       p-vss-revision    = vss-revision
       99       p-vss-author      = vss-author
      100       p-vss-date        = vss-date
      101       p-vss-workfile    = vss-workfile
      102       p-vss-archive     = vss-archive
      103       p-vss-description = vss-description
      104     .
      105   end procedure.
      106   procedure vss-get-parameters :
      107     define output parameter p-vss-parameters as character no-undo .
      108   end procedure.
      109   define new global shared variable g#vssrevis-logger as handle    no-undo .
      110   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      111   define variable v-vssrevis-logger                   as handle    no-undo .
      112   procedure vss-logevent :
      113     define input  parameter p-extra-paramters as character no-undo .
      114     define variable v-vssrevis-parameters as character no-undo .
      115     do
      116     on error undo, return error return-value
      117     :
      118       if  valid-handle(v-vssrevis-logger)
      119       and v-vssrevis-logger :get-signature("logevent") <> ""
      120       then do:
      121         run vss-get-parameters in this-procedure
      122           (output v-vssrevis-parameters
      123           ).
      124         run logevent in v-vssrevis-logger
      125           (input vss-workfile
      126           ,input vss-revision
      127           ,input v-vssrevis-parameters
      128           ,input p-extra-paramters
      129           ).
      130       end.
      131     end.
      132   end procedure.
      133   assign
      134     v-vssrevis-logger = g#vssrevis-logger
      135   .
      136   if  valid-handle(v-vssrevis-logger)
      137   and v-vssrevis-logger :get-signature("logevent") <> ""
      138   then do:
      139     assign
      140       v-vssrevis-logevent = true
      141     .
      142     run vss-logevent in this-procedure (input vss-description) .
      143   end.
      144   define new global shared variable g#language as character no-undo .
      145   if g#language <> '' and g#language <> 'rus':U then do:
      146     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      147   end.
      148   define new global shared variable g#library  as handle no-undo .
      149   define new global shared variable g#library2 as handle no-undo .
      150   define new global shared variable g#lib-trn  as handle no-undo .
      151   define new global shared variable g#lib-trn2 as handle no-undo .
      152   define new global shared variable g#lib-trn3 as handle no-undo .
      153   define new global shared variable g#lib-trn4 as handle no-undo .
      154   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   define variable to-day       as date no-undo .
      156   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      157   procedure doc-code:
      158   define input  parameter parmode          as   character           no-undo.
      159   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      160   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      161   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      162   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      163   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      164   define variable vardb-remote     as   logical             no-undo.
      165   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      166   define variable v-delimiter as character no-undo .
      167   do
      168   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      169   :
      170   find first buf_sys-ctrl no-lock .
      171   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      172     CASE parmode:
      173       when "main":u then do:
      174         if vardb-remote then do:
      175           assign
      176             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      177         end.
      178         else do:
      179           assign
      180             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      181         end.
      182       end.
      183       when "trio" then do:
      184         assign
      185           pardoc-code = replace (parroot-doc-code, "=", "*").
      186       end.
      187       otherwise do:
      188         assign
      189         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      190         no-error
      191         .
      192         if error-status:error  then do:
      193           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      194                                         ,chr(10)
      195                                         ,parmode
      196                                         ).
      197         end.
      198         if num-entries(parmode) = 1
      199         and parmode <> "chip":U
      200         and parmode <> "chip_s":U
      201         then do:
      202           assign
      203           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      204         end.
      205         else if (lookup("chip":U, parmode) > 0
      206                  or
      207                  lookup("chip_s":U, parmode) > 0) then do:
      208           assign
      209             vartemp-doc-code = parroot-doc-code.
      210           do while true:
      211             if index (vartemp-doc-code , ".") = 0 then
      212               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      213             else
      214               vartemp-doc-code  =
      215               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      216               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      217               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      218             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      219           end.
      220           assign
      221             pardoc-code = vartemp-doc-code.
      222         end.
      223       end.
      224     end CASE.
      225     if pardoc-code = '':U
      226     or (parroot-doc-code <> '':U
      227     and pardoc-code = parroot-doc-code) then do:
      228       undo, return error substitute("Ошибка при генерации номера документа&1"
      229                                     ,chr(10)).
      230     end.
      231   end.
      232   end. // procedure/method
      233   function get-doc-code-int64 returns int64
      234     ( input p-doc-code as character ) :
      235     define variable v-ind              as integer   no-undo .
      236     define variable v-num-entries      as integer   no-undo .
      237     define variable v-doc-code-int64   as int64     no-undo .
      238     define variable v-canonic-doc-code as character no-undo .
      239     assign
      240       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      241       v-canonic-doc-code = p-doc-code
      242     .
      243     do v-ind = 1 to v-num-entries
      244     :
      245       assign
      246         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      247       .
      248     end.
      249     assign
      250       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      251     .
      252     return v-doc-code-int64 .
      253   end. // function/method
      254   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   define variable v-waitfram-action01         as character   no-undo .
      256   define variable v-waitfram-action02         as character   no-undo .
      257   define variable v-waitfram-action03         as character   no-undo .
      258   define variable mWaitFramTextBeg            as character   no-undo.
      259   define variable mWaitFramTextEnd            as character   no-undo.
      260   define variable mWaitFramView               as logical     no-undo.
      261   define variable mWaitProcEvent              as logical     no-undo init yes.
      262   define variable mWaitFramInterval           as integer     no-undo init 1 .
      263   define variable mWaitFramStop               as logical     no-undo.
      264   define variable mWaitFramStopUser           as logical     no-undo.
      265   define variable mWaitFramStopTimeOut        as logical     no-undo.
      266   define variable mWaitFramStartProc          as datetime-tz no-undo.
      267   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      268   define button B-WaitFramStop auto-end-key
      269        label "Стоп"
      270        size 10 by 1 tooltip "Остоновить процесс".
      271   define button B-viewProcInfo
      272        label "Информация"
      273        size 15 by 1 tooltip "Информация о процесс".
      274   define frame waitfram
      275     v-waitfram-action01 format "x(72)" no-label skip
      276     v-waitfram-action02 format "x(72)" no-label skip
      277     v-waitfram-action03 format "x(72)" no-label skip
      278     B-viewProcInfo
      279     B-WaitFramStop at row 4 col 30
      280     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      281     .
      282   define new global shared variable mBatchMode as logical no-undo init ?.
      283   define variable mFramBachModHandle as handle no-undo.
      284   mFramBachModHandle = frame waitfram:handle.
      285   define variable mFameOldVis as logical no-undo.
      286   define variable mVisCUrentVin as logical no-undo.
      287   if session:batch-mode
      288   then
      289      mBatchMode = yes.
      290   if mBatchMode = ? then do:
      291     mVisCUrentVin = current-window:visible.
      292     mFameOldVis = mFramBachModHandle:visible.
      293     mFramBachModHandle:visible  = yes.
      294     mBatchMode = mFramBachModHandle:visible ne yes.
      295     mFramBachModHandle:visible = mFameOldVis.
      296     current-window:visible = mVisCUrentVin.
      297   end.
      298    if  log-manager:logfile-name ne ?
      299     then DO:
      300         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      301         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      302         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      303     end.
      304   on choose of B-WaitFramStop in frame waitfram
      305   do:
      306     mWaitFramStop = yes.
      307     mWaitFramStopUser = yes.
      308   end.
      309   function waitfram-check-timeout returns logical():
      310      define variable vtime as int64 no-undo.
      311      if mWaitFramStopTimeOut
      312      then
      313         return yes.
      314      vtime = ( now - mWaitFramStartProc ) / 1000 .
      315      if     mWaitFramTimeOut ne ?
      316         and mWaitFramTimeOut ne 0
      317         and mWaitFramTimeOut lt vtime
      318      then do:
      319         mWaitFramStopTimeOut = yes.
      320      end.
      321      return mWaitFramStopTimeOut.
      322   end.
      323   procedure waitfram-hide :
      324     if not session:batch-mode
      325     then do
      326     on error undo, return error return-value
      327     :
      328       pause 0 before-hide .
      329       if not mBatchMode then
      330         hide frame waitfram .
      331     if     not mWaitFramView
      332        and mWaitProcEvent
      333     then
      334       process events .
      335     end.
      336   end procedure.
      337   procedure waitfram-show :
      338     define input  parameter p-message as character no-undo .
      339     define variable v-left-margin as integer   no-undo .
      340     if not session:batch-mode
      341     then do
      342     on error undo, return error return-value
      343     :
      344       if length(p-message) <= 70 then do:
      345         assign
      346           v-left-margin = integer((70 - length(p-message)) / 2)
      347         .
      348         assign
      349           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      350         .
      351         assign
      352           v-waitfram-action01 = " "
      353           v-waitfram-action02 = " "
      354                                    + fill(" ", v-left-margin)
      355                                    + p-message
      356           v-waitfram-action03 = " "
      357         .
      358       end.
      359       else do:
      360         define variable vRindex1 as integer no-undo.
      361         define variable vRindex2 as integer no-undo.
      362         vRindex1 = r-index(p-message," ",70).
      363         if vRindex1 = 0
      364         then
      365            vRindex1 = 70.
      366         if length(p-message)  <= vRindex1 + 70 then do:
      367           assign
      368             v-waitfram-action01 = " "
      369             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      370             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      371           .
      372         end.
      373         else do:
      374           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      375           if vRindex2 <= vRindex1
      376           then
      377              vRindex2 = vRindex1 + 70.
      378           assign
      379             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      380             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      381             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      382           .
      383         end.
      384       end.
      385       B-viewProcInfo:visible   in frame waitfram = no.
      386       B-viewProcInfo:sensitive in frame waitfram = no.
      387       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      388       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      389       if  (   mWaitFramView
      390          or  mWaitProcEvent)
      391          and not mBatchMode
      392       then
      393          display
      394             v-waitfram-action01 skip
      395             v-waitfram-action02 skip
      396             v-waitfram-action03 skip
      397          with frame waitfram .
      398       if     mWaitFramView
      399          then do:
      400             if     mWaitFramInterval ne ?
      401                and not mBatchMode
      402             then
      403                wait-for go of frame waitfram pause mWaitFramInterval.
      404          end.
      405          else
      406             if     mWaitProcEvent
      407                and not mBatchMode
      408             then
      409                process events .
      410     end.
      411   end procedure.
      412      procedure waitfram-show-this:
      413         define input  parameter iInterval as int64 no-undo.
      414         define variable vtime as int64 no-undo.
      415         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      416         mWaitFramInterval = iInterval.
      417         run waitfram-show (substitute("&1&2 &3&4" ,
      418                                       mWaitFramTextBeg ,
      419                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      420                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      421                                       mWaitFramTextEnd
      422                                      )
      423                           ).
      424      end.
      425      procedure WaitFramRunPause:
      426         define input  parameter iInterval as dec no-undo.
      427         define variable vStart  as datetime-tz no-undo.
      428         define variable vend    as datetime-tz no-undo.
      429         define variable vint as int64 no-undo.
      430         define variable vOk as logical no-undo.
      431         vStart = now.
      432         vend   = vStart.
      433         publish "WaitFramPause" (iInterval,output vOk).
      434         vend   =  now.
      435         vint = vend - vStart.
      436         vint = iInterval - vint / 1000.
      437         if     not mWaitFramStop
      438            and (   vint > 0
      439                 or (    not vOk
      440                     and iInterval eq ?
      441                     )
      442                 )
      443         then
      444            run waitfram-show-this (iInterval).
      445         vend   =  now.
      446         vint = vend - vStart.
      447         vint = iInterval - vint / 1000.
      448         if     not mWaitFramStop
      449            and vint > 0
      450         then do:
      451            run gbl/pause.p (vint * 1000).
      452         end.
      453         if iInterval ne ?
      454         then
      455            publish "WaitFramStop".
      456         waitfram-check-timeout().
      457      end.
      458      procedure WaitFramWaitFor:
      459         define input  parameter iInterval as dec no-undo.
      460         assign
      461            mWaitFramStartProc   = now
      462            mWaitFramStopUser    = no
      463            mWaitFramStopTimeOut = no
      464         .
      465         block-wait:
      466         do while not mWaitFramStop:
      467            run WaitFramRunPause (iInterval).
      468            if  waitfram-check-timeout()
      469            then do:
      470               leave block-wait.
      471            end.
      472         end.
      473         run waitfram-hide.
      474      end.
      475   procedure waitfram-join :
      476     define input  parameter p-line-1  as character no-undo .
      477     define input  parameter p-line-2  as character no-undo .
      478     define input  parameter p-line-3  as character no-undo .
      479     define output parameter p-message as character no-undo .
      480     do
      481     on error undo, return error return-value
      482     :
      483       assign
      484         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      485                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      486                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      487       .
      488     end.
      489   end procedure.
      490   function waitfram-join-function returns character
      491     (input p-line-1 as character
      492     ,input p-line-2 as character
      493     ,input p-line-3 as character
      494     ).
      495     define variable v-message as character no-undo .
      496     run waitfram-join in this-procedure
      497       (input  p-line-1
      498       ,input  p-line-2
      499       ,input  p-line-3
      500       ,output v-message
      501       ) .
      502     return v-message .
      503   end function .
      504   function cross-list returns logical (
      505     input parfirst-stream  as character,
      506     input parsecond-stream as character,
      507     input pardelim         as character).
      508     if pardelim = ""
      509     or pardelim = ?
      510     then do:
      511       assign
      512         pardelim = ","
      513       .
      514     end.
      515     define variable vari            as integer no-undo .
      516     define variable varresult-cross as logical no-undo .
      517     assign
      518       varresult-cross = no
      519     .
      520     def var v-num-parfirst-stream as integer no-undo .
      521     assign
      522       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      523     .
      524     do vari = 1 to v-num-parfirst-stream
      525     :
      526       if lookup(entry(vari, parfirst-stream, pardelim)
      527                ,parsecond-stream
      528                ,pardelim
      529                ) > 0 then do:
      530         assign
      531           varresult-cross = yes
      532         .
      533         leave.
      534       end.
      535     end.
      536     return varresult-cross .
      537   end function.
