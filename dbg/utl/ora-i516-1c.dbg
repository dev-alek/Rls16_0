     1391     define buffer bf-cntxp_sysconf for ub.sysconf.
     1392   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
     1393   procedure who-cli-ora :
     1394   define input  parameter p-cli-code-ora as integer   no-undo .
     1395   define output parameter p-cli-type as character no-undo .
     1396   define output parameter p-cli-code as integer   no-undo .
     1397     do
     1398     on error undo, return error return-value
     1399     :
     1400     if length (string(p-cli-code-ora))  <> 9 then do:
     1401        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
     1402     end.
     1403     if string(p-cli-code-ora) begins "1" or
     1404        string(p-cli-code-ora) begins "2" or
     1405        string(p-cli-code-ora) begins "4" then do:
     1406         p-cli-type = 'орг':U .
     1407         p-cli-code = p-cli-code-ora  .
     1408     end.
     1409     else do:
     1410       if string(p-cli-code-ora) begins "3" then do:
     1411         p-cli-type = 'чел':U .
     1412         p-cli-code = p-cli-code-ora  .
     1413       end.
     1414       else do:
     1415          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
     1416       end.
     1417     end.
     1418     define buffer buf_clients for ub.clients  .
     1419     find first buf_clients no-lock where
     1420                buf_clients.obj-type = p-cli-type and
     1421                buf_clients.obj-code = p-cli-code
     1422                no-error .
     1423         if error-status :error then do:
     1424             return error substitute
     1425             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
     1426                 p-cli-code-ora ,
     1427                 p-cli-type ,
     1428                 p-cli-code ) .
     1429         end.
     1430         if ora-icli_ver-stts-client then do:
     1431             if buf_clients.stts > 0 then do:
     1432                 return error substitute
     1433                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
     1434                     p-cli-code-ora ,
     1435                     p-cli-type ,
     1436                     p-cli-code ) .
     1437             end.
     1438         end.
     1439     end.
     1440   end procedure.
     1441   procedure ora-ver-goods :
     1442   define input  parameter p-gds-code as integer   no-undo .
     1443   define buffer buf_goods for ub.goods  .
     1444   define variable my-message as character no-undo .
     1445     do
     1446     on error undo, return error return-value
     1447     :
     1448           find first buf_goods no-lock where
     1449                      buf_goods.gds-code = p-gds-code no-error .
     1450               if error-status :error then do:
     1451                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
     1452                   undo, return error my-message.
     1453               end.
     1454             if buf_goods.stts > 0 then do:
     1455               assign
     1456                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
     1457                 undo, return error my-message.
     1458             end.
     1459     end.
     1460   end procedure.
     1461   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1462   procedure factord :
     1463     define input  parameter p-fact-date            as date    no-undo .
     1464     define input  parameter p-fact-time            as integer no-undo .
     1465     define input  parameter p-fact-num             as integer no-undo .
     1466     define input  parameter p-shift-date           as date    no-undo .
     1467     define input  parameter p-shift-num            as integer no-undo .
     1468     define input  parameter p-shift-on             as logical no-undo .
     1469     define output parameter p-fact-order           as decimal no-undo .
     1470     define output parameter p-shift-end-fact-order as decimal no-undo .
     1471     define output parameter p-day-end-fact-order   as decimal no-undo .
     1472     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1473     if p-fact-date = ?
     1474     then do:
     1475       return error "Не указана фактическая дата" .
     1476     end.
     1477     define variable v-fact-date-num as integer no-undo .
     1478     assign
     1479       v-fact-date-num = integer(p-fact-date)
     1480     .
     1481     if p-fact-num = ?
     1482     or p-fact-num = 0
     1483     then do:
     1484       return error "Не задан p-fact-num " + string(p-fact-num) .
     1485     end.
     1486     if p-fact-num < 0
     1487     then do:
     1488       return error "Отрицательный fact-num " + string(p-fact-num) .
     1489     end.
     1490     if p-fact-num >= 100000000
     1491     then do:
     1492       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1493     end.
     1494     if p-shift-on = true
     1495     then do:
     1496       if p-shift-date = ?
     1497       then do:
     1498         return error "Не задана дата смены" .
     1499       end.
     1500       if p-shift-num = ?
     1501       or p-shift-num = 0
     1502       then do:
     1503         return error "Не задан номер смены" .
     1504       end.
     1505     end.
     1506     else do:
     1507       assign
     1508         p-shift-date = p-fact-date
     1509         p-shift-num  = 24
     1510       .
     1511     end.
     1512     define variable v-shift-offset as integer no-undo .
     1513     if p-shift-date = p-fact-date
     1514     then do:
     1515       assign
     1516         v-shift-offset = 1
     1517       .
     1518     end.
     1519     if p-shift-date < p-fact-date
     1520     then do:
     1521       assign
     1522         v-shift-offset = 0
     1523       .
     1524     end.
     1525     if p-shift-date > p-fact-date
     1526     then do:
     1527       message
     1528         vss-workfile vss-revision vss-description skip
     1529         "Неправильная дата закрытия смены" skip
     1530         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1531         view-as alert-box error .
     1532       undo, return error
     1533         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1534           ,string(p-fact-date, '99/99/9999':U)
     1535           ,string(p-shift-date, '99/99/9999':U)
     1536           )
     1537       .
     1538     end.
     1539     if p-shift-num < 1
     1540     or p-shift-num > 24
     1541     then do:
     1542       message
     1543         vss-workfile vss-revision vss-description skip
     1544         "Неправильный номер смены" skip
     1545         "p-shift-num" p-shift-num skip
     1546         view-as alert-box error .
     1547       undo, return error return-value .
     1548     end.
     1549     assign
     1550       p-fact-order           = v-fact-date-num
     1551                              + v-shift-offset * 0.5
     1552                              + p-shift-num    * 0.02 - 0.01
     1553                              + p-fact-num     * 0.0000000001
     1554       p-shift-end-fact-order = v-fact-date-num
     1555                              + v-shift-offset * 0.5
     1556                              + p-shift-num    * 0.02
     1557       p-day-end-fact-order   = v-fact-date-num
     1558                              + 0.99
     1559     .
     1560     if p-fact-order           <= v-fact-date-num
     1561     or p-shift-end-fact-order <= v-fact-date-num
     1562     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1563     or p-shift-end-fact-order >= p-day-end-fact-order
     1564     then do:
     1565       message
     1566         vss-workfile vss-revision vss-description skip
     1567         "Внутренняя ошибка при генерации фактического номера" skip
     1568         "p-fact-date"            p-fact-date            skip
     1569         "p-fact-time"            p-fact-time            skip
     1570         "p-fact-num"             p-fact-num             skip
     1571         "p-shift-date"           p-shift-date           skip
     1572         "p-shift-num"            p-shift-num            skip
     1573         "p-shift-on"             p-shift-on             skip
     1574         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1575         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1576         "v-fact-date-num"        v-fact-date-num        skip
     1577         view-as alert-box error .
     1578       undo, return error return-value .
     1579     end.
     1580   end procedure.
     1581   procedure day-begin-fact-order :
     1582     define input  parameter p-fact-date            as date    no-undo .
     1583     define output parameter p-day-begin-fact-order as decimal no-undo .
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587       if p-fact-date = ?
     1588       then do:
     1589         assign
     1590           p-day-begin-fact-order = 0
     1591         .
     1592       end.
     1593       else do:
     1594         assign
     1595           p-day-begin-fact-order = integer(p-fact-date)
     1596         .
     1597       end.
     1598     end.
     1599   end procedure.
     1600   procedure factord-max-fact-order :
     1601     define output parameter p-max-fact-order as decimal   no-undo .
     1602     do
     1603     on error undo, return error return-value
     1604     :
     1605       run day-begin-fact-order in this-procedure
     1606         (input  date(1, 1, 5000)
     1607         ,output p-max-fact-order
     1608         ) .
     1609     end.
     1610   end procedure.
     1611   procedure factord-cut-archive :
     1612     define input  parameter p-obj-type             as character no-undo .
     1613     define input  parameter p-obj-code             as integer   no-undo .
     1614     define input  parameter p-fact-date            as date      no-undo .
     1615     define output parameter p-shift-on             as logical   no-undo .
     1616     define output parameter p-shift-date           as date      no-undo .
     1617     define output parameter p-shift-num            as integer   no-undo .
     1618     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1619     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1620     define variable v-fact-order as decimal   no-undo .
     1621     define buffer buf_shift-obj for ub.shift-obj .
     1622     do
     1623     on error undo, return error return-value
     1624     :
     1625   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1626   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1627     (input  p-obj-type
     1628     ,input  p-obj-code
     1629     ,input  'shift-on=request'
     1630     ,output p-shift-on
     1631     ) no-error .
     1632       if error-status :error
     1633       then do:
     1634         message
     1635           vss-workfile vss-revision vss-description skip
     1636           "Ошибка при определении атрибута объекта" skip
     1637           "Объект" p-obj-type p-obj-code skip
     1638           error-status :get-message(1) skip
     1639           return-value skip
     1640           view-as alert-box error .
     1641         undo, return error return-value .
     1642       end.
     1643       if p-shift-on = false
     1644       then do:
     1645         assign
     1646           p-shift-date               = ?
     1647           p-shift-num                = 0
     1648         .
     1649       end.
     1650       else do:
     1651         find first buf_shift-obj share-lock
     1652           where buf_shift-obj.obj-type   = p-obj-type
     1653             and buf_shift-obj.obj-code   = p-obj-code
     1654             and buf_shift-obj.shift-date > p-fact-date
     1655           use-index pi
     1656           no-error .
     1657         if not available buf_shift-obj
     1658         or buf_shift-obj.status_ <> 'зкр':U
     1659         then do:
     1660           message
     1661             vss-workfile vss-revision vss-description skip
     1662             "Невозможно вычислить последнюю смену" skip
     1663             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1664             "Объект" p-obj-type p-obj-code skip
     1665             "Дата" p-fact-date skip
     1666             view-as alert-box error .
     1667           undo, return error return-value .
     1668         end.
     1669         find last buf_shift-obj share-lock
     1670           where buf_shift-obj.obj-type = p-obj-type
     1671             and buf_shift-obj.obj-code = p-obj-code
     1672             and buf_shift-obj.shift-date <= p-fact-date
     1673           use-index pi
     1674           no-error .
     1675         if available buf_shift-obj
     1676         then do:
     1677           if  buf_shift-obj.status_ = 'зкр':U
     1678           then do:
     1679             assign
     1680               p-shift-date = buf_shift-obj.shift-date
     1681               p-shift-num  = buf_shift-obj.shift-num
     1682             .
     1683           end.
     1684           else do:
     1685             message
     1686               vss-workfile vss-revision vss-description skip
     1687               "Невозможно вычислить последнюю смену" skip
     1688               "Статус смены отличен от статуса" 'зкр':U skip
     1689               "Объект" p-obj-type p-obj-code skip
     1690               "Дата" p-fact-date skip
     1691               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1692               view-as alert-box error .
     1693             undo, return error return-value .
     1694           end.
     1695         end.
     1696         else do:
     1697           assign
     1698             p-shift-date = p-fact-date - 1
     1699             p-shift-num  = 1
     1700           .
     1701         end.
     1702       end.
     1703       run factord in this-procedure
     1704         (input  p-fact-date
     1705         ,input  1
     1706         ,input  1
     1707         ,input  p-shift-date
     1708         ,input  p-shift-num
     1709         ,input  p-shift-on
     1710         ,output v-fact-order
     1711         ,output p-shift-end-fact-order
     1712         ,output p-day-end-fact-order
     1713         ) no-error .
     1714       if error-status :error
     1715       then do:
     1716         message
     1717           vss-workfile vss-revision vss-description skip
     1718           "Ошибка при вызове процедуры factord"
     1719           error-status :get-message(1) skip
     1720           return-value skip
     1721           view-as alert-box error .
     1722         undo, return error return-value .
     1723       end.
     1724     end.
     1725   end procedure.
     1726   procedure factord-lock-shift :
     1727     define input  parameter p-obj-type  as character no-undo .
     1728     define input  parameter p-obj-code  as integer   no-undo .
     1729     define input  parameter p-fact-date as date      no-undo .
     1730     define parameter buffer buf_shift-obj for ub.shift-obj .
     1731     define variable v-shift-on      as logical   no-undo .
     1732     define variable v-extra-message as character no-undo .
     1733     define variable v-error as character no-undo .
     1734     do
     1735     on error undo, return error return-value
     1736     :
     1737   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1739     (input  p-obj-type
     1740     ,input  p-obj-code
     1741     ,input  'shift-on=request'
     1742     ,output v-shift-on
     1743     ) no-error .
     1744       if error-status :error
     1745       then do:
     1746         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1747         undo, return error v-error .
     1748       end.
     1749       if v-shift-on = true
     1750       then do:
     1751         find first buf_shift-obj share-lock
     1752           where buf_shift-obj.obj-type   = p-obj-type
     1753             and buf_shift-obj.obj-code   = p-obj-code
     1754             and buf_shift-obj.shift-date > p-fact-date
     1755           use-index pi
     1756           no-error .
     1757         if not available buf_shift-obj
     1758         or buf_shift-obj.status_ <> 'зкр':U
     1759         then do:
     1760           find last buf_shift-obj
     1761             where buf_shift-obj.obj-type = p-obj-type
     1762               and buf_shift-obj.obj-code = p-obj-code
     1763               and buf_shift-obj.status_  = 'зкр':U
     1764             use-index stts
     1765             no-error .
     1766           if available buf_shift-obj
     1767           then do:
     1768             assign
     1769               v-extra-message =
     1770                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1771                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1772                               )
     1773             .
     1774           end.
     1775           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1776           undo, return error v-error .
     1777         end.
     1778       end.
     1779     end.
     1780   end procedure.
     1781   procedure factord-end-day :
     1782     define input  parameter p-fact-date            as date    no-undo .
     1783     define output parameter p-day-end-fact-order   as decimal no-undo .
     1784     do
     1785     on error undo, return error return-value
     1786     :
     1787       if p-fact-date = ?
     1788       then do:
     1789         return error "Не указана фактическая дата" .
     1790       end.
     1791       assign
     1792         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1793       .
     1794     end.
     1795   end procedure.
     1796   procedure factord-to-date :
     1797     define input  parameter p-fact-order as decimal no-undo .
     1798     define output parameter p-fact-date  as date    no-undo .
     1799     define variable v-ref-date  as date      no-undo .
     1800     define variable v-ref-delta as integer   no-undo .
     1801     do
     1802     on error undo, return error return-value
     1803     :
     1804       if p-fact-order = ?
     1805       or p-fact-order = 0
     1806       then do:
     1807         return error "Не указан fact-order" .
     1808       end.
     1809       assign
     1810         v-ref-date  = date(1, 1, 2000)
     1811       .
     1812       assign
     1813         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1814       .
     1815       assign
     1816         p-fact-date = v-ref-date + v-ref-delta
     1817       .
     1818     end.
     1819   end procedure.
     1820   procedure factord-to-fact-num :
     1821     define input  parameter p-fact-order as decimal no-undo .
     1822     define output parameter p-fact-num   as integer no-undo .
     1823     define variable v-fact-order-trunc as decimal no-undo .
     1824     do
     1825     on error undo, return error return-value
     1826     :
     1827       if p-fact-order = ?
     1828       or p-fact-order = 0
     1829       then do:
     1830         return error "Не указан fact-order" .
     1831       end.
     1832       assign
     1833        v-fact-order-trunc = truncate(p-fact-order, 2)
     1834       .
     1835       assign
     1836         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1837       .
     1838     end.
     1839   end procedure.
     1840   procedure factord-to-shift-num :
     1841     define input  parameter p-fact-order as decimal no-undo .
     1842     define output parameter p-shift-num   as integer no-undo .
     1843     define variable  p-shift-numd  as decimal   no-undo .
     1844     define variable v-fact-order-trunc as decimal no-undo .
     1845     do
     1846     on error undo, return error return-value
     1847     :
     1848       if p-fact-order = ?
     1849       or p-fact-order = 0
     1850       then do:
     1851         return error "Не указан fact-order" .
     1852       end.
     1853       assign
     1854        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1855       .
     1856       if v-fact-order-trunc < 0.5 then do:
     1857         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1858       end.
     1859       assign
     1860         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1861         .
     1862        assign
     1863         p-shift-num = truncate (p-shift-numd , 0)
     1864       .
     1865     end.
     1866   end procedure.
