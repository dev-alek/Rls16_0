     1384     define variable v-cntxp-db-num          as integer   no-undo .
     1385     define variable v-cntxp-userid          as character no-undo .
     1386     define variable v-cntxp-level           as character no-undo .
     1387     define variable v-cntxp-db-num-obj      as integer   no-undo .
