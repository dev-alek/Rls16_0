        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: allcheck.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/allcheck.p $":U .
        8   define variable vss-description as character no-undo init "Проверка целостности всех товаров".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define  temp-table temp-host no-undo
       71     field host-code like ub.store.host-code
       72     index xpk host-code
       73   .
       74   define  temp-table temp-obj no-undo
       75     field obj-type  like ub.clients.obj-type
       76     field obj-code  like ub.clients.obj-code
       77     field host-code like ub.store.host-code
       78     field db-num    like ub.clients.db-num
       79     index xpk  obj-type obj-code
       80     index xie1 host-code
       81     index xie2 db-num host-code
       82   .
       83   procedure init-temphost:
       84     define buffer buf_store   for ub.store .
       85     define buffer buf_shop    for ub.shop .
       86     define buffer buf_clients for ub.clients .
       87     define buffer buf_db for ub.db .
       88     define buffer buf_temp-host for temp-host .
       89     define buffer buf_temp-obj for temp-obj .
       90     do
       91     on error undo, return error return-value
       92     :
       93       for each buf_store
       94       on error undo, return error
       95       :
       96         find first buf_temp-host
       97           where buf_temp-host.host-code = buf_store.host-code
       98           no-error .
       99         if not available buf_temp-host
      100         then do:
      101           create buf_temp-host .
      102           assign
      103             buf_temp-host.host-code = buf_store.host-code
      104           .
      105         end.
      106         find first buf_clients no-lock
      107           where buf_clients.obj-type = 'скл':U
      108             and buf_clients.obj-code = buf_store.obj-code
      109           no-error .
      110         if not available buf_clients
      111         then do:
      112           message
      113             "Ошибка при поиске клиента" skip
      114             "Клиент" 'скл':U buf_store.obj-code skip
      115             view-as alert-box error .
      116           undo, return error .
      117         end.
      118         create buf_temp-obj .
      119         assign
      120           buf_temp-obj.obj-type  = 'скл':U
      121           buf_temp-obj.obj-code  = buf_store.obj-code
      122           buf_temp-obj.host-code = buf_store.host-code
      123           buf_temp-obj.db-num    = buf_clients.db-num
      124         .
      125       end.
      126       for each buf_shop
      127       on error undo, return error
      128       :
      129         find first buf_temp-host
      130           where buf_temp-host.host-code = buf_shop.host-code
      131           no-error .
      132         if not available buf_temp-host
      133         then do:
      134           create buf_temp-host .
      135           assign
      136             buf_temp-host.host-code = buf_shop.host-code
      137           .
      138         end.
      139         find first buf_clients no-lock
      140           where buf_clients.obj-type = 'маг':U
      141             and buf_clients.obj-code = buf_shop.obj-code
      142           no-error .
      143         if not available buf_clients then do:
      144           message
      145             "Ошибка при поиске клиента" skip
      146             "Клиент" 'маг':U buf_shop.obj-code skip
      147             view-as alert-box error .
      148           undo, return error .
      149         end.
      150         create buf_temp-obj .
      151         assign
      152           buf_temp-obj.obj-type  = 'маг':U
      153           buf_temp-obj.obj-code  = buf_shop.obj-code
      154           buf_temp-obj.host-code = buf_shop.host-code
      155           buf_temp-obj.db-num    = buf_clients.db-num
      156         .
      157       end.
      158     end.
      159   end.
      160   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161     define variable v-cntxt-db-num        as integer   no-undo .
      162     define variable v-cntxt-userid        as character no-undo .
      163     define variable v-cntxt-level         as character no-undo .
      164     define variable v-cntxt-host-code-obj as integer   no-undo .
      165     define variable v-cntxt-obj-type      as character no-undo .
      166     define variable v-cntxt-obj-code      as integer   no-undo .
      167     define variable v-cntxt-db-num-obj    as integer   no-undo .
      168     define variable v-cntxt-is-admin      as logical   no-undo .
      169   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   define temp-table userobjs_temp-user-obj no-undo
      171     field obj-type as character
      172     field obj-code as integer
      173     index xpk is primary unique obj-type obj-code
      174     .
      175   procedure userobjs_clear :
      176     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      177     do
      178     on error undo, return error return-value
      179     :
      180       for each buf_userobjs_temp-user-obj
      181       on error undo, return error return-value
      182       :
      183         delete buf_userobjs_temp-user-obj .
      184       end.
      185     end.
      186   end .
      187   procedure userobjs_object-count :
      188     define output parameter p-total-count as integer   no-undo .
      189     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      190     do
      191     on error undo, return error return-value
      192     :
      193       assign
      194         p-total-count = 0
      195       .
      196       for each buf_userobjs_temp-user-obj
      197       on error undo, return error return-value
      198       :
      199         assign
      200           p-total-count = p-total-count + 1
      201         .
      202       end.
      203     end.
      204   end.
      205   procedure userobjs_append :
      206      define input  parameter p-obj-type as character no-undo .
      207      define input  parameter p-obj-code as integer   no-undo .
      208     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      209     do
      210     on error undo, return error return-value
      211     :
      212       find first buf_userobjs_temp-user-obj
      213         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      214           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      215         no-error .
      216       if not available buf_userobjs_temp-user-obj
      217       then do:
      218         create buf_userobjs_temp-user-obj .
      219         assign
      220           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      221           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      222         .
      223       end.
      224     end.
      225   end.
      226   procedure userobjs_object-exist :
      227     define output parameter p-object-exist as logical   no-undo .
      228     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      229     do
      230     on error undo, return error return-value
      231     :
      232       find first buf_userobjs_temp-user-obj
      233         no-error .
      234       if not available buf_userobjs_temp-user-obj
      235       then do:
      236         assign
      237           p-object-exist = false
      238         .
      239       end.
      240       else do:
      241         assign
      242           p-object-exist = true
      243         .
      244       end.
      245     end.
      246   end.
      247   procedure userobjs_transfer :
      248     define input  parameter p-callback-handle as handle no-undo .
      249     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      250     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      251     do
      252     on error undo, return error return-value
      253     :
      254       if valid-handle(p-callback-handle) <> true
      255       then do:
      256         message
      257           vss-workfile vss-revision vss-description skip
      258           "Ошибка задания входных параметров" skip
      259           "Неизвестный указатель на процедуру" skip
      260           view-as alert-box error .
      261         undo, return error return-value .
      262       end.
      263       if p-callback-handle :get-signature("userobjs_append") = ""
      264       then do:
      265         message
      266           vss-workfile vss-revision vss-description skip
      267           "Ошибка задания входных параметров" skip
      268           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      269                     ,p-callback-handle :file-name
      270                     ) skip
      271           view-as alert-box error .
      272         undo, return error return-value .
      273       end.
      274       for each buf_userobjs_temp-user-obj
      275       on error undo, return error return-value
      276       :
      277         run userobjs_append in p-callback-handle
      278           (input  buf_userobjs_temp-user-obj.obj-type
      279           ,input  buf_userobjs_temp-user-obj.obj-code
      280           ) .
      281       end.
      282     end.
      283   end procedure.
      284   procedure userobjs_select-one :
      285      define input  parameter parparentproc     as widget-handle no-undo .
      286      define input  parameter p-db-num          as integer   no-undo .
      287      define input  parameter p-user-id         as character no-undo .
      288      define input  parameter p-host-code-obj   as integer   no-undo .
      289      define input  parameter p-obj-type        as character no-undo .
      290      define input  parameter p-obj-code        as integer   no-undo .
      291      define output parameter p-user-select     as logical   no-undo .
      292      define output parameter p-select-obj-type as character no-undo .
      293      define output parameter p-select-obj-code as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       run gbl/userobjs.w
      298         (input  parparentproc
      299         ,input  this-procedure :handle
      300         ,input  p-db-num
      301         ,input  p-user-id
      302         ,input  p-host-code-obj
      303         ,input  p-obj-type
      304         ,input  p-obj-code
      305         ,INPUT  "b-sel"
      306         ,output p-user-select
      307         ,output p-select-obj-type
      308         ,output p-select-obj-code
      309         ) .
      310     end.
      311   end.
      312   procedure userobjs_select-many :
      313     define input  parameter parparentproc   as widget-handle no-undo .
      314     define input  parameter p-db-num        as integer   no-undo .
      315     define input  parameter p-user-id       as character no-undo .
      316     define input  parameter p-host-code-obj as integer   no-undo .
      317     define input  parameter p-obj-type      as character no-undo .
      318     define input  parameter p-obj-code      as integer   no-undo .
      319     define output parameter p-user-select   as logical   no-undo .
      320     define variable v-select-obj-type as character no-undo .
      321     define variable v-select-obj-code as integer   no-undo .
      322     do
      323     on error undo, return error return-value
      324     :
      325       run gbl/userobjs.w
      326         (input  parparentproc
      327         ,input  this-procedure :handle
      328         ,input  p-db-num
      329         ,input  p-user-id
      330         ,input  p-host-code-obj
      331         ,input  p-obj-type
      332         ,input  p-obj-code
      333         ,INPUT  "b-sel,b-mark"
      334         ,output p-user-select
      335         ,output v-select-obj-type
      336         ,output v-select-obj-code
      337         ) .
      338     end.
      339   end.
      340   procedure thobjs :
      341      define input        parameter parparentproc     as widget-handle no-undo .
      342      define input        parameter i-bttns           as character     no-undo .
      343      define input        parameter i-list-mode       as character     no-undo.
      344      define input        parameter i-obj-type        as character     no-undo.
      345      define input        parameter i-db-num          as integer       no-undo.
      346      define input        parameter i-host-code       as integer       no-undo.
      347      define input-output parameter p-rid-list        as character     no-undo .
      348   run ref/thobjs.p
      349           ( input parparentproc
      350            ,input  this-procedure :handle
      351           , input i-bttns
      352           , input i-list-mode
      353           , input i-obj-type
      354           , input i-db-num
      355           , input i-host-code
      356           , input-output p-rid-list ) no-error .
      357   end.
      358   define variable v-total-err as integer   no-undo .
      359   define variable v-curr-err  as integer   no-undo .
      360   run init-temphost .
      361   define variable lok as logical no-undo init false .
      362   message
      363     "Проверить целостность товаров." skip
      364     "Да - все объекты" skip
      365     "Нет - выбрать объекты" skip
      366     "Результат проверки записывается в файлы" skip
      367     "gdscheck.txt, gdscheck.lst, objcheck.txt" skip
      368     view-as alert-box question buttons yes-no-cancel update lok
      369     .
      370   if lok = ? then do:
      371     return .
      372   end.
      373   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374     run mainmenu_getcntxt in parparentproc
      375       (output v-cntxt-db-num
      376       ,output v-cntxt-userid
      377       ,output v-cntxt-level
      378       ,output v-cntxt-host-code-obj
      379       ,output v-cntxt-obj-type
      380       ,output v-cntxt-obj-code
      381       ,output v-cntxt-db-num-obj
      382       ,output v-cntxt-is-admin
      383       ) .
      384   if lok = true then do:
      385     for each temp-obj
      386     :
      387       run utl/objcheck.p
      388         (input temp-obj.obj-type
      389         ,input temp-obj.obj-code
      390         ).
      391       assign
      392         v-curr-err = integer(return-value) no-error
      393       .
      394       if v-curr-err <> ?
      395       then do:
      396         assign
      397           v-total-err = v-total-err + v-curr-err
      398         .
      399       end.
      400     end.
      401   end.
      402   if lok = false then do:
      403     define variable v-user-select as logical   no-undo .
      404   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   run userobjs_select-many in this-procedure
      406     (input  parparentproc
      407     ,input  v-cntxt-db-num
      408     ,input  v-cntxt-userid
      409     ,input  v-cntxt-host-code-obj
      410     ,input  v-cntxt-obj-type
      411     ,input  v-cntxt-obj-code
      412     ,output v-user-select
      413     )  .
      414     if v-user-select <> true
      415     then do:
      416       message
      417         "Объект не выбран"
      418         view-as alert-box information .
      419       return .
      420     end.
      421     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      422     for each buf_userobjs_temp-user-obj
      423     on error undo, return error return-value
      424     :
      425       run utl/objcheck.p
      426         (input buf_userobjs_temp-user-obj.obj-type
      427         ,input buf_userobjs_temp-user-obj.obj-code
      428         ) .
      429       assign
      430         v-curr-err = integer(return-value) no-error
      431       .
      432       if v-curr-err <> ?
      433       then do:
      434         assign
      435           v-total-err = v-total-err + v-curr-err
      436         .
      437       end.
      438     end.
      439   end.
      440   return string(v-total-err) .
