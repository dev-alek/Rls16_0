        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date: $":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Повторная выгрузка данных для 1С ERP".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define   shared variable g#auto as logical no-undo.
       68   define   shared variable g#news as logical no-undo.
       69   define   shared variable g#oxml as logical no-undo.
       70   define   shared variable g#esys as logical no-undo.
       71   define   shared variable g#news-source-db as integer no-undo.
       72   define   shared variable g#esys-source-esys as integer no-undo.
       73   define   shared variable g#db-num as integer   no-undo .
       74   define   shared variable g#userid as character no-undo .
       75   define   shared variable g#passwd as character no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122     define variable v-cntxt-db-num        as integer   no-undo .
      123     define variable v-cntxt-userid        as character no-undo .
      124     define variable v-cntxt-level         as character no-undo .
      125     define variable v-cntxt-host-code-obj as integer   no-undo .
      126     define variable v-cntxt-obj-type      as character no-undo .
      127     define variable v-cntxt-obj-code      as integer   no-undo .
      128     define variable v-cntxt-db-num-obj    as integer   no-undo .
      129     define variable v-cntxt-is-admin      as logical   no-undo .
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define temp-table userobjs_temp-user-obj no-undo
      132     field obj-type as character
      133     field obj-code as integer
      134     index xpk is primary unique obj-type obj-code
      135     .
      136   procedure userobjs_clear :
      137     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      138     do
      139     on error undo, return error return-value
      140     :
      141       for each buf_userobjs_temp-user-obj
      142       on error undo, return error return-value
      143       :
      144         delete buf_userobjs_temp-user-obj .
      145       end.
      146     end.
      147   end .
      148   procedure userobjs_object-count :
      149     define output parameter p-total-count as integer   no-undo .
      150     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      151     do
      152     on error undo, return error return-value
      153     :
      154       assign
      155         p-total-count = 0
      156       .
      157       for each buf_userobjs_temp-user-obj
      158       on error undo, return error return-value
      159       :
      160         assign
      161           p-total-count = p-total-count + 1
      162         .
      163       end.
      164     end.
      165   end.
      166   procedure userobjs_append :
      167      define input  parameter p-obj-type as character no-undo .
      168      define input  parameter p-obj-code as integer   no-undo .
      169     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      170     do
      171     on error undo, return error return-value
      172     :
      173       find first buf_userobjs_temp-user-obj
      174         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      175           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      176         no-error .
      177       if not available buf_userobjs_temp-user-obj
      178       then do:
      179         create buf_userobjs_temp-user-obj .
      180         assign
      181           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      182           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      183         .
      184       end.
      185     end.
      186   end.
      187   procedure userobjs_object-exist :
      188     define output parameter p-object-exist as logical   no-undo .
      189     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      190     do
      191     on error undo, return error return-value
      192     :
      193       find first buf_userobjs_temp-user-obj
      194         no-error .
      195       if not available buf_userobjs_temp-user-obj
      196       then do:
      197         assign
      198           p-object-exist = false
      199         .
      200       end.
      201       else do:
      202         assign
      203           p-object-exist = true
      204         .
      205       end.
      206     end.
      207   end.
      208   procedure userobjs_transfer :
      209     define input  parameter p-callback-handle as handle no-undo .
      210     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      211     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      212     do
      213     on error undo, return error return-value
      214     :
      215       if valid-handle(p-callback-handle) <> true
      216       then do:
      217         message
      218           vss-workfile vss-revision vss-description skip
      219           "Ошибка задания входных параметров" skip
      220           "Неизвестный указатель на процедуру" skip
      221           view-as alert-box error .
      222         undo, return error return-value .
      223       end.
      224       if p-callback-handle :get-signature("userobjs_append") = ""
      225       then do:
      226         message
      227           vss-workfile vss-revision vss-description skip
      228           "Ошибка задания входных параметров" skip
      229           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      230                     ,p-callback-handle :file-name
      231                     ) skip
      232           view-as alert-box error .
      233         undo, return error return-value .
      234       end.
      235       for each buf_userobjs_temp-user-obj
      236       on error undo, return error return-value
      237       :
      238         run userobjs_append in p-callback-handle
      239           (input  buf_userobjs_temp-user-obj.obj-type
      240           ,input  buf_userobjs_temp-user-obj.obj-code
      241           ) .
      242       end.
      243     end.
      244   end procedure.
      245   procedure userobjs_select-one :
      246      define input  parameter parparentproc     as widget-handle no-undo .
      247      define input  parameter p-db-num          as integer   no-undo .
      248      define input  parameter p-user-id         as character no-undo .
      249      define input  parameter p-host-code-obj   as integer   no-undo .
      250      define input  parameter p-obj-type        as character no-undo .
      251      define input  parameter p-obj-code        as integer   no-undo .
      252      define output parameter p-user-select     as logical   no-undo .
      253      define output parameter p-select-obj-type as character no-undo .
      254      define output parameter p-select-obj-code as character no-undo .
      255     do
      256     on error undo, return error return-value
      257     :
      258       run gbl/userobjs.w
      259         (input  parparentproc
      260         ,input  this-procedure :handle
      261         ,input  p-db-num
      262         ,input  p-user-id
      263         ,input  p-host-code-obj
      264         ,input  p-obj-type
      265         ,input  p-obj-code
      266         ,INPUT  "b-sel"
      267         ,output p-user-select
      268         ,output p-select-obj-type
      269         ,output p-select-obj-code
      270         ) .
      271     end.
      272   end.
      273   procedure userobjs_select-many :
      274     define input  parameter parparentproc   as widget-handle no-undo .
      275     define input  parameter p-db-num        as integer   no-undo .
      276     define input  parameter p-user-id       as character no-undo .
      277     define input  parameter p-host-code-obj as integer   no-undo .
      278     define input  parameter p-obj-type      as character no-undo .
      279     define input  parameter p-obj-code      as integer   no-undo .
      280     define output parameter p-user-select   as logical   no-undo .
      281     define variable v-select-obj-type as character no-undo .
      282     define variable v-select-obj-code as integer   no-undo .
      283     do
      284     on error undo, return error return-value
      285     :
      286       run gbl/userobjs.w
      287         (input  parparentproc
