        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define new global shared variable g#library  as handle no-undo .
        8   define new global shared variable g#library2 as handle no-undo .
        9   define   shared variable g#auto as logical no-undo.
       10   define   shared variable g#news as logical no-undo.
       11   define   shared variable g#oxml as logical no-undo.
       12   define   shared variable g#esys as logical no-undo.
       13   define   shared variable g#news-source-db as integer no-undo.
       14   define   shared variable g#esys-source-esys as integer no-undo.
       15   define   shared variable g#db-num as integer   no-undo .
       16   define   shared variable g#userid as character no-undo .
       17   define   shared variable g#passwd as character no-undo .
       18   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       19     define variable v-cntxt-db-num        as integer   no-undo .
       20     define variable v-cntxt-userid        as character no-undo .
       21     define variable v-cntxt-level         as character no-undo .
       22     define variable v-cntxt-host-code-obj as integer   no-undo .
       23     define variable v-cntxt-obj-type      as character no-undo .
       24     define variable v-cntxt-obj-code      as integer   no-undo .
       25     define variable v-cntxt-db-num-obj    as integer   no-undo .
       26     define variable v-cntxt-is-admin      as logical   no-undo .
       27   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       28   define new shared temp-table gds-list no-undo like ub.goods
       29     field qnty   as decimal
       30     field to-del as logical
       31     field order-num as integer
       32     field to-sel as logical
       33     field promo-code as character
       34     field ActionId  as int64
       35     field db-num as integer
       36     index art  is primary unique artic prod-type prod-code
       37     index code is         unique gds-code
       38     index oi order-num
       39     index isel to-sel
       40     .
       41   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       42   define  new shared  temp-table gds-list-hist no-undo
       43   field list-table as character
       44   field id as integer
       45   field line as integer
       46   field hist-mode as character
       47   field des as character
       48   field num-recs as integer
       49   field option_ as character
       50   field item_ as character
       51   field status_ as character
       52   field num-add as integer
       53   field num-ignored as integer
       54   field done as logical
       55   field err_ as logical
       56   field err-mes as character
       57   index pi is primary
       58   id
       59   line
       60   index isdone
       61   done
       62   .
       63   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64   define variable v-waitfram-action01         as character   no-undo .
       65   define variable v-waitfram-action02         as character   no-undo .
       66   define variable v-waitfram-action03         as character   no-undo .
       67   define variable mWaitFramTextBeg            as character   no-undo.
       68   define variable mWaitFramTextEnd            as character   no-undo.
       69   define variable mWaitFramView               as logical     no-undo.
       70   define variable mWaitProcEvent              as logical     no-undo init yes.
       71   define variable mWaitFramInterval           as integer     no-undo init 1 .
       72   define variable mWaitFramStop               as logical     no-undo.
       73   define variable mWaitFramStopUser           as logical     no-undo.
       74   define variable mWaitFramStopTimeOut        as logical     no-undo.
       75   define variable mWaitFramStartProc          as datetime-tz no-undo.
       76   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       77   define button B-WaitFramStop auto-end-key
       78        label "Стоп"
       79        size 10 by 1 tooltip "Остоновить процесс".
       80   define button B-viewProcInfo
       81        label "Информация"
       82        size 15 by 1 tooltip "Информация о процесс".
       83   define frame waitfram
       84     v-waitfram-action01 format "x(72)" no-label skip
       85     v-waitfram-action02 format "x(72)" no-label skip
       86     v-waitfram-action03 format "x(72)" no-label skip
       87     B-viewProcInfo
       88     B-WaitFramStop at row 4 col 30
       89     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       90     .
       91   define new global shared variable mBatchMode as logical no-undo init ?.
       92   define variable mFramBachModHandle as handle no-undo.
       93   mFramBachModHandle = frame waitfram:handle.
       94   define variable mFameOldVis as logical no-undo.
       95   define variable mVisCUrentVin as logical no-undo.
       96   if session:batch-mode
       97   then
       98      mBatchMode = yes.
       99   if mBatchMode = ? then do:
      100     mVisCUrentVin = current-window:visible.
      101     mFameOldVis = mFramBachModHandle:visible.
      102     mFramBachModHandle:visible  = yes.
      103     mBatchMode = mFramBachModHandle:visible ne yes.
      104     mFramBachModHandle:visible = mFameOldVis.
      105     current-window:visible = mVisCUrentVin.
      106   end.
      107    if  log-manager:logfile-name ne ?
      108     then DO:
      109         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      110         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      111         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      112     end.
      113   on choose of B-WaitFramStop in frame waitfram
      114   do:
      115     mWaitFramStop = yes.
      116     mWaitFramStopUser = yes.
      117   end.
      118   function waitfram-check-timeout returns logical():
      119      define variable vtime as int64 no-undo.
      120      if mWaitFramStopTimeOut
      121      then
      122         return yes.
      123      vtime = ( now - mWaitFramStartProc ) / 1000 .
      124      if     mWaitFramTimeOut ne ?
      125         and mWaitFramTimeOut ne 0
      126         and mWaitFramTimeOut lt vtime
      127      then do:
      128         mWaitFramStopTimeOut = yes.
      129      end.
      130      return mWaitFramStopTimeOut.
      131   end.
      132   procedure waitfram-hide :
      133     if not session:batch-mode
      134     then do
      135     on error undo, return error return-value
      136     :
      137       pause 0 before-hide .
      138       if not mBatchMode then
      139         hide frame waitfram .
      140     if     not mWaitFramView
      141        and mWaitProcEvent
      142     then
      143       process events .
      144     end.
      145   end procedure.
      146   procedure waitfram-show :
      147     define input  parameter p-message as character no-undo .
      148     define variable v-left-margin as integer   no-undo .
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       if length(p-message) <= 70 then do:
      154         assign
      155           v-left-margin = integer((70 - length(p-message)) / 2)
      156         .
      157         assign
      158           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      159         .
      160         assign
      161           v-waitfram-action01 = " "
      162           v-waitfram-action02 = " "
      163                                    + fill(" ", v-left-margin)
      164                                    + p-message
      165           v-waitfram-action03 = " "
      166         .
      167       end.
      168       else do:
      169         define variable vRindex1 as integer no-undo.
      170         define variable vRindex2 as integer no-undo.
      171         vRindex1 = r-index(p-message," ",70).
      172         if vRindex1 = 0
      173         then
      174            vRindex1 = 70.
      175         if length(p-message)  <= vRindex1 + 70 then do:
      176           assign
      177             v-waitfram-action01 = " "
      178             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      179             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      180           .
      181         end.
      182         else do:
      183           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      184           if vRindex2 <= vRindex1
      185           then
      186              vRindex2 = vRindex1 + 70.
      187           assign
      188             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      189             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      191           .
      192         end.
      193       end.
      194       B-viewProcInfo:visible   in frame waitfram = no.
      195       B-viewProcInfo:sensitive in frame waitfram = no.
      196       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       if  (   mWaitFramView
      199          or  mWaitProcEvent)
      200          and not mBatchMode
      201       then
      202          display
      203             v-waitfram-action01 skip
      204             v-waitfram-action02 skip
      205             v-waitfram-action03 skip
      206          with frame waitfram .
      207       if     mWaitFramView
      208          then do:
      209             if     mWaitFramInterval ne ?
      210                and not mBatchMode
      211             then
      212                wait-for go of frame waitfram pause mWaitFramInterval.
      213          end.
      214          else
      215             if     mWaitProcEvent
      216                and not mBatchMode
      217             then
      218                process events .
      219     end.
      220   end procedure.
      221      procedure waitfram-show-this:
      222         define input  parameter iInterval as int64 no-undo.
      223         define variable vtime as int64 no-undo.
      224         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      225         mWaitFramInterval = iInterval.
      226         run waitfram-show (substitute("&1&2 &3&4" ,
      227                                       mWaitFramTextBeg ,
      228                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      229                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      230                                       mWaitFramTextEnd
      231                                      )
      232                           ).
      233      end.
      234      procedure WaitFramRunPause:
      235         define input  parameter iInterval as dec no-undo.
      236         define variable vStart  as datetime-tz no-undo.
      237         define variable vend    as datetime-tz no-undo.
      238         define variable vint as int64 no-undo.
      239         define variable vOk as logical no-undo.
      240         vStart = now.
      241         vend   = vStart.
      242         publish "WaitFramPause" (iInterval,output vOk).
      243         vend   =  now.
      244         vint = vend - vStart.
      245         vint = iInterval - vint / 1000.
      246         if     not mWaitFramStop
      247            and (   vint > 0
      248                 or (    not vOk
      249                     and iInterval eq ?
      250                     )
      251                 )
      252         then
      253            run waitfram-show-this (iInterval).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and vint > 0
      259         then do:
      260            run gbl/pause.p (vint * 1000).
      261         end.
      262         if iInterval ne ?
      263         then
      264            publish "WaitFramStop".
      265         waitfram-check-timeout().
      266      end.
      267      procedure WaitFramWaitFor:
      268         define input  parameter iInterval as dec no-undo.
      269         assign
      270            mWaitFramStartProc   = now
      271            mWaitFramStopUser    = no
      272            mWaitFramStopTimeOut = no
      273         .
      274         block-wait:
      275         do while not mWaitFramStop:
      276            run WaitFramRunPause (iInterval).
      277            if  waitfram-check-timeout()
      278            then do:
      279               leave block-wait.
      280            end.
      281         end.
      282         run waitfram-hide.
      283      end.
      284   procedure waitfram-join :
      285     define input  parameter p-line-1  as character no-undo .
      286     define input  parameter p-line-2  as character no-undo .
      287     define input  parameter p-line-3  as character no-undo .
      288     define output parameter p-message as character no-undo .
      289     do
      290     on error undo, return error return-value
      291     :
      292       assign
      293         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      294                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      296       .
      297     end.
      298   end procedure.
      299   function waitfram-join-function returns character
      300     (input p-line-1 as character
      301     ,input p-line-2 as character
      302     ,input p-line-3 as character
      303     ).
      304     define variable v-message as character no-undo .
      305     run waitfram-join in this-procedure
      306       (input  p-line-1
      307       ,input  p-line-2
      308       ,input  p-line-3
      309       ,output v-message
      310       ) .
      311     return v-message .
      312   end function .
      313   define variable list-main as log no-undo.
      314   define variable glog as logical no-undo .
      315   define variable lns-cnt as integer no-undo .
      316   define variable line-rec as recid no-undo .
      317   define buffer buf-bar-code for ub.bar-code.
      318   list-main = yes.
      319   message
      320   "Поиск пересечений основных и включенных дополнительных бар-кодов других товаров." skip
      321   "Внимание! Работа утилиты кассы не затрагивает!" skip (2)
      322   "YES - помещать в список товары с доп. БК," skip
      323   "NO - с основными," skip
      324   "Cancel - отказ." skip (2)
      325   "Продолжать ?"
      326   view-as alert-box question buttons YES-NO-Cancel update list-main.
      327   if list-main = ? then
      328     return.
      329   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330     run mainmenu_getcntxt in parparentproc
      331       (output v-cntxt-db-num
      332       ,output v-cntxt-userid
      333       ,output v-cntxt-level
      334       ,output v-cntxt-host-code-obj
      335       ,output v-cntxt-obj-type
      336       ,output v-cntxt-obj-code
      337       ,output v-cntxt-db-num-obj
      338       ,output v-cntxt-is-admin
      339       ) .
      340   glog = ?.
      341   if g#db-num = 0 then
      342     message
      343       "Удалять найденные доп. БК ?" skip (2)
      344       "YES - удалять" skip
      345       "NO - выключать" skip
      346       "Cancel - ничего не менять, просто формировать список"
      347       view-as alert-box question buttons YES-NO-Cancel update glog.
      348   run waitfram-show in this-procedure ("Поиск совпадений основных и Доп.БК. ЖДИТЕ...").
      349   lns-cnt = 0.
      350   for each ub.bar-code no-lock :
      351     find first ub.prod-bc where
      352                ub.prod-bc.b-str = string (ub.bar-code.b-code) and
      353                ub.prod-bc.bc-on = yes no-error.
      354     if available ub.prod-bc then do:
      355       if list-main then do:
      356         find buf-bar-code no-lock where
      357              buf-bar-code.b-code = ub.prod-bc.b-code.
      358         find ub.goods no-lock where
      359              ub.goods.gds-code = buf-bar-code.gds-code.
      360       end.
      361       else
      362         find ub.goods no-lock where
      363              ub.goods.gds-code = ub.bar-code.gds-code.
      364   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   find gds-list
      366     where gds-list.prod-type = goods.prod-type
      367       and gds-list.prod-code = goods.prod-code
      368       and gds-list.artic     = goods.artic
      369     no-error .
      370   if available gds-list then do:
      371     assign
      372       gds-list.to-del = no
      373     .
      374   end.
      375   else do:
      376     define variable v-last5 as integer no-undo .
      377     find last gds-list use-index oi no-error.
      378     if available gds-list then do:
      379       v-last5 = gds-list.order-num .
      380     end.
      381     else do:
      382       v-last5 = 0 .
      383     end.
      384     create gds-list .
      385     buffer-copy goods to gds-list
      386     assign
      387       gds-list.to-del = no
      388       gds-list.order-num = v-last5 + 1
      389     .
      390     assign
      391       lns-cnt = lns-cnt + 1
      392       line-rec = recid (gds-list)
      393     .
      394   end.
      395       run waitfram-show in this-procedure ("Найдено совпадений: " + string (lns-cnt)).
      396       if glog = ? then
      397         next.
      398       if glog then
      399         delete ub.prod-bc.
      400       else
      401         ub.prod-bc.bc-on = no.
      402     end.
      403   end.
      404   run waitfram-hide in this-procedure .
      405   message "Всего совпадений:" (lns-cnt) view-as alert-box.
      406   run str/gds-list.w (parparentproc, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
