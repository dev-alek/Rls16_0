        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type         as character no-undo .
        3   define input  parameter p-obj-code         as integer   no-undo .
        4   define input  parameter p-archive-type     as character no-undo .
        5   define input  parameter p-action-type      as character no-undo .
        6   define input  parameter p-start-check-date as date      no-undo .
        7   define input  parameter p-error-number     as integer   no-undo .
        8   define input  parameter p-status-message   as character no-undo .
        9   define output parameter p-create-chip-num  as integer   no-undo .
       10   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo initial "$Workfile: arhichk.p $":U .
       14   define variable vss-archive     as character no-undo initial "$Archive: utl/arhichk.p $":U .
       15   define variable vss-description as character no-undo initial "Создание истории по сохранению архива".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define buffer buf_archive-history for ub.archive-history .
       86   do
       87   on error undo, return error return-value
       88   :
       89     if p-archive-type = ?
       90     or lookup(p-archive-type
       91              , 'arh':U
       92              + chr(44) + 'ahsp':U
       93              + chr(44) + 'aht':U
       94              + chr(44) + 'prc':U
       95              ) = 0
       96     then do:
       97       message
       98         vss-workfile vss-revision vss-description skip
       99         "Ошибка задания входных параметров" skip
      100         "Неизвестное значение параметра типа архива" skip
      101         "Объект" p-obj-type p-obj-code skip
      102         "Тип архива" p-archive-type skip
      103         "Действие" p-action-type skip
      104         view-as alert-box error .
      105       undo, return error return-value .
      106     end.
      107     if p-action-type = ?
      108     or lookup(p-action-type
      109              ,'check-start':U
      110              + chr(44) + 'check-stop':U
      111              ) = 0
      112     then do:
      113       message
      114         vss-workfile vss-revision vss-description skip
      115         "Ошибка задания входных параметров" skip
      116         "Неизвестное значение параметра действия" skip
      117         "Объект" p-obj-type p-obj-code skip
      118         "Тип архива" p-archive-type skip
      119         "Действие" p-action-type skip
      120         view-as alert-box error .
      121       undo, return error return-value .
      122     end.
      123     define variable v-chip-num as integer   no-undo .
      124     find last buf_archive-history exclusive-lock
      125       where buf_archive-history.obj-type     = p-obj-type
      126         and buf_archive-history.obj-code     = p-obj-code
      127         and buf_archive-history.archive-type = p-archive-type
      128       use-index pi
      129       no-error .
      130     if available buf_archive-history
      131     then do:
      132       assign
      133         v-chip-num = buf_archive-history.chip-num + 1
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-chip-num = 1
      139       .
      140     end.
      141     assign
      142       p-create-chip-num = v-chip-num
      143     .
      144     create buf_archive-history .
      145     assign
      146       buf_archive-history.obj-type     = p-obj-type
      147       buf_archive-history.obj-code     = p-obj-code
      148       buf_archive-history.archive-type = p-archive-type
      149       buf_archive-history.chip-num     = v-chip-num
      150       buf_archive-history.action-type  = p-action-type
      151     .
      152   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
      154     (output buf_archive-history.corr-user-db-num
      155     ,output buf_archive-history.corr-user-name
      156     ,output buf_archive-history.corr-date
      157     ,output buf_archive-history.corr-time-str
      158     ,output buf_archive-history.corr-time
      159     )  .
      160     assign
      161       buf_archive-history.source-date = p-start-check-date
      162       buf_archive-history.PS          = p-status-message
      163     .
      164   end.
