        1   define variable vss-revision    as character no-undo init "$Revision: 6cc672b19ae2, 2597, rls $":U .
        2   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        3   define variable vss-date        as character no-undo init "$Date: Ср сен 23 11:55:30 2020 +0300 $":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile: mkstrglb.p $":U .
        5   define variable vss-archive     as character no-undo init "$Archive: utl/mkstrglb.p $":U .
        6   define variable vss-description as character no-undo init "Создание файла препроцессингов для системы".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       62   define variable v-waitfram-action01         as character   no-undo .
       63   define variable v-waitfram-action02         as character   no-undo .
       64   define variable v-waitfram-action03         as character   no-undo .
       65   define variable mWaitFramTextBeg            as character   no-undo.
       66   define variable mWaitFramTextEnd            as character   no-undo.
       67   define variable mWaitFramView               as logical     no-undo.
       68   define variable mWaitProcEvent              as logical     no-undo init yes.
       69   define variable mWaitFramInterval           as integer     no-undo init 1 .
       70   define variable mWaitFramStop               as logical     no-undo.
       71   define variable mWaitFramStopUser           as logical     no-undo.
       72   define variable mWaitFramStopTimeOut        as logical     no-undo.
       73   define variable mWaitFramStartProc          as datetime-tz no-undo.
       74   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       75   define button B-WaitFramStop auto-end-key
       76        label "Стоп"
       77        size 10 by 1 tooltip "Остоновить процесс".
       78   define button B-viewProcInfo
       79        label "Информация"
       80        size 15 by 1 tooltip "Информация о процесс".
       81   define frame waitfram
       82     v-waitfram-action01 format "x(72)" no-label skip
       83     v-waitfram-action02 format "x(72)" no-label skip
       84     v-waitfram-action03 format "x(72)" no-label skip
       85     B-viewProcInfo
       86     B-WaitFramStop at row 4 col 30
       87     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       88     .
       89   define new global shared variable mBatchMode as logical no-undo init ?.
       90   define variable mFramBachModHandle as handle no-undo.
       91   mFramBachModHandle = frame waitfram:handle.
       92   define variable mFameOldVis as logical no-undo.
       93   define variable mVisCUrentVin as logical no-undo.
       94   if session:batch-mode
       95   then
       96      mBatchMode = yes.
       97   if mBatchMode = ? then do:
       98     mVisCUrentVin = current-window:visible.
       99     mFameOldVis = mFramBachModHandle:visible.
      100     mFramBachModHandle:visible  = yes.
      101     mBatchMode = mFramBachModHandle:visible ne yes.
      102     mFramBachModHandle:visible = mFameOldVis.
      103     current-window:visible = mVisCUrentVin.
      104   end.
      105    if  log-manager:logfile-name ne ?
      106     then DO:
      107         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      108         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      109         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      110     end.
      111   on choose of B-WaitFramStop in frame waitfram
      112   do:
      113     mWaitFramStop = yes.
      114     mWaitFramStopUser = yes.
      115   end.
      116   function waitfram-check-timeout returns logical():
      117      define variable vtime as int64 no-undo.
      118      if mWaitFramStopTimeOut
      119      then
      120         return yes.
      121      vtime = ( now - mWaitFramStartProc ) / 1000 .
      122      if     mWaitFramTimeOut ne ?
      123         and mWaitFramTimeOut ne 0
      124         and mWaitFramTimeOut lt vtime
      125      then do:
      126         mWaitFramStopTimeOut = yes.
      127      end.
      128      return mWaitFramStopTimeOut.
      129   end.
      130   procedure waitfram-hide :
      131     if not session:batch-mode
      132     then do
      133     on error undo, return error return-value
      134     :
      135       pause 0 before-hide .
      136       if not mBatchMode then
      137         hide frame waitfram .
      138     if     not mWaitFramView
      139        and mWaitProcEvent
      140     then
      141       process events .
      142     end.
      143   end procedure.
      144   procedure waitfram-show :
      145     define input  parameter p-message as character no-undo .
      146     define variable v-left-margin as integer   no-undo .
      147     if not session:batch-mode
      148     then do
      149     on error undo, return error return-value
      150     :
      151       if length(p-message) <= 70 then do:
      152         assign
      153           v-left-margin = integer((70 - length(p-message)) / 2)
      154         .
      155         assign
      156           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      157         .
      158         assign
      159           v-waitfram-action01 = " "
      160           v-waitfram-action02 = " "
      161                                    + fill(" ", v-left-margin)
      162                                    + p-message
      163           v-waitfram-action03 = " "
      164         .
      165       end.
      166       else do:
      167         define variable vRindex1 as integer no-undo.
      168         define variable vRindex2 as integer no-undo.
      169         vRindex1 = r-index(p-message," ",70).
      170         if vRindex1 = 0
      171         then
      172            vRindex1 = 70.
      173         if length(p-message)  <= vRindex1 + 70 then do:
      174           assign
      175             v-waitfram-action01 = " "
      176             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      177             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      178           .
      179         end.
      180         else do:
      181           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      182           if vRindex2 <= vRindex1
      183           then
      184              vRindex2 = vRindex1 + 70.
      185           assign
      186             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      189           .
      190         end.
      191       end.
      192       B-viewProcInfo:visible   in frame waitfram = no.
      193       B-viewProcInfo:sensitive in frame waitfram = no.
      194       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      195       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      196       if  (   mWaitFramView
      197          or  mWaitProcEvent)
      198          and not mBatchMode
      199       then
      200          display
      201             v-waitfram-action01 skip
      202             v-waitfram-action02 skip
      203             v-waitfram-action03 skip
      204          with frame waitfram .
      205       if     mWaitFramView
      206          then do:
      207             if     mWaitFramInterval ne ?
      208                and not mBatchMode
      209             then
      210                wait-for go of frame waitfram pause mWaitFramInterval.
      211          end.
      212          else
      213             if     mWaitProcEvent
      214                and not mBatchMode
      215             then
      216                process events .
      217     end.
      218   end procedure.
      219      procedure waitfram-show-this:
      220         define input  parameter iInterval as int64 no-undo.
      221         define variable vtime as int64 no-undo.
      222         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      223         mWaitFramInterval = iInterval.
      224         run waitfram-show (substitute("&1&2 &3&4" ,
      225                                       mWaitFramTextBeg ,
      226                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      227                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      228                                       mWaitFramTextEnd
      229                                      )
      230                           ).
      231      end.
      232      procedure WaitFramRunPause:
      233         define input  parameter iInterval as dec no-undo.
      234         define variable vStart  as datetime-tz no-undo.
      235         define variable vend    as datetime-tz no-undo.
      236         define variable vint as int64 no-undo.
      237         define variable vOk as logical no-undo.
      238         vStart = now.
      239         vend   = vStart.
      240         publish "WaitFramPause" (iInterval,output vOk).
      241         vend   =  now.
      242         vint = vend - vStart.
      243         vint = iInterval - vint / 1000.
      244         if     not mWaitFramStop
      245            and (   vint > 0
      246                 or (    not vOk
      247                     and iInterval eq ?
      248                     )
      249                 )
      250         then
      251            run waitfram-show-this (iInterval).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and vint > 0
      257         then do:
      258            run gbl/pause.p (vint * 1000).
      259         end.
      260         if iInterval ne ?
      261         then
      262            publish "WaitFramStop".
      263         waitfram-check-timeout().
      264      end.
      265      procedure WaitFramWaitFor:
      266         define input  parameter iInterval as dec no-undo.
      267         assign
      268            mWaitFramStartProc   = now
      269            mWaitFramStopUser    = no
      270            mWaitFramStopTimeOut = no
      271         .
      272         block-wait:
      273         do while not mWaitFramStop:
      274            run WaitFramRunPause (iInterval).
      275            if  waitfram-check-timeout()
      276            then do:
      277               leave block-wait.
      278            end.
      279         end.
      280         run waitfram-hide.
      281      end.
      282   procedure waitfram-join :
      283     define input  parameter p-line-1  as character no-undo .
      284     define input  parameter p-line-2  as character no-undo .
      285     define input  parameter p-line-3  as character no-undo .
      286     define output parameter p-message as character no-undo .
      287     do
      288     on error undo, return error return-value
      289     :
      290       assign
      291         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      292                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      293                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      294       .
      295     end.
      296   end procedure.
      297   function waitfram-join-function returns character
      298     (input p-line-1 as character
      299     ,input p-line-2 as character
      300     ,input p-line-3 as character
      301     ).
      302     define variable v-message as character no-undo .
      303     run waitfram-join in this-procedure
      304       (input  p-line-1
      305       ,input  p-line-2
      306       ,input  p-line-3
      307       ,output v-message
      308       ) .
      309     return v-message .
      310   end function .
      311   define variable v-rus-num-lines as integer   no-undo .
      312   define variable v-eng-num-lines as integer   no-undo .
      313   define temp-table temp-definitions no-undo
      314     field temp-name as character
      315     field temp-rus-line as integer
      316     field temp-eng-line as integer
      317     index xpk is primary unique temp-name .
      318   define stream sinp .
      319   define stream sout .
      320   do
      321   on error undo, leave
      322   on stop  undo, leave
      323   :
      324     define variable v-ok as logical   no-undo .
      325     run waitfram-show in this-procedure
      326       (input "Создание файла определений cmp/str-glbl.i"
      327       ) .
      328     define variable mFileStr as character no-undo.
      329     define variable mdir as character no-undo.
      330     define variable vi as integer no-undo.
      331     mFileStr = replace (search ("cmp/str-glbl.p"), "\","/").
      332     do vi = 1 to num-entries(mFileStr,"/") - 2:
      333        mdir = mdir + entry(vi,mFileStr,"/") + "/".
      334     end.
      335     run cmp/str-glbl.p
      336       (input mdir + 'cmp'
      337       ,output v-rus-num-lines
      338       ) 'rus':U .
      339     run waitfram-show in this-procedure
      340       (input "Создание файла определений int/cmp/str-glbl.i"
      341       ) .
      342     run cmp/str-glbl.p
      343       (input mdir + 'int/cmp':U
      344       ,output v-eng-num-lines
      345       ) 'eng':U .
      346     run waitfram-show in this-procedure
      347       (input "Проверка файлов определений cmp/str-glbl.i, int/cmp/str-glbl.i"
      348       ) .
      349     define variable v-line     as character no-undo .
      350     define variable v-line-num as integer   no-undo .
      351     assign
      352       v-line-num = 0
      353     .
      354     input stream sinp from value(search('cmp/str-glbl.i':U)) .
      355     repeat
      356     :
      357       assign
      358         v-line     = '':U
      359         v-line-num = v-line-num + 1
      360       .
      361       import stream sinp unformatted
      362         v-line
      363         .
      364       if v-line begins '&glob'
      365       then do:
      366         find first temp-definitions
      367           where temp-definitions.temp-name = entry(2, v-line, ' ':U)
      368           no-error .
      369         if not available temp-definitions
      370         then do:
      371           create temp-definitions .
      372           assign
      373             temp-definitions.temp-name     = entry(2, v-line, ' ':U)
      374           .
      375         end.
      376         assign
      377           temp-definitions.temp-rus-line = v-line-num
      378         .
      379       end.
      380     end.
      381     input stream sinp close .
      382     v-rus-num-lines = v-line-num.
      383     assign
      384       v-line-num = 0
      385     .
      386     if search("int/cmp/str-glbl.i") ne ?
      387     then do:
      388        input stream sinp from value(search('int/cmp/str-glbl.i':U)) .
      389        repeat
      390        :
      391          assign
      392            v-line     = '':U
      393            v-line-num = v-line-num + 1
      394          .
      395          import stream sinp unformatted
      396            v-line
      397            .
      398          if v-line begins '&glob'
      399          then do:
      400            find first temp-definitions
      401              where temp-definitions.temp-name = entry(2, v-line, ' ':U)
      402              no-error .
      403            if not available temp-definitions
      404            then do:
      405              create temp-definitions .
      406              assign
      407                temp-definitions.temp-name     = entry(2, v-line, ' ':U)
      408              .
      409            end.
      410            assign
      411              temp-definitions.temp-eng-line = v-line-num
      412            .
      413          end.
      414        end.
      415        input stream sinp close .
      416     end.
      417     v-eng-num-lines = v-line-num.
      418     define variable v-clear-file  as logical   no-undo .
      419     define variable v-error-exist as logical   no-undo .
      420     assign
      421       v-clear-file = true
      422     .
      423     for each temp-definitions
      424       where temp-definitions.temp-rus-line = 0
      425          or temp-definitions.temp-eng-line = 0
      426     on error undo, return error return-value
      427     :
      428       assign
      429         v-error-exist = true
      430       .
      431       if v-clear-file = true
      432       then do:
      433         assign
      434           v-clear-file = false
      435         .
      436         output stream sout to value('str-glbl_err.txt':U) .
      437         output stream sout close .
      438       end.
      439       output stream sout to value('str-glbl_err.txt':U) append .
      440       export stream sout temp-definitions .
      441       output stream sout close .
      442     end.
      443     run waitfram-hide in this-procedure .
      444     output to "error.log".
      445     if v-error-exist = true
      446     then do:
      447        put unformatted
      448         "Были обнаружены ошибки при создании файлов" skip
      449         "" skip
      450         "Создание файлов определений str-glbl.i завершено" skip
      451         "Файл" 'cmp/str-glbl.i':U skip
      452         "Строк в файле " v-rus-num-lines skip
      453         "Файл" 'int/cmp/str-glbl.i':U skip
      454         "Строк в файле " v-eng-num-lines skip
      455       .
      456     end.
      457     else do:
      458        put unformatted
      459         "OK" skip
      460         "" skip
      461         "Создание файлов определений str-glbl.i завершено" skip
      462         "Файл" 'cmp/str-glbl.i':U skip
      463         "Строк в файле " v-rus-num-lines skip
      464         "Файл" 'int/cmp/str-glbl.i':U skip
      465         "Строк в файле " v-eng-num-lines skip
      466        .
      467     end.
      468     output close.
      469   end.
