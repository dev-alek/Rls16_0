        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: f866f7c13773, 3215, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        4   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:29 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: upd-gtin.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/upd-gtin.p $":U .
        7   define variable vss-description as character no-undo init "Обновление gtin'а (изначально для табака)".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   PROCEDURE get-db-num :
       79     define output parameter p-db-num as integer no-undo .
       80     do
       81     on error undo, return error return-value
       82     :
       83         run gbl/getdbnum.p (output p-db-num).
       84     end.
       85   END PROCEDURE.
       86   define variable v-cntxa-report-num as integer no-undo .
       87   PROCEDURE get-report-num :
       88     define output parameter p-report-num as integer no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       if v-cntxa-report-num = 0 then do:
       93         run gbl/getrpnum.p (output p-report-num).
       94         v-cntxa-report-num = p-report-num.
       95       end.
       96       else do:
       97         assign
       98         p-report-num = v-cntxa-report-num
       99         .
      100       end.
      101     end.
      102   END PROCEDURE.
      103   PROCEDURE get-userid :
      104   do
      105   on error undo, return error
      106   :
      107   define output parameter p-userid  as character    no-undo.
      108       assign
      109           p-userid = g#userid
      110       .
      111   end.
      112   END PROCEDURE.
      113   PROCEDURE get-version-num :
      114   define output parameter p-curr-version as character no-undo .
      115     do
      116     on error undo, return error return-value
      117     :
      118       run gbl/getvern.p
      119         ( output p-curr-version
      120         ) .
      121     end.
      122   END PROCEDURE.
      123   procedure get-news :
      124   define output parameter p-news as logical no-undo .
      125     do
      126     on error undo, return error
      127     :
      128        p-news = g#news.
      129     end.
      130   end procedure.
      131   procedure get-esys :
      132   define output parameter p-esys as logical no-undo .
      133     do
      134     on error undo, return error
      135     :
      136        p-esys = g#esys.
      137     end.
      138   end procedure.
      139   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   procedure gen-b-code :
      141     define input  parameter type-code like ub.code-range.range-type no-undo .
      142     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      143     do
      144     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      145     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      146     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      147     :
      148       define buffer buf_thbj-attr     for ub.thbj-attr .
      149       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      150       define buffer buf_code-range for ub.code-range .
      151       define variable l-code         as   integer              no-undo .
      152       define variable v-db-num       like ub.db.db-num         no-undo .
      153       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      154       if type-code = 'sslc':U
      155       or type-code = 'ssgb':U
      156       then do:
      157         message
      158           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      159           "Обратитесь к администратору системы."
      160           view-as alert-box error .
      161         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      162       end.
      163       run trg/getpcode.p ( input  type-code
      164                      ,output cfg-param-code
      165                     ).
      166       run get-next-seq( input  type-code,
      167                         output l-code
      168                       ).
      169       find first buf_sys-ctrl no-lock.
      170       if type-code = 'sclc':U
      171       or type-code = 'pglc':U
      172       then do:
      173         assign
      174           v-db-num = 0
      175         .
      176       end.
      177       else do:
      178         assign
      179           v-db-num = buf_sys-ctrl.db-num
      180         .
      181       end.
      182       find first buf_code-range no-lock
      183         where buf_code-range.db-num     = v-db-num
      184           and buf_code-range.range-type = type-code
      185           and buf_code-range.stts       = "a"
      186         use-index stts
      187         no-error .
      188       if available buf_code-range
      189          and l-code <= buf_code-range.last-code
      190          and l-code >= buf_code-range.first-code then do:
      191         assign
      192           p-b-code = l-code
      193         .
      194       end.
      195       else do:
      196         if available buf_code-range
      197            and l-code < buf_code-range.last-code then do:
      198           message
      199             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      200             "Обратитесь к администратору системы."
      201             view-as alert-box error .
      202           undo, return error "sequence":U .
      203         end.
      204         do transaction
      205         on error undo, return error
      206         :
      207           find first buf_thbj-attr exclusive-lock
      208             where buf_thbj-attr.upper-prop-code = 'code-range':U
      209               and buf_thbj-attr.prop-code = cfg-param-code
      210               and buf_thbj-attr.obj-type   = 'БД':U
      211               and buf_thbj-attr.obj-code   = v-db-num
      212             no-error .
      213           if not available buf_thbj-attr then do:
      214             find first buf_thbj-attr exclusive-lock
      215               where buf_thbj-attr.upper-prop-code = 'code-range':U
      216                 and buf_thbj-attr.prop-code = cfg-param-code
      217                 and buf_thbj-attr.obj-type   = ''
      218                 and buf_thbj-attr.obj-code   = 0
      219               no-error .
      220             if not available buf_thbj-attr then do:
      221               if not locked buf_thbj-attr then do:
      222                 message
      223                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      224                   "Обратитесь к администратору системы."
      225                   view-as alert-box error .
      226               end.
      227               undo, return error "config":U .
      228             end.
      229           end.
      230           run get-next-seq( input type-code,
      231                             output l-code
      232                           ).
      233           find first buf_code-range
      234             where buf_code-range.db-num     = v-db-num
      235               and buf_code-range.range-type = type-code
      236               and buf_code-range.stts       = "a"
      237             use-index stts
      238             no-error .
      239           if available buf_code-range
      240           and l-code <= buf_code-range.last-code
      241           and l-code >= buf_code-range.first-code
      242           then do:
      243             assign
      244               p-b-code = l-code
      245             .
      246           end.
      247           else do:
      248             if available buf_code-range then do:
      249               assign
      250                 buf_code-range.stts = "u"
      251               .
      252             end.
      253             find first buf_code-range
      254               where buf_code-range.db-num     = v-db-num
      255                 and buf_code-range.range-type = type-code
      256                 and buf_code-range.stts       = "f"
      257               use-index stts
      258               no-error .
      259             if not available buf_code-range then do:
      260               message
      261                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      262                 "Обратитесь к администратору системы"
      263                 view-as alert-box error .
      264               undo, return error "code-range":U .
      265             end.
      266             assign
      267               buf_code-range.stts           = "a"
      268             .
      269             if buf_code-range.first-code = 1 then do:
      270               run set-seq-cr( input type-code,
      271                               input buf_code-range.first-code
      272                             ).
      273               assign
      274                 p-b-code = 1
      275               .
      276             end.
      277             else do:
      278               run set-seq-cr( input type-code,
      279                               input ( buf_code-range.first-code - 1 )
      280                             ).
      281               run get-next-seq( input type-code,
      282                                 output p-b-code
      283                               ).
      284             end.
      285           end.
      286         end.
      287       end.
      288     end.
      289   end procedure.
      290   procedure get-next-seq :
      291     define input  parameter type-code like ub.code-range.range-type no-undo .
      292     define output parameter next-seq  as   integer                  no-undo .
      293     do
      294     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      295     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      296     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      297     :
      298       case type-code:
      299         when 'bcgb':U then do:
      300           assign
      301             next-seq = next-value(s-bcgb-code, ub)
      302           .
      303         end.
      304         when 'scgb':U then do:
      305           assign
      306             next-seq = next-value(s-scgb-code, ub)
      307           .
      308         end.
      309         when 'sclc':U then do:
      310           assign
      311             next-seq = next-value(s-sclc-code, ub)
      312           .
      313         end.
      314         when 'pglc':U then do:
      315           assign
      316             next-seq = next-value(s-pglc-code, ub)
      317           .
      318         end.
      319         when 'dcgb':U then do:
      320           assign
      321             next-seq = next-value(s-dcgb-code, ub)
      322           .
      323         end.
      324         when 'ctgb':U then do:
      325           assign
      326             next-seq = next-value(s-ctgb-code, ub)
      327           .
      328         end.
      329         when 'drgb':U then do:
      330           assign
      331             next-seq = next-value(s-drgb-code, ub)
      332           .
      333         end.
      334         when 'fmgb':U then do:
      335           assign
      336             next-seq = next-value(s-fmgb-code, ub)
      337           .
      338         end.
      339         when 'pngb':U then do:
      340           assign
      341             next-seq = next-value(s-pngb-code, ub)
      342           .
      343         end.
      344         when 'cagb':U then do:
      345           assign
      346             next-seq = next-value(s-cagb-code, ub)
      347           .
      348         end.
      349         when 'fdgb':U then do:
      350           assign
      351             next-seq = next-value(s-fin-doc, ub)
      352           .
      353         end.
      354       end case.
      355     end.
      356   end procedure.
      357   procedure set-seq-cr :
      358     define input parameter type-code like ub.code-range.range-type no-undo .
      359     define input parameter set-val   like ub.code-range.first-code no-undo .
      360     do
      361     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      362     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      363     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      364     :
      365       case type-code:
      366         when 'bcgb':U then do:
      367           assign
      368             current-value(s-bcgb-code, ub) = set-val
      369           .
      370         end.
      371         when 'scgb':U then do:
      372           assign
      373             current-value(s-scgb-code, ub) = set-val
      374           .
      375         end.
      376         when 'sclc':U then do:
      377           assign
      378             current-value(s-sclc-code, ub) = set-val
      379           .
      380         end.
      381         when 'pglc':U then do:
      382           assign
      383             current-value(s-pglc-code, ub) = set-val
      384           .
      385         end.
      386         when 'dcgb':U then do:
      387           assign
      388             current-value(s-dcgb-code, ub) = set-val
      389           .
      390         end.
      391         when 'ctgb':U then do:
      392           assign
      393             current-value(s-ctgb-code, ub) = set-val
      394           .
      395         end.
      396         when 'drgb':U then do:
      397           assign
      398             current-value(s-drgb-code, ub) = set-val
      399           .
      400         end.
      401         when 'fmgb':U then do:
      402           assign
      403             current-value(s-fmgb-code, ub) = set-val
      404           .
      405         end.
      406         when 'pngb':U then do:
      407           assign
      408             current-value(s-pngb-code, ub) = set-val
      409           .
      410         end.
      411         when 'cagb':U then do:
      412           assign
      413             current-value(s-cagb-code, ub) = set-val
      414           .
      415         end.
      416         when 'fdgb':U then do:
      417           assign
      418             current-value(s-fin-doc, ub) = set-val
      419           .
      420         end.
      421       end case.
      422     end.
      423   end procedure.
      424   procedure new-bcod-gen-code-range :
      425     do
      426     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      427     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      428     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      429     :
      430       define input parameter p-db-num  like ub.db.db-num             no-undo .
      431       define input parameter type-code like ub.code-range.range-type no-undo .
      432       define buffer buf_code-range      for ub.code-range .
      433       define buffer last_code-range     for ub.code-range .
      434       define buffer last-1_code-range   for ub.code-range .
      435       define buffer last-2_code-range   for ub.code-range .
      436       define buffer last-3_code-range   for ub.code-range .
      437       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      438       define variable conf-par       as character no-undo .
      439       define variable par-type       as character no-undo .
      440       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      441       define variable v-cre-cdrg as logical   no-undo .
      442       define variable v-cre-str  as character no-undo .
      443       define variable v-cr1      as integer no-undo .
      444       define variable v-cr2      as integer no-undo .
      445       define variable v-cr3      as integer no-undo .
      446       define variable v-cmax     as integer no-undo .
      447       find first buf_sys-ctrl no-lock .
      448       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      449         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      450                                       ,vss-workfile
      451                                       ,vss-revision
      452                                       ,vss-description
      453                                       ,chr(10)
      454                                       , p-db-num
      455                                      ).
      456       end.
      457       run trg/getpcode.p ( input  type-code
      458                      ,output cfg-param-code
      459                     ).
      460       for each buf_code-range
      461         where buf_code-range.db-num     = -1
      462           and buf_code-range.range-type = type-code
      463           and buf_code-range.stts       = "f"
      464       by buf_code-range.first-code
      465       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      466       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      467       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      468       :
      469         assign
      470           buf_code-range.db-num = p-db-num
      471         .
      472         return .
      473       end.
      474       assign
      475         v-cre-cdrg = TRUE
      476       .
      477       case type-code:
      478         when 'sclc':U
      479         or when 'scgb':U
      480         or when 'pglc':U
      481         then do:
      482           find last last-1_code-range no-lock
      483             where last-1_code-range.range-type = 'sclc':U
      484             no-error .
      485           if available last-1_code-range then do:
      486             v-cr1 = last-1_code-range.last-code.
      487           end.
      488           find last last-2_code-range no-lock
      489             where last-2_code-range.range-type = 'scgb':U
      490             no-error .
      491           if available last-2_code-range then do:
      492             v-cr2 = last-2_code-range.last-code.
      493             end.
      494           find last last-3_code-range no-lock
      495             where last-3_code-range.range-type = 'pglc':U
      496             no-error .
      497           if available last-3_code-range then do:
      498             v-cr3 = last-3_code-range.last-code.
      499           end.
      500           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      501           .
      502           if v-cmax = v-cr1  then do:
      503               find last last_code-range no-lock
      504                 where recid( last_code-range ) = recid( last-1_code-range )
      505                 .
      506             end.
      507           if v-cmax = v-cr2  then do:
      508               find last last_code-range no-lock
      509                 where recid( last_code-range ) = recid( last-2_code-range )
      510                 .
      511             end.
      512           if v-cmax = v-cr3  then do:
      513             find last last_code-range no-lock
      514               where recid( last_code-range ) = recid( last-3_code-range )
      515               .
      516           end.
      517           if last_code-range.last-code + 1 > 99999 then do:
      518             assign
      519               v-cre-cdrg = FALSE
      520             .
      521           end.
      522         end.
      523         when 'bcgb':U
      524         or when 'sslc':U
      525         or when 'ssgb':U
      526         then do:
      527           find last last-1_code-range no-lock
      528             where last-1_code-range.range-type = 'sslc':U
      529             no-error .
      530           if available last-1_code-range then do:
      531             v-cr1 = last-1_code-range.last-code.
      532           end.
      533           find last last-2_code-range no-lock
      534             where last-2_code-range.range-type = 'bcgb':U
      535             no-error .
      536           if available last-2_code-range then do:
      537             v-cr2 = last-2_code-range.last-code.
      538             end.
      539           find last last-3_code-range no-lock
      540             where last-3_code-range.range-type = 'ssgb':U
      541             no-error .
      542           if available last-3_code-range then do:
      543             v-cr3 = last-3_code-range.last-code.
      544           end.
      545           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      546           .
      547           if v-cmax = v-cr1  then do:
      548               find last last_code-range no-lock
      549                 where recid( last_code-range ) = recid( last-1_code-range )
      550                 .
      551             end.
      552           if v-cmax = v-cr2  then do:
      553               find last last_code-range no-lock
      554                 where recid( last_code-range ) = recid( last-2_code-range )
      555                 .
      556             end.
      557           if v-cmax = v-cr3  then do:
      558             find last last_code-range no-lock
      559               where recid( last_code-range ) = recid( last-3_code-range )
      560               .
      561           end.
      562         end.
      563         otherwise do:
      564           find last last_code-range no-lock
      565             where last_code-range.range-type = type-code
      566             no-error .
      567         end.
      568       end case.
      569       if not available last_code-range then do:
      570         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      571                                       ,vss-workfile
      572                                       ,vss-revision
      573                                       ,vss-description
      574                                       , chr(10)
      575                                       , type-code
      576                                      ) .
      577       end.
      578       define variable v-mes1 as character no-undo .
      579       define variable v-param-type1 as character no-undo .
      580       define variable v-value-character1 as INTEGER no-undo .
      581       define variable v-value-date1 as date no-undo .
      582       define variable v-value-decimal1 as decimal no-undo .
      583       define variable v-value-integer1 AS integer no-undo .
      584       define variable v-value-logical1 AS LOGICAL no-undo .
      585       define variable v-tth1 as handle no-undo .
      586       run adm/shattri.p (
      587           input "get":U
      588           ,input  'БД':U
      589           ,input  p-db-num
      590           ,input  'code-range':U
      591           ,input  cfg-param-code
      592           ,output v-value-character1
      593           ,output v-value-date1
      594           ,output v-value-decimal1
      595           ,output v-value-integer1
      596           ,output v-value-logical1
      597           ,output v-param-type1
      598           ,INPUT-OUTPUT table-handle v-tth1
      599           ) no-error .
      600       if error-status :error then do:
      601         delete object v-tth1.
      602         v-mes1 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      603                            , error-status:get-message(1)
      604                            , chr(10)
      605                            , return-value ).
      606         undo, return error v-mes1.
      607       end.
      608       delete object v-tth1.
      609       if v-cre-cdrg = TRUE then do:
      610         create buf_code-range .
      611         assign
      612           buf_code-range.db-num     = p-db-num
      613           buf_code-range.range-type = type-code
      614           buf_code-range.stts       = "f"
      615           buf_code-range.first-code = last_code-range.last-code + 1
      616           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer1)
      617           v-cre-str = "Свободный диапазон успешно создан"
      618         .
      619       end.
      620       else do:
      621         assign
      622           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      623                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      624         .
      625       end.
      626     end.
      627     return v-cre-str .
      628   end procedure.
      629   procedure gen-new-code-range-if-neces :
      630     define input parameter v-db-num           like ub.db.db-num             no-undo .
      631     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      632     define input parameter v-cur-code         as   integer                  no-undo .
      633     define input parameter v-g#news           as   logical                  no-undo .
      634     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      635     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      636     do
      637     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      638     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      639     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      640     :
      641       define variable l-code-range-exist as logical   no-undo init false .
      642       define variable v-db-for-send      as character no-undo .
      643       define buffer buf_code-range  for ub.code-range .
      644       define buffer buf1_code-range for ub.code-range .
      645       define buffer buf_db          for ub.db .
      646       find first buf_code-range
      647         where buf_code-range.range-type = v-range-type
      648           and buf_code-range.last-code >= v-cur-code
      649         use-index last-codei
      650         no-error .
      651       if
      652       (
      653          available buf_code-range
      654          and
      655         (buf_code-range.db-num = v-db-num
      656           and
      657         buf_code-range.first-code <= v-cur-code
      658         )
      659       or
      660         (
      661           v-range-type = 'drgb':U
      662           AND
      663           v-cur-code = 0
      664         )
      665      )
      666      then do:
      667         assign
      668           l-code-range-exist = true
      669         .
      670         if v-g#news
      671         and buf_code-range.stts = "f" then do:
      672           assign
      673             buf_code-range.stts = "u"
      674           .
      675         end.
      676       end.
      677       if not l-code-range-exist
      678          and v-g#news-source-db <> 0
      679       then do:
      680         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      681                                       ,vss-workfile
      682                                       ,vss-revision
      683                                       ,vss-description
      684                                       ,chr(10)
      685                                       ,v-db-num
      686                                       ,v-range-type
      687                                       ,v-cur-code
      688                                      ).
      689       end.
      690       if (not l-code-range-exist
      691           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      692          )
      693       and ( not can-find (first buf1_code-range no-lock
      694                           where buf1_code-range.db-num = v-db-num
      695                             and buf1_code-range.range-type = v-range-type
      696                             and buf1_code-range.stts = "f"
      697                          )
      698           )
      699       then do:
      700         if v-g#db-num = 0 then do:
      701           run new-bcod-gen-code-range in this-procedure
      702             (input v-db-num,
      703              input v-range-type
      704             ) no-error .
      705           if error-status :error then do:
      706             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      707                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      708                                           ,v-db-num
      709                                           ,v-range-type
      710                                           ,v-cur-code
      711                                           ,chr(10)
      712                                           ,error-status:get-message(1)
      713                                           ,return-value
      714                                          ).
      715           end.
      716         end.
      717         else do:
      718           if v-range-type = 'sclc':U
      719           or v-range-type = 'pglc':U
      720           then do:
      721             assign
      722               v-db-for-send = "":U
      723             .
      724             if v-g#db-num = 0 then do:
      725               for each buf_db no-lock
      726                 where buf_db.db-num > 0
      727                   and buf_db.db-num <> v-g#news-source-db
      728               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      729               :
      730                 assign
      731                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      732                 .
      733               end.
      734               assign
      735                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      736               .
      737             end.
      738             else do:
      739               if not v-g#news then do:
      740                 assign
      741                   v-db-for-send = "0":U
      742                 .
      743               end.
      744             end.
      745             run nws/cr-route.p ( input 'send-cmd':U
      746                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      747                                  "code-range":U + chr(1) +
      748                                  (if v-range-type = 'sclc':U
      749                                   then string( current-value(s-sclc-code, ub))
      750                                   else string( current-value(s-pglc-code, ub))
      751                                   ) + chr(1) +
      752                                   v-range-type)
      753                           ,input ?
      754                           ,input v-db-for-send
      755                           ) no-error .
      756             if error-status :error then do:
      757               undo, return error return-value.
      758             end.
      759           end.
      760         end.
      761       end.
      762     end.
      763   end procedure.
      764   procedure cre-loc-sc-code-range :
      765     define input parameter v-cur-code as integer no-undo .
      766   define input parameter p-cdrg-type as character no-undo .
      767     do
      768     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      769     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      770     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      771     :
      772       define buffer buf_code-range for ub.code-range .
      773       find first buf_code-range
      774            where buf_code-range.range-type = p-cdrg-type
      775              and buf_code-range.first-code >= v-cur-code
      776            no-error .
      777       if not available buf_code-range then do:
      778         run new-bcod-gen-code-range in this-procedure
      779           ( input 0,
      780             input p-cdrg-type
      781           ) no-error .
      782         if error-status :error then do:
      783           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      784                                          + "Код &2&1&3 &4"
      785                                         , chr(10)
      786                                         , v-cur-code
      787                                         , error-status:get-message(1)
      788                                         , return-value
      789                                        ) .
      790         end.
      791       end.
      792     end.
      793   end procedure.
      794   procedure mark-used-if-need :
      795   define input parameter p-cur-code as integer no-undo .
      796   define input parameter p-range-type like ub.code-range.range-type no-undo .
      797   define input parameter p-db-num like ub.code-range.db-num no-undo .
      798     do
      799     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      800     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      801     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      802     :
      803       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      804       define buffer buf_code-range for ub.code-range .
      805       assign
      806       v-db-num = if p-range-type = 'sclc':U
      807                  then 0
      808                  else p-db-num
      809       .
      810   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      811   define buffer locK-batchprocess2 for ub.batchprocess.
      812   run gbl/lock-prc.p
      813       (input 'lscc':U
      814       ,input 0
      815       ,input 0
      816       ,input 0
      817       ,input ""
      818       ,input ""
      819       ,input ""
      820       ,input (
      821               ",,,Вкл/выкл лок. вес. кодов"
      822              )
      823       ,input true
      824       ,buffer lock-batchprocess2
      825       ) no-error .
      826     if error-status :error then do:
      827       message
      828         vss-workfile vss-revision vss-description skip
      829         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      830         view-as alert-box error .
      831       undo, return error .
      832     end.
      833       find first buf_code-range
      834            where buf_code-range.range-type = p-range-type
      835              and buf_code-range.first-code >= p-cur-code
      836              and buf_code-range.last-code <= p-cur-code
      837              and buf_code-range.db-num = v-db-num
      838            no-error .
      839       if not available buf_code-range then do:
      840         message
      841           vss-workfile vss-revision vss-description skip
      842           "Ошибка при создании поиске диапазона" skip
      843           "База данных" p-db-num skip
      844           "Код" p-cur-code skip
      845           "Тип" p-range-type
      846           error-status :get-message(1) skip
      847           return-value skip
      848           view-as alert-box error .
      849         undo, return error .
      850       end.
      851       if buf_code-range.stts = "f":U then do:
      852         assign
      853         buf_code-range.stts = "u":U
      854         .
      855       end.
      856     end.
      857   end procedure.
      858   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      859   define variable send-ref as logical no-undo.
      860     define variable dops as character no-undo format "X(250)".
      861     define variable dopst as character no-undo format "X(1)".
      862   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      863     (input  'send-ref'
      864     ,input  0
      865     ,input  ''
      866     ,input  0
      867     ,input  ''
      868     ,input  ''
      869     ,input  ''
      870     ,input  no
      871     ,output dops
      872     ,output dopst
      873     ) no-error .
      874     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
      875   define input parameter p-db-num as integer no-undo .
      876   define input parameter p-b-code like ub.bar-code.b-code no-undo .
      877   define input parameter p-gtin   like ub.prod-bc.b-str no-undo .
      878   define input parameter p-send   as logical no-undo .
      879   define variable parparentproc as widget-handle no-undo .
      880   define variable v-cntxt-db-num        as integer   no-undo .
      881   define variable v-cntxt-userid        as character no-undo .
      882   define variable v-cntxt-level         as character no-undo .
      883   define variable v-cntxt-host-code-obj as integer   no-undo .
      884   define variable v-cntxt-obj-type      as character no-undo .
      885   define variable v-cntxt-obj-code      as integer   no-undo .
      886   define variable v-cntxt-db-num-obj    as integer   no-undo .
      887   define variable v-cntxt-is-admin      as logical   no-undo .
      888   define variable v-b-str     as character  no-undo .
      889   define variable v-rid-pbc   as recid      no-undo .
      890   define variable v-err-mess  as character  no-undo .
      891   define buffer buf_goods for ub.goods .
      892   define buffer buf_bar-code for ub.bar-code .
      893   define buffer buf_prod-bc for ub.prod-bc .
      894   parparentproc = this-procedure:handle .
      895   find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code  no-error.
      896   if not available buf_bar-code
      897   then do:
      898      v-err-mess = substitute("Ошибка при сохранении GTIN &1 bar-code &5 &2&3&2&4"
      899                           , p-gtin
      900                           , chr(10)
      901                           , error-status:get-message(1)
      902                           , return-value
      903                           , p-b-code ).
      904       undo, return error v-err-mess .
      905   end.
      906   find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error.
      907   if not available buf_goods
      908   then do:
      909      v-err-mess = substitute("Ошибка при сохранении GTIN &1 gds-code &5 &2&3&2&4"
      910                           , p-gtin
      911                           , chr(10)
      912                           , error-status:get-message(1)
      913                           , return-value
      914                           , buf_bar-code.gds-code ).
      915       undo, return error v-err-mess .
      916   end.
      917   v-b-str = p-gtin .
      918   run trg/prod-bc2.p (
      919                        input  parparentproc
      920                       ,input yes
      921                       ,input ?
      922                       ,input ?
      923                       ,input (send-ref and p-send)
      924                       ,input 'GTIN':U
      925                       ,input ""
      926                       ,buffer buf_goods
      927                       ,input buf_bar-code.b-code
      928                       ,input no
      929                       ,input-output v-b-str
      930                       ,output v-rid-pbc
      931                       ) no-error.
      932   if error-status :error
      933   or v-rid-pbc = ? then do:
      934     v-err-mess = substitute("Ошибка при сохранении GTIN &1&2&3&2&4"
      935                           , p-gtin
      936                           , chr(10)
      937                           , error-status:get-message(1)
      938                           , return-value ).
      939       undo, return error v-err-mess .
      940   end.
      941   else do:
      942     find first buf_prod-bc no-lock
      943           where recid(buf_prod-bc) = v-rid-pbc.
      944     if  buf_prod-bc.bc-on
      945     and send-ref
      946     and p-send
      947     then do:
      948       run str/diallog.w
      949         (input parparentproc
      950         ,input this-procedure
      951         ,input 'str/s-prodbc.p':U
      952         ,input string(v-rid-pbc) + chr(4) + "U":U
      953         ,input yes
      954         ,input '':U
      955         ,input "Пересылка ДопБК на кассы"
      956         ) .
      957     end.
      958   end.
      959   procedure mainmenu_getcntxt :
      960     define output parameter v-cntxt-db-num        as integer   no-undo .
      961     define output parameter v-cntxt-userid        as character no-undo .
      962     define output parameter v-cntxt-level         as character no-undo .
      963     define output parameter v-cntxt-host-code-obj as integer   no-undo .
      964     define output parameter v-cntxt-obj-type      as character no-undo .
      965     define output parameter v-cntxt-obj-code      as integer   no-undo .
      966     define output parameter v-cntxt-db-num-obj    as integer   no-undo .
      967     define output parameter v-cntxt-is-admin      as logical   no-undo .
      968     find first ub.clients no-lock where ub.clients.db-num   = p-db-num
      969                                     and ub.clients.obj-type = 'маг':U
      970                                     and ub.clients.stts = 0 .
      971     v-cntxt-db-num = p-db-num .
      972     v-cntxt-userid = ? .
      973     v-cntxt-level = ? .
      974     v-cntxt-host-code-obj = ub.clients.host-code .
      975     v-cntxt-obj-type = ub.clients.obj-type .
      976     v-cntxt-obj-code = ub.clients.obj-code .
      977     v-cntxt-db-num-obj = ub.clients.db-num .
      978     v-cntxt-is-admin =  ? .
      979   end procedure .
