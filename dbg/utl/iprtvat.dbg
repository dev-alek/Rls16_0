      350      define output parameter p-select-obj-code as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       run gbl/userobjs.w
      355         (input  parparentproc
      356         ,input  this-procedure :handle
      357         ,input  p-db-num
      358         ,input  p-user-id
      359         ,input  p-host-code-obj
      360         ,input  p-obj-type
      361         ,input  p-obj-code
