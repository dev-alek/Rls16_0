      232   procedure userobjs_clear :
      233     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      234     do
      235     on error undo, return error return-value
      236     :
      237       for each buf_userobjs_temp-user-obj
      238       on error undo, return error return-value
      239       :
      240         delete buf_userobjs_temp-user-obj .
      241       end.
      242     end.
      243   end .
      244   procedure userobjs_object-count :
      245     define output parameter p-total-count as integer   no-undo .
      246     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      247     do
      248     on error undo, return error return-value
      249     :
      250       assign
      251         p-total-count = 0
      252       .
      253       for each buf_userobjs_temp-user-obj
      254       on error undo, return error return-value
      255       :
      256         assign
      257           p-total-count = p-total-count + 1
      258         .
      259       end.
      260     end.
      261   end.
      262   procedure userobjs_append :
      263      define input  parameter p-obj-type as character no-undo .
      264      define input  parameter p-obj-code as integer   no-undo .
      265     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      266     do
      267     on error undo, return error return-value
      268     :
      269       find first buf_userobjs_temp-user-obj
      270         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      271           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      272         no-error .
      273       if not available buf_userobjs_temp-user-obj
      274       then do:
      275         create buf_userobjs_temp-user-obj .
      276         assign
      277           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      278           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      279         .
      280       end.
      281     end.
      282   end.
      283   procedure userobjs_object-exist :
      284     define output parameter p-object-exist as logical   no-undo .
      285     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      286     do
      287     on error undo, return error return-value
      288     :
      289       find first buf_userobjs_temp-user-obj
      290         no-error .
      291       if not available buf_userobjs_temp-user-obj
      292       then do:
      293         assign
      294           p-object-exist = false
      295         .
      296       end.
      297       else do:
      298         assign
      299           p-object-exist = true
      300         .
      301       end.
      302     end.
      303   end.
      304   procedure userobjs_transfer :
      305     define input  parameter p-callback-handle as handle no-undo .
      306     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      307     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      308     do
      309     on error undo, return error return-value
      310     :
      311       if valid-handle(p-callback-handle) <> true
      312       then do:
      313         message
      314           vss-workfile vss-revision vss-description skip
      315           "Ошибка задания входных параметров" skip
      316           "Неизвестный указатель на процедуру" skip
      317           view-as alert-box error .
      318         undo, return error return-value .
      319       end.
      320       if p-callback-handle :get-signature("userobjs_append") = ""
      321       then do:
      322         message
      323           vss-workfile vss-revision vss-description skip
      324           "Ошибка задания входных параметров" skip
      325           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      326                     ,p-callback-handle :file-name
      327                     ) skip
      328           view-as alert-box error .
      329         undo, return error return-value .
      330       end.
      331       for each buf_userobjs_temp-user-obj
      332       on error undo, return error return-value
      333       :
      334         run userobjs_append in p-callback-handle
      335           (input  buf_userobjs_temp-user-obj.obj-type
      336           ,input  buf_userobjs_temp-user-obj.obj-code
      337           ) .
      338       end.
      339     end.
      340   end procedure.
      341   procedure userobjs_select-one :
      342      define input  parameter parparentproc     as widget-handle no-undo .
      343      define input  parameter p-db-num          as integer   no-undo .
      344      define input  parameter p-user-id         as character no-undo .
      345      define input  parameter p-host-code-obj   as integer   no-undo .
      346      define input  parameter p-obj-type        as character no-undo .
