      397   procedure thobjs :
      398      define input        parameter parparentproc     as widget-handle no-undo .
      399      define input        parameter i-bttns           as character     no-undo .
      400      define input        parameter i-list-mode       as character     no-undo.
      401      define input        parameter i-obj-type        as character     no-undo.
      402      define input        parameter i-db-num          as integer       no-undo.
      403      define input        parameter i-host-code       as integer       no-undo.
      404      define input-output parameter p-rid-list        as character     no-undo .
      405   run ref/thobjs.p
      406           ( input parparentproc
      407            ,input  this-procedure :handle
      408           , input i-bttns
      409           , input i-list-mode
      410           , input i-obj-type
      411           , input i-db-num
      412           , input i-host-code
      413           , input-output p-rid-list ) no-error .
      414   end.
      415   run str/gds-list.w
      416     (input parparentproc
      417     ,input v-cntxt-host-code-obj
      418     ,input v-cntxt-obj-type
      419     ,input v-cntxt-obj-code
      420     ) .
      421   define variable lok as logical no-undo init false .
      422   message
      423     "Проинициализировать партии свобоной и расходной зон для выбранных товаров." skip
      424     "значениями НДС из справочника товаров"
      425     "Да - все объекты" skip
      426     "Нет - выбрать объекты" skip
      427     view-as alert-box question buttons yes-no-cancel update lok
      428     .
      429   if lok = ? then do:
      430     return .
      431   end.
      432   if lok = true then do:
      433     for each temp-obj
      434     :
      435       run initialise-parts-vat-pc
      436         (input temp-obj.obj-type
      437         ,input temp-obj.obj-code
      438         ).
      439     end.
      440   end.
      441   if lok = false
      442   then do:
      443     define variable v-user-select as logical   no-undo .
      444   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   run userobjs_select-many in this-procedure
      446     (input  parparentproc
      447     ,input  v-cntxt-db-num
      448     ,input  v-cntxt-userid
      449     ,input  v-cntxt-host-code-obj
      450     ,input  v-cntxt-obj-type
      451     ,input  v-cntxt-obj-code
      452     ,output v-user-select
      453     )  .
      454     if v-user-select <> true
      455     then do:
      456       message
      457         "Объект не выбран"
      458         view-as alert-box information .
      459       return .
      460     end.
      461     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      462     for each buf_userobjs_temp-user-obj
      463     on error undo, return error return-value
      464     :
      465       run initialise-parts-vat-pc
      466         (input buf_userobjs_temp-user-obj.obj-type
      467         ,input buf_userobjs_temp-user-obj.obj-code
      468         ).
      469     end.
      470   end.
      471   procedure initialise-parts-vat-pc :
      472     define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
      473     define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
      474     define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
      475     define variable v-slt-pc        like ub.doc-line.slt-pc    no-undo.
      476     define variable v-host-code     like ub.sysconf.host-code  no-undo.
      477   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      479     (input  p-obj-type
      480     ,input  p-obj-code
      481     ,output v-host-code
      482     )  .
      483     for each gds-list
      484     :
      485       find first ub.goods no-lock
      486         where ub.goods.artic     = gds-list.artic
      487           and ub.goods.prod-type = gds-list.prod-type
      488           and ub.goods.prod-code = gds-list.prod-code
      489         .
      490       find first ub.gds-obj exclusive-lock
      491         where ub.gds-obj.obj-type  = p-obj-type
      492           and ub.gds-obj.obj-code  = p-obj-code
      493           and ub.gds-obj.artic     = ub.goods.artic
      494           and ub.gds-obj.prod-type = ub.goods.prod-type
      495           and ub.gds-obj.prod-code = ub.goods.prod-code
      496         no-error .
      497       for each ub.parts
      498         where ub.parts.obj-type     = p-obj-type
      499           and ub.parts.obj-code     = p-obj-code
      500           and ub.parts.artic        = ub.goods.artic
      501           and ub.parts.prod-type    = ub.goods.prod-type
      502           and ub.parts.prod-code    = ub.goods.prod-code
      503           and ub.parts.status_      = no
      504           and (ub.parts.rsrv-free   = yes
      505                or ub.parts.rsrv-free = no
      506               )
      507       :
      508   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      510     (input  ub.goods.gds-code
      511     ,input  '1':U
      512     ,input  ?
      513     ,input  v-host-code
      514     ,input  p-obj-type
      515     ,input  p-obj-code
      516     ,output v-vat-pc
      517     ) no-error .
      518         assign
      519         ub.parts.VAT-pc = v-vat-pc
      520         .
      521       end.
      522     end.
      523   end procedure.
