     4100   procedure partslib-create-temp-parts :
     4101     define parameter buffer buf_parts       for ub.parts .
     4102     define parameter buffer buf_temp-parts  for temp-parts .
     4103     define input  parameter p-goods-twounit as logical   no-undo .
     4104     define variable v-base-part-code as character no-undo .
     4105     do
     4106     on error undo, return error
     4107     :
     4108       if p-goods-twounit = true
     4109       then do:
     4110         assign
     4111           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     4112         .
     4113       end.
     4114       else do:
     4115         assign
     4116           v-base-part-code = buf_parts.part-code
     4117         .
     4118       end.
     4119       find first buf_temp-parts exclusive-lock
     4120         where buf_temp-parts.obj-type  = buf_parts.obj-type
     4121           and buf_temp-parts.obj-code  = buf_parts.obj-code
     4122           and buf_temp-parts.artic     = buf_parts.artic
     4123           and buf_temp-parts.prod-type = buf_parts.prod-type
     4124           and buf_temp-parts.prod-code = buf_parts.prod-code
     4125           and buf_temp-parts.in-code   = buf_parts.in-code
     4126           and buf_temp-parts.out-code  = 'free-zone':U
     4127           and buf_temp-parts.part-code = v-base-part-code
     4128         no-error.
     4129       if not available buf_temp-parts
     4130       then do:
     4131         create buf_temp-parts .
     4132         buffer-copy buf_parts to buf_temp-parts
     4133         assign
     4134           buf_temp-parts.out-code  = 'free-zone':U
     4135           buf_temp-parts.part-code = v-base-part-code
     4136           buf_temp-parts.rsrv-free = yes
     4137           buf_temp-parts.status_   = no
     4138           buf_temp-parts.qnty      = 0
     4139           buf_temp-parts.fact-qnty = 0
     4140           buf_temp-parts.real-qnty = 0
     4141           buf_temp-parts.cli-qnty  = 0
     4142         .
     4143       end.
     4144     end.
     4145   end procedure.
     4146   procedure partslib-init-temp-parts :
     4147     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     4148     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     4149     define input parameter p-artic           like ub.parts.artic     no-undo .
     4150     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     4151     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     4152     define buffer buf_parts      for ub.parts .
     4153     define buffer buf_temp-parts for temp-parts .
     4154     define variable v-goods-twounit    as logical   no-undo .
     4155     do
     4156     on error undo, return error
     4157     :
     4158   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4159   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4160     (input  p-artic
     4161     ,input  p-prod-type
     4162     ,input  p-prod-code
     4163     ,input  'twounit=request':u
     4164     ,output v-goods-twounit
     4165     ) no-error .
     4166       if error-status :error
     4167       then do:
     4168         message
     4169           vss-workfile vss-revision vss-description skip
     4170           vss-include-info25 skip
     4171           "Ошибка при определении атрибута товара" skip
     4172           "Артикул" p-artic p-prod-type p-prod-code skip
     4173           "twounit=request" skip
     4174           error-status :get-message(1) skip
     4175           return-value skip
     4176           view-as alert-box error .
     4177         undo, return error return-value .
     4178       end.
     4179       run partslib-clear-temp-parts in this-procedure .
     4180       for each buf_parts
     4181         where buf_parts.obj-type  = p-obj-type
     4182           and buf_parts.obj-code  = p-obj-code
     4183           and buf_parts.artic     = p-artic
     4184           and buf_parts.prod-type = p-prod-type
     4185           and buf_parts.prod-code = p-prod-code
     4186           and buf_parts.rsrv-free = yes
     4187           and buf_parts.status_   = no
     4188           and buf_parts.in-code   <> buf_parts.out-code
     4189       on error undo, return error
     4190       :
     4191         run partslib-create-temp-parts in this-procedure
     4192           (buffer buf_parts
     4193           ,buffer buf_temp-parts
     4194           ,input  v-goods-twounit
     4195           ) .
     4196         define variable v-parts-qnty          as decimal   no-undo .
     4197         define variable v-parts-cli-qnty      as decimal   no-undo .
     4198         define variable v-parts-free-qnty     as decimal   no-undo .
     4199         define variable v-parts-free-cli-qnty as decimal   no-undo .
     4200         if buf_parts.out-code = 'free-zone':U
     4201         then do:
     4202           assign
     4203             v-parts-qnty          = buf_parts.qnty
     4204             v-parts-cli-qnty      = buf_parts.cli-qnty
     4205             v-parts-free-qnty     = buf_parts.qnty
     4206             v-parts-free-cli-qnty = buf_parts.cli-qnty
     4207           .
     4208         end.
     4209         else do:
     4210           assign
     4211             v-parts-qnty          = abs(buf_parts.qnty)
     4212             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     4213             v-parts-free-qnty     = 0
     4214             v-parts-free-cli-qnty = 0
     4215           .
     4216         end.
     4217         assign
     4218           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     4219           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     4220           buf_temp-parts.real-qnty     = 0
     4221           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     4222           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     4223           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     4224         .
     4225       end.
     4226     end.
     4227   end procedure.
