     2722   procedure prdoclib-clear-temp-prt-obj :
     2723     define buffer buf_temp-prt-obj for temp-prt-obj .
     2724     do
     2725     on error undo, return error return-value
     2726     :
     2727       for each buf_temp-prt-obj
