     1411   end procedure.
     1412   procedure doclslib-export-doc-list :
     1413     define input  parameter p-obj-type      as character no-undo .
     1414     define input  parameter p-obj-code      as integer no-undo .
     1415     define input  parameter p-log-file-name as character no-undo .
     1416     define input  parameter p-description   as character no-undo .
     1417     define buffer buf_doc-list for doc-list .
     1418     do
     1419     on error undo, return error
     1420     :
     1421       output stream doclsliblog to value(p-log-file-name) .
     1422       export stream doclsliblog "#############################################################" .
     1423       export stream doclsliblog "Список документов" .
     1424       export stream doclsliblog p-description .
     1425       export stream doclsliblog "Объект" p-obj-type p-obj-code .
     1426       export stream doclsliblog "Дата" string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     1427       for each buf_doc-list
     1428       by buf_doc-list.fact-order
     1429       on error undo, return error
     1430       :
     1431         export stream doclsliblog buf_doc-list .
     1432       end.
     1433       export stream doclsliblog "#############################################################" .
     1434       output stream doclsliblog close .
     1435     end.
     1436   end procedure.
     1437   procedure doclslib-clear-batch-process :
     1438     define input parameter p-bp_type like ub.batchprocess.bp_type no-undo .
     1439     define buffer buf_batchprocess        for ub.batchprocess .
     1440     define buffer execdelete_batchprocess for ub.batchprocess .
     1441     define buffer buf_doc-list            for doc-list .
     1442     for each buf_doc-list
     1443     on end-key undo, return error substitute( "doclslib-clear-batch-process. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1444     on error   undo, return error substitute( "doclslib-clear-batch-process. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1445     on stop    undo, return error substitute( "doclslib-clear-batch-process. STOP      &2"
     1446                                    + "bp_type &3&2"
     1447                                    + "Документ &4"
     1448                                    , chr(10)
     1449                                    , p-bp_type
     1450                                    , buf_doc-list.doc-code
     1451                                   )
     1452     :
     1453       find first buf_batchprocess exclusive-lock
     1454         where buf_BatchProcess.BP_Status   = 'N':U
     1455           and buf_batchprocess.bp_type     = p-bp_type
     1456           and buf_batchprocess.charkey_one = buf_doc-list.doc-code
     1457         no-error .
     1458       if available buf_batchprocess
     1459       then do:
     1460         delete buf_batchprocess .
     1461       end.
     1462     end.
     1463   end procedure.
     1464   procedure doclslib-calc-arh :
     1465     define input  parameter p-log-handle     as handle    no-undo .
     1466     define input  parameter p-obj-type       as character no-undo .
     1467     define input  parameter p-obj-code       as integer   no-undo .
     1468     define input  parameter p-cut-date       as date      no-undo .
     1469     define input  parameter p-update-recalc  as logical   no-undo .
     1470     define variable v-prev-fact-date as date      no-undo .
     1471     define buffer buf_doc-list for doc-list .
     1472     define buffer stop-arh-restore-lock_btpr for ub.batchprocess .
     1473     define buffer stop-arh-news-lock_btpr    for ub.batchprocess .
     1474     do
     1475     on stop    undo, return error substitute( "doclslib-calc-arh. stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1476     on end-key undo, return error substitute( "doclslib-calc-arh. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1477     on error   undo, return error substitute( "doclslib-calc-arh. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1478     :
     1479       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1480       run gbl/lockrngd.p
     1481         (input  'grar':U
     1482         ,input  'disable':U
     1483         ,buffer buf_lock_gdsrenart_batchprocess
     1484         ) no-error .
     1485       if error-status :error
     1486       then do:
     1487         if error-status :get-message(1) <> ""
     1488         then do:
     1489           message
     1490             vss-workfile vss-revision vss-description skip
     1491             "Ошибка при блокировании функции переименования артикула товара" skip
     1492             error-status :get-message(1) skip
     1493             return-value skip
     1494             view-as alert-box error .
     1495         end.
     1496         undo, return error return-value .
     1497       end.
     1498       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1499       run gbl/lockrngd.p
     1500         (input  'grgc':U
     1501         ,input  'disable':U
     1502         ,buffer buf_lock_gdsrengc_batchprocess
     1503         ) no-error .
     1504       if error-status :error
     1505       then do:
     1506         if error-status :get-message(1) <> ""
     1507         then do:
     1508           message
     1509             vss-workfile vss-revision vss-description skip
     1510             "Ошибка при блокировании функции переименования кода товара" skip
     1511             error-status :get-message(1) skip
     1512             return-value skip
     1513             view-as alert-box error .
     1514         end.
     1515         undo, return error return-value .
     1516       end.
     1517       for each buf_doc-list
     1518       by buf_doc-list.fact-order
     1519       on stop    undo, return error substitute( "f e . stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1520       on end-key undo, return error substitute( "f e . end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1521       on error   undo, return error substitute( "f e . error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1522       :
     1523         find first stop-arh-restore-lock_btpr no-lock
     1524           where stop-arh-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
     1525             and stop-arh-restore-lock_btpr.bp_status     = 'N':U
     1526             and stop-arh-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1527             and stop-arh-restore-lock_btpr.Key#_Two      = 0
     1528             and stop-arh-restore-lock_btpr.Key#_Three    = 0
     1529             and stop-arh-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1530             and stop-arh-restore-lock_btpr.CharKey_Two   = ""
     1531             and stop-arh-restore-lock_btpr.CharKey_Three = ""
     1532           no-error .
     1533         if available stop-arh-restore-lock_btpr
     1534         then do:
     1535           run doclslib-log-information in this-procedure
     1536             (input p-log-handle
     1537             ,input "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива"
     1538             ) .
     1539           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1540         end.
     1541         find first stop-arh-news-lock_btpr no-lock
     1542           where stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
     1543             and stop-arh-news-lock_btpr.bp_status     = 'N':U
     1544             and stop-arh-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1545             and stop-arh-news-lock_btpr.Key#_Two      = 0
     1546             and stop-arh-news-lock_btpr.Key#_Three    = 0
     1547             and stop-arh-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1548             and stop-arh-news-lock_btpr.CharKey_Three = ""
     1549           no-error .
     1550         if available stop-arh-news-lock_btpr
     1551         then do:
     1552           run doclslib-log-information in this-procedure
     1553             (input p-log-handle
     1554             ,input "Система новостей запросила остановку процедуры расчета складского архива"
     1555             ) .
     1556           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1557         end.
     1558         if buf_doc-list.is-trn-doc
     1559         then do:
     1560           run doclslib-log-information in this-procedure
     1561             (input p-log-handle
     1562             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1563                              ,buf_doc-list.doc-code
     1564                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1565                              ,buf_doc-list.fact-order
     1566                              )
     1567             ) .
     1568           run trg/calc-arh.p
     1569             (input buf_doc-list.doc-code
     1570             ,input p-cut-date
     1571             ).
     1572           run doclslib-log-information in this-procedure
     1573             (input p-log-handle
     1574             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1575                              ,buf_doc-list.doc-code
     1576                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1577                              ,buf_doc-list.fact-order
     1578                              )
     1579             ) .
     1580         end.
     1581         else do:
     1582           run doclslib-log-information in this-procedure
     1583             (input p-log-handle
     1584             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1585                              ,buf_doc-list.doc-code
     1586                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1587                              ,buf_doc-list.fact-order
     1588                              )
     1589             ) .
     1590           run trg/calc-apc.p
     1591             (input buf_doc-list.doc-code
     1592             ,input p-cut-date
     1593             ).
     1594           run doclslib-log-information in this-procedure
     1595             (input p-log-handle
     1596             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1597                              ,buf_doc-list.doc-code
     1598                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1599                              ,buf_doc-list.fact-order
     1600                              )
     1601             ) .
     1602         end.
     1603         if  p-update-recalc  = true
     1604         and v-prev-fact-date <> ?
     1605         and buf_doc-list.fact-date > v-prev-fact-date
     1606         then do:
     1607           run gbl/clntat-w.p
     1608             (input p-obj-type
     1609             ,input p-obj-code
     1610             ,input 'arh-recalc':U
     1611             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1612             ) .
     1613           run doclslib-log-information in this-procedure
     1614             (input p-log-handle
     1615             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1616                              ,string(v-prev-fact-date, '99/99/9999':u)
     1617                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1618                              )
     1619             ) .
     1620         end.
     1621         assign
     1622           v-prev-fact-date = buf_doc-list.fact-date
     1623         .
     1624       end.
     1625     end.
     1626   end procedure.
     1627   procedure doclslib-calc-aht :
     1628     define input  parameter p-log-handle    as handle    no-undo .
     1629     define input  parameter p-obj-type      as character no-undo .
     1630     define input  parameter p-obj-code      as integer   no-undo .
     1631     define input  parameter p-cut-date      as date      no-undo .
     1632     define input  parameter p-update-recalc as logical   no-undo .
     1633     define variable v-prev-fact-date as date      no-undo .
     1634     define buffer buf_doc-list for doc-list .
     1635     define buffer stop-aht-restore-lock_btpr for ub.batchprocess .
     1636     define buffer stop-aht-news-lock_btpr    for ub.batchprocess .
     1637     do
     1638     on error undo, return error return-value
     1639     :
