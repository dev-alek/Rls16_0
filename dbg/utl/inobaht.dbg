     6222       bfsacc_tt-allsum.vat-rubl-cur        = 0
     6223       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     6224       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     6225       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     6226       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     6227       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     6228       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     6229       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     6230       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     6231       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     6232       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     6233       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     6234       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     6235       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     6236       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     6237       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     6238       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     6239       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     6240       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     6241       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     6242       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     6243       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     6244       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     6245       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     6246       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     6247       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     6248       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     6249       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     6250       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     6251       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     6252       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     6253       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     6254       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     6255       .
     6256   end.
     6257   otherwise do:
     6258     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     6259                              cl_tt-clcparts.purch-code,
     6260                              cl_tt-clcparts.part-code,
     6261                              cl_tt-clcparts.out-code,
     6262                              cl_tt-clcparts.in-code,
     6263                              cl_tt-clcparts.artic,
     6264                              cl_tt-clcparts.prod-type,
     6265                              cl_tt-clcparts.prod-code).
     6266   end.
     6267   end case.
     6268   end.
     6269   end procedure.
     6270   procedure clcprtsl_calc-line :
     6271   define input  parameter parrec-line as recid no-undo.
     6272   define variable v-tax-date         as   date                     no-undo.
     6273   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     6274   define variable varr-b             as   character                no-undo.
     6275   define variable varr-btype         as   character                no-undo.
     6276   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     6277   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     6278   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     6279   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     6280   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     6281   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     6282   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     6283   define variable varb-code          like ub.bar-code.b-code       no-undo.
     6284   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6285   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6286   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6287   define variable varexcise          like ub.price-list.excise     no-undo.
     6288   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     6289   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     6290   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     6291   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6292   define variable v-varsum           as decimal                  no-undo.
     6293   define variable varprice-salef as decimal   no-undo .
     6294   define buffer bf_trn-doc             for ub.trn-doc.
     6295   define buffer bf_doc-line            for ub.doc-line.
     6296   define buffer bf_gds-dtl             for ub.gds-dtl.
     6297   define buffer bf_goods               for ub.goods.
     6298   define buffer bf_parts               for ub.parts.
     6299   define buffer bf_sysconf             for ub.sysconf.
     6300   define buffer bf_tt-allsum-line      for tt-allsum-line.
     6301   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     6302   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     6303   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     6304   define buffer buf_parts        for ub.parts.
     6305   v-calcbypart = no.
     6306   do on error undo, return error return-value :
     6307   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6308   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6309     (output varr-b
     6310     )  .
     6311     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     6312     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     6313     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     6314                               bf_goods.prod-type = bf_doc-line.prod-type and
     6315                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     6316     if bf_trn-doc.fact-date <> ?        then do:
     6317       assign v-tax-date = bf_trn-doc.fact-date.
     6318     end.
     6319     else do:
     6320       assign v-tax-date = ?.
     6321     end.
     6322   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6324     (input  bf_goods.gds-code
     6325     ,input  '1':U
     6326     ,input  v-tax-date
     6327     ,input  bf_trn-doc.host-code
     6328     ,input  bf_trn-doc.obj-type
     6329     ,input  bf_trn-doc.obj-code
     6330     ,output v-vat-pc
     6331     ) no-error .
     6332     if error-status :error
     6333     or v-vat-pc = ? then do:
     6334        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     6335     end.
     6336     if bf_goods.gds-type = 'у':U or
     6337        bf_trn-doc.status_ = 'запрос':U then do:
     6338       for each bf_tt-allsum-line
     6339       on error undo, return error return-value
     6340        :
     6341         delete bf_tt-allsum-line.
     6342       end.
     6343       create bf_tt-allsum-line.
     6344       assign
     6345        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     6346       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     6347                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     6348                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     6349                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     6350         assign
     6351           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     6352           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     6353           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     6354           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     6355           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     6356           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     6357           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     6358           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     6359           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     6360           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     6361           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     6362           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     6363           bf_tt-allsum-line.vat-cli-acc          =  ?
     6364           .
     6365       end.
     6366       assign
     6367         bf_tt-allsum-line.cli-qnty             =  ?
     6368         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6369         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6370         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6371         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6372         bf_tt-allsum-line.road-tax-base-doc    =  0
     6373         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     6374         bf_tt-allsum-line.excise-base-doc      =  0
     6375         bf_tt-allsum-line.excise-rubl-doc      =  0
     6376         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     6377         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     6378         bf_tt-allsum-line.dsc-base-cur         =  0
     6379         bf_tt-allsum-line.dsc-rubl-cur         =  0
     6380         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6381         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6382         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6383         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6384         bf_tt-allsum-line.road-tax-base-cur    =  0
     6385         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     6386         bf_tt-allsum-line.excise-base-cur      =  0
     6387         bf_tt-allsum-line.excise-rubl-cur      =  0
     6388         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     6389         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     6390         bf_tt-allsum-line.dsc-base-acc         =  0
     6391         bf_tt-allsum-line.dsc-rubl-acc         =  0
     6392         bf_tt-allsum-line.dsc-cli-acc          =  0
     6393         bf_tt-allsum-line.slt-base-acc         =  0
     6394         bf_tt-allsum-line.slt-rubl-acc         =  0
     6395         bf_tt-allsum-line.slt-cli-acc          =  0
     6396         bf_tt-allsum-line.road-tax-base-acc    =  0
     6397         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     6398         bf_tt-allsum-line.road-tax-cli-acc     =  0
     6399         bf_tt-allsum-line.excise-base-acc      =  0
     6400         bf_tt-allsum-line.excise-rubl-acc      =  0
     6401         bf_tt-allsum-line.excise-cli-acc       =  0
     6402         bf_tt-allsum-line.transport-base-acc   =  0
     6403         bf_tt-allsum-line.transport-rubl-acc   =  0
     6404         bf_tt-allsum-line.transport-cli-acc    =  0
     6405         bf_tt-allsum-line.other-base-acc       =  0
     6406         bf_tt-allsum-line.other-rubl-acc       =  0
     6407         bf_tt-allsum-line.other-cli-acc        =  0
     6408         .
     6409       create bfs_tt-allsum-line.
     6410       assign
     6411       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     6412       if bf_trn-doc.doc-type = 'инв':U or
     6413          bf_trn-doc.doc-type = 'при':U    or
     6414          bf_trn-doc.doc-type = 'возврат':U    then do:
     6415          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     6416       end.
     6417       else do:
     6418         assign
     6419           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     6420           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     6421           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     6422           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     6423           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     6424           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     6425           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     6426           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     6427           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     6428           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     6429           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     6430           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     6431           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     6432           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     6433           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     6434           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     6435           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     6436           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     6437           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     6438           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     6439           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     6440           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     6441           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     6442           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     6443           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     6444           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     6445           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     6446           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     6447           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     6448           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     6449           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     6450           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     6451           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     6452           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     6453           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     6454           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     6455           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     6456           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     6457           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     6458           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     6459           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
