     1671             "Ошибка при блокировании функции переименования кода товара" skip
     1672             error-status :get-message(1) skip
     1673             return-value skip
     1674             view-as alert-box error .
     1675         end.
     1676         undo, return error return-value .
     1677       end.
     1678       for each buf_doc-list
     1679       by buf_doc-list.fact-order
     1680       on error undo, return error
     1681       :
     1682         find first stop-aht-restore-lock_btpr no-lock
     1683           where stop-aht-restore-lock_btpr.bp_type       = 'lock':U + 'rsts':U
     1684             and stop-aht-restore-lock_btpr.bp_status     = 'N':U
     1685             and stop-aht-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1686             and stop-aht-restore-lock_btpr.Key#_Two      = 0
     1687             and stop-aht-restore-lock_btpr.Key#_Three    = 0
     1688             and stop-aht-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1689             and stop-aht-restore-lock_btpr.CharKey_Two   = ""
     1690             and stop-aht-restore-lock_btpr.CharKey_Three = ""
     1691           no-error .
     1692         if available stop-aht-restore-lock_btpr
     1693         then do:
     1694           undo, return error "Процедура восстановления складского архива запросила остановку процедуры автоматического расчета складского архива" .
     1695         end.
     1696         find first stop-aht-news-lock_btpr no-lock
     1697           where stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
     1698             and stop-aht-news-lock_btpr.bp_status     = 'N':U
     1699             and stop-aht-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1700             and stop-aht-news-lock_btpr.Key#_Two      = 0
     1701             and stop-aht-news-lock_btpr.Key#_Three    = 0
     1702             and stop-aht-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1703             and stop-aht-news-lock_btpr.CharKey_Three = ""
     1704           no-error .
     1705         if available stop-aht-news-lock_btpr
     1706         then do:
     1707           undo, return error "Система новостей запросила остановку процедуры автоматического расчета складского архива" .
     1708         end.
     1709         if buf_doc-list.is-trn-doc
     1710         then do:
