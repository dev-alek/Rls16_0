        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type    as character no-undo .
        3   define input  parameter p-obj-code    as integer   no-undo .
        4   define input  parameter p-cut-date    as date      no-undo .
        5   define output parameter p-error-count as integer   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: inobaht.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/inobaht.p $":U .
       11   define variable vss-description as character no-undo init "Первоначальный расчет складского архива по типу приобретени ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   define stream ahtlog .
      308   define temp-table temp-aht-ot-tot no-undo like ub.aht-ot-tot .
      309   define temp-table temp-aht-ot-line no-undo like ub.aht-ot-line .
      310   define temp-table temp-aht-stk-tot no-undo like ub.aht-stk-tot .
      311   define temp-table temp-aht-stk-line no-undo like ub.aht-stk-line .
      312   procedure aht_get-sum-type :
      313     define input  parameter p-aht-type        as character no-undo .
      314     define output parameter p-allsum-sum-type as character no-undo .
      315     do
      316     on error undo, return error return-value
      317     :
      318       case p-aht-type :
      319         when 'r':U then do:
      320           assign
      321             p-allsum-sum-type = 'сумма_по_выкупу_со_знаком':U
      322           .
      323         end.
      324         when 'c':U then do:
      325           assign
      326             p-allsum-sum-type = 'сумма_по_консигнации_закупка_со_знаком':U
      327           .
      328         end.
      329         when 'b':U then do:
      330           assign
      331             p-allsum-sum-type = 'сумма_по_консигнации_выгода_со_знаком':U
      332           .
      333         end.
      334         when 's':U then do:
      335           assign
      336             p-allsum-sum-type = 'сумма_по_ответственному_хранению_со_знаком':U
      337           .
      338         end.
      339         when 'o':U then do:
      340           assign
      341             p-allsum-sum-type = 'сумма_по_старой_консигнации_со_знаком':U
      342           .
      343         end.
      344         when 'v':U then do:
      345           assign
      346             p-allsum-sum-type = 'сумма_по_услуге_со_знаком':U
      347           .
      348         end.
      349         otherwise do:
      350           message
      351             vss-workfile vss-revision vss-description skip
      352             vss-include-info1 skip
      353             "Неизвестное значение типа приобретения" skip
      354             "Тип приобретения" p-aht-type skip
      355             view-as alert-box error .
      356           undo, return error .
      357         end.
      358       end.
      359     end.
      360   end procedure.
      361   procedure aht_get-stk-sum-type :
      362     define input  parameter p-ot-sum-type      as character no-undo .
      363     define input  parameter p-ext-doc-type     as character no-undo .
      364     define output parameter p-stk-ext-sum-type as character no-undo .
      365     do
      366     on error undo, return error return-value
      367     :
      368       assign
      369         p-stk-ext-sum-type = p-ot-sum-type + p-ext-doc-type
      370       .
      371     end.
      372   end procedure.
      373   procedure aht_store-ot-line :
      374     define input  parameter p-doc-code       as character no-undo .
      375     define input  parameter p-gds-code       as integer   no-undo .
      376     define input  parameter p-sum-type       as character no-undo .
      377     define input  parameter p-ext-doc-type   as character no-undo .
      378     define input  parameter p-obj-type       as character no-undo .
      379     define input  parameter p-obj-code       as integer   no-undo .
      380     define input  parameter p-fact-order     as decimal   no-undo .
      381     define input  parameter p-fact-qnty      as decimal   no-undo .
      382             define input  parameter p-cost-sum-base       as decimal   no-undo .     define input  parameter p-cost-sum-rubl       as decimal   no-undo .     define input  parameter p-cost-vat-base       as decimal   no-undo .     define input  parameter p-cost-vat-rubl       as decimal   no-undo .     define input  parameter p-cost-slt-base       as decimal   no-undo .     define input  parameter p-cost-slt-rubl       as decimal   no-undo .     define input  parameter p-cost-road-tax-base  as decimal   no-undo .     define input  parameter p-cost-road-tax-rubl  as decimal   no-undo .     define input  parameter p-cost-excise-base    as decimal   no-undo .     define input  parameter p-cost-excise-rubl    as decimal   no-undo .     define input  parameter p-cost-transport-base as decimal   no-undo .     define input  parameter p-cost-transport-rubl as decimal   no-undo .     define input  parameter p-cost-other-base     as decimal   no-undo .     define input  parameter p-cost-other-rubl     as decimal   no-undo .     define input  parameter p-cost-discnt-base    as decimal   no-undo .     define input  parameter p-cost-discnt-rubl    as decimal   no-undo .
      383             define input  parameter p-crsa-sum-base       as decimal   no-undo .     define input  parameter p-crsa-sum-rubl       as decimal   no-undo .     define input  parameter p-crsa-vat-base       as decimal   no-undo .     define input  parameter p-crsa-vat-rubl       as decimal   no-undo .     define input  parameter p-crsa-slt-base       as decimal   no-undo .     define input  parameter p-crsa-slt-rubl       as decimal   no-undo .     define input  parameter p-crsa-road-tax-base  as decimal   no-undo .     define input  parameter p-crsa-road-tax-rubl  as decimal   no-undo .     define input  parameter p-crsa-excise-base    as decimal   no-undo .     define input  parameter p-crsa-excise-rubl    as decimal   no-undo .     define input  parameter p-crsa-transport-base as decimal   no-undo .     define input  parameter p-crsa-transport-rubl as decimal   no-undo .     define input  parameter p-crsa-other-base     as decimal   no-undo .     define input  parameter p-crsa-other-rubl     as decimal   no-undo .     define input  parameter p-crsa-discnt-base    as decimal   no-undo .     define input  parameter p-crsa-discnt-rubl    as decimal   no-undo .
      384             define input  parameter p-sale-sum-base       as decimal   no-undo .     define input  parameter p-sale-sum-rubl       as decimal   no-undo .     define input  parameter p-sale-vat-base       as decimal   no-undo .     define input  parameter p-sale-vat-rubl       as decimal   no-undo .     define input  parameter p-sale-slt-base       as decimal   no-undo .     define input  parameter p-sale-slt-rubl       as decimal   no-undo .     define input  parameter p-sale-road-tax-base  as decimal   no-undo .     define input  parameter p-sale-road-tax-rubl  as decimal   no-undo .     define input  parameter p-sale-excise-base    as decimal   no-undo .     define input  parameter p-sale-excise-rubl    as decimal   no-undo .     define input  parameter p-sale-transport-base as decimal   no-undo .     define input  parameter p-sale-transport-rubl as decimal   no-undo .     define input  parameter p-sale-other-base     as decimal   no-undo .     define input  parameter p-sale-other-rubl     as decimal   no-undo .     define input  parameter p-sale-discnt-base    as decimal   no-undo .     define input  parameter p-sale-discnt-rubl    as decimal   no-undo .
      385     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      386     do
      387     on error undo, return error return-value
      388     :
      389       find first buf_temp-aht-ot-line
      390         where buf_temp-aht-ot-line.doc-code  = p-doc-code
      391           and buf_temp-aht-ot-line.gds-code  = p-gds-code
      392           and buf_temp-aht-ot-line.sum-type  = p-sum-type
      393         no-error .
      394       if not available buf_temp-aht-ot-line then do:
      395         create buf_temp-aht-ot-line .
      396         assign
      397           buf_temp-aht-ot-line.doc-code     = p-doc-code
      398           buf_temp-aht-ot-line.gds-code     = p-gds-code
      399           buf_temp-aht-ot-line.sum-type     = p-sum-type
      400           buf_temp-aht-ot-line.ext-doc-type = p-ext-doc-type
      401           buf_temp-aht-ot-line.obj-type     = p-obj-type
      402           buf_temp-aht-ot-line.obj-code     = p-obj-code
      403           buf_temp-aht-ot-line.fact-order   = p-fact-order
      404         .
      405       end.
      406       assign
