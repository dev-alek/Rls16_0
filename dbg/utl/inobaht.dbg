     2880           view-as alert-box error .
     2881         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2882       end.
     2883       find first buf_goods no-lock
     2884         where buf_goods.artic     = buf_main_price-list.artic
     2885           and buf_goods.prod-type = buf_main_price-list.prod-type
     2886           and buf_goods.prod-code = buf_main_price-list.prod-code
     2887         no-error .
     2888       if not available buf_goods
     2889       then do:
     2890         message
     2891           vss-workfile vss-revision vss-description skip
     2892           vss-include-info8 skip
     2893           "Не найден товар" skip
     2894           "Переоценка" buf_main_price-list.doc-num skip
     2895           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2896           view-as alert-box error .
     2897         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
