     6697   procedure clcprtsl_calc-ttable :
     6698   define input parameter paris-doc           as   logical                 no-undo.
     6699   define input parameter paris-cur           as   logical                 no-undo.
     6700   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     6701   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     6702   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     6703   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     6704   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     6705   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     6706   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     6707   define input parameter parr-b              as   character               no-undo.
     6708   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     6709   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     6710   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     6711   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     6712   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     6713   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     6714   define buffer bf_tt-allsum      for tt-allsum.
     6715   define buffer bf_tt-clcparts    for tt-clcparts.
     6716   define buffer bf_tt-allsum-line for tt-allsum-line.
     6717   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6718   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6719   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6720   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6721   define variable varexcise          like ub.price-list.excise     no-undo.
     6722   do on error undo, return error return-value :
     6723   for each bf_tt-allsum-line
     6724   on error undo, return error return-value
     6725    :
     6726     delete bf_tt-allsum-line.
     6727   end.
     6728   for each bf_tt-allsum
     6729   on error undo, return error return-value
     6730   :
     6731     delete bf_tt-allsum.
     6732   end.
     6733   for each bf_tt-clcparts
     6734   on error undo, return error return-value
     6735   :
     6736   if v-calcbypart then do:
     6737             assign
     6738             parcur-base =   bf_tt-clcparts.part-cur-base
     6739             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     6740             parcur-excise =   bf_tt-clcparts.part-cur-excise
     6741             .
     6742   end.
     6743      run clcprtsl_calc-parts in this-procedure (
     6744        input recid(bf_tt-clcparts),
     6745        input paris-doc,
     6746        input paris-cur,
     6747        input parroad-tax,
     6748        input parexcise,
     6749        input parvat-pc,
     6750        input parcons-vat-pc,
     6751        input parslt-pc,
     6752        input parbase-rate,
     6753        input parbase-scale,
     6754        input parr-b,
     6755        input parcur-base,
     6756        input parcur-road-tax,
     6757        input parcur-excise,
     6758        input parcur-vat-pc,
     6759        input parcurcons-vat-pc,
     6760        input parcurslt-pc
     6761        ) no-error.
     6762     if error-status:error then do:
     6763       message
     6764         vss-workfile vss-revision vss-description skip
     6765         vss-include-info32 skip
     6766         "Ошибка при обсчете партии" skip
