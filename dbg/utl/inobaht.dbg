      579   procedure aht_store-stk-line :
      580     define parameter buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      581     define input  parameter p-stk-sum-type   as character no-undo .
      582     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
      583     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
