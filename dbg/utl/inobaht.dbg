     7791           ,input p-obj-code
     7792           ,input "### ВНИМАНИЕ !!! ### Были обнаружены ошибки в товарных количествах. Всего ошибочных товаров " + string(v-total-err)
     7793           ) .
     7794       end.
     7795       run log-information in this-procedure
     7796         (input p-obj-type
     7797         ,input p-obj-code
     7798         ,input "Инициализация завершена. Обработано товаров " + string(v-ind)
     7799         ) .
     7800       run utl/arhiscr.p
     7801         (input  p-obj-type
     7802         ,input  p-obj-code
