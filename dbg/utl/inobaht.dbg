      714             vss-include-info1 skip
      715             "При расчета складского архива по типам приобретения получено неопределенное значение" skip
      716             "Документ" buf_temp-aht-ot-line.doc-code skip
      717             "Код товара" buf_temp-aht-ot-line.gds-code skip
