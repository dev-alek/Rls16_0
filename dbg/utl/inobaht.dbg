     2741     :
     2742       find first buf_temp-prt-obj
     2743         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2744         no-error .
     2745       if not available buf_temp-prt-obj
     2746       then do:
     2747         create buf_temp-prt-obj .
     2748         assign
     2749           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2750           buf_temp-prt-obj.price-sale       = ?
     2751           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2752           buf_temp-prt-obj.price-list-qnty  = ?
     2753           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2754           buf_temp-prt-obj.price-list-recid = ?
     2755         .
     2756         find first buf_gds-prt no-lock
     2757           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2758           .
     2759         assign
     2760           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2761         .
     2762         if buf_temp-prt-obj.is-term
     2763         then do:
     2764           assign
     2765             buf_temp-prt-obj.price-sale = p-root-price-sale
     2766           .
     2767         end.
     2768       end.
     2769     end.
     2770   end procedure.
     2771   procedure prdoclib-temp-prt-obj-by-prt-root :
     2772     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2773     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2774     define buffer buf_gds-prt for ub.gds-prt .
     2775     do
     2776     on error undo, return error return-value
     2777     :
     2778       find first buf_temp-prt-obj
     2779         where buf_temp-prt-obj.prt-code = p-prt-code
     2780         no-error .
     2781       if not available buf_temp-prt-obj
     2782       then do:
     2783         create buf_temp-prt-obj .
     2784         assign
     2785           buf_temp-prt-obj.prt-code         = p-prt-code
     2786           buf_temp-prt-obj.price-sale       = ?
     2787           buf_temp-prt-obj.fact-qnty        = 0
     2788           buf_temp-prt-obj.price-list-qnty  = ?
     2789           buf_temp-prt-obj.prt-obj-recid    = ?
     2790           buf_temp-prt-obj.price-list-recid = ?
     2791         .
     2792         find first buf_gds-prt no-lock
     2793           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2794           .
     2795         assign
     2796           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2797         .
     2798         if buf_temp-prt-obj.is-term
     2799         then do:
     2800           assign
     2801             buf_temp-prt-obj.price-sale = 0
     2802           .
     2803         end.
     2804       end.
     2805     end.
     2806   end procedure.
     2807   procedure prdoclib-init-temp-prt-obj :
     2808     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2809     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2810     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2811     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2812     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2813     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2814     define buffer buf_prt-obj      for ub.prt-obj .
     2815     define buffer buf_temp-prt-obj for temp-prt-obj .
     2816     do
     2817     on error undo, return error return-value
     2818     :
     2819       run prdoclib-clear-temp-prt-obj in this-procedure .
     2820       for each buf_prt-obj
     2821         where buf_prt-obj.obj-type  = p-obj-type
     2822           and buf_prt-obj.obj-code  = p-obj-code
     2823           and buf_prt-obj.artic     = p-artic
     2824           and buf_prt-obj.prod-type = p-prod-type
     2825           and buf_prt-obj.prod-code = p-prod-code
     2826       on error undo, return error return-value
     2827       :
     2828         run prdoclib-create-temp-prt-obj in this-procedure
     2829           (input  p-root-price-sale
     2830           ,buffer buf_prt-obj
     2831           ,buffer buf_temp-prt-obj
     2832           ).
     2833       end.
     2834     end.
     2835   end procedure.
     2836   procedure prdoclib-calc-fact-sale :
     2837     define input  parameter p-price-list-recid   as recid     no-undo .
     2838     define output parameter p-fact-qnty          as decimal   no-undo .
     2839     define output parameter p-cur-base           as decimal   no-undo .
