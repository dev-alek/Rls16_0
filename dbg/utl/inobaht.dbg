     7255           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
     7256   end.
     7257   else do:
     7258     if vardoc-type = 'инв':U then do:
     7259       assign
     7260               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     7261               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     7262        .
     7263     end.
     7264     else do:
     7265       assign
     7266               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     7267               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     7268        .
     7269     end.
     7270   end.
     7271   assign
     7272   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
     7273   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     7274     end.
     7275   end procedure.
     7276   define stream slog .
     7277   define variable v-total-err       as integer   no-undo .
     7278   define variable v-log-file-name   as character no-undo .
     7279   define variable v-error-file-name as character no-undo .
     7280   define variable v-list-file-name  as character no-undo .
     7281   do
     7282   on error undo, return error return-value
     7283   :
     7284     assign
     7285       v-log-file-name   = substitute('inobaht_&1_&2.txt':U, p-obj-type, p-obj-code)
     7286       v-error-file-name = substitute('inobaht_&1_&2.err':U, p-obj-type, p-obj-code)
     7287       v-list-file-name  = substitute('inobaht_&1_&2_doc_list.txt':U, p-obj-type, p-obj-code)
     7288     .
     7289     define variable v-curr-r-b as character no-undo .
     7290   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7291   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7292     (output v-curr-r-b
     7293     )  .
     7294       define buffer lock_shift-obj for ub.shift-obj .
     7295       run factord-lock-shift in this-procedure
     7296         (input  p-obj-type
     7297         ,input  p-obj-code
     7298         ,input  p-cut-date
     7299         ,buffer lock_shift-obj
     7300         ) no-error .
     7301       if error-status :error
     7302       then do:
     7303         run log-information in this-procedure
     7304           (input p-obj-type
     7305           ,input p-obj-code
     7306           ,input substitute("Процесс остановлен:  &1" , return-value  )
     7307           ) .
     7308         run gbl/clntat-w.p
     7309           (input p-obj-type
     7310           ,input p-obj-code
     7311           ,input 'aht-del':U
     7312           ,input true
     7313           ) no-error .
     7314         run gbl/clntat-w.p
     7315           (input p-obj-type
     7316           ,input p-obj-code
     7317           ,input 'aht-calc':U
     7318           ,input true
     7319           ) no-error .
     7320           p-error-count = 1 .
     7321       end.
     7322       else do:
     7323             run process-object in this-procedure
     7324               (input  p-obj-type
     7325               ,input  p-obj-code
     7326               ,input  p-cut-date
     7327               ) .
     7328             assign
     7329               p-error-count = v-total-err
     7330             .
     7331     end.
     7332   end.
     7333   procedure process-object :
     7334     define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
     7335     define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
     7336     define input parameter p-cut-date as date      no-undo .
     7337     do
     7338     on error undo, return error return-value
     7339     :
     7340       define buffer calc-aht-lock_batchprocess for ub.batchprocess .
     7341       run gbl/lock-prc.p
     7342         (input 'ahtb':U
     7343         ,input p-obj-code
     7344         ,input 0
     7345         ,input 0
     7346         ,input p-obj-type
     7347         ,input ""
     7348         ,input ""
     7349         ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
     7350         ,input true
     7351         ,buffer calc-aht-lock_batchprocess
     7352         ) no-error .
     7353       if error-status :error
     7354       then do:
     7355         message
