     7150   end.
     7151   else do:
     7152     for each out-vatp_partsprl where out-vatp_partsprl.out-code   = vardoc-num
     7153                                  and out-vatp_partsprl.obj-type   = varobj-type
     7154                                  and out-vatp_partsprl.obj-code   = varobj-code
     7155                                  and out-vatp_partsprl.artic      = varartic
     7156                                  and out-vatp_partsprl.prod-type  = varprod-type
     7157                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     7158       if out-vatp_partsprl.purch-code = 2 then do:
     7159   assign
     7160     price-rubl-with-tax-locoprl = out-vatp_partsprl.price-rubl
     7161     price-base-with-tax-locoprl = out-vatp_partsprl.price-base
     7162   .
     7163   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7164   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7165     (output varinvprboprl
     7166     )  .
     7167     if out-vatp_partsprl.out-code = 'free-zone':U     or
     7168        out-vatp_partsprl.out-code = 'out-zone':U   or
     7169        out-vatp_partsprl.doc-type = 'акт':U then do:
     7170       assign
     7171         in-vatp-have-vat-sltoprl = yes.
     7172     end.
     7173     else do:
     7174       find first in-vatp_doc-attroprl no-lock
     7175         where in-vatp_doc-attroprl.doc-code  = out-vatp_partsprl.out-code
     7176           and in-vatp_doc-attroprl.attr-code = 'envd':U
     7177         no-error .
     7178       if not available in-vatp_doc-attroprl then do:
     7179         assign
