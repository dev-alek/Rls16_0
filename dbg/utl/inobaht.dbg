     2960           ,output price-base-with-tax-sale-prl
     2961           ,output price-rubl-without-tax-sale-prl
     2962           ,output price-base-without-tax-sale-prl
     2963           ,output vat-base-sale-prl
     2964           ,output vat-rubl-sale-prl
     2965           ,output vat-base-buyer-prl
     2966           ,output vat-rubl-buyer-prl
     2967           ,output slt-base-sale-prl
     2968           ,output slt-rubl-sale-prl
     2969           ,output road-tax-base-sale-prl
