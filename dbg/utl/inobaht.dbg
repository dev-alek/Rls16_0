      722         find first buf_aht-ot-line exclusive-lock
      723           where buf_aht-ot-line.doc-code  = buf_temp-aht-ot-line.doc-code
      724             and buf_aht-ot-line.gds-code  = buf_temp-aht-ot-line.gds-code
      725             and buf_aht-ot-line.sum-type  = buf_temp-aht-ot-line.sum-type
      726           no-error .
