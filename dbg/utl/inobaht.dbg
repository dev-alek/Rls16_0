     5982       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     5983       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     5984       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     5985       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
