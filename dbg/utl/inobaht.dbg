     6937       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     6938       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     6939       define variable varinvatp-envdoprl             as   character              no-undo.
     6940       define variable varinvatp-typeoprl             as   character              no-undo.
     6941     define buffer bf_price-list for ub.price-list.
     6942     define buffer bf_goods      for ub.goods.
     6943     define buffer bf_sysconf    for ub.sysconf.
     6944     define buffer bf_parts      for ub.parts.
     6945     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     6946     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     6947     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     6948     define variable varexcise      like ub.price-list.excise     no-undo.
     6949     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     6950     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     6951     define variable varprice-base  like ub.price-list.price-sale no-undo.
     6952     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     6953     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     6954     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     6955     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     6956     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     6957     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     6958     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     6959     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     6960     define variable varartic       like ub.price-list.artic      no-undo.
     6961     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     6962     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     6963     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     6964     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     6965     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     6966     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     6967     define variable vardoc-type     as   character              no-undo.
     6968     do
     6969     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     6970     :
     6971       find first bf_price-list no-lock
     6972         where recid(bf_price-list) = parrecid
     6973         no-error .
     6974       if not available bf_price-list
     6975       then do:
     6976         return error "Ошибка во входящих параметрах prl-vat.i" .
     6977       end.
     6978       find first bf_goods no-lock
     6979         where bf_goods.artic     = bf_price-list.artic
     6980           and bf_goods.prod-type = bf_price-list.prod-type
     6981           and bf_goods.prod-code = bf_price-list.prod-code
     6982         no-error .
     6983       if not available bf_goods
     6984       then do:
     6985         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     6986       end.
     6987       assign
     6988         varvat-pc = bf_price-list.vat-pc
     6989         varslt-pc = bf_price-list.slt-pc
     6990       .
     6991       if varvat-pc = ?
     6992       then do:
     6993         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     6994       end.
     6995       if varslt-pc = ?
     6996       then do:
     6997         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     6998       end.
     6999       assign
     7000         varbase-rate   = 1
     7001         varbase-scale  = 1
     7002         varroad-tax    = bf_price-list.road-tax
     7003         varexcise      = bf_price-list.excise
     7004         varprice-base  = bf_price-list.price-sale
     7005         varprice-rubl  = bf_price-list.price-sale
     7006         vardiscnt-base = 0
     7007         vardiscnt-rubl = 0
     7008       .
     7009       assign
     7010         varfact-qnty = 0
     7011       .
     7012       for each bf_parts no-lock
     7013         where bf_parts.out-code   = bf_price-list.doc-num
     7014           and bf_parts.obj-type   = bf_price-list.obj-type
     7015           and bf_parts.obj-code   = bf_price-list.obj-code
     7016           and bf_parts.artic      = bf_price-list.artic
     7017           and bf_parts.prod-type  = bf_price-list.prod-type
     7018           and bf_parts.prod-code  = bf_price-list.prod-code
     7019       :
     7020         assign
     7021           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     7022         .
     7023       end.
     7024       assign
     7025         vardoc-num   = bf_price-list.doc-num
     7026         vardoc-code  = bf_price-list.doc-num
     7027         varobj-type  = bf_price-list.obj-type
     7028         varobj-code  = bf_price-list.obj-code
     7029         varartic     = bf_price-list.artic
     7030         varprod-type = bf_price-list.prod-type
     7031         varprod-code = bf_price-list.prod-code
     7032         vardoc-qnty  = varfact-qnty
     7033         varext-doc-type = 'ot':U
     7034       .
     7035   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7036   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7037     (input  bf_price-list.obj-type
     7038     ,input  bf_price-list.obj-code
     7039     ,output v-host-code
     7040     )  .
     7041       find first bf_sysconf no-lock
     7042         where bf_sysconf.host-code = v-host-code
     7043         .
     7044       if bf_sysconf.cons-vat-pc = ?
     7045       then do:
     7046         return error "Не задан консигнационный НДС по фирме." .
     7047       end.
     7048       else do:
     7049         assign
     7050           varcons-vat-pc = bf_sysconf.cons-vat-pc
     7051         .
     7052       end.
     7053   if varext-doc-type = 'ot':U or
     7054      varext-doc-type = ?                 then do:
     7055     assign
     7056      out-vatp-have-vat-sltprl = yes.
     7057   end.
     7058   else do:
     7059     find first out-vatp_doc-attrprl no-lock
     7060       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     7061         and out-vatp_doc-attrprl.attr-code = 'envd':U
     7062         no-error .
     7063     if not available out-vatp_doc-attrprl then do:
     7064       assign
     7065         out-vatp-have-vat-sltprl = yes.
     7066     end.
     7067     else do:
     7068        out-vatp-have-vat-sltprl = no.
     7069     end.
     7070   end.
     7071   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
     7072                                      out-vatp_goodsprl.prod-type = varprod-type and
     7073                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
     7074   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7075   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     7076     (input  varartic
     7077     ,input  varprod-type
     7078     ,input  varprod-code
     7079     ,output varroot-nodeprl
     7080     ) no-error .
     7081   if error-status :error then do:
     7082     message
     7083       vss-workfile vss-revision vss-description skip
     7084       "Ошибка при определении корневого признака товара" skip
     7085       "Артикул" varartic varprod-type varprod-code skip
     7086       error-status :get-message(1) skip
     7087       return-value skip
     7088       view-as alert-box error .
     7089     undo, return error .
     7090   end.
     7091   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     7092     (input  varroot-nodeprl
     7093     ,input  'empty-scale=request'
     7094     ,output varempty-scaleprl
     7095     ) no-error .
     7096   if error-status :error then do:
     7097     message
     7098       vss-workfile vss-revision vss-description skip
     7099       "Ошибка при определении атрибута признака" skip
     7100       "Артикул" varartic varprod-type varprod-code skip
     7101       "Признак" varroot-nodeprl skip
     7102       "Запрашивался атрибут" "empty-scale=request" skip
     7103       error-status :get-message(1) skip
     7104       return-value skip
     7105       view-as alert-box error .
     7106     undo, return error .
     7107   end.
     7108   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7109   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7110     (output varoutvprbprl
     7111     )  .
     7112   if varoutvprbprl = "base":u then do:
     7113     assign
     7114           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     7115       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     7116     .
     7117   end.
     7118   else do:
     7119     assign
     7120           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     7121       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     7122     .
     7123   end.
     7124   if varoutvprbprl = "rubl":u then do:
     7125     assign
     7126           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     7127       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     7128   end.
     7129   else do:
     7130     assign
     7131           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     7132       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     7133   end.
     7134   assign
     7135     varis-cons-parts-haveprl =  no.
     7136   assign
     7137     varfact-qntyprl       = 0
     7138     varcons-qntyprl       = 0
     7139     varprice-base-consprl = 0
     7140     varprice-rubl-consprl = 0.
     7141   find first out-vatp_doc-lineprl where
     7142              out-vatp_doc-lineprl.doc-code   = vardoc-num
     7143          and out-vatp_doc-lineprl.artic      = varartic
     7144          and out-vatp_doc-lineprl.prod-type  = varprod-type
     7145          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     7146   if available out-vatp_doc-lineprl           and
     7147     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     7148     assign
