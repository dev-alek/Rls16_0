     5954       bfs_tt-allsum.slt-rubl-doc        =  - bf_tt-allsum.slt-rubl-doc
     5955       bfs_tt-allsum.road-tax-base-doc   =  - bf_tt-allsum.road-tax-base-doc
     5956       bfs_tt-allsum.road-tax-rubl-doc   =  - bf_tt-allsum.road-tax-rubl-doc
     5957       bfs_tt-allsum.excise-base-doc     =  - bf_tt-allsum.excise-base-doc
     5958       bfs_tt-allsum.excise-rubl-doc     =  - bf_tt-allsum.excise-rubl-doc
     5959       bfs_tt-allsum.sum-dsc-base-cur    =  - bf_tt-allsum.sum-dsc-base-cur
     5960       bfs_tt-allsum.sum-dsc-rubl-cur    =  - bf_tt-allsum.sum-dsc-rubl-cur
     5961       bfs_tt-allsum.dsc-base-cur        =  - bf_tt-allsum.dsc-base-cur
     5962       bfs_tt-allsum.dsc-rubl-cur        =  - bf_tt-allsum.dsc-rubl-cur
     5963       bfs_tt-allsum.vat-base-cur        =  - bf_tt-allsum.vat-base-cur
