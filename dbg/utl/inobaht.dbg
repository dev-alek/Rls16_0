     8406   procedure clear-tot :
     8407     define buffer buf_temp-aht-stk-tot for temp-aht-stk-tot .
     8408     do
     8409     on error undo, return error return-value
     8410     :
     8411       for each buf_temp-aht-stk-tot
     8412       on error undo, return error return-value
     8413       :
     8414         delete buf_temp-aht-stk-tot .
     8415       end.
     8416     end.
     8417   end procedure.
     8418   procedure store-tot :
     8419     define buffer buf_temp-aht-stk-tot for temp-aht-stk-tot .
     8420     define buffer buf_aht-stk-tot      for ub.aht-stk-tot .
     8421     do
     8422     on error undo, return error return-value
     8423     :
     8424       for each buf_temp-aht-stk-tot
     8425       on error undo, return error return-value
     8426       :
     8427         create buf_aht-stk-tot .
     8428         buffer-copy buf_temp-aht-stk-tot to buf_aht-stk-tot
     8429         .
     8430       end.
     8431     end.
     8432   end procedure.
     8433   procedure log-clear :
     8434     do
     8435     on error undo, return error return-value
     8436     :
     8437       output stream slog to value(v-log-file-name) .
     8438       output stream slog close .
     8439     end.
     8440   end procedure.
     8441   procedure log-information :
     8442     do
     8443     on error undo, return error return-value
     8444     :
     8445       define input parameter p-obj-type as character no-undo .
     8446       define input parameter p-obj-code as integer   no-undo .
     8447       define input parameter p-message  as character no-undo .
     8448       output stream slog to value(v-log-file-name) append .
     8449       export stream slog
     8450         p-obj-type
     8451         p-obj-code
     8452         cur-time-string()
     8453         p-message .
     8454       output stream slog close .
     8455     end.
     8456   end procedure.
     8457   procedure invalidate-md5-signature :
     8458     define input  parameter p-obj-type     as character no-undo .
     8459     define input  parameter p-obj-code     as integer   no-undo .
     8460     define input  parameter p-archive-type as character no-undo .
     8461     define input  parameter p-chip-num     as integer   no-undo .
     8462     define buffer buf_archive-history for ub.archive-history .
     8463     do
     8464     on error undo, return error return-value
     8465     :
     8466       for each buf_archive-history exclusive-lock
     8467         where buf_archive-history.obj-type     = p-obj-type
     8468           and buf_archive-history.obj-code     = p-obj-code
     8469           and buf_archive-history.archive-type = p-archive-type
     8470           and buf_archive-history.file-valid   = true
     8471       on error undo, return error return-value
     8472       :
     8473         assign
     8474           buf_archive-history.file-valid            = false
     8475           buf_archive-history.file-invalid-chip-num = p-chip-num
     8476         .
     8477       end.
     8478     end.
     8479   end procedure.
