      741   end procedure.
      742   procedure aht_add-document :
      743     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
      744     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
      745     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
      746     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
      747     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
      748     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
      749     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
      750     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
      751     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
      752     define buffer buf_aht-doc for ub.aht-doc .
      753     do
      754     on error undo, return error return-value
      755     :
      756       find first buf_aht-doc exclusive-lock
      757         where buf_aht-doc.doc-code = p-doc-code
      758         no-error .
      759       if available buf_aht-doc then do:
      760         message
      761           vss-workfile vss-revision vss-description skip
      762           vss-include-info1 skip
      763           "Попытка повторного создания записи" skip
      764           "Документ" p-doc-code skip
      765           view-as alert-box error .
      766         undo, return error .
      767       end.
      768       if p-fact-order = ?
      769       or p-fact-order = 0
      770       then do:
      771         message
      772           vss-workfile vss-revision vss-description skip
      773           vss-include-info1 skip
      774           "Ошибка задания входных параметров" skip
      775           "Не задан номер документа" skip
      776           "Документ" p-doc-code skip
      777           "Номер документа" p-fact-order skip
      778           view-as alert-box error .
      779         undo, return error .
      780       end.
      781       create buf_aht-doc .
      782       assign
      783         buf_aht-doc.doc-code     = p-doc-code
      784         buf_aht-doc.obj-type     = p-obj-type
      785         buf_aht-doc.obj-code     = p-obj-code
      786         buf_aht-doc.ext-doc-type = p-ext-doc-type
      787         buf_aht-doc.is-trn-doc   = p-is-trn-doc
      788         buf_aht-doc.fact-order   = p-fact-order
      789         buf_aht-doc.fact-date    = p-fact-date
      790         buf_aht-doc.shift-date   = p-shift-date
      791         buf_aht-doc.shift-num    = p-shift-num
      792       .
      793     end.
      794   end procedure.
      795   procedure aht_add-date :
      796     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
      797     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
      798     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
      799     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
      800     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
      801     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
      802     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
      803     define buffer buf_aht-stk for ub.aht-stk .
      804     do
      805     on error undo, return error return-value
      806     :
      807       find first buf_aht-stk no-lock
      808         where buf_aht-stk.obj-type   = p-obj-type
      809           and buf_aht-stk.obj-code   = p-obj-code
      810           and buf_aht-stk.stk-type   = p-stk-type
      811           and buf_aht-stk.fact-order = p-fact-order
      812         no-error .
      813       if not available buf_aht-stk then do:
      814         create buf_aht-stk .
      815         assign
      816           buf_aht-stk.obj-type   = p-obj-type
      817           buf_aht-stk.obj-code   = p-obj-code
      818           buf_aht-stk.stk-type   = p-stk-type
      819           buf_aht-stk.fact-order = p-fact-order
      820           buf_aht-stk.fact-date  = p-fact-date
      821           buf_aht-stk.shift-date = p-shift-date
      822           buf_aht-stk.shift-num  = p-shift-num
      823         .
      824       end.
      825     end.
      826   end procedure.
      827   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   procedure factord :
      829     define input  parameter p-fact-date            as date    no-undo .
      830     define input  parameter p-fact-time            as integer no-undo .
      831     define input  parameter p-fact-num             as integer no-undo .
      832     define input  parameter p-shift-date           as date    no-undo .
      833     define input  parameter p-shift-num            as integer no-undo .
      834     define input  parameter p-shift-on             as logical no-undo .
      835     define output parameter p-fact-order           as decimal no-undo .
      836     define output parameter p-shift-end-fact-order as decimal no-undo .
      837     define output parameter p-day-end-fact-order   as decimal no-undo .
      838     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      839     if p-fact-date = ?
      840     then do:
      841       return error "Не указана фактическая дата" .
      842     end.
      843     define variable v-fact-date-num as integer no-undo .
      844     assign
      845       v-fact-date-num = integer(p-fact-date)
      846     .
      847     if p-fact-num = ?
      848     or p-fact-num = 0
      849     then do:
      850       return error "Не задан p-fact-num " + string(p-fact-num) .
      851     end.
      852     if p-fact-num < 0
      853     then do:
      854       return error "Отрицательный fact-num " + string(p-fact-num) .
      855     end.
      856     if p-fact-num >= 100000000
      857     then do:
      858       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      859     end.
      860     if p-shift-on = true
      861     then do:
      862       if p-shift-date = ?
      863       then do:
      864         return error "Не задана дата смены" .
      865       end.
      866       if p-shift-num = ?
      867       or p-shift-num = 0
      868       then do:
      869         return error "Не задан номер смены" .
      870       end.
      871     end.
      872     else do:
      873       assign
      874         p-shift-date = p-fact-date
      875         p-shift-num  = 24
      876       .
      877     end.
      878     define variable v-shift-offset as integer no-undo .
      879     if p-shift-date = p-fact-date
      880     then do:
      881       assign
      882         v-shift-offset = 1
      883       .
      884     end.
      885     if p-shift-date < p-fact-date
      886     then do:
      887       assign
      888         v-shift-offset = 0
      889       .
      890     end.
      891     if p-shift-date > p-fact-date
      892     then do:
      893       message
      894         vss-workfile vss-revision vss-description skip
      895         "Неправильная дата закрытия смены" skip
      896         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      897         view-as alert-box error .
      898       undo, return error
      899         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      900           ,string(p-fact-date, '99/99/9999':U)
      901           ,string(p-shift-date, '99/99/9999':U)
      902           )
      903       .
      904     end.
      905     if p-shift-num < 1
      906     or p-shift-num > 24
      907     then do:
      908       message
      909         vss-workfile vss-revision vss-description skip
      910         "Неправильный номер смены" skip
      911         "p-shift-num" p-shift-num skip
      912         view-as alert-box error .
      913       undo, return error return-value .
      914     end.
      915     assign
      916       p-fact-order           = v-fact-date-num
      917                              + v-shift-offset * 0.5
      918                              + p-shift-num    * 0.02 - 0.01
      919                              + p-fact-num     * 0.0000000001
      920       p-shift-end-fact-order = v-fact-date-num
      921                              + v-shift-offset * 0.5
      922                              + p-shift-num    * 0.02
      923       p-day-end-fact-order   = v-fact-date-num
      924                              + 0.99
      925     .
      926     if p-fact-order           <= v-fact-date-num
      927     or p-shift-end-fact-order <= v-fact-date-num
      928     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      929     or p-shift-end-fact-order >= p-day-end-fact-order
      930     then do:
      931       message
      932         vss-workfile vss-revision vss-description skip
      933         "Внутренняя ошибка при генерации фактического номера" skip
      934         "p-fact-date"            p-fact-date            skip
      935         "p-fact-time"            p-fact-time            skip
      936         "p-fact-num"             p-fact-num             skip
      937         "p-shift-date"           p-shift-date           skip
      938         "p-shift-num"            p-shift-num            skip
      939         "p-shift-on"             p-shift-on             skip
      940         "p-shift-end-fact-order" p-shift-end-fact-order skip
      941         "p-day-end-fact-order"   p-day-end-fact-order   skip
      942         "v-fact-date-num"        v-fact-date-num        skip
      943         view-as alert-box error .
      944       undo, return error return-value .
      945     end.
      946   end procedure.
      947   procedure day-begin-fact-order :
      948     define input  parameter p-fact-date            as date    no-undo .
      949     define output parameter p-day-begin-fact-order as decimal no-undo .
      950     do
      951     on error undo, return error return-value
      952     :
      953       if p-fact-date = ?
      954       then do:
      955         assign
      956           p-day-begin-fact-order = 0
      957         .
      958       end.
      959       else do:
      960         assign
      961           p-day-begin-fact-order = integer(p-fact-date)
      962         .
      963       end.
      964     end.
      965   end procedure.
      966   procedure factord-max-fact-order :
      967     define output parameter p-max-fact-order as decimal   no-undo .
      968     do
      969     on error undo, return error return-value
      970     :
      971       run day-begin-fact-order in this-procedure
      972         (input  date(1, 1, 5000)
      973         ,output p-max-fact-order
      974         ) .
      975     end.
      976   end procedure.
      977   procedure factord-cut-archive :
      978     define input  parameter p-obj-type             as character no-undo .
      979     define input  parameter p-obj-code             as integer   no-undo .
      980     define input  parameter p-fact-date            as date      no-undo .
      981     define output parameter p-shift-on             as logical   no-undo .
      982     define output parameter p-shift-date           as date      no-undo .
      983     define output parameter p-shift-num            as integer   no-undo .
      984     define output parameter p-day-end-fact-order   as decimal   no-undo .
      985     define output parameter p-shift-end-fact-order as decimal   no-undo .
      986     define variable v-fact-order as decimal   no-undo .
      987     define buffer buf_shift-obj for ub.shift-obj .
      988     do
      989     on error undo, return error return-value
      990     :
      991   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      992   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      993     (input  p-obj-type
      994     ,input  p-obj-code
      995     ,input  'shift-on=request'
      996     ,output p-shift-on
      997     ) no-error .
      998       if error-status :error
      999       then do:
     1000         message
     1001           vss-workfile vss-revision vss-description skip
     1002           "Ошибка при определении атрибута объекта" skip
     1003           "Объект" p-obj-type p-obj-code skip
     1004           error-status :get-message(1) skip
     1005           return-value skip
     1006           view-as alert-box error .
     1007         undo, return error return-value .
     1008       end.
     1009       if p-shift-on = false
     1010       then do:
     1011         assign
     1012           p-shift-date               = ?
     1013           p-shift-num                = 0
     1014         .
     1015       end.
     1016       else do:
     1017         find first buf_shift-obj share-lock
     1018           where buf_shift-obj.obj-type   = p-obj-type
     1019             and buf_shift-obj.obj-code   = p-obj-code
     1020             and buf_shift-obj.shift-date > p-fact-date
     1021           use-index pi
     1022           no-error .
     1023         if not available buf_shift-obj
     1024         or buf_shift-obj.status_ <> 'зкр':U
     1025         then do:
     1026           message
     1027             vss-workfile vss-revision vss-description skip
     1028             "Невозможно вычислить последнюю смену" skip
     1029             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1030             "Объект" p-obj-type p-obj-code skip
     1031             "Дата" p-fact-date skip
     1032             view-as alert-box error .
     1033           undo, return error return-value .
     1034         end.
     1035         find last buf_shift-obj share-lock
     1036           where buf_shift-obj.obj-type = p-obj-type
     1037             and buf_shift-obj.obj-code = p-obj-code
     1038             and buf_shift-obj.shift-date <= p-fact-date
     1039           use-index pi
     1040           no-error .
     1041         if available buf_shift-obj
     1042         then do:
     1043           if  buf_shift-obj.status_ = 'зкр':U
     1044           then do:
     1045             assign
     1046               p-shift-date = buf_shift-obj.shift-date
     1047               p-shift-num  = buf_shift-obj.shift-num
     1048             .
     1049           end.
     1050           else do:
     1051             message
     1052               vss-workfile vss-revision vss-description skip
     1053               "Невозможно вычислить последнюю смену" skip
     1054               "Статус смены отличен от статуса" 'зкр':U skip
     1055               "Объект" p-obj-type p-obj-code skip
     1056               "Дата" p-fact-date skip
     1057               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1058               view-as alert-box error .
     1059             undo, return error return-value .
     1060           end.
     1061         end.
     1062         else do:
     1063           assign
     1064             p-shift-date = p-fact-date - 1
     1065             p-shift-num  = 1
     1066           .
     1067         end.
     1068       end.
     1069       run factord in this-procedure
     1070         (input  p-fact-date
     1071         ,input  1
     1072         ,input  1
     1073         ,input  p-shift-date
     1074         ,input  p-shift-num
     1075         ,input  p-shift-on
     1076         ,output v-fact-order
     1077         ,output p-shift-end-fact-order
     1078         ,output p-day-end-fact-order
     1079         ) no-error .
     1080       if error-status :error
     1081       then do:
     1082         message
     1083           vss-workfile vss-revision vss-description skip
     1084           "Ошибка при вызове процедуры factord"
     1085           error-status :get-message(1) skip
     1086           return-value skip
     1087           view-as alert-box error .
     1088         undo, return error return-value .
     1089       end.
     1090     end.
     1091   end procedure.
     1092   procedure factord-lock-shift :
     1093     define input  parameter p-obj-type  as character no-undo .
     1094     define input  parameter p-obj-code  as integer   no-undo .
     1095     define input  parameter p-fact-date as date      no-undo .
     1096     define parameter buffer buf_shift-obj for ub.shift-obj .
     1097     define variable v-shift-on      as logical   no-undo .
     1098     define variable v-extra-message as character no-undo .
     1099     define variable v-error as character no-undo .
     1100     do
     1101     on error undo, return error return-value
     1102     :
     1103   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1104   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1105     (input  p-obj-type
     1106     ,input  p-obj-code
     1107     ,input  'shift-on=request'
     1108     ,output v-shift-on
     1109     ) no-error .
     1110       if error-status :error
     1111       then do:
     1112         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1113         undo, return error v-error .
     1114       end.
     1115       if v-shift-on = true
     1116       then do:
     1117         find first buf_shift-obj share-lock
     1118           where buf_shift-obj.obj-type   = p-obj-type
     1119             and buf_shift-obj.obj-code   = p-obj-code
     1120             and buf_shift-obj.shift-date > p-fact-date
     1121           use-index pi
     1122           no-error .
     1123         if not available buf_shift-obj
     1124         or buf_shift-obj.status_ <> 'зкр':U
     1125         then do:
     1126           find last buf_shift-obj
     1127             where buf_shift-obj.obj-type = p-obj-type
     1128               and buf_shift-obj.obj-code = p-obj-code
     1129               and buf_shift-obj.status_  = 'зкр':U
     1130             use-index stts
     1131             no-error .
     1132           if available buf_shift-obj
     1133           then do:
     1134             assign
     1135               v-extra-message =
     1136                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1137                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1138                               )
     1139             .
     1140           end.
     1141           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1142           undo, return error v-error .
     1143         end.
     1144       end.
     1145     end.
     1146   end procedure.
     1147   procedure factord-end-day :
     1148     define input  parameter p-fact-date            as date    no-undo .
     1149     define output parameter p-day-end-fact-order   as decimal no-undo .
     1150     do
     1151     on error undo, return error return-value
     1152     :
     1153       if p-fact-date = ?
     1154       then do:
     1155         return error "Не указана фактическая дата" .
     1156       end.
     1157       assign
     1158         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1159       .
     1160     end.
     1161   end procedure.
     1162   procedure factord-to-date :
     1163     define input  parameter p-fact-order as decimal no-undo .
     1164     define output parameter p-fact-date  as date    no-undo .
     1165     define variable v-ref-date  as date      no-undo .
     1166     define variable v-ref-delta as integer   no-undo .
     1167     do
     1168     on error undo, return error return-value
     1169     :
     1170       if p-fact-order = ?
     1171       or p-fact-order = 0
     1172       then do:
     1173         return error "Не указан fact-order" .
     1174       end.
     1175       assign
     1176         v-ref-date  = date(1, 1, 2000)
     1177       .
     1178       assign
     1179         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1180       .
     1181       assign
     1182         p-fact-date = v-ref-date + v-ref-delta
     1183       .
     1184     end.
     1185   end procedure.
     1186   procedure factord-to-fact-num :
     1187     define input  parameter p-fact-order as decimal no-undo .
     1188     define output parameter p-fact-num   as integer no-undo .
     1189     define variable v-fact-order-trunc as decimal no-undo .
     1190     do
     1191     on error undo, return error return-value
     1192     :
     1193       if p-fact-order = ?
     1194       or p-fact-order = 0
     1195       then do:
     1196         return error "Не указан fact-order" .
     1197       end.
     1198       assign
     1199        v-fact-order-trunc = truncate(p-fact-order, 2)
     1200       .
     1201       assign
     1202         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1203       .
     1204     end.
     1205   end procedure.
     1206   procedure factord-to-shift-num :
     1207     define input  parameter p-fact-order as decimal no-undo .
     1208     define output parameter p-shift-num   as integer no-undo .
     1209     define variable  p-shift-numd  as decimal   no-undo .
     1210     define variable v-fact-order-trunc as decimal no-undo .
     1211     do
     1212     on error undo, return error return-value
     1213     :
     1214       if p-fact-order = ?
     1215       or p-fact-order = 0
     1216       then do:
     1217         return error "Не указан fact-order" .
     1218       end.
     1219       assign
     1220        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1221       .
     1222       if v-fact-order-trunc < 0.5 then do:
     1223         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1224       end.
     1225       assign
     1226         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1227         .
     1228        assign
     1229         p-shift-num = truncate (p-shift-numd , 0)
     1230       .
     1231     end.
     1232   end procedure.
     1233   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1234   define temp-table doc-list no-undo
     1235     field doc-code         like ub.trn-doc.doc-code
     1236     field obj-type         like ub.trn-doc.obj-type
     1237     field obj-code         like ub.trn-doc.obj-code
     1238     field fact-date        like ub.trn-doc.fact-date
     1239     field shift-date       like ub.trn-doc.shift-date
     1240     field shift-num        like ub.trn-doc.shift-num
     1241     field shift-name       like ub.trn-doc.shift-name
     1242     field fact-order       as decimal
     1243     field is-trn-doc       as logical
     1244     field doc-type         like ub.trn-doc.doc-type
     1245     field is-archive-exist as logical
     1246     index xpk is primary unique doc-code doc-type
     1247     index xfact-order fact-order
     1248     index xfact-date  fact-date
     1249     .
     1250   define temp-table doclslib-goods no-undo
     1251     field gds-code  as integer
     1252     field artic     as character
     1253     field prod-type as character
     1254     field prod-code as integer
     1255     index xpk is primary unique gds-code
     1256     index xie1 artic prod-type prod-code
     1257     .
     1258   define buffer inkas_trn-doc for ub.trn-doc .
     1259   define stream doclsliblog .
     1260   procedure doclslib-clear-doc-list :
     1261     define buffer buf_doc-list for doc-list .
     1262     do
     1263     on error undo, return error
     1264     :
     1265       for each buf_doc-list
     1266       on error undo, return error
     1267       :
     1268         delete buf_doc-list .
     1269       end.
     1270     end.
     1271   end procedure.
     1272   procedure doclslib-init-trn-doc :
     1273     define input parameter p-obj-type      as character no-undo .
     1274     define input parameter p-obj-code      as integer   no-undo .
     1275     define input parameter p-cut-date      as date      no-undo .
     1276     define buffer buf_trn-doc for ub.trn-doc .
     1277     define buffer buf_doc-list for doc-list .
     1278     do
     1279     on error undo, return error
     1280     :
     1281       if p-cut-date = ?
     1282       then do:
     1283         for each buf_trn-doc no-lock
     1284           where buf_trn-doc.obj-type = p-obj-type
     1285             and buf_trn-doc.obj-code = p-obj-code
     1286             and buf_trn-doc.status_  = 'факт':U
     1287         on error undo, return error
     1288         :
     1289           create buf_doc-list .
     1290           assign
     1291             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1292             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1293             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1294             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1295             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1296             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1297             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1298             buf_doc-list.is-trn-doc = true
     1299           .
     1300         end.
     1301       end.
     1302       else do:
     1303         for each buf_trn-doc no-lock
     1304           where buf_trn-doc.obj-type  = p-obj-type
     1305             and buf_trn-doc.obj-code  = p-obj-code
     1306             and buf_trn-doc.status_   = 'факт':U
     1307             and buf_trn-doc.fact-date >= p-cut-date
     1308         on error undo, return error
     1309         :
     1310           create buf_doc-list .
     1311           assign
     1312             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1313             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1314             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1315             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1316             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1317             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1318             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1319             buf_doc-list.is-trn-doc = true
     1320           .
     1321         end.
     1322       end.
     1323     end.
     1324   end procedure.
     1325   procedure doclslib-init-price-doc :
     1326     define input parameter p-obj-type      as character no-undo .
     1327     define input parameter p-obj-code      as integer   no-undo .
     1328     define input parameter p-cut-date      as date      no-undo .
     1329     define buffer buf_price-doc for ub.price-doc .
     1330     define buffer buf_doc-list for doc-list .
     1331     do
     1332     on error undo, return error
