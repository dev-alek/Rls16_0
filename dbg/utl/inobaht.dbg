     3161                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     3162               p-cur-VAT-base      = p-cur-VAT-base
     3163                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     3164               p-cur-SLT-base      = p-cur-SLT-base
     3165                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     3166               p-cur-road-tax-base = p-cur-road-tax-base
     3167                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     3168               p-cur-excise-base   = p-cur-excise-base
     3169                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     3170             .
     3171           end.
     3172           else do:
     3173             assign
     3174               p-fact-qnty         = p-fact-qnty
     3175                                   + buf_price-list.doc-qnty
     3176               p-cur-base          = p-cur-base
     3177                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     3178               p-cur-VAT-base      = p-cur-VAT-base
     3179                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     3180               p-cur-SLT-base      = p-cur-SLT-base
     3181                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     3182               p-cur-road-tax-base = p-cur-road-tax-base
     3183                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     3184               p-cur-excise-base   = p-cur-excise-base
     3185                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     3186             .
     3187           end.
     3188         end.
     3189     end.
     3190   end procedure.
     3191   procedure prdoclib-calc-prc :
     3192     define input  parameter p-price-doc-recid as   recid                  no-undo.
     3193     define input  parameter p-cons-pay        as   integer                no-undo.
     3194     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     3195     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     3196     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     3197     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     3198     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     3199     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     3200     do
     3201     on error undo, return error return-value
     3202     :
     3203       define buffer buf_price-doc       for ub.price-doc .
     3204       define buffer buf_price-list      for ub.price-list .
     3205       define buffer buf_parts           for ub.parts .
     3206       define variable v-ov-qnty     as decimal   no-undo .
     3207       define variable v-ov-base     as decimal   no-undo .
     3208       define variable v-ov-VAT-base as decimal   no-undo .
     3209       define variable v-ov-SLT-base as decimal   no-undo .
     3210       define variable v-cons-qnty   as decimal   no-undo .
     3211       define variable v-prch-qnty   as decimal   no-undo .
     3212       define variable v-cons-mult   as decimal   no-undo .
     3213       define variable v-prch-mult   as decimal   no-undo .
     3214       find first buf_price-doc no-lock
     3215         where recid(buf_price-doc) = p-price-doc-recid
     3216         no-error .
     3217       if not available buf_price-doc
     3218       then do:
     3219         message
     3220           vss-workfile vss-revision vss-description skip
     3221           vss-include-info8 skip
     3222           "Ошибка задания входных параметров" skip
     3223           "Не найден документ переоценки" skip
     3224           "Код записи (recid)" p-price-doc-recid skip
     3225           view-as alert-box error .
     3226         undo, return error .
     3227       end.
     3228       for each buf_price-list no-lock
     3229         where buf_price-list.doc-num    = buf_price-doc.doc-num
     3230           and buf_price-list.main-price = true
     3231       on error undo, return error return-value
     3232       :
     3233         run prdoclib-calc-ov
     3234           (input recid(buf_price-list)
     3235           ,output v-ov-qnty
     3236           ,output v-ov-base
     3237           ,output v-ov-VAT-base
     3238           ,output v-ov-SLT-base
     3239           ) no-error .
     3240         if error-status :error
     3241         then do:
     3242           if error-status :get-message(1) <> ""
     3243           then do:
     3244             message
     3245               vss-workfile vss-revision vss-description skip
     3246               vss-include-info8 skip
     3247               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     3248               error-status :get-message(1) skip
     3249               return-value skip
     3250               view-as alert-box error .
     3251           end.
     3252           undo, return error return-value .
     3253         end.
     3254         assign
     3255           v-cons-qnty = 0
     3256           v-prch-qnty = 0
     3257         .
     3258         for each buf_parts no-lock
     3259           where buf_parts.out-code  = buf_price-list.doc-num
     3260             and buf_parts.obj-type  = buf_price-list.obj-type
     3261             and buf_parts.obj-code  = buf_price-list.obj-code
     3262             and buf_parts.artic     = buf_price-list.artic
     3263             and buf_parts.prod-type = buf_price-list.prod-type
     3264             and buf_parts.prod-code = buf_price-list.prod-code
     3265         on error undo, return error return-value
     3266         :
     3267           if buf_parts.pay-code = p-cons-pay
     3268           then do:
     3269             assign
     3270               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     3271             .
     3272           end.
     3273           else do:
     3274             assign
     3275               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     3276             .
     3277           end.
     3278         end.
     3279         if (v-cons-qnty + v-prch-qnty) = 0
     3280         then do:
     3281           assign
     3282             v-cons-mult = 0
     3283             v-prch-mult = 1
     3284           .
     3285         end.
     3286         else do:
     3287           assign
     3288             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     3289             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     3290           .
     3291         end.
     3292         assign
     3293           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     3294           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     3295           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     3296           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     3297           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     3298           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     3299         .
     3300       end.
     3301     end.
     3302   end procedure.
     3303   procedure prdoclib-calc-ov :
     3304     define input  parameter p-price-list-recid as recid     no-undo .
     3305     define output parameter p-fact-qnty        as decimal   no-undo .
     3306     define output parameter p-ov-base          as decimal   no-undo .
     3307     define output parameter p-ov-VAT-base      as decimal   no-undo .
     3308     define output parameter p-ov-SLT-base      as decimal   no-undo .
     3309     do
     3310     on error undo, return error return-value
     3311     :
     3312       define buffer buf_main_price-list    for ub.price-list .
     3313       define buffer buf_prev_price-list    for ub.price-list .
     3314       define buffer buf_special_price-list for ub.price-list .
     3315       define buffer buf_goods              for ub.goods .
     3316       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     3317       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     3318       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     3319       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     3320       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     3321       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     3322       define variable v-prev-price-list-recid as   recid                  no-undo.
     3323       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     3324       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     3325       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     3326       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     3327       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     3328       find first buf_main_price-list no-lock
     3329         where recid(buf_main_price-list) = p-price-list-recid
     3330         no-error .
     3331       if not available buf_main_price-list
     3332       then do:
     3333         message
     3334           vss-workfile vss-revision vss-description skip
     3335           vss-include-info8 skip
     3336           "Ошибка задания входных параметров" skip
     3337           "Не найдена строка переоценки" skip
     3338           "Код записи (recid)" p-price-list-recid skip
     3339           view-as alert-box error .
     3340         undo, return error .
     3341       end.
     3342       if buf_main_price-list.main-price <> true
     3343       then do:
     3344         message
     3345           vss-workfile vss-revision vss-description skip
     3346           vss-include-info8 skip
     3347           "Ошибка задания входных параметров" skip
     3348           "Строка переоценки не является основной" skip
     3349           "Код записи (recid)" p-price-list-recid skip
     3350           "Переоценка" buf_main_price-list.doc-num skip
     3351           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3352           "Бар-код" buf_main_price-list.b-code skip
     3353           view-as alert-box error .
     3354         undo, return error .
     3355       end.
     3356       run prdoclib-calc-fact-sale in this-procedure
     3357         (input  recid(buf_main_price-list)
     3358         ,output v-fact-qnty
     3359         ,output v-cur-base
     3360         ,output v-cur-VAT-base
     3361         ,output v-cur-SLT-base
     3362         ,output v-cur-road-tax-base
     3363         ,output v-cur-excise-base
     3364         ) no-error.
     3365       if error-status :error
     3366       then do:
     3367         message
     3368           vss-workfile vss-revision vss-description skip
     3369           vss-include-info8 skip
     3370           "Ошибка при расчете сумм переоценки." skip
     3371           "Документ переоценки" buf_main_price-list.doc-num skip
     3372           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3373           error-status :get-message(1) skip
     3374           return-value skip
     3375           view-as alert-box error .
     3376         undo, return error .
     3377       end.
     3378   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3380     (input  buf_main_price-list.obj-type
     3381     ,input  buf_main_price-list.obj-code
     3382     ,input  buf_main_price-list.b-code
     3383     ,input  buf_main_price-list.b-code
     3384     ,input  buf_main_price-list.fact-order
     3385     ,output v-prev-price-list-recid
     3386     ,output v-prev-cli-base-rate
     3387     ) no-error .
     3388       if error-status :error
     3389       then do:
     3390         message
     3391           vss-workfile vss-revision vss-description skip
     3392           vss-include-info8 skip
     3393           "Ошибка при поиске предыдущей переоценки." skip
     3394           "Документ переоценки " buf_main_price-list.doc-num skip
     3395           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3396           error-status :get-message(1) skip
     3397           return-value skip
     3398           view-as alert-box error .
     3399         undo, return error .
     3400       end.
     3401       if v-prev-price-list-recid <> ?
     3402       then do:
     3403         find first buf_prev_price-list no-lock
     3404           where recid(buf_prev_price-list) = v-prev-price-list-recid
     3405           .
     3406         find first buf_special_price-list no-lock
     3407           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     3408             and buf_special_price-list.main-price = false
     3409             and buf_special_price-list.artic      = buf_prev_price-list.artic
     3410             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     3411             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     3412             and buf_special_price-list.doc-qnty   <> ?
     3413           no-error .
     3414         if available buf_special_price-list
     3415         then do:
     3416           message
     3417             "Товар имеет специальные цены на признаки" skip
     3418             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3419             "Переоценка" buf_prev_price-list.doc-num skip
     3420             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3421             view-as alert-box error .
     3422           undo, return error .
     3423         end.
     3424         find first buf_goods no-lock
     3425           where buf_goods.artic     = buf_main_price-list.artic
     3426             and buf_goods.prod-type = buf_main_price-list.prod-type
     3427             and buf_goods.prod-code = buf_main_price-list.prod-code
     3428           no-error .
     3429         if not available buf_goods
     3430         then do:
     3431           message
     3432             vss-workfile vss-revision vss-description skip
     3433             vss-include-info8 skip
     3434             "Не найден товар" skip
     3435             "Переоценка" buf_main_price-list.doc-num skip
     3436             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3437             view-as alert-box error .
     3438           undo, return error .
     3439         end.
     3440         if buf_prev_price-list.vat-pc = ?
     3441         or buf_prev_price-list.slt-pc = ?
     3442         then do:
     3443           message
     3444             "В переоценке не заданы налоги товара" skip
     3445             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3446             "Переоценка" buf_prev_price-list.doc-num skip
     3447             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3448             "НДС" buf_prev_price-list.vat-pc skip
     3449             "НП" buf_prev_price-list.slt-pc skip
     3450             view-as alert-box error .
     3451           undo, return error return-value .
     3452         end.
     3453         define variable v-prev-cur-SLT-pc as decimal no-undo .
     3454         assign
     3455           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     3456         .
     3457         assign
     3458           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     3459           v-prev-cur-VAT-base = v-fact-qnty
     3460                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     3461                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     3462           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     3463         .
     3464         assign
     3465           p-fact-qnty   = v-fact-qnty
     3466           p-ov-base     = v-cur-base     - v-prev-cur-base
     3467           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3468           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3469         .
     3470       end.
     3471       else do:
     3472         assign
     3473           v-prev-cur-base     = 0
     3474           v-prev-cur-VAT-base = 0
     3475           v-prev-cur-SLT-base = 0
     3476           .
     3477         assign
     3478           p-fact-qnty   = v-fact-qnty
     3479           p-ov-base     = v-cur-base     - v-prev-cur-base
     3480           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3481           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3482         .
     3483       end.
     3484     end.
     3485   end procedure.
     3486   procedure prdoclib-init-prt-obj-by-factord :
     3487     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3488     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3489     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3490     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3491     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3492     define input parameter p-fact-order         as decimal   no-undo .
     3493     define input parameter p-include-fact-order as logical   no-undo .
     3494     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3495     define buffer buf_gds-obj      for ub.gds-obj .
     3496     define buffer buf_doc-line     for ub.doc-line .
     3497     define buffer buf_temp-prt-obj for temp-prt-obj .
     3498     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3499     do
     3500     on error undo, return error return-value
     3501     :
     3502       do transaction
     3503       on error undo, return error return-value
     3504       :
     3505   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3507     (input  p-obj-type
     3508     ,input  p-obj-code
     3509     ,input  p-artic
     3510     ,input  p-prod-type
     3511     ,input  p-prod-code
     3512     ,buffer buf_gds-obj
     3513     ) no-error .
     3514         if error-status :error
     3515         then do:
     3516           message
     3517             vss-workfile vss-revision vss-description skip
     3518             vss-include-info8 skip
     3519             "Невозможно найти gds-obj" skip
     3520             error-status :get-message(1) skip
     3521             return-value skip
     3522             view-as alert-box error .
     3523           undo, return error .
     3524         end.
     3525         find current buf_gds-obj exclusive-lock .
     3526       end.
     3527       run prdoclib-init-temp-prt-obj in this-procedure
     3528         (input p-obj-type
     3529         ,input p-obj-code
     3530         ,input p-artic
     3531         ,input p-prod-type
     3532         ,input p-prod-code
     3533         ,input 0
     3534         ) .
     3535       for each buf_temp-prt-obj
     3536         where buf_temp-prt-obj.is-term <> true
     3537       on error undo, return error return-value
     3538       :
     3539         delete buf_temp-prt-obj .
     3540       end.
     3541       if p-include-fact-order = true
     3542       then do:
     3543         assign
     3544          p-fact-order = p-fact-order - 0.0000000001
     3545         .
     3546       end.
     3547       for each buf_doc-line no-lock
     3548         where buf_doc-line.obj-type   = p-obj-type
     3549           and buf_doc-line.obj-code   = p-obj-code
     3550           and buf_doc-line.artic      = p-artic
     3551           and buf_doc-line.prod-type  = p-prod-type
     3552           and buf_doc-line.prod-code  = p-prod-code
     3553           and buf_doc-line.status_    = 'факт':U
     3554           and buf_doc-line.fact-order >= p-fact-order
     3555       on error undo, return error return-value
     3556       :
     3557         run prdoclib-process-document in this-procedure
     3558           (input  buf_doc-line.doc-code
     3559           ,input  p-obj-type
     3560           ,input  p-obj-code
     3561           ,input  p-artic
     3562           ,input  p-prod-type
     3563           ,input  p-prod-code
     3564           ,output v-total-gds-dtl-qnty
     3565           ) .
     3566       end.
     3567     end.
     3568   end procedure.
     3569   procedure prdoclib-process-document :
     3570     define input  parameter p-doc-code           as character no-undo .
     3571     define input  parameter p-obj-type           as character no-undo .
     3572     define input  parameter p-obj-code           as integer   no-undo .
     3573     define input  parameter p-artic              as character no-undo .
     3574     define input  parameter p-prod-type          as character no-undo .
     3575     define input  parameter p-prod-code          as integer   no-undo .
     3576     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3577     define buffer buf_trn-doc      for ub.trn-doc .
     3578     define buffer buf_gds-dtl      for ub.gds-dtl .
     3579     define buffer buf_temp-prt-obj for temp-prt-obj .
     3580     do
     3581     on error undo, return error return-value
     3582     :
     3583       find first buf_trn-doc no-lock
     3584         where buf_trn-doc.doc-code = p-doc-code
     3585         no-error .
     3586       if not available buf_trn-doc then do:
     3587         message
     3588           vss-workfile vss-revision vss-description skip
     3589           vss-include-info8 skip
     3590           "Ошибка при поиске документа" skip
     3591           "Документ" p-doc-code skip
     3592           "Объект" p-obj-type p-obj-code skip
     3593           "Артикул" p-artic p-prod-type p-prod-code skip
     3594           view-as alert-box error .
     3595         undo, return error .
     3596       end.
     3597       assign
     3598         p-total-gds-dtl-qnty = 0
     3599       .
     3600       for each buf_gds-dtl no-lock
     3601         where buf_gds-dtl.doc-code  = p-doc-code
     3602           and buf_gds-dtl.artic     = p-artic
     3603           and buf_gds-dtl.prod-type = p-prod-type
     3604           and buf_gds-dtl.prod-code = p-prod-code
     3605       on error undo, return error
     3606       :
     3607         define variable v-term-node as integer   no-undo .
     3608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3609     (input  buf_gds-dtl.prt-code
     3610     ,output v-term-node
     3611     )  .
     3612         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3613           (input  v-term-node
     3614           ,buffer buf_temp-prt-obj
     3615           ) .
     3616         if buf_temp-prt-obj.is-term <> true then do:
     3617           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3618                                        ,buf_gds-dtl.prt-code
     3619                                        ) .
     3620         end.
     3621         case buf_trn-doc.doc-type :
     3622           when 'при':U or
     3623           when 'возврат':U
     3624           then do:
     3625             assign
     3626               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3627                                           - buf_gds-dtl.fact-qnty
     3628               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3629                                           - buf_gds-dtl.fact-qnty
     3630             .
     3631           end.
     3632           when 'рас':U or
     3633           when 'спи':U
     3634           then do:
     3635             assign
     3636               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3637                                           + buf_gds-dtl.fact-qnty
     3638               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3639                                           + buf_gds-dtl.fact-qnty
     3640             .
     3641           end.
     3642           when 'инв':U
     3643           then do:
     3644             assign
     3645               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3646                                           - buf_gds-dtl.doc-qnty
     3647               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3648                                           - buf_gds-dtl.doc-qnty
     3649             .
     3650           end.
     3651           otherwise do:
     3652             undo, return error substitute("Неизвестный тип документа &1"
     3653                                          ,buf_trn-doc.doc-type
     3654                                          ) .
     3655           end.
     3656         end.
     3657       end.
     3658     end.
     3659   end procedure.
     3660   procedure prdoclib-prc-pl-document :
     3661     define input  parameter p-doc-code              as character no-undo .
     3662     define input  parameter p-obj-type              as character no-undo .
     3663     define input  parameter p-obj-code              as integer   no-undo .
     3664     define input  parameter p-gds-code              as integer   no-undo .
     3665     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3666     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3667     do
     3668     on error undo, return error return-value
     3669     :
     3670       define buffer buf_trn-doc      for ub.trn-doc .
     3671       define buffer buf_doc-pl       for ub.doc-pl .
     3672       define buffer buf_temp-pl-gds for temp-pl-gds .
     3673       define variable v-sign as decimal   no-undo .
     3674       find first buf_trn-doc no-lock
     3675         where buf_trn-doc.doc-code = p-doc-code
     3676         no-error .
     3677       if not available buf_trn-doc then do:
     3678         message
     3679           vss-workfile vss-revision vss-description skip
     3680           vss-include-info8 skip
     3681           "Ошибка при поиске документа" skip
     3682           "Документ" p-doc-code skip
     3683           "Объект" p-obj-type p-obj-code skip
     3684           "Товар" p-gds-code skip
     3685           view-as alert-box error .
     3686         undo, return error .
     3687       end.
     3688       assign
     3689         p-total-pl-gds-qnty     = 0
     3690         p-total-pl-gds-cli-qnty = 0
     3691       .
     3692       for each buf_doc-pl no-lock
     3693         where buf_doc-pl.out-code  = p-doc-code
     3694           and buf_doc-pl.gds-code  = p-gds-code
     3695       on error undo, return error return-value
     3696       :
     3697         find first buf_temp-pl-gds
     3698           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3699             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3700             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3701           .
     3702         case buf_trn-doc.doc-type :
     3703           when 'при':U
     3704           or when 'возврат':U
     3705           or when 'инв':U
     3706           then do:
     3707             assign
     3708               v-sign = -1.0
     3709             .
     3710           end.
     3711           when 'рас':U or
     3712           when 'спи':U
     3713           then do:
     3714             assign
     3715               v-sign = 1.0
     3716             .
     3717           end.
     3718           otherwise do:
     3719             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3720           end.
     3721         end case.
     3722         assign
     3723           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3724           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3725           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3726           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3727         .
     3728       end.
     3729     end.
     3730   end procedure.
     3731   procedure prdoclib-init-prt-obj-by-date :
     3732     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3733     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3734     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3735     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3736     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3737     define input parameter p-fact-date  as date      no-undo .
     3738     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3739     do
     3740     on error undo, return error return-value
     3741     :
     3742       define variable v-fact-order                as decimal   no-undo .
     3743       define variable v-shift-end-fact-order      as decimal   no-undo .
     3744       define variable v-day-end-fact-order        as decimal   no-undo .
     3745       run factord in this-procedure
     3746         (input  p-fact-date
     3747         ,input  1
     3748         ,input  1
     3749         ,input  ?
     3750         ,input  0
     3751         ,input  false
     3752         ,output v-fact-order
     3753         ,output v-shift-end-fact-order
     3754         ,output v-day-end-fact-order
     3755         ) no-error .
     3756       if error-status :error
     3757       then do:
     3758         message
     3759           vss-workfile vss-revision vss-description skip
     3760           vss-include-info8 skip
     3761           "Ошибка при определении момента времени, на который требуется остаток" skip
     3762           "Объект" p-obj-type p-obj-code skip
     3763           "Артикул" p-artic p-prod-type p-prod-code skip
     3764           "Дата" p-fact-date skip
     3765           view-as alert-box error .
     3766         undo, return error .
     3767       end.
     3768       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3769         (input p-obj-type
     3770         ,input p-obj-code
     3771         ,input p-artic
     3772         ,input p-prod-type
     3773         ,input p-prod-code
     3774         ,input v-day-end-fact-order
     3775         ,input false
     3776         ) no-error .
     3777       if error-status :error
     3778       then do:
     3779         message
     3780           vss-workfile vss-revision vss-description skip
     3781           vss-include-info8 skip
     3782           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3783           "Объект" p-obj-type p-obj-code skip
     3784           "Артикул" p-artic p-prod-type p-prod-code skip
     3785           "Дата" p-fact-date skip
     3786           view-as alert-box error .
     3787         undo, return error .
     3788       end.
     3789     end.
     3790   end procedure.
     3791   procedure prdoclib-calc-temp-fact-sale :
     3792     define input  parameter p-obj-type           as character no-undo .
     3793     define input  parameter p-obj-code           as integer   no-undo .
     3794     define input  parameter p-gds-code           as integer   no-undo .
     3795     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3796     define input  parameter p-curr-r-b           as character no-undo .
     3797     define output parameter p-fact-qnty          as decimal   no-undo .
     3798     define output parameter p-cur-base           as decimal   no-undo .
     3799     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3800     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3801     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3802     define output parameter p-cur-excise-base    as decimal   no-undo .
     3803     define buffer buf_temp-prt-obj for temp-prt-obj .
     3804     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3805     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3806     define variable parrecid-prl        as recid     no-undo .
     3807     define variable v-fact-qnty         as decimal   no-undo .
     3808     define variable v-cur-base          as decimal   no-undo .
     3809     define variable v-cur-VAT-base      as decimal   no-undo .
     3810     define variable v-cur-SLT-base      as decimal   no-undo .
     3811     define variable v-cur-road-tax-base as decimal   no-undo .
     3812     define variable v-cur-excise-base   as decimal   no-undo .
     3813     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3814     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3815     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3816     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3817     define variable vat-base-sale-prl               as decimal   no-undo .
     3818     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3819     define variable vat-base-buyer-prl              as decimal   no-undo .
     3820     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3821     define variable slt-base-sale-prl               as decimal   no-undo .
     3822     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3823     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3824     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3825     define variable excise-base-sale-prl            as decimal   no-undo .
     3826     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3827     define variable discnt-base-sale-prl            as decimal   no-undo .
     3828     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3829     do
     3830     on error undo, return error return-value
     3831     :
     3832       for each buf_temp-prt-obj no-lock
     3833       on error undo, return error return-value
     3834       :
     3835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3836     (input  p-gds-code
     3837     ,input  buf_temp-prt-obj.prt-code
     3838     ,output v-prt-b-code
     3839     ) no-error .
     3840         if error-status :error
     3841         then do:
     3842           message
     3843             vss-workfile vss-revision vss-description skip
     3844             "Ошибка при определении бар-кода признака" skip
     3845             "Код товара"   p-gds-code skip
     3846             "Код признака" buf_temp-prt-obj.prt-code skip
     3847             error-status :get-message(1) skip
     3848             return-value skip
     3849             view-as alert-box error .
     3850           undo, return error .
     3851         end.
     3852   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3853   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3854     (input  p-obj-type
     3855     ,input  p-obj-code
     3856     ,input  v-prt-b-code
     3857     ,input  0
     3858     ,input  p-day-end-fact-order
     3859     ,output parrecid-prl
     3860     ,output v-cli-base-rate
     3861     ) no-error .
     3862         if error-status :error
     3863         then do:
     3864           message
     3865             vss-workfile vss-revision vss-description skip
     3866             "Ошибка при определении цены бар-кода" skip
     3867             "Объект" p-obj-type p-obj-code skip
     3868             "Бар-код" v-prt-b-code skip
     3869             "fact-order" p-day-end-fact-order skip
     3870             error-status :get-message(1) skip
     3871             return-value skip
     3872             view-as alert-box error .
     3873           undo, return error .
     3874         end.
     3875         if parrecid-prl <> ?
     3876         then do:
     3877           run prl-vat in this-procedure
     3878             (input  parrecid-prl
     3879             ,output price-rubl-with-tax-sale-prl
     3880             ,output price-base-with-tax-sale-prl
     3881             ,output price-rubl-without-tax-sale-prl
     3882             ,output price-base-without-tax-sale-prl
     3883             ,output vat-base-sale-prl
     3884             ,output vat-rubl-sale-prl
     3885             ,output vat-base-buyer-prl
     3886             ,output vat-rubl-buyer-prl
     3887             ,output slt-base-sale-prl
     3888             ,output slt-rubl-sale-prl
     3889             ,output road-tax-base-sale-prl
     3890             ,output road-tax-rubl-sale-prl
     3891             ,output excise-base-sale-prl
     3892             ,output excise-rubl-sale-prl
     3893             ,output discnt-base-sale-prl
     3894             ,output discnt-rubl-sale-prl
     3895             ) no-error .
     3896           if error-status :error
     3897           then do:
     3898             message
     3899               vss-workfile vss-revision vss-description skip
     3900               "Ошибка при вызове процеды prl-vat" skip
     3901               "Объект" p-obj-type p-obj-code skip
     3902               "Код товара" p-gds-code skip
     3903               "Указатель на запись переоценки" parrecid-prl skip
     3904               error-status :get-message(1) skip
     3905               return-value skip
     3906               view-as alert-box error .
     3907             undo, return error .
     3908           end.
     3909         end.
     3910         else do:
     3911           assign
     3912             price-rubl-with-tax-sale-prl    = 0
     3913             price-base-with-tax-sale-prl    = 0
     3914             price-rubl-without-tax-sale-prl = 0
     3915             price-base-without-tax-sale-prl = 0
     3916             vat-base-sale-prl               = 0
     3917             vat-rubl-sale-prl               = 0
     3918             slt-base-sale-prl               = 0
     3919             slt-rubl-sale-prl               = 0
     3920             road-tax-base-sale-prl          = 0
     3921             road-tax-rubl-sale-prl          = 0
     3922             excise-base-sale-prl            = 0
     3923             excise-rubl-sale-prl            = 0
     3924             discnt-base-sale-prl            = 0
     3925             discnt-rubl-sale-prl            = 0
     3926           .
     3927         end.
     3928         assign
     3929           v-fact-qnty         = v-fact-qnty
     3930                               + buf_temp-prt-obj.fact-qnty
     3931           v-cur-base          = v-cur-base
     3932                               + (if p-curr-r-b = 'base':U
     3933                                   then price-base-with-tax-sale-prl
     3934                                   else price-rubl-with-tax-sale-prl
     3935                                 )
     3936                               * buf_temp-prt-obj.fact-qnty
     3937           v-cur-VAT-base      = v-cur-VAT-base
     3938                               + (if p-curr-r-b = 'base':U
     3939                                   then vat-base-sale-prl
     3940                                   else vat-rubl-sale-prl
     3941                                 )
     3942                               * buf_temp-prt-obj.fact-qnty
     3943           v-cur-SLT-base      = v-cur-SLT-base
     3944                               + (if p-curr-r-b = 'base':U
     3945                                   then slt-base-sale-prl
     3946                                   else slt-rubl-sale-prl
     3947                                 )
     3948                               * buf_temp-prt-obj.fact-qnty
     3949           v-cur-road-tax-base = v-cur-road-tax-base
     3950                               + (if p-curr-r-b = 'base':U
     3951                                   then road-tax-base-sale-prl
     3952                                   else road-tax-rubl-sale-prl
     3953                                 )
     3954                               * buf_temp-prt-obj.fact-qnty
     3955           v-cur-excise-base   = v-cur-excise-base
     3956                               + (if p-curr-r-b = 'base':U
     3957                                   then excise-base-sale-prl
     3958                                   else excise-rubl-sale-prl
     3959                                 )
     3960                               * buf_temp-prt-obj.fact-qnty
     3961         .
     3962       end.
     3963       assign
     3964         p-fact-qnty         = v-fact-qnty
     3965         p-cur-base          = v-cur-base
     3966         p-cur-VAT-base      = v-cur-VAT-base
     3967         p-cur-SLT-base      = v-cur-SLT-base
     3968         p-cur-road-tax-base = v-cur-road-tax-base
     3969         p-cur-excise-base   = v-cur-excise-base
     3970       .
     3971     end.
     3972   end procedure.
     3973   procedure prdoclib-clear-temp-pl-gds :
     3974     define buffer buf_temp-pl-gds for temp-pl-gds .
     3975     do
     3976     on error undo, return error return-value
     3977     :
     3978       for each buf_temp-pl-gds
     3979       on error undo, return error return-value
     3980       :
     3981         delete buf_temp-pl-gds .
     3982       end.
     3983     end.
     3984   end procedure.
     3985   procedure prdoclib-init-temp-pl-gds :
     3986     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3987     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3988     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3989     define buffer buf_pl-gds      for ub.pl-gds .
     3990     define buffer buf_temp-pl-gds for temp-pl-gds .
     3991     do
     3992     on error undo, return error return-value
     3993     :
     3994       run prdoclib-clear-temp-pl-gds in this-procedure .
     3995       for each buf_pl-gds
     3996         where buf_pl-gds.obj-type = p-obj-type
     3997           and buf_pl-gds.obj-code = p-obj-code
     3998           and buf_pl-gds.gds-code = p-gds-code
     3999       on error undo, return error return-value
     4000       :
     4001         create buf_temp-pl-gds .
     4002         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     4003       end.
     4004     end.
     4005   end procedure.
     4006   procedure prdoclib-init-pl-gds-by-factord :
     4007     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4008     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4009     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     4010     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     4011     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     4012     define input parameter p-fact-order         as decimal   no-undo .
     4013     define input parameter p-include-fact-order as logical   no-undo .
     4014     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     4015     define buffer buf_goods       for ub.goods .
     4016     define buffer buf_gds-obj     for ub.gds-obj .
     4017     define buffer buf_doc-line    for ub.doc-line .
     4018     define buffer buf_temp-pl-gds for temp-pl-gds .
     4019     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     4020     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     4021     do
     4022     on error undo, return error return-value
     4023     :
     4024       do transaction
     4025       on error undo, return error return-value
     4026       :
     4027   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
