     3138               price-base-with-tax-sale-prl    = 0
     3139               price-rubl-without-tax-sale-prl = 0
     3140               price-base-without-tax-sale-prl = 0
     3141               vat-base-sale-prl               = 0
     3142               vat-rubl-sale-prl               = 0
     3143               vat-base-buyer-prl              = 0
