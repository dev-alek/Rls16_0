     4477   procedure partslib-process-document :
     4478     define input  parameter p-doc-code         as character no-undo .
     4479     define input  parameter p-obj-type         as character no-undo .
     4480     define input  parameter p-obj-code         as integer   no-undo .
     4481     define input  parameter p-artic            as character no-undo .
     4482     define input  parameter p-prod-type        as character no-undo .
     4483     define input  parameter p-prod-code        as integer   no-undo .
     4484     define input  parameter p-goods-gds-goods  as logical   no-undo .
     4485     define input  parameter p-goods-twounit    as logical   no-undo .
     4486     define output parameter p-total-parts-qnty as decimal   no-undo .
     4487     define variable v-parts-sign as integer   no-undo .
     4488     define buffer buf_trn-doc    for ub.trn-doc .
     4489     define buffer buf_doc-line   for ub.doc-line .
     4490     define buffer buf_parts      for ub.parts .
     4491     define buffer buf_temp-parts for temp-parts .
     4492     do
     4493     on error undo, return error return-value
     4494     :
     4495       find first buf_trn-doc no-lock
     4496         where buf_trn-doc.doc-code = p-doc-code
     4497         no-error .
     4498       if not available buf_trn-doc
     4499       then do:
     4500         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     4501                                      ,p-doc-code
     4502                                      ) .
     4503       end.
     4504       case buf_trn-doc.doc-type
     4505       :
     4506         when 'при':U or
     4507         when 'возврат':U or
     4508         when 'инв':U
     4509         then do:
     4510           assign
     4511             v-parts-sign = -1
     4512           .
     4513         end.
     4514         when 'рас':U or
     4515         when 'спи':U
     4516         then do:
     4517           assign
     4518             v-parts-sign = 1
     4519           .
     4520         end.
     4521         otherwise do:
     4522           undo, return error substitute("Неизвестный тип документа &1"
     4523                                       ,buf_trn-doc.doc-type
     4524                                       ) .
     4525         end.
     4526       end.
     4527       find first buf_doc-line no-lock
     4528         where buf_doc-line.doc-code  = p-doc-code
     4529           and buf_doc-line.artic     = p-artic
     4530           and buf_doc-line.prod-type = p-prod-type
     4531           and buf_doc-line.prod-code = p-prod-code
     4532         no-error .
     4533       if not available buf_doc-line
     4534       then do:
     4535         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     4536                                      ,p-doc-code
     4537                                      ,artic
     4538                                      ,prod-type
     4539                                      ,prod-code
     4540                                      ) .
     4541       end.
     4542       assign
     4543         p-total-parts-qnty = 0
     4544       .
     4545       if p-goods-gds-goods = true
     4546       then do:
     4547         for each buf_parts no-lock
     4548           where buf_parts.out-code  = p-doc-code
     4549             and buf_parts.obj-type  = p-obj-type
     4550             and buf_parts.obj-code  = p-obj-code
     4551             and buf_parts.artic     = p-artic
     4552             and buf_parts.prod-type = p-prod-type
     4553             and buf_parts.prod-code = p-prod-code
     4554         on error undo, return error
     4555         :
     4556           run partslib-create-temp-parts in this-procedure
     4557             (buffer buf_parts
     4558             ,buffer buf_temp-parts
     4559             ,input  p-goods-twounit
     4560             ) .
     4561           assign
     4562             p-total-parts-qnty        = p-total-parts-qnty
     4563                                       + v-parts-sign * buf_parts.fact-qnty
     4564             buf_temp-parts.qnty       = buf_temp-parts.qnty
     4565                                       + v-parts-sign * buf_parts.fact-qnty
     4566             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     4567                                       + v-parts-sign * buf_parts.fact-qnty
     4568             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     4569                                       + v-parts-sign * buf_parts.cli-qnty
     4570           .
     4571           if buf_temp-parts.qnty = 0
     4572           then do:
     4573             delete buf_temp-parts .
     4574           end.
     4575         end.
     4576       end.
     4577       else do:
     4578         assign
     4579           p-total-parts-qnty = p-total-parts-qnty
     4580                              + v-parts-sign * buf_doc-line.fact-qnty
     4581         .
     4582       end.
     4583     end.
     4584   end procedure.
     4585   procedure partslib-init-temp-parts-by-date :
     4586     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     4587     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     4588     define input parameter p-artic           like ub.parts.artic     no-undo .
     4589     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     4590     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     4591     define input parameter p-fact-date       as date      no-undo .
     4592     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     4593     do
     4594     on error undo, return error
     4595     :
     4596       define variable v-fact-order                as decimal   no-undo .
     4597       define variable v-shift-end-fact-order      as decimal   no-undo .
     4598       define variable v-day-end-fact-order        as decimal   no-undo .
     4599       run factord in this-procedure
     4600         (input  p-fact-date
     4601         ,input  1
     4602         ,input  1
     4603         ,input  ?
     4604         ,input  0
     4605         ,input  false
     4606         ,output v-fact-order
     4607         ,output v-shift-end-fact-order
     4608         ,output v-day-end-fact-order
     4609         ) no-error .
     4610       if error-status :error
     4611       then do:
     4612         message
     4613           vss-workfile vss-revision vss-description skip
     4614           vss-include-info25 skip
     4615           "Ошибка при определении момента времени, на который требуется остаток" skip
     4616           "Объект" p-obj-type p-obj-code skip
     4617           "Артикул" p-artic p-prod-type p-prod-code skip
     4618           "Дата" p-fact-date skip
     4619           view-as alert-box error .
     4620         undo, return error .
     4621       end.
     4622       run partslib-init-temp-parts-by-factord in this-procedure
     4623         (input p-obj-type
     4624         ,input p-obj-code
     4625         ,input p-artic
     4626         ,input p-prod-type
     4627         ,input p-prod-code
     4628         ,input v-day-end-fact-order
     4629         ,input false
     4630         ) no-error .
     4631       if error-status :error
     4632       then do:
     4633         message
     4634           vss-workfile vss-revision vss-description skip
     4635           vss-include-info25 skip
     4636           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     4637           "Объект" p-obj-type p-obj-code skip
     4638           "Артикул" p-artic p-prod-type p-prod-code skip
     4639           "Дата" p-fact-date skip
     4640           view-as alert-box error .
     4641         undo, return error .
     4642       end.
     4643     end.
     4644   end procedure.
     4645   procedure partslib-calc-cost :
     4646     define output parameter p-fact-qnty      as decimal   no-undo .
     4647     define output parameter p-vat-pc         as decimal   no-undo .
     4648     define output parameter p-slt-pc         as decimal   no-undo .
     4649     define output parameter p-sum-base       as decimal   no-undo .
     4650     define output parameter p-sum-rubl       as decimal   no-undo .
     4651     define output parameter p-vat-base       as decimal   no-undo .
     4652     define output parameter p-vat-rubl       as decimal   no-undo .
     4653     define output parameter p-slt-base       as decimal   no-undo .
     4654     define output parameter p-slt-rubl       as decimal   no-undo .
     4655     define output parameter p-road-tax-base  as decimal   no-undo .
     4656     define output parameter p-road-tax-rubl  as decimal   no-undo .
     4657     define output parameter p-transport-base as decimal   no-undo .
     4658     define output parameter p-transport-rubl as decimal   no-undo .
     4659     define output parameter p-other-base     as decimal   no-undo .
     4660     define output parameter p-other-rubl     as decimal   no-undo .
     4661     define output parameter p-excise-base    as decimal   no-undo .
     4662     define output parameter p-excise-rubl    as decimal   no-undo .
     4663     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     4664     do
     4665     on error undo, return error return-value
     4666     :
     4667       define buffer buf_temp-parts for temp-parts .
     4668       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     4669       define buffer   in-vatp-parts    for ub.parts   .
     4670       define buffer   in-vatp-doc      for ub.trn-doc .
     4671       define buffer   in-vatp-goods    for ub.goods   .
     4672       define buffer   in-vatp-sysconf  for ub.sysconf .
     4673       define buffer   in-vatp_doc-attr for ub.doc-attr.
     4674       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     4675       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     4676       define variable varinvprb                  as   character              no-undo.
     4677       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     4678       define variable cli-base-rate              as   decimal                no-undo.
     4679       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     4680       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     4681       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     4682       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     4683       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     4684       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     4685       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     4686       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4687       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     4688       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     4689       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4690       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     4691       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     4692       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     4693       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     4694       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     4695       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     4696       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     4697       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     4698       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     4699       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     4700       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     4701       define variable varinvatp-envd             as   character              no-undo.
     4702       define variable varinvatp-type             as   character              no-undo.
     4703       for each buf_temp-parts
     4704       on error undo, return error
     4705       :
     4706   assign
     4707     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     4708     price-base-with-tax-loc = buf_temp-parts.price-base
     4709   .
     4710   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4711   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4712     (output varinvprb
     4713     )  .
     4714     if buf_temp-parts.out-code = 'free-zone':U     or
     4715        buf_temp-parts.out-code = 'out-zone':U   or
     4716        buf_temp-parts.doc-type = 'акт':U then do:
     4717       assign
     4718         in-vatp-have-vat-slt = yes.
     4719     end.
     4720     else do:
     4721       find first in-vatp_doc-attr no-lock
     4722         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     4723           and in-vatp_doc-attr.attr-code = 'envd':U
     4724         no-error .
     4725       if not available in-vatp_doc-attr then do:
     4726         assign
     4727           in-vatp-have-vat-slt = yes.
     4728       end.
     4729       else do:
     4730            in-vatp-have-vat-slt = no.
     4731       end.
     4732     end.
     4733     assign
     4734      price-cli-with-tax-loc = buf_temp-parts.price-cli
     4735      cli-base-rate          = buf_temp-parts.cli-base-rate.
     4736     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     4737              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     4738     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     4739             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     4740             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     4741             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     4742             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     4743             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     4744             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4745       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4746     assign
     4747       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     4748     assign
     4749       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     4750       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     4751       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     4752       transport-cli-loc  = 0
     4753       other-cli-loc      = 0
     4754     .
     4755   ASSIGN
     4756             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4757       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4758   .
     4759         assign
     4760           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     4761           p-vat-pc         = p-vat-pc         + vat-pc-loc
     4762           p-slt-pc         = p-slt-pc         + slt-pc-loc
     4763           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     4764           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     4765           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     4766           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     4767           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     4768           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     4769           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     4770           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     4771           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     4772           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     4773           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     4774           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     4775           p-excise-base    = p-excise-base    + 0
     4776           p-excise-rubl    = p-excise-rubl    + 0
     4777         .
     4778       end.
     4779       if p-fact-qnty      = ?
     4780       or p-sum-base       = ?
     4781       or p-sum-rubl       = ?
     4782       or p-vat-base       = ?
     4783       or p-vat-rubl       = ?
     4784       or p-slt-base       = ?
     4785       or p-slt-rubl       = ?
     4786       or p-road-tax-base  = ?
     4787       or p-road-tax-rubl  = ?
     4788       or p-transport-base = ?
     4789       or p-transport-rubl = ?
     4790       or p-other-base     = ?
     4791       or p-other-rubl     = ?
     4792       or p-excise-base    = ?
     4793       or p-excise-rubl    = ?
     4794       then do:
     4795         message
     4796           vss-workfile vss-revision vss-description skip
     4797           vss-include-info25 skip
     4798           "Программа in-vatp.i вернула неопределенные значения" skip
     4799           "p-fact-qnty"      p-fact-qnty      skip
     4800           "p-sum-base"       p-sum-base       skip
     4801           "p-sum-rubl"       p-sum-rubl       skip
     4802           "p-vat-base"       p-vat-base       skip
     4803           "p-vat-rubl"       p-vat-rubl       skip
     4804           "p-slt-base"       p-slt-base       skip
     4805           "p-slt-rubl"       p-slt-rubl       skip
     4806           "p-road-tax-base"  p-road-tax-base  skip
     4807           "p-road-tax-rubl"  p-road-tax-rubl  skip
     4808           "p-transport-base" p-transport-base skip
     4809           "p-transport-rubl" p-transport-rubl skip
     4810           "p-other-base"     p-other-base     skip
     4811           "p-other-rubl"     p-other-rubl     skip
     4812           "p-excise-base"    p-excise-base    skip
     4813           "p-excise-rubl"    p-excise-rubl    skip
     4814           view-as alert-box error .
     4815         undo, return error .
     4816       end.
     4817     end.
     4818   end procedure.
     4819   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4820   define new global shared variable g#lib-trn  as handle no-undo .
     4821   define new global shared variable g#lib-trn2 as handle no-undo .
     4822   define new global shared variable g#lib-trn3 as handle no-undo .
     4823   define new global shared variable g#lib-trn4 as handle no-undo .
     4824   define temp-table tt-allsum-line      no-undo
     4825   field sum-type           as   character
     4826   field fact-qnty          like ub.doc-line.fact-qnty
     4827   field cli-qnty           like ub.doc-line.cli-qnty
     4828   field sum-dsc-base-doc   like ub.doc-line.price-base
     4829   field sum-dsc-rubl-doc   like ub.doc-line.price-base
     4830   field dsc-base-doc       like ub.doc-line.price-base
     4831   field dsc-rubl-doc       like ub.doc-line.price-base
     4832   field vat-base-doc       like ub.doc-line.price-base
     4833   field vat-rubl-doc       like ub.doc-line.price-base
     4834   field vat-base-buyer-doc like ub.doc-line.price-base
     4835   field vat-rubl-buyer-doc like ub.doc-line.price-base
     4836   field slt-base-doc       like ub.doc-line.price-base
     4837   field slt-rubl-doc       like ub.doc-line.price-base
     4838   field road-tax-base-doc  like ub.doc-line.price-base
     4839   field road-tax-rubl-doc  like ub.doc-line.price-base
     4840   field excise-base-doc    like ub.doc-line.price-base
     4841   field excise-rubl-doc    like ub.doc-line.price-base
     4842   field sum-dsc-base-acc   like ub.doc-line.price-base
     4843   field sum-dsc-rubl-acc   like ub.doc-line.price-base
