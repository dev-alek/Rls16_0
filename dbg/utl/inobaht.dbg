     3110               ,output vat-base-buyer-prl
     3111               ,output vat-rubl-buyer-prl
     3112               ,output slt-base-sale-prl
     3113               ,output slt-rubl-sale-prl
     3114               ,output road-tax-base-sale-prl
     3115               ,output road-tax-rubl-sale-prl
     3116               ,output excise-base-sale-prl
     3117               ,output excise-rubl-sale-prl
     3118               ,output discnt-base-sale-prl
     3119               ,output discnt-rubl-sale-prl
     3120               ) no-error .
     3121             if error-status :error
