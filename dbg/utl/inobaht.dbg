      591       find last buf_aht-stk-line exclusive-lock
      592         where buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
      593           and buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
      594           and buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
      595           and buf_aht-stk-line.sum-type   = p-stk-sum-type
      596           and buf_aht-stk-line.fact-order <= p-fact-order
      597         use-index category
      598         no-error .
      599       if not available buf_aht-stk-line
      600       or buf_aht-stk-line.fact-order <> p-fact-order
      601       then do:
      602         create new-buf_aht-stk-line .
      603         assign
      604           new-buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
      605           new-buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
      606           new-buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
