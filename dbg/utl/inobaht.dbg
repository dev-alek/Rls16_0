      608           new-buf_aht-stk-line.sum-type   = p-stk-sum-type
      609         .
      610         if available buf_aht-stk-line then do:
      611           assign
      612             new-buf_aht-stk-line.fact-qnty = buf_aht-stk-line.fact-qnty
