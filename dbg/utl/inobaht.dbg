     6558     (input  bf_trn-doc.obj-type
     6559     ,input  bf_trn-doc.obj-code
     6560     ,input  varb-code
     6561     ,input  0
     6562     ,input  bf_trn-doc.fact-order
     6563     ,output vardoc-num
     6564     ,output varprice-sale
     6565     ,output varroad-tax
     6566     ,output varexcise
     6567     )  .
     6568             if varprice-sale = ?
     6569             then do:
     6570               assign
     6571                 varprice-sale = 0
     6572                 varroad-tax   = 0
     6573                 varexcise     = 0
     6574               .
     6575             end.
     6576             assign
     6577               varlastcur-base     = varprice-sale
     6578               varlastcur-road-tax = varroad-tax
     6579               varlastcur-excise   = varexcise
     6580               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     6581               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     6582               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     6583               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     6584             .
     6585         end.
     6586       end.
     6587       if varcur-fact-qnty = 0 then do:
     6588         assign
     6589           varcur-base      = varlastcur-base
     6590           varcur-road-tax  = varlastcur-road-tax
     6591           varcur-excise    = varlastcur-excise
     6592         .
     6593       end.
     6594       else do:
     6595         assign
     6596           varcur-base      = varcur-base      / varcur-fact-qnty
     6597           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     6598           varcur-excise    = varcur-excise    / varcur-fact-qnty
     6599         .
     6600       end.
     6601       if varcur-vat-pc = ?
