     1357           where buf_price-doc.obj-type = p-obj-type
     1358             and buf_price-doc.obj-code = p-obj-code
     1359             and buf_price-doc.status_  = 'акт':U
     1360             and ub.buf_price-doc.fact-date >= p-cut-date
     1361         on error undo, return error
     1362         :
     1363           create buf_doc-list .
     1364           assign
     1365             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1366             buf_doc-list.doc-type   = ''
     1367             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1368             buf_doc-list.shift-date = buf_price-doc.shift-date
     1369             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1370             buf_doc-list.shift-name = buf_price-doc.shift-name
     1371             buf_doc-list.fact-order = buf_price-doc.fact-order
     1372             buf_doc-list.is-trn-doc = false
     1373           .
     1374         end.
     1375       end.
     1376     end.
     1377   end procedure.
     1378   procedure doclslib-clear-bydate-doc-list :
     1379     define input parameter p-fact-date as date no-undo .
     1380     define buffer buf_doc-list for doc-list .
