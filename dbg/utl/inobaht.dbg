     1712             (input p-log-handle
     1713             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1714                              ,buf_doc-list.doc-code
     1715                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1716                              ,buf_doc-list.fact-order
     1717                              )
     1718             ) .
     1719           run trg/aht-doc.p
     1720             (input buf_doc-list.doc-code
     1721             ,input p-cut-date
     1722             ).
     1723           run doclslib-log-information in this-procedure
     1724             (input p-log-handle
     1725             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1726                              ,buf_doc-list.doc-code
     1727                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1728                              ,buf_doc-list.fact-order
     1729                              )
     1730             ) .
     1731         end.
     1732         else do:
     1733           run doclslib-log-information in this-procedure
     1734             (input p-log-handle
     1735             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1736                              ,buf_doc-list.doc-code
     1737                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1738                              ,buf_doc-list.fact-order
     1739                              )
     1740             ) .
     1741           run trg/aht-prc.p
     1742             (input buf_doc-list.doc-code
     1743             ,input p-cut-date
     1744             ).
     1745           run doclslib-log-information in this-procedure
     1746             (input p-log-handle
     1747             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1748                              ,buf_doc-list.doc-code
     1749                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1750                              ,buf_doc-list.fact-order
     1751                              )
     1752             ) .
     1753         end.
     1754         if  p-update-recalc  = true
     1755         and v-prev-fact-date <> ?
     1756         and buf_doc-list.fact-date > v-prev-fact-date
     1757         then do:
     1758           run gbl/clntat-w.p
     1759             (input p-obj-type
     1760             ,input p-obj-code
     1761             ,input 'aht-recalc':U
     1762             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1763             ) .
     1764           run doclslib-log-information in this-procedure
     1765             (input p-log-handle
     1766             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1767                              ,string(v-prev-fact-date, '99/99/9999':u)
     1768                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1769                              )
     1770             ) .
     1771         end.
     1772         assign
     1773           v-prev-fact-date = buf_doc-list.fact-date
     1774         .
     1775       end.
     1776     end.
     1777   end procedure.
     1778   procedure doclslib-calc-ahsp :
     1779     define input  parameter p-log-handle    as handle    no-undo .
     1780     define input  parameter p-obj-type      as character no-undo .
     1781     define input  parameter p-obj-code      as integer   no-undo .
     1782     define input  parameter p-cut-date      as date      no-undo .
     1783     define input  parameter p-update-recalc as logical   no-undo .
     1784     define variable v-prev-fact-date as date      no-undo .
     1785     define buffer buf_doc-list for doc-list .
     1786     define buffer stop-ahsp-restore-lock_btpr for ub.batchprocess .
     1787     define buffer stop-ahsp-news-lock_btpr    for ub.batchprocess .
     1788     do
     1789     on error undo, return error return-value
     1790     :
     1791       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1792       run gbl/lockrngd.p
     1793         (input  'grar':U
     1794         ,input  'disable':U
     1795         ,buffer buf_lock_gdsrenart_batchprocess
     1796         ) no-error .
     1797       if error-status :error
     1798       then do:
     1799         if error-status :get-message(1) <> ""
     1800         then do:
     1801           message
     1802             vss-workfile vss-revision vss-description skip
     1803             "Ошибка при блокировании функции переименования артикула товара" skip
     1804             error-status :get-message(1) skip
     1805             return-value skip
     1806             view-as alert-box error .
     1807         end.
     1808         undo, return error return-value .
     1809       end.
     1810       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1811       run gbl/lockrngd.p
     1812         (input  'grgc':U
     1813         ,input  'disable':U
     1814         ,buffer buf_lock_gdsrengc_batchprocess
     1815         ) no-error .
     1816       if error-status :error
     1817       then do:
     1818         if error-status :get-message(1) <> ""
     1819         then do:
     1820           message
     1821             vss-workfile vss-revision vss-description skip
     1822             "Ошибка при блокировании функции переименования кода товара" skip
     1823             error-status :get-message(1) skip
     1824             return-value skip
     1825             view-as alert-box error .
     1826         end.
     1827         undo, return error return-value .
     1828       end.
     1829       for each buf_doc-list
     1830         where buf_doc-list.is-trn-doc = true
     1831       by buf_doc-list.fact-order
     1832       on error undo, return error
     1833       :
     1834         find first stop-ahsp-restore-lock_btpr no-lock
     1835           where stop-ahsp-restore-lock_btpr.bp_type       = 'lock':U + 'rsss':U
     1836             and stop-ahsp-restore-lock_btpr.bp_status     = 'N':U
     1837             and stop-ahsp-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1838             and stop-ahsp-restore-lock_btpr.Key#_Two      = 0
     1839             and stop-ahsp-restore-lock_btpr.Key#_Three    = 0
     1840             and stop-ahsp-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1841             and stop-ahsp-restore-lock_btpr.CharKey_Two   = ""
     1842             and stop-ahsp-restore-lock_btpr.CharKey_Three = ""
     1843           no-error .
     1844         if available stop-ahsp-restore-lock_btpr
     1845         then do:
     1846           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1847         end.
     1848         find first stop-ahsp-news-lock_btpr no-lock
     1849           where stop-ahsp-news-lock_btpr.bp_type       = 'lock':U + 'rssn':U
     1850             and stop-ahsp-news-lock_btpr.bp_status     = 'N':U
     1851             and stop-ahsp-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1852             and stop-ahsp-news-lock_btpr.Key#_Two      = 0
     1853             and stop-ahsp-news-lock_btpr.Key#_Three    = 0
     1854             and stop-ahsp-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1855             and stop-ahsp-news-lock_btpr.CharKey_Three = ""
     1856           no-error .
     1857         if available stop-ahsp-news-lock_btpr
     1858         then do:
     1859           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1860         end.
     1861         run doclslib-log-information in this-procedure
     1862           (input p-log-handle
     1863           ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1864                             ,buf_doc-list.doc-code
     1865                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1866                             ,buf_doc-list.fact-order
     1867                             )
     1868           ) .
     1869         define variable v-need-process as logical   no-undo .
     1870         run trg/ah-csptr.p
     1871           (input  buf_doc-list.doc-code
     1872           ,input  p-cut-date
     1873           ,input  false
     1874           ,output v-need-process
     1875           ).
     1876         run doclslib-log-information in this-procedure
     1877           (input p-log-handle
     1878           ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1879                             ,buf_doc-list.doc-code
     1880                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1881                             ,buf_doc-list.fact-order
     1882                             )
     1883           ) .
     1884         if  p-update-recalc  = true
     1885         and v-prev-fact-date <> ?
     1886         and buf_doc-list.fact-date > v-prev-fact-date
     1887         then do:
     1888           run gbl/clntat-w.p
     1889             (input p-obj-type
     1890             ,input p-obj-code
     1891             ,input 'ahsp-recalc':U
     1892             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1893             ) .
     1894           run doclslib-log-information in this-procedure
     1895             (input p-log-handle
     1896             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1897                              ,string(v-prev-fact-date, '99/99/9999':u)
     1898                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1899                              )
     1900             ) .
     1901         end.
     1902         assign
     1903           v-prev-fact-date = buf_doc-list.fact-date
     1904         .
     1905       end.
     1906     end.
     1907   end procedure.
     1908   procedure doclslib-log-information :
     1909     define input  parameter p-log-handle as handle    no-undo .
     1910     define input  parameter p-message    as character no-undo .
     1911     do
     1912     on error undo, return error return-value
     1913     :
     1914       define variable v-log-procedure-name as character no-undo .
     1915       assign
     1916         v-log-procedure-name = "cb-doclslib-log"
     1917       .
     1918       if valid-handle(p-log-handle)
     1919       and p-log-handle :get-signature(v-log-procedure-name) <> ""
     1920       then do:
     1921         run value(v-log-procedure-name) in p-log-handle
     1922           (input p-message
     1923           ) no-error .
     1924       end.
     1925     end.
     1926   end procedure.
     1927   procedure doclslib-find-last-fact-date :
     1928     define output parameter p-last-fact-date  as date      no-undo .
     1929     define output parameter p-reason          as character no-undo .
     1930     do
     1931     on error undo, return error
     1932     :
     1933       define variable v-last-fact-date    as date      no-undo .
     1934       define buffer buf_doc-list for doc-list .
     1935       assign
     1936         v-last-fact-date    = ?
     1937       .
     1938       for each buf_doc-list
     1939       by buf_doc-list.fact-order
     1940       on error undo, return error
     1941       :
     1942         if buf_doc-list.is-archive-exist = false
     1943         or buf_doc-list.fact-date = ?
     1944         then do:
     1945           assign
     1946             p-reason = p-reason + substitute("По документу &1 отсутствует рассчитанный складской архив"
     1947                                             ,buf_doc-list.doc-code
     1948                                             )
     1949           .
     1950           leave .
     1951         end.
     1952         if buf_doc-list.fact-date = ?
     1953         then do:
     1954           assign
     1955             p-reason = p-reason + substitute("Документ &1 имеет не заданную фактическую дату "
     1956                                             ,buf_doc-list.doc-code
     1957                                             )
     1958           .
     1959           leave .
     1960         end.
     1961         if v-last-fact-date = ?
     1962         or (v-last-fact-date <> ?
     1963             and v-last-fact-date < buf_doc-list.fact-date
     1964            )
     1965         then do:
     1966           assign
     1967             v-last-fact-date = buf_doc-list.fact-date
     1968             p-reason         = substitute("Последний рассчитанный документ &1" + chr(10)
     1969                                          ,buf_doc-list.doc-code
     1970                                          )
     1971           .
     1972         end.
     1973       end.
     1974       assign
     1975         p-last-fact-date = v-last-fact-date
     1976       .
     1977     end.
     1978   end procedure.
     1979   procedure doclslib-check-arh-exist :
     1980     define input parameter  p-obj-type       as character no-undo .
     1981     define input parameter  p-obj-code       as integer   no-undo .
     1982     define input parameter  p-cut-fact-order as decimal   no-undo .
     1983     define output parameter p-archive-exist  as logical   no-undo .
     1984     define buffer buf_stk-tot for ub.stk-tot .
     1985     do
     1986     on error undo, return error
     1987     :
     1988       find first buf_stk-tot no-lock
     1989         where buf_stk-tot.obj-type   = p-obj-type
     1990           and buf_stk-tot.obj-code   = p-obj-code
     1991           and buf_stk-tot.fact-order > p-cut-fact-order
     1992         no-error .
     1993       assign
     1994         p-archive-exist = (available buf_stk-tot)
     1995       .
     1996     end.
     1997   end procedure.
     1998   procedure doclslib-check-aht-exist :
     1999     define input parameter  p-obj-type       as character no-undo .
     2000     define input parameter  p-obj-code       as integer   no-undo .
     2001     define input parameter  p-cut-fact-order as decimal   no-undo .
     2002     define output parameter p-archive-exist  as logical   no-undo .
     2003     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     2004     do
     2005     on error undo, return error
     2006     :
     2007       find first buf_aht-stk-tot no-lock
     2008         where buf_aht-stk-tot.obj-type   = p-obj-type
     2009           and buf_aht-stk-tot.obj-code   = p-obj-code
     2010           and buf_aht-stk-tot.fact-order > p-cut-fact-order
     2011         no-error .
     2012       assign
     2013         p-archive-exist = (available buf_aht-stk-tot)
     2014       .
     2015     end.
     2016   end procedure.
     2017   procedure doclslib-check-ahsp-exist :
     2018     define input parameter  p-obj-type       as character no-undo .
     2019     define input parameter  p-obj-code       as integer   no-undo .
     2020     define input parameter  p-cut-fact-order as decimal   no-undo .
     2021     define output parameter p-archive-exist  as logical   no-undo .
     2022     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     2023     do
     2024     on error undo, return error
     2025     :
     2026       find first buf_stk-supp-tot no-lock
     2027         where buf_stk-supp-tot.obj-type   = p-obj-type
     2028           and buf_stk-supp-tot.obj-code   = p-obj-code
     2029           and buf_stk-supp-tot.fact-order > p-cut-fact-order
