     4086   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4087   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     4088   procedure partslib-clear-temp-parts :
     4089     define buffer buf_temp-parts for temp-parts .
     4090     do
     4091     on error undo, return error
     4092     :
