     2033       .
     2034     end.
     2035   end procedure.
     2036   procedure doclslib-check-doc-arh-exist :
     2037     define buffer buf_doc-list for doc-list .
     2038     define buffer buf_ot-tot for ub.ot-tot .
     2039     do
     2040     on error undo, return error return-value
     2041     :
     2042       for each buf_doc-list
     2043       on error undo, return error
     2044       :
     2045         find first buf_ot-tot no-lock
     2046           where buf_ot-tot.doc-code = buf_doc-list.doc-code
     2047           no-error .
     2048         if available buf_ot-tot
     2049         then do:
     2050           assign
     2051             buf_doc-list.is-archive-exist = true
     2052           .
     2053         end.
     2054         else do:
     2055           assign
     2056             buf_doc-list.is-archive-exist = false
     2057           .
     2058         end.
     2059       end.
     2060     end.
     2061   end procedure.
     2062   procedure doclslib-check-doc-aht-exist :
     2063     define buffer buf_doc-list for doc-list .
     2064     define buffer buf_aht-doc for ub.aht-doc .
     2065     do
     2066     on error undo, return error return-value
     2067     :
     2068       for each buf_doc-list
     2069       on error undo, return error
     2070       :
     2071         find first buf_aht-doc no-lock
     2072           where buf_aht-doc.doc-code = buf_doc-list.doc-code
     2073           no-error .
     2074         if available buf_aht-doc
     2075         then do:
     2076           assign
     2077             buf_doc-list.is-archive-exist = true
     2078           .
     2079         end.
     2080         else do:
     2081           assign
     2082             buf_doc-list.is-archive-exist = false
     2083           .
     2084         end.
     2085       end.
     2086     end.
     2087   end procedure.
     2088   procedure doclslib-check-doc-ahsp-exist :
     2089     define buffer buf_doc-list for doc-list .
     2090     define buffer buf_ot-supp-line for ub.ot-supp-tot .
     2091     do
     2092     on error undo, return error return-value
     2093     :
     2094       for each buf_doc-list
     2095       on error undo, return error
     2096       :
     2097         find first buf_ot-supp-line no-lock
     2098           where buf_ot-supp-line.doc-code = buf_doc-list.doc-code
     2099           no-error .
     2100         if available buf_ot-supp-line
     2101         then do:
     2102           assign
     2103             buf_doc-list.is-archive-exist = true
     2104           .
     2105         end.
     2106         else do:
     2107           if buf_doc-list.doc-type = 'инв':U
     2108           then do:
     2109             define variable v-need-process as logical   no-undo .
     2110             run trg/ah-csptr.p
     2111               (input  buf_doc-list.doc-code
     2112               ,input  0
     2113               ,input  true
     2114               ,output v-need-process
     2115               ).
     2116             if v-need-process = true
     2117             then do:
     2118               assign
     2119                 buf_doc-list.is-archive-exist = false
     2120               .
     2121             end.
     2122             else do:
     2123               assign
     2124                 buf_doc-list.is-archive-exist = true
     2125               .
     2126             end.
     2127           end.
     2128           else do:
     2129             assign
     2130               buf_doc-list.is-archive-exist = false
     2131             .
     2132           end.
     2133         end.
     2134       end.
     2135     end.
     2136   end procedure.
     2137   procedure doclslib-clear-ahsp-doc-list :
     2138     define buffer buf_doc-list for doc-list .
     2139     define buffer buf_trn-doc  for ub.trn-doc .
     2140     define buffer buf_doc-line for ub.doc-line .
     2141     define buffer buf_parts    for ub.parts .
     2142     do
     2143     on error undo, return error return-value
     2144     :
     2145       check-doc-list :
     2146       for each buf_doc-list
     2147       on error undo, return error return-value
     2148       :
     2149         find first buf_trn-doc no-lock
     2150           where buf_trn-doc.doc-code = buf_doc-list.doc-code
     2151           .
     2152         if buf_trn-doc.office = true
     2153         then do:
     2154           delete buf_doc-list .
     2155           next check-doc-list .
     2156         end.
     2157         find first buf_doc-line no-lock
     2158           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2159           no-error .
     2160         if not available buf_doc-line
     2161         then do:
     2162           delete buf_doc-list .
     2163           next check-doc-list .
     2164         end.
     2165         find first buf_parts no-lock
     2166           where buf_parts.out-code = buf_trn-doc.doc-code
     2167             and buf_parts.fact-qnty <> 0
     2168           no-error .
     2169         if not available buf_parts
     2170         then do:
     2171           delete buf_doc-list .
     2172           next check-doc-list .
     2173         end.
     2174       end.
     2175     end.
     2176   end procedure.
     2177   procedure doclslib-init-goods :
     2178     define buffer buf_doclslib-goods for doclslib-goods .
     2179     define buffer buf_doc-list       for doc-list .
     2180     define buffer buf_trn-doc        for ub.trn-doc .
     2181     define buffer buf_price-doc      for ub.price-doc .
     2182     define buffer buf_doc-line       for ub.doc-line .
     2183     define buffer buf_price-list     for ub.price-list .
     2184     define variable v-gds-code as integer   no-undo .
     2185     do
     2186     on error undo, return error return-value
     2187     :
     2188       for each buf_doclslib-goods
     2189       on error undo, return error return-value
     2190       :
     2191         delete buf_doclslib-goods .
     2192       end.
     2193       for each buf_doc-list
     2194       on error undo, return error return-value
     2195       :
     2196         if buf_doc-list.is-trn-doc
     2197         then do:
     2198           find first buf_trn-doc no-lock
     2199             where buf_trn-doc.doc-code = buf_doc-list.doc-code
     2200             .
     2201           for each buf_doc-line no-lock
     2202             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2203           on error undo, return error return-value
     2204           :
     2205   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2206   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2207     (input  buf_doc-line.artic
     2208     ,input  buf_doc-line.prod-type
     2209     ,input  buf_doc-line.prod-code
     2210     ,output v-gds-code
     2211     )  .
     2212             find first buf_doclslib-goods
     2213               where buf_doclslib-goods.gds-code = v-gds-code
     2214               no-error .
     2215             if not available buf_doclslib-goods
     2216             then do:
     2217               create buf_doclslib-goods .
     2218               assign
     2219                 buf_doclslib-goods.gds-code  = v-gds-code
     2220                 buf_doclslib-goods.artic     = buf_doc-line.artic
     2221                 buf_doclslib-goods.prod-type = buf_doc-line.prod-type
     2222                 buf_doclslib-goods.prod-code = buf_doc-line.prod-code
     2223               .
     2224             end.
     2225           end.
     2226         end.
     2227         else do:
     2228           find first buf_price-doc no-lock
     2229             where buf_price-doc.doc-num = buf_doc-list.doc-code
     2230             .
     2231           for each buf_price-list no-lock
     2232             where buf_price-list.doc-num = buf_price-doc.doc-num
     2233           on error undo, return error return-value
     2234           :
     2235   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2237     (input  buf_price-list.artic
     2238     ,input  buf_price-list.prod-type
     2239     ,input  buf_price-list.prod-code
     2240     ,output v-gds-code
     2241     )  .
     2242             find first buf_doclslib-goods
     2243               where buf_doclslib-goods.gds-code = v-gds-code
     2244               no-error .
     2245             if not available buf_doclslib-goods
     2246             then do:
     2247               create buf_doclslib-goods .
     2248               assign
     2249                 buf_doclslib-goods.gds-code  = v-gds-code
     2250                 buf_doclslib-goods.artic     = buf_price-list.artic
     2251                 buf_doclslib-goods.prod-type = buf_price-list.prod-type
     2252                 buf_doclslib-goods.prod-code = buf_price-list.prod-code
     2253               .
     2254             end.
     2255           end.
     2256         end.
     2257       end.
     2258     end.
     2259   end procedure.
     2260   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2261   define temp-table temp-pl-gds no-undo   like ub.pl-gds .
     2262   define temp-table temp-prt-obj no-undo   field prt-code         like ub.prt-obj.prt-code     field price-sale       like ub.prt-obj.price-sale   field fact-qnty        like ub.prt-obj.fact-qnty    field price-list-qnty  like ub.prt-obj.fact-qnty    field is-term          as logical   field prt-obj-recid    as recid     field price-list-recid as recid     index xpk is primary unique prt-code   index xie1 is-term .
     2263   procedure prdoclib-process-goods :
     2264     define input  parameter p-obj-type          as character no-undo .
     2265     define input  parameter p-obj-code          as integer   no-undo .
     2266     define input  parameter p-artic             as character no-undo .
     2267     define input  parameter p-prod-type         as character no-undo .
     2268     define input  parameter p-prod-code         as integer   no-undo .
     2269     define input  parameter p-check-price-list  as logical   no-undo .
     2270     define input  parameter p-check-price-parts as logical   no-undo .
     2271     define input  parameter p-doc-num           as character no-undo .
     2272     define input  parameter p-fact-date         as date      no-undo .
     2273     define input  parameter p-corr-user-db-num  as integer   no-undo .
     2274     define input  parameter p-corr-user-name    as character no-undo .
     2275     define input  parameter p-corr-date         as date      no-undo .
     2276     define input  parameter p-corr-time         as integer   no-undo .
     2277     define input  parameter p-corr-time-str     as character no-undo .
     2278     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
     2279     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
     2280     define buffer buf_gds-obj      for ub.gds-obj .
     2281     define buffer buf_prt-obj      for ub.prt-obj .
     2282     define buffer buf_price-list   for ub.price-list .
     2283     define buffer buf_bar-code     for ub.bar-code .
     2284     define buffer buf_temp-prt-obj for temp-prt-obj .
     2285     define variable v-gds-code             like ub.goods.gds-code    no-undo .
     2286     define variable v-root-node            like ub.prt-obj.prt-code  no-undo .
     2287     define variable v-root-b-code          like ub.bar-code.b-code   no-undo .
     2288     define variable v-total-term-fact-qnty like ub.prt-obj.fact-qnty no-undo .
     2289     define variable v-total-fact-sale      like ub.gds-obj.fact-sale no-undo .
     2290     define variable v-doc-num     like ub.price-list.doc-num    no-undo .
     2291     define variable v-price-sale  like ub.price-list.price-sale no-undo .
     2292     define variable v-road-tax    like ub.price-list.road-tax   no-undo .
     2293     define variable v-excise      like ub.price-list.excise     no-undo .
     2294     do
     2295     on error undo, return error return-value
     2296     :
     2297   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2298   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2299     (input  p-artic
     2300     ,input  p-prod-type
     2301     ,input  p-prod-code
     2302     ,output v-root-node
     2303     )  .
     2304   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2305   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscr in g#library
     2306     (input  p-obj-type
     2307     ,input  p-obj-code
     2308     ,input  p-artic
     2309     ,input  p-prod-type
     2310     ,input  p-prod-code
     2311     ,input  v-root-node
     2312     ,buffer buf_gds-obj
     2313     ,buffer buf_prt-obj
     2314     ) no-error .
     2315       if error-status :error
     2316       then do:
     2317         message
     2318           vss-workfile vss-revision vss-description skip
     2319           vss-include-info8 skip
     2320           "Ошибка при начале товародвижения товара на объекте" skip
     2321           "Объект" p-obj-type p-obj-code skip
     2322           "Артикул" p-artic p-prod-type p-prod-code skip
     2323           error-status :get-message(1) skip
     2324           return-value skip
     2325           view-as alert-box error .
     2326         undo, return error .
     2327       end.
     2328       find current buf_gds-obj  exclusive-lock .
