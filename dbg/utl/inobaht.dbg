     1344             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1345             buf_doc-list.doc-type   = ''
     1346             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1347             buf_doc-list.shift-date = buf_price-doc.shift-date
     1348             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1349             buf_doc-list.shift-name = buf_price-doc.shift-name
     1350             buf_doc-list.fact-order = buf_price-doc.fact-order
     1351             buf_doc-list.is-trn-doc = false
     1352           .
     1353         end.
     1354       end.
     1355       else do:
