     1656         end.
     1657         undo, return error return-value .
     1658       end.
     1659       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1660       run gbl/lockrngd.p
     1661         (input  'grgc':U
     1662         ,input  'disable':U
     1663         ,buffer buf_lock_gdsrengc_batchprocess
     1664         ) no-error .
