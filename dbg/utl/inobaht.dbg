     3125                 vss-include-info8 skip
     3126                 "Ошибка при вызове процеды prl-vat" skip
     3127                 "Документ" buf_price-list.doc-num skip
     3128                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
