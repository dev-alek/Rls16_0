        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: pr-del.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/pr-del.p $":U .
        7   define variable vss-description as character no-undo init "Удаление всех незакрытых переоценок".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define input parameter p-install as logical no-undo init no .
       78   do transaction
       79   on error undo, return error return-value
       80   :
       81     on delete of ub.price-doc override do: end.
       82     define stream slog .
       83     define variable v-doc-code as character no-undo .
       84     define buffer buf_price-doc for ub.price-doc .
       85     for each buf_price-doc     where
       86         buf_price-doc.status_ <> 'акт':U
       87         exclusive-lock   :
       88     output stream slog to value('prdocdel.txt':u) append .
       89      v-doc-code = buf_price-doc.doc-num .
       90     if buf_price-doc.status_ = 'разрешен':U then do:
       91     if p-install = false then do:
       92       message
       93         "Переоценка находится в статусе" 'разрешен':U skip
       94         "Если товары на кассе заблокированы" skip
       95         "вам необходимо сделать повторную переоценку по всем товарам" skip
       96         "удаляемой переоценки" skip
       97         "Переоценка" buf_price-doc.doc-num skip
       98         "Объект" buf_price-doc.obj-type buf_price-doc.obj-code skip
       99         "Статус" buf_price-doc.status_ skip
      100         view-as alert-box information .
      101     end.
      102     end.
      103     define buffer buf_clients for ub.clients .
      104     find first buf_clients no-lock
      105       where buf_clients.obj-type = buf_price-doc.obj-type
      106         and buf_clients.obj-code = buf_price-doc.obj-code
      107       no-error .
      108     if available buf_clients
      109     and buf_clients.db-num <> 0 then do:
      110       if p-install = false then do:
      111       message
      112         "Переоценка принадлежит удаленной базе данных" skip
      113         "Возможно переоценка уже была передана в офис" skip
      114         "Свящитесь с администратором ГБД и попросите его удалить данную переоценку в ГБД" skip
      115         "Переоценка" buf_price-doc.doc-num skip
      116         "Объект" buf_price-doc.obj-type buf_price-doc.obj-code skip
      117         "Статус" buf_price-doc.status_ skip
      118         "База данных" buf_clients.db-num skip
      119         view-as alert-box information .
      120       end.
      121     end.
      122     do
      123     on error undo, return error
      124     :
      125       define buffer buf_price-list for ub.price-list  .
      126       for each buf_price-list exclusive-lock
      127         where buf_price-list.doc-num = buf_price-doc.doc-num
      128       :
      129         define buffer buf_gds-obj for ub.gds-obj .
      130         find first buf_gds-obj exclusive-lock
      131           where buf_gds-obj.obj-type  = buf_price-list.obj-type
      132             and buf_gds-obj.obj-code  = buf_price-list.obj-code
      133             and buf_gds-obj.artic     = buf_price-list.artic
      134             and buf_gds-obj.prod-type = buf_price-list.prod-type
      135             and buf_gds-obj.prod-code = buf_price-list.prod-code
      136           no-error .
      137       end.
      138       export stream slog string(today, '99/99/9999') string(time, 'HH:MM:SS') "delete price-doc" buf_price-doc.doc-num .
      139       export stream slog buf_price-doc .
      140       output stream slog close .
      141   define buffer buf_c-price-doc  for ub.c-price-doc  .
      142   define buffer buf_c-price-list for ub.c-price-list  .
      143       create buf_c-price-doc.
      144       BUFFER-COPY buf_price-doc TO buf_c-price-doc
      145       assign
      146         buf_c-price-doc.chip-num           = next-value (s-corr-chip, ub)
      147         buf_c-price-doc.corr-time          = time
      148         buf_c-price-doc.corr-user-db-num   = g#db-num
      149         buf_c-price-doc.corr-man           = g#userid
      150         buf_c-price-doc.corr-date          = today
      151         buf_c-price-doc.is-del             = true
      152       .
      153       output stream slog to value('prdocdel.gds':u) .
      154       output stream slog close .
      155       for each buf_price-list exclusive-lock
      156         where buf_price-list.doc-num = buf_price-doc.doc-num
      157       :
      158         create buf_c-price-list.
      159         BUFFER-COPY buf_price-list TO buf_c-price-list
      160         assign
      161           buf_c-price-list.chip-num           = buf_c-price-doc.chip-num
      162           buf_c-price-list.corr-time           = time
      163           buf_c-price-list.corr-user-db-num    = g#db-num
      164           buf_c-price-list.corr-user-name     = g#userid
      165           buf_c-price-list.corr-date          = today
      166           buf_c-price-list.is-del             = true
      167         .
      168         output stream slog to value('prdocdel.txt':u) append .
      169         export stream slog buf_price-list .
      170         output stream slog close .
      171         output stream slog to value('prdocdel.gds':u) append .
      172         export stream slog buf_price-list.prod-type buf_price-list.prod-code buf_price-list.artic 0 .
      173         output stream slog close .
      174         if buf_price-doc.status_ = 'разрешен':U then do:
      175           find first buf_gds-obj exclusive-lock
      176             where buf_gds-obj.obj-type  = buf_price-list.obj-type
      177               and buf_gds-obj.obj-code  = buf_price-list.obj-code
      178               and buf_gds-obj.artic     = buf_price-list.artic
      179               and buf_gds-obj.prod-type = buf_price-list.prod-type
      180               and buf_gds-obj.prod-code = buf_price-list.prod-code
      181             no-error .
      182           if available buf_gds-obj
      183           and buf_gds-obj.ov-on = true then do:
      184             assign
      185               buf_gds-obj.ov-on = false
      186             .
      187           end.
      188         end.
      189         delete buf_price-list .
      190       end.
      191       delete buf_price-doc .
      192    end.
      193       output stream slog to value('prdocdel.txt':u) append .
      194       export stream slog string(today, '99/99/9999') string(time, 'HH:MM:SS') "finish delete price-doc" v-doc-code .
      195       output stream slog close .
      196     end.
      197       if p-install = false then
      198         message
      199           "Переоценка успешно удалена" skip
      200           "Информация по удаленной переоценке выведена в файл" 'prdocdel.txt':u skip
      201           "Список товаров выведен в файл" 'prdocdel.gds':u skip
      202           view-as alert-box information .
      203   end.
