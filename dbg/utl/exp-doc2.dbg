        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: 0100a4d3b790, 1441, test $":U .
        4   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        5   define variable vss-date        as character no-undo init "$Date: Fri Jun 29 18:00:05 2018 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: exp-doc2.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/exp-doc2.p $":U .
        8   define variable vss-description as character no-undo init "Выгрузка остатков в формате импорта ПН".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68     define variable v-cntxt-db-num        as integer   no-undo .
       69     define variable v-cntxt-userid        as character no-undo .
       70     define variable v-cntxt-level         as character no-undo .
       71     define variable v-cntxt-host-code-obj as integer   no-undo .
       72     define variable v-cntxt-obj-type      as character no-undo .
       73     define variable v-cntxt-obj-code      as integer   no-undo .
       74     define variable v-cntxt-db-num-obj    as integer   no-undo .
       75     define variable v-cntxt-is-admin      as logical   no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77     run mainmenu_getcntxt in parparentproc
       78       (output v-cntxt-db-num
       79       ,output v-cntxt-userid
       80       ,output v-cntxt-level
       81       ,output v-cntxt-host-code-obj
       82       ,output v-cntxt-obj-type
       83       ,output v-cntxt-obj-code
       84       ,output v-cntxt-db-num-obj
       85       ,output v-cntxt-is-admin
       86       ) .
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define new global shared variable g#lib-trn  as handle no-undo .
       90   define new global shared variable g#lib-trn2 as handle no-undo .
       91   define new global shared variable g#lib-trn3 as handle no-undo .
       92   define new global shared variable g#lib-trn4 as handle no-undo .
       93   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   define variable v-waitfram-action01         as character   no-undo .
       95   define variable v-waitfram-action02         as character   no-undo .
       96   define variable v-waitfram-action03         as character   no-undo .
       97   define variable mWaitFramTextBeg            as character   no-undo.
       98   define variable mWaitFramTextEnd            as character   no-undo.
       99   define variable mWaitFramView               as logical     no-undo.
      100   define variable mWaitProcEvent              as logical     no-undo init yes.
      101   define variable mWaitFramInterval           as integer     no-undo init 1 .
      102   define variable mWaitFramStop               as logical     no-undo.
      103   define variable mWaitFramStopUser           as logical     no-undo.
      104   define variable mWaitFramStopTimeOut        as logical     no-undo.
      105   define variable mWaitFramStartProc          as datetime-tz no-undo.
      106   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      107   define button B-WaitFramStop auto-end-key
      108        label "Стоп"
      109        size 10 by 1 tooltip "Остоновить процесс".
      110   define button B-viewProcInfo
      111        label "Информация"
      112        size 15 by 1 tooltip "Информация о процесс".
      113   define frame waitfram
      114     v-waitfram-action01 format "x(72)" no-label skip
      115     v-waitfram-action02 format "x(72)" no-label skip
      116     v-waitfram-action03 format "x(72)" no-label skip
      117     B-viewProcInfo
      118     B-WaitFramStop at row 4 col 30
      119     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      120     .
      121   define new global shared variable mBatchMode as logical no-undo init ?.
      122   define variable mFramBachModHandle as handle no-undo.
      123   mFramBachModHandle = frame waitfram:handle.
      124   define variable mFameOldVis as logical no-undo.
      125   define variable mVisCUrentVin as logical no-undo.
      126   if session:batch-mode
      127   then
      128      mBatchMode = yes.
      129   if mBatchMode = ? then do:
      130     mVisCUrentVin = current-window:visible.
      131     mFameOldVis = mFramBachModHandle:visible.
      132     mFramBachModHandle:visible  = yes.
      133     mBatchMode = mFramBachModHandle:visible ne yes.
      134     mFramBachModHandle:visible = mFameOldVis.
      135     current-window:visible = mVisCUrentVin.
      136   end.
      137    if  log-manager:logfile-name ne ?
      138     then DO:
      139         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      140         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      141         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      142     end.
      143   on choose of B-WaitFramStop in frame waitfram
      144   do:
      145     mWaitFramStop = yes.
      146     mWaitFramStopUser = yes.
      147   end.
      148   function waitfram-check-timeout returns logical():
      149      define variable vtime as int64 no-undo.
      150      if mWaitFramStopTimeOut
      151      then
      152         return yes.
      153      vtime = ( now - mWaitFramStartProc ) / 1000 .
      154      if     mWaitFramTimeOut ne ?
      155         and mWaitFramTimeOut ne 0
      156         and mWaitFramTimeOut lt vtime
      157      then do:
      158         mWaitFramStopTimeOut = yes.
      159      end.
      160      return mWaitFramStopTimeOut.
      161   end.
      162   procedure waitfram-hide :
      163     if not session:batch-mode
      164     then do
      165     on error undo, return error return-value
      166     :
      167       pause 0 before-hide .
      168       if not mBatchMode then
      169         hide frame waitfram .
      170     if     not mWaitFramView
      171        and mWaitProcEvent
      172     then
      173       process events .
      174     end.
      175   end procedure.
      176   procedure waitfram-show :
      177     define input  parameter p-message as character no-undo .
      178     define variable v-left-margin as integer   no-undo .
      179     if not session:batch-mode
      180     then do
      181     on error undo, return error return-value
      182     :
      183       if length(p-message) <= 70 then do:
      184         assign
      185           v-left-margin = integer((70 - length(p-message)) / 2)
      186         .
      187         assign
      188           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      189         .
      190         assign
      191           v-waitfram-action01 = " "
      192           v-waitfram-action02 = " "
      193                                    + fill(" ", v-left-margin)
      194                                    + p-message
      195           v-waitfram-action03 = " "
      196         .
      197       end.
      198       else do:
      199         define variable vRindex1 as integer no-undo.
      200         define variable vRindex2 as integer no-undo.
      201         vRindex1 = r-index(p-message," ",70).
      202         if vRindex1 = 0
      203         then
      204            vRindex1 = 70.
      205         if length(p-message)  <= vRindex1 + 70 then do:
      206           assign
      207             v-waitfram-action01 = " "
      208             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      209             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      210           .
      211         end.
      212         else do:
      213           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      214           if vRindex2 <= vRindex1
      215           then
      216              vRindex2 = vRindex1 + 70.
      217           assign
      218             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      219             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      220             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      221           .
      222         end.
      223       end.
      224       B-viewProcInfo:visible   in frame waitfram = no.
      225       B-viewProcInfo:sensitive in frame waitfram = no.
      226       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      227       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      228       if  (   mWaitFramView
      229          or  mWaitProcEvent)
      230          and not mBatchMode
      231       then
      232          display
      233             v-waitfram-action01 skip
      234             v-waitfram-action02 skip
      235             v-waitfram-action03 skip
      236          with frame waitfram .
      237       if     mWaitFramView
      238          then do:
      239             if     mWaitFramInterval ne ?
      240                and not mBatchMode
      241             then
      242                wait-for go of frame waitfram pause mWaitFramInterval.
      243          end.
      244          else
      245             if     mWaitProcEvent
      246                and not mBatchMode
      247             then
      248                process events .
      249     end.
      250   end procedure.
      251      procedure waitfram-show-this:
      252         define input  parameter iInterval as int64 no-undo.
      253         define variable vtime as int64 no-undo.
      254         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      255         mWaitFramInterval = iInterval.
      256         run waitfram-show (substitute("&1&2 &3&4" ,
      257                                       mWaitFramTextBeg ,
      258                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      259                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      260                                       mWaitFramTextEnd
      261                                      )
      262                           ).
      263      end.
      264      procedure WaitFramRunPause:
      265         define input  parameter iInterval as dec no-undo.
      266         define variable vStart  as datetime-tz no-undo.
      267         define variable vend    as datetime-tz no-undo.
      268         define variable vint as int64 no-undo.
      269         define variable vOk as logical no-undo.
      270         vStart = now.
      271         vend   = vStart.
      272         publish "WaitFramPause" (iInterval,output vOk).
      273         vend   =  now.
      274         vint = vend - vStart.
      275         vint = iInterval - vint / 1000.
      276         if     not mWaitFramStop
      277            and (   vint > 0
      278                 or (    not vOk
      279                     and iInterval eq ?
      280                     )
      281                 )
      282         then
      283            run waitfram-show-this (iInterval).
      284         vend   =  now.
      285         vint = vend - vStart.
      286         vint = iInterval - vint / 1000.
      287         if     not mWaitFramStop
      288            and vint > 0
      289         then do:
      290            run gbl/pause.p (vint * 1000).
      291         end.
      292         if iInterval ne ?
      293         then
      294            publish "WaitFramStop".
      295         waitfram-check-timeout().
      296      end.
      297      procedure WaitFramWaitFor:
      298         define input  parameter iInterval as dec no-undo.
      299         assign
      300            mWaitFramStartProc   = now
      301            mWaitFramStopUser    = no
      302            mWaitFramStopTimeOut = no
      303         .
      304         block-wait:
      305         do while not mWaitFramStop:
      306            run WaitFramRunPause (iInterval).
      307            if  waitfram-check-timeout()
      308            then do:
      309               leave block-wait.
      310            end.
      311         end.
      312         run waitfram-hide.
      313      end.
      314   procedure waitfram-join :
      315     define input  parameter p-line-1  as character no-undo .
      316     define input  parameter p-line-2  as character no-undo .
      317     define input  parameter p-line-3  as character no-undo .
      318     define output parameter p-message as character no-undo .
      319     do
      320     on error undo, return error return-value
      321     :
      322       assign
      323         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      324                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      325                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      326       .
      327     end.
      328   end procedure.
      329   function waitfram-join-function returns character
      330     (input p-line-1 as character
      331     ,input p-line-2 as character
      332     ,input p-line-3 as character
      333     ).
      334     define variable v-message as character no-undo .
      335     run waitfram-join in this-procedure
      336       (input  p-line-1
      337       ,input  p-line-2
      338       ,input  p-line-3
      339       ,output v-message
      340       ) .
      341     return v-message .
      342   end function .
      343   define variable g-log        as logical no-undo .
      344   define variable v-dir-name   as character no-undo .
      345   define variable v-type       as character no-undo .
      346   define variable v-can-write  as logical   no-undo .
      347   define variable c_shift-list as character no-undo .
      348   define variable r_shift-obj  as recid no-undo .
      349   define variable f-name       as character no-undo .
      350   define variable v-shift-start-fact-order  as decimal no-undo .
      351   define variable is-petrolium as logical   no-undo .
      352   define variable is-pieces    as logical   no-undo .
      353   define variable v-unit-base  as character no-undo .
      354   define variable v-host-code  as integer   no-undo .
      355   define variable v-vat-tax-value as decimal no-undo .
      356   define variable v-sum-rubl   as decimal no-undo .
      357   define variable v-fact-qnty  as decimal no-undo .
      358   define variable v-wait-msg   as character no-undo .
      359   define variable v-lines      as integer no-undo .
      360   define variable v-ln-prev    as integer no-undo .
      361   define variable v-tm-prev    as integer no-undo .
      362   define buffer buf_shift-obj for ub.shift-obj .
      363   define buffer buf_gds-obj   for ub.gds-obj .
      364   define buffer buf_goods     for ub.goods .
      365   define buffer buf-stk-line  for ub.stk-line .
      366   define buffer buf_tax-rate-gds   for ub.tax-rate-gds .
      367   define buffer buf_tax-rate-value for ub.tax-rate-value .
      368   define stream f-txt .
      369   g-log = no.
      370   message "Выгрузка остатков в формате импорта ПН" skip (2)
      371           "Продолжать ?"
      372           view-as alert-box question buttons OK-Cancel update g-log.
      373   if not g-log then return.
      374   run gbl/dir-sel.p
      375        ( output v-dir-name
      376         ,output v-type
      377         ,output v-can-write
      378         ).
      379   if NOT v-can-write THEN DO:
      380     message
      381         "Путь для сохранения файлов не указан."
      382         view-as alert-box error.
      383     return.
      384   END.
      385     c_shift-list = "".
      386     run str/sht-all.w
      387       ( parparentproc
      388       , ?
      389       , ?
      390       , "b-sel"
      391       , "all"
      392       ,  v-cntxt-obj-type
      393       ,  v-cntxt-obj-code
      394       ,  ""
      395       ,  input-output c_shift-list
      396       ) no-error.
      397       if error-status:error then do:
      398         message
      399               vss-workfile vss-revision vss-description skip
      400               "Ошибка при выборе смены"  skip
      401               error-status :get-message( 1 ) skip
      402               return-value skip
      403               view-as alert-box error .
      404         return.
      405       end.
      406       if c_shift-list = "":U then do:
      407         message
      408           "Смена не выбрана"
      409         view-as alert-box error.
      410         return.
      411       end.
      412       r_shift-obj = integer(c_shift-list) no-error .
      413       find first buf_shift-obj no-lock where recid (buf_shift-obj) = r_shift-obj no-error .
      414       if available buf_shift-obj then
      415         f-name = substitute("&1\&2&3_&4&5&6_&7.adb", v-dir-name,
      416          buf_shift-obj.obj-type, buf_shift-obj.obj-code,
      417          year(buf_shift-obj.shift-date), month(buf_shift-obj.shift-date), day(buf_shift-obj.shift-date),
      418          buf_shift-obj.shift-num)
      419       no-error .
      420       if error-status:error then do:
      421         message
      422               vss-workfile vss-revision vss-description skip
      423               "Ошибка при поиске смены"  skip
      424               error-status :get-message( 1 ) skip
      425               return-value skip
      426               view-as alert-box error .
      427         return.
      428       end.
      429       define buffer buf_stk-tot for ub.stk-tot .
      430       find last buf_stk-tot no-lock
      431           where buf_stk-tot.obj-type = buf_shift-obj.obj-type
      432             and buf_stk-tot.obj-code = buf_shift-obj.obj-code
      433             and buf_stk-tot.shift-date = buf_shift-obj.shift-date
      434             and buf_stk-tot.shift-num  < buf_shift-obj.shift-num
      435             and buf_stk-tot.shift-num  > 0
      436             and buf_stk-tot.sum-type = 'crsa':U
      437             and buf_stk-tot.cat-id   = '##,##':U
      438       USE-INDEX Shift-num no-error .
      439       if not available buf_stk-tot then do:
      440       find last buf_stk-tot no-lock
      441           where buf_stk-tot.obj-type = buf_shift-obj.obj-type
      442             and buf_stk-tot.obj-code = buf_shift-obj.obj-code
      443             and buf_stk-tot.shift-date < buf_shift-obj.shift-date
      444             and buf_stk-tot.shift-num  > 0
      445             and buf_stk-tot.sum-type = 'crsa':U
      446             and buf_stk-tot.cat-id   = '##,##':U
      447         USE-INDEX Shift-num no-error .
      448       end.
      449       if available buf_stk-tot then v-shift-start-fact-order = buf_stk-tot.Fact-order .
      450       else do:
      451         message
      452           substitute( "Для смены &1 от &2 по объекту &3&4 отсуствуют предшествующие остатки"
      453                     , buf_shift-obj.shift-num
      454                     , buf_shift-obj.shift-date
      455                     , buf_shift-obj.obj-type, buf_shift-obj.obj-code
      456           )
      457         view-as alert-box error .
      458         return .
      459       end .
      460   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      461   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      462     (input  buf_shift-obj.obj-type
      463     ,input  buf_shift-obj.obj-code
      464     ,output v-host-code
      465     )  .
      466       assign
      467         v-wait-msg = "Выгрузка в файл " + f-name + " строк: &1"
      468         v-lines    = 0
      469         v-ln-prev  = v-lines + 100
      470         v-tm-prev  = time + 1
      471       .
      472       run waitfram-show in this-procedure (substitute(v-wait-msg, v-lines)) .
      473       output stream f-txt to value (f-name) .
      474       for each buf_gds-obj no-lock
      475          where buf_gds-obj.obj-type = buf_shift-obj.obj-type
      476            and buf_gds-obj.obj-code = buf_shift-obj.obj-code :
      477   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      478     (
      479        input buf_gds-obj.artic
      480     ,  input buf_gds-obj.prod-type
      481     ,  input buf_gds-obj.prod-code
      482     , output is-petrolium
      483     , output is-pieces
      484     ) .
      485         if is-petrolium then next .
      486         v-lines = v-lines + 1 .
      487         if v-lines > v-ln-prev then do:
      488           v-ln-prev = v-lines + 100.
      489           if v-tm-prev < time then do:
      490             v-tm-prev  = time + 1 .
      491             run waitfram-show in this-procedure (substitute(v-wait-msg, v-lines)) .
      492           end .
      493         end.
      494         find last buf-stk-line no-lock
      495             where buf-stk-line.obj-type = buf_gds-obj.obj-type
      496               and buf-stk-line.obj-code = buf_gds-obj.obj-code
      497               and buf-stk-line.artic     = buf_gds-obj.artic
      498               and buf-stk-line.prod-type = buf_gds-obj.prod-type
      499               and buf-stk-line.prod-code = buf_gds-obj.prod-code
      500               and buf-stk-line.sum-type = 'cost':U
      501               and buf-stk-line.cat-id   = '##,##':U
      502               and buf-stk-line.fact-order <= v-shift-start-fact-order
      503               and buf-stk-line.shift-num  > 0
      504         use-index category no-error .
      505         if available buf-stk-line then assign
      506           v-sum-rubl  = buf-stk-line.sum-rubl
      507           v-fact-qnty = buf-stk-line.fact-qnty
      508         .
      509         else assign
      510           v-sum-rubl  = 0
      511           v-fact-qnty = 0
      512         .
      513         find last buf_tax-rate-gds no-lock
      514             where buf_tax-rate-gds.gds-code  = buf_gds-obj.gds-code
      515               and buf_tax-rate-gds.tax-code  = 1
      516               and buf_tax-rate-gds.host-code = v-host-code
      517               and buf_tax-rate-gds.obj-type  = buf_shift-obj.obj-type
      518               and buf_tax-rate-gds.obj-code  = buf_shift-obj.obj-code
      519               and buf_tax-rate-gds.fact-order <= v-shift-start-fact-order no-error .
      520         if not available buf_tax-rate-gds then
      521         find last buf_tax-rate-gds no-lock
      522             where buf_tax-rate-gds.gds-code  = buf_gds-obj.gds-code
      523               and buf_tax-rate-gds.tax-code  = 1
      524               and buf_tax-rate-gds.host-code = 0
      525               and buf_tax-rate-gds.obj-type  = ''
      526               and buf_tax-rate-gds.obj-code  = 0
      527               and buf_tax-rate-gds.fact-order <= v-shift-start-fact-order no-error.
      528         if available buf_tax-rate-gds then do:
      529           find last buf_tax-rate-value no-lock
      530               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      531                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      532                 and buf_tax-rate-value.host-code = v-host-code
      533                 and buf_tax-rate-value.obj-type  = buf_shift-obj.obj-type
      534                 and buf_tax-rate-value.obj-code  = buf_shift-obj.obj-code
      535                 and buf_tax-rate-value.fact-order <= v-shift-start-fact-order
      536                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      537           if not available buf_tax-rate-value then
      538           find last buf_tax-rate-value no-lock
      539               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      540                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      541                 and buf_tax-rate-value.host-code = v-host-code
      542                 and buf_tax-rate-value.obj-type  = ""
      543                 and buf_tax-rate-value.obj-code  = 0
      544                 and buf_tax-rate-value.fact-order <= v-shift-start-fact-order
      545                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      546           if not available buf_tax-rate-value then
      547           find last buf_tax-rate-value no-lock
      548               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      549                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      550                 and buf_tax-rate-value.host-code = 0
      551                 and buf_tax-rate-value.obj-type  = ""
      552                 and buf_tax-rate-value.obj-code  = 0
      553                 and buf_tax-rate-value.fact-order <= v-shift-start-fact-order
      554                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      555           v-vat-tax-value = if available buf_tax-rate-value then buf_tax-rate-value.rate-value else 0 .
      556         end .
      557         else v-vat-tax-value = 0 .
      558         put stream f-txt unformatted
      559             substitute("ITEM:&1;", buf_gds-obj.artic)
      560              ";"
      561             ";"
      562             ";"
      563             buf_gds-obj.gds-code ";"
      564             (if v-fact-qnty <> 0 then v-sum-rubl / v-fact-qnty else v-sum-rubl) ";"
      565             v-fact-qnty ";"
      566              ";"
      567             ";"
      568             ";"
      569             v-vat-tax-value ";"
      570             ";"
      571             ";"
      572             ";"
      573             ";"
      574             "" skip
      575         .
      576       end .
      577       output stream f-txt close .
      578     run waitfram-hide in this-procedure .
      579   message "Выгрузка закончена." view-as alert-box information buttons ok.
