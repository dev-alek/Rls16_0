     1247     define new shared temp-table  tt-tax no-undo
     1248   field tax-code    like ub.tax.tax-code
     1249   FIELD individual  like ub.tax.individual
     1250   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     1251   field rate-code   like ub.tax-rate.rate-code
     1252   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     1253   FIELD tax-type    like ub.tax.tax-type
     1254   field rate-value  like ub.tax-rate-value.rate-value
     1255   FIELD tax-rate-gds-rc  as recid
     1256   FIELD to-cashdesk like ub.tax.to-cashdesk
     1257   FIELD fact-date like ub.tax-rate-value.fact-date
     1258   FIELD fact-order like ub.tax-rate-value.fact-order
     1259   FIELD next-order like ub.tax-rate-value.fact-order
     1260   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     1261   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     1262   FIELD corr-date like ub.tax-rate-gds.corr-date
     1263   FIELD corr-time like ub.tax-rate-gds.corr-time
     1264   index tax-code is unique primary tax-code fact-order descending rate-code.
