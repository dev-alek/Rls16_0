     2246   message ("Импорт из файла " + f-name + " закончен" + chr(10) + "прочитано " + string(impc) +
     2247            ",  сохранено " + string(impc-saved) + ", предупреждений " + string(impc-Warn) + chr(10) + chr(10) + "Информация по незагруженным товарам находится в файле gds-imp.log" )
     2248   view-as alert-box  INFORMATION.
     2249   release object mWorkSheet.
     2250   mExcelApplication:quit.
     2251   release object mExcelApplication.
