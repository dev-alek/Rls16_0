     1309   define variable i-sert like ub.goods.sert no-undo .
     1310   define variable i-user-rule like ub.goods.user-rule no-undo .
     1311   define variable i-alpha1 like ub.goods.alpha1 no-undo .
     1312   define variable i-grp-code like ub.goods.grp-code no-undo .
     1313   define variable i-service as logical no-undo .
     1314   define variable i-gds-code like ub.goods.gds-code no-undo .
     1315   define variable choice as integer no-undo.
     1316   define variable v-num-fields as integer no-undo .
     1317   define variable p-mark as integer no-undo .
     1318   define variable i-mark as integer  no-undo .
     1319   define variable p-nomcode as integer no-undo .
     1320   define variable i-nomcode as character  no-undo .
     1321   define variable i-ppr as integer no-undo .
     1322   define variable mnewrec as logical no-undo.
     1323   define variable v-host-code     as integer           no-undo.
     1324   define variable v-recid         as recid             no-undo.
     1325   define variable NDS like  tax-rate-value.rate-value  no-undo .
     1326   define variable NP like  tax-rate-value.rate-value  no-undo .
     1327   define variable j-gds-code like goods.gds-code NO-UNDO.
     1328   DEFINE VARIABLE mExcelApplication AS COMPONENT-HANDLE NO-UNDO.
     1329   DEFINE VARIABLE mWorkBook         AS COMPONENT-HANDLE NO-UNDO.
     1330   DEFINE VARIABLE mWorkSheet        AS COMPONENT-HANDLE NO-UNDO.
     1331   DEFINE VARIABLE mMaxNoLine        AS INTEGER          INITIAL 10 NO-UNDO.
     1332   DEFINE VARIABLE vLine   AS INTEGER   NO-UNDO.
     1333   DEFINE VARIABLE vChLine AS CHARACTER NO-UNDO.
     1334   DEFINE VARIABLE vCh     AS CHARACTER NO-UNDO.
     1335   DEFINE VARIABLE v-prod  as character no-undo .
     1336   DEFINE VARIABLE vNoLine AS INTEGER   NO-UNDO.
     1337   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1338   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1339   define variable MarkType as ibs.th.str.marking.Types no-undo.
     1340   MarkType = ObjSrv:Env:Marking:Types.
     1341   define variable MarkTypeStr as character no-undo.
     1342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1343     (input  'is-custm'
     1344     ,input  ''
     1345     ,input  ''
     1346     ,input  0
     1347     ,input  ''
     1348     ,input  ''
     1349     ,input  ''
     1350     ,input  no
     1351     ,output custvalue
     1352     ,output custtype
     1353     ) no-error .
     1354   function f-range returns character(input p-num as integer) :
     1355       case p-num :
     1356           when 1 then return "A":U .
     1357           when 2 then return "B":U .
     1358           when 3 then return "C":U .
     1359           when 4 then return "D":U .
     1360           when 5 then return "E":U .
     1361           when 6 then return "F":U .
     1362           when 7 then return "G":U .
     1363           when 8 then return "H":U .
     1364           when 9 then return "I":U .
     1365           when 10 then return "J":U .
     1366           when 11 then return "K":U .
     1367           when 12 then return "L":U .
     1368           when 13 then return "M":U .
     1369           when 14 then return "N":U .
     1370           when 15 then return "O":U .
     1371           when 16 then return "P":U .
     1372           when 17 then return "Q":U .
     1373           when 18 then return "R":U .
     1374           when 19 then return "S":U .
     1375           when 20 then return "T":U .
     1376       end case .
     1377   end.
     1378   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1379     run mainmenu_getcntxt in parparentproc
     1380       (output v-cntxt-db-num
     1381       ,output v-cntxt-userid
     1382       ,output v-cntxt-level
     1383       ,output v-cntxt-host-code-obj
     1384       ,output v-cntxt-obj-type
     1385       ,output v-cntxt-obj-code
     1386       ,output v-cntxt-db-num-obj
     1387       ,output v-cntxt-is-admin
     1388       ) .
     1389   for each thbjattr_thbj-attr  where
     1390           thbjattr_thbj-attr.obj-type = '':U
     1391       and thbjattr_thbj-attr.obj-code = 0
     1392       and thbjattr_thbj-attr.upper-prop-code = 'gds-ref':U
     1393   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1394   :
     1395     case thbjattr_thbj-attr.prop-code:
     1396       when 'tnvedimp':U then do:
     1397         tnvedimp = thbjattr_thbj-attr.property-value-logical.
     1398       end.
     1399     end case.
     1400   end.
     1401   run ref/strtimp.w (
     1402                          input parparentproc
     1403                         ,yes
     1404                         ,input integer('1':U)
     1405                         ,input integer('2':U)
     1406                         ,input custvalue
     1407                         ,input tnvedimp
     1408                         ,output f-name
     1409                         ,output choice
     1410                         ,output p-artic
     1411                         ,output p-prod
     1412                         ,OUTPUT p-name
     1413                         ,OUTPUT p-engl-name
     1414                         ,OUTPUT p-unit-base
     1415                         ,OUTPUT p-VAT-code
     1416                         ,OUTPUT p-SLT-code
     1417                         ,OUTPUT p-struct
     1418                         ,OUTPUT p-tnved
     1419                         ,OUTPUT p-attrib
     1420                         ,OUTPUT p-destin
     1421                         ,OUTPUT p-sert
     1422                         ,OUTPUT p-user-rule
     1423                         ,OUTPUT p-alpha1
     1424                         ,OUTPUT p-grp-code
     1425                         ,OUTPUT p-service
     1426                         ,OUTPUT p-gds-code
     1427                         ,OUTPUT p-mark
     1428                         ,output p-nomcode
     1429                         ,output p-ppr
     1430                         ) .
     1431   if  error-status:error or f-name = "" then return error.
     1432   CASE choice:
     1433       WHEN 1 then do:
     1434           input stream gds-file from value (f-name) convert source "1251".
     1435       END.
     1436       WHEN 2 then do:
     1437           input stream gds-file from value (f-name) convert source "KOI8-R".
     1438       END.
     1439   END CASE.
     1440   assign
     1441       impc       = 0
     1442       impc-saved = 0
     1443       impc-Warn  = 0
     1444   .
     1445   run waitfram-show in this-procedure ( "ЖДИТЕ...") .
     1446   output stream str-log to value("gds-imp.log") .
     1447   if substring(f-name, length(f-name) - 2) = "xls"
     1448   or substring(f-name, length(f-name) - 3) = "xlsx"
     1449   then do :
     1450       CREATE "Excel.Application":U mExcelApplication.
     1451       if error-status :error then do:
     1452           message
     1453           "Ошибка при запуске Excel" skip
     1454           error-status :get-message(1) skip
     1455           view-as alert-box error .
     1456           undo, return error .
     1457       end.
     1458       ASSIGN
     1459           mExcelApplication:DisplayAlerts = NO
     1460           mWorkbook                       = mExcelApplication:WorkBooks:Add(f-name)
     1461           mWorkSheet                      = mWorkbook:Sheets:Item(1)
     1462       .
     1463       loopbl:
     1464       DO vLine = 1 TO 1000000:
     1465           ASSIGN
     1466               vChLine = STRING(vLine)
     1467               i-artic = ?
     1468               i-alpha1 = ?
     1469               i-attrib = ?
     1470               i-destin = ?
     1471               i-engl-name = ?
     1472               i-gds-name = ?
     1473               i-grp-code = 0
     1474               i-prod-code = ?
     1475               i-prod-type = ?
     1476               i-sert = ?
     1477               i-service = ?
     1478               i-gds-code = ?
     1479               i-SLT-code = ?
     1480               i-struct = ?
     1481               i-tnved = ?
     1482               i-unit-base = ?
     1483               i-user-rule = ?
     1484               i-VAT-code = 0
     1485               i-mark = ?
     1486               i-nomcode = ?
     1487               i-ppr = ?
     1488           .
     1489           i-artic = mWorkSheet:Range(f-range(p-artic) + vChLine):VALUE NO-ERROR.
     1490           if i-artic = ? then i-artic = mWorkSheet:Range(f-range(p-artic) + vChLine):FORMULA NO-ERROR.
     1491           i-artic = entry(1, i-artic, ".") no-error .
     1492           i-alpha1 = mWorkSheet:Range(f-range(p-alpha1) + vChLine):VALUE NO-ERROR.
     1493           if i-alpha1 = ? then i-alpha1 = mWorkSheet:Range(f-range(p-alpha1) + vChLine):FORMULA NO-ERROR.
     1494           i-attrib = mWorkSheet:Range(f-range(p-attrib) + vChLine):VALUE NO-ERROR.
     1495           if i-attrib = ? then i-attrib = mWorkSheet:Range(f-range(p-attrib) + vChLine):FORMULA NO-ERROR.
     1496           i-destin = mWorkSheet:Range(f-range(p-destin) + vChLine):VALUE NO-ERROR.
     1497           if i-destin = ? then i-destin = mWorkSheet:Range(f-range(p-destin) + vChLine):FORMULA NO-ERROR.
     1498           i-engl-name = mWorkSheet:Range(f-range(p-engl-name) + vChLine):VALUE NO-ERROR.
     1499           if i-engl-name = ? then i-engl-name = mWorkSheet:Range(f-range(p-engl-name) + vChLine):FORMULA NO-ERROR.
     1500           i-gds-name = mWorkSheet:Range(f-range(p-name) + vChLine):VALUE NO-ERROR.
     1501           if i-gds-name = ? then i-gds-name = mWorkSheet:Range(f-range(p-name) + vChLine):FORMULA NO-ERROR.
     1502           i-grp-code = integer(mWorkSheet:Range(f-range(p-grp-code) + vChLine):VALUE) NO-ERROR.
     1503           if i-grp-code = ? then i-grp-code = integer(mWorkSheet:Range(f-range(p-grp-code) + vChLine):FORMULA) NO-ERROR.
     1504           v-prod = mWorkSheet:Range(f-range(p-prod) + vChLine):VALUE NO-ERROR.
     1505           if v-prod = ? then v-prod = mWorkSheet:Range(f-range(p-prod) + vChLine):FORMULA NO-ERROR.
     1506           i-prod-code = integer(substring(v-prod, 4)) no-error .
     1507           i-prod-type = substring(v-prod, 1, 3) .
     1508           i-sert = mWorkSheet:Range(f-range(p-sert) + vChLine):VALUE NO-ERROR.
     1509           if i-sert = ? then i-sert = mWorkSheet:Range(f-range(p-sert) + vChLine):FORMULA NO-ERROR.
     1510           i-service = logical(mWorkSheet:Range(f-range(p-service) + vChLine):VALUE) NO-ERROR.
     1511           if i-service = ? then i-service = logical(mWorkSheet:Range(f-range(p-service) + vChLine):FORMULA) NO-ERROR.
     1512           i-gds-code = integer(mWorkSheet:Range(f-range(p-gds-code) + vChLine):VALUE) NO-ERROR.
     1513           if i-gds-code = ? then i-gds-code = integer(mWorkSheet:Range(f-range(p-gds-code) + vChLine):FORMULA) NO-ERROR.
     1514           i-SLT-code = integer(mWorkSheet:Range(f-range(p-SLT-code) + vChLine):VALUE) NO-ERROR.
     1515           if i-SLT-code = ? then i-SLT-code = integer(mWorkSheet:Range(f-range(p-SLT-code) + vChLine):FORMULA) NO-ERROR.
     1516           i-struct = mWorkSheet:Range(f-range(p-struct) + vChLine):VALUE NO-ERROR.
     1517           if i-struct = ? then i-struct = mWorkSheet:Range(f-range(p-struct) + vChLine):FORMULA NO-ERROR.
     1518           i-tnved = mWorkSheet:Range(f-range(p-tnved) + vChLine):VALUE NO-ERROR.
     1519           if i-tnved = ? then i-tnved = mWorkSheet:Range(f-range(p-tnved) + vChLine):FORMULA NO-ERROR.
     1520           i-unit-base = mWorkSheet:Range(f-range(p-unit-base) + vChLine):VALUE NO-ERROR.
     1521           if i-unit-base = ? then i-unit-base = mWorkSheet:Range(f-range(p-unit-base) + vChLine):FORMULA NO-ERROR.
     1522           i-user-rule = mWorkSheet:Range(f-range(p-user-rule) + vChLine):VALUE NO-ERROR.
     1523           if i-user-rule = ? then i-user-rule = mWorkSheet:Range(f-range(p-user-rule) + vChLine):FORMULA NO-ERROR.
     1524           i-VAT-code = integer(mWorkSheet:Range(f-range(p-VAT-code) + vChLine):VALUE) NO-ERROR.
     1525           if i-VAT-code = ? then i-VAT-code = integer(mWorkSheet:Range(f-range(p-VAT-code) + vChLine):FORMULA) NO-ERROR.
     1526           i-mark = integer (mWorkSheet:Range(f-range(p-mark) + vChLine):value) NO-ERROR.
     1527           if i-mark = ? then i-mark = (mWorkSheet:Range(f-range(p-mark) + vChLine):FORMULA) NO-ERROR.
     1528           i-nomcode = mWorkSheet:Range(f-range(p-nomcode) + vChLine):value NO-ERROR.
     1529           if i-nomcode = ? then i-nomcode = (mWorkSheet:Range(f-range(p-nomcode) + vChLine):FORMULA) NO-ERROR.
     1530           i-ppr = integer(mWorkSheet:Range(f-range(p-ppr) + vChLine):VALUE) NO-ERROR.
     1531           if i-ppr = ? then i-ppr = integer(mWorkSheet:Range(f-range(p-ppr) + vChLine):FORMULA) NO-ERROR.
     1532           if length(i-artic) > 0 or length(i-alpha1) > 0 or length(i-attrib) > 0
     1533           or length(i-destin) > 0 or length(i-engl-name) > 0 or length(i-engl-name) > 0
     1534           or length(i-gds-name) > 0 or i-grp-code > 0 or length(i-prod-type) > 0
     1535           or i-prod-code > 0 or length(i-sert) > 0 or i-service <> ? or i-gds-code > 0 or length(i-struct) > 0
     1536           or i-SLT-code > 0 or length(i-tnved) > 0 or length(i-unit-base) > 0
     1537           or length(i-user-rule) > 0 or i-VAT-code > 0
     1538           then vNoLine = 0 .
     1539           else do :
     1540               vNoLine = vNoLine + 1.
     1541               IF vNoLine > mMaxNoLine THEN LEAVE loopbl.
     1542               ELSE NEXT loopbl.
     1543           end.
     1544           if i-gds-code eq ?
     1545              and (i-artic eq ?
     1546                  or  i-prod-type eq ?
     1547                  or  i-prod-code eq ?)
     1548           then do:
     1549               impc = impc + 1 .
     1550               put stream str-log unformatted "В загрузке обязательно должен быть код товара или артикул и производитель. Строка" vLine skip .
     1551               next.
     1552           end.
     1553           else do :
     1554               if     i-gds-code ne ?
     1555                  and i-artic    ne ?
     1556                  and i-prod-type ne ?
     1557                  and i-prod-code ne ?
     1558                and
     1559                can-find(goods where goods.artic eq i-artic
     1560                               and goods.prod-type eq i-prod-type
     1561                               and goods.prod-code eq i-prod-code
     1562                               and goods.gds-code  ne i-gds-code)
     1563               then do:
     1564                   impc = impc + 1 .
     1565                   put stream str-log unformatted "Уже есть товар с артикулом " i-artic "  " i-prod-type " " string(i-prod-code) " Строка  " vLine skip .
     1566                   next.
     1567               end.
     1568           end.
     1569           find first goods where goods.gds-code = i-gds-code no-lock no-error.
     1570           if not available goods
     1571           then
     1572              find first goods where goods.artic     eq i-artic
     1573                                 and goods.prod-type eq i-prod-type
     1574                                 and goods.prod-code eq i-prod-code no-lock no-error.
     1575           if available goods
     1576              and i-unit-base ne ?
     1577              and goods.unit-base ne i-unit-base
     1578           then do:
     1579               impc-Warn = impc-Warn + 1.
     1580               i-unit-base =  goods.unit-base.
     1581               put stream str-log unformatted "Внимание Артикул " goods.artic " .  Единицы измерения изменять нельзя. Единицы измерения проигнорировы.  Строка  " vLine  skip .
     1582           end.
     1583           assign
     1584           impc = impc + 1 .
     1585           do transaction:
     1586   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1588     (input  v-cntxt-obj-type
     1589     ,input  v-cntxt-obj-code
     1590     ,output v-host-code
     1591     )  .
     1592               find last tax-rate-value where
     1593                           tax-rate-value.tax-code = 1 and
     1594                           tax-rate-value.rate-code = i-vat-code no-lock no-error.
     1595               IF available tax-rate-value then do:
     1596                   NDS = tax-rate-value.rate-code.
     1597               END.
     1598               find first gds-grp no-lock where gds-grp.node-code = i-grp-code no-error .
     1599               find first first_gds-grp .
     1600               if i-unit-base ne ?
     1601               then do:
     1602               run ref/dtaxgdss.p (
     1603                     input yes
     1604                   , input   i-unit-base
     1605                   , input   (if available gds-grp
     1606                                 then gds-grp.node-code
     1607                                 else first_gds-grp.node-code)
     1608                   , input if available goods then recid(goods) else ?
     1609                   , input if available goods then recid(goods) else ?
     1610                   , input   v-host-code
     1611                   , input    v-cntxt-obj-type
     1612                   , input    v-cntxt-obj-code
     1613               ) no-error.
     1614               if error-status :error
     1615               then do:
     1616                  put stream str-log unformatted "Артикул " i-artic " .   " replace (return-value,Chr(10)," ")  " Строка  " vLine skip .
     1617                  next loopbl.
     1618               end.
     1619               end.
     1620               IF p-VAT-code > 0 THEN DO:
     1621                   find first tt-tax
     1622                        where tt-tax.tax-code = integer( '1':U )
     1623                   no-error.
     1624                   if available tt-tax   then do:
     1625                       assign
     1626                           tt-tax.rate-code = NDS .
     1627                   end.
     1628               END.
     1629               v-recid = if available goods then recid(goods) else ?.
     1630               mnewrec = not avail goods.
     1631               run ref/goods01.p (
     1632                     input parparentproc
     1633                   , input if available goods then 'АВТОИЗМЕНЕНИЕ':U else 'ДОБАВЛЕНИЕ':U
     1634                   , input no
     1635                   , input 0
     1636                   , input no
     1637                   , input yes
     1638                   , input no
     1639                   , input no
     1640                   , input yes
     1641                   , input v-host-code
     1642                   , input v-cntxt-obj-type
     1643                   , input v-cntxt-obj-code
     1644                   , input (if i-service then no else yes)
     1645                   , input ?
     1646                   , input i-gds-code
     1647                   , input i-artic
     1648                   , input i-prod-type
     1649                   , input i-prod-code
     1650                   , input 1
     1651                   , input i-grp-code
     1652                   , input i-gds-name
     1653                   , input ""
     1654                   , input i-engl-name
     1655                   , input i-gds-name
     1656                   , input replace( replace( i-gds-name, chr( 39 ), "" ), chr( 34 ), "" )
     1657                   , input i-alpha1
     1658                   , input i-unit-base
     1659                   , input i-unit-base
     1660                   , input 0.0
     1661                   , input 0.0
     1662                   , input 1
     1663                   , input 1
     1664                   , input 0
     1665                   , input 0
     1666                   , input 0
     1667                   , input 0
     1668                   , input 'Группа':U
     1669                   , input 0
     1670                   , input no
     1671                   , input (if i-service then 1 else 0)
     1672                   , input (if i-service then 1 else 0)
     1673                   , input ""
     1674                   , input ""
     1675                   , input ""
     1676                   , input ""
     1677                   , input ""
     1678                   , input ""
     1679                   , input 0
     1680                   , input 0
     1681                   , input ""
     1682                   , input 0.0
     1683                   , input 0
     1684                   , input 0
     1685                   , input ""
     1686                   , input ""
     1687                   , input ""
     1688                   , input 0
     1689                   , input ?
     1690                   , input ""
     1691                   , input no
     1692                   , input no
     1693                   , input no
     1694                   , input no
     1695                   , input "no"
     1696                   , input yes
     1697                   , input no
     1698                   , input no
     1699                   , input if i-gds-code > 0 then 2 else 0
     1700                   , input-output v-recid
     1701                   , output j-gds-code
     1702               ) no-error .
     1703               find first goods where recid( goods)  = v-recid    no-lock no-error.
     1704               if error-status :error
     1705                  or not available goods
     1706               then do:
     1707                   put stream str-log unformatted "Ошибка создания/изменении карточки товара. Артикул " i-artic " .   " return-value " Строка  " vLine  skip .
     1708                   next loopbl.
     1709               end.
     1710               else do :
     1711                    def var v-value as char no-undo.
     1712                   def var v-type as char no-undo.
     1713                   if p-mark eq 0
     1714                   then do:
     1715                      if mnewrec
     1716                      then do:
     1717                          define variable mflag as logical no-undo.
     1718                          run gds-attr-exist in this-procedure (goods.gds-code,'mark-type':U,output mflag).
     1719                          if not mflag
     1720                          then do:
     1721                             run ggoattr-value(
     1722                               input i-grp-code,
     1723                               input 0,
     1724                               input "",
     1725                               input 0,
     1726                               input 'gg-mark-type':U,
     1727                               output v-value,
     1728                               output v-type
     1729                             ) no-error.
     1730                             if v-value > "" then do:
     1731                                 run gds-attr-write IN THIS-PROCEDURE(
     1732                                    input goods.gds-code
     1733                                   ,INPUT 'mark-type':U
     1734                                   ,INPUT v-value ) NO-ERROR.
     1735                                 put stream str-log unformatted "Внимание Артикул " goods.artic " .  Признак маркировки установлен с группы Строка " vLine  skip .
     1736                                 impc-Warn = impc-Warn + 1.
     1737                             end.
     1738                         end.
     1739                      end.
     1740                   end.
     1741                   else if i-mark eq ? or i-mark eq 0
     1742                   then do:
     1743                      run gds-attr-delete IN THIS-PROCEDURE(input goods.gds-code
