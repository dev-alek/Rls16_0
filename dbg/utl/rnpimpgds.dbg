      524   procedure grp-obj-notcorr-value :
      525   do
      526   on error undo, return error
      527   :
      528   define input parameter p-node-code             as integer      no-undo.
      529   define input parameter p-obj-type              as character    no-undo.
      530   define input parameter p-obj-code              as integer      no-undo.
      531   define output parameter p-notcorr              as character    no-undo init ?.
      532   define output parameter p-range-notcorr     as integer      no-undo.
      533   define output parameter p-exists-notcorr    as logical      no-undo.
      534   define variable v-host-code as integer      no-undo.
      535   DEFINE VARIABLE v-found as logical no-undo .
      536   DEFINE VARIABLE v-exists as logical no-undo .
      537   DEFINE VARIABLE v-range as integer no-undo .
      538   DEFINE VARIABLE jj as integer no-undo .
      539   DEFINE VARIABLE v-notcorr-found as logical no-undo .
      540   DEFINE VARIABLE v-notcorr-value as char      no-undo.
      541   define buffer buf_gds-grp for ub.gds-grp.
      542   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      543   find first buf_gds-grp no-lock where
      544              buf_gds-grp.node-code = p-node-code no-error .
      545   if not avail buf_gds-grp and p-node-code <> 0 then do:
      546     message
      547       vss-workfile vss-revision vss-description
      548       skip "Не удалось найти группу товаров с кодом" p-node-code
      549       view-as alert-box error .
      550     undo, return error .
      551   end.
      552   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      554     (input  p-obj-type
      555     ,input  p-obj-code
      556     ,output v-host-code
      557     ) no-error .
      558   if error-status :error
      559   then do:
      560       message
      561         vss-workfile vss-revision vss-description
      562         skip "Не удалось найти фирму объекта"
      563         skip p-obj-type p-obj-code
      564         skip return-value
      565         skip trim(error-status :get-message(1))
      566       view-as alert-box error.
      567       undo, return error .
      568   end.
      569   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      570   do while v-found = no and jj < 2:
      571     if v-range <> 3 then do:
      572       find first buf_gds-grp-obj no-lock
      573           where buf_gds-grp-obj.node-code = p-node-code
      574             and buf_gds-grp-obj.host-code = v-host-code
      575             and buf_gds-grp-obj.obj-type  = p-obj-type
      576             and buf_gds-grp-obj.obj-code  = p-obj-code
      577       no-error .
      578     end.
      579     if v-range = 3 or not available buf_gds-grp-obj
      580     then do:
      581        if v-range <> 2 then do:
      582           find first buf_gds-grp-obj no-lock
      583               where buf_gds-grp-obj.node-code = p-node-code
      584                 and buf_gds-grp-obj.host-code = v-host-code
      585                 and buf_gds-grp-obj.obj-type  = ""
      586                 and buf_gds-grp-obj.obj-code  = 0
      587           no-error .
      588         end.
      589         if v-range = 2 or not available buf_gds-grp-obj
      590         then do:
      591             if v-range <> 1 then do:
      592               find first buf_gds-grp-obj no-lock
      593                   where buf_gds-grp-obj.node-code = p-node-code
      594                   and buf_gds-grp-obj.host-code = 0
      595                   and buf_gds-grp-obj.obj-type  = ""
      596                   and buf_gds-grp-obj.obj-code  = 0
      597               no-error .
      598             end.
      599             if v-range = 1 or not available buf_gds-grp-obj
      600             then do:
      601                 assign
      602                     v-exists = no
      603                 .
      604             end.
      605             else do:
      606                 assign
      607                     v-exists = yes
      608                     v-range = 1
      609                 .
      610             end.
      611         end.
      612         else do:
      613             assign
      614                 v-exists = yes
      615                 v-range  = 2
      616             .
      617         end.
      618     end.
      619     else do:
      620         assign
      621             v-exists = yes
      622             v-range  = 3
      623         .
      624     end.
      625     if available buf_gds-grp-obj
      626     then do:
      627       find first buf_gds-grp-obj-attr no-lock
      628         where buf_gds-grp-obj-attr.node-code   = p-node-code
      629           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
      630           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
      631           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
      632           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
      633         no-error .
      634       if available buf_gds-grp-obj-attr then do:
      635         assign
      636           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
      637         .
      638       end.
      639       else do:
      640         assign
      641           v-notcorr-value = ?
      642         .
      643       end.
      644       assign
      645       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
      646                           then yes
      647                           else p-exists-notcorr)
      648       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
      649                         then v-range
      650                         else p-range-notcorr
      651       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
      652                         then v-notcorr-value
      653                         else p-notcorr
      654       v-found =  (p-exists-notcorr ) or (v-range <= 1)
      655       jj = jj + 1
      656       .
      657     end.
      658     else do:
      659       assign
      660       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
      661       jj = jj + 1
      662       .
      663     end.
      664   end.
      665   end.
      666   end procedure.
