        1   block-level on error undo, throw.
        2   define input  parameter p-node-code      like ub.gds-prt.node-code no-undo .
        3   define input  parameter p-sort-level     as integer   no-undo .
        4   define input  parameter p-start-from-max as logical   no-undo .
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: srtgdprt.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: utl/srtgdprt.p $":U .
       10   define variable vss-description as character no-undo initial "Сортировка признаков заданного уровня шкалы".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2':u,p-node-code,p-sort-level)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define temp-table temp-node no-undo   field level-num as integer   field name      as character   index xpk is primary unique level-num name   .
       84   define temp-table temp-node-list no-undo   field node-code as integer   field upper-code as integer   field level-num as integer   field order     as integer   field sort-order as integer   field node-name  as character   index xpk is primary level-num upper-code node-name   index xie1 upper-code node-name   index xie2 node-code   index xie3 sort-order   .
       85   do
       86   on error undo, return error return-value
       87   :
       88     run validate-parameter in this-procedure
       89       (input p-node-code
       90       ,input p-sort-level
       91       ) no-error .
       92     if error-status :error then do:
       93       message
       94         vss-workfile vss-revision vss-description skip
       95         "Ошибка задания входных параметров" skip
       96         error-status :get-message(1) skip
       97         return-value skip
       98         view-as alert-box error .
       99       undo, return error .
      100     end.
      101     define buffer lock_gds-prt for ub.gds-prt .
      102     do transaction
      103     on error undo, return error return-value
      104     :
      105       find first lock_gds-prt exclusive-lock
      106         where lock_gds-prt.node-code = p-node-code
      107         .
      108     end.
      109     run fill-root-level in this-procedure
      110       (input p-node-code
      111       ) no-error .
      112     if error-status :error then do:
      113       message
      114         vss-workfile vss-revision vss-description skip
      115         "Ошибка при проверке целостности шкалы" skip
      116         error-status :get-message(1) skip
      117         return-value skip
      118         view-as alert-box error .
      119       undo, return error .
      120     end.
      121     run fill-levels in this-procedure
      122       (input p-node-code
      123       ,input 1
      124       ,input p-sort-level
      125       ) no-error .
      126     if error-status :error then do:
      127       message
      128         vss-workfile vss-revision vss-description skip
      129         "Ошибка при проверке целостности шкалы" skip
      130         error-status :get-message(1) skip
      131         return-value skip
      132         view-as alert-box error .
      133       undo, return error .
      134     end.
      135     run renumber-level-sort in this-procedure
      136       (input p-sort-level
      137       ,input p-start-from-max
      138       ) .
      139     run store-level-sort in this-procedure
      140       no-error .
      141     if error-status :error then do:
      142       message
      143         vss-workfile vss-revision vss-description skip
      144         "Ошибка при сохранении порядка сортировки" skip
      145         error-status :get-message(1) skip
      146         return-value skip
      147         view-as alert-box error .
      148       undo, return error .
      149     end.
      150   end.
      151   procedure validate-parameter :
      152     define input  parameter p-node-code like ub.gds-prt.node-code no-undo .
      153     define input  parameter p-level     as integer   no-undo .
      154     define buffer buf_gds-prt for ub.gds-prt .
      155     define buffer buf_db for ub.db .
      156     do
      157     on error undo, return error return-value
      158     :
      159       find first buf_gds-prt share-lock
      160         where buf_gds-prt.node-code = p-node-code
      161         no-error .
      162       if not available buf_gds-prt then do:
      163         message
      164           vss-workfile vss-revision vss-description skip
      165           "Ошибка задания входных параметров" skip
      166           "Не найдена шкала" skip
      167           "Номер шкалы" p-node-code skip
      168           view-as alert-box error .
      169         undo, return error .
      170       end.
      171       if buf_gds-prt.root <> true then do:
      172         message
      173           vss-workfile vss-revision vss-description skip
      174           "Ошибка задания входных параметров" skip
      175           "Указан номер не корневого признака" skip
      176           "Номер шкалы" p-node-code skip
      177           view-as alert-box error .
      178         undo, return error .
      179       end.
      180       define variable v-prt-level as integer   no-undo .
      181   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtlevel in g#library
      182     (input  p-node-code
      183     ,output v-prt-level
      184     )  .
      185       if p-level < 1
      186       or p-level >= v-prt-level
      187       then do:
      188         message
      189           vss-workfile vss-revision vss-description skip
      190           "Ошибка задания входных параметров" skip
      191           "Неправильный номер уровня" skip
      192           "Номер шкалы" p-node-code skip
      193           "Размер шкалы" v-prt-level skip
      194           "Задана сортировка уровня" p-level skip
      195           view-as alert-box error .
      196         undo, return error .
      197       end.
      198       define variable v-office as logical   no-undo .
      199   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currdbat in g#library
      201     (input  'office=request':u
      202     ,output v-office
      203     )  .
      204       if v-office = false
      205       then do:
      206         message
      207           vss-workfile vss-revision vss-description skip
      208           "Процедура сортировки шкалы может запускаться только в ГБД"
      209           view-as alert-box error .
      210         undo, return error .
      211       end.
      212     end.
      213   end procedure.
      214   procedure fill-root-level :
      215     define input  parameter p-node-code like ub.gds-prt.node-code no-undo .
      216     define buffer buf_gds-prt for ub.gds-prt .
      217     define buffer buf_temp-node for temp-node .
      218     define buffer buf_temp-node-list for temp-node-list .
      219     do
      220     on error undo, return error return-value
      221     :
      222       find first buf_gds-prt share-lock
      223         where buf_gds-prt.node-code = p-node-code
      224         .
      225       create buf_temp-node .
      226       assign
      227         buf_temp-node.level-num = 0
      228         buf_temp-node.name      = buf_gds-prt.node-name
      229       .
      230       create buf_temp-node-list .
      231       assign
      232         buf_temp-node-list.node-code  = buf_gds-prt.node-code
      233         buf_temp-node-list.upper-code = buf_gds-prt.upper-code
      234         buf_temp-node-list.level-num  = 0
      235         buf_temp-node-list.order      = buf_gds-prt.prt-num
      236         buf_temp-node-list.node-name  = buf_gds-prt.node-name
      237       .
      238     end.
      239   end procedure.
      240   procedure fill-levels :
      241     define input  parameter p-node-code like ub.gds-prt.node-code no-undo .
      242     define input  parameter p-level     as integer   no-undo .
      243     define input  parameter p-prt-level as integer   no-undo .
      244     define buffer buf_gds-prt for ub.gds-prt .
      245     define buffer buf_temp-node for temp-node .
      246     define buffer buf_temp-node-list for temp-node-list .
      247     do
      248     on error undo, return error return-value
      249     :
      250       find first buf_temp-node
      251         where buf_temp-node.level-num = p-level
      252         no-error .
      253       if not available buf_temp-node
      254       then do:
      255         for each buf_gds-prt share-lock
      256           where buf_gds-prt.upper-code = p-node-code
      257         on error undo, return error return-value
      258         :
      259           create buf_temp-node .
      260           assign
      261             buf_temp-node.level-num = p-level
      262             buf_temp-node.name      = buf_gds-prt.node-name
      263           .
      264         end.
      265       end.
      266       for each buf_gds-prt share-lock
      267         where buf_gds-prt.upper-code = p-node-code
      268       on error undo, return error return-value
      269       :
      270         create buf_temp-node-list .
      271         assign
      272           buf_temp-node-list.node-code  = buf_gds-prt.node-code
      273           buf_temp-node-list.upper-code = buf_gds-prt.upper-code
      274           buf_temp-node-list.level-num  = p-level
      275           buf_temp-node-list.order      = buf_gds-prt.prt-num
      276           buf_temp-node-list.sort-order = 0
      277           buf_temp-node-list.node-name  = buf_gds-prt.node-name
      278         .
      279         if p-level < p-prt-level then do:
      280           run fill-levels in this-procedure
      281             (input buf_gds-prt.node-code
      282             ,input p-level + 1
      283             ,input p-prt-level
      284             ) .
      285         end.
      286       end.
      287     end.
      288   end procedure.
      289   procedure renumber-level-sort :
      290     define input  parameter p-level          as integer   no-undo .
      291     define input  parameter p-start-from-max as logical   no-undo .
      292     define variable v-parent-level as integer   no-undo .
      293     define buffer parent_temp-node-list for temp-node-list .
      294     define buffer buf_temp-node-list for temp-node-list .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         v-parent-level = p-level - 1
      300       .
      301       for each parent_temp-node-list
      302         where parent_temp-node-list.level = v-parent-level
      303       on error undo, return error return-value
      304       :
      305         define variable v-sort-ind as integer   no-undo .
      306         assign
      307           v-sort-ind = 1
      308         .
      309         if p-start-from-max = true
      310         then do:
      311           define variable v-node-num  as integer   no-undo .
      312           define variable v-need-sort as logical   no-undo .
      313           define variable v-last-num  as integer   no-undo .
      314           assign
      315             v-node-num  = 1
      316             v-need-sort = false
      317             v-last-num  = 0
      318           .
      319           for each buf_temp-node-list
      320             where buf_temp-node-list.upper-code = parent_temp-node-list.node-code
      321           by buf_temp-node-list.node-name
      322           on error undo, return error return-value
      323           :
      324             if v-sort-ind < buf_temp-node-list.order
      325             then do:
      326               assign
      327                 v-sort-ind = buf_temp-node-list.order
      328               .
      329             end.
      330             assign
      331               v-node-num = v-node-num + 1
      332             .
      333             if buf_temp-node-list.order < v-last-num
      334             or buf_temp-node-list.order < 1
      335             then do:
      336               assign
      337                 v-need-sort = true
      338               .
      339             end.
      340             assign
      341               v-last-num = buf_temp-node-list.order
      342             .
      343           end.
      344           assign
      345             v-sort-ind = v-sort-ind + 1
      346           .
      347           if v-sort-ind < v-node-num
      348           then do:
      349             assign
      350               v-sort-ind = v-node-num
      351             .
      352           end.
      353         end.
      354         else do:
      355           assign
      356             v-need-sort = true
      357           .
      358         end.
      359         if v-need-sort = true then do:
      360           for each buf_temp-node-list
      361             where buf_temp-node-list.upper-code = parent_temp-node-list.node-code
      362           by buf_temp-node-list.node-name
      363           on error undo, return error return-value
      364           :
      365             assign
      366               buf_temp-node-list.sort-order = v-sort-ind
      367             .
      368             assign
      369               v-sort-ind = v-sort-ind + 1
      370             .
      371           end.
      372         end.
      373       end.
      374     end.
      375   end procedure.
      376   procedure store-level-sort :
      377     define buffer buf_temp-node-list for temp-node-list .
      378     define buffer buf_gds-prt for ub.gds-prt .
      379     do
      380     on error undo, return error return-value
      381     :
      382       define variable v-ind          as integer   no-undo .
      383       define variable v-current-time as character no-undo .
      384       define variable v-start-time   as int64     no-undo .
      385       def frame a
      386         v-ind          format ">>>>>>>9"  label "Обработано признаков" skip
      387         v-current-time format "x(8)"      label "Время" skip
      388         with view-as dialog-box side-labels three-d
      389         title "Сохранение порядка сортировки"
      390         .
      391       assign
      392         v-start-time = etime
      393       .
      394       view frame a .
      395       for each buf_temp-node-list
      396         where buf_temp-node-list.sort-order > 0
      397       by buf_temp-node-list.upper-code
      398       on error undo, return error return-value
      399       :
      400         assign
      401           v-ind = v-ind + 1
      402         .
      403         if v-ind modulo 10 = 0
      404         then do:
      405           assign
      406             v-current-time = string( integer(truncate((etime - v-start-time) / 1000, 0)), 'HH:MM:SS':u)
      407           .
      408           display
      409             v-ind
      410             v-current-time
      411             with frame a .
      412         end.
      413         do transaction
      414         on error undo, return error
      415         :
      416           find first buf_gds-prt exclusive-lock
      417             where buf_gds-prt.node-code = buf_temp-node-list.node-code
      418             .
      419           assign
      420             buf_gds-prt.prt-num = buf_temp-node-list.sort-order
      421           .
      422         end.
      423       end.
      424       hide frame a.
      425       pause 0 .
      426     end.
      427   end procedure.
