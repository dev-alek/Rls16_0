        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define  shared stream vProtTest.
       18   define  shared variable testId as rowid no-undo.
       19   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
       20       then run str/lib-trn.p persistent no-error .
       21   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn2)
       22       then run str/lib-trn2.p persistent no-error .
       23   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
       24       then run str/lib-trn3.p persistent no-error .
       25   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn4)
       26       then run str/lib-trn4.p persistent no-error .
       27   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#trdcalib)
       28       then run str/trdcalib.p persistent no-error .
       29   define temp-table tt-utd like ub.utd.
       30   define var v-doc-code as integer no-undo.
       31   if testId <> ? then
       32   do:
       33     find first ub.utd where rowid(ub.utd) = testId no-lock no-error.
       34   end.
       35   else
       36   do:
       37   DEFINE FRAME frame1
       38     v-doc-code format ">>>>>>>>>>>>>>9"
       39     with view-as dialog-box
       40     title "Введите внутр. номер документа"
       41   .
       42   update v-doc-code with frame frame1.
       43   find first ub.utd no-lock where ub.utd.doc-id = v-doc-code no-error .
       44   if not available (ub.utd)
       45     then do:
       46       message "Документ электронного документооборота не найден: номер " v-doc-code view-as alert-box.
       47       return.
       48     end.
       49   end.
       50   find last ub.c-utd no-lock where ub.c-utd.doc-code = ub.utd.doc-code
       51                                and ub.c-utd.db-num = ub.c-utd.db-num no-error .
       52   buffer-copy ub.utd except ub.utd.sts ub.utd.sts-edi to tt-utd  .
       53   if available (ub.c-utd) then do:
       54   assign
       55           tt-utd.sts = ub.c-utd.sts
       56           tt-utd.sts-edi = ub.c-utd.sts-edi
       57   .
       58   end.
       59     run bge\send1cerp.p (?,
       60       this-procedure,
       61       this-procedure,
       62       "edi-doc",
       63       (buffer tt-utd:handle),
       64       (buffer ub.utd:handle),
       65       ?) no-error.
       66   if error-status:error
       67   then do:
       68     message return-value view-as alert-box.
       69   end.
       70   else do:
       71     if testId <> ? then
       72       put stream vProtTest unformatted "Документ ЭД " ub.utd.doc-id " отправлен" skip.
       73     else
       74     message ub.utd.doc-id " отправлен" view-as alert-box.
       75   end.
