        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: put-pr.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/put-pr.p $":U .
        7   define variable vss-description as character no-undo init "Утилита по выгрузке текущих цен по товарам и признакам".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define new global shared variable g#lib-trn  as handle no-undo .
       69   define new global shared variable g#lib-trn2 as handle no-undo .
       70   define new global shared variable g#lib-trn3 as handle no-undo .
       71   define new global shared variable g#lib-trn4 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
       74   define variable gp-price-sale like ub.price-list.price-sale no-undo.
       75   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
       76   define variable gp-excise     like ub.price-list.excise     no-undo.
       77   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
       78   define variable gp-fact-order as decimal   no-undo .
       79   define variable gp-price-sale-parts as decimal   no-undo .
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define variable v-waitfram-action01         as character   no-undo .
       82   define variable v-waitfram-action02         as character   no-undo .
       83   define variable v-waitfram-action03         as character   no-undo .
       84   define variable mWaitFramTextBeg            as character   no-undo.
       85   define variable mWaitFramTextEnd            as character   no-undo.
       86   define variable mWaitFramView               as logical     no-undo.
       87   define variable mWaitProcEvent              as logical     no-undo init yes.
       88   define variable mWaitFramInterval           as integer     no-undo init 1 .
       89   define variable mWaitFramStop               as logical     no-undo.
       90   define variable mWaitFramStopUser           as logical     no-undo.
       91   define variable mWaitFramStopTimeOut        as logical     no-undo.
       92   define variable mWaitFramStartProc          as datetime-tz no-undo.
       93   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       94   define button B-WaitFramStop auto-end-key
       95        label "Стоп"
       96        size 10 by 1 tooltip "Остоновить процесс".
       97   define button B-viewProcInfo
       98        label "Информация"
       99        size 15 by 1 tooltip "Информация о процесс".
      100   define frame waitfram
      101     v-waitfram-action01 format "x(72)" no-label skip
      102     v-waitfram-action02 format "x(72)" no-label skip
      103     v-waitfram-action03 format "x(72)" no-label skip
      104     B-viewProcInfo
      105     B-WaitFramStop at row 4 col 30
      106     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      107     .
      108   define new global shared variable mBatchMode as logical no-undo init ?.
      109   define variable mFramBachModHandle as handle no-undo.
      110   mFramBachModHandle = frame waitfram:handle.
      111   define variable mFameOldVis as logical no-undo.
      112   define variable mVisCUrentVin as logical no-undo.
      113   if session:batch-mode
      114   then
      115      mBatchMode = yes.
      116   if mBatchMode = ? then do:
      117     mVisCUrentVin = current-window:visible.
      118     mFameOldVis = mFramBachModHandle:visible.
      119     mFramBachModHandle:visible  = yes.
      120     mBatchMode = mFramBachModHandle:visible ne yes.
      121     mFramBachModHandle:visible = mFameOldVis.
      122     current-window:visible = mVisCUrentVin.
      123   end.
      124    if  log-manager:logfile-name ne ?
      125     then DO:
      126         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      127         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      128         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      129     end.
      130   on choose of B-WaitFramStop in frame waitfram
      131   do:
      132     mWaitFramStop = yes.
      133     mWaitFramStopUser = yes.
      134   end.
      135   function waitfram-check-timeout returns logical():
      136      define variable vtime as int64 no-undo.
      137      if mWaitFramStopTimeOut
      138      then
      139         return yes.
      140      vtime = ( now - mWaitFramStartProc ) / 1000 .
      141      if     mWaitFramTimeOut ne ?
      142         and mWaitFramTimeOut ne 0
      143         and mWaitFramTimeOut lt vtime
      144      then do:
      145         mWaitFramStopTimeOut = yes.
      146      end.
      147      return mWaitFramStopTimeOut.
      148   end.
      149   procedure waitfram-hide :
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       pause 0 before-hide .
      155       if not mBatchMode then
      156         hide frame waitfram .
      157     if     not mWaitFramView
      158        and mWaitProcEvent
      159     then
      160       process events .
      161     end.
      162   end procedure.
      163   procedure waitfram-show :
      164     define input  parameter p-message as character no-undo .
      165     define variable v-left-margin as integer   no-undo .
      166     if not session:batch-mode
      167     then do
      168     on error undo, return error return-value
      169     :
      170       if length(p-message) <= 70 then do:
      171         assign
      172           v-left-margin = integer((70 - length(p-message)) / 2)
      173         .
      174         assign
      175           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      176         .
      177         assign
      178           v-waitfram-action01 = " "
      179           v-waitfram-action02 = " "
      180                                    + fill(" ", v-left-margin)
      181                                    + p-message
      182           v-waitfram-action03 = " "
      183         .
      184       end.
      185       else do:
      186         define variable vRindex1 as integer no-undo.
      187         define variable vRindex2 as integer no-undo.
      188         vRindex1 = r-index(p-message," ",70).
      189         if vRindex1 = 0
      190         then
      191            vRindex1 = 70.
      192         if length(p-message)  <= vRindex1 + 70 then do:
      193           assign
      194             v-waitfram-action01 = " "
      195             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      197           .
      198         end.
      199         else do:
      200           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      201           if vRindex2 <= vRindex1
      202           then
      203              vRindex2 = vRindex1 + 70.
      204           assign
      205             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      206             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      207             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      208           .
      209         end.
      210       end.
      211       B-viewProcInfo:visible   in frame waitfram = no.
      212       B-viewProcInfo:sensitive in frame waitfram = no.
      213       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      215       if  (   mWaitFramView
      216          or  mWaitProcEvent)
      217          and not mBatchMode
      218       then
      219          display
      220             v-waitfram-action01 skip
      221             v-waitfram-action02 skip
      222             v-waitfram-action03 skip
      223          with frame waitfram .
      224       if     mWaitFramView
      225          then do:
      226             if     mWaitFramInterval ne ?
      227                and not mBatchMode
      228             then
      229                wait-for go of frame waitfram pause mWaitFramInterval.
      230          end.
      231          else
      232             if     mWaitProcEvent
      233                and not mBatchMode
      234             then
      235                process events .
      236     end.
      237   end procedure.
      238      procedure waitfram-show-this:
      239         define input  parameter iInterval as int64 no-undo.
      240         define variable vtime as int64 no-undo.
      241         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      242         mWaitFramInterval = iInterval.
      243         run waitfram-show (substitute("&1&2 &3&4" ,
      244                                       mWaitFramTextBeg ,
      245                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      246                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      247                                       mWaitFramTextEnd
      248                                      )
      249                           ).
      250      end.
      251      procedure WaitFramRunPause:
      252         define input  parameter iInterval as dec no-undo.
      253         define variable vStart  as datetime-tz no-undo.
      254         define variable vend    as datetime-tz no-undo.
      255         define variable vint as int64 no-undo.
      256         define variable vOk as logical no-undo.
      257         vStart = now.
      258         vend   = vStart.
      259         publish "WaitFramPause" (iInterval,output vOk).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and (   vint > 0
      265                 or (    not vOk
      266                     and iInterval eq ?
      267                     )
      268                 )
      269         then
      270            run waitfram-show-this (iInterval).
      271         vend   =  now.
      272         vint = vend - vStart.
      273         vint = iInterval - vint / 1000.
      274         if     not mWaitFramStop
      275            and vint > 0
      276         then do:
      277            run gbl/pause.p (vint * 1000).
      278         end.
      279         if iInterval ne ?
      280         then
      281            publish "WaitFramStop".
      282         waitfram-check-timeout().
      283      end.
      284      procedure WaitFramWaitFor:
      285         define input  parameter iInterval as dec no-undo.
      286         assign
      287            mWaitFramStartProc   = now
      288            mWaitFramStopUser    = no
      289            mWaitFramStopTimeOut = no
      290         .
      291         block-wait:
      292         do while not mWaitFramStop:
      293            run WaitFramRunPause (iInterval).
      294            if  waitfram-check-timeout()
      295            then do:
      296               leave block-wait.
      297            end.
      298         end.
      299         run waitfram-hide.
      300      end.
      301   procedure waitfram-join :
      302     define input  parameter p-line-1  as character no-undo .
      303     define input  parameter p-line-2  as character no-undo .
      304     define input  parameter p-line-3  as character no-undo .
      305     define output parameter p-message as character no-undo .
      306     do
      307     on error undo, return error return-value
      308     :
      309       assign
      310         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      312                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      313       .
      314     end.
      315   end procedure.
      316   function waitfram-join-function returns character
      317     (input p-line-1 as character
      318     ,input p-line-2 as character
      319     ,input p-line-3 as character
      320     ).
      321     define variable v-message as character no-undo .
      322     run waitfram-join in this-procedure
      323       (input  p-line-1
      324       ,input  p-line-2
      325       ,input  p-line-3
      326       ,output v-message
      327       ) .
      328     return v-message .
      329   end function .
      330   define stream out-str.
      331   define buffer buf_db         for ub.db.
      332   define buffer buf_clients    for ub.clients.
      333   define buffer buf_gds-obj    for ub.gds-obj.
      334   define buffer buf_prt-obj    for ub.prt-obj.
      335   define buffer buf_price-doc  for ub.price-doc.
      336   define buffer buf_price-list for ub.price-list.
      337   define buffer buf_bar-code   for ub.bar-code.
      338   define buffer buf_gds-prt    for ub.gds-prt.
      339   define buffer buf_goods      for ub.goods.
      340   define variable varoldcli-type like ub.clients.obj-type initial ? no-undo.
      341   define variable varoldcli-code like ub.clients.obj-code initial ? no-undo.
      342   define variable varempty-scale as logical                         no-undo .
      343   message
      344   "Цены будут выгружены в файлы '<тип объекта>-<код объекта>-pr.adb.'"
      345   view-as alert-box information.
      346   run waitfram-show in this-procedure (input "Выгрузка цен").
      347   for each buf_db no-lock
      348     ,each buf_clients no-lock
      349       where buf_clients.db-num = buf_db.db-num
      350       ,each buf_gds-obj no-lock where buf_gds-obj.obj-type = buf_clients.obj-type and
      351                                       buf_gds-obj.obj-code = buf_clients.obj-code
      352         ,first buf_goods no-lock where buf_goods.artic     = buf_gds-obj.artic     and
      353                                        buf_goods.prod-type = buf_gds-obj.prod-type and
      354                                        buf_goods.prod-code = buf_gds-obj.prod-code
      355          on error undo, return error :
      356       run waitfram-show in this-procedure ("Выгрузка цен по объекту: " + buf_clients.obj-type + " " + string(buf_clients.obj-code) + ". Товар: " + buf_gds-obj.artic + " " + buf_gds-obj.prod-type + " " + string(buf_gds-obj.prod-code)).
      357   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   gp-fact-order = 0 .
      359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      360     (input  buf_gds-obj.gds-code
      361     ,input  ?
      362     ,output gp-b-code
      363     ) no-error .
      364   if error-status:error then do:
      365     message
      366       error-status :get-message(1) skip
      367       return-value skip
      368       view-as alert-box error .
      369     return error.
      370   end.
      371   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      373     (input  buf_clients.obj-type
      374     ,input  buf_clients.obj-code
      375     ,input  gp-b-code
      376     ,input  0
      377     ,input  gp-fact-order
      378     ,output gp-doc-num
      379     ,output gp-price-sale
      380     ,output gp-road-tax
      381     ,output gp-excise
      382     ) no-error .
      383   if error-status:error then do:
      384     return error.
      385   end.
      386   gp-price-sale-parts = gp-price-sale.
      387   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
      389     (input  buf_clients.obj-type
      390     ,input  buf_clients.obj-code
      391     ,input  gp-b-code
      392     ,input  0
      393     ,input  gp-fact-order
      394     ,output gp-doc-num
      395     ,output gp-price-sale-parts
      396     ,output gp-road-tax
      397     ,output gp-excise
      398     ) no-error .
      399   if error-status:error then do:
      400     return error.
      401   end.
      402   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
      403       gp-price-sale = gp-price-sale-parts.
      404    end.
      405       if gp-doc-num    <> ? and
      406          gp-price-sale <> ? and
      407          gp-price-sale <> 0 then do:
      408         if buf_clients.obj-type <> varoldcli-type or
      409            buf_clients.obj-code <> varoldcli-code then do:
      410            output stream out-str close.
      411            output stream out-str to value (buf_clients.obj-type + "-" + string(buf_clients.obj-code) + "-pr.adb").
      412            assign
      413              varoldcli-type = buf_clients.obj-type
      414              varoldcli-code = buf_clients.obj-code.
      415         end.
      416         put stream out-str unformatted "ITEM:" + buf_gds-obj.artic + ";" + string(buf_gds-obj.prod-code) + ";;;" + string(gp-b-code) + ";" + string(gp-price-sale) + ";;" + buf_goods.unit-base + ";1;" + "0;;;;" skip.
      417         for each buf_price-list no-lock where buf_price-list.doc-num    = gp-doc-num            and
      418                                               buf_price-list.main-price = no                    and
      419                                               buf_price-list.artic      = buf_gds-obj.artic     and
      420                                               buf_price-list.prod-type  = buf_gds-obj.prod-type and
      421                                               buf_price-list.prod-code  = buf_gds-obj.prod-code
      422            , first buf_bar-code where buf_bar-code.b-code = buf_price-list.b-code on error undo, return error :
      423            if buf_bar-code.in-code <> "" then do:
      424              put stream out-str unformatted "PART:" + buf_gds-obj.artic + ";" + string(buf_gds-obj.prod-code) + ";" + buf_bar-code.in-code + ";" + buf_bar-code.part-code + ";" + string(buf_price-list.b-code) + ";" + string(buf_price-list.price-sale) + ";;" + buf_bar-code.unit-cli + ";" + string(buf_bar-code.cli-base-rate) + ";" + (if buf_bar-code.cli-base-rate = 1 then "0" else string(buf_price-list.d-pcnt)) + ";;;;" skip.
      425            end.
      426            else do:
      427              find first buf_gds-prt no-lock where buf_gds-prt.node-code = buf_bar-code.node-code.
      428              if buf_gds-prt.upper-code  =  buf_goods.prt-root then do:
      429                put stream out-str unformatted "ITEM:" + buf_gds-obj.artic + ";" + string(buf_gds-obj.prod-code) + ";;;" + string(buf_price-list.b-code) + ";" + string(buf_price-list.price-sale) + ";;" + buf_bar-code.unit-cli + ";" + string(buf_bar-code.cli-base-rate) + ";" + (if buf_bar-code.cli-base-rate = 1 then "0" else string(buf_price-list.d-pcnt)) + ";;;;" skip.
      430              end.
      431              else do:
      432                put stream out-str unformatted "SCALE:" buf_gds-obj.artic + ";" + string(buf_gds-obj.prod-code) + ";" + buf_gds-prt.f-name + ";;" + string(buf_price-list.b-code) + ";" + string(buf_price-list.price-sale) + ";;" + buf_bar-code.unit-cli + ";" + string(buf_bar-code.cli-base-rate) + ";" + (if buf_bar-code.cli-base-rate = 1 then "0" else string(buf_price-list.d-pcnt)) + ";;;;" skip.
      433              end.
      434            end.
      435         end.
      436       end.
      437   end.
      438   run waitfram-hide in this-procedure .
      439   message
      440   "Выгрузка цен закончена."
      441   view-as alert-box.
