        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type as character no-undo .
        3   define input  parameter p-obj-code as integer   no-undo .
        4   define input  parameter p-gds-code as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: arhdate.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/arhdate.p $":U .
       10   define variable vss-description as character no-undo init "Определение даты несоответствия архива и партий ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       73   procedure partslib-clear-temp-parts :
       74     define buffer buf_temp-parts for temp-parts .
       75     do
       76     on error undo, return error
       77     :
       78       for each buf_temp-parts
       79       on error undo, return error
       80       :
       81         delete buf_temp-parts .
       82       end.
       83     end.
       84   end procedure.
       85   procedure partslib-create-temp-parts :
       86     define parameter buffer buf_parts       for ub.parts .
       87     define parameter buffer buf_temp-parts  for temp-parts .
       88     define input  parameter p-goods-twounit as logical   no-undo .
       89     define variable v-base-part-code as character no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       if p-goods-twounit = true
       94       then do:
       95         assign
       96           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
       97         .
       98       end.
       99       else do:
      100         assign
      101           v-base-part-code = buf_parts.part-code
      102         .
      103       end.
      104       find first buf_temp-parts exclusive-lock
      105         where buf_temp-parts.obj-type  = buf_parts.obj-type
      106           and buf_temp-parts.obj-code  = buf_parts.obj-code
      107           and buf_temp-parts.artic     = buf_parts.artic
      108           and buf_temp-parts.prod-type = buf_parts.prod-type
      109           and buf_temp-parts.prod-code = buf_parts.prod-code
      110           and buf_temp-parts.in-code   = buf_parts.in-code
      111           and buf_temp-parts.out-code  = 'free-zone':U
      112           and buf_temp-parts.part-code = v-base-part-code
      113         no-error.
      114       if not available buf_temp-parts
      115       then do:
      116         create buf_temp-parts .
      117         buffer-copy buf_parts to buf_temp-parts
      118         assign
      119           buf_temp-parts.out-code  = 'free-zone':U
      120           buf_temp-parts.part-code = v-base-part-code
      121           buf_temp-parts.rsrv-free = yes
      122           buf_temp-parts.status_   = no
      123           buf_temp-parts.qnty      = 0
      124           buf_temp-parts.fact-qnty = 0
      125           buf_temp-parts.real-qnty = 0
      126           buf_temp-parts.cli-qnty  = 0
      127         .
      128       end.
      129     end.
      130   end procedure.
      131   procedure partslib-init-temp-parts :
      132     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      133     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      134     define input parameter p-artic           like ub.parts.artic     no-undo .
      135     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      136     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      137     define buffer buf_parts      for ub.parts .
      138     define buffer buf_temp-parts for temp-parts .
      139     define variable v-goods-twounit    as logical   no-undo .
      140     do
      141     on error undo, return error
      142     :
      143   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      145     (input  p-artic
      146     ,input  p-prod-type
      147     ,input  p-prod-code
      148     ,input  'twounit=request':u
      149     ,output v-goods-twounit
      150     ) no-error .
      151       if error-status :error
      152       then do:
      153         message
      154           vss-workfile vss-revision vss-description skip
      155           vss-include-info0 skip
      156           "Ошибка при определении атрибута товара" skip
      157           "Артикул" p-artic p-prod-type p-prod-code skip
      158           "twounit=request" skip
      159           error-status :get-message(1) skip
      160           return-value skip
      161           view-as alert-box error .
      162         undo, return error return-value .
      163       end.
      164       run partslib-clear-temp-parts in this-procedure .
      165       for each buf_parts
      166         where buf_parts.obj-type  = p-obj-type
      167           and buf_parts.obj-code  = p-obj-code
      168           and buf_parts.artic     = p-artic
      169           and buf_parts.prod-type = p-prod-type
      170           and buf_parts.prod-code = p-prod-code
      171           and buf_parts.rsrv-free = yes
      172           and buf_parts.status_   = no
      173           and buf_parts.in-code   <> buf_parts.out-code
      174       on error undo, return error
      175       :
      176         run partslib-create-temp-parts in this-procedure
      177           (buffer buf_parts
      178           ,buffer buf_temp-parts
      179           ,input  v-goods-twounit
      180           ) .
      181         define variable v-parts-qnty          as decimal   no-undo .
      182         define variable v-parts-cli-qnty      as decimal   no-undo .
      183         define variable v-parts-free-qnty     as decimal   no-undo .
      184         define variable v-parts-free-cli-qnty as decimal   no-undo .
      185         if buf_parts.out-code = 'free-zone':U
      186         then do:
      187           assign
      188             v-parts-qnty          = buf_parts.qnty
      189             v-parts-cli-qnty      = buf_parts.cli-qnty
      190             v-parts-free-qnty     = buf_parts.qnty
      191             v-parts-free-cli-qnty = buf_parts.cli-qnty
      192           .
      193         end.
      194         else do:
      195           assign
      196             v-parts-qnty          = abs(buf_parts.qnty)
      197             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      198             v-parts-free-qnty     = 0
      199             v-parts-free-cli-qnty = 0
      200           .
      201         end.
      202         assign
      203           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      204           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      205           buf_temp-parts.real-qnty     = 0
      206           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      207           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      208           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      209         .
      210       end.
      211     end.
      212   end procedure.
      213   procedure partslib-init-temp-parts-by-factord :
      214     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      215     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      216     define input parameter p-artic              like ub.parts.artic     no-undo .
      217     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      218     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      219     define input parameter p-fact-order         as decimal   no-undo .
      220     define input parameter p-include-fact-order as logical   no-undo .
      221     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      222     define buffer buf_gds-obj  for ub.gds-obj .
      223     do
      224     on error undo, return error
      225     :
      226       do transaction
      227       on error undo, return error
      228       :
      229   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      230   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      231     (input  p-obj-type
      232     ,input  p-obj-code
      233     ,input  p-artic
      234     ,input  p-prod-type
      235     ,input  p-prod-code
      236     ,buffer buf_gds-obj
      237     ) no-error .
      238         if error-status :error
      239         then do:
      240           message
      241             vss-workfile vss-revision vss-description skip
      242             vss-include-info0 skip
      243             "Невозможно найти товар на объекте" skip
      244             "Объект" p-obj-type p-obj-code skip
      245             "Артикул" p-artic p-prod-type p-prod-code skip
      246             error-status :get-message(1) skip
      247             return-value skip
      248             view-as alert-box error .
      249           undo, return error .
      250         end.
      251         find current buf_gds-obj exclusive-lock .
      252       end.
      253       run partslib-init-temp-parts in this-procedure
      254         (input p-obj-type
      255         ,input p-obj-code
      256         ,input p-artic
      257         ,input p-prod-type
      258         ,input p-prod-code
      259         ) no-error .
      260       if error-status :error
      261       then do:
      262         message
      263           vss-workfile vss-revision vss-description skip
      264           vss-include-info0 skip
      265           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      266           "Объект" p-obj-type p-obj-code skip
      267           "Артикул" p-artic p-prod-type p-prod-code skip
      268           "p-fact-order" p-fact-order skip
      269           view-as alert-box error .
      270         undo, return error .
      271       end.
      272       if p-include-fact-order = true
      273       then do:
      274         assign
      275           p-fact-order = p-fact-order - 0.0000000001
      276         .
      277       end.
      278       define variable v-max-fact-order as character no-undo .
      279       run factord-max-fact-order in this-procedure
      280         (output v-max-fact-order
      281         ) no-error .
      282       if error-status :error
      283       then do:
      284         message
      285           vss-workfile vss-revision vss-description skip
      286           vss-include-info0 skip
      287           "Ошибка при вызове процедуры factord-max-fact-order" skip
      288           "Объект" p-obj-type p-obj-code skip
      289           "Артикул" p-artic p-prod-type p-prod-code skip
      290           "p-fact-order" p-fact-order skip
      291           view-as alert-box error .
      292         undo, return error .
      293       end.
      294       run partslib-update-by-factord in this-procedure
      295         (input p-obj-type
      296         ,input p-obj-code
      297         ,input p-artic
      298         ,input p-prod-type
      299         ,input p-prod-code
      300         ,input p-fact-order
      301         ,input v-max-fact-order
      302         ,input false
      303         ) no-error .
      304       if error-status :error
      305       then do:
      306         message
      307           vss-workfile vss-revision vss-description skip
      308           vss-include-info0 skip
      309           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      310           "Объект" p-obj-type p-obj-code skip
      311           "Артикул" p-artic p-prod-type p-prod-code skip
      312           "p-fact-order" p-fact-order skip
      313           "v-max-fact-order" v-max-fact-order skip
      314           view-as alert-box error .
      315         undo, return error .
      316       end.
      317     end.
      318   end procedure.
      319   procedure partslib-update-by-factord :
      320     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      321     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      322     define input parameter p-artic              like ub.parts.artic     no-undo .
      323     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      324     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      325     define input parameter p-start-fact-order   as decimal   no-undo .
      326     define input parameter p-end-fact-order     as decimal   no-undo .
      327     define input parameter p-lock-gds-obj       as logical   no-undo .
      328     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      329     define buffer buf_gds-obj  for ub.gds-obj .
      330     define buffer buf_doc-line for ub.doc-line .
      331     define variable v-total-parts-qnty as decimal   no-undo .
      332     define variable v-goods-gds-goods  as logical   no-undo .
      333     define variable v-goods-twounit    as logical   no-undo .
      334     do
      335     on error undo, return error
      336     :
      337       if p-start-fact-order > p-end-fact-order
      338       then do:
      339         message
      340           vss-workfile vss-revision vss-description skip
      341           vss-include-info0 skip
      342           "Ошибка задания входных параметров" skip
      343           "Начало интервала превышает конец интервала" skip
      344           "Объект" p-obj-type p-obj-code skip
      345           "Артикул" p-artic p-prod-type p-prod-code skip
      346           "p-start-fact-order" p-start-fact-order skip
      347           "p-end-fact-order"   p-end-fact-order skip
      348           view-as alert-box error .
      349         undo, return error .
      350       end.
      351       if p-lock-gds-obj = true
      352       then do:
      353         do transaction
      354         on error undo, return error
      355         :
      356   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      358     (input  p-obj-type
      359     ,input  p-obj-code
      360     ,input  p-artic
      361     ,input  p-prod-type
      362     ,input  p-prod-code
      363     ,buffer buf_gds-obj
      364     ) no-error .
      365           if error-status :error
      366           then do:
      367             message
      368               vss-workfile vss-revision vss-description skip
      369               vss-include-info0 skip
      370               "Невозможно найти gds-obj" skip
      371               error-status :get-message(1) skip
      372               return-value skip
      373               view-as alert-box error .
      374             undo, return error .
      375           end.
      376           find current buf_gds-obj exclusive-lock .
      377         end.
      378       end.
      379   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      381     (input  p-artic
      382     ,input  p-prod-type
      383     ,input  p-prod-code
      384     ,input  'gds-goods=request':u
      385     ,output v-goods-gds-goods
      386     ) no-error .
      387       if error-status :error
      388       then do:
      389         message
      390           vss-workfile vss-revision vss-description skip
      391           vss-include-info0 skip
      392           "Ошибка при определении атрибута товара" skip
      393           "Артикул" p-artic p-prod-type p-prod-code skip
      394           "gds-goods=request" skip
      395           error-status :get-message(1) skip
      396           return-value skip
      397           view-as alert-box error .
      398         undo, return error return-value .
      399       end.
      400   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      402     (input  p-artic
      403     ,input  p-prod-type
      404     ,input  p-prod-code
      405     ,input  'twounit=request':u
      406     ,output v-goods-twounit
      407     ) no-error .
      408       if error-status :error
      409       then do:
      410         message
      411           vss-workfile vss-revision vss-description skip
      412           vss-include-info0 skip
      413           "Ошибка при определении атрибута товара" skip
      414           "Артикул" p-artic p-prod-type p-prod-code skip
      415           "twounit=request" skip
      416           error-status :get-message(1) skip
      417           return-value skip
      418           view-as alert-box error .
      419         undo, return error return-value .
      420       end.
      421       for each buf_doc-line no-lock
      422         where buf_doc-line.obj-type   = p-obj-type
      423           and buf_doc-line.obj-code   = p-obj-code
      424           and buf_doc-line.artic      = p-artic
      425           and buf_doc-line.prod-type  = p-prod-type
      426           and buf_doc-line.prod-code  = p-prod-code
      427           and buf_doc-line.status_    = 'факт':U
      428           and buf_doc-line.fact-order > p-start-fact-order
      429           and buf_doc-line.fact-order <= p-end-fact-order
      430       on error undo, return error
      431       :
      432         run partslib-process-document in this-procedure
      433           (input  buf_doc-line.doc-code
      434           ,input  p-obj-type
      435           ,input  p-obj-code
      436           ,input  p-artic
      437           ,input  p-prod-type
      438           ,input  p-prod-code
      439           ,input  v-goods-gds-goods
      440           ,input  v-goods-twounit
      441           ,output v-total-parts-qnty
      442           ) no-error .
      443         if error-status :error
      444         then do:
      445           message
      446             vss-workfile vss-revision vss-description skip
      447             vss-include-info0 skip
      448             "Ошибка при вызове процедуры partslib-process-document" skip
      449             "Документ" buf_doc-line.doc-code skip
      450             "Объект" p-obj-type p-obj-code skip
      451             "Артикул" p-artic p-prod-type p-prod-code skip
      452             "p-start-fact-order" p-start-fact-order skip
      453             "p-end-fact-order" p-end-fact-order skip
      454             error-status :get-message(1) skip
      455             return-value skip
      456             view-as alert-box error .
      457           undo, return error return-value .
      458         end.
      459       end.
      460     end.
      461   end procedure.
      462   procedure partslib-process-document :
      463     define input  parameter p-doc-code         as character no-undo .
      464     define input  parameter p-obj-type         as character no-undo .
      465     define input  parameter p-obj-code         as integer   no-undo .
      466     define input  parameter p-artic            as character no-undo .
      467     define input  parameter p-prod-type        as character no-undo .
      468     define input  parameter p-prod-code        as integer   no-undo .
      469     define input  parameter p-goods-gds-goods  as logical   no-undo .
      470     define input  parameter p-goods-twounit    as logical   no-undo .
      471     define output parameter p-total-parts-qnty as decimal   no-undo .
      472     define variable v-parts-sign as integer   no-undo .
      473     define buffer buf_trn-doc    for ub.trn-doc .
      474     define buffer buf_doc-line   for ub.doc-line .
      475     define buffer buf_parts      for ub.parts .
      476     define buffer buf_temp-parts for temp-parts .
      477     do
      478     on error undo, return error return-value
      479     :
      480       find first buf_trn-doc no-lock
      481         where buf_trn-doc.doc-code = p-doc-code
      482         no-error .
      483       if not available buf_trn-doc
      484       then do:
      485         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      486                                      ,p-doc-code
      487                                      ) .
      488       end.
      489       case buf_trn-doc.doc-type
      490       :
      491         when 'при':U or
      492         when 'возврат':U or
      493         when 'инв':U
      494         then do:
      495           assign
      496             v-parts-sign = -1
      497           .
      498         end.
      499         when 'рас':U or
      500         when 'спи':U
      501         then do:
      502           assign
      503             v-parts-sign = 1
      504           .
      505         end.
      506         otherwise do:
      507           undo, return error substitute("Неизвестный тип документа &1"
      508                                       ,buf_trn-doc.doc-type
      509                                       ) .
      510         end.
      511       end.
      512       find first buf_doc-line no-lock
      513         where buf_doc-line.doc-code  = p-doc-code
      514           and buf_doc-line.artic     = p-artic
      515           and buf_doc-line.prod-type = p-prod-type
      516           and buf_doc-line.prod-code = p-prod-code
      517         no-error .
      518       if not available buf_doc-line
      519       then do:
      520         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      521                                      ,p-doc-code
      522                                      ,artic
      523                                      ,prod-type
      524                                      ,prod-code
      525                                      ) .
      526       end.
      527       assign
      528         p-total-parts-qnty = 0
      529       .
      530       if p-goods-gds-goods = true
      531       then do:
      532         for each buf_parts no-lock
      533           where buf_parts.out-code  = p-doc-code
      534             and buf_parts.obj-type  = p-obj-type
      535             and buf_parts.obj-code  = p-obj-code
      536             and buf_parts.artic     = p-artic
      537             and buf_parts.prod-type = p-prod-type
      538             and buf_parts.prod-code = p-prod-code
      539         on error undo, return error
      540         :
      541           run partslib-create-temp-parts in this-procedure
      542             (buffer buf_parts
      543             ,buffer buf_temp-parts
      544             ,input  p-goods-twounit
      545             ) .
      546           assign
      547             p-total-parts-qnty        = p-total-parts-qnty
      548                                       + v-parts-sign * buf_parts.fact-qnty
      549             buf_temp-parts.qnty       = buf_temp-parts.qnty
      550                                       + v-parts-sign * buf_parts.fact-qnty
      551             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      552                                       + v-parts-sign * buf_parts.fact-qnty
      553             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      554                                       + v-parts-sign * buf_parts.cli-qnty
      555           .
      556           if buf_temp-parts.qnty = 0
      557           then do:
      558             delete buf_temp-parts .
      559           end.
      560         end.
      561       end.
      562       else do:
      563         assign
      564           p-total-parts-qnty = p-total-parts-qnty
      565                              + v-parts-sign * buf_doc-line.fact-qnty
      566         .
      567       end.
      568     end.
      569   end procedure.
      570   procedure partslib-init-temp-parts-by-date :
      571     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      572     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      573     define input parameter p-artic           like ub.parts.artic     no-undo .
      574     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      575     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      576     define input parameter p-fact-date       as date      no-undo .
      577     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      578     do
      579     on error undo, return error
      580     :
      581       define variable v-fact-order                as decimal   no-undo .
      582       define variable v-shift-end-fact-order      as decimal   no-undo .
      583       define variable v-day-end-fact-order        as decimal   no-undo .
      584       run factord in this-procedure
      585         (input  p-fact-date
      586         ,input  1
      587         ,input  1
      588         ,input  ?
      589         ,input  0
      590         ,input  false
      591         ,output v-fact-order
      592         ,output v-shift-end-fact-order
      593         ,output v-day-end-fact-order
      594         ) no-error .
      595       if error-status :error
      596       then do:
      597         message
      598           vss-workfile vss-revision vss-description skip
      599           vss-include-info0 skip
      600           "Ошибка при определении момента времени, на который требуется остаток" skip
      601           "Объект" p-obj-type p-obj-code skip
      602           "Артикул" p-artic p-prod-type p-prod-code skip
      603           "Дата" p-fact-date skip
      604           view-as alert-box error .
      605         undo, return error .
      606       end.
      607       run partslib-init-temp-parts-by-factord in this-procedure
      608         (input p-obj-type
      609         ,input p-obj-code
      610         ,input p-artic
      611         ,input p-prod-type
      612         ,input p-prod-code
      613         ,input v-day-end-fact-order
      614         ,input false
      615         ) no-error .
      616       if error-status :error
      617       then do:
      618         message
      619           vss-workfile vss-revision vss-description skip
      620           vss-include-info0 skip
      621           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      622           "Объект" p-obj-type p-obj-code skip
      623           "Артикул" p-artic p-prod-type p-prod-code skip
      624           "Дата" p-fact-date skip
      625           view-as alert-box error .
      626         undo, return error .
      627       end.
      628     end.
      629   end procedure.
      630   procedure partslib-calc-cost :
      631     define output parameter p-fact-qnty      as decimal   no-undo .
      632     define output parameter p-vat-pc         as decimal   no-undo .
      633     define output parameter p-slt-pc         as decimal   no-undo .
      634     define output parameter p-sum-base       as decimal   no-undo .
      635     define output parameter p-sum-rubl       as decimal   no-undo .
      636     define output parameter p-vat-base       as decimal   no-undo .
      637     define output parameter p-vat-rubl       as decimal   no-undo .
      638     define output parameter p-slt-base       as decimal   no-undo .
      639     define output parameter p-slt-rubl       as decimal   no-undo .
      640     define output parameter p-road-tax-base  as decimal   no-undo .
      641     define output parameter p-road-tax-rubl  as decimal   no-undo .
      642     define output parameter p-transport-base as decimal   no-undo .
      643     define output parameter p-transport-rubl as decimal   no-undo .
      644     define output parameter p-other-base     as decimal   no-undo .
      645     define output parameter p-other-rubl     as decimal   no-undo .
      646     define output parameter p-excise-base    as decimal   no-undo .
      647     define output parameter p-excise-rubl    as decimal   no-undo .
      648     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      649     do
      650     on error undo, return error return-value
      651     :
      652       define buffer buf_temp-parts for temp-parts .
      653       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      654       define buffer   in-vatp-parts    for ub.parts   .
      655       define buffer   in-vatp-doc      for ub.trn-doc .
      656       define buffer   in-vatp-goods    for ub.goods   .
      657       define buffer   in-vatp-sysconf  for ub.sysconf .
      658       define buffer   in-vatp_doc-attr for ub.doc-attr.
      659       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      660       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      661       define variable varinvprb                  as   character              no-undo.
      662       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      663       define variable cli-base-rate              as   decimal                no-undo.
      664       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      665       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      666       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      667       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      668       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      669       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      670       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      671       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      672       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      673       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      674       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      675       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      676       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      677       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      678       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      679       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      680       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      681       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      682       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      683       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      684       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      685       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      686       define variable varinvatp-envd             as   character              no-undo.
      687       define variable varinvatp-type             as   character              no-undo.
      688       for each buf_temp-parts
      689       on error undo, return error
      690       :
      691   assign
      692     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      693     price-base-with-tax-loc = buf_temp-parts.price-base
      694   .
      695   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      697     (output varinvprb
      698     )  .
      699     if buf_temp-parts.out-code = 'free-zone':U     or
      700        buf_temp-parts.out-code = 'out-zone':U   or
      701        buf_temp-parts.doc-type = 'акт':U then do:
      702       assign
      703         in-vatp-have-vat-slt = yes.
      704     end.
      705     else do:
      706       find first in-vatp_doc-attr no-lock
      707         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      708           and in-vatp_doc-attr.attr-code = 'envd':U
      709         no-error .
      710       if not available in-vatp_doc-attr then do:
      711         assign
      712           in-vatp-have-vat-slt = yes.
      713       end.
      714       else do:
      715            in-vatp-have-vat-slt = no.
      716       end.
      717     end.
      718     assign
      719      price-cli-with-tax-loc = buf_temp-parts.price-cli
      720      cli-base-rate          = buf_temp-parts.cli-base-rate.
      721     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      722              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      723     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      724             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      725             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      726             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      727             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      728             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      729             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      730       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      731     assign
      732       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      733     assign
      734       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      735       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      736       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      737       transport-cli-loc  = 0
      738       other-cli-loc      = 0
      739     .
      740   ASSIGN
      741             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      742       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      743   .
      744         assign
      745           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      746           p-vat-pc         = p-vat-pc         + vat-pc-loc
      747           p-slt-pc         = p-slt-pc         + slt-pc-loc
      748           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      749           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      750           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      751           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      752           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      753           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      754           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      755           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      756           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      757           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      758           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      759           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      760           p-excise-base    = p-excise-base    + 0
      761           p-excise-rubl    = p-excise-rubl    + 0
      762         .
      763       end.
      764       if p-fact-qnty      = ?
      765       or p-sum-base       = ?
      766       or p-sum-rubl       = ?
      767       or p-vat-base       = ?
      768       or p-vat-rubl       = ?
      769       or p-slt-base       = ?
      770       or p-slt-rubl       = ?
      771       or p-road-tax-base  = ?
      772       or p-road-tax-rubl  = ?
      773       or p-transport-base = ?
      774       or p-transport-rubl = ?
      775       or p-other-base     = ?
      776       or p-other-rubl     = ?
      777       or p-excise-base    = ?
      778       or p-excise-rubl    = ?
      779       then do:
      780         message
      781           vss-workfile vss-revision vss-description skip
      782           vss-include-info0 skip
      783           "Программа in-vatp.i вернула неопределенные значения" skip
      784           "p-fact-qnty"      p-fact-qnty      skip
      785           "p-sum-base"       p-sum-base       skip
      786           "p-sum-rubl"       p-sum-rubl       skip
      787           "p-vat-base"       p-vat-base       skip
      788           "p-vat-rubl"       p-vat-rubl       skip
      789           "p-slt-base"       p-slt-base       skip
      790           "p-slt-rubl"       p-slt-rubl       skip
      791           "p-road-tax-base"  p-road-tax-base  skip
      792           "p-road-tax-rubl"  p-road-tax-rubl  skip
      793           "p-transport-base" p-transport-base skip
      794           "p-transport-rubl" p-transport-rubl skip
      795           "p-other-base"     p-other-base     skip
      796           "p-other-rubl"     p-other-rubl     skip
      797           "p-excise-base"    p-excise-base    skip
      798           "p-excise-rubl"    p-excise-rubl    skip
      799           view-as alert-box error .
      800         undo, return error .
      801       end.
      802     end.
      803   end procedure.
      804   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      805   procedure factord :
      806     define input  parameter p-fact-date            as date    no-undo .
      807     define input  parameter p-fact-time            as integer no-undo .
      808     define input  parameter p-fact-num             as integer no-undo .
      809     define input  parameter p-shift-date           as date    no-undo .
      810     define input  parameter p-shift-num            as integer no-undo .
      811     define input  parameter p-shift-on             as logical no-undo .
      812     define output parameter p-fact-order           as decimal no-undo .
      813     define output parameter p-shift-end-fact-order as decimal no-undo .
      814     define output parameter p-day-end-fact-order   as decimal no-undo .
      815     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      816     if p-fact-date = ?
      817     then do:
      818       return error "Не указана фактическая дата" .
      819     end.
      820     define variable v-fact-date-num as integer no-undo .
      821     assign
      822       v-fact-date-num = integer(p-fact-date)
      823     .
      824     if p-fact-num = ?
      825     or p-fact-num = 0
      826     then do:
      827       return error "Не задан p-fact-num " + string(p-fact-num) .
      828     end.
      829     if p-fact-num < 0
      830     then do:
      831       return error "Отрицательный fact-num " + string(p-fact-num) .
      832     end.
      833     if p-fact-num >= 100000000
      834     then do:
      835       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      836     end.
      837     if p-shift-on = true
      838     then do:
      839       if p-shift-date = ?
      840       then do:
      841         return error "Не задана дата смены" .
      842       end.
      843       if p-shift-num = ?
      844       or p-shift-num = 0
      845       then do:
      846         return error "Не задан номер смены" .
      847       end.
      848     end.
      849     else do:
      850       assign
      851         p-shift-date = p-fact-date
      852         p-shift-num  = 24
      853       .
      854     end.
      855     define variable v-shift-offset as integer no-undo .
      856     if p-shift-date = p-fact-date
      857     then do:
      858       assign
      859         v-shift-offset = 1
      860       .
      861     end.
      862     if p-shift-date < p-fact-date
      863     then do:
      864       assign
      865         v-shift-offset = 0
      866       .
      867     end.
      868     if p-shift-date > p-fact-date
      869     then do:
      870       message
      871         vss-workfile vss-revision vss-description skip
      872         "Неправильная дата закрытия смены" skip
      873         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      874         view-as alert-box error .
      875       undo, return error
      876         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      877           ,string(p-fact-date, '99/99/9999':U)
      878           ,string(p-shift-date, '99/99/9999':U)
      879           )
      880       .
      881     end.
      882     if p-shift-num < 1
      883     or p-shift-num > 24
      884     then do:
      885       message
      886         vss-workfile vss-revision vss-description skip
      887         "Неправильный номер смены" skip
      888         "p-shift-num" p-shift-num skip
      889         view-as alert-box error .
      890       undo, return error return-value .
      891     end.
      892     assign
      893       p-fact-order           = v-fact-date-num
      894                              + v-shift-offset * 0.5
      895                              + p-shift-num    * 0.02 - 0.01
      896                              + p-fact-num     * 0.0000000001
      897       p-shift-end-fact-order = v-fact-date-num
      898                              + v-shift-offset * 0.5
      899                              + p-shift-num    * 0.02
      900       p-day-end-fact-order   = v-fact-date-num
      901                              + 0.99
      902     .
      903     if p-fact-order           <= v-fact-date-num
      904     or p-shift-end-fact-order <= v-fact-date-num
      905     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      906     or p-shift-end-fact-order >= p-day-end-fact-order
      907     then do:
      908       message
      909         vss-workfile vss-revision vss-description skip
      910         "Внутренняя ошибка при генерации фактического номера" skip
      911         "p-fact-date"            p-fact-date            skip
      912         "p-fact-time"            p-fact-time            skip
      913         "p-fact-num"             p-fact-num             skip
      914         "p-shift-date"           p-shift-date           skip
      915         "p-shift-num"            p-shift-num            skip
      916         "p-shift-on"             p-shift-on             skip
      917         "p-shift-end-fact-order" p-shift-end-fact-order skip
      918         "p-day-end-fact-order"   p-day-end-fact-order   skip
      919         "v-fact-date-num"        v-fact-date-num        skip
      920         view-as alert-box error .
      921       undo, return error return-value .
      922     end.
      923   end procedure.
      924   procedure day-begin-fact-order :
      925     define input  parameter p-fact-date            as date    no-undo .
      926     define output parameter p-day-begin-fact-order as decimal no-undo .
      927     do
      928     on error undo, return error return-value
      929     :
      930       if p-fact-date = ?
      931       then do:
      932         assign
      933           p-day-begin-fact-order = 0
      934         .
      935       end.
      936       else do:
      937         assign
      938           p-day-begin-fact-order = integer(p-fact-date)
      939         .
      940       end.
      941     end.
      942   end procedure.
      943   procedure factord-max-fact-order :
      944     define output parameter p-max-fact-order as decimal   no-undo .
      945     do
      946     on error undo, return error return-value
      947     :
      948       run day-begin-fact-order in this-procedure
      949         (input  date(1, 1, 5000)
      950         ,output p-max-fact-order
      951         ) .
      952     end.
      953   end procedure.
      954   procedure factord-cut-archive :
      955     define input  parameter p-obj-type             as character no-undo .
      956     define input  parameter p-obj-code             as integer   no-undo .
      957     define input  parameter p-fact-date            as date      no-undo .
      958     define output parameter p-shift-on             as logical   no-undo .
      959     define output parameter p-shift-date           as date      no-undo .
      960     define output parameter p-shift-num            as integer   no-undo .
      961     define output parameter p-day-end-fact-order   as decimal   no-undo .
      962     define output parameter p-shift-end-fact-order as decimal   no-undo .
      963     define variable v-fact-order as decimal   no-undo .
      964     define buffer buf_shift-obj for ub.shift-obj .
      965     do
      966     on error undo, return error return-value
      967     :
      968   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      969   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      970     (input  p-obj-type
      971     ,input  p-obj-code
      972     ,input  'shift-on=request'
      973     ,output p-shift-on
      974     ) no-error .
      975       if error-status :error
      976       then do:
      977         message
      978           vss-workfile vss-revision vss-description skip
      979           "Ошибка при определении атрибута объекта" skip
      980           "Объект" p-obj-type p-obj-code skip
      981           error-status :get-message(1) skip
      982           return-value skip
      983           view-as alert-box error .
      984         undo, return error return-value .
      985       end.
      986       if p-shift-on = false
      987       then do:
      988         assign
      989           p-shift-date               = ?
      990           p-shift-num                = 0
      991         .
      992       end.
      993       else do:
      994         find first buf_shift-obj share-lock
      995           where buf_shift-obj.obj-type   = p-obj-type
      996             and buf_shift-obj.obj-code   = p-obj-code
      997             and buf_shift-obj.shift-date > p-fact-date
      998           use-index pi
      999           no-error .
     1000         if not available buf_shift-obj
     1001         or buf_shift-obj.status_ <> 'зкр':U
     1002         then do:
     1003           message
     1004             vss-workfile vss-revision vss-description skip
     1005             "Невозможно вычислить последнюю смену" skip
     1006             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1007             "Объект" p-obj-type p-obj-code skip
     1008             "Дата" p-fact-date skip
     1009             view-as alert-box error .
     1010           undo, return error return-value .
     1011         end.
     1012         find last buf_shift-obj share-lock
     1013           where buf_shift-obj.obj-type = p-obj-type
     1014             and buf_shift-obj.obj-code = p-obj-code
     1015             and buf_shift-obj.shift-date <= p-fact-date
     1016           use-index pi
     1017           no-error .
     1018         if available buf_shift-obj
     1019         then do:
     1020           if  buf_shift-obj.status_ = 'зкр':U
     1021           then do:
     1022             assign
     1023               p-shift-date = buf_shift-obj.shift-date
     1024               p-shift-num  = buf_shift-obj.shift-num
     1025             .
     1026           end.
     1027           else do:
     1028             message
     1029               vss-workfile vss-revision vss-description skip
     1030               "Невозможно вычислить последнюю смену" skip
     1031               "Статус смены отличен от статуса" 'зкр':U skip
     1032               "Объект" p-obj-type p-obj-code skip
     1033               "Дата" p-fact-date skip
     1034               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1035               view-as alert-box error .
     1036             undo, return error return-value .
     1037           end.
     1038         end.
     1039         else do:
     1040           assign
     1041             p-shift-date = p-fact-date - 1
     1042             p-shift-num  = 1
     1043           .
     1044         end.
     1045       end.
     1046       run factord in this-procedure
     1047         (input  p-fact-date
     1048         ,input  1
     1049         ,input  1
     1050         ,input  p-shift-date
     1051         ,input  p-shift-num
     1052         ,input  p-shift-on
     1053         ,output v-fact-order
     1054         ,output p-shift-end-fact-order
     1055         ,output p-day-end-fact-order
     1056         ) no-error .
     1057       if error-status :error
     1058       then do:
     1059         message
     1060           vss-workfile vss-revision vss-description skip
     1061           "Ошибка при вызове процедуры factord"
     1062           error-status :get-message(1) skip
     1063           return-value skip
     1064           view-as alert-box error .
     1065         undo, return error return-value .
     1066       end.
     1067     end.
     1068   end procedure.
     1069   procedure factord-lock-shift :
     1070     define input  parameter p-obj-type  as character no-undo .
     1071     define input  parameter p-obj-code  as integer   no-undo .
     1072     define input  parameter p-fact-date as date      no-undo .
     1073     define parameter buffer buf_shift-obj for ub.shift-obj .
     1074     define variable v-shift-on      as logical   no-undo .
     1075     define variable v-extra-message as character no-undo .
     1076     define variable v-error as character no-undo .
     1077     do
     1078     on error undo, return error return-value
     1079     :
     1080   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1082     (input  p-obj-type
     1083     ,input  p-obj-code
     1084     ,input  'shift-on=request'
     1085     ,output v-shift-on
     1086     ) no-error .
     1087       if error-status :error
     1088       then do:
     1089         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1090         undo, return error v-error .
     1091       end.
     1092       if v-shift-on = true
     1093       then do:
     1094         find first buf_shift-obj share-lock
     1095           where buf_shift-obj.obj-type   = p-obj-type
     1096             and buf_shift-obj.obj-code   = p-obj-code
     1097             and buf_shift-obj.shift-date > p-fact-date
     1098           use-index pi
     1099           no-error .
     1100         if not available buf_shift-obj
     1101         or buf_shift-obj.status_ <> 'зкр':U
     1102         then do:
     1103           find last buf_shift-obj
     1104             where buf_shift-obj.obj-type = p-obj-type
     1105               and buf_shift-obj.obj-code = p-obj-code
     1106               and buf_shift-obj.status_  = 'зкр':U
     1107             use-index stts
     1108             no-error .
     1109           if available buf_shift-obj
     1110           then do:
     1111             assign
     1112               v-extra-message =
     1113                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1114                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1115                               )
     1116             .
     1117           end.
     1118           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1119           undo, return error v-error .
     1120         end.
     1121       end.
     1122     end.
     1123   end procedure.
     1124   procedure factord-end-day :
     1125     define input  parameter p-fact-date            as date    no-undo .
     1126     define output parameter p-day-end-fact-order   as decimal no-undo .
     1127     do
     1128     on error undo, return error return-value
     1129     :
     1130       if p-fact-date = ?
     1131       then do:
     1132         return error "Не указана фактическая дата" .
     1133       end.
     1134       assign
     1135         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1136       .
     1137     end.
     1138   end procedure.
     1139   procedure factord-to-date :
     1140     define input  parameter p-fact-order as decimal no-undo .
     1141     define output parameter p-fact-date  as date    no-undo .
     1142     define variable v-ref-date  as date      no-undo .
     1143     define variable v-ref-delta as integer   no-undo .
     1144     do
     1145     on error undo, return error return-value
     1146     :
     1147       if p-fact-order = ?
     1148       or p-fact-order = 0
     1149       then do:
     1150         return error "Не указан fact-order" .
     1151       end.
     1152       assign
     1153         v-ref-date  = date(1, 1, 2000)
     1154       .
     1155       assign
     1156         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1157       .
     1158       assign
     1159         p-fact-date = v-ref-date + v-ref-delta
     1160       .
     1161     end.
     1162   end procedure.
     1163   procedure factord-to-fact-num :
     1164     define input  parameter p-fact-order as decimal no-undo .
     1165     define output parameter p-fact-num   as integer no-undo .
     1166     define variable v-fact-order-trunc as decimal no-undo .
     1167     do
     1168     on error undo, return error return-value
     1169     :
     1170       if p-fact-order = ?
     1171       or p-fact-order = 0
     1172       then do:
     1173         return error "Не указан fact-order" .
     1174       end.
     1175       assign
     1176        v-fact-order-trunc = truncate(p-fact-order, 2)
     1177       .
     1178       assign
     1179         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1180       .
     1181     end.
     1182   end procedure.
     1183   procedure factord-to-shift-num :
     1184     define input  parameter p-fact-order as decimal no-undo .
     1185     define output parameter p-shift-num   as integer no-undo .
     1186     define variable  p-shift-numd  as decimal   no-undo .
     1187     define variable v-fact-order-trunc as decimal no-undo .
     1188     do
     1189     on error undo, return error return-value
     1190     :
     1191       if p-fact-order = ?
     1192       or p-fact-order = 0
     1193       then do:
     1194         return error "Не указан fact-order" .
     1195       end.
     1196       assign
     1197        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1198       .
     1199       if v-fact-order-trunc < 0.5 then do:
     1200         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1201       end.
     1202       assign
     1203         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1204         .
     1205        assign
     1206         p-shift-num = truncate (p-shift-numd , 0)
     1207       .
     1208     end.
     1209   end procedure.
     1210   define buffer buf_goods for ub.goods  .
     1211   define variable v-qnty  as decimal   no-undo .
     1212   find first buf_goods no-lock where
     1213              buf_goods.gds-code = p-gds-code no-error .
     1214   if error-status :error then return error return-value .
     1215   define buffer buf_stk-line for ub.stk-line  .
     1216   for each ub.stk-line no-lock  where
     1217            ub.stk-line.obj-type  = p-obj-type and
     1218            ub.stk-line.obj-code  = p-obj-code and
     1219            ub.stk-line.artic     = buf_goods.artic     and
     1220            ub.stk-line.prod-type = buf_goods.prod-type and
     1221            ub.stk-line.prod-code = buf_goods.prod-code and
     1222            ub.stk-line.sum-type  = 'cost':U and
     1223            ub.stk-line.cat-id    = "##,##"
     1224               by ub.stk-line.fact-order
     1225            :
     1226           find first buf_stk-line no-lock where
     1227            buf_stk-line.obj-type  = p-obj-type and
     1228            buf_stk-line.obj-code  = p-obj-code and
     1229            buf_stk-line.artic     = buf_goods.artic     and
     1230            buf_stk-line.prod-type = buf_goods.prod-type and
     1231            buf_stk-line.prod-code = buf_goods.prod-code and
     1232            buf_stk-line.sum-type  = 'crsa':U and
     1233            buf_stk-line.cat-id    = "##,##"   no-error .
     1234            if not available buf_stk-line then do:
     1235                message "Дата для пересчета архива" ub.stk-line.fact-date  view-as alert-box information .
     1236                return .
     1237            end.
     1238            if ub.stk-line.fact-qnty <> buf_stk-line.fact-qnty
     1239            then do:
     1240                message "Дата для пересчета архива" ub.stk-line.fact-date  view-as alert-box information .
     1241                return .
     1242            end.
     1243           run partslib-clear-temp-parts .
     1244           run partslib-init-temp-parts-by-factord
     1245           (    ub.stk-line.obj-type
     1246              , ub.stk-line.obj-code
     1247              , ub.stk-line.artic
     1248              , ub.stk-line.prod-type
     1249              , ub.stk-line.prod-code
     1250              , ub.stk-line.fact-order
     1251              , false
     1252               ) no-error .
     1253               if error-status :error then message
     1254                 vss-workfile vss-revision vss-description skip
     1255                 error-status :get-message(1) skip
     1256                 return-value skip
     1257                 ""
     1258                 view-as alert-box error
     1259               .
     1260             v-qnty = 0 .
     1261             for each  temp-parts :
     1262                v-qnty = v-qnty + temp-parts.free-qnty .
     1263             end.
     1264             message  v-qnty ub.stk-line.fact-date  ub.stk-line.fact-qnty.
     1265             if v-qnty <> ub.stk-line.fact-qnty then do:
     1266                message "Дата для пересчета архива" ub.stk-line.fact-date  view-as alert-box information .
     1267                return .
     1268             end.
     1269   end.
     1270   message 'ok'  view-as alert-box information .
