        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: exp-chk.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/exp-chk.p $":U .
        7   define variable vss-description as character no-undo init "Экспорт одного чека".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define stream docs.
       67   define stream gdss.
       68   define stream pays.
       69   define stream discnts.
       70   define stream attrs.
       71   DEFINE VARIABLE v-doc-code like ub.chk-doc.doc-code no-undo .
       72   DEFINE VARIABLE loc#log as logical no-undo .
       73   do while true:
       74     run gbl/d-prompt.w (
       75       'title=':u + "Введите номер чека" + '\':u
       76     + 'text1=':u + "Номер чека" + '\':u
       77     + 'format=' + "X(20)" + '\':u
       78     + 'type=' + 'C':U + '\':u
       79     + 'fillin_row=2\':u
       80     + 'fillin_col=4\':u
       81     + 'fillin_width=20\':u
       82     + 'fillin_height=1\':u
       83     + 'max-chars=70\':u
       84     + 'readonly=no' + '\':u
       85     , input-output v-doc-code
       86     ).
       87     if return-value = 'false':u then return.
       88     find first ub.chk-doc no-lock where ub.chk-doc.doc-code = v-doc-code no-error .
       89     if avail ub.chk-doc then LEAVE.
       90     else do:
       91       message
       92       "Нет чека с номером" v-doc-code skip
       93       "Ввести другой номер?"
       94       view-as alert-box question button YES-NO update loc#log.
       95       if not loc#log then return.
       96     end.
       97   end.
       98   output stream docs to value(v-doc-code + ".doc").
       99   output stream gdss to value(v-doc-code + ".gds").
      100   output stream pays to value(v-doc-code + ".pay").
      101   output stream discnts to value(v-doc-code + ".discnt").
      102   output stream attrs to value(v-doc-code + ".attrs").
      103   for each ub.chk-doc no-lock where
      104            ub.chk-doc.doc-code = v-doc-code:
      105     export stream docs chk-doc.
      106     for each ub.chk-gds no-lock where
      107              ub.chk-gds.doc-code = chk-doc.doc-code:
      108       export stream gdss chk-gds.
      109     end.
      110     for each ub.chk-pay no-lock where
      111              ub.chk-pay.doc-code = chk-doc.doc-code:
      112       export stream pays chk-pay.
      113     end.
      114     for each ub.chk-discnt no-lock where
      115              ub.chk-discnt.doc-code = chk-doc.doc-code:
      116       export stream discnts chk-discnt.
      117     end.
      118     for each ub.chk-doc-attr no-lock where
      119              ub.chk-doc-attr.doc-code = chk-doc.doc-code:
      120       export stream attrs chk-doc-attr.
      121     end.
      122   end.
      123   output stream docs close.
      124   output stream gdss close.
      125   output stream pays close.
      126   output stream discnts close.
      127   output stream attrs close.
      128   message
      129   "Содержимое чека экспортировано в файлы" string(v-doc-code + ".*":U)
      130   view-as alert-box .
