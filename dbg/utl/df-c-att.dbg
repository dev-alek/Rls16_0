      416   DEFINE VARIABLE v-all AS LOGICAL INITIAL yes
      417        LABEL "В один файл new.df"
      418        VIEW-AS TOGGLE-BOX
      419        SIZE 20.6 BY .81 NO-UNDO.
      420   DEFINE QUERY BR-file FOR
      421         tt-file SCROLLING.
      422   DEFINE BROWSE BR-file
      423     QUERY BR-file NO-LOCK DISPLAY
      424         tt-file._File-Number column-label "№"
      425         tt-file._File-Name   column-label "Таблица"
      426         tt-file.f-attr column-label "Атр" view-as toggle-box
      427         tt-file.f-c column-label "Ист" view-as toggle-box
      428   ENABLE
      429         tt-file.f-attr
      430         tt-file.f-c
      431       WITH NO-ROW-MARKERS SEPARATORS SIZE 52.6 BY 16.52 FIT-LAST-COLUMN.
      432   DEFINE FRAME Dialog-Frame
      433        b-exit AT ROW 1 COL 1
      434        b-export AT ROW 1 COL 11 WIDGET-ID 4
      435        b-help AT ROW 1 COL 43.6
      436        v-all AT ROW 1.1 COL 22 WIDGET-ID 2
      437        b-sel-all-c AT ROW 2 COL 11 WIDGET-ID 8
      438        b-sel-all-attr AT ROW 2 COL 21 WIDGET-ID 6
      439        b-drop-all-c AT ROW 3 COL 11 WIDGET-ID 16
      440        b-drop-all-attr AT ROW 3 COL 21 WIDGET-ID 18
      441        BR-file AT ROW 4 COL 1 WIDGET-ID 200
      442        "Выделить" VIEW-AS TEXT
      443             SIZE 8 BY .67 AT ROW 2.24 COL 2 WIDGET-ID 12
      444        "Сбросить" VIEW-AS TEXT
      445             SIZE 8 BY .67 AT ROW 3.24 COL 2 WIDGET-ID 14
      446        SPACE(43.63) SKIP(16.66)
      447       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      448            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      449            TITLE "Таблицы"
      450            DEFAULT-BUTTON b-exit WIDGET-ID 100.
      451   ASSIGN
      452          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      453          FRAME Dialog-Frame:HIDDEN           = TRUE.
      454   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      455   DO:
      456     APPLY "END-ERROR":U TO SELF.
      457   END.
      458   ON CHOOSE OF b-drop-all-attr IN FRAME Dialog-Frame
