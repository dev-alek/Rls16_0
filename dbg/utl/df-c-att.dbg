      388         field f-name      as CHARACTER
      389   INDEX pi IS PRIMARY UNIQUE
      390         f-name
      391       .
      392   define stream st-out.
      393   DEFINE BUTTON b-drop-all-attr
      394        LABEL "все атр."
      395        SIZE 10 BY 1.
      396   DEFINE BUTTON b-drop-all-c
      397        LABEL "все ист."
      398        SIZE 10 BY 1.
      399   DEFINE BUTTON b-exit AUTO-GO
      400        LABEL "Выход"
      401        SIZE 10 BY 1
      402        BGCOLOR 8 .
      403   DEFINE BUTTON b-export
      404        LABEL "Выгрузить"
      405        SIZE 10 BY 1.
      406   DEFINE BUTTON b-help
      407        LABEL "Помо&щь"
      408        SIZE 10 BY 1
