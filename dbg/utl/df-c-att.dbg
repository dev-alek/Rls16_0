        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Создание df для таблиц истории и атрибутов".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
