      501      RUN enable_UI.
      502      RUN post-enable_UI IN THIS-PROCEDURE .
      503   END.
      504   ON ROW-DISPLAY OF BR-file IN FRAME Dialog-Frame
      505   DO:
      506      IF  tt-file.f-c-old = FALSE
      507      AND tt-file.f-c     = TRUE
      508      then do:
      509         assign
      510            tt-file.f-c:bgcolor    in browse br-file = GRAY_COLOR
      511         .
      512      end.
      513      IF  tt-file.f-attr-old = FALSE
      514      AND tt-file.f-attr     = TRUE
      515      then do:
      516         assign
      517            tt-file.f-attr:bgcolor in browse br-file = GRAY_COLOR
      518         .
      519      end.
      520   END.
      521   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      522   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      523   ON "value-changed" OF tt-file.f-attr  IN BROWSE br-file
      524   DO:
      525      define variable v-ok    as logical      no-undo.
      526      IF tt-file.f-attr-old = TRUE THEN dO:
      527         assign
      528            tt-file.f-attr:SCREEN-VALUE in browse br-file = STRING(tt-file.f-attr-old)
      529            tt-file.f-attr = tt-file.f-attr-old
      530         .
      531            APPLY "LEAVE" TO tt-file.f-attr in browse br-file.
      532         RETURN.
      533      END.
      534   END.
      535   ON "value-changed" OF tt-file.f-c  IN BROWSE br-file
      536   DO:
      537      define variable v-ok    as logical      no-undo.
      538      IF tt-file.f-c-old = TRUE THEN dO:
      539         assign
      540            tt-file.f-c:SCREEN-VALUE in browse br-file = STRING(tt-file.f-c-old)
      541            tt-file.f-c = tt-file.f-c-old
      542         .
      543         APPLY "LEAVE" TO tt-file.f-c in browse br-file.
      544         RETURN.
      545      END.
      546   END.
      547   MAIN-BLOCK:
      548   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      549      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      550     run fill-file in this-procedure .
      551     RUN enable_UI.
      552     RUN post-enable_UI IN THIS-PROCEDURE .
      553     WAIT-FOR GO OF FRAME Dialog-Frame.
      554   END.
      555   RUN disable_UI.
      556   PROCEDURE add-all-attr :
      557   define variable v-trig-delete     as character    no-undo.
      558   define variable v-trig-write     as character    no-undo.
      559   do
      560   on error undo, return error
      561   :
      562      for each  tt-file
      563          where tt-file.f-attr-old = FALSE
      564            AND tt-file.f-attr     = TRUE
      565          no-lock
      566          :
      567          RUN add-attr  IN THIS-PROCEDURE ( INPUT tt-file._File-Number ) .
      568      end.
      569   end.
      570   END PROCEDURE.
      571   PROCEDURE add-attr :
      572   define input parameter p-number as integer no-undo .
      573   define variable v-file-name     as character    no-undo.
      574   define variable v-trig-name     as character    no-undo.
      575   define variable v-log-gds-code     as LOGICAL    no-undo.
      576   define variable v-log-host-code     as LOGICAL    no-undo.
      577   define variable v-log-obj-code     as LOGICAL    no-undo.
      578   define variable v-log-b-code     as LOGICAL    no-undo.
      579   define variable v-log-doc-code     as LOGICAL    no-undo.
      580   define variable V-LOG-wth-CODE     as LOGICAL    no-undo.
      581   define variable v-log-rvs-code     as LOGICAL    no-undo.
      582   define variable v-log-artic     as LOGICAL    no-undo.
      583   define variable v-log-doc-num     as LOGICAL    no-undo.
      584   DEFINE VARIABLE v-idx-c AS INTEGER NO-UNDO .
      585   define buffer buf__Field      for _Field .
      586   do
      587   on error undo, return error
      588   :
      589       ASSIGN
      590           v-log-gds-code = FALSE
      591           v-log-host-code = FALSE
      592           v-log-obj-code = FALSE
      593           v-log-b-code   = FALSE
      594           v-log-doc-code = FALSE
      595           V-LOG-wth-CODE = FALSE
      596           v-log-rvs-code = FALSE
      597           v-idx-c = 0
      598      .
      599           FIND FIRST _file
      600            where _file._File-Number = p-number
      601            no-lock
      602            .
      603       run trig-name in this-procedure
      604          ( input _file._File-Name
      605          , output v-trig-name
      606          ) .
      607       IF v-all THEN DO:
      608         assign
      609         v-file-name = SUBSTITUTE("new.df")
      610         .
      611       END.
      612       ELSE DO:
      613         assign
      614            v-file-name = SUBSTITUTE("&1-attr.df", _file._File-Name)
      615         .
      616       END.
      617       for first _index
      618           where recid( _index  ) = _file._prime-index
      619             and LC( _index._index-name ) <> "default":U
      620           no-lock
      621           ,
      622           each _index-field of _index
      623           no-lock
      624           ,
      625           each _field of _index-field
      626           no-lock
      627           break by _index-seq
      628         :
      629           ASSIGN
      630                 v-idx-c = v-idx-c + 1
      631           .
      632       END.
      633       IF v-idx-c >= 16 THEN DO:
      634           MESSAGE "В таблице "
      635               _File._File-Name
      636               " первичный ключ шестнадцать полей."
      637               SKIP "Создание таблицы атрибутов невозможно."
      638               VIEW-AS ALERT-BOX.
      639           NEXT.
      640       END.
      641       output stream st-out to value(v-file-name) append .
      642       put stream st-out unformatted
      643           'ADD TABLE "' + _File._File-Name + '-attr"' + chr(10)
      644         + '  AREA "Schema Area"' + chr(10)
      645         + '  CAN-READ "!,*"' + chr(10)
      646         + '  CAN-WRITE "!,!odbc,*"' + chr(10)
      647         + '  CAN-CREATE "!,!odbc,*"' + chr(10)
      648         + '  CAN-DELETE "!,!odbc,*"' + chr(10)
      649         + '  CAN-DUMP "!odbc,*"' + chr(10)
      650         + '  CAN-LOAD "!odbc,*"' + chr(10)
      651         + '  LABEL "ABC анализ"' + chr(10)
      652         + SUBSTITUTE('  DUMP-NAME "&1"', SUBSTRING(v-trig-name, 5, 8)) + chr(10)
      653         + Substitute('  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "&1d.p" CRC "?"', v-trig-name) + chr(10)
      654         + Substitute('  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "&1w.p" CRC "?"', v-trig-name) + chr(10)
      655         + chr(10)
      656         .
      657       field-block:
      658       for first _index
      659           where recid( _index  ) = _file._prime-index
      660             and LC( _index._index-name ) <> "default":U
      661           no-lock
      662           ,
      663           each _index-field of _index
      664           no-lock
      665           ,
      666           each _field of _index-field
      667           no-lock
      668           break by _index-seq
      669         :
      670         CASE _Field._Field-Name:
      671             WHEN "gds-code"  THEN v-log-gds-code  = TRUE.
      672             WHEN "b-code"    THEN v-log-b-code    = TRUE.
      673             WHEN "doc-code"  THEN v-log-doc-code  = TRUE.
      674             WHEN "rvs-code"  THEN v-log-rvs-code  = TRUE.
      675             WHEN "wth-code"  THEN v-log-wth-code  = TRUE.
      676             WHEN "host-code" THEN v-log-host-code = TRUE.
      677             WHEN "obj-code"  THEN IF CAN-FIND(FIRST buf__Field of _File where buf__Field._Field-Name = "obj-type" no-lock)
      678                              THEN v-log-obj-code  = TRUE.
      679             WHEN "artic"     THEN IF  CAN-FIND(FIRST  buf__Field of _File where buf__Field._Field-Name = "prod-type" no-lock)
      680                                   and CAN-FIND(FIRST  buf__Field of _File where buf__Field._Field-Name = "prod-code" no-lock)
      681                              THEN v-log-artic     = TRUE.
      682             WHEN "doc-num"   THEN v-log-doc-num   = TRUE.
      683             OTHERWISE DO:
      684             END.
      685         END CASE.
      686         put stream st-out unformatted
      687           'ADD FIELD "' + _Field._Field-Name
      688                         + '" OF "'
      689                         + _File._File-Name
      690                         + '-attr"'
      691                         + ' AS '
      692                         + _Field._Data-Type
      693                         + chr(10)
      694           .
      695         put stream st-out unformatted
      696           '  DESCRIPTION ' .
      697         export stream st-out
      698             _Field._Desc
      699           .
      700         put stream st-out unformatted
      701           '  FORMAT ' .
      702         export stream st-out
      703             _Field._Format
      704           .
      705         put stream st-out unformatted
      706           '  INITIAL ' .
      707         export stream st-out
      708             _Field._Initial
      709           .
      710         put stream st-out unformatted
      711           '  LABEL ' .
      712         export stream st-out
      713             _Field._Label
      714           .
      715         put stream st-out unformatted
      716           '  MANDATORY '
      717           chr(10)
      718           .
      719         put stream st-out unformatted
      720           chr(10)
      721         .
      722       end.
      723         put stream st-out unformatted
      724            SUBSTITUTE('ADD FIELD "attr-code" OF "&1-attr" AS CHARACTER', _File._File-Name )
      725                         + chr(10)
      726            '  FORMAT "X(8)"'
      727                         + chr(10)
      728            '  INITIAL ""'
      729                         + chr(10)
      730            '  LABEL "Атрибут"'
      731                         + chr(10)
      732            '  MAX-WIDTH 16'
      733                         + chr(10)
      734            '  COLUMN-LABEL "Атрибут"'
      735                         + chr(10)
      736            '  MANDATORY'
      737                         + chr(10)
      738                         + chr(10)
      739         .
      740         put stream st-out unformatted
      741            SUBSTITUTE('ADD FIELD "attr-value" OF "&1-attr" AS CHARACTER', _File._File-Name )
      742                         + chr(10)
      743            + '  FORMAT "X(30)"'
      744                         + chr(10)
      745            + '  INITIAL ""'
      746                         + chr(10)
      747            + '  LABEL "Значение атрибута"'
      748                         + chr(10)
      749            + '  MAX-WIDTH 60'
      750                         + chr(10)
      751            + '  COLUMN-LABEL "Значение!атрибута"'
      752                         + chr(10)
      753                         + chr(10)
      754         .
      755       find first _index
      756            where recid( _index  ) = _file._prime-index
      757              and LC( _index._index-name ) <> "default":U
      758            no-lock
      759            no-error.
      760       if not available _index then do:
      761         message
      762            "Не найден первичный индекс для таблицы" _File._File-Name
      763         view-as alert-box information.
      764         next.
      765       end.
      766       put stream st-out unformatted
      767         SUBSTITUTE('ADD INDEX "pi" ON "&1-attr"', _File._File-Name )
      768                           + chr(10)
      769         + '  AREA "Schema Area"'
      770                           + chr(10)
      771         + '  UNIQUE'
      772                           + chr(10)
      773         + '  PRIMARY'
      774                           + chr(10)
      775       .
      776       for each _index-field of _index
      777           no-lock
      778           ,
      779           each _field of _index-field
      780           no-lock
      781           break by _index-seq:
      782         put stream st-out unformatted
      783            SUBSTITUTE('  INDEX-FIELD "&1" &2', _Field._Field-Name, IF _index-field._Ascending THEN "ASCENDING" ELSE "DESCENDING")
      784                              + chr(10)
      785         .
      786       end.
      787       put stream st-out unformatted
      788         '  INDEX-FIELD "attr-code" ASCENDING'
      789                           + chr(10)
      790                           + chr(10)
      791       .
      792       IF v-log-gds-code  THEN
      793       do:
      794         put stream st-out unformatted
      795            SUBSTITUTE('ADD INDEX "by-gds-code" ON "&1-attr"', _File._File-Name )
      796                              + chr(10)
      797            + '  AREA "Schema Area"'
      798                              + chr(10)
      799            + '  INDEX-FIELD "gds-code" ASCENDING'
      800                              + chr(10)
      801                              + chr(10)
      802         .
      803       end.
      804       IF v-log-b-code    THEN
      805       do:
      806         put stream st-out unformatted
      807            SUBSTITUTE('ADD INDEX "by-b-code" ON "&1-attr"', _File._File-Name )
      808                              + chr(10)
      809            + '  AREA "Schema Area"'
      810                              + chr(10)
      811            + '  INDEX-FIELD "b-code" ASCENDING'
      812                              + chr(10)
      813                              + chr(10)
      814         .
      815       end.
      816       IF v-log-doc-code  THEN
      817       do:
      818         put stream st-out unformatted
      819            SUBSTITUTE('ADD INDEX "by-doc-code" ON "&1-attr"', _File._File-Name )
      820                              + chr(10)
      821            + '  AREA "Schema Area"'
      822                              + chr(10)
      823            + '  INDEX-FIELD "doc-code" ASCENDING'
      824                              + chr(10)
      825                              + chr(10)
      826         .
      827       end.
      828       IF v-log-rvs-code  THEN
      829       do:
      830         put stream st-out unformatted
      831            SUBSTITUTE('ADD INDEX "by-rvs-code" ON "&1-attr"', _File._File-Name )
      832                              + chr(10)
      833            + '  AREA "Schema Area"'
      834                              + chr(10)
      835            + '  INDEX-FIELD "rvs-code" ASCENDING'
      836                              + chr(10)
      837                              + chr(10)
      838         .
      839       end.
      840       IF v-log-wth-code  THEN
      841       do:
      842         put stream st-out unformatted
      843            SUBSTITUTE('ADD INDEX "by-wth-code" ON "&1-attr"', _File._File-Name )
      844                              + chr(10)
      845            + '  AREA "Schema Area"'
      846                              + chr(10)
      847            + '  INDEX-FIELD "wth-code" ASCENDING'
      848                              + chr(10)
      849                              + chr(10)
      850         .
      851       end.
      852       IF v-log-host-code THEN
      853       do:
      854         put stream st-out unformatted
      855            SUBSTITUTE('ADD INDEX "by-host-code" ON "&1-attr"', _File._File-Name )
      856                              + chr(10)
      857            + '  AREA "Schema Area"'
      858                              + chr(10)
      859            + '  INDEX-FIELD "host-code" ASCENDING'
      860                              + chr(10)
      861                              + chr(10)
      862         .
      863       end.
      864       IF v-log-obj-code  THEN
      865       do:
      866         put stream st-out unformatted
      867            SUBSTITUTE('ADD INDEX "by-obj" ON "&1-attr"', _File._File-Name )
      868                              + chr(10)
      869            + '  AREA "Schema Area"'
      870                              + chr(10)
      871            + '  INDEX-FIELD "obj-type" ASCENDING'
      872                              + chr(10)
      873            + '  INDEX-FIELD "obj-code" ASCENDING'
      874                              + chr(10)
      875                              + chr(10)
      876         .
      877       end.
      878       IF v-log-artic     THEN
      879       do:
      880         put stream st-out unformatted
      881            SUBSTITUTE('ADD INDEX "by-artic" ON "&1-attr"', _File._File-Name )
      882                              + chr(10)
      883            + '  AREA "Schema Area"'
      884                              + chr(10)
      885            + '  INDEX-FIELD "artic" ASCENDING'
      886                              + chr(10)
      887            + '  INDEX-FIELD "prod-type" ASCENDING'
      888                              + chr(10)
      889            + '  INDEX-FIELD "prod-code" ASCENDING'
      890                              + chr(10)
      891                              + chr(10)
      892         .
      893       end.
      894       IF v-log-doc-num   THEN
      895       do:
      896         put stream st-out unformatted
      897            SUBSTITUTE('ADD INDEX "by-doc-num" ON "&1-attr"', _File._File-Name )
      898                              + chr(10)
      899            + '  AREA "Schema Area"'
      900                              + chr(10)
      901            + '  INDEX-FIELD "doc-num" ASCENDING'
      902                              + chr(10)
      903                              + chr(10)
      904         .
      905       end.
      906       output stream st-out close .
      907       RUN create-trg-w IN THIS-PROCEDURE (INPUT Substitute('&1w.p', v-trig-name), INPUT SUBSTITUTE('&1-attr', _file._File-Name) ) .
      908       RUN create-trg-d IN THIS-PROCEDURE (INPUT Substitute('&1d.p', v-trig-name), INPUT SUBSTITUTE('&1-attr', _file._File-Name) ) .
      909       output stream st-out to value("tbl.lst") append .
      910       put stream st-out unformatted
      911          SUBSTITUTE('&1-attr', _File._File-Name )
      912          + chr(10)
      913       .
      914       output stream st-out close .
      915   end.
      916   END PROCEDURE.
      917   PROCEDURE add-c :
      918   define input parameter p-number as integer no-undo .
      919   define variable v-file-name     as character    no-undo.
      920   define variable v-trig-name     as character    no-undo.
      921   define variable v-log-gds-code     as LOGICAL    no-undo.
      922   define variable v-log-host-code     as LOGICAL    no-undo.
      923   define variable v-log-obj-code     as LOGICAL    no-undo.
      924   define variable v-log-b-code     as LOGICAL    no-undo.
      925   define variable v-log-doc-code     as LOGICAL    no-undo.
      926   define variable V-LOG-wth-CODE     as LOGICAL    no-undo.
      927   define variable v-log-rvs-code     as LOGICAL    no-undo.
      928   define variable v-log-artic     as LOGICAL    no-undo.
      929   define variable v-log-doc-num     as LOGICAL    no-undo.
      930   DEFINE VARIABLE v-idx-c AS INTEGER NO-UNDO .
      931   define buffer buf__Field      for _Field .
      932   do
      933   on error undo, return error
      934   :
      935       FIND FIRST _file
      936            where _file._File-Number = p-number
      937            no-lock
      938            .
      939       run trig-name in this-procedure
      940          ( input _file._File-Name
      941          , output v-trig-name
      942          ) .
      943       IF v-all THEN DO:
      944         assign
      945         v-file-name = SUBSTITUTE("new.df")
      946         .
      947       END.
      948       ELSE DO:
      949         assign
      950            v-file-name = SUBSTITUTE("c-&1.df", _file._File-Name)
      951         .
      952       END.
      953       for first _index
      954           where recid( _index  ) = _file._prime-index
      955             and LC( _index._index-name ) <> "default":U
      956           no-lock
      957           ,
      958           each _index-field of _index
      959           no-lock
      960           ,
      961           each _field of _index-field
      962           no-lock
      963           break by _index-seq
      964         :
      965           ASSIGN
      966                 v-idx-c = v-idx-c + 1
      967           .
      968       END.
      969       IF v-idx-c >= 16 THEN DO:
      970           MESSAGE "В таблице "
      971               _File._File-Name
      972               " первичный ключ шестнадцать полей."
      973               SKIP "Создание таблицы атрибутов невозможно."
      974               VIEW-AS ALERT-BOX.
      975           NEXT.
      976       END.
      977       output stream st-out to value(v-file-name) append .
      978       put stream st-out unformatted
      979           'ADD TABLE "c-' + _File._File-Name + '"' + chr(10)
      980         + '  AREA "Schema Area"' + chr(10)
      981         + '  CAN-READ "!,*"' + chr(10)
      982         + '  CAN-WRITE "!,!odbc,*"' + chr(10)
      983         + '  CAN-CREATE "!,!odbc,*"' + chr(10)
      984         + '  CAN-DELETE "!,!odbc,*"' + chr(10)
      985         + '  CAN-DUMP "!odbc,*"' + chr(10)
      986         + '  CAN-LOAD "!odbc,*"' + chr(10)
      987         + '  LABEL "ABC анализ"' + chr(10)
      988         + SUBSTITUTE('  DUMP-NAME "&1"', v-trig-name) + chr(10)
      989         + Substitute('  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "&1d.p" CRC "?"', v-trig-name) + chr(10)
      990         + Substitute('  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "&1w.p" CRC "?"', v-trig-name) + chr(10)
      991         + chr(10)
      992         .
      993       field-block:
      994       for each _Field of _File
      995           no-lock
      996           on error undo, return error
      997         :
      998         CASE _Field._Field-Name:
      999             WHEN "gds-code"  THEN v-log-gds-code  = TRUE.
     1000             WHEN "b-code"    THEN v-log-b-code    = TRUE.
     1001             WHEN "doc-code"  THEN v-log-doc-code  = TRUE.
     1002             WHEN "rvs-code"  THEN v-log-rvs-code  = TRUE.
     1003             WHEN "wth-code"  THEN v-log-wth-code  = TRUE.
     1004             WHEN "host-code" THEN v-log-host-code = TRUE.
     1005             WHEN "obj-code"  THEN IF CAN-FIND(FIRST buf__Field of _File where buf__Field._Field-Name = "obj-type" no-lock)
     1006                              THEN v-log-obj-code  = TRUE.
     1007             WHEN "artic"     THEN IF  CAN-FIND(FIRST  buf__Field of _File where buf__Field._Field-Name = "prod-type" no-lock)
     1008                                   and CAN-FIND(FIRST  buf__Field of _File where buf__Field._Field-Name = "prod-code" no-lock)
     1009                              THEN v-log-artic     = TRUE.
     1010             WHEN "doc-num"   THEN v-log-doc-num   = TRUE.
     1011             OTHERWISE DO:
     1012             END.
     1013         END CASE.
     1014         put stream st-out unformatted
     1015           'ADD FIELD "' + _Field._Field-Name
     1016                         + '" OF c-"'
     1017                         + _File._File-Name
     1018                         + '" AS '
     1019                         + _Field._Data-Type
     1020                         + chr(10)
     1021           .
     1022         put stream st-out unformatted
     1023           '  DESCRIPTION ' .
     1024         export stream st-out
     1025             _Field._Desc
     1026           .
     1027         put stream st-out unformatted
     1028           '  FORMAT ' .
     1029         export stream st-out
     1030             _Field._Format
     1031           .
     1032         put stream st-out unformatted
     1033           '  INITIAL ' .
     1034         export stream st-out
     1035             _Field._Initial
     1036           .
     1037         put stream st-out unformatted
     1038           '  LABEL ' .
     1039         export stream st-out
     1040             _Field._Label
     1041           .
     1042         put stream st-out unformatted
     1043           '  MANDATORY '
     1044           chr(10)
     1045           .
     1046         put stream st-out unformatted
     1047           chr(10)
     1048         .
     1049       end.
     1050         put stream st-out unformatted
     1051            SUBSTITUTE('ADD FIELD "corr-user-db-num" OF "c-&1" AS INTEGER', _File._File-Name )
     1052                         + chr(10)
     1053            '  DESCRIPTION "Номер БД"'
     1054                         + chr(10)
     1055            '  FORMAT ">>>>9"'
     1056                         + chr(10)
     1057            '  INITIAL ?'
     1058                         + chr(10)
     1059            '  LABEL "Номер БД"'
     1060                         + chr(10)
     1061            '  MAX-WIDTH 4'
     1062                         + chr(10)
     1063            '  COLUMN-LABEL "Номер БД"'
     1064                         + chr(10)
     1065            '  MANDATORY'
     1066                         + chr(10)
     1067                         + chr(10)
     1068         .
     1069         put stream st-out unformatted
     1070            SUBSTITUTE('ADD FIELD "chip-num" OF "c-&1" AS INTEGER', _File._File-Name )
     1071                         + chr(10)
     1072            '  FORMAT ">,>>>,>>9"'
     1073                         + chr(10)
     1074            '  INITIAL 0'
     1075                         + chr(10)
     1076            '  LABEL "Щепка"'
     1077                         + chr(10)
     1078            '  MAX-WIDTH 4'
     1079                         + chr(10)
     1080            '  COLUMN-LABEL "Щепка"'
     1081                         + chr(10)
     1082            '  MANDATORY'
     1083                         + chr(10)
     1084                         + chr(10)
     1085         .
     1086         put stream st-out unformatted
     1087            SUBSTITUTE('ADD FIELD "corr-time" OF "c-&1" AS INTEGER', _File._File-Name )
     1088                         + chr(10)
     1089            '  DESCRIPTION "Время изменения в секундах"'
     1090                         + chr(10)
     1091            '  FORMAT ">>>,>>9"'
     1092                         + chr(10)
     1093            '  INITIAL 0'
     1094                         + chr(10)
     1095            '  LABEL "Время изменения в секундах"'
     1096                         + chr(10)
     1097            '  MAX-WIDTH 4'
     1098                         + chr(10)
     1099            '  COLUMN-LABEL "Время"'
     1100                         + chr(10)
     1101                         + chr(10)
     1102         .
     1103         put stream st-out unformatted
     1104            SUBSTITUTE('ADD FIELD "corr-date" OF "c-&1" AS DATE', _File._File-Name )
     1105                         + chr(10)
     1106            '  FORMAT 99/99/9999"'
     1107                         + chr(10)
     1108            '  INITIAL ?'
     1109                         + chr(10)
     1110            '  LABEL "Дата коррекции"'
     1111                         + chr(10)
     1112            '  MAX-WIDTH 4'
     1113                         + chr(10)
     1114            '  COLUMN-LABEL "Номер БД"'
     1115                         + chr(10)
     1116                         + chr(10)
     1117         .
     1118         put stream st-out unformatted
     1119            SUBSTITUTE('ADD FIELD "corr-user-name" OF "c-&1" AS CHARACTER', _File._File-Name )
     1120                         + chr(10)
     1121            '  DESCRIPTION "Имя пользователя"'
     1122                         + chr(10)
     1123            '  FORMAT "X(8)"'
     1124                         + chr(10)
     1125            '  INITIAL ""'
     1126                         + chr(10)
     1127            '  LABEL "Имя пользователя"'
     1128                         + chr(10)
     1129            '  MAX-WIDTH 16'
     1130                         + chr(10)
     1131            '  COLUMN-LABEL "Имя"'
     1132                         + chr(10)
     1133                         + chr(10)
     1134         .
     1135       find first _index
     1136            where recid( _index  ) = _file._prime-index
     1137              and LC( _index._index-name ) <> "default":U
     1138            no-lock
     1139            no-error.
     1140       if not available _index then do:
     1141         message
     1142            "Не найден первичный индекс для таблицы" _File._File-Name
     1143         view-as alert-box information.
     1144         next.
     1145       end.
     1146       put stream st-out unformatted
     1147         SUBSTITUTE('ADD INDEX "pi" ON "c-&1"', _File._File-Name )
     1148                           + chr(10)
     1149         + '  AREA "Schema Area"'
     1150                           + chr(10)
     1151         + '  UNIQUE'
     1152                           + chr(10)
     1153         + '  PRIMARY'
     1154                           + chr(10)
     1155       .
     1156       for each _index-field of _index
     1157           no-lock
     1158           ,
     1159           each _field of _index-field
     1160           no-lock
     1161           break by _index-seq:
     1162         put stream st-out unformatted
     1163            SUBSTITUTE('  INDEX-FIELD "&1" &2', _Field._Field-Name, IF _index-field._Ascending THEN "ASCENDING" ELSE "DESCENDING")
     1164                              + chr(10)
     1165         .
     1166       end.
     1167       put stream st-out unformatted
     1168            '  INDEX-FIELD "corr-user-db-num" ASCENDING'
     1169                              + chr(10)
     1170            '  INDEX-FIELD "chip-num" ASCENDING'
     1171                              + chr(10)
     1172                              + chr(10)
     1173       .
     1174       output stream st-out close .
     1175       RUN create-trg-w IN THIS-PROCEDURE (INPUT Substitute('&1w.p', v-trig-name), INPUT SUBSTITUTE('c-&1', _file._File-Name)).
     1176       RUN create-trg-d IN THIS-PROCEDURE (INPUT Substitute('&1d.p', v-trig-name), INPUT SUBSTITUTE('c-&1', _file._File-Name)).
     1177       output stream st-out to value("tbl.lst") append .
     1178       put stream st-out unformatted
     1179          SUBSTITUTE('&1-attr', _File._File-Name )
     1180          + chr(10)
     1181       .
     1182       output stream st-out close .
     1183   end.
     1184   END PROCEDURE.
     1185   PROCEDURE create-df :
     1186   do
     1187   on error undo, return error
     1188   :
     1189      for each  tt-file
     1190          where tt-file.f-c-old = FALSE
     1191            AND tt-file.f-c     = TRUE
     1192          :
     1193          RUN add-c in this-procedure ( INPUT tt-file._File-Number) .
     1194      end.
     1195      for each  tt-file
     1196          where tt-file.f-attr-old = FALSE
     1197            AND tt-file.f-attr     = TRUE
     1198          :
     1199          RUN add-attr in this-procedure  ( INPUT tt-file._File-Number) .
     1200      end.
     1201   end.
     1202   END PROCEDURE.
     1203   PROCEDURE create-trg-d :
     1204   DEFINE INPUT PARAMETER p-file-name AS CHARACTER NO-UNDO .
     1205   DEFINE INPUT PARAMETER p-tbl-name AS CHARACTER NO-UNDO .
     1206   do
     1207   on error undo, return error
     1208   :
     1209       output stream st-out to value(p-file-name) .
     1210   put stream st-out unformatted '/*' +  chr(10).
     1211   put stream st-out unformatted '' +  chr(10).
     1212   put stream st-out unformatted '$Revision$' +  chr(10).
     1213   put stream st-out unformatted '$Author$' +  chr(10).
     1214   put stream st-out unformatted '$Date$' +  chr(10).
     1215   put stream st-out unformatted '$Workfile$' +  chr(10).
     1216   put stream st-out unformatted '$Archive$' +  chr(10).
     1217   put stream st-out unformatted '' +  chr(10).
     1218   put stream st-out unformatted SUBSTITUTE('??????? ?? ???????? ??????? &1', p-tbl-name) +  chr(10).
     1219   put stream st-out unformatted '' +  chr(10).
     1220   put stream st-out unformatted '?????: ' +  chr(10).
     1221   put stream st-out unformatted '???? ????????:' +  chr(10).
     1222   put stream st-out unformatted 'Author: Ilia Belousov' +  chr(10).
     1223   put stream st-out unformatted 'Creation date:' +  chr(10) +  chr(10).
     1224   put stream st-out unformatted '*/' +  chr(10)  +  chr(10).
     1225   put stream st-out unformatted SUBSTITUTE('TRIGGER PROCEDURE FOR DELETE OF ub.&1 old old-&1.', p-tbl-name) +  chr(10) +  chr(10).
     1226   put stream st-out unformatted 'define variable vss-revision    as character no-undo init "$Revision$":U .' +  chr(10).
     1227   put stream st-out unformatted 'define variable vss-author      as character no-undo init "$Author$":U .' +  chr(10).
     1228   put stream st-out unformatted 'define variable vss-date        as character no-undo init "$Date$":U .' +  chr(10).
     1229   put stream st-out unformatted 'define variable vss-workfile    as character no-undo init "$Workfile$":U .' +  chr(10).
     1230   put stream st-out unformatted 'define variable vss-archive     as character no-undo init "$Archive$":U .' +  chr(10).
     1231   put stream st-out unformatted SUBSTITUTE('define variable vss-description as character no-undo init "??????? ?? ???????? ???????".', p-tbl-name) +  chr(10)  +  chr(10) +  chr(10).
     1232   put stream st-out unformatted 'main-block:' +  chr(10).
     1233   put stream st-out unformatted 'do' +  chr(10).
     1234   put stream st-out unformatted 'on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))' +  chr(10).
     1235   put stream st-out unformatted 'on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )' +  chr(10).
     1236   put stream st-out unformatted 'on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )' +  chr(10).
     1237   put stream st-out unformatted ':' +  chr(10)  +  chr(10) +  chr(10).
     1238   put stream st-out unformatted 'end. /* main-block */' +  chr(10).
     1239       output stream st-out close .
     1240   END.
     1241   END PROCEDURE.
     1242   PROCEDURE create-trg-w :
     1243   DEFINE INPUT PARAMETER p-file-name AS CHARACTER NO-UNDO .
     1244   DEFINE INPUT PARAMETER p-tbl-name AS CHARACTER NO-UNDO .
     1245   do
     1246   on error undo, return error
     1247   :
     1248       output stream st-out to value(p-file-name) .
     1249   put stream st-out unformatted '/*' +  chr(10).
     1250   put stream st-out unformatted '' +  chr(10).
     1251   put stream st-out unformatted '$Revision$' +  chr(10).
     1252   put stream st-out unformatted '$Author$' +  chr(10).
     1253   put stream st-out unformatted '$Date$' +  chr(10).
     1254   put stream st-out unformatted '$Workfile$' +  chr(10).
     1255   put stream st-out unformatted '$Archive$' +  chr(10) +  chr(10).
     1256   put stream st-out unformatted SUBSTITUTE('??????? ?? ????????? ??????? &1', p-tbl-name) +  chr(10) +  chr(10).
     1257   put stream st-out unformatted '?????: ' +  chr(10).
     1258   put stream st-out unformatted '???? ????????:' +  chr(10).
     1259   put stream st-out unformatted 'Author: Ilia Belousov' +  chr(10).
     1260   put stream st-out unformatted 'Creation date:' +  chr(10) +  chr(10).
     1261   put stream st-out unformatted '*/' +  chr(10) +  chr(10).
     1262   put stream st-out unformatted SUBSTITUTE('TRIGGER PROCEDURE FOR WRITE OF ub.&1 old old-&1.', p-tbl-name) +  chr(10) +  chr(10).
     1263   put stream st-out unformatted 'define variable vss-revision    as character no-undo init "$Revision$":U .' +  chr(10).
     1264   put stream st-out unformatted 'define variable vss-author      as character no-undo init "$Author$":U .' +  chr(10).
     1265   put stream st-out unformatted 'define variable vss-date        as character no-undo init "$Date$":U .' +  chr(10).
     1266   put stream st-out unformatted 'define variable vss-workfile    as character no-undo init "$Workfile$":U .' +  chr(10).
     1267   put stream st-out unformatted 'define variable vss-archive     as character no-undo init "$Archive$":U .' +  chr(10).
     1268   put stream st-out unformatted SUBSTITUTE('define variable vss-description as character no-undo init "??????? ??  ????????? ???????".', p-tbl-name) +  chr(10) +  chr(10) +  chr(10).
     1269   put stream st-out unformatted 'main-block:' +  chr(10).
     1270   put stream st-out unformatted 'do' +  chr(10).
     1271   put stream st-out unformatted 'on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))' +  chr(10).
     1272   put stream st-out unformatted 'on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )' +  chr(10).
     1273   put stream st-out unformatted 'on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )' +  chr(10).
     1274   put stream st-out unformatted ':' +  chr(10) +  chr(10) +  chr(10).
     1275   put stream st-out unformatted 'end. /* main-block */' +  chr(10).
     1276       output stream st-out close .
     1277   END.
     1278   END PROCEDURE.
     1279   PROCEDURE deselect-all-attr :
     1280   do
     1281   on error undo, return error
     1282   :
     1283      for each  tt-file
     1284          where tt-file.f-attr-old = FALSE
     1285            AND tt-file.f-attr     = TRUE
     1286          :
     1287          assign
     1288            tt-file.f-attr     = FALSE
     1289          .
     1290      end.
     1291   end.
     1292   END PROCEDURE.
     1293   PROCEDURE deselect-all-c :
     1294   do
     1295   on error undo, return error
     1296   :
     1297      for each  tt-file
     1298          where tt-file.f-c-old = FALSE
     1299            AND tt-file.f-c     = TRUE
     1300          :
     1301          assign
     1302            tt-file.f-c     = FALSE
     1303          .
     1304      end.
     1305   end.
     1306   END PROCEDURE.
     1307   PROCEDURE disable_UI :
     1308     HIDE FRAME Dialog-Frame.
     1309   END PROCEDURE.
     1310   PROCEDURE enable_UI :
     1311     DISPLAY v-all
     1312         WITH FRAME Dialog-Frame.
     1313     ENABLE b-exit b-export b-help v-all b-sel-all-c b-sel-all-attr b-drop-all-c
     1314            b-drop-all-attr BR-file
     1315         WITH FRAME Dialog-Frame.
     1316     VIEW FRAME Dialog-Frame.
     1317     RUN refresh-query in this-procedure .
     1318   END PROCEDURE.
     1319   PROCEDURE fill-file :
     1320   do
     1321   on error undo, return error
     1322   :
     1323     define buffer buf__file     for _file .
     1324     for each  _file
     1325         where _file._hidden = false
     1326         no-lock
     1327         :
     1328         if _file._File-Name begins "c-":U
     1329         or index(_file._File-Name , "-attr":U ) <> 0
     1330         then do:
     1331            next.
     1332         end.
     1333         FIND FIRST _Field OF _File WHERE _Field._Field-Name = "attr-code"
     1334             NO-LOCK
     1335             NO-ERROR
     1336             .
     1337         IF AVAILABLE _Field THEN DO:
     1338             NEXT.
     1339         END.
     1340         create tt-file.
     1341         buffer-copy _file to tt-file .
     1342         IF can-find (FIRST buf__file
     1343                      where buf__file._file-name = SUBSTITUTE( "&1-attr", _file._File-Name)
     1344                      no-lock
     1345                     )
     1346         then do:
     1347            assign
     1348               tt-file.f-attr       = YES
     1349               tt-file.f-attr-old   = YES
     1350            .
     1351         end.
     1352         IF can-find (FIRST buf__file
     1353                      where buf__file._file-name = SUBSTITUTE( "c-&1", _file._File-Name)
     1354                      no-lock
     1355                     )
     1356         then do:
     1357            assign
     1358               tt-file.f-c       = YES
     1359               tt-file.f-c-old   = YES
     1360            .
     1361         end.
     1362     end.
     1363   end.
     1364   END PROCEDURE.
     1365   PROCEDURE post-enable_UI :
     1366   do
     1367   on error undo, return error
     1368   :
     1369      ASSIGN
     1370         tt-file.f-c :READ-ONLY    in browse br-file = NO
     1371         tt-file.f-attr :READ-ONLY in browse br-file = NO
     1372      .
     1373   end.
     1374   END PROCEDURE.
     1375   PROCEDURE refresh-query :
     1376   do
     1377   on error undo, return error
     1378   :
     1379         OPEN QUERY BR-file
     1380              for each  tt-file
     1381         INDEXED-REPOSITION .
     1382   end.
     1383   END PROCEDURE.
     1384   PROCEDURE select-all-attr :
     1385   do
     1386   on error undo, return error
     1387   :
     1388      for each  tt-file
     1389          where tt-file.f-attr-old = FALSE
     1390            AND tt-file.f-attr     = FALSE
     1391          :
     1392          assign
     1393            tt-file.f-attr     = TRUE
     1394          .
     1395      end.
     1396   end.
     1397   END PROCEDURE.
     1398   PROCEDURE select-all-c :
     1399   do
     1400   on error undo, return error
     1401   :
     1402      for each  tt-file
     1403          where tt-file.f-c-old = FALSE
     1404            AND tt-file.f-c     = FALSE
     1405          :
     1406          assign
     1407            tt-file.f-c     = TRUE
     1408          .
     1409      end.
     1410   end.
     1411   END PROCEDURE.
     1412   PROCEDURE trig-name :
     1413   define input  parameter p-name   as character no-undo .
     1414   define output parameter p-trig-name as character no-undo .
     1415   define variable v-absent    as logical      no-undo.
     1416   define variable v-file-name as character    no-undo.
     1417   define variable v-counter    as integer      no-undo.
     1418   do
     1419   on error undo, return error
     1420   :
     1421      assign
     1422         v-file-name = SUBSTITUTE("trg/&1", SUBSTRING(p-name, 1 , 7 ))
     1423         v-counter   = 0
     1424      .
     1425      REPEAT WHILE NOT v-absent:
     1426         FIND FIRST _File-Trig
     1427            WHERE _File-Trig._Proc-Name begins v-file-name
     1428            no-lock
     1429            no-error
     1430            .
     1431         FIND FIRST tt-trig-name
     1432            WHERE tt-trig-name.f-name begins v-file-name
     1433            no-lock
     1434            no-error
     1435            .
     1436         IF AVAILABLE _File-Trig
     1437         OR AVAILABLE tt-trig-name
     1438         THEN DO:
     1439            assign
     1440               v-file-name = IF v-counter < 10
     1441                             THEN
     1442                             SUBSTITUTE
     1443                             ( "trg/&1&2"
     1444                             , SUBSTRING(p-name, 1 , 6 )
     1445                             , STRING(v-counter, "9")
     1446                             )
     1447                             ELSE
     1448                             SUBSTITUTE
     1449                             ( "trg/&1&2"
     1450                             , SUBSTRING(p-name, 1 , 5 )
     1451                             , STRING(v-counter, "99")
     1452                             )
     1453               v-counter = v-counter + 1
     1454            .
     1455            next.
     1456         END.
     1457         ELSE DO:
     1458            CREATE tt-trig-name.
     1459            assign
     1460               tt-trig-name.f-name = v-file-name
     1461               v-absent = TRUE
     1462               p-trig-name = v-file-name
     1463            .
     1464            return.
     1465         END.
     1466      END.
     1467   end.
     1468   END PROCEDURE.
