      460      run deselect-all-attr in this-procedure .
      461      RUN enable_UI.
      462      RUN post-enable_UI IN THIS-PROCEDURE .
      463   END.
      464   ON CHOOSE OF b-drop-all-c IN FRAME Dialog-Frame
      465   DO:
      466      run deselect-all-c in this-procedure .
      467      RUN enable_UI.
      468      RUN post-enable_UI IN THIS-PROCEDURE .
      469   END.
      470   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      471   DO:
      472      assign
      473         v-all
      474      .
      475      run waitfram-show in this-procedure
      476         ( input "Идет формирование файла"
      477         ) .
      478      run create-df in this-procedure NO-ERROR.
      479      IF ERROR-STATUS:ERROR THEN DO:
      480         MESSAGE "Ошибка формированяи DF-файла" RETURN-VALUE SKIP
      481                  ERROR-STATUS:GET-MESSAGE(1)
      482         VIEW-AS ALERT-BOX.
      483         UNDO, RETURN NO-APPLY.
      484      END.
      485      run waitfram-hide in this-procedure .
      486   END.
      487   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      488   OR HELP OF FRAME Dialog-Frame
      489   DO:
