        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: bbf1530230d5, 2753, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Сб фев 20 15:59:21 2021 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: in-imp-cashier.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/in-imp-cashier.p $":U .
        7   define variable vss-description as character no-undo init "импорт клиентов из excel".
        8   define new global shared variable g#library  as handle no-undo .
        9   define new global shared variable g#library2 as handle no-undo .
       10   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   procedure cur-time :
       16      define output parameter p-today as date      no-undo .
       17      define output parameter p-time  as integer   no-undo .
       18     do
       19     on error undo, return error
       20     :
       21       define variable v-date1 as date      no-undo .
       22       define variable v-date2 as date      no-undo .
       23       define variable v-time  as integer   no-undo .
       24       assign
       25         v-date1 = today
       26         v-time  = time
       27         v-date2 = today
       28       .
       29       if v-date1 <> v-date2
       30       then do:
       31         assign
       32           v-date1 = today
       33           v-time  = v-time
       34         .
       35       end.
       36       assign
       37         p-today = v-date1
       38         p-time  = v-time
       39       .
       40     end.
       41   end.
       42   function cur-time-date returns character
       43   :
       44     return string(today, '99/99/9999':U) .
       45   end.
       46   function cur-time-mjd returns decimal
       47   :
       48     define variable v-date as date      no-undo .
       49     define variable v-time as integer   no-undo .
       50     run cur-time in this-procedure
       51       (output v-date
       52       ,output v-time
       53       ) .
       54     return integer(v-date) - 2400002 + (v-time / 86400) .
       55   end.
       56   function cur-time-get-ending-index returns integer
       57   (input p-number as integer
       58   )
       59   :
       60     if p-number < 0
       61     or p-number = ?
       62     then do:
       63       return 1 .
       64     end.
       65     define variable v-rest as integer   no-undo .
       66     assign
       67       p-number = p-number modulo 100
       68     .
       69     if p-number < 20
       70     then do:
       71       assign
       72         v-rest = p-number
       73       .
       74     end.
       75     else do:
       76       assign
       77         v-rest = p-number modulo 10
       78       .
       79     end.
       80     case v-rest :
       81       when 1
       82       then do:
       83         return 2 .
       84       end.
       85       when 2 or
       86       when 3 or
       87       when 4
       88       then do:
       89         return 3 .
       90       end.
       91       otherwise do:
       92         return 1 .
       93       end.
       94     end case .
       95   end.
       96   procedure cur-time-mjd-to-date :
       97      define input  parameter i-mjd-diff as decimal no-undo.
       98      define output parameter o-Date     as date    no-undo.
       99      define output parameter o-Time     as integer no-undo.
      100      define variable v-day-number as integer   no-undo .
      101      if    i-mjd-diff < 0
      102         or i-mjd-diff = ?
      103      then do:
      104         return "?" .
      105      end.
      106      assign
      107         v-day-number = truncate(i-mjd-diff,0).
      108         o-Date = date(v-day-number + 2400002).
      109         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      110     .
      111   end.
      112   function cur-time-mjd-to-string returns character
      113   (input p-mjd-diff as decimal
      114   )
      115   :
      116     define variable v-day-number as integer   no-undo .
      117     define variable v-seconds    as integer   no-undo .
      118     define variable v-hour       as integer   no-undo .
      119     define variable v-min        as integer   no-undo .
      120     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      121     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      122     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      123     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      124     if p-mjd-diff < 0
      125     or p-mjd-diff = ?
      126     then do:
      127       return "?" .
      128     end.
      129     assign
      130       v-day-number = integer(truncate(p-mjd-diff,0))
      131       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      132     .
      133     if v-seconds > 86400
      134     then do:
      135       assign
      136         v-seconds = 86400 - 1
      137       .
      138     end.
      139     if v-seconds < 0
      140     then do:
      141       assign
      142         v-seconds = 0
      143       .
      144     end.
      145     assign
      146       v-hour = truncate(v-seconds / 3600, 0)
      147     .
      148     assign
      149       v-seconds = v-seconds modulo 3600
      150     .
      151     assign
      152       v-min = truncate(v-seconds / 60, 0)
      153     .
      154     assign
      155       v-seconds = v-seconds modulo 60
      156     .
      157     return
      158         (if v-day-number <> 0
      159           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      160           else ""
      161         )
      162       + (if v-day-number <> 0 or v-hour <> 0
      163           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      164           else ""
      165         )
      166       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      167           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      168           else ""
      169         )
      170       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      171       .
      172   end.
      173   function cur-time-string returns character
      174   :
      175     define variable v-date as date      no-undo .
      176     define variable v-time as integer   no-undo .
      177     run cur-time in this-procedure
      178       (output v-date
      179       ,output v-time
      180       ) .
      181     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      182   end.
      183   function cur-time-string-sec returns character
      184   :
      185     define variable v-date as date      no-undo .
      186     define variable v-time as integer   no-undo .
      187     run cur-time in this-procedure
      188       (output v-date
      189       ,output v-time
      190       ) .
      191     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      192   end.
      193   function cur-time-custom  returns character
      194   (input p-prefix as character
      195   ,input p-date-format as character
      196   ,input p-delimiter as character
      197   ,input p-time-format as character
      198   ,input p-suffix as character
      199   )
      200   :
      201     define variable v-date as date      no-undo .
      202     define variable v-time as integer   no-undo .
      203     run cur-time in this-procedure
      204       (output v-date
      205       ,output v-time
      206       ) .
      207     return
      208       p-prefix
      209       + string(v-date, p-date-format)
      210       + p-delimiter
      211       + string(v-time, p-time-format)
      212       + p-suffix
      213       .
      214   end.
      215   function cur-time-print  returns character
      216   :
      217     define variable v-date as date      no-undo .
      218     define variable v-time as integer   no-undo .
      219     run cur-time in this-procedure
      220       (output v-date
      221       ,output v-time
      222       ) .
      223     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      224   end.
      225   function cur-time-datetime returns datetime
      226   :
      227     define variable v-char as character no-undo .
      228     define variable v-datetime as datetime no-undo .
      229     v-char = cur-time-string().
      230     v-datetime = datetime(v-char).
      231     return  v-datetime.
      232   end.
      233   function cur-time-string-msec returns character
      234   :
      235     define variable v-date as datetime  no-undo .
      236     v-date = now.
      237     return string(v-date) .
      238   end.
      239   define input parameter parparentproc     as widget-handle no-undo .
      240   define input parameter p-parent-handle  as widget-handle no-undo .
      241   define input parameter p-log-handle  as handle no-undo .
      242   define input parameter p-parameter   as character no-undo .
      243   define variable my-seek1 as integer.
      244   define variable my-seek2 as integer.
      245   define variable my-mess as char.
      246     define stream InStream.
      247   define stream logstream .
      248   DEFINE VARIABLE chExcelApplication AS COM-HANDLE no-undo .
      249   DEFINE VARIABLE chWorkbook         AS COM-HANDLE no-undo .
      250   DEFINE VARIABLE chWorksheet        AS COM-HANDLE no-undo .
      251   define variable ss                 as character  no-undo.
      252   define variable cod-fiz            as integer    no-undo.
      253   define variable num-BD             as integer    no-undo.
      254   define variable code-cashier       as integer    no-undo.
      255   define variable password           as character  no-undo.
      256   define buffer buf_staff for staff.
      257   define variable v-date-start   as date      no-undo.
      258   define variable v-date-end     as date      no-undo.
      259   define variable p-rid          as recid     no-undo.
      260   define variable v-work-place   as character no-undo.
      261   define variable v-time         as integer   no-undo.
      262   define variable v-today        as date      no-undo.
      263   define variable v-level        as character no-undo.
      264   define variable v-host-code    as integer   no-undo.
      265   define variable v-obj-type     as character no-undo.
      266   define variable v-obj-code     as integer   no-undo.
      267   define variable num-rec        as integer   no-undo.
      268   define variable num-rec-ok     as integer   no-undo.
      269   define variable file-name as character no-undo.
      270   define variable ff             as character no-undo.
      271   define variable var-name-sheet as character no-undo .
      272   chworkbook = chexcelapplication:activeworkbook no-error.
      273   define variable log-file-name                as character      no-undo init "imp-cashier.txt".
      274   define variable v-view-log                   as logical        no-undo .
      275   define variable v-full-path        as character no-undo .
      276   define variable v-path             as character no-undo .
      277   define variable v-file-name        as character no-undo .
      278   define variable v-file-name-no-ext as character no-undo .
      279   define variable v-file-name-ext    as character no-undo .
      280   file-name   =  p-parameter no-error.
      281   if error-status:error then
      282   do:
      283       run write-log-and-file in p-log-handle (
      284           input 1
      285           , input log-file-name
      286           , input 1
      287           , input substitute("Ошибка входных параметров &1:&2&3&4"
      288           , p-parameter
      289           , chr(10)
      290           , error-status:get-message(1)
      291           , return-value
      292           )).
      293       assign
      294           v-view-log = yes.
      295       .
      296   end.
      297   run gbl/filename.p (
      298                    input  file-name
      299                   ,output v-full-path
      300                   ,output v-path
      301                   ,output v-file-name
      302                   ,output v-file-name-no-ext
      303                   ,output v-file-name-ext
      304                   ) no-error .
      305       chworkbook = chexcelapplication:activeworkbook no-error.
      306       run ex-file in this-procedure   (v-full-path, false) .
      307       chworkbook   = chexcelapplication:activeworkbook no-error.
      308       chworksheet  = chexcelapplication:sheets:item(1):select  no-error.
      309       chworksheet  = chexcelapplication:sheets:item(1) no-error.
      310   run import-proc in this-procedure  no-error .
      311   if error-status :error then message
      312           vss-workfile vss-revision vss-description skip
      313           error-status :get-message(1) skip
      314           return-value skip
      315           "import-proc"
      316           view-as alert-box error
      317           .
      318   RELEASE OBJECT chWorksheet NO-ERROR.
      319   RELEASE OBJECT chWorkbook NO-ERROR.
      320   chExcelApplication :QUIT().
      321   RELEASE OBJECT  chExcelApplication  NO-ERROR.
      322   procedure import-proc:
      323       define variable ii           as integer   no-undo.
      324       define variable t            as char      no-undo.
      325       define variable type-clients as char      no-undo.
      326       define variable code-clients as char      no-undo.
      327       define variable name-clients as char      no-undo.
      328       define variable n-entry      as char      no-undo extent 40.
      329       define variable alf          as character no-undo.
      330       define variable nen          as integer   no-undo .
      331       run cur-time in this-procedure ( output v-today, output v-time).
      332       ii = 1 .
      333       _stroka:
      334       REPEAT ON ERROR UNDO, leave:
      335          ss = "".
      336           ii = ii  + 1.
      337           T = string(ii) .
      338           if chWorkSheet:Range ('A' + T):Value  = ? then leave _stroka.
      339           num-rec = num-rec + 1.
      340           nen = 1 .
      341           alf = "a,b,c,d,e".
      342           mass: do nen = 1 to 5:
      343               n-entry[nen] = chWorkSheet:Range ( entry(nen, alf, ",") + T) :value.
      344               if  n-entry[nen] = ? then   n-entry[nen]  = "" .
      345               ss = ss +   n-entry[nen] + ";".
      346           end.
      347           cod-fiz     = integer( entry(1, ss , ";")) no-error.
      348           num-BD    = integer(entry(2, ss ,";")) no-error.
      349           code-cashier = integer(entry(3, ss ,";")) no-error.
      350           password = entry(4 , ss ,";") no-error.
      351           if LENGTH(string(code-cashier)) > 3 then do:
      352               my-mess =     substitute("Код кассира превышает 3 символа"
      353                   , 'C':U
      354                   , chr(10)
      355                   , error-status:get-message(1)
      356                   , return-value ) .
      357               run err-write in this-procedure ( input-output my-mess , v-obj-code , v-obj-type  ).
      358               .
      359               next  _stroka.
      360           end.
      361           find first clients where clients.obj-code = cod-fiz and clients.obj-type = 'чел':U no-lock no-error.
      362           v-work-place = string(num-BD , '99999').
      363           assign
      364               v-level      = 'db':U
      365               v-host-code  = 0
      366               v-obj-type   = '':U
      367               v-obj-code   = 0
      368               v-date-start = v-today + 1
      369               v-date-end   = 12/31/9999
      370               .
      371           run ref/staff01.p (
      372               input-output p-rid
      373               ,input 'ДОБАВЛЕНИЕ':U
      374               ,input no
      375               ,input 'C':U
      376               ,input code-cashier
      377               ,input clients.obj-code
      378               ,input v-level
      379               ,input v-date-start
      380               ,input v-date-end
      381               ,input num-BD
      382               ,input v-host-code
      383               ,input v-obj-type
      384               ,input v-obj-code
      385               ,input v-work-place
      386               ,input password) no-error .
      387           if error-status:error then
      388           do:
      389               my-mess =     substitute("Ошибка при сохранении записи &1&2&3&2&4"
      390                   , 'C':U
      391                   , chr(10)
      392                   , error-status:get-message(1)
      393                   , return-value ) .
      394               run err-write in this-procedure ( input-output my-mess , v-obj-code , v-obj-type  ).
      395               .
      396           end.
      397           else
      398           do:
      399               num-rec-ok = num-rec-ok + 1 .
      400           end.
      401           next  _stroka.
      402       end.
      403   end procedure.
      404   run write-log-and-file in p-log-handle (
      405       input 1
      406       , input log-file-name
      407       , input 1
      408       , input substitute("Импорт кассиров из файла &1 завершен: из &2 записей успешно закачано &3&4&5"
      409       , file-name
      410       , num-rec
      411       , num-rec-ok
      412       , chr(10) )
      413       ).
      414   .
      415   input stream InStream close.
      416   PROCEDURE ex-file :
      417       define input parameter ff as character no-undo .
      418       define input parameter ex as logical no-undo .
      419       if ex = false then
      420       do:
      421           create "excel.application" chexcelapplication connect no-error.
      422           if error-status:error then
      423           do:
      424               create "excel.application" chexcelapplication no-error.
      425              if error-status :error then
      426              do:
      427                 message
      428                    "Ошибка при запуске Excel" skip
      429                    error-status :get-message(1) skip
      430                    view-as alert-box error .
      431                 undo, return error .
      432              end.
      433           end.
      434           if ff = ""  then
      435           do:
      436               chworkbook   = chexcelapplication:workbooks:add( ).
      437           end.
      438           else
      439           do:
      440               chworkbook   = chexcelapplication:workbooks:open( ff ).
      441           end.
      442       end.
      443       chworksheet  = chexcelapplication:sheets:item (1).
      444   END PROCEDURE.
      445   PROCEDURE err-write:
      446       DEFINE INPUT-OUTPUT PARAMETER mess as char No-UNDO.
      447       define input parameter p-obj-code as integer no-undo.
      448       define input parameter p-obj-type as char no-undo.
      449       seek STREAM Instream to my-seek1.
      450       import stream InStream .
      451       run write-log-and-file in p-log-handle (
      452           input 1
      453           , input log-file-name
      454           , input 1
      455           , input mess + chr(10) + p-obj-type + "   " + string(p-obj-code)  ).
      456       assign
      457           v-view-log = yes.
      458       mess = "".
      459       seek STREAM Instream to my-seek2.
      460   END PROCEDURE.
