        1   block-level on error undo, throw.
        2   define input parameter p-install as logical no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: $":U .
        8   define variable vss-description as character no-undo init "Утилита создания и заполнения ссылков на расписание ВСЕГДА".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure dr-code :
       69     do
       70     on error undo, return error
       71     :
       72       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
       73       define output parameter  p-des               like ub.dis-rule.des               no-undo .
       74       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
       75       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
       76       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
       77       define output parameter  p-level-1           as character no-undo .
       78       define output parameter  p-level-2           as character no-undo .
       79       define output parameter  p-global             as integer no-undo .
       80       define output parameter  p-host               as integer no-undo .
       81       define output parameter  p-object             as integer no-undo .
       82       define output parameter  p-output-display as logical   no-undo .
       83       define output parameter  p-tree           as char  no-undo .
       84       define output parameter  p-other          as character no-undo .
       85       define variable v-other as character no-undo .
       86       define buffer buf_dis-rule for ub.dis-rule .
       87       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
       88       find first buf_dis-rule no-lock where
       89                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
       90       find first buf_dis-cfg-rule no-lock where
       91               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
       92           and buf_dis-cfg-rule.pos-type = '':U
       93           and buf_dis-cfg-rule.table-name = '':U
       94           and buf_dis-cfg-rule.discnt-role = '':U
       95           and buf_dis-cfg-rule.self-nonunique = '':U
       96               no-error.
       97       if not available buf_Dis-cfg-rule then do:
       98           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
       99       end.
      100       assign
      101       p-des = buf_dis-rule.des
      102       p-discnt-type = buf_dis-rule.discnt-type
      103       p-subject-type = buf_dis-rule.subject-type
      104       p-value-type = buf_dis-rule.value-type
      105       p-global = (if available buf_dis-cfg-rule
      106                   then buf_dis-cfg-rule.has-global
      107                   else 0)
      108       p-host = (if available buf_dis-cfg-rule
      109                 then buf_dis-cfg-rule.has-host
      110                 else 0)
      111       p-object = (if available buf_dis-cfg-rule
      112                 then buf_dis-cfg-rule.has-obj
      113                 else 0)
      114       p-output-display = (buf_dis-rule.sts = integer('0':U))
      115       p-tree = buf_Dis-rule.uniq-field
      116       p-other = buf_dis-rule.other-inf
      117       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      118       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      119                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      120                    else '')
      121       .
      122     end.
      123   end procedure.
      124   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      125   procedure disrules-fill-properties:
      126   define input  parameter p-templ-rl-root as integer   no-undo .
      127   define buffer buf_drt-prop for ub.drt-prop.
      128   define buffer buf_temp-drt-prop for temp-drt-prop.
      129   do
      130   on error undo, return error return-value
      131   :
      132     for each buf_temp-drt-prop:
      133       delete buf_temp-drt-prop.
      134     end.
      135     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      136       create buf_temp-drt-prop.
      137       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      138     end.
      139   end.
      140   end procedure.
      141   procedure disrules-get-interface-form :
      142   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      143   define output parameter p-form-name as character no-undo .
      144   define buffer buf_temp-drt-prop for temp-drt-prop.
      145   define buffer buf_drt-prop for ub.drt-prop.
      146   find first buf_temp-drt-prop where
      147             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      148         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      149         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      150   if not available buf_temp-drt-prop then do:
      151     find first buf_drt-prop where
      152               buf_drt-prop.templ-rl-root = p-templ-rl-root
      153           and buf_drt-prop.upper-prop-code = "InputForm"
      154           and buf_drt-prop.prop-code = "FormName" no-error.
      155     if available buf_drt-prop then do:
      156       p-form-name = buf_drt-prop.property-value.
      157     end.
      158     else do:
      159       p-form-name = "ref/dis-ruli.w".
      160     end.
      161   end.
      162   else do:
      163     p-form-name = buf_temp-drt-prop.property-value.
      164   end.
      165   end procedure.
      166   ~
      167   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   procedure dtr-code :
      169     do
      170     on error undo, return error
      171     :
      172       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
      173       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
      174       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
      175       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
      176       define output parameter  p-level-1 as character no-undo .
      177       define output parameter  p-level-2 as character no-undo .
      178       define output parameter  p-output-display as logical   no-undo .
      179       define output parameter  p-tree           as char  no-undo .
      180       define output parameter  p-other          as character no-undo .
      181       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
      182       define buffer buf_dis-time-rule for ub.dis-time-rule .
      183       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      184       if p-templ-rl-root < 50000 then
      185       v-templ-rl-root = (p-templ-rl-root + 50000).
      186       else v-templ-rl-root = p-templ-rl-root.
      187       find first buf_dis-time-rule no-lock where
      188                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      189       if not available buf_dis-time-rule then do:
      190         undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root) .
      191       end.
      192       find first buf_dis-cfg-rule no-lock where
      193               buf_dis-cfg-rule.templ-rl-root = 0
      194           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      195           and buf_dis-cfg-rule.pos-type = '':U
      196           and buf_dis-cfg-rule.table-name = '':U
      197           and buf_dis-cfg-rule.discnt-role = '':U
      198           and buf_dis-cfg-rule.self-nonunique = '':U
      199               no-error.
      200       if not available buf_Dis-cfg-rule then do:
      201           undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root ).
      202       end.
      203       assign
      204       p-des = buf_dis-time-rule.des
      205       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      206       p-value-type = buf_dis-time-rule.value-type
      207       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      208       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      209                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      210                    else '')
      211       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      212       p-tree = buf_dis-time-rule.uniq-field
      213       p-other = buf_dis-time-rule.other-inf
      214       .
      215     end.
      216   end procedure.
      217   define variable start-time     as integer no-undo .
      218   define variable current-time   as integer   no-undo .
      219   define variable v-ind          as integer no-undo .
      220   define variable v-err-count    as integer no-undo .
      221   define variable v-file-name    as char no-undo .
      222   define variable v-ii as integer no-undo .
      223   define variable v-template as integer no-undo .
      224   define buffer buf_dis-time-rule for ub.dis-time-rule .
      225   define buffer buf_sys-ctrl for ub.sys-ctrl.
      226   DEFINE TEMP-TABLE tt0-term_dis-time-rule NO-UNDO LIKE ub.dis-time-rule.
      227   v-file-name = substitute("&1.txt", entry(1, this-procedure:file-name, ".")).
      228   def frame a
      229     "Пересылка заполненных time-rule-num  и time-templ-rl-root таблицы dis-rule"
      230     v-ind        format "->>>>>>>>9" label "Количество записей" skip
      231     current-time format "->>>>>>>>9" label "Время" skip
      232     with view-as dialog-box side-labels three-d
      233     title "Обработка правил скидок"
      234     .
      235   if p-install = false then do:
      236     define variable lok as logical no-undo .
      237     message
      238       vss-description skip(0)
      239       "Переслать на УБД заполненные поля time-rule-num и time-templ-rl-root таблицы dis-rule" skip(0)
      240       "Продолжить?"
      241       view-as alert-box question buttons yes-no update lok .
      242     if lok <> true then do:
      243       return .
      244     end.
      245   end.
      246   do
      247   on error undo, return error
      248   :
      249     assign
      250       start-time = time
      251     .
      252     view frame a .
      253     find first ub.sys-ctrl No-LOCK.
      254     if ub.sys-ctrl.db-num > 0 then do:
      255       message
      256       "На УБД утилиту запускать не надо!"
      257       view-as alert-box warning.
      258       return ''.
      259     end.
      260     do v-ii = 1 to num-entries("5,6,8,9,20,42,48,49,55,56,76"):
      261       assign
      262       v-template = integer(entry(v-ii, "5,6,8,9,20,42,48,49,55,56,76")).
      263       _dis-rule:
      264       for each ub.dis-rule where ub.dis-rule.templ-rl-root = v-template
      265       and ub.dis-rule.rule-num > 99999
      266       on error undo, return error
      267       :
      268         define variable v-found as logical no-undo .
      269         v-found = yes.
      270       end.
      271     end.
      272     if v-found then do:
      273       do v-ii = 1 to num-entries("5,6,8,9,20,42,48,49,55,56,76"):
      274         assign
      275         v-template = integer(entry(v-ii, "5,6,8,9,20,42,48,49,55,56,76")).
      276         _dis-rule:
      277         for each ub.dis-rule where ub.dis-rule.templ-rl-root = v-template
      278         and ub.dis-rule.rule-num > 99999
      279         and ub.dis-rule.root = yes
      280         on error undo, return error
      281         :
      282           assign
      283             v-ind        = v-ind + 1
      284             current-time = time - start-time
      285           .
      286           if v-ind mod 10 = 0 then do:
      287             display
      288             v-ind current-time with frame a .
      289           end.
      290           run str/callnews.p
      291             (input 'dis-rule':U
      292             ,input (buffer ub.dis-rule:handle)
      293             ) no-error.
      294         end.
      295       end.
      296     end.
      297     if p-install = false then do:
      298       message
      299         vss-description skip
      300         "Утилита завершила работу" skip
      301         view-as alert-box information .
      302     end.
      303   END.
      304   procedure err-mess :
      305   define input parameter p-err-mess as character no-undo .
      306     do
      307     on error undo, return error
      308     :
      309       output to value(v-file-name) append.
      310       put unformatted p-err-mess skip.
      311       output close.
      312     end.
      313   end procedure.
