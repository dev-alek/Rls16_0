        1   block-level on error undo, throw.
        2   function objExists return character
        3   (input  ifolder as character,
        4    input  iType   as character  ):
        5       define variable vFileType as character no-undo init "D,F".
        6       define variable vi        as integer no-undo.
        7       define variable vtype as character no-undo.
        8       if iType ne ?
        9       then
       10          vFileType = iType.
       11       do vi = 1 to num-entries(vFileType):
       12          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       13          vtype = file-information:file-type.
       14          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       15             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       16             index(vtype , entry(vi,vFileType )) > 0
       17          then return file-information:full-pathname .
       18          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       19          vtype = file-information:file-type.
       20          if file-information:file-name <> "" and
       21             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       22             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       23             index( vtype, entry(vi,vFileType )) > 0
       24          then return file-information:full-pathname .
       25       end.
       26       return ? .
       27   end.
       28   function SearchFile return character
       29   (input  ifile as character):
       30      return objExists(ifile,?).
       31   end.
       32   function SearchPFile return character
       33   (input inFile as char):
       34        define variable oFile       as character no-undo.
       35        define variable vFileSearch as character no-undo.
       36        define variable vNumEntry   as integer no-undo.
       37        if inFile = "" then return ?.
       38        vNumEntry = num-entries(inFile,".").
       39        vFileSearch = inFile.
       40        if    vNumEntry > 0
       41           and (   entry(vNumEntry,inFile,".") eq "p"
       42                or entry(vNumEntry,inFile,".") eq "w")
       43        then do:
       44           entry(vNumEntry,vFileSearch, ".") = "r".
       45           oFile = search(vFileSearch ).
       46           if oFile eq ?
       47           then
       48              oFile = search(inFile).
       49        end.
       50        else
       51           oFile = search(vFileSearch).
       52        return oFile.
       53     end.
       54      function SavePARAM returns logical ( input iName as character, input iValue as character ):
       55         put unformatted SUBSTITUTE("<PARAM name='&1'>", iName).
       56         put unformatted iValue.
       57         put unformatted SUBSTITUTE("</PARAM name='&1'>", iName) skip.
       58      end .
       59      function GetPARAM returns character  ( input iFile as character, input iName as character ):
       60         define variable vLob  as longchar no-undo.
       61         define variable vFrom as int64    no-undo.
       62         define variable vTo   as int64    no-undo.
       63         iFile = SearchFile (iFile).
       64         if iFile eq ? then return ?.
       65         copy-lob file iFile to vLob no-error.
       66         vFrom = index(vLob, SUBSTITUTE("<PARAM name='&1'>", iName)).
       67         if vFrom <= 0 then return ?.
       68         assign
       69            vTo = index(vLob, SUBSTITUTE("</PARAM name='&1'>", iName))
       70            vFrom = vFrom + LENGTH(SUBSTITUTE("<PARAM name='&1'>", iName)).
       71         if vTo < vFrom then return ?.
       72         return string(substring(vLob, vFrom, vTo - vFrom)).
       73      end.
       74   define variable vFileParam as character no-undo.
       75   define variable mliststrfile as character no-undo.
       76   define variable mi           as integer   no-undo.
       77   define variable changstr     as logical   no-undo.
       78   define variable chancript    as logical   no-undo.
       79   define variable chancriptone as logical   no-undo.
       80   define variable changmd5     as logical   no-undo.
       81   define variable mfilesize    as integer   no-undo.
       82   define variable msizeinfile  as integer   no-undo.
       83   define variable mverinfile   as integer   no-undo.
       84   define variable v-md5-signature  as character no-undo.
       85   define variable mfile        as character no-undo.
       86   define variable mfilename    as character no-undo.
       87   define variable mfileNew     as character no-undo.
       88   define variable mFileRes     as character no-undo.
       89   define variable mDirUpdCk    as character no-undo.
       90   define stream sOut.
       91   define stream dir-stream.
       92   define temp-table tt-file-ver
       93   field  filename as character
       94   field  filesize as integer
       95   field  filever as integer init ?
       96   .
       97   if search("adm/l-i.r") eq ?
       98   then do:
       99      vFileParam = SearchFile ("filesize.txt").
      100      mFileRes = search("utl/mkstrglb.p").
      101      mFileRes = replace(mFileRes,"mkstrglb.p","mkstrres.txt").
      102      output stream sOut to value( mFileRes ).
      103      output stream sOut close.
      104      mliststrfile = "cmp/str-glb2.p,cmp/str-glb3.p,cmp/str-glb4.p,cmp/str-glb5.p,cmp/str-glbl.p,cmp/str-glbt.p".
      105      block-file:
      106      do mi = 1 to num-entries(mliststrfile):
      107         mfile = entry(mi,mliststrfile).
      108         if search (mfile ) = ?
      109         then
      110            mfilesize = 0.
      111         else do:
      112            file-info:file-name = search (mfile).
      113            mfilesize = file-info:file-size.
      114         end.
      115         create tt-file-ver.
      116         assign
      117            tt-file-ver.filename = entry(mi,mliststrfile)
      118            tt-file-ver.filesize = mfilesize
      119         .
      120         if vFileParam ne ?
      121         then do:
      122            assign
      123               msizeinfile = 0
      124               msizeinfile = int(getParam(vFileParam,mfile))
      125            no-error.
      126            if msizeinfile ne mfilesize
      127            then
      128               changstr = yes.
      129         end.
      130         else
      131            changstr = yes.
      132         run SaveFileList(entry(mi,mliststrfile),"cmp/str-glbl.i").
      133      end.
      134      if    changstr
      135         or search ("cmp/str-glbl.i") eq ?
      136      then do:
      137         if search("str-glbl.new") ne ?
      138         then do:
      139            message "Уже начато формирвание str-glbl.i в другой сесссии" skip
      140               search("str-glbl.new")
      141            view-as alert-box.
      142            return.
      143         end.
      144         if search("cmp/str-glbl.i") ne ?
      145         then do:
      146            output stream sOut to value( search("cmp/str-glbl.i")).
      147            put stream sOut "удален" skip.
      148            output stream sOut close.
      149         end.
      150         changstr = yes.
      151   define variable vss-revision    as character no-undo init "$Revision: 6cc672b19ae2, 2597, rls $":U .
      152   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
      153   define variable vss-date        as character no-undo init "$Date: Ср сен 23 11:55:30 2020 +0300 $":U .
      154   define variable vss-workfile    as character no-undo init "$Workfile: mkstrglb.p $":U .
      155   define variable vss-archive     as character no-undo init "$Archive: utl/mkstrglb.p $":U .
      156   define variable vss-description as character no-undo init "Создание файла препроцессингов для системы".
      157   procedure vss-get-info :
      158     define output parameter p-vss-revision    like vss-revision    no-undo .
      159     define output parameter p-vss-author      like vss-author      no-undo .
      160     define output parameter p-vss-date        like vss-date        no-undo .
      161     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      162     define output parameter p-vss-archive     like vss-archive     no-undo .
      163     define output parameter p-vss-description like vss-description no-undo .
      164     assign
      165       p-vss-revision    = vss-revision
      166       p-vss-author      = vss-author
      167       p-vss-date        = vss-date
      168       p-vss-workfile    = vss-workfile
      169       p-vss-archive     = vss-archive
      170       p-vss-description = vss-description
      171     .
      172   end procedure.
      173   procedure vss-get-parameters :
      174     define output parameter p-vss-parameters as character no-undo .
      175   end procedure.
      176   define new global shared variable g#vssrevis-logger as handle    no-undo .
      177   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      178   define variable v-vssrevis-logger                   as handle    no-undo .
      179   procedure vss-logevent :
      180     define input  parameter p-extra-paramters as character no-undo .
      181     define variable v-vssrevis-parameters as character no-undo .
      182     do
      183     on error undo, return error return-value
      184     :
      185       if  valid-handle(v-vssrevis-logger)
      186       and v-vssrevis-logger :get-signature("logevent") <> ""
      187       then do:
      188         run vss-get-parameters in this-procedure
      189           (output v-vssrevis-parameters
      190           ).
      191         run logevent in v-vssrevis-logger
      192           (input vss-workfile
      193           ,input vss-revision
      194           ,input v-vssrevis-parameters
      195           ,input p-extra-paramters
      196           ).
      197       end.
      198     end.
      199   end procedure.
      200   assign
      201     v-vssrevis-logger = g#vssrevis-logger
      202   .
      203   if  valid-handle(v-vssrevis-logger)
      204   and v-vssrevis-logger :get-signature("logevent") <> ""
      205   then do:
      206     assign
      207       v-vssrevis-logevent = true
      208     .
      209     run vss-logevent in this-procedure (input vss-description) .
      210   end.
      211   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      212   define variable v-waitfram-action01         as character   no-undo .
      213   define variable v-waitfram-action02         as character   no-undo .
      214   define variable v-waitfram-action03         as character   no-undo .
      215   define variable mWaitFramTextBeg            as character   no-undo.
      216   define variable mWaitFramTextEnd            as character   no-undo.
      217   define variable mWaitFramView               as logical     no-undo.
      218   define variable mWaitProcEvent              as logical     no-undo init yes.
      219   define variable mWaitFramInterval           as integer     no-undo init 1 .
      220   define variable mWaitFramStop               as logical     no-undo.
      221   define variable mWaitFramStopUser           as logical     no-undo.
      222   define variable mWaitFramStopTimeOut        as logical     no-undo.
      223   define variable mWaitFramStartProc          as datetime-tz no-undo.
      224   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      225   define button B-WaitFramStop auto-end-key
      226        label "Стоп"
      227        size 10 by 1 tooltip "Остоновить процесс".
      228   define button B-viewProcInfo
      229        label "Информация"
      230        size 15 by 1 tooltip "Информация о процесс".
      231   define frame waitfram
      232     v-waitfram-action01 format "x(72)" no-label skip
      233     v-waitfram-action02 format "x(72)" no-label skip
      234     v-waitfram-action03 format "x(72)" no-label skip
      235     B-viewProcInfo
      236     B-WaitFramStop at row 4 col 30
      237     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      238     .
      239   define new global shared variable mBatchMode as logical no-undo init ?.
      240   define variable mFramBachModHandle as handle no-undo.
      241   mFramBachModHandle = frame waitfram:handle.
      242   define variable mFameOldVis as logical no-undo.
      243   define variable mVisCUrentVin as logical no-undo.
      244   if session:batch-mode
      245   then
      246      mBatchMode = yes.
      247   if mBatchMode = ? then do:
      248     mVisCUrentVin = current-window:visible.
      249     mFameOldVis = mFramBachModHandle:visible.
      250     mFramBachModHandle:visible  = yes.
      251     mBatchMode = mFramBachModHandle:visible ne yes.
      252     mFramBachModHandle:visible = mFameOldVis.
      253     current-window:visible = mVisCUrentVin.
      254   end.
      255    if  log-manager:logfile-name ne ?
      256     then DO:
      257         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      258         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      259         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      260     end.
      261   on choose of B-WaitFramStop in frame waitfram
      262   do:
      263     mWaitFramStop = yes.
      264     mWaitFramStopUser = yes.
      265   end.
      266   function waitfram-check-timeout returns logical():
      267      define variable vtime as int64 no-undo.
      268      if mWaitFramStopTimeOut
      269      then
      270         return yes.
      271      vtime = ( now - mWaitFramStartProc ) / 1000 .
      272      if     mWaitFramTimeOut ne ?
      273         and mWaitFramTimeOut ne 0
      274         and mWaitFramTimeOut lt vtime
      275      then do:
      276         mWaitFramStopTimeOut = yes.
      277      end.
      278      return mWaitFramStopTimeOut.
      279   end.
      280   procedure waitfram-hide :
      281     if not session:batch-mode
      282     then do
      283     on error undo, return error return-value
      284     :
      285       pause 0 before-hide .
      286       if not mBatchMode then
      287         hide frame waitfram .
      288     if     not mWaitFramView
      289        and mWaitProcEvent
      290     then
      291       process events .
      292     end.
      293   end procedure.
      294   procedure waitfram-show :
      295     define input  parameter p-message as character no-undo .
      296     define variable v-left-margin as integer   no-undo .
      297     if not session:batch-mode
      298     then do
      299     on error undo, return error return-value
      300     :
      301       if length(p-message) <= 70 then do:
      302         assign
      303           v-left-margin = integer((70 - length(p-message)) / 2)
      304         .
      305         assign
      306           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      307         .
      308         assign
      309           v-waitfram-action01 = " "
      310           v-waitfram-action02 = " "
      311                                    + fill(" ", v-left-margin)
      312                                    + p-message
      313           v-waitfram-action03 = " "
      314         .
      315       end.
      316       else do:
      317         define variable vRindex1 as integer no-undo.
      318         define variable vRindex2 as integer no-undo.
      319         vRindex1 = r-index(p-message," ",70).
      320         if vRindex1 = 0
      321         then
      322            vRindex1 = 70.
      323         if length(p-message)  <= vRindex1 + 70 then do:
      324           assign
      325             v-waitfram-action01 = " "
      326             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      327             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      328           .
      329         end.
      330         else do:
      331           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      332           if vRindex2 <= vRindex1
      333           then
      334              vRindex2 = vRindex1 + 70.
      335           assign
      336             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      337             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      338             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      339           .
      340         end.
      341       end.
      342       B-viewProcInfo:visible   in frame waitfram = no.
      343       B-viewProcInfo:sensitive in frame waitfram = no.
      344       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      345       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      346       if  (   mWaitFramView
      347          or  mWaitProcEvent)
      348          and not mBatchMode
      349       then
      350          display
      351             v-waitfram-action01 skip
      352             v-waitfram-action02 skip
      353             v-waitfram-action03 skip
      354          with frame waitfram .
      355       if     mWaitFramView
      356          then do:
      357             if     mWaitFramInterval ne ?
      358                and not mBatchMode
      359             then
      360                wait-for go of frame waitfram pause mWaitFramInterval.
      361          end.
      362          else
      363             if     mWaitProcEvent
      364                and not mBatchMode
      365             then
      366                process events .
      367     end.
      368   end procedure.
      369      procedure waitfram-show-this:
      370         define input  parameter iInterval as int64 no-undo.
      371         define variable vtime as int64 no-undo.
      372         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      373         mWaitFramInterval = iInterval.
      374         run waitfram-show (substitute("&1&2 &3&4" ,
      375                                       mWaitFramTextBeg ,
      376                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      377                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      378                                       mWaitFramTextEnd
      379                                      )
      380                           ).
      381      end.
      382      procedure WaitFramRunPause:
      383         define input  parameter iInterval as dec no-undo.
      384         define variable vStart  as datetime-tz no-undo.
      385         define variable vend    as datetime-tz no-undo.
      386         define variable vint as int64 no-undo.
      387         define variable vOk as logical no-undo.
      388         vStart = now.
      389         vend   = vStart.
      390         publish "WaitFramPause" (iInterval,output vOk).
      391         vend   =  now.
      392         vint = vend - vStart.
      393         vint = iInterval - vint / 1000.
      394         if     not mWaitFramStop
      395            and (   vint > 0
      396                 or (    not vOk
      397                     and iInterval eq ?
      398                     )
      399                 )
      400         then
      401            run waitfram-show-this (iInterval).
      402         vend   =  now.
      403         vint = vend - vStart.
      404         vint = iInterval - vint / 1000.
      405         if     not mWaitFramStop
      406            and vint > 0
      407         then do:
      408            run gbl/pause.p (vint * 1000).
      409         end.
      410         if iInterval ne ?
      411         then
      412            publish "WaitFramStop".
      413         waitfram-check-timeout().
      414      end.
      415      procedure WaitFramWaitFor:
      416         define input  parameter iInterval as dec no-undo.
      417         assign
      418            mWaitFramStartProc   = now
      419            mWaitFramStopUser    = no
      420            mWaitFramStopTimeOut = no
      421         .
      422         block-wait:
      423         do while not mWaitFramStop:
      424            run WaitFramRunPause (iInterval).
      425            if  waitfram-check-timeout()
      426            then do:
      427               leave block-wait.
      428            end.
      429         end.
      430         run waitfram-hide.
      431      end.
      432   procedure waitfram-join :
      433     define input  parameter p-line-1  as character no-undo .
      434     define input  parameter p-line-2  as character no-undo .
      435     define input  parameter p-line-3  as character no-undo .
      436     define output parameter p-message as character no-undo .
      437     do
      438     on error undo, return error return-value
      439     :
      440       assign
      441         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      442                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      443                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      444       .
      445     end.
      446   end procedure.
      447   function waitfram-join-function returns character
      448     (input p-line-1 as character
      449     ,input p-line-2 as character
      450     ,input p-line-3 as character
      451     ).
      452     define variable v-message as character no-undo .
      453     run waitfram-join in this-procedure
      454       (input  p-line-1
      455       ,input  p-line-2
      456       ,input  p-line-3
      457       ,output v-message
      458       ) .
      459     return v-message .
      460   end function .
      461   define variable v-rus-num-lines as integer   no-undo .
      462   define variable v-eng-num-lines as integer   no-undo .
      463   define temp-table temp-definitions no-undo
      464     field temp-name as character
      465     field temp-rus-line as integer
      466     field temp-eng-line as integer
      467     index xpk is primary unique temp-name .
      468   define stream sinp .
      469   define stream sout .
      470   do
      471   on error undo, leave
      472   on stop  undo, leave
      473   :
      474     define variable v-ok as logical   no-undo .
      475     run waitfram-show in this-procedure
      476       (input "Создание файла определений cmp/str-glbl.i"
      477       ) .
      478     define variable mFileStr as character no-undo.
      479     define variable mdir as character no-undo.
      480     define variable vi as integer no-undo.
      481     mFileStr = replace (search ("cmp/str-glbl.p"), "\","/").
      482     do vi = 1 to num-entries(mFileStr,"/") - 2:
      483        mdir = mdir + entry(vi,mFileStr,"/") + "/".
      484     end.
      485     run cmp/str-glbl.p
      486       (input mdir + 'cmp'
      487       ,output v-rus-num-lines
      488       ) 'rus':U .
      489     run waitfram-show in this-procedure
      490       (input "Создание файла определений int/cmp/str-glbl.i"
      491       ) .
      492     run cmp/str-glbl.p
      493       (input mdir + 'int/cmp':U
      494       ,output v-eng-num-lines
      495       ) 'eng':U .
      496     run waitfram-show in this-procedure
      497       (input "Проверка файлов определений cmp/str-glbl.i, int/cmp/str-glbl.i"
      498       ) .
      499     define variable v-line     as character no-undo .
      500     define variable v-line-num as integer   no-undo .
      501     assign
      502       v-line-num = 0
      503     .
      504     input stream sinp from value(search('cmp/str-glbl.i':U)) .
      505     repeat
      506     :
      507       assign
      508         v-line     = '':U
      509         v-line-num = v-line-num + 1
      510       .
      511       import stream sinp unformatted
      512         v-line
      513         .
      514       if v-line begins '&glob'
      515       then do:
      516         find first temp-definitions
      517           where temp-definitions.temp-name = entry(2, v-line, ' ':U)
      518           no-error .
      519         if not available temp-definitions
      520         then do:
      521           create temp-definitions .
      522           assign
      523             temp-definitions.temp-name     = entry(2, v-line, ' ':U)
      524           .
      525         end.
      526         assign
      527           temp-definitions.temp-rus-line = v-line-num
      528         .
      529       end.
      530     end.
      531     input stream sinp close .
      532     v-rus-num-lines = v-line-num.
      533     assign
      534       v-line-num = 0
      535     .
      536     if search("int/cmp/str-glbl.i") ne ?
      537     then do:
      538        input stream sinp from value(search('int/cmp/str-glbl.i':U)) .
      539        repeat
      540        :
      541          assign
      542            v-line     = '':U
      543            v-line-num = v-line-num + 1
      544          .
      545          import stream sinp unformatted
      546            v-line
      547            .
      548          if v-line begins '&glob'
      549          then do:
      550            find first temp-definitions
      551              where temp-definitions.temp-name = entry(2, v-line, ' ':U)
      552              no-error .
      553            if not available temp-definitions
      554            then do:
      555              create temp-definitions .
      556              assign
      557                temp-definitions.temp-name     = entry(2, v-line, ' ':U)
      558              .
      559            end.
      560            assign
      561              temp-definitions.temp-eng-line = v-line-num
      562            .
      563          end.
      564        end.
      565        input stream sinp close .
      566     end.
      567     v-eng-num-lines = v-line-num.
      568     define variable v-clear-file  as logical   no-undo .
      569     define variable v-error-exist as logical   no-undo .
      570     assign
      571       v-clear-file = true
      572     .
      573     for each temp-definitions
      574       where temp-definitions.temp-rus-line = 0
      575          or temp-definitions.temp-eng-line = 0
      576     on error undo, return error return-value
      577     :
      578       assign
      579         v-error-exist = true
      580       .
      581       if v-clear-file = true
      582       then do:
      583         assign
      584           v-clear-file = false
      585         .
      586         output stream sout to value('str-glbl_err.txt':U) .
      587         output stream sout close .
      588       end.
      589       output stream sout to value('str-glbl_err.txt':U) append .
      590       export stream sout temp-definitions .
      591       output stream sout close .
      592     end.
      593     run waitfram-hide in this-procedure .
      594     output to "error.log".
      595     if v-error-exist = true
      596     then do:
      597        put unformatted
      598         "Были обнаружены ошибки при создании файлов" skip
      599         "" skip
      600         "Создание файлов определений str-glbl.i завершено" skip
      601         "Файл" 'cmp/str-glbl.i':U skip
      602         "Строк в файле " v-rus-num-lines skip
      603         "Файл" 'int/cmp/str-glbl.i':U skip
      604         "Строк в файле " v-eng-num-lines skip
      605       .
      606     end.
      607     else do:
      608        put unformatted
      609         "OK" skip
      610         "" skip
      611         "Создание файлов определений str-glbl.i завершено" skip
      612         "Файл" 'cmp/str-glbl.i':U skip
      613         "Строк в файле " v-rus-num-lines skip
      614         "Файл" 'int/cmp/str-glbl.i':U skip
      615         "Строк в файле " v-eng-num-lines skip
      616        .
      617     end.
      618     output close.
      619   end.
      620      end.
      621      mliststrfile = "upd/code.xml,cmp/procasunc.xml".
      622      block-md5:
      623      do mi = 1 to num-entries(mliststrfile):
      624         mfile = entry(mi,mliststrfile).
      625         mfileNew = mFile.
      626         entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      627         if search (mfile) eq ?
      628         then
      629            next block-md5.
      630         run SaveFileList (mfile,mfileNew).
      631         do:
      632            mfileNew = search (mfile).
      633            entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      634            run gbl/md5.p(mfile,output v-md5-signature).
      635            output stream sOut to value(mfileNew).
      636            put stream sOut unformatted string(encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      637    )  skip.
      638            output stream sOut close.
      639         end.
      640      end.
      641      define variable mdbver as integer no-undo.
      642      block-upd:
      643      do mdbver = 1 to 999999999:
      644         mfile    = substitute("upd/&1.xml",string(mdbver ,"999999999")).
      645         if    search(mfile)    eq ?
      646         then
      647            leave block-upd.
      648         mfileNew = mFile.
      649         entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      650         run SaveFileList (mfile,mfileNew).
      651         mfile = search(mfile).
      652         mfileNew = mFile.
      653         entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      654         run gbl/md5.p(mfile,output v-md5-signature).
      655         output stream sOut to value(mfileNew).
      656         put stream sOut unformatted encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      657      skip.
      658         output stream sOut close.
      659      end.
      660      mDirUpdCk = objExists("updck","D").
      661      if mDirUpdCk <> ? then do:
      662          input stream dir-stream from os-dir( mDirUpdCk ) no-attr-list no-echo .
      663          block-updck:
      664          repeat:
      665             import stream dir-stream mfilename mfile .
      666             file-info :file-name = mfile.
      667             if caps( file-info :file-type ) begins "F":U and
      668                entry(2, file-info:file-name, ".") = "xml" then
      669             do:
      670                mfileNew = mFile.
      671                entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      672                run SaveFileList (mfile,mfileNew).
      673                mfile = search(mfile).
      674                mfileNew = mFile.
      675                entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      676                run gbl/md5.p(mfile,output v-md5-signature).
      677                output stream sOut to value(mfileNew).
      678                put stream sOut unformatted encode(v-md5-signature + "updck" ) + string(index(encode(string(v-md5-signature)), "k"))
      679      skip.
      680                output stream sOut close.
      681             end.
      682          end.
      683          input stream dir-stream close.
      684      end.
      685      mliststrfile = "cmp/actn.txt,cmp/menu.txt".
      686      do mi = 1 to num-entries(mliststrfile):
      687         mfile = entry(mi,mliststrfile).
      688         mfilenew = replace (mfile,".txt",".enc").
      689         run SaveFileList (mfile,mfileNew).
      690         mfile = search(mfile).
      691         create tt-file-ver.
      692         tt-file-ver.filename = mfile.
      693         run getverfile (mfile,
      694                         output tt-file-ver.filesize,
      695                         output tt-file-ver.filever).
      696         if vFileParam ne ?
      697         then do:
      698            assign
      699               msizeinfile = 0
      700               msizeinfile = int(getParam(vFileParam,mfile))
      701            no-error.
      702            assign
      703               mverinfile = 0
      704               mverinfile = int(getParam(vFileParam,mfile + "|ver"))
      705            no-error.
      706            if    msizeinfile ne tt-file-ver.filesize
      707               or mverinfile  ne tt-file-ver.filever
      708            then do:
      709               chancriptone = yes.
      710            end.
      711         end.
      712         else
      713            chancriptone = yes.
      714         mfilenew = replace (mfile,".txt",".enc").
      715         if    chancriptone
      716            or search(mfilenew) eq ?
      717         then do:
      718             chancript = yes.
      719             run utl/filecrypnodb.p ( input mfile
      720                                  , input "sysadm"
      721                                  , input yes
      722                                  , input mfileNew
      723                                 ) .
      724         end.
      725      end.
      726      if    changstr
      727         or chancript
      728         or changmd5
      729      then do:
      730         output to "filesize.txt".
      731         for each tt-file-ver:
      732            saveparam(tt-file-ver.filename,string(tt-file-ver.filesize)).
      733            if tt-file-ver.filever ne ?
      734            then
      735               saveparam(tt-file-ver.filename + "|ver" ,string(tt-file-ver.filever)).
      736         end.
      737         output close.
      738      end.
      739      run utlcomp/crpwd.p(no).
      740      run utlcomp/crkey.p(no).
      741      run SaveFileList ("utlcomp/crpwd.p","utlcomp/crpwd.i").
      742      run SaveFileList ("utlcomp/crkey.p","utlcomp/keypub.i").
      743      run SaveFileList ("utlcomp/crkey.p","utlcomp/keypriv.i").
      744      run SaveFileList ("utlcomp/crkey.p","utlcomp/keyset.i").
      745   end.
      746   procedure SaveFileList:
      747      define input  parameter iFileNameOld as character no-undo.
      748      define input  parameter iFileNameNew as character no-undo.
      749      output stream sOut to value( mFileRes ) append.
      750      put stream sOut unformatted iFileNameOld  " " iFileNameNew skip.
      751      put stream sOut unformatted "utl/chkstrgbl.p " iFileNameNew skip.
      752      output stream sOut close.
      753   end.
      754   define stream sinp .
      755   procedure getverfile:
      756      define input  parameter iFileName as character no-undo.
      757      define output parameter oFilesize as integer   no-undo.
      758      define output parameter oFilever  as integer   no-undo.
      759      define variable vTXt as character no-undo.
      760      if iFileName eq ?
      761      then do:
      762         ofilesize = 0.
      763         return.
      764      end.
      765      else do:
      766         file-info:file-name = iFileName.
      767         ofilesize = file-info:file-size.
      768      end.
      769      input stream sinp from value(iFileName) .
      770      import stream sinp unformatted vTXt .
      771      oFilever = integer (trim(vtxt,'"')) no-error.
      772      input stream sinp close .
      773   end.
