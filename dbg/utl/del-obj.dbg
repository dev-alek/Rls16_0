     6983   procedure delete-stop-list :
     6984     define input  parameter p-obj-type as character no-undo .
     6985     define input  parameter p-obj-code as integer   no-undo .
     6986     define variable v-host-code as integer no-undo .
     6987     define buffer buf_stop-list for ub.stop-list .
     6988     define buffer buf_stop-list-line for ub.stop-list-line .
     6989     define buffer buf_c-stop-list for ub.c-stop-list .
     6990     define buffer buf_c-stop-list-line for ub.c-stop-list-line .
     6991     define buffer buf_sysconf for ub.sysconf.
     6992     on delete of ub.stop-list override do: end.
     6993     on delete of ub.c-stop-list override do: end.
     6994     on delete of ub.stop-list-line override do: end.
     6995     on delete of ub.c-stop-list-line override do: end.
     6996     do
     6997     on error undo, return error return-value
     6998     :
     6999   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7000   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7001     (input  p-obj-type
     7002     ,input  p-obj-code
     7003     ,output v-host-code
     7004     )  .
     7005       find first buf_sysconf no-lock where
     7006                 buf_sysconf.host-code = v-host-code.
     7007       for each buf_stop-list exclusive-lock
     7008         where buf_stop-list.obj-type = p-obj-type
     7009           and buf_stop-list.obj-code = p-obj-code
     7010       on error undo, return error return-value
     7011       :
     7012         for each buf_stop-list-line exclusive-lock
     7013           where buf_stop-list-line.classif-type = buf_stop-list.classif-type
     7014           and buf_stop-list-line.stop-list-code = buf_stop-list.stop-list-code
     7015         on error undo, return error return-value
     7016         :
     7017           delete buf_stop-list-line .
     7018         end.
     7019         for each buf_c-stop-list exclusive-lock
     7020           where buf_c-stop-list.classif-type = buf_stop-list.classif-type
     7021           and buf_c-stop-list.stop-list-code = buf_stop-list.stop-list-code
     7022         on error undo, return error return-value
     7023         :
     7024           delete buf_c-stop-list .
     7025         end.
     7026         for each buf_c-stop-list-line exclusive-lock
     7027           where buf_c-stop-list-line.classif-type = buf_stop-list.classif-type
     7028           and buf_c-stop-list-line.stop-list-code = buf_stop-list.stop-list-code
     7029         on error undo, return error return-value
     7030         :
     7031           delete buf_c-stop-list-line .
     7032         end.
     7033         run delete-route in this-procedure
     7034           ( input 'stop-list':U
     7035            ,input (buffer buf_stop-list:handle)
     7036           ) .
     7037         delete buf_stop-list .
     7038       end.
     7039       for each buf_c-stop-list exclusive-lock
     7040         where buf_c-stop-list.obj-type = p-obj-type
     7041           and buf_c-stop-list.obj-code = p-obj-code
     7042       on error undo, return error return-value
     7043       :
     7044         for each buf_c-stop-list-line exclusive-lock
     7045           where buf_c-stop-list-line.classif-type = buf_stop-list.classif-type
     7046           and buf_c-stop-list-line.stop-list-code = buf_c-stop-list.stop-list-code
     7047         on error undo, return error return-value
     7048         :
     7049           delete buf_c-stop-list-line .
     7050         end.
     7051         run delete-route in this-procedure
     7052           ( input 'c-stop-list':U
     7053            ,input (buffer buf_c-stop-list:handle)
     7054           ) .
     7055         delete buf_c-stop-list .
     7056       end.
     7057     end.
     7058   end procedure.
     7059   procedure convert-payment :
     7060     define input  parameter p-obj-type as character no-undo .
     7061     define input  parameter p-obj-code as integer   no-undo .
     7062   define variable v-host-code as integer no-undo .
     7063   define variable v-obj-type-code as character no-undo .
     7064   define buffer buf_payment for ub.payment.
     7065   define buffer buf_sysconf for ub.sysconf.
     7066   on write of ub.payment override do: end.
     7067     do
     7068     on error undo, return error
     7069     :
     7070   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7071   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7072     (input  p-obj-type
     7073     ,input  p-obj-code
     7074     ,output v-host-code
     7075     )  .
     7076       v-obj-type-code = substitute('&1&2-', p-obj-type, p-obj-code).
     7077       find first buf_sysconf no-lock where
     7078               buf_sysconf.host-code = v-host-code.
     7079       for each buf_payment where
     7080               buf_payment.host-code = v-host-code
     7081           and buf_payment.source-type = 'касс':U
     7082           and buf_payment.source-ref begins v-obj-type-code
     7083         on error undo, return error return-value
     7084         :
     7085           assign
     7086           buf_payment.source-type = '':U
     7087           buf_payment.pay-code = buf_sysconf.cash-pay
     7088           buf_payment.PS = substitute("!смена типа/кода платежа после удаления объекта &1&2", p-obj-type, p-obj-code)
     7089           .
     7090       end.
     7091       for each buf_payment where
     7092               buf_payment.host-code = v-host-code
     7093           and buf_payment.source-type = 'накл':U
     7094           and buf_payment.source-ref begins v-obj-type-code
     7095         on error undo, return error return-value
     7096         :
     7097           assign
     7098           buf_payment.source-type = '':U
     7099           buf_payment.PS = substitute("!смена типа платежа после удаления объекта &1&2", p-obj-type, p-obj-code)
     7100           .
     7101       end.
     7102     end.
     7103   end procedure.
     7104   procedure delete-ext-classif :
     7105     define input  parameter p-uniq-key-rec as character no-undo .
     7106     define input  parameter p-obj-type as character no-undo .
     7107     define input  parameter p-obj-code as integer   no-undo .
     7108     define buffer buf_ext-classif      for ub.ext-classif .
     7109     define buffer buf_c-ext-classif      for ub.c-ext-classif .
     7110     define buffer buf_clients for ub.clients.
     7111     on delete of ub.ext-classif override do: end.
     7112     on delete of ub.c-ext-classif override do: end.
     7113     define variable v-uniq-key-rec as character no-undo .
     7114     define variable v-names as character no-undo .
     7115     define variable v-ii as integer no-undo .
     7116     do
     7117     on error undo, return error return-value
     7118     :
     7119       v-names = 'clients-esys':U .
     7120       do v-ii = 1 to num-entries(v-names):
     7121         for each buf_Ext-classif where
     7122                 buf_ext-classif.classif-name = entry(v-ii, v-names)
     7123             and buf_Ext-classif.uniq-key-rec = p-uniq-key-rec
     7124         on error undo, return error return-value
     7125         :
     7126           run delete-route in this-procedure
     7127             ( input 'ext-classif':U
     7128             ,input (buffer buf_ext-classif:handle)
     7129             ) .
     7130           delete buf_ext-classif .
     7131         end.
     7132         for each buf_c-Ext-classif where
     7133                 buf_c-ext-classif.classif-name = entry(v-ii, v-names)
     7134             and buf_c-Ext-classif.uniq-key-rec = p-uniq-key-rec
     7135         on error undo, return error return-value
     7136         :
     7137           run delete-route in this-procedure
     7138             ( input 'c-ext-classif':U
     7139             ,input (buffer buf_c-ext-classif:handle)
     7140             ) .
     7141           delete buf_c-ext-classif .
     7142         end.
     7143       end.
     7144     end.
     7145   end procedure.
     7146   procedure delete-egais :
     7147     define input  parameter p-obj-type as character no-undo .
     7148     define input  parameter p-obj-code as integer   no-undo .
     7149     define buffer buf_egais-clients for ub.egais-clients.
     7150     do
     7151     on error undo, return error return-value
     7152     :
     7153       for each buf_egais-clients exclusive-lock
     7154         where buf_egais-clients.obj-type = p-obj-type
     7155           and buf_egais-clients.obj-code = p-obj-code
     7156       :
     7157         assign
     7158           buf_egais-clients.obj-type = ''
     7159           buf_egais-clients.obj-code = 0
     7160         .
     7161       end.
     7162     end.
     7163   end procedure.
     7164   procedure check-can-delete :
     7165     define input  parameter p-obj-type as character no-undo .
     7166     define input  parameter p-obj-code as integer   no-undo .
     7167     do
     7168     on error undo, return error return-value
     7169     :
     7170       define buffer buf_db for ub.db .
     7171       define buffer buf_clients for ub.clients .
     7172       define buffer buf_trn-doc for ub.trn-doc .
     7173       define buffer supp_clients for ub.clients .
     7174       define variable v-return-error as logical   no-undo .
     7175       for each buf_trn-doc no-lock
     7176         where buf_trn-doc.hold-obj-type = p-obj-type
     7177           and buf_trn-doc.hold-obj-code = p-obj-code
     7178           and buf_trn-doc.status_ <> 'факт':U
     7179       on error undo, return error return-value
     7180       :
     7181           assign
     7182             v-return-error = true
     7183           .
     7184           run log-error in this-procedure
     7185             (input substitute("Объект &1 &2, Документ МФ &3"
     7186                     ,buf_trn-doc.obj-type
     7187                     ,buf_trn-doc.obj-code
     7188                     ,buf_trn-doc.doc-code
     7189                     )
     7190             ) .
     7191       end.
     7192       for each buf_db no-lock
     7193       on error undo, return error return-value
     7194       :
     7195         for each buf_clients no-lock
     7196           where buf_clients.db-num = buf_db.db-num
     7197         on error undo, return error return-value
     7198         :
     7199           for each buf_trn-doc no-lock
     7200             where buf_trn-doc.obj-type = buf_clients.obj-type
     7201               and buf_trn-doc.obj-code = buf_clients.obj-code
     7202               and buf_trn-doc.status_ <> 'факт':U
     7203           on error undo, return error return-value
     7204           :
     7205             find first supp_clients no-lock
     7206               where supp_clients.obj-type = buf_trn-doc.obj-type
     7207                 and supp_clients.obj-code = buf_trn-doc.obj-code
     7208               no-error .
     7209             if not available supp_clients then do:
     7210               assign
     7211                 v-return-error = true
     7212               .
     7213               run log-error in this-procedure
     7214                 (input substitute("Объект &1 &2. Документ &3. Неизвестный контрагент"
     7215                        ,buf_clients.obj-type
     7216                        ,buf_clients.obj-code
     7217                        ,buf_trn-doc.doc-code
     7218                        )
     7219                 ) .
     7220               next .
     7221             end.
     7222             if supp_clients.db-num <> ?
     7223             and supp_clients.obj-type = p-obj-type
     7224             and supp_clients.obj-code = p-obj-code
     7225             then do:
     7226               assign
     7227                 v-return-error = true
     7228               .
     7229               run log-error in this-procedure
     7230                 (input substitute("Объект &1 &2, Документ &3"
     7231                        ,buf_clients.obj-type
     7232                        ,buf_clients.obj-code
     7233                        ,buf_trn-doc.doc-code
     7234                        )
     7235                 ) .
     7236             end.
     7237           end.
     7238         end.
     7239       end.
     7240       if v-return-error = true then do:
     7241         return error .
     7242       end.
     7243     end.
     7244   end procedure.
     7245   procedure log-error :
     7246     define input  parameter p-message as character no-undo .
     7247     do
     7248     on error undo, return error return-value
     7249     :
     7250       output stream slog to value('del-obj.err') append .
     7251       export stream slog v-obj-type v-obj-code cur-time-string() p-message .
     7252       output stream slog close .
     7253     end.
     7254   end procedure.
     7255   procedure generate-check-string :
     7256     define input  parameter p-obj-type     as character no-undo .
     7257     define input  parameter p-obj-code     as integer   no-undo .
     7258     define output parameter p-check-string as character no-undo .
     7259     do
     7260     on error undo, return error return-value
     7261     :
     7262       define buffer buf_sys-ctrl for ub.sys-ctrl .
     7263       define buffer buf_db       for ub.db .
     7264       find first buf_sys-ctrl no-lock .
     7265       find first buf_db no-lock
     7266         where buf_db.db-num = buf_sys-ctrl.db-num .
     7267       assign
     7268         p-check-string =
     7269           substitute('del-obj,&1,&2,&3,&4,&5':u
     7270             ,p-obj-type
     7271             ,p-obj-code
     7272             ,p-check-rest
     7273             ,cur-time-date()
     7274             ,buf_sys-ctrl.db-num
     7275           )
     7276       .
     7277     end.
     7278   end procedure.
