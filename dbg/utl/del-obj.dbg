     2700   PROCEDURE find-def-analysis-obj :
     2701   define input  parameter p-type     as character no-undo .
     2702   define input  parameter p-obj-type as character no-undo .
     2703   define input  parameter p-obj-code as integer   no-undo .
     2704   define output parameter p-abc-id   as integer   no-undo .
     2705   define output parameter p-db-num   as integer   no-undo .
     2706     do
     2707     on error undo, return error return-value
     2708     :
     2709     if p-type = "abc"  then do:
     2710         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     2711         define buffer buf_abc-analysis     for ub.abc-analysis      .
     2712         find first buf_abc-analysis-obj no-lock where
     2713                   buf_abc-analysis-obj.obj-type = p-obj-type and
     2714                   buf_abc-analysis-obj.obj-code = p-obj-code and
     2715                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
     2716                   if available buf_abc-analysis-obj then do:
     2717                       p-abc-id = buf_abc-analysis-obj.abc-id .
     2718                       p-db-num = buf_abc-analysis-obj.db-num .
     2719                   end.
     2720                   else do:
     2721                       p-abc-id = 0 .
     2722                       p-db-num = 0.
     2723                       return "На объекте нет анализа по умолчанию" .
     2724                   end.
     2725     end.
     2726     if p-type = "xyz"  then do:
     2727         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     2728         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     2729         find first buf_xyz-analysis-obj no-lock where
     2730                   buf_xyz-analysis-obj.obj-type = p-obj-type and
     2731                   buf_xyz-analysis-obj.obj-code = p-obj-code and
     2732                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
     2733                   if available buf_xyz-analysis-obj then do:
     2734                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
     2735                       p-db-num = buf_xyz-analysis-obj.db-num .
     2736                   end.
     2737                   else do:
     2738                       p-abc-id = 0 .
     2739                       p-db-num = 0 .
     2740                       return "На объекте нет анализа по умолчанию" .
     2741                   end.
     2742     end.
     2743     return .
     2744   end.
     2745   END PROCEDURE.
     2746   procedure save-def-analysis-obj :
     2747   define input  parameter p-type     as character no-undo .
     2748   define input  parameter p-db-num   as integer   no-undo .
     2749   define input  parameter p-abc-id   as integer   no-undo .
     2750   define output parameter v-log      as logical   no-undo .
     2751     do
     2752     on error undo, return error return-value
     2753     :
     2754     v-log = true .
     2755     if p-type = "abc"  then do:
     2756         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     2757         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
     2758         define buffer buf_abc-analysis     for ub.abc-analysis      .
     2759         for each buf_abc-obj no-lock where
     2760                  buf_abc-obj.abc-id = p-abc-id and
     2761                  buf_abc-obj.db-num = p-db-num :
     2762               define variable v-exist    as logical   no-undo init false .
     2763               define variable v-list-anal as character no-undo init ""    .
     2764               for each  buf_abc-analysis-obj no-lock where
     2765                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
     2766                              buf_abc-analysis-obj.db-num = p-db-num) and
     2767                         buf_abc-analysis-obj.is-def   = true   and
     2768                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     2769                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
     2770                         :
     2771                   v-exist    = true .
     2772                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
     2773               end.
     2774               if v-exist then do:
     2775                   message "На объекте "
     2776                   buf_abc-obj.obj-type
     2777                   buf_abc-obj.obj-code
     2778                   skip
     2779                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     2780                   v-list-anal                                              skip
     2781                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     2782                   view-as alert-box question
     2783                   buttons yes-no update v-log .
     2784                   if v-log then do:
     2785                       for each  buf_abc-analysis-obj exclusive-lock where
     2786                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     2787                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
     2788                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
     2789                              buf_abc-analysis-obj.db-num = p-db-num ) then
     2790                                 buf_abc-analysis-obj.is-def   = true .
     2791                         else buf_abc-analysis-obj.is-def   = false  .
     2792                       end.
     2793                   end.
     2794               end.
     2795               else do:
     2796                 for each  buf_abc-analysis-obj exclusive-lock where
     2797                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     2798                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
     2799                           buf_abc-analysis-obj.abc-id = p-abc-id and
     2800                           buf_abc-analysis-obj.db-num = p-db-num
     2801                           :
     2802                     buf_abc-analysis-obj.is-def   = true .
     2803                 end.
     2804               end.
     2805         end.
     2806     end.
     2807     if p-type = "xyz"  then do:
     2808         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     2809         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     2810         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     2811         for each buf_xyz-obj no-lock where
     2812                  buf_xyz-obj.xyz-id = p-abc-id and
     2813                  buf_xyz-obj.db-num = p-db-num :
     2814               v-exist = false .
     2815               v-list-anal = ""    .
     2816               for each  buf_xyz-analysis-obj no-lock where
     2817                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     2818                              buf_xyz-analysis-obj.db-num = p-db-num) and
     2819                         buf_xyz-analysis-obj.is-def   = true   and
     2820                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     2821                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     2822                         :
     2823                   v-exist    = true .
     2824                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     2825               end.
     2826               if v-exist then do:
     2827                   message "На объекте "
     2828                   buf_xyz-obj.obj-type
     2829                   buf_xyz-obj.obj-code
     2830                   skip
     2831                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     2832                   v-list-anal                                              skip
     2833                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     2834                   view-as alert-box question
     2835                   buttons yes-no update v-log .
     2836                   if v-log then do:
     2837                       for each  buf_xyz-analysis-obj exclusive-lock where
     2838                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     2839                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     2840                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     2841                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     2842                                 buf_xyz-analysis-obj.is-def   = true .
     2843                         else buf_xyz-analysis-obj.is-def   = false  .
     2844                       end.
     2845                   end.
     2846               end.
     2847               else do:
     2848                 for each  buf_xyz-analysis-obj exclusive-lock where
     2849                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     2850                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     2851                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     2852                           buf_xyz-analysis-obj.db-num = p-db-num
     2853                           :
     2854                     buf_xyz-analysis-obj.is-def   = true .
     2855                 end.
     2856               end.
     2857         end.
     2858     end.
     2859   end.
     2860   end procedure.
     2861   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2862   define stream slog .
     2863   on delete of ub.nws-doc-hist override do: end.
     2864   do
     2865   on error undo, return error return-value
     2866   :
     2867     define variable v-password-check-string as character no-undo .
     2868     define buffer buf_sys-ctrl for ub.sys-ctrl .
     2869     define variable v-current-action as character no-undo .
     2870     define variable v-current-time   as character no-undo .
     2871     define variable v-start-time     as integer   no-undo .
     2872     define variable v-uniq-key-rec as character no-undo .
     2873     define variable v-ind      as integer   no-undo .
     2874     define variable v-obj-type as character no-undo .
     2875     define variable v-obj-code as integer   no-undo .
     2876     define variable v-passwd   as character no-undo .
     2877     assign
     2878       v-start-time = time
     2879     .
     2880     def frame show-act
     2881       v-current-action         format "x(50)"      no-label skip
     2882       v-current-time           format "x(8)"       label "Время" skip
     2883       with view-as dialog-box side-labels three-d
     2884       title "Удаление объекта"
     2885       .
     2886     view frame show-act.
     2887     run log-information in this-procedure
     2888       (input "check-input-parameters"
     2889       ) .
     2890     run check-input-parameters in this-procedure no-error .
     2891     if error-status :error then do:
     2892       message
     2893         vss-workfile vss-revision vss-description skip
     2894         "Неправильно заданы входные параметры" skip
     2895         "Пароли " p-pswd-list skip
     2896         view-as alert-box error .
     2897       undo, return error .
     2898     end.
     2899     find first buf_sys-ctrl no-lock .
     2900     if g#news <> true then do:
     2901       if buf_sys-ctrl.db-num <> 0 then do:
     2902         message
     2903           vss-workfile vss-revision vss-description skip
     2904           substitute( "Данная утилита предназначена для работы только в ГБД" ) skip
     2905           view-as alert-box error
     2906         .
     2907         undo, return error .
     2908       end.
     2909       if  p-pswd-list = ""
     2910       and p-check-string-file <> "" then do:
     2911         output stream slog to value(p-check-string-file) .
     2912         put stream slog unformatted "":U .
     2913         output stream slog close .
     2914         do v-ind = 1 to num-entries( p-obj-list, chr(44) ) by 2
     2915         :
     2916           assign
     2917             v-obj-type = entry( v-ind, p-obj-list, chr(44) )
     2918             v-obj-code = integer( entry( v-ind + 1, p-obj-list, chr(44) ) )
     2919           .
     2920           run generate-check-string in this-procedure
     2921             ( input v-obj-type
     2922             , input v-obj-code
     2923             , output v-password-check-string
     2924           ) .
     2925           output stream slog to value(p-check-string-file) append.
     2926           put stream slog unformatted v-password-check-string + chr(10) .
     2927           output stream slog close .
     2928         end.
     2929         message
     2930           "Информация о параметрах запуска сохранена в файле" skip
     2931           "Имя файла" p-check-string-file skip
     2932           "Отправьте файл в службу поддержки пользователей для получения лицензии" skip
     2933           "на запуск программы с указанными параметрами." skip
     2934           "По получению лицензии запустите утилиту еще раз." skip
     2935           view-as alert-box information .
     2936         return .
     2937       end.
     2938       else do:
     2939         define variable v-check-passwd as character no-undo .
     2940         do v-ind = 1 to num-entries( p-obj-list, chr(44) ) by 2
     2941         :
     2942           assign
     2943             v-obj-type = entry( v-ind, p-obj-list, chr(44) )
     2944             v-obj-code = integer( entry( v-ind + 1, p-obj-list, chr(44) ) )
     2945             v-passwd   = entry( integer((v-ind + 1) / 2), p-pswd-list, chr(44) )
     2946           .
     2947           run generate-check-string in this-procedure
     2948             ( input v-obj-type
     2949             , input v-obj-code
     2950             , output v-password-check-string
     2951             ) .
     2952           run adm/pswd-enc.p
     2953             (input  v-password-check-string
     2954             ,output v-check-passwd
     2955             ) no-error .
     2956           if error-status :error then do:
     2957             message
     2958               vss-workfile vss-revision vss-description skip
     2959               "Ошибка при проверке пароля"
     2960               return-value skip
     2961               error-status :get-message(1) skip
     2962               view-as alert-box error .
     2963             undo, return error .
     2964           end.
     2965           if v-passwd <> v-check-passwd then do:
     2966             message
     2967               "Неправильный пароль" skip
     2968               "Параметры запуска программы" v-password-check-string skip
     2969               substitute( "Объект &1 &2", v-obj-type, v-obj-code ) skip
     2970               substitute( "Пароль &1", v-passwd ) skip
     2971               view-as alert-box error .
     2972             undo, return error .
     2973           end.
     2974         end.
     2975       end.
     2976     end.
     2977     do v-ind = 1 to num-entries( p-obj-list, chr(44) ) by 2
