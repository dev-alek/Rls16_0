     5672           ) .
     5673         delete buf_dis-card-property .
     5674       end.
     5675       for each buf_dis-dc-rule exclusive-lock
     5676         where buf_dis-dc-rule.host-code = v-host-code
     5677           and buf_dis-dc-rule.obj-type = p-obj-type
     5678           and buf_dis-dc-rule.obj-code = p-obj-code
     5679       on error undo, return error return-value
