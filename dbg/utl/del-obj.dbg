     6187     :
     6188       for each buf_user-obj exclusive-lock
     6189         where buf_user-obj.obj-type = p-obj-type
     6190           and buf_user-obj.obj-code = p-obj-code
     6191       on error undo, return error return-value
     6192       :
     6193         delete buf_user-obj .
     6194         run delete-route in this-procedure
     6195           ( input 'user-obj':U
     6196           , input (buffer buf_user-obj:handle)
     6197           ) .
     6198       end.
     6199       for each  buf_user-menu-group
     6200           where buf_user-menu-group.db-num   = ub.user-obj.db-num
     6201             and buf_user-menu-group.user-id  = ub.user-obj.user-id
     6202             and buf_user-menu-group.obj-type = ub.user-obj.obj-type
     6203             and buf_user-menu-group.obj-code = ub.user-obj.obj-code
     6204             and buf_user-menu-group.menu-group-context = 'object':U
     6205           exclusive-lock
     6206           :
