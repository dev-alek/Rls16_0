      577   define new global shared variable g#library  as handle no-undo .
      578   define new global shared variable g#library2 as handle no-undo .
      579   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   define temp-table doc-list no-undo
      581     field doc-code         like ub.trn-doc.doc-code
      582     field obj-type         like ub.trn-doc.obj-type
      583     field obj-code         like ub.trn-doc.obj-code
      584     field fact-date        like ub.trn-doc.fact-date
      585     field shift-date       like ub.trn-doc.shift-date
      586     field shift-num        like ub.trn-doc.shift-num
      587     field shift-name       like ub.trn-doc.shift-name
      588     field fact-order       as decimal
      589     field is-trn-doc       as logical
      590     field doc-type         like ub.trn-doc.doc-type
      591     field is-archive-exist as logical
      592     index xpk is primary unique doc-code doc-type
      593     index xfact-order fact-order
      594     index xfact-date  fact-date
      595     .
      596   define temp-table doclslib-goods no-undo
      597     field gds-code  as integer
      598     field artic     as character
      599     field prod-type as character
      600     field prod-code as integer
      601     index xpk is primary unique gds-code
      602     index xie1 artic prod-type prod-code
      603     .
      604   define buffer inkas_trn-doc for ub.trn-doc .
      605   define stream doclsliblog .
      606   procedure doclslib-clear-doc-list :
      607     define buffer buf_doc-list for doc-list .
      608     do
      609     on error undo, return error
      610     :
      611       for each buf_doc-list
      612       on error undo, return error
      613       :
      614         delete buf_doc-list .
      615       end.
      616     end.
      617   end procedure.
      618   procedure doclslib-init-trn-doc :
      619     define input parameter p-obj-type      as character no-undo .
      620     define input parameter p-obj-code      as integer   no-undo .
      621     define input parameter p-cut-date      as date      no-undo .
      622     define buffer buf_trn-doc for ub.trn-doc .
      623     define buffer buf_doc-list for doc-list .
      624     do
      625     on error undo, return error
      626     :
      627       if p-cut-date = ?
      628       then do:
      629         for each buf_trn-doc no-lock
      630           where buf_trn-doc.obj-type = p-obj-type
      631             and buf_trn-doc.obj-code = p-obj-code
      632             and buf_trn-doc.status_  = 'факт':U
      633         on error undo, return error
      634         :
      635           create buf_doc-list .
      636           assign
      637             buf_doc-list.doc-code   = buf_trn-doc.doc-code
      638             buf_doc-list.doc-type   = buf_trn-doc.doc-type
      639             buf_doc-list.fact-date  = buf_trn-doc.fact-date
      640             buf_doc-list.shift-date = buf_trn-doc.shift-date
      641             buf_doc-list.shift-num  = buf_trn-doc.shift-num
      642             buf_doc-list.shift-name = buf_trn-doc.shift-name
      643             buf_doc-list.fact-order = buf_trn-doc.fact-order
      644             buf_doc-list.is-trn-doc = true
      645           .
      646         end.
      647       end.
      648       else do:
      649         for each buf_trn-doc no-lock
      650           where buf_trn-doc.obj-type  = p-obj-type
      651             and buf_trn-doc.obj-code  = p-obj-code
      652             and buf_trn-doc.status_   = 'факт':U
      653             and buf_trn-doc.fact-date >= p-cut-date
      654         on error undo, return error
      655         :
      656           create buf_doc-list .
      657           assign
      658             buf_doc-list.doc-code   = buf_trn-doc.doc-code
      659             buf_doc-list.doc-type   = buf_trn-doc.doc-type
      660             buf_doc-list.fact-date  = buf_trn-doc.fact-date
      661             buf_doc-list.shift-date = buf_trn-doc.shift-date
      662             buf_doc-list.shift-num  = buf_trn-doc.shift-num
      663             buf_doc-list.shift-name = buf_trn-doc.shift-name
      664             buf_doc-list.fact-order = buf_trn-doc.fact-order
      665             buf_doc-list.is-trn-doc = true
      666           .
      667         end.
      668       end.
      669     end.
      670   end procedure.
      671   procedure doclslib-init-price-doc :
      672     define input parameter p-obj-type      as character no-undo .
      673     define input parameter p-obj-code      as integer   no-undo .
      674     define input parameter p-cut-date      as date      no-undo .
      675     define buffer buf_price-doc for ub.price-doc .
      676     define buffer buf_doc-list for doc-list .
      677     do
      678     on error undo, return error
      679     :
      680       if p-cut-date = ?
      681       then do:
      682         for each buf_price-doc no-lock
      683           where buf_price-doc.obj-type = p-obj-type
      684             and buf_price-doc.obj-code = p-obj-code
      685             and buf_price-doc.status_  = 'акт':U
      686         on error undo, return error
      687         :
      688           create buf_doc-list .
      689           assign
      690             buf_doc-list.doc-code   = buf_price-doc.doc-num
      691             buf_doc-list.doc-type   = ''
      692             buf_doc-list.fact-date  = buf_price-doc.fact-date
      693             buf_doc-list.shift-date = buf_price-doc.shift-date
      694             buf_doc-list.shift-num  = buf_price-doc.shift-num
      695             buf_doc-list.shift-name = buf_price-doc.shift-name
      696             buf_doc-list.fact-order = buf_price-doc.fact-order
      697             buf_doc-list.is-trn-doc = false
      698           .
      699         end.
      700       end.
      701       else do:
      702         for each buf_price-doc no-lock
      703           where buf_price-doc.obj-type = p-obj-type
      704             and buf_price-doc.obj-code = p-obj-code
      705             and buf_price-doc.status_  = 'акт':U
      706             and ub.buf_price-doc.fact-date >= p-cut-date
      707         on error undo, return error
      708         :
      709           create buf_doc-list .
      710           assign
      711             buf_doc-list.doc-code   = buf_price-doc.doc-num
      712             buf_doc-list.doc-type   = ''
      713             buf_doc-list.fact-date  = buf_price-doc.fact-date
      714             buf_doc-list.shift-date = buf_price-doc.shift-date
      715             buf_doc-list.shift-num  = buf_price-doc.shift-num
      716             buf_doc-list.shift-name = buf_price-doc.shift-name
      717             buf_doc-list.fact-order = buf_price-doc.fact-order
      718             buf_doc-list.is-trn-doc = false
      719           .
      720         end.
      721       end.
      722     end.
      723   end procedure.
      724   procedure doclslib-clear-bydate-doc-list :
      725     define input parameter p-fact-date as date no-undo .
      726     define buffer buf_doc-list for doc-list .
      727     do
      728     on error undo, return error
      729     :
      730       if p-fact-date <> ?
      731       then do:
      732         for each buf_doc-list
      733           where buf_doc-list.fact-date < p-fact-date
      734         on error undo, return error
      735         :
      736           delete buf_doc-list .
      737         end.
      738       end.
      739     end.
      740   end procedure.
      741   procedure doclslib-clear-rst :
      742     define input parameter p-fact-date as date no-undo .
      743     define buffer buf_doc-list for doc-list .
      744     do
      745     on error undo, return error
      746     :
      747       if p-fact-date <> ?
      748       then do:
      749         for each buf_doc-list
      750           where buf_doc-list.fact-date >= p-fact-date
      751         on error undo, return error
      752         :
      753           delete buf_doc-list .
      754         end.
      755       end.
      756     end.
      757   end procedure.
      758   procedure doclslib-export-doc-list :
      759     define input  parameter p-obj-type      as character no-undo .
      760     define input  parameter p-obj-code      as integer no-undo .
      761     define input  parameter p-log-file-name as character no-undo .
      762     define input  parameter p-description   as character no-undo .
      763     define buffer buf_doc-list for doc-list .
      764     do
      765     on error undo, return error
      766     :
      767       output stream doclsliblog to value(p-log-file-name) .
      768       export stream doclsliblog "#############################################################" .
      769       export stream doclsliblog "Список документов" .
      770       export stream doclsliblog p-description .
      771       export stream doclsliblog "Объект" p-obj-type p-obj-code .
      772       export stream doclsliblog "Дата" string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
      773       for each buf_doc-list
      774       by buf_doc-list.fact-order
      775       on error undo, return error
      776       :
      777         export stream doclsliblog buf_doc-list .
      778       end.
      779       export stream doclsliblog "#############################################################" .
      780       output stream doclsliblog close .
      781     end.
      782   end procedure.
      783   procedure doclslib-clear-batch-process :
      784     define input parameter p-bp_type like ub.batchprocess.bp_type no-undo .
      785     define buffer buf_batchprocess        for ub.batchprocess .
      786     define buffer execdelete_batchprocess for ub.batchprocess .
      787     define buffer buf_doc-list            for doc-list .
      788     for each buf_doc-list
      789     on end-key undo, return error substitute( "doclslib-clear-batch-process. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      790     on error   undo, return error substitute( "doclslib-clear-batch-process. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      791     on stop    undo, return error substitute( "doclslib-clear-batch-process. STOP      &2"
      792                                    + "bp_type &3&2"
      793                                    + "Документ &4"
      794                                    , chr(10)
      795                                    , p-bp_type
      796                                    , buf_doc-list.doc-code
      797                                   )
      798     :
      799       find first buf_batchprocess exclusive-lock
      800         where buf_BatchProcess.BP_Status   = 'N':U
      801           and buf_batchprocess.bp_type     = p-bp_type
      802           and buf_batchprocess.charkey_one = buf_doc-list.doc-code
      803         no-error .
      804       if available buf_batchprocess
      805       then do:
      806         delete buf_batchprocess .
      807       end.
      808     end.
      809   end procedure.
      810   procedure doclslib-calc-arh :
      811     define input  parameter p-log-handle     as handle    no-undo .
      812     define input  parameter p-obj-type       as character no-undo .
      813     define input  parameter p-obj-code       as integer   no-undo .
      814     define input  parameter p-cut-date       as date      no-undo .
      815     define input  parameter p-update-recalc  as logical   no-undo .
      816     define variable v-prev-fact-date as date      no-undo .
      817     define buffer buf_doc-list for doc-list .
      818     define buffer stop-arh-restore-lock_btpr for ub.batchprocess .
      819     define buffer stop-arh-news-lock_btpr    for ub.batchprocess .
      820     do
      821     on stop    undo, return error substitute( "doclslib-calc-arh. stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      822     on end-key undo, return error substitute( "doclslib-calc-arh. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      823     on error   undo, return error substitute( "doclslib-calc-arh. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      824     :
      825       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
      826       run gbl/lockrngd.p
      827         (input  'grar':U
      828         ,input  'disable':U
      829         ,buffer buf_lock_gdsrenart_batchprocess
      830         ) no-error .
      831       if error-status :error
      832       then do:
      833         if error-status :get-message(1) <> ""
      834         then do:
      835           message
      836             vss-workfile vss-revision vss-description skip
      837             "Ошибка при блокировании функции переименования артикула товара" skip
      838             error-status :get-message(1) skip
      839             return-value skip
      840             view-as alert-box error .
      841         end.
      842         undo, return error return-value .
      843       end.
      844       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
      845       run gbl/lockrngd.p
      846         (input  'grgc':U
      847         ,input  'disable':U
      848         ,buffer buf_lock_gdsrengc_batchprocess
      849         ) no-error .
      850       if error-status :error
      851       then do:
      852         if error-status :get-message(1) <> ""
      853         then do:
      854           message
      855             vss-workfile vss-revision vss-description skip
      856             "Ошибка при блокировании функции переименования кода товара" skip
      857             error-status :get-message(1) skip
      858             return-value skip
      859             view-as alert-box error .
      860         end.
      861         undo, return error return-value .
      862       end.
      863       for each buf_doc-list
      864       by buf_doc-list.fact-order
      865       on stop    undo, return error substitute( "f e . stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      866       on end-key undo, return error substitute( "f e . end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      867       on error   undo, return error substitute( "f e . error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      868       :
      869         find first stop-arh-restore-lock_btpr no-lock
      870           where stop-arh-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
      871             and stop-arh-restore-lock_btpr.bp_status     = 'N':U
      872             and stop-arh-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
      873             and stop-arh-restore-lock_btpr.Key#_Two      = 0
      874             and stop-arh-restore-lock_btpr.Key#_Three    = 0
      875             and stop-arh-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
      876             and stop-arh-restore-lock_btpr.CharKey_Two   = ""
      877             and stop-arh-restore-lock_btpr.CharKey_Three = ""
      878           no-error .
      879         if available stop-arh-restore-lock_btpr
      880         then do:
      881           run doclslib-log-information in this-procedure
      882             (input p-log-handle
      883             ,input "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива"
      884             ) .
      885           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
      886         end.
      887         find first stop-arh-news-lock_btpr no-lock
      888           where stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
      889             and stop-arh-news-lock_btpr.bp_status     = 'N':U
      890             and stop-arh-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
      891             and stop-arh-news-lock_btpr.Key#_Two      = 0
      892             and stop-arh-news-lock_btpr.Key#_Three    = 0
      893             and stop-arh-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
      894             and stop-arh-news-lock_btpr.CharKey_Three = ""
      895           no-error .
      896         if available stop-arh-news-lock_btpr
      897         then do:
      898           run doclslib-log-information in this-procedure
      899             (input p-log-handle
      900             ,input "Система новостей запросила остановку процедуры расчета складского архива"
      901             ) .
      902           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
      903         end.
      904         if buf_doc-list.is-trn-doc
      905         then do:
      906           run doclslib-log-information in this-procedure
      907             (input p-log-handle
      908             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
      909                              ,buf_doc-list.doc-code
      910                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
      911                              ,buf_doc-list.fact-order
      912                              )
      913             ) .
      914           run trg/calc-arh.p
      915             (input buf_doc-list.doc-code
      916             ,input p-cut-date
      917             ).
      918           run doclslib-log-information in this-procedure
      919             (input p-log-handle
      920             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
      921                              ,buf_doc-list.doc-code
      922                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
      923                              ,buf_doc-list.fact-order
      924                              )
      925             ) .
      926         end.
      927         else do:
      928           run doclslib-log-information in this-procedure
      929             (input p-log-handle
      930             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
      931                              ,buf_doc-list.doc-code
      932                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
      933                              ,buf_doc-list.fact-order
      934                              )
      935             ) .
      936           run trg/calc-apc.p
      937             (input buf_doc-list.doc-code
      938             ,input p-cut-date
      939             ).
      940           run doclslib-log-information in this-procedure
      941             (input p-log-handle
      942             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
      943                              ,buf_doc-list.doc-code
      944                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
      945                              ,buf_doc-list.fact-order
      946                              )
      947             ) .
      948         end.
      949         if  p-update-recalc  = true
      950         and v-prev-fact-date <> ?
      951         and buf_doc-list.fact-date > v-prev-fact-date
      952         then do:
      953           run gbl/clntat-w.p
      954             (input p-obj-type
      955             ,input p-obj-code
      956             ,input 'arh-recalc':U
      957             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
      958             ) .
      959           run doclslib-log-information in this-procedure
      960             (input p-log-handle
      961             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
      962                              ,string(v-prev-fact-date, '99/99/9999':u)
      963                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
      964                              )
      965             ) .
      966         end.
      967         assign
      968           v-prev-fact-date = buf_doc-list.fact-date
      969         .
      970       end.
      971     end.
      972   end procedure.
      973   procedure doclslib-calc-aht :
      974     define input  parameter p-log-handle    as handle    no-undo .
      975     define input  parameter p-obj-type      as character no-undo .
      976     define input  parameter p-obj-code      as integer   no-undo .
      977     define input  parameter p-cut-date      as date      no-undo .
      978     define input  parameter p-update-recalc as logical   no-undo .
      979     define variable v-prev-fact-date as date      no-undo .
      980     define buffer buf_doc-list for doc-list .
      981     define buffer stop-aht-restore-lock_btpr for ub.batchprocess .
      982     define buffer stop-aht-news-lock_btpr    for ub.batchprocess .
      983     do
      984     on error undo, return error return-value
      985     :
      986       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
      987       run gbl/lockrngd.p
      988         (input  'grar':U
      989         ,input  'disable':U
      990         ,buffer buf_lock_gdsrenart_batchprocess
      991         ) no-error .
      992       if error-status :error
      993       then do:
      994         if error-status :get-message(1) <> ""
      995         then do:
      996           message
      997             vss-workfile vss-revision vss-description skip
      998             "Ошибка при блокировании функции переименования артикула товара" skip
      999             error-status :get-message(1) skip
     1000             return-value skip
     1001             view-as alert-box error .
     1002         end.
     1003         undo, return error return-value .
     1004       end.
     1005       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1006       run gbl/lockrngd.p
     1007         (input  'grgc':U
     1008         ,input  'disable':U
     1009         ,buffer buf_lock_gdsrengc_batchprocess
     1010         ) no-error .
     1011       if error-status :error
     1012       then do:
     1013         if error-status :get-message(1) <> ""
     1014         then do:
     1015           message
     1016             vss-workfile vss-revision vss-description skip
     1017             "Ошибка при блокировании функции переименования кода товара" skip
     1018             error-status :get-message(1) skip
     1019             return-value skip
     1020             view-as alert-box error .
     1021         end.
     1022         undo, return error return-value .
     1023       end.
     1024       for each buf_doc-list
     1025       by buf_doc-list.fact-order
     1026       on error undo, return error
     1027       :
     1028         find first stop-aht-restore-lock_btpr no-lock
     1029           where stop-aht-restore-lock_btpr.bp_type       = 'lock':U + 'rsts':U
     1030             and stop-aht-restore-lock_btpr.bp_status     = 'N':U
     1031             and stop-aht-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1032             and stop-aht-restore-lock_btpr.Key#_Two      = 0
     1033             and stop-aht-restore-lock_btpr.Key#_Three    = 0
     1034             and stop-aht-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1035             and stop-aht-restore-lock_btpr.CharKey_Two   = ""
     1036             and stop-aht-restore-lock_btpr.CharKey_Three = ""
     1037           no-error .
     1038         if available stop-aht-restore-lock_btpr
     1039         then do:
     1040           undo, return error "Процедура восстановления складского архива запросила остановку процедуры автоматического расчета складского архива" .
     1041         end.
     1042         find first stop-aht-news-lock_btpr no-lock
     1043           where stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
     1044             and stop-aht-news-lock_btpr.bp_status     = 'N':U
     1045             and stop-aht-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1046             and stop-aht-news-lock_btpr.Key#_Two      = 0
     1047             and stop-aht-news-lock_btpr.Key#_Three    = 0
     1048             and stop-aht-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1049             and stop-aht-news-lock_btpr.CharKey_Three = ""
     1050           no-error .
     1051         if available stop-aht-news-lock_btpr
     1052         then do:
     1053           undo, return error "Система новостей запросила остановку процедуры автоматического расчета складского архива" .
     1054         end.
     1055         if buf_doc-list.is-trn-doc
     1056         then do:
     1057           run doclslib-log-information in this-procedure
     1058             (input p-log-handle
     1059             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1060                              ,buf_doc-list.doc-code
     1061                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1062                              ,buf_doc-list.fact-order
     1063                              )
     1064             ) .
     1065           run trg/aht-doc.p
     1066             (input buf_doc-list.doc-code
     1067             ,input p-cut-date
     1068             ).
     1069           run doclslib-log-information in this-procedure
     1070             (input p-log-handle
     1071             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1072                              ,buf_doc-list.doc-code
     1073                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1074                              ,buf_doc-list.fact-order
     1075                              )
     1076             ) .
     1077         end.
     1078         else do:
     1079           run doclslib-log-information in this-procedure
     1080             (input p-log-handle
     1081             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1082                              ,buf_doc-list.doc-code
     1083                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1084                              ,buf_doc-list.fact-order
     1085                              )
     1086             ) .
     1087           run trg/aht-prc.p
     1088             (input buf_doc-list.doc-code
     1089             ,input p-cut-date
     1090             ).
     1091           run doclslib-log-information in this-procedure
     1092             (input p-log-handle
     1093             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1094                              ,buf_doc-list.doc-code
     1095                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1096                              ,buf_doc-list.fact-order
     1097                              )
     1098             ) .
     1099         end.
     1100         if  p-update-recalc  = true
     1101         and v-prev-fact-date <> ?
     1102         and buf_doc-list.fact-date > v-prev-fact-date
     1103         then do:
     1104           run gbl/clntat-w.p
     1105             (input p-obj-type
     1106             ,input p-obj-code
     1107             ,input 'aht-recalc':U
     1108             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1109             ) .
     1110           run doclslib-log-information in this-procedure
     1111             (input p-log-handle
     1112             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1113                              ,string(v-prev-fact-date, '99/99/9999':u)
     1114                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1115                              )
     1116             ) .
     1117         end.
     1118         assign
     1119           v-prev-fact-date = buf_doc-list.fact-date
     1120         .
     1121       end.
     1122     end.
     1123   end procedure.
     1124   procedure doclslib-calc-ahsp :
     1125     define input  parameter p-log-handle    as handle    no-undo .
     1126     define input  parameter p-obj-type      as character no-undo .
     1127     define input  parameter p-obj-code      as integer   no-undo .
     1128     define input  parameter p-cut-date      as date      no-undo .
     1129     define input  parameter p-update-recalc as logical   no-undo .
     1130     define variable v-prev-fact-date as date      no-undo .
     1131     define buffer buf_doc-list for doc-list .
     1132     define buffer stop-ahsp-restore-lock_btpr for ub.batchprocess .
     1133     define buffer stop-ahsp-news-lock_btpr    for ub.batchprocess .
     1134     do
     1135     on error undo, return error return-value
     1136     :
     1137       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1138       run gbl/lockrngd.p
     1139         (input  'grar':U
     1140         ,input  'disable':U
     1141         ,buffer buf_lock_gdsrenart_batchprocess
     1142         ) no-error .
     1143       if error-status :error
     1144       then do:
     1145         if error-status :get-message(1) <> ""
     1146         then do:
     1147           message
     1148             vss-workfile vss-revision vss-description skip
     1149             "Ошибка при блокировании функции переименования артикула товара" skip
     1150             error-status :get-message(1) skip
     1151             return-value skip
     1152             view-as alert-box error .
     1153         end.
     1154         undo, return error return-value .
     1155       end.
     1156       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1157       run gbl/lockrngd.p
     1158         (input  'grgc':U
     1159         ,input  'disable':U
     1160         ,buffer buf_lock_gdsrengc_batchprocess
     1161         ) no-error .
     1162       if error-status :error
     1163       then do:
     1164         if error-status :get-message(1) <> ""
     1165         then do:
     1166           message
     1167             vss-workfile vss-revision vss-description skip
     1168             "Ошибка при блокировании функции переименования кода товара" skip
     1169             error-status :get-message(1) skip
     1170             return-value skip
     1171             view-as alert-box error .
     1172         end.
     1173         undo, return error return-value .
     1174       end.
     1175       for each buf_doc-list
     1176         where buf_doc-list.is-trn-doc = true
     1177       by buf_doc-list.fact-order
     1178       on error undo, return error
     1179       :
     1180         find first stop-ahsp-restore-lock_btpr no-lock
     1181           where stop-ahsp-restore-lock_btpr.bp_type       = 'lock':U + 'rsss':U
     1182             and stop-ahsp-restore-lock_btpr.bp_status     = 'N':U
     1183             and stop-ahsp-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1184             and stop-ahsp-restore-lock_btpr.Key#_Two      = 0
     1185             and stop-ahsp-restore-lock_btpr.Key#_Three    = 0
     1186             and stop-ahsp-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1187             and stop-ahsp-restore-lock_btpr.CharKey_Two   = ""
     1188             and stop-ahsp-restore-lock_btpr.CharKey_Three = ""
     1189           no-error .
     1190         if available stop-ahsp-restore-lock_btpr
     1191         then do:
     1192           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1193         end.
     1194         find first stop-ahsp-news-lock_btpr no-lock
     1195           where stop-ahsp-news-lock_btpr.bp_type       = 'lock':U + 'rssn':U
     1196             and stop-ahsp-news-lock_btpr.bp_status     = 'N':U
     1197             and stop-ahsp-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1198             and stop-ahsp-news-lock_btpr.Key#_Two      = 0
     1199             and stop-ahsp-news-lock_btpr.Key#_Three    = 0
     1200             and stop-ahsp-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1201             and stop-ahsp-news-lock_btpr.CharKey_Three = ""
     1202           no-error .
     1203         if available stop-ahsp-news-lock_btpr
     1204         then do:
     1205           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1206         end.
     1207         run doclslib-log-information in this-procedure
     1208           (input p-log-handle
     1209           ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1210                             ,buf_doc-list.doc-code
     1211                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1212                             ,buf_doc-list.fact-order
     1213                             )
     1214           ) .
     1215         define variable v-need-process as logical   no-undo .
     1216         run trg/ah-csptr.p
     1217           (input  buf_doc-list.doc-code
     1218           ,input  p-cut-date
     1219           ,input  false
     1220           ,output v-need-process
     1221           ).
     1222         run doclslib-log-information in this-procedure
     1223           (input p-log-handle
     1224           ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1225                             ,buf_doc-list.doc-code
     1226                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1227                             ,buf_doc-list.fact-order
     1228                             )
     1229           ) .
     1230         if  p-update-recalc  = true
     1231         and v-prev-fact-date <> ?
     1232         and buf_doc-list.fact-date > v-prev-fact-date
     1233         then do:
     1234           run gbl/clntat-w.p
     1235             (input p-obj-type
     1236             ,input p-obj-code
     1237             ,input 'ahsp-recalc':U
     1238             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1239             ) .
     1240           run doclslib-log-information in this-procedure
     1241             (input p-log-handle
     1242             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1243                              ,string(v-prev-fact-date, '99/99/9999':u)
     1244                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1245                              )
     1246             ) .
     1247         end.
     1248         assign
     1249           v-prev-fact-date = buf_doc-list.fact-date
     1250         .
     1251       end.
     1252     end.
     1253   end procedure.
     1254   procedure doclslib-log-information :
     1255     define input  parameter p-log-handle as handle    no-undo .
     1256     define input  parameter p-message    as character no-undo .
     1257     do
     1258     on error undo, return error return-value
     1259     :
     1260       define variable v-log-procedure-name as character no-undo .
     1261       assign
     1262         v-log-procedure-name = "cb-doclslib-log"
     1263       .
     1264       if valid-handle(p-log-handle)
     1265       and p-log-handle :get-signature(v-log-procedure-name) <> ""
     1266       then do:
     1267         run value(v-log-procedure-name) in p-log-handle
     1268           (input p-message
     1269           ) no-error .
     1270       end.
     1271     end.
     1272   end procedure.
     1273   procedure doclslib-find-last-fact-date :
     1274     define output parameter p-last-fact-date  as date      no-undo .
     1275     define output parameter p-reason          as character no-undo .
     1276     do
     1277     on error undo, return error
     1278     :
     1279       define variable v-last-fact-date    as date      no-undo .
     1280       define buffer buf_doc-list for doc-list .
     1281       assign
     1282         v-last-fact-date    = ?
     1283       .
     1284       for each buf_doc-list
     1285       by buf_doc-list.fact-order
     1286       on error undo, return error
     1287       :
     1288         if buf_doc-list.is-archive-exist = false
     1289         or buf_doc-list.fact-date = ?
     1290         then do:
     1291           assign
     1292             p-reason = p-reason + substitute("По документу &1 отсутствует рассчитанный складской архив"
     1293                                             ,buf_doc-list.doc-code
     1294                                             )
     1295           .
     1296           leave .
     1297         end.
     1298         if buf_doc-list.fact-date = ?
     1299         then do:
     1300           assign
     1301             p-reason = p-reason + substitute("Документ &1 имеет не заданную фактическую дату "
     1302                                             ,buf_doc-list.doc-code
     1303                                             )
     1304           .
     1305           leave .
     1306         end.
     1307         if v-last-fact-date = ?
     1308         or (v-last-fact-date <> ?
     1309             and v-last-fact-date < buf_doc-list.fact-date
     1310            )
     1311         then do:
     1312           assign
     1313             v-last-fact-date = buf_doc-list.fact-date
     1314             p-reason         = substitute("Последний рассчитанный документ &1" + chr(10)
     1315                                          ,buf_doc-list.doc-code
     1316                                          )
     1317           .
     1318         end.
     1319       end.
     1320       assign
     1321         p-last-fact-date = v-last-fact-date
     1322       .
     1323     end.
     1324   end procedure.
     1325   procedure doclslib-check-arh-exist :
     1326     define input parameter  p-obj-type       as character no-undo .
     1327     define input parameter  p-obj-code       as integer   no-undo .
     1328     define input parameter  p-cut-fact-order as decimal   no-undo .
     1329     define output parameter p-archive-exist  as logical   no-undo .
     1330     define buffer buf_stk-tot for ub.stk-tot .
     1331     do
     1332     on error undo, return error
     1333     :
     1334       find first buf_stk-tot no-lock
     1335         where buf_stk-tot.obj-type   = p-obj-type
     1336           and buf_stk-tot.obj-code   = p-obj-code
     1337           and buf_stk-tot.fact-order > p-cut-fact-order
     1338         no-error .
     1339       assign
     1340         p-archive-exist = (available buf_stk-tot)
     1341       .
     1342     end.
     1343   end procedure.
     1344   procedure doclslib-check-aht-exist :
     1345     define input parameter  p-obj-type       as character no-undo .
     1346     define input parameter  p-obj-code       as integer   no-undo .
     1347     define input parameter  p-cut-fact-order as decimal   no-undo .
     1348     define output parameter p-archive-exist  as logical   no-undo .
     1349     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     1350     do
     1351     on error undo, return error
     1352     :
     1353       find first buf_aht-stk-tot no-lock
     1354         where buf_aht-stk-tot.obj-type   = p-obj-type
     1355           and buf_aht-stk-tot.obj-code   = p-obj-code
     1356           and buf_aht-stk-tot.fact-order > p-cut-fact-order
     1357         no-error .
     1358       assign
     1359         p-archive-exist = (available buf_aht-stk-tot)
     1360       .
     1361     end.
     1362   end procedure.
     1363   procedure doclslib-check-ahsp-exist :
     1364     define input parameter  p-obj-type       as character no-undo .
     1365     define input parameter  p-obj-code       as integer   no-undo .
     1366     define input parameter  p-cut-fact-order as decimal   no-undo .
     1367     define output parameter p-archive-exist  as logical   no-undo .
     1368     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     1369     do
     1370     on error undo, return error
     1371     :
     1372       find first buf_stk-supp-tot no-lock
     1373         where buf_stk-supp-tot.obj-type   = p-obj-type
     1374           and buf_stk-supp-tot.obj-code   = p-obj-code
     1375           and buf_stk-supp-tot.fact-order > p-cut-fact-order
     1376         no-error .
     1377       assign
     1378         p-archive-exist = (available buf_stk-supp-tot)
     1379       .
     1380     end.
     1381   end procedure.
     1382   procedure doclslib-check-doc-arh-exist :
     1383     define buffer buf_doc-list for doc-list .
     1384     define buffer buf_ot-tot for ub.ot-tot .
     1385     do
     1386     on error undo, return error return-value
     1387     :
     1388       for each buf_doc-list
     1389       on error undo, return error
     1390       :
     1391         find first buf_ot-tot no-lock
     1392           where buf_ot-tot.doc-code = buf_doc-list.doc-code
     1393           no-error .
     1394         if available buf_ot-tot
     1395         then do:
     1396           assign
     1397             buf_doc-list.is-archive-exist = true
     1398           .
     1399         end.
     1400         else do:
     1401           assign
     1402             buf_doc-list.is-archive-exist = false
     1403           .
     1404         end.
     1405       end.
     1406     end.
     1407   end procedure.
     1408   procedure doclslib-check-doc-aht-exist :
     1409     define buffer buf_doc-list for doc-list .
     1410     define buffer buf_aht-doc for ub.aht-doc .
     1411     do
     1412     on error undo, return error return-value
     1413     :
     1414       for each buf_doc-list
     1415       on error undo, return error
     1416       :
     1417         find first buf_aht-doc no-lock
     1418           where buf_aht-doc.doc-code = buf_doc-list.doc-code
     1419           no-error .
     1420         if available buf_aht-doc
     1421         then do:
     1422           assign
     1423             buf_doc-list.is-archive-exist = true
     1424           .
     1425         end.
     1426         else do:
     1427           assign
     1428             buf_doc-list.is-archive-exist = false
     1429           .
     1430         end.
     1431       end.
     1432     end.
     1433   end procedure.
     1434   procedure doclslib-check-doc-ahsp-exist :
     1435     define buffer buf_doc-list for doc-list .
     1436     define buffer buf_ot-supp-line for ub.ot-supp-tot .
     1437     do
     1438     on error undo, return error return-value
     1439     :
     1440       for each buf_doc-list
     1441       on error undo, return error
     1442       :
     1443         find first buf_ot-supp-line no-lock
     1444           where buf_ot-supp-line.doc-code = buf_doc-list.doc-code
     1445           no-error .
     1446         if available buf_ot-supp-line
     1447         then do:
     1448           assign
     1449             buf_doc-list.is-archive-exist = true
     1450           .
     1451         end.
     1452         else do:
     1453           if buf_doc-list.doc-type = 'инв':U
     1454           then do:
     1455             define variable v-need-process as logical   no-undo .
     1456             run trg/ah-csptr.p
     1457               (input  buf_doc-list.doc-code
     1458               ,input  0
     1459               ,input  true
     1460               ,output v-need-process
     1461               ).
     1462             if v-need-process = true
     1463             then do:
     1464               assign
     1465                 buf_doc-list.is-archive-exist = false
     1466               .
     1467             end.
     1468             else do:
     1469               assign
     1470                 buf_doc-list.is-archive-exist = true
     1471               .
     1472             end.
     1473           end.
     1474           else do:
     1475             assign
     1476               buf_doc-list.is-archive-exist = false
     1477             .
     1478           end.
     1479         end.
     1480       end.
     1481     end.
     1482   end procedure.
     1483   procedure doclslib-clear-ahsp-doc-list :
     1484     define buffer buf_doc-list for doc-list .
     1485     define buffer buf_trn-doc  for ub.trn-doc .
     1486     define buffer buf_doc-line for ub.doc-line .
     1487     define buffer buf_parts    for ub.parts .
     1488     do
     1489     on error undo, return error return-value
     1490     :
     1491       check-doc-list :
     1492       for each buf_doc-list
     1493       on error undo, return error return-value
     1494       :
     1495         find first buf_trn-doc no-lock
     1496           where buf_trn-doc.doc-code = buf_doc-list.doc-code
     1497           .
     1498         if buf_trn-doc.office = true
     1499         then do:
     1500           delete buf_doc-list .
     1501           next check-doc-list .
     1502         end.
     1503         find first buf_doc-line no-lock
     1504           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1505           no-error .
     1506         if not available buf_doc-line
     1507         then do:
     1508           delete buf_doc-list .
     1509           next check-doc-list .
     1510         end.
     1511         find first buf_parts no-lock
     1512           where buf_parts.out-code = buf_trn-doc.doc-code
     1513             and buf_parts.fact-qnty <> 0
     1514           no-error .
     1515         if not available buf_parts
     1516         then do:
     1517           delete buf_doc-list .
     1518           next check-doc-list .
     1519         end.
     1520       end.
     1521     end.
     1522   end procedure.
     1523   procedure doclslib-init-goods :
     1524     define buffer buf_doclslib-goods for doclslib-goods .
     1525     define buffer buf_doc-list       for doc-list .
     1526     define buffer buf_trn-doc        for ub.trn-doc .
     1527     define buffer buf_price-doc      for ub.price-doc .
     1528     define buffer buf_doc-line       for ub.doc-line .
     1529     define buffer buf_price-list     for ub.price-list .
     1530     define variable v-gds-code as integer   no-undo .
     1531     do
     1532     on error undo, return error return-value
     1533     :
     1534       for each buf_doclslib-goods
     1535       on error undo, return error return-value
     1536       :
     1537         delete buf_doclslib-goods .
     1538       end.
     1539       for each buf_doc-list
     1540       on error undo, return error return-value
     1541       :
     1542         if buf_doc-list.is-trn-doc
     1543         then do:
     1544           find first buf_trn-doc no-lock
     1545             where buf_trn-doc.doc-code = buf_doc-list.doc-code
     1546             .
     1547           for each buf_doc-line no-lock
     1548             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1549           on error undo, return error return-value
     1550           :
     1551   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1553     (input  buf_doc-line.artic
     1554     ,input  buf_doc-line.prod-type
     1555     ,input  buf_doc-line.prod-code
     1556     ,output v-gds-code
     1557     )  .
     1558             find first buf_doclslib-goods
     1559               where buf_doclslib-goods.gds-code = v-gds-code
     1560               no-error .
     1561             if not available buf_doclslib-goods
     1562             then do:
     1563               create buf_doclslib-goods .
     1564               assign
     1565                 buf_doclslib-goods.gds-code  = v-gds-code
     1566                 buf_doclslib-goods.artic     = buf_doc-line.artic
     1567                 buf_doclslib-goods.prod-type = buf_doc-line.prod-type
     1568                 buf_doclslib-goods.prod-code = buf_doc-line.prod-code
     1569               .
     1570             end.
     1571           end.
     1572         end.
     1573         else do:
     1574           find first buf_price-doc no-lock
     1575             where buf_price-doc.doc-num = buf_doc-list.doc-code
     1576             .
     1577           for each buf_price-list no-lock
     1578             where buf_price-list.doc-num = buf_price-doc.doc-num
     1579           on error undo, return error return-value
     1580           :
     1581   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1582   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1583     (input  buf_price-list.artic
     1584     ,input  buf_price-list.prod-type
     1585     ,input  buf_price-list.prod-code
     1586     ,output v-gds-code
     1587     )  .
     1588             find first buf_doclslib-goods
     1589               where buf_doclslib-goods.gds-code = v-gds-code
     1590               no-error .
     1591             if not available buf_doclslib-goods
     1592             then do:
     1593               create buf_doclslib-goods .
     1594               assign
     1595                 buf_doclslib-goods.gds-code  = v-gds-code
     1596                 buf_doclslib-goods.artic     = buf_price-list.artic
     1597                 buf_doclslib-goods.prod-type = buf_price-list.prod-type
     1598                 buf_doclslib-goods.prod-code = buf_price-list.prod-code
     1599               .
     1600             end.
     1601           end.
     1602         end.
     1603       end.
     1604     end.
     1605   end procedure.
     1606   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1607   procedure gen-key-rec :
     1608     define input  parameter p-tbl-name    as character no-undo.
     1609     define input  parameter p-bh_tbl-name as handle    no-undo.
     1610     define output parameter p-key-rec     as character no-undo.
     1611     do
     1612     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1613     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1614     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1615     :
     1616       define variable fh               as handle    no-undo .
     1617       define variable v-ok             as logical   no-undo .
     1618       define variable v-inform         as character no-undo .
     1619       define variable v-ind            as integer   no-undo .
     1620       define variable v-idx-field-qnty as integer   no-undo .
     1621       if p-tbl-name = ?
     1622         or p-tbl-name = "":U
     1623       then do:
     1624         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
     1625       end.
     1626       if not p-bh_tbl-name:available then do:
     1627         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
     1628       end.
     1629       assign
     1630         p-key-rec = p-tbl-name
     1631         v-inform  = p-bh_tbl-name:index-information(1)
     1632         v-ind     = 2
     1633       .
     1634       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1635       on error undo, return error
     1636       :
     1637         assign
     1638           v-inform = p-bh_tbl-name:index-information( v-ind )
     1639           v-ind    = v-ind + 1
     1640         .
     1641       end.
     1642       if v-inform = ?
     1643         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1644         or entry( 3, v-inform, ",":U ) <> "1":U
     1645       then do:
     1646         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
     1647       end.
     1648       else do:
     1649         assign
     1650           v-idx-field-qnty = num-entries( v-inform ) - 4
     1651         .
     1652         if v-idx-field-qnty < 2 then do:
     1653           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
     1654         end.
     1655         do v-ind = 1 to v-idx-field-qnty by 2
     1656         on error undo, return error
     1657         :
     1658           assign
     1659             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1660             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1661           .
     1662         end.
     1663       end.
     1664       if p-key-rec = ? then do:
     1665         assign
     1666           p-key-rec = "":U
     1667         .
     1668         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
     1669       end.
     1670     end.
     1671     return.
     1672   end procedure.
     1673   procedure gen-where-keyr-tab :
     1674     define input  parameter i-tableSerach as character no-undo.
     1675     define input  parameter i-tablekey   as character  no-undo.
     1676     define input  parameter p-key-rec    as character  no-undo.
     1677     define input  parameter p-key-handle as handle     no-undo .
     1678     define input  parameter p-db-name    as character  no-undo .
     1679     define input  parameter p-tt-handle  as handle     no-undo .
     1680     define output parameter o-Where      as character  no-undo.
     1681     do
     1682     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1683     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1684     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1685     :
     1686       define variable v-full-tbl-name  as character no-undo .
     1687       define variable bh_tbl-name      as handle    no-undo .
     1688       define variable fh_key           as handle    no-undo .
     1689       define variable fh_search        as handle    no-undo .
     1690       define variable v-field-num      as integer   no-undo .
     1691       define variable v-count-fld      as integer   no-undo .
     1692       define variable v-inform         as character no-undo .
     1693       define variable v-ind            as integer   no-undo .
     1694       define variable v-idx-field-qnty as integer   no-undo .
     1695       define variable v-field-name     as character no-undo .
     1696       define variable v-field-val      as character no-undo .
     1697       define variable v-word-link      as character no-undo .
     1698       define variable vTable           as character no-undo.
     1699       define variable bh_tbl-key       as handle    no-undo .
     1700       assign
     1701         p-key-rec = trim( p-key-rec )
     1702       .
     1703       if p-key-handle <> ? then do:
     1704         if not valid-handle(p-key-handle)
     1705            or p-key-handle:type <> "buffer"
     1706         then do:
     1707           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
     1708         end.
     1709         if num-entries( p-key-rec, chr(3) ) > 1
     1710           or p-key-rec = ?
     1711           or p-key-rec = "":U
     1712         then do:
     1713           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
     1714         end.
     1715       end.
     1716       else do:
     1717         if p-key-rec = ?
     1718           or p-key-rec = "":U
     1719         then do:
     1720           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1721         end.
     1722       end.
     1723       assign
     1724         vTable = entry( 1 , p-key-rec, chr(3) )
     1725       .
     1726       if p-tt-handle <> ?
     1727         and ( not valid-handle(p-tt-handle)
     1728               or p-tt-handle:type <> "buffer"
     1729             )
     1730       then do:
     1731         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
     1732       end.
     1733       if p-tt-handle = ? then do:
     1734         assign
     1735           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1736         .
     1737         create buffer bh_tbl-name for table v-full-tbl-name .
     1738       end.
     1739       else do:
     1740         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1741       end.
     1742       assign
     1743         v-inform = bh_tbl-name:index-information(1)
     1744         v-ind    = 2
     1745       .
     1746       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1747       on error undo, return error
     1748       :
     1749         assign
     1750           v-inform = bh_tbl-name:index-information( v-ind )
     1751           v-ind    = v-ind + 1
     1752         .
     1753       end.
     1754       if v-inform = ?
     1755         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1756         or entry( 3, v-inform, ",":U ) <> "1":U
     1757       then do:
     1758         delete object bh_tbl-name no-error.
     1759         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
     1760       end.
     1761       assign
     1762         v-idx-field-qnty = num-entries( v-inform ) - 4
     1763       .
     1764       if v-idx-field-qnty < 2 then do:
     1765         delete object bh_tbl-name no-error.
     1766         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
     1767       end.
     1768       assign
     1769         o-where     = "where":U
     1770         v-word-link = "":U
     1771         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1772         v-count-fld = 0
     1773       .
     1774       if i-tablekey ne "" and i-tablekey ne ?
     1775       then do:
     1776         assign
     1777           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1778         .
     1779         create buffer bh_tbl-key for table v-full-tbl-name .
     1780       end.
     1781       if i-tableSerach ne "" and i-tableSerach ne ?
     1782       then do:
     1783         delete object bh_tbl-name no-error.
     1784         assign
     1785           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1786         .
     1787         create buffer bh_tbl-name for table v-full-tbl-name .
     1788       end.
     1789       block_where:
     1790       do v-ind = 1 to v-idx-field-qnty by 2
     1791       on error undo, return error
     1792       :
     1793         assign
     1794           v-count-fld = v-count-fld + 1
     1795         .
     1796         if p-key-handle = ?
     1797           and v-count-fld > v-field-num
     1798         then do:
     1799           leave block_where.
     1800         end.
     1801         define variable VfieldKeyTable as handle no-undo.
     1802         assign
     1803           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1804           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1805         .
     1806         if     bh_tbl-key ne ?
     1807         then do:
     1808            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1809            if VfieldKeyTable eq ?
     1810            then next block_where.
     1811         end.
     1812         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1813         then
     1814            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1815         else
     1816            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1817         if p-key-handle = ? then do:
     1818           assign
     1819             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1820           .
     1821         end.
     1822         else do:
     1823           assign
     1824             fh_key = p-key-handle:buffer-field( v-field-name )
     1825           .
     1826           if fh_key = ?
     1827             or not valid-handle( fh_key )
     1828           then do:
     1829             delete object bh_tbl-name.
     1830             if     bh_tbl-key ne ?
     1831             then
     1832                delete object bh_tbl-key.
     1833             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1834           end.
     1835           assign
     1836             v-field-val = fh_key:buffer-value
     1837           .
     1838         end.
     1839         if fh_search:data-type ="character":U then do:
     1840           assign
     1841             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1842             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1843             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1844             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1845             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1846             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1847             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1848             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1849             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1850             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1851             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1852             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1853             v-field-val = substitute( '"&1"', v-field-val )
     1854           .
     1855         end.
     1856         assign
     1857           o-where = substitute( "&1 &2", o-where, v-field-val )
     1858         .
     1859         if v-word-link = "":U then do:
     1860           assign
     1861             v-word-link = "and":U
     1862           .
     1863         end.
     1864       end.
     1865       delete object bh_tbl-name.
     1866       if     bh_tbl-key ne ?
     1867       then
     1868          delete object bh_tbl-key.
     1869       if p-key-handle = ?
     1870         and v-count-fld <> v-field-num
     1871       then do:
     1872         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1873       end.
     1874     end.
     1875   end procedure.
     1876   procedure gen-hn-keyr-tab :
     1877     define input  parameter i-tableSerach as character no-undo.
     1878     define input  parameter i-tablekey   as character no-undo.
     1879     define input  parameter p-key-rec    as character no-undo.
     1880     define input  parameter p-key-handle as handle    no-undo .
     1881     define input  parameter p-db-name    as character no-undo .
     1882     define input  parameter p-tt-handle  as handle    no-undo .
     1883     define input  parameter p-stts-lock  as integer   no-undo .
     1884     define output parameter o-hn         as handle    no-undo.
     1885     define variable v-full-tbl-name as character no-undo.
     1886     define variable v-where         as character no-undo.
     1887     define variable bh_tbl-name     as handle    no-undo.
     1888     define variable vTable          as character no-undo.
     1889     do
     1890     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1891     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1892     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1893         run gen-where-keyr-tab(i-tableSerach,
     1894                                i-tablekey,
     1895                                p-key-rec,
     1896                                p-key-handle,
     1897                                p-db-name,
     1898                                p-tt-handle,
     1899                                output v-where).
     1900         if i-tableSerach ne "" and i-tableSerach ne ?
     1901         then do:
     1902            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1903            create buffer bh_tbl-name for table v-full-tbl-name .
     1904         end.
     1905         else do:
     1906            if p-tt-handle = ? then do:
     1907               assign
     1908                  vTable = entry( 1 , p-key-rec, chr(3) )
     1909               .
     1910               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1911               create buffer bh_tbl-name for table v-full-tbl-name .
     1912            end.
     1913            else do:
     1914               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1915            end.
     1916         end.
     1917         if p-tt-handle = ? then do:
     1918            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1919         end.
     1920         else do:
     1921            bh_tbl-name:find-first( v-where ) no-error .
     1922         end.
     1923         o-hn = bh_tbl-name.
     1924      end.
     1925   end procedure.
     1926   procedure gen-hn-keyr :
     1927     define input  parameter p-key-rec    as character no-undo.
     1928     define input  parameter p-key-handle as handle    no-undo .
     1929     define input  parameter p-db-name    as character no-undo .
     1930     define input  parameter p-tt-handle  as handle    no-undo .
     1931     define input  parameter p-stts-lock  as integer   no-undo .
     1932     define output parameter o-hn         as handle    no-undo.
     1933     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1934   end.
     1935   procedure gen-row-keyr :
     1936     define input  parameter p-key-rec    as character no-undo.
     1937     define input  parameter p-key-handle as handle    no-undo .
     1938     define input  parameter p-db-name    as character no-undo .
     1939     define input  parameter p-tt-handle  as handle    no-undo .
     1940     define input  parameter p-stts-lock  as integer   no-undo .
     1941     define output parameter p-tbl-row    as rowid     no-undo.
     1942     define output parameter p-tbl-name   as character no-undo.
     1943     define variable vHn as handle no-undo.
     1944       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1945       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1946       p-tbl-name =  vHn:table.
     1947       delete object vHn no-error.
     1948     if p-tbl-row = ? then do:
     1949       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1950     end.
     1951     else do:
     1952       return.
     1953     end.
     1954   end procedure.
     1955   procedure gen-key-fv :
     1956     define input  parameter p-key-rec    as character no-undo .
     1957     define output parameter p-field-list as character no-undo .
     1958     define output parameter p-value-list as character no-undo.
     1959     do
     1960     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1961     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1962     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1963     :
     1964       define variable v-full-tbl-name  as character no-undo .
     1965       define variable bh_tbl-name      as handle    no-undo .
     1966       define variable v-tbl-name       as character no-undo .
     1967       define variable v-field-num      as integer   no-undo .
     1968       define variable v-count-fld      as integer   no-undo .
     1969       define variable v-inform         as character no-undo .
     1970       define variable v-ind            as integer   no-undo .
     1971       define variable v-idx-field-qnty as integer   no-undo .
     1972       define variable v-delim-key      as character no-undo .
     1973       if p-key-rec = ?
     1974         or p-key-rec = "":U
     1975       then do:
     1976         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1977       end.
     1978       assign
     1979         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1980         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1981       .
     1982       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1983       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1984       assign
     1985         v-inform = bh_tbl-name:index-information(1)
     1986         v-ind    = 2
     1987       .
     1988       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1989       on error undo, return error
     1990       :
     1991         assign
     1992           v-inform = bh_tbl-name:index-information( v-ind )
     1993           v-ind    = v-ind + 1
     1994         .
     1995       end.
     1996       if v-inform = ?
     1997         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1998         or entry( 3, v-inform, ",":U ) <> "1":U
     1999       then do:
     2000         delete object bh_tbl-name no-error.
     2001         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     2002       end.
     2003       assign
     2004         v-idx-field-qnty = num-entries( v-inform ) - 4
     2005       .
     2006       if v-idx-field-qnty < 2 then do:
     2007         delete object bh_tbl-name no-error.
     2008         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     2009       end.
     2010       assign
     2011         p-field-list = "":U
     2012         p-value-list = "":U
     2013         v-delim-key  = "":U
     2014         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2015         v-count-fld  = 0
     2016       .
     2017       block_where:
     2018       do v-ind = 1 to v-idx-field-qnty by 2
     2019       on error undo, return error
     2020       :
     2021         assign
     2022           v-count-fld = v-count-fld + 1
     2023         .
     2024         if v-count-fld > v-field-num then do:
     2025           leave block_where.
     2026         end.
     2027         assign
     2028           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2029           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2030         .
     2031         if v-ind = 1 then do:
     2032           assign
     2033             v-delim-key = chr(3)
     2034           .
     2035         end.
     2036       end.
     2037       delete object bh_tbl-name.
     2038       if v-count-fld <> v-field-num then do:
     2039         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     2040       end.
     2041     end.
     2042   end procedure.
     2043   procedure gen-key-field :
     2044     define input  parameter p-table      as character no-undo .
     2045     define output parameter p-field-list as character no-undo .
     2046     do
     2047     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2048     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2049     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2050     :
     2051       define variable v-full-tbl-name  as character no-undo .
     2052       define variable bh_tbl-name      as handle    no-undo .
     2053       define variable v-tbl-name       as character no-undo .
     2054       define variable v-field-num      as integer   no-undo .
     2055       define variable v-count-fld      as integer   no-undo .
     2056       define variable v-inform         as character no-undo .
     2057       define variable v-ind            as integer   no-undo .
     2058       define variable v-idx-field-qnty as integer   no-undo .
     2059       define variable v-delim-key      as character no-undo .
     2060       if p-table = ?
     2061         or p-table = "":U
     2062       then do:
     2063         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     2064       end.
     2065       assign
     2066         v-tbl-name      = p-table
     2067         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2068       .
     2069       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2070       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     2071       assign
     2072         v-inform = bh_tbl-name:index-information(1)
     2073         v-ind    = 2
     2074       .
     2075       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2076       on error undo, return error
     2077       :
     2078         assign
     2079           v-inform = bh_tbl-name:index-information( v-ind )
     2080           v-ind    = v-ind + 1
     2081         .
     2082       end.
     2083       if v-inform = ?
     2084         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2085         or entry( 3, v-inform, ",":U ) <> "1":U
     2086       then do:
     2087         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     2088       end.
     2089       assign
     2090         v-idx-field-qnty = num-entries( v-inform ) - 4
     2091       .
     2092       if v-idx-field-qnty < 2 then do:
     2093         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     2094       end.
     2095       assign
     2096         p-field-list = "":U
     2097         v-delim-key  = "":U
     2098         v-count-fld  = 0
     2099       .
     2100       block_where:
     2101       do v-ind = 1 to v-idx-field-qnty by 2
     2102       on error undo, return error
     2103       :
     2104         assign
     2105           v-count-fld = v-count-fld + 1
     2106         .
     2107         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2108         if v-ind = 1 then do:
     2109           assign
     2110             v-delim-key = chr(3)
     2111           .
     2112         end.
     2113       end.
     2114       delete object bh_tbl-name.
     2115     end.
     2116   end procedure.
     2117   define   shared variable g#auto as logical no-undo.
     2118   define   shared variable g#news as logical no-undo.
     2119   define   shared variable g#oxml as logical no-undo.
     2120   define   shared variable g#esys as logical no-undo.
     2121   define   shared variable g#news-source-db as integer no-undo.
     2122   define   shared variable g#esys-source-esys as integer no-undo.
     2123   define   shared variable g#db-num as integer   no-undo .
     2124   define   shared variable g#userid as character no-undo .
     2125   define   shared variable g#passwd as character no-undo .
     2126   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2127   define temp-table temp-index_name-value no-undo
     2128   field name-key  as character
     2129   field value-key as character
     2130   index pi name-key
     2131   .
     2132   define temp-table temp-sub-index_name no-undo
     2133   field name-key  as character
     2134   field nn as integer
     2135   index pi nn
     2136   .
     2137   procedure def-hash :
     2138     do
     2139     on error undo, return error return-value
     2140     :
     2141     define input  parameter p-full-string as character no-undo .
     2142     define output parameter p-possb-keep-string as logical   no-undo .
     2143     define output parameter p-string            as character no-undo .
     2144     define output parameter p-hash-string       as character no-undo .
     2145       p-full-string = trim( p-full-string ) .
     2146       if length (p-full-string ) > 150 then do:
     2147       assign
     2148         p-possb-keep-string =  false
     2149         p-string            =  substring(p-full-string,1,150)
     2150         p-hash-string       =  encode(p-full-string)
     2151       .
     2152       end.
     2153       else do:
     2154       assign
     2155         p-possb-keep-string =  true
     2156         p-string            =  p-full-string
     2157         p-hash-string       =  encode(p-full-string)
     2158       .
     2159       end.
     2160     end.
     2161   end procedure.
     2162   procedure find-from-hash :
     2163     do
     2164     on error undo, return error return-value
     2165     :
     2166   define input  parameter  p-full-string            as character no-undo .
     2167   define input  parameter  p-table-name             as character no-undo .
     2168   define input  parameter  p-field-possb-keep-name  as character no-undo .
     2169   define input  parameter  p-field-string-name      as character no-undo .
     2170   define input  parameter  p-field-hash-string-name as character no-undo .
     2171   define input  parameter  p-sub-table-name         as character no-undo .
     2172   define output parameter  p-recid                  as recid     no-undo .
     2173   define variable v-possb-keep-string as logical   no-undo .
     2174   define variable v-string            as character no-undo .
     2175   define variable v-hash-string       as character no-undo .
     2176   define variable v-query-prepare     as character no-undo .
     2177   define variable i  as integer no-undo .
     2178   define variable qh as widget-handle no-undo .
     2179   define variable bh as widget-handle no-undo .
     2180   define variable p-rez as logical   no-undo .
     2181   run def-hash in this-procedure (input  p-full-string ,
     2182                 output v-possb-keep-string ,
     2183                 output v-string            ,
     2184                 output v-hash-string
     2185                 ).
     2186   p-recid = ? .
     2187   create buffer bh for table p-table-name.
     2188   create query qh.
     2189      v-query-prepare =
     2190       "for each " + p-table-name + " no-lock where "
     2191       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
     2192       + p-field-string-name       + " = '" + v-string            + "' and "
     2193       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
     2194       .
     2195   if v-possb-keep-string = true then do:
     2196       qh:set-buffers(bh).
     2197       qh:query-prepare(v-query-prepare).
     2198       qh:query-open.
     2199       qh:get-first.
     2200       p-recid = bh:recid.
     2201   end.
     2202   else do:
     2203   message false "анализ hash" .
     2204     qh:set-buffers(bh).
     2205     qh:query-prepare(v-query-prepare).
     2206     qh:query-open.
     2207     qh:get-first.
     2208     p-recid = bh:recid.
     2209     repeat :
     2210       qh:get-next.
     2211       if bh:available then do:
     2212          qh:get-first.
     2213          run ver-sub-table in this-procedure (
     2214              input  p-full-string ,
     2215              input  p-table-name ,
     2216              input  p-sub-table-name ,
     2217              input  bh:recid  ,
     2218              output p-rez
     2219              ).
     2220          if p-rez = true  then do:
     2221             p-recid = bh:recid .
     2222             leave.
     2223          end.
     2224          else do:
     2225            next.
     2226          end.
     2227       end.
     2228       leave.
     2229     end.
     2230   end.
     2231   delete widget bh.
     2232   delete widget qh.
     2233     end.
     2234   end procedure.
     2235   procedure ver-sub-table :
     2236     do
     2237     on error undo, return error return-value
     2238     :
     2239   define input  parameter p-full-string as character no-undo .
     2240   define input  parameter p-name-table as character no-undo .
     2241   define input  parameter p-sub-name-table as character no-undo .
     2242   define input  parameter p-recid as recid no-undo .
     2243   define output parameter p-ok as logical   no-undo .
     2244   define variable v-query-prepare     as character no-undo .
     2245   define variable i  as integer no-undo .
     2246   define variable qh as widget-handle no-undo .
     2247   define variable bh as widget-handle no-undo .
     2248   define variable p-rez as logical   no-undo .
     2249   for each temp-index_name-value : delete temp-index_name-value . end.
     2250   for each temp-sub-index_name : delete temp-sub-index_name . end.
     2251       create buffer bh for table p-name-table.
     2252       create query qh.
     2253       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
     2254       qh:set-buffers(bh).
     2255       qh:query-prepare(v-query-prepare).
     2256       qh:query-open.
     2257       qh:get-first.
     2258       p-recid = bh:recid.
     2259   define variable v-inf-ind AS CHAR NO-UNDO.
     2260   define variable v-name-pi as character no-undo .
     2261   define variable v-num-fl-inkey as integer   no-undo .
     2262   define variable v-num-fl       as integer   no-undo .
     2263   define variable j as integer   no-undo .
     2264   v-name-pi = bh:PRIMARY .
     2265   v-inf-ind = "1".
     2266   i = 0.
     2267   DO while ( v-inf-ind <> ? )
     2268       on error undo, return error:
     2269       i = i + 1 .
     2270       v-inf-ind = bh:INDEX-INFORMATION(i) .
     2271       if v-inf-ind = ? then leave.
     2272       if entry( 1 , v-inf-ind ) = v-name-pi then do:
     2273          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     2274          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     2275         if v-num-fl-inkey >= 1 then do:
     2276             do j = 5 to v-num-fl  by 2 :
     2277                 create temp-index_name-value .
     2278                 assign
     2279                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
     2280                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
     2281                 .
     2282             end.
     2283          end.
     2284       end.
     2285   END.
     2286   define variable qh-sub as widget-handle no-undo .
     2287   define variable bh-sub as widget-handle no-undo .
     2288       create buffer bh-sub for table p-sub-name-table.
     2289       create query qh-sub.
     2290   define variable k as integer   no-undo init 0 .
     2291       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
     2292       for each temp-index_name-value :
     2293           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
     2294                         " = " + temp-index_name-value.value-key + " and " .
     2295       end.
     2296       v-query-prepare = v-query-prepare + " true = true " .
     2297       qh-sub:set-buffers(bh-sub).
     2298       qh-sub:query-prepare(v-query-prepare).
     2299       qh-sub:query-open.
     2300         v-name-pi = bh-sub:PRIMARY .
     2301         v-inf-ind = "1".
     2302         i = 0.
     2303         DO while ( v-inf-ind <> ? )
     2304             on error undo, return error:
     2305             i = i + 1 .
     2306             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
     2307             if v-inf-ind = ? then leave.
     2308             if entry( 1 , v-inf-ind ) = v-name-pi then do:
     2309               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     2310               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     2311               if v-num-fl-inkey >= 1 then do:
     2312                   do j = 5 to v-num-fl  by 2 :
     2313                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
     2314                           create temp-sub-index_name .
     2315                           assign
     2316                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
     2317                             temp-sub-index_name.nn  = j
     2318                           .
     2319                       end.
     2320                   end.
     2321               end.
     2322             end.
     2323         END.
     2324         define variable v-qw as character no-undo .
     2325         v-qw = "".
     2326         qh-sub:GET-first.
     2327         DO WHILE (bh-sub:AVAILABLE):
     2328           for each temp-sub-index_name :
     2329               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
     2330           end.
     2331           v-qw = v-qw + ",".
     2332           qh-sub:GET-NEXT.
     2333         END.
     2334         p-ok = false .
     2335         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
     2336       delete widget bh-sub.
     2337       delete widget qh-sub.
     2338       delete widget bh.
     2339       delete widget qh.
     2340     end.
     2341   end procedure.
     2342   PROCEDURE update-rang-def :
     2343   define input  parameter p-recid as recid     no-undo .
     2344   define input  parameter p-list-obj as character no-undo .
     2345   define input  parameter p-a as decimal   no-undo .
     2346   define input  parameter p-b as decimal   no-undo .
     2347   define input  parameter p-c as decimal   no-undo .
     2348   define input  parameter p-d as decimal   no-undo .
     2349   define input  parameter p-e as decimal   no-undo .
     2350   define input  parameter p-f as decimal   no-undo .
     2351   define variable v-date as date no-undo .
     2352   define variable v-time as integer no-undo .
     2353   define variable v-exist as logical   no-undo .
     2354   define variable p-id as integer   no-undo .
     2355   define variable p-db as integer   no-undo .
     2356   define variable  p-possb-keep-string-obj as logical   no-undo .
     2357   define variable  p-string-obj            as character no-undo .
     2358   define variable  p-hash-string-obj       as character no-undo .
     2359   define buffer buf_rang-abc-def     for ub.rang-abc-def.
     2360   define buffer buf_rang-abc-def-obj for ub.rang-abc-def-obj.
     2361   find first buf_rang-abc-def exclusive-lock where recid(buf_rang-abc-def) = p-recid no-error .
     2362   if not available buf_rang-abc-def then do:
     2363       v-exist = false  .
     2364       assign
     2365         p-id = next-value(s-asmt, ub)
     2366         p-db = g#db-num
     2367       .
     2368       create buf_rang-abc-def.
     2369       run def-hash in this-procedure (
     2370            input   p-list-obj
     2371           ,output  p-possb-keep-string-obj
     2372           ,output  p-string-obj
     2373           ,output  p-hash-string-obj
     2374           ).
     2375   end.
     2376   else do:
     2377     assign
     2378         v-exist = true
     2379         p-id = buf_rang-abc-def.raad-id
     2380         p-db = buf_rang-abc-def.db-num
     2381         p-hash-string-obj       = buf_rang-abc-def.raad-hash-string-obj
