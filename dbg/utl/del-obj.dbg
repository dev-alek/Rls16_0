     3738   procedure delete-inkas :
     3739     define input  parameter p-obj-type as character no-undo .
     3740     define input  parameter p-obj-code as integer   no-undo .
     3741     define variable v-host-code as integer no-undo .
     3742     define buffer buf_inkas for ub.inkas .
     3743     define buffer buf_inkas-pay for ub.inkas-pay .
     3744     define buffer buf_inkas-pay-desk for ub.inkas-pay-desk .
     3745     define buffer buf_inkas-pay-wth for ub.inkas-pay-wth .
     3746     define buffer buf_sale-doc for ub.sale-doc.
     3747     define buffer buf_c-inkas for ub.c-inkas .
     3748     define buffer buf_c-inkas-pay for ub.c-inkas-pay .
     3749     define buffer buf_c-inkas-pay-desk for ub.c-inkas-pay-desk .
     3750     define buffer buf_c-inkas-pay-wth for ub.c-inkas-pay-wth .
     3751     define buffer buf_c-sale-doc for ub.c-sale-doc.
     3752     define buffer buf_payment for ub.payment .
     3753     define buffer buf_sysconf for ub.sysconf.
     3754     on delete of ub.inkas override do: end.
     3755     on delete of ub.c-inkas override do: end.
     3756     on delete of ub.inkas-pay override do: end.
     3757     on delete of ub.c-inkas-pay override do: end.
     3758     on delete of ub.inkas-pay-desk override do: end.
     3759     on delete of ub.c-inkas-pay-desk override do: end.
     3760     on delete of ub.inkas-pay-wth override do: end.
     3761     on delete of ub.c-inkas-pay-wth override do: end.
     3762     on write of ub.payment override do: end.
     3763     on delete of ub.sale-doc override do: end.
     3764     on delete of ub.c-sale-doc override do: end.
     3765     do
     3766     on error undo, return error return-value
     3767     :
     3768   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3770     (input  p-obj-type
     3771     ,input  p-obj-code
     3772     ,output v-host-code
     3773     )  .
     3774       find first buf_sysconf no-lock where
     3775                 buf_sysconf.host-code = v-host-code.
     3776       for each buf_inkas exclusive-lock
     3777         where buf_inkas.obj-type = p-obj-type
     3778           and buf_inkas.obj-code = p-obj-code
     3779       on error undo, return error return-value
     3780       :
     3781         for each buf_sale-doc exclusive-lock
     3782           where buf_sale-doc.inkas-code = buf_inkas.inkas-code
     3783         on error undo, return error return-value
     3784         :
     3785           delete buf_sale-doc .
     3786         end.
     3787         for each buf_c-sale-doc exclusive-lock
     3788           where buf_c-sale-doc.inkas-code = buf_inkas.inkas-code
     3789         on error undo, return error return-value
     3790         :
     3791           delete buf_c-sale-doc .
     3792         end.
     3793         for each buf_inkas-pay exclusive-lock
     3794           where buf_inkas-pay.inkas-code = buf_inkas.inkas-code
     3795         on error undo, return error return-value
     3796         :
     3797           delete buf_inkas-pay .
     3798         end.
     3799         for each buf_inkas-pay-desk exclusive-lock
     3800           where buf_inkas-pay-desk.inkas-code = buf_inkas.inkas-code
     3801         on error undo, return error return-value
     3802         :
     3803           delete buf_inkas-pay-desk .
     3804         end.
     3805         for each buf_inkas-pay-wth exclusive-lock
     3806           where buf_inkas-pay-wth.inkas-code = buf_inkas.inkas-code
     3807         on error undo, return error return-value
     3808         :
     3809           delete buf_inkas-pay-wth .
     3810         end.
     3811         for each buf_payment exclusive-lock
     3812           where buf_payment.source-type = 'касс':U AND
