     5554   procedure delete-dis-obj :
     5555     define input  parameter p-obj-type as character no-undo .
     5556     define input  parameter p-obj-code as integer   no-undo .
     5557     define buffer buf_dis-obj       for ub.dis-obj .
     5558     define buffer buf_c-dis-obj     for ub.c-dis-obj .
     5559     define buffer buf_dis-host      for ub.dis-host.
     5560     define buffer buf_dis-card      for ub.dis-card.
     5561     define buffer buf_c-dc-hist     for ub.c-dc-hist.
     5562     on delete of ub.dis-obj          override do: end.
     5563     on delete of ub.c-dis-obj        override do: end.
     5564     on write  of ub.dis-host         override do: end.
     5565     on write  of ub.dis-card         override do: end.
     5566     on delete  of ub.c-dc-hist       override do: end.
     5567     on write   of ub.c-dc-hist       override do: end.
     5568     do
     5569     on error undo, return error return-value
     5570     :
     5571       for each buf_dis-obj exclusive-lock
     5572         where buf_dis-obj.obj-type = p-obj-type
     5573           and buf_dis-obj.obj-code = p-obj-code
     5574       on error undo, return error return-value
     5575       :
     5576         for each buf_c-dis-obj
     5577             where buf_c-dis-obj.d-card = buf_dis-obj.d-card
     5578               AND buf_c-dis-obj.obj-type = buf_dis-obj.obj-type
     5579               AND buf_c-dis-obj.obj-code = buf_dis-obj.obj-code:
     5580           run delete-route in this-procedure
     5581             ( input 'c-dis-obj':U
     5582             ,input (buffer buf_c-dis-obj:handle)
     5583             ) .
     5584         end.
     5585         for each buf_c-dc-hist
     5586             where buf_c-dc-hist.d-card = buf_dis-obj.d-card
     5587               AND buf_c-dc-hist.chip-num = buf_c-dis-obj.chip-num
     5588               AND buf_c-dc-hist.corr-user-db-num = buf_c-dis-obj.corr-user-db-num
     5589               AND buf_c-dc-hist.host-code = buf_dis-obj.host-code
     5590               AND buf_c-dc-hist.obj-type = buf_dis-obj.obj-type
     5591               AND buf_c-dc-hist.obj-code = buf_dis-obj.obj-code:
     5592           if buf_c-dc-hist.subject = 'dis-obj':U
     5593           and buf_c-dc-hist.source-type = 'касс':U
     5594           then do:
     5595              assign
     5596              buf_c-dc-hist.subject = 'dis-host':U
     5597              buf_c-dc-hist.source-type = 'накл':U
     5598              .
     5599           end.
     5600           else do:
     5601             delete buf_c-dc-hist.
     5602             run delete-route in this-procedure
     5603               ( input 'c-dc-hist':U
     5604               ,input (buffer buf_c-dc-hist:handle)
     5605               ) .
     5606           end.
     5607         end.
     5608         run delete-route in this-procedure
     5609             ( input 'dis-obj':U
     5610             ,input (buffer buf_dis-obj:handle)
     5611             ) .
     5612         delete buf_dis-obj .
     5613       end.
     5614     end.
     5615   end procedure.
     5616   procedure delete-dis-dc-rule :
     5617     define input  parameter p-obj-type as character no-undo .
