     6208         run delete-route in this-procedure
     6209           ( input 'user-menu-group':U
     6210           , input (buffer buf_user-menu-group:handle)
     6211           ) .
     6212       end.
     6213       for each  buf_user-login-action-role
     6214           where buf_user-login-action-role.db-num  = ub.user-obj.db-num
     6215             and buf_user-login-action-role.user-id = ub.user-obj.user-id
     6216             and buf_user-login-action-role.obj-type = ub.user-obj.obj-type
     6217             and buf_user-login-action-role.obj-code = ub.user-obj.obj-code
     6218             and buf_user-login-action-role.action-role-context = 'object':U
     6219           exclusive-lock
