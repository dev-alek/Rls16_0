     3353   procedure log-information :
     3354     define input  parameter p-message as character no-undo .
     3355     do
     3356     on error undo, return error return-value
     3357     :
     3358       define variable v-today as date      no-undo .
     3359       define variable v-time  as integer   no-undo .
     3360       output stream slog to value('del-obj.log') append .
     3361       export stream slog v-obj-type v-obj-code cur-time-string() p-message .
     3362       output stream slog close .
     3363       run cur-time in this-procedure
     3364         (output v-today
     3365         ,output v-time
     3366         ) .
     3367       assign
     3368         v-current-time = string(time - v-start-time, "HH:MM:SS")
     3369         v-current-action = p-message
     3370       .
     3371       display
     3372         v-current-time v-current-action
     3373         with frame show-act .
     3374       process events .
     3375     end.
     3376   end procedure.
     3377   procedure check-input-parameters :
     3378     define buffer buf_clients  for ub.clients .
     3379     do
     3380     on error undo, return error substitute( "&1 (check-input-parameters). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3381     :
     3382       define variable v-ind      as integer   no-undo .
     3383       define variable v-obj-type as character no-undo .
     3384       define variable v-obj-code as integer   no-undo .
     3385       do v-ind = 1 to num-entries( p-obj-list, chr(44) ) by 2
     3386       :
     3387         assign
     3388           v-obj-type = entry( v-ind, p-obj-list, chr(44) )
     3389           v-obj-code = integer( entry( v-ind + 1, p-obj-list, chr(44) ) )
     3390         .
     3391         find first buf_clients exclusive-lock
     3392           where buf_clients.obj-type = v-obj-type
     3393             and buf_clients.obj-code = v-obj-code
     3394           no-error .
     3395         if not available buf_clients then do:
     3396           message
     3397             vss-workfile vss-revision vss-description skip
     3398             "Ошибка задания входных параметров" skip
     3399             "Неизвестный объект" v-obj-type v-obj-code skip
     3400             view-as alert-box error .
     3401           undo, return error .
     3402         end.
     3403       end.
     3404     end.
     3405   end procedure.
     3406   procedure delete-route :
     3407     define input parameter p-tbl-name   as character no-undo .
     3408     define input parameter p-tbl-handle as handle    no-undo .
     3409     do
     3410     on error undo, return error
     3411     :
     3412       define buffer buf_route   for ub.route .
     3413       define variable v-key-rec as character no-undo .
     3414       run gen-key-rec ( input  p-tbl-name
     3415                        ,input  p-tbl-handle
     3416                        ,output v-key-rec
     3417                       ) no-error .
     3418       if not error-status :error then do:
     3419         for each buf_route exclusive-lock
     3420           where buf_route.uniq-key-rec = v-key-rec
     3421         on error undo, return error
     3422         :
     3423           delete buf_route .
     3424         end.
     3425       end.
     3426     end.
     3427   end procedure.
