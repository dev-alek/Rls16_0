     6839   procedure delete-batchprocess :
     6840     define input  parameter p-obj-type as character no-undo .
     6841     define input  parameter p-obj-code as integer   no-undo .
     6842     do
     6843     on error undo, return error return-value
     6844     :
     6845       define buffer calc-arh-lock_batchprocess for ub.batchprocess .
     6846       run gbl/lock-prc.p
     6847         (input 'btpr':U
     6848         ,input p-obj-code
     6849         ,input 0
     6850         ,input 0
     6851         ,input p-obj-type
     6852         ,input ""
     6853         ,input ""
     6854         ,input "Объект,,, ,,,Расчет складского архива по товарам"
     6855         ,input true
     6856         ,buffer calc-arh-lock_batchprocess
     6857         ) no-error .
     6858       if error-status :error then do:
     6859         message
     6860           vss-workfile vss-revision vss-description skip
     6861           "В данный момент рассчитывается складской архив по товарам" skip
     6862           "Невозможно удалить объект" skip
     6863           "Объект" p-obj-type p-obj-code skip
     6864           view-as alert-box error .
     6865         undo, return error .
     6866       end.
     6867       define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
     6868       run gbl/lock-prc.p
     6869         (input 'ahsp':U
     6870         ,input p-obj-code
     6871         ,input 0
     6872         ,input 0
     6873         ,input p-obj-type
     6874         ,input ""
     6875         ,input ""
     6876         ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
     6877         ,input true
     6878         ,buffer calc-supp-arh-lock_batchprocess
     6879         ) no-error .
     6880       if error-status :error then do:
     6881         message
     6882           vss-workfile vss-revision vss-description skip
     6883           "В данный момент рассчитывается складской архив по поставщикам" skip
     6884           "Невозможно удалить объект" skip
     6885           "Объект" p-obj-type p-obj-code skip
     6886           view-as alert-box error .
     6887         undo, return error .
     6888       end.
     6889       define buffer calc-aht-lock_batchprocess for ub.batchprocess .
     6890       run gbl/lock-prc.p
     6891         (input 'ahtb':U
     6892         ,input p-obj-code
     6893         ,input 0
     6894         ,input 0
     6895         ,input p-obj-type
     6896         ,input ""
     6897         ,input ""
     6898         ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
     6899         ,input true
     6900         ,buffer calc-aht-lock_batchprocess
     6901         ) no-error .
     6902       if error-status :error
     6903       then do:
     6904         message
     6905           vss-workfile vss-revision vss-description skip
     6906           "В данный момент рассчитывается складской архив по типам приобретения" skip
     6907           "Невозможно удалить объект" skip
     6908           "Объект" p-obj-type p-obj-code skip
     6909           view-as alert-box error .
     6910         undo, return error .
     6911       end.
     6912       run doclslib-clear-doc-list in this-procedure .
     6913       run doclslib-init-trn-doc in this-procedure
     6914         (input p-obj-type
     6915         ,input p-obj-code
     6916         ,input ?
     6917         ) no-error .
     6918       if error-status :error then do:
     6919         message
     6920           vss-workfile vss-revision vss-description skip
     6921           "Ошибка при вызове процедуры doclslib-init-trn-doc" skip
     6922           error-status :get-message(1) skip
     6923           return-value skip
     6924           view-as alert-box error .
     6925         undo, return error .
     6926       end.
     6927       run doclslib-init-price-doc in this-procedure
     6928         (input p-obj-type
     6929         ,input p-obj-code
     6930         ,input ?
     6931         ) no-error .
     6932       if error-status :error then do:
     6933         message
     6934           vss-workfile vss-revision vss-description skip
     6935           "Ошибка при вызове процедуры doclslib-init-price-doc" skip
     6936           error-status :get-message(1) skip
     6937           return-value skip
     6938           view-as alert-box error .
     6939         undo, return error .
     6940       end.
     6941       run doclslib-clear-batch-process in this-procedure
     6942         (input 'arh':U
     6943         ) no-error .
     6944       if error-status :error then do:
     6945         message
     6946           vss-workfile vss-revision vss-description skip
     6947           "Ошибка при вызове процедуры clear-batch-process" skip
     6948           error-status :get-message(1) skip
     6949           return-value skip
     6950           view-as alert-box error .
     6951         undo, return error .
     6952       end.
     6953       run doclslib-clear-batch-process in this-procedure
     6954         (input 'ahsp':U
     6955         ) no-error .
     6956       if error-status :error then do:
