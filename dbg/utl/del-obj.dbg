     5685             and buf_c-dis-dc-rule.nonunique = buf_dis-dc-rule.nonunique
     5686             and buf_c-dis-dc-rule.host-code = buf_dis-dc-rule.host-code
     5687             and buf_c-dis-dc-rule.obj-type = p-obj-type
     5688             and buf_c-dis-dc-rule.obj-code = p-obj-code:
