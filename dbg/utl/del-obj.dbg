      493     on error undo, return error return-value
      494     :
      495           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-get-archive-by-type in g#attr-lib
      496         (input  p-archive-type
      497         ,output p-archive-attr-list
      498         ) no-error .
      499       if error-status :error
      500       then do:
      501         undo, return error return-value .
      502       end.
      503     end.
      504   end procedure.
