        1   block-level on error undo, throw.
        2   define input parameter p-contract-code as integer   no-undo .
        3   define input parameter p-host-code as integer   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: ssetvat.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/ssetvat.p $":U .
        9   define variable vss-description as character no-undo init "Заполнение новых полей спецификации к договору".
       10   define new global shared variable g#language as character no-undo .
       11   if g#language <> '' and g#language <> 'rus':U then do:
       12     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       13   end.
       14   define new global shared variable g#library  as handle no-undo .
       15   define new global shared variable g#library2 as handle no-undo .
       16   main_block:
       17   do
       18   on error  undo main_block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       19   on stop   undo main_block, return error substitute( "&1. stop", vss-workfile )
       20   on endkey undo main_block, return error substitute( "&1. endkey", vss-workfile )
       21   :
       22     define variable v-vat-pc as decimal   no-undo .
       23     define variable v-fo     as decimal   no-undo .
       24     define buffer buf_tax-rate-gds for ub.tax-rate-gds .
       25     assign
       26       v-fo = integer(date(1, 1, 5000))
       27     .
       28     for each ub.c-contract-specif exclusive-lock
       29        where ub.c-contract-specif.contract-num = p-contract-code and
       30              ub.c-contract-specif.host-code = p-host-code
       31     on error  undo main_block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       32     :
       33       find first ub.clients no-lock
       34         where ub.clients.host-code = ub.c-contract-specif.host-code
       35         no-error .
       36       find first ub.goods no-lock
       37         where ub.goods.gds-code = ub.c-contract-specif.gds-code
       38         no-error .
       39       if available ub.goods then do:
       40         find last buf_tax-rate-gds no-lock
       41           where buf_tax-rate-gds.gds-code   = ub.goods.gds-code
       42             and buf_tax-rate-gds.tax-code   = 1
       43             and buf_tax-rate-gds.host-code  = 0
       44             and buf_tax-rate-gds.obj-type   = ""
       45             and buf_tax-rate-gds.obj-code   = 0
       46             and buf_tax-rate-gds.fact-order <= v-fo
       47           no-error .
       48           if available buf_tax-rate-gds then do:
       49             run pftxvalo (
       50                 input ?
       51               , input buf_tax-rate-gds.tax-code
       52               , input buf_tax-rate-gds.rate-code
       53               , input v-fo
       54               , input ub.c-contract-specif.host-code
       55               , input (if available ub.clients then ub.clients.obj-type else "":U )
       56               , input (if available ub.clients then ub.clients.obj-code else 0 )
       57               , output v-vat-pc
       58             ) .
       59           end.
       60           else do:
       61             assign
       62               v-vat-pc = 18
       63             .
       64           end.
       65         assign
       66           ub.c-contract-specif.gds-name      = ub.goods.gds-name
       67           ub.c-contract-specif.artic         = ub.goods.artic
       68           ub.c-contract-specif.prod-type     = ub.goods.prod-type
       69           ub.c-contract-specif.prod-code     = ub.goods.prod-code
       70           ub.c-contract-specif.unit-base     = ub.goods.unit-base
       71           ub.c-contract-specif.cli-base-rate = ub.goods.cli-base-rate
       72           ub.c-contract-specif.VAT-type      = 'в т. ч.':U
       73           ub.c-contract-specif.VAT-pc        = v-vat-pc
       74         .
       75       end.
       76     end.
       77     for each ub.contract-specif exclusive-lock
       78     where ub.contract-specif.contract-num = p-contract-code and
       79           ub.contract-specif.host-code = p-host-code
       80     on error  undo main_block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       81     :
       82       find first ub.clients no-lock
       83         where ub.clients.host-code = ub.contract-specif.host-code
       84         no-error .
       85       find first ub.goods no-lock
       86         where ub.goods.gds-code = ub.contract-specif.gds-code
       87         no-error .
       88       if available ub.goods then do:
       89         find last buf_tax-rate-gds no-lock
       90           where buf_tax-rate-gds.gds-code   = ub.goods.gds-code
       91             and buf_tax-rate-gds.tax-code   = 1
       92             and buf_tax-rate-gds.host-code  = 0
       93             and buf_tax-rate-gds.obj-type   = ""
       94             and buf_tax-rate-gds.obj-code   = 0
       95             and buf_tax-rate-gds.fact-order <= v-fo
       96           no-error .
       97         if available buf_tax-rate-gds then do:
       98           run pftxvalo (
       99               input ?
      100             , input buf_tax-rate-gds.tax-code
      101             , input buf_tax-rate-gds.rate-code
      102             , input v-fo
      103             , input ub.contract-specif.host-code
      104             , input (if available ub.clients then ub.clients.obj-type else "":U )
      105             , input (if available ub.clients then ub.clients.obj-code else 0 )
      106             , output v-vat-pc
      107           ) .
      108         end.
      109         else do:
      110           assign
      111             v-vat-pc = 18
      112           .
      113         end.
      114         assign
      115           ub.contract-specif.gds-name      = ub.goods.gds-name
      116           ub.contract-specif.artic         = ub.goods.artic
      117           ub.contract-specif.prod-type     = ub.goods.prod-type
      118           ub.contract-specif.prod-code     = ub.goods.prod-code
      119           ub.contract-specif.unit-base     = ub.goods.unit-base
      120           ub.contract-specif.cli-base-rate = ub.goods.cli-base-rate
      121           ub.contract-specif.VAT-type      = 'в т. ч.':U
      122           ub.contract-specif.VAT-pc        = v-vat-pc
      123         .
      124       end.
      125     end.
      126   end.
      127   procedure pftxvalo :
      128     define input  parameter par-rc        as recid                          no-undo .
      129     define input  parameter partax-code   like ub.tax.tax-code              no-undo .
      130     define input  parameter parrate-code  like ub.tax-rate.rate-code        no-undo .
      131     define input  parameter parfact-order like ub.tax-rate-value.fact-order no-undo .
      132     define input  parameter parhost-code  like ub.sysconf.host-code         no-undo .
      133     define input  parameter parobj-type   like ub.clients.obj-type          no-undo .
      134     define input  parameter parobj-code   like ub.clients.obj-code          no-undo .
      135     define output parameter partax-value  as decimal no-undo .
      136     define variable vss-description as character no-undo initial "pftxvalo: Значение по ставке налога для данного fact-order для заданного объекта и фирмы".
      137     define buffer buf_tax-rate for ub.tax-rate.
      138     define buffer buf_tax-rate-value for ub.tax-rate-value.
      139     do
      140     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      141     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      142     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      143     :
      144       assign
      145         partax-value = ?
      146       .
      147       find last buf_tax-rate-value no-lock
      148         where buf_tax-rate-value.tax-code   = partax-code
      149           and buf_tax-rate-value.rate-code  = parrate-code
      150           and buf_tax-rate-value.host-code  = parhost-code
      151           and buf_tax-rate-value.obj-type   = parobj-type
      152           and buf_tax-rate-value.obj-code   = parobj-code
      153           and buf_tax-rate-value.fact-order <= parfact-order
      154           and buf_tax-rate-value.status_    = 'тек':U
      155         no-error .
      156       if available buf_tax-rate-value then do:
      157         assign
      158           partax-value = buf_tax-rate-value.rate-value
      159         .
      160         return.
      161       end.
      162       find last buf_tax-rate-value no-lock
      163         where buf_tax-rate-value.tax-code   = partax-code
      164           and buf_tax-rate-value.rate-code  = parrate-code
      165           and buf_tax-rate-value.host-code  = parhost-code
      166           and buf_tax-rate-value.obj-type   = ""
      167           and buf_tax-rate-value.obj-code   = 0
      168           and buf_tax-rate-value.fact-order <= parfact-order
      169           and buf_tax-rate-value.status_    = 'тек':U
      170         no-error .
      171       if available buf_tax-rate-value then do:
      172         assign
      173           partax-value = buf_tax-rate-value.rate-value
      174         .
      175         return.
      176       end.
      177       find last buf_tax-rate-value no-lock
      178         where buf_tax-rate-value.tax-code   = partax-code
      179           and buf_tax-rate-value.rate-code  = parrate-code
      180           and buf_tax-rate-value.host-code  = 0
      181           and buf_tax-rate-value.obj-type   = ""
      182           and buf_tax-rate-value.obj-code   = 0
      183           and buf_tax-rate-value.fact-order <= parfact-order
      184           and buf_tax-rate-value.status_    = 'тек':U
      185         no-error .
      186       if available buf_tax-rate-value then do:
      187         assign
      188           partax-value = buf_tax-rate-value.rate-value
      189         .
      190         return.
      191       end.
      192     end.
      193   end procedure.
