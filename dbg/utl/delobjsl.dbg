      340   define stream slog .
      341   define variable v-rid-list as character no-undo .
      342   DEFINE BUTTON b-del AUTO-GO
      343        LABEL "&Удалить"
      344        SIZE 10 BY 1
      345        BGCOLOR 8 .
      346   DEFINE BUTTON b-help
      347        LABEL "&Помощь"
      348        SIZE 10 BY 1
      349        BGCOLOR 8 .
      350   DEFINE BUTTON b-inq AUTO-GO
      351        LABEL "&Запрос"
      352        SIZE 10 BY 1
      353        BGCOLOR 8 .
      354   DEFINE BUTTON b-mark
      355        LABEL "&*"
      356        SIZE 3 BY 1
      357        BGCOLOR 8 .
      358   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      359        LABEL "&Отмена"
      360        SIZE 10 BY 1
      361        BGCOLOR 8 .
      362   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      363        LABEL "Отмечено строк"
      364        VIEW-AS FILL-IN
      365        SIZE 14 BY 1 NO-UNDO.
      366   DEFINE QUERY br-cli FOR
      367         ub.clients SCROLLING.
      368   DEFINE BROWSE br-cli
      369     QUERY br-cli NO-LOCK DISPLAY
      370         mark-string( input recid(ub.clients), input v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      371         ub.clients.obj-type FORMAT "X(3)":U
      372         ub.clients.obj-code FORMAT ">>>>>>>>9":U
      373         ub.clients.obj-name FORMAT "X(40)":U
      374         ub.clients.db-num FORMAT ">>>>9":U
      375       WITH SEPARATORS SIZE 64.5 BY 10 ROW-HEIGHT-CHARS .67.
      376   DEFINE FRAME Dialog-Frame
      377        Btn_Cancel AT ROW 1 COL 2
      378        b-mark AT ROW 1 COL 12 WIDGET-ID 2
      379        b-inq AT ROW 1 COL 15
      380        b-del AT ROW 1 COL 25 WIDGET-ID 4
      381        b-help AT ROW 1 COL 57
      382        mark-num AT ROW 2.25 COL 16.5 COLON-ALIGNED
      383        br-cli AT ROW 3.5 COL 2.5
      384        SPACE(1.24) SKIP(0.49)
      385       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      386            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      387            TITLE "Удаление объекта"
      388            DEFAULT-BUTTON b-inq CANCEL-BUTTON Btn_Cancel.
      389   ASSIGN
      390          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      391          FRAME Dialog-Frame:HIDDEN           = TRUE.
      392   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      393   DO:
      394     APPLY "END-ERROR":U TO SELF.
      395   END.
      396   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      397   DO:
      398     run delete-object in this-procedure
      399       (input "":U
      400       ,input "delete":U
      401       ) no-error .
      402     if error-status :error then do:
      403       undo, return no-apply .
      404     end.
      405   END.
      406   ON CHOOSE OF b-inq IN FRAME Dialog-Frame
      407   DO:
      408     define buffer buf_clients for ub.clients .
      409     define variable v-ind   as integer   no-undo .
      410     define variable v-recid as integer   no-undo .
      411     define variable v-obj-list as character no-undo .
      412     if v-rid-list = "":U then do:
      413       if available ub.clients then do:
      414   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   define variable v-str-recid3 as character no-undo .
      416   define variable v-num-entry3 as integer   no-undo .
      417   assign
      418     v-str-recid3 = trim( string( recid( ub.clients ) , "->>>>>>>>>>>9":U ) )
      419     v-num-entry3 = lookup( v-str-recid3 , v-rid-list )
      420   .
      421   if v-num-entry3 > 0 then do:
      422     assign
      423       entry( v-num-entry3, v-rid-list ) = "":U
      424       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      425     .
      426   end.
      427   else do:
      428     assign
      429       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid3
      430     .
      431   end.
      432       end.
      433       else do:
      434         message
      435           "Не выбран клиент"
      436           view-as alert-box error .
      437         return no-apply.
      438       end.
      439     end.
      440     do v-ind = 1 to num-entries( v-rid-list )
      441     :
      442       assign
      443         v-recid = integer( entry( v-ind, v-rid-list, chr(44) ) )
      444         no-error
      445       .
      446       find first buf_clients no-lock
      447         where recid( buf_clients ) = v-recid
      448         no-error .
      449       if not available buf_clients then do:
      450         message
      451           substitute("Объект (recid &1) не найден", v-recid ) skip
      452           substitute("Полный список &1", v-rid-list ) skip
      453           view-as alert-box error .
      454         return no-apply .
      455       end.
      456       else do:
      457         assign
      458           v-obj-list = v-obj-list + chr(44) + substitute( "&1&2&3", buf_clients.obj-type, chr(44), buf_clients.obj-code )
      459         .
      460       end.
      461     end.
      462     assign
      463       v-obj-list = left-trim( v-obj-list, chr(44) )
      464     .
      465     run delete-object in this-procedure
      466       (input v-obj-list
      467       ,input "inquiry":U
      468       ) no-error .
      469     if error-status :error then do:
      470       undo, return no-apply .
      471     end.
      472   END.
      473   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      474   DO:
      475     define variable loc#log as logical no-undo .
      476     if available ub.clients then do:
      477   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      478   define variable v-str-recid5 as character no-undo .
      479   define variable v-num-entry5 as integer   no-undo .
      480   assign
      481     v-str-recid5 = trim( string( recid( ub.clients ) , "->>>>>>>>>>>9":U ) )
      482     v-num-entry5 = lookup( v-str-recid5 , v-rid-list )
      483   .
      484   if v-num-entry5 > 0 then do:
      485     assign
      486       entry( v-num-entry5, v-rid-list ) = "":U
      487       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      488     .
      489   end.
      490   else do:
      491     assign
      492       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
      493     .
      494   end.
      495       loc#log = br-cli:refresh() .
      496       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      497           loc#log = br-cli:select-next-row ().
      498           apply "VALUE-CHANGED" to br-cli in frame Dialog-Frame.
      499       end.
      500       if num-entries( v-rid-list ) = 0 then do:
      501         hide mark-num in frame Dialog-Frame.
      502       end.
      503       else do:
      504         display
      505           num-entries( v-rid-list ) @ mark-num
      506           with frame Dialog-Frame.
      507       end.
      508     end.
      509     apply "entry" to br-cli in frame Dialog-Frame.
      510   END.
      511   ON VALUE-CHANGED OF br-cli IN FRAME Dialog-Frame
      512   DO:
      513   END.
      514   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      515   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      516   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      517   on help of frame Dialog-Frame
      518   do:
      519     run gbl/app_help.p
      520       (input this-procedure :file-name
      521       ,input ''
      522       ,input ?
      523       ) no-error.
      524     if error-status :error then do:
      525       message
      526         "Ошибка при вызове помощи"
      527         error-status :get-message(1)
      528         view-as alert-box .
      529     end.
      530   end.
      531   run minbtn-set in this-procedure .
      532   on choose of b-help in frame Dialog-Frame
      533   do:
      534     apply "help":u to frame Dialog-Frame .
      535   end.
      536   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   procedure minbtn-set :
      538       do
      539           on error undo, return error return-value
      540           :
      541           define variable ii              as integer       no-undo .
      542           define variable fh              as widget-handle no-undo .
      543           define variable hh              as widget-handle no-undo .
      544           define variable v-h             as handle        extent 4 no-undo .
      545           define variable v-name-button   as character     no-undo .
      546           define variable v-help-old-x    as decimal       no-undo .
      547           define variable v-help-old-y    as decimal       no-undo .
      548           define variable v-help-old-size as decimal       no-undo .
      549           define variable v-frame-width   as decimal       no-undo .
      550           define variable jj              as integer       no-undo .
      551           do
      552               on error undo, return error
      553               :
      554               assign
      555                   v-frame-width = frame Dialog-Frame:width - 0.3
      556                   fh            = frame Dialog-Frame:first-child
      557                   hh            = fh:first-child
      558                   ii            = 1
      559                   .
      560               do while valid-handle(hh):
      561                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      562                   do:
      563                       case lc(hh:name) :
      564                           when "b-help" then
      565                               do:
      566                                   hh:load-image-up("cmp/b-help.bmp":u) .
      567                                   hh:load-image-down("cmp/b-help.bmp":u) .
      568                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      569                                   hh:TOOLTIP = "Помощь" .
      570                                   v-help-old-x = hh:column .
      571                                   v-help-old-y = hh:row    .
      572                                   v-help-old-size = hh:width .
      573                                   hh:width-chars = 2.5 .
      574                               end.
      575                           when "b-print" then
      576                               do:
      577                                   hh:load-image("cmp/b-print.bmp":u) .
      578                                   hh:TOOLTIP = "Печать" .
      579                                   v-h[ii] = hh:handle .
      580                                   ii = ii + 1 .
      581                                   hh:width-chars = 3 .
      582                               end.
      583                           when "b-history" or
      584                           when "b-hist" then
      585                               do:
      586                                   hh:load-image("cmp/b-hist.bmp":u) .
      587                                   hh:TOOLTIP = "История" .
      588                                   v-h[ii] = hh:handle .
      589                                   ii = ii + 1 .
      590                                   hh:width-chars = 3 .
      591                               end.
      592                           when "b-sch" then
      593                               do:
      594                                   hh:load-image("cmp/b-sch.bmp":u) .
      595                                   hh:TOOLTIP = "Установка Фильтра" .
      596                                   v-h[ii] = hh:handle .
      597                                   ii = ii + 1 .
      598                                   hh:width-chars = 3 .
      599                               end.
      600                           when "b-hist-user" then
      601                               do:
      602                                   hh:load-image("cmp/b-hist.bmp":u) .
      603                                   hh:TOOLTIP = "История пользователя" .
      604                                   ii = ii + 1 .
      605                               end.
      606                       end case.
      607                   end.
      608                   hh = hh:next-sibling.
      609               end.
      610               b-help:column = v-frame-width - b-help:width-chars.
      611               jj = 0.
      612               repeat ii = 4 to 1 by -1 :
      613                   if valid-handle (v-h[ii] ) then
      614                   do:
      615                       jj  = jj + 1 .
      616                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      617                       v-h[ii]:row    = v-help-old-y .
      618                   end.
      619               end.
      620           end.
      621       end.
      622   end procedure.
      623   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      624   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      625   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      626   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      627   define variable v-diasize-current-frame-width  as decimal   no-undo .
      628   define variable v-diasize-current-frame-height as decimal   no-undo .
      629   define variable v-diasize-change-size          as logical   no-undo .
      630   define variable v-diasize-resize-button        as handle    no-undo .
      631   define variable v-diasize-wndmax               as logical   no-undo .
      632   define variable v-diasize-wndstore             as logical   no-undo .
      633   define variable v-diasize-proc-name            as character no-undo .
      634   define variable v-diasize-browse-handle        as handle    no-undo .
      635   define variable v-diasize-browse-number        as integer   no-undo .
      636   define variable v-diasize-need-full-display    as logical   no-undo init false .
      637   define temp-table temp-diasize-handle no-undo
      638     field handle-value  as handle
      639     field save-position as decimal
      640     index xpk is primary unique handle-value
      641     .
      642   define temp-table temp-browse-handle no-undo
      643     field browse-type   as character
      644     field browse-number as integer
      645     field browse-handle as handle
      646     field original-size as decimal
      647     index xpk is primary unique browse-type browse-number
      648     index xie browse-type browse-handle
      649   .
      650   procedure diasize_change-height :
      651     define input  parameter p-change-value  as decimal   no-undo .
      652     define input  parameter p-move-resize   as logical   no-undo .
      653     define variable v-field-group-handle    as handle    no-undo .
      654     define variable v-object-handle         as handle    no-undo .
      655     define variable v-frame-height          as decimal   no-undo .
      656     define variable v-frame-virtual-height  as decimal   no-undo .
      657     define variable v-browse-height         as decimal   no-undo .
      658     define variable v-window-height         as decimal   no-undo .
      659     define variable v-window-virtual-height as decimal   no-undo .
      660     define variable v-change-sign           as integer   no-undo .
      661     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      662     define buffer buf_temp-browse-handle  for temp-browse-handle .
      663     if p-change-value > 0
      664     then do:
      665       if frame Dialog-Frame :height + p-change-value
      666           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      667       then do:
      668         assign
      669           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      670                           - (frame Dialog-Frame :height-chars)
      671         .
      672         if p-change-value <= 0
      673         then do:
      674           run diasize_position-resize-button in this-procedure .
      675           return .
      676         end.
      677       end.
      678     end.
      679     if p-change-value < 0
      680     then do:
      681       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      682       then do:
      683         assign
      684           p-change-value = v-diasize-orig-frame-height
      685                          - (frame Dialog-Frame :height-chars)
      686         .
      687         if p-change-value >= 0
      688         then do:
      689           run diasize_position-resize-button in this-procedure .
      690           return .
      691         end.
      692       end.
      693     end.
      694     if p-change-value >= 0
      695     then do:
      696       assign
      697         v-change-sign = 1
      698       .
      699     end.
      700     else do:
      701       assign
      702         v-change-sign = -1
      703       .
      704     end.
      705     assign
      706       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      707     .
      708     if p-change-value = 0
      709     then do:
      710       run diasize_position-resize-button in this-procedure .
      711       return .
      712     end.
      713     move_block:
      714     do
      715     on error undo move_block, retry move_block
      716     :
      717       if retry
      718       then do:
      719         do
      720         on error undo move_block, leave move_block
      721         :
      722           if p-change-value > 0
      723           then do:
      724             for each buf_temp-diasize-handle
      725             on error undo, next
      726             :
      727               assign
      728                 v-object-handle = buf_temp-diasize-handle.handle-value
      729               .
      730               if v-object-handle <> v-diasize-resize-button
      731               then do:
      732                 assign
      733                   v-object-handle :row = buf_temp-diasize-handle.save-position
      734                 .
      735               end.
      736             end.
      737             assign
      738               v-diasize-browse-handle :height = v-browse-height
      739             .
      740             for each buf_temp-browse-handle
      741               where buf_temp-browse-handle.browse-type = 'height':u
      742             on error undo, next
      743             :
      744               assign
      745                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      746               .
      747             end.
      748             assign
      749               frame Dialog-Frame :height = v-frame-height
      750             .
      751             if frame Dialog-Frame :scrollable = true
      752             then do:
      753               assign
      754                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      755               .
      756             end.
      757             run diasize_position-resize-button in this-procedure .
      758           end.
      759           else do:
      760             if frame Dialog-Frame :scrollable = true
      761             then do:
      762               assign
      763                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      764               .
      765             end.
      766             assign
      767               frame Dialog-Frame :height = v-frame-height
      768             .
      769             assign
      770               v-diasize-browse-handle :height = v-browse-height
      771             .
      772             for each buf_temp-browse-handle
      773               where buf_temp-browse-handle.browse-type = 'height':u
      774             on error undo, next
      775             :
      776               assign
      777                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      778               .
      779             end.
      780             for each buf_temp-diasize-handle
      781             on error undo, next
      782             :
      783               assign
      784                 v-object-handle = buf_temp-diasize-handle.handle-value
      785               .
      786               if v-object-handle <> v-diasize-resize-button
      787               then do:
      788                 assign
      789                   v-object-handle :row = buf_temp-diasize-handle.save-position
      790                 .
      791               end.
      792             end.
      793             run diasize_position-resize-button in this-procedure .
      794           end.
      795           assign
      796             v-diasize-change-size = false
      797           .
      798           leave move_block .
      799         end.
      800       end.
      801       assign
      802         v-diasize-need-full-display = true
      803       .
      804       if v-diasize-change-size = false
      805       then do:
      806         assign
      807           v-diasize-change-size = true
      808         .
      809       end.
      810       else do:
      811         return .
      812       end.
      813       assign
      814         v-frame-height = frame Dialog-Frame :height
      815         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      816         v-browse-height = v-diasize-browse-handle :height
      817       .
      818       for each buf_temp-browse-handle
      819         where buf_temp-browse-handle.browse-type = 'height':u
      820       :
      821         assign
      822           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      823         .
      824       end.
      825       for each buf_temp-diasize-handle
      826       :
      827         delete buf_temp-diasize-handle .
      828       end.
      829       assign
      830         v-field-group-handle = frame Dialog-Frame :first-child
      831       .
      832       do while valid-handle(v-field-group-handle)
      833       :
      834         assign
      835           v-object-handle = v-field-group-handle :first-child
      836         .
      837         do while valid-handle(v-object-handle)
      838         :
      839           if  v-object-handle <> v-diasize-browse-handle :handle
      840           and can-query(v-object-handle, "row")
      841           and can-query(v-object-handle, "height")
      842           and ( v-object-handle :row > v-diasize-browse-handle :row )
      843           then do:
      844             find first buf_temp-browse-handle
      845               where buf_temp-browse-handle.browse-type   = 'height':u
      846                 and buf_temp-browse-handle.browse-handle = v-object-handle
      847               no-error .
      848             if available buf_temp-browse-handle
      849             then do:
      850             end.
      851             else do:
      852               create buf_temp-diasize-handle .
      853               assign
      854                 buf_temp-diasize-handle.handle-value  = v-object-handle
      855                 buf_temp-diasize-handle.save-position = v-object-handle :row
      856               .
      857             end.
      858           end.
      859           assign
      860             v-object-handle = v-object-handle :next-sibling
      861           .
      862         end.
      863         assign
      864           v-field-group-handle = v-field-group-handle :next-sibling
      865         .
      866       end.
      867       do with frame Dialog-Frame
      868       :
      869         hide v-diasize-resize-button .
      870         assign
      871           v-diasize-resize-button :row    = 1
      872           v-diasize-resize-button :column = 1
      873         .
      874       end.
      875       if p-change-value > 0
      876       then do:
      877         if frame Dialog-Frame :scrollable = true
      878         then do:
      879           assign
      880             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      881             no-error .
      882           if error-status :error
      883           or error-status :get-message(1) <> ""
      884           then do:
      885             undo move_block, retry move_block .
      886           end.
      887         end.
      888         assign
      889           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      890           no-error .
      891         if error-status :error
      892         or error-status :get-message(1) <> ""
      893         then do:
      894           undo move_block, retry move_block .
      895         end.
      896         assign
      897           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      898           no-error .
      899         if error-status :error
      900         or error-status :get-message(1) <> ""
      901         then do:
      902           undo move_block, retry move_block .
      903         end.
      904         for each buf_temp-browse-handle
      905           where buf_temp-browse-handle.browse-type = 'height':u
      906         on error undo move_block, retry move_block
      907         :
      908           assign
      909             buf_temp-browse-handle.browse-handle :height
      910               = buf_temp-browse-handle.browse-handle :height + p-change-value
      911             no-error .
      912           if error-status :error
      913           or error-status :get-message(1) <> ""
      914           then do:
      915             undo move_block, retry move_block .
      916           end.
      917         end.
      918         for each buf_temp-diasize-handle
      919         on error undo move_block, retry move_block
      920         :
      921           assign
      922             v-object-handle = buf_temp-diasize-handle.handle-value
      923           .
      924           if v-object-handle <> v-diasize-resize-button
      925           then do:
      926             assign
      927               v-object-handle :row = v-object-handle :row + p-change-value
      928               no-error .
      929             if error-status :error
      930             or error-status :get-message(1) <> ""
      931             then do:
      932               undo move_block, retry move_block .
      933             end.
      934           end.
      935         end.
      936       end.
      937       else do:
      938         for each buf_temp-diasize-handle
      939         on error undo move_block, retry move_block
      940         :
      941           assign
      942             v-object-handle = buf_temp-diasize-handle.handle-value
      943           .
      944           if v-object-handle <> v-diasize-resize-button
      945           then do:
      946             assign
      947               v-object-handle :row = v-object-handle :row + p-change-value
      948               no-error .
      949             if error-status :error
      950             or error-status :get-message(1) <> ""
      951             then do:
      952               undo move_block, retry move_block .
      953             end.
      954           end.
      955         end.
      956         assign
      957           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      958           no-error .
      959         if error-status :error
      960         or error-status :get-message(1) <> ""
      961         then do:
      962           undo move_block, retry move_block .
      963         end.
      964         for each buf_temp-browse-handle
      965           where buf_temp-browse-handle.browse-type = 'height':u
      966         on error undo move_block, retry move_block
      967         :
      968           assign
      969             buf_temp-browse-handle.browse-handle :height
      970               = buf_temp-browse-handle.browse-handle :height + p-change-value
      971             no-error .
      972           if error-status :error
      973           or error-status :get-message(1) <> ""
      974           then do:
      975             undo move_block, retry move_block .
      976           end.
      977         end.
      978         assign
      979           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      980           no-error .
      981         if error-status :error
      982         or error-status :get-message(1) <> ""
      983         then do:
      984           undo move_block, retry move_block .
      985         end.
      986         if frame Dialog-Frame :scrollable = true
      987         then do:
      988           assign
      989             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      990             no-error .
      991           if error-status :error
      992           or error-status :get-message(1) <> ""
      993           then do:
      994             undo move_block, retry move_block .
      995           end.
      996         end.
      997       end.
      998       if p-move-resize = true
      999       then do:
     1000         run diasize_position-resize-button in this-procedure .
     1001       end.
     1002       if v-diasize-wndstore = true
     1003       then do:
     1004         if connected("ub") = true
     1005         then do:
     1006           define variable v-cntxt-db-num        as integer   no-undo .
     1007           define variable v-cntxt-userid        as character no-undo .
     1008           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1009                                             , OUTPUT v-cntxt-userid
     1010                                             ) .
     1011           run gbl/wndsizew.p
     1012             (input  v-cntxt-db-num
     1013             ,input  v-cntxt-userid
     1014             ,input  v-diasize-proc-name
     1015             ,input  'height':u
     1016             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1017             ) .
     1018         end.
     1019       end.
     1020     end.
     1021     assign
     1022       v-diasize-change-size = false
     1023     .
     1024   end procedure.
     1025   procedure diasize_set-height :
     1026     define input  parameter p-new-height  as decimal   no-undo .
     1027     define input  parameter p-move-resize as logical   no-undo .
     1028     do
     1029     on error undo, return error return-value
     1030     :
     1031       run diasize_change-height in this-procedure
     1032         (input  (p-new-height - frame Dialog-Frame :height)
     1033         ,input  p-move-resize
     1034         ) .
     1035     end.
     1036   end procedure.
     1037   procedure diasize_change-width :
     1038     define input  parameter p-change-value as decimal   no-undo .
     1039     define input  parameter p-move-resize  as logical   no-undo .
     1040     define variable v-field-group-handle   as handle    no-undo .
     1041     define variable v-object-handle        as handle    no-undo .
     1042     define variable v-frame-width          as decimal   no-undo .
     1043     define variable v-frame-virtual-width  as decimal   no-undo .
     1044     define variable v-browse-width         as decimal   no-undo .
     1045     define variable v-window-width         as decimal   no-undo .
     1046     define variable v-window-virtual-width as decimal   no-undo .
     1047     define variable v-change-sign          as integer   no-undo .
     1048     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1049     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1050     if p-change-value > 0
     1051     then do:
     1052       if frame Dialog-Frame :width + p-change-value >
     1053           session :width-chars
     1054       then do:
     1055         assign
     1056           p-change-value = session :width-chars - frame Dialog-Frame :width
     1057         .
     1058         if p-change-value <= 0
     1059         then do:
     1060           run diasize_position-resize-button in this-procedure .
     1061           return .
     1062         end.
     1063       end.
     1064     end.
     1065     if p-change-value < 0
     1066     then do:
     1067       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1068       then do:
     1069         assign
     1070           p-change-value = v-diasize-orig-frame-width
     1071                          - frame Dialog-Frame :width
     1072         .
     1073         if p-change-value >= 0
     1074         then do:
     1075           run diasize_position-resize-button in this-procedure .
     1076           return .
     1077         end.
     1078       end.
     1079     end.
     1080     if p-change-value >= 0
     1081     then do:
     1082       assign
     1083         v-change-sign = 1
     1084       .
     1085     end.
     1086     else do:
     1087       assign
     1088         v-change-sign = -1
     1089       .
     1090     end.
     1091     assign
     1092       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1093     .
     1094     if p-change-value = 0
     1095     then do:
     1096       run diasize_position-resize-button in this-procedure .
     1097       return .
     1098     end.
     1099     move_block:
     1100     do
     1101     on error undo move_block, leave move_block
     1102     :
     1103       if retry
     1104       then do:
     1105         do
     1106         on error undo move_block, leave move_block
     1107         :
     1108           if p-change-value > 0
     1109           then do:
     1110             for each buf_temp-diasize-handle
     1111             on error undo, next
     1112             :
     1113               assign
     1114                 v-object-handle = buf_temp-diasize-handle.handle-value
     1115               .
     1116               if v-object-handle <> v-diasize-resize-button
     1117               then do:
     1118                 assign
     1119                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1120                 .
     1121               end.
     1122             end.
     1123             assign
     1124               v-diasize-browse-handle :width = v-browse-width
     1125             .
     1126             for each buf_temp-browse-handle
     1127               where buf_temp-browse-handle.browse-type = 'width':u
     1128             on error undo, next
     1129             :
     1130               assign
     1131                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1132               .
     1133             end.
     1134             assign
     1135               frame Dialog-Frame :width = v-frame-width
     1136             .
     1137             if frame Dialog-Frame :scrollable = true
     1138             then do:
     1139               assign
     1140                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1141               .
     1142             end.
     1143             run diasize_position-resize-button in this-procedure .
     1144           end.
     1145           else do:
     1146             if frame Dialog-Frame :scrollable = true
     1147             then do:
     1148               assign
     1149                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1150               .
     1151             end.
     1152             assign
     1153               frame Dialog-Frame :width = v-frame-width
     1154             .
     1155             for each buf_temp-browse-handle
     1156               where buf_temp-browse-handle.browse-type = 'width':u
     1157             on error undo, next
     1158             :
     1159               assign
     1160                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1161               .
     1162             end.
     1163             assign
     1164               v-diasize-browse-handle :width = v-browse-width
     1165             .
     1166             for each buf_temp-diasize-handle
     1167             on error undo, next
     1168             :
     1169               assign
     1170                 v-object-handle = buf_temp-diasize-handle.handle-value
     1171               .
     1172               if v-object-handle <> v-diasize-resize-button
     1173               then do:
     1174                 assign
     1175                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1176                 .
     1177               end.
     1178             end.
     1179             run diasize_position-resize-button in this-procedure .
     1180           end.
     1181           assign
     1182             v-diasize-change-size = false
     1183           .
     1184           leave move_block .
     1185         end.
     1186       end.
     1187       assign
     1188         v-diasize-need-full-display = true
     1189       .
     1190       if v-diasize-change-size = false
     1191       then do:
     1192         assign
     1193           v-diasize-change-size = true
     1194         .
     1195       end.
     1196       else do:
     1197         return .
     1198       end.
     1199       assign
     1200         v-frame-width = frame Dialog-Frame :width
     1201         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1202         v-browse-width = v-diasize-browse-handle :width
     1203       .
     1204       for each buf_temp-browse-handle
     1205         where buf_temp-browse-handle.browse-type = 'width':u
     1206       :
     1207         assign
     1208           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1209         .
     1210       end.
     1211       for each buf_temp-diasize-handle
     1212       :
     1213         delete buf_temp-diasize-handle .
     1214       end.
     1215       assign
     1216         v-field-group-handle = frame Dialog-Frame :first-child
     1217       .
     1218       do while valid-handle(v-field-group-handle)
     1219       :
     1220         assign
     1221           v-object-handle = v-field-group-handle :first-child
     1222         .
     1223         do while valid-handle(v-object-handle)
     1224         :
     1225           if  v-object-handle <> v-diasize-browse-handle :handle
     1226           and v-object-handle <> v-diasize-resize-button
     1227           and can-query(v-object-handle, "row")
     1228           and can-query(v-object-handle, "height")
     1229           and ( v-object-handle :col + v-object-handle :width
     1230                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1231               )
     1232           then do:
     1233             find first buf_temp-browse-handle
     1234               where buf_temp-browse-handle.browse-type   = 'width':u
     1235                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1236               no-error .
     1237             if available buf_temp-browse-handle
     1238             then do:
     1239             end.
     1240             else do:
     1241               create buf_temp-diasize-handle .
     1242               assign
     1243                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1244                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1245               .
     1246             end.
     1247           end.
     1248           assign
     1249             v-object-handle = v-object-handle :next-sibling
     1250           .
     1251         end.
     1252         assign
     1253           v-field-group-handle = v-field-group-handle :next-sibling
     1254         .
     1255       end.
     1256       do with frame Dialog-Frame
     1257       :
     1258         hide v-diasize-resize-button .
     1259         v-diasize-resize-button :row = 1.
     1260         v-diasize-resize-button :column = 1.
     1261       end.
     1262       if p-change-value > 0
     1263       then do:
     1264         if frame Dialog-Frame :scrollable = true
     1265         then do:
     1266           assign
     1267             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1268             no-error .
     1269           if error-status :error
     1270           or error-status :get-message(1) <> ""
     1271           then do:
     1272             undo move_block, retry move_block.
     1273           end.
     1274         end.
     1275         assign
     1276           frame Dialog-Frame :width = v-frame-width + p-change-value
     1277           no-error .
     1278         if error-status :error
     1279         or error-status :get-message(1) <> ""
     1280         then do:
     1281           undo move_block, retry move_block.
     1282         end.
     1283         assign
     1284           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1285         no-error .
     1286         if error-status :error
     1287         or error-status :get-message(1) <> ""
     1288         then do:
     1289           undo move_block, retry move_block.
     1290         end.
     1291         for each buf_temp-browse-handle
     1292           where buf_temp-browse-handle.browse-type = 'width':u
     1293         on error undo move_block, retry move_block
     1294         :
     1295           assign
     1296             buf_temp-browse-handle.browse-handle :width
     1297               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1298             no-error .
     1299           if error-status :error
     1300           or error-status :get-message(1) <> ""
     1301           then do:
     1302             undo move_block, retry move_block .
     1303           end.
     1304         end.
     1305         for each buf_temp-diasize-handle
     1306         on error undo move_block, retry move_block
     1307         :
     1308           assign
     1309             v-object-handle = buf_temp-diasize-handle.handle-value
     1310           .
     1311           if v-object-handle <> v-diasize-resize-button
     1312           then do:
     1313             assign
     1314               v-object-handle :col = v-object-handle :col + p-change-value
     1315               no-error .
     1316             if error-status :error
     1317             or error-status :get-message(1) <> ""
     1318             then do:
     1319               undo move_block, retry move_block .
     1320             end.
     1321           end.
     1322         end.
     1323       end.
     1324       else do:
     1325         for each buf_temp-diasize-handle
     1326         on error undo move_block, retry move_block
     1327         :
     1328           assign
     1329             v-object-handle = buf_temp-diasize-handle.handle-value
     1330           .
     1331           if v-object-handle <> v-diasize-resize-button
     1332           then do:
     1333             assign
     1334               v-object-handle :col = v-object-handle :col + p-change-value
     1335               no-error .
     1336             if error-status :error
     1337             or error-status :get-message(1) <> ""
     1338             then do:
     1339               undo move_block, retry move_block .
     1340             end.
     1341           end.
     1342         end.
     1343         for each buf_temp-browse-handle
     1344           where buf_temp-browse-handle.browse-type = 'width':u
     1345         on error undo move_block, retry move_block
     1346         :
     1347           assign
     1348             buf_temp-browse-handle.browse-handle :width
     1349               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1350             no-error .
     1351           if error-status :error
     1352           or error-status :get-message(1) <> ""
     1353           then do:
     1354             undo move_block, retry move_block .
     1355           end.
     1356         end.
     1357         assign
     1358           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1359           no-error .
     1360         if error-status :error
     1361         or error-status :get-message(1) <> ""
     1362         then do:
     1363           undo move_block, retry move_block.
     1364         end.
     1365         assign
     1366           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1367         no-error .
     1368         if error-status :error
     1369         or error-status :get-message(1) <> ""
     1370         then do:
     1371           undo move_block, retry move_block.
     1372         end.
     1373         if frame Dialog-Frame :scrollable = true
     1374         then do:
     1375           assign
     1376             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1377           no-error .
     1378           if error-status :error
     1379           or error-status :get-message(1) <> ""
     1380           then do:
     1381             undo move_block, retry move_block.
     1382           end.
     1383         end.
     1384       end.
     1385       if p-move-resize
     1386       then do:
     1387         run diasize_position-resize-button in this-procedure .
     1388       end.
     1389       if v-diasize-wndstore = true
     1390       then do:
     1391         if connected("ub") = true
     1392         then do:
     1393           define variable v-cntxt-db-num        as integer   no-undo .
     1394           define variable v-cntxt-userid        as character no-undo .
     1395           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1396                                             , OUTPUT v-cntxt-userid
     1397                                             ) .
     1398           run gbl/wndsizew.p
     1399             (input  v-cntxt-db-num
     1400             ,input  v-cntxt-userid
     1401             ,input  v-diasize-proc-name
     1402             ,input  'width':u
     1403             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1404             ) .
     1405         end.
     1406       end.
     1407     end.
     1408     assign
     1409       v-diasize-change-size = false
     1410     .
     1411   end procedure.
     1412   procedure diasize_set-width :
     1413     define input  parameter p-new-width  as decimal   no-undo .
     1414     define input  parameter p-move-resize as logical   no-undo .
     1415     do
     1416     on error undo, return error return-value
     1417     :
     1418       run diasize_change-width in this-procedure
     1419         (input  (p-new-width - frame Dialog-Frame :width)
     1420         ,input  p-move-resize
     1421         ) .
     1422     end.
     1423   end procedure.
     1424   procedure diasize_position-resize-button :
     1425     do with frame Dialog-Frame
     1426     :
     1427       hide v-diasize-resize-button .
     1428       assign
     1429         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1430                     - 1
     1431                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1432         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1433                     - 1
     1434                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1435       .
     1436       view v-diasize-resize-button .
     1437     end.
     1438   end procedure.
     1439   on alt-right anywhere
     1440   do:
     1441     run diasize_change-width in this-procedure
     1442       (input 1
     1443       ,input true
     1444       ) .
     1445     return no-apply .
     1446   end.
     1447   on alt-left anywhere
     1448   do:
     1449     run diasize_change-width in this-procedure
     1450       (input -1
     1451       ,input true
     1452       ) .
     1453     return no-apply .
     1454   end.
     1455   on alt-down anywhere
     1456   do:
     1457     run diasize_change-height in this-procedure
     1458       (input 1
     1459       ,input true
     1460       ) .
     1461     return no-apply .
     1462   end.
     1463   on alt-up anywhere
     1464   do:
     1465     run diasize_change-height in this-procedure
     1466       (input -1
     1467       ,input true
     1468       ) .
     1469     return no-apply .
     1470   end.
     1471   on alt-enter of frame Dialog-Frame
     1472   do:
     1473     run diasize_maximize in this-procedure
     1474       (input  ?
     1475       ).
     1476     return no-apply .
     1477   end.
     1478   procedure diasize_end-move :
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       define variable v-row-delta as decimal   no-undo .
     1483       define variable v-col-delta as decimal   no-undo .
     1484       define variable v-new-row as decimal   no-undo .
     1485       define variable v-new-col as decimal   no-undo .
     1486       assign
     1487         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1488         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1489       .
     1490       assign
     1491         v-row-delta = v-new-row - frame Dialog-Frame :height
     1492         v-col-delta = v-new-col - frame Dialog-Frame :width
     1493       .
     1494       run diasize_change-height in this-procedure
     1495         (input v-row-delta
     1496         ,input true
     1497         ) .
     1498       run diasize_change-width in this-procedure
     1499         (input v-col-delta
     1500         ,input true
     1501         ) .
     1502     end.
     1503   end procedure.
     1504   procedure diasize_maximize :
     1505     define input  parameter p-action as logical   no-undo .
     1506     do
     1507     on error undo, return error return-value
     1508     :
     1509       if p-action = ?
     1510       then do:
     1511         if v-diasize-need-maximize = true
     1512         then do:
     1513           assign
     1514             p-action = true
     1515           .
     1516         end.
     1517         else do:
     1518           assign
     1519             p-action = false
     1520           .
     1521         end.
     1522       end.
     1523       if p-action = true
     1524       then do:
     1525         run diasize_change-height in this-procedure
     1526           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1527               - frame Dialog-Frame :height-chars
     1528           ,input true
     1529           ) .
     1530         run diasize_change-width in this-procedure
     1531           (input session :width-chars
     1532               - frame Dialog-Frame :width-chars
     1533           ,input true
     1534           ) .
     1535         assign
     1536           v-diasize-need-maximize = false
     1537         .
     1538       end.
     1539       else do:
     1540         run diasize_change-width in this-procedure
     1541           (input v-diasize-orig-frame-width
     1542               - frame Dialog-Frame :width-chars
     1543           ,input true
     1544           ) .
     1545         run diasize_change-height in this-procedure
     1546           (input v-diasize-orig-frame-height
     1547               - frame Dialog-Frame :height-chars
     1548           ,input true
     1549           ) .
     1550         assign
     1551           v-diasize-need-maximize = true
     1552         .
     1553       end.
     1554     end.
     1555   end procedure.
     1556   procedure diasize_restore-orig-size :
     1557     do
     1558     on error undo, return error return-value
     1559     :
     1560       assign
     1561         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1562         v-diasize-current-frame-height = frame Dialog-Frame :height
     1563       .
     1564       run diasize_set-height in this-procedure
     1565         (input  v-diasize-orig-frame-height
     1566         ,input  true
     1567         ) .
     1568       run diasize_set-width in this-procedure
     1569         (input  v-diasize-orig-frame-width
     1570         ,input  true
     1571         ) .
     1572     end.
     1573   end procedure.
     1574   procedure diasize_restore-current-size :
     1575     do
     1576     on error undo, return error return-value
     1577     :
     1578       run diasize_set-height in this-procedure
     1579         (input  v-diasize-current-frame-height
     1580         ,input  true
     1581         ) .
     1582       run diasize_set-width in this-procedure
     1583         (input  v-diasize-current-frame-width
     1584         ,input  true
     1585         ) .
     1586     end.
     1587   end procedure.
     1588   procedure diasize_set-browse-handle :
     1589     define input  parameter p-browse-handle as handle   no-undo .
     1590     define buffer buf_temp-browse-handle for temp-browse-handle .
     1591     do
     1592     on error undo, return error return-value
     1593     :
     1594       assign
     1595         v-diasize-browse-handle = p-browse-handle
     1596       .
     1597       for each buf_temp-browse-handle
     1598       on error undo, return error return-value
     1599       :
     1600         delete buf_temp-browse-handle .
     1601       end.
     1602     end.
     1603   end procedure.
     1604   procedure diasize_add_browse :
     1605     define input  parameter p-browse-type   as character no-undo .
     1606     define input  parameter p-browse-handle as handle    no-undo .
     1607     define buffer buf_temp-browse-handle for temp-browse-handle .
     1608     do
     1609     on error undo, return error return-value
     1610     :
     1611       assign
     1612         v-diasize-browse-number = v-diasize-browse-number + 1
     1613       .
     1614       create buf_temp-browse-handle .
     1615       assign
     1616         buf_temp-browse-handle.browse-type   = p-browse-type
     1617         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1618         buf_temp-browse-handle.browse-handle = p-browse-handle
     1619       .
     1620     end.
     1621   end procedure.
     1622   procedure diasize_init :
     1623     define variable v-default-value    as logical   no-undo .
     1624     define variable v-restore-saved    as logical   no-undo .
     1625     define variable v-resize-value-str as character no-undo .
     1626     do
     1627     on error undo, return error return-value
     1628     :
     1629       do with frame Dialog-Frame
     1630       :
     1631         assign
     1632           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1633           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1634           v-diasize-browse-handle     = browse br-cli :handle
     1635         .
     1636         create button v-diasize-resize-button
     1637         assign
     1638           parent        = frame Dialog-Frame :first-child
     1639           label         = "s"
     1640           height-pixels = 16
     1641           width-pixels  = 16
     1642           visible       = true
     1643           sensitive     = true
     1644           movable       = true
     1645           triggers:
     1646             on end-move persistent run diasize_end-move in this-procedure .
     1647           end triggers.
     1648         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1649         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1650         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1651         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1652         assign
     1653           v-diasize-wndmax = false
     1654         .
     1655         if connected("ub") = true
     1656         then do:
     1657           define variable v-cntxt-db-num        as integer   no-undo .
     1658           define variable v-cntxt-userid        as character no-undo .
     1659           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1660                                             , OUTPUT v-cntxt-userid
     1661                                             ) .
     1662           run gbl/wndpar_r.p
     1663             (input  v-cntxt-db-num
     1664             ,input  v-cntxt-userid
     1665             ,input  'wndmax':U
     1666             ,output v-diasize-wndmax
     1667             ,output v-default-value
     1668             ) .
     1669         end.
     1670         assign
     1671           v-diasize-wndstore = false
     1672         .
     1673         if connected("ub") = true
     1674         then do:
     1675           run gbl/wndpar_r.p
     1676             (input  v-cntxt-db-num
     1677             ,input  v-cntxt-userid
     1678             ,input  'wndstore':U
     1679             ,output v-diasize-wndstore
     1680             ,output v-default-value
     1681             ) .
     1682         end.
     1683         assign
     1684           v-diasize-proc-name = entry(1, program-name(2), '.')
     1685         .
     1686         if v-diasize-wndstore = true
     1687         then do:
     1688           assign
     1689             v-restore-saved = false
     1690           .
     1691           if connected("ub") = true
     1692           then do:
     1693             run gbl/wndsizer.p
     1694               (input  v-cntxt-db-num
     1695               ,input  v-cntxt-userid
     1696               ,input  v-diasize-proc-name
     1697               ,input  'height':u
     1698               ,output v-resize-value-str
     1699               ) .
     1700             if v-resize-value-str <> '':U
     1701             then do:
     1702               run diasize_change-height in this-procedure
     1703                 (input  integer(v-resize-value-str)
     1704                 ,input  true
     1705                 ) .
     1706               assign
     1707                 v-restore-saved = true
     1708               .
     1709             end.
     1710           end.
     1711           if connected("ub") = true
     1712           then do:
     1713             run gbl/wndsizer.p
     1714               (input  v-cntxt-db-num
     1715               ,input  v-cntxt-userid
     1716               ,input  v-diasize-proc-name
     1717               ,input  'width':u
     1718               ,output v-resize-value-str
     1719               ) .
     1720             if v-resize-value-str <> '':U
     1721             then do:
     1722               run diasize_change-width in this-procedure
     1723                 (input  integer(v-resize-value-str)
     1724                 ,input  true
     1725                 ) .
     1726               assign
     1727                 v-restore-saved = true
     1728               .
     1729             end.
     1730           end.
     1731           if v-restore-saved <> true
     1732           then do:
     1733             if v-diasize-wndmax = true
     1734             then do:
     1735               run diasize_maximize in this-procedure
     1736                 (input  true
     1737                 ) .
     1738             end.
     1739           end.
     1740         end.
     1741         else do:
     1742           if v-diasize-wndmax = true
     1743           then do:
     1744             run diasize_maximize in this-procedure
     1745               (input  true
     1746               ) .
     1747           end.
     1748         end.
     1749       end.
     1750     end.
     1751   end procedure.
     1752   procedure diasize_need-full-display :
     1753     define output parameter p-need-full-display as logical   no-undo .
     1754     do
     1755     on error undo, return error return-value
     1756     :
     1757       assign
     1758         p-need-full-display = v-diasize-need-full-display
     1759       .
     1760       assign
     1761         v-diasize-need-full-display = false
     1762       .
     1763     end.
     1764   end procedure.
     1765   procedure get-context :
     1766      define output parameter p-db-num as integer          no-undo.
     1767      define output parameter p-user-id as character        no-undo.
     1768      define variable v-login               as character    no-undo.
     1769      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1770      define buffer buf_user-login  for ub.user-login .
     1771      do
     1772      on error undo, return error
     1773      :
     1774            FIND FIRST buf_sys-ctrl no-lock.
     1775            ASSIGN
     1776               v-login = USERID("ub")
     1777               p-db-num = buf_sys-ctrl.db-num
     1778            .
     1779            FIND FIRST buf_user-login
     1780                 WHERE buf_user-login.db-num = p-db-num
     1781                   AND buf_user-login.user-login = v-login
     1782                 no-lock
     1783                 no-error
     1784                 .
     1785            IF AVAILABLE buf_user-login
     1786            THEN DO:
     1787               assign
     1788                  p-user-id = buf_user-login.user-id
     1789               .
     1790            END.
     1791      end.
     1792   end procedure.
     1793       run diasize_init in this-procedure .
     1794   MAIN-BLOCK:
     1795   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1796      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1797     define buffer buf_sys-ctrl for ub.sys-ctrl .
     1798     find first buf_sys-ctrl no-lock .
     1799     if buf_sys-ctrl.db-num <> 0 then do:
     1800       message
     1801         vss-workfile vss-revision vss-description skip
     1802         substitute( "Данная утилита предназначена для работы только в ГБД" ) skip
     1803         view-as alert-box error
     1804       .
     1805       return error .
     1806     end.
     1807     RUN enable_UI.
     1808     WAIT-FOR GO OF FRAME Dialog-Frame.
     1809   END.
     1810   RUN disable_UI.
     1811   PROCEDURE check-qnty :
     1812   END PROCEDURE.
     1813   PROCEDURE delete-object :
     1814     define input  parameter p-obj-list          as character no-undo .
     1815     define input  parameter p-action            as character no-undo .
     1816     do
     1817     on error undo, return error return-value
     1818     :
     1819       define variable v-ok           as logical   no-undo .
     1820       define variable v-num          as integer   no-undo .
     1821       define variable v-check-string as character no-undo .
     1822       define variable v-passwd       as character no-undo .
     1823       define variable v-pswd-list    as character no-undo .
     1824       if p-action = "inquiry":U
     1825         and p-obj-list = "":U
     1826       then do:
     1827         message
     1828           substitute("Для запроса необходим список объектов") skip
     1829           view-as alert-box error .
     1830         return error .
     1831       end.
     1832       if p-action = "delete":U
     1833         and p-obj-list <> "":U
     1834       then do:
     1835         message
     1836           substitute("При удалении список объектов должен быть пустым. Он будет взят из файла.") skip
     1837           view-as alert-box error .
     1838         return error .
     1839       end.
     1840       assign
     1841         v-pswd-list = "":U
     1842       .
     1843       run gbl/d-askw.w
     1844         (input "Удаление объекта(ов)"
     1845         ,input "Вы хотите удалить объект(ы)." + chr(10)
     1846           + substitute("&1", p-obj-list) + chr(10)
     1847           + "Вы действительно хотите сделать это?" + chr(10)
     1848         ,input "|^"
     1849         ,input "С проверкой остатков^confirm|Без проверки остатков^confirm|Отказ"
     1850         ,input "|"
     1851             + "|"
     1852             + ""
     1853         ,input 1
     1854         ,input 3
     1855         ,output v-num
     1856         ).
     1857       define variable v-check-rest as logical   no-undo .
     1858       case v-num :
     1859         when 1 then do:
     1860           assign
     1861             v-check-rest = true
     1862           .
     1863         end.
     1864         when 2 then do:
     1865           assign
     1866             v-check-rest = false
     1867           .
     1868         end.
     1869         when 3 then do:
     1870           undo, return error return-value .
     1871         end.
     1872         otherwise do:
     1873           message
     1874             "" skip
     1875             view-as alert-box error .
     1876           undo, return error return-value .
     1877         end.
     1878       end.
     1879       define variable v-file-name as character no-undo .
     1880       assign
     1881         v-file-name = substitute('del-obj-&1.txt':u
     1882                                  , string( today, "99999999" )
     1883                                 )
     1884       .
     1885       run gbl/d-prompt.w (
     1886           'title=':u + "Введите имя файла с паролем " + '\':u
     1887         + 'text1=':u + "Введите имя файла с паролем на право удаления объекта" + '\':u
     1888         + 'format=X(256)\':u
     1889         + 'type=char\':u
     1890         + 'boxprog=gbl/getfile.p\':u
     1891         ,input-output v-file-name
     1892         ).
     1893       if return-value = 'false':u then do:
     1894         return .
     1895       end.
     1896       case p-action :
     1897         when "delete":U then do:
     1898           if  search(v-file-name) <> ""
     1899           and search(v-file-name) <> ?
     1900           then do:
     1901             assign
     1902               v-pswd-list = "":U
     1903               p-obj-list  = "":U
     1904             .
     1905             input stream slog from value(v-file-name) .
     1906             block_read:
     1907             repeat
     1908             on error undo block_read, leave block_read
     1909             on end-key undo block_read, leave block_read
     1910             :
     1911               import stream slog unformatted v-check-string .
     1912               import stream slog unformatted v-passwd .
     1913               if num-entries( v-check-string, chr(44) ) > 3
     1914                 and num-entries( v-passwd, chr(44) ) = 1
     1915                 and v-passwd <> "":U
     1916               then do:
     1917                 assign
     1918                   p-obj-list  = p-obj-list + chr(44) + entry( 2, v-check-string, chr(44) ) + chr(44) + entry( 3, v-check-string, chr(44) )
     1919                   v-pswd-list = v-pswd-list + chr(44) + v-passwd
     1920                 .
     1921               end.
     1922             end.
     1923             input stream slog close .
     1924             assign
     1925               p-obj-list  = substring( p-obj-list, 2, length( p-obj-list ) - 1 )
     1926               v-pswd-list = substring( v-pswd-list, 2, length( v-pswd-list ) - 1 )
     1927             .
     1928             if v-passwd = "" then do:
     1929               message
     1930                 "В файле не указан пароль для удаления объекта" skip
     1931                 "Отправте файл в службу поддержки пользователей" skip
     1932                 "Файл параметров" v-file-name skip
     1933                 view-as alert-box error .
     1934             end.
     1935           end.
     1936           else do:
     1937             message
     1938               substitute("Файл &1 не найден", v-file-name) skip
     1939               view-as alert-box error .
     1940             return .
     1941           end.
     1942         end.
     1943       end case.
     1944       run utl/del-obj.p
     1945         (input p-obj-list
     1946         ,input v-check-rest
     1947         ,input v-pswd-list
     1948         ,input v-file-name
     1949         ) .
     1950       case p-action :
     1951         when "inquiry":U then do:
     1952           message
     1953             "Создан файл для получения пароля удаления объекта" skip
     1954             "Отправьте файл" v-file-name skip
     1955             view-as alert-box information .
     1956         end.
     1957         when "delete":U then do:
     1958           message
     1959             substitute("Объект(ы) удалены") skip
     1960             view-as alert-box information .
     1961         end.
     1962       end case.
     1963       run reopen-query in this-procedure .
     1964     end.
     1965   END PROCEDURE.
     1966   PROCEDURE disable_UI :
     1967     HIDE FRAME Dialog-Frame.
     1968   END PROCEDURE.
     1969   PROCEDURE enable_UI :
     1970     DISPLAY mark-num
     1971         WITH FRAME Dialog-Frame.
     1972     ENABLE Btn_Cancel b-mark b-inq b-del b-help br-cli
     1973         WITH FRAME Dialog-Frame.
     1974     VIEW FRAME Dialog-Frame.
     1975     OPEN QUERY br-cli FOR EACH ub.clients       WHERE ( ( clients.obj-type = 'маг':U     and clients.obj-code > 0    )   OR   ( clients.obj-type = 'скл':U     and clients.obj-code > 0    ) ) NO-LOCK.
     1976   END PROCEDURE.
     1977   PROCEDURE reopen-query :
     1978     define variable v-recid as recid     no-undo .
     1979     do
     1980     on error undo, return error return-value
     1981     :
     1982       do with frame Dialog-Frame:
     1983         get prev br-cli .
     1984         if available ub.clients then do:
     1985           assign
     1986             v-recid = recid(ub.clients)
     1987           .
     1988         end.
     1989         else do:
     1990           get first br-cli.
     1991           assign
     1992             v-recid = recid(ub.clients)
     1993           .
     1994         end.
     1995         OPEN QUERY br-cli FOR EACH ub.clients       WHERE ( ( clients.obj-type = 'маг':U     and clients.obj-code > 0    )   OR   ( clients.obj-type = 'скл':U     and clients.obj-code > 0    ) ) NO-LOCK.
     1996         reposition br-cli to recid v-recid no-error.
     1997         apply "entry":u to br-cli.
     1998         apply "value-changed":u to br-cli.
     1999       end.
     2000     end.
     2001   END PROCEDURE.
