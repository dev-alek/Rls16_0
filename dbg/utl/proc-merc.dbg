        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   define variable mError as logical no-undo.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64     define variable v-cntxt-db-num        as integer   no-undo .
       65     define variable v-cntxt-userid        as character no-undo .
       66     define variable v-cntxt-level         as character no-undo .
       67     define variable v-cntxt-host-code-obj as integer   no-undo .
       68     define variable v-cntxt-obj-type      as character no-undo .
       69     define variable v-cntxt-obj-code      as integer   no-undo .
       70     define variable v-cntxt-db-num-obj    as integer   no-undo .
       71     define variable v-cntxt-is-admin      as logical   no-undo .
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define new  shared variable g#auto as logical no-undo.
       79   define new  shared variable g#news as logical no-undo.
       80   define new  shared variable g#oxml as logical no-undo.
       81   define new  shared variable g#esys as logical no-undo.
       82   define new  shared variable g#news-source-db as integer no-undo.
       83   define new  shared variable g#esys-source-esys as integer no-undo.
       84   define new  shared variable g#db-num as integer   no-undo .
       85   define new  shared variable g#userid as character no-undo .
       86   define new  shared variable g#passwd as character no-undo .
       87   define variable mAsyncProc as class ibs.th.file.AsyncProc.
       88   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       89   define variable mstopAsunc as logical no-undo.
       90   function StopCheck returns logical:
       91      define variable oFlag as logical no-undo.
       92      run StopCheckAsync (output oFlag).
       93      return oFlag.
       94   end.
       95   procedure StopCheckAsync:
       96       define output  parameter oFlag as logical no-undo.
       97       if mstopAsunc
       98       then
       99          oFlag = mstopAsunc.
      100       else do:
      101          oFlag = mAsyncProc:CheckStop().
      102          mstopAsunc = oFlag.
      103       end.
      104   end.
      105   function GetParamAsunc returns character
      106   (input iNumPar as integer  ):
      107      return mAsyncProc:GetPARAM(iNumPar).
      108   end.
      109   function GetParamAsuncStr returns ibs.th.file.asyncparam
      110   (input iParamName as character ):
      111      return mAsyncProc:GetPARAM(iParamName).
      112   end.
      113   procedure PutMesAsunc:
      114       define input  parameter Itext as character no-undo.
      115       define variable vflag as logical no-undo.
      116       Publish "WriteLogAsunc" (Itext, yes)  .
      117   end.
      118   procedure PutMesAsuncNoTime:
      119       define input  parameter Itext as character no-undo.
      120       define variable vflag as logical no-undo.
      121       Publish "WriteLogAsunc" (Itext,no)  .
      122   end.
      123   procedure PutStatAsunc:
      124       define input  parameter Itext as character no-undo.
      125       Publish "PutStatAsunc" (Itext,no) .
      126        run
      127       PutMesAsunc (itext).
      128   end.
      129   procedure PutStatAsuncNoTime:
      130       define input  parameter Itext as character no-undo.
      131       Publish "PutStatAsunc" (Itext,no)  .
      132        run
      133       PutMesAsuncNoTime (itext).
      134   end.
      135   procedure PutStatAsuncAdd:
      136       define input  parameter Itext as character no-undo.
      137       Publish "PutStatAsunc" (Itext,yes)  .
      138   end.
      139   procedure PutFileLogAsunc:
      140       define input  parameter IFile as character no-undo.
      141       Publish "PutFileLogAsunc" (ifile)  .
      142   end.
      143          mAsyncProc:mProcPublish = this-procedure.
      144   define variable mParam as character no-undo.
      145   mParam = GetPARAMAsunc( 1).
      146   if mParam eq ? then do:
      147      run PutstatAsunc( "error   Получение данных было преврвано пользователем." ).
      148   end.
      149   else do:
      150      if mParam eq "*"
      151      then do:
      152         for each db no-lock:
      153            mParam = (if mParam eq "*" then "" else ( mParam + ",")) + string(db.db-num).
      154         end.
      155      end.
      156      run bge\auto-merc.p(this-procedure, mParam) no-error.
      157      if error-status:error
      158      then
      159         run PutstatAsunc( "error  Произошли ошибки при выполнение."  ).
      160      if    StopCheck()
      161      then do:
      162         run PutstatAsunc( "error   Получение данных было преврвано пользователем." ).
      163      end.
      164   end.
