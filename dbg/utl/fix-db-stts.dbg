        1   define input parameter parparentproc as widget-handle no-undo .
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   DEFINE BUTTON b-cancel AUTO-END-KEY
        7        LABEL "Отмена"
        8        SIZE 15 BY 1.14
        9        BGCOLOR 8 .
       10   DEFINE BUTTON b-ok AUTO-GO
       11        LABEL "Ввод"
       12        SIZE 15 BY 1.14
       13        BGCOLOR 8 .
       14   DEFINE VARIABLE f-db AS CHARACTER FORMAT "X(256)":U
       15        VIEW-AS FILL-IN
       16        SIZE 31 BY 1 NO-UNDO.
       17   DEFINE FRAME Dialog-Frame
       18        f-db AT ROW 1.95 COL 3 COLON-ALIGNED NO-LABEL WIDGET-ID 2
       19        b-ok AT ROW 3.38 COL 5
       20        b-cancel AT ROW 3.38 COL 21
       21        SPACE(3.99) SKIP(0.76)
       22       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       23            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       24            TITLE "Введите номер БД"
       25            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
       26   ASSIGN
       27          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       28          FRAME Dialog-Frame:HIDDEN           = TRUE.
       29   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       30   DO:
       31     APPLY "END-ERROR":U TO SELF.
       32   END.
       33   ON choose OF b-ok IN FRAME Dialog-Frame
       34   do :
       35     find first ub.db exclusive-lock where ub.db.db-num = integer(f-db) no-error.
       36     if not available ub.db
       37     then do :
       38       Message "База Данных с номером " f-db " не найдена" view-as alert-box.
       39       return no-apply.
       40     end.
       41     else do :
       42       ub.db.stts = 0 .
       43       Message "Готово" view-as alert-box.
       44     end.
       45   end .
       46   ON leave OF f-db IN FRAME Dialog-Frame
       47   do :
       48     assign frame Dialog-Frame f-db .
       49     integer(f-db) no-error .
       50     if error-status:error
       51     then do :
       52       message "Номер БД введен не верно!" view-as alert-box .
       53       apply "entry" to f-db in frame Dialog-Frame .
       54       return no-apply .
       55     end .
       56   end .
       57   ON return OF f-db IN FRAME Dialog-Frame
       58   do :
       59     assign frame Dialog-Frame f-db .
       60     integer(f-db) no-error .
       61     if error-status:error
       62     then do :
       63       message "Номер БД введен не верно!" view-as alert-box .
       64       apply "entry" to f-db in frame Dialog-Frame .
       65       return no-apply .
       66     end .
       67     apply "choose" to b-ok in frame Dialog-Frame .
       68   end .
       69   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       70   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       71   MAIN-BLOCK:
       72   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       73      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       74     RUN enable_UI.
       75     WAIT-FOR GO OF FRAME Dialog-Frame.
       76   END.
       77   RUN disable_UI.
       78   PROCEDURE disable_UI :
       79     HIDE FRAME Dialog-Frame.
       80   END PROCEDURE.
       81   PROCEDURE enable_UI :
       82     DISPLAY f-db
       83         WITH FRAME Dialog-Frame.
       84     ENABLE f-db b-ok b-cancel
       85         WITH FRAME Dialog-Frame.
       86     VIEW FRAME Dialog-Frame.
       87   END PROCEDURE.
