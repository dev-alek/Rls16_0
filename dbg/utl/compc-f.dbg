        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: compc-f.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/compc-f.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable loc#log as logical no-undo .
       78   define variable v-msg as character no-undo .
       79   define variable v-silence as logical no-undo init yes.
       80   define variable v-log-file as character no-undo .
       81   define variable v-err-file as character no-undo .
       82   define variable v-field-result as character no-undo .
       83   define variable v-field-failed as character no-undo .
       84   define variable jj as integer no-undo .
       85   define buffer buf1_file for _file.
       86   define buffer buf2_file for _file.
       87   define buffer buf1_field for _field.
       88   define buffer buf2_field for _field.
       89   define stream logstream.
       90   function get-property returns character  ( buffer loc_field for _field, input p-property-name as character ) :
       91   define variable v-property-value as character no-undo .
       92   case p-property-name:
       93     when "_data-type" then do:
       94       assign
       95       v-property-value = loc_field._data-type
       96       .
       97     end.
       98     when "_dtype" then do:
       99       assign
      100       v-property-value = string(loc_field._dtype)
      101       .
      102     end.
      103     when "_initial" then do:
      104       assign
      105       v-property-value = if loc_field._initial = ? then chr(63) else loc_field._initial
      106       .
      107     end.
      108     when "_label" then do:
      109       assign
      110       v-property-value = loc_field._label
      111       .
      112     end.
      113     when "_mandatory" then do:
      114       assign
      115       v-property-value = if loc_field._mandatory then "yes" else "no"
      116       .
      117     end.
      118     when "_decimals" then do:
      119       assign
      120       v-property-value = if loc_field._decimals = ? then chr(63) else string(loc_field._decimals)
      121       .
      122     end.
      123     when "_desc" then do:
      124       assign
      125       v-property-value = loc_field._desc
      126       .
      127     end.
      128   end case.
      129   return v-property-value.
      130   end function.
      131   message
      132   "Вы действительно хотите сравнить структуры таблиц,"
      133   "в которых хранятся документы и удаленные документы"
      134   view-as alert-box question buttons yes-no update loc#log.
      135   if not loc#log then do:
      136     return.
      137   end.
      138   message
      139   "Сооьщать о каждой обнаруженной ошибке или выводить результаты сравнения только в log и err"
      140   "в которых хранятся документы и удаленные документы"
      141   view-as alert-box question buttons yes-no update loc#log.
      142   if not loc#log then do:
      143     assign
      144     v-silence = no
      145     .
      146   end.
      147   assign
      148   v-log-file = "compc-f.log"
      149   v-err-file = "compc-f.err"
      150   .
      151   run set-file-title in this-procedure (v-log-file).
      152   run set-file-title in this-procedure (v-err-file).
      153   for each buf2_file no-lock where
      154            buf2_file._file-name begins "c-":u:
      155     find first buf1_file no-lock where
      156                buf1_file._file-name = substr(buf2_file._file-name, 3) no-error .
      157     if not available buf1_file then do:
      158       assign
      159       v-msg = "Не найдена исходная таблица к таблице" + chr(32) + buf2_file._file-name
      160       .
      161       run write-err in this-procedure (v-msg).
      162       assign
      163       v-msg = "Ошибка в таблице" + chr(32) + buf2_file._file-name
      164       .
      165       run write-log in this-procedure (v-msg).
      166       next.
      167     end.
      168     _ffield:
      169     for each buf1_field no-lock where
      170              buf1_field._file-recid = recid(buf1_file):
      171       find first buf2_field no-lock where
      172                  buf2_field._file-recid = recid(buf2_file)
      173             and buf2_field._field-name = buf1_field._field-name no-error .
      174       if not available buf2_field then do:
      175         assign
      176         v-msg = "Не найдено поле" + chr(32) + buf1_field._field-name + chr(32) +
      177                 "в таблице" + chr(32) + buf2_file._file-name
      178         .
      179         run write-err in this-procedure (v-msg).
      180         assign
      181         v-msg = "Ошибка в таблице" + chr(32) + buf2_file._file-name
      182         .
      183         run write-log in this-procedure (v-msg).
      184         next _ffield.
      185       end.
      186       assign
      187       v-field-result = "":u
      188       .
      189       buffer-compare buf1_field using
      190       _data-type _dtype _mandatory _decimals
      191       to buf2_field
      192       save result in v-field-result no-error .
      193       if v-field-result <> "":u then do:
      194         do jj = 1 to num-entries(v-field-result):
      195           assign
      196           v-field-failed = v-field-failed + chr(10) +
      197                           "реквизит" + chr(32) + entry(jj, v-field-result) + chr(32) +
      198                           get-property(buffer buf2_field, entry(jj, v-field-result)) + chr(32) + "должно быть" + chr(32) +
      199                           get-property(buffer buf1_field, entry(jj, v-field-result))
      200           .
      201         end.
      202         assign
      203         v-msg = "Ошибка в поле" + chr(32) + buf2_field._field-name +
      204                 "в таблице" + chr(32) + buf2_file._file-name + chr(10) + v-field-failed
      205         .
      206         run write-err in this-procedure (v-msg).
      207         assign
      208         v-msg = "Ошибка в таблице" + chr(32) + buf2_file._file-name +
      209                 chr(32) + "поле" + chr(32) + buf2_field._field-name
      210         .
      211         run write-log in this-procedure (v-msg).
      212         next _ffield.
      213       end.
      214     end.
      215   end.
      216   procedure write-err :
      217   define input parameter p-msg as character no-undo .
      218     do
      219     on error undo, return error
      220     :
      221       if not v-silence then do:
      222         message
      223         p-msg
      224         view-as alert-box error .
      225       end.
      226       if v-err-file <> "":u then do:
      227         output stream logstream to value(v-err-file) append.
      228         put stream logstream unformatted
      229         p-msg skip.
      230         output stream logstream close.
      231       end.
      232     end.
      233   end procedure.
      234   procedure write-log :
      235   define input parameter p-msg as character no-undo .
      236     do
      237     on error undo, return error
      238     :
      239       if not v-silence then do:
      240         message
      241         p-msg
      242         view-as alert-box error .
      243       end.
      244       if v-log-file <> "":u then do:
      245         output stream logstream to value(v-log-file) append.
      246         put stream logstream unformatted
      247         p-msg skip.
      248         output stream logstream close.
      249       end.
      250     end.
      251   end procedure.
      252   procedure set-file-title :
      253   define input parameter p-filename as character no-undo.
      254   define variable v-today as date no-undo.
      255   define variable v-time as integer no-undo.
      256   output stream logstream to value(p-filename) append.
      257   put stream logstream unformatted
      258   "**************************************************" skip
      259   "user:":u g#userid skip
      260   string(today, "99/99/9999") chr(32) string(time, "hh:mm:ss")
      261   skip.
      262   output stream logstream close.
      263   end procedure.
