        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as   handle               no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: trncstcp.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/trncstcp.p $":U .
        8   define variable vss-description as character no-undo init "Выбор документов и простановка кода ГТД ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   function octal-to-char return character
       69   ( p-string as character ) :
       70     def var v-asc     as integer no-undo .
       71     def var v-new-asc as integer no-undo .
       72     def var ind       as integer no-undo .
       73     if length(p-string) <> 3 then do:
       74       return ? .
       75     end.
       76     assign
       77       v-asc = 0
       78     .
       79     do ind = 1 to length(p-string)
       80     :
       81       assign
       82         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
       83       .
       84       if v-new-asc < 0 or v-new-asc >= 8 then do:
       85         return ? .
       86       end.
       87       assign
       88         v-asc = v-asc * 8 + v-new-asc
       89       .
       90     end.
       91     return chr(v-asc) .
       92   end function .
       93   function char-to-octal return character
       94   ( p-chr as character ) :
       95     def var v-asc    as integer   no-undo .
       96     def var ind      as integer   no-undo .
       97     def var v-string as character no-undo .
       98     if length(p-chr) <> 1 then do:
       99       return ? .
      100     end.
      101     assign
      102       v-asc    = asc(p-chr)
      103       v-string = ""
      104     .
      105     do ind = 1 to 3
      106     :
      107       assign
      108         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      109       .
      110       assign
      111         v-asc = truncate(v-asc / 8, 0)
      112       .
      113     end.
      114     return v-string .
      115   end.
      116   function str-encode return character
      117   (   p-init-string       as character
      118     , p-encode-char       as character
      119     , p-special-char-list as character
      120   ) :
      121     def var p-encode-string as character no-undo .
      122     def var ind                as integer no-undo .
      123     def var v-num-special-char as integer no-undo .
      124     def var v-special-char     as character no-undo .
      125     if p-encode-char = ?
      126     or p-encode-char = "" then do:
      127       assign
      128         p-encode-char = "~~"
      129       .
      130     end.
      131     if p-init-string = ? then do:
      132       return "?" .
      133     end.
      134     if p-init-string = "?" then do:
      135       return p-encode-char + char-to-octal("?") .
      136     end.
      137     assign
      138       v-num-special-char = length(p-special-char-list)
      139       p-encode-string    = replace(p-init-string
      140                                   ,p-encode-char
      141                                   ,p-encode-char + char-to-octal(p-encode-char)
      142                                   )
      143     .
      144     do ind = 1 to v-num-special-char
      145     :
      146       assign
      147         v-special-char = substring(p-special-char-list, ind, 1)
      148       .
      149       if v-special-char <> p-encode-char then do:
      150         assign
      151           p-encode-string = replace (p-encode-string
      152                                     ,v-special-char
      153                                     ,p-encode-char + char-to-octal(v-special-char)
      154                                     )
      155         .
      156       end.
      157     end.
      158     return p-encode-string .
      159   end.
      160   function str-decode returns character
      161     (p-init-string   as character
      162     ,p-encode-char   as character
      163     ) :
      164     def var p-decode-string as character no-undo .
      165     def var ind                       as integer no-undo .
      166     def var v-num-entries-init-string as integer no-undo .
      167     def var v-sub-phrase              as character no-undo .
      168     def var v-special-char            as character no-undo .
      169     if p-encode-char = ?
      170     or p-encode-char = "" then do:
      171       assign
      172         p-encode-char = "~~"
      173       .
      174     end.
      175     if p-init-string = "?" then do:
      176       return ? .
      177     end.
      178     assign
      179       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      180     .
      181     if v-num-entries-init-string > 1 then do:
      182       assign
      183         p-decode-string = entry(1, p-init-string, p-encode-char)
      184       .
      185       do ind = 2 to v-num-entries-init-string
      186       :
      187         assign
      188           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      189         .
      190         assign
      191           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      192         .
      193         if v-special-char <> ? then do:
      194           assign
      195             p-decode-string = p-decode-string
      196                             + v-special-char
      197                             + substring(v-sub-phrase, 4)
      198           .
      199         end.
      200         else do:
      201           assign
      202             p-decode-string = p-decode-string
      203                             + p-encode-char
      204                             + v-sub-phrase
      205           .
      206         end.
      207       end.
      208     end.
      209     else do:
      210       assign
      211         p-decode-string = p-init-string
      212       .
      213     end.
      214     return p-decode-string .
      215   end.
      216   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      217     define variable v-cntxt-db-num        as integer   no-undo .
      218     define variable v-cntxt-userid        as character no-undo .
      219     define variable v-cntxt-level         as character no-undo .
      220     define variable v-cntxt-host-code-obj as integer   no-undo .
      221     define variable v-cntxt-obj-type      as character no-undo .
      222     define variable v-cntxt-obj-code      as integer   no-undo .
      223     define variable v-cntxt-db-num-obj    as integer   no-undo .
      224     define variable v-cntxt-is-admin      as logical   no-undo .
      225   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      226     run mainmenu_getcntxt in parparentproc
      227       (output v-cntxt-db-num
      228       ,output v-cntxt-userid
      229       ,output v-cntxt-level
      230       ,output v-cntxt-host-code-obj
      231       ,output v-cntxt-obj-type
      232       ,output v-cntxt-obj-code
      233       ,output v-cntxt-db-num-obj
      234       ,output v-cntxt-is-admin
      235       ) .
      236   define buffer buf_trn-doc for ub.trn-doc .
      237   define variable v-update-ind as integer no-undo .
      238   define variable v-skip-ind   as integer no-undo .
      239   define variable lok as logical no-undo .
      240   define variable loc-ref-list as character no-undo .
      241   define variable v-doc-rec    as integer   no-undo .
      242   do
      243   on error undo, return error
      244   :
      245     assign
      246       lok = false
      247     .
      248     message
      249       "Программа обновления ГТД в приходном документе на основании расходного документа" skip
      250       "Сначала необходимо выбрать приходный документ." skip
      251       "Затем расходный." skip
      252       "ВНИМАНИЕ! Информация о ГТД в других базах данных не будет изменена." skip
      253       "Продолжить?"
      254       view-as alert-box question buttons yes-no update lok .
      255     if lok <> true then do:
      256       return .
      257     end.
      258     run str/all-docs.w
      259       (input parparentproc
      260       ,input v-cntxt-host-code-obj
      261       ,input v-cntxt-obj-type
      262       ,input v-cntxt-obj-code
      263       ,input 'ТИП':U
      264       ,input 'факт':U
      265       ,input 'при':U
      266       ,input ?
      267       ,input false
      268       ,input "b-sel":U
      269       ,input 'ie':U
      270       ,input no
      271       ,input ?
      272       ,output loc-ref-list
      273       ).
      274     assign
      275       v-doc-rec = integer(entry(1, loc-ref-list))
      276     .
      277     find trn-doc no-lock
      278       where recid (trn-doc) = v-doc-rec
      279       no-error .
      280     if not available trn-doc then do:
      281       return .
      282     end.
      283     run str/all-docs.w
      284       (input parparentproc
      285       ,input ?
      286       ,input ?
      287       ,input ?
      288       ,input 'работа':U
      289       ,input ?
      290       ,input ?
      291       ,input ?
      292       ,input ?
      293       ,input "b-sel":U
      294       ,input ?
      295       ,input no
      296       ,input ?
      297       ,output loc-ref-list
      298       ).
      299     assign
      300       v-doc-rec = integer(entry(1, loc-ref-list))
      301     .
      302     find buf_trn-doc no-lock
      303       where recid (buf_trn-doc) = v-doc-rec
      304       no-error .
      305     if not available buf_trn-doc then do:
      306       return .
      307     end.
      308     assign
      309       lok = false
      310     .
      311     message
      312       "Вы выбрали следующие документы" skip
      313       "Приходный" ub.trn-doc.doc-code skip
      314       "Расходный" buf_trn-doc.doc-code skip
      315       "Будем скопирована информация о ГТД" skip
      316       ub.trn-doc.doc-code "<---" buf_trn-doc.doc-code skip
      317       "Продолжить?"
      318       view-as alert-box question buttons yes-no update lok .
      319     if lok <> true then do:
      320       return .
      321     end.
      322     run copy-doc-cst in this-procedure
      323       (input ub.trn-doc.doc-code
      324       ,input buf_trn-doc.doc-code
      325       ).
      326     message
      327       "Информация о ГТД скопирована" skip
      328       "Приходный документ" ub.trn-doc.doc-code skip
      329       "Обновлено партий" v-update-ind skip
      330       "Не обновлено партий" v-skip-ind skip
      331       view-as alert-box information .
      332   end.
      333   procedure copy-doc-cst :
      334     do
      335     on error undo, return error
      336     :
      337       define input parameter p-input-doc-code   like ub.trn-doc.doc-code no-undo .
      338       define input parameter p-expense-doc-code like ub.trn-doc.doc-code no-undo .
      339       define buffer buf_trn-doc     for ub.trn-doc .
      340       define buffer expense_trn-doc for ub.trn-doc .
      341       define buffer buf_parts       for ub.parts .
      342       define buffer expense_parts   for ub.parts .
      343       find first buf_trn-doc no-lock
      344         where buf_trn-doc.doc-code = p-input-doc-code
      345         .
      346       find first expense_trn-doc no-lock
      347         where expense_trn-doc.doc-code = p-expense-doc-code
      348         .
      349       for each buf_parts exclusive-lock
      350         where buf_parts.out-code = p-input-doc-code
      351       on error undo, return error
      352       :
      353         find first expense_parts no-lock
      354           where expense_parts.out-code  = p-expense-doc-code
      355             and expense_parts.obj-type  = expense_trn-doc.obj-type
      356             and expense_parts.obj-code  = expense_trn-doc.obj-code
      357             and expense_parts.artic     = buf_parts.artic
      358             and expense_parts.prod-type = buf_parts.prod-type
      359             and expense_parts.prod-code = buf_parts.prod-code
      360             and expense_parts.part-code = buf_parts.part-code
      361             and expense_parts.cst-code  <> ""
      362           no-error .
      363         if available expense_parts then do:
      364           assign
      365             v-update-ind = v-update-ind + 1
      366           .
      367           run trg/partcst.p
      368             (input expense_parts.cst-code
      369             ,input buf_parts.in-code
      370             ,input buf_parts.artic
      371             ,input buf_parts.prod-type
      372             ,input buf_parts.prod-code
      373             ,input buf_parts.part-code
      374             ) no-error .
      375           if error-status :error then do:
      376             message
      377               vss-workfile vss-revision vss-description skip
      378               "Ошибка при вызове процедуры partcst.p" skip
      379               error-status :get-message(1) skip
      380               return-value skip
      381               view-as alert-box error .
      382             undo, return error .
      383           end.
      384         end.
      385         else do:
      386           assign
      387             v-skip-ind = v-skip-ind + 1
      388           .
      389         end.
      390       end.
      391     end.
      392   end procedure.
