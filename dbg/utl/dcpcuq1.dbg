     1026   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   define NEW SHARED temp-table temp-update-rule no-undo
     1028   field table-name as character
     1029   field table-id as integer
     1030   field field-name as character
     1031   field bh as handle
     1032   field pk as character
     1033   field gen-id as integer
