     1053   .
     1054   procedure gen-temp-row-keyr :
     1055     define input  parameter p-key-rec  as character no-undo.
     1056     define input  parameter p-prefix   as character no-undo .
     1057     define output parameter p-tbl-row  as rowid     no-undo.
     1058     do
     1059     on error  undo, return error substitute( "&1 (gen-temp-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1060     on stop   undo, return error substitute( "&1 (gen-temp-row-keyr). stop", vss-workfile )
     1061     on endkey undo, return error substitute( "&1 (gen-temp-row-keyr). endkey", vss-workfile )
     1062     :
     1063       define variable v-tbl-name as character no-undo.
     1064       define variable v-full-tbl-name as character no-undo .
     1065       define variable bh_tbl-name     as handle    no-undo .
     1066       define variable fh              as handle    no-undo .
     1067       define variable v-ok            as logical   no-undo .
     1068       define variable v-where         as character no-undo .
     1069       define variable v-field-num     as integer   no-undo .
     1070       define variable v-count-fld     as integer   no-undo .
     1071       if p-key-rec = ?
     1072         or p-key-rec = "":U
     1073       then do:
     1074         return error substitute( "&1 (gen-temp-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1075       end.
     1076       assign
     1077         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1078         v-full-tbl-name = 'ub.' + v-tbl-name
     1079         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
     1080         v-where         = "":U
     1081         v-count-fld     = 0
     1082       .
     1083       find ub._file
     1084         where ub._file._file-name = v-tbl-name
     1085         no-error.
     1086       if not available ub._file then do:
     1087         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info8, v-tbl-name ).
     1088       end.
     1089       find ub._index
     1090         where recid( ub._index  ) = ub._file._prime-index
     1091         no-error.
     1092       if not available ub._index
     1093         or LC( ub._index._index-name ) = "default":U
     1094       then do:
     1095         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1096       end.
     1097       block_where :
     1098       for each ub._index-field of ub._index  ,
     1099           each ub._field of _index-field
     1100           break by _index-seq
     1101       on error undo, return error
     1102       :
     1103         assign
     1104           v-count-fld = v-count-fld + 1
     1105         .
     1106         if v-count-fld > v-field-num then do:
     1107           leave block_where.
     1108         end.
     1109         if v-where = "":U then do:
     1110           assign
     1111             v-where = "where":U
     1112           .
     1113         end.
     1114         else do:
     1115           assign
     1116             v-where = v-where + chr(32) + "and":U
     1117           .
     1118         end.
     1119         if ub._field._Data-Type ="character":U then do:
     1120           assign
     1121             v-where = v-where + chr(32) + substitute( "&1 = '&2'":U, ub._field._field-name, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     1122           .
     1123         end.
     1124         else do:
     1125           assign
     1126             v-where = v-where + chr(32) + substitute( "&1 = &2":U, ub._field._field-name, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     1127           .
     1128         end.
     1129       end.
     1130       if v-count-fld <> v-field-num then do:
     1131         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     1132       end.
     1133       create buffer bh_tbl-name for table (p-prefix  + v-tbl-name) .
     1134       bh_tbl-name:find-first( v-where, share-lock ) no-error .
     1135       if bh_tbl-name:available then do:
     1136         assign
     1137           p-tbl-row = bh_tbl-name:rowid
     1138         .
     1139       end.
     1140       else do:
     1141         assign
     1142           p-tbl-row = ?
     1143         .
     1144       end.
     1145       delete object bh_tbl-name.
     1146     end.
     1147     if p-tbl-row = ? then do:
     1148       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, v-tbl-name, p-key-rec ).
     1149     end.
     1150     else do:
     1151       return.
     1152     end.
     1153   end procedure.
     1154   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1155   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1156   procedure gen-key-rec :
     1157     define input  parameter p-tbl-name    as character no-undo.
     1158     define input  parameter p-bh_tbl-name as handle    no-undo.
     1159     define output parameter p-key-rec     as character no-undo.
     1160     do
     1161     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1162     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1163     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1164     :
     1165       define variable fh               as handle    no-undo .
     1166       define variable v-ok             as logical   no-undo .
     1167       define variable v-inform         as character no-undo .
     1168       define variable v-ind            as integer   no-undo .
     1169       define variable v-idx-field-qnty as integer   no-undo .
     1170       if p-tbl-name = ?
     1171         or p-tbl-name = "":U
     1172       then do:
     1173         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info10 ).
     1174       end.
     1175       if not p-bh_tbl-name:available then do:
     1176         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info10, p-tbl-name ).
     1177       end.
     1178       assign
     1179         p-key-rec = p-tbl-name
     1180         v-inform  = p-bh_tbl-name:index-information(1)
     1181         v-ind     = 2
     1182       .
     1183       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1184       on error undo, return error
     1185       :
     1186         assign
     1187           v-inform = p-bh_tbl-name:index-information( v-ind )
     1188           v-ind    = v-ind + 1
     1189         .
     1190       end.
     1191       if v-inform = ?
     1192         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1193         or entry( 3, v-inform, ",":U ) <> "1":U
     1194       then do:
     1195         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, p-tbl-name ).
     1196       end.
     1197       else do:
     1198         assign
     1199           v-idx-field-qnty = num-entries( v-inform ) - 4
     1200         .
     1201         if v-idx-field-qnty < 2 then do:
     1202           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, p-tbl-name ).
     1203         end.
     1204         do v-ind = 1 to v-idx-field-qnty by 2
     1205         on error undo, return error
     1206         :
     1207           assign
     1208             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1209             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1210           .
     1211         end.
     1212       end.
     1213       if p-key-rec = ? then do:
     1214         assign
     1215           p-key-rec = "":U
     1216         .
     1217         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info10, p-tbl-name ).
     1218       end.
     1219     end.
     1220     return.
     1221   end procedure.
     1222   procedure gen-where-keyr-tab :
     1223     define input  parameter i-tableSerach as character no-undo.
     1224     define input  parameter i-tablekey   as character  no-undo.
     1225     define input  parameter p-key-rec    as character  no-undo.
     1226     define input  parameter p-key-handle as handle     no-undo .
     1227     define input  parameter p-db-name    as character  no-undo .
     1228     define input  parameter p-tt-handle  as handle     no-undo .
     1229     define output parameter o-Where      as character  no-undo.
     1230     do
     1231     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1232     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1233     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1234     :
     1235       define variable v-full-tbl-name  as character no-undo .
     1236       define variable bh_tbl-name      as handle    no-undo .
     1237       define variable fh_key           as handle    no-undo .
     1238       define variable fh_search        as handle    no-undo .
     1239       define variable v-field-num      as integer   no-undo .
     1240       define variable v-count-fld      as integer   no-undo .
     1241       define variable v-inform         as character no-undo .
     1242       define variable v-ind            as integer   no-undo .
     1243       define variable v-idx-field-qnty as integer   no-undo .
     1244       define variable v-field-name     as character no-undo .
     1245       define variable v-field-val      as character no-undo .
     1246       define variable v-word-link      as character no-undo .
     1247       define variable vTable           as character no-undo.
     1248       define variable bh_tbl-key       as handle    no-undo .
     1249       assign
     1250         p-key-rec = trim( p-key-rec )
     1251       .
     1252       if p-key-handle <> ? then do:
     1253         if not valid-handle(p-key-handle)
     1254            or p-key-handle:type <> "buffer"
     1255         then do:
     1256           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info10 ).
     1257         end.
     1258         if num-entries( p-key-rec, chr(3) ) > 1
     1259           or p-key-rec = ?
     1260           or p-key-rec = "":U
     1261         then do:
     1262           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info10, p-key-rec ).
     1263         end.
     1264       end.
     1265       else do:
     1266         if p-key-rec = ?
     1267           or p-key-rec = "":U
     1268         then do:
     1269           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     1270         end.
     1271       end.
     1272       assign
     1273         vTable = entry( 1 , p-key-rec, chr(3) )
     1274       .
     1275       if p-tt-handle <> ?
     1276         and ( not valid-handle(p-tt-handle)
     1277               or p-tt-handle:type <> "buffer"
     1278             )
     1279       then do:
     1280         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info10, vTable, chr(10) ).
     1281       end.
     1282       if p-tt-handle = ? then do:
     1283         assign
     1284           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1285         .
     1286         create buffer bh_tbl-name for table v-full-tbl-name .
     1287       end.
     1288       else do:
     1289         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1290       end.
     1291       assign
     1292         v-inform = bh_tbl-name:index-information(1)
     1293         v-ind    = 2
     1294       .
     1295       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1296       on error undo, return error
     1297       :
     1298         assign
     1299           v-inform = bh_tbl-name:index-information( v-ind )
     1300           v-ind    = v-ind + 1
     1301         .
     1302       end.
     1303       if v-inform = ?
     1304         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1305         or entry( 3, v-inform, ",":U ) <> "1":U
     1306       then do:
     1307         delete object bh_tbl-name no-error.
     1308         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info10, vTable ).
     1309       end.
     1310       assign
     1311         v-idx-field-qnty = num-entries( v-inform ) - 4
     1312       .
     1313       if v-idx-field-qnty < 2 then do:
     1314         delete object bh_tbl-name no-error.
     1315         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, vTable ).
     1316       end.
     1317       assign
     1318         o-where     = "where":U
     1319         v-word-link = "":U
     1320         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1321         v-count-fld = 0
     1322       .
     1323       if i-tablekey ne "" and i-tablekey ne ?
     1324       then do:
     1325         assign
     1326           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1327         .
     1328         create buffer bh_tbl-key for table v-full-tbl-name .
     1329       end.
     1330       if i-tableSerach ne "" and i-tableSerach ne ?
     1331       then do:
     1332         delete object bh_tbl-name no-error.
     1333         assign
     1334           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1335         .
     1336         create buffer bh_tbl-name for table v-full-tbl-name .
     1337       end.
     1338       block_where:
     1339       do v-ind = 1 to v-idx-field-qnty by 2
     1340       on error undo, return error
     1341       :
     1342         assign
     1343           v-count-fld = v-count-fld + 1
     1344         .
     1345         if p-key-handle = ?
     1346           and v-count-fld > v-field-num
     1347         then do:
     1348           leave block_where.
     1349         end.
     1350         define variable VfieldKeyTable as handle no-undo.
     1351         assign
     1352           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1353           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1354         .
     1355         if     bh_tbl-key ne ?
     1356         then do:
     1357            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1358            if VfieldKeyTable eq ?
     1359            then next block_where.
     1360         end.
     1361         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1362         then
     1363            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1364         else
     1365            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1366         if p-key-handle = ? then do:
     1367           assign
     1368             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1369           .
     1370         end.
     1371         else do:
     1372           assign
     1373             fh_key = p-key-handle:buffer-field( v-field-name )
     1374           .
     1375           if fh_key = ?
     1376             or not valid-handle( fh_key )
     1377           then do:
     1378             delete object bh_tbl-name.
     1379             if     bh_tbl-key ne ?
     1380             then
     1381                delete object bh_tbl-key.
     1382             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info10, p-key-handle:name, v-field-name ).
     1383           end.
     1384           assign
     1385             v-field-val = fh_key:buffer-value
     1386           .
     1387         end.
     1388         if fh_search:data-type ="character":U then do:
     1389           assign
     1390             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1391             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1392             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1393             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1394             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1395             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1396             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1397             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1398             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1399             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1400             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1401             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1402             v-field-val = substitute( '"&1"', v-field-val )
     1403           .
     1404         end.
     1405         assign
     1406           o-where = substitute( "&1 &2", o-where, v-field-val )
     1407         .
     1408         if v-word-link = "":U then do:
     1409           assign
     1410             v-word-link = "and":U
     1411           .
     1412         end.
     1413       end.
     1414       delete object bh_tbl-name.
     1415       if     bh_tbl-key ne ?
     1416       then
     1417          delete object bh_tbl-key.
     1418       if p-key-handle = ?
     1419         and v-count-fld <> v-field-num
     1420       then do:
     1421         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info10, vTable ).
     1422       end.
     1423     end.
     1424   end procedure.
     1425   procedure gen-hn-keyr-tab :
     1426     define input  parameter i-tableSerach as character no-undo.
     1427     define input  parameter i-tablekey   as character no-undo.
     1428     define input  parameter p-key-rec    as character no-undo.
     1429     define input  parameter p-key-handle as handle    no-undo .
     1430     define input  parameter p-db-name    as character no-undo .
     1431     define input  parameter p-tt-handle  as handle    no-undo .
     1432     define input  parameter p-stts-lock  as integer   no-undo .
     1433     define output parameter o-hn         as handle    no-undo.
     1434     define variable v-full-tbl-name as character no-undo.
     1435     define variable v-where         as character no-undo.
     1436     define variable bh_tbl-name     as handle    no-undo.
     1437     define variable vTable          as character no-undo.
     1438     do
     1439     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1440     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1441     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1442         run gen-where-keyr-tab(i-tableSerach,
     1443                                i-tablekey,
     1444                                p-key-rec,
     1445                                p-key-handle,
     1446                                p-db-name,
     1447                                p-tt-handle,
     1448                                output v-where).
     1449         if i-tableSerach ne "" and i-tableSerach ne ?
     1450         then do:
     1451            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1452            create buffer bh_tbl-name for table v-full-tbl-name .
     1453         end.
     1454         else do:
     1455            if p-tt-handle = ? then do:
     1456               assign
     1457                  vTable = entry( 1 , p-key-rec, chr(3) )
     1458               .
     1459               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1460               create buffer bh_tbl-name for table v-full-tbl-name .
     1461            end.
     1462            else do:
     1463               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1464            end.
     1465         end.
     1466         if p-tt-handle = ? then do:
     1467            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1468         end.
     1469         else do:
     1470            bh_tbl-name:find-first( v-where ) no-error .
     1471         end.
     1472         o-hn = bh_tbl-name.
     1473      end.
     1474   end procedure.
     1475   procedure gen-hn-keyr :
     1476     define input  parameter p-key-rec    as character no-undo.
     1477     define input  parameter p-key-handle as handle    no-undo .
     1478     define input  parameter p-db-name    as character no-undo .
     1479     define input  parameter p-tt-handle  as handle    no-undo .
     1480     define input  parameter p-stts-lock  as integer   no-undo .
     1481     define output parameter o-hn         as handle    no-undo.
     1482     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1483   end.
     1484   procedure gen-row-keyr :
     1485     define input  parameter p-key-rec    as character no-undo.
     1486     define input  parameter p-key-handle as handle    no-undo .
     1487     define input  parameter p-db-name    as character no-undo .
     1488     define input  parameter p-tt-handle  as handle    no-undo .
     1489     define input  parameter p-stts-lock  as integer   no-undo .
     1490     define output parameter p-tbl-row    as rowid     no-undo.
     1491     define output parameter p-tbl-name   as character no-undo.
     1492     define variable vHn as handle no-undo.
     1493       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1494       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1495       p-tbl-name =  vHn:table.
     1496       delete object vHn no-error.
     1497     if p-tbl-row = ? then do:
     1498       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info10, p-tbl-name, p-key-rec ).
     1499     end.
     1500     else do:
     1501       return.
     1502     end.
     1503   end procedure.
     1504   procedure gen-key-fv :
     1505     define input  parameter p-key-rec    as character no-undo .
     1506     define output parameter p-field-list as character no-undo .
     1507     define output parameter p-value-list as character no-undo.
     1508     do
     1509     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1510     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1511     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1512     :
     1513       define variable v-full-tbl-name  as character no-undo .
     1514       define variable bh_tbl-name      as handle    no-undo .
     1515       define variable v-tbl-name       as character no-undo .
     1516       define variable v-field-num      as integer   no-undo .
     1517       define variable v-count-fld      as integer   no-undo .
     1518       define variable v-inform         as character no-undo .
     1519       define variable v-ind            as integer   no-undo .
     1520       define variable v-idx-field-qnty as integer   no-undo .
     1521       define variable v-delim-key      as character no-undo .
     1522       if p-key-rec = ?
     1523         or p-key-rec = "":U
     1524       then do:
     1525         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     1526       end.
     1527       assign
     1528         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1529         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1530       .
     1531       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1532       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info10 ).
     1533       assign
     1534         v-inform = bh_tbl-name:index-information(1)
     1535         v-ind    = 2
     1536       .
     1537       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1538       on error undo, return error
     1539       :
     1540         assign
     1541           v-inform = bh_tbl-name:index-information( v-ind )
     1542           v-ind    = v-ind + 1
     1543         .
     1544       end.
     1545       if v-inform = ?
     1546         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1547         or entry( 3, v-inform, ",":U ) <> "1":U
     1548       then do:
     1549         delete object bh_tbl-name no-error.
     1550         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1551       end.
     1552       assign
     1553         v-idx-field-qnty = num-entries( v-inform ) - 4
     1554       .
     1555       if v-idx-field-qnty < 2 then do:
     1556         delete object bh_tbl-name no-error.
     1557         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1558       end.
     1559       assign
     1560         p-field-list = "":U
     1561         p-value-list = "":U
     1562         v-delim-key  = "":U
     1563         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1564         v-count-fld  = 0
     1565       .
     1566       block_where:
     1567       do v-ind = 1 to v-idx-field-qnty by 2
     1568       on error undo, return error
     1569       :
     1570         assign
     1571           v-count-fld = v-count-fld + 1
     1572         .
     1573         if v-count-fld > v-field-num then do:
     1574           leave block_where.
     1575         end.
     1576         assign
     1577           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1578           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1579         .
     1580         if v-ind = 1 then do:
     1581           assign
     1582             v-delim-key = chr(3)
     1583           .
     1584         end.
     1585       end.
     1586       delete object bh_tbl-name.
     1587       if v-count-fld <> v-field-num then do:
     1588         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info10, v-tbl-name ).
     1589       end.
     1590     end.
     1591   end procedure.
     1592   procedure gen-key-field :
     1593     define input  parameter p-table      as character no-undo .
     1594     define output parameter p-field-list as character no-undo .
     1595     do
     1596     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1597     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1598     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1599     :
     1600       define variable v-full-tbl-name  as character no-undo .
     1601       define variable bh_tbl-name      as handle    no-undo .
     1602       define variable v-tbl-name       as character no-undo .
     1603       define variable v-field-num      as integer   no-undo .
     1604       define variable v-count-fld      as integer   no-undo .
     1605       define variable v-inform         as character no-undo .
     1606       define variable v-ind            as integer   no-undo .
     1607       define variable v-idx-field-qnty as integer   no-undo .
     1608       define variable v-delim-key      as character no-undo .
     1609       if p-table = ?
     1610         or p-table = "":U
     1611       then do:
     1612         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info10 ).
     1613       end.
     1614       assign
     1615         v-tbl-name      = p-table
     1616         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1617       .
     1618       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1619       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info10 ).
     1620       assign
     1621         v-inform = bh_tbl-name:index-information(1)
     1622         v-ind    = 2
     1623       .
     1624       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1625       on error undo, return error
     1626       :
     1627         assign
     1628           v-inform = bh_tbl-name:index-information( v-ind )
     1629           v-ind    = v-ind + 1
     1630         .
     1631       end.
     1632       if v-inform = ?
     1633         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1634         or entry( 3, v-inform, ",":U ) <> "1":U
     1635       then do:
     1636         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1637       end.
     1638       assign
     1639         v-idx-field-qnty = num-entries( v-inform ) - 4
     1640       .
     1641       if v-idx-field-qnty < 2 then do:
     1642         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1643       end.
     1644       assign
     1645         p-field-list = "":U
     1646         v-delim-key  = "":U
     1647         v-count-fld  = 0
     1648       .
     1649       block_where:
     1650       do v-ind = 1 to v-idx-field-qnty by 2
     1651       on error undo, return error
     1652       :
     1653         assign
     1654           v-count-fld = v-count-fld + 1
     1655         .
     1656         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1657         if v-ind = 1 then do:
     1658           assign
     1659             v-delim-key = chr(3)
     1660           .
     1661         end.
     1662       end.
     1663       delete object bh_tbl-name.
     1664     end.
     1665   end procedure.
     1666   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1667   FUNCTION get-region RETURNS CHARACTER
     1668     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1669     define variable par-region as character no-undo.
     1670     if parhost-code = 0 and
     1671          parobj-type = "":U and
     1672          parobj-code = 0 then do:
     1673          par-region = "Глобально".
     1674          return par-region.
     1675       end.
     1676       if parobj-type = 'орг':U then do:
     1677          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1678          return par-region.
     1679       end.
     1680       if parobj-type = 'регион':U
     1681       then do:
     1682          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1683          return par-region.
     1684       end.
     1685       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1686       return par-region.
     1687   END FUNCTION.
     1688   FUNCTION get-objregion RETURNS CHARACTER
     1689     (  input parobj-type as character, input parobj-code as integer ) :
     1690     define variable par-region as character no-undo.
     1691     if  parobj-type = "":U and
     1692         parobj-code = 0
     1693     then do:
     1694        par-region = "Глобально".
     1695     end.
     1696     else if parobj-type = 'орг':U
     1697     then do:
     1698        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1699     end.
     1700     else if parobj-type = 'регион':U
     1701     then do:
     1702        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1703     end.
     1704     else
     1705        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1706     return par-region.
     1707   END FUNCTION.
     1708   FUNCTION calldscr returns character ( input p-call-id as character):
     1709   define variable v-descr as character no-undo .
     1710   define variable v-field-list as character no-undo .
     1711   define variable v-value-list as character no-undo.
     1712   define variable v-prop-label as character no-undo .
     1713   define variable v-node-label as character no-undo .
     1714   define variable v-dt-code as integer no-undo .
     1715   define variable v-host-code as integer no-undo .
     1716   define variable v-obj-type as character no-undo .
     1717   define variable v-obj-code as integer no-undo .
     1718   define variable v-label as character no-undo .
     1719   define variable v-node-code as integer no-undo .
     1720   define buffer buf_prop-head for ub.prop-head.
     1721   define buffer buf_prop-ref for ub.prop-ref.
     1722   define buffer buf_prop-map for ub.prop-map.
     1723   run gen-key-fv in this-procedure ( input p-call-id
     1724                                     ,output v-field-list
     1725                                     ,output v-value-list) no-error .
     1726   if error-status:error then return p-call-id.
     1727   CASE entry(1, p-call-id, chr(3)):
     1728     when 'dis-card-type':U then do:
     1729       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1730                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1731                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1732                            ).
     1733     end.
     1734     when 'dis-card':U then do:
     1735       v-descr = substitute("ДК: № &1"
     1736                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1737                            ).
     1738     end.
     1739     when 'dis-card-property':U then do:
     1740       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1741       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1742       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1743       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1744       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1745       find first buf_prop-ref no-lock where
     1746                 buf_prop-ref.dt-code = v-dt-code no-error .
     1747       if available buf_prop-ref then do:
     1748         find first buf_prop-head no-lock where
     1749                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1750         v-prop-label = buf_prop-head.prop-label.
     1751         find first buf_prop-map no-lock where
     1752                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1753               and buf_prop-map.node-code = v-node-code no-error .
     1754         if available buf_prop-map then do:
     1755           v-label = buf_prop-map.node-label.
     1756         end.
     1757       end.
     1758       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1759                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1760                            ,v-prop-label
     1761                            ,v-label
     1762                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1763                            ).
     1764     end.
     1765     when 'clients':U then do:
     1766       v-descr = substitute("&1&2"
     1767                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1768                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1769                            ).
     1770     end.
     1771     when 'ext-system':U then do:
     1772       v-descr = substitute("Внешняя система &1"
     1773                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1774                            ).
     1775     end.
     1776     WHEN 'thbj-attr':U then do:
     1777       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1778       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1779       then do:
     1780         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1781           v-descr = "Операции с товарами".
     1782         end.
     1783         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1784           v-descr = "Операции с клиентами".
     1785         end.
     1786         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1787           v-descr = "Операции с группами товаров".
     1788         end.
     1789         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1790           v-descr = "Операции с группами клиентов".
     1791         end.
     1792         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1793           v-descr = "Операции с чеками на POS IBS-TH".
     1794         end.
     1795         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1796           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1797         end.
     1798         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1799           v-descr = "Операции в системе электронного документооборота".
     1800         end.
     1801         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1802           v-descr = "Операции со справочниками".
     1803         end.
     1804         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1805           v-descr = "Операции с ДНЦ и переоценками".
     1806         end.
     1807         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1808           v-descr = "Отчеты".
     1809         end.
     1810         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1811           v-descr = "Операции с заказами".
     1812         end.
     1813       end.
     1814     end.
     1815     when 'cash-desk':U then do:
     1816       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1817                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1818                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1819                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1820                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1821                            ).
     1822     end.
     1823     when 'ext-file':U then do:
     1824       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1825                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1826                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1827                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1828                            ).
     1829     end.
     1830   end case.
     1831   return v-descr.
     1832   end function.
     1833   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1834   define  temp-table temp-changes no-undo
     1835   field f_name as character
     1836   field l_name as character
     1837   field v_old as character
     1838   field v_new as character
     1839   field t_name as character
     1840   field num_ as integer
     1841   field uniq-key-rec as character
     1842   field action as integer
     1843   field fNotChange as logical
     1844   index pi is unique primary
     1845   num_
     1846   t_name
     1847   f_name
     1848   index
     1849   Chan
     1850   fnotChange
     1851   t_name
     1852   f_name
     1853   index imain uniq-key-rec
     1854   .
     1855   FUNCTION get-all-fields returns character (p-file-name as character ):
     1856   define variable v-dop as character no-undo .
     1857     find first _file no-lock where _file._file-name = p-file-name no-error .
     1858     if not available _file then return "":U.
     1859     for each _field no-lock where
     1860              _field._file-recid = recid(_file) :
     1861       assign
     1862       v-dop = v-dop + _field._field-name + chr(44)
     1863       .
     1864     end.
     1865     return trim(v-dop).
     1866   END FUNCTION.
     1867   PROCEDURE proc-full-temp-changes :
     1868     define input  parameter p-hst-handle as handle    no-undo .
     1869     define input  parameter p-main-table as character no-undo .
     1870     define input  parameter p-field-list as character no-undo .
     1871     define input  parameter p-label-form as character no-undo .
     1872     define variable h-new-buf         as handle    no-undo .
     1873     define variable h-main-buf        as handle    no-undo .
     1874     define variable h-for-comp        as handle    no-undo .
     1875     define variable v-inform          as character no-undo .
     1876     define variable v-ind             as integer   no-undo .
     1877     define variable v-idx-field-qnty  as integer   no-undo .
     1878     define variable v-num-entries     as integer   no-undo .
     1879     define variable fh                as handle    no-undo .
     1880     define variable fh-main           as handle    no-undo .
     1881     define variable fh-old            as handle    no-undo .
     1882     define variable fh-new            as handle    no-undo .
     1883     define variable v-field-name      as character no-undo .
     1884     define variable v-field-lvl       as character no-undo .
     1885     define variable v-field-form      as character no-undo .
     1886     define variable v-search-exp      as character no-undo .
     1887     define variable v-srch-main       as character no-undo .
     1888     define variable v-word-link       as character no-undo .
     1889     define variable v-av-chip-num     as logical   no-undo .
     1890     define variable v-main-pi-fld-lst as character no-undo .
     1891     define variable v-main-fld-lst    as character no-undo .
     1892     define variable v-delim-list      as character no-undo .
     1893     define variable v-label           as character no-undo .
     1894     define variable v-old-value       as character no-undo case-sensitive.
     1895     define variable v-new-value       as character no-undo case-sensitive.
     1896     define variable v-chg-fields as character no-undo.
     1897     for each temp-changes:
     1898       delete temp-changes.
     1899     end.
     1900     if not p-hst-handle:available then do:
     1901       return .
     1902     end.
     1903     create buffer h-new-buf  for table p-hst-handle .
     1904     create buffer h-main-buf for table p-main-table .
     1905     assign
     1906       v-inform = h-main-buf:index-information(1)
     1907       v-ind    = 2
     1908     .
     1909     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1910     on error undo, return error
     1911     :
     1912       assign
     1913         v-inform = h-main-buf:index-information( v-ind )
     1914         v-ind    = v-ind + 1
     1915       .
     1916     end.
     1917     if v-inform = ?
     1918       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1919       or entry( 3, v-inform, ",":U ) <> "1":U
     1920     then do:
     1921       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1922     end.
     1923     assign
     1924       v-idx-field-qnty = num-entries( v-inform ) - 4
     1925     .
     1926     if v-idx-field-qnty < 2 then do:
     1927       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1928     end.
     1929     assign
     1930       v-srch-main   = "where":U
     1931       v-word-link   = "":U
     1932       v-av-chip-num = false
     1933       v-delim-list  = "":U
     1934     .
     1935     do v-ind = 1 to v-idx-field-qnty by 2
     1936     on error undo, return error
     1937     :
     1938       assign
     1939         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1940         fh                = p-hst-handle:buffer-field( v-field-name )
     1941         fh-main           = h-main-buf:buffer-field( v-field-name )
     1942         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1943         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1944       .
     1945       if fh:data-type ="character":U then do:
     1946         assign
     1947           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1948         .
     1949       end.
     1950       else do:
     1951         assign
     1952           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1953         .
     1954       end.
     1955       if v-delim-list = "":U then do:
     1956         assign
     1957           v-delim-list = ",":U
     1958         .
     1959       end.
     1960       if v-word-link = "":U then do:
     1961         assign
     1962           v-word-link = "and":U
     1963         .
     1964       end.
     1965     end.
     1966     assign
     1967       v-delim-list  = "":U
     1968     .
     1969     do v-ind = 1 to h-main-buf:num-fields
     1970     on error undo, return error
     1971     :
     1972       assign
     1973         fh-main      = h-main-buf:buffer-field( v-ind )
     1974         v-field-name = fh-main:name
     1975       .
     1976         assign
     1977           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1978         .
     1979         if v-delim-list = "":U then do:
     1980           assign
     1981             v-delim-list = ",":U
     1982           .
     1983         end.
     1984     end.
     1985     assign
     1986       v-inform = p-hst-handle:index-information(1)
     1987       v-ind    = 2
     1988     .
     1989     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1990     on error undo, return error
     1991     :
     1992       assign
     1993         v-inform = p-hst-handle:index-information( v-ind )
     1994         v-ind    = v-ind + 1
     1995       .
     1996     end.
     1997     if v-inform = ?
     1998       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1999       or entry( 3, v-inform, ",":U ) <> "1":U
     2000     then do:
     2001       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     2002     end.
     2003     assign
     2004       v-idx-field-qnty = num-entries( v-inform ) - 4
     2005     .
     2006     if v-idx-field-qnty < 2 then do:
     2007       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     2008     end.
     2009     assign
     2010       v-search-exp  = "where":U
     2011       v-word-link   = "":U
     2012       v-av-chip-num = false
     2013     .
     2014     do v-ind = 1 to v-idx-field-qnty by 2
     2015     on error undo, return error
     2016     :
     2017       assign
     2018         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2019         fh           = p-hst-handle:buffer-field( v-field-name )
     2020         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     2021       .
     2022       if v-field-name = "chip-num":U then do:
     2023         assign
     2024           v-search-exp  = substitute( "&1 >", v-search-exp )
     2025           v-av-chip-num = true
     2026         .
     2027       end.
     2028       else do:
     2029         assign
     2030           v-search-exp = substitute( "&1 =", v-search-exp )
     2031         .
     2032       end.
     2033       if fh:data-type ="character":U then do:
     2034         assign
     2035           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2036         .
     2037       end.
     2038       else do:
     2039         assign
     2040           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     2041         .
     2042       end.
     2043       if v-word-link = "":U then do:
     2044         assign
     2045           v-word-link = "and":U
     2046         .
     2047       end.
     2048     end.
     2049     if v-av-chip-num = false then do:
     2050       message
     2051         vss-workfile vss-revision vss-description skip
     2052         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     2053         "Использование данной процедуры невозможно!" skip
     2054         view-as alert-box error .
     2055       return error .
     2056     end.
     2057     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     2058     if not h-new-buf:available then do:
     2059       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     2060       if not h-main-buf:available then do:
     2061         assign
     2062           h-for-comp = ?
     2063         .
     2064       end.
     2065       else do:
     2066         assign
     2067           h-for-comp = h-main-buf
     2068         .
     2069       end.
     2070     end.
     2071     else do:
     2072       assign
     2073         h-for-comp = h-new-buf
     2074       .
     2075     end.
     2076     assign
     2077       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     2078     .
     2079     do v-ind = 1 to v-num-entries
     2080     on error undo, return error return-value
     2081     :
     2082       assign
     2083         v-field-name = entry( v-ind, v-main-fld-lst )
     2084         fh-old       = p-hst-handle:buffer-field( v-field-name )
     2085         v-old-value  = fh-old:buffer-value()
     2086         v-label      = trim( fh-old:label )
     2087       .
     2088       if ( trim( p-field-list ) <> "":U
     2089            and lookup( v-field-name, p-field-list ) > 0
     2090          )
     2091          or trim( p-field-list ) = "":U
     2092       then do:
     2093         if h-for-comp <> ? then do:
     2094           assign
     2095             fh-new      = h-for-comp:buffer-field( v-field-name )
     2096             v-new-value = fh-new:buffer-value()
     2097           .
     2098         end.
     2099         else do:
     2100           assign
     2101             v-new-value = "":U
     2102           .
     2103         end.
     2104         if v-old-value <> v-new-value
     2105         then do:
     2106           create temp-changes.
     2107           assign
     2108             temp-changes.t_name = p-main-table
     2109             temp-changes.f_name = v-field-name
     2110             temp-changes.l_name = replace( v-label, "&":U, "":U )
     2111             temp-changes.v_old  = trim( v-old-value )
     2112             temp-changes.v_new  = trim( v-new-value )
     2113             temp-changes.num_   = 0
     2114             temp-changes.fNotChange = v-old-value eq v-new-value
     2115           .
     2116         end.
     2117       end.
     2118     end.
     2119     assign
     2120       v-num-entries = num-entries( p-label-form, chr(8) )
     2121     .
     2122     do v-ind = 1 to v-num-entries
     2123     on error undo, return error return-value
     2124     :
     2125       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     2126         assign
     2127           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2128           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2129           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2130         .
     2131         find first temp-changes
     2132           where temp-changes.f_name = v-field-name
     2133           no-error .
     2134         if available temp-changes then do:
     2135           if trim( v-field-lvl ) <> "":U then do:
     2136             assign
     2137               temp-changes.l_name = v-field-lvl
     2138             .
     2139           end.
     2140           if trim( v-field-form ) <> "":U then do:
     2141             assign
     2142               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     2143             .
     2144             if h-for-comp <> ? then do:
     2145               assign
     2146                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     2147               .
     2148             end.
     2149           end.
     2150         end.
     2151       end.
     2152       else do:
     2153         message
     2154           vss-workfile vss-revision vss-description skip
     2155           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     2156           substitute( "список для поля '&1': '&2'"
     2157                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2158                       ,entry( v-ind, p-label-form, chr(8) )
     2159                     ) skip
     2160           substitute( "полный список: &2", p-label-form ) skip
     2161           view-as alert-box error .
     2162       end.
     2163     end.
     2164     delete object h-new-buf .
     2165     delete object h-main-buf .
     2166   END PROCEDURE.
     2167   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2168   define variable tempcont_v-num_ as integer no-undo .
     2169   define  temp-table temp-tables no-undo
     2170   field tbl-name as character
     2171   field new-tbl-handle as handle
     2172   field new-table-handle as handle
     2173   index pi is unique primary
     2174   tbl-name.
     2175   define  temp-table temp-records no-undo
     2176   field tbl-name as character
     2177   field uniq-key-rec as character
     2178   index pi is unique primary
     2179   tbl-name
     2180   uniq-key-rec
     2181   .
     2182   procedure tempcont_create-changes :
     2183   define input  parameter p-tbl-name   as character no-undo.
     2184   define input  parameter p-tbl-handle as handle    no-undo.
     2185   define input  parameter p-ttbl-handle as handle    no-undo.
     2186   define input  parameter p-action as integer no-undo .
     2187   define variable v-chg-fields as character no-undo .
     2188   define variable v-ii as integer no-undo .
     2189   define variable fh-main as handle no-undo .
     2190   define variable fh-temp as handle no-undo .
     2191   define variable fh as handle no-undo .
     2192   define variable th as handle no-undo .
     2193   define variable v-main-value as character no-undo .
     2194   define variable v-temp-value as character no-undo .
     2195   define variable v-uniq-key-rec as character no-undo .
     2196   define variable v-ind as integer no-undo .
     2197   define variable v-keys as character no-undo .
     2198   if p-tbl-handle:available then do:
     2199     if p-tbl-handle:buffer-compare( p-ttbl-handle) = yes then return.
     2200   end.
     2201   do v-ii = 1 to min(p-tbl-handle:num-fields, p-ttbl-handle:num-fields):
     2202     assign
     2203     fh-main      = p-tbl-handle:buffer-field( v-ii )
     2204     fh-temp      = p-ttbl-handle:buffer-field( v-ii )
     2205     .
     2206     if fh-main:name = fh-temp:name
     2207     and fh-main:data-type = fh-temp:data-type then do:
     2208       if fh-main:buffer-value ne fh-temp:buffer-value then do:
     2209         if p-action = integer('1':U) then do:
     2210           assign
     2211           fh = fh-temp
     2212           th = p-ttbl-handle
     2213           v-main-value = fh-main:initial
     2214           v-keys  = p-ttbl-handle:keys
     2215           .
     2216         end.
     2217         else do:
     2218           assign
     2219           fh = fh-main
     2220           th = p-tbl-handle
     2221           v-main-value = fh-main:string-value
     2222           v-keys  = p-tbl-handle:keys
     2223           .
     2224         end.
     2225         assign
     2226         v-temp-value = fh-temp:string-value
     2227        .
     2228        if v-uniq-key-rec = '':U then do:
     2229           v-uniq-key-rec = p-tbl-name.
     2230           do v-ind = 1 to num-entries(v-keys)
     2231           on error undo, return error
     2232           :
     2233             assign
     2234             fh = th:buffer-field(entry(v-ind, v-keys))
     2235             v-uniq-key-rec = v-uniq-key-rec + chr(3) + substitute("&1", fh:buffer-value())
     2236             .
     2237           end.
     2238         end.
     2239         create temp-changes.
     2240         assign
     2241         temp-changes.t_name = p-tbl-name
     2242         temp-changes.f_name = fh-main:name
     2243         temp-changes.l_name = '':U
     2244         temp-changes.v_old  = v-main-value
     2245         temp-changes.v_new  = v-temp-value
     2246         temp-changes.action = p-action
     2247         temp-changes.uniq-key-rec = v-uniq-key-rec
     2248         temp-changes.num_   = tempcont_v-num_ + 1
     2249         tempcont_v-num_     = tempcont_v-num_ + 1
     2250         .
     2251       end.
     2252     end.
     2253   end.
     2254   end procedure.
     2255   procedure tempcont_create-record :
     2256   define input  parameter p-tbl-name   as character no-undo.
     2257   define input  parameter p-new-tbl-handle as handle    no-undo.
     2258   define input  parameter p-action as integer no-undo .
     2259   do
     2260   on error  undo, return error substitute( "&1 (tempcont_create-record). &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2261   on stop   undo, return error substitute( "&1 (tempcont_create-record). stop", vss-include-info13 )
     2262   on endkey undo, return error substitute( "&1 (tempcont_create-record). endkey", vss-include-info13 )
     2263   :
     2264     define variable tt-name          as character no-undo .
     2265     define variable tth              as handle    no-undo .
     2266     define variable bh_tt            as handle    no-undo .
     2267     define variable v-ok             as logical   no-undo .
     2268     define variable v-full-tbl-name  as character no-undo .
     2269     define variable v-inform         as character no-undo .
     2270     define variable v-ind            as integer   no-undo .
     2271     define variable v-idx-field-qnty as integer   no-undo .
     2272     define variable v-where          as character no-undo .
     2273     define variable v-word-link      as character no-undo .
     2274     define variable v-field-name     as character no-undo .
     2275     define variable fh_tbl-name      as handle    no-undo .
     2276     define variable fh_tt            as handle    no-undo .
     2277     define variable v-field-val      as character no-undo .
     2278     define variable compare-log      as logical no-undo .
     2279     define buffer buf_temp-tables  for temp-tables.
     2280     if not p-new-tbl-handle:available then do:
     2281       return error substitute( "&1. Переданный буфер таблицы &2 не доступен", vss-include-info13, p-tbl-name ).
     2282     end.
     2283     assign
     2284       v-full-tbl-name = substitute( "ub.&1":U, p-tbl-name )
     2285     .
     2286     find first buf_temp-tables where
     2287               buf_temp-tables.tbl-name = p-tbl-name no-error .
     2288     if not available buf_temp-tables then do:
     2289       create temp-table tth.
     2290       assign
     2291         tt-name = "wt-" + p-tbl-name
     2292         tth:undo = no
     2293       .
     2294       v-ok = yes.
     2295       assign
     2296         v-ok = tth:create-like( v-full-tbl-name ) no-error
     2297       .
     2298       if v-ok <> true then do:
     2299         return error substitute( "&1 (tempcont_create-record). Ошибка при создании временной таблицы &2 (1)", vss-include-info13, tt-name ) .
     2300       end.
     2301       assign
     2302         v-ok = tth:temp-table-prepare( tt-name ) no-error
     2303       .
     2304       if v-ok <> true then do:
     2305         return error substitute( "&1 (tempcont_create-record). Ошибка при создании временной таблицы &2 (2)", vss-include-info13, tt-name ) .
     2306       end.
     2307       create buf_temp-tables.
     2308       assign
     2309       buf_temp-tables.tbl-name = p-tbl-name
     2310       buf_temp-tables.new-tbl-handle = tth:default-buffer-handle
     2311       buf_temp-tables.new-table-handle = tth
     2312       .
     2313       assign
     2314       bh_tt = buf_temp-tables.new-tbl-handle
     2315       .
     2316     end.
     2317     else do:
     2318       if p-new-tbl-handle:table-handle = buf_temp-tables.new-tbl-handle:table-handle then do:
     2319         assign
     2320         bh_tt = p-new-tbl-handle
     2321         .
     2322       end.
     2323       else do:
     2324         assign
     2325         bh_tt = buf_temp-tables.new-tbl-handle
     2326         .
     2327       end.
     2328     end.
     2329     assign
     2330     v-inform = bh_tt:index-information(1)
     2331     v-ind    = 2
     2332     .
     2333     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2334     on error undo, return error
     2335     :
     2336       assign
     2337         v-inform = bh_tt:index-information( v-ind )
     2338         v-ind    = v-ind + 1
     2339       .
     2340     end.
     2341     if v-inform = ?
     2342       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2343       or entry( 3, v-inform, ",":U ) <> "1":U
     2344     then do:
     2345       return error substitute( "&1 (tempcont_create-record). Таблица &2 не имеет первичного ключа в БД", vss-include-info13, p-tbl-name ).
     2346     end.
     2347     assign
     2348       v-idx-field-qnty = num-entries( v-inform ) - 4
     2349     .
     2350     if v-idx-field-qnty < 2 then do:
     2351       return error substitute( "&1 (tempcont_create-record). Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, p-tbl-name ).
     2352     end.
     2353     assign
     2354       v-where     = "where":U
     2355       v-word-link = "":U
     2356     .
     2357     block_where:
     2358     do v-ind = 1 to v-idx-field-qnty by 2
     2359     on error undo, return error
     2360     :
     2361       assign
     2362         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2363         fh_tbl-name  = bh_tt:buffer-field( v-field-name )
     2364         fh_tt        = p-new-tbl-handle:buffer-field( v-field-name )
     2365         v-field-val  = fh_tt:buffer-value
     2366         v-where      = substitute( "&1 &2 &3.&4 =", v-where, v-word-link, fh_tbl-name:table, v-field-name )
     2367       .
     2368       if fh_tbl-name:data-type ="character":U then do:
     2369           assign
     2370           v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2371           v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2372           v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2373           v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2374           v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2375           v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2376           v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2377           v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2378           v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2379           v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2380           v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2381           v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2382           v-field-val = substitute( '"&1"', v-field-val )
     2383           .
     2384       end.
     2385       assign
     2386         v-where = substitute( "&1 &2", v-where, v-field-val )
     2387       .
     2388       if v-word-link = "":U then do:
     2389         assign
     2390           v-word-link = "and":U
     2391         .
     2392       end.
     2393     end.
     2394     bh_tt:find-first( v-where, exclusive-lock ) no-error .
     2395     if not bh_tt:available then do:
     2396       assign
     2397         v-ok = false
     2398       .
     2399       assign
     2400         v-ok = bh_tt:buffer-create no-error
     2401       .
     2402       if v-ok <> true then do:
     2403         return error substitute( "&1 (tempcont_create-record). Ошибка при создании буфера временной таблицы.", vss-include-info13, p-tbl-name ).
     2404       end.
     2405       assign
     2406         compare-log = false
     2407       .
     2408     end.
     2409     else do:
     2410       assign
     2411         compare-log = bh_tt:buffer-compare( p-new-tbl-handle )
     2412       .
     2413     end.
     2414     if compare-log = false then do:
     2415       assign
     2416         v-ok = false
     2417       .
     2418       assign
     2419         v-ok = bh_tt:buffer-copy( p-new-tbl-handle ) no-error
     2420       .
     2421       if v-ok <> true then do:
     2422         return error substitute( "&1 (tempcont_create-record). BUFFER-COPY не прошел для таблицы &2", vss-include-info13, p-tbl-name ).
     2423       end.
     2424     end.
     2425     assign
     2426       v-ok = false
     2427     .
     2428     assign
     2429       v-ok = bh_tt:buffer-release() no-error
     2430     .
     2431     if v-ok <> true then do:
     2432       return error substitute( "&1 (tempcont_create-record). buffer-release не прошел для таблицы &2", vss-include-info13, p-tbl-name ).
     2433     end.
     2434     assign
     2435       v-ok = false
     2436     .
     2437     assign
     2438       fh_tbl-name  = ?
     2439       fh_tt        = ?
     2440       bh_tt        = ?
     2441     .
     2442   end.
     2443   end procedure.
     2444   procedure tempcont_get-buffer-handle :
     2445   define input parameter p-tbl-name as character no-undo .
     2446   define output parameter p-new-tbl-handle as handle no-undo .
     2447   do
     2448   on error undo, return error
     2449   :
     2450     define variable tth              as handle    no-undo .
     2451     define variable tt-name          as character no-undo .
     2452     define variable v-ok             as logical   no-undo .
     2453     define variable v-full-tbl-name  as character no-undo .
     2454     define buffer buf_temp-tables  for temp-tables.
     2455     find first buf_temp-tables where
     2456              buf_temp-tables.tbl-name = p-tbl-name no-error .
     2457     if not available buf_temp-tables then do:
     2458       create temp-table tth.
     2459       assign
     2460       tt-name = "wt-" + p-tbl-name
     2461       tth:undo = no
     2462       v-full-tbl-name = substitute( "ub.&1":U, p-tbl-name )
     2463       .
     2464       v-ok = yes.
     2465       assign
     2466       v-ok = tth:create-like( v-full-tbl-name ) no-error
     2467       .
     2468       if v-ok <> true then do:
     2469         return error substitute( "&1 (tempcont_get-buffer-handle). Ошибка при создании временной таблицы &2 (1)", vss-include-info13, tt-name ) .
     2470       end.
     2471       assign
     2472         v-ok = tth:temp-table-prepare( tt-name ) no-error
     2473       .
     2474       if v-ok <> true then do:
     2475         return error substitute( "&1 (tempcont_get-buffer-handle). Ошибка при создании временной таблицы &2 (2)", vss-include-info13, tt-name ) .
     2476       end.
     2477       create buf_temp-tables.
     2478       assign
     2479       buf_temp-tables.new-table-handle = tth
     2480       buf_temp-tables.tbl-name = p-tbl-name
     2481       buf_temp-tables.new-tbl-handle = tth:default-buffer-handle
     2482       .
     2483     end.
     2484     p-new-tbl-handle = buf_temp-tables.new-tbl-handle.
     2485   end.
     2486   end procedure.
     2487   procedure tempcont_clear :
     2488   define buffer buf_temp-tables for temp-tables.
     2489   do
     2490   on error undo, return error return-value
     2491   :
     2492     for each buf_temp-tables:
     2493       if valid-handle(buf_temp-tables.new-table-handle) then do:
     2494         buf_temp-tables.new-tbl-handle:empty-temp-table().
     2495       end.
     2496       delete object buf_temp-tables.new-table-handle.
     2497     end.
     2498   end.
     2499   end procedure.
     2500   define variable v-counter                   as integer      no-undo.
     2501   define variable v-param-list                as character    no-undo.
     2502   define variable v-param-type                as character    no-undo.
     2503   define variable v-host-code                 as integer      no-undo.
     2504   define variable v-parameter                 as character    no-undo .
     2505   define variable glog        as logical   no-undo .
     2506   define variable ii          as integer   no-undo .
     2507   define variable v-entry     as character no-undo .
     2508   define variable v-curr-r-b  as character no-undo .
     2509   DEFINE VARIABLE v-today as date no-undo .
     2510   DEFINE VARIABLE v-time as integer no-undo .
     2511   define variable v-can-calc as character no-undo .
     2512   define variable v-for-what as character no-undo .
     2513   define variable v-sum-id  as character no-undo .
     2514   define variable v-current-d-card as character no-undo .
     2515   DEFINE VARIABLE v-algo-field-list AS CHARACTER NO-UNDO.
     2516   DEFINE VARIABLE v-update-mode AS CHARACTER NO-UNDO.
     2517   DEFINE VARIABLE v-dc-list-mode AS CHARACTER NO-UNDO.
     2518   DEFINE VARIABLE v-dc-type-list-mode AS CHARACTER NO-UNDO.
     2519   DEFINE VARIABLE v-dc-type-list AS CHARACTER NO-UNDO.
     2520   DEFINE VARIABLE v-dc-type-algo-list AS CHARACTER NO-UNDO.
     2521   define variable v-db-num like ub.db.db-num no-undo .
     2522   define variable v-num-rec-value-err as integer no-undo .
     2523   define buffer buf_dis-card-type for ub.dis-card-type.
     2524   define buffer buf_dis-card for ub.dis-card.
     2525   DEFINE TEMP-TABLE sample NO-UNDO LIKE ub.rule-by-call.
     2526   define temp-table tt0-rule-by-call no-undo like ub.rule-by-call
     2527   field num-rec as integer
     2528   field num-rec-calc-err as integer
     2529   field num-rec-value-err as integer
     2530   field num-rec-ok as integer
     2531   field num-rec-new as integer
     2532   field num-rec-calc-err-new as integer
     2533   field num-rec-value-err-new as integer
     2534   field num-rec-ok-new as integer
     2535    .
     2536   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     2537   define buffer buf2_tt0-rule-by-call for tt0-rule-by-call.
     2538                                                                                                                           define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   PROCEDURE fill-table :
     2540   define input parameter p-dc-type-list-mode as character no-undo .
     2541   define input parameter p-dc-type-list as character no-undo .
     2542   define input parameter p-calc-only as logical no-undo .
     2543   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     2544   DEFINE BUFFER buf_rule-by-call FOR ub.rule-by-call.
     2545   DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     2546   _buf_dis-card-type:
     2547   FOR EACH buf_dis-card-type:
     2548     IF p-dc-type-list-mode = "*":U THEN.
     2549     ELSE DO:
     2550         IF not lookup(buf_dis-card-type.type, p-dc-type-list) > 0 then next _buf_dis-card-type.
     2551     END.
     2552     for each buf_rule-by-call no-lock where
     2553             buf_rule-by-call.call_id = buf_dis-card-type.uniq-key-rec
     2554         AND buf_rule-by-call.codex_id = 2
     2555         AND buf_rule-by-call.ruleset_id = 5:
     2556       if p-calc-only and buf_rule-by-call.can-calc = no then NEXT.
     2557       find first buf_tt0-rule-by-call no-lock where
     2558                 buf_tt0-rule-by-call.call_id = buf_rule-by-call.call_id
     2559             and buf_tt0-rule-by-call.ruleset_id = buf_rule-by-call.ruleset_id
     2560             and buf_tt0-rule-by-call.order_id = buf_rule-by-call.order_id no-error.
     2561       if not available buf_tt0-rule-by-call then do:
     2562         create buf_tt0-rule-by-call.
     2563         buffer-copy buf_rule-by-call to buf_tt0-rule-by-call.
     2564       end.
     2565     end.
     2566   END.
     2567   END PROCEDURE.
     2568   do
     2569   on error undo, return error return-value
     2570   :
     2571     assign
     2572     log-file-name = "shd-free.log".
     2573     run get-db-num in parparentproc (output v-db-num) no-error .
     2574     if v-db-num <> 0 then do:
     2575       run write-log-and-file in p-log-handle (
     2576             input 1
     2577           , input log-file-name
     2578           , input 1
     2579           , input substitute("!!!Перерасчет накопительных скидок и категорий по ДК возможен только в ГБД")).
     2580      return error.
     2581     end.
     2582     run schedule-attr-value in this-procedure (
     2583           input p-cre-db-num
     2584         , input p-task-type
     2585         , input p-task-num
     2586         , input 'schedule-param-list':U
     2587         , output v-param-list
     2588         , output v-param-type
     2589     ).
     2590     if v-param-list = "":U then do:
     2591         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Не заданы параметры расчета скидки или категории согласно накопительному алгоритма по ДК в задаче &1&2"                                     , p-task-num                                                                                                           , chr(10))).
     2592         return.
     2593     end.
     2594     assign
     2595     v-dc-list-mode = entry(1, v-param-list, chr(4))
     2596     v-update-mode = entry(2, v-param-list, chr(4))
     2597     v-dc-type-list-mode = entry(3, v-param-list, chr(4))
     2598     v-dc-type-list = entry(4, v-param-list, chr(4))
     2599     v-dc-type-algo-list = entry(5, v-param-list, chr(4))
     2600     no-error
     2601     .
     2602     if error-status :error then do:
     2603       run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Ошибки при получении параметров расчета&1" +                            "&2&1&3&1"                                                                          , error-status:get-message(1)                                                       , return-value )).
     2604     end.
     2605       run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Пересчет скидок и категорий по дисконтным картам в соответствии с накопительными алгоритмами&1" +                              "Отбор дисконтных карт: &2&1" +                             "Режим работы: &3&1" +                             "Отбор типов дисконтных карт: &4&1" +                             "Отбор итогов для пересчета или проверки: &5"                            , chr(10)                            , (if v-dc-list-mode = "LIST" then "по списку карт" else "все карты, подлежащие расчету по алгоритму")                           , (if v-update-mode = "update" then "ПЕРЕСЧЕТ" else "ПРОВЕРКА")                           , (if v-dc-type-list-mode = "*" then "ВСЕ ТИПЫ" else ("ПО СПИСКУ" + chr(32) + v-dc-type-list ))                           , (if v-dc-type-algo-list = "" then "ВСЕ АЛГОРИТМЫ" else "ВЫБРАННЫЕ АЛГОРИТМЫ"))).
     2606   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2608     (output v-curr-r-b
     2609     )  .
     2610     IF v-dc-type-list-mode = "LIST"
     2611     AND v-dc-type-list = '':u  then do:
     2612       run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Не задан список типов ДК&1", chr(10))).
     2613       return .
     2614     end.
     2615     IF v-dc-list-mode = "LIST"
     2616     AND NOT CAN-FIND(FIRST dc-list) then do:
     2617       run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Не задан список ДК&1", chr(10))).
     2618       return error.
     2619     END.
     2620     run fill-table in this-procedure (
     2621                                        input v-dc-type-list-mode
     2622                                       ,input v-dc-type-list
     2623                                       ,input yes ).
     2624     _buf_tt0-rule-by-call:
     2625     for each buf_tt0-rule-by-call,
     2626         first buf_dis-card-type where
     2627               buf_dis-card-type.uniq-key-rec = buf_tt0-rule-by-call.call_id
     2628     break
     2629     by buf_tt0-rule-by-call.call_id:
     2630       if first-of(buf_tt0-rule-by-call.call_id) then do:
     2631         v-current-d-card = "".
     2632         if v-dc-type-list-mode <> "*"
     2633         and lookup(buf_dis-card-type.type, v-dc-type-list) = 0 then NEXT _buf_tt0-rule-by-call.
     2634         do while v-current-d-card < "Z":
     2635           v-num-rec-value-err = 0.
     2636           run str/saledc.p ( input parparentproc
     2637                       , input this-procedure:handle
     2638                       , input p-log-handle
     2639                       , input 'batch-card-recalc':U
     2640                       , input ?
     2641                       , input ""
     2642                       , input 0
     2643                       , input 0
     2644                       , input 0
     2645                       , input g#db-num
     2646                       , input buf_dis-card-type.uniq-key-rec
     2647                       , input ?
     2648                       , input ?
     2649                       , input ?
     2650                       , input 1
     2651                       , input 1
     2652                       , input (v-update-mode = "update")
     2653                       ) no-error .
     2654           if error-status :error then do:
     2655             undo, return error return-value.
     2656           end.
     2657           for each buf2_tt0-rule-by-call:
     2658             assign
     2659             buf2_tt0-rule-by-call.num-rec           = buf2_tt0-rule-by-call.num-rec + buf2_tt0-rule-by-call.num-rec-new
     2660             buf2_tt0-rule-by-call.num-rec-new       = 0
     2661             buf2_tt0-rule-by-call.num-rec-calc-err  = buf2_tt0-rule-by-call.num-rec-calc-err + buf2_tt0-rule-by-call.num-rec-calc-err-new
     2662             buf2_tt0-rule-by-call.num-rec-calc-err-new = 0
     2663             buf2_tt0-rule-by-call.num-rec-value-err = buf2_tt0-rule-by-call.num-rec-value-err + buf2_tt0-rule-by-call.num-rec-value-err-new
     2664             buf2_tt0-rule-by-call.num-rec-value-err-new = 0
     2665             buf2_tt0-rule-by-call.num-rec-ok        = buf2_tt0-rule-by-call.num-rec-ok  + buf2_tt0-rule-by-call.num-rec-ok-new
     2666             buf2_tt0-rule-by-call.num-rec-ok-new = 0
     2667             .
     2668           end.
     2669         end.
     2670       end.
     2671     end.
     2672   run tempcont_clear in this-procedure no-error.
     2673      run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Завершен расчет&1", chr(10))).
     2674   end.
     2675   procedure is-to-create-d-card :
     2676   define input parameter p-d-card as character no-undo .
     2677   define output parameter p-create-chr as character no-undo .
     2678     do
     2679     on error undo, return error
     2680     :
     2681        if v-dc-list-mode = "all":U then do:
     2682          p-create-chr = "*".
     2683        end.
     2684        else do:
     2685          find first dc-list no-lock where
     2686                     dc-list.d-card = p-d-card no-error.
     2687          if not available dc-list then do:
     2688            p-create-chr = string(no).
     2689          end.
     2690          else do:
     2691            p-create-chr = string(yes).
     2692          end.
     2693        end.
     2694     end.
     2695   end procedure.
     2696   procedure is-to-calc-algo :
     2697   define input parameter p-uniq-key-rec as character no-undo .
     2698   define output parameter p-calc-chr as character no-undo .
     2699   do
     2700   on error undo, return error
     2701   :
     2702     if v-dc-type-algo-list = '':U then do:
     2703       p-calc-chr = '*':U.
     2704     end.
     2705     else do:
     2706       p-calc-chr = string(lookup(p-uniq-key-rec, v-dc-type-algo-list) > 0).
     2707     end.
     2708   end.
     2709   end procedure.
     2710   procedure set-current-d-card :
     2711   define input parameter p-current-d-card as character no-undo .
     2712     do
     2713     on error undo, return error
     2714     :
     2715        v-current-d-card = p-current-d-card.
     2716     end.
     2717   end procedure.
     2718   procedure get-current-d-card :
     2719   define output parameter p-current-d-card as character no-undo .
     2720     do
     2721     on error undo, return error
     2722     :
     2723       p-current-d-card = v-current-d-card.
     2724     end.
     2725   end procedure.
     2726   procedure set-num-rec :
     2727   define input parameter p-num-rec as integer no-undo .
     2728   define input parameter p-num-rec-calc-err as integer no-undo .
     2729   define input parameter p-num-rec-value-err as integer no-undo .
     2730   define input parameter p-num-rec-ok as integer no-undo .
     2731   define parameter buffer buf_rule-by-call for ub.rule-by-call.
     2732   define input parameter p-display as logical no-undo .
     2733   define buffer buf_temp-changes for temp-changes.
     2734   define buffer buf_temp-tables for temp-tables.
     2735   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     2736     do
     2737     on error undo, return error
     2738     :
     2739       for each buf_temp-changes
     2740       break
     2741       by buf_temp-changes.uniq-key-rec
     2742       by buf_temp-changes.f_name
     2743       :
     2744         if first-of(buf_temp-changes.uniq-key-rec) then do:
     2745           assign
     2746           v-num-rec-value-err = v-num-rec-value-err + 1
     2747           p-num-rec-ok = p-num-rec-ok - 1
     2748           .
     2749         end.
     2750         if buf_temp-changes.uniq-key-rec begins 'dis-card':U then do:
     2751               run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("&1:&5" +                              "старое значение &2 = &3&5" +                              "новое значение  &2 = &4"                             , calldscr(buf_temp-changes.uniq-key-rec)                               , (if buf_temp-changes.t_name = 'dis-card-property':U then '' else  buf_temp-changes.f_name)                             , buf_temp-changes.v_old                              , buf_temp-changes.v_new                              , chr(10))).
     2752         end.
     2753         delete buf_temp-changes.
     2754       end.
     2755       if p-display = yes then do:
     2756         tempcont_v-num_ = 0.
     2757         run hide-counter in p-log-handle.
     2758       end.
     2759       find first buf_tt0-rule-by-call where
     2760                 buf_tt0-rule-by-call.call_id = buf_rule-by-call.call_id
     2761            and  buf_tt0-rule-by-call.codex_id = buf_rule-by-call.codex_id
     2762            and  buf_tt0-rule-by-call.ruleset_id = buf_rule-by-call.ruleset_id
     2763            and  buf_tt0-rule-by-call.order_id = buf_rule-by-call.order_id no-error.
     2764       if available buf_tt0-rule-by-call then do:
     2765         assign
     2766         buf_tt0-rule-by-call.num-rec-new = p-num-rec
     2767         buf_tt0-rule-by-call.num-rec-calc-err-new = p-num-rec-calc-err
     2768         buf_tt0-rule-by-call.num-rec-value-err-new = v-num-rec-value-err
     2769         buf_tt0-rule-by-call.num-rec-ok-new = p-num-rec-ok
     2770         .
     2771         if p-display then do:
     2772           run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("&2---------------------Просмотрено карт - &1&2" +                              "---------------------Ошибок при расчете - &3&2" +                              (if v-update-mode = "update"                             then                                                     "---------------------Пересчитано - &4&2"                               else                                                                          "---------------------Значений для пересчета - &4&2") +                             "---------------------Значений не подлежащих пересчету - &5"                             , buf_tt0-rule-by-call.num-rec  + buf_tt0-rule-by-call.num-rec-new                              , chr(10)                                                                    , buf_tt0-rule-by-call.num-rec-calc-err + buf_tt0-rule-by-call.num-rec-calc-err-new                               ,  buf_tt0-rule-by-call.num-rec-value-err + buf_tt0-rule-by-call.num-rec-value-err-new                              , ((buf_tt0-rule-by-call.num-rec-ok + buf_tt0-rule-by-call.num-rec-ok-new)                                           - (buf_tt0-rule-by-call.num-rec-value-err + buf_tt0-rule-by-call.num-rec-value-err-new ))                             )).
     2773         end.
     2774         else do:
     2775           run show-counter in p-log-handle .               run write-counter in p-log-handle ( input substitute("Просмотрено карт - &1", buf_tt0-rule-by-call.num-rec  + buf_tt0-rule-by-call.num-rec-new)) no-error.
     2776         end.
     2777       end.
     2778     end.
     2779   end procedure.
