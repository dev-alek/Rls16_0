        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define input  parameter p-doc-code as character no-undo .
        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define new global shared variable g#library  as handle no-undo .
        9   define new global shared variable g#library2 as handle no-undo .
       10   define   shared variable g#auto as logical no-undo.
       11   define   shared variable g#news as logical no-undo.
       12   define   shared variable g#oxml as logical no-undo.
       13   define   shared variable g#esys as logical no-undo.
       14   define   shared variable g#news-source-db as integer no-undo.
       15   define   shared variable g#esys-source-esys as integer no-undo.
       16   define   shared variable g#db-num as integer   no-undo .
       17   define   shared variable g#userid as character no-undo .
       18   define   shared variable g#passwd as character no-undo .
       19   define buffer main_price-list for ub.price-list  .
       20   define buffer main_price-doc-forming-gds for ub.price-doc-forming-gds  .
       21   define variable k as integer   no-undo .
       22   define variable v-root-b-code as integer no-undo .
       23   find first ub.price-doc no-lock where ub.price-doc.doc-num = p-doc-code .
       24   find first ub.price-doc-forming no-lock where
       25              ub.price-doc-forming.plt-db-num  = ub.price-doc.plt-db-num and
       26              ub.price-doc-forming.plt-id      = ub.price-doc.plt-id     and
       27              ub.price-doc-forming.pdf-db      = ub.price-doc.pdf-db     and
       28              ub.price-doc-forming.pdf-id      = ub.price-doc.pdf-id     no-error .
       29   for each ub.price-list exclusive-lock  where
       30             ub.price-list.doc-num = p-doc-code :
       31         find first ub.goods no-lock where
       32                    ub.goods.artic     =  ub.price-list.artic and
       33                    ub.goods.prod-type =  ub.price-list.prod-type and
       34                    ub.goods.prod-code =  ub.price-list.prod-code .
       35   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
       36     (input  ub.goods.gds-code
       37     ,input  ?
       38     ,output v-root-b-code
       39     )  .
       40             if v-root-b-code <> ub.price-list.b-code
       41                   then ub.price-list.main-price = false .
       42                   else ub.price-list.main-price = true .
       43         find first ub.price-doc-forming-gds no-lock  where
       44                     ub.price-doc-forming-gds.plt-db-num  = ub.price-doc.plt-db-num and
       45                     ub.price-doc-forming-gds.plt-id      = ub.price-doc.plt-id     and
       46                     ub.price-doc-forming-gds.pdf-db      = ub.price-doc.pdf-db     and
       47                     ub.price-doc-forming-gds.pdf-id      = ub.price-doc.pdf-id     and
       48                     ub.price-doc-forming-gds.b-code      = ub.price-list.b-code no-error .
       49           if ub.price-list.main-price = false then do:
       50              find first main_price-list no-lock where
       51                         main_price-list.doc-num = p-doc-code and
       52                         main_price-list.b-code  = v-root-b-code no-error .
       53             if not available main_price-list then do:
       54                find first ub.gds-obj no-lock where
       55                           ub.gds-obj.gds-code = ub.goods.gds-code and
       56                           ub.gds-obj.obj-code = ub.price-doc.obj-code and
       57                           ub.gds-obj.obj-type = ub.price-doc.obj-type.
       58                create main_price-list.
       59                buffer-copy ub.price-list to main_price-list
       60                   assign
       61                     main_price-list.b-code     = v-root-b-code
       62                     main_price-list.main-price = true
       63                     main_price-list.price-sale = ub.gds-obj.price-sale
       64                   .
       65                   k = k + 1 .
       66                   find first main_price-doc-forming-gds exclusive-lock where
       67                              main_price-doc-forming-gds.plt-db-num  = ub.price-doc.plt-db-num and
       68                              main_price-doc-forming-gds.plt-id      = ub.price-doc.plt-id     and
       69                              main_price-doc-forming-gds.pdf-db      = ub.price-doc.pdf-db     and
       70                              main_price-doc-forming-gds.pdf-id      = ub.price-doc.pdf-id     and
       71                              main_price-doc-forming-gds.b-code      = main_price-list.b-code
       72                              no-error .
       73                  if available ub.price-doc-forming-gds and not available main_price-doc-forming-gds then do:
       74                     create main_price-doc-forming-gds.
       75                     buffer-copy ub.price-doc-forming-gds to main_price-doc-forming-gds
       76                       assign
       77                         main_price-doc-forming-gds.b-code          = v-root-b-code
       78                         main_price-doc-forming-gds.price-sale-doc  = ub.gds-obj.price-sale
       79                         main_price-doc-forming-gds.price-sale-rubl = ub.gds-obj.price-sale  * ub.price-doc-forming.exch-rate / ub.price-doc-forming.exch-scale
       80                         main_price-doc-forming-gds.price-sale-base = main_price-doc-forming-gds.price-sale-rubl  / ub.price-doc.base-rate * ub.price-doc.base-scale
       81                         .
       82                  end.
       83             end.
       84           end.
       85       end.
       86   message substitute("Исправлено  &1 бар-кодов " ,k ) .
