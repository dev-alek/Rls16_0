        1   block-level on error undo, throw.
        2   define input parameter p-install as logical no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: usrldr15.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/usrldr15.p $":U .
        8   define variable vss-description as character no-undo init "Перенос информации о доступных объектах из таблиц usr-grpo, usr-grpa в таблицы user-host, user-obj".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68     define variable v-cntxt-db-num        as integer   no-undo .
       69     define variable v-cntxt-userid        as character no-undo .
       70     define variable v-cntxt-level         as character no-undo .
       71     define variable v-cntxt-host-code-obj as integer   no-undo .
       72     define variable v-cntxt-obj-type      as character no-undo .
       73     define variable v-cntxt-obj-code      as integer   no-undo .
       74     define variable v-cntxt-db-num-obj    as integer   no-undo .
       75     define variable v-cntxt-is-admin      as logical   no-undo .
       76   define variable v-ok            as logical   no-undo .
       77   define variable v-ind           as integer   no-undo .
       78   define variable v-err-count     as integer   no-undo .
       79   define variable v-db-num        as integer   no-undo .
       80   define variable v-arm-code-list as character no-undo .
       81   define variable v-obj-name      as character no-undo .
       82   define variable v-user-menu-group-code      as integer   no-undo .
       83   define variable v-filename           as character no-undo .
       84   define temp-table temp-action-item no-undo
       85     field grp-acta-arm-code  as character
       86     field grp-acta-object    as character
       87     field grp-acta-act       as character
       88     field action-item-id     as character
       89     field action-context     as character
       90     index xpk is primary unique grp-acta-arm-code grp-acta-object grp-acta-act
       91     index ie1 action-item-id
       92     index ie2 action-context
       93     .
       94   define temp-table temp-usr-grpa no-undo
       95      field user-name      as character
       96      field arm-code       as character
       97      field grp-name       as character format "X(20)"
       98      field host-code      as integer
       99      index pu is primary unique
      100            user-name
      101            host-code
      102            arm-code
      103   .
      104   define temp-table temp-usr-grpo no-undo
      105      field user-name      as character
      106      field obj-type       as character
      107      field obj-code       as integer
      108      field grp-name       as character format "X(20)"
      109      index pu is primary unique
      110            user-name
      111            obj-type
      112            obj-code
      113   .
      114   define temp-table temp-grpa no-undo
      115      field grp-name       as character format "X(20)"
      116      field arm-code       as character
      117      index pu is primary unique
      118            arm-code
      119            grp-name
      120   .
      121   define temp-table temp-grp-acta no-undo
      122      field grp-name       as character format "X(20)"
      123      field arm-code       as character
      124      field object         as character format "X(15)"
      125      field act            as character format "X(25)"
      126      index pu is primary unique
      127            grp-name
      128            arm-code
      129            object
      130            act
      131   .
      132   define buffer buf_user-login             for ub.user-login .
      133   define buffer buf_user-host              for ub.user-host .
      134   define buffer buf_user-obj               for ub.user-obj .
      135   define buffer buf_clients                for ub.clients .
      136   define buffer buf_action-head            for ub.action-head .
      137   define buffer buf_action-role            for ub.action-role .
      138   define buffer buf_action-role-item       for ub.action-role-item .
      139   define buffer buf_user-login-action-role for ub.user-login-action-role .
      140   define buffer buf_user-menu-group        for ub.user-menu-group .
      141   define buffer buf_temp-action-item       for temp-action-item .
      142   define buffer buf_grpa     for temp-grpa .
      143   define buffer buf_usr-grpa for temp-usr-grpa .
      144   define buffer buf_usr-grpo for temp-usr-grpo .
      145   define buffer buf_grp-acta for temp-grp-acta .
      146   on write of ub.user-host              override do: end.
      147   on write of ub.user-obj               override do: end.
      148   on write of ub.action-head            override do: end.
      149   on write of ub.action-role            override do: end.
      150   on write of ub.action-head            override do: end.
      151   on write of ub.action-role            override do: end.
      152   on write of ub.action-role-item       override do: end.
      153   on write of ub.user-login-action-role override do: end.
      154   on write of ub.user-menu-group        override do: end.
      155   define stream sinp .
      156   define stream sout .
      157   do
      158   on error undo, return error return-value
      159   :
      160     if p-install = false
      161     then do:
      162       message
      163         vss-description skip
      164         "Продолжить?" skip
      165         view-as alert-box question buttons yes-no update v-ok .
      166       if v-ok <> true
      167       then do:
      168         return .
      169       end.
      170     end.
      171     if "rus" = "rus":U
      172     then do:
      173       assign
      174         v-arm-code-list = 'офи':U
      175                         + chr(44) + 'скл':U
      176                         + chr(44) + 'маг':U
      177                         + chr(44) + 'рес':U
      178                         + chr(44) + 'фин':U
      179                         + chr(44) + 'бгх':U
      180                         + chr(44) + 'бух':U
      181                         + chr(44) + 'осн':U
      182                         + chr(44) + 'адм':U
      183         v-obj-name      = 'объ':U
      184       .
      185     end.
      186     else do:
      187       assign
      188         v-arm-code-list = 'off':U
      189                         + chr(44) + 'str':U
      190                         + chr(44) + 'shp':U
      191                         + chr(44) + 'res':U
      192                         + chr(44) + 'fin':U
      193                         + chr(44) + 'eac':U
      194                         + chr(44) + 'acc':U
      195                         + chr(44) + 'fas':U
      196                         + chr(44) + 'adm':U
      197         v-obj-name      = 'object':U
      198       .
      199     end.
      200     run fill-temp-table in this-procedure .
      201     assign
      202       v-db-num = v-cntxt-db-num
      203     .
      204     assign
      205        v-filename = search('usr-grpa.142':U)
      206     .
      207     if v-filename = ?
      208     or v-filename = '':U
      209     then do:
      210       undo, return error substitute("Не найден файл с правами пользователей &1"
      211                                    ,'usr-gpra.142':U
      212                                    ) .
      213     end.
      214       for each buf_usr-grpa
      215       on error undo, return error return-value
      216       :
      217         delete buf_usr-grpa .
      218       end.
      219     input stream sinp from value(v-filename) .
      220     repeat
      221     :
      222       create buf_usr-grpa .
      223       import stream sinp buf_usr-grpa .
      224     end.
      225     input stream sinp close .
      226     assign
      227        v-filename = search('usr-grpo.142':U)
      228     .
      229     if v-filename = ?
      230     or v-filename = '':U
      231     then do:
      232       undo, return error substitute("Не найден файл с правами пользователей &1"
      233                                    ,'usr-grpo.142':U
      234                                    ) .
      235     end.
      236       for each buf_usr-grpo
      237       on error undo, return error return-value
      238       :
      239         delete buf_usr-grpo .
      240       end.
      241     input stream sinp from value(v-filename) .
      242     repeat
      243     :
      244       create buf_usr-grpo .
      245       import stream sinp buf_usr-grpo .
      246     end.
      247     input stream sinp close .
      248     assign
      249        v-filename = search('grpa.142':U)
      250     .
      251     if v-filename = ?
      252     or v-filename = '':U
      253     then do:
      254       undo, return error substitute("Не найден файл с правами пользователей &1"
      255                                    ,'grpa.142':U
      256                                    ) .
      257     end.
      258       for each buf_grpa
      259       on error undo, return error return-value
      260       :
      261         delete buf_grpa .
      262       end.
      263     input stream sinp from value(v-filename) .
      264     repeat
      265     :
      266       create buf_grpa .
      267       import stream sinp buf_grpa .
      268     end.
      269     input stream sinp close .
      270     assign
      271        v-filename = search('grp-acta.142':U)
      272     .
      273     if v-filename = ?
      274     or v-filename = '':U
      275     then do:
      276       undo, return error substitute("Не найден файл с правами пользователей &1"
      277                                    ,'grp-acta.142':U
      278                                    ) .
      279     end.
      280       for each buf_grp-acta
      281       on error undo, return error return-value
      282       :
      283         delete buf_grp-acta .
      284       end.
      285     input stream sinp from value(v-filename) .
      286     repeat
      287     :
      288       create buf_grp-acta .
      289       import stream sinp buf_grp-acta .
      290     end.
      291     input stream sinp close .
      292     for each buf_user-login no-lock
      293       where buf_user-login.db-num = v-db-num
      294     on error undo, return error return-value
      295     :
      296       assign
      297         v-ind = v-ind + 1
      298       .
      299       for each buf_usr-grpa no-lock
      300         where buf_usr-grpa.user-name = buf_user-login.user-login
      301       on error undo, return error return-value
      302       :
      303         find first buf_user-menu-group
      304           where buf_user-menu-group.db-num          = v-db-num
      305             and buf_user-menu-group.user-id         = buf_user-login.user-id
      306             and buf_user-menu-group.menu-code       = 0
      307             and buf_user-menu-group.menu-group-id = buf_usr-grpa.arm-code
      308             and buf_user-menu-group.menu-group-context         = 'firm':U
      309             and buf_user-menu-group.host-code       = buf_usr-grpa.host-code
      310           no-error .
      311         if not available buf_user-menu-group then do:
      312            ASSIGN
      313               v-user-menu-group-code = next-value(s-user-menu-group)
      314            .
      315            create buf_user-menu-group.
      316            assign
      317               buf_user-menu-group.db-num        = v-db-num
      318               buf_user-menu-group.user-id       = buf_user-login.user-id
      319               buf_user-menu-group.menu-code     = 0
      320               buf_user-menu-group.menu-group-id = buf_usr-grpa.arm-code
      321               buf_user-menu-group.menu-group-context       = 'firm':U
      322               buf_user-menu-group.user-menu-group-code      = v-user-menu-group-code
      323               buf_user-menu-group.host-code     = buf_usr-grpa.host-code
      324               buf_user-menu-group.obj-type      = "":U
      325               buf_user-menu-group.obj-code      = 0
      326            .
      327         end.
      328         find first buf_user-host
      329           where buf_user-host.db-num    = v-db-num
      330             and buf_user-host.user-id   = buf_user-login.user-id
      331             and buf_user-host.host-code = buf_usr-grpa.host-code
      332           no-error .
      333         if not available buf_user-host
      334         then do:
      335           create buf_user-host .
      336           assign
      337             buf_user-host.db-num    = v-db-num
      338             buf_user-host.user-id   = buf_user-login.user-id
      339             buf_user-host.host-code = buf_usr-grpa.host-code
      340           .
      341         end.
      342       end.
      343       for each buf_usr-grpo no-lock
      344         where buf_usr-grpo.user-name = buf_user-login.user-login
      345       on error undo, return error return-value
      346       :
      347         find first buf_user-obj
      348           where buf_user-obj.db-num    = v-db-num
      349             and buf_user-obj.user-id   = buf_user-login.user-id
      350             and buf_user-obj.obj-type  = buf_usr-grpo.obj-type
      351             and buf_user-obj.obj-code  = buf_usr-grpo.obj-code
      352           no-error .
      353         if not available buf_user-obj
      354         then do:
      355           find first buf_clients no-lock
      356             where buf_clients.obj-type = buf_usr-grpo.obj-type
      357               and buf_clients.obj-code = buf_usr-grpo.obj-code
      358             no-error .
      359           if not available buf_clients
      360           then do:
      361             assign
      362               v-err-count = v-err-count + 1
      363             .
      364             output stream sout to value('06012350.err':U) append .
      365             export stream sout buf_usr-grpo .
      366             output stream sout close .
      367           end.
      368           else do:
      369             create buf_user-obj .
      370             assign
      371               buf_user-obj.db-num    = v-db-num
      372               buf_user-obj.user-id   = buf_user-login.user-id
      373               buf_user-obj.obj-type  = buf_usr-grpo.obj-type
      374               buf_user-obj.obj-code  = buf_usr-grpo.obj-code
      375               buf_user-obj.host-code = buf_clients.host-code
      376             .
      377           end.
      378         end.
      379       end.
      380     end.
      381     create buf_action-head .
      382     assign
      383       buf_action-head.action-head-code           = 0
      384       buf_action-head.action-head-name           = "Система прав IBS Trade House"
      385       buf_action-head.action-head-control-number = ""
      386     .
      387     define variable v-action-role-code      as integer   no-undo .
      388     define variable v-action-role-item-code as integer   no-undo .
      389     define variable v-user-login-role-code  as integer   no-undo .
      390     assign
      391       v-action-role-code      = 0
      392       v-action-role-item-code = 0
      393       v-user-login-role-code  = 0
      394     .
      395     define variable v-global-action-role-code as integer   no-undo .
      396     define variable v-firm-action-role-code   as integer   no-undo .
      397     define variable v-object-action-role-code as integer   no-undo .
      398     for each buf_grpa no-lock
      399     on error undo, return error return-value
      400     :
      401       assign
      402         v-global-action-role-code = 0
      403         v-firm-action-role-code   = 0
      404         v-object-action-role-code = 0
      405       .
      406       for each buf_grp-acta no-lock
      407         where buf_grp-acta.grp-name = buf_grpa.grp-name
      408           and buf_grp-acta.arm-code = buf_grpa.arm-code
      409       on error undo, return error return-value
      410       :
      411         find first buf_temp-action-item
      412           where buf_temp-action-item.grp-acta-arm-code = buf_grp-acta.arm-code
      413             and buf_temp-action-item.grp-acta-object   = buf_grp-acta.object
      414             and buf_temp-action-item.grp-acta-act      = buf_grp-acta.act
      415           no-error .
      416         if not available buf_temp-action-item
      417         then do:
      418           output stream sout to value('06012351.err':U) append .
      419           export stream sout "unknown_action" buf_grp-acta.arm-code buf_grp-acta.object buf_grp-acta.act .
      420           export stream sout "grp-acta" .
      421           export stream sout buf_grp-acta .
      422           output stream sout close .
      423         end.
      424         else do:
      425           case buf_temp-action-item.action-context
      426           :
      427             when 'global':U
      428             then do:
      429               if v-global-action-role-code = 0
      430               then do:
      431                 assign
      432                   v-action-role-code = NEXT-VALUE(s-action-role)
      433                 .
      434                 create buf_action-role .
      435                 assign
      436                   buf_action-role.db-num              = v-db-num
      437                   buf_action-role.action-head-code    = 0
      438                   buf_action-role.action-role-code    = v-action-role-code
      439                   buf_action-role.action-role-context = buf_temp-action-item.action-context
      440                   buf_action-role.action-role-name    = buf_grpa.arm-code + ' ':U + buf_grpa.grp-name
      441                 .
      442                 assign
      443                   v-global-action-role-code = v-action-role-code
      444                 .
      445               end.
      446               assign
      447                 v-action-role-item-code = NEXT-VALUE(s-action-role-item)
      448               .
      449               create buf_action-role-item .
      450               assign
      451                 buf_action-role-item.db-num                = v-db-num
      452                 buf_action-role-item.action-head-code      = 0
      453                 buf_action-role-item.action-role-code      = v-global-action-role-code
      454                 buf_action-role-item.action-role-item-code = v-action-role-item-code
      455                 buf_action-role-item.action-item-id        = buf_temp-action-item.action-item-id
      456               .
      457             end.
      458             when 'firm':U
      459             then do:
      460               if v-firm-action-role-code = 0
      461               then do:
      462                 assign
      463                   v-action-role-code = NEXT-VALUE(s-action-role)
      464                 .
      465                 create buf_action-role .
      466                 assign
      467                   buf_action-role.db-num              = v-db-num
      468                   buf_action-role.action-head-code    = 0
      469                   buf_action-role.action-role-code    = v-action-role-code
      470                   buf_action-role.action-role-context = buf_temp-action-item.action-context
      471                   buf_action-role.action-role-name    = buf_grpa.arm-code + ' ':U + buf_grpa.grp-name
      472                 .
      473                 assign
      474                   v-firm-action-role-code = v-action-role-code
      475                 .
      476               end.
      477               assign
      478                 v-action-role-item-code = NEXT-VALUE(s-action-role-item)
      479               .
      480               create buf_action-role-item .
      481               assign
      482                 buf_action-role-item.db-num                = v-db-num
      483                 buf_action-role-item.action-head-code      = 0
      484                 buf_action-role-item.action-role-code      = v-firm-action-role-code
      485                 buf_action-role-item.action-role-item-code = v-action-role-item-code
      486                 buf_action-role-item.action-item-id        = buf_temp-action-item.action-item-id
      487               .
      488             end.
      489             when 'object':U
      490             then do:
      491               if v-object-action-role-code = 0
      492               then do:
      493                 assign
      494                   v-action-role-code = NEXT-VALUE(s-action-role)
      495                 .
      496                 create buf_action-role .
      497                 assign
      498                   buf_action-role.db-num              = v-db-num
      499                   buf_action-role.action-head-code    = 0
      500                   buf_action-role.action-role-code    = v-action-role-code
      501                   buf_action-role.action-role-context = buf_temp-action-item.action-context
      502                   buf_action-role.action-role-name    = buf_grpa.arm-code + ' ':U + buf_grpa.grp-name
      503                 .
      504                 assign
      505                   v-object-action-role-code = v-action-role-code
      506                 .
      507               end.
      508               assign
      509                 v-action-role-item-code = NEXT-VALUE(s-action-role-item)
      510               .
      511               create buf_action-role-item .
      512               assign
      513                 buf_action-role-item.db-num                = v-db-num
      514                 buf_action-role-item.action-head-code      = 0
      515                 buf_action-role-item.action-role-code      = v-object-action-role-code
      516                 buf_action-role-item.action-role-item-code = v-action-role-item-code
      517                 buf_action-role-item.action-item-id        = buf_temp-action-item.action-item-id
      518               .
      519             end.
      520             otherwise do:
      521               output stream sout to value('06012351.err':U) append .
      522               export stream sout "unknown_action-context" buf_temp-action-item.action-context .
      523               export stream sout "temp-action-item.action-context" .
      524               export stream sout buf_temp-action-item .
      525               output stream sout close .
      526             end.
      527           end.
      528         end.
      529       end.
      530       if buf_grpa.arm-code = v-obj-name
      531       then do:
      532         for each buf_usr-grpo no-lock
      533           where buf_usr-grpo.grp-name = buf_grpa.grp-name
      534         on error undo, return error return-value
      535         :
      536           find first buf_user-login no-lock
      537             where buf_user-login.db-num     = v-db-num
      538               and buf_user-login.user-login = buf_usr-grpo.user-name
      539             no-error .
      540           if not available buf_user-login
      541           then do:
      542             output stream sout to value('06012351.err':U) append .
      543             export stream sout "unknown_user-name" buf_usr-grpo.user-name .
      544             export stream sout "usr-grpo" .
      545             export stream sout buf_usr-grpo .
      546             output stream sout close .
      547           end.
      548           else do:
      549             find first buf_clients no-lock
      550               where buf_clients.obj-type = buf_usr-grpo.obj-type
      551                 and buf_clients.obj-code = buf_usr-grpo.obj-code
      552               no-error .
      553             if not available buf_clients
      554             then do:
      555               output stream sout to value('06012351.err':U) append .
      556               export stream sout "unknown_obj-type_obj-code" buf_usr-grpo.obj-type buf_usr-grpo.obj-code .
      557               export stream sout "usr-grpo" .
      558               export stream sout buf_usr-grpo .
      559               output stream sout close .
      560             end.
      561             else do:
      562               if v-global-action-role-code <> 0
      563               then do:
      564                 assign
      565                   v-user-login-role-code = NEXT-VALUE(s-user-login-action-role)
      566                 .
      567                 create buf_user-login-action-role .
      568                 assign
      569                   buf_user-login-action-role.db-num               = v-db-num
      570                   buf_user-login-action-role.action-head-code     = 0
      571                   buf_user-login-action-role.user-login-role-code = v-user-login-role-code
      572                   buf_user-login-action-role.user-id              = buf_user-login.user-id
      573                   buf_user-login-action-role.action-role-code     = v-global-action-role-code
      574                   buf_user-login-action-role.action-role-context  = 'global':U
      575                   buf_user-login-action-role.host-code            = 0
      576                   buf_user-login-action-role.obj-type             = '':U
      577                   buf_user-login-action-role.obj-code             = 0
      578                   buf_user-login-action-role.gds-grp-code         = ?
      579                   buf_user-login-action-role.gds-code             = ?
      580                   buf_user-login-action-role.cli-grp-code         = ?
      581                 .
      582               end.
      583               if v-firm-action-role-code <> 0
      584               then do:
      585                 assign
      586                   v-user-login-role-code = NEXT-VALUE(s-user-login-action-role)
      587                 .
      588                 create buf_user-login-action-role .
      589                 assign
      590                   buf_user-login-action-role.db-num               = v-db-num
      591                   buf_user-login-action-role.action-head-code     = 0
      592                   buf_user-login-action-role.user-login-role-code = v-user-login-role-code
      593                   buf_user-login-action-role.user-id              = buf_user-login.user-id
      594                   buf_user-login-action-role.action-role-code     = v-firm-action-role-code
      595                   buf_user-login-action-role.action-role-context  = 'firm':U
      596                   buf_user-login-action-role.host-code            = buf_clients.host-code
      597                   buf_user-login-action-role.obj-type             = '':U
      598                   buf_user-login-action-role.obj-code             = 0
      599                   buf_user-login-action-role.gds-grp-code         = ?
      600                   buf_user-login-action-role.gds-code             = ?
      601                   buf_user-login-action-role.cli-grp-code         = ?
      602                 .
      603               end.
      604               if v-object-action-role-code <> 0
      605               then do:
      606                 assign
      607                   v-user-login-role-code = NEXT-VALUE(s-user-login-action-role)
      608                 .
      609                 create buf_user-login-action-role .
      610                 assign
      611                   buf_user-login-action-role.db-num               = v-db-num
      612                   buf_user-login-action-role.action-head-code     = 0
      613                   buf_user-login-action-role.user-login-role-code = v-user-login-role-code
      614                   buf_user-login-action-role.user-id              = buf_user-login.user-id
      615                   buf_user-login-action-role.action-role-code     = v-object-action-role-code
      616                   buf_user-login-action-role.action-role-context  = 'object':U
      617                   buf_user-login-action-role.host-code            = buf_clients.host-code
      618                   buf_user-login-action-role.obj-type             = buf_clients.obj-type
      619                   buf_user-login-action-role.obj-code             = buf_clients.obj-code
      620                   buf_user-login-action-role.gds-grp-code         = ?
      621                   buf_user-login-action-role.gds-code             = ?
      622                   buf_user-login-action-role.cli-grp-code         = ?
      623                 .
      624               end.
      625             end.
      626           end.
      627         end.
      628       end.
      629       else do:
      630         for each buf_usr-grpa no-lock
      631           where buf_usr-grpa.grp-name = buf_grpa.grp-name
      632             and buf_usr-grpa.arm-code = buf_grpa.arm-code
      633         on error undo, return error return-value
      634         :
      635           find first buf_user-login no-lock
      636             where buf_user-login.db-num     = v-db-num
      637               and buf_user-login.user-login = buf_usr-grpa.user-name
      638             no-error .
      639           if not available buf_user-login
      640           then do:
      641             output stream sout to value('06012351.err':U) append .
      642             export stream sout "unknown_user-name" buf_usr-grpa.user-name .
      643             export stream sout "usr-grpa" .
      644             export stream sout buf_usr-grpa .
      645             output stream sout close .
      646           end.
      647           else do:
      648             find first buf_clients no-lock
      649               where buf_clients.obj-type = 'орг':U
      650                 and buf_clients.obj-code = buf_usr-grpa.host-code
      651               no-error .
      652             if not available buf_clients
      653             then do:
      654               output stream sout to value('06012351.err':U) append .
      655               export stream sout "unknown_host-code" buf_usr-grpa.host-code .
      656               export stream sout "usr-grpa" .
      657               export stream sout buf_usr-grpa .
      658               output stream sout close .
      659             end.
      660             else do:
      661               if v-global-action-role-code <> 0
      662               then do:
      663                 assign
      664                   v-user-login-role-code = NEXT-VALUE(s-user-login-action-role)
      665                 .
      666                 create buf_user-login-action-role .
      667                 assign
      668                   buf_user-login-action-role.db-num               = v-db-num
      669                   buf_user-login-action-role.action-head-code     = 0
      670                   buf_user-login-action-role.user-login-role-code = v-user-login-role-code
      671                   buf_user-login-action-role.user-id              = buf_user-login.user-id
      672                   buf_user-login-action-role.action-role-code     = v-global-action-role-code
      673                   buf_user-login-action-role.action-role-context  = 'global':U
      674                   buf_user-login-action-role.host-code            = 0
      675                   buf_user-login-action-role.obj-type             = '':U
      676                   buf_user-login-action-role.obj-code             = 0
      677                   buf_user-login-action-role.gds-grp-code         = ?
      678                   buf_user-login-action-role.gds-code             = ?
      679                   buf_user-login-action-role.cli-grp-code         = ?
      680                 .
      681               end.
      682               if v-firm-action-role-code <> 0
      683               then do:
      684                 assign
      685                   v-user-login-role-code = NEXT-VALUE(s-user-login-action-role)
      686                 .
      687                 create buf_user-login-action-role .
      688                 assign
      689                   buf_user-login-action-role.db-num               = v-db-num
      690                   buf_user-login-action-role.action-head-code     = 0
      691                   buf_user-login-action-role.user-login-role-code = v-user-login-role-code
      692                   buf_user-login-action-role.user-id              = buf_user-login.user-id
      693                   buf_user-login-action-role.action-role-code     = v-firm-action-role-code
      694                   buf_user-login-action-role.action-role-context  = 'firm':U
      695                   buf_user-login-action-role.host-code            = buf_clients.obj-code
      696                   buf_user-login-action-role.obj-type             = '':U
      697                   buf_user-login-action-role.obj-code             = 0
      698                   buf_user-login-action-role.gds-grp-code         = ?
      699                   buf_user-login-action-role.gds-code             = ?
      700                   buf_user-login-action-role.cli-grp-code         = ?
      701                 .
      702               end.
      703             end.
      704           end.
      705         end.
      706       end.
      707     end.
      708     return substitute("Обработано записей &1. Ошибок &2"
      709                      ,v-ind
      710                      ,v-err-count
      711                      ) .
      712   end.
      713   procedure fill-temp-table :
      714     define variable v-grp-acta-arm-code  as character no-undo .
      715     define variable v-grp-acta-object    as character no-undo .
      716     define variable v-grp-acta-act       as character no-undo .
      717     define variable v-action-item-id     as character no-undo .
      718     define variable v-action-context     as character no-undo .
      719     define buffer buf_temp-action-item for temp-action-item .
      720     do
      721     on error undo, return error return-value
      722     :
      723       input stream sinp from value('right142.txt':U).
      724       repeat
      725       :
      726         assign
      727           v-grp-acta-arm-code  = '':U
      728           v-grp-acta-object    = '':U
      729           v-grp-acta-act       = '':U
      730           v-action-item-id     = '':U
      731           v-action-context     = '':U
      732         .
      733         import stream sinp
      734           v-grp-acta-arm-code
      735           v-grp-acta-object
      736           v-grp-acta-act
      737           v-action-item-id
      738           v-action-context
      739           .
      740         create buf_temp-action-item .
      741         assign
      742           buf_temp-action-item.grp-acta-arm-code  = v-grp-acta-arm-code
      743           buf_temp-action-item.grp-acta-object    = v-grp-acta-object
      744           buf_temp-action-item.grp-acta-act       = v-grp-acta-act
      745           buf_temp-action-item.action-item-id     = v-action-item-id
      746           buf_temp-action-item.action-context     = v-action-context
      747         .
      748       end.
      749       input stream sinp close .
      750     end.
      751   end procedure.
