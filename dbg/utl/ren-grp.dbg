        1   define input  parameter p-node-code as integer   no-undo .
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Создание симметричной шкалы признаков".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      115   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      116   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      117   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      118   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      119   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      120   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      121   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      122   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      123   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      124   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      125   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      126   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      127   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      128   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      129   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      130   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      131   define variable sc-name like ub.gds-prt.node-name format "x(40)" label "Название шкалы" no-undo.
      132   def temp-table temp-level no-undo
      133       field num  as integer
      134       field ord  as integer
      135       field name like ub.gds-prt.node-name
      136       index num is primary unique num .
      137   def temp-table temp-node no-undo
      138       field num  as integer
      139       field ord  as integer
      140       field name like ub.gds-prt.node-name
      141       index num  is primary unique num ord.
      142   def query temp-level for temp-level .
      143   def browse temp-level query temp-level
      144          disp temp-level.name
      145          with size 35 by 10 no-labels title "Уровни".
      146   def query temp-node for temp-node .
      147   def browse temp-node query temp-node
      148          display temp-node.name
      149          with size 35 by 10 no-labels title "Признаки".
      150   def button b-exit auto-go default
      151        LABEL "&Выход"
      152        SIZE 10 BY 1.
      153   def button b-help
      154       label "Помо&щь"
      155        SIZE 10 BY 1.
      156   def button b-upd-nd
      157       label "&Изменить"
      158        SIZE 10 BY 1.
      159   DEF FRAME td
      160     b-exit     AT ROW  1   COL  1
      161     b-help     AT ROW  1   COL 11
      162     sc-name    AT ROW  2.5 COL  5
      163     temp-level AT ROW  4   COL  1
      164     temp-node  AT ROW  4   COL 37
      165     b-upd-nd   AT ROW 14.5 COL 45
      166   WITH VIEW-AS DIALOG-BOX SCROLLABLE SIDE-LABELS THREE-D DEFAULT-BUTTON b-exit TITLE "".
      167   on go of frame td do:
      168   end.
      169   on choose of b-upd-nd
      170   or return of temp-node
      171   or default-action of temp-node
      172   do:
      173     run upd-nd in this-procedure .
      174   end.
      175   ON WINDOW-CLOSE OF FRAME td APPLY "END-ERROR":U TO SELF.
      176   on value-changed of temp-level in frame td do:
      177     run open-temp-node in this-procedure .
      178   end.
      179   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   on help of frame td
      181   do:
      182     run gbl/app_help.p
      183       (input this-procedure :file-name
      184       ,input ''
      185       ,input ?
      186       ) no-error.
      187     if error-status :error then do:
      188       message
      189         "Ошибка при вызове помощи"
      190         error-status :get-message(1)
      191         view-as alert-box .
      192     end.
      193   end.
      194   run minbtn-set in this-procedure .
      195   on choose of b-help in frame td
      196   do:
      197     apply "help":u to frame td .
      198   end.
      199   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   procedure minbtn-set :
      201       do
      202           on error undo, return error return-value
      203           :
      204           define variable ii              as integer       no-undo .
      205           define variable fh              as widget-handle no-undo .
      206           define variable hh              as widget-handle no-undo .
      207           define variable v-h             as handle        extent 4 no-undo .
      208           define variable v-name-button   as character     no-undo .
      209           define variable v-help-old-x    as decimal       no-undo .
      210           define variable v-help-old-y    as decimal       no-undo .
      211           define variable v-help-old-size as decimal       no-undo .
      212           define variable v-frame-width   as decimal       no-undo .
      213           define variable jj              as integer       no-undo .
      214           do
      215               on error undo, return error
      216               :
      217               assign
      218                   v-frame-width = frame td:width - 0.3
      219                   fh            = frame td:first-child
      220                   hh            = fh:first-child
      221                   ii            = 1
      222                   .
      223               do while valid-handle(hh):
      224                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      225                   do:
      226                       case lc(hh:name) :
      227                           when "b-help" then
      228                               do:
      229                                   hh:load-image-up("cmp/b-help.bmp":u) .
      230                                   hh:load-image-down("cmp/b-help.bmp":u) .
      231                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      232                                   hh:TOOLTIP = "Помощь" .
      233                                   v-help-old-x = hh:column .
      234                                   v-help-old-y = hh:row    .
      235                                   v-help-old-size = hh:width .
      236                                   hh:width-chars = 2.5 .
      237                               end.
      238                           when "b-print" then
      239                               do:
      240                                   hh:load-image("cmp/b-print.bmp":u) .
      241                                   hh:TOOLTIP = "Печать" .
      242                                   v-h[ii] = hh:handle .
      243                                   ii = ii + 1 .
      244                                   hh:width-chars = 3 .
      245                               end.
      246                           when "b-history" or
      247                           when "b-hist" then
      248                               do:
      249                                   hh:load-image("cmp/b-hist.bmp":u) .
      250                                   hh:TOOLTIP = "История" .
      251                                   v-h[ii] = hh:handle .
      252                                   ii = ii + 1 .
      253                                   hh:width-chars = 3 .
      254                               end.
      255                           when "b-sch" then
      256                               do:
      257                                   hh:load-image("cmp/b-sch.bmp":u) .
      258                                   hh:TOOLTIP = "Установка Фильтра" .
      259                                   v-h[ii] = hh:handle .
      260                                   ii = ii + 1 .
      261                                   hh:width-chars = 3 .
      262                               end.
      263                           when "b-hist-user" then
      264                               do:
      265                                   hh:load-image("cmp/b-hist.bmp":u) .
      266                                   hh:TOOLTIP = "История пользователя" .
      267                                   ii = ii + 1 .
      268                               end.
      269                       end case.
      270                   end.
      271                   hh = hh:next-sibling.
      272               end.
      273               b-help:column = v-frame-width - b-help:width-chars.
      274               jj = 0.
      275               repeat ii = 4 to 1 by -1 :
      276                   if valid-handle (v-h[ii] ) then
      277                   do:
      278                       jj  = jj + 1 .
      279                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      280                       v-h[ii]:row    = v-help-old-y .
      281                   end.
      282               end.
      283           end.
      284       end.
      285   end procedure.
      286   do
      287   on error undo, return error return-value
      288   :
      289     assign
      290       frame td :title = "Шкала"
      291     .
      292     run open-all in this-procedure .
      293     temp-level :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
      294     temp-node :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
      295     enable
      296       temp-level temp-node b-exit b-upd-nd b-help
      297       with frame td.
      298     wait-for go of frame td.
      299   end.
      300   procedure prt-tree :
      301     def input param uc like ub.gds-prt.upper-code no-undo.
      302     def buffer buf_gds-prt   for ub.gds-prt.
      303     define variable nc         as int no-undo.
      304     define variable next-level as log no-undo.
      305     find first buf_gds-prt where buf_gds-prt.upper-code = uc.
      306     find temp-level where temp-level.num = buf_gds-prt.lvl-num.
      307     assign
      308       temp-level.ord = 0
      309       nc = buf_gds-prt.node-code
      310       .
      311     if can-find (first buf_gds-prt where buf_gds-prt.upper-code = nc)
      312     then do:
      313       next-level = yes.
      314     end.
      315     else do:
      316       next-level = no.
      317     end.
      318     for each buf_gds-prt
      319       where buf_gds-prt.upper-code = uc
      320     :
      321       if buf_gds-prt.prt-num > temp-level.ord
      322       then do:
      323         assign
      324           temp-level.ord = buf_gds-prt.prt-num
      325         .
      326       end.
      327       create temp-node.
      328       assign
      329         temp-node.num  = buf_gds-prt.lvl-num
      330         temp-node.ord  = buf_gds-prt.prt-num
      331         temp-node.name = buf_gds-prt.node-name
      332       .
      333     end.
      334     if next-level
      335     then do:
      336       run prt-tree (nc).
      337     end.
      338   end procedure.
      339   PROCEDURE upd-nd :
      340     define variable ri as recid no-undo .
      341     if not available temp-node
      342     then do:
      343       return .
      344     end.
      345     define variable v-node-name as character no-undo .
      346     assign
      347       v-node-name = temp-node.name
      348     .
      349     run gbl/d-prompt.w (
      350         'title=':u + "Имя признака" + '\':u
      351       + 'text1=':u + "Имя признака" + '\':u
      352       + 'format=x(16)\':u
      353       + 'type=char\':u
      354       ,input-output v-node-name
      355       ).
      356     if return-value = 'false':u then do:
      357       return .
      358     end.
      359     if v-node-name = ""
      360     then do:
      361       message
      362         "Не задано значение признака" skip
      363         view-as alert-box information .
      364       return .
      365     end.
      366     if can-find(first temp-node
      367       where temp-node.num = temp-level.num
      368         and temp-node.name = v-node-name
      369         and recid( temp-node ) <> ri )
      370     then do:
      371       message
      372         "Признак" v-node-name "уже есть" skip
      373         view-as alert-box information .
      374       return .
      375     end.
      376     run utl/rengdprt.p
      377       (input p-node-code
      378       ,input temp-level.num
      379       ,input temp-node.name
      380       ,input v-node-name
      381       ) .
      382     run open-all in this-procedure .
      383   END PROCEDURE.
      384   procedure open-temp-level :
      385     do
      386     on error undo, return error return-value
      387     :
      388       open query temp-level for each temp-level.
      389     end.
      390   end procedure.
      391   procedure open-temp-node :
      392     do
      393     on error undo, return error return-value
      394     :
      395       open query temp-node for each temp-node where temp-node.num = temp-level.num.
      396     end.
      397   end procedure.
      398   procedure open-all :
      399     do
      400     on error undo, return error return-value
      401     :
      402       find ub.gds-prt
      403         where ub.gds-prt.node-code = p-node-code
      404         .
      405       if ub.gds-prt.node-name = '_Пустая шкала':U
      406       then do:
      407         message
      408           "Изменение пустой шкалы невозможно."
      409           view-as alert-box error.
      410         undo, return error return-value .
      411       end.
      412       assign
      413         sc-name  = ub.gds-prt.node-name
      414       .
      415       for each temp-level
      416       :
      417         delete temp-level .
      418       end.
      419       for each temp-node
      420       :
      421         delete temp-node .
      422       end.
      423       for each ub.lvl-name
      424         where lvl-name.upper-code = ub.gds-prt.upper-code
      425       :
      426         create temp-level.
      427         assign
      428           temp-level.num = ub.lvl-name.level
      429           temp-level.name = ub.lvl-name.lvl-name
      430         .
      431       end.
      432       run prt-tree in this-procedure
      433         (input p-node-code
      434         ).
      435       disp sc-name with frame td.
      436       run open-temp-level in this-procedure .
      437       run open-temp-node in this-procedure .
      438     end.
      439   end procedure.
