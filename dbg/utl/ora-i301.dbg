     4693                     buf_doc-line.artic    = p-artic         and
     4694                     buf_doc-line.prod-type   = p-prod-type  and
     4695                     buf_doc-line.prod-code   = p-prod-code no-error .
     4696           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     4697           find first buf_gds-dtl no-lock where
     4698                      buf_gds-dtl.doc-code  = v-doc-code   and
     4699                      buf_gds-dtl.artic     = p-artic      and
     4700                      buf_gds-dtl.prod-type = p-prod-type  and
     4701                      buf_gds-dtl.prod-code = p-prod-code  and
     4702                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     4703           assign
     4704             v1 = recid (buf_trn-doc)
     4705             v2 = recid (buf_doc-line)
     4706             v3 = recid (buf_gds-dtl)
     4707             v4  = buf_gds-dtl.prt-code
     4708             no-error .
     4709             if not v-base then do:
     4710               run str/pr-wbil.p
     4711               ( input ""            ,
     4712                 input 'Накладная':U ,
     4713                 input v1               ,
     4714                 input v2               ,
     4715                 input v3               ,
     4716                 input v-doc-code       ,
     4717                 input ""               ,
     4718                 input p-gds-code       ,
     4719                 input p-artic          ,
     4720                 input p-prod-type      ,
     4721                 input p-prod-code      ,
     4722                 input v4               ,
     4723                 input 0                ,
     4724                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4725                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4726                 output cost-rubl       ,
     4727                 output v4
     4728                 ) no-error .
     4729             end.
     4730             else do:
     4731               run str/pr-wbil.p
     4732               ( input ""            ,
     4733                 input 'Накладная':U ,
     4734                 input v1               ,
     4735                 input v2               ,
     4736                 input v3               ,
     4737                 input v-doc-code       ,
     4738                 input ""               ,
     4739                 input p-gds-code       ,
     4740                 input p-artic          ,
     4741                 input p-prod-type      ,
     4742                 input p-prod-code      ,
     4743                 input v4               ,
     4744                 input 0                ,
     4745                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4746                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4747                 output cost-base       ,
     4748                 output v4
     4749                 ) no-error .
     4750             end.
     4751             if not error-status :error then
     4752                 assign
     4753                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     4754                .
     4755       end.
     4756       when 'Переоценка':U then do:
     4757         find prev-list where
     4758              prev-list.b-code     = p-b-code and
     4759              prev-list.price-type = "" and
     4760              prev-list.doc-num    = v-doc-code no-lock no-error.
     4761         if available prev-list then
     4762           assign
     4763             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     4764             cur-rt-base = prev-list.road-tax
     4765             cur-rt-rubl = prev-list.road-tax
     4766             cost-rubl = prev-list.price-sale
     4767             cost-base = prev-list.price-sale
     4768             .
     4769         else
     4770           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     4771                   "- расчет невозможен."
     4772                   view-as alert-box information .
     4773       end.
     4774       when 'ДокФормЦены':U then do:
     4775       find first b_price-doc-forming no-lock where
     4776                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     4777                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     4778                  no-error .
     4779         find b_price-doc-forming-gds no-lock where
     4780              b_price-doc-forming-gds.b-code     = p-b-code and
     4781              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     4782              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     4783              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     4784              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     4785              no-error.
     4786         if available b_price-doc-forming-gds then
     4787           assign
     4788             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     4789             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     4790             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     4791             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     4792             cost-base   = b_price-doc-forming-gds.price-sale-base
     4793             .
     4794         else
     4795           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     4796                   "для товара :" skip
     4797                    "Бар-код" p-b-code     skip
     4798                    "Артикул" p-artic      skip
     4799                     p-prod-type  skip
     4800                     p-prod-code  skip
     4801                   "- расчет невозможен."
     4802                   view-as alert-box information .
     4803       end.
     4804       when 'Единая':U then do:
     4805           assign
     4806             p-new-calc-method = 'Единая':U + " " + string(common-price)
     4807             cost-rubl = common-price
     4808             cost-base = common-price
     4809             .
     4810       end.
     4811       when 'Объект':U then do:
     4812       find first buf_gds-obj no-lock where
     4813                  buf_gds-obj.gds-code = p-gds-code and
     4814                  buf_gds-obj.obj-type = v-copy-type and
     4815                  buf_gds-obj.obj-code = v-copy-code no-error .
     4816           if available buf_gds-obj then do:
     4817           assign
     4818             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     4819             cost-rubl = buf_gds-obj.price-sale
     4820             cost-base = buf_gds-obj.price-sale
     4821             .
     4822           end.
     4823           else do:
     4824               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     4825                       "для товара :" p-artic  "- расчет невозможен."
     4826                       view-as alert-box information .
     4827           end.
     4828       end.
     4829      when 'Отсутствует':U or
     4830      when "" then do:
     4831         run str/mplnovat.p
     4832           ( input  'Отсутствует':U    ,
     4833             input  table x_obj-group ,
     4834             input  p-b-code    ,
     4835             input  p-artic     ,
     4836             input  p-prod-type ,
     4837             input  p-prod-code ,
     4838             input  0 ,
     4839             input  v-doc-code ,
     4840             input  p-vat-pc      ,
     4841             input  p-slt-pc      ,
     4842             output vd  ,
     4843             output vd  ,
     4844             output cost-base   ,
     4845             output cost-rubl   ,
     4846             output cur-rt-base ,
     4847             output cur-rt-rubl
     4848             ).
     4849             cost-rubl = vd * p-exch-rate / p-exch-scale .
     4850             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4851             p-new-calc-method = 'Отсутствует':U .
     4852      end.
     4853      when 'Основная':U then do:
     4854      end.
     4855       when 'ПорогПр-НДС':U then do:
     4856         find first x_obj-group.
     4857             run calc-price-levelprod (
     4858               input 2          ,
     4859               input var-pr-r-b ,
     4860               input p-b-code   ,
     4861               input x_obj-group.obj-type ,
     4862               input x_obj-group.obj-code ,
     4863               output vd,
     4864               output v-descript
     4865             ) no-error.
     4866         if vd = 0 or vd = ?  then do:
     4867           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4868                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4869                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4870                   view-as alert-box question buttons OK-Cancel title "#4" update g#log1 as logical .
     4871         end.
     4872         else do:
     4873             cost-rubl = vd .
     4874             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4875             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4876         end.
     4877       end.
     4878       when 'ПорогПр+НДС':U then do:
     4879         find first x_obj-group.
     4880             run calc-price-levelprod (
     4881               input 1          ,
     4882               input var-pr-r-b ,
     4883               input p-b-code   ,
     4884               input x_obj-group.obj-type ,
     4885               input x_obj-group.obj-code ,
     4886               output vd ,
     4887               output v-descript
     4888             ) no-error.
     4889         if vd = 0 or vd = ?  then do:
     4890           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4891                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4892                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4893                   view-as alert-box information .
     4894         end.
     4895         else do:
     4896             cost-rubl = vd .
     4897             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4898             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4899         end.
     4900       end.
     4901       when 'Производит':U
     4902       then do:
     4903         find first x_obj-group.
     4904   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4905   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4906   (  input  p-b-code
     4907    , input  x_obj-group.obj-type
     4908    , input  x_obj-group.obj-code
     4909    , output v-PriceWithVat
     4910    , output vd
     4911    , output v-prod-vat
     4912    , output v-str1
     4913    , output v-str1
     4914           ) no-error .
     4915         if error-status :error then
     4916         message
     4917           vss-workfile vss-revision vss-description skip
     4918           error-status :get-message(1) skip
     4919           return-value skip
     4920           "proprice.i"
     4921           view-as alert-box error
     4922         .
     4923         if vd = 0 or vd = ?  then do:
     4924           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4925                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4926                   "- расчет по производителю от последней приходной накладной невозможен."
     4927                   view-as alert-box question buttons OK-Cancel title "#3" update g#log as logical .
     4928         end.
     4929         else do:
     4930             cost-rubl = vd .
     4931             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4932             p-new-calc-method = p-calc-method .
     4933         end.
     4934       end.
     4935       when 'Произв-НДС':U
     4936       then do:
     4937         find first x_obj-group.
     4938   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4939   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4940   (  input  p-b-code
     4941    , input  x_obj-group.obj-type
     4942    , input  x_obj-group.obj-code
     4943    , output vd
     4944    , output v-PriceWithVat
     4945    , output v-prod-vat
     4946    , output v-str1
     4947    , output v-str1
     4948           ) no-error .
     4949         if error-status :error then
     4950         message
     4951           vss-workfile vss-revision vss-description skip
     4952           error-status :get-message(1) skip
     4953           return-value skip
     4954           "proprice.i"
     4955           view-as alert-box error
     4956         .
     4957         if vd = 0 or vd = ?  then do:
     4958           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4959                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4960                   "- расчет по производителю от последней приходной накладной невозможен."
     4961                   view-as alert-box  .
     4962         end.
     4963         else do:
     4964             cost-rubl = vd .
     4965             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4966             p-new-calc-method = p-calc-method .
     4967         end.
     4968       end.
     4969      when 'Спецификация':U
     4970      then do:
     4971         find first x_obj-group.
     4972         assign
     4973           v-num-specif    = 0
     4974           v-contract-code = 0
     4975         .
     4976         for each buf_contract no-lock
     4977         where buf_contract.host-code = v-cntxt-host-code-obj
     4978         :
     4979   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4980   ASSIGN
     4981      i-gl-Host-Code      = 0
     4982      i-gl-Contract-Code  = 0
     4983      i-gl-Extent3        = 0
     4984      .
     4985   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4986       INPUT  v-cntxt-host-code-obj,
     4987       INPUT  buf_contract.contract-code,
     4988       OUTPUT i-gl-Extent3
     4989      ).
     4990   IF i-gl-Extent3[1] = 2 THEN DO:
     4991      ASSIGN
     4992         i-gl-Host-Code      = i-gl-Extent3[2]
     4993         i-gl-Contract-Code  = i-gl-Extent3[3]
     4994         .
     4995   END. ELSE DO:
     4996      ASSIGN
     4997         i-gl-Host-Code      = v-cntxt-host-code-obj
     4998         i-gl-Contract-Code  = buf_contract.contract-code
     4999         .
     5000   END.
     5001   FOR EACH
     5002       buf_contract-specif
     5003        NO-LOCK
     5004        WHERE
     5005            buf_contract-specif.Host-code    = i-gl-Host-Code
     5006        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5007              :
     5008               if buf_contract-specif.gds-code = p-gds-code then do:
     5009                 assign
     5010                   v-num-specif = v-num-specif + 1
     5011                   v-contract-code = buf_contract.contract-code
     5012                 .
     5013               end.
     5014           end.
     5015         end.
     5016         if v-num-specif > 1 then do:
     5017            run str/gds-cnts.w
     5018               (input parparentproc
     5019               ,input p-gds-code
     5020               , "b-sel":U
     5021               ,output v-spis
     5022             ) no-error.
     5023           find first buf_contract-specif no-lock
     5024           where recid(buf_contract-specif) = integer(v-spis)
     5025             no-error.
     5026             if available buf_contract-specif then do:
     5027                 run read-bonus (
     5028                     input  buf_contract-specif.contract-num  ,
     5029                     input  buf_contract-specif.host-code     ,
     5030                     input  buf_contract-specif.gds-code      ,
     5031                     output v-bonus  ) .
     5032                 assign
     5033                   cost-rubl = buf_contract-specif.price-cli
     5034                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5035                   p-new-calc-method = 'Спецификация':U
     5036                 .
     5037                 if v-bonus <> ? and v-bonus <> 0 then do:
     5038                    assign
     5039                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5040                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5041                    .
     5042                 end.
     5043             end.
     5044             else do:
     5045               message "Не найдена спецификация с recid " v-spis skip
     5046                       "для товара с артикулом " p-artic skip
     5047                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5048                       view-as alert-box information .
     5049             end.
     5050         end.
     5051         if v-num-specif = 0 then do:
     5052             message "Не найдена ни одна спецификация" skip
     5053                     "для товара с артикулом " p-artic skip
     5054                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5055                     view-as alert-box information .
     5056         end.
     5057         if v-num-specif = 1 then do:
     5058   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5059   ASSIGN
     5060      i-gl-Host-Code      = 0
     5061      i-gl-Contract-Code  = 0
     5062      i-gl-Extent3        = 0
     5063      .
     5064   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5065       INPUT  v-cntxt-host-code-obj,
     5066       INPUT  v-contract-code,
     5067       OUTPUT i-gl-Extent3
     5068      ).
     5069   IF i-gl-Extent3[1] = 2 THEN DO:
     5070      ASSIGN
     5071         i-gl-Host-Code      = i-gl-Extent3[2]
     5072         i-gl-Contract-Code  = i-gl-Extent3[3]
     5073         .
     5074   END. ELSE DO:
     5075      ASSIGN
     5076         i-gl-Host-Code      = v-cntxt-host-code-obj
     5077         i-gl-Contract-Code  = v-contract-code
     5078         .
     5079   END.
     5080   FOR EACH
     5081       buf_contract-specif
     5082        NO-LOCK
     5083        WHERE
     5084            buf_contract-specif.Host-code    = i-gl-Host-Code
     5085        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5086               :
     5087               if buf_contract-specif.gds-code = p-gds-code then do:
     5088                 run read-bonus (
     5089                     input  buf_contract-specif.contract-num  ,
     5090                     input  buf_contract-specif.host-code     ,
     5091                     input  buf_contract-specif.gds-code      ,
     5092                     output v-bonus  ) .
     5093                 assign
     5094                   cost-rubl = buf_contract-specif.price-cli
     5095                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5096                   p-new-calc-method = 'Спецификация':U
     5097                 .
     5098                 if v-bonus <> ? and v-bonus <> 0 then do:
     5099                    assign
     5100                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5101                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5102                    .
     5103                 end.
     5104               end.
     5105             end.
     5106         end.
     5107      end.
     5108      otherwise do:
     5109        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     5110                  p-new-calc-method  skip
     5111                 "p-price-prev-doc " p-price-prev-doc  skip
     5112                 "mpl-lib ERR !!! " skip
     5113                 'артикул ' p-artic skip
     5114                 view-as alert-box information .
     5115      end.
     5116    end case.
     5117   run main-road-taxs in this-procedure
     5118     ( input p-artic     ,
     5119       input p-prod-type ,
     5120       input p-prod-code ,
     5121       input-output cur-rt-base ,
     5122       input-output cur-rt-rubl )
     5123       .
     5124     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     5125       return error "Не определен курс валюты документа" .
     5126     end.
     5127     if p-base-scale = 0  or  p-base-scale = ?  then do:
     5128        return error "Не определен курс базовой валюты " .
     5129     end.
     5130   if v-base = false then var-pr-r-b = "rubl":U .
     5131                     else var-pr-r-b =  "base":U .
     5132       if var-pr-r-b = "rubl":U then do:
     5133            case p-calc-method :
     5134            when 'ПорогПр-НДС':U then do:
     5135               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     5136            end.
     5137            when 'ПорогПр+НДС':U then do:
     5138               p-price-sale-rubl  =  cost-rubl .
     5139            end.
     5140            when  'Производит':U then do:
     5141               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     5142            end.
     5143            when  'Произв-НДС':U then do:
     5144               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     5145            end.
     5146            otherwise do:
     5147               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     5148            end.
     5149           end case.
     5150           assign
     5151             p-price-calc-rubl  =  cost-rubl
     5152             p-road-tax-rubl    =  cur-rt-rubl
     5153             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5154             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5155             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5156           .
     5157       end.
     5158       else do:
     5159            case p-calc-method:
     5160               when 'ПорогПр-НДС':U then do:
     5161                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     5162               end.
     5163               when 'ПорогПр+НДС':U then do:
     5164                   p-price-sale-base  =  cost-base .
     5165               end.
     5166               when 'Производит':U then do:
     5167                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     5168               end.
     5169               when 'Произв-НДС':U then do:
     5170                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     5171               end.
     5172               otherwise do:
     5173                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     5174               end.
     5175            end case.
     5176           assign
     5177             p-price-calc-base  =  cost-base
     5178             p-road-tax-base    =  cur-rt-base
     5179             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     5180             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     5181             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     5182             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5183             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5184             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5185           .
     5186       end.
     5187      if p-price-sale-doc <> 0 then do:
     5188   case p-round-method :
     5189     when '9-окончание':U then do:
     5190       if p-price-sale-doc < 29 then do:
     5191         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     5192           assign
     5193             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     5194           .
     5195         end.
     5196       end.
     5197       else do:
     5198         if (p-price-sale-doc modulo 10) < 3 then do:
     5199           assign
     5200             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5201                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5202                   - 1 ) * 10
     5203                 + 9
     5204           .
     5205         end.
     5206         else do:
     5207           assign
     5208             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5209                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5210                   ) * 10
     5211                 + 9
     5212           .
     5213         end.
     5214         assign
     5215           p-price-sale-doc = round (p-price-sale-doc, 0)
     5216         .
     5217       end.
     5218     end.
     5219     when '9-99окончание':U then do:
     5220       if p-price-sale-doc < p-round-base then do:
     5221         assign
     5222           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     5223         .
     5224       end.
     5225       else do:
     5226         assign
     5227           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     5228         .
     5229       end.
     5230     end.
     5231     when 'Без-дробных':U then do:
     5232       assign
     5233         p-price-sale-doc = round (p-price-sale-doc, 0)
     5234       .
     5235     end.
     5236     when 'Произвольно':U then do:
     5237       if p-round-base <> 0 then do:
     5238         assign
     5239           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     5240         .
     5241         if p-price-sale-doc = 0 then do:
     5242           assign
     5243             p-price-sale-doc = p-round-base
     5244           .
     5245         end.
     5246       end.
     5247     end.
     5248     when 'Вверх':U then do:
     5249       if p-round-base <> 0 then do:
     5250         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     5251           assign
     5252             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     5253           .
     5254         end.
     5255       end.
     5256       if p-price-sale-doc = 0 then do:
     5257         assign
     5258           p-price-sale-doc = p-round-base
     5259         .
     5260       end.
     5261     end.
     5262     when 'Коэффициент':U then do:
     5263       if p-round-base <> 0 then do:
     5264         assign
     5265           p-price-sale-doc = p-price-sale-doc * p-round-base
     5266         .
     5267       end.
     5268     end.
     5269     when 'Отключено':U then do:
     5270     end.
     5271     otherwise do:
     5272       message
     5273         vss-workfile vss-revision vss-description skip
     5274         "Неизвестный метод округления продажной цены" skip
     5275         "round-method" p-round-method skip
     5276         "round-base"   p-round-base   skip
     5277         "price"        p-price-sale-doc             skip
     5278         view-as alert-box error .
     5279     end.
     5280   end.
     5281     end.
     5282     assign
     5283       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     5284       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     5285       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     5286       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     5287      .
     5288     assign
     5289       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     5290       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     5291       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     5292       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     5293     .
     5294     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     5295     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     5296     p-prev-doc-code = if available bufold_price-doc-forming
     5297                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     5298                          else "" .
     5299   END PROCEDURE.
     5300   PROCEDURE create-line :
     5301   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     5302   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     5303   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     5304   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     5305   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     5306   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     5307   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     5308   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
     5309   define input  parameter p-prod-code         like ub.price-doc-forming-gds.prod-code no-undo .
     5310   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     5311   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     5312   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     5313   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     5314   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     5315   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     5316   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     5317   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     5318   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     5319   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     5320   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     5321   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     5322   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     5323   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     5324   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     5325   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     5326   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     5327   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     5328   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     5329   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     5330   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     5331   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     5332   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     5333   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     5334   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     5335   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     5336   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     5337   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     5338   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     5339   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     5340   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     5341   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     5342   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     5343   define input  parameter p-prev-doc-code     as character no-undo .
     5344   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     5345   define input-output parameter  v-sec        as integer   no-undo .
     5346     run check-use-bar-code ( p-b-code ) no-error .
     5347     if error-status :error then do:
     5348       message
     5349         return-value skip
     5350         "Ошибка !"
     5351         view-as alert-box error
     5352       .
     5353       undo, return error return-value.
     5354     end.
     5355   find first ub.price-doc-forming-gds exclusive-lock where
     5356              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     5357              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     5358              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     5359              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     5360              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     5361       if not available ub.price-doc-forming-gds then
     5362       do:
     5363         create ub.price-doc-forming-gds .
     5364          assign
     5365           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     5366           ub.price-doc-forming-gds.plt-id     = p-plt-id
     5367           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     5368           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     5369           ub.price-doc-forming-gds.b-code     = p-b-code
     5370           ub.price-doc-forming-gds.line-num   = p-line-num
     5371          .
     5372       end.
     5373     assign
     5374       ub.price-doc-forming-gds.artic            = p-artic
     5375       ub.price-doc-forming-gds.prod-type        = p-prod-type
     5376       ub.price-doc-forming-gds.prod-code        = p-prod-code
     5377       ub.price-doc-forming-gds.calc-method      = p-calc-method
     5378       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     5379       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     5380       ub.price-doc-forming-gds.start-date       = p-start-date
     5381       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     5382       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     5383       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     5384       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     5385       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     5386       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     5387       ub.price-doc-forming-gds.end-date         = p-end-date
     5388       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     5389       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     5390       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     5391       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     5392       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     5393       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     5394       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     5395       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     5396       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     5397       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     5398       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     5399       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     5400       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     5401       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     5402       ub.price-doc-forming-gds.excise-base      = p-excise-base
     5403       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     5404       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     5405       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     5406       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     5407       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     5408       ub.price-doc-forming-gds.stts             = p-stts
     5409       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     5410       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     5411       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     5412       .
     5413     run ref/h-pdfgds.p
     5414       ( buffer ub.price-doc-forming-gds ,
     5415         input p-price-sale-doc ,
     5416         input-output v-sec
     5417         ) .
     5418   END PROCEDURE.
     5419   PROCEDURE last-num :
     5420   define input  parameter p-recid as recid no-undo .
     5421   define output parameter p-last-id as integer   no-undo .
     5422   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     5423   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5424   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     5425         if error-status :error then do:
     5426           p-last-id = ? .
     5427           return .
     5428         end.
     5429       for each buf2_price-doc-forming-gds no-lock  where
     5430               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     5431               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     5432               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     5433               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     5434               by buf2_price-doc-forming-gds.line-num
     5435               :
     5436               p-last-id = buf2_price-doc-forming-gds.line-num .
     5437       end.
     5438   END PROCEDURE.
     5439   PROCEDURE calc-price-alt :
     5440   define input parameter bc         like ub.bar-code.b-code   no-undo.
     5441   define input parameter p-recid as recid no-undo .
     5442   define input parameter d-pcnt as decimal   no-undo .
     5443   define input parameter r-method   as character no-undo .
     5444   define input parameter r-base     as decimal   no-undo .
     5445   define output parameter pa-price-sale-base  as decimal   no-undo .
     5446   define output parameter pa-price-sale-doc   as decimal   no-undo .
     5447   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     5448   pr-alt:
     5449   do on error undo pr-alt, return error:
     5450     if r-method = ? or
     5451        r-base = ? then do:
     5452       message
     5453         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     5454         "Код:" bc skip
     5455         view-as alert-box error.
     5456       undo pr-alt, return error.
     5457     end.
     5458   define buffer buf_bar-code for ub.bar-code  .
     5459   define buffer buf_main_bar-code for ub.bar-code  .
     5460   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     5461   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5462   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     5463   if error-status :error then
     5464   message
     5465     vss-workfile vss-revision vss-description skip
     5466     error-status :get-message(1) skip
     5467     return-value skip
     5468     "Ошибка "
     5469     view-as alert-box error
     5470   .
     5471   find first buf_bar-code no-lock where
     5472              buf_bar-code.b-code = bc no-error .
     5473   if error-status :error then
     5474   message
     5475     vss-workfile vss-revision vss-description skip
     5476     error-status :get-message(1) skip
     5477     return-value skip
     5478     "3"
     5479     view-as alert-box error
     5480   .
     5481         assign
     5482           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     5483                               buf_bar-code.cli-base-rate *
     5484                               (1 - d-pcnt / 100)
     5485                                 .
     5486     if pa-price-sale-doc <> 0 then do:
     5487   case r-method :
     5488     when '9-окончание':U then do:
     5489       if pa-price-sale-doc < 29 then do:
     5490         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     5491           assign
     5492             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     5493           .
     5494         end.
     5495       end.
     5496       else do:
     5497         if (pa-price-sale-doc modulo 10) < 3 then do:
     5498           assign
     5499             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5500                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5501                   - 1 ) * 10
     5502                 + 9
     5503           .
     5504         end.
     5505         else do:
     5506           assign
     5507             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5508                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5509                   ) * 10
     5510                 + 9
     5511           .
     5512         end.
     5513         assign
     5514           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5515         .
     5516       end.
     5517     end.
     5518     when '9-99окончание':U then do:
     5519       if pa-price-sale-doc < r-base then do:
     5520         assign
     5521           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     5522         .
     5523       end.
     5524       else do:
     5525         assign
     5526           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     5527         .
     5528       end.
     5529     end.
     5530     when 'Без-дробных':U then do:
     5531       assign
     5532         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5533       .
     5534     end.
     5535     when 'Произвольно':U then do:
     5536       if r-base <> 0 then do:
     5537         assign
     5538           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     5539         .
     5540         if pa-price-sale-doc = 0 then do:
     5541           assign
     5542             pa-price-sale-doc = r-base
     5543           .
     5544         end.
     5545       end.
     5546     end.
     5547     when 'Вверх':U then do:
     5548       if r-base <> 0 then do:
     5549         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     5550           assign
     5551             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     5552           .
     5553         end.
     5554       end.
     5555       if pa-price-sale-doc = 0 then do:
     5556         assign
     5557           pa-price-sale-doc = r-base
     5558         .
     5559       end.
     5560     end.
     5561     when 'Коэффициент':U then do:
     5562       if r-base <> 0 then do:
     5563         assign
     5564           pa-price-sale-doc = pa-price-sale-doc * r-base
     5565         .
     5566       end.
     5567     end.
     5568     when 'Отключено':U then do:
     5569     end.
     5570     otherwise do:
     5571       message
     5572         vss-workfile vss-revision vss-description skip
     5573         "Неизвестный метод округления продажной цены" skip
     5574         "round-method" r-method skip
     5575         "round-base"   r-base   skip
     5576         "price"        pa-price-sale-doc             skip
     5577         view-as alert-box error .
     5578     end.
     5579   end.
     5580     end.
     5581     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     5582     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     5583   end.
     5584   END PROCEDURE.
     5585   procedure calc-price-discnt :
     5586     do
     5587     on error undo, return error return-value
     5588     :
     5589   define input parameter p-recid as recid no-undo .
     5590   define input parameter bc    like ub.bar-code.b-code   no-undo.
     5591   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     5592   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5593   define buffer buf-bar-code                      for ub.bar-code.
     5594   define buffer buf-goods                         for ub.goods.
     5595   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     5596   define variable pr-rec   as   recid                     no-undo.
     5597   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     5598   pr-discnt:
     5599   do on error undo pr-discnt, return error:
     5600     find  buf-price-doc-forming no-lock where
     5601           recid(buf-price-doc-forming) = p-recid .
     5602     find  buf-bar-code no-lock where
     5603           buf-bar-code.b-code = bc.
     5604     find  buf-goods no-lock where
     5605           buf-goods.gds-code = buf-bar-code.gds-code.
     5606     find  buf-price-doc-forming-gds exclusive-lock where
     5607           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5608           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5609           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5610           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5611           buf-price-doc-forming-gds.b-code  = bc.
     5612      if available buf-price-doc-forming-gds then do:
     5613         buf-price-doc-forming-gds.d-pcnt =
     5614         (1 - buf-price-doc-forming-gds.price-sale-doc /
     5615               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     5616               buf-bar-code.cli-base-rate) * 100 .
     5617      end.
     5618   end.
     5619     end.
     5620   end procedure.
     5621   procedure calc-price-sub :
     5622   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     5623   define  input  parameter p-recid      as recid no-undo .
     5624   define  input  parameter calc-method  as character         no-undo.
     5625   define  input  parameter increase-pc  as decimal           no-undo.
     5626   define  input  parameter round-method as character         no-undo.
     5627   define  input  parameter round-base   as decimal           no-undo.
     5628   define  input  parameter doc-code     as character no-undo .
     5629   define  input  parameter common-price as decimal   no-undo .
     5630   define  input  parameter copy-type    as character no-undo .
     5631   define  input  parameter copy-code    as integer   no-undo .
     5632   define  output parameter calc-rec     as recid             no-undo.
     5633   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5634   define  buffer buf-bar-code              for ub.bar-code.
     5635   define  buffer buf-goods                 for ub.goods.
     5636   define  buffer buf-gds-prt               for ub.gds-prt.
     5637   define  buffer buf-gds-grp               for ub.gds-grp.
     5638   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     5639   calc-sub:
     5640   do on error undo calc-sub, return error:
     5641     find  buf-price-doc-forming no-lock where
     5642           recid (buf-price-doc-forming) =  p-recid .
     5643     find  buf-bar-code no-lock where
     5644           buf-bar-code.b-code = bc.
     5645     find  buf-goods no-lock where
     5646           buf-goods.gds-code = buf-bar-code.gds-code.
     5647     find  buf-gds-prt no-lock where
     5648           buf-gds-prt.node-code = buf-bar-code.node-code.
     5649     find  buf-price-doc-forming-gds where
     5650           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5651           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5652           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5653           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5654           buf-price-doc-forming-gds.b-code      = bc no-error .
     5655     calc-rec = recid (buf-price-doc-forming-gds).
     5656     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     5657       for each  buf-price-doc-forming-gds exclusive-lock where
     5658                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5659                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5660                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5661                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5662                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5663                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5664                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5665           first buf-bar-code no-lock where
     5666                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     5667                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     5668           first buf-gds-prt no-lock where
     5669                 buf-gds-prt.node-code = buf-bar-code.node-code and
     5670                 buf-gds-prt.upper-code <> buf-goods.prt-root
     5671           on error undo calc-sub, return error:
     5672             run calc-price-line  in this-procedure
     5673               ( input  calc-method
     5674               , input  increase-pc
     5675               , input  round-method
     5676               , input  round-base
     5677               , input  buf-bar-code.b-code
     5678               , input  buf-goods.gds-code
     5679               , input  buf-goods.artic
     5680               , input  buf-goods.prod-type
     5681               , input  buf-goods.prod-code
     5682               , input  buf-price-doc-forming.base-rate
     5683               , input  buf-price-doc-forming.base-scale
     5684               , input  buf-price-doc-forming.exch-scale
     5685               , input  buf-price-doc-forming.exch-rate
     5686               , input  doc-code
     5687               , input  common-price
     5688               , input  copy-type
     5689               , input  copy-code
     5690               , output buf-price-doc-forming-gds.calc-method
     5691               , output buf-price-doc-forming-gds.price-calc-base
     5692               , output buf-price-doc-forming-gds.price-calc-doc
     5693               , output buf-price-doc-forming-gds.price-calc-rubl
     5694               , output buf-price-doc-forming-gds.price-prev-base
     5695               , output buf-price-doc-forming-gds.price-prev-doc
     5696               , output buf-price-doc-forming-gds.price-prev-rubl
     5697               , output buf-price-doc-forming-gds.price-sale-base
     5698               , output buf-price-doc-forming-gds.price-sale-doc
     5699               , output buf-price-doc-forming-gds.price-sale-rubl
     5700               , output buf-price-doc-forming-gds.road-tax-base
     5701               , output buf-price-doc-forming-gds.road-tax-doc
     5702               , output buf-price-doc-forming-gds.road-tax-rubl
     5703               , output buf-price-doc-forming-gds.excise-base
     5704               , output buf-price-doc-forming-gds.excise-doc
     5705               , output buf-price-doc-forming-gds.excise-rubl
     5706               , output buf-price-doc-forming-gds.vat-pc
     5707               , output buf-price-doc-forming-gds.slt-pc
     5708               , output buf-price-doc-forming-gds.prev-doc-code
     5709               , output buf-price-doc-forming-gds.d-pcnt
     5710               ) no-error .
     5711             if error-status :error then do :
     5712               message
     5713                 vss-workfile vss-revision vss-description skip
     5714                 error-status :get-message(1) skip
     5715                 return-value skip
     5716                 "calc-price-line"
     5717                 view-as alert-box error
     5718               .
     5719               undo calc-sub, return error.
     5720               end.
     5721         calc-rec = recid (buf-price-doc-forming-gds).
     5722       end.
     5723       for each  buf-price-doc-forming-gds exclusive-lock where
     5724                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5725                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5726                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5727                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5728                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5729                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5730                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5731           first buf-bar-code no-lock where
     5732                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     5733                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     5734           first buf-gds-prt no-lock where
     5735                 buf-gds-prt.node-code = buf-bar-code.node-code
     5736           on error undo calc-sub, return error:
     5737       end.
     5738     end.
     5739     else do:
     5740     end.
     5741   end.
     5742   end procedure.
     5743   procedure calc-base-update :
     5744   define input parameter bc           like ub.bar-code.b-code   no-undo.
     5745   define input parameter p-recid      as recid no-undo .
     5746   define input parameter round-method as character    no-undo.
     5747   define input parameter round-base   as decimal      no-undo.
     5748   define buffer alt-bar-code              for ub.bar-code.
     5749   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     5750   define buffer buf-bar-code              for ub.bar-code.
     5751   define buffer buf-goods                 for ub.goods.
     5752   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     5753   calc-base:
     5754   do on error undo calc-base, return error :
     5755     find  buf-price-doc-forming no-lock where
     5756           recid (buf-price-doc-forming) =  p-recid .
     5757     find  buf-bar-code no-lock where
     5758           buf-bar-code.b-code = bc.
     5759     find  buf-goods no-lock where
     5760           buf-goods.gds-code = buf-bar-code.gds-code.
     5761     for each  alt-bar-code no-lock where
     5762               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     5763               alt-bar-code.node-code = buf-bar-code.node-code and
     5764               alt-bar-code.part-code = buf-bar-code.part-code and
     5765               alt-bar-code.in-code   = buf-bar-code.in-code and
     5766               alt-bar-code.unit-cli <> buf-goods.unit-base,
     5767         each  alt-price-doc-forming-gds exclusive-lock where
     5768               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     5769               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     5770               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     5771               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5772               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     5773         on error undo calc-base, return error:
     5774     run calc-price-alt in this-procedure
     5775         ( input  alt-price-doc-forming-gds.b-code
     5776         , input  p-recid
     5777         , input  alt-price-doc-forming-gds.d-pcnt
     5778         , input  round-method
     5779         , input  round-base
     5780         , output alt-price-doc-forming-gds.price-sale-base
     5781         , output alt-price-doc-forming-gds.price-sale-doc
     5782         , output alt-price-doc-forming-gds.price-sale-rubl
     5783         ) no-error .
     5784       if error-status:error then do:
     5785       message
     5786         vss-workfile vss-revision vss-description skip
     5787         error-status :get-message(1) skip
     5788         return-value skip
     5789         "calc-price-alt"
     5790         view-as alert-box error
     5791       .
     5792         undo calc-base, return error.
     5793       end.
     5794     end.
     5795   end.
     5796   end procedure.
     5797   define temp-table temp-exp-partbc no-undo
     5798   field b-code  as integer
     5799   index pi b-code
     5800   .
     5801   procedure expose-prt :
     5802   define input  parameter p-calc-method  as character no-undo .
     5803   define input  parameter p-increase-pc as decimal   no-undo .
     5804   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     5805   define input  parameter old-recid      as recid no-undo .
     5806   define input  parameter new-recid      as recid no-undo .
     5807   define input  parameter p-round-method as character no-undo .
     5808   define input  parameter p-round-base   as decimal   no-undo .
     5809   define input  parameter v-doc-code     as character no-undo .
     5810   define input  parameter v-common-price as decimal   no-undo .
     5811   define input  parameter v-copy-type    as character no-undo .
     5812   define input  parameter v-copy-code    as integer   no-undo .
     5813   define input-output parameter v-line-num as integer   no-undo .
     5814   define input-output parameter v-sec      as integer   no-undo .
     5815   define output parameter new-rec-str      as recid   no-undo.
     5816   define buffer buf-bar-code              for ub.bar-code.
     5817   define buffer buf-goods                 for ub.goods.
     5818   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5819   define buffer buf-price-list            for ub.price-doc-forming-gds.
     5820   define buffer buf-price-doc-forming     for ub.price-doc-forming.
     5821   define buffer new-price-doc-forming     for ub.price-doc-forming.
     5822   define buffer new-price-doc-forming-gds for ub.price-doc-forming-gds  .
     5823   define buffer buf-gds-prt               for ub.gds-prt  .
     5824   define buffer buf_parts for ub.parts  .
     5825   define buffer buf_goods for ub.goods  .
     5826     do
     5827     on error undo, return error return-value
     5828     :
     5829     find  buf-price-doc-forming no-lock where
     5830           recid(buf-price-doc-forming) = old-recid .
     5831     find  new-price-doc-forming no-lock where
     5832           recid(new-price-doc-forming) = new-recid .
     5833     find  buf-bar-code no-lock where
     5834           buf-bar-code.b-code = p-main-code.
     5835     find  buf-goods no-lock where
     5836           buf-goods.gds-code = buf-bar-code.gds-code.
     5837     find  buf-price-doc-forming-gds no-lock  where
     5838           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5839           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5840           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5841           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5842           buf-price-doc-forming-gds.b-code  = p-main-code no-error .
     5843     if error-status :error then return .
     5844     find  buf-gds-prt no-lock where
     5845           buf-gds-prt.node-code = buf-bar-code.node-code.
     5846   if par-pr-altex = "yes" and
     5847      par-pr-notls = "yes" then do:
     5848   for each  buf-price-list where
     5849             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     5850             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     5851             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5852             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5853             buf-price-list.b-code     <> p-main-code and
     5854             buf-price-list.artic       = buf-goods.artic  and
     5855             buf-price-list.prod-type   = buf-goods.prod-type and
     5856             buf-price-list.prod-code   = buf-goods.prod-code
     5857             ,
     5858       first buf-bar-code no-lock where
     5859             buf-bar-code.b-code   = buf-price-list.b-code and
     5860             buf-bar-code.unit-cli <> buf-goods.unit-base:
     5861      run create-calc-bc in this-procedure
     5862          ( input  recid( new-price-doc-forming )
     5863           ,input  p-calc-method
     5864           ,input  p-increase-pc
     5865           ,input  p-round-method
     5866           ,input  p-round-base
     5867           ,input  buf-bar-code.b-code
     5868           ,input  buf-goods.gds-code
     5869           ,input  buf-goods.artic
     5870           ,input  buf-goods.prod-type
     5871           ,input  buf-goods.prod-code
     5872           ,input  new-price-doc-forming.base-rate
     5873           ,input  new-price-doc-forming.base-scale
     5874           ,input  new-price-doc-forming.exch-scale
     5875           ,input  new-price-doc-forming.exch-rate
     5876           ,input  v-doc-code
     5877           ,input  v-common-price
     5878           ,input  v-copy-type
     5879           ,input  v-copy-code
     5880           ,input-output v-line-num
     5881           ,input-output v-sec
     5882         ) no-error .
     5883     if error-status:error then do:
     5884       message
     5885         "Ошибка cre-pr-list."                skip
     5886         "Код:" buf-bar-code.b-code           skip
     5887         error-status :get-message(1)         skip
     5888         return-value                         skip
     5889          "pdf" new-price-doc-forming.pdf-id  skip
     5890         view-as alert-box.
     5891       next.
     5892     end.
     5893   end.
     5894   end.
     5895   if par-pr-sclex = "yes" and
     5896      par-pr-notls = "yes" then do:
     5897   for each  buf-price-list where
     5898             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     5899             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     5900             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5901             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5902             buf-price-list.b-code     <> p-main-code and
     5903             buf-price-list.artic       = buf-goods.artic  and
     5904             buf-price-list.prod-type   = buf-goods.prod-type and
     5905             buf-price-list.prod-code   = buf-goods.prod-code  ,
     5906       first buf-bar-code no-lock where
     5907             buf-bar-code.b-code   = buf-price-list.b-code and
     5908             buf-bar-code.unit-cli = buf-goods.unit-base and
     5909             buf-bar-code.in-code = ""
     5910             :
     5911      run create-calc-bc in this-procedure
     5912          ( input  recid( new-price-doc-forming )
     5913           ,input  p-calc-method
     5914           ,input  p-increase-pc
     5915           ,input  p-round-method
     5916           ,input  p-round-base
     5917           ,input  buf-bar-code.b-code
     5918           ,input  buf-goods.gds-code
     5919           ,input  buf-goods.artic
     5920           ,input  buf-goods.prod-type
     5921           ,input  buf-goods.prod-code
     5922           ,input  new-price-doc-forming.base-rate
     5923           ,input  new-price-doc-forming.base-scale
     5924           ,input  new-price-doc-forming.exch-scale
     5925           ,input  new-price-doc-forming.exch-rate
     5926           ,input v-doc-code
     5927           ,input v-common-price
     5928           ,input v-copy-type
     5929           ,input v-copy-code
     5930           ,input-output v-line-num
     5931           ,input-output v-sec
     5932         ) no-error .
     5933         if error-status:error then do:
     5934           message
     5935             "Ошибка cre-pr-list.2" skip
     5936             "Код:" buf-bar-code.b-code
     5937             view-as alert-box.
     5938           next.
     5939         end.
     5940       end.
     5941   end.
     5942   if par-pr-parex = "yes" and
     5943      par-pr-notls = "yes" then do:
     5944   define buffer bt_trn-doc  for ub.trn-doc  .
     5945   define buffer bf_parts    for ub.parts  .
     5946   define buffer free_parts  for ub.parts  .
     5947   define buffer buf_gds-obj for ub.gds-obj  .
     5948   find first buf_gds-obj no-lock where
     5949              buf_gds-obj.gds-code = buf-goods.gds-code and
     5950              buf_gds-obj.obj-type = v-cntxt-obj-type   and
     5951              buf_gds-obj.obj-code = v-cntxt-obj-code   and
     5952              buf_gds-obj.cash-parts = true
     5953              no-error .
     5954   if not available buf_gds-obj then return .
     5955    find first bt_trn-doc no-lock where
     5956               bt_trn-doc.doc-code = v-doc-code no-error .
     5957    if v-doc-code <> "" and available bt_trn-doc then do:
     5958    for each temp-exp-partbc :
     5959        delete temp-exp-partbc.
     5960    end.
