     1731     do
     1732     on error undo, return error
     1733     :
     1734           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-code in g#attr-lib
     1735         (input  p-code
     1736         ,output p-type
     1737         ,output p-format
     1738         ,output p-label
     1739         ,output p-user-can-edit
     1740         ,output p-output-display
     1741         ,output p-other
     1742         ) no-error .
