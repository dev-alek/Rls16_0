    10365                 assign
    10366                   buf_price-doc-forming.name       = substitute("№ &1 от &2 " ,temp-price-doc.doc-num, string (temp-price-doc.doc-date , "99/99/9999" ) ) .
    10367                   buf_price-doc-forming.des        = substitute(" Товаров &1" ,v-counter-gds ).
    10368                   .
    10369                 if (temp-price-doc.doc-num-ES <> ? and temp-price-doc.doc-num-ES <> "")
    10370                 or (temp-price-doc.doc-id <> ? and temp-price-doc.doc-id <> "")
    10371                 then buf_price-doc-forming.des = temp-price-doc.doc-num-ES + chr(4) + temp-price-doc.doc-id + chr(4) + string (temp-price-doc.doc-date , "99/99/9999" ) .
    10372          buf_price-doc.PS = "temp" .
    10373          delete  buf_price-doc.
    10374          .
    10375       end.
    10376       if temp-price-doc.doc-id = "_"
    10377       then do :
    10378         run str/diallog.w
    10379             ( this-procedure
    10380             , p-log-handle
    10381             , if (temp-price-doc.doc-num-ES <> ? and temp-price-doc.doc-num-ES <> "")
    10382               or (temp-price-doc.doc-id <> ? and temp-price-doc.doc-id <> "")
    10383               then ('str/pdf-clos.p':U + chr(4) + '1' + chr(4) + '2' + chr(4) + '1')
    10384               else 'str/pdf-clos.p':U
    10385             , ( string(recid(buf_price-doc-forming)) + chr(4) +
    10386                'no' + chr(4) +
    10387                'no' + chr(4) +
    10388                '?' +  chr(4) +
    10389                '?' +  chr(4) +
    10390                'факт':U + chr(4) +
    10391                '?' + chr(4) +
    10392                'no' + chr(4) +
    10393                'no' + chr(4) +
    10394                'yes'  )
    10395             , yes
    10396             , '':U
    10397             , 'Закрытие ДНЦ') no-error .
    10398             if error-status :error then do:
    10399                 v-end-message = error-status :get-message(1)  + return-value  .
    10400                 run pcall-log-file in p-log-handle (input v-end-message) .
    10401                 undo, return error v-end-message.
    10402             end.
    10403       end.
    10404       else do :
    10405         run str/diallog.w
    10406             ( this-procedure
    10407             , p-log-handle
    10408             , if (temp-price-doc.doc-num-ES <> ? and temp-price-doc.doc-num-ES <> "")
    10409               or (temp-price-doc.doc-id <> ? and temp-price-doc.doc-id <> "")
    10410               then ('str/pdf-clos.p':U + chr(4) + '1' + chr(4) + '2' + chr(4) + '1')
    10411               else 'str/pdf-clos.p':U
    10412             , ( string(recid(buf_price-doc-forming)) + chr(4) +
    10413                'no' + chr(4) +
    10414                'no' + chr(4) +
    10415                '?' +  chr(4) +
    10416                '?' +  chr(4) +
    10417                'приказ':U + chr(4) +
    10418                '?' + chr(4) +
    10419                'yes' + chr(4) +
    10420                'no' + chr(4) +
    10421                'yes'  )
    10422             , yes
    10423             , '':U
    10424             , 'Закрытие ДНЦ') no-error .
    10425             if error-status :error then do:
    10426                 v-end-message = error-status :get-message(1)  + return-value  .
    10427                 run pcall-log-file in p-log-handle (input v-end-message) .
    10428                 undo, return error v-end-message.
    10429             end.
    10430       end.
    10431           find first new_price-doc exclusive-lock where
    10432                      new_price-doc.plt-id     = buf_price-doc-forming.plt-id       and
    10433                      new_price-doc.plt-db-num = buf_price-doc-forming.plt-db-num   and
    10434                      new_price-doc.pdf-id     = buf_price-doc-forming.pdf-id       and
    10435                      new_price-doc.pdf-db     = buf_price-doc-forming.pdf-db       no-error .
    10436          if available new_price-doc then do:
    10437             if temp-price-doc.doc-num <> ? and temp-price-doc.doc-num <> 0
    10438             then do :
    10439               run add-nn (new_price-doc.doc-num , temp-price-doc.doc-num  ) no-error .
    10440               if error-status:error then do :
    10441                   v-end-message = substitute(" Ошибка записи атрибута документа &1 &2" , error-status :get-message(1)  , return-value) .
    10442                   run pcall-log-file in p-log-handle ( input v-end-message ) .
    10443                   undo, return error v-end-message.
    10444               end.
    10445             end.
    10446             assign
    10447               v-end-message =  string(temp-price-doc.obj-type) + string(temp-price-doc.obj-code)
    10448               + chr(9) + "ПЕРЕОЦЕНКА:" + string(new_price-doc.doc-num)
    10449             .
    10450             run pcall-log-file in p-log-handle (input v-end-message) .
    10451             new_price-doc.doc-num-es = temp-price-doc.doc-num-ES .
    10452             if temp-price-doc.cmnt <> ? and trim(temp-price-doc.cmnt) <> ""
    10453             then
    10454             new_price-doc.ps = temp-price-doc.cmnt .
    10455          end.
    10456       assign
    10457           v-end-message =  string(temp-price-doc.obj-type) + string(temp-price-doc.obj-code)
    10458           + chr(9) + "№ внешней системы:"  + string(temp-price-doc.doc-num)
    10459           + chr(9) + "ДНЦ:" + string(buf_price-doc-forming.pdf-id) + chr(9) + string( v-counter-gds ) + " товаров"
    10460       .
    10461        run pcall-log-file in p-log-handle (input v-end-message) .
    10462        p-ok-doc = p-ok-doc + 1.
    10463   end.
    10464     end.
    10465   end procedure.
    10466   procedure add-nn :
    10467   define input  parameter p-doc-code as character no-undo .
    10468   define input  parameter p-doc-out as character no-undo .
    10469     do
    10470     on error undo, return error return-value
    10471     :
    10472     find first ub.doc-attr exclusive-lock where
    10473              ub.doc-attr.doc-code = p-doc-code and
    10474              ub.doc-attr.attr-code = 'nids':U no-error .
    10475     if not available ub.doc-attr then create ub.doc-attr.
    10476     assign
    10477       ub.doc-attr.doc-code = p-doc-code
    10478       ub.doc-attr.attr-code = 'nids':U
    10479       ub.doc-attr.attr-value = p-doc-out
    10480     .
    10481     end.
    10482   end procedure.
