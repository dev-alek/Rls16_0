     6139   procedure create-calc-bc :
     6140   define input parameter  v-new-recid as recid no-undo .
     6141   define input parameter  p-calc-method  as character no-undo .
     6142   define input parameter  p-increase-pc  as decimal   no-undo .
     6143   define input parameter  round-method as character no-undo .
     6144   define input parameter  round-base   as decimal   no-undo .
     6145   define input parameter  p-b-code     as integer   no-undo .
     6146   define input parameter  p-gds-code   as integer   no-undo .
     6147   define input parameter  p-artic      as character no-undo .
     6148   define input parameter  p-prod-type  as character no-undo .
     6149   define input parameter  p-prod-code  as integer   no-undo .
     6150   define input parameter  v-base-rate  as decimal   no-undo .
     6151   define input parameter  v-base-scale as decimal   no-undo .
     6152   define input parameter  v-exch-scale as decimal   no-undo .
     6153   define input parameter  v-exch-rate  as decimal   no-undo .
     6154   define input parameter  v-doc-code   as character no-undo .
     6155   define input parameter  v-common-price as decimal   no-undo .
     6156   define input parameter  v-copy-type as character no-undo .
     6157   define input parameter  v-copy-code as integer   no-undo .
     6158   define input-output parameter v-line-num as integer   no-undo .
     6159   define input-output parameter v-sec     as integer   no-undo .
     6160   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     6161   define variable v-price-calc-base as decimal   no-undo .
     6162   define variable v-price-calc-doc  as decimal   no-undo .
     6163   define variable v-price-calc-rubl as decimal   no-undo .
     6164   define variable v-price-prev-base as decimal   no-undo .
     6165   define variable v-price-prev-doc  as decimal   no-undo .
     6166   define variable v-price-prev-rubl as decimal   no-undo .
     6167   define variable v-price-sale-base as decimal   no-undo .
     6168   define variable v-price-sale-doc  as decimal   no-undo .
     6169   define variable v-price-sale-rubl as decimal   no-undo .
     6170   define variable v-road-tax-base   as decimal   no-undo .
     6171   define variable v-road-tax-doc    as decimal   no-undo .
     6172   define variable v-road-tax-rubl   as decimal   no-undo .
     6173   define variable v-excise-base     as decimal   no-undo .
     6174   define variable v-excise-doc      as decimal   no-undo .
     6175   define variable v-excise-rubl     as decimal   no-undo .
     6176   define variable v-vat-pc          as decimal   no-undo .
     6177   define variable v-slt-pc          as decimal   no-undo .
     6178   define variable v-prev-doc-code   as character no-undo .
     6179   define variable v-d-pcnt as decimal   no-undo .
     6180     do
     6181     on error undo, return error return-value
     6182     :
     6183     find  buf_price-doc-forming no-lock where
     6184           recid(buf_price-doc-forming) = v-new-recid no-error .
     6185      if error-status :error then return error error-status :get-message(1) .
     6186      v-line-num = v-line-num + 1.
     6187      run calc-price-line  in this-procedure (
     6188        input  p-calc-method
     6189      , input  p-increase-pc
     6190      , input  round-method
     6191      , input  round-base
     6192      , input  p-b-code
     6193      , input  p-gds-code
     6194      , input  p-artic
     6195      , input  p-prod-type
     6196      , input  p-prod-code
     6197      , input  v-base-rate
     6198      , input  v-base-scale
     6199      , input  v-exch-scale
     6200      , input  v-exch-rate
     6201      , input  v-doc-code
     6202      , input  v-common-price
     6203      , input  v-copy-type
     6204      , input  v-copy-code
     6205      , output p-calc-method
     6206      , output v-price-calc-base
     6207      , output v-price-calc-doc
     6208      , output v-price-calc-rubl
     6209      , output v-price-prev-base
     6210      , output v-price-prev-doc
     6211      , output v-price-prev-rubl
     6212      , output v-price-sale-base
     6213      , output v-price-sale-doc
     6214      , output v-price-sale-rubl
     6215      , output v-road-tax-base
     6216      , output v-road-tax-doc
     6217      , output v-road-tax-rubl
     6218      , output v-excise-base
     6219      , output v-excise-doc
     6220      , output v-excise-rubl
     6221      , output v-vat-pc
     6222      , output v-slt-pc
     6223      , output v-prev-doc-code
     6224      , output v-d-pcnt
     6225      ) no-error .
     6226      if error-status :error then
     6227      message
     6228        vss-workfile vss-revision vss-description skip
     6229        error-status :get-message(1) skip
     6230        return-value skip
     6231        "123calc-price-line"
     6232        "p-calc-method     "  p-calc-method     skip
     6233        "p-increase-pc     "  p-increase-pc     skip
     6234        "round-method      "    round-method    skip
     6235        "round-base        "    round-base      skip
     6236        "p-b-code          "    p-b-code        skip
     6237        "p-gds-code        "    p-gds-code      skip
     6238        "p-artic           "    p-artic         skip
     6239        "p-prod-type       "    p-prod-type     skip
     6240        "p-prod-code       "    p-prod-code     skip
     6241        "v-base-rate       "   v-base-rate     skip
     6242        "v-base-scale      "  v-base-scale    skip
     6243        "v-exch-scale      "  v-exch-scale    skip
     6244        "v-exch-rate       "  v-exch-rate     skip
     6245        "v-doc-code        "  v-doc-code      skip
     6246        "v-common-price    "  v-common-price  skip
     6247        "v-copy-type       "  v-copy-type     skip
     6248        "v-copy-code       "  v-copy-code     skip
     6249        "v-d-pcnt          "  v-d-pcnt
     6250        view-as alert-box error
     6251      .
