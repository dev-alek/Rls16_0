     1470   procedure copy_new_price-doc-forming :
     1471   define input  parameter       p-recid      as recid no-undo .
     1472   define input-output parameter p-plt-db-num as integer   no-undo .
     1473   define input-output parameter p-plt-id     as integer   no-undo .
     1474   define output parameter       p-pdf-db-num as integer   no-undo .
     1475   define output parameter       p-pdf-id     as integer   no-undo .
     1476   define buffer buf_price-list-type        for ub.price-list-type  .
     1477   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     1478   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     1479   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     1480   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     1481   define variable v-host-code  as integer   no-undo .
     1482   define variable v-base-rate  as decimal   no-undo .
     1483   define variable v-base-scale as integer   no-undo .
     1484   define variable v-exch-rate  as decimal   no-undo .
     1485   define variable v-exch-scale as integer   no-undo .
     1486   define variable v-base as logical   no-undo .
     1487   define variable v-name as character no-undo .
     1488     do
     1489     on error undo, return error return-value
     1490     :
     1491   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1493     (output v-base
     1494     )  .
     1495   find first buf_price-list-type no-lock where
     1496              buf_price-list-type.plt-db-num = p-plt-db-num and
     1497              buf_price-list-type.plt-id     = p-plt-id no-error .
     1498   if error-status :error then return error "Не найден ТПЛ".
     1499   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     1500   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     1501       if available buf_price-doc-forming then do :
     1502           assign
     1503             v-base-rate  = buf_price-doc-forming.base-rate
     1504             v-base-scale = buf_price-doc-forming.base-scale
     1505             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     1506           .
     1507       end.
     1508       else do:
     1509           assign
     1510             v-base-rate  = 1
     1511             v-base-scale = 1
     1512             v-name       = "Автосоздание"
     1513           .
     1514       end.
     1515      create ub.price-doc-forming.
     1516      assign
     1517         ub.price-doc-forming.plt-id       = p-plt-id
     1518         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1519         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1520         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1521         ub.price-doc-forming.base-rate    = v-base-rate
     1522         ub.price-doc-forming.base-scale   = v-base-scale
     1523         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1524         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1525         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1526         ub.price-doc-forming.stts         = 0
     1527         ub.price-doc-forming.sys-date     = today
     1528         ub.price-doc-forming.sys-time     = time
     1529         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1530         ub.price-doc-forming.who          = v-cntxt-userid
     1531         ub.price-doc-forming.name         = v-name
     1532      .
     1533      assign
     1534       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1535       p-pdf-id      = ub.price-doc-forming.pdf-id
     1536       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1537       p-plt-id      = ub.price-doc-forming.plt-id
     1538      .
     1539     end.
     1540     if not available buf_price-doc-forming then return .
     1541   for each buf_price-doc-forming-attr no-lock where
     1542            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1543            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1544            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1545            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1546       create ub.price-doc-forming-attr.
     1547       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1548       assign
     1549         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1550         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1551         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1552         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1553         .
     1554   end.
     1555   for each buf_price-doc-forming-gds no-lock where
     1556            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1557            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1558            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1559            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1560       create ub.price-doc-forming-gds.
     1561       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1562       assign
     1563         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1564         ub.price-doc-forming-gds.plt-id      = p-plt-id
     1565         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     1566         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     1567       .
     1568   end.
     1569   for each buf_pd-forming-gds-attr no-lock where
     1570            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1571            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1572            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1573            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1574       create ub.price-doc-forming-gdsattr.
     1575       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     1576       assign
     1577         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     1578         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     1579         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     1580         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     1581       .
     1582   end.
     1583   end procedure.
     1584   define variable par-pr-incpc as character no-undo.
     1585   define variable par-pr-rndmt as character no-undo.
     1586   define variable par-pr-rndbs as character no-undo.
     1587   define variable par-pr-clt-q as character no-undo.
     1588   define variable par-pr-dpl-q as character no-undo.
     1589   define variable par-pr-rdc-q as character no-undo.
     1590   define variable par-pr-abs-d as character no-undo.
     1591   define variable par-pr-altex as character no-undo.
     1592   define variable par-pr-parex as character no-undo.
     1593   define variable par-pr-sclex as character no-undo.
     1594   define variable par-pr-notls as character no-undo.
     1595   define variable par-pr-equ-dq as integer  no-undo.
     1596   define variable par-pr-discm as character no-undo .
     1597   define variable par-pr-dscnt as character no-undo .
     1598   define variable par-pr-print as character no-undo .
     1599   define variable par-pr-sigma as character no-undo .
     1600   define variable par-pr-goods as character no-undo.
     1601   define variable par-pr-nogds as character no-undo.
     1602   define variable par-alcohol  as character no-undo.
     1603   define variable par-gen-mrgn-ie as character no-undo .
     1604   define variable par-gen-mrgn-iv as character no-undo .
     1605   define variable par-gen-mrgn-im as character no-undo .
     1606   define variable par-pr-nakl-ie  as logical   no-undo .
     1607   define variable par-pr-nakl-iv  as logical   no-undo .
     1608   define variable par-pr-nakl-im  as logical   no-undo .
     1609   define variable par-pr-nogds-long as longchar no-undo .
     1610   define temp-table tmp-proof-price no-undo
     1611     field node-code like ub.gds-grp.node-code
     1612     field proof as decimal
     1613     field price as decimal
     1614   index pi node-code proof descending .
     1615   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1617   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1618   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1619   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1620   ASSIGN
     1621      v-S_CONTRACT                = "Contract":U
     1622      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1623      v-DELIM_CHR_3               = ","
     1624      .
     1625   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1626   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1627   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1628   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1629      INPUT iHost-Code    AS INTEGER,
     1630      INPUT iContract-Num AS INTEGER,
     1631      INPUT iGds-Code     AS INTEGER ):
     1632      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1633      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1634      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1635      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1636      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1637      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1638          INPUT  iHost-Code,
     1639          INPUT  iContract-Num,
     1640          OUTPUT iTmp-Extent3
     1641          ).
     1642      IF iTmp-Extent3[1] = 2 THEN DO:
     1643         ASSIGN
     1644            iTmp-Host-Code      = iTmp-Extent3[2]
     1645            iTmp-Contract-Num   = iTmp-Extent3[3]
     1646            .
     1647      END. ELSE DO:
     1648         ASSIGN
     1649            iTmp-Host-Code      = iHost-Code
     1650            iTmp-Contract-Num   = iContract-Num
     1651            .
     1652      END.
     1653      IF iGds-Code = ? THEN DO:
     1654         ASSIGN
     1655            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1656                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1657                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1658                           ).
     1659      END. ELSE DO:
     1660            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1661                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1662                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1663                              AND buf_Spec.Gds-Code      = iGds-Code
     1664                            ).
     1665      END.
     1666      RETURN (lRet).
     1667   END FUNCTION.
     1668   PROCEDURE MS-Contract-EXTENT-3:
     1669      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1670      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1671      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1672      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1673      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1674      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1675      FIND FIRST buf_Cont-2 WHERE
     1676                 buf_Cont-2.Host-Code      = i-Host-Code
     1677             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1678           NO-LOCK NO-ERROR.
     1679      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1680         RETURN.
     1681      END.
     1682      FOR FIRST buf_Ext-Classif WHERE
     1683                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1684           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1685                                               STRING(i-Contract-code)
     1686           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1687          NO-LOCK,
     1688          EACH buf_Cont WHERE
     1689               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1690           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1691          NO-LOCK:
     1692          ASSIGN
     1693             i-Ret[1] = 1
     1694             i-Ret[2] = buf_Cont.Host-code
     1695             i-Ret[3] = buf_Cont.Contract-code
     1696             .
     1697          LEAVE.
     1698      END.
     1699      IF i-Ret[1] <> 1 THEN DO:
     1700         FOR FIRST buf_Ext-Classif WHERE
     1701                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1702              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1703                                                  STRING(i-Contract-code)
     1704              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1705             NO-LOCK,
     1706             EACH buf_Cont WHERE
     1707                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1708              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1709             NO-LOCK:
     1710             ASSIGN
     1711                i-Ret[1] = 2
     1712                i-Ret[2] = buf_Cont.Host-code
     1713                i-Ret[3] = buf_Cont.Contract-code
     1714                .
     1715             LEAVE.
     1716         END.
     1717      END.
     1718      RETURN.
     1719   END PROCEDURE.
     1720   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1721   define new global shared variable g#attr-lib  as handle no-undo .
