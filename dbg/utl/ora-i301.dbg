     1355     ,output main-b-code
     1356     ) no-error .
     1357   run check-use-bar-code (main-b-code) no-error .
     1358   if error-status :error then return .
     1359   run create-line-pdf-mpl-lib (
     1360        input buf_price-doc-forming.plt-db-num
