     8255             view-as alert-box error .
     8256                 p-err = true .
     8257                 undo , return error .
     8258       end.
     8259       else do:
     8260          if  t-prc = ? then  do:
     8261             message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     8262             else "По признаку"  )
     8263             b_price-doc-forming-gds.artic
     8264             b_price-doc-forming-gds.prod-type
     8265             b_price-doc-forming-gds.prod-code skip
     8266             "бар-код: " b_price-doc-forming-gds.b-code
     8267              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     8268                else "" ) skip
     8269             fnc-pr  (buffer b_price-doc-forming-gds)
     8270             skip
     8271             "Нет базовой цены для расчета процента наценки !" skip
     8272             "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     8273             "Процент не менее :" p-prc-min "%" skip
     8274             "Процент не более :" p-prc-max "%" skip
     8275             "Процент фактический :" t-prc  "%"  skip
     8276             "ДНЦ №_: " b_price-doc-forming-gds.pdf-id         skip
     8277             "БД" b_price-doc-forming-gds.pdf-db
     8278             view-as alert-box error .
     8279             p-err = true .
     8280             undo , return error .
     8281          end.
     8282       end.
     8283     end.
     8284   end.
     8285     end.
     8286   end procedure.
     8287   procedure del-doc-line :
     8288   define input  parameter p-recid as recid no-undo .
     8289     do
     8290     on error undo, return error return-value
     8291     :
     8292     find first ub.price-doc-forming-gds exclusive-lock where
     8293          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     8294      if available ub.price-doc-forming-gds then do:
     8295         delete ub.price-doc-forming-gds no-error .
     8296      end.
     8297     end.
     8298   end procedure.
     8299   def var vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8300   procedure check-use-bar-code :
     8301     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     8302     do
     8303     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info82, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8304     on stop   undo, return error substitute( "&1. stop", vss-include-info82 )
     8305     on endkey undo, return error substitute( "&1. endkey", vss-include-info82 )
     8306     :
     8307       define buffer buf_bar-code for ub.bar-code .
     8308       find first buf_bar-code no-lock
     8309         where buf_bar-code.b-code     = p-b-code
     8310         no-error .
     8311       if not available buf_bar-code then do:
     8312         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info82, p-b-code ) .
     8313       end.
     8314       if buf_bar-code.stts = integer('99':U) then do:
     8315         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     8316                                 + "Выполняется удаление бар-кода"
     8317                                 ,vss-include-info82
     8318                                 ,p-b-code
     8319                                 ,chr(10)
     8320                               ) .
     8321       end.
     8322       if buf_bar-code.stts = integer('79':U) then do:
     8323         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     8324                                 + "Бар-код выключен"
     8325                                 ,vss-include-info82
     8326                                 ,p-b-code
     8327                                 ,chr(10)
     8328                               ) .
     8329       end.
     8330       return .
     8331     end.
     8332   end procedure.
     8333   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8334   procedure last-incom-S :
     8335   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
     8336   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
     8337   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
     8338   define output parameter p-in-code   as character no-undo .
     8339   define output parameter p-obj-type  as character no-undo .
     8340   define output parameter p-obj-code  as integer   no-undo .
     8341     do
     8342     on error undo, return error return-value
     8343     :
     8344     define buffer buf_trn-doc for ub.trn-doc .
     8345     define buffer buf_gds-obj for ub.gds-obj  .
     8346     do
     8347     on error undo, return error
     8348     :
     8349       assign
     8350         p-in-code  = ""
     8351         p-obj-type = ""
     8352         p-obj-code = 0
     8353       .
     8354        for each x_obj-group ,
     8355         each buf_gds-obj no-lock
     8356         where buf_gds-obj.obj-type  = x_obj-group.obj-type
     8357           and buf_gds-obj.obj-code  = x_obj-group.obj-code
     8358           and buf_gds-obj.artic     = p-artic
     8359           and buf_gds-obj.prod-type = p-prod-type
     8360           and buf_gds-obj.prod-code = p-prod-code
     8361       , first buf_trn-doc no-lock
     8362         where buf_trn-doc.doc-code = buf_gds-obj.in-code
     8363           and buf_trn-doc.status_  = 'факт':U
     8364       on error undo, return error
     8365       by buf_trn-doc.fact-order descending
     8366       :
     8367         assign
     8368           p-in-code  = buf_gds-obj.in-code
     8369           p-obj-type = buf_gds-obj.obj-type
     8370           p-obj-code = buf_gds-obj.obj-code
     8371         .
     8372         leave .
     8373       end.
     8374     end.
     8375     end.
     8376   end procedure.
     8377   procedure main-road-tax :
     8378   def input param p-obj-type  like ub.gds-obj.obj-type  no-undo .
     8379   def input param p-obj-code  like ub.gds-obj.obj-code  no-undo .
     8380   def input param p-artic     like ub.gds-obj.artic     no-undo .
     8381   def input param p-prod-type like ub.gds-obj.prod-type no-undo .
     8382   def input param p-prod-code like ub.gds-obj.prod-code no-undo .
     8383   def input-output param p-road-tax-base as decimal no-undo .
     8384   def input-output param p-road-tax-rubl as decimal no-undo .
     8385   define buffer     buff-goods    for ub.goods   .
     8386   define buffer     buf_gds-obj   for ub.gds-obj .
     8387   define buffer     buf_parts     for ub.parts   .
     8388       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     8389       define buffer   in-vatp-parts    for ub.parts   .
     8390       define buffer   in-vatp-doc      for ub.trn-doc .
     8391       define buffer   in-vatp-goods    for ub.goods   .
     8392       define buffer   in-vatp-sysconf  for ub.sysconf .
     8393       define buffer   in-vatp_doc-attr for ub.doc-attr.
     8394       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     8395       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     8396       define variable varinvprb                  as   character              no-undo.
     8397       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     8398       define variable cli-base-rate              as   decimal                no-undo.
     8399       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     8400       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     8401       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     8402       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     8403       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     8404       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     8405       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     8406       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     8407       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     8408       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     8409       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     8410       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     8411       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     8412       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     8413       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     8414       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     8415       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     8416       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     8417       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     8418       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     8419       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     8420       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     8421       define variable varinvatp-envd             as   character              no-undo.
     8422       define variable varinvatp-type             as   character              no-undo.
     8423   define buffer buf_trn-doc for ub.trn-doc  .
     8424   define buffer buf_doc-line for ub.doc-line .
     8425   define variable   is-petrolium  as logical             no-undo.
     8426   define variable   is-pieces     as logical             no-undo.
     8427   define variable v-last-in-code  like ub.gds-obj.in-code  no-undo .
     8428   define variable v-last-obj-type like ub.gds-obj.obj-type no-undo .
     8429   define variable v-last-obj-code like ub.gds-obj.obj-code no-undo .
     8430   def var v-rec as recid no-undo.
     8431   def var t-ret as logical no-undo .
     8432   def var v-total-avrg-base as decimal no-undo .
     8433   def var v-total-avrg-rubl as decimal no-undo .
     8434   def var v-total-avrg-qnty as decimal no-undo .
     8435   def var v-total-road-tax-base     as decimal no-undo .
     8436   def var v-total-road-tax-rubl     as decimal no-undo .
     8437   def var v-all-total-road-tax-base as decimal no-undo .
     8438   def var v-all-total-road-tax-rubl as decimal no-undo .
     8439   assign
     8440     p-road-tax-base = ?
     8441     p-road-tax-rubl = ?
     8442     .
     8443     Find first buff-goods no-lock where
     8444           buff-goods.artic     = p-artic and
     8445           buff-goods.prod-type = p-prod-type and
     8446           buff-goods.prod-code = p-prod-code
     8447           no-error .
     8448         if available buff-goods then do:
     8449              v-rec = recid (buff-goods).
     8450              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     8451   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     8452     (
     8453        input p-artic
     8454     ,  input p-prod-type
     8455     ,  input p-prod-code
     8456     , output is-petrolium
     8457     , output is-pieces
     8458     ) .
     8459              t-ret =  session:SET-WAIT-STATE("") .
     8460              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     8461                 assign
     8462                   p-road-tax-base = ?
     8463                   p-road-tax-rubl = ?
     8464                   .
     8465                 return.
     8466              end.
     8467         end.
     8468         assign
     8469             v-total-avrg-qnty = 0
     8470             v-total-road-tax-base =  0
     8471             v-total-road-tax-rubl =  0
     8472             v-all-total-road-tax-base =  0
     8473             v-all-total-road-tax-rubl =  0
     8474             .
     8475         for each x_obj-group,
     8476            each buf_parts no-lock
     8477           where buf_parts.obj-type  = x_obj-group.obj-type
     8478             and buf_parts.obj-code  = x_obj-group.obj-code
     8479             and buf_parts.artic     = p-artic
     8480             and buf_parts.prod-type = p-prod-type
     8481             and buf_parts.prod-code = p-prod-code
     8482             and buf_parts.status_   = no
     8483             and buf_parts.out-code  = 'free-zone':U
     8484             and buf_parts.qnty      > 0
     8485         on error undo, return error
     8486         :
     8487            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     8488   assign
     8489     price-rubl-with-tax-loc = buf_parts.price-rubl
     8490     price-base-with-tax-loc = buf_parts.price-base
     8491   .
     8492   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8493   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8494     (output varinvprb
     8495     )  .
     8496     if buf_parts.out-code = 'free-zone':U     or
     8497        buf_parts.out-code = 'out-zone':U   or
     8498        buf_parts.doc-type = 'акт':U then do:
     8499       assign
     8500         in-vatp-have-vat-slt = yes.
     8501     end.
     8502     else do:
     8503       find first in-vatp_doc-attr no-lock
     8504         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     8505           and in-vatp_doc-attr.attr-code = 'envd':U
     8506         no-error .
     8507       if not available in-vatp_doc-attr then do:
     8508         assign
     8509           in-vatp-have-vat-slt = yes.
     8510       end.
     8511       else do:
     8512            in-vatp-have-vat-slt = no.
     8513       end.
     8514     end.
     8515     assign
     8516      price-cli-with-tax-loc = buf_parts.price-cli
     8517      cli-base-rate          = buf_parts.cli-base-rate.
     8518     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     8519              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     8520     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     8521             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     8522             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     8523             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     8524             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     8525             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     8526             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8527       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8528     assign
     8529       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     8530     assign
     8531       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     8532       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     8533       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     8534       transport-cli-loc  = 0
     8535       other-cli-loc      = 0
     8536     .
     8537   ASSIGN
     8538             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     8539       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     8540   .
     8541           assign
     8542             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     8543             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     8544            .
     8545         end.
     8546             if v-total-avrg-qnty > 0 then  DO :
     8547                 assign
     8548                   p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     8549                   p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     8550                   .
     8551             end.
     8552               if v-total-avrg-qnty <= 0 then do :
     8553                   run last-incom-S in this-procedure
     8554                   ( input   p-artic ,
     8555                     input   p-prod-type,
     8556                     input   p-prod-code ,
     8557                     output  v-last-in-code,
     8558                     output  v-last-obj-type,
     8559                     output  v-last-obj-code ).
     8560                         find buf_trn-doc where buf_trn-doc.doc-code  = v-last-in-code no-lock no-error .
     8561                         find buf_doc-line where     buf_doc-line.doc-code  = v-last-in-code
     8562                                         and buf_doc-line.artic     = p-artic
     8563                                         and buf_doc-line.prod-type = p-prod-type
     8564                                         and buf_doc-line.prod-code = p-prod-code no-lock no-error.
     8565                         if avail buf_doc-line then do :
     8566   assign
     8567     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     8568     price-base-with-tax-loc = buf_doc-line.price-base
     8569   .
     8570   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8572     (output varinvprb
     8573     )  .
     8574      find first in-vatp_doc-attr no-lock
     8575       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     8576         and in-vatp_doc-attr.attr-code = 'envd':U
     8577       no-error .
     8578       if available in-vatp_doc-attr
     8579          then do:
     8580          assign
     8581            in-vatp-have-vat-slt = no.
     8582      end.
     8583      else do:
     8584        assign
     8585          in-vatp-have-vat-slt = yes.
     8586      end.
     8587      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     8588                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     8589                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     8590      if (not buf_trn-doc.internal and
     8591              buf_trn-doc.doc-type = 'при':U) or
     8592         in-vatp-goods.gds-type = 'у':U then do:
     8593         if varinvprb = "base":u then do:
     8594           assign
     8595             road-tax-base-loc = buf_doc-line.road-tax
     8596             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     8597         end.
     8598         else do:
     8599           ASSIGN
     8600             road-tax-rubl-loc = buf_doc-line.road-tax
     8601             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     8602         end.
     8603         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     8604         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     8605         assign
     8606           road-tax-cli-loc = ?.
     8607         ASSIGN
     8608           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     8609           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
