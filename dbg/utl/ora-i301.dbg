     6609   procedure main-road-taxs :
     6610   define input param p-artic     like ub.gds-obj.artic     no-undo .
     6611   define input param p-prod-type like ub.gds-obj.prod-type no-undo .
     6612   define input param p-prod-code like ub.gds-obj.prod-code no-undo .
     6613   define input-output param p-road-tax-base as decimal no-undo .
     6614   define input-output param p-road-tax-rubl as decimal no-undo .
     6615       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     6616       define buffer   in-vatp-parts    for ub.parts   .
     6617       define buffer   in-vatp-doc      for ub.trn-doc .
     6618       define buffer   in-vatp-goods    for ub.goods   .
     6619       define buffer   in-vatp-sysconf  for ub.sysconf .
     6620       define buffer   in-vatp_doc-attr for ub.doc-attr.
     6621       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     6622       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     6623       define variable varinvprb                  as   character              no-undo.
     6624       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     6625       define variable cli-base-rate              as   decimal                no-undo.
     6626       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     6627       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     6628       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     6629       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     6630       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6631       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6632       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6633       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6634       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6635       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6636       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6637       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     6638       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     6639       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6640       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6641       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6642       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6643       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6644       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6645       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6646       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6647       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6648       define variable varinvatp-envd             as   character              no-undo.
     6649       define variable varinvatp-type             as   character              no-undo.
     6650     do
     6651     on error undo, return error return-value
     6652     :
     6653   define buffer buff-goods   for ub.goods    .
     6654   define buffer buf_gds-obj  for ub.gds-obj  .
     6655   define buffer buf_parts    for ub.parts    .
     6656   define buffer buf_trn-doc  for ub.trn-doc  .
     6657   define buffer buf_doc-line for ub.doc-line .
     6658   define variable is-petrolium as logical   no-undo .
     6659   define variable is-pieces   as  logical   no-undo .
     6660   define variable p-in-code   as  character no-undo .
     6661   define variable p-obj-type  as  character no-undo .
     6662   define variable p-obj-code  as  integer   no-undo .
     6663   define variable v-rec as recid no-undo .
     6664   define variable t-ret as logical no-undo .
     6665   define variable v-total-avrg-base as decimal no-undo .
     6666   define variable v-total-avrg-rubl as decimal no-undo .
     6667   define variable v-total-avrg-qnty as decimal no-undo .
     6668   define variable v-total-road-tax-base     as decimal no-undo .
     6669   define variable v-total-road-tax-rubl     as decimal no-undo .
     6670   define variable v-all-total-road-tax-base as decimal no-undo .
     6671   define variable v-all-total-road-tax-rubl as decimal no-undo .
     6672   assign
     6673     p-road-tax-base = 0
     6674     p-road-tax-rubl = 0
     6675     .
     6676     Find first buff-goods no-lock where
     6677                buff-goods.artic     = p-artic and
     6678                buff-goods.prod-type = p-prod-type and
     6679                buff-goods.prod-code = p-prod-code
     6680         no-error .
     6681         if available buff-goods then do:
     6682            v-rec = recid (buff-goods).
     6683            t-ret =  session:SET-WAIT-STATE("GENERAL") .
     6684   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     6685     (
     6686        input p-artic
     6687     ,  input p-prod-type
     6688     ,  input p-prod-code
     6689     , output is-petrolium
     6690     , output is-pieces
     6691     ) .
     6692              t-ret =  session:SET-WAIT-STATE("") .
     6693              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     6694                 assign
     6695                   p-road-tax-base = 0
     6696                   p-road-tax-rubl = 0
     6697                   .
     6698                  return.
     6699              end.
     6700         end.
     6701         assign
     6702             v-total-avrg-qnty = 0
     6703             v-total-road-tax-base =  0
     6704             v-total-road-tax-rubl =  0
     6705             v-all-total-road-tax-base =  0
     6706             v-all-total-road-tax-rubl =  0
     6707             .
     6708       for each  x_obj-group ,
     6709           each buf_parts no-lock
     6710           where buf_parts.obj-type  = x_obj-group.obj-type
     6711             and buf_parts.obj-code  = x_obj-group.obj-code
     6712             and buf_parts.artic     = p-artic
     6713             and buf_parts.prod-type = p-prod-type
     6714             and buf_parts.prod-code = p-prod-code
     6715             and buf_parts.status_   = no
     6716             and buf_parts.out-code  = 'free-zone':U
     6717             and buf_parts.qnty      > 0
     6718         on error undo, return error
     6719         :
     6720            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     6721   assign
     6722     price-rubl-with-tax-loc = buf_parts.price-rubl
     6723     price-base-with-tax-loc = buf_parts.price-base
     6724   .
     6725   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6726   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6727     (output varinvprb
     6728     )  .
     6729     if buf_parts.out-code = 'free-zone':U     or
     6730        buf_parts.out-code = 'out-zone':U   or
     6731        buf_parts.doc-type = 'акт':U then do:
     6732       assign
     6733         in-vatp-have-vat-slt = yes.
     6734     end.
     6735     else do:
     6736       find first in-vatp_doc-attr no-lock
     6737         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     6738           and in-vatp_doc-attr.attr-code = 'envd':U
     6739         no-error .
     6740       if not available in-vatp_doc-attr then do:
     6741         assign
     6742           in-vatp-have-vat-slt = yes.
     6743       end.
     6744       else do:
     6745            in-vatp-have-vat-slt = no.
     6746       end.
     6747     end.
     6748     assign
     6749      price-cli-with-tax-loc = buf_parts.price-cli
     6750      cli-base-rate          = buf_parts.cli-base-rate.
     6751     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     6752              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     6753     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     6754             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     6755             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     6756             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     6757             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     6758             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     6759             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6760       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6761     assign
     6762       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     6763     assign
     6764       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6765       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6766       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6767       transport-cli-loc  = 0
     6768       other-cli-loc      = 0
     6769     .
     6770   ASSIGN
     6771             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6772       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6773   .
     6774           assign
     6775             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     6776             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     6777            .
     6778        end.
     6779         if v-total-avrg-qnty > 0 then  do :
     6780         assign
     6781             p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     6782             p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     6783             .
     6784         end.
     6785         if v-total-avrg-qnty <= 0 then do :
     6786             run last-incom-S in this-procedure
     6787                ( input p-artic
     6788                 ,input p-prod-type
     6789                 ,input p-prod-code
     6790                 ,output p-in-code
     6791                 ,output p-obj-type
     6792                 ,output p-obj-code ).
     6793               find first  buf_trn-doc no-lock  where buf_trn-doc.doc-code  = p-in-code no-error .
     6794               find first  buf_doc-line no-lock where  buf_doc-line.doc-code = p-in-code
     6795                       and buf_doc-line.artic     = p-artic
     6796                       and buf_doc-line.prod-type = p-prod-type
     6797                       and buf_doc-line.prod-code = p-prod-code
     6798               no-error.
     6799               if available buf_doc-line then do :
