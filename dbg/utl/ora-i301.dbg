     3839                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     3840                 output cost-base       ,
     3841                 output v4
     3842                 ) no-error .
     3843             end.
     3844             if not error-status :error then
     3845                 assign
     3846                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     3847                .
     3848       end.
     3849       when 'Переоценка':U then do:
     3850         find prev-list where
     3851              prev-list.b-code     = p-b-code and
     3852              prev-list.price-type = "" and
     3853              prev-list.doc-num    = v-doc-code no-lock no-error.
     3854         if available prev-list then
     3855           assign
     3856             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     3857             cur-rt-base = prev-list.road-tax
     3858             cur-rt-rubl = prev-list.road-tax
     3859             cost-rubl = prev-list.price-sale
     3860             cost-base = prev-list.price-sale
     3861             .
     3862         else
     3863           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     3864                   "- расчет невозможен."
     3865                   view-as alert-box information .
     3866       end.
     3867       when 'ДокФормЦены':U then do:
     3868       find first b_price-doc-forming no-lock where
     3869                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     3870                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     3871                  no-error .
     3872         find b_price-doc-forming-gds no-lock where
     3873              b_price-doc-forming-gds.b-code     = p-b-code and
     3874              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     3875              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     3876              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     3877              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     3878              no-error.
     3879         if available b_price-doc-forming-gds then
     3880           assign
     3881             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     3882             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     3883             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     3884             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     3885             cost-base   = b_price-doc-forming-gds.price-sale-base
     3886             .
     3887         else
     3888           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     3889                   "для товара :" skip
     3890                    "Бар-код" p-b-code     skip
     3891                    "Артикул" p-artic      skip
     3892                     p-prod-type  skip
     3893                     p-prod-code  skip
     3894                   "- расчет невозможен."
     3895                   view-as alert-box information .
     3896       end.
     3897       when 'Единая':U then do:
     3898           assign
     3899             p-new-calc-method = 'Единая':U + " " + string(common-price)
     3900             cost-rubl = common-price
     3901             cost-base = common-price
     3902             .
     3903       end.
     3904       when 'Объект':U then do:
     3905       find first buf_gds-obj no-lock where
     3906                  buf_gds-obj.gds-code = p-gds-code and
     3907                  buf_gds-obj.obj-type = v-copy-type and
     3908                  buf_gds-obj.obj-code = v-copy-code no-error .
     3909           if available buf_gds-obj then do:
     3910           assign
     3911             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     3912             cost-rubl = buf_gds-obj.price-sale
     3913             cost-base = buf_gds-obj.price-sale
     3914             .
     3915           end.
     3916           else do:
     3917               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     3918                       "для товара :" p-artic  "- расчет невозможен."
     3919                       view-as alert-box information .
     3920           end.
     3921       end.
     3922      when 'Отсутствует':U or
     3923      when "" then do:
     3924         run str/mplnovat.p
     3925           ( input  'Отсутствует':U    ,
     3926             input  table x_obj-group ,
     3927             input  p-b-code    ,
     3928             input  p-artic     ,
     3929             input  p-prod-type ,
     3930             input  p-prod-code ,
     3931             input  0 ,
     3932             input  v-doc-code ,
     3933             input  p-vat-pc      ,
     3934             input  p-slt-pc      ,
     3935             output vd  ,
     3936             output vd  ,
     3937             output cost-base   ,
     3938             output cost-rubl   ,
     3939             output cur-rt-base ,
     3940             output cur-rt-rubl
     3941             ).
     3942             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3943             cost-base = cost-rubl / p-base-rate * p-base-scale .
     3944             p-new-calc-method = 'Отсутствует':U .
     3945      end.
     3946      when 'Основная':U then do:
     3947      end.
     3948     when 'ПорогПр-НДС':U then do:
     3949       message 1.
     3950     end.
     3951     when 'ПорогПр+НДС':U then do:
     3952       message 2.
     3953     end.
     3954     when 'Производит':U
     3955        then do:
     3956         find first x_obj-group .
     3957   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3958   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3959   (  input  p-b-code
     3960    , input  x_obj-group.obj-type
     3961    , input  x_obj-group.obj-code
     3962    , output v-PriceWithVat
     3963    , output vd
     3964    , output v-prod-vat
     3965    , output v-str1
     3966    , output v-str1
     3967           ) no-error .
     3968         if vd = 0 or vd = ?  then do:
     3969           message "Нет ПН для товара :" p-artic  p-b-code
     3970                   "- расчет по производителю от последней приходной накладной невозможен."
     3971                   view-as alert-box question buttons OK-Cancel title "#2" update g#log as logical .
     3972         end.
     3973         else do:
     3974             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3975             cost-base = cost-rubl / p-base-rate * p-base-scale .
     3976         end.
     3977     end.
     3978     when 'Произв-НДС':U
     3979       then do:
     3980         find first x_obj-group .
     3981   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3982   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3983   (  input  p-b-code
     3984    , input  x_obj-group.obj-type
     3985    , input  x_obj-group.obj-code
     3986    , output vd
     3987    , output v-PriceWithVat
     3988    , output v-prod-vat
     3989    , output v-str1
     3990    , output v-str1
     3991           ) no-error .
     3992         if vd = 0 or vd = ?  then do:
     3993           message "Нет ПН для товара :" p-artic  p-b-code
     3994                   "- расчет по производителю от последней приходной накладной невозможен."
     3995                   view-as alert-box .
     3996         end.
     3997         else do:
     3998             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3999             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4000         end.
     4001       end.
     4002      otherwise do:
     4003        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     4004                  p-new-calc-method  skip
     4005                 "p-price-prev-doc " p-price-prev-doc  skip
     4006                 "mpl-lib ERR !!! " skip
     4007                 'артикул ' p-artic skip
     4008                 view-as alert-box information .
     4009      end.
     4010    end case.
     4011   run main-road-taxs in this-procedure
     4012     ( input p-artic     ,
     4013       input p-prod-type ,
     4014       input p-prod-code ,
     4015       input-output cur-rt-base ,
     4016       input-output cur-rt-rubl )
     4017       no-error .
     4018       if error-status :error then do:
     4019          message
     4020            error-status :get-message(1) skip
     4021            return-value skip
     4022            "main-road-taxs"
     4023            view-as alert-box error
     4024          .
     4025       end.
     4026     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     4027       return error "Не определен курс валюты документа" .
     4028     end.
     4029     if p-base-scale = 0  or  p-base-scale = ?  then do:
     4030        return error "Не определен курс базовой валюты " .
     4031     end.
     4032   if v-base = false then var-pr-r-b = "rubl":U .
     4033                     else var-pr-r-b =  "base":U .
     4034       if var-pr-r-b = "rubl":U then do:
     4035           case p-calc-method :
     4036            when 'ПорогПр-НДС':U then do:
     4037               message 3.
     4038            end.
     4039            when 'ПорогПр+НДС':U then do:
     4040                message 4.
     4041            end.
     4042            when 'Производит':U then do:
     4043               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)   .
     4044            end.
     4045            when 'Произв-НДС':U then do:
     4046               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 +  p-vat-pc / 100)  .
     4047            end.
     4048            otherwise do:
     4049               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     4050            end.
     4051           end case.
     4052           assign
     4053             p-price-calc-rubl  =  cost-rubl
     4054             p-road-tax-rubl    =  cur-rt-rubl
     4055             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4056             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4057             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4058           .
     4059       end.
     4060       else dO:
     4061            case p-calc-method :
     4062            when 'ПорогПр-НДС':U then do:
     4063               message 5.
     4064            end.
     4065            when 'ПорогПр+НДС':U then do:
     4066                message 6.
     4067            end.
     4068            when 'Производит':U then do:
     4069               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     4070            end.
     4071            when 'Произв-НДС':U then do:
     4072               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     4073            end.
     4074            otherwise do:
     4075               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     4076            end.
     4077            end case.
     4078           assign
     4079             p-price-calc-base  =  cost-base
     4080             p-road-tax-base    =  cur-rt-base
     4081             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     4082             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     4083             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     4084             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4085             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4086             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4087           .
     4088       end.
     4089   case p-round-method :
     4090     when '9-окончание':U then do:
     4091       if p-price-sale-doc < 29 then do:
     4092         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     4093           assign
     4094             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     4095           .
     4096         end.
     4097       end.
     4098       else do:
     4099         if (p-price-sale-doc modulo 10) < 3 then do:
     4100           assign
     4101             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4102                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4103                   - 1 ) * 10
     4104                 + 9
     4105           .
     4106         end.
     4107         else do:
     4108           assign
     4109             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4110                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4111                   ) * 10
     4112                 + 9
     4113           .
     4114         end.
     4115         assign
     4116           p-price-sale-doc = round (p-price-sale-doc, 0)
     4117         .
     4118       end.
     4119     end.
     4120     when '9-99окончание':U then do:
     4121       if p-price-sale-doc < p-round-base then do:
     4122         assign
     4123           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     4124         .
     4125       end.
     4126       else do:
     4127         assign
     4128           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     4129         .
     4130       end.
     4131     end.
     4132     when 'Без-дробных':U then do:
     4133       assign
     4134         p-price-sale-doc = round (p-price-sale-doc, 0)
     4135       .
     4136     end.
     4137     when 'Произвольно':U then do:
     4138       if p-round-base <> 0 then do:
     4139         assign
     4140           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     4141         .
     4142         if p-price-sale-doc = 0 then do:
     4143           assign
     4144             p-price-sale-doc = p-round-base
     4145           .
     4146         end.
     4147       end.
     4148     end.
     4149     when 'Вверх':U then do:
     4150       if p-round-base <> 0 then do:
     4151         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     4152           assign
     4153             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     4154           .
     4155         end.
     4156       end.
     4157       if p-price-sale-doc = 0 then do:
     4158         assign
     4159           p-price-sale-doc = p-round-base
     4160         .
     4161       end.
     4162     end.
     4163     when 'Коэффициент':U then do:
     4164       if p-round-base <> 0 then do:
     4165         assign
     4166           p-price-sale-doc = p-price-sale-doc * p-round-base
     4167         .
     4168       end.
     4169     end.
     4170     when 'Отключено':U then do:
     4171     end.
     4172     otherwise do:
     4173       message
     4174         vss-workfile vss-revision vss-description skip
     4175         "Неизвестный метод округления продажной цены" skip
     4176         "round-method" p-round-method skip
     4177         "round-base"   p-round-base   skip
     4178         "price"        p-price-sale-doc             skip
     4179         view-as alert-box error .
     4180     end.
     4181   end.
     4182       if error-status :error then do:
     4183       message
     4184         error-status :get-message(1) skip
     4185         return-value skip
     4186         "pr-99"
     4187         view-as alert-box error
     4188       .
     4189       end.
     4190     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     4191     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     4192     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     4193     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     4194     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     4195     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     4196     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     4197     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     4198     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     4199     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     4200     p-prev-doc-code = if available bufold_price-doc-forming
     4201                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     4202                          else "" .
     4203     end.
     4204   end procedure.
     4205   PROCEDURE calc-price-line :
     4206   define input  parameter  p-calc-method      as character no-undo .
     4207   define input  parameter  p-increase-pc      as decimal   no-undo .
     4208   define input  parameter  p-round-method     as character no-undo .
     4209   define input  parameter  p-round-base       as decimal   no-undo .
     4210   define input  parameter  p-b-code           as integer   no-undo .
     4211   define input  parameter  p-gds-code         as integer   no-undo .
     4212   define input  parameter  p-artic            as character no-undo .
     4213   define input  parameter  p-prod-type        as character no-undo .
     4214   define input  parameter  p-prod-code        as integer   no-undo .
     4215   define input  parameter  p-base-rate        as decimal   no-undo .
     4216   define input  parameter  p-base-scale       as decimal   no-undo .
