     6265       ,buf_price-doc-forming.start-date
     6266       ,buf_price-doc-forming.start-shift-date
     6267       ,buf_price-doc-forming.start-shift-name
     6268       ,buf_price-doc-forming.start-shift-num
     6269       ,buf_price-doc-forming.start-sys-date
     6270       ,buf_price-doc-forming.start-sys-time
     6271       ,buf_price-doc-forming.have-end-period
     6272       ,buf_price-doc-forming.end-date
     6273       ,buf_price-doc-forming.end-shift-date
     6274       ,buf_price-doc-forming.end-shift-name
     6275       ,buf_price-doc-forming.end-shift-num
     6276       ,buf_price-doc-forming.end-sys-date
     6277       ,buf_price-doc-forming.end-sys-time
     6278       ,v-price-calc-base
     6279       ,v-price-calc-doc
     6280       ,v-price-calc-rubl
     6281       ,v-price-prev-base
     6282       ,v-price-prev-doc
     6283       ,v-price-prev-rubl
     6284       ,v-price-sale-base
     6285       ,v-price-sale-doc
     6286       ,v-price-sale-rubl
     6287       ,v-road-tax-base
     6288       ,v-road-tax-doc
     6289       ,v-road-tax-rubl
     6290       ,v-excise-base
     6291       ,v-excise-doc
     6292       ,v-excise-rubl
     6293       ,v-vat-pc
     6294       ,v-slt-pc
     6295       ,v-prev-doc-code
     6296       ,0
     6297       ,input-output v-sec
     6298        ) no-error  .
     6299        if error-status :error then
     6300        message
     6301          vss-workfile vss-revision vss-description skip
     6302          error-status :get-message(1) skip
     6303          return-value skip
     6304          "4567"
     6305          view-as alert-box error
     6306        .
     6307     end.
     6308   end procedure.
     6309   procedure re-define :
     6310   define input-output parameter p-calc-method      as character no-undo .
     6311   define input        parameter p-gds-code         as integer   no-undo .
     6312     do
     6313     on error undo, return error return-value
     6314     :
     6315   define buffer buf_goods for ub.goods  .
     6316   define buffer buf_gds-grp for ub.gds-grp  .
     6317       case p-calc-method :
     6318         when 'Товар':U then do:
     6319              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     6320                   case buf_goods.calc-method:
     6321                     when 'Группа':U then do:
     6322                       find first buf_gds-grp no-lock where
     6323                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     6324                       p-calc-method  = buf_gds-grp.calc-method.
     6325                     end.
     6326                   otherwise do:
     6327                       p-calc-method  =  buf_goods.calc-method .
     6328                   end.
     6329                   end case.
     6330              run  re-define in this-procedure (
     6331                         input-output  p-calc-method ,
     6332                         input p-gds-code )  .
     6333         end.
     6334         when 'Группа':U then do:
     6335              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     6336              find first buf_gds-grp no-lock where
     6337                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     6338              run re-define in this-procedure (
     6339                         input-output buf_gds-grp.calc-method ,
     6340                         input p-gds-code )  .
     6341         end.
     6342         when 'Учетная':U or
     6343         when 'Учет-объект':U then do:
     6344              p-calc-method = 'УчетнаяS':U .
     6345         end.
     6346         when 'Учет-резерв':U then do:
     6347              p-calc-method = 'Учет-рзрвS':U.
     6348         end.
     6349         when 'Приходная':U or
     6350         when 'Прих-объект':U then do:
     6351              p-calc-method = 'ПриходнаяS':U.
     6352         end.
     6353         when 'Учет-безНДС':U then do:
     6354              p-calc-method = 'Учет-НДСS':U .
     6355         end.
     6356       end case.
     6357     end.
     6358   end procedure.
     6359   procedure create-line-pdf-mpl-lib :
     6360   define input  parameter  p-plt-db-num as integer   no-undo .
     6361   define input  parameter  p-plt-id     as integer   no-undo .
     6362   define input  parameter  p-pdf-db     as integer   no-undo .
