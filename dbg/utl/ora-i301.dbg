     9171           ub.host-grp-obj-price.stts          = 1
     9172           ub.host-grp-obj-price.sys-date      = today
     9173           ub.host-grp-obj-price.sys-time      = time
     9174           ub.host-grp-obj-price.sys-time-chr  = string(ub.host-grp-obj-price.sys-time,"hh:mm")
     9175           ub.host-grp-obj-price.who           = p-userid
     9176         .
     9177          ub.grp-obj-price.sys-time = time .
     9178          run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
     9179     end.
