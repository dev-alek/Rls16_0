     1437                    old_price-list.doc-num    = v-cur-dn and
     1438                    old_price-list.artic      = buf_goods.artic and
     1439                    old_price-list.prod-type  = buf_goods.prod-type and
     1440                    old_price-list.prod-code  = buf_goods.prod-code and
     1441                    old_price-list.main-price = no,
     1442                   first buf_bar-code no-lock where
     1443                         buf_bar-code.b-code   = old_price-list.b-code and
     1444                         buf_bar-code.in-code  = "" and
     1445                         buf_bar-code.unit-cli = buf_goods.unit-base
     1446                         :
