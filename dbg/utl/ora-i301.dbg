     1913   procedure grp-obj-notcorr-value :
     1914   do
     1915   on error undo, return error
     1916   :
     1917   define input parameter p-node-code             as integer      no-undo.
     1918   define input parameter p-obj-type              as character    no-undo.
     1919   define input parameter p-obj-code              as integer      no-undo.
     1920   define output parameter p-notcorr              as character    no-undo init ?.
     1921   define output parameter p-range-notcorr     as integer      no-undo.
     1922   define output parameter p-exists-notcorr    as logical      no-undo.
     1923   define variable v-host-code as integer      no-undo.
     1924   DEFINE VARIABLE v-found as logical no-undo .
     1925   DEFINE VARIABLE v-exists as logical no-undo .
     1926   DEFINE VARIABLE v-range as integer no-undo .
     1927   DEFINE VARIABLE jj as integer no-undo .
     1928   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1929   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1930   define buffer buf_gds-grp for ub.gds-grp.
     1931   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1932   find first buf_gds-grp no-lock where
     1933              buf_gds-grp.node-code = p-node-code no-error .
     1934   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1935     message
     1936       vss-workfile vss-revision vss-description
     1937       skip "Не удалось найти группу товаров с кодом" p-node-code
     1938       view-as alert-box error .
     1939     undo, return error .
     1940   end.
     1941   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1942   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1943     (input  p-obj-type
     1944     ,input  p-obj-code
     1945     ,output v-host-code
     1946     ) no-error .
     1947   if error-status :error
     1948   then do:
     1949       message
     1950         vss-workfile vss-revision vss-description
     1951         skip "Не удалось найти фирму объекта"
     1952         skip p-obj-type p-obj-code
     1953         skip return-value
     1954         skip trim(error-status :get-message(1))
     1955       view-as alert-box error.
     1956       undo, return error .
     1957   end.
     1958   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1959   do while v-found = no and jj < 2:
     1960     if v-range <> 3 then do:
     1961       find first buf_gds-grp-obj no-lock
     1962           where buf_gds-grp-obj.node-code = p-node-code
     1963             and buf_gds-grp-obj.host-code = v-host-code
     1964             and buf_gds-grp-obj.obj-type  = p-obj-type
     1965             and buf_gds-grp-obj.obj-code  = p-obj-code
     1966       no-error .
     1967     end.
     1968     if v-range = 3 or not available buf_gds-grp-obj
     1969     then do:
     1970        if v-range <> 2 then do:
     1971           find first buf_gds-grp-obj no-lock
     1972               where buf_gds-grp-obj.node-code = p-node-code
     1973                 and buf_gds-grp-obj.host-code = v-host-code
     1974                 and buf_gds-grp-obj.obj-type  = ""
     1975                 and buf_gds-grp-obj.obj-code  = 0
     1976           no-error .
     1977         end.
     1978         if v-range = 2 or not available buf_gds-grp-obj
     1979         then do:
     1980             if v-range <> 1 then do:
     1981               find first buf_gds-grp-obj no-lock
     1982                   where buf_gds-grp-obj.node-code = p-node-code
     1983                   and buf_gds-grp-obj.host-code = 0
     1984                   and buf_gds-grp-obj.obj-type  = ""
     1985                   and buf_gds-grp-obj.obj-code  = 0
     1986               no-error .
     1987             end.
     1988             if v-range = 1 or not available buf_gds-grp-obj
     1989             then do:
     1990                 assign
     1991                     v-exists = no
     1992                 .
     1993             end.
     1994             else do:
     1995                 assign
     1996                     v-exists = yes
     1997                     v-range = 1
     1998                 .
     1999             end.
     2000         end.
     2001         else do:
     2002             assign
     2003                 v-exists = yes
     2004                 v-range  = 2
     2005             .
     2006         end.
     2007     end.
     2008     else do:
     2009         assign
     2010             v-exists = yes
     2011             v-range  = 3
     2012         .
     2013     end.
     2014     if available buf_gds-grp-obj
     2015     then do:
     2016       find first buf_gds-grp-obj-attr no-lock
     2017         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2018           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2019           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2020           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2021           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2022         no-error .
     2023       if available buf_gds-grp-obj-attr then do:
     2024         assign
     2025           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2026         .
     2027       end.
     2028       else do:
     2029         assign
     2030           v-notcorr-value = ?
     2031         .
     2032       end.
     2033       assign
     2034       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2035                           then yes
     2036                           else p-exists-notcorr)
     2037       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2038                         then v-range
     2039                         else p-range-notcorr
     2040       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2041                         then v-notcorr-value
     2042                         else p-notcorr
     2043       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2044       jj = jj + 1
     2045       .
     2046     end.
     2047     else do:
     2048       assign
     2049       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2050       jj = jj + 1
     2051       .
     2052     end.
     2053   end.
     2054   end.
     2055   end procedure.
     2056   define variable vss-include-info28 as character format "X(65)" no-undo
     2057   initial "@(#)$Workfile$ $Revision$".
     2058   procedure grplib-get-full-name :
     2059      define input parameter p-node-code  as integer      no-undo.
     2060      define output parameter p-full-name as character    no-undo.
     2061      do
     2062   on error undo, return error
     2063   :
     2064       define variable v-upper-code    as integer           no-undo.
     2065       define buffer buf_gds-grp       for ub.gds-grp.
     2066       define buffer buf_upper_gds-grp for ub.gds-grp.
     2067       find first buf_gds-grp no-lock
     2068            where buf_gds-grp.node-code = p-node-code
     2069       no-error.
     2070       if not available buf_gds-grp
     2071       then do:
     2072           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2073       end.
     2074       assign
     2075           p-full-name  = ""
     2076           v-upper-code = 1
     2077       .
     2078       do while buf_gds-grp.upper-code <> 0
     2079       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2080       :
     2081           assign
     2082               p-full-name  = buf_gds-grp.node-name
     2083                            + (if p-full-name <> "" then chr(47) else "")
     2084                            + p-full-name
     2085               v-upper-code = buf_gds-grp.upper-code
     2086           .
     2087           find first buf_gds-grp no-lock
     2088                where buf_gds-grp.node-code = v-upper-code
     2089           no-error.
     2090           if not available buf_gds-grp
     2091           then do:
     2092               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2093                                   + string( v-upper-code )
     2094                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2095           end.
     2096       end.
     2097       assign
     2098       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2099       .
     2100   end.
     2101   end .
     2102   procedure grplib-get-node-from-full-name :
     2103   define input parameter p-full-name as character no-undo .
     2104   define output parameter p-node-code as integer no-undo .
     2105   define variable v-ii as integer no-undo .
     2106   define variable v-upper-code as integer no-undo .
     2107   define variable v-root-code as integer no-undo .
     2108   define variable v-entry as character no-undo .
     2109   define buffer buf_gds-grp       for ub.gds-grp.
     2110   do
     2111   on error undo, return error
     2112   :
     2113     find first buf_gds-grp no-lock
     2114         where buf_gds-grp.upper-code = 0
     2115     no-error .
     2116     if not available buf_gds-grp
     2117     then do:
     2118         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2119     end.
     2120     else do:
     2121       assign
     2122       v-root-code = buf_gds-grp.node-code
     2123       .
     2124     end.
     2125     v-upper-code = v-root-code.
     2126     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2127       assign
     2128       v-entry = entry(v-ii, p-full-name, chr(47)).
     2129       if v-entry = '' then leave.
     2130       find first buf_gds-grp no-lock where
     2131                 buf_gds-grp.node-name = v-entry
     2132             and buf_gds-grp.upper-code = v-upper-code
     2133             no-error.
     2134       if not available buf_gds-grp then do:
     2135         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2136       end.
     2137       else do:
     2138         p-node-code = buf_gds-grp.node-code.
     2139         v-upper-code = buf_gds-grp.node-code.
     2140       end.
     2141     end.
     2142   end.
     2143   end .
     2144   procedure  chec-par :
     2145   define output parameter l-par as logical no-undo .
     2146   define input parameter l-host like ub.clients.obj-code no-undo .
     2147   define input parameter l-type like ub.clients.obj-type no-undo .
     2148   define input parameter l-code like ub.clients.obj-code no-undo .
     2149   define variable par-type          as character no-undo.
     2150   define variable v-value-character as character no-undo .
     2151   define variable v-value-date      as date      no-undo .
     2152   define variable v-value-decimal   as decimal   no-undo .
     2153   define variable v-value-integer   as integer   no-undo .
     2154   define variable v-value-logical   as logical   no-undo .
     2155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2156     (input  'alcohol'
     2157     ,input  l-host
     2158     ,input  l-type
     2159     ,input  l-code
     2160     ,input  ''
     2161     ,input  ''
     2162     ,input  ''
     2163     ,input  no
     2164     ,output par-alcohol
     2165     ,output par-type
     2166     ) no-error .
     2167    .
     2168   empty temp-table thbjattr_thbj-attr.
     2169   run adm/shattri.p (
     2170      input "get":U
     2171     ,input l-type
     2172     ,input l-code
     2173     ,input 'overval':U
     2174     ,input  ""
     2175     ,output v-value-character
     2176     ,output v-value-date
     2177     ,output v-value-decimal
     2178     ,output v-value-integer
     2179     ,output v-value-logical
     2180     ,output par-type
     2181     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2182     ) no-error .
     2183   for each thbjattr_thbj-attr :
     2184       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2185       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2186       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2187       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     2188       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     2189       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     2190       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     2191       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     2192       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     2193       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     2194       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     2195       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2196       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2197       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     2198       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2199       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     2200       if v-cntxt-db-num = 0 then do:
     2201         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     2202         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     2203       end.
     2204       else do:
     2205         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     2206         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     2207       end.
     2208   end.
     2209   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2210   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     2211     (input  ?
     2212     ,input  l-type
     2213     ,input  l-code
     2214     ,output par-gen-mrgn-ie
     2215     ,output par-gen-mrgn-iv
     2216     ,output par-gen-mrgn-im
     2217     ) no-error .
     2218      IF error-status :error THEN message
     2219        vss-workfile vss-revision vss-description skip
     2220        error-status :get-message(1) skip
     2221        return-value skip
     2222        "gbl/gtplmrgn.i"
     2223        view-as alert-box error
     2224      .
     2225   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2226   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     2227     (input  ?
     2228     ,input  l-type
     2229     ,input  l-code
     2230     ,output par-pr-nakl-ie
     2231     ,output par-pr-nakl-iv
     2232     ,output par-pr-nakl-im
     2233     ) no-error .
     2234      define variable ii as integer   no-undo .
     2235      define variable nn as integer   no-undo .
     2236      define variable v-fullname as character no-undo .
     2237      nn = num-entries ( par-pr-nogds ).
     2238      par-pr-nogds-long = "".
     2239      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     2240         repeat ii = 1 to nn :
     2241           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     2242           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     2243         end.
     2244         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     2245      end.
     2246   l-par = true .
     2247   end procedure.
     2248   PROCEDURE cre-pr-list:
     2249   define input  parameter bc      like ub.price-list.b-code no-undo.
     2250   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     2251   define output parameter new-rec as recid             no-undo.
     2252   define buffer buf-price-list for ub.price-list.
     2253   define buffer buf-price-doc  for ub.price-doc.
     2254   define buffer buf-bar-code   for ub.bar-code.
     2255   define buffer buf-goods      for ub.goods.
     2256   define buffer buf-gds-prt    for ub.gds-prt.
     2257   define buffer root-gds-prt   for ub.gds-prt.
     2258   define variable cur-pr like ub.price-list.price-sale no-undo.
     2259   define variable cur-rt like ub.price-list.road-tax   no-undo.
     2260   define variable cur-ex like ub.price-list.excise     no-undo.
     2261   define variable cur-dn like ub.price-list.doc-num    no-undo.
     2262   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     2263   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     2264   define variable cur-rt-base as decimal no-undo .
     2265   define variable cur-rt-rubl as decimal no-undo .
     2266   define variable p-hostcode as int no-undo .
     2267   define variable v-line-num as integer no-undo .
     2268   define variable v-skip-del-gds as logical no-undo initial no .
     2269   cre-pr:
     2270   do on error undo cre-pr, return error:
     2271     find  buf-bar-code no-lock where
     2272           buf-bar-code.b-code = bc.
     2273     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     2274     if error-status :error then do:
     2275       message
     2276         return-value skip
     2277         "Ошибка !"
     2278         view-as alert-box error
     2279       .
     2280       undo cre-pr, return.
     2281     end.
     2282     find  buf-goods no-lock where
     2283           buf-goods.gds-code = buf-bar-code.gds-code.
     2284     find first root-gds-prt no-lock where
     2285               root-gds-prt.upper-code = buf-goods.prt-root.
     2286     if root-gds-prt.node-name <> '_Пустая шкала':U and
     2287       buf-bar-code.in-code <> "" then do:
     2288       message
     2289         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     2290         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2291         view-as alert-box error.
     2292       undo cre-pr, return.
     2293     end.
     2294     find  buf-gds-prt no-lock where
     2295           buf-gds-prt.node-code = buf-bar-code.node-code.
     2296     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     2297       message
     2298         "Не допускается создавать цены на удаленные товары!" skip (2)
     2299         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2300         view-as alert-box error.
     2301       undo cre-pr, return.
     2302     end.
     2303     find  buf-price-doc where
     2304           buf-price-doc.doc-num = new-num.
     2305   define variable v-ret as logical no-undo .
     2306      run ver-modificator-price-is-null (
     2307             input    buf-goods.artic        ,
     2308             input    buf-goods.prod-type    ,
     2309             input    buf-goods.prod-code    ,
     2310             input    buf-price-doc.obj-type   ,
     2311             input    buf-price-doc.obj-code   ,
     2312             output   v-ret ).
     2313         if v-ret = false then dO:
     2314             message
     2315               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     2316               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2317               view-as alert-box error.
     2318             undo cre-pr, return.
     2319           end.
     2320   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2321   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2322     (input  buf-price-doc.obj-type
     2323     ,input  buf-price-doc.obj-code
     2324     ,output p-hostcode
     2325     ) no-error .
     2326   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2327   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2328     (input  buf-goods.gds-code
     2329     ,input  '1':U
     2330     ,input  ?
     2331     ,input  p-hostcode
     2332     ,input  buf-price-doc.obj-type
     2333     ,input  buf-price-doc.obj-code
     2334     ,output local_vat-pc
     2335     ) no-error .
     2336   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2337   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2338     (input  buf-goods.gds-code
     2339     ,input  '2':U
     2340     ,input  ?
     2341     ,input  p-hostcode
     2342     ,input  buf-price-doc.obj-type
     2343     ,input  buf-price-doc.obj-code
     2344     ,output local_slt-pc
     2345     ) no-error .
     2346   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2347   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2348     (input  buf-price-doc.obj-type
     2349     ,input  buf-price-doc.obj-code
     2350     ,input  bc
     2351     ,input  0
     2352     ,input  0
     2353     ,output cur-dn
     2354     ,output cur-pr
     2355     ,output cur-rt
     2356     ,output cur-ex
     2357     ) no-error .
     2358     find first buf-price-list where
     2359               buf-price-list.b-code  = buf-bar-code.b-code and
     2360               buf-price-list.doc-num = new-num  and
     2361               buf-price-list.price-type = ""    no-error .
     2362     if not available buf-price-list then do:
     2363       run calc-price-line-num (input  new-num , output v-line-num) .
     2364       create buf-price-list.
     2365       assign
     2366         buf-price-list.line-num  = v-line-num
     2367         buf-price-list.b-code    = buf-bar-code.b-code
     2368         buf-price-list.doc-num   = buf-price-doc.doc-num
     2369         buf-price-list.prod-type = buf-goods.prod-type
     2370         buf-price-list.prod-code = buf-goods.prod-code
     2371         buf-price-list.artic     = buf-goods.artic
     2372         buf-price-list.obj-type  = buf-price-doc.obj-type
     2373         buf-price-list.obj-code  = buf-price-doc.obj-code
     2374         buf-price-list.vat-pc    = local_vat-pc
     2375         buf-price-list.slt-pc    = local_slt-pc
     2376         buf-price-list.price-prev = cur-pr
     2377         .
     2378       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     2379           buf-bar-code.in-code   = "" and
     2380           buf-bar-code.part-code = "" and
     2381           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     2382         buf-price-list.main-price = yes.
     2383         if cur-pr <> ? then do:
     2384           run exp-prt (input buf-goods.gds-code,
     2385                       input cur-dn,
     2386                       input new-num,
     2387                       output new-rec) no-error.
     2388           if error-status :error then do:
     2389             message
     2390               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     2391               view-as alert-box error.
     2392             undo cre-pr, return error.
     2393           end.
     2394         end.
     2395       end.
     2396       else do:
     2397         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2398           buf-price-list.d-pcnt = ?.
     2399         end.
     2400         buf-price-list.main-price = no.
     2401       end.
     2402     end.
     2403   end.
     2404   new-rec = recid (buf-price-list).
     2405   END PROCEDURE.
     2406   procedure calc-price-line-num :
     2407    do
     2408    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2409    :
     2410   define input parameter p-doc-num as character no-undo .
     2411   define output parameter p-num  as integer no-undo .
     2412   define variable v-fact as integer no-undo .
     2413   define buffer buf_1_price-list for ub.price-list .
     2414   p-num = 1 .
     2415   find last  buf_1_price-list no-lock where
     2416              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     2417              if available buf_1_price-list then
     2418                   assign
     2419                     v-fact = buf_1_price-list.line-num
     2420                   .
     2421   v-fact = v-fact + 1.
     2422   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     2423    end.
     2424   end procedure.
     2425   PROCEDURE del-pr-list:
     2426   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2427   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2428   define input parameter round-method as character         no-undo.
     2429   define input parameter round-base   as decimal      no-undo.
     2430   define buffer buf-price-list for ub.price-list.
     2431   define buffer buf-bar-code   for ub.bar-code.
     2432   define buffer buf-goods      for ub.goods.
     2433   define variable l-ov-on as logical no-undo .
     2434   del-pr:
     2435   do on error undo del-pr, return error:
     2436     find first  buf-price-list no-lock where
     2437                 buf-price-list.doc-num    = d-num and
     2438                 buf-price-list.b-code     = bc and
     2439                 buf-price-list.price-type = "" no-error.
     2440     if not available buf-price-list then
     2441       undo del-pr, return error.
     2442     find  buf-goods no-lock where
     2443           buf-goods.prod-type = buf-price-list.prod-type and
     2444           buf-goods.prod-code = buf-price-list.prod-code and
     2445           buf-goods.artic     = buf-price-list.artic.
     2446     if buf-price-list.main-price then do:
     2447       for each  buf-price-list exclusive-lock where
     2448                 buf-price-list.doc-num   = d-num and
     2449                 buf-price-list.artic     = buf-goods.artic and
     2450                 buf-price-list.prod-type = buf-goods.prod-type and
     2451                 buf-price-list.prod-code = buf-goods.prod-code,
     2452           first buf-bar-code no-lock where
     2453                 buf-bar-code.b-code = buf-price-list.b-code
     2454       on error undo del-pr, return error:
     2455   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2456   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2457     (input  ub.buf-price-list.obj-type
     2458     ,input  ub.buf-price-list.obj-code
     2459     ,input  ub.buf-price-list.artic
     2460     ,input  ub.buf-price-list.prod-type
     2461     ,input  ub.buf-price-list.prod-code
     2462     ,input  'ov-on=request:exclusive'
     2463     ,output l-ov-on
     2464     ) no-error .
     2465         if error-status:error then do:
     2466           message
     2467             vss-workfile vss-revision vss-description skip
     2468             "Ошибка получения признака товара на объекте" skip
     2469             error-status :get-message(1) skip
     2470             return-value skip
     2471             view-as alert-box error .
     2472         end.
     2473         if l-ov-on then do:
     2474   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2476     (input  ub.buf-price-list.obj-type
     2477     ,input  ub.buf-price-list.obj-code
     2478     ,input  ub.buf-price-list.artic
     2479     ,input  ub.buf-price-list.prod-type
     2480     ,input  ub.buf-price-list.prod-code
     2481     ,input  'ov-on=false'
     2482     ,output l-ov-on
     2483     ) no-error .
     2484           if error-status :error then do:
     2485           end.
     2486          end.
     2487         delete buf-price-list.
     2488       end.
     2489     end.
     2490     else do:
     2491       find  buf-bar-code no-lock where
     2492             buf-bar-code.b-code = buf-price-list.b-code.
     2493       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2494         message
     2495           "Нельзя удалить неосновную цену." skip
     2496           "Неосновная цена (скидка) не может быть неопределенной." skip
     2497           "Код:" bc skip
     2498           "Переоценка:" d-num
     2499           view-as alert-box error.
     2500         undo del-pr, return error.
     2501       end.
     2502       find current buf-price-list exclusive-lock no-error .
     2503       delete buf-price-list.
     2504       run calc-base-upd (input buf-bar-code.b-code,
     2505                         input d-num,
     2506                         input round-method,
     2507                         input round-base) no-error.
     2508       if error-status :error then
     2509         undo del-pr, return error.
     2510     end.
     2511   end.
     2512   END PROCEDURE.
     2513   PROCEDURE calc-base-upd:
     2514   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2515   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2516   define input parameter round-method as character         no-undo.
     2517   define input parameter round-base   as decimal      no-undo.
     2518   define buffer alt-bar-code   for ub.bar-code.
     2519   define buffer alt-price-list for ub.price-list.
     2520   define buffer buf-bar-code   for ub.bar-code.
     2521   define buffer buf-goods      for ub.goods.
     2522   calc-base:
     2523   do on error undo calc-base, return error:
     2524     find  buf-bar-code no-lock where
     2525           buf-bar-code.b-code = bc.
     2526     find  buf-goods no-lock where
     2527           buf-goods.gds-code = buf-bar-code.gds-code.
     2528     for each  alt-bar-code no-lock where
     2529               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2530               alt-bar-code.node-code = buf-bar-code.node-code and
     2531               alt-bar-code.part-code = buf-bar-code.part-code and
     2532               alt-bar-code.in-code   = buf-bar-code.in-code and
     2533               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2534         each  alt-price-list where
     2535               alt-price-list.doc-num    = d-num and
     2536               alt-price-list.b-code     = alt-bar-code.b-code and
     2537               alt-price-list.price-type = ""
     2538         on error undo calc-base, return error:
     2539       run calc-pr-alt (input d-num,
     2540                       input alt-bar-code.b-code,
     2541                       input round-method,
     2542                       input round-base) no-error.
     2543       if error-status:error then
     2544         undo calc-base, return error.
     2545     end.
     2546   end.
     2547   END PROCEDURE.
     2548   PROCEDURE calc-pr-alt:
     2549   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2550   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2551   define input parameter r-method as character             no-undo.
     2552   define input parameter r-base   as decimal              no-undo.
     2553   define buffer buf-price-doc  for ub.price-doc.
     2554   define buffer buf-price-list for ub.price-list.
     2555   define buffer buf-bar-code   for ub.bar-code.
     2556   define buffer buf-goods      for ub.goods.
     2557   define buffer old-price-list for ub.price-list.
     2558   define variable pr-rec   as   recid                  no-undo.
     2559   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2560   pr-alt:
     2561   do on error undo pr-alt, return error:
     2562     if r-method = ? or
     2563        r-base = ? then do:
     2564       message
     2565         "Нельзя удалить основную цену." skip
     2566         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2567         "Код:" bc skip
     2568         "Переоценка:" d-num
     2569         view-as alert-box error.
     2570       undo pr-alt, return error.
     2571     end.
     2572     find  buf-price-doc where
     2573           buf-price-doc.doc-num = d-num.
     2574     find  buf-bar-code no-lock where
     2575           buf-bar-code.b-code = bc.
     2576     find  buf-goods no-lock where
     2577           buf-goods.gds-code = buf-bar-code.gds-code.
     2578     find  buf-price-list where
     2579           buf-price-list.doc-num = buf-price-doc.doc-num and
     2580           buf-price-list.b-code  = bc.
     2581     if buf-price-list.d-pcnt = ? then do:
     2582   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2584     (input  buf-price-doc.obj-type
     2585     ,input  buf-price-doc.obj-code
     2586     ,input  bc
     2587     ,input  0
     2588     ,input  0
     2589     ,output pr-rec
     2590     ,output pr-c-b-r
     2591     )  .
     2592       find old-price-list no-lock where
     2593           recid (old-price-list) = pr-rec no-error.
     2594       if available old-price-list and
     2595         old-price-list.b-code = bc then
     2596         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2597       else
     2598         buf-price-list.d-pcnt = 0.
     2599     end.
     2600      if buf-price-list.d-pcnt = ? then do:
     2601         assign
     2602           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2603           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2604           .
     2605     end.
     2606     else do:
     2607         assign
     2608           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2609                                         buf-bar-code.cli-base-rate *
     2610                                         (1 - buf-price-list.d-pcnt / 100)
     2611           buf-price-list.calc-method =  'Основная':U
     2612           .
     2613   case r-method :
     2614     when '9-окончание':U then do:
     2615       if buf-price-list.price-sale < 29 then do:
     2616         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2617           assign
     2618             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2619           .
     2620         end.
     2621       end.
     2622       else do:
     2623         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2624           assign
     2625             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2626                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2627                   - 1 ) * 10
     2628                 + 9
     2629           .
     2630         end.
     2631         else do:
     2632           assign
     2633             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2634                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2635                   ) * 10
     2636                 + 9
     2637           .
     2638         end.
     2639         assign
     2640           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2641         .
     2642       end.
     2643     end.
     2644     when '9-99окончание':U then do:
     2645       if buf-price-list.price-sale < r-base then do:
     2646         assign
     2647           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2648         .
     2649       end.
     2650       else do:
     2651         assign
     2652           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2653         .
     2654       end.
     2655     end.
     2656     when 'Без-дробных':U then do:
     2657       assign
     2658         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2659       .
     2660     end.
     2661     when 'Произвольно':U then do:
     2662       if r-base <> 0 then do:
     2663         assign
     2664           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2665         .
     2666         if buf-price-list.price-sale = 0 then do:
     2667           assign
     2668             buf-price-list.price-sale = r-base
     2669           .
     2670         end.
     2671       end.
     2672     end.
     2673     when 'Вверх':U then do:
     2674       if r-base <> 0 then do:
     2675         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2676           assign
     2677             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2678           .
     2679         end.
     2680       end.
     2681       if buf-price-list.price-sale = 0 then do:
     2682         assign
     2683           buf-price-list.price-sale = r-base
     2684         .
     2685       end.
     2686     end.
     2687     when 'Коэффициент':U then do:
     2688       if r-base <> 0 then do:
     2689         assign
     2690           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2691         .
     2692       end.
     2693     end.
     2694     when 'Отключено':U then do:
     2695     end.
     2696     otherwise do:
     2697       message
     2698         vss-workfile vss-revision vss-description skip
     2699         "Неизвестный метод округления продажной цены" skip
     2700         "round-method" r-method skip
     2701         "round-base"   r-base   skip
     2702         "price"        buf-price-list.price-sale             skip
     2703         view-as alert-box error .
     2704     end.
     2705   end.
     2706     end.
     2707   end.
     2708   END PROCEDURE.
     2709   PROCEDURE calc-pr-discnt:
     2710   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2711   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2712   define buffer buf-price-doc  for ub.price-doc.
     2713   define buffer buf-price-list for ub.price-list.
     2714   define buffer buf-bar-code   for ub.bar-code.
     2715   define buffer buf-goods      for ub.goods.
     2716   define buffer old-price-list for ub.price-list.
     2717   define variable pr-rec   as   recid                  no-undo.
     2718   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2719   pr-discnt:
     2720   do on error undo pr-discnt, return error:
     2721     find  buf-price-doc where
     2722           buf-price-doc.doc-num = d-num.
     2723     find  buf-bar-code no-lock where
     2724           buf-bar-code.b-code = bc.
     2725     find  buf-goods no-lock where
     2726           buf-goods.gds-code = buf-bar-code.gds-code.
     2727     find  buf-price-list where
     2728           buf-price-list.doc-num = buf-price-doc.doc-num and
     2729           buf-price-list.b-code  = bc.
     2730     buf-price-list.d-pcnt = (1 -
     2731                              buf-price-list.price-sale /
     2732                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2733                              buf-bar-code.cli-base-rate) *
     2734                              100
     2735                              .
     2736   end.
     2737   END PROCEDURE.
     2738   PROCEDURE calc-pr-sub :
     2739   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2740   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2741   define  input  parameter calc-method  as character    no-undo.
     2742   define  input  parameter increase-pc  as decimal      no-undo.
     2743   define  input  parameter round-method as character    no-undo.
     2744   define  input  parameter round-base   as decimal      no-undo.
     2745   define  output parameter calc-rec     as recid        no-undo.
     2746   define  buffer buf-price-list for ub.price-list.
     2747   define  buffer buf-bar-code   for ub.bar-code.
     2748   define  buffer buf-goods      for ub.goods.
     2749   define  buffer buf-gds-prt    for ub.gds-prt.
     2750   define  buffer buf-gds-grp    for ub.gds-grp.
     2751   define  buffer buf-price-doc  for ub.price-doc.
     2752   calc-sub:
     2753   do on error undo calc-sub, return error:
     2754     find  buf-bar-code no-lock where
     2755           buf-bar-code.b-code = bc.
     2756     find  buf-goods no-lock where
     2757           buf-goods.gds-code = buf-bar-code.gds-code.
     2758     find  buf-gds-prt no-lock where
     2759           buf-gds-prt.node-code = buf-bar-code.node-code.
     2760     find  buf-price-list where
     2761           buf-price-list.doc-num    = d-num and
     2762           buf-price-list.b-code     = bc and
     2763           buf-price-list.price-type = "".
     2764     find  buf-price-doc where
     2765           buf-price-doc.doc-num = d-num.
     2766     calc-rec = recid (buf-price-list).
     2767     if buf-price-list.main-price then do:
     2768       for each  buf-price-list where
     2769                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2770                 buf-price-list.main-price = no and
     2771                 buf-price-list.artic      = buf-goods.artic and
     2772                 buf-price-list.prod-type  = buf-goods.prod-type and
     2773                 buf-price-list.prod-code  = buf-goods.prod-code,
     2774           first buf-bar-code no-lock where
     2775                 buf-bar-code.b-code   = buf-price-list.b-code and
     2776                 buf-bar-code.unit-cli = buf-goods.unit-base
     2777           on error undo calc-sub, return error:
     2778         run calc-pr-list (input  buf-bar-code.b-code,
     2779                           input  buf-price-list.doc-num,
     2780                           input  calc-method,
     2781                           input  increase-pc,
     2782                           input  round-method,
     2783                           input  round-base,
     2784                           input ? ,
     2785                           input ? ,
     2786                           input ? ,
     2787                           input ? ,
     2788                           output calc-rec) no-error.
     2789         if error-status :error then
     2790           undo calc-sub, return error.
     2791         calc-rec = recid (buf-price-list).
     2792       end.
     2793       for each  buf-price-list where
     2794                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2795                 buf-price-list.main-price = no and
     2796                 buf-price-list.artic      = buf-goods.artic and
     2797                 buf-price-list.prod-type  = buf-goods.prod-type and
     2798                 buf-price-list.prod-code  = buf-goods.prod-code,
     2799           first buf-bar-code no-lock where
     2800                 buf-bar-code.b-code    = buf-price-list.b-code and
     2801                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2802           on error undo calc-sub, return error:
     2803         run calc-pr-alt (input buf-price-doc.doc-num,
     2804                         input buf-bar-code.b-code,
     2805                         input round-method,
     2806                         input round-base) no-error.
     2807         if error-status :error then
     2808           undo calc-sub, return error.
     2809       end.
     2810     end.
     2811     else do:
     2812       run calc-base-upd (input buf-bar-code.b-code,
     2813                         input buf-price-doc.doc-num,
     2814                         input round-method,
     2815                         input round-base) no-error.
     2816       if error-status :error then
     2817         undo calc-sub, return error.
     2818     end.
     2819   end.
     2820   END PROCEDURE.
     2821   procedure ver-pr-nogds :
     2822   define input  parameter p-gds-code      as integer   no-undo .
     2823   define input  parameter p-par-pr-nogds  as character no-undo .
     2824   define output parameter p-not           as logical   no-undo .
     2825   define output parameter p-str           as character no-undo .
     2826   define buffer buf_goods for ub.goods  .
     2827   define variable nn as integer   no-undo .
     2828   define variable ii as integer   no-undo .
     2829   define variable v-namegrp as character no-undo .
     2830     do
     2831     on error undo, return error return-value
     2832     :
     2833     if p-par-pr-nogds = "1" then do:
     2834        assign
     2835         p-not = true
     2836         p-str = ""
     2837        .
     2838        return .
     2839     end.
     2840     assign
     2841       p-not = false
     2842       p-str = ""
     2843     .
     2844     find first buf_goods no-lock where
     2845                buf_goods.gds-code = p-gds-code no-error .
     2846     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2847     repeat ii = 1 to nn:
     2848        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2849        if buf_goods.grp-name  begins v-namegrp  then do:
     2850           assign
     2851             p-not = true
     2852             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2853           .
     2854           leave .
     2855        end.
     2856     end.
     2857     end.
     2858   end procedure.
     2859   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2860   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2861   define temp-table tt-level-dis-attr no-undo
     2862         field attr-code   like global-state-attr.attr-code
     2863         field attr-value  like global-state-attr.attr-value
     2864         index pi   attr-value descending
     2865         index pi1 is unique attr-value
     2866               attr-code .
     2867   procedure lvldsc-byattr :
     2868   define input  parameter p-attr-code  as character no-undo .
     2869   define input  parameter p-attr-value as character no-undo .
     2870   define output parameter p-val1       as decimal   no-undo .
     2871   define output parameter p-val2       as decimal   no-undo .
     2872   define output parameter p-prc        as decimal   no-undo .
     2873     do
     2874     on error undo, return error return-value
     2875     :
     2876     define variable v-str1 as character no-undo .
     2877     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     2878     v-str1 = trim ( v-str1 , chr(4) ) .
     2879    run lvldsc-bytt (
     2880         input   v-str1
     2881       , input   p-attr-value
     2882       , output  p-val1
     2883       , output  p-val2
     2884       , output  p-prc )
     2885         no-error .
     2886     end.
     2887   end procedure.
     2888   procedure lvldsc-bytt :
     2889   define input  parameter p-attr-code as character no-undo .
     2890   define input  parameter p-attr-value as character no-undo .
     2891   define output parameter p-val1 as decimal   no-undo .
     2892   define output parameter p-val2 as decimal   no-undo .
     2893   define output parameter p-prc  as decimal   no-undo .
     2894   define variable v-str1 as character no-undo .
     2895     do
     2896     on error undo, return error return-value
     2897     :
     2898     assign
     2899        v-str1 = trim ( p-attr-code , "[]()" )
     2900        p-val1 = decimal(entry(1,v-str1, ";"))
     2901        p-val2 = decimal(entry(2,v-str1, ";"))
     2902        p-prc  = decimal(p-attr-value)
     2903        no-error
     2904     .
     2905     end.
     2906   end procedure.
     2907   procedure level-dis-value :
     2908   define input  parameter p-price-prod as decimal   no-undo .
     2909   define input  parameter p-b-code     as integer   no-undo .
     2910   define input  parameter p-obj-type   as character no-undo .
     2911   define input  parameter p-obj-code   as integer   no-undo .
     2912   define output parameter p-prc as decimal   no-undo .
     2913   define variable v-level-dis-attr as character no-undo .
     2914   define variable v-type as character no-undo .
     2915   define variable v-val1 as decimal   no-undo .
     2916   define variable v-val2 as decimal   no-undo .
     2917   define variable v-prc  as decimal   no-undo .
     2918   define variable ix     as integer   no-undo .
     2919   do
     2920    on error undo, return error return-value
     2921    :
     2922   define buffer buf_goods for ub.goods  .
     2923   define buffer buf_bar-code for ub.bar-code  .
     2924   find first buf_bar-code no-lock where
     2925              buf_bar-code.b-code = p-b-code
     2926              no-error .
     2927   find first buf_goods no-lock where
     2928              buf_goods.gds-code = buf_bar-code.gds-code
     2929              no-error .
     2930   run ggoattr-value (
     2931      input   buf_goods.grp-code
     2932     ,input   v-cntxt-host-code-obj
     2933     ,input   p-obj-type
     2934     ,input   p-obj-code
     2935     ,input   'level-dis':U
     2936     ,output  v-level-dis-attr
     2937     ,output  v-type ) no-error .
     2938   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     2939     create
     2940       tt-level-dis-attr
     2941     .
     2942     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2943     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2944   end.
     2945   p-prc = 0 .
     2946     if p-price-prod = 0 then do:
     2947         for each tt-level-dis-attr no-lock
     2948                 :
     2949               run lvldsc-bytt (
     2950                 input   tt-level-dis-attr.attr-code
     2951               , input   tt-level-dis-attr.attr-value
     2952               , output  v-val1
     2953               , output  v-val2
     2954               , output  v-prc  )
     2955               .
     2956               if v-val1  = 0  then do:
     2957                  p-prc = v-prc .
     2958                 leave.
     2959               end.
     2960         end.
     2961     end.
     2962     else do:
     2963         for each tt-level-dis-attr no-lock
     2964                 :
     2965               run lvldsc-bytt (
     2966                 input   tt-level-dis-attr.attr-code
     2967               , input   tt-level-dis-attr.attr-value
     2968               , output  v-val1
     2969               , output  v-val2
     2970               , output  v-prc  )
     2971               .
     2972               if p-price-prod   > v-val1 and
     2973                  p-price-prod  <= v-val2 then do:
     2974                  p-prc = v-prc .
     2975                 leave.
     2976               end.
     2977         end.
     2978     end.
     2979   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     2980    end.
     2981   end procedure.
     2982   procedure calc-price-levelprod :
     2983   define input  parameter p-mode     as integer   no-undo .
     2984   define input  parameter p-rb       as character no-undo .
     2985   define input  parameter p-b-code   as integer   no-undo .
     2986   define input  parameter p-obj-type as character no-undo .
     2987   define input  parameter p-obj-code as integer   no-undo .
     2988   define output parameter p-price-sale as decimal   no-undo .
     2989   define output parameter p-descript-calc as character no-undo .
     2990   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     2991   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     2992   define variable  v-prod-vat        as decimal   no-undo init 0.
     2993   define variable  v-discnt          as decimal   no-undo init 0.
     2994   define buffer buf_goods for ub.goods  .
     2995   define buffer buf_bar-code for ub.bar-code  .
     2996   define buffer buf_parts for ub.parts  .
     2997   define variable v-part-code as character no-undo .
     2998   define variable v-in-code   as character no-undo .
     2999     do
     3000     on error undo, return error return-value
     3001     :
     3002   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3003   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3004   (  input  p-b-code
     3005    , input  p-obj-type
     3006    , input  p-obj-code
     3007    , output v-PriceWithoutVat
     3008    , output v-PriceWithVat
     3009    , output v-prod-vat
     3010    , output v-part-code
     3011    , output v-in-code
     3012           ) no-error .
     3013         if error-status :error then do:
     3014           return error "Нет цены производителя!".
     3015         end.
     3016   find first buf_bar-code no-lock where
     3017              buf_bar-code.b-code = p-b-code
     3018              no-error .
     3019   find first buf_goods no-lock where
     3020              buf_goods.gds-code = buf_bar-code.gds-code
     3021              no-error .
     3022   find first buf_parts no-lock where
     3023              buf_parts.artic      = buf_goods.artic        and
     3024              buf_parts.prod-type  = buf_goods.prod-type    and
     3025              buf_parts.prod-code  = buf_goods.prod-code    and
     3026              buf_parts.in-code    = buf_bar-code.in-code   and
     3027              buf_parts.out-code   = buf_bar-code.in-code   and
     3028              buf_parts.part-code  = buf_bar-code.part-code
     3029              no-error .
     3030               if error-status :error then do:
     3031                   find first buf_parts no-lock where
     3032                             buf_parts.artic      = buf_goods.artic        and
     3033                             buf_parts.prod-type  = buf_goods.prod-type    and
     3034                             buf_parts.prod-code  = buf_goods.prod-code    and
     3035                             buf_parts.in-code    = v-in-code              and
     3036                             buf_parts.out-code   = v-in-code              and
     3037                             buf_parts.part-code  = v-part-code
     3038                             no-error .
     3039                   if error-status :error then do:
     3040                      message
     3041                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     3042                                   v-in-code,
     3043                                   v-part-code ,
     3044                                   buf_goods.artic   ,
     3045                                   buf_goods.prod-type,
     3046                                   buf_goods.prod-code ) .
     3047                      return error "Нет цены производителя !!!".
     3048                   end.
     3049               end.
     3050   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     3051   define variable v-postWithoutVat-rubl as decimal   no-undo .
     3052   define variable v-postWithoutVat-base as decimal   no-undo .
     3053      case p-mode :
     3054       when 1 then do:
     3055          if p-rb = "rubl" then do:
     3056             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     3057          end.
     3058          else do:
     3059             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     3060          end.
     3061       end.
     3062       when 2 then do:
     3063         if p-rb = "rubl" then do:
     3064           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     3065           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     3066         end.
     3067         else do:
     3068           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     3069           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     3070         end.
     3071       end.
     3072      end case.
     3073   p-descript-calc =
     3074     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     3075     buf_goods.gds-name                  +  chr(10) +
     3076     buf_goods.artic +
     3077     buf_goods.prod-type +
     3078     string(buf_goods.prod-code)         + chr(10) +
     3079     "бар-код " +  string(p-b-code)      + chr(10)  +
     3080     'ПН    ' + v-in-code  +
     3081     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     3082     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     3083     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     3084     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     3085     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     3086     chr(10) +
     3087     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     3088     chr(10) +
     3089     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     3090     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     3091     chr(10) +
     3092     string(p-price-sale)                                                               +  chr(10) +
     3093     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     3094     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     3095   .
     3096     end.
     3097   end procedure.
