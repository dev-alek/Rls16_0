    10601     )  .
    10602   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10603   empty temp-table thbjattr_thbj-attr.
    10604   run adm/shattri.p (
    10605      input "get":U
    10606     ,input p-obj-type
    10607     ,input p-obj-code
    10608     ,input 'overval':U
    10609     ,input  ""
    10610     ,output v-value-character
    10611     ,output v-value-date
    10612     ,output v-value-decimal
    10613     ,output v-value-integer
    10614     ,output v-value-logical
    10615     ,output par-type
    10616     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10617     ) no-error .
    10618     for each thbjattr_thbj-attr :
    10619       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then loc_calc-increase-pc = thbjattr_thbj-attr.property-value-decimal .
    10620       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then loc_calc-round-method = thbjattr_thbj-attr.property-value-character .
    10621       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then loc_calc-round-base = thbjattr_thbj-attr.property-value-decimal .
    10622     end.
    10623     case loc_calc-round-method:
    10624       when "pr-round-9end" then
    10625         loc_calc-round-method = '9-окончание':U.
    10626       when "pr-round-9-99end" then
    10627         loc_calc-round-method = '9-99окончание':U.
    10628       when "pr-round-integer" then
    10629         loc_calc-round-method = 'Без-дробных':U.
    10630       when "pr-round-select" then
    10631         loc_calc-round-method = 'Произвольно':U.
    10632       when "pr-round-up" then
    10633         loc_calc-round-method = 'Вверх':U.
    10634       when "pr-round-coef" then
    10635         loc_calc-round-method = 'Коэффициент':U.
    10636       when "pr-round-off" then
    10637         loc_calc-round-method = 'Отключено':U.
    10638       otherwise
    10639         loc_calc-round-method = 'Отключено':U.
    10640     end case.
    10641   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10642   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
    10643     (output v-is-base
    10644     )  .
    10645   loc_calc-method = 'Отсутствует':U.
    10646   do transaction :
    10647   if p-gop-id = 0 then do:
    10648       assign
    10649         p-gop-id = next-value ( s-gop , ub )
    10650         p-gop-db-num =  v-cntxt-db-num
    10651         .
    10652       create ub.grp-obj-price.
    10653       assign
    10654         ub.grp-obj-price.gop-db-num   = p-gop-db-num
    10655         ub.grp-obj-price.gop-id       = p-gop-id
    10656         ub.grp-obj-price.db-num-chg   = v-cntxt-db-num
    10657         ub.grp-obj-price.stts         = 0
    10658         ub.grp-obj-price.sys-date     = today
    10659         ub.grp-obj-price.sys-time     = time
    10660         ub.grp-obj-price.sys-time-chr = string(ub.grp-obj-price.sys-time,"hh:mm")
    10661         ub.grp-obj-price.who          = v-cntxt-userid
    10662         ub.grp-obj-price.name-group   = "По объекту " + p-obj-type + string ( p-obj-code )
    10663         .
    10664         run  objo-ADD (
    10665           input  p-gop-db-num  ,
    10666           input  p-gop-id            ,
    10667           input  p-obj-type  ,
    10668           input  p-obj-code  ,
    10669           input  0               ,
    10670           input  v-cntxt-db-num  ,
    10671           input  v-cntxt-userid  ,
    10672           output p-recid ) .
    10673   end.
    10674   find first ub.price-list-type no-lock where
    10675              ub.price-list-type.main = true and
    10676              ub.price-list-type.gop-id = p-gop-id and
    10677              ub.price-list-type.gop-db-num = p-gop-db-num and
    10678              ub.price-list-type.stts       = 0 and
    10679              ub.price-list-type.only-gbd = integer ( true ) and
    10680              ub.price-list-type.plt-db-num = v-cntxt-db-num no-error .
    10681       if available ub.price-list-type then do:
    10682          v-plt-id = ub.price-list-type.plt-id .
    10683       end.
    10684       else do:
    10685       v-plt-id = next-value (s-plt, ub)  .
    10686           run type-price-list-ADD (
    10687               v-cntxt-db-num
    10688             , v-plt-id
    10689             , "ГТПЛ по объекту " + p-obj-type + string (p-obj-code)
    10690             , 0
    10691             , loc_calc-round-method
    10692             , loc_calc-round-base
    10693             , loc_calc-increase-pc
    10694             , loc_calc-method
    10695             , int ( true )
    10696             , false
    10697             , false
    10698             , int ( false )
    10699             , false
    10700             , true
    10701             , int ( true  )
    10702             , v-cntxt-db-num
    10703             ,  ?
    10704             ,  0
    10705             ,  0
    10706             ,  true
    10707             ,  int  ( true  )
    10708             ,  ?
    10709             ,  ?
    10710             ,  int ( false )
    10711             ,  0
    10712             ,  int ( false )
    10713             ,  2
    10714             ,  0
    10715             ,  v-cntxt-db-num
    10716             ,  ?
    10717             ,  v-curr-code
    10718             ,  p-gop-db-num
    10719             ,  v-cntxt-db-num
    10720             ,  p-gop-id
    10721             ,  ?
    10722             ,  v-cntxt-db-num
    10723             ,  ?
    10724             ,  v-cntxt-db-num
    10725             ,  ?
    10726             ,  v-cntxt-db-num
    10727             ,  ?
    10728             ,  ?
    10729             ,  v-cntxt-db-num
    10730             ,  v-cntxt-userid
    10731             ,  v-cntxt-db-num
    10732             ,  int( false )
    10733             ,  0
    10734             ,  ?
    10735             ,  int( false  )
    10736             ,  int( false  )
    10737             ,  output p-recid
    10738             ,  input table TT_cassa
    10739             ,  input table TT_grp
    10740             ,  input table TT_pay-type
    10741             ,  input table TT_cash-pay
    10742             ) no-error .
    10743             find first ub.price-list-type no-lock where recid(ub.price-list-type) =  p-recid no-error .
    10744                       .
    10745        end.
    10746   end.
    10747   end.
    10748   end procedure.
    10749   procedure get-userid :
    10750   define output parameter v-cntxt-userid  as character no-undo .
    10751     do
    10752     on error undo, return error return-value
    10753     :
    10754        run get-userid in parparentproc (output v-cntxt-userid ) .
    10755     end.
