     3252   FUNCTION fnc-base-price-doc RETURN decimal
     3253     ( local-bc as integer, p-recid as recid ).
     3254   define buffer   base-price       for ub.price-doc-forming-gds .
     3255   define variable local-main-code like ub.bar-code.b-code no-undo.
     3256   define variable local-base-code like ub.bar-code.b-code no-undo.
     3257   define buffer   buf_main-pdf     for ub.price-doc-forming .
     3258   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     3259     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     3260     find base-price no-lock where
     3261          base-price.pdf-id = buf_main-pdf.pdf-id and
     3262          base-price.pdf-db = buf_main-pdf.pdf-db and
     3263          base-price.plt-id = buf_main-pdf.plt-id and
     3264          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     3265          base-price.b-code  = local-base-code
     3266          no-error.
     3267     if not available base-price then do:
     3268       run prc-main-code in this-procedure
     3269          ( input local-bc, output local-main-code ).
     3270       find  base-price no-lock where
     3271             base-price.pdf-id = buf_main-pdf.pdf-id and
     3272             base-price.pdf-db = buf_main-pdf.pdf-db and
     3273             base-price.plt-id = buf_main-pdf.plt-id and
     3274             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     3275             base-price.b-code  = local-main-code
     3276             no-error.
     3277     end.
     3278     if available base-price then
     3279       return (base-price.price-sale-doc).
     3280     else
     3281       return (?).
     3282   END FUNCTION.
