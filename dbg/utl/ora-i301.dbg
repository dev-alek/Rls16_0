     1083       buf_price-doc.base-scale     = v-base-scale
     1084       buf_price-doc.cr-db-num      = p-curr-db-num
     1085       buf_price-doc.doc-date       = v-obj-current-date
     1086       buf_price-doc.fact-num       = 0
     1087       buf_price-doc.host-code      = v-host-code
     1088       buf_price-doc.is-corr        = false
     1089       buf_price-doc.is-del         = false
     1090       buf_price-doc.obj-code       = p-obj-code
     1091       buf_price-doc.obj-type       = p-obj-type
     1092       buf_price-doc.out-code       = ""
     1093       buf_price-doc.pdf-db         = p-pdf-db-num
     1094       buf_price-doc.pdf-id         = p-pdf-id
     1095       buf_price-doc.plt-db-num     = p-plt-db-num
     1096       buf_price-doc.plt-id         = p-plt-id
     1097       buf_price-doc.PS             = "@ "
     1098       buf_price-doc.rest-base      = 0
     1099       buf_price-doc.rest-last      = 0
     1100       buf_price-doc.rest-qnty      = 0
     1101       buf_price-doc.rest-sale      = 0
     1102       buf_price-doc.sale-base      = 0
     1103       buf_price-doc.status_        = 'новый':U
     1104       .
     1105       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     1106       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     1107       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     1108       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     1109       assign
     1110           p-price-doc-recid = recid ( buf_price-doc )
     1111       .
     1112   end.
     1113   end procedure.
     1114   procedure prcreate-new-price-list :
     1115   do
     1116   on error undo, return error return-value
     1117   :
     1118   define input parameter p-price-doc-recid   as recid                    no-undo.
     1119   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     1120   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     1121   define output parameter p-update           as logical                  no-undo.
     1122   define variable kk as integer no-undo .
     1123   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1124   define variable p-hostcode as int no-undo .
     1125   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1126   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1127   define buffer buf_price-doc        for ub.price-doc.
     1128   define buffer buf_price-list       for ub.price-list.
     1129   define buffer buf_bar-code         for ub.bar-code.
     1130   define buffer buf_goods            for ub.goods.
     1131   define buffer buf_root_gds-prt     for ub.gds-prt.
     1132   define buffer buf_gds-prt          for ub.gds-prt.
     1133   find first buf_price-doc no-lock
     1134        where recid( buf_price-doc ) = p-price-doc-recid
     1135   .
     1136   find first buf_goods no-lock
     1137        where buf_goods.gds-code = p-gds-code
     1138   .
     1139   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1140     (input  p-gds-code
     1141     ,input  ?
     1142     ,output v-b-code
     1143     ) no-error .
     1144   if error-status :error
     1145   then do:
     1146       message
     1147           "Не найден основной бар-код"
     1148           skip "для товара "
     1149           skip string(buf_goods.artic)
     1150           skip buf_goods.gds-name
     1151       view-as alert-box
     1152       title "Ошибка при выполнении prcreate.i".
     1153       undo, return error .
     1154   end.
     1155   find first buf_bar-code no-lock
     1156        where buf_bar-code.b-code = v-b-code
     1157   no-error.
     1158   if error-status :error
     1159   then do:
     1160       message
     1161           "Не найдена запись bar-code"
     1162           skip "для товара "
     1163           skip string(buf_goods.artic)
     1164           skip buf_goods.gds-name
     1165           skip "С основным бар-кодом"
     1166           skip string(v-b-code)
     1167       view-as alert-box
     1168       title "Ошибка при выполнении prcreate.i".
     1169       undo, return error .
     1170   end.
     1171   find first buf_root_gds-prt no-lock
     1172        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1173   .
     1174   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1175     and buf_bar-code.in-code <> ""
     1176   then do:
     1177       message
     1178           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1179           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1180           view-as alert-box error.
     1181       undo, return error.
     1182   end.
     1183   find first buf_gds-prt no-lock
     1184        where buf_gds-prt.node-code = buf_bar-code.node-code
     1185   .
     1186   find first buf_price-list
     1187        where buf_price-list.doc-num = buf_price-doc.doc-num
     1188          and buf_price-list.b-code  = v-b-code
     1189   no-error.
     1190   if available buf_price-list
     1191   then do:
     1192       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1193          skip "  Цена:   " buf_price-list.price-sale
     1194          skip "Цена будет изменена"
     1195       view-as alert-box warning.
     1196       assign
     1197           p-update = yes
     1198       .
     1199   end.
     1200   else do:
     1201   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1202   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1203     (input  buf_price-doc.obj-type
     1204     ,input  buf_price-doc.obj-code
     1205     ,output p-hostcode
     1206     ) no-error .
     1207   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1208   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1209     (input  buf_goods.gds-code
     1210     ,input  '1':U
     1211     ,input  ?
     1212     ,input  p-hostcode
     1213     ,input  buf_price-doc.obj-type
     1214     ,input  buf_price-doc.obj-code
     1215     ,output local_vat-pc
     1216     ) no-error .
     1217   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1219     (input  buf_goods.gds-code
     1220     ,input  '2':U
     1221     ,input  ?
     1222     ,input  p-hostcode
     1223     ,input  buf_price-doc.obj-type
     1224     ,input  buf_price-doc.obj-code
     1225     ,output local_slt-pc
     1226     ) no-error .
     1227       kk = kk + 1.
     1228   define variable v-main-bar-code as integer   no-undo .
     1229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1230     (input  buf_goods.gds-code
     1231     ,input  ?
     1232     ,output v-main-bar-code
     1233     )  .
     1234       create buf_price-list.
     1235       assign
     1236           buf_price-list.line-num    = kk
     1237           buf_price-list.doc-num     = buf_price-doc.doc-num
     1238           buf_price-list.b-code      = buf_bar-code.b-code
     1239           buf_price-list.artic       = buf_goods.artic
     1240           buf_price-list.prod-type   = buf_goods.prod-type
     1241           buf_price-list.prod-code   = buf_goods.prod-code
     1242           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1243           buf_price-list.calc-method = 'Отсутствует':U
     1244           buf_price-list.obj-type    = buf_price-doc.obj-type
     1245           buf_price-list.obj-code    = buf_price-doc.obj-code
     1246           buf_price-list.price-sale  = p-price-sale
     1247           buf_price-list.vat-pc      = local_vat-pc
     1248           buf_price-list.slt-pc      = local_slt-pc
     1249           p-update                   = no
     1250       .
     1251   end.
     1252   end.
     1253   end procedure.
     1254   procedure create_new_price-doc-forming :
     1255   define input  parameter p-obj-type   as character no-undo .
     1256   define input  parameter p-obj-code   as integer   no-undo .
     1257   define output parameter p-pdf-db-num as integer   no-undo .
     1258   define output parameter p-pdf-id     as integer   no-undo .
     1259   define output parameter p-plt-db-num as integer   no-undo .
     1260   define output parameter p-plt-id     as integer   no-undo .
     1261   define buffer buf_price-list-type for ub.price-list-type  .
     1262   define variable v-host-code  as integer   no-undo .
     1263   define variable v-base-rate  as decimal   no-undo .
     1264   define variable v-base-scale as integer   no-undo .
     1265   define variable v-exch-rate  as decimal   no-undo .
     1266   define variable v-exch-scale as integer   no-undo .
     1267   define variable v-base as logical   no-undo .
     1268     do
