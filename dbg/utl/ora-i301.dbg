     3099   PROCEDURE write-bonus :
     3100   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3101   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3102   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3103   define input  parameter v-bonus as decimal   no-undo .
     3104     do
     3105     on error undo, return error return-value
     3106     :
     3107       find first ub.contract-specif-attr exclusive-lock  where
     3108                  ub.contract-specif-attr.contract-num = p-contract-num  and
     3109                  ub.contract-specif-attr.host-code    = p-host-code     and
     3110                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     3111                  ub.contract-specif-attr.attr-code    = 'bonus':U
     3112                 no-error .
     3113         if not available ub.contract-specif-attr then do:
     3114            create ub.contract-specif-attr .
     3115            assign
     3116                 ub.contract-specif-attr.contract-num = p-contract-num
     3117                 ub.contract-specif-attr.host-code    = p-host-code
     3118                 ub.contract-specif-attr.gds-code     = p-gds-code
     3119                 ub.contract-specif-attr.attr-code    = 'bonus':U
     3120            .
     3121         end.
     3122         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     3123   end.
     3124   END PROCEDURE.
     3125   PROCEDURE read-bonus :
