     7424     define buffer old_price-doc-forming for ub.price-doc-forming  .
     7425     define buffer old_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7426     define buffer old_price-all for ub.price-all.
     7427     if buf_price-list-type.main = false then do:
     7428        for each old_price-doc-forming no-lock where
     7429                 old_price-doc-forming.plt-id     = buf_price-list-type.plt-id     and
     7430                 old_price-doc-forming.plt-db-num = buf_price-list-type.plt-db-num and
     7431                 old_price-doc-forming.stts       = integer('3':U)  ,
     7432                 each old_price-doc-forming-gds no-lock where
     7433                       old_price-doc-forming-gds.plt-id     = buf_price-list-type.plt-id      and
     7434                       old_price-doc-forming-gds.plt-db-num = buf_price-list-type.plt-db-num  and
     7435                       old_price-doc-forming-gds.pdf-id     = old_price-doc-forming.pdf-id    and
     7436                       old_price-doc-forming-gds.pdf-db     = old_price-doc-forming.pdf-db    and
     7437                       old_price-doc-forming-gds.b-code     = buf_price-doc-forming-gds.b-code :
     7438                for each old_price-all no-lock where
     7439                         old_price-all.plt-id     = old_price-doc-forming-gds.plt-id      and
     7440                         old_price-all.plt-db-num = old_price-doc-forming-gds.plt-db-num  and
     7441                         old_price-all.pdf-id     = old_price-doc-forming-gds.pdf-id      and
     7442                         old_price-all.pdf-db     = old_price-doc-forming-gds.pdf-db      and
     7443                         old_price-all.b-code     = old_price-doc-forming-gds.b-code      and
     7444                         old_price-all.fact-order-sys-to   >= v-fact-order-sys-from       and
     7445                         old_price-all.fact-order-sys-from <= v-fact-order-sys-to         :
     7446                        return error substitute ("По товару &1 &2 &3 есть цена &6 в пересекающийся период с таким же приоритетом &7 (ДНЦ &4 &5) " ,
     7447                                                  buf_price-doc-forming-gds.artic ,
     7448                                                  buf_price-doc-forming-gds.prod-type ,
     7449                                                  buf_price-doc-forming-gds.prod-code,
     7450                                                  old_price-all.pdf-id ,
     7451                                                  old_price-all.pdf-db ,
     7452                                                  old_price-doc-forming-gds.price-sale-doc ,
     7453                                                  old_price-all.plt-priority
     7454                                                  ) .
     7455                end.
     7456        end.
     7457        end.
     7458       assign v-kol-rec = v-kol-rec + 1 .
