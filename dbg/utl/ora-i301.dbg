     3720             v-pdf-db-num  = buf_price-doc-forming.pdf-db
     3721             v-plt-id2     = buf_price-doc-forming.plt-id
     3722             v-plt-db-num2 = buf_price-doc-forming.plt-db-num
     3723           .
