     1448                          if error-status :error then next.
     1449                    run create-line-pdf-mpl-lib (
     1450                          input buf_price-doc-forming.plt-db-num
     1451                         ,input buf_price-doc-forming.plt-id
     1452                         ,input buf_price-doc-forming.pdf-db
