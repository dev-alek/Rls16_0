     9654   PROCEDURE type-price-list-delete :
     9655   define input  parameter p-db-num       as integer   no-undo .
     9656   define input  parameter p-id           as integer   no-undo .
     9657   define input  parameter p-db-num-usr   as integer   no-undo .
     9658   define input  parameter p-userid       as character no-undo .
     9659   define buffer child_price-list-type for ub.price-list-type  .
     9660     do
     9661     on error undo, return error return-value
     9662     :
     9663   find first ub.price-list-type exclusive-lock where
     9664           ub.price-list-type.plt-db-num   = p-db-num  and
     9665           ub.price-list-type.plt-id       = p-id
     9666           no-error .
     9667    if not available ub.price-list-type then  return error .
     9668    if ub.price-list-type.ban-discnt > 0 then do:
     9669    define buffer buf_dis-rule for ub.dis-rule  .
     9670    find first buf_dis-rule no-lock where
     9671               buf_dis-rule.templ-rl-root = ub.price-list-type.ban-discnt and
     9672               buf_dis-rule.charkey_one   = substitute("&1-&2", ub.price-list-type.plt-id, ub.price-list-type.plt-db-num)
     9673               no-error .
     9674        if available buf_dis-rule then do:
     9675           message  substitute
     9676             ( "Удалить этот тип нельзя, так как есть ссылка на ПРАВИЛО СКИДОК &1 &2" ,
     9677                ub.price-list-type.ban-discnt  ,
     9678                buf_dis-rule.des
     9679               ) view-as alert-box error .
     9680           return .
     9681        end.
     9682    end.
     9683    find first ub.price-doc-forming no-lock where
     9684               ub.price-doc-forming.plt-id = ub.price-list-type.plt-id and
     9685               ub.price-doc-forming.plt-db-num = ub.price-list-type.plt-db-num and
     9686               ub.price-doc-forming.stts = integer('0':U) no-error .
     9687    if available ub.price-doc-forming then do:
     9688           message "Удалить этот тип нельзя, так как есть незакрытые ДНЦ " ub.price-doc-forming.pdf-id "БД:" ub.price-doc-forming.pdf-db
     9689           view-as alert-box error .
     9690           return .
     9691    end.
     9692         assign
     9693           ub.price-list-type.db-num-chg    = p-db-num-usr
     9694           ub.price-list-type.stts          = integer('1':U)
     9695           ub.price-list-type.sys-date      = today
     9696           ub.price-list-type.sys-time      = time
     9697           ub.price-list-type.sys-time-chr  = string ( ub.price-list-type.sys-time,"hh:mm" )
     9698           ub.price-list-type.who           = p-userid
     9699         .
     9700         for each child_price-list-type exclusive-lock where
     9701                  child_price-list-type.plt-main-db-num = p-db-num  and
     9702                  child_price-list-type.plt-main-id     = p-id
     9703                  :
     9704               assign
     9705                 child_price-list-type.db-num-chg    = p-db-num-usr
     9706                 child_price-list-type.stts          = integer('1':U)
     9707                 child_price-list-type.sys-date      = today
     9708                 child_price-list-type.sys-time      = time
     9709                 child_price-list-type.sys-time-chr  = string ( child_price-list-type.sys-time , "hh:mm" )
     9710                 child_price-list-type.who           = p-userid
     9711               .
     9712         end.
     9713     end.
     9714   end procedure.
     9715   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9716   define variable v-waitfram-action01         as character   no-undo .
     9717   define variable v-waitfram-action02         as character   no-undo .
     9718   define variable v-waitfram-action03         as character   no-undo .
     9719   define variable mWaitFramTextBeg            as character   no-undo.
     9720   define variable mWaitFramTextEnd            as character   no-undo.
     9721   define variable mWaitFramView               as logical     no-undo.
     9722   define variable mWaitProcEvent              as logical     no-undo init yes.
     9723   define variable mWaitFramInterval           as integer     no-undo init 1 .
     9724   define variable mWaitFramStop               as logical     no-undo.
     9725   define variable mWaitFramStopUser           as logical     no-undo.
     9726   define variable mWaitFramStopTimeOut        as logical     no-undo.
     9727   define variable mWaitFramStartProc          as datetime-tz no-undo.
     9728   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     9729   define button B-WaitFramStop auto-end-key
     9730        label "Стоп"
     9731        size 10 by 1 tooltip "Остоновить процесс".
     9732   define button B-viewProcInfo
     9733        label "Информация"
     9734        size 15 by 1 tooltip "Информация о процесс".
     9735   define frame waitfram
     9736     v-waitfram-action01 format "x(72)" no-label skip
     9737     v-waitfram-action02 format "x(72)" no-label skip
     9738     v-waitfram-action03 format "x(72)" no-label skip
     9739     B-viewProcInfo
     9740     B-WaitFramStop at row 4 col 30
     9741     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     9742     .
     9743   define new global shared variable mBatchMode as logical no-undo init ?.
     9744   define variable mFramBachModHandle as handle no-undo.
     9745   mFramBachModHandle = frame waitfram:handle.
     9746   define variable mFameOldVis as logical no-undo.
     9747   define variable mVisCUrentVin as logical no-undo.
     9748   if session:batch-mode
     9749   then
     9750      mBatchMode = yes.
     9751   if mBatchMode = ? then do:
     9752     mVisCUrentVin = current-window:visible.
     9753     mFameOldVis = mFramBachModHandle:visible.
     9754     mFramBachModHandle:visible  = yes.
     9755     mBatchMode = mFramBachModHandle:visible ne yes.
     9756     mFramBachModHandle:visible = mFameOldVis.
     9757     current-window:visible = mVisCUrentVin.
     9758   end.
     9759    if  log-manager:logfile-name ne ?
     9760     then DO:
     9761         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     9762         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     9763         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     9764     end.
     9765   on choose of B-WaitFramStop in frame waitfram
     9766   do:
     9767     mWaitFramStop = yes.
     9768     mWaitFramStopUser = yes.
     9769   end.
     9770   function waitfram-check-timeout returns logical():
     9771      define variable vtime as int64 no-undo.
     9772      if mWaitFramStopTimeOut
     9773      then
     9774         return yes.
     9775      vtime = ( now - mWaitFramStartProc ) / 1000 .
     9776      if     mWaitFramTimeOut ne ?
     9777         and mWaitFramTimeOut ne 0
     9778         and mWaitFramTimeOut lt vtime
     9779      then do:
     9780         mWaitFramStopTimeOut = yes.
     9781      end.
     9782      return mWaitFramStopTimeOut.
     9783   end.
     9784   procedure waitfram-hide :
     9785     if not session:batch-mode
     9786     then do
     9787     on error undo, return error return-value
     9788     :
     9789       pause 0 before-hide .
     9790       if not mBatchMode then
     9791         hide frame waitfram .
     9792     if     not mWaitFramView
     9793        and mWaitProcEvent
     9794     then
     9795       process events .
     9796     end.
     9797   end procedure.
     9798   procedure waitfram-show :
     9799     define input  parameter p-message as character no-undo .
     9800     define variable v-left-margin as integer   no-undo .
     9801     if not session:batch-mode
     9802     then do
     9803     on error undo, return error return-value
     9804     :
     9805       if length(p-message) <= 70 then do:
     9806         assign
     9807           v-left-margin = integer((70 - length(p-message)) / 2)
     9808         .
     9809         assign
     9810           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     9811         .
     9812         assign
     9813           v-waitfram-action01 = " "
     9814           v-waitfram-action02 = " "
     9815                                    + fill(" ", v-left-margin)
     9816                                    + p-message
     9817           v-waitfram-action03 = " "
     9818         .
     9819       end.
     9820       else do:
     9821         define variable vRindex1 as integer no-undo.
     9822         define variable vRindex2 as integer no-undo.
     9823         vRindex1 = r-index(p-message," ",70).
     9824         if vRindex1 = 0
     9825         then
     9826            vRindex1 = 70.
     9827         if length(p-message)  <= vRindex1 + 70 then do:
     9828           assign
     9829             v-waitfram-action01 = " "
     9830             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     9831             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     9832           .
     9833         end.
     9834         else do:
     9835           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     9836           if vRindex2 <= vRindex1
     9837           then
     9838              vRindex2 = vRindex1 + 70.
     9839           assign
     9840             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     9841             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     9842             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     9843           .
     9844         end.
     9845       end.
     9846       B-viewProcInfo:visible   in frame waitfram = no.
     9847       B-viewProcInfo:sensitive in frame waitfram = no.
     9848       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     9849       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     9850       if  (   mWaitFramView
     9851          or  mWaitProcEvent)
     9852          and not mBatchMode
     9853       then
     9854          display
     9855             v-waitfram-action01 skip
     9856             v-waitfram-action02 skip
     9857             v-waitfram-action03 skip
     9858          with frame waitfram .
     9859       if     mWaitFramView
     9860          then do:
     9861             if     mWaitFramInterval ne ?
     9862                and not mBatchMode
     9863             then
     9864                wait-for go of frame waitfram pause mWaitFramInterval.
     9865          end.
     9866          else
     9867             if     mWaitProcEvent
     9868                and not mBatchMode
     9869             then
     9870                process events .
     9871     end.
     9872   end procedure.
     9873      procedure waitfram-show-this:
     9874         define input  parameter iInterval as int64 no-undo.
     9875         define variable vtime as int64 no-undo.
     9876         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     9877         mWaitFramInterval = iInterval.
     9878         run waitfram-show (substitute("&1&2 &3&4" ,
     9879                                       mWaitFramTextBeg ,
     9880                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     9881                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     9882                                       mWaitFramTextEnd
     9883                                      )
     9884                           ).
     9885      end.
     9886      procedure WaitFramRunPause:
     9887         define input  parameter iInterval as dec no-undo.
     9888         define variable vStart  as datetime-tz no-undo.
     9889         define variable vend    as datetime-tz no-undo.
     9890         define variable vint as int64 no-undo.
     9891         define variable vOk as logical no-undo.
     9892         vStart = now.
     9893         vend   = vStart.
     9894         publish "WaitFramPause" (iInterval,output vOk).
     9895         vend   =  now.
     9896         vint = vend - vStart.
     9897         vint = iInterval - vint / 1000.
     9898         if     not mWaitFramStop
     9899            and (   vint > 0
     9900                 or (    not vOk
     9901                     and iInterval eq ?
     9902                     )
     9903                 )
     9904         then
     9905            run waitfram-show-this (iInterval).
     9906         vend   =  now.
     9907         vint = vend - vStart.
     9908         vint = iInterval - vint / 1000.
     9909         if     not mWaitFramStop
     9910            and vint > 0
     9911         then do:
     9912            run gbl/pause.p (vint * 1000).
     9913         end.
     9914         if iInterval ne ?
     9915         then
     9916            publish "WaitFramStop".
     9917         waitfram-check-timeout().
     9918      end.
     9919      procedure WaitFramWaitFor:
     9920         define input  parameter iInterval as dec no-undo.
     9921         assign
     9922            mWaitFramStartProc   = now
     9923            mWaitFramStopUser    = no
     9924            mWaitFramStopTimeOut = no
     9925         .
     9926         block-wait:
     9927         do while not mWaitFramStop:
     9928            run WaitFramRunPause (iInterval).
     9929            if  waitfram-check-timeout()
     9930            then do:
     9931               leave block-wait.
     9932            end.
     9933         end.
     9934         run waitfram-hide.
     9935      end.
     9936   procedure waitfram-join :
     9937     define input  parameter p-line-1  as character no-undo .
     9938     define input  parameter p-line-2  as character no-undo .
     9939     define input  parameter p-line-3  as character no-undo .
     9940     define output parameter p-message as character no-undo .
     9941     do
     9942     on error undo, return error return-value
     9943     :
     9944       assign
     9945         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     9946                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     9947                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     9948       .
     9949     end.
     9950   end procedure.
     9951   function waitfram-join-function returns character
     9952     (input p-line-1 as character
     9953     ,input p-line-2 as character
     9954     ,input p-line-3 as character
     9955     ).
     9956     define variable v-message as character no-undo .
     9957     run waitfram-join in this-procedure
     9958       (input  p-line-1
     9959       ,input  p-line-2
     9960       ,input  p-line-3
     9961       ,output v-message
     9962       ) .
     9963     return v-message .
     9964   end function .
     9965   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
     9966   procedure who-cli-ora :
     9967   define input  parameter p-cli-code-ora as integer   no-undo .
     9968   define output parameter p-cli-type as character no-undo .
     9969   define output parameter p-cli-code as integer   no-undo .
     9970     do
     9971     on error undo, return error return-value
     9972     :
     9973     if length (string(p-cli-code-ora))  <> 9 then do:
     9974        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
     9975     end.
     9976     if string(p-cli-code-ora) begins "1" or
     9977        string(p-cli-code-ora) begins "2" or
     9978        string(p-cli-code-ora) begins "4" then do:
     9979         p-cli-type = 'орг':U .
     9980         p-cli-code = p-cli-code-ora  .
     9981     end.
     9982     else do:
     9983       if string(p-cli-code-ora) begins "3" then do:
     9984         p-cli-type = 'чел':U .
     9985         p-cli-code = p-cli-code-ora  .
     9986       end.
     9987       else do:
     9988          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
     9989       end.
     9990     end.
     9991     define buffer buf_clients for ub.clients  .
     9992     find first buf_clients no-lock where
     9993                buf_clients.obj-type = p-cli-type and
     9994                buf_clients.obj-code = p-cli-code
     9995                no-error .
     9996         if error-status :error then do:
     9997             return error substitute
     9998             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
     9999                 p-cli-code-ora ,
    10000                 p-cli-type ,
    10001                 p-cli-code ) .
    10002         end.
    10003         if ora-icli_ver-stts-client then do:
    10004             if buf_clients.stts > 0 then do:
    10005                 return error substitute
    10006                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
    10007                     p-cli-code-ora ,
    10008                     p-cli-type ,
    10009                     p-cli-code ) .
    10010             end.
    10011         end.
    10012     end.
    10013   end procedure.
    10014   procedure ora-ver-goods :
    10015   define input  parameter p-gds-code as integer   no-undo .
    10016   define buffer buf_goods for ub.goods  .
    10017   define variable my-message as character no-undo .
    10018     do
    10019     on error undo, return error return-value
    10020     :
    10021           find first buf_goods no-lock where
    10022                      buf_goods.gds-code = p-gds-code no-error .
    10023               if error-status :error then do:
    10024                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
    10025                   undo, return error my-message.
    10026               end.
    10027             if buf_goods.stts > 0 then do:
    10028               assign
    10029                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
    10030                 undo, return error my-message.
    10031             end.
    10032     end.
    10033   end procedure.
    10034   define variable v-end-message as character no-undo .
