     1289   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     1290     (input  ?
     1291     ,input  p-obj-type
     1292     ,input  p-obj-code
     1293     ,input  yes
     1294     ,output p-plt-id
     1295     ,output p-plt-db-num
     1296     )  .
     1297      create ub.price-doc-forming.
     1298      assign
     1299         ub.price-doc-forming.plt-id       = p-plt-id
     1300         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1301         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1302         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1303         ub.price-doc-forming.base-rate    = v-base-rate
     1304         ub.price-doc-forming.base-scale   = v-base-scale
     1305         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
