     9022   define variable v-sec as integer   no-undo .
     9023   PROCEDURE obji-add :
     9024   define input  parameter p-db-num       as integer   no-undo .
     9025   define input  parameter p-id           as integer   no-undo .
     9026   define input  parameter p-dgo-db-num   as integer   no-undo .
     9027   define input  parameter p-stts         as integer   no-undo .
     9028   define input  parameter p-db-num-usr   as integer   no-undo .
     9029   define input  parameter p-userid       as character no-undo .
     9030   define output parameter p-recid as recid no-undo .
     9031     do
     9032     on error undo, return error return-value
     9033     :
     9034   find first ub.grp-obj-price exclusive-lock where
     9035           ub.grp-obj-price.gop-db-num   = p-db-num  and
     9036           ub.grp-obj-price.gop-id       = p-id
     9037           no-error .
     9038     if error-status :error then do:
     9039         message
     9040           vss-workfile vss-revision vss-description skip
     9041           error-status :get-message(1) skip
     9042           return-value skip
     9043           ""
     9044           view-as alert-box error
     9045         .
     9046         return error .
     9047     end.
     9048   find first ub.db-grp-obj-price exclusive-lock where
     9049           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
     9050           ub.db-grp-obj-price.gop-id       = p-id      and
     9051           ub.db-grp-obj-price.dgo-db-num   = p-dgo-db-num
     9052           no-error .
     9053         if not available ub.db-grp-obj-price then do:
     9054             create ub.db-grp-obj-price.
     9055               assign
     9056                   ub.db-grp-obj-price.gop-db-num = p-db-num
     9057                   ub.db-grp-obj-price.gop-id     = p-id
     9058                   ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
     9059               .
     9060         end.
     9061         assign
     9062           ub.db-grp-obj-price.num-chg    = p-db-num-usr
     9063           ub.db-grp-obj-price.stts          = p-stts
     9064           ub.db-grp-obj-price.sys-date      = today
     9065           ub.db-grp-obj-price.sys-time      = time
     9066           ub.db-grp-obj-price.sys-time-chr  = string ( ub.db-grp-obj-price.sys-time,"hh:mm" )
     9067           ub.db-grp-obj-price.who           = p-userid
     9068           p-recid = recid ( ub.db-grp-obj-price )
     9069         .
     9070         ub.grp-obj-price.sys-time = time .
     9071         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
     9072     end.
     9073   end procedure.
     9074   PROCEDURE obji-del :
     9075   define input  parameter p-db-num       as integer   no-undo .
     9076   define input  parameter p-id           as integer   no-undo .
     9077   define input  parameter p-dgo-db-num   as integer   no-undo .
     9078   define input  parameter p-db-num-usr   as integer   no-undo .
     9079   define input  parameter p-userid       as character no-undo .
     9080     do
     9081     on error undo, return error return-value
     9082     :
     9083   find first ub.grp-obj-price exclusive-lock where
     9084           ub.grp-obj-price.gop-db-num   = p-db-num  and
     9085           ub.grp-obj-price.gop-id       = p-id
     9086           .
     9087   find first ub.db-grp-obj-price exclusive-lock where
     9088           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
     9089           ub.db-grp-obj-price.gop-id       = p-id      and
     9090           ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
     9091           no-error .
     9092    if not available ub.db-grp-obj-price then  return error .
     9093         assign
     9094           ub.db-grp-obj-price.num-chg    = p-db-num-usr
     9095           ub.db-grp-obj-price.stts          = 1
     9096           ub.db-grp-obj-price.sys-date      = today
     9097           ub.db-grp-obj-price.sys-time      = time
     9098           ub.db-grp-obj-price.sys-time-chr  = string(ub.db-grp-obj-price.sys-time,"hh:mm")
     9099           ub.db-grp-obj-price.who           = p-userid
     9100         .
     9101         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
     9102         ub.grp-obj-price.sys-time = time .
     9103     end.
     9104   end procedure.
     9105   PROCEDURE objf-add :
     9106   define input  parameter p-db-num       as integer   no-undo .
     9107   define input  parameter p-id           as integer   no-undo .
     9108   define input  parameter p-host-code    as integer   no-undo .
     9109   define input  parameter p-stts         as integer   no-undo .
     9110   define input  parameter p-db-num-usr   as integer   no-undo .
     9111   define input  parameter p-userid       as character no-undo .
     9112   define output parameter p-recid as recid no-undo .
     9113     do
     9114     on error undo, return error return-value
     9115     :
     9116   find first ub.sysconf no-lock where recid(ub.sysconf) = p-host-code .
     9117   if available ub.sysconf then do:
     9118      p-host-code = ub.sysconf.host-code .
     9119   end.
     9120   find first ub.grp-obj-price exclusive-lock where
     9121           ub.grp-obj-price.gop-db-num   = p-db-num  and
     9122           ub.grp-obj-price.gop-id       = p-id
     9123           .
     9124   find first ub.host-grp-obj-price exclusive-lock where
     9125           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
     9126           ub.host-grp-obj-price.gop-id       = p-id      and
     9127           ub.host-grp-obj-price.host-code    = p-host-code
     9128           no-error .
     9129         if not available ub.host-grp-obj-price then do:
     9130             create ub.host-grp-obj-price.
     9131               assign
     9132                   ub.host-grp-obj-price.gop-db-num   = p-db-num
     9133                   ub.host-grp-obj-price.gop-id       = p-id
     9134                   ub.host-grp-obj-price.host-code    = p-host-code
     9135               .
     9136         end.
     9137         assign
     9138           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
     9139           ub.host-grp-obj-price.stts          = p-stts
     9140           ub.host-grp-obj-price.sys-date      = today
     9141           ub.host-grp-obj-price.sys-time      = time
     9142           ub.host-grp-obj-price.sys-time-chr  = string ( ub.host-grp-obj-price.sys-time,"hh:mm" )
     9143           ub.host-grp-obj-price.who           = p-userid
     9144           p-recid = recid ( ub.host-grp-obj-price )
     9145         .
     9146         ub.grp-obj-price.sys-time = time .
     9147         run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
     9148     end.
     9149   end procedure.
