     3734                     cost-base = buf_buf_price-doc-forming-gds.price-sale-base
     3735                   .
     3736               end.
     3737         end.
     3738      end.
     3739      when 'УчетнаяS':U  or
     3740      when 'Учет-рзрвS':U  or
     3741      when 'ПриходнаяS':U
     3742      then do:
