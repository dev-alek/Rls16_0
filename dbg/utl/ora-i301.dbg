     4221   define input  parameter  v-copy-type        as character no-undo .
     4222   define input  parameter  v-copy-code        as integer   no-undo .
     4223   define output parameter  p-new-calc-method  as character no-undo .
     4224   define output parameter  p-price-calc-base  as decimal   no-undo .
     4225   define output parameter  p-price-calc-doc   as decimal   no-undo .
     4226   define output parameter  p-price-calc-rubl  as decimal   no-undo .
     4227   define output parameter  p-price-prev-base  as decimal   no-undo .
     4228   define output parameter  p-price-prev-doc   as decimal   no-undo .
     4229   define output parameter  p-price-prev-rubl  as decimal   no-undo .
     4230   define output parameter  p-price-sale-base  as decimal   no-undo .
     4231   define output parameter  p-price-sale-doc   as decimal   no-undo .
     4232   define output parameter  p-price-sale-rubl  as decimal   no-undo .
     4233   define output parameter  p-road-tax-base    as decimal   no-undo .
     4234   define output parameter  p-road-tax-doc     as decimal   no-undo .
     4235   define output parameter  p-road-tax-rubl    as decimal   no-undo .
     4236   define output parameter  p-excise-base      as decimal   no-undo .
     4237   define output parameter  p-excise-doc       as decimal   no-undo .
     4238   define output parameter  p-excise-rubl      as decimal   no-undo .
     4239   define output parameter  p-vat-pc           as decimal   no-undo .
     4240   define output parameter  p-slt-pc           as decimal   no-undo .
     4241   define output parameter  p-prev-doc-code    as character no-undo .
     4242   define output parameter  p-d-pcnt           as decimal   no-undo .
     4243   define variable cost-base    as decimal   no-undo .
     4244   define variable cost-rubl    as decimal   no-undo .
     4245   define variable cur-rt-base  as decimal   no-undo .
     4246   define variable cur-rt-rubl  as decimal   no-undo .
     4247   define variable local_vat-pc as decimal   no-undo .
     4248   define variable local_slt-pc as decimal   no-undo .
     4249   define variable new_vat-pc   as character no-undo  init "".
     4250   define variable new_slt-pc   as character no-undo  init "".
     4251   define variable new_round    as character no-undo  init "".
     4252   define variable loc_round    as character no-undo  init "".
     4253   define variable v-hostcode   as integer   no-undo .
     4254   define variable v-plt-id       as integer   no-undo .
     4255   define variable v-plt-db-num   as integer   no-undo .
     4256   define variable v-pdf-id       as integer   no-undo .
     4257   define variable v-pdf-db-num   as integer   no-undo .
     4258   define variable v-plt-id2      as integer   no-undo .
     4259   define variable v-plt-db-num2  as integer   no-undo .
     4260   define variable v1-recid       as recid no-undo .
     4261   define variable v1-cur-rt      as decimal   no-undo .
     4262   define variable v1-cur-ex      as decimal   no-undo .
     4263   define variable v1 as integer   no-undo .
     4264   define variable v2 as integer   no-undo .
     4265   define variable v3 as integer   no-undo .
     4266   define variable v4 as integer   no-undo .
     4267   define variable vd as decimal   no-undo .
     4268   define variable v-descript as character no-undo .
     4269   define buffer prev-list                     for ub.price-list  .
     4270   define buffer buf_price-list-type           for ub.price-list-type  .
