     6920   procedure calc-sigma :
     6921    do
     6922    on error undo, return error return-value
     6923    :
     6924   define input parameter l-bcode like ub.price-list.b-code no-undo .
     6925   define input-output parameter new-price as decimal no-undo .
     6926   define input parameter l-host as integer no-undo .
     6927   define input parameter l-code as integer no-undo .
     6928   define input parameter l-type as character no-undo .
     6929   define output parameter p-ret as logical no-undo .
     6930   define variable conf-par     as character no-undo.
     6931   define variable par-type     as character no-undo.
     6932   define variable i-sigma as decimal no-undo .
     6933   define variable cur-pr like ub.price-list.price-sale no-undo.
     6934   define variable cur-rt like ub.price-list.road-tax   no-undo.
     6935   define variable cur-ex like ub.price-list.excise     no-undo.
     6936   define variable cur-dn like ub.price-list.doc-num    no-undo.
     6937   define variable old-price as decimal no-undo .
     6938   p-ret = true  .
     6939   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     6940   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     6942     (input  l-type
     6943     ,input  l-code
     6944     ,input  l-bcode
     6945     ,input  0
     6946     ,input  0
     6947     ,output cur-dn
     6948     ,output cur-pr
     6949     ,output cur-rt
     6950     ,output cur-ex
     6951     )  .
     6952   old-price = cur-pr .
     6953   if old-price =  new-price then do:
     6954      p-ret = true .
     6955      return.
     6956   end.
     6957      i-sigma = decimal(par-pr-sigma) .
     6958      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     6959          p-ret = false .
     6960          new-price = old-price.
     6961          end.
     6962      else p-ret = true .
     6963   end.
     6964    end.
     6965   end procedure.
     6966   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6967   define variable var-pr-r-b as character no-undo .
     6968   define variable v-str2 as character no-undo .
     6969   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6971     (output var-pr-r-b
     6972     )  .
     6973   function f-base-code return integer ( p-b-code as integer ).
     6974     define variable main-b-code as integer   no-undo .
     6975     define buffer buf_bar-code for ub.bar-code  .
     6976     find first buf_bar-code no-lock where
     6977               buf_bar-code.b-code = p-b-code no-error .
     6978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6979     (input  buf_bar-code.gds-code
     6980     ,input  ?
     6981     ,output main-b-code
     6982     )  .
     6983     return (main-b-code).
     6984   end function.
     6985   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     6986     define variable f-cost     as decimal no-undo .
     6987     define variable f-cost-pc  as decimal no-undo .
     6988     define variable v-qnty     as decimal no-undo .
     6989     define variable v-sum      as decimal no-undo .
     6990     define variable fact_price as decimal no-undo .
     6991     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     6992                               ub.goods.prod-type = local-price-list.prod-type and
     6993                               ub.goods.prod-code = local-price-list.prod-code no-lock
     6994                               no-error .
     6995     assign
     6996       v-sum  =  0
     6997       v-qnty =  0
     6998       .
     6999     for each x_obj-group :
     7000         find ub.gds-obj no-lock where
     7001             ub.gds-obj.gds-code = ub.goods.gds-code and
     7002             ub.gds-obj.obj-type = x_obj-group.obj-type and
     7003             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     7004         if  available ub.gds-obj then
     7005           if ub.goods.gds-type = 'т':U then
     7006             assign
     7007               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     7008               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     7009               .
     7010             else  v-sum = ?.
     7011         else v-sum = ?.
     7012     end.
     7013     f-cost = v-sum / v-qnty .
     7014     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7015     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     7016     return (f-cost-pc).
     7017   end function.
     7018   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7019   define variable f-pr     as decimal no-undo .
     7020   define variable f-pr-pc  as decimal no-undo.
     7021   define variable v-qnty as decimal   no-undo .
     7022   define variable v-sum as decimal   no-undo .
     7023   define variable fact_price as decimal   no-undo .
     7024   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7025                          ub.goods.prod-type = local-price-list.prod-type and
     7026                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7027    assign
     7028      v-sum  =  0
     7029      v-qnty =  0
     7030      .
     7031   for each x_obj-group :
     7032   find ub.gds-obj no-lock where
     7033        ub.gds-obj.gds-code = ub.goods.gds-code and
     7034        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7035        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     7036   if  available ub.gds-obj then do:
     7037     if ub.goods.gds-type = 'т':U then
     7038       assign
     7039         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     7040         .
     7041       else f-pr = ?.
     7042   end.
     7043   else f-pr = ?.
     7044   end.
     7045     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7046     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     7047     return (f-pr-pc).
     7048   end function.
     7049   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7050   define variable f-cost   as decimal no-undo .
     7051   find first  x_obj-group.
     7052   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7053                          ub.goods.prod-type = local-price-list.prod-type and
     7054                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7055   find ub.gds-obj no-lock where
     7056        ub.gds-obj.gds-code = ub.goods.gds-code  and
     7057        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7058        ub.gds-obj.obj-code = x_obj-group.obj-code
     7059        no-error.
     7060   if  available ub.gds-obj then
     7061     if ub.goods.gds-type = 'т':U then
     7062       assign
     7063         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     7064         .
     7065       else  f-cost = ?.
     7066   else f-cost = ?.
     7067     return ( f-cost ).
     7068   end function.
     7069   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7070   define variable f-pr   as decimal no-undo .
     7071   find first x_obj-group .
     7072   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7073                          ub.goods.prod-type = local-price-list.prod-type and
     7074                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7075   find ub.gds-obj no-lock where
     7076        ub.gds-obj.gds-code = ub.goods.gds-code and
     7077        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7078        ub.gds-obj.obj-code = x_obj-group.obj-code
     7079        no-error.
     7080   if  available ub.gds-obj then
     7081     if ub.goods.gds-type = 'т':U then
     7082       assign
     7083         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     7084         .
     7085       else  f-pr = ?.
     7086   else f-pr = ?.
     7087      return ( f-pr ).
     7088   end function.
     7089   procedure make-fact-order-lib3 :
     7090   define input  parameter p-recid as recid no-undo .
     7091   define output parameter p-fact-order-sys-from as decimal   no-undo .
     7092   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     7093   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7094   define buffer buf_price-list-type for ub.price-list-type  .
     7095   define variable v-shift-end-fact-order as decimal no-undo .
     7096   define variable v-day-end-fact-order   as decimal no-undo .
     7097   define variable v-fact-order           as decimal no-undo .
     7098     do
     7099     on error undo, return error return-value
     7100     :
     7101   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7102     if error-status :error then return error error-status :get-message(1) .
     7103   find first buf_price-list-type  no-lock where
     7104              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7105              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7106     if error-status :error then return error error-status :get-message(1) .
     7107    if buf_price-doc-forming.have-start-period = 1 then do:
     7108       case buf_price-list-type.work-date :
     7109         when int('1':U)  then
     7110           do :
     7111              run day-begin-fact-order
     7112                   ( buf_price-doc-forming.start-date ,
     7113                    output p-fact-order-sys-from ) no-error .
     7114                    if error-status :error then
     7115                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     7116                                               error-status :get-message(1) ,
     7117                                               return-value ).
     7118           end.
     7119         when int('2':U)   then
     7120           do :
     7121             run factord (
     7122                input   buf_price-doc-forming.start-shift-date
     7123               ,input   buf_price-doc-forming.sys-time
     7124               ,input   1
     7125               ,input   buf_price-doc-forming.start-shift-date
     7126               ,input   buf_price-doc-forming.start-shift-num
     7127               ,input   true
     7128               ,output  p-fact-order-sys-from
     7129               ,output  v-shift-end-fact-order
     7130               ,output  v-day-end-fact-order
     7131               ) no-error  .
     7132               if error-status :error then
     7133                    return error substitute ( "Ошибка из factord &1 &2" ,
     7134                                               error-status :get-message(1) ,
     7135                                               return-value ).
     7136           end.
     7137         when int('3':U)   then
     7138           do :
     7139             run factord (
     7140               input    buf_price-doc-forming.start-sys-date
     7141               ,input   buf_price-doc-forming.start-sys-time
     7142               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     7143               ,input   ?
     7144               ,input   ?
     7145               ,input   false
     7146               ,output  p-fact-order-sys-from
     7147               ,output  v-shift-end-fact-order
     7148               ,output  v-day-end-fact-order
     7149               ) no-error .
     7150               if error-status :error then
     7151                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7152                                               error-status :get-message(1) ,
     7153                                               return-value ).
     7154           end.
     7155       end case.
     7156     end.
     7157    if buf_price-doc-forming.have-end-period = 1 then do:
     7158       case buf_price-list-type.work-date :
     7159         when int('1':U)   then
     7160           do :
     7161              run factord-end-day
     7162                 ( buf_price-doc-forming.end-date ,
     7163                   output p-fact-order-sys-to ) no-error .
     7164                   if error-status :error then
     7165                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     7166                                               error-status :get-message(1) ,
     7167                                               return-value ).
     7168           end.
     7169         when int('2':U)   then
     7170           do :
     7171             run factord (
     7172                input   buf_price-doc-forming.end-shift-date
     7173               ,input   buf_price-doc-forming.sys-time
     7174               ,input   1
     7175               ,input   buf_price-doc-forming.end-shift-date
     7176               ,input   buf_price-doc-forming.end-shift-num
     7177               ,input   true
     7178               ,output  v-fact-order
     7179               ,output  p-fact-order-sys-to
     7180               ,output  v-day-end-fact-order
     7181               ) no-error .
     7182               if error-status :error then
     7183                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     7184                                           error-status :get-message(1) ,
     7185                                           return-value ).
     7186           end.
     7187         when int('3':U)   then
     7188           do :
     7189             run factord (
     7190                input   buf_price-doc-forming.end-sys-date
     7191               ,input   buf_price-doc-forming.end-sys-time
     7192               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     7193               ,input   ?
     7194               ,input   ?
     7195               ,input   false
     7196               ,output  p-fact-order-sys-to
     7197               ,output  v-shift-end-fact-order
     7198               ,output  v-day-end-fact-order
     7199               ) no-error .
     7200               if error-status :error then
     7201                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7202                                           error-status :get-message(1) ,
     7203                                           return-value ).
     7204           end.
     7205       end case.
     7206     end.
     7207     end.
     7208   end procedure.
     7209   procedure ver-dfc-mpl-lib3 :
     7210   define input  parameter p-recid as recid no-undo .
     7211   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7212   define buffer buf_price-list-type for ub.price-list-type  .
     7213   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7214   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     7215   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     7216   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     7217   define variable v-fact-order-sys-from   as decimal   no-undo .
     7218   define variable v-fact-order-sys-to     as decimal   no-undo .
     7219     do
     7220     on error undo, return error return-value
     7221    :
     7222   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7223     if error-status :error then return error error-status :get-message(1) .
     7224   find first buf_price-list-type  no-lock where
     7225              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7226              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7227     if error-status :error then return error error-status :get-message(1) .
     7228     if buf_price-list-type.stts = integer('1':U) then do:
     7229        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     7230     end.
     7231     if buf_price-list-type.bgr-id > 0 then do:
     7232         find ub.buyer-group where
     7233               ub.buyer-group.stts       = 0  and
     7234               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     7235               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     7236               no-lock no-error .
     7237         if not available ub.buyer-group then
     7238         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     7239     end.
     7240     if buf_price-list-type.sgr-id > 0 then do:
     7241         find ub.sum-group where
     7242               ub.sum-group.stts       = 0  and
     7243               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     7244               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     7245               no-lock no-error .
     7246         if not available ub.sum-group then
     7247         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     7248     end.
     7249     if buf_price-list-type.qgr-id > 0 then do:
     7250         find ub.qnty-group where
     7251              ub.qnty-group.stts       = 0  and
     7252              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     7253              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     7254              no-lock no-error .
     7255         if not available ub.qnty-group then
     7256         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     7257     end.
     7258     if buf_price-list-type.tog-id > 0 then do:
     7259         find ub.turnover-group where
     7260              ub.turnover-group.stts       = 0  and
     7261              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     7262              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     7263             no-lock no-error .
     7264         if not available ub.turnover-group then
     7265         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     7266     end.
     7267     if buf_price-list-type.gop-id > 0 then do:
     7268         find ub.grp-obj-price where
     7269               ub.grp-obj-price.stts       = 0  and
     7270               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num and
     7271               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id
     7272               no-lock no-error .
     7273         if not available ub.grp-obj-price then
     7274         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id,buf_price-list-type.gop-db-num )  .
     7275     end.
     7276     if buf_price-list-type.gop-id-for-calc-turnover > 0 then do:
     7277         find ub.grp-obj-price where
     7278               ub.grp-obj-price.stts       = 0  and
     7279               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num-for-calc-turnover and
     7280               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id-for-calc-turnover
     7281               no-lock no-error .
     7282         if not available ub.grp-obj-price then
     7283         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id-for-calc-turnover,buf_price-list-type.gop-db-num-for-calc-turnover )  .
     7284     end.
     7285      if buf_price-doc-forming.have-start-period = integer(true) then do:
     7286         case buf_price-list-type.work-date :
     7287             when int('1':U)     then
     7288               do :
     7289                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     7290               end.
     7291             when int('2':U)   then
     7292               do :
     7293                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
     7294                   if buf_price-doc-forming.start-shift-num  = ? or
     7295                      buf_price-doc-forming.start-shift-num = 0  then return error "Не задан порядок смены начала действия цен !" .
     7296               end.
     7297             when int('3':U)     then
     7298               do :
     7299                   if buf_price-doc-forming.start-sys-date = ? then return error "Не задана дата начала действия цен !" .
     7300                   if buf_price-doc-forming.start-sys-time = ? then return error "Не задано время начала действия цен !" .
     7301               end.
     7302         end case.
     7303      end.
     7304      if buf_price-doc-forming.have-end-period = integer(true) then do:
     7305         case buf_price-list-type.work-date :
     7306             when int('1':U)     then
     7307               do :
     7308                  if buf_price-doc-forming.end-date = ? then return error "Не задана дата окончания действия цен !" .
     7309               end.
     7310             when int('2':U)   then
     7311               do :
     7312                   if buf_price-doc-forming.end-shift-date = ? then return error "Не задана сменная дата окончания действия цен !" .
     7313                   if buf_price-doc-forming.end-shift-num  = ? or
     7314                      buf_price-doc-forming.end-shift-num = 0  then return error "Не задан порядок смены окончания  действия цен !" .
     7315               end.
     7316             when int('3':U)     then
     7317               do :
     7318                   if buf_price-doc-forming.end-sys-date = ? then return error "Не задана дата окончания действия цен !" .
     7319                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     7320               end.
     7321         end case.
     7322      end.
     7323      if buf_price-doc-forming.have-start-period = integer(true) and
     7324         buf_price-doc-forming.have-end-period = integer(true) then do:
     7325         case buf_price-list-type.work-date :
     7326             when int('1':U)     then
     7327               do :
     7328                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     7329               end.
     7330             when int('2':U)   then
     7331               do :
     7332                   if buf_price-doc-forming.end-shift-date < buf_price-doc-forming.start-shift-date then return error "Не верно задан интервал дат !" .
     7333                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     7334                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     7335                   end.
     7336               end.
     7337             when int('3':U)     then
     7338               do :
     7339                   if buf_price-doc-forming.end-sys-date < buf_price-doc-forming.start-sys-date then return error "Не верно задан интервал дат !" .
     7340                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     7341                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     7342                   end.
     7343               end.
     7344         end case.
     7345      end.
     7346   if buf_price-doc-forming.name = "" then return error "Не задано название ДНЦ !" .
     7347   if buf_price-list-type.main = false then do:
     7348       run make-fact-order-lib3 in this-procedure
     7349           ( input  p-recid ,
     7350             output v-fact-order-sys-from ,
     7351             output v-fact-order-sys-to   ) .
     7352   end.
     7353   define variable old-price as decimal   no-undo .
     7354   define variable v-kol-rec as integer   no-undo .
     7355   define variable v-gds-null-price as character no-undo initial "" .
     7356   define variable v-type as character no-undo .
     7357   v-kol-rec = 0.
     7358   for each buf_price-doc-forming-gds no-lock where
     7359            buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
     7360            buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
     7361            buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
     7362            buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      :
     7363       find first ub.bar-code no-lock where
     7364                  ub.bar-code.b-code = buf_price-doc-forming-gds.b-code no-error .
     7365                  if error-status :error then return error substitute ("Не найден бар-код &1" ,  buf_price-doc-forming-gds.b-code ) .
     7366       find first ub.goods no-lock where
     7367                  ub.goods.artic = buf_price-doc-forming-gds.artic         and
     7368                  ub.goods.prod-type = buf_price-doc-forming-gds.prod-type and
     7369                  ub.goods.prod-code = buf_price-doc-forming-gds.prod-code no-error .
     7370                  if error-status :error then return error substitute ("Не найден товар &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7371       if ub.bar-code.gds-code <> ub.goods.gds-code then return error substitute ("Бар-код &4 не соответствует товару &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.b-code ) .
     7372       run gds-attr-value in this-procedure (input ub.goods.gds-code
     7373                                            ,input 'null-price':U
     7374                                            ,output v-gds-null-price
     7375                                            ,output v-type ) no-error .
     7376       if buf_price-doc-forming-gds.price-sale-doc   = ? or (buf_price-doc-forming-gds.price-sale-doc   = 0 and not logical(v-gds-null-price) )
     7377                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-doc  ) .
     7378       if buf_price-doc-forming-gds.price-sale-rubl  = ? or (buf_price-doc-forming-gds.price-sale-rubl  = 0 and not logical(v-gds-null-price) )
     7379                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-rubl ) .
     7380       if buf_price-doc-forming-gds.price-sale-base  = ? or (buf_price-doc-forming-gds.price-sale-base  = 0 and not logical(v-gds-null-price) )
     7381                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-base ) .
     7382       if buf_price-doc-forming-gds.slt-pc = ? then return error substitute ("НсП по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7383       if buf_price-doc-forming-gds.vat-pc = ? then return error substitute ("НДС по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7384   old-price = ? .
     7385     for each buf_price-doc-forming-gds-qnty no-lock where
     7386              buf_price-doc-forming-gds-qnty.plt-id = buf_price-doc-forming-gds.plt-id and
