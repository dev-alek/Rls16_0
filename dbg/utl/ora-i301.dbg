     1323   procedure prcreate-new-price-doc-forming-gds :
     1324   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     1325   define input  parameter p-obj-type   as character no-undo .
     1326   define input  parameter p-obj-code   as integer   no-undo .
     1327   define input  parameter par-pr-notls as character no-undo .
     1328   define input  parameter par-pr-altex as character no-undo .
     1329   define input  parameter par-pr-sclex as character no-undo .
     1330   define input  parameter p-line-num    as integer   no-undo .
     1331   define input  parameter p-gds-code    as integer   no-undo .
     1332   define input  parameter p-price-sale  as decimal   no-undo .
     1333   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1334   define buffer buf_goods for ub.goods  .
     1335   define buffer buf_bar-code for ub.bar-code  .
     1336   define buffer main_bar-code for ub.bar-code  .
     1337   define variable main-b-code as integer   no-undo .
     1338   define variable v-sec as integer   no-undo .
     1339     do
     1340     on error undo, return error return-value
     1341     :
     1342   define variable v-cur-dn as character no-undo .
     1343   define variable v-cur-pr as decimal   no-undo .
     1344   define variable v-cur-rt as decimal   no-undo .
     1345   define variable v-cur-ex as decimal   no-undo .
     1346   find first buf_price-doc-forming no-lock where
     1347              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     1348              if error-status :error then return error .
     1349   find first buf_goods no-lock where
     1350              buf_goods.gds-code  = p-gds-code no-error .
     1351              if error-status :error then return error .
     1352   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1353     (input  buf_goods.gds-code
