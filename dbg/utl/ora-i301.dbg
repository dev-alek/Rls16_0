     7460     run ver-pr-equ-qS in this-procedure
     7461       ( input buf_price-doc-forming.plt-id ,
     7462         input buf_price-doc-forming.plt-db-num,
     7463         input buf_price-doc-forming.pdf-id ,
     7464         input buf_price-doc-forming.pdf-db
     7465         ) no-error .
     7466     if error-status :error then  return error  "Ошибка при удалении строки ДНЦ "   .
     7467   if v-kol-rec = 0 then return error "no-records":U.
     7468   end.
     7469   end procedure.
     7470   procedure ver-pr-equ-qS :
     7471   define input parameter  p-plt-id      as integer   no-undo .
     7472   define input parameter  p-plt-db-num  as integer   no-undo .
     7473   define input parameter  p-pdf-id      as integer   no-undo .
     7474   define input parameter  p-pdf-db      as integer   no-undo .
     7475     do
     7476     on error undo, return error return-value
     7477     :
     7478   define variable  l-doc-num2   like ub.price-list.doc-num    no-undo .
     7479   define buffer pdf_price-list  for ub.price-doc-forming-gds .
     7480   define buffer pp_price-list   for ub.price-doc-forming-gds .
     7481   define buffer main_price-list for ub.price-doc-forming-gds .
     7482   define buffer alt_price-list  for ub.price-doc-forming-gds .
     7483   define buffer buf1-bar-code   for ub.bar-code .
     7484   define buffer buf2-bar-code   for ub.bar-code .
     7485   define buffer buf_goods for ub.goods  .
     7486   define buffer buf2_goods for ub.goods  .
     7487   define variable v-num as integer init 0 no-undo .
     7488   define variable bbb   as logical no-undo .
     7489   define variable l-price-sale like ub.price-list.price-sale no-undo .
     7490   define variable l-road-tax   like ub.price-list.road-tax   no-undo .
     7491   define variable l-excise     like ub.price-list.excise     no-undo .
     7492   define variable l-ok          as logical no-undo .
     7493   define variable check-par     as logical no-undo .
     7494   define variable main-b-code   as integer no-undo .
     7495   define variable par-pr-equ-dq as integer no-undo .
     7496   define variable v-price-sale  as decimal no-undo .
     7497   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7498   empty temp-table thbjattr_thbj-attr.
     7499   run adm/shattri.p (
     7500      input "get":U
     7501     ,input v-cntxt-obj-type
     7502     ,input v-cntxt-obj-code
     7503     ,input 'overval':U
     7504     ,input  ""
     7505     ,output v-value-character
     7506     ,output v-value-date
     7507     ,output v-value-decimal
     7508     ,output v-value-integer
     7509     ,output v-value-logical
     7510     ,output par-type
     7511     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     7512     ) no-error .
     7513   for each thbjattr_thbj-attr :
     7514       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     7515   end.
     7516   if par-pr-equ-dq = 1 then return .
     7517   for each pdf_price-list exclusive-lock where
     7518            pdf_price-list.plt-id     = p-plt-id     and
     7519            pdf_price-list.plt-db-num = p-plt-db-num and
     7520            pdf_price-list.pdf-id     = p-pdf-id     and
     7521            pdf_price-list.pdf-db     = p-pdf-db     by pdf_price-list.line-num
     7522           :
     7523       if not (pdf_price-list.b-code     = f-base-code (pdf_price-list.b-code) ) then next .
     7524       check-par = false .
     7525      find first x_obj-group no-error .
     7526   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7527   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7528     (input  x_obj-group.obj-type
     7529     ,input  x_obj-group.obj-code
     7530     ,input  pdf_price-list.b-code
     7531     ,input  0
     7532     ,input  0
     7533     ,output l-doc-num2
     7534     ,output l-price-sale
     7535     ,output l-road-tax
     7536     ,output l-excise
     7537     ) no-error .
     7538       v-price-sale = l-price-sale .
     7539      for each x_obj-group :
     7540   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7542     (input  x_obj-group.obj-type
     7543     ,input  x_obj-group.obj-code
     7544     ,input  pdf_price-list.b-code
     7545     ,input  0
     7546     ,input  0
     7547     ,output l-doc-num2
     7548     ,output l-price-sale
     7549     ,output l-road-tax
     7550     ,output l-excise
     7551     ) no-error .
     7552       if v-price-sale <> l-price-sale  then do :
     7553         v-price-sale = l-price-sale.
     7554         leave .
     7555       end.
     7556      end.
     7557      find first x_obj-group no-error .
     7558   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7560     (input  x_obj-group.obj-type
     7561     ,input  x_obj-group.obj-code
     7562     ,input  pdf_price-list.b-code
     7563     ,input  0
     7564     ,input  0
     7565     ,output l-doc-num2
     7566     ,output l-price-sale
     7567     ,output l-road-tax
     7568     ,output l-excise
     7569     ) no-error .
     7570         if l-doc-num2 <> ? then do :
     7571           if l-price-sale = pdf_price-list.price-sale-doc
     7572           and v-price-sale = pdf_price-list.price-sale-doc
     7573           then do:
     7574                find first buf_goods no-lock where
     7575                           buf_goods.artic     =  pdf_price-list.artic and
     7576                           buf_goods.prod-type =  pdf_price-list.prod-type and
     7577                           buf_goods.prod-code =  pdf_price-list.prod-code no-error .
     7578               check-par = false .
     7579                  for each pp_price-list no-lock where
     7580                           pp_price-list.plt-id     = p-plt-id     and
     7581                           pp_price-list.plt-db-num = p-plt-db-num and
     7582                           pp_price-list.pdf-id     = p-pdf-id     and
     7583                           pp_price-list.pdf-db     = p-pdf-db     and
     7584                           pp_price-list.artic      = pdf_price-list.artic and
     7585                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     7586                           pp_price-list.prod-code  = pdf_price-list.prod-code ,
     7587                        first buf1-bar-code no-lock where
     7588                             buf1-bar-code.b-code   = pp_price-list.b-code and
     7589                             buf1-bar-code.unit-cli <> buf_goods.unit-base
     7590                       :
     7591                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     7592                       check-par = true  .
     7593                       leave.
     7594                   end.
     7595                  for each pp_price-list no-lock where
     7596                           pp_price-list.plt-id     = p-plt-id     and
     7597                           pp_price-list.plt-db-num = p-plt-db-num and
     7598                           pp_price-list.pdf-id     = p-pdf-id     and
     7599                           pp_price-list.pdf-db     = p-pdf-db     and
     7600                           pp_price-list.artic      = pdf_price-list.artic and
     7601                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     7602                           pp_price-list.prod-code  = pdf_price-list.prod-code and
     7603                           pp_price-list.price-sale-doc <> pdf_price-list.price-sale-doc  ,
     7604                        first buf1-bar-code no-lock where
     7605                             buf1-bar-code.b-code   = pp_price-list.b-code and
     7606                             buf1-bar-code.unit-cli = buf_goods.unit-base
     7607                       :
     7608                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     7609                       check-par = true  .
     7610                       leave.
     7611                   end.
     7612               if check-par = true then next.
     7613               if par-pr-equ-dq = 2 then do:
     7614                     if  ( v-num <= 2  and check-par = false ) then
     7615                         run gbl/d-askw.w
     7616                           (input "Удалить строку?"
     7617                           ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     7618                                       + " Объект "  + v-cntxt-obj-type + String(v-cntxt-obj-code)
     7619                                       + " Артикул " + pdf_price-list.artic + " " +  buf_goods.gds-name + chr(10)
     7620                                       + " Бар-код " + string(pdf_price-list.b-code)
     7621                                       + " Цена по предыдущему документу переоценки № " + l-doc-num2 + " = "
     7622                                       + string(pdf_price-list.price-sale-doc) + chr(10)
     7623                                       + " Удалить строку? "
     7624                           ,input "|^"
     7625                           ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     7626                           ,input "Удалить строку|"
     7627                               + "Не удалять строку|"
     7628                               + "Удалять у всех товаров, цена на которые не изменилась|"
     7629                               + "Не удалять у всех товаров, цена на которые не изменилась"
     7630                           ,input 1
     7631                           ,input 2
     7632                           ,output v-num
     7633                           ).
     7634                 end.
     7635                 else do:
     7636                   v-num = 3 .
     7637                 end.
     7638                   if v-num = 1 then do:
     7639                     run del-doc-line ( input recid(pdf_price-list)) no-error  .
     7640                                     if error-status :error then do:
     7641                                             message  vss-workfile vss-revision vss-description skip
     7642                                             "Ошибка при удаление строки ДНЦ"
     7643                                             pdf_price-list.b-code skip
     7644                                             error-status :get-message(1) .
     7645                                             return error.
     7646                                     end.
     7647                   end.
     7648                   if v-num = 3  then do:
     7649                      run del-doc-line ( input recid(pdf_price-list)) no-error  .
     7650                   end.
     7651           end.
     7652          end.
     7653   end.
     7654     for each main_price-list no-lock where
     7655                 main_price-list.plt-id      = p-plt-id and
     7656                 main_price-list.plt-db-num  = p-plt-db-num and
     7657                 main_price-list.pdf-id      = p-pdf-id and
     7658                 main_price-list.pdf-db      = p-pdf-db
     7659                 :
     7660                 if main_price-list.b-code <> f-base-code (main_price-list.b-code) then next.
     7661                   for each pp_price-list no-lock where
     7662                             pp_price-list.plt-id       = main_price-list.plt-id     and
     7663                             pp_price-list.plt-db-num   = main_price-list.plt-db-num and
     7664                             pp_price-list.pdf-id       = main_price-list.pdf-id     and
     7665                             pp_price-list.pdf-db       = main_price-list.pdf-db     and
     7666                             pp_price-list.artic        = main_price-list.artic      and
     7667                             pp_price-list.prod-type    = main_price-list.prod-type  and
     7668                             pp_price-list.prod-code    = main_price-list.prod-code  and
     7669                             pp_price-list.b-code      <> main_price-list.b-code     and
     7670                             pp_price-list.price-sale-doc = main_price-list.price-sale-doc  ,
     7671                       first buf_goods no-lock where
     7672                             buf_goods.artic     =  pp_price-list.artic and
     7673                             buf_goods.prod-type =  pp_price-list.prod-type and
     7674                             buf_goods.prod-code =  pp_price-list.prod-code ,
     7675                       first buf1-bar-code no-lock where
     7676                             buf1-bar-code.b-code   = pp_price-list.b-code and
     7677                             buf1-bar-code.unit-cli = buf_goods.unit-base
     7678                             :
     7679                             bbb = true .
     7680                             for each alt_price-list no-lock where
     7681                                     alt_price-list.plt-id     = pp_price-list.plt-id     and
     7682                                     alt_price-list.plt-db-num = pp_price-list.plt-db-num and
     7683                                     alt_price-list.pdf-id     = pp_price-list.pdf-id     and
     7684                                     alt_price-list.pdf-db     = pp_price-list.pdf-db     and
     7685                                     alt_price-list.artic      = pp_price-list.artic      and
     7686                                     alt_price-list.prod-type  = pp_price-list.prod-type  and
     7687                                     alt_price-list.b-code     <> main_price-list.b-code  and
     7688                                     alt_price-list.b-code     <> pp_price-list.b-code    and
     7689                                     alt_price-list.prod-code  = pp_price-list.prod-code ,
     7690                               first buf2_goods no-lock where
     7691                                     buf2_goods.artic     =  pp_price-list.artic     and
     7692                                     buf2_goods.prod-type =  pp_price-list.prod-type and
     7693                                     buf2_goods.prod-code =  pp_price-list.prod-code ,
     7694                               first buf2-bar-code no-lock where
     7695                                     buf2-bar-code.b-code   = alt_price-list.b-code and
     7696                                     buf2-bar-code.unit-cli <> buf2_goods.unit-base and
     7697                                     buf2-bar-code.node-code = buf1-bar-code.node-code
     7698                                   :
     7699                                   bbb = false.
     7700                                   leave.
     7701                             end.
     7702                             if bbb = true  then do:
     7703                                 run del-doc-line ( input recid (pp_price-list)) no-error  .
     7704                                 if error-status :error then do:
     7705                                     message  vss-workfile vss-revision vss-description skip
     7706                                     " Нельзя удалить " pp_price-list.b-code skip
     7707                                     error-status :get-message(1) .
     7708                                 end.
     7709                             end.
     7710                   end.
     7711     end.
     7712   end.
     7713   end procedure.
