     6364   define input  parameter  p-line-num   as integer   no-undo .
     6365   define input  parameter  p-b-code     as integer   no-undo .
     6366   define input  parameter  p-artic      as character no-undo .
     6367   define input  parameter  p-prod-type  as character no-undo .
     6368   define input  parameter  p-prod-code  as integer   no-undo .
     6369   define input  parameter  p-met    as character no-undo .
     6370   define input  parameter  p-d-pcnt as decimal   no-undo .
     6371   define input  parameter  p-price  as decimal   no-undo .
     6372   define input  parameter  p-out-code as character no-undo .
     6373   define input  parameter  p-stts as integer   no-undo .
     6374   define input-output  parameter v-sec   as integer   no-undo .
     6375   define variable v-price-calc-base  as decimal   no-undo .
     6376   define variable v-price-calc-doc   as decimal   no-undo .
     6377   define variable v-price-calc-rubl  as decimal   no-undo .
     6378   define variable v-price-prev-base  as decimal   no-undo .
     6379   define variable v-price-prev-doc   as decimal   no-undo .
     6380   define variable v-price-prev-rubl  as decimal   no-undo .
     6381   define variable v-price-sale-base  as decimal   no-undo .
     6382   define variable v-price-sale-doc   as decimal   no-undo .
     6383   define variable v-price-sale-rubl  as decimal   no-undo .
     6384   define variable v-road-tax-base    as decimal   no-undo .
     6385   define variable v-road-tax-doc     as decimal   no-undo .
     6386   define variable v-road-tax-rubl    as decimal   no-undo .
     6387   define variable v-excise-base      as decimal   no-undo .
     6388   define variable v-excise-doc       as decimal   no-undo .
     6389   define variable v-excise-rubl      as decimal   no-undo .
     6390   define variable V-base-rate       as decimal   no-undo .
     6391   define variable V-base-scale      as decimal   no-undo .
     6392   define variable V-exch-scale      as decimal   no-undo .
     6393   define variable V-exch-rate       as decimal   no-undo .
     6394   define variable v-curr-abbr as character no-undo .
     6395   define variable p-vat-pc as decimal   no-undo .
     6396   define variable p-slt-pc as decimal   no-undo .
     6397     do
     6398     on error undo, return error return-value
     6399     :
     6400   find first ub.price-list-type  no-lock  where
     6401              ub.price-list-type.plt-db-num = p-plt-db-num  and
     6402              ub.price-list-type.plt-id     = p-plt-id
     6403              no-error .
     6404   if error-status :error then message
     6405     vss-workfile vss-revision vss-description skip
     6406     error-status :get-message(1) skip
     6407     return-value skip
     6408     "Ошибка!"
     6409     view-as alert-box error
     6410   .
     6411   find first ub.price-doc-forming no-lock  where
     6412              ub.price-doc-forming.plt-db-num = p-plt-db-num and
     6413              ub.price-doc-forming.plt-id     = p-plt-id     and
