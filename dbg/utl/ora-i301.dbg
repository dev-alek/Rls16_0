        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp-price-doc no-undo
        4   field line-num as integer
        5   field doc-date as date
        6   field doc-num  as integer
        7   field doc-num-ES as character
        8   field doc-id   as character
        9   field obj-type as character
       10   field obj-code as integer
       11   field cmnt     as character
       12   index pi line-num doc-num
       13   index pi2 doc-num
       14   index pi3 doc-id
       15   .
       16   define temp-table temp-price-list no-undo
       17   field line-num     as integer
       18   field doc-num      as integer
       19   field bar-code     as integer
       20   field gds-code     as integer
       21   field price-sale   as decimal
       22   index pi  doc-num  line-num  bar-code
       23   index pi2 bar-code
       24   .
       25   define input  parameter parparentproc as widget-handle no-undo .
       26   define input  parameter p-log-handle  as handle no-undo .
       27   define input  PARAMETER TABLE FOR  temp-price-doc.
       28   define input  PARAMETER TABLE FOR  temp-price-list.
       29   define output parameter p-ok-doc as integer   no-undo .
       30   define variable vss-revision    as character no-undo init "$Revision: ae105fa20a43, 3653, test $":U .
       31   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
       32   define variable vss-date        as character no-undo init "$Date: 2024/01/25 16:33:07 $":U .
       33   define variable vss-workfile    as character no-undo init "$Workfile: ora-i301.p $":U .
       34   define variable vss-archive     as character no-undo init "$Archive: utl/ora-i301.p $":U .
       35   define variable vss-description as character no-undo init "Импорт ДНЦ из временной таблицы".
       36   procedure vss-get-info :
       37     define output parameter p-vss-revision    like vss-revision    no-undo .
       38     define output parameter p-vss-author      like vss-author      no-undo .
       39     define output parameter p-vss-date        like vss-date        no-undo .
       40     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       41     define output parameter p-vss-archive     like vss-archive     no-undo .
       42     define output parameter p-vss-description like vss-description no-undo .
       43     assign
       44       p-vss-revision    = vss-revision
       45       p-vss-author      = vss-author
       46       p-vss-date        = vss-date
       47       p-vss-workfile    = vss-workfile
       48       p-vss-archive     = vss-archive
       49       p-vss-description = vss-description
       50     .
       51   end procedure.
       52   procedure vss-get-parameters :
       53     define output parameter p-vss-parameters as character no-undo .
       54   end procedure.
       55   define new global shared variable g#vssrevis-logger as handle    no-undo .
       56   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       57   define variable v-vssrevis-logger                   as handle    no-undo .
       58   procedure vss-logevent :
       59     define input  parameter p-extra-paramters as character no-undo .
       60     define variable v-vssrevis-parameters as character no-undo .
       61     do
       62     on error undo, return error return-value
       63     :
       64       if  valid-handle(v-vssrevis-logger)
       65       and v-vssrevis-logger :get-signature("logevent") <> ""
       66       then do:
       67         run vss-get-parameters in this-procedure
       68           (output v-vssrevis-parameters
       69           ).
       70         run logevent in v-vssrevis-logger
       71           (input vss-workfile
       72           ,input vss-revision
       73           ,input v-vssrevis-parameters
       74           ,input p-extra-paramters
       75           ).
       76       end.
       77     end.
       78   end procedure.
       79   assign
       80     v-vssrevis-logger = g#vssrevis-logger
       81   .
       82   if  valid-handle(v-vssrevis-logger)
       83   and v-vssrevis-logger :get-signature("logevent") <> ""
       84   then do:
       85     assign
       86       v-vssrevis-logevent = true
       87     .
       88     run vss-logevent in this-procedure (input vss-description) .
       89   end.
       90   define new global shared variable g#language as character no-undo .
       91   if g#language <> '' and g#language <> 'rus':U then do:
       92     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       93   end.
       94   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       97   define variable par-type          as character no-undo.
       98   define variable v-value-character as character no-undo .
       99   define variable v-value-date      as date      no-undo .
      100   define variable v-value-decimal   as decimal   no-undo .
      101   define variable v-value-integer   as integer   no-undo .
      102   define variable v-value-logical   as logical   no-undo .
      103   define new global shared variable g#library  as handle no-undo .
      104   define new global shared variable g#library2 as handle no-undo .
      105   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   define  temp-table temp-host no-undo
      107     field host-code like ub.store.host-code
      108     index xpk host-code
      109   .
      110   define  temp-table temp-obj no-undo
      111     field obj-type  like ub.clients.obj-type
      112     field obj-code  like ub.clients.obj-code
      113     field host-code like ub.store.host-code
      114     field db-num    like ub.clients.db-num
      115     index xpk  obj-type obj-code
      116     index xie1 host-code
      117     index xie2 db-num host-code
      118   .
      119   procedure init-temphost:
      120     define buffer buf_store   for ub.store .
      121     define buffer buf_shop    for ub.shop .
      122     define buffer buf_clients for ub.clients .
      123     define buffer buf_db for ub.db .
      124     define buffer buf_temp-host for temp-host .
      125     define buffer buf_temp-obj for temp-obj .
      126     do
      127     on error undo, return error return-value
      128     :
      129       for each buf_store
      130       on error undo, return error
      131       :
      132         find first buf_clients no-lock
      133           where buf_clients.obj-type = 'скл':U
      134             and buf_clients.obj-code = buf_store.obj-code
      135           no-error .
      136         if not available buf_clients
      137         then do:
      138           message
      139             "Ошибка при поиске клиента" skip
      140             "Клиент" 'скл':U buf_store.obj-code skip
      141             view-as alert-box error .
      142           undo, return error .
      143         end.
      144         if buf_clients.stts <> 0 then next.
      145         find first buf_temp-host
      146           where buf_temp-host.host-code = buf_store.host-code
      147           no-error .
      148         if not available buf_temp-host
      149         then do:
      150           create buf_temp-host .
      151           assign
      152             buf_temp-host.host-code = buf_store.host-code
      153           .
      154         end.
      155         create buf_temp-obj .
      156         assign
      157           buf_temp-obj.obj-type  = 'скл':U
      158           buf_temp-obj.obj-code  = buf_store.obj-code
      159           buf_temp-obj.host-code = buf_store.host-code
      160           buf_temp-obj.db-num    = buf_clients.db-num
      161         .
      162       end.
      163       for each buf_shop
      164       on error undo, return error
      165       :
      166         find first buf_clients no-lock
      167           where buf_clients.obj-type = 'маг':U
      168             and buf_clients.obj-code = buf_shop.obj-code
      169           no-error .
      170         if not available buf_clients then do:
      171           message
      172             "Ошибка при поиске клиента" skip
      173             "Клиент" 'маг':U buf_shop.obj-code skip
      174             view-as alert-box error .
      175           undo, return error .
      176         end.
      177         if buf_clients.stts <> 0 then next.
      178         find first buf_temp-host
      179           where buf_temp-host.host-code = buf_shop.host-code
      180           no-error .
      181         if not available buf_temp-host
      182         then do:
      183           create buf_temp-host .
      184           assign
      185             buf_temp-host.host-code = buf_shop.host-code
      186           .
      187         end.
      188         create buf_temp-obj .
      189         assign
      190           buf_temp-obj.obj-type  = 'маг':U
      191           buf_temp-obj.obj-code  = buf_shop.obj-code
      192           buf_temp-obj.host-code = buf_shop.host-code
      193           buf_temp-obj.db-num    = buf_clients.db-num
      194         .
      195       end.
      196     end.
      197   end.
      198   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   procedure factord :
      200     define input  parameter p-fact-date            as date    no-undo .
      201     define input  parameter p-fact-time            as integer no-undo .
      202     define input  parameter p-fact-num             as integer no-undo .
      203     define input  parameter p-shift-date           as date    no-undo .
      204     define input  parameter p-shift-num            as integer no-undo .
      205     define input  parameter p-shift-on             as logical no-undo .
      206     define output parameter p-fact-order           as decimal no-undo .
      207     define output parameter p-shift-end-fact-order as decimal no-undo .
      208     define output parameter p-day-end-fact-order   as decimal no-undo .
      209     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      210     if p-fact-date = ?
      211     then do:
      212       return error "Не указана фактическая дата" .
      213     end.
      214     define variable v-fact-date-num as integer no-undo .
      215     assign
      216       v-fact-date-num = integer(p-fact-date)
      217     .
      218     if p-fact-num = ?
      219     or p-fact-num = 0
      220     then do:
      221       return error "Не задан p-fact-num " + string(p-fact-num) .
      222     end.
      223     if p-fact-num < 0
      224     then do:
      225       return error "Отрицательный fact-num " + string(p-fact-num) .
      226     end.
      227     if p-fact-num >= 100000000
      228     then do:
      229       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      230     end.
      231     if p-shift-on = true
      232     then do:
      233       if p-shift-date = ?
      234       then do:
      235         return error "Не задана дата смены" .
      236       end.
      237       if p-shift-num = ?
      238       or p-shift-num = 0
      239       then do:
      240         return error "Не задан номер смены" .
      241       end.
      242     end.
      243     else do:
      244       assign
      245         p-shift-date = p-fact-date
      246         p-shift-num  = 24
      247       .
      248     end.
      249     define variable v-shift-offset as integer no-undo .
      250     if p-shift-date = p-fact-date
      251     then do:
      252       assign
      253         v-shift-offset = 1
      254       .
      255     end.
      256     if p-shift-date < p-fact-date
      257     then do:
      258       assign
      259         v-shift-offset = 0
      260       .
      261     end.
      262     if p-shift-date > p-fact-date
      263     then do:
      264       message
      265         vss-workfile vss-revision vss-description skip
      266         "Неправильная дата закрытия смены" skip
      267         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      268         view-as alert-box error .
      269       undo, return error
      270         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      271           ,string(p-fact-date, '99/99/9999':U)
      272           ,string(p-shift-date, '99/99/9999':U)
      273           )
      274       .
      275     end.
      276     if p-shift-num < 1
      277     or p-shift-num > 24
      278     then do:
      279       message
      280         vss-workfile vss-revision vss-description skip
      281         "Неправильный номер смены" skip
      282         "p-shift-num" p-shift-num skip
      283         view-as alert-box error .
      284       undo, return error return-value .
      285     end.
      286     assign
      287       p-fact-order           = v-fact-date-num
      288                              + v-shift-offset * 0.5
      289                              + p-shift-num    * 0.02 - 0.01
      290                              + p-fact-num     * 0.0000000001
      291       p-shift-end-fact-order = v-fact-date-num
      292                              + v-shift-offset * 0.5
      293                              + p-shift-num    * 0.02
      294       p-day-end-fact-order   = v-fact-date-num
      295                              + 0.99
      296     .
      297     if p-fact-order           <= v-fact-date-num
      298     or p-shift-end-fact-order <= v-fact-date-num
      299     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      300     or p-shift-end-fact-order >= p-day-end-fact-order
      301     then do:
      302       message
      303         vss-workfile vss-revision vss-description skip
      304         "Внутренняя ошибка при генерации фактического номера" skip
      305         "p-fact-date"            p-fact-date            skip
      306         "p-fact-time"            p-fact-time            skip
      307         "p-fact-num"             p-fact-num             skip
      308         "p-shift-date"           p-shift-date           skip
      309         "p-shift-num"            p-shift-num            skip
      310         "p-shift-on"             p-shift-on             skip
      311         "p-shift-end-fact-order" p-shift-end-fact-order skip
      312         "p-day-end-fact-order"   p-day-end-fact-order   skip
      313         "v-fact-date-num"        v-fact-date-num        skip
      314         view-as alert-box error .
      315       undo, return error return-value .
      316     end.
      317   end procedure.
      318   procedure day-begin-fact-order :
      319     define input  parameter p-fact-date            as date    no-undo .
      320     define output parameter p-day-begin-fact-order as decimal no-undo .
      321     do
      322     on error undo, return error return-value
      323     :
      324       if p-fact-date = ?
      325       then do:
      326         assign
      327           p-day-begin-fact-order = 0
      328         .
      329       end.
      330       else do:
      331         assign
      332           p-day-begin-fact-order = integer(p-fact-date)
      333         .
      334       end.
      335     end.
      336   end procedure.
      337   procedure factord-max-fact-order :
      338     define output parameter p-max-fact-order as decimal   no-undo .
      339     do
      340     on error undo, return error return-value
      341     :
      342       run day-begin-fact-order in this-procedure
      343         (input  date(1, 1, 5000)
      344         ,output p-max-fact-order
      345         ) .
      346     end.
      347   end procedure.
      348   procedure factord-cut-archive :
      349     define input  parameter p-obj-type             as character no-undo .
      350     define input  parameter p-obj-code             as integer   no-undo .
      351     define input  parameter p-fact-date            as date      no-undo .
      352     define output parameter p-shift-on             as logical   no-undo .
      353     define output parameter p-shift-date           as date      no-undo .
      354     define output parameter p-shift-num            as integer   no-undo .
      355     define output parameter p-day-end-fact-order   as decimal   no-undo .
      356     define output parameter p-shift-end-fact-order as decimal   no-undo .
      357     define variable v-fact-order as decimal   no-undo .
      358     define buffer buf_shift-obj for ub.shift-obj .
      359     do
      360     on error undo, return error return-value
      361     :
      362   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      364     (input  p-obj-type
      365     ,input  p-obj-code
      366     ,input  'shift-on=request'
      367     ,output p-shift-on
      368     ) no-error .
      369       if error-status :error
      370       then do:
      371         message
      372           vss-workfile vss-revision vss-description skip
      373           "Ошибка при определении атрибута объекта" skip
      374           "Объект" p-obj-type p-obj-code skip
      375           error-status :get-message(1) skip
      376           return-value skip
      377           view-as alert-box error .
      378         undo, return error return-value .
      379       end.
      380       if p-shift-on = false
      381       then do:
      382         assign
      383           p-shift-date               = ?
      384           p-shift-num                = 0
      385         .
      386       end.
      387       else do:
      388         find first buf_shift-obj share-lock
      389           where buf_shift-obj.obj-type   = p-obj-type
      390             and buf_shift-obj.obj-code   = p-obj-code
      391             and buf_shift-obj.shift-date > p-fact-date
      392           use-index pi
      393           no-error .
      394         if not available buf_shift-obj
      395         or buf_shift-obj.status_ <> 'зкр':U
      396         then do:
      397           message
      398             vss-workfile vss-revision vss-description skip
      399             "Невозможно вычислить последнюю смену" skip
      400             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      401             "Объект" p-obj-type p-obj-code skip
      402             "Дата" p-fact-date skip
      403             view-as alert-box error .
      404           undo, return error return-value .
      405         end.
      406         find last buf_shift-obj share-lock
      407           where buf_shift-obj.obj-type = p-obj-type
      408             and buf_shift-obj.obj-code = p-obj-code
      409             and buf_shift-obj.shift-date <= p-fact-date
      410           use-index pi
      411           no-error .
      412         if available buf_shift-obj
      413         then do:
      414           if  buf_shift-obj.status_ = 'зкр':U
      415           then do:
      416             assign
      417               p-shift-date = buf_shift-obj.shift-date
      418               p-shift-num  = buf_shift-obj.shift-num
      419             .
      420           end.
      421           else do:
      422             message
      423               vss-workfile vss-revision vss-description skip
      424               "Невозможно вычислить последнюю смену" skip
      425               "Статус смены отличен от статуса" 'зкр':U skip
      426               "Объект" p-obj-type p-obj-code skip
      427               "Дата" p-fact-date skip
      428               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      429               view-as alert-box error .
      430             undo, return error return-value .
      431           end.
      432         end.
      433         else do:
      434           assign
      435             p-shift-date = p-fact-date - 1
      436             p-shift-num  = 1
      437           .
      438         end.
      439       end.
      440       run factord in this-procedure
      441         (input  p-fact-date
      442         ,input  1
      443         ,input  1
      444         ,input  p-shift-date
      445         ,input  p-shift-num
      446         ,input  p-shift-on
      447         ,output v-fact-order
      448         ,output p-shift-end-fact-order
      449         ,output p-day-end-fact-order
      450         ) no-error .
      451       if error-status :error
      452       then do:
      453         message
      454           vss-workfile vss-revision vss-description skip
      455           "Ошибка при вызове процедуры factord"
      456           error-status :get-message(1) skip
      457           return-value skip
      458           view-as alert-box error .
      459         undo, return error return-value .
      460       end.
      461     end.
      462   end procedure.
      463   procedure factord-lock-shift :
      464     define input  parameter p-obj-type  as character no-undo .
      465     define input  parameter p-obj-code  as integer   no-undo .
      466     define input  parameter p-fact-date as date      no-undo .
      467     define parameter buffer buf_shift-obj for ub.shift-obj .
      468     define variable v-shift-on      as logical   no-undo .
      469     define variable v-extra-message as character no-undo .
      470     define variable v-error as character no-undo .
      471     do
      472     on error undo, return error return-value
      473     :
      474   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      476     (input  p-obj-type
      477     ,input  p-obj-code
      478     ,input  'shift-on=request'
      479     ,output v-shift-on
      480     ) no-error .
      481       if error-status :error
      482       then do:
      483         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      484         undo, return error v-error .
      485       end.
      486       if v-shift-on = true
      487       then do:
      488         find first buf_shift-obj share-lock
      489           where buf_shift-obj.obj-type   = p-obj-type
      490             and buf_shift-obj.obj-code   = p-obj-code
      491             and buf_shift-obj.shift-date > p-fact-date
      492           use-index pi
      493           no-error .
      494         if not available buf_shift-obj
      495         or buf_shift-obj.status_ <> 'зкр':U
      496         then do:
      497           find last buf_shift-obj
      498             where buf_shift-obj.obj-type = p-obj-type
      499               and buf_shift-obj.obj-code = p-obj-code
      500               and buf_shift-obj.status_  = 'зкр':U
      501             use-index stts
      502             no-error .
      503           if available buf_shift-obj
      504           then do:
      505             assign
      506               v-extra-message =
      507                     substitute("Дата начала последеней закрытой смены на объекте &1"
      508                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      509                               )
      510             .
      511           end.
      512           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      513           undo, return error v-error .
      514         end.
      515       end.
      516     end.
      517   end procedure.
      518   procedure factord-end-day :
      519     define input  parameter p-fact-date            as date    no-undo .
      520     define output parameter p-day-end-fact-order   as decimal no-undo .
      521     do
      522     on error undo, return error return-value
      523     :
      524       if p-fact-date = ?
      525       then do:
      526         return error "Не указана фактическая дата" .
      527       end.
      528       assign
      529         p-day-end-fact-order = integer(p-fact-date) + 0.99
      530       .
      531     end.
      532   end procedure.
      533   procedure factord-to-date :
      534     define input  parameter p-fact-order as decimal no-undo .
      535     define output parameter p-fact-date  as date    no-undo .
      536     define variable v-ref-date  as date      no-undo .
      537     define variable v-ref-delta as integer   no-undo .
      538     do
      539     on error undo, return error return-value
      540     :
      541       if p-fact-order = ?
      542       or p-fact-order = 0
      543       then do:
      544         return error "Не указан fact-order" .
      545       end.
      546       assign
      547         v-ref-date  = date(1, 1, 2000)
      548       .
      549       assign
      550         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      551       .
      552       assign
      553         p-fact-date = v-ref-date + v-ref-delta
      554       .
      555     end.
      556   end procedure.
      557   procedure factord-to-fact-num :
      558     define input  parameter p-fact-order as decimal no-undo .
      559     define output parameter p-fact-num   as integer no-undo .
      560     define variable v-fact-order-trunc as decimal no-undo .
      561     do
      562     on error undo, return error return-value
      563     :
      564       if p-fact-order = ?
      565       or p-fact-order = 0
      566       then do:
      567         return error "Не указан fact-order" .
      568       end.
      569       assign
      570        v-fact-order-trunc = truncate(p-fact-order, 2)
      571       .
      572       assign
      573         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      574       .
      575     end.
      576   end procedure.
      577   procedure factord-to-shift-num :
      578     define input  parameter p-fact-order as decimal no-undo .
      579     define output parameter p-shift-num   as integer no-undo .
      580     define variable  p-shift-numd  as decimal   no-undo .
      581     define variable v-fact-order-trunc as decimal no-undo .
      582     do
      583     on error undo, return error return-value
      584     :
      585       if p-fact-order = ?
      586       or p-fact-order = 0
      587       then do:
      588         return error "Не указан fact-order" .
      589       end.
      590       assign
      591        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      592       .
      593       if v-fact-order-trunc < 0.5 then do:
      594         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      595       end.
      596       assign
      597         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      598         .
      599        assign
      600         p-shift-num = truncate (p-shift-numd , 0)
      601       .
      602     end.
      603   end procedure.
      604   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   procedure doc-code:
      606   define input  parameter parmode          as   character           no-undo.
      607   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      608   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      609   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      610   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      611   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      612   define variable vardb-remote     as   logical             no-undo.
      613   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      614   define variable v-delimiter as character no-undo .
      615   do
      616   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      617   :
      618   find first buf_sys-ctrl no-lock .
      619   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      620     CASE parmode:
      621       when "main":u then do:
      622         if vardb-remote then do:
      623           assign
      624             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      625         end.
      626         else do:
      627           assign
      628             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      629         end.
      630       end.
      631       when "trio" then do:
      632         assign
      633           pardoc-code = replace (parroot-doc-code, "=", "*").
      634       end.
      635       otherwise do:
      636         assign
      637         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      638         no-error
      639         .
      640         if error-status:error  then do:
      641           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      642                                         ,chr(10)
      643                                         ,parmode
      644                                         ).
      645         end.
      646         if num-entries(parmode) = 1
      647         and parmode <> "chip":U
      648         and parmode <> "chip_s":U
      649         then do:
      650           assign
      651           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      652         end.
      653         else if (lookup("chip":U, parmode) > 0
      654                  or
      655                  lookup("chip_s":U, parmode) > 0) then do:
      656           assign
      657             vartemp-doc-code = parroot-doc-code.
      658           do while true:
      659             if index (vartemp-doc-code , ".") = 0 then
      660               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      661             else
      662               vartemp-doc-code  =
      663               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      664               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      665               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      666             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      667           end.
      668           assign
      669             pardoc-code = vartemp-doc-code.
      670         end.
      671       end.
      672     end CASE.
      673     if pardoc-code = '':U
      674     or (parroot-doc-code <> '':U
      675     and pardoc-code = parroot-doc-code) then do:
      676       undo, return error substitute("Ошибка при генерации номера документа&1"
      677                                     ,chr(10)).
      678     end.
      679   end.
      680   end. // procedure/method
      681   function get-doc-code-int64 returns int64
      682     ( input p-doc-code as character ) :
      683     define variable v-ind              as integer   no-undo .
      684     define variable v-num-entries      as integer   no-undo .
      685     define variable v-doc-code-int64   as int64     no-undo .
      686     define variable v-canonic-doc-code as character no-undo .
      687     assign
      688       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      689       v-canonic-doc-code = p-doc-code
      690     .
      691     do v-ind = 1 to v-num-entries
      692     :
      693       assign
      694         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      695       .
      696     end.
      697     assign
      698       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      699     .
      700     return v-doc-code-int64 .
      701   end. // function/method
      702   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703     define variable v-cntxt-db-num        as integer   no-undo .
      704     define variable v-cntxt-userid        as character no-undo .
      705     define variable v-cntxt-level         as character no-undo .
      706     define variable v-cntxt-host-code-obj as integer   no-undo .
      707     define variable v-cntxt-obj-type      as character no-undo .
      708     define variable v-cntxt-obj-code      as integer   no-undo .
      709     define variable v-cntxt-db-num-obj    as integer   no-undo .
      710     define variable v-cntxt-is-admin      as logical   no-undo .
      711   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712   define temp-table x_obj-group no-undo like ub.clients  .
      713   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      714   procedure metod-gop-obj :
      715     do
      716     on error undo, return error return-value
      717     :
      718   define input  parameter p-cntxt-db-num as integer   no-undo .
      719   define input  parameter p-gop-id       as integer   no-undo .
      720   define input  parameter p-gop-db-num   as integer   no-undo .
      721   define buffer buf1_clients for ub.clients  .
      722   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      723   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      724   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      725   for each  x_obj-group : delete x_obj-group. end.
      726   if p-gop-id = 0 or p-gop-id = ?  then do:
      727      if p-cntxt-db-num = 0  then do:
      728           for each buf1_clients no-lock where
      729                   (buf1_clients.obj-type = 'маг':U  or
      730                    buf1_clients.obj-type = 'скл':U  )
      731                   and
      732                   buf1_clients.db-num >= 0  and
      733                   buf1_clients.stts = 0
      734                   :
      735             create x_obj-group .
      736             assign
      737               x_obj-group.obj-code   = buf1_clients.obj-code
      738               x_obj-group.obj-type   = buf1_clients.obj-type
      739               x_obj-group.obj-name   = buf1_clients.obj-name
      740               x_obj-group.db-num     = buf1_clients.db-num
      741             .
      742           end.
      743      end.
      744      else do:
      745           for each buf1_clients no-lock where
      746                   (buf1_clients.obj-type = 'маг':U  or
      747                    buf1_clients.obj-type = 'скл':U  ) and
      748                    buf1_clients.db-num = p-cntxt-db-num  and
      749                    buf1_clients.stts = 0
      750                   :
      751             create x_obj-group .
      752             assign
      753               x_obj-group.obj-code   = buf1_clients.obj-code
      754               x_obj-group.obj-type   = buf1_clients.obj-type
      755               x_obj-group.obj-name   = buf1_clients.obj-name
      756               x_obj-group.db-num     = buf1_clients.db-num
      757             .
      758           end.
      759      end.
      760   end.
      761   else do:
      762         for each buf_db-grp-obj-price  where
      763                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      764                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      765                 buf_db-grp-obj-price.stts = 0  no-lock :
      766           for each buf1_clients no-lock where
      767                  (buf1_clients.obj-type = 'маг':U  or
      768                   buf1_clients.obj-type = 'скл':U  ) and
      769                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      770                   buf1_clients.stts = 0
      771                   :
      772             create x_obj-group .
      773             assign
      774               x_obj-group.obj-code   = buf1_clients.obj-code
      775               x_obj-group.obj-type   = buf1_clients.obj-type
      776               x_obj-group.obj-name   = buf1_clients.obj-name
      777               x_obj-group.db-num     = buf1_clients.db-num
      778             .
      779           end.
      780         end.
      781       for each buf_host-grp-obj-price where
      782               buf_host-grp-obj-price.gop-id     = p-gop-id and
      783               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      784               buf_host-grp-obj-price.stts = 0
      785               no-lock :
      786         for each buf1_clients no-lock where
      787                (buf1_clients.obj-type = 'маг':U  or
      788                 buf1_clients.obj-type = 'скл':U  ) and
      789                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      790                 buf1_clients.stts = 0
      791                 :
      792             find first x_obj-group no-lock  where
      793                       x_obj-group.obj-code   = buf1_clients.obj-code and
      794                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      795             if not available  x_obj-group then   create x_obj-group .
      796             assign
      797               x_obj-group.obj-code   = buf1_clients.obj-code
      798               x_obj-group.obj-type   = buf1_clients.obj-type
      799               x_obj-group.obj-name   = buf1_clients.obj-name
      800               x_obj-group.db-num     = buf1_clients.db-num
      801             .
      802         end.
      803       end.
      804       for each buf_obj-grp-obj-price where
      805               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      806               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      807               buf_obj-grp-obj-price.stts = 0
      808               no-lock :
      809         for each buf1_clients no-lock where
      810                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      811                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      812                   buf1_clients.stts     = 0
      813                   :
      814             find first  x_obj-group no-lock  where
      815                         x_obj-group.obj-code   = buf1_clients.obj-code and
      816                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      817             if not available  x_obj-group then   create x_obj-group .
      818             assign
      819               x_obj-group.obj-code   = buf1_clients.obj-code
      820               x_obj-group.obj-type   = buf1_clients.obj-type
      821               x_obj-group.obj-name   = buf1_clients.obj-name
      822               x_obj-group.db-num     = buf1_clients.db-num
      823             .
      824         end.
      825       end.
      826   end.
      827   end.
      828   end procedure.
      829   procedure metod-obj-in-gop :
      830   define input  parameter p-curr-db-num as integer   no-undo .
      831   define input  parameter p-obj-type as character no-undo .
      832   define input  parameter p-obj-code as integer   no-undo .
      833   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      834     do
      835     on error undo, return error return-value
      836     :
      837       empty temp-table x_grp-obj-price.
      838       for each buf_grp-obj-price where
      839                buf_grp-obj-price.stts = 0
      840                no-lock :
      841                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      842                  for each x_obj-group where
      843                           x_obj-group.obj-type = p-obj-type and
      844                           x_obj-group.obj-code = p-obj-code :
      845                       create  x_grp-obj-price.
      846                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      847                  end.
      848       end.
      849     end.
      850   end procedure.
      851   procedure metod-delobj-usr :
      852   define input  parameter p-pdf-id  as integer   no-undo .
      853   define input  parameter p-pdf-db  as integer   no-undo .
      854   define input  parameter p-plt-id  as integer   no-undo .
      855   define input  parameter p-plt-db-num as integer   no-undo .
      856   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      857     do
      858     on error undo, return error return-value
      859     :
      860   for each buf_price-doc-forming-attr no-lock  where
      861            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      862            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      863            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      864            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      865            buf_price-doc-forming-attr.attr-code begins "obj" :
      866      for each x_obj-group  where
      867               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      868               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      869        delete x_obj-group.
      870      end.
      871   end.
      872     if not can-find (first x_obj-group) then do:
      873        return "nullobj" .
      874     end.
      875   end.
      876   end procedure.
      877   procedure metod-obj-pdf :
      878   define input  parameter p-cntxt-db-num as integer   no-undo .
      879   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      880   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      881   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      882   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      883   define buffer buf_price-list-type for ub.price-list-type  .
      884   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      885     do
      886     on error undo, return error return-value
      887     :
      888    for each  x_obj-group : delete x_obj-group. end.
      889    find first buf_price-list-type no-lock where
      890               buf_price-list-type.plt-id = p-plt-id and
      891               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      892   if error-status :error then return error return-value .
      893    find first buf_price-doc-forming no-lock where
      894               buf_price-doc-forming.plt-id     = p-plt-id and
      895               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      896               buf_price-doc-forming.pdf-id     = p-pdf-id and
      897               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      898               no-error .
      899   if error-status :error then return error return-value .
      900     run metod-gop-obj in this-procedure (
      901         p-cntxt-db-num,
      902         buf_price-list-type.gop-id ,
      903         buf_price-list-type.gop-db-num
      904         ) no-error .
      905     run metod-delobj-usr in this-procedure (
      906       buf_price-doc-forming.pdf-id ,
      907       buf_price-doc-forming.pdf-db ,
      908       buf_price-doc-forming.plt-id ,
      909       buf_price-doc-forming.plt-db-num
      910       ) no-error .
      911     end.
      912   end procedure.
      913   function hvrdtax return logical (input parrecid as recid):
      914   define variable varresult as logical no-undo.
      915   run hvrdtax-proc (input parrecid, output varresult).
      916   return varresult.
      917   end function.
      918   procedure hvrdtax-proc:
      919   define input  parameter parrecid  as recid   no-undo.
      920   define output parameter parresult as logical no-undo.
      921   define buffer bf_goods for ub.goods.
      922   define buffer bf_units for ub.units.
      923   define buffer rt_tax   for ub.tax.
      924   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      925   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      926   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      927   if available rt_tax and
      928       can-find(first ub.tax-units No-LOCK WHERE
      929                      ub.tax-units.tax-code = rt_tax.tax-code AND
      930                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      931                                                       else assign parresult = no.
      932   end procedure.
      933   define new global shared variable g#lib-trn  as handle no-undo .
      934   define new global shared variable g#lib-trn2 as handle no-undo .
      935   define new global shared variable g#lib-trn3 as handle no-undo .
      936   define new global shared variable g#lib-trn4 as handle no-undo .
      937   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      938   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
      940                                           local-doc-num as char).
      941   define buffer base-price        for ub.price-list.
      942   define variable local-main-code like ub.bar-code.b-code no-undo.
      943   define variable local-base-code like ub.bar-code.b-code no-undo.
      944     run prc-base-code (input local-bc, output local-base-code).
      945     find base-price no-lock where
      946          base-price.doc-num = local-doc-num and
      947          base-price.b-code  = local-base-code and
      948          base-price.price-type = "" no-error.
      949     if not available base-price then do:
      950       run prc-main-code (input local-bc, output local-main-code).
      951       find  base-price no-lock where
      952             base-price.doc-num = local-doc-num and
      953             base-price.b-code  = local-main-code and
      954             base-price.price-type = "" no-error.
      955     end.
      956     if available base-price then
      957       return (base-price.price-sale).
      958     else
      959       return (?).
      960   END FUNCTION.
      961   procedure prc-main-code:
      962   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      963   define output parameter local-main-code like ub.bar-code.b-code no-undo.
      964   define buffer local-bar-code        for ub.bar-code.
      965   define buffer local-goods           for ub.goods.
      966   define buffer main-code             for ub.bar-code.
      967   define buffer main-prt              for ub.gds-prt.
      968     local-main-code = ?.
      969     find local-bar-code no-lock where
      970          local-bar-code.b-code = local-bc no-error.
      971     if not available local-bar-code then
      972       return.
      973     find local-goods no-lock where
      974          local-goods.gds-code = local-bar-code.gds-code.
      975     find first  main-prt no-lock where
      976                 main-prt.upper-code = local-goods.prt-root.
      977     find  main-code no-lock where
      978           main-code.gds-code  = local-bar-code.gds-code and
      979           main-code.in-code   = "" and
      980           main-code.part-code = "" and
      981           main-code.unit-cli  = local-goods.unit-base and
      982           main-code.node-code = main-prt.node-code.
      983     local-main-code = main-code.b-code.
      984   end procedure.
      985   procedure prc-base-code:
      986   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      987   define output parameter local-base-code like ub.bar-code.b-code no-undo.
      988   define buffer local-bar-code for ub.bar-code.
      989   define buffer local-goods    for ub.goods.
      990   define buffer base-code      for ub.bar-code.
      991     local-base-code = ?.
      992     find local-bar-code no-lock where
      993          local-bar-code.b-code = local-bc no-error.
      994     if not available local-bar-code then
      995       return.
      996     find local-goods no-lock where
      997          local-goods.gds-code = local-bar-code.gds-code.
      998     find base-code no-lock where
      999          base-code.gds-code  = local-bar-code.gds-code and
     1000          base-code.node-code = local-bar-code.node-code and
     1001          base-code.in-code   = local-bar-code.in-code and
     1002          base-code.part-code = local-bar-code.part-code and
     1003          base-code.unit-cli  = local-goods.unit-base.
     1004     local-base-code = base-code.b-code.
     1005   end procedure.
     1006   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1007   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   procedure prcreate-new-price-doc :
     1009   do
     1010   on error undo, return error return-value
     1011   :
     1012   define input  parameter p-curr-db-num  as integer   no-undo .
     1013   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     1014   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     1015   define input  parameter p-plt-id       as integer   no-undo .
     1016   define input  parameter p-plt-db-num   as integer   no-undo .
     1017   define input  parameter p-pdf-id       as integer   no-undo .
     1018   define input  parameter p-pdf-db-num   as integer   no-undo .
     1019   define output parameter p-price-doc-recid  as recid                no-undo.
     1020   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     1021   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     1022   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     1023   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     1024   define buffer buf_price-doc-forming for ub.price-doc-forming.
     1025   define buffer buf_price-doc         for ub.price-doc.
     1026   find first buf_price-doc-forming no-lock where
     1027              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1028              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1029              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1030              buf_price-doc-forming.plt-id     = p-plt-id
     1031              no-error .
     1032   if not available buf_price-doc-forming and p-plt-id = ? then do:
     1033      run create_new_price-doc-forming
     1034           ( input p-obj-type ,
     1035             input p-obj-code ,
     1036             output p-pdf-db-num ,
     1037             output p-pdf-id ,
     1038             output p-plt-db-num ,
     1039             output p-plt-id
     1040             ).
     1041       find first buf_price-doc-forming no-lock where
     1042                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1043                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1044                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1045                 buf_price-doc-forming.plt-id     = p-plt-id
     1046                 no-error .
     1047   end.
     1048       create buf_price-doc .
     1049       run doc-code in this-procedure
     1050       (input  "main",
     1051        input  p-obj-type  ,
     1052        input  p-obj-code  ,
     1053        input  ?,
     1054        output buf_price-doc.doc-num) no-error.
     1055       if error-status:error then do:
     1056         message vss-workfile vss-revision vss-description skip
     1057                error-status :get-message(1)
     1058               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     1059         return error.
     1060       end.
     1061   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1063     (input  p-obj-type
     1064     ,input  p-obj-code
     1065     ,output v-host-code
     1066     )  .
     1067       v-obj-current-date  = today .
     1068       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1069           v-base-rate   =  buf_price-doc-forming.base-rate  .
     1070           v-base-scale  =  buf_price-doc-forming.base-scale .
     1071       end.
     1072       else do:
