     9212         assign
     9213           ub.obj-grp-obj-price.db-num-chg    = p-db-num-usr
     9214           ub.obj-grp-obj-price.stts          = p-stts
     9215           ub.obj-grp-obj-price.sys-date      = today
     9216           ub.obj-grp-obj-price.sys-time      = time
     9217           ub.obj-grp-obj-price.sys-time-chr  = string ( ub.obj-grp-obj-price.sys-time,"hh:mm" )
     9218           ub.obj-grp-obj-price.who           = p-userid
     9219           p-recid = recid ( ub.obj-grp-obj-price )
     9220         .
     9221         ub.grp-obj-price.sys-time = time .
     9222         run ref/h-grpi.p (buffer ub.obj-grp-obj-price , input-output v-sec )  .
     9223     end.
     9224   end procedure.
     9225   PROCEDURE objo-del :
     9226   define input  parameter p-db-num       as integer   no-undo .
     9227   define input  parameter p-id           as integer   no-undo .
     9228   define input  parameter p-obj-type   as character no-undo .
     9229   define input  parameter p-obj-code   as integer   no-undo .
     9230   define input  parameter p-db-num-usr   as integer   no-undo .
     9231   define input  parameter p-userid       as character no-undo .
     9232     do
     9233     on error undo, return error return-value
     9234     :
     9235   find first ub.grp-obj-price exclusive-lock where
     9236           ub.grp-obj-price.gop-db-num   = p-db-num  and
     9237           ub.grp-obj-price.gop-id       = p-id
     9238           .
     9239   find first ub.obj-grp-obj-price exclusive-lock where
     9240           ub.obj-grp-obj-price.gop-db-num   = p-db-num  and
     9241           ub.obj-grp-obj-price.gop-id       = p-id      and
     9242           ub.obj-grp-obj-price.obj-type    = p-obj-type and
     9243           ub.obj-grp-obj-price.obj-code    = p-obj-code
     9244           no-error .
     9245    if not available ub.obj-grp-obj-price then  return error .
     9246         assign
     9247           ub.obj-grp-obj-price.db-num-chg    = p-db-num-usr
     9248           ub.obj-grp-obj-price.stts          = 1
     9249           ub.obj-grp-obj-price.sys-date      = today
     9250           ub.obj-grp-obj-price.sys-time      = time
     9251           ub.obj-grp-obj-price.sys-time-chr  = string(ub.obj-grp-obj-price.sys-time,"hh:mm")
     9252           ub.obj-grp-obj-price.who           = p-userid
     9253         .
     9254        ub.grp-obj-price.sys-time = time .
     9255        run ref/h-grpi.p (buffer ub.obj-grp-obj-price , input-output v-sec )  .
     9256     end.
     9257   end procedure.
     9258   DEFINE TEMP-TABLE TT_cassa NO-UNDO LIKE ub.price-list-type-cassa.
     9259   DEFINE TEMP-TABLE TT_grp   NO-UNDO LIKE ub.price-list-type-gds-grp.
     9260   DEFINE TEMP-TABLE TT_pay-type NO-UNDO LIKE ub.price-list-type-pay-type.
     9261   DEFINE TEMP-TABLE TT_cash-pay NO-UNDO LIKE ub.price-list-type-cash-pay.
     9262   PROCEDURE type-price-list-ADD :
     9263   define input  parameter p-db-num                       as integer   no-undo .
     9264   define input  parameter p-id                           as integer   no-undo .
     9265   define input  parameter p-name                         as character no-undo .
     9266   define input  parameter p-ban-discnt                   like   ub.price-list-type.ban-discnt          no-undo .
     9267   define input  parameter p-calc-round-method            like   ub.price-list-type.calc-round-method    no-undo .
     9268   define input  parameter p-calc-round-base              like   ub.price-list-type.calc-round-base      no-undo .
     9269   define input  parameter p-calc-increase-pc             like   ub.price-list-type.calc-increase-pc     no-undo .
     9270   define input  parameter p-calc-method                  like   ub.price-list-type.calc-method          no-undo .
     9271   define input  parameter p-create-price-doc             like   ub.price-list-type.create-price-doc     no-undo .
     9272   define input  parameter p-fix-cource-crc-base          like   ub.price-list-type.fix-cource-crc-base  no-undo .
     9273   define input  parameter p-fix-cource-crc-doc           like   ub.price-list-type.fix-cource-crc-doc   no-undo .
     9274   define input  parameter p-have-rs-qnty-group           like   ub.price-list-type.have-rs-qnty-group   no-undo .
     9275   define input  parameter p-have-rs-sum-group            like   ub.price-list-type.have-rs-sum-group    no-undo .
     9276   define input  parameter p-main                         like   ub.price-list-type.main                 no-undo .
     9277   define input  parameter p-only-gbd                     like   ub.price-list-type.only-gbd             no-undo .
     9278   define input  parameter p-plt-main-db-num              like   ub.price-list-type.plt-main-db-num      no-undo .
     9279   define input  parameter p-plt-main-id                  like   ub.price-list-type.plt-main-id          no-undo .
     9280   define input  parameter p-priority                     like   ub.price-list-type.priority             no-undo .
     9281   define input  parameter p-rs-buyer                     like   ub.price-list-type.rs-buyer             no-undo .
     9282   define input  parameter p-send-cassa                   like   ub.price-list-type.send-cassa           no-undo .
     9283   define input  parameter p-under-hand-corr              like   ub.price-list-type.under-hand-corr      no-undo .
     9284   define input  parameter p-under-round-method           like   ub.price-list-type.under-round-method         no-undo .
     9285   define input  parameter p-under-perc                   like   ub.price-list-type.under-perc           no-undo .
     9286   define input  parameter p-under-type-list              like   ub.price-list-type.under-type-list      no-undo .
     9287   define input  parameter p-use-cassa                    like   ub.price-list-type.use-cassa            no-undo .
     9288   define input  parameter p-use-gds-group                like   ub.price-list-type.use-gds-group        no-undo .
     9289   define input  parameter p-use-obj                      like   ub.price-list-type.use-obj              no-undo .
     9290   define input  parameter p-work-date                    like   ub.price-list-type.work-date            no-undo .
     9291   define input  parameter p-bgr-db-num                   like   ub.price-list-type.bgr-db-num           no-undo .
     9292   define input  parameter p-bgr-id                       like   ub.price-list-type.bgr-id               no-undo .
     9293   define input  parameter p-curr-code                    like   ub.price-list-type.curr-code            no-undo .
     9294   define input  parameter p-gop-db-num                   like   ub.price-list-type.gop-db-num           no-undo .
     9295   define input  parameter p-gop-db-num-for-calc-turnover like   ub.price-list-type.gop-db-num-for-calc-turnover  no-undo .
     9296   define input  parameter p-gop-id                       like   ub.price-list-type.gop-id                        no-undo .
     9297   define input  parameter p-gop-id-for-calc-turnover     like   ub.price-list-type.gop-id-for-calc-turnover      no-undo .
     9298   define input  parameter p-qgr-db-num                   like   ub.price-list-type.qgr-db-num                    no-undo .
     9299   define input  parameter p-qgr-id                       like   ub.price-list-type.qgr-id                        no-undo .
     9300   define input  parameter p-sgr-db-num                   like   ub.price-list-type.sgr-db-num                    no-undo .
     9301   define input  parameter p-sgr-id                       like   ub.price-list-type.sgr-id                        no-undo .
     9302   define input  parameter p-tog-db-num                   like   ub.price-list-type.tog-db-num                    no-undo .
     9303   define input  parameter p-tog-id                       like   ub.price-list-type.tog-id                        no-undo .
     9304   define input  parameter p-obj-turnover                 like   ub.price-list-type.obj-turnover                  no-undo .
     9305   define input  parameter p-ttg-summa                    like   ub.price-list-type.ttg-summa                     no-undo .
     9306   define input  parameter p-userid                       as character no-undo .
     9307   define input  parameter p-db-num-usr                   as integer   no-undo .
     9308   define input  parameter p-have-rs-turn-group           like   ub.price-list-type.have-rs-turn-group no-undo .
     9309   define input  parameter p-have-tog-db-num              like   ub.price-list-type.have-tog-db-num    no-undo .
     9310   define input  parameter p-have-tog-id                  like   ub.price-list-type.have-tog-id        no-undo .
     9311   define input  parameter p-use-cash-pay                 like   ub.price-list-type.use-cash-pay no-undo .
     9312   define input  parameter p-use-pay-type                 like   ub.price-list-type.use-pay-type no-undo .
     9313   define output parameter p-recid                        as recid no-undo .
     9314   define input  parameter table for tt_cassa .
     9315   define input  parameter table for tt_grp   .
     9316   define input  parameter table for tt_pay-type .
     9317   define input  parameter table for tt_cash-pay .
     9318   define variable v-text as character no-undo .
     9319   define buffer buf_price-list-type for ub.price-list-type  .
     9320     do
     9321     on error undo, return error return-value
     9322     :
     9323   if p-plt-main-id                     = ? then p-plt-main-id = 0 .
     9324   if p-bgr-id                          = ? then p-bgr-id                        = 0 .
     9325   if p-gop-id                          = ? then p-gop-id                        = 0 .
     9326   if p-gop-id-for-calc-turnover        = ? then p-gop-id-for-calc-turnover      = 0 .
     9327   if p-qgr-db-num                      = ? then p-qgr-db-num                    = 0 .
     9328   if p-qgr-id                          = ? then p-qgr-id                        = 0 .
     9329   if p-sgr-db-num                      = ? then p-sgr-db-num                    = 0 .
     9330   if p-sgr-id                          = ? then p-sgr-id                        = 0 .
     9331   if p-tog-db-num                      = ? then p-tog-db-num                    = 0 .
     9332   if p-tog-id                          = ? then p-tog-id                        = 0 .
     9333   if p-gop-db-num                      = ? then p-gop-db-num                    = 0 .
     9334   if p-gop-db-num-for-calc-turnover    = ? then p-gop-db-num-for-calc-turnover  = 0 .
     9335   if p-have-tog-db-num                 = ? then p-have-tog-db-num  = 0 .
     9336   if p-have-tog-id                     = ? then p-have-tog-id      = 0 .
     9337   if p-gop-id = 0  then  p-use-obj = 1 .
     9338   if p-gop-id-for-calc-turnover  = 0  then  p-obj-turnover = false  .
     9339   if p-tog-id = 0   then  p-obj-turnover = false  .
     9340   if p-tog-id = 0 and  p-bgr-id = 0   then  p-rs-buyer = 0.
     9341   if p-name = ? or p-name = ""  then do:
     9342     return error "Название типа прайс-листа не должно быть пустым!" .
     9343   end.
     9344   if logical(p-have-rs-qnty-group) = true and  ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
     9345     return error "Не задана количественная группа!" .
     9346   end.
     9347   if p-have-rs-sum-group = true and  ( p-sgr-id = 0 or p-sgr-id = ? ) then do:
     9348     return error "Не задана суммовая группа!" .
     9349   end.
     9350   if logical(p-under-type-list) = true and  ( p-plt-main-id = 0 or p-plt-main-id = ? ) then do:
     9351     return error "Не задан родительский прайс-лист !" .
     9352   end.
     9353   define buffer parent_price-list-type for ub.price-list-type  .
     9354   if  logical(p-under-type-list) = true and p-main = true  then do:
     9355       find first parent_price-list-type  no-lock where
     9356                  parent_price-list-type.plt-id = p-plt-main-id  and
     9357                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
     9358       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
     9359       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
     9360       if parent_price-list-type.main = false  then  return error "Родительский прайс-лист должен быть ГЛАВНЫМ !" .
     9361       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
     9362   end.
     9363   if  logical(p-under-type-list) = true and p-main = false   then do:
     9364       find first parent_price-list-type  no-lock where
     9365                  parent_price-list-type.plt-id = p-plt-main-id  and
     9366                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
     9367       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
     9368       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
     9369       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
     9370   end.
     9371   if logical(p-have-rs-qnty-group) = false  and not ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
     9372      p-qgr-id = 0.
     9373      p-qgr-db-num = 0.
     9374   end.
     9375   if p-have-rs-sum-group = false  and  not( p-sgr-id = 0 or p-sgr-id = ? ) then do:
     9376     p-sgr-id = 0.
     9377     p-sgr-db-num = 0.
     9378   end.
     9379   if logical(p-have-rs-turn-group) = false  and not ( p-have-tog-id = 0 or p-have-tog-id = ? ) then do:
     9380      p-have-tog-id = 0.
     9381      p-have-tog-db-num = 0.
     9382   end.
     9383   if p-priority  = 0  and p-main = false  and p-under-type-list = 0 then do:
     9384      return error "Не задан ПРИОРИТЕТ типа прайс-листа"   .
     9385   end.
     9386   if p-priority > 0 and p-main = false and p-under-type-list = 0 then do:
     9387       if can-find (
     9388             first buf_price-list-type no-lock where
     9389                   buf_price-list-type.under-type-list = 0          and
     9390                   buf_price-list-type.priority        = p-priority and
     9391                   buf_price-list-type.main            = false      and
     9392                   buf_price-list-type.stts            = integer('0':U)          and
     9393               not
     9394                 ( buf_price-list-type.plt-db-num = p-db-num and
     9395                   buf_price-list-type.plt-id     = p-id )
     9396                 ) then
     9397       return error "Уже есть тип прайс-листа с приоритетом " + string ( p-priority ) .
     9398   end.
     9399   find first ub.price-list-type exclusive-lock where
     9400              ub.price-list-type.plt-db-num   = p-db-num and
     9401              ub.price-list-type.plt-id       = p-id
     9402              no-error .
     9403       if not available ub.price-list-type then do:
     9404         if p-main = true and p-only-gbd = 1 then do:
     9405           if can-find ( first buf_price-list-type no-lock where
     9406                             buf_price-list-type.main = true and
     9407                             buf_price-list-type.only-gbd = 1 and
     9408                             buf_price-list-type.stts = integer('0':U) and
     9409                             buf_price-list-type.gop-id = p-gop-id and
     9410                             buf_price-list-type.gop-db-num = p-gop-db-num ) then  do:
     9411               if p-gop-id = 0 or p-gop-id = ? then do:
     9412                 v-text  = "для всех объектов" .
     9413                 end.
     9414                 else do:
     9415                 v-text  = "для объектов из группы №"  + string(p-gop-id) + " БД:" + string(p-gop-db-num).
     9416                 end.
     9417               release ub.price-list-type no-error .
     9418               return error "Уже существует ГЛАВНЫЙ ПРАЙС-ЛИСТ для автопереоценок " + v-text .
     9419               end.
     9420         end.
     9421         create ub.price-list-type .
     9422         assign
     9423             ub.price-list-type.plt-db-num   = p-db-num
     9424             ub.price-list-type.plt-id       = p-id
     9425         .
     9426       end.
     9427          assign
     9428             ub.price-list-type.plt-db-num                     = p-db-num
     9429             ub.price-list-type.plt-id                         = p-id
     9430             ub.price-list-type.name                           = p-name
     9431             ub.price-list-type.ban-discnt                     = p-ban-discnt
     9432             ub.price-list-type.calc-round-method              = p-calc-round-method
     9433             ub.price-list-type.calc-round-base                = p-calc-round-base
     9434             ub.price-list-type.calc-increase-pc               = p-calc-increase-pc
     9435             ub.price-list-type.calc-method                    = p-calc-method
     9436             ub.price-list-type.create-price-doc               = p-create-price-doc
     9437             ub.price-list-type.fix-cource-crc-base            = p-fix-cource-crc-base
     9438             ub.price-list-type.fix-cource-crc-doc             = p-fix-cource-crc-doc
     9439             ub.price-list-type.have-rs-qnty-group             = p-have-rs-qnty-group
     9440             ub.price-list-type.have-rs-sum-group              = p-have-rs-sum-group
     9441             ub.price-list-type.main                           = p-main
     9442             ub.price-list-type.only-gbd                       = p-only-gbd
     9443             ub.price-list-type.plt-main-db-num                = if p-plt-main-id = 0 then p-db-num else p-plt-main-db-num
     9444             ub.price-list-type.plt-main-id                    = if p-plt-main-id = 0 then p-id else p-plt-main-id
     9445             ub.price-list-type.priority                       = p-priority
     9446             ub.price-list-type.rs-buyer                       = p-rs-buyer
     9447             ub.price-list-type.send-cassa                     = p-send-cassa
     9448             ub.price-list-type.under-hand-corr                = p-under-hand-corr
     9449             ub.price-list-type.under-round-method             = p-under-round-method
     9450             ub.price-list-type.under-perc                     = p-under-perc
     9451             ub.price-list-type.under-type-list                = p-under-type-list
     9452             ub.price-list-type.use-cassa                      = p-use-cassa
     9453             ub.price-list-type.use-gds-group                  = p-use-gds-group
     9454             ub.price-list-type.use-obj                        = p-use-obj
     9455             ub.price-list-type.work-date                      = p-work-date
     9456             ub.price-list-type.bgr-db-num                     = p-bgr-db-num
     9457             ub.price-list-type.bgr-id                         = p-bgr-id
     9458             ub.price-list-type.curr-code                      = p-curr-code
     9459             ub.price-list-type.gop-db-num                     = p-gop-db-num
     9460             ub.price-list-type.gop-db-num-for-calc-turnover   = p-gop-db-num-for-calc-turnover
     9461             ub.price-list-type.gop-id                         = p-gop-id
     9462             ub.price-list-type.gop-id-for-calc-turnover       = p-gop-id-for-calc-turnover
     9463             ub.price-list-type.qgr-db-num                     = p-qgr-db-num
     9464             ub.price-list-type.qgr-id                         = p-qgr-id
     9465             ub.price-list-type.sgr-db-num                     = p-sgr-db-num
     9466             ub.price-list-type.sgr-id                         = p-sgr-id
     9467             ub.price-list-type.tog-db-num                     = p-tog-db-num
     9468             ub.price-list-type.tog-id                         = p-tog-id
     9469             ub.price-list-type.obj-turnover                   = p-obj-turnover
     9470             ub.price-list-type.ttg-summa                      = p-ttg-summa
     9471             ub.price-list-type.have-rs-turn-group             =   p-have-rs-turn-group
     9472             ub.price-list-type.have-tog-db-num                =   p-have-tog-db-num
     9473             ub.price-list-type.have-tog-id                    =   p-have-tog-id
     9474             ub.price-list-type.use-cash-pay                   =   p-use-cash-pay
     9475             ub.price-list-type.use-pay-type                   =   p-use-pay-type
     9476             ub.price-list-type.stts                           = integer('0':U)
     9477             ub.price-list-type.sys-date                       = today
     9478             ub.price-list-type.sys-time                       = time
     9479             ub.price-list-type.sys-time-chr                   = string ( ub.price-list-type.sys-time,"hh:mm" )
     9480             ub.price-list-type.who                            = p-userid
     9481             ub.price-list-type.db-num-chg                     = p-db-num-usr
     9482             p-recid = recid ( ub.price-list-type )
     9483         .
     9484     if p-use-cassa < 3 then do:
     9485        for each tt_cassa : delete tt_cassa . end.
     9486     end.
     9487     if p-use-gds-group = 0  then do:
     9488        for each tt_grp : delete tt_grp . end.
     9489     end.
     9490     for each ub.price-list-type-gds-grp exclusive-lock where
     9491              ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
     9492              ub.price-list-type-gds-grp.plt-id      = p-id :
     9493          if not can-find (first  tt_grp where tt_grp.node-code = ub.price-list-type-gds-grp.node-code ) then
     9494          ub.price-list-type-gds-grp.stts   = integer('1':U) .
     9495     end.
     9496     for each tt_grp :
     9497         find first  ub.price-list-type-gds-grp exclusive-lock where
     9498                 ub.price-list-type-gds-grp.node-code  = tt_grp.node-code and
     9499                 ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
     9500                 ub.price-list-type-gds-grp.plt-id      = p-id no-error .
     9501         if not available ub.price-list-type-gds-grp then do:
     9502                create ub.price-list-type-gds-grp.
     9503                 assign
     9504                   ub.price-list-type-gds-grp.node-code  = tt_grp.node-code
     9505                   ub.price-list-type-gds-grp.plt-db-num     = p-db-num
     9506                   ub.price-list-type-gds-grp.plt-id         = p-id
     9507                   ub.price-list-type-gds-grp.stts       = integer('0':U)
     9508                   ub.price-list-type-gds-grp.sys-date     = today
     9509                   ub.price-list-type-gds-grp.sys-time     = time
     9510                   ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
     9511                   ub.price-list-type-gds-grp.who          = p-userid
     9512                   ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
     9513                 .
     9514                end.
     9515         else do:
     9516            assign
     9517             ub.price-list-type-gds-grp.stts   = integer('0':U)
