        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle  no-undo .
        3   define input-OUTPUT parameter p-version as integer          no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: cdvdload.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/cdvdload.p $":U .
        9   define variable vss-description as character no-undo init "Загрузка справочника связей касс с СВ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define buffer bf_cd-video-link      for ub.cd-video-link .
      116   DEFINE VARIABLE v-in-string  AS CHARACTER NO-UNDO .
      117   DEFINE VARIABLE v-out-string AS CHARACTER NO-UNDO .
      118   DEFINE VARIABLE v-count      AS INTEGER   NO-UNDO .
      119   DEFINE STREAM st-in .
      120   do
      121   TRANSACTION
      122   on error undo, return error
      123   :
      124      FOR EACH bf_cd-video-link
      125          EXCLUSIVE-LOCK
      126          :
      127          DELETE bf_cd-video-link.
      128      END.
      129      INPUT STREAM st-in FROM "cmp/cd-video.enc" .
      130      SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      131      REPEAT:
      132         ASSIGN
      133            v-out-string = ""
      134            v-in-string  = ""
      135         .
      136         IMPORT STREAM st-in UNFORMATTED
      137            v-in-string
      138            .
      139   define variable vss-include-info0 as character format "X(65)" no-undo
      140   initial "@(#)$Workfile$ $Revision$".
      141   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      142     (input  v-in-string
      143     ,output v-out-string
      144     )  .
      145         RUN load-line ( INPUT v-out-string ) .
      146      END.
      147   end.
      148   procedure load-line :
      149   define input parameter p-line          as character        no-undo.
      150   define VARIABLE v-event-id       as integer          no-undo .
      151   define VARIABLE v-video-id       as character        no-undo .
      152   define VARIABLE v-video-event-id as character        no-undo .
      153   define buffer buf_cd-video-link      for ub.cd-video-link .
      154   do
      155   on error undo, return error
      156   :
      157      IF NUM-ENTRIES(p-line, chr(4)) < 3
      158      THEN DO:
      159         RETURN ERROR "Не хватает параметров " + p-line.
      160      END.
      161      ASSIGN
      162         v-event-id       = INTEGER(ENTRY(1, p-line, chr(4)))
      163         v-video-id       = ENTRY(2, p-line, chr(4))
      164         v-video-event-id = ENTRY(3, p-line, chr(4))
      165      NO-ERROR.
      166      IF ERROR-STATUS:ERROR
      167      THEN DO:
      168         RETURN ERROR SUBSTITUTE( "Ошибка типов данных &1&2" , chr(10), ERROR-STATUS:GET-MESSAGE (1)) .
      169      END.
      170      FIND FIRST buf_cd-video-link
      171           WHERE buf_cd-video-link.event-id        = v-event-id
      172             AND buf_cd-video-link.video-id        = v-video-id
      173             AND buf_cd-video-link.video-event-id  = v-video-event-id
      174           NO-LOCK
      175           NO-ERROR
      176           .
      177      IF AVAILABLE buf_cd-video-link
      178      THEN DO:
      179         RETURN ERROR SUBSTITUTE ( "Уже есть связка: &1&2&3&4&5"
      180                                 , v-video-id
      181                                 , chr(10)
      182                                 , v-event-id
      183                                 , chr(10)
      184                                 , v-video-event-id
      185                                 ) .
      186      END.
      187      CREATE buf_cd-video-link.
      188      ASSIGN
      189         buf_cd-video-link.video-id       = v-video-id
      190         buf_cd-video-link.event-id       = v-event-id
      191         buf_cd-video-link.video-event-id = v-video-event-id
      192      NO-ERROR .
      193      IF ERROR-STATUS:ERROR
      194      THEN DO:
      195         RETURN ERROR SUBSTITUTE(" Ошибка создания записи: &1&2&3&4&5&6"
      196                                 , v-video-id
      197                                 , chr(10)
      198                                 , v-event-id
      199                                 , chr(10)
      200                                 , v-video-event-id
      201                                 , error-status :get-message (1)
      202                                 ) .
      203      END.
      204      RETURN.
      205   end.
      206   end procedure.
