      388   define stream f-txt .
      389   define button btn-ok     AUTO-GO .
      390   define button btn-cancel AUTO-ENDKEY .
      391   define button btn-dir .
      392   define frame f-dialog
      393     v-obj-code attr-space auto-return format ">>>>>>>>9" view-as fill-in native
      394                    label "Введите код магазина для выгрузки остатков"
      395     skip(1)
      396     "Введите коды поставщиков, выгружаемых отдельными файлами" skip(0)
      397     c_cli-list attr-space auto-return format "x(320)" no-label view-as fill-in native size-chars 55 by 1
      398     skip(1)
      399     btn-dir    label "Выбрать директорию выгрузки"
      400     v-dir-name format "x(20)" no-label view-as text
      401     skip(1)
