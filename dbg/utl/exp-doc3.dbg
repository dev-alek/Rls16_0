      405     with title "Выгрузка текущих остатков в формате импорта ПН" attr-space side-labels view-as dialog-box.
      406   on choose of btn-dir in frame f-dialog do :
      407     run gbl/dir-sel.p
      408        ( output v-dir-name
      409         ,output v-type
      410         ,output v-can-write
      411         ).
      412     display v-dir-name with frame f-dialog .
      413   end .
      414   on choose of btn-ok in frame f-dialog do:
      415     if NOT v-can-write THEN DO:
      416       message "Укажите путь для сохранения файлов." view-as alert-box error.
      417       apply "entry" to btn-dir in frame f-dialog.
      418       return no-apply.
      419     END.
      420     assign v-obj-code .
      421     if v-obj-code > 0 then . else do:
      422       message "Укажите код магазина, остатки которого требуется выгрузить." view-as alert-box error.
      423       apply "entry" to v-obj-code in frame f-dialog.
      424       return no-apply.
      425     end .
      426   end .
      427   v-can-write = false .
      428     do on end-key undo, return :
      429       update
      430         v-obj-code
      431         c_cli-list
      432         btn-dir
      433         btn-ok
      434         btn-cancel
      435       with frame f-dialog.
      436     end .
      437     v-obj-type = 'маг':U .
      438     if c_cli-list = "":U then do:
      439       message "Остатки по всем поставщикам будут выгружены единым файлом"
      440         view-as alert-box information.
      441     end.
      442     else c_cli-list = replace(c_cli-list, ' ', '') .
      443   function fnamereplace returns character (input p-fname as character) :
      444   define variable v-fname as character no-undo .
      445     v-fname = replace(p-fname, '"', '') .
      446     v-fname = replace(v-fname, '\', '-') .
      447     v-fname = replace(v-fname, '/', '-') .
      448     v-fname = replace(v-fname, "'", "") .
      449     v-fname = replace(v-fname, ':', '') .
      450     v-fname = replace(v-fname, '?', '') .
      451     v-fname = replace(v-fname, '|', '') .
      452     v-fname = replace(v-fname, '>', '') .
      453     v-fname = replace(v-fname, '<', '') .
      454     return v-fname .
      455   end function .
      456       define buffer buf_stk-tot for ub.stk-tot .
      457       find last buf_stk-tot no-lock
      458           where buf_stk-tot.obj-type = v-obj-type
      459             and buf_stk-tot.obj-code = v-obj-code
      460             and buf_stk-tot.sum-type = 'crsa':U
      461             and buf_stk-tot.cat-id   = '##,##':U
      462       USE-INDEX Shift-num no-error .
      463       if available buf_stk-tot then v-start-fact-order = buf_stk-tot.Fact-order .
      464       else do:
      465         message
      466           substitute( "Для объекта &3&4 на сегодня отсуствуют предшествующие остатки"
      467                     , v-obj-type, v-obj-code
      468           )
      469         view-as alert-box error .
      470         return .
      471       end .
      472   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      473   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      474     (input  v-obj-type
      475     ,input  v-obj-code
      476     ,output v-host-code
      477     )  .
      478       assign
      479         v-wait-msg = "Сбор текущих остатков. Строк: &1"
      480         v-lines    = 0
      481         v-ln-prev  = v-lines + 100
      482         v-tm-prev  = time + 1
      483       .
      484       run waitfram-show in this-procedure (substitute(v-wait-msg, v-lines)) .
      485       empty temp-table tt-rest.
      486       v-today = today .
      487       v-sdate = substitute(  "&1&2&3",  string(year(v-today),"9999"),  string(month(v-today),"99"),  string(day(v-today),"99")  ) .
      488       for each buf_gds-obj no-lock
      489          where buf_gds-obj.obj-type = v-obj-type
      490            and buf_gds-obj.obj-code = v-obj-code :
      491   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      492     (
      493        input buf_gds-obj.artic
      494     ,  input buf_gds-obj.prod-type
      495     ,  input buf_gds-obj.prod-code
      496     , output is-petrolium
      497     , output is-pieces
      498     ) .
      499         if is-petrolium then next .
      500         for each buf_parts no-lock
      501            where buf_parts.out-code  = 'free-zone':U
      502              and buf_parts.obj-type  = buf_gds-obj.obj-type
      503              and buf_parts.obj-code  = buf_gds-obj.obj-code
      504              and buf_parts.artic     = buf_gds-obj.artic
      505              and buf_parts.prod-type = buf_gds-obj.prod-type
      506              and buf_parts.prod-code = buf_gds-obj.prod-code
      507            :
      508           v-lines = v-lines + 1 .
      509           if v-lines > v-ln-prev then do:
      510             v-ln-prev = v-lines + 100.
      511             if v-tm-prev < time then do:
      512               v-tm-prev  = time + 1 .
      513               run waitfram-show in this-procedure (substitute(v-wait-msg, v-lines)) .
      514             end .
      515           end.
      516           c_supp-code = string (buf_parts.supp-code) no-error .
      517           if can-do (c_cli-list, c_supp-code) then assign
      518             v-supp-code = buf_parts.supp-code
      519             v-cont-code = buf_parts.contract-code
      520           .
      521           else assign
      522             v-supp-code = 0
      523             v-cont-code = 0
      524           .
      525           find first buf_tt-rest where buf_tt-rest.contract-code = v-cont-code
      526                                    and buf_tt-rest.supp-code     = v-supp-code
      527                                    and buf_tt-rest.gds-code      = buf_gds-obj.gds-code no-error .
      528           if available buf_tt-rest then assign
      529             buf_tt-rest.fact-qnty = buf_tt-rest.fact-qnty +  buf_parts.fact-qnty
      530             buf_tt-rest.sum_rubl  = buf_tt-rest.sum_rubl  + (buf_parts.fact-qnty * buf_parts.price-rubl)
      531           .
      532           else do :
      533             create buf_tt-rest .
      534             assign
      535               buf_tt-rest.contract-code = v-cont-code
      536               buf_tt-rest.supp-code     = v-supp-code
      537               buf_tt-rest.gds-code      = buf_gds-obj.gds-code
      538               buf_tt-rest.artic     = buf_parts.artic
      539               buf_tt-rest.fact-qnty = buf_parts.fact-qnty
      540               buf_tt-rest.sum_rubl  = buf_parts.fact-qnty * buf_parts.price-rubl
      541               buf_tt-rest.vat-tax-value = 0
      542               buf_tt-rest.supp-type = buf_parts.supp-type
      543             .
      544           end .
      545         end .
      546       end .
      547       run waitfram-show in this-procedure (substitute(v-wait-msg, v-lines)) .
      548     v-wait-msg = "Проставление ставок налога" .
      549     run waitfram-show in this-procedure (v-wait-msg) .
      550     for each buf_tt-rest break by buf_tt-rest.gds-code :
      551       if first-of (buf_tt-rest.gds-code) then do :
      552         run найти_ставку_ндс in this-procedure
      553             ( buf_tt-rest.gds-code
      554             , v-host-code
      555             , v-obj-type
      556             , v-obj-code
      557             , v-start-fact-order
      558             , output v-vat-tax-value
      559             ) .
      560       end .
      561       buf_tt-rest.vat-tax-value = v-vat-tax-value .
      562     end .
      563     v-wait-msg = "Выгрузка в файл" .
      564     run waitfram-show in this-procedure (v-wait-msg) .
      565     v-fpref = substitute("&1\&2&3_&4", v-dir-name, v-obj-type, v-obj-code, v-sdate) no-error .
      566     for each buf_tt-rest break by buf_tt-rest.supp-code by buf_tt-rest.contract-code :
      567       if first-of (buf_tt-rest.supp-code) then do :
      568         if buf_tt-rest.supp-code > 0 then do :
      569           find first buf_clients no-lock
      570                where buf_clients.obj-type = buf_tt-rest.supp-type
      571                  and buf_clients.obj-code = buf_tt-rest.supp-code no-error .
      572           if available buf_clients then do :
      573                v-objnm = fnamereplace(buf_clients.obj-name).
      574                v-fsupp = substitute("&1_&2", v-objnm, buf_tt-rest.supp-code) .
      575           end .
      576           else v-fsupp = substitute("_&1", buf_tt-rest.supp-code) .
      577         end .
      578         else   v-fsupp = substitute("_0") .
      579       end .
      580       if first-of (buf_tt-rest.contract-code) then do :
      581         if buf_tt-rest.contract-code > 0 then do :
      582           find first buf_contract no-lock
      583                where  buf_contract.contract-code = buf_tt-rest.contract-code no-error .
      584           if available buf_contract then do:
      585                v-contn = fnamereplace(buf_contract.contract-prn-code).
      586                v-fcont = substitute("&1", v-contn) .
      587           end .
      588           else v-fcont = "0" .
      589         end .
      590         else   v-fcont = "0" .
      591         f-name = substitute("&1_&2_&3.adb", v-fpref, v-fsupp, v-fcont) no-error .
      592         output stream f-txt to value (f-name) .
      593       end .
      594       put stream f-txt unformatted
      595             substitute("ITEM:&1;", buf_tt-rest.artic)
      596             ";"
      597             ";"
      598             ";"
      599             buf_tt-rest.gds-code ";"
      600             (if buf_tt-rest.fact-qnty <> 0 then buf_tt-rest.sum_rubl / buf_tt-rest.fact-qnty else buf_tt-rest.sum_rubl) ";"
      601             buf_tt-rest.fact-qnty ";"
      602             ";"
      603             ";"
      604             ";"
      605             buf_tt-rest.vat-tax-value ";"
      606             ";"
      607             ";"
      608             ";"
      609             ";"
      610             "" skip
      611       .
      612       if last-of (buf_tt-rest.contract-code) then do :
      613         output stream f-txt close .
      614       end .
      615     end .
      616     run waitfram-hide in this-procedure .
      617   message "Выгрузка закончена." view-as alert-box information buttons ok.
      618   procedure найти_ставку_ндс private :
      619   define input parameter p-gds-code  as integer no-undo .
      620   define input parameter p-host-code as integer no-undo .
      621   define input parameter p-obj-type  as character no-undo .
      622   define input parameter p-obj-code  as integer no-undo .
      623   define input parameter p-start-fact-order as decimal no-undo .
      624   define output parameter p-vat-tax-value as decimal no-undo .
      625   define buffer buf_tax-rate-gds   for ub.tax-rate-gds .
      626   define buffer buf_tax-rate-value for ub.tax-rate-value .
      627         find last buf_tax-rate-gds no-lock
      628             where buf_tax-rate-gds.gds-code  = p-gds-code
      629               and buf_tax-rate-gds.tax-code  = 1
      630               and buf_tax-rate-gds.host-code = p-host-code
      631               and buf_tax-rate-gds.obj-type  = p-obj-type
      632               and buf_tax-rate-gds.obj-code  = p-obj-code
      633               and buf_tax-rate-gds.fact-order <= p-start-fact-order no-error .
      634         if not available buf_tax-rate-gds then
      635         find last buf_tax-rate-gds no-lock
      636             where buf_tax-rate-gds.gds-code  = p-gds-code
      637               and buf_tax-rate-gds.tax-code  = 1
      638               and buf_tax-rate-gds.host-code = 0
      639               and buf_tax-rate-gds.obj-type  = ''
      640               and buf_tax-rate-gds.obj-code  = 0
      641               and buf_tax-rate-gds.fact-order <= p-start-fact-order no-error.
      642         if available buf_tax-rate-gds then do:
      643           find last buf_tax-rate-value no-lock
      644               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      645                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      646                 and buf_tax-rate-value.host-code = p-host-code
      647                 and buf_tax-rate-value.obj-type  = p-obj-type
      648                 and buf_tax-rate-value.obj-code  = p-obj-code
      649                 and buf_tax-rate-value.fact-order <= p-start-fact-order
      650                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      651           if not available buf_tax-rate-value then
      652           find last buf_tax-rate-value no-lock
      653               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      654                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      655                 and buf_tax-rate-value.host-code = p-host-code
      656                 and buf_tax-rate-value.obj-type  = ""
      657                 and buf_tax-rate-value.obj-code  = 0
      658                 and buf_tax-rate-value.fact-order <= p-start-fact-order
      659                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      660           if not available buf_tax-rate-value then
      661           find last buf_tax-rate-value no-lock
      662               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      663                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      664                 and buf_tax-rate-value.host-code = 0
      665                 and buf_tax-rate-value.obj-type  = ""
      666                 and buf_tax-rate-value.obj-code  = 0
      667                 and buf_tax-rate-value.fact-order <= p-start-fact-order
      668                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      669           p-vat-tax-value = if available buf_tax-rate-value then buf_tax-rate-value.rate-value else 0 .
      670         end .
      671         else p-vat-tax-value = 0 .
      672   end procedure.
