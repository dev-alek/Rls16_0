        1   block-level on error undo, throw.
        2   define input parameter p-have-correct    as character          no-undo.
        3   on write    of fbr-line override do: end.
        4   on delete   of fbr-line override do: end.
        5   on write    of fbr-doc  override do: end.
        6   on delete   of fbr-doc  override do: end.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: fbrcorr.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: utl/fbrcorr.p $":U .
       12   define variable vss-description as character no-undo init "Проверка и правка документа производства".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   procedure cur-time :
       75      define output parameter p-today as date      no-undo .
       76      define output parameter p-time  as integer   no-undo .
       77     do
       78     on error undo, return error
       79     :
       80       define variable v-date1 as date      no-undo .
       81       define variable v-date2 as date      no-undo .
       82       define variable v-time  as integer   no-undo .
       83       assign
       84         v-date1 = today
       85         v-time  = time
       86         v-date2 = today
       87       .
       88       if v-date1 <> v-date2
       89       then do:
       90         assign
       91           v-date1 = today
       92           v-time  = v-time
       93         .
       94       end.
       95       assign
       96         p-today = v-date1
       97         p-time  = v-time
       98       .
       99     end.
      100   end.
      101   function cur-time-date returns character
      102   :
      103     return string(today, '99/99/9999':U) .
      104   end.
      105   function cur-time-mjd returns decimal
      106   :
      107     define variable v-date as date      no-undo .
      108     define variable v-time as integer   no-undo .
      109     run cur-time in this-procedure
      110       (output v-date
      111       ,output v-time
      112       ) .
      113     return integer(v-date) - 2400002 + (v-time / 86400) .
      114   end.
      115   function cur-time-get-ending-index returns integer
      116   (input p-number as integer
      117   )
      118   :
      119     if p-number < 0
      120     or p-number = ?
      121     then do:
      122       return 1 .
      123     end.
      124     define variable v-rest as integer   no-undo .
      125     assign
      126       p-number = p-number modulo 100
      127     .
      128     if p-number < 20
      129     then do:
      130       assign
      131         v-rest = p-number
      132       .
      133     end.
      134     else do:
      135       assign
      136         v-rest = p-number modulo 10
      137       .
      138     end.
      139     case v-rest :
      140       when 1
      141       then do:
      142         return 2 .
      143       end.
      144       when 2 or
      145       when 3 or
      146       when 4
      147       then do:
      148         return 3 .
      149       end.
      150       otherwise do:
      151         return 1 .
      152       end.
      153     end case .
      154   end.
      155   procedure cur-time-mjd-to-date :
      156      define input  parameter i-mjd-diff as decimal no-undo.
      157      define output parameter o-Date     as date    no-undo.
      158      define output parameter o-Time     as integer no-undo.
      159      define variable v-day-number as integer   no-undo .
      160      if    i-mjd-diff < 0
      161         or i-mjd-diff = ?
      162      then do:
      163         return "?" .
      164      end.
      165      assign
      166         v-day-number = truncate(i-mjd-diff,0).
      167         o-Date = date(v-day-number + 2400002).
      168         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      169     .
      170   end.
      171   function cur-time-mjd-to-string returns character
      172   (input p-mjd-diff as decimal
      173   )
      174   :
      175     define variable v-day-number as integer   no-undo .
      176     define variable v-seconds    as integer   no-undo .
      177     define variable v-hour       as integer   no-undo .
      178     define variable v-min        as integer   no-undo .
      179     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      180     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      181     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      182     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      183     if p-mjd-diff < 0
      184     or p-mjd-diff = ?
      185     then do:
      186       return "?" .
      187     end.
      188     assign
      189       v-day-number = integer(truncate(p-mjd-diff,0))
      190       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      191     .
      192     if v-seconds > 86400
      193     then do:
      194       assign
      195         v-seconds = 86400 - 1
      196       .
      197     end.
      198     if v-seconds < 0
      199     then do:
      200       assign
      201         v-seconds = 0
      202       .
      203     end.
      204     assign
      205       v-hour = truncate(v-seconds / 3600, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 3600
      209     .
      210     assign
      211       v-min = truncate(v-seconds / 60, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 60
      215     .
      216     return
      217         (if v-day-number <> 0
      218           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0
      222           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      226           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      227           else ""
      228         )
      229       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      230       .
      231   end.
      232   function cur-time-string returns character
      233   :
      234     define variable v-date as date      no-undo .
      235     define variable v-time as integer   no-undo .
      236     run cur-time in this-procedure
      237       (output v-date
      238       ,output v-time
      239       ) .
      240     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      241   end.
      242   function cur-time-string-sec returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      251   end.
      252   function cur-time-custom  returns character
      253   (input p-prefix as character
      254   ,input p-date-format as character
      255   ,input p-delimiter as character
      256   ,input p-time-format as character
      257   ,input p-suffix as character
      258   )
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return
      267       p-prefix
      268       + string(v-date, p-date-format)
      269       + p-delimiter
      270       + string(v-time, p-time-format)
      271       + p-suffix
      272       .
      273   end.
      274   function cur-time-print  returns character
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      283   end.
      284   function cur-time-datetime returns datetime
      285   :
      286     define variable v-char as character no-undo .
      287     define variable v-datetime as datetime no-undo .
      288     v-char = cur-time-string().
      289     v-datetime = datetime(v-char).
      290     return  v-datetime.
      291   end.
      292   function cur-time-string-msec returns character
      293   :
      294     define variable v-date as datetime  no-undo .
      295     v-date = now.
      296     return string(v-date) .
      297   end.
      298   define stream log-stream.
      299       define variable v-doc-code    as character    no-undo.
      300       define buffer buf_fbr-doc       for fbr-doc.
      301       define buffer buf_fbr-line      for fbr-line.
      302   do
      303   for buf_fbr-doc
      304     , buf_fbr-line
      305   on error undo, return error return-value
      306   :
      307   if session :set-wait-state( "compiler" ) then.
      308       run write-log in this-procedure (
      309             input 0
      310           , input "&DLine":U
      311       ).
      312       run write-log in this-procedure (
      313             input 0
      314           , input ( if p-have-correct = "delete":U then "Корректировка " else "Проверка " ) + "документов производства."
      315       ).
      316       test-fbr-line:
      317       for each buf_fbr-line exclusive-lock
      318       on error undo, return error
      319       :
      320           assign
      321               v-doc-code = buf_fbr-line.doc-code
      322           .
      323           find first buf_fbr-doc exclusive-lock
      324                where buf_fbr-doc.doc-code = v-doc-code
      325           no-error no-wait.
      326           if not available buf_fbr-doc
      327           then do:
      328               if locked buf_fbr-doc
      329               then do:
      330                   run write-log in this-procedure (
      331                         input 1
      332                       , input substitute( "*** Документ производства '&1' заблокирован. Проверка строк невозможна."
      333                                           , v-doc-code )
      334                   ).
      335                   undo test-fbr-line, next test-fbr-line.
      336               end.
      337               else do:
      338                   if p-have-correct = "delete":U
      339                   then do:
      340                       delete buf_fbr-line.
      341                   end.
      342                   run write-log in this-procedure (
      343                         input 1
      344                       , input substitute( "&1далена строка документа производства '&2'. Не найдена шапка документа."
      345                                           , ( if p-have-correct = "delete":U then "У" else "Должна быть у" )
      346                                           , v-doc-code )
      347                   ).
      348               end.
      349           end.
      350       end.
      351       run test-by-trn-docs in this-procedure .
      352   if session :set-wait-state( "" ) then.
      353       message
      354           ( if p-have-correct = "delete":U then "Корректировка " else "Проверка " ) "документов производства завершена."
      355           skip "Результат выведен в файл fbrcorr.txt"
      356           skip "в рабочем каталоге TradeHouse."
      357       view-as alert-box information
      358       title ( if p-have-correct = "delete":U then "Корректировка " else "Проверка " ) + "документов производства".
      359       run write-log in this-procedure (
      360             input 0
      361           , input "&DLine":U
      362       ).
      363   end.
      364   procedure test-by-trn-docs :
      365       define variable v-have-trn-doc  as logical      no-undo.
      366       define variable v-doc-code      as character    no-undo.
      367       define variable v-doc-code-eq   as character    no-undo.
      368       define variable v-doc-code-as   as character    no-undo.
      369       define buffer buf_trn-doc       for trn-doc.
      370       define buffer buf_fbr-doc       for fbr-doc.
      371       define buffer buf_fbr-line      for fbr-line.
      372   do
      373   for buf_trn-doc
      374     , buf_fbr-doc
      375     , buf_fbr-line
      376   on error undo, return error
      377   :
      378       test-fbr-doc:
      379       for each buf_fbr-doc exclusive-lock
      380       on error undo, return error
      381       :
      382           assign
      383               v-doc-code      = buf_fbr-doc.doc-code
      384               v-doc-code-eq   = replace( v-doc-code, "-":U, "=":U )
      385               v-doc-code-as   = replace( v-doc-code, "-":U, "*":U )
      386               v-have-trn-doc  = yes
      387           .
      388           if buf_fbr-doc.status_ = 'факт':U
      389           then do:
      390               find first buf_trn-doc exclusive-lock
      391                    where buf_trn-doc.doc-code = v-doc-code
      392               no-error no-wait.
      393               if available buf_trn-doc
      394               then do:
      395                   assign
      396                       v-have-trn-doc = yes
      397                   .
      398               end.
      399               else do:
      400                   if locked buf_trn-doc
      401                   then do:
      402                       run write-log in this-procedure (
      403                             input 1
      404                           , input substitute( "*** Документ списания по производству '&1' заблокирован. Проверка соответствующего документа производства невозможна."
      405                                               , v-doc-code )
      406                       ).
      407                       undo test-fbr-doc, next test-fbr-doc.
      408                   end.
      409                   else do:
      410                       assign
      411                           v-have-trn-doc = no
      412                       .
      413                   end.
      414               end.
      415               if v-have-trn-doc = no
      416               then do:
      417                   find first buf_trn-doc exclusive-lock
      418                        where buf_trn-doc.doc-code = v-doc-code-eq
      419                   no-error no-wait.
      420                   if available buf_trn-doc
      421                   then do:
      422                       assign
      423                           v-have-trn-doc = yes
      424                       .
      425                   end.
      426                   else do:
      427                       if locked buf_trn-doc
      428                       then do:
      429                           run write-log in this-procedure (
      430                                 input 1
      431                               , input substitute( "*** Документ прихода по производству '&1' заблокирован. Проверка соответствующего документа производства невозможна."
      432                                                   , v-doc-code )
      433                           ).
      434                           undo test-fbr-doc, next test-fbr-doc.
      435                       end.
      436                       else do:
      437                           assign
      438                               v-have-trn-doc = no
      439                           .
      440                       end.
      441                   end.
      442               end.
      443               if v-have-trn-doc = no
      444               then do:
      445                   find first buf_trn-doc exclusive-lock
      446                        where buf_trn-doc.doc-code = v-doc-code-as
      447                   no-error no-wait.
      448                   if available buf_trn-doc
      449                   then do:
      450                       assign
      451                           v-have-trn-doc = yes
      452                       .
      453                   end.
      454                   else do:
      455                       if locked buf_trn-doc
      456                       then do:
      457                           run write-log in this-procedure (
      458                                 input 1
      459                               , input substitute( "*** Документ прихода по производству '&1' заблокирован. Проверка соответствующего документа производства невозможна."
      460                                                   , v-doc-code )
      461                           ).
      462                           undo test-fbr-doc, next test-fbr-doc.
      463                       end.
      464                       else do:
      465                           assign
      466                               v-have-trn-doc = no
      467                           .
      468                       end.
      469                   end.
      470               end.
      471               if v-have-trn-doc = no
      472               then do:
      473                   run write-log in this-procedure (
      474                         input 1
      475                       , input substitute( "&1далён документ производства в статусе 'факт' номер '&2': документ не образует ни одного складского документа."
      476                                           , ( if p-have-correct = "delete":U then "У" else "Должен быть у" )
      477                                           , v-doc-code )
      478                   ).
      479                   if p-have-correct = "delete":U
      480                   then do:
      481                       for each buf_fbr-line exclusive-lock
      482                          where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
      483                       :
      484                           delete buf_fbr-line.
      485                       end.
      486                       delete buf_fbr-doc.
      487                   end.
      488               end.
      489           end.
      490       end.
      491   end.
      492   end procedure.
      493   procedure write-log :
      494   define input parameter p-log-level  as integer      no-undo.
      495   define input parameter p-out-string as character    no-undo.
      496   do
      497   on error undo, return error
      498   :
      499       output stream log-stream to value( "fbrcorr.txt":U ) append.
      500       put stream log-stream unformatted
      501           chr(10)
      502       .
      503       put stream log-stream unformatted
      504           ( if p-log-level = 0
      505             or p-out-string = "&DLine":U
      506             or p-out-string = "&Line":U
      507             then "":U
      508             else cur-time-string-sec() + fill( " ":U, p-log-level * 2 ) )
      509       .
      510       put stream log-stream unformatted
      511           ( if p-out-string = "&Line":U
      512             then fill( "-":U, 80 )
      513             else if p-out-string = "&DLine":U
      514                  then fill( "=":U, 80 )
      515                  else p-out-string )
      516       .
      517       output stream log-stream close.
      518   end.
      519   end procedure.
