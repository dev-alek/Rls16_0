       93   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
       95     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
       96     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
       97     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
