      500   field obj-type   like ub.trn-doc.obj-type
      501   field obj-code   like ub.trn-doc.obj-code
      502   field fact-num   like ub.trn-doc.fact-num
      503   field fact-date  like ub.trn-doc.fact-date
      504   field shift-date like ub.trn-doc.shift-date
      505   field shift-num  like ub.trn-doc.shift-num
      506   field shift-name like ub.trn-doc.shift-name
      507   field fact-order as decimal
