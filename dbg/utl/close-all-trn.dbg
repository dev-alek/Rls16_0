      525   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      526   define  new shared  temp-table doc-list-hist no-undo
      527   field list-table as character
      528   field id as integer
      529   field line as integer
      530   field hist-mode as character
      531   field des as character
      532   field num-recs as integer
      533   field option_ as character
      534   field item_ as character
      535   field status_ as character
      536   field num-add as integer
      537   field num-ignored as integer
      538   field done as logical
