      104     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
      105     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
      106     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
      107     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
      108     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
      109     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
      110     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
      111     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
      112     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
      113     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
      114     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
      115     define variable v-cntxp-conf-par        as   character                no-undo.
      116     define variable v-cntxp-par-type        as   character                no-undo.
      117     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
      118     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      119     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      120     define variable v-cntxp-db-num          as integer   no-undo .
      121     define variable v-cntxp-userid          as character no-undo .
      122     define variable v-cntxp-level           as character no-undo .
      123     define variable v-cntxp-db-num-obj      as integer   no-undo .
      124     define variable v-cntxp-is-admin        as logical   no-undo .
      125     define buffer bf-cntxp_store for ub.store.
      126     define buffer bf-cntxp_shop  for ub.shop.
      127     define buffer bf-cntxp_sysconf for ub.sysconf.
      128   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129     run mainmenu_getcntxt in parparentproc
      130       (output v-cntxp-db-num
      131       ,output v-cntxp-userid
      132       ,output v-cntxp-level
      133       ,output v-cntxp-curr-host-code
      134       ,output v-cntxp-obj-type
      135       ,output v-cntxp-obj-code
      136       ,output v-cntxp-db-num-obj
      137       ,output v-cntxp-is-admin
      138       ) .
      139     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      140        v-cntxp-obj-code <> 0 then do:
      141   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      142     (input  'is-prt'
      143     ,input  0
      144     ,input  ''
      145     ,input  0
      146     ,input  ''
      147     ,input  ''
      148     ,input  ''
      149     ,input  yes
      150     ,output v-cntxp-conf-par
      151     ,output v-cntxp-par-type
      152     ) no-error .
      153       case v-cntxp-obj-type :
      154         when 'скл':U then do:
      155           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      156           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      157           assign
      158             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      159             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      160             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      161             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      162             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      163             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      164             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      165             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      166             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      167             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      168             v-cntxp-load-time       = bf-cntxp_store.load-time
      169             v-cntxp-holidays        = bf-cntxp_store.holidays
      170             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      171             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      172             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      173             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      174             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      175             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      176             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      177             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      178             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      179             .
      180         end.
      181         when 'маг':U then do:
      182           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      183           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      184           assign
      185             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      186             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      187             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      188             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      189             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      190             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      191             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      192             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      193             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      194             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      195             v-cntxp-load-time       = bf-cntxp_shop.load-time
      196             v-cntxp-holidays        = bf-cntxp_shop.holidays
      197             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      198             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      199             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      200             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      201             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      202             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      203             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      204             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      205             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      206             .
      207         end.
      208       end case.
      209     end.
      210   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   define variable v-waitfram-action01         as character   no-undo .
      212   define variable v-waitfram-action02         as character   no-undo .
      213   define variable v-waitfram-action03         as character   no-undo .
      214   define variable mWaitFramTextBeg            as character   no-undo.
      215   define variable mWaitFramTextEnd            as character   no-undo.
      216   define variable mWaitFramView               as logical     no-undo.
      217   define variable mWaitProcEvent              as logical     no-undo init yes.
      218   define variable mWaitFramInterval           as integer     no-undo init 1 .
      219   define variable mWaitFramStop               as logical     no-undo.
      220   define variable mWaitFramStopUser           as logical     no-undo.
      221   define variable mWaitFramStopTimeOut        as logical     no-undo.
      222   define variable mWaitFramStartProc          as datetime-tz no-undo.
      223   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      224   define button B-WaitFramStop auto-end-key
      225        label "Стоп"
      226        size 10 by 1 tooltip "Остоновить процесс".
      227   define button B-viewProcInfo
      228        label "Информация"
      229        size 15 by 1 tooltip "Информация о процесс".
      230   define frame waitfram
      231     v-waitfram-action01 format "x(72)" no-label skip
      232     v-waitfram-action02 format "x(72)" no-label skip
      233     v-waitfram-action03 format "x(72)" no-label skip
      234     B-viewProcInfo
      235     B-WaitFramStop at row 4 col 30
      236     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      237     .
      238   define new global shared variable mBatchMode as logical no-undo init ?.
      239   define variable mFramBachModHandle as handle no-undo.
      240   mFramBachModHandle = frame waitfram:handle.
      241   define variable mFameOldVis as logical no-undo.
      242   define variable mVisCUrentVin as logical no-undo.
      243   if session:batch-mode
      244   then
      245      mBatchMode = yes.
      246   if mBatchMode = ? then do:
      247     mVisCUrentVin = current-window:visible.
      248     mFameOldVis = mFramBachModHandle:visible.
      249     mFramBachModHandle:visible  = yes.
      250     mBatchMode = mFramBachModHandle:visible ne yes.
      251     mFramBachModHandle:visible = mFameOldVis.
      252     current-window:visible = mVisCUrentVin.
      253   end.
      254    if  log-manager:logfile-name ne ?
      255     then DO:
      256         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      257         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      258         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      259     end.
      260   on choose of B-WaitFramStop in frame waitfram
      261   do:
      262     mWaitFramStop = yes.
      263     mWaitFramStopUser = yes.
      264   end.
      265   function waitfram-check-timeout returns logical():
      266      define variable vtime as int64 no-undo.
      267      if mWaitFramStopTimeOut
      268      then
      269         return yes.
      270      vtime = ( now - mWaitFramStartProc ) / 1000 .
      271      if     mWaitFramTimeOut ne ?
      272         and mWaitFramTimeOut ne 0
      273         and mWaitFramTimeOut lt vtime
      274      then do:
      275         mWaitFramStopTimeOut = yes.
      276      end.
      277      return mWaitFramStopTimeOut.
      278   end.
      279   procedure waitfram-hide :
      280     if not session:batch-mode
      281     then do
      282     on error undo, return error return-value
      283     :
      284       pause 0 before-hide .
      285       if not mBatchMode then
      286         hide frame waitfram .
      287     if     not mWaitFramView
      288        and mWaitProcEvent
      289     then
      290       process events .
      291     end.
      292   end procedure.
      293   procedure waitfram-show :
      294     define input  parameter p-message as character no-undo .
      295     define variable v-left-margin as integer   no-undo .
      296     if not session:batch-mode
      297     then do
      298     on error undo, return error return-value
      299     :
      300       if length(p-message) <= 70 then do:
      301         assign
      302           v-left-margin = integer((70 - length(p-message)) / 2)
      303         .
      304         assign
      305           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      306         .
      307         assign
      308           v-waitfram-action01 = " "
      309           v-waitfram-action02 = " "
      310                                    + fill(" ", v-left-margin)
      311                                    + p-message
      312           v-waitfram-action03 = " "
      313         .
      314       end.
      315       else do:
      316         define variable vRindex1 as integer no-undo.
      317         define variable vRindex2 as integer no-undo.
      318         vRindex1 = r-index(p-message," ",70).
      319         if vRindex1 = 0
      320         then
      321            vRindex1 = 70.
      322         if length(p-message)  <= vRindex1 + 70 then do:
      323           assign
      324             v-waitfram-action01 = " "
      325             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      326             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      327           .
      328         end.
      329         else do:
      330           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      331           if vRindex2 <= vRindex1
      332           then
      333              vRindex2 = vRindex1 + 70.
      334           assign
      335             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      336             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      337             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      338           .
      339         end.
      340       end.
      341       B-viewProcInfo:visible   in frame waitfram = no.
      342       B-viewProcInfo:sensitive in frame waitfram = no.
      343       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      344       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      345       if  (   mWaitFramView
      346          or  mWaitProcEvent)
      347          and not mBatchMode
      348       then
      349          display
      350             v-waitfram-action01 skip
      351             v-waitfram-action02 skip
      352             v-waitfram-action03 skip
      353          with frame waitfram .
      354       if     mWaitFramView
      355          then do:
      356             if     mWaitFramInterval ne ?
      357                and not mBatchMode
      358             then
      359                wait-for go of frame waitfram pause mWaitFramInterval.
      360          end.
      361          else
      362             if     mWaitProcEvent
      363                and not mBatchMode
      364             then
      365                process events .
      366     end.
      367   end procedure.
      368      procedure waitfram-show-this:
      369         define input  parameter iInterval as int64 no-undo.
      370         define variable vtime as int64 no-undo.
      371         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      372         mWaitFramInterval = iInterval.
      373         run waitfram-show (substitute("&1&2 &3&4" ,
      374                                       mWaitFramTextBeg ,
      375                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      376                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      377                                       mWaitFramTextEnd
      378                                      )
      379                           ).
      380      end.
      381      procedure WaitFramRunPause:
      382         define input  parameter iInterval as dec no-undo.
      383         define variable vStart  as datetime-tz no-undo.
      384         define variable vend    as datetime-tz no-undo.
      385         define variable vint as int64 no-undo.
      386         define variable vOk as logical no-undo.
      387         vStart = now.
      388         vend   = vStart.
      389         publish "WaitFramPause" (iInterval,output vOk).
      390         vend   =  now.
      391         vint = vend - vStart.
      392         vint = iInterval - vint / 1000.
      393         if     not mWaitFramStop
      394            and (   vint > 0
      395                 or (    not vOk
      396                     and iInterval eq ?
      397                     )
      398                 )
      399         then
      400            run waitfram-show-this (iInterval).
      401         vend   =  now.
      402         vint = vend - vStart.
      403         vint = iInterval - vint / 1000.
      404         if     not mWaitFramStop
      405            and vint > 0
      406         then do:
      407            run gbl/pause.p (vint * 1000).
      408         end.
      409         if iInterval ne ?
      410         then
      411            publish "WaitFramStop".
      412         waitfram-check-timeout().
      413      end.
      414      procedure WaitFramWaitFor:
      415         define input  parameter iInterval as dec no-undo.
      416         assign
      417            mWaitFramStartProc   = now
      418            mWaitFramStopUser    = no
      419            mWaitFramStopTimeOut = no
      420         .
      421         block-wait:
      422         do while not mWaitFramStop:
      423            run WaitFramRunPause (iInterval).
      424            if  waitfram-check-timeout()
      425            then do:
      426               leave block-wait.
      427            end.
      428         end.
      429         run waitfram-hide.
      430      end.
      431   procedure waitfram-join :
      432     define input  parameter p-line-1  as character no-undo .
      433     define input  parameter p-line-2  as character no-undo .
      434     define input  parameter p-line-3  as character no-undo .
      435     define output parameter p-message as character no-undo .
      436     do
      437     on error undo, return error return-value
      438     :
      439       assign
      440         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      441                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      442                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      443       .
      444     end.
      445   end procedure.
      446   function waitfram-join-function returns character
      447     (input p-line-1 as character
      448     ,input p-line-2 as character
      449     ,input p-line-3 as character
      450     ).
      451     define variable v-message as character no-undo .
      452     run waitfram-join in this-procedure
      453       (input  p-line-1
      454       ,input  p-line-2
      455       ,input  p-line-3
      456       ,output v-message
      457       ) .
      458     return v-message .
      459   end function .
      460   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      461   define new shared temp-table gds-list no-undo like ub.goods
