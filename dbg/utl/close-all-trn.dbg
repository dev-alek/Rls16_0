      546   .
      547   define buffer buf_trn-doc for ub.trn-doc  .
      548   define variable v-cntxt-cash-pay as integer   no-undo .
      549   define variable v-cntxt-in-ov as logical   no-undo .
      550   define variable v-cntxt-base-code as integer   no-undo .
      551   define variable v-cntxt-rsrv-time  as integer   no-undo .
      552   define variable v-cntxt-load-time  as integer   no-undo .
      553   define variable v-cntxt-holidays  as character no-undo .
      554   define variable vt-host-code as integer   no-undo .
      555   define variable vt-obj-type as character no-undo .
      556   define variable vt-obj-code      as integer   no-undo .
      557     run str/fext-trn.w
      558         ( parparentproc ,
      559         v-cntxt-host-code-obj,
      560         v-cntxt-obj-type,
      561         v-cntxt-obj-code
      562         ).
      563   run waitfram-show ( "Попытка потокового закрытия документов") .
      564   define buffer buf_sysconf for ub.sysconf  .
      565   define variable vvv as integer   no-undo .
      566   define variable eee as integer   no-undo .
      567   vvv = 0.
      568   eee = 0.
      569   for each doc-list :
      570   vvv = vvv + 1.
      571       for each buf_trn-doc no-lock where
      572           buf_trn-doc.doc-code = doc-list.doc-code and
      573           buf_trn-doc.status_ <> 'факт':U  :
      574           run waitfram-show ("Закрываю: " + buf_trn-doc.doc-code ) .
      575             find first   buf_sysconf where
      576                 buf_trn-doc.host-code = buf_sysconf.host-code .
      577             assign
      578               v-cntxt-cash-pay   = buf_sysconf.cash-pay
      579               v-cntxt-base-code  = buf_sysconf.base-code
      580               v-cntxt-in-ov      = buf_sysconf.in-ov
      581               v-cntxt-rsrv-time  = buf_sysconf.rsrv-time
      582               v-cntxt-load-time  = buf_sysconf.load-time
      583               v-cntxt-holidays   = buf_sysconf.holidays
      584               v-cntxp-out-pay    = buf_sysconf.out-pay
      585               .
      586             run clos-trn2 in this-procedure (buf_trn-doc.doc-code) no-error .
      587             if error-status :error then do:
      588             eee = eee + 1.
      589             next.
      590             end.
      591         end.
      592   end.
      593   run waitfram-hide.
      594   procedure clos-trn2 :
      595   define input parameter p-trn-code as character no-undo .
      596   define buffer buf_s-trn-doc for ub.trn-doc.
      597   define variable varmode            as   character           no-undo.
      598   define variable varstatus          like ub.trn-doc.status_  no-undo.
      599   define variable varflag            like ub.trn-doc.flag     no-undo.
      600   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
      601   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
      602   define variable varcheck-return as logical no-undo .
      603   define variable varchg-inv as logical no-undo .
      604   run str/trn-stat.p (
      605       input  parparentproc ,
      606       input  this-procedure ,
      607       input  '<закрытие документа>':U ,
      608       input  p-trn-code,
      609       input  false  ,
      610       input  v-cntxt-db-num,
      611       input  false ,
      612       input  v-cntxt-rsrv-time,
      613       input  v-cntxt-load-time,
      614       input  v-cntxt-holidays,
      615       input  false ,
      616       output varchg-inv ,
      617       output table gds-list)
      618       no-error.
      619   end procedure.
