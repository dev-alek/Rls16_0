        1   block-level on error undo, throw.
        2   .session:debug-alert = yes.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define variable mAsyncProc as class ibs.th.file.AsyncProc.
        8   run ibs\th\file\getasyncproc.p (output mAsyncProc).
        9   define variable mstopAsunc as logical no-undo.
       10   function StopCheck returns logical:
       11      define variable oFlag as logical no-undo.
       12      run StopCheckAsync (output oFlag).
       13      return oFlag.
       14   end.
       15   procedure StopCheckAsync:
       16       define output  parameter oFlag as logical no-undo.
       17       if mstopAsunc
       18       then
       19          oFlag = mstopAsunc.
       20       else do:
       21          oFlag = mAsyncProc:CheckStop().
       22          mstopAsunc = oFlag.
       23       end.
       24   end.
       25   function GetParamAsunc returns character
       26   (input iNumPar as integer  ):
       27      return mAsyncProc:GetPARAM(iNumPar).
       28   end.
       29   function GetParamAsuncStr returns ibs.th.file.asyncparam
       30   (input iParamName as character ):
       31      return mAsyncProc:GetPARAM(iParamName).
       32   end.
       33   procedure PutMesAsunc:
       34       define input  parameter Itext as character no-undo.
       35       define variable vflag as logical no-undo.
       36       Publish "WriteLogAsunc" (Itext, yes)  .
       37   end.
       38   procedure PutMesAsuncNoTime:
       39       define input  parameter Itext as character no-undo.
       40       define variable vflag as logical no-undo.
       41       Publish "WriteLogAsunc" (Itext,no)  .
       42   end.
       43   procedure PutStatAsunc:
       44       define input  parameter Itext as character no-undo.
       45       Publish "PutStatAsunc" (Itext,no) .
       46        run
       47       PutMesAsunc (itext).
       48   end.
       49   procedure PutStatAsuncNoTime:
       50       define input  parameter Itext as character no-undo.
       51       Publish "PutStatAsunc" (Itext,no)  .
       52        run
       53       PutMesAsuncNoTime (itext).
       54   end.
       55   procedure PutStatAsuncAdd:
       56       define input  parameter Itext as character no-undo.
       57       Publish "PutStatAsunc" (Itext,yes)  .
       58   end.
       59   procedure PutFileLogAsunc:
       60       define input  parameter IFile as character no-undo.
       61       Publish "PutFileLogAsunc" (ifile)  .
       62   end.
       63          mAsyncProc:mProcPublish = this-procedure.
       64   if        StopCheck()
       65   then do:
       66      run PutstatAsunc(substitute("error   Получение проверка была преврвана пользователем или по TimeOut.") ).
       67      return.
       68   end.
       69   if userid("ub") ne ""
       70   then do:
       71       run PutstatAsunc(substitute("error   Не правильное подключение к Базе. ") ).
       72   return.
       73   end.
       74   define variable v-num-parameters as integer no-undo.
       75   define variable mProc-name as character no-undo.
       76   define variable mparparentproc as logical   no-undo.
       77   define variable mKey as integer  no-undo.
       78   define variable MChekSum as character no-undo.
       79   define variable m-parameter1 as character no-undo.
       80   define variable m-parameter2 as character no-undo.
       81   define variable m-parameter3 as character no-undo.
       82   mProc-name        =          GetPARAMAsunc(1).
       83   v-num-parameters  = integer (GetPARAMAsunc(2)).
       84   mparparentproc    = logical (GetPARAMAsunc(3)).
       85   mkey              = integer (GetPARAMAsunc(4)).
       86   m-parameter1      =          GetPARAMAsunc(5).
       87   m-parameter2      =          GetPARAMAsunc(6).
       88   m-parameter3      =          GetPARAMAsunc(7).
       89   if     v-num-parameters ne ?
       90      and mparparentproc   ne ?
       91      and mkey     ne ?
       92   then do:
       93      case v-num-parameters :
       94         when 0
       95         then do:
       96            if mparparentproc
       97            then do:
       98               run value (mProc-name)
       99                      (input  mkey,
      100                       output MChekSum,
      101                       input ?
      102                      ) no-error.
      103            end.
      104            else do:
      105               run value (mProc-name)
      106                      (input  mkey,
      107                       output MChekSum
      108                       )no-error.
      109            end.
      110         end.
      111         when 1
      112         then do:
      113            if mparparentproc
      114            then do:
      115                 run value (mproc-name)
      116                   (input  mkey,
      117                    output MChekSum,
      118                    input  ?
      119                   ,input  m-parameter1
      120                   )no-error.
      121            end.
      122            else do:
      123               run value (mproc-name)
      124                   (input  mkey,
      125                    output MChekSum,
      126                    input m-parameter1
      127                   )no-error.
      128            end.
      129         end.
      130         when 2
      131         then do:
      132            if mparparentproc
      133            then do:
      134               run value (mproc-name)
      135                   (input  mkey
      136                   ,output MChekSum
      137                   ,input ?
      138                   ,input m-parameter1
      139                   ,input m-parameter2
      140                   )no-error.
      141            end.
      142            else do:
      143               run value (mproc-name)
      144                   (input  mkey
      145                   ,output MChekSum
      146                   ,input m-parameter1
      147                   ,input m-parameter2
      148                   )no-error.
      149            end.
      150         end.
      151         when 3
      152         then do:
      153            if mparparentproc
      154            then do:
      155               run value (mproc-name)
      156                   (input  mkey
      157                   ,output MChekSum
      158                   ,input ?
      159                   ,input m-parameter1
      160                   ,input m-parameter2
      161                   ,input m-parameter3
      162                   )no-error.
      163            end.
      164            else do:
      165               run value (mproc-name)
      166                   (input  mkey
      167                   ,output MChekSum
      168                   ,input m-parameter1
      169                   ,input m-parameter2
      170                   ,input m-parameter3
      171                   )no-error.
      172            end.
      173         end.
      174      end case.
      175      def var v-counter as int no-undo.
      176      if error-status:error
      177      then do v-counter = 1 to error-status :num-messages
      178          :
      179           run PutstatAsunc(substitute("error  &1",error-status:get-message (v-counter)) ).
      180      end.
      181      else
      182      run PutMesAsuncNoTime ( string(MChekSum) ).
      183   end.
