      158      method private void cmbRegion-SelectedValueChanged( input sender as System.Object, input e as System.EventArgs ):
      159         def var vSelectedItem as net-item no-undo.
      160         def var vItems as "System.Collections.Generic.List<System.Object>" no-undo.
      161         assign
      162            vSelectedItem = cast(cmbRegion:SelectedItem,net-item)
      163         no-error.
      164         if valid-object(vSelectedItem) then
      165         do:
      166            assign
      167               lblRegion:Text = vSelectedItem:Desctiption
      168               vItems         = DataProvider:GetList(vSelectedItem:Value)
      169            .
      170            if vItems:Count = 0 then
      171            do:
      172               vItems:Add(new net-item()).
      173               cmbShop:DataSource = vItems.
      174            end.
      175            else
      176               cmbShop:DataSource = vItems.
      177         end.
      178         return.
      179      end method.
