       78           @VisualDesigner.
       79           method private void btnGenerate_Click( input sender as System.Object, input e as System.EventArgs ):
       80         main:
       81         do on error undo, throw:
       82            if cmbRegion:Text eq ""
       83            then
       84               undo, throw new ValidateError("Регион не может быть пустым",-1).
       85                   if cmbShop:Text eq ""
       86            then do:
       87                undo, throw new ValidateError ("Магазин не может быть пустым",-1).
       88            end.
       89            if cmbCash:Text eq ""
       90            then do:
       91                  undo, throw new ValidateError ("Номер кассы не может быть пустым",-1).
       92            end.
       93                   ValidateForm().
       94                   define variable vShop as int64 no-undo.
       95                   vShop = int64(cast(cmbShop:SelectedItem,net-item):DisplayName)no-error .
       96                   if error-status:error
       97                   then do:
       98                      vShop = int64(cmbShop:Text)no-error.
       99                      if error-status:error
      100                      then do:
      101                         undo, throw new ValidateError (error-status:get-message (1),-1).
      102               end.
      103            end.
      104            define variable vCash as int64 no-undo.
      105            vCash = int64(cast(cmbCash:SelectedItem,net-item):DisplayName)NO-error .
      106            if error-status:error
      107            then do:
      108               vCash = int64(cmbCash:Text)no-error.
      109               if error-status:error
      110               then do:
      111                  undo, throw  new ValidateError (error-status:get-message (1),-1).
      112               end.
      113            end.
      114            if vCash = 0
      115            then
      116               undo, throw  new ValidateError ("Генерация техпролива для кассы с номером м 0 не возможна.",-1).
      117            tech-prol-pwd-obj:f-user = DataProvider:GetUserLogin().
      118            if    tech-prol-pwd-obj:f-user eq ""
      119               or tech-prol-pwd-obj:f-user eq ?
      120            then do:
      121                  undo, throw new ValidateError ("Не удается вас определить. Генерация пароля запрещена",-1).
      122            end.
      123            label8:Text = string(new gpwd():gen-pwd(
      124               vShop,
      125               vCash,
      126               date(replace(mtbDate:Text,",",".")),
      127               cmbTimeBeg:Text,
      128               cmbTimeEnd:Text)).
      129            this-object:tech-prol-pwd-obj = new tech-prol-pwd().
      130            tech-prol-pwd-obj:f-user = DataProvider:GetUserLogin().
      131            FormToObject(tech-prol-pwd-obj).
      132            new repoPwd2(tech-prol-pwd-obj):Save().
      133            catch vErr as ValidateError :
      134           System.Windows.Forms.MessageBox:Show(
      135               vErr:GetMessage(1),
      136               "Внимание!",
      137               System.Windows.Forms.MessageBoxButtons:OK,
      138               System.Windows.Forms.MessageBoxIcon:Error).
      139                     end catch.
      140         end.
      141           end method.
