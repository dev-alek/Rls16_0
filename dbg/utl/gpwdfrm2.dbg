      758      method public void EnableDisable():
      759         main:
      760         do:
      761            case this-object:State:
      762               when "View" then EnableDisableForView().
      763               when "Add" or
      764               when "Edit" then EnableDisableForAddEdit().
      765            end case.
      766         end.
      767      end method.
      768      method public void EnableDisableForView():
      769         assign
      770            btnGenerate:Enabled     = no
      771            btnGenerate:visible     = no
      772            cmbTimeBeg:Enabled      = no
      773            cmbTimeEnd:Enabled      = no
      774            cmbRegion:Enabled       = no
      775            cmbShop:Enabled         = no
      776            cmbCash:Enabled         = no
      777            dateTimePicker1:Enabled = no
      778            dateTimePicker1:visible = no
      779            cmbFio:Enabled          = no
      780            rbtnOnce:Enabled        = no
      781            rbtnInterval:Enabled    = no
      782            btnFio:enabled          = no
      783            btnFio:visible          = no
      784            mtbDate:enabled         = no
      785            .
      786      end method.
      787      method public void EnableDisableForAddEdit():
      788         assign
      789            btnGenerate:Enabled     = yes
      790            cmbShop:Enabled         = yes
      791            cmbCash:Enabled         = yes
      792            dateTimePicker1:Enabled = yes
      793            cmbFio:Enabled          = yes
      794            rbtnOnce:Enabled        = yes
      795            rbtnInterval:Enabled    = yes
      796            label8:Visible          = yes
      797            btnToBuff:Visible       = yes
      798            btnToBuff:Enabled       = yes
      799            btnFio:enabled          = yes
      800            cmbRegion:Enabled       = yes
      801            .
      802         if rbtnOnce:Checked then
      803            DisableTimes().
      804         else
      805            EnableTimes().
      806      end method.
      807      method public void EnableTimes():
      808         assign
      809            cmbTimeBeg:Enabled = yes
      810            cmbTimeEnd:Enabled = yes
      811            .
      812      end method.
      813      method public void DisableTimes():
      814         assign
      815            cmbTimeBeg:Enabled = no
      816            cmbTimeEnd:Enabled = no
      817            .
      818      end method.
      819      method public void ClearTimes():
      820         assign
      821            cmbTimeEnd:Text = ""
      822            .
      823      end method.
      824      method public void FormToObject(iObj as class tech-prol-pwd):
      825         def var vNow as datetime no-undo.
      826         define variable vShop as int64 no-undo.
      827            vShop = int64(cast(cmbShop:SelectedItem,net-item):DisplayName)NO-error .
      828            if error-status:error
      829            then do:
      830               vShop = int64(cmbShop:Text)no-error.
      831               if error-status:error
      832               then do:
      833                  message error-status:get-message (1)
      834                  view-as alert-box.
      835                  new ValidateError (error-status:get-message (1)).
      836               end.
      837            end.
      838            define variable vCash as int64 no-undo.
      839            vCash = int64(cast(cmbCash:SelectedItem,net-item):DisplayName)NO-error .
      840            if error-status:error
      841            then do:
      842               vCash = int64(cmbCash:Text)no-error.
      843               if error-status:error
      844               then do:
      845                  message error-status:get-message (1)
      846                  view-as alert-box.
      847                  new ValidateError (error-status:get-message (1)).
      848               end.
      849            end.
      850         assign
      851            vNow = now
      852            iObj:f-beg-time = cmbTimeBeg:Text
      853            iObj:f-end-time = cmbTimeEnd:Text
      854            iObj:f-host = System.Net.Dns:GetHostName()
      855            iObj:cash-desk-surr = string(vCash)
      856            iObj:shop-surr = String(vShop)
      857            iObj:region-surr = cmbRegion:text
      858            iObj:f-date = date(replace(mtbDate:text,",","."))
      859            iObj:f-time = vNow
      860            iObj:f-fio = cmbFio:Text
      861            iObj:f-pwd-type = if rbtnOnce:Checked then "Р" else "И"
      862            iObj:f-pwd = label8:Text
      863         .
      864      end method.
      865      method public void ObjectToForm(iObj as class tech-prol-pwd):
      866         def var vNetItem as class net-item no-undo.
      867         assign
      868            cmbTimeBeg:Text = iObj:f-beg-time
      869            cmbTimeEnd:Text = iObj:f-end-time
      870            cmbFio:Text = iObj:f-fio
      871            label8:Text = iObj:f-pwd
      872         .
      873         if tech-prol-pwd-obj:f-pwd-type = "Р" then
      874            rbtnOnce:Checked = yes.
      875         else
      876            rbtnInterval:Checked = yes.
      877         vNetItem = DataProvider:GetObj(iObj:region-surr).
      878         if valid-object(vNetItem) then
      879         do:
      880            assign
      881               cmbRegion:SelectedValue = vNetItem
      882               cmbRegion:Text = vNetItem:DisplayName
      883               lblRegion:Text = vNetItem:Desctiption
      884            .
      885         end.
      886         vNetItem = DataProvider:GetObj(iObj:shop-surr).
      887         if valid-object(vNetItem) then
      888         do:
      889            assign
      890               cmbShop:SelectedValue = vNetItem
      891               cmbShop:Text = vNetItem:DisplayName
      892               lblShop:Text = vNetItem:Desctiption
      893            .
      894         end.
      895         vNetItem = DataProvider:GetOBj(iObj:cash-desk-surr).
      896         if valid-object(vNetItem) then
      897         do:
      898            assign
      899               cmbCash:SelectedValue = vNetItem
      900               cmbCash:Text = vNetItem:DisplayName
      901            .
      902         end.
      903         define variable vDate as date no-undo.
      904         vDate = if iObj:f-date = ? then today else iObj:f-date.
      905         dateTimePicker1:value = datetime(vDate).
      906         mtbDate:text = string(vDate,"99.99.99").
      907      end method.
      908      method public void ValidateForm():
      909         def var vShop as int64 no-undo.
      910         do trans:
      911            DataProvider:ValidateForm(
      912             cmbRegion,
      913             cmbShop,
      914             cmbCash).
      915            catch vErr as ValidateError :
      916               message vErr:GetMessage(1)
      917               view-as alert-box.
      918            end catch.
      919         end.
      920         if rbtnInterval:Checked then
      921         do:
      922            if cmbTimeBeg:Text = "" then
      923            do:
      924               cmbTimeBeg:Focus().
      925               undo, throw new ValidateError("Не указано время начала техпролива",-1).
      926            end.
      927            if cmbTimeEnd:Text = "" then
      928            do:
      929               cmbTimeEnd:Focus().
      930               undo, throw new ValidateError("Не указано время окончания техпролива",-1).
      931            end.
      932         end.
      933         ValidateTimes(cmbTimeBeg).
      934         ValidateTimes(cmbTimeEnd).
      935         if cmbFio:Text = "" then
      936         do:
      937            cmbFio:Focus().
      938            undo, throw new ValidateError("Не указано ФИО заказчика техпролива",-1).
      939         end.
      940      end method.
      941      method public void ValidateTimes(iComboBox as System.Windows.Forms.ComboBox):
      942         define variable vDigit as int64 no-undo.
      943         if num-entries(iComboBox:Text, ":") <> 2 then
      944         do:
      945            iComboBox:Focus().
      946            undo, throw new ValidateError("Введено некорректное время",-1).
      947         end.
      948         assign
