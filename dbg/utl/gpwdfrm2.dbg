      286      method public void Inits():
      287         def buffer b-clients for clients.
      288         def buffer b-cash-desk for cash-desk.
      289         def var vItem as class net-item no-undo.
      290         assign
      291            cmbRegion:DisplayMember = "DisplayName"
      292            cmbRegion:ValueMember = "Value"
      293            cmbShop:DisplayMember = "DisplayName"
      294            cmbShop:ValueMember = "Value"
      295            cmbCash:DisplayMember = "DisplayName"
      296            cmbCash:ValueMember = "Value"
      297            this-object:DataProvider = new gpwdfrm-data2()
      298         .
      299         cmbRegion:DataSource = DataProvider:GetList("CashObj").
      300         if this-object:State = "Add" then
      301         do:
      302            assign
      303               cmbFio:DataSource =  DataProvider:GetUserList()
      304            .
      305         end.
      306         else do:
      307         cmbRegion:DropDownStyle = System.Windows.Forms.ComboBoxStyle:DropDown.
      308         cmbShop:DropDownStyle = System.Windows.Forms.ComboBoxStyle:DropDown.
      309         cmbCash:DropDownStyle = System.Windows.Forms.ComboBoxStyle:DropDown.
      310         end.
      311         ObjectToForm(tech-prol-pwd-obj).
      312         cmbShop:Focus().
      313         return.
      314      end method.
