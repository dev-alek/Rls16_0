      119      method private void cmbShop-SelectedValueChanged( input sender as System.Object, input e as System.EventArgs ):
      120         def var vSelectedItem as net-item no-undo.
      121         def var vItems as "System.Collections.Generic.List<System.Object>" no-undo.
      122         assign
      123            vSelectedItem = cast(cmbShop:SelectedItem,net-item)
      124         no-error.
      125         if valid-object(vSelectedItem) then
      126         do:
      127            assign
      128               lblShop:Text = vSelectedItem:Desctiption
      129               vItems = DataProvider:GetCashDeskList(vSelectedItem:Value)
      130            .
      131            if vItems:Count = 0 then
      132            do:
      133               vItems:Add(new net-item()).
      134               cmbCash:DataSource = vItems.
      135            end.
      136            else
      137               cmbCash:DataSource = vItems.
      138         end.
      139         return.
      140      end method.
      141           @VisualDesigner.
      142           method private void cmbShop_Validating( input sender as System.Object, input e as System.ComponentModel.CancelEventArgs ):
      143                   def var vSurr as char no-undo.
      144                   def var vCombo as System.Windows.Forms.ComboBox no-undo.
      145                   def var vNetItem as utl.net-item no-undo.
      146                   main:
      147                   do on error undo, throw:
      148                      assign
      149               vCombo = cast(sender,System.Windows.Forms.ComboBox)
      150               vSurr = DataProvider:GetShopSurrogate(vCombo:text)
      151            .
      152                   if vSurr = "" then
      153                   do:
      154                      System.Windows.Forms.MessageBox:Show(
      155                  "Нет такого кода магазина",
      156                  "Внимание!",
      157                  System.Windows.Forms.MessageBoxButtons:OK,
      158                  System.Windows.Forms.MessageBoxIcon:Error).
      159                      e:Cancel = yes.
      160                      leave main.
      161            end.
      162            vNetItem = DataProvider:GetShop(vSurr).
      163            if valid-object(vNetItem) then
      164            do:
      165               assign
      166                  vCombo:SelectedValue = vNetItem
      167                  vCombo:Text = vNetItem:DisplayName
      168                  lblShop:Text = vNetItem:Desctiption
      169               .
      170            end.
      171         end.
      172                   return.
      173           end method.
