       73           method private void btnGenerate_Click( input sender as System.Object, input e as System.EventArgs ):
       74         def var vSelectedItem as net-item no-undo.
       75         main:
       76         do on error undo, throw:
       77            assign
       78               vSelectedItem = cast(cmbShop:SelectedItem,net-item)
       79            no-error.
       80            if not valid-object(vSelectedItem) then
       81            do:
       82            end.
       83                   ValidateForm().
       84            label8:Text = string(new gpwd():gen-pwd(
       85               int64(cast(cmbShop:SelectedItem,net-item):DisplayName),
       86               int64(cast(cmbCash:SelectedItem,net-item):DisplayName),
       87               date(replace(mtbDate:Text,",",".")),
       88               cmbTimeBeg:Text,
       89               cmbTimeEnd:Text)).
       90            this-object:tech-prol-pwd-obj = new tech-prol-pwd().
       91            tech-prol-pwd-obj:f-user = DataProvider:GetUserLogin().
       92            FormToObject(tech-prol-pwd-obj).
       93            new repoPwd(tech-prol-pwd-obj):Save().
       94            catch vErr as ValidateError :
       95               System.Windows.Forms.MessageBox:Show(
       96                  vErr:GetMessage(1),
       97                  "Внимание!",
       98                  System.Windows.Forms.MessageBoxButtons:OK,
       99                  System.Windows.Forms.MessageBoxIcon:Error).
      100            end catch.
      101         end.
      102           end method.
