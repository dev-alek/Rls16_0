      689      method public static utl.gpwdfrm GetObject(
      690         iState as character,
      691         iPwd as class tech-prol-pwd):
      692         return new gpwdfrm(iState,iPwd).
      693      end method.
      694      method public void EnableDisable():
      695         main:
      696         do:
      697            case this-object:State:
      698               when "View" then EnableDisableForView().
      699               when "Add" or
      700               when "Edit" then EnableDisableForAddEdit().
      701            end case.
      702         end.
      703      end method.
      704      method public void EnableDisableForView():
      705         assign
      706            btnGenerate:Enabled     = no
      707            btnGenerate:visible     = no
      708            cmbTimeBeg:Enabled      = no
      709            cmbTimeEnd:Enabled      = no
      710            cmbShop:Enabled         = no
      711            cmbCash:Enabled         = no
      712            dateTimePicker1:Enabled = no
      713            dateTimePicker1:visible = no
      714            cmbFio:Enabled          = no
      715            rbtnOnce:Enabled        = no
      716            rbtnInterval:Enabled    = no
      717            btnFio:enabled          = no
      718            btnFio:visible          = no
      719            mtbDate:enabled         = no
      720            .
      721      end method.
      722      method public void EnableDisableForAddEdit():
      723         assign
      724            btnGenerate:Enabled     = yes
      725            cmbShop:Enabled         = yes
      726            cmbCash:Enabled         = yes
      727            dateTimePicker1:Enabled = yes
      728            cmbFio:Enabled          = yes
      729            rbtnOnce:Enabled        = yes
      730            rbtnInterval:Enabled    = yes
      731            label8:Visible          = yes
      732            btnToBuff:Visible       = yes
      733            btnToBuff:Enabled       = yes
      734            btnFio:enabled          = yes
      735            .
      736         if rbtnOnce:Checked then
      737            DisableTimes().
      738         else
      739            EnableTimes().
      740      end method.
      741      method public void EnableTimes():
      742         assign
      743            cmbTimeBeg:Enabled = yes
      744            cmbTimeEnd:Enabled = yes
      745            .
      746      end method.
      747      method public void DisableTimes():
      748         assign
      749            cmbTimeBeg:Enabled = no
      750            cmbTimeEnd:Enabled = no
      751            .
      752      end method.
      753      method public void ClearTimes():
      754         assign
      755            cmbTimeEnd:Text = ""
      756            .
      757      end method.
      758      method public void FormToObject(iObj as class tech-prol-pwd):
      759         def var vNow as datetime no-undo.
      760         assign
      761            vNow = now
      762            iObj:f-beg-time = cmbTimeBeg:Text
      763            iObj:f-end-time = cmbTimeEnd:Text
      764            iObj:f-host = System.Net.Dns:GetHostName()
      765            iObj:cash-desk-surr = cast(cmbCash:SelectedItem,utl.net-item):value
      766            iObj:shop-surr = cast(cmbShop:SelectedItem,utl.net-item):value
      767            iObj:f-date = date(replace(mtbDate:text,",","."))
      768            iObj:f-time = vNow
      769            iObj:f-fio = cmbFio:Text
      770            iObj:f-pwd-type = if rbtnOnce:Checked then "Р" else "И"
      771            iObj:f-pwd = label8:Text
      772         .
      773      end method.
      774      method public void ObjectToForm(iObj as class tech-prol-pwd):
      775         def var vNetItem as class net-item no-undo.
      776         assign
      777            cmbTimeBeg:Text = iObj:f-beg-time
      778            cmbTimeEnd:Text = iObj:f-end-time
      779            cmbFio:Text = iObj:f-fio
      780            label8:Text = iObj:f-pwd
      781         .
      782         if tech-prol-pwd-obj:f-pwd-type = "Р" then
      783            rbtnOnce:Checked = yes.
      784         else
      785            rbtnInterval:Checked = yes.
      786         vNetItem = DataProvider:GetShop(iObj:shop-surr).
      787         if valid-object(vNetItem) then
      788         do:
      789            assign
      790               cmbShop:SelectedValue = vNetItem
      791               cmbShop:Text = vNetItem:DisplayName
      792               lblShop:Text = vNetItem:Desctiption
      793            .
      794         end.
      795         vNetItem = DataProvider:GetCashDesk(iObj:cash-desk-surr).
      796         if valid-object(vNetItem) then
      797         do:
      798            assign
      799               cmbCash:SelectedValue = vNetItem
      800               cmbCash:Text = vNetItem:DisplayName
      801            .
      802         end.
      803         define variable vDate as date no-undo.
      804         vDate = if iObj:f-date = ? then today else iObj:f-date.
      805         dateTimePicker1:value = datetime(vDate).
      806         mtbDate:text = string(vDate,"99.99.99").
      807      end method.
      808      method public void ValidateForm():
      809         def var vShop as int64 no-undo.
      810         DataProvider:ValidateShop(cmbShop:Text, cmbShop).
      811         DataProvider:ValidateCashDesk(
      812            DataProvider:GetShopSurrogate(cmbShop:Text),
      813            cmbCash:Text,
      814            cmbCash).
      815         if rbtnInterval:Checked then
      816         do:
      817            if cmbTimeBeg:Text = "" then
      818            do:
      819               cmbTimeBeg:Focus().
      820               undo, throw new ValidateError("Не указано время начала техпролива",-1).
      821            end.
      822            if cmbTimeEnd:Text = "" then
      823            do:
      824               cmbTimeEnd:Focus().
      825               undo, throw new ValidateError("Не указано время окончания техпролива",-1).
      826            end.
      827            if cmbTimeBeg:text > cmbTimeEnd:text then do:
      828               cmbTimeEnd:Focus().
      829               undo, throw new ValidateError("Время начала позже времени конца",-1).
      830            end.
      831         end.
      832         ValidateTimes(cmbTimeBeg).
      833         ValidateTimes(cmbTimeEnd).
      834         if cmbFio:Text = "" then
      835         do:
      836            cmbFio:Focus().
      837            undo, throw new ValidateError("Не указано ФИО заказчика техпролива",-1).
      838         end.
      839      end method.
      840      method public void ValidateTimes(iComboBox as System.Windows.Forms.ComboBox):
      841         define variable vDigit as int64 no-undo.
      842         if num-entries(iComboBox:Text, ":") <> 2 then
      843         do:
      844            iComboBox:Focus().
      845            undo, throw new ValidateError("Введено некорректное время",-1).
      846         end.
      847         assign
      848            vDigit = int64(entry(1,iComboBox:Text,":"))
      849         no-error.
      850         if error-status:error or
      851            not (vDigit >= 0 and vDigit <= 23) then
      852         do:
      853            iComboBox:Focus().
      854            undo, throw new ValidateError("Введено некорректное время",-1).
      855         end.
      856         assign
      857            vDigit = int64(entry(2,iComboBox:Text,":"))
      858         no-error.
      859         if error-status:error or
      860            not (vDigit = 0 or vDigit = 30) then
      861         do:
      862            iComboBox:Focus().
      863            undo, throw new ValidateError("Введено некорректное время",-1).
      864         end.
      865      end method.
      866      destructor public gpwdfrm ( ):
      867      end destructor.
      868   end class.
