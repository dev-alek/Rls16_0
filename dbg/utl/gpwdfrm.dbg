      265         do:
      266            assign
      267               cmbShop:DataSource = DataProvider:GetShopList()
      268               cmbFio:DataSource =  DataProvider:GetUserList()
      269            .
      270         end.
      271         ObjectToForm(tech-prol-pwd-obj).
      272         cmbShop:Focus().
      273         return.
