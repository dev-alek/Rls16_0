        1   block-level on error undo, throw.
        2   define variable p-install as logical   no-undo init false .
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: exp-ggr.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: utl/exp-ggr.p $":U .
        8   define variable vss-description as character no-undo initial "Экспорт групп товаров".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define variable vss-include-info1 as character format "X(65)" no-undo
      318   initial "@(#)$Workfile$ $Revision$".
      319   define temp-table temp_grplib_grp no-undo
      320       field sel           as character
      321       field nabor         as character
      322       field full-name     as character
      323       field print-code    as character
      324       field sort-name     as character
      325       field node-code     as integer
      326       field upper-code    as integer
      327       field calc-method   as character
      328       field round-method  as character
      329       field increase-pc   as decimal
      330       field min-marg      as character
      331       field max-marg      as character
      332       field cli-type      as character
      333       field cli-code      as integer
      334       field notcorr      as character
      335       field name          as character
      336       field level         as integer
      337       field mark          as character
      338       index pi is primary unique sort-name
      339       index fn full-name
      340       index nc is unique node-code
      341       index sl sel
      342       index uc upper-code
      343   .
      344   define temp-table temp_grplib_found-grp no-undo
      345       field full-name   as character
      346       field sort-name   as character
      347       field node-code   as integer
      348       field level       as integer
      349       field is-terminal as logical
      350       index pi is primary unique sort-name
      351       index fn full-name
      352       index lv level
      353       index it is-terminal
      354   .
      355   define temp-table temp_found-result-nodelist no-undo
      356       field node-code     as recid
      357       field processed     as logical
      358       field sort-name     as character
      359       field full-name     as character
      360       index pi is primary unique node-code
      361       index ps processed
      362   .
      363   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      364   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      365   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      366   procedure grplib-get-parameters :
      367   define input parameter p-store-type     as character        no-undo.
      368   define input parameter p-store-code     as integer          no-undo.
      369   do
      370   on error undo, return error
      371   :
      372       assign
      373           v-grplib-not-fill-extra-info = no
      374       .
      375   end.
      376   end procedure.
      377   procedure grplib-get-sort-name :
      378   do
      379   on error undo, return error
      380   :
      381   define input parameter p-node-code  as integer      no-undo.
      382   define output parameter p-sort-name as character    no-undo.
      383       define variable v-upper-code    as integer           no-undo.
      384       define buffer buf_gds-grp       for ub.gds-grp.
      385       define buffer buf_upper_gds-grp for ub.gds-grp.
      386       find first buf_gds-grp no-lock
      387            where buf_gds-grp.node-code = p-node-code
      388       no-error.
      389       if not available buf_gds-grp
      390       then do:
      391           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      392       end.
      393       assign
      394           p-sort-name  = ""
      395           v-upper-code = 1
      396       .
      397       do while buf_gds-grp.upper-code <> 0
      398       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      399       :
      400           assign
      401               p-sort-name  = buf_gds-grp.node-name
      402                            + (if p-sort-name <> "" then chr(2) else "")
      403                            + p-sort-name
      404               v-upper-code = buf_gds-grp.upper-code
      405           .
      406           find first buf_gds-grp no-lock
      407                where buf_gds-grp.node-code = v-upper-code
      408           no-error.
      409           if not available buf_gds-grp
      410           then do:
      411               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      412                                   + string( v-upper-code )
      413                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      414           end.
      415       end.
      416   end.
      417   end procedure.
      418   define variable vss-include-info2 as character format "X(65)" no-undo
      419   initial "@(#)$Workfile$ $Revision$".
      420   procedure grplib-get-full-name :
      421      define input parameter p-node-code  as integer      no-undo.
      422      define output parameter p-full-name as character    no-undo.
      423      do
      424   on error undo, return error
      425   :
      426       define variable v-upper-code    as integer           no-undo.
      427       define buffer buf_gds-grp       for ub.gds-grp.
      428       define buffer buf_upper_gds-grp for ub.gds-grp.
      429       find first buf_gds-grp no-lock
      430            where buf_gds-grp.node-code = p-node-code
      431       no-error.
      432       if not available buf_gds-grp
      433       then do:
      434           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      435       end.
      436       assign
      437           p-full-name  = ""
      438           v-upper-code = 1
      439       .
      440       do while buf_gds-grp.upper-code <> 0
      441       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      442       :
      443           assign
      444               p-full-name  = buf_gds-grp.node-name
      445                            + (if p-full-name <> "" then chr(47) else "")
      446                            + p-full-name
      447               v-upper-code = buf_gds-grp.upper-code
      448           .
      449           find first buf_gds-grp no-lock
      450                where buf_gds-grp.node-code = v-upper-code
      451           no-error.
      452           if not available buf_gds-grp
      453           then do:
      454               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      455                                   + string( v-upper-code )
      456                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      457           end.
      458       end.
      459       assign
      460       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      461       .
      462   end.
      463   end .
      464   procedure grplib-get-node-from-full-name :
      465   define input parameter p-full-name as character no-undo .
      466   define output parameter p-node-code as integer no-undo .
      467   define variable v-ii as integer no-undo .
      468   define variable v-upper-code as integer no-undo .
      469   define variable v-root-code as integer no-undo .
      470   define variable v-entry as character no-undo .
      471   define buffer buf_gds-grp       for ub.gds-grp.
      472   do
      473   on error undo, return error
      474   :
      475     find first buf_gds-grp no-lock
      476         where buf_gds-grp.upper-code = 0
      477     no-error .
      478     if not available buf_gds-grp
      479     then do:
      480         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      481     end.
      482     else do:
      483       assign
      484       v-root-code = buf_gds-grp.node-code
      485       .
      486     end.
      487     v-upper-code = v-root-code.
      488     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      489       assign
      490       v-entry = entry(v-ii, p-full-name, chr(47)).
      491       if v-entry = '' then leave.
      492       find first buf_gds-grp no-lock where
      493                 buf_gds-grp.node-name = v-entry
      494             and buf_gds-grp.upper-code = v-upper-code
      495             no-error.
      496       if not available buf_gds-grp then do:
      497         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      498       end.
      499       else do:
      500         p-node-code = buf_gds-grp.node-code.
      501         v-upper-code = buf_gds-grp.node-code.
      502       end.
      503     end.
      504   end.
      505   end .
      506   procedure grplib-get-root-code :
      507   do
      508   on error undo, return error
      509   :
      510   define output parameter p-root-code as integer      no-undo.
      511       define buffer buf_gds-grp       for ub.gds-grp.
      512       find first buf_gds-grp no-lock
      513           where buf_gds-grp.upper-code = 0
      514       no-error .
      515       if not available buf_gds-grp
      516       then do:
      517           undo, return error .
      518       end.
      519       else do:
      520           assign
      521               p-root-code = buf_gds-grp.node-code
      522           .
      523       end.
      524   end.
      525   end procedure.
      526   procedure grplib-find-grp-by-full-name :
      527   do
      528   on error undo, return error
      529   :
      530   define input parameter p-search-name  as character    no-undo.
      531   define input parameter p-fill-path    as logical      no-undo.
      532   define output parameter p-found       as logical      no-undo.
      533       define variable v-upper-code    as integer          no-undo.
      534       define variable v-counter       as integer           no-undo.
      535       define variable v-level         as integer           no-undo.
      536       define variable v-full-name     as character         no-undo.
      537       define variable v-sort-name     as character         no-undo.
      538       define buffer buf_gds-grp       for ub.gds-grp.
      539       assign
      540           p-search-name = replace( p-search-name, chr(47), chr(2) )
      541       .
      542       run grplib-get-root-code ( output v-upper-code ) no-error .
      543       if error-status :error
      544       then do:
      545           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      546       end.
      547       assign
      548           v-full-name  = ""
      549           v-level      = num-entries( p-search-name, chr(2) )
      550       .
      551       for each temp_grplib_found-grp
      552       :
      553           delete temp_grplib_found-grp.
      554       end.
      555       start-name-analyze:
      556       do v-counter = 1 to v-level
      557       :
      558           if v-counter < v-level
      559           then do:
      560               find first buf_gds-grp no-lock
      561                    where buf_gds-grp.upper-code = v-upper-code
      562                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      563               no-error .
      564               if not available buf_gds-grp
      565               then do:
      566                   assign
      567                       v-full-name  = p-search-name
      568                       v-sort-name  = p-search-name
      569                   .
      570                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      571               end.
      572               else do:
      573                   assign
      574                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      575                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      576                       v-upper-code = buf_gds-grp.node-code
      577                   .
      578                   if p-fill-path = yes
      579                   then do:
      580                       create temp_grplib_found-grp.
      581                       assign
      582                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      583                           temp_grplib_found-grp.sort-name = v-sort-name
      584                           temp_grplib_found-grp.node-code = v-upper-code
      585                           temp_grplib_found-grp.level     = v-counter
      586                       .
      587                   end.
      588               end.
      589           end.
      590           else do:
      591               for each buf_gds-grp no-lock
      592                  where buf_gds-grp.upper-code = v-upper-code
      593                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      594               :
      595                   assign
      596                       p-found = yes
      597                   .
      598                   create temp_grplib_found-grp.
      599                   assign
      600                       temp_grplib_found-grp.full-name = v-full-name
      601                                                           + (if v-full-name = "" then "" else chr(47) )
      602                                                           + buf_gds-grp.node-name + chr(47)
      603                       temp_grplib_found-grp.sort-name = v-sort-name
      604                                                           + ( if v-sort-name = "" then "" else chr(2) )
      605                                                           + buf_gds-grp.node-name
      606                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      607                       temp_grplib_found-grp.level     = v-level
      608                   .
      609               end.
      610               if p-found = no
      611               then do:
      612                   assign
      613                       v-full-name  = p-search-name
      614                       v-sort-name  = p-search-name
      615                   .
      616                   for each temp_grplib_found-grp
      617                   :
      618                       delete temp_grplib_found-grp.
      619                   end.
      620                   assign
      621                       p-found = no
      622                   .
      623               end.
      624           end.
      625       end.
      626   end.
      627   end procedure.
      628   procedure grplib-find-all-subgroup :
      629   do
      630   on error undo, return error
      631   :
      632   define input parameter p-start-node-code    as integer      no-undo.
      633   define input parameter p-terminal-only      as logical      no-undo.
      634       define variable v-start-full-name   as character     no-undo.
      635       define variable v-start-sort-name   as character     no-undo.
      636       define variable v-not-found         as logical       no-undo.
      637       define variable v-is-terminal       as logical       no-undo.
      638       define buffer buf_gds-grp           for ub.gds-grp.
      639       create temp_found-result-nodelist.
      640       assign
      641           temp_found-result-nodelist.node-code = p-start-node-code
      642           temp_found-result-nodelist.processed = no
      643       .
      644       run grplib-get-full-name in this-procedure (
      645             input p-start-node-code
      646           , output v-start-full-name
      647       ).
      648       run grplib-get-full-name in this-procedure (
      649             input p-start-node-code
      650           , output v-start-sort-name
      651       ).
      652       process-nodes:
      653       do while yes
      654       :
      655           find first temp_found-result-nodelist
      656                where temp_found-result-nodelist.node-code = p-start-node-code
      657           .
      658           assign
      659               temp_found-result-nodelist.processed = yes
      660           .
      661           for each buf_gds-grp no-lock
      662              where buf_gds-grp.upper-code = p-start-node-code
      663           on error undo, return error
      664           :
      665               run grplib-is-terminal in this-procedure (
      666                     input buf_gds-grp.node-code
      667                   , output v-is-terminal
      668               ).
      669               if v-is-terminal = yes
      670               then do:
      671                   create temp_grplib_found-grp.
      672                   assign
      673                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      674                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      675                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      676                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      677                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      678                       temp_grplib_found-grp.is-terminal = yes
      679                   .
      680               end.
      681               else do:
      682                   create temp_found-result-nodelist.
      683                   assign
      684                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      685                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      686                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      687                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      688                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      689                       temp_found-result-nodelist.processed = no
      690                   .
      691                   if p-terminal-only = no
      692                   then do:
      693                       create temp_grplib_found-grp.
      694                       assign
      695                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      696                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      697                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      698                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      699                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      700                           temp_grplib_found-grp.is-terminal = no
      701                       .
      702                   end.
      703               end.
      704           end.
      705           find first temp_found-result-nodelist
      706                where temp_found-result-nodelist.processed = no
      707           no-error.
      708           if not available temp_found-result-nodelist
      709           then do:
      710               leave process-nodes.
      711           end.
      712           else do:
      713               assign
      714                   p-start-node-code = temp_found-result-nodelist.node-code
      715                   v-start-full-name = temp_found-result-nodelist.full-name
      716                   v-start-sort-name = temp_found-result-nodelist.sort-name
      717               .
      718           end.
      719       end.
      720   end.
      721   end procedure.
      722   procedure grplib-expand-name :
      723   define input parameter p-start-name as character        no-undo.
      724   define output parameter p-end-name  as character        no-undo.
      725       define variable v-is-terminal   as logical      no-undo.
      726       define variable v-found         as character    no-undo.
      727       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      728   do
      729   for buf_temp_grplib_found-grp
      730   on error undo, return error
      731   :
      732       run grplib-find-grp-by-full-name in this-procedure (
      733             input p-start-name
      734           , input no
      735           , output v-found
      736       ) no-error.
      737       run grplib-get-max-substring in this-procedure (
      738                   input length( p-start-name )
      739                 , output p-end-name
      740       ) no-error .
      741       if error-status :error
      742       then do:
      743           assign
      744               p-end-name = ""
      745           .
      746       end.
      747       else do:
      748           find first temp_grplib_found-grp
      749               where temp_grplib_found-grp.full-name = p-end-name
      750           no-error.
      751           if available temp_grplib_found-grp
      752           then do:
      753               find first buf_temp_grplib_found-grp
      754                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      755                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      756               no-error.
      757               if not available buf_temp_grplib_found-grp
      758               then do:
      759                   run grplib-is-terminal in this-procedure (
      760                       input temp_grplib_found-grp.node-code
      761                       , output v-is-terminal
      762                   ).
      763               end.
      764           end.
      765       end.
      766   end.
      767   end procedure.
      768   procedure grplib-get-max-substring :
      769   do
      770   on error undo, return error
      771   :
      772   define input parameter p-min-substring-length   as integer      no-undo.
      773   define output parameter p-substring             as character    no-undo.
      774           define variable v-char-counter  as integer           no-undo.
      775           define variable v-current-char  as character         no-undo.
      776           define variable v-names-counter  as integer           no-undo.
      777           define variable v-base-string   as character         no-undo.
      778           assign
      779               v-char-counter  = p-min-substring-length
      780           .
      781           find first temp_grplib_found-grp no-error.
      782           if not available temp_grplib_found-grp
      783           then do:
      784               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      785           end.
      786           else do:
      787               assign
      788                   v-base-string  = temp_grplib_found-grp.full-name
      789                   v-char-counter = 0
      790               .
      791               counter-block:
      792               do while yes
      793               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      794               :
      795                   assign
      796                       v-char-counter  = v-char-counter + 1
      797                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      798                       v-names-counter = 0
      799                   .
      800                   compare-block:
      801                   for each temp_grplib_found-grp
      802                   :
      803                       assign
      804                           v-names-counter = v-names-counter + 1
      805                       .
      806                       if v-names-counter = 1
      807                       then do:
      808                           next compare-block.
      809                       end.
      810                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      811                       then do:
      812                           leave counter-block.
      813                       end.
      814                   end.
      815                   if v-names-counter = 1
      816                   then do:
      817                       assign
      818                           p-substring = v-base-string
      819                       .
      820                       return.
      821                   end.
      822               end.
      823               assign
      824                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      825               .
      826           end.
      827   end.
      828   end procedure.
      829   procedure grplib-is-terminal :
      830   do
      831   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      832   :
      833   define input parameter p-node-code      as integer      no-undo.
      834   define output parameter p-is-terminal   as logical      no-undo.
      835       define buffer buf_gds-grp       for ub.gds-grp.
      836       find first buf_gds-grp no-lock
      837           where buf_gds-grp.upper-code = p-node-code
      838       no-error .
      839       if not available buf_gds-grp
      840       then do:
      841           assign
      842               p-is-terminal = yes
      843           .
      844       end.
      845       else do:
      846           assign
      847               p-is-terminal = no
      848           .
      849       end.
      850   end.
      851   end procedure.
      852   procedure grplib-have-goods :
      853   do
      854   on error undo, return error
      855   :
      856   define input parameter p-node-code      as integer      no-undo.
      857   define output parameter p-have-goods   as logical      no-undo.
      858       define buffer buf_goods         for ub.goods.
      859       find first buf_goods no-lock
      860            where buf_goods.grp-code = p-node-code
      861       no-error .
      862       if available buf_goods
      863       then do:
      864           assign
      865               p-have-goods = yes
      866           .
      867       end.
      868       else do:
      869           assign
      870               p-have-goods = no
      871           .
      872       end.
      873   end.
      874   end procedure.
      875   procedure grplib-find-by-substring :
      876   do
      877   on error undo, return error
      878   :
      879   define input parameter p-start-code         as integer      no-undo.
      880   define input parameter p-full-search-string as character    no-undo.
      881   define output parameter p-found-code        as integer      no-undo.
      882   define output parameter p-full-name         as character    no-undo.
      883       define variable v-start-code     as integer           no-undo.
      884       define variable v-found          as logical  init no  no-undo.
      885       define buffer buf_gds-grp       for ub.gds-grp.
      886       search-grp:
      887       for each buf_gds-grp no-lock
      888           where buf_gds-grp.node-code > p-start-code
      889       :
      890           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      891           then do:
      892               assign
      893                   p-found-code = buf_gds-grp.node-code
      894                   v-found      = yes
      895               .
      896               run grplib-get-full-name in this-procedure (
      897                     input p-found-code
      898                   , output p-full-name
      899               ) no-error .
      900               if error-status :error
      901               then do:
      902                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      903               end.
      904               leave search-grp.
      905           end.
      906       end.
      907       if v-found = yes
      908       then do:
      909       end.
      910       else do:
      911           assign
      912               p-full-name  = ""
      913               p-found-code = 0
      914           .
      915       end.
      916   end.
      917   end procedure.
      918   procedure grplib-analyze-grp-name :
      919   do
      920   on error undo, return error
      921   :
      922   define input parameter p-grp-name       as character            no-undo.
      923   define input parameter p-upper-code     as integer              no-undo.
      924   define output parameter p-error-message as character init ""    no-undo.
      925       define variable v-char-list     as character    no-undo.
      926       define variable v-char-counter  as integer      no-undo.
      927       define variable v-full-name     as character    no-undo.
      928       if p-grp-name = "" then do:
      929           assign
      930               p-error-message = "Название группы не может быть пустым.".
      931           .
      932       end.
      933       else do:
      934           assign
      935               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      936           .
      937           do v-char-counter = 1 to num-entries( v-char-list )
      938           :
      939               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      940               then do:
      941                   assign
      942                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      943                   .
      944                   return.
      945               end.
      946           end.
      947           if p-upper-code > 0
      948           then do:
      949               run grplib-get-full-name in this-procedure (
      950                     input p-upper-code
      951                   , output v-full-name
      952               ) no-error .
      953               if error-status :error
      954               then do:
      955                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      956               end.
      957               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      958               then do:
      959                   assign
      960                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      961                   .
      962               end.
      963           end.
      964       end.
      965   end.
      966   end procedure.
      967   procedure grplib-get-lvl-num :
      968   define input parameter p-node-code  as integer      no-undo.
      969   define output parameter p-lvl-num   as integer      no-undo.
      970       define variable v-full-name    as character    no-undo.
      971   do
      972   on error undo, return error
      973   :
      974       run grplib-get-full-name in this-procedure (
      975             input p-node-code
      976           , output v-full-name
      977       ).
      978       assign
      979           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      980       .
      981       if p-lvl-num = -1
      982       then do:
      983           assign
      984               p-lvl-num = 0
      985           .
      986       end.
      987   end.
      988   end procedure.
      989   define stream sexp .
      990   define variable f-name     as character no-undo .
      991   define variable v-ok       as logical   no-undo .
      992   define variable v-ind      as integer   no-undo .
      993   define variable v-grp-name as character no-undo .
      994   if p-install = false then do:
      995     assign
      996       v-ok = false
      997     .
      998     message
      999       "Экспорт групп товаров." skip
     1000       "Продолжить?" skip
     1001       view-as alert-box question buttons ok-cancel update v-ok.
     1002     if v-ok <> true then do:
     1003       return .
     1004     end.
     1005   end.
     1006   assign
     1007     f-name = 'gds-grp.ggr'
     1008   .
     1009   if p-install = false then do:
     1010     system-dialog get-file f-name
     1011       filters "Файл групп товаров *.ggr" "*.ggr"
     1012       ask-overwrite
     1013       save-as
     1014       use-filename
     1015       update v-ok
     1016       default-extension "ggr".
     1017     if v-ok <> true then do:
     1018       return .
     1019     end.
     1020   end.
     1021   output stream sexp to value (f-name) .
     1022   export stream sexp "GOODS_GRP_1_0" .
     1023   output stream sexp close .
     1024   run waitfram-show in this-procedure
     1025     (input "Ждите..."
     1026     ).
     1027   for each gds-grp no-lock
     1028     where gds-grp.upper-code <> 0
     1029   :
     1030     assign
     1031       v-ind = v-ind + 1
     1032     .
     1033     run grplib-get-full-name in this-procedure (
     1034                                                    input  gds-grp.node-code
     1035                                                 ,output v-grp-name
     1036                                                 ) .
     1037     run waitfram-show in this-procedure
     1038       (input "Ждите..."
     1039       ).
     1040     output stream sexp to value (f-name) append .
     1041     export stream sexp v-grp-name .
     1042     output stream sexp close .
     1043     run waitfram-hide in this-procedure .
     1044   end.
     1045   if p-install = false then do:
     1046     message
     1047       "Экспорт групп товаров закончен" skip
     1048       "Экспортировано групп" v-ind skip
     1049       view-as alert-box information .
     1050   end.
