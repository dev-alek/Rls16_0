      920   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921     define variable v-cntxt-db-num        as integer   no-undo .
      922     define variable v-cntxt-userid        as character no-undo .
      923     define variable v-cntxt-level         as character no-undo .
      924     define variable v-cntxt-host-code-obj as integer   no-undo .
      925     define variable v-cntxt-obj-type      as character no-undo .
      926     define variable v-cntxt-obj-code      as integer   no-undo .
      927     define variable v-cntxt-db-num-obj    as integer   no-undo .
      928     define variable v-cntxt-is-admin      as logical   no-undo .
      929   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      930   define variable v-waitfram-action01         as character   no-undo .
      931   define variable v-waitfram-action02         as character   no-undo .
      932   define variable v-waitfram-action03         as character   no-undo .
      933   define variable mWaitFramTextBeg            as character   no-undo.
      934   define variable mWaitFramTextEnd            as character   no-undo.
      935   define variable mWaitFramView               as logical     no-undo.
      936   define variable mWaitProcEvent              as logical     no-undo init yes.
      937   define variable mWaitFramInterval           as integer     no-undo init 1 .
      938   define variable mWaitFramStop               as logical     no-undo.
      939   define variable mWaitFramStopUser           as logical     no-undo.
      940   define variable mWaitFramStopTimeOut        as logical     no-undo.
      941   define variable mWaitFramStartProc          as datetime-tz no-undo.
      942   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      943   define button B-WaitFramStop auto-end-key
      944        label "Стоп"
      945        size 10 by 1 tooltip "Остоновить процесс".
      946   define button B-viewProcInfo
      947        label "Информация"
      948        size 15 by 1 tooltip "Информация о процесс".
      949   define frame waitfram
      950     v-waitfram-action01 format "x(72)" no-label skip
      951     v-waitfram-action02 format "x(72)" no-label skip
      952     v-waitfram-action03 format "x(72)" no-label skip
      953     B-viewProcInfo
      954     B-WaitFramStop at row 4 col 30
      955     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      956     .
      957   define new global shared variable mBatchMode as logical no-undo init ?.
      958   define variable mFramBachModHandle as handle no-undo.
      959   mFramBachModHandle = frame waitfram:handle.
      960   define variable mFameOldVis as logical no-undo.
      961   define variable mVisCUrentVin as logical no-undo.
      962   if session:batch-mode
      963   then
      964      mBatchMode = yes.
      965   if mBatchMode = ? then do:
      966     mVisCUrentVin = current-window:visible.
      967     mFameOldVis = mFramBachModHandle:visible.
      968     mFramBachModHandle:visible  = yes.
      969     mBatchMode = mFramBachModHandle:visible ne yes.
      970     mFramBachModHandle:visible = mFameOldVis.
      971     current-window:visible = mVisCUrentVin.
      972   end.
      973    if  log-manager:logfile-name ne ?
      974     then DO:
      975         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      976         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      977         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      978     end.
      979   on choose of B-WaitFramStop in frame waitfram
      980   do:
      981     mWaitFramStop = yes.
      982     mWaitFramStopUser = yes.
      983   end.
      984   function waitfram-check-timeout returns logical():
      985      define variable vtime as int64 no-undo.
      986      if mWaitFramStopTimeOut
      987      then
      988         return yes.
      989      vtime = ( now - mWaitFramStartProc ) / 1000 .
      990      if     mWaitFramTimeOut ne ?
      991         and mWaitFramTimeOut ne 0
      992         and mWaitFramTimeOut lt vtime
      993      then do:
      994         mWaitFramStopTimeOut = yes.
      995      end.
      996      return mWaitFramStopTimeOut.
      997   end.
      998   procedure waitfram-hide :
      999     if not session:batch-mode
     1000     then do
     1001     on error undo, return error return-value
     1002     :
     1003       pause 0 before-hide .
     1004       if not mBatchMode then
     1005         hide frame waitfram .
     1006     if     not mWaitFramView
     1007        and mWaitProcEvent
     1008     then
     1009       process events .
     1010     end.
     1011   end procedure.
     1012   procedure waitfram-show :
     1013     define input  parameter p-message as character no-undo .
     1014     define variable v-left-margin as integer   no-undo .
     1015     if not session:batch-mode
     1016     then do
     1017     on error undo, return error return-value
     1018     :
     1019       if length(p-message) <= 70 then do:
     1020         assign
     1021           v-left-margin = integer((70 - length(p-message)) / 2)
     1022         .
     1023         assign
     1024           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1025         .
     1026         assign
     1027           v-waitfram-action01 = " "
     1028           v-waitfram-action02 = " "
     1029                                    + fill(" ", v-left-margin)
     1030                                    + p-message
     1031           v-waitfram-action03 = " "
     1032         .
     1033       end.
     1034       else do:
     1035         define variable vRindex1 as integer no-undo.
     1036         define variable vRindex2 as integer no-undo.
     1037         vRindex1 = r-index(p-message," ",70).
     1038         if vRindex1 = 0
     1039         then
     1040            vRindex1 = 70.
     1041         if length(p-message)  <= vRindex1 + 70 then do:
     1042           assign
     1043             v-waitfram-action01 = " "
     1044             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1045             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1046           .
     1047         end.
     1048         else do:
     1049           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1050           if vRindex2 <= vRindex1
     1051           then
     1052              vRindex2 = vRindex1 + 70.
     1053           assign
     1054             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1055             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1056             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1057           .
     1058         end.
     1059       end.
     1060       B-viewProcInfo:visible   in frame waitfram = no.
     1061       B-viewProcInfo:sensitive in frame waitfram = no.
     1062       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1063       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1064       if  (   mWaitFramView
     1065          or  mWaitProcEvent)
     1066          and not mBatchMode
     1067       then
     1068          display
     1069             v-waitfram-action01 skip
     1070             v-waitfram-action02 skip
     1071             v-waitfram-action03 skip
     1072          with frame waitfram .
     1073       if     mWaitFramView
     1074          then do:
     1075             if     mWaitFramInterval ne ?
     1076                and not mBatchMode
     1077             then
     1078                wait-for go of frame waitfram pause mWaitFramInterval.
     1079          end.
     1080          else
     1081             if     mWaitProcEvent
     1082                and not mBatchMode
     1083             then
     1084                process events .
     1085     end.
     1086   end procedure.
     1087      procedure waitfram-show-this:
     1088         define input  parameter iInterval as int64 no-undo.
     1089         define variable vtime as int64 no-undo.
     1090         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1091         mWaitFramInterval = iInterval.
     1092         run waitfram-show (substitute("&1&2 &3&4" ,
     1093                                       mWaitFramTextBeg ,
     1094                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1095                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1096                                       mWaitFramTextEnd
     1097                                      )
     1098                           ).
     1099      end.
     1100      procedure WaitFramRunPause:
     1101         define input  parameter iInterval as dec no-undo.
     1102         define variable vStart  as datetime-tz no-undo.
     1103         define variable vend    as datetime-tz no-undo.
     1104         define variable vint as int64 no-undo.
     1105         define variable vOk as logical no-undo.
     1106         vStart = now.
     1107         vend   = vStart.
     1108         publish "WaitFramPause" (iInterval,output vOk).
     1109         vend   =  now.
     1110         vint = vend - vStart.
     1111         vint = iInterval - vint / 1000.
     1112         if     not mWaitFramStop
     1113            and (   vint > 0
     1114                 or (    not vOk
     1115                     and iInterval eq ?
     1116                     )
     1117                 )
     1118         then
     1119            run waitfram-show-this (iInterval).
     1120         vend   =  now.
     1121         vint = vend - vStart.
     1122         vint = iInterval - vint / 1000.
     1123         if     not mWaitFramStop
     1124            and vint > 0
     1125         then do:
     1126            run gbl/pause.p (vint * 1000).
     1127         end.
     1128         if iInterval ne ?
     1129         then
     1130            publish "WaitFramStop".
     1131         waitfram-check-timeout().
     1132      end.
     1133      procedure WaitFramWaitFor:
     1134         define input  parameter iInterval as dec no-undo.
     1135         assign
     1136            mWaitFramStartProc   = now
     1137            mWaitFramStopUser    = no
     1138            mWaitFramStopTimeOut = no
     1139         .
     1140         block-wait:
     1141         do while not mWaitFramStop:
     1142            run WaitFramRunPause (iInterval).
     1143            if  waitfram-check-timeout()
     1144            then do:
     1145               leave block-wait.
     1146            end.
     1147         end.
     1148         run waitfram-hide.
     1149      end.
     1150   procedure waitfram-join :
     1151     define input  parameter p-line-1  as character no-undo .
     1152     define input  parameter p-line-2  as character no-undo .
     1153     define input  parameter p-line-3  as character no-undo .
     1154     define output parameter p-message as character no-undo .
     1155     do
     1156     on error undo, return error return-value
     1157     :
     1158       assign
     1159         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1160                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1161                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1162       .
     1163     end.
     1164   end procedure.
     1165   function waitfram-join-function returns character
     1166     (input p-line-1 as character
     1167     ,input p-line-2 as character
     1168     ,input p-line-3 as character
     1169     ).
     1170     define variable v-message as character no-undo .
     1171     run waitfram-join in this-procedure
     1172       (input  p-line-1
     1173       ,input  p-line-2
     1174       ,input  p-line-3
     1175       ,output v-message
     1176       ) .
     1177     return v-message .
     1178   end function .
