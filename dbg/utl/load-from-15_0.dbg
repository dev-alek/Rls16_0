      433   procedure cd-attr-value :
      434     define input  parameter p-db-num    like ub.cash-desk-attr.db-num        no-undo .
      435     define input  parameter p-obj-code  like ub.cash-desk-attr.obj-code      no-undo .
      436     define input  parameter p-pos-type  like ub.cash-desk-attr.pos-type      no-undo .
      437     define input  parameter p-cash-num  like ub.cash-desk-attr.cash-num      no-undo .
      438     define input  parameter p-ucode     like ub.cash-desk-attr.upper-attr-code      no-undo .
      439     define input  parameter p-code      like ub.cash-desk-attr.attr-code      no-undo .
      440     define output parameter p-character like ub.cash-desk-attr.attr-value-character    no-undo .
      441     define output parameter p-date      like ub.cash-desk-attr.attr-value-date         no-undo .
      442     define output parameter p-decimal   like ub.cash-desk-attr.attr-value-decimal      no-undo .
      443     define output parameter p-integer   like ub.cash-desk-attr.attr-value-integer      no-undo .
      444     define output parameter p-logical   like ub.cash-desk-attr.attr-value-logical      no-undo .
      445     define output parameter p-type      as character no-undo .
      446     do
