     1368        SIZE 38 BY 1 no-undo.
     1369   define button b-retry-file  DEFAULT
     1370        IMAGE-UP FILE "btn-down-arrow":U
     1371        IMAGE-DOWN FILE "btn-down-arrow":U
     1372        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1373        label ""
     1374        SIZE 2.5 BY 1.08.
     1375   DEFINE FRAME Dialog-Frame
     1376        B-OK AT ROW 1.2 COL 2
     1377        B-Cancel AT ROW 1.2 COL 12
     1378        v-addr AT ROW 2.4 COL 2 WIDGET-ID 2
     1379        v-cashdesk AT ROW 3.6 COL 3 WIDGET-ID 4
     1380        v-schem AT ROW 4.8 COL 3 WIDGET-ID 6
     1381        v-pumpdoc AT ROW 6 COL 3 WIDGET-ID 8
     1382        v-price AT ROW 7.2 COL 3 WIDGET-ID 10
     1383        v-file-path at row 8.4 col 2 WIDGET-ID 12
     1384        b-file at row 8.4 col 60
     1385        v-rest AT ROW 9.6 COL 3 WIDGET-ID 14
     1386        v-osn-fname at row 10.8 col 34 colon-aligned WIDGET-ID 16
     1387        b-osn-file at row 10.8 col 75
     1388        v-art-fname at row 12 col 34 colon-aligned WIDGET-ID 18
     1389        b-art-file at row 12 col 75
     1390        v-retry-fname at row 13.2 col 34 colon-aligned WIDGET-ID 20
     1391        b-retry-file at row 13.2 col 75
     1392        SPACE(2) SKIP(0.5)
     1393       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1394            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1395            TITLE "Загрузка данных из TH v15.0"
     1396            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
     1397   ASSIGN
     1398          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1399          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1400   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1401   DO:
     1402     APPLY "END-ERROR":U TO SELF.
     1403   END.
     1404   ON value-changed of v-price in FRAME Dialog-Frame
     1405   DO:
     1406     assign v-price.
     1407     assign v-schem.
     1408     if v-price or v-schem
     1409     then do :
     1410       enable v-file-path b-file with frame Dialog-Frame.
     1411     end.
     1412     else do :
     1413       disable v-file-path b-file with frame Dialog-Frame.
     1414     end.
     1415   END.
     1416   ON value-changed of v-schem in FRAME Dialog-Frame
     1417   DO:
     1418     assign v-schem.
     1419     assign v-price.
     1420     if v-price or v-schem
     1421     then do :
     1422       enable v-file-path b-file with frame Dialog-Frame.
     1423     end.
     1424     else do :
     1425       disable v-file-path b-file with frame Dialog-Frame.
     1426     end.
     1427   END.
     1428   ON value-changed of v-rest in FRAME Dialog-Frame
     1429   DO:
     1430     assign v-rest.
     1431     if v-rest then enable
     1432       v-osn-fname b-osn-file
     1433       v-art-fname b-art-file
     1434       v-retry-fname b-retry-file
     1435     with frame Dialog-Frame.
     1436     else disable
     1437       v-osn-fname b-osn-file
     1438       v-art-fname b-art-file
     1439       v-retry-fname b-retry-file
     1440     with frame Dialog-Frame.
     1441   END.
     1442   ON CHOOSE OF B-file IN FRAME Dialog-Frame
     1443   DO:
     1444     system-dialog get-file v-file-path
     1445       filters "Текстовые файлы (*.txt)" "*.txt",
     1446               "Все файлы (*.*)" "*.*"
     1447       title "Выберите файл соответсвий кодов товаров"
     1448       update glog
     1449     .
     1450     if glog
     1451     then do :
     1452       v-file-path:screen-value = v-file-path .
     1453     end.
     1454   END.
     1455   ON CHOOSE OF B-osn-file IN FRAME Dialog-Frame
     1456   DO:
     1457     system-dialog get-file v-osn-fname
     1458       filters "Текстовые файлы (*.txt)" "*.txt",
     1459               "Все файлы (*.*)" "*.*"
     1460       title "Выберите файл соответствия кодов поставщиков"
     1461       update glog
     1462     .
     1463     if glog then v-osn-fname:screen-value = v-osn-fname .
     1464   END.
     1465   ON CHOOSE OF B-art-file IN FRAME Dialog-Frame
     1466   DO:
     1467     system-dialog get-file v-art-fname
     1468       filters "Текстовые файлы (*.txt)" "*.txt",
     1469               "Все файлы (*.*)" "*.*"
     1470       title "Выберите файл соответствия кодов товаров"
     1471       update glog
     1472     .
     1473     if glog then v-art-fname:screen-value = v-art-fname .
     1474   END.
     1475   ON CHOOSE OF B-retry-file IN FRAME Dialog-Frame
     1476   DO:
     1477     system-dialog get-file v-retry-fname
     1478       filters "Текстовые файлы (*.txt)" "*.txt",
     1479               "Все файлы (*.*)" "*.*"
     1480       title "Имя файла для повторной загрузки ошибочных строк"
     1481       update glog
     1482     .
     1483     if glog then v-retry-fname:screen-value = v-retry-fname .
     1484   END.
     1485   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
     1486   DO:
     1487     ASSIGN
     1488       v-addr
     1489       v-cashdesk
     1490       v-pumpdoc
     1491       v-schem
     1492       v-price
     1493       v-file-path
     1494       v-rest
     1495       v-osn-fname
     1496       v-art-fname
     1497       v-retry-fname
     1498     .
     1499     if v-price and trim(v-file-path) = ""
     1500     then do :
     1501       message "Для загрузки цен необходимо выбрать файл с соответствиями кодов товаров." view-as alert-box.
     1502       apply "entry" to v-file-path .
     1503       return no-apply .
     1504     end.
     1505     if v-schem and trim(v-file-path) = ""
     1506     then do :
     1507       message "Для загрузки топологии необходимо выбрать файл с соответствиями кодов товаров!" view-as alert-box.
     1508       return no-apply .
     1509     end.
     1510     if v-rest and trim(v-osn-fname) = ""
     1511     then do :
     1512       message "Для загрузки остатков необходимо выбрать файл с соответствиями кодов поставщиков." view-as alert-box.
     1513       apply "entry" to v-osn-fname .
     1514       return no-apply .
     1515     end.
     1516     if v-rest and trim(v-art-fname) = ""
     1517     then do :
     1518       message "Для загрузки остатков необходимо выбрать файл с соответствиями кодов товаров." view-as alert-box.
     1519       apply "entry" to v-art-fname .
     1520       return no-apply .
     1521     end.
     1522     if v-rest and trim(v-retry-fname) = ""
     1523     then do :
     1524       message "Для загрузки остатков необходимо указать имя файла для выгрузки строк с ошибками, пригодного для повторной загрузки." view-as alert-box.
     1525       apply "entry" to v-retry-fname .
     1526       return no-apply .
     1527     end.
     1528     if trim(v-file-path) <> ""
     1529     then do :
     1530       if search(v-file-path) = ?
     1531       then do :
     1532         message "Файл соответствий не найден!" view-as alert-box.
     1533         return no-apply .
     1534       end.
     1535       file-info:file-name = v-file-path .
     1536       if file-info:file-size = 0
     1537       then do :
     1538         message "Файл соответствий пустой!" view-as alert-box.
     1539         return no-apply .
     1540       end.
     1541     end.
     1542     mutil:mAddr = v-addr.
     1543     v-has-records = false.
     1544     if v-cashdesk then do :
     1545       v-has-records = mutil:chek_cash_desk().
     1546       if v-has-records
     1547       then do :
     1548         message "Справочник касс и/или их атрибутов не пустой!" view-as alert-box.
     1549         return no-apply .
     1550       end.
     1551     end.
     1552     if v-schem then do :
     1553       v-has-records = mUtil:Chek_Shem().
     1554       if v-has-records
     1555       then do :
     1556         message "Топология не пустая!" view-as alert-box.
     1557         return no-apply .
     1558       end.
     1559     end.
     1560     if v-pumpdoc then do :
     1561       v-has-records = mutil:chek_pumpdoc().
     1562       if v-has-records
     1563       then do :
     1564         message "На объекте есть инвентаризации счетчиков ТРК!" view-as alert-box.
     1565         return no-apply .
     1566       end.
     1567     end.
     1568     if v-price then do :
     1569       v-has-records = mutil:chek_price().
     1570       if v-has-records
     1571       then do :
     1572         message "На объекте есть переоценки!" view-as alert-box.
     1573         return no-apply .
     1574       end.
     1575     end.
     1576     if v-rest then do :
     1577       // 1. ?? запрещать повторную загрузку документов ??
     1578       if can-find (first ub.trn-doc where ub.trn-doc.obj-type = v-cntxt-obj-type
     1579                                       and ub.trn-doc.obj-code = v-cntxt-obj-code) then do :
     1580         v-has-records = true .
     1581       end.
     1582       if v-has-records
     1583       then do :
     1584         message "На объекте есть остатки!" view-as alert-box.
     1585         return no-apply .
     1586       end.
     1587     end .
     1588     output stream log-stream to value("load-from-15_0.log") append .
     1589     output stream err-stream to value("load-from-15_0.err") append .
     1590     if v-cashdesk
     1591     then do trans:
     1592       run waitfram-show in this-procedure ( INPUT "Обработка: Кассы..." ).
     1593       mutil:load_cashdesk ().
     1594       if error-status:error
     1595       then do :
     1596         run waitfram-hide in this-procedure .
     1597         message ("Ошибка при загрузке Касс: " + return-value + chr(10) + "Продолжить работу?") view-as alert-box question buttons yes-no update glog .
     1598         if not glog then undo, return no-apply .
     1599         undo .
     1600       end.
     1601     end.
     1602     output stream log-stream close .
     1603     output stream err-stream close .
     1604     output stream log-stream to value("load-from-15_0.log") append .
     1605     output stream err-stream to value("load-from-15_0.err") append .
     1606     if v-schem
     1607     then do trans:
     1608       run waitfram-show in this-procedure ( INPUT "Обработка: Топология..." ).
     1609       mUtil:load_schem(v-file-path) no-error .
     1610       if error-status:error
     1611       then do :
     1612         run waitfram-hide in this-procedure .
     1613         message ("Ошибка при загрузке Топологии: " + return-value + chr(10) + "Продолжить работу?") view-as alert-box question buttons yes-no update glog .
     1614         if not glog then undo, return no-apply .
     1615         undo .
     1616       end.
     1617     end.
     1618     output stream log-stream close .
     1619     output stream err-stream close .
     1620     output stream log-stream to value("load-from-15_0.log") append .
     1621     output stream err-stream to value("load-from-15_0.err") append .
     1622     if v-pumpdoc
     1623     then do trans:
     1624       run waitfram-show in this-procedure ( INPUT "Обработка: Инвентаризация счетчиков ТРК" ).
     1625       mutil:load_pumpdoc (v-file-path) no-error .
     1626       if error-status:error
     1627       then do :
     1628         run waitfram-hide in this-procedure .
     1629         message ("Ошибка при загрузке Инвентаризации счетчиков ТРК: " + return-value + chr(10) + "Продолжить работу?") view-as alert-box question buttons yes-no update glog .
     1630         if not glog then undo, return no-apply .
     1631         undo .
     1632       end.
     1633     end.
     1634     output stream log-stream close .
     1635     output stream err-stream close .
     1636     output stream log-stream to value("load-from-15_0.log") append .
     1637     output stream err-stream to value("load-from-15_0.err") append .
     1638     if v-price
     1639     then do trans:
     1640       run waitfram-show in this-procedure ( INPUT "Обработка: Цены" ).
     1641       mutil:load_price(v-file-path) no-error .
     1642       if error-status:error
     1643       then do :
     1644         run waitfram-hide in this-procedure .
     1645         message ("Ошибка при загрузке цен: " + return-value + chr(10) + "Продолжить работу?") view-as alert-box question buttons yes-no update glog .
     1646         if not glog then undo, return no-apply .
     1647         undo .
     1648       end.
     1649     end.
     1650     output stream log-stream close .
     1651     output stream err-stream close .
     1652     output stream log-stream to value("load-from-15_0.log") append .
     1653     output stream err-stream to value("load-from-15_0.err") append .
     1654     if v-rest
     1655     then do trans:
     1656       run waitfram-show in this-procedure ( INPUT "Обработка: Остатки" ).
     1657       mutil:load_rest ( v-osn-fname  ,  // список соответствия поставщиков
     1658                         v-art-fname  , // список соответствия товаров
     1659                         v-retry-fname).
     1660       if error-status:error
     1661       then do :
     1662         run waitfram-hide in this-procedure .
     1663         message ("Ошибка при загрузке остатков: " + return-value + chr(10) + "Продолжить работу?") view-as alert-box question buttons yes-no update glog .
     1664         if not glog then undo, return no-apply .
     1665         undo .
     1666       end.
     1667     end.
     1668     output stream log-stream close .
     1669     output stream err-stream close .
     1670     run waitfram-hide in this-procedure .
     1671     message "ГОТОВО!" view-as alert-box.
     1672   END.
     1673   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1674   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1675   MAIN-BLOCK:
     1676   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1677      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1678   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1679     run mainmenu_getcntxt in parparentproc
     1680       (output v-cntxt-db-num
     1681       ,output v-cntxt-userid
     1682       ,output v-cntxt-level
     1683       ,output v-cntxt-host-code-obj
     1684       ,output v-cntxt-obj-type
     1685       ,output v-cntxt-obj-code
     1686       ,output v-cntxt-db-num-obj
     1687       ,output v-cntxt-is-admin
     1688       ) .
     1689     RUN enable_UI.
     1690     WAIT-FOR GO OF FRAME Dialog-Frame.
     1691   END.
     1692   RUN disable_UI.
     1693   PROCEDURE disable_UI :
     1694     HIDE FRAME Dialog-Frame.
     1695   END PROCEDURE.
     1696   PROCEDURE enable_UI :
     1697     DISPLAY v-addr v-cashdesk v-schem v-pumpdoc
     1698         WITH FRAME Dialog-Frame.
     1699     ENABLE B-OK B-Cancel v-addr v-cashdesk v-schem v-pumpdoc v-price v-file-path b-file
     1700       v-rest v-osn-fname b-osn-file v-art-fname b-art-file v-retry-fname b-retry-file
     1701         WITH FRAME Dialog-Frame.
     1702     VIEW FRAME Dialog-Frame.
     1703     apply "value-changed" to v-price in frame Dialog-Frame .
     1704     apply "value-changed" to v-rest in frame Dialog-Frame .
     1705   END PROCEDURE.
     1706   procedure pcall-log-file :
     1707   define input  parameter p-message as character no-undo .
     1708     do
     1709     on error undo, return error return-value
     1710     :
     1711       put stream log-stream unformatted p-message skip .
     1712     end.
     1713   end procedure.
     1714   procedure pcall-log-file-err :
     1715   define input  parameter p-message as character no-undo .
     1716     do
     1717     on error undo, return error return-value
     1718     :
     1719       put stream err-stream unformatted p-message skip .
     1720     end.
     1721   end procedure.
     1722   finally:
     1723   unsubscribe   to "write-log"     .
     1724   unsubscribe   to "write-log-err" .
     1725   delete object mutil no-error.
     1726   end finally.
