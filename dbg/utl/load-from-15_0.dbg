        1   using Progress.Json.ObjectModel.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Загрузка данных из TH 15.0 через сокет-сервер".
        9   define variable mUtil as class ibs.th.utl.method-for-draw-utility no-undo.
       10   mUtil = new ibs.th.utl.method-for-draw-utility().
       11   mutil:parparentproc = parparentproc.
       12   subscribe   to "write-log"     anywhere run-procedure "pcall-log-file".
       13   subscribe   to "write-log-err" anywhere run-procedure "pcall-log-file-err".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   procedure placelib_write-attr:
      129   define input  parameter p-code     like ub.place-attr.attr-code .
      130   define input  parameter p-obj-code like ub.place-attr.obj-code .
      131   define input  parameter p-obj-type like ub.place-attr.obj-type .
      132   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      133   define input  parameter p-value    like ub.place-attr.attr-value .
      134   define output parameter p-ok       as logical.
      135   define buffer buf_place-attr for ub.place-attr .
      136     do on error undo, return error return-value :
      137        p-ok = false.
      138        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      139                                                   and buf_place-attr.obj-code    = p-obj-code
      140                                                   and buf_place-attr.obj-type    = p-obj-type
      141                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      142        if not available buf_place-attr then do :
      143           create buf_place-attr.
      144           assign
      145             buf_place-attr.attr-code   = p-code
      146             buf_place-attr.attr-value  = p-value
      147             buf_place-attr.obj-code    = p-obj-code
      148             buf_place-attr.obj-type    = p-obj-type
      149             buf_place-attr.pl-code     = p-pl-code
      150           .
      151           p-ok = true.
      152        end.
      153        else do:
      154           buf_place-attr.attr-value  = p-value .
      155           p-ok = true.
      156        end.
      157     end.
      158   end.
      159   procedure placelib_get-attr:
      160   define input  parameter  p-code     like ub.place-attr.attr-code .
      161   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      162   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      163   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      164   define output parameter  p-value    like ub.place-attr.attr-value .
      165   define output parameter  p-ok       as logical.
      166   define buffer buf_place-attr for ub.place-attr .
      167     do on error undo, return error return-value :
      168        p-ok = false.
      169        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      170                                                   and buf_place-attr.obj-code    = p-obj-code
      171                                                   and buf_place-attr.obj-type    = p-obj-type
      172                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      173        if available buf_place-attr then do :
      174          p-value = buf_place-attr.attr-value.
      175          p-ok = true.
      176        end.
      177        else do :
      178          p-ok = false.
      179        end.
      180     end.
      181   end.
      182   procedure placelib_del-attr:
      183   define input parameter  p-code     like ub.place-attr.attr-code .
      184   define input parameter  p-obj-code like ub.place-attr.obj-code .
      185   define input parameter  p-obj-type like ub.place-attr.obj-type .
      186   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      187   define input parameter  p-value    like ub.place-attr.attr-value .
      188   define output parameter p-ok       as logical.
      189   define buffer buf_place-attr for ub.place-attr .
      190     do on error undo, return error return-value :
      191        p-ok = false.
      192        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      193                                                   and buf_place-attr.obj-code    = p-obj-code
      194                                                   and buf_place-attr.obj-type    = p-obj-type
      195                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      196        if available buf_place-attr then do :
      197           delete buf_place-attr.
      198           p-ok = true.
      199        end.
      200     end.
      201   end.
      202   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      203   function nzpl-spl returns logical
      204   (input p-obj-type as character
      205                                   , input p-obj-code as integer):
      206   define variable v-dopi    as integer no-undo .
      207   define variable v-param-type as character no-undo .
      208   define variable v-value-character as character no-undo .
      209   define variable v-value-date as date no-undo .
      210   define variable v-value-decimal as decimal no-undo .
      211   define variable v-value-integer as integer no-undo .
      212   define variable v-value-logical as logical no-undo .
      213   define variable v-tth as handle no-undo .
      214   define variable dflt-cd as character no-undo .
      215   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      216   define variable v-param-type1 as character no-undo .
      217   define variable v-value-date1 as date no-undo .
      218   define variable v-value-decimal1 as decimal no-undo .
      219   define variable v-value-integer1 as INTEGER no-undo .
      220   define variable v-value-logical1 AS LOGICAL no-undo .
      221   define variable v-tth1 as handle no-undo .
      222   run adm/shattri.p (
      223       input "get":U
      224       ,input  p-obj-type
      225       ,input  p-obj-code
      226       ,input  'cd-sending':U
      227       ,input  'dflt-cd':U
      228       ,output dflt-cd
      229       ,output v-value-date1
      230       ,output v-value-decimal1
      231       ,output v-value-integer1
      232       ,output v-value-logical1
      233       ,output v-param-type1
      234       ,INPUT-OUTPUT table-handle v-tth1
      235       ) no-error .
      236   delete object v-tth1 no-error.
      237   if dflt-cd <> 'IBM':U
      238   and dflt-cd <> 'IBM-XML':U then return no.
      239   if dflt-cd = 'IBM-XML':U then return yes.
      240   run adm/shattri.p (
      241       input "get":U
      242       ,input  p-obj-type
      243       ,input  p-obj-code
      244       ,input  'cd-type-ibm':U
      245       ,input  'ibmspool':U
      246       ,output v-value-character
      247       ,output v-value-date
      248       ,output v-value-decimal
      249       ,output v-value-integer
      250       ,output v-value-logical
      251       ,output v-param-type
      252       ,INPUT-OUTPUT table-handle v-tth
      253       ) no-error .
      254   if error-status:error then do:
      255     delete object v-tth.
      256     return no.
      257   end.
      258   delete object v-tth.
      259   assign
      260   v-dopi = v-value-integer no-error .
      261   if v-dopi >= 6 then return yes.
      262   end. // FUNCTION/method
      263   FUNCTION nzpl-two returns logical
      264                                    (input p-obj-type as character
      265                                     , input p-obj-code as integer):
      266     define variable v-nzpl-two as logical no-undo.
      267     run
      268     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      269     return v-nzpl-two.
      270   end. // FUNCTION/method
      271   procedure nzpl-two-proc :
      272   define input  parameter p-obj-type   as character no-undo.
      273   define input  parameter p-obj-code   as integer   no-undo.
      274   define output parameter varge-two-pl as logical   no-undo.
      275   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      276   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      277   //do on error undo, return error return-value :
      278   assign
      279     varge-two-pl = no.
      280   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      281                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      282                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      283     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      284                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      285                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      286                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      287                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      288                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      289     if available bf-other_pl-gds-pump then do:
      290       assign
      291         varge-two-pl = yes.
      292       leave.
      293     end.
      294   end.
      295   //end.
      296   end. // procedure/method .
      297   procedure cplgdspm :
      298     define input parameter parobj-type  like ub.pl-gds-pump.obj-type  no-undo.
      299     define input parameter parobj-code  like ub.pl-gds-pump.obj-code  no-undo.
      300     define input parameter parpl-code   like ub.pl-gds-pump.pl-code   no-undo.
      301     define input parameter pargds-code  like ub.pl-gds-pump.gds-code  no-undo.
      302     define input parameter parpump-code like ub.pl-gds-pump.pump-code no-undo.
      303     define input parameter parstatus    like ub.pl-gds-pump.status_   no-undo.
      304       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      305       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      306       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      307       define buffer bf-place                for ub.place.
      308       if parstatus = 'тек':U then do:
      309         for each bf_pl-gds-pump no-lock
      310           where bf_pl-gds-pump.obj-type  =  parobj-type
      311             and bf_pl-gds-pump.obj-code  =  parobj-code
      312             and bf_pl-gds-pump.gds-code  =  pargds-code
      313             and bf_pl-gds-pump.pump-code =  parpump-code
      314             and bf_pl-gds-pump.pl-code   <> parpl-code
      315             and bf_pl-gds-pump.status_   =  'тек':U
      316         on error undo, return error
      317         :
      318           find first place where
      319                      place.obj-type = parobj-type
      320                  and place.obj-code = parobj-code
      321                  and place.pl-code  = parpl-code
      322                no-lock no-error.
      323           find first bf-place where
      324                      bf-place.obj-type = parobj-type
      325                  and bf-place.obj-code = parobj-code
      326                  and bf-place.pl-code = bf_pl-gds-pump.pl-code
      327                no-lock no-error.
      328           if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      329             return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      330                                        ,parobj-type
      331                                        ,parobj-code
      332                                        ,if available place then place.loc1 else string(parpl-code)
      333                                        ,pargds-code
      334                                        ,parpump-code
      335                                        ,parstatus
      336                                        ,chr(10)
      337                                       )
      338                         + substitute( "КАССА не возвращает номер пистолета в чеке, а на объекте уже есть резервуар &1 с тем же товаром и связан он с этой же ТРК."
      339                                       ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      340                                     ).
      341           end.
      342           else do:
      343             find first bf_pl-pump-nozzle no-lock
      344               where bf_pl-pump-nozzle.obj-type  = parobj-type
      345                 and bf_pl-pump-nozzle.obj-code  = parobj-code
      346                 and bf_pl-pump-nozzle.pump-code = parpump-code
      347                 and bf_pl-pump-nozzle.pl-code   = parpl-code
      348               no-error.
      349             if available bf_pl-pump-nozzle then do:
      350               find first bf-other_pl-pump-nozzle no-lock
      351                 where bf-other_pl-pump-nozzle.obj-type  = bf_pl-gds-pump.obj-type
      352                   and bf-other_pl-pump-nozzle.obj-code  = bf_pl-gds-pump.obj-code
      353                   and bf-other_pl-pump-nozzle.pump-code = bf_pl-gds-pump.pump-code
      354                   and bf-other_pl-pump-nozzle.pl-code   = bf_pl-gds-pump.pl-code
      355                 no-error.
      356               if available bf-other_pl-pump-nozzle
      357                 and bf-other_pl-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
      358               then do:
      359                 return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      360                                          ,parobj-type
      361                                          ,parobj-code
      362                                          ,if available place then place.loc1 else string(parpl-code)
      363                                          ,pargds-code
      364                                          ,parpump-code
      365                                          ,parstatus
      366                                          ,chr(10)
      367                                        )
      368                             + substitute( "На объекте &1 &2 уже есть запись резервуар &3 в статусе &4, в котором находится этот же товар и он связан с этой же ТРК через этот же пистолет."
      369                                           ,bf_pl-gds-pump.obj-type
      370                                           ,bf_pl-gds-pump.obj-code
      371                                           ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      372                                           ,bf_pl-gds-pump.status_
      373                                         ).
      374               end.
      375             end.
      376           end.
      377         end.
      378       end.
      379   end . // procedure/method
      380   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   define new global shared variable g#attr-lib  as handle no-undo .
      382   define variable v-attr-lib-variable as handle no-undo .
      383   procedure cd-attr-code :
      384     define input  parameter p-ucode          as character no-undo .
      385     define input  parameter p-code           as character no-undo .
      386     define output parameter p-type           as character no-undo .
      387     define output parameter p-format         as character no-undo .
      388     define output parameter p-label          as character no-undo .
      389     define output parameter p-user-can-edit  as logical   no-undo .
      390     define output parameter p-output-display as logical   no-undo .
      391     define output parameter p-other          as character no-undo .
      392     define output parameter p-prop-list      as character no-undo .
      393     do
      394     on error undo, return error return-value
      395     :
      396           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-code in g#attr-lib
      397         (input  p-ucode
      398         ,input  p-code
      399         ,output p-type
      400         ,output p-format
      401         ,output p-label
      402         ,output p-user-can-edit
      403         ,output p-output-display
      404         ,output p-other
      405         ,output p-prop-list
      406         ) no-error .
      407       if error-status :error
      408       then do:
      409         undo, return error return-value .
      410       end.
      411     end.
      412   end procedure.
      413   procedure cd-attr-tooltip :
      414     define input  parameter p-ucode   as character no-undo .
      415     define input  parameter p-code    as character no-undo .
      416     define output parameter p-tooltip as character no-undo .
