      213         message
      214           vss-workfile vss-revision vss-description skip
      215           vss-include-info0 skip
      216           "Ошибка при определении атрибута шкалы" skip
      217           "Код признака" v-root-node skip
      218           "Запрашивался атрибут" "empty-scale=request" skip
      219           error-status :get-message(1) skip
      220           return-value skip
      221           view-as alert-box error .
      222         undo, return error .
      223       end.
      224       assign
      225         v-total-term-fact-qnty = 0
      226         v-total-fact-sale      = 0
      227       .
      228       if l-empty-scale = true
      229       then do:
      230         for each buf_price-list
      231           where buf_price-list.doc-num    = v-doc-num
      232             and buf_price-list.main-price = false
      233             and buf_price-list.artic      = p-artic
      234             and buf_price-list.prod-type  = p-prod-type
      235             and buf_price-list.prod-code  = p-prod-code
      236             and buf_price-list.price-type = ""
      237         on error undo, return error return-value
      238         :
      239           if buf_price-list.doc-qnty <> ? and p-check-price-parts
      240           then do:
      241             message
      242               vss-workfile vss-revision vss-description skip
      243               vss-include-info0 skip
      244               "Ошибка при закрытии переоценки" skip
      245               "Для неосновного бар-кода товара с пустой шкалой" skip
      246               "указано количество отличное от ?" skip
      247               "Переоценка" v-doc-num skip
      248               "Бар-код" buf_price-list.b-code skip
      249               "Артикул" p-artic p-prod-type p-prod-code skip
      250               "Количество" buf_price-list.doc-qnty skip
      251               view-as alert-box error .
      252             undo, return error .
      253           end.
      254         end.
      255       end.
      256       if l-empty-scale = false
      257       then do:
      258         define variable v-unit-base like ub.goods.unit-base no-undo .
      259   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
      261     (input  v-gds-code
      262     ,output v-unit-base
      263     ) no-error .
      264         if error-status :error
      265         then do:
      266           message
      267             vss-workfile vss-revision vss-description skip
      268             vss-include-info0 skip
      269             "Ошибка при определении базовой единицы измерения товара" skip
      270             "Код товара" v-gds-code skip
      271             error-status :get-message(1) skip
      272             return-value skip
      273             view-as alert-box error .
      274           undo, return error .
      275         end.
      276         for each buf_price-list
      277           where buf_price-list.doc-num    = v-doc-num
      278             and buf_price-list.main-price = false
      279             and buf_price-list.artic      = p-artic
      280             and buf_price-list.prod-type  = p-prod-type
      281             and buf_price-list.prod-code  = p-prod-code
      282             and buf_price-list.price-type = ""
      283         on error undo, return error
      284         :
      285           if buf_price-list.doc-qnty = ?
      286           then do:
      287             find first buf_bar-code no-lock
      288               where buf_bar-code.b-code = buf_price-list.b-code
      289               no-error .
      290             if  available buf_bar-code
      291             and buf_bar-code.unit-cli = v-unit-base
      292             then do:
      293               message
      294                 vss-workfile vss-revision vss-description skip
      295                 vss-include-info0 skip
      296                 "Ошибка при закрытии переоценки" skip
      297                 "Не задано количество для бар-кода с основной единицей измерения" skip
      298                 "Переоценка" v-doc-num skip
      299                 "Бар-код" buf_price-list.b-code skip
      300                 "Артикул" p-artic p-prod-type p-prod-code skip
      301                 "Количество" buf_price-list.doc-qnty skip
      302                 "Основная единица измерения" v-unit-base skip
      303                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
      304                 view-as alert-box error .
      305               undo, return error .
      306             end.
      307             next .
      308           end.
      309           find first buf_bar-code no-lock
      310             where buf_bar-code.b-code = buf_price-list.b-code
      311             no-error .
      312           if not available buf_bar-code
      313           then do:
      314             message
