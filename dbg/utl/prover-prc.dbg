      378           then do:
      379             assign
      380               v-total-term-fact-qnty = v-total-term-fact-qnty
      381                                     + buf_temp-prt-obj.fact-qnty
      382               v-total-fact-sale = v-total-fact-sale
      383                                 + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
      384             .
      385           end.
      386           if p-check-price-list = true
      387           then do:
      388             if buf_temp-prt-obj.price-list-recid = ?
      389             or buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.price-list-qnty
      390             then do:
      391             end.
      392             else do:
      393               message
      394                 vss-workfile vss-revision vss-description skip
      395                 vss-include-info0 skip
      396                 "Ошибка при закрытии переоценки" skip
      397                 "Несовпадают текущие количества по признаку" skip
      398                 "и количество признака в переоценке" skip
      399                 "Переоценка" v-doc-num skip
      400                 "Артикул" p-artic p-prod-type p-prod-code skip
      401                 "Код признака" buf_temp-prt-obj.prt-code skip
      402                 "Количество по признаку" buf_temp-prt-obj.fact-qnty skip
      403                 "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
      404                 "Корень шкалы товара" v-root-node skip
      405                 view-as alert-box error .
      406               undo, return error .
      407             end.
      408           end.
      409         end.
      410       end.
      411       find first buf_temp-prt-obj
      412         where buf_temp-prt-obj.prt-code = v-root-node
      413         .
      414       assign
      415         buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.fact-qnty
      416                                     - v-total-term-fact-qnty
      417       .
      418       if p-check-price-list = true
      419       then do:
      420         if buf_temp-prt-obj.fact-qnty <> buf_temp-prt-obj.price-list-qnty and p-check-price-parts
      421         then do:
      422           message
      423             vss-workfile vss-revision vss-description skip
      424             vss-include-info0 skip
      425             "Ошибка при закрытии переоценки" skip
