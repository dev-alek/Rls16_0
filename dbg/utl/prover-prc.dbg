     2336   define variable v-total-crsa-fact-qnty  as decimal   no-undo .
     2337   define variable v-cur-base              as decimal   no-undo .
     2338   define variable v-cur-VAT-base          as decimal   no-undo .
     2339   define variable v-cur-SLT-base          as decimal   no-undo .
     2340   define variable v-cur-road-tax-base     as decimal   no-undo .
     2341   define variable v-cur-excise-base       as decimal   no-undo .
     2342   define variable v-kol                   as integer   no-undo .
     2343   define buffer buf_ot-line for ub.ot-line  .
     2344   define stream out-stream.
     2345   output stream out-stream to "verarh-prc.txt":U .
     2346   v-kol = 0 .
     2347   for each ub.clients no-lock where ub.clients.db-num > 0 :
     2348   for each  ub.price-doc no-lock where
     2349             ub.price-doc.obj-code = ub.clients.obj-code and
     2350             ub.price-doc.obj-type = ub.clients.obj-type and
     2351             ub.price-doc.status_  = 'акт':U ,
     2352       each  ub.price-list no-lock where
     2353             ub.price-list.doc-num =  ub.price-doc.doc-num and
     2354             ub.price-list.main-price  = true  by ub.price-doc.fact-order :
     2355   find first buf_ot-line no-lock where
     2356              buf_ot-line.doc-code      = ub.price-list.doc-num   and
     2357              buf_ot-line.artic         = ub.price-list.artic     and
     2358              buf_ot-line.prod-type     = ub.price-list.prod-type and
     2359              buf_ot-line.prod-code     = ub.price-list.prod-code and
     2360              buf_ot-line.sum-type      = 'crsa':U             and
     2361              buf_ot-line.obj-type      = ub.price-doc.obj-type   and
     2362              buf_ot-line.obj-code      = ub.price-doc.obj-code   and
     2363              buf_ot-line.ext-doc-type  = 'ot':U       no-error .
     2364            if not available buf_ot-line then next.
     2365           v-cur-base = 0.
     2366           run  prdoclib-calc-ov in this-procedure
     2367               (input  recid(ub.price-list)
     2368               ,output v-total-crsa-fact-qnty
     2369               ,output v-cur-base
     2370               ,output v-cur-VAT-base
     2371               ,output v-cur-SLT-base
     2372               ) no-error .
     2373               if error-status :error then do:
     2374              put stream out-stream unformatted
     2375              return-value
     2376              error-status :get-message(1)
     2377              skip
     2378              .
     2379             end.
     2380           if buf_ot-line.sum-rubl <> v-cur-base then do:
     2381              put stream out-stream unformatted
     2382              ub.clients.obj-type
     2383              ub.clients.obj-code
     2384              " артикул: "  buf_ot-line.artic  " №переоценки: " buf_ot-line.doc-code " " buf_ot-line.fact-qnty skip
     2385              'ARH ' buf_ot-line.sum-rubl "    UCH " v-cur-base
     2386              .
     2387              v-kol = v-kol + 1 .
     2388           run  prdoclib-calc-fact-sale in this-procedure
     2389               (input  recid(ub.price-list)
     2390               ,output v-total-crsa-fact-qnty
     2391               ,output v-cur-base
     2392               ,output v-cur-VAT-base
     2393               ,output v-cur-SLT-base
     2394               ,output v-cur-VAT-base
     2395               ,output v-cur-SLT-base
     2396               ) no-error .
     2397               if error-status :error then do:
     2398              put stream out-stream unformatted
     2399              return-value
     2400              error-status :get-message(1)
     2401              skip
     2402              .
     2403              end.
     2404              put stream out-stream unformatted
     2405               " F-S " v-cur-base skip
     2406               ' дата пересчета с ' string ( (ub.price-doc.fact-date - 1 ) , "99/99/9999" ) skip
     2407              return-value
     2408              error-status :get-message(1)
     2409              skip
     2410              .
     2411             leave.
     2412           end.
     2413   end.
     2414   end.
     2415   output stream out-stream close.
     2416   message 'все'
     2417       'Пересчитать с инициализацией'
     2418       v-kol
     2419       'объектов'
     2420    view-as alert-box information .
