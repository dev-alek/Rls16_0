      316               vss-include-info0 skip
      317               "В переоценке задан несуществующий бар-код" skip
      318               "Переоценка" v-doc-num skip
      319               "Артикул" p-artic p-prod-type p-prod-code skip
      320               "Бар-код" buf_price-list.b-code skip
      321               view-as alert-box error .
      322             undo, return error .
      323           end.
      324           if buf_bar-code.in-code <> ""
      325           or buf_bar-code.part-code <> ""
      326           then do:
      327             message
      328               vss-workfile vss-revision vss-description skip
      329               vss-include-info0 skip
      330               "В переоценке задан бар-код партии" skip
      331               "Данная версия системы не рассчитана на работу со специальными ценами по партиям" skip
      332               "Переоценка" v-doc-num skip
      333               "Бар-код" buf_price-list.b-code skip
      334               "Артикул" p-artic p-prod-type p-prod-code skip
      335               "Код ПН" buf_bar-code.in-code buf_bar-code.part-code skip
      336               view-as alert-box error .
      337             undo, return error .
      338           end.
      339           if buf_bar-code.node-code <> v-root-node
      340           then do:
      341   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
      343     (input  p-obj-type
      344     ,input  p-obj-code
      345     ,input  p-artic
      346     ,input  p-prod-type
      347     ,input  p-prod-code
      348     ,input  buf_bar-code.node-code
      349     ,buffer buf_prt-obj
      350     ) no-error .
      351             if error-status :error
      352             then do:
