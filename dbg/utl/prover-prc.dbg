      539   procedure prdoclib-clear-temp-prt-obj :
      540     define buffer buf_temp-prt-obj for temp-prt-obj .
      541     do
      542     on error undo, return error return-value
      543     :
      544       for each buf_temp-prt-obj
      545       on error undo, return error return-value
      546       :
      547         delete buf_temp-prt-obj .
      548       end.
      549     end.
      550   end procedure.
      551   procedure prdoclib-create-temp-prt-obj :
      552     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
      553     define parameter buffer buf_prt-obj       for ub.prt-obj .
      554     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
      555     define buffer buf_gds-prt for ub.gds-prt .
      556     do
      557     on error undo, return error return-value
      558     :
      559       find first buf_temp-prt-obj
      560         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
      561         no-error .
      562       if not available buf_temp-prt-obj
      563       then do:
      564         create buf_temp-prt-obj .
      565         assign
      566           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
      567           buf_temp-prt-obj.price-sale       = ?
      568           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
      569           buf_temp-prt-obj.price-list-qnty  = ?
      570           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
      571           buf_temp-prt-obj.price-list-recid = ?
      572         .
      573         find first buf_gds-prt no-lock
      574           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
      575           .
      576         assign
      577           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
      578         .
      579         if buf_temp-prt-obj.is-term
      580         then do:
      581           assign
      582             buf_temp-prt-obj.price-sale = p-root-price-sale
      583           .
      584         end.
      585       end.
      586     end.
      587   end procedure.
      588   procedure prdoclib-temp-prt-obj-by-prt-root :
      589     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
      590     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
      591     define buffer buf_gds-prt for ub.gds-prt .
      592     do
      593     on error undo, return error return-value
      594     :
      595       find first buf_temp-prt-obj
      596         where buf_temp-prt-obj.prt-code = p-prt-code
      597         no-error .
      598       if not available buf_temp-prt-obj
      599       then do:
      600         create buf_temp-prt-obj .
      601         assign
      602           buf_temp-prt-obj.prt-code         = p-prt-code
      603           buf_temp-prt-obj.price-sale       = ?
      604           buf_temp-prt-obj.fact-qnty        = 0
      605           buf_temp-prt-obj.price-list-qnty  = ?
      606           buf_temp-prt-obj.prt-obj-recid    = ?
      607           buf_temp-prt-obj.price-list-recid = ?
      608         .
      609         find first buf_gds-prt no-lock
      610           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
      611           .
      612         assign
      613           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
      614         .
      615         if buf_temp-prt-obj.is-term
      616         then do:
      617           assign
      618             buf_temp-prt-obj.price-sale = 0
      619           .
      620         end.
      621       end.
      622     end.
      623   end procedure.
      624   procedure prdoclib-init-temp-prt-obj :
      625     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
      626     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
      627     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
      628     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
      629     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
      630     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
      631     define buffer buf_prt-obj      for ub.prt-obj .
      632     define buffer buf_temp-prt-obj for temp-prt-obj .
      633     do
      634     on error undo, return error return-value
      635     :
      636       run prdoclib-clear-temp-prt-obj in this-procedure .
      637       for each buf_prt-obj
      638         where buf_prt-obj.obj-type  = p-obj-type
      639           and buf_prt-obj.obj-code  = p-obj-code
      640           and buf_prt-obj.artic     = p-artic
      641           and buf_prt-obj.prod-type = p-prod-type
      642           and buf_prt-obj.prod-code = p-prod-code
      643       on error undo, return error return-value
      644       :
      645         run prdoclib-create-temp-prt-obj in this-procedure
      646           (input  p-root-price-sale
      647           ,buffer buf_prt-obj
      648           ,buffer buf_temp-prt-obj
      649           ).
      650       end.
      651     end.
      652   end procedure.
      653   procedure prdoclib-calc-fact-sale :
      654     define input  parameter p-price-list-recid   as recid     no-undo .
      655     define output parameter p-fact-qnty          as decimal   no-undo .
      656     define output parameter p-cur-base           as decimal   no-undo .
      657     define output parameter p-cur-VAT-base       as decimal   no-undo .
      658     define output parameter p-cur-SLT-base       as decimal   no-undo .
      659     define output parameter p-cur-road-tax-base  as decimal   no-undo .
      660     define output parameter p-cur-excise-base    as decimal   no-undo .
      661     define buffer buf_main_price-list for ub.price-list .
      662     define buffer buf_price-list      for ub.price-list .
      663     define buffer buf_goods           for ub.goods .
      664     define buffer buf_gds-obj         for ub.gds-obj .
      665     define buffer buf_bar-code        for ub.bar-code .
      666     define variable l-empty-scale   as logical   no-undo .
      667     do
      668     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
      669     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
      670     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
      671     :
      672       find first buf_main_price-list no-lock
      673         where recid(buf_main_price-list) = p-price-list-recid
      674         no-error .
      675       if not available buf_main_price-list
      676       then do:
      677         message
      678           vss-workfile vss-revision vss-description skip
      679           vss-include-info0 skip
      680           "Ошибка задания входных параметров" skip
      681           "Не найдена строка переоценки" skip
      682           "Код записи (recid)" p-price-list-recid skip
      683           view-as alert-box error .
      684         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
      685       end.
      686       if buf_main_price-list.main-price <> true
      687       then do:
      688         message
      689           vss-workfile vss-revision vss-description skip
      690           vss-include-info0 skip
      691           "Ошибка задания входных параметров" skip
      692           "Строка переоценки не является основной" skip
      693           "Код записи (recid)" p-price-list-recid skip
      694           "Переоценка" buf_main_price-list.doc-num skip
      695           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      696           "Бар-код" buf_main_price-list.b-code skip
      697           view-as alert-box error .
      698         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
      699       end.
      700       find first buf_goods no-lock
      701         where buf_goods.artic     = buf_main_price-list.artic
      702           and buf_goods.prod-type = buf_main_price-list.prod-type
      703           and buf_goods.prod-code = buf_main_price-list.prod-code
      704         no-error .
      705       if not available buf_goods
      706       then do:
      707         message
      708           vss-workfile vss-revision vss-description skip
      709           vss-include-info0 skip
      710           "Не найден товар" skip
      711           "Переоценка" buf_main_price-list.doc-num skip
      712           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      713           view-as alert-box error .
      714         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      715       end.
      716   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      718     (input  buf_main_price-list.artic
      719     ,input  buf_main_price-list.prod-type
      720     ,input  buf_main_price-list.prod-code
      721     ,input  'empty-scale=request':u
      722     ,output l-empty-scale
      723     ) no-error .
      724       if error-status :error
      725       then do:
      726         message
      727           vss-workfile vss-revision vss-description skip
      728           vss-include-info0 skip
      729           "Ошибка при определении атрибута товара" skip
      730           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      731           'empty-scale=request':u skip
      732           error-status :get-message(1) skip
      733           return-value skip
      734           view-as alert-box error .
      735         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      736       end.
      737       find first buf_gds-obj no-lock
      738         where buf_gds-obj.gds-code = buf_goods.gds-code
      739           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
      740           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
      741         no-error .
      742         if not available buf_gds-obj then do:
      743   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      745     (input  buf_main_price-list.obj-type
      746     ,input  buf_main_price-list.obj-code
      747     ,input  buf_goods.artic
      748     ,input  buf_goods.prod-type
      749     ,input  buf_goods.prod-code
      750     ,buffer buf_gds-obj
      751     ) no-error .
      752           if error-status :error then do:
      753              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      754           end.
      755         end.
      756       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
      757       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
      758       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
      759       define variable price-base-without-tax-sale-prl as decimal   no-undo .
      760       define variable vat-base-sale-prl               as decimal   no-undo .
      761       define variable vat-rubl-sale-prl               as decimal   no-undo .
      762       define variable vat-base-buyer-prl              as decimal   no-undo .
      763       define variable vat-rubl-buyer-prl              as decimal   no-undo .
      764       define variable slt-base-sale-prl               as decimal   no-undo .
      765       define variable slt-rubl-sale-prl               as decimal   no-undo .
      766       define variable road-tax-base-sale-prl          as decimal   no-undo .
      767       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
      768       define variable excise-base-sale-prl            as decimal   no-undo .
      769       define variable excise-rubl-sale-prl            as decimal   no-undo .
      770       define variable discnt-base-sale-prl            as decimal   no-undo .
      771       define variable discnt-rubl-sale-prl            as decimal   no-undo .
      772       if buf_main_price-list.doc-qnty <> 0
      773       then do:
      774         run prl-vat in this-procedure
      775           (input  recid(buf_main_price-list)
      776           ,output price-rubl-with-tax-sale-prl
      777           ,output price-base-with-tax-sale-prl
      778           ,output price-rubl-without-tax-sale-prl
      779           ,output price-base-without-tax-sale-prl
      780           ,output vat-base-sale-prl
      781           ,output vat-rubl-sale-prl
      782           ,output vat-base-buyer-prl
      783           ,output vat-rubl-buyer-prl
      784           ,output slt-base-sale-prl
      785           ,output slt-rubl-sale-prl
      786           ,output road-tax-base-sale-prl
      787           ,output road-tax-rubl-sale-prl
      788           ,output excise-base-sale-prl
      789           ,output excise-rubl-sale-prl
      790           ,output discnt-base-sale-prl
      791           ,output discnt-rubl-sale-prl
      792           ) no-error .
      793         if error-status :error
      794         then do:
      795           message
      796             vss-workfile vss-revision vss-description skip
      797             vss-include-info0 skip
      798             "Ошибка при вызове процеды prl-vat" skip
      799             "Документ" buf_main_price-list.doc-num skip
      800             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      801             error-status :get-message(1) skip
      802             return-value skip
      803             view-as alert-box error .
      804           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      805         end.
      806       end.
      807       else do:
      808         assign
      809           price-rubl-with-tax-sale-prl    = 0
      810           price-base-with-tax-sale-prl    = 0
      811           price-rubl-without-tax-sale-prl = 0
      812           price-base-without-tax-sale-prl = 0
      813           vat-base-sale-prl               = 0
      814           vat-rubl-sale-prl               = 0
      815           vat-base-buyer-prl              = 0
      816           vat-rubl-buyer-prl              = 0
      817           slt-base-sale-prl               = 0
      818           slt-rubl-sale-prl               = 0
      819           road-tax-base-sale-prl          = 0
      820           road-tax-rubl-sale-prl          = 0
      821           excise-base-sale-prl            = 0
      822           excise-rubl-sale-prl            = 0
      823           discnt-base-sale-prl            = 0
      824           discnt-rubl-sale-prl            = 0
      825         .
      826       end.
      827       define variable v-curr-r-b as character no-undo .
      828   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      829   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      830     (output v-curr-r-b
      831     )  .
      832       if v-curr-r-b = 'base':U
      833       then do:
      834         assign
      835           p-fact-qnty         = buf_main_price-list.doc-qnty
      836           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
      837           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
      838           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
      839           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
      840           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
      841         .
      842       end.
      843       else do:
      844         assign
      845           p-fact-qnty         = buf_main_price-list.doc-qnty
      846           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
      847           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
      848           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
      849           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
      850           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
      851         .
      852       end.
      853         define variable v-unit-base like ub.goods.unit-base no-undo .
      854   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
      856     (input  buf_goods.gds-code
      857     ,output v-unit-base
      858     ) no-error .
      859         if error-status :error
      860         then do:
      861           message
      862             vss-workfile vss-revision vss-description skip
      863             vss-include-info0 skip
      864             "Ошибка при определении базовой единицы измерения товара" skip
      865             "Код товара" buf_goods.gds-code skip
      866             error-status :get-message(1) skip
      867             return-value skip
      868             view-as alert-box error .
      869           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      870         end.
      871         for each buf_price-list no-lock
      872           where buf_price-list.doc-num    = buf_main_price-list.doc-num
      873             and buf_price-list.main-price = false
      874             and buf_price-list.artic      = buf_main_price-list.artic
      875             and buf_price-list.prod-type  = buf_main_price-list.prod-type
      876             and buf_price-list.prod-code  = buf_main_price-list.prod-code
      877         :
      878           if buf_price-list.doc-qnty = ?
      879           then do:
      880             find first buf_bar-code no-lock
      881               where buf_bar-code.b-code = buf_price-list.b-code
      882               no-error .
      883             if available buf_bar-code
      884             and buf_bar-code.unit-cli = v-unit-base
      885             then do:
      886               message
      887                 vss-workfile vss-revision vss-description skip
      888                 vss-include-info0 skip
      889                 "Ошибка при закрытии переоценки" skip
      890                 "Не задано количество для бар-кода с основной единицей измерения" skip
      891                 "Переоценка" buf_main_price-list.doc-num skip
      892                 "Бар-код" buf_price-list.b-code skip
      893                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      894                 "Количество" buf_price-list.doc-qnty skip
      895                 "Основная единица измерения" v-unit-base skip
      896                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
      897                 view-as alert-box error .
      898               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      899             end.
      900             next .
      901           end.
      902           if not can-find
      903             (first buf_bar-code
      904             where buf_bar-code.b-code = buf_price-list.b-code
      905             )
      906           then do:
      907             message
      908               vss-workfile vss-revision vss-description skip
      909               vss-include-info0 skip
      910               "В переоценке задан несуществующий бар-код" skip
      911               "Переоценка" buf_price-list.doc-num skip
      912               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
      913               "Бар-код" buf_price-list.b-code skip
      914               view-as alert-box error .
      915             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      916           end.
      917           if buf_price-list.doc-qnty <> 0
      918           then do:
      919             run prl-vat in this-procedure
      920               (input  recid(buf_price-list)
      921               ,output price-rubl-with-tax-sale-prl
      922               ,output price-base-with-tax-sale-prl
      923               ,output price-rubl-without-tax-sale-prl
      924               ,output price-base-without-tax-sale-prl
      925               ,output vat-base-sale-prl
      926               ,output vat-rubl-sale-prl
      927               ,output vat-base-buyer-prl
      928               ,output vat-rubl-buyer-prl
      929               ,output slt-base-sale-prl
      930               ,output slt-rubl-sale-prl
      931               ,output road-tax-base-sale-prl
      932               ,output road-tax-rubl-sale-prl
      933               ,output excise-base-sale-prl
      934               ,output excise-rubl-sale-prl
      935               ,output discnt-base-sale-prl
      936               ,output discnt-rubl-sale-prl
      937               ) no-error .
      938             if error-status :error
      939             then do:
      940               message
      941                 vss-workfile vss-revision vss-description skip
      942                 vss-include-info0 skip
      943                 "Ошибка при вызове процеды prl-vat" skip
      944                 "Документ" buf_price-list.doc-num skip
      945                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
      946                 error-status :get-message(1) skip
      947                 return-value skip
      948                 view-as alert-box error .
      949               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      950             end.
      951           end.
      952           else do:
      953             assign
      954               price-rubl-with-tax-sale-prl    = 0
      955               price-base-with-tax-sale-prl    = 0
      956               price-rubl-without-tax-sale-prl = 0
      957               price-base-without-tax-sale-prl = 0
      958               vat-base-sale-prl               = 0
      959               vat-rubl-sale-prl               = 0
      960               vat-base-buyer-prl              = 0
      961               vat-rubl-buyer-prl              = 0
      962               slt-base-sale-prl               = 0
      963               slt-rubl-sale-prl               = 0
      964               road-tax-base-sale-prl          = 0
      965               road-tax-rubl-sale-prl          = 0
      966               excise-base-sale-prl            = 0
      967               excise-rubl-sale-prl            = 0
      968               discnt-base-sale-prl            = 0
      969               discnt-rubl-sale-prl            = 0
      970             .
      971           end.
      972           if v-curr-r-b = 'base':U
      973           then do:
      974             assign
      975               p-fact-qnty         = p-fact-qnty
      976                                   + buf_price-list.doc-qnty
      977               p-cur-base          = p-cur-base
      978                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
      979               p-cur-VAT-base      = p-cur-VAT-base
      980                                   + vat-base-sale-prl * buf_price-list.doc-qnty
      981               p-cur-SLT-base      = p-cur-SLT-base
      982                                   + slt-base-sale-prl * buf_price-list.doc-qnty
      983               p-cur-road-tax-base = p-cur-road-tax-base
      984                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
      985               p-cur-excise-base   = p-cur-excise-base
      986                                   + excise-base-sale-prl * buf_price-list.doc-qnty
      987             .
      988           end.
      989           else do:
      990             assign
      991               p-fact-qnty         = p-fact-qnty
      992                                   + buf_price-list.doc-qnty
      993               p-cur-base          = p-cur-base
      994                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
      995               p-cur-VAT-base      = p-cur-VAT-base
      996                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
      997               p-cur-SLT-base      = p-cur-SLT-base
      998                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
      999               p-cur-road-tax-base = p-cur-road-tax-base
     1000                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1001               p-cur-excise-base   = p-cur-excise-base
     1002                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1003             .
     1004           end.
     1005         end.
     1006     end.
     1007   end procedure.
     1008   procedure prdoclib-calc-prc :
     1009     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1010     define input  parameter p-cons-pay        as   integer                no-undo.
     1011     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1012     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1013     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1014     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1015     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1016     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1017     do
     1018     on error undo, return error return-value
     1019     :
     1020       define buffer buf_price-doc       for ub.price-doc .
     1021       define buffer buf_price-list      for ub.price-list .
     1022       define buffer buf_parts           for ub.parts .
     1023       define variable v-ov-qnty     as decimal   no-undo .
     1024       define variable v-ov-base     as decimal   no-undo .
     1025       define variable v-ov-VAT-base as decimal   no-undo .
     1026       define variable v-ov-SLT-base as decimal   no-undo .
     1027       define variable v-cons-qnty   as decimal   no-undo .
     1028       define variable v-prch-qnty   as decimal   no-undo .
     1029       define variable v-cons-mult   as decimal   no-undo .
     1030       define variable v-prch-mult   as decimal   no-undo .
     1031       find first buf_price-doc no-lock
     1032         where recid(buf_price-doc) = p-price-doc-recid
     1033         no-error .
     1034       if not available buf_price-doc
     1035       then do:
     1036         message
     1037           vss-workfile vss-revision vss-description skip
     1038           vss-include-info0 skip
     1039           "Ошибка задания входных параметров" skip
     1040           "Не найден документ переоценки" skip
     1041           "Код записи (recid)" p-price-doc-recid skip
     1042           view-as alert-box error .
     1043         undo, return error .
     1044       end.
     1045       for each buf_price-list no-lock
     1046         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1047           and buf_price-list.main-price = true
     1048       on error undo, return error return-value
     1049       :
     1050         run prdoclib-calc-ov
     1051           (input recid(buf_price-list)
     1052           ,output v-ov-qnty
     1053           ,output v-ov-base
     1054           ,output v-ov-VAT-base
     1055           ,output v-ov-SLT-base
     1056           ) no-error .
     1057         if error-status :error
     1058         then do:
     1059           if error-status :get-message(1) <> ""
     1060           then do:
     1061             message
     1062               vss-workfile vss-revision vss-description skip
     1063               vss-include-info0 skip
     1064               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1065               error-status :get-message(1) skip
     1066               return-value skip
     1067               view-as alert-box error .
     1068           end.
     1069           undo, return error return-value .
     1070         end.
     1071         assign
     1072           v-cons-qnty = 0
     1073           v-prch-qnty = 0
     1074         .
     1075         for each buf_parts no-lock
     1076           where buf_parts.out-code  = buf_price-list.doc-num
     1077             and buf_parts.obj-type  = buf_price-list.obj-type
     1078             and buf_parts.obj-code  = buf_price-list.obj-code
     1079             and buf_parts.artic     = buf_price-list.artic
     1080             and buf_parts.prod-type = buf_price-list.prod-type
     1081             and buf_parts.prod-code = buf_price-list.prod-code
     1082         on error undo, return error return-value
     1083         :
     1084           if buf_parts.pay-code = p-cons-pay
     1085           then do:
     1086             assign
     1087               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1088             .
     1089           end.
     1090           else do:
     1091             assign
     1092               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1093             .
     1094           end.
     1095         end.
     1096         if (v-cons-qnty + v-prch-qnty) = 0
     1097         then do:
     1098           assign
     1099             v-cons-mult = 0
     1100             v-prch-mult = 1
     1101           .
     1102         end.
     1103         else do:
     1104           assign
     1105             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1106             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1107           .
     1108         end.
     1109         assign
     1110           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1111           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1112           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1113           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1114           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1115           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1116         .
     1117       end.
     1118     end.
     1119   end procedure.
     1120   procedure prdoclib-calc-ov :
     1121     define input  parameter p-price-list-recid as recid     no-undo .
     1122     define output parameter p-fact-qnty        as decimal   no-undo .
     1123     define output parameter p-ov-base          as decimal   no-undo .
     1124     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1125     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1126     do
     1127     on error undo, return error return-value
     1128     :
     1129       define buffer buf_main_price-list    for ub.price-list .
     1130       define buffer buf_prev_price-list    for ub.price-list .
     1131       define buffer buf_special_price-list for ub.price-list .
     1132       define buffer buf_goods              for ub.goods .
     1133       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1134       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1135       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1136       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1137       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1138       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1139       define variable v-prev-price-list-recid as   recid                  no-undo.
     1140       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1141       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1142       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1143       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1144       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1145       find first buf_main_price-list no-lock
     1146         where recid(buf_main_price-list) = p-price-list-recid
     1147         no-error .
     1148       if not available buf_main_price-list
     1149       then do:
     1150         message
     1151           vss-workfile vss-revision vss-description skip
     1152           vss-include-info0 skip
     1153           "Ошибка задания входных параметров" skip
     1154           "Не найдена строка переоценки" skip
     1155           "Код записи (recid)" p-price-list-recid skip
     1156           view-as alert-box error .
     1157         undo, return error .
     1158       end.
     1159       if buf_main_price-list.main-price <> true
     1160       then do:
     1161         message
     1162           vss-workfile vss-revision vss-description skip
     1163           vss-include-info0 skip
     1164           "Ошибка задания входных параметров" skip
     1165           "Строка переоценки не является основной" skip
     1166           "Код записи (recid)" p-price-list-recid skip
     1167           "Переоценка" buf_main_price-list.doc-num skip
     1168           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1169           "Бар-код" buf_main_price-list.b-code skip
     1170           view-as alert-box error .
     1171         undo, return error .
     1172       end.
     1173       run prdoclib-calc-fact-sale in this-procedure
     1174         (input  recid(buf_main_price-list)
     1175         ,output v-fact-qnty
     1176         ,output v-cur-base
     1177         ,output v-cur-VAT-base
     1178         ,output v-cur-SLT-base
     1179         ,output v-cur-road-tax-base
     1180         ,output v-cur-excise-base
     1181         ) no-error.
     1182       if error-status :error
     1183       then do:
     1184         message
     1185           vss-workfile vss-revision vss-description skip
     1186           vss-include-info0 skip
     1187           "Ошибка при расчете сумм переоценки." skip
     1188           "Документ переоценки" buf_main_price-list.doc-num skip
     1189           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1190           error-status :get-message(1) skip
     1191           return-value skip
     1192           view-as alert-box error .
     1193         undo, return error .
     1194       end.
     1195   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1197     (input  buf_main_price-list.obj-type
     1198     ,input  buf_main_price-list.obj-code
     1199     ,input  buf_main_price-list.b-code
     1200     ,input  buf_main_price-list.b-code
     1201     ,input  buf_main_price-list.fact-order
     1202     ,output v-prev-price-list-recid
     1203     ,output v-prev-cli-base-rate
     1204     ) no-error .
     1205       if error-status :error
     1206       then do:
     1207         message
     1208           vss-workfile vss-revision vss-description skip
     1209           vss-include-info0 skip
     1210           "Ошибка при поиске предыдущей переоценки." skip
     1211           "Документ переоценки " buf_main_price-list.doc-num skip
     1212           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1213           error-status :get-message(1) skip
     1214           return-value skip
     1215           view-as alert-box error .
     1216         undo, return error .
     1217       end.
     1218       if v-prev-price-list-recid <> ?
     1219       then do:
     1220         find first buf_prev_price-list no-lock
     1221           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1222           .
     1223         find first buf_special_price-list no-lock
     1224           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1225             and buf_special_price-list.main-price = false
     1226             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1227             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1228             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1229             and buf_special_price-list.doc-qnty   <> ?
     1230           no-error .
     1231         if available buf_special_price-list
     1232         then do:
     1233           message
     1234             "Товар имеет специальные цены на признаки" skip
     1235             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1236             "Переоценка" buf_prev_price-list.doc-num skip
     1237             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1238             view-as alert-box error .
     1239           undo, return error .
     1240         end.
     1241         find first buf_goods no-lock
     1242           where buf_goods.artic     = buf_main_price-list.artic
     1243             and buf_goods.prod-type = buf_main_price-list.prod-type
     1244             and buf_goods.prod-code = buf_main_price-list.prod-code
     1245           no-error .
     1246         if not available buf_goods
     1247         then do:
     1248           message
     1249             vss-workfile vss-revision vss-description skip
     1250             vss-include-info0 skip
     1251             "Не найден товар" skip
     1252             "Переоценка" buf_main_price-list.doc-num skip
     1253             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1254             view-as alert-box error .
     1255           undo, return error .
     1256         end.
     1257         if buf_prev_price-list.vat-pc = ?
     1258         or buf_prev_price-list.slt-pc = ?
     1259         then do:
     1260           message
     1261             "В переоценке не заданы налоги товара" skip
     1262             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1263             "Переоценка" buf_prev_price-list.doc-num skip
     1264             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1265             "НДС" buf_prev_price-list.vat-pc skip
     1266             "НП" buf_prev_price-list.slt-pc skip
     1267             view-as alert-box error .
     1268           undo, return error return-value .
     1269         end.
     1270         define variable v-prev-cur-SLT-pc as decimal no-undo .
     1271         assign
     1272           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     1273         .
     1274         assign
     1275           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     1276           v-prev-cur-VAT-base = v-fact-qnty
     1277                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     1278                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     1279           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     1280         .
     1281         assign
     1282           p-fact-qnty   = v-fact-qnty
     1283           p-ov-base     = v-cur-base     - v-prev-cur-base
     1284           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1285           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1286         .
     1287       end.
     1288       else do:
     1289         assign
     1290           v-prev-cur-base     = 0
     1291           v-prev-cur-VAT-base = 0
     1292           v-prev-cur-SLT-base = 0
     1293           .
     1294         assign
     1295           p-fact-qnty   = v-fact-qnty
     1296           p-ov-base     = v-cur-base     - v-prev-cur-base
     1297           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1298           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1299         .
     1300       end.
     1301     end.
     1302   end procedure.
     1303   procedure prdoclib-init-prt-obj-by-factord :
     1304     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1305     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1306     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1307     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1308     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1309     define input parameter p-fact-order         as decimal   no-undo .
     1310     define input parameter p-include-fact-order as logical   no-undo .
     1311     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     1312     define buffer buf_gds-obj      for ub.gds-obj .
     1313     define buffer buf_doc-line     for ub.doc-line .
     1314     define buffer buf_temp-prt-obj for temp-prt-obj .
     1315     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319       do transaction
     1320       on error undo, return error return-value
     1321       :
     1322   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1324     (input  p-obj-type
     1325     ,input  p-obj-code
     1326     ,input  p-artic
     1327     ,input  p-prod-type
     1328     ,input  p-prod-code
     1329     ,buffer buf_gds-obj
     1330     ) no-error .
     1331         if error-status :error
     1332         then do:
     1333           message
     1334             vss-workfile vss-revision vss-description skip
     1335             vss-include-info0 skip
     1336             "Невозможно найти gds-obj" skip
     1337             error-status :get-message(1) skip
     1338             return-value skip
     1339             view-as alert-box error .
     1340           undo, return error .
     1341         end.
     1342         find current buf_gds-obj exclusive-lock .
     1343       end.
     1344       run prdoclib-init-temp-prt-obj in this-procedure
     1345         (input p-obj-type
     1346         ,input p-obj-code
     1347         ,input p-artic
     1348         ,input p-prod-type
     1349         ,input p-prod-code
     1350         ,input 0
     1351         ) .
     1352       for each buf_temp-prt-obj
     1353         where buf_temp-prt-obj.is-term <> true
     1354       on error undo, return error return-value
     1355       :
     1356         delete buf_temp-prt-obj .
     1357       end.
     1358       if p-include-fact-order = true
     1359       then do:
     1360         assign
     1361          p-fact-order = p-fact-order - 0.0000000001
     1362         .
     1363       end.
     1364       for each buf_doc-line no-lock
     1365         where buf_doc-line.obj-type   = p-obj-type
     1366           and buf_doc-line.obj-code   = p-obj-code
     1367           and buf_doc-line.artic      = p-artic
     1368           and buf_doc-line.prod-type  = p-prod-type
     1369           and buf_doc-line.prod-code  = p-prod-code
     1370           and buf_doc-line.status_    = 'факт':U
     1371           and buf_doc-line.fact-order >= p-fact-order
     1372       on error undo, return error return-value
     1373       :
     1374         run prdoclib-process-document in this-procedure
     1375           (input  buf_doc-line.doc-code
     1376           ,input  p-obj-type
     1377           ,input  p-obj-code
     1378           ,input  p-artic
     1379           ,input  p-prod-type
     1380           ,input  p-prod-code
     1381           ,output v-total-gds-dtl-qnty
     1382           ) .
     1383       end.
     1384     end.
     1385   end procedure.
     1386   procedure prdoclib-process-document :
     1387     define input  parameter p-doc-code           as character no-undo .
     1388     define input  parameter p-obj-type           as character no-undo .
     1389     define input  parameter p-obj-code           as integer   no-undo .
     1390     define input  parameter p-artic              as character no-undo .
     1391     define input  parameter p-prod-type          as character no-undo .
     1392     define input  parameter p-prod-code          as integer   no-undo .
     1393     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     1394     define buffer buf_trn-doc      for ub.trn-doc .
     1395     define buffer buf_gds-dtl      for ub.gds-dtl .
     1396     define buffer buf_temp-prt-obj for temp-prt-obj .
     1397     do
     1398     on error undo, return error return-value
     1399     :
     1400       find first buf_trn-doc no-lock
     1401         where buf_trn-doc.doc-code = p-doc-code
     1402         no-error .
     1403       if not available buf_trn-doc then do:
     1404         message
     1405           vss-workfile vss-revision vss-description skip
     1406           vss-include-info0 skip
     1407           "Ошибка при поиске документа" skip
     1408           "Документ" p-doc-code skip
     1409           "Объект" p-obj-type p-obj-code skip
     1410           "Артикул" p-artic p-prod-type p-prod-code skip
     1411           view-as alert-box error .
     1412         undo, return error .
     1413       end.
     1414       assign
     1415         p-total-gds-dtl-qnty = 0
     1416       .
     1417       for each buf_gds-dtl no-lock
     1418         where buf_gds-dtl.doc-code  = p-doc-code
     1419           and buf_gds-dtl.artic     = p-artic
     1420           and buf_gds-dtl.prod-type = p-prod-type
     1421           and buf_gds-dtl.prod-code = p-prod-code
     1422       on error undo, return error
     1423       :
     1424         define variable v-term-node as integer   no-undo .
     1425   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     1426     (input  buf_gds-dtl.prt-code
     1427     ,output v-term-node
     1428     )  .
     1429         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     1430           (input  v-term-node
     1431           ,buffer buf_temp-prt-obj
     1432           ) .
     1433         if buf_temp-prt-obj.is-term <> true then do:
     1434           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     1435                                        ,buf_gds-dtl.prt-code
     1436                                        ) .
     1437         end.
     1438         case buf_trn-doc.doc-type :
     1439           when 'при':U or
     1440           when 'возврат':U
     1441           then do:
     1442             assign
     1443               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1444                                           - buf_gds-dtl.fact-qnty
     1445               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1446                                           - buf_gds-dtl.fact-qnty
     1447             .
     1448           end.
     1449           when 'рас':U or
     1450           when 'спи':U
     1451           then do:
     1452             assign
     1453               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1454                                           + buf_gds-dtl.fact-qnty
     1455               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1456                                           + buf_gds-dtl.fact-qnty
     1457             .
     1458           end.
     1459           when 'инв':U
     1460           then do:
     1461             assign
     1462               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1463                                           - buf_gds-dtl.doc-qnty
     1464               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1465                                           - buf_gds-dtl.doc-qnty
     1466             .
     1467           end.
     1468           otherwise do:
     1469             undo, return error substitute("Неизвестный тип документа &1"
     1470                                          ,buf_trn-doc.doc-type
     1471                                          ) .
     1472           end.
     1473         end.
     1474       end.
     1475     end.
     1476   end procedure.
     1477   procedure prdoclib-prc-pl-document :
     1478     define input  parameter p-doc-code              as character no-undo .
     1479     define input  parameter p-obj-type              as character no-undo .
     1480     define input  parameter p-obj-code              as integer   no-undo .
     1481     define input  parameter p-gds-code              as integer   no-undo .
     1482     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     1483     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     1484     do
     1485     on error undo, return error return-value
     1486     :
     1487       define buffer buf_trn-doc      for ub.trn-doc .
     1488       define buffer buf_doc-pl       for ub.doc-pl .
     1489       define buffer buf_temp-pl-gds for temp-pl-gds .
     1490       define variable v-sign as decimal   no-undo .
     1491       find first buf_trn-doc no-lock
     1492         where buf_trn-doc.doc-code = p-doc-code
     1493         no-error .
     1494       if not available buf_trn-doc then do:
     1495         message
     1496           vss-workfile vss-revision vss-description skip
     1497           vss-include-info0 skip
     1498           "Ошибка при поиске документа" skip
     1499           "Документ" p-doc-code skip
     1500           "Объект" p-obj-type p-obj-code skip
     1501           "Товар" p-gds-code skip
     1502           view-as alert-box error .
     1503         undo, return error .
     1504       end.
     1505       assign
     1506         p-total-pl-gds-qnty     = 0
     1507         p-total-pl-gds-cli-qnty = 0
     1508       .
     1509       for each buf_doc-pl no-lock
     1510         where buf_doc-pl.out-code  = p-doc-code
     1511           and buf_doc-pl.gds-code  = p-gds-code
     1512       on error undo, return error return-value
     1513       :
     1514         find first buf_temp-pl-gds
     1515           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     1516             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     1517             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     1518           .
     1519         case buf_trn-doc.doc-type :
     1520           when 'при':U
     1521           or when 'возврат':U
     1522           or when 'инв':U
     1523           then do:
     1524             assign
     1525               v-sign = -1.0
     1526             .
     1527           end.
     1528           when 'рас':U or
     1529           when 'спи':U
     1530           then do:
     1531             assign
     1532               v-sign = 1.0
     1533             .
     1534           end.
     1535           otherwise do:
     1536             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     1537           end.
     1538         end case.
     1539         assign
     1540           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     1541           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     1542           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     1543           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     1544         .
     1545       end.
     1546     end.
     1547   end procedure.
     1548   procedure prdoclib-init-prt-obj-by-date :
     1549     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     1550     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     1551     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     1552     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     1553     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     1554     define input parameter p-fact-date  as date      no-undo .
     1555     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     1556     do
     1557     on error undo, return error return-value
     1558     :
     1559       define variable v-fact-order                as decimal   no-undo .
     1560       define variable v-shift-end-fact-order      as decimal   no-undo .
     1561       define variable v-day-end-fact-order        as decimal   no-undo .
     1562       run factord in this-procedure
     1563         (input  p-fact-date
     1564         ,input  1
     1565         ,input  1
     1566         ,input  ?
     1567         ,input  0
     1568         ,input  false
     1569         ,output v-fact-order
     1570         ,output v-shift-end-fact-order
     1571         ,output v-day-end-fact-order
     1572         ) no-error .
     1573       if error-status :error
     1574       then do:
     1575         message
     1576           vss-workfile vss-revision vss-description skip
     1577           vss-include-info0 skip
     1578           "Ошибка при определении момента времени, на который требуется остаток" skip
     1579           "Объект" p-obj-type p-obj-code skip
     1580           "Артикул" p-artic p-prod-type p-prod-code skip
     1581           "Дата" p-fact-date skip
     1582           view-as alert-box error .
     1583         undo, return error .
     1584       end.
     1585       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     1586         (input p-obj-type
     1587         ,input p-obj-code
     1588         ,input p-artic
     1589         ,input p-prod-type
     1590         ,input p-prod-code
     1591         ,input v-day-end-fact-order
     1592         ,input false
     1593         ) no-error .
     1594       if error-status :error
     1595       then do:
     1596         message
     1597           vss-workfile vss-revision vss-description skip
     1598           vss-include-info0 skip
     1599           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     1600           "Объект" p-obj-type p-obj-code skip
     1601           "Артикул" p-artic p-prod-type p-prod-code skip
     1602           "Дата" p-fact-date skip
     1603           view-as alert-box error .
     1604         undo, return error .
     1605       end.
     1606     end.
     1607   end procedure.
     1608   procedure prdoclib-calc-temp-fact-sale :
     1609     define input  parameter p-obj-type           as character no-undo .
     1610     define input  parameter p-obj-code           as integer   no-undo .
     1611     define input  parameter p-gds-code           as integer   no-undo .
     1612     define input  parameter p-day-end-fact-order as decimal   no-undo .
     1613     define input  parameter p-curr-r-b           as character no-undo .
     1614     define output parameter p-fact-qnty          as decimal   no-undo .
     1615     define output parameter p-cur-base           as decimal   no-undo .
     1616     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1617     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1618     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1619     define output parameter p-cur-excise-base    as decimal   no-undo .
     1620     define buffer buf_temp-prt-obj for temp-prt-obj .
     1621     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     1622     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     1623     define variable parrecid-prl        as recid     no-undo .
     1624     define variable v-fact-qnty         as decimal   no-undo .
     1625     define variable v-cur-base          as decimal   no-undo .
     1626     define variable v-cur-VAT-base      as decimal   no-undo .
     1627     define variable v-cur-SLT-base      as decimal   no-undo .
     1628     define variable v-cur-road-tax-base as decimal   no-undo .
     1629     define variable v-cur-excise-base   as decimal   no-undo .
     1630     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1631     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1632     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1633     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1634     define variable vat-base-sale-prl               as decimal   no-undo .
     1635     define variable vat-rubl-sale-prl               as decimal   no-undo .
     1636     define variable vat-base-buyer-prl              as decimal   no-undo .
     1637     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1638     define variable slt-base-sale-prl               as decimal   no-undo .
     1639     define variable slt-rubl-sale-prl               as decimal   no-undo .
     1640     define variable road-tax-base-sale-prl          as decimal   no-undo .
     1641     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1642     define variable excise-base-sale-prl            as decimal   no-undo .
     1643     define variable excise-rubl-sale-prl            as decimal   no-undo .
     1644     define variable discnt-base-sale-prl            as decimal   no-undo .
     1645     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1646     do
     1647     on error undo, return error return-value
     1648     :
     1649       for each buf_temp-prt-obj no-lock
     1650       on error undo, return error return-value
     1651       :
     1652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1653     (input  p-gds-code
     1654     ,input  buf_temp-prt-obj.prt-code
     1655     ,output v-prt-b-code
     1656     ) no-error .
     1657         if error-status :error
     1658         then do:
     1659           message
     1660             vss-workfile vss-revision vss-description skip
     1661             "Ошибка при определении бар-кода признака" skip
     1662             "Код товара"   p-gds-code skip
     1663             "Код признака" buf_temp-prt-obj.prt-code skip
     1664             error-status :get-message(1) skip
     1665             return-value skip
     1666             view-as alert-box error .
     1667           undo, return error .
     1668         end.
     1669   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1670   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1671     (input  p-obj-type
     1672     ,input  p-obj-code
     1673     ,input  v-prt-b-code
     1674     ,input  0
     1675     ,input  p-day-end-fact-order
     1676     ,output parrecid-prl
     1677     ,output v-cli-base-rate
     1678     ) no-error .
     1679         if error-status :error
     1680         then do:
     1681           message
     1682             vss-workfile vss-revision vss-description skip
     1683             "Ошибка при определении цены бар-кода" skip
     1684             "Объект" p-obj-type p-obj-code skip
     1685             "Бар-код" v-prt-b-code skip
     1686             "fact-order" p-day-end-fact-order skip
     1687             error-status :get-message(1) skip
     1688             return-value skip
     1689             view-as alert-box error .
     1690           undo, return error .
     1691         end.
     1692         if parrecid-prl <> ?
     1693         then do:
     1694           run prl-vat in this-procedure
     1695             (input  parrecid-prl
     1696             ,output price-rubl-with-tax-sale-prl
     1697             ,output price-base-with-tax-sale-prl
     1698             ,output price-rubl-without-tax-sale-prl
     1699             ,output price-base-without-tax-sale-prl
     1700             ,output vat-base-sale-prl
     1701             ,output vat-rubl-sale-prl
     1702             ,output vat-base-buyer-prl
     1703             ,output vat-rubl-buyer-prl
     1704             ,output slt-base-sale-prl
     1705             ,output slt-rubl-sale-prl
     1706             ,output road-tax-base-sale-prl
     1707             ,output road-tax-rubl-sale-prl
     1708             ,output excise-base-sale-prl
     1709             ,output excise-rubl-sale-prl
     1710             ,output discnt-base-sale-prl
     1711             ,output discnt-rubl-sale-prl
     1712             ) no-error .
     1713           if error-status :error
     1714           then do:
     1715             message
     1716               vss-workfile vss-revision vss-description skip
     1717               "Ошибка при вызове процеды prl-vat" skip
     1718               "Объект" p-obj-type p-obj-code skip
     1719               "Код товара" p-gds-code skip
     1720               "Указатель на запись переоценки" parrecid-prl skip
     1721               error-status :get-message(1) skip
     1722               return-value skip
     1723               view-as alert-box error .
     1724             undo, return error .
     1725           end.
     1726         end.
     1727         else do:
     1728           assign
     1729             price-rubl-with-tax-sale-prl    = 0
     1730             price-base-with-tax-sale-prl    = 0
     1731             price-rubl-without-tax-sale-prl = 0
     1732             price-base-without-tax-sale-prl = 0
     1733             vat-base-sale-prl               = 0
     1734             vat-rubl-sale-prl               = 0
     1735             slt-base-sale-prl               = 0
     1736             slt-rubl-sale-prl               = 0
     1737             road-tax-base-sale-prl          = 0
     1738             road-tax-rubl-sale-prl          = 0
     1739             excise-base-sale-prl            = 0
     1740             excise-rubl-sale-prl            = 0
     1741             discnt-base-sale-prl            = 0
     1742             discnt-rubl-sale-prl            = 0
     1743           .
     1744         end.
     1745         assign
     1746           v-fact-qnty         = v-fact-qnty
     1747                               + buf_temp-prt-obj.fact-qnty
     1748           v-cur-base          = v-cur-base
     1749                               + (if p-curr-r-b = 'base':U
     1750                                   then price-base-with-tax-sale-prl
     1751                                   else price-rubl-with-tax-sale-prl
     1752                                 )
     1753                               * buf_temp-prt-obj.fact-qnty
     1754           v-cur-VAT-base      = v-cur-VAT-base
     1755                               + (if p-curr-r-b = 'base':U
     1756                                   then vat-base-sale-prl
     1757                                   else vat-rubl-sale-prl
     1758                                 )
     1759                               * buf_temp-prt-obj.fact-qnty
     1760           v-cur-SLT-base      = v-cur-SLT-base
     1761                               + (if p-curr-r-b = 'base':U
     1762                                   then slt-base-sale-prl
     1763                                   else slt-rubl-sale-prl
     1764                                 )
     1765                               * buf_temp-prt-obj.fact-qnty
     1766           v-cur-road-tax-base = v-cur-road-tax-base
     1767                               + (if p-curr-r-b = 'base':U
     1768                                   then road-tax-base-sale-prl
     1769                                   else road-tax-rubl-sale-prl
     1770                                 )
     1771                               * buf_temp-prt-obj.fact-qnty
     1772           v-cur-excise-base   = v-cur-excise-base
     1773                               + (if p-curr-r-b = 'base':U
     1774                                   then excise-base-sale-prl
     1775                                   else excise-rubl-sale-prl
     1776                                 )
     1777                               * buf_temp-prt-obj.fact-qnty
     1778         .
     1779       end.
     1780       assign
     1781         p-fact-qnty         = v-fact-qnty
     1782         p-cur-base          = v-cur-base
     1783         p-cur-VAT-base      = v-cur-VAT-base
     1784         p-cur-SLT-base      = v-cur-SLT-base
     1785         p-cur-road-tax-base = v-cur-road-tax-base
     1786         p-cur-excise-base   = v-cur-excise-base
     1787       .
     1788     end.
     1789   end procedure.
     1790   procedure prdoclib-clear-temp-pl-gds :
     1791     define buffer buf_temp-pl-gds for temp-pl-gds .
     1792     do
     1793     on error undo, return error return-value
     1794     :
     1795       for each buf_temp-pl-gds
     1796       on error undo, return error return-value
     1797       :
     1798         delete buf_temp-pl-gds .
     1799       end.
     1800     end.
     1801   end procedure.
     1802   procedure prdoclib-init-temp-pl-gds :
     1803     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     1804     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     1805     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     1806     define buffer buf_pl-gds      for ub.pl-gds .
     1807     define buffer buf_temp-pl-gds for temp-pl-gds .
     1808     do
     1809     on error undo, return error return-value
     1810     :
     1811       run prdoclib-clear-temp-pl-gds in this-procedure .
     1812       for each buf_pl-gds
     1813         where buf_pl-gds.obj-type = p-obj-type
     1814           and buf_pl-gds.obj-code = p-obj-code
     1815           and buf_pl-gds.gds-code = p-gds-code
     1816       on error undo, return error return-value
     1817       :
     1818         create buf_temp-pl-gds .
     1819         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     1820       end.
     1821     end.
     1822   end procedure.
     1823   procedure prdoclib-init-pl-gds-by-factord :
     1824     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1825     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1826     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1827     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1828     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1829     define input parameter p-fact-order         as decimal   no-undo .
     1830     define input parameter p-include-fact-order as logical   no-undo .
     1831     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     1832     define buffer buf_goods       for ub.goods .
     1833     define buffer buf_gds-obj     for ub.gds-obj .
     1834     define buffer buf_doc-line    for ub.doc-line .
     1835     define buffer buf_temp-pl-gds for temp-pl-gds .
     1836     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     1837     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     1838     do
     1839     on error undo, return error return-value
     1840     :
     1841       do transaction
     1842       on error undo, return error return-value
     1843       :
     1844   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1846     (input  p-obj-type
     1847     ,input  p-obj-code
     1848     ,input  p-artic
     1849     ,input  p-prod-type
     1850     ,input  p-prod-code
     1851     ,buffer buf_gds-obj
     1852     ) no-error .
     1853         if error-status :error
     1854         then do:
     1855           message
     1856             vss-workfile vss-revision vss-description skip
     1857             vss-include-info0 skip
     1858             "Невозможно найти gds-obj" skip
     1859             error-status :get-message(1) skip
     1860             return-value skip
     1861             view-as alert-box error .
     1862           undo, return error return-value .
     1863         end.
     1864         find current buf_gds-obj exclusive-lock .
     1865       end.
     1866       find first buf_goods no-lock
     1867         where buf_goods.artic     = p-artic
     1868           and buf_goods.prod-type = p-prod-type
     1869           and buf_goods.prod-code = p-prod-code
     1870         .
     1871       run prdoclib-init-temp-pl-gds in this-procedure
     1872         (input p-obj-type
     1873         ,input p-obj-code
     1874         ,input buf_goods.gds-code
     1875         ) .
     1876       if p-include-fact-order = true
     1877       then do:
     1878         assign
     1879          p-fact-order = p-fact-order - 0.0000000001
     1880         .
     1881       end.
     1882       for each buf_doc-line no-lock
     1883         where buf_doc-line.obj-type   = p-obj-type
     1884           and buf_doc-line.obj-code   = p-obj-code
     1885           and buf_doc-line.artic      = p-artic
     1886           and buf_doc-line.prod-type  = p-prod-type
     1887           and buf_doc-line.prod-code  = p-prod-code
     1888           and buf_doc-line.status_    = 'факт':U
     1889           and buf_doc-line.fact-order >= p-fact-order
     1890       on error undo, return error return-value
     1891       :
     1892         run prdoclib-prc-pl-document in this-procedure
     1893           ( input  buf_doc-line.doc-code
     1894            ,input  p-obj-type
     1895            ,input  p-obj-code
     1896            ,input  buf_goods.gds-code
     1897            ,output v-total-pl-gds-qnty
     1898            ,output v-total-pl-gds-cli-qnty
     1899           ) .
     1900       end.
     1901     end.
     1902   end procedure.
     1903   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1904   procedure prl-vat:
     1905     define input parameter parrecid as recid no-undo.
     1906       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
