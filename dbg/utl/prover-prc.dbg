     1935       define variable varempty-scaleprl           as   logical                             no-undo.
     1936       define variable varis-cons-parts-haveprl    as   logical                             no-undo.
     1937       define variable varsum-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1938       define variable varslt-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1939       define variable varvat-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1940       define variable varvatcons-base-factovpprl  like ub.gds-dtl.price-base               no-undo.
     1941       define variable vardsc-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1942       define variable varsum-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1943       define variable varslt-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1944       define variable varvat-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1945       define variable varvatcons-base-docovpprl   like ub.gds-dtl.price-base               no-undo.
     1946       define variable vardsc-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1947       define variable varsum-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1948       define variable varslt-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1949       define variable varvat-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1950       define variable varvatcons-rubl-factovpprl  like ub.gds-dtl.price-base               no-undo.
     1951       define variable vardsc-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1952       define variable varsum-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1953       define variable varslt-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1954       define variable varvat-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1955       define variable varvatcons-rubl-docovpprl   like ub.gds-dtl.price-base               no-undo.
     1956       define variable vardsc-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1957       define variable varfact-qntyprl             like ub.parts.fact-qnty                  no-undo.
     1958       define variable varcons-qntyprl             like ub.parts.fact-qnty                  no-undo.
     1959       define variable varis-one-gds-dtlprl        as   logical                             no-undo.
     1960       define variable varcurprlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1961       define variable varcurprlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     1962       define variable varcurprldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1963       define variable varcurprldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1964       define variable varoutvprbprl               as   character                           no-undo.
     1965       define variable out-vatp-have-vat-sltprl    as   logical initial yes                 no-undo.
     1966       define buffer   in-vatp-trn-docoprl  for ub.trn-doc .
     1967       define buffer   in-vatp-partsoprl    for ub.parts   .
     1968       define buffer   in-vatp-docoprl      for ub.trn-doc .
     1969       define buffer   in-vatp-goodsoprl    for ub.goods   .
     1970       define buffer   in-vatp-sysconfoprl  for ub.sysconf .
     1971       define buffer   in-vatp_doc-attroprl for ub.doc-attr.
     1972       define variable in-vatp-have-vat-sltoprl       as   logical initial yes    no-undo.
     1973       define variable vat-pc-locoprl                 like ub.doc-line.vat-pc     no-undo.
     1974       define variable varinvprboprl                  as   character              no-undo.
     1975       define variable slt-pc-locoprl                 like ub.doc-line.slt-pc     no-undo.
     1976       define variable cli-base-rateoprl              as   decimal                no-undo.
     1977       define variable price-rubl-with-tax-locoprl    like ub.doc-line.price-rubl no-undo.
     1978       define variable price-base-with-tax-locoprl    like ub.doc-line.price-base no-undo.
     1979       define variable price-cli-with-tax-locoprl     like ub.doc-line.price-cli  no-undo.
     1980       define variable price-rubl-without-tax-locoprl like ub.doc-line.price-rubl no-undo.
     1981       define variable price-base-without-tax-locoprl like ub.doc-line.price-base no-undo.
     1982       define variable price-cli-without-tax-locoprl  like ub.doc-line.price-base no-undo.
     1983       define variable vat-base-locoprl               like ub.doc-line.price-base no-undo.
     1984       define variable vat-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     1985       define variable vat-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     1986       define variable slt-base-locoprl               like ub.doc-line.price-base no-undo.
     1987       define variable slt-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     1988       define variable slt-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     1989       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
     1990       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     1991       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
     1992       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
     1993       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
     1994       define variable transport-cli-locoprl          like ub.doc-line.price-rubl no-undo.
     1995       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
     1996       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
     1997       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     1998       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     1999       define variable varinvatp-envdoprl             as   character              no-undo.
     2000       define variable varinvatp-typeoprl             as   character              no-undo.
     2001     define buffer bf_price-list for ub.price-list.
     2002     define buffer bf_goods      for ub.goods.
     2003     define buffer bf_sysconf    for ub.sysconf.
     2004     define buffer bf_parts      for ub.parts.
     2005     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     2006     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     2007     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     2008     define variable varexcise      like ub.price-list.excise     no-undo.
     2009     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     2010     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     2011     define variable varprice-base  like ub.price-list.price-sale no-undo.
     2012     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     2013     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     2014     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     2015     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     2016     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     2017     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     2018     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     2019     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     2020     define variable varartic       like ub.price-list.artic      no-undo.
     2021     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     2022     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     2023     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     2024     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     2025     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     2026     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     2027     define variable vardoc-type     as   character              no-undo.
     2028     do
     2029     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     2030     :
     2031       find first bf_price-list no-lock
     2032         where recid(bf_price-list) = parrecid
     2033         no-error .
     2034       if not available bf_price-list
     2035       then do:
     2036         return error "Ошибка во входящих параметрах prl-vat.i" .
     2037       end.
     2038       find first bf_goods no-lock
     2039         where bf_goods.artic     = bf_price-list.artic
     2040           and bf_goods.prod-type = bf_price-list.prod-type
     2041           and bf_goods.prod-code = bf_price-list.prod-code
     2042         no-error .
     2043       if not available bf_goods
     2044       then do:
     2045         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     2046       end.
     2047       assign
     2048         varvat-pc = bf_price-list.vat-pc
     2049         varslt-pc = bf_price-list.slt-pc
     2050       .
     2051       if varvat-pc = ?
     2052       then do:
     2053         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2054       end.
     2055       if varslt-pc = ?
     2056       then do:
     2057         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2058       end.
     2059       assign
     2060         varbase-rate   = 1
     2061         varbase-scale  = 1
     2062         varroad-tax    = bf_price-list.road-tax
     2063         varexcise      = bf_price-list.excise
     2064         varprice-base  = bf_price-list.price-sale
     2065         varprice-rubl  = bf_price-list.price-sale
     2066         vardiscnt-base = 0
     2067         vardiscnt-rubl = 0
     2068       .
     2069       assign
     2070         varfact-qnty = 0
     2071       .
     2072       for each bf_parts no-lock
     2073         where bf_parts.out-code   = bf_price-list.doc-num
     2074           and bf_parts.obj-type   = bf_price-list.obj-type
     2075           and bf_parts.obj-code   = bf_price-list.obj-code
     2076           and bf_parts.artic      = bf_price-list.artic
     2077           and bf_parts.prod-type  = bf_price-list.prod-type
     2078           and bf_parts.prod-code  = bf_price-list.prod-code
     2079       :
     2080         assign
     2081           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     2082         .
     2083       end.
     2084       assign
     2085         vardoc-num   = bf_price-list.doc-num
     2086         vardoc-code  = bf_price-list.doc-num
     2087         varobj-type  = bf_price-list.obj-type
