      173         message
      174           vss-workfile vss-revision vss-description skip
      175           vss-include-info0 skip
      176           "Ошибка при определении цены признака на объекте" skip
      177           "Объект"     p-obj-type p-obj-code  skip
      178           "Бар-код"    v-root-b-code skip
      179           error-status :get-message(1) skip
      180           return-value skip
      181           view-as alert-box error .
      182         undo, return error .
      183       end.
      184       run prdoclib-init-temp-prt-obj in this-procedure
      185         (input p-obj-type
      186         ,input p-obj-code
      187         ,input p-artic
      188         ,input p-prod-type
      189         ,input p-prod-code
      190         ,input v-price-sale
      191         ) .
      192       find first buf_price-list no-lock
      193         where buf_price-list.doc-num    = v-doc-num
      194           and buf_price-list.price-type = ""
      195           and buf_price-list.b-code     = v-root-b-code
