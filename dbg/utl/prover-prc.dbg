       93     define input  parameter p-corr-time         as integer   no-undo .
       94     define input  parameter p-corr-time-str     as character no-undo .
       95     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
       96     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
       97     define buffer buf_gds-obj      for ub.gds-obj .
       98     define buffer buf_prt-obj      for ub.prt-obj .
       99     define buffer buf_price-list   for ub.price-list .
      100     define buffer buf_bar-code     for ub.bar-code .
