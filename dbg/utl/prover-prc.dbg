      432             "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
      433             view-as alert-box error .
      434           undo, return error .
      435         end.
      436       end.
      437       assign
      438         v-total-fact-sale = v-total-fact-sale
      439                           + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
      440       .
      441       if v-total-fact-sale = ?
      442       then do:
      443         message
      444           vss-workfile vss-revision vss-description skip
      445           vss-include-info0 skip
      446           "Ошибка при вычислении суммы в продажных ценах" skip
