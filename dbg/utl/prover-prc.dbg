       87     define input  parameter p-check-price-parts as logical   no-undo .
       88     define input  parameter p-doc-num           as character no-undo .
       89     define input  parameter p-fact-date         as date      no-undo .
       90     define input  parameter p-corr-user-db-num  as integer   no-undo .
       91     define input  parameter p-corr-user-name    as character no-undo .
