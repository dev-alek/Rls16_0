        1   block-level on error undo, throw.
        2   define input parameter parrvs-code like ub.rvs-doc.rvs-code no-undo.
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: clcavrgs.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: utl/clcavrgs.p $":U .
        8   define variable vss-description as character no-undo initial "Утилита по пересчету веса по средней плотности".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure clcavrgd:
       68   define input parameter parrvs-code like ub.rvs-doc.rvs-code no-undo.
       69   define buffer bf_rvs-doc    for ub.rvs-doc.
       70   define buffer bf_rvs-line   for ub.rvs-line.
       71   define buffer bf_goods      for ub.goods.
       72   define buffer prev_rvs-line for ub.rvs-line.
       73   define buffer prev_rvs-doc  for ub.rvs-doc.
       74   define variable varsystem-cli-avrg-qnty like ub.rvs-line.system-cli-avrg-qnty no-undo.
       75   define variable vardensity like ub.rvs-line.density no-undo.
       76   find first bf_rvs-doc where bf_rvs-doc.rvs-code = parrvs-code no-error.
       77   if not available bf_rvs-doc then return error "Неверный номер документа сверки(clcavrgd)".
       78   for each bf_rvs-line where bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code exclusive,
       79       first bf_goods where bf_goods.gds-code = bf_rvs-line.gds-code break by bf_rvs-line.gds-code on error undo, return error return-value :
       80       if first-of(bf_rvs-line.gds-code) then do:
       81          run str/avrgdens.p (input  bf_rvs-doc.obj-type,
       82                          input  bf_rvs-doc.obj-code,
       83                          input  bf_rvs-doc.shift-date,
       84                          input  bf_rvs-doc.shift-num,
       85                          input  bf_rvs-line.gds-code,
       86                          input  bf_rvs-doc.rvs-code,
       87                          input  no,
       88                          output vardensity) no-error.
       89          if error-status:error or
       90             vardensity = ?     then do:
       91             undo, return error.
       92          end.
       93       end.
       94       if bf_rvs-line.rvs-prev-code <> ? then do:
       95          find first prev_rvs-line where prev_rvs-line.rvs-code = bf_rvs-line.rvs-prev-code and
       96                                         prev_rvs-line.obj-type = bf_rvs-line.obj-type      and
       97                                         prev_rvs-line.obj-code = bf_rvs-line.obj-code      and
       98                                         prev_rvs-line.pl-code  = bf_rvs-line.pl-code       and
       99                                         prev_rvs-line.gds-code = bf_rvs-line.gds-code      no-lock no-error.
      100          if not available prev_rvs-line then do:
      101             undo, return error SUBSTITUTE
      102             ("Не найдена строка документа сверки с № &1 на которую имеет ссылку строка по складскому месту &2 товару &3 &4 &5 &6 .",
      103              bf_rvs-line.rvs-prev-code,
      104              bf_rvs-line.pl-code,
      105              bf_goods.artic,
      106              bf_goods.prod-type,
      107              bf_goods.prod-code,
      108              bf_goods.gds-name).
      109          end.
      110          find first prev_rvs-doc where prev_rvs-doc.rvs-code = prev_rvs-line.rvs-code No-LOCK No-ERROR.
      111          if not available prev_rvs-doc then do:
      112             undo, return error SUBSTITUTE
      113             ("Не найден документ сверки с № &1 на который имеет ссылку строка по складскому месту &2 товару &3 &4 &5 &6 .",
      114              bf_rvs-line.rvs-prev-code,
      115              bf_rvs-line.pl-code,
      116              bf_goods.artic,
      117              bf_goods.prod-type,
      118              bf_goods.prod-code,
      119              bf_goods.gds-name).
      120          end.
      121       end.
      122       else do:
      123          if bf_rvs-doc.rvs-type = 'смена':U then
      124             undo, return error SUBSTITUTE
      125            ("По складскому месту &1 товару &2 &3 &4 &5 нет ссылки на предыдущую сверку.",
      126             bf_rvs-line.pl-code,
      127             bf_goods.artic,
      128             bf_goods.prod-type,
      129             bf_goods.prod-code,
      130             bf_goods.gds-name).
      131      end.
      132      run calc_avrg_stock (input  bf_rvs-doc.shift-date,
      133                           input  bf_rvs-doc.shift-num,
      134                           input  bf_rvs-doc.obj-type,
      135                           input  bf_rvs-doc.obj-code,
      136                           input  bf_rvs-line.pl-code,
      137                           input  bf_rvs-line.gds-code,
      138                           input  vardensity,
      139                           output varsystem-cli-avrg-qnty) no-error.
      140      if error-status:error then do:
      141         undo, return error substitute ("Ошибка при расчета остатка по средней плотности &1.",return-value) .
      142      end.
      143      ASSIGN bf_rvs-line.system-cli-avrg-qnty =
      144             (if available prev_rvs-line then prev_rvs-line.system-cli-avrg-qnty else 0) + varsystem-cli-avrg-qnty.
      145      if bf_rvs-line.system-cli-avrg-qnty = ? then return error SUBSTITUTE
      146      ("Невозможно рассчитать вес по средней плотности для резервуара &1 товара &2 &3 &4 &5 .",
      147      bf_rvs-line.pl-code,
      148      bf_goods.artic,
      149      bf_rvs-line.obj-type,
      150      bf_rvs-line.obj-code,
      151      bf_goods.gds-name).
      152   end.
      153   end procedure.
      154   procedure calc_avrg_stock:
      155   define input  parameter parshift-date            like ub.rvs-doc.shift-date           no-undo.
      156   define input  parameter parshift-num             like ub.rvs-doc.shift-num            no-undo.
      157   define input  parameter parobj-type              like ub.rvs-doc.obj-type             no-undo.
      158   define input  parameter parobj-code              like ub.rvs-doc.obj-code             no-undo.
      159   define input  parameter parpl-code               like ub.rvs-line.pl-code             no-undo.
      160   define input  parameter pargds-code              like ub.rvs-line.gds-code            no-undo.
      161   define input  parameter pardensity               like ub.rvs-line.density             no-undo.
      162   define output parameter parsystem-cli-avrg-qnty  like ub.rvs-doc.system-cli-avrg-qnty no-undo.
      163   define buffer bf_trn-doc  for ub.trn-doc.
      164   define buffer bf_doc-line for ub.doc-line.
      165   define buffer bf_doc-pl   for ub.doc-pl.
      166   define buffer bf_goods    for ub.goods.
      167   find first bf_goods where bf_goods.gds-code = pargds-code no-lock.
      168   for each bf_trn-doc where bf_trn-doc.obj-type   = parobj-type   and
      169                             bf_trn-doc.obj-code   = parobj-code   and
      170                             bf_trn-doc.shift-date = parshift-date and
      171                             bf_trn-doc.shift-num  = parshift-num  and
      172                             bf_trn-doc.status_    = 'факт':U       no-lock,
      173       first bf_doc-line where bf_doc-line.doc-code  = bf_trn-doc.doc-code and
      174                               bf_doc-line.artic     = bf_goods.artic      and
      175                               bf_doc-line.prod-type = bf_goods.prod-type  and
      176                               bf_doc-line.prod-code = bf_goods.prod-code  no-lock,
      177             first bf_doc-pl where bf_doc-pl.out-code = bf_trn-doc.doc-code and
      178                                   bf_doc-pl.gds-code = pargds-code         and
      179                                   bf_doc-pl.obj-type = parobj-type         and
      180                                   bf_doc-pl.obj-code = parobj-code         and
      181                                   bf_doc-pl.pl-code  = parpl-code:
      182       if lookup (bf_trn-doc.ext-doc-type, 'ie,re,iv,rv,im,io':U) > 0 then do:
      183          if bf_trn-doc.ext-doc-type = 'ie':U then do:
      184             assign parsystem-cli-avrg-qnty = parsystem-cli-avrg-qnty + bf_doc-line.fact-density * bf_doc-pl.fact-qnty.
      185          end.
      186          else
      187             assign parsystem-cli-avrg-qnty = parsystem-cli-avrg-qnty + pardensity * bf_doc-pl.fact-qnty.
      188       end.
      189       else do:
      190          if lookup (bf_trn-doc.ext-doc-type, 'ee,ep,es,rs,we,vt,vp,ap,mp,pc,ev,em,wm,eo':U) > 0 then do:
      191             if lookup (bf_trn-doc.ext-doc-type, 'vt,vp,rs':U) > 0 then do:
      192                assign parsystem-cli-avrg-qnty = parsystem-cli-avrg-qnty + pardensity * bf_doc-pl.fact-qnty.
      193             end.
      194             else do:
      195                assign parsystem-cli-avrg-qnty = parsystem-cli-avrg-qnty - pardensity * bf_doc-pl.fact-qnty.
      196             end.
      197          end.
      198          else return error SUBSTITUTE
      199          ("Документ &1. Расширенный тип документа &2. Невозможно определить, реализация или поступление.",
      200          bf_trn-doc.doc-code,
      201          bf_trn-doc.ext-doc-type).
      202       end.
      203   end.
      204   end procedure.
      205   do
      206   on error undo, return error return-value
      207   :
      208     define buffer bf_rvs-doc  for ub.rvs-doc.
      209     define buffer bf_rvs-line for ub.rvs-line.
      210     find first bf_rvs-doc
      211       where bf_rvs-doc.rvs-code = parrvs-code no-error
      212       .
      213     if not available bf_rvs-doc
      214     then do:
      215       message
      216         "Ошибка входных параметров" skip
      217         view-as alert-box error .
      218       return error.
      219     end.
      220     run clcavrgd
      221       (input bf_rvs-doc.rvs-code
      222       ) no-error .
      223     if error-status :error then do:
      224       return error .
      225     end.
      226   end.
