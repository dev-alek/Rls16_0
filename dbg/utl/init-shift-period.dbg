      588   procedure placelib_write-attr:
      589   define input  parameter p-code     like ub.place-attr.attr-code .
      590   define input  parameter p-obj-code like ub.place-attr.obj-code .
      591   define input  parameter p-obj-type like ub.place-attr.obj-type .
      592   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      593   define input  parameter p-value    like ub.place-attr.attr-value .
      594   define output parameter p-ok       as logical.
      595   define buffer buf_place-attr for ub.place-attr .
      596     do on error undo, return error return-value :
      597        p-ok = false.
      598        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      599                                                   and buf_place-attr.obj-code    = p-obj-code
      600                                                   and buf_place-attr.obj-type    = p-obj-type
      601                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      602        if not available buf_place-attr then do :
      603           create buf_place-attr.
      604           assign
      605             buf_place-attr.attr-code   = p-code
      606             buf_place-attr.attr-value  = p-value
      607             buf_place-attr.obj-code    = p-obj-code
      608             buf_place-attr.obj-type    = p-obj-type
      609             buf_place-attr.pl-code     = p-pl-code
      610           .
      611           p-ok = true.
      612        end.
      613        else do:
      614           buf_place-attr.attr-value  = p-value .
      615           p-ok = true.
      616        end.
      617     end.
      618   end.
      619   procedure placelib_get-attr:
      620   define input  parameter  p-code     like ub.place-attr.attr-code .
      621   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      622   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      623   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      624   define output parameter  p-value    like ub.place-attr.attr-value .
      625   define output parameter  p-ok       as logical.
      626   define buffer buf_place-attr for ub.place-attr .
      627     do on error undo, return error return-value :
      628        p-ok = false.
      629        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      630                                                   and buf_place-attr.obj-code    = p-obj-code
      631                                                   and buf_place-attr.obj-type    = p-obj-type
      632                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      633        if available buf_place-attr then do :
      634          p-value = buf_place-attr.attr-value.
      635          p-ok = true.
      636        end.
      637        else do :
      638          p-ok = false.
      639        end.
      640     end.
      641   end.
      642   procedure placelib_del-attr:
      643   define input parameter  p-code     like ub.place-attr.attr-code .
      644   define input parameter  p-obj-code like ub.place-attr.obj-code .
      645   define input parameter  p-obj-type like ub.place-attr.obj-type .
      646   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      647   define input parameter  p-value    like ub.place-attr.attr-value .
      648   define output parameter p-ok       as logical.
      649   define buffer buf_place-attr for ub.place-attr .
      650     do on error undo, return error return-value :
      651        p-ok = false.
      652        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      653                                                   and buf_place-attr.obj-code    = p-obj-code
      654                                                   and buf_place-attr.obj-type    = p-obj-type
      655                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      656        if available buf_place-attr then do :
      657           delete buf_place-attr.
      658           p-ok = true.
      659        end.
      660     end.
      661   end.
      662   define input parameter p-rid-list as character no-undo .
      663   define buffer buf_place for ub.place .
      664   define buffer buf_pl-gds for ub.pl-gds .
      665   define buffer buf_place-attr for ub.place-attr .
      666   define buffer buf_rvs-doc for ub.rvs-doc .
      667   define buffer buf_rvs-line for ub.rvs-line .
      668   define variable ii as integer no-undo .
      669   define variable v-value as character no-undo .
      670   define variable par-type as character no-undo .
      671   define variable v-ok as logical no-undo .
      672   find first sys-ctrl no-lock no-error.
      673   if not available sys-ctrl then return error return-value .
      674   if p-rid-list = "all"
      675   then do :
      676     for each buf_place no-lock :
      677       find first buf_pl-gds no-lock where buf_pl-gds.pl-code = buf_place.pl-code no-error .
      678       if not available buf_pl-gds then next .
      679           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      680         (input  buf_pl-gds.gds-code
      681         ,input  'fuel-type':U
      682         ,output v-value
      683         ,output par-type) no-error.
      684       if v-value = "lgas"
      685       or v-value = "metan"
      686       or v-value = "propan"
      687       then next .
      688       run placelib_get-attr  ( input "place-com-tanks"
      689                               ,input buf_place.obj-code
      690                               ,input buf_place.obj-type
      691                               ,input buf_place.pl-code
      692                               ,output v-value
      693                               ,output v-ok      ) no-error.
      694       if v-ok
      695       and v-value > ""
      696       then do :
      697         run placelib_get-attr  ( input "place-is-main"
      698                                 ,input buf_place.obj-code
      699                                 ,input buf_place.obj-type
      700                                 ,input buf_place.pl-code
      701                                 ,output v-value
      702                                 ,output v-ok      ) no-error.
      703         if v-ok
      704         and v-value > ""
      705         and logical(v-value)
      706         then do :
      707         end .
      708         else do :
      709           next .
      710         end .
      711       end .
      712       run init_ .
      713     end .
      714   end .
      715   else do :
      716     do ii = 1 to num-entries(p-rid-list) :
      717       for first buf_place no-lock where recid(buf_place) = integer(entry(ii, p-rid-list)) :
      718         find first buf_pl-gds no-lock where buf_pl-gds.pl-code = buf_place.pl-code no-error .
      719         if not available buf_pl-gds then next .
      720               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      721           (input  buf_pl-gds.gds-code
      722           ,input  'fuel-type':U
      723           ,output v-value
      724           ,output par-type) no-error.
      725         if v-value = "lgas"
      726         or v-value = "metan"
      727         or v-value = "propan"
      728         then next .
      729         run placelib_get-attr  ( input "place-com-tanks"
      730                                 ,input buf_place.obj-code
      731                                 ,input buf_place.obj-type
      732                                 ,input buf_place.pl-code
      733                                 ,output v-value
      734                                 ,output v-ok      ) no-error.
      735         if v-ok
      736         and v-value > ""
      737         then do :
      738           run placelib_get-attr  ( input "place-is-main"
      739                                   ,input buf_place.obj-code
      740                                   ,input buf_place.obj-type
      741                                   ,input buf_place.pl-code
      742                                   ,output v-value
      743                                   ,output v-ok      ) no-error.
      744           if v-ok
      745           and v-value > ""
      746           and logical(v-value)
      747           then do :
      748           end .
      749           else do :
      750             next .
      751           end .
      752         end .
      753         run init_ .
      754       end .
      755     end .
      756   end .
      757   procedure init_ :
      758     for each buf_rvs-doc no-lock where buf_rvs-doc.obj-type = buf_place.obj-type
      759                                    and buf_rvs-doc.obj-code = buf_place.obj-code
      760                                    and buf_rvs-doc.status_  = 'факт':U
      761                                    and buf_rvs-doc.rvs-type = 'смена':U
      762                                    use-index shift :
      763       find first buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
      764                                         and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
      765                                         and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
      766                                         and buf_rvs-line.pl-code  = buf_pl-gds.pl-code
      767                                         and buf_rvs-line.gds-code = buf_pl-gds.gds-code
      768                                         no-error .
      769       if available buf_rvs-line
      770       then do :
      771         find first buf_place-attr exclusive-lock where buf_place-attr.obj-type = buf_place.obj-type
      772                                                    and buf_place-attr.obj-code = buf_place.obj-code
      773                                                    and buf_place-attr.pl-code  = buf_place.pl-code
      774                                                    and buf_place-attr.attr-code = "init-shift-period-rvs"
      775                                                    no-error .
      776         if not available buf_place-attr
      777         then do :
      778           create buf_place-attr .
      779           assign
      780             buf_place-attr.obj-type = buf_place.obj-type
      781             buf_place-attr.obj-code = buf_place.obj-code
      782             buf_place-attr.pl-code  = buf_place.pl-code
      783             buf_place-attr.attr-code = "init-shift-period-rvs"
      784           .
      785         end .
      786         assign buf_place-attr.attr-value = buf_rvs-doc.rvs-code .
      787         leave .
      788       end .
      789     end .
      790   end procedure .
