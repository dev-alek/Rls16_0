        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: incligds.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/incligds.p $":U .
        8   define variable vss-description as character no-undo init "Расчет товарного архива (приход, расход, возврат) по контрагентам" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     run mainmenu_getcntxt in parparentproc
       80       (output v-cntxt-db-num
       81       ,output v-cntxt-userid
       82       ,output v-cntxt-level
       83       ,output v-cntxt-host-code-obj
       84       ,output v-cntxt-obj-type
       85       ,output v-cntxt-obj-code
       86       ,output v-cntxt-db-num-obj
       87       ,output v-cntxt-is-admin
       88       ) .
       89   define temp-table temp-trn-doc no-undo
       90     field doc-code as character
       91     index xpk is primary unique doc-code
       92   .
       93   define variable v-ind       as integer   no-undo .
       94   define variable v-action    as character no-undo .
       95   define variable v-firm-name as character no-undo .
       96   define variable v-rid-list  as character no-undo .
       97   define buffer in-doc for ub.trn-doc .
       98   define frame a
       99     v-firm-name format "x(30)"       label "Фирма" skip
      100     v-action    format "x(30)"       no-label            skip
      101     v-ind       format ">>>,>>>,>>9" label "Обработано"  skip
      102     with three-d view-as dialog-box centered side-labels
      103     title "Итоговые значения по товарам по контрагентам"
      104     .
      105   define variable v-select-firm as logical   no-undo .
      106   define variable v-host-code   as integer   no-undo .
      107   define variable v-num         as integer   no-undo .
      108   define buffer buf_dis-card     for ub.dis-card  .
      109   define buffer buf_shop         for ub.shop      .
      110   define buffer buf_chk-doc      for ub.chk-doc   .
      111   define buffer buf_trn-doc      for ub.trn-doc   .
      112   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   def new shared temp-table cli-list no-undo like ub.clients
      114     field to-del as logical
      115     index obj  is primary unique obj-type obj-code
      116     index cli-name      obj-name
      117     .
      118   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define  new shared  temp-table cli-list-hist no-undo
      120   field list-table as character
      121   field id as integer
      122   field line as integer
      123   field hist-mode as character
      124   field des as character
      125   field num-recs as integer
      126   field option_ as character
      127   field item_ as character
      128   field status_ as character
      129   field num-add as integer
      130   field num-ignored as integer
      131   field done as logical
      132   field err_ as logical
      133   field err-mes as character
      134   index pi is primary
      135   id
      136   line
      137   index isdone
      138   done
      139   .
      140   do
      141   on error undo, return error return-value
      142   :
      143     run gbl/d-askw.w
      144       (input "Вопрос"
      145       ,input "Инициализация расчета Итоговых значений по товарам по контрагентам  (приход, расход, возврат)" + chr(10)
      146       ,input "|^"
      147       ,input "Все фирмы^confirm|Выбрать фирму|Отмена"
      148       ,input "|"
      149           + "|"
      150           + ""
      151       ,input 1
      152       ,input 3
      153       ,output v-num
      154       ).
      155     case v-num
      156     :
      157       when 1
      158       then do:
      159         assign
      160           v-select-firm = false
      161         .
      162       end.
      163       when 2
      164       then do:
      165         assign
      166           v-select-firm = true
      167         .
      168       end.
      169       when 3
      170       then do:
      171         return .
      172       end.
      173       otherwise do:
      174         message
      175           vss-workfile vss-revision vss-description skip
      176           "Неизвестное значение v-num" v-num skip
      177           view-as alert-box error .
      178         undo, return error return-value .
      179       end.
      180     end.
      181     if v-select-firm = true
      182     then do:
      183       run adm/sconfs.w
      184         (input  parparentproc
      185         ,input  'b-sel':U
      186         ,input  no
      187         ,input  v-cntxt-host-code-obj
      188         ,output v-host-code
      189         ,input-output v-rid-list
      190         ) no-error.
      191       if error-status :error
      192       or v-host-code = 0
      193       or v-host-code = ?
      194       then do:
      195         return .
      196       end.
      197     end.
      198     define variable v-select-clients as logical   no-undo .
      199     define variable v-select-ok      as logical   no-undo .
      200     run gbl/d-askw.w
      201       (input "Вопрос"
      202       ,input "Инициализация расчета Итоговых значений по товарам по контрагентам  (приход, расход, возврат)" + chr(10)
      203       ,input "|^"
      204       ,input "Все контрагенты^confirm|Выбрать контрагентов|Отмена"
      205       ,input "|"
      206           + "|"
      207           + ""
      208       ,input 1
      209       ,input 3
      210       ,output v-num
      211       ).
      212     case v-num
      213     :
      214       when 1
      215       then do:
      216         assign
      217           v-select-clients = false
      218         .
      219       end.
      220       when 2
      221       then do:
      222         assign
      223           v-select-clients = true
      224         .
      225       end.
      226       when 3
      227       then do:
      228         return .
      229       end.
      230       otherwise do:
      231         message
      232           vss-workfile vss-revision vss-description skip
      233           "Неизвестное значение v-num" v-num skip
      234           view-as alert-box error .
      235         undo, return error return-value .
      236       end.
      237     end.
      238     for each cli-list:
      239       delete cli-list.
      240     end.
      241     if v-select-clients = true
      242     then do:
      243       run str/cli-list.w (
      244                       input parparentproc
      245                       ,input v-cntxt-host-code-obj
      246                       ,input v-cntxt-obj-type
      247                       ,input v-cntxt-obj-code
      248         ) .
      249       if not can-find(first cli-list)
      250       then do:
      251         message
      252         "Не выбрано ни одного контрагента"
      253         view-as alert-box .
      254         return .
      255       end.
      256     end.
      257     else do:
      258       create cli-list.
      259     end.
      260     define variable v-ok as logical no-undo .
      261     assign
      262       v-ok = true
      263     .
      264     message
      265       "Вы хотите пересчитать Итоговые значения  по контрагентам" skip
      266       "Выбраны" skip
      267       "Фирмы:      " (if v-select-firm
      268                       then "код " + string(v-host-code)
      269                       else "ВСЕ"
      270                       ) skip
      271       "Контрагенты:" (if v-select-clients
      272                       then "по списку"
      273                       else "ВСЕ"
      274                       ) skip
      275       "Суммы оборота по контрагенту будут рассчитаны на основании складских документов" skip
      276       "Внимание!" skip
      277       "На обрезанной базе данных суммы оборота будут отражать не реальный оборот по контрагенту" skip
      278       "а суммарный оборот по всем документам, которые имеются в базе данных" skip
      279       "" skip
      280       "Продолжить?" skip
      281       view-as alert-box question buttons yes-no update v-ok .
      282     if v-ok <> true
      283     then do:
      284       return .
      285     end.
      286     view frame a.
      287     for each ub.sysconf no-lock
      288       where v-select-firm = false
      289         or ( ub.sysconf.host-code = v-host-code)
      290     :
      291       define buffer buf_clients for ub.clients .
      292       find buf_clients no-lock
      293         where buf_clients.obj-type = 'орг':U
      294           and buf_clients.obj-code = ub.sysconf.host-code
      295         .
      296       assign
      297         v-firm-name = buf_clients.obj-name
      298       .
      299       for each cli-list no-lock ,
      300         first ub.clients no-lock where
      301               v-select-clients = false
      302               or (ub.clients.obj-type = cli-list.obj-type
      303                   and
      304                   ub.clients.obj-code = cli-list.obj-code)
      305       :
      306         assign
      307           v-action = "Очистка ..."
      308         .
      309         for each ub.cli-gds exclusive-lock
      310           where ub.cli-gds.host-code = ub.sysconf.host-code
      311             and ub.cli-gds.cli-type  = ub.clients.obj-type
      312             and ub.cli-gds.cli-code  = ub.clients.obj-code
      313         :
      314           assign
      315             v-ind = v-ind + 1
      316           .
      317           if v-ind modulo 10 = 0
      318           then do:
      319             display
      320               v-ind
      321               v-action
      322               v-firm-name
      323               with frame a.
      324           end.
      325           assign
      326             ub.cli-gds.in-code    = ""
      327             ub.cli-gds.price-cli  = 0
      328             ub.cli-gds.exch-code  = 0
      329             ub.cli-gds.unit-cli   = ""
      330             ub.cli-gds.in-rubl    = 0
      331             ub.cli-gds.in-base    = 0
      332             ub.cli-gds.in-qnty    = 0
      333             ub.cli-gds.out-sum    = 0
      334             ub.cli-gds.out-discnt = 0
      335             ub.cli-gds.out-qnty   = 0
      336             ub.cli-gds.ret-sum    = 0
      337             ub.cli-gds.ret-discnt = 0
      338             ub.cli-gds.ret-qnty   = 0
      339           .
      340         end.
      341       end.
      342       assign
      343         v-action = "Обработка документов"
      344         v-ind    = 0
      345       .
      346       if v-select-clients = true
      347       then do:
      348         for each buf_trn-doc no-lock
      349           where buf_trn-doc.host-code = ub.sysconf.host-code
      350             and buf_trn-doc.status_   = 'факт':U
      351             and buf_trn-doc.internal  = no
      352             and buf_trn-doc.doc-type  <> 'инв':U
      353             and buf_trn-doc.cli-type  = ub.clients.obj-type
      354             and buf_trn-doc.cli-code  = ub.clients.obj-code
      355         use-index host-date
      356         :
      357           assign
      358             v-ind = v-ind + 1
      359           .
      360           if v-ind modulo 10 = 0
      361           then do:
      362             display
      363               v-ind
      364               v-action
      365               v-firm-name
      366               with frame a.
      367           end.
      368           run trg/trn-supp.p
      369             (input  buf_trn-doc.doc-code
      370             ,input  true
      371             ,input  false
      372             ,input  false
      373             ) .
      374         end.
      375         for each buf_dis-card no-lock
      376           where buf_dis-card.cli-type = ub.clients.obj-type
      377             and buf_dis-card.cli-code = ub.clients.obj-code
      378         on error undo, return error return-value
      379         :
      380           _buf_chk-doc:
      381           for each buf_shop no-lock
      382             where buf_shop.host-code = ub.sysconf.host-code
      383           ,each buf_chk-doc no-lock
      384             where buf_chk-doc.obj-type = 'маг':U
      385               and buf_chk-doc.obj-code = buf_shop.obj-code
      386               and buf_chk-doc.d-card   = buf_dis-card.d-card
      387           :
      388             if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then NEXT _buf_chk-doc.
      389             run str/trnsupds.p
      390               (input buf_chk-doc.doc-code
      391               ,input true
      392               ) .
      393           end.
      394         end.
      395       end.
      396       else do:
      397         for each buf_trn-doc no-lock
      398           where buf_trn-doc.host-code = ub.sysconf.host-code
      399             and buf_trn-doc.status_   = 'факт':U
      400             and buf_trn-doc.internal  = no
      401             and buf_trn-doc.doc-type  <> 'инв':U
      402         use-index host-date
      403         :
      404           assign
      405             v-ind = v-ind + 1
      406           .
      407           if v-ind modulo 10 = 0
      408           then do:
      409             display
      410               v-ind
      411               v-action
      412               v-firm-name
      413               with frame a.
      414           end.
      415           run trg/trn-supp.p
      416             (input  buf_trn-doc.doc-code
      417             ,input  true
      418             ,input  false
      419             ,input  true
      420             ) .
      421         end.
      422       end.
      423     end.
      424     message
      425       "Итоговые значения (приход, расход, возврат) по контрагентам" skip
      426       "Выбраны" skip
      427       "Фирмы:      " (if v-select-firm
      428                       then "код " + string(v-host-code)
      429                       else "ВСЕ"
      430                       ) skip
      431       "Контрагенты:" (if v-select-clients
      432                       then "по списку"
      433                       else "ВСЕ"
      434                       ) skip
      435       "" skip
      436       "Инициализация приходов, расходов, возвратов закончена успешно." skip
      437       view-as alert-box information .
      438   end.
