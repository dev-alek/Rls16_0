        1   block-level on error undo, throw.
        2   define input  parameter iKey     as integer no-undo.
        3   define output parameter oChekSum as character no-undo.
        4   if userid("ub") eq ""
        5   then do:
        6      oChekSum = encode(string(iKey * 13)) + string(index(encode(string(iKey)), "k"))
        7    .
        8      return.
        9   end.
       10   def input parameter p-type as int.
       11   def input parameter p-obj as int.
       12   def input parameter p-date as date.
       13   disable triggers for load of chk-gds-pay.
       14   if p-type <= 0 then return.
       15   if p-obj = 0 then do:
       16       for each chk-doc where chk-doc.chk-type = 6
       17                          and chk-doc.chk-date >= p-date
       18                          and (   p-type eq ?
       19                               or can-find(first chk-pay of chk-doc where pay-code = p-type no-lock))
       20       no-lock:
       21           for each chk-gds-pay of chk-doc:
       22               delete chk-gds-pay.
       23           end.
       24       end.
       25       for each chk-doc where chk-doc.chk-type = 1
       26                          and chk-doc.chk-date >= p-date
       27                          and (   p-type eq ?
       28                               or can-find(first chk-pay of chk-doc where pay-code = p-type no-lock) )
       29        no-lock:
       30           for each chk-gds-pay of chk-doc:
       31               delete chk-gds-pay.
       32           end.
       33       end.
       34   end.
       35   else do:
       36       for each chk-doc where chk-doc.chk-type = 6
       37                          and chk-doc.chk-date >= p-date
       38                          and chk-doc.obj-type = 'маг'
       39                          and chk-doc.obj-code = p-obj
       40                          and (   p-type eq ?
       41                               or can-find(first chk-pay of chk-doc where pay-code = p-type no-lock))
       42       no-lock:
       43           for each chk-gds-pay of chk-doc:
       44               delete chk-gds-pay.
       45           end.
       46       end.
       47       for each chk-doc where chk-doc.chk-type = 1
       48                          and chk-doc.chk-date >= p-date
       49                          and chk-doc.obj-code = p-obj
       50                          and (   p-type eq ?
       51                               or can-find(first chk-pay of chk-doc where pay-code = p-type no-lock))
       52       no-lock:
       53           for each chk-gds-pay of chk-doc:
       54               delete chk-gds-pay.
       55           end.
       56       end.
       57   end.
