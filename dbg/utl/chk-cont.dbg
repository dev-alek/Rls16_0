        1   block-level on error undo, throw.
        2   define input parameter parParentProc as handle           no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":u .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
        6   define variable vss-workfile    as character no-undo init "$Workfile: chk-cont.p $":u .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/chk-cont.p $":u .
        8   define variable vss-description as character no-undo init "утилита проверка привязки партий и складских документов к договору поставщика " .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure cur-time :
       71      define output parameter p-today as date      no-undo .
       72      define output parameter p-time  as integer   no-undo .
       73     do
       74     on error undo, return error
       75     :
       76       define variable v-date1 as date      no-undo .
       77       define variable v-date2 as date      no-undo .
       78       define variable v-time  as integer   no-undo .
       79       assign
       80         v-date1 = today
       81         v-time  = time
       82         v-date2 = today
       83       .
       84       if v-date1 <> v-date2
       85       then do:
       86         assign
       87           v-date1 = today
       88           v-time  = v-time
       89         .
       90       end.
       91       assign
       92         p-today = v-date1
       93         p-time  = v-time
       94       .
       95     end.
       96   end.
       97   function cur-time-date returns character
       98   :
       99     return string(today, '99/99/9999':U) .
      100   end.
      101   function cur-time-mjd returns decimal
      102   :
      103     define variable v-date as date      no-undo .
      104     define variable v-time as integer   no-undo .
      105     run cur-time in this-procedure
      106       (output v-date
      107       ,output v-time
      108       ) .
      109     return integer(v-date) - 2400002 + (v-time / 86400) .
      110   end.
      111   function cur-time-get-ending-index returns integer
      112   (input p-number as integer
      113   )
      114   :
      115     if p-number < 0
      116     or p-number = ?
      117     then do:
      118       return 1 .
      119     end.
      120     define variable v-rest as integer   no-undo .
      121     assign
      122       p-number = p-number modulo 100
      123     .
      124     if p-number < 20
      125     then do:
      126       assign
      127         v-rest = p-number
      128       .
      129     end.
      130     else do:
      131       assign
      132         v-rest = p-number modulo 10
      133       .
      134     end.
      135     case v-rest :
      136       when 1
      137       then do:
      138         return 2 .
      139       end.
      140       when 2 or
      141       when 3 or
      142       when 4
      143       then do:
      144         return 3 .
      145       end.
      146       otherwise do:
      147         return 1 .
      148       end.
      149     end case .
      150   end.
      151   procedure cur-time-mjd-to-date :
      152      define input  parameter i-mjd-diff as decimal no-undo.
      153      define output parameter o-Date     as date    no-undo.
      154      define output parameter o-Time     as integer no-undo.
      155      define variable v-day-number as integer   no-undo .
      156      if    i-mjd-diff < 0
      157         or i-mjd-diff = ?
      158      then do:
      159         return "?" .
      160      end.
      161      assign
      162         v-day-number = truncate(i-mjd-diff,0).
      163         o-Date = date(v-day-number + 2400002).
      164         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      165     .
      166   end.
      167   function cur-time-mjd-to-string returns character
      168   (input p-mjd-diff as decimal
      169   )
      170   :
      171     define variable v-day-number as integer   no-undo .
      172     define variable v-seconds    as integer   no-undo .
      173     define variable v-hour       as integer   no-undo .
      174     define variable v-min        as integer   no-undo .
      175     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      176     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      177     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      178     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      179     if p-mjd-diff < 0
      180     or p-mjd-diff = ?
      181     then do:
      182       return "?" .
      183     end.
      184     assign
      185       v-day-number = integer(truncate(p-mjd-diff,0))
      186       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188     if v-seconds > 86400
      189     then do:
      190       assign
      191         v-seconds = 86400 - 1
      192       .
      193     end.
      194     if v-seconds < 0
      195     then do:
      196       assign
      197         v-seconds = 0
      198       .
      199     end.
      200     assign
      201       v-hour = truncate(v-seconds / 3600, 0)
      202     .
      203     assign
      204       v-seconds = v-seconds modulo 3600
      205     .
      206     assign
      207       v-min = truncate(v-seconds / 60, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 60
      211     .
      212     return
      213         (if v-day-number <> 0
      214           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0
      218           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      222           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      223           else ""
      224         )
      225       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      226       .
      227   end.
      228   function cur-time-string returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-string-sec returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      247   end.
      248   function cur-time-custom  returns character
      249   (input p-prefix as character
      250   ,input p-date-format as character
      251   ,input p-delimiter as character
      252   ,input p-time-format as character
      253   ,input p-suffix as character
      254   )
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return
      263       p-prefix
      264       + string(v-date, p-date-format)
      265       + p-delimiter
      266       + string(v-time, p-time-format)
      267       + p-suffix
      268       .
      269   end.
      270   function cur-time-print  returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-datetime returns datetime
      281   :
      282     define variable v-char as character no-undo .
      283     define variable v-datetime as datetime no-undo .
      284     v-char = cur-time-string().
      285     v-datetime = datetime(v-char).
      286     return  v-datetime.
      287   end.
      288   function cur-time-string-msec returns character
      289   :
      290     define variable v-date as datetime  no-undo .
      291     v-date = now.
      292     return string(v-date) .
      293   end.
      294   define new global shared variable g#libtfarh as handle no-undo .
      295   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296     define variable v-cntxt-db-num        as integer   no-undo .
      297     define variable v-cntxt-userid        as character no-undo .
      298     define variable v-cntxt-level         as character no-undo .
      299     define variable v-cntxt-host-code-obj as integer   no-undo .
      300     define variable v-cntxt-obj-type      as character no-undo .
      301     define variable v-cntxt-obj-code      as integer   no-undo .
      302     define variable v-cntxt-db-num-obj    as integer   no-undo .
      303     define variable v-cntxt-is-admin      as logical   no-undo .
      304   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305     run mainmenu_getcntxt in parparentproc
      306       (output v-cntxt-db-num
      307       ,output v-cntxt-userid
      308       ,output v-cntxt-level
      309       ,output v-cntxt-host-code-obj
      310       ,output v-cntxt-obj-type
      311       ,output v-cntxt-obj-code
      312       ,output v-cntxt-db-num-obj
      313       ,output v-cntxt-is-admin
      314       ) .
      315   define variable g#host-code as integer   no-undo .
      316   define variable g#host-name as character no-undo .
      317     os-delete 'chk-cont.log' .
      318   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319       def var log-file-name as char no-undo.
      320       assign
      321           log-file-name = 'chk-cont.log'
      322       .
      323       if log-file-name <> "":U
      324       then do:
      325           if search( 'chk-cont.log' ) = ?
      326           then do:
      327               output to value( 'chk-cont.log' ).
      328               output close.
      329           end.
      330       end.
      331       DEF STREAM stm-log.
      332       PROCEDURE writelog:
      333       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      334       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      335       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      336       if p-file-name <> ""
      337       then do:
      338       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      339           PUT STREAM stm-log UNFORMATTED chr(10).
      340           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      341                                           OR p-log-string = "&Line") THEN "" ELSE
      342                                           cur-time-string-sec() + " ").
      343           PUT STREAM stm-log UNFORMATTED
      344                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      345                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      346                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      347       OUTPUT STREAM stm-log CLOSE.
      348       end.
      349       END PROCEDURE.
      350     define variable Counter1 as integer   no-undo .
      351     define variable doc-list as character no-undo .
      352     define variable s-list as character no-undo .
      353     define variable ii as integer   no-undo .
      354     define buffer buf_clients for clients .
      355     define buffer buf_trn-doc for trn-doc .
      356     define buffer buf_parts for parts.
      357     define buffer buf_parts-attr for parts-attr.
      358     run ref/cli-all.w ( parParentProc, "b-sel,b-mark", 'орг':U, 'все':U, 'текущие':U, ?, "yes,yes,yes,,,,ИЛИ,,":u, "without-obj":U, output doc-list ) .
      359     if doc-list <> "" then do:
      360       assign  Counter1 = 0 .
      361   if session :set-wait-state( "compiler" ) then.
      362   define variable v-account as integer init 0 no-undo .
      363   define variable v-account-lavel as character no-undo .
      364   define variable v-button-stop as logical no-undo .
      365   define variable v-kol-spice as integer no-undo .
      366   define variable v-kol-spice2 as integer no-undo .
      367   define variable v-kol-spice3 as integer no-undo .
      368   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      369   DEFINE BUTTON StopBtn AUTO-END-KEY
      370        LABEL "Стоп"
      371        SIZE 10 BY 1.
      372   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      373        LABEL "Обработано записей"
      374         VIEW-AS TEXT
      375        SIZE 14 BY .67 NO-UNDO.
      376   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      377         VIEW-AS TEXT
      378        SIZE 53.25 BY .67
      379        FGCOLOR 1  NO-UNDO.
      380   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      381         VIEW-AS TEXT
      382        SIZE 53.25 BY .67
      383        FGCOLOR 1  NO-UNDO.
      384   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      385         VIEW-AS TEXT
      386        SIZE 53.25 BY .67
      387        FGCOLOR 1  NO-UNDO.
      388   DEFINE RECTANGLE RECT-1
      389        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      390        SIZE 55.13 BY 4.46.
      391   DEFINE FRAME InfoFrame
      392        StopBtn AT ROW 4.25 COL 21.75
      393        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      394        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      395        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      396        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      397        RECT-1 AT ROW 1 COL 1
      398       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      399            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      400            TITLE "Процесс"
      401            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      402   define variable mFrameView      as logical   no-undo init yes.
      403     define variable mFramHandle as handle no-undo.
      404     mFramHandle = frame InfoFrame:handle.
      405     if  log-manager:logfile-name ne ?
      406     then DO:
      407         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      408         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      409         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      410     end.
      411     mFrameView = not session:batch-mode and mFramHandle:visible.
      412     if mFrameView
      413     then do:
      414       ASSIGN
      415          FRAME InfoFrame:HIDDEN                           = TRUE
      416          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      417     end.
      418   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      419   DO:
      420     IF not StopProcessing THEN
      421       Message "Вы действительно хотите прервать" SKIP
      422               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      423                 UPDATE StopProcessing.
      424     IF StopProcessing THEN do:
      425        if mFrameView
      426        then do:
      427           HIDE FRAME InfoFrame.
      428        end.
      429     End.
      430   END.
      431   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
      432     if  log-manager:logfile-name ne ?
      433     then DO:
      434         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      435     end.
      436     if not session:batch-mode then
      437     do:
      438       VIEW FRAME InfoFrame.
      439       mFrameView = true.
      440     end.
      441      v-button-stop = false .
      442         if mFrameView
      443         then do:
      444         if v-button-stop then view STOPBTN in frame InfoFrame.
      445                          else Hide STOPBTN in frame InfoFrame.
      446         end.
      447       do ii = 1 to num-entries(doc-list):
      448         find first buf_clients no-lock where RECID(buf_clients) = integer(entry(ii, doc-list)) no-error.
      449         assign s-list = "Поставщик " + buf_clients.obj-name .
      450         run writelog ( "chk-cont.log", 0, s-list) .
      451         for each buf_trn-doc  no-lock
      452           where buf_trn-doc.host-code = g#host-code
      453             and buf_trn-doc.cli-type  = buf_clients.obj-type
      454             and buf_trn-doc.cli-code  = buf_clients.obj-code
      455             and buf_trn-doc.ext-doc-type  = 'ie':U
      456           :
      457           assign s-list = "Проверка накладной № " + buf_trn-doc.doc-code + " вн.н. договора " + string(buf_trn-doc.contract-code) .
      458           run writelog ( "chk-cont.log", 0, s-list) .
      459           for each buf_parts-attr no-lock where buf_parts-attr.in-code = buf_trn-doc.doc-code :
      460             assign Counter1 = Counter1 + 1.
      461   IF ( Counter1 modulo v-account = 0 )  then DO:
      462             if  log-manager:logfile-name ne ?
      463             then DO:
      464                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      465             end.
      466              if mFrameView
      467              then do:
      468               DISPLAY
      469                 Counter1 @ RecordsDone
      470                 WITH FRAME InfoFrame.
      471              end.
      472   End.
      473      if v-button-stop then  DO:
      474            if mFrameView
      475            then
      476               PROCESS EVENTS.
      477            IF StopProcessing THEN DO:
      478            RETURN error.
      479            End.
      480      end.
      481             if buf_parts-attr.contract-code <> buf_trn-doc.contract-code then do:
      482               assign
      483                 s-list = "Не совпал вн.н. договора в parts-attr (" + string(buf_parts-attr.contract-code) +
      484                   ")   parts-attr.gds-code=" + string(buf_parts-attr.gds-code)
      485                   + "  parts-attr.part-code=" + string(buf_parts-attr.part-code)
      486               .
      487               run writelog ( "chk-cont.log", 0, s-list) .
      488             end.
      489           end.
      490           for each buf_parts no-lock where buf_parts.out-code = buf_trn-doc.doc-code :
      491             assign Counter1 = Counter1 + 1.
      492   IF ( Counter1 modulo v-account = 0 )  then DO:
      493             if  log-manager:logfile-name ne ?
      494             then DO:
      495                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      496             end.
      497              if mFrameView
      498              then do:
      499               DISPLAY
      500                 Counter1 @ RecordsDone
      501                 WITH FRAME InfoFrame.
      502              end.
      503   End.
      504      if v-button-stop then  DO:
      505            if mFrameView
      506            then
      507               PROCESS EVENTS.
      508            IF StopProcessing THEN DO:
      509            RETURN error.
      510            End.
      511      end.
      512             if buf_parts.contract-code <> buf_trn-doc.contract-code then do:
      513               assign
      514                 s-list = "Не совпал вн.н. договора в parts (" + string(buf_parts.contract-code) +
      515                   ")   parts.obj-type=" + buf_parts.obj-type
      516                   + "  parts.obj-code=" + string(buf_parts.obj-code)
      517                   + "  parts.artic=" + buf_parts.artic
      518                   + "  parts.prod-type=" + buf_parts.prod-type
      519                   + "  parts.prod-code=" + string(buf_parts.prod-code)
      520                   + "  parts.in-code=" + buf_parts.in-code
      521                   + "  parts.out-code=" + buf_parts.out-code
      522                   + "  parts.part-code=" + buf_parts.part-code
      523               .
      524               run writelog ( "chk-cont.log", 0, s-list) .
      525             end.
      526             for each gds-obj no-lock
      527               where gds-obj.artic     =  buf_parts.artic
      528                 and gds-obj.prod-type =  buf_parts.prod-type
      529                 and gds-obj.prod-code =  buf_parts.prod-code
      530              , each parts no-lock
      531               where parts.obj-type  =  gds-obj.obj-type
      532                 and parts.obj-code  =  gds-obj.obj-code
      533                 and parts.artic     =  buf_parts.artic
      534                 and parts.prod-type =  buf_parts.prod-type
      535                 and parts.prod-code =  buf_parts.prod-code
      536                 and parts.in-code   =  buf_parts.in-code
      537                 and parts.part-code =  buf_parts.part-code
      538               :
      539               assign Counter1 = Counter1 + 1.
      540   IF ( Counter1 modulo v-account = 0 )  then DO:
      541             if  log-manager:logfile-name ne ?
      542             then DO:
      543                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      544             end.
      545              if mFrameView
      546              then do:
      547               DISPLAY
      548                 Counter1 @ RecordsDone
      549                 WITH FRAME InfoFrame.
      550              end.
      551   End.
      552      if v-button-stop then  DO:
      553            if mFrameView
      554            then
      555               PROCESS EVENTS.
      556            IF StopProcessing THEN DO:
      557            RETURN error.
      558            End.
      559      end.
      560               if parts.contract-code <> buf_trn-doc.contract-code then do:
      561                 assign
      562                   s-list = "Не совпал вн.н. договора в parts (" + string(parts.contract-code) +
      563                     ")   parts.obj-type=" + parts.obj-type
      564                     + "  parts.obj-code=" + string(parts.obj-code)
      565                     + "  parts.artic=" + parts.artic
      566                     + "  parts.prod-type=" + parts.prod-type
      567                     + "  parts.prod-code=" + string(parts.prod-code)
      568                     + "  parts.in-code=" + parts.in-code
      569                     + "  parts.out-code=" + parts.out-code
      570                     + "  parts.part-code=" + parts.part-code
      571                 .
      572                 run writelog ( "chk-cont.log", 0, s-list) .
      573               end.
      574             end.
      575           end.
      576         end.
      577   if mFrameView
      578   then do:
      579      HIDE FRAME InfoFrame.
      580   end.
      581   if session :set-wait-state( "" ) then.
      582       end.
      583     end.
      584     define variable g#log as logical   no-undo .
      585     run gbl/prnfilen.w ( input  "Результат работы утилиты", input  0, input  'chk-cont.log', input 7, output s-list, output g#log ).
