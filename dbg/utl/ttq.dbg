        1   block-level on error undo, throw.
        2   define input parameter p-metka as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: ttq.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/ttq.p $":U .
        8   define variable vss-description as character no-undo init "Отлов мусорных tt".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   DEFINE VARIABLE hBuffer    AS HANDLE     NO-UNDO.
       64   DEFINE VARIABLE hDATASET   AS HANDLE     NO-UNDO.
       65   define variable v-tth as handle no-undo .
       66   define stream LogStream.
       67     ASSIGN hdataset = SESSION:FIRST-DATASET.
       68     DO WHILE VALID-HANDLE(hdataset):
       69       IF VALID-HANDLE((hdataset)) THEN DO:
       70         v-tth = hdataset.
       71         OUTPUT stream LogStream TO "memdump.log" APPEND.
       72         PUT stream LogStream UNFORMATTED SKIP
       73           "** Dump:" space TODAY space STRING(TIME,'HH:MM:SS') SKIP
       74           "** Dynamic dataset **" SKIP
       75           "** label" space p-metka skip
       76           .
       77         do
       78         on error undo, leave
       79         :
       80           PUT stream LogStream
       81             hdataset:NAME FORMAT "x(20)" AT 2
       82               " "
       83               " ".
       84         end.
       85           IF VALID-HANDLE(hdataset:INSTANTIATING-PROCEDURE) THEN
       86             PUT stream LogStream "procedure" hdataset:INSTANTIATING-PROCEDURE:FILE-NAME FORMAT "x(40)".
       87         PUT stream LogStream SKIP.
       88         OUTPUT stream LogStream CLOSE.
       89       END.
       90       else do:
       91         OUTPUT stream LogStream TO "memdump.log" APPEND.
       92         PUT stream LogStream UNFORMATTED SKIP
       93           "** Dump: " space TODAY space STRING(TIME,'HH:MM:SS') SKIP
       94           "** STATIC TABLE **" SKIP
       95           "** label" space p-metka skip
       96           .
       97         do
       98         on error undo, leave
       99         :
      100           PUT stream LogStream
      101             string(hdataset:NAME) FORMAT "x(20)" AT 2
      102               " "
      103             string(hdataset) FORMAT "x(20)"
      104               " ".
      105         end.
      106           IF VALID-HANDLE(hdataset:INSTANTIATING-PROCEDURE) THEN
      107             PUT stream LogStream "procedure" hdataset:INSTANTIATING-PROCEDURE:FILE-NAME FORMAT "x(40)".
      108         PUT stream LogStream SKIP.
      109         OUTPUT stream LogStream CLOSE.
      110       end.
      111       hdataset = hdataset:NEXT-SIBLING.
      112       if valid-handle(v-tth) then do:
      113         delete object v-tth no-error.
      114         if error-status:error then do:
      115            OUTPUT stream LogStream TO "memdump.log" APPEND.
      116            PUT stream LogStream "error on deleting" skip.
      117            OUTPUT stream LogStream CLOSE.
      118         end.
      119         v-tth = ?.
      120       end.
      121     END.
      122     ASSIGN hBuffer = SESSION:FIRST-BUFFER.
      123     DO WHILE VALID-HANDLE(hBuffer):
      124       IF VALID-HANDLE((hBuffer:TABLE-HANDLE)) THEN DO:
      125         v-tth = hBuffer:TABLE-HANDLE.
      126         OUTPUT stream LogStream TO "memdump.log" APPEND.
      127         PUT stream LogStream UNFORMATTED SKIP
      128           "** Dump:" space TODAY space STRING(TIME,'HH:MM:SS') SKIP
      129           "** Dynamic temp-tables **" SKIP
      130           "** label" space p-metka skip
      131           .
      132         do
      133         on error undo, leave
      134         :
      135           PUT stream LogStream
      136             hBuffer:TABLE-HANDLE:NAME FORMAT "x(20)" AT 2
      137               " "
      138             string(hBuffer:TABLE-HANDLE) FORMAT "x(20)"
      139               " ".
      140         end.
      141           IF VALID-HANDLE(hBuffer:INSTANTIATING-PROCEDURE) THEN
      142             PUT stream LogStream "procedure" hBuffer:INSTANTIATING-PROCEDURE:FILE-NAME FORMAT "x(40)".
      143         PUT stream LogStream SKIP.
      144         OUTPUT stream LogStream CLOSE.
      145       END.
      146       else do:
      147         OUTPUT stream LogStream TO "memdump.log" APPEND.
      148         PUT stream LogStream UNFORMATTED SKIP
      149           "** Dump: " space TODAY space STRING(TIME,'HH:MM:SS') SKIP
      150           "** STATIC TABLE **" SKIP
      151           "** label" space p-metka skip
      152           .
      153         do
      154         on error undo, leave
      155         :
      156           PUT stream LogStream
      157             string(hBuffer:TABLE) FORMAT "x(20)" AT 2
      158               " "
      159             string(hBuffer) FORMAT "x(20)"
      160               " ".
      161         end.
      162           IF VALID-HANDLE(hBuffer:INSTANTIATING-PROCEDURE) THEN
      163             PUT stream LogStream "procedure" hBuffer:INSTANTIATING-PROCEDURE:FILE-NAME FORMAT "x(40)".
      164         PUT stream LogStream SKIP.
      165         OUTPUT stream LogStream CLOSE.
      166       end.
      167       hBuffer = hBuffer:NEXT-SIBLING.
      168       if valid-handle(v-tth) then do:
      169         delete object v-tth no-error.
      170         if error-status:error then do:
      171            OUTPUT stream LogStream TO "memdump.log" APPEND.
      172            PUT stream LogStream "error on deleting" skip.
      173            OUTPUT stream LogStream CLOSE.
      174         end.
      175         v-tth = ?.
      176       end.
      177     END.
