        1   block-level on error undo, throw.
        2   class utl.gpwdbrw-filter:
        3      define public property User as utl.flt-condition no-undo
        4      get.
        5      set.
        6      define public property HostName as utl.flt-condition no-undo
        7      get.
        8      set.
        9      define public property DateGen as utl.flt-condition no-undo
       10      get.
       11      set.
       12      define public property ObjectNum as utl.flt-condition no-undo
       13      get.
       14      set.
       15      define public property CashNum as utl.flt-condition no-undo
       16      get.
       17      set.
       18      define public property Fio as utl.flt-condition no-undo
       19      get.
       20      set.
       21      define public property DateProl as utl.flt-condition no-undo
       22      get.
       23      set.
       24      define public property Modifier as char init "and" no-undo
       25      get.
       26      set.
       27      method public static utl.gpwdbrw-filter GetObject():
       28         def var vFilter as class utl.gpwdbrw-filter no-undo.
       29         def var vCond   as class utl.flt-condition  no-undo.
       30         vFilter = new utl.gpwdbrw-filter().
       31         assign
       32            vCond = new utl.flt-condition()
       33            vCond:BufferName = "b-tech-prol-pwd"
       34            vCond:Field_ = "f-user"
       35            vCond:FieldName = "Идентификатор пользователя:"
       36            vCond:FieldType = "char"
       37         .
       38         vCond:AddOp("равно").
       39         vCond:AddOp("не равно").
       40         vCond:AddOp("список").
       41         vFilter:user = vCond.
       42         assign
       43            vCond = new utl.flt-condition()
       44            vCond:BufferName = "b-tech-prol-pwd"
       45            vCond:Field_ = "f-hostname"
       46            vCond:FieldName = "Имя хоста:"
       47            vCond:FieldType = "char"
       48         .
       49         vCond:AddOp("равно").
       50         vCond:AddOp("не равно").
       51         vCond:AddOp("содержит").
       52         vCond:AddOp("список").
       53         vFilter:HostName = vCond.
       54         assign
       55            vCond = new utl.flt-condition()
       56            vCond:BufferName = "b-tech-prol-pwd"
       57            vCond:Field_ = "f-time"
       58            vCond:FieldName = "Дата и время генерации пароля:"
       59            vCond:FieldType = "datetime"
       60         .
       61         vCond:AddOp("больше").
       62         vCond:AddOp("больше или равно").
       63         vCond:AddOp("меньше").
       64         vCond:AddOp("меньше или равно").
       65         vCond:AddOp("между").
       66         vFilter:DateGen = vCond.
       67         assign
       68            vCond = new utl.flt-condition()
       69            vCond:BufferName = "b-tech-prol-pwd"
       70            vCond:Field_ = "f-date"
       71            vCond:FieldName = "Дата проведения техпролива:"
       72            vCond:FieldType = "date"
       73         .
       74         vCond:AddOp("больше").
       75         vCond:AddOp("больше или равно").
       76         vCond:AddOp("меньше").
       77         vCond:AddOp("меньше или равно").
       78         vCond:AddOp("между").
       79         vFilter:DateProl = vCond.
       80         assign
       81            vCond = new utl.flt-condition()
       82            vCond:BufferName = "b-tech-prol-pwd"
       83            vCond:Field_ = "f-object-num"
       84            vCond:FieldName = "Объект:"
       85            vCond:FieldType = "int"
       86         .
       87         vCond:AddOp("равно").
       88         vCond:AddOp("не равно").
       89         vCond:AddOp("список").
       90         vFilter:ObjectNum = vCond.
       91         assign
       92            vCond = new utl.flt-condition()
       93            vCond:BufferName = "b-tech-prol-pwd"
       94            vCond:Field_ = "f-cash-num"
       95            vCond:FieldName = "Касса:"
       96            vCond:FieldType = "int"
       97         .
       98         vCond:AddOp("равно").
       99         vCond:AddOp("не равно").
      100         vCond:AddOp("список").
      101         vFilter:CashNum = vCond.
      102         assign
      103            vCond = new utl.flt-condition()
      104            vCond:BufferName = "b-tech-prol-pwd"
      105            vCond:Field_ = "f-fio"
      106            vCond:FieldName = "ФИО заказчика пароля:"
      107            vCond:FieldType = "char"
      108         .
      109         vCond:AddOp("равно").
      110         vCond:AddOp("не равно").
      111         vCond:AddOp("содержит").
      112         vCond:AddOp("начинается с").
      113         vCond:AddOp("список").
      114         vFilter:Fio = vCond.
      115         return vFilter.
      116      end method.
      117      method public log AllFiltersDisabled():
      118         return not (CashNum:Enabled  or
      119                     DateGen:Enabled  or
      120                     DateProl:Enabled or
      121                     Fio:Enabled      or
      122                     HostName:Enabled or
      123                     ObjectNum:enabled or
      124                     User:enabled).
      125      end method.
      126      method public character SubstWhere(iWhere as char, iString as char):
      127         def var vWhere as char no-undo.
      128         if iString <> "" then
      129         do:
      130            vWhere = substitute("&1 &2 (&3)",iWhere,this-object:Modifier,iString).
      131         end.
      132         else
      133            vWhere = iWhere.
      134         return vWhere.
      135      end method.
      136      method public character GetWhere():
      137         def var vWhere as char no-undo.
      138         assign
      139            vWhere = SubstWhere(vWhere,this-object:HostName:GetWhere())
      140            vWhere = SubstWhere(vWhere,this-object:Fio:GetWhere())
      141            vWhere = SubstWhere(vWhere,this-object:User:GetWhere())
      142            vWhere = SubstWhere(vWhere,this-object:DateGen:GetWhere())
      143            vWhere = SubstWhere(vWhere,this-object:DateProl:GetWhere())
      144            vWhere = SubstWhere(vWhere,this-object:ObjectNum:GetWhere())
      145            vWhere = SubstWhere(vWhere,this-object:CashNum:GetWhere())
      146            vWhere = trim(vWhere," ")
      147            vWhere = trim(vWhere,Modifier)
      148         .
      149         return vWhere.
      150      end method.
      151      method public character GetModifierName():
      152         define variable result as character no-undo.
      153         case this-object:Modifier:
      154            when "and" then result = "И".
      155            when "or" then result = "ИЛИ".
      156         end case.
      157         return result.
      158      end method.
      159   end class.
