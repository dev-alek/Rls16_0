        1   block-level on error undo, throw.
        2   define variable v-ind as integer no-undo .
        3   define variable v-option as character no-undo .
        4   define variable file-in as character no-undo .
        5   define variable file-err as character no-undo .
        6   define variable file-temp as character no-undo .
        7   define variable file-out as character no-undo .
        8   def stream txt-in.
        9   def stream txt-err.
       10   def stream txt-temp.
       11   define variable text-string as character no-undo .
       12   define variable i as int no-undo .
       13   DEFINE var i-artic as char no-undo.
       14   DEFINE var i-scale as char no-undo.
       15   DEFINE var i-unit-name as char no-undo.
       16   DEFINE var i-VAT-code AS integer NO-UNDO.
       17   DEFINE var i-NP-code AS integer NO-UNDO.
       18   DEFINE var i-prod-bc as char no-undo.
       19   DEFINE var i-qnty AS dec NO-UNDO.
       20   DEFINE var i-price AS dec NO-UNDO.
       21   do
       22   on error undo, leave
       23   on stop undo, leave
       24   on end-key undo, leave
       25   :
       26     if num-entries(session :parameter) < 4 then do:
       27       message
       28         "Ошибка задания входных параметров" skip
       29         view-as alert-box .
       30       undo, leave .
       31     end.
       32     assign
       33        file-in = entry(1, session :parameter)
       34       file-err = entry(2, session :parameter)
       35       file-temp = entry(3, session :parameter)
       36       file-out = entry(4, session :parameter)
       37       i = 0
       38     .
       39      input stream txt-in from value (file-in).
       40      repeat:
       41           IMPORT stream txt-in UNFORMATTED text-string NO-ERROR.
       42           if trim(text-string) = "" then leave.
       43           if num-entries (text-string, ";") <> 11 then do:
       44               OUTPUT stream txt-Err TO value (file-err) append.
       45               put stream txt-Err "Неправильное число параметров в строке, должно быть 10, в конце строки должен стоять знак ;" skip.
       46               export stream  txt-Err text-string .
       47               output stream txt-Err close.
       48               next.
       49           end.
       50        assign
       51               i-artic       = ENTRY( 1, text-string, ";")
       52               i-unit-name = ENTRY( 3, text-string, ";")
       53               i-vat-code    = integer(ENTRY(5, text-string, ";"))
       54               i-NP-code      = integer(ENTRY(6, text-string, ";"))
       55               i-prod-bc       = ENTRY(8, text-string, ";")
       56               i-qnty        = dec(ENTRY( 9, text-string, ";"))
       57               i-price       = dec(ENTRY( 10, text-string, ";"))
       58           .
       59           if  trim(i-artic) = "" then do:
       60               OUTPUT stream txt-Err TO value (file-err) append.
       61               put stream txt-Err "Не задан артикул" skip.
       62               export stream  txt-Err text-string .
       63               output stream txt-Err close.
       64               next.
       65           end.
       66           i-scale  = "/".
       67           overlay ( i-artic, r-index(i-artic, "-"), 1) = i-scale.
       68           i-scale = substring( i-artic, r-index(i-artic, "-") + 1 ).
       69           i-artic = substring( i-artic, 1, r-index(i-artic, "-") - 1 ).
       70           if  trim(i-scale) = "" then do:
       71               OUTPUT stream txt-Err TO value (file-err) append.
       72               put stream txt-Err "Не задана шкала" skip.
       73               export stream  txt-Err text-string .
       74               output stream txt-Err close.
       75               next.
       76           end.
       77           if i-unit-name = "th" then i-unit-name = "шт".
       78           else do:
       79               OUTPUT stream txt-Err TO value (file-err) append.
       80               put stream txt-Err "Неправильная единица измерения, должна бвть th" skip.
       81               export stream  txt-Err text-string .
       82               output stream txt-Err close.
       83               next.
       84           end.
       85           if  length(i-prod-bc) <> 13 then do:
       86               OUTPUT stream txt-Err TO value (file-err) append.
       87               put stream txt-Err "Доп-БК должен быть EAN13" skip.
       88               export stream  txt-Err text-string .
       89               output stream txt-Err close.
       90               next.
       91           end.
       92           if  i-qnty <= 0 or i-qnty =? then do:
       93               OUTPUT stream txt-Err TO value (file-err) append.
       94               put stream txt-Err "Не заданно количество" skip.
       95               export stream  txt-Err text-string .
       96               output stream txt-Err close.
       97               next.
       98           end.
       99           if  i-price <= 0 or i-price =? then do:
      100               OUTPUT stream txt-Err TO value (file-err) append.
      101               put stream txt-Err "Не заданно количество" skip.
      102               export stream  txt-Err text-string .
      103               output stream txt-Err close.
      104               next.
      105           end.
      106           if  i-vat-code =? then do:
      107               OUTPUT stream txt-Err TO value (file-err) append.
      108               put stream txt-Err "Не задан НДС" skip.
      109               export stream  txt-Err text-string .
      110               output stream txt-Err close.
      111               next.
      112           end.
      113           if  i-NP-code =? then do:
      114               OUTPUT stream txt-Err TO value (file-err) append.
      115               put stream txt-Err "Не задан НП" skip.
      116               export stream  txt-Err text-string .
      117               output stream txt-Err close.
      118               next.
      119           end.
      120          OUTPUT stream txt-temp TO value (file-temp) append.
      121           put stream txt-temp  unformatted
      122                     "SCALE:" +
      123                     trim(i-artic) + ";;" +
      124                     trim(i-scale) + ";;" +
      125                     trim(i-prod-bc) + ";" +
      126                     trim(string(i-price)) + ";" +
      127                     trim(string(i-qnty)) + ";" +
      128                     trim(i-unit-name) + ";1;;" +
      129                     trim(string(i-vat-code)) + ";" +
      130                     trim(string(i-NP-code)) + ";yes;ГТД"
      131           skip.
      132           output stream txt-temp close.
      133           i = i + 1.
      134      end.
      135      output stream txt-in  close.
      136      if i > 0 then do:
      137                 os-copy value(file-temp) value(file-out).
      138      end.
      139   end.
      140   quit .
