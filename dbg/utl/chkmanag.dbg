     1745         end.
     1746         assign
     1747           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1748         no-error .
     1749         if error-status :error
     1750         or error-status :get-message(1) <> ""
     1751         then do:
     1752           undo move_block, retry move_block.
     1753         end.
     1754         for each buf_temp-browse-handle
     1755           where buf_temp-browse-handle.browse-type = 'width':u
     1756         on error undo move_block, retry move_block
     1757         :
     1758           assign
     1759             buf_temp-browse-handle.browse-handle :width
     1760               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1761             no-error .
     1762           if error-status :error
     1763           or error-status :get-message(1) <> ""
     1764           then do:
     1765             undo move_block, retry move_block .
     1766           end.
     1767         end.
     1768         for each buf_temp-diasize-handle
     1769         on error undo move_block, retry move_block
     1770         :
     1771           assign
     1772             v-object-handle = buf_temp-diasize-handle.handle-value
     1773           .
     1774           if v-object-handle <> v-diasize-resize-button
     1775           then do:
     1776             assign
     1777               v-object-handle :col = v-object-handle :col + p-change-value
     1778               no-error .
     1779             if error-status :error
     1780             or error-status :get-message(1) <> ""
     1781             then do:
     1782               undo move_block, retry move_block .
     1783             end.
     1784           end.
     1785         end.
     1786       end.
     1787       else do:
     1788         for each buf_temp-diasize-handle
     1789         on error undo move_block, retry move_block
     1790         :
     1791           assign
     1792             v-object-handle = buf_temp-diasize-handle.handle-value
     1793           .
     1794           if v-object-handle <> v-diasize-resize-button
     1795           then do:
     1796             assign
     1797               v-object-handle :col = v-object-handle :col + p-change-value
     1798               no-error .
     1799             if error-status :error
     1800             or error-status :get-message(1) <> ""
     1801             then do:
     1802               undo move_block, retry move_block .
     1803             end.
     1804           end.
     1805         end.
     1806         for each buf_temp-browse-handle
     1807           where buf_temp-browse-handle.browse-type = 'width':u
     1808         on error undo move_block, retry move_block
     1809         :
     1810           assign
     1811             buf_temp-browse-handle.browse-handle :width
     1812               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1813             no-error .
     1814           if error-status :error
     1815           or error-status :get-message(1) <> ""
     1816           then do:
     1817             undo move_block, retry move_block .
     1818           end.
     1819         end.
     1820         assign
     1821           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1822           no-error .
     1823         if error-status :error
     1824         or error-status :get-message(1) <> ""
     1825         then do:
     1826           undo move_block, retry move_block.
     1827         end.
     1828         assign
     1829           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1830         no-error .
     1831         if error-status :error
     1832         or error-status :get-message(1) <> ""
     1833         then do:
     1834           undo move_block, retry move_block.
     1835         end.
     1836         if frame Dialog-Frame :scrollable = true
     1837         then do:
     1838           assign
     1839             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1840           no-error .
     1841           if error-status :error
     1842           or error-status :get-message(1) <> ""
     1843           then do:
     1844             undo move_block, retry move_block.
     1845           end.
     1846         end.
     1847       end.
     1848       if p-move-resize
     1849       then do:
     1850         run diasize_position-resize-button in this-procedure .
     1851       end.
     1852       if v-diasize-wndstore = true
     1853       then do:
     1854         if connected("ub") = true
     1855         then do:
     1856           define variable v-cntxt-db-num        as integer   no-undo .
     1857           define variable v-cntxt-userid        as character no-undo .
     1858           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1859                                             , OUTPUT v-cntxt-userid
     1860                                             ) .
     1861           run gbl/wndsizew.p
     1862             (input  v-cntxt-db-num
     1863             ,input  v-cntxt-userid
     1864             ,input  v-diasize-proc-name
     1865             ,input  'width':u
     1866             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1867             ) .
     1868         end.
     1869       end.
     1870     end.
     1871     assign
     1872       v-diasize-change-size = false
     1873     .
     1874   end procedure.
     1875   procedure diasize_set-width :
     1876     define input  parameter p-new-width  as decimal   no-undo .
     1877     define input  parameter p-move-resize as logical   no-undo .
     1878     do
     1879     on error undo, return error return-value
     1880     :
     1881       run diasize_change-width in this-procedure
     1882         (input  (p-new-width - frame Dialog-Frame :width)
     1883         ,input  p-move-resize
     1884         ) .
     1885     end.
     1886   end procedure.
     1887   procedure diasize_position-resize-button :
     1888     do with frame Dialog-Frame
     1889     :
     1890       hide v-diasize-resize-button .
     1891       assign
     1892         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1893                     - 1
     1894                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1895         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1896                     - 1
     1897                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1898       .
     1899       view v-diasize-resize-button .
     1900     end.
     1901   end procedure.
     1902   on alt-right anywhere
     1903   do:
     1904     run diasize_change-width in this-procedure
     1905       (input 1
     1906       ,input true
     1907       ) .
     1908     return no-apply .
     1909   end.
     1910   on alt-left anywhere
     1911   do:
     1912     run diasize_change-width in this-procedure
     1913       (input -1
     1914       ,input true
     1915       ) .
     1916     return no-apply .
     1917   end.
     1918   on alt-down anywhere
     1919   do:
     1920     run diasize_change-height in this-procedure
     1921       (input 1
     1922       ,input true
     1923       ) .
     1924     return no-apply .
     1925   end.
     1926   on alt-up anywhere
     1927   do:
     1928     run diasize_change-height in this-procedure
     1929       (input -1
     1930       ,input true
     1931       ) .
     1932     return no-apply .
     1933   end.
     1934   on alt-enter of frame Dialog-Frame
     1935   do:
     1936     run diasize_maximize in this-procedure
     1937       (input  ?
     1938       ).
     1939     return no-apply .
     1940   end.
     1941   procedure diasize_end-move :
     1942     do
     1943     on error undo, return error return-value
     1944     :
     1945       define variable v-row-delta as decimal   no-undo .
     1946       define variable v-col-delta as decimal   no-undo .
     1947       define variable v-new-row as decimal   no-undo .
     1948       define variable v-new-col as decimal   no-undo .
     1949       assign
     1950         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1951         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1952       .
     1953       assign
     1954         v-row-delta = v-new-row - frame Dialog-Frame :height
     1955         v-col-delta = v-new-col - frame Dialog-Frame :width
     1956       .
     1957       run diasize_change-height in this-procedure
     1958         (input v-row-delta
     1959         ,input true
     1960         ) .
     1961       run diasize_change-width in this-procedure
     1962         (input v-col-delta
     1963         ,input true
     1964         ) .
     1965     end.
     1966   end procedure.
     1967   procedure diasize_maximize :
     1968     define input  parameter p-action as logical   no-undo .
     1969     do
     1970     on error undo, return error return-value
     1971     :
     1972       if p-action = ?
     1973       then do:
     1974         if v-diasize-need-maximize = true
     1975         then do:
     1976           assign
     1977             p-action = true
     1978           .
     1979         end.
     1980         else do:
     1981           assign
     1982             p-action = false
     1983           .
     1984         end.
     1985       end.
     1986       if p-action = true
     1987       then do:
     1988         run diasize_change-height in this-procedure
     1989           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1990               - frame Dialog-Frame :height-chars
     1991           ,input true
     1992           ) .
     1993         run diasize_change-width in this-procedure
     1994           (input session :width-chars
     1995               - frame Dialog-Frame :width-chars
     1996           ,input true
     1997           ) .
     1998         assign
     1999           v-diasize-need-maximize = false
     2000         .
     2001       end.
     2002       else do:
     2003         run diasize_change-width in this-procedure
     2004           (input v-diasize-orig-frame-width
     2005               - frame Dialog-Frame :width-chars
     2006           ,input true
     2007           ) .
     2008         run diasize_change-height in this-procedure
     2009           (input v-diasize-orig-frame-height
     2010               - frame Dialog-Frame :height-chars
     2011           ,input true
     2012           ) .
     2013         assign
     2014           v-diasize-need-maximize = true
     2015         .
     2016       end.
     2017     end.
     2018   end procedure.
     2019   procedure diasize_restore-orig-size :
     2020     do
     2021     on error undo, return error return-value
     2022     :
     2023       assign
     2024         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2025         v-diasize-current-frame-height = frame Dialog-Frame :height
     2026       .
     2027       run diasize_set-height in this-procedure
     2028         (input  v-diasize-orig-frame-height
     2029         ,input  true
     2030         ) .
     2031       run diasize_set-width in this-procedure
     2032         (input  v-diasize-orig-frame-width
     2033         ,input  true
     2034         ) .
     2035     end.
     2036   end procedure.
     2037   procedure diasize_restore-current-size :
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       run diasize_set-height in this-procedure
     2042         (input  v-diasize-current-frame-height
     2043         ,input  true
     2044         ) .
     2045       run diasize_set-width in this-procedure
     2046         (input  v-diasize-current-frame-width
     2047         ,input  true
     2048         ) .
     2049     end.
     2050   end procedure.
     2051   procedure diasize_set-browse-handle :
     2052     define input  parameter p-browse-handle as handle   no-undo .
     2053     define buffer buf_temp-browse-handle for temp-browse-handle .
     2054     do
     2055     on error undo, return error return-value
     2056     :
     2057       assign
     2058         v-diasize-browse-handle = p-browse-handle
     2059       .
     2060       for each buf_temp-browse-handle
     2061       on error undo, return error return-value
     2062       :
     2063         delete buf_temp-browse-handle .
     2064       end.
     2065     end.
     2066   end procedure.
     2067   procedure diasize_add_browse :
     2068     define input  parameter p-browse-type   as character no-undo .
     2069     define input  parameter p-browse-handle as handle    no-undo .
     2070     define buffer buf_temp-browse-handle for temp-browse-handle .
     2071     do
     2072     on error undo, return error return-value
     2073     :
     2074       assign
     2075         v-diasize-browse-number = v-diasize-browse-number + 1
     2076       .
     2077       create buf_temp-browse-handle .
     2078       assign
     2079         buf_temp-browse-handle.browse-type   = p-browse-type
     2080         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2081         buf_temp-browse-handle.browse-handle = p-browse-handle
     2082       .
     2083     end.
     2084   end procedure.
     2085   procedure diasize_init :
     2086     define variable v-default-value    as logical   no-undo .
     2087     define variable v-restore-saved    as logical   no-undo .
     2088     define variable v-resize-value-str as character no-undo .
     2089     do
     2090     on error undo, return error return-value
     2091     :
     2092       do with frame Dialog-Frame
     2093       :
     2094         assign
     2095           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2096           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2097           v-diasize-browse-handle     = browse BROWSE-1 :handle
     2098         .
     2099         create button v-diasize-resize-button
     2100         assign
     2101           parent        = frame Dialog-Frame :first-child
     2102           label         = "s"
     2103           height-pixels = 16
     2104           width-pixels  = 16
     2105           visible       = true
     2106           sensitive     = true
     2107           movable       = true
     2108           triggers:
     2109             on end-move persistent run diasize_end-move in this-procedure .
     2110           end triggers.
     2111         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2112         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2113         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2114         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2115         assign
     2116           v-diasize-wndmax = false
     2117         .
     2118         if connected("ub") = true
     2119         then do:
     2120           define variable v-cntxt-db-num        as integer   no-undo .
     2121           define variable v-cntxt-userid        as character no-undo .
     2122           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2123                                             , OUTPUT v-cntxt-userid
     2124                                             ) .
     2125           run gbl/wndpar_r.p
     2126             (input  v-cntxt-db-num
     2127             ,input  v-cntxt-userid
     2128             ,input  'wndmax':U
     2129             ,output v-diasize-wndmax
     2130             ,output v-default-value
     2131             ) .
     2132         end.
     2133         assign
     2134           v-diasize-wndstore = false
     2135         .
     2136         if connected("ub") = true
     2137         then do:
     2138           run gbl/wndpar_r.p
     2139             (input  v-cntxt-db-num
     2140             ,input  v-cntxt-userid
     2141             ,input  'wndstore':U
     2142             ,output v-diasize-wndstore
     2143             ,output v-default-value
     2144             ) .
     2145         end.
     2146         assign
     2147           v-diasize-proc-name = entry(1, program-name(2), '.')
     2148         .
     2149         if v-diasize-wndstore = true
     2150         then do:
     2151           assign
     2152             v-restore-saved = false
     2153           .
     2154           if connected("ub") = true
     2155           then do:
     2156             run gbl/wndsizer.p
     2157               (input  v-cntxt-db-num
     2158               ,input  v-cntxt-userid
     2159               ,input  v-diasize-proc-name
     2160               ,input  'height':u
     2161               ,output v-resize-value-str
     2162               ) .
     2163             if v-resize-value-str <> '':U
     2164             then do:
     2165               run diasize_change-height in this-procedure
     2166                 (input  integer(v-resize-value-str)
     2167                 ,input  true
     2168                 ) .
     2169               assign
     2170                 v-restore-saved = true
     2171               .
     2172             end.
     2173           end.
     2174           if connected("ub") = true
     2175           then do:
     2176             run gbl/wndsizer.p
     2177               (input  v-cntxt-db-num
     2178               ,input  v-cntxt-userid
     2179               ,input  v-diasize-proc-name
     2180               ,input  'width':u
     2181               ,output v-resize-value-str
     2182               ) .
     2183             if v-resize-value-str <> '':U
     2184             then do:
     2185               run diasize_change-width in this-procedure
     2186                 (input  integer(v-resize-value-str)
     2187                 ,input  true
     2188                 ) .
     2189               assign
     2190                 v-restore-saved = true
     2191               .
     2192             end.
     2193           end.
     2194           if v-restore-saved <> true
     2195           then do:
     2196             if v-diasize-wndmax = true
     2197             then do:
     2198               run diasize_maximize in this-procedure
     2199                 (input  true
     2200                 ) .
     2201             end.
     2202           end.
     2203         end.
     2204         else do:
     2205           if v-diasize-wndmax = true
     2206           then do:
     2207             run diasize_maximize in this-procedure
     2208               (input  true
     2209               ) .
     2210           end.
     2211         end.
     2212       end.
     2213     end.
     2214   end procedure.
     2215   procedure diasize_need-full-display :
     2216     define output parameter p-need-full-display as logical   no-undo .
     2217     do
     2218     on error undo, return error return-value
     2219     :
     2220       assign
     2221         p-need-full-display = v-diasize-need-full-display
     2222       .
     2223       assign
     2224         v-diasize-need-full-display = false
     2225       .
     2226     end.
     2227   end procedure.
     2228   procedure get-context :
     2229      define output parameter p-db-num as integer          no-undo.
     2230      define output parameter p-user-id as character        no-undo.
     2231      define variable v-login               as character    no-undo.
     2232      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2233      define buffer buf_user-login  for ub.user-login .
     2234      do
     2235      on error undo, return error
     2236      :
     2237            FIND FIRST buf_sys-ctrl no-lock.
     2238            ASSIGN
     2239               v-login = USERID("ub")
     2240               p-db-num = buf_sys-ctrl.db-num
     2241            .
     2242            FIND FIRST buf_user-login
     2243                 WHERE buf_user-login.db-num = p-db-num
     2244                   AND buf_user-login.user-login = v-login
     2245                 no-lock
     2246                 no-error
     2247                 .
     2248            IF AVAILABLE buf_user-login
     2249            THEN DO:
     2250               assign
     2251                  p-user-id = buf_user-login.user-id
     2252               .
     2253            END.
     2254      end.
     2255   end procedure.
     2256       run diasize_init in this-procedure .
     2257   MAIN-BLOCK:
     2258   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2259      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2260     run fill-temp-procedure in this-procedure .
     2261     RUN enable_UI.
     2262     RUN show-help in this-procedure  .
     2263     WAIT-FOR GO OF FRAME Dialog-Frame.
     2264   END.
     2265   RUN disable_UI.
     2266   PROCEDURE chk-allcheck :
     2267     define variable icount      as integer no-undo .
     2268     define variable v-test-name as character no-undo .
     2269     assign
     2270       v-test-name = "Подробная проверка товара (chk-allcheck)"
     2271     .
     2272     run log-test-started in this-procedure
     2273       (input v-test-name
     2274       ).
     2275     run utl/allcheck.p (input parparentproc) .
     2276     assign
     2277       icount = integer(return-value) no-error
     2278     .
     2279     run log-test-finished in this-procedure
     2280       (input v-test-name
     2281       ,input icount
     2282       ) .
     2283   END PROCEDURE.
     2284   PROCEDURE chk-batchprocess :
     2285   END PROCEDURE.
     2286   PROCEDURE chk-doc-line :
     2287     define variable icount      as integer no-undo .
     2288     define variable ind         as integer no-undo .
     2289     define variable v-artic-str as character no-undo .
     2290     define variable v-test-name as character no-undo .
     2291     assign
     2292       v-test-name = "Проверка строк складских документов (chk-doc-line)"
     2293     .
     2294     run log-test-started in this-procedure
     2295       (input v-test-name
     2296       ).
     2297     run waitfram-show in this-procedure
     2298       (input v-test-name
     2299       ).
     2300     run clear-temp-object in this-procedure .
     2301     for each doc-line no-lock
     2302     :
     2303       assign
     2304         ind = ind + 1
     2305       .
     2306       if ind mod 10 = 0 then do:
     2307         assign
     2308           v-artic-str = string(doc-line.artic)
     2309                       + " " + string(doc-line.prod-type)
     2310                       + " " + string(doc-line.prod-code)
     2311         .
     2312         run waitfram-show in this-procedure
     2313           (input "Документ " + string(doc-line.doc-code, 'x(14)':u)
     2314             + " Артикул " + string(v-artic-str, 'x(25)':u)
     2315             + " Найдено ошибок " + STRING(icount)
     2316           ).
     2317       end.
     2318       find first ub.trn-doc no-lock
     2319         where ub.trn-doc.doc-code = ub.doc-line.doc-code
     2320         no-error .
     2321       if not available ub.trn-doc then do:
     2322         assign
     2323           icount = icount + 1
     2324         .
     2325         run register-document in this-procedure
     2326           (input ub.doc-line.obj-type
     2327           ,input ub.doc-line.obj-code
     2328           ,input ub.doc-line.status_
     2329           ,input ub.doc-line.fact-order
     2330           ).
     2331         run log-error
     2332           (input "doc-line"
     2333           ,input ub.doc-line.obj-type
     2334           ,input ub.doc-line.obj-code
     2335           ,input ub.doc-line.artic
     2336           ,input ub.doc-line.prod-type
     2337           ,input ub.doc-line.prod-code
     2338           ,input 'trn-doc-not-exist '
     2339             + ' doc-code = ' + string(ub.doc-line.doc-code)
     2340           ).
     2341         next .
     2342       end.
     2343       find first ub.goods no-lock
     2344         where ub.goods.artic     = ub.doc-line.artic
     2345           and ub.goods.prod-type = ub.doc-line.prod-type
     2346           and ub.goods.prod-code = ub.doc-line.prod-code
     2347         no-error .
     2348       if not available ub.goods then do:
     2349         assign
     2350           icount = icount + 1
     2351         .
     2352         run register-document in this-procedure
     2353           (input ub.doc-line.obj-type
     2354           ,input ub.doc-line.obj-code
     2355           ,input ub.doc-line.status_
     2356           ,input ub.doc-line.fact-order
     2357           ).
     2358         run log-error
     2359           (input "doc-line"
     2360           ,input ub.doc-line.obj-type
     2361           ,input ub.doc-line.obj-code
     2362           ,input ub.doc-line.artic
     2363           ,input ub.doc-line.prod-type
     2364           ,input ub.doc-line.prod-code
     2365           ,input 'goods-not-exist '
     2366             + ' doc-code = ' + string(ub.doc-line.doc-code)
     2367           ).
     2368         next .
     2369       end.
     2370       if ub.doc-line.status_ <> ub.trn-doc.status_  then do:
     2371         assign
     2372           icount = icount + 1
     2373         .
     2374         run register-document in this-procedure
     2375           (input ub.doc-line.obj-type
     2376           ,input ub.doc-line.obj-code
     2377           ,input ub.doc-line.status_
     2378           ,input ub.doc-line.fact-order
     2379           ).
     2380         run register-document in this-procedure
     2381           (input ub.doc-line.obj-type
     2382           ,input ub.doc-line.obj-code
     2383           ,input ub.trn-doc.status_
     2384           ,input ub.doc-line.fact-order
     2385           ).
     2386         run log-error
     2387           (input "doc-line"
     2388           ,input ub.doc-line.obj-type
     2389           ,input ub.doc-line.obj-code
     2390           ,input ub.doc-line.artic
     2391           ,input ub.doc-line.prod-type
     2392           ,input ub.doc-line.prod-code
     2393           ,input 'doc-line.status_ '
     2394             + ' doc-code = ' + string(ub.doc-line.doc-code)
     2395             + ' trn-doc.status_  = ' + string(ub.trn-doc.status_)
     2396             + ' doc-line.status_ = ' + string(ub.doc-line.status_)
     2397           ).
     2398         next .
     2399       end.
     2400       if ub.doc-line.obj-type <> ub.trn-doc.obj-type
     2401       or ub.doc-line.obj-code <> ub.trn-doc.obj-code
     2402       then do:
     2403         assign
     2404           icount = icount + 1
     2405         .
     2406         run register-document in this-procedure
     2407           (input ub.doc-line.obj-type
     2408           ,input ub.doc-line.obj-code
     2409           ,input ub.doc-line.status_
     2410           ,input ub.doc-line.fact-order
     2411           ).
     2412         run log-error
     2413           (input "doc-line_obj-type_obj-code"
     2414           ,input ub.doc-line.obj-type
     2415           ,input ub.doc-line.obj-code
     2416           ,input ub.doc-line.artic
     2417           ,input ub.doc-line.prod-type
     2418           ,input ub.doc-line.prod-code
     2419           ,input 'doc-line.obj-type doc-line.obj-code '
     2420             + ' doc-code = ' + string(ub.doc-line.doc-code)
     2421           ).
     2422         next .
     2423       end.
     2424       if ub.trn-doc.status_ <> 'факт':U then do:
     2425         next .
     2426       end.
     2427       define variable v-parts-fact-qnty    as decimal no-undo .
     2428       define variable v-gds-dtl-fact-qnty  as decimal no-undo .
     2429       assign
     2430         v-parts-fact-qnty   = 0
     2431         v-gds-dtl-fact-qnty = 0
     2432       .
     2433       if ub.goods.gds-type = 'т':U then do:
     2434         for each ub.parts no-lock
     2435           where ub.parts.out-code  = ub.doc-line.doc-code
     2436             and ub.parts.obj-type  = ub.doc-line.obj-type
     2437             and ub.parts.obj-code  = ub.doc-line.obj-code
     2438             and ub.parts.artic     = ub.doc-line.artic
     2439             and ub.parts.prod-type = ub.doc-line.prod-type
     2440             and ub.parts.prod-code = ub.doc-line.prod-code
     2441         :
     2442           assign
     2443             v-parts-fact-qnty = v-parts-fact-qnty + parts.fact-qnty
     2444           .
     2445         end.
     2446       end.
     2447       else do:
     2448         find first ub.parts no-lock
     2449           where ub.parts.out-code  = ub.doc-line.doc-code
     2450             and ub.parts.obj-type  = ub.doc-line.obj-type
     2451             and ub.parts.obj-code  = ub.doc-line.obj-code
     2452             and ub.parts.artic     = ub.doc-line.artic
     2453             and ub.parts.prod-type = ub.doc-line.prod-type
     2454             and ub.parts.prod-code = ub.doc-line.prod-code
     2455           no-error .
     2456         if available parts then do:
     2457           assign
     2458             icount = icount + 1
     2459           .
     2460           run register-document in this-procedure
     2461             (input ub.doc-line.obj-type
     2462             ,input ub.doc-line.obj-code
     2463             ,input ub.doc-line.status_
     2464             ,input ub.doc-line.fact-order
     2465             ).
     2466           run log-error
     2467             (input "doc-line"
     2468             ,input ub.doc-line.obj-type
     2469             ,input ub.doc-line.obj-code
     2470             ,input ub.doc-line.artic
     2471             ,input ub.doc-line.prod-type
     2472             ,input ub.doc-line.prod-code
     2473             ,input 'not_goods_has_parts '
     2474               + ' doc-code = ' + string(ub.doc-line.doc-code)
     2475             ).
     2476           next .
     2477         end.
     2478         assign
     2479           v-parts-fact-qnty = ub.doc-line.fact-qnty
     2480         .
     2481       end.
     2482       for each ub.gds-dtl no-lock
     2483         where ub.gds-dtl.doc-code  = ub.doc-line.doc-code
     2484           and ub.gds-dtl.artic     = ub.doc-line.artic
     2485           and ub.gds-dtl.prod-type = ub.doc-line.prod-type
     2486           and ub.gds-dtl.prod-code = ub.doc-line.prod-code
     2487       :
     2488         assign
     2489           v-gds-dtl-fact-qnty = v-gds-dtl-fact-qnty
     2490                               + (if ub.trn-doc.doc-type <> 'инв':U
     2491                                  then ub.gds-dtl.fact-qnty
     2492                                  else ub.gds-dtl.doc-qnty
     2493                                 )
     2494         .
     2495       end.
     2496       if (( ub.doc-line.fact-qnty <> v-parts-fact-qnty
     2497        or ub.doc-line.fact-qnty <> v-gds-dtl-fact-qnty ) and
     2498           ub.trn-doc.doc-type <> 'инв':U )
     2499        or
     2500         ( ub.trn-doc.doc-type = 'инв':U   and
     2501           ub.doc-line.fact-qnty <> v-parts-fact-qnty )   then do:
     2502         assign
     2503           icount = icount + 1
     2504         .
     2505         run register-document in this-procedure
     2506               (input ub.doc-line.obj-type
     2507               ,input ub.doc-line.obj-code
     2508               ,input ub.doc-line.status_
     2509               ,input ub.doc-line.fact-order
     2510               ).
     2511             run log-error
     2512               (input "doc-line"
     2513               ,input ub.doc-line.obj-type
     2514               ,input ub.doc-line.obj-code
     2515               ,input ub.doc-line.artic
     2516               ,input ub.doc-line.prod-type
     2517               ,input ub.doc-line.prod-code
     2518               ,input 'trn-doc-fact-qnty '
     2519                 + ' doc-code = ' + string(ub.doc-line.doc-code)
     2520                 + ' doc-line.fact-qnty = ' + string(ub.doc-line.fact-qnty)
     2521                 + ' v-parts-fact-qnty = ' + STRING(v-parts-fact-qnty)
     2522                 + ' v-gds-dtl-fact-qnty = ' + STRING(v-gds-dtl-fact-qnty)
     2523                 + ' тип документа = ' + STRING(ub.trn-doc.doc-type)
     2524                 + ' статус = ' + STRING(ub.trn-doc.status_)
     2525               ).
     2526       end.
     2527     end.
     2528     run waitfram-hide in this-procedure .
     2529     run output-temp-object in this-procedure .
     2530     run log-test-finished in this-procedure
     2531       (input v-test-name
     2532       ,input icount
     2533       ) .
     2534   END PROCEDURE.
     2535   PROCEDURE chk-firm-db-num :
     2536     define variable icount      as integer no-undo .
     2537     define variable ind         as integer no-undo .
     2538     define variable v-test-name as character no-undo .
     2539     assign
     2540       v-test-name = "Проверка соответствия БД объекта главной БД фирмы  (chk-firm-db-num)"
     2541     .
     2542     run log-test-started in this-procedure
     2543       (input v-test-name
     2544       ).
     2545     run utl/chkfrmdb.p (
     2546                     input  this-procedure:handle
     2547                    ,output icount).
     2548     run log-test-finished in this-procedure
     2549       (input v-test-name
     2550       ,input icount
     2551       ) .
     2552   END PROCEDURE.
     2553   PROCEDURE chk-idxinact :
     2554     define variable icount      as integer no-undo .
     2555     define variable v-test-name as character no-undo .
     2556     assign
     2557       v-test-name = "Неактивные индексы (chk-idxinact)"
     2558     .
     2559     run log-test-started in this-procedure
