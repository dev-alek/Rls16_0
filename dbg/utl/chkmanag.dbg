     1459         end.
     1460       end.
     1461       if p-move-resize = true
     1462       then do:
     1463         run diasize_position-resize-button in this-procedure .
     1464       end.
     1465       if v-diasize-wndstore = true
     1466       then do:
     1467         if connected("ub") = true
     1468         then do:
     1469           define variable v-cntxt-db-num        as integer   no-undo .
     1470           define variable v-cntxt-userid        as character no-undo .
     1471           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1472                                             , OUTPUT v-cntxt-userid
     1473                                             ) .
     1474           run gbl/wndsizew.p
     1475             (input  v-cntxt-db-num
     1476             ,input  v-cntxt-userid
     1477             ,input  v-diasize-proc-name
     1478             ,input  'height':u
     1479             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1480             ) .
     1481         end.
     1482       end.
     1483     end.
     1484     assign
     1485       v-diasize-change-size = false
     1486     .
     1487   end procedure.
     1488   procedure diasize_set-height :
     1489     define input  parameter p-new-height  as decimal   no-undo .
     1490     define input  parameter p-move-resize as logical   no-undo .
     1491     do
     1492     on error undo, return error return-value
     1493     :
     1494       run diasize_change-height in this-procedure
     1495         (input  (p-new-height - frame Dialog-Frame :height)
     1496         ,input  p-move-resize
     1497         ) .
     1498     end.
     1499   end procedure.
     1500   procedure diasize_change-width :
     1501     define input  parameter p-change-value as decimal   no-undo .
     1502     define input  parameter p-move-resize  as logical   no-undo .
     1503     define variable v-field-group-handle   as handle    no-undo .
     1504     define variable v-object-handle        as handle    no-undo .
     1505     define variable v-frame-width          as decimal   no-undo .
     1506     define variable v-frame-virtual-width  as decimal   no-undo .
     1507     define variable v-browse-width         as decimal   no-undo .
     1508     define variable v-window-width         as decimal   no-undo .
     1509     define variable v-window-virtual-width as decimal   no-undo .
     1510     define variable v-change-sign          as integer   no-undo .
     1511     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1512     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1513     if p-change-value > 0
     1514     then do:
     1515       if frame Dialog-Frame :width + p-change-value >
     1516           session :width-chars
     1517       then do:
     1518         assign
     1519           p-change-value = session :width-chars - frame Dialog-Frame :width
     1520         .
     1521         if p-change-value <= 0
     1522         then do:
     1523           run diasize_position-resize-button in this-procedure .
     1524           return .
     1525         end.
     1526       end.
     1527     end.
     1528     if p-change-value < 0
     1529     then do:
     1530       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1531       then do:
     1532         assign
     1533           p-change-value = v-diasize-orig-frame-width
     1534                          - frame Dialog-Frame :width
     1535         .
     1536         if p-change-value >= 0
     1537         then do:
     1538           run diasize_position-resize-button in this-procedure .
     1539           return .
     1540         end.
     1541       end.
     1542     end.
     1543     if p-change-value >= 0
     1544     then do:
     1545       assign
     1546         v-change-sign = 1
     1547       .
     1548     end.
     1549     else do:
     1550       assign
     1551         v-change-sign = -1
     1552       .
     1553     end.
     1554     assign
     1555       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1556     .
     1557     if p-change-value = 0
     1558     then do:
     1559       run diasize_position-resize-button in this-procedure .
     1560       return .
     1561     end.
     1562     move_block:
