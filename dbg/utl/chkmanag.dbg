        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Утилиты проверки целостности БД".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   function diff-list returns character (
       69     input parfirst-list  as character,
       70     input parsecond-list as character,
       71     input pardelim       as character).
       72     if pardelim = ""
       73     or pardelim = ?
       74     then do:
       75       assign
       76         pardelim = ","
       77       .
       78     end.
       79     def var ind as integer no-undo .
       80     def var v-elem as character no-undo .
       81     def var v-result-list as character no-undo init "".
       82     def var v-num-parfirst-list as integer no-undo .
       83     assign
       84       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
       85     .
       86     do ind = 1 to v-num-parfirst-list
       87     :
       88       assign
       89         v-elem = entry(ind, parfirst-list, pardelim)
       90       .
       91       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
       92         assign
       93           v-result-list = v-result-list
       94                         + (if v-result-list > "" then pardelim else "")
       95                         + v-elem
       96         .
       97       end.
       98     end.
       99     return v-result-list .
      100   end function.
      101   function add-list returns character (
      102    input parfirst-list  as character,
      103    input parsecond-list as character,
      104    input pardelim       as character).
      105     if pardelim = ""
      106     or pardelim = ?
      107     then do:
      108       assign
      109         pardelim = ","
      110       .
      111     end.
      112     def var ind as integer no-undo .
      113     def var v-elem as character no-undo .
      114     def var v-result-list as character no-undo init "".
      115     def var v-num-parfirst-list as integer no-undo .
      116     assign
      117       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      118     .
      119     do ind = 1 to v-num-parfirst-list
      120     :
      121       assign
      122         v-elem = entry(ind, parfirst-list, pardelim)
      123       .
      124       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      125         assign
      126           v-result-list = v-result-list
      127                         + (if v-result-list > "" then pardelim else "")
      128                         + v-elem
      129         .
      130       end.
      131     end.
      132     def var v-num-parsecond-list as integer no-undo .
      133     assign
      134       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      135     .
      136     do ind = 1 to v-num-parsecond-list
      137     :
      138       assign
      139         v-elem = entry(ind, parsecond-list, pardelim)
      140       .
      141       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      142         assign
      143           v-result-list = v-result-list
      144                         + (if v-result-list > "" then pardelim else "")
      145                         + v-elem
      146         .
      147       end.
      148     end.
      149     return v-result-list .
      150   end function.
      151   function cross-list returns character (
      152    input parfirst-list  as character,
      153    input parsecond-list as character,
      154    input pardelim       as character).
      155     if pardelim = ""
      156     or pardelim = ?
      157     then do:
      158       assign
      159         pardelim = ","
      160       .
      161     end.
      162     def var ind as integer no-undo .
      163     def var v-elem as character no-undo .
      164     def var v-result-list as character no-undo init "".
      165     def var v-num-parfirst-list as integer no-undo .
      166     assign
      167       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      168     .
      169     do ind = 1 to v-num-parfirst-list
      170     :
      171       assign
      172         v-elem = entry(ind, parfirst-list, pardelim)
      173       .
      174       if lookup(v-elem, v-result-list, pardelim) = 0
      175       and lookup(v-elem, parsecond-list, pardelim) > 0
      176       then do:
      177         assign
      178           v-result-list = v-result-list
      179                         + (if v-result-list > "" then pardelim else "")
      180                         + v-elem
      181         .
      182       end.
      183     end.
      184     return v-result-list .
      185   end function.
      186   function radio-label returns character (
      187    input par-rs-value  as character,
      188    input par-rs-radio-buttons as character)
      189    .
      190    DEFINE variable v-result-label as character no-undo.
      191    assign
      192    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      193                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      194                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      195                             ), par-rs-radio-buttons
      196                           )
      197    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      198    .
      199   return v-result-label.
      200   end function.
      201   function m-radio-label returns character (
      202    input par-rs-value  as character,
      203    input par-rs-radio-buttons as character,
      204    input par-delim as character
      205    )
      206    .
      207    DEFINE variable v-result-label as character no-undo.
      208    assign
      209    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      210                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      211                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      212                             ), par-rs-radio-buttons, par-delim
      213                           )
      214    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      215    .
      216   return v-result-label.
      217   end function.
      218   FUNCTION mixlist returns character
      219   (
      220    input parfirst-list  as character
      221    ,input parsecond-list as character
      222    ,input pardelim       as character
      223    ,input pardelim-result as character ) :
      224     if pardelim = ""
      225     or pardelim = ?
      226     then do:
      227       assign
      228         pardelim = ","
      229       .
      230     end.
      231     def var ind as integer no-undo .
      232     def var v-elem1 as character no-undo .
      233     def var v-elem2 as character no-undo .
      234     def var v-result-list as character no-undo init "".
      235     do ind = 1 to num-entries(parfirst-list, pardelim)
      236     :
      237       assign
      238         v-elem1 = entry(ind, parfirst-list, pardelim)
      239         v-elem2 = entry(ind, parsecond-list, pardelim)
      240       .
      241         assign
      242           v-result-list = v-result-list
      243                         + (if v-result-list > "" then pardelim-result else "")
      244                         + v-elem1 + pardelim-result + v-elem2
      245         .
      246     end.
      247     return v-result-list .
      248   END FUNCTION.
      249   procedure proc-alt-shift-f2:
      250     if not ibs.th.gbl.gbl-var:rcode
      251   then
      252     run gbl\inidebug.p .
      253   end.
      254   procedure proc-alt-shift-f3:
      255     run gbl/prvssinf.p
      256       ( input this-procedure
      257       ) .
      258   end.
      259   define variable v-inform-launched as logical no-undo initial false .
      260   procedure proc-alt-shift-f4:
      261     define variable v-action as character no-undo .
      262     if v-inform-launched = false then do:
      263       assign
      264         v-inform-launched = true
      265       .
      266       run gbl/d-inform.w
      267         (  input self
      268         ,  input this-procedure
      269         , output v-action
      270         ) no-error .
      271       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      272       assign
      273         v-inform-launched = false
      274       .
      275     end.
      276   end.
      277   procedure proc-alt-f1:
      278     run gbl/corrhelp.p
      279       (input this-procedure
      280       ) .
      281   end .
      282   on alt-shift-f2 anywhere do:
      283     run proc-alt-shift-f2.
      284   end.
      285   on alt-shift-f3 anywhere do:
      286     run proc-alt-shift-f3 in this-procedure .
      287   end.
      288   on alt-shift-f4 anywhere do:
      289     run proc-alt-shift-f4 in this-procedure.
      290   end.
      291   on alt-f1 anywhere do:
      292     run proc-alt-f1 in this-procedure .
      293   end.
      294   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   procedure cur-time :
      296      define output parameter p-today as date      no-undo .
      297      define output parameter p-time  as integer   no-undo .
      298     do
      299     on error undo, return error
      300     :
      301       define variable v-date1 as date      no-undo .
      302       define variable v-date2 as date      no-undo .
      303       define variable v-time  as integer   no-undo .
      304       assign
      305         v-date1 = today
      306         v-time  = time
      307         v-date2 = today
      308       .
      309       if v-date1 <> v-date2
      310       then do:
      311         assign
      312           v-date1 = today
      313           v-time  = v-time
      314         .
      315       end.
      316       assign
      317         p-today = v-date1
      318         p-time  = v-time
      319       .
      320     end.
      321   end.
      322   function cur-time-date returns character
      323   :
      324     return string(today, '99/99/9999':U) .
      325   end.
      326   function cur-time-mjd returns decimal
      327   :
      328     define variable v-date as date      no-undo .
      329     define variable v-time as integer   no-undo .
      330     run cur-time in this-procedure
      331       (output v-date
      332       ,output v-time
      333       ) .
      334     return integer(v-date) - 2400002 + (v-time / 86400) .
      335   end.
      336   function cur-time-get-ending-index returns integer
      337   (input p-number as integer
      338   )
      339   :
      340     if p-number < 0
      341     or p-number = ?
      342     then do:
      343       return 1 .
      344     end.
      345     define variable v-rest as integer   no-undo .
      346     assign
      347       p-number = p-number modulo 100
      348     .
      349     if p-number < 20
      350     then do:
      351       assign
      352         v-rest = p-number
      353       .
      354     end.
      355     else do:
      356       assign
      357         v-rest = p-number modulo 10
      358       .
      359     end.
      360     case v-rest :
      361       when 1
      362       then do:
      363         return 2 .
      364       end.
      365       when 2 or
      366       when 3 or
      367       when 4
      368       then do:
      369         return 3 .
      370       end.
      371       otherwise do:
      372         return 1 .
      373       end.
      374     end case .
      375   end.
      376   procedure cur-time-mjd-to-date :
      377      define input  parameter i-mjd-diff as decimal no-undo.
      378      define output parameter o-Date     as date    no-undo.
      379      define output parameter o-Time     as integer no-undo.
      380      define variable v-day-number as integer   no-undo .
      381      if    i-mjd-diff < 0
      382         or i-mjd-diff = ?
      383      then do:
      384         return "?" .
      385      end.
      386      assign
      387         v-day-number = truncate(i-mjd-diff,0).
      388         o-Date = date(v-day-number + 2400002).
      389         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      390     .
      391   end.
      392   function cur-time-mjd-to-string returns character
      393   (input p-mjd-diff as decimal
      394   )
      395   :
      396     define variable v-day-number as integer   no-undo .
      397     define variable v-seconds    as integer   no-undo .
      398     define variable v-hour       as integer   no-undo .
      399     define variable v-min        as integer   no-undo .
      400     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      401     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      402     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      403     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      404     if p-mjd-diff < 0
      405     or p-mjd-diff = ?
      406     then do:
      407       return "?" .
      408     end.
      409     assign
      410       v-day-number = integer(truncate(p-mjd-diff,0))
      411       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      412     .
      413     if v-seconds > 86400
      414     then do:
      415       assign
      416         v-seconds = 86400 - 1
      417       .
      418     end.
      419     if v-seconds < 0
      420     then do:
      421       assign
      422         v-seconds = 0
      423       .
      424     end.
      425     assign
      426       v-hour = truncate(v-seconds / 3600, 0)
      427     .
      428     assign
      429       v-seconds = v-seconds modulo 3600
      430     .
      431     assign
      432       v-min = truncate(v-seconds / 60, 0)
      433     .
      434     assign
      435       v-seconds = v-seconds modulo 60
      436     .
      437     return
      438         (if v-day-number <> 0
      439           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      440           else ""
      441         )
      442       + (if v-day-number <> 0 or v-hour <> 0
      443           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      444           else ""
      445         )
      446       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      447           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      448           else ""
      449         )
      450       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      451       .
      452   end.
      453   function cur-time-string returns character
      454   :
      455     define variable v-date as date      no-undo .
      456     define variable v-time as integer   no-undo .
      457     run cur-time in this-procedure
      458       (output v-date
      459       ,output v-time
      460       ) .
      461     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      462   end.
      463   function cur-time-string-sec returns character
      464   :
      465     define variable v-date as date      no-undo .
      466     define variable v-time as integer   no-undo .
      467     run cur-time in this-procedure
      468       (output v-date
      469       ,output v-time
      470       ) .
      471     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      472   end.
      473   function cur-time-custom  returns character
      474   (input p-prefix as character
      475   ,input p-date-format as character
      476   ,input p-delimiter as character
      477   ,input p-time-format as character
      478   ,input p-suffix as character
      479   )
      480   :
      481     define variable v-date as date      no-undo .
      482     define variable v-time as integer   no-undo .
      483     run cur-time in this-procedure
      484       (output v-date
      485       ,output v-time
      486       ) .
      487     return
      488       p-prefix
      489       + string(v-date, p-date-format)
      490       + p-delimiter
      491       + string(v-time, p-time-format)
      492       + p-suffix
      493       .
      494   end.
      495   function cur-time-print  returns character
      496   :
      497     define variable v-date as date      no-undo .
      498     define variable v-time as integer   no-undo .
      499     run cur-time in this-procedure
      500       (output v-date
      501       ,output v-time
      502       ) .
      503     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      504   end.
      505   function cur-time-datetime returns datetime
      506   :
      507     define variable v-char as character no-undo .
      508     define variable v-datetime as datetime no-undo .
      509     v-char = cur-time-string().
      510     v-datetime = datetime(v-char).
      511     return  v-datetime.
      512   end.
      513   function cur-time-string-msec returns character
      514   :
      515     define variable v-date as datetime  no-undo .
      516     v-date = now.
      517     return string(v-date) .
      518   end.
      519   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      520   define variable v-waitfram-action01         as character   no-undo .
      521   define variable v-waitfram-action02         as character   no-undo .
      522   define variable v-waitfram-action03         as character   no-undo .
      523   define variable mWaitFramTextBeg            as character   no-undo.
      524   define variable mWaitFramTextEnd            as character   no-undo.
      525   define variable mWaitFramView               as logical     no-undo.
      526   define variable mWaitProcEvent              as logical     no-undo init yes.
      527   define variable mWaitFramInterval           as integer     no-undo init 1 .
      528   define variable mWaitFramStop               as logical     no-undo.
      529   define variable mWaitFramStopUser           as logical     no-undo.
      530   define variable mWaitFramStopTimeOut        as logical     no-undo.
      531   define variable mWaitFramStartProc          as datetime-tz no-undo.
      532   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      533   define button B-WaitFramStop auto-end-key
      534        label "Стоп"
      535        size 10 by 1 tooltip "Остоновить процесс".
      536   define button B-viewProcInfo
      537        label "Информация"
      538        size 15 by 1 tooltip "Информация о процесс".
      539   define frame waitfram
      540     v-waitfram-action01 format "x(72)" no-label skip
      541     v-waitfram-action02 format "x(72)" no-label skip
      542     v-waitfram-action03 format "x(72)" no-label skip
      543     B-viewProcInfo
      544     B-WaitFramStop at row 4 col 30
      545     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      546     .
      547   define new global shared variable mBatchMode as logical no-undo init ?.
      548   define variable mFramBachModHandle as handle no-undo.
      549   mFramBachModHandle = frame waitfram:handle.
      550   define variable mFameOldVis as logical no-undo.
      551   define variable mVisCUrentVin as logical no-undo.
      552   if session:batch-mode
      553   then
      554      mBatchMode = yes.
      555   if mBatchMode = ? then do:
      556     mVisCUrentVin = current-window:visible.
      557     mFameOldVis = mFramBachModHandle:visible.
      558     mFramBachModHandle:visible  = yes.
      559     mBatchMode = mFramBachModHandle:visible ne yes.
      560     mFramBachModHandle:visible = mFameOldVis.
      561     current-window:visible = mVisCUrentVin.
      562   end.
      563    if  log-manager:logfile-name ne ?
      564     then DO:
      565         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      566         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      567         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      568     end.
      569   on choose of B-WaitFramStop in frame waitfram
      570   do:
      571     mWaitFramStop = yes.
      572     mWaitFramStopUser = yes.
      573   end.
      574   function waitfram-check-timeout returns logical():
      575      define variable vtime as int64 no-undo.
      576      if mWaitFramStopTimeOut
      577      then
      578         return yes.
      579      vtime = ( now - mWaitFramStartProc ) / 1000 .
      580      if     mWaitFramTimeOut ne ?
      581         and mWaitFramTimeOut ne 0
      582         and mWaitFramTimeOut lt vtime
      583      then do:
      584         mWaitFramStopTimeOut = yes.
      585      end.
      586      return mWaitFramStopTimeOut.
      587   end.
      588   procedure waitfram-hide :
      589     if not session:batch-mode
      590     then do
      591     on error undo, return error return-value
      592     :
      593       pause 0 before-hide .
      594       if not mBatchMode then
      595         hide frame waitfram .
      596     if     not mWaitFramView
      597        and mWaitProcEvent
      598     then
      599       process events .
      600     end.
      601   end procedure.
      602   procedure waitfram-show :
      603     define input  parameter p-message as character no-undo .
      604     define variable v-left-margin as integer   no-undo .
      605     if not session:batch-mode
      606     then do
      607     on error undo, return error return-value
      608     :
      609       if length(p-message) <= 70 then do:
      610         assign
      611           v-left-margin = integer((70 - length(p-message)) / 2)
      612         .
      613         assign
      614           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      615         .
      616         assign
      617           v-waitfram-action01 = " "
      618           v-waitfram-action02 = " "
      619                                    + fill(" ", v-left-margin)
      620                                    + p-message
      621           v-waitfram-action03 = " "
      622         .
      623       end.
      624       else do:
      625         define variable vRindex1 as integer no-undo.
      626         define variable vRindex2 as integer no-undo.
      627         vRindex1 = r-index(p-message," ",70).
      628         if vRindex1 = 0
      629         then
      630            vRindex1 = 70.
      631         if length(p-message)  <= vRindex1 + 70 then do:
      632           assign
      633             v-waitfram-action01 = " "
      634             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      635             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      636           .
      637         end.
      638         else do:
      639           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      640           if vRindex2 <= vRindex1
      641           then
      642              vRindex2 = vRindex1 + 70.
      643           assign
      644             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      645             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      646             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      647           .
      648         end.
      649       end.
      650       B-viewProcInfo:visible   in frame waitfram = no.
      651       B-viewProcInfo:sensitive in frame waitfram = no.
      652       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      653       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      654       if  (   mWaitFramView
      655          or  mWaitProcEvent)
      656          and not mBatchMode
      657       then
      658          display
      659             v-waitfram-action01 skip
      660             v-waitfram-action02 skip
      661             v-waitfram-action03 skip
      662          with frame waitfram .
      663       if     mWaitFramView
      664          then do:
      665             if     mWaitFramInterval ne ?
      666                and not mBatchMode
      667             then
      668                wait-for go of frame waitfram pause mWaitFramInterval.
      669          end.
      670          else
      671             if     mWaitProcEvent
      672                and not mBatchMode
      673             then
      674                process events .
      675     end.
      676   end procedure.
      677      procedure waitfram-show-this:
      678         define input  parameter iInterval as int64 no-undo.
      679         define variable vtime as int64 no-undo.
      680         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      681         mWaitFramInterval = iInterval.
      682         run waitfram-show (substitute("&1&2 &3&4" ,
      683                                       mWaitFramTextBeg ,
      684                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      685                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      686                                       mWaitFramTextEnd
      687                                      )
      688                           ).
      689      end.
      690      procedure WaitFramRunPause:
      691         define input  parameter iInterval as dec no-undo.
      692         define variable vStart  as datetime-tz no-undo.
      693         define variable vend    as datetime-tz no-undo.
      694         define variable vint as int64 no-undo.
      695         define variable vOk as logical no-undo.
      696         vStart = now.
      697         vend   = vStart.
      698         publish "WaitFramPause" (iInterval,output vOk).
      699         vend   =  now.
      700         vint = vend - vStart.
      701         vint = iInterval - vint / 1000.
      702         if     not mWaitFramStop
      703            and (   vint > 0
      704                 or (    not vOk
      705                     and iInterval eq ?
      706                     )
      707                 )
      708         then
      709            run waitfram-show-this (iInterval).
      710         vend   =  now.
      711         vint = vend - vStart.
      712         vint = iInterval - vint / 1000.
      713         if     not mWaitFramStop
      714            and vint > 0
      715         then do:
      716            run gbl/pause.p (vint * 1000).
      717         end.
      718         if iInterval ne ?
      719         then
      720            publish "WaitFramStop".
      721         waitfram-check-timeout().
      722      end.
      723      procedure WaitFramWaitFor:
      724         define input  parameter iInterval as dec no-undo.
      725         assign
      726            mWaitFramStartProc   = now
      727            mWaitFramStopUser    = no
      728            mWaitFramStopTimeOut = no
      729         .
      730         block-wait:
      731         do while not mWaitFramStop:
      732            run WaitFramRunPause (iInterval).
      733            if  waitfram-check-timeout()
      734            then do:
      735               leave block-wait.
      736            end.
      737         end.
      738         run waitfram-hide.
      739      end.
      740   procedure waitfram-join :
      741     define input  parameter p-line-1  as character no-undo .
      742     define input  parameter p-line-2  as character no-undo .
      743     define input  parameter p-line-3  as character no-undo .
      744     define output parameter p-message as character no-undo .
      745     do
      746     on error undo, return error return-value
      747     :
      748       assign
      749         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      750                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      751                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      752       .
      753     end.
      754   end procedure.
      755   function waitfram-join-function returns character
      756     (input p-line-1 as character
      757     ,input p-line-2 as character
      758     ,input p-line-3 as character
      759     ).
      760     define variable v-message as character no-undo .
      761     run waitfram-join in this-procedure
      762       (input  p-line-1
      763       ,input  p-line-2
      764       ,input  p-line-3
      765       ,output v-message
      766       ) .
      767     return v-message .
      768   end function .
      769   define temp-table temp-object no-undo
      770     field obj-type   like ub.trn-doc.obj-type
      771     field obj-code   like ub.trn-doc.obj-code
      772     field status_    like ub.trn-doc.status_
      773     field fact-order like ub.trn-doc.fact-order
      774     index xpk is primary unique obj-type obj-code
      775   .
      776   define temp-table temp-procedure no-undo
      777     field proc-order    as integer   format ">9"    label "N"
      778     field proc-mark     as character format "X(1)"  label "*"
      779     field proc-label    as character format "x(20)" label "Проверка"
      780     field proc-descr    as character format "x(45)" label "Описание"
      781     field proc-group    as character format "x(1)"  label "Группа"
      782     field proc-name     as character format "x(20)" label "Процедура"
      783     index xpk is primary unique proc-order
      784   .
      785   define variable v-proc-order as integer   no-undo .
      786   define variable del-list     as character no-undo.
      787   define variable mark         as character no-undo COLUMN-LABEL "*"      FORMAT "x(1)"  .
      788   FUNCTION get-mark RETURNS CHARACTER
      789     ( input v-recid  as recid )  FORWARD.
      790   DEFINE BUTTON b-check
      791        LABEL "&Проверить"
      792        SIZE 12 BY 1.
      793   DEFINE BUTTON b-exit AUTO-END-KEY
      794        LABEL "&Выход"
      795        SIZE 10 BY 1 TOOLTIP "Подробная проверка целостности товаров".
      796   DEFINE BUTTON b-help
      797        LABEL "Помо&щь"
      798        SIZE 10 BY 1 TOOLTIP "Подробная проверка целостности товаров".
      799   DEFINE BUTTON b-mark
      800        LABEL "&*"
      801        SIZE 4 BY 1.
      802   DEFINE VARIABLE EDITOR-Help AS CHARACTER
      803        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      804        SIZE 35.88 BY 5 NO-UNDO.
      805   DEFINE VARIABLE EDITOR-Log AS CHARACTER
      806        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      807        SIZE 42.38 BY 5
      808        BGCOLOR 15  NO-UNDO.
      809   DEFINE QUERY BROWSE-1 FOR
      810         temp-procedure SCROLLING.
      811   DEFINE BROWSE BROWSE-1
      812     QUERY BROWSE-1 DISPLAY
      813         proc-order
      814         get-mark(recid(temp-procedure)) @ mark
      815         proc-label
      816         proc-descr
      817         proc-group
      818         proc-name
      819       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.25 BY 8.5
      820            BGCOLOR 15 .
      821   DEFINE FRAME Dialog-Frame
      822        b-exit AT ROW 1.5 COL 2
      823        b-help AT ROW 1.5 COL 12.13
      824        b-mark AT ROW 1.5 COL 22.13
      825        b-check AT ROW 1.5 COL 26.13
      826        BROWSE-1 AT ROW 2.71 COL 2
      827        EDITOR-Log AT ROW 11.5 COL 2.13 NO-LABEL
      828        EDITOR-Help AT ROW 11.5 COL 45.5 NO-LABEL
      829        SPACE(0.49) SKIP(0.16)
      830       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      831            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      832            TITLE "Утилиты проверки БД"
      833            CANCEL-BUTTON b-exit.
      834   ASSIGN
      835          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      836          FRAME Dialog-Frame:HIDDEN           = TRUE.
      837   ASSIGN
      838          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
      839   ASSIGN
      840          EDITOR-Help:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      841   ASSIGN
      842          EDITOR-Log:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      843   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      844   DO:
      845     APPLY "END-ERROR":U TO SELF.
      846   END.
      847   ON CHOOSE OF b-check IN FRAME Dialog-Frame
      848   DO:
      849   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850   if lookup(self :type
      851            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      852            ) = 0
      853   then do:
      854     message
      855       "$Workfile$"
      856       "Указанному интерфейсному элементу фокус не может быть передан" skip
      857       "Интерфейсный элемент" self :name  skip
      858       "Тип" self :type  skip
      859       "Процедура" this-procedure :file-name skip
      860       view-as alert-box .
      861   end.
      862   else do:
      863     apply "entry":u to self  .
      864     if focus :handle <> self :handle  then do:
      865       return no-apply .
      866     end.
      867   end.
      868     define variable lok          as logical   no-undo .
      869     define variable process-list as character no-undo .
      870     do
      871     on stop undo, return no-apply
      872     :
      873       if del-list = "" then do:
      874         if not available temp-procedure then do:
      875           message
      876             "Неправильный выбор поцедуры"
      877             view-as alert-box .
      878           return no-apply.
      879         end.
      880         assign
      881           process-list = string(recid(temp-procedure))
      882         .
      883       end.
      884       else do:
      885         assign
      886           process-list = del-list
      887         .
      888       end.
      889       lok = no.
      890       message
      891         "Выбрано" num-entries(process-list) "процедур проверки" skip
      892         "Продолжить?"
      893         view-as alert-box question buttons ok-cancel update lok .
      894       if lok <> true then do:
      895         return no-apply.
      896       end.
      897       define variable v-ind as integer no-undo .
      898       do v-ind = 1 to num-entries(process-list) :
      899         run make-check in this-procedure
      900           (input integer (entry (v-ind, process-list))
      901           ) .
      902       end.
      903       assign
      904         lok = browse BROWSE-1 :refresh() .
      905       .
      906     end.
      907   END.
      908   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      909   DO:
      910   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   if lookup(self :type
      912            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      913            ) = 0
      914   then do:
      915     message
      916       "$Workfile$"
      917       "Указанному интерфейсному элементу фокус не может быть передан" skip
      918       "Интерфейсный элемент" self :name  skip
      919       "Тип" self :type  skip
      920       "Процедура" this-procedure :file-name skip
      921       view-as alert-box .
      922   end.
      923   else do:
      924     apply "entry":u to self  .
      925     if focus :handle <> self :handle  then do:
      926       return no-apply .
      927     end.
      928   end.
      929   END.
      930   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      931   DO:
      932   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   if lookup(self :type
      934            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      935            ) = 0
      936   then do:
      937     message
      938       "$Workfile$"
      939       "Указанному интерфейсному элементу фокус не может быть передан" skip
      940       "Интерфейсный элемент" self :name  skip
      941       "Тип" self :type  skip
      942       "Процедура" this-procedure :file-name skip
      943       view-as alert-box .
      944   end.
      945   else do:
      946     apply "entry":u to self  .
      947     if focus :handle <> self :handle  then do:
      948       return no-apply .
      949     end.
      950   end.
      951     if not available temp-procedure then do:
      952       message
      953         "Неправильный выбор партии."
      954         view-as alert-box .
      955       return no-apply.
      956     end.
      957     define variable v-temp-procedure-recid as character no-undo .
      958     assign
      959       v-temp-procedure-recid = string (recid (temp-procedure))
      960     .
      961     if lookup( v-temp-procedure-recid, del-list ) > 0 then do:
      962       assign
      963         del-list = diff-list(del-list, v-temp-procedure-recid, "" )
      964       .
      965       disp "" @ mark with browse BROWSE-1 .
      966     end.
      967     else do:
      968       assign
      969         del-list = add-list(del-list, v-temp-procedure-recid, "" )
      970       .
      971       disp "*" @ mark with browse BROWSE-1 .
      972     end.
      973     define variable lok as logical no-undo .
      974     lok = BROWSE-1 :select-next-row ().
      975     apply "entry":u to BROWSE-1 in frame Dialog-Frame.
      976   END.
      977   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      978   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      979   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   on help of frame Dialog-Frame
      981   do:
      982     run gbl/app_help.p
      983       (input this-procedure :file-name
      984       ,input ''
      985       ,input ?
      986       ) no-error.
      987     if error-status :error then do:
      988       message
      989         "Ошибка при вызове помощи"
      990         error-status :get-message(1)
      991         view-as alert-box .
      992     end.
      993   end.
      994   run minbtn-set in this-procedure .
      995   on choose of b-help in frame Dialog-Frame
      996   do:
      997     apply "help":u to frame Dialog-Frame .
      998   end.
      999   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1000   procedure minbtn-set :
     1001       do
     1002           on error undo, return error return-value
     1003           :
     1004           define variable ii              as integer       no-undo .
     1005           define variable fh              as widget-handle no-undo .
     1006           define variable hh              as widget-handle no-undo .
     1007           define variable v-h             as handle        extent 4 no-undo .
     1008           define variable v-name-button   as character     no-undo .
     1009           define variable v-help-old-x    as decimal       no-undo .
     1010           define variable v-help-old-y    as decimal       no-undo .
     1011           define variable v-help-old-size as decimal       no-undo .
     1012           define variable v-frame-width   as decimal       no-undo .
     1013           define variable jj              as integer       no-undo .
     1014           do
     1015               on error undo, return error
     1016               :
     1017               assign
     1018                   v-frame-width = frame Dialog-Frame:width - 0.3
     1019                   fh            = frame Dialog-Frame:first-child
     1020                   hh            = fh:first-child
     1021                   ii            = 1
     1022                   .
     1023               do while valid-handle(hh):
     1024                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1025                   do:
     1026                       case lc(hh:name) :
     1027                           when "b-help" then
     1028                               do:
     1029                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1030                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1031                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1032                                   hh:TOOLTIP = "Помощь" .
     1033                                   v-help-old-x = hh:column .
     1034                                   v-help-old-y = hh:row    .
     1035                                   v-help-old-size = hh:width .
     1036                                   hh:width-chars = 2.5 .
     1037                               end.
     1038                           when "b-print" then
     1039                               do:
     1040                                   hh:load-image("cmp/b-print.bmp":u) .
     1041                                   hh:TOOLTIP = "Печать" .
     1042                                   v-h[ii] = hh:handle .
     1043                                   ii = ii + 1 .
     1044                                   hh:width-chars = 3 .
     1045                               end.
     1046                           when "b-history" or
     1047                           when "b-hist" then
     1048                               do:
     1049                                   hh:load-image("cmp/b-hist.bmp":u) .
     1050                                   hh:TOOLTIP = "История" .
     1051                                   v-h[ii] = hh:handle .
     1052                                   ii = ii + 1 .
     1053                                   hh:width-chars = 3 .
     1054                               end.
     1055                           when "b-sch" then
     1056                               do:
     1057                                   hh:load-image("cmp/b-sch.bmp":u) .
     1058                                   hh:TOOLTIP = "Установка Фильтра" .
     1059                                   v-h[ii] = hh:handle .
     1060                                   ii = ii + 1 .
     1061                                   hh:width-chars = 3 .
     1062                               end.
     1063                           when "b-hist-user" then
     1064                               do:
     1065                                   hh:load-image("cmp/b-hist.bmp":u) .
     1066                                   hh:TOOLTIP = "История пользователя" .
     1067                                   ii = ii + 1 .
     1068                               end.
     1069                       end case.
     1070                   end.
     1071                   hh = hh:next-sibling.
     1072               end.
     1073               b-help:column = v-frame-width - b-help:width-chars.
     1074               jj = 0.
     1075               repeat ii = 4 to 1 by -1 :
     1076                   if valid-handle (v-h[ii] ) then
     1077                   do:
     1078                       jj  = jj + 1 .
     1079                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1080                       v-h[ii]:row    = v-help-old-y .
     1081                   end.
     1082               end.
     1083           end.
     1084       end.
     1085   end procedure.
     1086   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1087   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1088   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1089   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1090   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1091   define variable v-diasize-current-frame-height as decimal   no-undo .
     1092   define variable v-diasize-change-size          as logical   no-undo .
     1093   define variable v-diasize-resize-button        as handle    no-undo .
     1094   define variable v-diasize-wndmax               as logical   no-undo .
     1095   define variable v-diasize-wndstore             as logical   no-undo .
     1096   define variable v-diasize-proc-name            as character no-undo .
     1097   define variable v-diasize-browse-handle        as handle    no-undo .
     1098   define variable v-diasize-browse-number        as integer   no-undo .
     1099   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1100   define temp-table temp-diasize-handle no-undo
     1101     field handle-value  as handle
     1102     field save-position as decimal
     1103     index xpk is primary unique handle-value
     1104     .
     1105   define temp-table temp-browse-handle no-undo
     1106     field browse-type   as character
     1107     field browse-number as integer
     1108     field browse-handle as handle
     1109     field original-size as decimal
     1110     index xpk is primary unique browse-type browse-number
     1111     index xie browse-type browse-handle
     1112   .
     1113   procedure diasize_change-height :
     1114     define input  parameter p-change-value  as decimal   no-undo .
     1115     define input  parameter p-move-resize   as logical   no-undo .
     1116     define variable v-field-group-handle    as handle    no-undo .
     1117     define variable v-object-handle         as handle    no-undo .
     1118     define variable v-frame-height          as decimal   no-undo .
     1119     define variable v-frame-virtual-height  as decimal   no-undo .
     1120     define variable v-browse-height         as decimal   no-undo .
     1121     define variable v-window-height         as decimal   no-undo .
     1122     define variable v-window-virtual-height as decimal   no-undo .
     1123     define variable v-change-sign           as integer   no-undo .
     1124     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1125     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1126     if p-change-value > 0
     1127     then do:
     1128       if frame Dialog-Frame :height + p-change-value
     1129           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1130       then do:
     1131         assign
     1132           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1133                           - (frame Dialog-Frame :height-chars)
     1134         .
     1135         if p-change-value <= 0
     1136         then do:
     1137           run diasize_position-resize-button in this-procedure .
     1138           return .
     1139         end.
     1140       end.
     1141     end.
     1142     if p-change-value < 0
     1143     then do:
     1144       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1145       then do:
     1146         assign
     1147           p-change-value = v-diasize-orig-frame-height
     1148                          - (frame Dialog-Frame :height-chars)
     1149         .
     1150         if p-change-value >= 0
     1151         then do:
     1152           run diasize_position-resize-button in this-procedure .
     1153           return .
     1154         end.
     1155       end.
     1156     end.
     1157     if p-change-value >= 0
     1158     then do:
     1159       assign
     1160         v-change-sign = 1
     1161       .
     1162     end.
     1163     else do:
     1164       assign
     1165         v-change-sign = -1
     1166       .
     1167     end.
     1168     assign
     1169       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1170     .
     1171     if p-change-value = 0
     1172     then do:
     1173       run diasize_position-resize-button in this-procedure .
     1174       return .
     1175     end.
     1176     move_block:
     1177     do
     1178     on error undo move_block, retry move_block
     1179     :
     1180       if retry
     1181       then do:
     1182         do
     1183         on error undo move_block, leave move_block
     1184         :
     1185           if p-change-value > 0
     1186           then do:
     1187             for each buf_temp-diasize-handle
     1188             on error undo, next
     1189             :
     1190               assign
     1191                 v-object-handle = buf_temp-diasize-handle.handle-value
     1192               .
     1193               if v-object-handle <> v-diasize-resize-button
     1194               then do:
     1195                 assign
     1196                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1197                 .
     1198               end.
     1199             end.
     1200             assign
     1201               v-diasize-browse-handle :height = v-browse-height
     1202             .
     1203             for each buf_temp-browse-handle
     1204               where buf_temp-browse-handle.browse-type = 'height':u
     1205             on error undo, next
     1206             :
     1207               assign
     1208                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1209               .
     1210             end.
     1211             assign
     1212               frame Dialog-Frame :height = v-frame-height
     1213             .
     1214             if frame Dialog-Frame :scrollable = true
     1215             then do:
     1216               assign
     1217                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1218               .
     1219             end.
     1220             run diasize_position-resize-button in this-procedure .
     1221           end.
     1222           else do:
     1223             if frame Dialog-Frame :scrollable = true
     1224             then do:
     1225               assign
     1226                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1227               .
     1228             end.
     1229             assign
     1230               frame Dialog-Frame :height = v-frame-height
     1231             .
     1232             assign
     1233               v-diasize-browse-handle :height = v-browse-height
     1234             .
     1235             for each buf_temp-browse-handle
     1236               where buf_temp-browse-handle.browse-type = 'height':u
     1237             on error undo, next
     1238             :
     1239               assign
     1240                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1241               .
     1242             end.
     1243             for each buf_temp-diasize-handle
     1244             on error undo, next
     1245             :
     1246               assign
     1247                 v-object-handle = buf_temp-diasize-handle.handle-value
     1248               .
     1249               if v-object-handle <> v-diasize-resize-button
