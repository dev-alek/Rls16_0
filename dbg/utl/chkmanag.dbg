     1719       do with frame Dialog-Frame
     1720       :
     1721         hide v-diasize-resize-button .
     1722         v-diasize-resize-button :row = 1.
     1723         v-diasize-resize-button :column = 1.
     1724       end.
     1725       if p-change-value > 0
     1726       then do:
     1727         if frame Dialog-Frame :scrollable = true
     1728         then do:
     1729           assign
     1730             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1731             no-error .
