     1301         :
     1302           if  v-object-handle <> v-diasize-browse-handle :handle
     1303           and can-query(v-object-handle, "row")
     1304           and can-query(v-object-handle, "height")
     1305           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1306           then do:
     1307             find first buf_temp-browse-handle
     1308               where buf_temp-browse-handle.browse-type   = 'height':u
     1309                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1310               no-error .
     1311             if available buf_temp-browse-handle
     1312             then do:
     1313             end.
     1314             else do:
     1315               create buf_temp-diasize-handle .
     1316               assign
     1317                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1318                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1319               .
     1320             end.
     1321           end.
     1322           assign
     1323             v-object-handle = v-object-handle :next-sibling
     1324           .
     1325         end.
     1326         assign
     1327           v-field-group-handle = v-field-group-handle :next-sibling
     1328         .
     1329       end.
     1330       do with frame Dialog-Frame
     1331       :
     1332         hide v-diasize-resize-button .
     1333         assign
     1334           v-diasize-resize-button :row    = 1
     1335           v-diasize-resize-button :column = 1
     1336         .
     1337       end.
     1338       if p-change-value > 0
     1339       then do:
     1340         if frame Dialog-Frame :scrollable = true
     1341         then do:
     1342           assign
     1343             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1344             no-error .
     1345           if error-status :error
     1346           or error-status :get-message(1) <> ""
     1347           then do:
     1348             undo move_block, retry move_block .
     1349           end.
     1350         end.
     1351         assign
     1352           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1353           no-error .
