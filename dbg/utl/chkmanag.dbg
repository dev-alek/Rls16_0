     1257           end.
     1258           assign
     1259             v-diasize-change-size = false
     1260           .
     1261           leave move_block .
     1262         end.
     1263       end.
     1264       assign
     1265         v-diasize-need-full-display = true
     1266       .
     1267       if v-diasize-change-size = false
     1268       then do:
     1269         assign
     1270           v-diasize-change-size = true
     1271         .
     1272       end.
     1273       else do:
     1274         return .
     1275       end.
     1276       assign
     1277         v-frame-height = frame Dialog-Frame :height
     1278         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1279         v-browse-height = v-diasize-browse-handle :height
     1280       .
     1281       for each buf_temp-browse-handle
     1282         where buf_temp-browse-handle.browse-type = 'height':u
     1283       :
     1284         assign
     1285           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1286         .
     1287       end.
     1288       for each buf_temp-diasize-handle
     1289       :
     1290         delete buf_temp-diasize-handle .
     1291       end.
     1292       assign
     1293         v-field-group-handle = frame Dialog-Frame :first-child
     1294       .
