     1368           where buf_temp-browse-handle.browse-type = 'height':u
     1369         on error undo move_block, retry move_block
     1370         :
     1371           assign
     1372             buf_temp-browse-handle.browse-handle :height
     1373               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1374             no-error .
