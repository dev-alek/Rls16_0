     2565       ,input icount
     2566       ) .
     2567   END PROCEDURE.
     2568   PROCEDURE chk-price-doc :
     2569     define variable icount      as integer no-undo .
     2570     define variable ind         as integer no-undo .
     2571     define variable v-test-name as character no-undo .
     2572     assign
     2573       v-test-name = "Проверка заголовков переоценок (chk-price-doc)"
     2574     .
     2575     run log-test-started in this-procedure
     2576       (input v-test-name
     2577       ).
     2578     run waitfram-show in this-procedure
     2579       (input v-test-name
     2580       ).
     2581     define buffer buf_price-doc for ub.price-doc .
     2582     for each ub.price-doc no-lock
     2583     :
     2584       assign
     2585         ind = ind + 1
     2586       .
     2587       if ind mod 10 = 0 then do:
     2588         run waitfram-show in this-procedure
     2589           (input "Переоценка " + string(ub.price-doc.doc-num, 'x(8)':u)
     2590             + " Найдено ошибок " + STRING(icount)
     2591           ).
     2592       end.
     2593       if (ub.price-doc.fact-num > 0) <> (ub.price-doc.status_ = 'акт':U) then do:
     2594         assign
     2595           icount = icount + 1
     2596         .
     2597         run log-error
     2598           (input 'price-doc':U
     2599           ,input price-doc.obj-type
     2600           ,input price-doc.obj-code
     2601           ,input ""
     2602           ,input ""
     2603           ,input 0
     2604           ,input 'price-doc-status-fact-num '
     2605             + ' doc-num = ' + string(price-doc.doc-num)
     2606             + ' status_ = ' + string(price-doc.status_)
     2607           ).
     2608       end.
     2609       if ub.price-doc.status_ = 'акт':U then do:
     2610         if ub.price-doc.fact-date = ? then do:
     2611           assign
     2612             icount = icount + 1
     2613           .
     2614           run log-error
     2615             (input 'price-doc':U
     2616             ,input price-doc.obj-type
     2617             ,input price-doc.obj-code
     2618             ,input ""
     2619             ,input ""
     2620             ,input 0
     2621             ,input 'price-doc-status-fact-date '
     2622               + ' doc-num = ' + string(price-doc.doc-num)
     2623               + ' status_ = ' + string(price-doc.status_)
     2624               + ' fact-date = ' + string(price-doc.fact-date)
     2625             ).
     2626         end.
     2627       end.
     2628       if ub.price-doc.status_ = 'акт':U then do:
     2629         find last buf_price-doc no-lock
     2630           where buf_price-doc.obj-type = ub.price-doc.obj-type
     2631             and buf_price-doc.obj-code = ub.price-doc.obj-code
     2632             and buf_price-doc.fact-num < ub.price-doc.fact-num
     2633           use-index fact-close
     2634           no-error .
     2635         if available buf_price-doc then do:
     2636           if buf_price-doc.fact-date > ub.price-doc.fact-date then do:
     2637             assign
     2638               icount = icount + 1
     2639             .
     2640             run log-error
     2641               (input 'price-doc':U
     2642               ,input price-doc.obj-type
     2643               ,input price-doc.obj-code
     2644               ,input ""
     2645               ,input ""
     2646               ,input 0
     2647               ,input 'price-doc-close-fact-order '
     2648                 + ' price-doc.doc-num = ' + string(price-doc.doc-num)
     2649                 + ' price-doc.fact-num = ' + string(price-doc.fact-num)
     2650                 + ' price-doc.fact-date = ' + string(price-doc.fact-date)
     2651                 + ' buf_price-doc.doc-num = ' + string(buf_price-doc.doc-num)
     2652                 + ' buf_price-doc.fact-num = ' + string(buf_price-doc.fact-num)
     2653                 + ' buf_price-doc.fact-date = ' + string(buf_price-doc.fact-date)
     2654               ).
     2655           end.
     2656         end.
     2657       end.
     2658     end.
     2659     run waitfram-hide in this-procedure .
     2660     run log-test-finished in this-procedure
     2661       (input v-test-name
     2662       ,input icount
     2663       ) .
     2664   END PROCEDURE.
     2665   PROCEDURE chk-price-list :
     2666     define variable icount      as integer no-undo .
     2667     define variable ind         as integer no-undo .
     2668     define variable v-artic-str as character no-undo .
     2669     define variable v-test-name as character no-undo .
     2670     assign
     2671       v-test-name = "Проверка строк переоценок (chk-price-list)"
     2672     .
     2673     run log-test-started in this-procedure
     2674       (input v-test-name
     2675       ).
     2676     run waitfram-show in this-procedure
     2677       (input v-test-name
     2678       ).
     2679     for each ub.price-list no-lock
     2680     :
     2681       assign
     2682         ind = ind + 1
     2683       .
     2684       if ind mod 10 = 0 then do:
     2685         assign
     2686           v-artic-str = string(price-list.artic)
     2687                       + " " + string(price-list.prod-type)
     2688                       + " " + string(price-list.prod-code)
     2689         .
     2690         run waitfram-show in this-procedure
     2691           (input "Переоценка " + string(price-list.doc-num, 'x(8)':u)
     2692             + " Артикул " + string(v-artic-str, 'x(25)':u)
     2693             + " Найдено ошибок " + STRING(icount)
     2694           ).
     2695       end.
     2696       find first ub.price-doc no-lock
     2697         where ub.price-doc.doc-num = ub.price-list.doc-num
     2698         no-error .
     2699       if not available ub.price-doc then do:
     2700         assign
     2701           icount = icount + 1
     2702         .
     2703         run log-error
     2704           (input "price-list"
     2705           ,input price-list.obj-type
     2706           ,input price-list.obj-code
     2707           ,input price-list.artic
     2708           ,input price-list.prod-type
     2709           ,input price-list.prod-code
     2710           ,input 'price-doc-not-exist '
     2711             + ' doc-num = ' + string(price-list.doc-num)
     2712           ).
     2713         next .
     2714       end.
     2715       find first ub.goods no-lock
     2716         where ub.goods.artic     = ub.price-list.artic
     2717           and ub.goods.prod-type = ub.price-list.prod-type
     2718           and ub.goods.prod-code = ub.price-list.prod-code
     2719         no-error .
     2720       if not available ub.goods then do:
     2721         assign
     2722           icount = icount + 1
     2723         .
     2724         run log-error
     2725           (input "price-list"
     2726           ,input price-list.obj-type
     2727           ,input price-list.obj-code
     2728           ,input price-list.artic
     2729           ,input price-list.prod-type
     2730           ,input price-list.prod-code
     2731           ,input 'price-list-goods-not-exist '
     2732             + ' doc-num = ' + string(price-list.doc-num)
     2733           ).
     2734         next .
     2735       end.
     2736       if ub.price-list.obj-type <> ub.price-doc.obj-type
     2737       or ub.price-list.obj-code <> ub.price-doc.obj-code
     2738       then do:
     2739         assign
     2740           icount = icount + 1
     2741         .
     2742         run log-error
     2743           (input "price-list"
     2744           ,input price-list.obj-type
     2745           ,input price-list.obj-code
     2746           ,input price-list.artic
     2747           ,input price-list.prod-type
     2748           ,input price-list.prod-code
     2749           ,input 'price-list-object '
     2750             + ' price-doc.obj-type ' + ' = ' + string(price-doc.obj-type)
     2751             + ' price-doc.obj-code ' + ' = ' + string(price-doc.obj-code)
     2752           ).
     2753       end.
     2754       if ub.price-list.fact-order <> ub.price-doc.fact-order then do:
     2755         assign
     2756           icount = icount + 1
     2757         .
     2758         run log-error
     2759           (input "price-list"
     2760           ,input price-list.obj-type
     2761           ,input price-list.obj-code
     2762           ,input price-list.artic
     2763           ,input price-list.prod-type
     2764           ,input price-list.prod-code
     2765           ,input 'price-list-fact-num '
     2766             + ' price-list.fact-num ' + ' = ' + string(price-list.fact-order)
     2767             + ' price-doc.fact-num ' + ' = ' + string(price-doc.fact-order)
     2768           ).
     2769       end.
     2770     end.
     2771     run waitfram-hide in this-procedure .
     2772     run log-test-finished in this-procedure
     2773       (input v-test-name
     2774       ,input icount
     2775       ) .
     2776   END PROCEDURE.
     2777   PROCEDURE clear-temp-object :
     2778     define buffer buf_temp-object for temp-object .
     2779     for each buf_temp-object :
     2780       delete buf_temp-object .
     2781     end.
     2782   END PROCEDURE.
     2783   PROCEDURE create-temp-procedure :
     2784     define input parameter p-label     as character no-undo .
     2785     define input parameter p-proc-name as character no-undo .
     2786     define input parameter p-group     as character no-undo .
     2787     define input parameter p-descr     as character no-undo .
     2788     define buffer buf_temp-procedure for temp-procedure .
     2789     assign
     2790       v-proc-order = v-proc-order + 1
     2791     .
     2792     create buf_temp-procedure .
     2793     assign
     2794       buf_temp-procedure.proc-order = v-proc-order
     2795       buf_temp-procedure.proc-label = p-label
     2796       buf_temp-procedure.proc-name  = p-proc-name
     2797       buf_temp-procedure.proc-group = p-group
     2798       buf_temp-procedure.proc-descr = p-descr
     2799     .
     2800   END PROCEDURE.
     2801   PROCEDURE disable_UI :
     2802     HIDE FRAME Dialog-Frame.
     2803   END PROCEDURE.
     2804   PROCEDURE enable_UI :
     2805     DISPLAY EDITOR-Log EDITOR-Help
     2806         WITH FRAME Dialog-Frame.
     2807     ENABLE b-exit b-help b-mark b-check BROWSE-1 EDITOR-Log EDITOR-Help
     2808         WITH FRAME Dialog-Frame.
     2809     VIEW FRAME Dialog-Frame.
     2810     OPEN QUERY BROWSE-1 FOR EACH temp-procedure .
     2811   END PROCEDURE.
     2812   PROCEDURE fill-temp-procedure :
     2813     run create-temp-procedure in this-procedure
     2814       (input "Свободно <-> Факт"
     2815       ,input "find-bad-goods-free-fact"
     2816       ,input "1"
     2817       ,input ""
     2818       ) .
     2819     run create-temp-procedure in this-procedure
     2820       (input "Товар <-> Шкала"
     2821       ,input "find-bad-goods-prt-obj"
     2822       ,input "1"
     2823       ,input ""
     2824       ) .
     2825     run create-temp-procedure in this-procedure
     2826       (input "Товар <-> Партии"
     2827       ,input "find-bad-goods-parts"
     2828       ,input "1"
     2829       ,input ""
     2830       ) .
     2831     run create-temp-procedure in this-procedure
     2832       (input "Документы"
     2833       ,input "chk-doc-line"
     2834       ,input "1"
     2835       ,input ""
     2836       ) .
     2837     run create-temp-procedure in this-procedure
     2838       (input "Переоценка Строки"
     2839       ,input "chk-price-list"
     2840       ,input "1"
     2841       ,input ""
     2842       ) .
     2843     run create-temp-procedure in this-procedure
     2844       (input "Переоценка Заголовки"
     2845       ,input "chk-price-doc"
     2846       ,input "1"
     2847       ,input ""
     2848       ) .
     2849     run create-temp-procedure in this-procedure
     2850       (input "Товар - Подробно"
     2851       ,input "chk-allcheck"
     2852       ,input "2"
     2853       ,input "Подробная проверка товара"
     2854       ) .
     2855     run create-temp-procedure in this-procedure
     2856       (input "Объекты-Главная БД фирмы"
     2857       ,input "chk-firm-db-num"
     2858       ,input "2"
     2859       ,input "Поиск объектов, у которых БД не равна БД фирмы"
     2860       ) .
     2861     run create-temp-procedure in this-procedure
     2862       (input "Активные индексы"
     2863       ,input "chk-idxinact"
     2864       ,input "3"
     2865       ,input "Поиск неактивных индексов в базе данных"
     2866       ) .
     2867   END PROCEDURE.
     2868   PROCEDURE find-bad-goods-free-fact :
     2869     define variable icount       as integer no-undo .
     2870     define variable v-object-str as character no-undo .
     2871     define variable v-artic-str  as character no-undo .
     2872     define variable v-test-name as character no-undo .
     2873     assign
     2874       v-test-name = "Проверка свободного количества (find-bad-goods-free-fact)"
     2875     .
     2876     run log-test-started in this-procedure
     2877       (input v-test-name
     2878       ).
     2879     run waitfram-show in this-procedure
     2880       (input v-test-name
     2881       ).
     2882     for each ub.gds-obj no-lock
     2883       where ub.gds-obj.free-qnty <> ub.gds-obj.fact-qnty
     2884     :
     2885       assign
     2886         v-object-str = string(ub.gds-obj.obj-type)
     2887                     + " " + string(ub.gds-obj.obj-code)
     2888         v-artic-str  = string(ub.gds-obj.artic)
     2889                     + " " + string(ub.gds-obj.prod-type)
     2890                     + " " + string(ub.gds-obj.prod-code)
     2891       .
     2892       run waitfram-show in this-procedure
     2893         (input "Объект " + string(v-object-str, 'x(10)':u)
     2894           + " Артикул " + string(v-artic-str, 'x(25)':u)
     2895           + " Найдено ошибок " + STRING(icount)
     2896         ).
     2897       find first ub.parts no-lock
     2898         where ub.parts.obj-type  = ub.gds-obj.obj-type
     2899           and ub.parts.obj-code  = ub.gds-obj.obj-code
     2900           and ub.parts.artic     = ub.gds-obj.artic
     2901           and ub.parts.prod-type = ub.gds-obj.prod-type
     2902           and ub.parts.prod-code = ub.gds-obj.prod-code
     2903           and ub.parts.out-code  <> 'free-zone':U
     2904           and ub.parts.rsrv-free = yes
     2905           and ub.parts.status_   = no
     2906         no-error .
     2907       if not available ub.parts then do:
     2908         assign
     2909           icount = icount + 1
     2910         .
     2911         run log-error
     2912           (input "gds-obj"
     2913           ,input ub.gds-obj.obj-type
     2914           ,input ub.gds-obj.obj-code
     2915           ,input ub.gds-obj.artic
     2916           ,input ub.gds-obj.prod-type
     2917           ,input ub.gds-obj.prod-code
     2918           ,input 'free-fact gds-obj.free-qnty = ' + STRING(ub.gds-obj.free-qnty)
     2919                 + ' gds-obj.fact-qnty = ' + STRING(ub.gds-obj.fact-qnty)
     2920           ).
     2921       end.
     2922     end.
     2923     run waitfram-hide in this-procedure .
     2924     run log-test-finished in this-procedure
     2925       (input v-test-name
     2926       ,input icount
     2927       ) .
     2928   END PROCEDURE.
     2929   PROCEDURE find-bad-goods-parts :
     2930   define variable icount       as integer   no-undo .
     2931   define variable jcount       as integer   no-undo .
     2932   define variable v-object-str as character no-undo .
     2933   define variable v-artic-str  as character no-undo .
     2934   define variable v-test-name as character no-undo .
     2935   define variable v-gds-obj as decimal   no-undo .
     2936     assign
     2937       v-test-name = "Проверка партий свободной зоны (find-bad-goods-parts)"
     2938     .
     2939     run log-test-started in this-procedure
     2940       (input v-test-name
     2941       ).
     2942     define variable v-parts-qnty as decimal no-undo .
     2943     run waitfram-show in this-procedure
     2944       (input v-test-name
     2945       ).
     2946     for each ub.gds-obj no-lock
     2947     :
     2948       assign
     2949         v-object-str  = string(ub.gds-obj.obj-type)
     2950                       + " " + string(ub.gds-obj.obj-code)
     2951         v-artic-str   = string(ub.gds-obj.artic)
     2952                       + " " + string(ub.gds-obj.prod-type)
     2953                       + " " + string(ub.gds-obj.prod-code)
     2954       .
     2955       run waitfram-show in this-procedure
     2956         (input "Объект " + string(v-object-str, 'x(10)':u)
     2957           + " Артикул " + string(v-artic-str, 'x(25)':u)
     2958           + " Найдено ошибок " + STRING(icount)
     2959         ).
     2960       assign
     2961         v-parts-qnty = 0
     2962       .
     2963       for each ub.parts no-lock
     2964         where ub.parts.obj-type  = ub.gds-obj.obj-type
     2965           and ub.parts.obj-code  = ub.gds-obj.obj-code
     2966           and ub.parts.artic     = ub.gds-obj.artic
     2967           and ub.parts.prod-type = ub.gds-obj.prod-type
     2968           and ub.parts.prod-code = ub.gds-obj.prod-code
     2969           and ub.parts.status_   = no
     2970           and ub.parts.rsrv-free = yes
     2971       :
     2972         if ub.parts.out-code = 'free-zone':U then do:
     2973           assign
     2974             v-parts-qnty = v-parts-qnty + ub.parts.qnty
     2975           .
     2976         end.
     2977         else do:
     2978           find first ub.trn-doc where ub.trn-doc.doc-code = ub.parts.out-code .
     2979           if lookup(ub.trn-doc.ext-doc-type,"ee,ep,es,we,") > 0 then do:
     2980               assign
     2981                 v-parts-qnty = v-parts-qnty  - ub.parts.qnty
     2982               .
     2983           end.
     2984           else do:
     2985               assign
     2986                 v-parts-qnty = v-parts-qnty + ub.parts.qnty
     2987               .
     2988           end.
     2989         end.
     2990       end.
     2991       if v-parts-qnty <> ub.gds-obj.fact-qnty then do:
     2992         assign
     2993           icount = icount + 1
     2994           v-gds-obj = ub.gds-obj.fact-qnty
     2995         .
     2996         run log-error
     2997           (input "gds-obj"
     2998           ,input ub.gds-obj.obj-type
     2999           ,input ub.gds-obj.obj-code
     3000           ,input ub.gds-obj.artic
     3001           ,input ub.gds-obj.prod-type
     3002           ,input ub.gds-obj.prod-code
     3003           ,input 'parts free-parts-qnty = ' + STRING(v-parts-qnty)
     3004                 + ' gds-obj.fact-qnty =' + STRING(v-gds-obj)
     3005           ).
     3006       end.
     3007     end.
     3008     run waitfram-hide in this-procedure .
     3009     run log-test-finished in this-procedure
     3010       (input v-test-name
     3011       ,input icount
     3012       ) .
     3013   END PROCEDURE.
     3014   PROCEDURE find-bad-goods-prt-obj :
     3015     define variable v-object-str as character no-undo .
     3016     define variable v-artic-str  as character no-undo .
     3017     define variable v-test-name as character no-undo .
     3018     assign
     3019       v-test-name = "Проверка количеств по шкалам (find-bad-goods-prt-obj)"
     3020     .
     3021     run log-test-started in this-procedure
     3022       (input v-test-name
     3023       ).
     3024     define variable v-total-fact-qnty as decimal no-undo .
     3025     define variable v-total-free-qnty as decimal no-undo .
     3026     define variable icount as integer no-undo .
     3027     run waitfram-show in this-procedure
     3028       (input v-test-name
     3029       ).
     3030     for each gds-obj no-lock
     3031     :
     3032       assign
     3033         v-object-str  = string(ub.gds-obj.obj-type)
     3034                       + " " + string(ub.gds-obj.obj-code)
     3035         v-artic-str   = string(ub.gds-obj.artic)
     3036                       + " " + string(ub.gds-obj.prod-type)
     3037                       + " " + string(ub.gds-obj.prod-code)
     3038       .
     3039       run waitfram-show in this-procedure
     3040         (input "Объект " + string(v-object-str, 'x(10)':u)
     3041           + " Артикул " + string(v-artic-str, 'x(25)':u)
     3042           + " Найдено ошибок " + STRING(icount)
     3043         ).
     3044       assign
     3045         v-total-fact-qnty = 0
     3046         v-total-free-qnty  = 0
     3047       .
     3048       find first ub.goods no-lock
     3049         where ub.goods.artic     = ub.gds-obj.artic
     3050           and ub.goods.prod-type = ub.gds-obj.prod-type
     3051           and ub.goods.prod-code = ub.gds-obj.prod-code
     3052         no-error .
     3053       if not available ub.goods then do:
     3054         assign
     3055           icount = icount + 1
     3056         .
     3057         run log-error
     3058           (input "gds-obj"
     3059           ,input ub.gds-obj.obj-type
     3060           ,input ub.gds-obj.obj-code
     3061           ,input ub.gds-obj.artic
     3062           ,input ub.gds-obj.prod-type
     3063           ,input ub.gds-obj.prod-code
     3064           ,input 'goods not found'
     3065           ).
     3066         next .
     3067       end.
     3068       find first ub.gds-prt no-lock
     3069         where ub.gds-prt.upper-code = ub.goods.prt-root
     3070         no-error .
     3071       if not available ub.gds-prt then do:
     3072         assign
     3073           icount = icount + 1
     3074         .
     3075         run log-error
     3076           (input "gds-obj"
     3077           ,input ub.gds-obj.obj-type
     3078           ,input ub.gds-obj.obj-code
     3079           ,input ub.gds-obj.artic
     3080           ,input ub.gds-obj.prod-type
     3081           ,input ub.gds-obj.prod-code
     3082           ,input 'root_node_not_found goods.prt-root=' + string(ub.goods.prt-root)
     3083           ).
     3084         next .
     3085       end.
     3086       for each ub.prt-obj no-lock
     3087         where ub.prt-obj.obj-type  = ub.gds-obj.obj-type
     3088           and ub.prt-obj.obj-code  = ub.gds-obj.obj-code
     3089           and ub.prt-obj.artic     = ub.gds-obj.artic
     3090           and ub.prt-obj.prod-type = ub.gds-obj.prod-type
     3091           and ub.prt-obj.prod-code = ub.gds-obj.prod-code
     3092           and ub.prt-obj.prt-code  = ub.gds-prt.node-code
     3093       :
     3094         assign
     3095           v-total-fact-qnty = v-total-fact-qnty  + ub.prt-obj.fact-qnty
     3096           v-total-free-qnty = v-total-free-qnty  + ub.prt-obj.free-qnty
     3097         .
     3098       end.
     3099       if v-total-fact-qnty <> ub.gds-obj.fact-qnty
     3100       or v-total-free-qnty <> ub.gds-obj.free-qnty
     3101       then do:
     3102         assign
     3103           icount = icount + 1
     3104         .
     3105         run log-error
     3106           (input "gds-obj"
     3107           ,input ub.gds-obj.obj-type
     3108           ,input ub.gds-obj.obj-code
     3109           ,input ub.gds-obj.artic
     3110           ,input ub.gds-obj.prod-type
     3111           ,input ub.gds-obj.prod-code
     3112           ,input 'goods-gds-prt gds-obj.free-qnty = ' + STRING(ub.gds-obj.free-qnty)
     3113             + ' gds-obj.fact-qnty = '            + STRING(ub.gds-obj.fact-qnty)
     3114             + ' total prt-obj.free-qnty = '      + STRING(v-total-free-qnty)
     3115             + ' total prt-obj.fact-qnty = '      + STRING(v-total-fact-qnty)
     3116           ).
     3117       end.
     3118     end.
     3119     run waitfram-hide in this-procedure .
     3120     run log-test-finished in this-procedure
     3121       (input v-test-name
     3122       ,input icount
     3123       ) .
     3124   END PROCEDURE.
     3125   PROCEDURE log-error :
     3126     define input parameter p-table-name as character no-undo .
     3127     define input parameter v-obj-type   like ub.gds-obj.obj-type  no-undo .
     3128     define input parameter v-obj-code   like ub.gds-obj.obj-code  no-undo .
     3129     define input parameter v-artic      like ub.gds-obj.artic     no-undo .
     3130     define input parameter v-prod-type  like ub.gds-obj.prod-type no-undo .
     3131     define input parameter v-prod-code  like ub.gds-obj.prod-code no-undo .
     3132     define input parameter v-error-msg  as character no-undo .
     3133     define variable v-today as date      no-undo.
     3134     define variable v-time  as integer   no-undo.
     3135     output to chkmanag.err append .
     3136     run cur-time in this-procedure ( output v-today
     3137                                    , output v-time
     3138                                    ).
     3139     export
     3140       string(v-today, '99/99/9999':u) string(v-time, 'HH:MM':u)
     3141       p-table-name
     3142       v-obj-type v-obj-code v-artic v-prod-type v-prod-code
     3143       v-error-msg .
     3144     output close .
     3145   END PROCEDURE.
     3146   PROCEDURE log-information :
     3147     define input parameter p-message as character no-undo .
     3148     define variable lok as logical   no-undo .
     3149     do with frame Dialog-Frame:
     3150       assign
     3151         lok = EDITOR-Log :move-to-eof()
     3152         lok = EDITOR-Log :insert-string(p-message + chr(10) )
     3153       .
     3154     end.
     3155   END PROCEDURE.
     3156   PROCEDURE log-test-finished :
     3157     define input parameter p-test-name as character no-undo .
     3158     define input parameter p-err-count as integer   no-undo .
     3159     define variable v-message-text as character no-undo .
     3160     assign
     3161       v-message-text = (if p-err-count > 0 then "**" else "  ")
     3162             + " " + cur-time-string()
     3163             + " " + "ошибок" + " " + string(p-err-count)
     3164             + " " + p-test-name
     3165     .
     3166     output to chkmanag.log append .
     3167     export v-message-text .
     3168     output close .
     3169     run log-information
     3170       (input v-message-text
     3171       ) .
     3172   END PROCEDURE.
     3173   PROCEDURE log-test-started :
     3174     define input parameter p-test-name as character no-undo .
     3175   END PROCEDURE.
     3176   PROCEDURE make-check :
     3177     define input parameter p-temp-procedure-recid as recid no-undo .
     3178     define buffer buf_temp-procedure for temp-procedure .
     3179     find first buf_temp-procedure
     3180       where recid(buf_temp-procedure) = p-temp-procedure-recid
     3181       .
     3182     run value(buf_temp-procedure.proc-name) in this-procedure .
     3183   END PROCEDURE.
     3184   PROCEDURE output-temp-object :
     3185     define buffer buf_temp-object for temp-object .
     3186     output to chkmanag.obj .
     3187     for each buf_temp-object :
     3188       display buf_temp-object .
     3189     end.
     3190     output close .
     3191   END PROCEDURE.
     3192   PROCEDURE register-document :
     3193     define input parameter p-obj-type   like ub.trn-doc.obj-type   no-undo .
     3194     define input parameter p-obj-code   like ub.trn-doc.obj-code   no-undo .
     3195     define input parameter p-status_    like ub.trn-doc.status_    no-undo .
     3196     define input parameter p-fact-order like ub.trn-doc.fact-order no-undo .
     3197     define buffer buf_temp-object for temp-object .
     3198     if p-status_ = 'факт':U then do:
     3199       find first buf_temp-object
     3200         where buf_temp-object.obj-type = p-obj-type
     3201           and buf_temp-object.obj-code = p-obj-code
     3202         no-error .
     3203       if not available buf_temp-object then do:
     3204         create buf_temp-object .
     3205         assign
     3206           buf_temp-object.obj-type = p-obj-type
     3207           buf_temp-object.obj-code = p-obj-code
     3208         .
     3209       end.
     3210       if buf_temp-object.fact-order = ?
     3211       or buf_temp-object.fact-order < p-fact-order then do:
     3212         assign
     3213           buf_temp-object.fact-order = p-fact-order
     3214         .
     3215       end.
     3216     end.
     3217   END PROCEDURE.
     3218   PROCEDURE show-help :
     3219     do with frame Dialog-Frame:
     3220       assign
     3221         editor-help :screen-value = "Рекомендуемый порядок проверки базы данных: " + chr(10)
     3222           + "Сначала последовательно выполните тесты Группы А. "
     3223           + "После выполнения каждого теста требуется проверить файлы ошибок chkmanag.err и chkmanag.log. "
     3224           + "В случае обнаружения ошибок необходимо обратиться в службу поддержки пользователей. "
     3225           + chr(10)
     3226           + chr(10)
     3227           + "Если в результате выполнения тестов Группы А не были найдены ошибки, то выполните тесты Группы Б."
     3228           + "В случае обнаружения ошибок необходимо обратиться в службу поддержки пользователей. "
     3229           + chr(10)
     3230       .
     3231     end.
     3232   END PROCEDURE.
     3233   FUNCTION get-mark RETURNS CHARACTER
     3234     ( input v-recid  as recid ) :
     3235     if lookup(string(v-recid), del-list ) > 0 then do:
     3236       return "*".
     3237     end.
     3238     return "".
     3239   END FUNCTION.
