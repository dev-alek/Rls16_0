        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: partshst.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/partshst.p $":U .
        8   define variable vss-description as character no-undo init "Простановка кода фирмы в партии".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define  temp-table temp-host no-undo
       80     field host-code like ub.store.host-code
       81     index xpk host-code
       82   .
       83   define  temp-table temp-obj no-undo
       84     field obj-type  like ub.clients.obj-type
       85     field obj-code  like ub.clients.obj-code
       86     field host-code like ub.store.host-code
       87     field db-num    like ub.clients.db-num
       88     index xpk  obj-type obj-code
       89     index xie1 host-code
       90     index xie2 db-num host-code
       91   .
       92   procedure init-temphost:
       93     define buffer buf_store   for ub.store .
       94     define buffer buf_shop    for ub.shop .
       95     define buffer buf_clients for ub.clients .
       96     define buffer buf_db for ub.db .
       97     define buffer buf_temp-host for temp-host .
       98     define buffer buf_temp-obj for temp-obj .
       99     do
      100     on error undo, return error return-value
      101     :
      102       for each buf_store
      103       on error undo, return error
      104       :
      105         find first buf_temp-host
      106           where buf_temp-host.host-code = buf_store.host-code
      107           no-error .
      108         if not available buf_temp-host
      109         then do:
      110           create buf_temp-host .
      111           assign
      112             buf_temp-host.host-code = buf_store.host-code
      113           .
      114         end.
      115         find first buf_clients no-lock
      116           where buf_clients.obj-type = 'скл':U
      117             and buf_clients.obj-code = buf_store.obj-code
      118           no-error .
      119         if not available buf_clients
      120         then do:
      121           message
      122             "Ошибка при поиске клиента" skip
      123             "Клиент" 'скл':U buf_store.obj-code skip
      124             view-as alert-box error .
      125           undo, return error .
      126         end.
      127         create buf_temp-obj .
      128         assign
      129           buf_temp-obj.obj-type  = 'скл':U
      130           buf_temp-obj.obj-code  = buf_store.obj-code
      131           buf_temp-obj.host-code = buf_store.host-code
      132           buf_temp-obj.db-num    = buf_clients.db-num
      133         .
      134       end.
      135       for each buf_shop
      136       on error undo, return error
      137       :
      138         find first buf_temp-host
      139           where buf_temp-host.host-code = buf_shop.host-code
      140           no-error .
      141         if not available buf_temp-host
      142         then do:
      143           create buf_temp-host .
      144           assign
      145             buf_temp-host.host-code = buf_shop.host-code
      146           .
      147         end.
      148         find first buf_clients no-lock
      149           where buf_clients.obj-type = 'маг':U
      150             and buf_clients.obj-code = buf_shop.obj-code
      151           no-error .
      152         if not available buf_clients then do:
      153           message
      154             "Ошибка при поиске клиента" skip
      155             "Клиент" 'маг':U buf_shop.obj-code skip
      156             view-as alert-box error .
      157           undo, return error .
      158         end.
      159         create buf_temp-obj .
      160         assign
      161           buf_temp-obj.obj-type  = 'маг':U
      162           buf_temp-obj.obj-code  = buf_shop.obj-code
      163           buf_temp-obj.host-code = buf_shop.host-code
      164           buf_temp-obj.db-num    = buf_clients.db-num
      165         .
      166       end.
      167     end.
      168   end.
      169   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170     define variable v-cntxt-db-num        as integer   no-undo .
      171     define variable v-cntxt-userid        as character no-undo .
      172     define variable v-cntxt-level         as character no-undo .
      173     define variable v-cntxt-host-code-obj as integer   no-undo .
      174     define variable v-cntxt-obj-type      as character no-undo .
      175     define variable v-cntxt-obj-code      as integer   no-undo .
      176     define variable v-cntxt-db-num-obj    as integer   no-undo .
      177     define variable v-cntxt-is-admin      as logical   no-undo .
      178   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   define variable v-waitfram-action01         as character   no-undo .
      180   define variable v-waitfram-action02         as character   no-undo .
      181   define variable v-waitfram-action03         as character   no-undo .
      182   define variable mWaitFramTextBeg            as character   no-undo.
      183   define variable mWaitFramTextEnd            as character   no-undo.
      184   define variable mWaitFramView               as logical     no-undo.
      185   define variable mWaitProcEvent              as logical     no-undo init yes.
      186   define variable mWaitFramInterval           as integer     no-undo init 1 .
      187   define variable mWaitFramStop               as logical     no-undo.
      188   define variable mWaitFramStopUser           as logical     no-undo.
      189   define variable mWaitFramStopTimeOut        as logical     no-undo.
      190   define variable mWaitFramStartProc          as datetime-tz no-undo.
      191   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      192   define button B-WaitFramStop auto-end-key
      193        label "Стоп"
      194        size 10 by 1 tooltip "Остоновить процесс".
      195   define button B-viewProcInfo
      196        label "Информация"
      197        size 15 by 1 tooltip "Информация о процесс".
      198   define frame waitfram
      199     v-waitfram-action01 format "x(72)" no-label skip
      200     v-waitfram-action02 format "x(72)" no-label skip
      201     v-waitfram-action03 format "x(72)" no-label skip
      202     B-viewProcInfo
      203     B-WaitFramStop at row 4 col 30
      204     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      205     .
      206   define new global shared variable mBatchMode as logical no-undo init ?.
      207   define variable mFramBachModHandle as handle no-undo.
      208   mFramBachModHandle = frame waitfram:handle.
      209   define variable mFameOldVis as logical no-undo.
      210   define variable mVisCUrentVin as logical no-undo.
      211   if session:batch-mode
      212   then
      213      mBatchMode = yes.
      214   if mBatchMode = ? then do:
      215     mVisCUrentVin = current-window:visible.
      216     mFameOldVis = mFramBachModHandle:visible.
      217     mFramBachModHandle:visible  = yes.
      218     mBatchMode = mFramBachModHandle:visible ne yes.
      219     mFramBachModHandle:visible = mFameOldVis.
      220     current-window:visible = mVisCUrentVin.
      221   end.
      222    if  log-manager:logfile-name ne ?
      223     then DO:
      224         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      225         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      226         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      227     end.
      228   on choose of B-WaitFramStop in frame waitfram
      229   do:
      230     mWaitFramStop = yes.
      231     mWaitFramStopUser = yes.
      232   end.
      233   function waitfram-check-timeout returns logical():
      234      define variable vtime as int64 no-undo.
      235      if mWaitFramStopTimeOut
      236      then
      237         return yes.
      238      vtime = ( now - mWaitFramStartProc ) / 1000 .
      239      if     mWaitFramTimeOut ne ?
      240         and mWaitFramTimeOut ne 0
      241         and mWaitFramTimeOut lt vtime
      242      then do:
      243         mWaitFramStopTimeOut = yes.
      244      end.
      245      return mWaitFramStopTimeOut.
      246   end.
      247   procedure waitfram-hide :
      248     if not session:batch-mode
      249     then do
      250     on error undo, return error return-value
      251     :
      252       pause 0 before-hide .
      253       if not mBatchMode then
      254         hide frame waitfram .
      255     if     not mWaitFramView
      256        and mWaitProcEvent
      257     then
      258       process events .
      259     end.
      260   end procedure.
      261   procedure waitfram-show :
      262     define input  parameter p-message as character no-undo .
      263     define variable v-left-margin as integer   no-undo .
      264     if not session:batch-mode
      265     then do
      266     on error undo, return error return-value
      267     :
      268       if length(p-message) <= 70 then do:
      269         assign
      270           v-left-margin = integer((70 - length(p-message)) / 2)
      271         .
      272         assign
      273           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      274         .
      275         assign
      276           v-waitfram-action01 = " "
      277           v-waitfram-action02 = " "
      278                                    + fill(" ", v-left-margin)
      279                                    + p-message
      280           v-waitfram-action03 = " "
      281         .
      282       end.
      283       else do:
      284         define variable vRindex1 as integer no-undo.
      285         define variable vRindex2 as integer no-undo.
      286         vRindex1 = r-index(p-message," ",70).
      287         if vRindex1 = 0
      288         then
      289            vRindex1 = 70.
      290         if length(p-message)  <= vRindex1 + 70 then do:
      291           assign
      292             v-waitfram-action01 = " "
      293             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      294             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      295           .
      296         end.
      297         else do:
      298           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      299           if vRindex2 <= vRindex1
      300           then
      301              vRindex2 = vRindex1 + 70.
      302           assign
      303             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      304             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      305             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      306           .
      307         end.
      308       end.
      309       B-viewProcInfo:visible   in frame waitfram = no.
      310       B-viewProcInfo:sensitive in frame waitfram = no.
      311       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      312       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      313       if  (   mWaitFramView
      314          or  mWaitProcEvent)
      315          and not mBatchMode
      316       then
      317          display
      318             v-waitfram-action01 skip
      319             v-waitfram-action02 skip
      320             v-waitfram-action03 skip
      321          with frame waitfram .
      322       if     mWaitFramView
      323          then do:
      324             if     mWaitFramInterval ne ?
      325                and not mBatchMode
      326             then
      327                wait-for go of frame waitfram pause mWaitFramInterval.
      328          end.
      329          else
      330             if     mWaitProcEvent
      331                and not mBatchMode
      332             then
      333                process events .
      334     end.
      335   end procedure.
      336      procedure waitfram-show-this:
      337         define input  parameter iInterval as int64 no-undo.
      338         define variable vtime as int64 no-undo.
      339         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      340         mWaitFramInterval = iInterval.
      341         run waitfram-show (substitute("&1&2 &3&4" ,
      342                                       mWaitFramTextBeg ,
      343                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      344                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      345                                       mWaitFramTextEnd
      346                                      )
      347                           ).
      348      end.
      349      procedure WaitFramRunPause:
      350         define input  parameter iInterval as dec no-undo.
      351         define variable vStart  as datetime-tz no-undo.
      352         define variable vend    as datetime-tz no-undo.
      353         define variable vint as int64 no-undo.
      354         define variable vOk as logical no-undo.
      355         vStart = now.
      356         vend   = vStart.
      357         publish "WaitFramPause" (iInterval,output vOk).
      358         vend   =  now.
      359         vint = vend - vStart.
      360         vint = iInterval - vint / 1000.
      361         if     not mWaitFramStop
      362            and (   vint > 0
      363                 or (    not vOk
      364                     and iInterval eq ?
      365                     )
      366                 )
      367         then
      368            run waitfram-show-this (iInterval).
      369         vend   =  now.
      370         vint = vend - vStart.
      371         vint = iInterval - vint / 1000.
      372         if     not mWaitFramStop
      373            and vint > 0
      374         then do:
      375            run gbl/pause.p (vint * 1000).
      376         end.
      377         if iInterval ne ?
      378         then
      379            publish "WaitFramStop".
      380         waitfram-check-timeout().
      381      end.
      382      procedure WaitFramWaitFor:
      383         define input  parameter iInterval as dec no-undo.
      384         assign
      385            mWaitFramStartProc   = now
      386            mWaitFramStopUser    = no
      387            mWaitFramStopTimeOut = no
      388         .
      389         block-wait:
      390         do while not mWaitFramStop:
      391            run WaitFramRunPause (iInterval).
      392            if  waitfram-check-timeout()
      393            then do:
      394               leave block-wait.
      395            end.
      396         end.
      397         run waitfram-hide.
      398      end.
      399   procedure waitfram-join :
      400     define input  parameter p-line-1  as character no-undo .
      401     define input  parameter p-line-2  as character no-undo .
      402     define input  parameter p-line-3  as character no-undo .
      403     define output parameter p-message as character no-undo .
      404     do
      405     on error undo, return error return-value
      406     :
      407       assign
      408         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      409                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      410                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      411       .
      412     end.
      413   end procedure.
      414   function waitfram-join-function returns character
      415     (input p-line-1 as character
      416     ,input p-line-2 as character
      417     ,input p-line-3 as character
      418     ).
      419     define variable v-message as character no-undo .
      420     run waitfram-join in this-procedure
      421       (input  p-line-1
      422       ,input  p-line-2
      423       ,input  p-line-3
      424       ,output v-message
      425       ) .
      426     return v-message .
      427   end function .
      428   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   define temp-table userobjs_temp-user-obj no-undo
      430     field obj-type as character
      431     field obj-code as integer
      432     index xpk is primary unique obj-type obj-code
      433     .
      434   procedure userobjs_clear :
      435     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      436     do
      437     on error undo, return error return-value
      438     :
      439       for each buf_userobjs_temp-user-obj
      440       on error undo, return error return-value
      441       :
      442         delete buf_userobjs_temp-user-obj .
      443       end.
      444     end.
      445   end .
      446   procedure userobjs_object-count :
      447     define output parameter p-total-count as integer   no-undo .
      448     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      449     do
      450     on error undo, return error return-value
      451     :
      452       assign
      453         p-total-count = 0
      454       .
      455       for each buf_userobjs_temp-user-obj
      456       on error undo, return error return-value
      457       :
      458         assign
      459           p-total-count = p-total-count + 1
      460         .
      461       end.
      462     end.
      463   end.
      464   procedure userobjs_append :
      465      define input  parameter p-obj-type as character no-undo .
      466      define input  parameter p-obj-code as integer   no-undo .
      467     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      468     do
      469     on error undo, return error return-value
      470     :
      471       find first buf_userobjs_temp-user-obj
      472         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      473           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      474         no-error .
      475       if not available buf_userobjs_temp-user-obj
      476       then do:
      477         create buf_userobjs_temp-user-obj .
      478         assign
      479           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      480           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      481         .
      482       end.
      483     end.
      484   end.
      485   procedure userobjs_object-exist :
      486     define output parameter p-object-exist as logical   no-undo .
      487     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      488     do
      489     on error undo, return error return-value
      490     :
      491       find first buf_userobjs_temp-user-obj
      492         no-error .
      493       if not available buf_userobjs_temp-user-obj
      494       then do:
      495         assign
      496           p-object-exist = false
      497         .
      498       end.
      499       else do:
      500         assign
      501           p-object-exist = true
      502         .
      503       end.
      504     end.
      505   end.
      506   procedure userobjs_transfer :
      507     define input  parameter p-callback-handle as handle no-undo .
      508     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      509     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      510     do
      511     on error undo, return error return-value
      512     :
      513       if valid-handle(p-callback-handle) <> true
      514       then do:
      515         message
      516           vss-workfile vss-revision vss-description skip
      517           "Ошибка задания входных параметров" skip
      518           "Неизвестный указатель на процедуру" skip
      519           view-as alert-box error .
      520         undo, return error return-value .
      521       end.
      522       if p-callback-handle :get-signature("userobjs_append") = ""
      523       then do:
      524         message
      525           vss-workfile vss-revision vss-description skip
      526           "Ошибка задания входных параметров" skip
      527           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      528                     ,p-callback-handle :file-name
      529                     ) skip
      530           view-as alert-box error .
      531         undo, return error return-value .
      532       end.
      533       for each buf_userobjs_temp-user-obj
      534       on error undo, return error return-value
      535       :
      536         run userobjs_append in p-callback-handle
      537           (input  buf_userobjs_temp-user-obj.obj-type
      538           ,input  buf_userobjs_temp-user-obj.obj-code
      539           ) .
      540       end.
      541     end.
      542   end procedure.
      543   procedure userobjs_select-one :
      544      define input  parameter parparentproc     as widget-handle no-undo .
      545      define input  parameter p-db-num          as integer   no-undo .
      546      define input  parameter p-user-id         as character no-undo .
      547      define input  parameter p-host-code-obj   as integer   no-undo .
      548      define input  parameter p-obj-type        as character no-undo .
      549      define input  parameter p-obj-code        as integer   no-undo .
      550      define output parameter p-user-select     as logical   no-undo .
      551      define output parameter p-select-obj-type as character no-undo .
      552      define output parameter p-select-obj-code as character no-undo .
      553     do
      554     on error undo, return error return-value
      555     :
      556       run gbl/userobjs.w
      557         (input  parparentproc
      558         ,input  this-procedure :handle
      559         ,input  p-db-num
      560         ,input  p-user-id
      561         ,input  p-host-code-obj
      562         ,input  p-obj-type
      563         ,input  p-obj-code
      564         ,INPUT  "b-sel"
      565         ,output p-user-select
      566         ,output p-select-obj-type
      567         ,output p-select-obj-code
      568         ) .
      569     end.
      570   end.
      571   procedure userobjs_select-many :
      572     define input  parameter parparentproc   as widget-handle no-undo .
      573     define input  parameter p-db-num        as integer   no-undo .
      574     define input  parameter p-user-id       as character no-undo .
      575     define input  parameter p-host-code-obj as integer   no-undo .
      576     define input  parameter p-obj-type      as character no-undo .
      577     define input  parameter p-obj-code      as integer   no-undo .
      578     define output parameter p-user-select   as logical   no-undo .
      579     define variable v-select-obj-type as character no-undo .
      580     define variable v-select-obj-code as integer   no-undo .
      581     do
      582     on error undo, return error return-value
      583     :
      584       run gbl/userobjs.w
      585         (input  parparentproc
      586         ,input  this-procedure :handle
      587         ,input  p-db-num
      588         ,input  p-user-id
      589         ,input  p-host-code-obj
      590         ,input  p-obj-type
      591         ,input  p-obj-code
      592         ,INPUT  "b-sel,b-mark"
      593         ,output p-user-select
      594         ,output v-select-obj-type
      595         ,output v-select-obj-code
      596         ) .
      597     end.
      598   end.
      599   procedure thobjs :
      600      define input        parameter parparentproc     as widget-handle no-undo .
      601      define input        parameter i-bttns           as character     no-undo .
      602      define input        parameter i-list-mode       as character     no-undo.
      603      define input        parameter i-obj-type        as character     no-undo.
      604      define input        parameter i-db-num          as integer       no-undo.
      605      define input        parameter i-host-code       as integer       no-undo.
      606      define input-output parameter p-rid-list        as character     no-undo .
      607   run ref/thobjs.p
      608           ( input parparentproc
      609            ,input  this-procedure :handle
      610           , input i-bttns
      611           , input i-list-mode
      612           , input i-obj-type
      613           , input i-db-num
      614           , input i-host-code
      615           , input-output p-rid-list ) no-error .
      616   end.
      617   run init-temphost .
      618   define variable v-num as integer no-undo .
      619   run gbl/d-askw.w
      620     (input "Вопрос"
      621     ,input "Инициализация поля <код фирмы> в партиях." + chr(10)
      622       + "Результат работы записывается в файл partshst.txt" + chr(10)
      623       + "Ошибки записываются в файл partshst.err" + chr(10)
      624     ,input "|^"
      625     ,input "Нулевые|Все объекты|Выборочно|Отказ"
      626     ,input "Инициализирует партии с кодом фирмы ноль|"
      627          + "Проверяет партии свободной и расходных зон на всех объектах|"
      628          + "Проверяет партии свободной и расходных зон на выбранных объектах|"
      629          + ""
      630     ,input 1
      631     ,input 4
      632     ,output v-num
      633     ).
      634   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635     run mainmenu_getcntxt in parparentproc
      636       (output v-cntxt-db-num
      637       ,output v-cntxt-userid
      638       ,output v-cntxt-level
      639       ,output v-cntxt-host-code-obj
      640       ,output v-cntxt-obj-type
      641       ,output v-cntxt-obj-code
      642       ,output v-cntxt-db-num-obj
      643       ,output v-cntxt-is-admin
      644       ) .
      645   case v-num :
      646     when 1 then do:
      647       run waitfram-show in this-procedure
      648         (input vss-description
      649         ).
      650       run init-null-host-code .
      651       run waitfram-hide in this-procedure .
      652     end.
      653     when 2 then do:
      654       define variable lok as logical no-undo .
      655       assign
      656         lok = false
      657       .
      658       message
      659         vss-description
      660         "Проверка партий на всех объектах может занять много времени."
      661         "Продолжить?"
      662         view-as alert-box question buttons yes-no update lok .
      663       if lok <> true then do:
      664         return .
      665       end.
      666       run waitfram-show in this-procedure
      667             (input vss-description
      668         ).
      669       for each temp-obj
      670       :
      671         run waitfram-show in this-procedure
      672           (input vss-description + ' Объект '
      673           + temp-obj.obj-type + " " + string(temp-obj.obj-code)
      674           ).
      675         run init-parts-host-code
      676           (input temp-obj.obj-type
      677           ,input temp-obj.obj-code
      678           ).
      679       end.
      680       run waitfram-hide in this-procedure .
      681     end.
      682     when 3 then do:
      683       define variable rid-list as character no-undo .
      684       define variable ind      as integer   no-undo .
      685       define variable v-user-select as logical   no-undo .
      686   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      687   run userobjs_select-many in this-procedure
      688     (input  parparentproc
      689     ,input  v-cntxt-db-num
      690     ,input  v-cntxt-userid
      691     ,input  v-cntxt-host-code-obj
      692     ,input  v-cntxt-obj-type
      693     ,input  v-cntxt-obj-code
      694     ,output v-user-select
      695     )  .
      696       if v-user-select <> true
      697       then do:
      698         message
      699           "Объект не выбран"
      700           view-as alert-box information .
      701         return .
      702       end.
      703       run waitfram-show in this-procedure
      704         (input vss-description
      705         ).
      706       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      707       for each buf_userobjs_temp-user-obj
      708       on error undo, return error return-value
      709       :
      710         run waitfram-show in this-procedure
      711           (input vss-description + ' Объект '
      712           + buf_userobjs_temp-user-obj.obj-type + string(buf_userobjs_temp-user-obj.obj-code)
      713           ).
      714         run init-parts-host-code
      715           (input buf_userobjs_temp-user-obj.obj-type
      716           ,input buf_userobjs_temp-user-obj.obj-code
      717           ).
      718       end.
      719       run waitfram-hide in this-procedure .
      720     end.
      721   end.
      722   procedure init-null-host-code :
      723     for each ub.parts
      724       where ub.parts.host-code = 0
      725     :
      726   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      728     (input  ub.parts.obj-type
      729     ,input  ub.parts.obj-code
      730     ,output ub.parts.host-code
      731     ) no-error .
      732       if error-status :error then do:
      733         output to partshst.err append .
      734         export parts .
      735         output close .
      736         next .
      737       end.
      738       output to partshst.txt append .
      739       export parts .
      740       output close .
      741     end.
      742   end procedure.
      743   procedure init-parts-host-code :
      744     define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
      745     define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
      746     run waitfram-show in this-procedure
      747         (input vss-description + 'Партии на объекте. Объект '
      748       + temp-obj.obj-type + " " + string(temp-obj.obj-code)
      749       ).
      750     define variable v-host-code like ub.parts.host-code no-undo .
      751     for each ub.parts
      752       where ub.parts.out-code = 'free-zone':U
      753         and ub.parts.obj-type = p-obj-type
      754         and ub.parts.obj-code = p-obj-code
      755     :
      756   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      758     (input  ub.parts.obj-type
      759     ,input  ub.parts.obj-code
      760     ,output v-host-code
      761     ) no-error .
      762       if error-status :error then do:
      763         output to partshst.err append .
      764         export parts .
      765         output close .
      766         next .
      767       end.
      768       if parts.host-code <> v-host-code then do:
      769         output to partshst.txt append .
      770         export ub.parts .
      771         output close .
      772         assign
      773           ub.parts.host-code = v-host-code
      774         .
      775       end.
      776     end.
      777     for each ub.parts
      778       where ub.parts.out-code = 'out-zone':U
      779         and ub.parts.obj-type = p-obj-type
      780         and ub.parts.obj-code = p-obj-code
      781     :
      782   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      784     (input  ub.parts.obj-type
      785     ,input  ub.parts.obj-code
      786     ,output v-host-code
      787     ) no-error .
      788       if error-status :error then do:
      789         output to partshst.err append .
      790         export parts .
      791         output close .
      792         next .
      793       end.
      794       if parts.host-code <> v-host-code then do:
      795         output to partshst.txt append .
      796         export ub.parts .
      797         output close .
      798         assign
      799           ub.parts.host-code = v-host-code
      800         .
      801       end.
      802     end.
      803     run waitfram-hide in this-procedure .
      804   end procedure.
