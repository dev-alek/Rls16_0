        1   define input parameter parparentproc as handle no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision: $":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date: $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Утилита пересчета остатков МЦ для одного выбранного объекта".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   def buffer buf_clients for ub.clients.
      123   DEFINE BUTTON B-cli
      124        IMAGE-UP FILE "btn-down-arrow":U
      125        IMAGE-DOWN FILE "btn-down-arrow":U
      126        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      127        LABEL ""
      128        SIZE 3 BY 1.
      129   DEFINE BUTTON B-Help
      130        LABEL "&Help"
      131        SIZE 3 BY 1.13
      132        BGCOLOR 8 .
      133   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      134        LABEL "Отмена"
      135        SIZE 10 BY 1.13
      136        BGCOLOR 8 .
      137   DEFINE BUTTON Btn_OK AUTO-GO
      138        LABEL "Ввод"
      139        SIZE 10 BY 1.13
      140        BGCOLOR 8 .
      141   DEFINE VARIABLE v-obj-type AS CHARACTER FORMAT "X(3)"
      142        LABEL "Объект"
      143        VIEW-AS COMBO-BOX INNER-LINES 5
      144        LIST-ITEMS "Item 1"
      145        DROP-DOWN-LIST
      146        SIZE 6.38 BY 1.
      147   DEFINE VARIABLE for-object AS CHARACTER FORMAT "X(40)"
      148         VIEW-AS TEXT
      149        SIZE 19 BY 1
      150        FGCOLOR 4  NO-UNDO.
      151   DEFINE VARIABLE v-obj-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL 0
      152        VIEW-AS FILL-IN
      153        SIZE 10 BY 1.
      154   DEFINE FRAME Dialog-Frame
      155        B-Help AT ROW 1.25 COL 61.5
      156        v-obj-type AT ROW 2.5 COL 13.5 COLON-ALIGNED WIDGET-ID 8
      157        v-obj-code AT ROW 2.5 COL 20.5 COLON-ALIGNED NO-LABEL WIDGET-ID 6
      158        B-cli AT ROW 2.5 COL 33 WIDGET-ID 4
      159        Btn_OK AT ROW 4.25 COL 18
      160        Btn_Cancel AT ROW 4.25 COL 35.5
      161        for-object AT ROW 2.5 COL 34.5 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      162        SPACE(9.62) SKIP(2.37)
      163       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      164            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      165            TITLE "Утилита пересчета остатков МЦ"
      166            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      167   ASSIGN
      168          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      169          FRAME Dialog-Frame:HIDDEN           = TRUE.
      170   ON GO OF FRAME Dialog-Frame
      171   DO:
      172     assign frame Dialog-Frame v-obj-type
      173                              v-obj-code.
      174    FIND FIRST buf_clients NO-LOCK WHERE
      175             buf_clients.obj-type = v-obj-type AND
      176             buf_clients.obj-code = v-obj-code NO-ERROR.
      177   IF AVAIL buf_clients THEN DO:
      178     run utl/reclcwth.p (buf_clients.obj-type, buf_clients.obj-code) no-error.
      179       if error-status:error then do:
      180       message
      181       vss-workfile vss-revision vss-description skip
      182       "Ошибка при пересчете объекта" skip
      183       buf_clients.obj-type buf_clients.obj-code.
      184       end.
      185   END.
      186   ELSE DO:
      187       message
      188       vss-workfile vss-revision vss-description skip
      189       "Не найден объект для пересчета" skip.
      190   END.
      191   END.
      192   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      193   DO:
      194     APPLY "END-ERROR":U TO SELF.
      195   END.
      196   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
      197   DO:
      198   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   if lookup(self :type
      200            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      201            ) = 0
      202   then do:
      203     message
      204       "$Workfile$"
      205       "Указанному интерфейсному элементу фокус не может быть передан" skip
      206       "Интерфейсный элемент" self :name  skip
      207       "Тип" self :type  skip
      208       "Процедура" this-procedure :file-name skip
      209       view-as alert-box .
      210   end.
      211   else do:
      212     apply "entry":u to self  .
      213     if focus :handle <> self :handle  then do:
      214       return no-apply .
      215     end.
      216   end.
      217    define variable v_rid as character no-undo.
      218    define variable ref-rec as recid no-undo .
      219      FIND FIRST buf_clients NO-LOCK WHERE
      220               buf_clients.obj-type = INPUT FRAME Dialog-Frame v-obj-type AND
      221               buf_clients.obj-code = INPUT FRAME Dialog-Frame v-obj-code  NO-ERROR.
      222      IF available(buf_clients) then do:
      223       run ref/cli-all.w (
      224                    input parparentproc
      225                  ,input "b-sel":U
      226                  ,input v-obj-type
      227                  ,input 'все':U
      228                  ,input 'все':U
      229                  ,input RECID( buf_clients )
      230                  ,input ",,,,,,NO"
      231                  ,input ?
      232                  ,OUTPUT v_rid ).
      233     END.
      234     ELSE DO:
      235       run ref/cli-all.w (
      236                    input parparentproc
      237                   ,INPUT "b-sel":U
      238                  ,input  v-obj-type
      239                  ,input 'все':U
      240                  ,input 'текущие':U
      241                  ,input ?
      242                  ,input ",,,,,,NO"
      243                  ,input ?
      244                  ,OUTPUT v_rid ).
      245     END.
      246     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      247       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      248       IF ERROR-STATUS:ERROR THEN DO:
      249           RETURN NO-APPLY.
      250       END.
      251       FIND FIRST buf_clients NO-LOCK WHERE
      252                  RECID( buf_clients ) = ref-rec NO-ERROR.
      253       IF AVAIL buf_clients THEN DO:
      254       assign
      255       v-obj-type =  buf_clients.obj-type
      256       v-obj-code =  buf_clients.obj-code
      257       for-object =  buf_clients.obj-name
      258       .
      259         DISPLAY
      260         v-obj-type
      261         v-obj-code
      262         for-object
      263         WITH FRAME Dialog-Frame.
      264       END.
      265       ELSE DO:
      266         RETURN NO-APPLY.
      267       END.
      268     END.
      269     ELSE DO:
      270       RETURN NO-APPLY.
      271     END.
      272   END.
      273   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      274   OR HELP OF FRAME Dialog-Frame
      275   DO:
      276     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\reclcw1o.w" VIEW-AS ALERT-BOX INFORMATION.
      277   END.
      278   ON LEAVE OF v-obj-code IN FRAME Dialog-Frame
      279   DO:
      280     assign frame Dialog-Frame v-obj-type
      281                              v-obj-code.
      282    FIND FIRST buf_clients NO-LOCK WHERE
      283             buf_clients.obj-type = v-obj-type AND
      284             buf_clients.obj-code = v-obj-code NO-ERROR.
      285   IF AVAIL buf_clients THEN DO:
      286       DISPLAY
      287       buf_clients.obj-name @ for-object WITH FRAME Dialog-Frame.
      288   END.
      289   ELSE DO:
      290       DISPLAY
      291       "":U @ for-object WITH FRAME Dialog-Frame.
      292   END.
      293   END.
      294   ON VALUE-CHANGED OF v-obj-type IN FRAME Dialog-Frame
      295   DO:
      296   assign frame Dialog-Frame v-obj-type
      297                              v-obj-code.
      298    FIND FIRST buf_clients NO-LOCK WHERE
      299             buf_clients.obj-type = v-obj-type AND
      300             buf_clients.obj-code = v-obj-code NO-ERROR.
      301   IF AVAIL buf_clients THEN DO:
      302       DISPLAY
      303       buf_clients.obj-name @ for-object WITH FRAME Dialog-Frame.
      304   END.
      305   ELSE DO:
      306       DISPLAY
      307       "":U @ for-object WITH FRAME Dialog-Frame.
      308   END.
      309   END.
      310   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      311   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      312   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   on help of frame Dialog-Frame
      314   do:
      315     run gbl/app_help.p
      316       (input this-procedure :file-name
      317       ,input ''
      318       ,input ?
      319       ) no-error.
      320     if error-status :error then do:
      321       message
      322         "Ошибка при вызове помощи"
      323         error-status :get-message(1)
      324         view-as alert-box .
      325     end.
      326   end.
      327   run minbtn-set in this-procedure .
      328   on choose of b-help in frame Dialog-Frame
      329   do:
      330     apply "help":u to frame Dialog-Frame .
      331   end.
      332   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   procedure minbtn-set :
      334       do
      335           on error undo, return error return-value
      336           :
      337           define variable ii              as integer       no-undo .
      338           define variable fh              as widget-handle no-undo .
      339           define variable hh              as widget-handle no-undo .
      340           define variable v-h             as handle        extent 4 no-undo .
      341           define variable v-name-button   as character     no-undo .
      342           define variable v-help-old-x    as decimal       no-undo .
      343           define variable v-help-old-y    as decimal       no-undo .
      344           define variable v-help-old-size as decimal       no-undo .
      345           define variable v-frame-width   as decimal       no-undo .
      346           define variable jj              as integer       no-undo .
      347           do
      348               on error undo, return error
      349               :
      350               assign
      351                   v-frame-width = frame Dialog-Frame:width - 0.3
      352                   fh            = frame Dialog-Frame:first-child
      353                   hh            = fh:first-child
      354                   ii            = 1
      355                   .
      356               do while valid-handle(hh):
      357                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      358                   do:
      359                       case lc(hh:name) :
      360                           when "b-help" then
      361                               do:
      362                                   hh:load-image-up("cmp/b-help.bmp":u) .
      363                                   hh:load-image-down("cmp/b-help.bmp":u) .
      364                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      365                                   hh:TOOLTIP = "Помощь" .
      366                                   v-help-old-x = hh:column .
      367                                   v-help-old-y = hh:row    .
      368                                   v-help-old-size = hh:width .
      369                                   hh:width-chars = 2.5 .
      370                               end.
      371                           when "b-print" then
      372                               do:
      373                                   hh:load-image("cmp/b-print.bmp":u) .
      374                                   hh:TOOLTIP = "Печать" .
      375                                   v-h[ii] = hh:handle .
      376                                   ii = ii + 1 .
      377                                   hh:width-chars = 3 .
      378                               end.
      379                           when "b-history" or
      380                           when "b-hist" then
      381                               do:
      382                                   hh:load-image("cmp/b-hist.bmp":u) .
      383                                   hh:TOOLTIP = "История" .
      384                                   v-h[ii] = hh:handle .
      385                                   ii = ii + 1 .
      386                                   hh:width-chars = 3 .
      387                               end.
      388                           when "b-sch" then
      389                               do:
      390                                   hh:load-image("cmp/b-sch.bmp":u) .
      391                                   hh:TOOLTIP = "Установка Фильтра" .
      392                                   v-h[ii] = hh:handle .
      393                                   ii = ii + 1 .
      394                                   hh:width-chars = 3 .
      395                               end.
      396                           when "b-hist-user" then
      397                               do:
      398                                   hh:load-image("cmp/b-hist.bmp":u) .
      399                                   hh:TOOLTIP = "История пользователя" .
      400                                   ii = ii + 1 .
      401                               end.
      402                       end case.
      403                   end.
      404                   hh = hh:next-sibling.
      405               end.
      406               b-help:column = v-frame-width - b-help:width-chars.
      407               jj = 0.
      408               repeat ii = 4 to 1 by -1 :
      409                   if valid-handle (v-h[ii] ) then
      410                   do:
      411                       jj  = jj + 1 .
      412                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      413                       v-h[ii]:row    = v-help-old-y .
      414                   end.
      415               end.
      416           end.
      417       end.
      418   end procedure.
      419   MAIN-BLOCK:
      420   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      421      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      422          v-obj-type:list-items =     'маг':U + chr(44) +
      423                                       'скл':U + chr(44).
      424     RUN enable_UI.
      425     WAIT-FOR GO OF FRAME Dialog-Frame.
      426   END.
      427   RUN disable_UI.
      428   PROCEDURE disable_UI :
      429     HIDE FRAME Dialog-Frame.
      430   END PROCEDURE.
      431   PROCEDURE enable_UI :
      432     DISPLAY v-obj-type v-obj-code for-object
      433         WITH FRAME Dialog-Frame.
      434     ENABLE B-Help v-obj-type v-obj-code B-cli Btn_OK Btn_Cancel for-object
      435         WITH FRAME Dialog-Frame.
      436     VIEW FRAME Dialog-Frame.
      437   END PROCEDURE.
