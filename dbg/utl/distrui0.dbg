      442        tt-dis-time-rule.sts AT ROW 10 COL 1 NO-LABEL WIDGET-ID 42
      443             VIEW-AS RADIO-SET VERTICAL
      444             RADIO-BUTTONS
      445                       "Item 1", 0,
      446   "Item 2", 1
      447             SIZE 15.5 BY 1.87
      448        b-add AT ROW 12.27 COL 1 WIDGET-ID 36
      449        b-del AT ROW 12.27 COL 11 WIDGET-ID 38
      450        b-chg AT ROW 12.27 COL 21 WIDGET-ID 40
      451        br-drt-prop AT ROW 13.27 COL 1 WIDGET-ID 100
      452        "Статус" VIEW-AS TEXT
      453             SIZE 9 BY .8 AT ROW 9 COL 1 WIDGET-ID 46
      454        SPACE(89.13) SKIP(13.45)
      455       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      456            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      457            TITLE "Название  секции"
      458            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      459   ASSIGN
      460          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      461          FRAME Dialog-Frame:HIDDEN           = TRUE.
      462   ON GO OF FRAME Dialog-Frame
      463   DO:
      464     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      465     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      466   END.
      467   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      468   DO:
      469     APPLY "END-ERROR":U TO SELF.
      470   END.
      471   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      472   DO:
      473     define variable v-node-code as integer   no-undo .
      474     RUN proc-b-add IN THIS-PROCEDURE ( output v-node-code) NO-ERROR.
      475     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      476     if not available tt-drt-prop or v-node-code = ? then return no-apply.
      477     run proc-b-chg in this-procedure no-error .
      478     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      479   END.
      480   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      481   DO:
      482     IF NOT AVAILABLE tt-drt-prop THEN RETURN NO-APPLY.
      483     RUN proc-b-chg IN THIS-PROCEDURE NO-ERROR.
      484   END.
      485   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      486   DO:
      487     IF NOT AVAILABLE tt-drt-prop THEN RETURN NO-APPLY.
      488     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
      489     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      490   END.
      491   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      492   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      493   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   on help of frame Dialog-Frame
      495   do:
      496     run gbl/app_help.p
      497       (input this-procedure :file-name
      498       ,input ''
      499       ,input ?
      500       ) no-error.
      501     if error-status :error then do:
      502       message
      503         "Ошибка при вызове помощи"
      504         error-status :get-message(1)
      505         view-as alert-box .
      506     end.
      507   end.
      508   run minbtn-set in this-procedure .
      509   on choose of b-help in frame Dialog-Frame
      510   do:
      511     apply "help":u to frame Dialog-Frame .
      512   end.
      513   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   procedure minbtn-set :
      515       do
      516           on error undo, return error return-value
      517           :
      518           define variable ii              as integer       no-undo .
      519           define variable fh              as widget-handle no-undo .
      520           define variable hh              as widget-handle no-undo .
      521           define variable v-h             as handle        extent 4 no-undo .
      522           define variable v-name-button   as character     no-undo .
      523           define variable v-help-old-x    as decimal       no-undo .
      524           define variable v-help-old-y    as decimal       no-undo .
      525           define variable v-help-old-size as decimal       no-undo .
      526           define variable v-frame-width   as decimal       no-undo .
      527           define variable jj              as integer       no-undo .
      528           do
      529               on error undo, return error
      530               :
      531               assign
      532                   v-frame-width = frame Dialog-Frame:width - 0.3
      533                   fh            = frame Dialog-Frame:first-child
      534                   hh            = fh:first-child
      535                   ii            = 1
      536                   .
      537               do while valid-handle(hh):
      538                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      539                   do:
      540                       case lc(hh:name) :
      541                           when "b-help" then
      542                               do:
      543                                   hh:load-image-up("cmp/b-help.bmp":u) .
      544                                   hh:load-image-down("cmp/b-help.bmp":u) .
      545                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      546                                   hh:TOOLTIP = "Помощь" .
      547                                   v-help-old-x = hh:column .
      548                                   v-help-old-y = hh:row    .
      549                                   v-help-old-size = hh:width .
      550                                   hh:width-chars = 2.5 .
      551                               end.
      552                           when "b-print" then
      553                               do:
      554                                   hh:load-image("cmp/b-print.bmp":u) .
      555                                   hh:TOOLTIP = "Печать" .
      556                                   v-h[ii] = hh:handle .
      557                                   ii = ii + 1 .
      558                                   hh:width-chars = 3 .
      559                               end.
      560                           when "b-history" or
      561                           when "b-hist" then
      562                               do:
      563                                   hh:load-image("cmp/b-hist.bmp":u) .
      564                                   hh:TOOLTIP = "История" .
      565                                   v-h[ii] = hh:handle .
      566                                   ii = ii + 1 .
      567                                   hh:width-chars = 3 .
      568                               end.
      569                           when "b-sch" then
      570                               do:
      571                                   hh:load-image("cmp/b-sch.bmp":u) .
      572                                   hh:TOOLTIP = "Установка Фильтра" .
      573                                   v-h[ii] = hh:handle .
      574                                   ii = ii + 1 .
      575                                   hh:width-chars = 3 .
      576                               end.
      577                           when "b-hist-user" then
      578                               do:
      579                                   hh:load-image("cmp/b-hist.bmp":u) .
      580                                   hh:TOOLTIP = "История пользователя" .
      581                                   ii = ii + 1 .
      582                               end.
      583                       end case.
      584                   end.
      585                   hh = hh:next-sibling.
      586               end.
      587               b-help:column = v-frame-width - b-help:width-chars.
      588               jj = 0.
      589               repeat ii = 4 to 1 by -1 :
      590                   if valid-handle (v-h[ii] ) then
      591                   do:
      592                       jj  = jj + 1 .
      593                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      594                       v-h[ii]:row    = v-help-old-y .
      595                   end.
      596               end.
      597           end.
      598       end.
      599   end procedure.
      600   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      601   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      602   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      603   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      604   define variable v-diasize-current-frame-width  as decimal   no-undo .
      605   define variable v-diasize-current-frame-height as decimal   no-undo .
      606   define variable v-diasize-change-size          as logical   no-undo .
      607   define variable v-diasize-resize-button        as handle    no-undo .
      608   define variable v-diasize-wndmax               as logical   no-undo .
      609   define variable v-diasize-wndstore             as logical   no-undo .
      610   define variable v-diasize-proc-name            as character no-undo .
      611   define variable v-diasize-browse-handle        as handle    no-undo .
      612   define variable v-diasize-browse-number        as integer   no-undo .
      613   define variable v-diasize-need-full-display    as logical   no-undo init false .
      614   define temp-table temp-diasize-handle no-undo
      615     field handle-value  as handle
      616     field save-position as decimal
      617     index xpk is primary unique handle-value
      618     .
      619   define temp-table temp-browse-handle no-undo
      620     field browse-type   as character
      621     field browse-number as integer
      622     field browse-handle as handle
      623     field original-size as decimal
      624     index xpk is primary unique browse-type browse-number
      625     index xie browse-type browse-handle
      626   .
      627   procedure diasize_change-height :
      628     define input  parameter p-change-value  as decimal   no-undo .
      629     define input  parameter p-move-resize   as logical   no-undo .
      630     define variable v-field-group-handle    as handle    no-undo .
      631     define variable v-object-handle         as handle    no-undo .
      632     define variable v-frame-height          as decimal   no-undo .
      633     define variable v-frame-virtual-height  as decimal   no-undo .
      634     define variable v-browse-height         as decimal   no-undo .
      635     define variable v-window-height         as decimal   no-undo .
      636     define variable v-window-virtual-height as decimal   no-undo .
      637     define variable v-change-sign           as integer   no-undo .
      638     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      639     define buffer buf_temp-browse-handle  for temp-browse-handle .
      640     if p-change-value > 0
      641     then do:
      642       if frame Dialog-Frame :height + p-change-value
      643           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      644       then do:
      645         assign
      646           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      647                           - (frame Dialog-Frame :height-chars)
      648         .
      649         if p-change-value <= 0
      650         then do:
      651           run diasize_position-resize-button in this-procedure .
      652           return .
      653         end.
      654       end.
      655     end.
      656     if p-change-value < 0
      657     then do:
      658       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      659       then do:
      660         assign
      661           p-change-value = v-diasize-orig-frame-height
      662                          - (frame Dialog-Frame :height-chars)
      663         .
      664         if p-change-value >= 0
      665         then do:
      666           run diasize_position-resize-button in this-procedure .
      667           return .
      668         end.
      669       end.
      670     end.
      671     if p-change-value >= 0
      672     then do:
      673       assign
      674         v-change-sign = 1
      675       .
      676     end.
      677     else do:
      678       assign
      679         v-change-sign = -1
      680       .
      681     end.
      682     assign
      683       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      684     .
      685     if p-change-value = 0
      686     then do:
      687       run diasize_position-resize-button in this-procedure .
      688       return .
      689     end.
      690     move_block:
      691     do
      692     on error undo move_block, retry move_block
      693     :
      694       if retry
      695       then do:
      696         do
      697         on error undo move_block, leave move_block
      698         :
      699           if p-change-value > 0
      700           then do:
      701             for each buf_temp-diasize-handle
      702             on error undo, next
      703             :
      704               assign
      705                 v-object-handle = buf_temp-diasize-handle.handle-value
      706               .
      707               if v-object-handle <> v-diasize-resize-button
      708               then do:
      709                 assign
      710                   v-object-handle :row = buf_temp-diasize-handle.save-position
      711                 .
      712               end.
      713             end.
      714             assign
      715               v-diasize-browse-handle :height = v-browse-height
      716             .
      717             for each buf_temp-browse-handle
      718               where buf_temp-browse-handle.browse-type = 'height':u
      719             on error undo, next
      720             :
      721               assign
      722                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      723               .
      724             end.
      725             assign
      726               frame Dialog-Frame :height = v-frame-height
      727             .
      728             if frame Dialog-Frame :scrollable = true
      729             then do:
      730               assign
      731                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      732               .
      733             end.
      734             run diasize_position-resize-button in this-procedure .
      735           end.
      736           else do:
      737             if frame Dialog-Frame :scrollable = true
      738             then do:
      739               assign
      740                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      741               .
      742             end.
      743             assign
      744               frame Dialog-Frame :height = v-frame-height
      745             .
      746             assign
      747               v-diasize-browse-handle :height = v-browse-height
      748             .
      749             for each buf_temp-browse-handle
      750               where buf_temp-browse-handle.browse-type = 'height':u
      751             on error undo, next
      752             :
      753               assign
      754                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      755               .
      756             end.
      757             for each buf_temp-diasize-handle
      758             on error undo, next
      759             :
      760               assign
      761                 v-object-handle = buf_temp-diasize-handle.handle-value
      762               .
      763               if v-object-handle <> v-diasize-resize-button
      764               then do:
      765                 assign
      766                   v-object-handle :row = buf_temp-diasize-handle.save-position
      767                 .
      768               end.
      769             end.
      770             run diasize_position-resize-button in this-procedure .
      771           end.
      772           assign
      773             v-diasize-change-size = false
      774           .
      775           leave move_block .
      776         end.
      777       end.
      778       assign
      779         v-diasize-need-full-display = true
      780       .
      781       if v-diasize-change-size = false
      782       then do:
      783         assign
      784           v-diasize-change-size = true
      785         .
      786       end.
      787       else do:
      788         return .
      789       end.
      790       assign
      791         v-frame-height = frame Dialog-Frame :height
      792         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      793         v-browse-height = v-diasize-browse-handle :height
      794       .
      795       for each buf_temp-browse-handle
      796         where buf_temp-browse-handle.browse-type = 'height':u
      797       :
      798         assign
      799           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      800         .
      801       end.
      802       for each buf_temp-diasize-handle
      803       :
      804         delete buf_temp-diasize-handle .
      805       end.
      806       assign
      807         v-field-group-handle = frame Dialog-Frame :first-child
      808       .
      809       do while valid-handle(v-field-group-handle)
      810       :
      811         assign
      812           v-object-handle = v-field-group-handle :first-child
      813         .
      814         do while valid-handle(v-object-handle)
      815         :
      816           if  v-object-handle <> v-diasize-browse-handle :handle
      817           and can-query(v-object-handle, "row")
      818           and can-query(v-object-handle, "height")
      819           and ( v-object-handle :row > v-diasize-browse-handle :row )
      820           then do:
      821             find first buf_temp-browse-handle
      822               where buf_temp-browse-handle.browse-type   = 'height':u
      823                 and buf_temp-browse-handle.browse-handle = v-object-handle
      824               no-error .
      825             if available buf_temp-browse-handle
      826             then do:
      827             end.
      828             else do:
      829               create buf_temp-diasize-handle .
      830               assign
      831                 buf_temp-diasize-handle.handle-value  = v-object-handle
      832                 buf_temp-diasize-handle.save-position = v-object-handle :row
      833               .
      834             end.
      835           end.
      836           assign
      837             v-object-handle = v-object-handle :next-sibling
      838           .
      839         end.
      840         assign
      841           v-field-group-handle = v-field-group-handle :next-sibling
      842         .
      843       end.
      844       do with frame Dialog-Frame
      845       :
      846         hide v-diasize-resize-button .
      847         assign
      848           v-diasize-resize-button :row    = 1
      849           v-diasize-resize-button :column = 1
      850         .
      851       end.
      852       if p-change-value > 0
      853       then do:
      854         if frame Dialog-Frame :scrollable = true
      855         then do:
      856           assign
      857             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      858             no-error .
      859           if error-status :error
      860           or error-status :get-message(1) <> ""
      861           then do:
      862             undo move_block, retry move_block .
      863           end.
      864         end.
      865         assign
      866           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      867           no-error .
      868         if error-status :error
      869         or error-status :get-message(1) <> ""
      870         then do:
      871           undo move_block, retry move_block .
      872         end.
      873         assign
      874           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      875           no-error .
      876         if error-status :error
      877         or error-status :get-message(1) <> ""
      878         then do:
      879           undo move_block, retry move_block .
      880         end.
      881         for each buf_temp-browse-handle
      882           where buf_temp-browse-handle.browse-type = 'height':u
      883         on error undo move_block, retry move_block
      884         :
      885           assign
      886             buf_temp-browse-handle.browse-handle :height
      887               = buf_temp-browse-handle.browse-handle :height + p-change-value
      888             no-error .
      889           if error-status :error
      890           or error-status :get-message(1) <> ""
      891           then do:
      892             undo move_block, retry move_block .
      893           end.
      894         end.
      895         for each buf_temp-diasize-handle
      896         on error undo move_block, retry move_block
      897         :
      898           assign
      899             v-object-handle = buf_temp-diasize-handle.handle-value
      900           .
      901           if v-object-handle <> v-diasize-resize-button
      902           then do:
      903             assign
      904               v-object-handle :row = v-object-handle :row + p-change-value
      905               no-error .
      906             if error-status :error
      907             or error-status :get-message(1) <> ""
      908             then do:
      909               undo move_block, retry move_block .
      910             end.
      911           end.
      912         end.
      913       end.
      914       else do:
      915         for each buf_temp-diasize-handle
      916         on error undo move_block, retry move_block
      917         :
      918           assign
      919             v-object-handle = buf_temp-diasize-handle.handle-value
      920           .
      921           if v-object-handle <> v-diasize-resize-button
      922           then do:
      923             assign
      924               v-object-handle :row = v-object-handle :row + p-change-value
      925               no-error .
      926             if error-status :error
      927             or error-status :get-message(1) <> ""
      928             then do:
      929               undo move_block, retry move_block .
      930             end.
      931           end.
      932         end.
      933         assign
      934           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      935           no-error .
      936         if error-status :error
      937         or error-status :get-message(1) <> ""
      938         then do:
      939           undo move_block, retry move_block .
      940         end.
      941         for each buf_temp-browse-handle
      942           where buf_temp-browse-handle.browse-type = 'height':u
      943         on error undo move_block, retry move_block
      944         :
      945           assign
      946             buf_temp-browse-handle.browse-handle :height
      947               = buf_temp-browse-handle.browse-handle :height + p-change-value
      948             no-error .
      949           if error-status :error
      950           or error-status :get-message(1) <> ""
      951           then do:
      952             undo move_block, retry move_block .
      953           end.
      954         end.
      955         assign
      956           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      957           no-error .
      958         if error-status :error
      959         or error-status :get-message(1) <> ""
      960         then do:
      961           undo move_block, retry move_block .
      962         end.
      963         if frame Dialog-Frame :scrollable = true
      964         then do:
      965           assign
      966             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      967             no-error .
      968           if error-status :error
      969           or error-status :get-message(1) <> ""
      970           then do:
      971             undo move_block, retry move_block .
      972           end.
      973         end.
      974       end.
      975       if p-move-resize = true
      976       then do:
      977         run diasize_position-resize-button in this-procedure .
      978       end.
      979       if v-diasize-wndstore = true
      980       then do:
      981         if connected("ub") = true
      982         then do:
      983           define variable v-cntxt-db-num        as integer   no-undo .
      984           define variable v-cntxt-userid        as character no-undo .
      985           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      986                                             , OUTPUT v-cntxt-userid
      987                                             ) .
      988           run gbl/wndsizew.p
      989             (input  v-cntxt-db-num
      990             ,input  v-cntxt-userid
      991             ,input  v-diasize-proc-name
      992             ,input  'height':u
      993             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      994             ) .
      995         end.
      996       end.
      997     end.
      998     assign
      999       v-diasize-change-size = false
     1000     .
     1001   end procedure.
     1002   procedure diasize_set-height :
     1003     define input  parameter p-new-height  as decimal   no-undo .
     1004     define input  parameter p-move-resize as logical   no-undo .
     1005     do
     1006     on error undo, return error return-value
     1007     :
     1008       run diasize_change-height in this-procedure
     1009         (input  (p-new-height - frame Dialog-Frame :height)
     1010         ,input  p-move-resize
     1011         ) .
     1012     end.
     1013   end procedure.
     1014   procedure diasize_change-width :
     1015     define input  parameter p-change-value as decimal   no-undo .
     1016     define input  parameter p-move-resize  as logical   no-undo .
     1017     define variable v-field-group-handle   as handle    no-undo .
     1018     define variable v-object-handle        as handle    no-undo .
     1019     define variable v-frame-width          as decimal   no-undo .
     1020     define variable v-frame-virtual-width  as decimal   no-undo .
     1021     define variable v-browse-width         as decimal   no-undo .
     1022     define variable v-window-width         as decimal   no-undo .
     1023     define variable v-window-virtual-width as decimal   no-undo .
     1024     define variable v-change-sign          as integer   no-undo .
     1025     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1026     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1027     if p-change-value > 0
     1028     then do:
     1029       if frame Dialog-Frame :width + p-change-value >
     1030           session :width-chars
     1031       then do:
     1032         assign
     1033           p-change-value = session :width-chars - frame Dialog-Frame :width
     1034         .
     1035         if p-change-value <= 0
     1036         then do:
     1037           run diasize_position-resize-button in this-procedure .
     1038           return .
     1039         end.
     1040       end.
     1041     end.
     1042     if p-change-value < 0
     1043     then do:
     1044       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1045       then do:
     1046         assign
     1047           p-change-value = v-diasize-orig-frame-width
     1048                          - frame Dialog-Frame :width
     1049         .
     1050         if p-change-value >= 0
     1051         then do:
     1052           run diasize_position-resize-button in this-procedure .
     1053           return .
     1054         end.
     1055       end.
     1056     end.
     1057     if p-change-value >= 0
     1058     then do:
     1059       assign
     1060         v-change-sign = 1
     1061       .
     1062     end.
     1063     else do:
     1064       assign
     1065         v-change-sign = -1
     1066       .
     1067     end.
     1068     assign
     1069       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1070     .
     1071     if p-change-value = 0
     1072     then do:
     1073       run diasize_position-resize-button in this-procedure .
     1074       return .
     1075     end.
     1076     move_block:
     1077     do
     1078     on error undo move_block, leave move_block
     1079     :
     1080       if retry
     1081       then do:
     1082         do
     1083         on error undo move_block, leave move_block
     1084         :
     1085           if p-change-value > 0
     1086           then do:
     1087             for each buf_temp-diasize-handle
     1088             on error undo, next
     1089             :
     1090               assign
     1091                 v-object-handle = buf_temp-diasize-handle.handle-value
     1092               .
     1093               if v-object-handle <> v-diasize-resize-button
     1094               then do:
     1095                 assign
     1096                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1097                 .
     1098               end.
     1099             end.
     1100             assign
     1101               v-diasize-browse-handle :width = v-browse-width
     1102             .
     1103             for each buf_temp-browse-handle
     1104               where buf_temp-browse-handle.browse-type = 'width':u
     1105             on error undo, next
     1106             :
     1107               assign
     1108                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1109               .
     1110             end.
     1111             assign
     1112               frame Dialog-Frame :width = v-frame-width
     1113             .
     1114             if frame Dialog-Frame :scrollable = true
     1115             then do:
     1116               assign
     1117                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1118               .
     1119             end.
     1120             run diasize_position-resize-button in this-procedure .
     1121           end.
     1122           else do:
     1123             if frame Dialog-Frame :scrollable = true
     1124             then do:
     1125               assign
     1126                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1127               .
     1128             end.
     1129             assign
     1130               frame Dialog-Frame :width = v-frame-width
     1131             .
     1132             for each buf_temp-browse-handle
     1133               where buf_temp-browse-handle.browse-type = 'width':u
     1134             on error undo, next
     1135             :
     1136               assign
     1137                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1138               .
     1139             end.
     1140             assign
     1141               v-diasize-browse-handle :width = v-browse-width
     1142             .
     1143             for each buf_temp-diasize-handle
     1144             on error undo, next
     1145             :
     1146               assign
     1147                 v-object-handle = buf_temp-diasize-handle.handle-value
     1148               .
     1149               if v-object-handle <> v-diasize-resize-button
     1150               then do:
     1151                 assign
     1152                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1153                 .
     1154               end.
     1155             end.
     1156             run diasize_position-resize-button in this-procedure .
     1157           end.
     1158           assign
     1159             v-diasize-change-size = false
     1160           .
     1161           leave move_block .
     1162         end.
     1163       end.
     1164       assign
     1165         v-diasize-need-full-display = true
     1166       .
     1167       if v-diasize-change-size = false
     1168       then do:
     1169         assign
     1170           v-diasize-change-size = true
     1171         .
     1172       end.
     1173       else do:
     1174         return .
     1175       end.
     1176       assign
     1177         v-frame-width = frame Dialog-Frame :width
     1178         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1179         v-browse-width = v-diasize-browse-handle :width
     1180       .
     1181       for each buf_temp-browse-handle
     1182         where buf_temp-browse-handle.browse-type = 'width':u
     1183       :
     1184         assign
     1185           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1186         .
     1187       end.
     1188       for each buf_temp-diasize-handle
     1189       :
     1190         delete buf_temp-diasize-handle .
     1191       end.
     1192       assign
     1193         v-field-group-handle = frame Dialog-Frame :first-child
     1194       .
     1195       do while valid-handle(v-field-group-handle)
     1196       :
     1197         assign
     1198           v-object-handle = v-field-group-handle :first-child
     1199         .
     1200         do while valid-handle(v-object-handle)
     1201         :
     1202           if  v-object-handle <> v-diasize-browse-handle :handle
     1203           and v-object-handle <> v-diasize-resize-button
     1204           and can-query(v-object-handle, "row")
     1205           and can-query(v-object-handle, "height")
     1206           and ( v-object-handle :col + v-object-handle :width
     1207                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1208               )
     1209           then do:
     1210             find first buf_temp-browse-handle
     1211               where buf_temp-browse-handle.browse-type   = 'width':u
     1212                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1213               no-error .
     1214             if available buf_temp-browse-handle
     1215             then do:
     1216             end.
     1217             else do:
     1218               create buf_temp-diasize-handle .
     1219               assign
     1220                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1221                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1222               .
     1223             end.
     1224           end.
     1225           assign
     1226             v-object-handle = v-object-handle :next-sibling
     1227           .
     1228         end.
     1229         assign
     1230           v-field-group-handle = v-field-group-handle :next-sibling
     1231         .
     1232       end.
     1233       do with frame Dialog-Frame
     1234       :
     1235         hide v-diasize-resize-button .
     1236         v-diasize-resize-button :row = 1.
     1237         v-diasize-resize-button :column = 1.
     1238       end.
     1239       if p-change-value > 0
     1240       then do:
     1241         if frame Dialog-Frame :scrollable = true
     1242         then do:
     1243           assign
     1244             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1245             no-error .
     1246           if error-status :error
     1247           or error-status :get-message(1) <> ""
     1248           then do:
     1249             undo move_block, retry move_block.
     1250           end.
     1251         end.
     1252         assign
     1253           frame Dialog-Frame :width = v-frame-width + p-change-value
     1254           no-error .
     1255         if error-status :error
     1256         or error-status :get-message(1) <> ""
     1257         then do:
     1258           undo move_block, retry move_block.
     1259         end.
     1260         assign
     1261           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1262         no-error .
     1263         if error-status :error
     1264         or error-status :get-message(1) <> ""
     1265         then do:
     1266           undo move_block, retry move_block.
     1267         end.
     1268         for each buf_temp-browse-handle
     1269           where buf_temp-browse-handle.browse-type = 'width':u
     1270         on error undo move_block, retry move_block
     1271         :
     1272           assign
     1273             buf_temp-browse-handle.browse-handle :width
     1274               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1275             no-error .
     1276           if error-status :error
     1277           or error-status :get-message(1) <> ""
     1278           then do:
     1279             undo move_block, retry move_block .
     1280           end.
     1281         end.
     1282         for each buf_temp-diasize-handle
     1283         on error undo move_block, retry move_block
     1284         :
     1285           assign
     1286             v-object-handle = buf_temp-diasize-handle.handle-value
     1287           .
     1288           if v-object-handle <> v-diasize-resize-button
     1289           then do:
     1290             assign
     1291               v-object-handle :col = v-object-handle :col + p-change-value
     1292               no-error .
     1293             if error-status :error
     1294             or error-status :get-message(1) <> ""
     1295             then do:
     1296               undo move_block, retry move_block .
     1297             end.
     1298           end.
     1299         end.
     1300       end.
     1301       else do:
     1302         for each buf_temp-diasize-handle
     1303         on error undo move_block, retry move_block
     1304         :
     1305           assign
     1306             v-object-handle = buf_temp-diasize-handle.handle-value
     1307           .
     1308           if v-object-handle <> v-diasize-resize-button
     1309           then do:
     1310             assign
     1311               v-object-handle :col = v-object-handle :col + p-change-value
     1312               no-error .
     1313             if error-status :error
     1314             or error-status :get-message(1) <> ""
     1315             then do:
     1316               undo move_block, retry move_block .
     1317             end.
     1318           end.
     1319         end.
     1320         for each buf_temp-browse-handle
     1321           where buf_temp-browse-handle.browse-type = 'width':u
     1322         on error undo move_block, retry move_block
     1323         :
     1324           assign
     1325             buf_temp-browse-handle.browse-handle :width
     1326               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1327             no-error .
     1328           if error-status :error
     1329           or error-status :get-message(1) <> ""
     1330           then do:
     1331             undo move_block, retry move_block .
     1332           end.
     1333         end.
     1334         assign
     1335           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1336           no-error .
     1337         if error-status :error
     1338         or error-status :get-message(1) <> ""
     1339         then do:
     1340           undo move_block, retry move_block.
     1341         end.
     1342         assign
     1343           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1344         no-error .
     1345         if error-status :error
     1346         or error-status :get-message(1) <> ""
     1347         then do:
     1348           undo move_block, retry move_block.
     1349         end.
     1350         if frame Dialog-Frame :scrollable = true
     1351         then do:
     1352           assign
     1353             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1354           no-error .
     1355           if error-status :error
     1356           or error-status :get-message(1) <> ""
     1357           then do:
     1358             undo move_block, retry move_block.
     1359           end.
     1360         end.
     1361       end.
     1362       if p-move-resize
     1363       then do:
     1364         run diasize_position-resize-button in this-procedure .
     1365       end.
     1366       if v-diasize-wndstore = true
     1367       then do:
     1368         if connected("ub") = true
     1369         then do:
     1370           define variable v-cntxt-db-num        as integer   no-undo .
     1371           define variable v-cntxt-userid        as character no-undo .
     1372           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1373                                             , OUTPUT v-cntxt-userid
     1374                                             ) .
     1375           run gbl/wndsizew.p
     1376             (input  v-cntxt-db-num
     1377             ,input  v-cntxt-userid
     1378             ,input  v-diasize-proc-name
     1379             ,input  'width':u
     1380             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1381             ) .
     1382         end.
     1383       end.
     1384     end.
     1385     assign
     1386       v-diasize-change-size = false
     1387     .
     1388   end procedure.
     1389   procedure diasize_set-width :
     1390     define input  parameter p-new-width  as decimal   no-undo .
     1391     define input  parameter p-move-resize as logical   no-undo .
     1392     do
     1393     on error undo, return error return-value
     1394     :
     1395       run diasize_change-width in this-procedure
     1396         (input  (p-new-width - frame Dialog-Frame :width)
     1397         ,input  p-move-resize
     1398         ) .
     1399     end.
     1400   end procedure.
     1401   procedure diasize_position-resize-button :
     1402     do with frame Dialog-Frame
     1403     :
     1404       hide v-diasize-resize-button .
     1405       assign
     1406         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1407                     - 1
     1408                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1409         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1410                     - 1
     1411                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1412       .
     1413       view v-diasize-resize-button .
     1414     end.
     1415   end procedure.
     1416   on alt-right anywhere
     1417   do:
     1418     run diasize_change-width in this-procedure
     1419       (input 1
     1420       ,input true
     1421       ) .
     1422     return no-apply .
     1423   end.
     1424   on alt-left anywhere
     1425   do:
     1426     run diasize_change-width in this-procedure
     1427       (input -1
     1428       ,input true
     1429       ) .
     1430     return no-apply .
     1431   end.
     1432   on alt-down anywhere
     1433   do:
     1434     run diasize_change-height in this-procedure
     1435       (input 1
     1436       ,input true
     1437       ) .
     1438     return no-apply .
     1439   end.
     1440   on alt-up anywhere
     1441   do:
     1442     run diasize_change-height in this-procedure
     1443       (input -1
     1444       ,input true
     1445       ) .
     1446     return no-apply .
     1447   end.
     1448   on alt-enter of frame Dialog-Frame
     1449   do:
     1450     run diasize_maximize in this-procedure
     1451       (input  ?
     1452       ).
     1453     return no-apply .
     1454   end.
     1455   procedure diasize_end-move :
     1456     do
     1457     on error undo, return error return-value
     1458     :
     1459       define variable v-row-delta as decimal   no-undo .
     1460       define variable v-col-delta as decimal   no-undo .
     1461       define variable v-new-row as decimal   no-undo .
     1462       define variable v-new-col as decimal   no-undo .
     1463       assign
     1464         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1465         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1466       .
     1467       assign
     1468         v-row-delta = v-new-row - frame Dialog-Frame :height
     1469         v-col-delta = v-new-col - frame Dialog-Frame :width
     1470       .
     1471       run diasize_change-height in this-procedure
     1472         (input v-row-delta
     1473         ,input true
     1474         ) .
     1475       run diasize_change-width in this-procedure
     1476         (input v-col-delta
     1477         ,input true
     1478         ) .
     1479     end.
     1480   end procedure.
     1481   procedure diasize_maximize :
     1482     define input  parameter p-action as logical   no-undo .
     1483     do
     1484     on error undo, return error return-value
     1485     :
     1486       if p-action = ?
     1487       then do:
     1488         if v-diasize-need-maximize = true
     1489         then do:
     1490           assign
     1491             p-action = true
     1492           .
     1493         end.
     1494         else do:
     1495           assign
     1496             p-action = false
     1497           .
     1498         end.
     1499       end.
     1500       if p-action = true
     1501       then do:
     1502         run diasize_change-height in this-procedure
     1503           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1504               - frame Dialog-Frame :height-chars
     1505           ,input true
     1506           ) .
     1507         run diasize_change-width in this-procedure
     1508           (input session :width-chars
     1509               - frame Dialog-Frame :width-chars
     1510           ,input true
     1511           ) .
     1512         assign
     1513           v-diasize-need-maximize = false
     1514         .
     1515       end.
     1516       else do:
     1517         run diasize_change-width in this-procedure
     1518           (input v-diasize-orig-frame-width
     1519               - frame Dialog-Frame :width-chars
     1520           ,input true
     1521           ) .
     1522         run diasize_change-height in this-procedure
     1523           (input v-diasize-orig-frame-height
     1524               - frame Dialog-Frame :height-chars
     1525           ,input true
     1526           ) .
     1527         assign
     1528           v-diasize-need-maximize = true
     1529         .
     1530       end.
     1531     end.
     1532   end procedure.
     1533   procedure diasize_restore-orig-size :
     1534     do
     1535     on error undo, return error return-value
     1536     :
     1537       assign
     1538         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1539         v-diasize-current-frame-height = frame Dialog-Frame :height
     1540       .
     1541       run diasize_set-height in this-procedure
     1542         (input  v-diasize-orig-frame-height
     1543         ,input  true
     1544         ) .
     1545       run diasize_set-width in this-procedure
     1546         (input  v-diasize-orig-frame-width
     1547         ,input  true
     1548         ) .
     1549     end.
     1550   end procedure.
     1551   procedure diasize_restore-current-size :
     1552     do
     1553     on error undo, return error return-value
     1554     :
     1555       run diasize_set-height in this-procedure
     1556         (input  v-diasize-current-frame-height
     1557         ,input  true
     1558         ) .
     1559       run diasize_set-width in this-procedure
     1560         (input  v-diasize-current-frame-width
     1561         ,input  true
     1562         ) .
     1563     end.
     1564   end procedure.
     1565   procedure diasize_set-browse-handle :
     1566     define input  parameter p-browse-handle as handle   no-undo .
     1567     define buffer buf_temp-browse-handle for temp-browse-handle .
     1568     do
     1569     on error undo, return error return-value
     1570     :
     1571       assign
     1572         v-diasize-browse-handle = p-browse-handle
     1573       .
     1574       for each buf_temp-browse-handle
     1575       on error undo, return error return-value
     1576       :
     1577         delete buf_temp-browse-handle .
     1578       end.
     1579     end.
     1580   end procedure.
     1581   procedure diasize_add_browse :
     1582     define input  parameter p-browse-type   as character no-undo .
     1583     define input  parameter p-browse-handle as handle    no-undo .
     1584     define buffer buf_temp-browse-handle for temp-browse-handle .
     1585     do
     1586     on error undo, return error return-value
     1587     :
     1588       assign
     1589         v-diasize-browse-number = v-diasize-browse-number + 1
     1590       .
     1591       create buf_temp-browse-handle .
     1592       assign
     1593         buf_temp-browse-handle.browse-type   = p-browse-type
     1594         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1595         buf_temp-browse-handle.browse-handle = p-browse-handle
     1596       .
     1597     end.
     1598   end procedure.
     1599   procedure diasize_init :
     1600     define variable v-default-value    as logical   no-undo .
     1601     define variable v-restore-saved    as logical   no-undo .
     1602     define variable v-resize-value-str as character no-undo .
     1603     do
     1604     on error undo, return error return-value
     1605     :
     1606       do with frame Dialog-Frame
     1607       :
     1608         assign
     1609           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1610           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1611           v-diasize-browse-handle     = browse br-drt-prop :handle
     1612         .
     1613         create button v-diasize-resize-button
     1614         assign
     1615           parent        = frame Dialog-Frame :first-child
     1616           label         = "s"
     1617           height-pixels = 16
     1618           width-pixels  = 16
     1619           visible       = true
     1620           sensitive     = true
     1621           movable       = true
     1622           triggers:
     1623             on end-move persistent run diasize_end-move in this-procedure .
     1624           end triggers.
     1625         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1626         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1627         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1628         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1629         assign
     1630           v-diasize-wndmax = false
     1631         .
     1632         if connected("ub") = true
     1633         then do:
     1634           define variable v-cntxt-db-num        as integer   no-undo .
     1635           define variable v-cntxt-userid        as character no-undo .
     1636           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1637                                             , OUTPUT v-cntxt-userid
     1638                                             ) .
     1639           run gbl/wndpar_r.p
     1640             (input  v-cntxt-db-num
     1641             ,input  v-cntxt-userid
     1642             ,input  'wndmax':U
     1643             ,output v-diasize-wndmax
     1644             ,output v-default-value
     1645             ) .
     1646         end.
     1647         assign
     1648           v-diasize-wndstore = false
     1649         .
     1650         if connected("ub") = true
     1651         then do:
     1652           run gbl/wndpar_r.p
     1653             (input  v-cntxt-db-num
     1654             ,input  v-cntxt-userid
     1655             ,input  'wndstore':U
     1656             ,output v-diasize-wndstore
     1657             ,output v-default-value
     1658             ) .
     1659         end.
     1660         assign
     1661           v-diasize-proc-name = entry(1, program-name(2), '.')
     1662         .
     1663         if v-diasize-wndstore = true
     1664         then do:
     1665           assign
     1666             v-restore-saved = false
     1667           .
     1668           if connected("ub") = true
     1669           then do:
     1670             run gbl/wndsizer.p
     1671               (input  v-cntxt-db-num
     1672               ,input  v-cntxt-userid
     1673               ,input  v-diasize-proc-name
     1674               ,input  'height':u
     1675               ,output v-resize-value-str
     1676               ) .
     1677             if v-resize-value-str <> '':U
     1678             then do:
     1679               run diasize_change-height in this-procedure
     1680                 (input  integer(v-resize-value-str)
     1681                 ,input  true
     1682                 ) .
     1683               assign
     1684                 v-restore-saved = true
     1685               .
     1686             end.
     1687           end.
     1688           if connected("ub") = true
     1689           then do:
     1690             run gbl/wndsizer.p
     1691               (input  v-cntxt-db-num
     1692               ,input  v-cntxt-userid
     1693               ,input  v-diasize-proc-name
     1694               ,input  'width':u
     1695               ,output v-resize-value-str
     1696               ) .
     1697             if v-resize-value-str <> '':U
     1698             then do:
     1699               run diasize_change-width in this-procedure
     1700                 (input  integer(v-resize-value-str)
     1701                 ,input  true
     1702                 ) .
     1703               assign
     1704                 v-restore-saved = true
     1705               .
     1706             end.
     1707           end.
     1708           if v-restore-saved <> true
     1709           then do:
     1710             if v-diasize-wndmax = true
     1711             then do:
     1712               run diasize_maximize in this-procedure
     1713                 (input  true
     1714                 ) .
     1715             end.
     1716           end.
     1717         end.
     1718         else do:
     1719           if v-diasize-wndmax = true
     1720           then do:
     1721             run diasize_maximize in this-procedure
     1722               (input  true
     1723               ) .
     1724           end.
     1725         end.
     1726       end.
     1727     end.
     1728   end procedure.
     1729   procedure diasize_need-full-display :
     1730     define output parameter p-need-full-display as logical   no-undo .
     1731     do
     1732     on error undo, return error return-value
     1733     :
     1734       assign
     1735         p-need-full-display = v-diasize-need-full-display
     1736       .
     1737       assign
     1738         v-diasize-need-full-display = false
     1739       .
     1740     end.
     1741   end procedure.
     1742   procedure get-context :
     1743      define output parameter p-db-num as integer          no-undo.
     1744      define output parameter p-user-id as character        no-undo.
     1745      define variable v-login               as character    no-undo.
     1746      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1747      define buffer buf_user-login  for ub.user-login .
     1748      do
     1749      on error undo, return error
     1750      :
     1751            FIND FIRST buf_sys-ctrl no-lock.
     1752            ASSIGN
     1753               v-login = USERID("ub")
     1754               p-db-num = buf_sys-ctrl.db-num
     1755            .
     1756            FIND FIRST buf_user-login
     1757                 WHERE buf_user-login.db-num = p-db-num
     1758                   AND buf_user-login.user-login = v-login
     1759                 no-lock
     1760                 no-error
     1761                 .
     1762            IF AVAILABLE buf_user-login
     1763            THEN DO:
     1764               assign
     1765                  p-user-id = buf_user-login.user-id
     1766               .
     1767            END.
     1768      end.
     1769   end procedure.
     1770       run diasize_init in this-procedure .
     1771   MAIN-BLOCK:
     1772   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1773      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1774     IF p-mode <> 'ДОБАВЛЕНИЕ':U
     1775     AND p-mode <> 'ИЗМЕНЕНИЕ':U
     1776     AND p-mode <> 'ПРОСМОТР':U
     1777     AND p-mode <> 'КОПИРОВАНИЕ':U
     1778     THEN DO:
     1779       MESSAGE
     1780       "Неверное значение параметра p-mode=" p-mode
     1781        VIEW-AS ALERT-BOX ERROR.
     1782       UNDO, RETURN ERROR.
     1783     END.
     1784     CASE p-mode:
     1785       WHEN 'ДОБАВЛЕНИЕ':U THEN DO:
     1786         CREATE tt-dis-time-rule.
     1787       END.
     1788       WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     1789          FIND FIRST LOCKED_dis-time-rule EXCLUSIVE-LOCK where
     1790                  LOCKED_dis-time-rule.time-rule-num = p-templ-rl-root .
     1791         CREATE tt-dis-time-rule.
     1792         BUFFER-COPY LOCKED_dis-time-rule TO tt-dis-time-rule.
     1793         find first locked_dis-cfg-rule exclusive-lock where
     1794                   locked_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
     1795               and locked_dis-cfg-rule.table-name = '':U
     1796               and locked_dis-cfg-rule.pos-type = '':U
     1797               and locked_dis-cfg-rule.self-nonunique = '':U
     1798               and locked_dis-cfg-rule.templ-rl-root = 0
     1799               .
     1800       END.
     1801       WHEN 'ПРОСМОТР':U
     1802       or when 'КОПИРОВАНИЕ':U
     1803       THEN DO:
     1804           FIND FIRST LOCKED_dis-time-rule no-lock where
     1805                 LOCKED_dis-time-rule.time-rule-num = p-templ-rl-root.
     1806         CREATE tt-dis-time-rule.
     1807         BUFFER-COPY LOCKED_dis-time-rule
     1808         except templ-rl-root
     1809                time-rule-num
     1810                rl-root
     1811         TO tt-dis-time-rule
     1812         assign
     1813         tt-dis-time-rule.templ-rl-root = (if p-mode = 'КОПИРОВАНИЕ':U
     1814                                      then 0
     1815                                      else locked_dis-time-rule.templ-rl-root )
     1816         tt-dis-time-rule.rl-root = (if p-mode = 'КОПИРОВАНИЕ':U
     1817                                then 0
     1818                                else locked_dis-time-rule.rl-root)
     1819         tt-dis-time-rule.time-rule-num = (if p-mode = 'КОПИРОВАНИЕ':U
     1820                                 then 0
     1821                                 else locked_dis-time-rule.time-rule-num)
     1822         .
     1823         find first locked_dis-cfg-rule no-lock where
     1824                   locked_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
     1825               and locked_dis-cfg-rule.table-name = '':U
     1826               and locked_dis-cfg-rule.pos-type = '':U
     1827               and locked_dis-cfg-rule.self-nonunique = '':U
     1828               and locked_dis-cfg-rule.templ-rl-root = 0
     1829               .
     1830       END.
     1831     END CASE.
     1832     if p-mode = 'КОПИРОВАНИЕ':U then do:
     1833       assign
     1834       v-is-copy = yes
     1835       p-mode = 'ДОБАВЛЕНИЕ':U
     1836       .
     1837     end.
     1838     RUN fill-temp-drt-prop IN THIS-PROCEDURE.
     1839     RUN Myenable.
     1840     WAIT-FOR GO OF FRAME Dialog-Frame.
     1841   END.
     1842   RUN disable_UI.
     1843   PROCEDURE disable_UI :
     1844     HIDE FRAME Dialog-Frame.
     1845   END PROCEDURE.
     1846   PROCEDURE enable_UI :
     1847     DISPLAY F-level-1 F-level-2
     1848         WITH FRAME Dialog-Frame.
     1849     IF AVAILABLE tt-dis-time-rule THEN
     1850       DISPLAY tt-dis-time-rule.templ-rl-root tt-dis-time-rule.des
     1851             tt-dis-time-rule.other-inf tt-dis-time-rule.uniq-field
     1852             tt-dis-time-rule.value-type tt-dis-time-rule.sts
     1853         WITH FRAME Dialog-Frame.
     1854     ENABLE B-exit b-quit tt-dis-time-rule.templ-rl-root B-Help
     1855            tt-dis-time-rule.des tt-dis-time-rule.other-inf
     1856            tt-dis-time-rule.uniq-field F-level-1 F-level-2
     1857            tt-dis-time-rule.value-type tt-dis-time-rule.sts b-add b-del b-chg
     1858            br-drt-prop
     1859         WITH FRAME Dialog-Frame.
     1860     VIEW FRAME Dialog-Frame.
     1861   END PROCEDURE.
     1862   PROCEDURE fill-temp-drt-prop :
     1863   define variable v-path                    as character                no-undo .
     1864   DEFINE VARIABLE v-full-path               as character                no-undo .
     1865   DEFINE VARIABLE v-file-name               as character                no-undo .
     1866   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1867   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1868   DEFINE VARIABLE v-start AS LOGICAL NO-UNDO INIT YES.
     1869   DEFINE VARIABLE v-node-code AS integer NO-UNDO.
     1870   DEFINE BUFFER buf_drt-prop FOR  ub.drt-prop.
     1871   DEFINE BUFFER upper_drt-prop FOR ub.drt-prop.
     1872   DEFINE BUFFER buf_tt-drt-prop FOR tt-drt-prop.
     1873   _buf_drt-prop:
     1874   FOR EACH buf_drt-prop NO-LOCK WHERE
     1875           buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1876     CREATE buf_tt-drt-prop.
     1877     BUFFER-COPY buf_drt-prop TO buf_tt-drt-prop
     1878     .
     1879     if v-is-copy = yes then do:
     1880       assign
     1881       buf_tt-drt-prop.templ-rl-root = -1.
     1882     end.
     1883     v-start = YES.
     1884     FIND FIRST UPPER_drt-prop NO-LOCK WHERE
     1885               UPPER_drt-prop.upper-node-code = buf_drt-prop.upper-node-code
     1886           AND UPPER_drt-prop.node-code = buf_drt-prop.node-code
     1887           AND UPPER_drt-prop.templ-rl-root = buf_drt-prop.templ-rl-root.
     1888     DO WHILE v-start OR buf_drt-prop.upper-node-code <> 0:
     1889       v-start = NO.
     1890       IF AVAILABLE UPPER_drt-prop THEN DO:
     1891         ASSIGN
     1892         buf_tt-drt-prop.full-prop-name = UPPER_drt-prop.prop-code +
     1893                                             chr(47) +
     1894                                         buf_tt-drt-prop.full-prop-name.
     1895       END.
     1896       v-node-code = upper_drt-prop.upper-node-code.
     1897       FIND FIRST UPPER_drt-prop NO-LOCK WHERE
     1898                  UPPER_drt-prop.node-code = v-node-code
     1899               AND UPPER_drt-prop.templ-rl-root = buf_drt-prop.templ-rl-root NO-ERROR.
     1900       IF NOT AVAILABLE UPPER_drt-prop THEN next _buf_drt-prop.
     1901     END.
     1902   END.
     1903   CREATE tt-drt-prop.
     1904   ASSIGN
     1905   tt-drt-prop.prop-code = '':U
     1906   tt-drt-prop.node-code = 0
     1907   tt-drt-prop.upper-prop-code = '':U
     1908   tt-drt-prop.upper-node-code = 0
     1909   tt-drt-prop.templ-rl-root = (if v-is-copy then - 1 else p-templ-rl-root)
     1910   .
     1911   END PROCEDURE.
     1912   PROCEDURE MyEnable :
     1913   DEFINE VARIABLE v-list-items AS CHARACTER  NO-UNDO.
     1914   DEFINE VARIABLE v-ii AS integer  NO-UNDO.
     1915   v-list-items = '':U.
     1916   DO v-ii = 1 TO NUM-ENTRIES('0,1,2,4,8,16':U):
     1917       ASSIGN
     1918       v-list-items = v-list-items +  (IF v-ii > 1 then chr(44) ELSE '':U) +
     1919                      ENTRY(v-ii, '?,Период времени,Период дат,День недели,Дата,День месяца':U) + chr(44) +
     1920                      ENTRY(v-ii, '0,1,2,4,8,16':U).
     1921   END.
     1922   ASSIGN
     1923   tt-dis-time-rule.value-type:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = v-list-items.
     1924   assign
     1925   tt-dis-time-rule.sts:radio-buttons in frame Dialog-Frame = "Текущий"   + chr(44) + '0':U +  chr(44) +
     1926                                                      "Нетекущий" + chr(44) + '1':U
     1927   .
     1928   ASSIGN
     1929   f-level-1 = entry(1, locked_dis-cfg-rule.other-inf, ";":U)
     1930   f-level-2 = (if num-entries(locked_dis-cfg-rule.other-inf, ";":U) > 1
     1931                then entry(2, locked_dis-cfg-rule.other-inf, ";":U)
     1932                else '')
     1933   .
     1934   DISPLAY
     1935   f-level-1
     1936   f-level-2
     1937   WITH FRAME Dialog-Frame.
     1938   IF AVAILABLE tt-dis-time-rule THEN
     1939   DISPLAY
     1940   tt-dis-time-rule.templ-rl-root
     1941   tt-dis-time-rule.des
     1942   tt-dis-time-rule.discnt-type
     1943   tt-dis-time-rule.other-inf
     1944   tt-dis-time-rule.uniq-field
     1945   tt-dis-time-rule.value-type
     1946   tt-dis-time-rule.sts
     1947   WITH FRAME Dialog-Frame.
     1948   ENABLE
     1949   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     1950   b-quit
     1951   B-Help
     1952   tt-dis-time-rule.templ-rl-root WHEN p-mode = 'ДОБАВЛЕНИЕ':U
     1953   tt-dis-time-rule.des WHEN p-mode <> 'ПРОСМОТР':U
     1954   tt-dis-time-rule.other-inf WHEN p-mode <> 'ПРОСМОТР':U
     1955   tt-dis-time-rule.uniq-field WHEN p-mode <> 'ПРОСМОТР':U
     1956   tt-dis-time-rule.value-type WHEN p-mode <> 'ПРОСМОТР':U
     1957   tt-dis-time-rule.sts when p-mode <> 'ПРОСМОТР':U
     1958   f-level-1 when p-mode <> 'ПРОСМОТР':U
     1959   f-level-2 when p-mode <> 'ПРОСМОТР':U
     1960   b-add WHEn p-mode <> 'ПРОСМОТР':U
     1961   b-del WHEn p-mode <> 'ПРОСМОТР':U
     1962   b-chg WHEn p-mode <> 'ПРОСМОТР':U
     1963   br-drt-prop
     1964   WITH FRAME Dialog-Frame.
     1965   VIEW FRAME Dialog-Frame.
     1966   if p-mode = 'ПРОСМОТР':U then do:
     1967     hide
     1968     b-exit
     1969     in frame Dialog-Frame .
     1970     assign
     1971     b-quit:column = 1
     1972     b-quit:label = "&Выход"
     1973     .
     1974   end.
     1975   RUN OPENbr IN THIS-PROCEDURE.
     1976   END PROCEDURE.
     1977   PROCEDURE Openbr :
     1978   OPEN QUERY br-drt-prop FOR EACH tt-drt-prop by tt-drt-prop.full-prop-name.
     1979   END PROCEDURE.
     1980   PROCEDURE proc-b-add :
     1981   define output parameter p-node-code     as integer initial ?  no-undo .
     1982   DEFINE VARIABLE v-upper-prop-code       AS CHARACTER NO-UNDO .
     1983   define variable v-upper-node-code       as integer   no-undo .
     1984   DEFINE VARIABLE v-upper-prop-label      AS CHARACTER NO-UNDO .
     1985   DEFINE VARIABLE v-full-prop-name        AS CHARACTER NO-UNDO .
     1986   DEFINE VARIABLE v-upper-full-prop-name  AS CHARACTER NO-UNDO .
     1987   DEFINE VARIABLE v-prop-code             AS CHARACTER NO-UNDO .
     1988   define variable v-node-code             as integer   no-undo .
     1989   DEFINE VARIABLE v-prop-label            AS CHARACTER NO-UNDO .
     1990   DEFINE VARIABLE v-property-value        AS CHARACTER NO-UNDO .
     1991   DEFINE BUFFER buf_tt-drt-prop FOR tt-drt-prop.
     1992   run utl/drtpropi.w (  INPUT parparentproc
     1993                        ,output v-upper-prop-code
     1994                        ,output v-upper-node-code
     1995                        ,OUTPUT v-upper-prop-label
     1996                        ,OUTPUT v-full-prop-name
     1997                        ,OUTPUT v-prop-code
     1998                        ,output v-node-code
     1999                        ,OUTPUT v-prop-label
     2000                        ) NO-ERROR.
     2001   IF ERROR-STATUS:ERROR THEN undo, RETURN ERROR.
     2002   if v-prop-code = '':u then return.
     2003   FIND FIRST buf_tt-drt-prop WHERE
     2004             buf_tt-drt-prop.full-prop-name = v-full-prop-name NO-ERROR.
     2005   IF AVAILABLE buf_tt-drt-prop THEN DO:
     2006      MESSAGE
     2007     "Уже есть такой параметр в такой секции" SKIP
     2008      v-full-prop-name
     2009      VIEW-AS ALERT-BOX ERROR.
     2010      UNDO, RETURN ERROR.
     2011   END.
     2012   ASSIGN
     2013   v-UPPER-full-prop-name = v-full-prop-name
     2014   .
     2015   ASSIGN
     2016   v-upper-full-prop-name = RIGHT-TRIM(v-upper-full-prop-name, chr(47))
     2017   .
     2018   ENTRY(NUM-ENTRIES(v-upper-full-prop-name, chr(47)), v-upper-full-prop-name, chr(47)) = '':U.
     2019   FIND FIRST buf_tt-drt-prop WHERE
     2020             buf_tt-drt-prop.full-prop-name = v-upper-full-prop-name NO-ERROR.
     2021   IF NOT AVAILABLE buf_tt-drt-prop THEN DO:
     2022      MESSAGE
     2023     "Нет секции с полным именем ="
     2024      v-upper-full-prop-name
     2025      VIEW-AS ALERT-BOX ERROR.
     2026      UNDO, RETURN ERROR.
     2027   END.
     2028   CREATE buf_tt-drt-prop.
     2029   ASSIGN
     2030   buf_tt-drt-prop.prop-code       = v-prop-code
     2031   buf_tt-drt-prop.node-code       = v-node-code
     2032   buf_tt-drt-prop.upper-prop-code = v-upper-prop-code
     2033   buf_tt-drt-prop.upper-node-code = v-upper-node-code
     2034   buf_tt-drt-prop.property-value  = v-property-value
     2035   buf_tt-drt-prop.full-prop-name  = v-full-prop-name
     2036   buf_tt-drt-prop.templ-rl-root   = p-templ-rl-root
     2037   p-node-code                     = v-node-code
     2038   .
     2039   release buf_tt-drt-prop.
     2040   RUN openbr IN THIS-PROCEDURE .
     2041   find first buf_tt-drt-prop no-lock
     2042     where buf_tt-drt-prop.templ-rl-root = p-templ-rl-root
     2043       and buf_tt-drt-prop.node-code     = v-node-code
     2044   no-error .
     2045   if available buf_tt-drt-prop  then do:
     2046     REPOSITION  br-drt-prop TO RECID RECID(buf_tt-drt-prop) NO-ERROR.
     2047   end.
     2048   APPLY "ENTRY" TO BROWSE br-drt-prop.
     2049   END PROCEDURE.
     2050   PROCEDURE proc-b-chg :
     2051   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     2052   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     2053   v-value = tt-drt-prop.property-value.
     2054         run gbl/d-character.w (
     2055                input ?
     2056               ,input (
     2057               'title=':u + substitute("Изменение свойства &1", tt-drt-prop.prop-code) + '\':u
     2058             + 'text1=':u + tt-drt-prop.prop-code + '\':u
     2059             + 'format=' + "X(90)" + '\':u
     2060             + 'fillin_row=3\':u
     2061             + 'fillin_col=4\':u
     2062             + 'fillin_width=90\':u
     2063             + 'fillin_height=1\':u
     2064             + 'max-chars=90\':u
     2065             + 'readonly=no' + '\':u)
     2066             , input-output v-value
     2067             , output v-ok
     2068                 ).
     2069             if not v-ok then return error.
     2070   assign
     2071   tt-drt-prop.property-value = v-value.
     2072   br-drt-prop:REFRESH() IN FRAME Dialog-Frame.
     2073   END PROCEDURE.
     2074   PROCEDURE proc-b-del :
     2075   DEFINE VARIABLE glog AS LOGICAL no-undo.
     2076   DEFINE BUFFER buf_tt-drt-prop FOR tt-drt-prop.
     2077   MESSAGE
     2078   SUBSTITUTE("Вы уверены, что хотите удалить свойство?")
     2079   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     2080   IF NOT glog  THEN RETURN ERROR.
     2081   FIND FIRST buf_tt-drt-prop WHERE
     2082             buf_tt-drt-prop.upper-node-code = tt-drt-prop.node-code  NO-ERROR.
     2083   IF AVAILABLE buf_tt-drt-prop THEN DO:
     2084     MESSAGE
     2085     "Нельзя удалить свойство, к нему есть привязки"
     2086      VIEW-AS ALERT-BOX ERROR.
     2087     UNDO, RETURN ERROR.
     2088   END.
     2089   FIND FIRST buf_tt-drt-prop WHERE
     2090            RECID(buf_tt-drt-prop) = RECID(tt-drt-prop).
     2091   DELETE buf_tt-drt-prop.
     2092   RUN Openbr IN THIS-PROCEDURE.
     2093   END PROCEDURE.
     2094   PROCEDURE proc-save :
     2095   define buffer buf_tt-drt-prop for tt-drt-prop.
     2096   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2097   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     2098   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2099     v-rec = p-rec.
     2100   END.
     2101   ASSIGN
     2102   FRAME Dialog-Frame
     2103   tt-dis-time-rule.templ-rl-root
     2104   tt-dis-time-rule.des
     2105   tt-dis-time-rule.other-inf
     2106   tt-dis-time-rule.uniq-field
     2107   tt-dis-time-rule.value-type
     2108   tt-dis-time-rule.sts
     2109   f-level-1
     2110   f-level-2
     2111   .
     2112   for each buf_tt-drt-prop:
     2113     assign
     2114     buf_tt-drt-prop.templ-rl-root = tt-dis-time-rule.templ-rl-root
     2115     .
     2116   end.
     2117   run utl/distrul0.p ( INPUT p-mode
     2118                       ,INPUT NO
     2119                       ,INPUT-output v-rec
     2120                       ,INPUT tt-dis-time-rule.templ-rl-root
     2121                       ,INPUT tt-dis-time-rule.des
     2122                       ,INPUT tt-dis-time-rule.other-inf
     2123                       ,INPUT tt-dis-time-rule.uniq-field
     2124                       ,INPUT tt-dis-time-rule.value-type
     2125                       ,INPUT tt-dis-time-rule.sts
     2126                       ,input f-level-1
     2127                       ,input f-level-2
     2128                       ,input table tt-drt-prop
     2129                       ) NO-ERROR.
     2130   IF ERROR-STATUS:ERROR THEN DO:
     2131     message error-status:get-message(1) view-as alert-box .
     2132   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2133   define variable fh as widget-handle no-undo .
     2134   define variable hh as widget-handle no-undo .
     2135   define variable rv as character no-undo .
     2136   assign
     2137   rv = entry(1, return-value , chr(4)).
     2138   if rv <> "":U then do:
     2139     assign
     2140     fh = frame Dialog-Frame:first-child
     2141     hh = fh:first-child
     2142     .
     2143     do while valid-handle(hh):
     2144       if hh:name = rv then do:
     2145         APPLY "ENTRY" to hh.
     2146         undo ,
     2147         return error.
     2148       end.
     2149       hh = hh:next-sibling.
     2150     end.
     2151   end.
     2152     undo, return error.
     2153   END.
     2154   p-rec = v-rec.
     2155   END PROCEDURE.
