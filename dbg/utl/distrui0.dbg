      406   DEFINE QUERY br-drt-prop FOR
      407         tt-drt-prop SCROLLING.
      408   DEFINE QUERY Dialog-Frame FOR
      409         tt-dis-time-rule SCROLLING.
      410   DEFINE BROWSE br-drt-prop
      411     QUERY br-drt-prop NO-LOCK DISPLAY
      412         tt-drt-prop.node-code COLUMN-LABEL "код" FORMAT ">>9"
      413   tt-drt-prop.upper-node-code COLUMN-LABEL "выш.!код" FORMAT ">>9"
      414   tt-drt-prop.full-prop-name COLUMN-LABEL "Свойство" FORMAT "X(255)" WIDTH 40
      415   tt-drt-prop.property-value COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 58
      416       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.87 FIT-LAST-COLUMN.
      417   DEFINE FRAME Dialog-Frame
      418        B-exit AT ROW 1 COL 1
      419        b-quit AT ROW 1 COL 11
      420        tt-dis-time-rule.templ-rl-root AT ROW 1 COL 43 COLON-ALIGNED WIDGET-ID 4
      421             LABEL "Код шаблона"
      422             VIEW-AS FILL-IN
      423             SIZE 10 BY 1
      424        B-Help AT ROW 1 COL 95
      425        tt-dis-time-rule.des AT ROW 2 COL 4 WIDGET-ID 6
      426             LABEL "Описание"
      427             VIEW-AS FILL-IN
      428             SIZE 84.5 BY 1
      429        tt-dis-time-rule.other-inf AT ROW 4 COL 2.6 WIDGET-ID 10
      430             LABEL "Другая инф" FORMAT "X(90)"
      431             VIEW-AS FILL-IN
      432             SIZE 84.5 BY 1
      433        tt-dis-time-rule.uniq-field AT ROW 5 COL 51 COLON-ALIGNED WIDGET-ID 14
      434             LABEL "Дерево" FORMAT "X(65)"
      435             VIEW-AS FILL-IN
