        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: ini-unit.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/ini-unit.p $":U .
        8   define variable vss-description as character no-undo init "Изменение базовой ед. изм. по списку товаров".
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   define new global shared variable g#library  as handle no-undo .
       14   define new global shared variable g#library2 as handle no-undo .
       15   define   shared variable g#auto as logical no-undo.
       16   define   shared variable g#news as logical no-undo.
       17   define   shared variable g#oxml as logical no-undo.
       18   define   shared variable g#esys as logical no-undo.
       19   define   shared variable g#news-source-db as integer no-undo.
       20   define   shared variable g#esys-source-esys as integer no-undo.
       21   define   shared variable g#db-num as integer   no-undo .
       22   define   shared variable g#userid as character no-undo .
       23   define   shared variable g#passwd as character no-undo .
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define new shared temp-table gds-list no-undo like ub.goods
       80     field qnty   as decimal
       81     field to-del as logical
       82     field order-num as integer
       83     field to-sel as logical
       84     field promo-code as character
       85     field ActionId  as int64
       86     field db-num as integer
       87     index art  is primary unique artic prod-type prod-code
       88     index code is         unique gds-code
       89     index oi order-num
       90     index isel to-sel
       91     .
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define  new shared  temp-table gds-list-hist no-undo
       94   field list-table as character
       95   field id as integer
       96   field line as integer
       97   field hist-mode as character
       98   field des as character
       99   field num-recs as integer
      100   field option_ as character
      101   field item_ as character
      102   field status_ as character
      103   field num-add as integer
      104   field num-ignored as integer
      105   field done as logical
      106   field err_ as logical
      107   field err-mes as character
      108   index pi is primary
      109   id
      110   line
      111   index isdone
      112   done
      113   .
      114   function diff-list returns character (
      115     input parfirst-list  as character,
      116     input parsecond-list as character,
      117     input pardelim       as character).
      118     if pardelim = ""
      119     or pardelim = ?
      120     then do:
      121       assign
      122         pardelim = ","
      123       .
      124     end.
      125     def var ind as integer no-undo .
      126     def var v-elem as character no-undo .
      127     def var v-result-list as character no-undo init "".
      128     def var v-num-parfirst-list as integer no-undo .
      129     assign
      130       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      131     .
      132     do ind = 1 to v-num-parfirst-list
      133     :
      134       assign
      135         v-elem = entry(ind, parfirst-list, pardelim)
      136       .
      137       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      138         assign
      139           v-result-list = v-result-list
      140                         + (if v-result-list > "" then pardelim else "")
      141                         + v-elem
      142         .
      143       end.
      144     end.
      145     return v-result-list .
      146   end function.
      147   function add-list returns character (
      148    input parfirst-list  as character,
      149    input parsecond-list as character,
      150    input pardelim       as character).
      151     if pardelim = ""
      152     or pardelim = ?
      153     then do:
      154       assign
      155         pardelim = ","
      156       .
      157     end.
      158     def var ind as integer no-undo .
      159     def var v-elem as character no-undo .
      160     def var v-result-list as character no-undo init "".
      161     def var v-num-parfirst-list as integer no-undo .
      162     assign
      163       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      164     .
      165     do ind = 1 to v-num-parfirst-list
      166     :
      167       assign
      168         v-elem = entry(ind, parfirst-list, pardelim)
      169       .
      170       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      171         assign
      172           v-result-list = v-result-list
      173                         + (if v-result-list > "" then pardelim else "")
      174                         + v-elem
      175         .
      176       end.
      177     end.
      178     def var v-num-parsecond-list as integer no-undo .
      179     assign
      180       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      181     .
      182     do ind = 1 to v-num-parsecond-list
      183     :
      184       assign
      185         v-elem = entry(ind, parsecond-list, pardelim)
      186       .
      187       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      188         assign
      189           v-result-list = v-result-list
      190                         + (if v-result-list > "" then pardelim else "")
      191                         + v-elem
      192         .
      193       end.
      194     end.
      195     return v-result-list .
      196   end function.
      197   function cross-list returns character (
      198    input parfirst-list  as character,
      199    input parsecond-list as character,
      200    input pardelim       as character).
      201     if pardelim = ""
      202     or pardelim = ?
      203     then do:
      204       assign
      205         pardelim = ","
      206       .
      207     end.
      208     def var ind as integer no-undo .
      209     def var v-elem as character no-undo .
      210     def var v-result-list as character no-undo init "".
      211     def var v-num-parfirst-list as integer no-undo .
      212     assign
      213       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      214     .
      215     do ind = 1 to v-num-parfirst-list
      216     :
      217       assign
      218         v-elem = entry(ind, parfirst-list, pardelim)
      219       .
      220       if lookup(v-elem, v-result-list, pardelim) = 0
      221       and lookup(v-elem, parsecond-list, pardelim) > 0
      222       then do:
      223         assign
      224           v-result-list = v-result-list
      225                         + (if v-result-list > "" then pardelim else "")
      226                         + v-elem
      227         .
      228       end.
      229     end.
      230     return v-result-list .
      231   end function.
      232   function radio-label returns character (
      233    input par-rs-value  as character,
      234    input par-rs-radio-buttons as character)
      235    .
      236    DEFINE variable v-result-label as character no-undo.
      237    assign
      238    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      239                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      240                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      241                             ), par-rs-radio-buttons
      242                           )
      243    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      244    .
      245   return v-result-label.
      246   end function.
      247   function m-radio-label returns character (
      248    input par-rs-value  as character,
      249    input par-rs-radio-buttons as character,
      250    input par-delim as character
      251    )
      252    .
      253    DEFINE variable v-result-label as character no-undo.
      254    assign
      255    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      256                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      257                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      258                             ), par-rs-radio-buttons, par-delim
      259                           )
      260    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      261    .
      262   return v-result-label.
      263   end function.
      264   FUNCTION mixlist returns character
      265   (
      266    input parfirst-list  as character
      267    ,input parsecond-list as character
      268    ,input pardelim       as character
      269    ,input pardelim-result as character ) :
      270     if pardelim = ""
      271     or pardelim = ?
      272     then do:
      273       assign
      274         pardelim = ","
      275       .
      276     end.
      277     def var ind as integer no-undo .
      278     def var v-elem1 as character no-undo .
      279     def var v-elem2 as character no-undo .
      280     def var v-result-list as character no-undo init "".
      281     do ind = 1 to num-entries(parfirst-list, pardelim)
      282     :
      283       assign
      284         v-elem1 = entry(ind, parfirst-list, pardelim)
      285         v-elem2 = entry(ind, parsecond-list, pardelim)
      286       .
      287         assign
      288           v-result-list = v-result-list
      289                         + (if v-result-list > "" then pardelim-result else "")
      290                         + v-elem1 + pardelim-result + v-elem2
      291         .
      292     end.
      293     return v-result-list .
      294   END FUNCTION.
      295   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296     define variable v-cntxt-db-num        as integer   no-undo .
      297     define variable v-cntxt-userid        as character no-undo .
      298     define variable v-cntxt-level         as character no-undo .
      299     define variable v-cntxt-host-code-obj as integer   no-undo .
      300     define variable v-cntxt-obj-type      as character no-undo .
      301     define variable v-cntxt-obj-code      as integer   no-undo .
      302     define variable v-cntxt-db-num-obj    as integer   no-undo .
      303     define variable v-cntxt-is-admin      as logical   no-undo .
      304   define variable new-unit as char no-undo.
      305   define variable old-type as char no-undo.
      306   define variable new-type as char no-undo.
      307   define variable glog as logical no-undo .
      308   def buffer old-units for ub.units.
      309   define buffer buf_bar-code for ub.bar-code.
      310   def frame a
      311   new-unit label "Новая единица" format "x(3)"
      312   with side-labels view-as dialog-box.
      313   define variable v-ind as integer no-undo.
      314   define variable num-rec as integer no-undo.
      315   def frame b
      316   v-ind label "Обработано товаров"
      317   ub.goods.gds-name label "Название"
      318   with side-labels view-as dialog-box.
      319   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320     run mainmenu_getcntxt in parparentproc
      321       (output v-cntxt-db-num
      322       ,output v-cntxt-userid
      323       ,output v-cntxt-level
      324       ,output v-cntxt-host-code-obj
      325       ,output v-cntxt-obj-type
      326       ,output v-cntxt-obj-code
      327       ,output v-cntxt-db-num-obj
      328       ,output v-cntxt-is-admin
      329       ) .
      330   run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
      331   find first ub.db No-LOCK WHERE
      332              ub.db.db-num <> 0 no-error .
      333   if available ub.db then do:
      334     message "Утилита может быть запущена только в системе без УБД.".
      335     return.
      336   end.
      337   glog = yes.
      338   message "Изменить базовую единицу измерения по всем товарам списка ?  Вы уверены ?"
      339                   view-as alert-box question buttons OK-Cancel update glog.
      340   if not glog then return.
      341   update new-unit with frame a.
      342   find ub.units where ub.units.unit-name = new-unit no-lock no-error.
      343   if not available ub.units then do:
      344     message "Нет такой единицы !".
      345     return.
      346   end.
      347   find ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock.
      348   view frame b.
      349   v-ind = 0.
      350   ON WRITE OF ub.bar-code OVERRIDE DO:
      351   END.
      352   ON WRITE OF ub.goods OVERRIDE DO:
      353   END.
      354   _gds-list:
      355   for each gds-list:
      356     num-rec = num-rec + 1.
      357     find ub.goods where
      358          ub.goods.artic = gds-list.artic
      359      and ub.goods.prod-type = gds-list.prod-type
      360      and ub.goods.prod-code = gds-list.prod-code.
      361     disp ub.goods.gds-name with frame b.
      362     run check-unit-chg No-ERROR.
      363     if error-status:error then NEXT _gds-list.
      364     for each ub.bar-code where
      365              ub.bar-code.gds-code = ub.goods.gds-code AND
      366              ub.bar-code.unit-cli = ub.goods.unit-base:
      367       find first buf_bar-code No-LOCK WHERE
      368                  buf_bar-code.gds-code = ub.goods.gds-code AND
      369                  buf_bar-code.node-code = ub.bar-code.node-code AND
      370                  buf_bar-code.part-code = ub.bar-code.part-code AND
      371                  buf_bar-code.in-code = ub.bar-code.in-code AND
      372                  buf_bar-code.unit-cli = ub.units.unit-name no-error .
      373       if available buf_bar-code then do:
      374         message
      375         "Не смогу изменить единицу измерения на" ub.units.unit-name skip
      376         "уже имеются бар-коды с такой единицей измерения" skip
      377         "товар" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      378         "бар-код" buf_bar-code.b-code skip
      379         view-as alert-box error .
      380         NEXT _gds-list.
      381       end.
      382     end.
      383     chg-unit:
      384     do on stop undo chg-unit, return on error undo chg-unit, return:
      385       if LOOKUP('сер':U, units.type) > 0 or
      386          LOOKUP('сте':U, units.type) > 0 then do:
      387         if ub.goods.prt-root <> ub.gds-prt.upper-code then next.
      388         ub.goods.unit-cli = units.unit-name.
      389         ub.goods.cli-base-rate = 1.
      390       end.
      391       for each ub.bar-code
      392         where ub.bar-code.gds-code = ub.goods.gds-code
      393           and ub.bar-code.unit-cli = ub.goods.unit-base
      394            on stop undo chg-unit, return on error undo chg-unit, return:
      395         ub.bar-code.unit-cli = ub.units.unit-name.
      396         if ub.bar-code.unit-cli = ub.goods.unit-base then do:
      397           assign
      398             ub.bar-code.cli-base-rate = 1
      399           .
      400         end.
      401       end.
      402       ub.goods.unit-base = ub.units.unit-name.
      403       disp v-ind with frame b.
      404       v-ind = v-ind + 1.
      405       process events.
      406     end.
      407   end.
      408   ON WRITE OF ub.bar-code REVERT.
      409   ON WRITE OF ub.goods REVERT.
      410   if v-ind < num-rec then
      411   message "Из выбранных " num-rec "товаров удалось отредактировать " v-ind.
      412   else
      413   message "Изменение проведено успешно.".
      414   PROCEDURE check-unit-chg:
      415   main-block:
      416   do
      417   on error undo main-block, return error
      418   :
      419     FIND FIRST old-units No-LOCK WHERE old-units.unit-name = ub.goods.unit-base No-ERROR.
      420     if diff-list(old-units.type , ub.units.type, chr(44)) = "" then return.
      421   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422     assign
      423       old-type  = (if lookup ('шту':U, old-units.type)     = 0 then "0" else "1")
      424                 + (if lookup ('дро':U, old-units.type) = 0 then "0" else "1")
      425                 + (if lookup ('сер':U, old-units.type)     = 0 then "0" else "1")
      426                 + (if lookup ('вес':U, old-units.type)     = 0 then "0" else "1")
      427                 + (if lookup ('топ':U, old-units.type)  = 0 then "0" else "1")
      428                 + (if lookup ('2ед':U, old-units.type)    = 0 then "0" else "1")
      429                 + (if lookup ('доп':U, old-units.type)    = 0 then "0" else "1")
      430                 + (if lookup ('сте':U, old-units.type)     = 0 then "0" else "1")
      431       new-type  = (if lookup ('шту':U, ub.units.type)     = 0 then "0" else "1")
      432                 + (if lookup ('дро':U, ub.units.type) = 0 then "0" else "1")
      433                 + (if lookup ('сер':U, ub.units.type)     = 0 then "0" else "1")
      434                 + (if lookup ('вес':U, ub.units.type)     = 0 then "0" else "1")
      435                 + (if lookup ('топ':U, ub.units.type)  = 0 then "0" else "1")
      436                 + (if lookup ('2ед':U, ub.units.type)    = 0 then "0" else "1")
      437                 + (if lookup ('доп':U, ub.units.type)    = 0 then "0" else "1")
      438                 + (if lookup ('сте':U, ub.units.type)     = 0 then "0" else "1")
      439     .
      440     if lookup (new-type, "10000000,01000000,00100000,00010000,10001000,01001000,01000100,10000010,10000001") = 0 then do:
      441       if g#esys then do:
      442                 undo, return error substitute( "&2&1Недопустимый тип единицы измерения&1
      443                                                 Единица измерения &3&1
      444                                                 Тип единицы измерения &4&1
      445                                                 Характеристика типа &5&1 
      446                                                 &6&1&7"
      447                                , chr(10)
      448                                , vss-workfile
      449                                , ub.units.unit-name
      450                                , ub.units.type
      451                                , new-type
      452                                , return-value
      453                                , error-status :get-message ( 1 ) ).
      454       end.
      455       else do:
      456       message
      457         vss-workfile vss-revision vss-description skip
      458         "Недопустимый тип единицы измерения" skip
      459         "Единица измерения" ub.units.unit-name skip
      460         "Тип единицы измерения" ub.units.type skip
      461         "Характеристика типа" new-type skip
      462         view-as alert-box error .
      463       undo main-block, return error .
      464       end.
      465     end.
      466     if old-type <> new-type then do:
      467       if lookup ((old-type + "-" + new-type),
      468         "10000000-01000000,10001000-01001000,00001000-10001000,00001000-01001000,10000000-10000010,10000010-10000000") = 0 and
      469         old-type <> "00000000" then do:
      470           if g#esys then do:
      471                           undo, return error substitute( "&2&1Недопустимая замена типа единицы измерения&1
      472                                                 Единица измерения &3&1
      473                                                 Тип единицы измерения &4&1
      474                                                 Характеристика типа &5&1 
      475                                                 &6&1&7"
      476                                , chr(10)
      477                                , vss-workfile
      478                                , ub.units.unit-name
      479                                , ub.units.type
      480                                , new-type
      481                                , return-value
      482                                , error-status :get-message ( 1 ) ).
      483           end.
      484           else do:
      485         message
      486           vss-workfile vss-revision vss-description skip
      487           "Недопустимая замена типа единицы измерения" skip
      488           "Единица измерения" ub.units.unit-name skip
      489           "Изменение типа:" old-units.type "->" ub.units.type skip
      490           "Изменение характеристики типа:" old-type "->" new-type skip
      491           view-as alert-box error .
      492         undo main-block, return error .
      493         end.
      494       end.
      495     end.
      496   END.
      497   END PROCEDURE.
