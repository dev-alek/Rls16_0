        1   block-level on error undo, throw.
        2   define variable p-install as logical no-undo init true  .
        3   define variable vss-revision    as character no-undo init "$Revision: d47c064bc860, 1107, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        5   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: abc-utl.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/abc-utl.p $":U .
        8   define variable vss-description as character no-undo init "".
        9   def var start-time     as integer   no-undo .
       10   def var current-time   as integer   no-undo .
       11   def var v-ind          as integer no-undo .
       12   def var v-err-count    as integer no-undo .
       13   def var v-file-name    as char no-undo init "03091801.txt".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   def frame a
       75     "Создание справочника Критерии анализа"
       76     v-ind        format "->>>>>>>>9" label "Количество записей" skip
       77     current-time format "->>>>>>>>9" label "Время" skip
       78     with view-as dialog-box side-labels three-d
       79     title "Закачка данных"
       80     .
       81   if p-install = false then do:
       82     def var lok as logical no-undo .
       83     message
       84       vss-description
       85       "Заменить Справочник Критериев анализа на стандартный " skip
       86       "Продолжить?"
       87       view-as alert-box question buttons yes-no update lok .
       88     if lok <> true then do:
       89       return .
       90     end.
       91   end.
       92   do
       93   on error undo, return error
       94   :
       95     assign
       96       start-time = time
       97       v-ind        = 15
       98     .
       99     view frame a .
      100     display v-ind  with frame a .
      101     run proc-in .
      102     if p-install = false then do:
      103       message
      104         vss-description skip
      105         "Утилита завершила работу" skip
      106         view-as alert-box information .
      107     end.
      108     return "Создано" + string(v-ind)  + " ошибок " + string(v-err-count).
      109   END.
      110   procedure proc-in :
      111     do
      112     on error undo, return error return-value
      113     :
      114     for each criterion-analysis exclusive-lock :
      115       delete criterion-analysis .
      116     end.
      117     create criterion-analysis.
      118           assign
      119             criterion-analysis.cral-id     = 1
      120             criterion-analysis.cral-name   = "Оборот в количестве"
      121             criterion-analysis.cral-des    = "Общее количество в базовых единицах"
      122             criterion-analysis.cral-status = 0
      123             .
      124     create criterion-analysis.
      125           assign
      126             criterion-analysis.cral-id     = 2
      127             criterion-analysis.cral-name   = "Оборот в учетных ценах в нац.валюте"
      128             criterion-analysis.cral-des    = "Реализовано по ценам из партий в нац.валюте"
      129             criterion-analysis.cral-status = 0
      130             .
      131     create criterion-analysis.
      132           assign
      133             criterion-analysis.cral-id     = 3
      134             criterion-analysis.cral-name   = "Оборот в ценах документа в нац.валюте"
      135             criterion-analysis.cral-des    = "Реализовано товара по ценам документа в нац.валюте"
      136             criterion-analysis.cral-status = 0
      137             .
      138     create criterion-analysis.
      139           assign
      140             criterion-analysis.cral-id     = 4
      141             criterion-analysis.cral-name   = "Оборот в текущих продажных ценах в нац.валюте     "
      142             criterion-analysis.cral-des    = "Реализовано в текущих продажных ценах в нац.валюте "
      143             criterion-analysis.cral-status = 0
      144             .
      145     create criterion-analysis.
      146           assign
      147             criterion-analysis.cral-id     = 5
      148             criterion-analysis.cral-name   = "Оборот в учетных ценах в баз.валюте        "
      149             criterion-analysis.cral-des    = "Реализовано по ценам из партий в базовой валюте "
      150             criterion-analysis.cral-status = 0
      151             .
      152     create criterion-analysis.
      153           assign
      154             criterion-analysis.cral-id     = 6
      155             criterion-analysis.cral-name   = "Оборот в ценах документа в баз.валюте"
      156             criterion-analysis.cral-des    = "Реализовано по ценам из документа в базовой валюте"
      157             criterion-analysis.cral-status = 0
      158             .
      159     create criterion-analysis.
      160           assign
      161             criterion-analysis.cral-id     = 7
      162             criterion-analysis.cral-name   = "Оборот в текущих продажных ценах в баз.валюте"
      163             criterion-analysis.cral-des    = "Реализовано в текущих продажных ценах в базовой валюте"
      164             criterion-analysis.cral-status = 0
      165             .
      166     create criterion-analysis.
      167           assign
      168             criterion-analysis.cral-id     = 8
      169             criterion-analysis.cral-name   = "Прибыль в нац.валюте"
      170             criterion-analysis.cral-des    = "Сумма реализ. товара в  ценах док. без налогов минус сумма в учетных ценах без налогов (нац.валюта)"
      171             criterion-analysis.cral-status = 0
      172             .
      173     create criterion-analysis.
      174           assign
      175             criterion-analysis.cral-id     = 9
      176             criterion-analysis.cral-name   = "Прибыль в баз.валюте"
      177             criterion-analysis.cral-des    = "Сумма реализ. товара в  ценах док. без налогов минус сумма в учетных ценах без налогов (баз. вал.)"
      178             criterion-analysis.cral-status = 0
      179             .
      180     create criterion-analysis.
      181           assign
      182             criterion-analysis.cral-id     = 10
      183             criterion-analysis.cral-name   = "Прибыль с учетом налогов в нац.валюте"
      184             criterion-analysis.cral-des    = "Сумма реализ. в  ценах док. минус сумма в учетных ценах (нац.валюта)"
      185             criterion-analysis.cral-status = 0
      186             .
      187     create criterion-analysis.
      188           assign
      189             criterion-analysis.cral-id     = 11
      190             criterion-analysis.cral-name   = "Прибыль с учетом налогов в баз.валюте"
      191             criterion-analysis.cral-des    = "Сумма реализ. в  ценах док. минус сумма в учетных ценах (баз. вал.)"
      192             criterion-analysis.cral-status = 0
      193             .
      194     create criterion-analysis.
      195           assign
      196             criterion-analysis.cral-id     = 12
      197             criterion-analysis.cral-name   = "Потенциальная прибыль в нац.валюте"
      198             criterion-analysis.cral-des    = "Сумма реализ. в  тек. прод ценах без налогов минус сумма в учетных ценах без налогов (нац.валюта)"
      199             criterion-analysis.cral-status = 0
      200             .
      201     create criterion-analysis.
      202           assign
      203             criterion-analysis.cral-id     = 13
      204             criterion-analysis.cral-name   = "Потенциальная прибыль в баз.валюте"
      205             criterion-analysis.cral-des    = "Сумма реализ. в  тек. прод. ценах  без налогов минус сумма в учетных ценах без налогов (баз. вал.)"
      206             criterion-analysis.cral-status = 0
      207             .
      208     create criterion-analysis.
      209           assign
      210             criterion-analysis.cral-id     = 14
      211             criterion-analysis.cral-name   = "Потенциальная прибыль с учетом налогов в нац.валюте"
      212             criterion-analysis.cral-des    = "Сумма реализ. товара в тек. прод. ценах  минус сумма в учетных ценах (нац.валюта)"
      213             criterion-analysis.cral-status = 0
      214             .
      215     create criterion-analysis.
      216           assign
      217             criterion-analysis.cral-id     = 15
      218             criterion-analysis.cral-name   = "Потенциальная прибыль с учетом налогов в баз.валюте"
      219             criterion-analysis.cral-des    = "Сумма реализ. товара в тек. прод. ценах  минус сумма в учетных ценах (баз. вал.)"
      220             criterion-analysis.cral-status = 0
      221             .
      222     end.
      223   end procedure.
