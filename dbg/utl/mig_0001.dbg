        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: mig_0001.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/mig_0001.p $":U .
        7   define variable vss-description as character no-undo init "Модификация таблиц раздела Пользователи".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input parameter parparentproc    as widget-handle no-undo .
       63   define input parameter p-parent-handle  as widget-handle no-undo .
       64   define input parameter p-log-handle     as handle no-undo .
       65   define input parameter p-parameter      as character no-undo .
       66   define input parameter p-db-num         as integer   no-undo .
       67   define input parameter p-cli-code       as integer   no-undo .
       68   define input parameter log-file-name   as character  no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   define new global shared variable g#library  as handle no-undo .
      300   define new global shared variable g#library2 as handle no-undo .
      301   run write-log-and-file in p-log-handle (
      302         input 1
      303       , input log-file-name
      304       , input 1
      305       , input substitute ( "Пользователи" )
      306       ).
      307   on write   of ub.user-login                   override do: end .
      308   on delete  of ub.user-login                   override do: end .
      309   on delete  of ub.user-login-action-item       override do: end .
      310   on delete  of ub.user-login-action-item-attr  override do: end .
      311   on delete  of ub.user-login-action-role       override do: end .
      312   on delete  of ub.user-login-action-role-attr  override do: end .
      313   on delete  of ub.user-login-attr              override do: end .
      314   on delete  of ub.user-menu-group              override do: end .
      315   on delete  of ub.user-menu-group-attr         override do: end .
      316   on delete  of ub.action-role                  override do: end .
      317   on delete  of ub.action-role-attr             override do: end .
      318   on delete  of ub.action-role-item             override do: end .
      319   on delete  of ub.action-role-item-attr        override do: end .
      320   on write   of ub.user-login-action-item       override do: end .
      321   on write   of ub.user-login-action-item-attr  override do: end .
      322   on write   of ub.user-login-action-role       override do: end .
      323   on write   of ub.user-login-action-role-attr  override do: end .
      324   on write   of ub.user-login-attr              override do: end .
      325   on write   of ub.user-menu-group              override do: end .
      326   on write   of ub.user-menu-group-attr         override do: end .
      327   on write   of ub.action-role                  override do: end .
      328   on write   of ub.action-role-attr             override do: end .
      329   on write   of ub.action-role-item             override do: end .
      330   on write   of ub.action-role-item-attr        override do: end .
      331   on write   of ub.user-host                    override do: end .
      332   on write   of ub.user-host-attr               override do: end .
      333   on write   of ub.user-obj                     override do: end .
      334   on write   of ub.user-obj-attr                override do: end .
      335     do
      336     on error undo, return error return-value
      337     :
      338       for each ub.user-login exclusive-lock   :
      339            ub.user-login.db-num = 0.
      340       end.
      341       for each ub.user-login-action-item exclusive-lock   where
      342                ub.user-login-action-item.db-num <>  p-db-num
      343       :
      344                delete ub.user-login-action-item.
      345       end.
      346       for each ub.user-login-action-item-attr exclusive-lock   where
      347                ub.user-login-action-item-attr.db-num <> p-db-num
      348       :
      349                 delete ub.user-login-action-item-attr.
      350       end.
      351       for each ub.user-login-action-role exclusive-lock   where
      352                ub.user-login-action-role.db-num <> p-db-num
      353       :
      354                 delete ub.user-login-action-role.
      355       end.
      356       for each ub.user-login-action-role-attr exclusive-lock   where
      357                ub.user-login-action-role-attr.db-num <> p-db-num
      358       :
      359                 delete ub.user-login-action-role-attr.
      360       end.
      361       for each ub.user-login-attr exclusive-lock  where
      362                ub.user-login-attr.db-num <> p-db-num
      363         :
      364                delete ub.user-login-attr .
      365       end.
      366       for each ub.user-menu-group exclusive-lock  where
      367                ub.user-menu-group.db-num <> p-db-num
      368       :
      369           delete ub.user-menu-group.
      370       end.
      371       for each ub.user-menu-group-attr exclusive-lock  where
      372                ub.user-menu-group-attr.db-num <> p-db-num
      373         :
      374           delete ub.user-menu-group-attr.
      375       end.
      376       for each ub.action-role           exclusive-lock  where
      377                ub.action-role.db-num <> p-db-num           :
      378                delete ub.action-role.
      379       end.
      380       for each ub.action-role-attr      exclusive-lock  where
      381                ub.action-role-attr.db-num <> p-db-num      :
      382                delete ub.action-role-attr.
      383       end.
      384       for each ub.action-role-item      exclusive-lock  where
      385                ub.action-role-item.db-num <> p-db-num      :
      386                delete ub.action-role-item.
      387       end.
      388       for each ub.action-role-item-attr exclusive-lock  where
      389                ub.action-role-item-attr.db-num <> p-db-num :
      390                delete ub.action-role-item-attr.
      391       end.
      392       for each ub.user-login-action-item exclusive-lock   where
      393                ub.user-login-action-item.db-num =  p-db-num
      394       :
      395                 ub.user-login-action-item.db-num = 0.
      396       end.
      397       for each ub.user-login-action-item-attr exclusive-lock   where
      398                ub.user-login-action-item-attr.db-num = p-db-num
      399       :
      400                 ub.user-login-action-item-attr.db-num = 0.
      401       end.
      402       for each ub.user-login-action-role exclusive-lock   where
      403                ub.user-login-action-role.db-num = p-db-num
      404       :
      405                 ub.user-login-action-role.db-num = 0.
      406       end.
      407       for each ub.user-login-action-role-attr exclusive-lock   where
      408                ub.user-login-action-role-attr.db-num = p-db-num
      409       :
      410                 ub.user-login-action-role-attr.db-num = 0 .
      411       end.
      412       for each ub.user-login-attr exclusive-lock  where
      413                ub.user-login-attr.db-num = p-db-num
      414         :
      415                ub.user-login-attr.db-num = 0 .
      416       end.
      417       for each ub.user-menu-group exclusive-lock  where
      418                ub.user-menu-group.db-num = p-db-num
      419       :
      420           ub.user-menu-group.db-num = 0.
      421       end.
      422       for each ub.user-menu-group-attr exclusive-lock  where
      423                ub.user-menu-group-attr.db-num = p-db-num
      424         :
      425           ub.user-menu-group-attr.db-num = 0.
      426       end.
      427       for each ub.action-role           exclusive-lock  where
      428                ub.action-role.db-num = p-db-num           :
      429                ub.action-role.db-num            = 0 .
      430       end.
      431       for each ub.action-role-attr      exclusive-lock  where
      432                ub.action-role-attr.db-num = p-db-num      :
      433                ub.action-role-attr.db-num       = 0 .
      434       end.
      435       for each ub.action-role-item      exclusive-lock  where
      436                ub.action-role-item.db-num = p-db-num      :
      437                ub.action-role-item.db-num       = 0 .
      438       end.
      439       for each ub.action-role-item-attr exclusive-lock  where
      440                ub.action-role-item-attr.db-num = p-db-num :
      441                ub.action-role-item-attr.db-num = 0 .
      442       end.
      443       for each ub.user-host exclusive-lock  where
      444                ub.user-host.db-num = p-db-num :
      445                ub.user-host.db-num = 0 .
      446       end.
      447       for each ub.user-host-attr exclusive-lock  where
      448                ub.user-host-attr.db-num = p-db-num :
      449                ub.user-host-attr.db-num = 0 .
      450       end.
      451       for each ub.user-obj exclusive-lock  where
      452                ub.user-obj.db-num = p-db-num :
      453                ub.user-obj.db-num = 0 .
      454       end.
      455       for each ub.user-obj-attr exclusive-lock  where
      456                ub.user-obj-attr.db-num = p-db-num :
      457                ub.user-obj-attr.db-num = 0 .
      458       end.
      459   end.
