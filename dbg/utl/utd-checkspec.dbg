     4058   end.
     4059   function GetLastUTDinPack returns logical
     4060   (input idb-num as integer,
     4061    input idoc-id as integer,
     4062    output odb-num as integer,
     4063    output odoc-id as integer ):
     4064      define buffer buf_utd for utd.
     4065      define buffer     utd for utd.
     4066      find first utd where utd.db-num eq idb-num
     4067                       and utd.doc-id eq idoc-id
     4068      no-lock no-error.
     4069      if available utd
     4070      then do:
     4071         if utd.PackageId eq ""
     4072         then do:
     4073            assign
     4074               odb-num = utd.db-num
     4075               odoc-id = utd.doc-id
     4076            .
     4077            return yes.
     4078         end.
     4079         else do:
     4080            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     4081            if    odb-num eq ?
     4082               or odoc-id eq ?
     4083            then do:
     4084               assign
     4085                  odb-num = utd.db-num
     4086                  odoc-id = utd.doc-id
     4087               .
     4088               return yes.
     4089            end.
     4090            else
     4091               return odoc-id = utd.doc-id.
     4092         end.
     4093      end.
     4094      return ?.
     4095   end.
     4096   function delMark returns logical
     4097   ( buffer utd-marking-lines for utd-marking-lines ):
     4098      define buffer buf_utd-marking-line for utd-marking-lines.
     4099      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4100         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4101                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4102                                           and buf_utd-marking-line.mark      eq marking.mark
     4103         no-lock no-error.
     4104         if available  buf_utd-marking-line
     4105         then do:
     4106            delMark(buffer buf_utd-marking-line).
     4107            delete buf_utd-marking-line.
     4108         end.
     4109      end.
     4110   end.
     4111   function addMark returns logical
     4112   ( buffer utd-marking-lines for utd-marking-lines ):
     4113      define buffer buf_utd-marking-line for utd-marking-lines.
     4114      define buffer par_utd-marking-line for utd-marking-lines.
     4115      define buffer buf_utd for ub.utd .
     4116      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4117         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4118                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4119                                           and buf_utd-marking-line.mark      eq marking.mark
     4120         no-lock no-error.
     4121         if available  buf_utd-marking-line
     4122         then do:
     4123            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     4124            then do:
     4125               find current  buf_utd-marking-line exclusive-lock no-error.
     4126               if available buf_utd-marking-line
     4127               then
     4128                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     4129            end.
     4130         end.
     4131         else do:
     4132            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     4133                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     4134                                         no-error .
     4135            create buf_utd-marking-line.
     4136            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     4137            assign
     4138               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     4139               buf_utd-marking-line.mark      = marking.mark
     4140               buf_utd-marking-line.gds-code  = marking.Gds-code
     4141               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     4142                                               then marking.sts
     4143                                               else
     4144                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     4145                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     4146                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4147                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4148                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4149                                                else marking.sts
     4150            .
     4151            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4152            do:
     4153              for first par_utd-marking-line no-lock where
     4154                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     4155                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     4156                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     4157                    and par_utd-marking-line.mark    = marking.mark-parent
     4158                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4159              :
     4160                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     4161              end.
     4162            end.
     4163         end.
     4164         addMark(buffer buf_utd-marking-line).
     4165      end.
     4166   end.
     4167   function UnLockUTDMarkbuf returns logical
     4168   (buffer old_utd for utd,
     4169    iAll as logical ):
     4170      define variable voldkey    as character no-undo.
     4171         run gen-key-rec (input "utd",
     4172                          input  buffer old_utd:handle,
     4173                          output voldkey).
     4174      for each marking where marking.loc-key eq voldkey
     4175      exclusive-lock:
     4176         if    iAll
     4177            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4178                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     4179         then do:
     4180            marking.loc-key = "".
     4181            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     4182         end.
     4183      end.
     4184   end.
     4185   function UnLockUTDMark returns logical
     4186   (idb-num as integer ,idoc-id as integer ,iall as logical):
     4187      define buffer old_utd for utd.
     4188      find first old_utd where old_utd.db-num eq idb-num
     4189                           and old_utd.db-num eq idoc-id
     4190      no-lock no-error.
     4191      if available old_utd
     4192      then do:
     4193         UnLockUTDMarkbuf(buffer old_utd,iall).
     4194      end.
     4195   end.
     4196   function changSts returns logical
     4197   (idb-num as integer ,
     4198    idoc-id as integer ,
     4199    old_sts_edo as character ,
     4200    new_sts_edo as character  ):
     4201      if     old_sts_edo ne new_sts_edo
     4202         and ( new_sts_edo eq "RevocationAccepted"
     4203              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     4204              )
     4205      then
     4206         UnLockUTDMark(idb-num,idoc-id,yes).
     4207      if     old_sts_edo ne new_sts_edo
     4208         and ( new_sts_edo eq "WithRecipientSignature"
     4209           or  new_sts_edo eq "WithRecipientPartiallySignature"
     4210              )
     4211      then
     4212         UnLockUTDMark(idb-num,idoc-id,no).
     4213   end.
     4214   function SetLockUTDMark returns logical
     4215   (idb-num as integer ,idoc-id as integer ):
     4216      define buffer new_utd for utd.
     4217      define buffer old_utd for utd.
     4218      define variable volddb-num as integer no-undo.
     4219      define variable volddoc-id as integer no-undo.
     4220      define variable voldkey    as character no-undo.
     4221      define variable vnewkey    as character no-undo.
     4222      find first new_utd where new_utd.db-num eq idb-num
     4223                           and new_utd.doc-id eq idoc-id
     4224      no-lock no-error.
     4225      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     4226      then do trans:
     4227         find first old_utd where old_utd.db-num eq volddb-num
     4228                              and old_utd.doc-id eq volddoc-id
     4229         no-lock no-error.
     4230            run gen-key-rec (input "utd",
     4231                             input  buffer new_utd:handle,
     4232                             output vnewkey).
     4233            run gen-key-rec (input "utd",
     4234                             input  buffer old_utd:handle,
     4235                             output voldkey).
     4236         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     4237                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     4238         no-lock:
     4239            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     4240            if available  marking
     4241            then do:
     4242               if    marking.loc-key eq ""
     4243                  or marking.loc-key eq ?
     4244                  or marking.loc-key eq voldkey
     4245               then do:
     4246                  find current marking exclusive-lock no-error.
     4247                  if available marking
     4248                  then do:
     4249                     marking.loc-key = vnewkey.
     4250                     release marking.
     4251                  end.
     4252               end.
     4253               else if marking.loc-key ne vnewkey
     4254               then do:
     4255                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     4256               end.
     4257            end.
     4258         end.
     4259         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     4260      end.
     4261   end.
     4262   define input parameter pDb-num as integer no-undo .
     4263   define input parameter pDoc-id as integer no-undo .
     4264   define buffer buf_utd for ub.utd .
     4265   define buffer buf_utd-attr for ub.utd-attr.
     4266   define buffer buf_utd-lines for ub.utd-lines .
     4267   define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     4268   define buffer buf_marking for ub.marking .
     4269   define buffer buf_marking-childs for ub.marking .
     4270   define buffer buf_contract for ub.contract .
     4271   define buffer buf_utd-err for ub.utd-err .
     4272   define variable v-vattype as character no-undo .
     4273   define variable v-vatpc   as decimal   no-undo .
     4274   define variable v-ok      as logical no-undo .
     4275   define variable v-ok-marks as logical no-undo .
     4276   define variable v-price   as decimal no-undo .
     4277   define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     4278   define variable vRecKey   as character no-undo.
     4279   define variable vMarkUtd   as logical no-undo init no .
     4280   find first buf_utd no-lock where buf_utd.db-num = pDb-num
     4281                                and buf_utd.doc-id = pDoc-id
     4282                                no-error .
     4283   v-ok = true .
     4284   find first buf_contract no-lock where buf_contract.host-code = buf_utd.host-code
     4285                                     and buf_contract.contract-code = buf_utd.contract-code
     4286                                     no-error .
     4287   if not available buf_contract
     4288   then do :
     4289     assign v-ok = false .
     4290   end .
     4291   for first buf_contract no-lock where buf_contract.host-code = buf_utd.host-code
     4292                                    and buf_contract.contract-code = buf_utd.contract-code
     4293                                    :
     4294     if buf_contract.contract-date-end < buf_utd.DocumentDate
     4295     then do :
     4296       assign v-ok = false .
     4297       AddUtdErr(buf_utd.db-num,
     4298                 buf_utd.doc-id,
     4299                 buffer buf_contract:handle,
     4300                 "CheckMOTP",
     4301                 "ContrDate",
     4302                 (buf_contract.contract-name + chr(4) + string(buf_contract.contract-date-end)) ) .
     4303     end .
     4304     else do :
     4305       ClearUtdErrTypeCode(buf_utd.db-num,buf_utd.doc-id,"CheckMOTP","ContrDate").
     4306     end .
     4307   end .
     4308   CheckGds (buf_utd.db-num,buf_utd.doc-id,buf_utd.obj-type,buf_utd.obj-code,"CheckGds").
     4309   CheckQnty(buf_utd.db-num, buf_utd.doc-id, "CheckQnty").
     4310   if v-ok
     4311   then do :
     4312     ClearUtdErr(buf_utd.db-num,buf_utd.doc-id,"CheckСontract").
     4313     ClearUtdErrTypeCode(buf_utd.db-num,buf_utd.doc-id,"CheckMOTP","SpecifErr").
     4314     objKeyRec = new ibs.th.gbl.keyrec().
     4315     lines_ :
     4316     for each buf_utd-lines no-lock where buf_utd-lines.db-num = pDb-num
     4317                                      and buf_utd-lines.doc-id = pDoc-id
     4318                                      :
     4319       vMarkUtd = CheckMarkUtdLine(buf_utd-lines.db-num,
     4320                                   buf_utd-lines.doc-id,
     4321                                   buf_utd-lines.LineNum).
     4322       objKeyRec:GenKeyRec ( input "utd-lines"
     4323                            ,input buffer buf_utd-lines:handle
     4324                            ,output vRecKey).
     4325       if can-find (first buf_utd-err  where buf_utd-err.db-num = buf_utd.db-num
     4326                                         and buf_utd-err.doc-id    = buf_utd.doc-id
     4327                                         and buf_utd-err.CheckType = "LoadUtd"
     4328                                         and buf_utd-err.reckey    =  vRecKey)
     4329       then next lines_ .
     4330       if vMarkUtd
     4331       then do :
     4332         v-ok-marks = true .
     4333         marks_ :
     4334         for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num   = buf_utd-lines.db-num
     4335                                                  and buf_utd-marking-lines.doc-id   = buf_utd-lines.doc-id
     4336                                                  and buf_utd-marking-lines.LineNum  = buf_utd-lines.LineNum,
     4337         first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark :
     4338           if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4339           then do :
     4340             v-ok-marks = false .
     4341             leave marks_ .
     4342           end .
     4343         end .
     4344         if     v-ok-marks
     4345            and available buf_utd-marking-lines
     4346         then next lines_ .
     4347       end .
     4348       if buf_utd-lines.TaxRate <= 0
     4349       then do :
     4350         assign
     4351           v-vattype = "без"
     4352           v-vatpc = 0
     4353         .
     4354       end .
     4355       else do :
     4356         assign
     4357           v-vattype = "в т. ч."
     4358           v-vatpc = buf_utd-lines.TaxRate
     4359         .
     4360       end .
     4361       assign v-price = buf_utd-lines.total / buf_utd-lines.Quantity .
     4362   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_ckcntspc in g#lib-trn3
     4363   ( input buf_utd.host-code
     4364    ,input buf_utd.contract-code
     4365    ,input buf_utd-lines.gds-code
     4366    ,input v-price
     4367    ,input v-vattype
     4368    ,input v-vatpc
     4369   ) no-error .
     4370       if error-status :error then
     4371       do:
     4372         assign v-ok = false .
     4373         AddUtdErr(buf_utd.db-num,
     4374                   buf_utd.doc-id,
     4375                   buffer buf_utd-lines:handle,
     4376                   "CheckСontract",
     4377                   "SpecifErr",
     4378                   (string(buf_utd-lines.linenum) + chr(4) + error-status :get-message(1) + chr(4) + return-value)).
     4379         if vMarkUtd
     4380         then do :
     4381           for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num   = buf_utd-lines.db-num
     4382                                                    and buf_utd-marking-lines.doc-id   = buf_utd-lines.doc-id
     4383                                                    and buf_utd-marking-lines.LineNum  = buf_utd-lines.LineNum,
     4384           first buf_marking exclusive-lock where buf_marking.mark = buf_utd-marking-lines.mark :
     4385             assign
     4386               buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     4387             .
     4388           end .
     4389         end .
     4390       end.
     4391       else do :
     4392         if vMarkUtd
     4393         then do :
     4394           for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num   = buf_utd-lines.db-num
     4395                                                    and buf_utd-marking-lines.doc-id   = buf_utd-lines.doc-id
     4396                                                    and buf_utd-marking-lines.LineNum  = buf_utd-lines.LineNum,
     4397           first buf_marking exclusive-lock where buf_marking.mark = buf_utd-marking-lines.mark :
     4398              objKeyRec:GenKeyRec ( input "utd-marking-lines"
     4399                                   ,input buffer buf_utd-marking-lines:handle
     4400                                   ,output vRecKey).
     4401              block-utd-err:
     4402              for each buf_utd-err  where buf_utd-err.db-num = buf_utd.db-num
     4403                                      and buf_utd-err.doc-id    = buf_utd.doc-id
     4404                                      and buf_utd-err.CheckType = "CheckMOTP"
     4405                                      and buf_utd-err.CodeErr   = "MotpMarkErr"
     4406                                      and buf_utd-err.reckey    =  vRecKey
     4407              no-lock:
     4408                 leave block-utd-err.
     4409              end .
     4410              assign
     4411                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:DeliveryControl:KeyIntDB when not available buf_utd-err
     4412              .
     4413           end .
     4414         end .
     4415       end .
     4416     end .
     4417     delete object objKeyRec.
     4418   end .
     4419   if v-ok
     4420   then do:
     4421      if      GetErrForUtdstr(buf_utd.db-num,buf_utd.doc-id,"CheckGds") ne ""
     4422      then
     4423         v-ok = no.
     4424      else if GetErrForUtdstr(buf_utd.db-num,buf_utd.doc-id,"CheckQnty") ne ""
     4425      then
     4426         v-ok = no.
     4427   end.
     4428   find current buf_utd exclusive-lock .
     4429   if not v-ok
     4430   then do :
     4431     assign
     4432       buf_utd.sts = objSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4433     .
     4434   end .
     4435   else do :
     4436      if CheckErrForUtd(pDb-num,pDoc-id)
     4437      then do:
     4438         buf_utd.sts = objSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB.
     4439      end.
     4440      else do:
     4441         for each buf_utd-lines no-lock where buf_utd-lines.db-num = pDb-num
     4442                                          and buf_utd-lines.doc-id = pDoc-id
     4443         :
     4444            for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num eq buf_utd.db-num
     4445                                                and buf_utd-marking-lines.doc-id      eq buf_utd.doc-id
     4446                                                and buf_utd-marking-lines.LineNum     eq buf_utd-lines.LineNum,
     4447            first buf_marking exclusive-lock where buf_marking.mark = buf_utd-marking-lines.mark :
     4448               if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then next .
     4449               assign
     4450                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:DeliveryControl:KeyIntDB
     4451               .
     4452            end.
     4453         end .
     4454         buf_utd.sts = objSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB.
     4455      end.
     4456   end .
     4457   CheckMarking(buf_utd.db-num,buf_utd.doc-id,"CheckСontract").
     4458   CheckMarkUtd-28rel(buf_utd.db-num,buf_utd.doc-id).
     4459   release buf_utd no-error .
