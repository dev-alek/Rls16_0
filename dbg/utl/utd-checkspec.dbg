     4034         if utd.PackageId eq ""
     4035         then do:
     4036            assign
     4037               odb-num = utd.db-num
     4038               odoc-id = utd.doc-id
     4039            .
     4040            return yes.
     4041         end.
     4042         else do:
     4043            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4044            if    odb-num eq ?
     4045               or odoc-id eq ?
     4046            then do:
     4047               assign
     4048                  odb-num = utd.db-num
     4049                  odoc-id = utd.doc-id
     4050               .
     4051               return yes.
     4052            end.
     4053            else
     4054               return odoc-id = utd.doc-id.
     4055         end.
     4056      end.
