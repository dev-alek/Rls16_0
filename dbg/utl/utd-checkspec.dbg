        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 1eba0946c2d7, 3078, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        4   define variable vss-date        as character no-undo init "$Date: Пт авг 05 19:16:25 2022 +0300 $":U .
        5   define variable vss-Workfile    as character no-undo init "$Workfile: utd-checkSpec.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/utd-checkSpec.p $":U .
        7   define variable vss-description as character no-undo init "Проверка по спецификации линий УПД" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define new global shared variable g#lib-trn  as handle no-undo .
       78   define new global shared variable g#lib-trn2 as handle no-undo .
       79   define new global shared variable g#lib-trn3 as handle no-undo .
       80   define new global shared variable g#lib-trn4 as handle no-undo .
       81   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure gen-key-rec :
       83     define input  parameter p-tbl-name    as character no-undo.
       84     define input  parameter p-bh_tbl-name as handle    no-undo.
       85     define output parameter p-key-rec     as character no-undo.
       86     do
       87     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       88     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       89     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       90     :
       91       define variable fh               as handle    no-undo .
       92       define variable v-ok             as logical   no-undo .
       93       define variable v-inform         as character no-undo .
       94       define variable v-ind            as integer   no-undo .
       95       define variable v-idx-field-qnty as integer   no-undo .
       96       if p-tbl-name = ?
       97         or p-tbl-name = "":U
       98       then do:
       99         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      100       end.
      101       if not p-bh_tbl-name:available then do:
      102         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      103       end.
      104       assign
      105         p-key-rec = p-tbl-name
      106         v-inform  = p-bh_tbl-name:index-information(1)
      107         v-ind     = 2
      108       .
      109       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      110       on error undo, return error
      111       :
      112         assign
      113           v-inform = p-bh_tbl-name:index-information( v-ind )
      114           v-ind    = v-ind + 1
      115         .
      116       end.
      117       if v-inform = ?
      118         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      119         or entry( 3, v-inform, ",":U ) <> "1":U
      120       then do:
      121         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      122       end.
      123       else do:
      124         assign
      125           v-idx-field-qnty = num-entries( v-inform ) - 4
      126         .
      127         if v-idx-field-qnty < 2 then do:
      128           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      129         end.
      130         do v-ind = 1 to v-idx-field-qnty by 2
      131         on error undo, return error
      132         :
      133           assign
      134             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      135             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      136           .
      137         end.
      138       end.
      139       if p-key-rec = ? then do:
      140         assign
      141           p-key-rec = "":U
      142         .
      143         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      144       end.
      145     end.
      146     return.
      147   end procedure.
      148   procedure gen-where-keyr-tab :
      149     define input  parameter i-tableSerach as character no-undo.
      150     define input  parameter i-tablekey   as character  no-undo.
      151     define input  parameter p-key-rec    as character  no-undo.
      152     define input  parameter p-key-handle as handle     no-undo .
      153     define input  parameter p-db-name    as character  no-undo .
      154     define input  parameter p-tt-handle  as handle     no-undo .
      155     define output parameter o-Where      as character  no-undo.
      156     do
      157     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      158     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      159     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      160     :
      161       define variable v-full-tbl-name  as character no-undo .
      162       define variable bh_tbl-name      as handle    no-undo .
      163       define variable fh_key           as handle    no-undo .
      164       define variable fh_search        as handle    no-undo .
      165       define variable v-field-num      as integer   no-undo .
      166       define variable v-count-fld      as integer   no-undo .
      167       define variable v-inform         as character no-undo .
      168       define variable v-ind            as integer   no-undo .
      169       define variable v-idx-field-qnty as integer   no-undo .
      170       define variable v-field-name     as character no-undo .
      171       define variable v-field-val      as character no-undo .
      172       define variable v-word-link      as character no-undo .
      173       define variable vTable           as character no-undo.
      174       define variable bh_tbl-key       as handle    no-undo .
      175       assign
      176         p-key-rec = trim( p-key-rec )
      177       .
      178       if p-key-handle <> ? then do:
      179         if not valid-handle(p-key-handle)
      180            or p-key-handle:type <> "buffer"
      181         then do:
      182           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      183         end.
      184         if num-entries( p-key-rec, chr(3) ) > 1
      185           or p-key-rec = ?
      186           or p-key-rec = "":U
      187         then do:
      188           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      189         end.
      190       end.
      191       else do:
      192         if p-key-rec = ?
      193           or p-key-rec = "":U
      194         then do:
      195           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      196         end.
      197       end.
      198       assign
      199         vTable = entry( 1 , p-key-rec, chr(3) )
      200       .
      201       if p-tt-handle <> ?
      202         and ( not valid-handle(p-tt-handle)
      203               or p-tt-handle:type <> "buffer"
      204             )
      205       then do:
      206         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      207       end.
      208       if p-tt-handle = ? then do:
      209         assign
      210           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      211         .
      212         create buffer bh_tbl-name for table v-full-tbl-name .
      213       end.
      214       else do:
      215         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      216       end.
      217       assign
      218         v-inform = bh_tbl-name:index-information(1)
      219         v-ind    = 2
      220       .
      221       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      222       on error undo, return error
      223       :
      224         assign
      225           v-inform = bh_tbl-name:index-information( v-ind )
      226           v-ind    = v-ind + 1
      227         .
      228       end.
      229       if v-inform = ?
      230         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      231         or entry( 3, v-inform, ",":U ) <> "1":U
      232       then do:
      233         delete object bh_tbl-name no-error.
      234         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      235       end.
      236       assign
      237         v-idx-field-qnty = num-entries( v-inform ) - 4
      238       .
      239       if v-idx-field-qnty < 2 then do:
      240         delete object bh_tbl-name no-error.
      241         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      242       end.
      243       assign
      244         o-where     = "where":U
      245         v-word-link = "":U
      246         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      247         v-count-fld = 0
      248       .
      249       if i-tablekey ne "" and i-tablekey ne ?
      250       then do:
      251         assign
      252           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      253         .
      254         create buffer bh_tbl-key for table v-full-tbl-name .
      255       end.
      256       if i-tableSerach ne "" and i-tableSerach ne ?
      257       then do:
      258         delete object bh_tbl-name no-error.
      259         assign
      260           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      261         .
      262         create buffer bh_tbl-name for table v-full-tbl-name .
      263       end.
      264       block_where:
      265       do v-ind = 1 to v-idx-field-qnty by 2
      266       on error undo, return error
      267       :
      268         assign
      269           v-count-fld = v-count-fld + 1
      270         .
      271         if p-key-handle = ?
      272           and v-count-fld > v-field-num
      273         then do:
      274           leave block_where.
      275         end.
      276         define variable VfieldKeyTable as handle no-undo.
      277         assign
      278           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      279           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      280         .
      281         if     bh_tbl-key ne ?
      282         then do:
      283            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      284            if VfieldKeyTable eq ?
      285            then next block_where.
      286         end.
      287         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      288         then
      289            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      290         else
      291            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      292         if p-key-handle = ? then do:
      293           assign
      294             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      295           .
      296         end.
      297         else do:
      298           assign
      299             fh_key = p-key-handle:buffer-field( v-field-name )
      300           .
      301           if fh_key = ?
      302             or not valid-handle( fh_key )
      303           then do:
      304             delete object bh_tbl-name.
      305             if     bh_tbl-key ne ?
      306             then
      307                delete object bh_tbl-key.
      308             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      309           end.
      310           assign
      311             v-field-val = fh_key:buffer-value
      312           .
      313         end.
      314         if fh_search:data-type ="character":U then do:
      315           assign
      316             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      317             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      318             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      319             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      320             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      321             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      322             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      323             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      324             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      325             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      326             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      327             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      328             v-field-val = substitute( '"&1"', v-field-val )
      329           .
      330         end.
      331         assign
      332           o-where = substitute( "&1 &2", o-where, v-field-val )
      333         .
      334         if v-word-link = "":U then do:
      335           assign
      336             v-word-link = "and":U
      337           .
      338         end.
      339       end.
      340       delete object bh_tbl-name.
      341       if     bh_tbl-key ne ?
      342       then
      343          delete object bh_tbl-key.
      344       if p-key-handle = ?
      345         and v-count-fld <> v-field-num
      346       then do:
      347         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      348       end.
      349     end.
      350   end procedure.
      351   procedure gen-hn-keyr-tab :
      352     define input  parameter i-tableSerach as character no-undo.
      353     define input  parameter i-tablekey   as character no-undo.
      354     define input  parameter p-key-rec    as character no-undo.
      355     define input  parameter p-key-handle as handle    no-undo .
      356     define input  parameter p-db-name    as character no-undo .
      357     define input  parameter p-tt-handle  as handle    no-undo .
      358     define input  parameter p-stts-lock  as integer   no-undo .
      359     define output parameter o-hn         as handle    no-undo.
      360     define variable v-full-tbl-name as character no-undo.
      361     define variable v-where         as character no-undo.
      362     define variable bh_tbl-name     as handle    no-undo.
      363     define variable vTable          as character no-undo.
      364     do
      365     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      366     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      367     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      368         run gen-where-keyr-tab(i-tableSerach,
      369                                i-tablekey,
      370                                p-key-rec,
      371                                p-key-handle,
      372                                p-db-name,
      373                                p-tt-handle,
      374                                output v-where).
      375         if i-tableSerach ne "" and i-tableSerach ne ?
      376         then do:
      377            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      378            create buffer bh_tbl-name for table v-full-tbl-name .
      379         end.
      380         else do:
      381            if p-tt-handle = ? then do:
      382               assign
      383                  vTable = entry( 1 , p-key-rec, chr(3) )
      384               .
      385               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      386               create buffer bh_tbl-name for table v-full-tbl-name .
      387            end.
      388            else do:
      389               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      390            end.
      391         end.
      392         if p-tt-handle = ? then do:
      393            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      394         end.
      395         else do:
      396            bh_tbl-name:find-first( v-where ) no-error .
      397         end.
      398         o-hn = bh_tbl-name.
      399      end.
      400   end procedure.
      401   procedure gen-hn-keyr :
      402     define input  parameter p-key-rec    as character no-undo.
      403     define input  parameter p-key-handle as handle    no-undo .
      404     define input  parameter p-db-name    as character no-undo .
      405     define input  parameter p-tt-handle  as handle    no-undo .
      406     define input  parameter p-stts-lock  as integer   no-undo .
      407     define output parameter o-hn         as handle    no-undo.
      408     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      409   end.
      410   procedure gen-row-keyr :
      411     define input  parameter p-key-rec    as character no-undo.
      412     define input  parameter p-key-handle as handle    no-undo .
      413     define input  parameter p-db-name    as character no-undo .
      414     define input  parameter p-tt-handle  as handle    no-undo .
      415     define input  parameter p-stts-lock  as integer   no-undo .
      416     define output parameter p-tbl-row    as rowid     no-undo.
      417     define output parameter p-tbl-name   as character no-undo.
      418     define variable vHn as handle no-undo.
      419       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      420       p-tbl-row = if vHn:available then vHn:rowid else ?.
      421       p-tbl-name =  vHn:table.
      422       delete object vHn no-error.
      423     if p-tbl-row = ? then do:
      424       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      425     end.
      426     else do:
      427       return.
      428     end.
      429   end procedure.
      430   procedure gen-key-fv :
      431     define input  parameter p-key-rec    as character no-undo .
      432     define output parameter p-field-list as character no-undo .
      433     define output parameter p-value-list as character no-undo.
      434     do
      435     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      436     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      437     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      438     :
      439       define variable v-full-tbl-name  as character no-undo .
      440       define variable bh_tbl-name      as handle    no-undo .
      441       define variable v-tbl-name       as character no-undo .
      442       define variable v-field-num      as integer   no-undo .
      443       define variable v-count-fld      as integer   no-undo .
      444       define variable v-inform         as character no-undo .
      445       define variable v-ind            as integer   no-undo .
      446       define variable v-idx-field-qnty as integer   no-undo .
      447       define variable v-delim-key      as character no-undo .
      448       if p-key-rec = ?
      449         or p-key-rec = "":U
      450       then do:
      451         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      452       end.
      453       assign
      454         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      455         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      456       .
      457       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      458       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      459       assign
      460         v-inform = bh_tbl-name:index-information(1)
      461         v-ind    = 2
      462       .
      463       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      464       on error undo, return error
      465       :
      466         assign
      467           v-inform = bh_tbl-name:index-information( v-ind )
      468           v-ind    = v-ind + 1
      469         .
      470       end.
      471       if v-inform = ?
      472         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      473         or entry( 3, v-inform, ",":U ) <> "1":U
      474       then do:
      475         delete object bh_tbl-name no-error.
      476         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      477       end.
      478       assign
      479         v-idx-field-qnty = num-entries( v-inform ) - 4
      480       .
      481       if v-idx-field-qnty < 2 then do:
      482         delete object bh_tbl-name no-error.
      483         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      484       end.
      485       assign
      486         p-field-list = "":U
      487         p-value-list = "":U
      488         v-delim-key  = "":U
      489         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      490         v-count-fld  = 0
      491       .
      492       block_where:
      493       do v-ind = 1 to v-idx-field-qnty by 2
      494       on error undo, return error
      495       :
      496         assign
      497           v-count-fld = v-count-fld + 1
      498         .
      499         if v-count-fld > v-field-num then do:
      500           leave block_where.
      501         end.
      502         assign
      503           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      504           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      505         .
      506         if v-ind = 1 then do:
      507           assign
      508             v-delim-key = chr(3)
      509           .
      510         end.
      511       end.
      512       delete object bh_tbl-name.
      513       if v-count-fld <> v-field-num then do:
      514         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      515       end.
      516     end.
      517   end procedure.
      518   procedure gen-key-field :
      519     define input  parameter p-table      as character no-undo .
      520     define output parameter p-field-list as character no-undo .
      521     do
      522     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      523     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      524     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      525     :
      526       define variable v-full-tbl-name  as character no-undo .
      527       define variable bh_tbl-name      as handle    no-undo .
      528       define variable v-tbl-name       as character no-undo .
      529       define variable v-field-num      as integer   no-undo .
      530       define variable v-count-fld      as integer   no-undo .
      531       define variable v-inform         as character no-undo .
      532       define variable v-ind            as integer   no-undo .
      533       define variable v-idx-field-qnty as integer   no-undo .
      534       define variable v-delim-key      as character no-undo .
      535       if p-table = ?
      536         or p-table = "":U
      537       then do:
      538         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      539       end.
      540       assign
      541         v-tbl-name      = p-table
      542         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      543       .
      544       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      545       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      546       assign
      547         v-inform = bh_tbl-name:index-information(1)
      548         v-ind    = 2
      549       .
      550       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      551       on error undo, return error
      552       :
      553         assign
      554           v-inform = bh_tbl-name:index-information( v-ind )
      555           v-ind    = v-ind + 1
      556         .
      557       end.
      558       if v-inform = ?
      559         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      560         or entry( 3, v-inform, ",":U ) <> "1":U
      561       then do:
      562         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      563       end.
      564       assign
      565         v-idx-field-qnty = num-entries( v-inform ) - 4
      566       .
      567       if v-idx-field-qnty < 2 then do:
      568         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      569       end.
      570       assign
      571         p-field-list = "":U
      572         v-delim-key  = "":U
      573         v-count-fld  = 0
      574       .
      575       block_where:
      576       do v-ind = 1 to v-idx-field-qnty by 2
      577       on error undo, return error
      578       :
      579         assign
      580           v-count-fld = v-count-fld + 1
      581         .
      582         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      583         if v-ind = 1 then do:
      584           assign
      585             v-delim-key = chr(3)
      586           .
      587         end.
      588       end.
      589       delete object bh_tbl-name.
      590     end.
      591   end procedure.
      592   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      593   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      594   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   define temp-table tt-utd-mark no-undo like utd-marking-lines
      596     field side as character.
      597   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   define variable vss-include-info3 as character format "X(65)" no-undo
      599   initial "@(#)$Workfile$ $Revision$".
      600   procedure xmlchar-test :
      601   define input parameter p-in-string          as character        no-undo.
      602   define output parameter p-out-string-enc    as character        no-undo.
      603   define output parameter p-out-string-dec    as character        no-undo.
      604   do
      605   on error undo, return error
      606   :
      607          run xmlchar-encode in this-procedure
      608       (
      609             input p-in-string
      610           , output p-out-string-enc
      611       ).
      612          run xmlchar-decode in this-procedure
      613       (
      614             input p-out-string-enc
      615           , output p-out-string-dec
      616       ).
      617   end.
      618   end .
      619   procedure xmlchar-encode :
      620   define input parameter p-in-string      as character        no-undo.
      621   define output parameter p-out-string    as character        no-undo.
      622       define variable v-position      as integer      no-undo.
      623       define variable v-current-char  as character    no-undo.
      624   do
      625   on error undo, return error
      626   :
      627       assign
      628           p-out-string = "":U
      629       .
      630       case p-in-string
      631       :
      632           when ?
      633           then do:
      634               assign
      635                   p-out-string = "?":U
      636               .
      637           end.
      638           when "?":U
      639           then do:
      640               assign
      641                   p-out-string = "&#63;":U
      642               .
      643           end.
      644           otherwise do:
      645               do v-position = 1 to length( p-in-string )
      646               :
      647                   assign
      648                       v-current-char = substring( p-in-string, v-position, 1 )
      649                   .
      650                   case v-current-char
      651                   :
      652                       when "&":U
      653                       then do:
      654                           assign
      655                               p-out-string = p-out-string + "&amp;":U
      656                           .
      657                       end.
      658                       when ">":U
      659                       then do:
      660                           assign
      661                               p-out-string = p-out-string + "&gt;":U
      662                           .
      663                       end.
      664                       when "<":U
      665                       then do:
      666                           assign
      667                               p-out-string = p-out-string + "&lt;":U
      668                           .
      669                       end.
      670                       when "'":U
      671                       then do:
      672                           assign
      673                               p-out-string = p-out-string + "&apos;":U
      674                           .
      675                       end.
      676                       when '"':U
      677                       then do:
      678                           assign
      679                               p-out-string = p-out-string + "&quot;":U
      680                           .
      681                       end.
      682                       when chr(1)
      683                       then do:
      684                           assign
      685                               p-out-string = p-out-string + "":U
      686                           .
      687                       end.
      688                       when chr(2)
      689                       then do:
      690                           assign
      691                               p-out-string = p-out-string + "":U
      692                           .
      693                       end.
      694                       when chr(3)
      695                       then do:
      696                           assign
      697                               p-out-string = p-out-string + "":U
      698                           .
      699                       end.
      700                       when chr(4)
      701                       then do:
      702                           assign
      703                               p-out-string = p-out-string + "":U
      704                           .
      705                       end.
      706                       when chr(5)
      707                       then do:
      708                           assign
      709                               p-out-string = p-out-string + "":U
      710                           .
      711                       end.
      712                       when chr(6)
      713                       then do:
      714                           assign
      715                               p-out-string = p-out-string + "":U
      716                           .
      717                       end.
      718                       when chr(7)
      719                       then do:
      720                           assign
      721                               p-out-string = p-out-string + "":U
      722                           .
      723                       end.
      724                       when chr(8)
      725                       then do:
      726                           assign
      727                               p-out-string = p-out-string + "":U
      728                           .
      729                       end.
      730                       when chr(9)
      731                       then do:
      732                           assign
      733                               p-out-string = p-out-string + "":U
      734                           .
      735                       end.
      736                       when chr(29)
      737                       then do:
      738                           assign
      739                               p-out-string = p-out-string + "":U
      740                           .
      741                       end.
      742                       when chr(10)
      743                       then do:
      744                           assign
      745                               p-out-string = p-out-string + "&#10;":U
      746                           .
      747                       end.
      748                       when chr(13)
      749                       then do:
      750                           assign
      751                               p-out-string = p-out-string + "&#13;":U
      752                           .
      753                       end.
      754                       otherwise do:
      755                           assign
      756                               p-out-string = p-out-string + v-current-char
      757                           .
      758                       end.
      759                   end case.
      760               end.
      761           end.
      762       end case.
      763   end.
      764   end .
      765   procedure xmlchar-encode-1c :
      766   define input parameter p-in-string      as character        no-undo.
      767   define output parameter p-out-string    as character        no-undo.
      768       define variable v-position      as integer      no-undo.
      769       define variable v-current-char  as character    no-undo.
      770   do
      771   on error undo, return error
      772   :
      773       assign
      774           p-out-string = "":U
      775       .
      776       case p-in-string
      777       :
      778           when ?
      779           then do:
      780               assign
      781                   p-out-string = "?":U
      782               .
      783           end.
      784           otherwise do:
      785               do v-position = 1 to length( p-in-string )
      786               :
      787                   assign
      788                       v-current-char = substring( p-in-string, v-position, 1 )
      789                   .
      790                   case v-current-char
      791                   :
      792                       when chr(1)
      793                       then do:
      794                           assign
      795                               p-out-string = p-out-string + " ":U
      796                           .
      797                       end.
      798                       when chr(2)
      799                       then do:
      800                           assign
      801                               p-out-string = p-out-string + " ":U
      802                           .
      803                       end.
      804                       when chr(3)
      805                       then do:
      806                           assign
      807                               p-out-string = p-out-string + " ":U
      808                           .
      809                       end.
      810                       when chr(4)
      811                       then do:
      812                           assign
      813                               p-out-string = p-out-string + " ":U
      814                           .
      815                       end.
      816                       when chr(5)
      817                       then do:
      818                           assign
      819                               p-out-string = p-out-string + " ":U
      820                           .
      821                       end.
      822                       when chr(6)
      823                       then do:
      824                           assign
      825                               p-out-string = p-out-string + " ":U
      826                           .
      827                       end.
      828                       when chr(7)
      829                       then do:
      830                           assign
      831                               p-out-string = p-out-string + " ":U
      832                           .
      833                       end.
      834                       when chr(8)
      835                       then do:
      836                           assign
      837                               p-out-string = p-out-string + " ":U
      838                           .
      839                       end.
      840                       when chr(9)
      841                       then do:
      842                           assign
      843                               p-out-string = p-out-string + " ":U
      844                           .
      845                       end.
      846                       when chr(29)
      847                       then do:
      848                           assign
      849                               p-out-string = p-out-string + " ":U
      850                           .
      851                       end.
      852                       when chr(10)
      853                       then do:
      854                           assign
      855                               p-out-string = p-out-string + " ":U
      856                           .
      857                       end.
      858                       when chr(13)
      859                       then do:
      860                           assign
      861                               p-out-string = p-out-string + " ":U
      862                           .
      863                       end.
      864                       otherwise do:
      865                           assign
      866                               p-out-string = p-out-string + v-current-char
      867                           .
      868                       end.
      869                   end case.
      870               end.
      871           end.
      872       end case.
      873   end.
      874   end .
      875   procedure xmlchar-decode :
      876   define input parameter p-in-string      as character        no-undo.
      877   define output parameter p-out-string    as character        no-undo.
      878       define variable v-position      as integer      no-undo.
      879       define variable v-last-position as integer      no-undo.
      880       define variable v-temp-integer  as integer      no-undo.
      881       define variable v-current-char  as character    no-undo.
      882       define variable v-next-char     as character    no-undo.
      883       define variable v-success       as logical      no-undo.
      884   do
      885   on error undo, return error
      886   :
      887       assign
      888           p-out-string = "":U
      889           v-position   = 0
      890       .
      891       replace-cycle:
      892       do while yes
      893       on error undo, return error
      894       :
      895           assign
      896               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      897           .
      898           if v-last-position <= v-position
      899           then do:
      900               if v-position = 0
      901               then do:
      902                   assign
      903                       p-out-string = p-in-string
      904                   .
      905               end.
      906               else do:
      907                   assign
      908                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      909                   .
      910               end.
      911               leave replace-cycle.
      912           end.
      913           else do:
      914               assign
      915                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      916                   v-position      = v-last-position
      917                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      918               .
      919               if v-current-char = "#":U
      920               then do:
      921                   assign
      922                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      923                   .
      924                   if v-last-position > 0
      925                   then do:
      926                       run xmlchar-read-integer in this-procedure
      927                        (
      928                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      929                           , output v-temp-integer
      930                           , output v-success
      931                       ).
      932                       if v-success = yes
      933                       and v-temp-integer >= 1
      934                       and v-temp-integer <= 255
      935                       then do:
      936                           assign
      937                               p-out-string = p-out-string + chr( v-temp-integer )
      938                               v-position   = v-last-position + 1
      939                           .
      940                       end.
      941                       else do:
      942                           assign
      943                               p-out-string = p-out-string + "&":U
      944                               v-position   = v-position   + 1
      945                           .
      946                       end.
      947                   end.
      948                   else do:
      949                       assign
      950                           p-out-string = p-out-string + "&":U
      951                           v-position   = v-position   + 1
      952                       .
      953                   end.
      954               end.
      955               else do:
      956                   case substring( p-in-string, v-position + 1, 3 )
      957                   :
      958                       when "lt;":U
      959                       then do:
      960                           assign
      961                               p-out-string = p-out-string + "<":U
      962                               v-position   = v-position   + 3
      963                           .
      964                       end.
      965                       when "gt;":U
      966                       then do:
      967                           assign
      968                               p-out-string = p-out-string + ">":U
      969                               v-position   = v-position   + 3
      970                           .
      971                       end.
      972                       otherwise do:
      973                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      974                           then do:
      975                               assign
      976                                   p-out-string = p-out-string + "&":U
      977                                   v-position   = v-position   + 4
      978                               .
      979                           end.
      980                           else do:
      981                               case substring( p-in-string, v-position + 1, 5 )
      982                               :
      983                                   when "quot;":U
      984                                   then do:
      985                                       assign
      986                                           p-out-string = p-out-string + '"':U
      987                                           v-position   = v-position   + 5
      988                                       .
      989                                   end.
      990                                   when "apos;":U
      991                                   then do:
      992                                       assign
      993                                           p-out-string = p-out-string + "'":U
      994                                           v-position   = v-position   + 5
      995                                       .
      996                                   end.
      997                                   otherwise do:
      998                                       assign
      999                                           p-out-string = p-out-string + "&":U
     1000                                       .
     1001                                   end.
     1002                               end case.
     1003                           end.
     1004                       end.
     1005                   end case.
     1006               end.
     1007           end.
     1008       end.
     1009   end.
     1010   end .
     1011   procedure xmlchar-read-integer :
     1012   define input parameter p-input-string      as character        no-undo.
     1013   define output parameter p-output-integer   as integer          no-undo.
     1014   define output parameter p-success       as logical          no-undo.
     1015   do
     1016   on error undo, return error
     1017   :
     1018       assign
     1019           p-output-integer = integer( p-input-string )
     1020       no-error.
     1021       if error-status :error
     1022       then do:
     1023           assign
     1024               p-success           = no
     1025               p-output-integer    = 0
     1026           .
     1027       end.
     1028       else do:
     1029           assign
     1030               p-success           = yes
     1031           .
     1032       end.
     1033   end.
     1034   end.
     1035   define new global shared variable g#attr-lib  as handle no-undo .
     1036   define variable v-attr-lib-variable as handle no-undo .
     1037   define variable mMRCCode  as logical    no-undo.
     1038   define variable mTypeMark as character  no-undo.
     1039   function IS-NeedMark returns logical
     1040   ( input ib-code as integer  ,
     1041     input ib-str as character ):
     1042      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1043      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1044                                    and buf_prod-bc-attr.b-str  eq ib-str
     1045                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1046        no-lock no-error.
     1047      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1048   end.
     1049   function repTegforDm return char
     1050   (iDM as char ):
     1051       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1052       define variable vteg as character no-undo.
     1053       define variable oDM as character no-undo.
     1054       define variable vi as integer no-undo.
     1055       oDM = iDm.
     1056       do vi = 1 to num-entries(vTeglist):
     1057          vTeg = entry(vi,vTeglist).
     1058          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1059       end.
     1060       return oDM.
     1061   end.
     1062   function repSpecSimbforDm return char
     1063   (iDM as char ):
     1064       define variable oDM as character no-undo.
     1065     run
     1066       xmlchar-decode(iDM, output oDM).
     1067     return repTegforDm (oDM).
     1068   end.
     1069   function CheckGtin return logical
     1070   (iGtin as char):
     1071      define variable bar_code as character no-undo.
     1072      define variable vGtin as logical no-undo init "yes".
     1073      if length(iGtin) eq 14
     1074      then do:
     1075         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1076         run str/chk-sum.p
     1077          (input-output bar_code ) no-error .
     1078         if iGtin ne  bar_code
     1079         then
     1080            vGtin = no.
     1081      end.
     1082      else
     1083         vGtin = no.
     1084      return vgtin.
     1085   end.
     1086   function repSpecSimbforXlm return char
     1087   (iDM as char ):
     1088       iDM = replace(iDM,chr(29),"").
     1089       return iDM.
     1090   end.
     1091   function getGtinByDM return char
     1092   (IDM as char):
     1093      define variable VTXT as char no-undo.
     1094      define variable vGtin as char no-undo.
     1095      vTXt = IdM.
     1096      vGtin = IDM.
     1097      if    length(vtxt) > 14
     1098      then do:
     1099         if   vtxt begins "(01)"
     1100                or vtxt begins "(02)"
     1101         then
     1102            vGtin = substring(vtxt,5,14).
     1103         else if   (vtxt begins "01"
     1104                or vtxt begins "02" )
     1105                and (   (    substring(iDm,17,2) eq "21"
     1106                         and length(vtxt) >= 21)
     1107                     or substring(iDm,17,2) eq "37"
     1108                     or substring(iDm,17,4) eq "(37)" )
     1109         then do:
     1110            vGtin = substring(vtxt,3,14).
     1111            if not checkGtin(vGtin)
     1112            then
     1113               vGtin = substring(vtxt,1,14).
     1114         end.
     1115         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1116             or length(vtxt) eq 14 + 7 + 4
     1117             or length(vtxt) eq 14 + 7
     1118         then
     1119            vGtin = substring(vtxt,1,14).
     1120      end.
     1121      if not checkGtin(vGtin)
     1122      then
     1123         vGtin = "".
     1124      return vgtin.
     1125   end.
     1126   function getGdsCodeByGtin return int
     1127   (iGtin as char):
     1128      define buffer prod-bc  for ub.prod-bc.
     1129      define buffer bar-code for ub.bar-code.
     1130      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1131      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1132      return if avail bar-code then bar-code.gds-code else ?.
     1133   end.
     1134   function getQntyCodeByGtin return decimal
     1135   (iGtin as char):
     1136      define buffer prod-bc  for ub.prod-bc.
     1137      define buffer bar-code for ub.bar-code.
     1138      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1139      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1140      return if avail bar-code then bar-code.cli-base-rate else ?.
     1141   end.
     1142   function getGdsCodeByDM return int
     1143   (iDm as char):
     1144      define variable vGtin as char no-undo.
     1145      define buffer prod-bc for ub.prod-bc.
     1146      vGtin  = getGtinByDM (IDM ).
     1147      return getGdsCodeByGtin (vGtin).
     1148   end.
     1149   function ChekTypeMarkByGds return logical
     1150   (iGds-code as integer ):
     1151      define buffer goods-attr for ub.goods-attr.
     1152      find first goods-attr where goods-attr.gds-code   = iGds-code
     1153                              and goods-attr.attr-code  = 'mark-type':U
     1154      no-lock no-error.
     1155      if available goods-attr
     1156      then do:
     1157         mTypeMark = goods-attr.attr-value.
     1158         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1159           .
     1160      end.
     1161      else
     1162         return no.
     1163   end.
     1164   function ChekTypeMarkByDm return logical
     1165   (iDM as char ):
     1166      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1167   end.
     1168   function ChekTypeMarkByGtin return logical
     1169   (iGtin as char ):
     1170      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1171   end.
     1172   function GetNextElement return character
     1173     (input iAllTeg        as logical
     1174     ,output oteg          as character
     1175     ,output otegval       as character
     1176     ,input-output pstr    as character
     1177      ):
     1178        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1179        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1180        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1181        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1182        define variable vTeg as character no-undo.
     1183        define variable vLength as integer no-undo.
     1184        define variable vi as integer no-undo.
     1185        define variable vj as integer no-undo.
     1186        define buffer code for ub.code.
     1187        find first code where Code.parent eq "MarkType"
     1188                          and Code.CodeValue   eq mTypeMark
     1189                          no-lock no-error.
     1190        if     available code
     1191           and Code.misc1 ne ""
     1192           and Code.misc1 ne ?
     1193        then do:
     1194           integer (Code.misc1) no-error.
     1195           if not error-status:error
     1196           then
     1197             entry (4,vlistleng) = Code.misc1.
     1198        end.
     1199        if iAllTeg
     1200        then
     1201           assign
     1202              vlistElem     = vlistElem    + vlistElemDop
     1203              vlistleng     = vlistleng    + vlistlengDop
     1204           .
     1205        else if mMRCCode
     1206        then
     1207           assign
     1208              vlistElem     = vlistElem    + ",(8005),8005"
     1209              vlistleng     = vlistleng    + ",000006,0006"
     1210           .
     1211       block-elem:
     1212       do vi = 1 to num-entries(vlistElem):
     1213          vTeg = entry(vi,vlistElem).
     1214          if pstr begins vTeg
     1215          then do:
     1216             if    vTeg eq "21"
     1217             then
     1218                vLength = index(pstr,chr(29)) - 2 no-error.
     1219             if vLength  <= 0
     1220             then
     1221                vLength = int(entry(vi,vlistleng)).
     1222             otegval = substring (pstr,length(vteg) + 1, vLength).
     1223             oteg = replace(replace(vteg,")",""),"(","").
     1224             vTeg = vteg + otegval.
     1225             otegval = replace(otegval,chr(29),"").
     1226             oteg = replace(replace(oteg,")",""),"(","").
     1227             pstr = substring (pstr,length(vTeg)+ 1).
     1228             vTeg = replace(vTeg,chr(29),"").
     1229             leave block-elem.
     1230          end.
     1231          else
     1232             vTeg = "".
     1233       end.
     1234       return vteg.
     1235   end.
     1236   function GetCodeIdent return character
     1237   (iDm as char):
     1238      define variable Velement   as character no-undo init "first".
     1239      define variable oCodeIdent as character no-undo.
     1240      define variable vteg as character no-undo.
     1241      define variable vtegval as character no-undo.
     1242      define variable vGtin as character no-undo.
     1243      define buffer marking for ub.marking.
     1244      for first marking no-lock where
     1245                marking.mark eq iDm
     1246            and marking.unit-ext = "LEVEL2"
     1247      :
     1248        return iDm.
     1249      end.
     1250      vGtin  = getGtinByDM (iDm ).
     1251      ChekTypeMarkByDm(idm).
     1252      if iDm begins 'tech_':U
     1253      then
     1254         oCodeIdent = iDm.
     1255      else if length(iDm) < 21
     1256      then do:
     1257         find first marking where marking.mark eq idm
     1258         no-lock no-error.
     1259         oCodeIdent = if available marking then marking.mark else  ?.
     1260      end.
     1261      else if     length(iDm) eq 29
     1262         and not iDm begins "01"
     1263         and not iDm begins "02"
     1264      then
     1265         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1266      else  if     length(iDm) >= 24
     1267               and (  iDm begins "01"
     1268                   or iDm begins "02")
     1269               and  substring(iDm,17,2) ne "21"
     1270      then do:
     1271         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1272                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1273         then
     1274            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1275         else
     1276            oCodeIdent = iDM.
     1277      end.
     1278      else  if     (   length(iDm) eq 25
     1279                    or length(iDm) eq 21)
     1280               and (not iDm begins "01"
     1281               and  not iDm begins "02")
     1282      then
     1283         oCodeIdent = substring(iDm,1,21).
     1284      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1285      then
     1286         oCodeIdent = substring(iDm,1,21).
     1287      else do while Velement ne "" and idm ne "":
     1288         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1289         oCodeIdent = oCodeIdent + Velement.
     1290      end.
     1291      return oCodeIdent.
     1292   end.
     1293   function GetTegCod return character
     1294   (icodeIdent as char, iTeg as char):
     1295      define variable Velement   as character no-undo init "first".
     1296      define variable oTeg as character no-undo init ?.
     1297      define variable vteg as character no-undo.
     1298      define variable vtegval as character no-undo.
     1299      if     ((length(icodeIdent) eq 21
     1300         and not icodeIdent begins "01"
     1301         and not icodeIdent begins "02")
     1302         or
     1303             ( length(icodeIdent) eq 25
     1304               and not icodeIdent begins "01"
     1305               and not icodeIdent begins "02"))
     1306      then do:
     1307         if iTeg eq "01" or iTeg eq "02"
     1308         then
     1309            oTeg = substring(icodeIdent,1,21).
     1310         else  if  iTeg eq "21"
     1311         then
     1312            oTeg = substring(icodeIdent,15,7).
     1313      end.
     1314      else do:
     1315         ChekTypeMarkByDm(icodeIdent).
     1316         block-teg:
     1317            do while Velement ne "" and icodeIdent ne "":
     1318            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1319            if    Velement begins iTeg
     1320               or Velement begins "(" + iTeg + ")"
     1321            then do:
     1322               oTeg = vtegval.
     1323               leave block-teg.
     1324            end.
     1325         end.
     1326      end.
     1327      return oTeg.
     1328   end.
     1329   function isOAD return logical
     1330   (icodeIdent as character):
     1331      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1332   end.
     1333   function isMark return logical
     1334   (icodeIdent as character):
     1335      define buffer buf_marking for ub.marking.
     1336      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1337             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1338   end.
     1339   function addBracketForCode return character
     1340   (icodeIdent as char):
     1341      define variable Velement   as character no-undo init "first".
     1342      define variable oTeg as character no-undo.
     1343      define variable vteg as character no-undo.
     1344      define variable vtegval as character no-undo.
     1345      define buffer marking for ub.marking.
     1346      find first marking no-lock where
     1347                 marking.mark begins icodeIdent no-error.
     1348      if    not ChekTypeMarkByDm(icodeIdent)
     1349         or length(icodeIdent) le 24
     1350         or (avail marking and marking.unit-ext = "LEVEL2")
     1351      then
     1352         oTeg = icodeIdent.
     1353      else do:
     1354         if (  icodeIdent begins "01"
     1355            or icodeIdent begins "02"
     1356            ) and CheckGtin(substring (icodeIdent,3,14))
     1357            and substring (icodeIdent,17,2) eq "21"
     1358         then do:
     1359            mMRCCode = yes.
     1360            ChekTypeMarkByDm(icodeIdent).
     1361            block-teg:
     1362            do while Velement ne "" and icodeIdent ne "":
     1363               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1364               if vteg ne ""
     1365               then
     1366                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1367            end.
     1368            mMRCCode = no.
     1369         end.
     1370         else do:
     1371            oTeg = icodeIdent.
     1372         end.
     1373      end.
     1374      return oTeg.
     1375   end.
     1376   function getlevelByCodId return int
     1377   (iCode as char):
     1378      define variable vLength as int no-undo.
     1379      define variable vLevel  as int no-undo.
     1380      if not ChekTypeMarkByDM (icode) then return ?.
     1381      vLength = length(iCode).
     1382      if    vLength eq 18
     1383         or vLength eq 20
     1384      then
     1385         Vlevel = 4.
     1386      else if vLength eq 21
     1387      then
     1388         Vlevel = 1.
     1389      else if vLength eq 25
     1390      then do:
     1391         if  iCode begins "01"
     1392         then
     1393            Vlevel = 3.
     1394         else
     1395            Vlevel = 1.
     1396      end.
     1397      else if     vLength >= 26
     1398              and vLength <= 46
     1399      then do:
     1400         if    substring(iCode,17,2) eq "11"
     1401            or substring(iCode,17,2) eq "13"
     1402            or (    substring(iCode,17,2) eq "21"
     1403                and vLength >= 33
     1404                and substring(iCode,26,4) ne "8005")
     1405         then
     1406            Vlevel = 4.
     1407         else if    vLength eq 31
     1408                 or vLength eq 38
     1409                 or vLength eq 39
     1410                 or vLength eq 45
     1411         then
     1412            Vlevel = 1.
     1413         else if    vLength eq 35
     1414                 or vLength eq 43
     1415         then
     1416            Vlevel = 3.
     1417         else
     1418            Vlevel = ?.
     1419      end.
     1420      else
     1421         Vlevel = ?.
     1422      return Vlevel.
     1423   end.
     1424   function getLevelMotpBycodid return character
     1425   (iDm as char):
     1426      define variable vLevel as integer no-undo.
     1427      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1428      vLevel = getlevelByCodId(iDm).
     1429      if    vLevel eq ?
     1430         or vLevel < 1
     1431         or vLevel > 6
     1432      then
     1433         return ?.
     1434      else
     1435         return entry(vlevel,vList).
     1436   end.
     1437   function getLevelUTDByLevelMotp return character
     1438   (iUnit as char):
     1439      define variable vLevel as integer no-undo.
     1440      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1441      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1442      vLevel = lookup(iUnit,vListMOTP).
     1443      if    vLevel eq ?
     1444         or vLevel < 1
     1445         or vLevel > 4
     1446      then
     1447         return ?.
     1448      else
     1449         return entry(vlevel,vListutd).
     1450   end.
     1451   function getLevelMotpByDM return character
     1452   (iDm as char):
     1453      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1454   end.
     1455   function getLevelUTDByCodId return character
     1456   (iDm as char):
     1457      define variable vLevel as integer no-undo.
     1458      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1459      vLevel = getlevelByCodId(iDm).
     1460      if    vLevel eq ?
     1461         or vLevel < 1
     1462         or vLevel > 4
     1463      then
     1464         return ?.
     1465      else
     1466         return entry(vlevel,vList).
     1467   end.
     1468   function getLevelUTDByDM return character
     1469   (iDm as char):
     1470      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1471   end.
     1472   define variable mNotMarkQnty as logical no-undo.
     1473   function getQntyUTDByCodId return decimal
     1474   (iDM as char):
     1475      define variable vLevel as integer no-undo.
     1476      define variable vList as character no-undo init "1,5,10,500".
     1477      define variable vGtin as character no-undo.
     1478      define variable vqnty as decimal no-undo init ?.
     1479      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1480      if vqnty eq ?
     1481      then do:
     1482         if not mNotMarkQnty
     1483         then do:
     1484            define buffer marking for ub.marking.
     1485            define variable vCodident as character no-undo.
     1486            vCodident = GetCodeIdent(idm).
     1487            find first marking where marking.mark begins vCodident no-lock no-error.
     1488            if     available marking
     1489               and marking.box-qnty ne ?
     1490            then
     1491               return marking.box-qnty.
     1492         end.
     1493         vGtin = getGtinByDm(iDM).
     1494         if ChekTypeMarkByGtin (vGtin)
     1495         then do:
     1496            vLevel = getlevelByCodId(iDM).
     1497            if     vLevel >= 1
     1498               and vLevel <= 4
     1499            then
     1500               vqnty = int(entry(vlevel,vList)).
     1501         end.
     1502         else
     1503            vqnty = getQntyCodeByGtin(vgtin).
     1504      end.
     1505      return vqnty.
     1506   end.
     1507   function getQntyUTDByDM return decimal
     1508   (iDm as char):
     1509      define variable vDM as character no-undo.
     1510      if     length (iDm) ne 25
     1511         and length (iDm) ne 29
     1512         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1513      then
     1514         vDM = substring (iDm,1,length (iDm) - 6 ).
     1515      else
     1516         vDM = substring (iDm,1,length (iDm) - 4 ).
     1517      return getQntyUTDByCodId(vDM).
     1518   end.
     1519   function getMRC4 return decimal
     1520   (iMRC as char):
     1521      define variable oMrc     as decimal no-undo init ?.
     1522      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1523      define variable vi       as integer no-undo.
     1524      define variable vfound   as integer no-undo.
     1525      define variable vposStart   as integer no-undo.
     1526      do:
     1527      OMRc = 0.
     1528      do vi = 1 to 4:
     1529         define variable vsimb as character no-undo.
     1530         vsimb = substring(iMRC,vi,1).
     1531         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1532         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1533         if vfound > 0
     1534         then
     1535            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1536         end.
     1537         OMRc = OMRc / 100.
     1538      end.
     1539      return OMRc.
     1540   end.
     1541   function getMRCByDM return decimal
     1542   (iDm as char):
     1543      define variable vMRC     as character no-undo.
     1544      define variable oMrc     as decimal no-undo init ?.
     1545      define variable Velement as character no-undo init "empty".
     1546      define variable vteg as character no-undo.
     1547      define variable vtegval as character no-undo.
     1548      if    length(idm) eq 14 + 7 + 4 + 4
     1549         or length(idm) eq 14 + 7 + 4
     1550      then do:
     1551         vMRC = substring(idm,22,4).
     1552         omrc = getMRC4(vMRC).
     1553      end.
     1554      else do:
     1555          ChekTypeMarkByDm(iDm).
     1556          block-mrc:
     1557          do while Velement ne "" and idm ne "":
     1558             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1559             if Velement begins "8005"
     1560             then do:
     1561                vMRC = substring(Velement,5,6).
     1562                leave block-mrc.
     1563             end.
     1564             else if Velement begins "(8005)"
     1565             then do:
     1566                vMRC = substring(Velement,7,6).
     1567                leave block-mrc.
     1568             end.
     1569          end.
     1570          if vMRC ne ""
     1571          then
     1572             OMRc = dec(vmrc) / 100 no-error.
     1573      end.
     1574      return OMRc.
     1575   end.
     1576   function MoveDate return Date
     1577   (idate as date,
     1578    iMonth as int64):
     1579      define variable vMonth   as int64 no-undo.
     1580      define variable vYear    as int64 no-undo.
     1581      define variable vDateNew as date  no-undo.
     1582       define variable vDay     as int64 no-undo.
     1583       vMonth = month(iDate) + iMonth.
     1584       vYear =  year(iDate).
     1585       if vMonth <= 0
     1586       then assign
     1587          vMonth = vMonth + 12
     1588           vYear  = vYear - 1
     1589       .
     1590       else if vMonth > 12
     1591       then assign
     1592          vMonth = vMonth - 12
     1593           vYear  = vYear + 1
     1594       .
     1595       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1596       do while error-status:error eq yes:
     1597          VDay = vDay + 1.
     1598          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1599       end.
     1600       if VDay > 0
     1601       then
     1602          vDateNew + 1.
     1603       return vDateNew.
     1604   end.
     1605   procedure checkEMRC:
     1606   define input  parameter iDm as character no-undo.
     1607   define output parameter vok as logical   no-undo init yes.
     1608      define variable v-value-emrc as character no-undo.
     1609      define variable v-type-emrc  as character no-undo.
     1610      define variable vDateIso     as character no-undo.
     1611      define variable vMRC         as decimal no-undo.
     1612      define variable vqnty        as decimal no-undo.
     1613      define variable vPrice       as decimal no-undo.
     1614      define variable vparent      as character no-undo.
     1615      define variable vgds-code    as integer no-undo.
     1616      define buffer code for ub.code.
     1617      vMRC = getMRCByDM(iDm).
     1618      if vMRC > 0
     1619      then do:
     1620         vgds-code = getGdsCodeByDM(iDm).
     1621         vqnty     = getQntyUTDByDM(iDm).
     1622               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1623            (
     1624             input   vgds-code
     1625            ,input   'emrc-type':U
     1626            ,output   v-value-emrc
     1627            ,output   v-type-emrc
     1628          ) no-error.
     1629          if     v-value-emrc ne ""
     1630             and v-value-emrc ne ?
     1631          then do:
     1632             vDateIso = iso-date(today).
     1633             vPrice = vMRC / vqnty.
     1634             vparent ="emc" + chr(4) + v-value-emrc.
     1635             find last code where Code.parent      eq vparent
     1636                              and Code.code        le vDateIso
     1637                              and code.status_  eq 0
     1638             no-lock no-error.
     1639             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1640             then
     1641                vOk = true .
     1642             else do:
     1643                 define variable vText      as character no-undo.
     1644                 define variable vDate      as date no-undo.
     1645                 define variable vDateLast  as character no-undo.
     1646                 define variable vDateFirst as character no-undo.
     1647                 define variable vDate3     as date no-undo.
     1648                 vdate = date(code.misc1).
     1649                 vDateLast = code.misc1.
     1650                 vDate3 = MoveDate(today, - 3 ).
     1651                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1652                                      string(vDate3  , "99/99/9999"),
     1653                                      string(vDate   , "99/99/9999")
     1654                                      ).
     1655                 vdateIso = iso-date(vdate3).
     1656                 find last code  where Code.parent      eq vparent
     1657                                   and Code.code        le vDateIso
     1658                                   and code.status_  eq 0 no-lock no-error.
     1659                 if available code
     1660                 then
     1661                    vDateIso = code.code.
     1662                 vDateFirst = vDateIso.
     1663                 vDateLast = iso-date(vdate).
     1664                 define variable vGood as logical no-undo.
     1665                 define variable vDateSale as date no-undo.
     1666                 define buffer bcode for code.
     1667                 for last code where Code.parent   eq vparent
     1668                                 and code.status_  eq 0
     1669                                 and code.code     < vDateLast
     1670                                 and code.code     >= vDateFirst
     1671                 no-lock:
     1672                    find first bcode where bCode.parent   eq vparent
     1673                                       and bcode.status_  eq 0
     1674                                       and bcode.code     > code.code no-lock no-error.
     1675                    if available bcode
     1676                    then do:
     1677                       if vPrice < dec(Code.CodeValue)
     1678                       then
     1679                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1680                                                     chr(10),
     1681                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1682                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1683                                                     ).
     1684                       else do:
     1685                          vGood = yes.
     1686                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1687                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1688                                                     chr(10),
     1689                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1690                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1691                                                     string(         vDateSale            ,"99/99/9999"),
     1692                                                     string(vDateSale - today)
     1693                                                     ).
     1694                       end.
     1695                    end.
     1696                 end.
     1697                 if vgood
     1698                 then do:
     1699                    define variable choice as integer no-undo .
     1700                    run gbl/d-askw.w (input "Уточнение"
     1701                           ,input  vText
     1702                           ,input "|"
     1703                           ,input "Принять|Вернуть"
     1704                           ,input "Принять данный товар|Вернуть товар постащику"
     1705                           ,input 1
     1706                           ,input 2
     1707                           ,output choice) no-error.
     1708                    vok = choice eq 1.
     1709                 end.
     1710                 else
     1711                    vok =false.
     1712             end.
     1713          end.
     1714      end.
     1715   end.
     1716   function addGs2Mark return character
     1717   (iMark as char):
     1718      define variable vDM   as character no-undo.
     1719      define variable vIdx  as integer   no-undo.
     1720      if index(iMark,chr(29),1) > 0
     1721      then return iMark.
     1722      if substring(iMark,26,4) = "8005" then
     1723      do:
     1724        vIdx = index(iMark,"93",26 + 4 + 5).
     1725        if vIdx > 1 then do:
     1726          vDM = substitute("&1&4&2&4&3",
     1727                           substring(iMark,1,25),
     1728                           substring(iMark,26,vIdx - 25 - 1),
     1729                           substring(iMark,vIdx),
     1730                           chr(29)) no-error.
     1731          vIdx = index(vDm,"240",vIdx + 4).
     1732          if vIdx > 0 then
     1733          do:
     1734            vDM = substitute("&1&3&2",
     1735                             substring(vDm,1,vIdx - 1),
     1736                             substring(vDm,vIdx),
     1737                             chr(29)) no-error.
     1738          end.
     1739        end.
     1740        else
     1741          vDM = substitute("&1&3&2",
     1742                           substring(iMark,1,25),
     1743                           substring(iMark,26),
     1744                           chr(29)) no-error.
     1745      end.
     1746      else if substring(iMark,32,2) = "91" then
     1747      do:
     1748        vIdx = index(iMark,"92",32).
     1749        if vIdx > 1 then
     1750          vDM = substitute("&1&4&2&4&3",
     1751                           substring(iMark,1,31),
     1752                           substring(iMark,32,vIdx - 31 - 1),
     1753                           substring(iMark,vIdx),
     1754                           chr(29)) no-error.
     1755        else
     1756          vDM = substitute("&1&3&2",
     1757                           substring(iMark,1,31),
     1758                           substring(iMark,32),
     1759                           chr(29)) no-error.
     1760      end.
     1761      else if substring(iMark,39,2) = "91" then
     1762      do:
     1763        vIdx = index(iMark,"92",38).
     1764        if vIdx > 1 then
     1765          vDM = substitute("&1&4&2&4&3",
     1766                           substring(iMark,1,38),
     1767                           substring(iMark,39,vIdx - 38 - 1),
     1768                           substring(iMark,vIdx),
     1769                           chr(29)) no-error.
     1770        else
     1771          vDM = substitute("&1&3&2",
     1772                           substring(iMark,1,38),
     1773                           substring(iMark,39),
     1774                           chr(29)) no-error.
     1775      end.
     1776      else if substring(iMark,25,2) = "93" then
     1777      do:
     1778        vIdx = index(iMark,"92",25).
     1779        if vIdx > 1 then
     1780          vDM = substitute("&1&4&2&4&3",
     1781                           substring(iMark,1,24),
     1782                           substring(iMark,25,vIdx - 24 - 1),
     1783                           substring(iMark,vIdx),
     1784                           chr(29)) no-error.
     1785        else
     1786          vIdx = index(iMark,"3103",25).
     1787          if vIdx > 0 then
     1788          vDM = substitute("&1&4&2&4&3",
     1789                           substring(iMark,1,24),
     1790                           substring(iMark,25,vIdx - 24 - 1),
     1791                           substring(iMark,vIdx),
     1792                           chr(29)) no-error.
     1793          else
     1794            vDM = substitute("&1&3&2",
     1795                             substring(iMark,1,24),
     1796                             substring(iMark,25),
     1797                             chr(29)) no-error.
     1798      end.
     1799      else if substring(iMark,32,2) = "93" then
     1800      do:
     1801        vDM = substitute("&1&3&2",
     1802              substring(iMark,1,31),
     1803              substring(iMark,32),
     1804              chr(29)) no-error.
     1805      end.
     1806      return if vDM <> "" then vDm else iMark.
     1807   end.
     1808   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1809   function getattrUtdex returns char
     1810   (idb-num   as integer,
     1811    idoc-id   as integer,
     1812    iattrcode as character,
     1813    iExValue  as character  ):
     1814      define buffer utd-attr for utd-attr.
     1815      find first utd-attr where utd-attr.db-num eq idb-num
     1816                            and utd-attr.doc-id eq idoc-id
     1817                            and utd-attr.attr-code eq iattrcode
     1818      no-lock no-error.
     1819      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     1820   end.
     1821   function getattrUtd returns char
     1822   (idb-num   as integer,
     1823    idoc-id   as integer,
     1824    iattrcode as character ):
     1825     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     1826   end.
     1827   function setattrUtd returns logical
     1828   (idb-num   as integer,
     1829    idoc-id   as integer,
     1830    iattrcode as character,
     1831    iattrval  as character ):
     1832      define buffer utd-attr for utd-attr.
     1833      find first utd-attr where utd-attr.db-num eq idb-num
     1834                            and utd-attr.doc-id eq idoc-id
     1835                            and utd-attr.attr-code eq iattrcode
     1836      no-lock no-error.
     1837      if not available utd-attr
     1838      then do:
     1839         create utd-attr.
     1840         assign
     1841            utd-attr.db-num    = idb-num
     1842            utd-attr.doc-id    = idoc-id
     1843            utd-attr.attr-code = iattrcode
     1844            utd-attr.attr-value = iattrval
     1845         .
     1846      end.
     1847      else do:
     1848         if utd-attr.attr-value ne iattrval
     1849         then do:
     1850            find current utd-attr exclusive-lock no-error.
     1851            if available utd-attr
     1852            then
     1853               utd-attr.attr-value = iattrval.
     1854         end.
     1855      end.
     1856      release utd-attr.
     1857   end.
     1858   function GetAttrUtdlinesEx returns char
     1859   (idb-num   as integer,
     1860    idoc-id   as integer,
     1861    ilinenum  as integer,
     1862    iattrcode as character,
     1863    iExValue  as character  ):
     1864      define buffer utd-lines-attr for utd-lines-attr.
     1865      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1866                                  and utd-lines-attr.doc-id    eq idoc-id
     1867                                  and utd-lines-attr.lineNum   eq ilineNum
     1868                                  and utd-lines-attr.attr-code eq iattrcode
     1869      no-lock no-error.
     1870      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     1871   end.
     1872   function GetAttrUtdlines returns char
     1873   (idb-num   as integer,
     1874    idoc-id   as integer,
     1875    ilinenum  as integer,
     1876    iattrcode as character ):
     1877      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     1878   end.
     1879   function setattrUtdlines returns logical
     1880   (idb-num   as integer,
     1881    idoc-id   as integer,
     1882    ilinenum  as integer,
     1883    iattrcode as character,
     1884    iattrval  as character ):
     1885      define buffer utd-lines-attr for utd-lines-attr.
     1886      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1887                                  and utd-lines-attr.doc-id    eq idoc-id
     1888                                  and utd-lines-attr.lineNum   eq ilineNum
     1889                                  and utd-lines-attr.attr-code eq iattrcode
     1890      no-lock no-error.
     1891      if not available utd-lines-attr
     1892      then do:
     1893         if iattrval ne ?
     1894            and iattrval ne ""
     1895         then do:
     1896            create utd-lines-attr.
     1897            assign
     1898               utd-lines-attr.db-num    = idb-num
     1899               utd-lines-attr.doc-id    = idoc-id
     1900               utd-lines-attr.lineNum   = ilineNum
     1901               utd-lines-attr.attr-code = iattrcode
     1902               utd-lines-attr.attr-value = iattrval
     1903            .
     1904         end.
     1905      end.
     1906      else do:
     1907         if utd-lines-attr.attr-value ne iattrval
     1908         then do:
     1909            find current utd-lines-attr exclusive-lock no-error.
     1910            if available utd-lines-attr
     1911            then do:
     1912               if    iattrval eq ?
     1913                  or iattrval eq ""
     1914               then do:
     1915                  delete utd-lines-attr.
     1916               end.
     1917               else do:
     1918                  utd-lines-attr.attr-value = iattrval.
     1919               end.
     1920            end.
     1921         end.
     1922      end.
     1923      release utd-lines-attr.
     1924   end.
     1925   function GetAttrUtdMarkingLinesEx returns char
     1926   (idb-num   as integer,
     1927    idoc-id   as integer,
     1928    ilinenum  as integer,
     1929    imark     as character,
     1930    iattrcode as character,
     1931    iExValue  as character  ):
     1932      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     1933      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     1934                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     1935                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     1936                                          and utd-marking-lines-attr.mark      eq imark
     1937                                          and utd-marking-lines-attr.attr-code eq iattrcode
     1938      no-lock no-error.
     1939      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     1940   end.
     1941   function GetAttrUtdMarkingLines returns char
     1942   (idb-num   as integer,
     1943    idoc-id   as integer,
     1944    ilinenum  as integer,
     1945    imark     as character,
     1946    iattrcode as character ):
     1947      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     1948   end.
     1949   function setattrUtdMarkingLines returns logical
     1950   (idb-num   as integer,
     1951    idoc-id   as integer,
     1952    ilinenum  as integer,
     1953    imark     as character,
     1954    iattrcode as character,
     1955    iattrval  as character ):
     1956      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     1957      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     1958                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     1959                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     1960                                          and utd-marking-lines-attr.mark      eq imark
     1961                                          and utd-marking-lines-attr.attr-code eq iattrcode
     1962      no-lock no-error.
     1963      if not available utd-marking-lines-attr
     1964      then do:
     1965         if iattrval ne ?
     1966            and iattrval ne ""
     1967         then do:
     1968            create utd-marking-lines-attr.
     1969            assign
     1970               utd-marking-lines-attr.db-num     = idb-num
     1971               utd-marking-lines-attr.doc-id     = idoc-id
     1972               utd-marking-lines-attr.lineNum    = ilineNum
     1973               utd-marking-lines-attr.mark       = imark
     1974               utd-marking-lines-attr.attr-code  = iattrcode
     1975               utd-marking-lines-attr.attr-value = iattrval
     1976            .
     1977         end.
     1978      end.
     1979      else do:
     1980         if utd-marking-lines-attr.attr-value ne iattrval
     1981         then do:
     1982            find current utd-marking-lines-attr exclusive-lock no-error.
     1983            if available utd-marking-lines-attr
     1984            then do:
     1985               if    iattrval eq ?
     1986                  or iattrval eq ""
     1987               then do:
     1988                  delete utd-marking-lines-attr.
     1989               end.
     1990               else do:
     1991                  utd-marking-lines-attr.attr-value = iattrval.
     1992               end.
     1993            end.
     1994         end.
     1995      end.
     1996      release utd-marking-lines-attr.
     1997   end.
     1998   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1999   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2000   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2001   function AddUtdErrForTab returns logical
     2002   (idb-num         as integer ,
     2003    idoc-id         as integer ,
     2004    iTab            as character,
     2005    iObj            as handle ,
     2006    iCheckType      as character,
     2007    iCodeErr        as character,
     2008    iCheckObj       as character ):
     2009      define buffer utd-err for utd-err.
     2010      define buffer utd for utd.
     2011      find first utd where utd.db-num     eq idb-num
     2012                       and utd.doc-id     eq idoc-id
     2013                       and utd.Direction  eq 'Outbound'
     2014      no-lock no-error.
     2015      if available utd
     2016      then
     2017         return no.
     2018      define variable vRecKey as character no-undo.
     2019            run gen-key-rec (input iTab,
     2020                             input  iObj,
     2021                             output vRecKey).
     2022      find first utd-err where utd-err.db-num     eq idb-num
     2023                           and utd-err.doc-id     eq idoc-id
     2024                           and utd-err.CheckType  eq iCheckType
     2025                           and utd-err.CodeErr    eq iCodeErr
     2026                           and utd-err.CheckObj   eq iCheckObj
     2027      exclusive-lock no-error.
     2028      if not available utd-err
     2029      then do:
     2030         create utd-err.
     2031         assign
     2032            utd-err.db-num         = idb-num
     2033            utd-err.doc-id         = idoc-id
     2034            utd-err.CheckType      = iCheckType
     2035            utd-err.CodeErr        = iCodeErr
     2036            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2037            utd-err.reckey         = vRecKey
     2038            utd-err.qnty           = 1
     2039         .
     2040      end.
     2041      else
     2042         utd-err.qnty = utd-err.qnty + 1.
     2043      return utd-err.qnty eq 1.
     2044   end.
     2045   function AddUtdErr returns logical
     2046   (idb-num         as integer ,
     2047    idoc-id         as integer ,
     2048    iObj            as handle ,
     2049    iCheckType      as character,
     2050    iCodeErr        as character,
     2051    iCheckObj       as character ):
     2052      AddUtdErrForTab
     2053         (idb-num,
     2054          idoc-id,
     2055          iObj:table,
     2056          iObj,
     2057          iCheckType,
     2058          iCodeErr,
     2059          iCheckObj).
     2060   end.
     2061   function ClearUtdErrTypeCode returns logical
     2062   (idb-num         as integer,
     2063    idoc-id         as integer ,
     2064    iCheckType      as character,
     2065    iCodeErr        as character
     2066    ):
     2067      define buffer utd-err for utd-err.
     2068      if    iCheckType eq "*"
     2069         or iCheckType eq ?
     2070      then do:
     2071         if     iCodeErr ne ?
     2072            and iCodeErr ne "*"
     2073         then
     2074            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2075            view-as alert-box.
     2076         else
     2077         for each utd-err where utd-err.db-num  eq idb-num
     2078                            and utd-err.doc-id  eq idoc-id
     2079         exclusive-lock:
     2080            delete utd-err.
     2081         end.
     2082      end.
     2083      else do:
     2084         if    iCodeErr eq ?
     2085            or iCodeErr eq "*"
     2086         then do:
     2087            for each utd-err where utd-err.db-num     eq idb-num
     2088                               and utd-err.doc-id     eq idoc-id
     2089                               and utd-err.CheckType  eq iCheckType
     2090            exclusive-lock:
     2091               delete utd-err.
     2092            end.
     2093         end.
     2094         else do:
     2095            for each utd-err where utd-err.db-num     eq idb-num
     2096                               and utd-err.doc-id     eq idoc-id
     2097                               and utd-err.CheckType  eq iCheckType
     2098                               and ub.utd-err.CodeErr eq iCodeErr
     2099            exclusive-lock:
     2100               delete utd-err.
     2101            end.
     2102         end.
     2103      end.
     2104   end.
     2105   function ClearUtdErr returns logical
     2106   (idb-num         as integer,
     2107    idoc-id         as integer ,
     2108    iCheckType      as character
     2109    ):
     2110      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2111   end.
     2112   function GetMesError returns character
     2113   (itxt as character,
     2114    iobj as character ):
     2115    define variable vi as integer no-undo.
     2116    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2117       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2118    end.
     2119    return itxt.
     2120   end.
     2121   function GetTextErrorType returns character
     2122   (iCheckType as character,
     2123    iCodeErr   as character,
     2124    iChechObj  as character,
     2125    iType      as character  ):
     2126      define buffer code    for code.
     2127      define variable vError as character no-undo.
     2128      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2129                        and code.code   eq iCodeErr
     2130      no-lock no-error.
     2131      if available code
     2132      then do:
     2133         define variable vType as integer no-undo.
     2134         if code.misc3 eq "error"
     2135         then
     2136            vType = 0.
     2137         else if code.misc3 eq "warning"
     2138         then
     2139            vType = 1.
     2140         else if code.misc3 eq "Hiden"
     2141         then
     2142            vType = 2.
     2143         else
     2144            vtype = int(code.misc3) no-error.
     2145         case itype:
     2146            when "error"
     2147            then do:
     2148               if vtype eq 0
     2149               then
     2150                  vError = GetMesError(Code.CodeValue,iChechObj).
     2151            end.
     2152            when "warning"
     2153            then do:
     2154               if vtype <= 1
     2155               then
     2156                  vError = GetMesError(Code.CodeValue,iChechObj).
     2157            end.
     2158            otherwise do:
     2159               vError = GetMesError(Code.CodeValue,iChechObj).
     2160            end.
     2161         end.
     2162      end.
     2163      else
     2164         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2165      return vError.
     2166   end.
     2167   function GetTypeError returns integer
     2168   (iCheckType as character,
     2169    iCodeErr   as character):
     2170      define buffer code    for code.
     2171      define variable vType as integer no-undo.
     2172      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2173                        and code.code   eq iCodeErr
     2174      no-lock no-error.
     2175      if     not available code
     2176         and code.misc3 eq "error"
     2177      then
     2178         vType = 0.
     2179      else if code.misc3 eq "warning"
     2180      then
     2181         vType = 1.
     2182      else if code.misc3 eq "Hiden"
     2183      then
     2184         vType = 2.
     2185      else
     2186         vtype = int(code.misc3) no-error.
     2187      return vtype.
     2188   end.
     2189   function GetTextError returns character
     2190   (iCheckType as character,
     2191    iCodeErr   as character,
     2192    iChechObj  as character ):
     2193      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2194   end.
     2195   function GetErrForUtdStr returns character
     2196   (idb-num     as integer ,
     2197    idoc-id     as integer ,
     2198    iCheckType  as character
     2199    ):
     2200      define buffer utd-err for utd-err.
     2201      define buffer code    for code.
     2202      define variable vHQry as handle no-undo.
     2203      define variable vError as longchar no-undo.
     2204      define variable vErrorOne as longchar  no-undo.
     2205      define variable oError as character no-undo.
     2206      create query vHQry.
     2207      vHQry:set-buffers(buffer utd-err:handle).
     2208      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2209                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2210                               + if    iCheckType eq "*"
     2211                                    or iCheckType eq ?
     2212                                 then       ""
     2213                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2214      vHQry:query-open().
     2215      vHQry:get-first().
     2216      QRY-BLOCK:
     2217      repeat while not vHQry:query-off-end:
     2218         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2219         if     vErrorOne ne ""
     2220            and vErrorOne ne ?
     2221         then
     2222            vError = vError + ", " + vErrorOne.
     2223         vHQry:get-next().
     2224      end.
     2225      oError = substring(vError,3,4002).
     2226      return oError.
     2227   end.
     2228   function GetErrJsonForUtd returns character
     2229   (idb-num         as integer ,
     2230    idoc-id         as integer ,
     2231    iCheckType      as character
     2232    ):
     2233      define buffer utd-err for utd-err.
     2234      define variable vHQry as handle no-undo.
     2235      define variable vError as longchar no-undo.
     2236      define variable oError as character no-undo.
     2237      create query vHQry.
     2238      define variable vi as integer no-undo.
     2239      vHQry:set-buffers(buffer utd-err:handle).
     2240      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2241                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2242                               + if    iCheckType eq "*"
     2243                                    or iCheckType eq ?
     2244                                 then       ""
     2245                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2246      vHQry:query-open().
     2247      vHQry:get-first().
     2248      QRY-BLOCK:
     2249      repeat while not vHQry:query-off-end:
     2250         define variable vErrorOne as character no-undo.
     2251         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2252         if     vErrorOne ne ?
     2253            and vErrorOne ne ""
     2254         then do:
     2255            vi = vi + 1.
     2256            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2257                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2258                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2259         end.
     2260         vHQry:get-next().
     2261      end.
     2262      for first utd where utd.db-num eq idb-num
     2263                      and utd.doc-id eq idoc-id
     2264                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2265      no-lock,
     2266         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2267                                  and utd-marking-lines.doc-id eq idoc-id
     2268                                  and utd-marking-lines.doc-level eq 1
     2269      no-lock,
     2270         first marking where marking.mark eq utd-marking-lines.mark
     2271                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2272      no-lock:
     2273         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2274         if     vErrorOne ne ?
     2275            and vErrorOne ne ""
     2276         then do:
     2277            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2278                            + '","ОбъектОш":"' + marking.mark
     2279                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2280         end.
     2281      end.
     2282      if vError ne ""
     2283      then
     2284         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2285      return oError.
     2286   end.
     2287   function GetErrJsonForUtdReturn returns character
     2288   (idb-num         as integer ,
     2289    idoc-id         as integer ,
     2290    iCheckType      as character
     2291    ):
     2292      define buffer utd-err for utd-err.
     2293      define variable vHQry as handle no-undo.
     2294      define variable vError as longchar no-undo.
     2295      define variable oError as character no-undo.
     2296      define variable vi as integer no-undo.
     2297      create query vHQry.
     2298      vHQry:set-buffers(buffer utd-err:handle).
     2299      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2300                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2301                               + if    iCheckType eq "*"
     2302                                    or iCheckType eq ?
     2303                                 then       ""
     2304                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2305      vHQry:query-open().
     2306      vHQry:get-first().
     2307      QRY-BLOCK:
     2308      repeat while not vHQry:query-off-end:
     2309         define variable vErrorOne as character no-undo.
     2310         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2311         if     vErrorOne ne ?
     2312            and vErrorOne ne ""
     2313         then do:
     2314            vi = vi + 1.
     2315            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2316                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2317                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2318         end.
     2319         vHQry:get-next().
     2320      end.
     2321      if vError ne ""
     2322      then
     2323         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2324      return oError.
     2325   end.
     2326   function GetCodeTextError returns character
     2327   (iCheckType as character,
     2328    iCodeErr   as character,
     2329    iChechObj  as character,
     2330    output oCode as character,
     2331    output ovalue as character ):
     2332      define buffer code    for code.
     2333      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2334                        and code.code   eq iCodeErr
     2335      no-lock no-error.
     2336      if     available code
     2337      then do:
     2338         define variable vi as integer no-undo init ?.
     2339         vi = int(Code.misc3) no-error.
     2340         if    code.misc3 ne "error"
     2341            and vi ne 0
     2342         then
     2343            oCode = ?.
     2344         else if     Code.misc1 ne ?
     2345                 and Code.misc1 ne ""
     2346         then
     2347            assign
     2348               oCode  = GetMesError(Code.misc1,iChechObj)
     2349               ovalue = GetMesError(Code.misc2,iChechObj)
     2350            .
     2351      end.
     2352      return if oCode eq ""
     2353             then ""
     2354             else (oCode + "_" + ovalue).
     2355   end.
     2356   define temp-table TT-err no-undo
     2357     field code_ as character
     2358     field text_ as character
     2359   index code_ code_.
     2360   function GetErrTxtForUtd returns character
     2361   (idb-num         as integer ,
     2362    idoc-id         as integer ,
     2363    iCheckType      as character
     2364    ):
     2365      define buffer utd-err for utd-err.
     2366      define variable vHQry as handle no-undo.
     2367      define variable oError as character no-undo.
     2368      create query vHQry.
     2369      define variable vi as integer no-undo.
     2370      for each tt-err :
     2371         delete tt-err.
     2372      end.
     2373      vHQry:set-buffers(buffer utd-err:handle).
     2374      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2375                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2376                               + if    iCheckType eq "*"
     2377                                    or iCheckType eq ?
     2378                                 then       ""
     2379                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2380      vHQry:query-open().
     2381      vHQry:get-first().
     2382      define variable vcode as character no-undo.
     2383      define variable vvalue as character no-undo.
     2384      QRY-BLOCK:
     2385      repeat while not vHQry:query-off-end:
     2386         vi = vi + 1.
     2387         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2388         if vcode ne ?
     2389         then do:
     2390            find first tt-err where tt-err.code eq vcode
     2391            no-error.
     2392            if not available tt-err
     2393            then do:
     2394               create tt-err.
     2395               assign
     2396                  tt-err.code_ = vcode
     2397                  tt-err.text_ = vvalue
     2398               .
     2399            end.
     2400            else
     2401               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2402         end.
     2403         vHQry:get-next().
     2404      end.
     2405     find first utd where utd.db-num eq idb-num
     2406                         and utd.doc-id eq idoc-id
     2407         no-lock.
     2408      define buffer cancel_utd-lines for utd-lines.
     2409      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2410                                  and cancel_utd-lines.doc-id eq idoc-id
     2411      no-lock:
     2412         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2413         then do:
     2414            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2415                                        and utd-marking-lines.doc-id eq idoc-id
     2416                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2417            no-lock,
     2418               first marking where marking.mark eq utd-marking-lines.mark
     2419                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2420            no-lock:
     2421               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2422               find first tt-err where tt-err.code eq vcode
     2423               no-error.
     2424               if not available tt-err
     2425               then do:
     2426                  create tt-err.
     2427                  assign
     2428                     tt-err.code_ = vcode
     2429                     tt-err.text_ = vvalue
     2430                  .
     2431               end.
     2432               else
     2433                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2434            end.
     2435         end.
     2436         else do:
     2437            define variable vqnty as decimal no-undo.
     2438            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2439            if vqnty eq ? then vqnty = 0.
     2440            if vqnty ne cancel_utd-lines.Quantity
     2441            then do:
     2442               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2443               find first tt-err where tt-err.code eq vcode
     2444               no-error.
     2445               if not available tt-err
     2446               then do:
     2447                  create tt-err.
     2448                  assign
     2449                     tt-err.code_ = vcode
     2450                     tt-err.text_ = vvalue
     2451                  .
     2452               end.
     2453               else
     2454                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2455            end.
     2456         end.
     2457      end.
     2458      for each tt-err:
     2459         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2460      end.
     2461      return oError.
     2462   end.
     2463   define variable mFormatErr as character no-undo init "text".
     2464   function GetErrForUtd returns character
     2465   (idb-num         as integer ,
     2466    idoc-id         as integer ,
     2467    iType           as character
     2468    ):
     2469      if mFormatErr eq "text"
     2470      then
     2471         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2472      else do:
     2473         if itype eq "return"
     2474         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2475         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2476      end.
     2477   end.
     2478   function GetErrComText returns longchar
     2479   (icomment as character,
     2480    itext    as longchar ):
     2481       define variable vText as longchar no-undo.
     2482      if mFormatErr eq "text"
     2483      then do:
     2484         if icomment ne ""
     2485         then
     2486            icomment = substitute("comment:|&1|",icomment).
     2487         vText = icomment + itext.
     2488      end.
     2489      else do:
     2490         icomment = if icomment begins  '"'
     2491                    then icomment
     2492                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2493         vText = icomment + "," + itext.
     2494         vText = "~{" + trim(vText,",") + "~}".
     2495      end.
     2496      return vText.
     2497   end.
     2498   function CheckTypeForMarkLineType returns logical
     2499   (iObj            as handle,
     2500    iCheckType      as character,
     2501    iCodeErr        as character ,
     2502    iTypeErr        as character ):
     2503      define variable vRecKey-markLine as character no-undo.
     2504      define variable vGoodMark        as logical no-undo.
     2505      define variable vdb-num          as integer no-undo.
     2506      define variable vdoc-id          as integer no-undo.
     2507      define variable vlinenum         as integer no-undo.
     2508      define variable vErrorOne as character no-undo.
     2509      define buffer buf_utd-err for utd-err.
     2510      run gen-key-rec (input "utd-marking-lines",
     2511                       input  iObj,
     2512                       output vRecKey-markLine).
     2513      vGoodMark = yes.
     2514      vdb-num = iObj::db-num.
     2515      vdoc-id = iObj::doc-id.
     2516      vlinenum = iObj::linenum.
     2517      block-mark-err:
     2518      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2519                               and buf_utd-err.db-num = vdb-num
     2520                               and buf_utd-err.reckey = vRecKey-markLine
     2521                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2522                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2523      no-lock:
     2524         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2525         if     vErrorOne ne ?
     2526            and vErrorOne ne ""
     2527         then do:
     2528            vGoodMark = no.
     2529            leave block-mark-err.
     2530         end.
     2531      end.
     2532      return not vGoodMark.
     2533   end.
     2534   function CheckErrForMarkLineType returns logical
     2535   (iObj            as handle,
     2536    iType           as character  ):
     2537      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2538   end.
     2539   function CheckErrForMarkLine returns logical
     2540   (iObj            as handle):
     2541      return CheckErrForMarkLineType(iObj,"*").
     2542   end.
     2543   function CheckErrForLineTypeCode returns logical
     2544   (iObj                 as handle,
     2545    iCheckType           as character,
     2546    iCodeErr             as character,
     2547    iTypeErr             as character,
     2548    iOneErr              as logical):
     2549      define variable vRecKey-line     as character no-undo.
     2550      define buffer buf_utd-err for utd-err.
     2551      define variable vUtdlineError as logical no-undo.
     2552      define variable vErrorOne as character no-undo.
     2553            run gen-key-rec (input "utd-lines",
     2554                             input  iObj,
     2555                             output vRecKey-line).
     2556         define variable vdb-num as integer no-undo.
     2557         define variable vdoc-id as integer no-undo.
     2558         define variable vlinenum as integer no-undo.
     2559         vdb-num = iObj::db-num.
     2560         vdoc-id = iObj::doc-id.
     2561         vlinenum = iObj::linenum.
     2562         block-err:
     2563         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2564                                  and buf_utd-err.db-num = vdb-num
     2565                                  and buf_utd-err.reckey = vRecKey-line
     2566                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2567                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2568         no-lock:
     2569            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2570            if     vErrorOne ne ?
     2571               and vErrorOne ne ""
     2572            then do:
     2573               vUtdlineError = yes.
     2574               leave block-err.
     2575            end.
     2576         end.
     2577         if  not vUtdlineError
     2578         then do:
     2579            define variable vGoodMark as logical no-undo.
     2580            vGoodMark = yes.
     2581            block-line-err:
     2582            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2583                                         and utd-marking-lines.doc-id  eq vdoc-id
     2584                                         and utd-marking-lines.LineNum eq vLineNum
     2585            no-lock:
     2586               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2587               if     vGoodMark
     2588                  and iOneErr eq no
     2589               then
     2590                  leave block-line-err.
     2591               if     iOneErr = yes
     2592                  and not vGoodMark
     2593               then
     2594                  leave block-line-err.
     2595            end.
     2596            vUtdlineError = not vGoodMark.
     2597         end.
     2598      return vUtdlineError.
     2599   end.
     2600   function getErrForLineType returns character
     2601   (iObj            as handle,
     2602    iType           as character  ):
     2603      define variable vRecKey-line     as character no-undo.
     2604      define buffer buf_utd-err for utd-err.
     2605      define variable vUtdlineError as logical no-undo.
     2606      define variable vErrorOne as character no-undo.
     2607      define variable oError as character no-undo.
     2608            run gen-key-rec (input "utd-lines",
     2609                             input  iObj,
     2610                             output vRecKey-line).
     2611         define variable vdb-num as integer no-undo.
     2612         define variable vdoc-id as integer no-undo.
     2613         define variable vlinenum as integer no-undo.
     2614         vdb-num = iObj::db-num.
     2615         vdoc-id = iObj::doc-id.
     2616         vlinenum = iObj::linenum.
     2617         block-err:
     2618         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2619                                  and buf_utd-err.db-num = vdb-num
     2620                                  and buf_utd-err.reckey = vRecKey-line
     2621                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2622         no-lock:
     2623            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2624            if     vErrorOne ne ?
     2625               and vErrorOne ne ""
     2626            then do:
     2627               oError = oError + vErrorOne + " ".
     2628            end.
     2629         end.
     2630      return oError.
     2631   end.
     2632   function CheckErrForLineType returns logical
     2633   (iObj            as handle,
     2634    iType           as character  ):
     2635       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2636   end.
     2637   function CheckErrForLine returns logical
     2638   (iObj            as handle):
     2639      return CheckErrForLineType(iobj,"*").
     2640   end.
     2641   function CheckErrForUtd returns logical
     2642   (idb-num         as integer ,
     2643    idoc-id         as integer ):
     2644      for each utd-lines where utd-lines.db-num eq idb-num
     2645                           and utd-lines.doc-id eq idoc-id
     2646      no-lock :
     2647         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2648         then
     2649            return no.
     2650      end.
     2651      return yes.
     2652   end.
     2653   function CheckMarkUtd-28rel return logical
     2654    (input idb-num as integer,
     2655    input idoc-id as integer):
     2656    define buffer utd                   for utd.
     2657    define buffer utd-lines             for utd-lines.
     2658    define buffer utd-marking-lines     for utd-marking-lines.
     2659    define variable v-par-type as character no-undo.
     2660    define variable vgdsNoMark as logical no-undo.
     2661    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2662      define variable v-par-val  as character no-undo.
     2663      find first utd where utd.db-num eq idb-num
     2664                       and utd.doc-id eq idoc-id
     2665      no-lock no-error.
     2666      if available utd
     2667      then do:
     2668         if     utd.obj-code ne ?
     2669            and utd.obj-type ne ?
     2670         then do:
     2671            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2672            Block-utd-lines:
     2673            for each utd-lines where utd-lines.db-num eq idb-num
     2674                                 and utd-lines.doc-id eq idoc-id
     2675            no-lock:
     2676               if     utd-lines.gds-code ne ?
     2677                  and utd-lines.gds-code ne 0
     2678               then do:
     2679                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2680                       ( utd-lines.gds-code,
     2681                         'mark-type':U,
     2682                          output v-par-val,
     2683                          output v-par-type
     2684                       ).
     2685                  if     EDOParSec:IsEdo
     2686                     and EDOParSec:GetIsEDOForType(v-par-val)
     2687                  then do:
     2688                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2689                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2690                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2691                                                    and length(utd-marking-lines.mark) > 13
     2692                     no-lock no-error.
     2693                     if     avail utd-marking-lines
     2694                        and not CheckErrForLine(buffer utd-lines:handle)
     2695                     then
     2696                        leave Block-utd-lines.
     2697                  end.
     2698                  else
     2699                     vgdsNoMark = yes.
     2700               end.
     2701            end.
     2702            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2703            if vgdsNoMark then return available utd-lines . else return yes .
     2704         end.
     2705      end.
     2706      return yes.
     2707   end.
     2708   function CheckMarkUtd return logical
     2709    (input idb-num  as integer,
     2710     input idoc-id  as integer):
     2711     define buffer utd-lines             for ub.utd-lines.
     2712     block-line:
     2713     for each utd-lines where utd-lines.db-num eq idb-num
     2714                          and utd-lines.doc-id eq idoc-id
     2715     no-lock:
     2716        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2717        then
     2718           leave block-line.
     2719     end.
     2720     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2721     return available utd-lines.
     2722   end.
     2723   function CheckNotMarkUtd return logical
     2724    (input idb-num  as integer,
     2725     input idoc-id  as integer):
     2726     define buffer utd-lines             for ub.utd-lines.
     2727     for each utd-lines where utd-lines.db-num eq idb-num
     2728                          and utd-lines.doc-id eq idoc-id
     2729     no-lock:
     2730        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2731        then
     2732           return yes.
     2733     end.
     2734     return no.
     2735   end.
     2736   function CheckMarkUtdLine return logical
     2737    (input idb-num  as integer,
     2738     input idoc-id  as integer,
     2739     input iLineNum as integer):
     2740    define buffer utd                   for utd.
     2741    define buffer utd-lines             for utd-lines.
     2742    define buffer utd-marking-lines     for utd-marking-lines.
     2743    define variable v-par-type as character no-undo.
     2744    define variable vMarking        as logical no-undo.
     2745    define variable vArtic          as logical no-undo.
     2746    define variable vTransitional   as logical no-undo.
     2747    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2748      define variable v-par-val  as character no-undo.
     2749      find first utd where utd.db-num eq idb-num
     2750                       and utd.doc-id eq idoc-id
     2751      no-lock no-error.
     2752      if available utd
     2753      then do:
     2754         if     utd.obj-code ne ?
     2755            and utd.obj-type ne ?
     2756         then do:
     2757            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2758            Block-utd-lines:
     2759            for each utd-lines where utd-lines.db-num   eq idb-num
     2760                                 and utd-lines.doc-id   eq idoc-id
     2761                                 and utd-lines.LineNum  eq iLineNum
     2762            no-lock:
     2763               if     utd-lines.gds-code ne ?
     2764                  and utd-lines.gds-code ne 0
     2765               then do:
     2766                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2767                       ( utd-lines.gds-code,
     2768                         'mark-type':U,
     2769                          output v-par-val,
     2770                          output v-par-type
     2771                       ).
     2772                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2773                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2774                  if vMarking
     2775                  then do:
     2776                     block-marking:
     2777                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2778                                                    and utd-marking-lines.doc-id   eq idoc-id
     2779                                                    and utd-marking-lines.LineNum  eq iLineNum
     2780                                                    and length(utd-marking-lines.mark) > 13
     2781                     no-lock:
     2782                        if isOAD(utd-marking-lines.mark)
     2783                        then do:
     2784                           assign
     2785                              vArtic   = yes
     2786                              vMarking = no
     2787                           .
     2788                           leave block-marking.
     2789                        end.
     2790                     end.
     2791                  end.
     2792                  if vArtic
     2793                  then do:
     2794                     block-artic:
     2795                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2796                                                    and utd-marking-lines.doc-id   eq idoc-id
     2797                                                    and utd-marking-lines.LineNum  eq iLineNum
     2798                                                    and length(utd-marking-lines.mark) > 13
     2799                     no-lock:
     2800                        if isMark(utd-marking-lines.mark)
     2801                        then do:
     2802                           assign
     2803                              vArtic   = no
     2804                              vMarking = yes
     2805                           .
     2806                           leave block-artic.
     2807                        end.
     2808                     end.
     2809                  end.
     2810                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2811                  if vTransitional
     2812                  then do:
     2813                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2814                                                    and utd-marking-lines.doc-id   eq idoc-id
     2815                                                    and utd-marking-lines.LineNum  eq iLineNum
     2816                                                    and length(utd-marking-lines.mark) > 13
     2817                     no-lock no-error.
     2818                     if not available utd-marking-lines
     2819                     then assign
     2820                        vMarking = no
     2821                        vArtic   = no
     2822                     .
     2823                  end.
     2824               end.
     2825               else
     2826                  assign
     2827                     vMarking      = yes
     2828                     vArtic        = no
     2829                     vTransitional = no
     2830                  .
     2831               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2832               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2833               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2834            end.
     2835         end.
     2836      end.
     2837      return vMarking or vArtic.
     2838   end.
     2839   function getMarkUtdLine return logical
     2840    (input  idb-num  as integer,
     2841     input  idoc-id  as integer,
     2842     input  iLineNum as integer,
     2843     output oMarking        as logical,
     2844     output oArtic          as logical,
     2845     output oTransitional   as logical):
     2846     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2847     oArtic        = not oMarking
     2848            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2849     oTransitional = (oMarking or oArtic)
     2850            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2851   end.
     2852   function CheckMarking return logical
     2853    (input idb-num as integer,
     2854    input idoc-id as integer,
     2855    input iTypeErr as character ):
     2856     define variable vMarkutd as logical no-undo.
     2857     define variable vCrErr   as logical no-undo.
     2858     define buffer utd-lines         for utd-lines.
     2859     define buffer utd-marking-lines for utd-marking-lines.
     2860     define buffer marking           for marking.
     2861     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2862      block-line:
     2863      for each utd-lines where utd-lines.db-num eq idb-num
     2864                           and utd-lines.doc-id eq idoc-id
     2865      no-lock:
     2866         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2867         then do:
     2868            for each utd-marking-lines
     2869                     where utd-marking-lines.db-num  = utd-lines.db-num
     2870                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2871                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2872            no-lock:
     2873               if isMark(utd-marking-lines.mark)
     2874               then do:
     2875                  find first marking where marking.mark eq utd-marking-lines.mark
     2876                  no-lock no-error.
     2877                  if not available marking
     2878                  then do:
     2879                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2880                     vCrErr = yes.
     2881                     next block-line.
     2882                  end.
     2883               end.
     2884            end.
     2885         end.
     2886      end.
     2887      return vCrErr.
     2888   end.
     2889   function CheckMarkForType return logical
     2890    (input idb-num   as integer,
     2891     input idoc-id   as integer):
     2892      define variable vMarking        as logical no-undo.
     2893      define variable vArtic          as logical no-undo.
     2894      define variable vTransitional   as logical no-undo.
     2895      define buffer utd-lines         for utd-lines.
     2896      define buffer utd-marking-lines for utd-marking-lines.
     2897      block-line:
     2898      for each utd-lines where utd-lines.db-num eq idb-num
     2899                           and utd-lines.doc-id eq idoc-id
     2900      no-lock:
     2901         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2902                          output vMarking         , output vArtic          , output vTransitional).
     2903         for each utd-marking-lines
     2904                     where utd-marking-lines.db-num  = utd-lines.db-num
     2905                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2906                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2907         no-lock:
     2908            if length(utd-marking-lines.mark) < 14
     2909            then do:
     2910               if (vMarking or vArtic) and not vTransitional
     2911               then
     2912                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2913            end.
     2914            else if not isMark(utd-marking-lines.mark)
     2915            then do:
     2916               if vMarking
     2917               then
     2918                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2919            end.
     2920            else do:
     2921            end.
     2922         end.
     2923      end.
     2924   end.
     2925   function WeighedProd return logical
     2926      ( input p-gds-code as integer) :
     2927      define variable v-par-val  as character no-undo.
     2928      define variable v-par-type as character no-undo.
     2929              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2930               ( p-gds-code,
     2931                 'weighed-gds':U,
     2932                  output v-par-val,
     2933                  output v-par-type
     2934               ).
     2935      return logical(v-par-val).
     2936   end.
     2937   function WghProdVariable return logical
     2938       (input p-obj-type as char,
     2939        input p-obj-code as integer,
     2940        input p-gds-code as integer) :
     2941      define variable v-wgh-val  as character no-undo.
     2942      define variable v-par-val  as character no-undo.
     2943      define variable v-par-type as character no-undo.
     2944      define variable vMarking        as logical no-undo.
     2945      define variable vArtic          as logical no-undo.
     2946      define variable vTransitional   as logical no-undo.
     2947      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2948         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2949           ( p-gds-code,
     2950             'weighed-gds':U,
     2951              output v-wgh-val,
     2952              output v-par-type
     2953           ).
     2954       if logical(v-wgh-val) = yes then do:
     2955           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2956               ( p-gds-code,
     2957                 'mark-type':U,
     2958                  output v-par-val,
     2959                  output v-par-type
     2960               ).
     2961           if v-par-val <> "" then do:
     2962               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     2963               assign
     2964                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     2965                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     2966                  .
     2967           end.
     2968      end.
     2969      if v-wgh-val > "" and (vMarking or vArtic)
     2970      then return yes.
     2971      else return no.
     2972   end.
     2973   function MarkWeight return decimal
     2974      ( input p-mark as character) :
     2975      define buffer  buf_marking-attr for  ub.marking-attr.
     2976      define variable vMarkWeight as decimal no-undo.
     2977      vMarkWeight = 0.
     2978      if p-mark <> "" and p-mark <> ?
     2979      then do:
     2980          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     2981                                        and buf_marking-attr.attr-code eq "weight"
     2982             no-lock no-error.
     2983          if not available buf_marking-attr
     2984          then do :
     2985            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     2986                                          and buf_marking-attr.attr-code eq "weight"
     2987               no-lock no-error.
     2988          end .
     2989          if avail buf_marking-attr
     2990          then vMarkWeight = dec(buf_marking-attr.attr-value).
     2991      end.
     2992      return vMarkWeight.
     2993   end.
     2994   function CheckQnty returns logical
     2995   (  input idb-num  as integer,
     2996      input idoc-id  as integer,
     2997      input iErrType as character
     2998   ):
     2999      if iErrType ne "loadUTD"
     3000      then do:
     3001         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3002         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3003         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3004      end.
     3005      if iErrType ne "CheckQnty"
     3006      then do:
     3007         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3008         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3009         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3010      end.
     3011      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3012      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3013      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3014      define buffer marking               for marking.
     3015      define buffer utd-lines             for utd-lines.
     3016      define buffer utd-marking-lines     for utd-marking-lines.
     3017      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3018      block-line:
     3019      for each utd-lines where utd-lines.db-num eq idb-num
     3020                           and utd-lines.doc-id eq idoc-id
     3021      no-lock:
     3022         define variable Vflagmark as logical no-undo.
     3023         find first buf_utd-marking-lines
     3024                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3025                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3026                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3027                         and length(buf_utd-marking-lines.mark) > 13
     3028         no-lock no-error.
     3029         if not available buf_utd-marking-lines
     3030         then
     3031            next block-line.
     3032         define variable vqntyMark as integer no-undo.
     3033         define variable vqntyOAD  as integer no-undo.
     3034         vqntyMark = 0.
     3035         vqntyOAD  = 0.
     3036         block-mark:
     3037         for each utd-marking-lines
     3038              where utd-marking-lines.db-num  = utd-lines.db-num
     3039                and utd-marking-lines.doc-id  = utd-lines.doc-id
     3040                and utd-marking-lines.LineNum = utd-lines.LineNum
     3041                and length(utd-marking-lines.mark) > 13
     3042                and utd-marking-lines.doc-level  = 1
     3043         no-lock:
     3044            if isMark(utd-marking-lines.mark)
     3045            then do:
     3046               find first marking where marking.mark eq utd-marking-lines.mark
     3047               no-lock no-error.
     3048               if available marking
     3049               then do:
     3050                  if marking.box-qnty ne ?
     3051                  then
     3052                     vqntyMark = vqntyMark + marking.box-qnty.
     3053               end.
     3054            end.
     3055            else do:
     3056               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     3057                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     3058                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     3059                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     3060                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     3061               no-lock no-error.
     3062               if available utd-marking-lines-attr
     3063               then
     3064                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     3065            end.
     3066         end.
     3067         if     utd-lines.gds-code   gt 0
     3068            and utd-lines.gds-code   ne ?
     3069            and vqntyMark            ne 0
     3070         then do:
     3071            if utd-lines.Quantity  < vqntyMark
     3072            then
     3073               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3074            else if utd-lines.Quantity  <> vqntyMark
     3075            then
     3076               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3077         end.
     3078         else if     utd-lines.gds-code   gt 0
     3079            and utd-lines.gds-code   ne ?
     3080            and vqntyOAD ne 0
     3081            and utd-lines.Quantity  ne vqntyOAD
     3082         then
     3083            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     3084      end.
     3085   end.
     3086   function CheckGds returns logical
     3087   (  input idb-num   as integer,
     3088      input idoc-id   as integer,
     3089      input iobj-type as character,
     3090      input iobj-code as integer,
     3091      input iErrType as character
     3092   ):
     3093      if iErrType ne "loadUTD"
     3094      then do:
     3095         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     3096         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     3097         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     3098         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3099         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     3100         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     3101         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     3102         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     3103         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     3104         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     3105         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     3106      end.
     3107      if iErrType ne "CheckGds"
     3108      then do:
     3109         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     3110         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     3111         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     3112         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     3113         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     3114         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     3115         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     3116         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     3117         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     3118         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     3119         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     3120      end.
     3121      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     3122      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     3123      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     3124      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3125      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     3126      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     3127      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     3128      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     3129      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     3130      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     3131      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     3132      define variable v-par-type as character no-undo.
     3133      define variable v-par-val  as character no-undo.
     3134      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3135      define buffer marking               for marking.
     3136      define buffer utd-lines             for utd-lines.
     3137      define buffer buf_utd-lines         for utd-lines.
     3138      define buffer utd-marking-lines     for utd-marking-lines.
     3139      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3140      define variable vGdsCode as integer no-undo.
     3141      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     3142      block-line:
     3143      for each utd-lines where utd-lines.db-num eq idb-num
     3144                           and utd-lines.doc-id eq idoc-id
     3145      no-lock:
     3146         vGdsCode = ?.
     3147         define variable Vflagmark as logical no-undo.
     3148         define variable VflagOAD  as logical no-undo.
     3149         assign
     3150            Vflagmark = no
     3151            VflagOAD = no
     3152         .
     3153         block-mark:
     3154         for each utd-marking-lines
     3155                  where utd-marking-lines.db-num  = utd-lines.db-num
     3156                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3157                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3158         no-lock:
     3159            if    isMark(utd-marking-lines.mark)
     3160               or isOAD (utd-marking-lines.mark)
     3161            then do:
     3162               define variable vnewGdsCode as integer no-undo.
     3163               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     3164               if isMark(utd-marking-lines.mark)
     3165               then do:
     3166                  Vflagmark = yes.
     3167                  find first marking where marking.mark eq utd-marking-lines.mark
     3168                  no-lock no-error.
     3169                  if not available marking
     3170                  then do:
     3171                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     3172                     next block-mark.
     3173                  end.
     3174                  if vnewGdsCode eq ?
     3175                  then
     3176                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     3177                  if    marking.gds-code eq 0
     3178                     or marking.gds-code eq ?
     3179                     or marking.sts eq 0
     3180                     or marking.sts eq ?
     3181                     or marking.box-qnty eq ?
     3182                     or (marking.gds-code ne vnewGdsCode
     3183                         and vnewGdsCode ne ?
     3184                         and vnewGdsCode ne 0)
     3185                  then do:
     3186                     find first marking where marking.mark eq utd-marking-lines.mark
     3187                     exclusive-lock no-error.
     3188                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     3189                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     3190                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     3191                     if    marking.gds-ext-id eq ""
     3192                        or marking.gds-ext-id eq ?
     3193                     then do:
     3194                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     3195                     end.
     3196                     else if    marking.gds-code eq 0
     3197                             or marking.gds-code eq ?
     3198                     then
     3199                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     3200                     else if     marking.sts eq 0
     3201                             or  marking.sts eq ?
     3202                     then
     3203                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     3204                  end.
     3205                  if utd-marking-lines.doc-level eq 1
     3206                  then do:
     3207                     if marking.box-qnty eq ?
     3208                     then
     3209                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3210                  end.
     3211               end.
     3212               else do:
     3213                  VflagOAD = yes.
     3214                  define variable vQnty as decimal no-undo.
     3215                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     3216                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     3217                                          utd-marking-lines.doc-id,
     3218                                          utd-marking-lines.LineNum,
     3219                                          utd-marking-lines.mark,
     3220                                          "box-qnty",
     3221                                           string(vQnty)).
     3222                  define variable vgtin as character no-undo.
     3223                  vgtin = getGtinByDM(utd-marking-lines.mark).
     3224                  if getQntyCodeByGtin(vgtin) ne 1
     3225                  then
     3226                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     3227               end.
     3228               if utd-marking-lines.gds-code ne vnewGdsCode
     3229               and vnewGdsCode ne ?
     3230               and vnewGdsCode ne 0
     3231               then do:
     3232                  find first buf_utd-marking-lines
     3233                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3234                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3235                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3236                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3237                  exclusive-lock no-error.
     3238                  if available buf_utd-marking-lines
     3239                  then do:
     3240                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     3241                  end.
     3242               end.
     3243            end.
     3244            else  do:
     3245               define variable vgdsbar as integer no-undo.
     3246               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     3247               if    utd-marking-lines.gds-code ne vgdsbar
     3248               then do:
     3249                  find first buf_utd-marking-lines
     3250                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3251                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3252                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3253                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3254                  exclusive-lock no-error.
     3255                  if available buf_utd-marking-lines
     3256                  then do:
     3257                     buf_utd-marking-lines.gds-code = vgdsbar.
     3258                  end.
     3259               end.
     3260               if vgdsbar ne ?
     3261               then do:
     3262                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3263                            ( vgdsbar,
     3264                              'mark-type':U,
     3265                              output v-par-val,
     3266                              output v-par-type
     3267                             ).
     3268                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     3269                       or  EDOParSec:GetIsArticForType(v-par-val))
     3270                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     3271                   and     EDOParSec:IsEdo
     3272                  then do:
     3273                     AddUtdErr(utd-marking-lines.db-num,
     3274                               utd-marking-lines.doc-id,
     3275                               buffer utd-marking-lines:handle,
     3276                               iErrType,
     3277                               "MarkingForTypeEDO",
     3278                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3279                  end.
     3280               end.
     3281            end.
     3282            if vGdsCode eq ?
     3283            then
     3284               vGdsCode = utd-marking-lines.gds-code.
     3285            if vGdsCode ne utd-marking-lines.gds-code
     3286            and utd-marking-lines.gds-code > 0
     3287            then do:
     3288               vGdsCode = -1.
     3289            end.
     3290         end.
     3291         if  vGdsCode = -1
     3292         then do:
     3293            vGdsCode = ?.
     3294            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     3295            next block-line.
     3296         end.
     3297         if vGdsCode ne ?
     3298         then do:
     3299                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3300                      ( vGdsCode,
     3301                        'mark-type':U,
     3302                        output v-par-val,
     3303                        output v-par-type
     3304                       ).
     3305            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     3306                and(
     3307                 (    EDOParSec:GetIsEDOForType(v-par-val)
     3308                     and not Vflagmark)
     3309                 or  (EDOParSec:GetIsArticForType(v-par-val)
     3310                     and not VflagOAD
     3311                     and not Vflagmark))
     3312            then do:
     3313               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     3314            end.
     3315         end.
     3316         if utd-lines.gds-code ne vGdsCode
     3317         then do:
     3318            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3319                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3320                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     3321            exclusive-lock no-error.
     3322            if available buf_utd-lines
     3323            then
     3324               buf_utd-lines.gds-code = vGdsCode.
     3325            release buf_utd-lines.
     3326         end.
     3327         define variable VBarCode as character no-undo.
     3328         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     3329         if VBarCode ne ?
     3330         then do:
     3331            if num-entries(VBarCode," ") > 0
     3332            then
     3333               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     3334            vgdsbar = GetGdsCodeByGtin(VBarCode).
     3335            if vgdsbar eq ? or vgdsbar eq 0
     3336            then do:
     3337               AddUtdErr(utd-lines.db-num,
     3338                         utd-lines.doc-id,
     3339                         buffer utd-lines:handle,
     3340                         iErrType,
     3341                         "NotFindGdsForBarCode",
     3342                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     3343            end.
     3344            else do:
     3345               if    utd-lines.gds-code eq ?
     3346                  or utd-lines.gds-code eq 0
     3347               then do:
     3348                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3349                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3350                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3351                  exclusive-lock no-error.
     3352                  if available buf_utd-lines
     3353                  then
     3354                     buf_utd-lines.gds-code = vgdsbar.
     3355                  release buf_utd-lines.
     3356               end.
     3357               else if utd-lines.gds-code ne vgdsbar
     3358               then do:
     3359                  AddUtdErr(utd-lines.db-num,
     3360                         utd-lines.doc-id,
     3361                         buffer utd-lines:handle,
     3362                         iErrType,
     3363                         "NotEqGgsForLineAndMark",
     3364                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     3365               end.
     3366            end.
     3367         end.
     3368         if vGdsCode eq ? and utd-lines.gds-code eq ?
     3369         then
     3370            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     3371      end.
     3372   end.
     3373   function GetUtdLineForOrig return logical
     3374   (input idb-num as integer,
     3375    input idoc-id as integer,
     3376    input ilineNum as integer,
     3377    input idb-numOrig as integer,
     3378    input idoc-idOrig as integer,
     3379    buffer edoc-lines for utd-lines):
     3380      define buffer edoc-marking-lines for ub.utd-marking-lines.
     3381      block-mark:
     3382      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     3383                                   and utd-marking-lines.doc-id  eq idoc-id
     3384                                   and utd-marking-lines.LineNum eq iLineNum
     3385                                   and utd-marking-lines.site eq "-"
     3386      no-lock:
     3387         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     3388                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     3389                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3390                     no-lock no-error.
     3391         if available edoc-marking-lines
     3392         then do:
     3393            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3394                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3395                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3396            no-lock no-error.
     3397               leave block-mark.
     3398          end.
     3399      end.
     3400       if not available edoc-lines
     3401       then do:
     3402          find  first  utd-lines where utd-lines.db-num      = idb-num
     3403                                   and utd-lines.doc-id      = idoc-id
     3404                                   and utd-lines.LineNum     = ilinenum
     3405             no-lock no-error.
     3406          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3407                                  and edoc-lines.doc-id      = idoc-idOrig
     3408                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3409          no-lock no-error.
     3410       end.
     3411       if not available edoc-lines
     3412       then
     3413          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3414                                  and edoc-lines.doc-id      = idoc-idOrig
     3415                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3416          no-lock no-error.
     3417   end.
     3418   function GetLastUTDinPack returns logical
     3419   (input idb-num as integer,
     3420    input idoc-id as integer,
     3421    output odb-num as integer,
     3422    output odoc-id as integer ) forward.
     3423   function getObgFns return logical
     3424   (input iDocumentNumber   as character ,
     3425    input iFnsParticipantId as character ,
     3426    input ikpp              as character ,
     3427    output ohost-code       as integer,
     3428    output oobj-type        as character ,
     3429    output oobj-code        as integer ,
     3430    output otext            as character  ):
     3431       define buffer ext-classif   for ext-classif.
     3432       define buffer clients       for clients.
     3433       define buffer buf_clients   for clients.
     3434       define buffer clients-attr  for clients-attr.
     3435       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3436                                and ext-classif.charkey_three eq iFnsParticipantId
     3437       no-lock no-error.
     3438       if available ext-classif
     3439       then do:
     3440          if ext-classif.CharKey_One eq 'маг':U
     3441          then do:
     3442             assign
     3443                oobj-type = ext-classif.CharKey_One
     3444                oobj-code = ext-classif.Key#_One
     3445             .
     3446             find first clients
     3447                  where clients.obj-type   = ext-classif.CharKey_One
     3448                    and clients.obj-code   = ext-classif.Key#_One
     3449             no-lock no-error .
     3450             if available clients
     3451             then
     3452                ohost-code =  clients.host-code.
     3453          end.
     3454          else do:
     3455             find first clients
     3456                  where clients.obj-type   = ext-classif.CharKey_One
     3457                    and clients.obj-code   = ext-classif.Key#_One
     3458                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3459             no-lock no-error .
     3460             if not available clients
     3461             then do:
     3462                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3463                return no.
     3464             end.
     3465             ohost-code = ext-classif.Key#_One.
     3466             block-cl:
     3467             for each clients-attr
     3468                where clients-attr.attr-code  = 'kpp':U
     3469                  and clients-attr.obj-type   = 'маг':U
     3470                  and clients-attr.attr-value = ikpp
     3471                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3472                                             and buf_clients.obj-code   = clients-attr.obj-code
     3473                                             and buf_clients.host-code  = ohost-code)
     3474             no-lock :
     3475                leave block-cl.
     3476             end.
     3477             if     available clients
     3478                and clients.obj-type eq 'маг':U
     3479             then do:
     3480                assign
     3481                   oobj-type = clients.obj-type
     3482                   oobj-code = clients.obj-code
     3483                .
     3484             end.
     3485             else if available clients-attr
     3486             then do:
     3487                assign
     3488                   oobj-type = clients-attr.obj-type
     3489                   oobj-code = clients-attr.obj-code
     3490                .
     3491             end.
     3492             else do:
     3493                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3494                return yes.
     3495             end.
     3496          end.
     3497       end.
     3498       else do:
     3499          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3500          return no.
     3501       end.
     3502       return ?.
     3503   end.
     3504   function CheckUcdForReturn return logical
     3505   (input idb-numUcd as integer,
     3506    input idoc-idUcd as integer,
     3507    input idb-numRet as integer,
     3508    input idoc-idRet as integer  ):
     3509       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3510                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3511                                    and utd-marking-lines.doc-level eq 1
     3512       no-lock:
     3513          create tt-utd-mark.
     3514          buffer-copy utd-marking-lines to tt-utd-mark
     3515          assign
     3516             tt-utd-mark.side = "+"
     3517          .
     3518       end.
     3519       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3520                                    and utd-marking-lines.doc-id eq idoc-idRet
     3521                                    and utd-marking-lines.doc-level eq 1
     3522       no-lock:
     3523          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3524          no-lock no-error.
     3525          if available tt-utd-mark
     3526          then
     3527             tt-utd-mark.side = "".
     3528          else do:
     3529             create tt-utd-mark.
     3530             buffer-copy utd-marking-lines to tt-utd-mark
     3531             assign
     3532                tt-utd-mark.side = "-"
     3533             .
     3534          end.
     3535       end.
     3536       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3537       no-lock:
     3538          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3539       end.
     3540       for each tt-utd-mark:
     3541          delete tt-utd-mark.
     3542       end.
     3543   end.
     3544   function GetLastUTDinPackAft returns logical
     3545   (input idb-num as integer,
     3546    input idoc-id as integer,
     3547    output odb-num as integer,
     3548    output odoc-id as integer ) forward.
     3549   function SaturateAndCheckUTD return character
     3550   (input idb-num as integer,
     3551    input idoc-id as integer  ):
     3552      define buffer clients-attr          for clients-attr.
     3553      define buffer clients               for clients.
     3554      define buffer Utd                   for Utd.
     3555      define buffer utd_ret               for ub.utd.
     3556      define buffer utd-lines             for utd-lines.
     3557      define buffer buf_utd-lines         for utd-lines.
     3558      define buffer buf_utddoc-lines      for utd-lines.
     3559      define buffer marking               for marking.
     3560      define buffer marking-lines         for marking-lines.
     3561      define buffer utd-marking-lines     for utd-marking-lines.
     3562      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3563      define buffer contract              for contract.
     3564      define buffer old_utd               for Utd.
     3565      define variable vError as character no-undo.
     3566      define variable vGdsCode as integer no-undo.
     3567      define variable vcli-type as character no-undo.
     3568      define variable vcli-code as integer no-undo.
     3569      define variable vhost-code as integer no-undo init ?.
     3570      define variable vcontract-code as integer no-undo.
     3571      define variable vobj-type as character no-undo init ?.
     3572      define variable vobj-code as integer no-undo init ?.
     3573      define variable volddb-num as integer no-undo.
     3574      define variable volddoc-id as integer no-undo.
     3575      define variable vMark as logical no-undo.
     3576      define variable VUcd as logical no-undo.
     3577      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3578      define variable v-par-type as character no-undo.
     3579      define variable v-par-val  as character no-undo.
     3580      define variable VFileMark as logical no-undo.
     3581      define variable vunit     as int no-undo.
     3582      define variable vunitCode as character no-undo.
     3583      define variable vMarkingUtd as logical no-undo.
     3584      find first Utd where utd.db-num eq idb-num
     3585                       and utd.doc-id eq idoc-id
     3586      no-lock no-error.
     3587      if available Utd
     3588      then do:
     3589         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     3590         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     3591         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     3592         assign
     3593               vobj-type  = utd.obj-type
     3594               vobj-code  = utd.obj-code
     3595               vhost-code = utd.host-code
     3596         .
     3597         do:
     3598            define variable vtext       as character no-undo.
     3599            define variable vhost-code1 as integer   no-undo.
     3600            define variable vobj-type1  as character no-undo.
     3601            define variable vobj-code1  as integer   no-undo.
     3602             getObgFns
     3603                       (input utd.DocumentNumber ,
     3604                        input utd.obj-FnsParticipantId ,
     3605                        input utd.obj-kpp,
     3606                        output vhost-code1,
     3607                        output vobj-type1,
     3608                        output vobj-code1,
     3609                        output vtext ).
     3610            assign
     3611               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     3612               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     3613               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     3614            .
     3615            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     3616            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     3617            block-line:
     3618            for each utd-lines where utd-lines.db-num eq utd.db-num
     3619                                 and utd-lines.doc-id eq utd.doc-id
     3620            no-lock:
     3621               vGdsCode =?.
     3622               define variable vNotMarkForLine as logical no-undo.
     3623               vNotMarkForLine = no.
     3624               if not VUcd
     3625               then do:
     3626                  find first utd-marking-lines
     3627                       where utd-marking-lines.db-num  = utd-lines.db-num
     3628                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     3629                         and utd-marking-lines.LineNum = utd-lines.LineNum
     3630                  no-lock no-error.
     3631                  if not available utd-marking-lines
     3632                  then do:
     3633                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     3634                     vNotMarkForLine = yes.
     3635                  end.
     3636               end.
     3637               block-mark:
     3638               for each utd-marking-lines
     3639                  where utd-marking-lines.db-num  = utd-lines.db-num
     3640                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3641                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3642               no-lock:
     3643                  vMark = yes.
     3644                  if     isMark(utd-marking-lines.mark)
     3645                     and utd-marking-lines.gds-code  ne 0
     3646                     and utd-marking-lines.gds-code ne ?
     3647                  then do:
     3648                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3649                           ( utd-marking-lines.gds-code,
     3650                            'mark-type':U,
     3651                            output v-par-val,
     3652                            output v-par-type
     3653                            ).
     3654                      if     not VFileMark
     3655                         and not VUcd
     3656                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     3657                      then do:
     3658                          AddUtdErr(utd.db-num,
     3659                                     utd.doc-id,
     3660                                     buffer utd-marking-lines:handle,
     3661                                     "loadUtd",
     3662                                     "NotON_NSCHFDOPPRMARK",
     3663                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3664                     end.
     3665                  end.
     3666               end.
     3667               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     3668               then do :
     3669                  if     VUcd
     3670                  then do:
     3671                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     3672                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     3673                     if available buf_utddoc-lines
     3674                     then do:
     3675                        vGdsCode = buf_utddoc-lines.gds-code.
     3676                        vunitCode = buf_utddoc-lines.UnitCode.
     3677                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     3678                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3679                        then
     3680                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3681                               "loadUtd",
     3682                               "UcdUnitChangForUtd",
     3683                               string(utd-lines.LineNum )                  + chr(4) +
     3684                               buf_utddoc-lines.UnitCode                   + chr(4) +
     3685                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3686                     end.
     3687                     if     utd-lines.UnitCode ne ?
     3688                        and utd-lines.UnitCode ne ""
     3689                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3690                     then
     3691                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3692                               "loadUtd",
     3693                               "UcdUnitChang",
     3694                               string(utd-lines.LineNum )                  + chr(4) +
     3695                               utd-lines.UnitCode                          + chr(4) +
     3696                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3697                  end.
     3698               end.
     3699               else
     3700                  vGdsCode = utd-lines.gds-code.
     3701               define variable vValText as character no-undo.
     3702               define variable vValDec  as decimal no-undo.
     3703               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     3704               if VValText = ?
     3705               then do:
     3706                  vValDec = utd-lines.Quantity.
     3707                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     3708               end.
     3709               else
     3710                  vValDec = dec(VValText).
     3711               release bar-code .
     3712               if     vGdsCode > 0 and vGdsCode ne ?
     3713               then do:
     3714                  assign
     3715                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     3716                     vunit = ?
     3717                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     3718                  no-error.
     3719                  if vunit ne 0 and vunit ne ?
     3720                  then do:
     3721                     find units where units.OKEI eq vunit no-lock no-error.
     3722                     if available units
     3723                     then
     3724                        vunitCode = units.unit-name.
     3725                  end.
     3726                  find first bar-code where bar-code.gds-code eq vGdsCode
     3727                                        and bar-code.unit-cli eq vUnitCode
     3728                  no-lock no-error.
     3729                  if not available bar-code
     3730                  then
     3731                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3732                               "loadUtd",
     3733                               "Unit",
     3734                               string(utd-lines.LineNum )                  + chr(4) +
     3735                               string(vGdsCode)                            + chr(4) +
     3736                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     3737                               vunitCode).
     3738               end.
     3739               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     3740               then do:
     3741                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3742                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3743                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3744                  exclusive-lock no-error.
     3745                  if available buf_utd-lines
     3746                  then do:
     3747                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     3748                     release buf_utd-lines.
     3749                  end.
     3750               end.
     3751               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     3752               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     3753               if     not VUcd
     3754                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     3755               then
     3756                  vMarkingUtd = yes .
     3757            end.
     3758            if not VUcd
     3759            then
     3760               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     3761            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3762                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     3763            no-lock no-error.
     3764            if available ext-classif
     3765            then
     3766               assign
     3767                  vcli-type = ext-classif.CharKey_One
     3768                  vcli-code = ext-classif.Key#_One
     3769               .
     3770            else do:
     3771               assign
     3772                 vcli-type = ?
     3773                 vcli-code = ?
     3774               .
     3775               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     3776            end.
     3777            find first contract  where contract.host-code eq vhost-code
     3778                                   and contract.cli-type  eq vcli-type
     3779                                   and contract.cli-code  eq vcli-code
     3780                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     3781            no-lock no-error.
     3782            define variable VContractEdo as logical no-undo init yes.
     3783            if available contract
     3784            then do:
     3785               assign
     3786                  VContractEdo = contract.whole-send-news > 0
     3787                  vcontract-code = contract.contract-code
     3788               .
     3789               if not VContractEdo
     3790               then
     3791                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     3792            end.
     3793            else do:
     3794               vcontract-code = ?.
     3795            end.
     3796         end.
     3797         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     3798         then do:
     3799            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     3800         end.
     3801         define variable vdoc-code as character no-undo init ?.
     3802         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     3803         then do:
     3804            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     3805                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     3806                                 and utd_ret.Timestamp             le utd.Timestamp
     3807                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     3808            no-lock no-error.
     3809            if available utd_ret
     3810            then do:
     3811               vdoc-code = utd_ret.doc-code.
     3812               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     3813            end.
     3814         end.
     3815      end.
     3816      find current utd exclusive-lock no-error.
     3817      if available utd
     3818      then do:
     3819         assign
     3820            utd.cli-type      = vcli-type      when vcli-type      ne ?
     3821            utd.cli-code      = vcli-code      when vcli-type      ne ?
     3822            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     3823            utd.contract-code = vcontract-code when vcontract-code ne ?
     3824            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     3825            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     3826            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     3827         .
     3828         if   ( utd.contract-code eq ?
     3829            or utd.contract-code eq 0)
     3830            and not vucd
     3831         then
     3832            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     3833         if utd.host-code eq ?
     3834            or utd.host-code eq 0
     3835         then
     3836            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     3837         if utd.obj-code eq ?
     3838            or utd.obj-code eq 0
     3839         then
     3840            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     3841      end.
     3842      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     3843      if vError eq ""
     3844      then do:
     3845         if utd.sts eq 0 or utd.sts eq ?
     3846         then
     3847            utd.sts = if VUcd
     3848                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     3849                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3850         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     3851         then do:
     3852            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3853         end.
     3854         if     not VUcd
     3855            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     3856         then do:
     3857            if not vMarkingUtd
     3858            then
     3859               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     3860         end.
     3861      end.
     3862      else do:
     3863         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     3864         then
     3865            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     3866      end.
     3867      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3868         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     3869      then
     3870         utd.sts-edi = ?.
     3871      else if     (not vMark and  not vucd) or not VContractEdo
     3872              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3873      then
     3874         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     3875      release utd no-error.
     3876      if error-status:error
     3877      then
     3878         return error return-value.
     3879      return vError.
     3880   end.
     3881   function ReCheckload returns logical
     3882   (idb-num as integer,
     3883    idoc-id as integer,
     3884    iload   as logical ):
     3885      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     3886      define buffer buf_c-utd for ub.c-utd .
     3887      define buffer buf_utd   for ub.utd .
     3888      find first buf_utd where buf_utd.db-num eq idb-num
     3889                           and buf_utd.doc-id eq idoc-id
     3890      exclusive-lock no-error.
     3891      if available buf_utd
     3892      then do:
     3893         if    iload
     3894            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     3895         then do:
     3896            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     3897            if  error-status:error then
     3898            do:
     3899               message return-value view-as alert-box.
     3900            end.
     3901         end.
     3902         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     3903            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     3904            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     3905            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     3906         then do:
     3907            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     3908                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     3909                                              buf_c-utd.sts    eq buf_utd.sts and
     3910                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     3911            no-error .
     3912            if available (buf_c-utd)
     3913            then do:
     3914               buf_utd.sts = buf_c-utd.sts .
     3915               buf_utd.sts-edi = buf_c-utd.sts-edi .
     3916            end.
     3917            else do:
     3918               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     3919                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     3920               then
     3921                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     3922               else
     3923                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     3924               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     3925            end.
     3926         end.
     3927         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     3928         then do:
     3929            run utl/utd-checkSpec.p (input buf_utd.db-num,
     3930                                     input buf_utd.doc-id) .
     3931         end.
     3932      end.
     3933      release buf_utd.
     3934      unsubscribe "getNextseq".
     3935   end.
     3936   function ReCheck returns logical
     3937   (idb-num as integer,
     3938    idoc-id as integer ):
     3939      ReCheckload(idb-num,idoc-id,no).
     3940   end.
     3941   function GetLastUTDForPac returns logical
     3942   (iPackegeId as character ,
     3943    iTimestamp as datetime,
     3944    output odb-num as integer,
     3945    output odoc-id as integer ):
     3946      define buffer buf_utd for utd.
     3947      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     3948                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     3949                                and Buf_utd.Timestamp gt iTimestamp
     3950      no-lock no-error.
     3951      if available  buf_utd
     3952      then
     3953         assign
     3954            odb-num = buf_utd.db-num
     3955            odoc-id = buf_utd.doc-id
     3956         no-error.
     3957      else
     3958         assign
     3959            odb-num = ?
     3960            odoc-id = ?
     3961         no-error.
     3962   end.
     3963   function GetprevUTDForPac returns logical
     3964   (iPackegeId as character ,
     3965    iTimestamp as datetime,
     3966    output odb-num as integer,
     3967    output odoc-id as integer ):
     3968      define buffer buf_utd for utd.
     3969      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     3970                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     3971                                and Buf_utd.Timestamp < iTimestamp
     3972      no-lock no-error.
     3973      if available  buf_utd
     3974      then
     3975         assign
     3976            odb-num = buf_utd.db-num
     3977            odoc-id = buf_utd.doc-id
     3978         no-error.
     3979      else
     3980         assign
     3981            odb-num = ?
     3982            odoc-id = ?
     3983         no-error.
     3984   end.
     3985   function GetLastUTDinPackAft returns logical
     3986   (input idb-num as integer,
     3987    input idoc-id as integer,
     3988    output odb-num as integer,
     3989    output odoc-id as integer ):
     3990      define buffer buf_utd for utd.
     3991      define buffer     utd for utd.
     3992      find first utd where utd.db-num eq idb-num
     3993                       and utd.doc-id eq idoc-id
     3994      no-lock no-error.
     3995      if available utd
     3996      then do:
     3997         if utd.PackageId eq ""
     3998         then do:
     3999            assign
     4000               odb-num = utd.db-num
     4001               odoc-id = utd.doc-id
     4002            .
     4003            return yes.
     4004         end.
     4005         else do:
     4006            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4007            if    odb-num eq ?
     4008               or odoc-id eq ?
     4009            then do:
     4010               assign
     4011                  odb-num = utd.db-num
     4012                  odoc-id = utd.doc-id
     4013               .
     4014               return yes.
     4015            end.
     4016            else
     4017               return odoc-id = utd.doc-id.
     4018         end.
     4019      end.
     4020      return ?.
     4021   end.
     4022   function GetLastUTDinPackbef returns logical
     4023   (input idb-num as integer,
     4024    input idoc-id as integer,
     4025    output odb-num as integer,
     4026    output odoc-id as integer ):
