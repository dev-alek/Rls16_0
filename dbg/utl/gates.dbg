        1   DEFINE BUFFER X_clob-bind FOR ub.clob-bind.
        2   DEFINE BUFFER X_clob-data FOR ub.clob-data.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Список гейтов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65   define variable v-waitfram-action01         as character   no-undo .
       66   define variable v-waitfram-action02         as character   no-undo .
       67   define variable v-waitfram-action03         as character   no-undo .
       68   define variable mWaitFramTextBeg            as character   no-undo.
       69   define variable mWaitFramTextEnd            as character   no-undo.
       70   define variable mWaitFramView               as logical     no-undo.
       71   define variable mWaitProcEvent              as logical     no-undo init yes.
       72   define variable mWaitFramInterval           as integer     no-undo init 1 .
       73   define variable mWaitFramStop               as logical     no-undo.
       74   define variable mWaitFramStopUser           as logical     no-undo.
       75   define variable mWaitFramStopTimeOut        as logical     no-undo.
       76   define variable mWaitFramStartProc          as datetime-tz no-undo.
       77   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       78   define button B-WaitFramStop auto-end-key
       79        label "Стоп"
       80        size 10 by 1 tooltip "Остоновить процесс".
       81   define button B-viewProcInfo
       82        label "Информация"
       83        size 15 by 1 tooltip "Информация о процесс".
       84   define frame waitfram
       85     v-waitfram-action01 format "x(72)" no-label skip
       86     v-waitfram-action02 format "x(72)" no-label skip
       87     v-waitfram-action03 format "x(72)" no-label skip
       88     B-viewProcInfo
       89     B-WaitFramStop at row 4 col 30
       90     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       91     .
       92   define new global shared variable mBatchMode as logical no-undo init ?.
       93   define variable mFramBachModHandle as handle no-undo.
       94   mFramBachModHandle = frame waitfram:handle.
       95   define variable mFameOldVis as logical no-undo.
       96   define variable mVisCUrentVin as logical no-undo.
       97   if session:batch-mode
       98   then
       99      mBatchMode = yes.
      100   if mBatchMode = ? then do:
      101     mVisCUrentVin = current-window:visible.
      102     mFameOldVis = mFramBachModHandle:visible.
      103     mFramBachModHandle:visible  = yes.
      104     mBatchMode = mFramBachModHandle:visible ne yes.
      105     mFramBachModHandle:visible = mFameOldVis.
      106     current-window:visible = mVisCUrentVin.
      107   end.
      108    if  log-manager:logfile-name ne ?
      109     then DO:
      110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      112         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      113     end.
      114   on choose of B-WaitFramStop in frame waitfram
      115   do:
      116     mWaitFramStop = yes.
      117     mWaitFramStopUser = yes.
      118   end.
      119   function waitfram-check-timeout returns logical():
      120      define variable vtime as int64 no-undo.
      121      if mWaitFramStopTimeOut
      122      then
      123         return yes.
      124      vtime = ( now - mWaitFramStartProc ) / 1000 .
      125      if     mWaitFramTimeOut ne ?
      126         and mWaitFramTimeOut ne 0
      127         and mWaitFramTimeOut lt vtime
      128      then do:
      129         mWaitFramStopTimeOut = yes.
      130      end.
      131      return mWaitFramStopTimeOut.
      132   end.
      133   procedure waitfram-hide :
      134     if not session:batch-mode
      135     then do
      136     on error undo, return error return-value
      137     :
      138       pause 0 before-hide .
      139       if not mBatchMode then
      140         hide frame waitfram .
      141     if     not mWaitFramView
      142        and mWaitProcEvent
      143     then
      144       process events .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208       if     mWaitFramView
      209          then do:
      210             if     mWaitFramInterval ne ?
      211                and not mBatchMode
      212             then
      213                wait-for go of frame waitfram pause mWaitFramInterval.
      214          end.
      215          else
      216             if     mWaitProcEvent
      217                and not mBatchMode
      218             then
      219                process events .
      220     end.
      221   end procedure.
      222      procedure waitfram-show-this:
      223         define input  parameter iInterval as int64 no-undo.
      224         define variable vtime as int64 no-undo.
      225         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      226         mWaitFramInterval = iInterval.
      227         run waitfram-show (substitute("&1&2 &3&4" ,
      228                                       mWaitFramTextBeg ,
      229                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      230                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      231                                       mWaitFramTextEnd
      232                                      )
      233                           ).
      234      end.
      235      procedure WaitFramRunPause:
      236         define input  parameter iInterval as dec no-undo.
      237         define variable vStart  as datetime-tz no-undo.
      238         define variable vend    as datetime-tz no-undo.
      239         define variable vint as int64 no-undo.
      240         define variable vOk as logical no-undo.
      241         vStart = now.
      242         vend   = vStart.
      243         publish "WaitFramPause" (iInterval,output vOk).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and (   vint > 0
      249                 or (    not vOk
      250                     and iInterval eq ?
      251                     )
      252                 )
      253         then
      254            run waitfram-show-this (iInterval).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and vint > 0
      260         then do:
      261            run gbl/pause.p (vint * 1000).
      262         end.
      263         if iInterval ne ?
      264         then
      265            publish "WaitFramStop".
      266         waitfram-check-timeout().
      267      end.
      268      procedure WaitFramWaitFor:
      269         define input  parameter iInterval as dec no-undo.
      270         assign
      271            mWaitFramStartProc   = now
      272            mWaitFramStopUser    = no
      273            mWaitFramStopTimeOut = no
      274         .
      275         block-wait:
      276         do while not mWaitFramStop:
      277            run WaitFramRunPause (iInterval).
      278            if  waitfram-check-timeout()
      279            then do:
      280               leave block-wait.
      281            end.
      282         end.
      283         run waitfram-hide.
      284      end.
      285   procedure waitfram-join :
      286     define input  parameter p-line-1  as character no-undo .
      287     define input  parameter p-line-2  as character no-undo .
      288     define input  parameter p-line-3  as character no-undo .
      289     define output parameter p-message as character no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       assign
      294         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      297       .
      298     end.
      299   end procedure.
      300   function waitfram-join-function returns character
      301     (input p-line-1 as character
      302     ,input p-line-2 as character
      303     ,input p-line-3 as character
      304     ).
      305     define variable v-message as character no-undo .
      306     run waitfram-join in this-procedure
      307       (input  p-line-1
      308       ,input  p-line-2
      309       ,input  p-line-3
      310       ,output v-message
      311       ) .
      312     return v-message .
      313   end function .
      314   define new global shared variable g#language as character no-undo .
      315   if g#language <> '' and g#language <> 'rus':U then do:
      316     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      317   end.
      318   define new global shared variable g#library  as handle no-undo .
      319   define new global shared variable g#library2 as handle no-undo .
      320   define   shared variable g#auto as logical no-undo.
      321   define   shared variable g#news as logical no-undo.
      322   define   shared variable g#oxml as logical no-undo.
      323   define   shared variable g#esys as logical no-undo.
      324   define   shared variable g#news-source-db as integer no-undo.
      325   define   shared variable g#esys-source-esys as integer no-undo.
      326   define   shared variable g#db-num as integer   no-undo .
      327   define   shared variable g#userid as character no-undo .
      328   define   shared variable g#passwd as character no-undo .
      329   procedure proc-alt-shift-f2:
      330     if not ibs.th.gbl.gbl-var:rcode
      331   then
      332     run gbl\inidebug.p .
      333   end.
      334   procedure proc-alt-shift-f3:
      335     run gbl/prvssinf.p
      336       ( input this-procedure
      337       ) .
      338   end.
      339   define variable v-inform-launched as logical no-undo initial false .
      340   procedure proc-alt-shift-f4:
      341     define variable v-action as character no-undo .
      342     if v-inform-launched = false then do:
      343       assign
      344         v-inform-launched = true
      345       .
      346       run gbl/d-inform.w
      347         (  input self
      348         ,  input this-procedure
      349         , output v-action
      350         ) no-error .
      351       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      352       assign
      353         v-inform-launched = false
      354       .
      355     end.
      356   end.
      357   procedure proc-alt-f1:
      358     run gbl/corrhelp.p
      359       (input this-procedure
      360       ) .
      361   end .
      362   on alt-shift-f2 anywhere do:
      363     run proc-alt-shift-f2.
      364   end.
      365   on alt-shift-f3 anywhere do:
      366     run proc-alt-shift-f3 in this-procedure .
      367   end.
      368   on alt-shift-f4 anywhere do:
      369     run proc-alt-shift-f4 in this-procedure.
      370   end.
      371   on alt-f1 anywhere do:
      372     run proc-alt-f1 in this-procedure .
      373   end.
      374   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375     define variable v-cntxt-db-num        as integer   no-undo .
      376     define variable v-cntxt-userid        as character no-undo .
      377     define variable v-cntxt-level         as character no-undo .
      378     define variable v-cntxt-host-code-obj as integer   no-undo .
      379     define variable v-cntxt-obj-type      as character no-undo .
      380     define variable v-cntxt-obj-code      as integer   no-undo .
      381     define variable v-cntxt-db-num-obj    as integer   no-undo .
      382     define variable v-cntxt-is-admin      as logical   no-undo .
      383   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   procedure cur-time :
      385      define output parameter p-today as date      no-undo .
      386      define output parameter p-time  as integer   no-undo .
      387     do
      388     on error undo, return error
      389     :
      390       define variable v-date1 as date      no-undo .
      391       define variable v-date2 as date      no-undo .
      392       define variable v-time  as integer   no-undo .
      393       assign
      394         v-date1 = today
      395         v-time  = time
      396         v-date2 = today
      397       .
      398       if v-date1 <> v-date2
      399       then do:
      400         assign
      401           v-date1 = today
      402           v-time  = v-time
      403         .
      404       end.
      405       assign
      406         p-today = v-date1
      407         p-time  = v-time
      408       .
      409     end.
      410   end.
      411   function cur-time-date returns character
      412   :
      413     return string(today, '99/99/9999':U) .
      414   end.
      415   function cur-time-mjd returns decimal
      416   :
      417     define variable v-date as date      no-undo .
      418     define variable v-time as integer   no-undo .
      419     run cur-time in this-procedure
      420       (output v-date
      421       ,output v-time
      422       ) .
      423     return integer(v-date) - 2400002 + (v-time / 86400) .
      424   end.
      425   function cur-time-get-ending-index returns integer
      426   (input p-number as integer
      427   )
      428   :
      429     if p-number < 0
      430     or p-number = ?
      431     then do:
      432       return 1 .
      433     end.
      434     define variable v-rest as integer   no-undo .
      435     assign
      436       p-number = p-number modulo 100
      437     .
      438     if p-number < 20
      439     then do:
      440       assign
      441         v-rest = p-number
      442       .
      443     end.
      444     else do:
      445       assign
      446         v-rest = p-number modulo 10
      447       .
      448     end.
      449     case v-rest :
      450       when 1
      451       then do:
      452         return 2 .
      453       end.
      454       when 2 or
      455       when 3 or
      456       when 4
      457       then do:
      458         return 3 .
      459       end.
      460       otherwise do:
      461         return 1 .
      462       end.
      463     end case .
      464   end.
      465   procedure cur-time-mjd-to-date :
      466      define input  parameter i-mjd-diff as decimal no-undo.
      467      define output parameter o-Date     as date    no-undo.
      468      define output parameter o-Time     as integer no-undo.
      469      define variable v-day-number as integer   no-undo .
      470      if    i-mjd-diff < 0
      471         or i-mjd-diff = ?
      472      then do:
      473         return "?" .
      474      end.
      475      assign
      476         v-day-number = truncate(i-mjd-diff,0).
      477         o-Date = date(v-day-number + 2400002).
      478         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      479     .
      480   end.
      481   function cur-time-mjd-to-string returns character
      482   (input p-mjd-diff as decimal
      483   )
      484   :
      485     define variable v-day-number as integer   no-undo .
      486     define variable v-seconds    as integer   no-undo .
      487     define variable v-hour       as integer   no-undo .
      488     define variable v-min        as integer   no-undo .
      489     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      490     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      491     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      492     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      493     if p-mjd-diff < 0
      494     or p-mjd-diff = ?
      495     then do:
      496       return "?" .
      497     end.
      498     assign
      499       v-day-number = integer(truncate(p-mjd-diff,0))
      500       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      501     .
      502     if v-seconds > 86400
      503     then do:
      504       assign
      505         v-seconds = 86400 - 1
      506       .
      507     end.
      508     if v-seconds < 0
      509     then do:
      510       assign
      511         v-seconds = 0
      512       .
      513     end.
      514     assign
      515       v-hour = truncate(v-seconds / 3600, 0)
      516     .
      517     assign
      518       v-seconds = v-seconds modulo 3600
      519     .
      520     assign
      521       v-min = truncate(v-seconds / 60, 0)
      522     .
      523     assign
      524       v-seconds = v-seconds modulo 60
      525     .
      526     return
      527         (if v-day-number <> 0
      528           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      529           else ""
      530         )
      531       + (if v-day-number <> 0 or v-hour <> 0
      532           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      533           else ""
      534         )
      535       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      536           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      537           else ""
      538         )
      539       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      540       .
      541   end.
      542   function cur-time-string returns character
      543   :
      544     define variable v-date as date      no-undo .
      545     define variable v-time as integer   no-undo .
      546     run cur-time in this-procedure
      547       (output v-date
      548       ,output v-time
      549       ) .
      550     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      551   end.
      552   function cur-time-string-sec returns character
      553   :
      554     define variable v-date as date      no-undo .
      555     define variable v-time as integer   no-undo .
      556     run cur-time in this-procedure
      557       (output v-date
      558       ,output v-time
      559       ) .
      560     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      561   end.
      562   function cur-time-custom  returns character
      563   (input p-prefix as character
      564   ,input p-date-format as character
      565   ,input p-delimiter as character
      566   ,input p-time-format as character
      567   ,input p-suffix as character
      568   )
      569   :
      570     define variable v-date as date      no-undo .
      571     define variable v-time as integer   no-undo .
      572     run cur-time in this-procedure
      573       (output v-date
      574       ,output v-time
      575       ) .
      576     return
      577       p-prefix
      578       + string(v-date, p-date-format)
      579       + p-delimiter
      580       + string(v-time, p-time-format)
      581       + p-suffix
      582       .
      583   end.
      584   function cur-time-print  returns character
      585   :
      586     define variable v-date as date      no-undo .
      587     define variable v-time as integer   no-undo .
      588     run cur-time in this-procedure
      589       (output v-date
      590       ,output v-time
      591       ) .
      592     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      593   end.
      594   function cur-time-datetime returns datetime
      595   :
      596     define variable v-char as character no-undo .
      597     define variable v-datetime as datetime no-undo .
      598     v-char = cur-time-string().
      599     v-datetime = datetime(v-char).
      600     return  v-datetime.
      601   end.
      602   function cur-time-string-msec returns character
      603   :
      604     define variable v-date as datetime  no-undo .
      605     v-date = now.
      606     return string(v-date) .
      607   end.
      608   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   procedure progs-name :
      610     define input  parameter p-action-code         as character no-undo .
      611     define output parameter p-main-prog-name      as character no-undo .
      612     define output parameter p-list-db-proc-name   as character no-undo .
      613     define output parameter p-commit-proc-name    as character no-undo .
      614     define output parameter p-execution-proc-name as character no-undo .
      615     define output parameter p-recover-proc-name   as character no-undo .
      616     define output parameter p-after-proc-name     as character no-undo .
      617     do
      618     on error undo, return error
      619     :
      620       case p-action-code :
      621               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
      622               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      623               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      624               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      625               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      626               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      627               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      628               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      629               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      630               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      631               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      632               otherwise do:
      633           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      634         end.
      635       end case.
      636     end.
      637     return.
      638   end procedure.
      639   procedure progs-title :
      640     define input  parameter p-action-code         as character no-undo .
      641     define output parameter p-action-title      as character no-undo .
      642     do
      643     on error undo, return error
      644     :
      645       case p-action-code :
      646               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      647               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      648               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      649               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      650               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      651               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      652               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      653               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      654               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      655               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      656               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      657               otherwise do:
      658           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      659         end.
      660       end case.
      661     end.
      662     return.
      663   end procedure.
      664   FUNCTION progs-title-function returns character(
      665      input  p-action-code         as character):
      666   define variable p-action-title      as character no-undo .
      667     do
      668     on error undo, return error
      669     :
      670       case p-action-code :
      671               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      672               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      673               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      674               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      675               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      676               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      677               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      678               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      679               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      680               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      681               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      682               otherwise do:
      683           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      684         end.
      685       end case.
      686     end.
      687     return p-action-title.
      688   end FUNCTION.
      689   procedure get-row-keyr-string :
      690    define input  parameter p-key-rec  as character no-undo.
      691    define output parameter p-tbl-title as character no-undo.
      692    define output parameter p-rec-string  as character no-undo.
      693     do
      694     on error undo, return error
      695     :
      696       define variable v-full-tbl-name as character no-undo .
      697       define variable bh_tbl-name     as handle    no-undo .
      698       define variable fh              as handle    no-undo .
      699       define variable v-ok            as logical   no-undo .
      700       define variable v-field-num     as integer   no-undo .
      701       define variable v-count-fld     as integer   no-undo .
      702       define variable v-tbl-name as character no-undo.
      703       if p-key-rec = ?
      704         or p-key-rec = "":U
      705       then do:
      706         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      707       end.
      708       assign
      709         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      710         v-full-tbl-name = "ub.":U + v-tbl-name
      711         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      712         p-rec-string         = "":U
      713         v-count-fld     = 0
      714       .
      715       find ub._file
      716         where ub._file._file-name = v-tbl-name
      717         no-error.
      718       if not available ub._file then do:
      719         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info3, v-tbl-name ).
      720       end.
      721       assign
      722       p-tbl-title = ub._file._file-label
      723       .
      724       find ub._index
      725         where recid( ub._index  ) = ub._file._prime-index
      726         no-error.
      727       if not available ub._index
      728         or LC( ub._index._index-name ) = "default":U
      729       then do:
      730         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      731       end.
      732       block_where :
      733       for each ub._index-field of ub._index  ,
      734           each ub._field of _index-field
      735           break by _index-seq
      736       on error undo, return error
      737       :
      738         assign
      739           v-count-fld = v-count-fld + 1
      740         .
      741         if v-count-fld > v-field-num then do:
      742           leave block_where.
      743         end.
      744         if p-rec-string = "":U then do:
      745           assign
      746             p-rec-string = "":U
      747           .
      748         end.
      749         else do:
      750           assign
      751             p-rec-string = p-rec-string + chr(32) + chr(44)
      752           .
      753         end.
      754         assign
      755           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      756         .
      757       end.
      758       if v-count-fld <> v-field-num then do:
      759         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      760       end.
      761     end.
      762     return.
      763   end procedure.
      764   FUNCTION uniq-key-rec-string-f returns character(
      765      input  p-uniq-key-rec         as character):
      766   define variable v-tbl-title as character no-undo .
      767   define variable v-rec-string as character no-undo .
      768     do
      769     on error undo, return error
      770     :
      771       run get-row-keyr-string in this-procedure (
      772                                                 input p-uniq-key-rec
      773                                                 ,output v-tbl-title
      774                                                 ,output v-rec-string).
      775       assign
      776       v-rec-string = (if v-tbl-title <> ? and
      777                       v-tbl-title <> "":U
      778                       then (v-tbl-title + ":")
      779                      else "":U) + chr(32) + v-rec-string
      780       .
      781     end.
      782     return v-rec-string.
      783   end FUNCTION.
      784   procedure create_db-rec_route :
      785     define input parameter p1-uniq-key-rec as character no-undo .
      786     define input parameter p1-action       as character no-undo .
      787     define input parameter p1-operation    as character no-undo .
      788     define input parameter p1-send-db-list as character no-undo .
      789     define input parameter p1-db-init      as integer   no-undo .
      790     define input parameter p1-parameters   as character no-undo .
      791     define input parameter p1-answer-code  as integer   no-undo .
      792     define input parameter p1-answer-msg   as character no-undo .
      793     do
      794     on error undo, return error
      795     :
      796       define variable v-command     as character no-undo .
      797       define variable v-ind         as integer   no-undo .
      798       define variable v-num-entries as integer   no-undo .
      799       define variable v-curr-db     as integer   no-undo .
      800       define variable v-db-for-send as character no-undo .
      801       define variable v-db-num      as integer   no-undo .
      802       define variable v-db-num-char as character no-undo .
      803       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      804       find first buf_sys-ctrl no-lock .
      805       assign
      806         v-curr-db     = buf_sys-ctrl.db-num
      807         v-db-for-send = "":U
      808       .
      809       if v-curr-db = 0 then do:
      810         if p1-answer-code >= 0 then do:
      811           if v-curr-db <> p1-db-init then do:
      812             assign
      813               v-db-for-send = string( p1-db-init )
      814             .
      815           end.
      816         end.
      817         else do:
      818           assign
      819             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      820           .
      821           do v-ind = 1 to v-num-entries:
      822             assign
      823               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      824               v-db-num      = integer( v-db-num-char )
      825             .
      826             if v-db-num <> v-curr-db
      827               and v-db-num <> p1-db-init
      828             then do:
      829               if v-db-for-send = "":U then do:
      830                 assign
      831                   v-db-for-send = v-db-num-char
      832                 .
      833               end.
      834               else do:
      835                 assign
      836                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      837                 .
      838               end.
      839             end.
      840           end.
      841         end.
      842       end.
      843       else do:
      844         assign
      845           v-db-for-send = "0":U
      846         .
      847       end.
      848       if v-db-for-send <> "":U then do:
      849         assign
      850           v-command = "command":U + chr(1)
      851                       + "two-commit":U + chr(1)
      852                       + p1-action + chr(1)
      853                       + p1-operation + chr(1)
      854                       + p1-uniq-key-rec + chr(1)
      855                       + string( p1-db-init ) + chr(1)
      856                       + p1-parameters + chr(1)
      857                       + string( p1-answer-code ) + chr(1)
      858                       + p1-answer-msg
      859         .
      860         run nws/cr-route.p ( input 'send-cmd':U
      861                       ,input v-command
      862                       ,input ?
      863                       ,input v-db-for-send
      864                       ) no-error .
      865         if error-status :error then do:
      866           return error return-value.
      867         end.
      868       end.
      869     end.
      870     return.
      871   end procedure.
      872   procedure create_msg_route :
      873     define input parameter p2-send-db-list as character no-undo .
      874     define input parameter p2-msg          as character no-undo .
      875     do
      876     on error undo, return error
      877     :
      878       define variable v-msg-command as character no-undo .
      879       define variable v-ind         as integer   no-undo .
      880       define variable v-num-entries as integer   no-undo .
      881       define variable v-curr-db     as integer   no-undo .
      882       define variable v-db-for-send as character no-undo .
      883       define variable v-db-num      as integer   no-undo .
      884       define variable v-db-num-char as character no-undo .
      885       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      886       find first buf_sys-ctrl no-lock .
      887       assign
      888         v-curr-db     = buf_sys-ctrl.db-num
      889         v-db-for-send = "":U
      890       .
      891       if v-curr-db = 0 then do:
      892         assign
      893           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      894         .
      895         do v-ind = 1 to v-num-entries:
      896           assign
      897             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      898             v-db-num      = integer( v-db-num-char )
      899           .
      900           if v-db-num <> v-curr-db then do:
      901             if v-db-for-send = "":U then do:
      902               assign
      903                 v-db-for-send = v-db-num-char
      904               .
      905             end.
      906             else do:
      907               assign
      908                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      909               .
      910             end.
      911           end.
      912         end.
      913       end.
      914       else do:
      915         assign
      916           v-db-for-send = "0":U
      917         .
      918       end.
      919       if v-db-for-send <> "":U then do:
      920         assign
      921           v-msg-command = "command":U + chr(1)
      922                           + "message-to-log":U + chr(1)
      923                           + p2-msg
      924         .
      925         run nws/cr-route.p ( input 'send-cmd':U
      926                       ,input v-msg-command
      927                       ,input ?
      928                       ,input v-db-for-send
      929                       ) no-error .
      930         if error-status :error then do:
      931           return error substitute( "&1&2&3"
      932                                     , return-value
      933                                     , chr(10)
      934                                     , error-status :get-message(1)
      935                                   ).
      936         end.
      937       end.
      938     end.
      939     return.
      940   end procedure.
      941   function get-send-db-list returns character
      942     ( input p-curr-db     as integer
      943      ,input p-all-db-list as character
      944     )
      945   :
      946     define variable v-send-db-list as character no-undo .
      947     if p-curr-db = 0 then do:
      948       assign
      949         v-send-db-list = p-all-db-list
      950       .
      951     end.
      952     else do:
      953       assign
      954         v-send-db-list = string(p-curr-db)
      955       .
      956     end.
      957     return v-send-db-list .
      958   end function .
      959   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      960   procedure clbdattd_two-commit-del :
      961   define parameter buffer buf_clob-data for ub.clob-data.
      962   define input parameter p-error-mode as integer no-undo .
      963   define variable v-key-rec as character no-undo .
      964   define variable v-param as character no-undo .
      965   define variable v-ext-prg-handle as handle no-undo .
      966   define variable v-rec as recid no-undo .
      967   define variable l-is-used as logical   no-undo init yes.
      968   define variable v-db-num as integer no-undo .
      969   define variable v-int64-id as int64 no-undo .
      970   define variable v-curr-db as integer   no-undo .
      971   define buffer buf2_clob-data for ub.clob-data.
      972   define buffer buf_sys-ctrl for ub.sys-ctrl .
      973   define buffer buf_db-rec-attr for ub.db-rec-attr .
      974   main-block:
      975   do
      976   on error undo, return error return-value
      977   :
      978     if can-find(first ub.db where ub.db.db-num > 0) then do:
      979       run gen-key-rec( input 'clob-data':U
      980                       ,input (buffer buf_clob-data:handle )
      981                       ,output v-key-rec
      982                     ) no-error.
      983       if error-status :error then do:
      984         undo main-block, return error substitute("&1 &2 &3&4Ошибка при генерации уникального ключа для clob-data4&5&6&5&7"
      985                                                   ,vss-workfile
      986                                                   ,vss-revision
      987                                                   ,vss-description
      988                                                   , buf_clob-data.file-name_
      989                                                   ,chr(10)
      990                                                   , error-status:get-message(1)
      991                                                   , return-value ).
      992       end.
      993       assign
      994       v-param = string(buf_clob-data.db-num) + chr(4) +
      995                 string(buf_clob-data.int64-id) + chr(4) +
      996                 buf_clob-data.crc-field
      997       v-db-num = buf_clob-data.db-num
      998       v-int64-id = buf_clob-data.int64-id
      999       .
     1000       run nws/db-rec.p (
     1001                           input 'delete_nu-clob-data':U
     1002                           ,input v-key-rec
     1003                           ,input v-param
     1004                         ) no-error .
     1005       if error-status:error then do:
     1006         if p-error-mode = 0 then do:
     1007           find first buf_sys-ctrl no-lock .
     1008           assign
     1009             v-curr-db  = buf_sys-ctrl.db-num.
     1010           find first buf_db-rec-attr exclusive-lock
     1011             where buf_db-rec-attr.db-num       = v-curr-db
     1012               and buf_db-rec-attr.uniq-key-rec = v-key-rec
     1013               and buf_db-rec-attr.attr-code    = 'delete_nu-clob-data':U
     1014             no-wait no-error.
     1015           if available buf_db-rec-attr
     1016             or ( not available buf_db-rec-attr
     1017                 and locked buf_db-rec-attr
     1018               )
     1019           then do:
     1020             return.
     1021           end.
     1022         end.
     1023         else do:
     1024         undo, return error substitute("&1&2&3"
     1025                                        ,error-status:get-message(1)
     1026                                        ,chr(10)
     1027                                        , return-value ).
     1028       end.
     1029       end.
     1030       find first buf2_clob-data no-lock where
     1031                 buf2_clob-data.db-num = buf_clob-data.db-num
     1032             and buf2_clob-data.int64-id = buf_clob-data.int64-id no-error.
     1033       if available buf2_clob-data
     1034       and buf2_clob-data.crc-field > '':U
     1035       and p-error-mode = 1
     1036       then do:
     1037         message return-value
     1038         view-as alert-box .
     1039       end.
     1040     end.
     1041     else do:
     1042       run trg/clobdatt.p persistent set v-ext-prg-handle .
     1043       find current buf_clob-data  exclusive-lock.
     1044       assign
     1045       v-rec = recid(buf_clob-data)
     1046       buf_clob-data.crc-field = '':U
     1047       .
     1048       release buf_clob-data.
     1049       find first buf_clob-data where
     1050               recid(buf_clob-data) = v-rec.
     1051       run value( "proc-is-used-clob-data" ) in v-ext-prg-handle (
     1052                                                                   buffer buf_clob-data
     1053                                                                 , input g#db-num
     1054                                                                 , output l-is-used) no-error .
     1055       if not error-status:error
     1056       and not l-is-used then do:
     1057         delete buf_clob-data no-error .
     1058       end.
     1059       if valid-handle(v-ext-prg-handle) then do:
     1060         delete procedure v-ext-prg-handle  .
     1061       end.
     1062       find first buf2_clob-data no-lock where
     1063                 buf2_clob-data.db-num = buf_clob-data.db-num
     1064             and buf2_clob-data.int64-id = buf_clob-data.int64-id no-error.
     1065       if available buf2_clob-data
     1066       and buf2_clob-data.crc-field > '':U
     1067       and p-error-mode = 1
     1068       then do:
     1069         message return-value
     1070         view-as alert-box .
     1071       end.
     1072       else do:
     1073         error-status:error = no.
     1074       end.
     1075     end.
     1076     if error-status :error then do:
     1077       undo, return error substitute("Ошибка при запуске удаления clob-data &1&2&3&4&3&5"
     1078                                     ,v-db-num
     1079                                     ,v-int64-id
     1080                                     ,chr(10)
     1081                                     , error-status:get-message(1)
     1082                                     , return-value ).
     1083     end.
     1084   end.
     1085   end procedure.
     1086   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1087   procedure gen-key-rec :
     1088     define input  parameter p-tbl-name    as character no-undo.
     1089     define input  parameter p-bh_tbl-name as handle    no-undo.
     1090     define output parameter p-key-rec     as character no-undo.
     1091     do
     1092     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1093     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1094     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1095     :
     1096       define variable fh               as handle    no-undo .
     1097       define variable v-ok             as logical   no-undo .
     1098       define variable v-inform         as character no-undo .
     1099       define variable v-ind            as integer   no-undo .
     1100       define variable v-idx-field-qnty as integer   no-undo .
     1101       if p-tbl-name = ?
     1102         or p-tbl-name = "":U
     1103       then do:
     1104         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
     1105       end.
     1106       if not p-bh_tbl-name:available then do:
     1107         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
     1108       end.
     1109       assign
     1110         p-key-rec = p-tbl-name
     1111         v-inform  = p-bh_tbl-name:index-information(1)
     1112         v-ind     = 2
     1113       .
     1114       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1115       on error undo, return error
     1116       :
     1117         assign
     1118           v-inform = p-bh_tbl-name:index-information( v-ind )
     1119           v-ind    = v-ind + 1
     1120         .
     1121       end.
     1122       if v-inform = ?
     1123         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1124         or entry( 3, v-inform, ",":U ) <> "1":U
     1125       then do:
     1126         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
     1127       end.
     1128       else do:
     1129         assign
     1130           v-idx-field-qnty = num-entries( v-inform ) - 4
     1131         .
     1132         if v-idx-field-qnty < 2 then do:
     1133           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
     1134         end.
     1135         do v-ind = 1 to v-idx-field-qnty by 2
     1136         on error undo, return error
     1137         :
     1138           assign
     1139             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1140             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1141           .
     1142         end.
     1143       end.
     1144       if p-key-rec = ? then do:
     1145         assign
     1146           p-key-rec = "":U
     1147         .
     1148         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
     1149       end.
     1150     end.
     1151     return.
     1152   end procedure.
     1153   procedure gen-where-keyr-tab :
     1154     define input  parameter i-tableSerach as character no-undo.
     1155     define input  parameter i-tablekey   as character  no-undo.
     1156     define input  parameter p-key-rec    as character  no-undo.
     1157     define input  parameter p-key-handle as handle     no-undo .
     1158     define input  parameter p-db-name    as character  no-undo .
     1159     define input  parameter p-tt-handle  as handle     no-undo .
     1160     define output parameter o-Where      as character  no-undo.
     1161     do
     1162     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1163     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1164     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1165     :
     1166       define variable v-full-tbl-name  as character no-undo .
     1167       define variable bh_tbl-name      as handle    no-undo .
     1168       define variable fh_key           as handle    no-undo .
     1169       define variable fh_search        as handle    no-undo .
     1170       define variable v-field-num      as integer   no-undo .
     1171       define variable v-count-fld      as integer   no-undo .
     1172       define variable v-inform         as character no-undo .
     1173       define variable v-ind            as integer   no-undo .
     1174       define variable v-idx-field-qnty as integer   no-undo .
     1175       define variable v-field-name     as character no-undo .
     1176       define variable v-field-val      as character no-undo .
     1177       define variable v-word-link      as character no-undo .
     1178       define variable vTable           as character no-undo.
     1179       define variable bh_tbl-key       as handle    no-undo .
     1180       assign
     1181         p-key-rec = trim( p-key-rec )
     1182       .
     1183       if p-key-handle <> ? then do:
     1184         if not valid-handle(p-key-handle)
     1185            or p-key-handle:type <> "buffer"
     1186         then do:
     1187           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
     1188         end.
     1189         if num-entries( p-key-rec, chr(3) ) > 1
     1190           or p-key-rec = ?
     1191           or p-key-rec = "":U
     1192         then do:
     1193           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
     1194         end.
     1195       end.
     1196       else do:
     1197         if p-key-rec = ?
     1198           or p-key-rec = "":U
     1199         then do:
     1200           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1201         end.
     1202       end.
     1203       assign
     1204         vTable = entry( 1 , p-key-rec, chr(3) )
     1205       .
     1206       if p-tt-handle <> ?
     1207         and ( not valid-handle(p-tt-handle)
     1208               or p-tt-handle:type <> "buffer"
     1209             )
     1210       then do:
     1211         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
     1212       end.
     1213       if p-tt-handle = ? then do:
     1214         assign
     1215           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1216         .
     1217         create buffer bh_tbl-name for table v-full-tbl-name .
     1218       end.
     1219       else do:
     1220         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1221       end.
     1222       assign
     1223         v-inform = bh_tbl-name:index-information(1)
     1224         v-ind    = 2
     1225       .
     1226       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1227       on error undo, return error
     1228       :
     1229         assign
     1230           v-inform = bh_tbl-name:index-information( v-ind )
     1231           v-ind    = v-ind + 1
     1232         .
     1233       end.
     1234       if v-inform = ?
     1235         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1236         or entry( 3, v-inform, ",":U ) <> "1":U
     1237       then do:
     1238         delete object bh_tbl-name no-error.
     1239         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
     1240       end.
     1241       assign
     1242         v-idx-field-qnty = num-entries( v-inform ) - 4
     1243       .
     1244       if v-idx-field-qnty < 2 then do:
     1245         delete object bh_tbl-name no-error.
     1246         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
     1247       end.
     1248       assign
     1249         o-where     = "where":U
     1250         v-word-link = "":U
     1251         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1252         v-count-fld = 0
     1253       .
     1254       if i-tablekey ne "" and i-tablekey ne ?
     1255       then do:
     1256         assign
     1257           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1258         .
     1259         create buffer bh_tbl-key for table v-full-tbl-name .
     1260       end.
     1261       if i-tableSerach ne "" and i-tableSerach ne ?
     1262       then do:
     1263         delete object bh_tbl-name no-error.
     1264         assign
     1265           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1266         .
     1267         create buffer bh_tbl-name for table v-full-tbl-name .
     1268       end.
     1269       block_where:
     1270       do v-ind = 1 to v-idx-field-qnty by 2
     1271       on error undo, return error
     1272       :
     1273         assign
     1274           v-count-fld = v-count-fld + 1
     1275         .
     1276         if p-key-handle = ?
     1277           and v-count-fld > v-field-num
     1278         then do:
     1279           leave block_where.
     1280         end.
     1281         define variable VfieldKeyTable as handle no-undo.
     1282         assign
     1283           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1284           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1285         .
     1286         if     bh_tbl-key ne ?
     1287         then do:
     1288            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1289            if VfieldKeyTable eq ?
     1290            then next block_where.
     1291         end.
     1292         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1293         then
     1294            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1295         else
     1296            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1297         if p-key-handle = ? then do:
     1298           assign
     1299             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1300           .
     1301         end.
     1302         else do:
     1303           assign
     1304             fh_key = p-key-handle:buffer-field( v-field-name )
     1305           .
     1306           if fh_key = ?
     1307             or not valid-handle( fh_key )
     1308           then do:
     1309             delete object bh_tbl-name.
     1310             if     bh_tbl-key ne ?
     1311             then
     1312                delete object bh_tbl-key.
     1313             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1314           end.
     1315           assign
     1316             v-field-val = fh_key:buffer-value
     1317           .
     1318         end.
     1319         if fh_search:data-type ="character":U then do:
     1320           assign
     1321             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1322             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1323             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1324             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1325             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1326             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1327             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1328             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1329             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1330             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1331             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1332             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1333             v-field-val = substitute( '"&1"', v-field-val )
     1334           .
     1335         end.
     1336         assign
     1337           o-where = substitute( "&1 &2", o-where, v-field-val )
     1338         .
     1339         if v-word-link = "":U then do:
     1340           assign
     1341             v-word-link = "and":U
     1342           .
     1343         end.
     1344       end.
     1345       delete object bh_tbl-name.
     1346       if     bh_tbl-key ne ?
     1347       then
     1348          delete object bh_tbl-key.
     1349       if p-key-handle = ?
     1350         and v-count-fld <> v-field-num
     1351       then do:
     1352         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1353       end.
     1354     end.
     1355   end procedure.
     1356   procedure gen-hn-keyr-tab :
     1357     define input  parameter i-tableSerach as character no-undo.
     1358     define input  parameter i-tablekey   as character no-undo.
     1359     define input  parameter p-key-rec    as character no-undo.
     1360     define input  parameter p-key-handle as handle    no-undo .
     1361     define input  parameter p-db-name    as character no-undo .
     1362     define input  parameter p-tt-handle  as handle    no-undo .
     1363     define input  parameter p-stts-lock  as integer   no-undo .
     1364     define output parameter o-hn         as handle    no-undo.
     1365     define variable v-full-tbl-name as character no-undo.
     1366     define variable v-where         as character no-undo.
     1367     define variable bh_tbl-name     as handle    no-undo.
     1368     define variable vTable          as character no-undo.
     1369     do
     1370     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1371     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1372     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1373         run gen-where-keyr-tab(i-tableSerach,
     1374                                i-tablekey,
     1375                                p-key-rec,
     1376                                p-key-handle,
     1377                                p-db-name,
     1378                                p-tt-handle,
     1379                                output v-where).
     1380         if i-tableSerach ne "" and i-tableSerach ne ?
     1381         then do:
     1382            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1383            create buffer bh_tbl-name for table v-full-tbl-name .
     1384         end.
     1385         else do:
     1386            if p-tt-handle = ? then do:
     1387               assign
     1388                  vTable = entry( 1 , p-key-rec, chr(3) )
     1389               .
     1390               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1391               create buffer bh_tbl-name for table v-full-tbl-name .
     1392            end.
     1393            else do:
     1394               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1395            end.
     1396         end.
     1397         if p-tt-handle = ? then do:
     1398            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1399         end.
     1400         else do:
     1401            bh_tbl-name:find-first( v-where ) no-error .
     1402         end.
     1403         o-hn = bh_tbl-name.
     1404      end.
     1405   end procedure.
     1406   procedure gen-hn-keyr :
     1407     define input  parameter p-key-rec    as character no-undo.
     1408     define input  parameter p-key-handle as handle    no-undo .
     1409     define input  parameter p-db-name    as character no-undo .
     1410     define input  parameter p-tt-handle  as handle    no-undo .
     1411     define input  parameter p-stts-lock  as integer   no-undo .
     1412     define output parameter o-hn         as handle    no-undo.
     1413     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1414   end.
     1415   procedure gen-row-keyr :
     1416     define input  parameter p-key-rec    as character no-undo.
     1417     define input  parameter p-key-handle as handle    no-undo .
     1418     define input  parameter p-db-name    as character no-undo .
     1419     define input  parameter p-tt-handle  as handle    no-undo .
     1420     define input  parameter p-stts-lock  as integer   no-undo .
     1421     define output parameter p-tbl-row    as rowid     no-undo.
     1422     define output parameter p-tbl-name   as character no-undo.
     1423     define variable vHn as handle no-undo.
     1424       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1425       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1426       p-tbl-name =  vHn:table.
     1427       delete object vHn no-error.
     1428     if p-tbl-row = ? then do:
     1429       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1430     end.
     1431     else do:
     1432       return.
     1433     end.
     1434   end procedure.
     1435   procedure gen-key-fv :
     1436     define input  parameter p-key-rec    as character no-undo .
     1437     define output parameter p-field-list as character no-undo .
     1438     define output parameter p-value-list as character no-undo.
     1439     do
     1440     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1441     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1442     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1443     :
     1444       define variable v-full-tbl-name  as character no-undo .
     1445       define variable bh_tbl-name      as handle    no-undo .
     1446       define variable v-tbl-name       as character no-undo .
     1447       define variable v-field-num      as integer   no-undo .
     1448       define variable v-count-fld      as integer   no-undo .
     1449       define variable v-inform         as character no-undo .
     1450       define variable v-ind            as integer   no-undo .
     1451       define variable v-idx-field-qnty as integer   no-undo .
     1452       define variable v-delim-key      as character no-undo .
     1453       if p-key-rec = ?
     1454         or p-key-rec = "":U
     1455       then do:
     1456         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1457       end.
     1458       assign
     1459         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1460         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1461       .
     1462       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1463       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1464       assign
     1465         v-inform = bh_tbl-name:index-information(1)
     1466         v-ind    = 2
     1467       .
     1468       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1469       on error undo, return error
     1470       :
     1471         assign
     1472           v-inform = bh_tbl-name:index-information( v-ind )
     1473           v-ind    = v-ind + 1
     1474         .
     1475       end.
     1476       if v-inform = ?
     1477         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1478         or entry( 3, v-inform, ",":U ) <> "1":U
     1479       then do:
     1480         delete object bh_tbl-name no-error.
     1481         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1482       end.
     1483       assign
     1484         v-idx-field-qnty = num-entries( v-inform ) - 4
     1485       .
     1486       if v-idx-field-qnty < 2 then do:
     1487         delete object bh_tbl-name no-error.
     1488         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1489       end.
     1490       assign
     1491         p-field-list = "":U
     1492         p-value-list = "":U
     1493         v-delim-key  = "":U
     1494         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1495         v-count-fld  = 0
     1496       .
     1497       block_where:
     1498       do v-ind = 1 to v-idx-field-qnty by 2
     1499       on error undo, return error
     1500       :
     1501         assign
     1502           v-count-fld = v-count-fld + 1
     1503         .
     1504         if v-count-fld > v-field-num then do:
     1505           leave block_where.
     1506         end.
     1507         assign
     1508           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1509           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1510         .
     1511         if v-ind = 1 then do:
     1512           assign
     1513             v-delim-key = chr(3)
     1514           .
     1515         end.
     1516       end.
     1517       delete object bh_tbl-name.
     1518       if v-count-fld <> v-field-num then do:
     1519         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1520       end.
     1521     end.
     1522   end procedure.
     1523   procedure gen-key-field :
     1524     define input  parameter p-table      as character no-undo .
     1525     define output parameter p-field-list as character no-undo .
     1526     do
     1527     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1528     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1529     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1530     :
     1531       define variable v-full-tbl-name  as character no-undo .
     1532       define variable bh_tbl-name      as handle    no-undo .
     1533       define variable v-tbl-name       as character no-undo .
     1534       define variable v-field-num      as integer   no-undo .
     1535       define variable v-count-fld      as integer   no-undo .
     1536       define variable v-inform         as character no-undo .
     1537       define variable v-ind            as integer   no-undo .
     1538       define variable v-idx-field-qnty as integer   no-undo .
     1539       define variable v-delim-key      as character no-undo .
     1540       if p-table = ?
     1541         or p-table = "":U
     1542       then do:
     1543         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1544       end.
     1545       assign
     1546         v-tbl-name      = p-table
     1547         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1548       .
     1549       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1550       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1551       assign
     1552         v-inform = bh_tbl-name:index-information(1)
     1553         v-ind    = 2
     1554       .
     1555       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1556       on error undo, return error
     1557       :
     1558         assign
     1559           v-inform = bh_tbl-name:index-information( v-ind )
     1560           v-ind    = v-ind + 1
     1561         .
     1562       end.
     1563       if v-inform = ?
     1564         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1565         or entry( 3, v-inform, ",":U ) <> "1":U
     1566       then do:
     1567         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1568       end.
     1569       assign
     1570         v-idx-field-qnty = num-entries( v-inform ) - 4
     1571       .
     1572       if v-idx-field-qnty < 2 then do:
     1573         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1574       end.
     1575       assign
     1576         p-field-list = "":U
     1577         v-delim-key  = "":U
     1578         v-count-fld  = 0
     1579       .
     1580       block_where:
     1581       do v-ind = 1 to v-idx-field-qnty by 2
     1582       on error undo, return error
     1583       :
     1584         assign
     1585           v-count-fld = v-count-fld + 1
     1586         .
     1587         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1588         if v-ind = 1 then do:
     1589           assign
     1590             v-delim-key = chr(3)
     1591           .
     1592         end.
     1593       end.
     1594       delete object bh_tbl-name.
     1595     end.
     1596   end procedure.
     1597   define variable v-gate-tables as character no-undo.
     1598   define variable v-gate-table-names as character no-undo.
     1599   define variable v-sys-key as character no-undo .
     1600   define variable v-ibs as logical no-undo .
     1601   define variable glog as logical no-undo .
     1602   define variable del-option as character no-undo.
     1603   DEFINE MENU MENU-b-del
     1604          MENU-ITEM m_clob-data    LABEL "CLOB-DATA"
     1605          MENU-ITEM m_clob-bind    LABEL "clob-bind"
     1606          MENU-ITEM m_both         LABEL "Обоих"         .
     1607   DEFINE BUTTON b-add
     1608        LABEL "&Добавить"
     1609        SIZE 10 BY 1.
     1610   DEFINE BUTTON b-chg
     1611        LABEL "&Изменить"
     1612        SIZE 10 BY 1.
     1613   DEFINE BUTTON b-del
     1614        LABEL "&Удалить"
     1615        SIZE 10 BY 1.
     1616   DEFINE BUTTON b-export
     1617        LABEL "Экспорт"
     1618        SIZE 10 BY 1.
     1619   DEFINE BUTTON B-Help
     1620        LABEL "Помо&щь"
     1621        SIZE 3 BY 1
     1622        BGCOLOR 8 .
     1623   DEFINE BUTTON b-lkp
     1624        LABEL "Просмотр"
     1625        SIZE 10 BY 1.
     1626   DEFINE BUTTON b-quit AUTO-END-KEY
     1627        LABEL "&Выход"
     1628        SIZE 10 BY 1
     1629        BGCOLOR 8 .
     1630   DEFINE BUTTON b-version
     1631        LABEL "Уст.верc."
     1632        SIZE 10 BY 1.
     1633   DEFINE VARIABLE E-descr AS CHARACTER
     1634        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1635        SIZE 98 BY 2 NO-UNDO.
     1636   DEFINE QUERY br-gates FOR
     1637         X_clob-bind,
     1638         X_clob-data SCROLLING.
     1639   DEFINE BROWSE br-gates
     1640     QUERY br-gates NO-LOCK DISPLAY
     1641         X_clob-bind.uniq-key-rec column-label "Файл" format "X(40)"
     1642   (X_clob-bind.int64-id = X_clob-data.int64-id) column-label "Тек" format "+/"
     1643   X_clob-data.int64-id column-label "id связки"
     1644   (if (X_clob-bind.int64-id = X_clob-data.int64-id)
     1645   then X_clob-bind.sys-date
     1646   else ?) column-label "Дата!связки" format "99/99/9999"
     1647   (if (X_clob-bind.int64-id = X_clob-data.int64-id)
     1648   then X_clob-bind.sys-time
     1649   else '') column-label "Время!связки" format "X(8)"
     1650   (if (X_clob-bind.int64-id = X_clob-data.int64-id)
     1651   then X_clob-bind.user-name
     1652   else '') column-label "Изменил!связку" format "X(8)"
     1653   X_clob-data.int64-id column-label "id cdata"
     1654   X_clob-data.crc-field column-label "MD5"
     1655   X_clob-data.file-size column-label "Длина файла"
     1656   X_clob-data.sys-date column-label "Дата!cdata" format "99/99/9999"
     1657   X_clob-data.sys-time column-label "Время!cdata" format "X(8)"
     1658   X_clob-data.user-name column-label "Изменил!cdata" format "X(8)"
     1659       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.27 FIT-LAST-COLUMN.
     1660   DEFINE FRAME Dialog-Frame
     1661        b-quit AT ROW 1 COL 1
     1662        b-add AT ROW 1 COL 31 WIDGET-ID 2
     1663        b-chg AT ROW 1 COL 41 WIDGET-ID 4
     1664        b-lkp AT ROW 1 COL 51 WIDGET-ID 12
     1665        b-del AT ROW 1 COL 61 WIDGET-ID 6
     1666        b-version AT ROW 1 COL 71 WIDGET-ID 14
     1667        b-export AT ROW 1 COL 81 WIDGET-ID 8
     1668        B-Help AT ROW 1 COL 95
     1669        br-gates AT ROW 3 COL 1 WIDGET-ID 100
     1670        E-descr AT ROW 21.27 COL 1 NO-LABEL WIDGET-ID 10
     1671       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1672            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1673            TITLE "Список гейтов, имеющихся в системе"
     1674            CANCEL-BUTTON b-quit.
     1675   ASSIGN
     1676          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1677          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1678   ASSIGN
     1679          b-del:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-del:HANDLE.
     1680   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1681   DO:
     1682     APPLY "END-ERROR":U TO SELF.
     1683   END.
     1684   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1685   DO:
     1686     run proc-b-add in this-procedure no-error.
     1687   END.
     1688   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1689   DO:
     1690     if not available X_clob-bind then undo, return no-apply.
     1691     run proc-b-chg in this-procedure no-error.
     1692   END.
     1693   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1694   DO:
     1695     define variable v-rec as recid no-undo.
     1696     if not available X_clob-bind
     1697     and not available X_clob-data
     1698     then undo, return no-apply.
     1699     IF del-option = '':U THEN DO:
     1700       run gbl/pop-up.p ( INPUT SELF :handle, input no ) no-error.
     1701       if error-status :error then do: return no-apply. end.
     1702     end.
     1703     if del-option = "":U then do:
     1704         return no-apply.
     1705     end.
     1706     run proc-b-del in this-procedure ( input del-option) no-error.
     1707   END.
     1708   ON CHOOSE OF b-export IN FRAME Dialog-Frame
     1709   DO:
     1710     define variable v-file-name as character no-undo .
     1711   define variable v-old-file-name as character no-undo .
     1712   define variable v-dir-name as character no-undo .
     1713   define variable v-yesno as logical no-undo .
     1714   define variable v-mode-log as logical no-undo .
     1715   define variable v-mode as character no-undo .
     1716   message
     1717   "??Хотите экспортировать уникальное имя каждой записи (uniq-key-rec)?"
     1718   view-as alert-box question buttons yes-no-cancel update v-mode-log.
     1719   if v-mode-log = ? then return no-apply.
     1720   if v-mode-log then do:
     1721     v-mode = "full".
     1722   end.
     1723   message
     1724   "Хотите экспортировать ПОЛНУЮ конфигурацию GATE" skip
     1725   "или только измененные записи?"
     1726   view-as alert-box question buttons yes-no-cancel update v-yesno.
     1727   if v-yesno = ? then return no-apply.
     1728   if v-yesno = no then do:
     1729     run gbl/d-file.p (
     1730           input-output v-old-file-name
     1731         , input-output v-dir-name
     1732         , input  (" Все файлы txt (*.txt) ")
     1733         , input  ("*.txt":U)
     1734         , input  chr(44)
     1735         , input  (".txt":U)
     1736         , input  yes
     1737         , input  no
     1738         , input  yes
     1739         , input  "Введите имя старого файла (для сравнения)"
     1740         , output v-yesno
     1741     ) no-error.
     1742     if error-status:error
     1743     or v-yesno = no then return no-apply.
     1744   end.
     1745   v-yesno = no.
     1746     run gbl/d-file.p (
     1747           input-output v-file-name
     1748         , input-output v-dir-name
     1749         , input  (" Все файлы? txt (*.txt) ")
     1750         , input  ("*.txt":U)
     1751         , input  chr(44)
     1752         , input  (".txt":U)
     1753         , input  no
     1754         , input  yes
     1755         , input  yes
     1756         , input  "Введите имя файла для экспорта"
     1757         , output v-yesno
     1758     ) no-error.
     1759     if error-status:error
     1760     or v-yesno = no then return no-apply.
     1761     run utl/export-current-gate.p (
     1762                                    input v-file-name
     1763                                   ,input v-old-file-name
     1764                                   ,input v-mode
     1765                                  ) NO-ERROR.
     1766     IF ERROR-STATUS:ERROR THEN DO:
     1767        MESSAGE
     1768        ERROR-STATUS:GET-MESSAGE(1) SKIP
     1769        RETURN-VALUE
     1770        VIEW-AS ALERT-BOX.
     1771        RETURN NO-APPLY.
     1772     END.
     1773     define variable v-md5-signature as character no-undo .
     1774     define variable v-full-file-name          as character                no-undo .
     1775     define variable v-path                    as character                no-undo .
     1776     DEFINE VARIABLE v-full-path               as character                no-undo .
     1777     DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1778     DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1779     run gbl/md5.p ( input v-file-name
     1780                    ,output v-md5-signature ) .
     1781     run gbl/filename.p (
     1782                    input v-file-name
     1783                   ,output v-full-path
     1784                   ,output v-path
     1785                   ,output v-full-file-name
     1786                   ,output v-file-name-no-ext
     1787                   ,output v-file-name-ext
     1788                   ) no-error .
     1789     if error-status:error then do:
     1790       message
     1791       return-value
     1792       view-as alert-box ERROR.
     1793       return.
     1794     end.
     1795     output to value(v-path + chr(47) + v-file-name-no-ext + ".md5").
     1796     put unformatted v-md5-signature skip.
     1797     output close.
     1798   END.
     1799   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1800   DO:
     1801       define variable v-longchar as longchar no-undo .
     1802       define variable v-ok as logical no-undo .
     1803       if not available X_clob-data then return no-apply.
     1804       v-longchar = X_clob-data.cdata.
     1805       run gbl/d-longchar.w (
     1806                              input ?
     1807                             ,input (
     1808                                       'title=':u + X_clob-data.file-name_ + '\':u
     1809                                     + 'Editor_row=2\':u
     1810                                     + 'Editor_col=1\':u
     1811                                     + 'Editor_width=96\':u
     1812                                     + 'Editor_height=15\':u
     1813                                     + 'readonly=yes\':u)
     1814                             ,input-output v-longchar
     1815                             ,output v-ok ) no-error .
     1816       assign
     1817       v-longchar = '':U.
     1818   END.
     1819   ON CHOOSE OF b-version IN FRAME Dialog-Frame
     1820   DO:
     1821     run proc-b-vers in this-procedure no-error.
     1822     if error-status:error then return no-apply.
     1823   END.
     1824   ON VALUE-CHANGED OF br-gates IN FRAME Dialog-Frame
     1825   DO:
     1826     if available X_clob-bind then do:
     1827       e-descr:screen-value = X_clob-bind.descr.
     1828     end.
     1829     else do:
     1830       e-descr:screen-value = "".
     1831     end.
     1832   END.
     1833   ON CHOOSE OF MENU-ITEM m_both
     1834   DO:
     1835       ASSIGN
     1836     del-option = "both".
     1837     run proc-b-del IN THIS-PROCEDURE ( INPUT del-option) NO-ERROR.
     1838     ASSIGN
     1839     del-option = '':U.
     1840     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1841   END.
     1842   ON CHOOSE OF MENU-ITEM m_clob-bind
     1843   DO:
     1844        ASSIGN
     1845     del-option = 'clob-bind':U.
     1846     run proc-b-del IN THIS-PROCEDURE ( INPUT del-option) NO-ERROR.
     1847     ASSIGN
     1848     del-option = '':U.
     1849     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1850   END.
     1851   ON CHOOSE OF MENU-ITEM m_clob-data
     1852   DO:
     1853          ASSIGN
     1854     del-option = 'clob-data':U.
     1855     run proc-b-del IN THIS-PROCEDURE ( INPUT del-option) NO-ERROR.
     1856     ASSIGN
     1857     del-option = '':U.
     1858     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1859   END.
     1860   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1861   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1862   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1863   on help of frame Dialog-Frame
     1864   do:
     1865     run gbl/app_help.p
     1866       (input this-procedure :file-name
     1867       ,input ''
     1868       ,input ?
     1869       ) no-error.
     1870     if error-status :error then do:
     1871       message
     1872         "Ошибка при вызове помощи"
     1873         error-status :get-message(1)
     1874         view-as alert-box .
     1875     end.
     1876   end.
     1877   run minbtn-set in this-procedure .
     1878   on choose of b-help in frame Dialog-Frame
     1879   do:
     1880     apply "help":u to frame Dialog-Frame .
     1881   end.
     1882   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1883   procedure minbtn-set :
     1884       do
     1885           on error undo, return error return-value
     1886           :
     1887           define variable ii              as integer       no-undo .
     1888           define variable fh              as widget-handle no-undo .
     1889           define variable hh              as widget-handle no-undo .
     1890           define variable v-h             as handle        extent 4 no-undo .
     1891           define variable v-name-button   as character     no-undo .
     1892           define variable v-help-old-x    as decimal       no-undo .
     1893           define variable v-help-old-y    as decimal       no-undo .
     1894           define variable v-help-old-size as decimal       no-undo .
     1895           define variable v-frame-width   as decimal       no-undo .
     1896           define variable jj              as integer       no-undo .
     1897           do
     1898               on error undo, return error
     1899               :
     1900               assign
     1901                   v-frame-width = frame Dialog-Frame:width - 0.3
     1902                   fh            = frame Dialog-Frame:first-child
     1903                   hh            = fh:first-child
     1904                   ii            = 1
     1905                   .
     1906               do while valid-handle(hh):
     1907                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1908                   do:
     1909                       case lc(hh:name) :
     1910                           when "b-help" then
     1911                               do:
     1912                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1913                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1914                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1915                                   hh:TOOLTIP = "Помощь" .
     1916                                   v-help-old-x = hh:column .
     1917                                   v-help-old-y = hh:row    .
     1918                                   v-help-old-size = hh:width .
     1919                                   hh:width-chars = 2.5 .
     1920                               end.
     1921                           when "b-print" then
     1922                               do:
     1923                                   hh:load-image("cmp/b-print.bmp":u) .
     1924                                   hh:TOOLTIP = "Печать" .
     1925                                   v-h[ii] = hh:handle .
     1926                                   ii = ii + 1 .
     1927                                   hh:width-chars = 3 .
     1928                               end.
     1929                           when "b-history" or
     1930                           when "b-hist" then
     1931                               do:
     1932                                   hh:load-image("cmp/b-hist.bmp":u) .
     1933                                   hh:TOOLTIP = "История" .
     1934                                   v-h[ii] = hh:handle .
     1935                                   ii = ii + 1 .
     1936                                   hh:width-chars = 3 .
     1937                               end.
     1938                           when "b-sch" then
     1939                               do:
     1940                                   hh:load-image("cmp/b-sch.bmp":u) .
     1941                                   hh:TOOLTIP = "Установка Фильтра" .
     1942                                   v-h[ii] = hh:handle .
     1943                                   ii = ii + 1 .
     1944                                   hh:width-chars = 3 .
     1945                               end.
     1946                           when "b-hist-user" then
     1947                               do:
     1948                                   hh:load-image("cmp/b-hist.bmp":u) .
     1949                                   hh:TOOLTIP = "История пользователя" .
     1950                                   ii = ii + 1 .
     1951                               end.
     1952                       end case.
     1953                   end.
     1954                   hh = hh:next-sibling.
     1955               end.
     1956               b-help:column = v-frame-width - b-help:width-chars.
     1957               jj = 0.
     1958               repeat ii = 4 to 1 by -1 :
     1959                   if valid-handle (v-h[ii] ) then
     1960                   do:
     1961                       jj  = jj + 1 .
     1962                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1963                       v-h[ii]:row    = v-help-old-y .
     1964                   end.
     1965               end.
     1966           end.
     1967       end.
     1968   end procedure.
     1969   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1970   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1971   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1972   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1973   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1974   define variable v-diasize-current-frame-height as decimal   no-undo .
     1975   define variable v-diasize-change-size          as logical   no-undo .
     1976   define variable v-diasize-resize-button        as handle    no-undo .
     1977   define variable v-diasize-wndmax               as logical   no-undo .
     1978   define variable v-diasize-wndstore             as logical   no-undo .
     1979   define variable v-diasize-proc-name            as character no-undo .
     1980   define variable v-diasize-browse-handle        as handle    no-undo .
     1981   define variable v-diasize-browse-number        as integer   no-undo .
     1982   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1983   define temp-table temp-diasize-handle no-undo
     1984     field handle-value  as handle
     1985     field save-position as decimal
     1986     index xpk is primary unique handle-value
     1987     .
     1988   define temp-table temp-browse-handle no-undo
     1989     field browse-type   as character
     1990     field browse-number as integer
     1991     field browse-handle as handle
     1992     field original-size as decimal
     1993     index xpk is primary unique browse-type browse-number
     1994     index xie browse-type browse-handle
     1995   .
     1996   procedure diasize_change-height :
     1997     define input  parameter p-change-value  as decimal   no-undo .
     1998     define input  parameter p-move-resize   as logical   no-undo .
     1999     define variable v-field-group-handle    as handle    no-undo .
     2000     define variable v-object-handle         as handle    no-undo .
     2001     define variable v-frame-height          as decimal   no-undo .
     2002     define variable v-frame-virtual-height  as decimal   no-undo .
     2003     define variable v-browse-height         as decimal   no-undo .
     2004     define variable v-window-height         as decimal   no-undo .
     2005     define variable v-window-virtual-height as decimal   no-undo .
     2006     define variable v-change-sign           as integer   no-undo .
     2007     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2008     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2009     if p-change-value > 0
     2010     then do:
     2011       if frame Dialog-Frame :height + p-change-value
     2012           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2013       then do:
     2014         assign
     2015           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2016                           - (frame Dialog-Frame :height-chars)
     2017         .
     2018         if p-change-value <= 0
     2019         then do:
     2020           run diasize_position-resize-button in this-procedure .
     2021           return .
     2022         end.
     2023       end.
     2024     end.
     2025     if p-change-value < 0
     2026     then do:
     2027       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2028       then do:
     2029         assign
     2030           p-change-value = v-diasize-orig-frame-height
     2031                          - (frame Dialog-Frame :height-chars)
     2032         .
     2033         if p-change-value >= 0
     2034         then do:
     2035           run diasize_position-resize-button in this-procedure .
     2036           return .
     2037         end.
     2038       end.
     2039     end.
     2040     if p-change-value >= 0
     2041     then do:
     2042       assign
     2043         v-change-sign = 1
     2044       .
     2045     end.
     2046     else do:
     2047       assign
     2048         v-change-sign = -1
     2049       .
     2050     end.
     2051     assign
     2052       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2053     .
     2054     if p-change-value = 0
     2055     then do:
     2056       run diasize_position-resize-button in this-procedure .
     2057       return .
     2058     end.
     2059     move_block:
     2060     do
     2061     on error undo move_block, retry move_block
     2062     :
     2063       if retry
     2064       then do:
     2065         do
     2066         on error undo move_block, leave move_block
     2067         :
     2068           if p-change-value > 0
     2069           then do:
     2070             for each buf_temp-diasize-handle
     2071             on error undo, next
     2072             :
     2073               assign
     2074                 v-object-handle = buf_temp-diasize-handle.handle-value
     2075               .
     2076               if v-object-handle <> v-diasize-resize-button
     2077               then do:
     2078                 assign
     2079                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2080                 .
     2081               end.
     2082             end.
     2083             assign
     2084               v-diasize-browse-handle :height = v-browse-height
     2085             .
     2086             for each buf_temp-browse-handle
     2087               where buf_temp-browse-handle.browse-type = 'height':u
     2088             on error undo, next
     2089             :
     2090               assign
     2091                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2092               .
     2093             end.
     2094             assign
     2095               frame Dialog-Frame :height = v-frame-height
     2096             .
     2097             if frame Dialog-Frame :scrollable = true
     2098             then do:
     2099               assign
     2100                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2101               .
     2102             end.
     2103             run diasize_position-resize-button in this-procedure .
     2104           end.
     2105           else do:
     2106             if frame Dialog-Frame :scrollable = true
     2107             then do:
     2108               assign
     2109                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2110               .
     2111             end.
     2112             assign
     2113               frame Dialog-Frame :height = v-frame-height
     2114             .
     2115             assign
     2116               v-diasize-browse-handle :height = v-browse-height
     2117             .
     2118             for each buf_temp-browse-handle
     2119               where buf_temp-browse-handle.browse-type = 'height':u
     2120             on error undo, next
     2121             :
     2122               assign
     2123                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2124               .
     2125             end.
     2126             for each buf_temp-diasize-handle
     2127             on error undo, next
     2128             :
     2129               assign
     2130                 v-object-handle = buf_temp-diasize-handle.handle-value
     2131               .
     2132               if v-object-handle <> v-diasize-resize-button
     2133               then do:
     2134                 assign
     2135                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2136                 .
     2137               end.
     2138             end.
     2139             run diasize_position-resize-button in this-procedure .
     2140           end.
     2141           assign
     2142             v-diasize-change-size = false
     2143           .
     2144           leave move_block .
     2145         end.
     2146       end.
     2147       assign
     2148         v-diasize-need-full-display = true
     2149       .
     2150       if v-diasize-change-size = false
     2151       then do:
     2152         assign
     2153           v-diasize-change-size = true
     2154         .
     2155       end.
     2156       else do:
     2157         return .
     2158       end.
     2159       assign
     2160         v-frame-height = frame Dialog-Frame :height
     2161         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2162         v-browse-height = v-diasize-browse-handle :height
     2163       .
     2164       for each buf_temp-browse-handle
     2165         where buf_temp-browse-handle.browse-type = 'height':u
     2166       :
     2167         assign
     2168           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2169         .
     2170       end.
     2171       for each buf_temp-diasize-handle
     2172       :
     2173         delete buf_temp-diasize-handle .
     2174       end.
     2175       assign
     2176         v-field-group-handle = frame Dialog-Frame :first-child
     2177       .
     2178       do while valid-handle(v-field-group-handle)
     2179       :
     2180         assign
     2181           v-object-handle = v-field-group-handle :first-child
     2182         .
     2183         do while valid-handle(v-object-handle)
     2184         :
     2185           if  v-object-handle <> v-diasize-browse-handle :handle
     2186           and can-query(v-object-handle, "row")
     2187           and can-query(v-object-handle, "height")
     2188           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2189           then do:
     2190             find first buf_temp-browse-handle
     2191               where buf_temp-browse-handle.browse-type   = 'height':u
     2192                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2193               no-error .
     2194             if available buf_temp-browse-handle
     2195             then do:
     2196             end.
     2197             else do:
     2198               create buf_temp-diasize-handle .
     2199               assign
     2200                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2201                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2202               .
     2203             end.
     2204           end.
     2205           assign
     2206             v-object-handle = v-object-handle :next-sibling
     2207           .
     2208         end.
     2209         assign
     2210           v-field-group-handle = v-field-group-handle :next-sibling
     2211         .
     2212       end.
     2213       do with frame Dialog-Frame
     2214       :
     2215         hide v-diasize-resize-button .
     2216         assign
     2217           v-diasize-resize-button :row    = 1
     2218           v-diasize-resize-button :column = 1
     2219         .
     2220       end.
     2221       if p-change-value > 0
     2222       then do:
     2223         if frame Dialog-Frame :scrollable = true
     2224         then do:
     2225           assign
     2226             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2227             no-error .
     2228           if error-status :error
     2229           or error-status :get-message(1) <> ""
     2230           then do:
     2231             undo move_block, retry move_block .
     2232           end.
     2233         end.
     2234         assign
     2235           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2236           no-error .
     2237         if error-status :error
     2238         or error-status :get-message(1) <> ""
     2239         then do:
     2240           undo move_block, retry move_block .
     2241         end.
     2242         assign
     2243           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2244           no-error .
     2245         if error-status :error
     2246         or error-status :get-message(1) <> ""
     2247         then do:
     2248           undo move_block, retry move_block .
     2249         end.
     2250         for each buf_temp-browse-handle
     2251           where buf_temp-browse-handle.browse-type = 'height':u
     2252         on error undo move_block, retry move_block
     2253         :
     2254           assign
     2255             buf_temp-browse-handle.browse-handle :height
     2256               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2257             no-error .
     2258           if error-status :error
     2259           or error-status :get-message(1) <> ""
     2260           then do:
     2261             undo move_block, retry move_block .
     2262           end.
     2263         end.
     2264         for each buf_temp-diasize-handle
     2265         on error undo move_block, retry move_block
     2266         :
     2267           assign
     2268             v-object-handle = buf_temp-diasize-handle.handle-value
     2269           .
     2270           if v-object-handle <> v-diasize-resize-button
     2271           then do:
     2272             assign
     2273               v-object-handle :row = v-object-handle :row + p-change-value
     2274               no-error .
     2275             if error-status :error
     2276             or error-status :get-message(1) <> ""
     2277             then do:
     2278               undo move_block, retry move_block .
     2279             end.
     2280           end.
     2281         end.
     2282       end.
     2283       else do:
     2284         for each buf_temp-diasize-handle
     2285         on error undo move_block, retry move_block
     2286         :
     2287           assign
     2288             v-object-handle = buf_temp-diasize-handle.handle-value
     2289           .
     2290           if v-object-handle <> v-diasize-resize-button
     2291           then do:
     2292             assign
     2293               v-object-handle :row = v-object-handle :row + p-change-value
     2294               no-error .
     2295             if error-status :error
     2296             or error-status :get-message(1) <> ""
     2297             then do:
     2298               undo move_block, retry move_block .
     2299             end.
     2300           end.
     2301         end.
     2302         assign
     2303           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2304           no-error .
     2305         if error-status :error
     2306         or error-status :get-message(1) <> ""
     2307         then do:
     2308           undo move_block, retry move_block .
     2309         end.
     2310         for each buf_temp-browse-handle
     2311           where buf_temp-browse-handle.browse-type = 'height':u
     2312         on error undo move_block, retry move_block
     2313         :
     2314           assign
     2315             buf_temp-browse-handle.browse-handle :height
     2316               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2317             no-error .
     2318           if error-status :error
     2319           or error-status :get-message(1) <> ""
     2320           then do:
     2321             undo move_block, retry move_block .
     2322           end.
     2323         end.
     2324         assign
     2325           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2326           no-error .
     2327         if error-status :error
     2328         or error-status :get-message(1) <> ""
     2329         then do:
     2330           undo move_block, retry move_block .
     2331         end.
     2332         if frame Dialog-Frame :scrollable = true
     2333         then do:
     2334           assign
     2335             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2336             no-error .
     2337           if error-status :error
     2338           or error-status :get-message(1) <> ""
     2339           then do:
     2340             undo move_block, retry move_block .
     2341           end.
     2342         end.
     2343       end.
     2344       if p-move-resize = true
     2345       then do:
     2346         run diasize_position-resize-button in this-procedure .
     2347       end.
     2348       if v-diasize-wndstore = true
     2349       then do:
     2350         if connected("ub") = true
     2351         then do:
     2352           define variable v-cntxt-db-num        as integer   no-undo .
     2353           define variable v-cntxt-userid        as character no-undo .
     2354           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2355                                             , OUTPUT v-cntxt-userid
     2356                                             ) .
     2357           run gbl/wndsizew.p
     2358             (input  v-cntxt-db-num
     2359             ,input  v-cntxt-userid
     2360             ,input  v-diasize-proc-name
     2361             ,input  'height':u
     2362             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2363             ) .
     2364         end.
     2365       end.
     2366     end.
     2367     assign
     2368       v-diasize-change-size = false
     2369     .
     2370   end procedure.
     2371   procedure diasize_set-height :
     2372     define input  parameter p-new-height  as decimal   no-undo .
     2373     define input  parameter p-move-resize as logical   no-undo .
     2374     do
     2375     on error undo, return error return-value
     2376     :
     2377       run diasize_change-height in this-procedure
     2378         (input  (p-new-height - frame Dialog-Frame :height)
     2379         ,input  p-move-resize
     2380         ) .
     2381     end.
     2382   end procedure.
     2383   procedure diasize_change-width :
     2384     define input  parameter p-change-value as decimal   no-undo .
     2385     define input  parameter p-move-resize  as logical   no-undo .
     2386     define variable v-field-group-handle   as handle    no-undo .
     2387     define variable v-object-handle        as handle    no-undo .
     2388     define variable v-frame-width          as decimal   no-undo .
     2389     define variable v-frame-virtual-width  as decimal   no-undo .
     2390     define variable v-browse-width         as decimal   no-undo .
     2391     define variable v-window-width         as decimal   no-undo .
     2392     define variable v-window-virtual-width as decimal   no-undo .
     2393     define variable v-change-sign          as integer   no-undo .
     2394     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2395     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2396     if p-change-value > 0
     2397     then do:
     2398       if frame Dialog-Frame :width + p-change-value >
     2399           session :width-chars
     2400       then do:
     2401         assign
     2402           p-change-value = session :width-chars - frame Dialog-Frame :width
     2403         .
     2404         if p-change-value <= 0
     2405         then do:
     2406           run diasize_position-resize-button in this-procedure .
     2407           return .
     2408         end.
     2409       end.
     2410     end.
     2411     if p-change-value < 0
     2412     then do:
     2413       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2414       then do:
     2415         assign
     2416           p-change-value = v-diasize-orig-frame-width
     2417                          - frame Dialog-Frame :width
     2418         .
     2419         if p-change-value >= 0
     2420         then do:
     2421           run diasize_position-resize-button in this-procedure .
     2422           return .
     2423         end.
     2424       end.
     2425     end.
     2426     if p-change-value >= 0
     2427     then do:
     2428       assign
     2429         v-change-sign = 1
     2430       .
     2431     end.
     2432     else do:
     2433       assign
     2434         v-change-sign = -1
     2435       .
     2436     end.
     2437     assign
     2438       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2439     .
     2440     if p-change-value = 0
     2441     then do:
     2442       run diasize_position-resize-button in this-procedure .
     2443       return .
     2444     end.
     2445     move_block:
     2446     do
     2447     on error undo move_block, leave move_block
     2448     :
     2449       if retry
     2450       then do:
     2451         do
     2452         on error undo move_block, leave move_block
     2453         :
     2454           if p-change-value > 0
     2455           then do:
     2456             for each buf_temp-diasize-handle
     2457             on error undo, next
     2458             :
     2459               assign
     2460                 v-object-handle = buf_temp-diasize-handle.handle-value
     2461               .
     2462               if v-object-handle <> v-diasize-resize-button
     2463               then do:
     2464                 assign
     2465                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2466                 .
     2467               end.
     2468             end.
     2469             assign
     2470               v-diasize-browse-handle :width = v-browse-width
     2471             .
     2472             for each buf_temp-browse-handle
     2473               where buf_temp-browse-handle.browse-type = 'width':u
     2474             on error undo, next
     2475             :
     2476               assign
     2477                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2478               .
     2479             end.
     2480             assign
     2481               frame Dialog-Frame :width = v-frame-width
     2482             .
     2483             if frame Dialog-Frame :scrollable = true
     2484             then do:
     2485               assign
     2486                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2487               .
     2488             end.
     2489             run diasize_position-resize-button in this-procedure .
     2490           end.
     2491           else do:
     2492             if frame Dialog-Frame :scrollable = true
     2493             then do:
     2494               assign
     2495                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2496               .
     2497             end.
     2498             assign
     2499               frame Dialog-Frame :width = v-frame-width
     2500             .
     2501             for each buf_temp-browse-handle
     2502               where buf_temp-browse-handle.browse-type = 'width':u
     2503             on error undo, next
     2504             :
     2505               assign
     2506                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2507               .
     2508             end.
     2509             assign
     2510               v-diasize-browse-handle :width = v-browse-width
     2511             .
     2512             for each buf_temp-diasize-handle
     2513             on error undo, next
     2514             :
     2515               assign
     2516                 v-object-handle = buf_temp-diasize-handle.handle-value
     2517               .
     2518               if v-object-handle <> v-diasize-resize-button
     2519               then do:
     2520                 assign
     2521                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2522                 .
     2523               end.
     2524             end.
     2525             run diasize_position-resize-button in this-procedure .
     2526           end.
     2527           assign
     2528             v-diasize-change-size = false
     2529           .
     2530           leave move_block .
     2531         end.
     2532       end.
     2533       assign
     2534         v-diasize-need-full-display = true
     2535       .
     2536       if v-diasize-change-size = false
     2537       then do:
     2538         assign
     2539           v-diasize-change-size = true
     2540         .
     2541       end.
     2542       else do:
     2543         return .
     2544       end.
     2545       assign
     2546         v-frame-width = frame Dialog-Frame :width
     2547         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2548         v-browse-width = v-diasize-browse-handle :width
     2549       .
     2550       for each buf_temp-browse-handle
     2551         where buf_temp-browse-handle.browse-type = 'width':u
     2552       :
     2553         assign
     2554           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2555         .
     2556       end.
     2557       for each buf_temp-diasize-handle
     2558       :
     2559         delete buf_temp-diasize-handle .
     2560       end.
     2561       assign
     2562         v-field-group-handle = frame Dialog-Frame :first-child
     2563       .
     2564       do while valid-handle(v-field-group-handle)
     2565       :
     2566         assign
     2567           v-object-handle = v-field-group-handle :first-child
     2568         .
     2569         do while valid-handle(v-object-handle)
     2570         :
     2571           if  v-object-handle <> v-diasize-browse-handle :handle
     2572           and v-object-handle <> v-diasize-resize-button
     2573           and can-query(v-object-handle, "row")
     2574           and can-query(v-object-handle, "height")
     2575           and ( v-object-handle :col + v-object-handle :width
     2576                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2577               )
     2578           then do:
     2579             find first buf_temp-browse-handle
     2580               where buf_temp-browse-handle.browse-type   = 'width':u
     2581                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2582               no-error .
     2583             if available buf_temp-browse-handle
     2584             then do:
     2585             end.
     2586             else do:
     2587               create buf_temp-diasize-handle .
     2588               assign
     2589                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2590                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2591               .
     2592             end.
     2593           end.
     2594           assign
     2595             v-object-handle = v-object-handle :next-sibling
     2596           .
     2597         end.
     2598         assign
     2599           v-field-group-handle = v-field-group-handle :next-sibling
     2600         .
     2601       end.
     2602       do with frame Dialog-Frame
     2603       :
     2604         hide v-diasize-resize-button .
     2605         v-diasize-resize-button :row = 1.
     2606         v-diasize-resize-button :column = 1.
     2607       end.
     2608       if p-change-value > 0
     2609       then do:
     2610         if frame Dialog-Frame :scrollable = true
     2611         then do:
     2612           assign
     2613             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2614             no-error .
     2615           if error-status :error
     2616           or error-status :get-message(1) <> ""
     2617           then do:
     2618             undo move_block, retry move_block.
     2619           end.
     2620         end.
     2621         assign
     2622           frame Dialog-Frame :width = v-frame-width + p-change-value
     2623           no-error .
     2624         if error-status :error
     2625         or error-status :get-message(1) <> ""
     2626         then do:
     2627           undo move_block, retry move_block.
     2628         end.
     2629         assign
     2630           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2631         no-error .
     2632         if error-status :error
     2633         or error-status :get-message(1) <> ""
     2634         then do:
     2635           undo move_block, retry move_block.
     2636         end.
     2637         for each buf_temp-browse-handle
     2638           where buf_temp-browse-handle.browse-type = 'width':u
     2639         on error undo move_block, retry move_block
     2640         :
     2641           assign
     2642             buf_temp-browse-handle.browse-handle :width
     2643               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2644             no-error .
     2645           if error-status :error
     2646           or error-status :get-message(1) <> ""
     2647           then do:
     2648             undo move_block, retry move_block .
     2649           end.
     2650         end.
     2651         for each buf_temp-diasize-handle
     2652         on error undo move_block, retry move_block
     2653         :
     2654           assign
     2655             v-object-handle = buf_temp-diasize-handle.handle-value
     2656           .
     2657           if v-object-handle <> v-diasize-resize-button
     2658           then do:
     2659             assign
     2660               v-object-handle :col = v-object-handle :col + p-change-value
     2661               no-error .
     2662             if error-status :error
     2663             or error-status :get-message(1) <> ""
     2664             then do:
     2665               undo move_block, retry move_block .
     2666             end.
     2667           end.
     2668         end.
     2669       end.
     2670       else do:
     2671         for each buf_temp-diasize-handle
     2672         on error undo move_block, retry move_block
     2673         :
     2674           assign
     2675             v-object-handle = buf_temp-diasize-handle.handle-value
     2676           .
     2677           if v-object-handle <> v-diasize-resize-button
     2678           then do:
     2679             assign
     2680               v-object-handle :col = v-object-handle :col + p-change-value
     2681               no-error .
     2682             if error-status :error
     2683             or error-status :get-message(1) <> ""
     2684             then do:
     2685               undo move_block, retry move_block .
     2686             end.
     2687           end.
     2688         end.
     2689         for each buf_temp-browse-handle
     2690           where buf_temp-browse-handle.browse-type = 'width':u
     2691         on error undo move_block, retry move_block
     2692         :
     2693           assign
     2694             buf_temp-browse-handle.browse-handle :width
     2695               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2696             no-error .
     2697           if error-status :error
     2698           or error-status :get-message(1) <> ""
     2699           then do:
     2700             undo move_block, retry move_block .
     2701           end.
     2702         end.
     2703         assign
     2704           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2705           no-error .
     2706         if error-status :error
     2707         or error-status :get-message(1) <> ""
     2708         then do:
     2709           undo move_block, retry move_block.
     2710         end.
     2711         assign
     2712           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2713         no-error .
     2714         if error-status :error
     2715         or error-status :get-message(1) <> ""
     2716         then do:
     2717           undo move_block, retry move_block.
     2718         end.
     2719         if frame Dialog-Frame :scrollable = true
     2720         then do:
     2721           assign
     2722             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2723           no-error .
     2724           if error-status :error
     2725           or error-status :get-message(1) <> ""
     2726           then do:
     2727             undo move_block, retry move_block.
     2728           end.
     2729         end.
     2730       end.
     2731       if p-move-resize
     2732       then do:
     2733         run diasize_position-resize-button in this-procedure .
     2734       end.
     2735       if v-diasize-wndstore = true
     2736       then do:
     2737         if connected("ub") = true
     2738         then do:
     2739           define variable v-cntxt-db-num        as integer   no-undo .
     2740           define variable v-cntxt-userid        as character no-undo .
     2741           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2742                                             , OUTPUT v-cntxt-userid
     2743                                             ) .
     2744           run gbl/wndsizew.p
     2745             (input  v-cntxt-db-num
     2746             ,input  v-cntxt-userid
     2747             ,input  v-diasize-proc-name
     2748             ,input  'width':u
     2749             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2750             ) .
     2751         end.
     2752       end.
     2753     end.
     2754     assign
     2755       v-diasize-change-size = false
     2756     .
     2757   end procedure.
     2758   procedure diasize_set-width :
     2759     define input  parameter p-new-width  as decimal   no-undo .
     2760     define input  parameter p-move-resize as logical   no-undo .
     2761     do
     2762     on error undo, return error return-value
     2763     :
     2764       run diasize_change-width in this-procedure
     2765         (input  (p-new-width - frame Dialog-Frame :width)
     2766         ,input  p-move-resize
     2767         ) .
     2768     end.
     2769   end procedure.
     2770   procedure diasize_position-resize-button :
     2771     do with frame Dialog-Frame
     2772     :
     2773       hide v-diasize-resize-button .
     2774       assign
     2775         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2776                     - 1
     2777                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2778         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2779                     - 1
     2780                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2781       .
     2782       view v-diasize-resize-button .
     2783     end.
     2784   end procedure.
     2785   on alt-right anywhere
     2786   do:
     2787     run diasize_change-width in this-procedure
     2788       (input 1
     2789       ,input true
     2790       ) .
     2791     return no-apply .
     2792   end.
     2793   on alt-left anywhere
     2794   do:
     2795     run diasize_change-width in this-procedure
     2796       (input -1
     2797       ,input true
     2798       ) .
     2799     return no-apply .
     2800   end.
     2801   on alt-down anywhere
     2802   do:
     2803     run diasize_change-height in this-procedure
     2804       (input 1
     2805       ,input true
     2806       ) .
     2807     return no-apply .
     2808   end.
     2809   on alt-up anywhere
     2810   do:
     2811     run diasize_change-height in this-procedure
     2812       (input -1
     2813       ,input true
     2814       ) .
     2815     return no-apply .
     2816   end.
     2817   on alt-enter of frame Dialog-Frame
     2818   do:
     2819     run diasize_maximize in this-procedure
     2820       (input  ?
     2821       ).
     2822     return no-apply .
     2823   end.
     2824   procedure diasize_end-move :
     2825     do
     2826     on error undo, return error return-value
     2827     :
     2828       define variable v-row-delta as decimal   no-undo .
     2829       define variable v-col-delta as decimal   no-undo .
     2830       define variable v-new-row as decimal   no-undo .
     2831       define variable v-new-col as decimal   no-undo .
     2832       assign
     2833         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2834         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2835       .
     2836       assign
     2837         v-row-delta = v-new-row - frame Dialog-Frame :height
     2838         v-col-delta = v-new-col - frame Dialog-Frame :width
     2839       .
     2840       run diasize_change-height in this-procedure
     2841         (input v-row-delta
     2842         ,input true
     2843         ) .
     2844       run diasize_change-width in this-procedure
     2845         (input v-col-delta
     2846         ,input true
     2847         ) .
     2848     end.
     2849   end procedure.
     2850   procedure diasize_maximize :
     2851     define input  parameter p-action as logical   no-undo .
     2852     do
     2853     on error undo, return error return-value
     2854     :
     2855       if p-action = ?
     2856       then do:
     2857         if v-diasize-need-maximize = true
     2858         then do:
     2859           assign
     2860             p-action = true
     2861           .
     2862         end.
     2863         else do:
     2864           assign
     2865             p-action = false
     2866           .
     2867         end.
     2868       end.
     2869       if p-action = true
     2870       then do:
     2871         run diasize_change-height in this-procedure
     2872           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2873               - frame Dialog-Frame :height-chars
     2874           ,input true
     2875           ) .
     2876         run diasize_change-width in this-procedure
     2877           (input session :width-chars
     2878               - frame Dialog-Frame :width-chars
     2879           ,input true
     2880           ) .
     2881         assign
     2882           v-diasize-need-maximize = false
     2883         .
     2884       end.
     2885       else do:
     2886         run diasize_change-width in this-procedure
     2887           (input v-diasize-orig-frame-width
     2888               - frame Dialog-Frame :width-chars
     2889           ,input true
     2890           ) .
     2891         run diasize_change-height in this-procedure
     2892           (input v-diasize-orig-frame-height
     2893               - frame Dialog-Frame :height-chars
     2894           ,input true
     2895           ) .
     2896         assign
     2897           v-diasize-need-maximize = true
     2898         .
     2899       end.
     2900     end.
     2901   end procedure.
     2902   procedure diasize_restore-orig-size :
     2903     do
     2904     on error undo, return error return-value
     2905     :
     2906       assign
     2907         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2908         v-diasize-current-frame-height = frame Dialog-Frame :height
     2909       .
     2910       run diasize_set-height in this-procedure
     2911         (input  v-diasize-orig-frame-height
     2912         ,input  true
     2913         ) .
     2914       run diasize_set-width in this-procedure
     2915         (input  v-diasize-orig-frame-width
     2916         ,input  true
     2917         ) .
     2918     end.
     2919   end procedure.
     2920   procedure diasize_restore-current-size :
     2921     do
     2922     on error undo, return error return-value
     2923     :
     2924       run diasize_set-height in this-procedure
     2925         (input  v-diasize-current-frame-height
     2926         ,input  true
     2927         ) .
     2928       run diasize_set-width in this-procedure
     2929         (input  v-diasize-current-frame-width
     2930         ,input  true
     2931         ) .
     2932     end.
     2933   end procedure.
     2934   procedure diasize_set-browse-handle :
     2935     define input  parameter p-browse-handle as handle   no-undo .
     2936     define buffer buf_temp-browse-handle for temp-browse-handle .
     2937     do
     2938     on error undo, return error return-value
     2939     :
     2940       assign
     2941         v-diasize-browse-handle = p-browse-handle
     2942       .
     2943       for each buf_temp-browse-handle
     2944       on error undo, return error return-value
     2945       :
     2946         delete buf_temp-browse-handle .
     2947       end.
     2948     end.
     2949   end procedure.
     2950   procedure diasize_add_browse :
     2951     define input  parameter p-browse-type   as character no-undo .
     2952     define input  parameter p-browse-handle as handle    no-undo .
     2953     define buffer buf_temp-browse-handle for temp-browse-handle .
     2954     do
     2955     on error undo, return error return-value
     2956     :
     2957       assign
     2958         v-diasize-browse-number = v-diasize-browse-number + 1
     2959       .
     2960       create buf_temp-browse-handle .
     2961       assign
     2962         buf_temp-browse-handle.browse-type   = p-browse-type
     2963         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2964         buf_temp-browse-handle.browse-handle = p-browse-handle
     2965       .
     2966     end.
     2967   end procedure.
     2968   procedure diasize_init :
     2969     define variable v-default-value    as logical   no-undo .
     2970     define variable v-restore-saved    as logical   no-undo .
     2971     define variable v-resize-value-str as character no-undo .
     2972     do
     2973     on error undo, return error return-value
     2974     :
     2975       do with frame Dialog-Frame
     2976       :
     2977         assign
     2978           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2979           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2980           v-diasize-browse-handle     = browse br-gates :handle
     2981         .
     2982         create button v-diasize-resize-button
     2983         assign
     2984           parent        = frame Dialog-Frame :first-child
     2985           label         = "s"
     2986           height-pixels = 16
     2987           width-pixels  = 16
     2988           visible       = true
     2989           sensitive     = true
     2990           movable       = true
     2991           triggers:
     2992             on end-move persistent run diasize_end-move in this-procedure .
     2993           end triggers.
     2994         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2995         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2996         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2997         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2998         assign
     2999           v-diasize-wndmax = false
     3000         .
     3001         if connected("ub") = true
     3002         then do:
     3003           define variable v-cntxt-db-num        as integer   no-undo .
     3004           define variable v-cntxt-userid        as character no-undo .
     3005           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3006                                             , OUTPUT v-cntxt-userid
     3007                                             ) .
     3008           run gbl/wndpar_r.p
     3009             (input  v-cntxt-db-num
     3010             ,input  v-cntxt-userid
     3011             ,input  'wndmax':U
     3012             ,output v-diasize-wndmax
     3013             ,output v-default-value
     3014             ) .
     3015         end.
     3016         assign
     3017           v-diasize-wndstore = false
     3018         .
     3019         if connected("ub") = true
     3020         then do:
     3021           run gbl/wndpar_r.p
     3022             (input  v-cntxt-db-num
     3023             ,input  v-cntxt-userid
     3024             ,input  'wndstore':U
     3025             ,output v-diasize-wndstore
     3026             ,output v-default-value
     3027             ) .
     3028         end.
     3029         assign
     3030           v-diasize-proc-name = entry(1, program-name(2), '.')
     3031         .
     3032         if v-diasize-wndstore = true
     3033         then do:
     3034           assign
     3035             v-restore-saved = false
     3036           .
     3037           if connected("ub") = true
     3038           then do:
     3039             run gbl/wndsizer.p
     3040               (input  v-cntxt-db-num
     3041               ,input  v-cntxt-userid
     3042               ,input  v-diasize-proc-name
     3043               ,input  'height':u
     3044               ,output v-resize-value-str
     3045               ) .
     3046             if v-resize-value-str <> '':U
     3047             then do:
     3048               run diasize_change-height in this-procedure
     3049                 (input  integer(v-resize-value-str)
     3050                 ,input  true
     3051                 ) .
     3052               assign
     3053                 v-restore-saved = true
     3054               .
     3055             end.
     3056           end.
     3057           if connected("ub") = true
     3058           then do:
     3059             run gbl/wndsizer.p
     3060               (input  v-cntxt-db-num
     3061               ,input  v-cntxt-userid
     3062               ,input  v-diasize-proc-name
     3063               ,input  'width':u
     3064               ,output v-resize-value-str
     3065               ) .
     3066             if v-resize-value-str <> '':U
     3067             then do:
     3068               run diasize_change-width in this-procedure
     3069                 (input  integer(v-resize-value-str)
     3070                 ,input  true
     3071                 ) .
     3072               assign
     3073                 v-restore-saved = true
     3074               .
     3075             end.
     3076           end.
     3077           if v-restore-saved <> true
     3078           then do:
     3079             if v-diasize-wndmax = true
     3080             then do:
     3081               run diasize_maximize in this-procedure
     3082                 (input  true
     3083                 ) .
     3084             end.
     3085           end.
     3086         end.
     3087         else do:
     3088           if v-diasize-wndmax = true
     3089           then do:
     3090             run diasize_maximize in this-procedure
     3091               (input  true
     3092               ) .
     3093           end.
     3094         end.
     3095       end.
     3096     end.
     3097   end procedure.
     3098   procedure diasize_need-full-display :
     3099     define output parameter p-need-full-display as logical   no-undo .
     3100     do
     3101     on error undo, return error return-value
     3102     :
     3103       assign
     3104         p-need-full-display = v-diasize-need-full-display
     3105       .
     3106       assign
     3107         v-diasize-need-full-display = false
     3108       .
     3109     end.
     3110   end procedure.
     3111   procedure get-context :
     3112      define output parameter p-db-num as integer          no-undo.
     3113      define output parameter p-user-id as character        no-undo.
     3114      define variable v-login               as character    no-undo.
     3115      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3116      define buffer buf_user-login  for ub.user-login .
     3117      do
     3118      on error undo, return error
     3119      :
     3120            FIND FIRST buf_sys-ctrl no-lock.
     3121            ASSIGN
     3122               v-login = USERID("ub")
     3123               p-db-num = buf_sys-ctrl.db-num
     3124            .
     3125            FIND FIRST buf_user-login
     3126                 WHERE buf_user-login.db-num = p-db-num
     3127                   AND buf_user-login.user-login = v-login
     3128                 no-lock
     3129                 no-error
     3130                 .
     3131            IF AVAILABLE buf_user-login
     3132            THEN DO:
     3133               assign
     3134                  p-user-id = buf_user-login.user-id
     3135               .
     3136            END.
     3137      end.
     3138   end procedure.
     3139       run diasize_init in this-procedure .
     3140   MAIN-BLOCK:
     3141   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3142      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3143   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3144     run mainmenu_getcntxt in parparentproc
     3145       (output v-cntxt-db-num
     3146       ,output v-cntxt-userid
     3147       ,output v-cntxt-level
     3148       ,output v-cntxt-host-code-obj
     3149       ,output v-cntxt-obj-type
     3150       ,output v-cntxt-obj-code
     3151       ,output v-cntxt-db-num-obj
     3152       ,output v-cntxt-is-admin
     3153       ) .
     3154   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     3155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     3156     (output v-sys-key
     3157     ) no-error .
     3158     if error-status:error then return error.
     3159     assign
     3160     v-ibs = (v-sys-key = 'ExpertekIBS':U).
     3161     assign
     3162     v-gate-tables = v-gate-tables + chr(44) + 'clob-bind':U +
     3163                                   chr(44) + 'clob-data':U
     3164                                   .
     3165     assign
     3166     v-gate-table-names = v-gate-table-names + chr(44) + 'Связка clob с владельцем':U +
     3167                                   chr(44) + 'CLOB-data':U
     3168                                   .
     3169     assign
     3170     v-gate-tables = trim(v-gate-tables).
     3171     RUN Myenable.
     3172     WAIT-FOR GO OF FRAME Dialog-Frame.
     3173   END.
     3174   RUN disable_UI.
     3175   PROCEDURE disable_UI :
     3176     HIDE FRAME Dialog-Frame.
     3177   END PROCEDURE.
     3178   PROCEDURE enable_UI :
     3179     DISPLAY E-descr
     3180         WITH FRAME Dialog-Frame.
     3181     ENABLE b-quit b-add b-chg b-lkp b-del b-version b-export B-Help br-gates
     3182            E-descr
     3183         WITH FRAME Dialog-Frame.
     3184     VIEW FRAME Dialog-Frame.
     3185     OPEN QUERY br-gates FOR EACH X_clob-bind NO-LOCK where       X_clob-bind.resource-type = 'gate':U and       X_clob-bind.db-num = 0 and       X_clob-bind.int64-id > 0       ,              EACH X_clob-data outer-join NO-LOCK where       (X_clob-data.db-num = X_clob-bind.db-num   and X_clob-data.int64-id = X_clob-bind.int64-id )   or (X_clob-data.file-name = X_clob-bind.uniq-key-rec       and       X_clob-data.resource-type = 'gate':U)        INDEXED-REPOSITION.
     3186   END PROCEDURE.
     3187   PROCEDURE MyEnable :
     3188   assign
     3189   b-del:menu-mouse in frame Dialog-Frame  = 1
     3190   e-descr:read-only in frame Dialog-Frame = yes
     3191   .
     3192   ENABLE
     3193   b-quit
     3194   b-add when v-cntxt-db-num = 0
     3195   b-chg when v-cntxt-db-num = 0
     3196   b-del when v-cntxt-db-num = 0
     3197   b-lkp
     3198   B-Help
     3199   b-version when v-cntxt-db-num = 0
     3200   b-export
     3201   br-gates
     3202   E-descr
     3203   WITH FRAME Dialog-Frame.
     3204   VIEW FRAME Dialog-Frame.
     3205   OPEN QUERY br-gates FOR EACH X_clob-bind NO-LOCK where       X_clob-bind.resource-type = 'gate':U and       X_clob-bind.db-num = 0 and       X_clob-bind.int64-id > 0       ,              EACH X_clob-data outer-join NO-LOCK where       (X_clob-data.db-num = X_clob-bind.db-num   and X_clob-data.int64-id = X_clob-bind.int64-id )   or (X_clob-data.file-name = X_clob-bind.uniq-key-rec       and       X_clob-data.resource-type = 'gate':U)        INDEXED-REPOSITION.
     3206   apply "value-changed" to br-gates.
     3207   END PROCEDURE.
     3208   PROCEDURE proc-b-add :
     3209   define variable v-part-num as integer   no-undo .
     3210   define variable v-clob-db-num as integer   no-undo .
     3211   define variable v-int64-id as int64 no-undo .
     3212   define variable v-descr as character no-undo .
     3213   define variable v-file-name0 as character no-undo .
     3214   define variable v-ok as logical   no-undo .
     3215   define variable v-path                    as character                no-undo .
     3216   DEFINE VARIABLE v-full-path               as character                no-undo .
     3217   DEFINE VARIABLE v-file-name               as character                no-undo .
     3218   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     3219   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     3220   system-dialog get-file v-file-name0
     3221   filters "Гейты *.xsd" "*.xsd"
     3222   use-filename
     3223   initial-dir "exe"
     3224   must-exist
     3225   update glog
     3226   default-extension "xsd".
     3227   if v-file-name0 = ""
     3228   or v-file-name0 = ? then do:
     3229     undo, return error.
     3230   end.
     3231   run gbl/filename.p (
     3232                   input v-file-name0
     3233                 ,output v-full-path
     3234                 ,output v-path
     3235                 ,output v-file-name
     3236                 ,output v-file-name-no-ext
     3237                 ,output v-file-name-ext
     3238                 ) no-error .
     3239   if error-status:error then do:
     3240     undo, return error .
     3241   end.
     3242   v-file-name0 = entry(num-entries(v-path, chr(92)), v-path, chr(92)) + chr(47) + v-file-name.
     3243   run gbl/d-character.w (
     3244         input ?
     3245         ,input (
     3246         'title=':u + substitute("Описание применения гейта &1", v-file-name0) + '\':u
     3247       + 'format=' + "X(75)" + '\':u
     3248       + 'fillin_row=4\':u
     3249       + 'fillin_col=4\':u
     3250       + 'fillin_width=75\':u
     3251       + 'fillin_height=1\':u
     3252       + 'max-chars=75\':u
     3253       + 'readonly=' + 'no':u + '\':u)
     3254       , input-output v-descr
     3255       , output v-ok
     3256           ).
     3257   if not v-ok then return error.
     3258   assign
     3259   v-clob-db-num = ?
     3260   v-int64-id = 0
     3261   .
     3262   run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     3263                       ,input ""
     3264                       ,input ?
     3265                       ,input v-file-name0
     3266                       ,input '':U
     3267                       ,input v-descr
     3268                       ,input-output v-part-num
     3269                       ,input 'gate':U
     3270                       ,input-output v-clob-db-num
     3271                       ,input-output v-int64-id
     3272                       ,input v-file-name0
     3273                       ,input ?
     3274                       ) no-error .
     3275   if error-status:error then do:
     3276     message error-status :error  skip
     3277     return-value
     3278     view-as alert-box error .
     3279     undo, return error  .
     3280   end.
     3281   OPEN QUERY br-gates FOR EACH X_clob-bind NO-LOCK where       X_clob-bind.resource-type = 'gate':U and       X_clob-bind.db-num = 0 and       X_clob-bind.int64-id > 0       ,              EACH X_clob-data outer-join NO-LOCK where       (X_clob-data.db-num = X_clob-bind.db-num   and X_clob-data.int64-id = X_clob-bind.int64-id )   or (X_clob-data.file-name = X_clob-bind.uniq-key-rec       and       X_clob-data.resource-type = 'gate':U)        INDEXED-REPOSITION.
     3282   apply "value-changed" to br-gates in frame Dialog-Frame .
     3283   END PROCEDURE.
     3284   PROCEDURE proc-b-chg :
     3285   define variable v-part-num as integer   no-undo .
     3286   define variable v-clob-db-num as integer   no-undo .
     3287   define variable v-int64-id as int64 no-undo .
     3288   define variable v-old-clob-db-num as integer   no-undo .
     3289   define variable v-old-int64-id as int64 no-undo .
     3290   define variable v-descr as character no-undo .
     3291   define variable v-file-name0 as character no-undo .
     3292   define variable v-ok as logical   no-undo .
     3293   define variable v-path                    as character                no-undo .
     3294   DEFINE VARIABLE v-full-path               as character                no-undo .
     3295   DEFINE VARIABLE v-file-name               as character                no-undo .
     3296   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     3297   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     3298   define buffer buf_clob-data for ub.clob-data.
     3299   system-dialog get-file v-file-name0
     3300   filters "Гейты *.xsd" "*.xsd"
     3301   use-filename
     3302   initial-dir "exe"
     3303   must-exist
     3304   update glog
     3305   default-extension "xsd".
     3306   if v-file-name0 = ""
     3307   or v-file-name0 = ? then do:
     3308     undo, return error.
     3309   end.
     3310   run gbl/filename.p (
     3311                   input v-file-name0
     3312                 ,output v-full-path
     3313                 ,output v-path
     3314                 ,output v-file-name
     3315                 ,output v-file-name-no-ext
     3316                 ,output v-file-name-ext
     3317                 ) no-error .
     3318   if error-status:error then do:
     3319     undo, return error .
     3320   end.
     3321   v-file-name0 = entry(num-entries(v-path, chr(92)), v-path, chr(92)) + chr(47) + v-file-name.
     3322   v-descr = X_clob-bind.descr.
     3323   run gbl/d-character.w (
     3324         input ?
     3325         ,input (
     3326         'title=':u + substitute("Описание применения гейта &1", v-file-name0) + '\':u
     3327       + 'format=' + "X(75)" + '\':u
     3328       + 'fillin_row=4\':u
     3329       + 'fillin_col=4\':u
     3330       + 'fillin_width=75\':u
     3331       + 'fillin_height=1\':u
     3332       + 'max-chars=75\':u
     3333       + 'readonly=' + 'no':u + '\':u)
     3334       , input-output v-descr
     3335       , output v-ok
     3336           ).
     3337   if not v-ok then return error.
     3338   assign
     3339   v-old-clob-db-num = X_clob-bind.db-num
     3340   v-old-int64-id = X_clob-bind.int64-id
     3341   v-clob-db-num = X_clob-bind.db-num
     3342   v-int64-id = X_clob-bind.int64-id
     3343   v-part-num = X_clob-bind.part-num
     3344   .
     3345   run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     3346                       ,input "add-new"
     3347                       ,input ?
     3348                       ,input v-file-name0
     3349                       ,input '':U
     3350                       ,input v-descr
     3351                       ,input-output v-part-num
     3352                       ,input 'gate':U
     3353                       ,input-output v-clob-db-num
     3354                       ,input-output v-int64-id
     3355                       ,input v-file-name0
     3356                       ,input ?
     3357                       ) no-error .
     3358   if error-status:error then do:
     3359     message error-status :error  skip
     3360     return-value
     3361     view-as alert-box error .
     3362     undo, return error  .
     3363   end.
     3364   find first buf_clob-data no-lock where
     3365             buf_clob-data.db-num = v-old-clob-db-num
     3366         and buf_clob-data.int64-id = v-old-int64-id no-error.
     3367   if available buf_clob-data then do:
     3368     run clbdattd_two-commit-del in this-procedure ( buffer buf_clob-data, input 1) no-error.
     3369     if error-status :error then do:
     3370       undo , return error substitute("Ошибка при попытке запустить удаление неиспользуемых clob-data &1 (&2&3)(2)&4&5&4&6"
     3371                                                 ,buf_clob-data.file-name_
     3372                                                 ,buf_clob-data.db-num
     3373                                                 ,buf_clob-data.int64-id
     3374                                                 ,chr(10)
     3375                                                 , error-status:get-message(1)
     3376                                                 , return-value ).
     3377     end.
     3378   end.
     3379   OPEN QUERY br-gates FOR EACH X_clob-bind NO-LOCK where       X_clob-bind.resource-type = 'gate':U and       X_clob-bind.db-num = 0 and       X_clob-bind.int64-id > 0       ,              EACH X_clob-data outer-join NO-LOCK where       (X_clob-data.db-num = X_clob-bind.db-num   and X_clob-data.int64-id = X_clob-bind.int64-id )   or (X_clob-data.file-name = X_clob-bind.uniq-key-rec       and       X_clob-data.resource-type = 'gate':U)        INDEXED-REPOSITION.
     3380   apply "value-changed" to br-gates in frame Dialog-Frame .
     3381   END PROCEDURE.
     3382   PROCEDURE proc-b-del :
     3383   define input parameter p-option as character no-undo.
     3384   define variable v-clob-db-num as integer   no-undo .
     3385   define variable v-int64-id as int64 no-undo .
     3386   define variable v-part-num as integer   no-undo .
     3387   define buffer buf_clob-data for ub.clob-data.
     3388   case p-option:
     3389     when "both" then do:
     3390        find first buf_clob-data no-lock where
     3391                 buf_clob-data.db-num = X_clob-bind.db-num
     3392             and buf_clob-data.int64-id = X_clob-bind.int64-id no-error.
     3393         assign
     3394         v-clob-db-num = X_clob-bind.db-num
     3395         v-int64-id = X_clob-bind.int64-id
     3396         v-part-num = X_clob-bind.part-num
     3397         .
     3398         run gbl/file2clb.p ( input 'удаление':U
     3399                             ,input "leave"
     3400                             ,input ?
     3401                             ,input X_clob-bind.uniq-key-rec
     3402                             ,input X_clob-bind.field-name
     3403                             ,input '':U
     3404                             ,input-output v-part-num
     3405                             ,input 'gate':U
     3406                             ,input-output v-clob-db-num
     3407                             ,input-output v-int64-id
     3408                             ,input X_clob-bind.uniq-key-rec
     3409                             ,input ?
     3410                             ) no-error .
     3411        if error-status :error then do:
     3412          message
     3413          error-status:get-message(1) skip
     3414          return-value
     3415          view-as alert-box error .
     3416          undo , return error return-value .
     3417        end.
     3418     end.
     3419     when 'clob-bind':U then do:
     3420         assign
     3421         v-clob-db-num = X_clob-bind.db-num
     3422         v-int64-id = X_clob-bind.int64-id
     3423         v-part-num = X_clob-bind.part-num
     3424         .
     3425         run gbl/file2clb.p ( input 'удаление':U
     3426                             ,input "leave"
     3427                             ,input ?
     3428                             ,input X_clob-bind.uniq-key-rec
     3429                             ,input X_clob-bind.field-name
     3430                             ,input '':U
     3431                             ,input-output v-part-num
     3432                             ,input 'gate':U
     3433                             ,input-output v-clob-db-num
     3434                             ,input-output v-int64-id
     3435                             ,input X_clob-bind.uniq-key-rec
     3436                             ,input ?
     3437                             ) no-error .
     3438        if error-status :error then do:
     3439          message
     3440          error-status:get-message(1) skip
     3441          return-value
     3442          view-as alert-box error .
     3443          undo , return error return-value .
     3444        end.
     3445     end.
     3446     when 'clob-data':U then do:
     3447        find first buf_clob-data no-lock where
     3448                 buf_clob-data.db-num = X_clob-data.db-num
     3449             and buf_clob-data.int64-id = X_clob-data.int64-id no-error.
     3450     end.
     3451   end case.
     3452   if available buf_clob-data then do:
     3453     run clbdattd_two-commit-del in this-procedure ( buffer buf_clob-data, input 1) no-error.
     3454     if error-status :error then do:
     3455       undo , return error substitute("Ошибка при попытке запустить удаление неиспользуемых clob-data &1 (&2&3)(2)&4&5&4&6"
     3456                                                 ,buf_clob-data.file-name_
     3457                                                 ,buf_clob-data.db-num
     3458                                                 ,buf_clob-data.int64-id
     3459                                                 ,chr(10)
     3460                                                 , error-status:get-message(1)
     3461                                                 , return-value ).
     3462     end.
     3463   end.
     3464   END PROCEDURE.
     3465   PROCEDURE proc-b-vers :
     3466   define variable v-descr as character no-undo.
     3467   define variable v-ok as logical no-undo.
     3468   define buffer buf_clob-bind for ub.clob-bind.
     3469   find first buf_clob-bind share-lock where
     3470              buf_clob-bind.db-num = 0
     3471          and buf_clob-bind.int64-id = 0 no-error.
     3472   if not available buf_clob-bind then do:
     3473       v-descr = "v15_0.0".
     3474       create buf_clob-bind.
     3475       assign
     3476       buf_clob-bind.db-num = 0
     3477       buf_clob-bind.int64-id = 0
     3478       buf_clob-bind.resource-type = 'gate':U
     3479       .
     3480   end.
     3481   else do:
     3482       v-descr = buf_clob-bind.descr.
     3483   end.
     3484   run gbl/d-character.w (
     3485       input ?
     3486         ,input (
     3487         'title=':u + "Изменение версии кофигурации гейтов" + '\':u
     3488       + 'text1=':u + "версия" + '\':u
     3489       + 'format=' + "X(8)" + '\':u
     3490       + 'fillin_row=2\':u
     3491       + 'fillin_col=8\':u
     3492       + 'fillin_width=20\':u
     3493       + 'fillin_height=1\':u
     3494       + 'max-chars=70\':u
     3495       + 'readonly=no\')
     3496       , input-output v-descr
     3497       , output v-ok
     3498           ).
     3499       if not v-ok then return NO-apply.
     3500   buf_clob-bind.descr = v-descr.
     3501   END PROCEDURE.
