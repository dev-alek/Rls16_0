     2063   ,reportShift~
     2064   ,shift-param~
     2065   ,susp-chk~
     2066   ':U .
     2067   define variable oth-list1 as character no-undo .
     2068   define variable oth-list2 as character no-undo .
     2069   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2070   procedure ren-route-dump :
     2071     define input parameter p-action          as character no-undo .
     2072     define input parameter p-old-gds-key-rec as character no-undo .
     2073     define input parameter p-tbl-name        as character no-undo .
     2074     define input parameter p-old-artic       as character no-undo .
     2075     define input parameter p-old-prod-type   as character no-undo .
     2076     define input parameter p-old-prod-code   as integer   no-undo .
     2077     define input parameter p-new-artic       as character no-undo .
     2078     define input parameter p-new-prod-type   as character no-undo .
     2079     define input parameter p-new-prod-code   as integer   no-undo .
     2080     define input parameter p-old-gds-code    as integer   no-undo .
     2081     define input parameter p-new-gds-code    as integer   no-undo .
     2082     do
     2083     on error  undo, return error substitute( "&1 (ren-route-dump). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2084     on stop   undo, return error substitute( "&1 (ren-route-dump). stop", vss-workfile )
     2085     on endkey undo, return error substitute( "&1 (ren-route-dump). endkey", vss-workfile )
     2086     :
     2087       define buffer buf_route-dump      for ub.route-dump .
     2088       define buffer buf_route-dump-link for ub.route-dump-link .
     2089       define variable v-is-change as logical no-undo .
     2090       define variable tth           as handle    no-undo .
     2091       define variable tt-name       as character no-undo .
     2092       define variable v-ok          as logical   no-undo .
     2093       define variable bh_tt         as handle    no-undo .
     2094       define variable bh_route-dump as handle    no-undo .
     2095       define variable fh_artic      as handle    no-undo .
     2096       define variable fh_prod-type  as handle    no-undo .
     2097       define variable fh_prod-code  as handle    no-undo .
     2098       define variable fh_gds-code   as handle    no-undo .
     2099       create temp-table tth.
     2100       assign
     2101         tt-name = "tt_" + p-tbl-name
     2102       .
     2103       assign
     2104         v-ok = tth:create-like( "ub.":U + p-tbl-name ) no-error
     2105       .
     2106       if v-ok <> true then do:
     2107         undo, return error substitute( "&1 (ren-route-dump). Ошибка при создании временной таблицы &2 (1)", vss-workfile, tt-name ) .
     2108       end.
     2109       assign
     2110         v-ok = tth:temp-table-prepare( tt-name ) no-error
     2111       .
     2112       if v-ok <> true then do:
     2113         undo, return error substitute( "&1 (ren-route-dump). Ошибка при создании временной таблицы &2 (2)", vss-workfile, tt-name ) .
     2114       end.
     2115       assign
     2116         bh_tt = tth:default-buffer-handle
     2117       .
     2118       assign
     2119         v-ok = bh_tt:buffer-create no-error
     2120       .
     2121       if v-ok <> true then do:
     2122         undo, return error substitute( "&1 (ren-route-dump). Ошибка при создании буфера временной таблицы.", vss-workfile, tt-name ).
     2123       end.
     2124       for each buf_route-dump-link exclusive-lock
     2125         where buf_route-dump-link.uniq-key-rec = p-old-gds-key-rec
     2126           and buf_route-dump-link.dump-name    = p-tbl-name
     2127       on error undo, return error
     2128       :
     2129         for each buf_route-dump exclusive-lock
     2130           where buf_route-dump.dump-ord = buf_route-dump-link.dump-ord
     2131             and buf_route-dump.rec-ord  = buf_route-dump-link.rec-ord
     2132         on error  undo, return error
     2133         :
     2134           assign
     2135             bh_route-dump = buffer buf_route-dump:handle
     2136           .
     2137           assign
     2138             v-ok = bh_tt:raw-transfer ( false, bh_route-dump:buffer-field("value-rec":U) ) no-error
     2139           .
     2140           if v-ok <> true then do:
     2141             undo, return error substitute( "&1 (ren-route-dump). RAW-TRANSFER -> не прошел для таблицы &2. Rowid записи &3", vss-workfile, tt-name, bh_route-dump:rowid ).
     2142           end.
     2143           assign
     2144             v-is-change = false
     2145           .
     2146           case p-action :
     2147             when "ren-art":U then do:
     2148               assign
     2149                 fh_artic     = bh_tt:buffer-field("artic":U)
     2150                 fh_prod-type = bh_tt:buffer-field("prod-type":U)
     2151                 fh_prod-code = bh_tt:buffer-field("prod-code":U)
     2152               .
     2153               if fh_artic:buffer-value  = p-old-artic
     2154                 and fh_prod-type:buffer-value = p-old-prod-type
     2155                 and fh_prod-code:buffer-value = p-old-prod-code
     2156               then do:
     2157                 assign
     2158                   fh_artic:buffer-value     = p-new-artic
     2159                   fh_prod-type:buffer-value = p-new-prod-type
     2160                   fh_prod-code:buffer-value = p-new-prod-code
     2161                   v-is-change               = true
     2162                 .
     2163               end.
     2164             end.
     2165             when "ren-gds-code":U then do:
     2166               assign
     2167                 fh_gds-code = bh_tt:buffer-field("gds-code":U)
     2168               .
     2169               if fh_gds-code:buffer-value = p-old-gds-code then do:
     2170                 assign
     2171                   fh_gds-code:buffer-value = p-new-gds-code
     2172                   v-is-change              = true
     2173                 .
     2174               end.
     2175             end.
     2176           end case.
     2177           if v-is-change = true then do:
     2178             assign
     2179               v-ok = bh_tt:raw-transfer ( true, bh_route-dump:buffer-field("value-rec":U) ) no-error
     2180             .
     2181             if v-ok <> true then do:
     2182               undo, return error substitute( "&1 (ren-route-dump). RAW-TRANSFER <- не прошел для таблицы &2. Rowid записи &3", vss-workfile, tt-name, bh_route-dump:rowid ).
     2183             end.
     2184           end.
     2185         end.
     2186       end.
     2187       assign
     2188         v-ok = bh_tt:buffer-delete no-error
     2189       .
     2190       if v-ok <> true then do:
     2191         undo, return error substitute( "&1 (ren-route-dump). Ошибка при удалении буфера временной таблицы.", vss-workfile, tt-name ).
     2192       end.
     2193       assign
     2194         v-ok = tth:clear() no-error
     2195       .
     2196       if v-ok <> true then do:
     2197         undo, return error substitute( "&1 (ren-route-dump). Ошибка при очистке временной таблицы &2", vss-workfile, tt-name ) .
     2198       end.
     2199       delete object tth no-error .
     2200       if error-status:error then do:
     2201         undo, return error substitute( "&1 (ren-route-dump). Ошибка при удалении временной таблицы для &2", vss-workfile, tt-name ).
     2202       end.
     2203     end.
     2204     return.
     2205   end procedure.
     2206   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2207   procedure ren-artic :
     2208     define input parameter p-tbl-name        as character no-undo .
     2209     define input parameter p-old-gds-key-rec as character no-undo .
     2210     define input parameter p-old-artic       as character no-undo .
     2211     define input parameter p-old-prod-type   as character no-undo .
     2212     define input parameter p-old-prod-code   as integer   no-undo .
     2213     define input parameter p-new-artic       as character no-undo .
     2214     define input parameter p-new-prod-type   as character no-undo .
     2215     define input parameter p-new-prod-code   as integer   no-undo .
     2216     define input parameter p-search-bufs     as character no-undo .
     2217     define input parameter p-search-prefix   as character no-undo .
     2218     define input parameter p-search-suffix   as character no-undo .
     2219     do
     2220     on error  undo, return error substitute( "&1 (ren-artic). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2221     on stop   undo, return error substitute( "&1 (ren-artic). stop", vss-workfile )
     2222     on endkey undo, return error substitute( "&1 (ren-artic). endkey", vss-workfile )
     2223     :
     2224       define variable qh_tbl-name  as handle no-undo .
     2225       define variable bh_tbl-name  as handle no-undo .
     2226       define variable v-query      as character no-undo .
     2227       define variable fh_artic     as handle no-undo .
     2228       define variable fh_prod-type as handle no-undo .
     2229       define variable fh_prod-code as handle no-undo .
     2230       define variable v-ind  as integer no-undo .
     2231       define variable v-ind1 as integer no-undo .
     2232       define variable v-tbl-name   as character no-undo .
     2233       assign
     2234         v-tbl-name  = substitute( "ub.&1":U, p-tbl-name )
     2235         v-query     = substitute( 'for &1 each &2 where &2.artic = "&3" and &2.prod-type = "&4" and &2.prod-code = &5 &6'
     2236                                   ,p-search-prefix
     2237                                   ,v-tbl-name
     2238                                   ,replace( replace( p-old-artic, '"':U, '""':U ), '~~':U, '~~~~':U )
     2239                                   ,replace( replace( p-old-prod-type, '"':U, '""':U ), '~~':U, '~~~~':U )
     2240                                   ,p-old-prod-code
     2241                                   ,p-search-suffix
     2242                                )
     2243       .
     2244       create buffer bh_tbl-name for table v-tbl-name  .
     2245       bh_tbl-name:disable-load-triggers ( false ).
     2246       create query qh_tbl-name .
     2247       if trim( p-search-bufs ) = "":U
     2248         or p-search-bufs = ?
     2249       then do:
     2250         qh_tbl-name:set-buffers( bh_tbl-name ).
     2251       end.
     2252       else do:
     2253         qh_tbl-name:set-buffers( p-search-bufs, bh_tbl-name ).
     2254       end.
     2255       qh_tbl-name:query-prepare( v-query ).
     2256       qh_tbl-name:query-open() .
     2257       qh_tbl-name:get-first( exclusive-lock ).
     2258       do while qh_tbl-name:query-off-end <> true
     2259       on error  undo, return error substitute( "&1 (ren-artic2). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2260       on stop   undo, return error substitute( "&1 (ren-artic2). stop", vss-workfile )
     2261       on quit   undo, return error substitute( "&1 (ren-artic2). quit", vss-workfile )
     2262       on endkey undo, return error substitute( "&1 (ren-artic2). endkey", vss-workfile )
     2263       :
     2264         assign
     2265           fh_artic     = bh_tbl-name:buffer-field( "artic":U )
     2266           fh_prod-type = bh_tbl-name:buffer-field( "prod-type":U )
     2267           fh_prod-code = bh_tbl-name:buffer-field( "prod-code":U )
     2268           fh_artic:buffer-value     = p-new-artic
     2269           fh_prod-type:buffer-value = p-new-prod-type
     2270           fh_prod-code:buffer-value = p-new-prod-code
     2271         .
     2272         bh_tbl-name:buffer-release() no-error .
     2273         assign
     2274           fh_artic     = ?
     2275           fh_prod-type = ?
     2276           fh_prod-code = ?
     2277         .
     2278         qh_tbl-name:get-next( exclusive-lock ).
     2279       END.
     2280       qh_tbl-name:query-close() .
     2281       delete object qh_tbl-name.
     2282       delete object bh_tbl-name.
     2283       if g#news = true
     2284         and g#db-num <> 0
     2285         and lookup( p-tbl-name, ( news-list + ",":U + attach-list ) ) <> 0
     2286       then do:
     2287         run ren-route-dump in this-procedure
     2288           ( input "ren-art":U
     2289            ,input p-old-gds-key-rec
     2290            ,input p-tbl-name
     2291            ,input p-old-artic
     2292            ,input p-old-prod-type
     2293            ,input p-old-prod-code
     2294            ,input p-new-artic
     2295            ,input p-new-prod-type
     2296            ,input p-new-prod-code
     2297            ,input ?
     2298            ,input ?
     2299           ) no-error .
     2300         if error-status :error then do:
     2301           undo, return error substitute( "&1 (ren-artic). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
     2302         end.
     2303       end.
     2304     end.
     2305     return .
     2306   end procedure.
     2307   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2308   procedure valid-ren-art-tbl-list :
     2309     do
     2310     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2311     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2312     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2313     :
     2314       define variable v-std-list        as character no-undo .
     2315       define variable v-ignore-list     as character no-undo .
     2316       define variable v-special-list    as character no-undo .
     2317       assign
     2318         v-std-list     = "cli-gds,cli-gds-attr,cli-art,cli-art-attr,contract-specif,c-contract-specif,doc-line,c-doc-line,fbr-line,c-fbr-line,fbr-recipe,fbr-recipe-gds,fbr-pln-line,c-fbr-pln-line,gds-dtl,c-gds-dtl,gds-dtl-attr,c-gds-dtl-attr,gds-obj,inv-line,inv-line-attr,c-inv-line,ot-supp-line,ot-supp-line-attr,ot-line-attr,ord-line,c-ord-line,ord-line-rcv,ord-dtl,c-ord-dtl,ord-dtl-attr,ord-dtl-rcv,ord-dtl-cons,ord-gds-cons,prt-obj,prt-obj-attr,parts,c-parts,parts-supp,parts-supp-attr,price-list,c-price-list,price-doc-forming-gds,c-price-doc-forming-gds,price-doc-forming-gds-qnty,c-price-doc-forming-gds-qnty,price-doc-forming-gds-sum,c-price-doc-forming-gds-sum,price-doc-forming-gds-tnv,c-price-doc-forming-gds-tnv,recipe,recipe-gds,c-recipe,c-recipe-gds,c-recipe-hist,stk-supp-line,stk-supp-line-attr,stk-line-attr,tmp-sale-dtl,tmp-sale-dtl-attr,tmp-sale-gds,tmp-sale-gds-attr":U
     2319         v-ignore-list  = "c-goods,c-order-line":U
     2320         v-special-list = "goods,ot-line,stk-line,order-line":U
     2321       .
     2322   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2323       define variable v-ind         as integer   no-undo .
     2324       define variable v-num-entries as integer   no-undo .
     2325       define variable v-inform      as character no-undo .
     2326       define variable bh_tbl-name   as handle    no-undo .
     2327       define variable v-tbl-not-idx as character no-undo .
     2328       define variable v-idx-avail   as logical   no-undo .
     2329       define variable new-tbl-list  as character no-undo .
     2330       define variable old-tbl-list  as character no-undo .
     2331       define variable old-tbl-avail as logical   no-undo .
     2332       define variable v-double-tbl  as character no-undo .
     2333       define variable v-tbl-name    as character no-undo .
     2334       define variable v-msg         as character no-undo .
     2335       assign
     2336         v-msg         = "":U
     2337         v-tbl-not-idx = "":U
     2338         new-tbl-list  = "":U
     2339       .
     2340       for each ub._Field no-lock
     2341         where ub._Field._Field-Name = 'artic':U
     2342       ,first ub._File of ub._Field
     2343       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2344       :
     2345         if  lookup( ub._File._File-Name, v-std-list     ) = 0
     2346         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
     2347         and lookup( ub._File._File-Name, v-special-list ) = 0
     2348         then do:
     2349           assign
     2350             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
     2351           .
     2352         end.
     2353         if lookup( ub._File._File-Name, v-std-list ) <> 0
     2354           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
     2355         then do:
     2356           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
     2357           assign
     2358             v-idx-avail = false
     2359             v-inform    = bh_tbl-name:index-information(1)
     2360             v-ind       = 2
     2361           .
     2362           block_chk-idx:
     2363           do while v-inform <> ?
     2364           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2365           :
     2366             if v-inform <> ?
     2367                 and lookup( entry( 5, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     2368                 and lookup( entry( 7, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     2369                 and lookup( entry( 9, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     2370             then do:
     2371               assign
     2372                 v-idx-avail = true
     2373               .
     2374               leave block_chk-idx.
     2375             end.
     2376             assign
     2377               v-inform = bh_tbl-name:index-information( v-ind )
     2378               v-ind    = v-ind + 1
     2379             .
     2380           end.
     2381           if v-idx-avail = false then do:
     2382             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
     2383               assign
     2384                 new-tbl-list = new-tbl-list + " (индекса нет)"
     2385               .
     2386             end.
     2387             else do:
     2388               assign
     2389                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
     2390               .
     2391             end.
     2392           end.
     2393           delete object bh_tbl-name.
     2394         end.
     2395       end.
     2396       assign
     2397         old-tbl-list  = "":U
     2398         v-double-tbl  = "":U
     2399         v-num-entries = num-entries( v-std-list )
     2400       .
     2401       do v-ind = 1 to v-num-entries
     2402       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2403       :
     2404         assign
     2405           v-tbl-name    = entry( v-ind, v-std-list )
     2406           old-tbl-avail = false
     2407         .
     2408         find first ub._File no-lock
     2409           where ub._File._File-Name = v-tbl-name
     2410           no-error .
     2411         if not available ub._File then do:
     2412           assign
     2413             old-tbl-avail = true
     2414           .
     2415         end.
     2416         else do:
     2417           find first ub._Field no-lock
     2418             where ub._Field._File-recid = recid( ub._File )
     2419               and ub._Field._Field-Name = 'artic':U
     2420             no-error .
     2421           if not available ub._Field then do:
     2422             assign
     2423               old-tbl-avail = true
     2424             .
     2425           end.
     2426             find first ub._Field no-lock
     2427               where ub._Field._File-recid = recid( ub._File )
     2428                 and ub._Field._Field-Name = "prod-type"
     2429               no-error .
     2430             if not available ub._Field then do:
     2431               assign
     2432                 old-tbl-avail = true
     2433               .
     2434             end.
     2435             find first ub._Field no-lock
     2436               where ub._Field._File-recid = recid( ub._File )
     2437                 and ub._Field._Field-Name = "prod-code"
     2438               no-error .
     2439             if not available ub._Field then do:
     2440               assign
     2441                 old-tbl-avail = true
     2442               .
     2443             end.
     2444         end.
     2445         if old-tbl-avail = true then do:
     2446           assign
     2447             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2448           .
     2449         end.
     2450         if ( lookup( v-tbl-name, v-std-list ) > v-ind
     2451              or lookup( v-tbl-name, v-ignore-list ) > 0
     2452              or lookup( v-tbl-name, v-special-list ) > 0
     2453            )
     2454           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2455         then do:
     2456           assign
     2457             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2458           .
     2459         end.
     2460       end.
     2461       assign
     2462         v-num-entries = num-entries( v-ignore-list )
     2463       .
     2464       do v-ind = 1 to v-num-entries
     2465       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2466       :
     2467         assign
     2468           v-tbl-name = entry( v-ind, v-ignore-list )
     2469           old-tbl-avail = false
     2470         .
     2471         find first ub._File no-lock
     2472           where ub._File._File-Name = v-tbl-name
     2473           no-error .
     2474         if not available ub._File then do:
     2475           assign
     2476             old-tbl-avail = true
     2477           .
     2478         end.
     2479         else do:
     2480           find first ub._Field no-lock
     2481             where ub._Field._File-recid = recid( ub._File )
     2482               and ub._Field._Field-Name = 'artic':U
     2483             no-error .
     2484           if not available ub._Field then do:
     2485             assign
     2486               old-tbl-avail = true
     2487             .
     2488           end.
     2489             find first ub._Field no-lock
     2490               where ub._Field._File-recid = recid( ub._File )
     2491                 and ub._Field._Field-Name = "prod-type"
     2492               no-error .
     2493             if not available ub._Field then do:
     2494               assign
     2495                 old-tbl-avail = true
     2496               .
     2497             end.
     2498             find first ub._Field no-lock
     2499               where ub._Field._File-recid = recid( ub._File )
     2500                 and ub._Field._Field-Name = "prod-code"
     2501               no-error .
     2502             if not available ub._Field then do:
     2503               assign
     2504                 old-tbl-avail = true
     2505               .
     2506             end.
     2507         end.
     2508         if old-tbl-avail = true then do:
     2509           assign
     2510             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2511           .
     2512         end.
     2513         if ( lookup( v-tbl-name, v-std-list ) > 0
     2514              or lookup( v-tbl-name, v-ignore-list ) > v-ind
     2515              or lookup( v-tbl-name, v-special-list ) > 0
     2516            )
     2517           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2518         then do:
     2519           assign
     2520             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2521           .
     2522         end.
     2523       end.
     2524       assign
     2525         v-num-entries = num-entries( v-special-list )
     2526       .
     2527       do v-ind = 1 to v-num-entries
     2528       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2529       :
     2530         assign
     2531           v-tbl-name = entry( v-ind, v-special-list )
     2532         .
     2533         find first ub._File no-lock
     2534           where ub._File._File-Name = v-tbl-name
     2535           no-error .
     2536         if available ub._File then do:
     2537           find first ub._Field no-lock
     2538             where ub._Field._File-recid = recid( ub._File )
     2539               and ub._Field._Field-Name = 'artic':U
     2540             no-error .
     2541         end.
     2542         if not available ub._File
     2543           or ( available ub._File
     2544                and not available ub._Field
     2545              )
     2546         then do:
     2547           assign
     2548             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2549           .
     2550         end.
     2551         if ( lookup( v-tbl-name, v-std-list ) > 0
     2552              or lookup( v-tbl-name, v-ignore-list ) > 0
     2553              or lookup( v-tbl-name, v-special-list ) > v-ind
     2554            )
     2555           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2556         then do:
     2557           assign
     2558             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2559           .
     2560         end.
     2561       end.
     2562       if v-tbl-not-idx <> "" then do:
     2563         assign
     2564           v-msg = v-msg + substitute( "Таблицы не имеют индекса с полями &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'artic, prod-type, prod-code':U )
     2565         .
     2566       end.
     2567       if new-tbl-list <> "":U then do:
     2568         assign
     2569           v-msg = v-msg + substitute( "Нет обработки таблиц: &2&1&1", chr(10), new-tbl-list )
     2570         .
     2571       end.
     2572       if v-double-tbl <> "":U then do:
     2573         assign
     2574           v-msg = v-msg + substitute( "В списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
     2575         .
     2576       end.
     2577       if old-tbl-list <> "":U then do:
     2578         assign
     2579           v-msg = v-msg + substitute( "В списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые поля: &2&1&1", chr(10), old-tbl-list )
     2580         .
     2581       end.
     2582       if v-msg <> "":U then do:
     2583         return error substitute( "Утилита переименования &3 не корректна.&1&1&2", chr(10), v-msg, 'artic, prod-type, prod-code':U ) .
     2584       end.
     2585     end.
     2586   end procedure.
     2587   do
     2588   on error undo, return error return-value
     2589   :
     2590     define buffer buf_lock_batchprocess for ub.batchprocess .
     2591     define variable v-ind         as integer   no-undo .
     2592     define variable v-num-entries as integer   no-undo .
     2593     define variable v-tbl-name    as character no-undo .
     2594     run valid-ren-art-tbl-list in this-procedure
     2595       no-error .
     2596     if error-status :error then do:
     2597       message
     2598         vss-workfile vss-revision vss-description skip
     2599         "Ошибка при проверке списка таблиц для обработки." skip
     2600         error-status :get-message(1) skip
     2601         return-value skip
     2602         view-as alert-box error .
     2603       undo, return error return-value .
     2604     end.
     2605     run gbl/lockrngd.p
     2606       (input 'grar':U
     2607       ,input 'enable':U
     2608       ,buffer buf_lock_batchprocess
     2609       ) no-error .
     2610     if error-status :error
     2611     then do:
     2612       if error-status :get-message(1) <> ""
     2613       then do:
     2614         message
     2615           vss-workfile vss-revision vss-description skip
     2616           "Ошибка при блокировании функции переименования артикула товара" skip
     2617           error-status :get-message(1) skip
     2618           return-value skip
     2619           view-as alert-box error .
     2620       end.
     2621       undo, return error return-value .
     2622     end.
     2623     update_block:
     2624     do transaction
     2625     on error undo update_block, return error return-value
     2626     :
     2627       define variable old-gds-key-rec like ub.route.uniq-key-rec  no-undo.
     2628       define buffer buf_rename_goods for ub.goods .
     2629       define buffer b-goods for ub.goods .
     2630       find first buf_rename_goods exclusive-lock
     2631         where buf_rename_goods.gds-code = old-gds-code
     2632         no-error .
     2633       if not available buf_rename_goods then do:
     2634         return error "Товар не доступен" .
     2635       end.
     2636       if buf_rename_goods.artic     <> old-artic
     2637       or buf_rename_goods.prod-type <> old-prod-type
     2638       or buf_rename_goods.prod-code <> old-prod-code
     2639       then do:
     2640         return error substitute( "Товарa с gds-code &1 artic &2 prod-type &3 prod-code &4 НЕСУЩЕСТВУЕТ!", old-gds-code, old-artic, old-prod-type, old-prod-code ) .
     2641       end.
     2642       if new-artic = "" then do:
     2643         return error "Новый артикул не может быть пустым" .
     2644       end.
     2645       if  new-artic     = old-artic
     2646       and new-prod-type = old-prod-type
     2647       and new-prod-code = old-prod-code
     2648       then do:
     2649         return "Новый артикул или производитель должен отличаться от старого" .
     2650       end.
     2651       if can-find(first b-goods no-lock
     2652         where b-goods.artic     = new-artic
     2653           and b-goods.prod-type = new-prod-type
     2654           and b-goods.prod-code = new-prod-code )
     2655       then do:
     2656         return error substitute( "Уже существует товар с артикулом &1 и производителем &2 &3", new-artic, new-prod-type, new-prod-code) .
     2657       end.
     2658       RUN gen-key-rec
     2659         (input 'goods':U
     2660         ,input (buffer buf_rename_goods:handle)
     2661         ,output old-gds-key-rec
     2662         ).
     2663       run init-temphost .
     2664       run waitfram-show in this-procedure
     2665         ( input substitute( 'Переименование артикула &1 и(или) производителя &2 &3 товара', old-artic, old-prod-type, old-prod-code )
     2666         ).
     2667       assign
     2668         v-num-entries = num-entries( "cli-gds,cli-gds-attr,cli-art,cli-art-attr,contract-specif,c-contract-specif,doc-line,c-doc-line,fbr-line,c-fbr-line,fbr-recipe,fbr-recipe-gds,fbr-pln-line,c-fbr-pln-line,gds-dtl,c-gds-dtl,gds-dtl-attr,c-gds-dtl-attr,gds-obj,inv-line,inv-line-attr,c-inv-line,ot-supp-line,ot-supp-line-attr,ot-line-attr,ord-line,c-ord-line,ord-line-rcv,ord-dtl,c-ord-dtl,ord-dtl-attr,ord-dtl-rcv,ord-dtl-cons,ord-gds-cons,prt-obj,prt-obj-attr,parts,c-parts,parts-supp,parts-supp-attr,price-list,c-price-list,price-doc-forming-gds,c-price-doc-forming-gds,price-doc-forming-gds-qnty,c-price-doc-forming-gds-qnty,price-doc-forming-gds-sum,c-price-doc-forming-gds-sum,price-doc-forming-gds-tnv,c-price-doc-forming-gds-tnv,recipe,recipe-gds,c-recipe,c-recipe-gds,c-recipe-hist,stk-supp-line,stk-supp-line-attr,stk-line-attr,tmp-sale-dtl,tmp-sale-dtl-attr,tmp-sale-gds,tmp-sale-gds-attr":U )
     2669       .
     2670       do v-ind = 1 to v-num-entries
     2671       on error  undo update_block, return error substitute( "&1 (TABLE-RART_LIST). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2672       on stop   undo update_block, return error substitute( "&1 (TABLE-RART_LIST). stop", vss-workfile )
     2673       on quit   undo update_block, return error substitute( "&1 (TABLE-RART_LIST). quit", vss-workfile )
     2674       on endkey undo update_block, return error substitute( "&1 (TABLE-RART_LIST). endkey", vss-workfile )
     2675       :
     2676         assign
     2677           v-tbl-name = entry( v-ind, "cli-gds,cli-gds-attr,cli-art,cli-art-attr,contract-specif,c-contract-specif,doc-line,c-doc-line,fbr-line,c-fbr-line,fbr-recipe,fbr-recipe-gds,fbr-pln-line,c-fbr-pln-line,gds-dtl,c-gds-dtl,gds-dtl-attr,c-gds-dtl-attr,gds-obj,inv-line,inv-line-attr,c-inv-line,ot-supp-line,ot-supp-line-attr,ot-line-attr,ord-line,c-ord-line,ord-line-rcv,ord-dtl,c-ord-dtl,ord-dtl-attr,ord-dtl-rcv,ord-dtl-cons,ord-gds-cons,prt-obj,prt-obj-attr,parts,c-parts,parts-supp,parts-supp-attr,price-list,c-price-list,price-doc-forming-gds,c-price-doc-forming-gds,price-doc-forming-gds-qnty,c-price-doc-forming-gds-qnty,price-doc-forming-gds-sum,c-price-doc-forming-gds-sum,price-doc-forming-gds-tnv,c-price-doc-forming-gds-tnv,recipe,recipe-gds,c-recipe,c-recipe-gds,c-recipe-hist,stk-supp-line,stk-supp-line-attr,stk-line-attr,tmp-sale-dtl,tmp-sale-dtl-attr,tmp-sale-gds,tmp-sale-gds-attr":U )
     2678         .
     2679         run waitfram-show in this-procedure
     2680           ( input substitute( 'Переименование артикула &1 и(или) производителя &2 &3 товара. Обработка таблицы: &4'
     2681                               ,old-artic
     2682                               ,old-prod-type
     2683                               ,old-prod-code
     2684                               ,v-tbl-name
     2685                             )
     2686           ).
     2687         run ren-artic in this-procedure
     2688           ( input v-tbl-name
     2689           ,input old-gds-key-rec
     2690           ,input old-artic
     2691           ,input old-prod-type
     2692           ,input old-prod-code
     2693           ,input new-artic
     2694           ,input new-prod-type
     2695           ,input new-prod-code
     2696           ,input "":U
     2697           ,input "":U
     2698           ,input "":U
     2699           ) no-error.
     2700         if error-status :error then do:
     2701           undo, return error substitute( "&1. Ошибка при переименовании артикула и(или) производителя товара в таблице &2&3&4&3&5"
     2702                                         ,vss-workfile
     2703                                         ,v-tbl-name
     2704                                         ,chr(10)
     2705                                         ,error-status :get-message(1)
     2706                                         ,return-value
     2707                                       ) .
     2708         end.
     2709       end.
     2710       run waitfram-show in this-procedure
     2711         ( input substitute( 'Переименование артикула &1 и(или) производителя &2 &3 товара. Обработка таблицы: &4'
     2712                             ,old-artic
     2713                             ,old-prod-type
     2714                             ,old-prod-code
     2715                             ,'ot-line':U
     2716                           )
     2717         ).
     2718       run ren-artic in this-procedure
     2719         ( input 'ot-line':U
     2720         ,input old-gds-key-rec
     2721         ,input old-artic
     2722         ,input old-prod-type
     2723         ,input old-prod-code
     2724         ,input new-artic
     2725         ,input new-prod-type
     2726         ,input new-prod-code
     2727         ,input "temp-obj":U
     2728         ,input "each temp-obj,":U
     2729         ,input "and ub.ot-line.obj-type = temp-obj.obj-type~
     2730                 and ub.ot-line.obj-code = temp-obj.obj-code":U
     2731         ) no-error.
     2732       if error-status :error then do:
     2733         undo, return error substitute( "&1. Ошибка при переименовании артикула и(или) производителя товара в таблице &2&3&4&3&5"
     2734                                       ,vss-workfile
     2735                                       ,'ot-line':U
     2736                                       ,chr(10)
     2737                                       ,error-status :get-message(1)
     2738                                       ,return-value
     2739                                     ) .
     2740       end.
     2741       run waitfram-show in this-procedure
     2742         ( input substitute( 'Переименование артикула &1 и(или) производителя &2 &3 товара. Обработка таблицы: &4'
     2743                             ,old-artic
     2744                             ,old-prod-type
     2745                             ,old-prod-code
     2746                             ,'stk-line':U
     2747                           )
     2748         ).
     2749       run ren-artic in this-procedure
     2750         ( input 'stk-line':U
     2751         ,input old-gds-key-rec
     2752         ,input old-artic
     2753         ,input old-prod-type
     2754         ,input old-prod-code
     2755         ,input new-artic
     2756         ,input new-prod-type
     2757         ,input new-prod-code
     2758         ,input "temp-obj":U
     2759         ,input "each temp-obj,":U
     2760         ,input "and ub.stk-line.obj-type = temp-obj.obj-type~
     2761                 and ub.stk-line.obj-code = temp-obj.obj-code":U
     2762         ) no-error.
     2763       if error-status :error then do:
     2764         undo, return error substitute( "&1. Ошибка при переименовании артикула и(или) производителя товара в таблице &2&3&4&3&5"
     2765                                       ,vss-workfile
     2766                                       ,'stk-line':U
     2767                                       ,chr(10)
     2768                                       ,error-status :get-message(1)
     2769                                       ,return-value
     2770                                     ) .
     2771       end.
     2772       run waitfram-show in this-procedure
     2773         ( input substitute( 'Переименование артикула &1 и(или) производителя &2 &3 товара. Обработка таблицы: &4'
     2774                             ,old-artic
     2775                             ,old-prod-type
     2776                             ,old-prod-code
     2777                             ,'goods':U
     2778                           )
     2779         ).
     2780       run ren-artic in this-procedure
     2781         ( input 'goods':U
     2782         ,input old-gds-key-rec
     2783         ,input old-artic
     2784         ,input old-prod-type
     2785         ,input old-prod-code
     2786         ,input new-artic
     2787         ,input new-prod-type
     2788         ,input new-prod-code
     2789         ,input "":U
     2790         ,input "":U
     2791         ,input "":U
     2792         ) no-error.
     2793       if error-status :error then do:
     2794         undo, return error substitute( "&1. Ошибка при переименовании артикула и(или) производителя товара в таблице &2&3&4&3&5"
     2795                                       ,vss-workfile
     2796                                       ,'goods':U
     2797                                       ,chr(10)
     2798                                       ,error-status :get-message(1)
     2799                                       ,return-value
     2800                                     ) .
     2801       end.
     2802       run waitfram-show in this-procedure
     2803         ( input substitute( 'Переименование артикула &1 и(или) производителя &2 &3 товара. Запись истории.'
     2804                             ,old-artic
     2805                             ,old-prod-type
     2806                             ,old-prod-code
     2807                           )
     2808         ).
     2809       run goodsh_write-goods-proc in this-procedure
     2810         ( buffer buf_rename_goods
     2811         ,input integer('2':U)
     2812         ,input "":U
     2813         ,input "":U
     2814         ) .
     2815       run waitfram-show in this-procedure
     2816         ( input substitute( 'Переименование артикула &1 и(или) производителя &2 &3 товара. Корректировка атрибута производителя.'
     2817                             ,old-artic
     2818                             ,old-prod-type
     2819                             ,old-prod-code
     2820                           )
     2821         ).
     2822       run update-clients-prod in this-procedure .
     2823     end.
     2824     run waitfram-hide in this-procedure .
     2825     return .
     2826   end.
     2827   procedure update-clients-prod :
     2828     do
     2829     on error undo, return error return-value
     2830     :
     2831       define buffer buf_clients for ub.clients .
     2832       define buffer buf_goods for ub.goods .
     2833       find buf_clients
     2834         where buf_clients.obj-type = new-prod-type
     2835           and buf_clients.obj-code = new-prod-code
     2836       no-error  .
     2837       if not avail buf_clients
     2838       then
     2839          return error substitute( "Производитель с типом &1 и кодом &2 НЕ СУЩЕСТВУЕТ!", new-prod-type, new-prod-code ) .
     2840       if buf_clients.is-prod <> true
     2841       then do:
     2842         assign
     2843           buf_clients.is-prod = true
     2844         .
     2845       end.
     2846       if not can-find( first buf_goods no-lock
     2847         where buf_goods.prod-type = old-prod-type
     2848           and buf_goods.prod-code = old-prod-code
     2849       )
     2850       then do:
     2851         find buf_clients
     2852           where buf_clients.obj-type = old-prod-type
     2853             and buf_clients.obj-code = old-prod-code
     2854           .
     2855         assign
     2856           buf_clients.is-prod = false
     2857         .
     2858       end.
     2859     end.
     2860   end procedure.
