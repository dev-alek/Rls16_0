        1   block-level on error undo, throw.
        2   define input  parameter old-gds-code  like ub.goods.gds-code  no-undo .
        3   define input  parameter old-artic     like ub.goods.artic     no-undo .
        4   define input  parameter old-prod-type like ub.goods.prod-type no-undo .
        5   define input  parameter old-prod-code like ub.goods.prod-code no-undo .
        6   define input  parameter new-artic     like ub.goods.artic     no-undo .
        7   define input  parameter new-prod-type like ub.goods.prod-type no-undo .
        8   define input  parameter new-prod-code like ub.goods.prod-code no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: d37bfb33277f, 3423, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       11   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:31 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: ren-art.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: utl/ren-art.p $":U .
       14   define variable vss-description as character no-undo init "Изменение артикула и(или) производителя для одного товара".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure gen-key-rec :
       86     define input  parameter p-tbl-name    as character no-undo.
       87     define input  parameter p-bh_tbl-name as handle    no-undo.
       88     define output parameter p-key-rec     as character no-undo.
       89     do
       90     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       91     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       92     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       93     :
       94       define variable fh               as handle    no-undo .
       95       define variable v-ok             as logical   no-undo .
       96       define variable v-inform         as character no-undo .
       97       define variable v-ind            as integer   no-undo .
       98       define variable v-idx-field-qnty as integer   no-undo .
       99       if p-tbl-name = ?
      100         or p-tbl-name = "":U
      101       then do:
      102         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      103       end.
      104       if not p-bh_tbl-name:available then do:
      105         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      106       end.
      107       assign
      108         p-key-rec = p-tbl-name
      109         v-inform  = p-bh_tbl-name:index-information(1)
      110         v-ind     = 2
      111       .
      112       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      113       on error undo, return error
      114       :
      115         assign
      116           v-inform = p-bh_tbl-name:index-information( v-ind )
      117           v-ind    = v-ind + 1
      118         .
      119       end.
      120       if v-inform = ?
      121         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      122         or entry( 3, v-inform, ",":U ) <> "1":U
      123       then do:
      124         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      125       end.
      126       else do:
      127         assign
      128           v-idx-field-qnty = num-entries( v-inform ) - 4
      129         .
      130         if v-idx-field-qnty < 2 then do:
      131           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      132         end.
      133         do v-ind = 1 to v-idx-field-qnty by 2
      134         on error undo, return error
      135         :
      136           assign
      137             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      138             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      139           .
      140         end.
      141       end.
      142       if p-key-rec = ? then do:
      143         assign
      144           p-key-rec = "":U
      145         .
      146         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      147       end.
      148     end.
      149     return.
      150   end procedure.
      151   procedure gen-where-keyr-tab :
      152     define input  parameter i-tableSerach as character no-undo.
      153     define input  parameter i-tablekey   as character  no-undo.
      154     define input  parameter p-key-rec    as character  no-undo.
      155     define input  parameter p-key-handle as handle     no-undo .
      156     define input  parameter p-db-name    as character  no-undo .
      157     define input  parameter p-tt-handle  as handle     no-undo .
      158     define output parameter o-Where      as character  no-undo.
      159     do
      160     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      161     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      162     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      163     :
      164       define variable v-full-tbl-name  as character no-undo .
      165       define variable bh_tbl-name      as handle    no-undo .
      166       define variable fh_key           as handle    no-undo .
      167       define variable fh_search        as handle    no-undo .
      168       define variable v-field-num      as integer   no-undo .
      169       define variable v-count-fld      as integer   no-undo .
      170       define variable v-inform         as character no-undo .
      171       define variable v-ind            as integer   no-undo .
      172       define variable v-idx-field-qnty as integer   no-undo .
      173       define variable v-field-name     as character no-undo .
      174       define variable v-field-val      as character no-undo .
      175       define variable v-word-link      as character no-undo .
      176       define variable vTable           as character no-undo.
      177       define variable bh_tbl-key       as handle    no-undo .
      178       assign
      179         p-key-rec = trim( p-key-rec )
      180       .
      181       if p-key-handle <> ? then do:
      182         if not valid-handle(p-key-handle)
      183            or p-key-handle:type <> "buffer"
      184         then do:
      185           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      186         end.
      187         if num-entries( p-key-rec, chr(3) ) > 1
      188           or p-key-rec = ?
      189           or p-key-rec = "":U
      190         then do:
      191           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      192         end.
      193       end.
      194       else do:
      195         if p-key-rec = ?
      196           or p-key-rec = "":U
      197         then do:
      198           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      199         end.
      200       end.
      201       assign
      202         vTable = entry( 1 , p-key-rec, chr(3) )
      203       .
      204       if p-tt-handle <> ?
      205         and ( not valid-handle(p-tt-handle)
      206               or p-tt-handle:type <> "buffer"
      207             )
      208       then do:
      209         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      210       end.
      211       if p-tt-handle = ? then do:
      212         assign
      213           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      214         .
      215         create buffer bh_tbl-name for table v-full-tbl-name .
      216       end.
      217       else do:
      218         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      219       end.
      220       assign
      221         v-inform = bh_tbl-name:index-information(1)
      222         v-ind    = 2
      223       .
      224       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      225       on error undo, return error
      226       :
      227         assign
      228           v-inform = bh_tbl-name:index-information( v-ind )
      229           v-ind    = v-ind + 1
      230         .
      231       end.
      232       if v-inform = ?
      233         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      234         or entry( 3, v-inform, ",":U ) <> "1":U
      235       then do:
      236         delete object bh_tbl-name no-error.
      237         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      238       end.
      239       assign
      240         v-idx-field-qnty = num-entries( v-inform ) - 4
      241       .
      242       if v-idx-field-qnty < 2 then do:
      243         delete object bh_tbl-name no-error.
      244         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      245       end.
      246       assign
      247         o-where     = "where":U
      248         v-word-link = "":U
      249         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      250         v-count-fld = 0
      251       .
      252       if i-tablekey ne "" and i-tablekey ne ?
      253       then do:
      254         assign
      255           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      256         .
      257         create buffer bh_tbl-key for table v-full-tbl-name .
      258       end.
      259       if i-tableSerach ne "" and i-tableSerach ne ?
      260       then do:
      261         delete object bh_tbl-name no-error.
      262         assign
      263           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      264         .
      265         create buffer bh_tbl-name for table v-full-tbl-name .
      266       end.
      267       block_where:
      268       do v-ind = 1 to v-idx-field-qnty by 2
      269       on error undo, return error
      270       :
      271         assign
      272           v-count-fld = v-count-fld + 1
      273         .
      274         if p-key-handle = ?
      275           and v-count-fld > v-field-num
      276         then do:
      277           leave block_where.
      278         end.
      279         define variable VfieldKeyTable as handle no-undo.
      280         assign
      281           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      282           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      283         .
      284         if     bh_tbl-key ne ?
      285         then do:
      286            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      287            if VfieldKeyTable eq ?
      288            then next block_where.
      289         end.
      290         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      291         then
      292            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      293         else
      294            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      295         if p-key-handle = ? then do:
      296           assign
      297             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      298           .
      299         end.
      300         else do:
      301           assign
      302             fh_key = p-key-handle:buffer-field( v-field-name )
      303           .
      304           if fh_key = ?
      305             or not valid-handle( fh_key )
      306           then do:
      307             delete object bh_tbl-name.
      308             if     bh_tbl-key ne ?
      309             then
      310                delete object bh_tbl-key.
      311             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      312           end.
      313           assign
      314             v-field-val = fh_key:buffer-value
      315           .
      316         end.
      317         if fh_search:data-type ="character":U then do:
      318           assign
      319             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      320             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      321             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      322             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      323             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      324             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      325             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      326             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      327             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      328             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      329             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      330             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      331             v-field-val = substitute( '"&1"', v-field-val )
      332           .
      333         end.
      334         assign
      335           o-where = substitute( "&1 &2", o-where, v-field-val )
      336         .
      337         if v-word-link = "":U then do:
      338           assign
      339             v-word-link = "and":U
      340           .
      341         end.
      342       end.
      343       delete object bh_tbl-name.
      344       if     bh_tbl-key ne ?
      345       then
      346          delete object bh_tbl-key.
      347       if p-key-handle = ?
      348         and v-count-fld <> v-field-num
      349       then do:
      350         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      351       end.
      352     end.
      353   end procedure.
      354   procedure gen-hn-keyr-tab :
      355     define input  parameter i-tableSerach as character no-undo.
      356     define input  parameter i-tablekey   as character no-undo.
      357     define input  parameter p-key-rec    as character no-undo.
      358     define input  parameter p-key-handle as handle    no-undo .
      359     define input  parameter p-db-name    as character no-undo .
      360     define input  parameter p-tt-handle  as handle    no-undo .
      361     define input  parameter p-stts-lock  as integer   no-undo .
      362     define output parameter o-hn         as handle    no-undo.
      363     define variable v-full-tbl-name as character no-undo.
      364     define variable v-where         as character no-undo.
      365     define variable bh_tbl-name     as handle    no-undo.
      366     define variable vTable          as character no-undo.
      367     do
      368     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      369     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      370     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      371         run gen-where-keyr-tab(i-tableSerach,
      372                                i-tablekey,
      373                                p-key-rec,
      374                                p-key-handle,
      375                                p-db-name,
      376                                p-tt-handle,
      377                                output v-where).
      378         if i-tableSerach ne "" and i-tableSerach ne ?
      379         then do:
      380            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      381            create buffer bh_tbl-name for table v-full-tbl-name .
      382         end.
      383         else do:
      384            if p-tt-handle = ? then do:
      385               assign
      386                  vTable = entry( 1 , p-key-rec, chr(3) )
      387               .
      388               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      389               create buffer bh_tbl-name for table v-full-tbl-name .
      390            end.
      391            else do:
      392               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      393            end.
      394         end.
      395         if p-tt-handle = ? then do:
      396            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      397         end.
      398         else do:
      399            bh_tbl-name:find-first( v-where ) no-error .
      400         end.
      401         o-hn = bh_tbl-name.
      402      end.
      403   end procedure.
      404   procedure gen-hn-keyr :
      405     define input  parameter p-key-rec    as character no-undo.
      406     define input  parameter p-key-handle as handle    no-undo .
      407     define input  parameter p-db-name    as character no-undo .
      408     define input  parameter p-tt-handle  as handle    no-undo .
      409     define input  parameter p-stts-lock  as integer   no-undo .
      410     define output parameter o-hn         as handle    no-undo.
      411     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      412   end.
      413   procedure gen-row-keyr :
      414     define input  parameter p-key-rec    as character no-undo.
      415     define input  parameter p-key-handle as handle    no-undo .
      416     define input  parameter p-db-name    as character no-undo .
      417     define input  parameter p-tt-handle  as handle    no-undo .
      418     define input  parameter p-stts-lock  as integer   no-undo .
      419     define output parameter p-tbl-row    as rowid     no-undo.
      420     define output parameter p-tbl-name   as character no-undo.
      421     define variable vHn as handle no-undo.
      422       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      423       p-tbl-row = if vHn:available then vHn:rowid else ?.
      424       p-tbl-name =  vHn:table.
      425       delete object vHn no-error.
      426     if p-tbl-row = ? then do:
      427       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      428     end.
      429     else do:
      430       return.
      431     end.
      432   end procedure.
      433   procedure gen-key-fv :
      434     define input  parameter p-key-rec    as character no-undo .
      435     define output parameter p-field-list as character no-undo .
      436     define output parameter p-value-list as character no-undo.
      437     do
      438     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      439     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      440     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      441     :
      442       define variable v-full-tbl-name  as character no-undo .
      443       define variable bh_tbl-name      as handle    no-undo .
      444       define variable v-tbl-name       as character no-undo .
      445       define variable v-field-num      as integer   no-undo .
      446       define variable v-count-fld      as integer   no-undo .
      447       define variable v-inform         as character no-undo .
      448       define variable v-ind            as integer   no-undo .
      449       define variable v-idx-field-qnty as integer   no-undo .
      450       define variable v-delim-key      as character no-undo .
      451       if p-key-rec = ?
      452         or p-key-rec = "":U
      453       then do:
      454         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      455       end.
      456       assign
      457         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      458         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      459       .
      460       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      461       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      462       assign
      463         v-inform = bh_tbl-name:index-information(1)
      464         v-ind    = 2
      465       .
      466       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      467       on error undo, return error
      468       :
      469         assign
      470           v-inform = bh_tbl-name:index-information( v-ind )
      471           v-ind    = v-ind + 1
      472         .
      473       end.
      474       if v-inform = ?
      475         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      476         or entry( 3, v-inform, ",":U ) <> "1":U
      477       then do:
      478         delete object bh_tbl-name no-error.
      479         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      480       end.
      481       assign
      482         v-idx-field-qnty = num-entries( v-inform ) - 4
      483       .
      484       if v-idx-field-qnty < 2 then do:
      485         delete object bh_tbl-name no-error.
      486         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      487       end.
      488       assign
      489         p-field-list = "":U
      490         p-value-list = "":U
      491         v-delim-key  = "":U
      492         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      493         v-count-fld  = 0
      494       .
      495       block_where:
      496       do v-ind = 1 to v-idx-field-qnty by 2
      497       on error undo, return error
      498       :
      499         assign
      500           v-count-fld = v-count-fld + 1
      501         .
      502         if v-count-fld > v-field-num then do:
      503           leave block_where.
      504         end.
      505         assign
      506           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      507           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      508         .
      509         if v-ind = 1 then do:
      510           assign
      511             v-delim-key = chr(3)
      512           .
      513         end.
      514       end.
      515       delete object bh_tbl-name.
      516       if v-count-fld <> v-field-num then do:
      517         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      518       end.
      519     end.
      520   end procedure.
      521   procedure gen-key-field :
      522     define input  parameter p-table      as character no-undo .
      523     define output parameter p-field-list as character no-undo .
      524     do
      525     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      526     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      527     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      528     :
      529       define variable v-full-tbl-name  as character no-undo .
      530       define variable bh_tbl-name      as handle    no-undo .
      531       define variable v-tbl-name       as character no-undo .
      532       define variable v-field-num      as integer   no-undo .
      533       define variable v-count-fld      as integer   no-undo .
      534       define variable v-inform         as character no-undo .
      535       define variable v-ind            as integer   no-undo .
      536       define variable v-idx-field-qnty as integer   no-undo .
      537       define variable v-delim-key      as character no-undo .
      538       if p-table = ?
      539         or p-table = "":U
      540       then do:
      541         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      542       end.
      543       assign
      544         v-tbl-name      = p-table
      545         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      546       .
      547       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      548       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      549       assign
      550         v-inform = bh_tbl-name:index-information(1)
      551         v-ind    = 2
      552       .
      553       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      554       on error undo, return error
      555       :
      556         assign
      557           v-inform = bh_tbl-name:index-information( v-ind )
      558           v-ind    = v-ind + 1
      559         .
      560       end.
      561       if v-inform = ?
      562         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      563         or entry( 3, v-inform, ",":U ) <> "1":U
      564       then do:
      565         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      566       end.
      567       assign
      568         v-idx-field-qnty = num-entries( v-inform ) - 4
      569       .
      570       if v-idx-field-qnty < 2 then do:
      571         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      572       end.
      573       assign
      574         p-field-list = "":U
      575         v-delim-key  = "":U
      576         v-count-fld  = 0
      577       .
      578       block_where:
      579       do v-ind = 1 to v-idx-field-qnty by 2
      580       on error undo, return error
      581       :
      582         assign
      583           v-count-fld = v-count-fld + 1
      584         .
      585         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      586         if v-ind = 1 then do:
      587           assign
      588             v-delim-key = chr(3)
      589           .
      590         end.
      591       end.
      592       delete object bh_tbl-name.
      593     end.
      594   end procedure.
      595   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      596   procedure cur-time :
      597      define output parameter p-today as date      no-undo .
      598      define output parameter p-time  as integer   no-undo .
      599     do
      600     on error undo, return error
      601     :
      602       define variable v-date1 as date      no-undo .
      603       define variable v-date2 as date      no-undo .
      604       define variable v-time  as integer   no-undo .
      605       assign
      606         v-date1 = today
      607         v-time  = time
      608         v-date2 = today
      609       .
      610       if v-date1 <> v-date2
      611       then do:
      612         assign
      613           v-date1 = today
      614           v-time  = v-time
      615         .
      616       end.
      617       assign
      618         p-today = v-date1
      619         p-time  = v-time
      620       .
      621     end.
      622   end.
      623   function cur-time-date returns character
      624   :
      625     return string(today, '99/99/9999':U) .
      626   end.
      627   function cur-time-mjd returns decimal
      628   :
      629     define variable v-date as date      no-undo .
      630     define variable v-time as integer   no-undo .
      631     run cur-time in this-procedure
      632       (output v-date
      633       ,output v-time
      634       ) .
      635     return integer(v-date) - 2400002 + (v-time / 86400) .
      636   end.
      637   function cur-time-get-ending-index returns integer
      638   (input p-number as integer
      639   )
      640   :
      641     if p-number < 0
      642     or p-number = ?
      643     then do:
      644       return 1 .
      645     end.
      646     define variable v-rest as integer   no-undo .
      647     assign
      648       p-number = p-number modulo 100
      649     .
      650     if p-number < 20
      651     then do:
      652       assign
      653         v-rest = p-number
      654       .
      655     end.
      656     else do:
      657       assign
      658         v-rest = p-number modulo 10
      659       .
      660     end.
      661     case v-rest :
      662       when 1
      663       then do:
      664         return 2 .
      665       end.
      666       when 2 or
      667       when 3 or
      668       when 4
      669       then do:
      670         return 3 .
      671       end.
      672       otherwise do:
      673         return 1 .
      674       end.
      675     end case .
      676   end.
      677   procedure cur-time-mjd-to-date :
      678      define input  parameter i-mjd-diff as decimal no-undo.
      679      define output parameter o-Date     as date    no-undo.
      680      define output parameter o-Time     as integer no-undo.
      681      define variable v-day-number as integer   no-undo .
      682      if    i-mjd-diff < 0
      683         or i-mjd-diff = ?
      684      then do:
      685         return "?" .
      686      end.
      687      assign
      688         v-day-number = truncate(i-mjd-diff,0).
      689         o-Date = date(v-day-number + 2400002).
      690         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      691     .
      692   end.
      693   function cur-time-mjd-to-string returns character
      694   (input p-mjd-diff as decimal
      695   )
      696   :
      697     define variable v-day-number as integer   no-undo .
      698     define variable v-seconds    as integer   no-undo .
      699     define variable v-hour       as integer   no-undo .
      700     define variable v-min        as integer   no-undo .
      701     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      702     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      703     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      704     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      705     if p-mjd-diff < 0
      706     or p-mjd-diff = ?
      707     then do:
      708       return "?" .
      709     end.
      710     assign
      711       v-day-number = integer(truncate(p-mjd-diff,0))
      712       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      713     .
      714     if v-seconds > 86400
      715     then do:
      716       assign
      717         v-seconds = 86400 - 1
      718       .
      719     end.
      720     if v-seconds < 0
      721     then do:
      722       assign
      723         v-seconds = 0
      724       .
      725     end.
      726     assign
      727       v-hour = truncate(v-seconds / 3600, 0)
      728     .
      729     assign
      730       v-seconds = v-seconds modulo 3600
      731     .
      732     assign
      733       v-min = truncate(v-seconds / 60, 0)
      734     .
      735     assign
      736       v-seconds = v-seconds modulo 60
      737     .
      738     return
      739         (if v-day-number <> 0
      740           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      741           else ""
      742         )
      743       + (if v-day-number <> 0 or v-hour <> 0
      744           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      745           else ""
      746         )
      747       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      748           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      749           else ""
      750         )
      751       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      752       .
      753   end.
      754   function cur-time-string returns character
      755   :
      756     define variable v-date as date      no-undo .
      757     define variable v-time as integer   no-undo .
      758     run cur-time in this-procedure
      759       (output v-date
      760       ,output v-time
      761       ) .
      762     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      763   end.
      764   function cur-time-string-sec returns character
      765   :
      766     define variable v-date as date      no-undo .
      767     define variable v-time as integer   no-undo .
      768     run cur-time in this-procedure
      769       (output v-date
      770       ,output v-time
      771       ) .
      772     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      773   end.
      774   function cur-time-custom  returns character
      775   (input p-prefix as character
      776   ,input p-date-format as character
      777   ,input p-delimiter as character
      778   ,input p-time-format as character
      779   ,input p-suffix as character
      780   )
      781   :
      782     define variable v-date as date      no-undo .
      783     define variable v-time as integer   no-undo .
      784     run cur-time in this-procedure
      785       (output v-date
      786       ,output v-time
      787       ) .
      788     return
      789       p-prefix
      790       + string(v-date, p-date-format)
      791       + p-delimiter
      792       + string(v-time, p-time-format)
      793       + p-suffix
      794       .
      795   end.
      796   function cur-time-print  returns character
      797   :
      798     define variable v-date as date      no-undo .
      799     define variable v-time as integer   no-undo .
      800     run cur-time in this-procedure
      801       (output v-date
      802       ,output v-time
      803       ) .
      804     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      805   end.
      806   function cur-time-datetime returns datetime
      807   :
      808     define variable v-char as character no-undo .
      809     define variable v-datetime as datetime no-undo .
      810     v-char = cur-time-string().
      811     v-datetime = datetime(v-char).
      812     return  v-datetime.
      813   end.
      814   function cur-time-string-msec returns character
      815   :
      816     define variable v-date as datetime  no-undo .
      817     v-date = now.
      818     return string(v-date) .
      819   end.
      820   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      822   define new global shared variable g#lib-nws as handle no-undo .
      823   procedure goodsh_write-goods-proc  :
      824   define parameter buffer buf_goods for ub.goods .
      825   define input parameter p-action as integer no-undo .
      826   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      827   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      828   define variable v-date as date      no-undo.
      829   define variable v-time  as integer   no-undo.
      830   define buffer buf_c-gds-hist for ub.c-gds-hist.
      831   define buffer buf_c-goods for ub.c-goods.
      832     do
      833     on error undo, return error
      834     :
      835       if not available buf_goods then do:
      836         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      837                       "Ошибка задания входных параметров:Не определен товар" ).
      838       end.
      839       if g#news then do:
      840         define variable v-send as integer no-undo .
      841         v-send = integer('0':U).
      842   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      844     (input  g#db-num
      845     ,input  'goods':U
      846     ,input  0
      847     ,input  '':U
      848     ,input  0
      849     ,input  '':U
      850     ,input  '':U
      851     ,input  '':U
      852     ,input  0
      853     ,input  0
      854     ,input  0
      855     ,input  'nws-to-hist'
      856     ,output v-send
      857     ) no-error .
      858         if v-send < 0 then return.
      859       end.
      860       run cur-time in this-procedure(output v-date, output v-time).
      861       create buf_c-goods.
      862       buffer-copy buf_goods to buf_c-goods
      863       assign
      864       buf_c-goods.gds-code             = buf_goods.gds-code
      865       buf_c-goods.chip-num           = next-value (s-gds-chip, ub)
      866       buf_c-goods.corr-time          = v-time
      867       buf_c-goods.corr-user-db-num   = g#db-num
      868       buf_c-goods.corr-user-name     = (if g#news then (chr(4) +  'СПН':U)
      869                                         else (if g#esys
      870                                               then (chr(4) +  'ВС':U)
      871                                               else g#userid)
      872                                               )
      873       buf_c-goods.corr-date          = v-date
      874       .
      875       create buf_c-gds-hist.
      876       buffer-copy buf_c-goods to buf_c-gds-hist
      877       assign
      878       buf_c-gds-hist.action =  p-action
      879       buf_c-gds-hist.subject = 'goods':U
      880       buf_c-gds-hist.is-news = g#news
      881       buf_c-gds-hist.source-type = p-source-type
      882       buf_c-gds-hist.source-ref = p-source-ref
      883       .
      884     end.
      885   end procedure.
      886   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   define variable v-waitfram-action01         as character   no-undo .
      888   define variable v-waitfram-action02         as character   no-undo .
      889   define variable v-waitfram-action03         as character   no-undo .
      890   define variable mWaitFramTextBeg            as character   no-undo.
      891   define variable mWaitFramTextEnd            as character   no-undo.
      892   define variable mWaitFramView               as logical     no-undo.
      893   define variable mWaitProcEvent              as logical     no-undo init yes.
      894   define variable mWaitFramInterval           as integer     no-undo init 1 .
      895   define variable mWaitFramStop               as logical     no-undo.
      896   define variable mWaitFramStopUser           as logical     no-undo.
      897   define variable mWaitFramStopTimeOut        as logical     no-undo.
      898   define variable mWaitFramStartProc          as datetime-tz no-undo.
      899   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      900   define button B-WaitFramStop auto-end-key
      901        label "Стоп"
      902        size 10 by 1 tooltip "Остоновить процесс".
      903   define button B-viewProcInfo
      904        label "Информация"
      905        size 15 by 1 tooltip "Информация о процесс".
      906   define frame waitfram
      907     v-waitfram-action01 format "x(72)" no-label skip
      908     v-waitfram-action02 format "x(72)" no-label skip
      909     v-waitfram-action03 format "x(72)" no-label skip
      910     B-viewProcInfo
      911     B-WaitFramStop at row 4 col 30
      912     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      913     .
      914   define new global shared variable mBatchMode as logical no-undo init ?.
      915   define variable mFramBachModHandle as handle no-undo.
      916   mFramBachModHandle = frame waitfram:handle.
      917   define variable mFameOldVis as logical no-undo.
      918   define variable mVisCUrentVin as logical no-undo.
      919   if session:batch-mode
      920   then
      921      mBatchMode = yes.
      922   if mBatchMode = ? then do:
      923     mVisCUrentVin = current-window:visible.
      924     mFameOldVis = mFramBachModHandle:visible.
      925     mFramBachModHandle:visible  = yes.
      926     mBatchMode = mFramBachModHandle:visible ne yes.
      927     mFramBachModHandle:visible = mFameOldVis.
      928     current-window:visible = mVisCUrentVin.
      929   end.
      930    if  log-manager:logfile-name ne ?
      931     then DO:
      932         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      933         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      934         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      935     end.
      936   on choose of B-WaitFramStop in frame waitfram
      937   do:
      938     mWaitFramStop = yes.
      939     mWaitFramStopUser = yes.
      940   end.
      941   function waitfram-check-timeout returns logical():
      942      define variable vtime as int64 no-undo.
      943      if mWaitFramStopTimeOut
      944      then
      945         return yes.
      946      vtime = ( now - mWaitFramStartProc ) / 1000 .
      947      if     mWaitFramTimeOut ne ?
      948         and mWaitFramTimeOut ne 0
      949         and mWaitFramTimeOut lt vtime
      950      then do:
      951         mWaitFramStopTimeOut = yes.
      952      end.
      953      return mWaitFramStopTimeOut.
      954   end.
      955   procedure waitfram-hide :
      956     if not session:batch-mode
      957     then do
      958     on error undo, return error return-value
      959     :
      960       pause 0 before-hide .
      961       if not mBatchMode then
      962         hide frame waitfram .
      963     if     not mWaitFramView
      964        and mWaitProcEvent
      965     then
      966       process events .
      967     end.
      968   end procedure.
      969   procedure waitfram-show :
      970     define input  parameter p-message as character no-undo .
      971     define variable v-left-margin as integer   no-undo .
      972     if not session:batch-mode
      973     then do
      974     on error undo, return error return-value
      975     :
      976       if length(p-message) <= 70 then do:
      977         assign
      978           v-left-margin = integer((70 - length(p-message)) / 2)
      979         .
      980         assign
      981           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      982         .
      983         assign
      984           v-waitfram-action01 = " "
      985           v-waitfram-action02 = " "
      986                                    + fill(" ", v-left-margin)
      987                                    + p-message
      988           v-waitfram-action03 = " "
      989         .
      990       end.
      991       else do:
      992         define variable vRindex1 as integer no-undo.
      993         define variable vRindex2 as integer no-undo.
      994         vRindex1 = r-index(p-message," ",70).
      995         if vRindex1 = 0
      996         then
      997            vRindex1 = 70.
      998         if length(p-message)  <= vRindex1 + 70 then do:
      999           assign
     1000             v-waitfram-action01 = " "
     1001             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1002             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1003           .
     1004         end.
     1005         else do:
     1006           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1007           if vRindex2 <= vRindex1
     1008           then
     1009              vRindex2 = vRindex1 + 70.
     1010           assign
     1011             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1012             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1013             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1014           .
     1015         end.
     1016       end.
     1017       B-viewProcInfo:visible   in frame waitfram = no.
     1018       B-viewProcInfo:sensitive in frame waitfram = no.
     1019       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1020       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1021       if  (   mWaitFramView
     1022          or  mWaitProcEvent)
     1023          and not mBatchMode
     1024       then
     1025          display
     1026             v-waitfram-action01 skip
     1027             v-waitfram-action02 skip
     1028             v-waitfram-action03 skip
     1029          with frame waitfram .
     1030       if     mWaitFramView
     1031          then do:
     1032             if     mWaitFramInterval ne ?
     1033                and not mBatchMode
     1034             then
     1035                wait-for go of frame waitfram pause mWaitFramInterval.
     1036          end.
     1037          else
     1038             if     mWaitProcEvent
     1039                and not mBatchMode
     1040             then
     1041                process events .
     1042     end.
     1043   end procedure.
     1044      procedure waitfram-show-this:
     1045         define input  parameter iInterval as int64 no-undo.
     1046         define variable vtime as int64 no-undo.
     1047         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1048         mWaitFramInterval = iInterval.
     1049         run waitfram-show (substitute("&1&2 &3&4" ,
     1050                                       mWaitFramTextBeg ,
     1051                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1052                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1053                                       mWaitFramTextEnd
     1054                                      )
     1055                           ).
     1056      end.
     1057      procedure WaitFramRunPause:
     1058         define input  parameter iInterval as dec no-undo.
     1059         define variable vStart  as datetime-tz no-undo.
     1060         define variable vend    as datetime-tz no-undo.
     1061         define variable vint as int64 no-undo.
     1062         define variable vOk as logical no-undo.
     1063         vStart = now.
     1064         vend   = vStart.
     1065         publish "WaitFramPause" (iInterval,output vOk).
     1066         vend   =  now.
     1067         vint = vend - vStart.
     1068         vint = iInterval - vint / 1000.
     1069         if     not mWaitFramStop
     1070            and (   vint > 0
     1071                 or (    not vOk
     1072                     and iInterval eq ?
     1073                     )
     1074                 )
     1075         then
     1076            run waitfram-show-this (iInterval).
     1077         vend   =  now.
     1078         vint = vend - vStart.
     1079         vint = iInterval - vint / 1000.
     1080         if     not mWaitFramStop
     1081            and vint > 0
     1082         then do:
     1083            run gbl/pause.p (vint * 1000).
     1084         end.
     1085         if iInterval ne ?
     1086         then
     1087            publish "WaitFramStop".
     1088         waitfram-check-timeout().
     1089      end.
     1090      procedure WaitFramWaitFor:
     1091         define input  parameter iInterval as dec no-undo.
     1092         assign
     1093            mWaitFramStartProc   = now
     1094            mWaitFramStopUser    = no
     1095            mWaitFramStopTimeOut = no
     1096         .
     1097         block-wait:
     1098         do while not mWaitFramStop:
     1099            run WaitFramRunPause (iInterval).
     1100            if  waitfram-check-timeout()
     1101            then do:
     1102               leave block-wait.
     1103            end.
     1104         end.
     1105         run waitfram-hide.
     1106      end.
     1107   procedure waitfram-join :
     1108     define input  parameter p-line-1  as character no-undo .
     1109     define input  parameter p-line-2  as character no-undo .
     1110     define input  parameter p-line-3  as character no-undo .
     1111     define output parameter p-message as character no-undo .
     1112     do
     1113     on error undo, return error return-value
     1114     :
     1115       assign
     1116         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1117                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1118                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1119       .
     1120     end.
     1121   end procedure.
     1122   function waitfram-join-function returns character
     1123     (input p-line-1 as character
     1124     ,input p-line-2 as character
     1125     ,input p-line-3 as character
     1126     ).
     1127     define variable v-message as character no-undo .
     1128     run waitfram-join in this-procedure
     1129       (input  p-line-1
     1130       ,input  p-line-2
     1131       ,input  p-line-3
     1132       ,output v-message
     1133       ) .
     1134     return v-message .
     1135   end function .
     1136   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1137   define  temp-table temp-host no-undo
     1138     field host-code like ub.store.host-code
     1139     index xpk host-code
     1140   .
     1141   define  temp-table temp-obj no-undo
     1142     field obj-type  like ub.clients.obj-type
     1143     field obj-code  like ub.clients.obj-code
     1144     field host-code like ub.store.host-code
     1145     field db-num    like ub.clients.db-num
     1146     index xpk  obj-type obj-code
     1147     index xie1 host-code
     1148     index xie2 db-num host-code
     1149   .
     1150   procedure init-temphost:
     1151     define buffer buf_store   for ub.store .
     1152     define buffer buf_shop    for ub.shop .
     1153     define buffer buf_clients for ub.clients .
     1154     define buffer buf_db for ub.db .
     1155     define buffer buf_temp-host for temp-host .
     1156     define buffer buf_temp-obj for temp-obj .
     1157     do
     1158     on error undo, return error return-value
     1159     :
     1160       for each buf_store
     1161       on error undo, return error
     1162       :
     1163         find first buf_temp-host
     1164           where buf_temp-host.host-code = buf_store.host-code
     1165           no-error .
     1166         if not available buf_temp-host
     1167         then do:
     1168           create buf_temp-host .
     1169           assign
     1170             buf_temp-host.host-code = buf_store.host-code
     1171           .
     1172         end.
     1173         find first buf_clients no-lock
     1174           where buf_clients.obj-type = 'скл':U
     1175             and buf_clients.obj-code = buf_store.obj-code
     1176           no-error .
     1177         if not available buf_clients
     1178         then do:
     1179           message
     1180             "Ошибка при поиске клиента" skip
     1181             "Клиент" 'скл':U buf_store.obj-code skip
     1182             view-as alert-box error .
     1183           undo, return error .
     1184         end.
     1185         create buf_temp-obj .
     1186         assign
     1187           buf_temp-obj.obj-type  = 'скл':U
     1188           buf_temp-obj.obj-code  = buf_store.obj-code
     1189           buf_temp-obj.host-code = buf_store.host-code
     1190           buf_temp-obj.db-num    = buf_clients.db-num
     1191         .
     1192       end.
     1193       for each buf_shop
     1194       on error undo, return error
     1195       :
     1196         find first buf_temp-host
     1197           where buf_temp-host.host-code = buf_shop.host-code
     1198           no-error .
     1199         if not available buf_temp-host
     1200         then do:
     1201           create buf_temp-host .
     1202           assign
     1203             buf_temp-host.host-code = buf_shop.host-code
     1204           .
     1205         end.
     1206         find first buf_clients no-lock
     1207           where buf_clients.obj-type = 'маг':U
     1208             and buf_clients.obj-code = buf_shop.obj-code
     1209           no-error .
     1210         if not available buf_clients then do:
     1211           message
     1212             "Ошибка при поиске клиента" skip
     1213             "Клиент" 'маг':U buf_shop.obj-code skip
     1214             view-as alert-box error .
     1215           undo, return error .
     1216         end.
     1217         create buf_temp-obj .
     1218         assign
     1219           buf_temp-obj.obj-type  = 'маг':U
     1220           buf_temp-obj.obj-code  = buf_shop.obj-code
     1221           buf_temp-obj.host-code = buf_shop.host-code
     1222           buf_temp-obj.db-num    = buf_clients.db-num
     1223         .
     1224       end.
     1225     end.
     1226   end.
