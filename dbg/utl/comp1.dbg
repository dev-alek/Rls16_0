        1   block-level on error undo, throw.
        2   define variable v-parameters         as character no-undo .
        3   define variable v-compile-File       as character no-undo .
        4   define variable v-log-file           as character no-undo .
        5   define variable v-compile-parameters as character no-undo .
        6   define variable ch           as character no-undo .
        7   define variable v-ind        as integer   no-undo .
        8   define variable alist        as character no-undo .
        9   define stream sinp .
       10   do
       11   on error undo, return error return-value
       12   :
       13     assign
       14       v-parameters = session :parameter
       15     .
       16     if num-entries(v-parameters) < 2
       17     then do:
       18       message  "error: not all parameters specified" skip
       19               '-param parameter must be like "<program.p>,<log.log>"'
       20         view-as alert-box.
       21       return.
       22     end.
       23     assign
       24       v-compile-file   = entry(1, v-parameters)
       25       v-log-file       = entry(2, v-parameters)
       26     .
       27     assign
       28       v-compile-file = replace(v-compile-file, '\':u, '/':u)
       29     .
       30     define variable v-dir-list             as character no-undo .
       31     define variable v-num-entries-dir-list as integer   no-undo .
       32     define variable v-dir-index            as integer   no-undo .
       33     define variable v-search-index         as integer   no-undo .
       34     assign
       35       v-dir-list             = 'adm,arc,bge,cmp,cus,exe,ibs/th/rul,ibs/th/gbl,gbl,nws,rcs,ref,rep,rul,str,trg,utl':u
       36       v-num-entries-dir-list = num-entries(v-dir-list)
       37     .
       38     do v-dir-index = 1 to v-num-entries-dir-list
       39     :
       40       assign
       41         v-search-index = r-index(v-compile-file, entry(v-dir-index, v-dir-list) + '/':u)
       42       .
       43       if v-search-index > 0
       44       then do:
       45         assign
       46           v-compile-file = substring(v-compile-file, v-search-index)
       47         .
       48         if entry(v-dir-index, v-dir-list) begins "ibs" then leave.
       49       end.
       50     end.
       51     if num-entries(v-parameters) > 2
       52     then do:
       53       assign
       54         v-compile-parameters = entry(3, v-parameters)
       55       .
       56     end.
       57     if connected("ub")
       58     then do:
       59       assign
       60         alist = ''
       61       .
       62       do v-ind = 1 to num-aliases
       63       :
       64         assign
       65           alist = alist + (if alist > "" then "," else "") + alias(v-ind)
       66         .
       67       end.
       68       do v-ind = 1 to num-entries('src,dst,dictdb,db-orig,db-copy,restseq,ubflt,ubfltdst,restseqflt':u)
       69       on error undo, leave
       70       :
       71         assign
       72           ch = entry(v-ind, 'src,dst,dictdb,db-orig,db-copy,restseq,ubflt,ubfltdst,restseqflt':u)
       73         .
       74         if lookup(ch, alist) = 0
       75         then do:
       76           create alias value(ch) for database ub.
       77           assign
       78             alist = alist + (if alist > "" then "," else "") + ch
       79           .
       80         end.
       81       end.
       82     end.
       83     define variable lsalbox as logical no-undo.
       84     assign
       85       lsalbox = session :system-alert-boxes
       86     .
       87     assign
       88       session :system-alert-boxes = false
       89     .
       90     define variable v-list-file-name as character no-undo .
       91     define variable v-xref-file-name as character no-undo .
       92     define variable v-prep-file-name as character no-undo .
       93     if lookup("list", v-compile-parameters, "_") > 0
       94     then do:
       95       assign
       96         v-list-file-name = "list.txt"
       97       .
       98     end.
       99     if lookup("xref", v-compile-parameters, "_") > 0
      100     then do:
      101       assign
      102         v-xref-file-name = "xref.txt"
      103       .
      104     end.
      105     if lookup("prep", v-compile-parameters, "_") > 0
      106     then do:
      107       assign
      108         v-prep-file-name = "prep_txt.p"
      109       .
      110     end.
      111     define variable v-output-pos as integer   no-undo .
      112     if search(v-compile-file) <> ""
      113     and search(v-compile-file) <> ?
      114     then do:
      115       define variable v-line          as character no-undo case-sensitive .
      116       define variable v-compare-start as character no-undo case-sensitive .
      117       define variable v-num-line      as integer   no-undo .
      118       define variable v-revision-ok as logical   no-undo .
      119       define variable v-reason      as character no-undo .
      120       assign
      121         v-revision-ok = false
      122       .
      123       input stream sinp from value(search(v-compile-file)) .
      124       repeat
      125       :
      126         import stream sinp unformatted v-line .
      127         assign
      128           v-num-line = v-num-line + 1
      129         .
      130         if v-num-line > 70
      131         then do:
      132           leave .
      133         end.
      134         assign
      135           v-compare-start = '$':u + "Revision:"
      136         .
      137         if  v-line begins v-compare-start
      138         and substring(v-line, length(v-line), 1) = '$'
      139         then do:
      140           import stream sinp unformatted v-line .
      141           assign
      142             v-num-line = v-num-line + 1
      143           .
      144           assign
      145             v-compare-start = '$':u + "Author:"
      146           .
      147           if  v-line begins v-compare-start
      148           and substring(v-line, length(v-line), 1) = '$':u
      149           then do:
      150           end.
      151           else do:
      152             leave .
      153           end.
      154           import stream sinp unformatted v-line .
      155           assign
      156             v-num-line = v-num-line + 1
      157           .
      158           assign
      159             v-compare-start = '$':u + "Date:"
      160           .
      161           if  v-line begins v-compare-start
      162           and substring(v-line, length(v-line), 1) = '$':u
      163           then do:
      164           end.
      165           else do:
      166             leave .
      167           end.
      168           import stream sinp unformatted v-line .
      169           assign
      170             v-num-line = v-num-line + 1
      171           .
      172           assign
      173             v-compare-start = '$':u + "Workfile:"
      174           .
      175           if  v-line begins v-compare-start
      176           and substring(v-line, length(v-line), 1) = '$':u
      177           then do:
      178           end.
      179           else do:
      180             leave .
      181           end.
      182           import stream sinp unformatted v-line .
      183           assign
      184             v-num-line = v-num-line + 1
      185           .
      186           assign
      187             v-compare-start = '$':u + "Archive:"
      188           .
      189           if  v-line begins v-compare-start
      190           and substring(v-line, length(v-line), 1) = '$':u
      191           then do:
      192           end.
      193           else do:
      194             leave .
      195           end.
      196           assign
      197             v-revision-ok = true
      198           .
      199           leave .
      200         end.
      201       end.
      202       input stream sinp close .
      203     end.
      204     output to value(v-log-file).
      205     compile value(v-compile-file)
      206       listing    value(v-list-file-name)
      207       xref       value(v-xref-file-name)
      208       preprocess value(v-prep-file-name)
      209       .
      210     if v-revision-ok <> true
      211     then do:
      212       put unformatted "** Стандартный заголовок. Не найден тэг " + v-compare-start + " (1)"  skip .
      213       put unformatted "** " + v-compile-file + " Не могу понять строку " + string(v-num-line) + ". (1)" skip .
      214     end.
      215     assign
      216       v-output-pos = seek(output)
      217     .
      218     if error-status :error
      219     or compiler :error
      220     or compiler :warning
      221     or v-output-pos <> 0
      222     then do:
      223       put unformatted "** Ошибка компиляции. (1)" skip .
      224       put unformatted "** " + v-compile-file + " Не могу понять строку 1. (1)" skip .
      225     end.
      226     output close.
      227     assign
      228       session :system-alert-boxes = lsalbox
      229     .
      230     quit.
      231   end.
