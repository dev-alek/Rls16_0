        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: ubdingbd.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/ubdingbd.p $":U .
        7   define variable vss-description as character no-undo init "Перевод УБД в ГБД запуск".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define new  shared variable g#auto as logical no-undo.
       69   define new  shared variable g#news as logical no-undo.
       70   define new  shared variable g#oxml as logical no-undo.
       71   define new  shared variable g#esys as logical no-undo.
       72   define new  shared variable g#news-source-db as integer no-undo.
       73   define new  shared variable g#esys-source-esys as integer no-undo.
       74   define new  shared variable g#db-num as integer   no-undo .
       75   define new  shared variable g#userid as character no-undo .
       76   define new  shared variable g#passwd as character no-undo .
       77     g#auto = true .
       78   define variable curr-db-num as integer   no-undo .
       79   find first ub.sys-ctrl no-lock no-error .
       80   if error-status :error then do:
       81      message
       82        vss-workfile vss-revision vss-description skip
       83        error-status :get-message(1) skip
       84        return-value skip
       85        "Ошибка"
       86        view-as alert-box error
       87      .
       88      return .
       89   end.
       90   assign
       91     curr-db-num = ub.sys-ctrl.db-num
       92   .
       93   message " ПРОВЕРЬТЕ НАЛИЧИЕ РЕЗЕРВНОЙ КОПИИ БД !!!" skip (2)
       94            "ЗАПУСКАТЬ утилиту трансформации УБД" curr-db-num "в ГБД ? "
       95            view-as alert-box question
       96            buttons yes-no
       97            title "Вопрос"
       98            update v-ok as log
       99            .
      100   if not v-ok then return .
      101   message "Для перевода внутрифирменных перемещений в одну БД необходимо создать ОРГ в справочнике клиента , на которого будут переведены документы других БД"  skip (2)
      102     "Продолжать ?"
      103     view-as alert-box information
      104     buttons yes-no
      105     update v-ok.
      106   if not v-ok then return.
      107     define variable passwd as character no-undo.
      108     run gbl/d-prompt.w (
      109         'title=':u + "Выбор фиктивного контрагена " + '\':u
      110       + 'text1=':u + "Выбор фиктивного контрагена для внутренних перемещений" + '\':u
      111       + 'text2=':u + "ВВЕДИТЕ код контрагента" + '\':u
      112       + 'type=integer\':u
      113       + 'format=>>>>>>>>>>>>>>9\':u
      114       + 'fillin_row=4\':u
      115       + 'fillin_col=4\':u
      116       + 'fillin_width=20\':u
      117       ,input-output passwd
      118       ).
      119     if return-value = 'false':u
      120     then do:
      121       return .
      122     end.
      123   find first ub.clients no-lock where
      124              ub.clients.obj-code = int(passwd)  and
      125              ub.clients.obj-type = 'орг':U
      126              no-error .
      127   if error-status :error then do:
      128     message
      129       vss-workfile vss-revision vss-description skip
      130       error-status :get-message(1) skip
      131       return-value skip
      132       "Ошибка"
      133       view-as alert-box error
      134     .
      135     return .
      136   end.
      137   if not ( ub.clients.obj-type = 'орг':U  )then do:
      138      message "Выбран неправильный Контрагент !" view-as alert-box error .
      139      return .
      140   end.
      141   message   ub.clients.obj-type ub.clients.obj-code ub.clients.obj-name skip
      142     "Будет фиктивным контрагентом для внутренних перемещений с другими БД" skip (2)
      143     "Продолжать ?"
      144     view-as alert-box information
      145     buttons yes-no
      146     title "Внимание"
      147     update v-ok
      148     .
      149   if not v-ok then return .
      150     run str/diallog.w (
      151          input this-procedure
      152         ,input this-procedure
      153         ,input "utl/ubd-gbd1.p" + chr(4) + "1" + chr(4) + "1"+ chr(4) + "1"+ chr(4) + "1"
      154         ,input string(curr-db-num) + chr(4) + string(ub.clients.obj-code)
      155         ,input yes
      156         ,input ?
      157         ,input substitute('Трансформация УБД &1 в ГБД', curr-db-num)
      158         ) no-error .
      159   if error-status:error then do:
      160       message
      161       "Ошибка при Трансформации УБД в ГБД" skip
      162       error-status:get-message(1) skip
      163       return-value
      164       view-as alert-box error.
      165       undo, return error.
      166   end.
      167   message 'Все' view-as alert-box information .
