        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle    no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: getpckk.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/getpckk.p $":U .
        8   define variable vss-description as character no-undo init "Вывод в файл ключей принятых пакетов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   do
       68   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       69   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       70   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       71   :
       72     define variable v-db-num   as integer   no-undo .
       73     define variable v-pck-cnt  as integer   no-undo .
       74     define variable v-ri       as recid     no-undo .
       75     define variable v-txt-name as character no-undo .
       76     define frame inf
       77       v-db-num    label "для БД" format ">>>>>>>>9"
       78       v-pck-cnt   label "Всего пакетов"
       79       with view-as dialog-box side-labels 1 columns three-d title "Сбор информации о пакетах".
       80     define stream OutStream.
       81     define buffer buf_sys-ctrl for ub.sys-ctrl .
       82     define buffer buf_db       for ub.db .
       83     find first buf_sys-ctrl no-lock .
       84     find first buf_db no-lock
       85       where buf_db.db-num = buf_sys-ctrl.db-num
       86       .
       87     assign
       88       v-txt-name = substitute("getpck&1.txt", buf_sys-ctrl.db-num )
       89     .
       90     output stream OutStream to value( v-txt-name ) append.
       91     put stream OutStream unformatted
       92       skip(1)
       93       substitute( "&1 &2 Текущая БД: &3 (&4) Ключ БД: &5", string( today, "99/99/9999" ), string( time, "HH:MM:SS" ), buf_sys-ctrl.db-num, buf_db.db-name, buf_db.db-key )
       94       skip(1)
       95       .
       96     output stream OutStream close.
       97     assign
       98       v-pck-cnt = 0
       99     .
      100     view frame inf.
      101     if buf_sys-ctrl.db-num = 0 then do:
      102       run adm/dbs.w
      103         ( input parparentproc
      104          ,input 'ПРОСМОТР':U
      105          ,output v-ri
      106         ).
      107       if v-ri <> ? then do:
      108         find first buf_db no-lock
      109           where recid( buf_db ) = v-ri
      110         .
      111         run unload-send in this-procedure
      112           ( input buf_db.db-num
      113           ) .
      114         run unload-rcvd in this-procedure
      115           ( input buf_db.db-num
      116           ) .
      117       end.
      118     end.
      119     else do:
      120       run unload-send in this-procedure
      121         ( input 0
      122         ) .
      123       run unload-rcvd in this-procedure
      124         ( input 0
      125         ) .
      126     end.
      127     hide frame inf.
      128     message
      129       "Сбор информации завершен."
      130       view-as alert-box information.
      131     return .
      132   end.
      133   procedure unload-send :
      134     define input  parameter p-db-num as integer   no-undo .
      135     do
      136     on error  undo, return error substitute( "&1 (unload-send). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      137     on stop   undo, return error substitute( "&1 (unload-send). stop", vss-workfile )
      138     on endkey undo, return error substitute( "&1 (unload-send). endkey", vss-workfile )
      139     :
      140       define buffer buf_pck-sent for ub.pck-sent .
      141       output stream OutStream to value( v-txt-name ) append.
      142       put stream OutStream unformatted
      143         substitute( "Отправленные пакеты для БД &1:", p-db-num ) skip
      144         .
      145       output stream OutStream close.
      146       for each buf_pck-sent no-lock
      147         where buf_pck-sent.db-num = p-db-num
      148         by buf_pck-sent.pack-num
      149       on error undo, return error return-value
      150       :
      151         output stream OutStream to value( v-txt-name ) append.
      152         put stream OutStream unformatted
      153           substitute( "--> пакет &1, ключ &2, подготовлен &3 &4, отправлен &5 &6, подтвержден &7 &8."
      154                      ,buf_pck-sent.pack-num
      155                      ,buf_pck-sent.CRC-pack
      156                      ,buf_pck-sent.CreDate
      157                      ,string( buf_pck-sent.CreTime, "HH:MM:SS" )
      158                      ,buf_pck-sent.SendTxtDate
      159                      ,string( buf_pck-sent.SendTxtTime, "HH:MM:SS" )
      160                      ,buf_pck-sent.RcvdDate
      161                      ,string( buf_pck-sent.RcvdTime, "HH:MM:SS" )
      162                     )
      163           skip
      164           .
      165         output stream OutStream close.
      166         assign
      167           v-pck-cnt = v-pck-cnt + 1
      168         .
      169         do with frame inf
      170         :
      171           assign
      172             v-db-num  :screen-value = string( p-db-num, v-db-num :format)
      173             v-pck-cnt :screen-value = string( v-pck-cnt, v-pck-cnt :format)
      174           .
      175         end.
      176       end.
      177     end.
      178   end procedure.
      179   procedure unload-rcvd :
      180     define input  parameter p-db-num as integer   no-undo .
      181     do
      182     on error  undo, return error substitute( "&1 (unload-rcvd). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      183     on stop   undo, return error substitute( "&1 (unload-rcvd). stop", vss-workfile )
      184     on endkey undo, return error substitute( "&1 (unload-rcvd). endkey", vss-workfile )
      185     :
      186       define buffer buf_pck-rcvd for ub.pck-rcvd .
      187       output stream OutStream to value( v-txt-name ) append.
      188       put stream OutStream unformatted
      189         substitute( "Принятые пакеты из БД &1:", p-db-num ) skip
      190         .
      191       output stream OutStream close.
      192       for each buf_pck-rcvd no-lock
      193         where buf_pck-rcvd.db-num = p-db-num
      194         by buf_pck-rcvd.pack-num
      195       on error undo, return error return-value
      196       :
      197         output stream OutStream to value( v-txt-name ) append.
      198         put stream OutStream unformatted
      199           substitute( "<-- пакет &1, ключ &2, подготовлен &3 &4, отправлен &5 &6, подтвержден &7 &8."
      200                      ,buf_pck-rcvd.pack-num
      201                      ,buf_pck-rcvd.CRC-pack
      202                      ,buf_pck-rcvd.CreDate
      203                      ,string( buf_pck-rcvd.CreTime, "HH:MM:SS" )
      204                      ,buf_pck-rcvd.SendTxtDate
      205                      ,string( buf_pck-rcvd.SendTxtTime, "HH:MM:SS" )
      206                      ,buf_pck-rcvd.RcvdDate
      207                      ,string( buf_pck-rcvd.RcvdTime, "HH:MM:SS" )
      208                     )
      209           skip
      210           .
      211         output stream OutStream close.
      212         assign
      213           v-pck-cnt = v-pck-cnt + 1
      214         .
      215         do with frame inf
      216         :
      217           assign
      218             v-db-num  :screen-value = string( p-db-num, v-db-num :format)
      219             v-pck-cnt :screen-value = string( v-pck-cnt, v-pck-cnt :format)
      220           .
      221         end.
      222       end.
      223     end.
      224   end procedure.
