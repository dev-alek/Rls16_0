        1   block-level on error undo, throw.
        2   define input parameter p-dir1 as character no-undo .
        3   define input parameter p-dir2 as character no-undo .
        4   define input parameter p-dir3 as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: rcodecmp.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/rcodecmp.p $":U .
       10   define variable vss-description as character no-undo init "Утилита сравнения директорий версии".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "X(65)" no-undo
       70   initial "@(#)$Workfile$ $Revision$".
       71   define variable v-filelist-total-file-num           as integer      no-undo .
       72   define variable v-filelist-total-dir-num            as integer      no-undo .
       73   define variable v-filelist-main-procedure-handle    as handle       no-undo .
       74   define variable v-filelist-main-procedure-name      as character    no-undo .
       75   define temp-table temp-dirlist no-undo
       76       field dir-full-name     as character
       77       field dir-short-name    as character
       78       field need-process      as logical
       79       index xpk is primary unique dir-full-name
       80   .
       81   define temp-table temp-filelist no-undo
       82     field file-name        as character
       83     field file-name-no-ext as character
       84     field file-extension   as character
       85     field directory-name   as character
       86     field full-name        as character
       87     field dir-short-name   as character
       88     field need-process     as logical
       89     index xpk is unique primary full-name
       90     index xie1 directory-name file-name
       91     index xie2 directory-name file-name-no-ext
       92     index xie3 file-name
       93     index xie4 file-name-no-ext
       94     index xie5 need-process file-name
       95     .
       96   define stream dir-list .
       97   procedure filelist-get-file-num :
       98     define output parameter p-file-num as integer   no-undo .
       99     do
      100     on error undo, return error return-value
      101     :
      102       assign
      103         p-file-num = v-filelist-total-file-num
      104       .
      105     end.
      106   end procedure.
      107   procedure filelist-clear :
      108     do
      109     on error undo, return error return-value
      110     :
      111       define buffer buf_filelist for temp-filelist .
      112       assign
      113         v-filelist-total-file-num = 0
      114       .
      115       for each buf_filelist
      116       on error undo, return error
      117       :
      118         delete buf_filelist .
      119       end.
      120     end.
      121   end procedure.
      122   procedure filelist-init :
      123     do
      124     on error undo, return error
      125     :
      126       define input parameter p-dir-name       as character no-undo .
      127       define input parameter p-filter-ext     as logical   no-undo .
      128       define input parameter p-ext-list       as character no-undo .
      129       define input parameter p-dir-short-name as character no-undo .
      130       define buffer buf_temp-filelist for temp-filelist .
      131       if p-filter-ext = true
      132          and p-ext-list = ?
      133       or (p-filter-ext = false
      134          and p-ext-list <> ?
      135          and p-ext-list <> "":U
      136          )
      137       then do:
      138         message
      139           vss-workfile vss-revision vss-description skip
      140           "Ошибка задания входных параметров" skip
      141           "p-filter-ext" p-filter-ext skip
      142           "p-ext-list"   p-ext-list   skip
      143           view-as alert-box error .
      144         undo, return error .
      145       end.
      146       for each buf_temp-filelist
      147         where buf_temp-filelist.directory-name = p-dir-name
      148       on error undo, return error return-value
      149       :
      150         delete buf_temp-filelist .
      151       end.
      152       input stream dir-list from os-dir( p-dir-name ).
      153       define variable v-file                  as character no-undo .
      154       define variable v-path                  as character no-undo .
      155       define variable v-mask                  as character no-undo .
      156       define variable v-extension             as character no-undo .
      157       define variable v-file-name-without-ext as character no-undo .
      158       repeat
      159       on error undo, return error
      160       :
      161         import stream dir-list v-file v-path v-mask .
      162         if  v-mask <> ?
      163         and v-mask begins 'F':u
      164         then do:
      165         end.
      166         else do:
      167           next .
      168         end.
      169         if num-entries(v-file, '.':u) > 1
      170         then do:
      171           assign
      172             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      173             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      174           .
      175         end.
      176         else do:
      177           assign
      178             v-extension = ''
      179             v-file-name-without-ext = v-file
      180           .
      181         end.
      182         if p-filter-ext = true
      183         then do:
      184           if lookup(v-extension, p-ext-list) = 0
      185           then do:
      186             next .
      187           end.
      188         end.
      189         create buf_temp-filelist .
      190         assign
      191           buf_temp-filelist.file-name        = v-file
      192           buf_temp-filelist.directory-name   = p-dir-name
      193           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      194           buf_temp-filelist.file-extension   = v-extension
      195           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      196           buf_temp-filelist.dir-short-name   = p-dir-short-name
      197         .
      198         assign
      199           v-filelist-total-file-num = v-filelist-total-file-num + 1
      200         .
      201         if v-filelist-main-procedure-handle <> ?
      202         then do:
      203           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      204             (input "file":U
      205             , input v-filelist-total-file-num
      206             , input buf_temp-filelist.full-name
      207             , input buf_temp-filelist.file-name
      208             ) no-error.
      209           if error-status :error
      210           then do:
      211             message
      212               vss-workfile vss-revision vss-description skip
      213               "filelist-dirlist-subdir-init" skip(1)
      214               skip "Ошибка при вызове процедуры вывода"
      215               skip "результатов сканирования каталогов."
      216               skip return-value
      217               skip trim(error-status :get-message(1))
      218                       trim(error-status :get-message(2))
      219                       trim(error-status :get-message(3))
      220               view-as alert-box error.
      221             undo, return error .
      222           end.
      223         end.
      224       end.
      225       input stream dir-list close .
      226       return.
      227     end.
      228   end procedure.
      229   procedure filelist-dirlist-init-by-list :
      230     do
      231     on error undo, return error
      232     :
      233       define input parameter p-root-dir   as character no-undo .
      234       define input parameter p-dir-list   as character no-undo .
      235       define input parameter p-filter-ext as logical   no-undo .
      236       define input parameter p-ext-list   as character no-undo .
      237       define variable v-num-appdir as integer   no-undo .
      238       do v-num-appdir = 1 to num-entries(p-dir-list)
      239       :
      240         define variable v-curr-dir  as character no-undo .
      241         assign
      242           v-curr-dir = entry(v-num-appdir, p-dir-list)
      243         .
      244         run filelist-init in this-procedure
      245           (input p-root-dir + '/':u + v-curr-dir
      246           ,input p-filter-ext
      247           ,input p-ext-list
      248           ,input v-curr-dir
      249           ) .
      250       end.
      251     end.
      252   end procedure.
      253   procedure filelist-dirlist-clear :
      254     do
      255     on error undo, return error
      256     :
      257       define buffer buf_temp-dirlist for temp-dirlist .
      258       assign
      259           v-filelist-total-dir-num = 0
      260       .
      261       for each buf_temp-dirlist
      262       on error undo, return error
      263       :
      264         delete buf_temp-dirlist .
      265       end.
      266     end.
      267   end procedure.
      268   procedure filelist-dirlist-subdir-init :
      269   define input parameter p-dir-name   as character no-undo .
      270       define buffer buf_temp-dirlist for temp-dirlist .
      271   do
      272   for buf_temp-dirlist
      273   on error undo, return error
      274   :
      275       assign
      276           file-info :file-name = p-dir-name
      277       .
      278       if file-info :full-pathname = ?
      279       or index( file-info :file-type, "D" ) = 0
      280       then do:
      281           message
      282               vss-workfile vss-revision vss-description skip
      283               "filelist-dirlist-init: Заданного каталога не существует."
      284               skip (1)
      285               skip "Задан каталог:"
      286               skip substitute( "'&1'", p-dir-name )
      287           view-as alert-box error .
      288           undo, return error .
      289       end.
      290       input stream dir-list from os-dir( p-dir-name ).
      291       define variable v-file                  as character no-undo .
      292       define variable v-path                  as character no-undo .
      293       define variable v-mask                  as character no-undo .
      294       file-in-directory:
      295       repeat
      296       on error undo, return error
      297       :
      298           import stream dir-list
      299               v-file
      300               v-path
      301               v-mask
      302           .
      303           if  v-mask = ?
      304           or index( v-mask, 'D':u ) = 0
      305           or v-file = ".":U
      306           or v-file = "..":U
      307           then do:
      308               next file-in-directory.
      309           end.
      310           else do:
      311               find first buf_temp-dirlist
      312                    where buf_temp-dirlist.dir-full-name    = v-path
      313               no-error.
      314               if not available buf_temp-dirlist
      315               then do:
      316                   create buf_temp-dirlist .
      317                   assign
      318                       buf_temp-dirlist.dir-full-name    = v-path
      319                       buf_temp-dirlist.dir-short-name   = v-file
      320                       buf_temp-dirlist.need-process     = yes
      321                   .
      322               end.
      323               assign
      324                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      325               .
      326               if v-filelist-main-procedure-handle <> ?
      327               then do:
      328                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      329                         input "dir":U
      330                       , input v-filelist-total-dir-num
      331                       , input buf_temp-dirlist.dir-full-name
      332                       , input buf_temp-dirlist.dir-short-name
      333                   ) no-error.
      334                   if error-status :error
      335                   then do:
      336                       message
      337                           vss-workfile vss-revision vss-description skip
      338                           "filelist-dirlist-subdir-init"
      339                           skip(1)
      340                           skip "Ошибка при вызове процедуры вывода"
      341                           skip "результатов сканирования каталогов."
      342                           skip return-value
      343                           skip trim(error-status :get-message(1))
      344                                trim(error-status :get-message(2))
      345                                trim(error-status :get-message(3))
      346                       view-as alert-box error.
      347                       undo, return error .
      348                   end.
      349               end.
      350           end.
      351       end.
      352       input stream dir-list close .
      353   end.
      354   end procedure.
      355   procedure filelist-dirlist-init :
      356   define input parameter p-dir-name   as character no-undo .
      357       define variable v-file  as character no-undo.
      358       define variable v-path  as character no-undo.
      359       define variable v-mask  as character no-undo.
      360       define buffer buf_temp-dirlist for temp-dirlist .
      361   do
      362   for buf_temp-dirlist
      363   on error undo, return error
      364   :
      365       assign
      366           file-info :file-name = p-dir-name
      367       .
      368       if file-info :full-pathname = ?
      369       or index( file-info :file-type, "D" ) = 0
      370       then do:
      371           message
      372               vss-workfile vss-revision vss-description skip
      373               "filelist-dirlist-init: Заданного каталога не существует."
      374               skip (1)
      375               skip "Задан каталог:"
      376               skip substitute( "'&1'", p-dir-name )
      377           view-as alert-box error .
      378           undo, return error .
      379       end.
      380       for each buf_temp-dirlist
      381          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      382       on error undo, return error return-value
      383       :
      384           delete buf_temp-dirlist .
      385       end.
      386       create buf_temp-dirlist .
      387       assign
      388           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      389           buf_temp-dirlist.dir-short-name   = file-info :file-name
      390           buf_temp-dirlist.need-process     = yes
      391       .
      392       do
      393       while available buf_temp-dirlist
      394       on error undo, return error
      395       :
      396           run filelist-dirlist-subdir-init in this-procedure (
      397               input buf_temp-dirlist.dir-full-name
      398           ).
      399           assign
      400               buf_temp-dirlist.need-process = no
      401           .
      402           find first buf_temp-dirlist
      403                where buf_temp-dirlist.need-process = yes
      404           no-error.
      405       end.
      406   end.
      407   end procedure.
      408   procedure filelist-set-procedure-handle :
      409   define input parameter p-proc-handle    as handle           no-undo.
      410   define input parameter p-proc-name      as character        no-undo.
      411       define variable v-signature    as character    no-undo.
      412   do
      413   on error undo, return error
      414   :
      415       if p-proc-handle = ?
      416       or not valid-handle( p-proc-handle )
      417       or p-proc-handle :get-signature( p-proc-name ) = ""
      418       then do:
      419           assign
      420               v-filelist-main-procedure-handle = ?
      421               v-filelist-main-procedure-name   = ""
      422           .
      423           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      424       end.
      425       else do:
      426           assign
      427               v-signature = p-proc-handle :get-signature( p-proc-name )
      428           .
      429           if entry(   1, v-signature )    = "PROCEDURE":U
      430           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      431           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      432           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      433           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      434           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      435           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      436           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      437           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      438           then do:
      439               assign
      440                   v-filelist-main-procedure-handle = p-proc-handle
      441                   v-filelist-main-procedure-name   = p-proc-name
      442               .
      443           end.
      444           else do:
      445               assign
      446                   v-filelist-main-procedure-handle = ?
      447                   v-filelist-main-procedure-name   = ""
      448               .
      449               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      450           end.
      451       end.
      452   end.
      453   end procedure.
      454   procedure filelist-clear-procedure-handle :
      455   do
      456   on error undo, return error
      457   :
      458       assign
      459           v-filelist-main-procedure-handle = ?
      460           v-filelist-main-procedure-name   = ?
      461       .
      462   end.
      463   end procedure.
      464   procedure filelist-build-by-dirlist :
      465       define buffer buf_temp-dirlist      for temp-dirlist.
      466   do
      467   for buf_temp-dirlist
      468   on error undo, return error
      469   :
      470       for each buf_temp-dirlist
      471       on error undo, return error
      472       :
      473           run filelist-init in this-procedure (
      474                 input buf_temp-dirlist.dir-full-name
      475               , input no
      476               , input "":U
      477               , input buf_temp-dirlist.dir-short-name
      478           ).
      479       end.
      480   end.
      481   end procedure.
      482   procedure filelist-check-dir-exists :
      483   define input parameter p-dir-name   as character        no-undo.
      484   define output parameter p-exists    as logical          no-undo.
      485   do
      486   on error undo, return error
      487   :
      488       assign
      489           file-info :file-name = p-dir-name
      490       .
      491       if file-info :file-type <> ?
      492       and substring( file-info :file-type, 1, 1 ) = "D":U
      493       then do:
      494           assign
      495               p-exists = yes
      496           .
      497       end.
      498       else do:
      499           assign
      500               p-exists = no
      501           .
      502       end.
      503   end.
      504   end procedure.
      505   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506   define variable v-waitfram-action01         as character   no-undo .
      507   define variable v-waitfram-action02         as character   no-undo .
      508   define variable v-waitfram-action03         as character   no-undo .
      509   define variable mWaitFramTextBeg            as character   no-undo.
      510   define variable mWaitFramTextEnd            as character   no-undo.
      511   define variable mWaitFramView               as logical     no-undo.
      512   define variable mWaitProcEvent              as logical     no-undo init yes.
      513   define variable mWaitFramInterval           as integer     no-undo init 1 .
      514   define variable mWaitFramStop               as logical     no-undo.
      515   define variable mWaitFramStopUser           as logical     no-undo.
      516   define variable mWaitFramStopTimeOut        as logical     no-undo.
      517   define variable mWaitFramStartProc          as datetime-tz no-undo.
      518   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      519   define button B-WaitFramStop auto-end-key
      520        label "Стоп"
      521        size 10 by 1 tooltip "Остоновить процесс".
      522   define button B-viewProcInfo
      523        label "Информация"
      524        size 15 by 1 tooltip "Информация о процесс".
      525   define frame waitfram
      526     v-waitfram-action01 format "x(72)" no-label skip
      527     v-waitfram-action02 format "x(72)" no-label skip
      528     v-waitfram-action03 format "x(72)" no-label skip
      529     B-viewProcInfo
      530     B-WaitFramStop at row 4 col 30
      531     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      532     .
      533   define new global shared variable mBatchMode as logical no-undo init ?.
      534   define variable mFramBachModHandle as handle no-undo.
      535   mFramBachModHandle = frame waitfram:handle.
      536   define variable mFameOldVis as logical no-undo.
      537   define variable mVisCUrentVin as logical no-undo.
      538   if session:batch-mode
      539   then
      540      mBatchMode = yes.
      541   if mBatchMode = ? then do:
      542     mVisCUrentVin = current-window:visible.
      543     mFameOldVis = mFramBachModHandle:visible.
      544     mFramBachModHandle:visible  = yes.
      545     mBatchMode = mFramBachModHandle:visible ne yes.
      546     mFramBachModHandle:visible = mFameOldVis.
      547     current-window:visible = mVisCUrentVin.
      548   end.
      549    if  log-manager:logfile-name ne ?
      550     then DO:
      551         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      552         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      553         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      554     end.
      555   on choose of B-WaitFramStop in frame waitfram
      556   do:
      557     mWaitFramStop = yes.
      558     mWaitFramStopUser = yes.
      559   end.
      560   function waitfram-check-timeout returns logical():
      561      define variable vtime as int64 no-undo.
      562      if mWaitFramStopTimeOut
      563      then
      564         return yes.
      565      vtime = ( now - mWaitFramStartProc ) / 1000 .
      566      if     mWaitFramTimeOut ne ?
      567         and mWaitFramTimeOut ne 0
      568         and mWaitFramTimeOut lt vtime
      569      then do:
      570         mWaitFramStopTimeOut = yes.
      571      end.
      572      return mWaitFramStopTimeOut.
      573   end.
      574   procedure waitfram-hide :
      575     if not session:batch-mode
      576     then do
      577     on error undo, return error return-value
      578     :
      579       pause 0 before-hide .
      580       if not mBatchMode then
      581         hide frame waitfram .
      582     if     not mWaitFramView
      583        and mWaitProcEvent
      584     then
      585       process events .
      586     end.
      587   end procedure.
      588   procedure waitfram-show :
      589     define input  parameter p-message as character no-undo .
      590     define variable v-left-margin as integer   no-undo .
      591     if not session:batch-mode
      592     then do
      593     on error undo, return error return-value
      594     :
      595       if length(p-message) <= 70 then do:
      596         assign
      597           v-left-margin = integer((70 - length(p-message)) / 2)
      598         .
      599         assign
      600           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      601         .
      602         assign
      603           v-waitfram-action01 = " "
      604           v-waitfram-action02 = " "
      605                                    + fill(" ", v-left-margin)
      606                                    + p-message
      607           v-waitfram-action03 = " "
      608         .
      609       end.
      610       else do:
      611         define variable vRindex1 as integer no-undo.
      612         define variable vRindex2 as integer no-undo.
      613         vRindex1 = r-index(p-message," ",70).
      614         if vRindex1 = 0
      615         then
      616            vRindex1 = 70.
      617         if length(p-message)  <= vRindex1 + 70 then do:
      618           assign
      619             v-waitfram-action01 = " "
      620             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      621             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      622           .
      623         end.
      624         else do:
      625           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      626           if vRindex2 <= vRindex1
      627           then
      628              vRindex2 = vRindex1 + 70.
      629           assign
      630             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      631             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      632             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      633           .
      634         end.
      635       end.
      636       B-viewProcInfo:visible   in frame waitfram = no.
      637       B-viewProcInfo:sensitive in frame waitfram = no.
      638       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      639       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      640       if  (   mWaitFramView
      641          or  mWaitProcEvent)
      642          and not mBatchMode
      643       then
      644          display
      645             v-waitfram-action01 skip
      646             v-waitfram-action02 skip
      647             v-waitfram-action03 skip
      648          with frame waitfram .
      649       if     mWaitFramView
      650          then do:
      651             if     mWaitFramInterval ne ?
      652                and not mBatchMode
      653             then
      654                wait-for go of frame waitfram pause mWaitFramInterval.
      655          end.
      656          else
      657             if     mWaitProcEvent
      658                and not mBatchMode
      659             then
      660                process events .
      661     end.
      662   end procedure.
      663      procedure waitfram-show-this:
      664         define input  parameter iInterval as int64 no-undo.
      665         define variable vtime as int64 no-undo.
      666         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      667         mWaitFramInterval = iInterval.
      668         run waitfram-show (substitute("&1&2 &3&4" ,
      669                                       mWaitFramTextBeg ,
      670                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      671                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      672                                       mWaitFramTextEnd
      673                                      )
      674                           ).
      675      end.
      676      procedure WaitFramRunPause:
      677         define input  parameter iInterval as dec no-undo.
      678         define variable vStart  as datetime-tz no-undo.
      679         define variable vend    as datetime-tz no-undo.
      680         define variable vint as int64 no-undo.
      681         define variable vOk as logical no-undo.
      682         vStart = now.
      683         vend   = vStart.
      684         publish "WaitFramPause" (iInterval,output vOk).
      685         vend   =  now.
      686         vint = vend - vStart.
      687         vint = iInterval - vint / 1000.
      688         if     not mWaitFramStop
      689            and (   vint > 0
      690                 or (    not vOk
      691                     and iInterval eq ?
      692                     )
      693                 )
      694         then
      695            run waitfram-show-this (iInterval).
      696         vend   =  now.
      697         vint = vend - vStart.
      698         vint = iInterval - vint / 1000.
      699         if     not mWaitFramStop
      700            and vint > 0
      701         then do:
      702            run gbl/pause.p (vint * 1000).
      703         end.
      704         if iInterval ne ?
      705         then
      706            publish "WaitFramStop".
      707         waitfram-check-timeout().
      708      end.
      709      procedure WaitFramWaitFor:
      710         define input  parameter iInterval as dec no-undo.
      711         assign
      712            mWaitFramStartProc   = now
      713            mWaitFramStopUser    = no
      714            mWaitFramStopTimeOut = no
      715         .
      716         block-wait:
      717         do while not mWaitFramStop:
      718            run WaitFramRunPause (iInterval).
      719            if  waitfram-check-timeout()
      720            then do:
      721               leave block-wait.
      722            end.
      723         end.
      724         run waitfram-hide.
      725      end.
      726   procedure waitfram-join :
      727     define input  parameter p-line-1  as character no-undo .
      728     define input  parameter p-line-2  as character no-undo .
      729     define input  parameter p-line-3  as character no-undo .
      730     define output parameter p-message as character no-undo .
      731     do
      732     on error undo, return error return-value
      733     :
      734       assign
      735         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      736                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      737                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      738       .
      739     end.
      740   end procedure.
      741   function waitfram-join-function returns character
      742     (input p-line-1 as character
      743     ,input p-line-2 as character
      744     ,input p-line-3 as character
      745     ).
      746     define variable v-message as character no-undo .
      747     run waitfram-join in this-procedure
      748       (input  p-line-1
      749       ,input  p-line-2
      750       ,input  p-line-3
      751       ,output v-message
      752       ) .
      753     return v-message .
      754   end function .
      755   define stream slog .
      756   define variable v-diff-file       as character no-undo .
      757   define variable v-delbat-file     as character no-undo .
      758   define variable v-total-diff      as integer   no-undo .
      759   define variable v-total-delold    as integer   no-undo .
      760   define variable v-dir-1-signature as character no-undo .
      761   define variable v-dir-2-signature as character no-undo .
      762   do
      763   on error undo, return error return-value
      764   :
      765     run check-input-parameters in this-procedure .
      766     run filelist-clear in this-procedure .
      767     if  search(p-dir1 + chr(47) + 'dfcrc.txt':u) <> ?
      768     and search(p-dir2 + chr(47) + 'dfcrc.txt':u) <> ?
      769     then do:
      770       run gbl/md5.p
      771         (input  p-dir1 + chr(47) + 'dfcrc.txt':u
      772         ,output v-dir-1-signature
      773         ) .
      774       run gbl/md5.p
      775         (input  p-dir2 + chr(47) + 'dfcrc.txt':u
      776         ,output v-dir-2-signature
      777         ) .
      778       if v-dir-1-signature <> v-dir-2-signature
      779       then do:
      780         message
      781           "Отличаются структуры баз данных использованных для компиляции кодов" skip
      782           "Невозможно произвести сравнение *.r кодов" skip
      783           view-as alert-box error .
      784         undo, return error return-value .
      785       end.
      786     end.
      787     run waitfram-show in this-procedure
      788       (input substitute("Чтение файлов из директории &1 (старые файлы)", p-dir1)
      789       ) .
      790     run filelist-init in this-procedure
      791       (input p-dir1
      792       ,input false
      793       ,input ""
      794       ,input ""
      795       ) .
      796     run waitfram-show in this-procedure
      797       (input substitute("Чтение файлов из директории &1 (новые файлы)", p-dir2)
      798       ) .
      799     run filelist-init in this-procedure
      800       (input p-dir2
      801       ,input false
      802       ,input ""
      803       ,input ""
      804       ) .
      805     run waitfram-show in this-procedure
      806       (input substitute("Чтение файлов из директории &1", p-dir3)
      807       ) .
      808     run filelist-init in this-procedure
      809       (input p-dir3
      810       ,input false
      811       ,input ""
      812       ,input ""
      813       ) .
      814     run waitfram-show in this-procedure
      815       (input substitute("Проверка отсутствия файлов в директории &1", p-dir3)
      816       ) .
      817     run clear-dir3 in this-procedure .
      818     run check-empty-dir3 in this-procedure .
      819     run clear-log-files in this-procedure .
      820     run waitfram-show in this-procedure
      821       (input substitute("Копирование новый файлов в директорию &1", p-dir3)
      822       ) .
      823     run copy-new-files in this-procedure .
      824     run waitfram-show in this-procedure
      825       (input substitute("Создание командного файла удаления старых файлов")
      826       ) .
      827     run delete-old-files in this-procedure .
      828     run waitfram-hide in this-procedure .
      829     run display-message-finished in this-procedure .
      830   end.
      831   procedure clear-log-files :
      832     do
      833     on error undo, return error return-value
      834     :
      835       assign
      836         v-diff-file   = p-dir3 + '/':u + '!newfile.txt'
      837         v-delbat-file = p-dir3 + '/':u + '!delfile.bat'
      838       .
      839       output stream slog to value(v-diff-file) .
      840       output stream slog close .
      841       output stream slog to value(v-delbat-file) .
      842       output stream slog close .
      843     end.
      844   end procedure.
      845   procedure clear-dir3 :
      846     do
      847     on error undo, return error return-value
      848     :
      849       define variable v-ok as logical   no-undo .
      850       define buffer buf_temp-filelist for temp-filelist .
      851       find first buf_temp-filelist
      852         where buf_temp-filelist.directory-name = p-dir3
      853         no-error .
      854       if available buf_temp-filelist
      855       then do:
      856         message
      857           "Директория" p-dir3 "содержит файлы." skip
      858           "Файлы будут удалены." skip
      859           "Продолжить?" skip
      860           view-as alert-box question buttons yes-no update v-ok .
      861         if v-ok <> true
      862         then do:
      863           undo, return error .
      864         end.
      865         for each buf_temp-filelist
      866           where buf_temp-filelist.directory-name = p-dir3
      867         on error undo, return error return-value
      868         :
      869           os-delete value(buf_temp-filelist.full-name) .
      870           delete buf_temp-filelist .
      871         end.
      872       end.
      873     end.
      874   end procedure.
      875   procedure check-empty-dir3 :
      876     define buffer buf_temp-filelist for temp-filelist .
      877     do
      878     on error undo, return error return-value
      879     :
      880       run filelist-init in this-procedure
      881         (input p-dir3
      882         ,input false
      883         ,input ""
      884         ,input ""
      885         ) .
      886       find first buf_temp-filelist
      887         where buf_temp-filelist.directory-name = p-dir3
      888         no-error .
      889       if available buf_temp-filelist
      890       then do:
      891         message
      892           "Директория" p-dir3 "содержит файлы" skip
      893           "которые не могут быть удалены автоматически." skip
      894           "Невозможно продолжить сравнение файлов." skip
      895           view-as alert-box error .
      896         undo, return error return-value .
      897       end.
      898     end.
      899   end procedure.
      900   procedure copy-new-files :
      901     do
      902     on error undo, return error return-value
      903     :
      904       define variable v-new-check-sum as character no-undo .
      905       define variable v-old-check-sum as character no-undo .
      906       define buffer new_temp-filelist for temp-filelist .
      907       define buffer old_temp-filelist for temp-filelist .
      908       for each new_temp-filelist
      909         where new_temp-filelist.directory-name = p-dir2
      910       on error undo, return error
      911       :
      912         run waitfram-show in this-procedure
      913           (input substitute("Проверка файла &1", new_temp-filelist.full-name)
      914           ) .
      915         if new_temp-filelist.file-extension = "r"
      916         then do:
      917           assign
      918             rcode-info :file-name = new_temp-filelist.full-name
      919           .
      920           assign
      921             v-new-check-sum = string(rcode-info :crc-value)
      922           .
      923         end.
      924         else do:
      925           run gbl/md5.p
      926             (input  new_temp-filelist.full-name
      927             ,output v-new-check-sum
      928             ) .
      929         end.
      930         find first old_temp-filelist no-lock
      931           where old_temp-filelist.directory-name = p-dir1
      932             and old_temp-filelist.file-name      = new_temp-filelist.file-name
      933           no-error .
      934         if available old_temp-filelist
      935         then do:
      936           if old_temp-filelist.file-extension = "r"
      937           then do:
      938             assign
      939               rcode-info :file-name = old_temp-filelist.full-name
      940             .
      941             assign
      942               v-old-check-sum = string(rcode-info :crc-value)
      943             .
      944           end.
      945           else do:
      946             run gbl/md5.p
      947               (input  old_temp-filelist.full-name
      948               ,output v-old-check-sum
      949               ) .
      950           end.
      951         end.
      952         else do:
      953           assign
      954             v-old-check-sum = ?
      955           .
      956         end.
      957         if v-old-check-sum = ?
      958         or v-new-check-sum <> v-old-check-sum
      959         then do:
      960           assign
      961             v-total-diff = v-total-diff + 1
      962           .
      963           output stream slog to value(v-diff-file) append .
      964           put stream slog unformatted new_temp-filelist.file-name + chr(32)
      965             + string(v-new-check-sum) + chr(10)
      966             .
      967           output stream slog close .
      968           os-copy
      969             value(new_temp-filelist.full-name)
      970             value(p-dir3 + '/':u + new_temp-filelist.file-name)
      971             .
      972         end.
      973       end.
      974     end.
      975   end procedure.
      976   procedure delete-old-files :
      977     do
      978     on error undo, return error return-value
      979     :
      980       define buffer old_temp-filelist for temp-filelist .
      981       define buffer new_temp-filelist for temp-filelist .
      982       for each old_temp-filelist
      983         where old_temp-filelist.directory-name = p-dir1
      984           and old_temp-filelist.file-name     <> '!delfile.bat'
      985           and old_temp-filelist.file-name     <> '!newfile.txt'
      986       on error undo, return error
      987       :
      988         find first new_temp-filelist no-lock
      989           where new_temp-filelist.directory-name = p-dir2
      990             and new_temp-filelist.file-name      = old_temp-filelist.file-name
      991           no-error .
      992         if not available new_temp-filelist
      993         then do:
      994           assign
      995             v-total-delold = v-total-delold + 1
      996           .
      997           output stream slog to value(v-delbat-file) append .
      998           put stream slog unformatted 'del ':u + old_temp-filelist.file-name + chr(10) .
      999           output stream slog close .
     1000         end.
     1001       end.
     1002     end.
     1003   end procedure.
     1004   procedure display-message-finished :
     1005     do
     1006     on error undo, return error return-value
     1007     :
     1008       if v-total-diff   <> 0
     1009       or v-total-delold <> 0
     1010       then do:
     1011         message
     1012           "Сравнение директорий закончено" skip
     1013           "Старая директория" p-dir1 skip
     1014           "Новая директория" p-dir2 skip
     1015           "Недостающие файлы скопированы в директорию" p-dir3 skip
     1016           "Обнаружено новых файлов" v-total-diff skip
     1017           "Список новых файлов находится в " v-diff-file skip
     1018           "Необходимо удалить старых файлов" v-total-delold skip
     1019           "Командный файл удаления файлов" v-delbat-file skip
     1020           view-as alert-box information .
     1021       end.
     1022       else do:
     1023         message
     1024           "Сравнение директорий закончено" skip
     1025           "Старая директория" p-dir1 skip
     1026           "Новая директория" p-dir2 skip
     1027           "Различий не обнаружено" skip
     1028           view-as alert-box information .
     1029       end.
     1030     end.
     1031   end procedure.
     1032   procedure check-input-parameters :
     1033     do
     1034     on error undo, return error return-value
     1035     :
     1036       assign
     1037         file-info :file-name = p-dir1
     1038       .
     1039       if file-info :file-type = ?
     1040       or index(file-info :file-type, 'D':U ) = 0
     1041       then do:
     1042         message
     1043           "Неправильный путь" skip
     1044           "Директория" p-dir1 skip
     1045           view-as alert-box error .
     1046         undo, return error return-value .
     1047       end.
     1048       assign
     1049         file-info :file-name = p-dir2
     1050       .
     1051       if file-info :file-type = ?
     1052       or index(file-info :file-type, 'D':U ) = 0
     1053       then do:
     1054         message
     1055           "Неправильный путь" skip
     1056           "Директория" p-dir2 skip
     1057           view-as alert-box error .
     1058         undo, return error return-value .
     1059       end.
     1060       assign
     1061         file-info :file-name = p-dir3
     1062       .
     1063       if file-info :file-type = ?
     1064       or index(file-info :file-type, 'D':U ) = 0
     1065       then do:
     1066         message
     1067           "Неправильный путь" skip
     1068           "Директория" p-dir3 skip
     1069           view-as alert-box error .
     1070         undo, return error return-value .
     1071       end.
     1072     end.
     1073   end procedure.
