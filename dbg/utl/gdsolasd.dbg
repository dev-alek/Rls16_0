        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-install as logical   no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: gdsolasd.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: utl/gdsolasd.p $":U .
        9   define variable vss-description as character no-undo initial "Редактирование списка количества товара на объекте".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure cur-time :
       72      define output parameter p-today as date      no-undo .
       73      define output parameter p-time  as integer   no-undo .
       74     do
       75     on error undo, return error
       76     :
       77       define variable v-date1 as date      no-undo .
       78       define variable v-date2 as date      no-undo .
       79       define variable v-time  as integer   no-undo .
       80       assign
       81         v-date1 = today
       82         v-time  = time
       83         v-date2 = today
       84       .
       85       if v-date1 <> v-date2
       86       then do:
       87         assign
       88           v-date1 = today
       89           v-time  = v-time
       90         .
       91       end.
       92       assign
       93         p-today = v-date1
       94         p-time  = v-time
       95       .
       96     end.
       97   end.
       98   function cur-time-date returns character
       99   :
      100     return string(today, '99/99/9999':U) .
      101   end.
      102   function cur-time-mjd returns decimal
      103   :
      104     define variable v-date as date      no-undo .
      105     define variable v-time as integer   no-undo .
      106     run cur-time in this-procedure
      107       (output v-date
      108       ,output v-time
      109       ) .
      110     return integer(v-date) - 2400002 + (v-time / 86400) .
      111   end.
      112   function cur-time-get-ending-index returns integer
      113   (input p-number as integer
      114   )
      115   :
      116     if p-number < 0
      117     or p-number = ?
      118     then do:
      119       return 1 .
      120     end.
      121     define variable v-rest as integer   no-undo .
      122     assign
      123       p-number = p-number modulo 100
      124     .
      125     if p-number < 20
      126     then do:
      127       assign
      128         v-rest = p-number
      129       .
      130     end.
      131     else do:
      132       assign
      133         v-rest = p-number modulo 10
      134       .
      135     end.
      136     case v-rest :
      137       when 1
      138       then do:
      139         return 2 .
      140       end.
      141       when 2 or
      142       when 3 or
      143       when 4
      144       then do:
      145         return 3 .
      146       end.
      147       otherwise do:
      148         return 1 .
      149       end.
      150     end case .
      151   end.
      152   procedure cur-time-mjd-to-date :
      153      define input  parameter i-mjd-diff as decimal no-undo.
      154      define output parameter o-Date     as date    no-undo.
      155      define output parameter o-Time     as integer no-undo.
      156      define variable v-day-number as integer   no-undo .
      157      if    i-mjd-diff < 0
      158         or i-mjd-diff = ?
      159      then do:
      160         return "?" .
      161      end.
      162      assign
      163         v-day-number = truncate(i-mjd-diff,0).
      164         o-Date = date(v-day-number + 2400002).
      165         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      166     .
      167   end.
      168   function cur-time-mjd-to-string returns character
      169   (input p-mjd-diff as decimal
      170   )
      171   :
      172     define variable v-day-number as integer   no-undo .
      173     define variable v-seconds    as integer   no-undo .
      174     define variable v-hour       as integer   no-undo .
      175     define variable v-min        as integer   no-undo .
      176     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      177     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      178     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      179     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      180     if p-mjd-diff < 0
      181     or p-mjd-diff = ?
      182     then do:
      183       return "?" .
      184     end.
      185     assign
      186       v-day-number = integer(truncate(p-mjd-diff,0))
      187       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189     if v-seconds > 86400
      190     then do:
      191       assign
      192         v-seconds = 86400 - 1
      193       .
      194     end.
      195     if v-seconds < 0
      196     then do:
      197       assign
      198         v-seconds = 0
      199       .
      200     end.
      201     assign
      202       v-hour = truncate(v-seconds / 3600, 0)
      203     .
      204     assign
      205       v-seconds = v-seconds modulo 3600
      206     .
      207     assign
      208       v-min = truncate(v-seconds / 60, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 60
      212     .
      213     return
      214         (if v-day-number <> 0
      215           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0
      219           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      223           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      224           else ""
      225         )
      226       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      227       .
      228   end.
      229   function cur-time-string returns character
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      238   end.
      239   function cur-time-string-sec returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      248   end.
      249   function cur-time-custom  returns character
      250   (input p-prefix as character
      251   ,input p-date-format as character
      252   ,input p-delimiter as character
      253   ,input p-time-format as character
      254   ,input p-suffix as character
      255   )
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return
      264       p-prefix
      265       + string(v-date, p-date-format)
      266       + p-delimiter
      267       + string(v-time, p-time-format)
      268       + p-suffix
      269       .
      270   end.
      271   function cur-time-print  returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-datetime returns datetime
      282   :
      283     define variable v-char as character no-undo .
      284     define variable v-datetime as datetime no-undo .
      285     v-char = cur-time-string().
      286     v-datetime = datetime(v-char).
      287     return  v-datetime.
      288   end.
      289   function cur-time-string-msec returns character
      290   :
      291     define variable v-date as datetime  no-undo .
      292     v-date = now.
      293     return string(v-date) .
      294   end.
      295   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296     define variable v-cntxt-db-num        as integer   no-undo .
      297     define variable v-cntxt-userid        as character no-undo .
      298     define variable v-cntxt-level         as character no-undo .
      299     define variable v-cntxt-host-code-obj as integer   no-undo .
      300     define variable v-cntxt-obj-type      as character no-undo .
      301     define variable v-cntxt-obj-code      as integer   no-undo .
      302     define variable v-cntxt-db-num-obj    as integer   no-undo .
      303     define variable v-cntxt-is-admin      as logical   no-undo .
      304   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   define variable v-waitfram-action01         as character   no-undo .
      306   define variable v-waitfram-action02         as character   no-undo .
      307   define variable v-waitfram-action03         as character   no-undo .
      308   define variable mWaitFramTextBeg            as character   no-undo.
      309   define variable mWaitFramTextEnd            as character   no-undo.
      310   define variable mWaitFramView               as logical     no-undo.
      311   define variable mWaitProcEvent              as logical     no-undo init yes.
      312   define variable mWaitFramInterval           as integer     no-undo init 1 .
      313   define variable mWaitFramStop               as logical     no-undo.
      314   define variable mWaitFramStopUser           as logical     no-undo.
      315   define variable mWaitFramStopTimeOut        as logical     no-undo.
      316   define variable mWaitFramStartProc          as datetime-tz no-undo.
      317   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      318   define button B-WaitFramStop auto-end-key
      319        label "Стоп"
      320        size 10 by 1 tooltip "Остоновить процесс".
      321   define button B-viewProcInfo
      322        label "Информация"
      323        size 15 by 1 tooltip "Информация о процесс".
      324   define frame waitfram
      325     v-waitfram-action01 format "x(72)" no-label skip
      326     v-waitfram-action02 format "x(72)" no-label skip
      327     v-waitfram-action03 format "x(72)" no-label skip
      328     B-viewProcInfo
      329     B-WaitFramStop at row 4 col 30
      330     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      331     .
      332   define new global shared variable mBatchMode as logical no-undo init ?.
      333   define variable mFramBachModHandle as handle no-undo.
      334   mFramBachModHandle = frame waitfram:handle.
      335   define variable mFameOldVis as logical no-undo.
      336   define variable mVisCUrentVin as logical no-undo.
      337   if session:batch-mode
      338   then
      339      mBatchMode = yes.
      340   if mBatchMode = ? then do:
      341     mVisCUrentVin = current-window:visible.
      342     mFameOldVis = mFramBachModHandle:visible.
      343     mFramBachModHandle:visible  = yes.
      344     mBatchMode = mFramBachModHandle:visible ne yes.
      345     mFramBachModHandle:visible = mFameOldVis.
      346     current-window:visible = mVisCUrentVin.
      347   end.
      348    if  log-manager:logfile-name ne ?
      349     then DO:
      350         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      351         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      352         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      353     end.
      354   on choose of B-WaitFramStop in frame waitfram
      355   do:
      356     mWaitFramStop = yes.
      357     mWaitFramStopUser = yes.
      358   end.
      359   function waitfram-check-timeout returns logical():
      360      define variable vtime as int64 no-undo.
      361      if mWaitFramStopTimeOut
      362      then
      363         return yes.
      364      vtime = ( now - mWaitFramStartProc ) / 1000 .
      365      if     mWaitFramTimeOut ne ?
      366         and mWaitFramTimeOut ne 0
      367         and mWaitFramTimeOut lt vtime
      368      then do:
      369         mWaitFramStopTimeOut = yes.
      370      end.
      371      return mWaitFramStopTimeOut.
      372   end.
      373   procedure waitfram-hide :
      374     if not session:batch-mode
      375     then do
      376     on error undo, return error return-value
      377     :
      378       pause 0 before-hide .
      379       if not mBatchMode then
      380         hide frame waitfram .
      381     if     not mWaitFramView
      382        and mWaitProcEvent
      383     then
      384       process events .
      385     end.
      386   end procedure.
      387   procedure waitfram-show :
      388     define input  parameter p-message as character no-undo .
      389     define variable v-left-margin as integer   no-undo .
      390     if not session:batch-mode
      391     then do
      392     on error undo, return error return-value
      393     :
      394       if length(p-message) <= 70 then do:
      395         assign
      396           v-left-margin = integer((70 - length(p-message)) / 2)
      397         .
      398         assign
      399           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      400         .
      401         assign
      402           v-waitfram-action01 = " "
      403           v-waitfram-action02 = " "
      404                                    + fill(" ", v-left-margin)
      405                                    + p-message
      406           v-waitfram-action03 = " "
      407         .
      408       end.
      409       else do:
      410         define variable vRindex1 as integer no-undo.
      411         define variable vRindex2 as integer no-undo.
      412         vRindex1 = r-index(p-message," ",70).
      413         if vRindex1 = 0
      414         then
      415            vRindex1 = 70.
      416         if length(p-message)  <= vRindex1 + 70 then do:
      417           assign
      418             v-waitfram-action01 = " "
      419             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      420             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      421           .
      422         end.
      423         else do:
      424           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      425           if vRindex2 <= vRindex1
      426           then
      427              vRindex2 = vRindex1 + 70.
      428           assign
      429             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      430             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      431             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      432           .
      433         end.
      434       end.
      435       B-viewProcInfo:visible   in frame waitfram = no.
      436       B-viewProcInfo:sensitive in frame waitfram = no.
      437       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      438       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      439       if  (   mWaitFramView
      440          or  mWaitProcEvent)
      441          and not mBatchMode
      442       then
      443          display
      444             v-waitfram-action01 skip
      445             v-waitfram-action02 skip
      446             v-waitfram-action03 skip
      447          with frame waitfram .
      448       if     mWaitFramView
      449          then do:
      450             if     mWaitFramInterval ne ?
      451                and not mBatchMode
      452             then
      453                wait-for go of frame waitfram pause mWaitFramInterval.
      454          end.
      455          else
      456             if     mWaitProcEvent
      457                and not mBatchMode
      458             then
      459                process events .
      460     end.
      461   end procedure.
      462      procedure waitfram-show-this:
      463         define input  parameter iInterval as int64 no-undo.
      464         define variable vtime as int64 no-undo.
      465         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      466         mWaitFramInterval = iInterval.
      467         run waitfram-show (substitute("&1&2 &3&4" ,
      468                                       mWaitFramTextBeg ,
      469                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      470                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      471                                       mWaitFramTextEnd
      472                                      )
      473                           ).
      474      end.
      475      procedure WaitFramRunPause:
      476         define input  parameter iInterval as dec no-undo.
      477         define variable vStart  as datetime-tz no-undo.
      478         define variable vend    as datetime-tz no-undo.
      479         define variable vint as int64 no-undo.
      480         define variable vOk as logical no-undo.
      481         vStart = now.
      482         vend   = vStart.
      483         publish "WaitFramPause" (iInterval,output vOk).
      484         vend   =  now.
      485         vint = vend - vStart.
      486         vint = iInterval - vint / 1000.
      487         if     not mWaitFramStop
      488            and (   vint > 0
      489                 or (    not vOk
      490                     and iInterval eq ?
      491                     )
      492                 )
      493         then
      494            run waitfram-show-this (iInterval).
      495         vend   =  now.
      496         vint = vend - vStart.
      497         vint = iInterval - vint / 1000.
      498         if     not mWaitFramStop
      499            and vint > 0
      500         then do:
      501            run gbl/pause.p (vint * 1000).
      502         end.
      503         if iInterval ne ?
      504         then
      505            publish "WaitFramStop".
      506         waitfram-check-timeout().
      507      end.
      508      procedure WaitFramWaitFor:
      509         define input  parameter iInterval as dec no-undo.
      510         assign
      511            mWaitFramStartProc   = now
      512            mWaitFramStopUser    = no
      513            mWaitFramStopTimeOut = no
      514         .
      515         block-wait:
      516         do while not mWaitFramStop:
      517            run WaitFramRunPause (iInterval).
      518            if  waitfram-check-timeout()
      519            then do:
      520               leave block-wait.
      521            end.
      522         end.
      523         run waitfram-hide.
      524      end.
      525   procedure waitfram-join :
      526     define input  parameter p-line-1  as character no-undo .
      527     define input  parameter p-line-2  as character no-undo .
      528     define input  parameter p-line-3  as character no-undo .
      529     define output parameter p-message as character no-undo .
      530     do
      531     on error undo, return error return-value
      532     :
      533       assign
      534         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      535                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      536                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      537       .
      538     end.
      539   end procedure.
      540   function waitfram-join-function returns character
      541     (input p-line-1 as character
      542     ,input p-line-2 as character
      543     ,input p-line-3 as character
      544     ).
      545     define variable v-message as character no-undo .
      546     run waitfram-join in this-procedure
      547       (input  p-line-1
      548       ,input  p-line-2
      549       ,input  p-line-3
      550       ,output v-message
      551       ) .
      552     return v-message .
      553   end function .
      554   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   define temp-table userobjs_temp-user-obj no-undo
      556     field obj-type as character
      557     field obj-code as integer
      558     index xpk is primary unique obj-type obj-code
      559     .
      560   procedure userobjs_clear :
      561     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      562     do
      563     on error undo, return error return-value
      564     :
      565       for each buf_userobjs_temp-user-obj
      566       on error undo, return error return-value
      567       :
      568         delete buf_userobjs_temp-user-obj .
      569       end.
      570     end.
      571   end .
      572   procedure userobjs_object-count :
      573     define output parameter p-total-count as integer   no-undo .
      574     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      575     do
      576     on error undo, return error return-value
      577     :
      578       assign
      579         p-total-count = 0
      580       .
      581       for each buf_userobjs_temp-user-obj
      582       on error undo, return error return-value
      583       :
      584         assign
      585           p-total-count = p-total-count + 1
      586         .
      587       end.
      588     end.
      589   end.
      590   procedure userobjs_append :
      591      define input  parameter p-obj-type as character no-undo .
      592      define input  parameter p-obj-code as integer   no-undo .
      593     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      594     do
      595     on error undo, return error return-value
      596     :
      597       find first buf_userobjs_temp-user-obj
      598         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      599           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      600         no-error .
      601       if not available buf_userobjs_temp-user-obj
      602       then do:
      603         create buf_userobjs_temp-user-obj .
      604         assign
      605           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      606           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      607         .
      608       end.
      609     end.
      610   end.
      611   procedure userobjs_object-exist :
      612     define output parameter p-object-exist as logical   no-undo .
      613     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      614     do
      615     on error undo, return error return-value
      616     :
      617       find first buf_userobjs_temp-user-obj
      618         no-error .
      619       if not available buf_userobjs_temp-user-obj
      620       then do:
      621         assign
      622           p-object-exist = false
      623         .
      624       end.
      625       else do:
      626         assign
      627           p-object-exist = true
      628         .
      629       end.
      630     end.
      631   end.
      632   procedure userobjs_transfer :
      633     define input  parameter p-callback-handle as handle no-undo .
      634     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      635     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      636     do
      637     on error undo, return error return-value
      638     :
      639       if valid-handle(p-callback-handle) <> true
      640       then do:
      641         message
      642           vss-workfile vss-revision vss-description skip
      643           "Ошибка задания входных параметров" skip
      644           "Неизвестный указатель на процедуру" skip
      645           view-as alert-box error .
      646         undo, return error return-value .
      647       end.
      648       if p-callback-handle :get-signature("userobjs_append") = ""
      649       then do:
      650         message
      651           vss-workfile vss-revision vss-description skip
      652           "Ошибка задания входных параметров" skip
      653           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      654                     ,p-callback-handle :file-name
      655                     ) skip
      656           view-as alert-box error .
      657         undo, return error return-value .
      658       end.
      659       for each buf_userobjs_temp-user-obj
      660       on error undo, return error return-value
      661       :
      662         run userobjs_append in p-callback-handle
      663           (input  buf_userobjs_temp-user-obj.obj-type
      664           ,input  buf_userobjs_temp-user-obj.obj-code
      665           ) .
      666       end.
      667     end.
      668   end procedure.
      669   procedure userobjs_select-one :
      670      define input  parameter parparentproc     as widget-handle no-undo .
      671      define input  parameter p-db-num          as integer   no-undo .
      672      define input  parameter p-user-id         as character no-undo .
      673      define input  parameter p-host-code-obj   as integer   no-undo .
      674      define input  parameter p-obj-type        as character no-undo .
      675      define input  parameter p-obj-code        as integer   no-undo .
      676      define output parameter p-user-select     as logical   no-undo .
      677      define output parameter p-select-obj-type as character no-undo .
      678      define output parameter p-select-obj-code as character no-undo .
      679     do
      680     on error undo, return error return-value
      681     :
      682       run gbl/userobjs.w
      683         (input  parparentproc
      684         ,input  this-procedure :handle
      685         ,input  p-db-num
      686         ,input  p-user-id
      687         ,input  p-host-code-obj
      688         ,input  p-obj-type
      689         ,input  p-obj-code
      690         ,INPUT  "b-sel"
      691         ,output p-user-select
      692         ,output p-select-obj-type
      693         ,output p-select-obj-code
      694         ) .
      695     end.
      696   end.
      697   procedure userobjs_select-many :
      698     define input  parameter parparentproc   as widget-handle no-undo .
      699     define input  parameter p-db-num        as integer   no-undo .
      700     define input  parameter p-user-id       as character no-undo .
      701     define input  parameter p-host-code-obj as integer   no-undo .
      702     define input  parameter p-obj-type      as character no-undo .
      703     define input  parameter p-obj-code      as integer   no-undo .
      704     define output parameter p-user-select   as logical   no-undo .
      705     define variable v-select-obj-type as character no-undo .
      706     define variable v-select-obj-code as integer   no-undo .
      707     do
      708     on error undo, return error return-value
      709     :
      710       run gbl/userobjs.w
      711         (input  parparentproc
      712         ,input  this-procedure :handle
      713         ,input  p-db-num
      714         ,input  p-user-id
      715         ,input  p-host-code-obj
      716         ,input  p-obj-type
      717         ,input  p-obj-code
      718         ,INPUT  "b-sel,b-mark"
      719         ,output p-user-select
      720         ,output v-select-obj-type
      721         ,output v-select-obj-code
      722         ) .
      723     end.
      724   end.
      725   procedure thobjs :
      726      define input        parameter parparentproc     as widget-handle no-undo .
      727      define input        parameter i-bttns           as character     no-undo .
      728      define input        parameter i-list-mode       as character     no-undo.
      729      define input        parameter i-obj-type        as character     no-undo.
      730      define input        parameter i-db-num          as integer       no-undo.
      731      define input        parameter i-host-code       as integer       no-undo.
      732      define input-output parameter p-rid-list        as character     no-undo .
      733   run ref/thobjs.p
      734           ( input parparentproc
      735            ,input  this-procedure :handle
      736           , input i-bttns
      737           , input i-list-mode
      738           , input i-obj-type
      739           , input i-db-num
      740           , input i-host-code
      741           , input-output p-rid-list ) no-error .
      742   end.
      743   define stream slog .
      744   define variable v-object-ind as integer   no-undo .
      745   define variable v-ind        as integer   no-undo .
      746   define variable v-fix-ind    as integer   no-undo .
      747   do
      748   on error undo, return error
      749   :
      750     define variable v-rid-list as character no-undo .
      751     define variable v-obj-type as character no-undo .
      752     define variable v-obj-code as integer   no-undo .
      753     define variable lok as logical   no-undo .
      754     message
      755       "Процедура инициализации полей:" skip
      756       "начало товародвижения по объекту" skip
      757       "конец товародвижения по объекту" skip
      758       "Продолжить?" skip
      759       view-as alert-box question buttons yes-no update lok .
      760     if lok <> true
      761     then do:
      762       return .
      763     end.
      764   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      765     run mainmenu_getcntxt in parparentproc
      766       (output v-cntxt-db-num
      767       ,output v-cntxt-userid
      768       ,output v-cntxt-level
      769       ,output v-cntxt-host-code-obj
      770       ,output v-cntxt-obj-type
      771       ,output v-cntxt-obj-code
      772       ,output v-cntxt-db-num-obj
      773       ,output v-cntxt-is-admin
      774       ) .
      775     define variable v-user-select as logical   no-undo .
      776   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      777   run userobjs_select-many in this-procedure
      778     (input  parparentproc
      779     ,input  v-cntxt-db-num
      780     ,input  v-cntxt-userid
      781     ,input  v-cntxt-host-code-obj
      782     ,input  v-cntxt-obj-type
      783     ,input  v-cntxt-obj-code
      784     ,output v-user-select
      785     )  .
      786     if v-user-select <> true
      787     then do:
      788       message
      789         "Объект не выбран"
      790         view-as alert-box information .
      791       return .
      792     end.
      793     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      794     for each buf_userobjs_temp-user-obj
      795     on error undo, return error return-value
      796     :
      797       run process-object in this-procedure
      798         (input buf_userobjs_temp-user-obj.obj-type
      799         ,input buf_userobjs_temp-user-obj.obj-code
      800         ) .
      801     end.
      802     message
      803       "Обработка товаров закончена" skip
      804       "Всего обработано товаров на объекте" v-ind skip
      805       "Произведена корректировка товаров на объекте" v-fix-ind skip
      806       view-as alert-box information .
      807   end.
      808   procedure process-object :
      809     define input parameter p-obj-type  like ub.gds-obj.obj-type no-undo .
      810     define input parameter p-obj-code  like ub.gds-obj.obj-code no-undo .
      811     define buffer buf_gds-obj  for ub.gds-obj .
      812     define buffer buf_doc-line for ub.doc-line .
      813     define buffer buf_trn-doc  for ub.trn-doc .
      814     define buffer buf_price-list for ub.price-list .
      815     define buffer buf_price-doc  for ub.price-doc .
      816     define buffer update_gds-obj for ub.gds-obj .
      817     do
      818     on error undo, return error
      819     :
      820       define variable v-today as date      no-undo.
      821       define variable v-time  as integer   no-undo.
      822       run waitfram-show in this-procedure
      823         (input "Инициализация дат начала и конца товародвижения по объекту"
      824         ).
      825       for each buf_gds-obj no-lock
      826         where buf_gds-obj.obj-type = p-obj-type
      827           and buf_gds-obj.obj-code = p-obj-code
      828       on error undo, return error
      829       :
      830         assign
      831           v-ind = v-ind + 1
      832         .
      833         if v-ind modulo 10 = 0
      834         then do:
      835           run waitfram-show in this-procedure
      836             (input substitute("Объект &1 &2. Обработано товаров &3"
      837                    ,p-obj-type
      838                    ,p-obj-code
      839                    ,v-ind
      840                    )
      841             ).
      842         end.
      843         define variable v-root-b-code like ub.bar-code.b-code no-undo .
      844   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      845     (input  buf_gds-obj.gds-code
      846     ,input  ?
      847     ,output v-root-b-code
      848     )  .
      849         find first buf_doc-line no-lock
      850           where buf_doc-line.obj-type  = buf_gds-obj.obj-type
      851             and buf_doc-line.obj-code  = buf_gds-obj.obj-code
      852             and buf_doc-line.artic     = buf_gds-obj.artic
      853             and buf_doc-line.prod-type = buf_gds-obj.prod-type
      854             and buf_doc-line.prod-code = buf_gds-obj.prod-code
      855             and buf_doc-line.status_   = 'факт':U
      856           use-index fact-order
      857           no-error .
      858         if available buf_doc-line
      859         then do:
      860           find first buf_trn-doc no-lock
      861             where buf_trn-doc.doc-code = buf_doc-line.doc-code
      862             .
      863           if buf_gds-obj.first-doc = ?
      864           or buf_gds-obj.first-doc > buf_trn-doc.fact-date
      865           then do:
      866             assign
      867               v-fix-ind = v-fix-ind + 1
      868             .
      869             do transaction
      870             on error undo, return error
      871             :
      872               find first update_gds-obj exclusive-lock
      873                 where recid(update_gds-obj) = recid(buf_gds-obj)
      874                 .
      875               assign
      876                 update_gds-obj.first-doc = buf_trn-doc.fact-date
      877               .
      878             end.
      879           end.
      880         end.
      881         find first buf_price-list no-lock
      882           where buf_price-list.obj-type   = buf_gds-obj.obj-type
      883             and buf_price-list.obj-code   = buf_gds-obj.obj-code
      884             and buf_price-list.b-code     = v-root-b-code
      885             and buf_price-list.price-type = ""
      886             and buf_price-list.fact-order > 0
      887           use-index fact-close
      888           no-error .
      889         if available buf_price-list
      890         then do:
      891           find first buf_price-doc no-lock
      892             where buf_price-doc.doc-num = buf_price-list.doc-num
      893             .
      894           if buf_gds-obj.first-doc = ?
      895           or buf_gds-obj.first-doc > buf_price-doc.fact-date
      896           then do:
      897             assign
      898               v-fix-ind = v-fix-ind + 1
      899             .
      900             do transaction
      901             on error undo, return error
      902             :
      903               find first update_gds-obj exclusive-lock
      904                 where recid(update_gds-obj) = recid(buf_gds-obj)
      905                 .
      906               assign
      907                 update_gds-obj.first-doc = buf_price-doc.fact-date
      908               .
      909             end.
      910           end.
      911         end.
      912         find last buf_doc-line no-lock
      913           where buf_doc-line.obj-type  = buf_gds-obj.obj-type
      914             and buf_doc-line.obj-code  = buf_gds-obj.obj-code
      915             and buf_doc-line.artic     = buf_gds-obj.artic
      916             and buf_doc-line.prod-type = buf_gds-obj.prod-type
      917             and buf_doc-line.prod-code = buf_gds-obj.prod-code
      918             and buf_doc-line.status_   = 'факт':U
      919           use-index fact-order
      920           no-error .
      921         if available buf_doc-line
      922         then do:
      923           find first buf_trn-doc no-lock
      924             where buf_trn-doc.doc-code = buf_doc-line.doc-code
      925             .
      926           if buf_gds-obj.last-doc = ?
      927           or buf_gds-obj.last-doc < buf_trn-doc.fact-date
      928           then do:
      929             assign
      930               v-fix-ind = v-fix-ind + 1
      931             .
      932             do transaction
      933             on error undo, return error
      934             :
      935               find first update_gds-obj exclusive-lock
      936                 where recid(update_gds-obj) = recid(buf_gds-obj)
      937                 .
      938               assign
      939                 update_gds-obj.last-doc = buf_trn-doc.fact-date
      940               .
      941             end.
      942           end.
      943         end.
      944         find last buf_price-list no-lock
      945           where buf_price-list.obj-type   = buf_gds-obj.obj-type
      946             and buf_price-list.obj-code   = buf_gds-obj.obj-code
      947             and buf_price-list.b-code     = v-root-b-code
      948             and buf_price-list.price-type = ""
      949             and buf_price-list.fact-order > 0
      950           use-index fact-close
      951           no-error .
      952         if available buf_price-list
      953         then do:
      954           find first buf_price-doc no-lock
      955             where buf_price-doc.doc-num = buf_price-list.doc-num
      956             .
      957           if buf_gds-obj.last-doc = ?
      958           or buf_gds-obj.last-doc < buf_price-doc.fact-date
      959           then do:
      960             assign
      961               v-fix-ind = v-fix-ind + 1
      962             .
      963             do transaction
      964             on error undo, return error
      965             :
      966               find first update_gds-obj exclusive-lock
      967                 where recid(update_gds-obj) = recid(buf_gds-obj)
      968                 .
      969               assign
      970                 update_gds-obj.last-doc = buf_price-doc.fact-date
      971               .
      972             end.
      973           end.
      974         end.
      975       end.
      976       run waitfram-hide in this-procedure .
      977     end.
      978   end procedure.
