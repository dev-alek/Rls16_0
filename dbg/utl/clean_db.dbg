      213   END PROCEDURE.
      214   PROCEDURE run-load :
      215     define variable lok           as logical no-undo .
      216     define variable save_ab       as logical no-undo.
      217     define variable v-archive-ok  as logical init true  no-undo .
      218     define variable v-comment     as character no-undo .
      219     define variable v-can-print   as logical   no-undo .
      220     define buffer buf_clients for ub.clients.
      221     define buffer buf_db-attr for ub.db-attr.
      222     define buffer buf_user-login for ub.user-login.
      223     on write of ub.db-attr override do: end.
      224     do
      225     on error  undo, return error substitute( "&1 (run-load). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      226     on stop   undo, return error substitute( "&1 (run-load). stop", vss-workfile )
      227     on endkey undo, return error substitute( "&1 (run-load). endkey", vss-workfile )
      228     :
      229       assign
      230         save_ab = SESSION :APPL-ALERT-BOXES
      231         SESSION :APPL-ALERT-BOXES = NO
      232       .
      233       run write-to-log in this-procedure
      234         ( chr(10) + string(today, '99/99/9999') + " " + string(time, 'HH:MM') + chr(10)
      235         ,p-handle-callback
      236         ).
      237       if buf_sys-ctrl.db-num <> 0 then
      238       do:
      239       find first buf_clients no-lock where
      240                  buf_clients.db-num = buf_sys-ctrl.db-num .
      241       run write-to-log in this-procedure
      242         (chr(10) + "Расчет архивов." + chr(10)
      243         ,p-handle-callback
      244         ).
      245       find first buf_user-login no-lock
      246           where buf_user-login.db-num     = buf_sys-ctrl.db-num
      247             and buf_user-login.status_    = 0
      248             and buf_user-login.user-login = userid.
      249       run rep/chk-ahz.p
      250         (input        buf_clients.obj-type
      251         ,input        buf_clients.obj-code
      252         ,input        true
      253         ,input        true
      254         ,input        true
      255         ,input        true
      256         ,input        true
      257         ,input        buf_clients.db-num
      258         ,input        buf_user-login.user-id
      259         ,input-output p-date-actual-docs
      260         ,input-output p-date-actual-docs
      261         ,output       v-archive-ok
      262         ,output       v-comment
      263         ,output       v-can-print
      264       ) .
      265       if v-archive-ok = false then
      266       do:
      267         return error "Очистка БД невозможна.~nНе удалось рассчитать архивы.~n" + v-comment.
      268       end.
      269       end.
      270       run write-to-log in this-procedure
      271         (chr(10) + "Создание списка файлов для запуска." + chr(10)
      272         ,p-handle-callback
      273         ).
      274       assign
      275         lok = session :set-wait-state("compiler")
      276       .
      277       RUN cre-list-action no-error .
      278       if error-status :error then do:
      279         return error "Ошибка при создании списка файлов! " + return-value .
      280       end.
      281       assign
      282         lok = session :set-wait-state("")
      283       .
      284       run write-to-log in this-procedure
      285          ( "Очистка БД" + chr(10)
      286            + substitute( "до даты: &1",  p-date-actual-docs ) + chr(10)
      287            + chr(10)
      288            ,p-handle-callback
      289          ).
      290       do transaction
      291       on error undo, return error return-value
      292       on stop  undo, return error return-value
      293       :
      294         find current buf_sys-ctrl exclusive-lock .
      295         assign
      296           buf_sys-ctrl.sys-date = p-date-actual-docs.
      297         .
      298         find first buf_db-attr exclusive-lock
      299           where buf_db-attr.db-num    = buf_sys-ctrl.db-num
      300             and buf_db-attr.attr-code = 'cut-fin-date':U
      301           no-error .
      302         if not available buf_db-attr then do:
      303           create buf_db-attr .
      304           assign
      305             buf_db-attr.db-num    = buf_sys-ctrl.db-num
      306             buf_db-attr.attr-code = 'cut-fin-date':U
      307           .
      308         end.
      309         assign
      310           buf_db-attr.attr-value = string( p-date-actual-docs, "99/99/9999" )
      311         .
      312         release buf_db-attr.
      313         release buf_sys-ctrl.
      314       end.
      315       for each list-action no-lock on error undo, return error return-value :
      316         run clear-return-value in this-procedure .
      317         assign
      318           ttd = string(today, '99/99/9999') + " " + string(time, 'HH:MM')
      319         .
      320         if search( list-action.file-name ) = ? then do:
      321           if search( entry(1, list-action.file-name, ".":U) + ".r":U  ) = ? then do:
      322             run write-to-log in this-procedure
      323               ( ' ERROR!!! Файл: ' + list-action.file-name + ' отсутствует в версии' + chr(10)
      324               ,p-handle-callback
      325               ).
      326             return error substitute( "Не найден файл &1", list-action.file-name ) .
      327           end.
      328         end.
      329         case list-action.action :
      330           when "p"
      331           or when "w"
      332           then do:
      333             run write-to-log in this-procedure
      334               ( ttd + " Util: " + list-action.file-name + "~n"
      335               ,p-handle-callback
      336               ).
      337             assign
      338               v-old-time = ETIME
      339             .
      340             run value( list-action.file-name )
      341               (input p-date-actual-docs
      342               ,input p-handle-callback
      343               )
      344               no-error .
      345             if error-status :error then do:
      346               run write-to-log in this-procedure
      347                 ( format-etime( ETIME - v-old-time) + " ERROR: " + SUBSTITUTE("&1", RETURN-VALUE) + chr(10)
      348                 ,p-handle-callback
      349                 ).
      350               run write-to-log in this-procedure
      351                 ( error-status:GET-MESSAGE( error-status:NUM-MESSAGES )
      352                 ,p-handle-callback
      353                 ).
      354               return error return-value + "Ошибка при выполнении процедуры " + SUBSTITUTE("&1", list-action.file-name) .
      355             end.
      356           end.
      357           otherwise do:
      358             return error "Неизвестное действие " + SUBSTITUTE("&1", list-action.action) + " " + SUBSTITUTE("&1", list-action.file-name) .
      359           end.
      360         end case .
      361         run write-to-log in this-procedure
      362           (format-etime( ETIME - v-old-time) + " ... Ok " + chr(10) + SUBSTITUTE("&1", RETURN-VALUE) + chr(10)
      363           ,p-handle-callback
      364           ).
      365       end.
      366       file-info:file-name = "clean_db.log".
      367       run write-to-log in this-procedure
      368         ( 'Чистка БД успешно завершена.' + chr(10)
      369           + substitute("Лог - &1.",file-info:full-pathname) + chr(10)
      370           + string(today, '99/99/9999') + " " + string(time, 'HH:MM') + chr(10)
      371         ,p-handle-callback
      372         ).
      373       assign
      374         session :appl-alert-boxes = save_ab
      375       .
      376     end.
      377   END PROCEDURE.
      378   procedure clear-return-value :
      379     do
      380     on error undo, return error
      381     :
      382       return .
      383     end.
      384   end procedure.
