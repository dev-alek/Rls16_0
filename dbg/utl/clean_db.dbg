        1   block-level on error undo, throw.
        2   define input parameter p-date-actual-docs    as date      no-undo .
        3   define input parameter p-handle-callback     as handle    no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        6   define variable vss-date        as character no-undo init "$Date: 10/07/2025 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: clean_db.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/clean_db.p $":U .
        9   define variable vss-description as character no-undo init "Чистка базы данных до даты".
       10   define new global shared variable g#language as character no-undo .
       11   if g#language <> '' and g#language <> 'rus':U then do:
       12     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       13   end.
       14   define stream LogStream .
       15   define variable ttd        as character no-undo .
       16   define variable v-old-time as int64     no-undo .
       17   PROCEDURE write-to-log :
       18     define input parameter p-msg-str   as character no-undo .
       19     define input parameter p-call-back as handle    no-undo .
       20     do
       21     on error undo, return error
       22     :
       23       output stream LogStream to "clean_db.log" page-size 0 append.
       24       put stream LogStream unformatted p-msg-str .
       25       output stream LogStream close.
       26       if  valid-handle(p-call-back)
       27       and lookup('callback-write-to-log', p-call-back :internal-entries) > 0
       28       then do:
       29         run callback-write-to-log in p-call-back
       30           (input p-msg-str
       31           ) no-error .
       32       end.
       33     end.
       34   END PROCEDURE.
       35   FUNCTION format-etime RETURNS CHARACTER
       36   (INPUT p-etime AS INT64  )
       37   :
       38     if p-etime = ?
       39     then do:
       40       return "?????????????" .
       41     end.
       42     assign
       43       p-etime = p-etime / 1000
       44     .
       45     return
       46       string( p-etime, '->>>>>>>9')
       47       + ' '
       48       + string( p-etime, 'HH:MM:SS')
       49     .
       50   END FUNCTION.
       51   define temp-table list-action no-undo
       52     field action         as character format "x(15)" label "Процедура"
       53     field file-name      as character
       54     index pi is unique primary
       55       file-name ascending
       56     .
       57   define stream UpgStream .
       58   do
       59   on error undo, return error return-value
       60   :
       61     define buffer buf_sys-ctrl for ub.sys-ctrl .
       62     define buffer buf_connect      for ub._connect .
       63     define buffer buf_myconnection for ub._myconnection .
       64     define variable v-log       as logical   no-undo .
       65     define variable v-gen-file  as character no-undo .
       66     define variable v-choice    as integer   no-undo .
       67     define variable v-login-usr as logical   no-undo .
       68     find first buf_sys-ctrl no-lock .
       69     if p-date-actual-docs < buf_sys-ctrl.sys-date then
       70     do:
       71       return error
       72         substitute("БД уже очищена на &1.~nВы можете ввести дату большую или равную текущей.",buf_sys-ctrl.sys-date).
       73     end.
       74     if transaction then do:
       75       message
       76         vss-workfile vss-revision vss-description skip
       77         substitute( "Вызов данной процедуры невозможен при наличии транзакции" )
       78         view-as alert-box error
       79       .
       80       return error .
       81     end.
       82     assign
       83       v-choice    = 0
       84       v-login-usr = false
       85       v-gen-file  = "clean_db.log"
       86     .
       87     run run-load in this-procedure
       88       no-error .
       89     if error-status :error then do:
       90       return error return-value.
       91     end.
       92   END.
       93   PROCEDURE cre-list-action :
       94     do
       95     on error  undo, return error substitute( "&1 (cre-list-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       96     on stop   undo, return error substitute( "&1 (cre-list-action). stop", vss-workfile )
       97     on endkey undo, return error substitute( "&1 (cre-list-action). endkey", vss-workfile )
       98     :
       99   create list-action .
      100   assign
      101     list-action.action    = 'p'
      102     list-action.file-name = 'cleandb/00037000.p'
      103     .
      104   create list-action .
      105   assign
      106     list-action.action    = 'p'
      107     list-action.file-name = 'cleandb/00037001.p'
      108     .
      109   create list-action .
      110   assign
      111     list-action.action    = 'p'
      112     list-action.file-name = 'cleandb/00043000.p'
      113     .
      114   create list-action .
      115   assign
      116     list-action.action    = 'p'
      117     list-action.file-name = 'cleandb/00043001.p'
      118     .
      119   create list-action .
      120   assign
      121     list-action.action    = 'p'
      122     list-action.file-name = 'cleandb/00045000.p'
      123     .
      124   create list-action .
      125   assign
      126     list-action.action    = 'p'
      127     list-action.file-name = 'cleandb/00055000.p'
      128     .
      129   create list-action .
      130   assign
      131     list-action.action    = 'p'
      132     list-action.file-name = 'cleandb/00061000.p'
      133     .
      134   create list-action .
      135   assign
      136     list-action.action    = 'p'
      137     list-action.file-name = 'cleandb/00090000.p'
      138     .
      139   create list-action .
      140   assign
      141     list-action.action    = 'p'
      142     list-action.file-name = 'cleandb/00091000.p'
      143     .
      144   if can-find(first _File where _file._file-name = "order-doc") then
      145   do:
      146   create list-action .
      147   assign
      148     list-action.action    = 'p'
      149     list-action.file-name = 'cleandb/00127000.p'
      150     .
      151   end.
      152   create list-action .
      153   assign
      154     list-action.action    = 'p'
      155     list-action.file-name = 'cleandb/00169000.p'
      156     .
      157   create list-action .
      158   assign
      159     list-action.action    = 'p'
      160     list-action.file-name = 'cleandb/00193000.p'
      161     .
      162   create list-action .
      163   assign
      164     list-action.action    = 'p'
      165     list-action.file-name = 'cleandb/00199000.p'
      166     .
      167   create list-action .
      168   assign
      169     list-action.action    = 'p'
      170     list-action.file-name = 'cleandb/00217000.p'
      171     .
      172   create list-action .
      173   assign
      174     list-action.action    = 'p'
      175     list-action.file-name = 'cleandb/00221000.p'
      176     .
      177   create list-action .
      178   assign
      179     list-action.action    = 'p'
      180     list-action.file-name = 'cleandb/00230000.p'
      181     .
      182   create list-action .
      183   assign
      184     list-action.action    = 'p'
      185     list-action.file-name = 'cleandb/00240000.p'
      186     .
      187   create list-action .
      188   assign
      189     list-action.action    = 'p'
      190     list-action.file-name = 'cleandb/00994000.p'
      191     .
      192   create list-action .
      193   assign
      194     list-action.action    = 'p'
      195     list-action.file-name = 'cleandb/01000000.p'
      196     .
      197   create list-action .
      198   assign
      199     list-action.action    = 'p'
      200     list-action.file-name = 'cleandb/01010000.p'
      201     .
      202   create list-action .
