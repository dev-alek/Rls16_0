        1   block-level on error undo, throw.
        2   define temp-table temp_fbr-recipe no-undo
        3       field recipe-code   as character
        4       field recipe-type   as character
        5       field recipe-name   as character
        6       index pi is primary unique
        7           recipe-code
        8   .
        9   define variable v-fbrtest-frc-key    as integer      no-undo.
       10   define input parameter p-fbr-doc-code   as character        no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: fbrout.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: utl/fbrout.p $":U .
       16   define variable vss-description as character no-undo init "Выгрузка данных по документу производства".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define stream out-stream.
       78       define buffer buf_fbr-doc           for fbr-doc.
       79       define buffer buf_fbr-line          for fbr-line.
       80       define buffer buf_recipe            for recipe.
       81       define buffer buf_recipe-gds        for recipe-gds.
       82       define buffer buf_fbr-recipe        for fbr-recipe.
       83       define buffer buf_fbr-recipe-gds    for fbr-recipe-gds.
       84       define buffer buf_temp_fbr-recipe   for temp_fbr-recipe.
       85   do
       86   for buf_fbr-doc
       87     , buf_fbr-line
       88     , buf_recipe
       89     , buf_recipe-gds
       90     , buf_fbr-recipe
       91     , buf_fbr-recipe-gds
       92     , buf_temp_fbr-recipe
       93   on error undo, return error
       94   :
       95       output stream out-stream to "fbrout.txt".
       96       find first buf_fbr-doc no-lock
       97            where buf_fbr-doc.doc-code = p-fbr-doc-code
       98       no-error.
       99       if not available buf_fbr-doc
      100       then do:
      101           run write-log in this-procedure ( "Неверно задан номер документа производства", p-fbr-doc-code ).
      102           message
      103               substitute( "Неверно задан номер документа производства: &1", p-fbr-doc-code )
      104               skip
      105           view-as alert-box error.
      106           undo, return error .
      107       end.
      108       run write-log in this-procedure ( "Документ производства", buf_fbr-doc.doc-code ).
      109       run write-log in this-procedure ( "Тип объекта          ", buf_fbr-doc.obj-type ).
      110       run write-log in this-procedure ( "Код объекта          ", buf_fbr-doc.obj-code ).
      111       run write-log in this-procedure ( "Свободный            ", buf_fbr-doc.is-free ).
      112       run write-log in this-procedure ( "Удалён               ", buf_fbr-doc.is-del ).
      113       run write-log in this-procedure ( "Статус               ", buf_fbr-doc.status_ ).
      114       run write-log in this-procedure ( "Дата                 ", buf_fbr-doc.doc-date ).
      115       run write-log in this-procedure ( "Факт-дата            ", buf_fbr-doc.fact-date ).
      116       run write-log in this-procedure ( "Тип                  ", buf_fbr-doc.doc-type ).
      117       run write-log in this-procedure ( "Пользователь         ", buf_fbr-doc.user-name ).
      118       run write-log in this-procedure ( "Дата смены           ", buf_fbr-doc.shift-date ).
      119       run write-log in this-procedure ( "Номер смены          ", buf_fbr-doc.shift-num ).
      120       run write-log in this-procedure ( "Приход количество    ", buf_fbr-doc.in-qnty ).
      121       run write-log in this-procedure ( "Приход Уч.цены б.в.  ", buf_fbr-doc.in-base ).
      122       run write-log in this-procedure ( "Приход Уч.цены руб.  ", buf_fbr-doc.in-rubl ).
      123       run write-log in this-procedure ( "Приход Пр.цены       ", buf_fbr-doc.in-sale ).
      124       run write-log in this-procedure ( "Приход Пр.ц.НДС б.в. ", buf_fbr-doc.in-vat-base ).
      125       run write-log in this-procedure ( "Приход Пр.ц.НДС руб. ", buf_fbr-doc.in-vat-rubl ).
      126       run write-log in this-procedure ( "Расход количество    ", buf_fbr-doc.out-qnty ).
      127       run write-log in this-procedure ( "Расход Уч.цены б.в.  ", buf_fbr-doc.out-base ).
      128       run write-log in this-procedure ( "Расход Уч.цены руб.  ", buf_fbr-doc.out-rubl ).
      129       run write-log in this-procedure ( "Расход Пр.цены       ", buf_fbr-doc.out-sale ).
      130       run write-log in this-procedure ( "Расход Пр.ц.НДС б.в. ", buf_fbr-doc.out-vat-base ).
      131       run write-log in this-procedure ( "Расход Пр.ц.НДС руб. ", buf_fbr-doc.out-vat-rubl ).
      132       run write-log in this-procedure ( "Примечание           ", buf_fbr-doc.PS ).
      133       run write-log in this-procedure ( "CR"                   , "":U ).
      134       run write-log in this-procedure ( "line"                 , "":U ).
      135       for each buf_fbr-recipe no-lock
      136          where buf_fbr-recipe.doc-code    = buf_fbr-doc.doc-code
      137       on error undo, return error
      138       :
      139           find first buf_temp_fbr-recipe
      140                where buf_temp_fbr-recipe.recipe-code = buf_fbr-recipe.recipe-code
      141           no-error.
      142           if not available buf_temp_fbr-recipe
      143           then do:
      144               create buf_temp_fbr-recipe.
      145               assign
      146                   buf_temp_fbr-recipe.recipe-code = buf_fbr-recipe.recipe-code
      147                   buf_temp_fbr-recipe.recipe-type = buf_fbr-recipe.recipe-type
      148                   buf_temp_fbr-recipe.recipe-name = buf_fbr-recipe.recipe-name
      149               .
      150           end.
      151       end.
      152       for each buf_temp_fbr-recipe no-lock
      153       on error undo, return error
      154       :
      155           run write-log in this-procedure ( "line"                 , "":U ).
      156           run write-log in this-procedure ( "line"                 , "":U ).
      157           run write-log in this-procedure ( "Рецепт документа производства", buf_temp_fbr-recipe.recipe-code ).
      158           run write-log in this-procedure ( "Тип рецепта                  ", buf_temp_fbr-recipe.recipe-type ).
      159           run write-log in this-procedure ( "Имя рецепта                  ", buf_temp_fbr-recipe.recipe-name ).
      160           for each buf_fbr-recipe no-lock
      161              where buf_fbr-recipe.doc-code    = buf_fbr-doc.doc-code
      162                and buf_fbr-recipe.recipe-code = buf_temp_fbr-recipe.recipe-code
      163           :
      164               run write-log in this-procedure ( "line", "":U ).
      165               run write-log in this-procedure ( "Код товара        ", buf_fbr-recipe.gds-code ).
      166               run write-log in this-procedure ( "Артикул           ", buf_fbr-recipe.artic ).
      167               run write-log in this-procedure ( "Производитель тип ", buf_fbr-recipe.prod-type ).
      168               run write-log in this-procedure ( "Производитель код ", buf_fbr-recipe.prod-code ).
      169               run write-log in this-procedure ( "Порция количество ", buf_fbr-recipe.portion-qnty ).
      170               run write-log in this-procedure ( "Порция вес        ", buf_fbr-recipe.portion-weight ).
      171               run write-log in this-procedure ( "Количество нетто  ", buf_fbr-recipe.qnty ).
      172               run write-log in this-procedure ( "Количество брутто ", buf_fbr-recipe.brutto-qnty ).
      173               run write-log in this-procedure ( "Цена продажи      ", buf_fbr-recipe.price-sale ).
      174               run write-log in this-procedure ( "Цена продажи НДС  ", buf_fbr-recipe.price-vat-sale ).
      175               find first buf_recipe no-lock
      176                    where buf_recipe.recipe-code = buf_fbr-recipe.recipe-code
      177               no-error.
      178               if available buf_recipe
      179               then do:
      180                   run write-log in this-procedure ( "line", "":U ).
      181                   run write-log in this-procedure ( "Рецепт системы, номер", buf_recipe.recipe-code ).
      182                   run write-log in this-procedure ( "Рецепт системы, тип  ", buf_recipe.recipe-type ).
      183                   run write-log in this-procedure ( "Рецепт системы, имя  ", buf_recipe.recipe-name ).
      184                   run write-log in this-procedure ( "Код товара           ", buf_recipe.gds-code ).
      185                   run write-log in this-procedure ( "Артикул              ", buf_recipe.artic ).
      186                   run write-log in this-procedure ( "Производитель тип    ", buf_recipe.prod-type ).
      187                   run write-log in this-procedure ( "Производитель код    ", buf_recipe.prod-code ).
      188                   run write-log in this-procedure ( "Порция количество    ", buf_recipe.portion-qnty ).
      189                   run write-log in this-procedure ( "Порция вес           ", buf_recipe.portion-weight ).
      190                   run write-log in this-procedure ( "Количество нетто     ", buf_recipe.qnty ).
      191                   run write-log in this-procedure ( "Количество брутто    ", buf_recipe.brutto-qnty ).
      192               end.
      193               run write-log in this-procedure ( "line", "":U ).
      194               run write-log in this-procedure ( "Строка документа     ", buf_recipe.recipe-code ).
      195               find first buf_fbr-line no-lock
      196                    where buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
      197                      and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
      198                      and buf_fbr-line.artic       = buf_fbr-recipe.artic
      199                      and buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
      200               no-error.
      201               if available buf_fbr-line
      202               then do:
      203                   run write-log in this-procedure ( "Тип (приход/списание)", buf_fbr-line.trn-type ).
      204                   run write-log in this-procedure ( "Артикул              ", buf_fbr-line.artic ).
      205                   run write-log in this-procedure ( "Производитель тип    ", buf_fbr-line.prod-type ).
      206                   run write-log in this-procedure ( "Производитель код    ", buf_fbr-line.prod-code ).
      207                   run write-log in this-procedure ( "Составной            ", buf_fbr-line.is-comp ).
      208                   run write-log in this-procedure ( "Рассчитаны уч.цены   ", buf_fbr-line.is-calc ).
      209                   run write-log in this-procedure ( "Метод расчёта        ", buf_fbr-line.calc-method ).
      210                   run write-log in this-procedure ( "Сезонный коэффициент ", buf_fbr-line.coeff-value ).
      211                   run write-log in this-procedure ( "Коэффициент отходов  ", buf_fbr-line.coeff-waste ).
      212                   run write-log in this-procedure ( "Количество факт      ", buf_fbr-line.fact-qnty ).
      213                   run write-log in this-procedure ( "Количество зарезерв. ", buf_fbr-line.rsrv-qnty ).
      214                   run write-log in this-procedure ( "Уч.цена фиксирована  ", buf_fbr-line.fix-cost ).
      215                   run write-log in this-procedure ( "Уч.цена б.в.         ", buf_fbr-line.price-base ).
      216                   run write-log in this-procedure ( "Уч.цена руб.         ", buf_fbr-line.price-rubl ).
      217                   run write-log in this-procedure ( "Пр.цена              ", buf_fbr-line.price-sale ).
      218                   run write-log in this-procedure ( "Сумма уч.ц. б.в.     ", buf_fbr-line.price-sum-base ).
      219                   run write-log in this-procedure ( "Сумма уч.ц. руб.     ", buf_fbr-line.price-sum-rubl ).
      220                   run write-log in this-procedure ( "Сумма НДС уч.ц. б.в. ", buf_fbr-line.price-sum-vat-base ).
      221                   run write-log in this-procedure ( "Сумма НДС уч.ц. руб. ", buf_fbr-line.price-sum-vat-rubl ).
      222               end.
      223               else do:
      224                   run write-log in this-procedure ( "*** Ошибка: нет строки документа производства.", buf_recipe.recipe-code ).
      225               end.
      226               for each buf_fbr-recipe-gds no-lock
      227                  where buf_fbr-recipe-gds.doc-code    = buf_fbr-doc.doc-code
      228                    and buf_fbr-recipe-gds.recipe-code = buf_fbr-recipe.recipe-code
      229               on error undo, return error
      230               :
      231                   run write-log in this-procedure ( "line", "":U ).
      232                   run write-log in this-procedure ( "Ингредиент рецепта документа, артикул", buf_fbr-recipe-gds.artic ).
      233                   run write-log in this-procedure ( "Производитель тип    ", buf_fbr-recipe-gds.prod-type ).
      234                   run write-log in this-procedure ( "Производитель код    ", buf_fbr-recipe-gds.prod-code ).
      235                   run write-log in this-procedure ( "Код товара           ", buf_fbr-recipe-gds.gds-code ).
      236                   run write-log in this-procedure ( "Отходы               ", buf_fbr-recipe-gds.is-waste ).
      237                   run write-log in this-procedure ( "Количество нетто     ", buf_fbr-recipe-gds.qnty ).
      238                   run write-log in this-procedure ( "Количество брутто    ", buf_fbr-recipe-gds.brutto-qnty ).
      239                   run write-log in this-procedure ( "Метод расчёта        ", buf_fbr-recipe-gds.calc-method ).
      240                   run write-log in this-procedure ( "Сезонный коэффициент ", buf_fbr-recipe-gds.coeff-value ).
      241                   run write-log in this-procedure ( "Коэффициент отходов  ", buf_fbr-recipe-gds.coeff-waste ).
      242                   run write-log in this-procedure ( "Порядковый номер     ", buf_fbr-recipe-gds.proc-number ).
      243                   find first buf_recipe-gds no-lock
      244                        where buf_recipe-gds.recipe-code = buf_fbr-recipe.recipe-code
      245                          and buf_recipe-gds.prod-type   = buf_fbr-recipe-gds.prod-type
      246                          and buf_recipe-gds.prod-code   = buf_fbr-recipe-gds.prod-code
      247                          and buf_recipe-gds.artic       = buf_fbr-recipe-gds.artic
      248                   no-error.
      249                   if available buf_recipe-gds
      250                   then do:
      251                       run write-log in this-procedure ( "line", "":U ).
      252                       run write-log in this-procedure ( "Ингредиент рецепта системы, артикул", buf_recipe-gds.artic ).
      253                       run write-log in this-procedure ( "Производитель тип    ", buf_recipe-gds.prod-type ).
      254                       run write-log in this-procedure ( "Производитель код    ", buf_recipe-gds.prod-code ).
      255                       run write-log in this-procedure ( "Код товара           ", buf_recipe-gds.gds-code ).
      256                       run write-log in this-procedure ( "Количество нетто     ", buf_recipe-gds.qnty ).
      257                       run write-log in this-procedure ( "Количество брутто    ", buf_recipe-gds.brutto-qnty ).
      258                       run write-log in this-procedure ( "Метод расчёта        ", buf_recipe-gds.calc-method ).
      259                       run write-log in this-procedure ( "Коэффициент отходов  ", buf_recipe-gds.coeff-waste ).
      260                       run write-log in this-procedure ( "Порядковый номер     ", buf_recipe-gds.proc-number ).
      261                   end.
      262                   run write-log in this-procedure ( "line", "":U ).
      263                   run write-log in this-procedure ( "Строка документа для ингредиента", buf_fbr-recipe-gds.artic ).
      264                   find first buf_fbr-line no-lock
      265                        where buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
      266                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
      267                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
      268                          and buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
      269                   no-error.
      270                   if available buf_fbr-line
      271                   then do:
      272                       run write-log in this-procedure ( "Тип (приход/списание)", buf_fbr-line.trn-type ).
      273                       run write-log in this-procedure ( "Артикул              ", buf_fbr-line.artic ).
      274                       run write-log in this-procedure ( "Производитель тип    ", buf_fbr-line.prod-type ).
      275                       run write-log in this-procedure ( "Производитель код    ", buf_fbr-line.prod-code ).
      276                       run write-log in this-procedure ( "Составной            ", buf_fbr-line.is-comp ).
      277                       run write-log in this-procedure ( "Рассчитаны уч.цены   ", buf_fbr-line.is-calc ).
      278                       run write-log in this-procedure ( "Метод расчёта        ", buf_fbr-line.calc-method ).
      279                       run write-log in this-procedure ( "Сезонный коэффициент ", buf_fbr-line.coeff-value ).
      280                       run write-log in this-procedure ( "Коэффициент отходов  ", buf_fbr-line.coeff-waste ).
      281                       run write-log in this-procedure ( "Количество факт      ", buf_fbr-line.fact-qnty ).
      282                       run write-log in this-procedure ( "Количество зарезерв. ", buf_fbr-line.rsrv-qnty ).
      283                       run write-log in this-procedure ( "Уч.цена фиксирована  ", buf_fbr-line.fix-cost ).
      284                       run write-log in this-procedure ( "Уч.цена б.в.         ", buf_fbr-line.price-base ).
      285                       run write-log in this-procedure ( "Уч.цена руб.         ", buf_fbr-line.price-rubl ).
      286                       run write-log in this-procedure ( "Пр.цена              ", buf_fbr-line.price-sale ).
      287                       run write-log in this-procedure ( "Сумма уч.ц. б.в.     ", buf_fbr-line.price-sum-base ).
      288                       run write-log in this-procedure ( "Сумма уч.ц. руб.     ", buf_fbr-line.price-sum-rubl ).
      289                       run write-log in this-procedure ( "Сумма НДС уч.ц. б.в. ", buf_fbr-line.price-sum-vat-base ).
      290                       run write-log in this-procedure ( "Сумма НДС уч.ц. руб. ", buf_fbr-line.price-sum-vat-rubl ).
      291                   end.
      292                   else do:
      293                       run write-log in this-procedure ( "*** Ошибка: нет строки документа производства.", buf_recipe.recipe-code ).
      294                   end.
      295               end.
      296           end.
      297       end.
      298       output stream out-stream close.
      299   end.
      300   procedure write-log :
      301   define input parameter p-name-string    as character        no-undo.
      302   define input parameter p-value-string   as character        no-undo.
      303   do
      304   on error undo, return error
      305   :
      306       case p-name-string
      307       :
      308           when "line":U
      309           then do:
      310               put stream out-stream unformatted
      311                   fill( "=", 80 ) + chr(10)
      312               .
      313           end.
      314           when "CR":U
      315           then do:
      316               put stream out-stream unformatted
      317                   chr(10)
      318               .
      319           end.
      320           otherwise do:
      321               put stream out-stream unformatted
      322                   substitute( "&2: &3&1", chr(10), p-name-string, p-value-string )
      323               .
      324           end.
      325       end case.
      326   end.
      327   end procedure.
