      679   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      680   define variable v-waitfram-action01         as character   no-undo .
      681   define variable v-waitfram-action02         as character   no-undo .
      682   define variable v-waitfram-action03         as character   no-undo .
      683   define variable mWaitFramTextBeg            as character   no-undo.
      684   define variable mWaitFramTextEnd            as character   no-undo.
      685   define variable mWaitFramView               as logical     no-undo.
      686   define variable mWaitProcEvent              as logical     no-undo init yes.
      687   define variable mWaitFramInterval           as integer     no-undo init 1 .
      688   define variable mWaitFramStop               as logical     no-undo.
      689   define variable mWaitFramStopUser           as logical     no-undo.
      690   define variable mWaitFramStopTimeOut        as logical     no-undo.
      691   define variable mWaitFramStartProc          as datetime-tz no-undo.
      692   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      693   define button B-WaitFramStop auto-end-key
      694        label "Стоп"
      695        size 10 by 1 tooltip "Остоновить процесс".
      696   define button B-viewProcInfo
      697        label "Информация"
      698        size 15 by 1 tooltip "Информация о процесс".
      699   define frame waitfram
      700     v-waitfram-action01 format "x(72)" no-label skip
      701     v-waitfram-action02 format "x(72)" no-label skip
      702     v-waitfram-action03 format "x(72)" no-label skip
      703     B-viewProcInfo
      704     B-WaitFramStop at row 4 col 30
      705     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      706     .
      707   define new global shared variable mBatchMode as logical no-undo init ?.
      708   define variable mFramBachModHandle as handle no-undo.
      709   mFramBachModHandle = frame waitfram:handle.
      710   define variable mFameOldVis as logical no-undo.
      711   define variable mVisCUrentVin as logical no-undo.
      712   if session:batch-mode
      713   then
      714      mBatchMode = yes.
      715   if mBatchMode = ? then do:
      716     mVisCUrentVin = current-window:visible.
      717     mFameOldVis = mFramBachModHandle:visible.
      718     mFramBachModHandle:visible  = yes.
      719     mBatchMode = mFramBachModHandle:visible ne yes.
      720     mFramBachModHandle:visible = mFameOldVis.
      721     current-window:visible = mVisCUrentVin.
      722   end.
      723    if  log-manager:logfile-name ne ?
      724     then DO:
      725         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      726         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      727         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      728     end.
      729   on choose of B-WaitFramStop in frame waitfram
      730   do:
      731     mWaitFramStop = yes.
      732     mWaitFramStopUser = yes.
      733   end.
      734   function waitfram-check-timeout returns logical():
      735      define variable vtime as int64 no-undo.
      736      if mWaitFramStopTimeOut
      737      then
      738         return yes.
      739      vtime = ( now - mWaitFramStartProc ) / 1000 .
      740      if     mWaitFramTimeOut ne ?
      741         and mWaitFramTimeOut ne 0
      742         and mWaitFramTimeOut lt vtime
      743      then do:
      744         mWaitFramStopTimeOut = yes.
      745      end.
      746      return mWaitFramStopTimeOut.
      747   end.
      748   procedure waitfram-hide :
      749     if not session:batch-mode
      750     then do
      751     on error undo, return error return-value
      752     :
      753       pause 0 before-hide .
      754       if not mBatchMode then
      755         hide frame waitfram .
      756     if     not mWaitFramView
      757        and mWaitProcEvent
      758     then
      759       process events .
      760     end.
      761   end procedure.
      762   procedure waitfram-show :
      763     define input  parameter p-message as character no-undo .
      764     define variable v-left-margin as integer   no-undo .
      765     if not session:batch-mode
      766     then do
      767     on error undo, return error return-value
      768     :
      769       if length(p-message) <= 70 then do:
      770         assign
      771           v-left-margin = integer((70 - length(p-message)) / 2)
      772         .
      773         assign
      774           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      775         .
      776         assign
      777           v-waitfram-action01 = " "
      778           v-waitfram-action02 = " "
      779                                    + fill(" ", v-left-margin)
      780                                    + p-message
      781           v-waitfram-action03 = " "
      782         .
      783       end.
      784       else do:
      785         define variable vRindex1 as integer no-undo.
      786         define variable vRindex2 as integer no-undo.
      787         vRindex1 = r-index(p-message," ",70).
      788         if vRindex1 = 0
      789         then
      790            vRindex1 = 70.
      791         if length(p-message)  <= vRindex1 + 70 then do:
      792           assign
      793             v-waitfram-action01 = " "
      794             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      795             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      796           .
      797         end.
      798         else do:
      799           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      800           if vRindex2 <= vRindex1
      801           then
      802              vRindex2 = vRindex1 + 70.
      803           assign
      804             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      805             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      806             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      807           .
      808         end.
      809       end.
      810       B-viewProcInfo:visible   in frame waitfram = no.
      811       B-viewProcInfo:sensitive in frame waitfram = no.
      812       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      813       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      814       if  (   mWaitFramView
      815          or  mWaitProcEvent)
      816          and not mBatchMode
      817       then
      818          display
      819             v-waitfram-action01 skip
      820             v-waitfram-action02 skip
      821             v-waitfram-action03 skip
      822          with frame waitfram .
      823       if     mWaitFramView
      824          then do:
      825             if     mWaitFramInterval ne ?
      826                and not mBatchMode
      827             then
      828                wait-for go of frame waitfram pause mWaitFramInterval.
      829          end.
      830          else
      831             if     mWaitProcEvent
      832                and not mBatchMode
      833             then
      834                process events .
      835     end.
      836   end procedure.
      837      procedure waitfram-show-this:
      838         define input  parameter iInterval as int64 no-undo.
      839         define variable vtime as int64 no-undo.
      840         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      841         mWaitFramInterval = iInterval.
      842         run waitfram-show (substitute("&1&2 &3&4" ,
      843                                       mWaitFramTextBeg ,
      844                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      845                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      846                                       mWaitFramTextEnd
      847                                      )
      848                           ).
      849      end.
      850      procedure WaitFramRunPause:
      851         define input  parameter iInterval as dec no-undo.
      852         define variable vStart  as datetime-tz no-undo.
      853         define variable vend    as datetime-tz no-undo.
      854         define variable vint as int64 no-undo.
      855         define variable vOk as logical no-undo.
      856         vStart = now.
      857         vend   = vStart.
      858         publish "WaitFramPause" (iInterval,output vOk).
      859         vend   =  now.
      860         vint = vend - vStart.
      861         vint = iInterval - vint / 1000.
      862         if     not mWaitFramStop
      863            and (   vint > 0
      864                 or (    not vOk
      865                     and iInterval eq ?
      866                     )
      867                 )
      868         then
      869            run waitfram-show-this (iInterval).
      870         vend   =  now.
      871         vint = vend - vStart.
      872         vint = iInterval - vint / 1000.
      873         if     not mWaitFramStop
      874            and vint > 0
      875         then do:
      876            run gbl/pause.p (vint * 1000).
      877         end.
      878         if iInterval ne ?
      879         then
      880            publish "WaitFramStop".
      881         waitfram-check-timeout().
      882      end.
      883      procedure WaitFramWaitFor:
      884         define input  parameter iInterval as dec no-undo.
      885         assign
      886            mWaitFramStartProc   = now
      887            mWaitFramStopUser    = no
      888            mWaitFramStopTimeOut = no
      889         .
      890         block-wait:
      891         do while not mWaitFramStop:
      892            run WaitFramRunPause (iInterval).
      893            if  waitfram-check-timeout()
      894            then do:
      895               leave block-wait.
      896            end.
      897         end.
      898         run waitfram-hide.
      899      end.
      900   procedure waitfram-join :
      901     define input  parameter p-line-1  as character no-undo .
      902     define input  parameter p-line-2  as character no-undo .
      903     define input  parameter p-line-3  as character no-undo .
      904     define output parameter p-message as character no-undo .
      905     do
      906     on error undo, return error return-value
      907     :
      908       assign
      909         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      910                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      911                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      912       .
      913     end.
      914   end procedure.
      915   function waitfram-join-function returns character
      916     (input p-line-1 as character
      917     ,input p-line-2 as character
      918     ,input p-line-3 as character
      919     ).
      920     define variable v-message as character no-undo .
      921     run waitfram-join in this-procedure
      922       (input  p-line-1
      923       ,input  p-line-2
      924       ,input  p-line-3
      925       ,output v-message
      926       ) .
      927     return v-message .
      928   end function .
      929   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
