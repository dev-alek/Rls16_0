     1007   procedure userobjs_transfer :
     1008     define input  parameter p-callback-handle as handle no-undo .
     1009     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1010     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
