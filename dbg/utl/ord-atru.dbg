      507   procedure gds-ind1 :
      508   main-block:
      509     do
      510   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      511   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      512   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      513     :
      514   define input-output parameter p-doc-rec  as recid no-undo.
