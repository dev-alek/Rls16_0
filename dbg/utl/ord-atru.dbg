      627   procedure create_obj-list :
      628      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      629      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      630      do
      631      on error undo, return error return-value
      632      :
      633         define buffer cli-obj for ub.clients .
      634         define variable p-var as integer no-undo .
      635         define buffer buf_obj-list for obj-list .
      636         find last buf_obj-list  use-index pi no-error .
      637         if available buf_obj-list
      638         then
      639            p-var = buf_obj-list.obj-id + 1.
      640         else
      641            p-var = 1.
      642         find first cli-obj where
      643                   cli-obj.obj-type = p-obj-type
      644               and cli-obj.obj-code = p-obj-code
      645         no-lock no-error.
      646         if available cli-obj
      647         then do:
      648            create buf_obj-list.
      649            assign
      650               buf_obj-list.obj-id   = p-var
      651               buf_obj-list.obj-code = cli-obj.obj-code
      652               buf_obj-list.obj-type = cli-obj.obj-type
      653               buf_obj-list.obj-name = cli-obj.obj-name
      654               buf_obj-list.db-num   = cli-obj.db-num
      655            .
      656         end.
      657      end.
      658   end.
