        1   block-level on error undo, throw.
        2   using Ibs.Th.Gbl.ProgressBar.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: mig_0040.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/mig_0040.p $":U .
        8   define variable vss-description as character no-undo init "Модификация таблиц раздела Клиенты".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define input parameter parparentproc    as widget-handle no-undo .
       64   define input parameter p-parent-handle  as widget-handle no-undo .
       65   define input parameter p-log-handle     as handle no-undo .
       66   define input parameter p-parameter      as character no-undo .
       67   define input parameter p-db-num         as integer   no-undo .
       68   define input parameter p-cli-code       as integer   no-undo .
       69   define input parameter log-file-name   as character  no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define new global shared variable g#library  as handle no-undo .
      301   define new global shared variable g#library2 as handle no-undo .
      302   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303     define variable v-prg-bar_progress-bar  as class ProgressBar  no-undo .
      304     procedure prg-bar_new-progress-bar :
      305       define input  parameter p-min as int64   no-undo .
      306       define input  parameter p-max as int64   no-undo .
      307     do
      308     on error undo, return error return-value
      309     :
      310       if v-prg-bar_progress-bar <> ?
      311       then do:
      312         run prg-bar_delete-progress-bar in this-procedure .
      313       end.
      314       v-prg-bar_progress-bar = new progressbar( p-min , p-max ).
      315     end.
      316     end procedure.
      317     procedure prg-bar_delete-progress-bar :
      318     do
      319     on error undo, return error return-value
      320     :
      321       if v-prg-bar_progress-bar <> ?
      322       then do:
      323         delete object v-prg-bar_progress-bar.
      324         assign
      325           v-prg-bar_progress-bar = ?
      326         .
      327       end.
      328     end.
      329     end procedure.
      330     procedure prg-bar_show-progress-bar :
      331     do
      332     on error undo, return error return-value
      333     :
      334       if v-prg-bar_progress-bar <> ?
      335       then do:
      336         v-prg-bar_progress-bar :show-bar() .
      337       end.
      338     end.
      339     end procedure.
      340     procedure prg-bar_increment-progress-bar :
      341     do
      342     on error undo, return error return-value
      343     :
      344       if v-prg-bar_progress-bar <> ?
      345       then do:
      346         v-prg-bar_progress-bar :increment() .
      347       end.
      348     end.
      349     end procedure.
      350     procedure prg-bar_title-progress-bar :
      351       define input  parameter p-str as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       if v-prg-bar_progress-bar <> ?
      356       then do:
      357         assign
      358           v-prg-bar_progress-bar :frame-title = p-str
      359         .
      360       end.
      361     end.
      362     end procedure.
      363     procedure prg-bar_stepto-progress-bar :
      364       define input  parameter p-val as integer   no-undo .
      365     do
      366     on error undo, return error return-value
      367     :
      368       if v-prg-bar_progress-bar <> ?
      369       then do:
      370           v-prg-bar_progress-bar :stepto( p-val ) .
      371       end.
      372     end.
      373     end procedure.
      374   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375     define variable v-prg-bar_cb-handle     as handle             no-undo .
      376     procedure prg-bar_init-cb-handle :
      377       define input  parameter p-cb-handle as handle    no-undo .
      378     do
      379     on error undo, return error return-value
      380     :
      381       if valid-handle( p-cb-handle )
      382       then do:
      383         assign
      384           v-prg-bar_cb-handle = p-cb-handle
      385         .
      386       end.
      387       else do:
      388         assign
      389           v-prg-bar_cb-handle = ?
      390         .
      391       end.
      392     end.
      393     end procedure.
      394     procedure prg-bar_new :
      395       define input  parameter p-min as int64   no-undo .
      396       define input  parameter p-max as int64   no-undo .
      397     do
      398     on error undo, return error return-value
      399     :
      400       if valid-handle(v-prg-bar_cb-handle)
      401       then do:
      402         run prg-bar_new-progress-bar in v-prg-bar_cb-handle ( input p-min , input p-max ).
      403       end.
      404     end.
      405     end procedure.
      406     procedure prg-bar_delete :
      407     do
      408     on error undo, return error return-value
      409     :
      410       if valid-handle(v-prg-bar_cb-handle)
      411       then do:
      412         run prg-bar_delete-progress-bar in v-prg-bar_cb-handle .
      413       end.
      414     end.
      415     end procedure.
      416     procedure prg-bar_show :
      417     do
      418     on error undo, return error return-value
      419     :
      420       if valid-handle(v-prg-bar_cb-handle)
      421       then do:
      422         run prg-bar_show-progress-bar in v-prg-bar_cb-handle .
      423       end.
      424     end.
      425     end procedure.
      426     procedure prg-bar_increment :
      427     do
      428     on error undo, return error return-value
      429     :
      430       if valid-handle(v-prg-bar_cb-handle)
      431       then do:
      432         run prg-bar_increment-progress-bar in v-prg-bar_cb-handle.
      433       end.
      434     end.
      435     end procedure.
      436     procedure prg-bar_title :
      437       define input  parameter p-str as character no-undo .
      438     do
      439     on error undo, return error return-value
      440     :
      441       if valid-handle(v-prg-bar_cb-handle)
      442       then do:
      443         run prg-bar_title-progress-bar in v-prg-bar_cb-handle ( input p-str ) .
      444       end.
      445     end.
      446     end procedure.
      447     procedure prg-bar_stepto :
      448       define input  parameter p-val as integer   no-undo .
      449     do
      450     on error undo, return error return-value
      451     :
      452       if valid-handle(v-prg-bar_cb-handle)
      453       then do:
      454         run prg-bar_stepto-progress-bar in v-prg-bar_cb-handle ( input p-val ) .
      455       end.
      456     end.
      457     end procedure.
      458   define variable v-progress-bar as class ProgressBar no-undo .
      459   run prg-bar_init-cb-handle in this-procedure ( this-procedure ) .
      460   define variable v-tot-rec as int64 no-undo .
      461   run write-log-and-file in p-log-handle (
      462       input 1
      463     , input log-file-name
      464     , input 1
      465     , input substitute("Клиенты")
      466     ).
      467   define shared temp-table temp-clients no-undo like ub.clients
      468   field base-code as integer
      469   field new-issue-code as integer
      470   field deleted-sysconf as logical
      471   .
      472   define shared temp-table temp-sysconf no-undo like ub.sysconf.
      473   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   on write  of ub.clients   override do: end .
      475   on delete of ub.clients   override do: end .
      476   on write  of ub.store     override do: end .
      477   on delete of ub.store     override do: end .
      478   on delete of ub.c-store   override do: end .
      479   on write  of ub.shop      override do: end .
      480   on delete of ub.shop      override do: end .
      481   on delete of ub.sysconf   override do: end .
      482   on write  of ub.sysconf   override do: end .
      483   on write  of ub.payment   override do: end .
      484   on write  of ub.prt-obj   override do: end .
      485   on delete of ub.prt-obj   override do: end .
      486   on delete of ub.staff     override do: end .
      487   on write  of ub.staff     override do: end .
      488     do
      489     on error undo, return error return-value
      490     :
      491     v-tot-rec = 0 .
      492     for each ub.clients no-lock where
      493       v-tot-rec = v-tot-rec + 1.
      494     end.
      495     run prg-bar_new in this-procedure ( 1, v-tot-rec ).
      496     run prg-bar_title in this-procedure ( input "Обработка таблиц Клиентов, складов и магазинов...":U).
      497     run prg-bar_show in this-procedure .
      498     for each ub.clients  exclusive-lock :
      499        run prg-bar_increment in this-procedure .
      500        if ub.clients.db-num <> p-db-num then do:
      501         case ub.clients.obj-type :
      502           when 'маг':U then do:
      503                 for each ub.shop exclusive-lock where
      504                         ub.shop.obj-code = ub.clients.obj-code :
      505                         run del-obj-other (ub.clients.obj-type , ub.clients.obj-code) no-error .
      506                         if error-status :error then do:
      507                             run write-log-and-file in p-log-handle (
      508                                   input 1
      509                                 , input log-file-name
      510                                 , input 1
      511                                 , input substitute("err маг&2 - &1 &3", error-status :get-message(1) ,ub.clients.obj-code, return-value  )).
      512                                 run prg-bar_delete-progress-bar in this-procedure .
      513                             return .
      514                         end.
      515                         delete ub.shop.
      516                         run del-cl-attr in this-procedure (ub.clients.obj-type,ub.clients.obj-code).
      517                 end.
      518                 create temp-clients.
      519                 buffer-copy ub.clients to temp-clients.
      520                 release temp-clients.
      521                 delete ub.clients.
      522           end.
      523           when 'скл':U then do:
      524                 for each ub.store exclusive-lock where
      525                         ub.store.obj-code = ub.clients.obj-code :
      526                         run del-obj-other (ub.clients.obj-type , ub.clients.obj-code) no-error .
      527                         if error-status :error then do:
      528                             run write-log-and-file in p-log-handle (
      529                                   input 1
      530                                 , input log-file-name
      531                                 , input 1
      532                                 , input substitute("err скл&2 - &1 &3", error-status :get-message(1) ,ub.clients.obj-code, return-value  )).
      533                             run prg-bar_delete-progress-bar in this-procedure .
      534                             return .
      535                         end.
      536                         delete ub.store.
      537                         run del-cl-attr in this-procedure (ub.clients.obj-type,ub.clients.obj-code).
      538                 end.
      539                 create temp-clients.
      540                 buffer-copy ub.clients to temp-clients.
      541                 release temp-clients.
      542                 delete ub.clients.
      543           end.
      544           when 'орг':U then do:
      545               ub.clients.db-num = ?.
      546           end.
      547           otherwise do:
      548               ub.clients.db-num = ?.
      549           end.
      550         end case.
      551        end.
      552        else do:
      553          if ub.clients.db-num <> ? then  ub.clients.db-num = 0.
      554        end.
      555     end.
      556     run prg-bar_delete-progress-bar in this-procedure .
      557     v-tot-rec = 0 .
      558     for each ub.sysconf no-lock :
      559       v-tot-rec = v-tot-rec + 1.
      560     end.
      561     run prg-bar_new in this-procedure ( 1, v-tot-rec).
      562     run prg-bar_title in this-procedure ( input "Обработка таблицы фирм...":U).
      563     run prg-bar_show in this-procedure .
      564   for each ub.sysconf exclusive-lock :
      565       run prg-bar_increment in this-procedure .
      566       if can-find ( first ub.shop  no-lock where ub.shop.host-code = ub.sysconf.host-code  ) or
      567          can-find ( first ub.store no-lock where ub.store.host-code = ub.sysconf.host-code ) then do:
      568       end.
      569       else do:
      570          find first ub.clients exclusive-lock where
      571                     ub.clients.obj-type = 'орг':U and
      572                     ub.clients.obj-code = ub.sysconf.host-code no-error .
      573          if available ub.clients  then  ub.clients.db-num = ? .
      574           run del-host-other in this-procedure  ( ub.clients.obj-code ) no-error .
      575           if error-status :error then do:
      576               run write-log-and-file in p-log-handle (
      577                     input 1
      578                   , input log-file-name
      579                   , input 1
      580                   , input substitute("err фирма&2 - &1 &3", error-status :get-message(1) ,ub.clients.obj-code, return-value  )).
      581               run prg-bar_delete-progress-bar in this-procedure .
      582               return .
      583           end.
      584           run del-cl-attr in this-procedure (ub.clients.obj-type,ub.clients.obj-code) no-error.
      585           if error-status :error then do:
      586               run write-log-and-file in p-log-handle (
      587                     input 1
      588                   , input log-file-name
      589                   , input 1
      590                   , input substitute("err фирма&2 - &1 &3", error-status :get-message(1) ,ub.clients.obj-code, return-value  )).
      591               run prg-bar_delete-progress-bar in this-procedure .
      592               return .
      593           end.
      594           create temp-sysconf.
      595           buffer-copy ub.sysconf to temp-sysconf.
      596           release temp-sysconf.
      597           delete ub.sysconf .
      598       end.
      599   end.
      600   run prg-bar_delete-progress-bar in this-procedure .
      601     v-tot-rec = 0 .
      602     for each ub.staff no-lock :
      603       v-tot-rec = v-tot-rec + 1.
      604     end.
      605     run prg-bar_new in this-procedure ( 1, v-tot-rec).
      606     run prg-bar_title in this-procedure ( input "Обработка таблицы ПЕРСОНАЛ...":U).
      607     run prg-bar_show in this-procedure .
      608     for each ub.staff exclusive-lock  where
      609            ub.staff.role-level = 'db':U
      610        and (ub.staff.db-num < p-db-num
      611             or
      612             ub.staff.db-num > p-db-num)
      613     by db-num
      614     :
      615         run prg-bar_increment in this-procedure .
      616         delete ub.staff.
      617     end.
      618     for each ub.staff exclusive-lock:
      619        ub.staff.db-num = 0.
      620     end.
      621     run prg-bar_delete-progress-bar in this-procedure .
      622   end.
      623   procedure del-cl-attr :
      624   define input  parameter p-obj-type as character no-undo .
      625   define input  parameter p-obj-code as integer   no-undo .
      626   on delete  of ub.c-clients         override do: end .
      627   on delete  of ub.clients-attr      override do: end .
      628   on delete  of ub.c-clients-attr      override do: end .
      629   on delete  of ub.c-shop      override do: end .
      630   on delete  of ub.c-clients   override do: end .
      631   on delete  of ub.dis-thbj-rule override do: end.
      632   on delete  of ub.c-dis-thbj-rule override do: end.
      633   on delete  of ub.thbj-attr override do: end.
      634   on delete  of ub.c-thbj-attr override do: end.
      635     do
      636     on error undo, return error return-value
      637     :
      638     if p-obj-type ='маг':U
      639     or p-obj-type = 'скл':U then do:
      640       for each ub.c-clients exclusive-lock where
      641               ub.c-clients.obj-type = p-obj-type and
      642               ub.c-clients.obj-code = p-obj-code :
      643               delete ub.c-clients.
      644       end.
      645       for each ub.c-clients-attr exclusive-lock where
      646               ub.c-clients-attr.obj-type = p-obj-type and
      647               ub.c-clients-attr.obj-code = p-obj-code :
      648               delete ub.c-clients-attr.
      649       end.
      650       for each ub.clients-attr exclusive-lock where
      651               ub.clients-attr.obj-type = p-obj-type and
      652               ub.clients-attr.obj-code = p-obj-code :
      653               delete ub.clients-attr.
      654       end.
      655       for each ub.dis-thbj-rule exclusive-lock where
      656               ub.dis-thbj-rule.obj-type = p-obj-type and
      657               ub.dis-thbj-rule.obj-code = p-obj-code :
      658               delete ub.dis-thbj-rule.
      659       end.
      660       for each ub.c-dis-thbj-rule exclusive-lock where
      661               ub.c-dis-thbj-rule.obj-type = p-obj-type and
      662               ub.c-dis-thbj-rule.obj-code = p-obj-code :
      663               delete ub.c-dis-thbj-rule.
      664       end.
      665     end.
      666     for each ub.thbj-attr exclusive-lock where
      667              ub.thbj-attr.obj-type = p-obj-type and
      668              ub.thbj-attr.obj-code = p-obj-code :
      669              delete ub.thbj-attr.
      670     end.
      671     for each ub.c-thbj-attr exclusive-lock where
      672              ub.c-thbj-attr.obj-type = p-obj-type and
      673              ub.c-thbj-attr.obj-code = p-obj-code :
      674              delete ub.c-thbj-attr.
      675     end.
      676     if p-obj-type = 'орг':U then do:
      677       for each ub.dis-thbj-rule exclusive-lock where
      678               ub.dis-thbj-rule.host-code = p-obj-code :
      679               delete ub.dis-thbj-rule.
      680       end.
      681       for each ub.c-dis-thbj-rule exclusive-lock where
      682               ub.c-dis-thbj-rule.host-code = p-obj-code :
      683               delete ub.c-dis-thbj-rule.
      684       end.
      685     end.
      686     if p-obj-type = 'маг':U then do:
      687         for each ub.c-shop exclusive-lock where
      688                 ub.c-shop.obj-code = p-obj-code :
      689                 delete ub.c-shop.
      690         end.
      691     end.
      692     if p-obj-type = 'скл':U then do:
      693         for each ub.c-store exclusive-lock where
      694                 ub.c-store.obj-code = p-obj-code :
      695                 delete ub.c-store.
      696         end.
      697     end.
      698     end.
      699   end procedure.
      700   procedure del-obj-other :
      701   define input  parameter p-obj-type as character no-undo .
      702   define input  parameter p-obj-code as integer   no-undo .
      703   on delete of ub.cash-pay-attr override do: end .
      704   on delete of ub.c-cash-pay-attr override do: end .
      705   on delete of ub.c-cash-pay override do: end .
      706   on delete of ub.c-cash-pay override do: end .
      707   on delete of ub.dis-cp-rule override do: end .
      708   on delete of ub.c-dis-cp-rule override do: end .
      709   on delete of ub.gds-grp-attr  override do: end .
      710   on delete of ub.gds-grp-obj   override do: end .
      711   on delete of ub.prt-obj       override do: end .
      712   on delete of ub.s-coeff       override do: end .
      713   on delete of ub.tax-rate-gds     override do: end .
      714   on delete of ub.tax-rate-gds-grp override do: end .
      715   on delete of ub.tax-rate-value   override do: end .
      716   on delete of ub.recipe           override do: end .
      717   on delete of ub.turnover-buyer             override do: end .
      718   on delete of ub.turnover-buyer-attr        override do: end .
      719   on delete of ub.turnover-buyer-gds         override do: end .
      720   on delete of ub.turnover-buyer-gds-attr    override do: end .
      721   on delete of ub.turnover-buyer-main        override do: end .
      722   on delete of ub.turnover-buyer-main-attr   override do: end .
      723   on delete of ub.user-obj                   override do: end .
      724   on delete of ub.user-obj-attr              override do: end .
      725   on delete of ub.trn-reason-obj             override do: end .
      726     do
      727     on error undo, return error return-value
      728     :
      729       for each ub.trn-reason-obj  exclusive-lock where
      730                 ub.trn-reason-obj.obj-type = p-obj-type and
      731                 ub.trn-reason-obj.obj-code = p-obj-code :
      732                 delete ub.trn-reason-obj.
      733       end.
      734       for each ub.prt-obj exclusive-lock where
      735                 ub.prt-obj.obj-type = p-obj-type and
      736                 ub.prt-obj.obj-code = p-obj-code :
      737                 delete ub.prt-obj.
      738       end.
      739       for each ub.cash-pay-attr exclusive-lock where
      740                 ub.cash-pay-attr.obj-type = p-obj-type and
      741                 ub.cash-pay-attr.obj-code = p-obj-code :
      742                 delete ub.cash-pay-attr.
      743       end.
      744       for each ub.c-cash-pay-attr exclusive-lock where
      745                 ub.c-cash-pay-attr.obj-type = p-obj-type and
      746                 ub.c-cash-pay-attr.obj-code = p-obj-code,
      747          each ub.c-cash-pay exclusive-lock where
      748                 ub.c-cash-pay.cdpay-code = ub.c-cash-pay-attr.cdpay-code and
      749                 ub.c-cash-pay.curr-code = ub.c-cash-pay-attr.curr-code and
      750                 ub.c-cash-pay.corr-user-db-num = ub.c-cash-pay-attr.corr-user-db-num and
      751                 ub.c-cash-pay.chip-num = ub.c-cash-pay-attr.chip-num:
      752         delete ub.c-cash-pay-attr.
      753         delete ub.c-cash-pay.
      754       end.
      755       for each ub.dis-cp-rule exclusive-lock where
      756                 ub.dis-cp-rule.obj-type = p-obj-type and
      757                 ub.dis-cp-rule.obj-code = p-obj-code :
      758                 delete ub.dis-cp-rule.
      759       end.
      760       for each ub.c-dis-cp-rule exclusive-lock where
      761                 ub.c-dis-cp-rule.obj-type = p-obj-type and
      762                 ub.c-dis-cp-rule.obj-code = p-obj-code :
      763                 delete ub.c-dis-cp-rule.
      764       end.
      765       for each ub.gds-grp-attr exclusive-lock where
      766                 ub.gds-grp-attr.obj-type = p-obj-type and
      767                 ub.gds-grp-attr.obj-code = p-obj-code :
      768                 delete ub.gds-grp-attr.
      769       end.
      770       for each ub.gds-grp-obj exclusive-lock where
      771                ub.gds-grp-obj.obj-type = p-obj-type and
      772                ub.gds-grp-obj.obj-code = p-obj-code :
      773                delete ub.gds-grp-obj.
      774       end.
      775       for each ub.s-coeff exclusive-lock where
      776                 ub.s-coeff.obj-type = p-obj-type and
      777                 ub.s-coeff.obj-code = p-obj-code :
      778                 delete ub.s-coeff.
      779       end.
      780       for each ub.tax-rate-gds exclusive-lock where
      781                 ub.tax-rate-gds.obj-type = p-obj-type and
      782                 ub.tax-rate-gds.obj-code = p-obj-code :
      783                 delete ub.tax-rate-gds.
      784       end.
      785       for each ub.tax-rate-gds-grp exclusive-lock where
      786                 ub.tax-rate-gds-grp.obj-type = p-obj-type and
      787                 ub.tax-rate-gds-grp.obj-code = p-obj-code :
      788                 delete ub.tax-rate-gds-grp.
      789       end.
      790       for each ub.tax-rate-value exclusive-lock where
      791                 ub.tax-rate-value.obj-type = p-obj-type and
      792                 ub.tax-rate-value.obj-code = p-obj-code :
      793                 delete ub.tax-rate-value.
      794       end.
      795       for each ub.recipe exclusive-lock where
      796                 ub.recipe.obj-type = p-obj-type and
      797                 ub.recipe.obj-code = p-obj-code :
      798                 delete ub.recipe.
      799       end.
      800   for each ub.turnover-buyer                  exclusive-lock where
      801             ub.turnover-buyer.obj-type = p-obj-type and
      802             ub.turnover-buyer.obj-code = p-obj-code :
      803             delete ub.turnover-buyer.
      804   end.
      805   for each ub.turnover-buyer-attr             exclusive-lock where
      806             ub.turnover-buyer-attr.obj-type = p-obj-type and
      807             ub.turnover-buyer-attr.obj-code = p-obj-code :
      808             delete ub.turnover-buyer-attr.
      809   end.
      810   for each ub.turnover-buyer-gds              exclusive-lock where
      811             ub.turnover-buyer-gds.obj-type = p-obj-type and
      812             ub.turnover-buyer-gds.obj-code = p-obj-code :
      813             delete ub.turnover-buyer-gds.
      814   end.
      815   for each ub.turnover-buyer-gds-attr         exclusive-lock where
      816             ub.turnover-buyer-gds-attr.obj-type = p-obj-type and
      817             ub.turnover-buyer-gds-attr.obj-code = p-obj-code :
      818             delete ub.turnover-buyer-gds-attr.
      819   end.
      820   for each ub.turnover-buyer-main             exclusive-lock where
      821             ub.turnover-buyer-main.obj-type = p-obj-type and
      822             ub.turnover-buyer-main.obj-code = p-obj-code :
      823             delete ub.turnover-buyer-main.
      824   end.
      825   for each ub.turnover-buyer-main-attr        exclusive-lock where
      826             ub.turnover-buyer-main-attr.obj-type = p-obj-type and
      827             ub.turnover-buyer-main-attr.obj-code = p-obj-code :
      828             delete ub.turnover-buyer-main-attr.
      829   end.
      830   for each ub.user-obj        exclusive-lock where
      831             ub.user-obj.obj-type = p-obj-type and
      832             ub.user-obj.obj-code = p-obj-code :
      833             delete ub.user-obj.
      834   end.
      835   for each ub.user-obj-attr        exclusive-lock where
      836             ub.user-obj-attr.obj-type = p-obj-type and
      837             ub.user-obj-attr.obj-code = p-obj-code :
      838             delete ub.user-obj-attr.
      839   end.
      840     end.
      841   end procedure.
      842   procedure del-host-other :
      843   define input  parameter p-host-code as integer   no-undo .
      844   on delete of ub.fin-bank       override do: end .
      845   on delete of ub.c-fin-bank       override do: end .
      846   on delete of ub.fin-schet       override do: end .
      847   on delete of ub.c-fin-schet       override do: end .
      848   on delete of ub.fin-code-an-uchet       override do: end .
      849   on delete of ub.c-fin-code-an-uchet     override do: end .
      850   on delete of ub.fin-code-cel-nazn       override do: end .
      851   on delete of ub.c-fin-code-cel-nazn     override do: end .
      852   on delete of ub.fin-code-cor-acc       override do: end .
      853   on delete of ub.c-fin-code-cor-acc     override do: end .
      854   on delete of ub.dis-rule         override do: end .
      855   on delete of ub.c-dis-rule       override do: end .
      856   on delete of ub.dis-gds-rule     override do: end .
      857   on delete of ub.c-dis-gds-rule   override do: end .
      858   on delete of ub.gds-host-attr    override do: end .
      859   on delete of ub.c-gds-host-attr  override do: end .
      860   on delete of ub.user-host        override do: end .
      861   on delete of ub.user-host-attr   override do: end .
      862   on delete of ub.trn-reason-host  override do: end .
      863     do
      864     on error undo, return error return-value
      865     :
      866       for each ub.trn-reason-host exclusive-lock where
      867                ub.trn-reason-host.host-code = p-host-code
      868                 :
      869         delete ub.trn-reason-host.
      870       end.
      871       for each ub.user-host exclusive-lock where
      872                ub.user-host.host-code = p-host-code
      873                 :
      874         delete ub.user-host.
      875       end.
      876       for each ub.user-host-attr exclusive-lock where
      877                ub.user-host-attr.host-code = p-host-code
      878                 :
      879         delete ub.user-host-attr.
      880       end.
      881       for each ub.fin-bank exclusive-lock where
      882                ub.fin-bank.host-code = p-host-code
      883                 :
      884         delete ub.fin-bank.
      885       end.
      886       for each ub.c-fin-bank exclusive-lock where
      887                ub.c-fin-bank.host-code = p-host-code
      888                 :
      889         delete ub.c-fin-bank.
      890       end.
      891       for each ub.fin-schet exclusive-lock where
      892                ub.fin-schet.host-code = p-host-code
      893                 :
      894         delete ub.fin-schet.
      895       end.
      896       for each ub.c-fin-schet exclusive-lock where
      897                ub.c-fin-schet.host-code = p-host-code
      898                 :
      899         delete ub.c-fin-schet.
      900       end.
      901       for each ub.fin-code-an-uchet exclusive-lock where
      902                ub.fin-code-an-uchet.host-code = p-host-code
      903                 :
      904         delete ub.fin-code-an-uchet.
      905       end.
      906       for each ub.c-fin-code-an-uchet exclusive-lock where
      907                ub.c-fin-code-an-uchet.host-code = p-host-code
      908                 :
      909         delete ub.c-fin-code-an-uchet.
      910       end.
      911       for each ub.fin-code-cel-nazn exclusive-lock where
      912                ub.fin-code-cel-nazn.host-code = p-host-code
      913                 :
      914         delete ub.fin-code-cel-nazn.
      915       end.
      916       for each ub.c-fin-code-cel-nazn exclusive-lock where
      917                ub.c-fin-code-cel-nazn.host-code = p-host-code
      918                 :
      919         delete ub.c-fin-code-cel-nazn.
      920       end.
      921       for each ub.fin-code-cor-acc exclusive-lock where
      922                ub.fin-code-cor-acc.host-code = p-host-code
      923                 :
      924         delete ub.fin-code-cor-acc.
      925       end.
      926       for each ub.c-fin-code-cor-acc exclusive-lock where
      927                ub.c-fin-code-cor-acc.host-code = p-host-code
      928                 :
      929         delete ub.c-fin-code-cor-acc.
      930       end.
      931       for each ub.dis-rule exclusive-lock where
      932                 ub.dis-rule.host-code = p-host-code :
      933                 delete ub.dis-rule.
      934       end.
      935       for each ub.c-dis-rule exclusive-lock where
      936                 ub.c-dis-rule.host-code = p-host-code :
      937                 delete ub.c-dis-rule.
      938       end.
      939       for each ub.dis-gds-rule exclusive-lock where
      940                 ub.dis-gds-rule.obj-type = 'орг':U
      941              and ub.dis-gds-rule.obj-code =  p-host-code :
      942         delete ub.dis-gds-rule.
      943       end.
      944       for each ub.c-dis-gds-rule exclusive-lock where
      945                 ub.c-dis-gds-rule.obj-type = 'орг':U
      946              and ub.c-dis-gds-rule.obj-code =  p-host-code :
      947         delete ub.dis-gds-rule.
      948       end.
      949       for each ub.gds-host-attr exclusive-lock where
      950                 ub.gds-host-attr.host-code = p-host-code :
      951         delete ub.gds-host-attr.
      952       end.
      953       for each ub.c-gds-host-attr exclusive-lock where
      954                 ub.c-gds-host-attr.host-code = p-host-code :
      955         delete ub.c-gds-host-attr.
      956       end.
      957     end.
      958   end procedure.
