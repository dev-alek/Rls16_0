        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: ef-serv.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/ef-serv.p $":U .
        8   define variable vss-description as character no-undo init "Обслуживание мобильного блока EasyFuel".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     run mainmenu_getcntxt in parparentproc
       80       (output v-cntxt-db-num
       81       ,output v-cntxt-userid
       82       ,output v-cntxt-level
       83       ,output v-cntxt-host-code-obj
       84       ,output v-cntxt-obj-type
       85       ,output v-cntxt-obj-code
       86       ,output v-cntxt-db-num-obj
       87       ,output v-cntxt-is-admin
       88       ) .
       89   define variable v-operations as character no-undo .
       90   define variable v-operation-codes as character no-undo .
       91   define variable v-selected-operation as character no-undo .
       92   define variable v-operation-name as character no-undo .
       93   define variable v-run-file-name as character no-undo .
       94   define variable v-can-init as logical no-undo .
       95   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   do:
       97     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
       98       (input  v-cntxt-db-num
       99       ,input  v-cntxt-userid
      100       ,input  0
      101       ,input  'actn_easyfuel_initialization':U
      102       ,input  'object':U
      103       ,input  v-cntxt-host-code-obj
      104       ,input  v-cntxt-obj-type
      105       ,input  v-cntxt-obj-code
      106       ,input  0
      107       ,input  0
      108       ,input  0
      109       ,input  false
      110       ,output v-can-init
      111       )  .
      112   end.
      113   assign
      114   v-operations = "":U
      115   v-operation-codes = "":U
      116   v-selected-operation = "start"
      117   .
      118   if v-can-init then do:
      119     assign
      120     v-operations = "Первоначальная прошивка в МБ данных транспортного средства и лимитов" + chr(4) +
      121                   "Изменение номера и марки трансп. средства" + chr(4) +
      122                   "Изменение топлив, привязанных к МБ и их лимитов" + chr(4) +
      123                   "Восстановление данных на МБ согласно данным, хранящимся в системе"  + chr(4) +
      124                   "Считывание данных с МБ и сравнение их с хранящимися в системе"
      125     v-operation-codes  = "initialize" + chr(4) +
      126                          "reg-num" + chr(4) +
      127                          "petrol" + chr(4) +
      128                          "restore" + chr(4) +
      129                          "read"
      130     .
      131   end.
      132   else do:
      133     assign
      134     v-operations = "Считывание данных с МБ и сравнение их с хранящимися в системе"
      135     v-operation-codes  = "read"
      136     .
      137   end.
      138   do while v-selected-operation <> "":
      139     run gbl/d-list.w (
      140                   INPUT "b-sel":U
      141                   ,INPUT "Выберите операцию с МБ EasyFuel"
      142                   ,INPUT v-operation-codes
      143                   ,INPUT v-operations
      144                   ,INPUT chr(4)
      145                   ,INPUT "":U
      146                   ,output v-selected-operation).
      147     IF v-selected-operation = "":u THEN do:
      148       RETURN "".
      149     end.
      150     assign
      151     v-operation-name = entry(lookup(v-selected-operation, v-operation-codes, chr(4)) , v-operations, chr(4))
      152     .
      153     case v-selected-operation:
      154       when "" then do:
      155         return ''.
      156       end.
      157       when "initialize" then do:
      158         v-run-file-name = "utl/ef-init.p".
      159       end.
      160       when "reg-num" then do:
      161         v-run-file-name = "utl/efregnum.p".
      162       end.
      163       when "petrol" then do:
      164         v-run-file-name = "utl/eflimits.p".
      165       end.
      166       when "restore" then do:
      167       end.
      168       when "read" then do:
      169         v-run-file-name = "utl/ef-read.p".
      170       end.
      171     end case.
      172     if v-run-file-name = "" then do:
      173       message
      174       "under construction"
      175       view-as alert-box .
      176     end.
      177     else do:
      178       run str/diallog.w ( input parparentproc
      179                   , input this-procedure
      180                   , input v-run-file-name
      181                   , input ""
      182                   , input yes
      183                   , input ''
      184                   , input v-operation-name) no-error .
      185       if error-status:error
      186       or return-value = "error"
      187       then do:
      188         message
      189         substitute("Ошибки при выполнение операции &1:&2" +
      190                     "&3&2&4"
      191                     , v-operation-name
      192                     , chr(10)
      193                     , error-status:get-message(1)
      194                     , return-value )
      195         view-as alert-box error .
      196       end.
      197     end.
      198   end.
