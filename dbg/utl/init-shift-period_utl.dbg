        1   define input        parameter parparentproc as handle    no-undo .
        2   define variable place-list as character no-undo .
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        8     define variable v-cntxt-db-num        as integer   no-undo .
        9     define variable v-cntxt-userid        as character no-undo .
       10     define variable v-cntxt-level         as character no-undo .
       11     define variable v-cntxt-host-code-obj as integer   no-undo .
       12     define variable v-cntxt-obj-type      as character no-undo .
       13     define variable v-cntxt-obj-code      as integer   no-undo .
       14     define variable v-cntxt-db-num-obj    as integer   no-undo .
       15     define variable v-cntxt-is-admin      as logical   no-undo .
       16   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       17     run mainmenu_getcntxt in parparentproc
       18       (output v-cntxt-db-num
       19       ,output v-cntxt-userid
       20       ,output v-cntxt-level
       21       ,output v-cntxt-host-code-obj
       22       ,output v-cntxt-obj-type
       23       ,output v-cntxt-obj-code
       24       ,output v-cntxt-db-num-obj
       25       ,output v-cntxt-is-admin
       26       ) .
       27   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
       28        LABEL "Отмена"
       29        SIZE 15 BY 1.14
       30        BGCOLOR 8 .
       31   DEFINE BUTTON Btn_OK AUTO-GO
       32        LABEL "Ввод"
       33        SIZE 15 BY 1.14
       34        BGCOLOR 8 .
       35   DEFINE VARIABLE rs-place AS INTEGER INITIAL 1
       36        VIEW-AS RADIO-SET VERTICAL
       37        RADIO-BUTTONS
       38             "Все", 1,
       39   "Выборочно", 2
       40        SIZE 23 BY 2.14 NO-UNDO.
       41   DEFINE FRAME Dialog-Frame
       42        Btn_OK AT ROW 1.24 COL 2
       43        Btn_Cancel AT ROW 1.24 COL 17
       44        rs-place AT ROW 4.33 COL 5 NO-LABEL WIDGET-ID 2
       45        "Резервуары:" VIEW-AS TEXT
       46             SIZE 17 BY 1.19 AT ROW 2.71 COL 4 WIDGET-ID 6
       47        SPACE(18.99) SKIP(3.76)
       48       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       49            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       50            TITLE "Повторная инициализация"
       51            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
       52   ASSIGN
       53          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       54          FRAME Dialog-Frame:HIDDEN           = TRUE.
       55   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       56   DO:
       57     APPLY "END-ERROR":U TO SELF.
       58   END.
       59   ON choose OF Btn_Ok in frame Dialog-Frame
       60   DO:
       61     case rs-place :
       62       when 1
       63       then do :
       64         run utl/init-shift-period.p (input "all") .
       65       end .
       66       when 2
       67       then do :
       68         if place-list = ""
       69         then do :
       70           message "Не выбрано ни одного резервуара!" view-as alert-box .
       71           return no-apply .
       72         end .
       73         run utl/init-shift-period.p (input place-list) .
       74       end .
       75     end case .
       76   END.
       77   ON VALUE-CHANGED OF rs-place IN FRAME Dialog-Frame
       78   DO:
       79     assign rs-place .
       80     if rs-place = 2
       81     then do :
       82       run ref/pl-list.w (
       83        input parparentproc
       84       ,input "b-sel,b-mark"
       85       ,input v-cntxt-obj-type
       86       ,input v-cntxt-obj-code
       87       ,input 'объект':U + chr(4) + "only-np"
       88       ,input-output place-list).
       89       if place-list = "cancel"
       90       then do :
       91         place-list = "" .
       92         return no-apply .
       93       end .
       94     end .
       95   END.
       96   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       97   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       98   MAIN-BLOCK:
       99   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      100      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      101     RUN enable_UI.
      102     WAIT-FOR GO OF FRAME Dialog-Frame.
      103   END.
      104   RUN disable_UI.
      105   PROCEDURE disable_UI :
      106     HIDE FRAME Dialog-Frame.
      107   END PROCEDURE.
      108   PROCEDURE enable_UI :
      109     DISPLAY rs-place
      110         WITH FRAME Dialog-Frame.
      111     ENABLE Btn_OK Btn_Cancel rs-place
      112         WITH FRAME Dialog-Frame.
      113     VIEW FRAME Dialog-Frame.
      114   END PROCEDURE.
