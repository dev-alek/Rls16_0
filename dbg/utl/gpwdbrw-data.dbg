        1   class utl.gpwdbrw-data:
        2      define stream sHtml.
        3      define temp-table ttTechProlBrw no-undo
        4         field id        as int64 column-label "Идентификатор"
        5         field fDate     as date  column-label "Дата"
        6         field fTime     as char  column-label "Время"
        7         field fHostName as char  column-label "Имя хоста"
        8         field fUser     as char  column-label "Пользователь"
        9         field fDetails  as char  column-label "Детали"
       10         index fdate fDate ftime
       11         .
       12      define public property hQuery as handle no-undo
       13      get.
       14      set.
       15      method public char GetQueryString(iFilter as class utl.gpwdbrw-filter):
       16         def var vQueryString as char no-undo init "for each b-tech-prol-pwd no-lock ".
       17         def var vWhere    as char   no-undo.
       18         vWhere = iFilter:GetWhere().
       19         if vWhere <> "" then
       20         do:
       21            vQueryString = substitute("&1 where &2", vQueryString, vWhere).
       22         end.
       23         return vQueryString.
       24      end method.
       25      method public void RefreshTT(iFilter as class utl.gpwdbrw-filter):
       26         def buffer b-tech-prol-pwd for tech-prol-pwd.
       27         def buffer b-clients   for clients.
       28         def buffer b-cash-desk for cash-desk.
       29         def var vShop        as char   no-undo.
       30         def var vCashDesk    as char   no-undo.
       31         def var vWhere       as char   no-undo.
       32         def var hQuery-tt    as handle no-undo.
       33         def var vQueryString as char   no-undo.
       34         empty temp-table ttTechProlBrw.
       35         create query hQuery-tt.
       36         hQuery-tt:set-buffers(buffer b-tech-prol-pwd:handle).
       37         vQueryString = GetQueryString(iFilter).
       38         hQuery-tt:query-prepare(vQueryString).
       39         hQuery-tt:query-open.
       40         hQuery-tt:get-first().
       41         do while not hQuery-tt:query-off-end:
       42            find first b-clients where
       43                       b-clients.obj-type = entry(1,b-tech-prol-pwd.shop-surr)
       44                   and b-clients.obj-code = int(entry(2,b-tech-prol-pwd.shop-surr))
       45            no-lock no-error.
       46            if avail b-clients then
       47               vShop = string(b-clients.obj-code).
       48            else
       49               vShop = "".
       50            find first b-cash-desk where
       51                       b-cash-desk.db-num   = int64(entry(1,b-tech-prol-pwd.cash-desk-surr))
       52                   and b-cash-desk.obj-code = int64(entry(2,b-tech-prol-pwd.cash-desk-surr))
       53                   and b-cash-desk.pos-type = entry(3,b-tech-prol-pwd.cash-desk-surr)
       54                   and b-cash-desk.cash-num = int64(entry(4,b-tech-prol-pwd.cash-desk-surr))
       55            no-lock no-error.
       56            if avail b-cash-desk then
       57               vCashDesk = string(b-cash-desk.cash-num).
       58            else
       59               vCashDesk = "".
       60            create ttTechProlBrw.
       61            assign
       62               ttTechProlBrw.id = b-tech-prol-pwd.id
       63               ttTechProlBrw.fDate = date(b-tech-prol-pwd.f-time)
       64               ttTechProlBrw.fTime = string(b-tech-prol-pwd.f-time,"99/99/99 HH:MM:SS")
       65               ttTechProlBrw.fTime = substring(ttTechProlBrw.fTime,10)
       66               ttTechProlBrw.fHostName = b-tech-prol-pwd.f-hostname
       67               ttTechProlBrw.fDetails = substitute(
       68                  "маг &1, касса &2, &3, &4 - &5, &6",
       69                  vShop,
       70                  vCashDesk,
       71                  b-tech-prol-pwd.f-date,
       72                  b-tech-prol-pwd.f-beg-time,
       73                  b-tech-prol-pwd.f-end-time,
       74                  b-tech-prol-pwd.f-fio)
       75            .
       76            if b-tech-prol-pwd.f-user <> "" then
       77            do:
       78               ttTechProlBrw.fUser = substitute("&1: &2",
       79                                                b-tech-prol-pwd.f-user,
       80                                                this-object:GetUserLogin(b-tech-prol-pwd.f-user)).
       81            end.
       82            hQuery-tt:get-next().
       83         end.
       84         hQuery-tt:query-close().
       85         finally:
       86            delete object hQuery-tt.
       87         end finally.
       88      end method.
       89      method public char GetUserLogin(iUser as char):
       90         def var vUserLogin as char no-undo.
       91         def buffer buf_user-account for ub.user-account.
       92         for first buf_user-account where
       93                   buf_user-account.user-id = iUser
       94         no-lock:
       95            assign
       96               vUserLogin = substitute('&1 &2 &3':U
       97                                       ,buf_user-account.last-name
       98                                       ,buf_user-account.first-name
       99                                       ,buf_user-account.second-name
      100                                       )
      101            .
      102         end.
      103         return vUserLogin.
      104      end method.
      105      method public handle GetQuery():
      106         create query hQuery.
      107         hQuery:set-buffers(buffer ttTechProlBrw:handle).
      108         hQuery:query-prepare("FOR EACH ttTechProlBrw").
      109         hQuery:query-open.
      110         return hQuery.
      111      end method.
      112      method public void RefreshQuery(iFilter as class utl.gpwdbrw-filter):
      113         RefreshTT(iFilter).
      114         hQuery:query-close().
      115         hQuery:set-buffers(buffer ttTechProlBrw:handle).
      116         hQuery:query-prepare("FOR EACH ttTechProlBrw").
      117         hQuery:query-open.
      118      end method.
      119      method public void Dispose():
      120         empty temp-table ttTechProlBrw.
      121         if valid-handle(hQuery) then delete object hQuery.
      122      end method.
      123      method public void Report(iFilter as class utl.gpwdbrw-filter):
      124         def var vFullFileName as char  no-undo.
      125         def buffer ttTechProlBrw for ttTechProlBrw.
      126         main:
      127         do on error undo, throw:
      128            vFullFileName = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name() + ".html".
      129            output stream sHtml to value(vFullFileName) convert target 'UTF-8'.
      130            put stream sHtml unformatted
      131               "<!DOCTYPE HTML>" skip
      132               ' <html>' skip
      133               '  <head>' skip
      134               '   <meta charset="utf-8">' skip
      135               '    <style type="text/css">' skip
      136               '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      137               '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      138               '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      139               '   </style>' skip
      140               '  </head>' skip
      141               .
      142            put stream sHtml unformatted
      143               '<body>' skip
      144               '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
      145               '<thead>' skip
      146               .
      147            put stream sHtml unformatted
      148               '<tr>' skip
      149               '<td style="width: 70px;"></td>' skip
      150               '<td style="width: 70px;"></td>' skip
      151               '<td style="width: 250px;"></td>' skip
      152               '<td style="width: 250px;"></td>' skip
      153               '<td style="width: 600px;"></td>' skip
      154               '</tr>' skip
      155               .
      156            put stream sHtml unformatted
      157               '<tr>' skip
      158               '<td colspan="5" style="text-align: center; font-weight: bold; font: 25px arial;">Журнал генерации паролей для проведения технологических проливов </td>' skip
      159               '</tr>' skip
      160               '</thead>' skip .
      161            put stream sHtml unformatted
      162               '<tr>' skip
      163               '<td colspan="5" style="text-align: left; font-weight: bold;">Фильтры: </td>' skip
      164               '</tr>' skip
      165               '</thead>' skip .
      166            if iFilter:AllFiltersDisabled() then
      167            do:
      168               put stream sHtml unformatted
      169                  '<tr>' skip
      170                  '<td colspan="5" style="text-align: left; font-weight: bold;">    все </td>' skip
      171                  '</tr>' skip
      172                  '</thead>' skip .
      173            end.
      174            else
      175            do:
      176               put stream sHtml unformatted
      177                  '<tr>' skip
      178                  '<td colspan="5" style="text-align: left;">Способ объединения фильтров: ' + iFilter:GetModifierName() + '</td>' skip
      179                  '</tr>' skip
      180                  '</thead>' skip.
      181               this-object:PutStream(iFilter:User).
      182               this-object:PutStream(iFilter:HostName).
      183               this-object:PutStream(iFilter:DateGen).
      184               this-object:PutStream(iFilter:DateProl).
      185               this-object:PutStream(iFilter:Fio).
      186               this-object:PutStream(iFilter:ObjectNum).
      187               this-object:PutStream(iFilter:CashNum).
      188            end.
      189            put stream sHtml unformatted
      190               '<tbody>'                                                            skip
      191               '<TR>'                                                               skip
      192               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Дата</TD>'         skip
      193               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Время</TD>'        skip
      194               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Имя хоста</TD>'    skip
      195               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Пользователь</TD>' skip
      196               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Детали</TD>'       skip
      197               '</TR>'                                                              skip
      198               .
      199            put stream sHtml unformatted
      200               '<tbody>'                                                 skip
      201               '<TR>'                                                    skip
      202               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">1</TD>' skip
      203               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">2</TD>' skip
      204               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">3</TD>' skip
      205               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">4</TD>' skip
      206               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">6</TD>' skip
      207               '</TR>'                                                   skip
      208               .
      209            for each ttTechProlBrw:
      210               put stream sHtml unformatted
      211                  '<TR>' skip
      212                  '<TD text_wrap="true" style="text-align: center;">'  + string(ttTechProlBrw.fDate) + '</TD>' skip
      213                  '<TD text_wrap="true" style="text-align: center;">'  + ttTechProlBrw.fTime + '</TD>' skip
      214                  '<TD text_wrap="true" style="text-align: center;">'  + ttTechProlBrw.fHostName + '</TD>' skip
      215                  '<TD text_wrap="true" style="text-align: center;">'  + ttTechProlBrw.fUser + '</TD>' skip
      216                  '<TD text_wrap="true" style="text-align: left; padding-left: 20px">' + ttTechProlBrw.fDetails + '</TD>' skip
      217                  '</TR>'skip
      218               .
      219            end.
      220            output stream sHtml close.
      221            ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(vFullFileName, "") .
      222         end.
      223      end method.
      224      method public void PutStream(iCondition as class utl.flt-condition):
      225         def var vString as char no-undo.
      226         if iCondition:Enabled then
      227         do:
      228            vString = substitute("&1-&2-&3&4",
      229                                 replace(iCondition:FieldName,":",""),
      230                                 iCondition:Operation,
      231                                 iCondition:Value,
      232                                 if iCondition:FieldType = "между"
      233                                 then ("-" + iCondition:Value1)
      234                                 else "").
      235            put stream sHtml unformatted
      236               '<tr>' skip
      237               '<td colspan="5" style="text-align: left;"> ' + vString + '</td>' skip
      238               '</tr>' skip
      239               '</thead>' skip .
      240         end.
      241      end method.
      242   end class.
