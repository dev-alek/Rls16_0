        1   block-level on error undo, throw.
        2   using ibs.th.skt.ControlledClients.GisMtCDN.
        3   define variable vss-revision    as character no-undo init "$Revision:$":U .
        4   define variable vss-author      as character no-undo init "$Author:$":U .
        5   define variable vss-date        as character no-undo init "$Date:$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        7   define variable vss-archive     as character no-undo init "$Archive:$":U .
        8   define variable vss-description as character no-undo init "".
        9   define variable mError as logical no-undo.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable mAsyncProc as class ibs.th.file.AsyncProc.
       69   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       70   define variable mstopAsunc as logical no-undo.
       71   function StopCheck returns logical:
       72      define variable oFlag as logical no-undo.
       73      run StopCheckAsync (output oFlag).
       74      return oFlag.
       75   end.
       76   procedure StopCheckAsync:
       77       define output  parameter oFlag as logical no-undo.
       78       if mstopAsunc
       79       then
       80          oFlag = mstopAsunc.
       81       else do:
       82          oFlag = mAsyncProc:CheckStop().
       83          mstopAsunc = oFlag.
       84       end.
       85   end.
       86   function GetParamAsunc returns character
       87   (input iNumPar as integer  ):
       88      return mAsyncProc:GetPARAM(iNumPar).
       89   end.
       90   function GetParamAsuncStr returns ibs.th.file.asyncparam
       91   (input iParamName as character ):
       92      return mAsyncProc:GetPARAM(iParamName).
       93   end.
       94   procedure PutMesAsunc:
       95       define input  parameter Itext as character no-undo.
       96       define variable vflag as logical no-undo.
       97       Publish "WriteLogAsunc" (Itext, yes)  .
       98   end.
       99   procedure PutMesAsuncNoTime:
      100       define input  parameter Itext as character no-undo.
      101       define variable vflag as logical no-undo.
      102       Publish "WriteLogAsunc" (Itext,no)  .
      103   end.
      104   procedure PutStatAsunc:
      105       define input  parameter Itext as character no-undo.
      106       Publish "PutStatAsunc" (Itext,no) .
      107        run
      108       PutMesAsunc (itext).
      109   end.
      110   procedure PutStatAsuncNoTime:
      111       define input  parameter Itext as character no-undo.
      112       Publish "PutStatAsunc" (Itext,no)  .
      113        run
      114       PutMesAsuncNoTime (itext).
      115   end.
      116   procedure PutStatAsuncAdd:
      117       define input  parameter Itext as character no-undo.
      118       Publish "PutStatAsunc" (Itext,yes)  .
      119   end.
      120   procedure PutFileLogAsunc:
      121       define input  parameter IFile as character no-undo.
      122       Publish "PutFileLogAsunc" (ifile)  .
      123   end.
      124          mAsyncProc:mProcPublish = this-procedure.
      125   function objExists return character
      126   (input  ifolder as character,
      127    input  iType   as character  ):
      128       define variable vFileType as character no-undo init "D,F".
      129       define variable vi        as integer no-undo.
      130       define variable vtype as character no-undo.
      131       if iType ne ?
      132       then
      133          vFileType = iType.
      134       do vi = 1 to num-entries(vFileType):
      135          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      136          vtype = file-information:file-type.
      137          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      138             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      139             index(vtype , entry(vi,vFileType )) > 0
      140          then return file-information:full-pathname .
      141          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      142          vtype = file-information:file-type.
      143          if file-information:file-name <> "" and
      144             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      145             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      146             index( vtype, entry(vi,vFileType )) > 0
      147          then return file-information:full-pathname .
      148       end.
      149       return ? .
      150   end.
      151   function SearchFile return character
      152   (input  ifile as character):
      153      return objExists(ifile,?).
      154   end.
      155   function SearchPFile return character
      156   (input inFile as char):
      157        define variable oFile       as character no-undo.
      158        define variable vFileSearch as character no-undo.
      159        define variable vNumEntry   as integer no-undo.
      160        if inFile = "" then return ?.
      161        vNumEntry = num-entries(inFile,".").
      162        vFileSearch = inFile.
      163        if    vNumEntry > 0
      164           and (   entry(vNumEntry,inFile,".") eq "p"
      165                or entry(vNumEntry,inFile,".") eq "w")
      166        then do:
      167           entry(vNumEntry,vFileSearch, ".") = "r".
      168           oFile = search(vFileSearch ).
      169           if oFile eq ?
      170           then
      171              oFile = search(inFile).
      172        end.
      173        else
      174           oFile = search(vFileSearch).
      175        return oFile.
      176     end.
      177   define variable thGisMtCdn as class GisMtCDN no-undo .
      178   define variable mParam     as character      no-undo.
      179   def buffer buf_code for ub.code.
      180   mParam = GetPARAMAsunc( 1).
      181   if mParam eq ? then do:
      182      run PutMesAsunc( "error   Получение данных было прервано пользователем." ).
      183      return.
      184   end.
      185   find first buf_code where
      186              buf_code.parent = "CDN_GisMt"
      187          and buf_code.code = "CDN_Upd"
      188       no-lock no-error.
      189   if not avail buf_code then do:
      190      create buf_code.
      191      assign
      192         buf_code.parent = "CDN_GisMt"
      193         buf_code.code = "CDN_Upd"
      194         buf_code.codename = "Запущен процесс обновления площадок ГИС МТ"
      195         buf_code.codeval = string(now)
      196         .
      197   end.
      198   thGisMtCdn =  new GisMtCDN().
      199   case mParam:
      200       when "1" then thGisMtCdn:GetListCdn().
      201       when "2" then thGisMtCdn:UpdTimetCdn().
      202   end case.
      203   thGisMtCdn:DelCdnUpd().
      204   delete object thGisMtCdn.
