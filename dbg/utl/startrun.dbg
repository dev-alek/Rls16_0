        1   define input parameter p-parent-handle as handle    no-undo.
        2   DEFINE INPUT PARAMETER p-run-file-name AS CHARACTER NO-UNDO.
        3   DEFINE INPUT PARAMETER p-parameters AS CHARACTER NO-UNDO.
        4   DEFINE INPUT PARAMETER p-title AS CHARACTER NO-UNDO.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define stream sinp .
      115   define variable v-running     as logical   no-undo .
      116   define variable v-stop-run  as logical   no-undo .
      117   define variable v-pause-run as logical   no-undo .
      118   define variable v-run-time-start  as decimal   no-undo .
      119   define variable v-run-time-finish as decimal   no-undo .
      120   define variable v-run-ind      as integer   no-undo .
      121   define variable v-need-run-ind as integer   no-undo .
      122   define variable v-error-ind        as integer   no-undo .
      123   DEFINE BUTTON B-Help
      124        LABEL "Помо&щь"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON b-pause
      128        LABEL "&Пауза"
      129        SIZE 10 BY 1.
      130   DEFINE BUTTON b-quit AUTO-END-KEY
      131        LABEL "&Отмена"
      132        SIZE 10 BY 1.
      133   DEFINE BUTTON b-run DEFAULT
      134        LABEL "_ &Выполнить"
      135        SIZE 13 BY 1.
      136   DEFINE BUTTON i-exit
      137        IMAGE-UP FILE "cmp/i-run.bmp":U
      138        IMAGE-DOWN FILE "cmp/i-run.bmp":U
      139        IMAGE-INSENSITIVE FILE "cmp/i-rund.bmp":U
      140        LABEL ""
      141        SIZE 2.5 BY .75.
      142   DEFINE VARIABLE log-edit AS CHARACTER
      143        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      144        SIZE 76.13 BY 10.79 NO-UNDO.
      145   DEFINE VARIABLE fi-error AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      146        LABEL "Ошибок"
      147         VIEW-AS TEXT
      148        SIZE 14 BY .67 NO-UNDO.
      149   DEFINE VARIABLE fi-finish-time AS CHARACTER FORMAT "X(256)":U
      150        LABEL "Завершение"
      151         VIEW-AS TEXT
      152        SIZE 30.25 BY .67 NO-UNDO.
      153   DEFINE VARIABLE fi-need-run AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      154        LABEL "Осталось"
      155         VIEW-AS TEXT
      156        SIZE 14 BY .67 NO-UNDO.
      157   DEFINE VARIABLE fi-run AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      158        LABEL "Выполнено"
      159         VIEW-AS TEXT
      160        SIZE 14 BY .67 NO-UNDO.
      161   DEFINE VARIABLE fi-start-time AS CHARACTER FORMAT "X(256)":U
      162        LABEL "Начало"
      163         VIEW-AS TEXT
      164        SIZE 30.25 BY .67 NO-UNDO.
      165   DEFINE FRAME Dialog-Frame
      166        b-run AT ROW 1 COL 1
      167        b-quit AT ROW 1 COL 14
      168        b-pause AT ROW 1 COL 24
      169        B-Help AT ROW 1 COL 69.5
      170        i-exit AT ROW 1.13 COL 1.5 WIDGET-ID 4
      171        log-edit AT ROW 5.5 COL 2.5 NO-LABEL
      172        fi-run AT ROW 2.29 COL 19 COLON-ALIGNED
      173        fi-start-time AT ROW 2.29 COL 45.13 COLON-ALIGNED
      174        fi-finish-time AT ROW 3.29 COL 45.13 COLON-ALIGNED
      175        fi-need-run AT ROW 3.33 COL 19 COLON-ALIGNED
      176        fi-error AT ROW 4.33 COL 19 COLON-ALIGNED
      177        SPACE(45.49) SKIP(11.74)
      178       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      179            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      180            TITLE "<insert dialog title>".
      181   ASSIGN
      182          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      183          FRAME Dialog-Frame:HIDDEN           = TRUE.
      184   ASSIGN
      185          log-edit:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      186   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      187   DO:
      188     APPLY "END-ERROR":U TO SELF.
      189   END.
      190   ON CHOOSE OF b-pause IN FRAME Dialog-Frame
      191   DO:
      192     run pause-run in this-procedure .
      193   END.
      194   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      195   DO:
      196     run stop-run in this-procedure .
      197   END.
      198   ON CHOOSE OF b-run IN FRAME Dialog-Frame
      199   DO:
      200     run start-run in this-procedure .
      201   END.
      202   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      203   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      204   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   on help of frame Dialog-Frame
      206   do:
      207     run gbl/app_help.p
      208       (input this-procedure :file-name
      209       ,input ''
      210       ,input ?
      211       ) no-error.
      212     if error-status :error then do:
      213       message
      214         "Ошибка при вызове помощи"
      215         error-status :get-message(1)
      216         view-as alert-box .
      217     end.
      218   end.
      219   run minbtn-set in this-procedure .
      220   on choose of b-help in frame Dialog-Frame
      221   do:
      222     apply "help":u to frame Dialog-Frame .
      223   end.
      224   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   procedure minbtn-set :
      226       do
      227           on error undo, return error return-value
      228           :
      229           define variable ii              as integer       no-undo .
      230           define variable fh              as widget-handle no-undo .
      231           define variable hh              as widget-handle no-undo .
      232           define variable v-h             as handle        extent 4 no-undo .
      233           define variable v-name-button   as character     no-undo .
      234           define variable v-help-old-x    as decimal       no-undo .
      235           define variable v-help-old-y    as decimal       no-undo .
      236           define variable v-help-old-size as decimal       no-undo .
      237           define variable v-frame-width   as decimal       no-undo .
      238           define variable jj              as integer       no-undo .
      239           do
      240               on error undo, return error
      241               :
      242               assign
      243                   v-frame-width = frame Dialog-Frame:width - 0.3
      244                   fh            = frame Dialog-Frame:first-child
      245                   hh            = fh:first-child
      246                   ii            = 1
      247                   .
      248               do while valid-handle(hh):
      249                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      250                   do:
      251                       case lc(hh:name) :
      252                           when "b-help" then
      253                               do:
      254                                   hh:load-image-up("cmp/b-help.bmp":u) .
      255                                   hh:load-image-down("cmp/b-help.bmp":u) .
      256                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      257                                   hh:TOOLTIP = "Помощь" .
      258                                   v-help-old-x = hh:column .
      259                                   v-help-old-y = hh:row    .
      260                                   v-help-old-size = hh:width .
      261                                   hh:width-chars = 2.5 .
      262                               end.
      263                           when "b-print" then
      264                               do:
      265                                   hh:load-image("cmp/b-print.bmp":u) .
      266                                   hh:TOOLTIP = "Печать" .
      267                                   v-h[ii] = hh:handle .
      268                                   ii = ii + 1 .
      269                                   hh:width-chars = 3 .
      270                               end.
      271                           when "b-history" or
      272                           when "b-hist" then
      273                               do:
      274                                   hh:load-image("cmp/b-hist.bmp":u) .
      275                                   hh:TOOLTIP = "История" .
      276                                   v-h[ii] = hh:handle .
      277                                   ii = ii + 1 .
      278                                   hh:width-chars = 3 .
      279                               end.
      280                           when "b-sch" then
      281                               do:
      282                                   hh:load-image("cmp/b-sch.bmp":u) .
      283                                   hh:TOOLTIP = "Установка Фильтра" .
      284                                   v-h[ii] = hh:handle .
      285                                   ii = ii + 1 .
      286                                   hh:width-chars = 3 .
      287                               end.
      288                           when "b-hist-user" then
      289                               do:
      290                                   hh:load-image("cmp/b-hist.bmp":u) .
      291                                   hh:TOOLTIP = "История пользователя" .
      292                                   ii = ii + 1 .
      293                               end.
      294                       end case.
      295                   end.
      296                   hh = hh:next-sibling.
      297               end.
      298               b-help:column = v-frame-width - b-help:width-chars.
      299               jj = 0.
      300               repeat ii = 4 to 1 by -1 :
      301                   if valid-handle (v-h[ii] ) then
      302                   do:
      303                       jj  = jj + 1 .
      304                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      305                       v-h[ii]:row    = v-help-old-y .
      306                   end.
      307               end.
      308           end.
      309       end.
      310   end procedure.
      311   MAIN-BLOCK:
      312   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      313      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      314     ASSIGN
      315     FRAME Dialog-Frame:TITLE = p-title.
      316     RUN enable_UI.
      317     WAIT-FOR GO OF FRAME Dialog-Frame.
      318   END.
      319   RUN disable_UI.
      320   PROCEDURE callback-check-stop-run :
      321     define output parameter p-stop-run  as logical   no-undo .
      322     define output parameter p-pause-run as logical   no-undo .
      323     assign
      324       p-stop-run  = v-stop-run
      325       p-pause-run = v-pause-run
      326     .
      327     assign
      328       v-stop-run  = false
      329       v-pause-run = false
      330     .
      331   END PROCEDURE.
      332   PROCEDURE callback-display-run :
      333     define input  parameter  p-run-ind      as integer   no-undo .
      334     define input  parameter  p-need-run-ind as integer   no-undo .
      335     define input  parameter  p-error-ind        as integer   no-undo .
      336     assign
      337       v-run-ind      = p-run-ind
      338       v-need-run-ind = p-need-run-ind
      339       v-error-ind        = p-error-ind
      340     .
      341     define variable v-curr-time as decimal   no-undo .
      342     assign
      343       v-curr-time = integer(today) + time / 86400.0
      344     .
      345     if v-run-ind > 0
      346     and v-run-ind modulo 10 = 0
      347     then do:
      348       assign
      349         v-run-time-finish = (v-curr-time - v-run-time-start)
      350                               / v-run-ind
      351                               * v-need-run-ind
      352                               + v-curr-time
      353       .
      354     end.
      355     if  v-run-ind > 0
      356     and v-run-time-finish > v-run-time-start
      357     then do:
      358       define variable v-start-time-string as character no-undo .
      359       define variable v-finish-time-string as character no-undo .
      360       define variable v-ref-date        as date      no-undo .
      361       define variable v-start-date-ind  as integer   no-undo .
      362       define variable v-finish-date-ind as integer   no-undo .
      363       assign
      364         v-ref-date        = today
      365         v-start-date-ind  = integer(truncate(v-run-time-start, 0))
      366         v-finish-date-ind = integer(truncate(v-run-time-finish, 0))
      367       .
      368       assign
      369         v-start-time-string   = string(v-ref-date + v-start-date-ind - integer(v-ref-date), '99/99/9999':U)
      370                               + "  ":U
      371                               + string(integer(truncate((v-run-time-start - truncate(v-run-time-start, 0)) * 86400, 0)), 'HH:MM':U)
      372         v-finish-time-string  = string(v-ref-date + v-finish-date-ind - integer(v-ref-date), '99/99/9999':U)
      373                               + "  ":U
      374                               + string(integer(truncate((v-run-time-finish - truncate(v-run-time-finish, 0)) * 86400, 0)), 'HH:MM':U)
      375       .
      376     end.
      377     else do:
      378       assign
      379       v-ref-date        = today
      380       v-start-date-ind  = integer(truncate(v-run-time-start, 0))
      381       v-start-time-string   = string(v-ref-date + v-start-date-ind - integer(v-ref-date), '99/99/9999':U)
      382                               + "  ":U
      383                               + string(integer(truncate((v-run-time-start - truncate(v-run-time-start, 0)) * 86400, 0)), 'HH:MM':U)
      384       .
      385     end.
      386     display
      387       v-run-ind        @ fi-run
      388       v-need-run-ind   @ fi-need-run
      389       v-error-ind          @ fi-error
      390       v-start-time-string  @ fi-start-time
      391       v-finish-time-string @ fi-finish-time
      392       with frame Dialog-Frame .
      393   END PROCEDURE.
      394   PROCEDURE callback-set-start-run-time :
      395     assign
      396       v-run-time-start = integer(today) + time / 86400.0
      397     .
      398   END PROCEDURE.
      399   PROCEDURE callback-write-to-log :
      400     define input parameter p-msg-str as character no-undo .
      401     define variable lok as logical   no-undo .
      402     do with frame Dialog-Frame
      403     on error undo, return error
      404     :
      405       assign
      406         lok = log-edit :move-to-eof( )
      407         lok = log-edit :insert-string( p-msg-str )
      408         lok = log-edit :move-to-eof( )
      409       .
      410     end.
      411   END PROCEDURE.
      412   PROCEDURE disable_UI :
      413     HIDE FRAME Dialog-Frame.
      414   END PROCEDURE.
      415   PROCEDURE enable_UI :
      416     DISPLAY log-edit fi-run fi-start-time fi-finish-time fi-need-run fi-error
      417         WITH FRAME Dialog-Frame.
      418     ENABLE b-run b-quit b-pause B-Help i-exit log-edit fi-run fi-start-time
      419            fi-finish-time fi-need-run fi-error
      420         WITH FRAME Dialog-Frame.
      421     VIEW FRAME Dialog-Frame.
      422   END PROCEDURE.
      423   PROCEDURE pause-run :
      424    assign
      425       v-pause-run = true
      426     .
      427   END PROCEDURE.
      428   PROCEDURE start-run :
      429     assign
      430       v-running     = true
      431       v-stop-run  = false
      432       v-pause-run = false
      433     .
      434     run value(p-run-file-name) in p-parent-handle
      435       (input this-procedure :handle
      436        ,INPUT p-parameters
      437       ) .
      438     assign
      439       v-running = false
      440     .
      441   END PROCEDURE.
      442   PROCEDURE stop-run :
      443     if v-running = true
      444     then do:
      445       assign
      446         v-stop-run = true
      447       .
      448     end.
      449     else do:
      450       apply 'close':u to this-procedure .
      451     end.
      452   END PROCEDURE.
