     1362       ,output v-cntxt-is-admin
     1363       ) .
     1364     if v-cntxt-db-num <> 0 then do:
     1365       message
     1366       "Данную утилиту можно запустить ТОЛЬКО В ГБД"
     1367       view-as alert-box.
     1368       return.
     1369     end.
     1370     if can-find(first ub.db no-lock where ub.db.db-num > 0) then do:
     1371       assign
     1372       v-is-remote-dbs = yes
     1373       .
     1374     end.
     1375     message
     1376     substitute("Отберите ДК, которые не были использованы&1" +
     1377               "Они будут, по возможности, ОКОНЧАТЕЛЬНО удалены&1&2&1" +
     1378               "Продолжить?"
     1379               , chr(10)
     1380               , (if v-is-remote-dbs
     1381                   then "после получения подтверждения из всех УБД"
     1382                   else '')
     1383               )
     1384     view-as alert-box question buttons YES-NO update glog.
     1385     if not glog then return.
     1386     run str/dc-list.w (
     1387                        input parparentproc
     1388                       ,input v-cntxt-host-code-obj
     1389                       ,input v-cntxt-obj-type
     1390                       ,input v-cntxt-obj-code) no-error.
     1391     find first dc-list no-error.
     1392     if not available dc-list then do:
     1393       return.
     1394     end.
     1395     message
     1396     substitute("Продолжить процесс ОКОНЧАТЕЛЬНОГО удаления отобранных карт?&1"
     1397               , chr(10)
     1398               )
     1399     view-as alert-box question buttons YES-NO update glog.
     1400     if not glog then return.
     1401     run proceed-non-used-dc in this-procedure no-error.
     1402     if error-status:error then do:
     1403       undo, return error .
     1404     end.
     1405     if not can-find(first dc-list no-lock) then return.
     1406     run hide-counter in p-log-handle.
     1407     run set-title in p-log-handle (
     1408           input 'Отправка информации по клиентским картам на кассу'
     1409                                     ).
     1410     for each dc-list :
     1411       assign
     1412       dc-list.status_ = 'неисп':U.
     1413     end.
     1414     run str/sendclia.p (
     1415                        input parparentproc
     1416                       ,input p-parent-handle
     1417                       ,input p-log-handle
     1418                       ,input(string(g#db-num) + chr(4) +  chr(4) + "no":U + chr(4) + "O":U)
     1419                         ) no-error .
     1420     if error-status:error then do:
     1421       run write-log-and-file in p-log-handle (
     1422                                               input 1
     1423                                             , input log-file-name
     1424                                             , input 1
     1425                                             , input  substitute( "ошибка при удалении информации по клиентским картам с касс &1&2&1&3"
     1426                                                                 , chr(10)
     1427                                                                 , error-status:get-message(1)
     1428                                                                 , return-value )
     1429                                                                         ).
     1430     end.
     1431   end.
     1432   procedure proceed-non-used-dc :
     1433   define variable v-ii as integer no-undo .
     1434   define variable v-stop as logical no-undo .
     1435   define buffer buf_dis-card for ub.dis-card.
     1436   main-block:
     1437   do
     1438   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1439   :
     1440     if not v-is-remote-dbs then do:
     1441       run trg/discardt.p persistent set v-ext-prg-handle .
     1442     end.
     1443     else do:
     1444       assign
     1445       v-is-remote-dbs = yes
     1446       .
     1447     end.
     1448     _dc-list:
     1449     for each dc-list no-lock,
     1450         first buf_dis-card no-lock where
     1451             buf_dis-card.d-card = dc-list.d-card:
     1452       assign
     1453       v-ii = v-ii + 1
     1454       .
     1455       run process-dis-card in this-procedure ( input buf_dis-card.d-card) no-error .
     1456       if error-status:error then do:
     1457         run write-log-and-file in p-log-handle (
     1458                                                 input 1
     1459                                               , input log-file-name
     1460                                               , input 1
     1461                                               , input return-value  ).
     1462         delete dc-list.
     1463         next _dc-list.
     1464       end.
     1465       dc-list.status_ = 'неисп':U.
     1466       run get-stop-state in p-log-handle ( output v-stop).
     1467       if v-stop then do:
     1468         run write-log-and-file in p-log-handle (
     1469                                                   input 1
     1470                                                 , input log-file-name
     1471                                                 , input 1
     1472                                                 , input substitute("!!!Процедура  остановлена пользователем"
     1473                                                                     )
     1474                                                                       ).
     1475         leave _dc-list.
     1476       end.
     1477       run show-counter in p-log-handle .
     1478       run write-counter in p-log-handle (substitute("Обработано: &1."
     1479                                           , v-ii
     1480                                             )) no-error.
     1481     END.
     1482     if v-is-remote-dbs = no then
     1483     delete procedure v-ext-prg-handle .
     1484     run waitfram-hide in this-procedure .
     1485   end.
     1486   end procedure.
     1487   procedure process-dis-card :
     1488   define input parameter p-d-card like ub.dis-card.d-card no-undo .
     1489   define variable v-key-rec as character no-undo .
     1490   define variable v-param as character no-undo .
     1491   define variable l-is-used as logical no-undo .
     1492   define variable v-rec as recid no-undo .
     1493   define variable v-d-card as character no-undo .
     1494   define buffer buf_dis-card for ub.dis-card.
     1495   define buffer buf2_dis-card for ub.dis-card.
     1496   main-block:
     1497   do
     1498   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1499   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1500   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1501   :
     1502     def var v-msg-not-del as character.
     1503     find first buf_Dis-card no-lock where
     1504               buf_Dis-card.d-card = p-d-card no-error.
     1505     if not available buf_dis-card then do:
     1506       message
     1507       substitute("Нет карты с номером &1", p-d-card)
     1508       view-as alert-box error .
     1509       undo, return error .
     1510     end.
     1511     for each buf2_dis-card no-lock where
     1512             buf2_dis-card.card-num = buf_dis-card.card-num:
     1513       if buf2_dis-card.d-card = buf_dis-card.d-card then next.
     1514       undo main-block, return error substitute("Удаление невозможно: dis-card Перевыпущенная карта &1 для карты", buf2_dis-card.d-card, buf_Dis-card.d-card).
     1515     end.
     1516     for each buf2_dis-card no-lock where
     1517             buf2_dis-card.main-card = buf_dis-card.main-card:
     1518       if buf2_dis-card.main-card = buf_dis-card.d-card then next.
     1519       undo main-block, return error substitute("Удаление невозможно: dis-card Дополнительная карта &1 для карты", buf2_dis-card.d-card, buf_Dis-card.d-card).
     1520     end.
     1521     if v-is-remote-dbs then do:
     1522       run gen-key-rec( input 'dis-card':U
     1523                       ,input (buffer buf_dis-card:handle )
     1524                       ,output v-key-rec
     1525                     ) no-error.
     1526       if error-status :error then do:
     1527         undo main-block, return error substitute("&1 &2 &3&4Ошибка при генерации уникального ключа для ДК&4&5&6&5&7"
     1528                                                   ,vss-workfile
     1529                                                   ,vss-revision
     1530                                                   ,vss-description
     1531                                                   , buf_dis-card.d-card
     1532                                                   ,chr(10)
     1533                                                   , error-status:get-message(1)
     1534                                                   , return-value ).
     1535       end.
     1536       assign
     1537       v-param = string(buf_dis-card.d-card) + chr(4) +
     1538                 buf_dis-card.status_
     1539       .
     1540       run nws/db-rec.p (
     1541                           input 'delete_nu-dis-card':U
     1542                           ,input v-key-rec
     1543                           ,input v-param
     1544                         ) no-error .
     1545     end.
     1546     else do:
     1547       find current buf_dis-card  exclusive-lock.
     1548       assign
     1549       v-rec = recid(buf_dis-card)
     1550       buf_dis-card.status_ = 'неисп':U
     1551       v-d-card = buf_dis-card.d-card
     1552       .
     1553       release buf_Dis-card.
     1554       find first buf_Dis-card where
     1555                recid(buf_dis-card) = v-rec.
     1556       run value( "proc-is-used-dis-card" ) in v-ext-prg-handle (
     1557                                                                   buffer buf_dis-card
     1558                                                                 , input g#db-num
     1559                                                                 , output l-is-used) no-error .
     1560       v-msg-not-del = return-value.
     1561       if not error-status:error
     1562       and not l-is-used then do:
     1563         delete buf_dis-card no-error .
     1564       end.
     1565     end.
     1566     if error-status :error then do:
     1567       run write-log-and-file in p-log-handle (
     1568                                               input 1
     1569                                             , input log-file-name
     1570                                             , input 1
     1571                                             , input  substitute( "&1 &2 &3&4Ошибка при удалении неиспользуемой ДК&4Карта &5&4&6&4&7"
     1572                                                                 ,vss-workfile
     1573                                                                 ,vss-revision
     1574                                                                 ,vss-description
     1575                                                                 , chr(10)
     1576                                                                 ,buf_dis-card.d-card
     1577                                                                 ,error-status:get-message(1)
     1578                                                                 ,return-value )
     1579                                                                         ).
     1580       undo main-block, return error.
     1581     end.
     1582     else do:
     1583       if v-is-remote-dbs then
     1584       if l-is-used
     1585       then
     1586         run write-log-and-file in p-log-handle (
     1587                                                 input 1
     1588                                               , input log-file-name
     1589                                               , input 1
     1590                                               , input  substitute( "Карта &1: Начат процесс изменения статуса на неисп., окончательное удаление невозможно. &3Обнаружено: &2."
     1591                                                                   ,buf_dis-card.d-card, v-msg-not-del, chr(10) )
     1592                                                                           ).
     1593       else
     1594         run write-log-and-file in p-log-handle (
     1595                                               input 1
     1596                                             , input log-file-name
     1597                                             , input 1
     1598                                             , input  substitute( "Карта &1: начат процесс ОКОНЧАТЕЛЬНОГО удаления"
     1599                                                                 ,buf_dis-card.d-card )
     1600                                                                         ).
     1601       else
     1602       if l-is-used
     1603       then
     1604         run write-log-and-file in p-log-handle (
     1605                                                 input 1
     1606                                               , input log-file-name
     1607                                               , input 1
     1608                                               , input  substitute( "Карта &1: Изменен статус на неисп., окончательное удаление невозможно. &3Обнаружено: &2."
     1609                                                                   ,buf_dis-card.d-card, v-msg-not-del, chr(10) )
     1610                                                                           ).
     1611       else
     1612         run write-log-and-file in p-log-handle (
     1613                                                 input 1
     1614                                               , input log-file-name
     1615                                               , input 1
     1616                                               , input  substitute( "Карта &1: ОКОНЧАТЕЛЬНО УДАЛЕНА"
     1617                                                                   ,v-d-card )
     1618                                                                           ).
     1619     end.
     1620   end.
     1621   end procedure.
