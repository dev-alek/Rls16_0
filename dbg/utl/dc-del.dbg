        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: 206c91217f77, 1790, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        8   define variable vss-date        as character no-undo init "$Date: Tue Feb 26 13:12:51 2019 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: dc-del.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/dc-del.p $":U .
       11   define variable vss-description as character no-undo init "Удаление неиспользованных ДК two-commit".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure progs-name :
       83     define input  parameter p-action-code         as character no-undo .
       84     define output parameter p-main-prog-name      as character no-undo .
       85     define output parameter p-list-db-proc-name   as character no-undo .
       86     define output parameter p-commit-proc-name    as character no-undo .
       87     define output parameter p-execution-proc-name as character no-undo .
       88     define output parameter p-recover-proc-name   as character no-undo .
       89     define output parameter p-after-proc-name     as character no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       case p-action-code :
       94               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
       95               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
       96               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
       97               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
       98               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
       99               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      100               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      101               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      102               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      103               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      104               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      105               otherwise do:
      106           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      107         end.
      108       end case.
      109     end.
      110     return.
      111   end procedure.
      112   procedure progs-title :
      113     define input  parameter p-action-code         as character no-undo .
      114     define output parameter p-action-title      as character no-undo .
      115     do
      116     on error undo, return error
      117     :
      118       case p-action-code :
      119               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      120               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      121               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      122               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      123               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      124               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      125               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      126               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      127               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      128               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      129               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      130               otherwise do:
      131           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      132         end.
      133       end case.
      134     end.
      135     return.
      136   end procedure.
      137   FUNCTION progs-title-function returns character(
      138      input  p-action-code         as character):
      139   define variable p-action-title      as character no-undo .
      140     do
      141     on error undo, return error
      142     :
      143       case p-action-code :
      144               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      145               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      146               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      147               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      148               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      149               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      150               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      151               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      152               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      153               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      154               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      155               otherwise do:
      156           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      157         end.
      158       end case.
      159     end.
      160     return p-action-title.
      161   end FUNCTION.
      162   procedure get-row-keyr-string :
      163    define input  parameter p-key-rec  as character no-undo.
      164    define output parameter p-tbl-title as character no-undo.
      165    define output parameter p-rec-string  as character no-undo.
      166     do
      167     on error undo, return error
      168     :
      169       define variable v-full-tbl-name as character no-undo .
      170       define variable bh_tbl-name     as handle    no-undo .
      171       define variable fh              as handle    no-undo .
      172       define variable v-ok            as logical   no-undo .
      173       define variable v-field-num     as integer   no-undo .
      174       define variable v-count-fld     as integer   no-undo .
      175       define variable v-tbl-name as character no-undo.
      176       if p-key-rec = ?
      177         or p-key-rec = "":U
      178       then do:
      179         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      180       end.
      181       assign
      182         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      183         v-full-tbl-name = "ub.":U + v-tbl-name
      184         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      185         p-rec-string         = "":U
      186         v-count-fld     = 0
      187       .
      188       find ub._file
      189         where ub._file._file-name = v-tbl-name
      190         no-error.
      191       if not available ub._file then do:
      192         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info0, v-tbl-name ).
      193       end.
      194       assign
      195       p-tbl-title = ub._file._file-label
      196       .
      197       find ub._index
      198         where recid( ub._index  ) = ub._file._prime-index
      199         no-error.
      200       if not available ub._index
      201         or LC( ub._index._index-name ) = "default":U
      202       then do:
      203         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      204       end.
      205       block_where :
      206       for each ub._index-field of ub._index  ,
      207           each ub._field of _index-field
      208           break by _index-seq
      209       on error undo, return error
      210       :
      211         assign
      212           v-count-fld = v-count-fld + 1
      213         .
      214         if v-count-fld > v-field-num then do:
      215           leave block_where.
      216         end.
      217         if p-rec-string = "":U then do:
      218           assign
      219             p-rec-string = "":U
      220           .
      221         end.
      222         else do:
      223           assign
      224             p-rec-string = p-rec-string + chr(32) + chr(44)
      225           .
      226         end.
      227         assign
      228           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      229         .
      230       end.
      231       if v-count-fld <> v-field-num then do:
      232         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      233       end.
      234     end.
      235     return.
      236   end procedure.
      237   FUNCTION uniq-key-rec-string-f returns character(
      238      input  p-uniq-key-rec         as character):
      239   define variable v-tbl-title as character no-undo .
      240   define variable v-rec-string as character no-undo .
      241     do
      242     on error undo, return error
      243     :
      244       run get-row-keyr-string in this-procedure (
      245                                                 input p-uniq-key-rec
      246                                                 ,output v-tbl-title
      247                                                 ,output v-rec-string).
      248       assign
      249       v-rec-string = (if v-tbl-title <> ? and
      250                       v-tbl-title <> "":U
      251                       then (v-tbl-title + ":")
      252                      else "":U) + chr(32) + v-rec-string
      253       .
      254     end.
      255     return v-rec-string.
      256   end FUNCTION.
      257   procedure create_db-rec_route :
      258     define input parameter p1-uniq-key-rec as character no-undo .
      259     define input parameter p1-action       as character no-undo .
      260     define input parameter p1-operation    as character no-undo .
      261     define input parameter p1-send-db-list as character no-undo .
      262     define input parameter p1-db-init      as integer   no-undo .
      263     define input parameter p1-parameters   as character no-undo .
      264     define input parameter p1-answer-code  as integer   no-undo .
      265     define input parameter p1-answer-msg   as character no-undo .
      266     do
      267     on error undo, return error
      268     :
      269       define variable v-command     as character no-undo .
      270       define variable v-ind         as integer   no-undo .
      271       define variable v-num-entries as integer   no-undo .
      272       define variable v-curr-db     as integer   no-undo .
      273       define variable v-db-for-send as character no-undo .
      274       define variable v-db-num      as integer   no-undo .
      275       define variable v-db-num-char as character no-undo .
      276       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      277       find first buf_sys-ctrl no-lock .
      278       assign
      279         v-curr-db     = buf_sys-ctrl.db-num
      280         v-db-for-send = "":U
      281       .
      282       if v-curr-db = 0 then do:
      283         if p1-answer-code >= 0 then do:
      284           if v-curr-db <> p1-db-init then do:
      285             assign
      286               v-db-for-send = string( p1-db-init )
      287             .
      288           end.
      289         end.
      290         else do:
      291           assign
      292             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      293           .
      294           do v-ind = 1 to v-num-entries:
      295             assign
      296               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      297               v-db-num      = integer( v-db-num-char )
      298             .
      299             if v-db-num <> v-curr-db
      300               and v-db-num <> p1-db-init
      301             then do:
      302               if v-db-for-send = "":U then do:
      303                 assign
      304                   v-db-for-send = v-db-num-char
      305                 .
      306               end.
      307               else do:
      308                 assign
      309                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      310                 .
      311               end.
      312             end.
      313           end.
      314         end.
      315       end.
      316       else do:
      317         assign
      318           v-db-for-send = "0":U
      319         .
      320       end.
      321       if v-db-for-send <> "":U then do:
      322         assign
      323           v-command = "command":U + chr(1)
      324                       + "two-commit":U + chr(1)
      325                       + p1-action + chr(1)
      326                       + p1-operation + chr(1)
      327                       + p1-uniq-key-rec + chr(1)
      328                       + string( p1-db-init ) + chr(1)
      329                       + p1-parameters + chr(1)
      330                       + string( p1-answer-code ) + chr(1)
      331                       + p1-answer-msg
      332         .
      333         run nws/cr-route.p ( input 'send-cmd':U
      334                       ,input v-command
      335                       ,input ?
      336                       ,input v-db-for-send
      337                       ) no-error .
      338         if error-status :error then do:
      339           return error return-value.
      340         end.
      341       end.
      342     end.
      343     return.
      344   end procedure.
      345   procedure create_msg_route :
      346     define input parameter p2-send-db-list as character no-undo .
      347     define input parameter p2-msg          as character no-undo .
      348     do
      349     on error undo, return error
      350     :
      351       define variable v-msg-command as character no-undo .
      352       define variable v-ind         as integer   no-undo .
      353       define variable v-num-entries as integer   no-undo .
      354       define variable v-curr-db     as integer   no-undo .
      355       define variable v-db-for-send as character no-undo .
      356       define variable v-db-num      as integer   no-undo .
      357       define variable v-db-num-char as character no-undo .
      358       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      359       find first buf_sys-ctrl no-lock .
      360       assign
      361         v-curr-db     = buf_sys-ctrl.db-num
      362         v-db-for-send = "":U
      363       .
      364       if v-curr-db = 0 then do:
      365         assign
      366           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      367         .
      368         do v-ind = 1 to v-num-entries:
      369           assign
      370             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      371             v-db-num      = integer( v-db-num-char )
      372           .
      373           if v-db-num <> v-curr-db then do:
      374             if v-db-for-send = "":U then do:
      375               assign
      376                 v-db-for-send = v-db-num-char
      377               .
      378             end.
      379             else do:
      380               assign
      381                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      382               .
      383             end.
      384           end.
      385         end.
      386       end.
      387       else do:
      388         assign
      389           v-db-for-send = "0":U
      390         .
      391       end.
      392       if v-db-for-send <> "":U then do:
      393         assign
      394           v-msg-command = "command":U + chr(1)
      395                           + "message-to-log":U + chr(1)
      396                           + p2-msg
      397         .
      398         run nws/cr-route.p ( input 'send-cmd':U
      399                       ,input v-msg-command
      400                       ,input ?
      401                       ,input v-db-for-send
      402                       ) no-error .
      403         if error-status :error then do:
      404           return error substitute( "&1&2&3"
      405                                     , return-value
      406                                     , chr(10)
      407                                     , error-status :get-message(1)
      408                                   ).
      409         end.
      410       end.
      411     end.
      412     return.
      413   end procedure.
      414   function get-send-db-list returns character
      415     ( input p-curr-db     as integer
      416      ,input p-all-db-list as character
      417     )
      418   :
      419     define variable v-send-db-list as character no-undo .
      420     if p-curr-db = 0 then do:
      421       assign
      422         v-send-db-list = p-all-db-list
      423       .
      424     end.
      425     else do:
      426       assign
      427         v-send-db-list = string(p-curr-db)
      428       .
      429     end.
      430     return v-send-db-list .
      431   end function .
      432   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      433   procedure gen-key-rec :
      434     define input  parameter p-tbl-name    as character no-undo.
      435     define input  parameter p-bh_tbl-name as handle    no-undo.
      436     define output parameter p-key-rec     as character no-undo.
      437     do
      438     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      439     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      440     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      441     :
      442       define variable fh               as handle    no-undo .
      443       define variable v-ok             as logical   no-undo .
      444       define variable v-inform         as character no-undo .
      445       define variable v-ind            as integer   no-undo .
      446       define variable v-idx-field-qnty as integer   no-undo .
      447       if p-tbl-name = ?
      448         or p-tbl-name = "":U
      449       then do:
      450         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      451       end.
      452       if not p-bh_tbl-name:available then do:
      453         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      454       end.
      455       assign
      456         p-key-rec = p-tbl-name
      457         v-inform  = p-bh_tbl-name:index-information(1)
      458         v-ind     = 2
      459       .
      460       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      461       on error undo, return error
      462       :
      463         assign
      464           v-inform = p-bh_tbl-name:index-information( v-ind )
      465           v-ind    = v-ind + 1
      466         .
      467       end.
      468       if v-inform = ?
      469         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      470         or entry( 3, v-inform, ",":U ) <> "1":U
      471       then do:
      472         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      473       end.
      474       else do:
      475         assign
      476           v-idx-field-qnty = num-entries( v-inform ) - 4
      477         .
      478         if v-idx-field-qnty < 2 then do:
      479           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      480         end.
      481         do v-ind = 1 to v-idx-field-qnty by 2
      482         on error undo, return error
      483         :
      484           assign
      485             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      486             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      487           .
      488         end.
      489       end.
      490       if p-key-rec = ? then do:
      491         assign
      492           p-key-rec = "":U
      493         .
      494         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      495       end.
      496     end.
      497     return.
      498   end procedure.
      499   procedure gen-where-keyr-tab :
      500     define input  parameter i-tableSerach as character no-undo.
      501     define input  parameter i-tablekey   as character  no-undo.
      502     define input  parameter p-key-rec    as character  no-undo.
      503     define input  parameter p-key-handle as handle     no-undo .
      504     define input  parameter p-db-name    as character  no-undo .
      505     define input  parameter p-tt-handle  as handle     no-undo .
      506     define output parameter o-Where      as character  no-undo.
      507     do
      508     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      509     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      510     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      511     :
      512       define variable v-full-tbl-name  as character no-undo .
      513       define variable bh_tbl-name      as handle    no-undo .
      514       define variable fh_key           as handle    no-undo .
      515       define variable fh_search        as handle    no-undo .
      516       define variable v-field-num      as integer   no-undo .
      517       define variable v-count-fld      as integer   no-undo .
      518       define variable v-inform         as character no-undo .
      519       define variable v-ind            as integer   no-undo .
      520       define variable v-idx-field-qnty as integer   no-undo .
      521       define variable v-field-name     as character no-undo .
      522       define variable v-field-val      as character no-undo .
      523       define variable v-word-link      as character no-undo .
      524       define variable vTable           as character no-undo.
      525       define variable bh_tbl-key       as handle    no-undo .
      526       assign
      527         p-key-rec = trim( p-key-rec )
      528       .
      529       if p-key-handle <> ? then do:
      530         if not valid-handle(p-key-handle)
      531            or p-key-handle:type <> "buffer"
      532         then do:
      533           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      534         end.
      535         if num-entries( p-key-rec, chr(3) ) > 1
      536           or p-key-rec = ?
      537           or p-key-rec = "":U
      538         then do:
      539           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      540         end.
      541       end.
      542       else do:
      543         if p-key-rec = ?
      544           or p-key-rec = "":U
      545         then do:
      546           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      547         end.
      548       end.
      549       assign
      550         vTable = entry( 1 , p-key-rec, chr(3) )
      551       .
      552       if p-tt-handle <> ?
      553         and ( not valid-handle(p-tt-handle)
      554               or p-tt-handle:type <> "buffer"
      555             )
      556       then do:
      557         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      558       end.
      559       if p-tt-handle = ? then do:
      560         assign
      561           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      562         .
      563         create buffer bh_tbl-name for table v-full-tbl-name .
      564       end.
      565       else do:
      566         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      567       end.
      568       assign
      569         v-inform = bh_tbl-name:index-information(1)
      570         v-ind    = 2
      571       .
      572       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      573       on error undo, return error
      574       :
      575         assign
      576           v-inform = bh_tbl-name:index-information( v-ind )
      577           v-ind    = v-ind + 1
      578         .
      579       end.
      580       if v-inform = ?
      581         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      582         or entry( 3, v-inform, ",":U ) <> "1":U
      583       then do:
      584         delete object bh_tbl-name no-error.
      585         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      586       end.
      587       assign
      588         v-idx-field-qnty = num-entries( v-inform ) - 4
      589       .
      590       if v-idx-field-qnty < 2 then do:
      591         delete object bh_tbl-name no-error.
      592         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      593       end.
      594       assign
      595         o-where     = "where":U
      596         v-word-link = "":U
      597         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      598         v-count-fld = 0
      599       .
      600       if i-tablekey ne "" and i-tablekey ne ?
      601       then do:
      602         assign
      603           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      604         .
      605         create buffer bh_tbl-key for table v-full-tbl-name .
      606       end.
      607       if i-tableSerach ne "" and i-tableSerach ne ?
      608       then do:
      609         delete object bh_tbl-name no-error.
      610         assign
      611           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      612         .
      613         create buffer bh_tbl-name for table v-full-tbl-name .
      614       end.
      615       block_where:
      616       do v-ind = 1 to v-idx-field-qnty by 2
      617       on error undo, return error
      618       :
      619         assign
      620           v-count-fld = v-count-fld + 1
      621         .
      622         if p-key-handle = ?
      623           and v-count-fld > v-field-num
      624         then do:
      625           leave block_where.
      626         end.
      627         define variable VfieldKeyTable as handle no-undo.
      628         assign
      629           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      630           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      631         .
      632         if     bh_tbl-key ne ?
      633         then do:
      634            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      635            if VfieldKeyTable eq ?
      636            then next block_where.
      637         end.
      638         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      639         then
      640            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      641         else
      642            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      643         if p-key-handle = ? then do:
      644           assign
      645             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      646           .
      647         end.
      648         else do:
      649           assign
      650             fh_key = p-key-handle:buffer-field( v-field-name )
      651           .
      652           if fh_key = ?
      653             or not valid-handle( fh_key )
      654           then do:
      655             delete object bh_tbl-name.
      656             if     bh_tbl-key ne ?
      657             then
      658                delete object bh_tbl-key.
      659             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      660           end.
      661           assign
      662             v-field-val = fh_key:buffer-value
      663           .
      664         end.
      665         if fh_search:data-type ="character":U then do:
      666           assign
      667             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      668             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      669             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      670             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      671             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      672             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      673             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      674             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      675             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      676             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      677             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      678             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      679             v-field-val = substitute( '"&1"', v-field-val )
      680           .
      681         end.
      682         assign
      683           o-where = substitute( "&1 &2", o-where, v-field-val )
      684         .
      685         if v-word-link = "":U then do:
      686           assign
      687             v-word-link = "and":U
      688           .
      689         end.
      690       end.
      691       delete object bh_tbl-name.
      692       if     bh_tbl-key ne ?
      693       then
      694          delete object bh_tbl-key.
      695       if p-key-handle = ?
      696         and v-count-fld <> v-field-num
      697       then do:
      698         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      699       end.
      700     end.
      701   end procedure.
      702   procedure gen-hn-keyr-tab :
      703     define input  parameter i-tableSerach as character no-undo.
      704     define input  parameter i-tablekey   as character no-undo.
      705     define input  parameter p-key-rec    as character no-undo.
      706     define input  parameter p-key-handle as handle    no-undo .
      707     define input  parameter p-db-name    as character no-undo .
      708     define input  parameter p-tt-handle  as handle    no-undo .
      709     define input  parameter p-stts-lock  as integer   no-undo .
      710     define output parameter o-hn         as handle    no-undo.
      711     define variable v-full-tbl-name as character no-undo.
      712     define variable v-where         as character no-undo.
      713     define variable bh_tbl-name     as handle    no-undo.
      714     define variable vTable          as character no-undo.
      715     do
      716     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      717     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      718     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      719         run gen-where-keyr-tab(i-tableSerach,
      720                                i-tablekey,
      721                                p-key-rec,
      722                                p-key-handle,
      723                                p-db-name,
      724                                p-tt-handle,
      725                                output v-where).
      726         if i-tableSerach ne "" and i-tableSerach ne ?
      727         then do:
      728            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      729            create buffer bh_tbl-name for table v-full-tbl-name .
      730         end.
      731         else do:
      732            if p-tt-handle = ? then do:
      733               assign
      734                  vTable = entry( 1 , p-key-rec, chr(3) )
      735               .
      736               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      737               create buffer bh_tbl-name for table v-full-tbl-name .
      738            end.
      739            else do:
      740               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      741            end.
      742         end.
      743         if p-tt-handle = ? then do:
      744            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      745         end.
      746         else do:
      747            bh_tbl-name:find-first( v-where ) no-error .
      748         end.
      749         o-hn = bh_tbl-name.
      750      end.
      751   end procedure.
      752   procedure gen-hn-keyr :
      753     define input  parameter p-key-rec    as character no-undo.
      754     define input  parameter p-key-handle as handle    no-undo .
      755     define input  parameter p-db-name    as character no-undo .
      756     define input  parameter p-tt-handle  as handle    no-undo .
      757     define input  parameter p-stts-lock  as integer   no-undo .
      758     define output parameter o-hn         as handle    no-undo.
      759     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      760   end.
      761   procedure gen-row-keyr :
      762     define input  parameter p-key-rec    as character no-undo.
      763     define input  parameter p-key-handle as handle    no-undo .
      764     define input  parameter p-db-name    as character no-undo .
      765     define input  parameter p-tt-handle  as handle    no-undo .
      766     define input  parameter p-stts-lock  as integer   no-undo .
      767     define output parameter p-tbl-row    as rowid     no-undo.
      768     define output parameter p-tbl-name   as character no-undo.
      769     define variable vHn as handle no-undo.
      770       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      771       p-tbl-row = if vHn:available then vHn:rowid else ?.
      772       p-tbl-name =  vHn:table.
      773       delete object vHn no-error.
      774     if p-tbl-row = ? then do:
      775       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      776     end.
      777     else do:
      778       return.
      779     end.
      780   end procedure.
      781   procedure gen-key-fv :
      782     define input  parameter p-key-rec    as character no-undo .
      783     define output parameter p-field-list as character no-undo .
      784     define output parameter p-value-list as character no-undo.
      785     do
      786     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      787     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      788     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      789     :
      790       define variable v-full-tbl-name  as character no-undo .
      791       define variable bh_tbl-name      as handle    no-undo .
      792       define variable v-tbl-name       as character no-undo .
      793       define variable v-field-num      as integer   no-undo .
      794       define variable v-count-fld      as integer   no-undo .
      795       define variable v-inform         as character no-undo .
      796       define variable v-ind            as integer   no-undo .
      797       define variable v-idx-field-qnty as integer   no-undo .
      798       define variable v-delim-key      as character no-undo .
      799       if p-key-rec = ?
      800         or p-key-rec = "":U
      801       then do:
      802         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      803       end.
      804       assign
      805         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      806         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      807       .
      808       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      809       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      810       assign
      811         v-inform = bh_tbl-name:index-information(1)
      812         v-ind    = 2
      813       .
      814       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      815       on error undo, return error
      816       :
      817         assign
      818           v-inform = bh_tbl-name:index-information( v-ind )
      819           v-ind    = v-ind + 1
      820         .
      821       end.
      822       if v-inform = ?
      823         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      824         or entry( 3, v-inform, ",":U ) <> "1":U
      825       then do:
      826         delete object bh_tbl-name no-error.
      827         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      828       end.
      829       assign
      830         v-idx-field-qnty = num-entries( v-inform ) - 4
      831       .
      832       if v-idx-field-qnty < 2 then do:
      833         delete object bh_tbl-name no-error.
      834         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      835       end.
      836       assign
      837         p-field-list = "":U
      838         p-value-list = "":U
      839         v-delim-key  = "":U
      840         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      841         v-count-fld  = 0
      842       .
      843       block_where:
      844       do v-ind = 1 to v-idx-field-qnty by 2
      845       on error undo, return error
      846       :
      847         assign
      848           v-count-fld = v-count-fld + 1
      849         .
      850         if v-count-fld > v-field-num then do:
      851           leave block_where.
      852         end.
      853         assign
      854           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      855           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      856         .
      857         if v-ind = 1 then do:
      858           assign
      859             v-delim-key = chr(3)
      860           .
      861         end.
      862       end.
      863       delete object bh_tbl-name.
      864       if v-count-fld <> v-field-num then do:
      865         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      866       end.
      867     end.
      868   end procedure.
      869   procedure gen-key-field :
      870     define input  parameter p-table      as character no-undo .
      871     define output parameter p-field-list as character no-undo .
      872     do
      873     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      874     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      875     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      876     :
      877       define variable v-full-tbl-name  as character no-undo .
      878       define variable bh_tbl-name      as handle    no-undo .
      879       define variable v-tbl-name       as character no-undo .
      880       define variable v-field-num      as integer   no-undo .
      881       define variable v-count-fld      as integer   no-undo .
      882       define variable v-inform         as character no-undo .
      883       define variable v-ind            as integer   no-undo .
      884       define variable v-idx-field-qnty as integer   no-undo .
      885       define variable v-delim-key      as character no-undo .
      886       if p-table = ?
      887         or p-table = "":U
      888       then do:
      889         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      890       end.
      891       assign
      892         v-tbl-name      = p-table
      893         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      894       .
      895       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      896       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      897       assign
      898         v-inform = bh_tbl-name:index-information(1)
      899         v-ind    = 2
      900       .
      901       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      902       on error undo, return error
      903       :
      904         assign
      905           v-inform = bh_tbl-name:index-information( v-ind )
      906           v-ind    = v-ind + 1
      907         .
      908       end.
      909       if v-inform = ?
      910         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      911         or entry( 3, v-inform, ",":U ) <> "1":U
      912       then do:
      913         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      914       end.
      915       assign
      916         v-idx-field-qnty = num-entries( v-inform ) - 4
      917       .
      918       if v-idx-field-qnty < 2 then do:
      919         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      920       end.
      921       assign
      922         p-field-list = "":U
      923         v-delim-key  = "":U
      924         v-count-fld  = 0
      925       .
      926       block_where:
      927       do v-ind = 1 to v-idx-field-qnty by 2
      928       on error undo, return error
      929       :
      930         assign
      931           v-count-fld = v-count-fld + 1
      932         .
      933         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      934         if v-ind = 1 then do:
      935           assign
      936             v-delim-key = chr(3)
      937           .
      938         end.
      939       end.
      940       delete object bh_tbl-name.
      941     end.
      942   end procedure.
      943   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   define variable v-waitfram-action01         as character   no-undo .
      945   define variable v-waitfram-action02         as character   no-undo .
      946   define variable v-waitfram-action03         as character   no-undo .
      947   define variable mWaitFramTextBeg            as character   no-undo.
      948   define variable mWaitFramTextEnd            as character   no-undo.
      949   define variable mWaitFramView               as logical     no-undo.
      950   define variable mWaitProcEvent              as logical     no-undo init yes.
      951   define variable mWaitFramInterval           as integer     no-undo init 1 .
      952   define variable mWaitFramStop               as logical     no-undo.
      953   define variable mWaitFramStopUser           as logical     no-undo.
      954   define variable mWaitFramStopTimeOut        as logical     no-undo.
      955   define variable mWaitFramStartProc          as datetime-tz no-undo.
      956   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      957   define button B-WaitFramStop auto-end-key
      958        label "Стоп"
      959        size 10 by 1 tooltip "Остоновить процесс".
      960   define button B-viewProcInfo
      961        label "Информация"
      962        size 15 by 1 tooltip "Информация о процесс".
      963   define frame waitfram
      964     v-waitfram-action01 format "x(72)" no-label skip
      965     v-waitfram-action02 format "x(72)" no-label skip
      966     v-waitfram-action03 format "x(72)" no-label skip
      967     B-viewProcInfo
      968     B-WaitFramStop at row 4 col 30
      969     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      970     .
      971   define new global shared variable mBatchMode as logical no-undo init ?.
      972   define variable mFramBachModHandle as handle no-undo.
      973   mFramBachModHandle = frame waitfram:handle.
      974   define variable mFameOldVis as logical no-undo.
      975   define variable mVisCUrentVin as logical no-undo.
      976   if session:batch-mode
      977   then
      978      mBatchMode = yes.
      979   if mBatchMode = ? then do:
      980     mVisCUrentVin = current-window:visible.
      981     mFameOldVis = mFramBachModHandle:visible.
      982     mFramBachModHandle:visible  = yes.
      983     mBatchMode = mFramBachModHandle:visible ne yes.
      984     mFramBachModHandle:visible = mFameOldVis.
      985     current-window:visible = mVisCUrentVin.
      986   end.
      987    if  log-manager:logfile-name ne ?
      988     then DO:
      989         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      990         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      991         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      992     end.
      993   on choose of B-WaitFramStop in frame waitfram
      994   do:
      995     mWaitFramStop = yes.
      996     mWaitFramStopUser = yes.
      997   end.
      998   function waitfram-check-timeout returns logical():
      999      define variable vtime as int64 no-undo.
     1000      if mWaitFramStopTimeOut
     1001      then
     1002         return yes.
     1003      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1004      if     mWaitFramTimeOut ne ?
     1005         and mWaitFramTimeOut ne 0
     1006         and mWaitFramTimeOut lt vtime
     1007      then do:
     1008         mWaitFramStopTimeOut = yes.
     1009      end.
     1010      return mWaitFramStopTimeOut.
     1011   end.
     1012   procedure waitfram-hide :
     1013     if not session:batch-mode
     1014     then do
     1015     on error undo, return error return-value
     1016     :
     1017       pause 0 before-hide .
     1018       if not mBatchMode then
     1019         hide frame waitfram .
     1020     if     not mWaitFramView
     1021        and mWaitProcEvent
     1022     then
     1023       process events .
     1024     end.
     1025   end procedure.
     1026   procedure waitfram-show :
     1027     define input  parameter p-message as character no-undo .
     1028     define variable v-left-margin as integer   no-undo .
     1029     if not session:batch-mode
     1030     then do
     1031     on error undo, return error return-value
     1032     :
     1033       if length(p-message) <= 70 then do:
     1034         assign
     1035           v-left-margin = integer((70 - length(p-message)) / 2)
     1036         .
     1037         assign
     1038           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1039         .
     1040         assign
     1041           v-waitfram-action01 = " "
     1042           v-waitfram-action02 = " "
     1043                                    + fill(" ", v-left-margin)
     1044                                    + p-message
     1045           v-waitfram-action03 = " "
     1046         .
     1047       end.
     1048       else do:
     1049         define variable vRindex1 as integer no-undo.
     1050         define variable vRindex2 as integer no-undo.
     1051         vRindex1 = r-index(p-message," ",70).
     1052         if vRindex1 = 0
     1053         then
     1054            vRindex1 = 70.
     1055         if length(p-message)  <= vRindex1 + 70 then do:
     1056           assign
     1057             v-waitfram-action01 = " "
     1058             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1059             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1060           .
     1061         end.
     1062         else do:
     1063           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1064           if vRindex2 <= vRindex1
     1065           then
     1066              vRindex2 = vRindex1 + 70.
     1067           assign
     1068             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1069             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1070             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1071           .
     1072         end.
     1073       end.
     1074       B-viewProcInfo:visible   in frame waitfram = no.
     1075       B-viewProcInfo:sensitive in frame waitfram = no.
     1076       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1077       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1078       if  (   mWaitFramView
     1079          or  mWaitProcEvent)
     1080          and not mBatchMode
     1081       then
     1082          display
     1083             v-waitfram-action01 skip
     1084             v-waitfram-action02 skip
     1085             v-waitfram-action03 skip
     1086          with frame waitfram .
     1087       if     mWaitFramView
     1088          then do:
     1089             if     mWaitFramInterval ne ?
     1090                and not mBatchMode
     1091             then
     1092                wait-for go of frame waitfram pause mWaitFramInterval.
     1093          end.
     1094          else
     1095             if     mWaitProcEvent
     1096                and not mBatchMode
     1097             then
     1098                process events .
     1099     end.
     1100   end procedure.
     1101      procedure waitfram-show-this:
     1102         define input  parameter iInterval as int64 no-undo.
     1103         define variable vtime as int64 no-undo.
     1104         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1105         mWaitFramInterval = iInterval.
     1106         run waitfram-show (substitute("&1&2 &3&4" ,
     1107                                       mWaitFramTextBeg ,
     1108                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1109                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1110                                       mWaitFramTextEnd
     1111                                      )
     1112                           ).
     1113      end.
     1114      procedure WaitFramRunPause:
     1115         define input  parameter iInterval as dec no-undo.
     1116         define variable vStart  as datetime-tz no-undo.
     1117         define variable vend    as datetime-tz no-undo.
     1118         define variable vint as int64 no-undo.
     1119         define variable vOk as logical no-undo.
     1120         vStart = now.
     1121         vend   = vStart.
     1122         publish "WaitFramPause" (iInterval,output vOk).
     1123         vend   =  now.
     1124         vint = vend - vStart.
     1125         vint = iInterval - vint / 1000.
     1126         if     not mWaitFramStop
     1127            and (   vint > 0
     1128                 or (    not vOk
     1129                     and iInterval eq ?
     1130                     )
     1131                 )
     1132         then
     1133            run waitfram-show-this (iInterval).
     1134         vend   =  now.
     1135         vint = vend - vStart.
     1136         vint = iInterval - vint / 1000.
     1137         if     not mWaitFramStop
     1138            and vint > 0
     1139         then do:
     1140            run gbl/pause.p (vint * 1000).
     1141         end.
     1142         if iInterval ne ?
     1143         then
     1144            publish "WaitFramStop".
     1145         waitfram-check-timeout().
     1146      end.
     1147      procedure WaitFramWaitFor:
     1148         define input  parameter iInterval as dec no-undo.
     1149         assign
     1150            mWaitFramStartProc   = now
     1151            mWaitFramStopUser    = no
     1152            mWaitFramStopTimeOut = no
     1153         .
     1154         block-wait:
     1155         do while not mWaitFramStop:
     1156            run WaitFramRunPause (iInterval).
     1157            if  waitfram-check-timeout()
     1158            then do:
     1159               leave block-wait.
     1160            end.
     1161         end.
     1162         run waitfram-hide.
     1163      end.
     1164   procedure waitfram-join :
     1165     define input  parameter p-line-1  as character no-undo .
     1166     define input  parameter p-line-2  as character no-undo .
     1167     define input  parameter p-line-3  as character no-undo .
     1168     define output parameter p-message as character no-undo .
     1169     do
     1170     on error undo, return error return-value
     1171     :
     1172       assign
     1173         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1174                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1175                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1176       .
     1177     end.
     1178   end procedure.
     1179   function waitfram-join-function returns character
     1180     (input p-line-1 as character
     1181     ,input p-line-2 as character
     1182     ,input p-line-3 as character
     1183     ).
     1184     define variable v-message as character no-undo .
     1185     run waitfram-join in this-procedure
     1186       (input  p-line-1
     1187       ,input  p-line-2
     1188       ,input  p-line-3
     1189       ,output v-message
     1190       ) .
     1191     return v-message .
     1192   end function .
