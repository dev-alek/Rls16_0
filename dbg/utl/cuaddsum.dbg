        1   block-level on error undo, throw.
        2   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: cuaddsum.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/cuaddsum.p $":U .
        8   define variable vss-description as character no-undo init "Программа по вызову утилиты для расчета дополнительных сумм по документу".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define new global shared variable g#trdcalib as handle no-undo.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       74   define variable par-type          as character no-undo.
       75   define variable v-value-character as character no-undo .
       76   define variable v-value-date      as date      no-undo .
       77   define variable v-value-decimal   as decimal   no-undo .
       78   define variable v-value-integer   as integer   no-undo .
       79   define variable v-value-logical   as logical   no-undo .
       80   define variable varinvclcspvalue as character          no-undo.
       81   define variable varinvclcsptype  as character          no-undo.
       82   define variable varcalcasstring  as character          no-undo.
       83   define variable varcalcastype    as character          no-undo.
       84   define variable wastagevalue     as character          no-undo.
       85   define variable wastagetype      as character          no-undo.
       86   define variable varneed-calc     as logical            no-undo.
       87   define buffer bf_trn-doc for ub.trn-doc.
       88   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
       89   if not available bf_trn-doc then do:
       90     return error substitute ("Не найден документ с номером &1.", pardoc-code).
       91   end.
       92   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   empty temp-table thbjattr_thbj-attr.
       94   run adm/shattri.p (
       95      input "get":U
       96     ,input bf_trn-doc.obj-type
       97     ,input bf_trn-doc.obj-code
       98     ,input 'inv-obj':U
       99     ,input  ""
      100     ,output v-value-character
      101     ,output v-value-date
      102     ,output v-value-decimal
      103     ,output v-value-integer
      104     ,output v-value-logical
      105     ,output par-type
      106     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      107     ) no-error .
      108     for each thbjattr_thbj-attr :
      109         if thbjattr_thbj-attr.prop-code = 'invclcsp' then varinvclcspvalue = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
      110         if thbjattr_thbj-attr.prop-code = 'wastage'  then wastagevalue = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
      111     end.
      112   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf_trn-doc.doc-code ,
      113                           input 'addsum':U ,
      114                          output varcalcasstring ,
      115                          output varcalcastype ) no-error .
      116   if error-status:error then do:
      117     return error substitute ("Ошибка при вызове процедуры tdat-val. Документ &1. Параметр &2.", bf_trn-doc.doc-code, 'clcasol':U).
      118   end.
      119   if lookup ('bd':U,  varcalcasstring ) = 0 or
      120      lookup ('gen':U, varcalcasstring ) = 0 or
      121      lookup ('ext':U,   varcalcasstring ) = 0 or
      122      lookup ('mis':U,    varcalcasstring ) = 0 or
      123      lookup ('ad':U,   varcalcasstring ) = 0 then do:
      124     assign
      125       varneed-calc = yes.
      126   end.
      127   if wastagevalue = "yes" then do:
      128     if lookup ('wst':U, varcalcasstring ) = 0 then do:
      129       assign
      130         varneed-calc = yes.
      131     end.
      132   end.
      133   if varinvclcspvalue = "yes" then do:
      134     if lookup ('bcd':U,  varcalcasstring ) = 0 or
      135        lookup ('genc':U, varcalcasstring ) = 0 or
      136        lookup ('extc':U,   varcalcasstring ) = 0 or
      137        lookup ('misc':U,    varcalcasstring ) = 0 or
      138        lookup ('acd':U,   varcalcasstring ) = 0 then do:
      139       assign
      140         varneed-calc = yes.
      141     end.
      142     if wastagevalue = "yes" then do:
      143       if lookup ('wstc':U, varcalcasstring ) = 0 then do:
      144         assign
      145           varneed-calc = yes.
      146       end.
      147     end.
      148   end.
      149   if varneed-calc = yes then do:
      150     run utl/uaddsum.p
      151         (input bf_trn-doc.doc-code ,
      152          input no ,
      153          input no ,
      154          input no
      155         ) no-error.
      156     if error-status:error then do:
      157       return error substitute ("Ошибка при вызове процедуры uaddsum.p: &1 &2.", return-value, error-status:get-message(1)).
      158     end.
      159   end.
