      687   procedure lineattr-delete-flora-all :
      688     do
      689     on error undo, return error return-value
      690     :
      691       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      692       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      693       define input  parameter p-prt-code    as integer   no-undo .
      694       define buffer buf_doc-line-attr for ub.doc-line-attr .
      695       for each buf_doc-line-attr exclusive-lock
      696         where buf_doc-line-attr.doc-code  = p-doc-code
      697           and buf_doc-line-attr.gds-code  = p-gds-code
      698           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      699        :
      700         delete buf_doc-line-attr.
      701       end.
      702    end.
      703   end procedure.
      704   procedure lineattr-exist-flora-gds :
      705     do
      706     on error undo, return error return-value
      707     :
      708       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      709       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      710       define input  parameter p-prt-code    as integer   no-undo .
      711       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      712       define output parameter p-exist as logical   no-undo .
      713       define buffer buf_doc-line-attr for ub.doc-line-attr .
      714       p-exist = false .
      715       find first buf_doc-line-attr no-lock
      716         where buf_doc-line-attr.doc-code  = p-doc-code
      717           and buf_doc-line-attr.gds-code  = p-gds-code
      718           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      719         no-error .
      720       if avail buf_doc-line-attr then do:
      721         assign
      722          p-exist = true
      723         .
      724       end.
      725     end.
      726   end procedure.
      727   procedure lineattr-write-add-line-cli :
      728   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      729   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      730   define input  parameter p-cli-type      as character no-undo .
      731   define input  parameter p-cli-code      as integer   no-undo .
      732   define input  parameter p-contract-code as integer   no-undo .
      733   define input  parameter p-host-code     as integer   no-undo .
      734   define input  parameter p-exch-code     as integer   no-undo .
      735   define input  parameter p-exch-rate     as decimal   no-undo .
      736   define input  parameter p-exch-scale    as integer   no-undo .
      737   define input  parameter p-sum-cli       as decimal   no-undo .
      738   define input  parameter p-sum-vat       as decimal   no-undo .
      739   define buffer buf_doc-line-attr for ub.doc-line-attr .
      740     do
      741     on error undo, return error return-value
      742     :
      743       find first buf_doc-line-attr exclusive-lock
      744         where buf_doc-line-attr.doc-code  = p-doc-code
      745           and buf_doc-line-attr.gds-code  = p-gds-code
      746           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      747                                             chr(4) + p-cli-type +
      748                                             chr(4) + string(p-cli-code) +
      749                                             chr(4) + string(p-contract-code) +
      750                                             chr(4) + string(p-host-code)
      751         no-error .
      752       if not available buf_doc-line-attr then do:
      753         create buf_doc-line-attr .
      754         assign
      755           buf_doc-line-attr.doc-code  = p-doc-code
      756           buf_doc-line-attr.gds-code  = p-gds-code
      757           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      758                                         chr(4) + p-cli-type +
      759                                         chr(4) + string(p-cli-code) +
      760                                         chr(4) + string(p-contract-code) +
      761                                         chr(4) + string(p-host-code)
      762         .
      763       end.
      764       assign
      765         buf_doc-line-attr.attr-value =
      766         string(p-exch-code)  + chr(4) +
      767         string(p-exch-rate)  + chr(4) +
      768         string(p-exch-scale) + chr(4) +
      769         string(p-sum-cli)    + chr(4) +
      770         string(p-sum-vat)
      771         .
      772     end.
      773   end procedure.
      774   procedure lineattr-value-add-line-cli :
      775   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      776   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      777   define input   parameter p-cli-type      as character no-undo .
      778   define input   parameter p-cli-code      as integer   no-undo .
      779   define input   parameter p-contract-code as integer   no-undo .
      780   define input   parameter p-host-code     as integer   no-undo .
      781   define output  parameter p-exch-code     as integer   no-undo .
      782   define output  parameter p-exch-rate     as decimal   no-undo .
      783   define output  parameter p-exch-scale    as integer   no-undo .
      784   define output  parameter p-sum-cli       as decimal   no-undo .
      785   define output  parameter p-sum-vat       as decimal   no-undo .
      786   define buffer buf_doc-line-attr for ub.doc-line-attr .
      787     do
      788     on error undo, return error return-value
      789     :
      790       find first buf_doc-line-attr exclusive-lock
      791         where buf_doc-line-attr.doc-code  = p-doc-code
      792           and buf_doc-line-attr.gds-code  = p-gds-code
      793           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      794                                             chr(4) + p-cli-type +
      795                                             chr(4) + string(p-cli-code) +
      796                                             chr(4) + string(p-contract-code) +
      797                                             chr(4) + string(p-host-code)
      798         no-error .
      799       if available buf_doc-line-attr then do:
      800        assign
      801           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      802           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      803           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      804           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      805           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      806          .
      807        end.
      808     end.
      809   end procedure.
      810   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      811     define variable v-code as character no-undo .
      812     define variable v-type as character no-undo .
      813     define variable v-gds-code as integer   no-undo .
      814   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      815   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      816     (input  local-doc-line.artic
      817     ,input  local-doc-line.prod-type
      818     ,input  local-doc-line.prod-code
      819     ,output v-gds-code
      820     )  .
      821     run lineattr-value (
      822         input   local-doc-line.doc-code ,
      823         input   v-gds-code              ,
      824         input   'reason-code':U ,
      825         output  v-code                  ,
      826         output  v-type ) .
      827     find first ub.trn-reason no-lock where
      828                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      829     if not available ub.trn-reason then do:
      830        return "" .
      831     end.
      832     else do:
      833        return ub.trn-reason.reason-name .
      834     end.
      835   end function.
      836   procedure lineattr-value-parts :
      837     do
      838     on error undo, return error return-value
      839     :
      840       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      841       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      842       define input  parameter p-part-code   as character no-undo .
      843       define input  parameter p_in-code     as character no-undo .
      844       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      845       define output parameter p-value       as    decimal   no-undo .
      846       define buffer buf_doc-line-attr for ub.doc-line-attr .
      847       find first buf_doc-line-attr no-lock
      848         where buf_doc-line-attr.doc-code  = p-doc-code
      849           and buf_doc-line-attr.gds-code  = p-gds-code
      850           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      851         no-error .
      852       if avail buf_doc-line-attr then do:
      853         assign
      854           p-value = decimal( buf_doc-line-attr.attr-value)
      855         .
      856       end.
      857       else do:
      858         assign
      859           p-value = 0
      860         .
      861       end.
      862     end.
      863   end procedure.
      864   procedure lineattr-write-parts :
      865     do
      866     on error undo, return error return-value
      867     :
      868       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      869       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      870       define input parameter p-part-code  as character no-undo .
      871       define input parameter p_in-code    as character no-undo .
      872       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      873       define input parameter p-value      as decimal   no-undo .
      874       define buffer buf_doc-line-attr for ub.doc-line-attr .
      875       find first buf_doc-line-attr exclusive-lock
      876         where buf_doc-line-attr.doc-code  = p-doc-code
      877           and buf_doc-line-attr.gds-code  = p-gds-code
      878           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      879         no-error .
      880       if not available buf_doc-line-attr then do:
      881         create buf_doc-line-attr .
      882         assign
      883           buf_doc-line-attr.doc-code  = p-doc-code
      884           buf_doc-line-attr.gds-code  = p-gds-code
      885           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      886         .
      887       end.
      888       assign
      889         buf_doc-line-attr.attr-value = string( p-value )
      890       .
