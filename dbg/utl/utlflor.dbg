        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: utlflor.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/utlflor.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure grp-attr-name :
       70   do
       71     on error undo, return error
       72     :
       73     define input  parameter p-code           as character no-undo .
       74     define output parameter p-type           as character no-undo .
       75     define output parameter p-format         as character no-undo .
       76     define output parameter p-label          as character no-undo .
       77     define output parameter p-user-can-edit  as logical   no-undo .
       78     define output parameter p-output-display as logical   no-undo .
       79     define output parameter p-other          as character no-undo .
       80       case p-code :
       81               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
       82         otherwise do:
       83           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
       84         end.
       85       end.
       86     end.
       87   end procedure.
       88   procedure grp-attr-tooltip :
       89   do
       90     on error undo, return error
       91     :
       92       define input  parameter p-code    as character no-undo .
       93       define output parameter p-tooltip as character no-undo .
       94       define output parameter p-label   as character no-undo .
       95       case p-code :
       96               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
       97         otherwise do:
       98               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
       99         end.
      100       end.
      101     end.
      102   end procedure.
      103   procedure grp-attr-value :
      104   do
      105   on error undo, return error
      106   :
      107   define input  parameter p-node-code   as integer    no-undo.
      108   define input  parameter p-code        as character  no-undo.
      109   define input  parameter p-host-code   as integer    no-undo.
      110   define input  parameter p-obj-type    as character  no-undo.
      111   define input  parameter p-obj-code    as integer    no-undo.
      112   define output parameter p-value       as character  no-undo.
      113   define output parameter p-type        as character  no-undo.
      114       define variable v-format         as character no-undo .
      115       define variable v-label          as character no-undo .
      116       define variable v-user-can-edit  as logical   no-undo .
      117       define variable v-output-display as logical   no-undo .
      118       define variable v-other          as character no-undo .
      119       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      120       run grp-attr-name in this-procedure (
      121             input  p-code
      122           , output p-type
      123           , output v-format
      124           , output v-label
      125           , output v-user-can-edit
      126           , output v-output-display
      127           , output v-other
      128       ) no-error .
      129       if error-status :error
      130       then do:
      131           undo, return error return-value .
      132       end.
      133       find first buf_gds-grp-attr no-lock
      134            where buf_gds-grp-attr.node-code = p-node-code
      135              and buf_gds-grp-attr.attr-code = p-code
      136              and buf_gds-grp-attr.host-code = p-host-code
      137              and buf_gds-grp-attr.obj-type  = p-obj-type
      138              and buf_gds-grp-attr.obj-code  = p-obj-code
      139       no-error .
      140       if available buf_gds-grp-attr
      141       then do:
      142           assign
      143               p-value = buf_gds-grp-attr.attr-value
      144           .
      145       end.
      146       else do:
      147           assign
      148               p-value = if p-type = 'L':U then "no":U else ""
      149           .
      150       end.
      151   end.
      152   end procedure.
      153   procedure grp-attr-write :
      154   do
      155   on error undo, return error
      156   :
      157   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      158   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      159   define input parameter p-host-code  as integer                          no-undo.
      160   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      161   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      162   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      163       define variable v-type              as character                no-undo.
      164       define variable v-format            as character                no-undo.
      165       define variable v-label             as character                no-undo.
      166       define variable v-user-can-edit     as logical                  no-undo.
      167       define variable v-output-display    as logical                  no-undo.
      168       define variable v-other             as character                no-undo.
      169       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      170       run grp-attr-name in this-procedure (
      171                         input  p-code
      172                       , output v-type
      173                       , output v-format
      174                       , output v-label
      175                       , output v-user-can-edit
      176                       , output v-output-display
      177                       , output v-other
      178       ) no-error.
      179       if error-status :error
      180       then do:
      181           undo, return error return-value.
      182       end.
      183       find first buf_gds-grp-attr exclusive-lock
      184            where buf_gds-grp-attr.node-code  = p-node-code
      185              and buf_gds-grp-attr.attr-code  = p-code
      186              and buf_gds-grp-attr.host-code  = p-host-code
      187              and buf_gds-grp-attr.obj-type   = p-obj-type
      188              and buf_gds-grp-attr.obj-code   = p-obj-code
      189       no-error.
      190       if not available buf_gds-grp-attr
      191       then do:
      192           create buf_gds-grp-attr.
      193           assign
      194                   buf_gds-grp-attr.node-code  = p-node-code
      195                   buf_gds-grp-attr.attr-code  = p-code
      196                   buf_gds-grp-attr.host-code  = p-host-code
      197                   buf_gds-grp-attr.obj-type   = p-obj-type
      198                   buf_gds-grp-attr.obj-code   = p-obj-code
      199                   buf_gds-grp-attr.attr-value = p-value
      200           .
      201       end.
      202       else do:
      203           assign
      204               buf_gds-grp-attr.attr-value = p-value
      205           .
      206       end.
      207   end.
      208   end procedure.
      209   procedure grp-attr-delete :
      210   do
      211   on error undo, return error
      212   :
      213   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      214   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      215   define input parameter p-host-code  as integer                      no-undo.
      216   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      217   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      218   define output parameter p-deleted   as logical                      no-undo.
      219       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      220       define variable v-type              as character                no-undo.
      221       define variable v-format            as character                no-undo.
      222       define variable v-label             as character                no-undo.
      223       define variable v-user-can-edit     as logical                  no-undo.
      224       define variable v-output-display    as logical                  no-undo.
      225       define variable v-other             as character                no-undo.
      226       run grp-attr-name in this-procedure
      227       ( input  p-code
      228       , output v-type
      229       , output v-format
      230       , output v-label
      231       , output v-user-can-edit
      232       , output v-output-display
      233       , output v-other
      234       ) no-error .
      235       if error-status :error then do:
      236           undo, return error return-value .
      237       end.
      238       find first buf_gds-grp-attr exclusive-lock
      239            where buf_gds-grp-attr.node-code  = p-node-code
      240              and buf_gds-grp-attr.attr-code  = p-code
      241              and buf_gds-grp-attr.host-code  = p-host-code
      242              and buf_gds-grp-attr.obj-type   = p-obj-type
      243              and buf_gds-grp-attr.obj-code   = p-obj-code
      244       no-error.
      245       if not available buf_gds-grp-attr
      246       then do:
      247           assign
      248               p-deleted = no
      249           .
      250       end.
      251       else do:
      252          delete buf_gds-grp-attr.
      253          assign
      254               p-deleted = yes
      255           .
      256       end.
      257   end.
      258   end procedure.
      259   procedure grp-attr-news :
      260   do
      261   on error undo, return error
      262   :
      263       define input  parameter p-code           as character no-undo .
      264       define output parameter p-news           as logical   no-undo .
      265       case p-code :
      266               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
      267         otherwise do:
      268           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
      269         end.
      270       end.
      271   end.
      272   end procedure.
      273   procedure grp-attr-obj-value :
      274   do
      275   on error undo, return error
      276   :
      277   define input parameter p-node-code as integer      no-undo.
      278   define input parameter p-obj-type  as character    no-undo.
      279   define input parameter p-obj-code  as integer      no-undo.
      280   define input parameter p-attr-code as character    no-undo .
      281   define output parameter p-attr-value     as character   no-undo.
      282   define output parameter p-range     as integer      no-undo.
      283   define output parameter p-exists    as logical      no-undo.
      284   define variable v-host-code as integer      no-undo.
      285   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      287     (input  p-obj-type
      288     ,input  p-obj-code
      289     ,output v-host-code
      290     ) no-error .
      291   if error-status :error
      292   then do:
      293       message
      294         vss-workfile vss-revision vss-description
      295         skip "Не удалось найти фирму объекта"
      296         skip p-obj-type p-obj-code
      297         skip return-value
      298         skip trim(error-status :get-message(1))
      299              trim(error-status :get-message(2))
      300              trim(error-status :get-message(3))
      301              trim(error-status :get-message(4))
      302              trim(error-status :get-message(5))
      303       view-as alert-box error.
      304       undo, return error .
      305   end.
      306   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      307   find first buf_gds-grp-attr no-lock
      308        where buf_gds-grp-attr.node-code = p-node-code
      309          and buf_gds-grp-attr.attr-code = p-attr-code
      310          and buf_gds-grp-attr.host-code = v-host-code
      311          and buf_gds-grp-attr.obj-type  = p-obj-type
      312          and buf_gds-grp-attr.obj-code  = p-obj-code
      313   no-error .
      314   if not available buf_gds-grp-attr
      315   then do:
      316       find first buf_gds-grp-attr no-lock
      317            where buf_gds-grp-attr.node-code = p-node-code
      318              and buf_gds-grp-attr.attr-code = p-attr-code
      319              and buf_gds-grp-attr.host-code = v-host-code
      320              and buf_gds-grp-attr.obj-type  = ""
      321              and buf_gds-grp-attr.obj-code  = 0
      322       no-error .
      323       if not available buf_gds-grp-attr
      324       then do:
      325           find first buf_gds-grp-attr no-lock
      326               where buf_gds-grp-attr.node-code = p-node-code
      327               and buf_gds-grp-attr.attr-code = p-attr-code
      328               and buf_gds-grp-attr.host-code = 0
      329               and buf_gds-grp-attr.obj-type  = ""
      330               and buf_gds-grp-attr.obj-code  = 0
      331           no-error .
      332           if not available buf_gds-grp-attr
      333           then do:
      334               assign
      335                   p-exists = no
      336               .
      337           end.
      338           else do:
      339               assign
      340                   p-exists = yes
      341                   p-range  = 1
      342               .
      343           end.
      344       end.
      345       else do:
      346           assign
      347               p-exists = yes
      348               p-range  = 2
      349           .
      350       end.
      351   end.
      352   else do:
      353       assign
      354           p-exists = yes
      355           p-range  = 3
      356       .
      357   end.
      358   if available buf_gds-grp-attr
      359   then do:
      360     assign
      361     p-attr-value = buf_gds-grp-attr.attr-value
      362     .
      363   end.
      364   end.
      365   end procedure.
      366   procedure ver-gds-grp-nabor :
      367   do
      368   on error undo, return error return-value
      369   :
      370   define input  parameter p-gds-code as integer   no-undo .
      371   define output parameter p-nabor as logical   no-undo .
      372   define buffer buf_goods for ub.goods.
      373   p-nabor = false .
      374   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      375   if error-status :error then return error .
      376   define variable v-value       as character  no-undo.
      377   define variable v-type        as character  no-undo.
      378     run grp-attr-value (
      379        input   buf_goods.grp-code
      380       ,input   'gds-grp-nabor':U
      381       ,input   0
      382       ,input   ""
      383       ,input   0
      384       ,output  v-value
      385       ,output  v-type       ) no-error .
      386       if error-status :error then return error .
      387     if v-value = "yes" then p-nabor = true  .
      388   end.
      389   end procedure.
      390   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   procedure lineattr-value :
      392     do
      393     on error undo, return error return-value
      394     :
      395       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      396       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      397       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      398       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      399       define output parameter p-type     as character no-undo .
      400       define buffer buf_doc-line-attr for ub.doc-line-attr .
      401       def var v-format         as character no-undo .
      402       def var v-fillin_width   as integer   no-undo .
      403       def var v-fillin_height  as integer   no-undo .
      404       def var v-label          as character no-undo .
      405       def var v-user-can-edit  as logical   no-undo .
      406       def var v-output-display as logical   no-undo .
      407       def var v-other          as character no-undo .
      408       run lineattr-code in this-procedure
      409         (input  p-code
      410         ,output p-type
      411         ,output v-format
      412         ,output v-fillin_width
      413         ,output v-fillin_height
      414         ,output v-label
      415         ,output v-user-can-edit
      416         ,output v-output-display
      417         ,output v-other
      418         ) no-error .
      419       if error-status :error then do:
      420         undo, return error return-value .
      421       end.
      422       find first buf_doc-line-attr no-lock
      423         where buf_doc-line-attr.doc-code  = p-doc-code
      424           and buf_doc-line-attr.gds-code  = p-gds-code
      425           and buf_doc-line-attr.attr-code = p-code
      426         no-error .
      427       if avail buf_doc-line-attr then do:
      428         assign
      429           p-value =  buf_doc-line-attr.attr-value
      430         .
      431       end.
      432       else do:
      433         assign
      434           p-value = if p-type = 'L':U then "no":U else ""
      435         .
      436       end.
      437     end.
      438   end procedure.
      439   procedure lineattr-write :
      440     do
      441     on error undo, return error return-value
      442     :
      443       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      444       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      445       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      446       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      447       define buffer buf_doc-line-attr for ub.doc-line-attr .
      448       def var v-type           as character no-undo .
      449       def var v-format         as character no-undo .
      450       def var v-fillin_width   as integer   no-undo .
      451       def var v-fillin_height  as integer   no-undo .
      452       def var v-label          as character no-undo .
      453       def var v-user-can-edit  as logical   no-undo .
      454       def var v-output-display as logical   no-undo .
      455       def var v-other          as character no-undo .
      456       run lineattr-code in this-procedure
      457         (input  p-code
      458         ,output v-type
      459         ,output v-format
      460         ,output v-fillin_width
      461         ,output v-fillin_height
      462         ,output v-label
      463         ,output v-user-can-edit
      464         ,output v-output-display
      465         ,output v-other
      466         ) no-error .
      467       if error-status :error then do:
      468         undo, return error return-value .
      469       end.
      470       find first buf_doc-line-attr exclusive-lock
      471         where buf_doc-line-attr.doc-code  = p-doc-code
      472           and buf_doc-line-attr.gds-code  = p-gds-code
      473           and buf_doc-line-attr.attr-code = p-code
      474         no-error .
      475       if not available buf_doc-line-attr then do:
      476         create buf_doc-line-attr .
      477         assign
      478           buf_doc-line-attr.doc-code  = p-doc-code
      479           buf_doc-line-attr.gds-code = p-gds-code
      480           buf_doc-line-attr.attr-code = p-code
      481         .
      482       end.
      483       assign
      484         buf_doc-line-attr.attr-value = p-value
      485       .
      486        release buf_doc-line-attr.
      487     end.
      488   end procedure.
      489   procedure lineattr-exist :
      490     do
      491     on error undo, return error return-value
      492     :
      493       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      494       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      495       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      496       define output parameter p-exist   as logical  no-undo .
      497       define buffer buf_doc-line-attr for ub.doc-line-attr .
      498       def var v-type           as character no-undo .
      499       def var v-format         as character no-undo .
      500       def var v-fillin_width   as integer   no-undo .
      501       def var v-fillin_height  as integer   no-undo .
      502       def var v-label          as character no-undo .
      503       def var v-user-can-edit  as logical   no-undo .
      504       def var v-output-display as logical   no-undo .
      505       def var v-other          as character no-undo .
      506       run lineattr-code in this-procedure
      507         (input  p-code
      508         ,output v-type
      509         ,output v-format
      510         ,output v-fillin_width
      511         ,output v-fillin_height
      512         ,output v-label
      513         ,output v-user-can-edit
      514         ,output v-output-display
      515         ,output v-other
      516         ) no-error .
      517       if error-status :error then do:
      518         undo, return error return-value .
      519       end.
      520       find first buf_doc-line-attr no-lock
      521         where buf_doc-line-attr.doc-code  = p-doc-code
      522           and buf_doc-line-attr.gds-code = p-gds-code
      523           and buf_doc-line-attr.attr-code = p-code
      524         no-error .
      525       if  available buf_doc-line-attr then do:
      526         p-exist = yes.
      527       end.
      528     end.
      529   end procedure.
      530   procedure lineattr-delete :
      531     do
      532     on error undo, return error return-value
      533     :
      534       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      535       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      536       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      537       define output parameter p-deleted  as logical no-undo.
      538       define buffer buf_doc-line-attr for ub.doc-line-attr .
      539       def var v-type           as character no-undo .
      540       def var v-format         as character no-undo .
      541       def var v-fillin_width   as integer   no-undo .
      542       def var v-fillin_height  as integer   no-undo .
      543       def var v-label          as character no-undo .
      544       def var v-user-can-edit  as logical   no-undo .
      545       def var v-output-display as logical   no-undo .
      546       def var v-other          as character no-undo .
      547       run lineattr-code in this-procedure
      548         (input  p-code
      549         ,output v-type
      550         ,output v-format
      551         ,output v-fillin_width
      552         ,output v-fillin_height
      553         ,output v-label
      554         ,output v-user-can-edit
      555         ,output v-output-display
      556         ,output v-other
      557         ) no-error .
      558       if error-status :error then do:
      559         undo, return error return-value .
      560       end.
      561       find first buf_doc-line-attr exclusive-lock
      562         where buf_doc-line-attr.doc-code  = p-doc-code
      563           and buf_doc-line-attr.gds-code  = p-gds-code
      564           and buf_doc-line-attr.attr-code = p-code
      565         no-error NO-WAIT.
      566       if not available buf_doc-line-attr then do:
      567         p-deleted = no.
      568       end.
      569       else do:
      570         delete buf_doc-line-attr.
      571         p-deleted = yes.
      572       end.
      573     end.
      574   end procedure.
      575   procedure lineattr-code :
      576     do on error undo, return error return-value
      577     :
      578       define input  parameter p-code           as character no-undo .
      579       define output parameter p-type           as character no-undo .
      580       define output parameter p-format         as character no-undo .
      581       define output parameter p-fillin_width   as integer   no-undo .
      582       define output parameter p-fillin_height  as integer   no-undo .
      583       define output parameter p-label          as character no-undo .
      584       define output parameter p-user-can-edit  as logical   no-undo .
      585       define output parameter p-output-display as logical   no-undo .
      586       define output parameter p-other          as character no-undo .
      587       case p-code :
      588               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      589               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      590               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      591               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      592               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      593               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      594               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      595               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      596               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      597               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      598               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      599         otherwise do:
      600           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      601         end.
      602       end.
      603     end.
      604   end procedure.
      605   procedure lineattr-value-flora-gds :
      606     do
      607     on error undo, return error return-value
      608     :
      609       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      610       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      611       define input  parameter p-prt-code    as integer   no-undo .
      612       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      613       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      614       define output parameter p-value       as    decimal   no-undo .
      615       define buffer buf_doc-line-attr for ub.doc-line-attr .
      616       find first buf_doc-line-attr no-lock
      617         where buf_doc-line-attr.doc-code  = p-doc-code
      618           and buf_doc-line-attr.gds-code  = p-gds-code
      619           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      620         no-error .
      621       if avail buf_doc-line-attr then do:
      622         assign
      623           p-value = decimal( buf_doc-line-attr.attr-value)
      624         .
      625       end.
      626       else do:
      627         assign
      628           p-value = 0
      629         .
      630       end.
      631     end.
      632   end procedure.
      633   procedure lineattr-write-flora-gds :
      634     do
      635     on error undo, return error return-value
      636     :
      637       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      638       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      639       define input parameter p-prt-code    as integer   no-undo .
      640       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      641       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      642       define input parameter p-value    as decimal   no-undo .
      643       define buffer buf_doc-line-attr for ub.doc-line-attr .
      644       find first buf_doc-line-attr exclusive-lock
      645         where buf_doc-line-attr.doc-code  = p-doc-code
      646           and buf_doc-line-attr.gds-code  = p-gds-code
      647           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      648         no-error .
      649       if not available buf_doc-line-attr then do:
      650         create buf_doc-line-attr .
      651         assign
      652           buf_doc-line-attr.doc-code  = p-doc-code
      653           buf_doc-line-attr.gds-code  = p-gds-code
      654           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      655         .
      656       end.
      657       assign
      658         buf_doc-line-attr.attr-value = string( p-value )
      659       .
      660     end.
      661   end procedure.
      662   procedure lineattr-delete-flora-gds :
      663     do
      664     on error undo, return error return-value
      665     :
      666       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      667       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      668       define input  parameter p-prt-code    as integer   no-undo .
      669       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      670       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      671       define output parameter p-deleted  as logical no-undo.
      672       define buffer buf_doc-line-attr for ub.doc-line-attr .
      673       find first buf_doc-line-attr exclusive-lock
      674         where buf_doc-line-attr.doc-code  = p-doc-code
      675           and buf_doc-line-attr.gds-code  = p-gds-code
      676           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      677         no-error NO-WAIT.
