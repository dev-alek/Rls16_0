      893   define variable v-account as integer init 0 no-undo .
      894   define variable v-account-lavel as character no-undo .
      895   define variable v-button-stop as logical no-undo .
      896   define variable v-kol-spice as integer no-undo .
      897   define variable v-kol-spice2 as integer no-undo .
      898   define variable v-kol-spice3 as integer no-undo .
      899   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      900   DEFINE BUTTON StopBtn AUTO-END-KEY
      901        LABEL "Стоп"
      902        SIZE 10 BY 1.
      903   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      904        LABEL "Обработано записей"
      905         VIEW-AS TEXT
      906        SIZE 14 BY .67 NO-UNDO.
      907   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      908         VIEW-AS TEXT
      909        SIZE 53.25 BY .67
      910        FGCOLOR 1  NO-UNDO.
      911   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      912         VIEW-AS TEXT
      913        SIZE 53.25 BY .67
      914        FGCOLOR 1  NO-UNDO.
      915   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      916         VIEW-AS TEXT
      917        SIZE 53.25 BY .67
      918        FGCOLOR 1  NO-UNDO.
      919   DEFINE RECTANGLE RECT-1
      920        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      921        SIZE 55.13 BY 4.46.
      922   DEFINE FRAME InfoFrame
      923        StopBtn AT ROW 4.25 COL 21.75
      924        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      925        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      926        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      927        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      928        RECT-1 AT ROW 1 COL 1
      929       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      930            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      931            TITLE "Процесс"
      932            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      933   define variable mFrameView      as logical   no-undo init yes.
      934     define variable mFramHandle as handle no-undo.
      935     mFramHandle = frame InfoFrame:handle.
      936     if  log-manager:logfile-name ne ?
      937     then DO:
      938         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      939         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      940         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      941     end.
      942     mFrameView = not session:batch-mode and mFramHandle:visible.
      943     if mFrameView
      944     then do:
      945       ASSIGN
      946          FRAME InfoFrame:HIDDEN                           = TRUE
      947          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      948     end.
      949   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      950   DO:
      951     IF not StopProcessing THEN
      952       Message "Вы действительно хотите прервать" SKIP
      953               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      954                 UPDATE StopProcessing.
      955     IF StopProcessing THEN do:
      956        if mFrameView
      957        then do:
      958           HIDE FRAME InfoFrame.
      959        end.
      960     End.
      961   END.
      962   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
      963     if  log-manager:logfile-name ne ?
      964     then DO:
      965         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      966     end.
      967     if not session:batch-mode then
      968     do:
      969       VIEW FRAME InfoFrame.
      970       mFrameView = true.
      971     end.
      972      v-button-stop = false .
      973         if mFrameView
      974         then do:
      975         if v-button-stop then view STOPBTN in frame InfoFrame.
      976                          else Hide STOPBTN in frame InfoFrame.
      977         end.
      978   define variable v-value       as character  no-undo.
      979   define variable v-type        as character  no-undo.
      980   define variable p-nabor       as logical    no-undo.
      981   ON WRITE OF ub.trn-doc  OVERRIDE DO: END.
      982   ON WRITE OF ub.doc-line OVERRIDE DO: END.
      983   ON WRITE OF ub.gds-dtl  OVERRIDE DO: END.
      984   define variable fl as logical   no-undo .
      985   define buffer b_trn-doc for trn-doc.
      986   define variable p-exist   as logical  no-undo .
      987   define variable i as integer   no-undo .
      988   for each shop no-lock :
      989   for each gds-obj exclusive-lock where gds-obj.obj-code = shop.obj-code and
      990                                         gds-obj.obj-type = 'маг':U   :
      991   find first goods no-lock where goods.gds-code = gds-obj.gds-code no-error .
      992   i = i + 1.
      993   IF ( i modulo v-account = 0 )  then DO:
      994    Assign
      995       v-kol-spice = (50 - LENGTH(goods.gds-name)) / 2
      996       RecordsString = fill(' ',v-kol-spice) + string(goods.gds-name)
      997       .
      998             if  log-manager:logfile-name ne ?
      999             then DO:
     1000                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1001             end.
     1002              if mFrameView
     1003              then do:
     1004               DISPLAY
     1005                 i @ RecordsDone
     1006                 RecordsString   @ RecordsString
     1007                 WITH FRAME InfoFrame.
     1008              end.
     1009   End.
     1010      if v-button-stop then  DO:
     1011            if mFrameView
     1012            then
     1013               PROCESS EVENTS.
     1014            IF StopProcessing THEN DO:
     1015            RETURN error.
     1016            End.
     1017      end.
     1018     p-nabor = false.
     1019     run grp-attr-value (
     1020        input   goods.grp-code
     1021       ,input   'gds-grp-nabor':U
     1022       ,input   0
     1023       ,input   ""
     1024       ,input   0
     1025       ,output  v-value
     1026       ,output  v-type       ) no-error .
     1027       if error-status :error then return error .
     1028       if v-value = "yes" then p-nabor = true  .
     1029       if p-nabor = false then next  .
     1030       fl = false .
     1031    for each  doc-line no-lock where
     1032               doc-line.obj-type  = gds-obj.obj-type  and
     1033               doc-line.obj-code  = gds-obj.obj-code  and
     1034               doc-line.artic     = gds-obj.artic     and
     1035               doc-line.prod-type = gds-obj.prod-type and
     1036               doc-line.prod-code = gds-obj.prod-code and
     1037               doc-line.status_    = 'накл':U :
     1038          find first trn-doc exclusive-lock  where trn-doc.doc-code = doc-line.doc-code no-error .
     1039          assign
     1040             trn-doc.is-flora = true .
     1041          .
     1042          if trn-doc.status_ = 'накл':U and trn-doc.flag_ = false  then do:
     1043             fl = true  .
     1044          end.
     1045          else do:
     1046            find first b_trn-doc exclusive-lock where b_trn-doc.out-code = trn-doc.doc-code no-error .
     1047            if available b_trn-doc then
     1048             assign
     1049                 b_trn-doc.is-flora = true .
     1050             .
     1051          end.
     1052    end.
     1053    if fl = true  then next.
     1054       for each   parts exclusive-lock where
     1055                   parts.obj-type  = gds-obj.obj-type
     1056               and parts.obj-code  = gds-obj.obj-code
     1057               and parts.artic     = gds-obj.artic
     1058               and parts.prod-type = gds-obj.prod-type
     1059               and parts.prod-code = gds-obj.prod-code :
     1060         delete parts.
     1061       end.
     1062     for each prt-obj exclusive-lock where
     1063         prt-obj.obj-type  = gds-obj.obj-type and
     1064         prt-obj.obj-code  = gds-obj.obj-code and
     1065         prt-obj.artic     = gds-obj.artic    and
     1066         prt-obj.prod-type = gds-obj.prod-type and
     1067         prt-obj.prod-code = gds-obj.prod-code  :
     1068       delete prt-obj .
     1069     end.
     1070     delete gds-obj .
     1071   end.
     1072   end.
     1073   for each trn-doc no-lock where trn-doc.status_= 'готов':U :
     1074      find first b_trn-doc exclusive-lock where b_trn-doc.out-code = trn-doc.doc-code no-error .
     1075      if error-status :error then next.
     1076      for each doc-line no-lock where doc-line.doc-code = trn-doc.doc-code:
     1077         find first goods no-lock where goods.artic = doc-line.artic          and
     1078                                        goods.prod-type = doc-line.prod-type  and
     1079                                        goods.prod-code = doc-line.prod-code  no-error .
     1080   IF ( i modulo v-account = 0 )  then DO:
     1081    Assign
     1082       v-kol-spice = (50 - LENGTH('по накладным в статусе ГОТОВ' )) / 2
     1083       RecordsString = fill(' ',v-kol-spice) + string('по накладным в статусе ГОТОВ' )
     1084       .
     1085    Assign
     1086       v-kol-spice = (50 - LENGTH(goods.gds-name)) / 2
     1087       RecordsString2 = fill(' ',v-kol-spice) + string(goods.gds-name)
     1088       .
     1089             if  log-manager:logfile-name ne ?
     1090             then DO:
     1091                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1092             end.
     1093              if mFrameView
     1094              then do:
     1095               DISPLAY
     1096                 i @ RecordsDone
     1097                 RecordsString   @ RecordsString
     1098                 RecordsString2  @ RecordsString2
     1099                 WITH FRAME InfoFrame.
     1100              end.
     1101   End.
     1102      if v-button-stop then  DO:
     1103            if mFrameView
     1104            then
     1105               PROCESS EVENTS.
     1106            IF StopProcessing THEN DO:
     1107            RETURN error.
     1108            End.
     1109      end.
     1110           p-nabor = false.
     1111           run grp-attr-value (
     1112             input   goods.grp-code
     1113             ,input   'gds-grp-nabor':U
     1114             ,input   0
     1115             ,input   ""
     1116             ,input   0
     1117             ,output  v-value
     1118             ,output  v-type       ) no-error .
     1119             if error-status :error then return error .
     1120             if v-value = "yes" then p-nabor = true  .
     1121             if p-nabor = false then next  .
     1122             if b_trn-doc.is-flora <> true then
     1123                 assign
     1124                     b_trn-doc.is-flora = true .
     1125                 .
     1126           run lineattr-exist (
     1127        input  b_trn-doc.doc-code ,
     1128        input  goods.gds-code     ,
     1129        input 'flora_ps':U,
     1130        output p-exist  ).
     1131             if p-exist = false then do:
     1132                 run lineattr-write (
     1133                     input  b_trn-doc.doc-code ,
     1134                     input  goods.gds-code     ,
     1135                     input 'flora_ps':U,
     1136                     input "" ).
     1137             end.
     1138       end.
     1139   end.
     1140   for each trn-doc exclusive-lock where trn-doc.status_= 'запрос':U
     1141                         and trn-doc.ext-doc-type = 'ee':U
     1142   :
     1143      for each doc-line no-lock where doc-line.doc-code = trn-doc.doc-code:
     1144         find first goods no-lock where goods.artic = doc-line.artic          and
     1145                                        goods.prod-type = doc-line.prod-type  and
     1146                                        goods.prod-code = doc-line.prod-code  no-error .
     1147   IF ( i modulo v-account = 0 )  then DO:
     1148    Assign
     1149       v-kol-spice = (50 - LENGTH('по накладным в статусе ЗАПРОС')) / 2
     1150       RecordsString = fill(' ',v-kol-spice) + string('по накладным в статусе ЗАПРОС')
     1151       .
     1152    Assign
     1153       v-kol-spice = (50 - LENGTH(goods.gds-name)) / 2
     1154       RecordsString2 = fill(' ',v-kol-spice) + string(goods.gds-name)
     1155       .
     1156             if  log-manager:logfile-name ne ?
     1157             then DO:
     1158                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1159             end.
     1160              if mFrameView
     1161              then do:
     1162               DISPLAY
     1163                 i @ RecordsDone
     1164                 RecordsString   @ RecordsString
     1165                 RecordsString2  @ RecordsString2
     1166                 WITH FRAME InfoFrame.
     1167              end.
     1168   End.
     1169      if v-button-stop then  DO:
     1170            if mFrameView
     1171            then
     1172               PROCESS EVENTS.
     1173            IF StopProcessing THEN DO:
     1174            RETURN error.
     1175            End.
     1176      end.
     1177           p-nabor = false.
     1178           run grp-attr-value (
     1179             input   goods.grp-code
     1180             ,input   'gds-grp-nabor':U
     1181             ,input   0
     1182             ,input   ""
     1183             ,input   0
     1184             ,output  v-value
     1185             ,output  v-type       ) no-error .
     1186             if error-status :error then return error .
     1187             if v-value = "yes" then p-nabor = true  .
     1188             if p-nabor = false then next  .
     1189             assign
     1190                 trn-doc.is-flora = true .
     1191             .
     1192       end.
     1193   end.
     1194   IF ( i modulo v-account = 0 )  then DO:
     1195    Assign
     1196       v-kol-spice = (50 - LENGTH('проверка накладных')) / 2
     1197       RecordsString = fill(' ',v-kol-spice) + string('проверка накладных')
     1198       .
     1199             if  log-manager:logfile-name ne ?
     1200             then DO:
     1201                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1202             end.
     1203              if mFrameView
     1204              then do:
     1205               DISPLAY
     1206                 i @ RecordsDone
     1207                 RecordsString   @ RecordsString
     1208                 WITH FRAME InfoFrame.
     1209              end.
     1210   End.
     1211      if v-button-stop then  DO:
     1212            if mFrameView
     1213            then
     1214               PROCESS EVENTS.
     1215            IF StopProcessing THEN DO:
     1216            RETURN error.
     1217            End.
     1218      end.
     1219   for each trn-doc exclusive-lock where trn-doc.status_<> 'готов':U
     1220                         and trn-doc.ext-doc-type = 'ee':U
     1221   :
     1222      find first b_trn-doc no-lock  where b_trn-doc.doc-code = trn-doc.out-code
     1223                                      and b_trn-doc.status_  = 'готов':U   no-error .
     1224      if error-status :error then next.
     1225             assign
     1226                 trn-doc.is-flora = true .
     1227             .
     1228   end.
     1229   for each trn-doc  exclusive-lock  where trn-doc.status_= 'готов':U
     1230   :
     1231             assign
     1232                  trn-doc.is-flora = true .
     1233             .
     1234     find first b_trn-doc no-lock  where b_trn-doc.out-code = trn-doc.doc-code no-error .
     1235      if available b_trn-doc then do:
     1236         for each doc-line no-lock where doc-line.doc-code = trn-doc.doc-code :
     1237         find first goods no-lock where goods.artic = doc-line.artic          and
     1238                                        goods.prod-type = doc-line.prod-type  and
     1239                                        goods.prod-code = doc-line.prod-code  no-error .
     1240             run lineattr-exist (
     1241             input  b_trn-doc.doc-code  ,
     1242             input  goods.gds-code      ,
     1243             input 'flora_ps':U ,
     1244             output p-exist  ).
     1245                 if p-exist = false then do:
     1246                     run lineattr-write (
     1247                         input  b_trn-doc.doc-code ,
     1248                         input  goods.gds-code     ,
     1249                         input 'flora_ps':U,
     1250                         input "" ).
     1251                 end.
     1252         end.
     1253       end.
     1254   end.
     1255   for each trn-doc exclusive-lock where trn-doc.status_= 'отказ':U and trn-doc.is-flora = false
     1256   :
     1257             assign
     1258                 trn-doc.is-flora = true .
     1259             .
     1260   end.
     1261   if mFrameView
     1262   then do:
     1263      HIDE FRAME InfoFrame.
     1264   end.
     1265   message "все" .
