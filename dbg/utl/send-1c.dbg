        1   DEFINE NEW GLOBAL SHARED VARIABLE appSrvUtils AS HANDLE                NO-UNDO.
        2   IF NOT VALID-HANDLE(appSrvUtils) THEN
        3     RUN adecomm/as-utils.w PERSISTENT SET appSrvUtils.
        4   THIS-PROCEDURE:ADD-SUPER-PROCEDURE(appSrvUtils).
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date: $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Повторная выгрузка данных для 1С ERP".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new shared stream vProtTest.
       66   define new shared variable testId as rowid no-undo.
       67   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO .
       68   DEFINE BUTTON b-close AUTO-END-KEY
       69        LABEL "Отменить"
       70        SIZE 15 BY 1.13.
       71   DEFINE BUTTON b-start
       72        LABEL "Запустить"
       73        SIZE 15 BY 1.13.
       74   DEFINE RECTANGLE RECT-3
       75        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
       76        SIZE 54 BY 11.75.
       77   DEFINE VARIABLE T-1 AS LOGICAL INITIAL no
       78        LABEL "Документа (накл., инв., перес.)"
       79        VIEW-AS TOGGLE-BOX
       80        SIZE 38 BY .83 NO-UNDO.
       81   DEFINE VARIABLE T-2 AS LOGICAL INITIAL no
       82        LABEL "Смены"
       83        VIEW-AS TOGGLE-BOX
       84        SIZE 38 BY .83 NO-UNDO.
       85   DEFINE VARIABLE T-3 AS LOGICAL INITIAL no
       86        LABEL "Сверки"
       87        VIEW-AS TOGGLE-BOX
       88        SIZE 38 BY .83 NO-UNDO.
       89   DEFINE VARIABLE T-4 AS LOGICAL INITIAL no
       90        LABEL "Переоценки"
       91        VIEW-AS TOGGLE-BOX
       92        SIZE 38 BY .83 NO-UNDO.
       93   DEFINE VARIABLE T-5 AS LOGICAL INITIAL no
       94        LABEL "Фин.документа"
       95        VIEW-AS TOGGLE-BOX
       96        SIZE 38 BY .83 NO-UNDO.
       97   DEFINE VARIABLE T-6 AS LOGICAL INITIAL no
       98        LABEL "Документа производства"
       99        VIEW-AS TOGGLE-BOX
      100        SIZE 38 BY .83 NO-UNDO.
      101   DEFINE VARIABLE T-7 AS LOGICAL INITIAL no
      102        LABEL "Документа электронного документооборота"
      103        VIEW-AS TOGGLE-BOX
      104        SIZE 42.5 BY .83 NO-UNDO.
      105   DEFINE VARIABLE T-8 AS LOGICAL INITIAL no
      106        LABEL "Общая выгрузка"
      107        VIEW-AS TOGGLE-BOX
      108        SIZE 38 BY .83 NO-UNDO.
      109   DEFINE VARIABLE T-9 AS LOGICAL INITIAL no
      110        LABEL "Текущая топология"
      111        VIEW-AS TOGGLE-BOX
      112        SIZE 42.5 BY .83 NO-UNDO.
      113   DEFINE VARIABLE T-10 AS LOGICAL INITIAL no
      114        LABEL "Контрольная плотность НП"
      115        VIEW-AS TOGGLE-BOX
      116        SIZE 42.5 BY .83 NO-UNDO.
      117   DEFINE FRAME gDialog
      118        b-start AT ROW 1.25 COL 2 WIDGET-ID 8
      119        b-close AT ROW 1.25 COL 42
      120        T-1 AT ROW 4 COL 13.5 WIDGET-ID 54
      121        T-2 AT ROW 5 COL 13.5 WIDGET-ID 56
      122        T-3 AT ROW 6 COL 13.5 WIDGET-ID 58
      123        T-4 AT ROW 7 COL 13.5 WIDGET-ID 60
      124        T-5 AT ROW 8 COL 13.5 WIDGET-ID 62
      125        T-6 AT ROW 9 COL 13.5 WIDGET-ID 64
      126        T-7 AT ROW 10 COL 13.5 WIDGET-ID 68
      127        T-9 AT ROW 11 COL 13.5 WIDGET-ID 70
      128        T-10 AT ROW 12 COL 13.5 WIDGET-ID 70
      129        T-8 AT ROW 13 COL 13.5 WIDGET-ID 66
      130        "Выгрузка:" VIEW-AS TEXT
      131             SIZE 9.5 BY .67 AT ROW 3 COL 4.5 WIDGET-ID 52
      132        RECT-3 AT ROW 3.25 COL 3 WIDGET-ID 50
      133        SPACE(2.12) SKIP(1.03)
      134       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      135            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      136            TITLE "Повторная выгрузка данных для 1С ERP"
      137            CANCEL-BUTTON b-close WIDGET-ID 100.
      138   ASSIGN
      139          FRAME gDialog:SCROLLABLE       = FALSE
      140          FRAME gDialog:HIDDEN           = TRUE.
      141   ON WINDOW-CLOSE OF FRAME gDialog
      142   DO:
      143     APPLY "END-ERROR":U TO SELF.
      144   END.
      145   ON CHOOSE OF b-start IN FRAME gDialog
      146   DO:
      147     ASSIGN
      148     t-1
      149     t-2
      150     t-3
      151     t-4
      152     t-5
      153     t-6
      154     t-7
      155     t-8
      156     t-9
      157     t-10
      158       .
      159   if t-1 then do:
      160   run  utl/send1c.p.
      161   end.
      162   if t-2 then do:
      163     run utl/send2c.p (parparentproc).
      164   end.
      165   if t-3 then do:
      166     run utl/send3c.p.
      167   end.
      168   if t-4 then do:
      169     run utl/send4c.p.
      170   end.
      171   if t-5 then do:
      172     run utl/send5c.p.
      173   end.
      174   if t-6 then do:
      175     run utl/send6c.p.
      176   end.
      177   if t-7 then do:
      178     run utl/send7c.p.
      179   end.
      180   if t-9 then do:
      181     run utl/send9c.p.
      182   end.
      183   if t-10 then do:
      184     run utl/send10c.p .
      185   end.
      186   if t-8 then do:
      187     run utl/all-send1c.p (parparentproc).
      188   end.
      189   END.
      190   ON VALUE-CHANGED OF T-1 IN FRAME gDialog
      191   DO:
      192     assign
      193     t-1
      194     .
      195   END.
      196   ON VALUE-CHANGED OF T-2 IN FRAME gDialog
      197   DO:
      198     assign
      199     t-2
      200     .
      201   END.
      202   ON VALUE-CHANGED OF T-3 IN FRAME gDialog
      203   DO:
      204     assign
      205     t-3
      206     .
      207   END.
      208   ON VALUE-CHANGED OF T-4 IN FRAME gDialog
      209   DO:
      210     assign
      211     t-4
      212     .
      213   END.
      214   ON VALUE-CHANGED OF T-5 IN FRAME gDialog
      215   DO:
      216     assign
      217     t-5
      218     .
      219   END.
      220   ON VALUE-CHANGED OF T-6 IN FRAME gDialog
      221   DO:
      222     assign
      223     t-6
      224     .
      225   END.
      226   ON VALUE-CHANGED OF T-7 IN FRAME gDialog
      227   DO:
      228     assign
      229     t-7
      230     .
      231   END.
      232   ON VALUE-CHANGED OF T-8 IN FRAME gDialog
      233   DO:
      234     assign
      235     t-8
      236     .
      237   END.
      238   ON VALUE-CHANGED OF T-9 IN FRAME gDialog
      239   DO:
      240     assign
      241     t-9
      242     .
      243   END.
      244   ON VALUE-CHANGED OF T-10 IN FRAME gDialog
      245   DO:
      246     assign
      247     t-10
      248     .
      249   END.
      250   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME gDialog:PARENT eq ?
      251   THEN FRAME gDialog:PARENT = ACTIVE-WINDOW.
      252   MAIN-BLOCK:
      253   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      254      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      255     RUN enable_UI.
      256     WAIT-FOR GO OF FRAME gDialog.
      257   END.
      258   RUN disable_UI.
      259   PROCEDURE disable_UI :
      260     HIDE FRAME gDialog.
      261   END PROCEDURE.
      262   PROCEDURE enable_UI :
      263     DISPLAY T-1 T-2 T-3 T-4 T-5 T-6 T-7 T-9 T-10 T-8
      264         WITH FRAME gDialog.
      265     ENABLE RECT-3 b-start b-close T-1 T-2 T-3 T-4 T-5 T-6 T-7 T-9 T-10 T-8
      266         WITH FRAME gDialog.
      267     VIEW FRAME gDialog.
      268   END PROCEDURE.
