      796   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   function octal-to-char return character
      798   ( p-string as character ) :
      799     def var v-asc     as integer no-undo .
      800     def var v-new-asc as integer no-undo .
      801     def var ind       as integer no-undo .
      802     if length(p-string) <> 3 then do:
      803       return ? .
      804     end.
      805     assign
      806       v-asc = 0
      807     .
      808     do ind = 1 to length(p-string)
      809     :
      810       assign
      811         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      812       .
      813       if v-new-asc < 0 or v-new-asc >= 8 then do:
      814         return ? .
      815       end.
      816       assign
      817         v-asc = v-asc * 8 + v-new-asc
      818       .
      819     end.
      820     return chr(v-asc) .
      821   end function .
      822   function char-to-octal return character
      823   ( p-chr as character ) :
      824     def var v-asc    as integer   no-undo .
      825     def var ind      as integer   no-undo .
      826     def var v-string as character no-undo .
      827     if length(p-chr) <> 1 then do:
      828       return ? .
      829     end.
      830     assign
      831       v-asc    = asc(p-chr)
      832       v-string = ""
      833     .
      834     do ind = 1 to 3
      835     :
      836       assign
      837         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      838       .
      839       assign
      840         v-asc = truncate(v-asc / 8, 0)
      841       .
      842     end.
      843     return v-string .
      844   end.
      845   function str-encode return character
      846   (   p-init-string       as character
      847     , p-encode-char       as character
      848     , p-special-char-list as character
      849   ) :
      850     def var p-encode-string as character no-undo .
      851     def var ind                as integer no-undo .
      852     def var v-num-special-char as integer no-undo .
      853     def var v-special-char     as character no-undo .
      854     if p-encode-char = ?
      855     or p-encode-char = "" then do:
      856       assign
      857         p-encode-char = "~~"
      858       .
      859     end.
      860     if p-init-string = ? then do:
      861       return "?" .
      862     end.
      863     if p-init-string = "?" then do:
      864       return p-encode-char + char-to-octal("?") .
      865     end.
      866     assign
      867       v-num-special-char = length(p-special-char-list)
      868       p-encode-string    = replace(p-init-string
      869                                   ,p-encode-char
      870                                   ,p-encode-char + char-to-octal(p-encode-char)
      871                                   )
      872     .
      873     do ind = 1 to v-num-special-char
      874     :
      875       assign
      876         v-special-char = substring(p-special-char-list, ind, 1)
      877       .
      878       if v-special-char <> p-encode-char then do:
      879         assign
      880           p-encode-string = replace (p-encode-string
      881                                     ,v-special-char
      882                                     ,p-encode-char + char-to-octal(v-special-char)
      883                                     )
      884         .
      885       end.
      886     end.
      887     return p-encode-string .
      888   end.
      889   function str-decode returns character
      890     (p-init-string   as character
      891     ,p-encode-char   as character
      892     ) :
      893     def var p-decode-string as character no-undo .
      894     def var ind                       as integer no-undo .
      895     def var v-num-entries-init-string as integer no-undo .
      896     def var v-sub-phrase              as character no-undo .
      897     def var v-special-char            as character no-undo .
      898     if p-encode-char = ?
      899     or p-encode-char = "" then do:
      900       assign
      901         p-encode-char = "~~"
      902       .
      903     end.
      904     if p-init-string = "?" then do:
      905       return ? .
      906     end.
      907     assign
      908       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      909     .
      910     if v-num-entries-init-string > 1 then do:
      911       assign
      912         p-decode-string = entry(1, p-init-string, p-encode-char)
      913       .
      914       do ind = 2 to v-num-entries-init-string
      915       :
      916         assign
      917           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      918         .
      919         assign
      920           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      921         .
      922         if v-special-char <> ? then do:
      923           assign
      924             p-decode-string = p-decode-string
      925                             + v-special-char
      926                             + substring(v-sub-phrase, 4)
      927           .
      928         end.
      929         else do:
      930           assign
      931             p-decode-string = p-decode-string
      932                             + p-encode-char
      933                             + v-sub-phrase
      934           .
      935         end.
      936       end.
      937     end.
      938     else do:
      939       assign
      940         p-decode-string = p-init-string
      941       .
      942     end.
      943     return p-decode-string .
      944   end.
      945   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      947   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      948     field cst-code                like ub.trn-doc.cst-code
      949     field part-code               like ub.parts.part-code
      950     .
      951   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      952   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      953   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      954   function hvrdtax return logical (input parrecid as recid):
      955   define variable varresult as logical no-undo.
      956   run hvrdtax-proc (input parrecid, output varresult).
      957   return varresult.
      958   end function.
      959   procedure hvrdtax-proc:
      960   define input  parameter parrecid  as recid   no-undo.
      961   define output parameter parresult as logical no-undo.
      962   define buffer bf_goods for ub.goods.
      963   define buffer bf_units for ub.units.
      964   define buffer rt_tax   for ub.tax.
      965   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      966   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      967   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      968   if available rt_tax and
      969       can-find(first ub.tax-units No-LOCK WHERE
      970                      ub.tax-units.tax-code = rt_tax.tax-code AND
      971                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      972                                                       else assign parresult = no.
      973   end procedure.
      974   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      975   define new global shared variable g#lib-calc as handle no-undo .
      976   procedure plgdsfnd :
      977     define input  parameter p-chk-and-chs    as logical               no-undo .
      978     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      979     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      980     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      981     define output parameter p-reserv-pl-code as   logical             no-undo .
      982     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      983     define buffer buf_goods         for ub.goods .
      984     define buffer buf_pl-gds        for ub.pl-gds .
      985     define buffer buf_second_pl-gds for ub.pl-gds .
      986     find first buf_goods no-lock where
      987                buf_goods.gds-code = p-gds-code no-error .
      988     if not available buf_goods
      989     then do:
      990       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      991     end.
      992   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      994     (input  p-obj-type
      995     ,input  p-obj-code
      996     ,input  buf_goods.artic
      997     ,input  buf_goods.prod-type
      998     ,input  buf_goods.prod-code
      999     ,input  'place-rsrv=request'
     1000     ,output p-reserv-pl-code
     1001     ) no-error .
     1002     if error-status :error
     1003     then do:
     1004       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1005     end.
     1006     if p-reserv-pl-code = no
     1007     then do:
     1008       return .
     1009     end.
     1010     if p-chk-and-chs <> yes
     1011     then do:
     1012       return .
     1013     end.
     1014     find first buf_pl-gds no-lock where
     1015                buf_pl-gds.obj-type = p-obj-type and
     1016                buf_pl-gds.obj-code = p-obj-code and
     1017                buf_pl-gds.gds-code = p-gds-code no-error .
     1018     if not available buf_pl-gds
     1019     then do:
     1020       return error "К товару не привязано ни одного места хранения" .
     1021     end.
     1022     find first buf_second_pl-gds no-lock where
     1023                buf_second_pl-gds.obj-type  = p-obj-type          and
     1024                buf_second_pl-gds.obj-code  = p-obj-code          and
     1025                buf_second_pl-gds.gds-code  = p-gds-code          and
     1026                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1027     if not available buf_second_pl-gds
     1028     then do:
     1029       assign
     1030         p-pl-code = buf_pl-gds.pl-code
     1031       .
     1032     end.
     1033     else do:
     1034       if not valid-handle( parparentproc )
     1035       then do:
     1036         return error "Не выбрано место хранения " + chr(10) .
     1037       end.
     1038       run str/plgdssel.p
     1039         (
     1040            input parparentproc
     1041         ,  input p-obj-type
     1042         ,  input p-obj-code
     1043         ,  input p-gds-code
     1044         , output p-pl-code
     1045         ) no-error .
     1046       if error-status :error
     1047       then do:
     1048         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1049                                , 'plgdssel.p':U
     1050                                , chr(10)
     1051                                , error-status :get-message( 1 )
     1052                                , return-value
     1053                                ) .
     1054       end.
     1055       if p-pl-code = ? or
     1056          p-pl-code = 0
     1057       then do:
     1058         return error "Не выбрано место хранения " + chr(10) .
     1059       end.
     1060     end.
     1061   end procedure.
     1062   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1063   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1064   define temp-table tt-doc-line no-undo like ub.doc-line
     1065   field cst-code like ub.trn-doc.cst-code
     1066   .
     1067   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1068   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1069   define temp-table tt-parts    no-undo like ub.parts.
     1070   procedure lib-trn_copy-inqu :
     1071   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1072   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1073   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1074   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1075   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1076   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1077   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1078   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1079   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1080   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1081   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1082   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1083   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1084   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1085   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1086   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1087   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1088   define input parameter parinp-discnt-type as   logical                no-undo.
     1089   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1090   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1091   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1092   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1093   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1094   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1095   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1096   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1097   define input parameter table for tt-doc-line.
     1098   define input parameter table for tt-gds-dtl.
     1099   define input parameter table for tt-parts.
     1100   define input parameter paruse-parts       as   logical                no-undo.
     1101   define input parameter parall-qnty        as   logical                no-undo.
     1102   define input parameter parfix-price       as   logical                no-undo.
     1103   define buffer crt_trn-doc  for ub.trn-doc.
     1104   define buffer crt_goods    for ub.goods.
     1105   define buffer crt_doc-line for ub.doc-line.
     1106   define buffer crt_gds-dtl  for ub.gds-dtl.
     1107   define variable end-price    as   logical              no-undo.
     1108   define variable real-type    like ub.goods.gds-type    no-undo.
     1109   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1110   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1111   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1112   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1113   define variable g-log        as   logical              no-undo.
     1114   define variable mem-qnty like chg-qnty no-undo.
     1115   define variable dflt-cd as character no-undo .
     1116   c-l:
     1117   do on error undo, return error return-value :
     1118   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1119   assign
     1120       paruse-parts = false
     1121       .
     1122   assign
     1123     end-price = no.
     1124   if parinp-discnt-type = yes and
     1125      parinp-discnt-pc   = 0   and
     1126      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1127      then do:
     1128     assign
     1129       crt_trn-doc.tot-calc    = partot-calc
     1130       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1131       crt_trn-doc.discnt-type = pardiscnt-type.
     1132   end.
     1133   if parinp-agnt = ? then do:
     1134     assign
     1135       crt_trn-doc.agnt = paragnt.
     1136   end.
     1137   if parinp-boss = ? then do:
     1138     assign
     1139       crt_trn-doc.boss = parboss.
     1140   end.
     1141   if parinp-wrkr = ? then do:
     1142     assign
     1143       crt_trn-doc.wrkr = parwrkr.
     1144   end.
     1145   if parinp-base-rate  = ? then do:
     1146     assign
     1147       crt_trn-doc.base-rate  = parbase-rate.
     1148   end.
     1149   if parinp-base-scale = ? then do:
     1150     assign
     1151       crt_trn-doc.base-scale = parbase-scale.
     1152   end.
     1153   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1154   if available tt-doc-line then do:
     1155     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1156                      and crt_goods.prod-type = tt-doc-line.prod-type
     1157                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1158     if crt_goods.gds-type = 'у':U and
     1159        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1160       return error "В данный документ нельзя копировать услуги.".
     1161     end.
     1162     assign
     1163       real-type = crt_goods.gds-type.
     1164     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1165     if available crt_doc-line then do:
     1166       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1167                        and crt_goods.prod-type = crt_doc-line.prod-type
     1168                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1169       if crt_goods.gds-type <> real-type then do:
     1170         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1171       end.
     1172     end.
     1173     else do:
     1174       assign
     1175         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1176     end.
     1177   end.
     1178   r-l:
     1179   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1180     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1181                      and crt_goods.prod-type = tt-doc-line.prod-type
     1182                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1183   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1184      (
     1185       input crt_trn-doc.doc-code
     1186      ,input crt_trn-doc.obj-type
     1187      ,input crt_trn-doc.obj-code
     1188      ,input crt_goods.artic
     1189      ,input crt_goods.prod-type
     1190      ,input crt_goods.prod-code
     1191      ,input crt_goods.gds-name
     1192      ,input crt_goods.prt-root
     1193      ,input ?
     1194      ,input ?
     1195      ,input parcash-pay      ) no-error.
     1196     if error-status:error then do:
     1197       undo c-l, return error return-value.
     1198     end.
     1199     if return-value = "next" then do:
     1200       next r-l.
     1201     end.
     1202     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1203                                   crt_doc-line.artic     = crt_goods.artic      and
     1204                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1205                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1206     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1207                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1208                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1209                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1210                               break by tt-gds-dtl.artic
     1211                                     by tt-gds-dtl.prod-type
     1212                                     by tt-gds-dtl.prod-code
     1213                               :
     1214   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1215     ( input  tt-gds-dtl.artic
     1216      ,input  tt-gds-dtl.prod-type
     1217      ,input  tt-gds-dtl.prod-code
     1218      ,input  tt-gds-dtl.prt-code
     1219      ,input  tt-doc-line.obj-type
     1220      ,input  tt-doc-line.obj-code
     1221      ,output legal-node
     1222     ) no-error .
     1223       if error-status:error then do:
     1224          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1225       end.
     1226   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1227     ( input crt_trn-doc.obj-code
     1228      ,input crt_trn-doc.obj-type
     1229      ,input crt_trn-doc.doc-code
     1230      ,input crt_goods.artic
     1231      ,input crt_goods.prod-code
     1232      ,input crt_goods.prod-type
     1233      ,input legal-node
     1234      ,input yes
     1235     ) no-error .
     1236        if error-status:error then do:
     1237           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1238        end.
     1239        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1240                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1241                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1242                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1243                                     crt_gds-dtl.prt-code  = legal-node.
     1244       assign
     1245         crt_gds-dtl.ov             = parfix-price
     1246         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1247         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1248         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1249         .
     1250       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1251         assign
     1252           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1253           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1254           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1255           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1256       end.
     1257       if end-price then do:
     1258         assign
     1259           crt_gds-dtl.ov             = yes
     1260           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1261           crt_gds-dtl.discnt-base    = 0
     1262           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1263           crt_gds-dtl.discnt-rubl    = 0
     1264           crt_gds-dtl.discnt-pc      = 0
     1265           crt_gds-dtl.discnt-type    = yes.
     1266       end.
     1267   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1268   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1269     ( input recid(crt_gds-dtl)
     1270     , input no
     1271     , input ?
     1272     ) no-error.
     1273           if error-status:error then do:
     1274             undo c-l, return error return-value.
     1275           end.
     1276       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1277          crt_gds-dtl.ov then do:
     1278         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1279       end.
     1280       if paruse-parts then do:
     1281          if first-of (tt-gds-dtl.prod-code) then do:
     1282            for each tt-parts :
     1283              assign
     1284                chg-qnty = tt-parts.fact-qnty
     1285                mem-qnty = chg-qnty.
     1286              assign
     1287              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1288              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1289            end.
     1290            assign
     1291              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1292              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1293            assign
     1294              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1295              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1296            if crt_gds-dtl.doc-qnty = 0 then do:
     1297              delete crt_gds-dtl.
     1298            end.
     1299          end.
     1300       end.
     1301       else do:
     1302         assign
     1303           chg-qnty = tt-gds-dtl.fact-qnty
     1304           mem-qnty = chg-qnty.
     1305         assign
     1306           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1307           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1308           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1309           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1310         assign
     1311         varchg-qnty  = varchg-qnty  + chg-qnty
     1312         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1313         if crt_gds-dtl.doc-qnty = 0 then do:
     1314           delete crt_gds-dtl.
     1315         end.
     1316       end.
     1317     end.
     1318     if crt_doc-line.doc-qnty = 0 then do:
     1319       delete crt_doc-line.
     1320     end.
     1321   end.
     1322   end.
     1323   end procedure.
     1324   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1325     define variable v-cntxt-db-num        as integer   no-undo .
     1326     define variable v-cntxt-userid        as character no-undo .
     1327     define variable v-cntxt-level         as character no-undo .
     1328     define variable v-cntxt-host-code-obj as integer   no-undo .
     1329     define variable v-cntxt-obj-type      as character no-undo .
     1330     define variable v-cntxt-obj-code      as integer   no-undo .
     1331     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1332     define variable v-cntxt-is-admin      as logical   no-undo .
     1333   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1334     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     1335     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     1336     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     1337     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     1338     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     1339     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     1340     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     1341     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     1342     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     1343     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     1344     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     1345     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     1346     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     1347     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     1348     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     1349     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     1350     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     1351     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     1352     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     1353     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     1354     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     1355     define variable v-cntxp-conf-par        as   character                no-undo.
     1356     define variable v-cntxp-par-type        as   character                no-undo.
     1357     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     1358     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     1359     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     1360     define variable v-cntxp-db-num          as integer   no-undo .
     1361     define variable v-cntxp-userid          as character no-undo .
     1362     define variable v-cntxp-level           as character no-undo .
     1363     define variable v-cntxp-db-num-obj      as integer   no-undo .
     1364     define variable v-cntxp-is-admin        as logical   no-undo .
     1365     define buffer bf-cntxp_store for ub.store.
     1366     define buffer bf-cntxp_shop  for ub.shop.
     1367     define buffer bf-cntxp_sysconf for ub.sysconf.
     1368   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
     1369   procedure who-cli-ora :
     1370   define input  parameter p-cli-code-ora as integer   no-undo .
     1371   define output parameter p-cli-type as character no-undo .
     1372   define output parameter p-cli-code as integer   no-undo .
     1373     do
     1374     on error undo, return error return-value
     1375     :
     1376     if length (string(p-cli-code-ora))  <> 9 then do:
     1377        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
     1378     end.
     1379     if string(p-cli-code-ora) begins "1" or
     1380        string(p-cli-code-ora) begins "2" or
     1381        string(p-cli-code-ora) begins "4" then do:
     1382         p-cli-type = 'орг':U .
     1383         p-cli-code = p-cli-code-ora  .
     1384     end.
     1385     else do:
     1386       if string(p-cli-code-ora) begins "3" then do:
     1387         p-cli-type = 'чел':U .
     1388         p-cli-code = p-cli-code-ora  .
     1389       end.
     1390       else do:
     1391          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
     1392       end.
     1393     end.
     1394     define buffer buf_clients for ub.clients  .
     1395     find first buf_clients no-lock where
     1396                buf_clients.obj-type = p-cli-type and
     1397                buf_clients.obj-code = p-cli-code
     1398                no-error .
     1399         if error-status :error then do:
     1400             return error substitute
     1401             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
     1402                 p-cli-code-ora ,
     1403                 p-cli-type ,
     1404                 p-cli-code ) .
     1405         end.
     1406         if ora-icli_ver-stts-client then do:
     1407             if buf_clients.stts > 0 then do:
     1408                 return error substitute
     1409                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
     1410                     p-cli-code-ora ,
     1411                     p-cli-type ,
     1412                     p-cli-code ) .
     1413             end.
     1414         end.
     1415     end.
     1416   end procedure.
     1417   procedure ora-ver-goods :
     1418   define input  parameter p-gds-code as integer   no-undo .
     1419   define buffer buf_goods for ub.goods  .
     1420   define variable my-message as character no-undo .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424           find first buf_goods no-lock where
     1425                      buf_goods.gds-code = p-gds-code no-error .
     1426               if error-status :error then do:
     1427                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
     1428                   undo, return error my-message.
     1429               end.
     1430             if buf_goods.stts > 0 then do:
     1431               assign
     1432                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
     1433                 undo, return error my-message.
     1434             end.
     1435     end.
     1436   end procedure.
     1437   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1438   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1439   procedure gen-key-rec :
     1440     define input  parameter p-tbl-name    as character no-undo.
     1441     define input  parameter p-bh_tbl-name as handle    no-undo.
     1442     define output parameter p-key-rec     as character no-undo.
     1443     do
     1444     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1445     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1446     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1447     :
     1448       define variable fh               as handle    no-undo .
     1449       define variable v-ok             as logical   no-undo .
     1450       define variable v-inform         as character no-undo .
     1451       define variable v-ind            as integer   no-undo .
     1452       define variable v-idx-field-qnty as integer   no-undo .
     1453       if p-tbl-name = ?
     1454         or p-tbl-name = "":U
     1455       then do:
     1456         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info14 ).
     1457       end.
     1458       if not p-bh_tbl-name:available then do:
     1459         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info14, p-tbl-name ).
     1460       end.
     1461       assign
     1462         p-key-rec = p-tbl-name
     1463         v-inform  = p-bh_tbl-name:index-information(1)
     1464         v-ind     = 2
     1465       .
     1466       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1467       on error undo, return error
     1468       :
     1469         assign
     1470           v-inform = p-bh_tbl-name:index-information( v-ind )
     1471           v-ind    = v-ind + 1
     1472         .
     1473       end.
     1474       if v-inform = ?
     1475         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1476         or entry( 3, v-inform, ",":U ) <> "1":U
     1477       then do:
     1478         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, p-tbl-name ).
     1479       end.
     1480       else do:
     1481         assign
     1482           v-idx-field-qnty = num-entries( v-inform ) - 4
     1483         .
     1484         if v-idx-field-qnty < 2 then do:
     1485           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, p-tbl-name ).
     1486         end.
     1487         do v-ind = 1 to v-idx-field-qnty by 2
     1488         on error undo, return error
     1489         :
     1490           assign
     1491             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1492             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1493           .
     1494         end.
     1495       end.
     1496       if p-key-rec = ? then do:
     1497         assign
     1498           p-key-rec = "":U
     1499         .
     1500         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info14, p-tbl-name ).
     1501       end.
     1502     end.
     1503     return.
     1504   end procedure.
     1505   procedure gen-where-keyr-tab :
     1506     define input  parameter i-tableSerach as character no-undo.
     1507     define input  parameter i-tablekey   as character  no-undo.
     1508     define input  parameter p-key-rec    as character  no-undo.
     1509     define input  parameter p-key-handle as handle     no-undo .
     1510     define input  parameter p-db-name    as character  no-undo .
     1511     define input  parameter p-tt-handle  as handle     no-undo .
     1512     define output parameter o-Where      as character  no-undo.
     1513     do
     1514     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1515     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1516     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1517     :
     1518       define variable v-full-tbl-name  as character no-undo .
     1519       define variable bh_tbl-name      as handle    no-undo .
     1520       define variable fh_key           as handle    no-undo .
     1521       define variable fh_search        as handle    no-undo .
     1522       define variable v-field-num      as integer   no-undo .
     1523       define variable v-count-fld      as integer   no-undo .
     1524       define variable v-inform         as character no-undo .
     1525       define variable v-ind            as integer   no-undo .
     1526       define variable v-idx-field-qnty as integer   no-undo .
     1527       define variable v-field-name     as character no-undo .
     1528       define variable v-field-val      as character no-undo .
     1529       define variable v-word-link      as character no-undo .
     1530       define variable vTable           as character no-undo.
     1531       define variable bh_tbl-key       as handle    no-undo .
     1532       assign
     1533         p-key-rec = trim( p-key-rec )
     1534       .
     1535       if p-key-handle <> ? then do:
     1536         if not valid-handle(p-key-handle)
     1537            or p-key-handle:type <> "buffer"
     1538         then do:
     1539           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info14 ).
     1540         end.
     1541         if num-entries( p-key-rec, chr(3) ) > 1
     1542           or p-key-rec = ?
     1543           or p-key-rec = "":U
     1544         then do:
     1545           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info14, p-key-rec ).
     1546         end.
     1547       end.
     1548       else do:
     1549         if p-key-rec = ?
     1550           or p-key-rec = "":U
     1551         then do:
     1552           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1553         end.
     1554       end.
     1555       assign
     1556         vTable = entry( 1 , p-key-rec, chr(3) )
     1557       .
     1558       if p-tt-handle <> ?
     1559         and ( not valid-handle(p-tt-handle)
     1560               or p-tt-handle:type <> "buffer"
     1561             )
     1562       then do:
     1563         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info14, vTable, chr(10) ).
     1564       end.
     1565       if p-tt-handle = ? then do:
     1566         assign
     1567           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1568         .
     1569         create buffer bh_tbl-name for table v-full-tbl-name .
     1570       end.
     1571       else do:
     1572         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1573       end.
     1574       assign
     1575         v-inform = bh_tbl-name:index-information(1)
     1576         v-ind    = 2
     1577       .
     1578       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1579       on error undo, return error
     1580       :
     1581         assign
     1582           v-inform = bh_tbl-name:index-information( v-ind )
     1583           v-ind    = v-ind + 1
     1584         .
     1585       end.
     1586       if v-inform = ?
     1587         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1588         or entry( 3, v-inform, ",":U ) <> "1":U
     1589       then do:
     1590         delete object bh_tbl-name no-error.
     1591         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info14, vTable ).
     1592       end.
     1593       assign
     1594         v-idx-field-qnty = num-entries( v-inform ) - 4
     1595       .
     1596       if v-idx-field-qnty < 2 then do:
     1597         delete object bh_tbl-name no-error.
     1598         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, vTable ).
     1599       end.
     1600       assign
     1601         o-where     = "where":U
     1602         v-word-link = "":U
     1603         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1604         v-count-fld = 0
     1605       .
     1606       if i-tablekey ne "" and i-tablekey ne ?
     1607       then do:
     1608         assign
     1609           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1610         .
     1611         create buffer bh_tbl-key for table v-full-tbl-name .
     1612       end.
     1613       if i-tableSerach ne "" and i-tableSerach ne ?
     1614       then do:
     1615         delete object bh_tbl-name no-error.
     1616         assign
     1617           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1618         .
     1619         create buffer bh_tbl-name for table v-full-tbl-name .
     1620       end.
     1621       block_where:
     1622       do v-ind = 1 to v-idx-field-qnty by 2
     1623       on error undo, return error
     1624       :
     1625         assign
     1626           v-count-fld = v-count-fld + 1
     1627         .
     1628         if p-key-handle = ?
     1629           and v-count-fld > v-field-num
     1630         then do:
     1631           leave block_where.
     1632         end.
     1633         define variable VfieldKeyTable as handle no-undo.
     1634         assign
     1635           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1636           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1637         .
     1638         if     bh_tbl-key ne ?
     1639         then do:
     1640            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1641            if VfieldKeyTable eq ?
     1642            then next block_where.
     1643         end.
     1644         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1645         then
     1646            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1647         else
     1648            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1649         if p-key-handle = ? then do:
     1650           assign
     1651             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1652           .
     1653         end.
     1654         else do:
     1655           assign
     1656             fh_key = p-key-handle:buffer-field( v-field-name )
     1657           .
     1658           if fh_key = ?
     1659             or not valid-handle( fh_key )
     1660           then do:
     1661             delete object bh_tbl-name.
     1662             if     bh_tbl-key ne ?
     1663             then
     1664                delete object bh_tbl-key.
     1665             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info14, p-key-handle:name, v-field-name ).
     1666           end.
     1667           assign
     1668             v-field-val = fh_key:buffer-value
     1669           .
     1670         end.
     1671         if fh_search:data-type ="character":U then do:
     1672           assign
     1673             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1674             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1675             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1676             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1677             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1678             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1679             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1680             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1681             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1682             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1683             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1684             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1685             v-field-val = substitute( '"&1"', v-field-val )
     1686           .
     1687         end.
     1688         assign
     1689           o-where = substitute( "&1 &2", o-where, v-field-val )
     1690         .
     1691         if v-word-link = "":U then do:
     1692           assign
     1693             v-word-link = "and":U
     1694           .
     1695         end.
     1696       end.
     1697       delete object bh_tbl-name.
     1698       if     bh_tbl-key ne ?
     1699       then
     1700          delete object bh_tbl-key.
     1701       if p-key-handle = ?
     1702         and v-count-fld <> v-field-num
     1703       then do:
     1704         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info14, vTable ).
     1705       end.
     1706     end.
     1707   end procedure.
     1708   procedure gen-hn-keyr-tab :
     1709     define input  parameter i-tableSerach as character no-undo.
     1710     define input  parameter i-tablekey   as character no-undo.
     1711     define input  parameter p-key-rec    as character no-undo.
     1712     define input  parameter p-key-handle as handle    no-undo .
     1713     define input  parameter p-db-name    as character no-undo .
     1714     define input  parameter p-tt-handle  as handle    no-undo .
     1715     define input  parameter p-stts-lock  as integer   no-undo .
     1716     define output parameter o-hn         as handle    no-undo.
     1717     define variable v-full-tbl-name as character no-undo.
     1718     define variable v-where         as character no-undo.
     1719     define variable bh_tbl-name     as handle    no-undo.
     1720     define variable vTable          as character no-undo.
     1721     do
     1722     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1723     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1724     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1725         run gen-where-keyr-tab(i-tableSerach,
     1726                                i-tablekey,
     1727                                p-key-rec,
     1728                                p-key-handle,
     1729                                p-db-name,
     1730                                p-tt-handle,
     1731                                output v-where).
     1732         if i-tableSerach ne "" and i-tableSerach ne ?
     1733         then do:
     1734            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1735            create buffer bh_tbl-name for table v-full-tbl-name .
     1736         end.
     1737         else do:
     1738            if p-tt-handle = ? then do:
     1739               assign
     1740                  vTable = entry( 1 , p-key-rec, chr(3) )
     1741               .
     1742               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1743               create buffer bh_tbl-name for table v-full-tbl-name .
     1744            end.
     1745            else do:
     1746               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1747            end.
     1748         end.
     1749         if p-tt-handle = ? then do:
     1750            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1751         end.
     1752         else do:
     1753            bh_tbl-name:find-first( v-where ) no-error .
     1754         end.
     1755         o-hn = bh_tbl-name.
     1756      end.
     1757   end procedure.
     1758   procedure gen-hn-keyr :
     1759     define input  parameter p-key-rec    as character no-undo.
     1760     define input  parameter p-key-handle as handle    no-undo .
     1761     define input  parameter p-db-name    as character no-undo .
     1762     define input  parameter p-tt-handle  as handle    no-undo .
     1763     define input  parameter p-stts-lock  as integer   no-undo .
     1764     define output parameter o-hn         as handle    no-undo.
     1765     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1766   end.
     1767   procedure gen-row-keyr :
     1768     define input  parameter p-key-rec    as character no-undo.
     1769     define input  parameter p-key-handle as handle    no-undo .
     1770     define input  parameter p-db-name    as character no-undo .
     1771     define input  parameter p-tt-handle  as handle    no-undo .
     1772     define input  parameter p-stts-lock  as integer   no-undo .
     1773     define output parameter p-tbl-row    as rowid     no-undo.
     1774     define output parameter p-tbl-name   as character no-undo.
     1775     define variable vHn as handle no-undo.
     1776       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1777       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1778       p-tbl-name =  vHn:table.
     1779       delete object vHn no-error.
     1780     if p-tbl-row = ? then do:
     1781       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info14, p-tbl-name, p-key-rec ).
     1782     end.
     1783     else do:
     1784       return.
     1785     end.
     1786   end procedure.
     1787   procedure gen-key-fv :
     1788     define input  parameter p-key-rec    as character no-undo .
     1789     define output parameter p-field-list as character no-undo .
     1790     define output parameter p-value-list as character no-undo.
     1791     do
     1792     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1793     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1794     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1795     :
     1796       define variable v-full-tbl-name  as character no-undo .
     1797       define variable bh_tbl-name      as handle    no-undo .
     1798       define variable v-tbl-name       as character no-undo .
     1799       define variable v-field-num      as integer   no-undo .
     1800       define variable v-count-fld      as integer   no-undo .
     1801       define variable v-inform         as character no-undo .
     1802       define variable v-ind            as integer   no-undo .
     1803       define variable v-idx-field-qnty as integer   no-undo .
     1804       define variable v-delim-key      as character no-undo .
     1805       if p-key-rec = ?
     1806         or p-key-rec = "":U
     1807       then do:
     1808         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1809       end.
     1810       assign
     1811         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1812         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1813       .
     1814       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1815       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info14 ).
     1816       assign
     1817         v-inform = bh_tbl-name:index-information(1)
     1818         v-ind    = 2
     1819       .
     1820       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1821       on error undo, return error
     1822       :
     1823         assign
     1824           v-inform = bh_tbl-name:index-information( v-ind )
     1825           v-ind    = v-ind + 1
     1826         .
     1827       end.
     1828       if v-inform = ?
     1829         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1830         or entry( 3, v-inform, ",":U ) <> "1":U
     1831       then do:
     1832         delete object bh_tbl-name no-error.
     1833         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1834       end.
     1835       assign
     1836         v-idx-field-qnty = num-entries( v-inform ) - 4
     1837       .
     1838       if v-idx-field-qnty < 2 then do:
     1839         delete object bh_tbl-name no-error.
     1840         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1841       end.
     1842       assign
     1843         p-field-list = "":U
     1844         p-value-list = "":U
     1845         v-delim-key  = "":U
     1846         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1847         v-count-fld  = 0
     1848       .
     1849       block_where:
     1850       do v-ind = 1 to v-idx-field-qnty by 2
     1851       on error undo, return error
     1852       :
     1853         assign
     1854           v-count-fld = v-count-fld + 1
     1855         .
     1856         if v-count-fld > v-field-num then do:
     1857           leave block_where.
     1858         end.
     1859         assign
     1860           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1861           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1862         .
     1863         if v-ind = 1 then do:
     1864           assign
     1865             v-delim-key = chr(3)
     1866           .
     1867         end.
     1868       end.
     1869       delete object bh_tbl-name.
     1870       if v-count-fld <> v-field-num then do:
     1871         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info14, v-tbl-name ).
     1872       end.
     1873     end.
     1874   end procedure.
     1875   procedure gen-key-field :
     1876     define input  parameter p-table      as character no-undo .
     1877     define output parameter p-field-list as character no-undo .
     1878     do
     1879     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1880     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1881     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1882     :
     1883       define variable v-full-tbl-name  as character no-undo .
     1884       define variable bh_tbl-name      as handle    no-undo .
     1885       define variable v-tbl-name       as character no-undo .
     1886       define variable v-field-num      as integer   no-undo .
     1887       define variable v-count-fld      as integer   no-undo .
     1888       define variable v-inform         as character no-undo .
     1889       define variable v-ind            as integer   no-undo .
     1890       define variable v-idx-field-qnty as integer   no-undo .
     1891       define variable v-delim-key      as character no-undo .
     1892       if p-table = ?
     1893         or p-table = "":U
     1894       then do:
     1895         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info14 ).
     1896       end.
     1897       assign
     1898         v-tbl-name      = p-table
     1899         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1900       .
     1901       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1902       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info14 ).
     1903       assign
     1904         v-inform = bh_tbl-name:index-information(1)
     1905         v-ind    = 2
     1906       .
     1907       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1908       on error undo, return error
     1909       :
     1910         assign
     1911           v-inform = bh_tbl-name:index-information( v-ind )
     1912           v-ind    = v-ind + 1
     1913         .
     1914       end.
     1915       if v-inform = ?
     1916         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1917         or entry( 3, v-inform, ",":U ) <> "1":U
     1918       then do:
     1919         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1920       end.
     1921       assign
     1922         v-idx-field-qnty = num-entries( v-inform ) - 4
     1923       .
     1924       if v-idx-field-qnty < 2 then do:
     1925         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1926       end.
     1927       assign
     1928         p-field-list = "":U
     1929         v-delim-key  = "":U
     1930         v-count-fld  = 0
     1931       .
     1932       block_where:
     1933       do v-ind = 1 to v-idx-field-qnty by 2
     1934       on error undo, return error
     1935       :
     1936         assign
     1937           v-count-fld = v-count-fld + 1
     1938         .
     1939         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1940         if v-ind = 1 then do:
     1941           assign
     1942             v-delim-key = chr(3)
     1943           .
     1944         end.
     1945       end.
     1946       delete object bh_tbl-name.
     1947     end.
     1948   end procedure.
