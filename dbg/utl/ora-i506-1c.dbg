       59   define output parameter p-ok-doc as integer   no-undo .
       60   define variable vss-revision    as character no-undo init "$Revision: 0d5da778db5d, 1549, rls $":U .
       61   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
       62   define variable vss-date        as character no-undo init "$Date: Wed Oct 17 22:18:22 2018 +0300 $":U .
       63   define variable vss-workfile    as character no-undo init "$Workfile: ora-i506-1c.p $":U .
       64   define variable vss-archive     as character no-undo init "$Archive: utl/ora-i506-1c.p $":U .
       65   define variable vss-description as character no-undo init "Импорт инвентаризаций из временной таблицы".
       66   procedure vss-get-info :
       67     define output parameter p-vss-revision    like vss-revision    no-undo .
       68     define output parameter p-vss-author      like vss-author      no-undo .
       69     define output parameter p-vss-date        like vss-date        no-undo .
       70     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       71     define output parameter p-vss-archive     like vss-archive     no-undo .
       72     define output parameter p-vss-description like vss-description no-undo .
       73     assign
       74       p-vss-revision    = vss-revision
       75       p-vss-author      = vss-author
       76       p-vss-date        = vss-date
       77       p-vss-workfile    = vss-workfile
       78       p-vss-archive     = vss-archive
       79       p-vss-description = vss-description
       80     .
       81   end procedure.
       82   procedure vss-get-parameters :
       83     define output parameter p-vss-parameters as character no-undo .
       84   end procedure.
       85   define new global shared variable g#vssrevis-logger as handle    no-undo .
       86   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       87   define variable v-vssrevis-logger                   as handle    no-undo .
       88   procedure vss-logevent :
       89     define input  parameter p-extra-paramters as character no-undo .
       90     define variable v-vssrevis-parameters as character no-undo .
       91     do
       92     on error undo, return error return-value
       93     :
       94       if  valid-handle(v-vssrevis-logger)
       95       and v-vssrevis-logger :get-signature("logevent") <> ""
       96       then do:
       97         run vss-get-parameters in this-procedure
       98           (output v-vssrevis-parameters
       99           ).
      100         run logevent in v-vssrevis-logger
      101           (input vss-workfile
      102           ,input vss-revision
      103           ,input v-vssrevis-parameters
      104           ,input p-extra-paramters
      105           ).
      106       end.
      107     end.
      108   end procedure.
      109   assign
      110     v-vssrevis-logger = g#vssrevis-logger
      111   .
      112   if  valid-handle(v-vssrevis-logger)
      113   and v-vssrevis-logger :get-signature("logevent") <> ""
      114   then do:
      115     assign
      116       v-vssrevis-logevent = true
      117     .
      118     run vss-logevent in this-procedure (input vss-description) .
      119   end.
      120   define new global shared variable g#language as character no-undo .
      121   if g#language <> '' and g#language <> 'rus':U then do:
      122     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      123   end.
      124   define new global shared variable g#library  as handle no-undo .
      125   define new global shared variable g#library2 as handle no-undo .
      126   define new global shared variable g#lib-trn  as handle no-undo .
      127   define new global shared variable g#lib-trn2 as handle no-undo .
      128   define new global shared variable g#lib-trn3 as handle no-undo .
      129   define new global shared variable g#lib-trn4 as handle no-undo .
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define variable to-day       as date no-undo .
      132   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure doc-code:
      134   define input  parameter parmode          as   character           no-undo.
      135   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      136   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      137   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      138   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      139   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      140   define variable vardb-remote     as   logical             no-undo.
      141   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      142   define variable v-delimiter as character no-undo .
      143   do
      144   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      145   :
      146   find first buf_sys-ctrl no-lock .
      147   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      148     CASE parmode:
      149       when "main":u then do:
      150         if vardb-remote then do:
      151           assign
      152             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      153         end.
      154         else do:
      155           assign
      156             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      157         end.
      158       end.
      159       when "trio" then do:
      160         assign
      161           pardoc-code = replace (parroot-doc-code, "=", "*").
      162       end.
      163       otherwise do:
      164         assign
      165         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      166         no-error
      167         .
      168         if error-status:error  then do:
      169           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      170                                         ,chr(10)
      171                                         ,parmode
      172                                         ).
      173         end.
      174         if num-entries(parmode) = 1
      175         and parmode <> "chip":U
      176         and parmode <> "chip_s":U
      177         then do:
      178           assign
      179           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      180         end.
      181         else if (lookup("chip":U, parmode) > 0
      182                  or
      183                  lookup("chip_s":U, parmode) > 0) then do:
      184           assign
      185             vartemp-doc-code = parroot-doc-code.
      186           do while true:
      187             if index (vartemp-doc-code , ".") = 0 then
      188               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      189             else
      190               vartemp-doc-code  =
      191               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      192               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      193               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      194             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      195           end.
      196           assign
      197             pardoc-code = vartemp-doc-code.
      198         end.
      199       end.
      200     end CASE.
      201     if pardoc-code = '':U
      202     or (parroot-doc-code <> '':U
      203     and pardoc-code = parroot-doc-code) then do:
      204       undo, return error substitute("Ошибка при генерации номера документа&1"
      205                                     ,chr(10)).
      206     end.
      207   end.
      208   end. // procedure/method
      209   function get-doc-code-int64 returns int64
      210     ( input p-doc-code as character ) :
      211     define variable v-ind              as integer   no-undo .
      212     define variable v-num-entries      as integer   no-undo .
      213     define variable v-doc-code-int64   as int64     no-undo .
      214     define variable v-canonic-doc-code as character no-undo .
      215     assign
      216       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      217       v-canonic-doc-code = p-doc-code
      218     .
      219     do v-ind = 1 to v-num-entries
      220     :
      221       assign
      222         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      223       .
      224     end.
      225     assign
      226       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      227     .
      228     return v-doc-code-int64 .
      229   end. // function/method
      230   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      231   define variable v-waitfram-action01         as character   no-undo .
      232   define variable v-waitfram-action02         as character   no-undo .
      233   define variable v-waitfram-action03         as character   no-undo .
      234   define variable mWaitFramTextBeg            as character   no-undo.
      235   define variable mWaitFramTextEnd            as character   no-undo.
      236   define variable mWaitFramView               as logical     no-undo.
      237   define variable mWaitProcEvent              as logical     no-undo init yes.
      238   define variable mWaitFramInterval           as integer     no-undo init 1 .
      239   define variable mWaitFramStop               as logical     no-undo.
      240   define variable mWaitFramStopUser           as logical     no-undo.
      241   define variable mWaitFramStopTimeOut        as logical     no-undo.
      242   define variable mWaitFramStartProc          as datetime-tz no-undo.
      243   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      244   define button B-WaitFramStop auto-end-key
      245        label "Стоп"
      246        size 10 by 1 tooltip "Остоновить процесс".
      247   define button B-viewProcInfo
      248        label "Информация"
      249        size 15 by 1 tooltip "Информация о процесс".
      250   define frame waitfram
      251     v-waitfram-action01 format "x(72)" no-label skip
      252     v-waitfram-action02 format "x(72)" no-label skip
      253     v-waitfram-action03 format "x(72)" no-label skip
      254     B-viewProcInfo
      255     B-WaitFramStop at row 4 col 30
      256     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      257     .
      258   define new global shared variable mBatchMode as logical no-undo init ?.
      259   define variable mFramBachModHandle as handle no-undo.
      260   mFramBachModHandle = frame waitfram:handle.
      261   define variable mFameOldVis as logical no-undo.
      262   define variable mVisCUrentVin as logical no-undo.
      263   if session:batch-mode
      264   then
      265      mBatchMode = yes.
      266   if mBatchMode = ? then do:
      267     mVisCUrentVin = current-window:visible.
      268     mFameOldVis = mFramBachModHandle:visible.
      269     mFramBachModHandle:visible  = yes.
      270     mBatchMode = mFramBachModHandle:visible ne yes.
      271     mFramBachModHandle:visible = mFameOldVis.
      272     current-window:visible = mVisCUrentVin.
      273   end.
      274    if  log-manager:logfile-name ne ?
      275     then DO:
      276         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      277         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      278         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      279     end.
      280   on choose of B-WaitFramStop in frame waitfram
      281   do:
      282     mWaitFramStop = yes.
      283     mWaitFramStopUser = yes.
      284   end.
      285   function waitfram-check-timeout returns logical():
      286      define variable vtime as int64 no-undo.
      287      if mWaitFramStopTimeOut
      288      then
      289         return yes.
      290      vtime = ( now - mWaitFramStartProc ) / 1000 .
      291      if     mWaitFramTimeOut ne ?
      292         and mWaitFramTimeOut ne 0
      293         and mWaitFramTimeOut lt vtime
      294      then do:
      295         mWaitFramStopTimeOut = yes.
      296      end.
      297      return mWaitFramStopTimeOut.
      298   end.
      299   procedure waitfram-hide :
      300     if not session:batch-mode
      301     then do
      302     on error undo, return error return-value
      303     :
      304       pause 0 before-hide .
      305       if not mBatchMode then
      306         hide frame waitfram .
      307     if     not mWaitFramView
      308        and mWaitProcEvent
      309     then
      310       process events .
      311     end.
      312   end procedure.
      313   procedure waitfram-show :
      314     define input  parameter p-message as character no-undo .
      315     define variable v-left-margin as integer   no-undo .
      316     if not session:batch-mode
      317     then do
      318     on error undo, return error return-value
      319     :
      320       if length(p-message) <= 70 then do:
      321         assign
      322           v-left-margin = integer((70 - length(p-message)) / 2)
      323         .
      324         assign
      325           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      326         .
      327         assign
      328           v-waitfram-action01 = " "
      329           v-waitfram-action02 = " "
      330                                    + fill(" ", v-left-margin)
      331                                    + p-message
      332           v-waitfram-action03 = " "
      333         .
      334       end.
      335       else do:
      336         define variable vRindex1 as integer no-undo.
      337         define variable vRindex2 as integer no-undo.
      338         vRindex1 = r-index(p-message," ",70).
      339         if vRindex1 = 0
      340         then
      341            vRindex1 = 70.
      342         if length(p-message)  <= vRindex1 + 70 then do:
      343           assign
      344             v-waitfram-action01 = " "
      345             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      346             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      347           .
      348         end.
      349         else do:
      350           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      351           if vRindex2 <= vRindex1
      352           then
      353              vRindex2 = vRindex1 + 70.
      354           assign
      355             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      356             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      357             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      358           .
      359         end.
      360       end.
      361       B-viewProcInfo:visible   in frame waitfram = no.
      362       B-viewProcInfo:sensitive in frame waitfram = no.
      363       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      364       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      365       if  (   mWaitFramView
      366          or  mWaitProcEvent)
      367          and not mBatchMode
      368       then
      369          display
      370             v-waitfram-action01 skip
      371             v-waitfram-action02 skip
      372             v-waitfram-action03 skip
      373          with frame waitfram .
      374       if     mWaitFramView
      375          then do:
      376             if     mWaitFramInterval ne ?
      377                and not mBatchMode
      378             then
      379                wait-for go of frame waitfram pause mWaitFramInterval.
      380          end.
      381          else
      382             if     mWaitProcEvent
      383                and not mBatchMode
      384             then
      385                process events .
      386     end.
      387   end procedure.
      388      procedure waitfram-show-this:
      389         define input  parameter iInterval as int64 no-undo.
      390         define variable vtime as int64 no-undo.
      391         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      392         mWaitFramInterval = iInterval.
      393         run waitfram-show (substitute("&1&2 &3&4" ,
      394                                       mWaitFramTextBeg ,
      395                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      396                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      397                                       mWaitFramTextEnd
      398                                      )
      399                           ).
      400      end.
      401      procedure WaitFramRunPause:
      402         define input  parameter iInterval as dec no-undo.
      403         define variable vStart  as datetime-tz no-undo.
      404         define variable vend    as datetime-tz no-undo.
      405         define variable vint as int64 no-undo.
      406         define variable vOk as logical no-undo.
      407         vStart = now.
      408         vend   = vStart.
      409         publish "WaitFramPause" (iInterval,output vOk).
      410         vend   =  now.
      411         vint = vend - vStart.
      412         vint = iInterval - vint / 1000.
      413         if     not mWaitFramStop
      414            and (   vint > 0
      415                 or (    not vOk
      416                     and iInterval eq ?
      417                     )
      418                 )
      419         then
      420            run waitfram-show-this (iInterval).
      421         vend   =  now.
      422         vint = vend - vStart.
      423         vint = iInterval - vint / 1000.
      424         if     not mWaitFramStop
      425            and vint > 0
      426         then do:
      427            run gbl/pause.p (vint * 1000).
      428         end.
      429         if iInterval ne ?
      430         then
      431            publish "WaitFramStop".
      432         waitfram-check-timeout().
      433      end.
      434      procedure WaitFramWaitFor:
      435         define input  parameter iInterval as dec no-undo.
      436         assign
      437            mWaitFramStartProc   = now
      438            mWaitFramStopUser    = no
      439            mWaitFramStopTimeOut = no
      440         .
      441         block-wait:
      442         do while not mWaitFramStop:
      443            run WaitFramRunPause (iInterval).
      444            if  waitfram-check-timeout()
      445            then do:
      446               leave block-wait.
      447            end.
      448         end.
      449         run waitfram-hide.
      450      end.
      451   procedure waitfram-join :
      452     define input  parameter p-line-1  as character no-undo .
      453     define input  parameter p-line-2  as character no-undo .
      454     define input  parameter p-line-3  as character no-undo .
      455     define output parameter p-message as character no-undo .
      456     do
      457     on error undo, return error return-value
      458     :
      459       assign
      460         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      461                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      462                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      463       .
      464     end.
      465   end procedure.
      466   function waitfram-join-function returns character
      467     (input p-line-1 as character
      468     ,input p-line-2 as character
      469     ,input p-line-3 as character
      470     ).
      471     define variable v-message as character no-undo .
      472     run waitfram-join in this-procedure
      473       (input  p-line-1
      474       ,input  p-line-2
      475       ,input  p-line-3
      476       ,output v-message
      477       ) .
      478     return v-message .
      479   end function .
      480   function cross-list returns logical (
      481     input parfirst-stream  as character,
      482     input parsecond-stream as character,
      483     input pardelim         as character).
      484     if pardelim = ""
      485     or pardelim = ?
      486     then do:
      487       assign
      488         pardelim = ","
      489       .
      490     end.
      491     define variable vari            as integer no-undo .
      492     define variable varresult-cross as logical no-undo .
      493     assign
      494       varresult-cross = no
      495     .
      496     def var v-num-parfirst-stream as integer no-undo .
      497     assign
      498       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      499     .
      500     do vari = 1 to v-num-parfirst-stream
      501     :
      502       if lookup(entry(vari, parfirst-stream, pardelim)
      503                ,parsecond-stream
      504                ,pardelim
      505                ) > 0 then do:
      506         assign
      507           varresult-cross = yes
      508         .
      509         leave.
      510       end.
      511     end.
      512     return varresult-cross .
      513   end function.
      514   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      515   define new global shared variable g#attr-lib  as handle no-undo .
      516   define variable v-attr-lib-variable as handle no-undo .
      517   procedure clntattr-code :
      518     define input  parameter p-code           as character no-undo .
      519     define output parameter p-type           as character no-undo .
      520     define output parameter p-format         as character no-undo .
      521     define output parameter p-label          as character no-undo .
      522     define output parameter p-user-can-edit  as logical   no-undo .
      523     define output parameter p-output-display as logical   no-undo .
      524     define output parameter p-other          as character no-undo .
      525     do
