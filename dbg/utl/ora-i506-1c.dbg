     2622               buf_doc-line.doc-code = new_trn-doc.doc-code and not is-tsd:
     2623          find first  buf_gds-obj no-lock where
     2624                      buf_gds-obj.obj-type  = new_trn-doc.obj-type  and
     2625                      buf_gds-obj.obj-code  = new_trn-doc.obj-code  and
     2626                      buf_gds-obj.artic     = buf_doc-line.artic    and
     2627                      buf_gds-obj.prod-type = buf_doc-line.prod-type    and
     2628                      buf_gds-obj.prod-code = buf_doc-line.prod-code    no-error .
     2629          if available buf_gds-obj and  buf_doc-line.doc-qnty <> buf_gds-obj.fact-qnty then
     2630             buf_doc-line.doc-qnty = buf_gds-obj.fact-qnty.
     2631      end.
     2632      run gbl/calc-trn.p (  this-procedure , recid(new_trn-doc)) no-error .
     2633         if error-status :error then do:
     2634           v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     2635           run pcall-log-file in p-log-handle ( input v-end-message ) .
     2636           undo, return error v-end-message.
