     2780   procedure clear-tt :
     2781     do
     2782     on error undo, return error return-value
     2783     :
     2784      for each tt-trn-doc:
     2785       delete tt-trn-doc.
     2786      end.
     2787       for each tt2-doc-line :
     2788           delete tt2-doc-line .
     2789       end.
     2790       for each tt-doc-line :
     2791           delete tt-doc-line .
     2792       end.
     2793       for each tt-gds-dtl :
     2794           delete tt-gds-dtl .
     2795       end.
     2796       for each tt-parts:
     2797           delete tt-parts .
     2798       end.
     2799       for each lib-trn_ret-doc :
     2800         delete lib-trn_ret-doc.
     2801       end.
     2802       for each lib-trn_ret-line :
     2803         delete lib-trn_ret-line      .
     2804       end.
     2805       for each lib-trn_ret-line-attr :
     2806         delete lib-trn_ret-line.
     2807       end.
     2808       for each lib-trn_ret-dtl :
     2809         delete lib-trn_ret-dtl.
     2810       end.
     2811       for each lib-trn_ret-parts :
     2812         delete lib-trn_ret-parts .
     2813       end.
     2814    end.
     2815   end procedure.
     2816   procedure add-nn :
     2817   define input  parameter p-doc-code as character no-undo .
     2818   define input  parameter p-doc-out as character no-undo .
     2819   define input  parameter p-date-inv as character no-undo .
     2820     do
     2821     on error undo, return error return-value
     2822     :
     2823     find first ub.doc-attr exclusive-lock where
     2824              ub.doc-attr.doc-code = p-doc-code and
     2825              ub.doc-attr.attr-code = 'nids':U no-error .
     2826     if not available ub.doc-attr then create ub.doc-attr.
     2827     assign
     2828       ub.doc-attr.doc-code = p-doc-code
     2829       ub.doc-attr.attr-code = 'nids':U
     2830       ub.doc-attr.attr-value = if is-tsd then "tsd," + p-doc-out else p-doc-out
     2831     .
     2832     find first ub.doc-attr exclusive-lock where
     2833                ub.doc-attr.doc-code = p-doc-code and
     2834                ub.doc-attr.attr-code = 'dateinv':U no-error .
     2835     if not available ub.doc-attr then create ub.doc-attr.
     2836     assign
     2837       ub.doc-attr.doc-code = p-doc-code
     2838       ub.doc-attr.attr-code = 'dateinv':U
     2839       ub.doc-attr.attr-value =  p-date-inv
     2840     .
     2841     end.
     2842   end procedure.
     2843   procedure add-nn1 :
     2844   define input  parameter p-doc-code as character no-undo .
     2845     do
     2846     on error undo, return error return-value
     2847     :
     2848     find first ub.doc-attr exclusive-lock where
     2849                ub.doc-attr.doc-code = p-doc-code and
     2850                ub.doc-attr.attr-code = 'clcasol':U no-error .
     2851     if not available ub.doc-attr then create ub.doc-attr.
     2852     assign
     2853       ub.doc-attr.doc-code = p-doc-code
     2854       ub.doc-attr.attr-code = 'clcasol':U
     2855       ub.doc-attr.attr-value =  "yes"
     2856     .
     2857     end.
     2858   end procedure.
