     2665        if varzero-string = true
     2666         then run str/scantsd.p ( this-procedure, 1, input no , input recid(new_trn-doc) ,input "addinvtsd.txt" ).
     2667        run gbl/filnline.p (input "invtsd.txt", output varzero-string).
     2668        if varzero-string = true
     2669         then run str/scantsd.p ( this-procedure, 2, input no , input recid(new_trn-doc) ,input "invtsd.txt" ).
     2670        os-delete value (search ("invtsd.txt")) no-error.
     2671        os-delete value (search ("addinvtsd.txt")) no-error.
     2672      end.
     2673      assign
     2674           v-end-message =  string(temp_trn-doc.obj-type) + string(temp_trn-doc.obj-code)
     2675                       + chr(9) + "Документ инвентаризации:" + string(new_trn-doc.doc-code) + " / " + string(temp_trn-doc.doc-code) + chr(9) + string( k ) + " товаров" + chr(10)
     2676                       .
     2677        run pcall-log-file in p-log-handle (input v-end-message) .
     2678        p-ok-doc = p-ok-doc + 1.
     2679   end.
     2680   end.
     2681   procedure clos-trn2 :
     2682   define input parameter p-trn-code as character no-undo .
     2683     do
     2684       on error undo, return error return-value
     2685       :
     2686       define buffer buf_s-trn-doc for ub.trn-doc.
     2687       define variable varmode         as character no-undo.
     2688       define variable varstatus       like ub.trn-doc.status_ no-undo.
     2689       define variable varflag         like ub.trn-doc.flag no-undo.
     2690       define variable varcopystatus   like ub.trn-doc.status_ no-undo.
     2691       define variable varcopyflag     like ub.trn-doc.flag no-undo.
     2692       define variable varcheck-return as logical   no-undo .
     2693       define variable varchg-inv      as logical   no-undo .
     2694       run str/trn-stat.p (
     2695         input  parparentproc ,
     2696         input  this-procedure ,
     2697         input  '<закрытие документа>':U ,
     2698         input  p-trn-code,
     2699         input  false  ,
     2700         input  v-cntxt-db-num,
     2701         input  false ,
     2702         input  v-cntxt-rsrv-time,
     2703         input  v-cntxt-load-time,
     2704         input  v-cntxt-holidays,
     2705         input  false ,
     2706         output varchg-inv ,
     2707         output table gds-list)
     2708         no-error.
     2709       if error-status:error then
     2710       do :
     2711         v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     2712         run pcall-log-file in p-log-handle ( input v-end-message ) .
     2713         undo, return error v-end-message.
     2714       end.
     2715       if is-tsd then
     2716       do:
     2717         run str/trn-stat.p (
     2718           input  parparentproc ,
     2719           input  this-procedure ,
     2720           input  '<закрытие документа>':U ,
     2721           input  p-trn-code,
     2722           input  false  ,
     2723           input  v-cntxt-db-num,
     2724           input  false ,
     2725           input  v-cntxt-rsrv-time,
     2726           input  v-cntxt-load-time,
     2727           input  v-cntxt-holidays,
     2728           input  false ,
     2729           output varchg-inv ,
     2730           output table gds-list)
     2731           no-error.
     2732         if error-status:error then
     2733         do :
     2734           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     2735           run pcall-log-file in p-log-handle ( input v-end-message ) .
     2736           undo, return error v-end-message.
     2737         end.
     2738       end.
     2739     end.
     2740   end procedure.
     2741   procedure mainmenu_getcntxt :
