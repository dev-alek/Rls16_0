     2536                                                       ,INPUT ?
     2537                                                       ,INPUT NO-LOCK
     2538                                                       ,OUTPUT v-rowid
     2539                                                       ,OUTPUT v-table-name) NO-ERROR.
     2540                   find first buf_gds-grp no-lock where
     2541                       rowid(buf_gds-grp) = v-rowid no-error.
     2542                       if error-status :error then do:
     2543                           v-end-message = substitute ( "Ошибка: нет группы &1 &2 &3 &4 &5 " ,
     2544                               temp_grp-line.depart-code   ,
     2545                               temp_grp-line.class-code    ,
     2546                               temp_grp-line.subclass-code ,
     2547                               error-status :get-message(1) ,
     2548                               return-value
     2549                               ) .
     2550                           run pcall-log-file in p-log-handle ( input v-end-message ) .
     2551                           undo, return error v-end-message.
     2552                       end.
     2553                 end.
     2554                 else do:
     2555                     v-end-message = substitute ( "Ошибка: нет группы &1 &2 &3  " ,
     2556                               temp_grp-line.depart-code ,
     2557                               temp_grp-line.class-code  ,
     2558                               temp_grp-line.subclass-code     ) .
     2559                     run pcall-log-file in p-log-handle ( input v-end-message ) .
     2560                     undo, return error v-end-message.
     2561                  end.
     2562        v-end-message = substitute("Соответствие групп &1 - &2 - &3  >>  &4" ,
     2563           temp_grp-line.depart-code ,
     2564           temp_grp-line.class-code  ,
     2565           temp_grp-line.subclass-code ,
     2566           buf_gds-grp.node-code    ) .
     2567       run pcall-log-file in p-log-handle ( input v-end-message ) .
     2568        for each buf_goods no-lock where
     2569                 buf_goods.grp-code = buf_gds-grp.node-code :
     2570       if buf_goods.stts <> 0  then do:
     2571           v-end-message = substitute("Пропускаю товар &1 &2&3  из группы  &4 , его статус не ТЕКУЩИЙ" ,
     2572                     buf_goods.artic ,
     2573                     buf_goods.prod-type ,
     2574                     buf_goods.prod-code  ,
     2575                     buf_gds-grp.node-code    ) .
     2576           run pcall-log-file in p-log-handle ( input v-end-message ) .
     2577           next.
     2578       end.
     2579   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2580   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2581     (input  tt-trn-doc.obj-type
     2582     ,input  tt-trn-doc.obj-code
     2583     ,input  buf_goods.artic
     2584     ,input  buf_goods.prod-type
     2585     ,input  buf_goods.prod-code
     2586     ,buffer ub.gds-obj
     2587     ) no-error .
     2588              find first buf_doc-line exclusive-lock where buf_doc-line.doc-code = new_trn-doc.doc-code
     2589                and buf_doc-line.artic = buf_goods.artic
     2590                and buf_doc-line.prod-type = buf_goods.prod-type
     2591                and buf_doc-line.prod-code = buf_goods.prod-code
     2592              no-error  .
     2593              if not available buf_doc-line then
     2594              do:
     2595                create anlz-bc .
     2596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2597     (input  buf_goods.gds-code
     2598     ,input  ?
     2599     ,output anlz-bc.b-c
     2600     ) no-error .
     2601                if error-status :error then
     2602                do:
     2603                  v-end-message = substitute("anlz-bc &1 &2 &3 &4" ,
     2604                    buf_goods.gds-code ,
     2605                    anlz-bc.b-c ,
     2606                    return-value ,
     2607                    error-status:get-message(1) ) .
     2608                  run pcall-log-file in p-log-handle ( input v-end-message ) .
     2609                end.
     2610                k = k + 1  .
     2611              end.
     2612        end.
     2613      end.
     2614      run str/use-list.p (input this-procedure , input-output line-rec, input recid(new_trn-doc) , input false  , input (buffer anlz-bc:handle) ) no-error .
     2615      if error-status :error then do:
     2616           v-end-message = substitute("Ошибка1 &1 &2" , error-status :get-message(1)  , return-value) .
     2617           run pcall-log-file in p-log-handle ( input v-end-message ) .
     2618           undo, return error v-end-message.
