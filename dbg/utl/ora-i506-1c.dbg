     2638      run add-nn (new_trn-doc.doc-code , temp_trn-doc.doc-code , string(temp_trn-doc.doc-date) ) no-error .
     2639       if error-status:error then do :
     2640           v-end-message = substitute(" Ошибка записи атрибута документа &1 &2" , error-status :get-message(1)  , return-value) .
     2641           run pcall-log-file in p-log-handle ( input v-end-message ) .
     2642           undo, return error v-end-message.
     2643       end.
     2644      if not not-is-new
     2645      then do:
     2646        run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     2647         if error-status:error then do :
     2648             v-end-message = substitute(" Ошибка2 &1 &2" , error-status :get-message(1)  , return-value) .
     2649             run pcall-log-file in p-log-handle ( input v-end-message ) .
     2650             undo, return error v-end-message.
     2651         end.
     2652      end.
     2653      if not not-is-new
     2654      then do:
     2655        run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     2656         if error-status:error then do :
     2657             v-end-message = substitute(" Ошибка2 &1 &2" , error-status :get-message(1)  , return-value) .
     2658             run pcall-log-file in p-log-handle ( input v-end-message ) .
     2659             undo, return error v-end-message.
     2660         end.
     2661      end.
     2662      if is-tsd
     2663      then do:
