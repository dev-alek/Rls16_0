      641   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      642   DO:
      643       run b-exit-proc in this-procedure no-error.
      644       if error-status:error then return no-apply.
      645   END.
      646   ON CHOOSE OF B-lst IN FRAME Dialog-Frame
      647   DO:
      648       define variable Filter-name as char no-undo.
      649       run str/dc-list.w ( input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code).
      650   END.
      651   ON CHOOSE OF B-shop IN FRAME Dialog-Frame
      652   DO:
      653       define variable rid-list as char no-undo.
      654     rid-list = "".
      655     run adm/shops.w ( input parparentproc, "b-sel", input-output rid-list, input no).
      656     if rid-list <> "" then do:
      657       FIND FIRST ub.shop No-LOCK WHERE recid(ub.shop) = integer(rid-list) No-ERROR.
      658       if ub.shop.host-code <> v-cntxt-host-code-obj then do:
      659           message "Нельзя выдать дисконтную карту для чужой фирмы!"
      660           view-as alert-box ERROR.
      661           return no-apply.
      662       end.
      663       assign
      664       issue-code:screen-value = string(shop.obj-code)
      665       emitent-host-code:screen-value = string(shop.host-code).
      666     end.
      667   END.
      668   ON CHOOSE OF B-type IN FRAME Dialog-Frame
      669   DO:
      670    run proc-b-type in this-procedure no-error.
      671    if error-status:error then return no-apply.
      672   END.
