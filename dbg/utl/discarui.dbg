      967   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      968   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      969   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      970   on help of frame Dialog-Frame
      971   do:
      972     run gbl/app_help.p
      973       (input this-procedure :file-name
      974       ,input ''
      975       ,input ?
      976       ) no-error.
      977     if error-status :error then do:
      978       message
      979         "Ошибка при вызове помощи"
      980         error-status :get-message(1)
      981         view-as alert-box .
      982     end.
      983   end.
      984   run minbtn-set in this-procedure .
      985   on choose of b-help in frame Dialog-Frame
      986   do:
      987     apply "help":u to frame Dialog-Frame .
      988   end.
      989   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      990   procedure minbtn-set :
      991       do
      992           on error undo, return error return-value
      993           :
      994           define variable ii              as integer       no-undo .
      995           define variable fh              as widget-handle no-undo .
      996           define variable hh              as widget-handle no-undo .
      997           define variable v-h             as handle        extent 4 no-undo .
      998           define variable v-name-button   as character     no-undo .
      999           define variable v-help-old-x    as decimal       no-undo .
     1000           define variable v-help-old-y    as decimal       no-undo .
     1001           define variable v-help-old-size as decimal       no-undo .
     1002           define variable v-frame-width   as decimal       no-undo .
     1003           define variable jj              as integer       no-undo .
     1004           do
     1005               on error undo, return error
     1006               :
     1007               assign
     1008                   v-frame-width = frame Dialog-Frame:width - 0.3
     1009                   fh            = frame Dialog-Frame:first-child
     1010                   hh            = fh:first-child
     1011                   ii            = 1
     1012                   .
     1013               do while valid-handle(hh):
     1014                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1015                   do:
     1016                       case lc(hh:name) :
     1017                           when "b-help" then
     1018                               do:
     1019                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1020                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1021                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1022                                   hh:TOOLTIP = "Помощь" .
     1023                                   v-help-old-x = hh:column .
     1024                                   v-help-old-y = hh:row    .
     1025                                   v-help-old-size = hh:width .
     1026                                   hh:width-chars = 2.5 .
     1027                               end.
     1028                           when "b-print" then
     1029                               do:
     1030                                   hh:load-image("cmp/b-print.bmp":u) .
     1031                                   hh:TOOLTIP = "Печать" .
     1032                                   v-h[ii] = hh:handle .
     1033                                   ii = ii + 1 .
     1034                                   hh:width-chars = 3 .
     1035                               end.
     1036                           when "b-history" or
     1037                           when "b-hist" then
     1038                               do:
     1039                                   hh:load-image("cmp/b-hist.bmp":u) .
     1040                                   hh:TOOLTIP = "История" .
     1041                                   v-h[ii] = hh:handle .
     1042                                   ii = ii + 1 .
     1043                                   hh:width-chars = 3 .
     1044                               end.
     1045                           when "b-sch" then
     1046                               do:
     1047                                   hh:load-image("cmp/b-sch.bmp":u) .
     1048                                   hh:TOOLTIP = "Установка Фильтра" .
     1049                                   v-h[ii] = hh:handle .
     1050                                   ii = ii + 1 .
     1051                                   hh:width-chars = 3 .
     1052                               end.
     1053                           when "b-hist-user" then
     1054                               do:
     1055                                   hh:load-image("cmp/b-hist.bmp":u) .
     1056                                   hh:TOOLTIP = "История пользователя" .
     1057                                   ii = ii + 1 .
     1058                               end.
     1059                       end case.
     1060                   end.
     1061                   hh = hh:next-sibling.
     1062               end.
     1063               b-help:column = v-frame-width - b-help:width-chars.
     1064               jj = 0.
     1065               repeat ii = 4 to 1 by -1 :
     1066                   if valid-handle (v-h[ii] ) then
     1067                   do:
     1068                       jj  = jj + 1 .
     1069                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1070                       v-h[ii]:row    = v-help-old-y .
     1071                   end.
     1072               end.
     1073           end.
     1074       end.
     1075   end procedure.
     1076   if ( g#db-num > 0 ) then do:
     1077       message "Данная утилита может быть запущена только в ГБД!" view-as alert-box.
     1078       return.
     1079   end.
     1080   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081     run mainmenu_getcntxt in parparentproc
     1082       (output v-cntxt-db-num
     1083       ,output v-cntxt-userid
     1084       ,output v-cntxt-level
     1085       ,output v-cntxt-host-code-obj
     1086       ,output v-cntxt-obj-type
     1087       ,output v-cntxt-obj-code
     1088       ,output v-cntxt-db-num-obj
     1089       ,output v-cntxt-is-admin
     1090       ) .
     1091   define variable glog as logical   no-undo .
     1092   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093   do:
     1094     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1095       (input  v-cntxt-db-num
     1096       ,input  v-cntxt-userid
     1097       ,input  0
     1098       ,input  'actn_referense-dis_input-deletion-updating':U
     1099       ,input  'firm':U
     1100       ,input  v-cntxt-host-code-obj
     1101       ,input  '':U
     1102       ,input  0
     1103       ,input  0
     1104       ,input  0
     1105       ,input  0
     1106       ,input  true
     1107       ,output glog
     1108       )  .
     1109   end.
     1110   if not glog
     1111   then do:
     1112     return.
     1113   end.
     1114   MAIN-BLOCK:
     1115   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1116      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1117     dc-status:list-items = 'тек':U + chr(44) + 'блок':U + chr(44) + 'удал':U.
     1118     d-pcnt-method:radio-buttons =
     1119          "Товар" + chr(44) + string('1':U) + chr(44) +
     1120        "Итог_чека" + chr(44) + string('2':U) + chr(44) +
     1121        "Товары_и_итог_чека" + chr(44) + string('3':U).
     1122     run Myenable in this-procedure .
     1123     WAIT-FOR GO OF FRAME Dialog-Frame.
     1124   END.
     1125   run disable_UI in this-procedure .
     1126   PROCEDURE b-exit-proc :
     1127   define variable mystr as char format "X(500)".
     1128   define variable glog as logical no-undo .
     1129   define variable II AS INTEGER NO-UNDO.
     1130   DEFINE VARIABLE var-run-names as character no-undo .
     1131   define variable ok-to-restore as logical no-undo .
     1132   if not can-find(first dc-list) then do:
     1133     BELL.
     1134     message
     1135     "В списке дисконтных карт нет ни одной карты!"
     1136     view-as alert-box WARNING.
     1137     return error.
     1138   end.
     1139   assign
     1140   frame Dialog-Frame dc-status
     1141   dc-type
     1142   d-pcnt
     1143   cash-d-pcnt
     1144   category
     1145   emitent-host-code
     1146   issue-code
     1147   issue-date
     1148   credit-card
     1149   LIM-KR
     1150   valid-date
     1151   d-pcnt-method
     1152   debet-card
     1153   staff-card
     1154   cli-message
     1155   .
     1156   if issue-code:sensitive and integer(issue-code:screen-value) = 0 then do:
     1157       message "Укажите код магазина, выдавшего карту!" view-as alert-box WARNING.
     1158       return error .
     1159   end.
     1160   if issue-date:sensitive and issue-date:screen-value = "  /  /    " then do:
     1161       message "Укажите дату выдачи карты!" view-as alert-box WARNING.
     1162       return error .
     1163   end.
     1164   if b-type:sensitive and dc-type = "" then do:
     1165       message "Укажите тип карты!" view-as alert-box WARNING.
     1166       return error .
     1167   end.
     1168   if d-pcnt:sensitive and ((d-pcnt < 0 ) OR ( d-pcnt = ? )) then do:
     1169           message "Вам следует ввести" skip
     1170                           "НЕОТРИЦАТЕЛЬНЫЙ процент скидки (на товары)."
     1171                           view-as alert-box INFORMATION .
     1172           apply "ENTRY":U to d-pcnt IN frame Dialog-Frame.
     1173           return error .
     1174   end.
     1175   if cash-d-pcnt:sensitive and ((cash-d-pcnt < 0 ) OR ( cash-d-pcnt = ? )) then do:
     1176           message "Вам следует ввести" skip
     1177                           "НЕОТРИЦАТЕЛЬНЫЙ процент скидки (на итог)."
     1178                           view-as alert-box INFORMATION .
     1179           apply "ENTRY":U to cash-d-pcnt IN frame Dialog-Frame.
     1180           return error .
     1181   end.
     1182   IF dc-status:sensitive and dc-status = 'тек':U or dc-status = 'блок':U then do:
     1183   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   do:
     1185     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1186       (input  v-cntxt-db-num
     1187       ,input  v-cntxt-userid
     1188       ,input  0
     1189       ,input  'actn_referense-dis_current-status':U
     1190       ,input  'firm':U
     1191       ,input  v-cntxt-host-code-obj
     1192       ,input  '':U
     1193       ,input  0
     1194       ,input  0
     1195       ,input  0
     1196       ,input  0
     1197       ,input  false
     1198       ,output ok-to-restore
     1199       )  .
     1200   end.
     1201     if not ok-to-restore then do:
     1202       message
     1203       substitute("ВНИМАНИЕ!&1" +
     1204                 "У Вас нет прав на восстановление удаленных карт&1" +
     1205                 "Для удаленных карт статус карты на &2  изменен не будет!"
     1206                 , chr(10)
     1207                 , dc-status  )
     1208       view-as alert-box  WARNING.
     1209     end.
     1210   end.
     1211   IF credit-card:sensitive
     1212       AND credit-card
     1213       AND debet-card:sensitive
     1214       AND debet-card THEN DO:
     1215      message
     1216     "Карта не может быть одновреенно кредитной и дебетовой"
     1217     view-as ALERT-BOX ERROR.
     1218     RETURN ERROR.
     1219   END.
     1220   mystr =   (IF dc-status:sensitive then ("СТАТУС="+                   dc-status + chr(10) ) else "") +
     1221             (IF b-type:sensitive then ("ТИП КАРТЫ=" +                  dc-type + chr(10) ) else "") +
     1222             (IF b-type:sensitive then ("ЭМИТЕНТ=" +                    string(ub.dis-card-type.emitent-host-code) + chr(10) ) else "") +
     1223             (IF d-pcnt:sensitive then ("% СКИДКИ НА ТОВАР=" +          string(d-pcnt) + chr(10) ) else "") +
     1224             (IF cash-d-pcnt:sensitive then ("% СКИДКИ НА ИТОГ=" +      string(cash-d-pcnt) + chr(10) ) else "") +
     1225             (IF category:sensitive then ("КАТЕГОРИЯ=" +                string(category) + chr(10) ) else "") +
     1226             (IF issue-date:sensitive then ("ДАТА ВЫДАЧИ=" +            string(issue-date, "99/99/9999") ) else "") +
     1227             (IF issue-code:sensitive then ("ВЫДАЛ МАГАЗИН=" +          string(issue-code, "99999") ) else "") +
     1228             (IF credit-card:sensitive then ("КРЕДИТНАЯ КАРТА=" +       string(credit-card, "да/нет") ) else "") +
     1229             (IF debet-card:sensitive then ("ДЕБЕТОВАЯ КАРТА=" +        string(debet-card, "да/нет") ) else "") +
     1230             (IF staff-card:sensitive then ("КАРТА ПЕРСОНАЛА=" +        string(staff-card, "да/нет") ) else "") +
     1231             (IF lim-kr:sensitive then ("ЛИМИТ КРЕДИТА=" +              string(lim-kr)) else "") +
     1232             (IF valid-date:sensitive then ("ДАТА ДЕЙСТВИЯ ДО=" +       string(valid-date, "99/99/9999") ) else "") +
     1233             (IF d-pcnt-method:sensitive then ("ТИП СКИДКИ=" +          radio-label(d-pcnt-method, d-pcnt-method:radio-buttons) + chr(10)) else "":U) +
     1234             (IF cli-message:sensitive then ("СООБЩЕНИЕ ДЛЯ КЛИЕНТА=" + string(cli-message, "X(128)" )) else "")
     1235   .
     1236   if REPLACE(mystr, chr(10), "") = "" then do:
     1237     message "Не выбраны поля и значения для внесения изменений" view-as alert-box
     1238     Warning.
     1239     return error .
     1240   end.
     1241   message
     1242   "В выбранных дисконтных картах будут произведены следующие изменения:" skip
     1243   mystr skip "Продолжать?"
     1244   view-as alert-box QUESTION buttons YES-NO update glog.
     1245   IF not glog then return error.
     1246   run str/diallog.w (
     1247                input parparentproc
     1248               ,input this-procedure
     1249               ,input 'utl/discarun.p':U
     1250               ,input
     1251               (v-cntxt-obj-type + chr(4) +
     1252                string(v-cntxt-obj-code) + chr(4) +
     1253               (IF dc-status:sensitive     then (dc-status + chr(44) + string(ok-to-restore)) else "":U )     + chr(4) +
     1254               (IF b-type:sensitive        then dc-type  else "":U )                                               + chr(4) +
     1255               (IF b-type:sensitive        then string(dis-card-type.emitent-host-code)  else "":U )               + chr(4) +
     1256               (IF d-pcnt:sensitive        then string(d-pcnt) else "")                                            + chr(4) +
     1257               (IF cash-d-pcnt:sensitive   then string(cash-d-pcnt)  else "")                                      + chr(4) +
     1258               (IF category:sensitive      then string(category)  else "")                                         + chr(4) +
     1259               (IF issue-date:sensitive    then string(issue-date, "99/99/9999") else "")                          + chr(4) +
     1260               (IF issue-code:sensitive    then string(issue-code)  else "")                                       + chr(4) +
     1261               (IF credit-card:sensitive   then string(credit-card)  else "")                                      + chr(4) +
     1262               (IF debet-card:sensitive    then string(debet-card) else "")                                        + chr(4) +
     1263               (IF staff-card:sensitive    then string(staff-card) else "")                                        + chr(4) +
     1264               (IF lim-kr:sensitive        then string(lim-kr) else "")                                            + chr(4) +
     1265               (IF valid-from:sensitive    then string(valid-from, "99/99/9999") else "")                          + chr(4) +
     1266               (IF valid-date:sensitive    then string(valid-date, "99/99/9999") else "")                          + chr(4) +
     1267               (IF d-pcnt-method:sensitive then string(d-pcnt-method) else "":U)                                   + chr(4) +
     1268               (IF cli-message:sensitive   then string(cli-message, "X(128)" ) else "") +
     1269               chr(1) +
     1270               (IF dc-status:sensitive     then "yes" else "no":U)                                                 + chr(4) +
     1271               (IF b-type:sensitive        then "yes" else "no":U)                                                 + chr(4) +
     1272               (IF b-type:sensitive        then "yes" else "no":U)                                                 + chr(4) +
     1273               (IF d-pcnt:sensitive        then "yes" else "no":U)                                                 + chr(4) +
     1274               (IF cash-d-pcnt:sensitive   then "yes" else "no":U)                                                 + chr(4) +
     1275               (IF category:sensitive      then "yes" else "no":U)                                                 + chr(4) +
     1276               (IF issue-date:sensitive    then "yes" else "no":U)                                                 + chr(4) +
     1277               (IF issue-code:sensitive    then "yes" else "no":U)                                                 + chr(4) +
     1278               (IF credit-card:sensitive   then "yes" else "no":U)                                                 + chr(4) +
     1279               (IF debet-card:sensitive    then "yes" else "no":U)                                                 + chr(4) +
     1280               (IF staff-card:sensitive    then "yes" else "no":U)                                                 + chr(4) +
     1281               (IF lim-kr:sensitive        then "yes" else "no":U)                                                 + chr(4) +
     1282               (IF valid-from:sensitive    then "yes" else "no":U)                                                 + chr(4) +
     1283               (IF valid-date:sensitive    then "yes" else "no":U)                                                 + chr(4) +
     1284               (IF d-pcnt-method:sensitive then "yes" else "no":U)                                                 + chr(4) +
     1285               (IF cli-message:sensitive   then "yes" else "no":U)
     1286               )
     1287               ,input no
     1288               ,input "&Стоп"
     1289               ,input 'Изменение ДК по списку') .
     1290   END PROCEDURE.
     1291   PROCEDURE disable_UI :
     1292     HIDE FRAME Dialog-Frame.
     1293   END PROCEDURE.
     1294   PROCEDURE enable_UI :
     1295     OPEN QUERY Dialog-Frame FOR EACH ub.dis-card SHARE-LOCK.
     1296     GET FIRST Dialog-Frame.
     1297     DISPLAY cash-d-pcnt category d-pcnt d-pcnt-method valid-date issue-date
     1298             valid-from issue-code debet-card staff-card credit-card lim-kr
     1299             dc-status cli-message n-dc-type dc-type n-cash-d-pcnt n-category
     1300             n-d-pcnt n-d-pcnt-method n-valid-date n-valid-from n-issue-date
     1301             n-issue-code n-debet-card n-staff-card n-credit-card n-lim-kr
     1302             n-dc-status n-cli-message
     1303         WITH FRAME Dialog-Frame.
     1304     ENABLE b-exit l-category l-cli-message l-credit-card l-d-pcnt l-d-pcnt-method
     1305            l-dc-status l-dc-type l-debet-card l-issue-code l-issue-date l-lim-kr
     1306            l-staff-card l-valid-date RECT-1 RECT-3 RECT-5 RECT-6 RECT-7
     1307            l-cash-d-pcnt l-valid-from B-quit B-lst B-Help d-pcnt-method n-dc-type
     1308            dc-type n-cash-d-pcnt n-category n-d-pcnt n-d-pcnt-method n-valid-date
     1309            n-valid-from n-issue-date n-issue-code n-debet-card n-staff-card
     1310            n-credit-card n-lim-kr n-dc-status n-cli-message
     1311         WITH FRAME Dialog-Frame.
     1312     VIEW FRAME Dialog-Frame.
     1313   END PROCEDURE.
     1314   PROCEDURE MyEnable :
     1315     OPEN QUERY Dialog-Frame FOR EACH ub.dis-card SHARE-LOCK.
     1316     GET FIRST Dialog-Frame.
     1317     assign
     1318       d-pcnt = ?
     1319       cash-d-pcnt = ?
     1320       category = ?
     1321       .
     1322     DISPLAY cash-d-pcnt d-pcnt category d-pcnt-method valid-date issue-date issue-code
     1323             credit-card cli-message debet-card staff-card lim-kr dc-status n-dc-type dc-type n-cash-d-pcnt n-d-pcnt
     1324             n-d-pcnt-method n-valid-date n-issue-date n-issue-code n-credit-card n-debet-card n-staff-card
     1325             n-lim-kr n-dc-status n-cli-message
     1326         WITH FRAME Dialog-Frame.
     1327     ENABLE b-exit l-dc-type l-cash-d-pcnt l-category l-credit-card l-debet-card l-staff-card
     1328             l-d-pcnt  l-lim-kr
     1329            l-dc-status l-issue-code l-issue-date l-valid-date
     1330            l-d-pcnt-method l-cli-message B-quit B-lst B-Help n-dc-type
     1331            n-cash-d-pcnt n-d-pcnt n-d-pcnt-method n-valid-date
     1332            n-issue-date n-issue-code n-credit-card n-lim-kr n-dc-status n-debet-card n-staff-card n-cli-message
     1333         WITH FRAME Dialog-Frame.
     1334     VIEW FRAME Dialog-Frame.
     1335   END PROCEDURE.
     1336   PROCEDURE proc-b-type :
     1337   define variable var-rid-str as character no-undo.
     1338   define variable v-d-pcnt as decimal no-undo .
     1339   define variable v-cash-d-pcnt as decimal no-undo .
     1340   define variable v-categ as integer no-undo .
     1341   define buffer b_clients for ub.clients.
     1342     run ref/dc-types.w (
     1343                     input parparentproc
     1344                   ,input "":U
     1345                   ,input "b-sel":U
     1346                   ,input 0
     1347                   ,input 0
     1348                   ,input "":U
     1349                   ,input 0
     1350                   ,input-output  var-rid-str) .
     1351     if var-rid-str = "" then return ERROR.
     1352   find first ub.dis-card-type no-lock where
     1353                 recid(ub.dis-card-type) = integer(var-rid-str) No-ERROR.
     1354   if not avail ub.dis-card-type then return ERROR.
     1355   if ub.dis-card-type.emitent-host-code = 0 then do:
     1356   end.
     1357   else do:
     1358         find first b_clients No-LOCK WHERE
     1359                 b_clients.obj-type = 'орг':U and
     1360                 b_clients.obj-code = ub.dis-card-type.emitent-host-code No-ERROR.
     1361         if not avail b_clients then return ERROR.
     1362   end.
     1363   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1364   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1365     (
     1366      input  ub.dis-card-type.type
     1367     ,input  ub.dis-card-type.emitent-host-code
     1368     ,input  0
     1369     ,input  '':U
     1370     ,input  0
     1371     ,input  'def-pcnt':U
     1372     ,output v-d-pcnt
     1373     )  .
     1374   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1376     (
     1377      input  ub.dis-card-type.type
     1378     ,input  ub.dis-card-type.emitent-host-code
     1379     ,input  0
     1380     ,input  '':U
     1381     ,input  0
     1382     ,input  'def-pcnt':U
     1383     ,output v-cash-d-pcnt
     1384     )  .
     1385   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1387     (
     1388      input  ub.dis-card-type.type
     1389     ,input  ub.dis-card-type.emitent-host-code
     1390     ,input  0
     1391     ,input  '':U
     1392     ,input  0
     1393     ,input  'def-categ':U
     1394     ,output v-categ
     1395     )  .
     1396   if v-d-pcnt = ? then do:
     1397     v-d-pcnt = 0.
     1398   end.
     1399   if v-cash-d-pcnt = ? then do:
     1400     v-cash-d-pcnt = 0.
     1401   end.
     1402   if v-categ = ? then do:
     1403     v-categ = 0.
     1404   end.
     1405   display
     1406   ub.dis-card-type.type @ dc-type
     1407   ub.dis-card-type.emitent-host-code @ emitent-host-code
     1408   v-d-pcnt @ d-pcnt
     1409   v-cash-d-pcnt @ cash-d-pcnt
     1410   with frame Dialog-Frame
     1411   .
     1412   if ub.dis-card-type.dflt-credit-card then do:
     1413     APPLY   "mouse-select-click" TO l-credit-card.
     1414     APPLY   "mouse-select-click" TO l-LIM-KR.
     1415     CREDIT-CARD:SCREEN-VALUE = "YES".
     1416     display
     1417     ub.dis-card-type.lim-kr @ lim-kr
     1418     with frame Dialog-Frame.
     1419   end.
     1420   else do:
     1421     APPLY   "right-mouse-click" TO credit-card.
     1422     APPLY   "right-mouse-click" TO LIM-KR.
     1423   end.
     1424   END PROCEDURE.
