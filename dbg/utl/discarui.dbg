      159   function diff-list returns character (
      160     input parfirst-list  as character,
      161     input parsecond-list as character,
      162     input pardelim       as character).
      163     if pardelim = ""
      164     or pardelim = ?
      165     then do:
      166       assign
      167         pardelim = ","
      168       .
      169     end.
      170     def var ind as integer no-undo .
      171     def var v-elem as character no-undo .
      172     def var v-result-list as character no-undo init "".
      173     def var v-num-parfirst-list as integer no-undo .
      174     assign
      175       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      176     .
      177     do ind = 1 to v-num-parfirst-list
      178     :
      179       assign
      180         v-elem = entry(ind, parfirst-list, pardelim)
      181       .
      182       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      183         assign
      184           v-result-list = v-result-list
      185                         + (if v-result-list > "" then pardelim else "")
      186                         + v-elem
      187         .
      188       end.
      189     end.
      190     return v-result-list .
      191   end function.
      192   function add-list returns character (
      193    input parfirst-list  as character,
      194    input parsecond-list as character,
      195    input pardelim       as character).
      196     if pardelim = ""
      197     or pardelim = ?
      198     then do:
      199       assign
      200         pardelim = ","
      201       .
      202     end.
      203     def var ind as integer no-undo .
      204     def var v-elem as character no-undo .
      205     def var v-result-list as character no-undo init "".
      206     def var v-num-parfirst-list as integer no-undo .
      207     assign
      208       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      209     .
      210     do ind = 1 to v-num-parfirst-list
      211     :
      212       assign
      213         v-elem = entry(ind, parfirst-list, pardelim)
      214       .
      215       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      216         assign
      217           v-result-list = v-result-list
      218                         + (if v-result-list > "" then pardelim else "")
      219                         + v-elem
      220         .
      221       end.
      222     end.
      223     def var v-num-parsecond-list as integer no-undo .
      224     assign
      225       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      226     .
      227     do ind = 1 to v-num-parsecond-list
      228     :
      229       assign
      230         v-elem = entry(ind, parsecond-list, pardelim)
      231       .
      232       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      233         assign
      234           v-result-list = v-result-list
      235                         + (if v-result-list > "" then pardelim else "")
      236                         + v-elem
      237         .
      238       end.
      239     end.
      240     return v-result-list .
      241   end function.
      242   function cross-list returns character (
      243    input parfirst-list  as character,
      244    input parsecond-list as character,
      245    input pardelim       as character).
      246     if pardelim = ""
      247     or pardelim = ?
      248     then do:
      249       assign
      250         pardelim = ","
      251       .
      252     end.
      253     def var ind as integer no-undo .
      254     def var v-elem as character no-undo .
      255     def var v-result-list as character no-undo init "".
      256     def var v-num-parfirst-list as integer no-undo .
      257     assign
      258       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      259     .
      260     do ind = 1 to v-num-parfirst-list
      261     :
      262       assign
      263         v-elem = entry(ind, parfirst-list, pardelim)
      264       .
      265       if lookup(v-elem, v-result-list, pardelim) = 0
      266       and lookup(v-elem, parsecond-list, pardelim) > 0
      267       then do:
      268         assign
      269           v-result-list = v-result-list
      270                         + (if v-result-list > "" then pardelim else "")
      271                         + v-elem
      272         .
      273       end.
      274     end.
      275     return v-result-list .
      276   end function.
      277   function radio-label returns character (
      278    input par-rs-value  as character,
      279    input par-rs-radio-buttons as character)
      280    .
      281    DEFINE variable v-result-label as character no-undo.
      282    assign
      283    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      284                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      285                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      286                             ), par-rs-radio-buttons
      287                           )
      288    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      289    .
      290   return v-result-label.
      291   end function.
      292   function m-radio-label returns character (
      293    input par-rs-value  as character,
      294    input par-rs-radio-buttons as character,
      295    input par-delim as character
      296    )
      297    .
      298    DEFINE variable v-result-label as character no-undo.
      299    assign
      300    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      301                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      302                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      303                             ), par-rs-radio-buttons, par-delim
      304                           )
      305    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      306    .
      307   return v-result-label.
      308   end function.
      309   FUNCTION mixlist returns character
      310   (
      311    input parfirst-list  as character
      312    ,input parsecond-list as character
      313    ,input pardelim       as character
      314    ,input pardelim-result as character ) :
      315     if pardelim = ""
      316     or pardelim = ?
      317     then do:
      318       assign
      319         pardelim = ","
      320       .
      321     end.
      322     def var ind as integer no-undo .
      323     def var v-elem1 as character no-undo .
      324     def var v-elem2 as character no-undo .
      325     def var v-result-list as character no-undo init "".
      326     do ind = 1 to num-entries(parfirst-list, pardelim)
      327     :
      328       assign
      329         v-elem1 = entry(ind, parfirst-list, pardelim)
      330         v-elem2 = entry(ind, parsecond-list, pardelim)
      331       .
      332         assign
      333           v-result-list = v-result-list
      334                         + (if v-result-list > "" then pardelim-result else "")
      335                         + v-elem1 + pardelim-result + v-elem2
      336         .
      337     end.
      338     return v-result-list .
      339   END FUNCTION.
