     2502   define buffer calc-arh-lock_batchprocess for ub.batchprocess .
     2503   define variable v-user-select         as logical   no-undo .
     2504   define variable v-obj-type            as character no-undo .
     2505   define variable v-obj-code            as integer   no-undo .
