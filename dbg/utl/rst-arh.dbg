     4485   procedure ahrstutl-init-line :
     4486     define input  parameter p-obj-type                     like ub.gds-obj.obj-type  no-undo .
     4487     define input  parameter p-obj-code                     like ub.gds-obj.obj-code  no-undo .
     4488     define input  parameter p-artic                        like ub.gds-obj.artic     no-undo .
     4489     define input  parameter p-prod-type                    like ub.gds-obj.prod-type no-undo .
     4490     define input  parameter p-prod-code                    like ub.gds-obj.prod-code no-undo .
     4491     define input  parameter p-root-sum-type                as character no-undo .
     4492     define input  parameter p-fact-date                    as date      no-undo .
     4493     define input  parameter p-stk-line-fact-order          as decimal   no-undo .
     4494     define input  parameter p-create-line-fact-order       as decimal   no-undo .
     4495     define input  parameter p-shift-on                     as logical   no-undo .
     4496     define input  parameter p-shift-date                   as date      no-undo .
     4497     define input  parameter p-shift-num                    as integer   no-undo .
     4498     define input  parameter p-shift-stk-line-fact-order    as decimal   no-undo .
     4499     define input  parameter p-shift-create-line-fact-order as decimal   no-undo .
     4500     define input  parameter p-save-new                     as logical   no-undo .
     4501     define buffer buf_stk-line for ub.stk-line .
     4502     define buffer buf_temp-stk-line for temp-stk-line .
     4503     define buffer buf_temp-shift-stk-line for temp-shift-stk-line .
     4504     define buffer buf_temp-create-stk-line for temp-create-stk-line .
     4505     define variable v-prev-stk-line-fact-order       like ub.stk-line.fact-order no-undo .
     4506     define variable v-prev-shift-stk-line-fact-order like ub.stk-line.fact-order no-undo .
     4507     define variable v-create-stk as logical   no-undo .
     4508     do
     4509     on error undo, return error return-value
     4510     :
     4511       assign
     4512         v-create-stk = false
     4513       .
     4514       find last buf_stk-line no-lock
     4515         where buf_stk-line.obj-type   = p-obj-type
     4516           and buf_stk-line.obj-code   = p-obj-code
     4517           and buf_stk-line.artic      = p-artic
     4518           and buf_stk-line.prod-type  = p-prod-type
     4519           and buf_stk-line.prod-code  = p-prod-code
     4520           and buf_stk-line.sum-type   = p-root-sum-type
     4521           and buf_stk-line.fact-order <= p-stk-line-fact-order
     4522         use-index category
     4523         no-error .
     4524       if available buf_stk-line
     4525       then do:
     4526         assign
     4527           v-prev-stk-line-fact-order = buf_stk-line.fact-order
     4528         .
     4529         if v-prev-stk-line-fact-order <> p-stk-line-fact-order
     4530         then do:
     4531           assign
     4532             v-create-stk = true
     4533           .
     4534         end.
     4535         else do:
     4536           assign
     4537             v-create-stk = false
     4538           .
     4539         end.
     4540         for each buf_stk-line no-lock
     4541           where buf_stk-line.obj-type   = p-obj-type
     4542             and buf_stk-line.obj-code   = p-obj-code
     4543             and buf_stk-line.artic      = p-artic
     4544             and buf_stk-line.prod-type  = p-prod-type
     4545             and buf_stk-line.prod-code  = p-prod-code
     4546             and buf_stk-line.fact-order = v-prev-stk-line-fact-order
     4547             and buf_stk-line.sum-type   begins p-root-sum-type
     4548         on error undo, return error return-value
     4549         :
     4550           find first buf_temp-stk-line
     4551             where buf_temp-stk-line.obj-type   = buf_stk-line.obj-type
     4552               and buf_temp-stk-line.obj-code   = buf_stk-line.obj-code
     4553               and buf_temp-stk-line.artic      = buf_stk-line.artic
     4554               and buf_temp-stk-line.prod-type  = buf_stk-line.prod-type
     4555               and buf_temp-stk-line.prod-code  = buf_stk-line.prod-code
     4556               and buf_temp-stk-line.fact-order = p-create-line-fact-order
     4557               and buf_temp-stk-line.sum-type   = buf_stk-line.sum-type
     4558               and buf_temp-stk-line.cat-id     = buf_stk-line.cat-id
     4559             no-error .
     4560           if not available buf_temp-stk-line
     4561           then do:
     4562             create buf_temp-stk-line .
     4563             assign
     4564                                       buf_temp-stk-line.obj-type     = buf_stk-line.obj-type     buf_temp-stk-line.obj-code     = buf_stk-line.obj-code     buf_temp-stk-line.artic        = buf_stk-line.artic        buf_temp-stk-line.prod-type    = buf_stk-line.prod-type    buf_temp-stk-line.prod-code    = buf_stk-line.prod-code    buf_temp-stk-line.fact-order   = buf_stk-line.fact-order   buf_temp-stk-line.sum-type     = buf_stk-line.sum-type     buf_temp-stk-line.cat-id       = buf_stk-line.cat-id       buf_temp-stk-line.fact-date    = buf_stk-line.fact-date    buf_temp-stk-line.shift-num    = buf_stk-line.shift-num    buf_temp-stk-line.shift-date   = buf_stk-line.shift-date
     4565               buf_temp-stk-line.fact-order = p-create-line-fact-order
     4566               buf_temp-stk-line.fact-date  = p-fact-date
     4567               buf_temp-stk-line.shift-num  = 0
     4568               buf_temp-stk-line.shift-date = ?
     4569             .
     4570           end.
     4571           if p-save-new = true
     4572           then do:
     4573             assign
     4574                                                                                       buf_temp-stk-line.new-fact-qnty      = buf_stk-line.fact-qnty            buf_temp-stk-line.new-sum-base       = buf_stk-line.sum-base             buf_temp-stk-line.new-sum-rubl       = buf_stk-line.sum-rubl             buf_temp-stk-line.new-vat-base       = buf_stk-line.vat-base             buf_temp-stk-line.new-vat-rubl       = buf_stk-line.vat-rubl             buf_temp-stk-line.new-slt-base       = buf_stk-line.slt-base             buf_temp-stk-line.new-slt-rubl       = buf_stk-line.slt-rubl             buf_temp-stk-line.new-road-tax-base  = buf_stk-line.road-tax-base        buf_temp-stk-line.new-road-tax-rubl  = buf_stk-line.road-tax-rubl        buf_temp-stk-line.new-excise-base    = buf_stk-line.excise-base          buf_temp-stk-line.new-excise-rubl    = buf_stk-line.excise-rubl          buf_temp-stk-line.new-transport-base = buf_stk-line.transport-base       buf_temp-stk-line.new-transport-rubl = buf_stk-line.transport-rubl       buf_temp-stk-line.new-other-base     = buf_stk-line.other-base           buf_temp-stk-line.new-other-rubl     = buf_stk-line.other-rubl
     4575             .
     4576           end.
     4577           else do:
     4578             assign
     4579                                                                                       buf_temp-stk-line.fact-qnty      = buf_stk-line.fact-qnty            buf_temp-stk-line.sum-base       = buf_stk-line.sum-base             buf_temp-stk-line.sum-rubl       = buf_stk-line.sum-rubl             buf_temp-stk-line.vat-base       = buf_stk-line.vat-base             buf_temp-stk-line.vat-rubl       = buf_stk-line.vat-rubl             buf_temp-stk-line.slt-base       = buf_stk-line.slt-base             buf_temp-stk-line.slt-rubl       = buf_stk-line.slt-rubl             buf_temp-stk-line.road-tax-base  = buf_stk-line.road-tax-base        buf_temp-stk-line.road-tax-rubl  = buf_stk-line.road-tax-rubl        buf_temp-stk-line.excise-base    = buf_stk-line.excise-base          buf_temp-stk-line.excise-rubl    = buf_stk-line.excise-rubl          buf_temp-stk-line.transport-base = buf_stk-line.transport-base       buf_temp-stk-line.transport-rubl = buf_stk-line.transport-rubl       buf_temp-stk-line.other-base     = buf_stk-line.other-base           buf_temp-stk-line.other-rubl     = buf_stk-line.other-rubl
     4580             .
     4581           end.
     4582           if p-shift-on = true
     4583           then do:
     4584             find first buf_temp-shift-stk-line
     4585               where buf_temp-shift-stk-line.obj-type   = buf_stk-line.obj-type
     4586                 and buf_temp-shift-stk-line.obj-code   = buf_stk-line.obj-code
     4587                 and buf_temp-shift-stk-line.artic      = buf_stk-line.artic
     4588                 and buf_temp-shift-stk-line.prod-type  = buf_stk-line.prod-type
     4589                 and buf_temp-shift-stk-line.prod-code  = buf_stk-line.prod-code
     4590                 and buf_temp-shift-stk-line.fact-order = p-shift-create-line-fact-order
     4591                 and buf_temp-shift-stk-line.sum-type   = buf_stk-line.sum-type
     4592                 and buf_temp-shift-stk-line.cat-id     = buf_stk-line.cat-id
     4593               no-error .
     4594             if not available buf_temp-shift-stk-line
     4595             then do:
     4596               create buf_temp-shift-stk-line .
     4597               assign
     4598                                             buf_temp-shift-stk-line.obj-type     = buf_stk-line.obj-type     buf_temp-shift-stk-line.obj-code     = buf_stk-line.obj-code     buf_temp-shift-stk-line.artic        = buf_stk-line.artic        buf_temp-shift-stk-line.prod-type    = buf_stk-line.prod-type    buf_temp-shift-stk-line.prod-code    = buf_stk-line.prod-code    buf_temp-shift-stk-line.fact-order   = buf_stk-line.fact-order   buf_temp-shift-stk-line.sum-type     = buf_stk-line.sum-type     buf_temp-shift-stk-line.cat-id       = buf_stk-line.cat-id       buf_temp-shift-stk-line.fact-date    = buf_stk-line.fact-date    buf_temp-shift-stk-line.shift-num    = buf_stk-line.shift-num    buf_temp-shift-stk-line.shift-date   = buf_stk-line.shift-date
     4599                 buf_temp-shift-stk-line.fact-order = p-shift-create-line-fact-order
     4600                 buf_temp-shift-stk-line.fact-date  = p-fact-date
     4601                 buf_temp-shift-stk-line.shift-date = p-shift-date
     4602                 buf_temp-shift-stk-line.shift-num  = p-shift-num
     4603               .
     4604             end.
     4605             if p-save-new = true
     4606             then do:
     4607               assign
     4608                                                                                                     buf_temp-shift-stk-line.new-fact-qnty      = buf_stk-line.fact-qnty            buf_temp-shift-stk-line.new-sum-base       = buf_stk-line.sum-base             buf_temp-shift-stk-line.new-sum-rubl       = buf_stk-line.sum-rubl             buf_temp-shift-stk-line.new-vat-base       = buf_stk-line.vat-base             buf_temp-shift-stk-line.new-vat-rubl       = buf_stk-line.vat-rubl             buf_temp-shift-stk-line.new-slt-base       = buf_stk-line.slt-base             buf_temp-shift-stk-line.new-slt-rubl       = buf_stk-line.slt-rubl             buf_temp-shift-stk-line.new-road-tax-base  = buf_stk-line.road-tax-base        buf_temp-shift-stk-line.new-road-tax-rubl  = buf_stk-line.road-tax-rubl        buf_temp-shift-stk-line.new-excise-base    = buf_stk-line.excise-base          buf_temp-shift-stk-line.new-excise-rubl    = buf_stk-line.excise-rubl          buf_temp-shift-stk-line.new-transport-base = buf_stk-line.transport-base       buf_temp-shift-stk-line.new-transport-rubl = buf_stk-line.transport-rubl       buf_temp-shift-stk-line.new-other-base     = buf_stk-line.other-base           buf_temp-shift-stk-line.new-other-rubl     = buf_stk-line.other-rubl
     4609               .
