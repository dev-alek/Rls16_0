     1005     index xie1 artic prod-type prod-code
     1006     .
     1007   define buffer inkas_trn-doc for ub.trn-doc .
     1008   define stream doclsliblog .
     1009   procedure doclslib-clear-doc-list :
     1010     define buffer buf_doc-list for doc-list .
     1011     do
     1012     on error undo, return error
     1013     :
     1014       for each buf_doc-list
     1015       on error undo, return error
     1016       :
     1017         delete buf_doc-list .
     1018       end.
     1019     end.
     1020   end procedure.
     1021   procedure doclslib-init-trn-doc :
     1022     define input parameter p-obj-type      as character no-undo .
     1023     define input parameter p-obj-code      as integer   no-undo .
     1024     define input parameter p-cut-date      as date      no-undo .
     1025     define buffer buf_trn-doc for ub.trn-doc .
     1026     define buffer buf_doc-list for doc-list .
     1027     do
     1028     on error undo, return error
     1029     :
     1030       if p-cut-date = ?
     1031       then do:
     1032         for each buf_trn-doc no-lock
     1033           where buf_trn-doc.obj-type = p-obj-type
     1034             and buf_trn-doc.obj-code = p-obj-code
     1035             and buf_trn-doc.status_  = 'факт':U
     1036         on error undo, return error
     1037         :
     1038           create buf_doc-list .
     1039           assign
     1040             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1041             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1042             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1043             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1044             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1045             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1046             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1047             buf_doc-list.is-trn-doc = true
     1048           .
     1049         end.
     1050       end.
     1051       else do:
     1052         for each buf_trn-doc no-lock
     1053           where buf_trn-doc.obj-type  = p-obj-type
     1054             and buf_trn-doc.obj-code  = p-obj-code
     1055             and buf_trn-doc.status_   = 'факт':U
     1056             and buf_trn-doc.fact-date >= p-cut-date
     1057         on error undo, return error
     1058         :
     1059           create buf_doc-list .
     1060           assign
     1061             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1062             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1063             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1064             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1065             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1066             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1067             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1068             buf_doc-list.is-trn-doc = true
     1069           .
     1070         end.
     1071       end.
     1072     end.
     1073   end procedure.
     1074   procedure doclslib-init-price-doc :
     1075     define input parameter p-obj-type      as character no-undo .
     1076     define input parameter p-obj-code      as integer   no-undo .
     1077     define input parameter p-cut-date      as date      no-undo .
     1078     define buffer buf_price-doc for ub.price-doc .
     1079     define buffer buf_doc-list for doc-list .
     1080     do
     1081     on error undo, return error
     1082     :
     1083       if p-cut-date = ?
     1084       then do:
     1085         for each buf_price-doc no-lock
     1086           where buf_price-doc.obj-type = p-obj-type
     1087             and buf_price-doc.obj-code = p-obj-code
     1088             and buf_price-doc.status_  = 'акт':U
     1089         on error undo, return error
     1090         :
     1091           create buf_doc-list .
     1092           assign
     1093             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1094             buf_doc-list.doc-type   = ''
     1095             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1096             buf_doc-list.shift-date = buf_price-doc.shift-date
     1097             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1098             buf_doc-list.shift-name = buf_price-doc.shift-name
     1099             buf_doc-list.fact-order = buf_price-doc.fact-order
     1100             buf_doc-list.is-trn-doc = false
     1101           .
     1102         end.
     1103       end.
     1104       else do:
     1105         for each buf_price-doc no-lock
     1106           where buf_price-doc.obj-type = p-obj-type
     1107             and buf_price-doc.obj-code = p-obj-code
     1108             and buf_price-doc.status_  = 'акт':U
     1109             and ub.buf_price-doc.fact-date >= p-cut-date
     1110         on error undo, return error
     1111         :
     1112           create buf_doc-list .
     1113           assign
     1114             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1115             buf_doc-list.doc-type   = ''
     1116             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1117             buf_doc-list.shift-date = buf_price-doc.shift-date
     1118             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1119             buf_doc-list.shift-name = buf_price-doc.shift-name
     1120             buf_doc-list.fact-order = buf_price-doc.fact-order
     1121             buf_doc-list.is-trn-doc = false
     1122           .
     1123         end.
     1124       end.
     1125     end.
     1126   end procedure.
     1127   procedure doclslib-clear-bydate-doc-list :
     1128     define input parameter p-fact-date as date no-undo .
     1129     define buffer buf_doc-list for doc-list .
     1130     do
     1131     on error undo, return error
     1132     :
     1133       if p-fact-date <> ?
     1134       then do:
     1135         for each buf_doc-list
     1136           where buf_doc-list.fact-date < p-fact-date
     1137         on error undo, return error
     1138         :
     1139           delete buf_doc-list .
     1140         end.
     1141       end.
     1142     end.
     1143   end procedure.
     1144   procedure doclslib-clear-rst :
     1145     define input parameter p-fact-date as date no-undo .
     1146     define buffer buf_doc-list for doc-list .
     1147     do
     1148     on error undo, return error
     1149     :
     1150       if p-fact-date <> ?
     1151       then do:
     1152         for each buf_doc-list
     1153           where buf_doc-list.fact-date >= p-fact-date
     1154         on error undo, return error
     1155         :
     1156           delete buf_doc-list .
     1157         end.
     1158       end.
     1159     end.
     1160   end procedure.
     1161   procedure doclslib-export-doc-list :
     1162     define input  parameter p-obj-type      as character no-undo .
     1163     define input  parameter p-obj-code      as integer no-undo .
     1164     define input  parameter p-log-file-name as character no-undo .
     1165     define input  parameter p-description   as character no-undo .
     1166     define buffer buf_doc-list for doc-list .
     1167     do
     1168     on error undo, return error
     1169     :
     1170       output stream doclsliblog to value(p-log-file-name) .
     1171       export stream doclsliblog "#############################################################" .
     1172       export stream doclsliblog "Список документов" .
     1173       export stream doclsliblog p-description .
     1174       export stream doclsliblog "Объект" p-obj-type p-obj-code .
     1175       export stream doclsliblog "Дата" string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     1176       for each buf_doc-list
     1177       by buf_doc-list.fact-order
     1178       on error undo, return error
     1179       :
     1180         export stream doclsliblog buf_doc-list .
     1181       end.
     1182       export stream doclsliblog "#############################################################" .
     1183       output stream doclsliblog close .
     1184     end.
     1185   end procedure.
     1186   procedure doclslib-clear-batch-process :
     1187     define input parameter p-bp_type like ub.batchprocess.bp_type no-undo .
     1188     define buffer buf_batchprocess        for ub.batchprocess .
     1189     define buffer execdelete_batchprocess for ub.batchprocess .
     1190     define buffer buf_doc-list            for doc-list .
     1191     for each buf_doc-list
     1192     on end-key undo, return error substitute( "doclslib-clear-batch-process. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1193     on error   undo, return error substitute( "doclslib-clear-batch-process. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1194     on stop    undo, return error substitute( "doclslib-clear-batch-process. STOP      &2"
     1195                                    + "bp_type &3&2"
     1196                                    + "Документ &4"
     1197                                    , chr(10)
     1198                                    , p-bp_type
     1199                                    , buf_doc-list.doc-code
     1200                                   )
     1201     :
     1202       find first buf_batchprocess exclusive-lock
     1203         where buf_BatchProcess.BP_Status   = 'N':U
     1204           and buf_batchprocess.bp_type     = p-bp_type
     1205           and buf_batchprocess.charkey_one = buf_doc-list.doc-code
     1206         no-error .
     1207       if available buf_batchprocess
     1208       then do:
     1209         delete buf_batchprocess .
     1210       end.
     1211     end.
     1212   end procedure.
     1213   procedure doclslib-calc-arh :
     1214     define input  parameter p-log-handle     as handle    no-undo .
     1215     define input  parameter p-obj-type       as character no-undo .
     1216     define input  parameter p-obj-code       as integer   no-undo .
     1217     define input  parameter p-cut-date       as date      no-undo .
     1218     define input  parameter p-update-recalc  as logical   no-undo .
     1219     define variable v-prev-fact-date as date      no-undo .
     1220     define buffer buf_doc-list for doc-list .
     1221     define buffer stop-arh-restore-lock_btpr for ub.batchprocess .
     1222     define buffer stop-arh-news-lock_btpr    for ub.batchprocess .
     1223     do
     1224     on stop    undo, return error substitute( "doclslib-calc-arh. stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1225     on end-key undo, return error substitute( "doclslib-calc-arh. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1226     on error   undo, return error substitute( "doclslib-calc-arh. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1227     :
     1228       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1229       run gbl/lockrngd.p
     1230         (input  'grar':U
     1231         ,input  'disable':U
     1232         ,buffer buf_lock_gdsrenart_batchprocess
     1233         ) no-error .
     1234       if error-status :error
     1235       then do:
     1236         if error-status :get-message(1) <> ""
     1237         then do:
     1238           message
     1239             vss-workfile vss-revision vss-description skip
     1240             "Ошибка при блокировании функции переименования артикула товара" skip
     1241             error-status :get-message(1) skip
     1242             return-value skip
     1243             view-as alert-box error .
     1244         end.
     1245         undo, return error return-value .
     1246       end.
     1247       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1248       run gbl/lockrngd.p
     1249         (input  'grgc':U
     1250         ,input  'disable':U
     1251         ,buffer buf_lock_gdsrengc_batchprocess
     1252         ) no-error .
     1253       if error-status :error
     1254       then do:
     1255         if error-status :get-message(1) <> ""
     1256         then do:
     1257           message
     1258             vss-workfile vss-revision vss-description skip
     1259             "Ошибка при блокировании функции переименования кода товара" skip
     1260             error-status :get-message(1) skip
     1261             return-value skip
     1262             view-as alert-box error .
     1263         end.
     1264         undo, return error return-value .
     1265       end.
     1266       for each buf_doc-list
     1267       by buf_doc-list.fact-order
     1268       on stop    undo, return error substitute( "f e . stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1269       on end-key undo, return error substitute( "f e . end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1270       on error   undo, return error substitute( "f e . error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1271       :
     1272         find first stop-arh-restore-lock_btpr no-lock
     1273           where stop-arh-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
     1274             and stop-arh-restore-lock_btpr.bp_status     = 'N':U
     1275             and stop-arh-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1276             and stop-arh-restore-lock_btpr.Key#_Two      = 0
     1277             and stop-arh-restore-lock_btpr.Key#_Three    = 0
     1278             and stop-arh-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1279             and stop-arh-restore-lock_btpr.CharKey_Two   = ""
     1280             and stop-arh-restore-lock_btpr.CharKey_Three = ""
     1281           no-error .
     1282         if available stop-arh-restore-lock_btpr
     1283         then do:
     1284           run doclslib-log-information in this-procedure
     1285             (input p-log-handle
     1286             ,input "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива"
     1287             ) .
     1288           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1289         end.
     1290         find first stop-arh-news-lock_btpr no-lock
     1291           where stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
     1292             and stop-arh-news-lock_btpr.bp_status     = 'N':U
     1293             and stop-arh-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1294             and stop-arh-news-lock_btpr.Key#_Two      = 0
     1295             and stop-arh-news-lock_btpr.Key#_Three    = 0
     1296             and stop-arh-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1297             and stop-arh-news-lock_btpr.CharKey_Three = ""
     1298           no-error .
     1299         if available stop-arh-news-lock_btpr
     1300         then do:
     1301           run doclslib-log-information in this-procedure
     1302             (input p-log-handle
     1303             ,input "Система новостей запросила остановку процедуры расчета складского архива"
     1304             ) .
     1305           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1306         end.
     1307         if buf_doc-list.is-trn-doc
     1308         then do:
     1309           run doclslib-log-information in this-procedure
     1310             (input p-log-handle
     1311             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1312                              ,buf_doc-list.doc-code
     1313                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1314                              ,buf_doc-list.fact-order
     1315                              )
     1316             ) .
     1317           run trg/calc-arh.p
     1318             (input buf_doc-list.doc-code
     1319             ,input p-cut-date
     1320             ).
     1321           run doclslib-log-information in this-procedure
     1322             (input p-log-handle
     1323             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1324                              ,buf_doc-list.doc-code
     1325                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1326                              ,buf_doc-list.fact-order
     1327                              )
     1328             ) .
     1329         end.
     1330         else do:
     1331           run doclslib-log-information in this-procedure
     1332             (input p-log-handle
     1333             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1334                              ,buf_doc-list.doc-code
     1335                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1336                              ,buf_doc-list.fact-order
     1337                              )
     1338             ) .
     1339           run trg/calc-apc.p
     1340             (input buf_doc-list.doc-code
     1341             ,input p-cut-date
     1342             ).
     1343           run doclslib-log-information in this-procedure
     1344             (input p-log-handle
     1345             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1346                              ,buf_doc-list.doc-code
     1347                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1348                              ,buf_doc-list.fact-order
     1349                              )
     1350             ) .
     1351         end.
     1352         if  p-update-recalc  = true
     1353         and v-prev-fact-date <> ?
     1354         and buf_doc-list.fact-date > v-prev-fact-date
     1355         then do:
     1356           run gbl/clntat-w.p
     1357             (input p-obj-type
     1358             ,input p-obj-code
     1359             ,input 'arh-recalc':U
     1360             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1361             ) .
     1362           run doclslib-log-information in this-procedure
     1363             (input p-log-handle
     1364             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1365                              ,string(v-prev-fact-date, '99/99/9999':u)
     1366                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1367                              )
     1368             ) .
     1369         end.
     1370         assign
     1371           v-prev-fact-date = buf_doc-list.fact-date
     1372         .
     1373       end.
     1374     end.
     1375   end procedure.
     1376   procedure doclslib-calc-aht :
     1377     define input  parameter p-log-handle    as handle    no-undo .
     1378     define input  parameter p-obj-type      as character no-undo .
     1379     define input  parameter p-obj-code      as integer   no-undo .
     1380     define input  parameter p-cut-date      as date      no-undo .
     1381     define input  parameter p-update-recalc as logical   no-undo .
     1382     define variable v-prev-fact-date as date      no-undo .
     1383     define buffer buf_doc-list for doc-list .
     1384     define buffer stop-aht-restore-lock_btpr for ub.batchprocess .
     1385     define buffer stop-aht-news-lock_btpr    for ub.batchprocess .
     1386     do
     1387     on error undo, return error return-value
     1388     :
     1389       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1390       run gbl/lockrngd.p
     1391         (input  'grar':U
     1392         ,input  'disable':U
     1393         ,buffer buf_lock_gdsrenart_batchprocess
     1394         ) no-error .
     1395       if error-status :error
     1396       then do:
     1397         if error-status :get-message(1) <> ""
     1398         then do:
     1399           message
     1400             vss-workfile vss-revision vss-description skip
     1401             "Ошибка при блокировании функции переименования артикула товара" skip
     1402             error-status :get-message(1) skip
     1403             return-value skip
     1404             view-as alert-box error .
     1405         end.
     1406         undo, return error return-value .
     1407       end.
     1408       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1409       run gbl/lockrngd.p
     1410         (input  'grgc':U
     1411         ,input  'disable':U
     1412         ,buffer buf_lock_gdsrengc_batchprocess
     1413         ) no-error .
     1414       if error-status :error
     1415       then do:
     1416         if error-status :get-message(1) <> ""
     1417         then do:
     1418           message
     1419             vss-workfile vss-revision vss-description skip
     1420             "Ошибка при блокировании функции переименования кода товара" skip
     1421             error-status :get-message(1) skip
     1422             return-value skip
     1423             view-as alert-box error .
     1424         end.
     1425         undo, return error return-value .
     1426       end.
     1427       for each buf_doc-list
     1428       by buf_doc-list.fact-order
     1429       on error undo, return error
     1430       :
     1431         find first stop-aht-restore-lock_btpr no-lock
     1432           where stop-aht-restore-lock_btpr.bp_type       = 'lock':U + 'rsts':U
     1433             and stop-aht-restore-lock_btpr.bp_status     = 'N':U
     1434             and stop-aht-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1435             and stop-aht-restore-lock_btpr.Key#_Two      = 0
     1436             and stop-aht-restore-lock_btpr.Key#_Three    = 0
     1437             and stop-aht-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1438             and stop-aht-restore-lock_btpr.CharKey_Two   = ""
     1439             and stop-aht-restore-lock_btpr.CharKey_Three = ""
     1440           no-error .
     1441         if available stop-aht-restore-lock_btpr
     1442         then do:
     1443           undo, return error "Процедура восстановления складского архива запросила остановку процедуры автоматического расчета складского архива" .
     1444         end.
     1445         find first stop-aht-news-lock_btpr no-lock
     1446           where stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
     1447             and stop-aht-news-lock_btpr.bp_status     = 'N':U
     1448             and stop-aht-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1449             and stop-aht-news-lock_btpr.Key#_Two      = 0
     1450             and stop-aht-news-lock_btpr.Key#_Three    = 0
     1451             and stop-aht-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1452             and stop-aht-news-lock_btpr.CharKey_Three = ""
     1453           no-error .
     1454         if available stop-aht-news-lock_btpr
     1455         then do:
     1456           undo, return error "Система новостей запросила остановку процедуры автоматического расчета складского архива" .
     1457         end.
     1458         if buf_doc-list.is-trn-doc
     1459         then do:
     1460           run doclslib-log-information in this-procedure
     1461             (input p-log-handle
     1462             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1463                              ,buf_doc-list.doc-code
     1464                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1465                              ,buf_doc-list.fact-order
     1466                              )
     1467             ) .
     1468           run trg/aht-doc.p
     1469             (input buf_doc-list.doc-code
     1470             ,input p-cut-date
     1471             ).
     1472           run doclslib-log-information in this-procedure
     1473             (input p-log-handle
     1474             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1475                              ,buf_doc-list.doc-code
     1476                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1477                              ,buf_doc-list.fact-order
     1478                              )
     1479             ) .
     1480         end.
     1481         else do:
     1482           run doclslib-log-information in this-procedure
     1483             (input p-log-handle
     1484             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1485                              ,buf_doc-list.doc-code
     1486                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1487                              ,buf_doc-list.fact-order
     1488                              )
     1489             ) .
     1490           run trg/aht-prc.p
     1491             (input buf_doc-list.doc-code
     1492             ,input p-cut-date
     1493             ).
     1494           run doclslib-log-information in this-procedure
     1495             (input p-log-handle
     1496             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1497                              ,buf_doc-list.doc-code
     1498                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1499                              ,buf_doc-list.fact-order
     1500                              )
     1501             ) .
     1502         end.
     1503         if  p-update-recalc  = true
     1504         and v-prev-fact-date <> ?
     1505         and buf_doc-list.fact-date > v-prev-fact-date
     1506         then do:
     1507           run gbl/clntat-w.p
     1508             (input p-obj-type
     1509             ,input p-obj-code
     1510             ,input 'aht-recalc':U
     1511             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1512             ) .
     1513           run doclslib-log-information in this-procedure
     1514             (input p-log-handle
     1515             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1516                              ,string(v-prev-fact-date, '99/99/9999':u)
     1517                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1518                              )
     1519             ) .
     1520         end.
     1521         assign
     1522           v-prev-fact-date = buf_doc-list.fact-date
     1523         .
     1524       end.
     1525     end.
     1526   end procedure.
     1527   procedure doclslib-calc-ahsp :
     1528     define input  parameter p-log-handle    as handle    no-undo .
     1529     define input  parameter p-obj-type      as character no-undo .
     1530     define input  parameter p-obj-code      as integer   no-undo .
     1531     define input  parameter p-cut-date      as date      no-undo .
     1532     define input  parameter p-update-recalc as logical   no-undo .
     1533     define variable v-prev-fact-date as date      no-undo .
     1534     define buffer buf_doc-list for doc-list .
     1535     define buffer stop-ahsp-restore-lock_btpr for ub.batchprocess .
     1536     define buffer stop-ahsp-news-lock_btpr    for ub.batchprocess .
     1537     do
     1538     on error undo, return error return-value
     1539     :
     1540       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1541       run gbl/lockrngd.p
     1542         (input  'grar':U
     1543         ,input  'disable':U
     1544         ,buffer buf_lock_gdsrenart_batchprocess
     1545         ) no-error .
     1546       if error-status :error
     1547       then do:
     1548         if error-status :get-message(1) <> ""
     1549         then do:
     1550           message
     1551             vss-workfile vss-revision vss-description skip
     1552             "Ошибка при блокировании функции переименования артикула товара" skip
     1553             error-status :get-message(1) skip
     1554             return-value skip
     1555             view-as alert-box error .
     1556         end.
     1557         undo, return error return-value .
     1558       end.
     1559       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1560       run gbl/lockrngd.p
     1561         (input  'grgc':U
     1562         ,input  'disable':U
     1563         ,buffer buf_lock_gdsrengc_batchprocess
     1564         ) no-error .
     1565       if error-status :error
     1566       then do:
     1567         if error-status :get-message(1) <> ""
     1568         then do:
     1569           message
     1570             vss-workfile vss-revision vss-description skip
     1571             "Ошибка при блокировании функции переименования кода товара" skip
     1572             error-status :get-message(1) skip
     1573             return-value skip
     1574             view-as alert-box error .
     1575         end.
     1576         undo, return error return-value .
     1577       end.
     1578       for each buf_doc-list
     1579         where buf_doc-list.is-trn-doc = true
     1580       by buf_doc-list.fact-order
     1581       on error undo, return error
     1582       :
     1583         find first stop-ahsp-restore-lock_btpr no-lock
     1584           where stop-ahsp-restore-lock_btpr.bp_type       = 'lock':U + 'rsss':U
     1585             and stop-ahsp-restore-lock_btpr.bp_status     = 'N':U
     1586             and stop-ahsp-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1587             and stop-ahsp-restore-lock_btpr.Key#_Two      = 0
     1588             and stop-ahsp-restore-lock_btpr.Key#_Three    = 0
     1589             and stop-ahsp-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1590             and stop-ahsp-restore-lock_btpr.CharKey_Two   = ""
     1591             and stop-ahsp-restore-lock_btpr.CharKey_Three = ""
     1592           no-error .
     1593         if available stop-ahsp-restore-lock_btpr
     1594         then do:
     1595           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1596         end.
     1597         find first stop-ahsp-news-lock_btpr no-lock
     1598           where stop-ahsp-news-lock_btpr.bp_type       = 'lock':U + 'rssn':U
     1599             and stop-ahsp-news-lock_btpr.bp_status     = 'N':U
     1600             and stop-ahsp-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1601             and stop-ahsp-news-lock_btpr.Key#_Two      = 0
     1602             and stop-ahsp-news-lock_btpr.Key#_Three    = 0
     1603             and stop-ahsp-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1604             and stop-ahsp-news-lock_btpr.CharKey_Three = ""
     1605           no-error .
     1606         if available stop-ahsp-news-lock_btpr
     1607         then do:
     1608           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1609         end.
     1610         run doclslib-log-information in this-procedure
     1611           (input p-log-handle
     1612           ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1613                             ,buf_doc-list.doc-code
     1614                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1615                             ,buf_doc-list.fact-order
     1616                             )
     1617           ) .
     1618         define variable v-need-process as logical   no-undo .
     1619         run trg/ah-csptr.p
     1620           (input  buf_doc-list.doc-code
     1621           ,input  p-cut-date
     1622           ,input  false
     1623           ,output v-need-process
     1624           ).
     1625         run doclslib-log-information in this-procedure
     1626           (input p-log-handle
     1627           ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1628                             ,buf_doc-list.doc-code
     1629                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1630                             ,buf_doc-list.fact-order
     1631                             )
     1632           ) .
     1633         if  p-update-recalc  = true
     1634         and v-prev-fact-date <> ?
     1635         and buf_doc-list.fact-date > v-prev-fact-date
     1636         then do:
     1637           run gbl/clntat-w.p
     1638             (input p-obj-type
     1639             ,input p-obj-code
     1640             ,input 'ahsp-recalc':U
     1641             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1642             ) .
     1643           run doclslib-log-information in this-procedure
     1644             (input p-log-handle
     1645             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1646                              ,string(v-prev-fact-date, '99/99/9999':u)
     1647                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1648                              )
     1649             ) .
     1650         end.
     1651         assign
     1652           v-prev-fact-date = buf_doc-list.fact-date
     1653         .
     1654       end.
     1655     end.
     1656   end procedure.
     1657   procedure doclslib-log-information :
     1658     define input  parameter p-log-handle as handle    no-undo .
     1659     define input  parameter p-message    as character no-undo .
     1660     do
     1661     on error undo, return error return-value
     1662     :
     1663       define variable v-log-procedure-name as character no-undo .
     1664       assign
     1665         v-log-procedure-name = "cb-doclslib-log"
     1666       .
     1667       if valid-handle(p-log-handle)
     1668       and p-log-handle :get-signature(v-log-procedure-name) <> ""
     1669       then do:
     1670         run value(v-log-procedure-name) in p-log-handle
     1671           (input p-message
     1672           ) no-error .
     1673       end.
     1674     end.
     1675   end procedure.
     1676   procedure doclslib-find-last-fact-date :
     1677     define output parameter p-last-fact-date  as date      no-undo .
     1678     define output parameter p-reason          as character no-undo .
     1679     do
     1680     on error undo, return error
     1681     :
     1682       define variable v-last-fact-date    as date      no-undo .
     1683       define buffer buf_doc-list for doc-list .
     1684       assign
     1685         v-last-fact-date    = ?
     1686       .
     1687       for each buf_doc-list
     1688       by buf_doc-list.fact-order
     1689       on error undo, return error
     1690       :
     1691         if buf_doc-list.is-archive-exist = false
     1692         or buf_doc-list.fact-date = ?
     1693         then do:
     1694           assign
     1695             p-reason = p-reason + substitute("По документу &1 отсутствует рассчитанный складской архив"
     1696                                             ,buf_doc-list.doc-code
     1697                                             )
     1698           .
     1699           leave .
     1700         end.
     1701         if buf_doc-list.fact-date = ?
     1702         then do:
     1703           assign
     1704             p-reason = p-reason + substitute("Документ &1 имеет не заданную фактическую дату "
     1705                                             ,buf_doc-list.doc-code
     1706                                             )
     1707           .
     1708           leave .
     1709         end.
     1710         if v-last-fact-date = ?
     1711         or (v-last-fact-date <> ?
     1712             and v-last-fact-date < buf_doc-list.fact-date
     1713            )
     1714         then do:
     1715           assign
     1716             v-last-fact-date = buf_doc-list.fact-date
     1717             p-reason         = substitute("Последний рассчитанный документ &1" + chr(10)
     1718                                          ,buf_doc-list.doc-code
     1719                                          )
     1720           .
     1721         end.
     1722       end.
     1723       assign
     1724         p-last-fact-date = v-last-fact-date
     1725       .
     1726     end.
     1727   end procedure.
     1728   procedure doclslib-check-arh-exist :
     1729     define input parameter  p-obj-type       as character no-undo .
     1730     define input parameter  p-obj-code       as integer   no-undo .
     1731     define input parameter  p-cut-fact-order as decimal   no-undo .
     1732     define output parameter p-archive-exist  as logical   no-undo .
     1733     define buffer buf_stk-tot for ub.stk-tot .
     1734     do
     1735     on error undo, return error
     1736     :
     1737       find first buf_stk-tot no-lock
     1738         where buf_stk-tot.obj-type   = p-obj-type
     1739           and buf_stk-tot.obj-code   = p-obj-code
     1740           and buf_stk-tot.fact-order > p-cut-fact-order
     1741         no-error .
     1742       assign
     1743         p-archive-exist = (available buf_stk-tot)
     1744       .
     1745     end.
     1746   end procedure.
     1747   procedure doclslib-check-aht-exist :
     1748     define input parameter  p-obj-type       as character no-undo .
     1749     define input parameter  p-obj-code       as integer   no-undo .
     1750     define input parameter  p-cut-fact-order as decimal   no-undo .
     1751     define output parameter p-archive-exist  as logical   no-undo .
     1752     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     1753     do
     1754     on error undo, return error
     1755     :
     1756       find first buf_aht-stk-tot no-lock
     1757         where buf_aht-stk-tot.obj-type   = p-obj-type
     1758           and buf_aht-stk-tot.obj-code   = p-obj-code
     1759           and buf_aht-stk-tot.fact-order > p-cut-fact-order
     1760         no-error .
     1761       assign
     1762         p-archive-exist = (available buf_aht-stk-tot)
     1763       .
     1764     end.
     1765   end procedure.
     1766   procedure doclslib-check-ahsp-exist :
     1767     define input parameter  p-obj-type       as character no-undo .
     1768     define input parameter  p-obj-code       as integer   no-undo .
     1769     define input parameter  p-cut-fact-order as decimal   no-undo .
     1770     define output parameter p-archive-exist  as logical   no-undo .
     1771     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     1772     do
     1773     on error undo, return error
     1774     :
     1775       find first buf_stk-supp-tot no-lock
     1776         where buf_stk-supp-tot.obj-type   = p-obj-type
     1777           and buf_stk-supp-tot.obj-code   = p-obj-code
     1778           and buf_stk-supp-tot.fact-order > p-cut-fact-order
     1779         no-error .
     1780       assign
     1781         p-archive-exist = (available buf_stk-supp-tot)
     1782       .
     1783     end.
     1784   end procedure.
     1785   procedure doclslib-check-doc-arh-exist :
     1786     define buffer buf_doc-list for doc-list .
     1787     define buffer buf_ot-tot for ub.ot-tot .
     1788     do
     1789     on error undo, return error return-value
     1790     :
     1791       for each buf_doc-list
     1792       on error undo, return error
     1793       :
     1794         find first buf_ot-tot no-lock
     1795           where buf_ot-tot.doc-code = buf_doc-list.doc-code
     1796           no-error .
     1797         if available buf_ot-tot
     1798         then do:
     1799           assign
     1800             buf_doc-list.is-archive-exist = true
     1801           .
     1802         end.
     1803         else do:
     1804           assign
     1805             buf_doc-list.is-archive-exist = false
     1806           .
     1807         end.
     1808       end.
     1809     end.
     1810   end procedure.
     1811   procedure doclslib-check-doc-aht-exist :
     1812     define buffer buf_doc-list for doc-list .
     1813     define buffer buf_aht-doc for ub.aht-doc .
     1814     do
     1815     on error undo, return error return-value
     1816     :
     1817       for each buf_doc-list
     1818       on error undo, return error
     1819       :
     1820         find first buf_aht-doc no-lock
     1821           where buf_aht-doc.doc-code = buf_doc-list.doc-code
     1822           no-error .
     1823         if available buf_aht-doc
     1824         then do:
     1825           assign
     1826             buf_doc-list.is-archive-exist = true
     1827           .
     1828         end.
     1829         else do:
     1830           assign
     1831             buf_doc-list.is-archive-exist = false
     1832           .
     1833         end.
     1834       end.
     1835     end.
     1836   end procedure.
     1837   procedure doclslib-check-doc-ahsp-exist :
     1838     define buffer buf_doc-list for doc-list .
     1839     define buffer buf_ot-supp-line for ub.ot-supp-tot .
     1840     do
     1841     on error undo, return error return-value
     1842     :
     1843       for each buf_doc-list
     1844       on error undo, return error
     1845       :
     1846         find first buf_ot-supp-line no-lock
     1847           where buf_ot-supp-line.doc-code = buf_doc-list.doc-code
     1848           no-error .
     1849         if available buf_ot-supp-line
     1850         then do:
     1851           assign
     1852             buf_doc-list.is-archive-exist = true
     1853           .
     1854         end.
     1855         else do:
     1856           if buf_doc-list.doc-type = 'инв':U
     1857           then do:
     1858             define variable v-need-process as logical   no-undo .
     1859             run trg/ah-csptr.p
     1860               (input  buf_doc-list.doc-code
     1861               ,input  0
     1862               ,input  true
     1863               ,output v-need-process
     1864               ).
     1865             if v-need-process = true
     1866             then do:
     1867               assign
     1868                 buf_doc-list.is-archive-exist = false
     1869               .
     1870             end.
     1871             else do:
     1872               assign
     1873                 buf_doc-list.is-archive-exist = true
     1874               .
     1875             end.
     1876           end.
     1877           else do:
     1878             assign
     1879               buf_doc-list.is-archive-exist = false
     1880             .
     1881           end.
     1882         end.
     1883       end.
     1884     end.
     1885   end procedure.
     1886   procedure doclslib-clear-ahsp-doc-list :
     1887     define buffer buf_doc-list for doc-list .
     1888     define buffer buf_trn-doc  for ub.trn-doc .
     1889     define buffer buf_doc-line for ub.doc-line .
     1890     define buffer buf_parts    for ub.parts .
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894       check-doc-list :
     1895       for each buf_doc-list
     1896       on error undo, return error return-value
     1897       :
     1898         find first buf_trn-doc no-lock
     1899           where buf_trn-doc.doc-code = buf_doc-list.doc-code
     1900           .
     1901         if buf_trn-doc.office = true
     1902         then do:
     1903           delete buf_doc-list .
     1904           next check-doc-list .
     1905         end.
     1906         find first buf_doc-line no-lock
     1907           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1908           no-error .
     1909         if not available buf_doc-line
     1910         then do:
     1911           delete buf_doc-list .
     1912           next check-doc-list .
     1913         end.
     1914         find first buf_parts no-lock
     1915           where buf_parts.out-code = buf_trn-doc.doc-code
     1916             and buf_parts.fact-qnty <> 0
     1917           no-error .
     1918         if not available buf_parts
     1919         then do:
     1920           delete buf_doc-list .
     1921           next check-doc-list .
     1922         end.
     1923       end.
     1924     end.
     1925   end procedure.
     1926   procedure doclslib-init-goods :
     1927     define buffer buf_doclslib-goods for doclslib-goods .
     1928     define buffer buf_doc-list       for doc-list .
     1929     define buffer buf_trn-doc        for ub.trn-doc .
     1930     define buffer buf_price-doc      for ub.price-doc .
     1931     define buffer buf_doc-line       for ub.doc-line .
     1932     define buffer buf_price-list     for ub.price-list .
     1933     define variable v-gds-code as integer   no-undo .
     1934     do
     1935     on error undo, return error return-value
     1936     :
     1937       for each buf_doclslib-goods
     1938       on error undo, return error return-value
     1939       :
     1940         delete buf_doclslib-goods .
     1941       end.
     1942       for each buf_doc-list
     1943       on error undo, return error return-value
     1944       :
     1945         if buf_doc-list.is-trn-doc
     1946         then do:
     1947           find first buf_trn-doc no-lock
     1948             where buf_trn-doc.doc-code = buf_doc-list.doc-code
     1949             .
     1950           for each buf_doc-line no-lock
     1951             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1952           on error undo, return error return-value
     1953           :
     1954   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1955   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1956     (input  buf_doc-line.artic
     1957     ,input  buf_doc-line.prod-type
     1958     ,input  buf_doc-line.prod-code
     1959     ,output v-gds-code
     1960     )  .
     1961             find first buf_doclslib-goods
     1962               where buf_doclslib-goods.gds-code = v-gds-code
     1963               no-error .
     1964             if not available buf_doclslib-goods
     1965             then do:
     1966               create buf_doclslib-goods .
     1967               assign
     1968                 buf_doclslib-goods.gds-code  = v-gds-code
     1969                 buf_doclslib-goods.artic     = buf_doc-line.artic
     1970                 buf_doclslib-goods.prod-type = buf_doc-line.prod-type
     1971                 buf_doclslib-goods.prod-code = buf_doc-line.prod-code
     1972               .
     1973             end.
     1974           end.
     1975         end.
     1976         else do:
     1977           find first buf_price-doc no-lock
     1978             where buf_price-doc.doc-num = buf_doc-list.doc-code
     1979             .
     1980           for each buf_price-list no-lock
     1981             where buf_price-list.doc-num = buf_price-doc.doc-num
     1982           on error undo, return error return-value
     1983           :
     1984   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1986     (input  buf_price-list.artic
     1987     ,input  buf_price-list.prod-type
     1988     ,input  buf_price-list.prod-code
     1989     ,output v-gds-code
     1990     )  .
     1991             find first buf_doclslib-goods
     1992               where buf_doclslib-goods.gds-code = v-gds-code
     1993               no-error .
     1994             if not available buf_doclslib-goods
     1995             then do:
     1996               create buf_doclslib-goods .
     1997               assign
     1998                 buf_doclslib-goods.gds-code  = v-gds-code
     1999                 buf_doclslib-goods.artic     = buf_price-list.artic
     2000                 buf_doclslib-goods.prod-type = buf_price-list.prod-type
     2001                 buf_doclslib-goods.prod-code = buf_price-list.prod-code
     2002               .
     2003             end.
     2004           end.
     2005         end.
     2006       end.
     2007     end.
     2008   end procedure.
     2009   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2010   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2011   define variable v-waitfram-action01         as character   no-undo .
     2012   define variable v-waitfram-action02         as character   no-undo .
     2013   define variable v-waitfram-action03         as character   no-undo .
     2014   define variable mWaitFramTextBeg            as character   no-undo.
     2015   define variable mWaitFramTextEnd            as character   no-undo.
     2016   define variable mWaitFramView               as logical     no-undo.
     2017   define variable mWaitProcEvent              as logical     no-undo init yes.
     2018   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2019   define variable mWaitFramStop               as logical     no-undo.
     2020   define variable mWaitFramStopUser           as logical     no-undo.
     2021   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2022   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2023   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2024   define button B-WaitFramStop auto-end-key
     2025        label "Стоп"
     2026        size 10 by 1 tooltip "Остоновить процесс".
     2027   define button B-viewProcInfo
     2028        label "Информация"
     2029        size 15 by 1 tooltip "Информация о процесс".
     2030   define frame waitfram
     2031     v-waitfram-action01 format "x(72)" no-label skip
     2032     v-waitfram-action02 format "x(72)" no-label skip
     2033     v-waitfram-action03 format "x(72)" no-label skip
     2034     B-viewProcInfo
     2035     B-WaitFramStop at row 4 col 30
     2036     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2037     .
     2038   define new global shared variable mBatchMode as logical no-undo init ?.
     2039   define variable mFramBachModHandle as handle no-undo.
     2040   mFramBachModHandle = frame waitfram:handle.
     2041   define variable mFameOldVis as logical no-undo.
     2042   define variable mVisCUrentVin as logical no-undo.
     2043   if session:batch-mode
     2044   then
     2045      mBatchMode = yes.
     2046   if mBatchMode = ? then do:
     2047     mVisCUrentVin = current-window:visible.
     2048     mFameOldVis = mFramBachModHandle:visible.
     2049     mFramBachModHandle:visible  = yes.
     2050     mBatchMode = mFramBachModHandle:visible ne yes.
     2051     mFramBachModHandle:visible = mFameOldVis.
     2052     current-window:visible = mVisCUrentVin.
     2053   end.
     2054    if  log-manager:logfile-name ne ?
     2055     then DO:
     2056         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2057         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2058         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2059     end.
     2060   on choose of B-WaitFramStop in frame waitfram
     2061   do:
     2062     mWaitFramStop = yes.
     2063     mWaitFramStopUser = yes.
     2064   end.
     2065   function waitfram-check-timeout returns logical():
     2066      define variable vtime as int64 no-undo.
     2067      if mWaitFramStopTimeOut
     2068      then
     2069         return yes.
     2070      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2071      if     mWaitFramTimeOut ne ?
     2072         and mWaitFramTimeOut ne 0
     2073         and mWaitFramTimeOut lt vtime
     2074      then do:
     2075         mWaitFramStopTimeOut = yes.
     2076      end.
     2077      return mWaitFramStopTimeOut.
     2078   end.
     2079   procedure waitfram-hide :
     2080     if not session:batch-mode
     2081     then do
     2082     on error undo, return error return-value
     2083     :
     2084       pause 0 before-hide .
     2085       if not mBatchMode then
     2086         hide frame waitfram .
     2087     if     not mWaitFramView
     2088        and mWaitProcEvent
     2089     then
     2090       process events .
     2091     end.
     2092   end procedure.
     2093   procedure waitfram-show :
     2094     define input  parameter p-message as character no-undo .
     2095     define variable v-left-margin as integer   no-undo .
     2096     if not session:batch-mode
     2097     then do
     2098     on error undo, return error return-value
     2099     :
     2100       if length(p-message) <= 70 then do:
     2101         assign
     2102           v-left-margin = integer((70 - length(p-message)) / 2)
     2103         .
     2104         assign
     2105           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2106         .
     2107         assign
     2108           v-waitfram-action01 = " "
     2109           v-waitfram-action02 = " "
     2110                                    + fill(" ", v-left-margin)
     2111                                    + p-message
     2112           v-waitfram-action03 = " "
     2113         .
     2114       end.
     2115       else do:
     2116         define variable vRindex1 as integer no-undo.
     2117         define variable vRindex2 as integer no-undo.
     2118         vRindex1 = r-index(p-message," ",70).
     2119         if vRindex1 = 0
     2120         then
     2121            vRindex1 = 70.
     2122         if length(p-message)  <= vRindex1 + 70 then do:
     2123           assign
     2124             v-waitfram-action01 = " "
     2125             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2126             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2127           .
     2128         end.
     2129         else do:
     2130           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2131           if vRindex2 <= vRindex1
     2132           then
     2133              vRindex2 = vRindex1 + 70.
     2134           assign
     2135             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2136             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2137             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2138           .
     2139         end.
     2140       end.
     2141       B-viewProcInfo:visible   in frame waitfram = no.
     2142       B-viewProcInfo:sensitive in frame waitfram = no.
     2143       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2144       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2145       if  (   mWaitFramView
     2146          or  mWaitProcEvent)
     2147          and not mBatchMode
     2148       then
     2149          display
     2150             v-waitfram-action01 skip
     2151             v-waitfram-action02 skip
     2152             v-waitfram-action03 skip
     2153          with frame waitfram .
     2154       if     mWaitFramView
     2155          then do:
     2156             if     mWaitFramInterval ne ?
     2157                and not mBatchMode
     2158             then
     2159                wait-for go of frame waitfram pause mWaitFramInterval.
     2160          end.
     2161          else
     2162             if     mWaitProcEvent
     2163                and not mBatchMode
     2164             then
     2165                process events .
     2166     end.
     2167   end procedure.
     2168      procedure waitfram-show-this:
     2169         define input  parameter iInterval as int64 no-undo.
     2170         define variable vtime as int64 no-undo.
     2171         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2172         mWaitFramInterval = iInterval.
     2173         run waitfram-show (substitute("&1&2 &3&4" ,
     2174                                       mWaitFramTextBeg ,
     2175                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2176                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2177                                       mWaitFramTextEnd
     2178                                      )
     2179                           ).
     2180      end.
     2181      procedure WaitFramRunPause:
     2182         define input  parameter iInterval as dec no-undo.
     2183         define variable vStart  as datetime-tz no-undo.
     2184         define variable vend    as datetime-tz no-undo.
     2185         define variable vint as int64 no-undo.
     2186         define variable vOk as logical no-undo.
     2187         vStart = now.
     2188         vend   = vStart.
     2189         publish "WaitFramPause" (iInterval,output vOk).
     2190         vend   =  now.
     2191         vint = vend - vStart.
     2192         vint = iInterval - vint / 1000.
     2193         if     not mWaitFramStop
     2194            and (   vint > 0
     2195                 or (    not vOk
     2196                     and iInterval eq ?
     2197                     )
     2198                 )
     2199         then
     2200            run waitfram-show-this (iInterval).
     2201         vend   =  now.
     2202         vint = vend - vStart.
     2203         vint = iInterval - vint / 1000.
     2204         if     not mWaitFramStop
     2205            and vint > 0
     2206         then do:
     2207            run gbl/pause.p (vint * 1000).
     2208         end.
     2209         if iInterval ne ?
     2210         then
     2211            publish "WaitFramStop".
     2212         waitfram-check-timeout().
     2213      end.
     2214      procedure WaitFramWaitFor:
     2215         define input  parameter iInterval as dec no-undo.
     2216         assign
     2217            mWaitFramStartProc   = now
     2218            mWaitFramStopUser    = no
     2219            mWaitFramStopTimeOut = no
     2220         .
     2221         block-wait:
     2222         do while not mWaitFramStop:
     2223            run WaitFramRunPause (iInterval).
     2224            if  waitfram-check-timeout()
     2225            then do:
     2226               leave block-wait.
     2227            end.
     2228         end.
     2229         run waitfram-hide.
     2230      end.
     2231   procedure waitfram-join :
     2232     define input  parameter p-line-1  as character no-undo .
     2233     define input  parameter p-line-2  as character no-undo .
     2234     define input  parameter p-line-3  as character no-undo .
     2235     define output parameter p-message as character no-undo .
     2236     do
     2237     on error undo, return error return-value
     2238     :
     2239       assign
     2240         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2241                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2242                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2243       .
     2244     end.
     2245   end procedure.
     2246   function waitfram-join-function returns character
     2247     (input p-line-1 as character
     2248     ,input p-line-2 as character
     2249     ,input p-line-3 as character
     2250     ).
     2251     define variable v-message as character no-undo .
     2252     run waitfram-join in this-procedure
     2253       (input  p-line-1
     2254       ,input  p-line-2
     2255       ,input  p-line-3
     2256       ,output v-message
     2257       ) .
     2258     return v-message .
     2259   end function .
