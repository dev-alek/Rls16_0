     5912                   .
     5913                 end.
     5914               end.
     5915             end.
     5916           end.
     5917         end.
     5918       end.
     5919     end.
     5920   end procedure.
     5921   procedure cb_rst-arh_overturn-exist :
     5922     define input  parameter p-artic          as character no-undo .
     5923     define input  parameter p-prod-type      as character no-undo .
     5924     define input  parameter p-prod-code      as integer   no-undo .
     5925     define output parameter p-overturn-exist as logical   no-undo .
     5926     define buffer buf_doclslib-goods for doclslib-goods .
     5927     do
     5928     on error undo, return error return-value
     5929     :
     5930       find first buf_doclslib-goods
     5931         where buf_doclslib-goods.artic     = p-artic
     5932           and buf_doclslib-goods.prod-type = p-prod-type
     5933           and buf_doclslib-goods.prod-code = p-prod-code
     5934         no-error .
     5935       if available buf_doclslib-goods
     5936       then do:
     5937         assign
     5938           p-overturn-exist = true
     5939         .
     5940       end.
     5941       else do:
     5942         assign
     5943           p-overturn-exist = false
     5944         .
     5945       end.
     5946     end.
     5947   end procedure.
     5948   procedure check-md5-signature :
     5949     define input  parameter p-obj-type     as character no-undo .
     5950     define input  parameter p-obj-code     as integer   no-undo .
     5951     define input  parameter p-archive-type as character no-undo .
     5952     define input  parameter p-file-name    as character no-undo .
     5953     define buffer buf_archive-history for ub.archive-history .
     5954     do
     5955     on error undo, return error return-value
     5956     :
     5957       find first buf_archive-history exclusive-lock
     5958         where buf_archive-history.obj-type     = p-obj-type
     5959           and buf_archive-history.obj-code     = p-obj-code
     5960           and buf_archive-history.archive-type = p-archive-type
     5961           and buf_archive-history.file-valid   = true
     5962           and buf_archive-history.file-name    = p-file-name
     5963         no-error .
     5964       if not available buf_archive-history
     5965       then do:
     5966         message
     5967           "Складской архив по товарам" skip
     5968           "Объект" p-obj-type p-obj-code skip
     5969           "Отсутствует информация о выгрузке файла" skip
     5970           "Файл" p-file-name skip
     5971           view-as alert-box error .
     5972         undo, return error return-value .
     5973       end.
     5974       define variable v-md5-signature as character no-undo .
     5975       run gbl/md5.p
     5976         (input  p-file-name
     5977         ,output v-md5-signature
     5978         ) .
     5979       if v-md5-signature <> buf_archive-history.file-md5
     5980       then do:
     5981         message
     5982           "Складской архив по товарам" skip
     5983           "Объект" p-obj-type p-obj-code skip
     5984           "Контрольная сумма файла не совпадает с информацией о выгрузке файла" skip
     5985           "Файл" p-file-name skip
     5986           "Контрольная сумма" v-md5-signature skip
     5987           "Информация о выгрузке файла" buf_archive-history.file-md5 skip
     5988           view-as alert-box error .
     5989         undo, return error return-value .
     5990       end.
     5991     end.
     5992   end procedure.
     5993   procedure invalidate-md5-signature :
     5994     define input  parameter p-obj-type     as character no-undo .
     5995     define input  parameter p-obj-code     as integer   no-undo .
     5996     define input  parameter p-archive-type as character no-undo .
     5997     define input  parameter p-file-name    as character no-undo .
     5998     define input  parameter p-chip-num     as integer   no-undo .
     5999     define buffer buf_archive-history for ub.archive-history .
     6000     do
     6001     on error undo, return error return-value
     6002     :
     6003       find first buf_archive-history exclusive-lock
     6004         where buf_archive-history.obj-type     = p-obj-type
     6005           and buf_archive-history.obj-code     = p-obj-code
     6006           and buf_archive-history.archive-type = p-archive-type
     6007           and buf_archive-history.file-valid   = true
     6008           and buf_archive-history.file-name    = p-file-name
     6009         no-error .
     6010       if available buf_archive-history
     6011       then do:
     6012         assign
     6013           buf_archive-history.file-valid            = false
     6014           buf_archive-history.file-invalid-chip-num = p-chip-num
     6015         .
     6016       end.
     6017     end.
     6018   end procedure.
     6019   procedure fill-artic :
     6020     define input  parameter p-gds-code  as integer   no-undo .
     6021     define output parameter p-artic     as character no-undo .
     6022     define output parameter p-prod-type as character no-undo .
     6023     define output parameter p-prod-code as integer   no-undo .
     6024     define buffer buf_temp-goods for temp-goods .
     6025     define buffer buf_goods for ub.goods .
     6026     do
     6027     on error undo, return error return-value
     6028     :
     6029       find first buf_temp-goods
     6030         where buf_temp-goods.gds-code = p-gds-code
     6031         no-error .
     6032       if not available buf_temp-goods
     6033       then do:
     6034         find first buf_goods no-lock
     6035           where buf_goods.gds-code = p-gds-code
     6036           no-error .
     6037         if not available buf_goods
     6038         then do:
     6039           message
     6040             vss-workfile vss-revision vss-description skip
     6041             "Не найден товар" skip
     6042             "Код товара" p-gds-code skip
     6043             view-as alert-box error .
     6044           undo, return error return-value .
     6045         end.
     6046         create buf_temp-goods .
     6047         assign
     6048           buf_temp-goods.gds-code  = p-gds-code
     6049           buf_temp-goods.artic     = buf_goods.artic
     6050           buf_temp-goods.prod-type = buf_goods.prod-type
     6051           buf_temp-goods.prod-code = buf_goods.prod-code
     6052         .
     6053       end.
     6054       assign
     6055         p-artic     = buf_temp-goods.artic
     6056         p-prod-type = buf_temp-goods.prod-type
     6057         p-prod-code = buf_temp-goods.prod-code
     6058       .
     6059     end.
     6060   end procedure.
