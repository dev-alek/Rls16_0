     2513   do
     2514   on error undo, return error return-value
     2515   :
     2516   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2517     run mainmenu_getcntxt in parparentproc
     2518       (output v-cntxt-db-num
