     2637       end.
     2638       undo, return error return-value .
     2639     end.
     2640     define variable v-attr-value as character no-undo .
     2641     define variable v-attr-type  as character no-undo .
     2642     define variable v-arh-calc          as logical   no-undo .
     2643     define variable v-arh-del           as logical   no-undo .
     2644     define variable v-arh-start-date    as date      no-undo .
     2645     define variable v-arh-detail-date   as date      no-undo .
     2646     define variable v-arh-recalc-date   as date      no-undo .
     2647     run clntattr-value in this-procedure
     2648       (input  v-obj-type
     2649       ,input  v-obj-code
     2650       ,input  'arh-calc':U
     2651       ,output v-attr-value
     2652       ,output v-attr-type
     2653       ) .
     2654     assign
     2655       v-arh-calc = (lookup(v-attr-value, 'yes,true') > 0)
     2656     .
     2657     run clntattr-value in this-procedure
     2658       (input  v-obj-type
     2659       ,input  v-obj-code
     2660       ,input  'arh-del':U
     2661       ,output v-attr-value
     2662       ,output v-attr-type
     2663       ) .
     2664     assign
     2665       v-arh-del = (lookup(v-attr-value, 'yes,true') > 0)
     2666     .
     2667     run clntattr-value in this-procedure
     2668       (input  v-obj-type
     2669       ,input  v-obj-code
     2670       ,input  'arh-start':U
     2671       ,output v-attr-value
     2672       ,output v-attr-type
     2673       ) .
     2674     assign
     2675       v-arh-start-date = date(v-attr-value)
     2676     .
     2677     run clntattr-value in this-procedure
     2678       (input  v-obj-type
     2679       ,input  v-obj-code
     2680       ,input  'arh-detail':U
     2681       ,output v-attr-value
     2682       ,output v-attr-type
     2683       ) .
     2684     assign
     2685       v-arh-detail-date = date(v-attr-value)
     2686     .
     2687     run clntattr-value in this-procedure
     2688       (input  v-obj-type
     2689       ,input  v-obj-code
     2690       ,input  'arh-recalc':U
     2691       ,output v-attr-value
     2692       ,output v-attr-type
     2693       ) .
     2694     assign
     2695       v-arh-recalc-date = date(v-attr-value)
     2696     .
     2697     if (v-arh-start-date <> ?
     2698        and v-arh-detail-date = ?)
     2699     or (v-arh-start-date = ?
     2700        and v-arh-detail-date <> ?)
     2701     then do:
     2702       message
     2703         "Невозможно произвести восстановление складского архива по товарам" skip
     2704         "Складской архив по товарам" skip
     2705         "Объект" v-obj-type v-obj-code skip
     2706         "Противоречивая информация в датах инициализации архива" skip
     2707         "Дата начала складского архива по товарам" string(v-arh-start-date, '99/99/9999':u) skip
     2708         "Дата начала подробного складского архива по товарам" string(v-arh-detail-date, '99/99/9999':u) skip
     2709         view-as alert-box error .
     2710       undo, return error return-value .
     2711     end.
     2712     if v-arh-detail-date = ?
     2713     then do:
     2714       message
     2715         "Складской архив по товарам" skip
     2716         "Объект" v-obj-type v-obj-code skip
     2717         "На объекте рассчитан складской архив по товарам за все даты" skip
     2718         "Операция восстановления не может быть произведена" skip
     2719         view-as alert-box information .
     2720       return .
     2721     end.
     2722     define variable v-year  as integer   no-undo .
     2723     define variable v-month as integer   no-undo .
     2724     define variable v-day   as integer   no-undo .
     2725     assign
     2726       v-year  = year(v-arh-detail-date)
     2727       v-month = month(v-arh-detail-date)
     2728       v-day   = day(v-arh-detail-date)
     2729     .
     2730     assign
     2731       v-file-name = 'arhdel':u
     2732                   + '_':u
     2733                   + (if v-obj-type = 'скл':U then 'stock':u else 'shop':u)
     2734                   + '_':u
     2735                   + string(v-obj-code)
     2736                   + '_':u
     2737                   + string(v-year, '9999':u)
     2738                   + string(v-month, '99':u)
     2739                   + string(v-day, '99':u)
     2740                   + '.txt'
     2741     .
     2742     assign
     2743       v-backup-file-name = entry(1, v-file-name, '.') + '.rst':u
     2744     .
     2745     define variable v-full-file-name    as character no-undo .
     2746     define variable v-full-backup-name  as character no-undo .
     2747     define variable v-restore-from-file as logical   no-undo .
     2748     define variable v-restore-backup    as logical   no-undo .
     2749     assign
     2750       v-full-file-name = search(v-file-name)
     2751     .
     2752     if v-full-file-name = ?
     2753     or v-full-file-name = ""
     2754     then do:
     2755       assign
     2756         v-restore-from-file = false
     2757       .
     2758     end.
     2759     else do:
     2760       assign
     2761         v-restore-from-file = true
     2762       .
     2763     end.
     2764     assign
     2765       v-full-backup-name = search(v-backup-file-name)
     2766     .
     2767     if v-full-backup-name = ?
     2768     or v-full-backup-name = ""
     2769     then do:
     2770       assign
     2771         v-restore-backup = false
     2772       .
     2773     end.
     2774     else do:
     2775       assign
     2776         v-restore-backup = true
     2777       .
     2778     end.
     2779     define variable v-num as integer   no-undo .
     2780     run gbl/d-askw.w
     2781       (input "Вопрос"
     2782       ,input substitute("Объект &1 &2", v-obj-type, v-obj-code) + chr(10)
     2783              + "Восстановление подробного складского архива по товарам" + chr(10)
     2784              + "Дата начала подробного складского архива по товарам " + string(v-arh-detail-date, '99/99/9999':U) + chr(10)
     2785              + substitute("Сегодня &1", string(v-today, '99/99/9999':U)) + chr(10)
     2786       ,input '|^':u
     2787       ,input "Из файла" + '^confirm':u + (if v-restore-from-file = true then '':u else '^disable':u)
     2788       + '|':u + "Резервная копия" + '^confirm':u + (if v-restore-backup = true then '':u else '^disable':u)
     2789       + '|':u + "Документы" + '^confirm':u + (if v-arh-del = true then '^disable':u else '':u)
     2790       + '|':u + "Отказ"
     2791       ,input (if v-restore-from-file then substitute("Восстановить из файла &1", v-full-file-name)
     2792               else substitute("Файл с сохраненным складским архивом по товарам &1 не найден", v-file-name ) )
     2793           + "|":u +
     2794              (if v-restore-from-file then substitute("Восстановить из резервной копии &1", v-backup-file-name)
     2795               else substitute("Файл резервной копии &1 не найден", v-backup-file-name) )
     2796           + "|":u + (if v-arh-del
     2797                      then "Была ошибка при предыдущем Удалении/Восстановлении" + chr(10)
     2798                           + "Складской архив по товарам можно восстановить только из файла"
     2799                      else "Рассчитать на основании документов"
     2800                      )
     2801           + "|":u + ""
     2802       ,input 1
     2803       ,input 4
     2804       ,output v-num
     2805       ).
     2806     define variable v-clear-start as logical   no-undo .
     2807     assign
     2808       v-clear-start = true
     2809     .
     2810     case v-num :
     2811       when 1
     2812       then do:
     2813         assign
     2814           v-restore-from-file = true
     2815           v-restore-backup    = false
     2816         .
     2817         run check-md5-signature in this-procedure
     2818           (input  v-obj-type
     2819           ,input  v-obj-code
     2820           ,input  'arh':U
     2821           ,input  v-file-name
     2822           ) no-error .
     2823         if error-status :error
     2824         then do:
     2825           if error-status :get-message(1) <> ""
     2826           then do:
     2827             message
     2828               vss-workfile vss-revision vss-description skip
     2829               "Складской архив по товарам" skip
     2830               "Объект" v-obj-type v-obj-code skip
     2831               "Ошибка при проверке контрольной суммы файла" skip
     2832               view-as alert-box error .
     2833             undo, return error return-value .
     2834           end.
     2835           undo, return error return-value .
     2836         end.
     2837         input stream sinp from value(v-file-name) .
     2838         run validate-file-name in this-procedure
     2839           (input  v-obj-type
     2840           ,input  v-obj-code
     2841           ,input  v-arh-detail-date
     2842           ,input  v-file-name
     2843           ,output v-restore-start-date
     2844           ,output v-restore-detail-date
     2845           ) no-error .
     2846         if error-status :error
     2847         then do:
     2848           message
     2849             vss-workfile vss-revision vss-description skip
     2850             "Складской архив по товарам" skip
     2851             "Объект" v-obj-type v-obj-code skip
     2852             "Ошибка при проверке данных файла архивации" skip
     2853             "Имя файла архивации" v-file-name skip
     2854             error-status :get-message(1) skip
     2855             return-value skip
     2856             view-as alert-box error .
     2857           undo, return error .
     2858         end.
     2859         input stream sinp close .
     2860       end.
     2861       when 2
     2862       then do:
     2863         assign
     2864           v-restore-from-file = true
     2865           v-restore-backup    = true
     2866         .
     2867         assign
