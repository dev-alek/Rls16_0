     3381           error-status :get-message(1) skip
     3382           return-value skip
     3383           view-as alert-box error .
     3384         undo, return error return-value .
     3385       end.
     3386       run clntattr-write in this-procedure
     3387         (input v-obj-type
     3388         ,input v-obj-code
     3389         ,input 'arh-detail':U
     3390         ,input string(v-restore-detail-date, '99/99/9999':u)
     3391         ) no-error .
     3392       if error-status :error
     3393       then do:
     3394         message
     3395           vss-workfile vss-revision vss-description skip
     3396           "Складской архив по товарам" skip
     3397           "Объект" v-obj-type v-obj-code skip
     3398           "Ошибка при записи даты начала подробного складского архива по товарам" skip
     3399           error-status :get-message(1) skip
     3400           return-value skip
     3401           view-as alert-box error .
     3402         undo, return error return-value .
     3403       end.
     3404       define variable v-delete-arh-del as logical   no-undo .
     3405       run clntattr-delete in this-procedure
     3406         (input  v-obj-type
     3407         ,input  v-obj-code
     3408         ,input  'arh-del':U
     3409         ,output v-delete-arh-del
     3410         ) .
     3411     end.
     3412     else do:
     3413       define buffer lock_shift-obj for ub.shift-obj .
     3414       run factord-lock-shift in this-procedure
     3415         (input  v-obj-type
     3416         ,input  v-obj-code
     3417         ,input  v-restore-start-date - 1
     3418         ,buffer lock_shift-obj
     3419         ) no-error .
     3420       if error-status :error
     3421       then do:
     3422         message
     3423           vss-workfile vss-revision vss-description skip
     3424           "Ошибка при блокировке смены на объекте" skip
     3425           "Объект" v-obj-type v-obj-code skip
     3426           "Дата" v-restore-detail-date skip
     3427           return-value
     3428           view-as alert-box error .
     3429         undo, return error return-value .
     3430       end.
     3431       run doclslib-clear-doc-list in this-procedure .
     3432       run doclslib-init-trn-doc in this-procedure
     3433         (input  v-obj-type
     3434         ,input  v-obj-code
     3435         ,input  v-restore-detail-date
     3436         ) no-error .
     3437       if error-status :error
     3438       then do:
     3439         message
     3440           vss-workfile vss-revision vss-description skip
     3441           "Ошибка при заполнении списка документов" skip
     3442           "Объект" v-obj-type v-obj-code skip
     3443           "Дата" v-restore-detail-date skip
     3444           view-as alert-box error .
     3445         undo, return error return-value .
     3446       end.
     3447       run doclslib-init-price-doc in this-procedure
     3448         (input  v-obj-type
     3449         ,input  v-obj-code
     3450         ,input  v-restore-detail-date
     3451         ) no-error .
     3452       if error-status :error
     3453       then do:
     3454         message
     3455           vss-workfile vss-revision vss-description skip
     3456           "Ошибка при заполнении списка переоценок" skip
     3457           "Объект" v-obj-type v-obj-code skip
     3458           "Дата" v-restore-detail-date skip
     3459           view-as alert-box error .
     3460         undo, return error return-value .
     3461       end.
     3462       run doclslib-clear-rst in this-procedure
     3463         (input v-arh-detail-date
     3464         ) .
     3465       run doclslib-init-goods in this-procedure .
     3466       run clntattr-write in this-procedure
     3467         (input v-obj-type
     3468         ,input v-obj-code
     3469         ,input 'arh-rest':U
     3470         ,input 'true':u
     3471         ) .
     3472       run ahrstutl-init in this-procedure
     3473         (input v-obj-type
     3474         ,input v-obj-code
     3475         ,input v-arh-detail-date - 1
     3476         ,input false
     3477         ) .
     3478       run ahrstutl-create-stk in this-procedure
     3479         (input  v-obj-type
     3480         ,input  v-obj-code
     3481         ,input  v-arh-detail-date - 1
     3482         ) .
     3483       run ahrstutl-clear-arh in this-procedure
     3484         (input  v-obj-type
     3485         ,input  v-obj-code
     3486         ,input  v-start-day-end-fact-order
     3487         ,input  v-arh-detail-date - 1
     3488         ) .
     3489       find current calc-arh-lock_batchprocess no-lock .
     3490       if v-clear-start = true
     3491       then do:
     3492         run show-action in this-procedure
     3493           (input "Инициализация остатка на дату нового начала складского архива"
     3494           ).
     3495         run trg/inarh.p
     3496           (input  this-procedure :handle
     3497           ,input  v-obj-type
     3498           ,input  v-obj-code
     3499           ,input  v-restore-start-date - 1
     3500           ,input  v-arh-detail-date - 1
     3501           ) .
     3502       end.
     3503       run show-action in this-procedure
     3504         (input "Расчёт складского архива по товарам"
     3505         ).
     3506       run doclslib-calc-arh in this-procedure
     3507         (input this-procedure
     3508         ,input v-obj-type
     3509         ,input v-obj-code
     3510         ,input v-arh-detail-date - 1
     3511         ,input false
     3512         ) .
     3513       if v-clear-start = true
     3514       then do:
     3515         run show-action in this-procedure
     3516           (input "Обновление накопительных остатков"
     3517           ).
     3518         run ahrstutl-init in this-procedure
     3519           (input v-obj-type
     3520           ,input v-obj-code
     3521           ,input v-arh-detail-date - 1
     3522           ,input true
     3523           ) .
     3524         run ahrstutl-update in this-procedure
     3525           (input v-obj-type
     3526           ,input v-obj-code
     3527           ,input v-restore-detail-date - 1
     3528           ,input v-arh-detail-date - 1
     3529           ) .
     3530       end.
     3531       run show-action in this-procedure
     3532         (input "Блокировка расчёта складского архива по товарам"
     3533         ).
     3534       define variable v-need-stop-arh as logical   no-undo .
     3535       assign
     3536         v-need-stop-arh = false
     3537       .
     3538       run gbl/lock-prc.p
     3539         (input 'btpr':U
     3540         ,input v-obj-code
     3541         ,input 0
     3542         ,input 0
     3543         ,input v-obj-type
     3544         ,input ""
     3545         ,input ""
     3546         ,input "Объект,,, ,,,Расчет складского архива по товарам"
     3547         ,input false
     3548         ,buffer calc-arh-lock_batchprocess
     3549         ) no-error .
     3550       if error-status :error
     3551       then do:
     3552         if error-status :get-message(1) <> ""
     3553         then do:
     3554           message
     3555             vss-workfile vss-revision vss-description skip
     3556             "Ошибка при вызове процедуры блокировки расчета складского архива по товарам" skip
     3557             "Невозможно продолжить восстановление складского архива по товарам" skip
     3558             error-status :get-message(1) skip
     3559             return-value skip
     3560             view-as alert-box error .
     3561           undo, return error "Ошибка при вызове процедуры блокировки расчёта складского архива по товарам" .
     3562         end.
     3563         assign
     3564           v-need-stop-arh = true
     3565         .
     3566       end.
     3567       define buffer stop-arh-restore-lock_btpr for batchprocess .
     3568       if v-need-stop-arh = true
     3569       then do:
     3570         do transaction
     3571         on error undo, return error return-value
     3572         :
     3573           create stop-arh-restore-lock_btpr .
     3574           assign
     3575             stop-arh-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
     3576             stop-arh-restore-lock_btpr.bp_status     = 'N':U
     3577             stop-arh-restore-lock_btpr.Key#_One      = v-obj-code
     3578             stop-arh-restore-lock_btpr.Key#_Two      = 0
     3579             stop-arh-restore-lock_btpr.Key#_Three    = 0
     3580             stop-arh-restore-lock_btpr.CharKey_One   = v-obj-type
     3581             stop-arh-restore-lock_btpr.CharKey_Two   = ""
     3582             stop-arh-restore-lock_btpr.CharKey_Three = ""
     3583           .
     3584           define variable v-start-lock-time   as int64     no-undo .
     3585           define variable v-start-lock-second as integer   no-undo .
     3586           assign
     3587             v-start-lock-time = etime
     3588           .
     3589           wait_block:
     3590           do while true
     3591           :
     3592             assign
     3593               v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
     3594             .
     3595             run waitfram-show in this-procedure
     3596               (input waitfram-join-function("Складской архив рассчитывается на другой машине"
     3597                                            ,"Отправлено сообщение о необходимости остановки расчёта складского архива"
     3598                                            ,substitute("Ожидание освобождения ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
     3599                                            )
     3600               ) .
     3601             run gbl/lock-prc.p
     3602               (input 'btpr':U
     3603               ,input v-obj-code
     3604               ,input 0
     3605               ,input 0
     3606               ,input v-obj-type
     3607               ,input ""
     3608               ,input ""
     3609               ,input "Объект,,, ,,,Расчет складского архива по товарам"
     3610               ,input false
     3611               ,buffer calc-arh-lock_batchprocess
     3612               ) no-error .
     3613             if error-status :error
     3614             then do:
     3615               if error-status :get-message(1) <> ""
     3616               then do:
     3617                 message
     3618                   vss-workfile vss-revision vss-description skip
     3619                   "Ошибка при вызове процедуры блокировки расчета складского архива по товарам" skip
     3620                   "Невозможно продолжить восстановление складского архива по товарам" skip
     3621                   view-as alert-box error .
     3622                 undo, return error "В данный момент рассчитывается складской архив по товарам" .
     3623               end.
     3624             end.
     3625             else do:
     3626               run waitfram-hide in this-procedure .
     3627               leave wait_block .
     3628             end.
     3629             pause 1 no-message .
     3630           end.
     3631           delete stop-arh-restore-lock_btpr .
     3632         end.
     3633       end.
     3634       run show-action in this-procedure
     3635         (input "Удаление повторных записей остатков"
     3636         ).
     3637       run ahrstutl-delete-copy in this-procedure
     3638         (input v-obj-type
     3639         ,input v-obj-code
     3640         ,input v-arh-detail-date - 1
     3641         ) .
     3642       run show-action in this-procedure
     3643         (input "Обновление атрибутов складского архива по товарам"
     3644         ).
     3645       run clntattr-write in this-procedure
     3646         (input v-obj-type
     3647         ,input v-obj-code
     3648         ,input 'arh-start':U
     3649         ,input string(v-restore-start-date, '99/99/9999':u)
     3650         ) no-error .
     3651       if error-status :error
     3652       then do:
     3653         message
     3654           vss-workfile vss-revision vss-description skip
     3655           "Ошибка при записи даты начала складского архива по товарам" skip
     3656           error-status :get-message(1) skip
     3657           return-value skip
     3658           view-as alert-box error .
     3659         undo, return error return-value .
     3660       end.
     3661       run clntattr-write in this-procedure
     3662         (input v-obj-type
     3663         ,input v-obj-code
     3664         ,input 'arh-detail':U
     3665         ,input string(v-restore-detail-date, '99/99/9999':u)
     3666         ) no-error .
     3667       if error-status :error
     3668       then do:
     3669         message
     3670           vss-workfile vss-revision vss-description skip
     3671           "Ошибка при записи даты начала подробного архива по товарам" skip
     3672           error-status :get-message(1) skip
     3673           return-value skip
     3674           view-as alert-box error .
     3675         undo, return error return-value .
     3676       end.
     3677       define variable v-delete-arh-rest as logical   no-undo .
     3678       run clntattr-delete in this-procedure
     3679         (input  v-obj-type
     3680         ,input  v-obj-code
     3681         ,input  'arh-rest':U
     3682         ,output v-delete-arh-rest
     3683         ) .
     3684     end.
     3685     if v-restore-from-file = true
     3686     then do:
     3687       assign
     3688         v-action-type = 'rstfil-stop':U
     3689       .
     3690     end.
     3691     else do:
     3692       assign
     3693         v-action-type = 'rstdoc-stop':U
     3694       .
     3695     end.
     3696     run utl/arhiscr.p
     3697       (input  v-obj-type
     3698       ,input  v-obj-code
     3699       ,input  'arh':U
     3700       ,input  v-action-type
     3701       ,input  ""
     3702       ,input  ""
     3703       ,input  0
     3704       ,input  ""
     3705       ,input  ""
     3706       ,input  v-restore-detail-date
     3707       ,output v-create-chip-num
     3708       ) .
     3709     run invalidate-md5-signature in this-procedure
     3710       (input  v-obj-type
     3711       ,input  v-obj-code
     3712       ,input  'arh':U
     3713       ,input  v-file-name
     3714       ,input  v-create-chip-num
     3715       ) .
     3716     run invalidate-md5-signature in this-procedure
     3717       (input  v-obj-type
     3718       ,input  v-obj-code
     3719       ,input  'arh':U
     3720       ,input  v-backup-file-name
     3721       ,input  v-create-chip-num
     3722       ) .
     3723     message
     3724       "Складской архив по товарам" skip
     3725       "Объект" v-obj-type v-obj-code skip
     3726       "Восстановление складского архива по товарам успешно закончилось" skip
     3727       "" + (if v-restore-detail-date <> ?
     3728            then substitute("На объекте существует подробный складской архив с даты &1", string(v-restore-detail-date, '99/99/9999':u))
     3729            else "На объекте существует складской архив с даты открытия объекта"
     3730            ) skip
     3731       view-as alert-box information .
     3732   end.
     3733   procedure restore-from-file :
     3734     do
     3735     on error undo, return error return-value
     3736     :
     3737       define variable v-key-value as character no-undo .
     3738       run show-action in this-procedure
     3739         (input "Импорт данных из файла " + v-file-name
     3740         ) .
     3741       define variable v-data-finished as logical   no-undo .
     3742       assign
     3743         v-data-finished = false
     3744       .
     3745       assign
     3746         v-line-num = 0
     3747       .
     3748       define variable v-total-count as integer   no-undo .
     3749       assign
     3750         v-total-count = 0
     3751       .
     3752       repeat
     3753       :
     3754         import stream sinp v-key-value .
     3755         assign
     3756           v-line-num = v-line-num + 1
     3757         .
     3758         assign
     3759           v-total-count = v-total-count + 1
     3760         .
     3761         if v-total-count modulo 10 = 0
     3762         then do:
     3763           run show-count in this-procedure
     3764             (input v-total-count
     3765             ,input "Чтение файла"
     3766             ) .
     3767         end.
     3768         case v-key-value :
     3769           when 'ot-tot':U
     3770           then do:
     3771             define buffer buf_temp-import-ot-tot for temp-import-ot-tot .
     3772             create buf_temp-import-ot-tot .
     3773             import stream sinp buf_temp-import-ot-tot no-error .
     3774             if error-status :error
     3775             then do:
     3776               message
     3777                 vss-workfile vss-revision vss-description skip
     3778                 "Ошибка при импорте таблицы ot-tot" skip
     3779                 "Строка" v-line-num skip
     3780                 error-status :get-message(1) skip
     3781                 view-as alert-box error .
     3782               undo, return error .
     3783             end.
     3784             assign
     3785               v-line-num = v-line-num + 1
     3786             .
     3787             define buffer buf_ot-tot for ub.ot-tot .
     3788             create buf_ot-tot .
     3789             buffer-copy buf_temp-import-ot-tot to buf_ot-tot .
     3790             delete buf_temp-import-ot-tot .
     3791           end.
     3792           when 'ot-line':U
     3793           then do:
     3794             define buffer buf_temp-import-ot-line for temp-import-ot-line .
     3795             create buf_temp-import-ot-line .
     3796             import stream sinp buf_temp-import-ot-line except artic prod-type prod-code
     3797               no-error .
     3798             if error-status :error
     3799             then do:
     3800               message
     3801                 vss-workfile vss-revision vss-description skip
     3802                 "Ошибка при импорте таблицы ot-line" skip
     3803                 "Строка" v-line-num skip
     3804                 error-status :get-message(1) skip
     3805                 view-as alert-box error .
     3806               undo, return error .
     3807             end.
     3808             assign
     3809               v-line-num = v-line-num + 1
     3810             .
     3811             run fill-artic in this-procedure
     3812               (input  buf_temp-import-ot-line.gds-code
     3813               ,output buf_temp-import-ot-line.artic
     3814               ,output buf_temp-import-ot-line.prod-type
     3815               ,output buf_temp-import-ot-line.prod-code
     3816               ) .
     3817             define buffer buf_ot-line for ub.ot-line .
     3818             create buf_ot-line .
     3819             buffer-copy buf_temp-import-ot-line to buf_ot-line .
     3820             delete buf_temp-import-ot-line .
     3821           end.
     3822           when 'stk-tot':U
     3823           then do:
     3824             define buffer buf_temp-import-stk-tot for temp-import-stk-tot .
     3825             create buf_temp-import-stk-tot .
     3826             import stream sinp buf_temp-import-stk-tot no-error .
     3827             if error-status :error
     3828             then do:
     3829               message
     3830                 vss-workfile vss-revision vss-description skip
     3831                 "Ошибка при импорте таблицы stk-tot" skip
     3832                 "Строка" v-line-num skip
     3833                 error-status :get-message(1) skip
     3834                 view-as alert-box error .
     3835               undo, return error .
     3836             end.
     3837             assign
     3838               v-line-num = v-line-num + 1
     3839             .
     3840             define buffer buf_stk-tot for ub.stk-tot .
     3841             create buf_stk-tot .
     3842             buffer-copy buf_temp-import-stk-tot to buf_stk-tot .
     3843             delete buf_temp-import-stk-tot .
     3844           end.
     3845           when 'stk-line':U
     3846           then do:
     3847             define buffer buf_temp-import-stk-line for temp-import-stk-line .
     3848             create buf_temp-import-stk-line .
     3849             import stream sinp buf_temp-import-stk-line except artic prod-type prod-code
     3850               no-error .
     3851             if error-status :error
     3852             then do:
     3853               message
     3854                 vss-workfile vss-revision vss-description skip
     3855                 "Ошибка при импорте таблицы stk-line" skip
     3856                 "Строка" v-line-num skip
     3857                 error-status :get-message(1) skip
     3858                 view-as alert-box error .
     3859               undo, return error .
     3860             end.
     3861             assign
     3862               v-line-num = v-line-num + 1
     3863             .
     3864             run fill-artic in this-procedure
     3865               (input  buf_temp-import-stk-line.gds-code
     3866               ,output buf_temp-import-stk-line.artic
     3867               ,output buf_temp-import-stk-line.prod-type
     3868               ,output buf_temp-import-stk-line.prod-code
     3869               ) .
     3870             define buffer buf_stk-line for ub.stk-line .
     3871             create buf_stk-line .
     3872             buffer-copy buf_temp-import-stk-line to buf_stk-line .
     3873             delete buf_temp-import-stk-line .
     3874           end.
     3875           when 'end-of-log':u
     3876           then do:
     3877             assign
     3878               v-data-finished = true
     3879             .
     3880             leave .
     3881           end.
     3882           otherwise do:
     3883             message
     3884               vss-workfile vss-revision vss-description skip
     3885               "Неизвестный код таблицы" v-key-value skip
     3886               "Строка" v-line-num skip
     3887               view-as alert-box error .
     3888             undo, return error .
     3889           end.
     3890         end case .
     3891       end.
     3892       if v-data-finished = false
     3893       then do:
     3894         message
     3895           vss-workfile vss-revision vss-description skip
     3896           "Складской архив по товарам" skip
     3897           "Объект" v-obj-type v-obj-code skip
     3898           "Не найден признак окончания данных в файле" skip
     3899           "Неправильный формат файла" v-file-name skip
     3900           "Строка" v-line-num skip
     3901           view-as alert-box error .
     3902         undo, return error .
     3903       end.
     3904     end.
     3905   end procedure.
     3906   procedure validate-file-name :
     3907     define input parameter  p-obj-type            as character no-undo .
     3908     define input parameter  p-obj-code            as integer   no-undo .
     3909     define input parameter  v-arh-detail-date     as date      no-undo .
     3910     define input parameter  p-file-name           as character no-undo .
     3911     define output parameter p-restore-start-date  as date      no-undo .
     3912     define output parameter p-restore-detail-date as date      no-undo .
     3913     do
     3914     on error undo, return error
     3915     :
     3916       define variable v-param-code  as character no-undo .
     3917       define variable v-param-value as character no-undo .
     3918       import stream sinp v-param-code v-param-value .
     3919       assign
     3920         v-line-num = v-line-num + 1
     3921       .
     3922       if v-param-code <> 'archive-log-version':u
     3923       or v-param-value <> '2.1':u
     3924       then do:
     3925         message
     3926           "Складской архив по товарам" skip
     3927           "Объект" p-obj-type p-obj-code skip
     3928           "Неправильный формат файла" p-file-name skip
     3929           "Строка" v-line-num skip
     3930           "Значения" v-param-code v-param-value skip
     3931           view-as alert-box error .
     3932         undo, return error .
     3933       end.
     3934       import stream sinp v-param-code v-param-value .
     3935       assign
     3936         v-line-num = v-line-num + 1
     3937       .
     3938       if v-param-code <> 'obj-type':u
     3939       or v-param-value <> p-obj-type
     3940       then do:
     3941         message
     3942           "Складской архив по товарам" skip
     3943           "Объект" p-obj-type p-obj-code skip
     3944           "Неправильный формат файла" p-file-name skip
     3945           "Строка" v-line-num skip
     3946           "Значения" v-param-code v-param-value skip
     3947           view-as alert-box error .
     3948         undo, return error .
     3949       end.
     3950       import stream sinp v-param-code v-param-value .
     3951       assign
     3952         v-line-num = v-line-num + 1
     3953       .
     3954       if v-param-code <> 'obj-code':u
     3955       or v-param-value <> string(p-obj-code)
     3956       then do:
     3957         message
     3958           "Складской архив по товарам" skip
     3959           "Объект" p-obj-type p-obj-code skip
     3960           "Неправильный формат файла" p-file-name skip
     3961           "Строка" v-line-num skip
     3962           "Значения" v-param-code v-param-value skip
     3963           view-as alert-box error .
     3964         undo, return error .
     3965       end.
     3966       import stream sinp v-param-code v-param-value .
     3967       assign
     3968         v-line-num = v-line-num + 1
     3969       .
     3970       if v-param-code <> 'old-start-date':u
     3971       then do:
     3972         message
     3973           "Складской архив по товарам" skip
     3974           "Объект" p-obj-type p-obj-code skip
     3975           "Неправильный формат файла" p-file-name skip
     3976           "Строка" v-line-num skip
     3977           "Значения" v-param-code v-param-value skip
     3978           view-as alert-box error .
     3979         undo, return error .
     3980       end.
     3981       assign
     3982         p-restore-start-date = date(v-param-value)
     3983       .
     3984       import stream sinp v-param-code v-param-value .
     3985       assign
     3986         v-line-num = v-line-num + 1
     3987       .
     3988       if v-param-code <> 'old-detail-date':u
     3989       then do:
     3990         message
     3991           "Складской архив по товарам" skip
     3992           "Объект" p-obj-type p-obj-code skip
     3993           "Неправильный формат файла" p-file-name skip
     3994           "Строка" v-line-num skip
     3995           "Значения" v-param-code v-param-value skip
     3996           view-as alert-box error .
     3997         undo, return error .
     3998       end.
     3999       assign
     4000         p-restore-detail-date = date(v-param-value)
     4001       .
     4002       import stream sinp v-param-code v-param-value .
     4003       assign
     4004         v-line-num = v-line-num + 1
     4005       .
     4006       if v-param-code <> 'new-start-date':u
     4007       then do:
     4008         message
     4009           "Складской архив по товарам" skip
     4010           "Объект" p-obj-type p-obj-code skip
     4011           "Неправильный формат файла" p-file-name skip
     4012           "Строка" v-line-num skip
     4013           "Значения" v-param-code v-param-value skip
     4014           view-as alert-box error .
     4015         undo, return error .
     4016       end.
     4017       import stream sinp v-param-code v-param-value .
     4018       assign
     4019         v-line-num = v-line-num + 1
     4020       .
     4021       if v-param-code <> 'new-detail-date':u
     4022       then do:
     4023         message
     4024           "Складской архив по товарам" skip
     4025           "Объект" p-obj-type p-obj-code skip
     4026           "Неправильный формат файла" p-file-name skip
     4027           "Строка" v-line-num skip
     4028           "Значения" v-param-code v-param-value skip
     4029           view-as alert-box error .
     4030         undo, return error .
     4031       end.
     4032       if v-arh-detail-date <> date(v-param-value)
     4033       then do:
     4034         message
     4035           "Складской архив по товарам" skip
     4036           "Объект" p-obj-type p-obj-code skip
     4037           "Несоответствие текущей даты начала подробного архива" skip
     4038           "и даты начала подробного архива в файле" p-file-name skip
     4039           "Строка" v-line-num skip
     4040           "Текущая дата начала подробного архива" string(v-arh-detail-date) skip
     4041           "Дата начала подробного архива в файле" v-param-value skip
     4042           "Восстановление архива невозможно" skip
     4043           view-as alert-box error .
     4044         undo, return error .
     4045       end.
     4046     end.
     4047   end procedure.
     4048   procedure show-action :
     4049     do
     4050     on error undo, return error
     4051     :
     4052       define input parameter p-action as character no-undo .
     4053       assign
     4054         v-current-time = string(time - v-start-time, "HH:MM:SS")
     4055         v-current-action = p-action
     4056       .
     4057       display
     4058         v-current-time
     4059         v-current-action
     4060         with frame a.
     4061     end.
     4062   end procedure.
     4063   procedure show-count :
     4064     define input  parameter p-count      as integer   no-undo .
     4065     define input  parameter p-sub-action as character no-undo .
     4066     do
     4067     on error undo, return error
     4068     :
     4069       assign
     4070         v-current-time = string(time - v-start-time, "HH:MM:SS")
     4071         v-count        = p-count
     4072         v-sub-action   = p-sub-action
     4073       .
     4074       display
     4075         v-current-time
     4076         v-count
     4077         v-sub-action
     4078         with frame a.
     4079     end.
     4080   end procedure.
     4081   procedure create-log-file :
     4082     define input  parameter p-obj-type        as character no-undo .
     4083     define input  parameter p-obj-code        as integer   no-undo .
     4084     define input  parameter p-old-start-date  as date      no-undo .
     4085     define input  parameter p-old-detail-date as date      no-undo .
     4086     define input  parameter p-new-start-date  as date      no-undo .
     4087     define input  parameter p-new-detail-date as date      no-undo .
     4088     define input  parameter p-file-name       as character no-undo .
     4089     do
     4090     on error undo, return error return-value
     4091     :
     4092       if search('.' + '/':u + p-file-name) <> ?
     4093       then do:
     4094         define variable v-ok as logical   no-undo .
     4095         message
     4096           "ВНИМАНИЕ!" skip
     4097           "Файл" p-file-name "существует и будет перезаписан" skip
     4098           "Продолжить?"
     4099           view-as alert-box question buttons yes-no update v-ok .
     4100         if v-ok <> true
     4101         then do:
     4102           undo, return error return-value .
     4103         end.
     4104       end.
     4105       output stream slog to value(p-file-name) .
     4106       export stream slog 'archive-log-version':u '2.1':u .
     4107       export stream slog 'obj-type':u            p-obj-type .
     4108       export stream slog 'obj-code':u            string(p-obj-code) .
     4109       export stream slog 'old-start-date':u      string(p-old-start-date, '99/99/9999':u ) .
     4110       export stream slog 'old-detail-date':u     string(p-old-detail-date, '99/99/9999':u ) .
     4111       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     4112       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     4113       output stream slog close .
     4114     end.
     4115   end procedure.
     4116   procedure close-log-file :
     4117     define input  parameter p-obj-type        as character no-undo .
     4118     define input  parameter p-obj-code        as integer   no-undo .
     4119     define input  parameter p-old-start-date  as date      no-undo .
     4120     define input  parameter p-old-detail-date as date      no-undo .
     4121     define input  parameter p-new-start-date  as date      no-undo .
     4122     define input  parameter p-new-detail-date as date      no-undo .
     4123     define input  parameter p-file-name       as character no-undo .
     4124     do
     4125     on error undo, return error return-value
     4126     :
     4127       output stream slog to value(p-file-name) append .
     4128       export stream slog 'end-of-log':u .
     4129       export stream slog 'archive-log-version':u '2.1':u .
     4130       export stream slog 'obj-type':u            p-obj-type .
     4131       export stream slog 'obj-code':u            string(p-obj-code) .
     4132       export stream slog 'old-start-date':u      string(p-old-start-date, '99/99/9999':u ) .
     4133       export stream slog 'old-detail-date':u     string(p-old-detail-date, '99/99/9999':u ) .
     4134       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     4135       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     4136       export stream slog '.':u                   .
     4137       output stream slog close .
     4138     end.
     4139   end procedure.
     4140   procedure store-temp :
     4141     define buffer buf_temp-stk-tot         for temp-stk-tot        .
     4142     define buffer buf_temp-stk-line        for temp-stk-line       .
     4143     define buffer buf_temp-shift-stk-tot   for temp-shift-stk-tot  .
     4144     define buffer buf_temp-shift-stk-line  for temp-shift-stk-line .
     4145     define buffer buf_temp-create-stk-tot  for temp-create-stk-tot .
     4146     define buffer buf_temp-create-stk-line for temp-create-stk-line .
     4147     do
     4148     on error undo, return error return-value
     4149     :
     4150       output stream sout to value ("rst-arh.txt") append .
     4151       export stream sout 'export':u string(today, '99/99/9999':u) string(time, 'hh:mm:ss':u) .
     4152       for each buf_temp-stk-tot
     4153       on error undo, return error return-value
     4154       :
     4155         export stream sout 'temp-stk-tot':u .
     4156         export stream sout buf_temp-stk-tot .
     4157       end.
     4158       for each buf_temp-stk-line
     4159       on error undo, return error return-value
     4160       :
     4161         export stream sout 'temp-stk-line':u .
     4162         export stream sout buf_temp-stk-line .
     4163       end.
     4164       for each buf_temp-shift-stk-tot
     4165       on error undo, return error return-value
     4166       :
     4167         export stream sout 'temp-shift-stk-tot':u .
     4168         export stream sout buf_temp-shift-stk-tot .
     4169       end.
     4170       for each buf_temp-shift-stk-line
     4171       on error undo, return error return-value
     4172       :
     4173         export stream sout 'temp-shift-stk-line':u .
     4174         export stream sout buf_temp-shift-stk-line .
     4175       end.
     4176       for each buf_temp-create-stk-tot
     4177       on error undo, return error return-value
     4178       :
     4179         export stream sout 'temp-create-stk-tot':u .
     4180         export stream sout buf_temp-create-stk-tot .
     4181       end.
     4182       for each buf_temp-create-stk-line
     4183       on error undo, return error return-value
     4184       :
     4185         export stream sout 'temp-create-stk-line':u .
     4186         export stream sout buf_temp-create-stk-line .
     4187       end.
     4188       output stream sout close .
     4189     end.
     4190   end procedure.
     4191   procedure ahrstutl-init :
     4192     define input  parameter p-obj-type  as character no-undo .
     4193     define input  parameter p-obj-code  as integer   no-undo .
     4194     define input  parameter p-fact-date as date      no-undo .
     4195     define input  parameter p-save-new  as logical   no-undo .
     4196     define variable v-shift-on                as logical   no-undo .
     4197     define variable v-shift-date              as date      no-undo .
     4198     define variable v-shift-num               as integer   no-undo .
     4199     define variable v-day-end-fact-order      as decimal   no-undo .
     4200     define variable v-shift-end-fact-order    as decimal   no-undo .
     4201     define variable v-search-end-fact-order   as decimal   no-undo .
     4202     define variable v-create-fact-order       as decimal   no-undo .
     4203     define variable v-shift-create-fact-order as decimal   no-undo .
     4204     define variable v-gds-goods     as logical   no-undo .
     4205     define variable v-sum-type-list as character no-undo .
     4206     do
     4207     on error undo, return error return-value
     4208     :
     4209       run factord-cut-archive in this-procedure
     4210         (input  p-obj-type
     4211         ,input  p-obj-code
     4212         ,input  p-fact-date
     4213         ,output v-shift-on
     4214         ,output v-shift-date
     4215         ,output v-shift-num
     4216         ,output v-day-end-fact-order
     4217         ,output v-shift-end-fact-order
     4218         ) .
     4219       assign
     4220         v-create-fact-order       = v-day-end-fact-order
     4221         v-shift-create-fact-order = v-shift-end-fact-order
     4222       .
     4223       if p-save-new = true
     4224       then do:
     4225         assign
     4226           v-day-end-fact-order   = v-day-end-fact-order - 0.0000000001
     4227           v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     4228         .
     4229       end.
     4230       define variable v-ind as integer   no-undo .
     4231       run show-action in this-procedure
     4232         (input "Остаток по объекту"
     4233         ).
     4234       run ahrstutl-tot-sum-type-list in this-procedure
     4235         (output v-sum-type-list
     4236         ) .
     4237       do v-ind = 1 to num-entries(v-sum-type-list)
     4238       :
     4239         run ahrstutl-init-tot in this-procedure
     4240           (input p-obj-type
     4241           ,input p-obj-code
     4242           ,input entry(v-ind, v-sum-type-list)
     4243           ,input p-fact-date
     4244           ,input v-day-end-fact-order
     4245           ,input v-create-fact-order
     4246           ,input v-shift-on
     4247           ,input v-shift-date
     4248           ,input v-shift-num
     4249           ,input v-shift-end-fact-order
     4250           ,input v-shift-create-fact-order
     4251           ,input p-save-new
     4252           ) .
     4253       end.
     4254       run show-action in this-procedure
     4255         (input "Остаток по товарам"
     4256         ).
     4257       define variable v-total-count as integer   no-undo .
     4258       define buffer buf_doclslib-goods for doclslib-goods.
     4259       for each buf_doclslib-goods no-lock
     4260       on error undo, return error return-value
     4261       :
     4262         assign
     4263           v-total-count = v-total-count + 1
     4264         .
     4265         if v-total-count modulo 10 = 0
     4266         then do:
     4267           run show-count in this-procedure
     4268             (input v-total-count
     4269             ,input "Артикул " + string(buf_doclslib-goods.artic)
     4270             ).
     4271         end.
     4272   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     4273     (input  buf_doclslib-goods.gds-code
     4274     ,input  'gds-goods=request':u
     4275     ,output v-gds-goods
     4276     ) no-error .
     4277         run ahrstutl-line-sum-type-list in this-procedure
     4278           (input  v-gds-goods
     4279           ,output v-sum-type-list
     4280           ) .
     4281         do v-ind = 1 to num-entries(v-sum-type-list)
     4282         :
     4283           run ahrstutl-init-line in this-procedure
     4284             (input p-obj-type
     4285             ,input p-obj-code
     4286             ,input buf_doclslib-goods.artic
     4287             ,input buf_doclslib-goods.prod-type
     4288             ,input buf_doclslib-goods.prod-code
     4289             ,input entry(v-ind, v-sum-type-list)
     4290             ,input p-fact-date
     4291             ,input v-day-end-fact-order
     4292             ,input v-create-fact-order
     4293             ,input v-shift-on
     4294             ,input v-shift-date
     4295             ,input v-shift-num
     4296             ,input v-shift-end-fact-order
     4297             ,input v-shift-create-fact-order
     4298             ,input p-save-new
     4299             ) .
     4300         end.
     4301       end.
     4302     end.
     4303   end procedure.
     4304   procedure ahrstutl-init-tot :
     4305     define input  parameter p-obj-type                    as character no-undo .
     4306     define input  parameter p-obj-code                    as integer   no-undo .
     4307     define input  parameter p-root-sum-type               as character no-undo .
     4308     define input  parameter p-fact-date                   as date      no-undo .
     4309     define input  parameter p-stk-tot-fact-order          as decimal   no-undo .
     4310     define input  parameter p-create-tot-fact-order       as decimal   no-undo .
     4311     define input  parameter p-shift-on                    as logical   no-undo .
     4312     define input  parameter p-shift-date                  as date      no-undo .
     4313     define input  parameter p-shift-num                   as integer   no-undo .
     4314     define input  parameter p-shift-stk-tot-fact-order    as decimal   no-undo .
     4315     define input  parameter p-shift-create-tot-fact-order as decimal   no-undo .
     4316     define input  parameter p-save-new                    as logical   no-undo .
     4317     define buffer buf_stk-tot for ub.stk-tot .
     4318     define buffer buf_temp-stk-tot for temp-stk-tot .
     4319     define buffer buf_temp-shift-stk-tot for temp-shift-stk-tot .
     4320     define buffer buf_temp-create-stk-tot for temp-create-stk-tot .
     4321     define variable v-prev-stk-tot-fact-order        like ub.stk-tot.fact-order no-undo .
     4322     define variable v-create-stk as logical   no-undo .
     4323     do
     4324     on error undo, return error return-value
     4325     :
     4326       assign
     4327         v-create-stk = false
     4328       .
     4329       find last buf_stk-tot no-lock
     4330         where buf_stk-tot.obj-type   = p-obj-type
     4331           and buf_stk-tot.obj-code   = p-obj-code
     4332           and buf_stk-tot.sum-type   = p-root-sum-type
     4333           and buf_stk-tot.cat-id     = '##,##':U
     4334           and buf_stk-tot.fact-order <= p-stk-tot-fact-order
     4335         use-index category
     4336         no-error .
     4337       if available buf_stk-tot
     4338       then do:
     4339         assign
     4340           v-prev-stk-tot-fact-order = buf_stk-tot.fact-order
     4341         .
     4342         if v-prev-stk-tot-fact-order <> p-stk-tot-fact-order
     4343         then do:
     4344           assign
     4345             v-create-stk = true
     4346           .
     4347         end.
     4348         else do:
     4349           assign
     4350             v-create-stk = false
     4351           .
     4352         end.
     4353         for each buf_stk-tot no-lock
     4354           where buf_stk-tot.obj-type   = p-obj-type
     4355             and buf_stk-tot.obj-code   = p-obj-code
     4356             and buf_stk-tot.fact-order = v-prev-stk-tot-fact-order
     4357             and buf_stk-tot.sum-type   begins p-root-sum-type
     4358         on error undo, return error return-value
     4359         :
     4360           find first buf_temp-stk-tot
     4361             where buf_temp-stk-tot.obj-type   = buf_stk-tot.obj-type
     4362               and buf_temp-stk-tot.obj-code   = buf_stk-tot.obj-code
     4363               and buf_temp-stk-tot.fact-order = p-create-tot-fact-order
     4364               and buf_temp-stk-tot.sum-type   = buf_stk-tot.sum-type
     4365               and buf_temp-stk-tot.cat-id     = buf_stk-tot.cat-id
     4366             no-error .
     4367           if not available buf_temp-stk-tot
     4368           then do:
     4369             create buf_temp-stk-tot .
     4370             assign
     4371                                       buf_temp-stk-tot.obj-type     = buf_stk-tot.obj-type     buf_temp-stk-tot.obj-code     = buf_stk-tot.obj-code     buf_temp-stk-tot.fact-order   = buf_stk-tot.fact-order   buf_temp-stk-tot.sum-type     = buf_stk-tot.sum-type     buf_temp-stk-tot.cat-id       = buf_stk-tot.cat-id       buf_temp-stk-tot.fact-date    = buf_stk-tot.fact-date    buf_temp-stk-tot.shift-num    = buf_stk-tot.shift-num    buf_temp-stk-tot.shift-date   = buf_stk-tot.shift-date
     4372               buf_temp-stk-tot.fact-order = p-create-tot-fact-order
     4373               buf_temp-stk-tot.fact-date  = p-fact-date
     4374               buf_temp-stk-tot.shift-num  = 0
     4375               buf_temp-stk-tot.shift-date = ?
     4376             .
     4377           end.
     4378           if p-save-new = true
     4379           then do:
     4380             assign
