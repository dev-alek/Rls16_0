     5204             for each buf_stk-line exclusive-lock
     5205               where buf_stk-line.obj-type   = buf_gds-obj.obj-type
     5206                 and buf_stk-line.obj-code   = buf_gds-obj.obj-code
     5207                 and buf_stk-line.artic      = buf_gds-obj.artic
     5208                 and buf_stk-line.prod-type  = buf_gds-obj.prod-type
     5209                 and buf_stk-line.prod-code  = buf_gds-obj.prod-code
     5210                 and buf_stk-line.fact-order = v-shift-end-fact-order
     5211             on error undo, return error return-value
     5212             :
     5213               delete buf_stk-line .
     5214             end.
     5215           end.
     5216         end.
     5217       end.
     5218     end.
     5219   end procedure.
     5220   procedure ahrstutl-update :
     5221     define input  parameter p-obj-type           as character no-undo .
     5222     define input  parameter p-obj-code           as integer   no-undo .
     5223     define input  parameter p-first-cut-date     as date      no-undo .
     5224     define input  parameter p-last-cut-date      as date      no-undo .
     5225     define buffer buf_doclslib-goods for doclslib-goods .
     5226     define variable v-shift-on                   as logical   no-undo .
     5227     define variable v-first-shift-date           as date      no-undo .
     5228     define variable v-first-shift-num            as integer   no-undo .
     5229     define variable v-first-day-end-fact-order   as decimal   no-undo .
     5230     define variable v-first-shift-end-fact-order as decimal   no-undo .
     5231     define variable v-last-shift-date            as date      no-undo .
     5232     define variable v-last-shift-num             as integer   no-undo .
     5233     define variable v-last-day-end-fact-order    as decimal   no-undo .
     5234     define variable v-last-shift-end-fact-order  as decimal   no-undo .
     5235     define variable v-gds-goods     as logical   no-undo .
     5236     define variable v-sum-type-list as character no-undo .
     5237     define variable v-ind           as integer   no-undo .
     5238     do
     5239     on error undo, return error return-value
     5240     :
     5241       run factord-cut-archive in this-procedure
     5242         (input  p-obj-type
     5243         ,input  p-obj-code
     5244         ,input  p-first-cut-date
     5245         ,output v-shift-on
     5246         ,output v-first-shift-date
     5247         ,output v-first-shift-num
     5248         ,output v-first-day-end-fact-order
     5249         ,output v-first-shift-end-fact-order
     5250         ) .
     5251       run factord-cut-archive in this-procedure
     5252         (input  p-obj-type
     5253         ,input  p-obj-code
     5254         ,input  p-last-cut-date
     5255         ,output v-shift-on
     5256         ,output v-last-shift-date
     5257         ,output v-last-shift-num
     5258         ,output v-last-day-end-fact-order
     5259         ,output v-last-shift-end-fact-order
     5260         ) .
     5261       run show-action in this-procedure
     5262         (input "Пересчитываем остаток по объекту"
     5263         ).
     5264       run ahrstutl-tot-sum-type-list in this-procedure
     5265         (output v-sum-type-list
     5266         ) .
     5267       do v-ind = 1 to num-entries(v-sum-type-list)
     5268       :
     5269         run ahrstutl-store-tot in this-procedure
     5270           (input p-obj-type
     5271           ,input p-obj-code
     5272           ,input entry(v-ind, v-sum-type-list)
     5273           ,input v-shift-on
     5274           ,input p-first-cut-date
     5275           ,input p-last-cut-date
     5276           ,input v-first-day-end-fact-order
     5277           ,input v-first-shift-end-fact-order
     5278           ,input v-first-shift-date
     5279           ,input v-first-shift-num
     5280           ,input v-last-day-end-fact-order
     5281           ,input v-last-shift-end-fact-order
     5282           ,input v-last-shift-date
     5283           ,input v-last-shift-num
     5284           ) no-error .
     5285         if error-status :error
     5286         then do:
     5287           message
     5288             vss-workfile vss-revision vss-description skip
     5289             "Ошибка при вызове процедуры" 'ahrstutl-store-tot':u skip
     5290             "v-ind" v-ind skip
     5291             "sum-type" entry(v-ind, v-sum-type-list) skip
     5292             return-value skip
     5293             error-status :get-message(1) skip
     5294             view-as alert-box error .
     5295           undo, return error .
     5296         end.
     5297       end.
     5298       run show-action in this-procedure
     5299         (input "Пересчитываем остаток по товару"
     5300         ).
     5301       define variable v-total-count as integer   no-undo .
     5302       for each buf_doclslib-goods no-lock
     5303       on error undo, return error return-value
     5304       :
     5305         assign
     5306           v-total-count = v-total-count + 1
     5307         .
     5308         if v-total-count modulo 10 = 0
     5309         then do:
     5310           run show-count in this-procedure
     5311             (input v-total-count
     5312             ,input "Артикул " + string(buf_doclslib-goods.artic)
     5313             ).
     5314         end.
     5315   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     5316     (input  buf_doclslib-goods.gds-code
     5317     ,input  'gds-goods=request':u
     5318     ,output v-gds-goods
     5319     ) no-error .
     5320         run ahrstutl-line-sum-type-list in this-procedure
     5321           (input  v-gds-goods
     5322           ,output v-sum-type-list
     5323           ) .
     5324         do v-ind = 1 to num-entries(v-sum-type-list)
     5325         :
     5326           run ahrstutl-store-line in this-procedure
     5327             (input p-obj-type
     5328             ,input p-obj-code
     5329             ,input buf_doclslib-goods.artic
     5330             ,input buf_doclslib-goods.prod-type
     5331             ,input buf_doclslib-goods.prod-code
     5332             ,input entry(v-ind, v-sum-type-list)
     5333             ,input v-shift-on
     5334             ,input p-first-cut-date
     5335             ,input p-last-cut-date
     5336             ,input v-first-day-end-fact-order
     5337             ,input v-first-shift-end-fact-order
     5338             ,input v-first-shift-date
     5339             ,input v-first-shift-num
     5340             ,input v-last-day-end-fact-order
     5341             ,input v-last-shift-end-fact-order
     5342             ,input v-last-shift-date
     5343             ,input v-last-shift-num
     5344             ) no-error .
     5345           if error-status :error
     5346           then do:
     5347             message
     5348               vss-workfile vss-revision vss-description skip
     5349               "Ошибка при вызове процедуры" 'ahrstutl-store-line':u skip
     5350               "Объект" p-obj-type p-obj-code skip
     5351               "Артикул" buf_doclslib-goods.artic buf_doclslib-goods.prod-type buf_doclslib-goods.prod-code skip
     5352               return-value skip
     5353               error-status :get-message(1) skip
     5354               view-as alert-box error .
     5355             undo, return error .
     5356           end.
     5357         end.
     5358       end.
     5359     end.
     5360   end procedure.
     5361   procedure ahrstutl-tot-sum-type-list :
     5362     define output parameter p-sum-type-list as character no-undo .
     5363     do
     5364     on error undo, return error return-value
     5365     :
     5366       define variable v-ind                    as integer   no-undo .
     5367       define variable v-num-entries-TDEDT_List as integer   no-undo .
     5368       assign
     5369         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5370       .
     5371       assign
     5372         p-sum-type-list = 'crsa':U
     5373                         + chr(44)
     5374                         + 'cost':U
     5375       .
     5376       do v-ind = 1 to v-num-entries-TDEDT_List
     5377       :
     5378         assign
     5379           p-sum-type-list = p-sum-type-list
     5380                           + chr(44)
     5381                           + 'sadt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5382         .
     5383       end.
     5384       do v-ind = 1 to v-num-entries-TDEDT_List
     5385       :
     5386         assign
     5387           p-sum-type-list = p-sum-type-list
     5388                           + chr(44)
     5389                           + 'cgdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5390         .
     5391       end.
     5392       do v-ind = 1 to v-num-entries-TDEDT_List
     5393       :
     5394         assign
     5395           p-sum-type-list = p-sum-type-list
     5396                           + chr(44)
     5397                           + 'csdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5398         .
     5399       end.
     5400       do v-ind = 1 to v-num-entries-TDEDT_List
     5401       :
     5402         assign
     5403           p-sum-type-list = p-sum-type-list
     5404                           + chr(44)
     5405                           + 'adsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5406         .
     5407       end.
     5408       do v-ind = 1 to v-num-entries-TDEDT_List
     5409       :
     5410         assign
     5411           p-sum-type-list = p-sum-type-list
     5412                           + chr(44)
     5413                           + 'gdsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5414         .
     5415       end.
     5416       do v-ind = 1 to v-num-entries-TDEDT_List
     5417       :
     5418         assign
     5419           p-sum-type-list = p-sum-type-list
     5420                           + chr(44)
     5421                           + 'sdsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5422         .
     5423       end.
     5424     end.
     5425   end procedure.
     5426   procedure ahrstutl-line-sum-type-list :
     5427     define input  parameter p-gds-goods     as logical   no-undo .
     5428     define output parameter p-sum-type-list as character no-undo .
     5429     do
     5430     on error undo, return error return-value
     5431     :
