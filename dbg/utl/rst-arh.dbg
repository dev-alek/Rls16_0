     2549     define buffer restore-arh-lock_batchprocess for ub.batchprocess .
     2550     run gbl/lock-prc.p
     2551       (input 'rsar':U
     2552       ,input v-obj-code
     2553       ,input 0
     2554       ,input 0
     2555       ,input v-obj-type
     2556       ,input ""
     2557       ,input ""
     2558       ,input "Объект,,, ,,,Восстановление складского архива по товарам"
     2559       ,input true
     2560       ,buffer restore-arh-lock_batchprocess
     2561       ) no-error .
     2562     if error-status :error
     2563     then do:
     2564       if error-status :get-message(1) <> ""
     2565       then do:
     2566         message
     2567           vss-workfile vss-revision vss-description skip
     2568           "Складской архив по товарам" skip
     2569           "Объект" v-obj-type v-obj-code skip
     2570           "В данный момент восстанавливается складской архив по товарам" skip
     2571           "Невозможно произвести восстановлением складского архива по товарам" skip
     2572           view-as alert-box error .
     2573       end.
     2574       undo, return error "В данный момент восстанавливается складской архив по товарам" .
     2575     end.
     2576     run gbl/lock-prc.p
     2577       (input 'btpr':U
     2578       ,input v-obj-code
     2579       ,input 0
     2580       ,input 0
     2581       ,input v-obj-type
     2582       ,input ""
     2583       ,input ""
     2584       ,input "Объект,,, ,,,Расчет складского архива по товарам"
     2585       ,input true
     2586       ,buffer calc-arh-lock_batchprocess
     2587       ) no-error .
     2588     if error-status :error
     2589     then do:
     2590       if error-status :get-message(1) <> ""
     2591       then do:
     2592         message
     2593           vss-workfile vss-revision vss-description skip
     2594           "Складской архив по товарам" skip
     2595           "Объект" v-obj-type v-obj-code skip
     2596           "В данный момент рассчитывается складской архив по товарам" skip
     2597           "Невозможно произвести расчет складского архива по товарам" skip
     2598           view-as alert-box error .
     2599       end.
     2600       undo, return error "В данный момент рассчитывается складской архив по товарам" .
     2601     end.
     2602     define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
