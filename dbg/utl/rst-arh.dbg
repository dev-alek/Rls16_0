     5164                 and buf_stk-line.obj-code   = buf_temp-create-stk-line.obj-code
     5165                 and buf_stk-line.artic      = buf_temp-create-stk-line.artic
     5166                 and buf_stk-line.prod-type  = buf_temp-create-stk-line.prod-type
     5167                 and buf_stk-line.prod-code  = buf_temp-create-stk-line.prod-code
     5168                 and buf_stk-line.fact-order = v-shift-end-fact-order
     5169                 and buf_stk-line.sum-type   begins buf_temp-create-stk-line.sum-type
     5170             on error undo, return error return-value
     5171             :
