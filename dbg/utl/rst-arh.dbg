     4611             else do:
     4612               assign
     4613                                                                                                     buf_temp-shift-stk-line.fact-qnty      = buf_stk-line.fact-qnty            buf_temp-shift-stk-line.sum-base       = buf_stk-line.sum-base             buf_temp-shift-stk-line.sum-rubl       = buf_stk-line.sum-rubl             buf_temp-shift-stk-line.vat-base       = buf_stk-line.vat-base             buf_temp-shift-stk-line.vat-rubl       = buf_stk-line.vat-rubl             buf_temp-shift-stk-line.slt-base       = buf_stk-line.slt-base             buf_temp-shift-stk-line.slt-rubl       = buf_stk-line.slt-rubl             buf_temp-shift-stk-line.road-tax-base  = buf_stk-line.road-tax-base        buf_temp-shift-stk-line.road-tax-rubl  = buf_stk-line.road-tax-rubl        buf_temp-shift-stk-line.excise-base    = buf_stk-line.excise-base          buf_temp-shift-stk-line.excise-rubl    = buf_stk-line.excise-rubl          buf_temp-shift-stk-line.transport-base = buf_stk-line.transport-base       buf_temp-shift-stk-line.transport-rubl = buf_stk-line.transport-rubl       buf_temp-shift-stk-line.other-base     = buf_stk-line.other-base           buf_temp-shift-stk-line.other-rubl     = buf_stk-line.other-rubl
     4614               .
     4615             end.
     4616           end.
     4617         end.
     4618       end.
     4619       else do:
     4620         assign
     4621           v-create-stk = true
     4622         .
     4623         find first buf_temp-stk-line
     4624           where buf_temp-stk-line.obj-type   = p-obj-type
     4625             and buf_temp-stk-line.obj-code   = p-obj-code
     4626             and buf_temp-stk-line.artic      = p-artic
     4627             and buf_temp-stk-line.prod-type  = p-prod-type
     4628             and buf_temp-stk-line.prod-code  = p-prod-code
     4629             and buf_temp-stk-line.fact-order = p-create-line-fact-order
     4630             and buf_temp-stk-line.sum-type   = p-root-sum-type
     4631             and buf_temp-stk-line.cat-id     = '##,##':U
     4632           no-error .
     4633         if not available buf_temp-stk-line
     4634         then do:
     4635           create buf_temp-stk-line .
     4636           assign
     4637             buf_temp-stk-line.obj-type   = p-obj-type
     4638             buf_temp-stk-line.obj-code   = p-obj-code
     4639             buf_temp-stk-line.artic      = p-artic
     4640             buf_temp-stk-line.prod-type  = p-prod-type
     4641             buf_temp-stk-line.prod-code  = p-prod-code
     4642             buf_temp-stk-line.sum-type   = p-root-sum-type
     4643             buf_temp-stk-line.cat-id     = '##,##':U
     4644             buf_temp-stk-line.fact-order = p-create-line-fact-order
     4645             buf_temp-stk-line.fact-date  = p-fact-date
     4646             buf_temp-stk-line.shift-num  = 0
     4647             buf_temp-stk-line.shift-date = ?
     4648           .
     4649         end.
     4650         if p-shift-on = true
     4651         then do:
     4652           find first buf_temp-shift-stk-line
     4653             where buf_temp-shift-stk-line.obj-type   = p-obj-type
     4654               and buf_temp-shift-stk-line.obj-code   = p-obj-code
     4655               and buf_temp-shift-stk-line.artic      = p-artic
     4656               and buf_temp-shift-stk-line.prod-type  = p-prod-type
     4657               and buf_temp-shift-stk-line.prod-code  = p-prod-code
     4658               and buf_temp-shift-stk-line.fact-order = p-shift-create-line-fact-order
     4659               and buf_temp-shift-stk-line.sum-type   = p-root-sum-type
     4660               and buf_temp-shift-stk-line.cat-id     = '##,##':U
     4661             no-error .
     4662           if not available buf_temp-shift-stk-line
     4663           then do:
     4664             create buf_temp-shift-stk-line .
     4665             assign
     4666               buf_temp-shift-stk-line.obj-type   = p-obj-type
     4667               buf_temp-shift-stk-line.obj-code   = p-obj-code
     4668               buf_temp-shift-stk-line.artic      = p-artic
     4669               buf_temp-shift-stk-line.prod-type  = p-prod-type
     4670               buf_temp-shift-stk-line.prod-code  = p-prod-code
     4671               buf_temp-shift-stk-line.sum-type   = p-root-sum-type
     4672               buf_temp-shift-stk-line.cat-id     = '##,##':U
     4673               buf_temp-shift-stk-line.fact-order = p-shift-create-line-fact-order
     4674               buf_temp-shift-stk-line.fact-date  = p-fact-date
     4675               buf_temp-shift-stk-line.shift-date = p-shift-date
     4676               buf_temp-shift-stk-line.shift-num  = p-shift-num
     4677             .
     4678           end.
     4679         end.
     4680       end.
     4681       if p-save-new = false
     4682       then do:
     4683         create buf_temp-create-stk-line .
     4684         assign
     4685           buf_temp-create-stk-line.obj-type    = p-obj-type
     4686           buf_temp-create-stk-line.obj-code    = p-obj-code
     4687           buf_temp-create-stk-line.artic       = p-artic
     4688           buf_temp-create-stk-line.prod-type   = p-prod-type
     4689           buf_temp-create-stk-line.prod-code   = p-prod-code
     4690           buf_temp-create-stk-line.sum-type    = p-root-sum-type
     4691           buf_temp-create-stk-line.need-create = v-create-stk
     4692         .
     4693       end.
     4694     end.
     4695   end procedure.
     4696   procedure ahrstutl-create-stk :
     4697     define input  parameter p-obj-type  as character no-undo .
     4698     define input  parameter p-obj-code  as integer   no-undo .
     4699     define input  parameter p-fact-date as date      no-undo .
     4700     define variable v-shift-on                as logical   no-undo .
     4701     define variable v-shift-date              as date      no-undo .
     4702     define variable v-shift-num               as integer   no-undo .
     4703     define variable v-day-end-fact-order      as decimal   no-undo .
     4704     define variable v-shift-end-fact-order    as decimal   no-undo .
     4705     define buffer buf_temp-create-stk-tot  for temp-create-stk-tot .
     4706     define buffer buf_temp-create-stk-line for temp-create-stk-line .
     4707     define buffer buf_temp-stk-tot for temp-stk-tot .
     4708     define buffer buf_stk-tot for ub.stk-tot .
     4709     define buffer buf_temp-stk-line for temp-stk-line .
     4710     define buffer buf_stk-line for ub.stk-line .
     4711     do
     4712     on error undo, return error return-value
     4713     :
     4714       run factord-cut-archive in this-procedure
     4715         (input  p-obj-type
     4716         ,input  p-obj-code
     4717         ,input  p-fact-date
     4718         ,output v-shift-on
     4719         ,output v-shift-date
     4720         ,output v-shift-num
     4721         ,output v-day-end-fact-order
     4722         ,output v-shift-end-fact-order
     4723         ) .
     4724       run show-action in this-procedure
     4725         (input "Создание остатка на текущую дату"
     4726         ).
     4727       define variable v-total-count as integer   no-undo .
     4728       for each buf_temp-create-stk-tot
     4729         where buf_temp-create-stk-tot.need-create = true
     4730       on error undo, return error return-value
     4731       :
     4732         assign
     4733           v-total-count = v-total-count + 1
     4734         .
     4735         if v-total-count modulo 10 = 0
     4736         then do:
     4737           run show-count in this-procedure
     4738             (input v-total-count
     4739             ,input ""
     4740             ).
     4741         end.
     4742         for each buf_temp-stk-tot
     4743           where buf_temp-stk-tot.obj-type   = buf_temp-create-stk-tot.obj-type
     4744             and buf_temp-stk-tot.obj-code   = buf_temp-create-stk-tot.obj-code
     4745             and buf_temp-stk-tot.fact-order = v-day-end-fact-order
     4746             and buf_temp-stk-tot.sum-type   begins buf_temp-create-stk-tot.sum-type
     4747         on error undo, return error return-value
     4748         :
     4749           create buf_stk-tot .
     4750           buffer-copy buf_temp-stk-tot to buf_stk-tot
     4751           .
     4752         end.
     4753         if v-shift-on = true
     4754         then do:
     4755           for each buf_temp-stk-tot
     4756             where buf_temp-stk-tot.obj-type   = buf_temp-create-stk-tot.obj-type
     4757               and buf_temp-stk-tot.obj-code   = buf_temp-create-stk-tot.obj-code
     4758               and buf_temp-stk-tot.fact-order = v-shift-end-fact-order
     4759               and buf_temp-stk-tot.sum-type   begins buf_temp-create-stk-tot.sum-type
     4760           on error undo, return error return-value
     4761           :
     4762             create buf_stk-tot .
     4763             buffer-copy buf_temp-stk-tot to buf_stk-tot
     4764             .
     4765           end.
     4766         end.
     4767       end.
     4768       assign
     4769         v-total-count = 0
     4770       .
     4771       for each buf_temp-create-stk-line
     4772         where buf_temp-create-stk-line.need-create = true
     4773       on error undo, return error return-value
     4774       :
     4775         assign
     4776           v-total-count = v-total-count + 1
     4777         .
     4778         if v-total-count modulo 10 = 0
     4779         then do:
     4780           run show-count in this-procedure
     4781             (input v-total-count
     4782             ,input "Артикул " + buf_temp-create-stk-line.artic
     4783             ).
     4784         end.
     4785         for each buf_temp-stk-line
     4786           where buf_temp-stk-line.obj-type   = buf_temp-create-stk-line.obj-type
     4787             and buf_temp-stk-line.obj-code   = buf_temp-create-stk-line.obj-code
     4788             and buf_temp-stk-line.artic      = buf_temp-create-stk-line.artic
     4789             and buf_temp-stk-line.prod-type  = buf_temp-create-stk-line.prod-type
     4790             and buf_temp-stk-line.prod-code  = buf_temp-create-stk-line.prod-code
     4791             and buf_temp-stk-line.fact-order = v-day-end-fact-order
     4792             and buf_temp-stk-line.sum-type   begins buf_temp-create-stk-line.sum-type
     4793         on error undo, return error return-value
     4794         :
     4795           create buf_stk-line .
     4796           buffer-copy buf_temp-stk-line to buf_stk-line
     4797           .
     4798         end.
     4799         if v-shift-on = true
     4800         then do:
     4801           for each buf_temp-stk-line
     4802             where buf_temp-stk-line.obj-type   = buf_temp-create-stk-line.obj-type
     4803               and buf_temp-stk-line.obj-code   = buf_temp-create-stk-line.obj-code
     4804               and buf_temp-stk-line.artic      = buf_temp-create-stk-line.artic
     4805               and buf_temp-stk-line.prod-type  = buf_temp-create-stk-line.prod-type
     4806               and buf_temp-stk-line.prod-code  = buf_temp-create-stk-line.prod-code
     4807               and buf_temp-stk-line.fact-order = v-shift-end-fact-order
     4808               and buf_temp-stk-line.sum-type   begins buf_temp-create-stk-line.sum-type
     4809           on error undo, return error return-value
     4810           :
     4811             create buf_stk-line .
     4812             buffer-copy buf_temp-stk-line to buf_stk-line
     4813             .
     4814           end.
     4815         end.
     4816       end.
     4817     end.
     4818   end procedure.
     4819   procedure ahrstutl-clear-arh :
     4820     define input  parameter p-obj-type         as character no-undo .
     4821     define input  parameter p-obj-code         as integer   no-undo .
     4822     define input  parameter p-start-fact-order as decimal   no-undo .
     4823     define input  parameter p-fact-date        as date      no-undo .
     4824     define buffer buf_ot-tot   for ub.ot-tot .
     4825     define buffer buf_ot-line  for ub.ot-line .
     4826     define buffer buf_stk-tot  for ub.stk-tot .
     4827     define buffer buf_stk-line for ub.stk-line .
     4828     define variable v-shift-on                as logical   no-undo .
     4829     define variable v-shift-date              as date      no-undo .
     4830     define variable v-shift-num               as integer   no-undo .
     4831     define variable v-day-end-fact-order      as decimal   no-undo .
     4832     define variable v-shift-end-fact-order    as decimal   no-undo .
     4833     define variable v-ind as integer no-undo .
     4834     do
     4835     on error undo, return error return-value
     4836     :
     4837       run factord-cut-archive in this-procedure
     4838         (input  p-obj-type
     4839         ,input  p-obj-code
     4840         ,input  p-fact-date
     4841         ,output v-shift-on
     4842         ,output v-shift-date
     4843         ,output v-shift-num
     4844         ,output v-day-end-fact-order
     4845         ,output v-shift-end-fact-order
     4846         ) .
     4847       assign
     4848         v-day-end-fact-order   = v-day-end-fact-order   - 0.0000000001
     4849         v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     4850       .
     4851       run show-action in this-procedure
     4852         (input "Удаление оборота по документам"
     4853         ).
     4854       assign
     4855         v-ind = 0
     4856       .
     4857       for each buf_ot-tot
     4858         where buf_ot-tot.obj-type   = p-obj-type
     4859           and buf_ot-tot.obj-code   = p-obj-code
     4860           and buf_ot-tot.fact-order > p-start-fact-order
     4861           and buf_ot-tot.fact-order <= v-day-end-fact-order
     4862       on error undo, return error return-value
     4863       :
     4864         assign
     4865           v-ind = v-ind + 1
     4866         .
     4867         if v-ind modulo 10 = 0
     4868         then do:
     4869           run show-count in this-procedure
     4870             (input v-ind
     4871             ,input "Документ " + string(buf_ot-tot.doc-code)
     4872             ).
     4873         end.
     4874         delete buf_ot-tot .
     4875       end.
     4876       run show-action in this-procedure
     4877         (input "Удаление оборота по строкам документов"
     4878         ).
     4879       assign
     4880         v-ind = 0
     4881       .
     4882       for each buf_ot-line
     4883         where buf_ot-line.obj-type   = p-obj-type
     4884           and buf_ot-line.obj-code   = p-obj-code
     4885           and buf_ot-line.fact-order > p-start-fact-order
     4886           and buf_ot-line.fact-order <= v-day-end-fact-order
     4887       on error undo, return error return-value
     4888       :
     4889         assign
     4890           v-ind = v-ind + 1
     4891         .
     4892         if v-ind modulo 10 = 0
     4893         then do:
     4894           run show-count in this-procedure
     4895             (input v-ind
     4896             ,input "Документ " + string(buf_ot-line.doc-code)
     4897                     + " Артикул " + string(buf_ot-line.artic)
     4898             ).
     4899         end.
     4900         delete buf_ot-line .
     4901       end.
     4902       run show-action in this-procedure
     4903         (input "Удаление остатка по объекту"
     4904         ).
     4905       assign
     4906         v-ind = 0
     4907       .
     4908       for each buf_stk-tot
     4909         where buf_stk-tot.obj-type   = p-obj-type
     4910           and buf_stk-tot.obj-code   = p-obj-code
     4911           and buf_stk-tot.fact-order > p-start-fact-order
     4912           and buf_stk-tot.fact-order <= v-day-end-fact-order
     4913       on error undo, return error return-value
     4914       :
     4915         assign
     4916           v-ind = v-ind + 1
     4917         .
     4918         if v-ind modulo 10 = 0
     4919         then do:
     4920           run show-count in this-procedure
     4921             (input v-ind
     4922             ,input "Дата " + string(buf_stk-tot.fact-date, '99/99/9999':U )
     4923             ).
     4924         end.
     4925         if buf_stk-tot.shift-date = ?
     4926         or (buf_stk-tot.shift-date <> ?
     4927             and
     4928             buf_stk-tot.fact-order <= v-shift-end-fact-order
     4929            )
     4930         then do:
     4931           delete buf_stk-tot .
     4932         end.
     4933       end.
     4934       run show-action in this-procedure
     4935         (input "Удаление остатка по товарам на объекте"
     4936         ).
     4937       assign
     4938         v-ind = 0
     4939       .
     4940       for each buf_stk-line
     4941         where buf_stk-line.obj-type   = p-obj-type
     4942           and buf_stk-line.obj-code   = p-obj-code
     4943           and buf_stk-line.fact-order > p-start-fact-order
     4944           and buf_stk-line.fact-order <= v-day-end-fact-order
     4945       on error undo, return error return-value
     4946       :
     4947         assign
     4948           v-ind = v-ind + 1
     4949         .
     4950         if v-ind modulo 10 = 0
     4951         then do:
     4952           run show-count in this-procedure
     4953             (input v-ind
     4954             ,input "Артикул " + string(buf_stk-line.artic)
     4955             ).
     4956         end.
     4957         if buf_stk-line.shift-date = ?
     4958         or (buf_stk-line.shift-date <> ?
     4959             and
     4960             buf_stk-line.fact-order <= v-shift-end-fact-order
     4961            )
     4962         then do:
     4963           delete buf_stk-line .
     4964         end.
     4965       end.
     4966     end.
     4967   end procedure.
     4968   procedure ahrstutl-delete-copy :
     4969     define input  parameter p-obj-type  as character no-undo .
     4970     define input  parameter p-obj-code  as integer   no-undo .
     4971     define input  parameter p-fact-date as date      no-undo .
     4972     define buffer buf_stk-tot  for ub.stk-tot .
     4973     define buffer buf_stk-line for ub.stk-line .
     4974     define buffer buf_temp-create-stk-tot for temp-create-stk-tot .
     4975     define buffer buf_temp-create-stk-line for temp-create-stk-line .
     4976     define variable v-shift-on                as logical   no-undo .
     4977     define variable v-shift-date              as date      no-undo .
     4978     define variable v-shift-num               as integer   no-undo .
     4979     define variable v-day-end-fact-order      as decimal   no-undo .
     4980     define variable v-shift-end-fact-order    as decimal   no-undo .
     4981     define variable v-ind as integer no-undo .
     4982     do
     4983     on error undo, return error return-value
     4984     :
     4985       run factord-cut-archive in this-procedure
     4986         (input  p-obj-type
     4987         ,input  p-obj-code
     4988         ,input  p-fact-date
     4989         ,output v-shift-on
     4990         ,output v-shift-date
     4991         ,output v-shift-num
     4992         ,output v-day-end-fact-order
     4993         ,output v-shift-end-fact-order
     4994         ) .
     4995       run show-action in this-procedure
     4996         (input "Удаление повторных остатков"
     4997         ).
     4998       define variable v-total-count as integer   no-undo .
     4999       assign
     5000         v-total-count = 0
     5001       .
     5002       for each buf_temp-create-stk-tot
     5003       on error undo, return error return-value
     5004       :
     5005         assign
     5006           v-total-count = v-total-count + 1
     5007         .
     5008         if v-ind modulo 10 = 0
     5009         then do:
     5010           run show-count in this-procedure
     5011             (input v-total-count
     5012             ,input "Остатки по объекту"
     5013             ).
     5014         end.
     5015         find last buf_stk-tot no-lock
     5016           where buf_stk-tot.obj-type   = buf_temp-create-stk-tot.obj-type
     5017             and buf_stk-tot.obj-code   = buf_temp-create-stk-tot.obj-code
     5018             and buf_stk-tot.fact-order = v-day-end-fact-order - 0.0000000001
     5019             and buf_stk-tot.sum-type   = buf_temp-create-stk-tot.sum-type
     5020             and buf_stk-tot.cat-id     = '##,##':U
     5021           no-error .
     5022         if available buf_stk-tot
     5023         then do:
     5024           for each buf_stk-tot exclusive-lock
     5025             where buf_stk-tot.obj-type   = buf_temp-create-stk-tot.obj-type
     5026               and buf_stk-tot.obj-code   = buf_temp-create-stk-tot.obj-code
     5027               and buf_stk-tot.fact-order = v-day-end-fact-order - 0.0000000001
     5028               and buf_stk-tot.sum-type   begins buf_temp-create-stk-tot.sum-type
     5029           on error undo, return error return-value
     5030           :
     5031             delete buf_stk-tot .
     5032           end.
     5033         end.
     5034         else do:
     5035           for each buf_stk-tot exclusive-lock
     5036             where buf_stk-tot.obj-type   = buf_temp-create-stk-tot.obj-type
     5037               and buf_stk-tot.obj-code   = buf_temp-create-stk-tot.obj-code
     5038               and buf_stk-tot.fact-order = v-day-end-fact-order
     5039               and buf_stk-tot.sum-type   begins buf_temp-create-stk-tot.sum-type
     5040           on error undo, return error return-value
     5041           :
     5042             delete buf_stk-tot .
     5043           end.
     5044         end.
     5045         if v-shift-on = true
     5046         then do:
     5047           find last buf_stk-tot no-lock
     5048             where buf_stk-tot.obj-type   = buf_temp-create-stk-tot.obj-type
     5049               and buf_stk-tot.obj-code   = buf_temp-create-stk-tot.obj-code
     5050               and buf_stk-tot.fact-order = v-shift-end-fact-order - 0.0000000001
     5051               and buf_stk-tot.sum-type   = buf_temp-create-stk-tot.sum-type
     5052               and buf_stk-tot.cat-id     = '##,##':U
     5053             no-error .
     5054           if available buf_stk-tot
     5055           then do:
     5056             for each buf_stk-tot exclusive-lock
     5057               where buf_stk-tot.obj-type   = buf_temp-create-stk-tot.obj-type
     5058                 and buf_stk-tot.obj-code   = buf_temp-create-stk-tot.obj-code
     5059                 and buf_stk-tot.fact-order = v-shift-end-fact-order - 0.0000000001
     5060                 and buf_stk-tot.sum-type   begins buf_temp-create-stk-tot.sum-type
     5061             on error undo, return error return-value
     5062             :
     5063               delete buf_stk-tot .
     5064             end.
     5065           end.
     5066           else do:
     5067             for each buf_stk-tot exclusive-lock
     5068               where buf_stk-tot.obj-type   = buf_temp-create-stk-tot.obj-type
     5069                 and buf_stk-tot.obj-code   = buf_temp-create-stk-tot.obj-code
     5070                 and buf_stk-tot.fact-order = v-shift-end-fact-order
     5071                 and buf_stk-tot.sum-type   begins buf_temp-create-stk-tot.sum-type
     5072             on error undo, return error return-value
     5073             :
     5074               delete buf_stk-tot .
     5075             end.
     5076           end.
     5077         end.
     5078       end.
     5079       assign
     5080         v-total-count = 0
     5081       .
     5082       for each buf_temp-create-stk-line
     5083       on error undo, return error return-value
     5084       :
     5085         assign
     5086           v-total-count = v-total-count + 1
     5087         .
     5088         if v-ind modulo 10 = 0
     5089         then do:
     5090           run show-count in this-procedure
     5091             (input v-total-count
     5092             ,input "Артикул " + buf_temp-create-stk-line.artic
     5093             ).
     5094         end.
     5095         find first buf_stk-line no-lock
     5096           where buf_stk-line.obj-type   = buf_temp-create-stk-line.obj-type
     5097             and buf_stk-line.obj-code   = buf_temp-create-stk-line.obj-code
     5098             and buf_stk-line.artic      = buf_temp-create-stk-line.artic
     5099             and buf_stk-line.prod-type  = buf_temp-create-stk-line.prod-type
     5100             and buf_stk-line.prod-code  = buf_temp-create-stk-line.prod-code
     5101             and buf_stk-line.fact-order = v-day-end-fact-order - 0.0000000001
     5102             and buf_stk-line.sum-type   = buf_temp-create-stk-line.sum-type
     5103             and buf_stk-line.cat-id     = '##,##':U
     5104           no-error .
     5105         if available buf_stk-line
     5106         then do:
     5107           for each buf_stk-line exclusive-lock
     5108             where buf_stk-line.obj-type   = buf_temp-create-stk-line.obj-type
     5109               and buf_stk-line.obj-code   = buf_temp-create-stk-line.obj-code
     5110               and buf_stk-line.artic      = buf_temp-create-stk-line.artic
     5111               and buf_stk-line.prod-type  = buf_temp-create-stk-line.prod-type
     5112               and buf_stk-line.prod-code  = buf_temp-create-stk-line.prod-code
     5113               and buf_stk-line.fact-order = v-day-end-fact-order - 0.0000000001
     5114               and buf_stk-line.sum-type   begins buf_temp-create-stk-line.sum-type
     5115           on error undo, return error return-value
     5116           :
     5117             delete buf_stk-line .
     5118           end.
     5119         end.
     5120         else do:
     5121           for each buf_stk-line exclusive-lock
     5122             where buf_stk-line.obj-type   = buf_temp-create-stk-line.obj-type
     5123               and buf_stk-line.obj-code   = buf_temp-create-stk-line.obj-code
     5124               and buf_stk-line.artic      = buf_temp-create-stk-line.artic
     5125               and buf_stk-line.prod-type  = buf_temp-create-stk-line.prod-type
     5126               and buf_stk-line.prod-code  = buf_temp-create-stk-line.prod-code
     5127               and buf_stk-line.fact-order = v-day-end-fact-order
     5128               and buf_stk-line.sum-type   begins buf_temp-create-stk-line.sum-type
     5129           on error undo, return error return-value
     5130           :
     5131             delete buf_stk-line .
     5132           end.
     5133         end.
     5134         if v-shift-on = true
     5135         then do:
     5136           find first buf_stk-line no-lock
     5137             where buf_stk-line.obj-type   = buf_temp-create-stk-line.obj-type
     5138               and buf_stk-line.obj-code   = buf_temp-create-stk-line.obj-code
     5139               and buf_stk-line.artic      = buf_temp-create-stk-line.artic
     5140               and buf_stk-line.prod-type  = buf_temp-create-stk-line.prod-type
     5141               and buf_stk-line.prod-code  = buf_temp-create-stk-line.prod-code
     5142               and buf_stk-line.fact-order = v-shift-end-fact-order - 0.0000000001
     5143               and buf_stk-line.sum-type   = buf_temp-create-stk-line.sum-type
     5144               and buf_stk-line.cat-id     = '##,##':U
     5145             no-error .
     5146           if available buf_stk-line
     5147           then do:
     5148             for each buf_stk-line exclusive-lock
     5149               where buf_stk-line.obj-type   = buf_temp-create-stk-line.obj-type
     5150                 and buf_stk-line.obj-code   = buf_temp-create-stk-line.obj-code
     5151                 and buf_stk-line.artic      = buf_temp-create-stk-line.artic
     5152                 and buf_stk-line.prod-type  = buf_temp-create-stk-line.prod-type
     5153                 and buf_stk-line.prod-code  = buf_temp-create-stk-line.prod-code
     5154                 and buf_stk-line.fact-order = v-shift-end-fact-order - 0.0000000001
     5155                 and buf_stk-line.sum-type   begins buf_temp-create-stk-line.sum-type
     5156             on error undo, return error return-value
     5157             :
