     5450           .
     5451         end.
     5452         do v-ind = 1 to v-num-entries-TDEDT_List
     5453         :
     5454           assign
     5455             p-sum-type-list = p-sum-type-list
     5456                             + chr(44)
     5457                             + 'cgdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5458           .
     5459         end.
     5460         do v-ind = 1 to v-num-entries-TDEDT_List
     5461         :
     5462           assign
     5463             p-sum-type-list = p-sum-type-list
     5464                             + chr(44)
     5465                             + 'csdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5466           .
     5467         end.
     5468       end.
     5469       else do:
     5470         assign
     5471           p-sum-type-list = 'cgsr':U
     5472                           + chr(44)
     5473                           + 'cssr':U
     5474         .
     5475         do v-ind = 1 to v-num-entries-TDEDT_List
     5476         :
     5477           assign
     5478             p-sum-type-list = p-sum-type-list
     5479                             + chr(44)
     5480                             + 'adsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5481           .
     5482         end.
     5483         do v-ind = 1 to v-num-entries-TDEDT_List
     5484         :
     5485           assign
     5486             p-sum-type-list = p-sum-type-list
     5487                             + chr(44)
     5488                             + 'gdsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5489           .
     5490         end.
     5491         do v-ind = 1 to v-num-entries-TDEDT_List
     5492         :
     5493           assign
     5494             p-sum-type-list = p-sum-type-list
     5495                             + chr(44)
     5496                             + 'sdsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5497           .
     5498         end.
     5499       end.
     5500     end.
     5501   end procedure.
     5502   procedure ahrstutl-store-tot :
     5503     define input  parameter p-obj-type                   as character no-undo .
     5504     define input  parameter p-obj-code                   as integer   no-undo .
     5505     define input  parameter p-sum-type                   as character no-undo .
     5506     define input  parameter p-shift-on                   as logical   no-undo .
     5507     define input  parameter p-first-cut-date             as date      no-undo .
     5508     define input  parameter p-last-cut-date              as date      no-undo .
     5509     define input  parameter p-first-day-end-fact-order   as decimal   no-undo .
     5510     define input  parameter p-first-shift-end-fact-order as decimal   no-undo .
     5511     define input  parameter p-first-shift-date           as date      no-undo .
     5512     define input  parameter p-first-shift-num            as integer   no-undo .
     5513     define input  parameter p-last-day-end-fact-order    as decimal   no-undo .
     5514     define input  parameter p-last-shift-end-fact-order  as decimal   no-undo .
     5515     define input  parameter p-last-shift-date            as date      no-undo .
     5516     define input  parameter p-last-shift-num             as integer   no-undo .
     5517     define buffer buf_stk-tot for ub.stk-tot .
     5518     define buffer buf_temp-stk-tot for temp-stk-tot .
     5519     define buffer buf_temp-shift-stk-tot for temp-shift-stk-tot .
     5520     define buffer sub_temp-stk-tot for temp-stk-tot .
     5521     define buffer sub_stk-tot for ub.stk-tot .
     5522     define buffer sub_temp-shift-stk-tot for temp-stk-tot .
     5523     do
     5524     on error undo, return error return-value
     5525     :
     5526       for each buf_temp-stk-tot
     5527         where buf_temp-stk-tot.obj-type = p-obj-type
     5528           and buf_temp-stk-tot.obj-code = p-obj-code
     5529           and buf_temp-stk-tot.sum-type = p-sum-type
     5530       on error undo, return error return-value
     5531       :
     5532         if
     5533                                             buf_temp-stk-tot.fact-qnty      <> buf_temp-stk-tot.new-fact-qnty        or    buf_temp-stk-tot.sum-base       <> buf_temp-stk-tot.new-sum-base         or    buf_temp-stk-tot.sum-rubl       <> buf_temp-stk-tot.new-sum-rubl         or    buf_temp-stk-tot.vat-base       <> buf_temp-stk-tot.new-vat-base         or    buf_temp-stk-tot.vat-rubl       <> buf_temp-stk-tot.new-vat-rubl         or    buf_temp-stk-tot.slt-base       <> buf_temp-stk-tot.new-slt-base         or    buf_temp-stk-tot.slt-rubl       <> buf_temp-stk-tot.new-slt-rubl         or    buf_temp-stk-tot.road-tax-base  <> buf_temp-stk-tot.new-road-tax-base    or    buf_temp-stk-tot.road-tax-rubl  <> buf_temp-stk-tot.new-road-tax-rubl    or    buf_temp-stk-tot.excise-base    <> buf_temp-stk-tot.new-excise-base      or    buf_temp-stk-tot.excise-rubl    <> buf_temp-stk-tot.new-excise-rubl      or    buf_temp-stk-tot.transport-base <> buf_temp-stk-tot.new-transport-base   or    buf_temp-stk-tot.transport-rubl <> buf_temp-stk-tot.new-transport-rubl   or    buf_temp-stk-tot.other-base     <> buf_temp-stk-tot.new-other-base       or    buf_temp-stk-tot.other-rubl     <> buf_temp-stk-tot.new-other-rubl
     5534         then do:
     5535           find first buf_stk-tot exclusive-lock
     5536             where buf_stk-tot.obj-type   = buf_temp-stk-tot.obj-type
     5537               and buf_stk-tot.obj-code   = buf_temp-stk-tot.obj-code
     5538               and buf_stk-tot.sum-type   = buf_temp-stk-tot.sum-type
     5539               and buf_stk-tot.cat-id     = buf_temp-stk-tot.cat-id
     5540               and buf_stk-tot.fact-order <= p-first-day-end-fact-order
     5541               and buf_stk-tot.shift-date = ?
     5542             no-error .
     5543           if not available buf_stk-tot
     5544           then do:
     5545             create buf_stk-tot .
     5546             assign
     5547               buf_stk-tot.obj-type   = buf_temp-stk-tot.obj-type
     5548               buf_stk-tot.obj-code   = buf_temp-stk-tot.obj-code
     5549               buf_stk-tot.fact-order = p-first-day-end-fact-order
     5550               buf_stk-tot.sum-type   = buf_temp-stk-tot.sum-type
     5551               buf_stk-tot.cat-id     = buf_temp-stk-tot.cat-id
     5552               buf_stk-tot.fact-date  = p-first-cut-date
     5553               buf_stk-tot.shift-num  = 0
     5554               buf_stk-tot.shift-date = ?
     5555             .
     5556           end.
     5557           for each buf_stk-tot exclusive-lock
     5558             where buf_stk-tot.obj-type   = buf_temp-stk-tot.obj-type
     5559               and buf_stk-tot.obj-code   = buf_temp-stk-tot.obj-code
     5560               and buf_stk-tot.sum-type   = buf_temp-stk-tot.sum-type
     5561               and buf_stk-tot.cat-id     = buf_temp-stk-tot.cat-id
     5562               and buf_stk-tot.fact-order <= p-last-day-end-fact-order - 0.0000000001
     5563               and buf_stk-tot.shift-date = ?
     5564           on error undo, return error return-value
     5565           :
     5566             for each sub_temp-stk-tot
     5567               where sub_temp-stk-tot.obj-type   = buf_temp-stk-tot.obj-type
     5568                 and sub_temp-stk-tot.obj-code   = buf_temp-stk-tot.obj-code
     5569                 and sub_temp-stk-tot.fact-order = buf_temp-stk-tot.fact-order
     5570                 and sub_temp-stk-tot.sum-type   begins buf_temp-stk-tot.sum-type
     5571             on error undo, return error return-value
     5572             :
     5573               if
     5574                                                                                       sub_temp-stk-tot.fact-qnty      <> sub_temp-stk-tot.new-fact-qnty        or    sub_temp-stk-tot.sum-base       <> sub_temp-stk-tot.new-sum-base         or    sub_temp-stk-tot.sum-rubl       <> sub_temp-stk-tot.new-sum-rubl         or    sub_temp-stk-tot.vat-base       <> sub_temp-stk-tot.new-vat-base         or    sub_temp-stk-tot.vat-rubl       <> sub_temp-stk-tot.new-vat-rubl         or    sub_temp-stk-tot.slt-base       <> sub_temp-stk-tot.new-slt-base         or    sub_temp-stk-tot.slt-rubl       <> sub_temp-stk-tot.new-slt-rubl         or    sub_temp-stk-tot.road-tax-base  <> sub_temp-stk-tot.new-road-tax-base    or    sub_temp-stk-tot.road-tax-rubl  <> sub_temp-stk-tot.new-road-tax-rubl    or    sub_temp-stk-tot.excise-base    <> sub_temp-stk-tot.new-excise-base      or    sub_temp-stk-tot.excise-rubl    <> sub_temp-stk-tot.new-excise-rubl      or    sub_temp-stk-tot.transport-base <> sub_temp-stk-tot.new-transport-base   or    sub_temp-stk-tot.transport-rubl <> sub_temp-stk-tot.new-transport-rubl   or    sub_temp-stk-tot.other-base     <> sub_temp-stk-tot.new-other-base       or    sub_temp-stk-tot.other-rubl     <> sub_temp-stk-tot.new-other-rubl
     5575               then do:
     5576                 find first sub_stk-tot exclusive-lock
     5577                   where sub_stk-tot.obj-type   = buf_stk-tot.obj-type
     5578                     and sub_stk-tot.obj-code   = buf_stk-tot.obj-code
     5579                     and sub_stk-tot.fact-order = buf_stk-tot.fact-order
     5580                     and sub_stk-tot.sum-type   = sub_temp-stk-tot.sum-type
     5581                     and sub_stk-tot.cat-id     = sub_temp-stk-tot.cat-id
     5582                   no-error .
     5583                 if not available sub_stk-tot
     5584                 then do:
     5585                   create sub_stk-tot .
     5586                   assign
     5587                     sub_stk-tot.obj-type   = buf_stk-tot.obj-type
     5588                     sub_stk-tot.obj-code   = buf_stk-tot.obj-code
     5589                     sub_stk-tot.fact-order = buf_stk-tot.fact-order
     5590                     sub_stk-tot.sum-type   = sub_temp-stk-tot.sum-type
     5591                     sub_stk-tot.cat-id     = sub_temp-stk-tot.cat-id
     5592                     sub_stk-tot.fact-date  = buf_stk-tot.fact-date
     5593                     sub_stk-tot.shift-num  = buf_stk-tot.shift-num
     5594                     sub_stk-tot.shift-date = buf_stk-tot.shift-date
     5595                   .
     5596                 end.
     5597                 assign
     5598                                                                                                                                                                                   sub_stk-tot.fact-qnty      = sub_stk-tot.fact-qnty      + sub_temp-stk-tot.fact-qnty      - sub_temp-stk-tot.new-fact-qnty           sub_stk-tot.sum-base       = sub_stk-tot.sum-base       + sub_temp-stk-tot.sum-base       - sub_temp-stk-tot.new-sum-base            sub_stk-tot.sum-rubl       = sub_stk-tot.sum-rubl       + sub_temp-stk-tot.sum-rubl       - sub_temp-stk-tot.new-sum-rubl            sub_stk-tot.vat-base       = sub_stk-tot.vat-base       + sub_temp-stk-tot.vat-base       - sub_temp-stk-tot.new-vat-base            sub_stk-tot.vat-rubl       = sub_stk-tot.vat-rubl       + sub_temp-stk-tot.vat-rubl       - sub_temp-stk-tot.new-vat-rubl            sub_stk-tot.slt-base       = sub_stk-tot.slt-base       + sub_temp-stk-tot.slt-base       - sub_temp-stk-tot.new-slt-base            sub_stk-tot.slt-rubl       = sub_stk-tot.slt-rubl       + sub_temp-stk-tot.slt-rubl       - sub_temp-stk-tot.new-slt-rubl            sub_stk-tot.road-tax-base  = sub_stk-tot.road-tax-base  + sub_temp-stk-tot.road-tax-base  - sub_temp-stk-tot.new-road-tax-base       sub_stk-tot.road-tax-rubl  = sub_stk-tot.road-tax-rubl  + sub_temp-stk-tot.road-tax-rubl  - sub_temp-stk-tot.new-road-tax-rubl       sub_stk-tot.excise-base    = sub_stk-tot.excise-base    + sub_temp-stk-tot.excise-base    - sub_temp-stk-tot.new-excise-base         sub_stk-tot.excise-rubl    = sub_stk-tot.excise-rubl    + sub_temp-stk-tot.excise-rubl    - sub_temp-stk-tot.new-excise-rubl         sub_stk-tot.transport-base = sub_stk-tot.transport-base + sub_temp-stk-tot.transport-base - sub_temp-stk-tot.new-transport-base      sub_stk-tot.transport-rubl = sub_stk-tot.transport-rubl + sub_temp-stk-tot.transport-rubl - sub_temp-stk-tot.new-transport-rubl      sub_stk-tot.other-base     = sub_stk-tot.other-base     + sub_temp-stk-tot.other-base     - sub_temp-stk-tot.new-other-base          sub_stk-tot.other-rubl     = sub_stk-tot.other-rubl     + sub_temp-stk-tot.other-rubl     - sub_temp-stk-tot.new-other-rubl
     5599                 .
     5600               end.
     5601             end.
     5602           end.
     5603         end.
     5604       end.
     5605       if p-shift-on = true
     5606       then do:
     5607         for each buf_temp-shift-stk-tot
     5608           where buf_temp-shift-stk-tot.obj-type = p-obj-type
     5609             and buf_temp-shift-stk-tot.obj-code = p-obj-code
     5610             and buf_temp-shift-stk-tot.sum-type = p-sum-type
     5611         on error undo, return error return-value
     5612         :
     5613           if
     5614                                                           buf_temp-shift-stk-tot.fact-qnty      <> buf_temp-shift-stk-tot.new-fact-qnty        or    buf_temp-shift-stk-tot.sum-base       <> buf_temp-shift-stk-tot.new-sum-base         or    buf_temp-shift-stk-tot.sum-rubl       <> buf_temp-shift-stk-tot.new-sum-rubl         or    buf_temp-shift-stk-tot.vat-base       <> buf_temp-shift-stk-tot.new-vat-base         or    buf_temp-shift-stk-tot.vat-rubl       <> buf_temp-shift-stk-tot.new-vat-rubl         or    buf_temp-shift-stk-tot.slt-base       <> buf_temp-shift-stk-tot.new-slt-base         or    buf_temp-shift-stk-tot.slt-rubl       <> buf_temp-shift-stk-tot.new-slt-rubl         or    buf_temp-shift-stk-tot.road-tax-base  <> buf_temp-shift-stk-tot.new-road-tax-base    or    buf_temp-shift-stk-tot.road-tax-rubl  <> buf_temp-shift-stk-tot.new-road-tax-rubl    or    buf_temp-shift-stk-tot.excise-base    <> buf_temp-shift-stk-tot.new-excise-base      or    buf_temp-shift-stk-tot.excise-rubl    <> buf_temp-shift-stk-tot.new-excise-rubl      or    buf_temp-shift-stk-tot.transport-base <> buf_temp-shift-stk-tot.new-transport-base   or    buf_temp-shift-stk-tot.transport-rubl <> buf_temp-shift-stk-tot.new-transport-rubl   or    buf_temp-shift-stk-tot.other-base     <> buf_temp-shift-stk-tot.new-other-base       or    buf_temp-shift-stk-tot.other-rubl     <> buf_temp-shift-stk-tot.new-other-rubl
     5615           then do:
     5616             find first buf_stk-tot exclusive-lock
     5617               where buf_stk-tot.obj-type   = buf_temp-shift-stk-tot.obj-type
     5618                 and buf_stk-tot.obj-code   = buf_temp-shift-stk-tot.obj-code
     5619                 and buf_stk-tot.sum-type   = buf_temp-shift-stk-tot.sum-type
     5620                 and buf_stk-tot.cat-id     = buf_temp-shift-stk-tot.cat-id
     5621                 and buf_stk-tot.fact-order <= p-first-shift-end-fact-order
     5622                 and buf_stk-tot.shift-date <> ?
     5623               no-error .
     5624             if not available buf_stk-tot
     5625             then do:
     5626               create buf_stk-tot .
     5627               assign
     5628                 buf_stk-tot.obj-type   = buf_temp-shift-stk-tot.obj-type
     5629                 buf_stk-tot.obj-code   = buf_temp-shift-stk-tot.obj-code
     5630                 buf_stk-tot.fact-order = p-first-shift-end-fact-order
     5631                 buf_stk-tot.sum-type   = buf_temp-shift-stk-tot.sum-type
     5632                 buf_stk-tot.cat-id     = buf_temp-shift-stk-tot.cat-id
     5633                 buf_stk-tot.fact-date  = p-first-cut-date
     5634                 buf_stk-tot.shift-num  = p-first-shift-num
     5635                 buf_stk-tot.shift-date = p-first-shift-date
     5636               .
     5637             end.
     5638             for each buf_stk-tot exclusive-lock
     5639               where buf_stk-tot.obj-type   = buf_temp-shift-stk-tot.obj-type
     5640                 and buf_stk-tot.obj-code   = buf_temp-shift-stk-tot.obj-code
     5641                 and buf_stk-tot.sum-type   = buf_temp-shift-stk-tot.sum-type
     5642                 and buf_stk-tot.cat-id     = buf_temp-shift-stk-tot.cat-id
     5643                 and buf_stk-tot.fact-order <= p-last-shift-end-fact-order - 0.0000000001
     5644                 and buf_stk-tot.shift-date <> ?
     5645             on error undo, return error return-value
     5646             :
     5647               for each sub_temp-shift-stk-tot
     5648                 where sub_temp-shift-stk-tot.obj-type   = buf_temp-shift-stk-tot.obj-type
     5649                   and sub_temp-shift-stk-tot.obj-code   = buf_temp-shift-stk-tot.obj-code
     5650                   and sub_temp-shift-stk-tot.fact-order = buf_temp-shift-stk-tot.fact-order
     5651                   and sub_temp-shift-stk-tot.sum-type   begins buf_temp-shift-stk-tot.sum-type
     5652               on error undo, return error return-value
     5653               :
     5654                 if
     5655                                                                                                     sub_temp-shift-stk-tot.fact-qnty      <> sub_temp-shift-stk-tot.new-fact-qnty        or    sub_temp-shift-stk-tot.sum-base       <> sub_temp-shift-stk-tot.new-sum-base         or    sub_temp-shift-stk-tot.sum-rubl       <> sub_temp-shift-stk-tot.new-sum-rubl         or    sub_temp-shift-stk-tot.vat-base       <> sub_temp-shift-stk-tot.new-vat-base         or    sub_temp-shift-stk-tot.vat-rubl       <> sub_temp-shift-stk-tot.new-vat-rubl         or    sub_temp-shift-stk-tot.slt-base       <> sub_temp-shift-stk-tot.new-slt-base         or    sub_temp-shift-stk-tot.slt-rubl       <> sub_temp-shift-stk-tot.new-slt-rubl         or    sub_temp-shift-stk-tot.road-tax-base  <> sub_temp-shift-stk-tot.new-road-tax-base    or    sub_temp-shift-stk-tot.road-tax-rubl  <> sub_temp-shift-stk-tot.new-road-tax-rubl    or    sub_temp-shift-stk-tot.excise-base    <> sub_temp-shift-stk-tot.new-excise-base      or    sub_temp-shift-stk-tot.excise-rubl    <> sub_temp-shift-stk-tot.new-excise-rubl      or    sub_temp-shift-stk-tot.transport-base <> sub_temp-shift-stk-tot.new-transport-base   or    sub_temp-shift-stk-tot.transport-rubl <> sub_temp-shift-stk-tot.new-transport-rubl   or    sub_temp-shift-stk-tot.other-base     <> sub_temp-shift-stk-tot.new-other-base       or    sub_temp-shift-stk-tot.other-rubl     <> sub_temp-shift-stk-tot.new-other-rubl
     5656                 then do:
     5657                   find first sub_stk-tot exclusive-lock
     5658                     where sub_stk-tot.obj-type   = buf_stk-tot.obj-type
     5659                       and sub_stk-tot.obj-code   = buf_stk-tot.obj-code
     5660                       and sub_stk-tot.fact-order = buf_stk-tot.fact-order
     5661                       and sub_stk-tot.sum-type   = sub_temp-shift-stk-tot.sum-type
     5662                       and sub_stk-tot.cat-id     = sub_temp-shift-stk-tot.cat-id
     5663                     no-error .
     5664                   if not available sub_stk-tot
     5665                   then do:
     5666                     create sub_stk-tot .
     5667                     assign
     5668                       sub_stk-tot.obj-type   = buf_stk-tot.obj-type
     5669                       sub_stk-tot.obj-code   = buf_stk-tot.obj-code
     5670                       sub_stk-tot.fact-order = buf_stk-tot.fact-order
     5671                       sub_stk-tot.sum-type   = sub_temp-shift-stk-tot.sum-type
     5672                       sub_stk-tot.cat-id     = sub_temp-shift-stk-tot.cat-id
     5673                       sub_stk-tot.fact-date  = buf_stk-tot.fact-date
     5674                       sub_stk-tot.shift-num  = buf_stk-tot.shift-num
     5675                       sub_stk-tot.shift-date = buf_stk-tot.shift-date
     5676                     .
     5677                   end.
     5678                   assign
     5679                                                                                                                                                                                                         sub_stk-tot.fact-qnty      = sub_stk-tot.fact-qnty      + sub_temp-shift-stk-tot.fact-qnty      - sub_temp-shift-stk-tot.new-fact-qnty           sub_stk-tot.sum-base       = sub_stk-tot.sum-base       + sub_temp-shift-stk-tot.sum-base       - sub_temp-shift-stk-tot.new-sum-base            sub_stk-tot.sum-rubl       = sub_stk-tot.sum-rubl       + sub_temp-shift-stk-tot.sum-rubl       - sub_temp-shift-stk-tot.new-sum-rubl            sub_stk-tot.vat-base       = sub_stk-tot.vat-base       + sub_temp-shift-stk-tot.vat-base       - sub_temp-shift-stk-tot.new-vat-base            sub_stk-tot.vat-rubl       = sub_stk-tot.vat-rubl       + sub_temp-shift-stk-tot.vat-rubl       - sub_temp-shift-stk-tot.new-vat-rubl            sub_stk-tot.slt-base       = sub_stk-tot.slt-base       + sub_temp-shift-stk-tot.slt-base       - sub_temp-shift-stk-tot.new-slt-base            sub_stk-tot.slt-rubl       = sub_stk-tot.slt-rubl       + sub_temp-shift-stk-tot.slt-rubl       - sub_temp-shift-stk-tot.new-slt-rubl            sub_stk-tot.road-tax-base  = sub_stk-tot.road-tax-base  + sub_temp-shift-stk-tot.road-tax-base  - sub_temp-shift-stk-tot.new-road-tax-base       sub_stk-tot.road-tax-rubl  = sub_stk-tot.road-tax-rubl  + sub_temp-shift-stk-tot.road-tax-rubl  - sub_temp-shift-stk-tot.new-road-tax-rubl       sub_stk-tot.excise-base    = sub_stk-tot.excise-base    + sub_temp-shift-stk-tot.excise-base    - sub_temp-shift-stk-tot.new-excise-base         sub_stk-tot.excise-rubl    = sub_stk-tot.excise-rubl    + sub_temp-shift-stk-tot.excise-rubl    - sub_temp-shift-stk-tot.new-excise-rubl         sub_stk-tot.transport-base = sub_stk-tot.transport-base + sub_temp-shift-stk-tot.transport-base - sub_temp-shift-stk-tot.new-transport-base      sub_stk-tot.transport-rubl = sub_stk-tot.transport-rubl + sub_temp-shift-stk-tot.transport-rubl - sub_temp-shift-stk-tot.new-transport-rubl      sub_stk-tot.other-base     = sub_stk-tot.other-base     + sub_temp-shift-stk-tot.other-base     - sub_temp-shift-stk-tot.new-other-base          sub_stk-tot.other-rubl     = sub_stk-tot.other-rubl     + sub_temp-shift-stk-tot.other-rubl     - sub_temp-shift-stk-tot.new-other-rubl
     5680                   .
     5681                 end.
     5682               end.
     5683             end.
     5684           end.
     5685         end.
     5686       end.
     5687     end.
     5688   end procedure.
     5689   procedure ahrstutl-store-line :
     5690     define input  parameter p-obj-type                   as character no-undo .
     5691     define input  parameter p-obj-code                   as integer   no-undo .
     5692     define input  parameter p-artic                      as character no-undo .
     5693     define input  parameter p-prod-type                  as character no-undo .
     5694     define input  parameter p-prod-code                  as integer   no-undo .
     5695     define input  parameter p-sum-type                   as character no-undo .
     5696     define input  parameter p-shift-on                   as logical   no-undo .
     5697     define input  parameter p-first-cut-date             as date      no-undo .
     5698     define input  parameter p-last-cut-date              as date      no-undo .
     5699     define input  parameter p-first-day-end-fact-order   as decimal   no-undo .
     5700     define input  parameter p-first-shift-end-fact-order as decimal   no-undo .
     5701     define input  parameter p-first-shift-date           as date      no-undo .
     5702     define input  parameter p-first-shift-num            as integer   no-undo .
     5703     define input  parameter p-last-day-end-fact-order    as decimal   no-undo .
     5704     define input  parameter p-last-shift-end-fact-order  as decimal   no-undo .
     5705     define input  parameter p-last-shift-date            as date      no-undo .
     5706     define input  parameter p-last-shift-num             as integer   no-undo .
     5707     define buffer buf_stk-line for ub.stk-line .
     5708     define buffer buf_temp-stk-line for temp-stk-line .
     5709     define buffer buf_temp-shift-stk-line for temp-shift-stk-line .
     5710     define buffer sub_temp-stk-line for temp-stk-line .
     5711     define buffer sub_stk-line for ub.stk-line .
     5712     define buffer sub_temp-shift-stk-line for temp-shift-stk-line .
     5713     do
     5714     on error undo, return error return-value
     5715     :
     5716       for each buf_temp-stk-line
     5717         where buf_temp-stk-line.obj-type  = p-obj-type
