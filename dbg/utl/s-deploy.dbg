        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: e0fc85c3ab59, 1564, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: PGridchina $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Nov 06 04:41:34 2018 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: s-deploy.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/s-deploy.p $":U .
        7   define variable vss-description as character no-undo init "Раскрутка системы" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     define variable v-cntxt-db-num        as integer   no-undo .
      115     define variable v-cntxt-userid        as character no-undo .
      116     define variable v-cntxt-level         as character no-undo .
      117     define variable v-cntxt-host-code-obj as integer   no-undo .
      118     define variable v-cntxt-obj-type      as character no-undo .
      119     define variable v-cntxt-obj-code      as integer   no-undo .
      120     define variable v-cntxt-db-num-obj    as integer   no-undo .
      121     define variable v-cntxt-is-admin      as logical   no-undo .
      122   define input parameter parparentproc as widget-handle no-undo .
      123   DEFINE VARIABLE ri-list    as character no-undo .
      124   define variable v-step     as integer   no-undo .
      125   define variable v-all-step as integer   no-undo .
      126   define variable v-ok       as logical      no-undo.
      127   define variable v-rec      as recid        no-undo.
      128   define variable v-host-code    as integer      no-undo.
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130     run mainmenu_getcntxt in parparentproc
      131       (output v-cntxt-db-num
      132       ,output v-cntxt-userid
      133       ,output v-cntxt-level
      134       ,output v-cntxt-host-code-obj
      135       ,output v-cntxt-obj-type
      136       ,output v-cntxt-obj-code
      137       ,output v-cntxt-db-num-obj
      138       ,output v-cntxt-is-admin
      139       ) .
      140   assign
      141     v-step     = 0
      142     v-all-step = 2
      143   .
      144   if v-cntxt-db-num = 0 then do:
      145     assign
      146       v-all-step = 13
      147     .
      148     message
      149       substitute( "Шаг 1 из &1", v-all-step ) skip (2)
      150       "Включить возможность добавления клиентов и товаров"
      151       view-as alert-box question buttons YES-NO-Cancel update v-ok.
      152     if v-ok = ? then do:
      153       return.
      154     end.
      155     if v-ok = true then do:
      156       run adm/dbs.w ( input parparentproc
      157                     , input 'ИЗМЕНЕНИЕ':U
      158                     , output v-rec).
      159     end.
      160     message
      161       substitute( "Шаг 2 из &1", v-all-step ) skip (2)
      162       "Добавить валюты и курсы (если нужны валюты кроме рубля)"
      163       view-as alert-box question buttons YES-NO-Cancel update v-ok.
      164     if v-ok = ? then do:
      165       return.
      166     end.
      167     if v-ok = true then do:
      168       assign
      169          v-rec = ?
      170       .
      171       run ref/currency.w ( input parparentproc
      172                          , input 'b-add,b-add-acc,b-add-bank'
      173                          , input-output v-rec
      174                          ) .
      175     end.
      176     message
      177       substitute( "Шаг 3 из &1", v-all-step ) skip (2)
      178       "Добавить группу клиентов для своих фирм, объектов"
      179       view-as alert-box question buttons YES-NO-Cancel update v-ok.
      180     if v-ok = ? then do:
      181       return.
      182     end.
      183     assign
      184      ri-list = "":U
      185     .
      186     if v-ok = true then do:
      187       run ref/cli-grps.w  ( input parparentproc
      188                           , input '':U
      189                           , input-output ri-list
      190                           ) .
      191     end.
      192     message
      193       substitute( "Шаг 4 из &1", v-all-step ) skip (2)
      194       "Добавить фирму (одну из своих организаций)," skip
      195       "добавить организацию 'Реализация в магазине', записав ее код."
      196       view-as alert-box question buttons YES-NO-Cancel update v-ok.
      197     if v-ok = ? then do:
      198       return.
      199     end.
      200     if v-ok = true then do:
      201       run ref/cli-all.w   ( input parparentproc
      202                           , input 'b-add'
      203                           , input 'все':U
      204                           , input 'все':U
      205                           , input 'все':U
      206                           , input ?
      207                           , input ",,,,,,NO,,"
      208                           , input "s-deploy":U
      209                           , output ri-list
      210                           ) .
      211     end.
      212     message
      213       substitute( "Шаг 5 из &1", v-all-step ) skip (2)
      214       "Создать фирму из организации"
      215       view-as alert-box question buttons YES-NO-Cancel update v-ok.
      216     if v-ok = ? then do:
      217       return.
      218     end.
      219     if v-ok = true then do:
      220       run adm/config.w ( input parparentproc
      221                        , input 0
      222                        , input 'ДОБАВЛЕНИЕ':U
      223                        , input yes
      224                        ) .
      225     end.
      226     assign
      227       v-step = 5
      228     .
      229   end.
      230   find first sysconf no-lock no-error.
      231   if not available sysconf then do:
      232     message
      233       "Не найдена фирма."
      234       view-as alert-box error.
      235   end.
      236   assign
      237     v-host-code = sysconf.host-code
      238   .
      239   if v-cntxt-db-num = 0 then do:
      240     assign
      241       v-ok = yes
      242       ri-list = ""
      243     .
      244     message
      245       substitute( "Шаг 6 из &1", v-all-step ) skip (2)
      246       "Добавить объект" skip
      247       "Склад - YES" skip
      248       "Магазин - NO"
      249       view-as alert-box question buttons YES-NO-Cancel update v-ok.
      250     if v-ok = ? then do:
      251       return.
      252     end.
      253     if v-ok = true then do:
      254       run adm/stores.w ( INPUT parparentproc
      255                        , INPUT 'b-add'
      256                        , input-output ri-list
      257                        , INPUT YES
      258                        ) .
      259     end.
      260     else do:
      261       run adm/shops.w  ( INPUT parparentproc
      262                        , INPUT 'b-add'
      263                        , input-output ri-list
      264                        , INPUT YES
      265                        ) .
      266     end.
      267     define buffer buf_clients      for ub.clients .
      268     define buffer buf_user-obj     for ub.user-obj .
      269     FIND FIRST buf_clients
      270          WHERE buf_clients.obj-type = 'маг':U
      271             OR buf_clients.obj-type = 'скл':U
      272          NO-LOCK
      273          NO-ERROR
      274          .
      275     IF AVAILABLE buf_clients
      276     THEN DO:
      277      IF NOT CAN-FIND( FIRST buf_user-obj
      278                       WHERE buf_user-obj.db-num      = v-cntxt-db-num
      279                         AND buf_user-obj.user-id     = v-cntxt-userid
      280                         AND buf_user-obj.obj-type    = buf_clients.obj-type
      281                         AND buf_user-obj.obj-code    = buf_clients.obj-code
      282                       NO-LOCK
      283                     )
      284      THEN DO:
      285         create buf_user-obj.
      286         Assign
      287            buf_user-obj.db-num      = v-cntxt-db-num
      288            buf_user-obj.user-id     = v-cntxt-userid
      289            buf_user-obj.obj-type    = buf_clients.obj-type
      290            buf_user-obj.obj-code    = buf_clients.obj-code
      291            buf_user-obj.host-code   = buf_clients.host-code
      292         .
      293      END.
      294     END.
      295     assign
      296       v-step = 6
      297     .
      298   end.
      299   message
      300     substitute( "Шаг &1 из &2", v-step + 1, v-all-step ) skip (2)
      301     "Добавить группы прав"
      302     view-as alert-box question buttons YES-NO-Cancel update v-ok.
      303   if v-ok = ? then do:
      304     return.
      305   end.
      306   if v-ok = true then do:
      307     define variable v-action-role-code as integer   no-undo .
      308     define variable v-context          as character no-undo .
      309       ASSIGN
      310         v-context = 'All':U
      311         ri-list = "":U
      312       .
      313       run str/actnrole.w ( input  parparentproc
      314                          , input  'b-add,rs-scope':U
      315                          , input-output v-context
      316                          , output v-action-role-code
      317                          , input-output ri-list
      318                          , input 0
      319                          ) .
      320   end.
      321   if v-cntxt-db-num = 0 then do:
      322     message
      323       substitute( "Шаг 11 из &1", v-all-step ) skip (2)
      324       "Добавить виды оплат, записать их коды"
      325     view-as alert-box question buttons YES-NO-Cancel update v-ok.
      326     if v-ok = ? then do:
      327       return.
      328     end.
      329     if v-ok = true then do:
      330       run ref/paytype.w ( input parparentproc
      331                         , input 'b-add,b-upd,b-del'
      332                         , output ri-list
      333                         ) .
      334     end.
      335     message
      336       substitute( "Шаг 12 из &1", v-all-step ) skip (2)
      337       "Добавить типы платежа, записать их коды"
      338     view-as alert-box question buttons YES-NO-Cancel update v-ok.
      339     if v-ok = ? then do:
      340       return.
      341     end.
      342     if v-ok = true then do:
      343       run ref/cashpays.w  ( input parparentproc
      344                           , input 'b-add,b-upd,b-del'
      345                           , input 'все':U
      346                           , input buf_clients.host-code
      347                           , input buf_clients.obj-type
      348                           , input buf_clients.obj-code
      349                           , output ri-list
      350                           ) .
      351     end.
      352     message
      353       substitute( "Шаг 13 из &1", v-all-step ) skip (2)
      354       "Прописать в фирме 'Код реализации' - код 'Реализации в магазине', НДС и код оплаты консигнации"
      355     view-as alert-box question buttons YES-NO-Cancel update v-ok.
      356     if v-ok = ? then do:
      357       return.
      358     end.
      359     if v-ok = true then do:
      360       run adm/config.w ( input parparentproc
      361                        , input v-host-code
      362                        , input 'ИЗМЕНЕНИЕ':U
      363                        , input no
      364                        ) .
      365     end.
      366   end.
      367   message
      368     "Раскрутка закончена!" skip (2)
      369     "Сейчас будет выход из этого режима." skip
      370     "Войти под новым паролем. Система готова к работе с новым паролем." skip (2)
      371     "Не забудьте:" skip
      372     "Записать коды оплат в объекты;" skip
      373     "Сформировать и отправить НОВОСТИ."
      374     view-as alert-box.
      375   procedure s-deploy :
      376     do
      377     on error undo, return error
      378     :
      379     end.
      380   end procedure.
