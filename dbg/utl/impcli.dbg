     2014   PROCEDURE MyENable :
     2015   assign
     2016   delim:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = "Точка с запятой (;)" + chr(44) + ";" + chr(44) +
     2017                            "Тильда (~)" + chr(44) + "~~" + chr(44) +
     2018                             "Табулятор" + chr(44) + "~t" + chr(44) + "Excel(xls)"  + chr(44) + "xls"
     2019   .
     2020   ASSIGN
     2021   firm_conf-import.to-import:READ-ONLY IN BROWSE br-firm = YES
     2022   person_conf-import.to-import:READ-ONLY IN BROWSE br-person = YES
     2023   rs-uniq-method:radio-buttons = "Название" + chr(44) + "obj-name" + chr(44) +
     2024                                  "ИНН" + "+" + "КПП" + chr(44) + "inn+kpp".
     2025   .
     2026   DISPLAY
     2027   file-name
     2028   EDITOR-1
     2029   delim
     2030   cli-grp-name
     2031   rs-uniq-method
     2032   WITH FRAME Dialog-Frame.
     2033   ENABLE
     2034   b-up-firm
     2035   b-down-firm
     2036   b-up-person
     2037   b-down-person
     2038   b-exit
     2039   RECT-7
     2040   B-quit
     2041   B-help
     2042   B-cli-grp
     2043   file-name
     2044   B-file
     2045   BR-firm
     2046   BR-person
     2047   EDITOR-1
     2048   delim
     2049   cli-grp-name
     2050   rs-uniq-method
     2051   WITH FRAME Dialog-Frame.
     2052   OPEN QUERY BR-firm FOR EACH firm_conf-import WHERE firm_conf-import.subject = 'firm':U.    OPEN QUERY BR-person FOR EACH person_conf-import WHERE person_conf-import.subject = 'person':U.
     2053   apply "value-changed" to br-firm.
     2054   apply "value-changed" to br-person.
     2055   END PROCEDURE.
     2056   PROCEDURE set-row-color-firm :
     2057   DEFINE INPUT PARAMETER p-is-mandatory AS LOGICAL NO-UNDO.
     2058   DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
     2059   DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
     2060     IF p-is-mandatory = YES THEN DO:
     2061         ASSIGN
     2062           iFGColor = WHITE_COLOR
     2063           iBGColor = GREY_COLOR
     2064         .
     2065       end.
     2066       ELSE do:
     2067         ASSIGN
     2068           iFGColor = Black_COLOR
     2069           iBGColor = White_COLOR
     2070         .
     2071       end.
     2072   ASSIGN
     2073   firm_conf-import.field-label:FGCOLOR IN BROWSE br-firm = iFGColor
     2074   firm_conf-import.field-label:BGCOLOR IN BROWSE br-firm = iBGColor
     2075   .
     2076   END PROCEDURE.
     2077   PROCEDURE set-row-color-person :
     2078   DEFINE INPUT PARAMETER p-is-mandatory AS LOGICAL NO-UNDO.
     2079   DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
     2080   DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
     2081     IF p-is-mandatory = YES THEN DO:
     2082         ASSIGN
     2083           iFGColor = WHITE_COLOR
     2084           iBGColor = GREY_COLOR
     2085         .
     2086       end.
     2087       ELSE do:
     2088         ASSIGN
     2089           iFGColor = Black_COLOR
     2090           iBGColor = White_COLOR
     2091         .
     2092       end.
     2093   ASSIGN
     2094   person_conf-import.field-label:FGCOLOR IN BROWSE br-person = iFGColor
     2095   person_conf-import.field-label:BGCOLOR IN BROWSE br-person = iBGColor
     2096   .
     2097   END PROCEDURE.
