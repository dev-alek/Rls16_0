        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Утилита закачки дисконтных карт и клиентов-интерфейс".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#library  as handle no-undo .
      112   define new global shared variable g#library2 as handle no-undo .
      113   define variable dops0 as character no-undo format "X(8)".
      114   define variable dops as character no-undo format "X(250)".
      115   define variable dopst as character no-undo format "X(1)".
      116   define variable dopsp as character no-undo format "X(10)".
      117   define variable cards as char no-undo.
      118   define variable cli-grp-code like cli-grp.node-code no-undo.
      119   define variable globalcard as logical no-undo.
      120   define variable ii as integer no-undo.
      121   define variable dc-type-type as char no-undo.
      122   define variable v-curr-db-num like ub.db.db-num no-undo .
      123    DEFINE VARIABLE chExcelApplication      AS COM-HANDLE no-undo .
      124   DEFINE VARIABLE chWorkbook              AS COM-HANDLE no-undo .
      125   DEFINE VARIABLE chWorksheet             AS COM-HANDLE no-undo .
      126   DEFINE VARIABLE  v-num-mandatory-fields AS INTEGER NO-UNDO.
      127   DEFINE TEMP-TABLE conf-import NO-UNDO
      128   FIELD subject AS CHARACTER
      129   FIELD table-name AS CHARACTER
      130   FIELD field-name AS CHARACTER
      131   FIELD is-mandatory AS LOGICAL
      132   FIELD to-import AS LOGICAL
      133   FIELD field-label AS CHARACTER
      134   FIELD position_ AS INTEGER
      135   INDEX pi IS UNIQUE PRIMARY
      136   subject
      137   position_
      138   .
      139   DEFINE BUFFER firm_conf-import FOR conf-import.
      140   DEFINE BUFFER person_conf-import FOR conf-import.
      141   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      143   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      144   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      145   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      146   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      147   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      148   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      149   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      150   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      151   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      152   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      153   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      154   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      155   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      156   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      157   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      158   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      159   DEFINE BUTTON B-cli-grp
      160        IMAGE-UP FILE "btn-down-arrow":U
      161        IMAGE-DOWN FILE "btn-down-arrow":U
      162        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      163        LABEL ""
      164        SIZE 3 BY 1.
      165   DEFINE BUTTON b-down-firm
      166        IMAGE-UP FILE "btn-down-arrow":U
      167        IMAGE-DOWN FILE "btn-down-arrow":U
      168        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      169        LABEL ""
      170        SIZE 4 BY 1.
      171   DEFINE BUTTON b-down-person
      172        IMAGE-UP FILE "btn-down-arrow":U
      173        IMAGE-DOWN FILE "btn-down-arrow":U
      174        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      175        LABEL ""
      176        SIZE 4 BY 1.
      177   DEFINE BUTTON b-exit AUTO-GO
      178        LABEL "&Ввод"
      179        SIZE 10 BY 1
      180        BGCOLOR 8 .
      181   DEFINE BUTTON B-file
      182        IMAGE-UP FILE "btn-down-arrow":U
      183        IMAGE-DOWN FILE "btn-down-arrow":U
      184        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      185        LABEL ""
      186        SIZE 3 BY 1.
      187   DEFINE BUTTON B-help
      188        LABEL "Помо&щь"
      189        SIZE 3 BY 1
      190        BGCOLOR 8 .
      191   DEFINE BUTTON B-quit AUTO-END-KEY
      192        LABEL "&Отмена"
      193        SIZE 10 BY 1
      194        BGCOLOR 8 .
      195   DEFINE BUTTON b-up-firm
      196        IMAGE-UP FILE "btn-up-arrow":U
      197        IMAGE-DOWN FILE "btn-up-arrow":U
      198        IMAGE-INSENSITIVE FILE "btn-up-arrow":U
      199        LABEL ""
      200        SIZE 4 BY 1.
      201   DEFINE BUTTON b-up-person
      202        IMAGE-UP FILE "btn-up-arrow":U
      203        IMAGE-DOWN FILE "btn-up-arrow":U
      204        IMAGE-INSENSITIVE FILE "btn-up-arrow":U
      205        LABEL ""
      206        SIZE 4 BY 1.
      207   DEFINE VARIABLE EDITOR-1 AS CHARACTER INITIAL "Необязательные поля следуют в строчке файла импорта за обязательными со строгим соблюдением задаваемой последовательности"
      208        VIEW-AS EDITOR NO-BOX
      209        SIZE 20 BY 5.2
      210        FGCOLOR 4  NO-UNDO.
      211   DEFINE VARIABLE cli-grp-name AS CHARACTER FORMAT "X(256)":U
      212         VIEW-AS TEXT
      213        SIZE 40.8 BY 1 NO-UNDO.
      214   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      215        VIEW-AS FILL-IN
      216        SIZE 25 BY 1 NO-UNDO.
      217   DEFINE VARIABLE Rs-uniq-method AS CHARACTER INITIAL "obj-name"
      218        VIEW-AS RADIO-SET VERTICAL
      219        RADIO-BUTTONS
      220             "Название", "obj-name",
      221   "INN+KPP", "inn+kpp"
      222        SIZE 21 BY 2.4 NO-UNDO.
      223   DEFINE RECTANGLE RECT-7
      224        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      225        SIZE 21 BY 5.67.
      226   DEFINE VARIABLE delim AS CHARACTER
      227        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      228        LIST-ITEM-PAIRS "Точка с запятой(;)","Точка с запятой(;)",
      229                        "Тильда()","Тильда()",
      230                        "Табулятор(     )","Табулятор(     )",
      231                        "Excel", "Excel"
      232        SIZE 21.8 BY 2.8 NO-UNDO.
      233   DEFINE QUERY BR-firm FOR
      234         firm_conf-import SCROLLING.
      235   DEFINE QUERY BR-person FOR
      236         person_conf-import SCROLLING.
      237   DEFINE BROWSE BR-firm
      238     QUERY BR-firm DISPLAY
      239         firm_conf-import.field-label FORMAT "X(25)" COLUMN-LABEL "Поле"
      240   firm_conf-import.IS-MANDATORY COLUMN-LABEL "Обяз":U FORMAT "+/"
      241   firm_conf-import.to-import COLUMN-LABEL "":U VIEW-AS TOGGLE-BOX
      242   ENABLE
      243   firm_conf-import.to-import
      244       WITH NO-ROW-MARKERS SEPARATORS SIZE 39 BY 18
      245            TITLE "Поля при импорте клиента типа ОРГАНИЗАЦИЯ" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
      246   DEFINE BROWSE BR-person
      247     QUERY BR-person DISPLAY
      248         person_conf-import.field-label COLUMN-LABEL "Поле" FORMAT "X(25)"
      249   person_conf-import.IS-MANDATORY COLUMN-LABEL "Обяз":U FORMAT "+/"
      250   person_conf-import.to-import COLUMN-LABEL "":U VIEW-AS TOGGLE-BOX
      251   ENABLE
      252   person_conf-import.to-import
      253       WITH NO-ROW-MARKERS SEPARATORS SIZE 35.5 BY 18
      254            TITLE "Поля при импорте клиента типа ФИЗ.ЛИЦО" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
      255   DEFINE FRAME Dialog-Frame
      256        b-exit AT ROW 1 COL 1
      257        B-quit AT ROW 1 COL 11
      258        B-help AT ROW 1 COL 95
      259        B-cli-grp AT ROW 2.07 COL 94.3
      260        file-name AT ROW 2.87 COL 2.1 NO-LABEL
      261        B-file AT ROW 2.93 COL 28
      262        b-up-firm AT ROW 3.93 COL 31.5 WIDGET-ID 2
      263        b-down-firm AT ROW 3.93 COL 35.5 WIDGET-ID 6
      264        b-up-person AT ROW 3.93 COL 65 WIDGET-ID 4
      265        b-down-person AT ROW 3.93 COL 69 WIDGET-ID 8
      266        BR-firm AT ROW 5 COL 23.5 WIDGET-ID 200
      267        BR-person AT ROW 5 COL 63 WIDGET-ID 300
      268        delim AT ROW 6.8 COL 1.5 NO-LABEL
      269        EDITOR-1 AT ROW 9.93 COL 2.4 NO-LABEL
      270        Rs-uniq-method AT ROW 16.47 COL 1.5 NO-LABEL WIDGET-ID 10
      271        cli-grp-name AT ROW 2.03 COL 53.1 NO-LABEL
      272        "Файл импорта" VIEW-AS TEXT
      273             SIZE 19 BY .77 AT ROW 2.07 COL 2
      274             FGCOLOR 4
      275        "по умолчанию" VIEW-AS TEXT
      276             SIZE 19 BY .77 AT ROW 2.93 COL 33.4
      277             FGCOLOR 4
      278        "Группа клиента" VIEW-AS TEXT
      279             SIZE 19 BY .8 AT ROW 2.07 COL 33.5
      280             FGCOLOR 4
      281        "колонок" VIEW-AS TEXT
      282             SIZE 19 BY .97 AT ROW 5.2 COL 2.1
      283             FGCOLOR 4
      284        "Символ-разделитель" VIEW-AS TEXT
      285             SIZE 20 BY .97 AT ROW 4.2 COL 2.1
      286             FGCOLOR 4
      287        RECT-7 AT ROW 9.8 COL 1.6
      288        SPACE(84.49) SKIP(7.69)
      289       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      290            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      291            TITLE "Импорт клиентов"
      292            DEFAULT-BUTTON b-exit CANCEL-BUTTON B-quit.
      293   ASSIGN
      294          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      295          FRAME Dialog-Frame:HIDDEN           = TRUE.
      296   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      297   DO:
      298     APPLY "END-ERROR":U TO SELF.
      299   END.
      300   ON CHOOSE OF B-cli-grp IN FRAME Dialog-Frame
      301   DO:
      302       define variable rid-list as char no-undo.
      303       run ref/cli-grps.w ( input parparentproc
      304                           ,input ('терм':U + chr(44) + "b-sel")
      305                           ,input-output rid-list).
      306       if rid-list <> "" then do:
      307           FIND FIRST cli-grp NO-LOCK WHERE recid(cli-grp) = integer(rid-list) NO-ERROR.
      308           IF NOT AVAIL cli-grp then return no-apply.
      309           assign
      310           cli-grp-code = cli-grp.node-code
      311           cli-grp-name = cli-grp.node-name
      312           .
      313           DISPLAY
      314           cli-grp-name
      315           WITH FRAME Dialog-Frame.
      316       end.
      317   END.
      318   ON CHOOSE OF b-down-firm IN FRAME Dialog-Frame
      319   DO:
      320     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      321   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      322   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      323   DEFINE BUFFER buf1_conf-import FOR conf-import.
      324   DEFINE BUFFER buf2_conf-import FOR conf-import.
      325     IF NOT AVAILABLE firm_conf-import  THEN RETURN NO-APPLY.
      326     DO TRANSACTION:
      327        v-rec = recid(firm_conf-import).
      328        FIND FIRST buf1_conf-import WHERE
      329                 buf1_conf-import.subject = 'firm':U
      330             AND buf1_conf-import.POSITION_ = firm_conf-import.POSITION_.
      331       FIND FIRST buf2_conf-import WHERE
      332                buf2_conf-import.subject = 'firm':U
      333            AND buf2_conf-import.POSITION_ > firm_conf-import.POSITION_ NO-ERROR.
      334       IF NOT AVAILABLE buf2_conf-import THEN DO:
      335           BELL.
      336           RETURN NO-APPLY.
      337       END.
      338        ASSIGN
      339        v-old = buf1_conf-import.POSITION_.
      340        ASSIGN
      341        v-new = buf2_conf-import.POSITION_.
      342        ASSIGN
      343        buf1_conf-import.POSITION_ = 999999999.
      344        RELEASE buf1_conf-import.
      345        ASSIGN
      346        buf2_conf-import.POSITION_ = v-old.
      347        RELEASE buf2_conf-import.
      348        FIND FIRST buf1_conf-import WHERE
      349                   buf1_conf-import.subject = 'firm':U
      350               AND buf1_conf-import.POSITION_ = 999999999.
      351        ASSIGN
      352        buf1_conf-import.POSITION_ = v-new.
      353     END.
      354     OPEN QUERY BR-firm FOR EACH firm_conf-import WHERE firm_conf-import.subject = 'firm':U.
      355     REPOSITION br-firm TO RECID v-rec NO-ERROR.
      356     apply "entry" TO br-firm.
      357   END.
      358   ON CHOOSE OF b-down-person IN FRAME Dialog-Frame
      359   DO:
      360    DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      361   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      362   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      363   DEFINE BUFFER buf1_conf-import FOR conf-import.
      364   DEFINE BUFFER buf2_conf-import FOR conf-import.
      365     IF NOT AVAILABLE person_conf-import  THEN RETURN NO-APPLY.
      366     DO TRANSACTION:
      367        v-rec = recid(person_conf-import).
      368        FIND FIRST buf1_conf-import WHERE
      369                 buf1_conf-import.subject = 'person':U
      370             AND buf1_conf-import.POSITION_ = person_conf-import.POSITION_.
      371       FIND FIRST buf2_conf-import WHERE
      372                buf2_conf-import.subject = 'person':U
      373            AND buf2_conf-import.POSITION_ > person_conf-import.POSITION_ NO-ERROR.
      374       IF NOT AVAILABLE buf2_conf-import THEN DO:
      375           BELL.
      376           RETURN NO-APPLY.
      377       END.
      378        ASSIGN
      379        v-old = buf1_conf-import.POSITION_.
      380        ASSIGN
      381        v-new = buf2_conf-import.POSITION_.
      382        ASSIGN
      383        buf1_conf-import.POSITION_ = 999999999.
      384        RELEASE buf1_conf-import.
      385        ASSIGN
      386        buf2_conf-import.POSITION_ = v-old.
      387        RELEASE buf2_conf-import.
      388        FIND FIRST buf1_conf-import WHERE
      389                   buf1_conf-import.subject = 'person':U
      390               AND buf1_conf-import.POSITION_ = 999999999.
      391        ASSIGN
      392        buf1_conf-import.POSITION_ = v-new.
      393     END.
      394     OPEN QUERY BR-person FOR EACH person_conf-import WHERE person_conf-import.subject = 'person':U.
      395     REPOSITION br-person TO RECID v-rec NO-ERROR.
      396     apply "entry" TO br-person.
      397   END.
      398   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      399   DO:
      400   define variable firm-pairs as char no-undo.
      401   define variable person-pairs as char no-undo.
      402   define variable mydelimiter as char no-undo.
      403   DEFINE BUFFER buf_conf-import FOR conf-import.
      404     assign
      405     file-name
      406     delim
      407     rs-uniq-method
      408     .
      409     if search(file-name) = ? then do:
      410       message "Не выбран файл импорта"
      411       view-as alert-box ERROR.
      412       return no-apply.
      413     end.
      414     if delim = "" then do:
      415       message "Не выбран символ-разделитель колонок в файле импорта!"
      416       view-as alert-box.
      417       return no-apply.
      418     end.
      419     FIND FIRST cli-grp No-LOCK WHERE cli-grp.node-code = cli-grp-code No-ERROR.
      420     IF NOT avail cli-grp then do:
      421       message "Не выбрана группа клиентов или группа клиентов неверна!"
      422       view-as alert-box error.
      423         return no-APPLY.
      424     end.
      425     assign
      426     mydelimiter = delim
      427     mydelimiter = if mydelimiter = "~t":U
      428                   then chr(9)
      429                   else mydelimiter
      430    .
      431   FOR EACH buf_conf-import WHERE
      432      buf_conf-import.subject = 'firm':U
      433   AND buf_conf-import.to-import = YES
      434   BY buf_conf-import.subject
      435   BY buf_conf-import.POSITION_
      436   :
      437      ASSIGN
      438      firm-pairs = firm-pairs + (IF firm-pairs = '':U THEN '':U ELSE chr(47)) + buf_conf-import.field-name.
      439   END.
      440   FOR EACH buf_conf-import WHERE
      441      buf_conf-import.subject = 'person':U
      442   AND buf_conf-import.to-import = YES
      443   BY buf_conf-import.subject
      444   BY buf_conf-import.POSITION_
      445   :
      446     ASSIGN
      447     person-pairs = person-pairs + (IF person-pairs = '':U THEN '':U ELSE chr(47)) + buf_conf-import.field-name.
      448   END.
      449   ASSIGN
      450   firm-pairs = RIGHT-TRIM(firm-pairs, chr(47))
      451   person-pairs = RIGHT-TRIM(person-pairs, chr(47))
      452   .
      453   run str/diallog.w (
      454                   input parparentproc
      455                 , input this-procedure
      456                 , input 'utl/incli.p':U
      457                 , input (file-name                        + chr(4) +
      458                    string(cli-grp-code)             + chr(4) +
      459                    mydelimiter                      + chr(4) +
      460                    rs-uniq-method                   + chr(4) +
      461                    firm-pairs                        + chr(4) +
      462                    person-pairs                      )
      463                 , INPUT no
      464                 , INPUT "&Стоп"
      465                 , INPUT 'Импорт клиентов') .
      466   END.
      467   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      468   DO:
      469         define variable ff as character no-undo.
      470       define variable v_os-file   AS CHAR NO-UNDO INIT "".
      471       define variable ll_commit AS LOG    NO-UNDO INIT NO.
      472       SYSTEM-DIALOG GET-FILE v_os-file
      473           TITLE "Выберите файл для импорта"
      474           FILTERS
      475           " Все текстовые файлы (*.txt) " "*.txt",
      476           "excel (*.xls , *xlsx)"   "*.xls, *xlsx",
      477           " Все файлы (*.*) "                      "*.*"
      478           INITIAL-FILTER 1
      479           DEFAULT-EXTENSION ".txt"
      480           USE-FILENAME
      481           MUST-EXIST
      482           UPDATE ll_commit
      483           .
      484       IF ll_commit <> YES THEN do:
      485          RETURN NO-APPLY.
      486       end.
      487       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      488           BELL.
      489           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      490           RETURN NO-APPLY.
      491       END.
      492       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      493       DISP file-name WITH FRAME Dialog-Frame.
      494   END.
      495   ON CHOOSE OF b-up-firm IN FRAME Dialog-Frame
      496   DO:
      497   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      498   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      499   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      500   DEFINE BUFFER buf1_conf-import FOR conf-import.
      501   DEFINE BUFFER buf2_conf-import FOR conf-import.
      502     IF NOT AVAILABLE firm_conf-import  THEN RETURN NO-APPLY.
      503     IF firm_conf-import.POSITION_ =  1 THEN DO:
      504         BELL.
      505         RETURN NO-APPLY.
      506     END.
      507     DO TRANSACTION:
      508        v-rec = recid(firm_conf-import).
      509        FIND FIRST buf1_conf-import WHERE
      510                 buf1_conf-import.subject = 'firm':U
      511             AND buf1_conf-import.POSITION_ = firm_conf-import.POSITION.
      512       FIND last buf2_conf-import WHERE
      513                buf2_conf-import.subject = 'firm':U
      514            AND buf2_conf-import.POSITION_ < firm_conf-import.POSITION .
      515        ASSIGN
      516        v-old = buf1_conf-import.POSITION_.
      517        ASSIGN
      518        v-new = buf2_conf-import.POSITION_.
      519        ASSIGN
      520        buf1_conf-import.POSITION_ = 999999999.
      521        RELEASE buf1_conf-import.
      522        ASSIGN
      523        buf2_conf-import.POSITION_ = v-old.
      524        RELEASE buf2_conf-import.
      525        FIND FIRST buf1_conf-import WHERE
      526                   buf1_conf-import.subject = 'firm':U
      527               AND buf1_conf-import.POSITION_ = 999999999.
      528        ASSIGN
      529        buf1_conf-import.POSITION_ = v-new.
      530     END.
      531   OPEN QUERY BR-firm FOR EACH firm_conf-import WHERE firm_conf-import.subject = 'firm':U.
      532     REPOSITION br-firm TO RECID v-rec NO-ERROR.
      533     apply "entry" TO br-firm.
      534   END.
      535   ON CHOOSE OF b-up-person IN FRAME Dialog-Frame
      536   DO:
      537     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      538   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      539   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      540   DEFINE BUFFER buf1_conf-import FOR conf-import.
      541   DEFINE BUFFER buf2_conf-import FOR conf-import.
      542     IF NOT AVAILABLE person_conf-import  THEN RETURN NO-APPLY.
      543     IF person_conf-import.POSITION_ =  1 THEN DO:
      544         BELL.
      545         RETURN NO-APPLY.
      546     END.
      547     DO TRANSACTION:
      548        v-rec = recid(person_conf-import).
      549        FIND FIRST buf1_conf-import WHERE
      550                 buf1_conf-import.subject = 'person':U
      551             AND buf1_conf-import.POSITION_ = person_conf-import.POSITION.
      552       FIND LAST buf2_conf-import WHERE
      553                buf2_conf-import.subject = 'person':U
      554            AND buf2_conf-import.POSITION_ < person_conf-import.POSITION .
      555        ASSIGN
      556        v-old = buf1_conf-import.POSITION_.
      557        ASSIGN
      558        v-new = buf2_conf-import.POSITION_.
      559        ASSIGN
      560        buf1_conf-import.POSITION_ = 999999999.
      561        RELEASE buf1_conf-import.
      562        ASSIGN
      563        buf2_conf-import.POSITION_ = v-old.
      564        RELEASE buf2_conf-import.
      565        FIND FIRST buf1_conf-import WHERE
      566                   buf1_conf-import.subject = 'person':U
      567               AND buf1_conf-import.POSITION_ = 999999999.
      568        ASSIGN
      569        buf1_conf-import.POSITION_ = v-new.
      570     END.
      571     OPEN QUERY BR-person FOR EACH person_conf-import WHERE person_conf-import.subject = 'person':U.
      572     REPOSITION br-person TO RECID v-rec NO-ERROR.
      573     apply "entry" TO br-person.
      574   END.
      575   ON VALUE-CHANGED OF BR-firm IN FRAME Dialog-Frame
      576   DO:
      577     IF NOT AVAILABLE firm_conf-import
      578     OR (AVAILABLE firm_conf-import AND firm_conf-import.is-mandatory) = YES THEN DO:
      579         ASSIGN
      580         firm_conf-import.to-import:READ-ONLY IN BROWSE br-firm = YES.
      581     END.
      582     ELSE DO:
      583         ASSIGN
      584         firm_conf-import.to-import:READ-ONLY IN BROWSE br-firm = NO.
      585     END.
      586   END.
      587   ON VALUE-CHANGED OF BR-person IN FRAME Dialog-Frame
      588   DO:
      589     IF NOT AVAILABLE person_conf-import
      590     OR (AVAILABLE person_conf-import AND person_conf-import.is-mandatory) = YES THEN DO:
      591         ASSIGN
      592         person_conf-import.to-import:READ-ONLY IN BROWSE br-person = YES.
      593     END.
      594     ELSE DO:
      595         ASSIGN
      596         person_conf-import.to-import:READ-ONLY IN BROWSE br-person = NO.
      597     END.
      598   END.
      599   ON LEAVE OF file-name IN FRAME Dialog-Frame
      600   DO:
      601       ASSIGN file-name.
      602       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      603           ASSIGN FILE-INFO:FILE-NAME = file-name.
      604           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      605           DISP file-name WITH FRAME Dialog-Frame.
      606       END.
      607       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
      608   END.
      609   ON ROW-DISPLAY OF br-firm IN frame Dialog-Frame
      610   DO:
      611     IF AVAIL firm_conf-import THEN DO:
      612       RUN set-row-color-firm IN THIS-PROCEDURE ( INPUT firm_conf-import.is-mandatory).
      613     END.
      614   END.
      615   ON ROW-DISPLAY OF br-person IN frame Dialog-Frame
      616   DO:
      617     IF AVAIL person_conf-import THEN DO:
      618       RUN set-row-color-person IN THIS-PROCEDURE (INPUT person_conf-import.is-mandatory).
      619     END.
      620   END.
      621   ON "leave" OF firm_conf-import.to-import  IN BROWSE br-firm
      622   DO:
      623      IF firm_conf-import.is-mandatory = YES
      624      and firm_conf-import.to-import = no
      625      THEN DO:
      626       BELL.
      627       assign
      628       firm_conf-import.to-import = yes.
      629       display
      630       firm_conf-import.to-import
      631       with browse br-firm.
      632     END.
      633   END.
      634   ON "leave" OF person_conf-import.to-import  IN BROWSE br-person
      635   DO:
      636      IF person_conf-import.is-mandatory = YES
      637      and person_conf-import.to-import = no
      638      THEN DO:
      639       BELL.
      640       assign
      641       person_conf-import.to-import = yes.
      642       display
      643       person_conf-import.to-import
      644       with browse br-person.
      645     END.
      646   END.
      647   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      648   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      649   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      651     (output v-curr-db-num
      652     )  .
      653   FIND FIRST db WHERE db.db-num = v-curr-db-num NO-LOCK .
      654   if NOT  db.add-clients  OR NOT v-curr-db-num = 0 then do:
      655       message "Импорт клиентов возможен только в ГБД"  skip
      656               "и БД, в которых разрешен ввод клиентов"
      657       view-as alert-box ERROR.
      658       return.
      659   end.
      660   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   on help of frame Dialog-Frame
      662   do:
      663     run gbl/app_help.p
      664       (input this-procedure :file-name
      665       ,input ''
      666       ,input ?
      667       ) no-error.
      668     if error-status :error then do:
      669       message
      670         "Ошибка при вызове помощи"
      671         error-status :get-message(1)
      672         view-as alert-box .
      673     end.
      674   end.
      675   run minbtn-set in this-procedure .
      676   on choose of b-help in frame Dialog-Frame
      677   do:
      678     apply "help":u to frame Dialog-Frame .
      679   end.
      680   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   procedure minbtn-set :
      682       do
      683           on error undo, return error return-value
      684           :
      685           define variable ii              as integer       no-undo .
      686           define variable fh              as widget-handle no-undo .
      687           define variable hh              as widget-handle no-undo .
      688           define variable v-h             as handle        extent 4 no-undo .
      689           define variable v-name-button   as character     no-undo .
      690           define variable v-help-old-x    as decimal       no-undo .
      691           define variable v-help-old-y    as decimal       no-undo .
      692           define variable v-help-old-size as decimal       no-undo .
      693           define variable v-frame-width   as decimal       no-undo .
      694           define variable jj              as integer       no-undo .
      695           do
      696               on error undo, return error
      697               :
      698               assign
      699                   v-frame-width = frame Dialog-Frame:width - 0.3
      700                   fh            = frame Dialog-Frame:first-child
      701                   hh            = fh:first-child
      702                   ii            = 1
      703                   .
      704               do while valid-handle(hh):
      705                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      706                   do:
      707                       case lc(hh:name) :
      708                           when "b-help" then
      709                               do:
      710                                   hh:load-image-up("cmp/b-help.bmp":u) .
      711                                   hh:load-image-down("cmp/b-help.bmp":u) .
      712                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      713                                   hh:TOOLTIP = "Помощь" .
      714                                   v-help-old-x = hh:column .
      715                                   v-help-old-y = hh:row    .
      716                                   v-help-old-size = hh:width .
      717                                   hh:width-chars = 2.5 .
      718                               end.
      719                           when "b-print" then
      720                               do:
      721                                   hh:load-image("cmp/b-print.bmp":u) .
      722                                   hh:TOOLTIP = "Печать" .
      723                                   v-h[ii] = hh:handle .
      724                                   ii = ii + 1 .
      725                                   hh:width-chars = 3 .
      726                               end.
      727                           when "b-history" or
      728                           when "b-hist" then
      729                               do:
      730                                   hh:load-image("cmp/b-hist.bmp":u) .
      731                                   hh:TOOLTIP = "История" .
      732                                   v-h[ii] = hh:handle .
      733                                   ii = ii + 1 .
      734                                   hh:width-chars = 3 .
      735                               end.
      736                           when "b-sch" then
      737                               do:
      738                                   hh:load-image("cmp/b-sch.bmp":u) .
      739                                   hh:TOOLTIP = "Установка Фильтра" .
      740                                   v-h[ii] = hh:handle .
      741                                   ii = ii + 1 .
      742                                   hh:width-chars = 3 .
      743                               end.
      744                           when "b-hist-user" then
      745                               do:
      746                                   hh:load-image("cmp/b-hist.bmp":u) .
      747                                   hh:TOOLTIP = "История пользователя" .
      748                                   ii = ii + 1 .
      749                               end.
      750                       end case.
      751                   end.
      752                   hh = hh:next-sibling.
      753               end.
      754               b-help:column = v-frame-width - b-help:width-chars.
      755               jj = 0.
      756               repeat ii = 4 to 1 by -1 :
      757                   if valid-handle (v-h[ii] ) then
      758                   do:
      759                       jj  = jj + 1 .
      760                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      761                       v-h[ii]:row    = v-help-old-y .
      762                   end.
      763               end.
      764           end.
      765       end.
      766   end procedure.
      767   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      768   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      769   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      770   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      771   define variable v-diasize-current-frame-width  as decimal   no-undo .
      772   define variable v-diasize-current-frame-height as decimal   no-undo .
      773   define variable v-diasize-change-size          as logical   no-undo .
      774   define variable v-diasize-resize-button        as handle    no-undo .
      775   define variable v-diasize-wndmax               as logical   no-undo .
      776   define variable v-diasize-wndstore             as logical   no-undo .
      777   define variable v-diasize-proc-name            as character no-undo .
      778   define variable v-diasize-browse-handle        as handle    no-undo .
      779   define variable v-diasize-browse-number        as integer   no-undo .
      780   define variable v-diasize-need-full-display    as logical   no-undo init false .
      781   define temp-table temp-diasize-handle no-undo
      782     field handle-value  as handle
      783     field save-position as decimal
      784     index xpk is primary unique handle-value
      785     .
      786   define temp-table temp-browse-handle no-undo
      787     field browse-type   as character
      788     field browse-number as integer
      789     field browse-handle as handle
      790     field original-size as decimal
      791     index xpk is primary unique browse-type browse-number
      792     index xie browse-type browse-handle
      793   .
      794   procedure diasize_change-height :
      795     define input  parameter p-change-value  as decimal   no-undo .
      796     define input  parameter p-move-resize   as logical   no-undo .
      797     define variable v-field-group-handle    as handle    no-undo .
      798     define variable v-object-handle         as handle    no-undo .
      799     define variable v-frame-height          as decimal   no-undo .
      800     define variable v-frame-virtual-height  as decimal   no-undo .
      801     define variable v-browse-height         as decimal   no-undo .
      802     define variable v-window-height         as decimal   no-undo .
      803     define variable v-window-virtual-height as decimal   no-undo .
      804     define variable v-change-sign           as integer   no-undo .
      805     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      806     define buffer buf_temp-browse-handle  for temp-browse-handle .
      807     if p-change-value > 0
      808     then do:
      809       if frame Dialog-Frame :height + p-change-value
      810           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      811       then do:
      812         assign
      813           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      814                           - (frame Dialog-Frame :height-chars)
      815         .
      816         if p-change-value <= 0
      817         then do:
      818           run diasize_position-resize-button in this-procedure .
      819           return .
      820         end.
      821       end.
      822     end.
      823     if p-change-value < 0
      824     then do:
      825       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      826       then do:
      827         assign
      828           p-change-value = v-diasize-orig-frame-height
      829                          - (frame Dialog-Frame :height-chars)
      830         .
      831         if p-change-value >= 0
      832         then do:
      833           run diasize_position-resize-button in this-procedure .
      834           return .
      835         end.
      836       end.
      837     end.
      838     if p-change-value >= 0
      839     then do:
      840       assign
      841         v-change-sign = 1
      842       .
      843     end.
      844     else do:
      845       assign
      846         v-change-sign = -1
      847       .
      848     end.
      849     assign
      850       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      851     .
      852     if p-change-value = 0
      853     then do:
      854       run diasize_position-resize-button in this-procedure .
      855       return .
      856     end.
      857     move_block:
      858     do
      859     on error undo move_block, retry move_block
      860     :
      861       if retry
      862       then do:
      863         do
      864         on error undo move_block, leave move_block
      865         :
      866           if p-change-value > 0
      867           then do:
      868             for each buf_temp-diasize-handle
      869             on error undo, next
      870             :
      871               assign
      872                 v-object-handle = buf_temp-diasize-handle.handle-value
      873               .
      874               if v-object-handle <> v-diasize-resize-button
      875               then do:
      876                 assign
      877                   v-object-handle :row = buf_temp-diasize-handle.save-position
      878                 .
      879               end.
      880             end.
      881             assign
      882               v-diasize-browse-handle :height = v-browse-height
      883             .
      884             for each buf_temp-browse-handle
      885               where buf_temp-browse-handle.browse-type = 'height':u
      886             on error undo, next
      887             :
      888               assign
      889                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      890               .
      891             end.
      892             assign
      893               frame Dialog-Frame :height = v-frame-height
      894             .
      895             if frame Dialog-Frame :scrollable = true
      896             then do:
      897               assign
      898                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      899               .
      900             end.
      901             run diasize_position-resize-button in this-procedure .
      902           end.
      903           else do:
      904             if frame Dialog-Frame :scrollable = true
      905             then do:
      906               assign
      907                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      908               .
      909             end.
      910             assign
      911               frame Dialog-Frame :height = v-frame-height
      912             .
      913             assign
      914               v-diasize-browse-handle :height = v-browse-height
      915             .
      916             for each buf_temp-browse-handle
      917               where buf_temp-browse-handle.browse-type = 'height':u
      918             on error undo, next
      919             :
      920               assign
      921                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      922               .
      923             end.
      924             for each buf_temp-diasize-handle
      925             on error undo, next
      926             :
      927               assign
      928                 v-object-handle = buf_temp-diasize-handle.handle-value
      929               .
      930               if v-object-handle <> v-diasize-resize-button
      931               then do:
      932                 assign
      933                   v-object-handle :row = buf_temp-diasize-handle.save-position
      934                 .
      935               end.
      936             end.
      937             run diasize_position-resize-button in this-procedure .
      938           end.
      939           assign
      940             v-diasize-change-size = false
      941           .
      942           leave move_block .
      943         end.
      944       end.
      945       assign
      946         v-diasize-need-full-display = true
      947       .
      948       if v-diasize-change-size = false
      949       then do:
      950         assign
      951           v-diasize-change-size = true
      952         .
      953       end.
      954       else do:
      955         return .
      956       end.
      957       assign
      958         v-frame-height = frame Dialog-Frame :height
      959         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      960         v-browse-height = v-diasize-browse-handle :height
      961       .
      962       for each buf_temp-browse-handle
      963         where buf_temp-browse-handle.browse-type = 'height':u
      964       :
      965         assign
      966           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      967         .
      968       end.
      969       for each buf_temp-diasize-handle
      970       :
      971         delete buf_temp-diasize-handle .
      972       end.
      973       assign
      974         v-field-group-handle = frame Dialog-Frame :first-child
      975       .
      976       do while valid-handle(v-field-group-handle)
      977       :
      978         assign
      979           v-object-handle = v-field-group-handle :first-child
      980         .
      981         do while valid-handle(v-object-handle)
      982         :
      983           if  v-object-handle <> v-diasize-browse-handle :handle
      984           and can-query(v-object-handle, "row")
      985           and can-query(v-object-handle, "height")
      986           and ( v-object-handle :row > v-diasize-browse-handle :row )
      987           then do:
      988             find first buf_temp-browse-handle
      989               where buf_temp-browse-handle.browse-type   = 'height':u
      990                 and buf_temp-browse-handle.browse-handle = v-object-handle
      991               no-error .
      992             if available buf_temp-browse-handle
      993             then do:
      994             end.
      995             else do:
      996               create buf_temp-diasize-handle .
      997               assign
      998                 buf_temp-diasize-handle.handle-value  = v-object-handle
      999                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1000               .
     1001             end.
     1002           end.
     1003           assign
     1004             v-object-handle = v-object-handle :next-sibling
     1005           .
     1006         end.
     1007         assign
     1008           v-field-group-handle = v-field-group-handle :next-sibling
     1009         .
     1010       end.
     1011       do with frame Dialog-Frame
     1012       :
     1013         hide v-diasize-resize-button .
     1014         assign
     1015           v-diasize-resize-button :row    = 1
     1016           v-diasize-resize-button :column = 1
     1017         .
     1018       end.
     1019       if p-change-value > 0
     1020       then do:
     1021         if frame Dialog-Frame :scrollable = true
     1022         then do:
     1023           assign
     1024             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1025             no-error .
     1026           if error-status :error
     1027           or error-status :get-message(1) <> ""
     1028           then do:
     1029             undo move_block, retry move_block .
     1030           end.
     1031         end.
     1032         assign
     1033           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1034           no-error .
     1035         if error-status :error
     1036         or error-status :get-message(1) <> ""
     1037         then do:
     1038           undo move_block, retry move_block .
     1039         end.
     1040         assign
     1041           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1042           no-error .
     1043         if error-status :error
     1044         or error-status :get-message(1) <> ""
     1045         then do:
     1046           undo move_block, retry move_block .
     1047         end.
     1048         for each buf_temp-browse-handle
     1049           where buf_temp-browse-handle.browse-type = 'height':u
     1050         on error undo move_block, retry move_block
     1051         :
     1052           assign
     1053             buf_temp-browse-handle.browse-handle :height
     1054               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1055             no-error .
     1056           if error-status :error
     1057           or error-status :get-message(1) <> ""
     1058           then do:
     1059             undo move_block, retry move_block .
     1060           end.
     1061         end.
     1062         for each buf_temp-diasize-handle
     1063         on error undo move_block, retry move_block
     1064         :
     1065           assign
     1066             v-object-handle = buf_temp-diasize-handle.handle-value
     1067           .
     1068           if v-object-handle <> v-diasize-resize-button
     1069           then do:
     1070             assign
     1071               v-object-handle :row = v-object-handle :row + p-change-value
     1072               no-error .
     1073             if error-status :error
     1074             or error-status :get-message(1) <> ""
     1075             then do:
     1076               undo move_block, retry move_block .
     1077             end.
     1078           end.
     1079         end.
     1080       end.
     1081       else do:
     1082         for each buf_temp-diasize-handle
     1083         on error undo move_block, retry move_block
     1084         :
     1085           assign
     1086             v-object-handle = buf_temp-diasize-handle.handle-value
     1087           .
     1088           if v-object-handle <> v-diasize-resize-button
     1089           then do:
     1090             assign
     1091               v-object-handle :row = v-object-handle :row + p-change-value
     1092               no-error .
     1093             if error-status :error
     1094             or error-status :get-message(1) <> ""
     1095             then do:
     1096               undo move_block, retry move_block .
     1097             end.
     1098           end.
     1099         end.
     1100         assign
     1101           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1102           no-error .
     1103         if error-status :error
     1104         or error-status :get-message(1) <> ""
     1105         then do:
     1106           undo move_block, retry move_block .
     1107         end.
     1108         for each buf_temp-browse-handle
     1109           where buf_temp-browse-handle.browse-type = 'height':u
     1110         on error undo move_block, retry move_block
     1111         :
     1112           assign
     1113             buf_temp-browse-handle.browse-handle :height
     1114               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1115             no-error .
     1116           if error-status :error
     1117           or error-status :get-message(1) <> ""
     1118           then do:
     1119             undo move_block, retry move_block .
     1120           end.
     1121         end.
     1122         assign
     1123           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1124           no-error .
     1125         if error-status :error
     1126         or error-status :get-message(1) <> ""
     1127         then do:
     1128           undo move_block, retry move_block .
     1129         end.
     1130         if frame Dialog-Frame :scrollable = true
     1131         then do:
     1132           assign
     1133             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1134             no-error .
     1135           if error-status :error
     1136           or error-status :get-message(1) <> ""
     1137           then do:
     1138             undo move_block, retry move_block .
     1139           end.
     1140         end.
     1141       end.
     1142       if p-move-resize = true
     1143       then do:
     1144         run diasize_position-resize-button in this-procedure .
     1145       end.
     1146       if v-diasize-wndstore = true
     1147       then do:
     1148         if connected("ub") = true
     1149         then do:
     1150           define variable v-cntxt-db-num        as integer   no-undo .
     1151           define variable v-cntxt-userid        as character no-undo .
     1152           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1153                                             , OUTPUT v-cntxt-userid
     1154                                             ) .
     1155           run gbl/wndsizew.p
     1156             (input  v-cntxt-db-num
     1157             ,input  v-cntxt-userid
     1158             ,input  v-diasize-proc-name
     1159             ,input  'height':u
     1160             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1161             ) .
     1162         end.
     1163       end.
     1164     end.
     1165     assign
     1166       v-diasize-change-size = false
     1167     .
     1168   end procedure.
     1169   procedure diasize_set-height :
     1170     define input  parameter p-new-height  as decimal   no-undo .
     1171     define input  parameter p-move-resize as logical   no-undo .
     1172     do
     1173     on error undo, return error return-value
     1174     :
     1175       run diasize_change-height in this-procedure
     1176         (input  (p-new-height - frame Dialog-Frame :height)
     1177         ,input  p-move-resize
     1178         ) .
     1179     end.
     1180   end procedure.
     1181   procedure diasize_change-width :
     1182     define input  parameter p-change-value as decimal   no-undo .
     1183     define input  parameter p-move-resize  as logical   no-undo .
     1184     define variable v-field-group-handle   as handle    no-undo .
     1185     define variable v-object-handle        as handle    no-undo .
     1186     define variable v-frame-width          as decimal   no-undo .
     1187     define variable v-frame-virtual-width  as decimal   no-undo .
     1188     define variable v-browse-width         as decimal   no-undo .
     1189     define variable v-window-width         as decimal   no-undo .
     1190     define variable v-window-virtual-width as decimal   no-undo .
     1191     define variable v-change-sign          as integer   no-undo .
     1192     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1193     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1194     if p-change-value > 0
     1195     then do:
     1196       if frame Dialog-Frame :width + p-change-value >
     1197           session :width-chars
     1198       then do:
     1199         assign
     1200           p-change-value = session :width-chars - frame Dialog-Frame :width
     1201         .
     1202         if p-change-value <= 0
     1203         then do:
     1204           run diasize_position-resize-button in this-procedure .
     1205           return .
     1206         end.
     1207       end.
     1208     end.
     1209     if p-change-value < 0
     1210     then do:
     1211       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1212       then do:
     1213         assign
     1214           p-change-value = v-diasize-orig-frame-width
     1215                          - frame Dialog-Frame :width
     1216         .
     1217         if p-change-value >= 0
     1218         then do:
     1219           run diasize_position-resize-button in this-procedure .
     1220           return .
     1221         end.
     1222       end.
     1223     end.
     1224     if p-change-value >= 0
     1225     then do:
     1226       assign
     1227         v-change-sign = 1
     1228       .
     1229     end.
     1230     else do:
     1231       assign
     1232         v-change-sign = -1
     1233       .
     1234     end.
     1235     assign
     1236       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1237     .
     1238     if p-change-value = 0
     1239     then do:
     1240       run diasize_position-resize-button in this-procedure .
     1241       return .
     1242     end.
     1243     move_block:
     1244     do
     1245     on error undo move_block, leave move_block
     1246     :
     1247       if retry
     1248       then do:
     1249         do
     1250         on error undo move_block, leave move_block
     1251         :
     1252           if p-change-value > 0
     1253           then do:
     1254             for each buf_temp-diasize-handle
     1255             on error undo, next
     1256             :
     1257               assign
     1258                 v-object-handle = buf_temp-diasize-handle.handle-value
     1259               .
     1260               if v-object-handle <> v-diasize-resize-button
     1261               then do:
     1262                 assign
     1263                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1264                 .
     1265               end.
     1266             end.
     1267             assign
     1268               v-diasize-browse-handle :width = v-browse-width
     1269             .
     1270             for each buf_temp-browse-handle
     1271               where buf_temp-browse-handle.browse-type = 'width':u
     1272             on error undo, next
     1273             :
     1274               assign
     1275                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1276               .
     1277             end.
     1278             assign
     1279               frame Dialog-Frame :width = v-frame-width
     1280             .
     1281             if frame Dialog-Frame :scrollable = true
     1282             then do:
     1283               assign
     1284                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1285               .
     1286             end.
     1287             run diasize_position-resize-button in this-procedure .
     1288           end.
     1289           else do:
     1290             if frame Dialog-Frame :scrollable = true
     1291             then do:
     1292               assign
     1293                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1294               .
     1295             end.
     1296             assign
     1297               frame Dialog-Frame :width = v-frame-width
     1298             .
     1299             for each buf_temp-browse-handle
     1300               where buf_temp-browse-handle.browse-type = 'width':u
     1301             on error undo, next
     1302             :
     1303               assign
     1304                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1305               .
     1306             end.
     1307             assign
     1308               v-diasize-browse-handle :width = v-browse-width
     1309             .
     1310             for each buf_temp-diasize-handle
     1311             on error undo, next
     1312             :
     1313               assign
     1314                 v-object-handle = buf_temp-diasize-handle.handle-value
     1315               .
     1316               if v-object-handle <> v-diasize-resize-button
     1317               then do:
     1318                 assign
     1319                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1320                 .
     1321               end.
     1322             end.
     1323             run diasize_position-resize-button in this-procedure .
     1324           end.
     1325           assign
     1326             v-diasize-change-size = false
     1327           .
     1328           leave move_block .
     1329         end.
     1330       end.
     1331       assign
     1332         v-diasize-need-full-display = true
     1333       .
     1334       if v-diasize-change-size = false
     1335       then do:
     1336         assign
     1337           v-diasize-change-size = true
     1338         .
     1339       end.
     1340       else do:
     1341         return .
     1342       end.
     1343       assign
     1344         v-frame-width = frame Dialog-Frame :width
     1345         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1346         v-browse-width = v-diasize-browse-handle :width
     1347       .
     1348       for each buf_temp-browse-handle
     1349         where buf_temp-browse-handle.browse-type = 'width':u
     1350       :
     1351         assign
     1352           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1353         .
     1354       end.
     1355       for each buf_temp-diasize-handle
     1356       :
     1357         delete buf_temp-diasize-handle .
     1358       end.
     1359       assign
     1360         v-field-group-handle = frame Dialog-Frame :first-child
     1361       .
     1362       do while valid-handle(v-field-group-handle)
     1363       :
     1364         assign
     1365           v-object-handle = v-field-group-handle :first-child
     1366         .
     1367         do while valid-handle(v-object-handle)
     1368         :
     1369           if  v-object-handle <> v-diasize-browse-handle :handle
     1370           and v-object-handle <> v-diasize-resize-button
     1371           and can-query(v-object-handle, "row")
     1372           and can-query(v-object-handle, "height")
     1373           and ( v-object-handle :col + v-object-handle :width
     1374                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1375               )
     1376           then do:
     1377             find first buf_temp-browse-handle
     1378               where buf_temp-browse-handle.browse-type   = 'width':u
     1379                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1380               no-error .
     1381             if available buf_temp-browse-handle
     1382             then do:
     1383             end.
     1384             else do:
     1385               create buf_temp-diasize-handle .
     1386               assign
     1387                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1388                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1389               .
     1390             end.
     1391           end.
     1392           assign
     1393             v-object-handle = v-object-handle :next-sibling
     1394           .
     1395         end.
     1396         assign
     1397           v-field-group-handle = v-field-group-handle :next-sibling
     1398         .
     1399       end.
     1400       do with frame Dialog-Frame
     1401       :
     1402         hide v-diasize-resize-button .
     1403         v-diasize-resize-button :row = 1.
     1404         v-diasize-resize-button :column = 1.
     1405       end.
     1406       if p-change-value > 0
     1407       then do:
     1408         if frame Dialog-Frame :scrollable = true
     1409         then do:
     1410           assign
     1411             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1412             no-error .
     1413           if error-status :error
     1414           or error-status :get-message(1) <> ""
     1415           then do:
     1416             undo move_block, retry move_block.
     1417           end.
     1418         end.
     1419         assign
     1420           frame Dialog-Frame :width = v-frame-width + p-change-value
     1421           no-error .
     1422         if error-status :error
     1423         or error-status :get-message(1) <> ""
     1424         then do:
     1425           undo move_block, retry move_block.
     1426         end.
     1427         assign
     1428           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1429         no-error .
     1430         if error-status :error
     1431         or error-status :get-message(1) <> ""
     1432         then do:
     1433           undo move_block, retry move_block.
     1434         end.
     1435         for each buf_temp-browse-handle
     1436           where buf_temp-browse-handle.browse-type = 'width':u
     1437         on error undo move_block, retry move_block
     1438         :
     1439           assign
     1440             buf_temp-browse-handle.browse-handle :width
     1441               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1442             no-error .
     1443           if error-status :error
     1444           or error-status :get-message(1) <> ""
     1445           then do:
     1446             undo move_block, retry move_block .
     1447           end.
     1448         end.
     1449         for each buf_temp-diasize-handle
     1450         on error undo move_block, retry move_block
     1451         :
     1452           assign
     1453             v-object-handle = buf_temp-diasize-handle.handle-value
     1454           .
     1455           if v-object-handle <> v-diasize-resize-button
     1456           then do:
     1457             assign
     1458               v-object-handle :col = v-object-handle :col + p-change-value
     1459               no-error .
     1460             if error-status :error
     1461             or error-status :get-message(1) <> ""
     1462             then do:
     1463               undo move_block, retry move_block .
     1464             end.
     1465           end.
     1466         end.
     1467       end.
     1468       else do:
     1469         for each buf_temp-diasize-handle
     1470         on error undo move_block, retry move_block
     1471         :
     1472           assign
     1473             v-object-handle = buf_temp-diasize-handle.handle-value
     1474           .
     1475           if v-object-handle <> v-diasize-resize-button
     1476           then do:
     1477             assign
     1478               v-object-handle :col = v-object-handle :col + p-change-value
     1479               no-error .
     1480             if error-status :error
     1481             or error-status :get-message(1) <> ""
     1482             then do:
     1483               undo move_block, retry move_block .
     1484             end.
     1485           end.
     1486         end.
     1487         for each buf_temp-browse-handle
     1488           where buf_temp-browse-handle.browse-type = 'width':u
     1489         on error undo move_block, retry move_block
     1490         :
     1491           assign
     1492             buf_temp-browse-handle.browse-handle :width
     1493               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1494             no-error .
     1495           if error-status :error
     1496           or error-status :get-message(1) <> ""
     1497           then do:
     1498             undo move_block, retry move_block .
     1499           end.
     1500         end.
     1501         assign
     1502           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1503           no-error .
     1504         if error-status :error
     1505         or error-status :get-message(1) <> ""
     1506         then do:
     1507           undo move_block, retry move_block.
     1508         end.
     1509         assign
     1510           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1511         no-error .
     1512         if error-status :error
     1513         or error-status :get-message(1) <> ""
     1514         then do:
     1515           undo move_block, retry move_block.
     1516         end.
     1517         if frame Dialog-Frame :scrollable = true
     1518         then do:
     1519           assign
     1520             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1521           no-error .
     1522           if error-status :error
     1523           or error-status :get-message(1) <> ""
     1524           then do:
     1525             undo move_block, retry move_block.
     1526           end.
     1527         end.
     1528       end.
     1529       if p-move-resize
     1530       then do:
     1531         run diasize_position-resize-button in this-procedure .
     1532       end.
     1533       if v-diasize-wndstore = true
     1534       then do:
     1535         if connected("ub") = true
     1536         then do:
     1537           define variable v-cntxt-db-num        as integer   no-undo .
     1538           define variable v-cntxt-userid        as character no-undo .
     1539           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1540                                             , OUTPUT v-cntxt-userid
     1541                                             ) .
     1542           run gbl/wndsizew.p
     1543             (input  v-cntxt-db-num
     1544             ,input  v-cntxt-userid
     1545             ,input  v-diasize-proc-name
     1546             ,input  'width':u
     1547             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1548             ) .
     1549         end.
     1550       end.
     1551     end.
     1552     assign
     1553       v-diasize-change-size = false
     1554     .
     1555   end procedure.
     1556   procedure diasize_set-width :
     1557     define input  parameter p-new-width  as decimal   no-undo .
     1558     define input  parameter p-move-resize as logical   no-undo .
     1559     do
     1560     on error undo, return error return-value
     1561     :
     1562       run diasize_change-width in this-procedure
     1563         (input  (p-new-width - frame Dialog-Frame :width)
     1564         ,input  p-move-resize
     1565         ) .
     1566     end.
     1567   end procedure.
     1568   procedure diasize_position-resize-button :
     1569     do with frame Dialog-Frame
     1570     :
     1571       hide v-diasize-resize-button .
     1572       assign
     1573         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1574                     - 1
     1575                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1576         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1577                     - 1
     1578                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1579       .
     1580       view v-diasize-resize-button .
     1581     end.
     1582   end procedure.
     1583   on alt-right anywhere
     1584   do:
     1585     run diasize_change-width in this-procedure
     1586       (input 1
     1587       ,input true
     1588       ) .
     1589     return no-apply .
     1590   end.
     1591   on alt-left anywhere
     1592   do:
     1593     run diasize_change-width in this-procedure
     1594       (input -1
     1595       ,input true
     1596       ) .
     1597     return no-apply .
     1598   end.
     1599   on alt-down anywhere
     1600   do:
     1601     run diasize_change-height in this-procedure
     1602       (input 1
     1603       ,input true
     1604       ) .
     1605     return no-apply .
     1606   end.
     1607   on alt-up anywhere
     1608   do:
     1609     run diasize_change-height in this-procedure
     1610       (input -1
     1611       ,input true
     1612       ) .
     1613     return no-apply .
     1614   end.
     1615   on alt-enter of frame Dialog-Frame
     1616   do:
     1617     run diasize_maximize in this-procedure
     1618       (input  ?
     1619       ).
     1620     return no-apply .
     1621   end.
     1622   procedure diasize_end-move :
     1623     do
     1624     on error undo, return error return-value
     1625     :
     1626       define variable v-row-delta as decimal   no-undo .
     1627       define variable v-col-delta as decimal   no-undo .
     1628       define variable v-new-row as decimal   no-undo .
     1629       define variable v-new-col as decimal   no-undo .
     1630       assign
     1631         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1632         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1633       .
     1634       assign
     1635         v-row-delta = v-new-row - frame Dialog-Frame :height
     1636         v-col-delta = v-new-col - frame Dialog-Frame :width
     1637       .
     1638       run diasize_change-height in this-procedure
     1639         (input v-row-delta
     1640         ,input true
     1641         ) .
     1642       run diasize_change-width in this-procedure
     1643         (input v-col-delta
     1644         ,input true
     1645         ) .
     1646     end.
     1647   end procedure.
     1648   procedure diasize_maximize :
     1649     define input  parameter p-action as logical   no-undo .
     1650     do
     1651     on error undo, return error return-value
     1652     :
     1653       if p-action = ?
     1654       then do:
     1655         if v-diasize-need-maximize = true
     1656         then do:
     1657           assign
     1658             p-action = true
     1659           .
     1660         end.
     1661         else do:
     1662           assign
     1663             p-action = false
     1664           .
     1665         end.
     1666       end.
     1667       if p-action = true
     1668       then do:
     1669         run diasize_change-height in this-procedure
     1670           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1671               - frame Dialog-Frame :height-chars
     1672           ,input true
     1673           ) .
     1674         run diasize_change-width in this-procedure
     1675           (input session :width-chars
     1676               - frame Dialog-Frame :width-chars
     1677           ,input true
     1678           ) .
     1679         assign
     1680           v-diasize-need-maximize = false
     1681         .
     1682       end.
     1683       else do:
     1684         run diasize_change-width in this-procedure
     1685           (input v-diasize-orig-frame-width
     1686               - frame Dialog-Frame :width-chars
     1687           ,input true
     1688           ) .
     1689         run diasize_change-height in this-procedure
     1690           (input v-diasize-orig-frame-height
     1691               - frame Dialog-Frame :height-chars
     1692           ,input true
     1693           ) .
     1694         assign
     1695           v-diasize-need-maximize = true
     1696         .
     1697       end.
     1698     end.
     1699   end procedure.
     1700   procedure diasize_restore-orig-size :
     1701     do
     1702     on error undo, return error return-value
     1703     :
     1704       assign
     1705         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1706         v-diasize-current-frame-height = frame Dialog-Frame :height
     1707       .
     1708       run diasize_set-height in this-procedure
     1709         (input  v-diasize-orig-frame-height
     1710         ,input  true
     1711         ) .
     1712       run diasize_set-width in this-procedure
     1713         (input  v-diasize-orig-frame-width
     1714         ,input  true
     1715         ) .
     1716     end.
     1717   end procedure.
     1718   procedure diasize_restore-current-size :
     1719     do
     1720     on error undo, return error return-value
     1721     :
     1722       run diasize_set-height in this-procedure
     1723         (input  v-diasize-current-frame-height
     1724         ,input  true
     1725         ) .
     1726       run diasize_set-width in this-procedure
     1727         (input  v-diasize-current-frame-width
     1728         ,input  true
     1729         ) .
     1730     end.
     1731   end procedure.
     1732   procedure diasize_set-browse-handle :
     1733     define input  parameter p-browse-handle as handle   no-undo .
     1734     define buffer buf_temp-browse-handle for temp-browse-handle .
     1735     do
     1736     on error undo, return error return-value
     1737     :
     1738       assign
     1739         v-diasize-browse-handle = p-browse-handle
     1740       .
     1741       for each buf_temp-browse-handle
     1742       on error undo, return error return-value
     1743       :
     1744         delete buf_temp-browse-handle .
     1745       end.
     1746     end.
     1747   end procedure.
     1748   procedure diasize_add_browse :
     1749     define input  parameter p-browse-type   as character no-undo .
     1750     define input  parameter p-browse-handle as handle    no-undo .
     1751     define buffer buf_temp-browse-handle for temp-browse-handle .
     1752     do
     1753     on error undo, return error return-value
     1754     :
     1755       assign
     1756         v-diasize-browse-number = v-diasize-browse-number + 1
     1757       .
     1758       create buf_temp-browse-handle .
     1759       assign
     1760         buf_temp-browse-handle.browse-type   = p-browse-type
     1761         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1762         buf_temp-browse-handle.browse-handle = p-browse-handle
     1763       .
     1764     end.
     1765   end procedure.
     1766   procedure diasize_init :
     1767     define variable v-default-value    as logical   no-undo .
     1768     define variable v-restore-saved    as logical   no-undo .
     1769     define variable v-resize-value-str as character no-undo .
     1770     do
     1771     on error undo, return error return-value
     1772     :
     1773       do with frame Dialog-Frame
     1774       :
     1775         assign
     1776           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1777           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1778           v-diasize-browse-handle     = browse BR-firm :handle
     1779         .
     1780         create button v-diasize-resize-button
     1781         assign
     1782           parent        = frame Dialog-Frame :first-child
     1783           label         = "s"
     1784           height-pixels = 16
     1785           width-pixels  = 16
     1786           visible       = true
     1787           sensitive     = true
     1788           movable       = true
     1789           triggers:
     1790             on end-move persistent run diasize_end-move in this-procedure .
     1791           end triggers.
     1792         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1793         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1794         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1795         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1796         assign
     1797           v-diasize-wndmax = false
     1798         .
     1799         if connected("ub") = true
     1800         then do:
     1801           define variable v-cntxt-db-num        as integer   no-undo .
     1802           define variable v-cntxt-userid        as character no-undo .
     1803           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1804                                             , OUTPUT v-cntxt-userid
     1805                                             ) .
     1806           run gbl/wndpar_r.p
     1807             (input  v-cntxt-db-num
     1808             ,input  v-cntxt-userid
     1809             ,input  'wndmax':U
     1810             ,output v-diasize-wndmax
     1811             ,output v-default-value
     1812             ) .
     1813         end.
     1814         assign
     1815           v-diasize-wndstore = false
     1816         .
     1817         if connected("ub") = true
     1818         then do:
     1819           run gbl/wndpar_r.p
     1820             (input  v-cntxt-db-num
     1821             ,input  v-cntxt-userid
     1822             ,input  'wndstore':U
     1823             ,output v-diasize-wndstore
     1824             ,output v-default-value
     1825             ) .
     1826         end.
     1827         assign
     1828           v-diasize-proc-name = entry(1, program-name(2), '.')
     1829         .
     1830         if v-diasize-wndstore = true
     1831         then do:
     1832           assign
     1833             v-restore-saved = false
     1834           .
     1835           if connected("ub") = true
     1836           then do:
     1837             run gbl/wndsizer.p
     1838               (input  v-cntxt-db-num
     1839               ,input  v-cntxt-userid
     1840               ,input  v-diasize-proc-name
     1841               ,input  'height':u
     1842               ,output v-resize-value-str
     1843               ) .
     1844             if v-resize-value-str <> '':U
     1845             then do:
     1846               run diasize_change-height in this-procedure
     1847                 (input  integer(v-resize-value-str)
     1848                 ,input  true
     1849                 ) .
     1850               assign
     1851                 v-restore-saved = true
     1852               .
     1853             end.
     1854           end.
     1855           if connected("ub") = true
     1856           then do:
     1857             run gbl/wndsizer.p
     1858               (input  v-cntxt-db-num
     1859               ,input  v-cntxt-userid
     1860               ,input  v-diasize-proc-name
     1861               ,input  'width':u
     1862               ,output v-resize-value-str
     1863               ) .
     1864             if v-resize-value-str <> '':U
     1865             then do:
     1866               run diasize_change-width in this-procedure
     1867                 (input  integer(v-resize-value-str)
     1868                 ,input  true
     1869                 ) .
     1870               assign
     1871                 v-restore-saved = true
     1872               .
     1873             end.
     1874           end.
     1875           if v-restore-saved <> true
     1876           then do:
     1877             if v-diasize-wndmax = true
     1878             then do:
     1879               run diasize_maximize in this-procedure
     1880                 (input  true
     1881                 ) .
     1882             end.
     1883           end.
     1884         end.
     1885         else do:
     1886           if v-diasize-wndmax = true
     1887           then do:
     1888             run diasize_maximize in this-procedure
     1889               (input  true
     1890               ) .
     1891           end.
     1892         end.
     1893       end.
     1894     end.
     1895   end procedure.
     1896   procedure diasize_need-full-display :
     1897     define output parameter p-need-full-display as logical   no-undo .
     1898     do
     1899     on error undo, return error return-value
     1900     :
     1901       assign
     1902         p-need-full-display = v-diasize-need-full-display
     1903       .
     1904       assign
     1905         v-diasize-need-full-display = false
     1906       .
     1907     end.
     1908   end procedure.
     1909   procedure get-context :
     1910      define output parameter p-db-num as integer          no-undo.
     1911      define output parameter p-user-id as character        no-undo.
     1912      define variable v-login               as character    no-undo.
     1913      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1914      define buffer buf_user-login  for ub.user-login .
     1915      do
     1916      on error undo, return error
     1917      :
     1918            FIND FIRST buf_sys-ctrl no-lock.
     1919            ASSIGN
     1920               v-login = USERID("ub")
     1921               p-db-num = buf_sys-ctrl.db-num
     1922            .
     1923            FIND FIRST buf_user-login
     1924                 WHERE buf_user-login.db-num = p-db-num
     1925                   AND buf_user-login.user-login = v-login
     1926                 no-lock
     1927                 no-error
     1928                 .
     1929            IF AVAILABLE buf_user-login
     1930            THEN DO:
     1931               assign
     1932                  p-user-id = buf_user-login.user-id
     1933               .
     1934            END.
     1935      end.
     1936   end procedure.
     1937       run diasize_init in this-procedure .
     1938   MAIN-BLOCK:
     1939   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1940      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1941     RUN fill-conf-import IN THIS-PROCEDURE.
     1942     RUN Myenable IN THIS-PROCEDURE.
     1943     WAIT-FOR GO OF FRAME Dialog-Frame.
     1944   END.
     1945   RUN disable_UI.
     1946   PROCEDURE disable_UI :
     1947     HIDE FRAME Dialog-Frame.
     1948   END PROCEDURE.
     1949   PROCEDURE enable_UI :
     1950     DISPLAY file-name delim EDITOR-1 Rs-uniq-method cli-grp-name
     1951         WITH FRAME Dialog-Frame.
     1952     ENABLE b-exit RECT-7 B-quit B-help B-cli-grp file-name B-file b-up-firm
     1953            b-down-firm b-up-person b-down-person BR-firm BR-person delim EDITOR-1
     1954            Rs-uniq-method cli-grp-name
     1955         WITH FRAME Dialog-Frame.
     1956     VIEW FRAME Dialog-Frame.
     1957     OPEN QUERY BR-firm FOR EACH firm_conf-import WHERE firm_conf-import.subject = 'firm':U.    OPEN QUERY BR-person FOR EACH person_conf-import WHERE person_conf-import.subject = 'person':U.
     1958   END PROCEDURE.
     1959   PROCEDURE fill-conf-import :
     1960   DEFINE VARIABLE v-position-firm AS INTEGER NO-UNDO.
     1961   DEFINE VARIABLE v-position-person AS INTEGER NO-UNDO.
