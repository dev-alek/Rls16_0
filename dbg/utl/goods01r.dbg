      135   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   define  shared  temp-table gds-list-hist no-undo
      137   field list-table as character
      138   field id as integer
      139   field line as integer
      140   field hist-mode as character
      141   field des as character
      142   field num-recs as integer
      143   field option_ as character
      144   field item_ as character
      145   field status_ as character
      146   field num-add as integer
      147   field num-ignored as integer
      148   field done as logical
      149   field err_ as logical
      150   field err-mes as character
