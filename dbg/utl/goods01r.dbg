     2570     , input (if v-do[1] then p-gds-name else  buf_goods.gds-name)
     2571     , input "":U
     2572     , input (if v-do[2] then p-engl-name else  buf_goods.engl-name)
     2573     , input (if v-do[3] then p-label-name else  buf_goods.label-name)
     2574     , input (if v-do[4] then p-chk-name else  buf_goods.chk-name)
     2575     , input (if v-do[5] then p-alpha1 else  buf_goods.alpha1)
     2576     , input buf_goods.unit-base
     2577     , input (if v-do[6] then p-unit-cli else  buf_goods.unit-cli)
     2578     , input (IF v-do[7] AND LOOKUP('2ед':U, buf_units.type) > 0
     2579             then p-max-rate
     2580             else buf_goods.max-rate)
     2581     , input (IF v-do[8] AND LOOKUP('2ед':U, buf_units.type) > 0
     2582             then p-min-rate
     2583             else buf_goods.min-rate)
     2584     , input (IF v-do[9] then p-cli-base-rate else buf_goods.cli-base-rate)
     2585     , input (IF v-do[10] then p-qnty-cart else buf_goods.qnty-cart)
     2586     , input (IF v-do[11]  then p-ms-base else buf_goods.ms-base)
     2587     , input (IF v-do[12]  then p-wt-base else buf_goods.wt-base)
     2588     , input (IF v-do[13] then p-ms-cart else buf_goods.ms-cart)
     2589     , input (IF v-do[14] then p-wt-cart else buf_goods.wt-cart)
     2590     , input (IF v-do[15] then p-calc-method else buf_goods.calc-method)
     2591     , input (IF v-do[16] then p-increase-pc else buf_goods.increase-pc)
     2592     , input (IF v-do[17] then p-negative-rest else buf_goods.negative-rest)
     2593     , input (if buf_goods.gds-type = 'у':U and available buf_gds-obj
     2594              then buf_gds-obj.price-base
     2595              else 0)
     2596     , input (if buf_goods.gds-type = 'у':U and available buf_gds-obj
     2597              then  buf_gds-obj.price-rubl
     2598              else 0)
     2599     , input (IF v-do[18] then p-okdp else buf_goods.okdp)
     2600     , input (IF v-do[19] then p-destin else buf_goods.destin)
     2601     , input (IF v-do[20] then p-attrib else buf_goods.attrib)
     2602     , input (IF v-do[21] then p-user-rule else buf_goods.user-rule)
     2603     , input (IF v-do[22]  then p-sert else buf_goods.sert)
     2604     , input (IF v-do[23] then p-struct else buf_goods.struct)
     2605     , input (IF v-do[24] then p-deadline else buf_goods.deadline)
     2606     , input (IF v-do[25] then p-cond-keep-code else buf_goods.cond-keep-code)
     2607     , input (IF v-do[26] then p-sort else buf_goods.sort)
     2608     , input (IF v-do[27] then p-proof else buf_goods.proof)
     2609     , input (IF v-do[28] then p-normal-wastage else buf_goods.normal-wastage)
     2610     , input (IF v-do[29] then p-normal-waste else buf_goods.normal-waste)
     2611     , input (IF v-do[30]  then p-tnved else buf_goods.tnved)
     2612     , input (IF v-do[31] then p-nationality else buf_goods.nationality)
     2613     , input (IF v-do[32] then p-unit-cst else buf_goods.unit-cst)
     2614     , input (IF v-do[33] then p-cst-base-rate else buf_goods.cst-base-rate)
     2615     , input (if v-do[34] then p-fbr-grp-code else buf_goods.fbr-grp-code)
     2616     , input (IF v-do[35] then p-PS else buf_goods.PS)
     2617       , input no
     2618     , input is-jwlr
     2619     , input is-bttl
     2620     , input is-ptrl
     2621     , input custvalue
     2622     , input no
     2623     , input no
     2624     , input no
     2625     , input 0
     2626     , input-output v-gds-rec
     2627     , output v-nbc
     2628                       ) no-error .
     2629     if error-status:error then do:
     2630       assign
     2631       v-main-error = yes.
     2632       run write-log-and-file in p-log-handle (
     2633             input 1
     2634           , input log-file-name
     2635           , input 1
     2636           , input substitute("Ошибка изменения записи товара с кодом &1:&2&3 &4"
     2637                             , gds-list.gds-code
     2638                             , chr(10)
     2639                             , error-status:get-message(1)
     2640                             , return-value
     2641                             ) ).
     2642       assign
     2643       v-view-log = yes.
     2644     end.
     2645     if not v-main-error then do:
     2646      IF v-do[36] then do:
     2647         v-stts = (if p-stts then 1 else 0).
     2648         run ref/goods02.p (
     2649                          input recid(buf_goods)
     2650                         ,input yes
     2651                         ,input-output v-stts) no-error.
     2652         if error-status:error then do:
     2653           run write-log-and-file in p-log-handle (
     2654                 input 1
     2655               , input log-file-name
     2656               , input 1
     2657               , input substitute("Ошибка изменения статуса товара с кодом &1:&2&3 &4"
     2658                                 , gds-list.gds-code
     2659                                 , chr(10)
     2660                                 , error-status:get-message(1)
     2661                                 , return-value
     2662                                 ) ).
     2663           assign
     2664           v-view-log = yes.
     2665         end.
     2666       end.
     2667     end.
     2668     IF v-main-error then do:
     2669       message
     2670       substitute("Не удалось изменить товар с кодом &1&2" +
     2671                  "&3 &4&5 - &6&2" +
     2672                  "Продолжить изменение товаров по списку?"
     2673                 ,buf_goods.gds-code
     2674                 , chr(10)
     2675                 ,buf_goods.artic
     2676                 ,buf_goods.prod-type
     2677                 ,buf_goods.prod-code)
     2678      view-as alert-box ERROR buttons YES-NO update glog.
     2679      if not glog then do:
     2680        IF num-rec > num-rec-ok then do:
     2681           run write-log-and-file in p-log-handle (
     2682                 input 1
     2683               , input log-file-name
     2684               , input 1
     2685               , input substitute("Из выбранных &1 товаров удалось отредактировать &2"
     2686                                 , num-rec
     2687                                 , num-rec-ok
     2688                                 ) ).
     2689           return.
     2690        end.
     2691      end.
     2692     end.
     2693     else num-rec-ok = num-rec-ok + 1.
     2694     run show-counter in p-log-handle .
     2695     run write-counter in p-log-handle (substitute("Обработано &1 из них успешно &2"
     2696                                                 , num-rec
     2697                                                 , num-rec-ok
     2698                                                 )) no-error.
     2699     run get-stop-state in p-log-handle (
     2700         output v-stop
     2701     ).
     2702     if v-stop then do:
     2703       leave _gds-list.
     2704     end.
     2705   end.
     2706   IF num-rec > num-rec-ok then do:
     2707     run write-log-and-file in p-log-handle (
     2708           input 1
     2709         , input log-file-name
     2710         , input 1
     2711         , input substitute("&3&4Из выбранных &1 товаров удалось отредактировать &2&4Информация находится в файле &5.txt"
     2712                           , num-rec
     2713                           , num-rec-ok
     2714                           , (if v-stop then "Процесс прерван пользователем" else "":U)
     2715                           , chr(10)
     2716                           , v-call-point
     2717                           ) ).
     2718   end.
     2719   else do:
     2720           run write-log-and-file in p-log-handle (
     2721                 input 1
     2722               , input log-file-name
     2723               , input 1
     2724               , input substitute("&1&2Пакетное изменение по списку товаров прошло"
     2725                               , (if v-stop then "Процесс прерван пользователем" else "":U)
     2726                               , chr(10)
     2727                                 ) ).
     2728   end.
