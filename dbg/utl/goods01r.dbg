      156   .
      157     define shared temp-table  tt-tax no-undo
      158   field tax-code    like ub.tax.tax-code
      159   FIELD individual  like ub.tax.individual
      160   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      161   field rate-code   like ub.tax-rate.rate-code
      162   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      163   FIELD tax-type    like ub.tax.tax-type
      164   field rate-value  like ub.tax-rate-value.rate-value
      165   FIELD tax-rate-gds-rc  as recid
      166   FIELD to-cashdesk like ub.tax.to-cashdesk
      167   FIELD fact-date like ub.tax-rate-value.fact-date
      168   FIELD fact-order like ub.tax-rate-value.fact-order
      169   FIELD next-order like ub.tax-rate-value.fact-order
      170   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      171   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      172   FIELD corr-date like ub.tax-rate-gds.corr-date
