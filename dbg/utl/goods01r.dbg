      866   procedure grplib-get-sort-name :
      867   do
      868   on error undo, return error
      869   :
      870   define input parameter p-node-code  as integer      no-undo.
      871   define output parameter p-sort-name as character    no-undo.
      872       define variable v-upper-code    as integer           no-undo.
      873       define buffer buf_gds-grp       for ub.gds-grp.
      874       define buffer buf_upper_gds-grp for ub.gds-grp.
      875       find first buf_gds-grp no-lock
      876            where buf_gds-grp.node-code = p-node-code
      877       no-error.
      878       if not available buf_gds-grp
      879       then do:
      880           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      881       end.
      882       assign
      883           p-sort-name  = ""
      884           v-upper-code = 1
      885       .
      886       do while buf_gds-grp.upper-code <> 0
      887       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      888       :
      889           assign
      890               p-sort-name  = buf_gds-grp.node-name
      891                            + (if p-sort-name <> "" then chr(2) else "")
      892                            + p-sort-name
      893               v-upper-code = buf_gds-grp.upper-code
      894           .
      895           find first buf_gds-grp no-lock
      896                where buf_gds-grp.node-code = v-upper-code
      897           no-error.
      898           if not available buf_gds-grp
      899           then do:
      900               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      901                                   + string( v-upper-code )
      902                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      903           end.
      904       end.
      905   end.
      906   end procedure.
      907   define variable vss-include-info7 as character format "X(65)" no-undo
      908   initial "@(#)$Workfile$ $Revision$".
      909   procedure grplib-get-full-name :
      910      define input parameter p-node-code  as integer      no-undo.
      911      define output parameter p-full-name as character    no-undo.
      912      do
      913   on error undo, return error
      914   :
      915       define variable v-upper-code    as integer           no-undo.
      916       define buffer buf_gds-grp       for ub.gds-grp.
      917       define buffer buf_upper_gds-grp for ub.gds-grp.
      918       find first buf_gds-grp no-lock
      919            where buf_gds-grp.node-code = p-node-code
      920       no-error.
      921       if not available buf_gds-grp
      922       then do:
      923           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      924       end.
      925       assign
      926           p-full-name  = ""
      927           v-upper-code = 1
      928       .
      929       do while buf_gds-grp.upper-code <> 0
      930       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      931       :
      932           assign
      933               p-full-name  = buf_gds-grp.node-name
      934                            + (if p-full-name <> "" then chr(47) else "")
      935                            + p-full-name
      936               v-upper-code = buf_gds-grp.upper-code
      937           .
      938           find first buf_gds-grp no-lock
      939                where buf_gds-grp.node-code = v-upper-code
      940           no-error.
      941           if not available buf_gds-grp
      942           then do:
      943               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      944                                   + string( v-upper-code )
      945                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      946           end.
      947       end.
      948       assign
      949       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      950       .
      951   end.
      952   end .
      953   procedure grplib-get-node-from-full-name :
      954   define input parameter p-full-name as character no-undo .
      955   define output parameter p-node-code as integer no-undo .
      956   define variable v-ii as integer no-undo .
      957   define variable v-upper-code as integer no-undo .
      958   define variable v-root-code as integer no-undo .
      959   define variable v-entry as character no-undo .
      960   define buffer buf_gds-grp       for ub.gds-grp.
      961   do
      962   on error undo, return error
      963   :
      964     find first buf_gds-grp no-lock
      965         where buf_gds-grp.upper-code = 0
      966     no-error .
      967     if not available buf_gds-grp
      968     then do:
      969         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      970     end.
      971     else do:
      972       assign
      973       v-root-code = buf_gds-grp.node-code
      974       .
      975     end.
      976     v-upper-code = v-root-code.
      977     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      978       assign
      979       v-entry = entry(v-ii, p-full-name, chr(47)).
      980       if v-entry = '' then leave.
      981       find first buf_gds-grp no-lock where
      982                 buf_gds-grp.node-name = v-entry
      983             and buf_gds-grp.upper-code = v-upper-code
      984             no-error.
      985       if not available buf_gds-grp then do:
      986         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      987       end.
      988       else do:
      989         p-node-code = buf_gds-grp.node-code.
      990         v-upper-code = buf_gds-grp.node-code.
      991       end.
      992     end.
      993   end.
      994   end .
      995   procedure grplib-get-root-code :
      996   do
      997   on error undo, return error
      998   :
      999   define output parameter p-root-code as integer      no-undo.
     1000       define buffer buf_gds-grp       for ub.gds-grp.
     1001       find first buf_gds-grp no-lock
     1002           where buf_gds-grp.upper-code = 0
     1003       no-error .
     1004       if not available buf_gds-grp
     1005       then do:
     1006           undo, return error .
     1007       end.
     1008       else do:
     1009           assign
     1010               p-root-code = buf_gds-grp.node-code
     1011           .
     1012       end.
     1013   end.
     1014   end procedure.
     1015   procedure grplib-find-grp-by-full-name :
     1016   do
     1017   on error undo, return error
     1018   :
     1019   define input parameter p-search-name  as character    no-undo.
     1020   define input parameter p-fill-path    as logical      no-undo.
     1021   define output parameter p-found       as logical      no-undo.
     1022       define variable v-upper-code    as integer          no-undo.
     1023       define variable v-counter       as integer           no-undo.
     1024       define variable v-level         as integer           no-undo.
     1025       define variable v-full-name     as character         no-undo.
     1026       define variable v-sort-name     as character         no-undo.
     1027       define buffer buf_gds-grp       for ub.gds-grp.
     1028       assign
     1029           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1030       .
     1031       run grplib-get-root-code ( output v-upper-code ) no-error .
     1032       if error-status :error
     1033       then do:
     1034           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1035       end.
     1036       assign
     1037           v-full-name  = ""
     1038           v-level      = num-entries( p-search-name, chr(2) )
     1039       .
     1040       for each temp_grplib_found-grp
     1041       :
     1042           delete temp_grplib_found-grp.
     1043       end.
     1044       start-name-analyze:
     1045       do v-counter = 1 to v-level
     1046       :
     1047           if v-counter < v-level
     1048           then do:
     1049               find first buf_gds-grp no-lock
     1050                    where buf_gds-grp.upper-code = v-upper-code
     1051                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1052               no-error .
     1053               if not available buf_gds-grp
     1054               then do:
     1055                   assign
     1056                       v-full-name  = p-search-name
     1057                       v-sort-name  = p-search-name
     1058                   .
     1059                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1060               end.
     1061               else do:
     1062                   assign
     1063                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1064                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1065                       v-upper-code = buf_gds-grp.node-code
     1066                   .
     1067                   if p-fill-path = yes
     1068                   then do:
     1069                       create temp_grplib_found-grp.
     1070                       assign
     1071                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1072                           temp_grplib_found-grp.sort-name = v-sort-name
     1073                           temp_grplib_found-grp.node-code = v-upper-code
     1074                           temp_grplib_found-grp.level     = v-counter
     1075                       .
     1076                   end.
     1077               end.
     1078           end.
     1079           else do:
     1080               for each buf_gds-grp no-lock
     1081                  where buf_gds-grp.upper-code = v-upper-code
     1082                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1083               :
     1084                   assign
     1085                       p-found = yes
     1086                   .
     1087                   create temp_grplib_found-grp.
     1088                   assign
     1089                       temp_grplib_found-grp.full-name = v-full-name
     1090                                                           + (if v-full-name = "" then "" else chr(47) )
     1091                                                           + buf_gds-grp.node-name + chr(47)
     1092                       temp_grplib_found-grp.sort-name = v-sort-name
     1093                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1094                                                           + buf_gds-grp.node-name
     1095                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1096                       temp_grplib_found-grp.level     = v-level
     1097                   .
     1098               end.
     1099               if p-found = no
     1100               then do:
     1101                   assign
     1102                       v-full-name  = p-search-name
     1103                       v-sort-name  = p-search-name
     1104                   .
     1105                   for each temp_grplib_found-grp
     1106                   :
     1107                       delete temp_grplib_found-grp.
     1108                   end.
     1109                   assign
     1110                       p-found = no
     1111                   .
     1112               end.
     1113           end.
     1114       end.
     1115   end.
     1116   end procedure.
     1117   procedure grplib-find-all-subgroup :
     1118   do
     1119   on error undo, return error
     1120   :
     1121   define input parameter p-start-node-code    as integer      no-undo.
     1122   define input parameter p-terminal-only      as logical      no-undo.
     1123       define variable v-start-full-name   as character     no-undo.
     1124       define variable v-start-sort-name   as character     no-undo.
     1125       define variable v-not-found         as logical       no-undo.
     1126       define variable v-is-terminal       as logical       no-undo.
     1127       define buffer buf_gds-grp           for ub.gds-grp.
     1128       create temp_found-result-nodelist.
     1129       assign
     1130           temp_found-result-nodelist.node-code = p-start-node-code
     1131           temp_found-result-nodelist.processed = no
     1132       .
     1133       run grplib-get-full-name in this-procedure (
     1134             input p-start-node-code
     1135           , output v-start-full-name
     1136       ).
     1137       run grplib-get-full-name in this-procedure (
     1138             input p-start-node-code
     1139           , output v-start-sort-name
     1140       ).
     1141       process-nodes:
     1142       do while yes
     1143       :
     1144           find first temp_found-result-nodelist
     1145                where temp_found-result-nodelist.node-code = p-start-node-code
     1146           .
     1147           assign
     1148               temp_found-result-nodelist.processed = yes
     1149           .
     1150           for each buf_gds-grp no-lock
     1151              where buf_gds-grp.upper-code = p-start-node-code
     1152           on error undo, return error
     1153           :
     1154               run grplib-is-terminal in this-procedure (
     1155                     input buf_gds-grp.node-code
     1156                   , output v-is-terminal
     1157               ).
     1158               if v-is-terminal = yes
     1159               then do:
     1160                   create temp_grplib_found-grp.
     1161                   assign
     1162                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1163                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1164                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1165                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1166                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1167                       temp_grplib_found-grp.is-terminal = yes
     1168                   .
     1169               end.
     1170               else do:
     1171                   create temp_found-result-nodelist.
     1172                   assign
     1173                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1174                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1175                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1176                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1177                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1178                       temp_found-result-nodelist.processed = no
     1179                   .
     1180                   if p-terminal-only = no
     1181                   then do:
     1182                       create temp_grplib_found-grp.
     1183                       assign
     1184                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1185                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1186                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1187                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1188                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1189                           temp_grplib_found-grp.is-terminal = no
     1190                       .
     1191                   end.
     1192               end.
     1193           end.
     1194           find first temp_found-result-nodelist
     1195                where temp_found-result-nodelist.processed = no
     1196           no-error.
     1197           if not available temp_found-result-nodelist
     1198           then do:
     1199               leave process-nodes.
     1200           end.
     1201           else do:
     1202               assign
     1203                   p-start-node-code = temp_found-result-nodelist.node-code
     1204                   v-start-full-name = temp_found-result-nodelist.full-name
     1205                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1206               .
     1207           end.
     1208       end.
     1209   end.
     1210   end procedure.
     1211   procedure grplib-expand-name :
     1212   define input parameter p-start-name as character        no-undo.
     1213   define output parameter p-end-name  as character        no-undo.
     1214       define variable v-is-terminal   as logical      no-undo.
     1215       define variable v-found         as character    no-undo.
     1216       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1217   do
     1218   for buf_temp_grplib_found-grp
     1219   on error undo, return error
     1220   :
     1221       run grplib-find-grp-by-full-name in this-procedure (
     1222             input p-start-name
     1223           , input no
     1224           , output v-found
     1225       ) no-error.
     1226       run grplib-get-max-substring in this-procedure (
     1227                   input length( p-start-name )
     1228                 , output p-end-name
     1229       ) no-error .
     1230       if error-status :error
     1231       then do:
     1232           assign
     1233               p-end-name = ""
     1234           .
     1235       end.
     1236       else do:
     1237           find first temp_grplib_found-grp
     1238               where temp_grplib_found-grp.full-name = p-end-name
     1239           no-error.
     1240           if available temp_grplib_found-grp
     1241           then do:
     1242               find first buf_temp_grplib_found-grp
     1243                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1244                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1245               no-error.
     1246               if not available buf_temp_grplib_found-grp
     1247               then do:
     1248                   run grplib-is-terminal in this-procedure (
     1249                       input temp_grplib_found-grp.node-code
     1250                       , output v-is-terminal
     1251                   ).
     1252               end.
     1253           end.
     1254       end.
     1255   end.
     1256   end procedure.
     1257   procedure grplib-get-max-substring :
     1258   do
     1259   on error undo, return error
     1260   :
     1261   define input parameter p-min-substring-length   as integer      no-undo.
     1262   define output parameter p-substring             as character    no-undo.
     1263           define variable v-char-counter  as integer           no-undo.
     1264           define variable v-current-char  as character         no-undo.
     1265           define variable v-names-counter  as integer           no-undo.
     1266           define variable v-base-string   as character         no-undo.
     1267           assign
     1268               v-char-counter  = p-min-substring-length
     1269           .
     1270           find first temp_grplib_found-grp no-error.
     1271           if not available temp_grplib_found-grp
     1272           then do:
     1273               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1274           end.
     1275           else do:
     1276               assign
     1277                   v-base-string  = temp_grplib_found-grp.full-name
     1278                   v-char-counter = 0
     1279               .
     1280               counter-block:
     1281               do while yes
     1282               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1283               :
     1284                   assign
     1285                       v-char-counter  = v-char-counter + 1
     1286                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1287                       v-names-counter = 0
     1288                   .
     1289                   compare-block:
     1290                   for each temp_grplib_found-grp
     1291                   :
     1292                       assign
     1293                           v-names-counter = v-names-counter + 1
     1294                       .
     1295                       if v-names-counter = 1
     1296                       then do:
     1297                           next compare-block.
     1298                       end.
     1299                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1300                       then do:
     1301                           leave counter-block.
     1302                       end.
     1303                   end.
     1304                   if v-names-counter = 1
     1305                   then do:
     1306                       assign
     1307                           p-substring = v-base-string
     1308                       .
     1309                       return.
     1310                   end.
     1311               end.
     1312               assign
     1313                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1314               .
     1315           end.
     1316   end.
     1317   end procedure.
     1318   procedure grplib-is-terminal :
     1319   do
     1320   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1321   :
     1322   define input parameter p-node-code      as integer      no-undo.
     1323   define output parameter p-is-terminal   as logical      no-undo.
     1324       define buffer buf_gds-grp       for ub.gds-grp.
     1325       find first buf_gds-grp no-lock
     1326           where buf_gds-grp.upper-code = p-node-code
     1327       no-error .
     1328       if not available buf_gds-grp
     1329       then do:
     1330           assign
     1331               p-is-terminal = yes
     1332           .
     1333       end.
     1334       else do:
     1335           assign
     1336               p-is-terminal = no
     1337           .
     1338       end.
     1339   end.
     1340   end procedure.
     1341   procedure grplib-have-goods :
     1342   do
     1343   on error undo, return error
     1344   :
     1345   define input parameter p-node-code      as integer      no-undo.
     1346   define output parameter p-have-goods   as logical      no-undo.
     1347       define buffer buf_goods         for ub.goods.
     1348       find first buf_goods no-lock
     1349            where buf_goods.grp-code = p-node-code
     1350       no-error .
     1351       if available buf_goods
     1352       then do:
     1353           assign
     1354               p-have-goods = yes
     1355           .
     1356       end.
     1357       else do:
     1358           assign
     1359               p-have-goods = no
     1360           .
     1361       end.
     1362   end.
     1363   end procedure.
     1364   procedure grplib-find-by-substring :
     1365   do
     1366   on error undo, return error
     1367   :
     1368   define input parameter p-start-code         as integer      no-undo.
     1369   define input parameter p-full-search-string as character    no-undo.
     1370   define output parameter p-found-code        as integer      no-undo.
     1371   define output parameter p-full-name         as character    no-undo.
     1372       define variable v-start-code     as integer           no-undo.
     1373       define variable v-found          as logical  init no  no-undo.
     1374       define buffer buf_gds-grp       for ub.gds-grp.
     1375       search-grp:
     1376       for each buf_gds-grp no-lock
     1377           where buf_gds-grp.node-code > p-start-code
     1378       :
     1379           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1380           then do:
     1381               assign
     1382                   p-found-code = buf_gds-grp.node-code
     1383                   v-found      = yes
     1384               .
     1385               run grplib-get-full-name in this-procedure (
     1386                     input p-found-code
     1387                   , output p-full-name
     1388               ) no-error .
     1389               if error-status :error
     1390               then do:
     1391                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1392               end.
     1393               leave search-grp.
     1394           end.
     1395       end.
     1396       if v-found = yes
     1397       then do:
     1398       end.
     1399       else do:
     1400           assign
     1401               p-full-name  = ""
     1402               p-found-code = 0
     1403           .
     1404       end.
     1405   end.
     1406   end procedure.
     1407   procedure grplib-analyze-grp-name :
     1408   do
     1409   on error undo, return error
     1410   :
     1411   define input parameter p-grp-name       as character            no-undo.
     1412   define input parameter p-upper-code     as integer              no-undo.
     1413   define output parameter p-error-message as character init ""    no-undo.
     1414       define variable v-char-list     as character    no-undo.
     1415       define variable v-char-counter  as integer      no-undo.
     1416       define variable v-full-name     as character    no-undo.
     1417       if p-grp-name = "" then do:
     1418           assign
     1419               p-error-message = "Название группы не может быть пустым.".
     1420           .
     1421       end.
     1422       else do:
     1423           assign
     1424               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1425           .
     1426           do v-char-counter = 1 to num-entries( v-char-list )
     1427           :
     1428               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1429               then do:
     1430                   assign
     1431                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1432                   .
     1433                   return.
     1434               end.
     1435           end.
     1436           if p-upper-code > 0
     1437           then do:
     1438               run grplib-get-full-name in this-procedure (
     1439                     input p-upper-code
     1440                   , output v-full-name
     1441               ) no-error .
     1442               if error-status :error
     1443               then do:
     1444                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1445               end.
     1446               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1447               then do:
     1448                   assign
     1449                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1450                   .
     1451               end.
     1452           end.
     1453       end.
     1454   end.
     1455   end procedure.
     1456   procedure grplib-get-lvl-num :
     1457   define input parameter p-node-code  as integer      no-undo.
     1458   define output parameter p-lvl-num   as integer      no-undo.
     1459       define variable v-full-name    as character    no-undo.
     1460   do
     1461   on error undo, return error
     1462   :
     1463       run grplib-get-full-name in this-procedure (
     1464             input p-node-code
     1465           , output v-full-name
     1466       ).
     1467       assign
     1468           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1469       .
     1470       if p-lvl-num = -1
     1471       then do:
     1472           assign
     1473               p-lvl-num = 0
     1474           .
     1475       end.
     1476   end.
     1477   end procedure.
     1478   define variable dops as character no-undo format "X(250)".
     1479   define variable dopst as character no-undo format "X(1)".
     1480   define variable is-jwlr as logical no-undo.
     1481   define variable is-bttl as logical no-undo.
     1482   define variable is-ptrl as logical no-undo.
     1483   define variable custvalue      as char no-undo.
     1484   define variable custtype       as char no-undo.
     1485   define variable v-gds-rec as recid no-undo.
     1486   define variable v-nbc like ub.bar-code.b-code no-undo .
     1487   define variable v-dop as character no-undo .
     1488   define variable v-main-error as logical no-undo .
     1489   define variable vnum1 as integer no-undo .
     1490   define variable vnum2 as integer no-undo .
     1491   define variable v-call-point as character no-undo .
     1492   define variable i-line as integer no-undo .
     1493   define variable v-call-params as character no-undo .
     1494   define variable text-string as character no-undo .
     1495   define variable i-artic like ub.goods.artic no-undo .
     1496   define variable i-struct like ub.goods.struct no-undo .
     1497   define variable i-prod-code like ub.goods.prod-code no-undo .
     1498   define variable i-tnved like ub.goods.tnved no-undo .
     1499   define variable i-alpha1 like ub.goods.alpha1 no-undo .
     1500   define variable v-stts as integer no-undo .
     1501   define stream inp.
     1502   define buffer buf_goods for ub.goods.
     1503   define buffer buf_gds-prt for ub.gds-prt.
     1504   define buffer buf_gds-obj for ub.gds-obj.
     1505   define buffer buf_units for ub.units.
     1506   define buffer cli-units for ub.units.
     1507   define buffer buf_tt-tax for tt-tax.
     1508   define variable log-file-name                as character      no-undo init "gdsuform.txt".
     1509   define variable v-view-log                   as logical        no-undo .
     1510   define variable v-stop                       as logical        no-undo .
     1511   define variable v-val as character no-undo .
     1512   define variable v-do-str  as character no-undo .
     1513   define variable v-do      as logical no-undo extent 37.
     1514   define variable v-ii      as integer no-undo .
     1515   define variable num-rec   as integer no-undo .
     1516   define variable num-rec-ok as integer no-undo .
     1517   define variable glog as logical no-undo .
     1518   define variable lns-cnt as integer no-undo .
     1519   define variable line-rec as recid no-undo .
     1520   define variable v-update-mode as character no-undo .
     1521   define variable v-file-name as character no-undo .
     1522   define variable v-encoding as character no-undo .
     1523   define variable v-found   as logical no-undo .
     1524   define variable v-host-code like ub.sysconf.host-code no-undo .
     1525   if num-entries(p-parameter, chr(1)) <> 4 then do:
     1526    run write-log-and-file in p-log-handle (
     1527           input 1
     1528         , input log-file-name
     1529         , input 1
     1530         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1531                            , p-parameter
     1532                            , chr(10)
     1533                            , error-status:get-message(1)
     1534                            , return-value
     1535                            )).
     1536     assign
     1537     v-view-log = yes.
     1538   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1539   if v-view-log
     1540   and not g#news
     1541   and not g#auto
     1542   then do:
     1543     message
     1544     '!!!При изменении товаров произошли ошибки!!!'  skip
     1545     "!!!Внимательно прочитайте Log-file!!"
     1546     view-as alert-box error .
     1547        define variable v-user-action9   as character no-undo .
     1548     define variable v-printed9       as logical   no-undo .
     1549     run gbl/prnfilen.w
     1550       (input  ('!!!При изменении товаров произошли ошибки!!!')
     1551       ,input  0
     1552       ,input  (string("./":U) + 'gdsuform.txt')
     1553       ,input  7
     1554       ,output v-user-action9
     1555       ,output v-printed9
     1556       ) .
     1557   end.
     1558   if v-view-log = true
     1559   and (g#news
     1560   or g#auto)
     1561   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1562   then do:
     1563      run cb_set-view-log in p-parent-handle ( input yes).
     1564   end.
     1565   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1566     OS-DELETE value(string("./":U) + 'gdsuform.txt').
     1567   end.
     1568                           return.
     1569   end.
     1570   assign
     1571   v-call-point = entry(1, p-parameter, chr(1))
     1572   v-call-params = entry(2, p-parameter, chr(1))
     1573   v-val = entry(3, p-parameter, chr(1))
     1574   v-do-str = entry(4, p-parameter, chr(1))
     1575   .
     1576   log-file-name = v-call-point + ".txt".
     1577   if lookup(v-call-point, "gdsuform,struct,tnved,alpha1") = 0 then do:
     1578    run write-log-and-file in p-log-handle (
     1579           input 1
     1580         , input log-file-name
     1581         , input 1
     1582         , input substitute("Ошибка входных параметров &1:&2неверный режим пакетного изменения товара &3"
     1583                            , p-parameter
     1584                            , chr(10)
     1585                            , v-call-point
