      174   index tax-code is unique primary tax-code fact-order descending rate-code.
      175   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   procedure factord :
      177     define input  parameter p-fact-date            as date    no-undo .
      178     define input  parameter p-fact-time            as integer no-undo .
      179     define input  parameter p-fact-num             as integer no-undo .
      180     define input  parameter p-shift-date           as date    no-undo .
      181     define input  parameter p-shift-num            as integer no-undo .
      182     define input  parameter p-shift-on             as logical no-undo .
      183     define output parameter p-fact-order           as decimal no-undo .
      184     define output parameter p-shift-end-fact-order as decimal no-undo .
      185     define output parameter p-day-end-fact-order   as decimal no-undo .
      186     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      187     if p-fact-date = ?
      188     then do:
      189       return error "Не указана фактическая дата" .
      190     end.
      191     define variable v-fact-date-num as integer no-undo .
      192     assign
      193       v-fact-date-num = integer(p-fact-date)
      194     .
      195     if p-fact-num = ?
      196     or p-fact-num = 0
      197     then do:
      198       return error "Не задан p-fact-num " + string(p-fact-num) .
      199     end.
      200     if p-fact-num < 0
      201     then do:
      202       return error "Отрицательный fact-num " + string(p-fact-num) .
      203     end.
      204     if p-fact-num >= 100000000
      205     then do:
      206       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      207     end.
      208     if p-shift-on = true
      209     then do:
      210       if p-shift-date = ?
      211       then do:
      212         return error "Не задана дата смены" .
      213       end.
      214       if p-shift-num = ?
      215       or p-shift-num = 0
      216       then do:
      217         return error "Не задан номер смены" .
      218       end.
      219     end.
      220     else do:
      221       assign
      222         p-shift-date = p-fact-date
      223         p-shift-num  = 24
      224       .
      225     end.
      226     define variable v-shift-offset as integer no-undo .
      227     if p-shift-date = p-fact-date
      228     then do:
      229       assign
      230         v-shift-offset = 1
      231       .
      232     end.
      233     if p-shift-date < p-fact-date
      234     then do:
      235       assign
      236         v-shift-offset = 0
      237       .
      238     end.
      239     if p-shift-date > p-fact-date
      240     then do:
      241       message
      242         vss-workfile vss-revision vss-description skip
      243         "Неправильная дата закрытия смены" skip
      244         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      245         view-as alert-box error .
      246       undo, return error
      247         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      248           ,string(p-fact-date, '99/99/9999':U)
      249           ,string(p-shift-date, '99/99/9999':U)
      250           )
      251       .
      252     end.
      253     if p-shift-num < 1
      254     or p-shift-num > 24
      255     then do:
      256       message
      257         vss-workfile vss-revision vss-description skip
      258         "Неправильный номер смены" skip
      259         "p-shift-num" p-shift-num skip
      260         view-as alert-box error .
      261       undo, return error return-value .
      262     end.
      263     assign
      264       p-fact-order           = v-fact-date-num
      265                              + v-shift-offset * 0.5
      266                              + p-shift-num    * 0.02 - 0.01
      267                              + p-fact-num     * 0.0000000001
      268       p-shift-end-fact-order = v-fact-date-num
      269                              + v-shift-offset * 0.5
      270                              + p-shift-num    * 0.02
      271       p-day-end-fact-order   = v-fact-date-num
      272                              + 0.99
      273     .
      274     if p-fact-order           <= v-fact-date-num
      275     or p-shift-end-fact-order <= v-fact-date-num
      276     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      277     or p-shift-end-fact-order >= p-day-end-fact-order
      278     then do:
      279       message
      280         vss-workfile vss-revision vss-description skip
      281         "Внутренняя ошибка при генерации фактического номера" skip
      282         "p-fact-date"            p-fact-date            skip
      283         "p-fact-time"            p-fact-time            skip
      284         "p-fact-num"             p-fact-num             skip
      285         "p-shift-date"           p-shift-date           skip
      286         "p-shift-num"            p-shift-num            skip
      287         "p-shift-on"             p-shift-on             skip
      288         "p-shift-end-fact-order" p-shift-end-fact-order skip
      289         "p-day-end-fact-order"   p-day-end-fact-order   skip
      290         "v-fact-date-num"        v-fact-date-num        skip
      291         view-as alert-box error .
      292       undo, return error return-value .
      293     end.
      294   end procedure.
      295   procedure day-begin-fact-order :
      296     define input  parameter p-fact-date            as date    no-undo .
      297     define output parameter p-day-begin-fact-order as decimal no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       if p-fact-date = ?
      302       then do:
      303         assign
      304           p-day-begin-fact-order = 0
      305         .
      306       end.
      307       else do:
      308         assign
      309           p-day-begin-fact-order = integer(p-fact-date)
      310         .
      311       end.
      312     end.
      313   end procedure.
      314   procedure factord-max-fact-order :
      315     define output parameter p-max-fact-order as decimal   no-undo .
      316     do
      317     on error undo, return error return-value
      318     :
      319       run day-begin-fact-order in this-procedure
      320         (input  date(1, 1, 5000)
      321         ,output p-max-fact-order
      322         ) .
      323     end.
      324   end procedure.
      325   procedure factord-cut-archive :
      326     define input  parameter p-obj-type             as character no-undo .
      327     define input  parameter p-obj-code             as integer   no-undo .
      328     define input  parameter p-fact-date            as date      no-undo .
      329     define output parameter p-shift-on             as logical   no-undo .
      330     define output parameter p-shift-date           as date      no-undo .
      331     define output parameter p-shift-num            as integer   no-undo .
      332     define output parameter p-day-end-fact-order   as decimal   no-undo .
      333     define output parameter p-shift-end-fact-order as decimal   no-undo .
      334     define variable v-fact-order as decimal   no-undo .
      335     define buffer buf_shift-obj for ub.shift-obj .
      336     do
      337     on error undo, return error return-value
      338     :
      339   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      341     (input  p-obj-type
      342     ,input  p-obj-code
      343     ,input  'shift-on=request'
      344     ,output p-shift-on
      345     ) no-error .
      346       if error-status :error
      347       then do:
      348         message
      349           vss-workfile vss-revision vss-description skip
      350           "Ошибка при определении атрибута объекта" skip
      351           "Объект" p-obj-type p-obj-code skip
      352           error-status :get-message(1) skip
      353           return-value skip
      354           view-as alert-box error .
      355         undo, return error return-value .
      356       end.
      357       if p-shift-on = false
      358       then do:
      359         assign
      360           p-shift-date               = ?
      361           p-shift-num                = 0
      362         .
      363       end.
      364       else do:
      365         find first buf_shift-obj share-lock
      366           where buf_shift-obj.obj-type   = p-obj-type
      367             and buf_shift-obj.obj-code   = p-obj-code
      368             and buf_shift-obj.shift-date > p-fact-date
      369           use-index pi
      370           no-error .
      371         if not available buf_shift-obj
      372         or buf_shift-obj.status_ <> 'зкр':U
      373         then do:
      374           message
      375             vss-workfile vss-revision vss-description skip
      376             "Невозможно вычислить последнюю смену" skip
      377             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      378             "Объект" p-obj-type p-obj-code skip
      379             "Дата" p-fact-date skip
      380             view-as alert-box error .
      381           undo, return error return-value .
      382         end.
      383         find last buf_shift-obj share-lock
      384           where buf_shift-obj.obj-type = p-obj-type
      385             and buf_shift-obj.obj-code = p-obj-code
      386             and buf_shift-obj.shift-date <= p-fact-date
      387           use-index pi
      388           no-error .
      389         if available buf_shift-obj
      390         then do:
      391           if  buf_shift-obj.status_ = 'зкр':U
      392           then do:
      393             assign
      394               p-shift-date = buf_shift-obj.shift-date
      395               p-shift-num  = buf_shift-obj.shift-num
      396             .
      397           end.
      398           else do:
      399             message
      400               vss-workfile vss-revision vss-description skip
      401               "Невозможно вычислить последнюю смену" skip
      402               "Статус смены отличен от статуса" 'зкр':U skip
      403               "Объект" p-obj-type p-obj-code skip
      404               "Дата" p-fact-date skip
      405               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      406               view-as alert-box error .
      407             undo, return error return-value .
      408           end.
      409         end.
      410         else do:
      411           assign
      412             p-shift-date = p-fact-date - 1
      413             p-shift-num  = 1
      414           .
      415         end.
      416       end.
      417       run factord in this-procedure
      418         (input  p-fact-date
      419         ,input  1
      420         ,input  1
      421         ,input  p-shift-date
      422         ,input  p-shift-num
      423         ,input  p-shift-on
      424         ,output v-fact-order
      425         ,output p-shift-end-fact-order
      426         ,output p-day-end-fact-order
      427         ) no-error .
      428       if error-status :error
      429       then do:
      430         message
      431           vss-workfile vss-revision vss-description skip
      432           "Ошибка при вызове процедуры factord"
      433           error-status :get-message(1) skip
      434           return-value skip
      435           view-as alert-box error .
      436         undo, return error return-value .
      437       end.
      438     end.
      439   end procedure.
      440   procedure factord-lock-shift :
      441     define input  parameter p-obj-type  as character no-undo .
      442     define input  parameter p-obj-code  as integer   no-undo .
      443     define input  parameter p-fact-date as date      no-undo .
      444     define parameter buffer buf_shift-obj for ub.shift-obj .
      445     define variable v-shift-on      as logical   no-undo .
      446     define variable v-extra-message as character no-undo .
      447     define variable v-error as character no-undo .
      448     do
      449     on error undo, return error return-value
      450     :
      451   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      453     (input  p-obj-type
      454     ,input  p-obj-code
      455     ,input  'shift-on=request'
      456     ,output v-shift-on
      457     ) no-error .
      458       if error-status :error
      459       then do:
      460         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      461         undo, return error v-error .
      462       end.
      463       if v-shift-on = true
      464       then do:
      465         find first buf_shift-obj share-lock
      466           where buf_shift-obj.obj-type   = p-obj-type
      467             and buf_shift-obj.obj-code   = p-obj-code
      468             and buf_shift-obj.shift-date > p-fact-date
      469           use-index pi
      470           no-error .
      471         if not available buf_shift-obj
      472         or buf_shift-obj.status_ <> 'зкр':U
      473         then do:
      474           find last buf_shift-obj
      475             where buf_shift-obj.obj-type = p-obj-type
      476               and buf_shift-obj.obj-code = p-obj-code
      477               and buf_shift-obj.status_  = 'зкр':U
      478             use-index stts
      479             no-error .
      480           if available buf_shift-obj
      481           then do:
      482             assign
      483               v-extra-message =
      484                     substitute("Дата начала последеней закрытой смены на объекте &1"
      485                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      486                               )
      487             .
      488           end.
      489           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      490           undo, return error v-error .
      491         end.
      492       end.
      493     end.
      494   end procedure.
      495   procedure factord-end-day :
      496     define input  parameter p-fact-date            as date    no-undo .
      497     define output parameter p-day-end-fact-order   as decimal no-undo .
      498     do
      499     on error undo, return error return-value
      500     :
      501       if p-fact-date = ?
      502       then do:
      503         return error "Не указана фактическая дата" .
      504       end.
      505       assign
      506         p-day-end-fact-order = integer(p-fact-date) + 0.99
      507       .
      508     end.
      509   end procedure.
      510   procedure factord-to-date :
      511     define input  parameter p-fact-order as decimal no-undo .
      512     define output parameter p-fact-date  as date    no-undo .
      513     define variable v-ref-date  as date      no-undo .
      514     define variable v-ref-delta as integer   no-undo .
      515     do
      516     on error undo, return error return-value
      517     :
      518       if p-fact-order = ?
      519       or p-fact-order = 0
      520       then do:
      521         return error "Не указан fact-order" .
      522       end.
      523       assign
      524         v-ref-date  = date(1, 1, 2000)
      525       .
      526       assign
      527         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      528       .
      529       assign
      530         p-fact-date = v-ref-date + v-ref-delta
      531       .
      532     end.
      533   end procedure.
      534   procedure factord-to-fact-num :
      535     define input  parameter p-fact-order as decimal no-undo .
      536     define output parameter p-fact-num   as integer no-undo .
      537     define variable v-fact-order-trunc as decimal no-undo .
      538     do
      539     on error undo, return error return-value
      540     :
      541       if p-fact-order = ?
      542       or p-fact-order = 0
      543       then do:
      544         return error "Не указан fact-order" .
      545       end.
      546       assign
      547        v-fact-order-trunc = truncate(p-fact-order, 2)
      548       .
      549       assign
      550         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      551       .
      552     end.
      553   end procedure.
      554   procedure factord-to-shift-num :
      555     define input  parameter p-fact-order as decimal no-undo .
      556     define output parameter p-shift-num   as integer no-undo .
      557     define variable  p-shift-numd  as decimal   no-undo .
      558     define variable v-fact-order-trunc as decimal no-undo .
      559     do
      560     on error undo, return error return-value
      561     :
      562       if p-fact-order = ?
      563       or p-fact-order = 0
      564       then do:
      565         return error "Не указан fact-order" .
      566       end.
      567       assign
      568        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      569       .
      570       if v-fact-order-trunc < 0.5 then do:
      571         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      572       end.
      573       assign
      574         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      575         .
      576        assign
      577         p-shift-num = truncate (p-shift-numd , 0)
      578       .
      579     end.
      580   end procedure.
      581   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   procedure cur-time :
      583      define output parameter p-today as date      no-undo .
      584      define output parameter p-time  as integer   no-undo .
      585     do
      586     on error undo, return error
      587     :
      588       define variable v-date1 as date      no-undo .
      589       define variable v-date2 as date      no-undo .
      590       define variable v-time  as integer   no-undo .
      591       assign
      592         v-date1 = today
      593         v-time  = time
      594         v-date2 = today
      595       .
      596       if v-date1 <> v-date2
      597       then do:
      598         assign
      599           v-date1 = today
      600           v-time  = v-time
      601         .
      602       end.
      603       assign
      604         p-today = v-date1
      605         p-time  = v-time
      606       .
      607     end.
      608   end.
      609   function cur-time-date returns character
      610   :
      611     return string(today, '99/99/9999':U) .
      612   end.
      613   function cur-time-mjd returns decimal
      614   :
      615     define variable v-date as date      no-undo .
      616     define variable v-time as integer   no-undo .
      617     run cur-time in this-procedure
      618       (output v-date
      619       ,output v-time
      620       ) .
      621     return integer(v-date) - 2400002 + (v-time / 86400) .
      622   end.
      623   function cur-time-get-ending-index returns integer
      624   (input p-number as integer
      625   )
      626   :
      627     if p-number < 0
      628     or p-number = ?
      629     then do:
      630       return 1 .
      631     end.
      632     define variable v-rest as integer   no-undo .
      633     assign
      634       p-number = p-number modulo 100
      635     .
      636     if p-number < 20
      637     then do:
      638       assign
      639         v-rest = p-number
      640       .
      641     end.
      642     else do:
      643       assign
      644         v-rest = p-number modulo 10
      645       .
      646     end.
      647     case v-rest :
      648       when 1
      649       then do:
      650         return 2 .
      651       end.
      652       when 2 or
      653       when 3 or
      654       when 4
      655       then do:
      656         return 3 .
      657       end.
      658       otherwise do:
      659         return 1 .
      660       end.
      661     end case .
      662   end.
      663   procedure cur-time-mjd-to-date :
      664      define input  parameter i-mjd-diff as decimal no-undo.
      665      define output parameter o-Date     as date    no-undo.
      666      define output parameter o-Time     as integer no-undo.
      667      define variable v-day-number as integer   no-undo .
      668      if    i-mjd-diff < 0
      669         or i-mjd-diff = ?
      670      then do:
      671         return "?" .
      672      end.
      673      assign
      674         v-day-number = truncate(i-mjd-diff,0).
      675         o-Date = date(v-day-number + 2400002).
      676         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      677     .
      678   end.
      679   function cur-time-mjd-to-string returns character
      680   (input p-mjd-diff as decimal
      681   )
      682   :
      683     define variable v-day-number as integer   no-undo .
      684     define variable v-seconds    as integer   no-undo .
      685     define variable v-hour       as integer   no-undo .
      686     define variable v-min        as integer   no-undo .
      687     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      688     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      689     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      690     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      691     if p-mjd-diff < 0
      692     or p-mjd-diff = ?
      693     then do:
      694       return "?" .
      695     end.
      696     assign
      697       v-day-number = integer(truncate(p-mjd-diff,0))
      698       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      699     .
      700     if v-seconds > 86400
      701     then do:
      702       assign
      703         v-seconds = 86400 - 1
      704       .
      705     end.
      706     if v-seconds < 0
      707     then do:
      708       assign
      709         v-seconds = 0
      710       .
      711     end.
      712     assign
      713       v-hour = truncate(v-seconds / 3600, 0)
      714     .
      715     assign
      716       v-seconds = v-seconds modulo 3600
      717     .
      718     assign
      719       v-min = truncate(v-seconds / 60, 0)
      720     .
      721     assign
      722       v-seconds = v-seconds modulo 60
      723     .
      724     return
      725         (if v-day-number <> 0
      726           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      727           else ""
      728         )
      729       + (if v-day-number <> 0 or v-hour <> 0
      730           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      731           else ""
      732         )
      733       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      734           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      735           else ""
      736         )
      737       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      738       .
      739   end.
      740   function cur-time-string returns character
      741   :
      742     define variable v-date as date      no-undo .
      743     define variable v-time as integer   no-undo .
      744     run cur-time in this-procedure
      745       (output v-date
      746       ,output v-time
      747       ) .
      748     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      749   end.
      750   function cur-time-string-sec returns character
      751   :
      752     define variable v-date as date      no-undo .
      753     define variable v-time as integer   no-undo .
      754     run cur-time in this-procedure
      755       (output v-date
      756       ,output v-time
      757       ) .
      758     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      759   end.
      760   function cur-time-custom  returns character
      761   (input p-prefix as character
      762   ,input p-date-format as character
      763   ,input p-delimiter as character
      764   ,input p-time-format as character
      765   ,input p-suffix as character
      766   )
      767   :
      768     define variable v-date as date      no-undo .
      769     define variable v-time as integer   no-undo .
      770     run cur-time in this-procedure
      771       (output v-date
      772       ,output v-time
      773       ) .
      774     return
      775       p-prefix
      776       + string(v-date, p-date-format)
      777       + p-delimiter
      778       + string(v-time, p-time-format)
      779       + p-suffix
      780       .
      781   end.
      782   function cur-time-print  returns character
      783   :
      784     define variable v-date as date      no-undo .
      785     define variable v-time as integer   no-undo .
      786     run cur-time in this-procedure
      787       (output v-date
      788       ,output v-time
      789       ) .
      790     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      791   end.
      792   function cur-time-datetime returns datetime
      793   :
      794     define variable v-char as character no-undo .
      795     define variable v-datetime as datetime no-undo .
      796     v-char = cur-time-string().
      797     v-datetime = datetime(v-char).
      798     return  v-datetime.
      799   end.
      800   function cur-time-string-msec returns character
      801   :
      802     define variable v-date as datetime  no-undo .
      803     v-date = now.
      804     return string(v-date) .
      805   end.
