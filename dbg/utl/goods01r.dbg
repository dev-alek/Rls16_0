       45   DEFINE VARIABLE var-fact-order like ub.tax-rate-value.fact-order no-undo .
       46   define variable vss-revision    as character no-undo init "$Revision: 151fe727385f, 696, rls $":U .
       47   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       48   define variable vss-date        as character no-undo init "$Date: Wed Jul 06 18:00:55 2016 +0300 $":U .
       49   define variable vss-workfile    as character no-undo init "$Workfile: goods01r.p $":U .
