      510            CANCEL-BUTTON b-quit.
      511   ASSIGN
      512          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      513          FRAME Dialog-Frame:HIDDEN           = TRUE.
      514   ASSIGN
      515          f-path:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      516   ASSIGN
      517          f-path2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      518   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      519   DO:
      520     APPLY "END-ERROR":U TO SELF.
      521   END.
      522   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      523   DO:
      524     run proc-b-add IN THIS-PROCEDURE ( INPUT "") NO-ERROR.
      525     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      526   END.
      527   ON CHOOSE OF B-add-all IN FRAME Dialog-Frame
      528   DO:
      529     run proc-b-add IN THIS-PROCEDURE ( INPUT 'все':U) NO-ERROR.
      530     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      531   END.
      532   ON CHOOSE OF B-add-db IN FRAME Dialog-Frame
      533   DO:
      534     run proc-b-add IN THIS-PROCEDURE ( INPUT "db" ) NO-ERROR.
      535     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      536   END.
      537   ON CHOOSE OF B-add-object IN FRAME Dialog-Frame
      538   DO:
      539     run proc-b-add IN THIS-PROCEDURE ( INPUT 'объект':U) NO-ERROR.
      540     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      541   END.
      542   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      543   DO:
      544     run proc-b-del IN THIS-PROCEDURE ( INPUT "") NO-ERROR.
      545     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      546   END.
      547   ON CHOOSE OF B-del-all IN FRAME Dialog-Frame
      548   DO:
      549     run proc-b-del IN THIS-PROCEDURE ( INPUT 'все':U ) NO-ERROR.
      550     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      551   END.
      552   ON CHOOSE OF B-del-db IN FRAME Dialog-Frame
      553   DO:
      554     run proc-b-del IN THIS-PROCEDURE ( INPUT "db" ) NO-ERROR.
      555     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      556   END.
      557   ON CHOOSE OF B-del-obj IN FRAME Dialog-Frame
      558   DO:
      559     run proc-b-del IN THIS-PROCEDURE ( INPUT 'объект':U) NO-ERROR.
      560     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      561   END.
      562   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      563   DO:
      564   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      565     ASSIGN
      566     f-path
      567     rs-action    .
      568     if f-path = '' then do:
      569       message
      570       substitute("Не задан файл &1", f-path)
      571       view-as alert-box error .
      572       undo, return no-apply.
      573     end.
      574     if not can-find( first tt-cash-desk) then do:
      575       message
      576       substitute("Не задан список касс")
      577       view-as alert-box error .
      578       undo, return no-apply.
      579     end.
      580     MESSAGE
      581     SUBSTITUTE("Отослать на выбранные кассы файл &1&2Вы уверены?&2" +
      582                "(Для УБД отсылка будет проведена при приеме пакета СПН)"
      583                , f-path
      584                , chr(10))
      585     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      586     IF NOT glog THEN RETURN NO-APPLY.
      587     run str/diallog.w (
      588               INPUT parparentproc
      589             , INPUT this-procedure:HANDLE
      590             , INPUT 'utl/sendxprr.p':U
      591             , INPUT f-path + chr(4) + rs-action
      592             , INPUT no
      593             , input 'Прервать'
      594             , INPUT 'Пересылка файлов на кассы IBM-XML') no-error .
      595     END.
      596   ON CHOOSE OF b-file IN FRAME Dialog-Frame
      597   DO:
      598     run proc-b-file IN THIS-PROCEDURE NO-ERROR.
      599     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      600   END.
      601   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      602   DO:
      603   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      604     if not available tt-cash-desk then return no-apply.
      605   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   define variable v-str-recid5 as character no-undo .
      607   define variable v-num-entry5 as integer   no-undo .
      608   assign
      609     v-str-recid5 = trim( string( recid( tt-cash-desk ) , "->>>>>>>>>>>9":U ) )
      610     v-num-entry5 = lookup( v-str-recid5 , v-rid-list )
      611   .
      612   if v-num-entry5 > 0 then do:
      613     assign
      614       entry( v-num-entry5, v-rid-list ) = "":U
      615       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      616     .
      617   end.
      618   else do:
      619     assign
      620       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
      621     .
      622   end.
      623     glog = br-cash-desk  :refresh( ) in frame Dialog-Frame.
      624     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
      625             glog = br-cash-desk:select-next-row () in frame Dialog-Frame.
      626             apply "value-changed" to br-cash-desk in frame Dialog-Frame.
      627     end.
      628     apply "entry" to br-cash-desk in frame Dialog-Frame.
      629   END.
      630   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      631   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      632   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      633   on help of frame Dialog-Frame
      634   do:
      635     run gbl/app_help.p
      636       (input this-procedure :file-name
      637       ,input ''
      638       ,input ?
      639       ) no-error.
      640     if error-status :error then do:
      641       message
      642         "Ошибка при вызове помощи"
      643         error-status :get-message(1)
      644         view-as alert-box .
      645     end.
      646   end.
      647   run minbtn-set in this-procedure .
      648   on choose of b-help in frame Dialog-Frame
      649   do:
      650     apply "help":u to frame Dialog-Frame .
      651   end.
      652   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      653   procedure minbtn-set :
      654       do
      655           on error undo, return error return-value
      656           :
      657           define variable ii              as integer       no-undo .
      658           define variable fh              as widget-handle no-undo .
      659           define variable hh              as widget-handle no-undo .
      660           define variable v-h             as handle        extent 4 no-undo .
      661           define variable v-name-button   as character     no-undo .
      662           define variable v-help-old-x    as decimal       no-undo .
      663           define variable v-help-old-y    as decimal       no-undo .
      664           define variable v-help-old-size as decimal       no-undo .
      665           define variable v-frame-width   as decimal       no-undo .
      666           define variable jj              as integer       no-undo .
      667           do
      668               on error undo, return error
      669               :
      670               assign
      671                   v-frame-width = frame Dialog-Frame:width - 0.3
      672                   fh            = frame Dialog-Frame:first-child
      673                   hh            = fh:first-child
      674                   ii            = 1
      675                   .
      676               do while valid-handle(hh):
      677                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      678                   do:
      679                       case lc(hh:name) :
      680                           when "b-help" then
      681                               do:
      682                                   hh:load-image-up("cmp/b-help.bmp":u) .
      683                                   hh:load-image-down("cmp/b-help.bmp":u) .
      684                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      685                                   hh:TOOLTIP = "Помощь" .
      686                                   v-help-old-x = hh:column .
      687                                   v-help-old-y = hh:row    .
      688                                   v-help-old-size = hh:width .
      689                                   hh:width-chars = 2.5 .
      690                               end.
      691                           when "b-print" then
      692                               do:
      693                                   hh:load-image("cmp/b-print.bmp":u) .
      694                                   hh:TOOLTIP = "Печать" .
      695                                   v-h[ii] = hh:handle .
      696                                   ii = ii + 1 .
      697                                   hh:width-chars = 3 .
      698                               end.
      699                           when "b-history" or
      700                           when "b-hist" then
      701                               do:
      702                                   hh:load-image("cmp/b-hist.bmp":u) .
      703                                   hh:TOOLTIP = "История" .
      704                                   v-h[ii] = hh:handle .
      705                                   ii = ii + 1 .
      706                                   hh:width-chars = 3 .
      707                               end.
      708                           when "b-sch" then
      709                               do:
      710                                   hh:load-image("cmp/b-sch.bmp":u) .
      711                                   hh:TOOLTIP = "Установка Фильтра" .
      712                                   v-h[ii] = hh:handle .
      713                                   ii = ii + 1 .
      714                                   hh:width-chars = 3 .
      715                               end.
      716                           when "b-hist-user" then
      717                               do:
      718                                   hh:load-image("cmp/b-hist.bmp":u) .
      719                                   hh:TOOLTIP = "История пользователя" .
      720                                   ii = ii + 1 .
      721                               end.
      722                       end case.
      723                   end.
      724                   hh = hh:next-sibling.
      725               end.
      726               b-help:column = v-frame-width - b-help:width-chars.
      727               jj = 0.
      728               repeat ii = 4 to 1 by -1 :
      729                   if valid-handle (v-h[ii] ) then
      730                   do:
      731                       jj  = jj + 1 .
      732                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      733                       v-h[ii]:row    = v-help-old-y .
      734                   end.
      735               end.
      736           end.
      737       end.
      738   end procedure.
      739   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      740   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      741   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      742   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      743   define variable v-diasize-current-frame-width  as decimal   no-undo .
      744   define variable v-diasize-current-frame-height as decimal   no-undo .
      745   define variable v-diasize-change-size          as logical   no-undo .
      746   define variable v-diasize-resize-button        as handle    no-undo .
      747   define variable v-diasize-wndmax               as logical   no-undo .
      748   define variable v-diasize-wndstore             as logical   no-undo .
      749   define variable v-diasize-proc-name            as character no-undo .
      750   define variable v-diasize-browse-handle        as handle    no-undo .
      751   define variable v-diasize-browse-number        as integer   no-undo .
      752   define variable v-diasize-need-full-display    as logical   no-undo init false .
      753   define temp-table temp-diasize-handle no-undo
      754     field handle-value  as handle
      755     field save-position as decimal
      756     index xpk is primary unique handle-value
      757     .
      758   define temp-table temp-browse-handle no-undo
      759     field browse-type   as character
      760     field browse-number as integer
      761     field browse-handle as handle
      762     field original-size as decimal
      763     index xpk is primary unique browse-type browse-number
      764     index xie browse-type browse-handle
      765   .
      766   procedure diasize_change-height :
      767     define input  parameter p-change-value  as decimal   no-undo .
      768     define input  parameter p-move-resize   as logical   no-undo .
      769     define variable v-field-group-handle    as handle    no-undo .
      770     define variable v-object-handle         as handle    no-undo .
      771     define variable v-frame-height          as decimal   no-undo .
      772     define variable v-frame-virtual-height  as decimal   no-undo .
      773     define variable v-browse-height         as decimal   no-undo .
      774     define variable v-window-height         as decimal   no-undo .
      775     define variable v-window-virtual-height as decimal   no-undo .
      776     define variable v-change-sign           as integer   no-undo .
      777     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      778     define buffer buf_temp-browse-handle  for temp-browse-handle .
      779     if p-change-value > 0
      780     then do:
      781       if frame Dialog-Frame :height + p-change-value
      782           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      783       then do:
      784         assign
      785           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      786                           - (frame Dialog-Frame :height-chars)
      787         .
      788         if p-change-value <= 0
      789         then do:
      790           run diasize_position-resize-button in this-procedure .
      791           return .
      792         end.
      793       end.
      794     end.
      795     if p-change-value < 0
      796     then do:
      797       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      798       then do:
      799         assign
      800           p-change-value = v-diasize-orig-frame-height
      801                          - (frame Dialog-Frame :height-chars)
      802         .
      803         if p-change-value >= 0
      804         then do:
      805           run diasize_position-resize-button in this-procedure .
      806           return .
      807         end.
      808       end.
      809     end.
      810     if p-change-value >= 0
      811     then do:
      812       assign
      813         v-change-sign = 1
      814       .
      815     end.
      816     else do:
      817       assign
      818         v-change-sign = -1
      819       .
      820     end.
      821     assign
      822       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      823     .
      824     if p-change-value = 0
      825     then do:
      826       run diasize_position-resize-button in this-procedure .
      827       return .
      828     end.
      829     move_block:
      830     do
      831     on error undo move_block, retry move_block
      832     :
      833       if retry
      834       then do:
      835         do
      836         on error undo move_block, leave move_block
      837         :
      838           if p-change-value > 0
      839           then do:
      840             for each buf_temp-diasize-handle
      841             on error undo, next
      842             :
      843               assign
      844                 v-object-handle = buf_temp-diasize-handle.handle-value
      845               .
      846               if v-object-handle <> v-diasize-resize-button
      847               then do:
      848                 assign
      849                   v-object-handle :row = buf_temp-diasize-handle.save-position
      850                 .
      851               end.
      852             end.
      853             assign
      854               v-diasize-browse-handle :height = v-browse-height
      855             .
      856             for each buf_temp-browse-handle
      857               where buf_temp-browse-handle.browse-type = 'height':u
      858             on error undo, next
      859             :
      860               assign
      861                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      862               .
      863             end.
      864             assign
      865               frame Dialog-Frame :height = v-frame-height
      866             .
      867             if frame Dialog-Frame :scrollable = true
      868             then do:
      869               assign
      870                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      871               .
      872             end.
      873             run diasize_position-resize-button in this-procedure .
      874           end.
      875           else do:
      876             if frame Dialog-Frame :scrollable = true
      877             then do:
      878               assign
      879                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      880               .
      881             end.
      882             assign
      883               frame Dialog-Frame :height = v-frame-height
      884             .
      885             assign
      886               v-diasize-browse-handle :height = v-browse-height
      887             .
      888             for each buf_temp-browse-handle
      889               where buf_temp-browse-handle.browse-type = 'height':u
      890             on error undo, next
      891             :
      892               assign
      893                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      894               .
      895             end.
      896             for each buf_temp-diasize-handle
      897             on error undo, next
      898             :
      899               assign
      900                 v-object-handle = buf_temp-diasize-handle.handle-value
      901               .
      902               if v-object-handle <> v-diasize-resize-button
      903               then do:
      904                 assign
      905                   v-object-handle :row = buf_temp-diasize-handle.save-position
      906                 .
      907               end.
      908             end.
      909             run diasize_position-resize-button in this-procedure .
      910           end.
      911           assign
      912             v-diasize-change-size = false
      913           .
      914           leave move_block .
      915         end.
      916       end.
      917       assign
      918         v-diasize-need-full-display = true
      919       .
      920       if v-diasize-change-size = false
      921       then do:
      922         assign
      923           v-diasize-change-size = true
      924         .
      925       end.
      926       else do:
      927         return .
      928       end.
      929       assign
      930         v-frame-height = frame Dialog-Frame :height
      931         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      932         v-browse-height = v-diasize-browse-handle :height
      933       .
      934       for each buf_temp-browse-handle
      935         where buf_temp-browse-handle.browse-type = 'height':u
      936       :
      937         assign
      938           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      939         .
      940       end.
      941       for each buf_temp-diasize-handle
      942       :
      943         delete buf_temp-diasize-handle .
      944       end.
      945       assign
      946         v-field-group-handle = frame Dialog-Frame :first-child
      947       .
      948       do while valid-handle(v-field-group-handle)
      949       :
      950         assign
      951           v-object-handle = v-field-group-handle :first-child
      952         .
      953         do while valid-handle(v-object-handle)
      954         :
      955           if  v-object-handle <> v-diasize-browse-handle :handle
      956           and can-query(v-object-handle, "row")
      957           and can-query(v-object-handle, "height")
      958           and ( v-object-handle :row > v-diasize-browse-handle :row )
      959           then do:
      960             find first buf_temp-browse-handle
      961               where buf_temp-browse-handle.browse-type   = 'height':u
      962                 and buf_temp-browse-handle.browse-handle = v-object-handle
      963               no-error .
      964             if available buf_temp-browse-handle
      965             then do:
      966             end.
      967             else do:
      968               create buf_temp-diasize-handle .
      969               assign
      970                 buf_temp-diasize-handle.handle-value  = v-object-handle
      971                 buf_temp-diasize-handle.save-position = v-object-handle :row
      972               .
      973             end.
      974           end.
      975           assign
      976             v-object-handle = v-object-handle :next-sibling
      977           .
      978         end.
      979         assign
      980           v-field-group-handle = v-field-group-handle :next-sibling
      981         .
      982       end.
      983       do with frame Dialog-Frame
      984       :
      985         hide v-diasize-resize-button .
      986         assign
      987           v-diasize-resize-button :row    = 1
      988           v-diasize-resize-button :column = 1
      989         .
      990       end.
      991       if p-change-value > 0
      992       then do:
      993         if frame Dialog-Frame :scrollable = true
      994         then do:
      995           assign
      996             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      997             no-error .
      998           if error-status :error
      999           or error-status :get-message(1) <> ""
     1000           then do:
     1001             undo move_block, retry move_block .
     1002           end.
     1003         end.
     1004         assign
     1005           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1006           no-error .
     1007         if error-status :error
     1008         or error-status :get-message(1) <> ""
     1009         then do:
     1010           undo move_block, retry move_block .
     1011         end.
     1012         assign
     1013           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1014           no-error .
     1015         if error-status :error
     1016         or error-status :get-message(1) <> ""
     1017         then do:
     1018           undo move_block, retry move_block .
     1019         end.
     1020         for each buf_temp-browse-handle
     1021           where buf_temp-browse-handle.browse-type = 'height':u
     1022         on error undo move_block, retry move_block
     1023         :
     1024           assign
     1025             buf_temp-browse-handle.browse-handle :height
     1026               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1027             no-error .
     1028           if error-status :error
     1029           or error-status :get-message(1) <> ""
     1030           then do:
     1031             undo move_block, retry move_block .
     1032           end.
     1033         end.
     1034         for each buf_temp-diasize-handle
     1035         on error undo move_block, retry move_block
     1036         :
     1037           assign
     1038             v-object-handle = buf_temp-diasize-handle.handle-value
     1039           .
     1040           if v-object-handle <> v-diasize-resize-button
     1041           then do:
     1042             assign
     1043               v-object-handle :row = v-object-handle :row + p-change-value
     1044               no-error .
     1045             if error-status :error
     1046             or error-status :get-message(1) <> ""
     1047             then do:
     1048               undo move_block, retry move_block .
     1049             end.
     1050           end.
     1051         end.
     1052       end.
     1053       else do:
     1054         for each buf_temp-diasize-handle
     1055         on error undo move_block, retry move_block
     1056         :
     1057           assign
     1058             v-object-handle = buf_temp-diasize-handle.handle-value
     1059           .
     1060           if v-object-handle <> v-diasize-resize-button
     1061           then do:
     1062             assign
     1063               v-object-handle :row = v-object-handle :row + p-change-value
     1064               no-error .
     1065             if error-status :error
     1066             or error-status :get-message(1) <> ""
     1067             then do:
     1068               undo move_block, retry move_block .
     1069             end.
     1070           end.
     1071         end.
     1072         assign
     1073           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1074           no-error .
     1075         if error-status :error
     1076         or error-status :get-message(1) <> ""
     1077         then do:
     1078           undo move_block, retry move_block .
     1079         end.
     1080         for each buf_temp-browse-handle
     1081           where buf_temp-browse-handle.browse-type = 'height':u
     1082         on error undo move_block, retry move_block
     1083         :
     1084           assign
     1085             buf_temp-browse-handle.browse-handle :height
     1086               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1087             no-error .
     1088           if error-status :error
     1089           or error-status :get-message(1) <> ""
     1090           then do:
     1091             undo move_block, retry move_block .
     1092           end.
     1093         end.
     1094         assign
     1095           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1096           no-error .
     1097         if error-status :error
     1098         or error-status :get-message(1) <> ""
     1099         then do:
     1100           undo move_block, retry move_block .
     1101         end.
     1102         if frame Dialog-Frame :scrollable = true
     1103         then do:
     1104           assign
     1105             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1106             no-error .
     1107           if error-status :error
     1108           or error-status :get-message(1) <> ""
     1109           then do:
     1110             undo move_block, retry move_block .
     1111           end.
     1112         end.
     1113       end.
     1114       if p-move-resize = true
     1115       then do:
     1116         run diasize_position-resize-button in this-procedure .
     1117       end.
     1118       if v-diasize-wndstore = true
     1119       then do:
     1120         if connected("ub") = true
     1121         then do:
     1122           define variable v-cntxt-db-num        as integer   no-undo .
     1123           define variable v-cntxt-userid        as character no-undo .
     1124           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1125                                             , OUTPUT v-cntxt-userid
     1126                                             ) .
     1127           run gbl/wndsizew.p
     1128             (input  v-cntxt-db-num
     1129             ,input  v-cntxt-userid
     1130             ,input  v-diasize-proc-name
     1131             ,input  'height':u
     1132             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1133             ) .
     1134         end.
     1135       end.
     1136     end.
     1137     assign
     1138       v-diasize-change-size = false
     1139     .
     1140   end procedure.
     1141   procedure diasize_set-height :
     1142     define input  parameter p-new-height  as decimal   no-undo .
     1143     define input  parameter p-move-resize as logical   no-undo .
     1144     do
     1145     on error undo, return error return-value
     1146     :
     1147       run diasize_change-height in this-procedure
     1148         (input  (p-new-height - frame Dialog-Frame :height)
     1149         ,input  p-move-resize
     1150         ) .
     1151     end.
     1152   end procedure.
     1153   procedure diasize_change-width :
     1154     define input  parameter p-change-value as decimal   no-undo .
     1155     define input  parameter p-move-resize  as logical   no-undo .
     1156     define variable v-field-group-handle   as handle    no-undo .
     1157     define variable v-object-handle        as handle    no-undo .
     1158     define variable v-frame-width          as decimal   no-undo .
     1159     define variable v-frame-virtual-width  as decimal   no-undo .
     1160     define variable v-browse-width         as decimal   no-undo .
     1161     define variable v-window-width         as decimal   no-undo .
     1162     define variable v-window-virtual-width as decimal   no-undo .
     1163     define variable v-change-sign          as integer   no-undo .
     1164     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1165     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1166     if p-change-value > 0
     1167     then do:
     1168       if frame Dialog-Frame :width + p-change-value >
     1169           session :width-chars
     1170       then do:
     1171         assign
     1172           p-change-value = session :width-chars - frame Dialog-Frame :width
     1173         .
     1174         if p-change-value <= 0
     1175         then do:
     1176           run diasize_position-resize-button in this-procedure .
     1177           return .
     1178         end.
     1179       end.
     1180     end.
     1181     if p-change-value < 0
     1182     then do:
     1183       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1184       then do:
     1185         assign
     1186           p-change-value = v-diasize-orig-frame-width
     1187                          - frame Dialog-Frame :width
     1188         .
     1189         if p-change-value >= 0
     1190         then do:
     1191           run diasize_position-resize-button in this-procedure .
     1192           return .
     1193         end.
     1194       end.
     1195     end.
     1196     if p-change-value >= 0
     1197     then do:
     1198       assign
     1199         v-change-sign = 1
     1200       .
     1201     end.
     1202     else do:
     1203       assign
     1204         v-change-sign = -1
     1205       .
     1206     end.
     1207     assign
     1208       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1209     .
     1210     if p-change-value = 0
     1211     then do:
     1212       run diasize_position-resize-button in this-procedure .
     1213       return .
     1214     end.
     1215     move_block:
     1216     do
     1217     on error undo move_block, leave move_block
     1218     :
     1219       if retry
     1220       then do:
     1221         do
     1222         on error undo move_block, leave move_block
     1223         :
     1224           if p-change-value > 0
     1225           then do:
     1226             for each buf_temp-diasize-handle
     1227             on error undo, next
     1228             :
     1229               assign
     1230                 v-object-handle = buf_temp-diasize-handle.handle-value
     1231               .
     1232               if v-object-handle <> v-diasize-resize-button
     1233               then do:
     1234                 assign
     1235                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1236                 .
     1237               end.
     1238             end.
     1239             assign
     1240               v-diasize-browse-handle :width = v-browse-width
     1241             .
     1242             for each buf_temp-browse-handle
     1243               where buf_temp-browse-handle.browse-type = 'width':u
     1244             on error undo, next
     1245             :
     1246               assign
     1247                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1248               .
     1249             end.
     1250             assign
     1251               frame Dialog-Frame :width = v-frame-width
     1252             .
     1253             if frame Dialog-Frame :scrollable = true
     1254             then do:
     1255               assign
     1256                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1257               .
     1258             end.
     1259             run diasize_position-resize-button in this-procedure .
     1260           end.
     1261           else do:
     1262             if frame Dialog-Frame :scrollable = true
     1263             then do:
     1264               assign
     1265                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1266               .
     1267             end.
     1268             assign
     1269               frame Dialog-Frame :width = v-frame-width
     1270             .
     1271             for each buf_temp-browse-handle
     1272               where buf_temp-browse-handle.browse-type = 'width':u
     1273             on error undo, next
     1274             :
     1275               assign
     1276                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1277               .
     1278             end.
     1279             assign
     1280               v-diasize-browse-handle :width = v-browse-width
     1281             .
     1282             for each buf_temp-diasize-handle
     1283             on error undo, next
     1284             :
     1285               assign
     1286                 v-object-handle = buf_temp-diasize-handle.handle-value
     1287               .
     1288               if v-object-handle <> v-diasize-resize-button
     1289               then do:
     1290                 assign
     1291                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1292                 .
     1293               end.
     1294             end.
     1295             run diasize_position-resize-button in this-procedure .
     1296           end.
     1297           assign
     1298             v-diasize-change-size = false
     1299           .
     1300           leave move_block .
     1301         end.
     1302       end.
     1303       assign
     1304         v-diasize-need-full-display = true
     1305       .
     1306       if v-diasize-change-size = false
     1307       then do:
     1308         assign
     1309           v-diasize-change-size = true
     1310         .
     1311       end.
     1312       else do:
     1313         return .
     1314       end.
     1315       assign
     1316         v-frame-width = frame Dialog-Frame :width
     1317         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1318         v-browse-width = v-diasize-browse-handle :width
     1319       .
     1320       for each buf_temp-browse-handle
     1321         where buf_temp-browse-handle.browse-type = 'width':u
     1322       :
     1323         assign
     1324           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1325         .
     1326       end.
     1327       for each buf_temp-diasize-handle
     1328       :
     1329         delete buf_temp-diasize-handle .
     1330       end.
     1331       assign
     1332         v-field-group-handle = frame Dialog-Frame :first-child
     1333       .
     1334       do while valid-handle(v-field-group-handle)
     1335       :
     1336         assign
     1337           v-object-handle = v-field-group-handle :first-child
     1338         .
     1339         do while valid-handle(v-object-handle)
     1340         :
     1341           if  v-object-handle <> v-diasize-browse-handle :handle
     1342           and v-object-handle <> v-diasize-resize-button
     1343           and can-query(v-object-handle, "row")
     1344           and can-query(v-object-handle, "height")
     1345           and ( v-object-handle :col + v-object-handle :width
     1346                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1347               )
     1348           then do:
     1349             find first buf_temp-browse-handle
     1350               where buf_temp-browse-handle.browse-type   = 'width':u
     1351                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1352               no-error .
     1353             if available buf_temp-browse-handle
     1354             then do:
     1355             end.
     1356             else do:
     1357               create buf_temp-diasize-handle .
     1358               assign
     1359                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1360                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1361               .
     1362             end.
     1363           end.
     1364           assign
     1365             v-object-handle = v-object-handle :next-sibling
     1366           .
     1367         end.
     1368         assign
     1369           v-field-group-handle = v-field-group-handle :next-sibling
     1370         .
     1371       end.
     1372       do with frame Dialog-Frame
     1373       :
     1374         hide v-diasize-resize-button .
     1375         v-diasize-resize-button :row = 1.
     1376         v-diasize-resize-button :column = 1.
     1377       end.
     1378       if p-change-value > 0
     1379       then do:
     1380         if frame Dialog-Frame :scrollable = true
     1381         then do:
     1382           assign
     1383             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1384             no-error .
     1385           if error-status :error
     1386           or error-status :get-message(1) <> ""
     1387           then do:
     1388             undo move_block, retry move_block.
     1389           end.
     1390         end.
     1391         assign
     1392           frame Dialog-Frame :width = v-frame-width + p-change-value
     1393           no-error .
     1394         if error-status :error
     1395         or error-status :get-message(1) <> ""
     1396         then do:
     1397           undo move_block, retry move_block.
     1398         end.
     1399         assign
     1400           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1401         no-error .
     1402         if error-status :error
     1403         or error-status :get-message(1) <> ""
     1404         then do:
     1405           undo move_block, retry move_block.
     1406         end.
     1407         for each buf_temp-browse-handle
     1408           where buf_temp-browse-handle.browse-type = 'width':u
     1409         on error undo move_block, retry move_block
     1410         :
     1411           assign
     1412             buf_temp-browse-handle.browse-handle :width
     1413               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1414             no-error .
     1415           if error-status :error
     1416           or error-status :get-message(1) <> ""
     1417           then do:
     1418             undo move_block, retry move_block .
     1419           end.
     1420         end.
     1421         for each buf_temp-diasize-handle
     1422         on error undo move_block, retry move_block
     1423         :
     1424           assign
     1425             v-object-handle = buf_temp-diasize-handle.handle-value
     1426           .
     1427           if v-object-handle <> v-diasize-resize-button
     1428           then do:
     1429             assign
     1430               v-object-handle :col = v-object-handle :col + p-change-value
     1431               no-error .
     1432             if error-status :error
     1433             or error-status :get-message(1) <> ""
     1434             then do:
     1435               undo move_block, retry move_block .
     1436             end.
     1437           end.
     1438         end.
     1439       end.
     1440       else do:
     1441         for each buf_temp-diasize-handle
     1442         on error undo move_block, retry move_block
     1443         :
     1444           assign
     1445             v-object-handle = buf_temp-diasize-handle.handle-value
     1446           .
     1447           if v-object-handle <> v-diasize-resize-button
     1448           then do:
     1449             assign
     1450               v-object-handle :col = v-object-handle :col + p-change-value
     1451               no-error .
     1452             if error-status :error
     1453             or error-status :get-message(1) <> ""
     1454             then do:
     1455               undo move_block, retry move_block .
     1456             end.
     1457           end.
     1458         end.
     1459         for each buf_temp-browse-handle
     1460           where buf_temp-browse-handle.browse-type = 'width':u
     1461         on error undo move_block, retry move_block
     1462         :
     1463           assign
     1464             buf_temp-browse-handle.browse-handle :width
     1465               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1466             no-error .
     1467           if error-status :error
     1468           or error-status :get-message(1) <> ""
     1469           then do:
     1470             undo move_block, retry move_block .
     1471           end.
     1472         end.
     1473         assign
     1474           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1475           no-error .
     1476         if error-status :error
     1477         or error-status :get-message(1) <> ""
     1478         then do:
     1479           undo move_block, retry move_block.
     1480         end.
     1481         assign
     1482           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1483         no-error .
     1484         if error-status :error
     1485         or error-status :get-message(1) <> ""
     1486         then do:
     1487           undo move_block, retry move_block.
     1488         end.
     1489         if frame Dialog-Frame :scrollable = true
     1490         then do:
     1491           assign
     1492             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1493           no-error .
     1494           if error-status :error
     1495           or error-status :get-message(1) <> ""
     1496           then do:
     1497             undo move_block, retry move_block.
     1498           end.
     1499         end.
     1500       end.
     1501       if p-move-resize
     1502       then do:
     1503         run diasize_position-resize-button in this-procedure .
     1504       end.
     1505       if v-diasize-wndstore = true
     1506       then do:
     1507         if connected("ub") = true
     1508         then do:
     1509           define variable v-cntxt-db-num        as integer   no-undo .
     1510           define variable v-cntxt-userid        as character no-undo .
     1511           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1512                                             , OUTPUT v-cntxt-userid
     1513                                             ) .
     1514           run gbl/wndsizew.p
     1515             (input  v-cntxt-db-num
     1516             ,input  v-cntxt-userid
     1517             ,input  v-diasize-proc-name
     1518             ,input  'width':u
     1519             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1520             ) .
     1521         end.
     1522       end.
     1523     end.
     1524     assign
     1525       v-diasize-change-size = false
     1526     .
     1527   end procedure.
     1528   procedure diasize_set-width :
     1529     define input  parameter p-new-width  as decimal   no-undo .
     1530     define input  parameter p-move-resize as logical   no-undo .
     1531     do
     1532     on error undo, return error return-value
     1533     :
     1534       run diasize_change-width in this-procedure
     1535         (input  (p-new-width - frame Dialog-Frame :width)
     1536         ,input  p-move-resize
     1537         ) .
     1538     end.
     1539   end procedure.
     1540   procedure diasize_position-resize-button :
     1541     do with frame Dialog-Frame
     1542     :
     1543       hide v-diasize-resize-button .
     1544       assign
     1545         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1546                     - 1
     1547                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1548         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1549                     - 1
     1550                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1551       .
     1552       view v-diasize-resize-button .
     1553     end.
     1554   end procedure.
     1555   on alt-right anywhere
     1556   do:
     1557     run diasize_change-width in this-procedure
     1558       (input 1
     1559       ,input true
     1560       ) .
     1561     return no-apply .
     1562   end.
     1563   on alt-left anywhere
     1564   do:
     1565     run diasize_change-width in this-procedure
     1566       (input -1
     1567       ,input true
     1568       ) .
     1569     return no-apply .
     1570   end.
     1571   on alt-down anywhere
     1572   do:
     1573     run diasize_change-height in this-procedure
     1574       (input 1
     1575       ,input true
     1576       ) .
     1577     return no-apply .
     1578   end.
     1579   on alt-up anywhere
     1580   do:
     1581     run diasize_change-height in this-procedure
     1582       (input -1
     1583       ,input true
     1584       ) .
     1585     return no-apply .
     1586   end.
     1587   on alt-enter of frame Dialog-Frame
     1588   do:
     1589     run diasize_maximize in this-procedure
     1590       (input  ?
     1591       ).
     1592     return no-apply .
     1593   end.
     1594   procedure diasize_end-move :
     1595     do
     1596     on error undo, return error return-value
     1597     :
     1598       define variable v-row-delta as decimal   no-undo .
     1599       define variable v-col-delta as decimal   no-undo .
     1600       define variable v-new-row as decimal   no-undo .
     1601       define variable v-new-col as decimal   no-undo .
     1602       assign
     1603         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1604         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1605       .
     1606       assign
     1607         v-row-delta = v-new-row - frame Dialog-Frame :height
     1608         v-col-delta = v-new-col - frame Dialog-Frame :width
     1609       .
     1610       run diasize_change-height in this-procedure
     1611         (input v-row-delta
     1612         ,input true
     1613         ) .
     1614       run diasize_change-width in this-procedure
     1615         (input v-col-delta
     1616         ,input true
     1617         ) .
     1618     end.
     1619   end procedure.
     1620   procedure diasize_maximize :
     1621     define input  parameter p-action as logical   no-undo .
     1622     do
     1623     on error undo, return error return-value
     1624     :
     1625       if p-action = ?
     1626       then do:
     1627         if v-diasize-need-maximize = true
     1628         then do:
     1629           assign
     1630             p-action = true
     1631           .
     1632         end.
     1633         else do:
     1634           assign
     1635             p-action = false
     1636           .
     1637         end.
     1638       end.
     1639       if p-action = true
     1640       then do:
     1641         run diasize_change-height in this-procedure
     1642           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1643               - frame Dialog-Frame :height-chars
     1644           ,input true
     1645           ) .
     1646         run diasize_change-width in this-procedure
     1647           (input session :width-chars
     1648               - frame Dialog-Frame :width-chars
     1649           ,input true
     1650           ) .
     1651         assign
     1652           v-diasize-need-maximize = false
     1653         .
     1654       end.
     1655       else do:
     1656         run diasize_change-width in this-procedure
     1657           (input v-diasize-orig-frame-width
     1658               - frame Dialog-Frame :width-chars
     1659           ,input true
     1660           ) .
     1661         run diasize_change-height in this-procedure
     1662           (input v-diasize-orig-frame-height
     1663               - frame Dialog-Frame :height-chars
     1664           ,input true
     1665           ) .
     1666         assign
     1667           v-diasize-need-maximize = true
     1668         .
     1669       end.
     1670     end.
     1671   end procedure.
     1672   procedure diasize_restore-orig-size :
     1673     do
     1674     on error undo, return error return-value
     1675     :
     1676       assign
     1677         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1678         v-diasize-current-frame-height = frame Dialog-Frame :height
     1679       .
     1680       run diasize_set-height in this-procedure
     1681         (input  v-diasize-orig-frame-height
     1682         ,input  true
     1683         ) .
     1684       run diasize_set-width in this-procedure
     1685         (input  v-diasize-orig-frame-width
     1686         ,input  true
     1687         ) .
     1688     end.
     1689   end procedure.
     1690   procedure diasize_restore-current-size :
     1691     do
     1692     on error undo, return error return-value
     1693     :
     1694       run diasize_set-height in this-procedure
     1695         (input  v-diasize-current-frame-height
     1696         ,input  true
     1697         ) .
     1698       run diasize_set-width in this-procedure
     1699         (input  v-diasize-current-frame-width
     1700         ,input  true
     1701         ) .
     1702     end.
     1703   end procedure.
     1704   procedure diasize_set-browse-handle :
     1705     define input  parameter p-browse-handle as handle   no-undo .
     1706     define buffer buf_temp-browse-handle for temp-browse-handle .
     1707     do
     1708     on error undo, return error return-value
     1709     :
     1710       assign
     1711         v-diasize-browse-handle = p-browse-handle
     1712       .
     1713       for each buf_temp-browse-handle
     1714       on error undo, return error return-value
     1715       :
     1716         delete buf_temp-browse-handle .
     1717       end.
     1718     end.
     1719   end procedure.
     1720   procedure diasize_add_browse :
     1721     define input  parameter p-browse-type   as character no-undo .
     1722     define input  parameter p-browse-handle as handle    no-undo .
     1723     define buffer buf_temp-browse-handle for temp-browse-handle .
     1724     do
     1725     on error undo, return error return-value
     1726     :
     1727       assign
     1728         v-diasize-browse-number = v-diasize-browse-number + 1
     1729       .
     1730       create buf_temp-browse-handle .
     1731       assign
     1732         buf_temp-browse-handle.browse-type   = p-browse-type
     1733         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1734         buf_temp-browse-handle.browse-handle = p-browse-handle
     1735       .
     1736     end.
     1737   end procedure.
     1738   procedure diasize_init :
     1739     define variable v-default-value    as logical   no-undo .
     1740     define variable v-restore-saved    as logical   no-undo .
     1741     define variable v-resize-value-str as character no-undo .
     1742     do
     1743     on error undo, return error return-value
     1744     :
     1745       do with frame Dialog-Frame
     1746       :
     1747         assign
     1748           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1749           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1750           v-diasize-browse-handle     = browse BR-cash-desk :handle
     1751         .
     1752         create button v-diasize-resize-button
     1753         assign
     1754           parent        = frame Dialog-Frame :first-child
     1755           label         = "s"
     1756           height-pixels = 16
     1757           width-pixels  = 16
     1758           visible       = true
     1759           sensitive     = true
     1760           movable       = true
     1761           triggers:
     1762             on end-move persistent run diasize_end-move in this-procedure .
     1763           end triggers.
     1764         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1765         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1766         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1767         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1768         assign
     1769           v-diasize-wndmax = false
     1770         .
     1771         if connected("ub") = true
     1772         then do:
     1773           define variable v-cntxt-db-num        as integer   no-undo .
     1774           define variable v-cntxt-userid        as character no-undo .
     1775           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1776                                             , OUTPUT v-cntxt-userid
     1777                                             ) .
     1778           run gbl/wndpar_r.p
     1779             (input  v-cntxt-db-num
     1780             ,input  v-cntxt-userid
     1781             ,input  'wndmax':U
     1782             ,output v-diasize-wndmax
     1783             ,output v-default-value
     1784             ) .
     1785         end.
     1786         assign
     1787           v-diasize-wndstore = false
     1788         .
     1789         if connected("ub") = true
     1790         then do:
     1791           run gbl/wndpar_r.p
     1792             (input  v-cntxt-db-num
     1793             ,input  v-cntxt-userid
     1794             ,input  'wndstore':U
     1795             ,output v-diasize-wndstore
     1796             ,output v-default-value
     1797             ) .
     1798         end.
     1799         assign
     1800           v-diasize-proc-name = entry(1, program-name(2), '.')
     1801         .
     1802         if v-diasize-wndstore = true
     1803         then do:
     1804           assign
     1805             v-restore-saved = false
     1806           .
     1807           if connected("ub") = true
     1808           then do:
     1809             run gbl/wndsizer.p
     1810               (input  v-cntxt-db-num
     1811               ,input  v-cntxt-userid
     1812               ,input  v-diasize-proc-name
     1813               ,input  'height':u
     1814               ,output v-resize-value-str
     1815               ) .
     1816             if v-resize-value-str <> '':U
     1817             then do:
     1818               run diasize_change-height in this-procedure
     1819                 (input  integer(v-resize-value-str)
     1820                 ,input  true
     1821                 ) .
     1822               assign
     1823                 v-restore-saved = true
     1824               .
     1825             end.
     1826           end.
     1827           if connected("ub") = true
     1828           then do:
     1829             run gbl/wndsizer.p
     1830               (input  v-cntxt-db-num
     1831               ,input  v-cntxt-userid
     1832               ,input  v-diasize-proc-name
     1833               ,input  'width':u
     1834               ,output v-resize-value-str
     1835               ) .
     1836             if v-resize-value-str <> '':U
     1837             then do:
     1838               run diasize_change-width in this-procedure
     1839                 (input  integer(v-resize-value-str)
     1840                 ,input  true
     1841                 ) .
     1842               assign
     1843                 v-restore-saved = true
     1844               .
     1845             end.
     1846           end.
     1847           if v-restore-saved <> true
     1848           then do:
     1849             if v-diasize-wndmax = true
     1850             then do:
     1851               run diasize_maximize in this-procedure
     1852                 (input  true
     1853                 ) .
     1854             end.
     1855           end.
     1856         end.
     1857         else do:
     1858           if v-diasize-wndmax = true
     1859           then do:
     1860             run diasize_maximize in this-procedure
     1861               (input  true
     1862               ) .
     1863           end.
     1864         end.
     1865       end.
     1866     end.
     1867   end procedure.
     1868   procedure diasize_need-full-display :
     1869     define output parameter p-need-full-display as logical   no-undo .
     1870     do
     1871     on error undo, return error return-value
     1872     :
     1873       assign
     1874         p-need-full-display = v-diasize-need-full-display
     1875       .
     1876       assign
     1877         v-diasize-need-full-display = false
     1878       .
     1879     end.
     1880   end procedure.
     1881   procedure get-context :
     1882      define output parameter p-db-num as integer          no-undo.
     1883      define output parameter p-user-id as character        no-undo.
     1884      define variable v-login               as character    no-undo.
     1885      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1886      define buffer buf_user-login  for ub.user-login .
     1887      do
     1888      on error undo, return error
     1889      :
     1890            FIND FIRST buf_sys-ctrl no-lock.
     1891            ASSIGN
     1892               v-login = USERID("ub")
     1893               p-db-num = buf_sys-ctrl.db-num
     1894            .
     1895            FIND FIRST buf_user-login
     1896                 WHERE buf_user-login.db-num = p-db-num
     1897                   AND buf_user-login.user-login = v-login
     1898                 no-lock
     1899                 no-error
     1900                 .
     1901            IF AVAILABLE buf_user-login
     1902            THEN DO:
     1903               assign
     1904                  p-user-id = buf_user-login.user-id
     1905               .
     1906            END.
     1907      end.
     1908   end procedure.
     1909       run diasize_init in this-procedure .
     1910   MAIN-BLOCK:
     1911   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1912      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1913   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1914     run mainmenu_getcntxt in parparentproc
     1915       (output v-cntxt-db-num
     1916       ,output v-cntxt-userid
     1917       ,output v-cntxt-level
     1918       ,output v-cntxt-host-code-obj
     1919       ,output v-cntxt-obj-type
     1920       ,output v-cntxt-obj-code
     1921       ,output v-cntxt-db-num-obj
     1922       ,output v-cntxt-is-admin
     1923       ) .
     1924     RUN Myenable IN THIS-PROCEDURE .
     1925     WAIT-FOR GO OF FRAME Dialog-Frame.
     1926   END.
     1927   RUN disable_UI.
     1928   PROCEDURE cb_get-cash-desk-list :
     1929   DEFINE INPUT PARAMETER p-callback-handle AS HANDLE NO-UNDO.
     1930   DEFINE BUFFER buf_tt-cash-desk FOR tt-cash-desk.
     1931   FOR EACH buf_tt-cash-desk:
     1932     RUN cb_set-cash-desk-list IN p-callback-handle
     1933         ( INPUT buf_tt-cash-desk.db-num
     1934           ,INPUT buf_tt-cash-desk.obj-code
     1935           ,INPUT buf_tt-cash-desk.pos-type
     1936           ,INPUT buf_tt-cash-desk.cash-num
     1937           ,INPUT buf_tt-cash-desk.VERSION ) NO-ERROR.
     1938     IF ERROR-STATUS:ERROR THEN DO:
     1939         UNDO, RETURN ERROR substitute("Ошибка при задании списка касс:&1&2&1&3"
     1940                                       , chr(10)
     1941                                       , ERROR-STATUS:GET-MESSAGE(1)
     1942                                       , RETURN-VALUE).
     1943     END.
     1944   END.
     1945   END PROCEDURE.
     1946   PROCEDURE disable_UI :
     1947     HIDE FRAME Dialog-Frame.
     1948   END PROCEDURE.
     1949   PROCEDURE enable_UI :
     1950     DISPLAY f-path f-path2 rs-action
     1951         WITH FRAME Dialog-Frame.
     1952     ENABLE B-exit b-quit B-Help f-path b-file f-path2 rs-action b-mark B-add
     1953            B-add-object B-add-db B-add-all B-del B-del-obj B-del-db B-del-all
     1954            BR-cash-desk
     1955         WITH FRAME Dialog-Frame.
     1956     VIEW FRAME Dialog-Frame.
     1957     OPEN QUERY BR-cash-desk FOR EACH tt-cash-desk NO-LOCK INDEXED-REPOSITION.
     1958   END PROCEDURE.
     1959   PROCEDURE MyEnable :
     1960   DISPLAY f-path
     1961   WITH FRAME Dialog-Frame.
     1962   ENABLE
     1963   B-exit
     1964   b-quit
     1965   B-Help
     1966   b-file
     1967   b-mark
     1968   B-add
     1969   B-add-object
     1970   B-add-db
     1971   B-add-all
     1972   B-del
     1973   B-del-obj
     1974   B-del-db
     1975   B-del-all
     1976   f-path
     1977   rs-action
     1978   BR-cash-desk
     1979   WITH FRAME Dialog-Frame.
     1980   VIEW FRAME Dialog-Frame.
     1981   END PROCEDURE.
     1982   PROCEDURE proc-add-cd :
     1983   DEFINE parameter BUFFER buf_cash-desk FOR ub.cash-desk.
     1984   DEFINE BUFFER buf_tt-cash-desk FOR tt-cash-desk.
     1985   FIND FIRST buf_tt-cash-desk NO-LOCK WHERE
     1986            buf_tt-cash-desk.db-num = buf_cash-desk.db-num
     1987       AND  buf_tt-cash-desk.obj-code = buf_cash-desk.obj-code
     1988       AND  buf_tt-cash-desk.pos-type = buf_cash-desk.pos-type
     1989       AND  buf_tt-cash-desk.cash-num = buf_cash-desk.cash-num NO-ERROR.
     1990   IF NOT available buf_tt-cash-desk THEN DO:
     1991     if v-cntxt-db-num = 0
     1992     or buf_cash-desk.db-num = v-cntxt-db-num then do:
     1993       CREATE buf_tt-cash-desk.
     1994       BUFFER-COPY buf_cash-desk TO buf_tt-cash-desk.
     1995       RELEASE buf_tt-cash-desk.
     1996     end.
     1997   END.
     1998   END PROCEDURE.
     1999   PROCEDURE proc-b-add :
     2000   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2001   DEFINE VARIABLE v-rid AS RECID NO-UNDO.
     2002   DEFINE VARIABLE v-loc-rid-list AS character NO-UNDO.
     2003   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     2004   define variable v-other-pos-type as logical no-undo .
     2005   define variable v-obj-db-num as integer no-undo .
     2006   DEFINE BUFFER buf_cash-desk FOR ub.cash-desk.
     2007   DEFINE BUFFER buf_db FOR ub.db.
     2008   DEFINE BUFFER buf_shop FOR ub.shop.
     2009   CASE p-option:
     2010     WHEN 'все':U THEN DO:
     2011        FOR EACH buf_cash-desk NO-LOCK WHERE
     2012                buf_cash-desk.pos-type = 'IBM-XML':U:
     2013           IF  buf_cash-desk.is-del = yes THEN NEXT.
     2014          RUN proc-add-cd IN THIS-PROCEDURE ( BUFFER buf_Cash-desk).
     2015        END.
     2016     END.
     2017     WHEN "db" THEN DO:
     2018       run adm/dbs.w (
     2019                  input ?
     2020                 ,input 'ПРОСМОТР':U
     2021                 ,output v-rid) NO-ERROR.
     2022       IF v-rid <> ?  THEN DO:
     2023           find FIRST buf_db NO-LOCK WHERE recid (buf_db) = v-rid .
     2024          FOR EACH buf_cash-desk NO-LOCK WHERE
     2025                  buf_cash-desk.pos-type = 'IBM-XML':U
     2026              AND buf_cash-desk.is-del = NO
     2027              AND buf_cash-desk.db-num = buf_db.db-num:
     2028             RUN proc-add-cd IN THIS-PROCEDURE ( BUFFER buf_Cash-desk).
     2029          END.
     2030       END.
     2031     END.
     2032     WHEN 'объект':U THEN DO:
     2033      run adm/shops.w ( input parparentproc
     2034                          ,input "b-sel,b-mark"
     2035                          ,input-output v-loc-rid-list
     2036                          ,no ) NO-ERROR.
     2037      if v-loc-rid-list <> "":U then DO:
     2038        do v-ii = 1 to num-entries(v-loc-rid-list):
     2039        find first buf_shop no-lock where
     2040             recid(buf_shop) = integer(entry(v-ii, v-loc-rid-list) ).
     2041   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2042   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2043     (input  'маг':U
     2044     ,input  buf_shop.obj-code
     2045     ,output v-obj-db-num
     2046     )  .
     2047       FOR EACH buf_cash-desk NO-LOCK WHERE
     2048           buf_cash-desk.pos-type = 'IBM-XML':U
     2049       AND buf_cash-desk.is-del = NO
     2050       AND buf_cash-desk.db-num = v-obj-db-num
     2051       AND buf_Cash-desk.obj-code = buf_shop.obj-code:
     2052         RUN proc-add-cd IN THIS-PROCEDURE ( BUFFER buf_Cash-desk).
     2053        END.
     2054        end.
     2055       END.
     2056     END.
     2057     WHEN '' THEN DO:
     2058       run ref/cashlist.w (input parparentproc
     2059                     ,INPUT "b-sel,b-mark"
     2060                     ,INPUT (if v-cntxt-db-num = 0 then 'все':U else "db")
     2061                     ,INPUT v-cntxt-db-num
     2062                     ,INPUT v-cntxt-host-code-obj
     2063                     ,INPUT v-cntxt-obj-type
     2064                     ,INPUT v-cntxt-obj-code
     2065                     ,INPUT ?
     2066                     ,OUTPUT v-loc-rid-list) NO-ERROR.
     2067       IF v-loc-rid-list <> '':U THEN DO:
     2068         DO v-ii = 1 TO NUM-ENTRIES(v-loc-rid-list):
     2069           FIND FIRST buf_Cash-desk NO-LOCK WHERE
     2070                   RECID(buf_cash-desk) = INTEGER(ENTRY(v-ii, v-loc-rid-list)) NO-ERROR.
     2071           IF AVAILABLE buf_Cash-desk THEN DO:
     2072             if buf_cash-desk.pos-type = 'IBM-XML':U then do:
     2073               RUN proc-add-cd IN THIS-PROCEDURE ( BUFFER buf_Cash-desk).
     2074             end.
     2075             else do:
     2076               v-other-pos-type = yes.
     2077             end.
     2078           END.
     2079         END.
     2080         if v-other-pos-type = yes then do:
     2081           message
     2082           substitute("Добавлены только кассы типа &1", 'IBM-XML':U)
     2083           view-as alert-box warning.
     2084         end.
     2085       END.
     2086     END.
     2087   END CASE.
     2088   OPEN QUERY BR-cash-desk FOR EACH tt-cash-desk NO-LOCK INDEXED-REPOSITION.
     2089   APPLY "ENTRY" to br-cash-desk in frame Dialog-Frame .
     2090   END PROCEDURE.
     2091   PROCEDURE proc-b-del :
     2092   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2093   DEFINE VARIABLE v-rid AS RECID NO-UNDO.
     2094   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     2095   DEFINE VARIABLE v-local-rid-list AS character NO-UNDO.
     2096   DEFINE VARIABLE v-local2-rid-list AS character NO-UNDO.
     2097   define variable v-entry-ii as integer no-undo .
     2098   define variable v-obj-db-num as integer no-undo .
     2099   DEFINE BUFFER buf_tt-cash-desk FOR tt-cash-desk.
     2100   DEFINE BUFFER buf_db FOR ub.db.
     2101   DEFINE BUFFER buf_shop FOR ub.shop.
     2102   CASE p-option:
     2103     WHEN 'все':U THEN DO:
     2104       FOR EACH buf_tt-cash-desk :
     2105           DELETE buf_tt-cash-desk.
     2106       END.
     2107       v-rid-list = ''.
     2108     END.
     2109     WHEN "db" THEN DO:
     2110       run adm/dbs.w (
     2111                  input ?
     2112                 ,input 'ПРОСМОТР':U
     2113                 ,output v-rid) NO-ERROR.
     2114       IF v-rid <> ?  THEN DO:
     2115          find FIRST buf_db NO-LOCK WHERE recid (buf_db) = v-rid .
     2116          FOR EACH buf_tt-cash-desk NO-LOCK WHERE
     2117                  buf_tt-cash-desk.pos-type = 'IBM-XML':U
     2118               AND buf_tt-cash-desk.db-num = buf_db.db-num:
     2119           v-local-rid-list = v-rid-list.
     2120           v-entry-ii = lookup(string(recid(buf_tt-cash-desk)), v-local-rid-list).
     2121           if v-entry-ii > 0 then do:
     2122             entry(v-entry-ii,  v-local-rid-list) = ''.
     2123             v-local-rid-list = REPLACE(v-local-rid-list, chr(44) + chr(44), chr(44)).
     2124             v-local-rid-list = TRIM(v-local-rid-list, chr(44)).
     2125           end.
     2126           v-rid-list = v-local-rid-list.
     2127           DELETE buf_tt-cash-desk.
     2128         END.
     2129       END.
     2130     END.
     2131     WHEN 'объект':U THEN DO:
     2132       run adm/shops.w ( input parparentproc
     2133                          ,input "b-sel,b-mark"
     2134                          ,input-output v-local2-rid-list
     2135                          ,no ) NO-ERROR.
     2136       if v-local2-rid-list <> "":U then DO:
     2137         do v-ii = 1 to num-entries(v-local2-rid-list):
     2138         find first buf_shop no-lock where
     2139             recid(buf_shop) = integer(entry(v-ii, v-local2-rid-list)) .
     2140   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2141   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2142     (input  'маг':U
     2143     ,input  buf_shop.obj-code
     2144     ,output v-obj-db-num
     2145     )  .
     2146         FOR EACH buf_tt-cash-desk NO-LOCK WHERE
     2147             buf_tt-cash-desk.pos-type = 'IBM-XML':U
     2148         AND buf_tt-cash-desk.db-num = v-obj-db-num
     2149         AND buf_tt-Cash-desk.obj-code = buf_shop.obj-code:
     2150           v-local-rid-list = v-rid-list.
     2151           v-entry-ii = lookup(string(recid(buf_tt-cash-desk)), v-local-rid-list).
     2152           if v-entry-ii > 0 then do:
     2153             entry(v-entry-ii,  v-local-rid-list) = ''.
     2154             v-local-rid-list = REPLACE(v-local-rid-list, chr(44) + chr(44), chr(44)).
     2155             v-local-rid-list = TRIM(v-local-rid-list, chr(44)).
     2156           end.
     2157           v-rid-list = v-local-rid-list.
     2158           DELETE buf_tt-cash-desk.
     2159         END.
     2160         end.
     2161       END.
     2162     END.
     2163     WHEN '' THEN DO:
     2164       IF v-rid-list <> '':U THEN DO:
     2165         v-local-rid-list = v-rid-list.
     2166         DO v-ii = 1 TO NUM-ENTRIES(v-rid-list):
     2167           FIND FIRST buf_tt-Cash-desk NO-LOCK WHERE
     2168                   RECID(buf_tt-cash-desk) = INTEGER(ENTRY(v-ii, v-rid-list)) NO-ERROR.
     2169           IF AVAILABLE buf_tt-Cash-desk THEN DO:
     2170             ENTRY( LOOKUP(string(recid(buf_tt-cash-desk)), v-local-rid-list) , v-local-rid-list) = ''.
     2171             v-local-rid-list = REPLACE(v-local-rid-list, chr(44) + chr(44), chr(44)).
     2172             v-local-rid-list = TRIM(v-local-rid-list, chr(44)).
     2173             DELETE buf_tt-cash-desk.
     2174           END.
     2175         END.
     2176         v-rid-list = v-local-rid-list.
     2177       END.
     2178       else do:
     2179         FIND FIRST buf_tt-Cash-desk NO-LOCK WHERE
     2180                 RECID(buf_tt-cash-desk) = recid(tt-cash-desk) NO-ERROR.
     2181         IF AVAILABLE buf_tt-Cash-desk THEN DO:
     2182           DELETE buf_tt-cash-desk.
     2183         END.
     2184       end.
     2185     END.
     2186   END CASE.
     2187   OPEN QUERY BR-cash-desk FOR EACH tt-cash-desk NO-LOCK INDEXED-REPOSITION.
     2188   APPLY "ENTRY" to br-cash-desk in frame Dialog-Frame .
     2189   END PROCEDURE.
     2190   PROCEDURE proc-b-file :
     2191   define variable v_os-file   AS CHAR NO-UNDO INIT "".
     2192   define variable ll_commit AS LOG    NO-UNDO INIT NO.
     2193   define variable v-full-path        as character no-undo .
     2194   define variable v-path             as character no-undo .
     2195   define variable v-file-name        as character no-undo .
     2196   define variable v-file-name-no-ext as character no-undo .
     2197   define variable v-file-name-ext    as character no-undo .
     2198   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2199   run gbl/dm-file.p ( INPUT (
     2200                     "|" + " XML файлы (*.xml) " + "|" + "*.xml"
     2201                   + "|" + " Все файлы (*.*) "  + "|" +  "*.*")
     2202                   ,INPUT "."
     2203                   ,INPUT "Выберите один или несколько файлов"
     2204                   ,input frame Dialog-Frame:hwnd
     2205                   ,OUTPUT v_os-file
     2206                   ,OUTPUT ll_commit
     2207                               ).
     2208   IF ll_commit <> YES THEN do:
     2209      RETURN error.
     2210   end.
     2211   _ii:
     2212   DO ii = 1 TO NUM-ENTRIES (v_os-file, "|"):
     2213       run gbl/filename.p (
     2214                        input  entry(ii, v_os-file, '|')
     2215                       ,output v-full-path
     2216                       ,output v-path
     2217                       ,output v-file-name
     2218                       ,output v-file-name-no-ext
     2219                       ,output v-file-name-ext
     2220                       ) no-error .
     2221       if error-status:error  = ? then do:
     2222         message
     2223         substitute("Ошибка при поиске файла файла &1&2" +
     2224                    "возможно файл уже удален"
     2225                    , v-full-path
     2226                    , chr(10))
     2227        view-as alert-box error .
     2228        next _ii.
     2229       end.
     2230       assign
     2231       f-path = prepare-path(v-full-path).
     2232       DISPLAY
     2233       f-path
     2234       WITH FRAME Dialog-Frame.
     2235       f-path2 = prepare-path2(v-full-path).
     2236       define variable v-unc as character no-undo .
     2237       run gbl/get-unc.p ( input f-path2, output v-unc) no-error.
     2238       if not error-status :error then do:
     2239         assign
     2240         f-path2 = v-unc.
     2241       end.
     2242       DISPLAY
     2243       f-path2
     2244       WITH FRAME Dialog-Frame.
     2245   END.
     2246   END PROCEDURE.
