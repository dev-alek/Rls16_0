        1   DEFINE TEMP-TABLE tt0-rp-by-call NO-UNDO LIKE ub.rp-by-call.
        2   DEFINE TEMP-TABLE tt0-rule-by-call NO-UNDO LIKE ub.rule-by-call.
        3   DEFINE NEW SHARED TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
        4   DEFINE BUFFER X_rp-by-call FOR ub.rp-by-call.
        5   DEFINE BUFFER X_rule FOR ub.rule.
        6   DEFINE BUFFER X_rule-by-call FOR ub.rule-by-call.
        7   DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
        8   DEFINE BUFFER X_ruleset FOR ub.ruleset.
        9   define input parameter parparentproc as widget-handle no-undo .
       10   define input parameter p-parent-handle  as widget-handle no-undo .
       11   define input parameter p-log-handle  as handle no-undo .
       12   define input parameter p-parameter   as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Запуск RUM".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     define variable v-cntxt-db-num        as integer   no-undo .
      126     define variable v-cntxt-userid        as character no-undo .
      127     define variable v-cntxt-level         as character no-undo .
      128     define variable v-cntxt-host-code-obj as integer   no-undo .
      129     define variable v-cntxt-obj-type      as character no-undo .
      130     define variable v-cntxt-obj-code      as integer   no-undo .
      131     define variable v-cntxt-db-num-obj    as integer   no-undo .
      132     define variable v-cntxt-is-admin      as logical   no-undo .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   procedure gen-key-rec :
      361     define input  parameter p-tbl-name    as character no-undo.
      362     define input  parameter p-bh_tbl-name as handle    no-undo.
      363     define output parameter p-key-rec     as character no-undo.
      364     do
      365     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      366     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      367     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      368     :
      369       define variable fh               as handle    no-undo .
      370       define variable v-ok             as logical   no-undo .
      371       define variable v-inform         as character no-undo .
      372       define variable v-ind            as integer   no-undo .
      373       define variable v-idx-field-qnty as integer   no-undo .
      374       if p-tbl-name = ?
      375         or p-tbl-name = "":U
      376       then do:
      377         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      378       end.
      379       if not p-bh_tbl-name:available then do:
      380         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      381       end.
      382       assign
      383         p-key-rec = p-tbl-name
      384         v-inform  = p-bh_tbl-name:index-information(1)
      385         v-ind     = 2
      386       .
      387       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      388       on error undo, return error
      389       :
      390         assign
      391           v-inform = p-bh_tbl-name:index-information( v-ind )
      392           v-ind    = v-ind + 1
      393         .
      394       end.
      395       if v-inform = ?
      396         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      397         or entry( 3, v-inform, ",":U ) <> "1":U
      398       then do:
      399         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      400       end.
      401       else do:
      402         assign
      403           v-idx-field-qnty = num-entries( v-inform ) - 4
      404         .
      405         if v-idx-field-qnty < 2 then do:
      406           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      407         end.
      408         do v-ind = 1 to v-idx-field-qnty by 2
      409         on error undo, return error
      410         :
      411           assign
      412             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      413             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      414           .
      415         end.
      416       end.
      417       if p-key-rec = ? then do:
      418         assign
      419           p-key-rec = "":U
      420         .
      421         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      422       end.
      423     end.
      424     return.
      425   end procedure.
      426   procedure gen-where-keyr-tab :
      427     define input  parameter i-tableSerach as character no-undo.
      428     define input  parameter i-tablekey   as character  no-undo.
      429     define input  parameter p-key-rec    as character  no-undo.
      430     define input  parameter p-key-handle as handle     no-undo .
      431     define input  parameter p-db-name    as character  no-undo .
      432     define input  parameter p-tt-handle  as handle     no-undo .
      433     define output parameter o-Where      as character  no-undo.
      434     do
      435     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      436     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      437     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      438     :
      439       define variable v-full-tbl-name  as character no-undo .
      440       define variable bh_tbl-name      as handle    no-undo .
      441       define variable fh_key           as handle    no-undo .
      442       define variable fh_search        as handle    no-undo .
      443       define variable v-field-num      as integer   no-undo .
      444       define variable v-count-fld      as integer   no-undo .
      445       define variable v-inform         as character no-undo .
      446       define variable v-ind            as integer   no-undo .
      447       define variable v-idx-field-qnty as integer   no-undo .
      448       define variable v-field-name     as character no-undo .
      449       define variable v-field-val      as character no-undo .
      450       define variable v-word-link      as character no-undo .
      451       define variable vTable           as character no-undo.
      452       define variable bh_tbl-key       as handle    no-undo .
      453       assign
      454         p-key-rec = trim( p-key-rec )
      455       .
      456       if p-key-handle <> ? then do:
      457         if not valid-handle(p-key-handle)
      458            or p-key-handle:type <> "buffer"
      459         then do:
      460           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      461         end.
      462         if num-entries( p-key-rec, chr(3) ) > 1
      463           or p-key-rec = ?
      464           or p-key-rec = "":U
      465         then do:
      466           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      467         end.
      468       end.
      469       else do:
      470         if p-key-rec = ?
      471           or p-key-rec = "":U
      472         then do:
      473           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      474         end.
      475       end.
      476       assign
      477         vTable = entry( 1 , p-key-rec, chr(3) )
      478       .
      479       if p-tt-handle <> ?
      480         and ( not valid-handle(p-tt-handle)
      481               or p-tt-handle:type <> "buffer"
      482             )
      483       then do:
      484         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      485       end.
      486       if p-tt-handle = ? then do:
      487         assign
      488           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      489         .
      490         create buffer bh_tbl-name for table v-full-tbl-name .
      491       end.
      492       else do:
      493         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      494       end.
      495       assign
      496         v-inform = bh_tbl-name:index-information(1)
      497         v-ind    = 2
      498       .
      499       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      500       on error undo, return error
      501       :
      502         assign
      503           v-inform = bh_tbl-name:index-information( v-ind )
      504           v-ind    = v-ind + 1
      505         .
      506       end.
      507       if v-inform = ?
      508         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      509         or entry( 3, v-inform, ",":U ) <> "1":U
      510       then do:
      511         delete object bh_tbl-name no-error.
      512         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      513       end.
      514       assign
      515         v-idx-field-qnty = num-entries( v-inform ) - 4
      516       .
      517       if v-idx-field-qnty < 2 then do:
      518         delete object bh_tbl-name no-error.
      519         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      520       end.
      521       assign
      522         o-where     = "where":U
      523         v-word-link = "":U
      524         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      525         v-count-fld = 0
      526       .
      527       if i-tablekey ne "" and i-tablekey ne ?
      528       then do:
      529         assign
      530           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      531         .
      532         create buffer bh_tbl-key for table v-full-tbl-name .
      533       end.
      534       if i-tableSerach ne "" and i-tableSerach ne ?
      535       then do:
      536         delete object bh_tbl-name no-error.
      537         assign
      538           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      539         .
      540         create buffer bh_tbl-name for table v-full-tbl-name .
      541       end.
      542       block_where:
      543       do v-ind = 1 to v-idx-field-qnty by 2
      544       on error undo, return error
      545       :
      546         assign
      547           v-count-fld = v-count-fld + 1
      548         .
      549         if p-key-handle = ?
      550           and v-count-fld > v-field-num
      551         then do:
      552           leave block_where.
      553         end.
      554         define variable VfieldKeyTable as handle no-undo.
      555         assign
      556           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      557           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      558         .
      559         if     bh_tbl-key ne ?
      560         then do:
      561            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      562            if VfieldKeyTable eq ?
      563            then next block_where.
      564         end.
      565         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      566         then
      567            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      568         else
      569            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      570         if p-key-handle = ? then do:
      571           assign
      572             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      573           .
      574         end.
      575         else do:
      576           assign
      577             fh_key = p-key-handle:buffer-field( v-field-name )
      578           .
      579           if fh_key = ?
      580             or not valid-handle( fh_key )
      581           then do:
      582             delete object bh_tbl-name.
      583             if     bh_tbl-key ne ?
      584             then
      585                delete object bh_tbl-key.
      586             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      587           end.
      588           assign
      589             v-field-val = fh_key:buffer-value
      590           .
      591         end.
      592         if fh_search:data-type ="character":U then do:
      593           assign
      594             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      595             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      596             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      597             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      598             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      599             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      600             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      601             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      602             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      603             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      604             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      605             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      606             v-field-val = substitute( '"&1"', v-field-val )
      607           .
      608         end.
      609         assign
      610           o-where = substitute( "&1 &2", o-where, v-field-val )
      611         .
      612         if v-word-link = "":U then do:
      613           assign
      614             v-word-link = "and":U
      615           .
      616         end.
      617       end.
      618       delete object bh_tbl-name.
      619       if     bh_tbl-key ne ?
      620       then
      621          delete object bh_tbl-key.
      622       if p-key-handle = ?
      623         and v-count-fld <> v-field-num
      624       then do:
      625         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      626       end.
      627     end.
      628   end procedure.
      629   procedure gen-hn-keyr-tab :
      630     define input  parameter i-tableSerach as character no-undo.
      631     define input  parameter i-tablekey   as character no-undo.
      632     define input  parameter p-key-rec    as character no-undo.
      633     define input  parameter p-key-handle as handle    no-undo .
      634     define input  parameter p-db-name    as character no-undo .
      635     define input  parameter p-tt-handle  as handle    no-undo .
      636     define input  parameter p-stts-lock  as integer   no-undo .
      637     define output parameter o-hn         as handle    no-undo.
      638     define variable v-full-tbl-name as character no-undo.
      639     define variable v-where         as character no-undo.
      640     define variable bh_tbl-name     as handle    no-undo.
      641     define variable vTable          as character no-undo.
      642     do
      643     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      644     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      645     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      646         run gen-where-keyr-tab(i-tableSerach,
      647                                i-tablekey,
      648                                p-key-rec,
      649                                p-key-handle,
      650                                p-db-name,
      651                                p-tt-handle,
      652                                output v-where).
      653         if i-tableSerach ne "" and i-tableSerach ne ?
      654         then do:
      655            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      656            create buffer bh_tbl-name for table v-full-tbl-name .
      657         end.
      658         else do:
      659            if p-tt-handle = ? then do:
      660               assign
      661                  vTable = entry( 1 , p-key-rec, chr(3) )
      662               .
      663               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      664               create buffer bh_tbl-name for table v-full-tbl-name .
      665            end.
      666            else do:
      667               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      668            end.
      669         end.
      670         if p-tt-handle = ? then do:
      671            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      672         end.
      673         else do:
      674            bh_tbl-name:find-first( v-where ) no-error .
      675         end.
      676         o-hn = bh_tbl-name.
      677      end.
      678   end procedure.
      679   procedure gen-hn-keyr :
      680     define input  parameter p-key-rec    as character no-undo.
      681     define input  parameter p-key-handle as handle    no-undo .
      682     define input  parameter p-db-name    as character no-undo .
      683     define input  parameter p-tt-handle  as handle    no-undo .
      684     define input  parameter p-stts-lock  as integer   no-undo .
      685     define output parameter o-hn         as handle    no-undo.
      686     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      687   end.
      688   procedure gen-row-keyr :
      689     define input  parameter p-key-rec    as character no-undo.
      690     define input  parameter p-key-handle as handle    no-undo .
      691     define input  parameter p-db-name    as character no-undo .
      692     define input  parameter p-tt-handle  as handle    no-undo .
      693     define input  parameter p-stts-lock  as integer   no-undo .
      694     define output parameter p-tbl-row    as rowid     no-undo.
      695     define output parameter p-tbl-name   as character no-undo.
      696     define variable vHn as handle no-undo.
      697       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      698       p-tbl-row = if vHn:available then vHn:rowid else ?.
      699       p-tbl-name =  vHn:table.
      700       delete object vHn no-error.
      701     if p-tbl-row = ? then do:
      702       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      703     end.
      704     else do:
      705       return.
      706     end.
      707   end procedure.
      708   procedure gen-key-fv :
      709     define input  parameter p-key-rec    as character no-undo .
      710     define output parameter p-field-list as character no-undo .
      711     define output parameter p-value-list as character no-undo.
      712     do
      713     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      714     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      715     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      716     :
      717       define variable v-full-tbl-name  as character no-undo .
      718       define variable bh_tbl-name      as handle    no-undo .
      719       define variable v-tbl-name       as character no-undo .
      720       define variable v-field-num      as integer   no-undo .
      721       define variable v-count-fld      as integer   no-undo .
      722       define variable v-inform         as character no-undo .
      723       define variable v-ind            as integer   no-undo .
      724       define variable v-idx-field-qnty as integer   no-undo .
      725       define variable v-delim-key      as character no-undo .
      726       if p-key-rec = ?
      727         or p-key-rec = "":U
      728       then do:
      729         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      730       end.
      731       assign
      732         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      733         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      734       .
      735       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      736       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      737       assign
      738         v-inform = bh_tbl-name:index-information(1)
      739         v-ind    = 2
      740       .
      741       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      742       on error undo, return error
      743       :
      744         assign
      745           v-inform = bh_tbl-name:index-information( v-ind )
      746           v-ind    = v-ind + 1
      747         .
      748       end.
      749       if v-inform = ?
      750         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      751         or entry( 3, v-inform, ",":U ) <> "1":U
      752       then do:
      753         delete object bh_tbl-name no-error.
      754         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      755       end.
      756       assign
      757         v-idx-field-qnty = num-entries( v-inform ) - 4
      758       .
      759       if v-idx-field-qnty < 2 then do:
      760         delete object bh_tbl-name no-error.
      761         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      762       end.
      763       assign
      764         p-field-list = "":U
      765         p-value-list = "":U
      766         v-delim-key  = "":U
      767         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      768         v-count-fld  = 0
      769       .
      770       block_where:
      771       do v-ind = 1 to v-idx-field-qnty by 2
      772       on error undo, return error
      773       :
      774         assign
      775           v-count-fld = v-count-fld + 1
      776         .
      777         if v-count-fld > v-field-num then do:
      778           leave block_where.
      779         end.
      780         assign
      781           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      782           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      783         .
      784         if v-ind = 1 then do:
      785           assign
      786             v-delim-key = chr(3)
      787           .
      788         end.
      789       end.
      790       delete object bh_tbl-name.
      791       if v-count-fld <> v-field-num then do:
      792         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      793       end.
      794     end.
      795   end procedure.
      796   procedure gen-key-field :
      797     define input  parameter p-table      as character no-undo .
      798     define output parameter p-field-list as character no-undo .
      799     do
      800     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      801     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      802     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      803     :
      804       define variable v-full-tbl-name  as character no-undo .
      805       define variable bh_tbl-name      as handle    no-undo .
      806       define variable v-tbl-name       as character no-undo .
      807       define variable v-field-num      as integer   no-undo .
      808       define variable v-count-fld      as integer   no-undo .
      809       define variable v-inform         as character no-undo .
      810       define variable v-ind            as integer   no-undo .
      811       define variable v-idx-field-qnty as integer   no-undo .
      812       define variable v-delim-key      as character no-undo .
      813       if p-table = ?
      814         or p-table = "":U
      815       then do:
      816         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      817       end.
      818       assign
      819         v-tbl-name      = p-table
      820         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      821       .
      822       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      823       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      824       assign
      825         v-inform = bh_tbl-name:index-information(1)
      826         v-ind    = 2
      827       .
      828       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      829       on error undo, return error
      830       :
      831         assign
      832           v-inform = bh_tbl-name:index-information( v-ind )
      833           v-ind    = v-ind + 1
      834         .
      835       end.
      836       if v-inform = ?
      837         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      838         or entry( 3, v-inform, ",":U ) <> "1":U
      839       then do:
      840         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      841       end.
      842       assign
      843         v-idx-field-qnty = num-entries( v-inform ) - 4
      844       .
      845       if v-idx-field-qnty < 2 then do:
      846         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      847       end.
      848       assign
      849         p-field-list = "":U
      850         v-delim-key  = "":U
      851         v-count-fld  = 0
      852       .
      853       block_where:
      854       do v-ind = 1 to v-idx-field-qnty by 2
      855       on error undo, return error
      856       :
      857         assign
      858           v-count-fld = v-count-fld + 1
      859         .
      860         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      861         if v-ind = 1 then do:
      862           assign
      863             v-delim-key = chr(3)
      864           .
      865         end.
      866       end.
      867       delete object bh_tbl-name.
      868     end.
      869   end procedure.
      870   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      871   FUNCTION get-region RETURNS CHARACTER
      872     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      873     define variable par-region as character no-undo.
      874     if parhost-code = 0 and
      875          parobj-type = "":U and
      876          parobj-code = 0 then do:
      877          par-region = "Глобально".
      878          return par-region.
      879       end.
      880       if parobj-type = 'орг':U then do:
      881          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      882          return par-region.
      883       end.
      884       if parobj-type = 'регион':U
      885       then do:
      886          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      887          return par-region.
      888       end.
      889       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      890       return par-region.
      891   END FUNCTION.
      892   FUNCTION get-objregion RETURNS CHARACTER
      893     (  input parobj-type as character, input parobj-code as integer ) :
      894     define variable par-region as character no-undo.
      895     if  parobj-type = "":U and
      896         parobj-code = 0
      897     then do:
      898        par-region = "Глобально".
      899     end.
      900     else if parobj-type = 'орг':U
      901     then do:
      902        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      903     end.
      904     else if parobj-type = 'регион':U
      905     then do:
      906        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      907     end.
      908     else
      909        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      910     return par-region.
      911   END FUNCTION.
      912   FUNCTION calldscr returns character ( input p-call-id as character):
      913   define variable v-descr as character no-undo .
      914   define variable v-field-list as character no-undo .
      915   define variable v-value-list as character no-undo.
      916   define variable v-prop-label as character no-undo .
      917   define variable v-node-label as character no-undo .
      918   define variable v-dt-code as integer no-undo .
      919   define variable v-host-code as integer no-undo .
      920   define variable v-obj-type as character no-undo .
      921   define variable v-obj-code as integer no-undo .
      922   define variable v-label as character no-undo .
      923   define variable v-node-code as integer no-undo .
      924   define buffer buf_prop-head for ub.prop-head.
      925   define buffer buf_prop-ref for ub.prop-ref.
      926   define buffer buf_prop-map for ub.prop-map.
      927   run gen-key-fv in this-procedure ( input p-call-id
      928                                     ,output v-field-list
      929                                     ,output v-value-list) no-error .
      930   if error-status:error then return p-call-id.
      931   CASE entry(1, p-call-id, chr(3)):
      932     when 'dis-card-type':U then do:
      933       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      934                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      935                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      936                            ).
      937     end.
      938     when 'dis-card':U then do:
      939       v-descr = substitute("ДК: № &1"
      940                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      941                            ).
      942     end.
      943     when 'dis-card-property':U then do:
      944       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      945       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      946       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      947       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      948       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      949       find first buf_prop-ref no-lock where
      950                 buf_prop-ref.dt-code = v-dt-code no-error .
      951       if available buf_prop-ref then do:
      952         find first buf_prop-head no-lock where
      953                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      954         v-prop-label = buf_prop-head.prop-label.
      955         find first buf_prop-map no-lock where
      956                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      957               and buf_prop-map.node-code = v-node-code no-error .
      958         if available buf_prop-map then do:
      959           v-label = buf_prop-map.node-label.
      960         end.
      961       end.
      962       v-descr = substitute("ДК: № &1 &2:&3 &4"
      963                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      964                            ,v-prop-label
      965                            ,v-label
      966                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      967                            ).
      968     end.
      969     when 'clients':U then do:
      970       v-descr = substitute("&1&2"
      971                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      972                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      973                            ).
      974     end.
      975     when 'ext-system':U then do:
      976       v-descr = substitute("Внешняя система &1"
      977                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
      978                            ).
      979     end.
      980     WHEN 'thbj-attr':U then do:
      981       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
      982       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
      983       then do:
      984         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
      985           v-descr = "Операции с товарами".
      986         end.
      987         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
      988           v-descr = "Операции с клиентами".
      989         end.
      990         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
      991           v-descr = "Операции с группами товаров".
      992         end.
      993         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
      994           v-descr = "Операции с группами клиентов".
      995         end.
      996         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
      997           v-descr = "Операции с чеками на POS IBS-TH".
      998         end.
      999         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1000           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1001         end.
     1002         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1003           v-descr = "Операции в системе электронного документооборота".
     1004         end.
     1005         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1006           v-descr = "Операции со справочниками".
     1007         end.
     1008         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1009           v-descr = "Операции с ДНЦ и переоценками".
     1010         end.
     1011         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1012           v-descr = "Отчеты".
     1013         end.
     1014         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1015           v-descr = "Операции с заказами".
     1016         end.
     1017       end.
     1018     end.
     1019     when 'cash-desk':U then do:
     1020       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1021                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1022                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1023                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1024                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1025                            ).
     1026     end.
     1027     when 'ext-file':U then do:
     1028       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1029                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1030                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1031                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1032                            ).
     1033     end.
     1034   end case.
     1035   return v-descr.
     1036   end function.
     1037   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1038   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1039   FUNCTION rum-fn_get-next-file-name returns character (
     1040                                       input p-base-file-name as character
     1041                                     , input p-index as integer):
     1042   define variable v-loc-file-name as character no-undo .
     1043   v-loc-file-name = substitute("&1_&2.&3"
     1044                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     1045                                                         then (r-index(p-base-file-name, ".") - 1)
     1046                                                         else length(p-base-file-name)
     1047                                                         )
     1048                                           )
     1049                               ,p-index
     1050                               ,(if r-index(p-base-file-name, ".") > 1
     1051                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     1052                                 else '')
     1053                                 )
     1054                                 .
     1055   return v-loc-file-name.
     1056   end function.
     1057   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   define temp-table temp-string no-undo
     1059   field v-string as character
     1060   field string-num as integer
     1061   index pi is unique primary string-num.
     1062   procedure temp-string_clear :
     1063     define buffer buf_temp-string for temp-string .
     1064     do
     1065     on error undo, return error return-value
     1066     :
     1067       for each buf_temp-string
     1068       on error undo, return error
     1069       :
     1070         delete buf_temp-string.
     1071       end.
     1072     end.
     1073   end procedure.
     1074   procedure temp-string_write :
     1075     define input  parameter p-v-string    as character no-undo .
     1076     define variable v-string-num as integer no-undo .
     1077     define buffer buf_temp-string for temp-string .
     1078     do
     1079     on error undo, return error return-value
     1080     :
     1081       find last buf_temp-string no-error .
     1082       if not available buf_temp-string then do:
     1083         create buf_temp-string .
     1084         assign
     1085         buf_temp-string.string-num     = 1
     1086         buf_temp-string.v-string       = p-v-string
     1087         .
     1088       end.
     1089       else do:
     1090         v-string-num = buf_temp-string.string-num.
     1091         create buf_temp-string .
     1092         assign
     1093         buf_temp-string.string-num = v-string-num + 1
     1094         buf_temp-string.v-string = p-v-string
     1095         .
     1096       end.
     1097     end.
     1098   end procedure.
     1099   procedure temp-string_read :
     1100     define input  parameter p-string-num    as integer   no-undo .
     1101     define output parameter p-v-string      as character no-undo .
     1102     define buffer buf_temp-string for temp-string .
     1103     do
     1104     on error undo, return error return-value
     1105     :
     1106       find first buf_temp-string
     1107         where buf_temp-string.string-num     = p-string-num
     1108         no-error .
     1109       if available buf_temp-string then do:
     1110         assign
     1111           p-v-string = buf_temp-string.v-string
     1112         .
     1113       end.
     1114       else do:
     1115         assign
     1116           p-v-string = '':U
     1117         .
     1118       end.
     1119     end.
     1120   end procedure.
     1121   procedure temp-string_append :
     1122     define input  parameter p-string-num  as integer   no-undo .
     1123     define input  parameter p-v-string    as character no-undo .
     1124     define input  parameter p-append-char as character no-undo .
     1125     define buffer buf_temp-string for temp-string .
     1126     do
     1127     on error undo, return error return-value
     1128     :
     1129       find first buf_temp-string
     1130            where buf_temp-string.string-num = p-string-num
     1131         no-error .
     1132       if not available buf_temp-string then do:
     1133         create buf_temp-string .
     1134         assign
     1135           buf_temp-string.string-num  = p-string-num
     1136           buf_temp-string.v-string    = p-v-string
     1137         .
     1138       end.
     1139       else do:
     1140           assign
     1141           buf_temp-string.v-string = buf_temp-string.v-string + p-append-char + p-v-string
     1142           .
     1143       end.
     1144     end.
     1145   end procedure.
     1146   procedure temp-string_get-last-num:
     1147   define output parameter p-string-num  as integer   no-undo .
     1148   define buffer buf_temp-string for temp-string .
     1149   find last buf_temp-string no-error.
     1150   if available buf_temp-string then do:
     1151     p-string-num = buf_temp-string.string-num.
     1152   end.
     1153   end procedure.
     1154   procedure temp-string_delete-range:
     1155   define input parameter p-first-string-num  as integer   no-undo .
     1156   define input parameter p-last-string-num  as integer   no-undo .
     1157   define buffer buf_temp-string for temp-string .
     1158   for each buf_temp-string where
     1159           buf_temp-string.string-num >= p-first-string-num
     1160       and buf_temp-string.string-num <= p-last-string-num:
     1161     delete buf_temp-string.
     1162   end.
     1163   end procedure.
     1164   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1165   procedure display-rule-call-params :
     1166   define input parameter p-mode as character no-undo .
     1167   define input parameter p-codex-id as integer no-undo .
     1168   define input parameter p-ruleset-id as integer no-undo .
     1169   define input parameter p-call-id as character no-undo .
     1170   define input parameter p-once-more as integer no-undo .
     1171   define input parameter p-order-id as integer no-undo .
     1172   define input parameter p-handle as handle no-undo .
     1173   define buffer buf_rule-call-param for tt0-rule-call-param.
     1174   define variable v-string as character no-undo .
     1175   do
     1176   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1177   :
     1178     run temp-string_write in p-handle ( input "ПАРАМЕТРЫ").
     1179     if p-mode = "text"
     1180     or p-mode = "text-temp"
     1181     then do:
     1182       run temp-string_write in p-handle ( input "").
     1183     end.
     1184     _rr:
     1185     for each buf_rule-call-param no-lock where
     1186             buf_rule-call-param.codex_id = p-codex-id
     1187         and buf_rule-call-param.ruleset_id = p-ruleset-id
     1188         and buf_rule-call-param.call_id = p-call-id
     1189         and buf_rule-call-param.order_id = p-order-id:
     1190       if p-once-more >= 0 and
     1191       buf_rule-call-param.once-more <> p-once-more then next.
     1192       v-string = '':U.
     1193       if lookup("LIST", buf_rule-call-param.param-3-data-type) > 0 then do:
     1194         if buf_rule-call-param.p-index = 0 then do:
     1195           assign
     1196           v-string = buf_rule-call-param.param-label +  chr(32)  + "=".
     1197           run temp-string_write in p-handle ( input v-string).
     1198           next _rr.
     1199         end.
     1200         else do:
     1201           assign
     1202           v-string = fill( chr(32), length(buf_rule-call-param.param-label) + 2).
     1203         end.
     1204       end.
     1205       else do:
     1206         assign
     1207         v-string = buf_rule-call-param.param-label +  chr(32)  + "=".
     1208       end.
     1209       CASE buf_rule-call-param.param-data-type:
     1210         when 'character':U then do:
     1211           v-string = v-string + buf_rule-call-param.param-value-character.
     1212         end.
     1213         when 'date':U then do:
     1214           v-string = v-string + string(buf_rule-call-param.param-value-date, "99/99/9999").
     1215         end.
     1216         when 'logical':U then do:
     1217           v-string = v-string + string(buf_rule-call-param.param-value-logical, "ДА/НЕТ").
     1218         end.
     1219         when 'decimal':U then do:
     1220           v-string = v-string + string(buf_rule-call-param.param-value-decimal).
     1221         end.
     1222         when 'integer':U then do:
     1223           v-string = v-string + string(buf_rule-call-param.param-value-integer).
     1224         end.
     1225       END CASE.
     1226       run temp-string_write in p-handle ( input v-string).
     1227     end.
     1228     if p-mode = "text"
     1229     or p-mode = "text-temp"
     1230     then do:
     1231       run temp-string_write in p-handle ( input "").
     1232     end.
     1233   end.
     1234   end procedure.
     1235   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1236   define variable dops0 as character no-undo format "X(8)".
     1237   define variable dops as character no-undo format "X(250)".
     1238   define variable dopst as character no-undo format "X(1)".
     1239   define variable dopsp as character no-undo format "X(10)".
     1240   define variable v-conf-type as character no-undo .
     1241   define variable v-run as logical no-undo .
     1242   define variable v-profile-type as character no-undo .
     1243   define variable v-uniq-key-rec as character no-undo .
     1244   define variable v-prop-code as character no-undo .
     1245   define variable v-codex-id as integer no-undo .
     1246   define variable v-ruleset-id as integer no-undo .
     1247   define variable v-ruleproc as character no-undo .
     1248   define variable v-current-file-name as character no-undo .
     1249   define variable v-current-file-index as integer no-undo .
     1250   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     1251   define variable v-full-path        as character no-undo .
     1252   define variable v-path             as character no-undo .
     1253   define variable v-file-name        as character no-undo .
     1254   define variable v-file-name-no-ext as character no-undo .
     1255   define variable v-file-name-ext    as character no-undo .
     1256   define variable v-rp-by-call-uniq-key-rec as character no-undo .
     1257   define variable v-needs-ifile as logical no-undo .
     1258   define variable v-dop as character no-undo .
     1259   define buffer buf_thbj-attr for ub.thbj-attr.
     1260   DEFINE BUFFER buf_ruleset FOR ub.ruleset.
     1261   define buffer buf_rule-process for ub.rule-process.
     1262   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1263   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1264   procedure init-rule-call-params :
     1265   define input parameter p-uniq-key-rec as character no-undo .
     1266   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1267   define buffer buf_rule-call-param for ub.rule-call-param.
     1268   do
     1269   on error undo, return error
     1270   :
     1271     empty temp-table temp-rule-call-param.
     1272     for each buf_rule-call-param where
     1273             buf_rule-call-param.call_id = p-uniq-key-rec:
     1274       create buf_temp-rule-call-param.
     1275       buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     1276       if lookup("container", buf_rule-call-param.param-3-data-type) > 0 then do:
     1277         find first buf_temp-rule-call-param where
     1278               buf_temp-rule-call-param.call_id = p-uniq-key-rec
     1279           and buf_temp-rule-call-param.codex_id = 0
     1280           and buf_temp-rule-call-param.ruleset_id = 0
     1281           and buf_temp-rule-call-param.order_id = 0
     1282           and buf_temp-rule-call-param.param-name = buf_rule-call-param.param-name
     1283           and buf_temp-rule-call-param.p-index = buf_rule-call-param.p-index no-error.
     1284         if not available buf_temp-rule-call-param then do:
     1285           create buf_temp-rule-call-param.
     1286           buffer-copy buf_rule-call-param
     1287           except
     1288           codex_id
     1289           ruleset_id
     1290           order_id
     1291           to buf_temp-rule-call-param.
     1292         end.
     1293       end.
     1294     end.
     1295   end.
     1296   end procedure.
     1297   procedure update-rule-call-params :
     1298   define input parameter p-profile-type as character no-undo .
     1299   define input parameter p-uniq-key-rec as character no-undo .
     1300   do
     1301   on error undo, return error
     1302   :
     1303     for each temp-rule-call-param where
     1304             temp-rule-call-param.call_id = p-uniq-key-rec
     1305         and temp-rule-call-param.codex_id = 0
     1306         and temp-rule-call-param.ruleset_id = 0
     1307         and temp-rule-call-param.order_id = 0:
     1308       delete temp-rule-call-param.
     1309     end.
     1310     run rul/ruprcall.p (
     1311                          input p-profile-type
     1312                         ,input p-uniq-key-rec
     1313                         ,input 'rule-call-param':U
     1314                         ,input ?
     1315                         ,input 0
     1316                         ,INPUT TABLE tt0-rp-by-call
     1317                         ,INPUT TABLE tt0-rule-by-call
     1318                         ,INPUT TABLE temp-rule-call-param) no-error .
     1319   end.
     1320   end procedure.
     1321   procedure cb_rcps-run_get-value :
     1322   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1323   define input parameter p-codex-id as integer no-undo .
     1324   define input parameter p-ruleset-id as integer no-undo .
     1325   define input parameter p-order-id as integer no-undo .
     1326   DEFINE INPUT PARAMETER p-param-name AS CHARACTER NO-UNDO.
     1327   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     1328   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     1329   DEFINE output parameter p-value-date AS date NO-UNDO.
     1330   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     1331   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     1332   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     1333   define variable v-current-index as integer no-undo init -1.
     1334   define variable v-start as logical no-undo init yes.
     1335   DEFINE BUFFER buf_temp-rule-call-param FOR temp-rule-call-param.
     1336   do
     1337   on error undo, return error
     1338   :
     1339    for each buf_temp-rule-call-param where
     1340          buf_temp-rule-call-param.call_id = p-call-id
     1341      and buf_temp-rule-call-param.codex_id = p-codex-id
     1342      and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     1343      and buf_temp-rule-call-param.order_id = p-order-id
     1344      and buf_temp-rule-call-param.param-name = p-param-name
     1345      and buf_temp-rule-call-param.p-index >= pp-index :
     1346     if v-start then do:
     1347         assign
     1348         pp-index = buf_temp-rule-call-param.p-index
     1349         p-value-character = buf_temp-rule-call-param.param-value-character
     1350         p-value-date      = buf_temp-rule-call-param.param-value-date
     1351         p-value-decimal   = buf_temp-rule-call-param.param-value-decimal
     1352         p-value-integer   = buf_temp-rule-call-param.param-value-integer
     1353         p-value-logical   = buf_temp-rule-call-param.param-value-logical
     1354         v-start = no
     1355         .
     1356       end.
     1357       else do:
     1358         if buf_temp-rule-call-param.p-index > pp-index then do:
     1359           v-current-index = buf_temp-rule-call-param.p-index.
     1360           leave.
     1361         end.
     1362       end.
     1363     end.
     1364     pp-index = v-current-index.
     1365   end.
     1366   end procedure.
     1367   PROCEDURE cb_rcps-run_set-value :
     1368   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1369   define input parameter p-codex-id as integer no-undo .
     1370   define input parameter p-ruleset-id as integer no-undo .
     1371   define input parameter p-order-id as integer no-undo .
     1372   DEFINE INPUT PARAMETER p-param-name AS CHARACTER NO-UNDO.
     1373   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1374   define input parameter p-param-mode as character no-undo .
     1375   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     1376   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     1377   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     1378   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     1379   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     1380   define variable v-found as logical no-undo .
     1381   define variable v-rp-param-name as character no-undo .
     1382   DEFINE BUFFER buf_temp-rule-call-param FOR temp-rule-call-param.
     1383   DEFINE BUFFER buf2_temp-rule-call-param FOR temp-rule-call-param.
     1384   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1385   find first buf_temp-rule-call-param WHERE
     1386           buf_temp-rule-call-param.call_id = p-CALL-id
     1387       AND buf_temp-rule-call-param.codex_id = p-codex-id
     1388       AND buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     1389       AND buf_temp-rule-call-param.order_id = p-order-id
     1390       AND buf_temp-rule-call-param.param-name = p-param-name
     1391       AND buf_temp-rule-call-param.p-index = pp-index no-error.
     1392   if pp-index > 0
     1393   then do:
     1394     if not available buf_temp-rule-call-param then do:
     1395       find first buf2_temp-rule-call-param WHERE
     1396               buf2_temp-rule-call-param.call_id = p-CALL-id
     1397           AND buf2_temp-rule-call-param.codex_id = p-codex-id
     1398           AND buf2_temp-rule-call-param.ruleset_id = p-ruleset-id
     1399           AND buf2_temp-rule-call-param.order_id = p-order-id
     1400           AND buf2_temp-rule-call-param.param-name = p-param-name
     1401           AND buf2_temp-rule-call-param.p-index = 0 no-error.
     1402       create buf_temp-rule-call-param.
     1403       buffer-copy buf2_temp-rule-call-param
     1404       except p-index
     1405       to buf_temp-rule-call-param
     1406       assign
     1407       buf_temp-rule-call-param.p-index = pp-index
     1408       .
     1409     end.
     1410   end.
     1411   else do:
     1412     if not available buf_temp-rule-call-param then do:
     1413       undo, return error substitute("Отсутствует параметр &1/&6 для вызова &2 кодекс &3 набор правил &4 порядок &5"
     1414                                     , p-param-name
     1415                                     , p-call-id
     1416                                     , p-codex-id
     1417                                     , p-ruleset-id
     1418                                     , p-order-id
     1419                                     , pp-index).
     1420     end.
     1421   end.
     1422   assign
     1423   buf_temp-rule-call-param.param-value-character = p-value-character
     1424   buf_temp-rule-call-param.param-value-date      = p-value-date
     1425   buf_temp-rule-call-param.param-value-decimal   = p-value-decimal
     1426   buf_temp-rule-call-param.param-value-integer   = p-value-integer
     1427   buf_temp-rule-call-param.param-value-logical   = p-value-logical
     1428   .
     1429   if not (p-codex-id = 0
     1430           and
     1431           p-ruleset-id = 0
     1432           and
     1433           p-order-id = 0)   then do:
     1434   find first buf_rp-rule-param no-lock where
     1435            buf_rp-rule-param.profile_id = buf_temp-rule-call-param.profile_id
     1436       and  buf_rp-rule-param.codex_id = p-codex-id
     1437       and  buf_rp-rule-param.ruleset_id = p-ruleset-id
     1438       and  buf_rp-rule-param.rule_id = buf_temp-rule-call-param.rule_id
     1439       and  buf_rp-rule-param.rule-param-name = p-param-name.
     1440   assign
     1441   v-rp-param-name = buf_rp-rule-param.rp-param-name.
     1442   for each buf_rp-rule-param no-lock where
     1443            buf_rp-rule-param.profile_id = buf_temp-rule-call-param.profile_id
     1444        and buf_rp-rule-param.rp-param-name = v-rp-param-name,
     1445       each buf2_temp-rule-call-param where
     1446           buf2_temp-rule-call-param.call_id = p-call-id
     1447       and buf2_temp-rule-call-param.profile_id = buf_temp-rule-call-param.profile_id
     1448       and buf2_temp-rule-call-param.once-more = buf_temp-rule-call-param.once-more
     1449       and buf2_temp-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1450       and buf2_temp-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1451       and buf2_temp-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1452       and buf2_temp-rule-call-param.p-index = pp-index
     1453       :
     1454     assign
     1455     buf2_temp-rule-call-param.param-value-character = p-value-character
     1456     buf2_temp-rule-call-param.param-value-date      = p-value-date
     1457     buf2_temp-rule-call-param.param-value-decimal   = p-value-decimal
     1458     buf2_temp-rule-call-param.param-value-integer   = p-value-integer
     1459     buf2_temp-rule-call-param.param-value-logical   = p-value-logical
     1460     .
     1461   end.
     1462   end.
     1463   end procedure.
     1464   procedure cb_rcps-run_fill-rcp-from-tt0 :
     1465   define input parameter p-call-id as character no-undo .
     1466   define input parameter p-bh as handle no-undo .
     1467   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1468   for each buf_tt0-rule-call-param where
     1469          buf_tt0-rule-call-param.call_id = p-call-id
     1470   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1471   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1472   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1473   :
     1474     p-bh:buffer-create ().
     1475     p-bh:buffer-copy(buffer buf_tt0-rule-call-param:handle).
     1476     p-bh:buffer-release.
     1477   end.
     1478   end procedure.
     1479   DEFINE BUTTON b-exit AUTO-GO
     1480        LABEL "&Ввод"
     1481        SIZE 10 BY 1
     1482        BGCOLOR 8 .
     1483   DEFINE BUTTON B-file
     1484        IMAGE-UP FILE "btn-down-arrow":U
     1485        IMAGE-DOWN FILE "btn-down-arrow":U
     1486        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1487        LABEL ""
     1488        SIZE 3 BY 1.
     1489   DEFINE BUTTON B-help
     1490        LABEL "Помо&щь"
     1491        SIZE 3 BY 1
     1492        BGCOLOR 8 .
     1493   DEFINE BUTTON b-param
     1494        LABEL "&Параметры"
     1495        SIZE 10 BY 1.
     1496   DEFINE BUTTON B-profile
     1497        IMAGE-UP FILE "btn-down-arrow":U
     1498        IMAGE-DOWN FILE "btn-down-arrow":U
     1499        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1500        LABEL ""
     1501        SIZE 3 BY 1.
     1502   DEFINE BUTTON B-quit AUTO-END-KEY
     1503        LABEL "&Отмена"
     1504        SIZE 10 BY 1
     1505        BGCOLOR 8 .
     1506   DEFINE BUTTON b-rule
     1507        LABEL "Правила"
     1508        SIZE 10 BY 1.
     1509   DEFINE VARIABLE Ed-notes AS CHARACTER
     1510        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1511        SIZE 98 BY 9.21
     1512        FGCOLOR 4  NO-UNDO.
     1513   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
     1514        LABEL "Файл"
     1515        VIEW-AS FILL-IN
     1516        SIZE 78.5 BY 1
     1517        FGCOLOR 4  NO-UNDO.
     1518   DEFINE VARIABLE rs-rule-process AS CHARACTER
     1519        VIEW-AS RADIO-SET VERTICAL
     1520        RADIO-BUTTONS
     1521             "Экспорт", "1"
     1522        SIZE 71.5 BY 5 NO-UNDO.
     1523   DEFINE QUERY Dialog-Frame FOR
     1524         X_rule-profile,
     1525         X_ruleset,
     1526         X_rule-by-call,
     1527         X_rp-by-call SCROLLING.
     1528   DEFINE FRAME Dialog-Frame
     1529        b-exit AT ROW 1 COL 1
     1530        B-quit AT ROW 1 COL 11
     1531        rs-rule-process AT ROW 1 COL 22 NO-LABEL WIDGET-ID 22
     1532        B-help AT ROW 1 COL 95
     1533        ub.X_ruleset.name AT ROW 6 COL 1.5 NO-LABEL WIDGET-ID 28
     1534             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1535             SIZE 97 BY 2.5
     1536        b-rule AT ROW 9 COL 77 WIDGET-ID 24
     1537        b-param AT ROW 9 COL 87 WIDGET-ID 14
     1538        X_rule-profile.name AT ROW 10 COL 14 COLON-ALIGNED WIDGET-ID 10
     1539             LABEL "Профайл"
     1540             VIEW-AS FILL-IN NATIVE
     1541             SIZE 79 BY 1
     1542             FGCOLOR 0
     1543        B-profile AT ROW 10 COL 95 WIDGET-ID 12
     1544        X_rp-by-call.once-more AT ROW 11 COL 14 COLON-ALIGNED WIDGET-ID 32
     1545             LABEL "№ привязки" FORMAT ">>9"
     1546             VIEW-AS FILL-IN NATIVE
     1547             SIZE 4 BY 1
     1548             FGCOLOR 0
     1549        file-name AT ROW 12.25 COL 10
     1550        B-file AT ROW 12.25 COL 95
     1551        Ed-notes AT ROW 13.25 COL 1.5 NO-LABEL WIDGET-ID 30
     1552       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1553            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1554            TITLE ""
     1555            DEFAULT-BUTTON b-exit CANCEL-BUTTON B-quit.
     1556   ASSIGN
     1557          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1558          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1559   ASSIGN
     1560          B-file:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1561   ASSIGN
     1562          Ed-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1563   ASSIGN
     1564          file-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1565   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1566   DO:
     1567     APPLY "END-ERROR":U TO SELF.
     1568   END.
     1569   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1570   DO:
     1571     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1572     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1573     v-run = yes.
     1574   END.
     1575   ON CHOOSE OF B-file IN FRAME Dialog-Frame
     1576   DO:
     1577   define variable v_os-file   AS CHAR NO-UNDO INIT "".
     1578   define variable ll_commit AS LOG    NO-UNDO INIT NO.
     1579   define variable v-full-path        as character no-undo .
     1580   define variable v-path             as character no-undo .
     1581   define variable v-file-name        as character no-undo .
     1582   define variable v-file-name-no-ext as character no-undo .
     1583   define variable v-file-name-ext    as character no-undo .
     1584   define variable v-txt-name as character no-undo .
     1585   define variable v-flt-name as character no-undo .
     1586   define variable glog as logical no-undo .
     1587   define variable v-needs-ifile as logical no-undo .
     1588   define variable v-needs-efile as logical no-undo .
     1589   define variable v-xml-file as logical no-undo .
     1590   define variable v-excel-file as logical no-undo .
     1591   define variable v-text-file as logical no-undo .
     1592   define variable v-dflt-extension as character no-undo .
     1593   define buffer buf_rule-process for ub.rule-process.
     1594   for each buf_rule-process no-lock where
     1595             buf_rule-process.pchain-type = v-profile-type
     1596         and buf_rule-process.pchain-id = rs-rule-process
     1597         and buf_rule-process.start-from = (if v-cntxt-db-num = 0 then 0 else 1):
     1598   if buf_rule-process.needs-ifile = 1 then do:
     1599       v-needs-ifile = yes.
     1600     end.
     1601     if buf_rule-process.needs-efile = 1 then do:
     1602       v-needs-efile = yes.
     1603     end.
     1604   end.
     1605   if v-needs-ifile then do:
     1606     if lookup( "xml", rs-rule-process, '-') > 0  then do:
     1607       v-xml-file = yes.
     1608     end.
     1609     if lookup("excel", rs-rule-process, '-' ) > 0 then do:
     1610       v-excel-file = yes.
     1611     end.
     1612     if lookup("text", rs-rule-process, '-') > 0 then do:
     1613       v-text-file = yes.
     1614     end.
     1615     if rs-rule-process = "batchwork-import" then do:
     1616       v-xml-file = yes.
     1617     end.
     1618     if v-xml-file then do:
     1619     SYSTEM-DIALOG GET-FILE v_os-file
     1620     TITLE "Задайте файл для импорта"
     1621     FILTERS
     1622       " Все XML файлы (*.xml) " "*.xml",
     1623       " Все файлы (*.*) "                      "*.*"
     1624     INITIAL-FILTER 1
     1625     DEFAULT-EXTENSION ".xml"
     1626     USE-FILENAME
     1627     MUST-EXIST
     1628     UPDATE ll_commit
     1629     .
     1630     end.
     1631     if v-excel-file then do:
     1632       SYSTEM-DIALOG GET-FILE v_os-file
     1633       TITLE "Задайте файл для импорта"
     1634       FILTERS
     1635         " Все EXCEL файлы (*.xls,*.xlsx) " "*.xls,*.xlsx",
     1636         " Все файлы (*.*) "                      "*.*"
     1637       INITIAL-FILTER 1
     1638       DEFAULT-EXTENSION ".xml"
     1639       USE-FILENAME
     1640       MUST-EXIST
     1641       UPDATE ll_commit
     1642       .
     1643     end.
     1644     if v-text-file then do:
     1645       case rs-rule-process:
     1646         when 'text-export_specif':U then do:
     1647           assign
     1648           v-txt-name = " Все TEXT файлы (*.txt), Все SPC файлы (*.spc) "
     1649           v-flt-name = "*.txt, *.spc"
     1650           .
     1651         end.
     1652         otherwise do:
     1653           assign
     1654           v-txt-name = " Все TEXT файлы (*.txt) "
     1655           v-flt-name = "*.txt"
     1656           .
     1657         end.
     1658       end case.
     1659       SYSTEM-DIALOG GET-FILE v_os-file
     1660       TITLE "Задайте файл для импорта"
     1661       FILTERS
     1662         v-txt-name  v-flt-name
     1663         ," Все файлы (*.*) "                      "*.*"
     1664       INITIAL-FILTER 1
     1665       DEFAULT-EXTENSION ".xml"
     1666       USE-FILENAME
     1667       MUST-EXIST
     1668       UPDATE ll_commit
     1669       .
     1670     end.
     1671     IF ll_commit <> YES THEN do:
     1672         RETURN NO-APPLY.
     1673     end.
     1674     IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
     1675         BELL.
     1676         MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1677         RETURN NO-APPLY.
     1678     END.
     1679     ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
     1680     run gbl/filename.p (
     1681                     input  v_os-file
     1682                     ,output v-full-path
     1683                     ,output v-path
     1684                     ,output v-file-name
     1685                     ,output v-file-name-no-ext
     1686                     ,output v-file-name-ext
     1687                     ) no-error .
     1688     if error-status:error  = ? then do:
     1689       return no-apply.
     1690     end.
     1691     assign
     1692     file-name = v-full-path.
     1693     DISPlay
     1694     file-name WITH FRAME Dialog-Frame.
     1695   END.
     1696   if v-needs-efile then do:
     1697     if lookup( "xml", rs-rule-process, '-') > 0 then do:
     1698       v-xml-file = yes.
     1699     end.
     1700     if lookup("excel", rs-rule-process, '-' ) > 0 then do:
     1701       v-excel-file = yes.
     1702     end.
     1703     if lookup("text", rs-rule-process, '-') > 0 then do:
     1704       v-text-file = yes.
     1705     end.
     1706     if rs-rule-process = "batchwork-export" then do:
     1707       v-xml-file = yes.
     1708     end.
     1709     if v-xml-file then do:
     1710     assign
     1711     v_os-file = "default.xml"
     1712     glog = yes
     1713     .
     1714     system-dialog get-file v_os-file
     1715     filters "Файл экспорта *.xml" "*.xml"
     1716     ask-overwrite
     1717     save-as
     1718     use-filename
     1719     update glog
     1720     default-extension "xml".
     1721     end.
     1722     if v-excel-file then do:
     1723       assign
     1724       v_os-file = "default.xls"
     1725       glog = yes
     1726       .
     1727       system-dialog get-file v_os-file
     1728       filters "Файл экспорта *.xls" "*.xls"
     1729       ask-overwrite
     1730       save-as
     1731       use-filename
     1732       update glog
     1733       default-extension "xml".
     1734     end.
     1735     if v-text-file then do:
     1736       case rs-rule-process:
     1737         when 'text-export_specif':U then do:
     1738           assign
     1739           v-txt-name = " Все TEXT файлы (*.txt), Все SPC файлы (*.spc) "
     1740           v-flt-name = "*.txt, *.spc"
     1741           v_os-file = "default.spc"
     1742           v-dflt-extension = "spc"
     1743           .
     1744         end.
     1745         otherwise do:
     1746           assign
     1747           v-txt-name = " Все TEXT файлы (*.txt) "
     1748           v-flt-name = "*.txt"
     1749           v_os-file = "default.txt"
     1750           v-dflt-extension = "txt"
     1751           .
     1752         end.
     1753       end case.
     1754       assign
     1755       glog = yes
     1756       .
     1757       system-dialog get-file v_os-file
     1758       filters v-txt-name v-flt-name
     1759       ask-overwrite
     1760       save-as
     1761       use-filename
     1762       update glog
     1763       default-extension v-dflt-extension.
     1764     end.
     1765     if not glog then do:
     1766       return no-apply.
     1767     end.
     1768     file-name = v_os-file.
     1769     DISPlay
     1770     file-name WITH FRAME Dialog-Frame.
     1771       run gbl/filename.p (
     1772                        input  file-name
     1773                       ,output v-full-path
     1774                       ,output v-path
     1775                       ,output v-file-name
     1776                       ,output v-file-name-no-ext
     1777                       ,output v-file-name-ext
     1778                       ) no-error .
     1779       if not (error-status:error
     1780       or v-full-path = ?
     1781       or v-full-path = '':U) then do:
     1782         message
     1783         "Такой файл существует!" skip
     1784         "перезаписывать?"
     1785         view-as alert-box question buttons yes-no update glog.
     1786         if not glog then return no-apply.
     1787       end.
     1788   END.
     1789   END.
     1790   ON CHOOSE OF b-param IN FRAME Dialog-Frame
     1791   DO:
     1792     RUN proc-b-param IN THIS-PROCEDURE ( input yes) NO-ERROR.
     1793       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1794   END.
     1795   ON CHOOSE OF B-profile IN FRAME Dialog-Frame
     1796   DO:
     1797   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1798   define variable glog as logical no-undo .
     1799   define buffer buf_rule-by-profile for ub.rule-by-profile.
     1800   define buffer buf_rp-by-call for ub.rp-by-call.
     1801   define buffer buf_rule-profile for ub.rule-profile.
     1802   IF AVAILABLE X_rp-by-call THEN DO:
     1803      ASSIGN
     1804      v-rid-list = STRING(RECID(X_rp-by-call)).
     1805   END.
     1806   run rul/rp-by-call-s.w ( INPUT parparentproc
     1807                           ,INPUT "b-sel,instant":U
     1808                           ,INPUT "call-id,ruleset-id"
     1809                           ,INPUT 0
     1810                           ,INPUT '':U
     1811                           ,input v-uniq-key-rec
     1812                           ,input v-codex-id
     1813                           ,input v-ruleset-id
     1814                           ,INPUT-OUTPUT v-rid-list
     1815                           ) NO-ERROR.
     1816   if v-rid-list = '':U then RETURN NO-APPLY.
     1817   FIND FIRST buf_rp-by-call NO-LOCK WHERE
     1818           recid(buf_rp-by-call) = integer(v-rid-list).
     1819   find first buf_rule-by-profile no-lock where
     1820             buf_rule-by-profile.profile_id = buf_rp-by-call.profile_id
     1821         and buf_rule-by-profile.codex_id = v-codeX-id
     1822         and buf_rule-by-profile.ruleset_id = v-ruleset-id no-error.
     1823   if not available buf_rule-by-profile then do:
     1824      message
     1825      substitute("Для данного профайла не определено никаких правил")
     1826      view-as alert-box error .
     1827      return no-apply.
     1828   end.
     1829   find first buf_rule-profile no-lock where
     1830             buf_rule-profile.profile_id = buf_rule-by-profile.profile_id.
     1831   if buf_rule-profile.action-item-id > '' then do:
     1832   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1833   do:
     1834     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1835       (input  v-cntxt-db-num
     1836       ,input  v-cntxt-userid
     1837       ,input  buf_rule-profile.action-head-code
     1838       ,input  buf_rule-profile.action-item-id
     1839       ,input  buf_rule-profile.action-item-context
     1840       ,input  (if buf_rule-profile.action-item-context = 'global':U then 0 else v-cntxt-host-code-obj)
     1841       ,input  (if buf_rule-profile.action-item-context = 'object':U then v-cntxt-obj-type else '')
     1842       ,input  (if buf_rule-profile.action-item-context = 'object':U then v-cntxt-obj-code else 0)
     1843       ,input  0
     1844       ,input  0
     1845       ,input  0
     1846       ,input  true
     1847       ,output glog
     1848       )  .
     1849   end.
     1850     if not glog then do:
     1851      return no-apply.
     1852     end.
     1853   end.
     1854   find first X_rp-by-call no-lock where
     1855             recid(X_rp-by-call) = recid(buf_rp-by-call).
     1856   FIND FIRST X_rule-profile NO-LOCK WHERE
     1857           X_rule-profile.profile_id = X_rp-by-call.profile_id.
     1858   DISPLAY
     1859   X_rule-profile.NAME
     1860   X_rp-by-call.once-more
     1861   WITH FRAME Dialog-Frame.
     1862   RUN  refill-rp-by-call IN THIS-PROCEDURE NO-ERROR.
     1863   ENABLE
     1864   b-param
     1865   b-rule
     1866   WITH FRAME Dialog-Frame.
     1867   run proc-b-type in this-procedure no-error.
     1868   if error-status:error then do:
     1869     undo, return no-apply.
     1870   end.
     1871   END.
     1872   ON CHOOSE OF b-rule IN FRAME Dialog-Frame
     1873   DO:
     1874      RUN proc-b-rule IN THIS-PROCEDURE NO-ERROR.
     1875      IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1876   END.
     1877   ON LEAVE OF file-name IN FRAME Dialog-Frame
     1878   DO:
     1879     CASE v-ruleproc:
     1880       WHEN 'xml-file-import':U
     1881       or
     1882       WHEN 'xml-file-import':U
     1883       or
     1884       WHEN 'xml-file-import':U
     1885       or
     1886       WHEN 'xml-file-import_order':U
     1887       or
     1888       WHEN 'text-import_specif':U
     1889       or
     1890       WHEN 'excel-import_specif':U
     1891       or
     1892       when 'xml-file-import':U
     1893           or
     1894       when "recipe-xml-file-import":U
     1895       THEN DO:
     1896           ASSIGN file-name.
     1897           IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
     1898               ASSIGN FILE-INFO:FILE-NAME = file-name.
     1899               IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
     1900               DISP file-name WITH FRAME Dialog-Frame.
     1901           END.
     1902           APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
     1903       END.
     1904     END CASE.
     1905   END.
     1906   ON VALUE-CHANGED OF rs-rule-process IN FRAME Dialog-Frame
     1907   DO:
     1908     define variable v-needs-ifile as logical no-undo .
     1909     define variable v-needs-efile as logical no-undo .
     1910     define buffer buf_rule-process for ub.rule-process.
     1911     ASSIGN
     1912     rs-rule-process.
     1913     FILE-NAME = ''.
     1914     IF AVAILABLE X_rp-by-call THEN RELEASE X_rp-by-call.
     1915     IF AVAILABLE X_rule-profile THEN RELEASE X_rule-profile.
     1916     X_rule-profile.NAME :SCREEN-VALUE = ''.
     1917     disABLE
     1918     FILE-NAME
     1919     b-file
     1920     WITH FRAME Dialog-Frame.
     1921     hide
     1922     FILE-NAME
     1923     b-file
     1924     IN FRAME Dialog-Frame.
     1925     for each buf_rule-process no-lock where
     1926               buf_rule-process.pchain-type = v-profile-type
     1927           and buf_rule-process.pchain-id = rs-rule-process
     1928           and buf_rule-process.start-from = (if v-cntxt-db-num = 0 then 0 else 1):
     1929       if buf_rule-process.needs-efile = 1 then do:
     1930         v-needs-efile = yes.
     1931       end.
     1932       if buf_rule-process.needs-ifile = 1 then do:
     1933         v-needs-ifile = yes.
     1934       end.
     1935     end.
     1936     find first buf_rule-process no-lock where
     1937               buf_rule-process.pchain-type = v-profile-type
     1938           and buf_rule-process.pchain-id = rs-rule-process
     1939         and buf_rule-process.start-from = (if v-cntxt-db-num = 0 then 0 else 1)
     1940         and buf_rule-process.main-link = 1.
     1941     ASSIGN
     1942     v-ruleset-id = integer(buf_rule-process.ruleset_id)
     1943     v-ruleproc = rs-rule-process
     1944     .
     1945     if v-needs-efile = yes then do:
     1946       ENABLE
     1947       FILE-NAME
     1948       b-file
     1949       WITH FRAME Dialog-Frame.
     1950       DISPLAY
     1951       FILE-NAME
     1952       b-file
     1953       WITH FRAME Dialog-Frame.
     1954     end.
     1955     if v-needs-ifile = yes then do:
     1956       ENABLE
     1957       FILE-NAME
     1958       b-file
     1959       WITH FRAME Dialog-Frame.
     1960       DISPLAY
     1961       FILE-NAME
     1962       b-file
     1963       WITH FRAME Dialog-Frame.
     1964     end.
     1965     FIND first X_ruleset no-lock where
     1966           X_ruleset.codex_id = v-codex-id
     1967       and X_ruleset.ruleset_id = v-ruleset-id.
     1968     DISPLAY
     1969     X_ruleset.NAME
     1970     WITH FRAME Dialog-Frame.
     1971   END.
     1972   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1973   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1974   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1975   on help of frame Dialog-Frame
     1976   do:
     1977     run gbl/app_help.p
     1978       (input this-procedure :file-name
     1979       ,input ''
     1980       ,input ?
     1981       ) no-error.
     1982     if error-status :error then do:
     1983       message
     1984         "Ошибка при вызове помощи"
     1985         error-status :get-message(1)
     1986         view-as alert-box .
     1987     end.
     1988   end.
     1989   run minbtn-set in this-procedure .
     1990   on choose of b-help in frame Dialog-Frame
     1991   do:
     1992     apply "help":u to frame Dialog-Frame .
     1993   end.
     1994   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1995   procedure minbtn-set :
     1996       do
     1997           on error undo, return error return-value
     1998           :
     1999           define variable ii              as integer       no-undo .
     2000           define variable fh              as widget-handle no-undo .
     2001           define variable hh              as widget-handle no-undo .
     2002           define variable v-h             as handle        extent 4 no-undo .
     2003           define variable v-name-button   as character     no-undo .
     2004           define variable v-help-old-x    as decimal       no-undo .
     2005           define variable v-help-old-y    as decimal       no-undo .
     2006           define variable v-help-old-size as decimal       no-undo .
     2007           define variable v-frame-width   as decimal       no-undo .
     2008           define variable jj              as integer       no-undo .
     2009           do
     2010               on error undo, return error
     2011               :
     2012               assign
     2013                   v-frame-width = frame Dialog-Frame:width - 0.3
     2014                   fh            = frame Dialog-Frame:first-child
     2015                   hh            = fh:first-child
     2016                   ii            = 1
     2017                   .
     2018               do while valid-handle(hh):
     2019                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2020                   do:
     2021                       case lc(hh:name) :
     2022                           when "b-help" then
     2023                               do:
     2024                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2025                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2026                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2027                                   hh:TOOLTIP = "Помощь" .
     2028                                   v-help-old-x = hh:column .
     2029                                   v-help-old-y = hh:row    .
     2030                                   v-help-old-size = hh:width .
     2031                                   hh:width-chars = 2.5 .
     2032                               end.
     2033                           when "b-print" then
     2034                               do:
     2035                                   hh:load-image("cmp/b-print.bmp":u) .
     2036                                   hh:TOOLTIP = "Печать" .
     2037                                   v-h[ii] = hh:handle .
     2038                                   ii = ii + 1 .
     2039                                   hh:width-chars = 3 .
     2040                               end.
     2041                           when "b-history" or
     2042                           when "b-hist" then
     2043                               do:
     2044                                   hh:load-image("cmp/b-hist.bmp":u) .
     2045                                   hh:TOOLTIP = "История" .
     2046                                   v-h[ii] = hh:handle .
     2047                                   ii = ii + 1 .
     2048                                   hh:width-chars = 3 .
     2049                               end.
     2050                           when "b-sch" then
     2051                               do:
     2052                                   hh:load-image("cmp/b-sch.bmp":u) .
     2053                                   hh:TOOLTIP = "Установка Фильтра" .
     2054                                   v-h[ii] = hh:handle .
     2055                                   ii = ii + 1 .
     2056                                   hh:width-chars = 3 .
     2057                               end.
     2058                           when "b-hist-user" then
     2059                               do:
     2060                                   hh:load-image("cmp/b-hist.bmp":u) .
     2061                                   hh:TOOLTIP = "История пользователя" .
     2062                                   ii = ii + 1 .
     2063                               end.
     2064                       end case.
     2065                   end.
     2066                   hh = hh:next-sibling.
     2067               end.
     2068               b-help:column = v-frame-width - b-help:width-chars.
     2069               jj = 0.
     2070               repeat ii = 4 to 1 by -1 :
     2071                   if valid-handle (v-h[ii] ) then
     2072                   do:
     2073                       jj  = jj + 1 .
     2074                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2075                       v-h[ii]:row    = v-help-old-y .
     2076                   end.
     2077               end.
     2078           end.
     2079       end.
     2080   end procedure.
     2081   procedure rcpscont_get-rule-on-off :
     2082   define input parameter p-codex-id as integer no-undo .
     2083   define input parameter p-ruleset-id as integer no-undo .
     2084   define input parameter p-rule-id as integer no-undo .
     2085   define input parameter p-profile-id as integer no-undo .
     2086   define input parameter p-once-more as integer no-undo .
     2087   define output parameter p-on-off as logical no-undo .
     2088   define buffer buf_tt0-rule-by-call for ub.rule-by-call.
     2089   find first buf_tt0-rule-by-call where
     2090            buf_tt0-rule-by-call.codex_id = p-codex-id
     2091        and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     2092        and buf_tt0-rule-by-call.profile_id = p-profile-id
     2093        and buf_tt0-rule-by-call.once-more = p-once-more
     2094        and buf_tt0-rule-by-call.rule_id = p-rule-id
     2095        no-error .
     2096   if available buf_tt0-rule-by-call then do:
     2097      p-on-off = buf_tt0-rule-by-call.can-calc.
     2098   end.
     2099   end procedure.
     2100   procedure rcpscont_set-rule-on-off :
     2101   define input parameter p-codex-id as integer no-undo .
     2102   define input parameter p-ruleset-id as integer no-undo .
     2103   define input parameter p-rule-id as integer no-undo .
     2104   define input parameter p-profile-id as integer no-undo .
     2105   define input parameter p-once-more as integer no-undo .
     2106   define input parameter p-on-off as logical no-undo .
     2107   define variable v-h as handle no-undo .
     2108   define buffer buf_tt0-rule-by-call for ub.rule-by-call.
     2109   v-h = buffer ub.rule-by-call:handle.
     2110   if v-h:table <> ''
     2111   and v-h:table <> ? then do:
     2112     find first buf_tt0-rule-by-call where
     2113             buf_tt0-rule-by-call.codex_id = p-codex-id
     2114         and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     2115         and buf_tt0-rule-by-call.profile_id = p-profile-id
     2116         and buf_tt0-rule-by-call.once-more = p-once-more
     2117         and buf_tt0-rule-by-call.rule_id = p-rule-id   no-error .
     2118     if not available buf_tt0-rule-by-call then do:
     2119       undo, return error .
     2120     end.
     2121     buf_tt0-rule-by-call.can-calc = p-on-off .
     2122     release buf_tt0-rule-by-call.
     2123   end.
     2124   end procedure.
     2125   MAIN-BLOCK:
     2126   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2127      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2128   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2129     run mainmenu_getcntxt in parparentproc
     2130       (output v-cntxt-db-num
     2131       ,output v-cntxt-userid
     2132       ,output v-cntxt-level
     2133       ,output v-cntxt-host-code-obj
     2134       ,output v-cntxt-obj-type
     2135       ,output v-cntxt-obj-code
     2136       ,output v-cntxt-db-num-obj
     2137       ,output v-cntxt-is-admin
     2138       ) .
     2139     v-profile-type = entry(1, p-parameter, chr(4)).
     2140     v-dop = (if num-entries(p-parameter, chr(4)) > 2
     2141              then entry(3, p-parameter, chr(4))
     2142              else '').
     2143     find first buf_rule-process no-error.
     2144     if not available buf_rule-process
     2145     then do:
     2146       message
     2147         "Нарушение целосности машины правил: нет записей в таблице rule-process. Обратитесь к администратору системы"
     2148         view-as alert-box error.
     2149       undo, return error.
     2150     end.
     2151     case v-profile-type:
     2152       when 'goods':U then do:
     2153         v-prop-code = 'goods':U.
     2154         v-codex-id = 11.
     2155         FIND FIRST buf_ruleset NO-LOCK WHERE
     2156             buf_ruleset.codex_id = v-codex-id
     2157             AND buf_ruleset.ruleset_id = 0.
     2158         ASSIGN
     2159         frame Dialog-Frame:title = buf_ruleset.name.
     2160       end.
     2161       when 'clients':U then do:
     2162         v-prop-code = 'clients':U.
     2163         v-codex-id = 12.
     2164         FIND FIRST buf_ruleset NO-LOCK WHERE
     2165             buf_ruleset.codex_id = v-codex-id
     2166             AND buf_ruleset.ruleset_id = 0.
     2167         ASSIGN
     2168         frame Dialog-Frame:title = buf_ruleset.name.
     2169       end.
     2170       when 'gds-grp':U then do:
     2171         v-prop-code = 'gds-grp':U.
     2172         v-codex-id = 13.
     2173         FIND FIRST buf_ruleset NO-LOCK WHERE
     2174             buf_ruleset.codex_id = v-codex-id
     2175             AND buf_ruleset.ruleset_id = 0.
     2176         ASSIGN
     2177         frame Dialog-Frame:title = buf_ruleset.name.
     2178       end.
     2179       when 'cli-grp':U then do:
     2180         v-prop-code = 'cli-grp':U.
     2181         v-codex-id = 14.
     2182         FIND FIRST buf_ruleset NO-LOCK WHERE
     2183             buf_ruleset.codex_id = v-codex-id
     2184             AND buf_ruleset.ruleset_id = 0.
     2185         ASSIGN
     2186         frame Dialog-Frame:title = buf_ruleset.name.
     2187       end.
     2188       when 'edoc':U then do:
     2189         v-prop-code = 'edoc':U.
     2190         v-codex-id = 18.
     2191         FIND FIRST buf_ruleset NO-LOCK WHERE
     2192             buf_ruleset.codex_id = v-codex-id
     2193             AND buf_ruleset.ruleset_id = 0.
     2194         ASSIGN
     2195         frame Dialog-Frame:title = buf_ruleset.name.
     2196       end.
     2197       when 'thref':U then do:
     2198         v-prop-code = 'thref':U.
     2199         v-codex-id = 20.
     2200         FIND FIRST buf_ruleset NO-LOCK WHERE
     2201             buf_ruleset.codex_id = v-codex-id
     2202             AND buf_ruleset.ruleset_id = 0.
     2203         ASSIGN
     2204         frame Dialog-Frame:title = buf_ruleset.name.
     2205       end.
     2206       when 'rep':U then do:
     2207         v-prop-code = 'rep':U.
     2208         v-codex-id = 22.
     2209         FIND FIRST buf_ruleset NO-LOCK WHERE
     2210             buf_ruleset.codex_id = v-codex-id
     2211             AND buf_ruleset.ruleset_id = 0.
     2212         ASSIGN
     2213         frame Dialog-Frame:title = buf_ruleset.name.
     2214       end.
     2215       when 'ord':U then do:
     2216         v-prop-code = 'ord':U.
     2217         v-codex-id = 23.
     2218         FIND FIRST buf_ruleset NO-LOCK WHERE
     2219             buf_ruleset.codex_id = v-codex-id
     2220             AND buf_ruleset.ruleset_id = 0.
     2221         ASSIGN
     2222         frame Dialog-Frame:title = buf_ruleset.name.
     2223       end.
     2224     end case.
     2225     DO v-ii = 1 TO NUM-ENTRIES(ENTRY(2, p-parameter, chr(4))) by 2:
     2226         FIND FIRST buf_rule-process NO-LOCK WHERE
     2227                   buf_rule-process.pchain-type = entry(1, p-parameter, chr(4))
     2228              AND buf_rule-process.pchain-id = entry(v-ii, ENTRY(2, p-parameter, chr(4))) NO-ERROR.
     2229         IF NOT AVAILABLE buf_rule-process THEN DO:
     2230             MESSAGE
     2231             "Неверное значение параметра p-parameter" SKIP
     2232             substitute("Не удается найти процесс &1 для типа процесса &2"
     2233                        , entry(v-ii , ENTRY(2, p-parameter, chr(4)))
     2234                        , entry(1, p-parameter, chr(4)))
     2235            VIEW-AS ALERT-BOX ERROR.
     2236             UNDO, RETURN ERROR.
     2237         END.
     2238     END.
     2239     find first buf_thbj-attr no-lock where
     2240               buf_thbj-attr.upper-prop-code = 'rum':U
     2241           and buf_thbj-attr.prop-code = v-prop-code
     2242           and buf_thbj-attr.obj-type = ''
     2243           and buf_thbj-attr.obj-code = 0
     2244           and buf_thbj-attr.property-value-logical = yes
     2245           no-error.
     2246     if not available buf_thbj-attr then do:
     2247       find first buf_ruleset no-lock where
     2248                 buf_ruleset.codex_id = v-codex-id
     2249             and buf_ruleset.ruleset_id = 0.
     2250       message
     2251       substitute("В Вашей системе нет настроек &1", buf_ruleset.name)
     2252       view-as alert-box error .
     2253       undo, return ''.
     2254     end.
     2255     run gen-key-rec in this-procedure (
     2256                                       input  'thbj-attr':U
     2257                                      ,input (buffer buf_thbj-attr:handle)
     2258                                      ,output v-uniq-key-rec).
     2259     run Myenable in this-procedure .
     2260     if rs-rule-process:num-buttons = 1 then do:
     2261       apply "CHOOSE" to b-profile.
     2262     end.
     2263     WAIT-FOR GO OF FRAME Dialog-Frame.
     2264   END.
     2265   run disable_UI in this-procedure .
     2266   for each buf_rule-process no-lock where
     2267             buf_rule-process.pchain-type = v-profile-type
     2268         and buf_rule-process.pchain-id = rs-rule-process
     2269         and buf_rule-process.start-from = (if v-cntxt-db-num = 0 then 0 else 1) :
     2270     if buf_rule-process.needs-ifile = 1  then do:
     2271       v-needs-ifile = yes.
     2272     end.
     2273   end.
     2274   assign
     2275   v-current-file-name = file-name.
     2276   if v-run then do:
     2277     _do:
     2278     do while v-current-file-index >= 0 :
     2279       case v-prop-code:
     2280         when 'goods':U then do:
     2281           if not available X_rp-by-call then do:
     2282             message
     2283             "Не выбрана привязка к алгоритму"
     2284             view-as alert-box error .
     2285           end.
     2286           if v-ruleproc = 'goods-batchwork':U
     2287           then do:
     2288             run cb_set-rp-by-call in p-parent-handle (
     2289                                                         input X_rp-by-call.call_id
     2290                                                       ,input X_rp-by-call.profile_id
     2291                                                       ,input X_rp-by-call.once-more
     2292                                                       ,input table tt0-rule-call-param
     2293                                                       ).
     2294           end.
     2295           else do:
     2296           run str/goodsrum.p
     2297             (
     2298             input parparentproc
     2299             ,input p-parent-handle
     2300             ,input p-log-handle
     2301             ,input v-ruleproc
     2302             ,input X_rule-profile.profile_id
     2303             ,input v-codex-id
     2304             ,input v-ruleset-id
     2305             ,input v-cntxt-db-num
     2306             ,input v-uniq-key-rec
     2307             ,input ( string(next-value(s-v-doc, ub)) + chr(4) +
     2308                           v-current-file-name
     2309                     )
     2310             ,input yes
     2311             ) no-error .
     2312         end.
     2313         end.
     2314         when 'clients':U then do:
     2315           run str/clisrum.p
     2316             (
     2317             input parparentproc
     2318             ,input p-parent-handle
     2319             ,input p-log-handle
     2320             ,input v-ruleproc
     2321             ,input X_rule-profile.profile_id
     2322             ,input v-codex-id
     2323             ,input v-ruleset-id
     2324             ,input v-cntxt-db-num
     2325             ,input v-uniq-key-rec
     2326             ,input ( string(next-value(s-v-doc, ub)) + chr(4) +
     2327                           v-current-file-name
     2328                     )
     2329             ,input yes
     2330             ) no-error .
     2331         end.
     2332         when 'gds-grp':U then do:
     2333           run str/ggrprum.p
     2334             (
     2335             input parparentproc
     2336             ,input p-parent-handle
     2337             ,input p-log-handle
     2338             ,input v-ruleproc
     2339             ,input X_rule-profile.profile_id
     2340             ,input v-codex-id
     2341             ,input v-ruleset-id
     2342             ,input v-cntxt-db-num
     2343             ,input v-uniq-key-rec
     2344             ,input ( string(next-value(s-v-doc, ub)) + chr(4) +
     2345                           v-current-file-name
     2346                     )
     2347             ,input yes
     2348             ) no-error .
     2349         end.
     2350         when 'cli-grp':U then do:
     2351           run str/cgrprum.p
     2352             (
     2353             input parparentproc
     2354             ,input p-parent-handle
     2355             ,input p-log-handle
     2356             ,input v-ruleproc
     2357             ,input X_rule-profile.profile_id
     2358             ,input v-codex-id
     2359             ,input v-ruleset-id
     2360             ,input v-cntxt-db-num
     2361             ,input v-uniq-key-rec
     2362             ,input ( string(next-value(s-v-doc, ub)) + chr(4) +
     2363                           v-current-file-name
     2364                     )
     2365             ,input yes
     2366             ) no-error .
     2367         end.
     2368         when 'edoc':U then do:
     2369           run str/edocrum.p
     2370             (
     2371             input parparentproc
     2372             ,input p-parent-handle
     2373             ,input p-log-handle
     2374             ,input v-ruleproc
     2375             ,input X_rule-profile.profile_id
     2376             ,input v-codex-id
     2377             ,input v-ruleset-id
     2378             ,input v-cntxt-db-num
     2379             ,input v-uniq-key-rec
     2380             ,input ( v-dop + chr(4) +
     2381                           v-current-file-name
     2382                     )
     2383             ,input yes
     2384             ) no-error .
     2385         end.
     2386         when 'thref':U then do:
     2387           run ref/threfrum.p
     2388             (
     2389             input parparentproc
     2390             ,input p-parent-handle
     2391             ,input p-log-handle
     2392             ,input v-ruleproc
     2393             ,input X_rule-profile.profile_id
     2394             ,input v-codex-id
     2395             ,input v-ruleset-id
     2396             ,input v-cntxt-db-num
     2397             ,input v-uniq-key-rec
     2398             ,input ( string(next-value(s-v-doc, ub)) + chr(4) +
     2399                           v-current-file-name
     2400                     )
     2401             ,input yes
     2402             ) no-error .
     2403         end.
     2404         when 'rep':U
     2405         or
     2406         when 'ord':U
     2407         then do:
     2408           if not available X_rp-by-call then do:
     2409             message
     2410             "Не выбрана привязка к алгоритму"
     2411             view-as alert-box error .
     2412           end.
     2413           else do:
     2414             if v-ruleproc = 'batchwork':U
     2415             or v-ruleproc = 'batchwork':U
     2416             then do:
     2417               run cb_set-rp-by-call in p-parent-handle (
     2418                                                          input X_rp-by-call.call_id
     2419                                                         ,input X_rp-by-call.profile_id
     2420                                                         ,input X_rp-by-call.once-more
     2421                                                         ,input table tt0-rule-call-param
     2422                                                         ).
     2423             end.
     2424             else do:
     2425                 message "Не обработано!"
     2426                 view-as alert-box .
     2427             end.
     2428           end.
     2429         end.
     2430       end case.
     2431       if v-needs-ifile then do:
     2432         v-current-file-index = v-current-file-index  + 1.
     2433         assign
     2434         v-current-file-name = rum-fn_get-next-file-name ( file-name, v-current-file-index)
     2435         no-error.
     2436         if error-status:error then do:
     2437           if v-current-file-index = 1 then do:
     2438             v-current-file-index = -2.
     2439           end.
     2440           else do:
     2441             v-current-file-index = -1.
     2442           end.
     2443           leave _do.
     2444         end.
     2445         assign
     2446         file-info:file-name = v-current-file-name
     2447         .
     2448         run gbl/filename.p (
     2449                        input  v-current-file-name
     2450                       ,output v-full-path
     2451                       ,output v-path
     2452                       ,output v-file-name
     2453                       ,output v-file-name-no-ext
     2454                       ,output v-file-name-ext
     2455                       ) no-error .
     2456         if error-status:error then do:
     2457           if v-current-file-index = 0 then do:
     2458             v-current-file-index = -2.
     2459           end.
     2460           else do:
     2461             v-current-file-index = -1.
     2462           end.
     2463           leave _do.
     2464         end.
     2465       end.
     2466       else do:
     2467         leave _do.
     2468       end.
     2469     end.
     2470     if error-status:error
     2471     and v-current-file-index = -2
     2472     then do:
     2473       message
     2474       error-status:get-message(1) view-as alert-box .
     2475       undo, return error return-value .
     2476     end.
     2477   end.
     2478   else do:
     2479     return "return".
     2480   end.
     2481   PROCEDURE add-lines :
     2482   DEFINE BUFFER buf_temp-string FOR temp-string.
     2483   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2484   for each buf_temp-string:
     2485     glog = ed-notes:INSERT-STRING ( buf_temp-string.v-string ) in frame Dialog-Frame .
     2486     glog = ed-notes:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     2487   end.
     2488   END PROCEDURE.
     2489   PROCEDURE cb_thbjrumr_is-running :
     2490   DEFINE OUTPUT PARAMETER p-is-running AS LOGICAL NO-UNDO.
     2491   p-is-running = YES.
     2492   END PROCEDURE.
     2493   PROCEDURE disable_UI :
     2494     HIDE FRAME Dialog-Frame.
     2495   END PROCEDURE.
     2496   PROCEDURE enable_UI :
     2497     OPEN QUERY Dialog-Frame FOR EACH X_rule-profile SHARE-LOCK,       EACH X_ruleset WHERE TRUE  SHARE-LOCK,       EACH X_rule-by-call WHERE TRUE  SHARE-LOCK,       EACH X_rp-by-call WHERE TRUE  SHARE-LOCK.
     2498     GET FIRST Dialog-Frame.
     2499     DISPLAY rs-rule-process file-name Ed-notes
     2500         WITH FRAME Dialog-Frame.
     2501     IF AVAILABLE X_rp-by-call THEN
     2502       DISPLAY X_rp-by-call.once-more
     2503         WITH FRAME Dialog-Frame.
     2504     IF AVAILABLE X_rule-profile THEN
     2505       DISPLAY X_rule-profile.name
     2506         WITH FRAME Dialog-Frame.
     2507     IF AVAILABLE X_ruleset THEN
     2508       DISPLAY X_ruleset.name
     2509         WITH FRAME Dialog-Frame.
     2510     ENABLE b-exit B-quit rs-rule-process B-help X_ruleset.name b-rule b-param
     2511            X_rule-profile.name B-profile X_rp-by-call.once-more file-name B-file
     2512            Ed-notes
     2513         WITH FRAME Dialog-Frame.
     2514     VIEW FRAME Dialog-Frame.
     2515   END PROCEDURE.
     2516   PROCEDURE MyEnable :
     2517   define variable v-ii as integer no-undo .
     2518   define variable v-name as character no-undo .
     2519   define buffer buf_rule-process for ub.rule-process.
     2520   do v-ii = 1 to num-entries(ENTRY(2, p-parameter, chr(4))):
     2521     find first buf_rule-process no-lock where
     2522               buf_rule-process.pchain-type = ENTRY(1, p-parameter, chr(4))
     2523           and buf_rule-process.pchain-id = entry(v-ii, ENTRY(2, p-parameter, chr(4)))
     2524           and buf_rule-process.start-from = (if v-cntxt-db-num = 0 then 0 else 1) no-error .
     2525   if not available buf_rule-process then do:
     2526     message
     2527     substitute("Не найден процесс &1 типа &2 для &3"
     2528                ,entry(v-ii, ENTRY(2, p-parameter, chr(4)))
     2529                ,ENTRY(1, p-parameter, chr(4))
     2530                ,(if v-cntxt-db-num = 0 then "ГБД" else "УБД")
     2531                )
     2532     view-as alert-box error .
     2533     return error.
     2534   end.
     2535   case entry(1, p-parameter, chr(4)):
     2536     when 'clients':U then do:
     2537       v-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import,text-import,text-export,cliadd,cliupdate':U) + 1, ',' + 'Операции по списку-экспорт,Операции по списку-маршрутизация,Импорт из xml-файла,Импорт из ВС,Импорт данных в текст.виде,Экспорт данных в текст.виде,Добавление клиента,Изменение клиента':U).
     2538     end.
     2539     when 'goods':U then do:
     2540       v-name = entry (lookup (buf_rule-process.pchain-id, 'gdsadd,gdsupdate,rengdscode,addlcode,dellcode,updatelcode,addprcode,delprcode,updateprcode,xml-file-import,xml-esys-import,batchwork-export,batchwork-routing,rest-update,goods-cd-send,goods-batchwork,add-good-to-asm,del-good-from-asm':U) + 1, ',' + 'Добавление товара,Изменение товара,Смена кода товара,Добавление лок.кода,Удаление лок.кода,Изменение лок.кода,Добавление Доп.БК,Удаление Доп.БК,Изменение Доп.БК,Импорт из xml-файла,Импорт из ВС,Операции по списку-экспорт,Операции по списку-маршрутизация,Изменение остатка,Передача товаров на кассу,Работа в атоматическом режиме,add-good-to-asm,del-good-from-asm':U).
     2541     end.
     2542     when 'gds-grp':U then do:
     2543       v-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import':U) + 1, ',' + 'Операции по списку-экспорт,Операции по списку-маршрутизация,Импорт из xml-файла,Импорт из ВС':U).
     2544     end.
     2545     when 'cli-grp':U then do:
     2546       v-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import':U) + 1, ',' + 'Операции по списку-экспорт,Операции по списку-маршрутизация,Импорт из xml-файла,Импорт из ВС':U).
     2547     end.
     2548     when 'edoc':U then do:
     2549       v-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export_order,batchwork-routing_order,xml-esys-import_order,xml-file-import_order,batchwork-export_rcv,batchwork-routing_rcv,xml-esys-import_rcv,xml-file-import_rcv,batchwork-routing_price-doc,xml-esys-import_price-doc,xml-esys-import_trn-doc,batchwork-routing_trn-doc,xml-esys-import_inv-doc,xml-esys-import_contract,batchwork-routing_intorder,xml-esys-import_intorder,batchwork-routing_inkas,event_order,event_rcv,event_trn-doc,event_inv-doc,event_intorder,event_price-doc,event_inkas,text-export_specif,excel-export_specif,text-import_specif,excel-import_specif':U) + 1, ',' + 'Заказы поставщику-экспорт,Заказы поставщику-маршрутизация,Заказы поставщику-импорт из ВС,Заказы поставщику-импорт из xml-файла,Поставки поставщика-экспорт,Поставки поставщика-маршрутизация,Поставка поставщика-импорт из ВС,Поставка поставщика-импорт из xml-файла,ДНЦ/переоценка-маршрутизация,ДНЦ-импорт из ВС,Накладные-импорт из ВС,Накладные-маршрутизация,Инвентаризации-импорт из ВС,Дог-ра и специф-ции-импорт из ВС,Заявки РЦ-маршрутизация,Заявки РЦ-импорт из ВС,Док-ты продажи-маршрутизация,Заказы поставщику-событие,Поставки поставщика-событие,Накладные-событие,Инвентаризация-событие,Заявки РЦ-событие,ДНЦ/переоценка-событие,Документ продажи-событие,Экспорт спецификации в текст.файл,Экспорт спецификации в Excel,Импорт спецификации из текст.файла,Импорт спецификации из Excel':U).
     2550     end.
     2551     when 'thref':U then do:
     2552       v-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import,recadd,recupdate,ref-event':U) + 1, ',' + 'Операции по списку-экспорт,Операции по списку-маршрутизация,Импорт из xml-файла,Импорт из ВС,Добавление записи,Изменение записи,События справочников':U).
     2553     end.
     2554     when 'rep':U then do:
     2555       v-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork,close-shift':U) + 1, ',' + 'Выполнение отчета по расписанию,Выполнение отчета при закрытии смены':U).
     2556     end.
     2557     when 'ord':U then do:
     2558       v-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork':U) + 1, ',' + 'Работа с заказами по расписанию':U).
     2559     end.
     2560   end case.
     2561     assign
     2562     rs-rule-process:RADIO-BUTTONS IN FRAME Dialog-Frame = (if v-ii = 1 then '' else ((rs-rule-process:RADIO-BUTTONS IN FRAME Dialog-Frame) + chr(44))) +
     2563                                                       v-name + chr(44) + buf_rule-process.pchain-id
     2564     .
     2565   end.
     2566   ASSIGN
     2567   rs-rule-process = ENTRY(1, ENTRY(2, p-parameter, chr(4)))
     2568   .
     2569   assign
     2570   X_rule-profile.name:read-only in frame Dialog-Frame = yes
     2571   X_rp-by-call.once-more:read-only in frame Dialog-Frame = yes
     2572   .
     2573   DISPLAY
     2574   rs-rule-process
     2575   file-name
     2576   WITH FRAME Dialog-Frame .
     2577   ENABLE
     2578   rs-rule-process
     2579   b-exit
     2580   B-quit
     2581   B-help
     2582   file-name
     2583   B-file
     2584   b-profile
     2585   ed-notes
     2586   X_ruleset.NAME
     2587   X_rule-profile.name
     2588   X_rp-by-call.once-more
     2589   WITH FRAME Dialog-Frame .
     2590   VIEW FRAME Dialog-Frame .
     2591   APPLY "VALUE-CHANGED" TO rs-rule-process.
     2592   END PROCEDURE.
     2593   PROCEDURE proc-b-param :
     2594   define input parameter p-from-button as logical no-undo .
     2595   if not available X_rule-profile then do:
     2596     message
     2597     "Сначала необходимо выбрать профайл"
     2598     view-as alert-box error .
     2599     return error.
     2600   end.
     2601   define variable v-list-mode as character no-undo .
     2602   define variable v-param-form as character no-undo .
     2603   define variable v-is-esys-import as logical no-undo .
     2604   define variable v-is-routing as logical no-undo .
     2605   define buffer buf_rule-process for ub.rule-process.
     2606   for each buf_rule-process no-lock where
     2607             buf_rule-process.pchain-type = v-profile-type
     2608         and buf_rule-process.pchain-id = rs-rule-process
     2609         and buf_rule-process.start-from = (if v-cntxt-db-num = 0 then 0 else 1):
     2610     if buf_rule-process.is-esys-import = 1  then v-is-esys-import = yes.
     2611     if buf_rule-process.is-routing = 1 then v-is-routing = yes.
     2612   end.
     2613   assign
     2614   v-param-form = (if X_rule-profile.custom-param-form > 0
     2615                   then  substitute("rul/rcps-&1.w", X_rule-profile.profile_id)
     2616                   else "ref/rulercps.w")
     2617   v-list-mode = (if X_rule-profile.custom-param-form > 0
     2618                  then 'rp-rule-param':U
     2619                  else 'rule-call-param':U)
     2620   .
     2621   run value(v-param-form) (
     2622                        input parparentproc
     2623                       ,input this-procedure:handle
     2624                       ,input (if not (v-is-esys-import or  v-is-routing )
     2625                               and v-ruleproc <> 'batchwork':U
     2626                              and v-ruleproc <> 'batchwork':U
     2627                              and v-ruleproc <> 'goods-batchwork':U
     2628                              then "b-chg,running":U
     2629                              else 'running')
     2630                       ,input (if not (v-is-esys-import or v-is-routing )
     2631                              then 'ИЗМЕНЕНИЕ':U
     2632                              else 'ПРОСМОТР':U)
     2633                       ,input v-list-mode
     2634                       ,input X_rule-profile.profile_id
     2635                       ,input X_rp-by-call.once-more
     2636                       ,input X_rp-by-call.call_id
     2637                       ,input 0
     2638                       ,input 0
     2639                       ,input ?
     2640                       ,input 0
     2641                       ,INput substitute("Профайл &1 &2"
     2642                                         , X_rule-profile.profile_id, calldscr(X_rp-by-call.call_id))
     2643                       ,input-output table tt0-rule-call-param  ) no-error.
     2644   RUN  refill-rp-by-call IN THIS-PROCEDURE NO-ERROR.
     2645   END PROCEDURE.
     2646   PROCEDURE proc-b-rule :
     2647   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2648   if not available X_rule-profile then do:
     2649     message
     2650     "Сначала необходимо определить профайл"
     2651     view-as alert-box error .
     2652     return error.
     2653   end.
     2654   run rul/rule-by-profile-s.w ( INPUT parparentproc
     2655                                ,INPUT ''
     2656                                ,INPUT "profile"
     2657                                ,INPUT X_rule-profile.profile_id
     2658                                ,INPUT v-codex-id
     2659                                ,INPUT v-ruleset-id
     2660                                ,INPUT 0
     2661                                ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2662   END PROCEDURE.
     2663   PROCEDURE proc-b-type :
     2664   define variable v-found as logical no-undo .
     2665   define buffer buf_rule-call-param for ub.rule-call-param.
     2666   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2667   IF NOT AVAILABLE X_rp-by-call THEN DO:
     2668     MESSAGE
     2669     "Сначала необходимо определить профайл"
     2670     VIEW-AS ALERT-BOX.
     2671     disable b-param
     2672     with frame Dialog-Frame .
     2673     RETURN ERROR.
     2674   END.
     2675   FOR EACH buf_tt0-rule-call-param:
     2676      DELETE buf_tt0-rule-call-param.
     2677   END.
     2678   for each buf_Rule-call-param no-lock where
     2679           buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     2680       and  buf_rule-call-param.profile_id = X_rp-by-call.profile_id
     2681       AND buf_rule-call-param.once-more = X_rp-by-call.once-more:
     2682     create buf_tt0-rule-call-param.
     2683     buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     2684     v-found = yes.
     2685   end.
     2686   if v-found
     2687   and v-ruleproc <> 'batchwork':U
     2688   and v-ruleproc <> 'batchwork':U
     2689   and v-ruleproc <> 'goods-batchwork':U
     2690   then do:
     2691     RUN proc-b-param IN THIS-PROCEDURE ( input no) NO-ERROR.
     2692   end.
     2693   END PROCEDURE.
     2694   PROCEDURE proc-save :
     2695   define variable v-full-path        as character no-undo .
     2696   define variable v-path             as character no-undo .
     2697   define variable v-file-name        as character no-undo .
     2698   define variable v-file-name-no-ext as character no-undo .
     2699   define variable v-file-name-ext    as character no-undo .
     2700   define variable glog as logical no-undo .
     2701   if file-name:visible in frame Dialog-Frame then do:
     2702     ASSIGN FRAME Dialog-Frame
     2703     file-name
     2704     .
     2705     if file-name = '':u
     2706     or file-name = ?
     2707     then do:
     2708       message
     2709       "Не задан файл"
     2710       view-as alert-box error .
     2711       undo, return error .
     2712     end.
     2713   end.
     2714   if not available X_rule-profile then do:
     2715     message
     2716     "Не выбран профайл!"
     2717     view-as alert-box error .
     2718     undo, return error .
     2719   end.
     2720   if v-cntxt-db-num = 0 then do:
     2721     if (v-profile-type = 'rep':U
     2722     and v-ruleproc = 'batchwork':U)
     2723     or (v-profile-type = 'ord':U
     2724     and v-ruleproc = 'batchwork':U)
     2725     or (v-profile-type = 'goods':U
     2726     and v-ruleproc = 'goods-batchwork':U)
     2727     or (v-profile-type = 'edoc':U
     2728     and v-ruleproc = 'batchwork-routing_order':U)
     2729     or (v-profile-type = 'edoc':U
     2730     and v-ruleproc = 'batchwork-routing_price-doc':U)
     2731     or (v-profile-type = 'edoc':U
     2732     and v-ruleproc = 'batchwork-routing_trn-doc':U)
     2733     or (v-profile-type = 'edoc':U
     2734     and v-ruleproc = 'batchwork-routing_inkas':U)
     2735     or (v-profile-type = 'edoc':U
     2736     and v-ruleproc = 'text-import_specif':U)
     2737     or (v-profile-type = 'edoc':U
     2738     and v-ruleproc = 'excel-import_specif':U)
     2739     or (v-profile-type = 'edoc':U
     2740     and v-ruleproc = 'text-export_specif':U)
     2741     or (v-profile-type = 'edoc':U
     2742     and v-ruleproc = 'excel-export_specif':U)
     2743     or X_rule-profile.short-name begins "_"
     2744     or v-ruleproc = 'recipe-xml-file-import':U
     2745     then do:
     2746       glog = no.
     2747     end.
     2748     else do:
     2749     message
     2750     "Сохранить изменения значений параметров (если они были) в БД?"
     2751     view-as alert-box question buttons yes-no update glog.
     2752     end.
     2753     if glog then do:
     2754       run rul/ruprcall.p ( input v-profile-type
     2755                           ,input v-uniq-key-rec
     2756                           ,input 'rule-call-param':U
     2757                           ,input ?
     2758                           ,input 0
     2759                           ,INPUT TABLE tt0-rp-by-call
     2760                           ,INPUT TABLE tt0-rule-by-call
     2761                           ,INPUT TABLE tt0-rule-call-param) no-error .
     2762     if error-status:error then do:
     2763       message
     2764       "Ошибка при сохранении параметров правил" skip
     2765       error-status:get-message(1) skip
     2766       return-value
     2767       view-as alert-box error .
     2768       undo, return error .
     2769     end.
     2770   end.
     2771   end.
     2772   END PROCEDURE.
     2773   PROCEDURE refill-rp-by-call :
     2774   RUN temp-string_clear IN THIS-PROCEDURE.
     2775   IF AVAILABLE X_rp-by-call  THEN DO:
     2776       run rul/rule-proc-view.p ( input v-profile-type
     2777                                 ,input v-ruleproc
     2778                                 ,input (IF v-cntxt-db-num = 0 THEN 0 ELSE 1 )
     2779                                 ,input X_rp-by-call.CALL_id
     2780                                 ,input X_rp-by-call.profile_id
     2781                                 ,input X_rp-by-call.once-more
     2782                                 ,input "text-temp"
     2783                                 ,input this-procedure:HANDLE
     2784                                 ) no-error.
     2785       ed-notes:SCREEN-VALUE  IN FRAME Dialog-Frame = '' .
     2786       run add-lines in THIS-PROCEDURE  .
     2787   END.
     2788   ELSE DO:
     2789     ed-notes:SCREEN-VALUE  IN FRAME Dialog-Frame = '' .
     2790   END.
     2791   END PROCEDURE.
