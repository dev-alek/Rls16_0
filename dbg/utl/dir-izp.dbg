        1   define output parameter p-source-dir as character no-undo .
        2   define output parameter p-archive-dir as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Директории Импорта НАКЛАДНЫХ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   p-source-dir  = ?.
       79   p-archive-dir = ?.
       80   define stream test2.
       81   define variable v-old-source-dir as character no-undo .
       82   define variable v-old-archive-dir as character no-undo .
       83   DEFINE BUTTON B-Help
       84        LABEL "Помо&щь"
       85        SIZE 10 BY 1
       86        BGCOLOR 8 .
       87   DEFINE BUTTON B-quit AUTO-END-KEY
       88        LABEL "&Отмена"
       89        SIZE 10 BY 1
       90        BGCOLOR 8 .
       91   DEFINE BUTTON b-save AUTO-GO DEFAULT
       92        LABEL "&Ввод"
       93        SIZE 10 BY 1
       94        BGCOLOR 8 .
       95   DEFINE BUTTON b-sel-archive-dir DEFAULT
       96        IMAGE-UP FILE "btn-down-arrow":U
       97        IMAGE-DOWN FILE "btn-down-arrow":U
       98        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       99        LABEL "":L
      100        SIZE-PIXELS 20 BY 26.
      101   DEFINE BUTTON b-sel-source-dir DEFAULT
      102        IMAGE-UP FILE "btn-down-arrow":U
      103        IMAGE-DOWN FILE "btn-down-arrow":U
      104        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      105        LABEL "":L
      106        SIZE-PIXELS 20 BY 26.
      107   DEFINE VARIABLE v-archive-dir AS CHARACTER FORMAT "X(256)":U
      108        LABEL "Директория архив"
      109        VIEW-AS FILL-IN
      110        SIZE 38 BY 1 NO-UNDO.
      111   DEFINE VARIABLE v-source-dir AS CHARACTER FORMAT "X(256)":U
      112        LABEL "Директория источник"
      113        VIEW-AS FILL-IN
      114        SIZE 38 BY 1 NO-UNDO.
      115   DEFINE FRAME Dialog-Frame
      116        b-save AT ROW 1 COL 1
      117        B-quit AT ROW 1 COL 11
      118        B-Help AT ROW 1 COL 77
      119        b-sel-source-dir AT Y 48 X 548
      120        v-source-dir AT ROW 3.04 COL 9.5
      121        b-sel-archive-dir AT Y 76 X 548
      122        v-archive-dir AT ROW 4.25 COL 28.5 COLON-ALIGNED
      123        SPACE(18.74) SKIP(1.78)
      124       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      125            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      126            TITLE "Директории обмена c import-rash"
      127            CANCEL-BUTTON B-quit.
      128   ASSIGN
      129          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      130          FRAME Dialog-Frame:HIDDEN           = TRUE.
      131   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      132   DO:
      133     APPLY "END-ERROR":U TO SELF.
      134   END.
      135   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
      136   DO:
      137             p-source-dir  = ?.
      138             p-archive-dir = ?.
      139   END.
      140   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      141   DO:
      142     assign
      143       v-source-dir
      144       v-archive-dir
      145     .
      146       p-source-dir  =  v-source-dir  .
      147       p-archive-dir =  v-archive-dir .
      148     run check-dir ( input-output v-source-dir ) no-error.
      149     if error-status :error then do:
      150       message
      151         vss-workfile vss-revision vss-description skip
      152         return-value skip
      153         error-status :get-message(0) skip
      154         error-status :get-message(1)
      155         view-as alert-box error.
      156         p-source-dir  = ?.
      157         p-archive-dir = ?.
      158       return no-apply.
      159     end.
      160     else do:
      161       if v-source-dir <> v-old-source-dir then do:
      162         put-key-value section "import-rash":U key "import-rash-source-dir":U value v-source-dir  no-error.
      163         if error-status:error then do:
      164           message
      165             vss-workfile vss-revision vss-description skip
      166             "Файл настроек progress доступен только для чтения!" skip
      167             "Сохранение параметров невозможно."
      168             view-as alert-box error.
      169           return no-apply.
      170         end.
      171       end.
      172     end.
      173     run check-dir ( input-output v-archive-dir ) no-error.
      174     if error-status :error then do:
      175       message
      176         vss-workfile vss-revision vss-description skip
      177         return-value skip
      178         error-status :get-message(0) skip
      179         error-status :get-message(1)
      180         view-as alert-box error.
      181         p-source-dir  = ?.
      182         p-archive-dir = ?.
      183       return no-apply.
      184     end.
      185     else do:
      186       if v-archive-dir <> v-old-archive-dir then do:
      187         put-key-value section "import-rash":U key "import-rash-archive-dir":U value v-archive-dir .
      188         if error-status:error then do:
      189           message
      190             vss-workfile vss-revision vss-description skip
      191             "Файл настроек progress доступен только для чтения!" skip
      192             "Сохранение параметров невозможно."
      193             view-as alert-box error.
      194           return no-apply.
      195         end.
      196       end.
      197     end.
      198   p-source-dir  =  v-source-dir  .
      199   p-archive-dir =  v-archive-dir .
      200   END.
      201   ON CHOOSE OF b-sel-archive-dir IN FRAME Dialog-Frame
      202   DO:
      203     define variable v-dir-name  as character no-undo .
      204     define variable v-type      as character no-undo .
      205     define variable v-can-write as logical   no-undo .
      206     run gbl/dir-sel.p ( output v-dir-name
      207                    ,output v-type
      208                    ,output v-can-write
      209                   ).
      210     if v-can-write then do:
      211       assign
      212         v-archive-dir = v-dir-name
      213       .
      214       display
      215         v-archive-dir
      216         with frame Dialog-Frame
      217       .
      218     end.
      219     APPLY "ENTRY" TO v-archive-dir IN FRAME Dialog-Frame .
      220   END.
      221   ON CHOOSE OF b-sel-source-dir IN FRAME Dialog-Frame
      222   DO:
      223     define variable v-dir-name  as character no-undo .
      224     define variable v-type      as character no-undo .
      225     define variable v-can-write as logical   no-undo .
      226     run gbl/dir-sel.p ( output v-dir-name
      227                    ,output v-type
      228                    ,output v-can-write
      229                   ).
      230     if v-can-write then do:
      231       assign
      232         v-source-dir = v-dir-name
      233       .
      234       display
      235         v-source-dir
      236         with frame Dialog-Frame
      237       .
      238     end.
      239     APPLY "ENTRY" TO v-source-dir IN FRAME Dialog-Frame .
      240   END.
      241   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      242   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      243   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   on help of frame Dialog-Frame
      245   do:
      246     run gbl/app_help.p
      247       (input this-procedure :file-name
      248       ,input ''
      249       ,input ?
      250       ) no-error.
      251     if error-status :error then do:
      252       message
      253         "Ошибка при вызове помощи"
      254         error-status :get-message(1)
      255         view-as alert-box .
      256     end.
      257   end.
      258   run minbtn-set in this-procedure .
      259   on choose of b-help in frame Dialog-Frame
      260   do:
      261     apply "help":u to frame Dialog-Frame .
      262   end.
      263   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      264   procedure minbtn-set :
      265       do
      266           on error undo, return error return-value
      267           :
      268           define variable ii              as integer       no-undo .
      269           define variable fh              as widget-handle no-undo .
      270           define variable hh              as widget-handle no-undo .
      271           define variable v-h             as handle        extent 4 no-undo .
      272           define variable v-name-button   as character     no-undo .
      273           define variable v-help-old-x    as decimal       no-undo .
      274           define variable v-help-old-y    as decimal       no-undo .
      275           define variable v-help-old-size as decimal       no-undo .
      276           define variable v-frame-width   as decimal       no-undo .
      277           define variable jj              as integer       no-undo .
      278           do
      279               on error undo, return error
      280               :
      281               assign
      282                   v-frame-width = frame Dialog-Frame:width - 0.3
      283                   fh            = frame Dialog-Frame:first-child
      284                   hh            = fh:first-child
      285                   ii            = 1
      286                   .
      287               do while valid-handle(hh):
      288                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      289                   do:
      290                       case lc(hh:name) :
      291                           when "b-help" then
      292                               do:
      293                                   hh:load-image-up("cmp/b-help.bmp":u) .
      294                                   hh:load-image-down("cmp/b-help.bmp":u) .
      295                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      296                                   hh:TOOLTIP = "Помощь" .
      297                                   v-help-old-x = hh:column .
      298                                   v-help-old-y = hh:row    .
      299                                   v-help-old-size = hh:width .
      300                                   hh:width-chars = 2.5 .
      301                               end.
      302                           when "b-print" then
      303                               do:
      304                                   hh:load-image("cmp/b-print.bmp":u) .
      305                                   hh:TOOLTIP = "Печать" .
      306                                   v-h[ii] = hh:handle .
      307                                   ii = ii + 1 .
      308                                   hh:width-chars = 3 .
      309                               end.
      310                           when "b-history" or
      311                           when "b-hist" then
      312                               do:
      313                                   hh:load-image("cmp/b-hist.bmp":u) .
      314                                   hh:TOOLTIP = "История" .
      315                                   v-h[ii] = hh:handle .
      316                                   ii = ii + 1 .
      317                                   hh:width-chars = 3 .
      318                               end.
      319                           when "b-sch" then
      320                               do:
      321                                   hh:load-image("cmp/b-sch.bmp":u) .
      322                                   hh:TOOLTIP = "Установка Фильтра" .
      323                                   v-h[ii] = hh:handle .
      324                                   ii = ii + 1 .
      325                                   hh:width-chars = 3 .
      326                               end.
      327                           when "b-hist-user" then
      328                               do:
      329                                   hh:load-image("cmp/b-hist.bmp":u) .
      330                                   hh:TOOLTIP = "История пользователя" .
      331                                   ii = ii + 1 .
      332                               end.
      333                       end case.
      334                   end.
      335                   hh = hh:next-sibling.
      336               end.
      337               b-help:column = v-frame-width - b-help:width-chars.
      338               jj = 0.
      339               repeat ii = 4 to 1 by -1 :
      340                   if valid-handle (v-h[ii] ) then
      341                   do:
      342                       jj  = jj + 1 .
      343                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      344                       v-h[ii]:row    = v-help-old-y .
      345                   end.
      346               end.
      347           end.
      348       end.
      349   end procedure.
      350   MAIN-BLOCK:
      351   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      352      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      353   get-key-value section "import-rash":U key "import-rash-source-dir":U value v-source-dir .
      354   get-key-value section "import-rash":U key "import-rash-archive-dir":U value v-archive-dir .
      355   if v-source-dir = ? then do:
      356     assign
      357       v-source-dir = "":U
      358     .
      359   end.
      360   if v-archive-dir = ? then do:
      361     assign
      362       v-archive-dir = "":U
      363     .
      364   end.
      365   assign
      366     v-old-source-dir = v-source-dir
      367     v-old-archive-dir = v-archive-dir
      368   .
      369     RUN enable_UI.
      370     WAIT-FOR GO OF FRAME Dialog-Frame.
      371   END.
      372   RUN disable_UI.
      373   PROCEDURE check-dir :
      374   define input-output parameter p-dir-name as character no-undo .
      375   do
      376   on error undo, return error
      377   :
      378     define variable v-log as logical no-undo .
      379     assign
      380       file-info:file-name = p-dir-name
      381     .
      382     if file-info:file-type <> ?
      383       and index( file-info:file-type, "D":U ) <> 0
      384     then do:
      385       output stream test2 to "test2.tst":U .
      386       put stream test2 unformatted "test2":U skip.
      387       output stream test2 close.
      388       os-copy "test2.tst":U value( p-dir-name ) .
      389       if os-error <> 0 then do:
      390         return error string( "Каталог" + chr(32) + p-dir-name + chr(32)
      391                              + "недоступен для чтения и(или) записи!"
      392                              + chr(10) + "Сохранение параметров невозможно."
      393                            ).
      394       end.
      395       else do:
      396         os-delete value( "test2.tst":U ) .
      397         os-delete value( p-dir-name + chr(92) + "test2.tst":U ) .
      398       end.
      399     end.
      400     else do:
      401       message
      402         "Каталог" p-dir-name "не существует!" skip
      403         "Cоздать его?"
      404         view-as alert-box information buttons yes-no update v-log.
      405       if v-log = false then do:
      406         return error substitute( "Отказ от создания каталога!" ).
      407       end.
      408       else do:
      409         run gbl/dir-cre.p ( input p-dir-name ) no-error .
      410         if error-status:error then do:
      411           return error substitute( "Ошибка при создании каталога &1&2&3", p-dir-name, chr(10), return-value ).
      412         end.
      413       end.
      414     end.
      415     assign
      416       file-info:file-name = p-dir-name
      417     .
      418     if file-info:file-type <> ? then do:
      419       assign
      420         p-dir-name = file-info:full-pathname
      421       .
      422     end.
      423   end.
      424   END PROCEDURE.
      425   PROCEDURE disable_UI :
      426     HIDE FRAME Dialog-Frame.
      427   END PROCEDURE.
      428   PROCEDURE enable_UI :
      429     DISPLAY v-source-dir v-archive-dir
      430         WITH FRAME Dialog-Frame.
      431     ENABLE b-save B-quit B-Help b-sel-source-dir v-source-dir b-sel-archive-dir
      432            v-archive-dir
      433         WITH FRAME Dialog-Frame.
      434     VIEW FRAME Dialog-Frame.
      435   END PROCEDURE.
