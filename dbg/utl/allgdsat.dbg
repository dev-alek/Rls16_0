        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $".
        4   define variable vss-author      as character no-undo initial "$Author: expertek $".
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $".
        6   define variable vss-workfile    as character no-undo initial "$Workfile: allgdsat.p $".
        7   define variable vss-archive     as character no-undo initial "$Archive: utl/allgdsat.p $".
        8   define variable vss-description as character no-undo initial "Инициализация атрибутов товара на объекте".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure cur-time :
       71      define output parameter p-today as date      no-undo .
       72      define output parameter p-time  as integer   no-undo .
       73     do
       74     on error undo, return error
       75     :
       76       define variable v-date1 as date      no-undo .
       77       define variable v-date2 as date      no-undo .
       78       define variable v-time  as integer   no-undo .
       79       assign
       80         v-date1 = today
       81         v-time  = time
       82         v-date2 = today
       83       .
       84       if v-date1 <> v-date2
       85       then do:
       86         assign
       87           v-date1 = today
       88           v-time  = v-time
       89         .
       90       end.
       91       assign
       92         p-today = v-date1
       93         p-time  = v-time
       94       .
       95     end.
       96   end.
       97   function cur-time-date returns character
       98   :
       99     return string(today, '99/99/9999':U) .
      100   end.
      101   function cur-time-mjd returns decimal
      102   :
      103     define variable v-date as date      no-undo .
      104     define variable v-time as integer   no-undo .
      105     run cur-time in this-procedure
      106       (output v-date
      107       ,output v-time
      108       ) .
      109     return integer(v-date) - 2400002 + (v-time / 86400) .
      110   end.
      111   function cur-time-get-ending-index returns integer
      112   (input p-number as integer
      113   )
      114   :
      115     if p-number < 0
      116     or p-number = ?
      117     then do:
      118       return 1 .
      119     end.
      120     define variable v-rest as integer   no-undo .
      121     assign
      122       p-number = p-number modulo 100
      123     .
      124     if p-number < 20
      125     then do:
      126       assign
      127         v-rest = p-number
      128       .
      129     end.
      130     else do:
      131       assign
      132         v-rest = p-number modulo 10
      133       .
      134     end.
      135     case v-rest :
      136       when 1
      137       then do:
      138         return 2 .
      139       end.
      140       when 2 or
      141       when 3 or
      142       when 4
      143       then do:
      144         return 3 .
      145       end.
      146       otherwise do:
      147         return 1 .
      148       end.
      149     end case .
      150   end.
      151   procedure cur-time-mjd-to-date :
      152      define input  parameter i-mjd-diff as decimal no-undo.
      153      define output parameter o-Date     as date    no-undo.
      154      define output parameter o-Time     as integer no-undo.
      155      define variable v-day-number as integer   no-undo .
      156      if    i-mjd-diff < 0
      157         or i-mjd-diff = ?
      158      then do:
      159         return "?" .
      160      end.
      161      assign
      162         v-day-number = truncate(i-mjd-diff,0).
      163         o-Date = date(v-day-number + 2400002).
      164         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      165     .
      166   end.
      167   function cur-time-mjd-to-string returns character
      168   (input p-mjd-diff as decimal
      169   )
      170   :
      171     define variable v-day-number as integer   no-undo .
      172     define variable v-seconds    as integer   no-undo .
      173     define variable v-hour       as integer   no-undo .
      174     define variable v-min        as integer   no-undo .
      175     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      176     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      177     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      178     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      179     if p-mjd-diff < 0
      180     or p-mjd-diff = ?
      181     then do:
      182       return "?" .
      183     end.
      184     assign
      185       v-day-number = integer(truncate(p-mjd-diff,0))
      186       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188     if v-seconds > 86400
      189     then do:
      190       assign
      191         v-seconds = 86400 - 1
      192       .
      193     end.
      194     if v-seconds < 0
      195     then do:
      196       assign
      197         v-seconds = 0
      198       .
      199     end.
      200     assign
      201       v-hour = truncate(v-seconds / 3600, 0)
      202     .
      203     assign
      204       v-seconds = v-seconds modulo 3600
      205     .
      206     assign
      207       v-min = truncate(v-seconds / 60, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 60
      211     .
      212     return
      213         (if v-day-number <> 0
      214           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0
      218           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      222           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      223           else ""
      224         )
      225       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      226       .
      227   end.
      228   function cur-time-string returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-string-sec returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      247   end.
      248   function cur-time-custom  returns character
      249   (input p-prefix as character
      250   ,input p-date-format as character
      251   ,input p-delimiter as character
      252   ,input p-time-format as character
      253   ,input p-suffix as character
      254   )
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return
      263       p-prefix
      264       + string(v-date, p-date-format)
      265       + p-delimiter
      266       + string(v-time, p-time-format)
      267       + p-suffix
      268       .
      269   end.
      270   function cur-time-print  returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-datetime returns datetime
      281   :
      282     define variable v-char as character no-undo .
      283     define variable v-datetime as datetime no-undo .
      284     v-char = cur-time-string().
      285     v-datetime = datetime(v-char).
      286     return  v-datetime.
      287   end.
      288   function cur-time-string-msec returns character
      289   :
      290     define variable v-date as datetime  no-undo .
      291     v-date = now.
      292     return string(v-date) .
      293   end.
      294   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   define variable v-waitfram-action01         as character   no-undo .
      296   define variable v-waitfram-action02         as character   no-undo .
      297   define variable v-waitfram-action03         as character   no-undo .
      298   define variable mWaitFramTextBeg            as character   no-undo.
      299   define variable mWaitFramTextEnd            as character   no-undo.
      300   define variable mWaitFramView               as logical     no-undo.
      301   define variable mWaitProcEvent              as logical     no-undo init yes.
      302   define variable mWaitFramInterval           as integer     no-undo init 1 .
      303   define variable mWaitFramStop               as logical     no-undo.
      304   define variable mWaitFramStopUser           as logical     no-undo.
      305   define variable mWaitFramStopTimeOut        as logical     no-undo.
      306   define variable mWaitFramStartProc          as datetime-tz no-undo.
      307   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      308   define button B-WaitFramStop auto-end-key
      309        label "Стоп"
      310        size 10 by 1 tooltip "Остоновить процесс".
      311   define button B-viewProcInfo
      312        label "Информация"
      313        size 15 by 1 tooltip "Информация о процесс".
      314   define frame waitfram
      315     v-waitfram-action01 format "x(72)" no-label skip
      316     v-waitfram-action02 format "x(72)" no-label skip
      317     v-waitfram-action03 format "x(72)" no-label skip
      318     B-viewProcInfo
      319     B-WaitFramStop at row 4 col 30
      320     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      321     .
      322   define new global shared variable mBatchMode as logical no-undo init ?.
      323   define variable mFramBachModHandle as handle no-undo.
      324   mFramBachModHandle = frame waitfram:handle.
      325   define variable mFameOldVis as logical no-undo.
      326   define variable mVisCUrentVin as logical no-undo.
      327   if session:batch-mode
      328   then
      329      mBatchMode = yes.
      330   if mBatchMode = ? then do:
      331     mVisCUrentVin = current-window:visible.
      332     mFameOldVis = mFramBachModHandle:visible.
      333     mFramBachModHandle:visible  = yes.
      334     mBatchMode = mFramBachModHandle:visible ne yes.
      335     mFramBachModHandle:visible = mFameOldVis.
      336     current-window:visible = mVisCUrentVin.
      337   end.
      338    if  log-manager:logfile-name ne ?
      339     then DO:
      340         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      341         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      342         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      343     end.
      344   on choose of B-WaitFramStop in frame waitfram
      345   do:
      346     mWaitFramStop = yes.
      347     mWaitFramStopUser = yes.
      348   end.
      349   function waitfram-check-timeout returns logical():
      350      define variable vtime as int64 no-undo.
      351      if mWaitFramStopTimeOut
      352      then
      353         return yes.
      354      vtime = ( now - mWaitFramStartProc ) / 1000 .
      355      if     mWaitFramTimeOut ne ?
      356         and mWaitFramTimeOut ne 0
      357         and mWaitFramTimeOut lt vtime
      358      then do:
      359         mWaitFramStopTimeOut = yes.
      360      end.
      361      return mWaitFramStopTimeOut.
      362   end.
      363   procedure waitfram-hide :
      364     if not session:batch-mode
      365     then do
      366     on error undo, return error return-value
      367     :
      368       pause 0 before-hide .
      369       if not mBatchMode then
      370         hide frame waitfram .
      371     if     not mWaitFramView
      372        and mWaitProcEvent
      373     then
      374       process events .
      375     end.
      376   end procedure.
      377   procedure waitfram-show :
      378     define input  parameter p-message as character no-undo .
      379     define variable v-left-margin as integer   no-undo .
      380     if not session:batch-mode
      381     then do
      382     on error undo, return error return-value
      383     :
      384       if length(p-message) <= 70 then do:
      385         assign
      386           v-left-margin = integer((70 - length(p-message)) / 2)
      387         .
      388         assign
      389           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      390         .
      391         assign
      392           v-waitfram-action01 = " "
      393           v-waitfram-action02 = " "
      394                                    + fill(" ", v-left-margin)
      395                                    + p-message
      396           v-waitfram-action03 = " "
      397         .
      398       end.
      399       else do:
      400         define variable vRindex1 as integer no-undo.
      401         define variable vRindex2 as integer no-undo.
      402         vRindex1 = r-index(p-message," ",70).
      403         if vRindex1 = 0
      404         then
      405            vRindex1 = 70.
      406         if length(p-message)  <= vRindex1 + 70 then do:
      407           assign
      408             v-waitfram-action01 = " "
      409             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      410             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      411           .
      412         end.
      413         else do:
      414           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      415           if vRindex2 <= vRindex1
      416           then
      417              vRindex2 = vRindex1 + 70.
      418           assign
      419             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      420             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      421             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      422           .
      423         end.
      424       end.
      425       B-viewProcInfo:visible   in frame waitfram = no.
      426       B-viewProcInfo:sensitive in frame waitfram = no.
      427       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      428       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      429       if  (   mWaitFramView
      430          or  mWaitProcEvent)
      431          and not mBatchMode
      432       then
      433          display
      434             v-waitfram-action01 skip
      435             v-waitfram-action02 skip
      436             v-waitfram-action03 skip
      437          with frame waitfram .
      438       if     mWaitFramView
      439          then do:
      440             if     mWaitFramInterval ne ?
      441                and not mBatchMode
      442             then
      443                wait-for go of frame waitfram pause mWaitFramInterval.
      444          end.
      445          else
      446             if     mWaitProcEvent
      447                and not mBatchMode
      448             then
      449                process events .
      450     end.
      451   end procedure.
      452      procedure waitfram-show-this:
      453         define input  parameter iInterval as int64 no-undo.
      454         define variable vtime as int64 no-undo.
      455         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      456         mWaitFramInterval = iInterval.
      457         run waitfram-show (substitute("&1&2 &3&4" ,
      458                                       mWaitFramTextBeg ,
      459                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      460                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      461                                       mWaitFramTextEnd
      462                                      )
      463                           ).
      464      end.
      465      procedure WaitFramRunPause:
      466         define input  parameter iInterval as dec no-undo.
      467         define variable vStart  as datetime-tz no-undo.
      468         define variable vend    as datetime-tz no-undo.
      469         define variable vint as int64 no-undo.
      470         define variable vOk as logical no-undo.
      471         vStart = now.
      472         vend   = vStart.
      473         publish "WaitFramPause" (iInterval,output vOk).
      474         vend   =  now.
      475         vint = vend - vStart.
      476         vint = iInterval - vint / 1000.
      477         if     not mWaitFramStop
      478            and (   vint > 0
      479                 or (    not vOk
      480                     and iInterval eq ?
      481                     )
      482                 )
      483         then
      484            run waitfram-show-this (iInterval).
      485         vend   =  now.
      486         vint = vend - vStart.
      487         vint = iInterval - vint / 1000.
      488         if     not mWaitFramStop
      489            and vint > 0
      490         then do:
      491            run gbl/pause.p (vint * 1000).
      492         end.
      493         if iInterval ne ?
      494         then
      495            publish "WaitFramStop".
      496         waitfram-check-timeout().
      497      end.
      498      procedure WaitFramWaitFor:
      499         define input  parameter iInterval as dec no-undo.
      500         assign
      501            mWaitFramStartProc   = now
      502            mWaitFramStopUser    = no
      503            mWaitFramStopTimeOut = no
      504         .
      505         block-wait:
      506         do while not mWaitFramStop:
      507            run WaitFramRunPause (iInterval).
      508            if  waitfram-check-timeout()
      509            then do:
      510               leave block-wait.
      511            end.
      512         end.
      513         run waitfram-hide.
      514      end.
      515   procedure waitfram-join :
      516     define input  parameter p-line-1  as character no-undo .
      517     define input  parameter p-line-2  as character no-undo .
      518     define input  parameter p-line-3  as character no-undo .
      519     define output parameter p-message as character no-undo .
      520     do
      521     on error undo, return error return-value
      522     :
      523       assign
      524         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      525                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      526                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      527       .
      528     end.
      529   end procedure.
      530   function waitfram-join-function returns character
      531     (input p-line-1 as character
      532     ,input p-line-2 as character
      533     ,input p-line-3 as character
      534     ).
      535     define variable v-message as character no-undo .
      536     run waitfram-join in this-procedure
      537       (input  p-line-1
      538       ,input  p-line-2
      539       ,input  p-line-3
      540       ,output v-message
      541       ) .
      542     return v-message .
      543   end function .
      544   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545     define variable v-cntxt-db-num        as integer   no-undo .
      546     define variable v-cntxt-userid        as character no-undo .
      547     define variable v-cntxt-level         as character no-undo .
      548     define variable v-cntxt-host-code-obj as integer   no-undo .
      549     define variable v-cntxt-obj-type      as character no-undo .
      550     define variable v-cntxt-obj-code      as integer   no-undo .
      551     define variable v-cntxt-db-num-obj    as integer   no-undo .
      552     define variable v-cntxt-is-admin      as logical   no-undo .
      553   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   define temp-table userobjs_temp-user-obj no-undo
      555     field obj-type as character
      556     field obj-code as integer
      557     index xpk is primary unique obj-type obj-code
      558     .
      559   procedure userobjs_clear :
      560     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      561     do
      562     on error undo, return error return-value
      563     :
      564       for each buf_userobjs_temp-user-obj
      565       on error undo, return error return-value
      566       :
      567         delete buf_userobjs_temp-user-obj .
      568       end.
      569     end.
      570   end .
      571   procedure userobjs_object-count :
      572     define output parameter p-total-count as integer   no-undo .
      573     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      574     do
      575     on error undo, return error return-value
      576     :
      577       assign
      578         p-total-count = 0
      579       .
      580       for each buf_userobjs_temp-user-obj
      581       on error undo, return error return-value
      582       :
      583         assign
      584           p-total-count = p-total-count + 1
      585         .
      586       end.
      587     end.
      588   end.
      589   procedure userobjs_append :
      590      define input  parameter p-obj-type as character no-undo .
      591      define input  parameter p-obj-code as integer   no-undo .
      592     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      593     do
      594     on error undo, return error return-value
      595     :
      596       find first buf_userobjs_temp-user-obj
      597         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      598           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      599         no-error .
      600       if not available buf_userobjs_temp-user-obj
      601       then do:
      602         create buf_userobjs_temp-user-obj .
      603         assign
      604           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      605           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      606         .
      607       end.
      608     end.
      609   end.
      610   procedure userobjs_object-exist :
      611     define output parameter p-object-exist as logical   no-undo .
      612     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      613     do
      614     on error undo, return error return-value
      615     :
      616       find first buf_userobjs_temp-user-obj
      617         no-error .
      618       if not available buf_userobjs_temp-user-obj
      619       then do:
      620         assign
      621           p-object-exist = false
      622         .
      623       end.
      624       else do:
      625         assign
      626           p-object-exist = true
      627         .
      628       end.
      629     end.
      630   end.
      631   procedure userobjs_transfer :
      632     define input  parameter p-callback-handle as handle no-undo .
      633     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      634     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      635     do
      636     on error undo, return error return-value
      637     :
      638       if valid-handle(p-callback-handle) <> true
      639       then do:
      640         message
      641           vss-workfile vss-revision vss-description skip
      642           "Ошибка задания входных параметров" skip
      643           "Неизвестный указатель на процедуру" skip
      644           view-as alert-box error .
      645         undo, return error return-value .
      646       end.
      647       if p-callback-handle :get-signature("userobjs_append") = ""
      648       then do:
      649         message
      650           vss-workfile vss-revision vss-description skip
      651           "Ошибка задания входных параметров" skip
      652           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      653                     ,p-callback-handle :file-name
      654                     ) skip
      655           view-as alert-box error .
      656         undo, return error return-value .
      657       end.
      658       for each buf_userobjs_temp-user-obj
      659       on error undo, return error return-value
      660       :
      661         run userobjs_append in p-callback-handle
      662           (input  buf_userobjs_temp-user-obj.obj-type
      663           ,input  buf_userobjs_temp-user-obj.obj-code
      664           ) .
      665       end.
      666     end.
      667   end procedure.
      668   procedure userobjs_select-one :
      669      define input  parameter parparentproc     as widget-handle no-undo .
      670      define input  parameter p-db-num          as integer   no-undo .
      671      define input  parameter p-user-id         as character no-undo .
      672      define input  parameter p-host-code-obj   as integer   no-undo .
      673      define input  parameter p-obj-type        as character no-undo .
      674      define input  parameter p-obj-code        as integer   no-undo .
      675      define output parameter p-user-select     as logical   no-undo .
      676      define output parameter p-select-obj-type as character no-undo .
      677      define output parameter p-select-obj-code as character no-undo .
      678     do
      679     on error undo, return error return-value
      680     :
      681       run gbl/userobjs.w
      682         (input  parparentproc
      683         ,input  this-procedure :handle
      684         ,input  p-db-num
      685         ,input  p-user-id
      686         ,input  p-host-code-obj
      687         ,input  p-obj-type
      688         ,input  p-obj-code
      689         ,INPUT  "b-sel"
      690         ,output p-user-select
      691         ,output p-select-obj-type
      692         ,output p-select-obj-code
      693         ) .
      694     end.
      695   end.
      696   procedure userobjs_select-many :
      697     define input  parameter parparentproc   as widget-handle no-undo .
      698     define input  parameter p-db-num        as integer   no-undo .
      699     define input  parameter p-user-id       as character no-undo .
      700     define input  parameter p-host-code-obj as integer   no-undo .
      701     define input  parameter p-obj-type      as character no-undo .
      702     define input  parameter p-obj-code      as integer   no-undo .
      703     define output parameter p-user-select   as logical   no-undo .
      704     define variable v-select-obj-type as character no-undo .
      705     define variable v-select-obj-code as integer   no-undo .
      706     do
      707     on error undo, return error return-value
      708     :
      709       run gbl/userobjs.w
      710         (input  parparentproc
      711         ,input  this-procedure :handle
      712         ,input  p-db-num
      713         ,input  p-user-id
      714         ,input  p-host-code-obj
      715         ,input  p-obj-type
      716         ,input  p-obj-code
      717         ,INPUT  "b-sel,b-mark"
      718         ,output p-user-select
      719         ,output v-select-obj-type
      720         ,output v-select-obj-code
      721         ) .
      722     end.
      723   end.
      724   procedure thobjs :
      725      define input        parameter parparentproc     as widget-handle no-undo .
      726      define input        parameter i-bttns           as character     no-undo .
      727      define input        parameter i-list-mode       as character     no-undo.
      728      define input        parameter i-obj-type        as character     no-undo.
      729      define input        parameter i-db-num          as integer       no-undo.
      730      define input        parameter i-host-code       as integer       no-undo.
      731      define input-output parameter p-rid-list        as character     no-undo .
      732   run ref/thobjs.p
      733           ( input parparentproc
      734            ,input  this-procedure :handle
      735           , input i-bttns
      736           , input i-list-mode
      737           , input i-obj-type
      738           , input i-db-num
      739           , input i-host-code
      740           , input-output p-rid-list ) no-error .
      741   end.
      742   do
      743   on error undo, return error return-value
      744   :
      745     define variable v-total-ind as integer   no-undo .
      746     define variable v-num as integer no-undo .
      747   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      748     run mainmenu_getcntxt in parparentproc
      749       (output v-cntxt-db-num
      750       ,output v-cntxt-userid
      751       ,output v-cntxt-level
      752       ,output v-cntxt-host-code-obj
      753       ,output v-cntxt-obj-type
      754       ,output v-cntxt-obj-code
      755       ,output v-cntxt-db-num-obj
      756       ,output v-cntxt-is-admin
      757       ) .
      758     run gbl/d-askw.w
      759       (input "Вопрос"
      760       ,input vss-description + chr(10)
      761           + "Результат работы программы записывается в файлы:" + chr(10) + chr(10)
      762           + "allgdsoat.txt - значения атрибутов," + chr(10)
      763           + "allgdsoat.obj - список обработанный объектов."
      764       ,input "|^"
      765       ,input "Все^confirm|Выбрать|Отмена"
      766       ,input "Все объекты|"
      767           + "Выбрать объекты|"
      768           + "Не запускать утилиту"
      769       ,input 1
      770       ,input 3
      771       ,output v-num
      772       ).
      773     case v-num :
      774       when 1
      775       then do:
      776         for each ub.db no-lock
      777         ,each ub.clients no-lock
      778           where ub.clients.db-num = ub.db.db-num
      779         on error undo, return error return-value
      780         :
      781           run initialize-gds-obj in this-procedure
      782             (input clients.obj-type
      783             ,input clients.obj-code
      784             ).
      785         end.
      786       end.
      787       when 2
      788       then do:
      789         define variable v-user-select as logical   no-undo .
      790   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   run userobjs_select-many in this-procedure
      792     (input  parparentproc
      793     ,input  v-cntxt-db-num
      794     ,input  v-cntxt-userid
      795     ,input  v-cntxt-host-code-obj
      796     ,input  v-cntxt-obj-type
      797     ,input  v-cntxt-obj-code
      798     ,output v-user-select
      799     )  .
      800         if v-user-select <> true
      801         then do:
      802           message
      803             "Объект не выбран"
      804             view-as alert-box information .
      805           return .
      806         end.
      807         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      808         for each buf_userobjs_temp-user-obj
      809         on error undo, return error return-value
      810         :
      811           run initialize-gds-obj in this-procedure
      812             (input buf_userobjs_temp-user-obj.obj-type
      813             ,input buf_userobjs_temp-user-obj.obj-code
      814             ).
      815         end.
      816       end.
      817     end.
      818     if v-total-ind <> 0
      819     then do:
      820       message
      821         "Инициализация атрибутов закончена" skip
      822         "Обработано объектов" v-total-ind skip
      823         view-as alert-box information .
      824     end.
      825   end.
      826   procedure initialize-gds-obj :
      827     define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
      828     define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
      829     define variable v-today as date      no-undo.
      830     define variable v-time  as integer   no-undo.
      831     output to allgdsoat.obj append .
      832     run cur-time in this-procedure ( output v-today
      833                                    , output v-time
      834                                    ).
      835     export p-obj-type p-obj-code string(v-today) string(v-time, "HH:MM") .
      836     output close .
      837     assign
      838       v-total-ind = v-total-ind + 1
      839     .
      840     run waitfram-show in this-procedure
      841       (input substitute("Инициализация атрибута <Переоценка включена> на объекте &1 &2"
      842                        ,p-obj-type
      843                        ,p-obj-code
      844                        )
      845       ) .
      846     run initialise-ov-on
      847       (input p-obj-type
      848       ,input p-obj-code
      849       ).
      850     run waitfram-show in this-procedure
      851       (input substitute("Инициализация атрибута <Инвентаризация включена> на объекте &1 &2"
      852                        ,p-obj-type
      853                        ,p-obj-code
      854                        )
      855       ) .
      856     run initialise-inv-on
      857       (input p-obj-type
      858       ,input p-obj-code
      859       ).
      860     run waitfram-hide in this-procedure .
      861   end procedure.
      862   procedure initialise-ov-on :
      863     define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
      864     define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
      865     for each ub.gds-obj exclusive-lock
      866       where ub.gds-obj.obj-type = p-obj-type
      867         and ub.gds-obj.obj-code = p-obj-code
      868         and ub.gds-obj.ov-on    = true
      869     :
      870       assign
      871         ub.gds-obj.ov-on = false
      872       .
      873     end.
      874     for each ub.price-doc exclusive-lock
      875       where price-doc.status_  = 'разрешен':U
      876         and price-doc.obj-type = p-obj-type
      877         and price-doc.obj-code = p-obj-code
      878     :
      879       for each price-list
      880         where price-list.doc-num = price-doc.doc-num
      881       :
      882         output to allgdsoat.txt append .
      883         export
      884           ub.price-list.obj-type
      885           ub.price-list.obj-code
      886           ub.price-list.artic
      887           ub.price-list.prod-type
      888           ub.price-list.prod-code
      889           "ov-on"
      890           .
      891         output close .
      892         define variable l-ov-on as logical no-undo .
      893   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      894   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      895     (input  ub.price-list.obj-type
      896     ,input  ub.price-list.obj-code
      897     ,input  ub.price-list.artic
      898     ,input  ub.price-list.prod-type
      899     ,input  ub.price-list.prod-code
      900     ,input  'ov-on=true':u
      901     ,output l-ov-on
      902     ) no-error .
      903         if error-status :error
      904         then do:
      905           message
      906             vss-workfile vss-revision vss-description skip
      907             "Ошибка задания признака товара на объекте" skip
      908             "obj-type " ub.price-list.obj-type  skip
      909             "obj-code " ub.price-list.obj-code  skip
      910             "artic    " ub.price-list.artic     skip
      911             "prod-type" ub.price-list.prod-type skip
      912             "prod-code" ub.price-list.prod-code skip
      913             error-status :get-message(1) skip
      914             return-value skip
      915             view-as alert-box error .
      916         end.
      917       end.
      918     end.
      919   end procedure.
      920   procedure initialise-inv-on :
      921     define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
      922     define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
      923     for each ub.gds-obj exclusive-lock
      924       where ub.gds-obj.obj-type = p-obj-type
      925         and ub.gds-obj.obj-code = p-obj-code
      926         and ub.gds-obj.inv-on    = true
      927     :
      928       assign
      929         ub.gds-obj.inv-on = false
      930       .
      931     end.
      932     for each ub.trn-doc exclusive-lock
      933       where ub.trn-doc.obj-type     = p-obj-type
      934         and ub.trn-doc.obj-code     = p-obj-code
      935         and ub.trn-doc.internal     = no
      936         and ub.trn-doc.doc-type     = 'инв':U
      937         and ub.trn-doc.ext-doc-type = 'vt':U
      938         and ub.trn-doc.status_      = 'разрешен':U
      939         and ub.trn-doc.flag_        = true
      940         or  ub.trn-doc.obj-type     = p-obj-type
      941         and ub.trn-doc.obj-code     = p-obj-code
      942         and ub.trn-doc.internal     = no
      943         and ub.trn-doc.doc-type     = 'инв':U
      944         and ub.trn-doc.ext-doc-type = 'ap':U
      945         and ub.trn-doc.status_      = 'накл':U
      946         and ub.trn-doc.flag_        = no
      947         or  ub.trn-doc.obj-type     = p-obj-type
      948         and ub.trn-doc.obj-code     = p-obj-code
      949         and ub.trn-doc.internal     = no
      950         and ub.trn-doc.doc-type     = 'инв':U
      951         and ub.trn-doc.ext-doc-type = 'vp':U
      952         and ub.trn-doc.status_      = 'накл':U
      953         and ub.trn-doc.flag_        = no
      954     :
      955       for each ub.doc-line
      956         where doc-line.doc-code = trn-doc.doc-code
      957       :
      958         output to allgdsoat.txt append .
      959         export
      960           ub.doc-line.obj-type
      961           ub.doc-line.obj-code
      962           ub.doc-line.artic
      963           ub.doc-line.prod-type
      964           ub.doc-line.prod-code
      965           "inv-on"
      966           .
      967         output close .
      968         define variable l-inv-on as logical no-undo .
      969   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      971     (input  ub.doc-line.obj-type
      972     ,input  ub.doc-line.obj-code
      973     ,input  ub.doc-line.artic
      974     ,input  ub.doc-line.prod-type
      975     ,input  ub.doc-line.prod-code
      976     ,input  'inv-on=true':u
      977     ,output l-inv-on
      978     ) no-error .
      979         if error-status:error then do:
      980           message
      981             vss-workfile vss-revision vss-description skip
      982             "Ошибка задания признака товара на объекте" skip
      983             "obj-type " ub.doc-line.obj-type  skip
      984             "obj-code " ub.doc-line.obj-code  skip
      985             "artic    " ub.doc-line.artic     skip
      986             "prod-type" ub.doc-line.prod-type skip
      987             "prod-code" ub.doc-line.prod-code skip
      988             error-status :get-message(1) skip
      989             return-value skip
      990             view-as alert-box error .
      991         end.
      992       end.
      993     end.
      994   end procedure.
