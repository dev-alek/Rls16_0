        1   define input  parameter parparentproc as handle    no-undo .
        2   DEFINE BUTTON b-cancel AUTO-END-KEY
        3        LABEL "Отмена"
        4        SIZE 15 BY 1.14
        5        BGCOLOR 8 .
        6   DEFINE BUTTON b-ok AUTO-GO
        7        LABEL "Ввод"
        8        SIZE 15 BY 1.14
        9        BGCOLOR 8 .
       10   DEFINE VARIABLE f-chk-doc AS integer FORMAT ">>>>>>>>>9":U
       11        LABEL "Чеки"
       12        VIEW-AS FILL-IN
       13        SIZE 14 BY 1 NO-UNDO.
       14   DEFINE VARIABLE f-chk-doc-cur AS integer FORMAT ">>>>>>>>>9":U
       15        LABEL "(Текущее значение"
       16        VIEW-AS FILL-IN
       17        SIZE 14 BY 1 NO-UNDO.
       18   DEFINE VARIABLE f-fin-doc AS integer FORMAT ">>>>>>>>>9":U
       19        LABEL "Кассовые ордера"
       20        VIEW-AS FILL-IN
       21        SIZE 14 BY 1 NO-UNDO.
       22   DEFINE VARIABLE f-fin-doc-cur AS integer FORMAT ">>>>>>>>>9":U
       23        LABEL "(Текущее значение"
       24        VIEW-AS FILL-IN
       25        SIZE 14 BY 1 NO-UNDO.
       26   DEFINE VARIABLE f-trn-doc AS integer FORMAT ">>>>>>>>>9":U
       27        LABEL "Складские док-ты/Сверки"
       28        VIEW-AS FILL-IN
       29        SIZE 14 BY 1 NO-UNDO.
       30   DEFINE VARIABLE f-trn-doc-cur AS integer FORMAT ">>>>>>>>>9":U
       31        LABEL "(Текущее значение"
       32        VIEW-AS FILL-IN
       33        SIZE 14 BY 1 NO-UNDO.
       34   DEFINE FRAME Dialog-Frame
       35        b-ok AT ROW 1.24 COL 2
       36        b-cancel AT ROW 1.24 COL 17
       37        f-trn-doc AT ROW 3 COL 27 COLON-ALIGNED WIDGET-ID 2
       38        f-trn-doc-cur AT ROW 3 COL 64 COLON-ALIGNED WIDGET-ID 12
       39        f-chk-doc-cur AT ROW 4.5 COL 64 COLON-ALIGNED WIDGET-ID 16
       40        f-chk-doc AT ROW 4.5 COL 27 COLON-ALIGNED WIDGET-ID 6
       41        f-fin-doc AT ROW 6 COL 27 COLON-ALIGNED WIDGET-ID 8
       42        f-fin-doc-cur AT ROW 6 COL 64 COLON-ALIGNED WIDGET-ID 18
       43        ")" VIEW-AS TEXT
       44             SIZE 2.6 BY .62 AT ROW 6 COL 80 WIDGET-ID 30
       45        ")" VIEW-AS TEXT
       46             SIZE 2.6 BY .62 AT ROW 4.5 COL 80 WIDGET-ID 28
       47        ")" VIEW-AS TEXT
       48             SIZE 2.6 BY .62 AT ROW 3 COL 80 WIDGET-ID 26
       49        SPACE(1) SKIP(1)
       50       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       51            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       52            TITLE "Синхронизация счетчиков документов"
       53            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
       54   ASSIGN
       55          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       56          FRAME Dialog-Frame:HIDDEN           = TRUE.
       57   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       58   DO:
       59     APPLY "END-ERROR":U TO SELF.
       60   END.
       61   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
       62   DO:
       63     assign
       64       f-trn-doc
       65       f-chk-doc
       66       f-fin-doc
       67     .
       68     if f-trn-doc > 0 then current-value(s-trn-doc)  = f-trn-doc .
       69     if f-chk-doc > 0 then current-value(s-chk)      = f-chk-doc .
       70     if f-fin-doc > 0 then current-value(s-fin-doc)  = f-fin-doc .
       71   END.
       72   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       73   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       74   MAIN-BLOCK:
       75   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       76      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       77     assign
       78       f-trn-doc-cur = current-value(s-trn-doc)
       79       f-chk-doc-cur = current-value(s-chk)
       80       f-fin-doc-cur = current-value(s-fin-doc)
       81     .
       82     RUN enable_UI.
       83     WAIT-FOR GO OF FRAME Dialog-Frame.
       84   END.
       85   RUN disable_UI.
       86   PROCEDURE disable_UI :
       87     HIDE FRAME Dialog-Frame.
       88   END PROCEDURE.
       89   PROCEDURE enable_UI :
       90     DISPLAY f-trn-doc f-trn-doc-cur f-chk-doc-cur
       91             f-chk-doc f-fin-doc f-fin-doc-cur
       92         WITH FRAME Dialog-Frame.
       93     ENABLE b-ok b-cancel f-trn-doc
       94            f-chk-doc f-fin-doc
       95         WITH FRAME Dialog-Frame.
       96     VIEW FRAME Dialog-Frame.
       97   END PROCEDURE.
