      413   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      414   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      415   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      416   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   function getattrUtdex returns char
      418   (idb-num   as integer,
      419    idoc-id   as integer,
      420    iattrcode as character,
      421    iExValue  as character  ):
      422      define buffer utd-attr for utd-attr.
      423      find first utd-attr where utd-attr.db-num eq idb-num
      424                            and utd-attr.doc-id eq idoc-id
      425                            and utd-attr.attr-code eq iattrcode
      426      no-lock no-error.
      427      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      428   end.
      429   function getattrUtd returns char
      430   (idb-num   as integer,
      431    idoc-id   as integer,
      432    iattrcode as character ):
      433     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      434   end.
      435   function setattrUtd returns logical
      436   (idb-num   as integer,
      437    idoc-id   as integer,
      438    iattrcode as character,
      439    iattrval  as character ):
      440      define buffer utd-attr for utd-attr.
      441      find first utd-attr where utd-attr.db-num eq idb-num
      442                            and utd-attr.doc-id eq idoc-id
      443                            and utd-attr.attr-code eq iattrcode
      444      no-lock no-error.
      445      if not available utd-attr
      446      then do:
      447         create utd-attr.
      448         assign
      449            utd-attr.db-num    = idb-num
      450            utd-attr.doc-id    = idoc-id
      451            utd-attr.attr-code = iattrcode
      452            utd-attr.attr-value = iattrval
      453         .
      454      end.
      455      else do:
      456         if utd-attr.attr-value ne iattrval
      457         then do:
      458            find current utd-attr exclusive-lock no-error.
      459            if available utd-attr
      460            then
      461               utd-attr.attr-value = iattrval.
      462         end.
      463      end.
      464      release utd-attr.
      465   end.
      466   function GetAttrUtdlinesEx returns char
      467   (idb-num   as integer,
      468    idoc-id   as integer,
      469    ilinenum  as integer,
      470    iattrcode as character,
      471    iExValue  as character  ):
      472      define buffer utd-lines-attr for utd-lines-attr.
      473      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      474                                  and utd-lines-attr.doc-id    eq idoc-id
      475                                  and utd-lines-attr.lineNum   eq ilineNum
      476                                  and utd-lines-attr.attr-code eq iattrcode
      477      no-lock no-error.
      478      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      479   end.
      480   function GetAttrUtdlines returns char
      481   (idb-num   as integer,
      482    idoc-id   as integer,
