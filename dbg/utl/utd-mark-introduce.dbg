      609   procedure xmlchar-test :
      610   define input parameter p-in-string          as character        no-undo.
      611   define output parameter p-out-string-enc    as character        no-undo.
      612   define output parameter p-out-string-dec    as character        no-undo.
      613   do
      614   on error undo, return error
      615   :
      616          run xmlchar-encode in this-procedure
      617       (
      618             input p-in-string
      619           , output p-out-string-enc
      620       ).
      621          run xmlchar-decode in this-procedure
      622       (
      623             input p-out-string-enc
      624           , output p-out-string-dec
      625       ).
      626   end.
      627   end .
      628   procedure xmlchar-encode :
      629   define input parameter p-in-string      as character        no-undo.
      630   define output parameter p-out-string    as character        no-undo.
      631       define variable v-position      as integer      no-undo.
      632       define variable v-current-char  as character    no-undo.
      633   do
      634   on error undo, return error
      635   :
      636       assign
      637           p-out-string = "":U
      638       .
      639       case p-in-string
      640       :
      641           when ?
      642           then do:
      643               assign
      644                   p-out-string = "?":U
      645               .
      646           end.
      647           when "?":U
      648           then do:
      649               assign
      650                   p-out-string = "&#63;":U
      651               .
      652           end.
      653           otherwise do:
      654               do v-position = 1 to length( p-in-string )
      655               :
      656                   assign
      657                       v-current-char = substring( p-in-string, v-position, 1 )
      658                   .
      659                   case v-current-char
      660                   :
      661                       when "&":U
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + "&amp;":U
      665                           .
      666                       end.
      667                       when ">":U
      668                       then do:
      669                           assign
      670                               p-out-string = p-out-string + "&gt;":U
      671                           .
      672                       end.
      673                       when "<":U
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + "&lt;":U
      677                           .
      678                       end.
      679                       when "'":U
      680                       then do:
      681                           assign
      682                               p-out-string = p-out-string + "&apos;":U
      683                           .
      684                       end.
      685                       when '"':U
      686                       then do:
      687                           assign
      688                               p-out-string = p-out-string + "&quot;":U
      689                           .
      690                       end.
      691                       when chr(1)
      692                       then do:
      693                           assign
      694                               p-out-string = p-out-string + "":U
      695                           .
      696                       end.
      697                       when chr(2)
      698                       then do:
      699                           assign
      700                               p-out-string = p-out-string + "":U
      701                           .
      702                       end.
      703                       when chr(3)
      704                       then do:
      705                           assign
      706                               p-out-string = p-out-string + "":U
      707                           .
      708                       end.
      709                       when chr(4)
      710                       then do:
      711                           assign
      712                               p-out-string = p-out-string + "":U
      713                           .
      714                       end.
      715                       when chr(5)
      716                       then do:
      717                           assign
      718                               p-out-string = p-out-string + "":U
      719                           .
      720                       end.
      721                       when chr(6)
      722                       then do:
      723                           assign
      724                               p-out-string = p-out-string + "":U
      725                           .
      726                       end.
      727                       when chr(7)
      728                       then do:
      729                           assign
      730                               p-out-string = p-out-string + "":U
      731                           .
      732                       end.
      733                       when chr(8)
      734                       then do:
      735                           assign
      736                               p-out-string = p-out-string + "":U
      737                           .
      738                       end.
      739                       when chr(9)
      740                       then do:
      741                           assign
      742                               p-out-string = p-out-string + "":U
      743                           .
      744                       end.
      745                       when chr(29)
      746                       then do:
      747                           assign
      748                               p-out-string = p-out-string + "":U
      749                           .
      750                       end.
      751                       when chr(10)
      752                       then do:
      753                           assign
      754                               p-out-string = p-out-string + "&#10;":U
      755                           .
      756                       end.
      757                       when chr(13)
      758                       then do:
      759                           assign
      760                               p-out-string = p-out-string + "&#13;":U
      761                           .
      762                       end.
      763                       otherwise do:
      764                           assign
      765                               p-out-string = p-out-string + v-current-char
      766                           .
      767                       end.
      768                   end case.
      769               end.
      770           end.
      771       end case.
      772   end.
      773   end .
      774   procedure xmlchar-encode-1c :
