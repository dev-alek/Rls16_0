      566                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      567                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      568                                          and utd-marking-lines-attr.mark      eq imark
      569                                          and utd-marking-lines-attr.attr-code eq iattrcode
      570      no-lock no-error.
