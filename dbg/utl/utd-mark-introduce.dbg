      487   function setattrUtdlines returns logical
      488   (idb-num   as integer,
      489    idoc-id   as integer,
      490    ilinenum  as integer,
      491    iattrcode as character,
      492    iattrval  as character ):
      493      define buffer utd-lines-attr for utd-lines-attr.
      494      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      495                                  and utd-lines-attr.doc-id    eq idoc-id
      496                                  and utd-lines-attr.lineNum   eq ilineNum
      497                                  and utd-lines-attr.attr-code eq iattrcode
      498      no-lock no-error.
      499      if not available utd-lines-attr
      500      then do:
      501         if iattrval ne ?
      502            and iattrval ne ""
      503         then do:
      504            create utd-lines-attr.
      505            assign
      506               utd-lines-attr.db-num    = idb-num
      507               utd-lines-attr.doc-id    = idoc-id
      508               utd-lines-attr.lineNum   = ilineNum
      509               utd-lines-attr.attr-code = iattrcode
      510               utd-lines-attr.attr-value = iattrval
      511            .
      512         end.
      513      end.
      514      else do:
      515         if utd-lines-attr.attr-value ne iattrval
      516         then do:
      517            find current utd-lines-attr exclusive-lock no-error.
      518            if available utd-lines-attr
      519            then do:
      520               if    iattrval eq ?
      521                  or iattrval eq ""
      522               then do:
      523                  delete utd-lines-attr.
      524               end.
      525               else do:
      526                  utd-lines-attr.attr-value = iattrval.
      527               end.
      528            end.
      529         end.
      530      end.
      531      release utd-lines-attr.
      532   end.
