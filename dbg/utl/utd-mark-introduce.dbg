      824                       end.
      825                       when chr(5)
      826                       then do:
      827                           assign
      828                               p-out-string = p-out-string + " ":U
      829                           .
      830                       end.
      831                       when chr(6)
      832                       then do:
      833                           assign
      834                               p-out-string = p-out-string + " ":U
      835                           .
      836                       end.
      837                       when chr(7)
      838                       then do:
      839                           assign
      840                               p-out-string = p-out-string + " ":U
      841                           .
      842                       end.
      843                       when chr(8)
      844                       then do:
      845                           assign
