      883   end .
      884   procedure xmlchar-decode :
      885   define input parameter p-in-string      as character        no-undo.
      886   define output parameter p-out-string    as character        no-undo.
      887       define variable v-position      as integer      no-undo.
      888       define variable v-last-position as integer      no-undo.
      889       define variable v-temp-integer  as integer      no-undo.
      890       define variable v-current-char  as character    no-undo.
      891       define variable v-next-char     as character    no-undo.
      892       define variable v-success       as logical      no-undo.
      893   do
      894   on error undo, return error
      895   :
      896       assign
      897           p-out-string = "":U
      898           v-position   = 0
      899       .
      900       replace-cycle:
      901       do while yes
      902       on error undo, return error
      903       :
      904           assign
      905               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      906           .
      907           if v-last-position <= v-position
      908           then do:
      909               if v-position = 0
      910               then do:
      911                   assign
      912                       p-out-string = p-in-string
      913                   .
      914               end.
      915               else do:
      916                   assign
      917                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      918                   .
      919               end.
      920               leave replace-cycle.
      921           end.
      922           else do:
      923               assign
      924                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      925                   v-position      = v-last-position
      926                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      927               .
      928               if v-current-char = "#":U
      929               then do:
      930                   assign
      931                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      932                   .
      933                   if v-last-position > 0
      934                   then do:
      935                       run xmlchar-read-integer in this-procedure
      936                        (
      937                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      938                           , output v-temp-integer
      939                           , output v-success
      940                       ).
      941                       if v-success = yes
      942                       and v-temp-integer >= 1
      943                       and v-temp-integer <= 255
      944                       then do:
      945                           assign
      946                               p-out-string = p-out-string + chr( v-temp-integer )
      947                               v-position   = v-last-position + 1
      948                           .
      949                       end.
      950                       else do:
      951                           assign
      952                               p-out-string = p-out-string + "&":U
      953                               v-position   = v-position   + 1
      954                           .
      955                       end.
      956                   end.
      957                   else do:
      958                       assign
      959                           p-out-string = p-out-string + "&":U
      960                           v-position   = v-position   + 1
      961                       .
      962                   end.
      963               end.
      964               else do:
      965                   case substring( p-in-string, v-position + 1, 3 )
      966                   :
      967                       when "lt;":U
      968                       then do:
      969                           assign
      970                               p-out-string = p-out-string + "<":U
      971                               v-position   = v-position   + 3
      972                           .
      973                       end.
      974                       when "gt;":U
      975                       then do:
      976                           assign
      977                               p-out-string = p-out-string + ">":U
      978                               v-position   = v-position   + 3
      979                           .
      980                       end.
      981                       otherwise do:
      982                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      983                           then do:
      984                               assign
      985                                   p-out-string = p-out-string + "&":U
      986                                   v-position   = v-position   + 4
      987                               .
      988                           end.
      989                           else do:
      990                               case substring( p-in-string, v-position + 1, 5 )
      991                               :
      992                                   when "quot;":U
      993                                   then do:
      994                                       assign
      995                                           p-out-string = p-out-string + '"':U
      996                                           v-position   = v-position   + 5
      997                                       .
      998                                   end.
      999                                   when "apos;":U
     1000                                   then do:
     1001                                       assign
     1002                                           p-out-string = p-out-string + "'":U
     1003                                           v-position   = v-position   + 5
     1004                                       .
     1005                                   end.
     1006                                   otherwise do:
     1007                                       assign
     1008                                           p-out-string = p-out-string + "&":U
     1009                                       .
     1010                                   end.
     1011                               end case.
     1012                           end.
     1013                       end.
     1014                   end case.
     1015               end.
     1016           end.
     1017       end.
     1018   end.
     1019   end .
     1020   procedure xmlchar-read-integer :
     1021   define input parameter p-input-string      as character        no-undo.
     1022   define output parameter p-output-integer   as integer          no-undo.
     1023   define output parameter p-success       as logical          no-undo.
     1024   do
     1025   on error undo, return error
     1026   :
     1027       assign
     1028           p-output-integer = integer( p-input-string )
     1029       no-error.
     1030       if error-status :error
     1031       then do:
     1032           assign
     1033               p-success           = no
     1034               p-output-integer    = 0
     1035           .
     1036       end.
     1037       else do:
     1038           assign
     1039               p-success           = yes
     1040           .
     1041       end.
     1042   end.
     1043   end.
     1044   define variable mMRCCode  as logical    no-undo.
     1045   define variable mTypeMark as character  no-undo.
     1046   function IS-NeedMark returns logical
     1047   ( input ib-code as integer  ,
     1048     input ib-str as character ):
     1049      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1050      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1051                                    and buf_prod-bc-attr.b-str  eq ib-str
     1052                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1053        no-lock no-error.
     1054      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1055   end.
     1056   function repTegforDm return char
     1057   (iDM as char ):
     1058       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1059       define variable vteg as character no-undo.
     1060       define variable oDM as character no-undo.
     1061       define variable vi as integer no-undo.
     1062       oDM = iDm.
     1063       do vi = 1 to num-entries(vTeglist):
     1064          vTeg = entry(vi,vTeglist).
     1065          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1066       end.
     1067       return oDM.
     1068   end.
     1069   function repSpecSimbforDm return char
     1070   (iDM as char ):
     1071       define variable oDM as character no-undo.
     1072     run
     1073       xmlchar-decode(iDM, output oDM).
     1074     return repTegforDm (oDM).
     1075   end.
     1076   function CheckGtin return logical
     1077   (iGtin as char):
     1078      define variable bar_code as character no-undo.
     1079      define variable vGtin as logical no-undo init "yes".
     1080      if length(iGtin) eq 14
     1081      then do:
     1082         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1083         run str/chk-sum.p
     1084          (input-output bar_code ) no-error .
     1085         if iGtin ne  bar_code
     1086         then
     1087            vGtin = no.
     1088      end.
     1089      else
     1090         vGtin = no.
     1091      return vgtin.
     1092   end.
     1093   function repSpecSimbforXlm return char
     1094   (iDM as char ):
     1095       iDM = replace(iDM,chr(29),"").
     1096       return iDM.
     1097   end.
     1098   function getGtinByDM return char
     1099   (IDM as char):
     1100      define variable VTXT as char no-undo.
     1101      define variable vGtin as char no-undo.
     1102      vTXt = IdM.
     1103      vGtin = IDM.
     1104      if    length(vtxt) > 14
     1105      then do:
     1106         if   vtxt begins "(01)"
     1107                or vtxt begins "(02)"
     1108         then
     1109            vGtin = substring(vtxt,5,14).
     1110         else if   (vtxt begins "01"
     1111                or vtxt begins "02" )
     1112                and (   (    substring(iDm,17,2) eq "21"
     1113                         and length(vtxt) >= 21)
     1114                     or substring(iDm,17,2) eq "37"
     1115                     or substring(iDm,17,4) eq "(37)" )
     1116         then do:
     1117            vGtin = substring(vtxt,3,14).
     1118            if not checkGtin(vGtin)
     1119            then
     1120               vGtin = substring(vtxt,1,14).
     1121         end.
     1122         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1123             or length(vtxt) eq 14 + 7 + 4
     1124             or length(vtxt) eq 14 + 7
     1125         then
     1126            vGtin = substring(vtxt,1,14).
     1127      end.
     1128      if not checkGtin(vGtin)
     1129      then
     1130         vGtin = "".
     1131      return vgtin.
     1132   end.
     1133   function getGdsCodeByGtin return int
     1134   (iGtin as char):
     1135      define buffer prod-bc  for ub.prod-bc.
     1136      define buffer bar-code for ub.bar-code.
     1137      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1138      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1139      return if avail bar-code then bar-code.gds-code else ?.
     1140   end.
     1141   function getQntyCodeByGtin return decimal
     1142   (iGtin as char):
     1143      define buffer prod-bc  for ub.prod-bc.
     1144      define buffer bar-code for ub.bar-code.
     1145      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1146      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1147      return if avail bar-code then bar-code.cli-base-rate else ?.
     1148   end.
     1149   function getGdsCodeByDM return int
     1150   (iDm as char):
     1151      define variable vGtin as char no-undo.
     1152      define buffer prod-bc for ub.prod-bc.
     1153      vGtin  = getGtinByDM (IDM ).
     1154      return getGdsCodeByGtin (vGtin).
     1155   end.
     1156   function ChekTypeMarkByGds return logical
     1157   (iGds-code as integer ):
     1158      define buffer goods-attr for ub.goods-attr.
     1159      find first goods-attr where goods-attr.gds-code   = iGds-code
     1160                              and goods-attr.attr-code  = 'mark-type':U
     1161      no-lock no-error.
     1162      if available goods-attr
     1163      then do:
     1164         mTypeMark = goods-attr.attr-value.
     1165         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1166           .
     1167      end.
     1168      else
     1169         return no.
     1170   end.
     1171   function ChekTypeMarkByDm return logical
     1172   (iDM as char ):
     1173      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1174   end.
     1175   function ChekTypeMarkByGtin return logical
     1176   (iGtin as char ):
     1177      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1178   end.
     1179   function GetNextElement return character
     1180     (input iAllTeg        as logical
     1181     ,output oteg          as character
     1182     ,output otegval       as character
     1183     ,input-output pstr    as character
     1184      ):
     1185        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1186        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1187        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1188        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1189        define variable vTeg as character no-undo.
     1190        define variable vLength as integer no-undo.
     1191        define variable vi as integer no-undo.
     1192        define variable vj as integer no-undo.
     1193        define buffer code for ub.code.
     1194        find first code where Code.parent eq "MarkType"
     1195                          and Code.CodeValue   eq mTypeMark
     1196                          no-lock no-error.
     1197        if     available code
     1198           and Code.misc1 ne ""
     1199           and Code.misc1 ne ?
     1200        then do:
     1201           integer (Code.misc1) no-error.
     1202           if not error-status:error
     1203           then
     1204             entry (4,vlistleng) = Code.misc1.
     1205        end.
     1206        if iAllTeg
     1207        then
     1208           assign
     1209              vlistElem     = vlistElem    + vlistElemDop
     1210              vlistleng     = vlistleng    + vlistlengDop
     1211           .
     1212        else if mMRCCode
     1213        then
     1214           assign
     1215              vlistElem     = vlistElem    + ",(8005),8005"
     1216              vlistleng     = vlistleng    + ",000006,0006"
     1217           .
     1218       block-elem:
     1219       do vi = 1 to num-entries(vlistElem):
     1220          vTeg = entry(vi,vlistElem).
     1221          if pstr begins vTeg
     1222          then do:
     1223             if    vTeg eq "21"
     1224             then
     1225                vLength = index(pstr,chr(29)) - 2 no-error.
     1226             if vLength  <= 0
     1227             then
     1228                vLength = int(entry(vi,vlistleng)).
     1229             otegval = substring (pstr,length(vteg) + 1, vLength).
     1230             oteg = replace(replace(vteg,")",""),"(","").
     1231             vTeg = vteg + otegval.
     1232             otegval = replace(otegval,chr(29),"").
     1233             oteg = replace(replace(oteg,")",""),"(","").
     1234             pstr = substring (pstr,length(vTeg)+ 1).
     1235             vTeg = replace(vTeg,chr(29),"").
     1236             leave block-elem.
     1237          end.
     1238          else
     1239             vTeg = "".
     1240       end.
     1241       return vteg.
     1242   end.
     1243   function GetCodeIdent return character
     1244   (iDm as char):
     1245      define variable Velement   as character no-undo init "first".
     1246      define variable oCodeIdent as character no-undo.
     1247      define variable vteg as character no-undo.
     1248      define variable vtegval as character no-undo.
     1249      define variable vGtin as character no-undo.
     1250      define buffer marking for ub.marking.
     1251      for first marking no-lock where
     1252                marking.mark eq iDm
     1253            and marking.unit-ext = "LEVEL2"
     1254      :
     1255        return iDm.
     1256      end.
     1257      vGtin  = getGtinByDM (iDm ).
     1258      ChekTypeMarkByDm(idm).
     1259      if iDm begins 'tech_':U
     1260      then
     1261         oCodeIdent = iDm.
     1262      else if length(iDm) < 21
     1263      then do:
     1264         find first marking where marking.mark eq idm
     1265         no-lock no-error.
     1266         oCodeIdent = if available marking then marking.mark else  ?.
     1267      end.
     1268      else if     length(iDm) eq 29
     1269         and not iDm begins "01"
     1270         and not iDm begins "02"
     1271      then
     1272         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1273      else  if     length(iDm) >= 24
     1274               and (  iDm begins "01"
     1275                   or iDm begins "02")
     1276               and  substring(iDm,17,2) ne "21"
     1277      then do:
     1278         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1279                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1280         then
     1281            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1282         else
     1283            oCodeIdent = iDM.
     1284      end.
     1285      else  if     (   length(iDm) eq 25
     1286                    or length(iDm) eq 21)
     1287               and (not iDm begins "01"
     1288               and  not iDm begins "02")
     1289      then
     1290         oCodeIdent = substring(iDm,1,21).
     1291      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1292      then
     1293         oCodeIdent = substring(iDm,1,21).
     1294      else do while Velement ne "" and idm ne "":
     1295         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1296         oCodeIdent = oCodeIdent + Velement.
     1297      end.
     1298      return oCodeIdent.
     1299   end.
     1300   function GetTegCod return character
     1301   (icodeIdent as char, iTeg as char):
     1302      define variable Velement   as character no-undo init "first".
     1303      define variable oTeg as character no-undo init ?.
     1304      define variable vteg as character no-undo.
     1305      define variable vtegval as character no-undo.
     1306      if     ((length(icodeIdent) eq 21
     1307         and not icodeIdent begins "01"
     1308         and not icodeIdent begins "02")
     1309         or
     1310             ( length(icodeIdent) eq 25
     1311               and not icodeIdent begins "01"
     1312               and not icodeIdent begins "02"))
     1313      then do:
     1314         if iTeg eq "01" or iTeg eq "02"
     1315         then
     1316            oTeg = substring(icodeIdent,1,21).
     1317         else  if  iTeg eq "21"
     1318         then
     1319            oTeg = substring(icodeIdent,15,7).
     1320      end.
     1321      else do:
     1322         ChekTypeMarkByDm(icodeIdent).
     1323         block-teg:
     1324            do while Velement ne "" and icodeIdent ne "":
     1325            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1326            if    Velement begins iTeg
     1327               or Velement begins "(" + iTeg + ")"
     1328            then do:
     1329               oTeg = vtegval.
     1330               leave block-teg.
     1331            end.
     1332         end.
     1333      end.
     1334      return oTeg.
     1335   end.
     1336   function isOAD return logical
     1337   (icodeIdent as character):
     1338      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1339   end.
     1340   function isMark return logical
     1341   (icodeIdent as character):
     1342      define buffer buf_marking for ub.marking.
     1343      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1344             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1345   end.
     1346   function addBracketForCode return character
     1347   (icodeIdent as char):
     1348      define variable Velement   as character no-undo init "first".
     1349      define variable oTeg as character no-undo.
     1350      define variable vteg as character no-undo.
     1351      define variable vtegval as character no-undo.
     1352      define buffer marking for ub.marking.
     1353      find first marking no-lock where
     1354                 marking.mark begins icodeIdent no-error.
     1355      if    not ChekTypeMarkByDm(icodeIdent)
     1356         or length(icodeIdent) le 24
     1357         or (avail marking and marking.unit-ext = "LEVEL2")
     1358      then
     1359         oTeg = icodeIdent.
     1360      else do:
     1361         if (  icodeIdent begins "01"
     1362            or icodeIdent begins "02"
     1363            ) and CheckGtin(substring (icodeIdent,3,14))
     1364            and substring (icodeIdent,17,2) eq "21"
     1365         then do:
     1366            mMRCCode = yes.
     1367            ChekTypeMarkByDm(icodeIdent).
     1368            block-teg:
     1369            do while Velement ne "" and icodeIdent ne "":
     1370               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1371               if vteg ne ""
     1372               then
     1373                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1374            end.
     1375            mMRCCode = no.
     1376         end.
     1377         else do:
     1378            oTeg = icodeIdent.
     1379         end.
     1380      end.
     1381      return oTeg.
     1382   end.
     1383   function getlevelByCodId return int
     1384   (iCode as char):
     1385      define variable vLength as int no-undo.
     1386      define variable vLevel  as int no-undo.
     1387      if not ChekTypeMarkByDM (icode) then return ?.
     1388      vLength = length(iCode).
     1389      if    vLength eq 18
     1390         or vLength eq 20
     1391      then
     1392         Vlevel = 4.
     1393      else if vLength eq 21
     1394      then
     1395         Vlevel = 1.
     1396      else if vLength eq 25
     1397      then do:
     1398         if  iCode begins "01"
     1399         then
     1400            Vlevel = 3.
     1401         else
     1402            Vlevel = 1.
     1403      end.
     1404      else if     vLength >= 26
     1405              and vLength <= 46
     1406      then do:
     1407         if    substring(iCode,17,2) eq "11"
     1408            or substring(iCode,17,2) eq "13"
     1409            or (    substring(iCode,17,2) eq "21"
     1410                and vLength >= 33
     1411                and substring(iCode,26,4) ne "8005")
     1412         then
     1413            Vlevel = 4.
     1414         else if    vLength eq 31
     1415                 or vLength eq 38
     1416                 or vLength eq 39
     1417                 or vLength eq 45
     1418         then
     1419            Vlevel = 1.
     1420         else if    vLength eq 35
     1421                 or vLength eq 43
     1422         then
     1423            Vlevel = 3.
     1424         else
     1425            Vlevel = ?.
     1426      end.
     1427      else
     1428         Vlevel = ?.
     1429      return Vlevel.
     1430   end.
     1431   function getLevelMotpBycodid return character
     1432   (iDm as char):
     1433      define variable vLevel as integer no-undo.
     1434      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1435      vLevel = getlevelByCodId(iDm).
     1436      if    vLevel eq ?
     1437         or vLevel < 1
     1438         or vLevel > 6
     1439      then
     1440         return ?.
     1441      else
     1442         return entry(vlevel,vList).
     1443   end.
     1444   function getLevelUTDByLevelMotp return character
     1445   (iUnit as char):
     1446      define variable vLevel as integer no-undo.
     1447      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1448      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1449      vLevel = lookup(iUnit,vListMOTP).
     1450      if    vLevel eq ?
     1451         or vLevel < 1
     1452         or vLevel > 4
     1453      then
     1454         return ?.
     1455      else
     1456         return entry(vlevel,vListutd).
     1457   end.
     1458   function getLevelMotpByDM return character
     1459   (iDm as char):
     1460      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1461   end.
     1462   function getLevelUTDByCodId return character
     1463   (iDm as char):
     1464      define variable vLevel as integer no-undo.
     1465      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1466      vLevel = getlevelByCodId(iDm).
     1467      if    vLevel eq ?
     1468         or vLevel < 1
     1469         or vLevel > 4
     1470      then
     1471         return ?.
     1472      else
     1473         return entry(vlevel,vList).
     1474   end.
     1475   function getLevelUTDByDM return character
     1476   (iDm as char):
     1477      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1478   end.
     1479   define variable mNotMarkQnty as logical no-undo.
     1480   function getQntyUTDByCodId return decimal
     1481   (iDM as char):
     1482      define variable vLevel as integer no-undo.
     1483      define variable vList as character no-undo init "1,5,10,500".
     1484      define variable vGtin as character no-undo.
     1485      define variable vqnty as decimal no-undo init ?.
     1486      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1487      if vqnty eq ?
     1488      then do:
     1489         if not mNotMarkQnty
     1490         then do:
     1491            define buffer marking for ub.marking.
     1492            define variable vCodident as character no-undo.
     1493            vCodident = GetCodeIdent(idm).
     1494            find first marking where marking.mark begins vCodident no-lock no-error.
     1495            if     available marking
     1496               and marking.box-qnty ne ?
     1497            then
     1498               return marking.box-qnty.
     1499         end.
     1500         vGtin = getGtinByDm(iDM).
     1501         if ChekTypeMarkByGtin (vGtin)
     1502         then do:
     1503            vLevel = getlevelByCodId(iDM).
     1504            if     vLevel >= 1
     1505               and vLevel <= 4
     1506            then
     1507               vqnty = int(entry(vlevel,vList)).
     1508         end.
     1509         else
     1510            vqnty = getQntyCodeByGtin(vgtin).
     1511      end.
     1512      return vqnty.
     1513   end.
     1514   function getQntyUTDByDM return decimal
     1515   (iDm as char):
     1516      define variable vDM as character no-undo.
     1517      if     length (iDm) ne 25
     1518         and length (iDm) ne 29
     1519         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1520      then
     1521         vDM = substring (iDm,1,length (iDm) - 6 ).
     1522      else
     1523         vDM = substring (iDm,1,length (iDm) - 4 ).
     1524      return getQntyUTDByCodId(vDM).
     1525   end.
     1526   function getMRC4 return decimal
     1527   (iMRC as char):
     1528      define variable oMrc     as decimal no-undo init ?.
     1529      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1530      define variable vi       as integer no-undo.
     1531      define variable vfound   as integer no-undo.
     1532      define variable vposStart   as integer no-undo.
     1533      do:
     1534      OMRc = 0.
     1535      do vi = 1 to 4:
     1536         define variable vsimb as character no-undo.
     1537         vsimb = substring(iMRC,vi,1).
     1538         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1539         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1540         if vfound > 0
     1541         then
     1542            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1543         end.
     1544         OMRc = OMRc / 100.
     1545      end.
     1546      return OMRc.
     1547   end.
     1548   function getMRCByDM return decimal
     1549   (iDm as char):
     1550      define variable vMRC     as character no-undo.
     1551      define variable oMrc     as decimal no-undo init ?.
     1552      define variable Velement as character no-undo init "empty".
     1553      define variable vteg as character no-undo.
     1554      define variable vtegval as character no-undo.
     1555      if    length(idm) eq 14 + 7 + 4 + 4
     1556         or length(idm) eq 14 + 7 + 4
     1557      then do:
     1558         vMRC = substring(idm,22,4).
     1559         omrc = getMRC4(vMRC).
     1560      end.
     1561      else do:
     1562          ChekTypeMarkByDm(iDm).
     1563          block-mrc:
     1564          do while Velement ne "" and idm ne "":
     1565             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1566             if Velement begins "8005"
     1567             then do:
     1568                vMRC = substring(Velement,5,6).
     1569                leave block-mrc.
     1570             end.
     1571             else if Velement begins "(8005)"
     1572             then do:
     1573                vMRC = substring(Velement,7,6).
     1574                leave block-mrc.
     1575             end.
     1576          end.
     1577          if vMRC ne ""
     1578          then
     1579             OMRc = dec(vmrc) / 100 no-error.
     1580      end.
     1581      return OMRc.
     1582   end.
     1583   function MoveDate return Date
     1584   (idate as date,
     1585    iMonth as int64):
     1586      define variable vMonth   as int64 no-undo.
     1587      define variable vYear    as int64 no-undo.
     1588      define variable vDateNew as date  no-undo.
     1589       define variable vDay     as int64 no-undo.
     1590       vMonth = month(iDate) + iMonth.
     1591       vYear =  year(iDate).
     1592       if vMonth <= 0
     1593       then assign
     1594          vMonth = vMonth + 12
     1595           vYear  = vYear - 1
     1596       .
     1597       else if vMonth > 12
     1598       then assign
     1599          vMonth = vMonth - 12
     1600           vYear  = vYear + 1
     1601       .
     1602       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1603       do while error-status:error eq yes:
     1604          VDay = vDay + 1.
     1605          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1606       end.
     1607       if VDay > 0
     1608       then
     1609          vDateNew + 1.
     1610       return vDateNew.
     1611   end.
     1612   procedure checkEMRC:
     1613   define input  parameter iDm as character no-undo.
     1614   define output parameter vok as logical   no-undo init yes.
     1615      define variable v-value-emrc as character no-undo.
     1616      define variable v-type-emrc  as character no-undo.
     1617      define variable vDateIso     as character no-undo.
     1618      define variable vMRC         as decimal no-undo.
     1619      define variable vqnty        as decimal no-undo.
     1620      define variable vPrice       as decimal no-undo.
     1621      define variable vparent      as character no-undo.
     1622      define variable vgds-code    as integer no-undo.
     1623      define buffer code for ub.code.
     1624      vMRC = getMRCByDM(iDm).
     1625      if vMRC > 0
     1626      then do:
     1627         vgds-code = getGdsCodeByDM(iDm).
     1628         vqnty     = getQntyUTDByDM(iDm).
     1629               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1630            (
     1631             input   vgds-code
     1632            ,input   'emrc-type':U
     1633            ,output   v-value-emrc
     1634            ,output   v-type-emrc
     1635          ) no-error.
     1636          if     v-value-emrc ne ""
     1637             and v-value-emrc ne ?
     1638          then do:
     1639             vDateIso = iso-date(today).
     1640             vPrice = vMRC / vqnty.
     1641             vparent ="emc" + chr(4) + v-value-emrc.
     1642             find last code where Code.parent      eq vparent
     1643                              and Code.code        le vDateIso
     1644                              and code.status_  eq 0
     1645             no-lock no-error.
     1646             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1647             then
     1648                vOk = true .
     1649             else do:
     1650                 define variable vText      as character no-undo.
     1651                 define variable vDate      as date no-undo.
     1652                 define variable vDateLast  as character no-undo.
     1653                 define variable vDateFirst as character no-undo.
     1654                 define variable vDate3     as date no-undo.
     1655                 vdate = date(code.misc1).
     1656                 vDateLast = code.misc1.
     1657                 vDate3 = MoveDate(today, - 3 ).
     1658                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1659                                      string(vDate3  , "99/99/9999"),
     1660                                      string(vDate   , "99/99/9999")
     1661                                      ).
     1662                 vdateIso = iso-date(vdate3).
     1663                 find last code  where Code.parent      eq vparent
     1664                                   and Code.code        le vDateIso
     1665                                   and code.status_  eq 0 no-lock no-error.
     1666                 if available code
     1667                 then
     1668                    vDateIso = code.code.
     1669                 vDateFirst = vDateIso.
     1670                 vDateLast = iso-date(vdate).
     1671                 define variable vGood as logical no-undo.
     1672                 define variable vDateSale as date no-undo.
     1673                 define buffer bcode for code.
     1674                 for last code where Code.parent   eq vparent
     1675                                 and code.status_  eq 0
     1676                                 and code.code     < vDateLast
     1677                                 and code.code     >= vDateFirst
     1678                 no-lock:
     1679                    find first bcode where bCode.parent   eq vparent
     1680                                       and bcode.status_  eq 0
     1681                                       and bcode.code     > code.code no-lock no-error.
     1682                    if available bcode
     1683                    then do:
     1684                       if vPrice < dec(Code.CodeValue)
     1685                       then
     1686                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1687                                                     chr(10),
     1688                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1689                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1690                                                     ).
     1691                       else do:
     1692                          vGood = yes.
     1693                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1694                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1695                                                     chr(10),
     1696                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1697                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1698                                                     string(         vDateSale            ,"99/99/9999"),
     1699                                                     string(vDateSale - today)
     1700                                                     ).
     1701                       end.
     1702                    end.
     1703                 end.
     1704                 if vgood
     1705                 then do:
     1706                    define variable choice as integer no-undo .
     1707                    run gbl/d-askw.w (input "Уточнение"
     1708                           ,input  vText
     1709                           ,input "|"
     1710                           ,input "Принять|Вернуть"
     1711                           ,input "Принять данный товар|Вернуть товар постащику"
     1712                           ,input 1
     1713                           ,input 2
     1714                           ,output choice) no-error.
     1715                    vok = choice eq 1.
     1716                 end.
     1717                 else
     1718                    vok =false.
     1719             end.
     1720          end.
     1721      end.
     1722   end.
     1723   function addGs2Mark return character
     1724   (iMark as char):
     1725      define variable vDM   as character no-undo.
     1726      define variable vIdx  as integer   no-undo.
     1727      if index(iMark,chr(29),1) > 0
     1728      then return iMark.
     1729      if substring(iMark,26,4) = "8005" then
     1730      do:
     1731        vIdx = index(iMark,"93",26 + 4 + 5).
     1732        if vIdx > 1 then do:
     1733          vDM = substitute("&1&4&2&4&3",
     1734                           substring(iMark,1,25),
     1735                           substring(iMark,26,vIdx - 25 - 1),
     1736                           substring(iMark,vIdx),
     1737                           chr(29)) no-error.
     1738          vIdx = index(vDm,"240",vIdx + 4).
     1739          if vIdx > 0 then
     1740          do:
     1741            vDM = substitute("&1&3&2",
     1742                             substring(vDm,1,vIdx - 1),
     1743                             substring(vDm,vIdx),
     1744                             chr(29)) no-error.
     1745          end.
     1746        end.
     1747        else
     1748          vDM = substitute("&1&3&2",
     1749                           substring(iMark,1,25),
     1750                           substring(iMark,26),
     1751                           chr(29)) no-error.
     1752      end.
     1753      else if substring(iMark,32,2) = "91" then
     1754      do:
     1755        vIdx = index(iMark,"92",32).
     1756        if vIdx > 1 then
     1757          vDM = substitute("&1&4&2&4&3",
     1758                           substring(iMark,1,31),
     1759                           substring(iMark,32,vIdx - 31 - 1),
     1760                           substring(iMark,vIdx),
     1761                           chr(29)) no-error.
     1762        else
     1763          vDM = substitute("&1&3&2",
     1764                           substring(iMark,1,31),
     1765                           substring(iMark,32),
     1766                           chr(29)) no-error.
     1767      end.
     1768      else if substring(iMark,39,2) = "91" then
     1769      do:
     1770        vIdx = index(iMark,"92",38).
     1771        if vIdx > 1 then
     1772          vDM = substitute("&1&4&2&4&3",
     1773                           substring(iMark,1,38),
     1774                           substring(iMark,39,vIdx - 38 - 1),
     1775                           substring(iMark,vIdx),
     1776                           chr(29)) no-error.
     1777        else
     1778          vDM = substitute("&1&3&2",
     1779                           substring(iMark,1,38),
     1780                           substring(iMark,39),
     1781                           chr(29)) no-error.
     1782      end.
     1783      else if substring(iMark,25,2) = "93" then
     1784      do:
     1785        vIdx = index(iMark,"92",25).
     1786        if vIdx > 1 then
     1787          vDM = substitute("&1&4&2&4&3",
     1788                           substring(iMark,1,24),
     1789                           substring(iMark,25,vIdx - 24 - 1),
     1790                           substring(iMark,vIdx),
     1791                           chr(29)) no-error.
     1792        else
     1793          vIdx = index(iMark,"3103",25).
     1794          if vIdx > 0 then
     1795          vDM = substitute("&1&4&2&4&3",
     1796                           substring(iMark,1,24),
     1797                           substring(iMark,25,vIdx - 24 - 1),
     1798                           substring(iMark,vIdx),
     1799                           chr(29)) no-error.
     1800          else
     1801            vDM = substitute("&1&3&2",
     1802                             substring(iMark,1,24),
     1803                             substring(iMark,25),
     1804                             chr(29)) no-error.
     1805      end.
     1806      else if substring(iMark,32,2) = "93" then
     1807      do:
     1808        vDM = substitute("&1&3&2",
     1809              substring(iMark,1,31),
     1810              substring(iMark,32),
     1811              chr(29)) no-error.
     1812      end.
     1813      return if vDM <> "" then vDm else iMark.
     1814   end.
     1815   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1816   procedure gen-key-rec :
     1817     define input  parameter p-tbl-name    as character no-undo.
     1818     define input  parameter p-bh_tbl-name as handle    no-undo.
     1819     define output parameter p-key-rec     as character no-undo.
     1820     do
     1821     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1822     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1823     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1824     :
     1825       define variable fh               as handle    no-undo .
     1826       define variable v-ok             as logical   no-undo .
     1827       define variable v-inform         as character no-undo .
     1828       define variable v-ind            as integer   no-undo .
     1829       define variable v-idx-field-qnty as integer   no-undo .
     1830       if p-tbl-name = ?
     1831         or p-tbl-name = "":U
     1832       then do:
     1833         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
     1834       end.
     1835       if not p-bh_tbl-name:available then do:
     1836         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
     1837       end.
     1838       assign
     1839         p-key-rec = p-tbl-name
     1840         v-inform  = p-bh_tbl-name:index-information(1)
     1841         v-ind     = 2
     1842       .
     1843       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1844       on error undo, return error
     1845       :
     1846         assign
     1847           v-inform = p-bh_tbl-name:index-information( v-ind )
     1848           v-ind    = v-ind + 1
     1849         .
     1850       end.
     1851       if v-inform = ?
     1852         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1853         or entry( 3, v-inform, ",":U ) <> "1":U
     1854       then do:
     1855         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
     1856       end.
     1857       else do:
     1858         assign
     1859           v-idx-field-qnty = num-entries( v-inform ) - 4
     1860         .
     1861         if v-idx-field-qnty < 2 then do:
     1862           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
     1863         end.
     1864         do v-ind = 1 to v-idx-field-qnty by 2
     1865         on error undo, return error
     1866         :
     1867           assign
     1868             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1869             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1870           .
     1871         end.
     1872       end.
     1873       if p-key-rec = ? then do:
     1874         assign
     1875           p-key-rec = "":U
     1876         .
     1877         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
     1878       end.
     1879     end.
     1880     return.
     1881   end procedure.
     1882   procedure gen-where-keyr-tab :
     1883     define input  parameter i-tableSerach as character no-undo.
     1884     define input  parameter i-tablekey   as character  no-undo.
     1885     define input  parameter p-key-rec    as character  no-undo.
     1886     define input  parameter p-key-handle as handle     no-undo .
     1887     define input  parameter p-db-name    as character  no-undo .
     1888     define input  parameter p-tt-handle  as handle     no-undo .
     1889     define output parameter o-Where      as character  no-undo.
     1890     do
     1891     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1892     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1893     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1894     :
     1895       define variable v-full-tbl-name  as character no-undo .
     1896       define variable bh_tbl-name      as handle    no-undo .
     1897       define variable fh_key           as handle    no-undo .
     1898       define variable fh_search        as handle    no-undo .
     1899       define variable v-field-num      as integer   no-undo .
     1900       define variable v-count-fld      as integer   no-undo .
     1901       define variable v-inform         as character no-undo .
     1902       define variable v-ind            as integer   no-undo .
     1903       define variable v-idx-field-qnty as integer   no-undo .
     1904       define variable v-field-name     as character no-undo .
     1905       define variable v-field-val      as character no-undo .
     1906       define variable v-word-link      as character no-undo .
     1907       define variable vTable           as character no-undo.
     1908       define variable bh_tbl-key       as handle    no-undo .
     1909       assign
     1910         p-key-rec = trim( p-key-rec )
     1911       .
     1912       if p-key-handle <> ? then do:
     1913         if not valid-handle(p-key-handle)
     1914            or p-key-handle:type <> "buffer"
     1915         then do:
     1916           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
     1917         end.
     1918         if num-entries( p-key-rec, chr(3) ) > 1
     1919           or p-key-rec = ?
     1920           or p-key-rec = "":U
     1921         then do:
     1922           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
     1923         end.
     1924       end.
     1925       else do:
     1926         if p-key-rec = ?
     1927           or p-key-rec = "":U
     1928         then do:
     1929           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1930         end.
     1931       end.
     1932       assign
     1933         vTable = entry( 1 , p-key-rec, chr(3) )
     1934       .
     1935       if p-tt-handle <> ?
     1936         and ( not valid-handle(p-tt-handle)
     1937               or p-tt-handle:type <> "buffer"
     1938             )
     1939       then do:
     1940         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
     1941       end.
     1942       if p-tt-handle = ? then do:
     1943         assign
     1944           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1945         .
     1946         create buffer bh_tbl-name for table v-full-tbl-name .
     1947       end.
     1948       else do:
     1949         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1950       end.
     1951       assign
     1952         v-inform = bh_tbl-name:index-information(1)
     1953         v-ind    = 2
     1954       .
     1955       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1956       on error undo, return error
     1957       :
     1958         assign
     1959           v-inform = bh_tbl-name:index-information( v-ind )
     1960           v-ind    = v-ind + 1
     1961         .
     1962       end.
     1963       if v-inform = ?
     1964         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1965         or entry( 3, v-inform, ",":U ) <> "1":U
     1966       then do:
     1967         delete object bh_tbl-name no-error.
     1968         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
     1969       end.
     1970       assign
     1971         v-idx-field-qnty = num-entries( v-inform ) - 4
     1972       .
     1973       if v-idx-field-qnty < 2 then do:
     1974         delete object bh_tbl-name no-error.
     1975         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
     1976       end.
     1977       assign
     1978         o-where     = "where":U
     1979         v-word-link = "":U
     1980         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1981         v-count-fld = 0
     1982       .
     1983       if i-tablekey ne "" and i-tablekey ne ?
     1984       then do:
     1985         assign
     1986           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1987         .
     1988         create buffer bh_tbl-key for table v-full-tbl-name .
     1989       end.
     1990       if i-tableSerach ne "" and i-tableSerach ne ?
     1991       then do:
     1992         delete object bh_tbl-name no-error.
     1993         assign
     1994           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1995         .
     1996         create buffer bh_tbl-name for table v-full-tbl-name .
     1997       end.
     1998       block_where:
     1999       do v-ind = 1 to v-idx-field-qnty by 2
     2000       on error undo, return error
     2001       :
     2002         assign
     2003           v-count-fld = v-count-fld + 1
     2004         .
     2005         if p-key-handle = ?
     2006           and v-count-fld > v-field-num
     2007         then do:
     2008           leave block_where.
     2009         end.
     2010         define variable VfieldKeyTable as handle no-undo.
     2011         assign
     2012           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2013           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2014         .
     2015         if     bh_tbl-key ne ?
     2016         then do:
     2017            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2018            if VfieldKeyTable eq ?
     2019            then next block_where.
     2020         end.
     2021         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2022         then
     2023            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2024         else
     2025            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2026         if p-key-handle = ? then do:
     2027           assign
     2028             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2029           .
     2030         end.
     2031         else do:
     2032           assign
     2033             fh_key = p-key-handle:buffer-field( v-field-name )
     2034           .
     2035           if fh_key = ?
     2036             or not valid-handle( fh_key )
     2037           then do:
     2038             delete object bh_tbl-name.
     2039             if     bh_tbl-key ne ?
     2040             then
     2041                delete object bh_tbl-key.
     2042             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
     2043           end.
     2044           assign
     2045             v-field-val = fh_key:buffer-value
     2046           .
     2047         end.
     2048         if fh_search:data-type ="character":U then do:
     2049           assign
     2050             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2051             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2052             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2053             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2054             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2055             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2056             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2057             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2058             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2059             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2060             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2061             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2062             v-field-val = substitute( '"&1"', v-field-val )
     2063           .
     2064         end.
     2065         assign
     2066           o-where = substitute( "&1 &2", o-where, v-field-val )
     2067         .
     2068         if v-word-link = "":U then do:
     2069           assign
     2070             v-word-link = "and":U
     2071           .
     2072         end.
     2073       end.
     2074       delete object bh_tbl-name.
     2075       if     bh_tbl-key ne ?
     2076       then
     2077          delete object bh_tbl-key.
     2078       if p-key-handle = ?
     2079         and v-count-fld <> v-field-num
     2080       then do:
     2081         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
     2082       end.
     2083     end.
     2084   end procedure.
     2085   procedure gen-hn-keyr-tab :
     2086     define input  parameter i-tableSerach as character no-undo.
     2087     define input  parameter i-tablekey   as character no-undo.
     2088     define input  parameter p-key-rec    as character no-undo.
     2089     define input  parameter p-key-handle as handle    no-undo .
     2090     define input  parameter p-db-name    as character no-undo .
     2091     define input  parameter p-tt-handle  as handle    no-undo .
     2092     define input  parameter p-stts-lock  as integer   no-undo .
     2093     define output parameter o-hn         as handle    no-undo.
     2094     define variable v-full-tbl-name as character no-undo.
     2095     define variable v-where         as character no-undo.
     2096     define variable bh_tbl-name     as handle    no-undo.
     2097     define variable vTable          as character no-undo.
     2098     do
     2099     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2100     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2101     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2102         run gen-where-keyr-tab(i-tableSerach,
     2103                                i-tablekey,
     2104                                p-key-rec,
     2105                                p-key-handle,
     2106                                p-db-name,
     2107                                p-tt-handle,
     2108                                output v-where).
     2109         if i-tableSerach ne "" and i-tableSerach ne ?
     2110         then do:
     2111            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2112            create buffer bh_tbl-name for table v-full-tbl-name .
     2113         end.
     2114         else do:
     2115            if p-tt-handle = ? then do:
     2116               assign
     2117                  vTable = entry( 1 , p-key-rec, chr(3) )
     2118               .
     2119               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2120               create buffer bh_tbl-name for table v-full-tbl-name .
     2121            end.
     2122            else do:
     2123               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2124            end.
     2125         end.
     2126         if p-tt-handle = ? then do:
     2127            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2128         end.
     2129         else do:
     2130            bh_tbl-name:find-first( v-where ) no-error .
     2131         end.
     2132         o-hn = bh_tbl-name.
     2133      end.
     2134   end procedure.
     2135   procedure gen-hn-keyr :
     2136     define input  parameter p-key-rec    as character no-undo.
     2137     define input  parameter p-key-handle as handle    no-undo .
     2138     define input  parameter p-db-name    as character no-undo .
     2139     define input  parameter p-tt-handle  as handle    no-undo .
     2140     define input  parameter p-stts-lock  as integer   no-undo .
     2141     define output parameter o-hn         as handle    no-undo.
     2142     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2143   end.
     2144   procedure gen-row-keyr :
     2145     define input  parameter p-key-rec    as character no-undo.
     2146     define input  parameter p-key-handle as handle    no-undo .
     2147     define input  parameter p-db-name    as character no-undo .
     2148     define input  parameter p-tt-handle  as handle    no-undo .
     2149     define input  parameter p-stts-lock  as integer   no-undo .
     2150     define output parameter p-tbl-row    as rowid     no-undo.
     2151     define output parameter p-tbl-name   as character no-undo.
     2152     define variable vHn as handle no-undo.
     2153       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2154       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2155       p-tbl-name =  vHn:table.
     2156       delete object vHn no-error.
     2157     if p-tbl-row = ? then do:
     2158       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
     2159     end.
     2160     else do:
     2161       return.
     2162     end.
     2163   end procedure.
     2164   procedure gen-key-fv :
     2165     define input  parameter p-key-rec    as character no-undo .
     2166     define output parameter p-field-list as character no-undo .
     2167     define output parameter p-value-list as character no-undo.
     2168     do
     2169     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2170     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2171     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2172     :
     2173       define variable v-full-tbl-name  as character no-undo .
     2174       define variable bh_tbl-name      as handle    no-undo .
     2175       define variable v-tbl-name       as character no-undo .
     2176       define variable v-field-num      as integer   no-undo .
     2177       define variable v-count-fld      as integer   no-undo .
     2178       define variable v-inform         as character no-undo .
     2179       define variable v-ind            as integer   no-undo .
     2180       define variable v-idx-field-qnty as integer   no-undo .
     2181       define variable v-delim-key      as character no-undo .
     2182       if p-key-rec = ?
     2183         or p-key-rec = "":U
     2184       then do:
     2185         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     2186       end.
     2187       assign
     2188         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2189         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2190       .
     2191       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2192       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
     2193       assign
     2194         v-inform = bh_tbl-name:index-information(1)
     2195         v-ind    = 2
     2196       .
     2197       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2198       on error undo, return error
     2199       :
     2200         assign
     2201           v-inform = bh_tbl-name:index-information( v-ind )
     2202           v-ind    = v-ind + 1
     2203         .
     2204       end.
     2205       if v-inform = ?
     2206         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2207         or entry( 3, v-inform, ",":U ) <> "1":U
     2208       then do:
     2209         delete object bh_tbl-name no-error.
     2210         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     2211       end.
     2212       assign
     2213         v-idx-field-qnty = num-entries( v-inform ) - 4
     2214       .
     2215       if v-idx-field-qnty < 2 then do:
     2216         delete object bh_tbl-name no-error.
     2217         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     2218       end.
     2219       assign
     2220         p-field-list = "":U
     2221         p-value-list = "":U
     2222         v-delim-key  = "":U
     2223         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2224         v-count-fld  = 0
     2225       .
     2226       block_where:
     2227       do v-ind = 1 to v-idx-field-qnty by 2
     2228       on error undo, return error
     2229       :
     2230         assign
     2231           v-count-fld = v-count-fld + 1
     2232         .
     2233         if v-count-fld > v-field-num then do:
     2234           leave block_where.
     2235         end.
     2236         assign
     2237           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2238           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2239         .
     2240         if v-ind = 1 then do:
     2241           assign
     2242             v-delim-key = chr(3)
     2243           .
     2244         end.
     2245       end.
     2246       delete object bh_tbl-name.
     2247       if v-count-fld <> v-field-num then do:
     2248         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
     2249       end.
     2250     end.
     2251   end procedure.
     2252   procedure gen-key-field :
     2253     define input  parameter p-table      as character no-undo .
     2254     define output parameter p-field-list as character no-undo .
     2255     do
     2256     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2257     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2258     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2259     :
     2260       define variable v-full-tbl-name  as character no-undo .
     2261       define variable bh_tbl-name      as handle    no-undo .
     2262       define variable v-tbl-name       as character no-undo .
     2263       define variable v-field-num      as integer   no-undo .
     2264       define variable v-count-fld      as integer   no-undo .
     2265       define variable v-inform         as character no-undo .
     2266       define variable v-ind            as integer   no-undo .
     2267       define variable v-idx-field-qnty as integer   no-undo .
     2268       define variable v-delim-key      as character no-undo .
     2269       if p-table = ?
     2270         or p-table = "":U
     2271       then do:
     2272         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
     2273       end.
     2274       assign
     2275         v-tbl-name      = p-table
     2276         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2277       .
     2278       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2279       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
     2280       assign
     2281         v-inform = bh_tbl-name:index-information(1)
     2282         v-ind    = 2
     2283       .
     2284       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2285       on error undo, return error
     2286       :
     2287         assign
     2288           v-inform = bh_tbl-name:index-information( v-ind )
     2289           v-ind    = v-ind + 1
     2290         .
     2291       end.
     2292       if v-inform = ?
     2293         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2294         or entry( 3, v-inform, ",":U ) <> "1":U
     2295       then do:
     2296         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     2297       end.
     2298       assign
     2299         v-idx-field-qnty = num-entries( v-inform ) - 4
     2300       .
     2301       if v-idx-field-qnty < 2 then do:
     2302         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     2303       end.
     2304       assign
     2305         p-field-list = "":U
     2306         v-delim-key  = "":U
     2307         v-count-fld  = 0
     2308       .
     2309       block_where:
     2310       do v-ind = 1 to v-idx-field-qnty by 2
     2311       on error undo, return error
     2312       :
     2313         assign
     2314           v-count-fld = v-count-fld + 1
     2315         .
     2316         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2317         if v-ind = 1 then do:
     2318           assign
     2319             v-delim-key = chr(3)
     2320           .
     2321         end.
     2322       end.
     2323       delete object bh_tbl-name.
     2324     end.
     2325   end procedure.
     2326   function AddUtdErrForTab returns logical
     2327   (idb-num         as integer ,
     2328    idoc-id         as integer ,
     2329    iTab            as character,
     2330    iObj            as handle ,
     2331    iCheckType      as character,
     2332    iCodeErr        as character,
     2333    iCheckObj       as character ):
     2334      define buffer utd-err for utd-err.
     2335      define buffer utd for utd.
     2336      find first utd where utd.db-num     eq idb-num
     2337                       and utd.doc-id     eq idoc-id
     2338                       and utd.Direction  eq 'Outbound'
     2339      no-lock no-error.
     2340      if available utd
     2341      then
     2342         return no.
     2343      define variable vRecKey as character no-undo.
     2344            run gen-key-rec (input iTab,
     2345                             input  iObj,
     2346                             output vRecKey).
     2347      find first utd-err where utd-err.db-num     eq idb-num
     2348                           and utd-err.doc-id     eq idoc-id
     2349                           and utd-err.CheckType  eq iCheckType
     2350                           and utd-err.CodeErr    eq iCodeErr
     2351                           and utd-err.CheckObj   eq iCheckObj
     2352      exclusive-lock no-error.
     2353      if not available utd-err
     2354      then do:
     2355         create utd-err.
     2356         assign
     2357            utd-err.db-num         = idb-num
     2358            utd-err.doc-id         = idoc-id
     2359            utd-err.CheckType      = iCheckType
     2360            utd-err.CodeErr        = iCodeErr
     2361            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2362            utd-err.reckey         = vRecKey
     2363            utd-err.qnty           = 1
     2364         .
     2365      end.
     2366      else
     2367         utd-err.qnty = utd-err.qnty + 1.
     2368      return utd-err.qnty eq 1.
     2369   end.
     2370   function AddUtdErr returns logical
     2371   (idb-num         as integer ,
     2372    idoc-id         as integer ,
     2373    iObj            as handle ,
     2374    iCheckType      as character,
     2375    iCodeErr        as character,
     2376    iCheckObj       as character ):
     2377      AddUtdErrForTab
     2378         (idb-num,
     2379          idoc-id,
     2380          iObj:table,
     2381          iObj,
     2382          iCheckType,
     2383          iCodeErr,
     2384          iCheckObj).
     2385   end.
     2386   function ClearUtdErrTypeCode returns logical
     2387   (idb-num         as integer,
     2388    idoc-id         as integer ,
     2389    iCheckType      as character,
     2390    iCodeErr        as character
     2391    ):
     2392      define buffer utd-err for utd-err.
     2393      if    iCheckType eq "*"
     2394         or iCheckType eq ?
     2395      then do:
     2396         if     iCodeErr ne ?
     2397            and iCodeErr ne "*"
     2398         then
     2399            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2400            view-as alert-box.
     2401         else
     2402         for each utd-err where utd-err.db-num  eq idb-num
     2403                            and utd-err.doc-id  eq idoc-id
     2404         exclusive-lock:
     2405            delete utd-err.
     2406         end.
     2407      end.
     2408      else do:
     2409         if    iCodeErr eq ?
     2410            or iCodeErr eq "*"
     2411         then do:
     2412            for each utd-err where utd-err.db-num     eq idb-num
     2413                               and utd-err.doc-id     eq idoc-id
     2414                               and utd-err.CheckType  eq iCheckType
     2415            exclusive-lock:
     2416               delete utd-err.
     2417            end.
     2418         end.
     2419         else do:
     2420            for each utd-err where utd-err.db-num     eq idb-num
     2421                               and utd-err.doc-id     eq idoc-id
     2422                               and utd-err.CheckType  eq iCheckType
     2423                               and ub.utd-err.CodeErr eq iCodeErr
     2424            exclusive-lock:
     2425               delete utd-err.
     2426            end.
     2427         end.
     2428      end.
     2429   end.
     2430   function ClearUtdErr returns logical
     2431   (idb-num         as integer,
     2432    idoc-id         as integer ,
     2433    iCheckType      as character
     2434    ):
     2435      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2436   end.
     2437   function GetMesError returns character
     2438   (itxt as character,
     2439    iobj as character ):
     2440    define variable vi as integer no-undo.
     2441    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2442       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2443    end.
     2444    return itxt.
     2445   end.
     2446   function GetTextErrorType returns character
     2447   (iCheckType as character,
     2448    iCodeErr   as character,
     2449    iChechObj  as character,
     2450    iType      as character  ):
     2451      define buffer code    for code.
     2452      define variable vError as character no-undo.
     2453      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2454                        and code.code   eq iCodeErr
     2455      no-lock no-error.
     2456      if available code
     2457      then do:
     2458         define variable vType as integer no-undo.
     2459         if code.misc3 eq "error"
     2460         then
     2461            vType = 0.
     2462         else if code.misc3 eq "warning"
     2463         then
     2464            vType = 1.
     2465         else if code.misc3 eq "Hiden"
     2466         then
     2467            vType = 2.
     2468         else
     2469            vtype = int(code.misc3) no-error.
     2470         case itype:
     2471            when "error"
     2472            then do:
     2473               if vtype eq 0
     2474               then
     2475                  vError = GetMesError(Code.CodeValue,iChechObj).
     2476            end.
     2477            when "warning"
     2478            then do:
     2479               if vtype <= 1
     2480               then
     2481                  vError = GetMesError(Code.CodeValue,iChechObj).
     2482            end.
     2483            otherwise do:
     2484               vError = GetMesError(Code.CodeValue,iChechObj).
     2485            end.
     2486         end.
     2487      end.
     2488      else
     2489         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2490      return vError.
     2491   end.
     2492   function GetTypeError returns integer
     2493   (iCheckType as character,
     2494    iCodeErr   as character):
     2495      define buffer code    for code.
     2496      define variable vType as integer no-undo.
     2497      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2498                        and code.code   eq iCodeErr
     2499      no-lock no-error.
     2500      if     not available code
     2501         and code.misc3 eq "error"
     2502      then
     2503         vType = 0.
     2504      else if code.misc3 eq "warning"
     2505      then
     2506         vType = 1.
     2507      else if code.misc3 eq "Hiden"
     2508      then
     2509         vType = 2.
     2510      else
     2511         vtype = int(code.misc3) no-error.
     2512      return vtype.
     2513   end.
     2514   function GetTextError returns character
     2515   (iCheckType as character,
     2516    iCodeErr   as character,
     2517    iChechObj  as character ):
     2518      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2519   end.
     2520   function GetErrForUtdStr returns character
     2521   (idb-num     as integer ,
     2522    idoc-id     as integer ,
     2523    iCheckType  as character
     2524    ):
     2525      define buffer utd-err for utd-err.
     2526      define buffer code    for code.
     2527      define variable vHQry as handle no-undo.
     2528      define variable vError as longchar no-undo.
     2529      define variable vErrorOne as longchar  no-undo.
     2530      define variable oError as character no-undo.
     2531      create query vHQry.
     2532      vHQry:set-buffers(buffer utd-err:handle).
     2533      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2534                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2535                               + if    iCheckType eq "*"
     2536                                    or iCheckType eq ?
     2537                                 then       ""
     2538                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2539      vHQry:query-open().
     2540      vHQry:get-first().
     2541      QRY-BLOCK:
     2542      repeat while not vHQry:query-off-end:
     2543         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2544         if     vErrorOne ne ""
     2545            and vErrorOne ne ?
     2546         then
     2547            vError = vError + ", " + vErrorOne.
     2548         vHQry:get-next().
     2549      end.
     2550      oError = substring(vError,3,4002).
     2551      return oError.
     2552   end.
     2553   function GetErrJsonForUtd returns character
     2554   (idb-num         as integer ,
     2555    idoc-id         as integer ,
     2556    iCheckType      as character
     2557    ):
     2558      define buffer utd-err for utd-err.
     2559      define variable vHQry as handle no-undo.
     2560      define variable vError as longchar no-undo.
     2561      define variable oError as character no-undo.
     2562      create query vHQry.
     2563      define variable vi as integer no-undo.
     2564      vHQry:set-buffers(buffer utd-err:handle).
     2565      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2566                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2567                               + if    iCheckType eq "*"
     2568                                    or iCheckType eq ?
     2569                                 then       ""
     2570                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2571      vHQry:query-open().
     2572      vHQry:get-first().
     2573      QRY-BLOCK:
     2574      repeat while not vHQry:query-off-end:
     2575         define variable vErrorOne as character no-undo.
     2576         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2577         if     vErrorOne ne ?
     2578            and vErrorOne ne ""
     2579         then do:
     2580            vi = vi + 1.
     2581            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2582                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2583                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2584         end.
     2585         vHQry:get-next().
     2586      end.
     2587      for first utd where utd.db-num eq idb-num
     2588                      and utd.doc-id eq idoc-id
     2589                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2590      no-lock,
     2591         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2592                                  and utd-marking-lines.doc-id eq idoc-id
     2593                                  and utd-marking-lines.doc-level eq 1
     2594      no-lock,
     2595         first marking where marking.mark eq utd-marking-lines.mark
     2596                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2597      no-lock:
     2598         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2599         if     vErrorOne ne ?
     2600            and vErrorOne ne ""
     2601         then do:
     2602            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2603                            + '","ОбъектОш":"' + marking.mark
     2604                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2605         end.
     2606      end.
     2607      if vError ne ""
     2608      then
     2609         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2610      return oError.
     2611   end.
     2612   function GetErrJsonForUtdReturn returns character
     2613   (idb-num         as integer ,
     2614    idoc-id         as integer ,
     2615    iCheckType      as character
     2616    ):
     2617      define buffer utd-err for utd-err.
     2618      define variable vHQry as handle no-undo.
     2619      define variable vError as longchar no-undo.
     2620      define variable oError as character no-undo.
     2621      define variable vi as integer no-undo.
     2622      create query vHQry.
     2623      vHQry:set-buffers(buffer utd-err:handle).
     2624      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2625                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2626                               + if    iCheckType eq "*"
     2627                                    or iCheckType eq ?
     2628                                 then       ""
     2629                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2630      vHQry:query-open().
     2631      vHQry:get-first().
     2632      QRY-BLOCK:
     2633      repeat while not vHQry:query-off-end:
     2634         define variable vErrorOne as character no-undo.
     2635         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2636         if     vErrorOne ne ?
     2637            and vErrorOne ne ""
     2638         then do:
     2639            vi = vi + 1.
     2640            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2641                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2642                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2643         end.
     2644         vHQry:get-next().
     2645      end.
     2646      if vError ne ""
     2647      then
     2648         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2649      return oError.
     2650   end.
     2651   function GetCodeTextError returns character
     2652   (iCheckType as character,
     2653    iCodeErr   as character,
     2654    iChechObj  as character,
     2655    output oCode as character,
     2656    output ovalue as character ):
     2657      define buffer code    for code.
     2658      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2659                        and code.code   eq iCodeErr
     2660      no-lock no-error.
     2661      if     available code
     2662      then do:
     2663         define variable vi as integer no-undo init ?.
     2664         vi = int(Code.misc3) no-error.
     2665         if    code.misc3 ne "error"
     2666            and vi ne 0
     2667         then
     2668            oCode = ?.
     2669         else if     Code.misc1 ne ?
     2670                 and Code.misc1 ne ""
     2671         then
     2672            assign
     2673               oCode  = GetMesError(Code.misc1,iChechObj)
     2674               ovalue = GetMesError(Code.misc2,iChechObj)
     2675            .
     2676      end.
     2677      return if oCode eq ""
     2678             then ""
     2679             else (oCode + "_" + ovalue).
     2680   end.
     2681   define temp-table TT-err no-undo
     2682     field code_ as character
     2683     field text_ as character
     2684   index code_ code_.
     2685   function GetErrTxtForUtd returns character
     2686   (idb-num         as integer ,
     2687    idoc-id         as integer ,
     2688    iCheckType      as character
     2689    ):
     2690      define buffer utd-err for utd-err.
     2691      define variable vHQry as handle no-undo.
     2692      define variable oError as character no-undo.
     2693      create query vHQry.
     2694      define variable vi as integer no-undo.
     2695      for each tt-err :
     2696         delete tt-err.
     2697      end.
     2698      vHQry:set-buffers(buffer utd-err:handle).
     2699      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2700                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2701                               + if    iCheckType eq "*"
     2702                                    or iCheckType eq ?
     2703                                 then       ""
     2704                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2705      vHQry:query-open().
     2706      vHQry:get-first().
     2707      define variable vcode as character no-undo.
     2708      define variable vvalue as character no-undo.
     2709      QRY-BLOCK:
     2710      repeat while not vHQry:query-off-end:
     2711         vi = vi + 1.
     2712         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2713         if vcode ne ?
     2714         then do:
     2715            find first tt-err where tt-err.code eq vcode
     2716            no-error.
     2717            if not available tt-err
     2718            then do:
     2719               create tt-err.
     2720               assign
     2721                  tt-err.code_ = vcode
     2722                  tt-err.text_ = vvalue
     2723               .
     2724            end.
     2725            else
     2726               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2727         end.
     2728         vHQry:get-next().
     2729      end.
     2730     find first utd where utd.db-num eq idb-num
     2731                         and utd.doc-id eq idoc-id
     2732         no-lock.
     2733      define buffer cancel_utd-lines for utd-lines.
     2734      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2735                                  and cancel_utd-lines.doc-id eq idoc-id
     2736      no-lock:
     2737         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2738         then do:
     2739            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2740                                        and utd-marking-lines.doc-id eq idoc-id
     2741                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2742            no-lock,
     2743               first marking where marking.mark eq utd-marking-lines.mark
     2744                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2745            no-lock:
     2746               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2747               find first tt-err where tt-err.code eq vcode
     2748               no-error.
     2749               if not available tt-err
     2750               then do:
     2751                  create tt-err.
     2752                  assign
     2753                     tt-err.code_ = vcode
     2754                     tt-err.text_ = vvalue
     2755                  .
     2756               end.
     2757               else
     2758                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2759            end.
     2760         end.
     2761         else do:
     2762            define variable vqnty as decimal no-undo.
     2763            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2764            if vqnty eq ? then vqnty = 0.
     2765            if vqnty ne cancel_utd-lines.Quantity
     2766            then do:
     2767               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2768               find first tt-err where tt-err.code eq vcode
     2769               no-error.
     2770               if not available tt-err
     2771               then do:
     2772                  create tt-err.
     2773                  assign
     2774                     tt-err.code_ = vcode
     2775                     tt-err.text_ = vvalue
     2776                  .
     2777               end.
     2778               else
     2779                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2780            end.
     2781         end.
     2782      end.
     2783      for each tt-err:
     2784         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2785      end.
     2786      return oError.
     2787   end.
     2788   define variable mFormatErr as character no-undo init "text".
     2789   function GetErrForUtd returns character
     2790   (idb-num         as integer ,
     2791    idoc-id         as integer ,
     2792    iType           as character
     2793    ):
     2794      if mFormatErr eq "text"
     2795      then
     2796         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2797      else do:
     2798         if itype eq "return"
     2799         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2800         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2801      end.
     2802   end.
     2803   function GetErrComText returns longchar
     2804   (icomment as character,
     2805    itext    as longchar ):
     2806       define variable vText as longchar no-undo.
     2807      if mFormatErr eq "text"
     2808      then do:
     2809         if icomment ne ""
     2810         then
     2811            icomment = substitute("comment:|&1|",icomment).
     2812         vText = icomment + itext.
     2813      end.
     2814      else do:
     2815         icomment = if icomment begins  '"'
     2816                    then icomment
     2817                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2818         vText = icomment + "," + itext.
     2819         vText = "~{" + trim(vText,",") + "~}".
     2820      end.
     2821      return vText.
     2822   end.
     2823   function CheckTypeForMarkLineType returns logical
     2824   (iObj            as handle,
     2825    iCheckType      as character,
     2826    iCodeErr        as character ,
     2827    iTypeErr        as character ):
     2828      define variable vRecKey-markLine as character no-undo.
     2829      define variable vGoodMark        as logical no-undo.
     2830      define variable vdb-num          as integer no-undo.
     2831      define variable vdoc-id          as integer no-undo.
     2832      define variable vlinenum         as integer no-undo.
     2833      define variable vErrorOne as character no-undo.
     2834      define buffer buf_utd-err for utd-err.
     2835      run gen-key-rec (input "utd-marking-lines",
     2836                       input  iObj,
     2837                       output vRecKey-markLine).
     2838      vGoodMark = yes.
     2839      vdb-num = iObj::db-num.
     2840      vdoc-id = iObj::doc-id.
     2841      vlinenum = iObj::linenum.
     2842      block-mark-err:
     2843      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2844                               and buf_utd-err.db-num = vdb-num
     2845                               and buf_utd-err.reckey = vRecKey-markLine
     2846                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2847                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2848      no-lock:
     2849         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2850         if     vErrorOne ne ?
     2851            and vErrorOne ne ""
     2852         then do:
     2853            vGoodMark = no.
     2854            leave block-mark-err.
     2855         end.
     2856      end.
     2857      return not vGoodMark.
     2858   end.
     2859   function CheckErrForMarkLineType returns logical
     2860   (iObj            as handle,
     2861    iType           as character  ):
     2862      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2863   end.
     2864   function CheckErrForMarkLine returns logical
     2865   (iObj            as handle):
     2866      return CheckErrForMarkLineType(iObj,"*").
     2867   end.
     2868   function CheckErrForLineTypeCode returns logical
     2869   (iObj                 as handle,
     2870    iCheckType           as character,
     2871    iCodeErr             as character,
     2872    iTypeErr             as character,
     2873    iOneErr              as logical):
     2874      define variable vRecKey-line     as character no-undo.
     2875      define buffer buf_utd-err for utd-err.
     2876      define variable vUtdlineError as logical no-undo.
     2877      define variable vErrorOne as character no-undo.
     2878            run gen-key-rec (input "utd-lines",
     2879                             input  iObj,
     2880                             output vRecKey-line).
     2881         define variable vdb-num as integer no-undo.
     2882         define variable vdoc-id as integer no-undo.
     2883         define variable vlinenum as integer no-undo.
     2884         vdb-num = iObj::db-num.
     2885         vdoc-id = iObj::doc-id.
     2886         vlinenum = iObj::linenum.
     2887         block-err:
     2888         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2889                                  and buf_utd-err.db-num = vdb-num
     2890                                  and buf_utd-err.reckey = vRecKey-line
     2891                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2892                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2893         no-lock:
     2894            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2895            if     vErrorOne ne ?
     2896               and vErrorOne ne ""
     2897            then do:
     2898               vUtdlineError = yes.
     2899               leave block-err.
     2900            end.
     2901         end.
     2902         if  not vUtdlineError
     2903         then do:
     2904            define variable vGoodMark as logical no-undo.
     2905            vGoodMark = yes.
     2906            block-line-err:
     2907            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2908                                         and utd-marking-lines.doc-id  eq vdoc-id
     2909                                         and utd-marking-lines.LineNum eq vLineNum
     2910            no-lock:
     2911               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2912               if     vGoodMark
     2913                  and iOneErr eq no
     2914               then
     2915                  leave block-line-err.
     2916               if     iOneErr = yes
     2917                  and not vGoodMark
     2918               then
     2919                  leave block-line-err.
     2920            end.
     2921            vUtdlineError = not vGoodMark.
     2922         end.
     2923      return vUtdlineError.
     2924   end.
     2925   function getErrForLineType returns character
     2926   (iObj            as handle,
     2927    iType           as character  ):
     2928      define variable vRecKey-line     as character no-undo.
     2929      define buffer buf_utd-err for utd-err.
     2930      define variable vUtdlineError as logical no-undo.
     2931      define variable vErrorOne as character no-undo.
     2932      define variable oError as character no-undo.
     2933            run gen-key-rec (input "utd-lines",
     2934                             input  iObj,
     2935                             output vRecKey-line).
     2936         define variable vdb-num as integer no-undo.
     2937         define variable vdoc-id as integer no-undo.
     2938         define variable vlinenum as integer no-undo.
     2939         vdb-num = iObj::db-num.
     2940         vdoc-id = iObj::doc-id.
     2941         vlinenum = iObj::linenum.
     2942         block-err:
     2943         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2944                                  and buf_utd-err.db-num = vdb-num
     2945                                  and buf_utd-err.reckey = vRecKey-line
     2946                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2947         no-lock:
     2948            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2949            if     vErrorOne ne ?
     2950               and vErrorOne ne ""
     2951            then do:
     2952               oError = oError + vErrorOne + " ".
     2953            end.
     2954         end.
     2955      return oError.
     2956   end.
     2957   function CheckErrForLineType returns logical
     2958   (iObj            as handle,
     2959    iType           as character  ):
     2960       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2961   end.
     2962   function CheckErrForLine returns logical
     2963   (iObj            as handle):
     2964      return CheckErrForLineType(iobj,"*").
     2965   end.
     2966   function CheckErrForUtd returns logical
     2967   (idb-num         as integer ,
     2968    idoc-id         as integer ):
     2969      for each utd-lines where utd-lines.db-num eq idb-num
     2970                           and utd-lines.doc-id eq idoc-id
     2971      no-lock :
     2972         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2973         then
     2974            return no.
     2975      end.
     2976      return yes.
     2977   end.
     2978   function CheckMarkUtd-28rel return logical
     2979    (input idb-num as integer,
     2980    input idoc-id as integer):
     2981    define buffer utd                   for utd.
     2982    define buffer utd-lines             for utd-lines.
     2983    define buffer utd-marking-lines     for utd-marking-lines.
     2984    define variable v-par-type as character no-undo.
     2985    define variable vgdsNoMark as logical no-undo.
     2986    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2987      define variable v-par-val  as character no-undo.
     2988      find first utd where utd.db-num eq idb-num
     2989                       and utd.doc-id eq idoc-id
     2990      no-lock no-error.
     2991      if available utd
     2992      then do:
     2993         if     utd.obj-code ne ?
     2994            and utd.obj-type ne ?
     2995         then do:
     2996            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2997            Block-utd-lines:
     2998            for each utd-lines where utd-lines.db-num eq idb-num
     2999                                 and utd-lines.doc-id eq idoc-id
     3000            no-lock:
     3001               if     utd-lines.gds-code ne ?
     3002                  and utd-lines.gds-code ne 0
     3003               then do:
     3004                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3005                       ( utd-lines.gds-code,
     3006                         'mark-type':U,
     3007                          output v-par-val,
     3008                          output v-par-type
     3009                       ).
     3010                  if     EDOParSec:IsEdo
     3011                     and EDOParSec:GetIsEDOForType(v-par-val)
     3012                  then do:
     3013                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3014                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3015                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3016                                                    and length(utd-marking-lines.mark) > 13
     3017                     no-lock no-error.
     3018                     if     avail utd-marking-lines
     3019                        and not CheckErrForLine(buffer utd-lines:handle)
     3020                     then
     3021                        leave Block-utd-lines.
     3022                  end.
     3023                  else
     3024                     vgdsNoMark = yes.
     3025               end.
     3026            end.
     3027            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3028            if vgdsNoMark then return available utd-lines . else return yes .
     3029         end.
     3030      end.
     3031      return yes.
     3032   end.
     3033   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3034   define input parameter pDb-num as integer no-undo .
     3035   define input parameter pDoc-id as integer no-undo .
     3036   define buffer buf_utd for ub.utd .
     3037   define buffer buf2_utd for ub.utd .
     3038   define buffer buf_marking for ub.marking .
     3039   define buffer new_marking for ub.marking .
     3040   define buffer buf_marking-childs for ub.marking .
     3041   define buffer buf_marking-lines for ub.marking-lines .
     3042   define buffer buf_marking-lines-childs for ub.marking-lines .
     3043   define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     3044   define buffer buf_goods for ub.goods .
     3045   define buffer buf_parts for ub.parts .
     3046   define buffer buf_cash-desk for ub.cash-desk .
     3047   define buffer buf_trn-doc for ub.trn-doc .
     3048   define buffer buf_doc-line for ub.doc-line .
     3049   define buffer buf_gds-dtl for ub.gds-dtl .
     3050   define buffer buf_chk-doc for ub.chk-doc .
     3051   define buffer buf_marking-chk for ub.marking-chk .
     3052   define temp-table tt-utd-marking-lines like ub.utd-marking-lines .
     3053   define buffer buf_utd-marking-lines-childs for tt-utd-marking-lines .
     3054   define buffer buf_utd-lines for ub.utd-lines .
     3055   define buffer buf_utd-lines-attr for ub.utd-lines-attr .
     3056   define temp-table tt-mark-qnty no-undo
     3057     field gds-code  as integer
     3058     field marq-qnty as integer
     3059     field tech-qnty as integer
     3060     index pi as primary unique
     3061       gds-code
     3062   .
     3063   define temp-table tt-bad-gds no-undo
     3064     field gds-code as integer
     3065   .
     3066   define variable v-ok          as logical no-undo .
     3067   define variable v-parts-qnty  as decimal no-undo .
     3068   define variable v-marks-qnty  as integer no-undo .
     3069   define variable v-delta-qnty  as integer no-undo .
     3070   define variable v-num-childs  as integer no-undo .
     3071   define variable ii            as integer no-undo .
     3072   define variable v-err-gds       as integer no-undo .
     3073   define variable v-err-units     as integer no-undo .
     3074   define variable v-ok-packs      as integer no-undo .
     3075   define variable v-ok-units      as integer no-undo .
     3076   define variable v-created-units as integer no-undo .
     3077   define variable v-curr-cnt      as integer no-undo .
     3078   define variable v-curr-created-units as integer no-undo .
     3079   define variable MSG as character no-undo .
     3080   define variable cmd as character no-undo .
     3081   define variable v-value-character as character no-undo .
     3082   define variable v-value-date as date no-undo .
     3083   define variable v-value-decimal as decimal no-undo .
     3084   define variable v-value-integer as INTEGER no-undo .
     3085   define variable v-value-logical AS LOGICAL no-undo .
     3086   define variable v-param-type as character no-undo .
     3087   define variable v-param-value as character no-undo .
     3088   define variable v-mark-type as character no-undo .
     3089   define variable v-tth     as handle no-undo .
     3090   define variable conf-par as character no-undo .
     3091   define variable par-type as character no-undo .
     3092   define variable v-1C     as logical   no-undo .
     3093   define temp-table tt-gds-list
     3094     field gds-code as integer
     3095   .
     3096   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3097     (input  'is-erpRN'
     3098     ,input  0
     3099     ,input  ''
     3100     ,input  0
     3101     ,input  ''
     3102     ,input  ''
     3103     ,input  ''
     3104     ,input  NO
     3105     ,output conf-par
     3106     ,output par-type
     3107     ) no-error .
     3108     IF not error-status:error and conf-par = "yes":U
     3109     then do:
     3110       v-1C = true .
     3111     end .
     3112     else do :
     3113       v-1C = false .
     3114     end .
     3115     assign v-ok = true .
     3116     find first buf_utd no-lock where buf_utd.db-num = pDb-num
     3117                                  and buf_utd.doc-id = pDoc-id
     3118                                  no-error .
     3119     if not available buf_utd
     3120     then do :
     3121       MSG = "Не найден УПД в БД " + string(pDb-num) + " c doc-id " + string(pDoc-id) .
     3122       return error MSG .
     3123     end.
     3124     assign
     3125       v-err-gds       = 0
     3126       v-err-units     = 0
     3127       v-ok-packs      = 0
     3128       v-ok-units      = 0
     3129       v-created-units = 0
     3130     .
     3131     for each buf_utd-lines no-lock where buf_utd-lines.db-num = pDb-num
     3132                                      and buf_utd-lines.doc-id = pDoc-id
     3133                                      :
     3134       find first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num   = buf_utd-lines.db-num
     3135                                                  and buf_utd-marking-lines.doc-id   = buf_utd-lines.doc-id
     3136                                                  and buf_utd-marking-lines.LineNum  = buf_utd-lines.LineNum
     3137                                                  and buf_utd-marking-lines.gds-code = buf_utd-lines.gds-code
     3138                                                  no-error .
     3139       if not available buf_utd-marking-lines
     3140       then do :
     3141         find first buf_utd-lines-attr no-lock where buf_utd-lines-attr.db-num    = buf_utd-lines.db-num
     3142                                                 and buf_utd-lines-attr.doc-id    = buf_utd-lines.doc-id
     3143                                                 and buf_utd-lines-attr.LineNum   = buf_utd-lines.LineNum
     3144                                                 and buf_utd-lines-attr.attr-code = "NoMarking"
     3145                                                 no-error .
     3146         if available buf_utd-lines-attr
     3147         and buf_utd-lines-attr.attr-value > ""
     3148         then do :
     3149           find first tt-mark-qnty exclusive-lock where tt-mark-qnty.gds-code  = buf_utd-lines.gds-code no-error .
     3150           if not available tt-mark-qnty
     3151           then do :
     3152             create tt-mark-qnty .
     3153             assign
     3154               tt-mark-qnty.gds-code  = buf_utd-lines.gds-code
     3155               tt-mark-qnty.tech-qnty = integer(buf_utd-lines-attr.attr-value)
     3156             no-error .
     3157             if error-status:error
     3158             then do :
     3159               delete tt-mark-qnty .
     3160               v-err-gds = v-err-gds + 1 .
     3161             end .
     3162           end.
     3163         end .
     3164         else do :
     3165           v-err-gds = v-err-gds + 1 .
     3166         end .
     3167       end .
     3168     end .
     3169     empty temp-table tt-utd-marking-lines .
     3170     for each buf_utd-marking-lines no-lock where  buf_utd-marking-lines.db-num = pDb-num
     3171                                               and buf_utd-marking-lines.doc-id = pDoc-id :
     3172       create tt-utd-marking-lines .
     3173       buffer-copy buf_utd-marking-lines to tt-utd-marking-lines .
     3174       find first tt-gds-list where tt-gds-list.gds-code = tt-utd-marking-lines.gds-code no-error.
     3175       if not available tt-gds-list
     3176       then do :
     3177         create tt-gds-list .
     3178         assign
     3179           tt-gds-list.gds-code = tt-utd-marking-lines.gds-code
     3180         .
     3181       end .
     3182     end .
     3183     for each buf2_utd no-lock where buf2_utd.obj-type = buf_utd.obj-type
     3184                                 and buf2_utd.obj-code = buf_utd.obj-code
     3185                                 and buf2_utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     3186                                 and buf2_utd.sts = objSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB
     3187                                 and buf2_utd.LoadDate >= buf_utd.LoadDate
     3188                                 :
     3189       if buf2_utd.LoadDate = buf_utd.LoadDate
     3190       and buf2_utd.LoadTime <= buf_utd.LoadTime
     3191       then next .
     3192       for each buf_utd-marking-lines no-lock where  buf_utd-marking-lines.db-num = buf2_utd.db-num
     3193                                                 and buf_utd-marking-lines.doc-id = buf2_utd.doc-id :
     3194         find first tt-gds-list where tt-gds-list.gds-code = buf_utd-marking-lines.gds-code no-error.
     3195         if not available tt-gds-list then next .
     3196         create tt-utd-marking-lines .
     3197         buffer-copy buf_utd-marking-lines to tt-utd-marking-lines .
     3198       end .
     3199     end .
     3200     check_ :
     3201     for each tt-utd-marking-lines no-lock,
     3202     first buf_marking no-lock where buf_marking.mark = tt-utd-marking-lines.mark :
     3203       if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     3204       then do :
     3205         delete tt-utd-marking-lines .
     3206         next check_ .
     3207       end .
     3208       find first buf_marking-chk no-lock where buf_marking-chk.mark begins buf_marking.mark no-error .
     3209       if available buf_marking-chk
     3210       then do :
     3211         find first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     3212                                          and buf_chk-doc.chk-date >= buf_utd.LoadDate
     3213                                          no-error .
     3214         if available buf_chk-doc
     3215         then do :
     3216           if buf_chk-doc.chk-date = buf_utd.LoadDate
     3217           and buf_chk-doc.chk-time <= buf_utd.LoadTime
     3218           then .
     3219           else do :
     3220             find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_chk-doc.out-code
     3221                                              and buf_trn-doc.status_ = 'факт':U
     3222                                              no-error .
     3223             if available buf_trn-doc
     3224             then do :
     3225               delete tt-utd-marking-lines .
     3226               find first ub.marking exclusive-lock where rowid(ub.marking) = rowid(buf_marking) .
     3227               ub.marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB .
     3228               release ub.marking .
     3229               next check_ .
     3230             end .
     3231             else do :
     3232               find first buf_goods no-lock where buf_goods.gds-code     = buf_marking.gds-code .
     3233               for each buf_gds-dtl no-lock where buf_gds-dtl.doc-code   = buf_chk-doc.out-code
     3234                                              and buf_gds-dtl.artic      = buf_goods.artic
     3235                                              and buf_gds-dtl.prod-type  = buf_goods.prod-type
     3236                                              and buf_gds-dtl.prod-code  = buf_goods.prod-code
     3237                                              :
     3238                 if buf_gds-dtl.doc-qnty = buf_gds-dtl.fact-qnty
     3239                 then do :
     3240                   message "Закройте все зарезервированные продажи!" view-as alert-box .
     3241                   return error .
     3242                 end .
     3243               end .
     3244             end .
     3245           end .
     3246         end .
     3247       end .
     3248       if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3249       and buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3250       and buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     3251       and buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB
     3252       then do :
     3253         assign v-ok = false .
     3254         MSG = "Марка " + buf_marking.mark + " в статусе " + objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts) .
     3255         message MSG view-as alert-box .
     3256         return error MSG .
     3257       end .
     3258       if buf_marking.loc-key <> ""
     3259       then do :
     3260         assign v-ok = false .
     3261       end .
     3262       if buf_marking.unit-ext = "LEVEL1"
     3263       then do :
     3264         if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     3265         then do :
     3266           assign v-ok = false .
     3267           find first tt-bad-gds where tt-bad-gds.gds-code = buf_marking.gds-code no-error .
     3268           if not available tt-bad-gds
     3269           then do :
     3270             create tt-bad-gds.
     3271             assign tt-bad-gds.gds-code = buf_marking.gds-code .
     3272           end .
     3273           AddUtdErr(input buf_utd.db-num,
     3274                     input buf_utd.doc-id,
     3275                     input buffer buf_marking:handle,
     3276                     input "FirstInput",
     3277                     input "GrayZone",
     3278                     input (buf_marking.mark + chr(4) + " блок в серой зоне (нет полной информации по его пачкам)")).
     3279         end .
     3280         else do :
     3281           find first buf_marking-childs no-lock where buf_marking-childs.mark-parent = buf_marking.mark no-error .
     3282           if not available buf_marking-childs
     3283           then do :
     3284             assign v-ok = false .
     3285             find first tt-bad-gds where tt-bad-gds.gds-code = buf_marking.gds-code no-error .
     3286             if not available tt-bad-gds
     3287             then do :
     3288               create tt-bad-gds.
     3289               assign tt-bad-gds.gds-code = buf_marking.gds-code .
     3290             end .
     3291             AddUtdErr(input buf_utd.db-num,
     3292                       input buf_utd.doc-id,
     3293                       input buffer buf_marking:handle,
     3294                       input "FirstInput",
     3295                       input "Level1Empty",
     3296                       input (buf_marking.mark + chr(4) + "для этого блока в базе нет марок пачек")).
     3297           end .
     3298         end .
     3299         next .
     3300       end .
     3301       find first tt-mark-qnty exclusive-lock where tt-mark-qnty.gds-code  = buf_marking.gds-code no-error .
     3302       if not available tt-mark-qnty
     3303       then do :
     3304         create tt-mark-qnty .
     3305         assign
     3306           tt-mark-qnty.gds-code  = buf_marking.gds-code
     3307           tt-mark-qnty.tech-qnty = 0
     3308         .
     3309         for first buf_utd-lines no-lock where buf_utd-lines.db-num    = buf_utd.db-num
     3310                                           and buf_utd-lines.doc-id    = buf_utd.doc-id
     3311                                           and buf_utd-lines.gds-code  = tt-mark-qnty.gds-code,
     3312         first buf_utd-lines-attr no-lock where buf_utd-lines-attr.db-num    = buf_utd-lines.db-num
     3313                                            and buf_utd-lines-attr.doc-id    = buf_utd-lines.doc-id
     3314                                            and buf_utd-lines-attr.LineNum   = buf_utd-lines.LineNum
     3315                                            and buf_utd-lines-attr.attr-code = "NoMarking"
     3316                                            :
     3317           assign
     3318             tt-mark-qnty.tech-qnty = integer(buf_utd-lines-attr.attr-value)
     3319           no-error .
     3320         end .
     3321       end .
     3322       if buf_marking.unit-ext = "UNIT"
     3323       then
     3324       assign tt-mark-qnty.marq-qnty = tt-mark-qnty.marq-qnty + 1 .
     3325     end .
     3326     for each tt-mark-qnty no-lock :
     3327       find first tt-bad-gds where tt-bad-gds.gds-code = tt-mark-qnty.gds-code no-error .
     3328       if available tt-bad-gds
     3329       then do :
     3330         v-err-gds = v-err-gds + 1 .
     3331         next .
     3332       end .
     3333       assign
     3334         v-parts-qnty = 0
     3335         v-curr-created-units = 0
     3336       .
     3337       find first buf_goods no-lock where buf_goods.gds-code = tt-mark-qnty.gds-code .
     3338       for each buf_parts no-lock where buf_parts.obj-type   = buf_utd.obj-type
     3339                                    and buf_parts.obj-code   = buf_utd.obj-code
     3340                                    and buf_parts.artic      = buf_goods.artic
     3341                                    and buf_parts.prod-type  = buf_goods.prod-type
     3342                                    and buf_parts.prod-code  = buf_goods.prod-code
     3343                                    and buf_parts.out-code   = 'free-zone':U
     3344                                    :
     3345         assign v-parts-qnty = v-parts-qnty + buf_parts.qnty .
     3346         for each buf_marking-lines no-lock where buf_marking-lines.obj-type   = buf_parts.obj-type
     3347                                              and buf_marking-lines.obj-code   = buf_parts.obj-code
     3348                                              and buf_marking-lines.gds-code   = buf_goods.gds-code
     3349                                              and buf_marking-lines.in-code    = buf_parts.in-code
     3350                                              and buf_marking-lines.out-code   = buf_parts.out-code
     3351                                              and buf_marking-lines.part-code  = buf_parts.part-code,
     3352         first buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark
     3353                                     and buf_marking.unit-ext = "UNIT"
     3354                                     :
     3355           assign v-parts-qnty = v-parts-qnty - 1 .
     3356         end .
     3357       end .
     3358       assign v-marks-qnty = tt-mark-qnty.marq-qnty .
     3359       assign v-delta-qnty = v-parts-qnty - v-marks-qnty .
     3360       if v-delta-qnty <> tt-mark-qnty.tech-qnty
     3361       then do :
     3362         AddUtdErr(input buf_utd.db-num,
     3363                   input buf_utd.doc-id,
     3364                   input buffer buf_goods:handle,
     3365                   input "FirstInput",
     3366                   input "QntyErr",
     3367                   input string(buf_goods.gds-code) + chr(4) +
     3368                         string(v-marks-qnty) + chr(4) +
     3369                         string(tt-mark-qnty.tech-qnty) + chr(4) +
     3370                         string(v-parts-qnty) ) .
     3371         v-err-gds = v-err-gds + 1 .
     3372         next .
     3373       end .
     3374       if v-parts-qnty > v-marks-qnty
     3375       then do :
     3376         find last ub.marking no-lock where ub.marking.mark begins ('tech_':U + string(pDb-num)) no-error .
     3377         if available ub.marking
     3378         then assign v-curr-cnt = integer(entry(3, ub.marking.mark, "_")) + 1 .
     3379         else assign v-curr-cnt = 1 .
     3380         do ii = 1 to v-delta-qnty :
     3381           create new_marking .
     3382           assign
     3383             new_marking.mark = 'tech_':U + string(pDb-num) + "_" + string(v-curr-cnt, "999999")
     3384             new_marking.sts  = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3385             new_marking.obj-type = buf_utd.obj-type
     3386             new_marking.obj-code = buf_utd.obj-code
     3387             new_marking.unit-ext = "UNIT"
     3388             new_marking.gds-code = buf_goods.gds-code
     3389             new_marking.box-qnty = 1
     3390             v-curr-cnt = v-curr-cnt + 1
     3391             v-created-units = v-created-units + 1
     3392             v-curr-created-units = v-curr-created-units + 1
     3393           .
     3394           create tt-utd-marking-lines .
     3395           assign
     3396             tt-utd-marking-lines.mark = new_marking.mark
     3397             tt-utd-marking-lines.gds-code = new_marking.gds-code
     3398             tt-utd-marking-lines.doc-level = 1
     3399           .
     3400         end .
     3401       end .
     3402       assign v-marks-qnty = v-marks-qnty + v-curr-created-units .
     3403       if v-parts-qnty <> v-marks-qnty
     3404       then do :
     3405         AddUtdErr(input buf_utd.db-num,
     3406                   input buf_utd.doc-id,
     3407                   input buffer buf_goods:handle,
     3408                   input "FirstInput",
     3409                   input "QntyErr",
     3410                   input string(buf_goods.gds-code) + chr(4) +
     3411                         string(v-marks-qnty) + chr(4) +
     3412                         string(tt-mark-qnty.tech-qnty) + chr(4) +
     3413                         string(v-parts-qnty) ) .
     3414         v-err-gds = v-err-gds + 1 .
     3415         next .
     3416       end .
     3417       else do :
     3418         allocation_ :
     3419         for each buf_parts no-lock where buf_parts.obj-type   = buf_utd.obj-type
     3420                                      and buf_parts.obj-code   = buf_utd.obj-code
     3421                                      and buf_parts.artic      = buf_goods.artic
     3422                                      and buf_parts.prod-type  = buf_goods.prod-type
     3423                                      and buf_parts.prod-code  = buf_goods.prod-code
     3424                                      and buf_parts.out-code   = 'free-zone':U
     3425                                      :
     3426           assign
     3427             v-parts-qnty = buf_parts.qnty
     3428           .
     3429           for each buf_marking-lines no-lock where buf_marking-lines.obj-type   = buf_parts.obj-type
     3430                                                and buf_marking-lines.obj-code   = buf_parts.obj-code
     3431                                                and buf_marking-lines.gds-code   = buf_goods.gds-code
     3432                                                and buf_marking-lines.in-code    = buf_parts.in-code
     3433                                                and buf_marking-lines.out-code   = buf_parts.out-code
     3434                                                and buf_marking-lines.part-code  = buf_parts.part-code,
     3435           first buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark
     3436                                       and buf_marking.unit-ext = "UNIT"
     3437                                       :
     3438             assign v-parts-qnty = v-parts-qnty - 1 .
     3439           end .
     3440           for each tt-utd-marking-lines exclusive-lock where tt-utd-marking-lines.gds-code = buf_goods.gds-code
     3441                                                          and tt-utd-marking-lines.doc-level = 1 ,
     3442           first buf_marking exclusive-lock where buf_marking.mark = tt-utd-marking-lines.mark
     3443                                              break by buf_marking.unit-ext
     3444                                              :
     3445             find first buf_marking-lines no-lock where buf_marking-lines.gds-code    = tt-utd-marking-lines.gds-code
     3446                                                    and buf_marking-lines.mark        = tt-utd-marking-lines.mark
     3447                                                    and buf_marking-lines.obj-type    = buf_utd.obj-type
     3448                                                    and buf_marking-lines.obj-code    = buf_utd.obj-code
     3449                                                    and buf_marking-lines.in-code     = buf_parts.in-code
     3450                                                    and buf_marking-lines.out-code    = buf_parts.out-code
     3451                                                    and buf_marking-lines.part-code   = buf_parts.part-code
     3452                                                    no-error .
     3453             if not available buf_marking-lines
     3454             then do :
     3455               if v-parts-qnty < 10
     3456               and buf_marking.unit-ext = "LEVEL1"
     3457               then do :
     3458                 assign
     3459                   buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3460                 .
     3461                 AddUtdErr(input buf_utd.db-num,
     3462                           input buf_utd.doc-id,
     3463                           input buffer buf_marking:handle,
     3464                           input "FirstInput",
     3465                           input "Level1FreeErr",
     3466                           input (buf_marking.mark + chr(4) + "пачки этого блока распределились в разные партии")).
     3467               end .
     3468               else do :
     3469                 if buf_marking.sts <> ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3470                 or buf_marking.unit-ext = "UNIT"
     3471                 then do :
     3472                   if not (buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and buf_marking.unit-ext = "LEVEL1")
     3473                   then do :
     3474                     create buf_marking-lines .
     3475                     assign
     3476                       buf_marking-lines.gds-code    = tt-utd-marking-lines.gds-code
     3477                       buf_marking-lines.mark        = tt-utd-marking-lines.mark
     3478                       buf_marking-lines.obj-type    = buf_utd.obj-type
     3479                       buf_marking-lines.obj-code    = buf_utd.obj-code
     3480                       buf_marking-lines.in-code     = buf_parts.in-code
     3481                       buf_marking-lines.out-code    = buf_parts.out-code
     3482                       buf_marking-lines.part-code   = buf_parts.part-code
     3483                       buf_marking-lines.doc-level   = tt-utd-marking-lines.doc-level
     3484                     .
     3485                     if not v-1C
     3486                     then do :
     3487                       run str/callnews.p (  input 'marking-lines':U
     3488                                            ,input (buffer buf_marking-lines:handle )
     3489                                           ) no-error .
     3490                     end .
     3491                   end.
     3492                 end .
     3493               end .
     3494             end .
     3495             if buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3496             then do :
     3497               assign
     3498                 buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     3499                 buf_marking.loc-key = ""
     3500               .
     3501             end .
     3502             else do :
     3503               assign
     3504                 buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3505               .
     3506             end .
     3507             if v-1C
     3508             then do :
     3509             end .
     3510             else do :
     3511               run str/callnews.p (  input 'marking':U
     3512                                    ,input (buffer buf_marking:handle )
     3513                                   ) no-error .
     3514             end .
     3515             if buf_marking.unit-ext = "LEVEL1"
     3516             then do :
     3517               assign v-num-childs = 0 .
     3518               for each buf_marking-childs no-lock where buf_marking-childs.mark-parent = buf_marking.mark,
     3519               first buf_utd-marking-lines-childs no-lock where buf_utd-marking-lines-childs.gds-code = buf_goods.gds-code
     3520                                                            and buf_utd-marking-lines-childs.mark = buf_marking-childs.mark
     3521                                                            :
     3522                 assign v-num-childs = v-num-childs + 1 .
     3523               end .
     3524               for each buf_marking-childs exclusive-lock where buf_marking-childs.mark-parent = buf_marking.mark,
     3525               first buf_utd-marking-lines-childs exclusive-lock where buf_utd-marking-lines-childs.gds-code = buf_goods.gds-code
     3526                                                                   and buf_utd-marking-lines-childs.mark = buf_marking-childs.mark
     3527                                                                   :
     3528                 find first buf_marking-lines-childs no-lock where buf_marking-lines-childs.gds-code    = buf_utd-marking-lines-childs.gds-code
     3529                                                               and buf_marking-lines-childs.mark        = buf_utd-marking-lines-childs.mark
     3530                                                               and buf_marking-lines-childs.obj-type    = buf_utd.obj-type
     3531                                                               and buf_marking-lines-childs.obj-code    = buf_utd.obj-code
     3532                                                               and buf_marking-lines-childs.in-code     = buf_parts.in-code
     3533                                                               and buf_marking-lines-childs.out-code    = buf_parts.out-code
     3534                                                               and buf_marking-lines-childs.part-code   = buf_parts.part-code
     3535                                                               and buf_marking-lines-childs.prt-code    = buf_parts.prt-code
     3536                                                               no-error .
     3537                 if not available buf_marking-lines-childs
     3538                 then do :
     3539                   create buf_marking-lines-childs .
     3540                   assign
     3541                     buf_marking-lines-childs.gds-code    = buf_utd-marking-lines-childs.gds-code
     3542                     buf_marking-lines-childs.mark        = buf_utd-marking-lines-childs.mark
     3543                     buf_marking-lines-childs.obj-type    = buf_utd.obj-type
     3544                     buf_marking-lines-childs.obj-code    = buf_utd.obj-code
     3545                     buf_marking-lines-childs.in-code     = buf_parts.in-code
     3546                     buf_marking-lines-childs.out-code    = buf_parts.out-code
     3547                     buf_marking-lines-childs.part-code   = buf_parts.part-code
     3548                     buf_marking-lines-childs.prt-code    = buf_parts.prt-code
     3549                     buf_marking-lines-childs.doc-level   = buf_utd-marking-lines-childs.doc-level
     3550                   .
     3551                   if not v-1C
     3552                   then do :
     3553                     run str/callnews.p (  input 'marking-lines':U
     3554                                          ,input (buffer buf_marking-lines-childs:handle )
     3555                                         ) no-error .
     3556                   end .
     3557                 end .
     3558                 if buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3559                 then do :
     3560                   assign buf_marking-lines-childs.doc-level   = 1 .
     3561                 end .
     3562                 if buf_marking-childs.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3563                 then do :
     3564                   assign
     3565                     buf_marking-childs.sts = ObjSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     3566                     buf_marking-childs.loc-key = ""
     3567                   .
     3568                 end .
     3569                 else do :
     3570                   assign
     3571                     buf_marking-childs.sts = ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3572                   .
     3573                   v-err-units = v-err-units + 1 .
     3574                 end .
     3575                 if v-1C
     3576                 then do :
     3577                 end .
     3578                 else do :
     3579                   run str/callnews.p (  input 'marking':U
     3580                                        ,input (buffer buf_marking-childs:handle )
     3581                                       ) no-error .
     3582                 end .
     3583                 assign
     3584                   v-parts-qnty = v-parts-qnty - 1
     3585                   v-marks-qnty = v-marks-qnty - 1
     3586                 .
     3587                 assign v-ok-units = v-ok-units + 1 .
     3588                 delete buf_utd-marking-lines-childs no-error .
     3589                 assign v-num-childs = v-num-childs - 1 .
     3590                 if v-num-childs = 0
     3591                 then do :
     3592                   delete tt-utd-marking-lines no-error .
     3593                 end .
     3594                 if v-marks-qnty = 0 then leave allocation_ .
     3595                 if v-parts-qnty < 1 then next allocation_ .
     3596               end .
     3597               v-ok-packs = v-ok-packs + 1 .
     3598             end .
     3599             if buf_marking.unit-ext = "UNIT"
     3600             then do :
     3601               assign
     3602                 v-parts-qnty = v-parts-qnty - 1
     3603                 v-marks-qnty = v-marks-qnty - 1
     3604               .
     3605               v-ok-units = v-ok-units + 1 .
     3606               if buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3607               then
     3608                 v-err-units = v-err-units + 1 .
     3609             end .
     3610             delete tt-utd-marking-lines no-error .
     3611             if v-marks-qnty = 0 then leave allocation_ .
     3612             if v-parts-qnty < 1 then next allocation_ .
     3613           end .
     3614         end .
     3615       end .
     3616     end .
     3617     assign
     3618       v-tth      = buffer thbjattr_thbj-attr:table-handle
     3619     .
     3620     run adm/shattri.p (
     3621         input "init":U
     3622       , input buf_utd.obj-type
     3623       , input buf_utd.obj-code
     3624       , input 'marking':U
     3625       , input "":U
     3626       , output v-value-character
     3627       , output v-value-date
     3628       , output v-value-decimal
     3629       , output v-value-integer
     3630       , output v-value-logical
     3631       , output v-param-type
     3632       , input-output TABLE-HANDLE v-tth
     3633       ) no-error .
     3634     if error-status:error then do:
     3635       message
     3636       "Не удалось получить начальные значения настроек" skip
     3637       error-status:get-message(1) return-value
     3638       view-as alert-box error .
     3639       undo, return error .
     3640     end.
     3641     for each thbjattr_thbj-attr :
     3642       if thbjattr_thbj-attr.prop-code = 'marking-type':U
     3643       then do :
     3644         v-mark-type = thbjattr_thbj-attr.property-value-character.
     3645         if v-mark-type = ? then v-mark-type = "" .
     3646         if lookup (v-mark-type, "tabak") = 0
     3647         then do :
     3648           if v-mark-type = ""
     3649           then
     3650             thbjattr_thbj-attr.property-value-character = "tabak" .
     3651           else
     3652             thbjattr_thbj-attr.property-value-character = v-mark-type + ",tabak" .
     3653         end .
     3654       end .
     3655     end .
     3656     do transaction:
     3657       RUN thbjattr_set-section IN THIS-PROCEDURE (
     3658            input buf_utd.obj-type
     3659           ,input buf_utd.obj-code
     3660           ,input 'marking':U
     3661           ,INPUT table thbjattr_thbj-attr
     3662       ) NO-ERROR.
     3663       if error-status:error then do:
     3664           message "Не удалось сохранить настройки"
     3665           view-as alert-box.
     3666           undo, return error.
     3667       end.
     3668     end.
     3669     if search ("exe/POSParMark.xml") > ""
     3670     then
     3671     for each buf_cash-desk no-lock where buf_cash-desk.db-num   = buf_utd.db-num
     3672                                      and buf_cash-desk.obj-code = buf_utd.obj-code
     3673                                      and buf_cash-desk.pos-type = 'IBM-XML':U
     3674                                      and buf_cash-desk.cash-on :
     3675       assign
     3676         cmd = substitute('&1 -X POST -H "Content-Type: text/xml" -d @&2 &3 >&4'
     3677                         , search ("exe/curl.exe")
     3678                         , search ("exe/POSParMark.xml")
     3679                         , (entry(1, buf_cash-desk.addr-path, chr(4)) + '://' + entry(2, buf_cash-desk.addr-path, chr(4)))
     3680                         , "cashParResp.txt")
     3681       .
     3682       os-command silent value (cmd) .
     3683     end .
     3684     if v-err-gds > 0
     3685     then do :
     3686       message
     3687         "Ввод в оборот завершен!" skip
     3688         "Распределено " string(v-ok-units) " пачек." skip
     3689         "Из них ошибочных - " string(v-err-units) skip
     3690         "Создано " string(v-created-units) " технических марок." skip
     3691         "НЕ распределено " string(v-err-gds) " товаров."
     3692       view-as alert-box .
     3693     end .
     3694     else do :
     3695       message
     3696         "Ввод в оборот завершен!" skip
     3697         "Распределено " string(v-ok-units) " пачек." skip
     3698         "Из них ошибочных - " string(v-err-units) skip
     3699         "Создано " string(v-created-units) " технических марок." skip
     3700       view-as alert-box .
     3701     end .
