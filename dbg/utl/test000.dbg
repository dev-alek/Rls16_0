      876   RUN disable_UI.
      877   PROCEDURE disable_UI :
      878     HIDE FRAME Dialog-Frame.
      879   END PROCEDURE.
      880   PROCEDURE enable_UI :
      881     DISPLAY my-inkas F-sch
      882         WITH FRAME Dialog-Frame.
      883     ENABLE b-quit B-sch B-Help my-inkas BUTTON-1 BUTTON-2 BUTTON-3 BUTTON-4
      884            BUTTON-5 BUTTON-9 BUTTON-10 BUTTON-11 BUTTON-12 BUTTON-6 BUTTON-7
      885            BUTTON-8 BUTTON-13 BUTTON-14 F-sch
      886         WITH FRAME Dialog-Frame.
      887     VIEW FRAME Dialog-Frame.
      888   END PROCEDURE.
      889   PROCEDURE MyENable :
      890   DISPLAY my-inkas F-sch
      891         WITH FRAME Dialog-Frame.
      892     ENABLE
      893     b-quit
      894     B-sch
      895     B-Help
      896     my-inkas
      897     BUTTON-1
      898     BUTTON-2 WHEN v-curr-r-b = 'rubl':U OR v-base-code = 0
      899     BUTTON-3 WHEN v-curr-r-b = 'base':U OR v-base-code = 0
      900     BUTTON-4 WHEN v-curr-r-b = 'rubl':U OR v-base-code = 0
      901     BUTTON-5 WHEN v-curr-r-b = 'base':U OR v-base-code = 0
      902     BUTTON-9
      903     BUTTON-10
      904     BUTTON-11
      905     BUTTON-12
      906     BUTTON-6
      907     BUTTON-7 WHEN v-base-code = 0
      908     BUTTON-8
      909     BUTTON-13
      910     BUTTON-14
      911     F-sch
      912     WITH FRAME Dialog-Frame.
      913     VIEW FRAME Dialog-Frame.
      914   END PROCEDURE.
      915   PROCEDURE test0 :
      916   if not my-inkas = ? then do:
      917       IF my-inkas = "ALL" OR my-inkas = "all" then.
      918       else do:
      919           FIND FIRST ub.inkas no-lock where ub.inkas.inkas-code = my-inkas NO-ERROR.
      920           if not avail ub.inkas then do:
      921               message "Нет такой продажи!" view-as alert-box ERROR.
      922               return error.
      923           END.
      924           if test-number = 7 then do:
      925               FIND FIRST ub.shop no-lock where ub.shop.obj-code = ub.inkas.obj-code No-ERROR.
      926               FIND FIRST ub.sysconf NO-LOCK where ub.sysconf.host-code = ub.shop.host-code NO-ERROR.
      927               if NOT ub.sysconf.base-code = 0 then do:
      928                   message "Базовая валюта фирмы для продажи " my-inkas " не рубли!" skip
      929                   "Тестирование лишено смысла!" view-as alert-box.
      930                   return error.
      931               end.
      932           end.
      933       end.
      934   end.
      935   else do:
      936       if v-cntxt-obj-type = 'скл':U then do:
      937           message
      938           "Тестирование незакрытых чеков возможно только на объекте типа магазин!"
      939           view-as alert-box ERROR.
      940           return error.
      941       end.
      942       if test-number = 7 then do:
      943         FIND FIRST sysconf NO-LOCK where sysconf.host-code = v-cntxt-host-code-obj NO-ERROR.
      944         if NOT sysconf.base-code = 0 then do:
      945           message "Базовая валюта текущей фирмы не рубли!" skip
      946           "Тестирование лишено смысла!" view-as alert-box.
      947           return error.
      948         end.
      949       end.
      950   end.
      951   assign
      952   ff = 0
      953   gg = 0
      954   accum1 = 0
      955   accum2 = 0
      956   .
      957   run waitfram-show in this-procedure ("Ждите - идет обработка " ).
      958   case test-number:
      959       WHEN 1 then do:
      960          OUTPUT stream PrnLibStream to test1.txt.
      961          PUT stream PrnLibStream UNFORMATTED
      962          "ЧЕКИ С НЕРАСПОЗНАННЫМ ТОВАРОМ ПО ПРОДАЖЕ " my-inkas " Фильтр - " filter-name
      963          SKIP
      964          "НОМЕР ЧЕКА" format "X(20)" space(1)
      965          "Касса"    format "X(5)" space(1)
      966          "Чек" format "X(6)" space(1)
      967          "БАР-КОД" format "X(9)" space(1)
      968          "Ош-ка номера продажи" format "X(20)"
      969          SKIP
      970          .
      971       END.
      972       WHEN 2 then do:
      973          OUTPUT stream PrnLibStream to test2.txt.
      974          PUT stream PrnLibStream UNFORMATTED
      975          "Разница между товарной суммой по строкам и оплатам (рубли) по чеку по продаже " my-inkas " Фильтр - " filter-name skip
      976          "Номер чека"  format "X(20)" space(1)
      977          "Касса"    format "X(5)" space(1)
      978          "Чек" format "X(6)" space(1)
      979          "Товарная сумма"     format "X(19)" space(1)
      980          "Сумма оплат"  format "X(19)" space(1)
      981          "Погрешность"  format "X(19)" space(1)
      982           "Ош-ка номера продажи" format "X(20)"
      983           SKIP.
      984       END.
      985       WHEN 3 then do:
      986          OUTPUT stream PrnLibStream to test3.txt.
      987          PUT stream PrnLibStream UNFORMATTED
      988          "Разница между товарной суммой по строкам и оплатам (баз вал) по чеку по продаже " my-inkas " Фильтр - " filter-name skip
      989          "Номер чека"  format "X(20)" space(1)
      990          "Касса"    format "X(5)" space(1)
      991          "Чек" format "X(6)" space(1)
      992          "Товарная сумма"     format "X(19)" space(1)
      993          "Сумма оплат"  format "X(19)" space(1)
      994          "Погрешность"  format "X(19)" space(1)
      995          "Ош-ка номера продажи" format "X(20)"
      996           SKIP.
      997       END.
      998       WHEN 4 then do:
      999           OUTPUT stream PrnLibStream to test4.txt.
     1000           PUT stream PrnLibStream UNFORMATTED
     1001           "Разница между суммой оплат (рубли) и суммой нетто по чекам продажи " my-inkas " Фильтр - " filter-name
     1002           skip
     1003           "Номер чека"  format "X(20)" space(1)
     1004           "Касса"    format "X(5)" space(1)
     1005           "Чек" format "X(6)" space(1)
     1006           "Сумма нетто"     format "X(19)" space(1)
     1007           "Сумма оплат"  format "X(19)" space(1)
     1008           "Погрешность"  format "X(19)" space(1)
     1009          "Ош-ка номера продажи" format "X(20)"
     1010           SKIP.
     1011       END.
     1012       WHEN 5 then do:
     1013           OUTPUT stream PrnLibStream to test5.txt.
     1014           PUT stream PrnLibStream UNFORMATTED
     1015           "Разница между суммой оплат (баз вал) и суммой нетто по чекам продажи " my-inkas " Фильтр - " filter-name
     1016           skip
     1017           "Номер чека"  format "X(20)" space(1)
     1018           "Касса"    format "X(5)" space(1)
     1019           "Чек" format "X(6)" space(1)
     1020           "Сумма нетто"     format "X(19)" space(1)
     1021           "Сумма оплат"  format "X(19)" space(1)
     1022           "Погрешность"  format "X(19)" space(1)
     1023          "Ош-ка номера продажи" format "X(20)"
     1024           SKIP.
     1025       END.
     1026       WHEN 6 then do:
     1027           OUTPUT stream PrnLibStream to test6.txt.
     1028           PUT stream PrnLibStream UNFORMATTED
     1029           "Нераспознанные платежи по чекам продажи " my-inkas " Фильтр - " filter-name
     1030           skip
     1031           "Номер чека"  format "X(20)" space(1)
     1032           "Касса"    format "X(5)" space(1)
     1033           "Чек" format "X(6)" space(1)
     1034           "Сумма в валюте продаж"  format "X(19)" space(1)
     1035           "Нет такого типа касс. платежа" format "X(29)" space(1)
     1036           "Код валюты платежа в системе" format "X(28)" space(1)
     1037           "Код валюты платежа в чеке" format  "X(25)" space(1)
     1038           "Ош-ка номера продажи" format "X(20)"
     1039           SKIP.
     1040       END.
     1041       WHEN 7 then do:
     1042           OUTPUT stream PrnLibStream to test7.txt.
     1043           PUT stream PrnLibStream UNFORMATTED
     1044           "Разница между суммой оплат (рубли) и суммой оплат (баз вал) чекам продажи " my-inkas " Фильтр - " filter-name
     1045           skip
     1046           "Номер чека"  format "X(20)" space(1)
     1047           "Касса"    format "X(5)" space(1)
     1048           "Чек" format "X(6)" space(1)
     1049           "Сумма оплат рубли"   format "X(19)" space(1)
     1050           "Сумма оплат баз вал"  format "X(19)" space(1)
     1051           "Погрешность"  format "X(19)" space(1)
     1052           "Ош-ка номера продажи" format "X(20)"
     1053           SKIP.
     1054       end.
     1055       WHEN 8 then do:
     1056           OUTPUT stream PrnLibStream to test8.txt.
     1057           PUT stream PrnLibStream UNFORMATTED
     1058           "Разница между суммой скидок по строкам и общей скидкой чека продажи " my-inkas " Фильтр - " filter-name
     1059           skip
     1060           "Номер чека"  format "X(20)" space(1)
     1061           "Касса"    format "X(5)" space(1)
     1062           "Чек" format "X(6)" space(1)
     1063           "Сумма скидок строк"   format "X(19)" space(1)
     1064           "Общая скидка чека"  format "X(19)" space(1)
     1065           "Погрешность"  format "X(19)" space(1)
     1066           "Ош-ка номера продажи" format "X(20)"
     1067           SKIP.
     1068       end.
     1069       WHEN 9 then do:
     1070           output stream PrnLibStream to test9.txt.
     1071           PUT stream PrnLibStream UNFORMATTED
     1072           "Разница между суммой нетто по чеку и брутто-скидка  по чекам продажи " my-inkas " Фильтр - " filter-name
     1073           skip
     1074           "Номер чека"  format "X(20)" space(1)
     1075           "Касса"    format "X(5)" space(1)
     1076           "Чек" format "X(6)" space(1)
     1077           "Брутто" format "X(19)" space(1)
     1078           "Скидка" format "X(19)" space(1)
     1079           "Нетто"     format "X(19)" space(1)
     1080           "Разность брутто-скидка"  format "X(19)" space(1)
     1081           "Погрешность"  format "X(19)" space(1)
     1082           SKIP.
     1083       END.
     1084       WHEN 10 then do:
     1085           output stream PrnLibStream to TEST10.txt.
     1086           PUT stream PrnLibStream UNFORMATTED
     1087           "Разница между товарной суммой по строкам чека и суммой нетто по чекам продажи " my-inkas " Фильтр - " filter-name
     1088           skip
     1089           "Номер чека"  format "X(20)" space(1)
     1090           "Касса"    format "X(5)" space(1)
     1091           "Чек" format "X(6)" space(1)
     1092           "Товарная сумма"     format "X(19)" space(1)
     1093           "Сумма нетто по чеку"  format "X(19)" space(1)
     1094           "Погрешность"  format "X(19)" space(1)
     1095           SKIP.
     1096       END.
     1097       WHEN 11 then do:
     1098           output stream PrnLibStream to test11.txt.
     1099           PUT stream PrnLibStream UNFORMATTED
     1100           "Разница между товарной суммой по строкам чека и брутто-скидка по чекам продажи " my-inkas " Фильтр - " filter-name
     1101           skip
     1102           "Номер чека"  format "X(20)" space(1)
     1103           "Касса"    format "X(5)" space(1)
     1104           "Чек" format "X(6)" space(1)
     1105           "Брутто" format "X(19)" space(1)
     1106           "Скидка" format "X(19)" space(1)
     1107           "Скидка на итог" format "X(19)" space(1)
     1108           "Товарная сумма"     format "X(19)" space(1)
     1109           "Разность брутто-скидка"  format "X(19)" space(1)
     1110           "Погрешность"  format "X(19)" space(1)
     1111           "Ош-ка номера продажи" format "X(20)"
     1112           SKIP.
     1113       END.
     1114       WHEN 12 then do:
     1115           output stream PrnLibStream to test12.txt.
     1116           PUT stream PrnLibStream UNFORMATTED
     1117           "Разница между суммой оплат (рубли) и суммой нетто по чекам продажи " my-inkas " Фильтр - " filter-name
     1118           skip
     1119           "Номер чека"  format "X(20)" space(1)
     1120           "Касса"    format "X(5)" space(1)
     1121           "Чек" format "X(6)" space(1)
     1122           "Бар-код" format "X(9)" space(1)
     1123           "Цена1" format "X(12)" space(1)
     1124           "Цена2" format "X(12)" space(1)
     1125           "Погрешность"  format "X(19)" space(1)
     1126           "Ош-ка номера продажи" format "X(20)"
     1127           SKIP.
     1128       END.
     1129       WHEN 13 then do:
     1130           output stream PrnLibStream to test13.txt.
     1131           PUT stream PrnLibStream UNFORMATTED
     1132           "Разница между суммой списания и суммой по строкам списания" my-inkas " Фильтр - " filter-name
     1133           skip
     1134           "Номер чека"  format "X(20)" space(1)
     1135           "Касса"    format "X(5)" space(1)
     1136           "Чек" format "X(6)" space(1)
     1137           "Сумма списания" format "X(19)" space(1)
     1138           "Сумма по строкам списания"     format "X(19)" space(1)
     1139           "Погрешность"  format "X(19)" space(1)
     1140           "Ош-ка номера продажи" format "X(20)"
     1141           SKIP.
     1142      END.
     1143      WHEN 14 then do:
     1144           output stream PRnLibStream to test14.txt.
     1145           PUT STREAM PrnLibStream UNFORMATTED
     1146           "Скидки погрешностей и округления" my-inkas " Фильтр - " filter-name
     1147           skip
     1148           "Номер чека"  format "X(20)" space(1)
     1149           "Дата"  format "X(10)" space(1)
     1150           "№ продажи"  format "X(20)" space(1)
     1151           "Касса"    format "X(5)" space(1)
     1152           "Чек" format "X(6)" space(1)
     1153           "№№" format "X(6)"  space(1)
     1154           "Бар-код" FORMAT "X(9)"  SPACE(1)
     1155           "Цена" FORMAT "X(15)"  SPACE(1)
     1156           "Кол-во" FORMAT "X(11)"   SPACE(1)
     1157           "Сумма нетто" FORMAT "X(22)"  SPACE(1)
     1158           "Скидка погрешности" format "X(22)"  space(1)
     1159           "Сумма погрешности" format "X(22)"
     1160           SKIP.
     1161      END.
     1162   END CASE.
     1163   define variable v-prepare-phrase as character no-undo .
     1164   if my-inkas = "ALL" OR my-inkas = "all" then do:
     1165     v-prepare-phrase = substitute('FOR EACH inkas NO-LOCK where ' +
     1166                                   ' inkas.obj-type = &1&2&1 ' +
     1167                                   ' AND  inkas.obj-code = &3,' +
     1168                                   ' EACH chk-doc NO-LOCK where ' +
     1169                                   ' chk-doc.out-code = inkas.inkas-code &4'
     1170                                 ,chr(34)
     1171                                 ,'маг':U
     1172                                 ,v-cntxt-obj-code
     1173                                 ,my-where-phrase).
     1174     run utl/testq00.p (
     1175                input parparentproc
     1176               ,input test-number
     1177               ,input my-inkas
     1178               ,INPUT v-cntxt-obj-type
     1179               ,INPUT v-cntxt-obj-code
     1180               ,input v-prepare-phrase
     1181               ,input varscales-pref
     1182               ,input varpgscales-pref
     1183               )
     1184      no-error.
     1185   end.
     1186   else do:
     1187     if my-inkas = ?
     1188     or my-inkas = chr(63) then do:
     1189     v-prepare-phrase = substitute('FOR EACH chk-doc NO-LOCK where ' +
     1190                                   ' chk-doc.obj-type = &1&2&1 ' +
     1191                                   ' AND chk-doc.obj-code = &3' +
     1192                                   ' and chk-doc.out-code = ? &4'
     1193                                 ,chr(34)
     1194                                 ,'маг':U
     1195                                 ,v-cntxt-obj-code
     1196                                 ,my-where-phrase).
     1197     end.
     1198     else do:
     1199     v-prepare-phrase = substitute('FOR EACH chk-doc NO-LOCK where ' +
     1200                                   ' chk-doc.obj-type = &1&2&1 ' +
     1201                                   ' AND chk-doc.obj-code = &3' +
     1202                                   ' and chk-doc.out-code = &1&4&1 &5'
     1203                                 ,chr(34)
     1204                                 ,'маг':U
     1205                                 ,v-cntxt-obj-code
     1206                                 ,my-inkas
     1207                                 ,my-where-phrase).
     1208     end.
     1209     run utl/testq00.p (
     1210                input parparentproc
     1211               ,input test-number
     1212               ,input my-inkas
     1213               ,INPUT v-cntxt-obj-type
     1214               ,INPUT v-cntxt-obj-code
     1215               ,input v-prepare-phrase
     1216               ,input varscales-pref
     1217               ,input varpgscales-pref
     1218               )
     1219     no-error.
     1220   end.
     1221   if not test-number = 1 and NOT test-number = 6 then
     1222   PUT stream PrnLibStream UNFORMATTED
     1223   "Накопленная погрешность"
     1224   SKIP
     1225   accum1 format "-999,999.9999999999"
     1226   SKIP.
     1227   run waitfram-hide in this-procedure .
     1228   OUTPUT stream PrnLibStream close.
     1229   END PROCEDURE.
