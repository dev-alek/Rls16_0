      541       view-as alert-box ERROR.
      542       return no-apply.
      543     end.
      544     assign
      545     c-point = "chk-docs" + 'объект':U
      546     tbl = 'chk-doc'
      547     join-tbl = 'c-DOC'
      548     fld = 'doc-code,chk-date,office,shift-date,shift-num,chk-num,pay-desk,cashier,sales-man,tot-doc,discnt,sub-discnt,netto,out-code,d-card'
      549     lab = 'Номер в базе,,,Смена от,Номер смены,Номер по кассе,,,,,,Сумма списанного,Нетто сумма (выручка),Номер продажи,N дис.карты'
      550     spr = ',,,,,,,,,,,,,,'
      551     dim = '15'.
      552     run gbl/filter.w ( input parparentproc
      553                      , input (c-point + chr(4) + "Список чеков, один объект")
      554                      , input tbl
      555                      , input join-tbl
      556                      , input fld
      557                      , input lab
      558                      , input spr
      559                      , input dim).
