      701   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   on help of frame Dialog-Frame
      703   do:
      704     run gbl/app_help.p
      705       (input this-procedure :file-name
      706       ,input ''
      707       ,input ?
      708       ) no-error.
      709     if error-status :error then do:
      710       message
      711         "Ошибка при вызове помощи"
      712         error-status :get-message(1)
      713         view-as alert-box .
      714     end.
      715   end.
      716   run minbtn-set in this-procedure .
      717   on choose of b-help in frame Dialog-Frame
      718   do:
      719     apply "help":u to frame Dialog-Frame .
      720   end.
      721   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   procedure minbtn-set :
      723       do
      724           on error undo, return error return-value
      725           :
      726           define variable ii              as integer       no-undo .
      727           define variable fh              as widget-handle no-undo .
      728           define variable hh              as widget-handle no-undo .
      729           define variable v-h             as handle        extent 4 no-undo .
      730           define variable v-name-button   as character     no-undo .
      731           define variable v-help-old-x    as decimal       no-undo .
      732           define variable v-help-old-y    as decimal       no-undo .
      733           define variable v-help-old-size as decimal       no-undo .
      734           define variable v-frame-width   as decimal       no-undo .
      735           define variable jj              as integer       no-undo .
      736           do
      737               on error undo, return error
      738               :
      739               assign
      740                   v-frame-width = frame Dialog-Frame:width - 0.3
      741                   fh            = frame Dialog-Frame:first-child
      742                   hh            = fh:first-child
      743                   ii            = 1
      744                   .
      745               do while valid-handle(hh):
      746                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      747                   do:
      748                       case lc(hh:name) :
      749                           when "b-help" then
      750                               do:
      751                                   hh:load-image-up("cmp/b-help.bmp":u) .
      752                                   hh:load-image-down("cmp/b-help.bmp":u) .
      753                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      754                                   hh:TOOLTIP = "Помощь" .
      755                                   v-help-old-x = hh:column .
      756                                   v-help-old-y = hh:row    .
      757                                   v-help-old-size = hh:width .
      758                                   hh:width-chars = 2.5 .
      759                               end.
      760                           when "b-print" then
      761                               do:
      762                                   hh:load-image("cmp/b-print.bmp":u) .
      763                                   hh:TOOLTIP = "Печать" .
      764                                   v-h[ii] = hh:handle .
      765                                   ii = ii + 1 .
      766                                   hh:width-chars = 3 .
      767                               end.
      768                           when "b-history" or
      769                           when "b-hist" then
      770                               do:
      771                                   hh:load-image("cmp/b-hist.bmp":u) .
      772                                   hh:TOOLTIP = "История" .
      773                                   v-h[ii] = hh:handle .
      774                                   ii = ii + 1 .
      775                                   hh:width-chars = 3 .
      776                               end.
      777                           when "b-sch" then
      778                               do:
      779                                   hh:load-image("cmp/b-sch.bmp":u) .
      780                                   hh:TOOLTIP = "Установка Фильтра" .
      781                                   v-h[ii] = hh:handle .
      782                                   ii = ii + 1 .
      783                                   hh:width-chars = 3 .
      784                               end.
      785                           when "b-hist-user" then
      786                               do:
      787                                   hh:load-image("cmp/b-hist.bmp":u) .
      788                                   hh:TOOLTIP = "История пользователя" .
      789                                   ii = ii + 1 .
      790                               end.
      791                       end case.
      792                   end.
      793                   hh = hh:next-sibling.
      794               end.
      795               b-help:column = v-frame-width - b-help:width-chars.
      796               jj = 0.
      797               repeat ii = 4 to 1 by -1 :
      798                   if valid-handle (v-h[ii] ) then
      799                   do:
      800                       jj  = jj + 1 .
      801                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      802                       v-h[ii]:row    = v-help-old-y .
      803                   end.
      804               end.
      805           end.
      806       end.
      807   end procedure.
