      562                 , output v-flt-rec
      563                 , output filter-name
      564                 , output where-phrase
      565                 , output sort-phrase
      566                 , output where-phrase-rus
      567                 , output sort-phrase-rus
      568                 ) .
      569     MY-WHERE-PHRASE = REPLACE(WHERE-PHRASE, "C-DOC", "CHK-DOC").
      570     assign f-sch = filter-name.
      571     display f-sch with frame Dialog-Frame.
      572   END.
