        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
        7   define buffer bf_trn-doc for ub.trn-doc.
        8   define buffer bf_parts   for ub.parts.
        9   on write of ub.trn-doc override do:
       10   end.
       11   do on error undo, return error return-value :
       12     find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-error.
       13     if not available bf_trn-doc then do:
       14       message "Документ: " pardoc-code " не найден." view-as alert-box.
       15       return error.
       16     end.
       17     if bf_trn-doc.ext-doc-type = 'ev':U and
       18        bf_trn-doc.cr-db-num    = 0                  and
       19        bf_trn-doc.status_      <> 'факт':U           and
       20        bf_trn-doc.status_      <> 'запрос':U        then do:
       21        find first bf_parts where bf_parts.out-code = bf_trn-doc.doc-code no-error.
       22        if available bf_parts then do:
       23          message "К документу " pardoc-code " есть привязанные партии." skip
       24                  "Данный документ не может быть обработан данной утилитой." view-as alert-box.
       25          return error.
       26        end.
       27        else do:
       28          assign
       29            bf_trn-doc.status_ = 'запрос':U
       30            bf_trn-doc.flag_   = yes.
       31        end.
       32    end.
       33    else do:
       34      message "Этот документ не может быть обработан данной утилитой." view-as alert-box.
       35      return error.
       36    end.
       37   end.
