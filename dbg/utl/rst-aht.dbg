     4027         (input "Блокировка расчёта складского архива по типам приобретения"
     4028         ).
     4029       define variable v-need-stop-aht as logical   no-undo .
     4030       assign
     4031         v-need-stop-aht = false
     4032       .
     4033       run gbl/lock-prc.p
     4034         (input 'ahtb':U
     4035         ,input v-obj-code
     4036         ,input 0
     4037         ,input 0
     4038         ,input v-obj-type
     4039         ,input ""
     4040         ,input ""
     4041         ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
     4042         ,input false
     4043         ,buffer calc-aht-lock_batchprocess
     4044         ) no-error .
     4045       if error-status :error
     4046       then do:
     4047         if error-status :get-message(1) <> ""
     4048         then do:
     4049           message
     4050             vss-workfile vss-revision vss-description skip
     4051             "Ошибка при вызове процедуры блокировки расчета складского архива по типам приобретения" skip
     4052             "Невозможно продолжить восстановление складского архива по типам приобретения" skip
     4053             error-status :get-message(1) skip
     4054             return-value skip
     4055             view-as alert-box error .
     4056           undo, return error "Ошибка при вызове процедуры блокировки расчёта складского архива по типам приобретения" .
     4057         end.
     4058         assign
     4059           v-need-stop-aht = true
     4060         .
     4061       end.
     4062       define buffer stop-aht-restore-lock_btpr for batchprocess .
     4063       if v-need-stop-aht = true
     4064       then do:
     4065         do transaction
     4066         on error undo, return error return-value
     4067         :
     4068           create stop-aht-restore-lock_btpr .
     4069           assign
     4070             stop-aht-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
     4071             stop-aht-restore-lock_btpr.bp_status     = 'N':U
     4072             stop-aht-restore-lock_btpr.Key#_One      = v-obj-code
     4073             stop-aht-restore-lock_btpr.Key#_Two      = 0
     4074             stop-aht-restore-lock_btpr.Key#_Three    = 0
     4075             stop-aht-restore-lock_btpr.CharKey_One   = v-obj-type
     4076             stop-aht-restore-lock_btpr.CharKey_Two   = ""
     4077             stop-aht-restore-lock_btpr.CharKey_Three = ""
     4078           .
     4079           define variable v-start-lock-time   as int64     no-undo .
     4080           define variable v-start-lock-second as integer   no-undo .
     4081           assign
     4082             v-start-lock-time = etime
     4083           .
     4084           wait_block:
     4085           do while true
     4086           :
     4087             assign
     4088               v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
     4089             .
     4090             run waitfram-show in this-procedure
     4091               (input waitfram-join-function("Архив рассчитывается на другой машине"
     4092                                            ,"Отправлено сообщение о необходимости остановки расчёта складского архива"
     4093                                            ,substitute("Ожидание освобождения ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
     4094                                            )
     4095               ) .
     4096             run gbl/lock-prc.p
     4097               (input 'ahtb':U
     4098               ,input v-obj-code
     4099               ,input 0
     4100               ,input 0
     4101               ,input v-obj-type
     4102               ,input ""
     4103               ,input ""
     4104               ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
     4105               ,input false
     4106               ,buffer calc-aht-lock_batchprocess
     4107               ) no-error .
     4108             if error-status :error
     4109             then do:
     4110               if error-status :get-message(1) <> ""
     4111               then do:
     4112                 message
     4113                   vss-workfile vss-revision vss-description skip
     4114                   "Ошибка при вызове процедуры блокировки расчета складского архива по типам приобретения" skip
     4115                   "Невозможно продолжить восстановление складского архива по типам приобретения" skip
     4116                   view-as alert-box error .
     4117                 undo, return error "В данный момент рассчитывается складской архив по типам приобретения" .
     4118               end.
     4119             end.
     4120             else do:
     4121               run waitfram-hide in this-procedure .
     4122               leave wait_block .
     4123             end.
     4124             pause 1 no-message .
     4125           end.
     4126           delete stop-aht-restore-lock_btpr .
     4127         end.
     4128       end.
     4129       run show-action in this-procedure
     4130         (input "Удаление повторных записей остатков"
     4131         ).
     4132       run ahrstutl-delete-copy in this-procedure
     4133         (input v-obj-type
