     4839                                                                           buf_temp-aht-stk-line.sale-sum-base       = buf_temp-aht-stk-line.sale-sum-base       + p-sign * buf_aht-stk-line.sale-sum-base            buf_temp-aht-stk-line.sale-sum-rubl       = buf_temp-aht-stk-line.sale-sum-rubl       + p-sign * buf_aht-stk-line.sale-sum-rubl            buf_temp-aht-stk-line.sale-vat-base       = buf_temp-aht-stk-line.sale-vat-base       + p-sign * buf_aht-stk-line.sale-vat-base            buf_temp-aht-stk-line.sale-vat-rubl       = buf_temp-aht-stk-line.sale-vat-rubl       + p-sign * buf_aht-stk-line.sale-vat-rubl            buf_temp-aht-stk-line.sale-slt-base       = buf_temp-aht-stk-line.sale-slt-base       + p-sign * buf_aht-stk-line.sale-slt-base            buf_temp-aht-stk-line.sale-slt-rubl       = buf_temp-aht-stk-line.sale-slt-rubl       + p-sign * buf_aht-stk-line.sale-slt-rubl            buf_temp-aht-stk-line.sale-road-tax-base  = buf_temp-aht-stk-line.sale-road-tax-base  + p-sign * buf_aht-stk-line.sale-road-tax-base       buf_temp-aht-stk-line.sale-road-tax-rubl  = buf_temp-aht-stk-line.sale-road-tax-rubl  + p-sign * buf_aht-stk-line.sale-road-tax-rubl       buf_temp-aht-stk-line.sale-excise-base    = buf_temp-aht-stk-line.sale-excise-base    + p-sign * buf_aht-stk-line.sale-excise-base         buf_temp-aht-stk-line.sale-excise-rubl    = buf_temp-aht-stk-line.sale-excise-rubl    + p-sign * buf_aht-stk-line.sale-excise-rubl         buf_temp-aht-stk-line.sale-transport-base = buf_temp-aht-stk-line.sale-transport-base + p-sign * buf_aht-stk-line.sale-transport-base      buf_temp-aht-stk-line.sale-transport-rubl = buf_temp-aht-stk-line.sale-transport-rubl + p-sign * buf_aht-stk-line.sale-transport-rubl      buf_temp-aht-stk-line.sale-other-base     = buf_temp-aht-stk-line.sale-other-base     + p-sign * buf_aht-stk-line.sale-other-base          buf_temp-aht-stk-line.sale-other-rubl     = buf_temp-aht-stk-line.sale-other-rubl     + p-sign * buf_aht-stk-line.sale-other-rubl          buf_temp-aht-stk-line.sale-discnt-base    = buf_temp-aht-stk-line.sale-discnt-base    + p-sign * buf_aht-stk-line.sale-discnt-base          buf_temp-aht-stk-line.sale-discnt-rubl    = buf_temp-aht-stk-line.sale-discnt-rubl    + p-sign * buf_aht-stk-line.sale-discnt-rubl
     4840         .
     4841       end.
     4842       else do:
     4843         assign
     4844           v-create-stk = true
     4845         .
     4846         find first buf_temp-aht-stk-line
     4847           where buf_temp-aht-stk-line.obj-type   = p-obj-type
     4848             and buf_temp-aht-stk-line.obj-code   = p-obj-code
     4849             and buf_temp-aht-stk-line.gds-code   = p-gds-code
     4850             and buf_temp-aht-stk-line.fact-order = p-create-line-fact-order
     4851             and buf_temp-aht-stk-line.sum-type   = p-sum-type
     4852           no-error .
     4853         if not available buf_temp-aht-stk-line
     4854         then do:
     4855           create buf_temp-aht-stk-line .
     4856           assign
     4857             buf_temp-aht-stk-line.obj-type   = p-obj-type
     4858             buf_temp-aht-stk-line.obj-code   = p-obj-code
     4859             buf_temp-aht-stk-line.gds-code   = p-gds-code
     4860             buf_temp-aht-stk-line.sum-type   = p-sum-type
     4861             buf_temp-aht-stk-line.fact-order = p-create-line-fact-order
     4862           .
     4863         end.
     4864       end.
     4865       if p-sign = 1
     4866       then do:
     4867         create buf_temp-create-aht-stk-line .
     4868         assign
     4869           buf_temp-create-aht-stk-line.obj-type    = p-obj-type
     4870           buf_temp-create-aht-stk-line.obj-code    = p-obj-code
     4871           buf_temp-create-aht-stk-line.gds-code    = p-gds-code
     4872           buf_temp-create-aht-stk-line.sum-type    = p-sum-type
     4873           buf_temp-create-aht-stk-line.need-create = v-create-stk
     4874         .
     4875       end.
     4876     end.
     4877   end procedure.
     4878   procedure ahrstutl-create-stk :
     4879     define input  parameter p-obj-type  as character no-undo .
     4880     define input  parameter p-obj-code  as integer   no-undo .
     4881     define input  parameter p-fact-date as date      no-undo .
     4882     define variable v-shift-on                as logical   no-undo .
     4883     define variable v-shift-date              as date      no-undo .
     4884     define variable v-shift-num               as integer   no-undo .
     4885     define variable v-day-end-fact-order      as decimal   no-undo .
     4886     define variable v-shift-end-fact-order    as decimal   no-undo .
     4887     define buffer buf_temp-create-aht-stk-tot  for temp-create-aht-stk-tot .
     4888     define buffer buf_temp-create-aht-stk-line for temp-create-aht-stk-line .
     4889     define buffer buf_temp-aht-stk-tot for temp-aht-stk-tot .
     4890     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     4891     define buffer buf_temp-aht-stk-line for temp-aht-stk-line .
     4892     define buffer buf_aht-stk-line for ub.aht-stk-line .
     4893     do
     4894     on error undo, return error return-value
     4895     :
     4896       run factord-cut-archive in this-procedure
     4897         (input  p-obj-type
     4898         ,input  p-obj-code
     4899         ,input  p-fact-date
     4900         ,output v-shift-on
     4901         ,output v-shift-date
     4902         ,output v-shift-num
     4903         ,output v-day-end-fact-order
     4904         ,output v-shift-end-fact-order
     4905         ) .
     4906       run show-action in this-procedure
     4907         (input "Создание остатка на текущую дату"
     4908         ).
     4909       define variable v-total-count as integer   no-undo .
     4910       for each buf_temp-create-aht-stk-tot
     4911         where buf_temp-create-aht-stk-tot.need-create = true
     4912       on error undo, return error return-value
     4913       :
     4914         assign
     4915           v-total-count = v-total-count + 1
     4916         .
     4917         if v-total-count modulo 10 = 0
     4918         then do:
     4919           run show-count in this-procedure
     4920             (input v-total-count
     4921             ,input ""
     4922             ).
     4923         end.
     4924         for each buf_temp-aht-stk-tot
     4925           where buf_temp-aht-stk-tot.obj-type   = buf_temp-create-aht-stk-tot.obj-type
     4926             and buf_temp-aht-stk-tot.obj-code   = buf_temp-create-aht-stk-tot.obj-code
     4927             and buf_temp-aht-stk-tot.fact-order = v-day-end-fact-order
     4928             and buf_temp-aht-stk-tot.sum-type   = buf_temp-create-aht-stk-tot.sum-type
     4929         on error undo, return error return-value
     4930         :
     4931           create buf_aht-stk-tot .
     4932           buffer-copy buf_temp-aht-stk-tot to buf_aht-stk-tot
     4933           .
     4934         end.
     4935       end.
     4936       assign
     4937         v-total-count = 0
     4938       .
     4939       for each buf_temp-create-aht-stk-line
     4940         where buf_temp-create-aht-stk-line.need-create = true
     4941       on error undo, return error return-value
     4942       :
     4943         assign
     4944           v-total-count = v-total-count + 1
     4945         .
     4946         if v-total-count modulo 10 = 0
     4947         then do:
     4948           run show-count in this-procedure
     4949             (input v-total-count
     4950             ,input "Код товара " + string(buf_temp-create-aht-stk-line.gds-code)
     4951             ).
     4952         end.
     4953         for each buf_temp-aht-stk-line
     4954           where buf_temp-aht-stk-line.obj-type   = buf_temp-create-aht-stk-line.obj-type
     4955             and buf_temp-aht-stk-line.obj-code   = buf_temp-create-aht-stk-line.obj-code
     4956             and buf_temp-aht-stk-line.gds-code   = buf_temp-create-aht-stk-line.gds-code
     4957             and buf_temp-aht-stk-line.fact-order = v-day-end-fact-order
     4958             and buf_temp-aht-stk-line.sum-type   = buf_temp-create-aht-stk-line.sum-type
     4959         on error undo, return error return-value
     4960         :
     4961           create buf_aht-stk-line .
     4962           buffer-copy buf_temp-aht-stk-line to buf_aht-stk-line
     4963           .
     4964         end.
     4965       end.
     4966     end.
     4967   end procedure.
     4968   procedure ahrstutl-clear-aht :
     4969     define input  parameter p-obj-type         as character no-undo .
     4970     define input  parameter p-obj-code         as integer   no-undo .
     4971     define input  parameter p-start-fact-order as decimal   no-undo .
     4972     define input  parameter p-fact-date        as date      no-undo .
     4973     define buffer buf_aht-doc      for ub.aht-doc .
     4974     define buffer buf_aht-stk      for ub.aht-stk .
     4975     define buffer buf_aht-ot-tot   for ub.aht-ot-tot .
     4976     define buffer buf_aht-ot-line  for ub.aht-ot-line .
     4977     define buffer buf_aht-stk-tot  for ub.aht-stk-tot .
     4978     define buffer buf_aht-stk-line for ub.aht-stk-line .
     4979     define variable v-shift-on                as logical   no-undo .
     4980     define variable v-shift-date              as date      no-undo .
     4981     define variable v-shift-num               as integer   no-undo .
     4982     define variable v-day-end-fact-order      as decimal   no-undo .
     4983     define variable v-shift-end-fact-order    as decimal   no-undo .
     4984     define variable v-ind as integer no-undo .
     4985     do
     4986     on error undo, return error return-value
     4987     :
     4988       run factord-cut-archive in this-procedure
     4989         (input  p-obj-type
     4990         ,input  p-obj-code
     4991         ,input  p-fact-date
     4992         ,output v-shift-on
     4993         ,output v-shift-date
     4994         ,output v-shift-num
     4995         ,output v-day-end-fact-order
     4996         ,output v-shift-end-fact-order
     4997         ) .
     4998       assign
     4999         v-day-end-fact-order   = v-day-end-fact-order   - 0.0000000001
     5000         v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     5001       .
     5002       run show-action in this-procedure
     5003         (input "Удаление информации о наличии документов"
     5004         ).
     5005       for each buf_aht-doc
     5006         where buf_aht-doc.obj-type   = p-obj-type
     5007           and buf_aht-doc.obj-code   = p-obj-code
     5008           and buf_aht-doc.fact-order > p-start-fact-order
     5009           and buf_aht-doc.fact-order <= v-day-end-fact-order
     5010       on error undo, return error
     5011       :
     5012         assign
     5013           v-ind = v-ind + 1
     5014         .
     5015         if v-ind modulo 10 = 0
     5016         then do:
     5017           run show-count in this-procedure
     5018             (input v-ind
     5019             ,input "Документ " + string(buf_aht-doc.doc-code)
     5020             ).
     5021         end.
     5022         delete buf_aht-doc .
     5023       end.
     5024       run show-action in this-procedure
     5025         (input "Удаление информации о наличии остатков по объекту"
     5026         ).
     5027       for each buf_aht-stk
     5028         where buf_aht-stk.obj-type   = p-obj-type
     5029           and buf_aht-stk.obj-code   = p-obj-code
     5030           and buf_aht-stk.fact-order > p-start-fact-order
     5031           and buf_aht-stk.fact-order <= v-day-end-fact-order
     5032       on error undo, return error
     5033       :
     5034         assign
     5035           v-ind = v-ind + 1
     5036         .
     5037         if v-ind modulo 10 = 0
     5038         then do:
     5039           run show-count in this-procedure
     5040             (input v-ind
     5041             ,input "Дата " + string(buf_aht-stk.fact-date)
     5042             ).
     5043         end.
     5044         delete buf_aht-stk .
     5045       end.
     5046       run show-action in this-procedure
     5047         (input "Удаление оборота по документам"
     5048         ).
     5049       assign
     5050         v-ind = 0
     5051       .
     5052       for each buf_aht-ot-tot
     5053         where buf_aht-ot-tot.obj-type   = p-obj-type
     5054           and buf_aht-ot-tot.obj-code   = p-obj-code
     5055           and buf_aht-ot-tot.fact-order > p-start-fact-order
     5056           and buf_aht-ot-tot.fact-order <= v-day-end-fact-order
     5057       on error undo, return error return-value
     5058       :
     5059         assign
     5060           v-ind = v-ind + 1
     5061         .
     5062         if v-ind modulo 10 = 0
     5063         then do:
     5064           run show-count in this-procedure
     5065             (input v-ind
     5066             ,input "Документ " + string(buf_aht-ot-tot.doc-code)
     5067             ).
     5068         end.
     5069         delete buf_aht-ot-tot .
     5070       end.
     5071       run show-action in this-procedure
     5072         (input "Удаление оборота по строкам документов"
     5073         ).
     5074       assign
     5075         v-ind = 0
     5076       .
     5077       for each buf_aht-ot-line
     5078         where buf_aht-ot-line.obj-type   = p-obj-type
     5079           and buf_aht-ot-line.obj-code   = p-obj-code
     5080           and buf_aht-ot-line.fact-order > p-start-fact-order
     5081           and buf_aht-ot-line.fact-order <= v-day-end-fact-order
     5082       on error undo, return error return-value
     5083       :
     5084         assign
     5085           v-ind = v-ind + 1
     5086         .
     5087         if v-ind modulo 10 = 0
     5088         then do:
     5089           run show-count in this-procedure
     5090             (input v-ind
     5091             ,input "Документ " + string(buf_aht-ot-line.doc-code)
     5092                     + " Код товара " + string(buf_aht-ot-line.gds-code)
     5093             ).
     5094         end.
     5095         delete buf_aht-ot-line .
     5096       end.
     5097       run show-action in this-procedure
     5098         (input "Удаление остатка по объекту"
     5099         ).
     5100       assign
     5101         v-ind = 0
     5102       .
     5103       for each buf_aht-stk-tot
     5104         where buf_aht-stk-tot.obj-type   = p-obj-type
     5105           and buf_aht-stk-tot.obj-code   = p-obj-code
     5106           and buf_aht-stk-tot.fact-order > p-start-fact-order
     5107           and buf_aht-stk-tot.fact-order <= v-day-end-fact-order
     5108       on error undo, return error return-value
     5109       :
     5110         assign
     5111           v-ind = v-ind + 1
     5112         .
     5113         if v-ind modulo 10 = 0
     5114         then do:
     5115           define variable v-fact-date as date      no-undo .
     5116           run factord-to-date in this-procedure
     5117             (input  buf_aht-stk-tot.fact-order
     5118             ,output v-fact-date
     5119             ) .
     5120           run show-count in this-procedure
     5121             (input v-ind
     5122             ,input "Дата " + string(v-fact-date, '99/99/9999':U )
     5123             ).
     5124         end.
     5125         delete buf_aht-stk-tot .
     5126       end.
     5127       run show-action in this-procedure
     5128         (input "Удаление остатка по товарам на объекте"
     5129         ).
     5130       assign
     5131         v-ind = 0
     5132       .
     5133       for each buf_aht-stk-line
     5134         where buf_aht-stk-line.obj-type   = p-obj-type
     5135           and buf_aht-stk-line.obj-code   = p-obj-code
     5136           and buf_aht-stk-line.fact-order > p-start-fact-order
     5137           and buf_aht-stk-line.fact-order <= v-day-end-fact-order
     5138       on error undo, return error return-value
     5139       :
     5140         assign
     5141           v-ind = v-ind + 1
     5142         .
     5143         if v-ind modulo 10 = 0
     5144         then do:
     5145           run show-count in this-procedure
     5146             (input v-ind
     5147             ,input "Код товара " + string(buf_aht-stk-line.gds-code)
     5148             ).
     5149         end.
     5150         delete buf_aht-stk-line .
     5151       end.
     5152     end.
     5153   end procedure.
     5154   procedure ahrstutl-delete-copy :
     5155     define input  parameter p-obj-type  as character no-undo .
     5156     define input  parameter p-obj-code  as integer   no-undo .
     5157     define input  parameter p-fact-date as date      no-undo .
     5158     define buffer buf_aht-stk-tot  for ub.aht-stk-tot .
     5159     define buffer buf_aht-stk-line for ub.aht-stk-line .
     5160     define buffer buf_temp-create-aht-stk-tot for temp-create-aht-stk-tot .
     5161     define buffer buf_temp-create-aht-stk-line for temp-create-aht-stk-line .
     5162     define variable v-shift-on                as logical   no-undo .
     5163     define variable v-shift-date              as date      no-undo .
     5164     define variable v-shift-num               as integer   no-undo .
     5165     define variable v-day-end-fact-order      as decimal   no-undo .
     5166     define variable v-shift-end-fact-order    as decimal   no-undo .
     5167     define variable v-ind as integer no-undo .
     5168     do
     5169     on error undo, return error return-value
     5170     :
     5171       run factord-cut-archive in this-procedure
     5172         (input  p-obj-type
     5173         ,input  p-obj-code
     5174         ,input  p-fact-date
     5175         ,output v-shift-on
     5176         ,output v-shift-date
     5177         ,output v-shift-num
     5178         ,output v-day-end-fact-order
     5179         ,output v-shift-end-fact-order
     5180         ) .
     5181       run show-action in this-procedure
     5182         (input "Удаление повторных остатков"
     5183         ).
     5184       define variable v-total-count as integer   no-undo .
     5185       assign
     5186         v-total-count = 0
     5187       .
     5188       for each buf_temp-create-aht-stk-tot
     5189       on error undo, return error return-value
     5190       :
     5191         assign
     5192           v-total-count = v-total-count + 1
     5193         .
     5194         if v-ind modulo 10 = 0
     5195         then do:
     5196           run show-count in this-procedure
     5197             (input v-total-count
     5198             ,input "Остатки по объекту"
     5199             ).
     5200         end.
     5201         find last buf_aht-stk-tot exclusive-lock
     5202           where buf_aht-stk-tot.obj-type   = buf_temp-create-aht-stk-tot.obj-type
     5203             and buf_aht-stk-tot.obj-code   = buf_temp-create-aht-stk-tot.obj-code
     5204             and buf_aht-stk-tot.fact-order = v-day-end-fact-order - 0.0000000001
     5205             and buf_aht-stk-tot.sum-type   = buf_temp-create-aht-stk-tot.sum-type
     5206           no-error .
     5207         if available buf_aht-stk-tot
     5208         then do:
     5209           delete buf_aht-stk-tot .
     5210         end.
     5211         else do:
     5212           for each buf_aht-stk-tot exclusive-lock
     5213             where buf_aht-stk-tot.obj-type   = buf_temp-create-aht-stk-tot.obj-type
     5214               and buf_aht-stk-tot.obj-code   = buf_temp-create-aht-stk-tot.obj-code
     5215               and buf_aht-stk-tot.fact-order = v-day-end-fact-order
     5216               and buf_aht-stk-tot.sum-type   = buf_temp-create-aht-stk-tot.sum-type
     5217           on error undo, return error return-value
     5218           :
     5219             delete buf_aht-stk-tot .
     5220           end.
     5221         end.
     5222       end.
     5223       assign
     5224         v-total-count = 0
     5225       .
     5226       for each buf_temp-create-aht-stk-line
     5227       on error undo, return error return-value
     5228       :
     5229         assign
     5230           v-total-count = v-total-count + 1
     5231         .
     5232         if v-ind modulo 10 = 0
     5233         then do:
     5234           run show-count in this-procedure
     5235             (input v-total-count
     5236             ,input "Код товара " + string(buf_temp-create-aht-stk-line.gds-code)
     5237             ).
     5238         end.
     5239         find first buf_aht-stk-line exclusive-lock
     5240           where buf_aht-stk-line.obj-type   = buf_temp-create-aht-stk-line.obj-type
     5241             and buf_aht-stk-line.obj-code   = buf_temp-create-aht-stk-line.obj-code
     5242             and buf_aht-stk-line.gds-code   = buf_temp-create-aht-stk-line.gds-code
     5243             and buf_aht-stk-line.fact-order = v-day-end-fact-order - 0.0000000001
     5244             and buf_aht-stk-line.sum-type   = buf_temp-create-aht-stk-line.sum-type
     5245           no-error .
     5246         if available buf_aht-stk-line
     5247         then do:
     5248           delete buf_aht-stk-line .
     5249         end.
     5250         else do:
     5251           for each buf_aht-stk-line exclusive-lock
     5252             where buf_aht-stk-line.obj-type   = buf_temp-create-aht-stk-line.obj-type
     5253               and buf_aht-stk-line.obj-code   = buf_temp-create-aht-stk-line.obj-code
     5254               and buf_aht-stk-line.gds-code   = buf_temp-create-aht-stk-line.gds-code
     5255               and buf_aht-stk-line.fact-order = v-day-end-fact-order
     5256               and buf_aht-stk-line.sum-type   = buf_temp-create-aht-stk-line.sum-type
     5257           on error undo, return error return-value
     5258           :
     5259             delete buf_aht-stk-line .
     5260           end.
     5261         end.
     5262       end.
     5263       define buffer buf_gds-obj for ub.gds-obj .
     5264       define buffer buf_doclslib-goods for doclslib-goods .
     5265       for each buf_gds-obj no-lock
     5266         where buf_gds-obj.obj-type = p-obj-type
     5267           and buf_gds-obj.obj-code = p-obj-code
     5268       on error undo, return error return-value
     5269       :
     5270         find first buf_doclslib-goods
     5271           where buf_doclslib-goods.artic     = buf_gds-obj.artic
     5272             and buf_doclslib-goods.prod-type = buf_gds-obj.prod-type
     5273             and buf_doclslib-goods.prod-code = buf_gds-obj.prod-code
     5274           no-error .
     5275         if not available buf_doclslib-goods
     5276         then do:
     5277           for each buf_aht-stk-line exclusive-lock
     5278             where buf_aht-stk-line.obj-type   = buf_gds-obj.obj-type
     5279               and buf_aht-stk-line.obj-code   = buf_gds-obj.obj-code
     5280               and buf_aht-stk-line.gds-code   = buf_gds-obj.gds-code
     5281               and buf_aht-stk-line.fact-order = v-day-end-fact-order
     5282           on error undo, return error return-value
     5283           :
     5284             delete buf_aht-stk-line .
     5285           end.
     5286         end.
     5287       end.
     5288     end.
     5289   end procedure.
     5290   procedure ahrstutl-update :
     5291     define input  parameter p-obj-type           as character no-undo .
     5292     define input  parameter p-obj-code           as integer   no-undo .
     5293     define input  parameter p-first-cut-date     as date      no-undo .
     5294     define input  parameter p-last-cut-date      as date      no-undo .
     5295     define buffer buf_doclslib-goods for doclslib-goods .
     5296     define variable v-shift-on                   as logical   no-undo .
     5297     define variable v-first-shift-date           as date      no-undo .
     5298     define variable v-first-shift-num            as integer   no-undo .
     5299     define variable v-first-day-end-fact-order   as decimal   no-undo .
     5300     define variable v-first-shift-end-fact-order as decimal   no-undo .
     5301     define variable v-last-shift-date            as date      no-undo .
     5302     define variable v-last-shift-num             as integer   no-undo .
     5303     define variable v-last-day-end-fact-order    as decimal   no-undo .
     5304     define variable v-last-shift-end-fact-order  as decimal   no-undo .
     5305     define variable v-gds-goods     as logical   no-undo .
     5306     define variable v-sum-type-list as character no-undo .
     5307     define variable v-ind           as integer   no-undo .
     5308     do
     5309     on error undo, return error return-value
     5310     :
     5311       run factord-cut-archive in this-procedure
     5312         (input  p-obj-type
     5313         ,input  p-obj-code
     5314         ,input  p-first-cut-date
     5315         ,output v-shift-on
     5316         ,output v-first-shift-date
     5317         ,output v-first-shift-num
     5318         ,output v-first-day-end-fact-order
     5319         ,output v-first-shift-end-fact-order
     5320         ) .
     5321       run factord-cut-archive in this-procedure
     5322         (input  p-obj-type
     5323         ,input  p-obj-code
     5324         ,input  p-last-cut-date
     5325         ,output v-shift-on
     5326         ,output v-last-shift-date
     5327         ,output v-last-shift-num
     5328         ,output v-last-day-end-fact-order
     5329         ,output v-last-shift-end-fact-order
     5330         ) .
     5331       run show-action in this-procedure
     5332         (input "Пересчитываем остаток по объекту"
     5333         ).
     5334       define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     5335       run ahrstutl-tot-sum-type-list in this-procedure
     5336         (output v-sum-type-list
     5337         ) .
     5338       do v-ind = 1 to num-entries(v-sum-type-list)
     5339       :
     5340         run ahrstutl-store-tot in this-procedure
     5341           (input p-obj-type
     5342           ,input p-obj-code
     5343           ,input entry(v-ind, v-sum-type-list)
     5344           ,input v-first-day-end-fact-order
     5345           ,input v-last-day-end-fact-order
     5346           ) no-error .
     5347         if error-status :error
     5348         then do:
     5349           message
     5350             vss-workfile vss-revision vss-description skip
     5351             "Ошибка при вызове процедуры" 'ahrstutl-store-tot':u skip
     5352             "v-ind" v-ind skip
     5353             "sum-type" entry(v-ind, v-sum-type-list) skip
     5354             return-value skip
     5355             error-status :get-message(1) skip
     5356             view-as alert-box error .
     5357           undo, return error return-value .
     5358         end.
     5359       end.
     5360       run show-action in this-procedure
     5361         (input "Пересчитываем остаток по товару"
     5362         ).
     5363       define variable v-total-count as integer   no-undo .
     5364       for each buf_doclslib-goods no-lock
     5365       on error undo, return error return-value
     5366       :
     5367         assign
     5368           v-total-count = v-total-count + 1
     5369         .
     5370         if v-total-count modulo 10 = 0
     5371         then do:
     5372           run show-count in this-procedure
     5373             (input v-total-count
     5374             ,input "Артикул " + string(buf_doclslib-goods.artic)
     5375             ).
     5376         end.
     5377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     5378     (input  buf_doclslib-goods.gds-code
     5379     ,input  'gds-goods=request':u
     5380     ,output v-gds-goods
     5381     ) no-error .
     5382         run ahrstutl-line-sum-type-list in this-procedure
     5383           (input  v-gds-goods
     5384           ,output v-sum-type-list
     5385           ) .
     5386         do v-ind = 1 to num-entries(v-sum-type-list)
     5387         :
     5388           run ahrstutl-store-line in this-procedure
     5389             (input p-obj-type
     5390             ,input p-obj-code
     5391             ,input buf_doclslib-goods.gds-code
     5392             ,input entry(v-ind, v-sum-type-list)
     5393             ,input v-first-day-end-fact-order
     5394             ,input v-last-day-end-fact-order
     5395             ) no-error .
     5396           if error-status :error
     5397           then do:
     5398             message
     5399               vss-workfile vss-revision vss-description skip
     5400               "Ошибка при вызове процедуры" 'ahrstutl-store-line':u skip
     5401               "Объект" p-obj-type p-obj-code skip
     5402               "Артикул" buf_doclslib-goods.artic buf_doclslib-goods.prod-type buf_doclslib-goods.prod-code skip
     5403               "Код товара" buf_doclslib-goods.gds-code skip
     5404               return-value skip
     5405               error-status :get-message(1) skip
     5406               view-as alert-box error .
     5407             undo, return error return-value .
     5408           end.
     5409         end.
     5410       end.
     5411     end.
     5412   end procedure.
     5413   procedure ahrstutl-tot-sum-type-list :
     5414     define output parameter p-sum-type-list as character no-undo .
     5415     do
     5416     on error undo, return error return-value
     5417     :
     5418       define variable v-ind                    as integer   no-undo .
     5419       define variable v-num-entries-TDEDT_List as integer   no-undo .
     5420       assign
     5421         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5422       .
     5423       assign
     5424         p-sum-type-list =                 'r':U
     5425                         + chr(44) + 'c':U
     5426                         + chr(44) + 'b':U
     5427                         + chr(44) + 's':U
     5428                         + chr(44) + 'o':U
     5429                         + chr(44) + 'v':U
     5430       .
     5431       define variable v-ext-sum-type as character no-undo .
     5432       do v-ind = 1 to v-num-entries-TDEDT_List
     5433       :
     5434         run aht_get-stk-sum-type in this-procedure
     5435           (input  'r':U
     5436           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5437           ,output v-ext-sum-type
     5438           ) .
     5439         assign
     5440           p-sum-type-list = p-sum-type-list
     5441                           + chr(44)
     5442                           + v-ext-sum-type
     5443         .
     5444         run aht_get-stk-sum-type in this-procedure
     5445           (input  'c':U
     5446           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5447           ,output v-ext-sum-type
     5448           ) .
     5449         assign
     5450           p-sum-type-list = p-sum-type-list
     5451                           + chr(44)
     5452                           + v-ext-sum-type
     5453         .
     5454         run aht_get-stk-sum-type in this-procedure
     5455           (input  'b':U
     5456           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5457           ,output v-ext-sum-type
     5458           ) .
     5459         assign
     5460           p-sum-type-list = p-sum-type-list
     5461                           + chr(44)
     5462                           + v-ext-sum-type
     5463         .
     5464         run aht_get-stk-sum-type in this-procedure
     5465           (input  's':U
     5466           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5467           ,output v-ext-sum-type
     5468           ) .
     5469         assign
     5470           p-sum-type-list = p-sum-type-list
     5471                           + chr(44)
     5472                           + v-ext-sum-type
     5473         .
     5474         run aht_get-stk-sum-type in this-procedure
     5475           (input  'o':U
     5476           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5477           ,output v-ext-sum-type
     5478           ) .
     5479         assign
     5480           p-sum-type-list = p-sum-type-list
     5481                           + chr(44)
     5482                           + v-ext-sum-type
     5483         .
     5484         run aht_get-stk-sum-type in this-procedure
     5485           (input  'v':U
     5486           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5487           ,output v-ext-sum-type
     5488           ) .
     5489         assign
     5490           p-sum-type-list = p-sum-type-list
     5491                           + chr(44)
     5492                           + v-ext-sum-type
     5493         .
     5494       end.
     5495     end.
     5496   end procedure.
