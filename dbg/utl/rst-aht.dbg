     2117   procedure aht_update-ot-tot :
     2118     define input  parameter p-obj-type            like ub.trn-doc.obj-type     no-undo .
     2119     define input  parameter p-obj-code            like ub.trn-doc.obj-code     no-undo .
     2120     define input  parameter p-fact-order          like ub.trn-doc.fact-order   no-undo .
     2121     define input  parameter p-ext-doc-type        like ub.trn-doc.ext-doc-type no-undo .
     2122     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     2123     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     2124     do
     2125     on error undo, return error
     2126     :
     2127       for each buf_temp-aht-ot-line
     2128       on error undo, return error
     2129       :
     2130         find first buf_temp-aht-ot-tot
     2131           where buf_temp-aht-ot-tot.doc-code = buf_temp-aht-ot-line.doc-code
     2132             and buf_temp-aht-ot-tot.sum-type = buf_temp-aht-ot-line.sum-type
     2133           no-error .
     2134         if not available buf_temp-aht-ot-tot then do:
     2135           create buf_temp-aht-ot-tot .
     2136           assign
     2137             buf_temp-aht-ot-tot.doc-code     = buf_temp-aht-ot-line.doc-code
     2138             buf_temp-aht-ot-tot.sum-type     = buf_temp-aht-ot-line.sum-type
     2139             buf_temp-aht-ot-tot.ext-doc-type = p-ext-doc-type
     2140             buf_temp-aht-ot-tot.obj-type     = p-obj-type
     2141             buf_temp-aht-ot-tot.obj-code     = p-obj-code
     2142             buf_temp-aht-ot-tot.fact-order   = p-fact-order
     2143           .
     2144         end.
     2145         assign
     2146           buf_temp-aht-ot-tot.fact-qnty = buf_temp-aht-ot-tot.fact-qnty + buf_temp-aht-ot-line.fact-qnty
