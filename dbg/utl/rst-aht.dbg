     5707   procedure cb_rst-aht_overturn-exist :
     5708     define input  parameter p-artic          as character no-undo .
     5709     define input  parameter p-prod-type      as character no-undo .
     5710     define input  parameter p-prod-code      as integer   no-undo .
     5711     define output parameter p-overturn-exist as logical   no-undo .
     5712     define buffer buf_doclslib-goods for doclslib-goods .
     5713     do
     5714     on error undo, return error return-value
     5715     :
     5716       find first buf_doclslib-goods
     5717         where buf_doclslib-goods.artic     = p-artic
     5718           and buf_doclslib-goods.prod-type = p-prod-type
     5719           and buf_doclslib-goods.prod-code = p-prod-code
     5720         no-error .
     5721       if available buf_doclslib-goods
     5722       then do:
     5723         assign
     5724           p-overturn-exist = true
     5725         .
     5726       end.
     5727       else do:
     5728         assign
     5729           p-overturn-exist = false
     5730         .
     5731       end.
     5732     end.
     5733   end procedure.
     5734   procedure check-md5-signature :
     5735     define input  parameter p-obj-type     as character no-undo .
     5736     define input  parameter p-obj-code     as integer   no-undo .
     5737     define input  parameter p-archive-type as character no-undo .
     5738     define input  parameter p-file-name    as character no-undo .
     5739     define buffer buf_archive-history for ub.archive-history .
     5740     do
     5741     on error undo, return error return-value
     5742     :
     5743       find first buf_archive-history exclusive-lock
     5744         where buf_archive-history.obj-type     = p-obj-type
     5745           and buf_archive-history.obj-code     = p-obj-code
     5746           and buf_archive-history.archive-type = p-archive-type
     5747           and buf_archive-history.file-valid   = true
     5748           and buf_archive-history.file-name    = p-file-name
     5749         no-error .
     5750       if not available buf_archive-history
     5751       then do:
     5752         message
     5753           "Складской архив по типам приобретения" skip
     5754           "Объект" p-obj-type p-obj-code skip
     5755           "Отсутствует информация о выгрузке файла" skip
     5756           "Файл" p-file-name skip
     5757           view-as alert-box error .
     5758         undo, return error return-value .
     5759       end.
     5760       define variable v-md5-signature as character no-undo .
     5761       run gbl/md5.p
     5762         (input  p-file-name
     5763         ,output v-md5-signature
     5764         ) .
     5765       if v-md5-signature <> buf_archive-history.file-md5
     5766       then do:
     5767         message
     5768           "Складской архив по типам приобретения" skip
     5769           "Объект" p-obj-type p-obj-code skip
     5770           "Контрольная сумма файла не совпадает с информацией о выгрузке файла" skip
     5771           "Файл" p-file-name skip
     5772           "Контрольная сумма" v-md5-signature skip
     5773           "Информация о выгрузке файла" buf_archive-history.file-md5 skip
     5774           view-as alert-box error .
     5775         undo, return error return-value .
     5776       end.
     5777     end.
     5778   end procedure.
     5779   procedure invalidate-md5-signature :
     5780     define input  parameter p-obj-type     as character no-undo .
     5781     define input  parameter p-obj-code     as integer   no-undo .
     5782     define input  parameter p-archive-type as character no-undo .
     5783     define input  parameter p-file-name    as character no-undo .
     5784     define input  parameter p-chip-num     as integer   no-undo .
     5785     define buffer buf_archive-history for ub.archive-history .
     5786     do
     5787     on error undo, return error return-value
     5788     :
     5789       find first buf_archive-history exclusive-lock
     5790         where buf_archive-history.obj-type     = p-obj-type
     5791           and buf_archive-history.obj-code     = p-obj-code
     5792           and buf_archive-history.archive-type = p-archive-type
     5793           and buf_archive-history.file-valid   = true
     5794           and buf_archive-history.file-name    = p-file-name
     5795         no-error .
     5796       if available buf_archive-history
     5797       then do:
     5798         assign
     5799           buf_archive-history.file-valid            = false
     5800           buf_archive-history.file-invalid-chip-num = p-chip-num
     5801         .
     5802       end.
     5803     end.
     5804   end procedure.
