     2998   define buffer calc-aht-lock_batchprocess for ub.batchprocess .
     2999   define variable v-user-select         as logical   no-undo .
     3000   define variable v-obj-type            as character no-undo .
     3001   define variable v-obj-code            as integer   no-undo .
     3002   define variable v-file-name           as character no-undo .
     3003   define variable v-backup-file-name    as character no-undo .
