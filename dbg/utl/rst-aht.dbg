     2294       find last buf_aht-stk-line exclusive-lock
     2295         where buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
     2296           and buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
     2297           and buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
     2298           and buf_aht-stk-line.sum-type   = p-stk-sum-type
