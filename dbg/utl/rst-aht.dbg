        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: rst-aht.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: utl/rst-aht.p $":U .
        8   define variable vss-description as character no-undo initial "Восстановление складского архива по типам приобретения".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure cur-time :
       71      define output parameter p-today as date      no-undo .
       72      define output parameter p-time  as integer   no-undo .
       73     do
       74     on error undo, return error
       75     :
       76       define variable v-date1 as date      no-undo .
       77       define variable v-date2 as date      no-undo .
       78       define variable v-time  as integer   no-undo .
       79       assign
       80         v-date1 = today
       81         v-time  = time
       82         v-date2 = today
       83       .
       84       if v-date1 <> v-date2
       85       then do:
       86         assign
       87           v-date1 = today
       88           v-time  = v-time
       89         .
       90       end.
       91       assign
       92         p-today = v-date1
       93         p-time  = v-time
       94       .
       95     end.
       96   end.
       97   function cur-time-date returns character
       98   :
       99     return string(today, '99/99/9999':U) .
      100   end.
      101   function cur-time-mjd returns decimal
      102   :
      103     define variable v-date as date      no-undo .
      104     define variable v-time as integer   no-undo .
      105     run cur-time in this-procedure
      106       (output v-date
      107       ,output v-time
      108       ) .
      109     return integer(v-date) - 2400002 + (v-time / 86400) .
      110   end.
      111   function cur-time-get-ending-index returns integer
      112   (input p-number as integer
      113   )
      114   :
      115     if p-number < 0
      116     or p-number = ?
      117     then do:
      118       return 1 .
      119     end.
      120     define variable v-rest as integer   no-undo .
      121     assign
      122       p-number = p-number modulo 100
      123     .
      124     if p-number < 20
      125     then do:
      126       assign
      127         v-rest = p-number
      128       .
      129     end.
      130     else do:
      131       assign
      132         v-rest = p-number modulo 10
      133       .
      134     end.
      135     case v-rest :
      136       when 1
      137       then do:
      138         return 2 .
      139       end.
      140       when 2 or
      141       when 3 or
      142       when 4
      143       then do:
      144         return 3 .
      145       end.
      146       otherwise do:
      147         return 1 .
      148       end.
      149     end case .
      150   end.
      151   procedure cur-time-mjd-to-date :
      152      define input  parameter i-mjd-diff as decimal no-undo.
      153      define output parameter o-Date     as date    no-undo.
      154      define output parameter o-Time     as integer no-undo.
      155      define variable v-day-number as integer   no-undo .
      156      if    i-mjd-diff < 0
      157         or i-mjd-diff = ?
      158      then do:
      159         return "?" .
      160      end.
      161      assign
      162         v-day-number = truncate(i-mjd-diff,0).
      163         o-Date = date(v-day-number + 2400002).
      164         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      165     .
      166   end.
      167   function cur-time-mjd-to-string returns character
      168   (input p-mjd-diff as decimal
      169   )
      170   :
      171     define variable v-day-number as integer   no-undo .
      172     define variable v-seconds    as integer   no-undo .
      173     define variable v-hour       as integer   no-undo .
      174     define variable v-min        as integer   no-undo .
      175     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      176     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      177     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      178     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      179     if p-mjd-diff < 0
      180     or p-mjd-diff = ?
      181     then do:
      182       return "?" .
      183     end.
      184     assign
      185       v-day-number = integer(truncate(p-mjd-diff,0))
      186       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188     if v-seconds > 86400
      189     then do:
      190       assign
      191         v-seconds = 86400 - 1
      192       .
      193     end.
      194     if v-seconds < 0
      195     then do:
      196       assign
      197         v-seconds = 0
      198       .
      199     end.
      200     assign
      201       v-hour = truncate(v-seconds / 3600, 0)
      202     .
      203     assign
      204       v-seconds = v-seconds modulo 3600
      205     .
      206     assign
      207       v-min = truncate(v-seconds / 60, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 60
      211     .
      212     return
      213         (if v-day-number <> 0
      214           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0
      218           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      222           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      223           else ""
      224         )
      225       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      226       .
      227   end.
      228   function cur-time-string returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-string-sec returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      247   end.
      248   function cur-time-custom  returns character
      249   (input p-prefix as character
      250   ,input p-date-format as character
      251   ,input p-delimiter as character
      252   ,input p-time-format as character
      253   ,input p-suffix as character
      254   )
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return
      263       p-prefix
      264       + string(v-date, p-date-format)
      265       + p-delimiter
      266       + string(v-time, p-time-format)
      267       + p-suffix
      268       .
      269   end.
      270   function cur-time-print  returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-datetime returns datetime
      281   :
      282     define variable v-char as character no-undo .
      283     define variable v-datetime as datetime no-undo .
      284     v-char = cur-time-string().
      285     v-datetime = datetime(v-char).
      286     return  v-datetime.
      287   end.
      288   function cur-time-string-msec returns character
      289   :
      290     define variable v-date as datetime  no-undo .
      291     v-date = now.
      292     return string(v-date) .
      293   end.
      294   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   procedure factord :
      296     define input  parameter p-fact-date            as date    no-undo .
      297     define input  parameter p-fact-time            as integer no-undo .
      298     define input  parameter p-fact-num             as integer no-undo .
      299     define input  parameter p-shift-date           as date    no-undo .
      300     define input  parameter p-shift-num            as integer no-undo .
      301     define input  parameter p-shift-on             as logical no-undo .
      302     define output parameter p-fact-order           as decimal no-undo .
      303     define output parameter p-shift-end-fact-order as decimal no-undo .
      304     define output parameter p-day-end-fact-order   as decimal no-undo .
      305     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      306     if p-fact-date = ?
      307     then do:
      308       return error "Не указана фактическая дата" .
      309     end.
      310     define variable v-fact-date-num as integer no-undo .
      311     assign
      312       v-fact-date-num = integer(p-fact-date)
      313     .
      314     if p-fact-num = ?
      315     or p-fact-num = 0
      316     then do:
      317       return error "Не задан p-fact-num " + string(p-fact-num) .
      318     end.
      319     if p-fact-num < 0
      320     then do:
      321       return error "Отрицательный fact-num " + string(p-fact-num) .
      322     end.
      323     if p-fact-num >= 100000000
      324     then do:
      325       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      326     end.
      327     if p-shift-on = true
      328     then do:
      329       if p-shift-date = ?
      330       then do:
      331         return error "Не задана дата смены" .
      332       end.
      333       if p-shift-num = ?
      334       or p-shift-num = 0
      335       then do:
      336         return error "Не задан номер смены" .
      337       end.
      338     end.
      339     else do:
      340       assign
      341         p-shift-date = p-fact-date
      342         p-shift-num  = 24
      343       .
      344     end.
      345     define variable v-shift-offset as integer no-undo .
      346     if p-shift-date = p-fact-date
      347     then do:
      348       assign
      349         v-shift-offset = 1
      350       .
      351     end.
      352     if p-shift-date < p-fact-date
      353     then do:
      354       assign
      355         v-shift-offset = 0
      356       .
      357     end.
      358     if p-shift-date > p-fact-date
      359     then do:
      360       message
      361         vss-workfile vss-revision vss-description skip
      362         "Неправильная дата закрытия смены" skip
      363         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      364         view-as alert-box error .
      365       undo, return error
      366         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      367           ,string(p-fact-date, '99/99/9999':U)
      368           ,string(p-shift-date, '99/99/9999':U)
      369           )
      370       .
      371     end.
      372     if p-shift-num < 1
      373     or p-shift-num > 24
      374     then do:
      375       message
      376         vss-workfile vss-revision vss-description skip
      377         "Неправильный номер смены" skip
      378         "p-shift-num" p-shift-num skip
      379         view-as alert-box error .
      380       undo, return error return-value .
      381     end.
      382     assign
      383       p-fact-order           = v-fact-date-num
      384                              + v-shift-offset * 0.5
      385                              + p-shift-num    * 0.02 - 0.01
      386                              + p-fact-num     * 0.0000000001
      387       p-shift-end-fact-order = v-fact-date-num
      388                              + v-shift-offset * 0.5
      389                              + p-shift-num    * 0.02
      390       p-day-end-fact-order   = v-fact-date-num
      391                              + 0.99
      392     .
      393     if p-fact-order           <= v-fact-date-num
      394     or p-shift-end-fact-order <= v-fact-date-num
      395     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      396     or p-shift-end-fact-order >= p-day-end-fact-order
      397     then do:
      398       message
      399         vss-workfile vss-revision vss-description skip
      400         "Внутренняя ошибка при генерации фактического номера" skip
      401         "p-fact-date"            p-fact-date            skip
      402         "p-fact-time"            p-fact-time            skip
      403         "p-fact-num"             p-fact-num             skip
      404         "p-shift-date"           p-shift-date           skip
      405         "p-shift-num"            p-shift-num            skip
      406         "p-shift-on"             p-shift-on             skip
      407         "p-shift-end-fact-order" p-shift-end-fact-order skip
      408         "p-day-end-fact-order"   p-day-end-fact-order   skip
      409         "v-fact-date-num"        v-fact-date-num        skip
      410         view-as alert-box error .
      411       undo, return error return-value .
      412     end.
      413   end procedure.
      414   procedure day-begin-fact-order :
      415     define input  parameter p-fact-date            as date    no-undo .
      416     define output parameter p-day-begin-fact-order as decimal no-undo .
      417     do
      418     on error undo, return error return-value
      419     :
      420       if p-fact-date = ?
      421       then do:
      422         assign
      423           p-day-begin-fact-order = 0
      424         .
      425       end.
      426       else do:
      427         assign
      428           p-day-begin-fact-order = integer(p-fact-date)
      429         .
      430       end.
      431     end.
      432   end procedure.
      433   procedure factord-max-fact-order :
      434     define output parameter p-max-fact-order as decimal   no-undo .
      435     do
      436     on error undo, return error return-value
      437     :
      438       run day-begin-fact-order in this-procedure
      439         (input  date(1, 1, 5000)
      440         ,output p-max-fact-order
      441         ) .
      442     end.
      443   end procedure.
      444   procedure factord-cut-archive :
      445     define input  parameter p-obj-type             as character no-undo .
      446     define input  parameter p-obj-code             as integer   no-undo .
      447     define input  parameter p-fact-date            as date      no-undo .
      448     define output parameter p-shift-on             as logical   no-undo .
      449     define output parameter p-shift-date           as date      no-undo .
      450     define output parameter p-shift-num            as integer   no-undo .
      451     define output parameter p-day-end-fact-order   as decimal   no-undo .
      452     define output parameter p-shift-end-fact-order as decimal   no-undo .
      453     define variable v-fact-order as decimal   no-undo .
      454     define buffer buf_shift-obj for ub.shift-obj .
      455     do
      456     on error undo, return error return-value
      457     :
      458   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      460     (input  p-obj-type
      461     ,input  p-obj-code
      462     ,input  'shift-on=request'
      463     ,output p-shift-on
      464     ) no-error .
      465       if error-status :error
      466       then do:
      467         message
      468           vss-workfile vss-revision vss-description skip
      469           "Ошибка при определении атрибута объекта" skip
      470           "Объект" p-obj-type p-obj-code skip
      471           error-status :get-message(1) skip
      472           return-value skip
      473           view-as alert-box error .
      474         undo, return error return-value .
      475       end.
      476       if p-shift-on = false
      477       then do:
      478         assign
      479           p-shift-date               = ?
      480           p-shift-num                = 0
      481         .
      482       end.
      483       else do:
      484         find first buf_shift-obj share-lock
      485           where buf_shift-obj.obj-type   = p-obj-type
      486             and buf_shift-obj.obj-code   = p-obj-code
      487             and buf_shift-obj.shift-date > p-fact-date
      488           use-index pi
      489           no-error .
      490         if not available buf_shift-obj
      491         or buf_shift-obj.status_ <> 'зкр':U
      492         then do:
      493           message
      494             vss-workfile vss-revision vss-description skip
      495             "Невозможно вычислить последнюю смену" skip
      496             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      497             "Объект" p-obj-type p-obj-code skip
      498             "Дата" p-fact-date skip
      499             view-as alert-box error .
      500           undo, return error return-value .
      501         end.
      502         find last buf_shift-obj share-lock
      503           where buf_shift-obj.obj-type = p-obj-type
      504             and buf_shift-obj.obj-code = p-obj-code
      505             and buf_shift-obj.shift-date <= p-fact-date
      506           use-index pi
      507           no-error .
      508         if available buf_shift-obj
      509         then do:
      510           if  buf_shift-obj.status_ = 'зкр':U
      511           then do:
      512             assign
      513               p-shift-date = buf_shift-obj.shift-date
      514               p-shift-num  = buf_shift-obj.shift-num
      515             .
      516           end.
      517           else do:
      518             message
      519               vss-workfile vss-revision vss-description skip
      520               "Невозможно вычислить последнюю смену" skip
      521               "Статус смены отличен от статуса" 'зкр':U skip
      522               "Объект" p-obj-type p-obj-code skip
      523               "Дата" p-fact-date skip
      524               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      525               view-as alert-box error .
      526             undo, return error return-value .
      527           end.
      528         end.
      529         else do:
      530           assign
      531             p-shift-date = p-fact-date - 1
      532             p-shift-num  = 1
      533           .
      534         end.
      535       end.
      536       run factord in this-procedure
      537         (input  p-fact-date
      538         ,input  1
      539         ,input  1
      540         ,input  p-shift-date
      541         ,input  p-shift-num
      542         ,input  p-shift-on
      543         ,output v-fact-order
      544         ,output p-shift-end-fact-order
      545         ,output p-day-end-fact-order
      546         ) no-error .
      547       if error-status :error
      548       then do:
      549         message
      550           vss-workfile vss-revision vss-description skip
      551           "Ошибка при вызове процедуры factord"
      552           error-status :get-message(1) skip
      553           return-value skip
      554           view-as alert-box error .
      555         undo, return error return-value .
      556       end.
      557     end.
      558   end procedure.
      559   procedure factord-lock-shift :
      560     define input  parameter p-obj-type  as character no-undo .
      561     define input  parameter p-obj-code  as integer   no-undo .
      562     define input  parameter p-fact-date as date      no-undo .
      563     define parameter buffer buf_shift-obj for ub.shift-obj .
      564     define variable v-shift-on      as logical   no-undo .
      565     define variable v-extra-message as character no-undo .
      566     define variable v-error as character no-undo .
      567     do
      568     on error undo, return error return-value
      569     :
      570   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      572     (input  p-obj-type
      573     ,input  p-obj-code
      574     ,input  'shift-on=request'
      575     ,output v-shift-on
      576     ) no-error .
      577       if error-status :error
      578       then do:
      579         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      580         undo, return error v-error .
      581       end.
      582       if v-shift-on = true
      583       then do:
      584         find first buf_shift-obj share-lock
      585           where buf_shift-obj.obj-type   = p-obj-type
      586             and buf_shift-obj.obj-code   = p-obj-code
      587             and buf_shift-obj.shift-date > p-fact-date
      588           use-index pi
      589           no-error .
      590         if not available buf_shift-obj
      591         or buf_shift-obj.status_ <> 'зкр':U
      592         then do:
      593           find last buf_shift-obj
      594             where buf_shift-obj.obj-type = p-obj-type
      595               and buf_shift-obj.obj-code = p-obj-code
      596               and buf_shift-obj.status_  = 'зкр':U
      597             use-index stts
      598             no-error .
      599           if available buf_shift-obj
      600           then do:
      601             assign
      602               v-extra-message =
      603                     substitute("Дата начала последеней закрытой смены на объекте &1"
      604                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      605                               )
      606             .
      607           end.
      608           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      609           undo, return error v-error .
      610         end.
      611       end.
      612     end.
      613   end procedure.
      614   procedure factord-end-day :
      615     define input  parameter p-fact-date            as date    no-undo .
      616     define output parameter p-day-end-fact-order   as decimal no-undo .
      617     do
      618     on error undo, return error return-value
      619     :
      620       if p-fact-date = ?
      621       then do:
      622         return error "Не указана фактическая дата" .
      623       end.
      624       assign
      625         p-day-end-fact-order = integer(p-fact-date) + 0.99
      626       .
      627     end.
      628   end procedure.
      629   procedure factord-to-date :
      630     define input  parameter p-fact-order as decimal no-undo .
      631     define output parameter p-fact-date  as date    no-undo .
      632     define variable v-ref-date  as date      no-undo .
      633     define variable v-ref-delta as integer   no-undo .
      634     do
      635     on error undo, return error return-value
      636     :
      637       if p-fact-order = ?
      638       or p-fact-order = 0
      639       then do:
      640         return error "Не указан fact-order" .
      641       end.
      642       assign
      643         v-ref-date  = date(1, 1, 2000)
      644       .
      645       assign
      646         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      647       .
      648       assign
      649         p-fact-date = v-ref-date + v-ref-delta
      650       .
      651     end.
      652   end procedure.
      653   procedure factord-to-fact-num :
      654     define input  parameter p-fact-order as decimal no-undo .
      655     define output parameter p-fact-num   as integer no-undo .
      656     define variable v-fact-order-trunc as decimal no-undo .
      657     do
      658     on error undo, return error return-value
      659     :
      660       if p-fact-order = ?
      661       or p-fact-order = 0
      662       then do:
      663         return error "Не указан fact-order" .
      664       end.
      665       assign
      666        v-fact-order-trunc = truncate(p-fact-order, 2)
      667       .
      668       assign
      669         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      670       .
      671     end.
      672   end procedure.
      673   procedure factord-to-shift-num :
      674     define input  parameter p-fact-order as decimal no-undo .
      675     define output parameter p-shift-num   as integer no-undo .
      676     define variable  p-shift-numd  as decimal   no-undo .
      677     define variable v-fact-order-trunc as decimal no-undo .
      678     do
      679     on error undo, return error return-value
      680     :
      681       if p-fact-order = ?
      682       or p-fact-order = 0
      683       then do:
      684         return error "Не указан fact-order" .
      685       end.
      686       assign
      687        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      688       .
      689       if v-fact-order-trunc < 0.5 then do:
      690         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      691       end.
      692       assign
      693         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      694         .
      695        assign
      696         p-shift-num = truncate (p-shift-numd , 0)
      697       .
      698     end.
      699   end procedure.
