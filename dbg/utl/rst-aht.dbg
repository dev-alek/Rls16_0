     3040   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3042     (input  v-obj-type
     3043     ,input  v-obj-code
     3044     ,output v-today
     3045     )  .
     3046     define buffer restore-aht-lock_batchprocess for ub.batchprocess .
     3047     run gbl/lock-prc.p
     3048       (input 'rsat':U
     3049       ,input v-obj-code
     3050       ,input 0
     3051       ,input 0
     3052       ,input v-obj-type
     3053       ,input ""
     3054       ,input ""
     3055       ,input "Объект,,, ,,,Восстановление складского архива по типам приобретения"
     3056       ,input true
     3057       ,buffer restore-aht-lock_batchprocess
     3058       ) no-error .
     3059     if error-status :error
     3060     then do:
     3061       if error-status :get-message(1) <> ""
     3062       then do:
     3063         message
     3064           vss-workfile vss-revision vss-description skip
     3065           "Складской архив по типам приобретения" skip
     3066           "Объект" v-obj-type v-obj-code skip
     3067           "В данный момент восстанавливается складской архив по типам приобретения" skip
     3068           "Невозможно произвести восстановлением складского архива по типам приобретения" skip
     3069           view-as alert-box error .
     3070       end.
     3071       undo, return error "В данный момент восстанавливается складской архив по типам приобретения" .
     3072     end.
     3073     run gbl/lock-prc.p
     3074       (input 'ahtb':U
     3075       ,input v-obj-code
     3076       ,input 0
     3077       ,input 0
     3078       ,input v-obj-type
     3079       ,input ""
     3080       ,input ""
     3081       ,input "Объект,,, ,,,Расчёт складского архива по типам приобретения"
     3082       ,input true
     3083       ,buffer calc-aht-lock_batchprocess
     3084       ) no-error .
     3085     if error-status :error
     3086     then do:
     3087       if error-status :get-message(1) <> ""
     3088       then do:
     3089         message
     3090           vss-workfile vss-revision vss-description skip
     3091           "Складской архив по типам приобретения" skip
     3092           "Объект" v-obj-type v-obj-code skip
     3093           "В данный момент рассчитывается складской архив по типам приобтерения" skip
     3094           "Невозможно произвести восстановление складского архива по типам приобретения" skip
     3095           view-as alert-box error .
     3096       end.
     3097       undo, return error "В данный момент рассчитывается складской архив по типам приобретения" .
     3098     end.
     3099     define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     3100     run gbl/lockrngd.p
     3101       (input  'grar':U
     3102       ,input  'disable':U
     3103       ,buffer buf_lock_gdsrenart_batchprocess
     3104       ) no-error .
     3105     if error-status :error
     3106     then do:
     3107       if error-status :get-message(1) <> ""
     3108       then do:
