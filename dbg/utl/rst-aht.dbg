     2311           new-buf_aht-stk-line.sum-type   = p-stk-sum-type
     2312         .
     2313         if available buf_aht-stk-line then do:
     2314           assign
     2315             new-buf_aht-stk-line.fact-qnty = buf_aht-stk-line.fact-qnty
