     4195       ,input  v-action-type
     4196       ,input  ""
     4197       ,input  ""
     4198       ,input  0
     4199       ,input  ""
     4200       ,input  ""
     4201       ,input  v-restore-detail-date
     4202       ,output v-create-chip-num
     4203       ) .
     4204     run invalidate-md5-signature in this-procedure
     4205       (input  v-obj-type
     4206       ,input  v-obj-code
     4207       ,input  'aht':U
     4208       ,input  v-file-name
     4209       ,input  v-create-chip-num
     4210       ) .
     4211     run invalidate-md5-signature in this-procedure
     4212       (input  v-obj-type
     4213       ,input  v-obj-code
     4214       ,input  'aht':U
     4215       ,input  v-backup-file-name
     4216       ,input  v-create-chip-num
     4217       ) .
     4218     message
     4219       "Складской архив по типам приобретения" skip
     4220       "Объект" v-obj-type v-obj-code skip
     4221       "Восстановление складского архива по типам приобретения успешно закончилось" skip
     4222       "Объект" v-obj-type v-obj-code skip
     4223       "" + (if v-restore-detail-date <> ?
     4224            then substitute("На объекте существует подробный складской архив с даты &1", string(v-restore-detail-date, '99/99/9999':u))
     4225            else "На объекте существует складской архив с даты открытия объекта"
     4226            ) skip
     4227       view-as alert-box information .
     4228   end.
     4229   procedure restore-from-file :
     4230     do
     4231     on error undo, return error return-value
     4232     :
     4233       define variable v-key-value as character no-undo .
     4234       run show-action in this-procedure
     4235         (input "Импорт данных из файла " + v-file-name
     4236         ) .
     4237       define variable v-data-finished as logical   no-undo .
     4238       assign
     4239         v-data-finished = false
     4240       .
     4241       assign
     4242         v-line-num = 0
     4243       .
     4244       define variable v-total-count as integer   no-undo .
     4245       assign
     4246         v-total-count = 0
     4247       .
     4248       repeat
     4249       :
     4250         import stream sinp v-key-value .
     4251         assign
     4252           v-line-num = v-line-num + 1
     4253         .
     4254         assign
     4255           v-total-count = v-total-count + 1
     4256         .
     4257         if v-total-count modulo 10 = 0
     4258         then do:
     4259           run show-count in this-procedure
     4260             (input v-total-count
     4261             ,input "Чтение файла"
     4262             ) .
     4263         end.
     4264         case v-key-value :
     4265             when 'aht-doc':u then do:     define buffer buf_aht-doc for ub.aht-doc .     create buf_aht-doc .     import stream sinp buf_aht-doc no-error .     if error-status :error then do:       message         vss-workfile vss-revision vss-description skip         "Ошибка при импорте таблицы aht-doc" skip         "Строка" v-line-num skip         error-status :get-message(1) skip         view-as alert-box error .       undo, return error .     end.     assign       v-line-num = v-line-num + 1     .   end.
     4266             when 'aht-gds':u then do:     define buffer buf_aht-gds for ub.aht-gds .     create buf_aht-gds .     import stream sinp buf_aht-gds no-error .     if error-status :error then do:       message         vss-workfile vss-revision vss-description skip         "Ошибка при импорте таблицы aht-gds" skip         "Строка" v-line-num skip         error-status :get-message(1) skip         view-as alert-box error .       undo, return error .     end.     assign       v-line-num = v-line-num + 1     .   end.
     4267             when 'aht-stk':u then do:     define buffer buf_aht-stk for ub.aht-stk .     create buf_aht-stk .     import stream sinp buf_aht-stk no-error .     if error-status :error then do:       message         vss-workfile vss-revision vss-description skip         "Ошибка при импорте таблицы aht-stk" skip         "Строка" v-line-num skip         error-status :get-message(1) skip         view-as alert-box error .       undo, return error .     end.     assign       v-line-num = v-line-num + 1     .   end.
     4268             when 'aht-time':u then do:     define buffer buf_aht-time for ub.aht-time .     create buf_aht-time .     import stream sinp buf_aht-time no-error .     if error-status :error then do:       message         vss-workfile vss-revision vss-description skip         "Ошибка при импорте таблицы aht-time" skip         "Строка" v-line-num skip         error-status :get-message(1) skip         view-as alert-box error .       undo, return error .     end.     assign       v-line-num = v-line-num + 1     .   end.
     4269             when 'aht-ot-tot':u then do:     define buffer buf_aht-ot-tot for ub.aht-ot-tot .     create buf_aht-ot-tot .     import stream sinp buf_aht-ot-tot no-error .     if error-status :error then do:       message         vss-workfile vss-revision vss-description skip         "Ошибка при импорте таблицы aht-ot-tot" skip         "Строка" v-line-num skip         error-status :get-message(1) skip         view-as alert-box error .       undo, return error .     end.     assign       v-line-num = v-line-num + 1     .   end.
     4270             when 'aht-ot-line':u then do:     define buffer buf_aht-ot-line for ub.aht-ot-line .     create buf_aht-ot-line .     import stream sinp buf_aht-ot-line no-error .     if error-status :error then do:       message         vss-workfile vss-revision vss-description skip         "Ошибка при импорте таблицы aht-ot-line" skip         "Строка" v-line-num skip         error-status :get-message(1) skip         view-as alert-box error .       undo, return error .     end.     assign       v-line-num = v-line-num + 1     .   end.
     4271             when 'aht-stk-tot':u then do:     define buffer buf_aht-stk-tot for ub.aht-stk-tot .     create buf_aht-stk-tot .     import stream sinp buf_aht-stk-tot no-error .     if error-status :error then do:       message         vss-workfile vss-revision vss-description skip         "Ошибка при импорте таблицы aht-stk-tot" skip         "Строка" v-line-num skip         error-status :get-message(1) skip         view-as alert-box error .       undo, return error .     end.     assign       v-line-num = v-line-num + 1     .   end.
     4272             when 'aht-stk-line':u then do:     define buffer buf_aht-stk-line for ub.aht-stk-line .     create buf_aht-stk-line .     import stream sinp buf_aht-stk-line no-error .     if error-status :error then do:       message         vss-workfile vss-revision vss-description skip         "Ошибка при импорте таблицы aht-stk-line" skip         "Строка" v-line-num skip         error-status :get-message(1) skip         view-as alert-box error .       undo, return error .     end.     assign       v-line-num = v-line-num + 1     .   end.
     4273           when 'end-of-log':u
     4274           then do:
     4275             assign
     4276               v-data-finished = true
     4277             .
     4278             leave .
     4279           end.
     4280           otherwise do:
     4281             message
     4282               vss-workfile vss-revision vss-description skip
     4283               "Складской архив по типам приобретения" skip
     4284               "Объект" v-obj-type v-obj-code skip
     4285               "Неизвестный код таблицы" v-key-value skip
     4286               "Строка" v-line-num skip
     4287               view-as alert-box error .
     4288             undo, return error .
     4289           end.
     4290         end case .
     4291       end.
     4292       if v-data-finished = false
     4293       then do:
     4294         message
     4295           vss-workfile vss-revision vss-description skip
     4296           "Складской архив по типам приобретения" skip
     4297           "Объект" v-obj-type v-obj-code skip
     4298           "Не найден признак окончания данных" skip
     4299           "Неправильный формат файла" v-file-name skip
     4300           "Строка" v-line-num skip
     4301           view-as alert-box error .
     4302         undo, return error .
     4303       end.
     4304     end.
     4305   end procedure.
     4306   procedure validate-file-name :
     4307     define input parameter  p-obj-type            as character no-undo .
     4308     define input parameter  p-obj-code            as integer   no-undo .
     4309     define input parameter  v-aht-detail-date     as date      no-undo .
     4310     define input parameter  p-file-name           as character no-undo .
     4311     define output parameter p-restore-start-date  as date      no-undo .
     4312     define output parameter p-restore-detail-date as date      no-undo .
     4313     do
     4314     on error undo, return error
     4315     :
     4316       define variable v-param-code  as character no-undo .
     4317       define variable v-param-value as character no-undo .
     4318       import stream sinp v-param-code v-param-value .
     4319       assign
     4320         v-line-num = v-line-num + 1
     4321       .
     4322       if v-param-code <> 'archive-log-version':u
     4323       or v-param-value <> '2.1':u
     4324       then do:
     4325         message
     4326           "Складской архив по типам приобретения" skip
     4327           "Объект" p-obj-type p-obj-code skip
     4328           "Неправильный формат файла" p-file-name skip
     4329           "Строка" v-line-num skip
     4330           "Значения" v-param-code v-param-value skip
     4331           view-as alert-box error .
     4332         undo, return error .
     4333       end.
     4334       import stream sinp v-param-code v-param-value .
     4335       assign
     4336         v-line-num = v-line-num + 1
     4337       .
     4338       if v-param-code <> 'obj-type':u
     4339       or v-param-value <> p-obj-type
     4340       then do:
     4341         message
     4342           "Складской архив по типам приобретения" skip
     4343           "Объект" p-obj-type p-obj-code skip
     4344           "Неправильный формат файла" p-file-name skip
     4345           "Строка" v-line-num skip
     4346           "Значения" v-param-code v-param-value skip
     4347           view-as alert-box error .
     4348         undo, return error .
     4349       end.
     4350       import stream sinp v-param-code v-param-value .
     4351       assign
     4352         v-line-num = v-line-num + 1
     4353       .
     4354       if v-param-code <> 'obj-code':u
     4355       or v-param-value <> string(p-obj-code)
     4356       then do:
     4357         message
     4358           "Складской архив по типам приобретения" skip
     4359           "Объект" p-obj-type p-obj-code skip
     4360           "Неправильный формат файла" p-file-name skip
     4361           "Строка" v-line-num skip
     4362           "Значения" v-param-code v-param-value skip
     4363           view-as alert-box error .
     4364         undo, return error .
     4365       end.
     4366       import stream sinp v-param-code v-param-value .
     4367       assign
     4368         v-line-num = v-line-num + 1
     4369       .
     4370       if v-param-code <> 'old-start-date':u
     4371       then do:
     4372         message
     4373           "Складской архив по типам приобретения" skip
     4374           "Объект" p-obj-type p-obj-code skip
     4375           "Неправильный формат файла" p-file-name skip
     4376           "Строка" v-line-num skip
     4377           "Значения" v-param-code v-param-value skip
     4378           view-as alert-box error .
     4379         undo, return error .
     4380       end.
     4381       assign
     4382         p-restore-start-date = date(v-param-value)
     4383       .
     4384       import stream sinp v-param-code v-param-value .
     4385       assign
     4386         v-line-num = v-line-num + 1
     4387       .
     4388       if v-param-code <> 'old-detail-date':u
     4389       then do:
     4390         message
     4391           "Складской архив по типам приобретения" skip
     4392           "Объект" p-obj-type p-obj-code skip
     4393           "Неправильный формат файла" p-file-name skip
     4394           "Строка" v-line-num skip
     4395           "Значения" v-param-code v-param-value skip
     4396           view-as alert-box error .
     4397         undo, return error .
     4398       end.
     4399       assign
     4400         p-restore-detail-date = date(v-param-value)
     4401       .
     4402       import stream sinp v-param-code v-param-value .
     4403       assign
     4404         v-line-num = v-line-num + 1
     4405       .
     4406       if v-param-code <> 'new-start-date':u
     4407       then do:
     4408         message
     4409           "Складской архив по типам приобретения" skip
     4410           "Объект" p-obj-type p-obj-code skip
     4411           "Неправильный формат файла" p-file-name skip
     4412           "Строка" v-line-num skip
     4413           "Значения" v-param-code v-param-value skip
     4414           view-as alert-box error .
     4415         undo, return error .
     4416       end.
     4417       import stream sinp v-param-code v-param-value .
     4418       assign
     4419         v-line-num = v-line-num + 1
     4420       .
     4421       if v-param-code <> 'new-detail-date':u
     4422       then do:
     4423         message
     4424           "Складской архив по типам приобретения" skip
     4425           "Объект" p-obj-type p-obj-code skip
     4426           "Неправильный формат файла" p-file-name skip
     4427           "Строка" v-line-num skip
     4428           "Значения" v-param-code v-param-value skip
     4429           view-as alert-box error .
     4430         undo, return error .
     4431       end.
     4432       if v-aht-detail-date <> date(v-param-value)
     4433       then do:
     4434         message
     4435           "Складской архив по типам приобретения" skip
     4436           "Объект" p-obj-type p-obj-code skip
     4437           "Несоответствие текущей даты начала подробного архива" skip
     4438           "и даты начала подробного архива в файле" p-file-name skip
     4439           "Строка" v-line-num skip
     4440           "Текущая дата начала подробного архива" string(v-aht-detail-date) skip
     4441           "Дата начала подробного архива в файле" v-param-value skip
     4442           "Восстановление архива невозможно" skip
     4443           view-as alert-box error .
     4444         undo, return error .
     4445       end.
     4446     end.
     4447   end procedure.
     4448   procedure show-action :
     4449     do
     4450     on error undo, return error
     4451     :
     4452       define input parameter p-action as character no-undo .
     4453       assign
     4454         v-current-time = string(time - v-start-time, "HH:MM:SS")
     4455         v-current-action = p-action
     4456       .
     4457       display
     4458         v-current-time
     4459         v-current-action
     4460         with frame a.
     4461     end.
     4462   end procedure.
     4463   procedure show-count :
     4464     define input  parameter p-count      as integer   no-undo .
     4465     define input  parameter p-sub-action as character no-undo .
     4466     do
     4467     on error undo, return error
     4468     :
     4469       assign
     4470         v-current-time = string(time - v-start-time, "HH:MM:SS")
     4471         v-count        = p-count
     4472         v-sub-action   = p-sub-action
     4473       .
     4474       display
     4475         v-current-time
     4476         v-count
     4477         v-sub-action
     4478         with frame a.
     4479     end.
     4480   end procedure.
     4481   procedure create-log-file :
     4482     define input  parameter p-obj-type        as character no-undo .
     4483     define input  parameter p-obj-code        as integer   no-undo .
     4484     define input  parameter p-old-start-date  as date      no-undo .
     4485     define input  parameter p-old-detail-date as date      no-undo .
     4486     define input  parameter p-new-start-date  as date      no-undo .
     4487     define input  parameter p-new-detail-date as date      no-undo .
     4488     define input  parameter p-file-name       as character no-undo .
     4489     do
     4490     on error undo, return error
     4491     :
     4492       if search('.' + '/':u + p-file-name) <> ?
     4493       then do:
     4494         define variable v-ok as logical   no-undo .
     4495         message
     4496           "ВНИМАНИЕ!" skip
     4497           "Файл" p-file-name "существует и будет перезаписан" skip
     4498           "Продолжить?"
     4499           view-as alert-box question buttons yes-no update v-ok .
     4500         if v-ok <> true
     4501         then do:
     4502           undo, return error return-value .
     4503         end.
     4504       end.
     4505       output stream slog to value(p-file-name) .
     4506       export stream slog 'archive-log-version':u '2.1':u .
     4507       export stream slog 'obj-type':u            p-obj-type .
     4508       export stream slog 'obj-code':u            string(p-obj-code) .
     4509       export stream slog 'old-start-date':u      string(p-old-start-date, '99/99/9999':u ) .
     4510       export stream slog 'old-detail-date':u     string(p-old-detail-date, '99/99/9999':u ) .
     4511       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     4512       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     4513       output stream slog close .
     4514     end.
     4515   end procedure.
     4516   procedure close-log-file :
     4517     define input  parameter p-obj-type        as character no-undo .
     4518     define input  parameter p-obj-code        as integer   no-undo .
     4519     define input  parameter p-old-start-date  as date      no-undo .
     4520     define input  parameter p-old-detail-date as date      no-undo .
     4521     define input  parameter p-new-start-date  as date      no-undo .
     4522     define input  parameter p-new-detail-date as date      no-undo .
     4523     define input  parameter p-file-name       as character no-undo .
     4524     do
     4525     on error undo, return error
     4526     :
     4527       output stream slog to value(p-file-name) append .
     4528       export stream slog 'end-of-log':u .
     4529       export stream slog 'archive-log-version':u '2.1':u .
     4530       export stream slog 'obj-type':u            p-obj-type .
     4531       export stream slog 'obj-code':u            string(p-obj-code) .
     4532       export stream slog 'old-start-date':u      string(p-old-start-date, '99/99/9999':u ) .
     4533       export stream slog 'old-detail-date':u     string(p-old-detail-date, '99/99/9999':u ) .
     4534       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     4535       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     4536       export stream slog '.':u                   .
     4537       output stream slog close .
     4538     end.
     4539   end procedure.
     4540   procedure store-temp :
     4541     define buffer buf_temp-aht-stk-tot  for temp-aht-stk-tot .
     4542     define buffer buf_temp-aht-stk-line for temp-aht-stk-line .
     4543     define buffer buf_temp-create-aht-stk-tot  for temp-create-aht-stk-tot .
     4544     define buffer buf_temp-create-aht-stk-line for temp-create-aht-stk-line .
     4545     do
     4546     on error undo, return error return-value
     4547     :
     4548       output stream sout to value ("rst-aht.txt") append .
     4549       export stream sout 'export':u string(today, '99/99/9999':u) string(time, 'hh:mm:ss':u) .
     4550       for each buf_temp-aht-stk-tot
     4551       on error undo, return error return-value
     4552       :
     4553         export stream sout 'temp-aht-stk-tot':u .
     4554         export stream sout buf_temp-aht-stk-tot .
     4555       end.
     4556       for each buf_temp-aht-stk-line
     4557       on error undo, return error return-value
     4558       :
     4559         export stream sout 'temp-aht-stk-line':u .
     4560         export stream sout buf_temp-aht-stk-line .
     4561       end.
     4562       for each buf_temp-create-aht-stk-tot
     4563       on error undo, return error return-value
     4564       :
     4565         export stream sout 'temp-create-aht-stk-tot':u .
     4566         export stream sout buf_temp-create-aht-stk-tot .
     4567       end.
     4568       for each buf_temp-create-aht-stk-line
     4569       on error undo, return error return-value
     4570       :
     4571         export stream sout 'temp-create-aht-stk-line':u .
     4572         export stream sout buf_temp-create-aht-stk-line .
     4573       end.
     4574       output stream sout close .
     4575     end.
     4576   end procedure.
     4577   procedure ahrstutl-init :
     4578     define input  parameter p-obj-type           as character no-undo .
     4579     define input  parameter p-obj-code           as integer   no-undo .
     4580     define input  parameter p-fact-date          as date      no-undo .
     4581     define input  parameter p-sign               as integer   no-undo .
     4582     define variable v-shift-on                as logical   no-undo .
     4583     define variable v-shift-date              as date      no-undo .
     4584     define variable v-shift-num               as integer   no-undo .
     4585     define variable v-day-end-fact-order      as decimal   no-undo .
     4586     define variable v-shift-end-fact-order    as decimal   no-undo .
     4587     define variable v-search-end-fact-order   as decimal   no-undo .
     4588     define variable v-create-fact-order       as decimal   no-undo .
     4589     define variable v-shift-create-fact-order as decimal   no-undo .
     4590     define variable v-gds-goods     as logical   no-undo .
     4591     define variable v-sum-type-list as character no-undo .
     4592     do
     4593     on error undo, return error return-value
     4594     :
     4595       run factord-cut-archive in this-procedure
     4596         (input  p-obj-type
     4597         ,input  p-obj-code
     4598         ,input  p-fact-date
     4599         ,output v-shift-on
     4600         ,output v-shift-date
     4601         ,output v-shift-num
     4602         ,output v-day-end-fact-order
     4603         ,output v-shift-end-fact-order
     4604         ) .
     4605       assign
     4606         v-create-fact-order       = v-day-end-fact-order
     4607         v-shift-create-fact-order = v-shift-end-fact-order
     4608       .
     4609       if p-sign = -1
     4610       then do:
     4611         assign
     4612           v-day-end-fact-order   = v-day-end-fact-order - 0.0000000001
     4613           v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     4614         .
     4615       end.
     4616       define variable v-ind as integer   no-undo .
     4617       run show-action in this-procedure
     4618         (input "Остаток по объекту"
     4619         ).
     4620       run ahrstutl-tot-sum-type-list in this-procedure
     4621         (output v-sum-type-list
     4622         ) .
     4623       do v-ind = 1 to num-entries(v-sum-type-list)
     4624       :
     4625         run ahrstutl-init-tot in this-procedure
     4626           (input p-obj-type
     4627           ,input p-obj-code
     4628           ,input entry(v-ind, v-sum-type-list)
     4629           ,input v-day-end-fact-order
     4630           ,input v-create-fact-order
     4631           ,input p-sign
     4632           ) .
     4633       end.
     4634       run show-action in this-procedure
     4635         (input "Остаток по товарам"
     4636         ).
     4637       define variable v-total-count as integer   no-undo .
     4638       define buffer buf_doclslib-goods for doclslib-goods.
     4639       for each buf_doclslib-goods no-lock
     4640       on error undo, return error return-value
     4641       :
     4642         assign
     4643           v-total-count = v-total-count + 1
     4644         .
     4645         if v-total-count modulo 10 = 0
     4646         then do:
     4647           run show-count in this-procedure
     4648             (input v-total-count
     4649             ,input "Артикул " + string(buf_doclslib-goods.artic)
     4650             ).
     4651         end.
     4652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     4653     (input  buf_doclslib-goods.gds-code
     4654     ,input  'gds-goods=request':u
     4655     ,output v-gds-goods
     4656     ) no-error .
     4657         run ahrstutl-line-sum-type-list in this-procedure
     4658           (input  v-gds-goods
     4659           ,output v-sum-type-list
     4660           ) .
     4661         do v-ind = 1 to num-entries(v-sum-type-list)
     4662         :
     4663           run ahrstutl-init-line in this-procedure
     4664             (input p-obj-type
     4665             ,input p-obj-code
     4666             ,input buf_doclslib-goods.gds-code
     4667             ,input entry(v-ind, v-sum-type-list)
     4668             ,input v-day-end-fact-order
     4669             ,input v-create-fact-order
     4670             ,input p-sign
     4671             ) .
     4672         end.
     4673       end.
     4674     end.
     4675   end procedure.
     4676   procedure ahrstutl-init-tot :
     4677     define input  parameter p-obj-type               as character no-undo .
     4678     define input  parameter p-obj-code               as integer   no-undo .
     4679     define input  parameter p-sum-type               as character no-undo .
     4680     define input  parameter p-aht-stk-tot-fact-order as decimal   no-undo .
     4681     define input  parameter p-create-tot-fact-order  as decimal   no-undo .
     4682     define input  parameter p-sign                   as integer   no-undo .
