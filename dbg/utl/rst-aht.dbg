     5642   procedure ahrstutl-store-line :
     5643     define input  parameter p-obj-type                 as character no-undo .
     5644     define input  parameter p-obj-code                 as integer   no-undo .
     5645     define input  parameter p-gds-code                 as integer   no-undo .
     5646     define input  parameter p-sum-type                 as character no-undo .
     5647     define input  parameter p-first-day-end-fact-order as decimal   no-undo .
     5648     define input  parameter p-last-day-end-fact-order  as decimal   no-undo .
     5649     define buffer buf_aht-stk-line for ub.aht-stk-line .
     5650     define buffer buf_temp-aht-stk-line for temp-aht-stk-line .
     5651     do
     5652     on error undo, return error return-value
     5653     :
     5654       for each buf_temp-aht-stk-line
     5655         where buf_temp-aht-stk-line.obj-type  = p-obj-type
     5656           and buf_temp-aht-stk-line.obj-code  = p-obj-code
     5657           and buf_temp-aht-stk-line.gds-code  = p-gds-code
     5658           and buf_temp-aht-stk-line.sum-type  = p-sum-type
     5659       on error undo, return error return-value
     5660       :
     5661         if buf_temp-aht-stk-line.fact-qnty <> 0
     5662         or
     5663                                 buf_temp-aht-stk-line.cost-sum-base       <> 0 or    buf_temp-aht-stk-line.cost-sum-rubl       <> 0 or    buf_temp-aht-stk-line.cost-vat-base       <> 0 or    buf_temp-aht-stk-line.cost-vat-rubl       <> 0 or    buf_temp-aht-stk-line.cost-slt-base       <> 0 or    buf_temp-aht-stk-line.cost-slt-rubl       <> 0 or    buf_temp-aht-stk-line.cost-road-tax-base  <> 0 or    buf_temp-aht-stk-line.cost-road-tax-rubl  <> 0 or    buf_temp-aht-stk-line.cost-excise-base    <> 0 or    buf_temp-aht-stk-line.cost-excise-rubl    <> 0 or    buf_temp-aht-stk-line.cost-transport-base <> 0 or    buf_temp-aht-stk-line.cost-transport-rubl <> 0 or    buf_temp-aht-stk-line.cost-other-base     <> 0 or    buf_temp-aht-stk-line.cost-other-rubl     <> 0 or    buf_temp-aht-stk-line.cost-discnt-base    <> 0 or    buf_temp-aht-stk-line.cost-discnt-rubl    <> 0
     5664         or
     5665                                 buf_temp-aht-stk-line.crsa-sum-base       <> 0 or    buf_temp-aht-stk-line.crsa-sum-rubl       <> 0 or    buf_temp-aht-stk-line.crsa-vat-base       <> 0 or    buf_temp-aht-stk-line.crsa-vat-rubl       <> 0 or    buf_temp-aht-stk-line.crsa-slt-base       <> 0 or    buf_temp-aht-stk-line.crsa-slt-rubl       <> 0 or    buf_temp-aht-stk-line.crsa-road-tax-base  <> 0 or    buf_temp-aht-stk-line.crsa-road-tax-rubl  <> 0 or    buf_temp-aht-stk-line.crsa-excise-base    <> 0 or    buf_temp-aht-stk-line.crsa-excise-rubl    <> 0 or    buf_temp-aht-stk-line.crsa-transport-base <> 0 or    buf_temp-aht-stk-line.crsa-transport-rubl <> 0 or    buf_temp-aht-stk-line.crsa-other-base     <> 0 or    buf_temp-aht-stk-line.crsa-other-rubl     <> 0 or    buf_temp-aht-stk-line.crsa-discnt-base    <> 0 or    buf_temp-aht-stk-line.crsa-discnt-rubl    <> 0
     5666         or
     5667                                 buf_temp-aht-stk-line.sale-sum-base       <> 0 or    buf_temp-aht-stk-line.sale-sum-rubl       <> 0 or    buf_temp-aht-stk-line.sale-vat-base       <> 0 or    buf_temp-aht-stk-line.sale-vat-rubl       <> 0 or    buf_temp-aht-stk-line.sale-slt-base       <> 0 or    buf_temp-aht-stk-line.sale-slt-rubl       <> 0 or    buf_temp-aht-stk-line.sale-road-tax-base  <> 0 or    buf_temp-aht-stk-line.sale-road-tax-rubl  <> 0 or    buf_temp-aht-stk-line.sale-excise-base    <> 0 or    buf_temp-aht-stk-line.sale-excise-rubl    <> 0 or    buf_temp-aht-stk-line.sale-transport-base <> 0 or    buf_temp-aht-stk-line.sale-transport-rubl <> 0 or    buf_temp-aht-stk-line.sale-other-base     <> 0 or    buf_temp-aht-stk-line.sale-other-rubl     <> 0 or    buf_temp-aht-stk-line.sale-discnt-base    <> 0 or    buf_temp-aht-stk-line.sale-discnt-rubl    <> 0
     5668         then do:
     5669           find first buf_aht-stk-line exclusive-lock
     5670             where buf_aht-stk-line.obj-type   = buf_temp-aht-stk-line.obj-type
     5671               and buf_aht-stk-line.obj-code   = buf_temp-aht-stk-line.obj-code
     5672               and buf_aht-stk-line.gds-code   = buf_temp-aht-stk-line.gds-code
     5673               and buf_aht-stk-line.sum-type   = buf_temp-aht-stk-line.sum-type
     5674               and buf_aht-stk-line.fact-order <= p-first-day-end-fact-order
     5675             no-error .
     5676           if not available buf_aht-stk-line
     5677           then do:
     5678             create buf_aht-stk-line .
     5679             assign
     5680               buf_aht-stk-line.obj-type   = buf_temp-aht-stk-line.obj-type
     5681               buf_aht-stk-line.obj-code   = buf_temp-aht-stk-line.obj-code
     5682               buf_aht-stk-line.gds-code   = buf_temp-aht-stk-line.gds-code
     5683               buf_aht-stk-line.fact-order = p-first-day-end-fact-order
     5684               buf_aht-stk-line.sum-type   = buf_temp-aht-stk-line.sum-type
     5685             .
     5686           end.
     5687           for each buf_aht-stk-line exclusive-lock
     5688             where buf_aht-stk-line.obj-type   = buf_temp-aht-stk-line.obj-type
     5689               and buf_aht-stk-line.obj-code   = buf_temp-aht-stk-line.obj-code
     5690               and buf_aht-stk-line.gds-code   = buf_temp-aht-stk-line.gds-code
     5691               and buf_aht-stk-line.sum-type   = buf_temp-aht-stk-line.sum-type
     5692               and buf_aht-stk-line.fact-order <= p-last-day-end-fact-order - 0.0000000001
     5693           on error undo, return error return-value
     5694           :
     5695             assign
     5696               buf_aht-stk-line.fact-qnty = buf_aht-stk-line.fact-qnty
     5697                                         + buf_temp-aht-stk-line.fact-qnty
