     3118     define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     3119     run gbl/lockrngd.p
     3120       (input  'grgc':U
     3121       ,input  'disable':U
     3122       ,buffer buf_lock_gdsrengc_batchprocess
     3123       ) no-error .
     3124     if error-status :error
     3125     then do:
     3126       if error-status :get-message(1) <> ""
     3127       then do:
     3128         message
     3129           vss-workfile vss-revision vss-description skip
     3130           "Ошибка при блокировании функции переименования кода товара" skip
     3131           error-status :get-message(1) skip
     3132           return-value skip
     3133           view-as alert-box error .
     3134       end.
     3135       undo, return error return-value .
     3136     end.
     3137     define variable v-attr-value as character no-undo .
     3138     define variable v-attr-type  as character no-undo .
     3139     define variable v-aht-calc          as logical   no-undo .
     3140     define variable v-aht-del           as logical   no-undo .
     3141     define variable v-aht-start-date    as date      no-undo .
     3142     define variable v-aht-detail-date   as date      no-undo .
     3143     define variable v-aht-recalc-date   as date      no-undo .
     3144     run clntattr-value in this-procedure
     3145       (input  v-obj-type
     3146       ,input  v-obj-code
     3147       ,input  'aht-calc':U
     3148       ,output v-attr-value
     3149       ,output v-attr-type
     3150       ) .
     3151     assign
     3152       v-aht-calc = (lookup(v-attr-value, 'yes,true') > 0)
     3153     .
     3154     run clntattr-value in this-procedure
     3155       (input  v-obj-type
     3156       ,input  v-obj-code
     3157       ,input  'aht-del':U
     3158       ,output v-attr-value
     3159       ,output v-attr-type
     3160       ) .
     3161     assign
     3162       v-aht-del = (lookup(v-attr-value, 'yes,true') > 0)
     3163     .
     3164     run clntattr-value in this-procedure
     3165       (input  v-obj-type
     3166       ,input  v-obj-code
     3167       ,input  'aht-start':U
     3168       ,output v-attr-value
     3169       ,output v-attr-type
     3170       ) .
     3171     assign
     3172       v-aht-start-date = date(v-attr-value)
     3173     .
     3174     run clntattr-value in this-procedure
     3175       (input  v-obj-type
     3176       ,input  v-obj-code
     3177       ,input  'aht-detail':U
     3178       ,output v-attr-value
     3179       ,output v-attr-type
     3180       ) .
     3181     assign
     3182       v-aht-detail-date = date(v-attr-value)
     3183     .
     3184     run clntattr-value in this-procedure
     3185       (input  v-obj-type
     3186       ,input  v-obj-code
     3187       ,input  'aht-recalc':U
     3188       ,output v-attr-value
     3189       ,output v-attr-type
     3190       ) .
     3191     assign
     3192       v-aht-recalc-date = date(v-attr-value)
     3193     .
     3194     if (v-aht-start-date <> ?
     3195        and v-aht-detail-date = ?)
     3196     or (v-aht-start-date = ?
     3197        and v-aht-detail-date <> ?)
     3198     then do:
     3199       message
     3200         "Складской архив по типам приобретения" skip
     3201         "Объект" v-obj-type v-obj-code skip
     3202         "Невозможно произвести восстановление складского архива по типам приобретения" skip
     3203         "Противоречивая информация в датах инициализации складского архива" skip
     3204         "Дата начала складского архива по типам приобретения" string(v-aht-start-date, '99/99/9999':u) skip
     3205         "Дата начала подробного складского архива по типам приобретения" string(v-aht-detail-date, '99/99/9999':u) skip
     3206         view-as alert-box error .
     3207       undo, return error return-value .
     3208     end.
     3209     if v-aht-detail-date = ?
     3210     then do:
     3211       message
     3212         "Складской архив по типам приобретения" skip
     3213         "Объект" v-obj-type v-obj-code skip
     3214         "На объекте рассчитан складской архив по типам приобретения за все даты" skip
     3215         "Операция восстановления не может быть произведена" skip
     3216         view-as alert-box information .
     3217       return .
     3218     end.
     3219     define variable v-year  as integer   no-undo .
     3220     define variable v-month as integer   no-undo .
     3221     define variable v-day   as integer   no-undo .
     3222     assign
     3223       v-year  = year(v-aht-detail-date)
     3224       v-month = month(v-aht-detail-date)
     3225       v-day   = day(v-aht-detail-date)
     3226     .
     3227     assign
     3228       v-file-name = 'ahtdel':u
     3229                   + '_':u
     3230                   + (if v-obj-type = 'скл':U then 'stock':u else 'shop':u)
     3231                   + '_':u
     3232                   + string(v-obj-code)
     3233                   + '_':u
     3234                   + string(v-year, '9999':u)
     3235                   + string(v-month, '99':u)
     3236                   + string(v-day, '99':u)
     3237                   + '.txt'
     3238     .
     3239     assign
     3240       v-backup-file-name = entry(1, v-file-name, '.') + '.rst':u
     3241     .
     3242     define variable v-full-file-name    as character no-undo .
     3243     define variable v-full-backup-name  as character no-undo .
     3244     define variable v-restore-from-file as logical   no-undo .
     3245     define variable v-restore-backup    as logical   no-undo .
     3246     assign
     3247       v-full-file-name = search(v-file-name)
     3248     .
     3249     if v-full-file-name = ?
     3250     or v-full-file-name = ""
     3251     then do:
     3252       assign
     3253         v-restore-from-file = false
     3254       .
     3255     end.
     3256     else do:
     3257       assign
     3258         v-restore-from-file = true
     3259       .
     3260     end.
     3261     assign
     3262       v-full-backup-name = search(v-backup-file-name)
     3263     .
     3264     if v-full-backup-name = ?
     3265     or v-full-backup-name = ""
     3266     then do:
     3267       assign
     3268         v-restore-backup = false
     3269       .
     3270     end.
     3271     else do:
     3272       assign
     3273         v-restore-backup = true
     3274       .
     3275     end.
     3276     define variable v-num as integer   no-undo .
     3277     run gbl/d-askw.w
     3278       (input "Вопрос"
     3279       ,input substitute("Объект &1 &2", v-obj-type, v-obj-code) + chr(10)
     3280              + "Произвести восстановление подробного складского архива по типам приобретения" + chr(10)
     3281              + "Дата начала подробного складского архива по типам приобретения " + string(v-aht-detail-date, '99/99/9999':U) + chr(10)
     3282              + "Сегодня " + string(v-today, '99/99/9999':U) + chr(10)
     3283       ,input '|^':u
     3284       ,input "Из файла" + '^confirm':u + (if v-restore-from-file = true then '':u else '^disable':u)
     3285       + '|':u + "Резервная копия" + '^confirm':u + (if v-restore-backup = true then '':u else '^disable':u)
     3286       + '|':u + "Документы" + '^confirm':u + (if v-aht-del = true then '^disable':u else '':u)
