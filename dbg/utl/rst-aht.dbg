     2445   procedure aht_add-document :
     2446     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
     2447     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
     2448     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
     2449     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
     2450     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
     2451     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
     2452     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
     2453     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
     2454     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
     2455     define buffer buf_aht-doc for ub.aht-doc .
     2456     do
     2457     on error undo, return error return-value
     2458     :
     2459       find first buf_aht-doc exclusive-lock
     2460         where buf_aht-doc.doc-code = p-doc-code
     2461         no-error .
     2462       if available buf_aht-doc then do:
     2463         message
     2464           vss-workfile vss-revision vss-description skip
     2465           vss-include-info8 skip
     2466           "Попытка повторного создания записи" skip
     2467           "Документ" p-doc-code skip
     2468           view-as alert-box error .
     2469         undo, return error .
     2470       end.
     2471       if p-fact-order = ?
     2472       or p-fact-order = 0
     2473       then do:
     2474         message
     2475           vss-workfile vss-revision vss-description skip
     2476           vss-include-info8 skip
     2477           "Ошибка задания входных параметров" skip
     2478           "Не задан номер документа" skip
     2479           "Документ" p-doc-code skip
     2480           "Номер документа" p-fact-order skip
     2481           view-as alert-box error .
     2482         undo, return error .
     2483       end.
     2484       create buf_aht-doc .
     2485       assign
     2486         buf_aht-doc.doc-code     = p-doc-code
     2487         buf_aht-doc.obj-type     = p-obj-type
     2488         buf_aht-doc.obj-code     = p-obj-code
     2489         buf_aht-doc.ext-doc-type = p-ext-doc-type
     2490         buf_aht-doc.is-trn-doc   = p-is-trn-doc
     2491         buf_aht-doc.fact-order   = p-fact-order
     2492         buf_aht-doc.fact-date    = p-fact-date
     2493         buf_aht-doc.shift-date   = p-shift-date
     2494         buf_aht-doc.shift-num    = p-shift-num
     2495       .
     2496     end.
     2497   end procedure.
     2498   procedure aht_add-date :
     2499     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
     2500     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
     2501     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
     2502     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
     2503     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
     2504     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
     2505     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
     2506     define buffer buf_aht-stk for ub.aht-stk .
     2507     do
     2508     on error undo, return error return-value
     2509     :
     2510       find first buf_aht-stk no-lock
     2511         where buf_aht-stk.obj-type   = p-obj-type
     2512           and buf_aht-stk.obj-code   = p-obj-code
     2513           and buf_aht-stk.stk-type   = p-stk-type
     2514           and buf_aht-stk.fact-order = p-fact-order
     2515         no-error .
     2516       if not available buf_aht-stk then do:
     2517         create buf_aht-stk .
     2518         assign
     2519           buf_aht-stk.obj-type   = p-obj-type
     2520           buf_aht-stk.obj-code   = p-obj-code
     2521           buf_aht-stk.stk-type   = p-stk-type
     2522           buf_aht-stk.fact-order = p-fact-order
     2523           buf_aht-stk.fact-date  = p-fact-date
     2524           buf_aht-stk.shift-date = p-shift-date
     2525           buf_aht-stk.shift-num  = p-shift-num
     2526         .
     2527       end.
     2528     end.
     2529   end procedure.
     2530   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2531   define variable v-waitfram-action01         as character   no-undo .
     2532   define variable v-waitfram-action02         as character   no-undo .
     2533   define variable v-waitfram-action03         as character   no-undo .
     2534   define variable mWaitFramTextBeg            as character   no-undo.
     2535   define variable mWaitFramTextEnd            as character   no-undo.
     2536   define variable mWaitFramView               as logical     no-undo.
     2537   define variable mWaitProcEvent              as logical     no-undo init yes.
     2538   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2539   define variable mWaitFramStop               as logical     no-undo.
     2540   define variable mWaitFramStopUser           as logical     no-undo.
     2541   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2542   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2543   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2544   define button B-WaitFramStop auto-end-key
     2545        label "Стоп"
     2546        size 10 by 1 tooltip "Остоновить процесс".
     2547   define button B-viewProcInfo
     2548        label "Информация"
     2549        size 15 by 1 tooltip "Информация о процесс".
     2550   define frame waitfram
     2551     v-waitfram-action01 format "x(72)" no-label skip
     2552     v-waitfram-action02 format "x(72)" no-label skip
     2553     v-waitfram-action03 format "x(72)" no-label skip
     2554     B-viewProcInfo
     2555     B-WaitFramStop at row 4 col 30
     2556     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2557     .
     2558   define new global shared variable mBatchMode as logical no-undo init ?.
     2559   define variable mFramBachModHandle as handle no-undo.
     2560   mFramBachModHandle = frame waitfram:handle.
     2561   define variable mFameOldVis as logical no-undo.
     2562   define variable mVisCUrentVin as logical no-undo.
     2563   if session:batch-mode
     2564   then
     2565      mBatchMode = yes.
     2566   if mBatchMode = ? then do:
     2567     mVisCUrentVin = current-window:visible.
     2568     mFameOldVis = mFramBachModHandle:visible.
     2569     mFramBachModHandle:visible  = yes.
     2570     mBatchMode = mFramBachModHandle:visible ne yes.
     2571     mFramBachModHandle:visible = mFameOldVis.
     2572     current-window:visible = mVisCUrentVin.
     2573   end.
     2574    if  log-manager:logfile-name ne ?
     2575     then DO:
     2576         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2577         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2578         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2579     end.
     2580   on choose of B-WaitFramStop in frame waitfram
     2581   do:
     2582     mWaitFramStop = yes.
     2583     mWaitFramStopUser = yes.
     2584   end.
     2585   function waitfram-check-timeout returns logical():
     2586      define variable vtime as int64 no-undo.
     2587      if mWaitFramStopTimeOut
     2588      then
     2589         return yes.
     2590      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2591      if     mWaitFramTimeOut ne ?
     2592         and mWaitFramTimeOut ne 0
     2593         and mWaitFramTimeOut lt vtime
     2594      then do:
     2595         mWaitFramStopTimeOut = yes.
     2596      end.
     2597      return mWaitFramStopTimeOut.
     2598   end.
     2599   procedure waitfram-hide :
     2600     if not session:batch-mode
     2601     then do
     2602     on error undo, return error return-value
     2603     :
     2604       pause 0 before-hide .
     2605       if not mBatchMode then
     2606         hide frame waitfram .
     2607     if     not mWaitFramView
     2608        and mWaitProcEvent
     2609     then
     2610       process events .
     2611     end.
     2612   end procedure.
     2613   procedure waitfram-show :
     2614     define input  parameter p-message as character no-undo .
     2615     define variable v-left-margin as integer   no-undo .
     2616     if not session:batch-mode
     2617     then do
     2618     on error undo, return error return-value
     2619     :
     2620       if length(p-message) <= 70 then do:
     2621         assign
     2622           v-left-margin = integer((70 - length(p-message)) / 2)
     2623         .
     2624         assign
     2625           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2626         .
     2627         assign
     2628           v-waitfram-action01 = " "
     2629           v-waitfram-action02 = " "
     2630                                    + fill(" ", v-left-margin)
     2631                                    + p-message
     2632           v-waitfram-action03 = " "
     2633         .
     2634       end.
     2635       else do:
     2636         define variable vRindex1 as integer no-undo.
     2637         define variable vRindex2 as integer no-undo.
     2638         vRindex1 = r-index(p-message," ",70).
     2639         if vRindex1 = 0
     2640         then
     2641            vRindex1 = 70.
     2642         if length(p-message)  <= vRindex1 + 70 then do:
     2643           assign
     2644             v-waitfram-action01 = " "
     2645             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2646             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2647           .
     2648         end.
     2649         else do:
     2650           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2651           if vRindex2 <= vRindex1
     2652           then
     2653              vRindex2 = vRindex1 + 70.
     2654           assign
     2655             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2656             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2657             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2658           .
     2659         end.
     2660       end.
     2661       B-viewProcInfo:visible   in frame waitfram = no.
     2662       B-viewProcInfo:sensitive in frame waitfram = no.
     2663       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2664       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2665       if  (   mWaitFramView
     2666          or  mWaitProcEvent)
     2667          and not mBatchMode
     2668       then
     2669          display
     2670             v-waitfram-action01 skip
     2671             v-waitfram-action02 skip
     2672             v-waitfram-action03 skip
     2673          with frame waitfram .
     2674       if     mWaitFramView
     2675          then do:
     2676             if     mWaitFramInterval ne ?
     2677                and not mBatchMode
     2678             then
     2679                wait-for go of frame waitfram pause mWaitFramInterval.
     2680          end.
     2681          else
     2682             if     mWaitProcEvent
     2683                and not mBatchMode
     2684             then
     2685                process events .
     2686     end.
     2687   end procedure.
     2688      procedure waitfram-show-this:
     2689         define input  parameter iInterval as int64 no-undo.
     2690         define variable vtime as int64 no-undo.
     2691         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2692         mWaitFramInterval = iInterval.
     2693         run waitfram-show (substitute("&1&2 &3&4" ,
     2694                                       mWaitFramTextBeg ,
     2695                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2696                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2697                                       mWaitFramTextEnd
     2698                                      )
     2699                           ).
     2700      end.
     2701      procedure WaitFramRunPause:
     2702         define input  parameter iInterval as dec no-undo.
     2703         define variable vStart  as datetime-tz no-undo.
     2704         define variable vend    as datetime-tz no-undo.
     2705         define variable vint as int64 no-undo.
     2706         define variable vOk as logical no-undo.
     2707         vStart = now.
     2708         vend   = vStart.
     2709         publish "WaitFramPause" (iInterval,output vOk).
     2710         vend   =  now.
     2711         vint = vend - vStart.
     2712         vint = iInterval - vint / 1000.
     2713         if     not mWaitFramStop
     2714            and (   vint > 0
     2715                 or (    not vOk
     2716                     and iInterval eq ?
     2717                     )
     2718                 )
     2719         then
     2720            run waitfram-show-this (iInterval).
     2721         vend   =  now.
     2722         vint = vend - vStart.
     2723         vint = iInterval - vint / 1000.
     2724         if     not mWaitFramStop
     2725            and vint > 0
     2726         then do:
     2727            run gbl/pause.p (vint * 1000).
     2728         end.
     2729         if iInterval ne ?
     2730         then
     2731            publish "WaitFramStop".
     2732         waitfram-check-timeout().
     2733      end.
     2734      procedure WaitFramWaitFor:
     2735         define input  parameter iInterval as dec no-undo.
     2736         assign
     2737            mWaitFramStartProc   = now
     2738            mWaitFramStopUser    = no
     2739            mWaitFramStopTimeOut = no
     2740         .
     2741         block-wait:
     2742         do while not mWaitFramStop:
     2743            run WaitFramRunPause (iInterval).
     2744            if  waitfram-check-timeout()
     2745            then do:
     2746               leave block-wait.
     2747            end.
     2748         end.
     2749         run waitfram-hide.
     2750      end.
     2751   procedure waitfram-join :
     2752     define input  parameter p-line-1  as character no-undo .
     2753     define input  parameter p-line-2  as character no-undo .
     2754     define input  parameter p-line-3  as character no-undo .
     2755     define output parameter p-message as character no-undo .
     2756     do
     2757     on error undo, return error return-value
     2758     :
     2759       assign
     2760         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2761                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2762                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2763       .
     2764     end.
     2765   end procedure.
     2766   function waitfram-join-function returns character
     2767     (input p-line-1 as character
     2768     ,input p-line-2 as character
     2769     ,input p-line-3 as character
     2770     ).
     2771     define variable v-message as character no-undo .
     2772     run waitfram-join in this-procedure
     2773       (input  p-line-1
     2774       ,input  p-line-2
     2775       ,input  p-line-3
     2776       ,output v-message
     2777       ) .
     2778     return v-message .
     2779   end function .
     2780   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2781     define variable v-cntxt-db-num        as integer   no-undo .
     2782     define variable v-cntxt-userid        as character no-undo .
     2783     define variable v-cntxt-level         as character no-undo .
     2784     define variable v-cntxt-host-code-obj as integer   no-undo .
     2785     define variable v-cntxt-obj-type      as character no-undo .
     2786     define variable v-cntxt-obj-code      as integer   no-undo .
     2787     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2788     define variable v-cntxt-is-admin      as logical   no-undo .
     2789   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790   define temp-table userobjs_temp-user-obj no-undo
     2791     field obj-type as character
     2792     field obj-code as integer
     2793     index xpk is primary unique obj-type obj-code
     2794     .
     2795   procedure userobjs_clear :
     2796     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2797     do
     2798     on error undo, return error return-value
     2799     :
     2800       for each buf_userobjs_temp-user-obj
     2801       on error undo, return error return-value
     2802       :
     2803         delete buf_userobjs_temp-user-obj .
     2804       end.
     2805     end.
     2806   end .
     2807   procedure userobjs_object-count :
     2808     define output parameter p-total-count as integer   no-undo .
     2809     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2810     do
     2811     on error undo, return error return-value
     2812     :
     2813       assign
     2814         p-total-count = 0
     2815       .
     2816       for each buf_userobjs_temp-user-obj
     2817       on error undo, return error return-value
     2818       :
     2819         assign
     2820           p-total-count = p-total-count + 1
     2821         .
     2822       end.
     2823     end.
     2824   end.
     2825   procedure userobjs_append :
     2826      define input  parameter p-obj-type as character no-undo .
     2827      define input  parameter p-obj-code as integer   no-undo .
     2828     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2829     do
     2830     on error undo, return error return-value
     2831     :
     2832       find first buf_userobjs_temp-user-obj
     2833         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     2834           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     2835         no-error .
     2836       if not available buf_userobjs_temp-user-obj
     2837       then do:
     2838         create buf_userobjs_temp-user-obj .
     2839         assign
     2840           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     2841           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     2842         .
     2843       end.
     2844     end.
     2845   end.
     2846   procedure userobjs_object-exist :
     2847     define output parameter p-object-exist as logical   no-undo .
     2848     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2849     do
     2850     on error undo, return error return-value
     2851     :
     2852       find first buf_userobjs_temp-user-obj
     2853         no-error .
     2854       if not available buf_userobjs_temp-user-obj
     2855       then do:
     2856         assign
     2857           p-object-exist = false
     2858         .
     2859       end.
     2860       else do:
     2861         assign
     2862           p-object-exist = true
     2863         .
     2864       end.
     2865     end.
     2866   end.
     2867   procedure userobjs_transfer :
     2868     define input  parameter p-callback-handle as handle no-undo .
     2869     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     2870     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2871     do
     2872     on error undo, return error return-value
     2873     :
     2874       if valid-handle(p-callback-handle) <> true
     2875       then do:
     2876         message
     2877           vss-workfile vss-revision vss-description skip
     2878           "Ошибка задания входных параметров" skip
     2879           "Неизвестный указатель на процедуру" skip
     2880           view-as alert-box error .
     2881         undo, return error return-value .
     2882       end.
     2883       if p-callback-handle :get-signature("userobjs_append") = ""
     2884       then do:
     2885         message
     2886           vss-workfile vss-revision vss-description skip
     2887           "Ошибка задания входных параметров" skip
     2888           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     2889                     ,p-callback-handle :file-name
     2890                     ) skip
     2891           view-as alert-box error .
     2892         undo, return error return-value .
     2893       end.
     2894       for each buf_userobjs_temp-user-obj
     2895       on error undo, return error return-value
     2896       :
     2897         run userobjs_append in p-callback-handle
     2898           (input  buf_userobjs_temp-user-obj.obj-type
     2899           ,input  buf_userobjs_temp-user-obj.obj-code
     2900           ) .
     2901       end.
     2902     end.
     2903   end procedure.
     2904   procedure userobjs_select-one :
     2905      define input  parameter parparentproc     as widget-handle no-undo .
