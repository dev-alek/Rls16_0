     3979         (input  v-obj-type
     3980         ,input  v-obj-code
     3981         ,input  v-start-day-end-fact-order
     3982         ,input  v-aht-detail-date - 1
     3983         ) .
     3984       find current calc-aht-lock_batchprocess no-lock .
