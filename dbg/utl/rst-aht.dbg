     4141         (input v-obj-type
     4142         ,input v-obj-code
     4143         ,input 'aht-start':U
     4144         ,input string(v-restore-start-date, '99/99/9999':u)
     4145         ) no-error .
     4146       if error-status :error
     4147       then do:
     4148         message
     4149           vss-workfile vss-revision vss-description skip
     4150           "Ошибка при записи даты начала складского архива по типам приобретения" skip
     4151           error-status :get-message(1) skip
     4152           return-value skip
     4153           view-as alert-box error .
     4154         undo, return error .
     4155       end.
     4156       run clntattr-write in this-procedure
     4157         (input v-obj-type
     4158         ,input v-obj-code
     4159         ,input 'aht-detail':U
     4160         ,input string(v-restore-detail-date, '99/99/9999':u)
     4161         ) no-error .
     4162       if error-status :error
     4163       then do:
     4164         message
     4165           vss-workfile vss-revision vss-description skip
     4166           "Ошибка при записи даты начала подробного складского архива по типам приобретения" skip
     4167           error-status :get-message(1) skip
     4168           return-value skip
     4169           view-as alert-box error .
     4170         undo, return error .
     4171       end.
     4172       define variable v-delete-aht-rest as logical   no-undo .
     4173       run clntattr-delete in this-procedure
     4174         (input  v-obj-type
     4175         ,input  v-obj-code
     4176         ,input  'aht-rest':U
     4177         ,output v-delete-aht-rest
     4178         ) .
     4179     end.
     4180     if v-restore-from-file = true
     4181     then do:
