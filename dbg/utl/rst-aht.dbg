     3010   on error undo, return error return-value
     3011   :
     3012     define variable rid-list as character no-undo .
     3013   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3014     run mainmenu_getcntxt in parparentproc
     3015       (output v-cntxt-db-num
