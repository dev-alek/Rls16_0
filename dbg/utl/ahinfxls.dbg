        1   block-level on error undo, throw.
        2   define input  parameter p-ah-infov-handle as handle    no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision: bbf1530230d5, 2753, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Сб фев 20 15:59:21 2021 +0300 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: ahinfxls.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: utl/ahinfxls.p $":U .
        8   define variable vss-description as character no-undo initial "Печать информации по складским архивам по товарам, по поставщикам, по типам приобретени".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64   define variable v-waitfram-action01         as character   no-undo .
       65   define variable v-waitfram-action02         as character   no-undo .
       66   define variable v-waitfram-action03         as character   no-undo .
       67   define variable mWaitFramTextBeg            as character   no-undo.
       68   define variable mWaitFramTextEnd            as character   no-undo.
       69   define variable mWaitFramView               as logical     no-undo.
       70   define variable mWaitProcEvent              as logical     no-undo init yes.
       71   define variable mWaitFramInterval           as integer     no-undo init 1 .
       72   define variable mWaitFramStop               as logical     no-undo.
       73   define variable mWaitFramStopUser           as logical     no-undo.
       74   define variable mWaitFramStopTimeOut        as logical     no-undo.
       75   define variable mWaitFramStartProc          as datetime-tz no-undo.
       76   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       77   define button B-WaitFramStop auto-end-key
       78        label "Стоп"
       79        size 10 by 1 tooltip "Остоновить процесс".
       80   define button B-viewProcInfo
       81        label "Информация"
       82        size 15 by 1 tooltip "Информация о процесс".
       83   define frame waitfram
       84     v-waitfram-action01 format "x(72)" no-label skip
       85     v-waitfram-action02 format "x(72)" no-label skip
       86     v-waitfram-action03 format "x(72)" no-label skip
       87     B-viewProcInfo
       88     B-WaitFramStop at row 4 col 30
       89     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       90     .
       91   define new global shared variable mBatchMode as logical no-undo init ?.
       92   define variable mFramBachModHandle as handle no-undo.
       93   mFramBachModHandle = frame waitfram:handle.
       94   define variable mFameOldVis as logical no-undo.
       95   define variable mVisCUrentVin as logical no-undo.
       96   if session:batch-mode
       97   then
       98      mBatchMode = yes.
       99   if mBatchMode = ? then do:
      100     mVisCUrentVin = current-window:visible.
      101     mFameOldVis = mFramBachModHandle:visible.
      102     mFramBachModHandle:visible  = yes.
      103     mBatchMode = mFramBachModHandle:visible ne yes.
      104     mFramBachModHandle:visible = mFameOldVis.
      105     current-window:visible = mVisCUrentVin.
      106   end.
      107    if  log-manager:logfile-name ne ?
      108     then DO:
      109         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      110         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      111         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      112     end.
      113   on choose of B-WaitFramStop in frame waitfram
      114   do:
      115     mWaitFramStop = yes.
      116     mWaitFramStopUser = yes.
      117   end.
      118   function waitfram-check-timeout returns logical():
      119      define variable vtime as int64 no-undo.
      120      if mWaitFramStopTimeOut
      121      then
      122         return yes.
      123      vtime = ( now - mWaitFramStartProc ) / 1000 .
      124      if     mWaitFramTimeOut ne ?
      125         and mWaitFramTimeOut ne 0
      126         and mWaitFramTimeOut lt vtime
      127      then do:
      128         mWaitFramStopTimeOut = yes.
      129      end.
      130      return mWaitFramStopTimeOut.
      131   end.
      132   procedure waitfram-hide :
      133     if not session:batch-mode
      134     then do
      135     on error undo, return error return-value
      136     :
      137       pause 0 before-hide .
      138       if not mBatchMode then
      139         hide frame waitfram .
      140     if     not mWaitFramView
      141        and mWaitProcEvent
      142     then
      143       process events .
      144     end.
      145   end procedure.
      146   procedure waitfram-show :
      147     define input  parameter p-message as character no-undo .
      148     define variable v-left-margin as integer   no-undo .
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       if length(p-message) <= 70 then do:
      154         assign
      155           v-left-margin = integer((70 - length(p-message)) / 2)
      156         .
      157         assign
      158           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      159         .
      160         assign
      161           v-waitfram-action01 = " "
      162           v-waitfram-action02 = " "
      163                                    + fill(" ", v-left-margin)
      164                                    + p-message
      165           v-waitfram-action03 = " "
      166         .
      167       end.
      168       else do:
      169         define variable vRindex1 as integer no-undo.
      170         define variable vRindex2 as integer no-undo.
      171         vRindex1 = r-index(p-message," ",70).
      172         if vRindex1 = 0
      173         then
      174            vRindex1 = 70.
      175         if length(p-message)  <= vRindex1 + 70 then do:
      176           assign
      177             v-waitfram-action01 = " "
      178             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      179             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      180           .
      181         end.
      182         else do:
      183           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      184           if vRindex2 <= vRindex1
      185           then
      186              vRindex2 = vRindex1 + 70.
      187           assign
      188             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      189             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      191           .
      192         end.
      193       end.
      194       B-viewProcInfo:visible   in frame waitfram = no.
      195       B-viewProcInfo:sensitive in frame waitfram = no.
      196       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       if  (   mWaitFramView
      199          or  mWaitProcEvent)
      200          and not mBatchMode
      201       then
      202          display
      203             v-waitfram-action01 skip
      204             v-waitfram-action02 skip
      205             v-waitfram-action03 skip
      206          with frame waitfram .
      207       if     mWaitFramView
      208          then do:
      209             if     mWaitFramInterval ne ?
      210                and not mBatchMode
      211             then
      212                wait-for go of frame waitfram pause mWaitFramInterval.
      213          end.
      214          else
      215             if     mWaitProcEvent
      216                and not mBatchMode
      217             then
      218                process events .
      219     end.
      220   end procedure.
      221      procedure waitfram-show-this:
      222         define input  parameter iInterval as int64 no-undo.
      223         define variable vtime as int64 no-undo.
      224         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      225         mWaitFramInterval = iInterval.
      226         run waitfram-show (substitute("&1&2 &3&4" ,
      227                                       mWaitFramTextBeg ,
      228                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      229                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      230                                       mWaitFramTextEnd
      231                                      )
      232                           ).
      233      end.
      234      procedure WaitFramRunPause:
      235         define input  parameter iInterval as dec no-undo.
      236         define variable vStart  as datetime-tz no-undo.
      237         define variable vend    as datetime-tz no-undo.
      238         define variable vint as int64 no-undo.
      239         define variable vOk as logical no-undo.
      240         vStart = now.
      241         vend   = vStart.
      242         publish "WaitFramPause" (iInterval,output vOk).
      243         vend   =  now.
      244         vint = vend - vStart.
      245         vint = iInterval - vint / 1000.
      246         if     not mWaitFramStop
      247            and (   vint > 0
      248                 or (    not vOk
      249                     and iInterval eq ?
      250                     )
      251                 )
      252         then
      253            run waitfram-show-this (iInterval).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and vint > 0
      259         then do:
      260            run gbl/pause.p (vint * 1000).
      261         end.
      262         if iInterval ne ?
      263         then
      264            publish "WaitFramStop".
      265         waitfram-check-timeout().
      266      end.
      267      procedure WaitFramWaitFor:
      268         define input  parameter iInterval as dec no-undo.
      269         assign
      270            mWaitFramStartProc   = now
      271            mWaitFramStopUser    = no
      272            mWaitFramStopTimeOut = no
      273         .
      274         block-wait:
      275         do while not mWaitFramStop:
      276            run WaitFramRunPause (iInterval).
      277            if  waitfram-check-timeout()
      278            then do:
      279               leave block-wait.
      280            end.
      281         end.
      282         run waitfram-hide.
      283      end.
      284   procedure waitfram-join :
      285     define input  parameter p-line-1  as character no-undo .
      286     define input  parameter p-line-2  as character no-undo .
      287     define input  parameter p-line-3  as character no-undo .
      288     define output parameter p-message as character no-undo .
      289     do
      290     on error undo, return error return-value
      291     :
      292       assign
      293         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      294                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      296       .
      297     end.
      298   end procedure.
      299   function waitfram-join-function returns character
      300     (input p-line-1 as character
      301     ,input p-line-2 as character
      302     ,input p-line-3 as character
      303     ).
      304     define variable v-message as character no-undo .
      305     run waitfram-join in this-procedure
      306       (input  p-line-1
      307       ,input  p-line-2
      308       ,input  p-line-3
      309       ,output v-message
      310       ) .
      311     return v-message .
      312   end function .
      313   DEFINE VARIABLE chExcelApplication      AS COM-HANDLE no-undo .
      314   DEFINE VARIABLE chWorkbook              AS COM-HANDLE no-undo .
      315   DEFINE VARIABLE chWorksheet             AS COM-HANDLE no-undo .
      316   define variable cColumn       as character no-undo .
      317   define variable cRange        as character no-undo .
      318   if not valid-handle(p-ah-infov-handle)
      319   then do:
      320     message
      321       vss-workfile vss-revision vss-description skip
      322       "Ошибка задания входных параметров" skip
      323       "Неизвестная ссылка на программу" p-ah-infov-handle skip
      324       view-as alert-box error .
      325     undo, return error return-value .
      326   end.
      327   CREATE "Excel.Application" chExcelApplication no-error.
      328       if error-status :error then do:
      329           message
      330           "Ошибка при запуске Excel" skip
      331           error-status :get-message(1) skip
      332           view-as alert-box error .
      333           undo, return error .
      334       end.
      335   assign
      336     chExcelApplication:Visible = false
      337     chWorkbook = chExcelApplication:Workbooks:Add ()
      338   .
      339   assign
      340     chWorkSheet = chExcelApplication:Sheets:Item (1)
      341     chExcelApplication:Interactive = false
      342     chExcelApplication:ScreenUpdating = false
      343     chWorkSheet:Name = "Признаки"
      344     chWorkSheet:PageSetup:PrintGridlines     = TRUE
      345     chWorkSheet:Range ("A1"):Value           = "Архивы на объектах"
      346     chWorkSheet:Range ("A1:A1"):Font:Bold    = TRUE
      347     chWorkSheet:Range ("A2"):Value           = "Номер БД"
      348     chWorkSheet:Columns ("A":U):ColumnWidth  = 7
      349     chWorkSheet:Columns ("A":U):NumberFormat = fill ("#", 5) + "0"
      350     chWorkSheet:Range ("B2"):Value           = "Объект"
      351     chWorkSheet:Columns ("B":U):ColumnWidth  = 7
      352     chWorkSheet:Columns ("B":U):NumberFormat = "@"
      353     chWorkSheet:Range ("C2"):Value           = "Тип"
      354     chWorkSheet:Columns ("C":U):ColumnWidth  = 10
      355     chWorkSheet:Columns ("C":U):NumberFormat = "@"
      356     chWorkSheet:Range ("D2"):Value           = "Не рассчитан оборот"
      357     chWorkSheet:Columns ("D":U):ColumnWidth  = 5
      358     chWorkSheet:Columns ("D":U):NumberFormat = "@"
      359     chWorkSheet:Range ("E2"):Value           = "Не рассчитан нач.остаток"
      360     chWorkSheet:Columns ("E":U):ColumnWidth  = 5
      361     chWorkSheet:Columns ("E":U):NumberFormat = "@"
      362     chWorkSheet:Range ("F2"):Value           = "Расчет архива выключен"
      363     chWorkSheet:Columns ("F":U):ColumnWidth  = 5
      364     chWorkSheet:Columns ("F":U):NumberFormat = "@"
      365     chWorkSheet:Range ("G2"):Value           = "Сбой удал./восст."
      366     chWorkSheet:Columns ("G":U):ColumnWidth  = 5
      367     chWorkSheet:Columns ("G":U):NumberFormat = "@"
      368     chWorkSheet:Range ("H2"):Value           = "Задания на расчет"
      369     chWorkSheet:Columns ("H":U):ColumnWidth  = 5
      370     chWorkSheet:Columns ("H":U):NumberFormat = "@"
      371     chWorkSheet:Range ("I2"):Value           = "Подробный"
      372     chWorkSheet:Columns ("I":U):ColumnWidth  = 10
      373     chWorkSheet:Columns ("I":U):NumberFormat = "@"
      374     chWorkSheet:Range ("J2"):Value           = "Сжатый"
      375     chWorkSheet:Columns ("J":U):ColumnWidth  = 10
      376     chWorkSheet:Columns ("J":U):NumberFormat = "@"
      377     chWorkSheet:Range ("K2"):Value           = "Перерасчет"
      378     chWorkSheet:Columns ("K":U):ColumnWidth  = 10
      379     chWorkSheet:Columns ("K":U):NumberFormat = "@"
      380     chWorkSheet:Range ("A2:K2"):Font:Bold = TRUE
      381     chWorkSheet:Range ("A2:K2"):Interior:ColorIndex = 35
      382     .
      383   run waitfram-show in this-procedure
      384     (input "Экспорт в EXCEL. Ждите ..."
      385     ).
      386   define variable v-rid as recid no-undo .
      387   define variable v-ind as integer   no-undo .
      388   run ah-infov_get-first in p-ah-infov-handle .
      389   do while true
      390   :
      391     define variable v-available                as logical   no-undo .
      392     define variable v-db-num                   as integer   no-undo .
      393     define variable v-obj-type                 as character no-undo .
      394     define variable v-obj-code                 as integer   no-undo .
      395     define variable v-archive-type             as character no-undo .
      396     define variable v-deleted                  as logical   no-undo .
      397     define variable v-archive-calc             as logical   no-undo .
      398     define variable v-archive-del              as logical   no-undo .
      399     define variable v-archive-disable          as logical   no-undo .
      400     define variable v-archive-rest             as logical   no-undo .
      401     define variable v-archive-bpexist          as logical   no-undo .
      402     define variable v-archive-detail-date      as date      no-undo .
      403     define variable v-archive-start-date       as date      no-undo .
      404     define variable v-archive-date-recalc      as date      no-undo .
      405     define variable v-archive-lock-prc         as logical   no-undo .
      406     define variable v-archive-execuser         as character no-undo .
      407     define variable v-archive-execsysdate      as date      no-undo .
      408     define variable v-archive-execsystime      as character no-undo .
      409     define variable v-archive-rest-lock-prc    as logical   no-undo .
      410     define variable v-archive-rest-execuser    as character no-undo .
      411     define variable v-archive-rest-execsysdate as date      no-undo .
      412     define variable v-archive-rest-execsystime as character no-undo .
      413     define variable v-archive-type-name     as character no-undo .
      414     run ah-infov_get-current in p-ah-infov-handle
      415       (output v-available
      416       ,output v-db-num
      417       ,output v-obj-type
      418       ,output v-obj-code
      419       ,output v-archive-type
      420       ,output v-deleted
      421       ,output v-archive-calc
      422       ,output v-archive-del
      423       ,output v-archive-disable
      424       ,output v-archive-rest
      425       ,output v-archive-bpexist
      426       ,output v-archive-detail-date
      427       ,output v-archive-start-date
      428       ,output v-archive-date-recalc
      429       ,output v-archive-lock-prc
      430       ,output v-archive-execuser
      431       ,output v-archive-execsysdate
      432       ,output v-archive-execsystime
      433       ,output v-archive-rest-lock-prc
      434       ,output v-archive-rest-execuser
      435       ,output v-archive-rest-execsysdate
      436       ,output v-archive-rest-execsystime
      437       ) .
      438     if v-available <> true
      439     then do:
      440       leave .
      441     end.
      442     run ah-infov_archive-type-name-proc in p-ah-infov-handle
      443       (input  v-archive-type
      444       ,output v-archive-type-name
      445       ) .
      446     assign
      447       v-ind = v-ind + 1
      448     .
      449     run waitfram-show in this-procedure
      450       (input substitute("Экспортировано в EXCEL строк: &1", v-ind)
      451       ).
      452     assign
      453       cColumn = STRING (v-ind + 2)
      454       cRange = "A":U + cColumn
      455       chWorkSheet:Range (cRange):Value = v-db-num
      456       cRange = "B":U + cColumn
      457       chWorkSheet:Range (cRange):Value = substitute("&1 &2", v-obj-type, v-obj-code)
      458       cRange = "C":U + cColumn
      459       chWorkSheet:Range (cRange):Value = v-archive-type-name
      460       cRange = "D":U + cColumn
      461       chWorkSheet:Range (cRange):Value = string(v-archive-calc, '+/-':u)
      462       cRange = "E":U + cColumn
      463       chWorkSheet:Range (cRange):Value = string(v-archive-del, '+/-':u)
      464       cRange = "F":U + cColumn
      465       chWorkSheet:Range (cRange):Value = string(v-archive-disable, '+/-':u)
      466       cRange = "G":U + cColumn
      467       chWorkSheet:Range (cRange):Value = string(v-archive-rest, '+/-':u)
      468       cRange = "H":U + cColumn
      469       chWorkSheet:Range (cRange):Value = string(v-archive-bpexist, '+/-':u)
      470       cRange = "I":U + cColumn
      471       chWorkSheet:Range (cRange):Value = string(v-archive-detail-date, '99/99/9999':u)
      472       cRange = "J":U + cColumn
      473       chWorkSheet:Range (cRange):Value = string(v-archive-start-date, '99/99/9999':u)
      474       cRange = "K":U + cColumn
      475       chWorkSheet:Range (cRange):Value = string(v-archive-date-recalc, '99/99/9999':u)
      476     .
      477     run ah-infov_get-next in p-ah-infov-handle .
      478   END.
      479   run waitfram-hide in this-procedure .
      480   assign
      481     chExcelApplication:Interactive = true
      482     chExcelApplication:ScreenUpdating = true
      483     chExcelApplication:Visible = true
      484   .
      485   RELEASE OBJECT chWorksheet NO-ERROR.
      486   RELEASE OBJECT chWorkbook NO-ERROR.
      487   chExcelApplication :QUIT().
      488   RELEASE OBJECT  chExcelApplication  NO-ERROR.
