        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: test-ptr.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/test-ptr.p $":U .
        7   define variable vss-description as character no-undo init "test".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   do
       67   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       68   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       69   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       70   :
       71     define variable v-file-name as character no-undo .
       72     define variable v-sign      as decimal   no-undo .
       73     define variable v-after     as decimal   no-undo .
       74     define variable v-cli-qnty  as decimal   no-undo .
       75     define buffer buf_sys-ctrl for ub.sys-ctrl .
       76     define buffer buf_doc-line for ub.doc-line .
       77     define buffer buf_inv-line for ub.inv-line .
       78     define stream out-stream.
       79     find first buf_sys-ctrl no-lock.
       80     assign
       81       v-after = 0.0
       82       v-file-name = substitute( "doc-ln-&1.txt", buf_sys-ctrl.db-num)
       83     .
       84     output stream out-stream to value(v-file-name) append.
       85     put stream out-stream unformatted skip(5) "<<<<<<<<<< Дата:" space(1) string(today,"99/99/9999") space(1) "Время:" space(1) string(time, "HH:MM:SS") skip.
       86     output stream out-stream close.
       87     for each buf_doc-line no-lock
       88       where buf_doc-line.status_ = 'факт':U
       89       break by buf_doc-line.obj-type by buf_doc-line.obj-code by buf_doc-line.artic by buf_doc-line.fact-order
       90     on error undo, return error return-value
       91     :
       92       find first trn-doc no-lock
       93         where trn-doc.doc-code = buf_doc-line.doc-code
       94       .
       95       for each buf_inv-line no-lock
       96         where buf_inv-line.doc-code  = buf_doc-line.doc-code
       97           and buf_inv-line.artic     = buf_doc-line.artic
       98           and buf_inv-line.prod-type = buf_doc-line.prod-type
       99           and buf_inv-line.prod-code = buf_doc-line.prod-code
      100       on error undo, return error return-value
      101       :
      102         if first-of( buf_doc-line.artic ) then do:
      103           output stream out-stream to value(v-file-name) append.
      104           put stream out-stream unformatted
      105             skip(1)
      106             "Объект" space(1) buf_doc-line.obj-type space(1) buf_doc-line.obj-code skip
      107             "Товар" space(1) buf_doc-line.artic skip
      108             .
      109           put stream out-stream unformatted skip(1) skip.
      110           output stream out-stream close.
      111           assign
      112             v-after = 0.0
      113           .
      114         end.
      115         if lookup( buf_doc-line.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then do:
      116           assign
      117             v-sign = -1.0
      118           .
      119         end.
      120         else do:
      121           assign
      122             v-sign = 1.0
      123           .
      124         end.
      125         if v-after <> buf_inv-line.before-cli-qnty then do:
      126           output stream out-stream to value(v-file-name) append.
      127           put stream out-stream unformatted "$$$ Между документами !!!!" skip .
      128           output stream out-stream close.
      129         end.
      130         if trn-doc.doc-type = 'инв':U then do:
      131           assign
      132             v-cli-qnty = buf_doc-line.cli-qnty
      133           .
      134         end.
      135         else do:
      136           assign
      137             v-cli-qnty = buf_inv-line.wast-cli-qnty
      138           .
      139         end.
      140         if buf_inv-line.before-cli-qnty + v-cli-qnty * v-sign <> buf_inv-line.after-cli-qnty then do:
      141           output stream out-stream to value(v-file-name) append.
      142           put stream out-stream unformatted "$$$ Сам документ !!!!" space(1) .
      143           output stream out-stream close.
      144         end.
      145         output stream out-stream to value(v-file-name) append.
      146         put stream out-stream unformatted
      147           buf_doc-line.doc-code space(1)
      148           "До:" space(1) buf_inv-line.before-cli-qnty space(1)
      149           "По документу:" space(1) v-cli-qnty * v-sign space(1)
      150           "После:" space(1) buf_inv-line.after-cli-qnty skip
      151         .
      152         output stream out-stream close.
      153         assign
      154           v-after = buf_inv-line.after-cli-qnty
      155         .
      156       end.
      157     end.
      158   end.
