        1   block-level on error undo, throw.
        2   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INITIAL "$Revision$":U.
        3   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INITIAL "$Author$":U.
        4   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INITIAL "$Date$":U.
        5   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INITIAL "$Workfile$":U.
        6   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INITIAL "$Archive$":U.
        7   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INITIAL "экспорт справочников":U.
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   DEFINE TEMP-TABLE tt_currency NO-UNDO LIKE ub.currency.
       69     DEFINE TEMP-TABLE tt_curr-accnt NO-UNDO LIKE ub.curr-accnt.
       70     DEFINE TEMP-TABLE tt_curr-bank  NO-UNDO LIKE ub.curr-bank.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable v-waitfram-action01         as character   no-undo .
       73   define variable v-waitfram-action02         as character   no-undo .
       74   define variable v-waitfram-action03         as character   no-undo .
       75   define variable mWaitFramTextBeg            as character   no-undo.
       76   define variable mWaitFramTextEnd            as character   no-undo.
       77   define variable mWaitFramView               as logical     no-undo.
       78   define variable mWaitProcEvent              as logical     no-undo init yes.
       79   define variable mWaitFramInterval           as integer     no-undo init 1 .
       80   define variable mWaitFramStop               as logical     no-undo.
       81   define variable mWaitFramStopUser           as logical     no-undo.
       82   define variable mWaitFramStopTimeOut        as logical     no-undo.
       83   define variable mWaitFramStartProc          as datetime-tz no-undo.
       84   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       85   define button B-WaitFramStop auto-end-key
       86        label "Стоп"
       87        size 10 by 1 tooltip "Остоновить процесс".
       88   define button B-viewProcInfo
       89        label "Информация"
       90        size 15 by 1 tooltip "Информация о процесс".
       91   define frame waitfram
       92     v-waitfram-action01 format "x(72)" no-label skip
       93     v-waitfram-action02 format "x(72)" no-label skip
       94     v-waitfram-action03 format "x(72)" no-label skip
       95     B-viewProcInfo
       96     B-WaitFramStop at row 4 col 30
       97     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       98     .
       99   define new global shared variable mBatchMode as logical no-undo init ?.
      100   define variable mFramBachModHandle as handle no-undo.
      101   mFramBachModHandle = frame waitfram:handle.
      102   define variable mFameOldVis as logical no-undo.
      103   define variable mVisCUrentVin as logical no-undo.
      104   if session:batch-mode
      105   then
      106      mBatchMode = yes.
      107   if mBatchMode = ? then do:
      108     mVisCUrentVin = current-window:visible.
      109     mFameOldVis = mFramBachModHandle:visible.
      110     mFramBachModHandle:visible  = yes.
      111     mBatchMode = mFramBachModHandle:visible ne yes.
      112     mFramBachModHandle:visible = mFameOldVis.
      113     current-window:visible = mVisCUrentVin.
      114   end.
      115    if  log-manager:logfile-name ne ?
      116     then DO:
      117         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      118         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      119         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      120     end.
      121   on choose of B-WaitFramStop in frame waitfram
      122   do:
      123     mWaitFramStop = yes.
      124     mWaitFramStopUser = yes.
      125   end.
      126   function waitfram-check-timeout returns logical():
      127      define variable vtime as int64 no-undo.
      128      if mWaitFramStopTimeOut
      129      then
      130         return yes.
      131      vtime = ( now - mWaitFramStartProc ) / 1000 .
      132      if     mWaitFramTimeOut ne ?
      133         and mWaitFramTimeOut ne 0
      134         and mWaitFramTimeOut lt vtime
      135      then do:
      136         mWaitFramStopTimeOut = yes.
      137      end.
      138      return mWaitFramStopTimeOut.
      139   end.
      140   procedure waitfram-hide :
      141     if not session:batch-mode
      142     then do
      143     on error undo, return error return-value
      144     :
      145       pause 0 before-hide .
      146       if not mBatchMode then
      147         hide frame waitfram .
      148     if     not mWaitFramView
      149        and mWaitProcEvent
      150     then
      151       process events .
      152     end.
      153   end procedure.
      154   procedure waitfram-show :
      155     define input  parameter p-message as character no-undo .
      156     define variable v-left-margin as integer   no-undo .
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       if length(p-message) <= 70 then do:
      162         assign
      163           v-left-margin = integer((70 - length(p-message)) / 2)
      164         .
      165         assign
      166           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      167         .
      168         assign
      169           v-waitfram-action01 = " "
      170           v-waitfram-action02 = " "
      171                                    + fill(" ", v-left-margin)
      172                                    + p-message
      173           v-waitfram-action03 = " "
      174         .
      175       end.
      176       else do:
      177         define variable vRindex1 as integer no-undo.
      178         define variable vRindex2 as integer no-undo.
      179         vRindex1 = r-index(p-message," ",70).
      180         if vRindex1 = 0
      181         then
      182            vRindex1 = 70.
      183         if length(p-message)  <= vRindex1 + 70 then do:
      184           assign
      185             v-waitfram-action01 = " "
      186             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      188           .
      189         end.
      190         else do:
      191           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      192           if vRindex2 <= vRindex1
      193           then
      194              vRindex2 = vRindex1 + 70.
      195           assign
      196             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      199           .
      200         end.
      201       end.
      202       B-viewProcInfo:visible   in frame waitfram = no.
      203       B-viewProcInfo:sensitive in frame waitfram = no.
      204       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       if  (   mWaitFramView
      207          or  mWaitProcEvent)
      208          and not mBatchMode
      209       then
      210          display
      211             v-waitfram-action01 skip
      212             v-waitfram-action02 skip
      213             v-waitfram-action03 skip
      214          with frame waitfram .
      215       if     mWaitFramView
      216          then do:
      217             if     mWaitFramInterval ne ?
      218                and not mBatchMode
      219             then
      220                wait-for go of frame waitfram pause mWaitFramInterval.
      221          end.
      222          else
      223             if     mWaitProcEvent
      224                and not mBatchMode
      225             then
      226                process events .
      227     end.
      228   end procedure.
      229      procedure waitfram-show-this:
      230         define input  parameter iInterval as int64 no-undo.
      231         define variable vtime as int64 no-undo.
      232         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      233         mWaitFramInterval = iInterval.
      234         run waitfram-show (substitute("&1&2 &3&4" ,
      235                                       mWaitFramTextBeg ,
      236                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      237                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      238                                       mWaitFramTextEnd
      239                                      )
      240                           ).
      241      end.
      242      procedure WaitFramRunPause:
      243         define input  parameter iInterval as dec no-undo.
      244         define variable vStart  as datetime-tz no-undo.
      245         define variable vend    as datetime-tz no-undo.
      246         define variable vint as int64 no-undo.
      247         define variable vOk as logical no-undo.
      248         vStart = now.
      249         vend   = vStart.
      250         publish "WaitFramPause" (iInterval,output vOk).
      251         vend   =  now.
      252         vint = vend - vStart.
      253         vint = iInterval - vint / 1000.
      254         if     not mWaitFramStop
      255            and (   vint > 0
      256                 or (    not vOk
      257                     and iInterval eq ?
      258                     )
      259                 )
      260         then
      261            run waitfram-show-this (iInterval).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and vint > 0
      267         then do:
      268            run gbl/pause.p (vint * 1000).
      269         end.
      270         if iInterval ne ?
      271         then
      272            publish "WaitFramStop".
      273         waitfram-check-timeout().
      274      end.
      275      procedure WaitFramWaitFor:
      276         define input  parameter iInterval as dec no-undo.
      277         assign
      278            mWaitFramStartProc   = now
      279            mWaitFramStopUser    = no
      280            mWaitFramStopTimeOut = no
      281         .
      282         block-wait:
      283         do while not mWaitFramStop:
      284            run WaitFramRunPause (iInterval).
      285            if  waitfram-check-timeout()
      286            then do:
      287               leave block-wait.
      288            end.
      289         end.
      290         run waitfram-hide.
      291      end.
      292   procedure waitfram-join :
      293     define input  parameter p-line-1  as character no-undo .
      294     define input  parameter p-line-2  as character no-undo .
      295     define input  parameter p-line-3  as character no-undo .
      296     define output parameter p-message as character no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       assign
      301         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      304       .
      305     end.
      306   end procedure.
      307   function waitfram-join-function returns character
      308     (input p-line-1 as character
      309     ,input p-line-2 as character
      310     ,input p-line-3 as character
      311     ).
      312     define variable v-message as character no-undo .
      313     run waitfram-join in this-procedure
      314       (input  p-line-1
      315       ,input  p-line-2
      316       ,input  p-line-3
      317       ,output v-message
      318       ) .
      319     return v-message .
      320   end function .
      321   DEFINE VARIABLE v_dmp-dir AS CHARACTER NO-UNDO.
      322   DEFINE VARIABLE v_type    AS CHARACTER NO-UNDO.
      323   DEFINE VARIABLE j_docs    AS INTEGER   NO-UNDO.
      324   DEFINE STREAM out-str.
      325   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      326     (input  'dmp-dir':U
      327     ,input  0
      328     ,input  '':U
      329     ,input  0
      330     ,input  '':U
      331     ,input  '':U
      332     ,input  '':U
      333     ,input  NO
      334     ,output v_dmp-dir
      335     ,output v_type
      336     ) NO-ERROR .
      337   IF ERROR-STATUS :ERROR OR v_type <> "C":U OR v_dmp-dir = ? OR v_dmp-dir = "":U THEN DO: ASSIGN v_dmp-dir = "./". END.
      338   IF SUBSTRING( v_dmp-dir, LENGTH( v_dmp-dir ), 1 ) <> "/" THEN DO: ASSIGN v_dmp-dir = v_dmp-dir + "/". END.
      339   MESSAGE "Вы уверены, что хотите начать экспорт"
      340           "справочников валют и курсов валют" + "?"
      341   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO TITLE "Экспорт справочников" UPDATE l_start-export AS LOGICAL.
      342   RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников валют и курсов валют" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ).
      343   SESSION :SET-WAIT-STATE( "COMPILER":U ).
      344   Prepare-Block:
      345   DO ON ERROR  UNDO Prepare-Block, RETURN ERROR
      346      ON ENDKEY UNDO Prepare-Block, RETURN ERROR :
      347     FOR EACH ub.currency NO-LOCK :
      348       PROCESS EVENTS.
      349       ASSIGN j_docs = j_docs + 1.
      350       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников валют и курсов валют" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      351       CREATE tt_currency.
      352       BUFFER-COPY ub.currency
      353                TO tt_currency.
      354       FOR EACH ub.curr-accnt NO-LOCK WHERE ub.curr-accnt.curr-code = ub.currency.curr-code :
      355         CREATE tt_curr-accnt.
      356         BUFFER-COPY ub.curr-accnt TO tt_curr-accnt.
      357       END.
      358       FOR EACH ub.curr-bank  NO-LOCK WHERE ub.curr-bank.curr-code  = ub.currency.curr-code :
      359         CREATE tt_curr-bank.
      360         BUFFER-COPY ub.curr-bank TO tt_curr-bank.
      361       END.
      362     END.
      363   END.
      364   ASSIGN j_docs = 0.
      365   BlockTransaction:
      366   DO TRANSACTION ON ERROR  UNDO BlockTransaction, RETURN ERROR
      367                  ON ENDKEY UNDO BlockTransaction, RETURN ERROR :
      368     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-" + SUBSTRING( "currency", 1, 3 ) + ".txt" ).
      369     FOR EACH tt_currency :
      370       PROCESS EVENTS.
      371       ASSIGN j_docs = j_docs + 1.
      372       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников валют и курсов валют" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      373       EXPORT STREAM out-str tt_currency.
      374     END.
      375     OUTPUT STREAM out-str CLOSE.
      376     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-cacc.txt" ).
      377     FOR EACH tt_curr-accnt :
      378       PROCESS EVENTS.
      379       ASSIGN j_docs = j_docs + 1.
      380       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников валют и курсов валют" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      381       EXPORT STREAM out-str tt_curr-accnt.
      382     END.
      383     OUTPUT STREAM out-str CLOSE.
      384     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-cbnk.txt" ).
      385     FOR EACH tt_curr-bank :
      386       PROCESS EVENTS.
      387       ASSIGN j_docs = j_docs + 1.
      388       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников валют и курсов валют" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      389       EXPORT STREAM out-str tt_curr-bank.
      390     END.
      391     OUTPUT STREAM out-str CLOSE.
      392   END.
      393   IF SESSION :SET-WAIT-STATE( "":U ) THEN DO: END.
      394   RUN WaitFram-Hide IN THIS-PROCEDURE.
      395   MESSAGE "Экспорт" "справочников валют и курсов валют" "закончен" SKIP
      396           "Выгружено записей:" j_docs
      397   VIEW-AS ALERT-BOX INFORMATION TITLE "Экспорт справочников".
