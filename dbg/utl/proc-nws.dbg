      122          mAsyncProc:mProcPublish = this-procedure.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define  shared variable g#auto-pid           as integer   no-undo .
      125   define  shared variable conn-par             as character no-undo .
      126   define  shared variable g#auto-user-id       as character no-undo .
      127   define  shared variable g#auto-user-login    as character no-undo .
      128   define  shared variable g#auto-user-password as character no-undo .
      129   define  shared variable v-socket             as logical   no-undo .
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define  shared variable auto-window-h     as handle    no-undo .
      132   define  shared variable auto-log-msg-h    as handle    no-undo .
      133   define  shared variable hand-log-msg-h    as handle    no-undo .
      134   define  shared variable log-file-name     as character no-undo initial ? .
      135   define  shared variable add-log-file-name as character no-undo initial ? .
      136   define  shared variable writelogvalue     as character no-undo initial ? .
      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   procedure cur-time :
      139      define output parameter p-today as date      no-undo .
      140      define output parameter p-time  as integer   no-undo .
      141     do
      142     on error undo, return error
      143     :
      144       define variable v-date1 as date      no-undo .
      145       define variable v-date2 as date      no-undo .
      146       define variable v-time  as integer   no-undo .
      147       assign
      148         v-date1 = today
      149         v-time  = time
      150         v-date2 = today
      151       .
      152       if v-date1 <> v-date2
      153       then do:
      154         assign
      155           v-date1 = today
      156           v-time  = v-time
      157         .
      158       end.
      159       assign
      160         p-today = v-date1
      161         p-time  = v-time
      162       .
      163     end.
      164   end.
      165   function cur-time-date returns character
      166   :
      167     return string(today, '99/99/9999':U) .
      168   end.
      169   function cur-time-mjd returns decimal
      170   :
      171     define variable v-date as date      no-undo .
      172     define variable v-time as integer   no-undo .
      173     run cur-time in this-procedure
      174       (output v-date
      175       ,output v-time
      176       ) .
      177     return integer(v-date) - 2400002 + (v-time / 86400) .
      178   end.
      179   function cur-time-get-ending-index returns integer
      180   (input p-number as integer
      181   )
      182   :
      183     if p-number < 0
      184     or p-number = ?
      185     then do:
      186       return 1 .
      187     end.
      188     define variable v-rest as integer   no-undo .
      189     assign
      190       p-number = p-number modulo 100
      191     .
      192     if p-number < 20
      193     then do:
      194       assign
      195         v-rest = p-number
      196       .
      197     end.
      198     else do:
      199       assign
      200         v-rest = p-number modulo 10
      201       .
      202     end.
      203     case v-rest :
      204       when 1
      205       then do:
      206         return 2 .
      207       end.
      208       when 2 or
      209       when 3 or
      210       when 4
      211       then do:
      212         return 3 .
      213       end.
      214       otherwise do:
      215         return 1 .
      216       end.
      217     end case .
      218   end.
      219   procedure cur-time-mjd-to-date :
      220      define input  parameter i-mjd-diff as decimal no-undo.
      221      define output parameter o-Date     as date    no-undo.
      222      define output parameter o-Time     as integer no-undo.
      223      define variable v-day-number as integer   no-undo .
      224      if    i-mjd-diff < 0
      225         or i-mjd-diff = ?
      226      then do:
      227         return "?" .
      228      end.
      229      assign
      230         v-day-number = truncate(i-mjd-diff,0).
      231         o-Date = date(v-day-number + 2400002).
      232         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      233     .
      234   end.
      235   function cur-time-mjd-to-string returns character
      236   (input p-mjd-diff as decimal
      237   )
      238   :
      239     define variable v-day-number as integer   no-undo .
      240     define variable v-seconds    as integer   no-undo .
      241     define variable v-hour       as integer   no-undo .
      242     define variable v-min        as integer   no-undo .
      243     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      244     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      245     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      246     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      247     if p-mjd-diff < 0
      248     or p-mjd-diff = ?
      249     then do:
      250       return "?" .
      251     end.
      252     assign
      253       v-day-number = integer(truncate(p-mjd-diff,0))
      254       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      255     .
      256     if v-seconds > 86400
      257     then do:
      258       assign
      259         v-seconds = 86400 - 1
      260       .
      261     end.
      262     if v-seconds < 0
      263     then do:
      264       assign
      265         v-seconds = 0
      266       .
      267     end.
      268     assign
      269       v-hour = truncate(v-seconds / 3600, 0)
      270     .
      271     assign
      272       v-seconds = v-seconds modulo 3600
      273     .
      274     assign
      275       v-min = truncate(v-seconds / 60, 0)
      276     .
      277     assign
      278       v-seconds = v-seconds modulo 60
      279     .
      280     return
      281         (if v-day-number <> 0
      282           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0
      286           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      287           else ""
      288         )
      289       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      290           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      291           else ""
      292         )
      293       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      294       .
      295   end.
      296   function cur-time-string returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      305   end.
      306   function cur-time-string-sec returns character
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      315   end.
      316   function cur-time-custom  returns character
      317   (input p-prefix as character
      318   ,input p-date-format as character
      319   ,input p-delimiter as character
      320   ,input p-time-format as character
      321   ,input p-suffix as character
      322   )
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return
      331       p-prefix
      332       + string(v-date, p-date-format)
      333       + p-delimiter
      334       + string(v-time, p-time-format)
      335       + p-suffix
      336       .
      337   end.
      338   function cur-time-print  returns character
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      347   end.
      348   function cur-time-datetime returns datetime
      349   :
      350     define variable v-char as character no-undo .
      351     define variable v-datetime as datetime no-undo .
      352     v-char = cur-time-string().
      353     v-datetime = datetime(v-char).
      354     return  v-datetime.
      355   end.
      356   function cur-time-string-msec returns character
      357   :
      358     define variable v-date as datetime  no-undo .
      359     v-date = now.
      360     return string(v-date) .
      361   end.
      362   define stream LogStream .
      363   define variable mNoTime as logical no-undo.
      364   procedure write-to-log-notime :
      365     define input param i-str as character no-undo .
      366     mNoTime = yes.
      367     run write-to-log (i-str).
      368     mNoTime = no.
      369   end.
      370   procedure write-to-log :
      371     define input param p-str as character no-undo .
      372     do
      373     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      374     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      375     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      376     :
      377       define variable log-res        as logical   no-undo .
      378       define variable v-jj           as integer   no-undo .
      379       if    mNoTime
      380          or writelogvalue eq "AsyncProc"
      381       then
      382          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      383       else
      384          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      385       if auto-log-msg-h <> ? then do:
      386         log-res = auto-log-msg-h:move-to-eof( ) .
      387         log-res = auto-log-msg-h:insert-string( p-str ).
      388       end.
      389       if hand-log-msg-h <> ? then do:
      390         log-res = hand-log-msg-h:move-to-eof( ) .
      391         log-res = hand-log-msg-h:insert-string( p-str ).
      392       end.
      393       assign
      394         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      395         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      396         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      397       .
      398       if add-log-file-name <> ? then do:
      399         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      400           run gbl/fileapnd.p
      401             ( input entry(v-jj, add-log-file-name, chr(1) )
      402             ,input p-str
      403             ,input 20
      404             ) no-error .
      405           if error-status:error then do:
      406             return error return-value .
      407           end.
      408         end.
      409       end.
      410       if writelogvalue eq "AsyncProc"
      411       then do:
      412          p-str = trim(p-str, (chr(13) + chr(10)) )
      413       .
      414          Publish "WriteLogAsunc" (p-str,yes).
      415       end.
      416       else if writelogvalue <> "yes" then do:
      417         run gbl/fileapnd.p
      418           ( input log-file-name
      419           ,input p-str
      420           ,input 20
      421           ) no-error .
      422         if error-status:error then do:
      423           return error return-value .
      424         end.
      425       end.
      426     end.
      427   end procedure.
      428   procedure write-to-screen :
      429     define input param p-str as character no-undo .
      430     do
      431     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      432     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      433     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      434     :
      435       define variable log-res as logical no-undo.
      436       assign
      437         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      438       .
      439       if auto-log-msg-h <> ?
      440       then do:
      441         log-res = auto-log-msg-h:move-to-eof( ) .
      442         log-res = auto-log-msg-h:insert-string( p-str ).
      443       end.
      444       if hand-log-msg-h <> ?
      445       then do:
      446         log-res = hand-log-msg-h:move-to-eof( ) .
      447         log-res = hand-log-msg-h:insert-string( p-str ).
      448       end.
      449     end.
      450   end procedure.
      451   procedure send-msg-to-email :
      452     define input  parameter p-subject      as character no-undo .
      453     define input  parameter p-text-err     as character no-undo .
      454     define input  parameter p-attach-files as character no-undo .
      455     do
      456     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      457     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      458     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      459     :
      460       define variable v-tth             as handle    no-undo .
      461       define variable v-value-character as character no-undo .
      462       define variable v-value-date      as date      no-undo .
      463       define variable v-value-decimal   as decimal   no-undo .
      464       define variable v-value-integer   as integer   no-undo .
      465       define variable v-value-logical   as logical   no-undo .
      466       define variable v-param-type      as character no-undo .
      467       define variable v-email       as character no-undo .
      468       define variable v-tmp-str     as character no-undo .
      469       define variable v-tmp1-str    as character no-undo .
      470       define variable v-ind         as integer   no-undo .
      471       define variable v-num-entries as integer   no-undo .
      472       delete object v-tth no-error.
      473       run adm/shattri.p
      474         ( input "get":U
      475          ,input  "":U
      476          ,input  0
      477          ,input  'auto-task':U
      478          ,input  'send-msg-to-email':U
      479          ,output v-value-character
      480          ,output v-value-date
      481          ,output v-value-decimal
      482          ,output v-value-integer
      483          ,output v-value-logical
      484          ,output v-param-type
      485          ,input-output table-handle v-tth
      486         ) no-error .
      487       if not error-status :error  then do:
      488         assign
      489           v-tmp-str = v-value-character
      490         .
      491       end.
      492       delete object v-tth no-error.
      493       assign
      494         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      495         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      496         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      497         v-num-entries = num-entries( v-tmp-str, chr(44) )
      498         v-email       = "":U
      499       .
      500       do v-ind = 1 to v-num-entries
      501       :
      502         assign
      503           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      504         .
      505         if trim( v-tmp1-str ) <> "":U then do:
      506           if v-email = "":U then do:
      507             assign
      508               v-email = v-tmp1-str
      509             .
      510           end.
      511           else do:
      512             assign
      513               v-email = v-email + chr(44) + v-tmp1-str
      514             .
      515           end.
      516         end.
      517       end.
      518       if v-email <> "":U then do:
      519         run gbl/sendmail.p
      520           ( input v-email
      521           , input p-subject
      522           , input p-text-err
      523           , input p-attach-files
      524           ) no-error .
      525         if error-status :error
      526           or return-value <> "":U
      527         then do:
      528           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      529         end.
      530       end.
      531     end.
      532   end procedure.
      533   define new global shared variable g#library  as handle no-undo .
