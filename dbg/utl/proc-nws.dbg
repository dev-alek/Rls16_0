      540   define   shared variable g#esys-source-esys as integer no-undo.
      541   define   shared variable g#db-num as integer   no-undo .
      542   define   shared variable g#userid as character no-undo .
      543   define   shared variable g#passwd as character no-undo .
      544   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   define new shared variable nws-exch-dir as character no-undo .
      546   define new shared variable nws-heap-dir as character no-undo .
      547   define variable err-mess as character no-undo .
      548   define temp-table t-pck-conf no-undo
      549     field db-num-dst      as integer
      550     field db-num-src      as integer
      551     field pack-num        as integer
      552     field total-recs      as integer
      553     field sys-key         as character
      554     field src_db-key      as character
      555     field dst_db-key      as character
      556     field ver-num         as character
      557     field prev-crc        as character
      558     field actual-date     as date
      559     field actual-time-int as integer
      560   .
      561   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562   PROCEDURE get-db-num :
      563     define output parameter p-db-num as integer no-undo .
      564     do
      565     on error undo, return error return-value
      566     :
      567         run gbl/getdbnum.p (output p-db-num).
      568     end.
      569   END PROCEDURE.
      570   define variable v-cntxa-report-num as integer no-undo .
      571   PROCEDURE get-report-num :
      572     define output parameter p-report-num as integer no-undo .
      573     do
      574     on error undo, return error
      575     :
      576       if v-cntxa-report-num = 0 then do:
      577         run gbl/getrpnum.p (output p-report-num).
      578         v-cntxa-report-num = p-report-num.
      579       end.
      580       else do:
      581         assign
      582         p-report-num = v-cntxa-report-num
      583         .
      584       end.
      585     end.
      586   END PROCEDURE.
      587   PROCEDURE get-userid :
      588   do
      589   on error undo, return error
      590   :
      591   define output parameter p-userid  as character    no-undo.
      592       assign
      593           p-userid = g#userid
      594       .
      595   end.
      596   END PROCEDURE.
      597   PROCEDURE get-version-num :
      598   define output parameter p-curr-version as character no-undo .
      599     do
      600     on error undo, return error return-value
      601     :
      602       run gbl/getvern.p
      603         ( output p-curr-version
      604         ) .
      605     end.
      606   END PROCEDURE.
      607   procedure get-news :
      608   define output parameter p-news as logical no-undo .
      609     do
      610     on error undo, return error
      611     :
      612        p-news = g#news.
      613     end.
      614   end procedure.
      615   procedure get-esys :
      616   define output parameter p-esys as logical no-undo .
      617     do
      618     on error undo, return error
      619     :
      620        p-esys = g#esys.
      621     end.
      622   end procedure.
      623   run nws/nws-init.p no-error.
      624   if error-status :error then do:
      625       message
      626         vss-workfile vss-revision vss-description skip
      627         "Error Ошибка инициализации переменных для системы передачи новостей" skip
      628         return-value
      629         view-as alert-box error.
      630   end.
      631   else do:
      632      define variable mDB as character no-undo.
      633      mDB = GetParamAsunc( 1).
      634      if mDB eq ? then do:
      635         run PutstatAsunc( "error   Получение данных было преврвано пользователем." ).
      636         return.
      637      end.
      638      else
      639         run PutstatAsunc(substitute ("Отправка и получение новостей по БД &1", mdb)).
      640      run nws/exch-nws.p (this-procedure,?,?,mDB).
      641   end.
