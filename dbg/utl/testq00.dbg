        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   DEFINE INPUT PARAMETER test-number as integer.
        4   DEFINE INPUT PARAMETER my-inkas as char.
        5   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        6   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        7   define input parameter p-where-phrase as character no-undo .
        8   define input parameter parscales-pref as character no-undo .
        9   define input parameter parpgscales-pref as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: testq00.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: utl/testq00.p $":U .
       15   define variable vss-description as character no-undo init "Компилируемый ран-тайм модуль тестов по чекам".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define new global shared variable g#libbcrcn as handle no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define variable v-waitfram-action01         as character   no-undo .
       88   define variable v-waitfram-action02         as character   no-undo .
       89   define variable v-waitfram-action03         as character   no-undo .
       90   define variable mWaitFramTextBeg            as character   no-undo.
       91   define variable mWaitFramTextEnd            as character   no-undo.
       92   define variable mWaitFramView               as logical     no-undo.
       93   define variable mWaitProcEvent              as logical     no-undo init yes.
       94   define variable mWaitFramInterval           as integer     no-undo init 1 .
       95   define variable mWaitFramStop               as logical     no-undo.
       96   define variable mWaitFramStopUser           as logical     no-undo.
       97   define variable mWaitFramStopTimeOut        as logical     no-undo.
       98   define variable mWaitFramStartProc          as datetime-tz no-undo.
       99   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      100   define button B-WaitFramStop auto-end-key
      101        label "Стоп"
      102        size 10 by 1 tooltip "Остоновить процесс".
      103   define button B-viewProcInfo
      104        label "Информация"
      105        size 15 by 1 tooltip "Информация о процесс".
      106   define frame waitfram
      107     v-waitfram-action01 format "x(72)" no-label skip
      108     v-waitfram-action02 format "x(72)" no-label skip
      109     v-waitfram-action03 format "x(72)" no-label skip
      110     B-viewProcInfo
      111     B-WaitFramStop at row 4 col 30
      112     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      113     .
      114   define new global shared variable mBatchMode as logical no-undo init ?.
      115   define variable mFramBachModHandle as handle no-undo.
      116   mFramBachModHandle = frame waitfram:handle.
      117   define variable mFameOldVis as logical no-undo.
      118   define variable mVisCUrentVin as logical no-undo.
      119   if session:batch-mode
      120   then
      121      mBatchMode = yes.
      122   if mBatchMode = ? then do:
      123     mVisCUrentVin = current-window:visible.
      124     mFameOldVis = mFramBachModHandle:visible.
      125     mFramBachModHandle:visible  = yes.
      126     mBatchMode = mFramBachModHandle:visible ne yes.
      127     mFramBachModHandle:visible = mFameOldVis.
      128     current-window:visible = mVisCUrentVin.
      129   end.
      130    if  log-manager:logfile-name ne ?
      131     then DO:
      132         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      133         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      134         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      135     end.
      136   on choose of B-WaitFramStop in frame waitfram
      137   do:
      138     mWaitFramStop = yes.
      139     mWaitFramStopUser = yes.
      140   end.
      141   function waitfram-check-timeout returns logical():
      142      define variable vtime as int64 no-undo.
      143      if mWaitFramStopTimeOut
      144      then
      145         return yes.
      146      vtime = ( now - mWaitFramStartProc ) / 1000 .
      147      if     mWaitFramTimeOut ne ?
      148         and mWaitFramTimeOut ne 0
      149         and mWaitFramTimeOut lt vtime
      150      then do:
      151         mWaitFramStopTimeOut = yes.
      152      end.
      153      return mWaitFramStopTimeOut.
      154   end.
      155   procedure waitfram-hide :
      156     if not session:batch-mode
      157     then do
      158     on error undo, return error return-value
      159     :
      160       pause 0 before-hide .
      161       if not mBatchMode then
      162         hide frame waitfram .
      163     if     not mWaitFramView
      164        and mWaitProcEvent
      165     then
      166       process events .
      167     end.
      168   end procedure.
      169   procedure waitfram-show :
      170     define input  parameter p-message as character no-undo .
      171     define variable v-left-margin as integer   no-undo .
      172     if not session:batch-mode
      173     then do
      174     on error undo, return error return-value
      175     :
      176       if length(p-message) <= 70 then do:
      177         assign
      178           v-left-margin = integer((70 - length(p-message)) / 2)
      179         .
      180         assign
      181           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      182         .
      183         assign
      184           v-waitfram-action01 = " "
      185           v-waitfram-action02 = " "
      186                                    + fill(" ", v-left-margin)
      187                                    + p-message
      188           v-waitfram-action03 = " "
      189         .
      190       end.
      191       else do:
      192         define variable vRindex1 as integer no-undo.
      193         define variable vRindex2 as integer no-undo.
      194         vRindex1 = r-index(p-message," ",70).
      195         if vRindex1 = 0
      196         then
      197            vRindex1 = 70.
      198         if length(p-message)  <= vRindex1 + 70 then do:
      199           assign
      200             v-waitfram-action01 = " "
      201             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      202             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      203           .
      204         end.
      205         else do:
      206           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      207           if vRindex2 <= vRindex1
      208           then
      209              vRindex2 = vRindex1 + 70.
      210           assign
      211             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      212             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      213             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      214           .
      215         end.
      216       end.
      217       B-viewProcInfo:visible   in frame waitfram = no.
      218       B-viewProcInfo:sensitive in frame waitfram = no.
      219       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      220       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      221       if  (   mWaitFramView
      222          or  mWaitProcEvent)
      223          and not mBatchMode
      224       then
      225          display
      226             v-waitfram-action01 skip
      227             v-waitfram-action02 skip
      228             v-waitfram-action03 skip
      229          with frame waitfram .
      230       if     mWaitFramView
      231          then do:
      232             if     mWaitFramInterval ne ?
      233                and not mBatchMode
      234             then
      235                wait-for go of frame waitfram pause mWaitFramInterval.
      236          end.
      237          else
      238             if     mWaitProcEvent
      239                and not mBatchMode
      240             then
      241                process events .
      242     end.
      243   end procedure.
      244      procedure waitfram-show-this:
      245         define input  parameter iInterval as int64 no-undo.
      246         define variable vtime as int64 no-undo.
      247         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      248         mWaitFramInterval = iInterval.
      249         run waitfram-show (substitute("&1&2 &3&4" ,
      250                                       mWaitFramTextBeg ,
      251                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      252                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      253                                       mWaitFramTextEnd
      254                                      )
      255                           ).
      256      end.
      257      procedure WaitFramRunPause:
      258         define input  parameter iInterval as dec no-undo.
      259         define variable vStart  as datetime-tz no-undo.
      260         define variable vend    as datetime-tz no-undo.
      261         define variable vint as int64 no-undo.
      262         define variable vOk as logical no-undo.
      263         vStart = now.
      264         vend   = vStart.
      265         publish "WaitFramPause" (iInterval,output vOk).
      266         vend   =  now.
      267         vint = vend - vStart.
      268         vint = iInterval - vint / 1000.
      269         if     not mWaitFramStop
      270            and (   vint > 0
      271                 or (    not vOk
      272                     and iInterval eq ?
      273                     )
      274                 )
      275         then
      276            run waitfram-show-this (iInterval).
      277         vend   =  now.
      278         vint = vend - vStart.
      279         vint = iInterval - vint / 1000.
      280         if     not mWaitFramStop
      281            and vint > 0
      282         then do:
      283            run gbl/pause.p (vint * 1000).
      284         end.
      285         if iInterval ne ?
      286         then
      287            publish "WaitFramStop".
      288         waitfram-check-timeout().
      289      end.
      290      procedure WaitFramWaitFor:
      291         define input  parameter iInterval as dec no-undo.
      292         assign
      293            mWaitFramStartProc   = now
      294            mWaitFramStopUser    = no
      295            mWaitFramStopTimeOut = no
      296         .
      297         block-wait:
      298         do while not mWaitFramStop:
      299            run WaitFramRunPause (iInterval).
      300            if  waitfram-check-timeout()
      301            then do:
      302               leave block-wait.
      303            end.
      304         end.
      305         run waitfram-hide.
      306      end.
      307   procedure waitfram-join :
      308     define input  parameter p-line-1  as character no-undo .
      309     define input  parameter p-line-2  as character no-undo .
      310     define input  parameter p-line-3  as character no-undo .
      311     define output parameter p-message as character no-undo .
      312     do
      313     on error undo, return error return-value
      314     :
      315       assign
      316         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      317                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      318                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      319       .
      320     end.
      321   end procedure.
      322   function waitfram-join-function returns character
      323     (input p-line-1 as character
      324     ,input p-line-2 as character
      325     ,input p-line-3 as character
      326     ).
      327     define variable v-message as character no-undo .
      328     run waitfram-join in this-procedure
      329       (input  p-line-1
      330       ,input  p-line-2
      331       ,input  p-line-3
      332       ,output v-message
      333       ) .
      334     return v-message .
      335   end function .
      336   define SHARED var ff as decimal.
      337   define SHARED var gg as decimal.
      338   DEFine SHARED VAR accum1 as decimal.
      339   DEFINE VARIABLE bc-buf as char no-undo.
      340   DEFINE VARIABLE b-c like ub.bar-code.b-code no-undo.
      341   DEFINE VARIABLE flag as logical.
      342   DEFINE VARIABLE price-from-check like ub.chk-gds.price-base no-undo .
      343   DEFINE VARIABLE r-bar-code like ub.bar-code.b-code no-undo .
      344   define variable varresult   as character         no-undo.
      345   define variable vartype-bc  as character         no-undo.
      346   define variable varweight   as decimal           no-undo.
      347   DEFINE VARIABLE v-err       as logical           no-undo .
      348   define buffer for-gds for ub.chk-gds.
      349   DEFINE SHARED STREAM PrnLibStream.
      350   define variable v-curr-r-b as character no-undo .
      351   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      352   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      353     (output v-curr-r-b
      354     )  .
      355   define query testqi for ub.inkas, ub.chk-doc.
      356   define query testqc for ub.chk-doc.
      357   define variable v-qh as handle no-undo .
      358   define variable glog as logical no-undo .
      359   if my-inkas = "ALL" then do:
      360     v-qh = query testqi:handle.
      361   end.
      362   else do:
      363     v-qh = query testqc:handle.
      364   end.
      365   assign
      366   glog = v-qh:query-prepare(p-where-phrase) no-error.
      367   if error-status:error then do:
      368     message error-status:get-message(1)
      369     view-as alert-box error .
      370     undo, return error .
      371   end.
      372   assign
      373   glog = v-qh:query-open( ) no-error .
      374   if error-status:error then do:
      375     message error-status:get-message(1)
      376     view-as alert-box error .
      377     undo, return error .
      378   end.
      379   REPEAT :
      380     v-qh:GET-NEXT().
      381     IF v-qh:QUERY-OFF-END THEN LEAVE.
      382     if chk-doc.chk-type = integer('8':U) then next.
      383     if lookup(string(chk-doc.chk-type), '2,3,4,5,7':U) > 0  then next.
      384     if my-inkas = "ALL" then do:
      385       my-inkas = inkas.inkas-code.
      386     end.
      387     run waitfram-show in this-procedure ( input substitute("Ждите - идет обработка -  чек &1",chk-doc.doc-code)).
      388     CASE test-number:
      389       WHEN 1 then do:
      390         FOR EACH ub.chk-gds no-lock where ub.chk-gds.doc-code = ub.CHK-DOC.doc-code :
      391           flag = no.
      392           IF chk-gds.b-code = ? or chk-gds.b-code <= 0 THEN FLAG = YES.
      393           else do:
      394             assign
      395             price-from-check = chk-gds.price-base
      396             bc-buf = string(chk-gds.b-code)
      397             .
      398   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      399   (
      400    input  parparentproc
      401   ,input  bc-buf
      402   ,input  price-from-check
      403   ,input  chk-doc.obj-type
      404   ,input  chk-doc.obj-code
      405   ,input  yes
      406   ,input  no
      407   ,input  parscales-pref
      408   ,input  parpgscales-pref
      409   ,output varresult
      410   ,output vartype-bc
      411   ,output varweight
      412   ,buffer ub.bar-code
      413   ,buffer ub.prod-bc
      414   ,buffer ub.place
      415   ) no-error.
      416             if error-status:error then do:
      417               release bar-code.
      418             end.
      419             if avail bar-code then do:
      420               v-err = no.
      421   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      422     (input  bar-code.gds-code
      423     ,input  bar-code.node-code
      424     ,output r-bar-code
      425     ) no-error .
      426               if error-status:error then v-err = yes.
      427               if v-err then  do:
      428                 assign
      429                 b-c = ?
      430                 flag = yes
      431                 .
      432               end.
      433               else do:
      434                 if bar-code.in-code = "":U and bar-code.part-code = "":U then do:
      435                   assign
      436                   b-c = r-bar-code
      437                   .
      438                 end.
      439                 else do:
      440                   v-err = no.
      441   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      442   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdspcode in g#library
      443     (input  bar-code.gds-code
      444     ,input  bar-code.node-code
      445     ,input  bar-code.in-code
      446     ,input  bar-code.part-code
      447     ,output r-bar-code
      448     ) no-error .
      449                   if error-status:error then v-err = yes.
      450                   assign
      451                   b-c = (if v-err
      452                          then ?
      453                          else r-bar-code)
      454                   flag = (if v-err
      455                          then yes
      456                          else flag)
      457                   .
      458                 end.
      459               end.
      460             end.
      461             else do:
      462               assign
      463               b-c = ?
      464               flag = yes
      465               .
      466             end.
      467           end.
      468           if chk-gds.out-code <> chk-doc.out-code then flag = yes.
      469           if flag then do:
      470              PUT STREAM PrnLibStream UNFORMATTED
      471               chk-gds.doc-code FORMAT "X(20)"  space(1)
      472               CHK-DOC.pay-desk format "99999" space(1)
      473               CHK-DOC.chk-num format "-99999" space(1)
      474               if chk-gds.b-code = ? then "?" else string(chk-gds.b-code, "-9999999999") space(1)
      475               string(chk-gds.out-code <> chk-doc.out-code, "да/нет")
      476               SKIP
      477               .
      478           end.
      479       end.
      480       END.
      481       WHEN 2 then do:
      482           ff = 0.
      483           gg = 0.
      484           flag = no.
      485           if lookup(string(chk-doc.chk-type), '14,15,16,17,36':U) > 0 then next.
      486           for each ub.chk-gds where ub.chk-gds.doc-code = ub.chk-doc.doc-code no-lock:
      487               if ub.chk-gds.write-off-code <> ? and ub.chk-gds.write-off-code > 0 then next.
      488               ff = ff + ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - chk-gds.discnt).
      489               flag = (ub.chk-gds.out-code <> ub.chk-doc.out-code) OR flag.
      490           end.
      491            for each ub.chk-pay where ub.chk-pay.doc-code = ub.chk-doc.doc-code no-lock:
      492               gg = gg +  ub.chk-pay.tot-rubl.
      493               flag = (ub.chk-pay.out-code <> ub.chk-doc.out-code) OR flag.
      494           end.
      495           if abs(ff - gg) > 0.0000000002 or flag then do:
      496               put stream PrnLibStream UNFORMATTED
      497               ub.chk-doc.doc-code  format "X(20)" space(1)
      498               ub.chk-doc.pay-desk format "99999" space(1)
      499               ub.chk-doc.chk-num format "-99999" space(1)
      500               ff   format "-999,999.9999999999" space(1)
      501               gg format "-999,999.9999999999" space(1)
      502               (ff - gg) format "-999,999.9999999999" space(1)
      503               flag
      504               skip.
      505           accum1 = accum1 + (ff - gg) .
      506           end.
      507       END.
      508       WHEN 3 then do:
      509           ff = 0.
      510           gg = 0.
      511           flag = no.
      512           if lookup(string(ub.chk-doc.chk-type), '14,15,16,17,36':U) > 0 then next.
      513            for each ub.chk-gds where ub.chk-gds.doc-code = ub.chk-doc.doc-code no-lock:
      514              if ub.chk-gds.write-off-code <> ? and ub.chk-gds.write-off-code > 0 then next.
      515               ff = ff + ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
      516               flag = (ub.chk-gds.out-code <> ub.chk-doc.out-code) or flag.
      517           end.
      518            for each ub.chk-pay where ub.chk-pay.doc-code = ub.chk-doc.doc-code no-lock:
      519               gg = gg +  ub.chk-pay.tot-base.
      520               flag = (ub.chk-pay.out-code <> ub.chk-doc.out-code) or flag.
      521           end.
      522           if abs(ff - gg) > 0.0000000002 or flag then do:
      523               put stream PrnLibStream UNFORMATTED
      524               ub.chk-doc.doc-code  format "X(20)" space(1)
      525               ub.chk-doc.pay-desk format "99999" space(1)
      526               ub.chk-doc.chk-num format "-99999" space(1)
      527               ff   format "-999,999.9999999999" space(1)
      528               gg format "-999,999.9999999999" space(1)
      529               (ff - gg) format "-999,999.9999999999" space(1)
      530               flag
      531               skip.
      532           accum1 = accum1 + (ff - gg) .
      533           end.
      534       END.
      535       WHEN 4 then do:
      536           ff = 0.
      537           flag = no.
      538           for each ub.chk-pay No-LOCK WHERE ub.chk-pay.doc-code = ub.chk-doc.doc-code:
      539               ff = ff + ub.chk-pay.tot-rubl .
      540               flag = (ub.chk-pay.out-code <> ub.chk-doc.out-code) or flag.
      541           end.
      542           if abs(ff - ub.chk-doc.netto)  > 0.0000000002 or flag then do:
      543               PUT STREAM PrnLibStream UNFORMATTED
      544               ub.chk-doc.doc-code  format "X(20)" space(1)
      545               ub.chk-doc.pay-desk format "99999" space(1)
      546               ub.chk-doc.chk-num format "-99999" space(1)
      547               ub.chk-doc.netto format "-999,999.9999999999" space(1)
      548               ff   format "-999,999.9999999999" space(1)
      549               (ff - ub.chk-doc.netto) format "-999,999.9999999999" space(1)
      550               flag
      551               SKIP.
      552               accum1 = accum1 + (ff - ub.chk-doc.netto).
      553           end.
      554       END.
      555       WHEN 5 then do:
      556           ff = 0.
      557           flag = no.
      558           for each ub.chk-pay NO-LOCK WHERE ub.chk-pay.doc-code = chk-doc.doc-code :
      559               ff = ff + ub.chk-pay.tot-base .
      560               flag = (ub.chk-pay.out-code <> chk-doc.out-code) or flag.
      561           end.
      562           if abs(ff - chk-doc.netto)  > 0.0000000002 or flag then do:
      563               PUT STREAM PrnLibStream UNFORMATTED
      564               chk-doc.doc-code  format "X(20)" space(1)
      565               chk-doc.pay-desk format "99999" space(1)
      566               chk-doc.chk-num format "-99999" space(1)
      567               chk-doc.netto format "-999,999.9999999999" space(1)
      568               ff   format "-999,999.9999999999" space(1)
      569               (ff - chk-doc.netto) format "-999,999.9999999999" space(1)
      570               flag
      571               SKIP.
      572               accum1 = accum1 + (ff - chk-doc.netto).
      573           end.
      574       END.
      575       WHEN 6 then do:
      576           flag = no.
      577           for each ub.chk-pay NO-LOCK WHERE ub.chk-pay.doc-code = chk-doc.doc-code :
      578               flag = ub.chk-pay.out-code <> chk-doc.out-code.
      579               FIND FIRST ub.cash-pay NO-LOCK WHERE
      580                                   ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
      581                                   ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
      582               if not avail ub.cash-pay or flag then do:
      583                   PUT STREAM PrnLibStream UNFORMATTED
      584                   ub.chk-doc.doc-code  format "X(20)" space(1)
      585                   ub.chk-doc.pay-desk format "99999" space(1)
      586                   ub.chk-doc.chk-num format "-99999" space(1)
      587                   (if v-curr-r-b = 'base':U
      588                   then ub.chk-pay.tot-base
      589                   else ub.chk-pay.tot-rubl)  format "-999,999.9999999999" space(1)
      590                   (if not avail cash-pay
      591                   then ("+" + fill(" ", 29) + fill(" ", 29) + fill(" ", 25)
      592                           )
      593                   else (fill(" ", 30) +
      594                           string(ub.chk-pay.curr-code, "99999") + fill(" ", 24) +
      595                           string(cash-pay.curr-code, "99999") + fill(" ", 20)
      596                           )
      597                   )
      598                   " "
      599                   flag
      600                   SKIP.
      601               end.
      602           end.
      603       END.
      604       WHEN 7 then do:
      605           assign
      606           ff = 0
      607           gg= 0
      608           flag = no
      609           .
      610           for each ub.chk-pay NO-LOCK WHERE ub.chk-pay.doc-code = ub.chk-doc.doc-code :
      611               assign
      612               ff = ff + ub.chk-pay.tot-rubl
      613               gg = gg + ub.chk-pay.tot-base
      614               flag = (ub.chk-pay.out-code <> ub.chk-doc.out-code) or flag
      615               .
      616           end.
      617           if abs(ff - gg)  > 0.0000000002 or flag then do:
      618               PUT STREAM PrnLibStream UNFORMATTED
      619               ub.chk-doc.doc-code  format "X(20)" space(1)
      620               ub.chk-doc.pay-desk format "99999" space(1)
      621               ub.chk-doc.chk-num format "-99999" space(1)
      622               ub.chk-doc.netto format "-999,999.9999999999" space(1)
      623               ff   format "-999,999.9999999999" space(1)
      624               (ff - gg) format "-999,999.9999999999" space(1)
      625               flag
      626               SKIP.
      627               accum1 = accum1 + (ff - gg) .
      628           end.
      629       end.
      630       WHEN 8 then do:
      631           assign
      632           ff = 0
      633           gg= 0
      634           flag = no
      635           .
      636           for each ub.chk-gds NO-LOCK WHERE ub.chk-gds.doc-code = ub.chk-doc.doc-code :
      637             if ub.chk-gds.write-off-code <> ?
      638             and ub.chk-gds.write-off-code > 0 then next.
      639             assign
      640             ff = ff + ub.chk-gds.discnt * ub.chk-gds.doc-qnty
      641             flag = (ub.chk-gds.out-code <> ub.chk-doc.out-code) or flag
      642             .
      643           end.
      644           gg = ub.chk-doc.discnt.
      645           if abs(ff - gg)  > 0.0000000002 or flag then do:
      646               PUT STREAM PrnLibStream UNFORMATTED
      647               ub.chk-doc.doc-code  format "X(20)" space(1)
      648               ub.chk-doc.pay-desk format "99999" space(1)
      649               ub.chk-doc.chk-num format "-99999" space(1)
      650               ff   format "-999,999.9999999999" space(1)
      651               gg format "-999,999.9999999999" space(1)
      652               (ff - gg) format "-999,999.9999999999" space(1)
      653               flag
      654               SKIP.
      655               accum1 = accum1 + (ff - gg) .
      656           end.
      657       end.
      658       WHEN 9 then do:
      659           if abs(ub.chk-doc.netto - (ub.chk-doc.tot-doc - ub.chk-doc.discnt )
      660                  ) > 0.0000000002  then do:
      661               put stream PrnLibStream UNFORMATTED
      662               ub.chk-doc.doc-code format "X(20)" space(1)
      663               ub.chk-doc.pay-desk format "99999" space(1)
      664               ub.chk-doc.chk-num format "-99999" space(1)
      665               ub.chk-doc.tot-doc format "-999,999.9999999999" space(1)
      666               ub.chk-doc.discnt format "-999,999.9999999999" space(1)
      667               ub.chk-doc.netto format "-999,999.9999999999" space(1)
      668               ub.chk-doc.tot-doc - ub.chk-doc.discnt  format "-999,999.9999999999" space(1)
      669               ub.chk-doc.netto - (ub.chk-doc.tot-doc - ub.chk-doc.discnt)  format "-999,999.9999999999" space(1)
      670              skip.
      671               accum1 = accum1 +  (ub.chk-doc.netto - (ub.chk-doc.tot-doc - ub.chk-doc.discnt)).
      672           end.
      673       END.
      674       WHEN 10 then do:
      675           assign
      676           ff = 0
      677           flag = no.
      678           if lookup(string(ub.chk-doc.chk-type), '14,15,16,17,36':U) > 0 then next.
      679           for each ub.chk-gds where ub.chk-gds.doc-code = ub.chk-doc.doc-code no-lock:
      680               if ub.chk-gds.write-off-code <> ? and ub.chk-gds.write-off-code > 0 then next.
      681               assign
      682               flag = (ub.chk-gds.out-code <> ub.chk-doc.out-code) or flag
      683               ff = ff +  ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt) .
      684           end.
      685           if abs(ff - ub.chk-doc.netto) > 0.0000000002  or flag then do:
      686               put stream PrnLibStream UNFORMATTED
      687               ub.chk-doc.doc-code format "X(20)" space(1)
      688               ub.chk-doc.pay-desk format "99999" space(1)
      689               ub.chk-doc.chk-num format "-99999" space(1)
      690               ff format "-999,999.9999999999" space(1)
      691               ub.chk-doc.netto  format "-999,999.9999999999" space(1)
      692               (ff - ub.chk-doc.netto)  format "-999,999.9999999999" space(1)
      693               flag
      694               skip.
      695               accum1 = accum1 + (ff - ub.chk-doc.netto).
      696           end.
      697       END.
      698       WHEN 11 then do:
      699           assign
      700           ff = 0
      701           flag = no.
      702           if lookup(string(ub.chk-doc.chk-type), '14,15,16,17,36':U) > 0 then next.
      703            for each ub.chk-gds where ub.chk-gds.doc-code = ub.chk-doc.doc-code no-lock:
      704               if ub.chk-gds.write-off-code <> ? and ub.chk-gds.write-off-code > 0 then next.
      705               assign
      706               flag = (ub.chk-gds.out-code <> ub.chk-doc.out-code) or flag
      707               ff = ff +  ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt)
      708               .
      709           end.
      710           if abs(ff - (ub.chk-doc.tot-doc - ub.chk-doc.discnt)) > 0.0000000002  or flag then do:
      711               put stream PrnLibStream  UNFORMATTED
      712               ub.chk-doc.doc-code format "X(20)" space(1)
      713               ub.chk-doc.pay-desk format "99999" space(1)
      714               ub.chk-doc.chk-num format "-99999" space(1)
      715               ub.chk-doc.tot-doc format "-999,999.9999999999" space(1)
      716               ub.chk-doc.discnt format "-999,999.9999999999" space(1)
      717               ub.chk-doc.sub-discnt format "-999,999.9999999999" space(1)
      718               ff format "-999,999.9999999999" space(1)
      719               ub.chk-doc.tot-doc - ub.chk-doc.discnt  format "-999,999.9999999999" space(1)
      720               ff - (ub.chk-doc.tot-doc - ub.chk-doc.discnt)  format "-999,999.9999999999" space(1)
      721               flag
      722               skip.
      723               accum1 = accum1 + (ff - (ub.chk-doc.tot-doc - ub.chk-doc.discnt)).
      724           end.
      725       END.
      726       WHEN 12 then do:
      727           flag = no.
      728           if ub.chk-doc.netto >= 0 and can-find(FIRST ub.chk-gds where ub.chk-gds.doc-qnty < 0 and
      729                                                                           ub.chk-gds.doc-code = ub.chk-doc.doc-code) then do:
      730               for each ub.chk-gds where ub.chk-gds.doc-qnty < 0 AND ub.chk-gds.doc-code = ub.chk-doc.doc-code NO-LOCK:
      731                   flag = ub.chk-gds.out-code <> ub.chk-doc.out-code.
      732                   FIND FIRST for-gds where for-gds.b-code = ub.chk-gds.b-code AND for-gds.doc-qnty > 0
      733                   AND for-gds.doc-code = ub.chk-gds.doc-code NO-LOCK NO-ERROR.
      734                   if avail for-gds and for-gds.price-base <> ub.chk-gds.price-base or flag then do:
      735                       PUT stream PrnLibStream UNFORMATTED
      736                       ub.chk-gds.doc-code FORMAT "X(20)"  space(1)
      737                       ub.chk-doc.pay-desk format "99999" space(1)
      738                       ub.chk-doc.chk-num format "-99999" space(1)
      739                       ub.chk-gds.b-code format "-9999999999"
      740                       ub.chk-gds.price-base format "-999,999,999.999"
      741                       for-gds.price-base format "-999,999,999.999"
      742                       (ub.chk-gds.price-base - for-gds.price-base) * ub.chk-gds.doc-qnty format "-999,999.9999999999" space(1)
      743                       flag
      744                       skip.
      745                       accum1 = accum1 +  (ub.chk-gds.price-base - for-gds.price-base) * ub.chk-gds.doc-qnty.
      746                   end.
      747             end.
      748           end.
      749           if ub.chk-doc.netto < 0 and can-find(FIRST ub.chk-gds where ub.chk-gds.doc-qnty > 0 and
      750                                                                       ub.chk-gds.doc-code = ub.chk-doc.doc-code) then do:
      751               FOR EACH ub.chk-gds where ub.chk-gds.doc-qnty > 0 AND ub.chk-gds.doc-code = ub.chk-doc.doc-code NO-LOck:
      752                   flag = ub.chk-gds.out-code <> ub.chk-doc.out-code.
      753                   FIND FIRST for-gds where for-gds.b-code = ub.chk-gds.b-code and for-gds.doc-qnty < 0
      754                   AND for-gds.doc-code = ub.chk-gds.doc-code  NO-LOCK NO-ERROR.
      755                   if avail for-gds and for-gds.price-base <> ub.chk-gds.price-base or flag then do:
      756                       PUT stream PrnLibStream UNFORMATTED
      757                       ub.chk-gds.doc-code FORMAT "X(20)"  space(1)
      758                       ub.chk-doc.pay-desk format "99999" space(1)
      759                       ub.chk-doc.chk-num format "-99999" space(1)
      760                       ub.chk-gds.b-code format "-9999999999"
      761                       ub.chk-gds.price-base format "-999,999,999.999"
      762                       for-gds.price-base format "-999,999,999.999"
      763                       (ub.chk-gds.price-base - for-gds.price-base) * ub.chk-gds.doc-qnty   format "-999,999.9999999999" space(1)
      764                       flag
      765                       skip.
      766                       accum1 = accum1 +  (ub.chk-gds.price-base - for-gds.price-base) * ub.chk-gds.doc-qnty  .
      767                   end.
      768               end.
      769           end.
      770       END.
      771       when 13 then do:
      772           assign
      773           ff = 0
      774           flag = no.
      775           if lookup(string(ub.chk-doc.chk-type), '14,15,16,17,36':U) > 0 then next.
      776            for each ub.chk-gds where ub.chk-gds.doc-code = ub.chk-doc.doc-code no-lock:
      777             if ub.chk-gds.write-off-code <> ? and ub.chk-gds.write-off-code <> 0 then do:
      778               assign
      779               flag = (ub.chk-gds.out-code <> ub.chk-doc.out-code) or flag
      780               ff = ff +  ub.chk-gds.doc-qnty * ub.chk-gds.price-base  * (if ub.chk-gds.write-off-code > 0 then 1 else - 1)
      781               .
      782             end.
      783           end.
      784           if abs(ub.chk-doc.sub-discnt - ff ) > 0.0000000002  or flag then do:
      785               put stream PrnLibStream  UNFORMATTED
      786               ub.chk-doc.doc-code format "X(20)" space(1)
      787               ub.chk-doc.pay-desk format "99999" space(1)
      788               ub.chk-doc.chk-num format "-99999" space(1)
      789               ub.chk-doc.sub-discnt format "-999,999.9999999999" space(1)
      790               ff format "-999,999.9999999999" space(1)
      791               ub.chk-doc.sub-discnt - ff format "-999,999.9999999999" space(1)
      792               flag
      793               skip.
      794               accum1 = accum1 + (ub.chk-doc.sub-discnt - ff).
      795           end.
      796       end.
      797       when 14 then do:
      798         assign
      799         ff = 0
      800         .
      801         if lookup(string(ub.chk-doc.chk-type), '14,15,16,17,36':U) > 0
      802         or ub.chk-doc.chk-type = integer('8':U)
      803         then next.
      804         for each ub.chk-discnt no-lock where
      805                 ub.chk-discnt.doc-code = ub.chk-doc.doc-code
      806             AND ub.chk-discnt.record-type = 2,
      807             first ub.chk-gds no-lock where
      808                 ub.chk-gds.doc-code = ub.chk-doc.doc-code
      809             AND ub.chk-gds.line-num = ub.chk-discnt.object-line-num:
      810           assign
      811           ff = ff +  ub.chk-discnt.discnt-value-abs
      812           accum1 = accum1 + ub.chk-discnt.discnt-value-abs
      813           .
      814           put stream PrnLibStream  UNFORMATTED
      815           ub.chk-doc.doc-code   format "X(20)"           space(1)
      816           ub.chk-doc.chk-date   format "99/99/9999"      space(1)
      817           ub.chk-doc.out-code   format "X(20)"           space(1)
      818           ub.chk-doc.pay-desk   format "99999"           space(1)
      819           ub.chk-doc.chk-num    format "-99999"          space(1)
      820           ub.chk-gds.line-num   format "-99999"          space(1)
      821           ub.chk-gds.b-code     format "999999999"       space(1)
      822           ub.chk-gds.price-base format "-999,999,999.99" space(1)
      823           ub.chk-gds.doc-qnty   FORMAT "-999,999.99"     space(1)
      824           ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt) format "-999,999,999.999999999"  space(1)
      825           ub.chk-discnt.discnt-value-abs format "-999,999,999.999999999"  space(1)
      826           ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt + ub.chk-discnt.discnt-value-abs) * ub.chk-discnt.discnt-value-pcnt / 100 format "-999,999,999.999999999"
      827           skip.
      828         end.
      829         if ff <> 0 then
      830         put stream PrnLibStream  UNFORMATTED
      831         "Итого по чеку"  space(1)
      832         ff format "-999,999,999.999999999"
      833         skip(1).
      834       end.
      835     END CASE.
      836     run waitfram-hide in this-procedure .
      837   END.
