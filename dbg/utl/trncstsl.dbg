        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as   handle               no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: trncstsl.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/trncstsl.p $":U .
        8   define variable vss-description as character no-undo init "Выбор документов и простановка кода ГТД ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   function octal-to-char return character
       69   ( p-string as character ) :
       70     def var v-asc     as integer no-undo .
       71     def var v-new-asc as integer no-undo .
       72     def var ind       as integer no-undo .
       73     if length(p-string) <> 3 then do:
       74       return ? .
       75     end.
       76     assign
       77       v-asc = 0
       78     .
       79     do ind = 1 to length(p-string)
       80     :
       81       assign
       82         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
       83       .
       84       if v-new-asc < 0 or v-new-asc >= 8 then do:
       85         return ? .
       86       end.
       87       assign
       88         v-asc = v-asc * 8 + v-new-asc
       89       .
       90     end.
       91     return chr(v-asc) .
       92   end function .
       93   function char-to-octal return character
       94   ( p-chr as character ) :
       95     def var v-asc    as integer   no-undo .
       96     def var ind      as integer   no-undo .
       97     def var v-string as character no-undo .
       98     if length(p-chr) <> 1 then do:
       99       return ? .
      100     end.
      101     assign
      102       v-asc    = asc(p-chr)
      103       v-string = ""
      104     .
      105     do ind = 1 to 3
      106     :
      107       assign
      108         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      109       .
      110       assign
      111         v-asc = truncate(v-asc / 8, 0)
      112       .
      113     end.
      114     return v-string .
      115   end.
      116   function str-encode return character
      117   (   p-init-string       as character
      118     , p-encode-char       as character
      119     , p-special-char-list as character
      120   ) :
      121     def var p-encode-string as character no-undo .
      122     def var ind                as integer no-undo .
      123     def var v-num-special-char as integer no-undo .
      124     def var v-special-char     as character no-undo .
      125     if p-encode-char = ?
      126     or p-encode-char = "" then do:
      127       assign
      128         p-encode-char = "~~"
      129       .
      130     end.
      131     if p-init-string = ? then do:
      132       return "?" .
      133     end.
      134     if p-init-string = "?" then do:
      135       return p-encode-char + char-to-octal("?") .
      136     end.
      137     assign
      138       v-num-special-char = length(p-special-char-list)
      139       p-encode-string    = replace(p-init-string
      140                                   ,p-encode-char
      141                                   ,p-encode-char + char-to-octal(p-encode-char)
      142                                   )
      143     .
      144     do ind = 1 to v-num-special-char
      145     :
      146       assign
      147         v-special-char = substring(p-special-char-list, ind, 1)
      148       .
      149       if v-special-char <> p-encode-char then do:
      150         assign
      151           p-encode-string = replace (p-encode-string
      152                                     ,v-special-char
      153                                     ,p-encode-char + char-to-octal(v-special-char)
      154                                     )
      155         .
      156       end.
      157     end.
      158     return p-encode-string .
      159   end.
      160   function str-decode returns character
      161     (p-init-string   as character
      162     ,p-encode-char   as character
      163     ) :
      164     def var p-decode-string as character no-undo .
      165     def var ind                       as integer no-undo .
      166     def var v-num-entries-init-string as integer no-undo .
      167     def var v-sub-phrase              as character no-undo .
      168     def var v-special-char            as character no-undo .
      169     if p-encode-char = ?
      170     or p-encode-char = "" then do:
      171       assign
      172         p-encode-char = "~~"
      173       .
      174     end.
      175     if p-init-string = "?" then do:
      176       return ? .
      177     end.
      178     assign
      179       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      180     .
      181     if v-num-entries-init-string > 1 then do:
      182       assign
      183         p-decode-string = entry(1, p-init-string, p-encode-char)
      184       .
      185       do ind = 2 to v-num-entries-init-string
      186       :
      187         assign
      188           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      189         .
      190         assign
      191           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      192         .
      193         if v-special-char <> ? then do:
      194           assign
      195             p-decode-string = p-decode-string
      196                             + v-special-char
      197                             + substring(v-sub-phrase, 4)
      198           .
      199         end.
      200         else do:
      201           assign
      202             p-decode-string = p-decode-string
      203                             + p-encode-char
      204                             + v-sub-phrase
      205           .
      206         end.
      207       end.
      208     end.
      209     else do:
      210       assign
      211         p-decode-string = p-init-string
      212       .
      213     end.
      214     return p-decode-string .
      215   end.
      216   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      217     define variable v-cntxt-db-num        as integer   no-undo .
      218     define variable v-cntxt-userid        as character no-undo .
      219     define variable v-cntxt-level         as character no-undo .
      220     define variable v-cntxt-host-code-obj as integer   no-undo .
      221     define variable v-cntxt-obj-type      as character no-undo .
      222     define variable v-cntxt-obj-code      as integer   no-undo .
      223     define variable v-cntxt-db-num-obj    as integer   no-undo .
      224     define variable v-cntxt-is-admin      as logical   no-undo .
      225   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      226     run mainmenu_getcntxt in parparentproc
      227       (output v-cntxt-db-num
      228       ,output v-cntxt-userid
      229       ,output v-cntxt-level
      230       ,output v-cntxt-host-code-obj
      231       ,output v-cntxt-obj-type
      232       ,output v-cntxt-obj-code
      233       ,output v-cntxt-db-num-obj
      234       ,output v-cntxt-is-admin
      235       ) .
      236   define variable lok as logical no-undo .
      237   define variable loc-ref-list as character no-undo .
      238   define variable v-ind        as integer   no-undo .
      239   define variable v-doc-rec    as integer   no-undo .
      240   do
      241   on error undo, return error
      242   :
      243     run str/all-docs.w
      244       (input  parparentproc
      245       ,input v-cntxt-host-code-obj
      246       ,input v-cntxt-obj-type
      247       ,input v-cntxt-obj-code
      248       ,input  'ТИП':U
      249       ,input  'факт':U
      250       ,input  'при':U
      251       ,input  ?
      252       ,input  false
      253       ,input  'b-sel,b-mark':U
      254       ,input  'ie':U
      255       ,input  false
      256       ,input  ?
      257       ,output loc-ref-list
      258       ).
      259     do v-ind = 1 to num-entries(loc-ref-list)
      260     :
      261       assign
      262         v-doc-rec = integer(entry(v-ind, loc-ref-list))
      263       .
      264       find trn-doc no-lock
      265         where recid (trn-doc) = v-doc-rec
      266         no-error .
      267       if available trn-doc
      268       then do:
      269         define variable v-field-format as character no-undo .
      270         define variable v-cst-code     as character no-undo .
      271         run gbl/fldfrmt.p
      272           (input  'trn-doc':u
      273           ,input  'cst-code':u
      274           ,output v-field-format
      275           ) no-error .
      276         if error-status :error then do:
      277           message
      278             vss-workfile vss-revision vss-description skip
      279             "Ошибка при вызове программы fldfrmt.p" skip
      280             error-status :get-message(1) skip
      281             return-value skip
      282             view-as alert-box error .
      283           assign
      284             v-field-format = "X(22)"
      285           .
      286         end.
      287         assign
      288           v-cst-code = ub.trn-doc.cst-code
      289         .
      290         run gbl/d-prompt.w (
      291             'title=Задайте код ГТД\'
      292           + 'text1=Проставить код ГТД во все партии документа?\'
      293           + 'text2=Документ ' + str-encode(ub.trn-doc.doc-code, "", "=\") + '\'
      294           + 'format=' + v-field-format + '\'
      295           + 'type=char\'
      296           ,input-output v-cst-code
      297           ).
      298         if return-value = 'false':u then do:
      299           return .
      300         end.
      301         define buffer buf_trn-doc for ub.trn-doc .
      302         do transaction
      303         on error undo, return error
      304         :
      305           find first buf_trn-doc exclusive-lock
      306             where recid(buf_trn-doc) = recid(ub.trn-doc)
      307             no-error .
      308           assign
      309             buf_trn-doc.cst-code = v-cst-code
      310           .
      311         end.
      312         run trg/trncst.p
      313           (input buf_trn-doc.doc-code
      314           ).
      315       end.
      316     end.
      317   end.
