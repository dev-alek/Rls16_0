        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: ben-innr.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/ben-innr.p $":U .
        8   define variable vss-description as character no-undo init "Запуск ben-innu.p".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68     define variable v-cntxt-db-num        as integer   no-undo .
       69     define variable v-cntxt-userid        as character no-undo .
       70     define variable v-cntxt-level         as character no-undo .
       71     define variable v-cntxt-host-code-obj as integer   no-undo .
       72     define variable v-cntxt-obj-type      as character no-undo .
       73     define variable v-cntxt-obj-code      as integer   no-undo .
       74     define variable v-cntxt-db-num-obj    as integer   no-undo .
       75     define variable v-cntxt-is-admin      as logical   no-undo .
       76   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   procedure gen-key-rec :
       78     define input  parameter p-tbl-name    as character no-undo.
       79     define input  parameter p-bh_tbl-name as handle    no-undo.
       80     define output parameter p-key-rec     as character no-undo.
       81     do
       82     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       83     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       84     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       85     :
       86       define variable fh               as handle    no-undo .
       87       define variable v-ok             as logical   no-undo .
       88       define variable v-inform         as character no-undo .
       89       define variable v-ind            as integer   no-undo .
       90       define variable v-idx-field-qnty as integer   no-undo .
       91       if p-tbl-name = ?
       92         or p-tbl-name = "":U
       93       then do:
       94         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       95       end.
       96       if not p-bh_tbl-name:available then do:
       97         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
       98       end.
       99       assign
      100         p-key-rec = p-tbl-name
      101         v-inform  = p-bh_tbl-name:index-information(1)
      102         v-ind     = 2
      103       .
      104       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      105       on error undo, return error
      106       :
      107         assign
      108           v-inform = p-bh_tbl-name:index-information( v-ind )
      109           v-ind    = v-ind + 1
      110         .
      111       end.
      112       if v-inform = ?
      113         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      114         or entry( 3, v-inform, ",":U ) <> "1":U
      115       then do:
      116         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      117       end.
      118       else do:
      119         assign
      120           v-idx-field-qnty = num-entries( v-inform ) - 4
      121         .
      122         if v-idx-field-qnty < 2 then do:
      123           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      124         end.
      125         do v-ind = 1 to v-idx-field-qnty by 2
      126         on error undo, return error
      127         :
      128           assign
      129             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      130             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      131           .
      132         end.
      133       end.
      134       if p-key-rec = ? then do:
      135         assign
      136           p-key-rec = "":U
      137         .
      138         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      139       end.
      140     end.
      141     return.
      142   end procedure.
      143   procedure gen-where-keyr-tab :
      144     define input  parameter i-tableSerach as character no-undo.
      145     define input  parameter i-tablekey   as character  no-undo.
      146     define input  parameter p-key-rec    as character  no-undo.
      147     define input  parameter p-key-handle as handle     no-undo .
      148     define input  parameter p-db-name    as character  no-undo .
      149     define input  parameter p-tt-handle  as handle     no-undo .
      150     define output parameter o-Where      as character  no-undo.
      151     do
      152     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      153     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      154     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      155     :
      156       define variable v-full-tbl-name  as character no-undo .
      157       define variable bh_tbl-name      as handle    no-undo .
      158       define variable fh_key           as handle    no-undo .
      159       define variable fh_search        as handle    no-undo .
      160       define variable v-field-num      as integer   no-undo .
      161       define variable v-count-fld      as integer   no-undo .
      162       define variable v-inform         as character no-undo .
      163       define variable v-ind            as integer   no-undo .
      164       define variable v-idx-field-qnty as integer   no-undo .
      165       define variable v-field-name     as character no-undo .
      166       define variable v-field-val      as character no-undo .
      167       define variable v-word-link      as character no-undo .
      168       define variable vTable           as character no-undo.
      169       define variable bh_tbl-key       as handle    no-undo .
      170       assign
      171         p-key-rec = trim( p-key-rec )
      172       .
      173       if p-key-handle <> ? then do:
      174         if not valid-handle(p-key-handle)
      175            or p-key-handle:type <> "buffer"
      176         then do:
      177           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      178         end.
      179         if num-entries( p-key-rec, chr(3) ) > 1
      180           or p-key-rec = ?
      181           or p-key-rec = "":U
      182         then do:
      183           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      184         end.
      185       end.
      186       else do:
      187         if p-key-rec = ?
      188           or p-key-rec = "":U
      189         then do:
      190           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      191         end.
      192       end.
      193       assign
      194         vTable = entry( 1 , p-key-rec, chr(3) )
      195       .
      196       if p-tt-handle <> ?
      197         and ( not valid-handle(p-tt-handle)
      198               or p-tt-handle:type <> "buffer"
      199             )
      200       then do:
      201         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      202       end.
      203       if p-tt-handle = ? then do:
      204         assign
      205           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      206         .
      207         create buffer bh_tbl-name for table v-full-tbl-name .
      208       end.
      209       else do:
      210         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      211       end.
      212       assign
      213         v-inform = bh_tbl-name:index-information(1)
      214         v-ind    = 2
      215       .
      216       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      217       on error undo, return error
      218       :
      219         assign
      220           v-inform = bh_tbl-name:index-information( v-ind )
      221           v-ind    = v-ind + 1
      222         .
      223       end.
      224       if v-inform = ?
      225         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      226         or entry( 3, v-inform, ",":U ) <> "1":U
      227       then do:
      228         delete object bh_tbl-name no-error.
      229         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      230       end.
      231       assign
      232         v-idx-field-qnty = num-entries( v-inform ) - 4
      233       .
      234       if v-idx-field-qnty < 2 then do:
      235         delete object bh_tbl-name no-error.
      236         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      237       end.
      238       assign
      239         o-where     = "where":U
      240         v-word-link = "":U
      241         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      242         v-count-fld = 0
      243       .
      244       if i-tablekey ne "" and i-tablekey ne ?
      245       then do:
      246         assign
      247           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      248         .
      249         create buffer bh_tbl-key for table v-full-tbl-name .
      250       end.
      251       if i-tableSerach ne "" and i-tableSerach ne ?
      252       then do:
      253         delete object bh_tbl-name no-error.
      254         assign
      255           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      256         .
      257         create buffer bh_tbl-name for table v-full-tbl-name .
      258       end.
      259       block_where:
      260       do v-ind = 1 to v-idx-field-qnty by 2
      261       on error undo, return error
      262       :
      263         assign
      264           v-count-fld = v-count-fld + 1
      265         .
      266         if p-key-handle = ?
      267           and v-count-fld > v-field-num
      268         then do:
      269           leave block_where.
      270         end.
      271         define variable VfieldKeyTable as handle no-undo.
      272         assign
      273           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      274           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      275         .
      276         if     bh_tbl-key ne ?
      277         then do:
      278            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      279            if VfieldKeyTable eq ?
      280            then next block_where.
      281         end.
      282         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      283         then
      284            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      285         else
      286            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      287         if p-key-handle = ? then do:
      288           assign
      289             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      290           .
      291         end.
      292         else do:
      293           assign
      294             fh_key = p-key-handle:buffer-field( v-field-name )
      295           .
      296           if fh_key = ?
      297             or not valid-handle( fh_key )
      298           then do:
      299             delete object bh_tbl-name.
      300             if     bh_tbl-key ne ?
      301             then
      302                delete object bh_tbl-key.
      303             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      304           end.
      305           assign
      306             v-field-val = fh_key:buffer-value
      307           .
      308         end.
      309         if fh_search:data-type ="character":U then do:
      310           assign
      311             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      312             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      313             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      314             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      315             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      316             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      317             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      318             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      319             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      320             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      321             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      322             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      323             v-field-val = substitute( '"&1"', v-field-val )
      324           .
      325         end.
      326         assign
      327           o-where = substitute( "&1 &2", o-where, v-field-val )
      328         .
      329         if v-word-link = "":U then do:
      330           assign
      331             v-word-link = "and":U
      332           .
      333         end.
      334       end.
      335       delete object bh_tbl-name.
      336       if     bh_tbl-key ne ?
      337       then
      338          delete object bh_tbl-key.
      339       if p-key-handle = ?
      340         and v-count-fld <> v-field-num
      341       then do:
      342         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      343       end.
      344     end.
      345   end procedure.
      346   procedure gen-hn-keyr-tab :
      347     define input  parameter i-tableSerach as character no-undo.
      348     define input  parameter i-tablekey   as character no-undo.
      349     define input  parameter p-key-rec    as character no-undo.
      350     define input  parameter p-key-handle as handle    no-undo .
      351     define input  parameter p-db-name    as character no-undo .
      352     define input  parameter p-tt-handle  as handle    no-undo .
      353     define input  parameter p-stts-lock  as integer   no-undo .
      354     define output parameter o-hn         as handle    no-undo.
      355     define variable v-full-tbl-name as character no-undo.
      356     define variable v-where         as character no-undo.
      357     define variable bh_tbl-name     as handle    no-undo.
      358     define variable vTable          as character no-undo.
      359     do
      360     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      361     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      362     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      363         run gen-where-keyr-tab(i-tableSerach,
      364                                i-tablekey,
      365                                p-key-rec,
      366                                p-key-handle,
      367                                p-db-name,
      368                                p-tt-handle,
      369                                output v-where).
      370         if i-tableSerach ne "" and i-tableSerach ne ?
      371         then do:
      372            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      373            create buffer bh_tbl-name for table v-full-tbl-name .
      374         end.
      375         else do:
      376            if p-tt-handle = ? then do:
      377               assign
      378                  vTable = entry( 1 , p-key-rec, chr(3) )
      379               .
      380               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      381               create buffer bh_tbl-name for table v-full-tbl-name .
      382            end.
      383            else do:
      384               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      385            end.
      386         end.
      387         if p-tt-handle = ? then do:
      388            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      389         end.
      390         else do:
      391            bh_tbl-name:find-first( v-where ) no-error .
      392         end.
      393         o-hn = bh_tbl-name.
      394      end.
      395   end procedure.
      396   procedure gen-hn-keyr :
      397     define input  parameter p-key-rec    as character no-undo.
      398     define input  parameter p-key-handle as handle    no-undo .
      399     define input  parameter p-db-name    as character no-undo .
      400     define input  parameter p-tt-handle  as handle    no-undo .
      401     define input  parameter p-stts-lock  as integer   no-undo .
      402     define output parameter o-hn         as handle    no-undo.
      403     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      404   end.
      405   procedure gen-row-keyr :
      406     define input  parameter p-key-rec    as character no-undo.
      407     define input  parameter p-key-handle as handle    no-undo .
      408     define input  parameter p-db-name    as character no-undo .
      409     define input  parameter p-tt-handle  as handle    no-undo .
      410     define input  parameter p-stts-lock  as integer   no-undo .
      411     define output parameter p-tbl-row    as rowid     no-undo.
      412     define output parameter p-tbl-name   as character no-undo.
      413     define variable vHn as handle no-undo.
      414       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      415       p-tbl-row = if vHn:available then vHn:rowid else ?.
      416       p-tbl-name =  vHn:table.
      417       delete object vHn no-error.
      418     if p-tbl-row = ? then do:
      419       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      420     end.
      421     else do:
      422       return.
      423     end.
      424   end procedure.
      425   procedure gen-key-fv :
      426     define input  parameter p-key-rec    as character no-undo .
      427     define output parameter p-field-list as character no-undo .
      428     define output parameter p-value-list as character no-undo.
      429     do
      430     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      431     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      432     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      433     :
      434       define variable v-full-tbl-name  as character no-undo .
      435       define variable bh_tbl-name      as handle    no-undo .
      436       define variable v-tbl-name       as character no-undo .
      437       define variable v-field-num      as integer   no-undo .
      438       define variable v-count-fld      as integer   no-undo .
      439       define variable v-inform         as character no-undo .
      440       define variable v-ind            as integer   no-undo .
      441       define variable v-idx-field-qnty as integer   no-undo .
      442       define variable v-delim-key      as character no-undo .
      443       if p-key-rec = ?
      444         or p-key-rec = "":U
      445       then do:
      446         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      447       end.
      448       assign
      449         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      450         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      451       .
      452       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      453       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      454       assign
      455         v-inform = bh_tbl-name:index-information(1)
      456         v-ind    = 2
      457       .
      458       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      459       on error undo, return error
      460       :
      461         assign
      462           v-inform = bh_tbl-name:index-information( v-ind )
      463           v-ind    = v-ind + 1
      464         .
      465       end.
      466       if v-inform = ?
      467         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      468         or entry( 3, v-inform, ",":U ) <> "1":U
      469       then do:
      470         delete object bh_tbl-name no-error.
      471         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      472       end.
      473       assign
      474         v-idx-field-qnty = num-entries( v-inform ) - 4
      475       .
      476       if v-idx-field-qnty < 2 then do:
      477         delete object bh_tbl-name no-error.
      478         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      479       end.
      480       assign
      481         p-field-list = "":U
      482         p-value-list = "":U
      483         v-delim-key  = "":U
      484         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      485         v-count-fld  = 0
      486       .
      487       block_where:
      488       do v-ind = 1 to v-idx-field-qnty by 2
      489       on error undo, return error
      490       :
      491         assign
      492           v-count-fld = v-count-fld + 1
      493         .
      494         if v-count-fld > v-field-num then do:
      495           leave block_where.
      496         end.
      497         assign
      498           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      499           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      500         .
      501         if v-ind = 1 then do:
      502           assign
      503             v-delim-key = chr(3)
      504           .
      505         end.
      506       end.
      507       delete object bh_tbl-name.
      508       if v-count-fld <> v-field-num then do:
      509         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      510       end.
      511     end.
      512   end procedure.
      513   procedure gen-key-field :
      514     define input  parameter p-table      as character no-undo .
      515     define output parameter p-field-list as character no-undo .
      516     do
      517     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      518     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      519     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      520     :
      521       define variable v-full-tbl-name  as character no-undo .
      522       define variable bh_tbl-name      as handle    no-undo .
      523       define variable v-tbl-name       as character no-undo .
      524       define variable v-field-num      as integer   no-undo .
      525       define variable v-count-fld      as integer   no-undo .
      526       define variable v-inform         as character no-undo .
      527       define variable v-ind            as integer   no-undo .
      528       define variable v-idx-field-qnty as integer   no-undo .
      529       define variable v-delim-key      as character no-undo .
      530       if p-table = ?
      531         or p-table = "":U
      532       then do:
      533         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      534       end.
      535       assign
      536         v-tbl-name      = p-table
      537         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      538       .
      539       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      540       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      541       assign
      542         v-inform = bh_tbl-name:index-information(1)
      543         v-ind    = 2
      544       .
      545       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      546       on error undo, return error
      547       :
      548         assign
      549           v-inform = bh_tbl-name:index-information( v-ind )
      550           v-ind    = v-ind + 1
      551         .
      552       end.
      553       if v-inform = ?
      554         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      555         or entry( 3, v-inform, ",":U ) <> "1":U
      556       then do:
      557         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      558       end.
      559       assign
      560         v-idx-field-qnty = num-entries( v-inform ) - 4
      561       .
      562       if v-idx-field-qnty < 2 then do:
      563         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      564       end.
      565       assign
      566         p-field-list = "":U
      567         v-delim-key  = "":U
      568         v-count-fld  = 0
      569       .
      570       block_where:
      571       do v-ind = 1 to v-idx-field-qnty by 2
      572       on error undo, return error
      573       :
      574         assign
      575           v-count-fld = v-count-fld + 1
      576         .
      577         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      578         if v-ind = 1 then do:
      579           assign
      580             v-delim-key = chr(3)
      581           .
      582         end.
      583       end.
      584       delete object bh_tbl-name.
      585     end.
      586   end procedure.
      587   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588     run mainmenu_getcntxt in parparentproc
      589       (output v-cntxt-db-num
      590       ,output v-cntxt-userid
      591       ,output v-cntxt-level
      592       ,output v-cntxt-host-code-obj
      593       ,output v-cntxt-obj-type
      594       ,output v-cntxt-obj-code
      595       ,output v-cntxt-db-num-obj
      596       ,output v-cntxt-is-admin
      597       ) .
      598   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   if v-cntxt-db-num <> 0 then do:
      600     message
      601     "Данную утилиту можно запустить только в ГБД"
      602     view-as alert-box error .
      603     return.
      604   end.
      605   run str/diallog.w (
      606                     input parparentproc
      607                    ,input this-procedure:handle
      608                    ,input ('ben-innu':U + chr(4)  +
      609                           "1" + chr(4) +
      610                           "0" + chr(4) +
      611                           "1" + chr(4) +
      612                           "1" + chr(4) +
      613                           "yes")
      614                    ,input '':U
      615                    ,input no
      616                    ,input '':U
      617                    ,input 'Утилита коррекции кодов INN в таблице ext-classif по данным карточке контрагентов') no-error.
      618   procedure ben-innu :
      619   define input parameter parparentproc as widget-handle no-undo .
      620   define input parameter p-parent-handle as widget-handle no-undo .
      621   define input parameter p-log-handle  as handle no-undo .
      622   define input parameter p-parameter   as character no-undo .
      623   define variable ii as integer no-undo .
      624   define variable ii-prs as integer no-undo .
      625   define variable ii-cmp as integer no-undo .
      626   define variable ii-prs-ok as integer no-undo .
      627   define variable ii-cmp-ok as integer no-undo .
      628   define variable ii-err-rec as integer no-undo .
      629   define variable v-uniq-key-rec as character no-undo .
      630   define variable v-rid as recid no-undo .
      631   define variable v-tbl-row as rowid no-undo .
      632   define variable v-tbl-name as character no-undo .
      633   define buffer buf_ext-classif for ub.ext-classif.
      634   define buffer buf_firm for ub.firm.
      635   define buffer buf_person for ub.person.
      636   define buffer buf_clients for ub.clients.
      637   _cmp:
      638   for each buf_firm no-lock
      639   on error undo, next _cmp
      640   on stop undo, next _cmp:
      641      assign
      642      ii-cmp = ii-cmp + 1.
      643      ii = ii + 1.
      644      .
      645      run write-counter in p-log-handle ( input substitute("Просмотрено &1 записей контрагентов", ii)) .
      646      if trim(buf_firm.inn) = '':U then next _cmp.
      647      find first buf_clients no-lock where
      648                 buf_clients.obj-type = 'орг':U
      649             and buf_clients.obj-code = buf_firm.firm-code no-error.
      650       run gen-key-rec in this-procedure (
      651                                           input  ('clients':U)
      652                                           ,input  (buffer buf_clients:handle)
      653                                           ,output v-uniq-key-rec ).
      654      find first buf_ext-classif where
      655               buf_ext-classif.classif-subject = 'clients':U
      656           and buf_ext-classif.classif-name = 'inn':U
      657           and buf_ext-classif.charkey_one  = buf_firm.inn
      658           and buf_ext-classif.db-num  = -1
      659           and buf_ext-classif.uniq-key-rec = v-uniq-key-rec
      660           no-error.
      661      if available buf_ext-classif
      662      and buf_ext-classif.charkey_one = buf_firm.inn then next _cmp.
      663      if available buf_ext-classif
      664      and buf_ext-classif.charkey_one <> buf_firm.inn then do:
      665        run ref/extclas3.p ( input yes
      666                            ,input recid(buf_ext-classif)) no-error.
      667        if error-status:error then do:
      668           run write-log in p-log-handle (
      669                 input 1
      670               , input substitute( substitute("Ошибка при удалении ИНН (ext-classif), не совпадающего с ИНН в карточке &1&2"
      671                                              , 'орг':U, buf_firm.firm-code))).
      672          next _cmp.
      673        end.
      674        else do:
      675         ii-err-rec = ii-err-rec + 1.
      676        end.
      677      end.
      678      run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
      679                           ,INPUT NO
      680                           ,INPUT-OUTPUT v-rid
      681                           ,INPUT 'clients':U
      682                           ,INPUT 'inn':U
      683                           ,input (-1)
      684                           ,input 0
      685                           ,input 0
      686                           ,input 0
      687                           ,input buf_firm.inn
      688                           ,input '':U
      689                           ,input '':U
      690                           ,input ''
      691                           ,input v-uniq-key-rec ) no-error.
      692       if not error-status:error then do:
      693         assign
      694         ii-cmp-ok = ii-cmp-ok + 1.
      695         .
      696      end.
      697      else do:
      698         run write-log in p-log-handle (
      699               input 1
      700             , input substitute( substitute("Ошибка при сохранении ИНН (ext-classif) для &1&2"
      701                                             , 'орг':U, buf_firm.firm-code))).
      702      end.
      703   end.
      704   _prs:
      705   for each buf_person no-lock
      706   on error undo, next _prs
      707   on stop undo, next _prs:
      708      assign
      709      ii-prs = ii-prs + 1.
      710      ii = ii + 1.
      711      .
      712      run write-counter in p-log-handle ( input substitute("Просмотрено &1 записей контрагентов", ii)).
      713      if trim(buf_person.inn) = '':U then next _prs.
      714      find first buf_clients no-lock where
      715                 buf_clients.obj-type = 'орг':U
      716             and buf_clients.obj-code = buf_person.psn-code no-error.
      717       run gen-key-rec in this-procedure (
      718                                           input  ('clients':U)
      719                                           ,input  (buffer buf_clients:handle)
      720                                           ,output v-uniq-key-rec ).
      721      find first buf_ext-classif where
      722               buf_ext-classif.classif-subject = 'clients':U
      723           and buf_ext-classif.classif-name = 'inn':U
      724           and buf_ext-classif.charkey_one  = buf_person.inn
      725           and buf_ext-classif.db-num  = -1
      726           and buf_ext-classif.uniq-key-rec = v-uniq-key-rec
      727           no-error.
      728      if available buf_ext-classif
      729      and buf_ext-classif.charkey_one = buf_person.inn then next _prs.
      730      if available buf_ext-classif
      731      and buf_ext-classif.charkey_one <> buf_person.inn then do:
      732        run ref/extclas3.p ( input yes
      733                            ,input recid(buf_ext-classif)) no-error.
      734        if error-status:error then do:
      735           run write-log in p-log-handle (
      736                 input 1
      737               , input substitute( substitute("Ошибка при удалении ИНН (ext-classif), не совпадающего с ИНН в карточке &1&2 "
      738                                              , 'чел':U, buf_person.psn-code))).
      739          next _prs.
      740        end.
      741        else do:
      742         ii-err-rec = ii-err-rec + 1.
      743        end.
      744      end.
      745      run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
      746                           ,INPUT NO
      747                           ,INPUT-OUTPUT v-rid
      748                           ,INPUT 'clients':U
      749                           ,INPUT 'inn':U
      750                           ,input (-1)
      751                           ,input 0
      752                           ,input 0
      753                           ,input 0
      754                           ,input buf_person.inn
      755                           ,input '':U
      756                           ,input '':U
      757                           ,input ""
      758                           ,input v-uniq-key-rec ) no-error.
      759      if not error-status:error then do:
      760       assign
      761       ii-prs-ok = ii-prs-ok + 1.
      762       .
      763      end.
      764      else do:
      765         run write-log in p-log-handle (
      766               input 1
      767             , input substitute( substitute("Ошибка при сохранении ИНН (ext-classif) для &1&2"
      768                                             , 'чел':U, buf_person.psn-code))).
      769      end.
      770   end.
      771   for each buf_ext-classif no-lock where
      772           buf_ext-classif.classif-subject = 'clients':U
      773      and buf_ext-classif.classif-name = 'inn':U:
      774     run gen-row-keyr  in this-procedure (
      775     input  buf_ext-classif.uniq-key-rec
      776     ,input  ?
      777     ,input  "ub"
      778     ,input  ?
      779     ,input NO-LOCK
      780     ,output v-tbl-row
      781     ,output v-tbl-name) no-error.
      782     if error-status:error
      783     or not v-tbl-name = 'clients':U then do:
      784        run ref/extclas3.p ( input yes
      785                            ,input recid(buf_ext-classif)) no-error.
      786        if error-status:error then do:
      787           run write-log in p-log-handle (
      788                 input 1
      789               , input substitute( substitute("Ошибка при удалении ИНН (ext-classif), с невернмы uniq-key-rec &1"
      790                                              , buf_ext-classif.uniq-key-rec))).
      791        end.
      792        else do:
      793         ii-err-rec = ii-err-rec + 1.
      794        end.
      795     end.
      796   end.
      797   run write-log in p-log-handle (
      798         input 1
      799       , input substitute( substitute("Просмотрено &1 записей по организациям и  &2 по физическим лицам&3" +
      800                                       "Сохранено кодов ИНН&3" +
      801                                       "&4 по организациям и &5 по физическим лицам&3" +
      802                                       "удалено &6 неверных записей"
      803                                       , ii-cmp
      804                                       , ii-prs
      805                                       , chr(10)
      806                                       , ii-cmp-ok
      807                                       , ii-prs-ok
      808                                       , ii-err-rec
      809                                       ))).
      810   end procedure.
