        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define  shared stream vProtTest.
       18   define  shared variable testId as rowid no-undo.
       19   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
       20       then run str/lib-trn.p persistent no-error .
       21   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn2)
       22       then run str/lib-trn2.p persistent no-error .
       23   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
       24       then run str/lib-trn3.p persistent no-error .
       25   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn4)
       26       then run str/lib-trn4.p persistent no-error .
       27   define temp-table tt-fin like ub.fin-doc.
       28   define var v-doc-code as char no-undo.
       29   if testId ne ? then
       30   do:
       31     find first ub.fin-doc where rowid(ub.fin-doc) = testId no-lock no-error.
       32   end.
       33   else
       34   do:
       35   DEFINE FRAME frame1
       36     v-doc-code format "x(15)"
       37     with view-as dialog-box
       38     title "Введите номер фин.документа"
       39   .
       40   update v-doc-code with frame frame1.
       41   find first ub.fin-doc where ub.fin-doc.fin-doc-code = integer(v-doc-code) no-error.
       42   end.
       43   if not available (ub.fin-doc)
       44     then do:
       45       message "Документ не найден: номер " v-doc-code view-as alert-box.
       46       return.
       47     end.
       48   buffer-copy fin-doc except fin-doc.status_ to tt-fin  assign tt-fin.status_ = "накл".
       49   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
       50     (input ?
       51     ,input this-procedure:handle
       52     ,input ?
       53     ,input 'event_fin-doc':U
       54     ,input  buffer tt-fin:handle
       55     ,input  buffer ub.fin-doc:handle
       56     ,input ''
       57     ,input ''
       58     ) no-error .
       59   if error-status:error
       60   then do:
       61     message return-value view-as alert-box.
       62   end.
       63   else do:
       64     if testId ne ? then
       65       put stream vProtTest unformatted "Фин.документ " fin-doc.prn-doc-code " отправлен" skip.
       66     else
       67       message fin-doc.prn-doc-code " отправлен" view-as alert-box.
       68   end.
