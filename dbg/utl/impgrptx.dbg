        1   block-level on error undo, throw.
        2   define input parameter p-mode           as character    no-undo .
        3   define input parameter p-node-code      as integer      no-undo .
        4   define input parameter p-upper-code     as integer      no-undo .
        5   define input parameter p-node-name      as character    no-undo .
        6   define input parameter p-host-code      as integer      no-undo .
        7   define input parameter p-obj-type       as character    no-undo .
        8   define input parameter p-obj-code       as integer      no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: 8d6ad4ee6014, 1102, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       11   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:52 2017 +0300 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: impgrptx.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: utl/impgrptx.p $":U .
       14   define variable vss-description as character no-undo init "Создание или изменение группы товара.".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73     define new shared temp-table  tt-tax no-undo
       74   field tax-code    like ub.tax.tax-code
       75   FIELD individual  like ub.tax.individual
       76   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       77   field rate-code   like ub.tax-rate.rate-code
       78   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       79   FIELD tax-type    like ub.tax.tax-type
       80   field rate-value  like ub.tax-rate-value.rate-value
       81   FIELD tax-rate-gds-rc  as recid
       82   FIELD to-cashdesk like ub.tax.to-cashdesk
       83   FIELD fact-date like ub.tax-rate-value.fact-date
       84   FIELD fact-order like ub.tax-rate-value.fact-order
       85   FIELD next-order like ub.tax-rate-value.fact-order
       86   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
       87   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
       88   FIELD corr-date like ub.tax-rate-gds.corr-date
       89   FIELD corr-time like ub.tax-rate-gds.corr-time
       90   index tax-code is unique primary tax-code fact-order descending rate-code.
       91   define new shared buffer goods for ub.goods.
       92       define variable v-node-code         as integer      no-undo.
       93       define variable v-upper-code        as integer      no-undo.
       94       define variable v-gds-grp-recid     as recid        no-undo.
       95   do
       96   on error undo, return error
       97   :
       98               assign
       99                   v-node-code  = p-node-code
      100                   v-upper-code = p-upper-code
      101               .
      102               run ref/gdsgrp01.p (
      103                     input p-mode
      104                   , input no
      105                   , input (if p-mode = 'ДОБАВЛЕНИЕ':U then yes else no)
      106                   , input no
      107                   , input-output v-node-code
      108                   , input-output v-upper-code
      109                   , input p-node-name
      110                   , input entry( 9, 'Учетная,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U )
      111                   , input 0
      112                   , input ""
      113                   , input entry( 5, '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U )
      114                   , input 0
      115                   , output v-gds-grp-recid
      116               ) no-error.
      117               if error-status :error
      118               then do:
      119                   message
      120                            vss-workfile vss-revision vss-description
      121                       skip(1)
      122                       skip "Ошибка создания или изменения группы товаров."
      123                       skip return-value
      124                       skip trim(error-status :get-message(1))
      125                            trim(error-status :get-message(2))
      126                            trim(error-status :get-message(3))
      127                   view-as alert-box error.
      128                   undo, return error .
      129               end.
      130               if p-mode = 'ДОБАВЛЕНИЕ':U
      131               then do:
      132                   run ref/dtaxgrps.p (
      133                         input 0
      134                       , input p-upper-code
      135                       , input p-host-code
      136                       , input p-obj-type
      137                       , input p-obj-code
      138                   ) no-error.
      139                   if error-status :error
      140                   then do:
      141                       message
      142                                vss-workfile vss-revision vss-description
      143                           skip(1)
      144                           skip "Ошибка заполнения таблицы налогов для групп товаров."
      145                           skip return-value
      146                           skip trim(error-status :get-message(1))
      147                                trim(error-status :get-message(2))
      148                                trim(error-status :get-message(3))
      149                       view-as alert-box error.
      150                       undo, return error .
      151                   end.
      152               end.
      153               else do:
      154                   for each tt-tax:
      155                       delete tt-tax.
      156                   end.
      157               end.
      158               run ref/dtaxgrpu.p (
      159                     input p-node-code
      160                   , input p-upper-code
      161                   , input yes
      162                   , input p-host-code
      163                   , input p-obj-type
      164                   , input p-obj-code
      165               ) no-error.
      166               if error-status :error
      167               then do:
      168                   message
      169                            vss-workfile vss-revision vss-description
      170                       skip(1)
      171                       skip "Ошибка привязки налогов к группе товаров."
      172                       skip return-value
      173                       skip trim(error-status :get-message(1))
      174                            trim(error-status :get-message(2))
      175                            trim(error-status :get-message(3))
      176                   view-as alert-box error.
      177                   undo, return error .
      178               end.
      179   end.
