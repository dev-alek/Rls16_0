        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Просмотр строк документа".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE QUERY external_tables FOR trn-doc.
      108   RUN set-attribute-list (
      109       'Keys-Accepted = ,
      110        Keys-Supplied = "obj-code,doc-code"':U).
      111   RUN set-attribute-list (
      112       'SortBy-Options = ""':U).
      113   DEFINE QUERY br_table FOR
      114         doc-line SCROLLING.
      115   DEFINE BROWSE br_table
      116     QUERY br_table NO-LOCK DISPLAY
      117         doc-line.artic           COLUMN-LABEL "artic"
      118         doc-line.prod-type       COLUMN-LABEL "prod-type"
      119         doc-line.prod-code       COLUMN-LABEL "prod-code"
      120         doc-line.cli-qnty        COLUMN-LABEL "cli-qnty"
      121         doc-line.cli-base-rate   COLUMN-LABEL "cli-base-rate"
      122         doc-line.doc-qnty        COLUMN-LABEL "doc-qnty"
      123         doc-line.fact-qnty       COLUMN-LABEL "fact-qnty"
      124         doc-line.price-cli       COLUMN-LABEL "price-cli"
      125         doc-line.price-base      COLUMN-LABEL "price-base"
      126         doc-line.price-rubl      COLUMN-LABEL "price-rubl"
      127         doc-line.VAT-pc          COLUMN-LABEL "VAT-pc"
      128         doc-line.SLT-pc          COLUMN-LABEL "SLT-pc"
      129         doc-line.road-tax        COLUMN-LABEL "road-tax"
      130         doc-line.transport-base  COLUMN-LABEL "transport-base"
      131         doc-line.transport-rubl  COLUMN-LABEL "transport-rubl"
      132         doc-line.other-base      COLUMN-LABEL "other-base"
      133         doc-line.other-rubl      COLUMN-LABEL "other-rubl"
      134         doc-line.excise          COLUMN-LABEL "excise"
      135         doc-line.doc-density     COLUMN-LABEL "doc-density"
      136         doc-line.fact-density    COLUMN-LABEL "fact-density"
      137         doc-line.doc-code        COLUMN-LABEL "doc-code"
      138         doc-line.fact-order      COLUMN-LABEL "fact-order"
      139         doc-line.line-num        COLUMN-LABEL "line-num"
      140         doc-line.num-place       COLUMN-LABEL "num-place"
      141         doc-line.obj-code        COLUMN-LABEL "obj-code"
      142         doc-line.obj-type        COLUMN-LABEL "obj-type"
      143         doc-line.prt-OK          COLUMN-LABEL "prt-OK"
      144         doc-line.prt-root        COLUMN-LABEL "prt-root"
      145         doc-line.status_         COLUMN-LABEL "status_"
      146         doc-line.temperature     COLUMN-LABEL "temperature"
      147         doc-line.unit-cli        COLUMN-LABEL "unit-cli"
      148         doc-line.wt-brutto       COLUMN-LABEL "wt-brutto"
      149       WITH NO-ASSIGN SEPARATORS SIZE 97.38 BY 6.71.
      150   DEFINE FRAME F-Main
      151        br_table AT ROW 1 COL 1
      152       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      153            SIDE-LABELS NO-UNDERLINE THREE-D
      154            AT COL 1 ROW 1 SCROLLABLE
      155            BGCOLOR 8 FGCOLOR 0 .
      156   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      157   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      158   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      159   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      160   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      161   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      162   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      163   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      164   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      165   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      166   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      167         adm-object-hdl = FRAME F-Main:HANDLE.
      168   RUN ensure-broker.
      169   THIS-PROCEDURE:ADM-DATA =
      170        'ADM1.1~`':U +
      171        'SmartObject~`':U +
      172        '~`':U +
      173        'YES~`':U +
      174        'trn-doc~`':U +
      175        'doc-line~`':U +
      176        '~`':U +
      177        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      178           + "~`":U +
      179        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      180        'Record-Source,Record-Target,TableIO-Target~`':U +
      181        '~`':U +
      182        '~`~`~`~`~`~`~`~`~`~`~`':U +
      183        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      184            THEN "^^":U
      185        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      186             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      187   PROCEDURE adm-apply-entry :
      188     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      189   END PROCEDURE.
      190   PROCEDURE adm-destroy :
      191    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      192   END PROCEDURE.
      193   PROCEDURE adm-disable :
      194       DISABLE br_table WITH FRAME F-Main.
      195       RUN dispatch ('disable-fields':U).
      196       RUN set-attribute-list ('ENABLED=no':U).
      197       RETURN.
      198   END PROCEDURE.
      199   PROCEDURE adm-edit-attribute-list :
      200         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      201         RETURN.
      202   END PROCEDURE.
      203   PROCEDURE adm-enable :
      204       ENABLE UNLESS-HIDDEN br_table WITH FRAME F-Main.
      205       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      206       RUN set-attribute-list ('ENABLED=yes':U).
      207       RETURN.
      208   END PROCEDURE.
      209   PROCEDURE adm-exit :
      210        RUN notify ('exit':U).
      211     RETURN.
      212   END PROCEDURE.
      213   PROCEDURE adm-hide :
      214     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      215   END PROCEDURE.
      216   PROCEDURE adm-initialize :
      217     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      218   END PROCEDURE.
      219   PROCEDURE adm-show-errors :
      220       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      221       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      222           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      223       END.
      224       RETURN.
      225   END PROCEDURE.
      226   PROCEDURE adm-UIB-mode :
      227     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      228   END PROCEDURE.
      229   PROCEDURE adm-view :
      230     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      231   END PROCEDURE.
      232   PROCEDURE dispatch :
      233       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      234       RUN broker-dispatch IN adm-broker-hdl
      235           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      236       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      237   END PROCEDURE.
      238   PROCEDURE ensure-broker :
      239   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      240   IF RETURN-VALUE NE "ADM-Broker":U THEN
      241   DO:
      242       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      243       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      244   END.
      245   END PROCEDURE.
      246   PROCEDURE get-attribute :
      247     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      248     RUN broker-get-attribute IN adm-broker-hdl
      249         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      250     RETURN RETURN-VALUE.
      251   END PROCEDURE.
      252   PROCEDURE get-attribute-list :
      253     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      254     RUN broker-get-attribute-list IN adm-broker-hdl
      255         (INPUT THIS-PROCEDURE,
      256          INPUT ?,
      257          OUTPUT p-attr-list) NO-ERROR.
      258     RETURN.
      259   END PROCEDURE.
      260   PROCEDURE new-state :
      261     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      262     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      263     RETURN.
      264   END PROCEDURE.
      265   PROCEDURE notify :
      266     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      267     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      268     IF RETURN-VALUE = "ADM-ERROR":U THEN
      269         RETURN "ADM-ERROR":U.
      270     RETURN.
      271   END PROCEDURE.
      272   PROCEDURE set-attribute-list :
      273     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      274     RUN ensure-broker.
      275     RUN broker-set-attribute-list IN adm-broker-hdl
      276         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      277     RETURN.
      278   END PROCEDURE.
      279   PROCEDURE set-position :
      280       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      281       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      282       IF VALID-HANDLE(adm-object-hdl) THEN
      283       DO:
      284         ASSIGN adm-object-hdl:ROW    =   p-row
      285                adm-object-hdl:COLUMN =   p-col.
      286       END.
      287       RETURN.
      288   END PROCEDURE.
      289     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      290     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      291     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      292     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      293     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      294     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      295     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      296     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      297     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      298     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      299     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      300     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      301     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      302     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      303     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      304     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      305     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      306     IF "":U = "":U THEN
      307       RUN modify-list-attribute IN adm-broker-hdl
      308         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      309     RUN use-create-on-add(?).
      310   PROCEDURE adm-add-record :
      311       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      312          "must have at least one Enabled Table to perform Add.":U
      313          VIEW-AS ALERT-BOX ERROR.
      314       RETURN.
      315   END PROCEDURE.
      316   PROCEDURE adm-assign-record :
      317    MESSAGE
      318          "Object ":U THIS-PROCEDURE:FILE-NAME
      319            "must have at least one Enabled Table to perform Assign.":U
      320              VIEW-AS ALERT-BOX ERROR.
      321      RETURN.
      322     END PROCEDURE.
      323   PROCEDURE adm-assign-statement :
      324     RETURN.
      325   END PROCEDURE.
      326   PROCEDURE adm-cancel-record :
      327      RETURN.
      328     END PROCEDURE.
      329   PROCEDURE adm-copy-record :
      330       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      331        "must have at least one Enabled Table to perform Copy.":U
      332          VIEW-AS ALERT-BOX ERROR.
      333       RETURN.
      334   END PROCEDURE.
      335   PROCEDURE adm-create-record :
      336      RETURN.
      337   END PROCEDURE.
      338   PROCEDURE adm-current-changed :
      339     RETURN.
      340   END PROCEDURE.
      341   PROCEDURE adm-delete-record :
      342    MESSAGE
      343          "Object ":U THIS-PROCEDURE:FILE-NAME
      344            "must have at least one Enabled Table to perform Delete.":U
      345              VIEW-AS ALERT-BOX ERROR.
      346       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      347       RETURN.
      348   END PROCEDURE.
      349   PROCEDURE adm-disable-fields :
      350         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      351       RETURN.
      352   END PROCEDURE.
      353   PROCEDURE adm-enable-fields :
      354       RETURN.
      355   END PROCEDURE.
      356   PROCEDURE adm-end-update :
      357     RETURN.
      358   END PROCEDURE.
      359   PROCEDURE adm-reset-record :
      360       RETURN.
      361   END PROCEDURE.
      362   PROCEDURE adm-update-record :
      363       MESSAGE
      364         "Object ":U THIS-PROCEDURE:FILE-NAME
      365           "must have at least one Enabled Table to perform Update.":U
      366             VIEW-AS ALERT-BOX ERROR.
      367      RETURN.
      368   END PROCEDURE.
      369   PROCEDURE check-modified :
      370   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      371   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      372   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      373   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      374     IF check-state = "check":U THEN
      375     DO:
      376       RUN get-link-handle IN adm-broker-hdl
      377         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      378            OUTPUT group-target-list).
      379       IF group-target-list NE "":U THEN
      380       DO i = 1 TO NUM-ENTRIES(group-target-list):
      381         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      382         RUN check-modified IN curr-widget ('group-check':U).
      383         IF RETURN-VALUE NE "":U THEN
      384         DO:
      385           RUN check-modified-message(RETURN-VALUE).
      386           RETURN "":U.
      387         END.
      388       END.
      389     END.
      390     RETURN "":U.
      391   END PROCEDURE.
      392   PROCEDURE check-modified-message :
      393     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      394        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      395           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      396        IF RETURN-VALUE = "YES":U THEN
      397           RUN notify ('view,CONTAINER-SOURCE':U).
      398        MESSAGE IF p-changed-table NE ? THEN
      399           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      400           ELSE "Current values have been changed."
      401           SKIP "  Do you wish to save those changes?"
      402           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      403        IF ANS THEN
      404        DO:
      405           IF group-assign-target THEN
      406             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      407           ELSE RUN dispatch('update-record':U).
      408           IF RETURN-VALUE = "ADM-ERROR":U THEN
      409           DO:
      410               MESSAGE "Changes to the previous record were not saved."
      411                 VIEW-AS ALERT-BOX ERROR.
      412               IF group-assign-target THEN
      413                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      414               ELSE RUN dispatch ('cancel-record':U).
      415           END.
      416        END.
      417        ELSE DO:
      418          IF group-assign-target THEN
      419             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      420          ELSE RUN dispatch('cancel-record':U).
      421        END.
      422        RETURN.
      423   END PROCEDURE.
      424   PROCEDURE get-rowid :
      425       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      426       ASSIGN
      427       p-table   =   adm-first-table.
      428       RETURN.
      429   END PROCEDURE.
      430   PROCEDURE init-group-assign :
      431       RUN request-attribute IN adm-broker-hdl
      432         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      433       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      434         group-assign-target = yes.
      435       ELSE group-assign-target = no.
      436       RETURN.
      437   END PROCEDURE.
      438   PROCEDURE set-editors :
      439       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      440       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      441       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      442       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      443       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      444       DO WHILE VALID-HANDLE (curr-widget):
      445           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      446              curr-widget:HIDDEN = no THEN DO:
      447             CASE p-field-setting:
      448               WHEN "INITIALIZE":U THEN
      449               DO:
      450                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      451                     read-only-list +
      452                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      453                        STRING(curr-widget).
      454               END.
      455               WHEN "DISABLE":U OR
      456               WHEN "ENABLE":U THEN
      457               DO:
      458                   curr-widget:SENSITIVE = yes.
      459                   RUN get-attribute ('Read-Only-Editors':U).
      460                   IF RETURN-VALUE = ? OR
      461                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      462                       curr-widget:READ-ONLY =
      463                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      464               END.
      465               WHEN "CLEAR":U THEN
      466                   curr-widget:SCREEN-VALUE = "":U.
      467             END CASE.
      468           END.
      469           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      470       END.
      471       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      472         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      473           + '"':U).
      474       RETURN.
      475   END PROCEDURE.
      476   PROCEDURE use-check-modified-all :
      477    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      478     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      479     RETURN.
      480   END PROCEDURE.
      481   PROCEDURE use-create-on-add :
      482   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      483      RETURN.
      484   END PROCEDURE.
      485   PROCEDURE use-initial-lock :
      486     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      487     ASSIGN adm-initial-lock = p-attr-value.
      488     RETURN.
      489   END PROCEDURE.
      490   PROCEDURE adm-display-fields :
      491         IF AVAILABLE doc-line THEN
      492             DISPLAY doc-line.artic doc-line.prod-type doc-line.prod-code doc-line.cli-qnty doc-line.cli-base-rate doc-line.doc-qnty doc-line.fact-qnty doc-line.price-cli doc-line.price-base doc-line.price-rubl doc-line.VAT-pc doc-line.SLT-pc doc-line.road-tax doc-line.transport-base doc-line.transport-rubl doc-line.other-base doc-line.other-rubl doc-line.excise doc-line.doc-density doc-line.fact-density doc-line.doc-code doc-line.fact-order doc-line.line-num doc-line.num-place doc-line.obj-code doc-line.obj-type doc-line.prt-OK doc-line.prt-root doc-line.status_ doc-line.temperature doc-line.unit-cli doc-line.wt-brutto WITH BROWSE br_table
      493               NO-ERROR.
      494       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      495       RETURN.
      496   END PROCEDURE.
      497   PROCEDURE adm-open-query :
      498       IF AVAILABLE(trn-doc) THEN DO:
      499               RUN dispatch ('open-query-cases':U).
      500           adm-query-opened = yes.
      501           IF NUM-RESULTS("br_table":U) = 0 THEN
      502               RUN new-state ('no-record-available,SELF':U).
      503           ELSE DO:
      504               RUN new-state ('record-available,SELF':U).
      505               RUN new-state ('first-record,SELF':U).
      506           END.
      507       END.
      508       ELSE
      509       DO:
      510           CLOSE QUERY br_table.
      511           RELEASE doc-line NO-ERROR.
      512           RUN new-state ('no-external-record-available,SELF':U).
      513       END.
      514           IF NOT adm-updating-record THEN
      515               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      516     RETURN.
      517   END PROCEDURE.
      518   PROCEDURE adm-row-changed :
      519         IF VALID-HANDLE(adm-object-hdl) THEN
      520           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      521         RUN notify ('row-available':U).
      522         RETURN.
      523   END PROCEDURE.
      524   PROCEDURE reposition-query :
      525       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      526       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      527       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      528       IF table-name <> ? THEN
      529           REPOSITION br_table TO ROWID table-name NO-ERROR.
      530       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      531       RETURN.
      532   END PROCEDURE.
      533     adm-sts = br_table:SET-REPOSITIONED-ROW
      534       (br_table:DOWN,"CONDITIONAL":U).
      535     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      536   PROCEDURE set-size :
      537     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      538     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      539     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      540     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      541     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      542     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      543     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      544     ASSIGN pd_height = MAX(pd_height, 2.0)
      545            pd_width  = MAX(pd_width, 2.0)
      546            hBrowse     = br_table:HANDLE IN FRAME F-Main
      547            hFieldGroup = hBrowse:PARENT
      548            htmpWidget  = hFieldGroup:FIRST-CHILD
      549            hFrame      = hFieldGroup:PARENT.
      550     Search-For-Siblings:
      551     REPEAT WHILE VALID-HANDLE(htmpWidget):
      552       IF htmpWidget NE hBrowse THEN DO:
      553         IF htmpWidget:TYPE NE "BUTTON" OR
      554            htmpWidget:X    NE 4 OR
      555            htmpWidget:Y    NE 4 THEN DO:
      556           RETURN.
      557         END.
      558       END.
      559       htmpWidget = htmpWidget:NEXT-SIBLING.
      560     END.
      561     IF pd_width < hBrowse:WIDTH THEN
      562       ASSIGN hBrowse:WIDTH = pd_width
      563              hFrame:WIDTH  = pd_width     NO-ERROR.
      564     ELSE
      565       ASSIGN hFrame:WIDTH  = pd_width
      566              hBrowse:WIDTH = pd_width     NO-ERROR.
      567     IF pd_height < hBrowse:HEIGHT THEN
      568       ASSIGN hBrowse:HEIGHT = pd_height
      569              hFrame:HEIGHT  = pd_height     NO-ERROR.
      570     ELSE
      571       ASSIGN hFrame:HEIGHT  = pd_height
      572              hBrowse:HEIGHT = pd_height     NO-ERROR.
      573   END PROCEDURE.
      574   ASSIGN
      575          FRAME F-Main:SCROLLABLE       = FALSE
      576          FRAME F-Main:HIDDEN           = TRUE.
      577   ON ROW-ENTRY OF br_table IN FRAME F-Main
      578   DO:
      579   END.
      580   ON ROW-LEAVE OF br_table IN FRAME F-Main
      581   DO:
      582   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      583   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      584   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      585     widget-enter = last-event:widget-enter.
      586     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      587     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      588       THEN widget-frame = widget-enter:FRAME.
      589     IF ((NOT VALID-HANDLE(widget-enter)) OR
      590         (widget-parent:TYPE = "BROWSE":U) OR
      591         (NOT VALID-HANDLE(widget-frame)) OR
      592         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      593     THEN DO:
      594         IF adm-brs-in-update THEN
      595         DO:
      596           MESSAGE
      597           "You must complete or cancel the update before leaving the current row."
      598               VIEW-AS ALERT-BOX WARNING.
      599           RETURN NO-APPLY.
      600         END.
      601         IF br_table:CURRENT-ROW-MODIFIED  OR
      602           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      603         DO:
      604           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      605           THEN DO:
      606             MESSAGE
      607             "Current record has been changed. " SKIP
      608             "Do you wish to save those changes?"
      609               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      610             IF l-save THEN
      611             DO:
      612                RUN dispatch('update-record':U).
      613                IF RETURN-VALUE = "ADM-ERROR":U THEN
      614                    RETURN NO-APPLY.
      615             END.
      616             ELSE RUN dispatch ('cancel-record':U).
      617           END.
      618           ELSE DO:
      619             RUN dispatch('update-record':U).
      620             IF RETURN-VALUE = "ADM-ERROR":U THEN
      621                 RETURN NO-APPLY.
      622           END.
      623         END.
      624     END.
      625   END.
      626   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      627   DO:
      628   RUN get-attribute('ADM-NEW-RECORD':U).
      629   IF RETURN-VALUE NE "YES":U THEN
      630     RUN notify ('row-available':U).
      631   END.
      632   if not this-procedure :persistent
      633   then do:
      634     message
      635       vss-workfile vss-revision vss-description skip
      636       "Ошибка при запуске процедуры" skip
      637       "Данную процедуру следует запускать только с параметром persistent" skip
      638       view-as alert-box error .
      639     undo, return error .
      640   end.
      641   PROCEDURE adm-open-query-cases :
      642     OPEN QUERY br_table FOR EACH doc-line where doc-line.doc-code = trn-doc.doc-code NO-LOCK     .
      643   END PROCEDURE.
      644   PROCEDURE adm-row-available :
      645     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      646     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      647     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      648     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      649     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      650     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      651     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      652     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      653     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      654     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      655     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      656     IF adm-updating-record THEN RETURN.
      657     RUN get-attribute ('FIELDS-ENABLED':U).
      658     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      659     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      660         OUTPUT link-handle) NO-ERROR.
      661     IF link-handle = "":U THEN
      662         RETURN.
      663     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      664     IF NUM-ENTRIES(link-handle) > 1 THEN
      665         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      666             "encountered more than one RECORD-SOURCE.":U SKIP
      667             "The first - ":U record-source-hdl:file-name " - will be used.":U
      668                VIEW-AS ALERT-BOX ERROR.
      669     RUN get-attribute ('Key-Name':U).
      670     key-name = RETURN-VALUE.
      671     IF key-name = "":U THEN key-name = ?.
      672     IF key-name NE ? THEN DO:
      673       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      674         NO-ERROR.
      675       IF key-value NE ? THEN
      676         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      677     END.
      678     IF key-name eq ? THEN tbl-list = "trn-doc":U.
      679         RUN send-records IN record-source-hdl
      680             (INPUT tbl-list, OUTPUT rowid-list) NO-ERROR.
      681         IF ERROR-STATUS:ERROR THEN RETURN.
      682     IF key-name ne ?
      683     THEN DO:
      684       RUN dispatch ('find-using-key':U).
      685       IF RETURN-VALUE eq "ADM-ERROR":U THEN RETURN RETURN-VALUE.
      686     END.
      687     ELSE
      688     DO:
      689       row-avail-cntr = row-avail-cntr + 1.
      690       row-avail-rowid = TO-ROWID(ENTRY(row-avail-cntr,rowid-list)).
      691       IF row-avail-rowid NE ROWID(trn-doc) THEN different-row = yes.
      692       IF row-avail-rowid ne ? THEN DO:
      693          DO:
      694            IF row-avail-enabled AND
      695               (adm-initial-lock = "SHARE-LOCK":U OR
      696                adm-initial-lock = "EXCLUSIVE-LOCK":U) THEN
      697            DO:
      698              IF adm-initial-lock = "SHARE-LOCK":U
      699              THEN FIND trn-doc WHERE ROWID(trn-doc) = row-avail-rowid SHARE-LOCK NO-ERROR.
      700              ELSE DO TRANSACTION:
      701                FIND trn-doc WHERE ROWID(trn-doc) = row-avail-rowid EXCLUSIVE-LOCK NO-ERROR.
      702              END.
      703            END.
      704            ELSE FIND trn-doc WHERE ROWID(trn-doc) = row-avail-rowid  NO-LOCK NO-ERROR.
      705            IF ERROR-STATUS:ERROR THEN DO:
      706              RUN dispatch ('show-errors':U).
      707              RETURN "ADM-ERROR":U.
      708            END.
      709          END.
      710       END.
      711       ELSE DO:
      712            IF AVAILABLE trn-doc THEN RELEASE trn-doc.
      713              IF NOT different-row THEN
      714                RUN dispatch('open-query').
      715        END.
      716     END.
      717   IF VALID-HANDLE (adm-object-hdl) THEN
      718       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      719     IF key-name ne ? OR different-row
      720     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      721     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
      722   END PROCEDURE.
      723   PROCEDURE disable_UI :
      724     HIDE FRAME F-Main.
      725     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      726   END PROCEDURE.
      727   PROCEDURE send-key :
      728     DEFINE INPUT  PARAMETER pc_key-name   AS CHARACTER NO-UNDO.
      729     DEFINE OUTPUT PARAMETER pc_key-value  AS CHARACTER NO-UNDO INITIAL ?.
      730     CASE pc_key-name:
      731       WHEN "obj-code" THEN
      732         pc_key-value = IF AVAILABLE doc-line THEN STRING(doc-line.obj-code) ELSE ?.
      733       WHEN "doc-code" THEN
      734         pc_key-value = IF AVAILABLE doc-line THEN STRING(doc-line.doc-code) ELSE ?.
      735         WHEN "":U THEN .
      736         OTHERWISE MESSAGE "Entry ":U pc_key-name
      737                           " was not found in the send-key cases in ":U
      738                           THIS-PROCEDURE:FILE-NAME
      739                         VIEW-AS ALERT-BOX ERROR.
      740     END CASE.
      741   END PROCEDURE.
      742   PROCEDURE send-records :
      743     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
      744     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
      745     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
      746     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
      747     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
      748     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
      749         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
      750         CASE ENTRY(i, p-tbl-list):
      751       WHEN "trn-doc":U THEN p-rowid-list = p-rowid-list +
      752           IF AVAILABLE trn-doc THEN STRING(ROWID(trn-doc))
      753           ELSE "?":U.
      754       WHEN "doc-line":U THEN p-rowid-list = p-rowid-list +
      755           IF AVAILABLE doc-line THEN STRING(ROWID(doc-line))
      756           ELSE "?":U.
      757           OTHERWISE
      758           DO:
      759               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      760                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
      761               IF link-handle NE "":U THEN
      762               DO:
      763                   IF NUM-ENTRIES(link-handle) > 1 THEN
      764                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
      765                               "encountered more than one RECORD-SOURCE.":U SKIP
      766                               "The first will be used.":U
      767                               VIEW-AS ALERT-BOX ERROR.
      768                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
      769                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
      770                   p-rowid-list = p-rowid-list + rowid-string.
      771               END.
      772               ELSE
      773               DO:
      774                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
      775                           "does not match tables in send-records":U
      776                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
      777                           "Check that objects are linked properly and that":U
      778                           "database qualification is consistent.":U
      779                       VIEW-AS ALERT-BOX ERROR.
      780                   RETURN ERROR.
      781               END.
      782           END.
      783           END CASE.
      784       END.
      785   END PROCEDURE.
      786   PROCEDURE state-changed :
      787     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      788     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      789     CASE p-state:
      790       WHEN "update-begin":U THEN
      791       DO:
      792           adm-brs-in-update = yes.
      793           RUN dispatch ('enable-fields':U).
      794           IF RETURN-VALUE = "ADM-ERROR":U THEN
      795           DO:
      796             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      797             RUN new-state('update-complete':U).
      798           END.
      799           ELSE DO:
      800             RUN dispatch ('apply-entry':U).
      801             RUN new-state('update':U).
      802           END.
      803       END.
      804       WHEN "update":U THEN
      805         DO:
      806           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
      807           RUN get-link-handle IN adm-broker-hdl
      808               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
      809                   NO-ERROR.
      810           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
      811             br_table:SENSITIVE IN FRAME F-Main = no.
      812         END.
      813       WHEN "update-complete":U THEN DO:
      814           br_table:SENSITIVE IN FRAME F-Main = yes.
      815           adm-brs-in-update = no.
      816           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
      817           IF RETURN-VALUE NE "YES":U THEN
      818           DO:
      819             IF NUM-RESULTS("br_table":U) NE ? AND
      820                NUM-RESULTS("br_table":U) NE 0
      821             THEN DO:
      822               GET CURRENT br_table.
      823               RUN dispatch ('row-changed':U).
      824             END.
      825           END.
      826           RUN new-state ('update-complete':U).
      827       END.
      828       WHEN "delete-complete":U THEN DO:
      829          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
      830          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
      831          IF NUM-RESULTS("br_table":U) = 0 THEN
      832            RUN notify('row-available':U).
      833       END.
      834       WHEN   'first-record':U        OR
      835         WHEN 'last-record':U         OR
      836         WHEN 'only-record':U         OR
      837         WHEN 'not-first-or-last':U   OR
      838         WHEN 'no-record-available':U OR
      839         WHEN 'no-external-record-available':U THEN
      840           RUN set-attribute-list('Query-Position=':U + p-state).
      841     END CASE.
      842   END PROCEDURE.
