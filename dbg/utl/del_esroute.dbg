        1   block-level on error undo, throw.
        2   for each esys-route :
        3    find first esys-pck-sent no-lock where esys-pck-sent.esys-id = esys-route.esys-id
        4                                       and esys-pck-sent.db-num = esys-route.db-num
        5                                       and esys-pck-sent.esps-pack-num = esys-route.esr-last-pack
        6                                       no-error.
        7    if not available esys-pck-sent then next.
        8    if esys-pck-sent.esps-rcvd = no then next.
        9    for each esys-route-dump where esys-route-dump.esrd-dump-ord = esys-route.esr-dump-ord:
       10      delete esys-route-dump no-error .
       11    end.
       12    delete esys-route.
       13   end.
       14   message "Готово" view-as alert-box.
