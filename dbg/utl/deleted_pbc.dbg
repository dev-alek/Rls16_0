        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: bf04b0e5cfa2, 2256, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: druban $":U .
        4   define variable vss-date        as character no-undo init "$Date: Wed Dec 25 15:24:01 2019 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: deleted_pbc.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/deleted_pbc.p $":U .
        7   define variable vss-description as character no-undo init "Удаление незакрытых накладных с просроч. платежами и связаными с ними ФО".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable v-file-name as character no-undo.
       63   define variable v-file-line-str as character initial "" no-undo.
       64   define variable v-lst-del-pbc   as character initial "" no-undo.
       65   define variable v-cnt-line as integer no-undo.
       66   define variable v-num-entry as integer no-undo.
       67   define variable v-i as integer initial 0 no-undo.
       68   define variable v-i1 as integer initial 0 no-undo.
       69   define variable v-i2 as integer initial 0 no-undo.
       70   define variable v-i3 as integer initial 0 no-undo.
       71   define temp-table tt-deleted-pbc no-undo
       72       field b-str like ub.prod-bc.b-str
       73       index pi as primary unique b-str
       74   .
       75   procedure proc-mes-err-file-empty:
       76       message "Внимание!" skip
       77       "Файл соответствий не содержит значимых данных!" skip(2)
       78       "Обязательно проверьте:" skip
       79       "- доп.Бар-коды отделены друг от друга запятыми" skip
       80       "(кроме запятых не используйте в качестве разделителей кавычки и др. символы!);" skip
       81       "- доп.Бар-коды не содержат пустых значений или не состоят из одних пробелов;"
       82       "- под списком доп.Баркодов должна стоять пустая строка!" skip
       83       "- список соответствий заполняется в файле: deleted_pbc.txt"
       84       view-as alert-box error.
       85   end procedure.
       86   do:
       87       v-file-name = "deleted_pbc.txt".
       88       if search(v-file-name) = ? then
       89           do:
       90               message "Внимание!" skip
       91               "Не найден файл соответствия - deleted_pbc.txt" skip(2)
       92               "Создайте файл deleted_pbc.txt в рабочей директории и заполните его доп.Баркодами, которые Вы хотите удалить." view-as alert-box error.
       93               return.
       94           end.
       95           input from value(v-file-name).
       96               repeat:
       97                   import unformatted v-file-line-str.
       98                   v-lst-del-pbc = v-lst-del-pbc + trim(v-file-line-str).
       99                   v-file-line-str = "".
      100                   v-cnt-line = v-cnt-line + 1.
      101               end.
      102           input close.
      103           if v-cnt-line = 0 then
      104               do:
      105                   run proc-mes-err-file-empty.
      106                   return.
      107               end.
      108           v-num-entry = num-entries(v-lst-del-pbc).
      109           if v-num-entry > 0 then
      110               do:
      111                   do v-i = 1 to v-num-entry:
      112                       if trim(entry(v-i, v-lst-del-pbc, ",")) <> "" then
      113                           do:
      114                               if not can-find(first tt-deleted-pbc where tt-deleted-pbc.b-str = trim(entry(v-i, v-lst-del-pbc, ","))) then
      115                                   do:
      116                                       create tt-deleted-pbc.
      117                                       tt-deleted-pbc.b-str = trim(entry(v-i, v-lst-del-pbc, ",")).
      118                                       v-i1 = v-i1 + 1.
      119                                   end.
      120                               else
      121                                   do:
      122                                       v-i3 = v-i3 + 1.
      123                                   end.
      124                           end.
      125                   end.
      126               end.
      127           else
      128               do:
      129                   run proc-mes-err-file-empty.
      130                   return.
      131               end.
      132       for each tt-deleted-pbc no-lock:
      133           find first ub.prod-bc where
      134           ub.prod-bc.b-str = tt-deleted-pbc.b-str exclusive-lock no-error.
      135           if available ub.prod-bc then
      136               do:
      137                   v-i2 = v-i2 + 1.
      138                    delete ub.prod-bc.
      139               end.
      140       end.
      141       if v-i2 = 0 and v-i1 = 0 then
      142       do:
      143           run proc-mes-err-file-empty.
      144           return.
      145       end.
      146       if v-i2 = 0 then
      147           do:
      148               message "Внмание!" skip
      149               "Процесс удаления доп.Бар-кодов завершён." skip
      150               "Из запланированных к удалению - " v-i1 + v-i3 " позиц., " skip
      151               "удалено - " v-i2 " позиций доп.Бар-кодов." skip(2)
      152               "Запланированные к удалению поз. доп.Бар-кодов отсутствуют в ТН, возможно они удалены ранее!" view-as alert-box error.
      153           end.
      154       if v-i2 <> 0 and v-i1 <> v-i2 then
      155           do:
      156               message "Удаление доп.Бар-кодов произведено успешно!" skip
      157               "Из запланированных к удалению - " v-i1 + v-i3 " позиц., " skip
      158               if v-i3 = 0 then "" else "исключено повторов - " string(v-i3) "," skip
      159               "удалено - " v-i2 " позиц. доп. Бар-кодов." skip
      160               "Не удалось удалить - " (v-i1 - v-i2) " позиц.  доп.Бар-кода,  котор. отсутств. в ТН." skip
      161               view-as alert-box information.
      162           end.
      163       if v-i1 <> 0 and v-i1 = v-i2 then
      164           do:
      165               message "Удаление дополнительных Бар-кодов произведено успешно!" skip
      166               "Из запланированных к удалению - " v-i1 + v-i3 " позиц.," (if v-i3 = 0 then "" else " исключено повторов - " + string(v-i3) + ",") " удалено - " v-i2 " позиц. доп.Бар-кодов." view-as alert-box information.
      167           end.
      168   end.
