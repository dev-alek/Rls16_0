     2157   procedure thth150-db-attr-code :
     2158     do
     2159     on error undo, return error
     2160     :
     2161       define input  parameter p-code           as character no-undo .
     2162       define output parameter p-type           as character no-undo .
     2163       define output parameter p-format         as character no-undo .
     2164       define output parameter p-label          as character no-undo .
