     1256   procedure create_obj-list :
     1257      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1258      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1259      do
     1260      on error undo, return error return-value
     1261      :
     1262         define buffer cli-obj for ub.clients .
     1263         define variable p-var as integer no-undo .
     1264         define buffer buf_obj-list for obj-list .
     1265         find last buf_obj-list  use-index pi no-error .
     1266         if available buf_obj-list
     1267         then
     1268            p-var = buf_obj-list.obj-id + 1.
     1269         else
     1270            p-var = 1.
     1271         find first cli-obj where
     1272                   cli-obj.obj-type = p-obj-type
     1273               and cli-obj.obj-code = p-obj-code
     1274         no-lock no-error.
     1275         if available cli-obj
     1276         then do:
     1277            create buf_obj-list.
     1278            assign
     1279               buf_obj-list.obj-id   = p-var
     1280               buf_obj-list.obj-code = cli-obj.obj-code
     1281               buf_obj-list.obj-type = cli-obj.obj-type
     1282               buf_obj-list.obj-name = cli-obj.obj-name
     1283               buf_obj-list.db-num   = cli-obj.db-num
     1284            .
     1285         end.
     1286      end.
     1287   end.
