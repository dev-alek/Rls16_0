     2391   procedure thth14-db-attr-code :
     2392     do
     2393     on error undo, return error
     2394     :
     2395       define input  parameter p-code           as character no-undo .
     2396       define output parameter p-type           as character no-undo .
     2397       define output parameter p-format         as character no-undo .
     2398       define output parameter p-label          as character no-undo .
     2399       define output parameter p-user-can-edit  as logical   no-undo .
     2400       define output parameter p-output-display as logical   no-undo .
     2401       define output parameter p-other          as character no-undo .
     2402       case p-code :
     2403               when 'thth14-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2404               when 'thth14-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2405               when 'thth14-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2406               when 'thth14-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2407               when 'thth14-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2408               when 'thth14-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2409               when 'thth14-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2410               when 'thth14-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2411               when 'thth14-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2412               when 'thth14-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     2413         otherwise do:
     2414           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     2415         end.
     2416       end.
     2417     end.
     2418   end procedure.
     2419   procedure thth14-db-attr-tooltip :
     2420     do
     2421     on error undo, return error
     2422     :
     2423       define input  parameter p-code    as character no-undo .
     2424       define output parameter p-tooltip as character no-undo .
     2425       define output parameter p-label   as character no-undo .
     2426       case p-code :
     2427               when 'thth14-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
     2428               when 'thth14-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
     2429               when 'thth14-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
     2430               when 'thth14-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
     2431               when 'thth14-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
     2432               when 'thth14-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
     2433               when 'thth14-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
     2434               when 'thth14-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
     2435               when 'thth14-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
     2436               when 'thth14-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
     2437         otherwise do:
     2438           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     2439         end.
     2440       end.
     2441     end.
     2442   end procedure.
     2443   procedure thth14-db-attr-value :
     2444     do
     2445     on error undo, return error
     2446     :
     2447       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     2448       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     2449       define output parameter p-value     like ub.db-attr.attr-value no-undo .
     2450       define output parameter p-type      as character no-undo .
     2451       define buffer buf_db-attr for ub.db-attr .
     2452       define variable v-format         as character no-undo .
     2453       define variable v-label          as character no-undo .
     2454       define variable v-user-can-edit  as logical   no-undo .
     2455       define variable v-output-display as logical   no-undo .
     2456       define variable v-other          as character no-undo .
     2457       run thth14-db-attr-code in this-procedure
     2458         (input  p-code
     2459         ,output p-type
     2460         ,output v-format
     2461         ,output v-label
     2462         ,output v-user-can-edit
     2463         ,output v-output-display
     2464         ,output v-other
     2465         ) no-error .
     2466       if error-status :error then do:
     2467         undo, return error return-value .
     2468       end.
     2469       find first buf_db-attr no-lock
     2470         where buf_db-attr.db-num    = p-db-num
     2471           and buf_db-attr.attr-code = p-code
     2472         no-error .
     2473       if avail buf_db-attr then do:
     2474         assign
     2475           p-value =  buf_db-attr.attr-value
     2476         .
     2477       end.
     2478       else do:
     2479         assign
     2480           p-value = if p-type = 'L':U then "no":U else ""
     2481         .
     2482       end.
     2483     end.
     2484   end procedure.
     2485   procedure thth14-db-attr-write :
     2486     do
     2487     on error undo, return error
     2488     :
     2489       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     2490       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     2491       define input parameter p-value     like ub.db-attr.attr-value no-undo .
     2492       define buffer buf_db-attr for ub.db-attr .
     2493       define variable v-type           as character no-undo .
     2494       define variable v-format         as character no-undo .
     2495       define variable v-label          as character no-undo .
     2496       define variable v-user-can-edit  as logical   no-undo .
     2497       define variable v-output-display as logical   no-undo .
     2498       define variable v-other          as character no-undo .
     2499       run thth14-db-attr-code in this-procedure
     2500         (input  p-code
     2501         ,output v-type
     2502         ,output v-format
     2503         ,output v-label
     2504         ,output v-user-can-edit
     2505         ,output v-output-display
     2506         ,output v-other
     2507         ) no-error .
     2508       if error-status :error then do:
     2509         undo, return error return-value .
     2510       end.
     2511       find first buf_db-attr exclusive-lock
     2512         where buf_db-attr.db-num    = p-db-num
     2513           and buf_db-attr.attr-code = p-code
     2514         no-error .
     2515       if not available buf_db-attr then do:
     2516         create buf_db-attr .
     2517         assign
     2518           buf_db-attr.db-num    = p-db-num
     2519           buf_db-attr.attr-code = p-code
     2520         .
     2521       end.
     2522       assign
     2523         buf_db-attr.attr-value = p-value
     2524       .
     2525     end.
     2526   end procedure.
     2527   procedure thth14-db-attr-exist :
     2528     do
     2529     on error undo, return error
     2530     :
     2531       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     2532       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     2533       define output parameter p-exist    as logical  no-undo .
     2534       define buffer buf_db-attr for ub.db-attr .
     2535       define variable v-type           as character no-undo .
     2536       define variable v-format         as character no-undo .
     2537       define variable v-label          as character no-undo .
     2538       define variable v-user-can-edit  as logical   no-undo .
     2539       define variable v-output-display as logical   no-undo .
     2540       define variable v-other          as character no-undo .
     2541       run thth14-db-attr-code in this-procedure
     2542         (input  p-code
     2543         ,output v-type
     2544         ,output v-format
     2545         ,output v-label
     2546         ,output v-user-can-edit
     2547         ,output v-output-display
     2548         ,output v-other
     2549         ) no-error .
     2550       if error-status :error then do:
     2551         undo, return error return-value .
     2552       end.
     2553       find first buf_db-attr no-lock
     2554         where buf_db-attr.db-num    = p-db-num
     2555           and buf_db-attr.attr-code = p-code
     2556         no-error .
     2557       if  available buf_db-attr then do:
     2558         p-exist = yes.
     2559       end.
     2560     end.
     2561   end procedure.
     2562   procedure thth14-db-attr-delete :
     2563     do
     2564     on error undo, return error
     2565     :
     2566       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
     2567       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     2568       define output parameter p-deleted  as logical no-undo.
     2569       define buffer buf_db-attr for ub.db-attr .
     2570       define variable v-type           as character no-undo .
     2571       define variable v-format         as character no-undo .
     2572       define variable v-label          as character no-undo .
     2573       define variable v-user-can-edit  as logical   no-undo .
     2574       define variable v-output-display as logical   no-undo .
     2575       define variable v-other          as character no-undo .
     2576       run thth14-db-attr-code in this-procedure
     2577         (input  p-code
     2578         ,output v-type
     2579         ,output v-format
     2580         ,output v-label
     2581         ,output v-user-can-edit
     2582         ,output v-output-display
     2583         ,output v-other
     2584         ) no-error .
     2585       if error-status :error then do:
     2586         undo, return error return-value .
     2587       end.
     2588       find first buf_db-attr exclusive-lock
     2589         where buf_db-attr.db-num    = p-db-num
     2590           and buf_db-attr.attr-code = p-code
     2591         no-error NO-WAIT.
     2592       if not available buf_db-attr then do:
     2593         p-deleted = no.
     2594       end.
     2595       else do:
     2596         delete buf_db-attr.
     2597         p-deleted = yes.
     2598       end.
     2599     end.
     2600   end procedure.
     2601   procedure thth14-db-attr-news :
     2602     do
     2603     on error undo, return error
     2604     :
     2605       define input  parameter p-code           as character no-undo .
     2606       define output parameter p-news           as logical   no-undo .
     2607       case p-code :
     2608               when 'thth14-cli-grp':U then do:     assign     p-news = no.   end.
     2609               when 'thth14-gds-grp':U then do:     assign     p-news = no.   end.
     2610               when 'thth14-clients':U then do:     assign     p-news = no.   end.
     2611               when 'thth14-goods':U then do:     assign     p-news = no.   end.
     2612               when 'thth14-dis-card':U then do:     assign     p-news = no.   end.
     2613               when 'thth14-qnty-dis-card':U then do:     assign     p-news = no.   end.
     2614               when 'thth14-shop':U then do:     assign     p-news = no.   end.
     2615               when 'thth14-contract':U then do:     assign     p-news = no.   end.
     2616               when 'thth14-price-doc':U then do:     assign     p-news = no.   end.
     2617               when 'thth14-trn-doc':U then do:     assign     p-news = no.   end.
     2618         otherwise do:
     2619           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     2620         end.
     2621       end.
     2622     end.
     2623   end procedure.
