     1696   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1697   define  stream PrnLibStream.
     1698   procedure prn-lib-prn-file :
     1699     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1700     define input parameter p-DIsabledoptions as integer no-undo .
     1701     define variable v-report-name as character no-undo .
     1702     define variable v-user-action as character no-undo .
     1703     define variable v-printed     as logical   no-undo .
     1704     define variable v-exist       as logical   no-undo .
     1705     do
     1706       on error undo, return error
     1707       :
     1708       run prn-lib-get-report-name  in this-procedure (
     1709         input parParentProc
     1710         ,output v-report-name
     1711         ).
     1712   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1714     (input  v-report-name
     1715     ,input  2
     1716     ,output v-exist
     1717     )  .
     1718       if NOT v-exist then
     1719       DO:
     1720         Message
     1721           "Нет заданий на печать ! "
     1722           view-as alert-box .
     1723         Return  .
     1724       End.
     1725       run gbl/prnfilen.w
     1726         (input  ""
     1727         ,input  p-DisabledOptions
     1728         ,input  string(v-report-name )
     1729         ,input  7
     1730         ,output v-user-action
     1731         ,output v-printed
     1732         ) .
     1733       if v-printed then
     1734       do:
     1735         return "YES" .
     1736       end.
     1737       else
     1738       do:
     1739         return "NO" .
     1740       end.
     1741     end.
     1742   end procedure.
     1743   procedure prn-lib-open-stream :
     1744     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1745     define input parameter p-page-size    as integer no-undo .
     1746     define input parameter p-is-stream    as logical no-undo .
     1747     define input parameter p-append       as logical no-undo .
     1748     define variable v-report-name as character no-undo .
     1749     do
     1750       on error undo, return error
     1751       :
     1752       run prn-lib-get-report-name  in this-procedure (
     1753         input parParentProc
     1754         ,output v-report-name
     1755         ).
     1756       if p-is-stream then
     1757       do:
     1758         if p-append then
     1759         do:
     1760           output stream PrnLibStream to value( v-report-name )
     1761             page-size value(p-page-size) append .
     1762         end.
     1763         if not p-append then
     1764         do:
     1765           output stream PrnLibStream to value( v-report-name )
     1766             page-size value(p-page-size) .
     1767         end.
     1768       end.
     1769       if not p-is-stream then
     1770       do:
     1771         if p-append then
     1772         do:
     1773           output to value( v-report-name )
     1774             page-size value(p-page-size) append .
     1775         end.
     1776         if not p-append then
     1777         do:
     1778           output to value( v-report-name )
     1779             page-size value(p-page-size) .
     1780         end.
     1781       end.
     1782     end.
     1783   end procedure.
     1784   procedure prn-lib-open-exp :
     1785     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1786     define input parameter p-is-stream    as logical no-undo .
     1787     define input parameter p-is-append    as logical no-undo .
     1788     define output parameter p-ReportFileName as char init "report" no-undo.
     1789     define output parameter p-process as logical no-undo .
     1790     define variable glog as logical no-undo .
     1791     do
     1792       on error undo, return error
     1793       :
     1794       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1795         TITLE      "Укажите путь"
     1796         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1797         ASK-OVERWRITE
     1798         CREATE-TEST-FILE
     1799         SAVE-AS
     1800         USE-FILENAME
     1801         DEFAULT-EXTENSION "txt"
     1802         UPDATE glog
     1803         .
     1804       if not glog then  return.
     1805       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1806       if p-is-stream then
     1807       do:
     1808         if p-is-append then
     1809         do:
     1810           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1811         end.
     1812         else
     1813         do:
     1814           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1815         end.
     1816       end.
     1817       else
     1818       do:
     1819         if p-is-append then
     1820         do:
     1821           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1822         end.
     1823         else
     1824         do:
     1825           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1826         end.
     1827       end.
     1828       p-process = yes.
     1829     end.
     1830   end procedure.
     1831   procedure prn-lib-get-report-name :
     1832     define input parameter parParentProc  as widget-handle no-undo.
     1833     define output parameter p-report-name as character no-undo .
     1834     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1835   end procedure.
     1836   procedure prn-lib-reportviewer-report-name :
     1837     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1838     define input parameter p-report-name-html as character no-undo .
     1839     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1840   end procedure.
     1841   procedure prn-lib-reportviewer :
     1842     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1843     define input parameter p-report-name-html as character no-undo .
     1844     define input parameter p-param        as character no-undo .
     1845     define variable v-excel           as character no-undo init 'TRUE' .
     1846     define variable v-value-character as character no-undo .
     1847     define variable v-value-integer   as character no-undo .
     1848     define variable v-value-date      as date      no-undo .
     1849     define variable v-value-decimal   as decimal   no-undo .
     1850     define variable rep-excel         as logical   no-undo .
     1851     define variable excel-string      as character no-undo .
     1852     define variable v-param-type      as character no-undo .
     1853     define variable v-tth             as handle    no-undo .
     1854     run adm/shattri.p (
     1855       input "get":U
     1856       ,input  ""
     1857       ,input  0
     1858       ,input  'report-glob':U
     1859       ,input  'rep-excel':U
     1860       ,output v-value-character
     1861       ,output v-value-date
     1862       ,output v-value-decimal
     1863       ,output v-value-integer
     1864       ,output rep-excel
     1865       ,output v-param-type
     1866       ,INPUT-OUTPUT table-handle v-tth
     1867       )  .
     1868     if rep-excel then v-excel = "TRUE" .
     1869     else v-excel = "FALSE" .
     1870     if p-param eq ""
     1871     then
     1872        p-param = "EXCEL:" + v-excel.
     1873     else
     1874        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1875     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1876   end procedure.
     1877   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1878   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1879   procedure fltopend_fltopend :
     1880   define input parameter p-parent-handle as handle no-undo .
     1881   define input parameter p-qh as handle no-undo .
     1882   define input parameter p-flt-open-open-query  as character no-undo .
     1883   define input parameter p-where-cond as character no-undo .
     1884   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1885   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1886   define input parameter p-indexed-reposition as character no-undo .
     1887     do
     1888     on error undo, return error
     1889     :
     1890   define variable v-prepare-string as character no-undo .
     1891   define variable glog as logical no-undo .
     1892   assign
     1893   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1894                      p-where-cond + chr(32)  +
     1895                      p-use-indFIRST-query-tail + chr(32) +
     1896                      p-use-ind-sort-clmn-by + chr(32) +
     1897                      p-indexed-reposition
     1898   .
     1899   assign
     1900   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1901   if not glog
     1902   or error-status:error then do:
     1903     message error-status:get-message(1) view-as alert-box .
     1904     undo, return error .
     1905   end.
     1906   assign
     1907   glog = p-qh:query-open no-error .
     1908   if not glog
     1909   or error-status:error then do:
     1910     message error-status:get-message(1) view-as alert-box .
     1911     undo, return error .
     1912   end.
     1913     end.
     1914   end procedure.
     1915   procedure fltopend_fltfindd :
     1916   define input parameter p-parent-handle as handle no-undo .
     1917   define input parameter p-qh as handle no-undo .
     1918   define input parameter p-rowid as rowid no-undo .
     1919   define input parameter p-next as logical no-undo .
     1920   define input parameter p-lock as integer no-undo .
     1921   define input parameter p-bh as handle no-undo .
     1922   define input parameter p-where-cond as character no-undo .
     1923   define input parameter p-use-index-phrase as character no-undo .
     1924   define variable glog as logical no-undo .
     1925   define variable v-qh as handle no-undo .
     1926   define variable v-bh as handle no-undo .
     1927   define variable v-recid as recid no-undo .
     1928   define variable v-prepare-string as character no-undo .
     1929   do
     1930   on error undo, return error
     1931   on stop undo, return error
     1932   :
     1933     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1934     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1935     create query v-qh.
     1936     v-qh:set-buffers(v-bh).
     1937     v-prepare-string = substitute("for each &1 &2 &3"
     1938                                     ,v-bh:name
     1939                                     ,p-where-cond
     1940                                     ,p-use-index-phrase).
     1941     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1942     if not glog then do:
     1943       delete object v-qh.
     1944       delete object v-bh.
     1945       undo, return error .
     1946     end.
     1947     glog = v-qh:query-open no-error .
     1948     if not glog then do:
     1949       delete object v-qh.
     1950       delete object v-bh.
     1951       undo, return error .
     1952     end.
     1953     if p-next then do:
     1954       v-qh:reposition-to-rowid(p-rowid) no-error .
     1955       glog = v-qh:get-next( p-lock) no-error .
     1956       glog = v-qh:get-next( p-lock) no-error .
     1957       if not glog or v-qh:query-off-end = yes then do:
     1958         glog = v-qh:get-first( p-lock) no-error .
     1959       end.
     1960     end.
     1961     else do:
     1962       glog = v-qh:get-first( p-lock) no-error .
     1963     end.
     1964     v-recid = v-bh:recid no-error .
     1965     delete object v-qh.
     1966     delete object v-bh.
     1967     return string(v-recid) .
     1968   end.
     1969   end procedure.
     1970   procedure fltopend_fltfindq :
     1971   define input parameter p-parent-handle as handle no-undo .
     1972   define input parameter p-qh as handle no-undo .
     1973   define input parameter p-next as logical no-undo .
     1974   define input parameter p-lock as integer no-undo .
     1975   define input parameter p-flt-open-open-query  as character no-undo .
     1976   define input parameter p-where-cond as character no-undo .
     1977   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1978   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1979   define input parameter p-indexed-reposition as character no-undo .
     1980   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1981   define variable glog as logical no-undo .
     1982   define variable v-qh as handle no-undo .
     1983   define variable v-bh as handle no-undo extent 18.
     1984   define variable v-rowid as rowid no-undo extent 18.
     1985   define variable v-ii as integer no-undo .
     1986   define variable v-prepare-string as character no-undo .
     1987   do
     1988   on error undo, return error
     1989   on stop undo, return error
     1990   :
     1991     create query v-qh.
     1992     do v-ii = 1 to p-qh:num-buffers:
     1993       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1994       assign
     1995       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1996       no-error.
     1997       v-qh:add-buffer(v-bh[v-ii]).
     1998     end.
     1999     assign
     2000     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2001                       p-where-cond + chr(32)  +
     2002                       p-use-indFIRST-query-tail + chr(32) +
     2003                       p-use-ind-sort-clmn-by + chr(32) +
     2004                       p-indexed-reposition
     2005     .
     2006     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2007     if not glog then do:
     2008       delete object v-qh.
     2009       do v-ii = 1 to p-qh:num-buffers:
     2010         delete object v-bh[v-ii].
     2011       end.
     2012       undo, return error .
     2013     end.
     2014     glog = v-qh:query-open no-error .
     2015     if not glog then do:
     2016       delete object v-qh.
     2017       do v-ii = 1 to p-qh:num-buffers:
     2018         delete object v-bh[v-ii].
     2019       end.
     2020       undo, return error .
     2021     end.
     2022     if p-next then do:
     2023       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2024       glog = v-qh:get-next( p-lock) no-error .
     2025       glog = v-qh:get-next( p-lock) no-error .
     2026       if not glog or v-qh:query-off-end = yes then do:
     2027         glog = v-qh:get-first( p-lock) no-error .
     2028       end.
     2029     end.
     2030     else do:
     2031       glog = v-qh:get-first( p-lock) no-error .
     2032     end.
     2033     do v-ii = 1 to p-qh:num-buffers:
     2034       assign
     2035       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2036       no-error.
     2037     end.
     2038     delete object v-qh.
     2039     do v-ii = 1 to p-qh:num-buffers:
     2040       delete object v-bh[v-ii].
     2041     end.
     2042   end.
     2043   end procedure.
