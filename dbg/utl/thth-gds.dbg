     2209   procedure thth150-db-attr-value :
     2210     do
     2211     on error undo, return error
     2212     :
     2213       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     2214       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     2215       define output parameter p-value     like ub.db-attr.attr-value no-undo .
     2216       define output parameter p-type      as character no-undo .
     2217       define buffer buf_db-attr for ub.db-attr .
     2218       define variable v-format         as character no-undo .
     2219       define variable v-label          as character no-undo .
     2220       define variable v-user-can-edit  as logical   no-undo .
     2221       define variable v-output-display as logical   no-undo .
     2222       define variable v-other          as character no-undo .
     2223       run thth150-db-attr-code in this-procedure
     2224         (input  p-code
     2225         ,output p-type
     2226         ,output v-format
     2227         ,output v-label
     2228         ,output v-user-can-edit
     2229         ,output v-output-display
     2230         ,output v-other
     2231         ) no-error .
     2232       if error-status :error then do:
     2233         undo, return error return-value .
     2234       end.
     2235       find first buf_db-attr no-lock
     2236         where buf_db-attr.db-num    = p-db-num
     2237           and buf_db-attr.attr-code = p-code
     2238         no-error .
     2239       if avail buf_db-attr then do:
     2240         assign
     2241           p-value =  buf_db-attr.attr-value
     2242         .
     2243       end.
     2244       else do:
     2245         assign
     2246           p-value = if p-type = 'L':U then "no":U else ""
     2247         .
     2248       end.
     2249     end.
     2250   end procedure.
