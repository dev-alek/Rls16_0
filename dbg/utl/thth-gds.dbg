     2328   procedure thth150-db-attr-delete :
     2329     do
     2330     on error undo, return error
     2331     :
     2332       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
     2333       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     2334       define output parameter p-deleted  as logical no-undo.
     2335       define buffer buf_db-attr for ub.db-attr .
     2336       define variable v-type           as character no-undo .
     2337       define variable v-format         as character no-undo .
     2338       define variable v-label          as character no-undo .
     2339       define variable v-user-can-edit  as logical   no-undo .
     2340       define variable v-output-display as logical   no-undo .
