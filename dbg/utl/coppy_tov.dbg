       49   def
       50   new shared
       51   temp-table  obj-list no-undo
       52     field obj-type like ub.clients.obj-type
       53     field obj-code like ub.clients.obj-code
       54     field obj-name like ub.clients.obj-name
       55     field obj-id   as integer
       56     field db-num   as integer
       57     index pi is primary unique obj-id
       58     index ie1 obj-type obj-code
       59     index ie2 obj-name
       60   .
       61   procedure create_obj-list :
       62      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       63      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       64      do
       65      on error undo, return error return-value
       66      :
       67         define buffer cli-obj for ub.clients .
       68         define variable p-var as integer no-undo .
       69         define buffer buf_obj-list for obj-list .
       70         find last buf_obj-list  use-index pi no-error .
       71         if available buf_obj-list
       72         then
       73            p-var = buf_obj-list.obj-id + 1.
       74         else
       75            p-var = 1.
       76         find first cli-obj where
       77                   cli-obj.obj-type = p-obj-type
       78               and cli-obj.obj-code = p-obj-code
       79         no-lock no-error.
       80         if available cli-obj
       81         then do:
       82            create buf_obj-list.
       83            assign
       84               buf_obj-list.obj-id   = p-var
       85               buf_obj-list.obj-code = cli-obj.obj-code
       86               buf_obj-list.obj-type = cli-obj.obj-type
       87               buf_obj-list.obj-name = cli-obj.obj-name
       88               buf_obj-list.db-num   = cli-obj.db-num
       89            .
       90         end.
       91      end.
       92   end.
       93   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94     run mainmenu_getcntxt in parparentproc
       95       (output v-cntxt-db-num
       96       ,output v-cntxt-userid
       97       ,output v-cntxt-level
       98       ,output v-cntxt-host-code-obj
       99       ,output v-cntxt-obj-type
      100       ,output v-cntxt-obj-code
      101       ,output v-cntxt-db-num-obj
      102       ,output v-cntxt-is-admin
      103       ) .
