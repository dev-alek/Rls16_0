       40     define variable v-cntxt-db-num        as integer   no-undo .
       41     define variable v-cntxt-userid        as character no-undo .
       42     define variable v-cntxt-level         as character no-undo .
       43     define variable v-cntxt-host-code-obj as integer   no-undo .
       44     define variable v-cntxt-obj-type      as character no-undo .
       45     define variable v-cntxt-obj-code      as integer   no-undo .
       46     define variable v-cntxt-db-num-obj    as integer   no-undo .
