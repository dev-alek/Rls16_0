      784   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      785   FUNCTION Break-n-line RETURNS CHARACTER
      786     ( INPUT p-ost as char,
      787       INPUT p-lengths  as character,
      788       OUTPUT output-num-lines as integer
      789       ) :
      790   define variable ii as integer no-undo.
      791   define variable jj as integer no-undo.
      792   define variable linei as character no-undo extent 10.
      793   define variable line-length as integer no-undo extent 10.
      794   define variable num-line as integer no-undo .
      795   define variable v-line as character no-undo .
      796   do ii = 1 to MIN(num-entries(p-lengths), 10):
      797     assign
      798     line-length[ii] = integer(entry(ii, p-lengths))
      799     num-line = ii
      800     .
      801   end.
      802   do jj = 1 to num-line:
      803     if Length ( p-ost ) <= line-length[jj] then do:
      804       assign
      805       output-num-lines = jj
      806       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      807       .
      808       return v-line.
      809     end.
      810     assign
      811     ii = 1
      812     .
      813     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      814     then do:
      815       assign
      816       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      817       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      818       .
      819     end.
      820     else do:
      821       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      822         assign
      823         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      824         ii = ii + 1
      825         .
      826         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      827         assign
      828         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      829         .
      830       END.
      831       assign
      832       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      833       .
      834     end.
      835     assign
      836     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      837     .
      838     if p-ost = "":U then LEAVE.
      839   end.
      840   assign
      841   output-num-lines = jj.
      842   RETURN v-line.
      843   END FUNCTION.
      844   FUNCTION Center-Field RETURNS CHARACTER
      845     ( INPUT p-str as char,
      846       INPUT p-format as integer,
      847       INPUT p-Length as integer,
      848       INPUT p-fill as character
      849       ) :
      850   define variable v-str as character no-undo .
      851   define variable v-left as integer no-undo .
      852   define variable v-dop as integer no-undo .
      853   assign
      854   p-str = trim(p-str)
      855   .
      856   if p-str = "":U then return fill(p-fill, p-length).
      857   if length(p-str) >= p-format then
      858   p-str = substr(p-str, 1, p-format).
      859   else do:
      860     p-format = length(p-str).
      861   end.
      862   if p-format < p-length then do:
      863     assign
      864     v-left = (p-length - p-format )
      865     v-dop = (if v-left modulo 2 = 1
      866              then 1
      867              else 0)
      868     v-left = (if (v-left modulo 2 = 1)
      869              then (v-left - 1 ) / 2
      870              else v-left / 2)
      871     v-str =  fill(p-fill, v-left) +
      872              string(p-str, "X(":U + string(p-format) + ")":U) +
      873              fill(p-fill, v-left) + fill(p-fill, v-dop)
      874     .
      875     return v-str.
      876   end.
      877   else do:
      878     return string(p-str, "X(":U + string(p-length) + ")":U).
      879   end.
      880   END FUNCTION.
      881   FUNCTION Left-Field RETURNS CHARACTER
      882     ( INPUT p-str as char,
      883       INPUT p-format as integer,
      884       INPUT p-Length as integer,
      885       INPUT p-fill as character
      886       ) :
      887   define variable v-str as character no-undo .
      888   define variable v-left as integer no-undo .
      889   define variable v-dop as integer no-undo .
      890   assign
      891   p-str = trim(p-str)
      892   .
      893   if p-str = "":U then return fill(p-fill, p-length).
      894   if length(p-str) >= p-format then
      895   p-str = substr(p-str, 1, p-format).
      896   else do:
      897     p-format = length(p-str).
      898   end.
      899   if p-format < p-length then do:
      900     assign
      901     v-dop =  p-length - p-format
      902     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      903              fill(p-fill, v-dop)
      904     .
      905     return v-str.
      906   end.
      907   else do:
      908     return string(p-str, "X(":U + string(p-length) + ")":U).
      909   end.
      910   END FUNCTION.
      911   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      912     ( INPUT p-sum as decimal,
      913       INPUT p-rub-length as integer,
      914       INPUT p-kop-length as integer,
      915       INPUT p-fill as character,
      916       INPUT p-razr-delim as character,
      917       INPUT p-rub-str  as character,
      918       INPUT p-kop-str  as character
      919       ) :
      920   define variable v-str as character no-undo .
      921   define variable v-format as character no-undo .
      922   define variable v-dopi as integer no-undo .
      923   define variable v-dopi2 as integer no-undo .
      924   assign
      925   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      926   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      927   .
      928   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      929   assign
      930   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      931   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      932   .
      933   assign
      934   v-str = fill(p-fill, p-rub-length - v-dopi) +
      935           string(truncate(p-sum, 0), v-format) +
      936           p-rub-str +
      937           fill(p-fill, p-kop-length - 2) +
      938           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      939   .
      940   return v-str.
      941   END FUNCTION.
      942   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      943     ( INPUT p-sum as decimal,
      944       INPUT p-sum-length as integer,
      945       INPUT p-curr-code as integer,
      946       INPUT p-fill as character,
      947       INPUT p-razr-delim as character
      948       ) :
      949   define variable v-str as character no-undo .
      950   define variable v-format as character no-undo .
      951   define variable v-dopi as integer no-undo .
      952   define variable v-dopi2 as integer no-undo .
      953   define variable v-curr-name as character no-undo .
      954   define buffer buf_currency for ub.currency.
      955   find first buf_currency no-lock where
      956             buf_currency.curr-code = p-curr-code no-error .
      957   if not avail buf_currency
      958   then v-curr-name = "неизвестная валюта".
      959   else
      960   assign
      961   v-curr-name = buf_currency.curr-name
      962   .
      963   assign
      964   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      965   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      966   .
      967   if v-dopi > p-sum-length then return "?".
      968   assign
      969   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      970   v-dopi = length(trim(string(p-sum, v-format)))
      971   .
      972   assign
      973   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      974           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      975           trim(string(p-sum, v-format))
      976   .
      977   return v-str.
      978   END FUNCTION.
      979   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      980   (input v-sum as decimal
      981   ):
      982   define variable v-str as character no-undo .
      983   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      984   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      985   return v-str.
      986   END FUNCTION.
      987   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      988   (input p-sum as decimal
      989    ,input p-curr-code as integer
      990   ):
      991   define variable v-str as character no-undo .
      992   define variable Copeck as character no-undo.
      993   define variable Rouble as character no-undo.
      994   define variable v-Word as character no-undo.
      995   define variable ii as integer init 18 no-undo.
      996   define variable v-str-rubl as character no-undo .
      997   define variable v-kop as integer no-undo .
      998   define buffer buf_currency for ub.currency.
      999   assign
     1000   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
     1001   find first buf_currency no-lock where
     1002             buf_currency.curr-code = p-curr-code no-error .
     1003   if not available buf_currency then return chr(63).
     1004   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
     1005     CASE substring(v-Word, ii - 3,1):
     1006       WHEN "1" THEN DO:
     1007         if substring(v-Word, ii - 4,1) = "1" then
     1008             Rouble = buf_currency.curr-name-five .
     1009         else
     1010             Rouble = buf_currency.curr-name-one .
     1011       END.
     1012       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
     1013         if substring(v-Word, ii - 4,1) = "1" then
     1014            Rouble = buf_currency.curr-name-five .
     1015            else
     1016            Rouble = buf_currency.curr-name-three .
     1017         END.
     1018       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
     1019          Rouble = buf_currency.curr-name-five .
     1020       END.
     1021     END CASE.
     1022   end.
     1023   CASE substring(v-Word, ii, 1):
     1024     WHEN "1" THEN DO:
     1025       if substring(v-Word, ii - 1, 1) = "1" then
     1026           Copeck = buf_currency.part-name-five .
     1027       else
     1028           Copeck = buf_currency.part-name-one .
     1029     END.
     1030     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
     1031       if substring(v-Word, ii - 1, 1) = "1" then
     1032           Copeck = buf_currency.part-name-five .
     1033       else
     1034           Copeck = buf_currency.part-name-three .
     1035     END.
     1036     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
     1037       Copeck = buf_currency.part-name-five .
     1038     END.
     1039   END CASE.
     1040   run gbl/num-rus.p ( input absolute( p-sum )
     1041                , output v-str-rubl).
     1042   assign
     1043   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
     1044           ) * 100
     1045   .
     1046   v-str = ( if p-Sum < 0 then "- " else "" ) +
     1047               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
     1048               string(v-kop, "99":U) + chr(32) + Copeck .
     1049   return v-str.
     1050   END FUNCTION.
     1051   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
     1052   (input v-sum as decimal,
     1053   input v-razr as integer
     1054   ):
     1055   define variable v-str as character no-undo .
     1056   define variable v-dec-separ as character no-undo .
     1057   case SESSION:NUMERIC-FORMAT:
     1058     when "American":U then do:
     1059       assign
     1060       v-dec-separ = ".":U
     1061       .
     1062     end.
     1063     when "European":U then do:
     1064       assign
     1065       v-dec-separ = ",":U
     1066       .
     1067     end.
     1068   END CASE.
     1069   assign
     1070   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
     1071   .
     1072   return v-str.
     1073   END FUNCTION.
     1074   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     1075     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     1076     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     1077     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     1078   END FUNCTION.
     1079   PROCEDURE get-month-name-gen :
     1080     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     1081     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     1082     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     1083     DO ON ERROR UNDO, RETURN ERROR :
     1084       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     1085     END.
     1086   END PROCEDURE.
     1087   define variable vss-revision    as character no-undo init "$Revision: ":U .
     1088   define variable vss-author      as character no-undo init "$Author: SShalanin $":U .
     1089   define variable vss-date        as character no-undo init "$Date: $":U .
     1090   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
     1091   define variable vss-archive     as character no-undo init "$Archive: utl/coppy_tov.p $":U .
     1092   define variable vss-description as character no-undo init "Утилита".
     1093   procedure vss-get-info :
     1094     define output parameter p-vss-revision    like vss-revision    no-undo .
     1095     define output parameter p-vss-author      like vss-author      no-undo .
     1096     define output parameter p-vss-date        like vss-date        no-undo .
     1097     define output parameter p-vss-workfile    like vss-workfile    no-undo .
     1098     define output parameter p-vss-archive     like vss-archive     no-undo .
     1099     define output parameter p-vss-description like vss-description no-undo .
     1100     assign
     1101       p-vss-revision    = vss-revision
     1102       p-vss-author      = vss-author
     1103       p-vss-date        = vss-date
     1104       p-vss-workfile    = vss-workfile
     1105       p-vss-archive     = vss-archive
     1106       p-vss-description = vss-description
     1107     .
     1108   end procedure.
     1109   procedure vss-get-parameters :
     1110     define output parameter p-vss-parameters as character no-undo .
     1111   end procedure.
     1112   define new global shared variable g#vssrevis-logger as handle    no-undo .
     1113   define variable v-vssrevis-logevent                 as logical   no-undo init false .
     1114   define variable v-vssrevis-logger                   as handle    no-undo .
     1115   procedure vss-logevent :
     1116     define input  parameter p-extra-paramters as character no-undo .
     1117     define variable v-vssrevis-parameters as character no-undo .
     1118     do
     1119     on error undo, return error return-value
     1120     :
     1121       if  valid-handle(v-vssrevis-logger)
     1122       and v-vssrevis-logger :get-signature("logevent") <> ""
     1123       then do:
     1124         run vss-get-parameters in this-procedure
     1125           (output v-vssrevis-parameters
     1126           ).
     1127         run logevent in v-vssrevis-logger
     1128           (input vss-workfile
     1129           ,input vss-revision
     1130           ,input v-vssrevis-parameters
     1131           ,input p-extra-paramters
     1132           ).
     1133       end.
     1134     end.
     1135   end procedure.
     1136   assign
     1137     v-vssrevis-logger = g#vssrevis-logger
     1138   .
     1139   if  valid-handle(v-vssrevis-logger)
     1140   and v-vssrevis-logger :get-signature("logevent") <> ""
     1141   then do:
     1142     assign
     1143       v-vssrevis-logevent = true
     1144     .
     1145     run vss-logevent in this-procedure (input vss-description) .
     1146   end.
     1147   define variable   k-attr-15x80-value as char.
     1148           define variable  k-attr-6x50-value as char.
     1149        define variable   k-attr-8x50-value as char.
     1150      define variable   k-sost-attr-value as char.
     1151   DEFINE BUTTON Btn_cancel AUTO-GO
     1152        LABEL "Отмена"
     1153        SIZE 15 BY 1.13
     1154        BGCOLOR 8 .
     1155   DEFINE BUTTON Btn_quite AUTO-END-KEY
     1156        LABEL "Ввод"
     1157        SIZE 15 BY 1.13
     1158        BGCOLOR 8 .
     1159   DEFINE BUTTON BTN_tov
     1160        LABEL "Список товаров"
     1161        SIZE 15 BY 1.13.
     1162   DEFINE VARIABLE cb-cop AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1163        VIEW-AS COMBO-BOX INNER-LINES 5
     1164        LIST-ITEM-PAIRS "Состав (из доп. инфо)",         1,
     1165                        "Текст поля СОСТАВ 8x50 (CAS_LP-16x)",         2,
     1166                        "Текст поля СОСТАВ 15x80 (DIGI-SM)",         3,
     1167                        "Текст поля СОСТАВ 6x50 (CAS_CL5000 CAS_CL5000J)",         4
     1168        DROP-DOWN-LIST
     1169        SIZE 35 BY 1
     1170        FONT 0 NO-UNDO.
     1171   DEFINE VARIABLE cb-naz AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1172        VIEW-AS COMBO-BOX INNER-LINES 5
     1173        LIST-ITEM-PAIRS "Состав (из доп. инфо)",         1,
     1174                        "Текст поля СОСТАВ 8x50 (CAS_LP-16x",         2,
     1175                        "Текст поля СОСТАВ 15x80 (DIGI-SM)",         3,
     1176                        "Текст поля СОСТАВ 6x50 (CAS_CL5000 CAS_CL5000J)",        4
     1177        DROP-DOWN-LIST
     1178        SIZE 35 BY 1 NO-UNDO.
     1179   DEFINE VARIABLE tgl-ignr AS LOGICAL INITIAL no
     1180        LABEL "Игнорировать пустые записи в источнике"
     1181        VIEW-AS TOGGLE-BOX
     1182        SIZE 47 BY .83 NO-UNDO.
     1183   DEFINE FRAME Dialog-Frame
     1184        Btn_quite AT ROW 3.75 COL 5.5
     1185        BTN_tov AT ROW 3.75 COL 30.5 WIDGET-ID 14
     1186        Btn_cancel AT ROW 3.75 COL 55.5
     1187        cb-cop AT ROW 8 COL 2 NO-LABEL WIDGET-ID 6
     1188        cb-naz AT ROW 8 COL 36.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1189        tgl-ignr AT ROW 10 COL 8.5 WIDGET-ID 16
     1190        "Источник копирования" VIEW-AS TEXT
     1191             SIZE 21 BY 1.42 AT ROW 6.5 COL 3 WIDGET-ID 10
     1192        "Назначение" VIEW-AS TEXT
     1193             SIZE 21 BY 1.42 AT ROW 6.5 COL 39 WIDGET-ID 12
     1194             FONT 0
     1195        SPACE(21.24) SKIP(5.49)
     1196       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1197            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1198            TITLE "Копирование состава товара"
     1199            DEFAULT-BUTTON Btn_cancel CANCEL-BUTTON Btn_quite WIDGET-ID 100.
     1200   ASSIGN
     1201          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1202          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1203   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1204   DO:
     1205     APPLY "END-ERROR":U TO SELF.
     1206   END.
     1207   ON choose OF Btn_quite IN FRAME Dialog-Frame
     1208   do:
     1209   assign
     1210   tgl-ignr.
     1211     run gds-cb-naz.
     1212   run gds-cb-attr.
     1213   end.
     1214   ON CHOOSE OF BTN_tov IN FRAME Dialog-Frame
     1215   DO:
     1216     run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
     1217   END.
     1218   ON value-changed OF cb-cop IN FRAME Dialog-Frame
     1219   do:
     1220   assign cb-cop.
     1221       end.
     1222   ON value-changed OF cb-naz IN FRAME Dialog-Frame
     1223   do:
     1224       assign cb-naz.
     1225       end.
     1226   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1227   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1228   MAIN-BLOCK:
     1229   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1230      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1231     RUN enable_UI.
     1232       WAIT-FOR GO OF FRAME Dialog-Frame.
     1233   END.
     1234   RUN disable_UI.
     1235   PROCEDURE disable_UI :
     1236     HIDE FRAME Dialog-Frame.
     1237   END PROCEDURE.
     1238   PROCEDURE enable_UI :
     1239     DISPLAY cb-cop cb-naz tgl-ignr
     1240         WITH FRAME Dialog-Frame.
     1241     ENABLE Btn_quite BTN_tov Btn_cancel cb-cop cb-naz tgl-ignr
     1242         WITH FRAME Dialog-Frame.
     1243     VIEW FRAME Dialog-Frame.
     1244   END PROCEDURE.
     1245   PROCEDURE gds-cb-attr :
     1246        define variable v-value as char.
     1247            define variable p-gds-code as integer.
     1248   define variable v-attr-code as character .
     1249   define variable v-attr-value as char.
     1250   define buffer buf_goods for goods.
     1251    define variable  attr-15x80-value as char.
     1252           define variable attr-6x50-value as char.
     1253        define variable attr-8x50-value as char.
     1254        define variable sost-attr-value as char.
     1255    for each gds-list:
     1256        p-gds-code = gds-list.gds-code.
     1257     if cb-cop = 2 then do:
     1258     run gds-attr-value in this-procedure (
     1259             INPUT p-gds-code,
     1260             INPUT '8x50':U,
     1261             OUTPUT v-attr-value,
     1262             OUTPUT v-value
     1263             ).
     1264    attr-8x50-value = replace(v-attr-value,  chr(4), " " ).
     1265               end.
     1266        if cb-cop = 3 then do:
     1267     run gds-attr-value in this-procedure (
     1268             INPUT p-gds-code,
     1269             INPUT '15x80':U,
     1270             OUTPUT v-attr-value,
     1271             OUTPUT v-value
     1272             ).
     1273             attr-15x80-value = replace(v-attr-value,   chr(4), " "  ).
     1274             end.
     1275             if cb-cop = 4 then do:
     1276    run gds-attr-value in this-procedure (
     1277             INPUT p-gds-code,
     1278             INPUT '6x50':U,
     1279             OUTPUT v-attr-value,
     1280             OUTPUT v-value
     1281             ).
     1282             attr-6x50-value = replace(v-attr-value,   chr(4), " ").
     1283   end.
     1284   if cb-cop = 1 then do:
     1285       find first buf_goods where buf_goods.gds-code = p-gds-code.
     1286         sost-attr-value =   replace(buf_goods.struct, chr(4), " ").
     1287      end.
     1288   if  tgl-ignr = yes and cb-cop = 4 then do:
     1289       if attr-6x50-value = " " then do:
     1290           ''.
     1291           end.
     1292       else do:
     1293   run tgl-coppy  ( input p-gds-code,
     1294                                       input attr-15x80-value,
     1295                                       input attr-6x50-value ,
     1296                                    input  attr-8x50-value ,
     1297                                     input  sost-attr-value).
     1298                                     end.
     1299                                     end.
     1300           if  tgl-ignr = yes and cb-cop = 2 then do:
     1301       if attr-8x50-value = " " then do:
     1302           ''.
     1303           end.
     1304       else do:
     1305   run tgl-coppy  ( input p-gds-code,
     1306                                       input attr-15x80-value,
     1307                                       input attr-6x50-value ,
     1308                                    input  attr-8x50-value ,
     1309                                     input  sost-attr-value).
     1310               end.
     1311           end.
     1312           if  tgl-ignr = yes and cb-cop = 3 then
     1313           do:
     1314               if attr-15x80-value = " " then
     1315               do:
     1316                   ''.
     1317               end.
     1318               else
     1319               do:
     1320                   run tgl-coppy  ( input p-gds-code,
     1321                       input attr-15x80-value,
     1322                       input attr-6x50-value ,
     1323                       input  attr-8x50-value ,
     1324                       input  sost-attr-value).
     1325               end.
     1326           end.
     1327           if tgl-ignr = yes and cb-cop = 1 then
     1328           do:
     1329               if sost-attr-value = " " then
     1330               do:
     1331                   ''.
     1332               end.
     1333               else
     1334               do:
     1335                   run tgl-coppy  ( input p-gds-code,
     1336                       input attr-15x80-value,
     1337                       input attr-6x50-value ,
     1338                       input  attr-8x50-value ,
     1339                       input  sost-attr-value).
     1340               end.
     1341           end.
     1342           if tgl-ignr = no then
     1343           do:
     1344               run tgl-coppy  ( input p-gds-code,
     1345                   input attr-15x80-value,
     1346                   input attr-6x50-value ,
     1347                   input  attr-8x50-value ,
     1348                   input  sost-attr-value).
     1349           end.
     1350       end.
     1351   END PROCEDURE.
     1352   procedure gds-cb-naz:
     1353       define variable p-value      as char.
     1354       define variable p-gds-code   as integer.
     1355       define variable p-attr-value as char.
     1356       define buffer buf_goods for goods.
     1357       define variable v-attr-15x80-value as char.
     1358       define variable v-attr-6x50-value  as char.
     1359       define variable v-attr-8x50-value  as char.
     1360       define variable v-sost-attr-value  as char.
     1361       for each gds-list:
     1362           p-gds-code = gds-list.gds-code.
     1363           if cb-naz = 2 then
     1364           do:
     1365               run gds-attr-value in this-procedure (
     1366                   INPUT p-gds-code,
     1367                   INPUT '8x50':U,
     1368                   OUTPUT p-attr-value,
     1369                   OUTPUT p-value
     1370                   ).
     1371           end.
     1372           if cb-naz = 3 then
     1373           do:
     1374               run gds-attr-value in this-procedure (
     1375                   INPUT p-gds-code,
     1376                   INPUT '15x80':U,
     1377                   OUTPUT p-attr-value,
     1378                   OUTPUT p-value
     1379                   ).
     1380           end.
     1381           if cb-naz = 4 then
     1382           do:
     1383               run gds-attr-value in this-procedure (
     1384                   INPUT p-gds-code,
     1385                   INPUT '6x50':U,
     1386                   OUTPUT p-attr-value,
     1387                   OUTPUT p-value
     1388                   ).
     1389           end.
     1390           if cb-naz = 1 then
     1391           do:
     1392               find first buf_goods where buf_goods.gds-code = p-gds-code.
     1393               v-sost-attr-value = buf_goods.struct.
     1394           end.
     1395       end.
     1396   end procedure.
     1397   procedure tgl-coppy:
     1398       DEFINE variable output-num-lines   AS integer NO-UNDO.
     1399       define variable p-attr-15x80-value as char.
     1400       define variable p-attr-6x50-value  as char.
     1401       define variable p-attr-8x50-value  as char.
