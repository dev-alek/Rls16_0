        1   block-level on error undo, throw.
        2   define variable FullFileName  as character no-undo.
        3   define variable v-param       as character no-undo .
        4   define variable ind           as integer   no-undo .
        5   define variable v-num-entries as integer   no-undo .
        6   define variable v-msg         as character no-undo .
        7   define stream   s-imp.
        8   if session:parameter <> "":U
        9     and session:parameter <> ?
       10   then do:
       11     assign
       12       v-num-entries = num-entries( session:parameter, ",":U )
       13     .
       14     do ind = 1 to v-num-entries :
       15       assign
       16         v-param = entry( ind, session:parameter, ",":U )
       17       .
       18         if v-param begins 'FullFileName' then do:
       19           assign
       20             FullFileName = entry( 2, v-param, "?":U )
       21           .
       22         end.
       23     end.
       24   end.
       25   if FullFileName = ? or FullFileName = ""
       26     then quit.
       27   input stream s-imp from value( FullFileName ) .
       28   import stream s-imp unformatted v-msg no-error .
       29   message v-msg view-as alert-box information title "Информация.".
       30   quit.
