        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "обновление реквизитов клиентов в незакрытых платежах из договора".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   procedure cur-time :
      114      define output parameter p-today as date      no-undo .
      115      define output parameter p-time  as integer   no-undo .
      116     do
      117     on error undo, return error
      118     :
      119       define variable v-date1 as date      no-undo .
      120       define variable v-date2 as date      no-undo .
      121       define variable v-time  as integer   no-undo .
      122       assign
      123         v-date1 = today
      124         v-time  = time
      125         v-date2 = today
      126       .
      127       if v-date1 <> v-date2
      128       then do:
      129         assign
      130           v-date1 = today
      131           v-time  = v-time
      132         .
      133       end.
      134       assign
      135         p-today = v-date1
      136         p-time  = v-time
      137       .
      138     end.
      139   end.
      140   function cur-time-date returns character
      141   :
      142     return string(today, '99/99/9999':U) .
      143   end.
      144   function cur-time-mjd returns decimal
      145   :
      146     define variable v-date as date      no-undo .
      147     define variable v-time as integer   no-undo .
      148     run cur-time in this-procedure
      149       (output v-date
      150       ,output v-time
      151       ) .
      152     return integer(v-date) - 2400002 + (v-time / 86400) .
      153   end.
      154   function cur-time-get-ending-index returns integer
      155   (input p-number as integer
      156   )
      157   :
      158     if p-number < 0
      159     or p-number = ?
      160     then do:
      161       return 1 .
      162     end.
      163     define variable v-rest as integer   no-undo .
      164     assign
      165       p-number = p-number modulo 100
      166     .
      167     if p-number < 20
      168     then do:
      169       assign
      170         v-rest = p-number
      171       .
      172     end.
      173     else do:
      174       assign
      175         v-rest = p-number modulo 10
      176       .
      177     end.
      178     case v-rest :
      179       when 1
      180       then do:
      181         return 2 .
      182       end.
      183       when 2 or
      184       when 3 or
      185       when 4
      186       then do:
      187         return 3 .
      188       end.
      189       otherwise do:
      190         return 1 .
      191       end.
      192     end case .
      193   end.
      194   procedure cur-time-mjd-to-date :
      195      define input  parameter i-mjd-diff as decimal no-undo.
      196      define output parameter o-Date     as date    no-undo.
      197      define output parameter o-Time     as integer no-undo.
      198      define variable v-day-number as integer   no-undo .
      199      if    i-mjd-diff < 0
      200         or i-mjd-diff = ?
      201      then do:
      202         return "?" .
      203      end.
      204      assign
      205         v-day-number = truncate(i-mjd-diff,0).
      206         o-Date = date(v-day-number + 2400002).
      207         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209   end.
      210   function cur-time-mjd-to-string returns character
      211   (input p-mjd-diff as decimal
      212   )
      213   :
      214     define variable v-day-number as integer   no-undo .
      215     define variable v-seconds    as integer   no-undo .
      216     define variable v-hour       as integer   no-undo .
      217     define variable v-min        as integer   no-undo .
      218     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      219     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      220     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      221     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      222     if p-mjd-diff < 0
      223     or p-mjd-diff = ?
      224     then do:
      225       return "?" .
      226     end.
      227     assign
      228       v-day-number = integer(truncate(p-mjd-diff,0))
      229       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231     if v-seconds > 86400
      232     then do:
      233       assign
      234         v-seconds = 86400 - 1
      235       .
      236     end.
      237     if v-seconds < 0
      238     then do:
      239       assign
      240         v-seconds = 0
      241       .
      242     end.
      243     assign
      244       v-hour = truncate(v-seconds / 3600, 0)
      245     .
      246     assign
      247       v-seconds = v-seconds modulo 3600
      248     .
      249     assign
      250       v-min = truncate(v-seconds / 60, 0)
      251     .
      252     assign
      253       v-seconds = v-seconds modulo 60
      254     .
      255     return
      256         (if v-day-number <> 0
      257           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      258           else ""
      259         )
      260       + (if v-day-number <> 0 or v-hour <> 0
      261           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      262           else ""
      263         )
      264       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      265           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      266           else ""
      267         )
      268       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      269       .
      270   end.
      271   function cur-time-string returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-string-sec returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      290   end.
      291   function cur-time-custom  returns character
      292   (input p-prefix as character
      293   ,input p-date-format as character
      294   ,input p-delimiter as character
      295   ,input p-time-format as character
      296   ,input p-suffix as character
      297   )
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return
      306       p-prefix
      307       + string(v-date, p-date-format)
      308       + p-delimiter
      309       + string(v-time, p-time-format)
      310       + p-suffix
      311       .
      312   end.
      313   function cur-time-print  returns character
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      322   end.
      323   function cur-time-datetime returns datetime
      324   :
      325     define variable v-char as character no-undo .
      326     define variable v-datetime as datetime no-undo .
      327     v-char = cur-time-string().
      328     v-datetime = datetime(v-char).
      329     return  v-datetime.
      330   end.
      331   function cur-time-string-msec returns character
      332   :
      333     define variable v-date as datetime  no-undo .
      334     v-date = now.
      335     return string(v-date) .
      336   end.
      337   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   define input parameter ParParentProc as handle           no-undo.
      339   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340     define variable v-cntxt-db-num        as integer   no-undo .
      341     define variable v-cntxt-userid        as character no-undo .
      342     define variable v-cntxt-level         as character no-undo .
      343     define variable v-cntxt-host-code-obj as integer   no-undo .
      344     define variable v-cntxt-obj-type      as character no-undo .
      345     define variable v-cntxt-obj-code      as integer   no-undo .
      346     define variable v-cntxt-db-num-obj    as integer   no-undo .
      347     define variable v-cntxt-is-admin      as logical   no-undo .
      348   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349     run mainmenu_getcntxt in parparentproc
      350       (output v-cntxt-db-num
      351       ,output v-cntxt-userid
      352       ,output v-cntxt-level
      353       ,output v-cntxt-host-code-obj
      354       ,output v-cntxt-obj-type
      355       ,output v-cntxt-obj-code
      356       ,output v-cntxt-db-num-obj
      357       ,output v-cntxt-is-admin
      358       ) .
      359   define variable ii as integer   no-undo .
      360   define variable is-edit as logical   no-undo .
      361   define variable v-name as character no-undo .
      362   define variable v-inn  as character no-undo .
      363   define variable v-kpp  as character no-undo .
      364   define buffer buf_contract for contract .
      365   define buffer buf_fin-doc  for fin-doc .
      366   define buffer buf_fin-ob  for fin-ob .
      367   DEFINE TEMP-TABLE tt-fin-ob       NO-UNDO LIKE fin-ob .
      368   DEFINE TEMP-TABLE tt-fin-doc      NO-UNDO LIKE fin-doc .
      369   DEFINE TEMP-TABLE tt-fin-doc-attr NO-UNDO LIKE fin-doc-attr .
      370   DEFINE TEMP-TABLE tt-fin-doc-tax  NO-UNDO LIKE fin-doc-tax .
      371   define temp-table tt0-payment     no-undo like ub.payment.
      372   define variable v-logfile as character no-undo .
      373   assign v-logfile = 'updfind.log' .
      374     os-delete v-logfile .
      375   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376       def var log-file-name as char no-undo.
      377       assign
      378           log-file-name = v-logfile
      379       .
      380       if log-file-name <> "":U
      381       then do:
      382           if search( v-logfile ) = ?
      383           then do:
      384               output to value( v-logfile ).
      385               output close.
      386           end.
      387       end.
      388       DEF STREAM stm-log.
      389       PROCEDURE writelog:
      390       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      391       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      392       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      393       if p-file-name <> ""
      394       then do:
      395       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      396           PUT STREAM stm-log UNFORMATTED chr(10).
      397           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      398                                           OR p-log-string = "&Line") THEN "" ELSE
      399                                           cur-time-string-sec() + " ").
      400           PUT STREAM stm-log UNFORMATTED
      401                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      402                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      403                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      404       OUTPUT STREAM stm-log CLOSE.
      405       end.
      406       END PROCEDURE.
      407   DEFINE BUTTON b-exit AUTO-GO
      408        LABEL "&Отмена":L
      409        SIZE 10 BY 1.
      410   DEFINE BUTTON B-Help
      411        LABEL "Помо&щь"
      412        SIZE 10 BY 1
      413        BGCOLOR 8 .
      414   DEFINE BUTTON b-OK AUTO-GO
      415        LABEL "&Ввод ":L
      416        SIZE 10 BY 1.
      417   DEFINE RECTANGLE RECT-7
      418        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      419        SIZE 32.5 BY 5.
      420   DEFINE VARIABLE TOG-inn AS LOGICAL INITIAL no
      421        LABEL "ИНН"
      422        VIEW-AS TOGGLE-BOX
      423        SIZE 26 BY .83 NO-UNDO.
      424   DEFINE VARIABLE TOG-kpp AS LOGICAL INITIAL no
      425        LABEL "КПП"
      426        VIEW-AS TOGGLE-BOX
      427        SIZE 26 BY .83 NO-UNDO.
      428   DEFINE VARIABLE TOG-name AS LOGICAL INITIAL no
      429        LABEL "Наименование"
      430        VIEW-AS TOGGLE-BOX
      431        SIZE 26 BY .83 NO-UNDO.
      432   DEFINE FRAME Dialog-Frame
      433        b-OK AT ROW 1 COL 1
      434        b-exit AT ROW 1 COL 11
      435        B-Help AT ROW 1 COL 24.5
      436        TOG-name AT ROW 3.63 COL 4.63
      437        TOG-inn AT ROW 4.75 COL 4.63
      438        TOG-kpp AT ROW 5.83 COL 4.75
      439        "Обновить:" VIEW-AS TEXT
      440             SIZE 10 BY 1 AT ROW 2.5 COL 3
      441             FGCOLOR 4
      442        RECT-7 AT ROW 2.25 COL 2
      443        SPACE(0.74) SKIP(0.16)
      444       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      445            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      446            TITLE "Обновление реквизитов клиентов в незакрытых платежах из договора".
      447   ASSIGN
      448          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      449          FRAME Dialog-Frame:HIDDEN           = TRUE.
      450   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      451   DO:
      452     APPLY "END-ERROR":U TO SELF.
      453   END.
      454   ON CHOOSE OF b-OK IN FRAME Dialog-Frame
      455   DO:
      456     assign
      457       TOG-name
      458       TOG-inn
      459       TOG-kpp
      460     .
      461     run proc-OK .
      462   END.
      463   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      464   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      465   MAIN-BLOCK:
      466   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      467      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      468   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      469   on help of frame Dialog-Frame
      470   do:
      471     run gbl/app_help.p
      472       (input this-procedure :file-name
      473       ,input ''
      474       ,input ?
      475       ) no-error.
      476     if error-status :error then do:
      477       message
      478         "Ошибка при вызове помощи"
      479         error-status :get-message(1)
      480         view-as alert-box .
      481     end.
      482   end.
      483   run minbtn-set in this-procedure .
      484   on choose of b-help in frame Dialog-Frame
      485   do:
      486     apply "help":u to frame Dialog-Frame .
      487   end.
      488   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      489   procedure minbtn-set :
      490       do
      491           on error undo, return error return-value
      492           :
      493           define variable ii              as integer       no-undo .
      494           define variable fh              as widget-handle no-undo .
      495           define variable hh              as widget-handle no-undo .
      496           define variable v-h             as handle        extent 4 no-undo .
      497           define variable v-name-button   as character     no-undo .
      498           define variable v-help-old-x    as decimal       no-undo .
      499           define variable v-help-old-y    as decimal       no-undo .
      500           define variable v-help-old-size as decimal       no-undo .
      501           define variable v-frame-width   as decimal       no-undo .
      502           define variable jj              as integer       no-undo .
      503           do
      504               on error undo, return error
      505               :
      506               assign
      507                   v-frame-width = frame Dialog-Frame:width - 0.3
      508                   fh            = frame Dialog-Frame:first-child
      509                   hh            = fh:first-child
      510                   ii            = 1
      511                   .
      512               do while valid-handle(hh):
      513                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      514                   do:
      515                       case lc(hh:name) :
      516                           when "b-help" then
      517                               do:
      518                                   hh:load-image-up("cmp/b-help.bmp":u) .
      519                                   hh:load-image-down("cmp/b-help.bmp":u) .
      520                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      521                                   hh:TOOLTIP = "Помощь" .
      522                                   v-help-old-x = hh:column .
      523                                   v-help-old-y = hh:row    .
      524                                   v-help-old-size = hh:width .
      525                                   hh:width-chars = 2.5 .
      526                               end.
      527                           when "b-print" then
      528                               do:
      529                                   hh:load-image("cmp/b-print.bmp":u) .
      530                                   hh:TOOLTIP = "Печать" .
      531                                   v-h[ii] = hh:handle .
      532                                   ii = ii + 1 .
      533                                   hh:width-chars = 3 .
      534                               end.
      535                           when "b-history" or
      536                           when "b-hist" then
      537                               do:
      538                                   hh:load-image("cmp/b-hist.bmp":u) .
      539                                   hh:TOOLTIP = "История" .
      540                                   v-h[ii] = hh:handle .
      541                                   ii = ii + 1 .
      542                                   hh:width-chars = 3 .
      543                               end.
      544                           when "b-sch" then
      545                               do:
      546                                   hh:load-image("cmp/b-sch.bmp":u) .
      547                                   hh:TOOLTIP = "Установка Фильтра" .
      548                                   v-h[ii] = hh:handle .
      549                                   ii = ii + 1 .
      550                                   hh:width-chars = 3 .
      551                               end.
      552                           when "b-hist-user" then
      553                               do:
      554                                   hh:load-image("cmp/b-hist.bmp":u) .
      555                                   hh:TOOLTIP = "История пользователя" .
      556                                   ii = ii + 1 .
      557                               end.
      558                       end case.
      559                   end.
      560                   hh = hh:next-sibling.
      561               end.
      562               b-help:column = v-frame-width - b-help:width-chars.
      563               jj = 0.
      564               repeat ii = 4 to 1 by -1 :
      565                   if valid-handle (v-h[ii] ) then
      566                   do:
      567                       jj  = jj + 1 .
      568                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      569                       v-h[ii]:row    = v-help-old-y .
      570                   end.
      571               end.
      572           end.
      573       end.
      574   end procedure.
      575     define variable num-db as integer   no-undo .
      576   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      578     (output num-db
      579     )  .
      580     if num-db <> 0 then do:
      581       message  "Данная утилита предназначена для работы только в главной БД"  view-as alert-box.
      582       return no-apply .
      583     end.
      584   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   do:
      586     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      587       (input  v-cntxt-db-num
      588       ,input  v-cntxt-userid
      589       ,input  0
      590       ,input  'actn_updfind_update':U
      591       ,input  'firm':U
      592       ,input  v-cntxt-host-code-obj
      593       ,input  '':U
      594       ,input  0
      595       ,input  0
      596       ,input  0
      597       ,input  0
      598       ,input  true
      599       ,output is-edit
      600       )  .
      601   end.
      602     if is-edit = false then return no-apply .
      603     RUN enable_UI.
      604     WAIT-FOR GO OF FRAME Dialog-Frame.
      605   END.
      606   RUN disable_UI.
      607   PROCEDURE disable_UI :
      608     HIDE FRAME Dialog-Frame.
      609   END PROCEDURE.
      610   PROCEDURE enable_UI :
      611     DISPLAY TOG-name TOG-inn TOG-kpp
      612         WITH FRAME Dialog-Frame.
      613     ENABLE b-OK RECT-7 b-exit B-Help TOG-name TOG-inn TOG-kpp
      614         WITH FRAME Dialog-Frame.
      615     VIEW FRAME Dialog-Frame.
      616   END PROCEDURE.
      617   PROCEDURE proc-OK :
      618     do on error undo, return error return-value :
      619       define variable Counter1 as integer   no-undo .
      620   define variable v-account as integer init 0 no-undo .
      621   define variable v-account-lavel as character no-undo .
      622   define variable v-button-stop as logical no-undo .
      623   define variable v-kol-spice as integer no-undo .
      624   define variable v-kol-spice2 as integer no-undo .
      625   define variable v-kol-spice3 as integer no-undo .
      626   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      627   DEFINE BUTTON StopBtn AUTO-END-KEY
      628        LABEL "Стоп"
      629        SIZE 10 BY 1.
      630   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      631        LABEL "Обработано записей"
      632         VIEW-AS TEXT
      633        SIZE 14 BY .67 NO-UNDO.
      634   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      635         VIEW-AS TEXT
      636        SIZE 53.25 BY .67
      637        FGCOLOR 1  NO-UNDO.
      638   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      639         VIEW-AS TEXT
      640        SIZE 53.25 BY .67
      641        FGCOLOR 1  NO-UNDO.
      642   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      643         VIEW-AS TEXT
      644        SIZE 53.25 BY .67
      645        FGCOLOR 1  NO-UNDO.
      646   DEFINE RECTANGLE RECT-1
      647        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      648        SIZE 55.13 BY 4.46.
      649   DEFINE FRAME InfoFrame
      650        StopBtn AT ROW 4.25 COL 21.75
      651        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      652        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      653        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      654        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      655        RECT-1 AT ROW 1 COL 1
      656       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      657            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      658            TITLE "Процесс"
      659            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      660   define variable mFrameView      as logical   no-undo init yes.
      661     define variable mFramHandle as handle no-undo.
      662     mFramHandle = frame InfoFrame:handle.
      663     if  log-manager:logfile-name ne ?
      664     then DO:
      665         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      666         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      667         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      668     end.
      669     mFrameView = not session:batch-mode and mFramHandle:visible.
      670     if mFrameView
      671     then do:
      672       ASSIGN
      673          FRAME InfoFrame:HIDDEN                           = TRUE
      674          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      675     end.
      676   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      677   DO:
      678     IF not StopProcessing THEN
      679       Message "Вы действительно хотите прервать" SKIP
      680               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      681                 UPDATE StopProcessing.
      682     IF StopProcessing THEN do:
      683        if mFrameView
      684        then do:
      685           HIDE FRAME InfoFrame.
      686        end.
      687     End.
      688   END.
      689   assign v-account = ( if integer( 5 ) = 0 then 100 else integer( 5 ) ).
      690     if  log-manager:logfile-name ne ?
      691     then DO:
      692         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      693     end.
      694     if not session:batch-mode then
      695     do:
      696       VIEW FRAME InfoFrame.
      697       mFrameView = true.
      698     end.
      699      v-button-stop = false .
      700         if mFrameView
      701         then do:
      702         if v-button-stop then view STOPBTN in frame InfoFrame.
      703                          else Hide STOPBTN in frame InfoFrame.
      704         end.
      705       for each buf_fin-doc no-lock
      706         where  buf_fin-doc.host-code    = v-cntxt-host-code-obj
      707           and  buf_fin-doc.status_      = 'новый':U
      708         :
      709         find first buf_contract no-lock
      710           where buf_contract.host-code     = buf_fin-doc.host-code
      711             and buf_contract.contract-code = buf_fin-doc.contract-code
      712         no-error .
      713         if not available buf_contract then next.
      714   IF ( Counter1 modulo v-account = 0 )  then DO:
      715             if  log-manager:logfile-name ne ?
      716             then DO:
      717                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      718             end.
      719              if mFrameView
      720              then do:
      721               DISPLAY
      722                 Counter1 @ RecordsDone
      723                 WITH FRAME InfoFrame.
      724              end.
      725   End.
      726      if v-button-stop then  DO:
      727            if mFrameView
      728            then
      729               PROCESS EVENTS.
      730            IF StopProcessing THEN DO:
      731            RETURN error.
      732            End.
      733      end.
      734         run writelog ( v-logfile, 0, string(Counter1,">>>9") + " Проверка фин. документа вн. номер " + string(buf_fin-doc.fin-doc-code) + " по договору вн.номер "  + string(buf_fin-doc.contract-code)) .
      735         assign
      736           Counter1 = Counter1 + 1
      737           is-edit  = no
      738         .
      739         if available tt-fin-doc then delete tt-fin-doc .
      740         for each tt-fin-doc-tax :   delete tt-fin-doc-tax .  end.
      741         for each tt-fin-doc-attr :  delete tt-fin-doc-attr . end.
      742         buffer-copy buf_fin-doc to tt-fin-doc .
      743         if tt-fin-doc.payer-code =  buf_contract.host-code and tt-fin-doc.payer-type = 'орг':U then do:
      744           if TOG-name then do:
      745             if tt-fin-doc.payer-name <> buf_contract.own-name then do:
      746               run writelog ( v-logfile, 0, "    Изменение наименования плательщика. " + tt-fin-doc.payer-name + " -> " + buf_contract.own-name ) .
      747               assign is-edit = yes  tt-fin-doc.payer-name = buf_contract.own-name .
      748             end.
      749           end.
      750           if TOG-inn then do:
      751             if tt-fin-doc.payer-inn <> buf_contract.own-inn then do:
      752               run writelog ( v-logfile, 0, "    Изменение ИНН плательщика. " + tt-fin-doc.payer-inn + " -> " + buf_contract.own-inn ) .
      753               assign is-edit = yes  tt-fin-doc.payer-inn = buf_contract.own-inn .
      754             end.
      755           end.
      756           if TOG-kpp then do:
      757             if tt-fin-doc.payer-kpp <> buf_contract.own-kpp then do:
      758               run writelog ( v-logfile, 0, "    Изменение КПП плательщика. " + tt-fin-doc.payer-kpp + " -> " + buf_contract.own-kpp ) .
      759               assign is-edit = yes  tt-fin-doc.payer-kpp = buf_contract.own-kpp .
      760             end.
      761           end.
      762           if tt-fin-doc.receiver-code =  buf_contract.cli-code and tt-fin-doc.receiver-type =  buf_contract.cli-type then do:
      763             assign  v-name = buf_contract.cli-name    v-inn  = buf_contract.cli-inn   v-kpp  = buf_contract.cli-kpp .
      764           end.
      765           else do:
      766             if tt-fin-doc.receiver-code =  buf_contract.posr-code and tt-fin-doc.receiver-type =  buf_contract.posr-type then do:
      767               assign  v-name = buf_contract.posr-name    v-inn  = buf_contract.posr-inn   v-kpp  = buf_contract.posr-kpp .
      768             end.
      769             else do:
      770               if tt-fin-doc.receiver-code =  buf_contract.agnt-code and tt-fin-doc.receiver-type =  buf_contract.agnt-type then do:
      771                 assign  v-name = buf_contract.agnt-name    v-inn  = buf_contract.agnt-inn   v-kpp  = buf_contract.agnt-kpp .
      772               end.
      773             end.
      774           end.
      775           if TOG-name then do:
      776             if tt-fin-doc.receiver-name <> v-name then do:
      777               run writelog ( v-logfile, 0, "    Изменение наименования получателя. " + tt-fin-doc.receiver-name + " -> " + v-name ) .
      778               assign is-edit = yes   tt-fin-doc.receiver-name = v-name  .
      779             end.
      780           end.
      781           if TOG-inn then do:
      782             if tt-fin-doc.receiver-inn <> v-inn then do:
      783               run writelog ( v-logfile, 0, "    Изменение ИНН получателя. " + tt-fin-doc.receiver-inn + " -> " + v-inn ) .
      784               assign is-edit = yes   tt-fin-doc.receiver-inn = v-inn .
      785             end.
      786           end.
      787           if TOG-kpp then do:
      788             if tt-fin-doc.receiver-kpp <> v-kpp then do:
      789               run writelog ( v-logfile, 0, "    Изменение КПП получателя. " + tt-fin-doc.receiver-kpp + " -> " + v-kpp ) .
      790               assign is-edit = yes   tt-fin-doc.receiver-kpp = v-kpp .
      791             end.
      792           end.
      793         end.
      794         else do:
      795           if TOG-name then do:
      796             if tt-fin-doc.receiver-name <> buf_contract.own-name then do:
      797               run writelog ( v-logfile, 0, "    Изменение наименования получателя . " + tt-fin-doc.receiver-name + " -> " + buf_contract.own-name ) .
      798               assign is-edit = yes  tt-fin-doc.receiver-name = buf_contract.own-name .
      799             end.
      800           end.
      801           if TOG-inn then do:
      802             if tt-fin-doc.receiver-inn <> buf_contract.own-inn then do:
      803               run writelog ( v-logfile, 0, "    Изменение ИНН получателя . " + tt-fin-doc.receiver-inn + " -> " + buf_contract.own-inn ) .
      804               assign is-edit = yes  tt-fin-doc.receiver-inn = buf_contract.own-inn .
      805             end.
      806           end.
      807           if TOG-kpp then do:
      808             if tt-fin-doc.receiver-kpp <> buf_contract.own-kpp then do:
      809               run writelog ( v-logfile, 0, "    Изменение КПП получателя . " + tt-fin-doc.receiver-kpp + " -> " + buf_contract.own-kpp ) .
      810               assign is-edit = yes  tt-fin-doc.receiver-kpp = buf_contract.own-kpp .
      811             end.
      812           end.
      813           if tt-fin-doc.payer-code =  buf_contract.cli-code and tt-fin-doc.payer-type =  buf_contract.cli-type then do:
      814             assign  v-name = buf_contract.cli-name    v-inn  = buf_contract.cli-inn   v-kpp  = buf_contract.cli-kpp .
      815           end.
      816           else do:
      817             if tt-fin-doc.payer-code =  buf_contract.posr-code and tt-fin-doc.payer-type =  buf_contract.posr-type then do:
      818               assign  v-name = buf_contract.posr-name    v-inn  = buf_contract.posr-inn   v-kpp  = buf_contract.posr-kpp .
      819             end.
      820             else do:
      821               if tt-fin-doc.payer-code =  buf_contract.agnt-code and tt-fin-doc.payer-type =  buf_contract.agnt-type then do:
      822                 assign  v-name = buf_contract.agnt-name    v-inn  = buf_contract.agnt-inn   v-kpp  = buf_contract.agnt-kpp .
      823               end.
      824             end.
      825           end.
      826           if TOG-name then do:
      827             if tt-fin-doc.payer-name <> v-name then do:
      828               run writelog ( v-logfile, 0, "    Изменение наименования плательщика. " + tt-fin-doc.payer-name + " -> " + v-name ) .
      829               assign is-edit = yes   tt-fin-doc.payer-name = v-name  .
      830             end.
      831           end.
      832           if TOG-inn then do:
      833             if tt-fin-doc.payer-inn <> v-inn then do:
      834               run writelog ( v-logfile, 0, "    Изменение ИНН плательщика. " + tt-fin-doc.payer-inn + " -> " + v-inn ) .
      835               assign is-edit = yes   tt-fin-doc.payer-inn = v-inn .
      836             end.
      837           end.
      838           if TOG-kpp then do:
      839             if tt-fin-doc.payer-kpp <> v-kpp then do:
      840               run writelog ( v-logfile, 0, "    Изменение КПП плательщика. " + tt-fin-doc.payer-kpp + " -> " + v-kpp ) .
      841               assign is-edit = yes   tt-fin-doc.payer-kpp = v-kpp .
      842             end.
      843           end.
      844         end.
      845         if is-edit = yes then do:
      846           define variable p-doc-rec as recid no-undo.
      847           for each fin-doc-tax no-lock where fin-doc-tax.host-code = v-cntxt-host-code-obj and fin-doc-tax.fin-doc-code = buf_fin-doc.fin-doc-code :
      848             buffer-copy fin-doc-tax to tt-fin-doc-tax .
      849           end.
      850           for each fin-doc-attr no-lock where fin-doc-attr.host-code = v-cntxt-host-code-obj and fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code :
      851             buffer-copy fin-doc-attr to tt-fin-doc-attr .
      852           end.
      853           assign p-doc-rec = recid (buf_fin-doc) .
      854           run writelog ( v-logfile, 0, "     " ) .
      855           tt-fin-doc.doc-author = "fin-ob".
      856           run ref/findoc0.p (
      857               input-output p-doc-rec
      858              ,input 'ИЗМЕНЕНИЕ':U
      859              ,input yes
      860              ,input tt-fin-doc.host-code            ,input tt-fin-doc.fin-doc-code         ,input tt-fin-doc.an-uchet-code        ,input tt-fin-doc.an-uchet-value       ,input tt-fin-doc.base-rate            ,input tt-fin-doc.base-scale           ,input tt-fin-doc.cel-nazn-code        ,input tt-fin-doc.cel-nazn-value       ,input tt-fin-doc.contract-code        ,input tt-fin-doc.contract-curr        ,input tt-fin-doc.contract-rate        ,input tt-fin-doc.contract-scale       ,input tt-fin-doc.cor-acc              ,input tt-fin-doc.cor-acc-value        ,input tt-fin-doc.cor-acc1             ,input tt-fin-doc.cor-acc1-value       ,input tt-fin-doc.curr-code            ,input tt-fin-doc.doc-date             ,input tt-fin-doc.shift-date           ,input tt-fin-doc.shift-num            ,input tt-fin-doc.shift-name           ,input tt-fin-doc.enclosure            ,input tt-fin-doc.exch-rate            ,input tt-fin-doc.exch-scale           ,input tt-fin-doc.f104                 ,input tt-fin-doc.f105                 ,input tt-fin-doc.f106                 ,input tt-fin-doc.f107                 ,input tt-fin-doc.f108                 ,input tt-fin-doc.f109                 ,input tt-fin-doc.f110                 ,input tt-fin-doc.f22                  ,input tt-fin-doc.f23                  ,input tt-fin-doc.fact-date            ,input tt-fin-doc.fin-doc-type         ,input tt-fin-doc.fin-ext-doc-type     ,input tt-fin-doc.in-doc-code          ,input tt-fin-doc.in-host-code         ,input tt-fin-doc.including            ,input tt-fin-doc.nazn-pl              ,input tt-fin-doc.naznach-plat         ,input tt-fin-doc.ocher-pl             ,input tt-fin-doc.out-doc-code         ,input tt-fin-doc.out-host-code        ,input tt-fin-doc.pay-date             ,input tt-fin-doc.payer-bank-name      ,input tt-fin-doc.payer-bank-city      ,input tt-fin-doc.payer-bik            ,input tt-fin-doc.payer-c-schet        ,input tt-fin-doc.payer-code           ,input tt-fin-doc.payer-code-schet     ,input tt-fin-doc.payer-dop1           ,input tt-fin-doc.payer-dop2           ,input tt-fin-doc.payer-inn            ,input tt-fin-doc.payer-kpp            ,input tt-fin-doc.payer-name           ,input tt-fin-doc.payer-okpo           ,input tt-fin-doc.payer-passport      ,input tt-fin-doc.payer-r-schet        ,input tt-fin-doc.payer-type           ,input tt-fin-doc.perm-date            ,input tt-fin-doc.prn-doc-code         ,input tt-fin-doc.PS                   ,input tt-fin-doc.receiver-bank-name   ,input tt-fin-doc.receiver-bank-city   ,input tt-fin-doc.receiver-bik         ,input tt-fin-doc.receiver-c-schet     ,input tt-fin-doc.receiver-code        ,input tt-fin-doc.receiver-code-schet  ,input tt-fin-doc.receiver-dop1        ,input tt-fin-doc.receiver-dop2        ,input tt-fin-doc.receiver-inn         ,input tt-fin-doc.receiver-kpp         ,input tt-fin-doc.receiver-name        ,input tt-fin-doc.receiver-okpo        ,input tt-fin-doc.receiver-passport    ,input tt-fin-doc.receiver-r-schet     ,input tt-fin-doc.receiver-type        ,input tt-fin-doc.srok-pl              ,input tt-fin-doc.stat-pl              ,input tt-fin-doc.str-podr-code        ,input tt-fin-doc.str-podr-type        ,input tt-fin-doc.str-podr-name        ,input tt-fin-doc.sum-base             ,input tt-fin-doc.sum-doc              ,input tt-fin-doc.sum-rubl             ,input tt-fin-doc.sum-contr            ,input tt-fin-doc.trn-doc-code         ,input tt-fin-doc.vid-opl              ,input tt-fin-doc.vid-plat
      861              ,input tt-fin-doc.con-sum-rubl         ,input tt-fin-doc.con-sum-base         ,input tt-fin-doc.con-sum-doc          ,input tt-fin-doc.con-sum-contr        ,input tt-fin-doc.con-stat             ,input tt-fin-doc.payer-sign1                ,input tt-fin-doc.payer-sign2                ,input tt-fin-doc.payer-sign3                ,input tt-fin-doc.payer-sign4                ,input tt-fin-doc.receiver-sign1                ,input tt-fin-doc.receiver-sign2                ,input tt-fin-doc.receiver-sign3                ,input tt-fin-doc.receiver-sign4                ,input tt-fin-doc.obj-type                   ,input tt-fin-doc.obj-code                   ,input tt-fin-doc.doc-author                 ,input tt-fin-doc.fact-author                ,input tt-fin-doc.CashBookId
      862              ,input table tt-fin-doc-tax
      863              ,input table tt-fin-doc-attr
      864              ,input no
      865              ,input table tt0-payment
      866            ) no-error .
      867          if error-status:error then do:
      868            run writelog ( v-logfile, 0, substitute( "&1&2&3", return-value, chr(10), error-status :get-message (1)) ) .
      869          end.
      870         end.
      871       end.
      872       if TOG-name then do:
      873         for each buf_fin-ob no-lock  where  buf_fin-ob.host-code = v-cntxt-host-code-obj
      874           :
      875           find first buf_contract no-lock where buf_contract.host-code = buf_fin-ob.host-code and buf_contract.contract-code = buf_fin-ob.contract-code no-error .
      876           if not available buf_contract then next.
      877   IF ( Counter1 modulo v-account = 0 )  then DO:
      878             if  log-manager:logfile-name ne ?
      879             then DO:
      880                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      881             end.
      882              if mFrameView
      883              then do:
      884               DISPLAY
      885                 Counter1 @ RecordsDone
      886                 WITH FRAME InfoFrame.
      887              end.
      888   End.
      889      if v-button-stop then  DO:
      890            if mFrameView
      891            then
      892               PROCESS EVENTS.
      893            IF StopProcessing THEN DO:
      894            RETURN error.
      895            End.
      896      end.
      897           run writelog ( v-logfile, 0, string(Counter1,">>>9") + " Проверка фин. обязательства вн. номер " + string(buf_fin-ob.doc-code) + " по договору вн.номер "  + string(buf_fin-ob.contract-code)) .
      898           assign
      899             Counter1 = Counter1 + 1
      900             is-edit  = no
      901           .
      902           buffer-copy buf_fin-ob to tt-fin-ob .
      903           if tt-fin-ob.payer-code =  buf_contract.host-code and tt-fin-ob.payer-type = 'орг':U then do:
      904             if TOG-name then do:
      905               if tt-fin-ob.payer-name <> buf_contract.own-name then do:
      906                 run writelog ( v-logfile, 0, "    Изменение наименования плательщика. " + tt-fin-ob.payer-name + " -> " + buf_contract.own-name ) .
      907                 assign is-edit = yes  tt-fin-ob.payer-name = buf_contract.own-name .
      908               end.
      909             end.
      910             if tt-fin-ob.receiver-code =  buf_contract.cli-code and tt-fin-ob.receiver-type =  buf_contract.cli-type then assign  v-name = buf_contract.cli-name .
      911             else do:
      912               if tt-fin-ob.receiver-code =  buf_contract.posr-code and tt-fin-ob.receiver-type =  buf_contract.posr-type then assign  v-name = buf_contract.posr-name .
      913               else do:
      914                 if tt-fin-ob.receiver-code =  buf_contract.agnt-code and tt-fin-ob.receiver-type =  buf_contract.agnt-type then assign  v-name = buf_contract.agnt-name .
      915               end.
      916             end.
      917             if TOG-name then do:
      918               if tt-fin-ob.receiver-name <> v-name then do:
      919                 run writelog ( v-logfile, 0, "    Изменение наименования получателя. " + tt-fin-ob.receiver-name + " -> " + v-name ) .
      920                 assign is-edit = yes   tt-fin-ob.receiver-name = v-name  .
      921               end.
      922             end.
      923           end.
      924           else do:
      925             if TOG-name then do:
      926               if tt-fin-ob.receiver-name <> buf_contract.own-name then do:
      927                 run writelog ( v-logfile, 0, "    Изменение наименования получателя . " + tt-fin-ob.receiver-name + " -> " + buf_contract.own-name ) .
      928                 assign is-edit = yes  tt-fin-ob.receiver-name = buf_contract.own-name .
      929               end.
      930             end.
      931             if tt-fin-ob.payer-code =  buf_contract.cli-code and tt-fin-ob.payer-type =  buf_contract.cli-type then  assign  v-name = buf_contract.cli-name .
      932             else do:
      933               if tt-fin-ob.payer-code =  buf_contract.posr-code and tt-fin-ob.payer-type =  buf_contract.posr-type then  assign  v-name = buf_contract.posr-name .
      934               else do:
      935                 if tt-fin-ob.payer-code =  buf_contract.agnt-code and tt-fin-ob.payer-type =  buf_contract.agnt-type then  assign  v-name = buf_contract.agnt-name .
      936               end.
      937             end.
      938             if TOG-name then do:
      939               if tt-fin-ob.payer-name <> v-name then do:
      940                 run writelog ( v-logfile, 0, "    Изменение наименования плательщика. " + tt-fin-ob.payer-name + " -> " + v-name ) .
      941                 assign is-edit = yes   tt-fin-ob.payer-name = v-name  .
      942               end.
      943             end.
      944           end.
      945           if is-edit = yes then do:
      946             find first fin-ob exclusive-lock where recid(fin-ob) = recid(buf_fin-ob) .
      947             assign
      948               fin-ob.payer-name    = tt-fin-ob.payer-name
      949               fin-ob.receiver-name = tt-fin-ob.receiver-name
      950             .
      951           end.
      952         end.
      953       end.
      954   if mFrameView
      955   then do:
      956      HIDE FRAME InfoFrame.
      957   end.
      958       define variable s-list as character no-undo .
      959       run gbl/prnfilen.w ( input  "Результат работы утилиты", input  0, input v-logfile, input  7, output s-list, output is-edit ).
      960     end.
      961   end procedure.
