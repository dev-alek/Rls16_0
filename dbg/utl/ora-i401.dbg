      275   define variable vv-sumkolc  as decimal   no-undo .
      276   MAIN-BLOCK:
      277   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      278      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      279      for each  temp_ord-doc :
      280          for each temp_ord-line where
      281                   temp_ord-line.line-num = temp_ord-doc.line-num :
      282              if temp_ord-line.doc-code <> temp_ord-doc.doc-code then do:
      283                 assign
      284                     v-end-message =  substitute("Не верно указан doc-num &1 &2  товар &3" ,
      285                     temp_ord-line.doc-code ,
      286                     temp_ord-doc.doc-code ,
      287                     temp_ord-line.gds-code
      288                     ).
      289                 run pcall-log-file in p-log-handle (input v-end-message) .
      290                 undo, return error v-end-message.
      291              end.
      292          end.
      293      end.
      294   run get-db-num in parparentproc ( output v-cntxt-db-num ) .
      295   run get-userid in parparentproc ( output v-cntxt-userid ) .
      296   p-ok-doc = 0 .
      297      _temp-ord-doc:
      298      for each temp_ord-doc
      299      :
      300      k = 0 .
      301     case temp_ord-doc.status_ :
      302     when 'N'
      303     or
      304     when 'U'
      305     or
      306     when 'D' then do:
      307       if temp_ord-doc.status_ = 'D' then do:
      308         find first ub.ord-doc exclusive-lock where
      309                    ub.ord-doc.doc-code =  trim(temp_ord-doc.corr-doc-code) no-error .
      310         if error-status :error then do:
      311         v-end-message =  substitute(" Заказ: &1 не найден " ,
      312                                       temp_ord-doc.corr-doc-code
      313                                       ).
      314         run pcall-log-file in p-log-handle (input v-end-message) .
      315         undo, return error v-end-message.
      316         end.
      317         assign
      318           ub.ord-doc.fact-date  = today
      319           ub.ord-doc.fact-order = decimal(today)
      320           ub.ord-doc.status_    = 'отказ':U
      321           ub.ord-doc.cons-code  = ""
      322           temp_ord-doc.pay-code = ub.ord-doc.pay-code
      323           .
      324         ub.ord-doc.ps = "ОТКАЗ из внешней ситемы " + ub.ord-doc.ps + " №:" + temp_ord-doc.doc-code +
      325                       " от " + string ( temp_ord-doc.doc-date , "99/99/9999") .
      326         v-end-message =  substitute(" ОТКАЗ &3&4 Заказ: &1  товаров: &2" ,
      327                                       temp_ord-doc.doc-code    ,
      328                                       k ,
      329                                       temp_ord-doc.obj-type ,
      330                                       temp_ord-doc.obj-code
      331                                       ).
      332         run pcall-log-file in p-log-handle (input v-end-message) .
      333         next _temp-ord-doc.
      334     end.
      335     else do :
      336        if temp_ord-doc.corr-doc-code <> "" then do:
      337         find first ub.ord-doc exclusive-lock where
      338                    ub.ord-doc.doc-code =  trim(temp_ord-doc.corr-doc-code) no-error .
      339         if error-status :error then do:
      340         v-end-message =  substitute(" Заказ: &1 не найден " ,
      341                                       temp_ord-doc.corr-doc-code
      342                                       ).
      343         run pcall-log-file in p-log-handle (input v-end-message) .
      344         undo, return error v-end-message.
      345         end.
      346         assign
      347           ub.ord-doc.fact-date  = today
      348           ub.ord-doc.fact-order = decimal(today)
      349           ub.ord-doc.status_    = 'факт':U
      350           ub.ord-doc.cons-code  = ""
      351           temp_ord-doc.pay-code = ub.ord-doc.pay-code
      352           .
      353         v-end-message = "Закрыт заказом из внешней ситемы  №:" + temp_ord-doc.doc-code +
      354                       " от " + string ( temp_ord-doc.doc-date , "99/99/9999") .
      355         ub.ord-doc.ps = v-end-message.
      356         run pcall-log-file in p-log-handle (input v-end-message) .
      357       end.
      358       else do:
      359         v-end-message = "Заказ от внешней системы  №:" + temp_ord-doc.doc-code +
      360                       " от " + string ( temp_ord-doc.doc-date , "99/99/9999") + " Пришел без ссылки на заказ ТН." .
      361         run pcall-log-file in p-log-handle (input v-end-message) .
      362       end.
      363     end.
      364     find first bufo_clients no-lock where
      365                bufo_clients.obj-type  = temp_ord-doc.obj-type  and
      366                bufo_clients.obj-code  = temp_ord-doc.obj-code  no-error .
      367         if error-status :error then do:
      368                 assign
      369                 v-end-message =  substitute(" Не найден объект &1 &2 &3 &4" , temp_ord-doc.obj-type , temp_ord-doc.obj-code , error-status :get-message(1) , return-value )
      370                 .
      371                 run pcall-log-file in p-log-handle (input v-end-message) .
      372                 undo, return error v-end-message.
      373         end.
      374   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      376     (input  temp_ord-doc.obj-type
      377     ,input  temp_ord-doc.obj-code
      378     ,output v-host-code
      379     ) no-error .
      380         if error-status :error then do:
      381           assign
      382               v-end-message =  substitute("Не верно указан объект &1 &2 " ,
      383               temp_ord-doc.obj-type ,
      384               temp_ord-doc.obj-code ).
      385           run pcall-log-file in p-log-handle (input v-end-message) .
      386           undo, return error v-end-message.
      387         end.
      388         temp_ord-doc.host-code = v-host-code .
      389       find first buf_contract no-lock where
      390                  buf_contract.contract-code =  temp_ord-doc.cli-code and
      391                  buf_contract.host-code     =  temp_ord-doc.host-code no-error .
      392      if not available  buf_contract then do:
      393         temp_ord-doc.contract-code =  0.
      394      end.
      395      else do:
      396         temp_ord-doc.contract-code =  buf_contract.contract-code .
      397      end.
      398         v-specif = false .
      399   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   empty temp-table thbjattr_thbj-attr.
      401   run adm/shattri.p (
      402      input "get":U
      403     ,input temp_ord-doc.obj-type
      404     ,input temp_ord-doc.obj-code
      405     ,input 'nakl_par':U
      406     ,input  ""
      407     ,output v-value-character
      408     ,output v-value-date
      409     ,output v-value-decimal
      410     ,output v-value-integer
      411     ,output v-value-logical
      412     ,output par-type
      413     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      414     ) no-error .
      415         for each thbjattr_thbj-attr :
      416           if thbjattr_thbj-attr.prop-code = 'type-vat' then v-value-integer = thbjattr_thbj-attr.property-value-integer.
      417         end.
      418             case v-value-integer:
      419             when 1 or when ? then do:
      420               assign
      421                 v-typevat = 'в т. ч.':U.
      422             end.
      423             when 2 then do:
      424               assign
      425                 v-typevat = 'нет':U.
      426             end.
      427             when 3 then do:
      428               assign
      429                 v-typevat = 'без':U.
      430             end.
      431             otherwise do:
      432                 v-end-message =  substitute(" Не верно задан атрибут 'Тип заведения НДС' (type-vat). &1 &2 &3 &4 &5" , temp_ord-doc.obj-type , temp_ord-doc.obj-code , error-status :get-message(1) , return-value , v-value-integer ) .
      433                 run pcall-log-file in p-log-handle (input v-end-message) .
      434                 undo, return error v-end-message.
      435             end.
      436             end case.
      437      if temp_ord-doc.contract-code  > 0 then do:
      438        find first  ub.contract-specif no-lock where
      439         ub.contract-specif.contract-num = temp_ord-doc.contract-code and
      440         ub.contract-specif.host-code    = temp_ord-doc.host-code  no-error .
      441         if available ub.contract-specif then
      442            assign
      443              v-typevat  = ub.contract-specif.VAT-type
      444              v-specif = true .
      445            .
      446      end.
      447      if buf_contract.curr-code <> temp_ord-doc.exch-code then do:
      448                   v-end-message =  substitute("По договору &3   ожидалась валюта &1  пришла &2 " ,
      449                   buf_contract.curr-code,
      450                   temp_ord-doc.exch-code,
      451                   temp_ord-doc.contract-code ) .
      452                   run pcall-log-file in p-log-handle (input v-end-message) .
      453                   undo, return error v-end-message.
      454      end.
      455         run who-cli-ora in this-procedure (
      456             input  temp_ord-doc.cli-code ,
      457             output temp_ord-doc.cli-type ,
      458             output temp_ord-doc.cli-code
      459             ) no-error .
      460             if error-status :error then return error return-value .
      461         v-cntxt-obj-code      =  temp_ord-doc.obj-code .
      462         v-cntxt-obj-type      =  temp_ord-doc.obj-type .
