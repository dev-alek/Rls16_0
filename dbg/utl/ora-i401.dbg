      739   procedure ver-contract :
      740   define input  parameter p-contract-code as integer   no-undo .
      741   define input  parameter p-host-code     as integer   no-undo .
      742   define input  parameter p-doc-code      as character no-undo .
      743   define buffer bf_contract-specif for ub.contract-specif  .
      744     do
      745     on error undo, return error return-value
      746     :
      747         if p-contract-code > 0  then do:
      748             find first bf_contract-specif where bf_contract-specif.host-code    = p-host-code     and
      749                                                 bf_contract-specif.contract-num = p-contract-code no-lock no-error.
      750             if available bf_contract-specif then do:
      751                for each ub.ord-line no-lock where
      752                         ub.ord-line.doc-code = p-doc-code :
      753                   if not can-find (first bf_contract-specif no-lock where
      754                                          bf_contract-specif.host-code    = p-host-code and
      755                                          bf_contract-specif.contract-num = p-contract-code and
      756                                          bf_contract-specif.gds-code     = ub.ord-line.gds-code   ) then do:
      757                       v-end-message =  substitute(
      758                         "Выбран Договор со спецификацией. Несоответствие списка товаров заказа и спецификации&1Заказ      :&2&1код товара :&3&1артикл     :&4&1 ",
      759                         ub.ord-line.doc-code,
      760                         ub.ord-line.gds-code,
      761                         ub.ord-line.artic ).
      762                       run pcall-log-file in p-log-handle (input v-end-message) .
      763                       undo, return error v-end-message.
      764                   end.
      765                end.
      766             end.
      767           end.
      768     end.
      769   end procedure.
