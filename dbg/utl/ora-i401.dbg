       76   define new global shared variable g#vssrevis-logger as handle    no-undo .
       77   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       78   define variable v-vssrevis-logger                   as handle    no-undo .
       79   procedure vss-logevent :
       80     define input  parameter p-extra-paramters as character no-undo .
       81     define variable v-vssrevis-parameters as character no-undo .
       82     do
       83     on error undo, return error return-value
       84     :
       85       if  valid-handle(v-vssrevis-logger)
       86       and v-vssrevis-logger :get-signature("logevent") <> ""
       87       then do:
       88         run vss-get-parameters in this-procedure
       89           (output v-vssrevis-parameters
       90           ).
       91         run logevent in v-vssrevis-logger
       92           (input vss-workfile
       93           ,input vss-revision
       94           ,input v-vssrevis-parameters
       95           ,input p-extra-paramters
       96           ).
       97       end.
       98     end.
       99   end procedure.
      100   assign
