      131   procedure proc-ord-code :
      132   define input  parameter  p-type as character no-undo .
      133   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      134   define input  parameter  v-cntxt-obj-type as character no-undo .
      135   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      136   define input  parameter  p-i-doc    as character no-undo .
      137   define output parameter  p-ord-doc  as character no-undo .
      138   define variable          v-idop     as character no-undo .
      139     do
      140     on error undo, return error return-value
      141     :
      142   case p-type :
      143       when "main-no-ver" then do:
      144         if  (v-cntxt-db-num <> 0) then
      145           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      146         else
      147           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      148       end.
      149       when "main" then do:
      150             do while true:
      151             if  (v-cntxt-db-num <> 0) then
      152               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      153             else
      154               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      155             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      156             End.
      157       end.
      158       when "chip" then do:
      159         assign
      160           v-idop = p-i-doc .
      161         do while true :
      162           if index (v-idop , ".") = 0 then
      163             v-idop  = replace (v-idop , "-", "-1.").
      164           else
      165             v-idop  =
      166             substring (v-idop , 1, index (v-idop, "-")) +
      167             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      168             substring (v-idop, index (v-idop, ".")).
      169           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      170         end.
      171         assign
      172           p-ord-doc = v-idop.
      173       end.
      174   end case.
      175     end.
      176   end procedure.
      177   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   define variable to-day       as date no-undo .
      179   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
      180   procedure who-cli-ora :
      181   define input  parameter p-cli-code-ora as integer   no-undo .
      182   define output parameter p-cli-type as character no-undo .
      183   define output parameter p-cli-code as integer   no-undo .
      184     do
      185     on error undo, return error return-value
      186     :
      187     if length (string(p-cli-code-ora))  <> 9 then do:
      188        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
      189     end.
      190     if string(p-cli-code-ora) begins "1" or
      191        string(p-cli-code-ora) begins "2" or
      192        string(p-cli-code-ora) begins "4" then do:
      193         p-cli-type = 'орг':U .
      194         p-cli-code = p-cli-code-ora  .
      195     end.
      196     else do:
      197       if string(p-cli-code-ora) begins "3" then do:
      198         p-cli-type = 'чел':U .
      199         p-cli-code = p-cli-code-ora  .
      200       end.
      201       else do:
      202          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
      203       end.
      204     end.
      205     define buffer buf_clients for ub.clients  .
      206     find first buf_clients no-lock where
      207                buf_clients.obj-type = p-cli-type and
      208                buf_clients.obj-code = p-cli-code
      209                no-error .
      210         if error-status :error then do:
      211             return error substitute
      212             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
      213                 p-cli-code-ora ,
      214                 p-cli-type ,
      215                 p-cli-code ) .
      216         end.
      217         if ora-icli_ver-stts-client then do:
      218             if buf_clients.stts > 0 then do:
      219                 return error substitute
      220                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
      221                     p-cli-code-ora ,
      222                     p-cli-type ,
      223                     p-cli-code ) .
      224             end.
      225         end.
      226     end.
      227   end procedure.
      228   procedure ora-ver-goods :
      229   define input  parameter p-gds-code as integer   no-undo .
      230   define buffer buf_goods for ub.goods  .
      231   define variable my-message as character no-undo .
      232     do
      233     on error undo, return error return-value
      234     :
      235           find first buf_goods no-lock where
      236                      buf_goods.gds-code = p-gds-code no-error .
      237               if error-status :error then do:
      238                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
      239                   undo, return error my-message.
      240               end.
      241             if buf_goods.stts > 0 then do:
      242               assign
      243                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
      244                 undo, return error my-message.
      245             end.
      246     end.
      247   end procedure.
      248   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      249   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
