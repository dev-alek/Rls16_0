        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle    as handle no-undo .
        5   define input parameter p-parameter      as character no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo init "Тригер изменение ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable v-pack-data    as memptr no-undo .
       67   define variable v-full-path    as character no-undo .
       68   define variable v-err-msg      as character no-undo .
       69   define variable v-step-msg     as character no-undo .
       70   define variable parseSubObj    as class ibs.th.bge.1crn.import.parsesub no-undo.
       71   define variable impSubObj      as class ibs.th.bge.1crn.import.impsubject no-undo.
       72     if not valid-handle (p-log-handle) then
       73       undo, throw new Progress.Lang.AppError ("Отсутствует указатель на процедуру записи в лог.") .
       74     if not can-do (p-log-handle:internal-entries, "write-log":U) then
       75       undo, throw new Progress.Lang.AppError ("Отсутствует функция записи в лог в процедуре записи в лог.") .
       76     v-full-path = search("nws/kass-books.xml") .
       77     if v-full-path > "" then do :
       78       v-err-msg = substitute("импорт кассовых книг из файла &1", v-full-path) .
       79       run write-log in p-log-handle ( input 2, input v-err-msg ).
       80     end .
       81     else do :
       82       v-err-msg = substitute("отсутствует файл импорта кассовых книг &1", "nws/kass-books.xml") .
       83       run write-log in p-log-handle ( input 2, input v-err-msg ).
       84       return .
       85     end .
       86     v-step-msg = "чтение файла" .
       87     set-size(v-pack-data) = 0 .
       88     COPY-LOB FROM FILE v-full-path TO OBJECT v-pack-data NO-CONVERT .
       89     v-step-msg = "создание разбора пакета" .
       90     parseSubObj = new ibs.th.bge.1crn.import.parsesub () .
       91     v-step-msg = "установка указателей в разборе пакета" .
       92     parseSubObj:setParent(parparentproc, p-parent-handle, p-log-handle) .
       93     v-step-msg = "создание импорта пакета" .
       94     impSubObj = new ibs.th.bge.1crn.import.impsubject (parseSubObj).
       95     v-step-msg = "импорт пакета" .
       96     parseSubObj:Parse1CRNSub(v-pack-data).
       97     v-step-msg = "импорт завершён" .
       98     v-err-msg = substitute("пакет из файла &1 обработан без ошибок", v-full-path) .
       99     run write-log in p-log-handle ( input 2, input v-err-msg ).
      100     v-err-msg = "" .
      101     catch exAppErrors as class Progress.Lang.AppError :
      102       v-err-msg = exAppErrors:ReturnValue .
      103       if v-err-msg > "" then . else do :
      104         v-err-msg = exAppErrors:GetMessage(1) .
      105         if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\kass-book-new.p" .
      106       end .
      107       v-err-msg = v-step-msg + " " + v-err-msg .
      108     end catch .
      109     catch exProErrors as class Progress.Lang.ProError :
      110       v-err-msg = exProErrors:GetMessage(1) .
      111       if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\kass-book-new.p" .
      112     end catch .
      113     catch exAnyErrors as class Progress.Lang.Error:
      114       v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\kass-book-new.p " + exAnyErrors:GetMessage(1).
      115     end catch .
      116     finally:
      117       if valid-object(impSubObj)   then delete object impSubObj .
      118       if valid-object(parseSubObj) then delete object parseSubObj .
      119       set-size(v-pack-data) = 0 .
      120       if v-err-msg > "" then do :
      121         run write-log in p-log-handle ( input 2, input v-err-msg ).
      122         undo.
      123       end .
      124     end finally.
