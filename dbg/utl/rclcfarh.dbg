        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7   define variable v-waitfram-action01         as character   no-undo .
        8   define variable v-waitfram-action02         as character   no-undo .
        9   define variable v-waitfram-action03         as character   no-undo .
       10   define variable mWaitFramTextBeg            as character   no-undo.
       11   define variable mWaitFramTextEnd            as character   no-undo.
       12   define variable mWaitFramView               as logical     no-undo.
       13   define variable mWaitProcEvent              as logical     no-undo init yes.
       14   define variable mWaitFramInterval           as integer     no-undo init 1 .
       15   define variable mWaitFramStop               as logical     no-undo.
       16   define variable mWaitFramStopUser           as logical     no-undo.
       17   define variable mWaitFramStopTimeOut        as logical     no-undo.
       18   define variable mWaitFramStartProc          as datetime-tz no-undo.
       19   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       20   define button B-WaitFramStop auto-end-key
       21        label "Стоп"
       22        size 10 by 1 tooltip "Остоновить процесс".
       23   define button B-viewProcInfo
       24        label "Информация"
       25        size 15 by 1 tooltip "Информация о процесс".
       26   define frame waitfram
       27     v-waitfram-action01 format "x(72)" no-label skip
       28     v-waitfram-action02 format "x(72)" no-label skip
       29     v-waitfram-action03 format "x(72)" no-label skip
       30     B-viewProcInfo
       31     B-WaitFramStop at row 4 col 30
       32     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       33     .
       34   define new global shared variable mBatchMode as logical no-undo init ?.
       35   define variable mFramBachModHandle as handle no-undo.
       36   mFramBachModHandle = frame waitfram:handle.
       37   define variable mFameOldVis as logical no-undo.
       38   define variable mVisCUrentVin as logical no-undo.
       39   if session:batch-mode
       40   then
       41      mBatchMode = yes.
       42   if mBatchMode = ? then do:
       43     mVisCUrentVin = current-window:visible.
       44     mFameOldVis = mFramBachModHandle:visible.
       45     mFramBachModHandle:visible  = yes.
       46     mBatchMode = mFramBachModHandle:visible ne yes.
       47     mFramBachModHandle:visible = mFameOldVis.
       48     current-window:visible = mVisCUrentVin.
       49   end.
       50    if  log-manager:logfile-name ne ?
       51     then DO:
       52         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
       53         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
       54         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
       55     end.
       56   on choose of B-WaitFramStop in frame waitfram
       57   do:
       58     mWaitFramStop = yes.
       59     mWaitFramStopUser = yes.
       60   end.
       61   function waitfram-check-timeout returns logical():
       62      define variable vtime as int64 no-undo.
       63      if mWaitFramStopTimeOut
       64      then
       65         return yes.
       66      vtime = ( now - mWaitFramStartProc ) / 1000 .
       67      if     mWaitFramTimeOut ne ?
       68         and mWaitFramTimeOut ne 0
       69         and mWaitFramTimeOut lt vtime
       70      then do:
       71         mWaitFramStopTimeOut = yes.
       72      end.
       73      return mWaitFramStopTimeOut.
       74   end.
       75   procedure waitfram-hide :
       76     if not session:batch-mode
       77     then do
       78     on error undo, return error return-value
       79     :
       80       pause 0 before-hide .
       81       if not mBatchMode then
       82         hide frame waitfram .
       83     if     not mWaitFramView
       84        and mWaitProcEvent
       85     then
       86       process events .
       87     end.
       88   end procedure.
       89   procedure waitfram-show :
       90     define input  parameter p-message as character no-undo .
       91     define variable v-left-margin as integer   no-undo .
       92     if not session:batch-mode
       93     then do
       94     on error undo, return error return-value
       95     :
       96       if length(p-message) <= 70 then do:
       97         assign
       98           v-left-margin = integer((70 - length(p-message)) / 2)
       99         .
      100         assign
      101           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      102         .
      103         assign
      104           v-waitfram-action01 = " "
      105           v-waitfram-action02 = " "
      106                                    + fill(" ", v-left-margin)
      107                                    + p-message
      108           v-waitfram-action03 = " "
      109         .
      110       end.
      111       else do:
      112         define variable vRindex1 as integer no-undo.
      113         define variable vRindex2 as integer no-undo.
      114         vRindex1 = r-index(p-message," ",70).
      115         if vRindex1 = 0
      116         then
      117            vRindex1 = 70.
      118         if length(p-message)  <= vRindex1 + 70 then do:
      119           assign
      120             v-waitfram-action01 = " "
      121             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      122             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      123           .
      124         end.
      125         else do:
      126           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      127           if vRindex2 <= vRindex1
      128           then
      129              vRindex2 = vRindex1 + 70.
      130           assign
      131             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      132             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      133             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      134           .
      135         end.
      136       end.
      137       B-viewProcInfo:visible   in frame waitfram = no.
      138       B-viewProcInfo:sensitive in frame waitfram = no.
      139       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      140       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      141       if  (   mWaitFramView
      142          or  mWaitProcEvent)
      143          and not mBatchMode
      144       then
      145          display
      146             v-waitfram-action01 skip
      147             v-waitfram-action02 skip
      148             v-waitfram-action03 skip
      149          with frame waitfram .
      150       if     mWaitFramView
      151          then do:
      152             if     mWaitFramInterval ne ?
      153                and not mBatchMode
      154             then
      155                wait-for go of frame waitfram pause mWaitFramInterval.
      156          end.
      157          else
      158             if     mWaitProcEvent
      159                and not mBatchMode
      160             then
      161                process events .
      162     end.
      163   end procedure.
      164      procedure waitfram-show-this:
      165         define input  parameter iInterval as int64 no-undo.
      166         define variable vtime as int64 no-undo.
      167         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      168         mWaitFramInterval = iInterval.
      169         run waitfram-show (substitute("&1&2 &3&4" ,
      170                                       mWaitFramTextBeg ,
      171                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      172                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      173                                       mWaitFramTextEnd
      174                                      )
      175                           ).
      176      end.
      177      procedure WaitFramRunPause:
      178         define input  parameter iInterval as dec no-undo.
      179         define variable vStart  as datetime-tz no-undo.
      180         define variable vend    as datetime-tz no-undo.
      181         define variable vint as int64 no-undo.
      182         define variable vOk as logical no-undo.
      183         vStart = now.
      184         vend   = vStart.
      185         publish "WaitFramPause" (iInterval,output vOk).
      186         vend   =  now.
      187         vint = vend - vStart.
      188         vint = iInterval - vint / 1000.
      189         if     not mWaitFramStop
      190            and (   vint > 0
      191                 or (    not vOk
      192                     and iInterval eq ?
      193                     )
      194                 )
      195         then
      196            run waitfram-show-this (iInterval).
      197         vend   =  now.
      198         vint = vend - vStart.
      199         vint = iInterval - vint / 1000.
      200         if     not mWaitFramStop
      201            and vint > 0
      202         then do:
      203            run gbl/pause.p (vint * 1000).
      204         end.
      205         if iInterval ne ?
      206         then
      207            publish "WaitFramStop".
      208         waitfram-check-timeout().
      209      end.
      210      procedure WaitFramWaitFor:
      211         define input  parameter iInterval as dec no-undo.
      212         assign
      213            mWaitFramStartProc   = now
      214            mWaitFramStopUser    = no
      215            mWaitFramStopTimeOut = no
      216         .
      217         block-wait:
      218         do while not mWaitFramStop:
      219            run WaitFramRunPause (iInterval).
      220            if  waitfram-check-timeout()
      221            then do:
      222               leave block-wait.
      223            end.
      224         end.
      225         run waitfram-hide.
      226      end.
      227   procedure waitfram-join :
      228     define input  parameter p-line-1  as character no-undo .
      229     define input  parameter p-line-2  as character no-undo .
      230     define input  parameter p-line-3  as character no-undo .
      231     define output parameter p-message as character no-undo .
      232     do
      233     on error undo, return error return-value
      234     :
      235       assign
      236         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      237                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      238                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      239       .
      240     end.
      241   end procedure.
      242   function waitfram-join-function returns character
      243     (input p-line-1 as character
      244     ,input p-line-2 as character
      245     ,input p-line-3 as character
      246     ).
      247     define variable v-message as character no-undo .
      248     run waitfram-join in this-procedure
      249       (input  p-line-1
      250       ,input  p-line-2
      251       ,input  p-line-3
      252       ,output v-message
      253       ) .
      254     return v-message .
      255   end function .
      256   define new global shared variable g#libofarh as handle no-undo .
      257   define new global shared variable g#lib-farh as handle no-undo .
      258   define input parameter parhost-code like ub.sysconf.host-code no-undo.
      259   define input parameter parrecalc-fo as   logical              no-undo.
      260   define input parameter parlist-arh  as   character            no-undo.
      261   on delete of arh-fin-doc-an                override do: end.
      262   on delete of arh-fin-doc-an-nal            override do: end.
      263   on delete of arh-fin-doc-an-nal-obj        override do: end.
      264   on delete of arh-fin-doc-an-obj            override do: end.
      265   on delete of arh-fin-doc-c-s-tax-nal-obj   override do: end.
      266   on delete of arh-fin-doc-c-schet-tax-nal   override do: end.
      267   on delete of arh-fin-doc-contr-s-nal-obj   override do: end.
      268   on delete of arh-fin-doc-contr-s-tax-obj   override do: end.
      269   on delete of arh-fin-doc-contr-schet       override do: end.
      270   on delete of arh-fin-doc-contr-schet-nal   override do: end.
      271   on delete of arh-fin-doc-contr-schet-obj   override do: end.
      272   on delete of arh-fin-doc-contr-schet-tax   override do: end.
      273   on delete of arh-fin-doc-s-tax-nal-obj     override do: end.
      274   on delete of arh-fin-doc-schet             override do: end.
      275   on delete of arh-fin-doc-schet-nal         override do: end.
      276   on delete of arh-fin-doc-schet-nal-obj     override do: end.
      277   on delete of arh-fin-doc-schet-obj         override do: end.
      278   on delete of arh-fin-doc-schet-tax         override do: end.
      279   on delete of arh-fin-doc-schet-tax-nal     override do: end.
      280   on delete of arh-fin-doc-schet-tax-obj     override do: end.
      281   on delete of arh-fin-ob-contr              override do: end.
      282   on delete of arh-fin-ob-contr-obj          override do: end.
      283   on write  of arh-fin-doc-an                override do: end.
      284   on write  of arh-fin-doc-an-nal            override do: end.
      285   on write  of arh-fin-doc-an-nal-obj        override do: end.
      286   on write  of arh-fin-doc-an-obj            override do: end.
      287   on write  of arh-fin-doc-c-s-tax-nal-obj   override do: end.
      288   on write  of arh-fin-doc-c-schet-tax-nal   override do: end.
      289   on write  of arh-fin-doc-contr-s-nal-obj   override do: end.
      290   on write  of arh-fin-doc-contr-s-tax-obj   override do: end.
      291   on write  of arh-fin-doc-contr-schet       override do: end.
      292   on write  of arh-fin-doc-contr-schet-nal   override do: end.
      293   on write  of arh-fin-doc-contr-schet-obj   override do: end.
      294   on write  of arh-fin-doc-contr-schet-tax   override do: end.
      295   on write  of arh-fin-doc-s-tax-nal-obj     override do: end.
      296   on write  of arh-fin-doc-schet             override do: end.
      297   on write  of arh-fin-doc-schet-nal         override do: end.
      298   on write  of arh-fin-doc-schet-nal-obj     override do: end.
      299   on write  of arh-fin-doc-schet-obj         override do: end.
      300   on write  of arh-fin-doc-schet-tax         override do: end.
      301   on write  of arh-fin-doc-schet-tax-nal     override do: end.
      302   on write  of arh-fin-doc-schet-tax-obj     override do: end.
      303   on write  of arh-fin-ob-contr              override do: end.
      304   on write  of arh-fin-ob-contr-obj          override do: end.
      305   if parlist-arh = "" then parlist-arh = "all" .
      306   run del-for-one-firm  (input parhost-code, input parlist-arh) no-error.
      307   if error-status:error then do:
      308     message return-value error-status:get-message(1) error-status:get-message(2) view-as alert-box error.
      309     return error.
      310   end.
      311   run calc-for-one-firm (input parhost-code, input parlist-arh) no-error.
      312   if error-status:error then do:
      313     message return-value error-status:get-message(1) error-status:get-message(2) view-as alert-box error.
      314     return error.
      315   end.
      316   procedure calc-for-one-firm :
      317   define input parameter parhost-code like ub.sysconf.host-code no-undo.
      318   define input parameter parlist-arh  as   character            no-undo.
      319   define buffer bf_fin-ob  for ub.fin-ob.
      320   define buffer bf_fin-doc for ub.fin-doc.
      321   define variable p-var as logical   no-undo .
      322   do on error undo, return error return-value :
      323     if parrecalc-fo then do:
      324       run waitfram-show in this-procedure (substitute ("Расчитываем финансовые архивы финобязательств по фирме &1", parhost-code)).
      325       for each bf_fin-ob where bf_fin-ob.host-code = parhost-code and
      326                                bf_fin-ob.status_   = 'факт':U      by bf_fin-ob.host-code by bf_fin-ob.status_ by bf_fin-ob.fact-order on error undo, return error return-value :
      327   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      328   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_taskclco in g#libofarh
      329   (input parhost-code
      330   ,input bf_fin-ob.doc-code
      331   ,input 'Полный пересчет архивов':u
      332   ,input 'close':u
      333   ,input no
      334   ,output p-var
      335   ) no-error
      336   .
      337         if error-status:error then do:
      338           undo, return error substitute("Ошибка при пересчете архивов по ФО фирма &1 док-т &2:&3&4&3&5"
      339                                          , bf_fin-ob.host-code
      340                                          , bf_fin-ob.doc-code
      341                                          , chr(10)
      342                                          , error-status:get-message(1)
      343                                          , return-value ).
      344         end.
      345       end.
      346     end.
      347     run waitfram-show in this-procedure (substitute ("Расчитываем финансовые архивы финдокументов по фирме &1", parhost-code)).
      348     for each bf_fin-doc where bf_fin-doc.host-code = parhost-code and
      349                               bf_fin-doc.status_   = 'факт':U      by bf_fin-doc.host-code by bf_fin-doc.status_ by bf_fin-doc.fact-order on error undo, return error return-value :
      350   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_taskclcd in g#lib-farh
      351   (input parhost-code
      352   ,input bf_fin-doc.fin-doc-code
      353   ,input parlist-arh
      354   ,input 'Полный пересчет архивов':u
      355   ,input 'recalc':u
      356   ) no-error
      357   .
      358         if error-status:error then do:
      359           undo, return error substitute("Ошибка при пересчете архиво по финдок-там фирма &1 вн.№ &2:&3&4&3&5"
      360                                          , bf_fin-doc.host-code
      361                                          , bf_fin-doc.fin-doc-code
      362                                          , chr(10)
      363                                          , error-status:get-message(1)
      364                                          , return-value ).
      365         end.
      366     end.
      367   end.
      368   end procedure.
      369   procedure del-for-one-firm :
      370   define input parameter parhost-code like ub.sysconf.host-code no-undo.
      371   define input parameter parlist-arh  as   character            no-undo.
      372   define buffer bf_arh-fin-doc-an              for ub.arh-fin-doc-an             .
      373   define buffer bf_arh-fin-doc-an-nal          for ub.arh-fin-doc-an-nal         .
      374   define buffer bf_arh-fin-doc-an-nal-obj      for ub.arh-fin-doc-an-nal-obj     .
      375   define buffer bf_arh-fin-doc-an-obj          for ub.arh-fin-doc-an-obj         .
      376   define buffer bf_arh-fin-doc-c-s-tax-nal-obj for ub.arh-fin-doc-c-s-tax-nal-obj.
      377   define buffer bf_arh-fin-doc-c-schet-tax-nal for ub.arh-fin-doc-c-schet-tax-nal.
      378   define buffer bf_arh-fin-doc-contr-s-nal-obj for ub.arh-fin-doc-contr-s-nal-obj.
      379   define buffer bf_arh-fin-doc-contr-s-tax-obj for ub.arh-fin-doc-contr-s-tax-obj.
      380   define buffer bf_arh-fin-doc-contr-schet     for ub.arh-fin-doc-contr-schet    .
      381   define buffer bf_arh-fin-doc-contr-schet-nal for ub.arh-fin-doc-contr-schet-nal.
      382   define buffer bf_arh-fin-doc-contr-schet-obj for ub.arh-fin-doc-contr-schet-obj.
      383   define buffer bf_arh-fin-doc-contr-schet-tax for ub.arh-fin-doc-contr-schet-tax.
      384   define buffer bf_arh-fin-doc-s-tax-nal-obj   for ub.arh-fin-doc-s-tax-nal-obj  .
      385   define buffer bf_arh-fin-doc-schet           for ub.arh-fin-doc-schet          .
      386   define buffer bf_arh-fin-doc-schet-nal       for ub.arh-fin-doc-schet-nal      .
      387   define buffer bf_arh-fin-doc-schet-nal-obj   for ub.arh-fin-doc-schet-nal-obj  .
      388   define buffer bf_arh-fin-doc-schet-obj       for ub.arh-fin-doc-schet-obj      .
      389   define buffer bf_arh-fin-doc-schet-tax       for ub.arh-fin-doc-schet-tax      .
      390   define buffer bf_arh-fin-doc-schet-tax-nal   for ub.arh-fin-doc-schet-tax-nal  .
      391   define buffer bf_arh-fin-doc-schet-tax-obj   for ub.arh-fin-doc-schet-tax-obj  .
      392   define buffer bf_arh-fin-ob-contr            for ub.arh-fin-ob-contr           .
      393   define buffer bf_arh-fin-ob-contr-obj        for ub.arh-fin-ob-contr-obj       .
      394   do on error undo, return error return-value :
      395   run waitfram-show in this-procedure (substitute ("Удаляем финансовые архивы по фирме &1", parhost-code)).
      396   if parlist-arh = "all":u or lookup ('arh-fin-doc-an':U,              parlist-arh) > 0 then do: for each bf_arh-fin-doc-an              where bf_arh-fin-doc-an             .host-code = parhost-code on error undo, return error return-value : delete bf_arh-fin-doc-an             . end. end.
      397   if parlist-arh = "all":u or lookup ('arh-fin-doc-an-nal':U,          parlist-arh) > 0 then do: for each bf_arh-fin-doc-an-nal          where bf_arh-fin-doc-an-nal         .host-code = parhost-code on error undo, return error return-value : delete bf_arh-fin-doc-an-nal         . end. end.
      398   if parlist-arh = "all":u or lookup ('arh-fin-doc-an-nal-obj':U,      parlist-arh) > 0 then do: for each bf_arh-fin-doc-an-nal-obj      where bf_arh-fin-doc-an-nal-obj     .host-code = parhost-code on error undo, return error return-value : delete bf_arh-fin-doc-an-nal-obj     . end. end.
      399   if parlist-arh = "all":u or lookup ('arh-fin-doc-an-obj':U,          parlist-arh) > 0 then do: for each bf_arh-fin-doc-an-obj          where bf_arh-fin-doc-an-obj         .host-code = parhost-code on error undo, return error return-value : delete bf_arh-fin-doc-an-obj         . end. end.
