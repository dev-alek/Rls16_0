        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: bf04b0e5cfa2, 2256, rls $":U.
        3   define variable vss-author      as character no-undo initial "$Author: druban $":U.
        4   define variable vss-date        as character no-undo initial "$Date: Wed Dec 25 15:24:01 2019 +0300 $":U.
        5   define variable vss-workfile    as character no-undo initial "$Workfile: updclrvs.p $":U.
        6   define variable vss-archive     as character no-undo initial "$Archive: utl/updclrvs.p $":U.
        7   define variable vss-description as character no-undo initial "Утилита запуска редактирования закрытых сверок":U.
        8   def input parameter parproc as handle.
        9   def variable par-doc-code as char.
       10   define new global shared variable g#language as character no-undo .
       11   if g#language <> '' and g#language <> 'rus':U then do:
       12     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       13   end.
       14   define new global shared variable g#library  as handle no-undo .
       15   define new global shared variable g#library2 as handle no-undo .
       16   define   shared variable g#auto as logical no-undo.
       17   define   shared variable g#news as logical no-undo.
       18   define   shared variable g#oxml as logical no-undo.
       19   define   shared variable g#esys as logical no-undo.
       20   define   shared variable g#news-source-db as integer no-undo.
       21   define   shared variable g#esys-source-esys as integer no-undo.
       22   define   shared variable g#db-num as integer   no-undo .
       23   define   shared variable g#userid as character no-undo .
       24   define   shared variable g#passwd as character no-undo .
       25   DEFINE FRAME frame1
       26     par-doc-code format "x(15)"
       27     with view-as dialog-box
       28     title "Введите номер сверки."
       29   .
       30   update par-doc-code with frame frame1.
       31     def var rvs-rec as recid.
       32     find first ub.rvs-doc exclusive-lock where ub.rvs-doc.rvs-code = par-doc-code no-error .
       33     if not available (ub.rvs-doc) then do:
       34       message "Не найдена сверка с номером: " + par-doc-code
       35       view-as alert-box.
       36     end.
       37     else do:
       38     if ub.rvs-doc.status_ <> "факт" then do :
       39         message "Данная сверка не закрыта на факт!" view-as alert-box .
       40         return .
       41     end.
       42     rvs-rec = recid(ub.rvs-doc).
       43     run utl/rvs-doc_upd.w
       44       ( input        parproc
       45        ,input        'ИЗМЕНЕНИЕ'
       46        ,input        ub.rvs-doc.rvs-type
       47        ,input        no
       48        ,input-output rvs-rec
       49       ) no-error.
       50         run str/callnews.p
       51            (input 'rvs-doc':U
       52            ,input (buffer ub.rvs-doc:handle)
       53            ) no-error .
       54         if error-status :error then do:
       55           message "Невозможно маршрутизировать rvs-doc для отправки в новости" view-as alert-box.
       56         end.
       57      release ub.rvs-doc.
       58   message 'Если Вы корректировли сменную сверку, то не забудьте, пожалуйста, перепечатать сменный отчет!' view-as alert-box warning.
       59   end.
