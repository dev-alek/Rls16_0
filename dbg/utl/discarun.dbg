      454   _dc-list:
      455   for each dc-list no-lock,
      456       first ub.dis-card no-lock where
      457             ub.dis-card.d-card = dc-list.d-card:
      458     assign
      459     num-rec = num-rec + 1
      460     dc-ri = recid(dis-card)
      461     .
      462     if pardc-type <> "":U then do:
      463       find first ub.dis-card-type no-lock where
      464                 ub.dis-card-type.type = pardc-type
      465             AND ub.dis-card-type.emitent-host-code = paremitent-host-code no-error .
      466         if not avail ub.dis-card-type then do:
      467         neXt .
      468       end.
      469     end.
      470     else do:
      471       find first dis-card-type no-lock where
      472                 dis-card-type.type = dis-card.type
      473             AND dis-card-type.emitent-host-code = dis-card.emitent-host-code no-error .
      474         if not avail dis-card-type then do:
      475         neXt .
      476       end.
      477     end.
      478     run ref/dcardi01.p (
      479                      input parparentproc
      480                     ,input p-parent-handle
      481                     ,input p-log-handle
      482                     ,input ?
      483                     ,input yes
      484                     ,input-output dc-ri
      485                     ,input 'ИЗМЕНЕНИЕ':U
      486                     ,input '':U
      487                     ,input p-curr-obj-type
      488                     ,input p-curr-obj-code
      489                     ,input dis-card.d-card
      490                     ,input (if v-do[2] then paremitent-host-code else dis-card.emitent-host-code)
      491                     ,input dis-card.cli-type
      492                     ,input dis-card.cli-code
      493                     ,input (if v-do[1] then pardc-status_ else  dis-card.status_)
      494                     ,input (if v-do[2] then pardc-type else dis-card.type)
      495                     ,input (IF v-do[4]
      496                             and (
      497                                   (
      498                                     (dis-card.d-pcnt-method = integer('1':U))
      499                                       or
      500                                     (dis-card.d-pcnt-method = integer('3':U))
      501                                   )
      502                                   OR
      503                                   (
      504                                     v-do[15] and
      505                                     (
      506                                       (pard-pcnt-method = integer('1':U))
      507                                     or
      508                                       (pard-pcnt-method = integer('3':U))
      509                                     )
      510                                   )
      511                                 )
      512                           then pard-pcnt
      513                           else dis-card.d-pcnt)
      514                     ,input (IF v-do[5]
      515                            and (
      516                                   (
      517                                      (dis-card.d-pcnt-method = integer('2':U))
      518                                        or
      519                                      (dis-card.d-pcnt-method = integer('3':U))
      520                                   )
      521                                 OR
      522                                   (
      523                                     v-do[15] and
      524                                     (
      525                                       (pard-pcnt-method = integer('2':U))
      526                                     or
      527                                       (pard-pcnt-method = integer('3':U))
      528                                     )
      529                                   )
      530                                 )
      531                           then parcash-d-pcnt
      532                           else dis-card.cash-d-pcnt)
      533                     ,input (if v-do[6]
      534                             THEN parCategory
      535                             else dis-card.category)
      536                     ,input (if v-do[15]
      537                             then integer(pard-pcnt-method)
      538                             else dis-card.d-pcnt-method)
      539                     ,input (if v-do[9]
      540                             THEN parCREDIT-CARD
      541                             else dis-card.credit-card)
      542                     ,input (if v-do[12]
      543                           then parlim-kr
      544                           else dis-card.lim-kr)
      545                     ,input (if v-do[10]
      546                             THEN pardebet-CARD
      547                             else dis-card.debet-card)
      548                     ,input (if v-do[11]
      549                             THEN parstaff-CARD
      550                             else dis-card.staff-card)
      551                     ,input (IF v-do[7]
      552                             then parissue-date
      553                             else dis-card.issue-date)
      554                     ,input (IF v-do[8]
      555                             then parissue-code
      556                             else dis-card.issue-code)
      557                     ,input (IF v-do[13]
      558                             then parvalid-from
      559                             else dis-card.valid-from)
      560                     ,input (IF v-do[14]
      561                             then parvalid-date
      562                             else dis-card.valid-date)
      563                     ,input dis-card.sourced-card
      564                     ,input (if v-do[16]
      565                             THEN parCli-message
      566                             else dis-card.cli-message)
      567                     ,input no
      568                     ,input dis-card.main-card
      569                     ,input dis-card.is-subsid
      570                     ,INPUT no
      571                     ,INPUT table tt0-dis-card-property
      572                                       ) no-error.
      573       IF ERROR-STATUS:ERROR then do:
      574           run write-log-and-file in p-log-handle (
      575                 input 1
      576               , input log-file-name
      577               , input 1
      578               , input substitute("Ошибка изменения записи дисконтной карты &1:&2&3 &4"
      579                                 , dc-list.d-card
      580                                 , chr(10)
      581                                 , error-status:get-message(1)
      582                                 , return-value
      583                                 ) ).
      584           assign
      585           v-view-log = yes.
      586       end.
      587       else do:
      588         num-rec-ok = num-rec-ok + 1.
      589       end.
      590       run show-counter in p-log-handle .
      591       run write-counter in p-log-handle (substitute("Обработано &1 из них успешно &2"
      592                                                   , num-rec
      593                                                   , num-rec-ok
      594                                                   )) no-error.
      595       run get-stop-state in p-log-handle (
      596           output v-stop
      597       ).
      598       if v-stop then do:
      599         leave _dc-list.
      600       end.
      601   end.
      602   run write-log-and-file in p-log-handle (
      603         input 1
      604       , input log-file-name
      605       , input 1
      606       , input substitute("Пакетное изменение по списку ДК завершено: из &1 записей отредактировано &2", num-rec, num-rec-ok )).
      607   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   if v-view-log
      609   and not g#news
      610   and not g#auto
      611   then do:
      612     message
      613     '!!!При изменении дисконтных карт по списку произошли ошибки!!!'  skip
      614     "!!!Внимательно прочитайте Log-file!!"
      615     view-as alert-box error .
      616        define variable v-user-action13   as character no-undo .
      617     define variable v-printed13       as logical   no-undo .
      618     run gbl/prnfilen.w
      619       (input  ('!!!При изменении дисконтных карт по списку произошли ошибки!!!')
      620       ,input  0
      621       ,input  (string("./":U) + 'discarun.txt')
      622       ,input  7
      623       ,output v-user-action13
      624       ,output v-printed13
      625       ) .
      626   end.
      627   if v-view-log = true
      628   and (g#news
      629   or g#auto)
      630   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      631   then do:
      632      run cb_set-view-log in p-parent-handle ( input yes).
      633   end.
      634   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      635     OS-DELETE value(string("./":U) + 'discarun.txt').
      636   end.
      637                           return.
