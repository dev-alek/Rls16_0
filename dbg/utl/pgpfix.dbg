        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: pgpfix.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/pgpfix.p $":U .
        7   define variable vss-description as character no-undo init "Утилита проверки и исправления конфигурации ТАНК-ТРК-МЕСТО".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define stream outstream.
       78   define variable loc#log as logical no-undo.
       79   message "ПРОВЕРКА (НЕТ) ИЛИ ИСПРАВЛЕНИЕ(ДА) ?" view-as alert-box QUESTION
       80   buttons YES-NO update loc#log.
       81   output stream outstream to pgpfix.txt.
       82   ON WRITE OF ub.pl-gds-pump OVERRIDE DO:
       83   end.
       84   ON DELETE OF ub.pl-gds-pump OVERRIDE DO:
       85   end.
       86   FIND FIRST ub.sys-ctrl NO-LOCK.
       87   _pl-pump:
       88   for each ub.pl-pump no-lock,
       89            first ub.clients no-lock where
       90                  ub.clients.obj-type = ub.pl-pump.obj-type AND
       91                  ub.clients.obj-code = ub.pl-pump.obj-code AND
       92                  ub.clients.db-num = ub.sys-ctrl.db-num:
       93       find ub.pl-gds-pump no-lock where
       94                  ub.pl-gds-pump.pl-code = ub.pl-pump.pl-code AND
       95               ub.pl-gds-pump.pump-code = ub.pl-pump.pump-code AND
       96               ub.pl-gds-pump.obj-type = ub.pl-pump.obj-type AND
       97               ub.pl-gds-pump.obj-code = ub.pl-pump.obj-code
       98               NO-ERROR.
       99       IF AMBIGUOUS ub.pl-gds-pump then do:
      100           run fixa in this-procedure
      101               (loc#log,
      102               yes,
      103               ub.pl-pump.obj-type,
      104               ub.pl-pump.obj-code,
      105               ub.pl-pump.pl-code,
      106               ub.pl-pump.pump-code) no-error.
      107         if error-status:error then do:
      108           PUT stream outstream unformatted
      109           "Объект " ub.pl-pump.obj-type ub.pl-pump.obj-code
      110           " У складского места " ub.pl-pump.pl-code  "несколько связей ТОВАР-ТРК " skip
      111           " Не удалось исправить "
      112           skip.
      113           NEXT _pl-pump.
      114         end.
      115       end.
      116       find first ub.pl-gds-pump no-lock where
      117                  ub.pl-gds-pump.pl-code = ub.pl-pump.pl-code AND
      118               ub.pl-gds-pump.pump-code = ub.pl-pump.pump-code AND
      119               ub.pl-gds-pump.obj-type = ub.pl-pump.obj-type AND
      120               ub.pl-gds-pump.obj-code = ub.pl-pump.obj-code
      121               NO-ERROR.
      122       if not avail ub.pl-gds-pump then do:
      123           run fixa in this-procedure
      124               (loc#log,
      125               no,
      126               ub.pl-pump.obj-type,
      127               ub.pl-pump.obj-code,
      128               ub.pl-pump.pl-code,
      129               ub.pl-pump.pump-code) no-error.
      130           if error-status:error then do:
      131               FIND FIRST
      132               ub.pl-gds No-LOCK WHERE
      133               ub.pl-gds.pl-code = ub.pl-pump.pl-code AND
      134               ub.pl-gds.obj-type = ub.pl-pump.obj-type AND
      135               ub.pl-gds.obj-code = ub.pl-pump.obj-code NO-ERROR.
      136               if avail ub.pl-gds then do:
      137               FIND FIRST ub.goods no-lock where
      138                          ub.goods.gds-code = ub.pl-gds.gds-code No-ERROR.
      139                   PUT stream outstream unformatted
      140                   "ub.Объект " pl-pump.obj-type ub.pl-pump.obj-code
      141                   " Не удалось связать складское место " ub.pl-pump.pl-code
      142                   " - ТРК " ub.pl-pump.pump-code " - ТОВАР " ub.pl-gds.gds-code " "
      143                   ub.goods.gds-name skip skip.
      144               end.
      145               else do:
      146                   PUT stream outstream unformatted
      147                   "Объект " ub.pl-pump.obj-type ub.pl-pump.obj-code
      148                   " Не удалось связать складское место " ub.pl-pump.pl-code
      149                   " - ТРК " ub.pl-pump.pump-code " - на складском месте нет товара"
      150                   skip skip.
      151               END.
      152           end.
      153       end.
      154   end.
      155   ON WRITE OF ub.pl-gds-pump revert.
      156   output stream Outstream close.
      157   message "Результаты работы утилиты ищите в файле pgpfix.txt"
      158   view-as alert-box.
      159   PROCEDURE fixa:
      160   DEFINE INPUT PARAMETER paction as logical no-undo.
      161   DEFINE INPUT PARAMETER psituation as logical no-undo.
      162   DEFINE INPUT PARAMETER pobj-type like ub.place.obj-type no-undo.
      163   DEFINE INPUT PARAMETER pobj-code like ub.place.obj-code no-undo.
      164   DEFINE INPUT PARAMETER ppl-code like ub.place.pl-code no-undo.
      165   DEFINE INPUT PARAMETER ppump-code like ub.pump.pump-code no-undo.
      166   define buffer b-pl-gds-pump for ub.pl-gds-pump.
      167   define buffer b-pl-gds for ub.pl-gds.
      168   CASE psituation:
      169     when yes then do:
      170       FOR EACH b-pl-gds-pump where
      171                b-pl-gds-pump.obj-type = pobj-type AND
      172                b-pl-gds-pump.obj-type = pobj-type AND
      173                b-pl-gds-pump.pl-code = ppl-code AND
      174                b-pl-gds-pump.pump-code = ppump-code:
      175         FIND FIRST b-pl-gds No-LOCK WHERE
      176                    b-pl-gds.obj-type = pobj-type AND
      177                    b-pl-gds.obj-code = pobj-code AND
      178                    b-pl-gds.pl-code = ppl-code AND
      179                    b-pl-gds.gds-code = b-pl-gds-pump.gds-code No-ERROR.
      180         if not avail b-pl-gds then do:
      181           PUT stream outstream unformatted
      182           "Объект " pobj-type pobj-code
      183           " У складского места " ppl-code  "есть несколько связей ТОВАР-ТРК " skip
      184           " из них ТОВАР " b-pl-gds-pump.gds-code " не имеет привязки к месту " SKIP
      185           skip.
      186           if paction = yes then delete b-pl-gds-pump.
      187         END.
      188         else return error.
      189       END.
      190     end.
      191     when no then do:
      192         FIND FIRST
      193         ub.pl-gds No-LOCK WHERE
      194         ub.pl-gds.pl-code = ppl-code AND
      195         ub.pl-gds.obj-type = pobj-type AND
      196         ub.pl-gds.obj-code = pobj-code NO-ERROR.
      197         if not avail ub.pl-gds then return.
      198         error-status:error = no.
      199         PUT stream outstream UNFORMATTED
      200         "Объект " pobj-type pobj-code
      201         " Cкладское место " ppl-code
      202         " - ТРК " ppump-code " - не связано с ТОВАРОМ " skip.
      203         if paction = yes then do:
      204           DO ON ERROR UNDO, return error ON STOP undo, return error:
      205             create
      206             ub.pl-gds-pump.
      207             assign
      208             ub.pl-gds-pump.obj-type = pobj-type
      209             ub.pl-gds-pump.obj-code = pobj-code
      210             ub.pl-gds-pump.pl-code = ppl-code
      211             ub.pl-gds-pump.pump-code = ppump-code
      212             ub.pl-gds-pump.gds-code = pl-gds.gds-code
      213             ub.pl-gds-pump.ps = "FIXED!!!"
      214             ub.pl-gds-pump.status_ = 'тек':U
      215           .
      216           END.
      217           PUT stream outstream UNFORMATTED
      218           "Объект " pobj-type pobj-code
      219           " Cкладское место " ub.pl-pump.pl-code
      220           " - ТРК " ub.pl-pump.pump-code " - ТОВАР " ub.pl-gds.gds-code skip.
      221         end.
      222     end.
      223   END CASE.
      224   END PROCEDURE.
