        1   block-level on error undo, throw.
        2   define input parameter l-update-free-zone     as logical no-undo .
        3   define input parameter l-update-out-zone      as logical no-undo .
        4   define input parameter l-update-archive-parts as logical no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: partini.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/partini.p $":U .
       10   define variable vss-description as character no-undo init "Инициализация партий на основании складских документов".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   if l-update-free-zone then do:
       70     for each ub.parts
       71       where ub.parts.out-code = 'free-zone':U
       72     :
       73       run process-part.
       74       process events.
       75     end.
       76   end.
       77   if l-update-out-zone then do:
       78     for each ub.parts
       79       where ub.parts.out-code = 'out-zone':U
       80     :
       81       run process-part.
       82       process events.
       83     end.
       84   end.
       85   if l-update-archive-parts then do:
       86     for each ub.parts
       87       where ub.parts.out-code <> 'free-zone':U
       88         and ub.parts.out-code <> 'out-zone':U
       89     :
       90       run process-part.
       91       process events.
       92     end.
       93   end.
       94   procedure process-part :
       95     output to process.txt append .
       96     export ub.parts .
       97     output close .
       98     if ub.parts.doc-type = 'акт':U then do:
       99       assign
      100         rsrv-free = ?
      101       .
      102       next .
      103     end.
      104     find ub.trn-doc no-lock
      105       where ub.trn-doc.doc-code = ub.parts.in-code
      106       no-error.
      107     if available trn-doc then do:
      108       assign
      109         ub.parts.doc-type  = ub.trn-doc.doc-type
      110         ub.parts.host-code = ub.trn-doc.host-code
      111         ub.parts.exch-code = ub.trn-doc.exch-code
      112         ub.parts.pay-code  = ub.trn-doc.pay-code
      113         ub.parts.supp-code = ub.trn-doc.cli-code
      114         ub.parts.supp-type = ub.trn-doc.cli-type
      115         ub.parts.VAT-type  = ub.trn-doc.VAT-type
      116         ub.parts.SLT-type  = ub.trn-doc.SLT-type
      117         ub.parts.fact-num  = ub.trn-doc.fact-num
      118         ub.parts.fact-date = ub.trn-doc.fact-date
      119         ub.parts.is-supp   = (ub.trn-doc.doc-type = 'при':U
      120                               and not ub.trn-doc.internal
      121                              )
      122       .
      123       find ub.doc-line no-lock
      124         where ub.doc-line.doc-code  = ub.parts.in-code
      125           and ub.doc-line.artic     = ub.parts.artic
      126           and ub.doc-line.prod-type = ub.parts.prod-type
      127           and ub.doc-line.prod-code = ub.parts.prod-code
      128         no-error.
      129       if available doc-line then do:
      130         assign
      131           ub.parts.VAT-pc        = ub.doc-line.VAT-pc
      132           ub.parts.SLT-pc        = ub.doc-line.SLT-pc
      133           ub.parts.cli-base-rate = ub.doc-line.cli-base-rate
      134           ub.parts.price-base    = ub.doc-line.price-base
      135           ub.parts.price-rubl    = ub.doc-line.price-rubl
      136           ub.parts.price-cli     = ub.doc-line.price-cli
      137         .
      138       end.
      139       else do:
      140         assign
      141           ub.parts.VAT-pc = 20
      142           ub.parts.SLT-pc = 0
      143           ub.parts.cli-base-rate = 1
      144         .
      145       end.
      146       if ub.parts.cli-base-rate <> 0 then do:
      147         assign
      148           ub.parts.cli-qnty  = ub.parts.qnty / ub.parts.cli-base-rate
      149         .
      150       end.
      151       if ub.trn-doc.exch-rate <> 0 then do:
      152         assign
      153           ub.parts.price-cli  = ub.parts.price-rubl
      154                               * ( ub.trn-doc.exch-scale / ub.trn-doc.exch-rate )
      155                               * ub.parts.cli-base-rate
      156         .
      157       end.
      158       else do:
      159         assign
      160           ub.parts.price-cli  = 0
      161         .
      162       end.
      163     end.
      164     else do:
      165       output to ini-part.txt append .
      166       export 'trn-doc: bad in-code ' parts.in-code recid(parts).
      167       output close .
      168     end.
      169     case parts.out-code:
      170       when 'free-zone':U or
      171       when 'out-zone':U then do:
      172         assign
      173           parts.status_   = no
      174           parts.rsrv-free =
      175          (if ub.parts.out-code = 'free-zone':U then yes else no)
      176         .
      177       end.
      178       otherwise do:
      179         find trn-doc no-lock
      180           where trn-doc.doc-code = parts.out-code
      181           no-error.
      182         if available trn-doc then do:
      183           assign
      184             parts.doc-type = trn-doc.doc-type
      185           .
      186           if trn-doc.status_ = 'факт':U then do:
      187             assign
      188               parts.fact-num  = trn-doc.fact-num
      189               parts.fact-date = trn-doc.fact-date
      190               parts.rsrv-free = ?
      191               parts.status_   = yes
      192             .
      193           end.
      194           else do:
      195             if trn-doc.internal then do:
      196             end.
      197             else do:
      198               assign
      199                 parts.rsrv-free =
      200           ( (lookup(ub.trn-doc.doc-type, 'рас,спи':U) > 0 )
      201         or (ub.trn-doc.doc-type = 'инв':U and ub.parts.fact-qnty < 0))
      202               .
      203             end.
      204           end.
      205         end.
      206         else do:
      207           output to ini-part.txt append .
      208           export 'trn-doc: bad out-code' parts.out-code recid(parts).
      209           output close .
      210           assign
      211             parts.rsrv-free = ?
      212             parts.status_   = yes
      213           .
      214         end.
      215       end.
      216     end case.
      217   end procedure.
