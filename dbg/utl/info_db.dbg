        1   DEFINE TEMP-TABLE db-area NO-UNDO LIKE ub.sys-ctrl
        2          field name-area    like _AreaStatus._AreaStatus-Areaname
        3          field num-area     AS INT
        4          field size-area    AS DEC
        5          field size-Hiwater AS DEC
        6          field size-empty   AS DEC
        7          field percent      AS char
        8          field ID-Area      like _AreaStatus._AreaStatus-Id
        9          field v-col          AS dec
       10          index pi is unique primary
       11          num-area
       12          .
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Информация о БД".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      124   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      125   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      126   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      127   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      128   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      129   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      130   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      133   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      134   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      135   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      136   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      137   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      138   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      139   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      140   DEFINE VARIABLE vDelimiter AS CHARACTER NO-UNDO INITIAL "~\".
      141   DEFINE VARIABLE vPercentFull AS DECIMAL NO-UNDO.
      142   DEFINE VARIABLE vEmptyBlocks AS DECIMAL NO-UNDO.
      143   DEFINE VARIABLE vBusyFlag AS CHARACTER NO-UNDO FORMAT "x(4)".
      144   DEFINE VARIABLE vCol  AS DECIMAL NO-UNDO.
      145   DEFINE VARIABLE SizeArea  AS DECIMAL NO-UNDO.
      146   DEFINE BUTTON b-help
      147        LABEL "Помо&щь"
      148        SIZE 10 BY 1
      149        BGCOLOR 8 .
      150   DEFINE BUTTON b-quit AUTO-END-KEY
      151        LABEL "&Выход"
      152        SIZE 10 BY 1
      153        BGCOLOR 8 .
      154   DEFINE BUTTON b-area AUTO-END-KEY
      155        LABEL "Состав"
      156        SIZE 10 BY 1 TOOLTIP "Состав области"
      157        BGCOLOR 8 .
      158   DEFINE VARIABLE ED-view AS CHARACTER
      159        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      160        SIZE 99 BY 7.75 NO-UNDO.
      161   DEFINE VARIABLE SizeAI AS DECIMAL FORMAT ">>>,>>>,>>9":U INITIAL 0
      162        LABEL "Размер AI (MB)"
      163         VIEW-AS TEXT
      164        SIZE 14 BY .67 NO-UNDO.
      165   DEFINE VARIABLE SizeBI AS DECIMAL FORMAT ">>>,>>>,>>9":U INITIAL 0
      166        LABEL "Размер BI (MB)"
      167         VIEW-AS TEXT
      168        SIZE 14 BY .67 NO-UNDO.
      169   DEFINE VARIABLE SizeDB AS DECIMAL FORMAT ">>>,>>>,>>>,>>>,>>>":U INITIAL 0
      170        LABEL "Размер БД (MB)"
      171         VIEW-AS TEXT
      172        SIZE 25 BY .67 NO-UNDO.
      173   DEFINE VARIABLE VolAI AS INTEGER FORMAT ">>,>>9":U INITIAL 0
      174        LABEL "Кол-во томов AI"
      175         VIEW-AS TEXT
      176        SIZE 9 BY .67 NO-UNDO.
      177   DEFINE VARIABLE VolArea AS INTEGER FORMAT ">>,>>9":U INITIAL 0
      178        LABEL "Кол-во областей"
      179         VIEW-AS TEXT
      180        SIZE 14 BY .67 NO-UNDO.
      181   DEFINE VARIABLE VolBI AS INTEGER FORMAT ">>,>>9":U INITIAL 0
      182        LABEL "Кол-во томов BI"
      183         VIEW-AS TEXT
      184        SIZE 9 BY .67 NO-UNDO.
      185   DEFINE QUERY br-area FOR
      186         db-area SCROLLING.
      187   DEFINE BROWSE br-area
      188     QUERY br-area NO-LOCK DISPLAY
      189         name-area COLUMN-LABEL "Имя области" WIDTH 28.38
      190         num-area COLUMN-LABEL "N" WIDTH 3.88
      191         size-area COLUMN-LABEL "Размер области (MB)" FORMAT ">>,>>>,>>>,>>>,>>>":U
      192         size-Hiwater COLUMN-LABEL "Заполнено (MB)" FORMAT ">>,>>>,>>>,>>>,>>>":U
      193         size-empty COLUMN-LABEL "Свободно (MB)" FORMAT ">>,>>>,>>>,>>>,>>>":U
      194         percent COLUMN-LABEL "Внимание"
      195       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.88 BY 9.5 ROW-HEIGHT-CHARS .63.
      196   DEFINE FRAME Dialog-Frame
      197        b-quit AT ROW 1 COL 2
      198        b-help AT ROW 1 COL 89.5 WIDGET-ID 4
      199        b-area AT ROW 4.33 COL 89 WIDGET-ID 6
      200        br-area AT ROW 5.5 COL 1
      201        ED-view AT ROW 15.75 COL 1 NO-LABEL
      202        SizeBI AT ROW 2.25 COL 60 COLON-ALIGNED
      203        VolBI AT ROW 3 COL 60 COLON-ALIGNED
      204        SizeDB AT ROW 3.5 COL 17 COLON-ALIGNED
      205        SizeAI AT ROW 3.75 COL 60 COLON-ALIGNED
      206        VolArea AT ROW 4.25 COL 17 COLON-ALIGNED
      207        VolAI AT ROW 4.5 COL 60 COLON-ALIGNED
      208        "Информация об области" VIEW-AS TEXT
      209             SIZE 38 BY .67 AT ROW 15 COL 1.5
      210        SPACE(60.74) SKIP(8.03)
      211       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      212            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      213            TITLE "Информация о базе данных"
      214            CANCEL-BUTTON b-quit.
      215   ASSIGN
      216          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      217          FRAME Dialog-Frame:HIDDEN           = TRUE.
      218   ASSIGN
      219          ED-view:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      220   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      221   DO:
      222     APPLY "END-ERROR":U TO SELF.
      223   END.
      224   ON CHOOSE OF b-area IN FRAME Dialog-Frame
      225   DO:
      226     if avail db-area then
      227       run utl/info-area.w (db-area.num-area).
      228     return no-apply.
      229   END.
      230   ON VALUE-CHANGED OF br-area IN FRAME Dialog-Frame
      231   DO:
      232     ed-view:SCREEN-VALUE = "":U.
      233     ASSIGN
      234       ed-view:SCREEN-VALUE = string("Имя файла области", "X(28)") + " ":U +
      235                              string("Размер (MB)", "X(12)") + " ":U +
      236                              string("Заполняется", "X(12)") + CHR(13) + CHR(10)
      237       .
      238     FIND _areastatus WHERE _areastatus._AreaStatus-Id = db-area.Id-Area NO-LOCK.
      239     FIND _Area WHERE _Area._Area-Num = _AreaStatus._AreaStatus-AreaNum  NO-LOCK.
      240     SizeArea = 0.
      241     FOR EACH _AreaExtent where _AreaExtent._Area-Recid = RECID(_Area)  NO-LOCK:
      242           FIND _FileList WHERE ENTRY(NUM-ENTRIES(_FileList._FileList-Name, vDelimiter),
      243                              _FileList._FileList-Name, vDelimiter)
      244                      = ENTRY(NUM-ENTRIES(_AreaExtent._Extent-Path, vDelimiter),
      245                              _AreaExtent._Extent-Path, vDelimiter)  NO-LOCK.
      246           IF _FileList-name = _AreaStatus-Lastextent THEN DO:
      247               IF  _FileList._FileList-Openmode = "BOTHIO" THEN DO:
      248                  IF _AreaStatus-Areanum = 6 THEN DO:
      249                      IF _AreaExtent._Extent-type < 32 THEN
      250                          vBusyFlag = "Последний том области, заполнен на " + STRING (
      251                       dec(_FileList._FileList-Size) * 100 / 2048000, ">>9.99"
      252                       ) + " %" .
      253                      ELSE
      254                          ASSIGN vBusyFlag = "Заполнен на " +
      255                                 STRING( ( (DEC(_AreaStatus-Hiwater) * dec(_Area._Area-blocksize) - SizeArea )  /
      256                                   dec(_FileList._FileList-Size * 1024) )
      257                                   * 100 ,  ">>9.99" ) + " %" .
      258                  END.
      259                  ELSE IF _AreaExtent._Extent-type < 32 THEN
      260                       vBusyFlag = "Последний том области, заполнен на " + STRING (
      261                         dec(_FileList._FileList-Size) * 100 / 2048000, ">>9.99"
      262                         ) + " %" .
      263                  ELSE IF _AreaExtent._Extent-type > 32 THEN
      264                       vBusyFlag = "Последний том области, заполнен на " +
      265                        STRING( ( (DEC(_AreaStatus-Hiwater) * dec(_Area._Area-blocksize) - SizeArea )  /
      266                        dec(_FileList._FileList-Size * 1024) )
      267                        * 100 ,  ">>9.99" ) + " %" .
      268               END.
      269               ELSE
      270                  ASSIGN vBusyFlag = "Заполнен на " +
      271                         STRING( ( (DEC(_AreaStatus-Hiwater) * dec(_Area._Area-blocksize) - SizeArea )  /
      272                           dec(_FileList._FileList-Size * 1024) )
      273                           * 100 ,  ">>9.99" ) + " %" .
      274           END.
      275           ELSE
      276               ASSIGN
      277                   SizeArea = SizeArea +  dec(_FileList._FileList-Size * 1024)
      278                   vBusyFlag = "".
      279     ASSIGN
      280     ed-view:SCREEN-VALUE = ed-view:SCREEN-VALUE + CHR(13) + CHR(10) +
      281                            string(_FileList._FileList-Name, "x(28)") + " " +
      282                            STRING(_FileList._FileList-Size, ">>>,>>>,>>>") + " " +
      283                            STRING(vBusyFlag, "X(55)").
      284   END.
      285   END.
      286   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      287   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      288   ON ROW-DISPLAY OF br-area IN frame Dialog-Frame
      289   DO:
      290     IF AVAIL db-area THEN DO:
      291       RUN set-row-color.
      292     END.
      293   END.
      294   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   on help of frame Dialog-Frame
      296   do:
      297     run gbl/app_help.p
      298       (input this-procedure :file-name
      299       ,input ''
      300       ,input ?
      301       ) no-error.
      302     if error-status :error then do:
      303       message
      304         "Ошибка при вызове помощи"
      305         error-status :get-message(1)
      306         view-as alert-box .
      307     end.
      308   end.
      309   run minbtn-set in this-procedure .
      310   on choose of b-help in frame Dialog-Frame
      311   do:
      312     apply "help":u to frame Dialog-Frame .
      313   end.
      314   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      315   procedure minbtn-set :
      316       do
      317           on error undo, return error return-value
      318           :
      319           define variable ii              as integer       no-undo .
      320           define variable fh              as widget-handle no-undo .
      321           define variable hh              as widget-handle no-undo .
      322           define variable v-h             as handle        extent 4 no-undo .
      323           define variable v-name-button   as character     no-undo .
      324           define variable v-help-old-x    as decimal       no-undo .
      325           define variable v-help-old-y    as decimal       no-undo .
      326           define variable v-help-old-size as decimal       no-undo .
      327           define variable v-frame-width   as decimal       no-undo .
      328           define variable jj              as integer       no-undo .
      329           do
      330               on error undo, return error
      331               :
      332               assign
      333                   v-frame-width = frame Dialog-Frame:width - 0.3
      334                   fh            = frame Dialog-Frame:first-child
      335                   hh            = fh:first-child
      336                   ii            = 1
      337                   .
      338               do while valid-handle(hh):
      339                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      340                   do:
      341                       case lc(hh:name) :
      342                           when "b-help" then
      343                               do:
      344                                   hh:load-image-up("cmp/b-help.bmp":u) .
      345                                   hh:load-image-down("cmp/b-help.bmp":u) .
      346                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      347                                   hh:TOOLTIP = "Помощь" .
      348                                   v-help-old-x = hh:column .
      349                                   v-help-old-y = hh:row    .
      350                                   v-help-old-size = hh:width .
      351                                   hh:width-chars = 2.5 .
      352                               end.
      353                           when "b-print" then
      354                               do:
      355                                   hh:load-image("cmp/b-print.bmp":u) .
      356                                   hh:TOOLTIP = "Печать" .
      357                                   v-h[ii] = hh:handle .
      358                                   ii = ii + 1 .
      359                                   hh:width-chars = 3 .
      360                               end.
      361                           when "b-history" or
      362                           when "b-hist" then
      363                               do:
      364                                   hh:load-image("cmp/b-hist.bmp":u) .
      365                                   hh:TOOLTIP = "История" .
      366                                   v-h[ii] = hh:handle .
      367                                   ii = ii + 1 .
      368                                   hh:width-chars = 3 .
      369                               end.
      370                           when "b-sch" then
      371                               do:
      372                                   hh:load-image("cmp/b-sch.bmp":u) .
      373                                   hh:TOOLTIP = "Установка Фильтра" .
      374                                   v-h[ii] = hh:handle .
      375                                   ii = ii + 1 .
      376                                   hh:width-chars = 3 .
      377                               end.
      378                           when "b-hist-user" then
      379                               do:
      380                                   hh:load-image("cmp/b-hist.bmp":u) .
      381                                   hh:TOOLTIP = "История пользователя" .
      382                                   ii = ii + 1 .
      383                               end.
      384                       end case.
      385                   end.
      386                   hh = hh:next-sibling.
      387               end.
      388               b-help:column = v-frame-width - b-help:width-chars.
      389               jj = 0.
      390               repeat ii = 4 to 1 by -1 :
      391                   if valid-handle (v-h[ii] ) then
      392                   do:
      393                       jj  = jj + 1 .
      394                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      395                       v-h[ii]:row    = v-help-old-y .
      396                   end.
      397               end.
      398           end.
      399       end.
      400   end procedure.
      401   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      402   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      403   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      404   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      405   define variable v-diasize-current-frame-width  as decimal   no-undo .
      406   define variable v-diasize-current-frame-height as decimal   no-undo .
      407   define variable v-diasize-change-size          as logical   no-undo .
      408   define variable v-diasize-resize-button        as handle    no-undo .
      409   define variable v-diasize-wndmax               as logical   no-undo .
      410   define variable v-diasize-wndstore             as logical   no-undo .
      411   define variable v-diasize-proc-name            as character no-undo .
      412   define variable v-diasize-browse-handle        as handle    no-undo .
      413   define variable v-diasize-browse-number        as integer   no-undo .
      414   define variable v-diasize-need-full-display    as logical   no-undo init false .
      415   define temp-table temp-diasize-handle no-undo
      416     field handle-value  as handle
      417     field save-position as decimal
      418     index xpk is primary unique handle-value
      419     .
      420   define temp-table temp-browse-handle no-undo
      421     field browse-type   as character
      422     field browse-number as integer
      423     field browse-handle as handle
      424     field original-size as decimal
      425     index xpk is primary unique browse-type browse-number
      426     index xie browse-type browse-handle
      427   .
      428   procedure diasize_change-height :
      429     define input  parameter p-change-value  as decimal   no-undo .
      430     define input  parameter p-move-resize   as logical   no-undo .
      431     define variable v-field-group-handle    as handle    no-undo .
      432     define variable v-object-handle         as handle    no-undo .
      433     define variable v-frame-height          as decimal   no-undo .
      434     define variable v-frame-virtual-height  as decimal   no-undo .
      435     define variable v-browse-height         as decimal   no-undo .
      436     define variable v-window-height         as decimal   no-undo .
      437     define variable v-window-virtual-height as decimal   no-undo .
      438     define variable v-change-sign           as integer   no-undo .
      439     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      440     define buffer buf_temp-browse-handle  for temp-browse-handle .
      441     if p-change-value > 0
      442     then do:
      443       if frame Dialog-Frame :height + p-change-value
      444           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      445       then do:
      446         assign
      447           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      448                           - (frame Dialog-Frame :height-chars)
      449         .
      450         if p-change-value <= 0
      451         then do:
      452           run diasize_position-resize-button in this-procedure .
      453           return .
      454         end.
      455       end.
      456     end.
      457     if p-change-value < 0
      458     then do:
      459       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      460       then do:
      461         assign
      462           p-change-value = v-diasize-orig-frame-height
      463                          - (frame Dialog-Frame :height-chars)
      464         .
      465         if p-change-value >= 0
      466         then do:
      467           run diasize_position-resize-button in this-procedure .
      468           return .
      469         end.
      470       end.
      471     end.
      472     if p-change-value >= 0
      473     then do:
      474       assign
      475         v-change-sign = 1
      476       .
      477     end.
      478     else do:
      479       assign
      480         v-change-sign = -1
      481       .
      482     end.
      483     assign
      484       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      485     .
      486     if p-change-value = 0
      487     then do:
      488       run diasize_position-resize-button in this-procedure .
      489       return .
      490     end.
      491     move_block:
      492     do
      493     on error undo move_block, retry move_block
      494     :
      495       if retry
      496       then do:
      497         do
      498         on error undo move_block, leave move_block
      499         :
      500           if p-change-value > 0
      501           then do:
      502             for each buf_temp-diasize-handle
      503             on error undo, next
      504             :
      505               assign
