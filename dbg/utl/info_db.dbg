     1147         or error-status :get-message(1) <> ""
     1148         then do:
     1149           undo move_block, retry move_block.
     1150         end.
     1151         if frame Dialog-Frame :scrollable = true
     1152         then do:
     1153           assign
     1154             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1155           no-error .
     1156           if error-status :error
     1157           or error-status :get-message(1) <> ""
     1158           then do:
     1159             undo move_block, retry move_block.
     1160           end.
     1161         end.
     1162       end.
     1163       if p-move-resize
     1164       then do:
     1165         run diasize_position-resize-button in this-procedure .
     1166       end.
     1167       if v-diasize-wndstore = true
     1168       then do:
     1169         if connected("ub") = true
     1170         then do:
     1171           define variable v-cntxt-db-num        as integer   no-undo .
     1172           define variable v-cntxt-userid        as character no-undo .
     1173           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1174                                             , OUTPUT v-cntxt-userid
     1175                                             ) .
     1176           run gbl/wndsizew.p
     1177             (input  v-cntxt-db-num
     1178             ,input  v-cntxt-userid
     1179             ,input  v-diasize-proc-name
     1180             ,input  'width':u
     1181             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1182             ) .
     1183         end.
     1184       end.
     1185     end.
     1186     assign
     1187       v-diasize-change-size = false
     1188     .
     1189   end procedure.
     1190   procedure diasize_set-width :
     1191     define input  parameter p-new-width  as decimal   no-undo .
     1192     define input  parameter p-move-resize as logical   no-undo .
     1193     do
     1194     on error undo, return error return-value
     1195     :
     1196       run diasize_change-width in this-procedure
     1197         (input  (p-new-width - frame Dialog-Frame :width)
     1198         ,input  p-move-resize
     1199         ) .
     1200     end.
     1201   end procedure.
     1202   procedure diasize_position-resize-button :
     1203     do with frame Dialog-Frame
     1204     :
     1205       hide v-diasize-resize-button .
     1206       assign
     1207         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1208                     - 1
     1209                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1210         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1211                     - 1
     1212                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1213       .
     1214       view v-diasize-resize-button .
     1215     end.
     1216   end procedure.
     1217   on alt-right anywhere
     1218   do:
     1219     run diasize_change-width in this-procedure
     1220       (input 1
     1221       ,input true
     1222       ) .
     1223     return no-apply .
     1224   end.
     1225   on alt-left anywhere
     1226   do:
     1227     run diasize_change-width in this-procedure
     1228       (input -1
     1229       ,input true
     1230       ) .
     1231     return no-apply .
     1232   end.
     1233   on alt-down anywhere
     1234   do:
     1235     run diasize_change-height in this-procedure
     1236       (input 1
     1237       ,input true
     1238       ) .
     1239     return no-apply .
     1240   end.
     1241   on alt-up anywhere
     1242   do:
     1243     run diasize_change-height in this-procedure
     1244       (input -1
     1245       ,input true
     1246       ) .
     1247     return no-apply .
     1248   end.
     1249   on alt-enter of frame Dialog-Frame
     1250   do:
     1251     run diasize_maximize in this-procedure
     1252       (input  ?
     1253       ).
     1254     return no-apply .
     1255   end.
     1256   procedure diasize_end-move :
     1257     do
     1258     on error undo, return error return-value
     1259     :
     1260       define variable v-row-delta as decimal   no-undo .
     1261       define variable v-col-delta as decimal   no-undo .
     1262       define variable v-new-row as decimal   no-undo .
     1263       define variable v-new-col as decimal   no-undo .
     1264       assign
     1265         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1266         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1267       .
     1268       assign
     1269         v-row-delta = v-new-row - frame Dialog-Frame :height
     1270         v-col-delta = v-new-col - frame Dialog-Frame :width
     1271       .
     1272       run diasize_change-height in this-procedure
     1273         (input v-row-delta
     1274         ,input true
     1275         ) .
     1276       run diasize_change-width in this-procedure
     1277         (input v-col-delta
     1278         ,input true
     1279         ) .
     1280     end.
     1281   end procedure.
     1282   procedure diasize_maximize :
     1283     define input  parameter p-action as logical   no-undo .
     1284     do
     1285     on error undo, return error return-value
     1286     :
     1287       if p-action = ?
     1288       then do:
     1289         if v-diasize-need-maximize = true
     1290         then do:
     1291           assign
     1292             p-action = true
     1293           .
     1294         end.
     1295         else do:
     1296           assign
     1297             p-action = false
     1298           .
     1299         end.
     1300       end.
     1301       if p-action = true
     1302       then do:
     1303         run diasize_change-height in this-procedure
     1304           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1305               - frame Dialog-Frame :height-chars
     1306           ,input true
     1307           ) .
     1308         run diasize_change-width in this-procedure
     1309           (input session :width-chars
     1310               - frame Dialog-Frame :width-chars
     1311           ,input true
     1312           ) .
     1313         assign
     1314           v-diasize-need-maximize = false
     1315         .
     1316       end.
     1317       else do:
     1318         run diasize_change-width in this-procedure
     1319           (input v-diasize-orig-frame-width
     1320               - frame Dialog-Frame :width-chars
     1321           ,input true
     1322           ) .
     1323         run diasize_change-height in this-procedure
     1324           (input v-diasize-orig-frame-height
     1325               - frame Dialog-Frame :height-chars
     1326           ,input true
     1327           ) .
     1328         assign
     1329           v-diasize-need-maximize = true
     1330         .
     1331       end.
     1332     end.
     1333   end procedure.
     1334   procedure diasize_restore-orig-size :
     1335     do
     1336     on error undo, return error return-value
     1337     :
     1338       assign
     1339         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1340         v-diasize-current-frame-height = frame Dialog-Frame :height
     1341       .
     1342       run diasize_set-height in this-procedure
     1343         (input  v-diasize-orig-frame-height
     1344         ,input  true
     1345         ) .
     1346       run diasize_set-width in this-procedure
     1347         (input  v-diasize-orig-frame-width
     1348         ,input  true
     1349         ) .
     1350     end.
     1351   end procedure.
     1352   procedure diasize_restore-current-size :
     1353     do
     1354     on error undo, return error return-value
     1355     :
     1356       run diasize_set-height in this-procedure
     1357         (input  v-diasize-current-frame-height
     1358         ,input  true
     1359         ) .
     1360       run diasize_set-width in this-procedure
     1361         (input  v-diasize-current-frame-width
     1362         ,input  true
     1363         ) .
     1364     end.
     1365   end procedure.
     1366   procedure diasize_set-browse-handle :
     1367     define input  parameter p-browse-handle as handle   no-undo .
     1368     define buffer buf_temp-browse-handle for temp-browse-handle .
     1369     do
     1370     on error undo, return error return-value
     1371     :
     1372       assign
     1373         v-diasize-browse-handle = p-browse-handle
     1374       .
     1375       for each buf_temp-browse-handle
     1376       on error undo, return error return-value
     1377       :
     1378         delete buf_temp-browse-handle .
     1379       end.
     1380     end.
     1381   end procedure.
     1382   procedure diasize_add_browse :
     1383     define input  parameter p-browse-type   as character no-undo .
     1384     define input  parameter p-browse-handle as handle    no-undo .
     1385     define buffer buf_temp-browse-handle for temp-browse-handle .
     1386     do
     1387     on error undo, return error return-value
     1388     :
     1389       assign
     1390         v-diasize-browse-number = v-diasize-browse-number + 1
     1391       .
     1392       create buf_temp-browse-handle .
     1393       assign
     1394         buf_temp-browse-handle.browse-type   = p-browse-type
     1395         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1396         buf_temp-browse-handle.browse-handle = p-browse-handle
     1397       .
     1398     end.
     1399   end procedure.
     1400   procedure diasize_init :
     1401     define variable v-default-value    as logical   no-undo .
     1402     define variable v-restore-saved    as logical   no-undo .
     1403     define variable v-resize-value-str as character no-undo .
     1404     do
     1405     on error undo, return error return-value
     1406     :
     1407       do with frame Dialog-Frame
     1408       :
     1409         assign
     1410           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1411           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1412           v-diasize-browse-handle     = browse br-area :handle
     1413         .
     1414         create button v-diasize-resize-button
     1415         assign
     1416           parent        = frame Dialog-Frame :first-child
     1417           label         = "s"
     1418           height-pixels = 16
     1419           width-pixels  = 16
     1420           visible       = true
     1421           sensitive     = true
     1422           movable       = true
     1423           triggers:
     1424             on end-move persistent run diasize_end-move in this-procedure .
     1425           end triggers.
     1426         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1427         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1428         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1429         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1430         assign
     1431           v-diasize-wndmax = false
     1432         .
     1433         if connected("ub") = true
     1434         then do:
     1435           define variable v-cntxt-db-num        as integer   no-undo .
     1436           define variable v-cntxt-userid        as character no-undo .
     1437           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1438                                             , OUTPUT v-cntxt-userid
     1439                                             ) .
     1440           run gbl/wndpar_r.p
     1441             (input  v-cntxt-db-num
     1442             ,input  v-cntxt-userid
     1443             ,input  'wndmax':U
     1444             ,output v-diasize-wndmax
     1445             ,output v-default-value
     1446             ) .
     1447         end.
     1448         assign
     1449           v-diasize-wndstore = false
     1450         .
     1451         if connected("ub") = true
     1452         then do:
     1453           run gbl/wndpar_r.p
     1454             (input  v-cntxt-db-num
     1455             ,input  v-cntxt-userid
     1456             ,input  'wndstore':U
     1457             ,output v-diasize-wndstore
     1458             ,output v-default-value
     1459             ) .
     1460         end.
     1461         assign
     1462           v-diasize-proc-name = entry(1, program-name(2), '.')
     1463         .
     1464         if v-diasize-wndstore = true
     1465         then do:
     1466           assign
     1467             v-restore-saved = false
     1468           .
     1469           if connected("ub") = true
     1470           then do:
     1471             run gbl/wndsizer.p
     1472               (input  v-cntxt-db-num
     1473               ,input  v-cntxt-userid
     1474               ,input  v-diasize-proc-name
     1475               ,input  'height':u
     1476               ,output v-resize-value-str
     1477               ) .
     1478             if v-resize-value-str <> '':U
     1479             then do:
     1480               run diasize_change-height in this-procedure
     1481                 (input  integer(v-resize-value-str)
     1482                 ,input  true
     1483                 ) .
     1484               assign
     1485                 v-restore-saved = true
     1486               .
     1487             end.
     1488           end.
     1489           if connected("ub") = true
     1490           then do:
     1491             run gbl/wndsizer.p
     1492               (input  v-cntxt-db-num
     1493               ,input  v-cntxt-userid
     1494               ,input  v-diasize-proc-name
     1495               ,input  'width':u
     1496               ,output v-resize-value-str
     1497               ) .
     1498             if v-resize-value-str <> '':U
     1499             then do:
     1500               run diasize_change-width in this-procedure
     1501                 (input  integer(v-resize-value-str)
     1502                 ,input  true
     1503                 ) .
     1504               assign
     1505                 v-restore-saved = true
     1506               .
     1507             end.
     1508           end.
     1509           if v-restore-saved <> true
     1510           then do:
     1511             if v-diasize-wndmax = true
     1512             then do:
     1513               run diasize_maximize in this-procedure
     1514                 (input  true
     1515                 ) .
     1516             end.
     1517           end.
     1518         end.
     1519         else do:
     1520           if v-diasize-wndmax = true
     1521           then do:
     1522             run diasize_maximize in this-procedure
     1523               (input  true
     1524               ) .
     1525           end.
     1526         end.
     1527       end.
     1528     end.
     1529   end procedure.
     1530   procedure diasize_need-full-display :
     1531     define output parameter p-need-full-display as logical   no-undo .
     1532     do
     1533     on error undo, return error return-value
     1534     :
     1535       assign
     1536         p-need-full-display = v-diasize-need-full-display
     1537       .
     1538       assign
     1539         v-diasize-need-full-display = false
     1540       .
     1541     end.
     1542   end procedure.
     1543   procedure get-context :
     1544      define output parameter p-db-num as integer          no-undo.
     1545      define output parameter p-user-id as character        no-undo.
     1546      define variable v-login               as character    no-undo.
     1547      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1548      define buffer buf_user-login  for ub.user-login .
     1549      do
     1550      on error undo, return error
     1551      :
     1552            FIND FIRST buf_sys-ctrl no-lock.
     1553            ASSIGN
     1554               v-login = USERID("ub")
     1555               p-db-num = buf_sys-ctrl.db-num
     1556            .
     1557            FIND FIRST buf_user-login
     1558                 WHERE buf_user-login.db-num = p-db-num
     1559                   AND buf_user-login.user-login = v-login
     1560                 no-lock
     1561                 no-error
     1562                 .
     1563            IF AVAILABLE buf_user-login
     1564            THEN DO:
     1565               assign
     1566                  p-user-id = buf_user-login.user-id
     1567               .
     1568            END.
     1569      end.
     1570   end procedure.
     1571       run diasize_init in this-procedure .
     1572   MAIN-BLOCK:
     1573   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1574      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1575     FOR EACH _areastatus NO-LOCK:
     1576         vEmptyBlocks = _AreaStatus-Totblocks - _AreaStatus-Hiwater.
     1577         vPercentFull = (1 - (vEmptyBlocks / _AreaStatus-Totblocks)) * 100.
     1578         FIND _Area WHERE _Area._Area-Num = _AreaStatus._AreaStatus-AreaNum  NO-LOCK.
     1579         ASSIGN
     1580             SizeDB = SizeDB + ( DEC (_AreaStatus._AreaStatus-Totblocks) * DEC( _Area._Area-blocksize)) / 1024.
     1581         IF _AreaStatus._AreaStatus-Areanum = 1 THEN NEXT.
     1582         IF _AreaStatus._AreaStatus-Areaname  BEGINS "Primary Recovery" THEN do:
     1583             ASSIGN
     1584               SizeBI = SizeBI + ( DEC (_AreaStatus._AreaStatus-Totblocks) * DEC( _Area._Area-blocksize)) / 1024
     1585               VolBI = VolBI + 1.
     1586             NEXT.
     1587         END.
     1588         IF _AreaStatus._AreaStatus-Areaname  BEGINS "After Image" THEN do:
     1589             ASSIGN
     1590               SizeAI = SizeAI + ( DEC (_AreaStatus._AreaStatus-Totblocks) * DEC( _Area._Area-blocksize)) / 1024
     1591               VolAI = VolAI + 1.
     1592             NEXT.
     1593         END.
     1594         vCol = 0.
     1595         FOR EACH _AreaExtent where _AreaExtent._Area-Recid = RECID(_Area)  NO-LOCK:
     1596             FIND _FileList WHERE ENTRY(NUM-ENTRIES(_FileList._FileList-Name, vDelimiter),
     1597                               _FileList._FileList-Name, vDelimiter)
     1598                       = ENTRY(NUM-ENTRIES(_AreaExtent._Extent-Path, vDelimiter),
     1599                               _AreaExtent._Extent-Path, vDelimiter)  NO-LOCK.
     1600             IF _FileList-name = _AreaStatus-Lastextent THEN DO:
     1601               IF _AreaStatus-Areanum = 6 THEN DO:
     1602                   IF _AreaExtent._Extent-type < 32 THEN
     1603                     vCol = (dec(_FileList._FileList-Size) * 100 / 2048000) .
     1604                 END.
     1605               ELSE
     1606                 IF  _FileList._FileList-Openmode = "BOTHIO"  THEN
     1607                     vCol = (dec(_FileList._FileList-Size) * 100 / 2048000) .
     1608             END.
     1609         END.
     1610         VolArea = VolArea + 1.
     1611         CREATE db-area.
     1612         ASSIGN
     1613             name-area    = _AreaStatus._AreaStatus-Areaname
     1614             num-area     = _AreaStatus._AreaStatus-Areanum
     1615             size-area    = DEC (DEC (_AreaStatus._AreaStatus-Totblocks) * DEC( _Area._Area-blocksize)) / 1024
     1616             size-Hiwater = DEC (( DEC(_AreaStatus._AreaStatus-Hiwater)) * DEC (_Area._Area-blocksize)) / 1024
     1617             size-empty   = (vEmptyBlocks  * _Area._Area-blocksize) / 1024
     1618             Id-Area      = _AreaStatus._AreaStatus-Id
     1619             v-Col = vCol.
     1620     END.
     1621     RUN enable_UI.
     1622     apply "VALUE-CHANGED":U TO br-area.
     1623     WAIT-FOR GO OF FRAME Dialog-Frame.
     1624   END.
     1625   RUN disable_UI.
     1626   PROCEDURE carring-obj :
     1627   END PROCEDURE.
     1628   PROCEDURE check-qnty :
     1629   END PROCEDURE.
     1630   PROCEDURE disable_UI :
     1631     HIDE FRAME Dialog-Frame.
     1632   END PROCEDURE.
     1633   PROCEDURE enable_UI :
     1634     DISPLAY ED-view SizeBI VolBI SizeDB SizeAI VolArea VolAI
     1635         WITH FRAME Dialog-Frame.
     1636     ENABLE b-quit b-help b-area br-area ED-view
     1637         WITH FRAME Dialog-Frame.
     1638     VIEW FRAME Dialog-Frame.
     1639     OPEN QUERY br-area FOR EACH db-area NO-LOCK.
     1640   END PROCEDURE.
     1641   PROCEDURE set-row-color :
     1642     define variable iFGColor AS INTEGER NO-UNDO.
     1643     define variable iBGColor AS INTEGER NO-UNDO.
     1644         IF db-area.v-Col > 80 THEN
     1645            ASSIGN
     1646              iFGColor = WHITE_COLOR
     1647              iBGColor =  RED_COLOR
     1648            .
     1649         ELSE IF db-area.v-Col > 50 THEN
     1650            ASSIGN
     1651              iFGColor = WHITE_COLOR
     1652              iBGColor =  YELLOW_COLOR
     1653            .
     1654         ELSE
     1655             ASSIGN
     1656               iFGColor = Black_COLOR
     1657               iBGColor = White_COLOR
     1658             .
     1659       ASSIGN
     1660         db-area.percent:FGCOLOR IN BROWSE br-area = iFGColor
     1661         db-area.percent:BGCOLOR IN BROWSE br-area = iBGColor
     1662       .
     1663   END PROCEDURE.
