        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: crmhinc.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/crmhinc.p $":U .
        9   define variable vss-description as character no-undo init "Утилита по коррекции НДС по внешним приходным накладным межфирменного перемещени ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define buffer bf_db           for ub.db.
       69   define buffer bf_trn-doc      for ub.trn-doc.
       70   define buffer bf_doc-line     for ub.doc-line.
       71   define buffer bf_parts        for ub.parts.
       72   define buffer bf-cur_sysconf  for ub.sysconf.
       73   define buffer bf-cur_trn-doc  for ub.trn-doc.
       74   define buffer bf-cur_doc-line for ub.doc-line.
       75   do transaction
       76   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       77     find first bf_db where bf_db.db-num > 0 no-lock no-error.
       78     if available bf_db then do:
       79       return error "Данная утилита не работает в системе с удаленными базами данных.".
       80     end.
       81     find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code exclusive-lock no-error.
       82     if not available bf_trn-doc then do:
       83       return error substitute ("Не найден документ с номером &1.", pardoc-code).
       84     end.
       85     if bf_trn-doc.ext-doc-type <> 'ie':U then do:
       86       return error substitute ("Документ &1 не является документом внешнего прихода.", bf_trn-doc.doc-code).
       87     end.
       88     if bf_trn-doc.hold-doc-code-parent = "" then do:
       89       return error substitute ("Документ &1 не является документом межфирменного перемещения.", bf_trn-doc.doc-code).
       90     end.
       91     find first bf-cur_trn-doc where bf-cur_trn-doc.doc-code = bf_trn-doc.hold-doc-code-parent no-lock no-error.
       92     if not available bf-cur_trn-doc then do:
       93       return error substitute ("Не найден родительский документ внешнего межфирменного расхода &1.", bf_trn-doc.hold-doc-code-parent).
       94     end.
       95     find first bf-cur_sysconf where bf-cur_sysconf.host-code = bf-cur_trn-doc.host-code no-lock no-error.
       96     if bf-cur_trn-doc.pay-code = bf-cur_sysconf.cash-pay then do:
       97       assign
       98         bf_trn-doc.slt-type = 'в т. ч.':U.
       99     end.
      100     else do:
      101       assign
      102         bf_trn-doc.slt-type = 'без':U.
      103     end.
      104     for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      105       find first bf-cur_doc-line where bf-cur_doc-line.doc-code  = bf-cur_trn-doc.doc-code and
      106                                        bf-cur_doc-line.artic     = bf_doc-line.artic       and
      107                                        bf-cur_doc-line.prod-type = bf_doc-line.prod-type   and
      108                                        bf-cur_doc-line.prod-code = bf_doc-line.prod-code   no-lock no-error.
      109       if not available bf-cur_doc-line then do:
      110         return error substitute ("Не найдена линия по товару &1 &2 &3 в документе &4",
      111                                  bf_doc-line.artic        ,
      112                                  bf_doc-line.prod-type    ,
      113                                  bf_doc-line.prod-code    ,
      114                                  bf-cur_trn-doc.doc-code).
      115       end.
      116       assign
      117         bf_doc-line.vat-pc = bf-cur_doc-line.vat-pc.
      118       if bf_trn-doc.slt-type = 'в т. ч.':U then do:
      119         assign
      120           bf_doc-line.slt-pc = bf-cur_doc-line.slt-pc.
      121       end.
      122       else do:
      123         assign
      124           bf_doc-line.slt-pc = 0.
      125       end.
      126       for each bf_parts where bf_parts.out-code  = bf_doc-line.doc-code  and
      127                               bf_parts.obj-type  = bf_trn-doc.obj-type   and
      128                               bf_parts.obj-code  = bf_trn-doc.obj-code   and
      129                               bf_parts.artic     = bf_doc-line.artic     and
      130                               bf_parts.prod-type = bf_doc-line.prod-type and
      131                               bf_parts.prod-code = bf_doc-line.prod-code on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      132         run utl/partbase.p (
      133             parparentproc,
      134             bf_parts.artic,
      135             bf_parts.prod-type,
      136             bf_parts.prod-code,
      137             bf_parts.in-code,
      138             bf_parts.part-code,
      139             bf_parts.price-base,
      140             bf_parts.price-rubl,
      141             bf_doc-line.vat-pc,
      142             bf_doc-line.slt-pc  ) no-error.
      143         if error-status:error then do:
      144           return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
      145         end.
      146       end.
      147     end.
      148   end.
