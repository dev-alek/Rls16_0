      563   define new global shared variable g#library  as handle no-undo .
      564   define new global shared variable g#library2 as handle no-undo .
      565   define variable var-report-r-b as character no-undo .
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   define frame a.
      571   define buffer a-price-list for price-list.
      572   define buffer a-doc-line for doc-line.
      573   define variable  p-d-n like    price-doc.doc-num no-undo.
      574   define variable g#ok as logical no-undo .
      575   message "Эта утилита проверяет наличие налогов в переоценке и при отсутствии их ,"
      576            "проставляет ставки налогов на конец дня , когда документ был закрыт ."
      577           skip  "Будем запускать утилиту ? "
      578           view-as alert-box question
      579           button yes-no
      580           update g#ok
      581           .
      582   if g#ok = false then return.
      583   view frame a.
      584   define stream errstream.
      585   define stream liststream.
      586   define variable p-date as date no-undo .
      587   define variable p-hostcode as integer no-undo .
      588   define variable local_vat-pc as decimal no-undo .
      589   define variable local_slt-pc as decimal no-undo .
      590   define buffer buf-goods  for goods.
      591   define variable f-o-1 as decimal no-undo .
      592   define variable f-o-2 as decimal no-undo .
      593   define variable err-file as character no-undo .
      594   define variable list-file as character no-undo .
      595   define variable l-err as integer no-undo .
      596   define variable l-all as integer no-undo .
      597   define variable l-chg as integer no-undo .
      598   l-err = 0 .
      599   l-all = 0 .
      600   l-chg = 0 .
      601   err-file  =  session:temp-directory + "prlist.err"  .
      602   list-file =  session:temp-directory + "prlist.lst"  .
      603   OUTPUT STREAM errstream TO VALUE(err-file).
      604   OUTPUT STREAM liststream TO VALUE(list-file).
      605   run factord-end-day (
      606      input   x-date-start - 1 ,
      607      output  f-o-1      )  .
      608   run factord-end-day (
      609      input   x-date-end ,
      610      output  f-o-2      )  .
      611    for each obj-list :
      612                 for each a-price-list  exclusive-lock  where
      613                                                 a-price-list.obj-code = obj-list.obj-code  and
      614                                                 a-price-list.obj-type = obj-list.obj-type  and
      615                                                 a-price-list.fact-order >= f-o-1 and
      616                                                 a-price-list.fact-order <= f-o-2 and
      617                                               (( a-price-list.vat-pc = ?  or  a-price-list.slt-pc = ? )
      618                                               ) :
      619                   find first buf-goods no-lock where
      620                             a-price-list.artic      = buf-goods.artic and
      621                             a-price-list.prod-type  = buf-goods.prod-type and
      622                             a-price-list.prod-code  = buf-goods.prod-code  no-error .
      623                          if error-status :error then do:
      624                                   put STREAM errstream  "Не удается найти товар "
      625                                   a-price-list.artic
      626                                   a-price-list.prod-type
      627                                   a-price-list.prod-code
      628                                   a-price-list.doc-num
      629                                   a-price-list.obj-type
      630                                   a-price-list.obj-code
      631                                   skip.
      632                             next.
      633                           end.
      634                     run factord-to-date  (
      635                       input  a-price-list.fact-order ,
      636                       output p-date        ).
      637   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      638   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      639     (input  a-price-list.obj-type
      640     ,input  a-price-list.obj-code
      641     ,output p-hostcode
      642     ) no-error .
      643                 if error-status :error then
      644                   put STREAM errstream  "Не удается определить host-code "
      645                   a-price-list.doc-num
      646                   a-price-list.obj-type
      647                   a-price-list.obj-code   skip.
      648   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      650     (input  buf-goods.gds-code
      651     ,input  '1':U
      652     ,input  p-date
      653     ,input  p-hostcode
      654     ,input  a-price-list.obj-type
      655     ,input  a-price-list.obj-code
      656     ,output local_vat-pc
      657     ) no-error .
      658                   if error-status :error then do:
      659                     local_vat-pc = ?.
      660                     put STREAM errstream  "Не удается определить налог "
      661                     '1':U
      662                     buf-goods.gds-code
      663                     a-price-list.doc-num
      664                     a-price-list.obj-type
      665                     a-price-list.obj-code
      666                     skip.
      667                   end.
      668   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      670     (input  buf-goods.gds-code
      671     ,input  '2':U
      672     ,input  p-date
      673     ,input  p-hostcode
      674     ,input  a-price-list.obj-type
      675     ,input  a-price-list.obj-code
      676     ,output local_slt-pc
      677     ) no-error .
      678                   if error-status :error then do:
      679                       local_slt-pc = ?.
      680                     put STREAM errstream  "Не удается определить налог "
      681                     '2':U
      682                     buf-goods.gds-code
      683                     a-price-list.doc-num
      684                     a-price-list.obj-type
      685                     a-price-list.obj-code
      686                     skip.
      687                   end.
      688                   if local_vat-pc <> ? and local_slt-pc <> ? then do:
      689                             assign
      690                                   a-price-list.vat-pc    = local_vat-pc
      691                                   a-price-list.slt-pc    = local_slt-pc
      692                                   l-chg = l-chg  + 1.
      693                             .
      694                           export STREAM liststream
      695                               a-price-list.obj-code
      696                               a-price-list.obj-type
      697                               buf-goods.gds-code
      698                               a-price-list.fact-order
      699                               a-price-list.vat-pc
      700                               a-price-list.slt-pc
      701                               .
      702                   end.
      703                   l-all = l-all  + 1.
      704                                 if (local_vat-pc = ? and   local_slt-pc = ? )  then do:
      705                                   l-err = l-err  + 1.
      706                                   export STREAM errstream
      707                                       a-price-list.obj-code
      708                                       a-price-list.obj-type
      709                                       buf-goods.gds-code
      710                                       a-price-list.fact-order
      711                                       local_vat-pc
      712                                       local_slt-pc
      713                                       .
      714                                 end.
      715                 end.
      716   end.
      717   message "Обработано : " l-all Skip
      718           "Исправлено : " l-chg  skip
      719           "Ошибки     : " l-err skip
      720           "Список исправлений в файле "  list-file skip
      721           "Список ошибок в файле " err-file skip
      722           view-as alert-box .
      723   OUTPUT STREAM errstream CLOSE .
      724   OUTPUT STREAM liststream CLOSE .
      725   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      726   procedure factord :
      727     define input  parameter p-fact-date            as date    no-undo .
      728     define input  parameter p-fact-time            as integer no-undo .
      729     define input  parameter p-fact-num             as integer no-undo .
      730     define input  parameter p-shift-date           as date    no-undo .
      731     define input  parameter p-shift-num            as integer no-undo .
      732     define input  parameter p-shift-on             as logical no-undo .
      733     define output parameter p-fact-order           as decimal no-undo .
      734     define output parameter p-shift-end-fact-order as decimal no-undo .
      735     define output parameter p-day-end-fact-order   as decimal no-undo .
      736     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      737     if p-fact-date = ?
      738     then do:
      739       return error "Не указана фактическая дата" .
      740     end.
      741     define variable v-fact-date-num as integer no-undo .
      742     assign
      743       v-fact-date-num = integer(p-fact-date)
      744     .
      745     if p-fact-num = ?
      746     or p-fact-num = 0
      747     then do:
      748       return error "Не задан p-fact-num " + string(p-fact-num) .
      749     end.
      750     if p-fact-num < 0
      751     then do:
      752       return error "Отрицательный fact-num " + string(p-fact-num) .
      753     end.
      754     if p-fact-num >= 100000000
      755     then do:
      756       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      757     end.
      758     if p-shift-on = true
      759     then do:
      760       if p-shift-date = ?
      761       then do:
      762         return error "Не задана дата смены" .
      763       end.
      764       if p-shift-num = ?
      765       or p-shift-num = 0
      766       then do:
      767         return error "Не задан номер смены" .
      768       end.
      769     end.
      770     else do:
      771       assign
      772         p-shift-date = p-fact-date
      773         p-shift-num  = 24
      774       .
      775     end.
      776     define variable v-shift-offset as integer no-undo .
      777     if p-shift-date = p-fact-date
      778     then do:
      779       assign
      780         v-shift-offset = 1
      781       .
      782     end.
      783     if p-shift-date < p-fact-date
      784     then do:
      785       assign
      786         v-shift-offset = 0
      787       .
      788     end.
      789     if p-shift-date > p-fact-date
      790     then do:
      791       message
      792         vss-workfile vss-revision vss-description skip
      793         "Неправильная дата закрытия смены" skip
      794         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      795         view-as alert-box error .
      796       undo, return error
      797         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      798           ,string(p-fact-date, '99/99/9999':U)
      799           ,string(p-shift-date, '99/99/9999':U)
      800           )
      801       .
      802     end.
      803     if p-shift-num < 1
      804     or p-shift-num > 24
      805     then do:
      806       message
      807         vss-workfile vss-revision vss-description skip
      808         "Неправильный номер смены" skip
      809         "p-shift-num" p-shift-num skip
      810         view-as alert-box error .
      811       undo, return error return-value .
      812     end.
      813     assign
      814       p-fact-order           = v-fact-date-num
      815                              + v-shift-offset * 0.5
      816                              + p-shift-num    * 0.02 - 0.01
      817                              + p-fact-num     * 0.0000000001
      818       p-shift-end-fact-order = v-fact-date-num
      819                              + v-shift-offset * 0.5
      820                              + p-shift-num    * 0.02
      821       p-day-end-fact-order   = v-fact-date-num
      822                              + 0.99
      823     .
      824     if p-fact-order           <= v-fact-date-num
      825     or p-shift-end-fact-order <= v-fact-date-num
      826     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      827     or p-shift-end-fact-order >= p-day-end-fact-order
      828     then do:
      829       message
      830         vss-workfile vss-revision vss-description skip
      831         "Внутренняя ошибка при генерации фактического номера" skip
      832         "p-fact-date"            p-fact-date            skip
      833         "p-fact-time"            p-fact-time            skip
      834         "p-fact-num"             p-fact-num             skip
      835         "p-shift-date"           p-shift-date           skip
      836         "p-shift-num"            p-shift-num            skip
      837         "p-shift-on"             p-shift-on             skip
      838         "p-shift-end-fact-order" p-shift-end-fact-order skip
      839         "p-day-end-fact-order"   p-day-end-fact-order   skip
      840         "v-fact-date-num"        v-fact-date-num        skip
      841         view-as alert-box error .
      842       undo, return error return-value .
      843     end.
      844   end procedure.
      845   procedure day-begin-fact-order :
      846     define input  parameter p-fact-date            as date    no-undo .
      847     define output parameter p-day-begin-fact-order as decimal no-undo .
      848     do
      849     on error undo, return error return-value
      850     :
      851       if p-fact-date = ?
      852       then do:
      853         assign
      854           p-day-begin-fact-order = 0
      855         .
      856       end.
      857       else do:
      858         assign
      859           p-day-begin-fact-order = integer(p-fact-date)
      860         .
      861       end.
      862     end.
      863   end procedure.
      864   procedure factord-max-fact-order :
      865     define output parameter p-max-fact-order as decimal   no-undo .
      866     do
      867     on error undo, return error return-value
      868     :
      869       run day-begin-fact-order in this-procedure
      870         (input  date(1, 1, 5000)
      871         ,output p-max-fact-order
      872         ) .
      873     end.
      874   end procedure.
      875   procedure factord-cut-archive :
      876     define input  parameter p-obj-type             as character no-undo .
      877     define input  parameter p-obj-code             as integer   no-undo .
      878     define input  parameter p-fact-date            as date      no-undo .
      879     define output parameter p-shift-on             as logical   no-undo .
      880     define output parameter p-shift-date           as date      no-undo .
      881     define output parameter p-shift-num            as integer   no-undo .
      882     define output parameter p-day-end-fact-order   as decimal   no-undo .
      883     define output parameter p-shift-end-fact-order as decimal   no-undo .
      884     define variable v-fact-order as decimal   no-undo .
      885     define buffer buf_shift-obj for ub.shift-obj .
      886     do
      887     on error undo, return error return-value
      888     :
      889   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      891     (input  p-obj-type
      892     ,input  p-obj-code
      893     ,input  'shift-on=request'
      894     ,output p-shift-on
      895     ) no-error .
      896       if error-status :error
      897       then do:
      898         message
      899           vss-workfile vss-revision vss-description skip
      900           "Ошибка при определении атрибута объекта" skip
      901           "Объект" p-obj-type p-obj-code skip
      902           error-status :get-message(1) skip
      903           return-value skip
      904           view-as alert-box error .
      905         undo, return error return-value .
      906       end.
      907       if p-shift-on = false
      908       then do:
      909         assign
      910           p-shift-date               = ?
      911           p-shift-num                = 0
      912         .
      913       end.
      914       else do:
      915         find first buf_shift-obj share-lock
      916           where buf_shift-obj.obj-type   = p-obj-type
      917             and buf_shift-obj.obj-code   = p-obj-code
      918             and buf_shift-obj.shift-date > p-fact-date
      919           use-index pi
      920           no-error .
      921         if not available buf_shift-obj
      922         or buf_shift-obj.status_ <> 'зкр':U
      923         then do:
      924           message
      925             vss-workfile vss-revision vss-description skip
      926             "Невозможно вычислить последнюю смену" skip
      927             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      928             "Объект" p-obj-type p-obj-code skip
      929             "Дата" p-fact-date skip
      930             view-as alert-box error .
      931           undo, return error return-value .
      932         end.
      933         find last buf_shift-obj share-lock
      934           where buf_shift-obj.obj-type = p-obj-type
      935             and buf_shift-obj.obj-code = p-obj-code
      936             and buf_shift-obj.shift-date <= p-fact-date
      937           use-index pi
      938           no-error .
      939         if available buf_shift-obj
      940         then do:
      941           if  buf_shift-obj.status_ = 'зкр':U
      942           then do:
      943             assign
      944               p-shift-date = buf_shift-obj.shift-date
      945               p-shift-num  = buf_shift-obj.shift-num
      946             .
      947           end.
      948           else do:
      949             message
      950               vss-workfile vss-revision vss-description skip
      951               "Невозможно вычислить последнюю смену" skip
      952               "Статус смены отличен от статуса" 'зкр':U skip
      953               "Объект" p-obj-type p-obj-code skip
      954               "Дата" p-fact-date skip
      955               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      956               view-as alert-box error .
      957             undo, return error return-value .
      958           end.
      959         end.
      960         else do:
      961           assign
      962             p-shift-date = p-fact-date - 1
      963             p-shift-num  = 1
      964           .
      965         end.
      966       end.
      967       run factord in this-procedure
      968         (input  p-fact-date
      969         ,input  1
      970         ,input  1
      971         ,input  p-shift-date
      972         ,input  p-shift-num
      973         ,input  p-shift-on
      974         ,output v-fact-order
      975         ,output p-shift-end-fact-order
      976         ,output p-day-end-fact-order
      977         ) no-error .
      978       if error-status :error
      979       then do:
      980         message
      981           vss-workfile vss-revision vss-description skip
      982           "Ошибка при вызове процедуры factord"
      983           error-status :get-message(1) skip
      984           return-value skip
      985           view-as alert-box error .
      986         undo, return error return-value .
      987       end.
      988     end.
      989   end procedure.
      990   procedure factord-lock-shift :
      991     define input  parameter p-obj-type  as character no-undo .
      992     define input  parameter p-obj-code  as integer   no-undo .
      993     define input  parameter p-fact-date as date      no-undo .
      994     define parameter buffer buf_shift-obj for ub.shift-obj .
      995     define variable v-shift-on      as logical   no-undo .
      996     define variable v-extra-message as character no-undo .
      997     define variable v-error as character no-undo .
      998     do
      999     on error undo, return error return-value
     1000     :
     1001   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1003     (input  p-obj-type
     1004     ,input  p-obj-code
     1005     ,input  'shift-on=request'
     1006     ,output v-shift-on
     1007     ) no-error .
     1008       if error-status :error
     1009       then do:
     1010         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1011         undo, return error v-error .
     1012       end.
     1013       if v-shift-on = true
     1014       then do:
     1015         find first buf_shift-obj share-lock
     1016           where buf_shift-obj.obj-type   = p-obj-type
     1017             and buf_shift-obj.obj-code   = p-obj-code
     1018             and buf_shift-obj.shift-date > p-fact-date
     1019           use-index pi
     1020           no-error .
     1021         if not available buf_shift-obj
     1022         or buf_shift-obj.status_ <> 'зкр':U
     1023         then do:
     1024           find last buf_shift-obj
     1025             where buf_shift-obj.obj-type = p-obj-type
     1026               and buf_shift-obj.obj-code = p-obj-code
     1027               and buf_shift-obj.status_  = 'зкр':U
     1028             use-index stts
     1029             no-error .
     1030           if available buf_shift-obj
     1031           then do:
     1032             assign
     1033               v-extra-message =
     1034                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1035                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1036                               )
     1037             .
     1038           end.
     1039           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1040           undo, return error v-error .
     1041         end.
     1042       end.
     1043     end.
     1044   end procedure.
     1045   procedure factord-end-day :
     1046     define input  parameter p-fact-date            as date    no-undo .
     1047     define output parameter p-day-end-fact-order   as decimal no-undo .
     1048     do
     1049     on error undo, return error return-value
     1050     :
     1051       if p-fact-date = ?
     1052       then do:
     1053         return error "Не указана фактическая дата" .
     1054       end.
     1055       assign
     1056         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1057       .
     1058     end.
     1059   end procedure.
     1060   procedure factord-to-date :
     1061     define input  parameter p-fact-order as decimal no-undo .
     1062     define output parameter p-fact-date  as date    no-undo .
     1063     define variable v-ref-date  as date      no-undo .
     1064     define variable v-ref-delta as integer   no-undo .
     1065     do
     1066     on error undo, return error return-value
     1067     :
     1068       if p-fact-order = ?
     1069       or p-fact-order = 0
     1070       then do:
     1071         return error "Не указан fact-order" .
     1072       end.
     1073       assign
     1074         v-ref-date  = date(1, 1, 2000)
     1075       .
     1076       assign
     1077         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1078       .
     1079       assign
     1080         p-fact-date = v-ref-date + v-ref-delta
     1081       .
     1082     end.
     1083   end procedure.
     1084   procedure factord-to-fact-num :
     1085     define input  parameter p-fact-order as decimal no-undo .
     1086     define output parameter p-fact-num   as integer no-undo .
     1087     define variable v-fact-order-trunc as decimal no-undo .
     1088     do
     1089     on error undo, return error return-value
     1090     :
     1091       if p-fact-order = ?
     1092       or p-fact-order = 0
     1093       then do:
     1094         return error "Не указан fact-order" .
     1095       end.
     1096       assign
     1097        v-fact-order-trunc = truncate(p-fact-order, 2)
     1098       .
     1099       assign
     1100         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1101       .
     1102     end.
     1103   end procedure.
     1104   procedure factord-to-shift-num :
     1105     define input  parameter p-fact-order as decimal no-undo .
     1106     define output parameter p-shift-num   as integer no-undo .
     1107     define variable  p-shift-numd  as decimal   no-undo .
     1108     define variable v-fact-order-trunc as decimal no-undo .
     1109     do
     1110     on error undo, return error return-value
     1111     :
     1112       if p-fact-order = ?
     1113       or p-fact-order = 0
     1114       then do:
     1115         return error "Не указан fact-order" .
     1116       end.
     1117       assign
     1118        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1119       .
     1120       if v-fact-order-trunc < 0.5 then do:
     1121         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1122       end.
     1123       assign
     1124         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1125         .
     1126        assign
     1127         p-shift-num = truncate (p-shift-numd , 0)
     1128       .
     1129     end.
     1130   end procedure.
