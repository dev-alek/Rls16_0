        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define stream out-stream .
        9   output stream out-stream to value ( "pr-u121.txt") .
       10   define stream err-stream .
       11   output stream err-stream to value ( "err-121.txt") .
       12   define variable g#log as logical   no-undo .
       13   define variable g#ok as integer   no-undo  init 0.
       14   define variable v-exist as logical no-undo init false .
       15   define variable bbb as integer   no-undo .
       16   define variable rr as recid     no-undo .
       17   define variable str as character no-undo .
       18   g#log =  session:SET-WAIT-STATE("GENERAL") .
       19   define buffer buf_price-doc for ub.price-doc.
       20   define buffer buf1_price-list for ub.price-list.
       21   define buffer buf2_price-list for ub.price-list.
       22   for each ub.gds-obj no-lock where ub.gds-obj.price-sale  <> 0  break by ub.gds-obj.obj-type by ub.gds-obj.obj-code :
       23   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
       24     (input  ub.gds-obj.gds-code
       25     ,input  ?
       26     ,output bbb
       27     ) no-error .
       28   if bbb = ? or bbb = 0 or error-status :error then do:
       29        export stream err-stream
       30             bbb
       31             ub.gds-obj.artic
       32             ub.gds-obj.prod-code
       33             ub.gds-obj.prod-type
       34             ub.gds-obj.obj-code
       35             ub.gds-obj.obj-type
       36             ub.gds-obj.price-sale
       37             error-status :get-message(1)
       38             return-value
       39             skip
       40             .
       41        bbb = gds-obj.gds-code .
       42   end.
       43       find first buf1_price-list exclusive-lock  where
       44                  buf1_price-list.obj-type  = gds-obj.obj-type and
       45                  buf1_price-list.obj-code  = gds-obj.obj-code and
       46                  buf1_price-list.b-code    =  bbb and
       47                  buf1_price-list.price-type =  "" and
       48                  buf1_price-list.fact-order > 1   and
       49                  buf1_price-list.artic     = gds-obj.artic    and
       50                  buf1_price-list.prod-type = gds-obj.prod-type and
       51                  buf1_price-list.prod-code = gds-obj.prod-code no-error .
       52       if not available buf1_price-list then do:
       53           g#ok = g#ok + 1.
       54             export stream out-stream
       55             bbb
       56             gds-obj.artic
       57             gds-obj.prod-code
       58             gds-obj.prod-type
       59             gds-obj.obj-code
       60             gds-obj.obj-type
       61             gds-obj.price-sale
       62             skip
       63             .
       64       end.
       65   end.
       66   output stream out-stream close.
       67   output stream err-stream close.
       68   g#log =  session:SET-WAIT-STATE("") .
       69   message "ВСЕ готово в  pr-u121.txt" skip g#ok view-as alert-box .
