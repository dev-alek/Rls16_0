     1390         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1391         ub.price-doc-forming.who          = v-cntxt-userid
     1392         ub.price-doc-forming.name         = "автосоздание"
     1393      .
     1394      assign
     1395       p-pdf-db-num  = ub.price-doc-forming.pdf-db
