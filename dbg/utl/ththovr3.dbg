     7490   old-price = ? .
     7491     for each buf_price-doc-forming-gds-tnv no-lock where
     7492              buf_price-doc-forming-gds-tnv.plt-id     = buf_price-doc-forming-gds.plt-id and
     7493              buf_price-doc-forming-gds-tnv.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     7494              buf_price-doc-forming-gds-tnv.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     7495              buf_price-doc-forming-gds-tnv.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     7496              buf_price-doc-forming-gds-tnv.b-code     = buf_price-doc-forming-gds.b-code
     7497              by buf_price-doc-forming-gds-tnv.ttg-summa :
     7498              if old-price < buf_price-doc-forming-gds-tnv.price-sale-doc and old-price <> ? then do:
