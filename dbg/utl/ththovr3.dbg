     4922             output vd  ,
     4923             output cost-base   ,
     4924             output cost-rubl   ,
     4925             output cur-rt-base ,
     4926             output cur-rt-rubl
     4927             ).
     4928             cost-rubl = vd * p-exch-rate / p-exch-scale .
     4929             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4930             p-new-calc-method = 'Отсутствует':U .
     4931      end.
     4932      when 'Основная':U then do:
     4933      end.
     4934       when 'ПорогПр-НДС':U then do:
     4935         find first x_obj-group.
     4936             run calc-price-levelprod (
     4937               input 2          ,
     4938               input var-pr-r-b ,
     4939               input p-b-code   ,
     4940               input x_obj-group.obj-type ,
     4941               input x_obj-group.obj-code ,
     4942               output vd,
     4943               output v-descript
     4944             ) no-error.
     4945         if vd = 0 or vd = ?  then do:
     4946           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4947                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4948                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4949                   view-as alert-box question buttons OK-Cancel title "#4" update g#log1 as logical .
     4950         end.
     4951         else do:
     4952             cost-rubl = vd .
     4953             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4954             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4955         end.
     4956       end.
     4957       when 'ПорогПр+НДС':U then do:
     4958         find first x_obj-group.
     4959             run calc-price-levelprod (
     4960               input 1          ,
     4961               input var-pr-r-b ,
     4962               input p-b-code   ,
     4963               input x_obj-group.obj-type ,
     4964               input x_obj-group.obj-code ,
     4965               output vd ,
     4966               output v-descript
     4967             ) no-error.
     4968         if vd = 0 or vd = ?  then do:
     4969           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4970                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4971                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4972                   view-as alert-box information .
     4973         end.
     4974         else do:
     4975             cost-rubl = vd .
     4976             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4977             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4978         end.
     4979       end.
     4980       when 'Производит':U
     4981       then do:
     4982         find first x_obj-group.
     4983   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4985   (  input  p-b-code
     4986    , input  x_obj-group.obj-type
     4987    , input  x_obj-group.obj-code
     4988    , output v-PriceWithVat
     4989    , output vd
     4990    , output v-prod-vat
     4991    , output v-str1
