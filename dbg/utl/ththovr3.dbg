     9681             ub.price-list-type-pay-type.sys-date     = today
     9682             ub.price-list-type-pay-type.sys-time     = time
     9683             ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
     9684             ub.price-list-type-pay-type.who          = p-userid
     9685             ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
     9686            .
