     1992   procedure grp-obj-notcorr-value :
     1993   do
     1994   on error undo, return error
     1995   :
     1996   define input parameter p-node-code             as integer      no-undo.
     1997   define input parameter p-obj-type              as character    no-undo.
     1998   define input parameter p-obj-code              as integer      no-undo.
     1999   define output parameter p-notcorr              as character    no-undo init ?.
     2000   define output parameter p-range-notcorr     as integer      no-undo.
     2001   define output parameter p-exists-notcorr    as logical      no-undo.
     2002   define variable v-host-code as integer      no-undo.
     2003   DEFINE VARIABLE v-found as logical no-undo .
     2004   DEFINE VARIABLE v-exists as logical no-undo .
     2005   DEFINE VARIABLE v-range as integer no-undo .
     2006   DEFINE VARIABLE jj as integer no-undo .
     2007   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2008   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2009   define buffer buf_gds-grp for ub.gds-grp.
     2010   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2011   find first buf_gds-grp no-lock where
     2012              buf_gds-grp.node-code = p-node-code no-error .
     2013   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2014     message
     2015       vss-workfile vss-revision vss-description
     2016       skip "Не удалось найти группу товаров с кодом" p-node-code
     2017       view-as alert-box error .
     2018     undo, return error .
     2019   end.
     2020   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2021   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2022     (input  p-obj-type
     2023     ,input  p-obj-code
     2024     ,output v-host-code
     2025     ) no-error .
     2026   if error-status :error
     2027   then do:
     2028       message
     2029         vss-workfile vss-revision vss-description
     2030         skip "Не удалось найти фирму объекта"
     2031         skip p-obj-type p-obj-code
     2032         skip return-value
     2033         skip trim(error-status :get-message(1))
     2034       view-as alert-box error.
     2035       undo, return error .
     2036   end.
     2037   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2038   do while v-found = no and jj < 2:
     2039     if v-range <> 3 then do:
     2040       find first buf_gds-grp-obj no-lock
     2041           where buf_gds-grp-obj.node-code = p-node-code
     2042             and buf_gds-grp-obj.host-code = v-host-code
     2043             and buf_gds-grp-obj.obj-type  = p-obj-type
     2044             and buf_gds-grp-obj.obj-code  = p-obj-code
     2045       no-error .
     2046     end.
     2047     if v-range = 3 or not available buf_gds-grp-obj
     2048     then do:
     2049        if v-range <> 2 then do:
     2050           find first buf_gds-grp-obj no-lock
     2051               where buf_gds-grp-obj.node-code = p-node-code
     2052                 and buf_gds-grp-obj.host-code = v-host-code
     2053                 and buf_gds-grp-obj.obj-type  = ""
     2054                 and buf_gds-grp-obj.obj-code  = 0
     2055           no-error .
     2056         end.
     2057         if v-range = 2 or not available buf_gds-grp-obj
     2058         then do:
     2059             if v-range <> 1 then do:
     2060               find first buf_gds-grp-obj no-lock
     2061                   where buf_gds-grp-obj.node-code = p-node-code
     2062                   and buf_gds-grp-obj.host-code = 0
     2063                   and buf_gds-grp-obj.obj-type  = ""
     2064                   and buf_gds-grp-obj.obj-code  = 0
     2065               no-error .
     2066             end.
     2067             if v-range = 1 or not available buf_gds-grp-obj
     2068             then do:
     2069                 assign
     2070                     v-exists = no
     2071                 .
     2072             end.
     2073             else do:
     2074                 assign
     2075                     v-exists = yes
     2076                     v-range = 1
     2077                 .
     2078             end.
     2079         end.
     2080         else do:
     2081             assign
     2082                 v-exists = yes
     2083                 v-range  = 2
     2084             .
     2085         end.
     2086     end.
     2087     else do:
     2088         assign
     2089             v-exists = yes
     2090             v-range  = 3
     2091         .
     2092     end.
     2093     if available buf_gds-grp-obj
     2094     then do:
     2095       find first buf_gds-grp-obj-attr no-lock
     2096         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2097           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2098           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2099           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2100           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2101         no-error .
     2102       if available buf_gds-grp-obj-attr then do:
     2103         assign
     2104           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2105         .
     2106       end.
     2107       else do:
     2108         assign
     2109           v-notcorr-value = ?
     2110         .
     2111       end.
     2112       assign
     2113       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2114                           then yes
     2115                           else p-exists-notcorr)
     2116       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2117                         then v-range
     2118                         else p-range-notcorr
     2119       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2120                         then v-notcorr-value
     2121                         else p-notcorr
     2122       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2123       jj = jj + 1
     2124       .
     2125     end.
     2126     else do:
     2127       assign
     2128       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2129       jj = jj + 1
     2130       .
     2131     end.
     2132   end.
     2133   end.
     2134   end procedure.
     2135   define variable vss-include-info29 as character format "X(65)" no-undo
     2136   initial "@(#)$Workfile$ $Revision$".
     2137   procedure grplib-get-full-name :
     2138      define input parameter p-node-code  as integer      no-undo.
     2139      define output parameter p-full-name as character    no-undo.
     2140      do
     2141   on error undo, return error
     2142   :
     2143       define variable v-upper-code    as integer           no-undo.
     2144       define buffer buf_gds-grp       for ub.gds-grp.
     2145       define buffer buf_upper_gds-grp for ub.gds-grp.
     2146       find first buf_gds-grp no-lock
     2147            where buf_gds-grp.node-code = p-node-code
     2148       no-error.
     2149       if not available buf_gds-grp
     2150       then do:
     2151           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2152       end.
     2153       assign
     2154           p-full-name  = ""
     2155           v-upper-code = 1
     2156       .
     2157       do while buf_gds-grp.upper-code <> 0
     2158       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2159       :
     2160           assign
     2161               p-full-name  = buf_gds-grp.node-name
     2162                            + (if p-full-name <> "" then chr(47) else "")
     2163                            + p-full-name
     2164               v-upper-code = buf_gds-grp.upper-code
     2165           .
     2166           find first buf_gds-grp no-lock
     2167                where buf_gds-grp.node-code = v-upper-code
     2168           no-error.
     2169           if not available buf_gds-grp
     2170           then do:
     2171               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2172                                   + string( v-upper-code )
     2173                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2174           end.
     2175       end.
     2176       assign
     2177       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2178       .
     2179   end.
     2180   end .
     2181   procedure grplib-get-node-from-full-name :
     2182   define input parameter p-full-name as character no-undo .
     2183   define output parameter p-node-code as integer no-undo .
     2184   define variable v-ii as integer no-undo .
     2185   define variable v-upper-code as integer no-undo .
     2186   define variable v-root-code as integer no-undo .
     2187   define variable v-entry as character no-undo .
     2188   define buffer buf_gds-grp       for ub.gds-grp.
     2189   do
     2190   on error undo, return error
     2191   :
     2192     find first buf_gds-grp no-lock
     2193         where buf_gds-grp.upper-code = 0
     2194     no-error .
     2195     if not available buf_gds-grp
     2196     then do:
     2197         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2198     end.
     2199     else do:
     2200       assign
     2201       v-root-code = buf_gds-grp.node-code
     2202       .
     2203     end.
     2204     v-upper-code = v-root-code.
     2205     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2206       assign
     2207       v-entry = entry(v-ii, p-full-name, chr(47)).
     2208       if v-entry = '' then leave.
     2209       find first buf_gds-grp no-lock where
     2210                 buf_gds-grp.node-name = v-entry
     2211             and buf_gds-grp.upper-code = v-upper-code
     2212             no-error.
     2213       if not available buf_gds-grp then do:
     2214         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2215       end.
     2216       else do:
     2217         p-node-code = buf_gds-grp.node-code.
     2218         v-upper-code = buf_gds-grp.node-code.
     2219       end.
     2220     end.
     2221   end.
     2222   end .
     2223   procedure  chec-par :
     2224   define output parameter l-par as logical no-undo .
