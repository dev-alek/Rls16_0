     9694                                 tt_cash-pay.curr-code  = ub.price-list-type-cash-pay.curr-code
     9695                                 ) then
     9696          ub.price-list-type-cash-pay.stts   = 1 .
     9697     end.
     9698     for each tt_cash-pay :
     9699         find first  ub.price-list-type-cash-pay exclusive-lock where
     9700                     ub.price-list-type-cash-pay.cdpay-code = tt_cash-pay.cdpay-code and
     9701                     ub.price-list-type-cash-pay.curr-code  = tt_cash-pay.curr-code and
     9702                     ub.price-list-type-cash-pay.plt-db-num        = p-db-num and
