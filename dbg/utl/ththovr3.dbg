     4562   p-new-calc-method = p-calc-method .
     4563   run re-define in this-procedure (
     4564       input-output p-calc-method
     4565     , input p-gds-code
     4566     ) .
     4567     define variable v-sps as character no-undo .
     4568   v-sps =
     4569    "Товар,
     4570   Группа,
     4571   Учетная,
     4572   Учет-объект,
     4573   Учет-резерв,
     4574   Приходная,
     4575   Прих-объект,
     4576   Начальная,
     4577   Старая,
     4578   Новая,
     4579   Объект,
     4580   Накладная,
     4581   Накл-безНДС,
     4582   Учет-безНДС,
     4583   Стар-безНДС,
     4584   Переоценка,
     4585   ДокФормЦены,
     4586   Отсутствует,
     4587   Признак,
     4588   Специальная,
     4589   Не-считать,
     4590   Основная,
     4591   Единая,
     4592   Учет+накл,
     4593   Уч+накл-НДС,
     4594   НсП,
     4595   НсП+накл,
     4596   УчетнаяS,
     4597   Учет-рзрвS,
     4598   ПриходнаяS,
     4599   Учет-НДСS,
     4600   Откат_цен,
     4601   Спецификация
     4602   "
     4603     .
     4604   if lookup ( p-calc-method , v-sps )  = 0 then  do:
     4605       p-calc-method = entry (1,p-calc-method, " ") no-error .
     4606       if error-status :error then message p-calc-method.
     4607   end.
     4608   define variable v-i as integer   no-undo init 0.
     4609     for each  x_obj-group :
     4610         v-i = v-i + 1.
     4611         if entry( v-i, new_round , chr(4) ) <> string ( loc_round ) then do:
     4612             message "На выбранных объектах используются разные параметры Наценки и округления ! Для расчета выбран" string ( loc_round ) skip "для товара  "
     4613             skip
     4614             "код     :" p-gds-code  skip
     4615             "бар-код :" p-b-code    skip
     4616             "артикул :" p-artic     skip
     4617             "производитель :" p-prod-type        p-prod-code
     4618             view-as alert-box information .
     4619             leave.
     4620         end.
     4621         if entry( v-i, new_vat-pc , chr(4) ) <> string ( local_vat-pc ) then do:
     4622             message "На выбранных объектах используются разные НДС ! Для расчета выбран" string ( local_vat-pc ) "%" skip "для товара  "
     4623             skip
     4624             "код     :" p-gds-code  skip
     4625             "бар-код :" p-b-code    skip
     4626             "артикул :" p-artic     skip
     4627             "производитель :" p-prod-type        p-prod-code
     4628             view-as alert-box information .
     4629             leave.
     4630         end.
     4631         if entry( v-i, new_slt-pc , chr(4) ) <> string ( local_slt-pc ) then do:
     4632             message "На выбранных объектах используются разные НсП ! Для расчета выбран" string ( local_slt-pc )
     4633             skip
     4634             "код     :" p-gds-code   skip
     4635             "бар-код :" p-b-code    skip
     4636             "артикул :" p-artic             skip
     4637             "производитель :" p-prod-type        p-prod-code
     4638             view-as alert-box information .
