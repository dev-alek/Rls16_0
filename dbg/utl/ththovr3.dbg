     6361       ,v-price-prev-doc
     6362       ,v-price-prev-rubl
     6363       ,v-price-sale-base
     6364       ,v-price-sale-doc
     6365       ,v-price-sale-rubl
     6366       ,v-road-tax-base
     6367       ,v-road-tax-doc
     6368       ,v-road-tax-rubl
     6369       ,v-excise-base
     6370       ,v-excise-doc
     6371       ,v-excise-rubl
     6372       ,v-vat-pc
     6373       ,v-slt-pc
     6374       ,v-prev-doc-code
     6375       ,0
     6376       ,input-output v-sec
     6377        ) no-error  .
     6378        if error-status :error then
     6379        message
     6380          vss-workfile vss-revision vss-description skip
     6381          error-status :get-message(1) skip
     6382          return-value skip
     6383          "4567"
     6384          view-as alert-box error
     6385        .
     6386     end.
     6387   end procedure.
     6388   procedure re-define :
     6389   define input-output parameter p-calc-method      as character no-undo .
     6390   define input        parameter p-gds-code         as integer   no-undo .
     6391     do
     6392     on error undo, return error return-value
     6393     :
     6394   define buffer buf_goods for ub.goods  .
     6395   define buffer buf_gds-grp for ub.gds-grp  .
     6396       case p-calc-method :
     6397         when 'Товар':U then do:
     6398              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     6399                   case buf_goods.calc-method:
     6400                     when 'Группа':U then do:
     6401                       find first buf_gds-grp no-lock where
     6402                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     6403                       p-calc-method  = buf_gds-grp.calc-method.
     6404                     end.
     6405                   otherwise do:
     6406                       p-calc-method  =  buf_goods.calc-method .
     6407                   end.
     6408                   end case.
     6409              run  re-define in this-procedure (
     6410                         input-output  p-calc-method ,
     6411                         input p-gds-code )  .
     6412         end.
     6413         when 'Группа':U then do:
     6414              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     6415              find first buf_gds-grp no-lock where
     6416                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     6417              run re-define in this-procedure (
     6418                         input-output buf_gds-grp.calc-method ,
     6419                         input p-gds-code )  .
     6420         end.
     6421         when 'Учетная':U or
     6422         when 'Учет-объект':U then do:
     6423              p-calc-method = 'УчетнаяS':U .
     6424         end.
     6425         when 'Учет-резерв':U then do:
     6426              p-calc-method = 'Учет-рзрвS':U.
     6427         end.
     6428         when 'Приходная':U or
     6429         when 'Прих-объект':U then do:
     6430              p-calc-method = 'ПриходнаяS':U.
     6431         end.
     6432         when 'Учет-безНДС':U then do:
     6433              p-calc-method = 'Учет-НДСS':U .
     6434         end.
     6435       end case.
     6436     end.
     6437   end procedure.
     6438   procedure create-line-pdf-mpl-lib :
     6439   define input  parameter  p-plt-db-num as integer   no-undo .
