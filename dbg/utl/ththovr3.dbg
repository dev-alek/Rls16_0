     4236       if p-price-sale-doc = 0 then do:
     4237         assign
     4238           p-price-sale-doc = p-round-base
     4239         .
     4240       end.
     4241     end.
     4242     when 'Коэффициент':U then do:
     4243       if p-round-base <> 0 then do:
     4244         assign
     4245           p-price-sale-doc = p-price-sale-doc * p-round-base
     4246         .
     4247       end.
     4248     end.
     4249     when 'Отключено':U then do:
     4250     end.
     4251     otherwise do:
     4252       message
     4253         vss-workfile vss-revision vss-description skip
     4254         "Неизвестный метод округления продажной цены" skip
     4255         "round-method" p-round-method skip
     4256         "round-base"   p-round-base   skip
     4257         "price"        p-price-sale-doc             skip
     4258         view-as alert-box error .
     4259     end.
     4260   end.
     4261       if error-status :error then do:
     4262       message
     4263         error-status :get-message(1) skip
     4264         return-value skip
     4265         "pr-99"
     4266         view-as alert-box error
     4267       .
     4268       end.
     4269     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     4270     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     4271     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     4272     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     4273     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     4274     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     4275     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     4276     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     4277     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     4278     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     4279     p-prev-doc-code = if available bufold_price-doc-forming
     4280                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     4281                          else "" .
     4282     end.
     4283   end procedure.
