        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-from-version   as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: ththovr3.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/ththovr3.p $":U .
        9   define variable vss-description as character no-undo init "Закрытие ДНЦ списком со сбрасывание конфигурационных параметров".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure gen-key-rec :
       73     define input  parameter p-tbl-name    as character no-undo.
       74     define input  parameter p-bh_tbl-name as handle    no-undo.
       75     define output parameter p-key-rec     as character no-undo.
       76     do
       77     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       78     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       79     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       80     :
       81       define variable fh               as handle    no-undo .
       82       define variable v-ok             as logical   no-undo .
       83       define variable v-inform         as character no-undo .
       84       define variable v-ind            as integer   no-undo .
       85       define variable v-idx-field-qnty as integer   no-undo .
       86       if p-tbl-name = ?
       87         or p-tbl-name = "":U
       88       then do:
       89         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       90       end.
       91       if not p-bh_tbl-name:available then do:
       92         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
       93       end.
       94       assign
       95         p-key-rec = p-tbl-name
       96         v-inform  = p-bh_tbl-name:index-information(1)
       97         v-ind     = 2
       98       .
       99       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      100       on error undo, return error
      101       :
      102         assign
      103           v-inform = p-bh_tbl-name:index-information( v-ind )
      104           v-ind    = v-ind + 1
      105         .
      106       end.
      107       if v-inform = ?
      108         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      109         or entry( 3, v-inform, ",":U ) <> "1":U
      110       then do:
      111         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      112       end.
      113       else do:
      114         assign
      115           v-idx-field-qnty = num-entries( v-inform ) - 4
      116         .
      117         if v-idx-field-qnty < 2 then do:
      118           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      119         end.
      120         do v-ind = 1 to v-idx-field-qnty by 2
      121         on error undo, return error
      122         :
      123           assign
      124             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      125             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      126           .
      127         end.
      128       end.
      129       if p-key-rec = ? then do:
      130         assign
      131           p-key-rec = "":U
      132         .
      133         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      134       end.
      135     end.
      136     return.
      137   end procedure.
      138   procedure gen-where-keyr-tab :
      139     define input  parameter i-tableSerach as character no-undo.
      140     define input  parameter i-tablekey   as character  no-undo.
      141     define input  parameter p-key-rec    as character  no-undo.
      142     define input  parameter p-key-handle as handle     no-undo .
      143     define input  parameter p-db-name    as character  no-undo .
      144     define input  parameter p-tt-handle  as handle     no-undo .
      145     define output parameter o-Where      as character  no-undo.
      146     do
      147     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      148     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      149     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      150     :
      151       define variable v-full-tbl-name  as character no-undo .
      152       define variable bh_tbl-name      as handle    no-undo .
      153       define variable fh_key           as handle    no-undo .
      154       define variable fh_search        as handle    no-undo .
      155       define variable v-field-num      as integer   no-undo .
      156       define variable v-count-fld      as integer   no-undo .
      157       define variable v-inform         as character no-undo .
      158       define variable v-ind            as integer   no-undo .
      159       define variable v-idx-field-qnty as integer   no-undo .
      160       define variable v-field-name     as character no-undo .
      161       define variable v-field-val      as character no-undo .
      162       define variable v-word-link      as character no-undo .
      163       define variable vTable           as character no-undo.
      164       define variable bh_tbl-key       as handle    no-undo .
      165       assign
      166         p-key-rec = trim( p-key-rec )
      167       .
      168       if p-key-handle <> ? then do:
      169         if not valid-handle(p-key-handle)
      170            or p-key-handle:type <> "buffer"
      171         then do:
      172           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      173         end.
      174         if num-entries( p-key-rec, chr(3) ) > 1
      175           or p-key-rec = ?
      176           or p-key-rec = "":U
      177         then do:
      178           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      179         end.
      180       end.
      181       else do:
      182         if p-key-rec = ?
      183           or p-key-rec = "":U
      184         then do:
      185           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      186         end.
      187       end.
      188       assign
      189         vTable = entry( 1 , p-key-rec, chr(3) )
      190       .
      191       if p-tt-handle <> ?
      192         and ( not valid-handle(p-tt-handle)
      193               or p-tt-handle:type <> "buffer"
      194             )
      195       then do:
      196         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      197       end.
      198       if p-tt-handle = ? then do:
      199         assign
      200           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      201         .
      202         create buffer bh_tbl-name for table v-full-tbl-name .
      203       end.
      204       else do:
      205         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      206       end.
      207       assign
      208         v-inform = bh_tbl-name:index-information(1)
      209         v-ind    = 2
      210       .
      211       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      212       on error undo, return error
      213       :
      214         assign
      215           v-inform = bh_tbl-name:index-information( v-ind )
      216           v-ind    = v-ind + 1
      217         .
      218       end.
      219       if v-inform = ?
      220         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      221         or entry( 3, v-inform, ",":U ) <> "1":U
      222       then do:
      223         delete object bh_tbl-name no-error.
      224         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      225       end.
      226       assign
      227         v-idx-field-qnty = num-entries( v-inform ) - 4
      228       .
      229       if v-idx-field-qnty < 2 then do:
      230         delete object bh_tbl-name no-error.
      231         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      232       end.
      233       assign
      234         o-where     = "where":U
      235         v-word-link = "":U
      236         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      237         v-count-fld = 0
      238       .
      239       if i-tablekey ne "" and i-tablekey ne ?
      240       then do:
      241         assign
      242           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      243         .
      244         create buffer bh_tbl-key for table v-full-tbl-name .
      245       end.
      246       if i-tableSerach ne "" and i-tableSerach ne ?
      247       then do:
      248         delete object bh_tbl-name no-error.
      249         assign
      250           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      251         .
      252         create buffer bh_tbl-name for table v-full-tbl-name .
      253       end.
      254       block_where:
      255       do v-ind = 1 to v-idx-field-qnty by 2
      256       on error undo, return error
      257       :
      258         assign
      259           v-count-fld = v-count-fld + 1
      260         .
      261         if p-key-handle = ?
      262           and v-count-fld > v-field-num
      263         then do:
      264           leave block_where.
      265         end.
      266         define variable VfieldKeyTable as handle no-undo.
      267         assign
      268           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      269           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      270         .
      271         if     bh_tbl-key ne ?
      272         then do:
      273            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      274            if VfieldKeyTable eq ?
      275            then next block_where.
      276         end.
      277         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      278         then
      279            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      280         else
      281            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      282         if p-key-handle = ? then do:
      283           assign
      284             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      285           .
      286         end.
      287         else do:
      288           assign
      289             fh_key = p-key-handle:buffer-field( v-field-name )
      290           .
      291           if fh_key = ?
      292             or not valid-handle( fh_key )
      293           then do:
      294             delete object bh_tbl-name.
      295             if     bh_tbl-key ne ?
      296             then
      297                delete object bh_tbl-key.
      298             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      299           end.
      300           assign
      301             v-field-val = fh_key:buffer-value
      302           .
      303         end.
      304         if fh_search:data-type ="character":U then do:
      305           assign
      306             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      307             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      308             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      309             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      310             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      311             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      312             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      313             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      314             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      315             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      316             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      317             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      318             v-field-val = substitute( '"&1"', v-field-val )
      319           .
      320         end.
      321         assign
      322           o-where = substitute( "&1 &2", o-where, v-field-val )
      323         .
      324         if v-word-link = "":U then do:
      325           assign
      326             v-word-link = "and":U
      327           .
      328         end.
      329       end.
      330       delete object bh_tbl-name.
      331       if     bh_tbl-key ne ?
      332       then
      333          delete object bh_tbl-key.
      334       if p-key-handle = ?
      335         and v-count-fld <> v-field-num
      336       then do:
      337         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      338       end.
      339     end.
      340   end procedure.
      341   procedure gen-hn-keyr-tab :
      342     define input  parameter i-tableSerach as character no-undo.
      343     define input  parameter i-tablekey   as character no-undo.
      344     define input  parameter p-key-rec    as character no-undo.
      345     define input  parameter p-key-handle as handle    no-undo .
      346     define input  parameter p-db-name    as character no-undo .
      347     define input  parameter p-tt-handle  as handle    no-undo .
      348     define input  parameter p-stts-lock  as integer   no-undo .
      349     define output parameter o-hn         as handle    no-undo.
      350     define variable v-full-tbl-name as character no-undo.
      351     define variable v-where         as character no-undo.
      352     define variable bh_tbl-name     as handle    no-undo.
      353     define variable vTable          as character no-undo.
      354     do
      355     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      356     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      357     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      358         run gen-where-keyr-tab(i-tableSerach,
      359                                i-tablekey,
      360                                p-key-rec,
      361                                p-key-handle,
      362                                p-db-name,
      363                                p-tt-handle,
      364                                output v-where).
      365         if i-tableSerach ne "" and i-tableSerach ne ?
      366         then do:
      367            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      368            create buffer bh_tbl-name for table v-full-tbl-name .
      369         end.
      370         else do:
      371            if p-tt-handle = ? then do:
      372               assign
      373                  vTable = entry( 1 , p-key-rec, chr(3) )
      374               .
      375               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      376               create buffer bh_tbl-name for table v-full-tbl-name .
      377            end.
      378            else do:
      379               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      380            end.
      381         end.
      382         if p-tt-handle = ? then do:
      383            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      384         end.
      385         else do:
      386            bh_tbl-name:find-first( v-where ) no-error .
      387         end.
      388         o-hn = bh_tbl-name.
      389      end.
      390   end procedure.
      391   procedure gen-hn-keyr :
      392     define input  parameter p-key-rec    as character no-undo.
      393     define input  parameter p-key-handle as handle    no-undo .
      394     define input  parameter p-db-name    as character no-undo .
      395     define input  parameter p-tt-handle  as handle    no-undo .
      396     define input  parameter p-stts-lock  as integer   no-undo .
      397     define output parameter o-hn         as handle    no-undo.
      398     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      399   end.
      400   procedure gen-row-keyr :
      401     define input  parameter p-key-rec    as character no-undo.
      402     define input  parameter p-key-handle as handle    no-undo .
      403     define input  parameter p-db-name    as character no-undo .
      404     define input  parameter p-tt-handle  as handle    no-undo .
      405     define input  parameter p-stts-lock  as integer   no-undo .
      406     define output parameter p-tbl-row    as rowid     no-undo.
      407     define output parameter p-tbl-name   as character no-undo.
      408     define variable vHn as handle no-undo.
      409       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      410       p-tbl-row = if vHn:available then vHn:rowid else ?.
      411       p-tbl-name =  vHn:table.
      412       delete object vHn no-error.
      413     if p-tbl-row = ? then do:
      414       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      415     end.
      416     else do:
      417       return.
      418     end.
      419   end procedure.
      420   procedure gen-key-fv :
      421     define input  parameter p-key-rec    as character no-undo .
      422     define output parameter p-field-list as character no-undo .
      423     define output parameter p-value-list as character no-undo.
      424     do
      425     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      426     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      427     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      428     :
      429       define variable v-full-tbl-name  as character no-undo .
      430       define variable bh_tbl-name      as handle    no-undo .
      431       define variable v-tbl-name       as character no-undo .
      432       define variable v-field-num      as integer   no-undo .
      433       define variable v-count-fld      as integer   no-undo .
      434       define variable v-inform         as character no-undo .
      435       define variable v-ind            as integer   no-undo .
      436       define variable v-idx-field-qnty as integer   no-undo .
      437       define variable v-delim-key      as character no-undo .
      438       if p-key-rec = ?
      439         or p-key-rec = "":U
      440       then do:
      441         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      442       end.
      443       assign
      444         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      445         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      446       .
      447       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      448       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      449       assign
      450         v-inform = bh_tbl-name:index-information(1)
      451         v-ind    = 2
      452       .
      453       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      454       on error undo, return error
      455       :
      456         assign
      457           v-inform = bh_tbl-name:index-information( v-ind )
      458           v-ind    = v-ind + 1
      459         .
      460       end.
      461       if v-inform = ?
      462         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      463         or entry( 3, v-inform, ",":U ) <> "1":U
      464       then do:
      465         delete object bh_tbl-name no-error.
      466         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      467       end.
      468       assign
      469         v-idx-field-qnty = num-entries( v-inform ) - 4
      470       .
      471       if v-idx-field-qnty < 2 then do:
      472         delete object bh_tbl-name no-error.
      473         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      474       end.
      475       assign
      476         p-field-list = "":U
      477         p-value-list = "":U
      478         v-delim-key  = "":U
      479         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      480         v-count-fld  = 0
      481       .
      482       block_where:
      483       do v-ind = 1 to v-idx-field-qnty by 2
      484       on error undo, return error
      485       :
      486         assign
      487           v-count-fld = v-count-fld + 1
      488         .
      489         if v-count-fld > v-field-num then do:
      490           leave block_where.
      491         end.
      492         assign
      493           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      494           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      495         .
      496         if v-ind = 1 then do:
      497           assign
      498             v-delim-key = chr(3)
      499           .
      500         end.
      501       end.
      502       delete object bh_tbl-name.
      503       if v-count-fld <> v-field-num then do:
      504         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      505       end.
      506     end.
      507   end procedure.
      508   procedure gen-key-field :
      509     define input  parameter p-table      as character no-undo .
      510     define output parameter p-field-list as character no-undo .
      511     do
      512     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      513     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      514     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      515     :
      516       define variable v-full-tbl-name  as character no-undo .
      517       define variable bh_tbl-name      as handle    no-undo .
      518       define variable v-tbl-name       as character no-undo .
      519       define variable v-field-num      as integer   no-undo .
      520       define variable v-count-fld      as integer   no-undo .
      521       define variable v-inform         as character no-undo .
      522       define variable v-ind            as integer   no-undo .
      523       define variable v-idx-field-qnty as integer   no-undo .
      524       define variable v-delim-key      as character no-undo .
      525       if p-table = ?
      526         or p-table = "":U
      527       then do:
      528         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      529       end.
      530       assign
      531         v-tbl-name      = p-table
      532         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      533       .
      534       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      535       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      536       assign
      537         v-inform = bh_tbl-name:index-information(1)
      538         v-ind    = 2
      539       .
      540       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      541       on error undo, return error
      542       :
      543         assign
      544           v-inform = bh_tbl-name:index-information( v-ind )
      545           v-ind    = v-ind + 1
      546         .
      547       end.
      548       if v-inform = ?
      549         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      550         or entry( 3, v-inform, ",":U ) <> "1":U
      551       then do:
      552         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      553       end.
      554       assign
      555         v-idx-field-qnty = num-entries( v-inform ) - 4
      556       .
      557       if v-idx-field-qnty < 2 then do:
      558         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      559       end.
      560       assign
      561         p-field-list = "":U
      562         v-delim-key  = "":U
      563         v-count-fld  = 0
      564       .
      565       block_where:
      566       do v-ind = 1 to v-idx-field-qnty by 2
      567       on error undo, return error
      568       :
      569         assign
      570           v-count-fld = v-count-fld + 1
      571         .
      572         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      573         if v-ind = 1 then do:
      574           assign
      575             v-delim-key = chr(3)
      576           .
      577         end.
      578       end.
      579       delete object bh_tbl-name.
      580     end.
      581   end procedure.
