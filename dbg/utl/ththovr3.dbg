     7548   end procedure.
     7549   procedure ver-pr-equ-qS :
     7550   define input parameter  p-plt-id      as integer   no-undo .
     7551   define input parameter  p-plt-db-num  as integer   no-undo .
     7552   define input parameter  p-pdf-id      as integer   no-undo .
     7553   define input parameter  p-pdf-db      as integer   no-undo .
     7554     do
     7555     on error undo, return error return-value
     7556     :
     7557   define variable  l-doc-num2   like ub.price-list.doc-num    no-undo .
     7558   define buffer pdf_price-list  for ub.price-doc-forming-gds .
     7559   define buffer pp_price-list   for ub.price-doc-forming-gds .
     7560   define buffer main_price-list for ub.price-doc-forming-gds .
     7561   define buffer alt_price-list  for ub.price-doc-forming-gds .
