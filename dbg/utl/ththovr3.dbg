     7500              end.
     7501              old-price = buf_price-doc-forming-gds-tnv.price-sale-doc .
     7502     end.
     7503     define buffer old_price-doc-forming for ub.price-doc-forming  .
     7504     define buffer old_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7505     define buffer old_price-all for ub.price-all.
     7506     if buf_price-list-type.main = false then do:
     7507        for each old_price-doc-forming no-lock where
     7508                 old_price-doc-forming.plt-id     = buf_price-list-type.plt-id     and
     7509                 old_price-doc-forming.plt-db-num = buf_price-list-type.plt-db-num and
     7510                 old_price-doc-forming.stts       = integer('3':U)  ,
     7511                 each old_price-doc-forming-gds no-lock where
     7512                       old_price-doc-forming-gds.plt-id     = buf_price-list-type.plt-id      and
     7513                       old_price-doc-forming-gds.plt-db-num = buf_price-list-type.plt-db-num  and
     7514                       old_price-doc-forming-gds.pdf-id     = old_price-doc-forming.pdf-id    and
     7515                       old_price-doc-forming-gds.pdf-db     = old_price-doc-forming.pdf-db    and
     7516                       old_price-doc-forming-gds.b-code     = buf_price-doc-forming-gds.b-code :
     7517                for each old_price-all no-lock where
     7518                         old_price-all.plt-id     = old_price-doc-forming-gds.plt-id      and
     7519                         old_price-all.plt-db-num = old_price-doc-forming-gds.plt-db-num  and
     7520                         old_price-all.pdf-id     = old_price-doc-forming-gds.pdf-id      and
     7521                         old_price-all.pdf-db     = old_price-doc-forming-gds.pdf-db      and
     7522                         old_price-all.b-code     = old_price-doc-forming-gds.b-code      and
     7523                         old_price-all.fact-order-sys-to   >= v-fact-order-sys-from       and
     7524                         old_price-all.fact-order-sys-from <= v-fact-order-sys-to         :
     7525                        return error substitute ("По товару &1 &2 &3 есть цена &6 в пересекающийся период с таким же приоритетом &7 (ДНЦ &4 &5) " ,
     7526                                                  buf_price-doc-forming-gds.artic ,
     7527                                                  buf_price-doc-forming-gds.prod-type ,
     7528                                                  buf_price-doc-forming-gds.prod-code,
     7529                                                  old_price-all.pdf-id ,
     7530                                                  old_price-all.pdf-db ,
     7531                                                  old_price-doc-forming-gds.price-sale-doc ,
     7532                                                  old_price-all.plt-priority
     7533                                                  ) .
     7534                end.
     7535        end.
     7536        end.
     7537       assign v-kol-rec = v-kol-rec + 1 .
