     4168   case p-round-method :
     4169     when '9-окончание':U then do:
     4170       if p-price-sale-doc < 29 then do:
     4171         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     4172           assign
