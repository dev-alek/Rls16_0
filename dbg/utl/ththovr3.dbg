    10279   procedure thth14-db-attr-code :
    10280     do
    10281     on error undo, return error
    10282     :
    10283       define input  parameter p-code           as character no-undo .
    10284       define output parameter p-type           as character no-undo .
    10285       define output parameter p-format         as character no-undo .
    10286       define output parameter p-label          as character no-undo .
    10287       define output parameter p-user-can-edit  as logical   no-undo .
    10288       define output parameter p-output-display as logical   no-undo .
    10289       define output parameter p-other          as character no-undo .
    10290       case p-code :
    10291               when 'thth14-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10292               when 'thth14-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10293               when 'thth14-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10294               when 'thth14-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
