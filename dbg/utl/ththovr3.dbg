    10512   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10513   procedure re-save-conf-par :
    10514   define variable v-obj-type as character no-undo .
    10515   define variable v-obj-code as integer no-undo .
    10516   define buffer buf_rep-line for ub.rep-line  .
    10517   define buffer buf_price-list-type-attr  for ub.price-list-type-attr .
    10518   define buffer buf_thbj-attr  for ub.thbj-attr.
    10519   main-block:
    10520   do
    10521   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10522   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    10523   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    10524   :
    10525     for each buf_rep-line exclusive-lock where
    10526              buf_rep-line.rep-num = 1996011203
    10527     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10528     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    10529     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    10530     :
    10531       find first buf_price-list-type-attr exclusive-lock where
    10532                 buf_price-list-type-attr.plt-id = integer(buf_rep-line.name4)
    10533             and buf_price-list-type-attr.plt-db-num =  integer(buf_rep-line.name5)
    10534             and buf_price-list-type-attr.attr-code = 'ie-gen-marg':U no-error.
    10535       if available buf_price-list-type-attr then do:
    10536         buf_price-list-type-attr.attr-value = buf_rep-line.name2 .
    10537       end.
    10538     end.
    10539     for each buf_rep-line exclusive-lock where
    10540              buf_rep-line.rep-num = 1996011206
    10541     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10542     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    10543     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    10544     :
    10545       case buf_rep-line.name3:
    10546         when "object" then do:
    10547           assign
    10548           v-obj-type = buf_rep-line.name1
    10549           v-obj-code = buf_rep-line.code3
    10550           .
    10551         end.
    10552         when "host" then do:
    10553           assign
    10554           v-obj-type = 'орг':U
    10555           v-obj-code = buf_rep-line.code2
    10556           .
    10557         end.
    10558         when "global" then do:
    10559           assign
    10560           v-obj-type = ''
    10561           v-obj-code = 0
    10562           .
    10563         end.
    10564       end case.
    10565       find first buf_thbj-attr exclusive-lock where
    10566                 buf_thbj-attr.obj-type = v-obj-type
    10567             and buf_thbj-attr.obj-code = v-obj-code
    10568             and buf_thbj-attr.prop-code = 'pr-goods':U
    10569             and buf_thbj-attr.upper-prop-code = 'overval':U no-error.
    10570       if available buf_thbj-attr then do:
    10571         buf_thbj-attr.property-value-character =  buf_rep-line.name2 .
    10572       end.
    10573     end.
    10574     for each buf_rep-line exclusive-lock where
    10575              buf_rep-line.rep-num = 1996011209
    10576     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10577     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    10578     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    10579     :
    10580       case buf_rep-line.name3:
    10581         when "object" then do:
    10582           assign
    10583           v-obj-type = buf_rep-line.name1
    10584           v-obj-code = buf_rep-line.code3
    10585           .
    10586         end.
    10587         when "host" then do:
    10588           assign
    10589           v-obj-type = 'орг':U
    10590           v-obj-code = buf_rep-line.code2
    10591           .
    10592         end.
    10593         when "global" then do:
    10594           assign
    10595           v-obj-type = ''
    10596           v-obj-code = 0
    10597           .
    10598         end.
    10599       end case.
    10600       find first buf_thbj-attr exclusive-lock where
    10601                 buf_thbj-attr.obj-type = buf_rep-line.name1
    10602             and buf_thbj-attr.obj-code = buf_rep-line.code3
    10603             and buf_thbj-attr.prop-code = 'pr-goods0':U
    10604             and buf_thbj-attr.upper-prop-code = 'overval':U no-error.
    10605       if available buf_thbj-attr then do:
    10606         buf_thbj-attr.property-value-character =  buf_rep-line.name2 .
    10607       end.
    10608     end.
    10609   end.
    10610   end procedure.
    10611   procedure save-conf-par :
    10612   define buffer buf_rep-line for ub.rep-line  .
    10613   define variable ii as integer   no-undo init 0 .
    10614   define variable v-plt-id as integer no-undo .
    10615   define variable v-plt-db-num as integer no-undo .
    10616   define variable v-host-code as integer no-undo .
    10617   define buffer buf_price-list-type-attr  for ub.price-list-type-attr .
    10618   define buffer buf_thbj-attr for ub.thbj-attr.
    10619   main-block:
    10620   do
    10621   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10622   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    10623   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    10624   :
    10625     for each obj-list
    10626     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10627     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    10628     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    10629     :
    10630   define variable vss-include-info92 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10631   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
    10632     (input  ?
    10633     ,input  obj-list.obj-type
    10634     ,input  obj-list.obj-code
    10635     ,input  yes
    10636     ,output v-plt-id
    10637     ,output v-plt-db-num
    10638     )  .
    10639   define variable vss-include-info93 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10641     (input  obj-list.obj-type
    10642     ,input  obj-list.obj-code
    10643     ,output v-host-code
    10644     )  .
    10645       for each buf_price-list-type-attr no-lock where
    10646               buf_price-list-type-attr.plt-id     = v-plt-id
    10647           and buf_price-list-type-attr.plt-db-num = v-plt-db-num
    10648           and buf_price-list-type-attr.attr-code = 'ie-gen-marg':U
    10649       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10650       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    10651       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    10652       :
    10653         ii = ii + 1.
    10654         find first buf_rep-line exclusive-lock where
    10655                   buf_rep-line.code1   = ii
    10656               and buf_rep-line.rep-num = 1996011203
    10657         no-error .
    10658         if not available buf_rep-line then do:
    10659           create buf_rep-line.
    10660         end.
    10661         assign
    10662         buf_rep-line.code1   = ii
    10663         buf_rep-line.rep-num = 1996011203
    10664         buf_rep-line.code2   = v-host-code
    10665         buf_rep-line.name1   = obj-list.obj-type
    10666         buf_rep-line.code3   = obj-list.obj-code
    10667         buf_rep-line.name2   = buf_price-list-type-attr.attr-value
    10668         buf_rep-line.name4   = string(buf_price-list-type-attr.plt-id)
    10669         buf_rep-line.name5   = string(buf_price-list-type-attr.plt-db-num)
    10670         .
    10671         buf_price-list-type-attr.attr-value = 'no-margin':U.
    10672       end.
    10673   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10674   empty temp-table thbjattr_thbj-attr.
    10675   run adm/shattri.p (
    10676      input "get":U
    10677     ,input obj-list.obj-type
    10678     ,input obj-list.obj-code
    10679     ,input 'overval':U
    10680     ,input  ""
    10681     ,output v-value-character
    10682     ,output v-value-date
    10683     ,output v-value-decimal
    10684     ,output v-value-integer
    10685     ,output v-value-logical
    10686     ,output par-type
    10687     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10688     ) no-error .
    10689       for each thbjattr_thbj-attr
    10690       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10691       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    10692       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    10693       :
    10694         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then do:
    10695           find first buf_rep-line exclusive-lock where
    10696                     buf_rep-line.code1   = ii
    10697                 and buf_rep-line.rep-num = 1996011206
    10698                     no-error .
    10699           if not available buf_rep-line then do:
    10700             create buf_rep-line.
    10701           end.
    10702           assign
    10703           buf_rep-line.code1   = ii
    10704           buf_rep-line.rep-num = 1996011206
    10705           buf_rep-line.code2   = v-host-code
    10706           buf_rep-line.name1   = obj-list.obj-type
    10707           buf_rep-line.code3   = obj-list.obj-code
    10708           buf_rep-line.name2   = thbjattr_thbj-attr.property-value-character
    10709           .
    10710           find first buf_thbj-attr exclusive-locK where
    10711                     buf_thbj-attr.upper-prop-code = 'overval':U
    10712                 and buf_thbj-attr.prop-code = 'pr-goods':U
    10713                 and buf_thbj-attr.obj-type = obj-list.obj-type
    10714                 and buf_thbj-attr.obj-code = obj-list.obj-code no-error.
    10715           if available buf_thbj-attr then do:
    10716             buf_thbj-attr.property-value-character = '1.нет запрета':U .
    10717             buf_rep-line.name3   = "object".
    10718           end.
    10719           else do:
    10720             find first buf_thbj-attr exclusive-locK where
    10721                       buf_thbj-attr.upper-prop-code = 'overval':U
    10722                   and buf_thbj-attr.prop-code = 'pr-goods':U
    10723                   and buf_thbj-attr.obj-type = 'орг':U
    10724                   and buf_thbj-attr.obj-code = v-host-code no-error.
    10725             if available buf_thbj-attr then do:
    10726               buf_thbj-attr.property-value-character = '1.нет запрета':U .
    10727               buf_rep-line.name3   = "host".
    10728             end.
    10729             else do:
    10730               find first buf_thbj-attr exclusive-locK where
    10731                         buf_thbj-attr.upper-prop-code = 'overval':U
    10732                     and buf_thbj-attr.prop-code = 'pr-goods':U
    10733                     and buf_thbj-attr.obj-type = ''
    10734                     and buf_thbj-attr.obj-code = 0 no-error.
    10735               if available buf_thbj-attr then do:
    10736                 buf_thbj-attr.property-value-character = '1.нет запрета':U .
    10737                 buf_rep-line.name3   = "global".
    10738               end.
    10739             end.
    10740           end.
    10741         end.
    10742         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then do:
    10743           find first buf_rep-line exclusive-lock where
    10744                     buf_rep-line.code1   = ii
    10745                 and buf_rep-line.rep-num = 1996011209
    10746                     no-error .
    10747           if not available buf_rep-line then do:
    10748             create buf_rep-line.
    10749           end.
    10750           assign
    10751           buf_rep-line.code1   = ii
    10752           buf_rep-line.rep-num = 1996011209
    10753           buf_rep-line.code2   = v-host-code
    10754           buf_rep-line.name1   = obj-list.obj-type
    10755           buf_rep-line.code3   = obj-list.obj-code
    10756           buf_rep-line.name2   = thbjattr_thbj-attr.property-value-character
    10757           .
    10758           find first buf_thbj-attr exclusive-locK where
    10759                     buf_thbj-attr.upper-prop-code = 'overval':U
    10760                 and buf_thbj-attr.prop-code = 'pr-goods0':U
    10761                 and buf_thbj-attr.obj-type = obj-list.obj-type
    10762                 and buf_thbj-attr.obj-code = obj-list.obj-code no-error.
    10763           if available buf_thbj-attr then do:
    10764             buf_thbj-attr.property-value-character = '1.нет запрета':U .
    10765             buf_rep-line.name3   = "object".
    10766           end.
    10767           else do:
    10768             find first buf_thbj-attr exclusive-locK where
    10769                       buf_thbj-attr.upper-prop-code = 'overval':U
    10770                   and buf_thbj-attr.prop-code = 'pr-goods0':U
    10771                   and buf_thbj-attr.obj-type = 'орг':U
    10772                   and buf_thbj-attr.obj-code = v-host-code no-error.
    10773             if available buf_thbj-attr then do:
    10774               buf_thbj-attr.property-value-character = '1.нет запрета':U .
    10775               buf_rep-line.name3   = "host".
    10776             end.
    10777             else do:
    10778               find first buf_thbj-attr exclusive-locK where
    10779                         buf_thbj-attr.upper-prop-code = 'overval':U
    10780                     and buf_thbj-attr.prop-code = 'pr-goods0':U
    10781                     and buf_thbj-attr.obj-type = ''
    10782                     and buf_thbj-attr.obj-code = 0 no-error.
    10783               if available buf_thbj-attr then do:
    10784                 buf_thbj-attr.property-value-character = '1.нет запрета':U .
    10785                 buf_rep-line.name3   = "global".
    10786               end.
    10787             end.
    10788           end.
    10789         end.
    10790       end.
    10791     end.
    10792   end.
    10793   end procedure.
    10794   define variable v-classif-name as character no-undo .
    10795   define variable v-cli-classif-name as character no-undo .
    10796   on WRITE of ub.goods          override do: end.
    10797   define temp-table gds-list2 no-undo
    10798   field gds-code as integer
    10799   index pi gds-code
    10800   .
    10801   define buffer new_goods for ub.goods  .
    10802   empty temp-table gds-list2.
    10803   case p-from-version:
    10804     when 'v15_0000':U then do:
    10805       assign
    10806       v-classif-name = 'th-th150_goods':U
    10807       v-cli-classif-name = 'th-th150_clients':U
    10808       .
    10809     end.
    10810     when 'v14_0':U then do:
    10811       assign
    10812       v-classif-name = 'th-th14_goods':U
    10813       v-cli-classif-name = 'th-th14_clients':U
    10814       .
    10815     end.
    10816   end case.
    10817   if connected ("src") then do:
    10818     disconnect src.
    10819   end.
    10820   run save-conf-pari this-procedure .
    10821   for each new_goods exclusive-lock where
    10822            new_goods.stts > 0 :
    10823    find first gds-list2  where  gds-list2.gds-code = new_goods.gds-code no-error .
    10824    if not available gds-list2 then do:
    10825      create gds-list2 .
    10826      assign
    10827      gds-list2.gds-code = new_goods.gds-code
    10828      .
    10829    end.
    10830    new_goods.stts = 0 .
    10831   end.
    10832   for each buf_price-doc-forming no-lock where
    10833           buf_price-doc-forming.stts = 0
    10834   by buf_price-doc-forming.pdf-id :
    10835     run str/diallog.w (
    10836             input parparentproc
    10837           , input this-procedure
    10838           , input 'str/pdf-clos.p':U
    10839           , ( string(recid( buf_price-doc-forming )) + chr(4) +
    10840              'no' + chr(4) +
    10841              'no' + chr(4) +
    10842              '?' + chr(4) +
    10843              '?' + chr(4) +
    10844               'факт':U + chr(4) +
    10845               '?' + chr(4) +
    10846               string( false )  )
    10847           , input yes
    10848           , input '':U
    10849           , input 'Закрытие ДНЦ') no-error .
    10850   end.
    10851   for each gds-list2 :
    10852     find first ub.goods exclusive-lock where
    10853               ub.goods.gds-code = gds-list2.gds-code no-error .
    10854     if available ub.goods then do:
    10855       ub.goods.stts  = 1 .
    10856     end.
    10857   end.
    10858   run re-save-conf-par in this-procedure .
