     7567   define variable bbb   as logical no-undo .
     7568   define variable l-price-sale like ub.price-list.price-sale no-undo .
     7569   define variable l-road-tax   like ub.price-list.road-tax   no-undo .
     7570   define variable l-excise     like ub.price-list.excise     no-undo .
     7571   define variable l-ok          as logical no-undo .
     7572   define variable check-par     as logical no-undo .
     7573   define variable main-b-code   as integer no-undo .
     7574   define variable par-pr-equ-dq as integer no-undo .
     7575   define variable v-price-sale  as decimal no-undo .
     7576   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7577   empty temp-table thbjattr_thbj-attr.
     7578   run adm/shattri.p (
     7579      input "get":U
     7580     ,input v-cntxt-obj-type
     7581     ,input v-cntxt-obj-code
     7582     ,input 'overval':U
     7583     ,input  ""
     7584     ,output v-value-character
     7585     ,output v-value-date
     7586     ,output v-value-decimal
     7587     ,output v-value-integer
     7588     ,output v-value-logical
     7589     ,output par-type
     7590     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     7591     ) no-error .
     7592   for each thbjattr_thbj-attr :
     7593       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     7594   end.
     7595   if par-pr-equ-dq = 1 then return .
     7596   for each pdf_price-list exclusive-lock where
     7597            pdf_price-list.plt-id     = p-plt-id     and
     7598            pdf_price-list.plt-db-num = p-plt-db-num and
     7599            pdf_price-list.pdf-id     = p-pdf-id     and
     7600            pdf_price-list.pdf-db     = p-pdf-db     by pdf_price-list.line-num
     7601           :
     7602       if not (pdf_price-list.b-code     = f-base-code (pdf_price-list.b-code) ) then next .
     7603       check-par = false .
     7604      find first x_obj-group no-error .
     7605   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7607     (input  x_obj-group.obj-type
     7608     ,input  x_obj-group.obj-code
     7609     ,input  pdf_price-list.b-code
     7610     ,input  0
     7611     ,input  0
     7612     ,output l-doc-num2
     7613     ,output l-price-sale
     7614     ,output l-road-tax
     7615     ,output l-excise
     7616     ) no-error .
     7617       v-price-sale = l-price-sale .
     7618      for each x_obj-group :
     7619   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7621     (input  x_obj-group.obj-type
     7622     ,input  x_obj-group.obj-code
     7623     ,input  pdf_price-list.b-code
     7624     ,input  0
     7625     ,input  0
     7626     ,output l-doc-num2
     7627     ,output l-price-sale
     7628     ,output l-road-tax
