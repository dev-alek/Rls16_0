     9522             ub.price-list-type.plt-main-db-num                = if p-plt-main-id = 0 then p-db-num else p-plt-main-db-num
     9523             ub.price-list-type.plt-main-id                    = if p-plt-main-id = 0 then p-id else p-plt-main-id
     9524             ub.price-list-type.priority                       = p-priority
     9525             ub.price-list-type.rs-buyer                       = p-rs-buyer
     9526             ub.price-list-type.send-cassa                     = p-send-cassa
     9527             ub.price-list-type.under-hand-corr                = p-under-hand-corr
     9528             ub.price-list-type.under-round-method             = p-under-round-method
     9529             ub.price-list-type.under-perc                     = p-under-perc
     9530             ub.price-list-type.under-type-list                = p-under-type-list
     9531             ub.price-list-type.use-cassa                      = p-use-cassa
     9532             ub.price-list-type.use-gds-group                  = p-use-gds-group
     9533             ub.price-list-type.use-obj                        = p-use-obj
     9534             ub.price-list-type.work-date                      = p-work-date
     9535             ub.price-list-type.bgr-db-num                     = p-bgr-db-num
     9536             ub.price-list-type.bgr-id                         = p-bgr-id
     9537             ub.price-list-type.curr-code                      = p-curr-code
     9538             ub.price-list-type.gop-db-num                     = p-gop-db-num
     9539             ub.price-list-type.gop-db-num-for-calc-turnover   = p-gop-db-num-for-calc-turnover
     9540             ub.price-list-type.gop-id                         = p-gop-id
     9541             ub.price-list-type.gop-id-for-calc-turnover       = p-gop-id-for-calc-turnover
     9542             ub.price-list-type.qgr-db-num                     = p-qgr-db-num
     9543             ub.price-list-type.qgr-id                         = p-qgr-id
     9544             ub.price-list-type.sgr-db-num                     = p-sgr-db-num
     9545             ub.price-list-type.sgr-id                         = p-sgr-id
     9546             ub.price-list-type.tog-db-num                     = p-tog-db-num
     9547             ub.price-list-type.tog-id                         = p-tog-id
     9548             ub.price-list-type.obj-turnover                   = p-obj-turnover
     9549             ub.price-list-type.ttg-summa                      = p-ttg-summa
     9550             ub.price-list-type.have-rs-turn-group             =   p-have-rs-turn-group
     9551             ub.price-list-type.have-tog-db-num                =   p-have-tog-db-num
     9552             ub.price-list-type.have-tog-id                    =   p-have-tog-id
     9553             ub.price-list-type.use-cash-pay                   =   p-use-cash-pay
     9554             ub.price-list-type.use-pay-type                   =   p-use-pay-type
     9555             ub.price-list-type.stts                           = integer('0':U)
     9556             ub.price-list-type.sys-date                       = today
     9557             ub.price-list-type.sys-time                       = time
     9558             ub.price-list-type.sys-time-chr                   = string ( ub.price-list-type.sys-time,"hh:mm" )
     9559             ub.price-list-type.who                            = p-userid
     9560             ub.price-list-type.db-num-chg                     = p-db-num-usr
     9561             p-recid = recid ( ub.price-list-type )
     9562         .
     9563     if p-use-cassa < 3 then do:
     9564        for each tt_cassa : delete tt_cassa . end.
     9565     end.
     9566     if p-use-gds-group = 0  then do:
     9567        for each tt_grp : delete tt_grp . end.
     9568     end.
     9569     for each ub.price-list-type-gds-grp exclusive-lock where
     9570              ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
     9571              ub.price-list-type-gds-grp.plt-id      = p-id :
     9572          if not can-find (first  tt_grp where tt_grp.node-code = ub.price-list-type-gds-grp.node-code ) then
     9573          ub.price-list-type-gds-grp.stts   = integer('1':U) .
     9574     end.
     9575     for each tt_grp :
     9576         find first  ub.price-list-type-gds-grp exclusive-lock where
     9577                 ub.price-list-type-gds-grp.node-code  = tt_grp.node-code and
     9578                 ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
     9579                 ub.price-list-type-gds-grp.plt-id      = p-id no-error .
     9580         if not available ub.price-list-type-gds-grp then do:
     9581                create ub.price-list-type-gds-grp.
     9582                 assign
     9583                   ub.price-list-type-gds-grp.node-code  = tt_grp.node-code
     9584                   ub.price-list-type-gds-grp.plt-db-num     = p-db-num
     9585                   ub.price-list-type-gds-grp.plt-id         = p-id
     9586                   ub.price-list-type-gds-grp.stts       = integer('0':U)
     9587                   ub.price-list-type-gds-grp.sys-date     = today
     9588                   ub.price-list-type-gds-grp.sys-time     = time
     9589                   ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
     9590                   ub.price-list-type-gds-grp.who          = p-userid
     9591                   ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
     9592                 .
     9593                end.
     9594         else do:
     9595            assign
     9596             ub.price-list-type-gds-grp.stts   = integer('0':U)
     9597             ub.price-list-type-gds-grp.sys-date     = today
     9598             ub.price-list-type-gds-grp.sys-time     = time
     9599             ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
     9600             ub.price-list-type-gds-grp.who          = p-userid
     9601             ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
     9602            .
     9603         end.
     9604     end.
     9605     for each ub.price-list-type-cassa exclusive-lock where
     9606              ub.price-list-type-cassa.plt-db-num  = p-db-num and
     9607              ub.price-list-type-cassa.plt-id      = p-id :
