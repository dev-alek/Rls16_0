     4761             output vd  ,
     4762             output cost-base   ,
     4763             output cost-rubl   ,
     4764             output cur-rt-base ,
     4765             output cur-rt-rubl
     4766             ).
     4767      end.
     4768      when 'Накладная':U then do:
     4769           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = v-doc-code no-error .
     4770           find first buf_doc-line  no-lock where
     4771                     buf_doc-line.doc-code = v-doc-code      and
     4772                     buf_doc-line.artic    = p-artic         and
     4773                     buf_doc-line.prod-type   = p-prod-type  and
     4774                     buf_doc-line.prod-code   = p-prod-code no-error .
     4775           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     4776           find first buf_gds-dtl no-lock where
     4777                      buf_gds-dtl.doc-code  = v-doc-code   and
     4778                      buf_gds-dtl.artic     = p-artic      and
     4779                      buf_gds-dtl.prod-type = p-prod-type  and
     4780                      buf_gds-dtl.prod-code = p-prod-code  and
     4781                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     4782           assign
     4783             v1 = recid (buf_trn-doc)
     4784             v2 = recid (buf_doc-line)
     4785             v3 = recid (buf_gds-dtl)
     4786             v4  = buf_gds-dtl.prt-code
     4787             no-error .
