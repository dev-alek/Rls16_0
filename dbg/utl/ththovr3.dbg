     4642   p-vat-pc  = local_vat-pc .
     4643   p-slt-pc  = local_slt-pc .
     4644     if available buf_price-doc-forming then do:
     4645        find first buf_price-list-type no-lock where
     4646                   buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id    and
     4647                   buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num
     4648                   no-error .
     4649        if error-status :error then return error return-value .
     4650     end.
     4651     else do:
     4652   find first buf_price-list-type no-lock where
     4653              buf_price-list-type.plt-id     = v-plt-id    and
     4654              buf_price-list-type.plt-db-num = v-plt-db-num
     4655              no-error .
     4656      if error-status :error then return error return-value .
     4657     end.
     4658   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4659   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-mpl in g#library2
     4660     (input  buf_price-list-type.gop-id
     4661     ,input  buf_price-list-type.gop-db-num
     4662     ,input  p-b-code
     4663     ,input  0
     4664     ,input  0
     4665     ,output v1-recid
     4666     ,output p-price-prev-doc
     4667     ,output v1-cur-rt
     4668     ,output v1-cur-ex
     4669     ) no-error .
     4670       if error-status :error then
     4671       message
     4672         vss-workfile vss-revision vss-description skip
     4673         error-status :get-message(1) skip
     4674         return-value skip
     4675         "bc-mpl"
     4676         view-as alert-box error
     4677       .
     4678   define buffer old1_price-doc-forming     for ub.price-doc-forming  .
     4679   define buffer old1_price-doc-forming-gds for ub.price-doc-forming-gds  .
     4680   find first old1_price-doc-forming no-lock where
     4681              recid(old1_price-doc-forming) = v1-recid no-error .
     4682   find first old1_price-doc-forming-gds no-lock where
     4683              old1_price-doc-forming-gds.pdf-db      = old1_price-doc-forming.pdf-db      and
     4684              old1_price-doc-forming-gds.pdf-id      = old1_price-doc-forming.pdf-id      and
     4685              old1_price-doc-forming-gds.plt-db-num  = old1_price-doc-forming.plt-db-num  and
     4686              old1_price-doc-forming-gds.plt-id      = old1_price-doc-forming.plt-id      and
     4687              old1_price-doc-forming-gds.b-code      = p-b-code
     4688              no-error .
     4689   if available old1_price-doc-forming-gds then do:
     4690      p-d-pcnt = old1_price-doc-forming-gds.d-pcnt .
     4691   end.
     4692   else do:
     4693     p-d-pcnt = 0 .
     4694   end.
     4695   case p-calc-method :
     4696      when 'Новая':U or
     4697      when 'Не-считать':U then do:
     4698       assign
     4699         p-new-calc-method = p-calc-method
     4700         cost-rubl = ?
     4701         cost-base = ?
     4702       .
     4703         if available buf_price-doc-forming then do:
     4704           assign
     4705             v-pdf-id      = buf_price-doc-forming.pdf-id
     4706             v-pdf-db-num  = buf_price-doc-forming.pdf-db
     4707             v-plt-id2     = buf_price-doc-forming.plt-id
     4708             v-plt-db-num2 = buf_price-doc-forming.plt-db-num
     4709           .
     4710           find first buf_buf_price-doc-forming-gds no-lock where
     4711                 buf_buf_price-doc-forming-gds.pdf-id =  v-pdf-id and
     4712                 buf_buf_price-doc-forming-gds.pdf-db =  v-pdf-db-num and
     4713                 buf_buf_price-doc-forming-gds.plt-id =  v-plt-id2     and
     4714                 buf_buf_price-doc-forming-gds.plt-db-num =  v-plt-db-num2 and
     4715                 buf_buf_price-doc-forming-gds.b-code =  p-b-code
     4716                 no-error .
     4717               if available buf_buf_price-doc-forming-gds then do:
     4718                   assign
     4719                     cost-rubl = buf_buf_price-doc-forming-gds.price-sale-rubl
     4720                     cost-base = buf_buf_price-doc-forming-gds.price-sale-base
     4721                   .
     4722               end.
     4723         end.
     4724      end.
     4725      when 'УчетнаяS':U  or
     4726      when 'Учет-рзрвS':U  or
     4727      when 'ПриходнаяS':U
     4728      then do:
     4729         run str/sgdsavrg.p
     4730         (   input  p-calc-method    ,
     4731             input  table x_obj-group ,
     4732             input  p-b-code    ,
     4733             input  p-artic     ,
     4734             input  p-prod-type ,
     4735             input  p-prod-code ,
     4736             output cost-base   ,
     4737             output cost-rubl   ,
     4738             output cur-rt-base ,
     4739             output cur-rt-rubl
     4740             ).
     4741      end.
     4742      when 'Учет-НДСS':U or
     4743      when 'Накл-безНДС':U or
     4744      when 'Стар-безНДС':U or
     4745      when 'Старая':U or
     4746      when 'Учет+накл':U or
     4747      when 'Уч+накл-НДС':U or
     4748      when 'Откат_цен':U then do:
     4749         run str/mplnovat.p
     4750           ( input  p-calc-method    ,
     4751             input  table x_obj-group ,
     4752             input  p-b-code    ,
     4753             input  p-artic     ,
     4754             input  p-prod-type ,
     4755             input  p-prod-code ,
     4756             input  0 ,
