     9101   define variable v-sec as integer   no-undo .
     9102   PROCEDURE obji-add :
     9103   define input  parameter p-db-num       as integer   no-undo .
     9104   define input  parameter p-id           as integer   no-undo .
     9105   define input  parameter p-dgo-db-num   as integer   no-undo .
     9106   define input  parameter p-stts         as integer   no-undo .
     9107   define input  parameter p-db-num-usr   as integer   no-undo .
     9108   define input  parameter p-userid       as character no-undo .
     9109   define output parameter p-recid as recid no-undo .
     9110     do
     9111     on error undo, return error return-value
     9112     :
     9113   find first ub.grp-obj-price exclusive-lock where
     9114           ub.grp-obj-price.gop-db-num   = p-db-num  and
     9115           ub.grp-obj-price.gop-id       = p-id
     9116           no-error .
     9117     if error-status :error then do:
     9118         message
     9119           vss-workfile vss-revision vss-description skip
     9120           error-status :get-message(1) skip
     9121           return-value skip
     9122           ""
     9123           view-as alert-box error
     9124         .
     9125         return error .
     9126     end.
     9127   find first ub.db-grp-obj-price exclusive-lock where
     9128           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
     9129           ub.db-grp-obj-price.gop-id       = p-id      and
     9130           ub.db-grp-obj-price.dgo-db-num   = p-dgo-db-num
     9131           no-error .
     9132         if not available ub.db-grp-obj-price then do:
     9133             create ub.db-grp-obj-price.
     9134               assign
     9135                   ub.db-grp-obj-price.gop-db-num = p-db-num
     9136                   ub.db-grp-obj-price.gop-id     = p-id
     9137                   ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
     9138               .
     9139         end.
     9140         assign
     9141           ub.db-grp-obj-price.num-chg    = p-db-num-usr
     9142           ub.db-grp-obj-price.stts          = p-stts
     9143           ub.db-grp-obj-price.sys-date      = today
     9144           ub.db-grp-obj-price.sys-time      = time
     9145           ub.db-grp-obj-price.sys-time-chr  = string ( ub.db-grp-obj-price.sys-time,"hh:mm" )
     9146           ub.db-grp-obj-price.who           = p-userid
     9147           p-recid = recid ( ub.db-grp-obj-price )
     9148         .
     9149         ub.grp-obj-price.sys-time = time .
     9150         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
     9151     end.
     9152   end procedure.
     9153   PROCEDURE obji-del :
     9154   define input  parameter p-db-num       as integer   no-undo .
     9155   define input  parameter p-id           as integer   no-undo .
     9156   define input  parameter p-dgo-db-num   as integer   no-undo .
     9157   define input  parameter p-db-num-usr   as integer   no-undo .
     9158   define input  parameter p-userid       as character no-undo .
     9159     do
     9160     on error undo, return error return-value
     9161     :
     9162   find first ub.grp-obj-price exclusive-lock where
     9163           ub.grp-obj-price.gop-db-num   = p-db-num  and
     9164           ub.grp-obj-price.gop-id       = p-id
     9165           .
     9166   find first ub.db-grp-obj-price exclusive-lock where
     9167           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
     9168           ub.db-grp-obj-price.gop-id       = p-id      and
     9169           ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
     9170           no-error .
     9171    if not available ub.db-grp-obj-price then  return error .
     9172         assign
     9173           ub.db-grp-obj-price.num-chg    = p-db-num-usr
     9174           ub.db-grp-obj-price.stts          = 1
     9175           ub.db-grp-obj-price.sys-date      = today
     9176           ub.db-grp-obj-price.sys-time      = time
     9177           ub.db-grp-obj-price.sys-time-chr  = string(ub.db-grp-obj-price.sys-time,"hh:mm")
     9178           ub.db-grp-obj-price.who           = p-userid
     9179         .
     9180         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
     9181         ub.grp-obj-price.sys-time = time .
     9182     end.
     9183   end procedure.
     9184   PROCEDURE objf-add :
     9185   define input  parameter p-db-num       as integer   no-undo .
     9186   define input  parameter p-id           as integer   no-undo .
     9187   define input  parameter p-host-code    as integer   no-undo .
     9188   define input  parameter p-stts         as integer   no-undo .
     9189   define input  parameter p-db-num-usr   as integer   no-undo .
     9190   define input  parameter p-userid       as character no-undo .
     9191   define output parameter p-recid as recid no-undo .
     9192     do
     9193     on error undo, return error return-value
     9194     :
     9195   find first ub.sysconf no-lock where recid(ub.sysconf) = p-host-code .
     9196   if available ub.sysconf then do:
     9197      p-host-code = ub.sysconf.host-code .
     9198   end.
     9199   find first ub.grp-obj-price exclusive-lock where
     9200           ub.grp-obj-price.gop-db-num   = p-db-num  and
     9201           ub.grp-obj-price.gop-id       = p-id
     9202           .
     9203   find first ub.host-grp-obj-price exclusive-lock where
     9204           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
     9205           ub.host-grp-obj-price.gop-id       = p-id      and
     9206           ub.host-grp-obj-price.host-code    = p-host-code
     9207           no-error .
     9208         if not available ub.host-grp-obj-price then do:
     9209             create ub.host-grp-obj-price.
     9210               assign
     9211                   ub.host-grp-obj-price.gop-db-num   = p-db-num
     9212                   ub.host-grp-obj-price.gop-id       = p-id
     9213                   ub.host-grp-obj-price.host-code    = p-host-code
     9214               .
     9215         end.
     9216         assign
     9217           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
     9218           ub.host-grp-obj-price.stts          = p-stts
     9219           ub.host-grp-obj-price.sys-date      = today
     9220           ub.host-grp-obj-price.sys-time      = time
     9221           ub.host-grp-obj-price.sys-time-chr  = string ( ub.host-grp-obj-price.sys-time,"hh:mm" )
     9222           ub.host-grp-obj-price.who           = p-userid
     9223           p-recid = recid ( ub.host-grp-obj-price )
     9224         .
     9225         ub.grp-obj-price.sys-time = time .
     9226         run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
     9227     end.
     9228   end procedure.
