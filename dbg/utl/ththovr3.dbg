      623   .
      624   procedure create_obj-list :
      625      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      626      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      627      do
      628      on error undo, return error return-value
      629      :
      630         define buffer cli-obj for ub.clients .
      631         define variable p-var as integer no-undo .
      632         define buffer buf_obj-list for obj-list .
      633         find last buf_obj-list  use-index pi no-error .
      634         if available buf_obj-list
      635         then
      636            p-var = buf_obj-list.obj-id + 1.
      637         else
      638            p-var = 1.
      639         find first cli-obj where
      640                   cli-obj.obj-type = p-obj-type
      641               and cli-obj.obj-code = p-obj-code
      642         no-lock no-error.
      643         if available cli-obj
      644         then do:
      645            create buf_obj-list.
      646            assign
      647               buf_obj-list.obj-id   = p-var
      648               buf_obj-list.obj-code = cli-obj.obj-code
      649               buf_obj-list.obj-type = cli-obj.obj-type
      650               buf_obj-list.obj-name = cli-obj.obj-name
      651               buf_obj-list.db-num   = cli-obj.db-num
      652            .
      653         end.
      654      end.
      655   end.
      656   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
