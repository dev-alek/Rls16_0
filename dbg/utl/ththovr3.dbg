     9689     for each ub.price-list-type-cash-pay exclusive-lock where
     9690              ub.price-list-type-cash-pay.plt-db-num  = p-db-num and
     9691              ub.price-list-type-cash-pay.plt-id      = p-id :
     9692          if not can-find (first tt_cash-pay where
