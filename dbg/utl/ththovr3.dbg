      692   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   define temp-table x_obj-group no-undo like ub.clients  .
      694   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      695   procedure metod-gop-obj :
      696     do
      697     on error undo, return error return-value
      698     :
      699   define input  parameter p-cntxt-db-num as integer   no-undo .
      700   define input  parameter p-gop-id       as integer   no-undo .
      701   define input  parameter p-gop-db-num   as integer   no-undo .
      702   define buffer buf1_clients for ub.clients  .
      703   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      704   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      705   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      706   for each  x_obj-group : delete x_obj-group. end.
      707   if p-gop-id = 0 or p-gop-id = ?  then do:
      708      if p-cntxt-db-num = 0  then do:
      709           for each buf1_clients no-lock where
      710                   (buf1_clients.obj-type = 'маг':U  or
      711                    buf1_clients.obj-type = 'скл':U  )
      712                   and
      713                   buf1_clients.db-num >= 0  and
      714                   buf1_clients.stts = 0
      715                   :
      716             create x_obj-group .
      717             assign
      718               x_obj-group.obj-code   = buf1_clients.obj-code
      719               x_obj-group.obj-type   = buf1_clients.obj-type
      720               x_obj-group.obj-name   = buf1_clients.obj-name
      721               x_obj-group.db-num     = buf1_clients.db-num
      722             .
      723           end.
      724      end.
      725      else do:
      726           for each buf1_clients no-lock where
      727                   (buf1_clients.obj-type = 'маг':U  or
      728                    buf1_clients.obj-type = 'скл':U  ) and
      729                    buf1_clients.db-num = p-cntxt-db-num  and
      730                    buf1_clients.stts = 0
      731                   :
      732             create x_obj-group .
      733             assign
      734               x_obj-group.obj-code   = buf1_clients.obj-code
      735               x_obj-group.obj-type   = buf1_clients.obj-type
      736               x_obj-group.obj-name   = buf1_clients.obj-name
      737               x_obj-group.db-num     = buf1_clients.db-num
      738             .
      739           end.
      740      end.
      741   end.
      742   else do:
      743         for each buf_db-grp-obj-price  where
      744                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      745                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      746                 buf_db-grp-obj-price.stts = 0  no-lock :
      747           for each buf1_clients no-lock where
      748                  (buf1_clients.obj-type = 'маг':U  or
      749                   buf1_clients.obj-type = 'скл':U  ) and
      750                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      751                   buf1_clients.stts = 0
      752                   :
      753             create x_obj-group .
      754             assign
      755               x_obj-group.obj-code   = buf1_clients.obj-code
      756               x_obj-group.obj-type   = buf1_clients.obj-type
      757               x_obj-group.obj-name   = buf1_clients.obj-name
      758               x_obj-group.db-num     = buf1_clients.db-num
      759             .
      760           end.
      761         end.
      762       for each buf_host-grp-obj-price where
      763               buf_host-grp-obj-price.gop-id     = p-gop-id and
      764               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      765               buf_host-grp-obj-price.stts = 0
      766               no-lock :
      767         for each buf1_clients no-lock where
      768                (buf1_clients.obj-type = 'маг':U  or
      769                 buf1_clients.obj-type = 'скл':U  ) and
      770                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      771                 buf1_clients.stts = 0
      772                 :
      773             find first x_obj-group no-lock  where
      774                       x_obj-group.obj-code   = buf1_clients.obj-code and
      775                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      776             if not available  x_obj-group then   create x_obj-group .
      777             assign
      778               x_obj-group.obj-code   = buf1_clients.obj-code
      779               x_obj-group.obj-type   = buf1_clients.obj-type
      780               x_obj-group.obj-name   = buf1_clients.obj-name
      781               x_obj-group.db-num     = buf1_clients.db-num
      782             .
      783         end.
      784       end.
      785       for each buf_obj-grp-obj-price where
      786               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      787               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      788               buf_obj-grp-obj-price.stts = 0
      789               no-lock :
      790         for each buf1_clients no-lock where
      791                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      792                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      793                   buf1_clients.stts     = 0
      794                   :
      795             find first  x_obj-group no-lock  where
      796                         x_obj-group.obj-code   = buf1_clients.obj-code and
      797                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      798             if not available  x_obj-group then   create x_obj-group .
      799             assign
      800               x_obj-group.obj-code   = buf1_clients.obj-code
      801               x_obj-group.obj-type   = buf1_clients.obj-type
      802               x_obj-group.obj-name   = buf1_clients.obj-name
      803               x_obj-group.db-num     = buf1_clients.db-num
      804             .
      805         end.
      806       end.
      807   end.
      808   end.
      809   end procedure.
      810   procedure metod-obj-in-gop :
      811   define input  parameter p-curr-db-num as integer   no-undo .
      812   define input  parameter p-obj-type as character no-undo .
      813   define input  parameter p-obj-code as integer   no-undo .
      814   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      815     do
      816     on error undo, return error return-value
      817     :
      818       empty temp-table x_grp-obj-price.
      819       for each buf_grp-obj-price where
      820                buf_grp-obj-price.stts = 0
      821                no-lock :
      822                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      823                  for each x_obj-group where
      824                           x_obj-group.obj-type = p-obj-type and
      825                           x_obj-group.obj-code = p-obj-code :
      826                       create  x_grp-obj-price.
      827                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      828                  end.
      829       end.
      830     end.
      831   end procedure.
      832   procedure metod-delobj-usr :
      833   define input  parameter p-pdf-id  as integer   no-undo .
      834   define input  parameter p-pdf-db  as integer   no-undo .
      835   define input  parameter p-plt-id  as integer   no-undo .
      836   define input  parameter p-plt-db-num as integer   no-undo .
      837   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      838     do
      839     on error undo, return error return-value
      840     :
      841   for each buf_price-doc-forming-attr no-lock  where
      842            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      843            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      844            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      845            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      846            buf_price-doc-forming-attr.attr-code begins "obj" :
      847      for each x_obj-group  where
      848               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      849               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      850        delete x_obj-group.
      851      end.
      852   end.
      853     if not can-find (first x_obj-group) then do:
      854        return "nullobj" .
      855     end.
      856   end.
      857   end procedure.
      858   procedure metod-obj-pdf :
      859   define input  parameter p-cntxt-db-num as integer   no-undo .
      860   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      861   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      862   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      863   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      864   define buffer buf_price-list-type for ub.price-list-type  .
      865   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      866     do
      867     on error undo, return error return-value
      868     :
      869    for each  x_obj-group : delete x_obj-group. end.
      870    find first buf_price-list-type no-lock where
      871               buf_price-list-type.plt-id = p-plt-id and
      872               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      873   if error-status :error then return error return-value .
      874    find first buf_price-doc-forming no-lock where
      875               buf_price-doc-forming.plt-id     = p-plt-id and
      876               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      877               buf_price-doc-forming.pdf-id     = p-pdf-id and
      878               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      879               no-error .
      880   if error-status :error then return error return-value .
      881     run metod-gop-obj in this-procedure (
      882         p-cntxt-db-num,
      883         buf_price-list-type.gop-id ,
      884         buf_price-list-type.gop-db-num
      885         ) no-error .
      886     run metod-delobj-usr in this-procedure (
      887       buf_price-doc-forming.pdf-id ,
      888       buf_price-doc-forming.pdf-db ,
      889       buf_price-doc-forming.plt-id ,
      890       buf_price-doc-forming.plt-db-num
      891       ) no-error .
      892     end.
      893   end procedure.
      894   function hvrdtax return logical (input parrecid as recid):
      895   define variable varresult as logical no-undo.
      896   run hvrdtax-proc (input parrecid, output varresult).
      897   return varresult.
      898   end function.
      899   procedure hvrdtax-proc:
      900   define input  parameter parrecid  as recid   no-undo.
      901   define output parameter parresult as logical no-undo.
      902   define buffer bf_goods for ub.goods.
      903   define buffer bf_units for ub.units.
      904   define buffer rt_tax   for ub.tax.
      905   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      906   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      907   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      908   if available rt_tax and
      909       can-find(first ub.tax-units No-LOCK WHERE
      910                      ub.tax-units.tax-code = rt_tax.tax-code AND
      911                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      912                                                       else assign parresult = no.
      913   end procedure.
      914   define new global shared variable g#lib-trn  as handle no-undo .
      915   define new global shared variable g#lib-trn2 as handle no-undo .
      916   define new global shared variable g#lib-trn3 as handle no-undo .
      917   define new global shared variable g#lib-trn4 as handle no-undo .
      918   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   procedure doc-code:
      920   define input  parameter parmode          as   character           no-undo.
      921   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      922   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      923   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      924   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      925   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      926   define variable vardb-remote     as   logical             no-undo.
      927   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      928   define variable v-delimiter as character no-undo .
      929   do
      930   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      931   :
      932   find first buf_sys-ctrl no-lock .
      933   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      934     CASE parmode:
      935       when "main":u then do:
      936         if vardb-remote then do:
      937           assign
      938             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      939         end.
      940         else do:
      941           assign
      942             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      943         end.
      944       end.
      945       when "trio" then do:
      946         assign
      947           pardoc-code = replace (parroot-doc-code, "=", "*").
      948       end.
      949       otherwise do:
      950         assign
      951         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      952         no-error
      953         .
      954         if error-status:error  then do:
      955           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      956                                         ,chr(10)
      957                                         ,parmode
      958                                         ).
      959         end.
      960         if num-entries(parmode) = 1
      961         and parmode <> "chip":U
      962         and parmode <> "chip_s":U
      963         then do:
      964           assign
      965           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      966         end.
      967         else if (lookup("chip":U, parmode) > 0
      968                  or
      969                  lookup("chip_s":U, parmode) > 0) then do:
      970           assign
      971             vartemp-doc-code = parroot-doc-code.
      972           do while true:
      973             if index (vartemp-doc-code , ".") = 0 then
      974               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      975             else
      976               vartemp-doc-code  =
      977               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      978               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      979               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      980             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      981           end.
      982           assign
      983             pardoc-code = vartemp-doc-code.
      984         end.
      985       end.
      986     end CASE.
      987     if pardoc-code = '':U
      988     or (parroot-doc-code <> '':U
      989     and pardoc-code = parroot-doc-code) then do:
      990       undo, return error substitute("Ошибка при генерации номера документа&1"
      991                                     ,chr(10)).
      992     end.
      993   end.
      994   end. // procedure/method
      995   function get-doc-code-int64 returns int64
      996     ( input p-doc-code as character ) :
      997     define variable v-ind              as integer   no-undo .
      998     define variable v-num-entries      as integer   no-undo .
      999     define variable v-doc-code-int64   as int64     no-undo .
     1000     define variable v-canonic-doc-code as character no-undo .
     1001     assign
     1002       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1003       v-canonic-doc-code = p-doc-code
     1004     .
     1005     do v-ind = 1 to v-num-entries
     1006     :
     1007       assign
     1008         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1009       .
     1010     end.
     1011     assign
     1012       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1013     .
     1014     return v-doc-code-int64 .
     1015   end. // function/method
     1016   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1017   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1018   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     1019                                           local-doc-num as char).
     1020   define buffer base-price        for ub.price-list.
     1021   define variable local-main-code like ub.bar-code.b-code no-undo.
     1022   define variable local-base-code like ub.bar-code.b-code no-undo.
     1023     run prc-base-code (input local-bc, output local-base-code).
     1024     find base-price no-lock where
     1025          base-price.doc-num = local-doc-num and
     1026          base-price.b-code  = local-base-code and
     1027          base-price.price-type = "" no-error.
     1028     if not available base-price then do:
     1029       run prc-main-code (input local-bc, output local-main-code).
     1030       find  base-price no-lock where
     1031             base-price.doc-num = local-doc-num and
     1032             base-price.b-code  = local-main-code and
     1033             base-price.price-type = "" no-error.
     1034     end.
     1035     if available base-price then
     1036       return (base-price.price-sale).
     1037     else
     1038       return (?).
     1039   END FUNCTION.
     1040   procedure prc-main-code:
     1041   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1042   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     1043   define buffer local-bar-code        for ub.bar-code.
     1044   define buffer local-goods           for ub.goods.
     1045   define buffer main-code             for ub.bar-code.
     1046   define buffer main-prt              for ub.gds-prt.
     1047     local-main-code = ?.
     1048     find local-bar-code no-lock where
     1049          local-bar-code.b-code = local-bc no-error.
     1050     if not available local-bar-code then
     1051       return.
     1052     find local-goods no-lock where
     1053          local-goods.gds-code = local-bar-code.gds-code.
     1054     find first  main-prt no-lock where
     1055                 main-prt.upper-code = local-goods.prt-root.
     1056     find  main-code no-lock where
     1057           main-code.gds-code  = local-bar-code.gds-code and
     1058           main-code.in-code   = "" and
     1059           main-code.part-code = "" and
     1060           main-code.unit-cli  = local-goods.unit-base and
     1061           main-code.node-code = main-prt.node-code.
     1062     local-main-code = main-code.b-code.
     1063   end procedure.
     1064   procedure prc-base-code:
     1065   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1066   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     1067   define buffer local-bar-code for ub.bar-code.
     1068   define buffer local-goods    for ub.goods.
     1069   define buffer base-code      for ub.bar-code.
     1070     local-base-code = ?.
     1071     find local-bar-code no-lock where
     1072          local-bar-code.b-code = local-bc no-error.
     1073     if not available local-bar-code then
     1074       return.
     1075     find local-goods no-lock where
     1076          local-goods.gds-code = local-bar-code.gds-code.
     1077     find base-code no-lock where
     1078          base-code.gds-code  = local-bar-code.gds-code and
     1079          base-code.node-code = local-bar-code.node-code and
     1080          base-code.in-code   = local-bar-code.in-code and
     1081          base-code.part-code = local-bar-code.part-code and
     1082          base-code.unit-cli  = local-goods.unit-base.
     1083     local-base-code = base-code.b-code.
     1084   end procedure.
     1085   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1086   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1087   procedure prcreate-new-price-doc :
     1088   do
     1089   on error undo, return error return-value
     1090   :
     1091   define input  parameter p-curr-db-num  as integer   no-undo .
     1092   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     1093   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     1094   define input  parameter p-plt-id       as integer   no-undo .
     1095   define input  parameter p-plt-db-num   as integer   no-undo .
     1096   define input  parameter p-pdf-id       as integer   no-undo .
     1097   define input  parameter p-pdf-db-num   as integer   no-undo .
     1098   define output parameter p-price-doc-recid  as recid                no-undo.
     1099   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     1100   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     1101   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     1102   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     1103   define buffer buf_price-doc-forming for ub.price-doc-forming.
     1104   define buffer buf_price-doc         for ub.price-doc.
     1105   find first buf_price-doc-forming no-lock where
     1106              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1107              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1108              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1109              buf_price-doc-forming.plt-id     = p-plt-id
     1110              no-error .
     1111   if not available buf_price-doc-forming and p-plt-id = ? then do:
     1112      run create_new_price-doc-forming
     1113           ( input p-obj-type ,
     1114             input p-obj-code ,
     1115             output p-pdf-db-num ,
     1116             output p-pdf-id ,
     1117             output p-plt-db-num ,
     1118             output p-plt-id
     1119             ).
     1120       find first buf_price-doc-forming no-lock where
     1121                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1122                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1123                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1124                 buf_price-doc-forming.plt-id     = p-plt-id
     1125                 no-error .
     1126   end.
     1127       create buf_price-doc .
     1128       run doc-code in this-procedure
     1129       (input  "main",
     1130        input  p-obj-type  ,
     1131        input  p-obj-code  ,
     1132        input  ?,
     1133        output buf_price-doc.doc-num) no-error.
     1134       if error-status:error then do:
     1135         message vss-workfile vss-revision vss-description skip
     1136                error-status :get-message(1)
     1137               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     1138         return error.
     1139       end.
     1140   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1142     (input  p-obj-type
     1143     ,input  p-obj-code
     1144     ,output v-host-code
     1145     )  .
     1146       v-obj-current-date  = today .
     1147       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1148           v-base-rate   =  buf_price-doc-forming.base-rate  .
     1149           v-base-scale  =  buf_price-doc-forming.base-scale .
     1150       end.
     1151       else do:
     1152   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1154     (input  v-host-code
     1155     ,input  v-obj-current-date
     1156     ,output v-base-rate
     1157     ,output v-base-scale
     1158     )  .
     1159       end.
     1160      assign
     1161       buf_price-doc.base-rate      = v-base-rate
     1162       buf_price-doc.base-scale     = v-base-scale
     1163       buf_price-doc.cr-db-num      = p-curr-db-num
     1164       buf_price-doc.doc-date       = v-obj-current-date
     1165       buf_price-doc.fact-num       = 0
     1166       buf_price-doc.host-code      = v-host-code
     1167       buf_price-doc.is-corr        = false
     1168       buf_price-doc.is-del         = false
     1169       buf_price-doc.obj-code       = p-obj-code
     1170       buf_price-doc.obj-type       = p-obj-type
     1171       buf_price-doc.out-code       = ""
     1172       buf_price-doc.pdf-db         = p-pdf-db-num
     1173       buf_price-doc.pdf-id         = p-pdf-id
     1174       buf_price-doc.plt-db-num     = p-plt-db-num
     1175       buf_price-doc.plt-id         = p-plt-id
     1176       buf_price-doc.PS             = "@ "
     1177       buf_price-doc.rest-base      = 0
     1178       buf_price-doc.rest-last      = 0
     1179       buf_price-doc.rest-qnty      = 0
     1180       buf_price-doc.rest-sale      = 0
     1181       buf_price-doc.sale-base      = 0
     1182       buf_price-doc.status_        = 'новый':U
     1183       .
     1184       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     1185       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     1186       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     1187       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     1188       assign
     1189           p-price-doc-recid = recid ( buf_price-doc )
     1190       .
     1191   end.
     1192   end procedure.
     1193   procedure prcreate-new-price-list :
     1194   do
     1195   on error undo, return error return-value
     1196   :
     1197   define input parameter p-price-doc-recid   as recid                    no-undo.
     1198   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     1199   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     1200   define output parameter p-update           as logical                  no-undo.
     1201   define variable kk as integer no-undo .
     1202   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1203   define variable p-hostcode as int no-undo .
     1204   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1205   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1206   define buffer buf_price-doc        for ub.price-doc.
     1207   define buffer buf_price-list       for ub.price-list.
     1208   define buffer buf_bar-code         for ub.bar-code.
     1209   define buffer buf_goods            for ub.goods.
     1210   define buffer buf_root_gds-prt     for ub.gds-prt.
     1211   define buffer buf_gds-prt          for ub.gds-prt.
     1212   find first buf_price-doc no-lock
     1213        where recid( buf_price-doc ) = p-price-doc-recid
     1214   .
     1215   find first buf_goods no-lock
     1216        where buf_goods.gds-code = p-gds-code
     1217   .
     1218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1219     (input  p-gds-code
     1220     ,input  ?
     1221     ,output v-b-code
     1222     ) no-error .
     1223   if error-status :error
     1224   then do:
     1225       message
     1226           "Не найден основной бар-код"
     1227           skip "для товара "
     1228           skip string(buf_goods.artic)
     1229           skip buf_goods.gds-name
     1230       view-as alert-box
     1231       title "Ошибка при выполнении prcreate.i".
     1232       undo, return error .
     1233   end.
     1234   find first buf_bar-code no-lock
     1235        where buf_bar-code.b-code = v-b-code
     1236   no-error.
     1237   if error-status :error
     1238   then do:
     1239       message
     1240           "Не найдена запись bar-code"
     1241           skip "для товара "
     1242           skip string(buf_goods.artic)
     1243           skip buf_goods.gds-name
     1244           skip "С основным бар-кодом"
     1245           skip string(v-b-code)
     1246       view-as alert-box
     1247       title "Ошибка при выполнении prcreate.i".
     1248       undo, return error .
     1249   end.
     1250   find first buf_root_gds-prt no-lock
     1251        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1252   .
     1253   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1254     and buf_bar-code.in-code <> ""
     1255   then do:
     1256       message
     1257           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1258           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1259           view-as alert-box error.
     1260       undo, return error.
     1261   end.
     1262   find first buf_gds-prt no-lock
     1263        where buf_gds-prt.node-code = buf_bar-code.node-code
     1264   .
     1265   find first buf_price-list
     1266        where buf_price-list.doc-num = buf_price-doc.doc-num
     1267          and buf_price-list.b-code  = v-b-code
     1268   no-error.
     1269   if available buf_price-list
     1270   then do:
     1271       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1272          skip "  Цена:   " buf_price-list.price-sale
     1273          skip "Цена будет изменена"
     1274       view-as alert-box warning.
     1275       assign
     1276           p-update = yes
     1277       .
     1278   end.
     1279   else do:
     1280   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1281   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1282     (input  buf_price-doc.obj-type
     1283     ,input  buf_price-doc.obj-code
     1284     ,output p-hostcode
     1285     ) no-error .
     1286   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1288     (input  buf_goods.gds-code
     1289     ,input  '1':U
     1290     ,input  ?
     1291     ,input  p-hostcode
     1292     ,input  buf_price-doc.obj-type
     1293     ,input  buf_price-doc.obj-code
     1294     ,output local_vat-pc
     1295     ) no-error .
     1296   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1298     (input  buf_goods.gds-code
     1299     ,input  '2':U
     1300     ,input  ?
     1301     ,input  p-hostcode
     1302     ,input  buf_price-doc.obj-type
     1303     ,input  buf_price-doc.obj-code
     1304     ,output local_slt-pc
     1305     ) no-error .
     1306       kk = kk + 1.
     1307   define variable v-main-bar-code as integer   no-undo .
     1308   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1309     (input  buf_goods.gds-code
     1310     ,input  ?
     1311     ,output v-main-bar-code
     1312     )  .
     1313       create buf_price-list.
     1314       assign
     1315           buf_price-list.line-num    = kk
     1316           buf_price-list.doc-num     = buf_price-doc.doc-num
     1317           buf_price-list.b-code      = buf_bar-code.b-code
     1318           buf_price-list.artic       = buf_goods.artic
     1319           buf_price-list.prod-type   = buf_goods.prod-type
     1320           buf_price-list.prod-code   = buf_goods.prod-code
     1321           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1322           buf_price-list.calc-method = 'Отсутствует':U
     1323           buf_price-list.obj-type    = buf_price-doc.obj-type
     1324           buf_price-list.obj-code    = buf_price-doc.obj-code
     1325           buf_price-list.price-sale  = p-price-sale
     1326           buf_price-list.vat-pc      = local_vat-pc
     1327           buf_price-list.slt-pc      = local_slt-pc
     1328           p-update                   = no
     1329       .
     1330   end.
     1331   end.
     1332   end procedure.
     1333   procedure create_new_price-doc-forming :
