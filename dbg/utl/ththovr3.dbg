     9629                   ub.price-list-type-cassa.plt-id       = p-id
     9630                   ub.price-list-type-cassa.stts         = integer('0':U)
     9631                   ub.price-list-type-cassa.sys-date     = today
     9632                   ub.price-list-type-cassa.sys-time     = time
     9633                   ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
     9634                   ub.price-list-type-cassa.who          = p-userid
     9635                   ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
     9636                   ub.price-list-type-cassa.db-num       = p-db-num-usr
     9637                 .
     9638                end.
     9639         else do:
     9640            assign
     9641             ub.price-list-type-cassa.stts   = integer('0':U)
     9642             ub.price-list-type-cassa.sys-date     = today
     9643             ub.price-list-type-cassa.sys-time     = time
     9644             ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
     9645             ub.price-list-type-cassa.who          = p-userid
     9646             ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
     9647            .
     9648         end.
     9649     end.
     9650     for each ub.price-list-type-pay-type exclusive-lock where
     9651              ub.price-list-type-pay-type.plt-db-num  = p-db-num and
     9652              ub.price-list-type-pay-type.plt-id      = p-id :
     9653          if not can-find (first tt_pay-type where
     9654                                 tt_pay-type.pay-code = ub.price-list-type-pay-type.pay-code
     9655                                 ) then
     9656          ub.price-list-type-pay-type.stts   = integer('1':U)  .
     9657     end.
     9658     for each tt_pay-type :
     9659         find first  ub.price-list-type-pay-type exclusive-lock where
     9660                     ub.price-list-type-pay-type.pay-code = tt_pay-type.pay-code and
     9661                     ub.price-list-type-pay-type.plt-db-num        = p-db-num and
     9662                     ub.price-list-type-pay-type.plt-id            = p-id     no-error .
     9663         if not available ub.price-list-type-pay-type then do :
