     1379         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1380         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1381         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1382         ub.price-doc-forming.base-rate    = v-base-rate
     1383         ub.price-doc-forming.base-scale   = v-base-scale
