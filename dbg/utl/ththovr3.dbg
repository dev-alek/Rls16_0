     6971           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     6972           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     6973         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     6974         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     6975         if transport-base-loc = ? then transport-base-loc = 0.
     6976         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     6977         if other-base-loc     = ? then other-base-loc     = 0.
     6978         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     6979         assign
     6980           transport-cli-loc      = 0
     6981           other-cli-loc          = 0
     6982           road-tax-cli-loc       = ?
     6983           vat-cli-loc            = ?
     6984           slt-cli-loc            = ?
     6985           price-cli-with-tax-loc = ?.
     6986      end.
     6987   ASSIGN
     6988             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6989       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6990   .
     6991                 assign
     6992                   p-road-tax-rubl =  road-tax-rubl-loc
     6993                   p-road-tax-base =  road-tax-base-loc
     6994                   .
     6995               end.
     6996         end.
     6997     end.
     6998   end procedure.
     6999   procedure calc-sigma :
     7000    do
     7001    on error undo, return error return-value
     7002    :
     7003   define input parameter l-bcode like ub.price-list.b-code no-undo .
     7004   define input-output parameter new-price as decimal no-undo .
     7005   define input parameter l-host as integer no-undo .
     7006   define input parameter l-code as integer no-undo .
     7007   define input parameter l-type as character no-undo .
     7008   define output parameter p-ret as logical no-undo .
     7009   define variable conf-par     as character no-undo.
     7010   define variable par-type     as character no-undo.
     7011   define variable i-sigma as decimal no-undo .
     7012   define variable cur-pr like ub.price-list.price-sale no-undo.
     7013   define variable cur-rt like ub.price-list.road-tax   no-undo.
     7014   define variable cur-ex like ub.price-list.excise     no-undo.
     7015   define variable cur-dn like ub.price-list.doc-num    no-undo.
     7016   define variable old-price as decimal no-undo .
     7017   p-ret = true  .
     7018   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     7019   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7020   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7021     (input  l-type
     7022     ,input  l-code
     7023     ,input  l-bcode
     7024     ,input  0
     7025     ,input  0
     7026     ,output cur-dn
     7027     ,output cur-pr
     7028     ,output cur-rt
     7029     ,output cur-ex
     7030     )  .
     7031   old-price = cur-pr .
     7032   if old-price =  new-price then do:
     7033      p-ret = true .
     7034      return.
     7035   end.
     7036      i-sigma = decimal(par-pr-sigma) .
     7037      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     7038          p-ret = false .
     7039          new-price = old-price.
     7040          end.
     7041      else p-ret = true .
     7042   end.
     7043    end.
     7044   end procedure.
     7045   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7046   define variable var-pr-r-b as character no-undo .
     7047   define variable v-str2 as character no-undo .
     7048   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7049   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7050     (output var-pr-r-b
     7051     )  .
     7052   function f-base-code return integer ( p-b-code as integer ).
     7053     define variable main-b-code as integer   no-undo .
     7054     define buffer buf_bar-code for ub.bar-code  .
     7055     find first buf_bar-code no-lock where
     7056               buf_bar-code.b-code = p-b-code no-error .
     7057   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7058     (input  buf_bar-code.gds-code
     7059     ,input  ?
     7060     ,output main-b-code
     7061     )  .
     7062     return (main-b-code).
     7063   end function.
     7064   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7065     define variable f-cost     as decimal no-undo .
     7066     define variable f-cost-pc  as decimal no-undo .
     7067     define variable v-qnty     as decimal no-undo .
     7068     define variable v-sum      as decimal no-undo .
     7069     define variable fact_price as decimal no-undo .
     7070     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     7071                               ub.goods.prod-type = local-price-list.prod-type and
     7072                               ub.goods.prod-code = local-price-list.prod-code no-lock
     7073                               no-error .
     7074     assign
     7075       v-sum  =  0
     7076       v-qnty =  0
     7077       .
     7078     for each x_obj-group :
     7079         find ub.gds-obj no-lock where
     7080             ub.gds-obj.gds-code = ub.goods.gds-code and
     7081             ub.gds-obj.obj-type = x_obj-group.obj-type and
     7082             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     7083         if  available ub.gds-obj then
     7084           if ub.goods.gds-type = 'т':U then
     7085             assign
     7086               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     7087               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     7088               .
     7089             else  v-sum = ?.
     7090         else v-sum = ?.
     7091     end.
     7092     f-cost = v-sum / v-qnty .
     7093     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7094     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     7095     return (f-cost-pc).
     7096   end function.
     7097   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7098   define variable f-pr     as decimal no-undo .
     7099   define variable f-pr-pc  as decimal no-undo.
     7100   define variable v-qnty as decimal   no-undo .
     7101   define variable v-sum as decimal   no-undo .
     7102   define variable fact_price as decimal   no-undo .
     7103   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7104                          ub.goods.prod-type = local-price-list.prod-type and
     7105                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7106    assign
     7107      v-sum  =  0
     7108      v-qnty =  0
     7109      .
     7110   for each x_obj-group :
     7111   find ub.gds-obj no-lock where
     7112        ub.gds-obj.gds-code = ub.goods.gds-code and
     7113        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7114        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     7115   if  available ub.gds-obj then do:
     7116     if ub.goods.gds-type = 'т':U then
     7117       assign
     7118         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     7119         .
     7120       else f-pr = ?.
     7121   end.
     7122   else f-pr = ?.
     7123   end.
     7124     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7125     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     7126     return (f-pr-pc).
     7127   end function.
     7128   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7129   define variable f-cost   as decimal no-undo .
     7130   find first  x_obj-group.
     7131   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7132                          ub.goods.prod-type = local-price-list.prod-type and
     7133                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7134   find ub.gds-obj no-lock where
     7135        ub.gds-obj.gds-code = ub.goods.gds-code  and
     7136        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7137        ub.gds-obj.obj-code = x_obj-group.obj-code
     7138        no-error.
     7139   if  available ub.gds-obj then
     7140     if ub.goods.gds-type = 'т':U then
     7141       assign
     7142         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     7143         .
     7144       else  f-cost = ?.
     7145   else f-cost = ?.
     7146     return ( f-cost ).
     7147   end function.
     7148   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7149   define variable f-pr   as decimal no-undo .
     7150   find first x_obj-group .
     7151   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7152                          ub.goods.prod-type = local-price-list.prod-type and
     7153                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7154   find ub.gds-obj no-lock where
     7155        ub.gds-obj.gds-code = ub.goods.gds-code and
     7156        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7157        ub.gds-obj.obj-code = x_obj-group.obj-code
     7158        no-error.
     7159   if  available ub.gds-obj then
     7160     if ub.goods.gds-type = 'т':U then
     7161       assign
     7162         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     7163         .
     7164       else  f-pr = ?.
     7165   else f-pr = ?.
     7166      return ( f-pr ).
     7167   end function.
     7168   procedure make-fact-order-lib3 :
     7169   define input  parameter p-recid as recid no-undo .
     7170   define output parameter p-fact-order-sys-from as decimal   no-undo .
     7171   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     7172   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7173   define buffer buf_price-list-type for ub.price-list-type  .
     7174   define variable v-shift-end-fact-order as decimal no-undo .
     7175   define variable v-day-end-fact-order   as decimal no-undo .
     7176   define variable v-fact-order           as decimal no-undo .
     7177     do
     7178     on error undo, return error return-value
     7179     :
     7180   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7181     if error-status :error then return error error-status :get-message(1) .
     7182   find first buf_price-list-type  no-lock where
     7183              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7184              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7185     if error-status :error then return error error-status :get-message(1) .
     7186    if buf_price-doc-forming.have-start-period = 1 then do:
     7187       case buf_price-list-type.work-date :
     7188         when int('1':U)  then
     7189           do :
     7190              run day-begin-fact-order
     7191                   ( buf_price-doc-forming.start-date ,
     7192                    output p-fact-order-sys-from ) no-error .
     7193                    if error-status :error then
     7194                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     7195                                               error-status :get-message(1) ,
     7196                                               return-value ).
     7197           end.
     7198         when int('2':U)   then
     7199           do :
     7200             run factord (
     7201                input   buf_price-doc-forming.start-shift-date
     7202               ,input   buf_price-doc-forming.sys-time
     7203               ,input   1
     7204               ,input   buf_price-doc-forming.start-shift-date
     7205               ,input   buf_price-doc-forming.start-shift-num
     7206               ,input   true
     7207               ,output  p-fact-order-sys-from
     7208               ,output  v-shift-end-fact-order
     7209               ,output  v-day-end-fact-order
     7210               ) no-error  .
     7211               if error-status :error then
     7212                    return error substitute ( "Ошибка из factord &1 &2" ,
     7213                                               error-status :get-message(1) ,
     7214                                               return-value ).
     7215           end.
     7216         when int('3':U)   then
     7217           do :
     7218             run factord (
     7219               input    buf_price-doc-forming.start-sys-date
     7220               ,input   buf_price-doc-forming.start-sys-time
     7221               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     7222               ,input   ?
     7223               ,input   ?
     7224               ,input   false
     7225               ,output  p-fact-order-sys-from
     7226               ,output  v-shift-end-fact-order
     7227               ,output  v-day-end-fact-order
     7228               ) no-error .
     7229               if error-status :error then
     7230                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7231                                               error-status :get-message(1) ,
     7232                                               return-value ).
     7233           end.
     7234       end case.
     7235     end.
     7236    if buf_price-doc-forming.have-end-period = 1 then do:
     7237       case buf_price-list-type.work-date :
     7238         when int('1':U)   then
     7239           do :
     7240              run factord-end-day
     7241                 ( buf_price-doc-forming.end-date ,
     7242                   output p-fact-order-sys-to ) no-error .
     7243                   if error-status :error then
     7244                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     7245                                               error-status :get-message(1) ,
     7246                                               return-value ).
     7247           end.
     7248         when int('2':U)   then
     7249           do :
     7250             run factord (
     7251                input   buf_price-doc-forming.end-shift-date
     7252               ,input   buf_price-doc-forming.sys-time
     7253               ,input   1
     7254               ,input   buf_price-doc-forming.end-shift-date
     7255               ,input   buf_price-doc-forming.end-shift-num
     7256               ,input   true
     7257               ,output  v-fact-order
     7258               ,output  p-fact-order-sys-to
     7259               ,output  v-day-end-fact-order
     7260               ) no-error .
     7261               if error-status :error then
     7262                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     7263                                           error-status :get-message(1) ,
     7264                                           return-value ).
     7265           end.
     7266         when int('3':U)   then
     7267           do :
     7268             run factord (
     7269                input   buf_price-doc-forming.end-sys-date
     7270               ,input   buf_price-doc-forming.end-sys-time
     7271               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     7272               ,input   ?
     7273               ,input   ?
     7274               ,input   false
     7275               ,output  p-fact-order-sys-to
     7276               ,output  v-shift-end-fact-order
     7277               ,output  v-day-end-fact-order
     7278               ) no-error .
     7279               if error-status :error then
     7280                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7281                                           error-status :get-message(1) ,
     7282                                           return-value ).
     7283           end.
     7284       end case.
     7285     end.
     7286     end.
     7287   end procedure.
     7288   procedure ver-dfc-mpl-lib3 :
     7289   define input  parameter p-recid as recid no-undo .
     7290   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7291   define buffer buf_price-list-type for ub.price-list-type  .
     7292   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7293   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     7294   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     7295   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     7296   define variable v-fact-order-sys-from   as decimal   no-undo .
     7297   define variable v-fact-order-sys-to     as decimal   no-undo .
     7298     do
     7299     on error undo, return error return-value
     7300    :
     7301   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7302     if error-status :error then return error error-status :get-message(1) .
     7303   find first buf_price-list-type  no-lock where
     7304              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7305              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7306     if error-status :error then return error error-status :get-message(1) .
     7307     if buf_price-list-type.stts = integer('1':U) then do:
     7308        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     7309     end.
     7310     if buf_price-list-type.bgr-id > 0 then do:
     7311         find ub.buyer-group where
     7312               ub.buyer-group.stts       = 0  and
     7313               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     7314               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     7315               no-lock no-error .
     7316         if not available ub.buyer-group then
     7317         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     7318     end.
     7319     if buf_price-list-type.sgr-id > 0 then do:
     7320         find ub.sum-group where
     7321               ub.sum-group.stts       = 0  and
     7322               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     7323               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     7324               no-lock no-error .
     7325         if not available ub.sum-group then
     7326         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     7327     end.
     7328     if buf_price-list-type.qgr-id > 0 then do:
     7329         find ub.qnty-group where
     7330              ub.qnty-group.stts       = 0  and
     7331              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     7332              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     7333              no-lock no-error .
     7334         if not available ub.qnty-group then
     7335         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     7336     end.
     7337     if buf_price-list-type.tog-id > 0 then do:
     7338         find ub.turnover-group where
     7339              ub.turnover-group.stts       = 0  and
     7340              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     7341              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     7342             no-lock no-error .
     7343         if not available ub.turnover-group then
     7344         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     7345     end.
     7346     if buf_price-list-type.gop-id > 0 then do:
     7347         find ub.grp-obj-price where
     7348               ub.grp-obj-price.stts       = 0  and
     7349               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num and
     7350               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id
     7351               no-lock no-error .
     7352         if not available ub.grp-obj-price then
     7353         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id,buf_price-list-type.gop-db-num )  .
     7354     end.
     7355     if buf_price-list-type.gop-id-for-calc-turnover > 0 then do:
     7356         find ub.grp-obj-price where
     7357               ub.grp-obj-price.stts       = 0  and
     7358               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num-for-calc-turnover and
     7359               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id-for-calc-turnover
     7360               no-lock no-error .
     7361         if not available ub.grp-obj-price then
     7362         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id-for-calc-turnover,buf_price-list-type.gop-db-num-for-calc-turnover )  .
     7363     end.
     7364      if buf_price-doc-forming.have-start-period = integer(true) then do:
     7365         case buf_price-list-type.work-date :
     7366             when int('1':U)     then
     7367               do :
     7368                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     7369               end.
     7370             when int('2':U)   then
     7371               do :
     7372                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
     7373                   if buf_price-doc-forming.start-shift-num  = ? or
     7374                      buf_price-doc-forming.start-shift-num = 0  then return error "Не задан порядок смены начала действия цен !" .
     7375               end.
     7376             when int('3':U)     then
     7377               do :
     7378                   if buf_price-doc-forming.start-sys-date = ? then return error "Не задана дата начала действия цен !" .
     7379                   if buf_price-doc-forming.start-sys-time = ? then return error "Не задано время начала действия цен !" .
     7380               end.
     7381         end case.
     7382      end.
     7383      if buf_price-doc-forming.have-end-period = integer(true) then do:
     7384         case buf_price-list-type.work-date :
     7385             when int('1':U)     then
     7386               do :
     7387                  if buf_price-doc-forming.end-date = ? then return error "Не задана дата окончания действия цен !" .
     7388               end.
     7389             when int('2':U)   then
     7390               do :
     7391                   if buf_price-doc-forming.end-shift-date = ? then return error "Не задана сменная дата окончания действия цен !" .
     7392                   if buf_price-doc-forming.end-shift-num  = ? or
     7393                      buf_price-doc-forming.end-shift-num = 0  then return error "Не задан порядок смены окончания  действия цен !" .
     7394               end.
     7395             when int('3':U)     then
     7396               do :
     7397                   if buf_price-doc-forming.end-sys-date = ? then return error "Не задана дата окончания действия цен !" .
     7398                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     7399               end.
     7400         end case.
     7401      end.
     7402      if buf_price-doc-forming.have-start-period = integer(true) and
     7403         buf_price-doc-forming.have-end-period = integer(true) then do:
     7404         case buf_price-list-type.work-date :
     7405             when int('1':U)     then
     7406               do :
     7407                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     7408               end.
     7409             when int('2':U)   then
     7410               do :
     7411                   if buf_price-doc-forming.end-shift-date < buf_price-doc-forming.start-shift-date then return error "Не верно задан интервал дат !" .
     7412                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     7413                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     7414                   end.
     7415               end.
     7416             when int('3':U)     then
     7417               do :
     7418                   if buf_price-doc-forming.end-sys-date < buf_price-doc-forming.start-sys-date then return error "Не верно задан интервал дат !" .
     7419                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     7420                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     7421                   end.
     7422               end.
     7423         end case.
     7424      end.
     7425   if buf_price-doc-forming.name = "" then return error "Не задано название ДНЦ !" .
     7426   if buf_price-list-type.main = false then do:
     7427       run make-fact-order-lib3 in this-procedure
     7428           ( input  p-recid ,
     7429             output v-fact-order-sys-from ,
     7430             output v-fact-order-sys-to   ) .
     7431   end.
     7432   define variable old-price as decimal   no-undo .
     7433   define variable v-kol-rec as integer   no-undo .
     7434   define variable v-gds-null-price as character no-undo initial "" .
     7435   define variable v-type as character no-undo .
     7436   v-kol-rec = 0.
     7437   for each buf_price-doc-forming-gds no-lock where
     7438            buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
     7439            buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
     7440            buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
