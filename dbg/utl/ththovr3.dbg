     1402   procedure prcreate-new-price-doc-forming-gds :
     1403   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     1404   define input  parameter p-obj-type   as character no-undo .
     1405   define input  parameter p-obj-code   as integer   no-undo .
     1406   define input  parameter par-pr-notls as character no-undo .
     1407   define input  parameter par-pr-altex as character no-undo .
     1408   define input  parameter par-pr-sclex as character no-undo .
     1409   define input  parameter p-line-num    as integer   no-undo .
     1410   define input  parameter p-gds-code    as integer   no-undo .
     1411   define input  parameter p-price-sale  as decimal   no-undo .
     1412   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1413   define buffer buf_goods for ub.goods  .
     1414   define buffer buf_bar-code for ub.bar-code  .
     1415   define buffer main_bar-code for ub.bar-code  .
     1416   define variable main-b-code as integer   no-undo .
     1417   define variable v-sec as integer   no-undo .
     1418     do
     1419     on error undo, return error return-value
     1420     :
     1421   define variable v-cur-dn as character no-undo .
     1422   define variable v-cur-pr as decimal   no-undo .
     1423   define variable v-cur-rt as decimal   no-undo .
     1424   define variable v-cur-ex as decimal   no-undo .
     1425   find first buf_price-doc-forming no-lock where
     1426              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     1427              if error-status :error then return error .
     1428   find first buf_goods no-lock where
     1429              buf_goods.gds-code  = p-gds-code no-error .
     1430              if error-status :error then return error .
     1431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1432     (input  buf_goods.gds-code
     1433     ,input  ?
     1434     ,output main-b-code
     1435     ) no-error .
     1436   run check-use-bar-code (main-b-code) no-error .
     1437   if error-status :error then return .
     1438   run create-line-pdf-mpl-lib (
     1439        input buf_price-doc-forming.plt-db-num
     1440       ,input buf_price-doc-forming.plt-id
     1441       ,input buf_price-doc-forming.pdf-db
     1442       ,input buf_price-doc-forming.pdf-id
     1443       ,input p-line-num
     1444       ,input main-b-code
     1445       ,input buf_goods.artic
     1446       ,input buf_goods.prod-type
     1447       ,input buf_goods.prod-code
     1448       ,input ""
     1449       ,input 0
     1450       ,input p-price-sale
     1451       ,input ""
     1452       ,input 0
     1453      ,input-output v-sec ) no-error .
     1454      if error-status :error  then do:
     1455        message
     1456          vss-workfile vss-revision vss-description skip
     1457          error-status :get-message(1) skip
     1458          return-value skip
     1459          "2"
     1460          view-as alert-box error
     1461        .
     1462      end.
     1463   define buffer old_price-list for ub.price-list  .
     1464   if par-pr-notls = "yes" then do:
     1465   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1466   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1467     (input  p-obj-type
     1468     ,input  p-obj-code
     1469     ,input  main-b-code
     1470     ,input  0
     1471     ,input  0
     1472     ,output v-cur-dn
     1473     ,output v-cur-pr
     1474     ,output v-cur-rt
     1475     ,output v-cur-ex
     1476     )  .
     1477   end.
     1478   if par-pr-altex = "yes" and
     1479      par-pr-notls = "yes" then do:
     1480       if v-cur-dn <> "" then do:
     1481           for each old_price-list no-lock where
     1482                    old_price-list.doc-num = v-cur-dn and
     1483                    old_price-list.artic      = buf_goods.artic and
     1484                    old_price-list.prod-type  = buf_goods.prod-type and
     1485                    old_price-list.prod-code  = buf_goods.prod-code and
     1486                    old_price-list.main-price = no,
     1487                   first buf_bar-code no-lock where
     1488                         buf_bar-code.b-code   = old_price-list.b-code and
     1489                         buf_bar-code.unit-cli <> buf_goods.unit-base
     1490                         :
     1491                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1492                          if error-status :error then next.
     1493                    run create-line-pdf-mpl-lib (
     1494                          input buf_price-doc-forming.plt-db-num
     1495                         ,input buf_price-doc-forming.plt-id
     1496                         ,input buf_price-doc-forming.pdf-db
     1497                         ,input buf_price-doc-forming.pdf-id
     1498                         ,input p-line-num
     1499                         ,input old_price-list.b-code
     1500                         ,input buf_goods.artic
     1501                         ,input buf_goods.prod-type
     1502                         ,input buf_goods.prod-code
     1503                         ,input ""
     1504                         ,input 0
     1505                         ,input old_price-list.price-sale
     1506                         ,input ""
     1507                         ,input 0
     1508                        ,input-output v-sec ) no-error .
     1509           end.
     1510       end.
     1511   end.
     1512   if par-pr-sclex = "yes" and
     1513      par-pr-notls = "yes" then do:
     1514       if v-cur-dn <> "" then do:
     1515           for each old_price-list no-lock where
     1516                    old_price-list.doc-num    = v-cur-dn and
     1517                    old_price-list.artic      = buf_goods.artic and
     1518                    old_price-list.prod-type  = buf_goods.prod-type and
     1519                    old_price-list.prod-code  = buf_goods.prod-code and
     1520                    old_price-list.main-price = no,
     1521                   first buf_bar-code no-lock where
     1522                         buf_bar-code.b-code   = old_price-list.b-code and
     1523                         buf_bar-code.in-code  = "" and
     1524                         buf_bar-code.unit-cli = buf_goods.unit-base
     1525                         :
     1526                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1527                          if error-status :error then next.
     1528                    run create-line-pdf-mpl-lib (
     1529                          input buf_price-doc-forming.plt-db-num
     1530                         ,input buf_price-doc-forming.plt-id
     1531                         ,input buf_price-doc-forming.pdf-db
     1532                         ,input buf_price-doc-forming.pdf-id
     1533                         ,input p-line-num
     1534                         ,input old_price-list.b-code
     1535                         ,input buf_goods.artic
     1536                         ,input buf_goods.prod-type
     1537                         ,input buf_goods.prod-code
     1538                         ,input ""
     1539                         ,input 0
     1540                         ,input old_price-list.price-sale
     1541                         ,input ""
     1542                         ,input 0
     1543                       ,input-output v-sec ) no-error .
     1544           end.
     1545       end.
     1546   end.
     1547   end.
     1548   end procedure.
     1549   procedure copy_new_price-doc-forming :
     1550   define input  parameter       p-recid      as recid no-undo .
     1551   define input-output parameter p-plt-db-num as integer   no-undo .
     1552   define input-output parameter p-plt-id     as integer   no-undo .
     1553   define output parameter       p-pdf-db-num as integer   no-undo .
     1554   define output parameter       p-pdf-id     as integer   no-undo .
     1555   define buffer buf_price-list-type        for ub.price-list-type  .
     1556   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     1557   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     1558   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     1559   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     1560   define variable v-host-code  as integer   no-undo .
     1561   define variable v-base-rate  as decimal   no-undo .
     1562   define variable v-base-scale as integer   no-undo .
     1563   define variable v-exch-rate  as decimal   no-undo .
     1564   define variable v-exch-scale as integer   no-undo .
     1565   define variable v-base as logical   no-undo .
     1566   define variable v-name as character no-undo .
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1572     (output v-base
     1573     )  .
     1574   find first buf_price-list-type no-lock where
     1575              buf_price-list-type.plt-db-num = p-plt-db-num and
     1576              buf_price-list-type.plt-id     = p-plt-id no-error .
     1577   if error-status :error then return error "Не найден ТПЛ".
     1578   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     1579   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     1580       if available buf_price-doc-forming then do :
     1581           assign
     1582             v-base-rate  = buf_price-doc-forming.base-rate
     1583             v-base-scale = buf_price-doc-forming.base-scale
     1584             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     1585           .
     1586       end.
     1587       else do:
     1588           assign
     1589             v-base-rate  = 1
     1590             v-base-scale = 1
     1591             v-name       = "Автосоздание"
     1592           .
     1593       end.
     1594      create ub.price-doc-forming.
     1595      assign
     1596         ub.price-doc-forming.plt-id       = p-plt-id
     1597         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1598         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1599         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1600         ub.price-doc-forming.base-rate    = v-base-rate
     1601         ub.price-doc-forming.base-scale   = v-base-scale
     1602         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1603         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1604         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1605         ub.price-doc-forming.stts         = 0
     1606         ub.price-doc-forming.sys-date     = today
     1607         ub.price-doc-forming.sys-time     = time
     1608         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1609         ub.price-doc-forming.who          = v-cntxt-userid
     1610         ub.price-doc-forming.name         = v-name
     1611      .
     1612      assign
     1613       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1614       p-pdf-id      = ub.price-doc-forming.pdf-id
     1615       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1616       p-plt-id      = ub.price-doc-forming.plt-id
     1617      .
     1618     end.
     1619     if not available buf_price-doc-forming then return .
     1620   for each buf_price-doc-forming-attr no-lock where
     1621            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1622            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1623            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1624            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1625       create ub.price-doc-forming-attr.
     1626       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1627       assign
     1628         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1629         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1630         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1631         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1632         .
     1633   end.
     1634   for each buf_price-doc-forming-gds no-lock where
     1635            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1636            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1637            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1638            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1639       create ub.price-doc-forming-gds.
     1640       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1641       assign
     1642         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1643         ub.price-doc-forming-gds.plt-id      = p-plt-id
     1644         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     1645         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     1646       .
     1647   end.
     1648   for each buf_pd-forming-gds-attr no-lock where
     1649            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1650            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1651            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1652            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1653       create ub.price-doc-forming-gdsattr.
     1654       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     1655       assign
     1656         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     1657         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     1658         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     1659         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     1660       .
     1661   end.
     1662   end procedure.
     1663   define variable par-pr-incpc as character no-undo.
     1664   define variable par-pr-rndmt as character no-undo.
     1665   define variable par-pr-rndbs as character no-undo.
     1666   define variable par-pr-clt-q as character no-undo.
     1667   define variable par-pr-dpl-q as character no-undo.
     1668   define variable par-pr-rdc-q as character no-undo.
     1669   define variable par-pr-abs-d as character no-undo.
     1670   define variable par-pr-altex as character no-undo.
     1671   define variable par-pr-parex as character no-undo.
     1672   define variable par-pr-sclex as character no-undo.
     1673   define variable par-pr-notls as character no-undo.
     1674   define variable par-pr-equ-dq as integer  no-undo.
     1675   define variable par-pr-discm as character no-undo .
     1676   define variable par-pr-dscnt as character no-undo .
     1677   define variable par-pr-print as character no-undo .
     1678   define variable par-pr-sigma as character no-undo .
     1679   define variable par-pr-goods as character no-undo.
     1680   define variable par-pr-nogds as character no-undo.
     1681   define variable par-alcohol  as character no-undo.
     1682   define variable par-gen-mrgn-ie as character no-undo .
     1683   define variable par-gen-mrgn-iv as character no-undo .
     1684   define variable par-gen-mrgn-im as character no-undo .
     1685   define variable par-pr-nakl-ie  as logical   no-undo .
     1686   define variable par-pr-nakl-iv  as logical   no-undo .
     1687   define variable par-pr-nakl-im  as logical   no-undo .
     1688   define variable par-pr-nogds-long as longchar no-undo .
     1689   define temp-table tmp-proof-price no-undo
     1690     field node-code like ub.gds-grp.node-code
     1691     field proof as decimal
     1692     field price as decimal
     1693   index pi node-code proof descending .
     1694   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1697   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1698   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1699   ASSIGN
     1700      v-S_CONTRACT                = "Contract":U
     1701      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1702      v-DELIM_CHR_3               = ","
     1703      .
     1704   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1705   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1706   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1707   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1708      INPUT iHost-Code    AS INTEGER,
     1709      INPUT iContract-Num AS INTEGER,
     1710      INPUT iGds-Code     AS INTEGER ):
     1711      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1712      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1713      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1714      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1715      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1716      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1717          INPUT  iHost-Code,
     1718          INPUT  iContract-Num,
     1719          OUTPUT iTmp-Extent3
     1720          ).
     1721      IF iTmp-Extent3[1] = 2 THEN DO:
     1722         ASSIGN
     1723            iTmp-Host-Code      = iTmp-Extent3[2]
     1724            iTmp-Contract-Num   = iTmp-Extent3[3]
     1725            .
     1726      END. ELSE DO:
     1727         ASSIGN
     1728            iTmp-Host-Code      = iHost-Code
     1729            iTmp-Contract-Num   = iContract-Num
     1730            .
     1731      END.
     1732      IF iGds-Code = ? THEN DO:
     1733         ASSIGN
     1734            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1735                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1736                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1737                           ).
     1738      END. ELSE DO:
     1739            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1740                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1741                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1742                              AND buf_Spec.Gds-Code      = iGds-Code
     1743                            ).
     1744      END.
     1745      RETURN (lRet).
     1746   END FUNCTION.
     1747   PROCEDURE MS-Contract-EXTENT-3:
     1748      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1749      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1750      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1751      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1752      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1753      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1754      FIND FIRST buf_Cont-2 WHERE
     1755                 buf_Cont-2.Host-Code      = i-Host-Code
     1756             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1757           NO-LOCK NO-ERROR.
     1758      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1759         RETURN.
     1760      END.
     1761      FOR FIRST buf_Ext-Classif WHERE
     1762                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1763           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1764                                               STRING(i-Contract-code)
     1765           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1766          NO-LOCK,
     1767          EACH buf_Cont WHERE
     1768               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1769           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1770          NO-LOCK:
     1771          ASSIGN
     1772             i-Ret[1] = 1
     1773             i-Ret[2] = buf_Cont.Host-code
     1774             i-Ret[3] = buf_Cont.Contract-code
     1775             .
     1776          LEAVE.
     1777      END.
     1778      IF i-Ret[1] <> 1 THEN DO:
     1779         FOR FIRST buf_Ext-Classif WHERE
     1780                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1781              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1782                                                  STRING(i-Contract-code)
     1783              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1784             NO-LOCK,
     1785             EACH buf_Cont WHERE
     1786                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1787              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1788             NO-LOCK:
     1789             ASSIGN
     1790                i-Ret[1] = 2
     1791                i-Ret[2] = buf_Cont.Host-code
     1792                i-Ret[3] = buf_Cont.Contract-code
     1793                .
     1794             LEAVE.
     1795         END.
     1796      END.
     1797      RETURN.
     1798   END PROCEDURE.
