     9727             ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
     9728            .
     9729         end.
     9730     end.
     9731     end.
     9732   end procedure.
     9733   PROCEDURE type-price-list-delete :
     9734   define input  parameter p-db-num       as integer   no-undo .
     9735   define input  parameter p-id           as integer   no-undo .
     9736   define input  parameter p-db-num-usr   as integer   no-undo .
     9737   define input  parameter p-userid       as character no-undo .
     9738   define buffer child_price-list-type for ub.price-list-type  .
     9739     do
     9740     on error undo, return error return-value
     9741     :
     9742   find first ub.price-list-type exclusive-lock where
     9743           ub.price-list-type.plt-db-num   = p-db-num  and
     9744           ub.price-list-type.plt-id       = p-id
     9745           no-error .
     9746    if not available ub.price-list-type then  return error .
     9747    if ub.price-list-type.ban-discnt > 0 then do:
     9748    define buffer buf_dis-rule for ub.dis-rule  .
     9749    find first buf_dis-rule no-lock where
     9750               buf_dis-rule.templ-rl-root = ub.price-list-type.ban-discnt and
     9751               buf_dis-rule.charkey_one   = substitute("&1-&2", ub.price-list-type.plt-id, ub.price-list-type.plt-db-num)
     9752               no-error .
     9753        if available buf_dis-rule then do:
     9754           message  substitute
     9755             ( "Удалить этот тип нельзя, так как есть ссылка на ПРАВИЛО СКИДОК &1 &2" ,
     9756                ub.price-list-type.ban-discnt  ,
     9757                buf_dis-rule.des
     9758               ) view-as alert-box error .
     9759           return .
     9760        end.
     9761    end.
     9762    find first ub.price-doc-forming no-lock where
     9763               ub.price-doc-forming.plt-id = ub.price-list-type.plt-id and
     9764               ub.price-doc-forming.plt-db-num = ub.price-list-type.plt-db-num and
     9765               ub.price-doc-forming.stts = integer('0':U) no-error .
     9766    if available ub.price-doc-forming then do:
     9767           message "Удалить этот тип нельзя, так как есть незакрытые ДНЦ " ub.price-doc-forming.pdf-id "БД:" ub.price-doc-forming.pdf-db
     9768           view-as alert-box error .
     9769           return .
     9770    end.
     9771         assign
     9772           ub.price-list-type.db-num-chg    = p-db-num-usr
     9773           ub.price-list-type.stts          = integer('1':U)
     9774           ub.price-list-type.sys-date      = today
     9775           ub.price-list-type.sys-time      = time
     9776           ub.price-list-type.sys-time-chr  = string ( ub.price-list-type.sys-time,"hh:mm" )
     9777           ub.price-list-type.who           = p-userid
     9778         .
     9779         for each child_price-list-type exclusive-lock where
     9780                  child_price-list-type.plt-main-db-num = p-db-num  and
     9781                  child_price-list-type.plt-main-id     = p-id
     9782                  :
     9783               assign
     9784                 child_price-list-type.db-num-chg    = p-db-num-usr
     9785                 child_price-list-type.stts          = integer('1':U)
     9786                 child_price-list-type.sys-date      = today
     9787                 child_price-list-type.sys-time      = time
     9788                 child_price-list-type.sys-time-chr  = string ( child_price-list-type.sys-time , "hh:mm" )
     9789                 child_price-list-type.who           = p-userid
     9790               .
     9791         end.
     9792     end.
     9793   end procedure.
     9794   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9795   define variable v-waitfram-action01         as character   no-undo .
     9796   define variable v-waitfram-action02         as character   no-undo .
     9797   define variable v-waitfram-action03         as character   no-undo .
     9798   define variable mWaitFramTextBeg            as character   no-undo.
     9799   define variable mWaitFramTextEnd            as character   no-undo.
     9800   define variable mWaitFramView               as logical     no-undo.
     9801   define variable mWaitProcEvent              as logical     no-undo init yes.
     9802   define variable mWaitFramInterval           as integer     no-undo init 1 .
     9803   define variable mWaitFramStop               as logical     no-undo.
     9804   define variable mWaitFramStopUser           as logical     no-undo.
     9805   define variable mWaitFramStopTimeOut        as logical     no-undo.
     9806   define variable mWaitFramStartProc          as datetime-tz no-undo.
     9807   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     9808   define button B-WaitFramStop auto-end-key
     9809        label "Стоп"
     9810        size 10 by 1 tooltip "Остоновить процесс".
     9811   define button B-viewProcInfo
     9812        label "Информация"
     9813        size 15 by 1 tooltip "Информация о процесс".
     9814   define frame waitfram
     9815     v-waitfram-action01 format "x(72)" no-label skip
     9816     v-waitfram-action02 format "x(72)" no-label skip
     9817     v-waitfram-action03 format "x(72)" no-label skip
     9818     B-viewProcInfo
     9819     B-WaitFramStop at row 4 col 30
     9820     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     9821     .
     9822   define new global shared variable mBatchMode as logical no-undo init ?.
     9823   define variable mFramBachModHandle as handle no-undo.
     9824   mFramBachModHandle = frame waitfram:handle.
     9825   define variable mFameOldVis as logical no-undo.
     9826   define variable mVisCUrentVin as logical no-undo.
     9827   if session:batch-mode
     9828   then
     9829      mBatchMode = yes.
     9830   if mBatchMode = ? then do:
     9831     mVisCUrentVin = current-window:visible.
     9832     mFameOldVis = mFramBachModHandle:visible.
     9833     mFramBachModHandle:visible  = yes.
     9834     mBatchMode = mFramBachModHandle:visible ne yes.
     9835     mFramBachModHandle:visible = mFameOldVis.
     9836     current-window:visible = mVisCUrentVin.
     9837   end.
     9838    if  log-manager:logfile-name ne ?
     9839     then DO:
     9840         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     9841         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     9842         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     9843     end.
     9844   on choose of B-WaitFramStop in frame waitfram
     9845   do:
     9846     mWaitFramStop = yes.
     9847     mWaitFramStopUser = yes.
     9848   end.
     9849   function waitfram-check-timeout returns logical():
     9850      define variable vtime as int64 no-undo.
     9851      if mWaitFramStopTimeOut
     9852      then
     9853         return yes.
     9854      vtime = ( now - mWaitFramStartProc ) / 1000 .
     9855      if     mWaitFramTimeOut ne ?
     9856         and mWaitFramTimeOut ne 0
     9857         and mWaitFramTimeOut lt vtime
     9858      then do:
     9859         mWaitFramStopTimeOut = yes.
     9860      end.
     9861      return mWaitFramStopTimeOut.
     9862   end.
     9863   procedure waitfram-hide :
     9864     if not session:batch-mode
     9865     then do
     9866     on error undo, return error return-value
     9867     :
     9868       pause 0 before-hide .
     9869       if not mBatchMode then
     9870         hide frame waitfram .
     9871     if     not mWaitFramView
     9872        and mWaitProcEvent
     9873     then
     9874       process events .
     9875     end.
     9876   end procedure.
     9877   procedure waitfram-show :
     9878     define input  parameter p-message as character no-undo .
     9879     define variable v-left-margin as integer   no-undo .
     9880     if not session:batch-mode
     9881     then do
     9882     on error undo, return error return-value
     9883     :
     9884       if length(p-message) <= 70 then do:
     9885         assign
     9886           v-left-margin = integer((70 - length(p-message)) / 2)
     9887         .
     9888         assign
     9889           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     9890         .
     9891         assign
     9892           v-waitfram-action01 = " "
     9893           v-waitfram-action02 = " "
     9894                                    + fill(" ", v-left-margin)
     9895                                    + p-message
     9896           v-waitfram-action03 = " "
     9897         .
     9898       end.
     9899       else do:
     9900         define variable vRindex1 as integer no-undo.
     9901         define variable vRindex2 as integer no-undo.
     9902         vRindex1 = r-index(p-message," ",70).
     9903         if vRindex1 = 0
     9904         then
     9905            vRindex1 = 70.
     9906         if length(p-message)  <= vRindex1 + 70 then do:
     9907           assign
     9908             v-waitfram-action01 = " "
     9909             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     9910             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     9911           .
     9912         end.
     9913         else do:
     9914           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     9915           if vRindex2 <= vRindex1
     9916           then
     9917              vRindex2 = vRindex1 + 70.
     9918           assign
     9919             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     9920             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     9921             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     9922           .
     9923         end.
     9924       end.
     9925       B-viewProcInfo:visible   in frame waitfram = no.
     9926       B-viewProcInfo:sensitive in frame waitfram = no.
     9927       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     9928       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     9929       if  (   mWaitFramView
     9930          or  mWaitProcEvent)
     9931          and not mBatchMode
     9932       then
     9933          display
     9934             v-waitfram-action01 skip
     9935             v-waitfram-action02 skip
     9936             v-waitfram-action03 skip
     9937          with frame waitfram .
     9938       if     mWaitFramView
     9939          then do:
     9940             if     mWaitFramInterval ne ?
     9941                and not mBatchMode
     9942             then
     9943                wait-for go of frame waitfram pause mWaitFramInterval.
     9944          end.
     9945          else
     9946             if     mWaitProcEvent
     9947                and not mBatchMode
     9948             then
     9949                process events .
     9950     end.
     9951   end procedure.
     9952      procedure waitfram-show-this:
     9953         define input  parameter iInterval as int64 no-undo.
     9954         define variable vtime as int64 no-undo.
     9955         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     9956         mWaitFramInterval = iInterval.
     9957         run waitfram-show (substitute("&1&2 &3&4" ,
     9958                                       mWaitFramTextBeg ,
     9959                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     9960                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     9961                                       mWaitFramTextEnd
     9962                                      )
     9963                           ).
     9964      end.
     9965      procedure WaitFramRunPause:
     9966         define input  parameter iInterval as dec no-undo.
     9967         define variable vStart  as datetime-tz no-undo.
     9968         define variable vend    as datetime-tz no-undo.
     9969         define variable vint as int64 no-undo.
     9970         define variable vOk as logical no-undo.
     9971         vStart = now.
     9972         vend   = vStart.
     9973         publish "WaitFramPause" (iInterval,output vOk).
     9974         vend   =  now.
     9975         vint = vend - vStart.
     9976         vint = iInterval - vint / 1000.
     9977         if     not mWaitFramStop
     9978            and (   vint > 0
     9979                 or (    not vOk
     9980                     and iInterval eq ?
     9981                     )
     9982                 )
     9983         then
     9984            run waitfram-show-this (iInterval).
     9985         vend   =  now.
     9986         vint = vend - vStart.
     9987         vint = iInterval - vint / 1000.
     9988         if     not mWaitFramStop
     9989            and vint > 0
     9990         then do:
     9991            run gbl/pause.p (vint * 1000).
     9992         end.
     9993         if iInterval ne ?
     9994         then
     9995            publish "WaitFramStop".
     9996         waitfram-check-timeout().
     9997      end.
     9998      procedure WaitFramWaitFor:
     9999         define input  parameter iInterval as dec no-undo.
    10000         assign
    10001            mWaitFramStartProc   = now
    10002            mWaitFramStopUser    = no
    10003            mWaitFramStopTimeOut = no
    10004         .
    10005         block-wait:
    10006         do while not mWaitFramStop:
    10007            run WaitFramRunPause (iInterval).
    10008            if  waitfram-check-timeout()
    10009            then do:
    10010               leave block-wait.
    10011            end.
    10012         end.
    10013         run waitfram-hide.
    10014      end.
    10015   procedure waitfram-join :
    10016     define input  parameter p-line-1  as character no-undo .
    10017     define input  parameter p-line-2  as character no-undo .
    10018     define input  parameter p-line-3  as character no-undo .
    10019     define output parameter p-message as character no-undo .
    10020     do
    10021     on error undo, return error return-value
    10022     :
    10023       assign
    10024         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
    10025                   + substring(p-line-2 + fill(' ', 70), 1, 70)
    10026                   + substring(p-line-3 + fill(' ', 70), 1, 70)
    10027       .
    10028     end.
    10029   end procedure.
    10030   function waitfram-join-function returns character
    10031     (input p-line-1 as character
    10032     ,input p-line-2 as character
    10033     ,input p-line-3 as character
    10034     ).
    10035     define variable v-message as character no-undo .
    10036     run waitfram-join in this-procedure
    10037       (input  p-line-1
    10038       ,input  p-line-2
    10039       ,input  p-line-3
    10040       ,output v-message
    10041       ) .
    10042     return v-message .
    10043   end function .
    10044   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10045   procedure thth150-db-attr-code :
    10046     do
    10047     on error undo, return error
    10048     :
    10049       define input  parameter p-code           as character no-undo .
    10050       define output parameter p-type           as character no-undo .
    10051       define output parameter p-format         as character no-undo .
    10052       define output parameter p-label          as character no-undo .
    10053       define output parameter p-user-can-edit  as logical   no-undo .
    10054       define output parameter p-output-display as logical   no-undo .
    10055       define output parameter p-other          as character no-undo .
    10056       case p-code :
    10057               when 'thth150-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10058               when 'thth150-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10059               when 'thth150-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10060               when 'thth150-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10061               when 'thth150-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10062               when 'thth150-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10063               when 'thth150-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10064               when 'thth150-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10065               when 'thth150-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10066               when 'thth150-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
    10067         otherwise do:
    10068           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
    10069         end.
    10070       end.
    10071     end.
    10072   end procedure.
    10073   procedure thth150-db-attr-tooltip :
    10074     do
    10075     on error undo, return error
    10076     :
    10077       define input  parameter p-code    as character no-undo .
    10078       define output parameter p-tooltip as character no-undo .
    10079       define output parameter p-label   as character no-undo .
    10080       case p-code :
    10081               when 'thth150-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
    10082               when 'thth150-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
    10083               when 'thth150-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
    10084               when 'thth150-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
    10085               when 'thth150-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
    10086               when 'thth150-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
    10087               when 'thth150-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
    10088               when 'thth150-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
    10089               when 'thth150-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
    10090               when 'thth150-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
    10091         otherwise do:
    10092           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
    10093         end.
    10094       end.
    10095     end.
    10096   end procedure.
    10097   procedure thth150-db-attr-value :
    10098     do
    10099     on error undo, return error
    10100     :
    10101       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
    10102       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
    10103       define output parameter p-value     like ub.db-attr.attr-value no-undo .
    10104       define output parameter p-type      as character no-undo .
    10105       define buffer buf_db-attr for ub.db-attr .
    10106       define variable v-format         as character no-undo .
    10107       define variable v-label          as character no-undo .
    10108       define variable v-user-can-edit  as logical   no-undo .
    10109       define variable v-output-display as logical   no-undo .
    10110       define variable v-other          as character no-undo .
    10111       run thth150-db-attr-code in this-procedure
    10112         (input  p-code
    10113         ,output p-type
    10114         ,output v-format
    10115         ,output v-label
    10116         ,output v-user-can-edit
    10117         ,output v-output-display
    10118         ,output v-other
    10119         ) no-error .
    10120       if error-status :error then do:
    10121         undo, return error return-value .
    10122       end.
    10123       find first buf_db-attr no-lock
    10124         where buf_db-attr.db-num    = p-db-num
    10125           and buf_db-attr.attr-code = p-code
    10126         no-error .
    10127       if avail buf_db-attr then do:
    10128         assign
    10129           p-value =  buf_db-attr.attr-value
    10130         .
    10131       end.
    10132       else do:
    10133         assign
    10134           p-value = if p-type = 'L':U then "no":U else ""
    10135         .
    10136       end.
    10137     end.
    10138   end procedure.
    10139   procedure thth150-db-attr-write :
    10140     do
    10141     on error undo, return error
    10142     :
    10143       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
    10144       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
    10145       define input parameter p-value     like ub.db-attr.attr-value no-undo .
    10146       define buffer buf_db-attr for ub.db-attr .
    10147       define variable v-type           as character no-undo .
    10148       define variable v-format         as character no-undo .
    10149       define variable v-label          as character no-undo .
    10150       define variable v-user-can-edit  as logical   no-undo .
    10151       define variable v-output-display as logical   no-undo .
    10152       define variable v-other          as character no-undo .
    10153       run thth150-db-attr-code in this-procedure
    10154         (input  p-code
    10155         ,output v-type
    10156         ,output v-format
    10157         ,output v-label
    10158         ,output v-user-can-edit
    10159         ,output v-output-display
    10160         ,output v-other
    10161         ) no-error .
    10162       if error-status :error then do:
    10163         undo, return error return-value .
    10164       end.
    10165       find first buf_db-attr exclusive-lock
