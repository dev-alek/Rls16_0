     4856                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     4857                  no-error .
     4858         find b_price-doc-forming-gds no-lock where
     4859              b_price-doc-forming-gds.b-code     = p-b-code and
     4860              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     4861              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     4862              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     4863              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     4864              no-error.
     4865         if available b_price-doc-forming-gds then
     4866           assign
     4867             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     4868             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     4869             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     4870             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     4871             cost-base   = b_price-doc-forming-gds.price-sale-base
     4872             .
     4873         else
     4874           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     4875                   "для товара :" skip
     4876                    "Бар-код" p-b-code     skip
     4877                    "Артикул" p-artic      skip
     4878                     p-prod-type  skip
     4879                     p-prod-code  skip
     4880                   "- расчет невозможен."
     4881                   view-as alert-box information .
     4882       end.
     4883       when 'Единая':U then do:
     4884           assign
     4885             p-new-calc-method = 'Единая':U + " " + string(common-price)
     4886             cost-rubl = common-price
     4887             cost-base = common-price
     4888             .
     4889       end.
     4890       when 'Объект':U then do:
     4891       find first buf_gds-obj no-lock where
     4892                  buf_gds-obj.gds-code = p-gds-code and
     4893                  buf_gds-obj.obj-type = v-copy-type and
     4894                  buf_gds-obj.obj-code = v-copy-code no-error .
     4895           if available buf_gds-obj then do:
     4896           assign
     4897             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     4898             cost-rubl = buf_gds-obj.price-sale
     4899             cost-base = buf_gds-obj.price-sale
     4900             .
     4901           end.
     4902           else do:
     4903               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     4904                       "для товара :" p-artic  "- расчет невозможен."
     4905                       view-as alert-box information .
     4906           end.
     4907       end.
     4908      when 'Отсутствует':U or
     4909      when "" then do:
     4910         run str/mplnovat.p
     4911           ( input  'Отсутствует':U    ,
     4912             input  table x_obj-group ,
     4913             input  p-b-code    ,
     4914             input  p-artic     ,
     4915             input  p-prod-type ,
     4916             input  p-prod-code ,
     4917             input  0 ,
     4918             input  v-doc-code ,
     4919             input  p-vat-pc      ,
     4920             input  p-slt-pc      ,
