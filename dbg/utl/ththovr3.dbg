     2239     ,input  ''
     2240     ,input  ''
     2241     ,input  ''
     2242     ,input  no
     2243     ,output par-alcohol
     2244     ,output par-type
     2245     ) no-error .
     2246    .
     2247   empty temp-table thbjattr_thbj-attr.
     2248   run adm/shattri.p (
     2249      input "get":U
     2250     ,input l-type
     2251     ,input l-code
     2252     ,input 'overval':U
     2253     ,input  ""
     2254     ,output v-value-character
     2255     ,output v-value-date
     2256     ,output v-value-decimal
     2257     ,output v-value-integer
     2258     ,output v-value-logical
     2259     ,output par-type
     2260     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2261     ) no-error .
     2262   for each thbjattr_thbj-attr :
     2263       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2264       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2265       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2266       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     2267       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     2268       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     2269       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     2270       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     2271       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     2272       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     2273       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     2274       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2275       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2276       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     2277       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2278       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     2279       if v-cntxt-db-num = 0 then do:
     2280         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     2281         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     2282       end.
     2283       else do:
     2284         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     2285         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     2286       end.
     2287   end.
     2288   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2289   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     2290     (input  ?
     2291     ,input  l-type
     2292     ,input  l-code
     2293     ,output par-gen-mrgn-ie
     2294     ,output par-gen-mrgn-iv
     2295     ,output par-gen-mrgn-im
     2296     ) no-error .
     2297      IF error-status :error THEN message
     2298        vss-workfile vss-revision vss-description skip
     2299        error-status :get-message(1) skip
     2300        return-value skip
     2301        "gbl/gtplmrgn.i"
     2302        view-as alert-box error
     2303      .
     2304   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2305   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     2306     (input  ?
     2307     ,input  l-type
     2308     ,input  l-code
     2309     ,output par-pr-nakl-ie
     2310     ,output par-pr-nakl-iv
     2311     ,output par-pr-nakl-im
     2312     ) no-error .
     2313      define variable ii as integer   no-undo .
     2314      define variable nn as integer   no-undo .
     2315      define variable v-fullname as character no-undo .
     2316      nn = num-entries ( par-pr-nogds ).
     2317      par-pr-nogds-long = "".
     2318      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     2319         repeat ii = 1 to nn :
     2320           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     2321           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     2322         end.
     2323         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     2324      end.
     2325   l-par = true .
     2326   end procedure.
     2327   PROCEDURE cre-pr-list:
     2328   define input  parameter bc      like ub.price-list.b-code no-undo.
     2329   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     2330   define output parameter new-rec as recid             no-undo.
     2331   define buffer buf-price-list for ub.price-list.
     2332   define buffer buf-price-doc  for ub.price-doc.
     2333   define buffer buf-bar-code   for ub.bar-code.
     2334   define buffer buf-goods      for ub.goods.
     2335   define buffer buf-gds-prt    for ub.gds-prt.
     2336   define buffer root-gds-prt   for ub.gds-prt.
     2337   define variable cur-pr like ub.price-list.price-sale no-undo.
     2338   define variable cur-rt like ub.price-list.road-tax   no-undo.
     2339   define variable cur-ex like ub.price-list.excise     no-undo.
     2340   define variable cur-dn like ub.price-list.doc-num    no-undo.
     2341   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     2342   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     2343   define variable cur-rt-base as decimal no-undo .
     2344   define variable cur-rt-rubl as decimal no-undo .
     2345   define variable p-hostcode as int no-undo .
     2346   define variable v-line-num as integer no-undo .
     2347   define variable v-skip-del-gds as logical no-undo initial no .
     2348   cre-pr:
     2349   do on error undo cre-pr, return error:
     2350     find  buf-bar-code no-lock where
     2351           buf-bar-code.b-code = bc.
     2352     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     2353     if error-status :error then do:
     2354       message
     2355         return-value skip
     2356         "Ошибка !"
     2357         view-as alert-box error
     2358       .
     2359       undo cre-pr, return.
     2360     end.
     2361     find  buf-goods no-lock where
     2362           buf-goods.gds-code = buf-bar-code.gds-code.
     2363     find first root-gds-prt no-lock where
     2364               root-gds-prt.upper-code = buf-goods.prt-root.
     2365     if root-gds-prt.node-name <> '_Пустая шкала':U and
     2366       buf-bar-code.in-code <> "" then do:
     2367       message
     2368         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     2369         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2370         view-as alert-box error.
     2371       undo cre-pr, return.
     2372     end.
     2373     find  buf-gds-prt no-lock where
     2374           buf-gds-prt.node-code = buf-bar-code.node-code.
     2375     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     2376       message
     2377         "Не допускается создавать цены на удаленные товары!" skip (2)
     2378         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2379         view-as alert-box error.
     2380       undo cre-pr, return.
     2381     end.
     2382     find  buf-price-doc where
     2383           buf-price-doc.doc-num = new-num.
     2384   define variable v-ret as logical no-undo .
     2385      run ver-modificator-price-is-null (
     2386             input    buf-goods.artic        ,
     2387             input    buf-goods.prod-type    ,
     2388             input    buf-goods.prod-code    ,
     2389             input    buf-price-doc.obj-type   ,
     2390             input    buf-price-doc.obj-code   ,
     2391             output   v-ret ).
     2392         if v-ret = false then dO:
     2393             message
     2394               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     2395               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2396               view-as alert-box error.
     2397             undo cre-pr, return.
     2398           end.
     2399   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2401     (input  buf-price-doc.obj-type
     2402     ,input  buf-price-doc.obj-code
     2403     ,output p-hostcode
     2404     ) no-error .
     2405   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2407     (input  buf-goods.gds-code
     2408     ,input  '1':U
     2409     ,input  ?
     2410     ,input  p-hostcode
     2411     ,input  buf-price-doc.obj-type
     2412     ,input  buf-price-doc.obj-code
     2413     ,output local_vat-pc
     2414     ) no-error .
     2415   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2417     (input  buf-goods.gds-code
     2418     ,input  '2':U
     2419     ,input  ?
     2420     ,input  p-hostcode
     2421     ,input  buf-price-doc.obj-type
     2422     ,input  buf-price-doc.obj-code
     2423     ,output local_slt-pc
     2424     ) no-error .
     2425   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2427     (input  buf-price-doc.obj-type
     2428     ,input  buf-price-doc.obj-code
     2429     ,input  bc
     2430     ,input  0
     2431     ,input  0
     2432     ,output cur-dn
     2433     ,output cur-pr
     2434     ,output cur-rt
     2435     ,output cur-ex
     2436     ) no-error .
     2437     find first buf-price-list where
     2438               buf-price-list.b-code  = buf-bar-code.b-code and
     2439               buf-price-list.doc-num = new-num  and
     2440               buf-price-list.price-type = ""    no-error .
     2441     if not available buf-price-list then do:
     2442       run calc-price-line-num (input  new-num , output v-line-num) .
     2443       create buf-price-list.
     2444       assign
     2445         buf-price-list.line-num  = v-line-num
     2446         buf-price-list.b-code    = buf-bar-code.b-code
     2447         buf-price-list.doc-num   = buf-price-doc.doc-num
     2448         buf-price-list.prod-type = buf-goods.prod-type
     2449         buf-price-list.prod-code = buf-goods.prod-code
     2450         buf-price-list.artic     = buf-goods.artic
     2451         buf-price-list.obj-type  = buf-price-doc.obj-type
     2452         buf-price-list.obj-code  = buf-price-doc.obj-code
     2453         buf-price-list.vat-pc    = local_vat-pc
     2454         buf-price-list.slt-pc    = local_slt-pc
     2455         buf-price-list.price-prev = cur-pr
     2456         .
     2457       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     2458           buf-bar-code.in-code   = "" and
     2459           buf-bar-code.part-code = "" and
     2460           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     2461         buf-price-list.main-price = yes.
     2462         if cur-pr <> ? then do:
     2463           run exp-prt (input buf-goods.gds-code,
     2464                       input cur-dn,
     2465                       input new-num,
     2466                       output new-rec) no-error.
     2467           if error-status :error then do:
     2468             message
     2469               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     2470               view-as alert-box error.
     2471             undo cre-pr, return error.
     2472           end.
     2473         end.
     2474       end.
     2475       else do:
     2476         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2477           buf-price-list.d-pcnt = ?.
     2478         end.
     2479         buf-price-list.main-price = no.
     2480       end.
     2481     end.
     2482   end.
     2483   new-rec = recid (buf-price-list).
     2484   END PROCEDURE.
     2485   procedure calc-price-line-num :
     2486    do
     2487    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2488    :
     2489   define input parameter p-doc-num as character no-undo .
     2490   define output parameter p-num  as integer no-undo .
     2491   define variable v-fact as integer no-undo .
     2492   define buffer buf_1_price-list for ub.price-list .
     2493   p-num = 1 .
     2494   find last  buf_1_price-list no-lock where
     2495              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     2496              if available buf_1_price-list then
     2497                   assign
     2498                     v-fact = buf_1_price-list.line-num
     2499                   .
     2500   v-fact = v-fact + 1.
     2501   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     2502    end.
     2503   end procedure.
     2504   PROCEDURE del-pr-list:
     2505   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2506   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2507   define input parameter round-method as character         no-undo.
     2508   define input parameter round-base   as decimal      no-undo.
     2509   define buffer buf-price-list for ub.price-list.
     2510   define buffer buf-bar-code   for ub.bar-code.
     2511   define buffer buf-goods      for ub.goods.
     2512   define variable l-ov-on as logical no-undo .
     2513   del-pr:
     2514   do on error undo del-pr, return error:
     2515     find first  buf-price-list no-lock where
     2516                 buf-price-list.doc-num    = d-num and
     2517                 buf-price-list.b-code     = bc and
     2518                 buf-price-list.price-type = "" no-error.
     2519     if not available buf-price-list then
     2520       undo del-pr, return error.
     2521     find  buf-goods no-lock where
     2522           buf-goods.prod-type = buf-price-list.prod-type and
     2523           buf-goods.prod-code = buf-price-list.prod-code and
     2524           buf-goods.artic     = buf-price-list.artic.
     2525     if buf-price-list.main-price then do:
     2526       for each  buf-price-list exclusive-lock where
     2527                 buf-price-list.doc-num   = d-num and
     2528                 buf-price-list.artic     = buf-goods.artic and
     2529                 buf-price-list.prod-type = buf-goods.prod-type and
     2530                 buf-price-list.prod-code = buf-goods.prod-code,
     2531           first buf-bar-code no-lock where
     2532                 buf-bar-code.b-code = buf-price-list.b-code
     2533       on error undo del-pr, return error:
     2534   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2536     (input  ub.buf-price-list.obj-type
     2537     ,input  ub.buf-price-list.obj-code
     2538     ,input  ub.buf-price-list.artic
     2539     ,input  ub.buf-price-list.prod-type
     2540     ,input  ub.buf-price-list.prod-code
     2541     ,input  'ov-on=request:exclusive'
     2542     ,output l-ov-on
     2543     ) no-error .
     2544         if error-status:error then do:
     2545           message
     2546             vss-workfile vss-revision vss-description skip
     2547             "Ошибка получения признака товара на объекте" skip
     2548             error-status :get-message(1) skip
     2549             return-value skip
     2550             view-as alert-box error .
     2551         end.
     2552         if l-ov-on then do:
     2553   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2555     (input  ub.buf-price-list.obj-type
     2556     ,input  ub.buf-price-list.obj-code
     2557     ,input  ub.buf-price-list.artic
     2558     ,input  ub.buf-price-list.prod-type
     2559     ,input  ub.buf-price-list.prod-code
     2560     ,input  'ov-on=false'
     2561     ,output l-ov-on
     2562     ) no-error .
     2563           if error-status :error then do:
     2564           end.
     2565          end.
     2566         delete buf-price-list.
     2567       end.
     2568     end.
     2569     else do:
     2570       find  buf-bar-code no-lock where
     2571             buf-bar-code.b-code = buf-price-list.b-code.
     2572       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2573         message
     2574           "Нельзя удалить неосновную цену." skip
     2575           "Неосновная цена (скидка) не может быть неопределенной." skip
     2576           "Код:" bc skip
     2577           "Переоценка:" d-num
     2578           view-as alert-box error.
     2579         undo del-pr, return error.
     2580       end.
     2581       find current buf-price-list exclusive-lock no-error .
     2582       delete buf-price-list.
     2583       run calc-base-upd (input buf-bar-code.b-code,
     2584                         input d-num,
     2585                         input round-method,
     2586                         input round-base) no-error.
     2587       if error-status :error then
     2588         undo del-pr, return error.
     2589     end.
     2590   end.
     2591   END PROCEDURE.
     2592   PROCEDURE calc-base-upd:
     2593   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2594   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2595   define input parameter round-method as character         no-undo.
     2596   define input parameter round-base   as decimal      no-undo.
     2597   define buffer alt-bar-code   for ub.bar-code.
     2598   define buffer alt-price-list for ub.price-list.
     2599   define buffer buf-bar-code   for ub.bar-code.
     2600   define buffer buf-goods      for ub.goods.
     2601   calc-base:
     2602   do on error undo calc-base, return error:
     2603     find  buf-bar-code no-lock where
     2604           buf-bar-code.b-code = bc.
     2605     find  buf-goods no-lock where
     2606           buf-goods.gds-code = buf-bar-code.gds-code.
     2607     for each  alt-bar-code no-lock where
     2608               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2609               alt-bar-code.node-code = buf-bar-code.node-code and
     2610               alt-bar-code.part-code = buf-bar-code.part-code and
     2611               alt-bar-code.in-code   = buf-bar-code.in-code and
     2612               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2613         each  alt-price-list where
     2614               alt-price-list.doc-num    = d-num and
     2615               alt-price-list.b-code     = alt-bar-code.b-code and
     2616               alt-price-list.price-type = ""
     2617         on error undo calc-base, return error:
     2618       run calc-pr-alt (input d-num,
     2619                       input alt-bar-code.b-code,
     2620                       input round-method,
     2621                       input round-base) no-error.
     2622       if error-status:error then
     2623         undo calc-base, return error.
     2624     end.
     2625   end.
     2626   END PROCEDURE.
     2627   PROCEDURE calc-pr-alt:
     2628   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2629   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2630   define input parameter r-method as character             no-undo.
     2631   define input parameter r-base   as decimal              no-undo.
     2632   define buffer buf-price-doc  for ub.price-doc.
     2633   define buffer buf-price-list for ub.price-list.
     2634   define buffer buf-bar-code   for ub.bar-code.
     2635   define buffer buf-goods      for ub.goods.
     2636   define buffer old-price-list for ub.price-list.
     2637   define variable pr-rec   as   recid                  no-undo.
     2638   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2639   pr-alt:
     2640   do on error undo pr-alt, return error:
     2641     if r-method = ? or
     2642        r-base = ? then do:
     2643       message
     2644         "Нельзя удалить основную цену." skip
     2645         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2646         "Код:" bc skip
     2647         "Переоценка:" d-num
     2648         view-as alert-box error.
     2649       undo pr-alt, return error.
     2650     end.
     2651     find  buf-price-doc where
     2652           buf-price-doc.doc-num = d-num.
     2653     find  buf-bar-code no-lock where
     2654           buf-bar-code.b-code = bc.
     2655     find  buf-goods no-lock where
     2656           buf-goods.gds-code = buf-bar-code.gds-code.
     2657     find  buf-price-list where
     2658           buf-price-list.doc-num = buf-price-doc.doc-num and
     2659           buf-price-list.b-code  = bc.
     2660     if buf-price-list.d-pcnt = ? then do:
     2661   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2663     (input  buf-price-doc.obj-type
     2664     ,input  buf-price-doc.obj-code
     2665     ,input  bc
     2666     ,input  0
     2667     ,input  0
     2668     ,output pr-rec
     2669     ,output pr-c-b-r
     2670     )  .
     2671       find old-price-list no-lock where
     2672           recid (old-price-list) = pr-rec no-error.
     2673       if available old-price-list and
     2674         old-price-list.b-code = bc then
     2675         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2676       else
     2677         buf-price-list.d-pcnt = 0.
     2678     end.
     2679      if buf-price-list.d-pcnt = ? then do:
     2680         assign
     2681           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2682           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2683           .
     2684     end.
     2685     else do:
     2686         assign
     2687           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2688                                         buf-bar-code.cli-base-rate *
     2689                                         (1 - buf-price-list.d-pcnt / 100)
     2690           buf-price-list.calc-method =  'Основная':U
     2691           .
     2692   case r-method :
     2693     when '9-окончание':U then do:
     2694       if buf-price-list.price-sale < 29 then do:
     2695         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2696           assign
     2697             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2698           .
     2699         end.
     2700       end.
     2701       else do:
     2702         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2703           assign
     2704             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2705                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2706                   - 1 ) * 10
     2707                 + 9
     2708           .
     2709         end.
     2710         else do:
     2711           assign
     2712             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2713                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2714                   ) * 10
     2715                 + 9
     2716           .
     2717         end.
     2718         assign
     2719           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2720         .
     2721       end.
     2722     end.
     2723     when '9-99окончание':U then do:
     2724       if buf-price-list.price-sale < r-base then do:
     2725         assign
     2726           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2727         .
     2728       end.
     2729       else do:
     2730         assign
     2731           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2732         .
     2733       end.
     2734     end.
     2735     when 'Без-дробных':U then do:
     2736       assign
     2737         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2738       .
     2739     end.
     2740     when 'Произвольно':U then do:
     2741       if r-base <> 0 then do:
     2742         assign
     2743           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2744         .
     2745         if buf-price-list.price-sale = 0 then do:
     2746           assign
     2747             buf-price-list.price-sale = r-base
     2748           .
     2749         end.
     2750       end.
     2751     end.
     2752     when 'Вверх':U then do:
     2753       if r-base <> 0 then do:
     2754         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2755           assign
     2756             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2757           .
     2758         end.
     2759       end.
     2760       if buf-price-list.price-sale = 0 then do:
     2761         assign
     2762           buf-price-list.price-sale = r-base
     2763         .
     2764       end.
     2765     end.
     2766     when 'Коэффициент':U then do:
     2767       if r-base <> 0 then do:
     2768         assign
     2769           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2770         .
     2771       end.
     2772     end.
     2773     when 'Отключено':U then do:
     2774     end.
     2775     otherwise do:
     2776       message
     2777         vss-workfile vss-revision vss-description skip
     2778         "Неизвестный метод округления продажной цены" skip
     2779         "round-method" r-method skip
     2780         "round-base"   r-base   skip
     2781         "price"        buf-price-list.price-sale             skip
     2782         view-as alert-box error .
     2783     end.
     2784   end.
     2785     end.
     2786   end.
     2787   END PROCEDURE.
     2788   PROCEDURE calc-pr-discnt:
     2789   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2790   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2791   define buffer buf-price-doc  for ub.price-doc.
     2792   define buffer buf-price-list for ub.price-list.
     2793   define buffer buf-bar-code   for ub.bar-code.
     2794   define buffer buf-goods      for ub.goods.
     2795   define buffer old-price-list for ub.price-list.
     2796   define variable pr-rec   as   recid                  no-undo.
     2797   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2798   pr-discnt:
     2799   do on error undo pr-discnt, return error:
     2800     find  buf-price-doc where
     2801           buf-price-doc.doc-num = d-num.
     2802     find  buf-bar-code no-lock where
     2803           buf-bar-code.b-code = bc.
     2804     find  buf-goods no-lock where
     2805           buf-goods.gds-code = buf-bar-code.gds-code.
     2806     find  buf-price-list where
     2807           buf-price-list.doc-num = buf-price-doc.doc-num and
     2808           buf-price-list.b-code  = bc.
     2809     buf-price-list.d-pcnt = (1 -
     2810                              buf-price-list.price-sale /
     2811                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2812                              buf-bar-code.cli-base-rate) *
     2813                              100
     2814                              .
     2815   end.
     2816   END PROCEDURE.
     2817   PROCEDURE calc-pr-sub :
     2818   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2819   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2820   define  input  parameter calc-method  as character    no-undo.
     2821   define  input  parameter increase-pc  as decimal      no-undo.
     2822   define  input  parameter round-method as character    no-undo.
     2823   define  input  parameter round-base   as decimal      no-undo.
     2824   define  output parameter calc-rec     as recid        no-undo.
     2825   define  buffer buf-price-list for ub.price-list.
     2826   define  buffer buf-bar-code   for ub.bar-code.
     2827   define  buffer buf-goods      for ub.goods.
     2828   define  buffer buf-gds-prt    for ub.gds-prt.
     2829   define  buffer buf-gds-grp    for ub.gds-grp.
     2830   define  buffer buf-price-doc  for ub.price-doc.
     2831   calc-sub:
     2832   do on error undo calc-sub, return error:
     2833     find  buf-bar-code no-lock where
     2834           buf-bar-code.b-code = bc.
     2835     find  buf-goods no-lock where
     2836           buf-goods.gds-code = buf-bar-code.gds-code.
     2837     find  buf-gds-prt no-lock where
     2838           buf-gds-prt.node-code = buf-bar-code.node-code.
     2839     find  buf-price-list where
     2840           buf-price-list.doc-num    = d-num and
     2841           buf-price-list.b-code     = bc and
     2842           buf-price-list.price-type = "".
     2843     find  buf-price-doc where
     2844           buf-price-doc.doc-num = d-num.
     2845     calc-rec = recid (buf-price-list).
     2846     if buf-price-list.main-price then do:
     2847       for each  buf-price-list where
     2848                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2849                 buf-price-list.main-price = no and
     2850                 buf-price-list.artic      = buf-goods.artic and
     2851                 buf-price-list.prod-type  = buf-goods.prod-type and
     2852                 buf-price-list.prod-code  = buf-goods.prod-code,
     2853           first buf-bar-code no-lock where
     2854                 buf-bar-code.b-code   = buf-price-list.b-code and
     2855                 buf-bar-code.unit-cli = buf-goods.unit-base
     2856           on error undo calc-sub, return error:
     2857         run calc-pr-list (input  buf-bar-code.b-code,
     2858                           input  buf-price-list.doc-num,
     2859                           input  calc-method,
     2860                           input  increase-pc,
     2861                           input  round-method,
     2862                           input  round-base,
     2863                           input ? ,
     2864                           input ? ,
     2865                           input ? ,
     2866                           input ? ,
     2867                           output calc-rec) no-error.
     2868         if error-status :error then
     2869           undo calc-sub, return error.
     2870         calc-rec = recid (buf-price-list).
     2871       end.
     2872       for each  buf-price-list where
     2873                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2874                 buf-price-list.main-price = no and
     2875                 buf-price-list.artic      = buf-goods.artic and
     2876                 buf-price-list.prod-type  = buf-goods.prod-type and
     2877                 buf-price-list.prod-code  = buf-goods.prod-code,
     2878           first buf-bar-code no-lock where
     2879                 buf-bar-code.b-code    = buf-price-list.b-code and
     2880                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2881           on error undo calc-sub, return error:
     2882         run calc-pr-alt (input buf-price-doc.doc-num,
     2883                         input buf-bar-code.b-code,
     2884                         input round-method,
     2885                         input round-base) no-error.
     2886         if error-status :error then
     2887           undo calc-sub, return error.
     2888       end.
     2889     end.
     2890     else do:
     2891       run calc-base-upd (input buf-bar-code.b-code,
     2892                         input buf-price-doc.doc-num,
     2893                         input round-method,
     2894                         input round-base) no-error.
     2895       if error-status :error then
     2896         undo calc-sub, return error.
     2897     end.
     2898   end.
     2899   END PROCEDURE.
     2900   procedure ver-pr-nogds :
     2901   define input  parameter p-gds-code      as integer   no-undo .
     2902   define input  parameter p-par-pr-nogds  as character no-undo .
     2903   define output parameter p-not           as logical   no-undo .
     2904   define output parameter p-str           as character no-undo .
     2905   define buffer buf_goods for ub.goods  .
     2906   define variable nn as integer   no-undo .
     2907   define variable ii as integer   no-undo .
     2908   define variable v-namegrp as character no-undo .
     2909     do
     2910     on error undo, return error return-value
     2911     :
     2912     if p-par-pr-nogds = "1" then do:
     2913        assign
     2914         p-not = true
     2915         p-str = ""
     2916        .
     2917        return .
     2918     end.
     2919     assign
     2920       p-not = false
     2921       p-str = ""
     2922     .
     2923     find first buf_goods no-lock where
     2924                buf_goods.gds-code = p-gds-code no-error .
     2925     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2926     repeat ii = 1 to nn:
     2927        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2928        if buf_goods.grp-name  begins v-namegrp  then do:
     2929           assign
     2930             p-not = true
     2931             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2932           .
     2933           leave .
     2934        end.
     2935     end.
     2936     end.
     2937   end procedure.
     2938   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2939   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2940   define temp-table tt-level-dis-attr no-undo
     2941         field attr-code   like global-state-attr.attr-code
     2942         field attr-value  like global-state-attr.attr-value
     2943         index pi   attr-value descending
     2944         index pi1 is unique attr-value
     2945               attr-code .
     2946   procedure lvldsc-byattr :
     2947   define input  parameter p-attr-code  as character no-undo .
     2948   define input  parameter p-attr-value as character no-undo .
     2949   define output parameter p-val1       as decimal   no-undo .
     2950   define output parameter p-val2       as decimal   no-undo .
     2951   define output parameter p-prc        as decimal   no-undo .
     2952     do
     2953     on error undo, return error return-value
     2954     :
     2955     define variable v-str1 as character no-undo .
     2956     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     2957     v-str1 = trim ( v-str1 , chr(4) ) .
     2958    run lvldsc-bytt (
     2959         input   v-str1
     2960       , input   p-attr-value
     2961       , output  p-val1
     2962       , output  p-val2
     2963       , output  p-prc )
     2964         no-error .
     2965     end.
     2966   end procedure.
     2967   procedure lvldsc-bytt :
     2968   define input  parameter p-attr-code as character no-undo .
     2969   define input  parameter p-attr-value as character no-undo .
     2970   define output parameter p-val1 as decimal   no-undo .
     2971   define output parameter p-val2 as decimal   no-undo .
     2972   define output parameter p-prc  as decimal   no-undo .
     2973   define variable v-str1 as character no-undo .
     2974     do
     2975     on error undo, return error return-value
     2976     :
     2977     assign
     2978        v-str1 = trim ( p-attr-code , "[]()" )
     2979        p-val1 = decimal(entry(1,v-str1, ";"))
     2980        p-val2 = decimal(entry(2,v-str1, ";"))
     2981        p-prc  = decimal(p-attr-value)
     2982        no-error
     2983     .
     2984     end.
     2985   end procedure.
     2986   procedure level-dis-value :
     2987   define input  parameter p-price-prod as decimal   no-undo .
     2988   define input  parameter p-b-code     as integer   no-undo .
     2989   define input  parameter p-obj-type   as character no-undo .
     2990   define input  parameter p-obj-code   as integer   no-undo .
     2991   define output parameter p-prc as decimal   no-undo .
     2992   define variable v-level-dis-attr as character no-undo .
     2993   define variable v-type as character no-undo .
     2994   define variable v-val1 as decimal   no-undo .
     2995   define variable v-val2 as decimal   no-undo .
     2996   define variable v-prc  as decimal   no-undo .
     2997   define variable ix     as integer   no-undo .
     2998   do
     2999    on error undo, return error return-value
     3000    :
     3001   define buffer buf_goods for ub.goods  .
     3002   define buffer buf_bar-code for ub.bar-code  .
     3003   find first buf_bar-code no-lock where
     3004              buf_bar-code.b-code = p-b-code
     3005              no-error .
     3006   find first buf_goods no-lock where
     3007              buf_goods.gds-code = buf_bar-code.gds-code
     3008              no-error .
     3009   run ggoattr-value (
     3010      input   buf_goods.grp-code
     3011     ,input   v-cntxt-host-code-obj
     3012     ,input   p-obj-type
     3013     ,input   p-obj-code
     3014     ,input   'level-dis':U
     3015     ,output  v-level-dis-attr
     3016     ,output  v-type ) no-error .
     3017   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     3018     create
     3019       tt-level-dis-attr
     3020     .
     3021     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     3022     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     3023   end.
     3024   p-prc = 0 .
     3025     if p-price-prod = 0 then do:
     3026         for each tt-level-dis-attr no-lock
     3027                 :
     3028               run lvldsc-bytt (
     3029                 input   tt-level-dis-attr.attr-code
     3030               , input   tt-level-dis-attr.attr-value
     3031               , output  v-val1
     3032               , output  v-val2
     3033               , output  v-prc  )
     3034               .
     3035               if v-val1  = 0  then do:
     3036                  p-prc = v-prc .
     3037                 leave.
     3038               end.
     3039         end.
     3040     end.
     3041     else do:
     3042         for each tt-level-dis-attr no-lock
     3043                 :
     3044               run lvldsc-bytt (
     3045                 input   tt-level-dis-attr.attr-code
     3046               , input   tt-level-dis-attr.attr-value
     3047               , output  v-val1
     3048               , output  v-val2
     3049               , output  v-prc  )
     3050               .
     3051               if p-price-prod   > v-val1 and
     3052                  p-price-prod  <= v-val2 then do:
     3053                  p-prc = v-prc .
     3054                 leave.
     3055               end.
     3056         end.
     3057     end.
     3058   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     3059    end.
     3060   end procedure.
     3061   procedure calc-price-levelprod :
     3062   define input  parameter p-mode     as integer   no-undo .
     3063   define input  parameter p-rb       as character no-undo .
     3064   define input  parameter p-b-code   as integer   no-undo .
     3065   define input  parameter p-obj-type as character no-undo .
     3066   define input  parameter p-obj-code as integer   no-undo .
     3067   define output parameter p-price-sale as decimal   no-undo .
     3068   define output parameter p-descript-calc as character no-undo .
     3069   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     3070   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     3071   define variable  v-prod-vat        as decimal   no-undo init 0.
     3072   define variable  v-discnt          as decimal   no-undo init 0.
     3073   define buffer buf_goods for ub.goods  .
     3074   define buffer buf_bar-code for ub.bar-code  .
     3075   define buffer buf_parts for ub.parts  .
     3076   define variable v-part-code as character no-undo .
     3077   define variable v-in-code   as character no-undo .
     3078     do
     3079     on error undo, return error return-value
     3080     :
     3081   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3082   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3083   (  input  p-b-code
     3084    , input  p-obj-type
     3085    , input  p-obj-code
     3086    , output v-PriceWithoutVat
     3087    , output v-PriceWithVat
     3088    , output v-prod-vat
     3089    , output v-part-code
     3090    , output v-in-code
     3091           ) no-error .
     3092         if error-status :error then do:
     3093           return error "Нет цены производителя!".
     3094         end.
     3095   find first buf_bar-code no-lock where
     3096              buf_bar-code.b-code = p-b-code
     3097              no-error .
     3098   find first buf_goods no-lock where
     3099              buf_goods.gds-code = buf_bar-code.gds-code
     3100              no-error .
     3101   find first buf_parts no-lock where
     3102              buf_parts.artic      = buf_goods.artic        and
     3103              buf_parts.prod-type  = buf_goods.prod-type    and
     3104              buf_parts.prod-code  = buf_goods.prod-code    and
     3105              buf_parts.in-code    = buf_bar-code.in-code   and
     3106              buf_parts.out-code   = buf_bar-code.in-code   and
     3107              buf_parts.part-code  = buf_bar-code.part-code
     3108              no-error .
     3109               if error-status :error then do:
     3110                   find first buf_parts no-lock where
     3111                             buf_parts.artic      = buf_goods.artic        and
     3112                             buf_parts.prod-type  = buf_goods.prod-type    and
     3113                             buf_parts.prod-code  = buf_goods.prod-code    and
     3114                             buf_parts.in-code    = v-in-code              and
     3115                             buf_parts.out-code   = v-in-code              and
     3116                             buf_parts.part-code  = v-part-code
     3117                             no-error .
     3118                   if error-status :error then do:
     3119                      message
     3120                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     3121                                   v-in-code,
     3122                                   v-part-code ,
     3123                                   buf_goods.artic   ,
     3124                                   buf_goods.prod-type,
     3125                                   buf_goods.prod-code ) .
     3126                      return error "Нет цены производителя !!!".
     3127                   end.
     3128               end.
     3129   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     3130   define variable v-postWithoutVat-rubl as decimal   no-undo .
     3131   define variable v-postWithoutVat-base as decimal   no-undo .
     3132      case p-mode :
     3133       when 1 then do:
     3134          if p-rb = "rubl" then do:
     3135             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     3136          end.
     3137          else do:
     3138             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     3139          end.
     3140       end.
     3141       when 2 then do:
     3142         if p-rb = "rubl" then do:
     3143           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     3144           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     3145         end.
     3146         else do:
     3147           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     3148           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     3149         end.
     3150       end.
     3151      end case.
     3152   p-descript-calc =
     3153     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     3154     buf_goods.gds-name                  +  chr(10) +
     3155     buf_goods.artic +
     3156     buf_goods.prod-type +
     3157     string(buf_goods.prod-code)         + chr(10) +
     3158     "бар-код " +  string(p-b-code)      + chr(10)  +
     3159     'ПН    ' + v-in-code  +
     3160     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     3161     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     3162     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     3163     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     3164     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     3165     chr(10) +
     3166     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     3167     chr(10) +
     3168     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     3169     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     3170     chr(10) +
     3171     string(p-price-sale)                                                               +  chr(10) +
     3172     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     3173     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     3174   .
     3175     end.
     3176   end procedure.
     3177   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3178   PROCEDURE write-bonus :
     3179   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3180   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3181   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3182   define input  parameter v-bonus as decimal   no-undo .
     3183     do
     3184     on error undo, return error return-value
     3185     :
     3186       find first ub.contract-specif-attr exclusive-lock  where
     3187                  ub.contract-specif-attr.contract-num = p-contract-num  and
     3188                  ub.contract-specif-attr.host-code    = p-host-code     and
     3189                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     3190                  ub.contract-specif-attr.attr-code    = 'bonus':U
     3191                 no-error .
     3192         if not available ub.contract-specif-attr then do:
     3193            create ub.contract-specif-attr .
     3194            assign
     3195                 ub.contract-specif-attr.contract-num = p-contract-num
     3196                 ub.contract-specif-attr.host-code    = p-host-code
     3197                 ub.contract-specif-attr.gds-code     = p-gds-code
     3198                 ub.contract-specif-attr.attr-code    = 'bonus':U
     3199            .
     3200         end.
     3201         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     3202   end.
     3203   END PROCEDURE.
     3204   PROCEDURE read-bonus :
     3205   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3206   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3207   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3208   define output parameter v-bonus as decimal   no-undo .
     3209     do
     3210     on error undo, return error return-value
     3211     :
     3212   find first ub.contract-specif-attr no-lock  where
     3213              ub.contract-specif-attr.contract-num = p-contract-num  and
     3214              ub.contract-specif-attr.host-code    = p-host-code     and
     3215              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3216              ub.contract-specif-attr.attr-code    = 'bonus':U
     3217              no-error .
     3218      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     3219                                           else  v-bonus = 0 .
     3220   end.
     3221   END PROCEDURE.
     3222   PROCEDURE write-prc-min :
     3223   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3224   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3225   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3226   define input  parameter v-prc-min        as decimal   no-undo .
     3227     do
     3228     on error undo, return error return-value
     3229     :
     3230       find first ub.contract-specif-attr exclusive-lock  where
     3231                 ub.contract-specif-attr.contract-num = p-contract-num  and
     3232                 ub.contract-specif-attr.host-code    = p-host-code     and
     3233                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     3234                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     3235                 no-error .
     3236         if not available ub.contract-specif-attr then do:
     3237            create ub.contract-specif-attr .
     3238            assign
     3239                 ub.contract-specif-attr.contract-num = p-contract-num
     3240                 ub.contract-specif-attr.host-code    = p-host-code
     3241                 ub.contract-specif-attr.gds-code     = p-gds-code
     3242                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     3243                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     3244            .
     3245         end.
     3246         else do:
     3247            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     3248         end.
     3249       find first ub.contract-specif exclusive-lock where
     3250           ub.contract-specif.contract-num = p-contract-num and
     3251           ub.contract-specif.host-code    = p-host-code    and
     3252           ub.contract-specif.gds-code     = p-gds-code.
     3253           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3254   end.
     3255   END PROCEDURE.
     3256   PROCEDURE read-prc-min :
     3257   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3258   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3259   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3260   define output parameter v-prc-min as decimal   no-undo .
     3261     do
     3262     on error undo, return error return-value
     3263     :
     3264   find first ub.contract-specif-attr no-lock  where
     3265              ub.contract-specif-attr.contract-num = p-contract-num  and
     3266              ub.contract-specif-attr.host-code    = p-host-code     and
     3267              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3268              ub.contract-specif-attr.attr-code    = 'prc-min':U
     3269              no-error .
     3270      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     3271                                           else  v-prc-min = 0 .
     3272   end.
     3273   END PROCEDURE.
     3274   PROCEDURE write-retro-bonus :
     3275   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3276   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3277   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3278   define input  parameter v-retro-bonus as character   no-undo .
     3279     do
     3280     on error undo, return error return-value
     3281     :
     3282       find first ub.contract-specif-attr exclusive-lock  where
     3283                 ub.contract-specif-attr.contract-num = p-contract-num  and
     3284                 ub.contract-specif-attr.host-code    = p-host-code     and
     3285                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     3286                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     3287                 no-error .
     3288         if not available ub.contract-specif-attr then do:
     3289            create ub.contract-specif-attr .
     3290            assign
     3291                 ub.contract-specif-attr.contract-num = p-contract-num
     3292                 ub.contract-specif-attr.host-code    = p-host-code
     3293                 ub.contract-specif-attr.gds-code     = p-gds-code
     3294                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     3295            .
     3296            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     3297            if error-status:error then
     3298               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     3299         end.
     3300         else do:
     3301            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     3302            if error-status:error then
     3303               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     3304         end.
     3305       find first ub.contract-specif exclusive-lock where
     3306           ub.contract-specif.contract-num = p-contract-num and
     3307           ub.contract-specif.host-code    = p-host-code    and
     3308           ub.contract-specif.gds-code     = p-gds-code.
     3309           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3310   end.
     3311   END PROCEDURE.
     3312   PROCEDURE read-retro-bonus :
     3313   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3314   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3315   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3316   define output parameter v-retro-bonus as character   no-undo .
     3317     do
     3318     on error undo, return error return-value
     3319     :
     3320   find first ub.contract-specif-attr no-lock  where
     3321              ub.contract-specif-attr.contract-num = p-contract-num  and
     3322              ub.contract-specif-attr.host-code    = p-host-code     and
     3323              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3324              ub.contract-specif-attr.attr-code    = "retro-bonus"
     3325              no-error .
     3326      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     3327                                           else  v-retro-bonus = "" .
     3328   end.
     3329   END PROCEDURE.
     3330   define variable v-str1 as character no-undo .
     3331   FUNCTION fnc-base-price-doc RETURN decimal
     3332     ( local-bc as integer, p-recid as recid ).
     3333   define buffer   base-price       for ub.price-doc-forming-gds .
     3334   define variable local-main-code like ub.bar-code.b-code no-undo.
     3335   define variable local-base-code like ub.bar-code.b-code no-undo.
     3336   define buffer   buf_main-pdf     for ub.price-doc-forming .
     3337   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     3338     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     3339     find base-price no-lock where
     3340          base-price.pdf-id = buf_main-pdf.pdf-id and
     3341          base-price.pdf-db = buf_main-pdf.pdf-db and
     3342          base-price.plt-id = buf_main-pdf.plt-id and
     3343          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     3344          base-price.b-code  = local-base-code
     3345          no-error.
     3346     if not available base-price then do:
     3347       run prc-main-code in this-procedure
     3348          ( input local-bc, output local-main-code ).
     3349       find  base-price no-lock where
     3350             base-price.pdf-id = buf_main-pdf.pdf-id and
     3351             base-price.pdf-db = buf_main-pdf.pdf-db and
     3352             base-price.plt-id = buf_main-pdf.plt-id and
     3353             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     3354             base-price.b-code  = local-main-code
     3355             no-error.
     3356     end.
     3357     if available base-price then
     3358       return (base-price.price-sale-doc).
     3359     else
     3360       return (?).
     3361   END FUNCTION.
