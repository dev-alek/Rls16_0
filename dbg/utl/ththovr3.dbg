     5453       ub.price-doc-forming-gds.artic            = p-artic
     5454       ub.price-doc-forming-gds.prod-type        = p-prod-type
     5455       ub.price-doc-forming-gds.prod-code        = p-prod-code
     5456       ub.price-doc-forming-gds.calc-method      = p-calc-method
     5457       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     5458       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     5459       ub.price-doc-forming-gds.start-date       = p-start-date
     5460       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     5461       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     5462       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     5463       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     5464       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     5465       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     5466       ub.price-doc-forming-gds.end-date         = p-end-date
     5467       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     5468       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     5469       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     5470       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     5471       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     5472       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     5473       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     5474       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     5475       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     5476       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     5477       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     5478       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     5479       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     5480       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     5481       ub.price-doc-forming-gds.excise-base      = p-excise-base
     5482       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     5483       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     5484       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     5485       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     5486       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     5487       ub.price-doc-forming-gds.stts             = p-stts
     5488       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     5489       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     5490       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     5491       .
     5492     run ref/h-pdfgds.p
     5493       ( buffer ub.price-doc-forming-gds ,
     5494         input p-price-sale-doc ,
     5495         input-output v-sec
     5496         ) .
     5497   END PROCEDURE.
     5498   PROCEDURE last-num :
     5499   define input  parameter p-recid as recid no-undo .
     5500   define output parameter p-last-id as integer   no-undo .
     5501   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     5502   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5503   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     5504         if error-status :error then do:
     5505           p-last-id = ? .
     5506           return .
     5507         end.
     5508       for each buf2_price-doc-forming-gds no-lock  where
     5509               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     5510               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     5511               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     5512               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     5513               by buf2_price-doc-forming-gds.line-num
     5514               :
     5515               p-last-id = buf2_price-doc-forming-gds.line-num .
     5516       end.
     5517   END PROCEDURE.
     5518   PROCEDURE calc-price-alt :
     5519   define input parameter bc         like ub.bar-code.b-code   no-undo.
     5520   define input parameter p-recid as recid no-undo .
     5521   define input parameter d-pcnt as decimal   no-undo .
     5522   define input parameter r-method   as character no-undo .
     5523   define input parameter r-base     as decimal   no-undo .
     5524   define output parameter pa-price-sale-base  as decimal   no-undo .
     5525   define output parameter pa-price-sale-doc   as decimal   no-undo .
     5526   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     5527   pr-alt:
     5528   do on error undo pr-alt, return error:
     5529     if r-method = ? or
     5530        r-base = ? then do:
     5531       message
     5532         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     5533         "Код:" bc skip
     5534         view-as alert-box error.
     5535       undo pr-alt, return error.
     5536     end.
     5537   define buffer buf_bar-code for ub.bar-code  .
     5538   define buffer buf_main_bar-code for ub.bar-code  .
     5539   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     5540   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5541   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     5542   if error-status :error then
     5543   message
     5544     vss-workfile vss-revision vss-description skip
     5545     error-status :get-message(1) skip
     5546     return-value skip
     5547     "Ошибка "
     5548     view-as alert-box error
     5549   .
     5550   find first buf_bar-code no-lock where
     5551              buf_bar-code.b-code = bc no-error .
     5552   if error-status :error then
     5553   message
     5554     vss-workfile vss-revision vss-description skip
     5555     error-status :get-message(1) skip
     5556     return-value skip
     5557     "3"
     5558     view-as alert-box error
     5559   .
     5560         assign
     5561           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     5562                               buf_bar-code.cli-base-rate *
     5563                               (1 - d-pcnt / 100)
     5564                                 .
     5565     if pa-price-sale-doc <> 0 then do:
     5566   case r-method :
     5567     when '9-окончание':U then do:
     5568       if pa-price-sale-doc < 29 then do:
     5569         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     5570           assign
     5571             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     5572           .
     5573         end.
     5574       end.
     5575       else do:
     5576         if (pa-price-sale-doc modulo 10) < 3 then do:
     5577           assign
     5578             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5579                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5580                   - 1 ) * 10
     5581                 + 9
     5582           .
     5583         end.
     5584         else do:
     5585           assign
     5586             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5587                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5588                   ) * 10
     5589                 + 9
     5590           .
     5591         end.
     5592         assign
     5593           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5594         .
     5595       end.
     5596     end.
     5597     when '9-99окончание':U then do:
     5598       if pa-price-sale-doc < r-base then do:
     5599         assign
     5600           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     5601         .
     5602       end.
     5603       else do:
     5604         assign
     5605           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     5606         .
     5607       end.
     5608     end.
     5609     when 'Без-дробных':U then do:
     5610       assign
     5611         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5612       .
     5613     end.
     5614     when 'Произвольно':U then do:
     5615       if r-base <> 0 then do:
     5616         assign
     5617           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     5618         .
     5619         if pa-price-sale-doc = 0 then do:
     5620           assign
     5621             pa-price-sale-doc = r-base
     5622           .
     5623         end.
     5624       end.
     5625     end.
     5626     when 'Вверх':U then do:
     5627       if r-base <> 0 then do:
     5628         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     5629           assign
     5630             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     5631           .
     5632         end.
     5633       end.
     5634       if pa-price-sale-doc = 0 then do:
     5635         assign
     5636           pa-price-sale-doc = r-base
     5637         .
     5638       end.
     5639     end.
     5640     when 'Коэффициент':U then do:
     5641       if r-base <> 0 then do:
     5642         assign
     5643           pa-price-sale-doc = pa-price-sale-doc * r-base
     5644         .
     5645       end.
     5646     end.
     5647     when 'Отключено':U then do:
     5648     end.
     5649     otherwise do:
     5650       message
     5651         vss-workfile vss-revision vss-description skip
     5652         "Неизвестный метод округления продажной цены" skip
     5653         "round-method" r-method skip
     5654         "round-base"   r-base   skip
     5655         "price"        pa-price-sale-doc             skip
     5656         view-as alert-box error .
     5657     end.
     5658   end.
     5659     end.
     5660     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     5661     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     5662   end.
     5663   END PROCEDURE.
     5664   procedure calc-price-discnt :
     5665     do
     5666     on error undo, return error return-value
     5667     :
     5668   define input parameter p-recid as recid no-undo .
     5669   define input parameter bc    like ub.bar-code.b-code   no-undo.
     5670   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     5671   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5672   define buffer buf-bar-code                      for ub.bar-code.
     5673   define buffer buf-goods                         for ub.goods.
     5674   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     5675   define variable pr-rec   as   recid                     no-undo.
     5676   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     5677   pr-discnt:
     5678   do on error undo pr-discnt, return error:
     5679     find  buf-price-doc-forming no-lock where
     5680           recid(buf-price-doc-forming) = p-recid .
     5681     find  buf-bar-code no-lock where
     5682           buf-bar-code.b-code = bc.
     5683     find  buf-goods no-lock where
     5684           buf-goods.gds-code = buf-bar-code.gds-code.
     5685     find  buf-price-doc-forming-gds exclusive-lock where
     5686           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5687           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5688           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5689           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5690           buf-price-doc-forming-gds.b-code  = bc.
     5691      if available buf-price-doc-forming-gds then do:
     5692         buf-price-doc-forming-gds.d-pcnt =
     5693         (1 - buf-price-doc-forming-gds.price-sale-doc /
     5694               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     5695               buf-bar-code.cli-base-rate) * 100 .
     5696      end.
     5697   end.
     5698     end.
     5699   end procedure.
     5700   procedure calc-price-sub :
     5701   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     5702   define  input  parameter p-recid      as recid no-undo .
     5703   define  input  parameter calc-method  as character         no-undo.
     5704   define  input  parameter increase-pc  as decimal           no-undo.
     5705   define  input  parameter round-method as character         no-undo.
     5706   define  input  parameter round-base   as decimal           no-undo.
     5707   define  input  parameter doc-code     as character no-undo .
     5708   define  input  parameter common-price as decimal   no-undo .
     5709   define  input  parameter copy-type    as character no-undo .
     5710   define  input  parameter copy-code    as integer   no-undo .
     5711   define  output parameter calc-rec     as recid             no-undo.
     5712   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5713   define  buffer buf-bar-code              for ub.bar-code.
     5714   define  buffer buf-goods                 for ub.goods.
     5715   define  buffer buf-gds-prt               for ub.gds-prt.
     5716   define  buffer buf-gds-grp               for ub.gds-grp.
     5717   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     5718   calc-sub:
     5719   do on error undo calc-sub, return error:
     5720     find  buf-price-doc-forming no-lock where
     5721           recid (buf-price-doc-forming) =  p-recid .
     5722     find  buf-bar-code no-lock where
     5723           buf-bar-code.b-code = bc.
     5724     find  buf-goods no-lock where
     5725           buf-goods.gds-code = buf-bar-code.gds-code.
     5726     find  buf-gds-prt no-lock where
     5727           buf-gds-prt.node-code = buf-bar-code.node-code.
     5728     find  buf-price-doc-forming-gds where
     5729           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5730           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5731           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5732           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5733           buf-price-doc-forming-gds.b-code      = bc no-error .
     5734     calc-rec = recid (buf-price-doc-forming-gds).
     5735     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     5736       for each  buf-price-doc-forming-gds exclusive-lock where
     5737                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5738                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5739                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5740                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5741                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5742                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5743                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5744           first buf-bar-code no-lock where
     5745                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     5746                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     5747           first buf-gds-prt no-lock where
     5748                 buf-gds-prt.node-code = buf-bar-code.node-code and
     5749                 buf-gds-prt.upper-code <> buf-goods.prt-root
     5750           on error undo calc-sub, return error:
     5751             run calc-price-line  in this-procedure
     5752               ( input  calc-method
     5753               , input  increase-pc
     5754               , input  round-method
     5755               , input  round-base
     5756               , input  buf-bar-code.b-code
     5757               , input  buf-goods.gds-code
     5758               , input  buf-goods.artic
     5759               , input  buf-goods.prod-type
     5760               , input  buf-goods.prod-code
     5761               , input  buf-price-doc-forming.base-rate
     5762               , input  buf-price-doc-forming.base-scale
     5763               , input  buf-price-doc-forming.exch-scale
     5764               , input  buf-price-doc-forming.exch-rate
     5765               , input  doc-code
     5766               , input  common-price
     5767               , input  copy-type
     5768               , input  copy-code
     5769               , output buf-price-doc-forming-gds.calc-method
     5770               , output buf-price-doc-forming-gds.price-calc-base
     5771               , output buf-price-doc-forming-gds.price-calc-doc
     5772               , output buf-price-doc-forming-gds.price-calc-rubl
     5773               , output buf-price-doc-forming-gds.price-prev-base
     5774               , output buf-price-doc-forming-gds.price-prev-doc
     5775               , output buf-price-doc-forming-gds.price-prev-rubl
     5776               , output buf-price-doc-forming-gds.price-sale-base
     5777               , output buf-price-doc-forming-gds.price-sale-doc
     5778               , output buf-price-doc-forming-gds.price-sale-rubl
     5779               , output buf-price-doc-forming-gds.road-tax-base
     5780               , output buf-price-doc-forming-gds.road-tax-doc
     5781               , output buf-price-doc-forming-gds.road-tax-rubl
     5782               , output buf-price-doc-forming-gds.excise-base
     5783               , output buf-price-doc-forming-gds.excise-doc
     5784               , output buf-price-doc-forming-gds.excise-rubl
     5785               , output buf-price-doc-forming-gds.vat-pc
     5786               , output buf-price-doc-forming-gds.slt-pc
     5787               , output buf-price-doc-forming-gds.prev-doc-code
     5788               , output buf-price-doc-forming-gds.d-pcnt
     5789               ) no-error .
     5790             if error-status :error then do :
     5791               message
     5792                 vss-workfile vss-revision vss-description skip
     5793                 error-status :get-message(1) skip
     5794                 return-value skip
     5795                 "calc-price-line"
     5796                 view-as alert-box error
     5797               .
     5798               undo calc-sub, return error.
     5799               end.
     5800         calc-rec = recid (buf-price-doc-forming-gds).
     5801       end.
     5802       for each  buf-price-doc-forming-gds exclusive-lock where
     5803                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5804                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5805                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5806                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5807                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5808                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5809                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5810           first buf-bar-code no-lock where
     5811                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     5812                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     5813           first buf-gds-prt no-lock where
     5814                 buf-gds-prt.node-code = buf-bar-code.node-code
     5815           on error undo calc-sub, return error:
     5816       end.
     5817     end.
     5818     else do:
     5819     end.
     5820   end.
     5821   end procedure.
     5822   procedure calc-base-update :
     5823   define input parameter bc           like ub.bar-code.b-code   no-undo.
     5824   define input parameter p-recid      as recid no-undo .
     5825   define input parameter round-method as character    no-undo.
     5826   define input parameter round-base   as decimal      no-undo.
     5827   define buffer alt-bar-code              for ub.bar-code.
     5828   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     5829   define buffer buf-bar-code              for ub.bar-code.
     5830   define buffer buf-goods                 for ub.goods.
     5831   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     5832   calc-base:
     5833   do on error undo calc-base, return error :
     5834     find  buf-price-doc-forming no-lock where
     5835           recid (buf-price-doc-forming) =  p-recid .
     5836     find  buf-bar-code no-lock where
     5837           buf-bar-code.b-code = bc.
     5838     find  buf-goods no-lock where
     5839           buf-goods.gds-code = buf-bar-code.gds-code.
     5840     for each  alt-bar-code no-lock where
     5841               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     5842               alt-bar-code.node-code = buf-bar-code.node-code and
     5843               alt-bar-code.part-code = buf-bar-code.part-code and
     5844               alt-bar-code.in-code   = buf-bar-code.in-code and
     5845               alt-bar-code.unit-cli <> buf-goods.unit-base,
     5846         each  alt-price-doc-forming-gds exclusive-lock where
     5847               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     5848               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     5849               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     5850               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5851               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     5852         on error undo calc-base, return error:
     5853     run calc-price-alt in this-procedure
     5854         ( input  alt-price-doc-forming-gds.b-code
     5855         , input  p-recid
     5856         , input  alt-price-doc-forming-gds.d-pcnt
     5857         , input  round-method
     5858         , input  round-base
     5859         , output alt-price-doc-forming-gds.price-sale-base
     5860         , output alt-price-doc-forming-gds.price-sale-doc
     5861         , output alt-price-doc-forming-gds.price-sale-rubl
     5862         ) no-error .
     5863       if error-status:error then do:
     5864       message
     5865         vss-workfile vss-revision vss-description skip
     5866         error-status :get-message(1) skip
     5867         return-value skip
     5868         "calc-price-alt"
     5869         view-as alert-box error
     5870       .
     5871         undo calc-base, return error.
     5872       end.
     5873     end.
     5874   end.
     5875   end procedure.
     5876   define temp-table temp-exp-partbc no-undo
     5877   field b-code  as integer
     5878   index pi b-code
     5879   .
     5880   procedure expose-prt :
     5881   define input  parameter p-calc-method  as character no-undo .
     5882   define input  parameter p-increase-pc as decimal   no-undo .
     5883   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     5884   define input  parameter old-recid      as recid no-undo .
     5885   define input  parameter new-recid      as recid no-undo .
     5886   define input  parameter p-round-method as character no-undo .
     5887   define input  parameter p-round-base   as decimal   no-undo .
     5888   define input  parameter v-doc-code     as character no-undo .
     5889   define input  parameter v-common-price as decimal   no-undo .
     5890   define input  parameter v-copy-type    as character no-undo .
     5891   define input  parameter v-copy-code    as integer   no-undo .
     5892   define input-output parameter v-line-num as integer   no-undo .
     5893   define input-output parameter v-sec      as integer   no-undo .
     5894   define output parameter new-rec-str      as recid   no-undo.
     5895   define buffer buf-bar-code              for ub.bar-code.
     5896   define buffer buf-goods                 for ub.goods.
     5897   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5898   define buffer buf-price-list            for ub.price-doc-forming-gds.
     5899   define buffer buf-price-doc-forming     for ub.price-doc-forming.
     5900   define buffer new-price-doc-forming     for ub.price-doc-forming.
     5901   define buffer new-price-doc-forming-gds for ub.price-doc-forming-gds  .
     5902   define buffer buf-gds-prt               for ub.gds-prt  .
     5903   define buffer buf_parts for ub.parts  .
     5904   define buffer buf_goods for ub.goods  .
     5905     do
     5906     on error undo, return error return-value
     5907     :
     5908     find  buf-price-doc-forming no-lock where
     5909           recid(buf-price-doc-forming) = old-recid .
     5910     find  new-price-doc-forming no-lock where
     5911           recid(new-price-doc-forming) = new-recid .
     5912     find  buf-bar-code no-lock where
     5913           buf-bar-code.b-code = p-main-code.
