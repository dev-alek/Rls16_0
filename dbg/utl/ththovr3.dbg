     4802                 input 0                ,
     4803                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4804                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4805                 output cost-rubl       ,
     4806                 output v4
     4807                 ) no-error .
     4808             end.
     4809             else do:
     4810               run str/pr-wbil.p
     4811               ( input ""            ,
     4812                 input 'Накладная':U ,
     4813                 input v1               ,
     4814                 input v2               ,
     4815                 input v3               ,
     4816                 input v-doc-code       ,
     4817                 input ""               ,
     4818                 input p-gds-code       ,
     4819                 input p-artic          ,
     4820                 input p-prod-type      ,
     4821                 input p-prod-code      ,
     4822                 input v4               ,
     4823                 input 0                ,
     4824                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4825                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4826                 output cost-base       ,
     4827                 output v4
     4828                 ) no-error .
     4829             end.
     4830             if not error-status :error then
     4831                 assign
     4832                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     4833                .
     4834       end.
     4835       when 'Переоценка':U then do:
     4836         find prev-list where
     4837              prev-list.b-code     = p-b-code and
     4838              prev-list.price-type = "" and
     4839              prev-list.doc-num    = v-doc-code no-lock no-error.
     4840         if available prev-list then
     4841           assign
     4842             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     4843             cur-rt-base = prev-list.road-tax
     4844             cur-rt-rubl = prev-list.road-tax
     4845             cost-rubl = prev-list.price-sale
     4846             cost-base = prev-list.price-sale
     4847             .
     4848         else
     4849           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     4850                   "- расчет невозможен."
     4851                   view-as alert-box information .
     4852       end.
     4853       when 'ДокФормЦены':U then do:
