     6688   procedure main-road-taxs :
     6689   define input param p-artic     like ub.gds-obj.artic     no-undo .
     6690   define input param p-prod-type like ub.gds-obj.prod-type no-undo .
     6691   define input param p-prod-code like ub.gds-obj.prod-code no-undo .
     6692   define input-output param p-road-tax-base as decimal no-undo .
     6693   define input-output param p-road-tax-rubl as decimal no-undo .
     6694       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     6695       define buffer   in-vatp-parts    for ub.parts   .
     6696       define buffer   in-vatp-doc      for ub.trn-doc .
     6697       define buffer   in-vatp-goods    for ub.goods   .
     6698       define buffer   in-vatp-sysconf  for ub.sysconf .
     6699       define buffer   in-vatp_doc-attr for ub.doc-attr.
     6700       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     6701       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     6702       define variable varinvprb                  as   character              no-undo.
     6703       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     6704       define variable cli-base-rate              as   decimal                no-undo.
     6705       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     6706       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     6707       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     6708       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     6709       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6710       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6711       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6712       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6713       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6714       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6715       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6716       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     6717       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     6718       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6719       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6720       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6721       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6722       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6723       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6724       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6725       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6726       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6727       define variable varinvatp-envd             as   character              no-undo.
     6728       define variable varinvatp-type             as   character              no-undo.
     6729     do
     6730     on error undo, return error return-value
     6731     :
     6732   define buffer buff-goods   for ub.goods    .
     6733   define buffer buf_gds-obj  for ub.gds-obj  .
     6734   define buffer buf_parts    for ub.parts    .
     6735   define buffer buf_trn-doc  for ub.trn-doc  .
     6736   define buffer buf_doc-line for ub.doc-line .
     6737   define variable is-petrolium as logical   no-undo .
     6738   define variable is-pieces   as  logical   no-undo .
     6739   define variable p-in-code   as  character no-undo .
     6740   define variable p-obj-type  as  character no-undo .
     6741   define variable p-obj-code  as  integer   no-undo .
     6742   define variable v-rec as recid no-undo .
     6743   define variable t-ret as logical no-undo .
     6744   define variable v-total-avrg-base as decimal no-undo .
     6745   define variable v-total-avrg-rubl as decimal no-undo .
     6746   define variable v-total-avrg-qnty as decimal no-undo .
     6747   define variable v-total-road-tax-base     as decimal no-undo .
     6748   define variable v-total-road-tax-rubl     as decimal no-undo .
     6749   define variable v-all-total-road-tax-base as decimal no-undo .
     6750   define variable v-all-total-road-tax-rubl as decimal no-undo .
     6751   assign
     6752     p-road-tax-base = 0
     6753     p-road-tax-rubl = 0
     6754     .
     6755     Find first buff-goods no-lock where
     6756                buff-goods.artic     = p-artic and
     6757                buff-goods.prod-type = p-prod-type and
     6758                buff-goods.prod-code = p-prod-code
     6759         no-error .
     6760         if available buff-goods then do:
     6761            v-rec = recid (buff-goods).
     6762            t-ret =  session:SET-WAIT-STATE("GENERAL") .
     6763   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     6764     (
     6765        input p-artic
     6766     ,  input p-prod-type
     6767     ,  input p-prod-code
     6768     , output is-petrolium
     6769     , output is-pieces
     6770     ) .
     6771              t-ret =  session:SET-WAIT-STATE("") .
     6772              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     6773                 assign
     6774                   p-road-tax-base = 0
     6775                   p-road-tax-rubl = 0
     6776                   .
     6777                  return.
     6778              end.
     6779         end.
     6780         assign
     6781             v-total-avrg-qnty = 0
     6782             v-total-road-tax-base =  0
     6783             v-total-road-tax-rubl =  0
     6784             v-all-total-road-tax-base =  0
     6785             v-all-total-road-tax-rubl =  0
     6786             .
     6787       for each  x_obj-group ,
     6788           each buf_parts no-lock
     6789           where buf_parts.obj-type  = x_obj-group.obj-type
     6790             and buf_parts.obj-code  = x_obj-group.obj-code
     6791             and buf_parts.artic     = p-artic
     6792             and buf_parts.prod-type = p-prod-type
     6793             and buf_parts.prod-code = p-prod-code
     6794             and buf_parts.status_   = no
     6795             and buf_parts.out-code  = 'free-zone':U
     6796             and buf_parts.qnty      > 0
     6797         on error undo, return error
     6798         :
     6799            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     6800   assign
     6801     price-rubl-with-tax-loc = buf_parts.price-rubl
     6802     price-base-with-tax-loc = buf_parts.price-base
     6803   .
     6804   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$".
