      612   def
      613   new shared
      614   temp-table  obj-list no-undo
      615     field obj-type like ub.clients.obj-type
      616     field obj-code like ub.clients.obj-code
      617     field obj-name like ub.clients.obj-name
      618     field obj-id   as integer
      619     field db-num   as integer
