     1338   define output parameter p-plt-db-num as integer   no-undo .
     1339   define output parameter p-plt-id     as integer   no-undo .
     1340   define buffer buf_price-list-type for ub.price-list-type  .
     1341   define variable v-host-code  as integer   no-undo .
