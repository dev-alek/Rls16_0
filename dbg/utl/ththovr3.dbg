     8221                   vat-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b_doc-line.fact-qnty   else 0
     8222           slt-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     8223           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     8224           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     8225         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     8226         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     8227         if transport-base-loc = ? then transport-base-loc = 0.
     8228         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     8229         if other-base-loc     = ? then other-base-loc     = 0.
     8230         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     8231         assign
     8232           transport-cli-loc      = 0
     8233           other-cli-loc          = 0
     8234           road-tax-cli-loc       = ?
     8235           vat-cli-loc            = ?
     8236           slt-cli-loc            = ?
     8237           price-cli-with-tax-loc = ?.
     8238      end.
     8239   ASSIGN
     8240             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     8241       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     8242   .
     8243                if var-pr-r-b = "rubl" then
     8244                    s-cost = price-rubl-with-tax-loc.
     8245                  else
     8246                    s-cost = price-base-with-tax-loc.
     8247                s-qnty = b_doc-line.fact-qnty .
     8248              end.
     8249              else do:
     8250                assign
     8251                 s-cost = 0
     8252                 s-qnty = 0
     8253                .
     8254              end.
     8255              l_price  =  (f-cost * f-qnty + s-cost * s-qnty ) / (f-qnty + s-qnty)  .
     8256           end.
     8257           when "cost-vat":u then do:
     8258                run str/gdsnovat.p ('Уч+накл-НДС':U,
     8259                        b_trn-doc.obj-type,
     8260                        b_trn-doc.obj-code,
     8261                        b_trn-doc.host-code,
     8262                        b_doc-line.artic,
     8263                        b_doc-line.prod-type,
     8264                        b_doc-line.prod-code,
     8265                        0 ,
     8266                        b_doc-line.doc-code,
     8267                        ?,
     8268                        ?,
     8269                        output cost-base   ,
     8270                        output cost-rubl   ,
     8271                        output v-price-base  ,
     8272                        output v-price-rubl  ,
     8273                        output cur-rt-base ,
     8274                        output cur-rt-rubl ).
     8275                        if var-pr-r-b = "rubl"
     8276                           then l_price = v-price-rubl.
     8277                           else l_price = v-price-base.
     8278           end.
     8279           when "sale":u then do:
     8280                 l_price = ( if var-pr-r-b = "rubl"
     8281                                then b_doc-line.price-rubl
     8282                                else b_doc-line.price-base ).
     8283           end.
     8284           when "prod":u then do:
     8285   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8287   (  input  b_price-doc-forming-gds.b-code
     8288    , input  p-obj-type
     8289    , input  p-obj-code
     8290    , output l_pricewithoutvat
     8291    , output l_price
     8292    , output l_prod-vat
     8293    , output v-str2
     8294    , output v-str2
     8295           )  .
     8296       end.
     8297      when "prod-vat":u then do:
     8298   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8299   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8300   (  input  b_price-doc-forming-gds.b-code
     8301    , input  p-obj-type
     8302    , input  p-obj-code
     8303    , output l_price
     8304    , output l_pricewithvat
     8305    , output l_prod-vat
     8306    , output v-str2
     8307    , output v-str2
     8308           )  .
     8309       end.
     8310         end case.
     8311           tt-price-sale = b_price-doc-forming-gds.price-sale-rubl .
     8312           t-prc = (( tt-price-sale /  v-koff ) / l_price - 1) * 100.
     8313      end.
     8314   end.
     8315     if  p-prc-max <> ? then do:
     8316       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
     8317       then do:
     8318         message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     8319             else "По признаку"  )
     8320             b_price-doc-forming-gds.artic
     8321             b_price-doc-forming-gds.prod-type
     8322             b_price-doc-forming-gds.prod-code skip
     8323             "бар-код: " b_price-doc-forming-gds.b-code
     8324              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     8325                else "" ) skip
     8326             fnc-pr  (buffer b_price-doc-forming-gds)
     8327             skip
     8328           "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     8329           "Процент не менее :" p-prc-min "%" skip
     8330           "Процент не более :" p-prc-max "%" skip
     8331           "Процент фактический :" t-prc  "%"  skip
     8332           "ДНЦ №: " b_price-doc-forming-gds.pdf-id         skip
     8333           "БД" b_price-doc-forming-gds.pdf-db
     8334             view-as alert-box error .
     8335                 p-err = true .
     8336                 undo , return error .
     8337       end.
     8338       else do:
     8339          if  t-prc = ? then  do:
     8340             message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     8341             else "По признаку"  )
     8342             b_price-doc-forming-gds.artic
     8343             b_price-doc-forming-gds.prod-type
     8344             b_price-doc-forming-gds.prod-code skip
     8345             "бар-код: " b_price-doc-forming-gds.b-code
     8346              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     8347                else "" ) skip
     8348             fnc-pr  (buffer b_price-doc-forming-gds)
     8349             skip
     8350             "Нет базовой цены для расчета процента наценки !" skip
     8351             "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     8352             "Процент не менее :" p-prc-min "%" skip
     8353             "Процент не более :" p-prc-max "%" skip
     8354             "Процент фактический :" t-prc  "%"  skip
     8355             "ДНЦ №_: " b_price-doc-forming-gds.pdf-id         skip
     8356             "БД" b_price-doc-forming-gds.pdf-db
     8357             view-as alert-box error .
     8358             p-err = true .
     8359             undo , return error .
     8360          end.
     8361       end.
     8362     end.
     8363   end.
     8364     end.
     8365   end procedure.
     8366   procedure del-doc-line :
     8367   define input  parameter p-recid as recid no-undo .
     8368     do
     8369     on error undo, return error return-value
     8370     :
     8371     find first ub.price-doc-forming-gds exclusive-lock where
     8372          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     8373      if available ub.price-doc-forming-gds then do:
     8374         delete ub.price-doc-forming-gds no-error .
     8375      end.
     8376     end.
     8377   end procedure.
     8378   def var vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8379   procedure check-use-bar-code :
     8380     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     8381     do
     8382     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info83, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8383     on stop   undo, return error substitute( "&1. stop", vss-include-info83 )
     8384     on endkey undo, return error substitute( "&1. endkey", vss-include-info83 )
     8385     :
     8386       define buffer buf_bar-code for ub.bar-code .
     8387       find first buf_bar-code no-lock
     8388         where buf_bar-code.b-code     = p-b-code
     8389         no-error .
     8390       if not available buf_bar-code then do:
     8391         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info83, p-b-code ) .
     8392       end.
     8393       if buf_bar-code.stts = integer('99':U) then do:
     8394         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     8395                                 + "Выполняется удаление бар-кода"
     8396                                 ,vss-include-info83
     8397                                 ,p-b-code
     8398                                 ,chr(10)
     8399                               ) .
     8400       end.
     8401       if buf_bar-code.stts = integer('79':U) then do:
     8402         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     8403                                 + "Бар-код выключен"
     8404                                 ,vss-include-info83
     8405                                 ,p-b-code
     8406                                 ,chr(10)
     8407                               ) .
     8408       end.
     8409       return .
     8410     end.
     8411   end procedure.
     8412   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8413   procedure last-incom-S :
     8414   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
     8415   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
     8416   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
     8417   define output parameter p-in-code   as character no-undo .
     8418   define output parameter p-obj-type  as character no-undo .
     8419   define output parameter p-obj-code  as integer   no-undo .
     8420     do
     8421     on error undo, return error return-value
     8422     :
     8423     define buffer buf_trn-doc for ub.trn-doc .
     8424     define buffer buf_gds-obj for ub.gds-obj  .
     8425     do
     8426     on error undo, return error
     8427     :
     8428       assign
     8429         p-in-code  = ""
     8430         p-obj-type = ""
     8431         p-obj-code = 0
     8432       .
     8433        for each x_obj-group ,
     8434         each buf_gds-obj no-lock
     8435         where buf_gds-obj.obj-type  = x_obj-group.obj-type
     8436           and buf_gds-obj.obj-code  = x_obj-group.obj-code
     8437           and buf_gds-obj.artic     = p-artic
     8438           and buf_gds-obj.prod-type = p-prod-type
     8439           and buf_gds-obj.prod-code = p-prod-code
     8440       , first buf_trn-doc no-lock
     8441         where buf_trn-doc.doc-code = buf_gds-obj.in-code
     8442           and buf_trn-doc.status_  = 'факт':U
     8443       on error undo, return error
     8444       by buf_trn-doc.fact-order descending
     8445       :
     8446         assign
     8447           p-in-code  = buf_gds-obj.in-code
     8448           p-obj-type = buf_gds-obj.obj-type
     8449           p-obj-code = buf_gds-obj.obj-code
     8450         .
     8451         leave .
     8452       end.
     8453     end.
     8454     end.
     8455   end procedure.
     8456   procedure main-road-tax :
     8457   def input param p-obj-type  like ub.gds-obj.obj-type  no-undo .
     8458   def input param p-obj-code  like ub.gds-obj.obj-code  no-undo .
     8459   def input param p-artic     like ub.gds-obj.artic     no-undo .
     8460   def input param p-prod-type like ub.gds-obj.prod-type no-undo .
     8461   def input param p-prod-code like ub.gds-obj.prod-code no-undo .
     8462   def input-output param p-road-tax-base as decimal no-undo .
     8463   def input-output param p-road-tax-rubl as decimal no-undo .
     8464   define buffer     buff-goods    for ub.goods   .
     8465   define buffer     buf_gds-obj   for ub.gds-obj .
     8466   define buffer     buf_parts     for ub.parts   .
     8467       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     8468       define buffer   in-vatp-parts    for ub.parts   .
     8469       define buffer   in-vatp-doc      for ub.trn-doc .
     8470       define buffer   in-vatp-goods    for ub.goods   .
     8471       define buffer   in-vatp-sysconf  for ub.sysconf .
     8472       define buffer   in-vatp_doc-attr for ub.doc-attr.
     8473       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     8474       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     8475       define variable varinvprb                  as   character              no-undo.
     8476       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     8477       define variable cli-base-rate              as   decimal                no-undo.
     8478       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     8479       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     8480       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     8481       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     8482       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     8483       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     8484       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     8485       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     8486       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     8487       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     8488       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     8489       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     8490       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     8491       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     8492       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     8493       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     8494       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     8495       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     8496       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     8497       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     8498       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     8499       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     8500       define variable varinvatp-envd             as   character              no-undo.
     8501       define variable varinvatp-type             as   character              no-undo.
     8502   define buffer buf_trn-doc for ub.trn-doc  .
     8503   define buffer buf_doc-line for ub.doc-line .
     8504   define variable   is-petrolium  as logical             no-undo.
     8505   define variable   is-pieces     as logical             no-undo.
     8506   define variable v-last-in-code  like ub.gds-obj.in-code  no-undo .
     8507   define variable v-last-obj-type like ub.gds-obj.obj-type no-undo .
     8508   define variable v-last-obj-code like ub.gds-obj.obj-code no-undo .
     8509   def var v-rec as recid no-undo.
     8510   def var t-ret as logical no-undo .
     8511   def var v-total-avrg-base as decimal no-undo .
     8512   def var v-total-avrg-rubl as decimal no-undo .
     8513   def var v-total-avrg-qnty as decimal no-undo .
     8514   def var v-total-road-tax-base     as decimal no-undo .
     8515   def var v-total-road-tax-rubl     as decimal no-undo .
     8516   def var v-all-total-road-tax-base as decimal no-undo .
     8517   def var v-all-total-road-tax-rubl as decimal no-undo .
     8518   assign
     8519     p-road-tax-base = ?
     8520     p-road-tax-rubl = ?
     8521     .
     8522     Find first buff-goods no-lock where
     8523           buff-goods.artic     = p-artic and
     8524           buff-goods.prod-type = p-prod-type and
     8525           buff-goods.prod-code = p-prod-code
     8526           no-error .
     8527         if available buff-goods then do:
     8528              v-rec = recid (buff-goods).
     8529              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     8530   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     8531     (
     8532        input p-artic
     8533     ,  input p-prod-type
     8534     ,  input p-prod-code
     8535     , output is-petrolium
     8536     , output is-pieces
     8537     ) .
     8538              t-ret =  session:SET-WAIT-STATE("") .
     8539              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     8540                 assign
     8541                   p-road-tax-base = ?
     8542                   p-road-tax-rubl = ?
     8543                   .
     8544                 return.
     8545              end.
     8546         end.
     8547         assign
     8548             v-total-avrg-qnty = 0
     8549             v-total-road-tax-base =  0
     8550             v-total-road-tax-rubl =  0
     8551             v-all-total-road-tax-base =  0
     8552             v-all-total-road-tax-rubl =  0
     8553             .
     8554         for each x_obj-group,
     8555            each buf_parts no-lock
     8556           where buf_parts.obj-type  = x_obj-group.obj-type
     8557             and buf_parts.obj-code  = x_obj-group.obj-code
