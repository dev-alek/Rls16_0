     6491              ub.price-doc-forming.plt-db-num = p-plt-db-num and
     6492              ub.price-doc-forming.plt-id     = p-plt-id     and
     6493              ub.price-doc-forming.pdf-db     = p-pdf-db     and
     6494              ub.price-doc-forming.pdf-id     = p-pdf-id
     6495               no-error .
     6496   if error-status :error then message
     6497     vss-workfile vss-revision vss-description skip
     6498     error-status :get-message(1) skip
     6499     return-value skip
     6500     "Ошибка!"
     6501     view-as alert-box error
     6502   .
