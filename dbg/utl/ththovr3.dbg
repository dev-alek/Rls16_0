     9708                   ub.price-list-type-cash-pay.curr-code     = tt_cash-pay.curr-code
     9709                   ub.price-list-type-cash-pay.plt-db-num   = p-db-num
     9710                   ub.price-list-type-cash-pay.plt-id       = p-id
     9711                   ub.price-list-type-cash-pay.stts         = integer('0':U)
     9712                   ub.price-list-type-cash-pay.sys-date     = today
     9713                   ub.price-list-type-cash-pay.sys-time     = time
     9714                   ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
     9715                   ub.price-list-type-cash-pay.who          = p-userid
     9716                   ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
     9717                   ub.price-list-type-cash-pay.db-num       = p-db-num-usr
     9718                 .
