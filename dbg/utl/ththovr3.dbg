     9337   DEFINE TEMP-TABLE TT_cassa NO-UNDO LIKE ub.price-list-type-cassa.
     9338   DEFINE TEMP-TABLE TT_grp   NO-UNDO LIKE ub.price-list-type-gds-grp.
     9339   DEFINE TEMP-TABLE TT_pay-type NO-UNDO LIKE ub.price-list-type-pay-type.
     9340   DEFINE TEMP-TABLE TT_cash-pay NO-UNDO LIKE ub.price-list-type-cash-pay.
     9341   PROCEDURE type-price-list-ADD :
     9342   define input  parameter p-db-num                       as integer   no-undo .
     9343   define input  parameter p-id                           as integer   no-undo .
     9344   define input  parameter p-name                         as character no-undo .
     9345   define input  parameter p-ban-discnt                   like   ub.price-list-type.ban-discnt          no-undo .
     9346   define input  parameter p-calc-round-method            like   ub.price-list-type.calc-round-method    no-undo .
     9347   define input  parameter p-calc-round-base              like   ub.price-list-type.calc-round-base      no-undo .
     9348   define input  parameter p-calc-increase-pc             like   ub.price-list-type.calc-increase-pc     no-undo .
     9349   define input  parameter p-calc-method                  like   ub.price-list-type.calc-method          no-undo .
     9350   define input  parameter p-create-price-doc             like   ub.price-list-type.create-price-doc     no-undo .
     9351   define input  parameter p-fix-cource-crc-base          like   ub.price-list-type.fix-cource-crc-base  no-undo .
     9352   define input  parameter p-fix-cource-crc-doc           like   ub.price-list-type.fix-cource-crc-doc   no-undo .
     9353   define input  parameter p-have-rs-qnty-group           like   ub.price-list-type.have-rs-qnty-group   no-undo .
     9354   define input  parameter p-have-rs-sum-group            like   ub.price-list-type.have-rs-sum-group    no-undo .
     9355   define input  parameter p-main                         like   ub.price-list-type.main                 no-undo .
     9356   define input  parameter p-only-gbd                     like   ub.price-list-type.only-gbd             no-undo .
     9357   define input  parameter p-plt-main-db-num              like   ub.price-list-type.plt-main-db-num      no-undo .
     9358   define input  parameter p-plt-main-id                  like   ub.price-list-type.plt-main-id          no-undo .
     9359   define input  parameter p-priority                     like   ub.price-list-type.priority             no-undo .
     9360   define input  parameter p-rs-buyer                     like   ub.price-list-type.rs-buyer             no-undo .
     9361   define input  parameter p-send-cassa                   like   ub.price-list-type.send-cassa           no-undo .
     9362   define input  parameter p-under-hand-corr              like   ub.price-list-type.under-hand-corr      no-undo .
     9363   define input  parameter p-under-round-method           like   ub.price-list-type.under-round-method         no-undo .
     9364   define input  parameter p-under-perc                   like   ub.price-list-type.under-perc           no-undo .
     9365   define input  parameter p-under-type-list              like   ub.price-list-type.under-type-list      no-undo .
     9366   define input  parameter p-use-cassa                    like   ub.price-list-type.use-cassa            no-undo .
     9367   define input  parameter p-use-gds-group                like   ub.price-list-type.use-gds-group        no-undo .
     9368   define input  parameter p-use-obj                      like   ub.price-list-type.use-obj              no-undo .
     9369   define input  parameter p-work-date                    like   ub.price-list-type.work-date            no-undo .
     9370   define input  parameter p-bgr-db-num                   like   ub.price-list-type.bgr-db-num           no-undo .
     9371   define input  parameter p-bgr-id                       like   ub.price-list-type.bgr-id               no-undo .
     9372   define input  parameter p-curr-code                    like   ub.price-list-type.curr-code            no-undo .
     9373   define input  parameter p-gop-db-num                   like   ub.price-list-type.gop-db-num           no-undo .
     9374   define input  parameter p-gop-db-num-for-calc-turnover like   ub.price-list-type.gop-db-num-for-calc-turnover  no-undo .
     9375   define input  parameter p-gop-id                       like   ub.price-list-type.gop-id                        no-undo .
     9376   define input  parameter p-gop-id-for-calc-turnover     like   ub.price-list-type.gop-id-for-calc-turnover      no-undo .
     9377   define input  parameter p-qgr-db-num                   like   ub.price-list-type.qgr-db-num                    no-undo .
     9378   define input  parameter p-qgr-id                       like   ub.price-list-type.qgr-id                        no-undo .
     9379   define input  parameter p-sgr-db-num                   like   ub.price-list-type.sgr-db-num                    no-undo .
     9380   define input  parameter p-sgr-id                       like   ub.price-list-type.sgr-id                        no-undo .
     9381   define input  parameter p-tog-db-num                   like   ub.price-list-type.tog-db-num                    no-undo .
     9382   define input  parameter p-tog-id                       like   ub.price-list-type.tog-id                        no-undo .
     9383   define input  parameter p-obj-turnover                 like   ub.price-list-type.obj-turnover                  no-undo .
     9384   define input  parameter p-ttg-summa                    like   ub.price-list-type.ttg-summa                     no-undo .
     9385   define input  parameter p-userid                       as character no-undo .
     9386   define input  parameter p-db-num-usr                   as integer   no-undo .
     9387   define input  parameter p-have-rs-turn-group           like   ub.price-list-type.have-rs-turn-group no-undo .
     9388   define input  parameter p-have-tog-db-num              like   ub.price-list-type.have-tog-db-num    no-undo .
     9389   define input  parameter p-have-tog-id                  like   ub.price-list-type.have-tog-id        no-undo .
     9390   define input  parameter p-use-cash-pay                 like   ub.price-list-type.use-cash-pay no-undo .
     9391   define input  parameter p-use-pay-type                 like   ub.price-list-type.use-pay-type no-undo .
     9392   define output parameter p-recid                        as recid no-undo .
     9393   define input  parameter table for tt_cassa .
     9394   define input  parameter table for tt_grp   .
     9395   define input  parameter table for tt_pay-type .
     9396   define input  parameter table for tt_cash-pay .
     9397   define variable v-text as character no-undo .
     9398   define buffer buf_price-list-type for ub.price-list-type  .
     9399     do
     9400     on error undo, return error return-value
     9401     :
     9402   if p-plt-main-id                     = ? then p-plt-main-id = 0 .
     9403   if p-bgr-id                          = ? then p-bgr-id                        = 0 .
     9404   if p-gop-id                          = ? then p-gop-id                        = 0 .
     9405   if p-gop-id-for-calc-turnover        = ? then p-gop-id-for-calc-turnover      = 0 .
     9406   if p-qgr-db-num                      = ? then p-qgr-db-num                    = 0 .
     9407   if p-qgr-id                          = ? then p-qgr-id                        = 0 .
     9408   if p-sgr-db-num                      = ? then p-sgr-db-num                    = 0 .
     9409   if p-sgr-id                          = ? then p-sgr-id                        = 0 .
     9410   if p-tog-db-num                      = ? then p-tog-db-num                    = 0 .
     9411   if p-tog-id                          = ? then p-tog-id                        = 0 .
     9412   if p-gop-db-num                      = ? then p-gop-db-num                    = 0 .
     9413   if p-gop-db-num-for-calc-turnover    = ? then p-gop-db-num-for-calc-turnover  = 0 .
     9414   if p-have-tog-db-num                 = ? then p-have-tog-db-num  = 0 .
     9415   if p-have-tog-id                     = ? then p-have-tog-id      = 0 .
     9416   if p-gop-id = 0  then  p-use-obj = 1 .
     9417   if p-gop-id-for-calc-turnover  = 0  then  p-obj-turnover = false  .
     9418   if p-tog-id = 0   then  p-obj-turnover = false  .
     9419   if p-tog-id = 0 and  p-bgr-id = 0   then  p-rs-buyer = 0.
     9420   if p-name = ? or p-name = ""  then do:
     9421     return error "Название типа прайс-листа не должно быть пустым!" .
     9422   end.
     9423   if logical(p-have-rs-qnty-group) = true and  ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
     9424     return error "Не задана количественная группа!" .
     9425   end.
     9426   if p-have-rs-sum-group = true and  ( p-sgr-id = 0 or p-sgr-id = ? ) then do:
     9427     return error "Не задана суммовая группа!" .
     9428   end.
     9429   if logical(p-under-type-list) = true and  ( p-plt-main-id = 0 or p-plt-main-id = ? ) then do:
     9430     return error "Не задан родительский прайс-лист !" .
     9431   end.
     9432   define buffer parent_price-list-type for ub.price-list-type  .
     9433   if  logical(p-under-type-list) = true and p-main = true  then do:
     9434       find first parent_price-list-type  no-lock where
     9435                  parent_price-list-type.plt-id = p-plt-main-id  and
     9436                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
     9437       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
     9438       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
     9439       if parent_price-list-type.main = false  then  return error "Родительский прайс-лист должен быть ГЛАВНЫМ !" .
     9440       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
     9441   end.
     9442   if  logical(p-under-type-list) = true and p-main = false   then do:
     9443       find first parent_price-list-type  no-lock where
     9444                  parent_price-list-type.plt-id = p-plt-main-id  and
     9445                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
     9446       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
     9447       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
     9448       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
     9449   end.
     9450   if logical(p-have-rs-qnty-group) = false  and not ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
     9451      p-qgr-id = 0.
     9452      p-qgr-db-num = 0.
     9453   end.
     9454   if p-have-rs-sum-group = false  and  not( p-sgr-id = 0 or p-sgr-id = ? ) then do:
     9455     p-sgr-id = 0.
     9456     p-sgr-db-num = 0.
     9457   end.
     9458   if logical(p-have-rs-turn-group) = false  and not ( p-have-tog-id = 0 or p-have-tog-id = ? ) then do:
     9459      p-have-tog-id = 0.
     9460      p-have-tog-db-num = 0.
     9461   end.
     9462   if p-priority  = 0  and p-main = false  and p-under-type-list = 0 then do:
     9463      return error "Не задан ПРИОРИТЕТ типа прайс-листа"   .
     9464   end.
     9465   if p-priority > 0 and p-main = false and p-under-type-list = 0 then do:
     9466       if can-find (
     9467             first buf_price-list-type no-lock where
     9468                   buf_price-list-type.under-type-list = 0          and
     9469                   buf_price-list-type.priority        = p-priority and
     9470                   buf_price-list-type.main            = false      and
     9471                   buf_price-list-type.stts            = integer('0':U)          and
     9472               not
     9473                 ( buf_price-list-type.plt-db-num = p-db-num and
     9474                   buf_price-list-type.plt-id     = p-id )
     9475                 ) then
     9476       return error "Уже есть тип прайс-листа с приоритетом " + string ( p-priority ) .
     9477   end.
     9478   find first ub.price-list-type exclusive-lock where
     9479              ub.price-list-type.plt-db-num   = p-db-num and
     9480              ub.price-list-type.plt-id       = p-id
     9481              no-error .
     9482       if not available ub.price-list-type then do:
     9483         if p-main = true and p-only-gbd = 1 then do:
     9484           if can-find ( first buf_price-list-type no-lock where
     9485                             buf_price-list-type.main = true and
     9486                             buf_price-list-type.only-gbd = 1 and
     9487                             buf_price-list-type.stts = integer('0':U) and
     9488                             buf_price-list-type.gop-id = p-gop-id and
     9489                             buf_price-list-type.gop-db-num = p-gop-db-num ) then  do:
     9490               if p-gop-id = 0 or p-gop-id = ? then do:
     9491                 v-text  = "для всех объектов" .
     9492                 end.
     9493                 else do:
     9494                 v-text  = "для объектов из группы №"  + string(p-gop-id) + " БД:" + string(p-gop-db-num).
     9495                 end.
     9496               release ub.price-list-type no-error .
     9497               return error "Уже существует ГЛАВНЫЙ ПРАЙС-ЛИСТ для автопереоценок " + v-text .
     9498               end.
     9499         end.
     9500         create ub.price-list-type .
     9501         assign
     9502             ub.price-list-type.plt-db-num   = p-db-num
     9503             ub.price-list-type.plt-id       = p-id
     9504         .
     9505       end.
     9506          assign
     9507             ub.price-list-type.plt-db-num                     = p-db-num
     9508             ub.price-list-type.plt-id                         = p-id
     9509             ub.price-list-type.name                           = p-name
     9510             ub.price-list-type.ban-discnt                     = p-ban-discnt
     9511             ub.price-list-type.calc-round-method              = p-calc-round-method
     9512             ub.price-list-type.calc-round-base                = p-calc-round-base
     9513             ub.price-list-type.calc-increase-pc               = p-calc-increase-pc
