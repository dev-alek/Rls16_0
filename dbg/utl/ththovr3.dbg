     4427     if error-status :error then message
     4428       vss-workfile vss-revision vss-description skip
     4429       error-status :get-message(1) skip
     4430       return-value skip
     4431       ""
     4432       view-as alert-box error
     4433     .
     4434     case p-calc-method:
     4435       when 'Единая':U or
     4436       when 'Отсутствует':U or
     4437       when 'Не-считать':U or
     4438       when 'Откат_цен':U
     4439       then do:
     4440          p-increase-pc  = 0  .
     4441          p-round-method = 'Отключено':U .
     4442       end.
     4443       when 'Товар':U then do:
     4444         case buf-goods.calc-method:
     4445           when 'Группа':U then do:
     4446             find buf-gds-grp no-lock where
     4447                  buf-gds-grp.node-code = buf-goods.grp-code.
     4448              p-increase-pc  = loc-grp-increase-pc .
     4449              p-round-method = loc-grp-round-method .
     4450              p-round-base   = loc-grp-round-base .
     4451              g-g = true  .
     4452           end.
     4453           otherwise do:
     4454              p-increase-pc  =  loc-increase-pc .
     4455           end.
     4456         end case.
     4457         if g-g = false then do:
     4458             run gdsoattr-value
     4459                ( input 'round-method':U ,
     4460                  input p-gds-code ,
     4461                  input x_obj-group.obj-type ,
     4462                  input x_obj-group.obj-code ,
     4463                  output loc-rez ,
     4464                  output t-type
     4465                  ) no-error  .
     4466                 if error-status :error then message
     4467                   vss-workfile vss-revision vss-description skip
     4468                   error-status :get-message(1) skip
     4469                   "gdsoattr-value"
     4470                   view-as alert-box error .
     4471             case NUM-ENTRIES (loc-rez," ") :
     4472                 when 0 then do:
     4473                 end.
     4474                 when 1 then do:
     4475                   p-round-method = loc-rez .
     4476                   p-round-base   = 0 .
     4477                 end.
     4478                 when 2 then do:
     4479                   p-round-method = entry(1 , loc-rez, " " ).
     4480                   p-round-base   = decimal(entry(2 , loc-rez, " " )) .
     4481                 end.
     4482                 otherwise do:
     4483                   p-round-method = entry(1 , loc-rez, " " ).
     4484                   p-round-base   = decimal(entry(NUM-ENTRIES (loc-rez," ") , loc-rez, " " )) .
     4485                 end.
     4486             end case.
     4487         end.
     4488       end.
     4489     end case.
