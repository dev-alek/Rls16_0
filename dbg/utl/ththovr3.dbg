     9723             ub.price-list-type-cash-pay.sys-date     = today
     9724             ub.price-list-type-cash-pay.sys-time     = time
     9725             ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
