     4997           error-status :get-message(1) skip
     4998           return-value skip
     4999           "proprice.i"
     5000           view-as alert-box error
     5001         .
     5002         if vd = 0 or vd = ?  then do:
     5003           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5004                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5005                   "- расчет по производителю от последней приходной накладной невозможен."
     5006                   view-as alert-box question buttons OK-Cancel title "#3" update g#log as logical .
     5007         end.
     5008         else do:
     5009             cost-rubl = vd .
     5010             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5011             p-new-calc-method = p-calc-method .
     5012         end.
     5013       end.
     5014       when 'Произв-НДС':U
     5015       then do:
     5016         find first x_obj-group.
     5017   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     5019   (  input  p-b-code
     5020    , input  x_obj-group.obj-type
     5021    , input  x_obj-group.obj-code
     5022    , output vd
     5023    , output v-PriceWithVat
     5024    , output v-prod-vat
     5025    , output v-str1
     5026    , output v-str1
     5027           ) no-error .
     5028         if error-status :error then
     5029         message
     5030           vss-workfile vss-revision vss-description skip
     5031           error-status :get-message(1) skip
     5032           return-value skip
     5033           "proprice.i"
     5034           view-as alert-box error
     5035         .
     5036         if vd = 0 or vd = ?  then do:
     5037           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5038                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5039                   "- расчет по производителю от последней приходной накладной невозможен."
     5040                   view-as alert-box  .
     5041         end.
     5042         else do:
     5043             cost-rubl = vd .
     5044             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5045             p-new-calc-method = p-calc-method .
     5046         end.
     5047       end.
     5048      when 'Спецификация':U
     5049      then do:
     5050         find first x_obj-group.
     5051         assign
     5052           v-num-specif    = 0
     5053           v-contract-code = 0
     5054         .
     5055         for each buf_contract no-lock
     5056         where buf_contract.host-code = v-cntxt-host-code-obj
     5057         :
     5058   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5059   ASSIGN
     5060      i-gl-Host-Code      = 0
     5061      i-gl-Contract-Code  = 0
     5062      i-gl-Extent3        = 0
     5063      .
     5064   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5065       INPUT  v-cntxt-host-code-obj,
     5066       INPUT  buf_contract.contract-code,
     5067       OUTPUT i-gl-Extent3
     5068      ).
     5069   IF i-gl-Extent3[1] = 2 THEN DO:
     5070      ASSIGN
     5071         i-gl-Host-Code      = i-gl-Extent3[2]
     5072         i-gl-Contract-Code  = i-gl-Extent3[3]
     5073         .
     5074   END. ELSE DO:
     5075      ASSIGN
     5076         i-gl-Host-Code      = v-cntxt-host-code-obj
     5077         i-gl-Contract-Code  = buf_contract.contract-code
     5078         .
     5079   END.
     5080   FOR EACH
     5081       buf_contract-specif
     5082        NO-LOCK
     5083        WHERE
     5084            buf_contract-specif.Host-code    = i-gl-Host-Code
     5085        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5086              :
     5087               if buf_contract-specif.gds-code = p-gds-code then do:
     5088                 assign
     5089                   v-num-specif = v-num-specif + 1
     5090                   v-contract-code = buf_contract.contract-code
     5091                 .
     5092               end.
     5093           end.
     5094         end.
     5095         if v-num-specif > 1 then do:
     5096            run str/gds-cnts.w
     5097               (input parparentproc
     5098               ,input p-gds-code
     5099               , "b-sel":U
     5100               ,output v-spis
     5101             ) no-error.
     5102           find first buf_contract-specif no-lock
     5103           where recid(buf_contract-specif) = integer(v-spis)
     5104             no-error.
     5105             if available buf_contract-specif then do:
     5106                 run read-bonus (
     5107                     input  buf_contract-specif.contract-num  ,
     5108                     input  buf_contract-specif.host-code     ,
     5109                     input  buf_contract-specif.gds-code      ,
     5110                     output v-bonus  ) .
     5111                 assign
     5112                   cost-rubl = buf_contract-specif.price-cli
     5113                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5114                   p-new-calc-method = 'Спецификация':U
     5115                 .
     5116                 if v-bonus <> ? and v-bonus <> 0 then do:
     5117                    assign
     5118                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5119                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5120                    .
     5121                 end.
     5122             end.
     5123             else do:
     5124               message "Не найдена спецификация с recid " v-spis skip
     5125                       "для товара с артикулом " p-artic skip
     5126                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5127                       view-as alert-box information .
     5128             end.
     5129         end.
     5130         if v-num-specif = 0 then do:
     5131             message "Не найдена ни одна спецификация" skip
     5132                     "для товара с артикулом " p-artic skip
     5133                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5134                     view-as alert-box information .
     5135         end.
     5136         if v-num-specif = 1 then do:
     5137   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5138   ASSIGN
     5139      i-gl-Host-Code      = 0
     5140      i-gl-Contract-Code  = 0
     5141      i-gl-Extent3        = 0
     5142      .
     5143   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5144       INPUT  v-cntxt-host-code-obj,
     5145       INPUT  v-contract-code,
     5146       OUTPUT i-gl-Extent3
     5147      ).
     5148   IF i-gl-Extent3[1] = 2 THEN DO:
     5149      ASSIGN
     5150         i-gl-Host-Code      = i-gl-Extent3[2]
     5151         i-gl-Contract-Code  = i-gl-Extent3[3]
     5152         .
     5153   END. ELSE DO:
     5154      ASSIGN
     5155         i-gl-Host-Code      = v-cntxt-host-code-obj
     5156         i-gl-Contract-Code  = v-contract-code
     5157         .
     5158   END.
     5159   FOR EACH
     5160       buf_contract-specif
     5161        NO-LOCK
     5162        WHERE
     5163            buf_contract-specif.Host-code    = i-gl-Host-Code
     5164        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5165               :
     5166               if buf_contract-specif.gds-code = p-gds-code then do:
     5167                 run read-bonus (
     5168                     input  buf_contract-specif.contract-num  ,
     5169                     input  buf_contract-specif.host-code     ,
     5170                     input  buf_contract-specif.gds-code      ,
     5171                     output v-bonus  ) .
     5172                 assign
     5173                   cost-rubl = buf_contract-specif.price-cli
     5174                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5175                   p-new-calc-method = 'Спецификация':U
     5176                 .
     5177                 if v-bonus <> ? and v-bonus <> 0 then do:
     5178                    assign
     5179                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5180                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5181                    .
     5182                 end.
     5183               end.
     5184             end.
     5185         end.
     5186      end.
     5187      otherwise do:
     5188        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     5189                  p-new-calc-method  skip
     5190                 "p-price-prev-doc " p-price-prev-doc  skip
     5191                 "mpl-lib ERR !!! " skip
     5192                 'артикул ' p-artic skip
     5193                 view-as alert-box information .
     5194      end.
     5195    end case.
     5196   run main-road-taxs in this-procedure
     5197     ( input p-artic     ,
     5198       input p-prod-type ,
     5199       input p-prod-code ,
     5200       input-output cur-rt-base ,
     5201       input-output cur-rt-rubl )
     5202       .
     5203     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     5204       return error "Не определен курс валюты документа" .
     5205     end.
     5206     if p-base-scale = 0  or  p-base-scale = ?  then do:
     5207        return error "Не определен курс базовой валюты " .
     5208     end.
     5209   if v-base = false then var-pr-r-b = "rubl":U .
     5210                     else var-pr-r-b =  "base":U .
     5211       if var-pr-r-b = "rubl":U then do:
     5212            case p-calc-method :
     5213            when 'ПорогПр-НДС':U then do:
     5214               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     5215            end.
     5216            when 'ПорогПр+НДС':U then do:
     5217               p-price-sale-rubl  =  cost-rubl .
     5218            end.
     5219            when  'Производит':U then do:
     5220               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     5221            end.
     5222            when  'Произв-НДС':U then do:
     5223               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     5224            end.
     5225            otherwise do:
     5226               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     5227            end.
     5228           end case.
     5229           assign
     5230             p-price-calc-rubl  =  cost-rubl
     5231             p-road-tax-rubl    =  cur-rt-rubl
     5232             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5233             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5234             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5235           .
     5236       end.
     5237       else do:
     5238            case p-calc-method:
     5239               when 'ПорогПр-НДС':U then do:
     5240                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     5241               end.
     5242               when 'ПорогПр+НДС':U then do:
     5243                   p-price-sale-base  =  cost-base .
     5244               end.
     5245               when 'Производит':U then do:
     5246                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     5247               end.
     5248               when 'Произв-НДС':U then do:
     5249                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     5250               end.
     5251               otherwise do:
     5252                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     5253               end.
     5254            end case.
     5255           assign
     5256             p-price-calc-base  =  cost-base
     5257             p-road-tax-base    =  cur-rt-base
     5258             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     5259             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     5260             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     5261             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5262             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5263             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5264           .
     5265       end.
     5266      if p-price-sale-doc <> 0 then do:
     5267   case p-round-method :
     5268     when '9-окончание':U then do:
     5269       if p-price-sale-doc < 29 then do:
     5270         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     5271           assign
     5272             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     5273           .
     5274         end.
     5275       end.
     5276       else do:
     5277         if (p-price-sale-doc modulo 10) < 3 then do:
     5278           assign
     5279             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5280                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5281                   - 1 ) * 10
     5282                 + 9
     5283           .
     5284         end.
     5285         else do:
     5286           assign
     5287             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5288                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5289                   ) * 10
     5290                 + 9
     5291           .
     5292         end.
     5293         assign
     5294           p-price-sale-doc = round (p-price-sale-doc, 0)
     5295         .
     5296       end.
     5297     end.
     5298     when '9-99окончание':U then do:
     5299       if p-price-sale-doc < p-round-base then do:
     5300         assign
     5301           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     5302         .
     5303       end.
     5304       else do:
     5305         assign
     5306           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     5307         .
     5308       end.
     5309     end.
     5310     when 'Без-дробных':U then do:
     5311       assign
     5312         p-price-sale-doc = round (p-price-sale-doc, 0)
     5313       .
     5314     end.
     5315     when 'Произвольно':U then do:
     5316       if p-round-base <> 0 then do:
     5317         assign
     5318           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     5319         .
     5320         if p-price-sale-doc = 0 then do:
     5321           assign
     5322             p-price-sale-doc = p-round-base
     5323           .
     5324         end.
     5325       end.
     5326     end.
     5327     when 'Вверх':U then do:
     5328       if p-round-base <> 0 then do:
     5329         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     5330           assign
     5331             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     5332           .
     5333         end.
     5334       end.
     5335       if p-price-sale-doc = 0 then do:
     5336         assign
     5337           p-price-sale-doc = p-round-base
     5338         .
     5339       end.
     5340     end.
     5341     when 'Коэффициент':U then do:
     5342       if p-round-base <> 0 then do:
     5343         assign
     5344           p-price-sale-doc = p-price-sale-doc * p-round-base
     5345         .
     5346       end.
     5347     end.
     5348     when 'Отключено':U then do:
     5349     end.
     5350     otherwise do:
     5351       message
     5352         vss-workfile vss-revision vss-description skip
     5353         "Неизвестный метод округления продажной цены" skip
     5354         "round-method" p-round-method skip
     5355         "round-base"   p-round-base   skip
     5356         "price"        p-price-sale-doc             skip
     5357         view-as alert-box error .
     5358     end.
     5359   end.
     5360     end.
     5361     assign
     5362       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     5363       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     5364       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     5365       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     5366      .
     5367     assign
     5368       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     5369       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     5370       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     5371       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     5372     .
     5373     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     5374     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     5375     p-prev-doc-code = if available bufold_price-doc-forming
     5376                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     5377                          else "" .
     5378   END PROCEDURE.
     5379   PROCEDURE create-line :
     5380   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     5381   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     5382   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     5383   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     5384   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     5385   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     5386   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     5387   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
     5388   define input  parameter p-prod-code         like ub.price-doc-forming-gds.prod-code no-undo .
     5389   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     5390   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     5391   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     5392   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     5393   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     5394   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     5395   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     5396   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     5397   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     5398   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     5399   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     5400   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     5401   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     5402   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     5403   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     5404   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     5405   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     5406   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     5407   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     5408   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     5409   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     5410   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     5411   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     5412   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     5413   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     5414   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     5415   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     5416   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     5417   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     5418   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     5419   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     5420   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     5421   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     5422   define input  parameter p-prev-doc-code     as character no-undo .
     5423   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     5424   define input-output parameter  v-sec        as integer   no-undo .
     5425     run check-use-bar-code ( p-b-code ) no-error .
     5426     if error-status :error then do:
     5427       message
     5428         return-value skip
     5429         "Ошибка !"
     5430         view-as alert-box error
     5431       .
     5432       undo, return error return-value.
     5433     end.
     5434   find first ub.price-doc-forming-gds exclusive-lock where
     5435              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     5436              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     5437              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     5438              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     5439              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     5440       if not available ub.price-doc-forming-gds then
     5441       do:
     5442         create ub.price-doc-forming-gds .
     5443          assign
     5444           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     5445           ub.price-doc-forming-gds.plt-id     = p-plt-id
     5446           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     5447           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     5448           ub.price-doc-forming-gds.b-code     = p-b-code
     5449           ub.price-doc-forming-gds.line-num   = p-line-num
     5450          .
     5451       end.
