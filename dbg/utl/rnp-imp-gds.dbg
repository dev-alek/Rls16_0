     1308   define variable i-sert like ub.goods.sert no-undo .
     1309   define variable i-user-rule like ub.goods.user-rule no-undo .
     1310   define variable i-alpha1 like ub.goods.alpha1 no-undo .
     1311   define variable i-grp-code like ub.goods.grp-code no-undo .
     1312   define variable i-service as logical no-undo .
     1313   define variable i-gds-code like ub.goods.gds-code no-undo .
     1314   define variable choice as integer no-undo.
     1315   define variable v-num-fields as integer no-undo .
     1316   define variable p-mark as integer no-undo .
     1317   define variable i-mark as integer  no-undo .
     1318   define variable p-nomcode as integer no-undo .
     1319   define variable i-nomcode as character  no-undo .
     1320   define variable i-ppr as integer no-undo .
     1321   define variable mnewrec as logical no-undo.
     1322   define variable v-host-code     as integer           no-undo.
     1323   define variable v-recid         as recid             no-undo.
     1324   define variable NDS like  tax-rate-value.rate-value  no-undo .
     1325   define variable NP like  tax-rate-value.rate-value  no-undo .
     1326   define variable j-gds-code like goods.gds-code NO-UNDO.
     1327   DEFINE VARIABLE mExcelApplication AS COMPONENT-HANDLE NO-UNDO.
     1328   DEFINE VARIABLE mWorkBook         AS COMPONENT-HANDLE NO-UNDO.
     1329   DEFINE VARIABLE mWorkSheet        AS COMPONENT-HANDLE NO-UNDO.
     1330   DEFINE VARIABLE mMaxNoLine        AS INTEGER          INITIAL 10 NO-UNDO.
     1331   DEFINE VARIABLE vLine   AS INTEGER   NO-UNDO.
     1332   DEFINE VARIABLE vChLine AS CHARACTER NO-UNDO.
     1333   DEFINE VARIABLE vCh     AS CHARACTER NO-UNDO.
     1334   DEFINE VARIABLE v-prod  as character no-undo .
     1335   DEFINE VARIABLE vNoLine AS INTEGER   NO-UNDO.
     1336   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1337   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1338   define variable MarkType as ibs.th.str.marking.Types no-undo.
     1339   MarkType = ObjSrv:Env:Marking:Types.
     1340   define variable MarkTypeStr as character no-undo.
     1341   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1342     (input  'is-custm'
     1343     ,input  ''
     1344     ,input  ''
     1345     ,input  0
     1346     ,input  ''
     1347     ,input  ''
     1348     ,input  ''
     1349     ,input  no
     1350     ,output custvalue
     1351     ,output custtype
     1352     ) no-error .
     1353   function f-range returns character(input p-num as integer) :
     1354       case p-num :
     1355           when 1 then return "A":U .
     1356           when 2 then return "B":U .
     1357           when 3 then return "C":U .
     1358           when 4 then return "D":U .
     1359           when 5 then return "E":U .
     1360           when 6 then return "F":U .
     1361           when 7 then return "G":U .
     1362           when 8 then return "H":U .
     1363           when 9 then return "I":U .
     1364           when 10 then return "J":U .
     1365           when 11 then return "K":U .
     1366           when 12 then return "L":U .
     1367           when 13 then return "M":U .
     1368           when 14 then return "N":U .
     1369           when 15 then return "O":U .
     1370           when 16 then return "P":U .
     1371           when 17 then return "Q":U .
     1372           when 18 then return "R":U .
     1373           when 19 then return "S":U .
     1374           when 20 then return "T":U .
     1375       end case .
     1376   end.
     1377   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378     run mainmenu_getcntxt in parparentproc
     1379       (output v-cntxt-db-num
     1380       ,output v-cntxt-userid
     1381       ,output v-cntxt-level
     1382       ,output v-cntxt-host-code-obj
     1383       ,output v-cntxt-obj-type
     1384       ,output v-cntxt-obj-code
     1385       ,output v-cntxt-db-num-obj
     1386       ,output v-cntxt-is-admin
     1387       ) .
     1388   for each thbjattr_thbj-attr  where
     1389           thbjattr_thbj-attr.obj-type = '':U
     1390       and thbjattr_thbj-attr.obj-code = 0
     1391       and thbjattr_thbj-attr.upper-prop-code = 'gds-ref':U
     1392   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1393   :
     1394     case thbjattr_thbj-attr.prop-code:
     1395       when 'tnvedimp':U then do:
     1396         tnvedimp = thbjattr_thbj-attr.property-value-logical.
     1397       end.
     1398     end case.
     1399   end.
     1400   run ref/strtimp.w (
     1401                          input parparentproc
     1402                         ,no
     1403                         ,input integer('1':U)
     1404                         ,input integer('2':U)
     1405                         ,input custvalue
     1406                         ,input tnvedimp
     1407                         ,output f-name
     1408                         ,output choice
     1409                         ,output p-artic
     1410                         ,output p-prod
     1411                         ,OUTPUT p-name
     1412                         ,OUTPUT p-engl-name
     1413                         ,OUTPUT p-unit-base
     1414                         ,OUTPUT p-VAT-code
     1415                         ,OUTPUT p-SLT-code
     1416                         ,OUTPUT p-struct
     1417                         ,OUTPUT p-tnved
     1418                         ,OUTPUT p-attrib
     1419                         ,OUTPUT p-destin
     1420                         ,OUTPUT p-sert
     1421                         ,OUTPUT p-user-rule
     1422                         ,OUTPUT p-alpha1
     1423                         ,OUTPUT p-grp-code
     1424                         ,OUTPUT p-service
     1425                         ,OUTPUT p-gds-code
     1426                         ,OUTPUT p-mark
     1427                         ,output p-nomcode
     1428                         ,output p-ppr
     1429                         ) .
     1430   if  error-status:error or f-name = "" then return error.
     1431   CASE choice:
     1432       WHEN 1 then do:
     1433           input stream gds-file from value (f-name) convert source "1251".
     1434       END.
     1435       WHEN 2 then do:
     1436           input stream gds-file from value (f-name) convert source "KOI8-R".
     1437       END.
     1438   END CASE.
     1439   assign
     1440       impc       = 0
     1441       impc-saved = 0
     1442       impc-Warn  = 0
     1443   .
     1444   run waitfram-show in this-procedure ( "ЖДИТЕ...") .
     1445   output stream str-log to value("gds-imp.log") .
     1446   if substring(f-name, length(f-name) - 2) = "xls"
     1447   or substring(f-name, length(f-name) - 3) = "xlsx"
     1448   then do :
     1449       CREATE "Excel.Application":U mExcelApplication.
     1450       if error-status :error then do:
     1451           message
     1452           "Ошибка при запуске Excel" skip
     1453           error-status :get-message(1) skip
     1454           view-as alert-box error .
     1455           undo, return error .
     1456       end.
     1457       ASSIGN
     1458           mExcelApplication:DisplayAlerts = NO
     1459           mWorkbook                       = mExcelApplication:WorkBooks:Add(f-name)
     1460           mWorkSheet                      = mWorkbook:Sheets:Item(1)
     1461       .
     1462       loopbl:
     1463       DO vLine = 1 TO 1000000:
     1464           ASSIGN
     1465               vChLine = STRING(vLine)
     1466               i-artic = ?
     1467               i-alpha1 = ?
     1468               i-attrib = ?
     1469               i-destin = ?
     1470               i-engl-name = ?
     1471               i-gds-name = ?
     1472               i-grp-code = 0
     1473               i-prod-code = ?
     1474               i-prod-type = ?
     1475               i-sert = ?
     1476               i-service = ?
     1477               i-gds-code = ?
     1478               i-SLT-code = ?
     1479               i-struct = ?
     1480               i-tnved = ?
     1481               i-unit-base = ?
     1482               i-user-rule = ?
     1483               i-VAT-code = 0
     1484               i-mark = ?
     1485               i-nomcode = ?
     1486               i-ppr = ?
     1487           .
     1488           i-artic = mWorkSheet:Range(f-range(p-artic) + vChLine):VALUE NO-ERROR.
     1489           if i-artic = ? then i-artic = mWorkSheet:Range(f-range(p-artic) + vChLine):FORMULA NO-ERROR.
     1490           i-artic = entry(1, i-artic, ".") no-error .
     1491           i-alpha1 = mWorkSheet:Range(f-range(p-alpha1) + vChLine):VALUE NO-ERROR.
     1492           if i-alpha1 = ? then i-alpha1 = mWorkSheet:Range(f-range(p-alpha1) + vChLine):FORMULA NO-ERROR.
     1493           i-attrib = mWorkSheet:Range(f-range(p-attrib) + vChLine):VALUE NO-ERROR.
     1494           if i-attrib = ? then i-attrib = mWorkSheet:Range(f-range(p-attrib) + vChLine):FORMULA NO-ERROR.
     1495           i-destin = mWorkSheet:Range(f-range(p-destin) + vChLine):VALUE NO-ERROR.
     1496           if i-destin = ? then i-destin = mWorkSheet:Range(f-range(p-destin) + vChLine):FORMULA NO-ERROR.
     1497           i-engl-name = mWorkSheet:Range(f-range(p-engl-name) + vChLine):VALUE NO-ERROR.
     1498           if i-engl-name = ? then i-engl-name = mWorkSheet:Range(f-range(p-engl-name) + vChLine):FORMULA NO-ERROR.
     1499           i-gds-name = mWorkSheet:Range(f-range(p-name) + vChLine):VALUE NO-ERROR.
     1500           if i-gds-name = ? then i-gds-name = mWorkSheet:Range(f-range(p-name) + vChLine):FORMULA NO-ERROR.
     1501           i-grp-code = integer(mWorkSheet:Range(f-range(p-grp-code) + vChLine):VALUE) NO-ERROR.
     1502           if i-grp-code = ? then i-grp-code = integer(mWorkSheet:Range(f-range(p-grp-code) + vChLine):FORMULA) NO-ERROR.
     1503           v-prod = mWorkSheet:Range(f-range(p-prod) + vChLine):VALUE NO-ERROR.
     1504           if v-prod = ? then v-prod = mWorkSheet:Range(f-range(p-prod) + vChLine):FORMULA NO-ERROR.
     1505           i-prod-code = integer(substring(v-prod, 4)) no-error .
     1506           i-prod-type = substring(v-prod, 1, 3) .
     1507           i-sert = mWorkSheet:Range(f-range(p-sert) + vChLine):VALUE NO-ERROR.
     1508           if i-sert = ? then i-sert = mWorkSheet:Range(f-range(p-sert) + vChLine):FORMULA NO-ERROR.
     1509           i-service = logical(mWorkSheet:Range(f-range(p-service) + vChLine):VALUE) NO-ERROR.
     1510           if i-service = ? then i-service = logical(mWorkSheet:Range(f-range(p-service) + vChLine):FORMULA) NO-ERROR.
     1511           i-gds-code = integer(mWorkSheet:Range(f-range(p-gds-code) + vChLine):VALUE) NO-ERROR.
     1512           if i-gds-code = ? then i-gds-code = integer(mWorkSheet:Range(f-range(p-gds-code) + vChLine):FORMULA) NO-ERROR.
     1513           i-SLT-code = integer(mWorkSheet:Range(f-range(p-SLT-code) + vChLine):VALUE) NO-ERROR.
     1514           if i-SLT-code = ? then i-SLT-code = integer(mWorkSheet:Range(f-range(p-SLT-code) + vChLine):FORMULA) NO-ERROR.
     1515           i-struct = mWorkSheet:Range(f-range(p-struct) + vChLine):VALUE NO-ERROR.
     1516           if i-struct = ? then i-struct = mWorkSheet:Range(f-range(p-struct) + vChLine):FORMULA NO-ERROR.
     1517           i-tnved = mWorkSheet:Range(f-range(p-tnved) + vChLine):VALUE NO-ERROR.
     1518           if i-tnved = ? then i-tnved = mWorkSheet:Range(f-range(p-tnved) + vChLine):FORMULA NO-ERROR.
     1519           i-unit-base = mWorkSheet:Range(f-range(p-unit-base) + vChLine):VALUE NO-ERROR.
     1520           if i-unit-base = ? then i-unit-base = mWorkSheet:Range(f-range(p-unit-base) + vChLine):FORMULA NO-ERROR.
     1521           i-user-rule = mWorkSheet:Range(f-range(p-user-rule) + vChLine):VALUE NO-ERROR.
     1522           if i-user-rule = ? then i-user-rule = mWorkSheet:Range(f-range(p-user-rule) + vChLine):FORMULA NO-ERROR.
     1523           i-VAT-code = integer(mWorkSheet:Range(f-range(p-VAT-code) + vChLine):VALUE) NO-ERROR.
     1524           if i-VAT-code = ? then i-VAT-code = integer(mWorkSheet:Range(f-range(p-VAT-code) + vChLine):FORMULA) NO-ERROR.
     1525           i-mark = integer (mWorkSheet:Range(f-range(p-mark) + vChLine):value) NO-ERROR.
     1526           if i-mark = ? then i-mark = (mWorkSheet:Range(f-range(p-mark) + vChLine):FORMULA) NO-ERROR.
     1527           i-nomcode = mWorkSheet:Range(f-range(p-nomcode) + vChLine):value NO-ERROR.
     1528           if i-nomcode = ? then i-nomcode = (mWorkSheet:Range(f-range(p-nomcode) + vChLine):FORMULA) NO-ERROR.
     1529           i-ppr = integer(mWorkSheet:Range(f-range(p-ppr) + vChLine):VALUE) NO-ERROR.
     1530           if i-ppr = ? then i-ppr = integer(mWorkSheet:Range(f-range(p-ppr) + vChLine):FORMULA) NO-ERROR.
     1531           if length(i-artic) > 0 or length(i-alpha1) > 0 or length(i-attrib) > 0
     1532           or length(i-destin) > 0 or length(i-engl-name) > 0 or length(i-engl-name) > 0
     1533           or length(i-gds-name) > 0 or i-grp-code > 0 or length(i-prod-type) > 0
     1534           or i-prod-code > 0 or length(i-sert) > 0 or i-service <> ? or i-gds-code > 0 or length(i-struct) > 0
     1535           or i-SLT-code > 0 or length(i-tnved) > 0 or length(i-unit-base) > 0
     1536           or length(i-user-rule) > 0 or i-VAT-code > 0
     1537           then vNoLine = 0 .
     1538           else do :
     1539               vNoLine = vNoLine + 1.
     1540               IF vNoLine > mMaxNoLine THEN LEAVE loopbl.
     1541               ELSE NEXT loopbl.
     1542           end.
     1543           if i-gds-code eq ?
     1544              and (i-artic eq ?
     1545                  or  i-prod-type eq ?
     1546                  or  i-prod-code eq ?)
     1547           then do:
     1548               impc = impc + 1 .
     1549               put stream str-log unformatted "В загрузке обязательно должен быть код товара или артикул и производитель. Строка" vLine skip .
     1550               next.
     1551           end.
     1552           else do :
     1553               if     i-gds-code ne ?
     1554                  and i-artic    ne ?
     1555                  and i-prod-type ne ?
     1556                  and i-prod-code ne ?
     1557                and
     1558                can-find(goods where goods.artic eq i-artic
     1559                               and goods.prod-type eq i-prod-type
     1560                               and goods.prod-code eq i-prod-code
     1561                               and goods.gds-code  ne i-gds-code)
     1562               then do:
     1563                   impc = impc + 1 .
     1564                   put stream str-log unformatted "Уже есть товар с артикулом " i-artic "  " i-prod-type " " string(i-prod-code) " Строка  " vLine skip .
     1565                   next.
     1566               end.
     1567           end.
     1568           find first goods where goods.gds-code = i-gds-code no-lock no-error.
     1569           if not available goods
     1570           then
     1571              find first goods where goods.artic     eq i-artic
     1572                                 and goods.prod-type eq i-prod-type
     1573                                 and goods.prod-code eq i-prod-code no-lock no-error.
     1574           if available goods
     1575              and i-unit-base ne ?
     1576              and goods.unit-base ne i-unit-base
     1577           then do:
     1578               impc-Warn = impc-Warn + 1.
     1579               i-unit-base =  goods.unit-base.
     1580               put stream str-log unformatted "Внимание Артикул " goods.artic " .  Единицы измерения изменять нельзя. Единицы измерения проигнорировы.  Строка  " vLine  skip .
     1581           end.
     1582           assign
     1583           impc = impc + 1 .
     1584           do transaction:
     1585   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1587     (input  v-cntxt-obj-type
     1588     ,input  v-cntxt-obj-code
     1589     ,output v-host-code
     1590     )  .
     1591               find last tax-rate-value where
     1592                           tax-rate-value.tax-code = 1 and
     1593                           tax-rate-value.rate-code = i-vat-code no-lock no-error.
     1594               IF available tax-rate-value then do:
     1595                   NDS = tax-rate-value.rate-code.
     1596               END.
     1597               find first gds-grp no-lock where gds-grp.node-code = i-grp-code no-error .
     1598               find first first_gds-grp .
     1599               if i-unit-base ne ?
     1600               then do:
     1601               run ref/dtaxgdss.p (
     1602                     input yes
     1603                   , input   i-unit-base
     1604                   , input   (if available gds-grp
     1605                                 then gds-grp.node-code
     1606                                 else first_gds-grp.node-code)
     1607                   , input if available goods then recid(goods) else ?
     1608                   , input if available goods then recid(goods) else ?
     1609                   , input   v-host-code
     1610                   , input    v-cntxt-obj-type
     1611                   , input    v-cntxt-obj-code
     1612               ) no-error.
     1613               if error-status :error
     1614               then do:
     1615                  put stream str-log unformatted "Артикул " i-artic " .   " replace (return-value,Chr(10)," ")  " Строка  " vLine skip .
     1616                  next loopbl.
     1617               end.
     1618               end.
     1619               IF p-VAT-code > 0 THEN DO:
     1620                   find first tt-tax
     1621                        where tt-tax.tax-code = integer( '1':U )
     1622                   no-error.
     1623                   if available tt-tax   then do:
     1624                       assign
     1625                           tt-tax.rate-code = NDS .
     1626                   end.
     1627               END.
     1628               v-recid = if available goods then recid(goods) else ?.
     1629               mnewrec = not avail goods.
     1630               run ref/goods01.p (
     1631                     input parparentproc
     1632                   , input if available goods then 'АВТОИЗМЕНЕНИЕ':U else 'ДОБАВЛЕНИЕ':U
     1633                   , input no
     1634                   , input 0
     1635                   , input no
     1636                   , input yes
     1637                   , input no
     1638                   , input no
     1639                   , input yes
     1640                   , input v-host-code
     1641                   , input v-cntxt-obj-type
     1642                   , input v-cntxt-obj-code
     1643                   , input (if i-service then no else yes)
     1644                   , input ?
     1645                   , input i-gds-code
     1646                   , input i-artic
     1647                   , input i-prod-type
     1648                   , input i-prod-code
     1649                   , input 1
     1650                   , input i-grp-code
     1651                   , input i-gds-name
     1652                   , input ""
     1653                   , input i-engl-name
     1654                   , input i-gds-name
     1655                   , input replace( replace( i-gds-name, chr( 39 ), "" ), chr( 34 ), "" )
     1656                   , input i-alpha1
     1657                   , input i-unit-base
     1658                   , input i-unit-base
     1659                   , input 0.0
     1660                   , input 0.0
     1661                   , input 1
     1662                   , input 1
     1663                   , input 0
     1664                   , input 0
     1665                   , input 0
     1666                   , input 0
     1667                   , input 'Группа':U
     1668                   , input 0
     1669                   , input no
     1670                   , input (if i-service then 1 else 0)
     1671                   , input (if i-service then 1 else 0)
     1672                   , input ""
     1673                   , input ""
     1674                   , input ""
     1675                   , input ""
     1676                   , input ""
     1677                   , input ""
     1678                   , input 0
     1679                   , input 0
     1680                   , input ""
     1681                   , input 0.0
     1682                   , input 0
     1683                   , input 0
     1684                   , input ""
     1685                   , input ""
     1686                   , input ""
     1687                   , input 0
     1688                   , input ?
     1689                   , input ""
     1690                   , input no
     1691                   , input no
     1692                   , input no
     1693                   , input no
     1694                   , input "no"
     1695                   , input yes
     1696                   , input no
     1697                   , input no
     1698                   , input if i-gds-code > 0 then 2 else 0
     1699                   , input-output v-recid
     1700                   , output j-gds-code
     1701               ) no-error .
     1702               find first goods where recid( goods)  = v-recid    no-lock no-error.
     1703               if error-status :error
     1704                  or not available goods
     1705               then do:
     1706                   put stream str-log unformatted "Ошибка создания/изменении карточки товара. Артикул " i-artic " .   " return-value " Строка  " vLine  skip .
     1707                   next loopbl.
     1708               end.
     1709               else do :
     1710                    def var v-value as char no-undo.
     1711                   def var v-type as char no-undo.
     1712                   if p-mark eq 0
     1713                   then do:
     1714                      if mnewrec
     1715                      then do:
     1716                          define variable mflag as logical no-undo.
     1717                          run gds-attr-exist in this-procedure (goods.gds-code,'mark-type':U,output mflag).
     1718                          if not mflag
     1719                          then do:
     1720                             run ggoattr-value(
     1721                               input i-grp-code,
     1722                               input 0,
     1723                               input "",
     1724                               input 0,
     1725                               input 'gg-mark-type':U,
     1726                               output v-value,
     1727                               output v-type
     1728                             ) no-error.
     1729                             if v-value > "" then do:
     1730                                 run gds-attr-write IN THIS-PROCEDURE(
     1731                                    input goods.gds-code
     1732                                   ,INPUT 'mark-type':U
     1733                                   ,INPUT v-value ) NO-ERROR.
     1734                                 put stream str-log unformatted "Внимание Артикул " goods.artic " .  Признак маркировки установлен с группы Строка " vLine  skip .
     1735                                 impc-Warn = impc-Warn + 1.
     1736                             end.
     1737                         end.
     1738                      end.
     1739                   end.
     1740                   else if i-mark eq ? or i-mark eq 0
     1741                   then do:
     1742                      run gds-attr-delete IN THIS-PROCEDURE(input goods.gds-code
