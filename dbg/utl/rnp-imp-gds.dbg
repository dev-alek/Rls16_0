     2245   message ("Импорт из файла " + f-name + " закончен" + chr(10) + "прочитано " + string(impc) +
     2246            ",  сохранено " + string(impc-saved) + ", предупреждений " + string(impc-Warn) + chr(10) + chr(10) + "Информация по незагруженным товарам находится в файле gds-imp.log" )
     2247   view-as alert-box  INFORMATION.
     2248   release object mWorkSheet.
     2249   mExcelApplication:quit.
     2250   release object mExcelApplication.
