      523   procedure grp-obj-notcorr-value :
      524   do
      525   on error undo, return error
      526   :
      527   define input parameter p-node-code             as integer      no-undo.
      528   define input parameter p-obj-type              as character    no-undo.
      529   define input parameter p-obj-code              as integer      no-undo.
      530   define output parameter p-notcorr              as character    no-undo init ?.
      531   define output parameter p-range-notcorr     as integer      no-undo.
      532   define output parameter p-exists-notcorr    as logical      no-undo.
      533   define variable v-host-code as integer      no-undo.
      534   DEFINE VARIABLE v-found as logical no-undo .
      535   DEFINE VARIABLE v-exists as logical no-undo .
      536   DEFINE VARIABLE v-range as integer no-undo .
      537   DEFINE VARIABLE jj as integer no-undo .
      538   DEFINE VARIABLE v-notcorr-found as logical no-undo .
      539   DEFINE VARIABLE v-notcorr-value as char      no-undo.
      540   define buffer buf_gds-grp for ub.gds-grp.
      541   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      542   find first buf_gds-grp no-lock where
      543              buf_gds-grp.node-code = p-node-code no-error .
      544   if not avail buf_gds-grp and p-node-code <> 0 then do:
      545     message
      546       vss-workfile vss-revision vss-description
      547       skip "Не удалось найти группу товаров с кодом" p-node-code
      548       view-as alert-box error .
      549     undo, return error .
      550   end.
      551   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      553     (input  p-obj-type
      554     ,input  p-obj-code
      555     ,output v-host-code
      556     ) no-error .
      557   if error-status :error
      558   then do:
      559       message
      560         vss-workfile vss-revision vss-description
      561         skip "Не удалось найти фирму объекта"
      562         skip p-obj-type p-obj-code
      563         skip return-value
      564         skip trim(error-status :get-message(1))
      565       view-as alert-box error.
      566       undo, return error .
      567   end.
      568   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      569   do while v-found = no and jj < 2:
      570     if v-range <> 3 then do:
      571       find first buf_gds-grp-obj no-lock
      572           where buf_gds-grp-obj.node-code = p-node-code
      573             and buf_gds-grp-obj.host-code = v-host-code
      574             and buf_gds-grp-obj.obj-type  = p-obj-type
      575             and buf_gds-grp-obj.obj-code  = p-obj-code
      576       no-error .
      577     end.
      578     if v-range = 3 or not available buf_gds-grp-obj
      579     then do:
      580        if v-range <> 2 then do:
      581           find first buf_gds-grp-obj no-lock
      582               where buf_gds-grp-obj.node-code = p-node-code
      583                 and buf_gds-grp-obj.host-code = v-host-code
      584                 and buf_gds-grp-obj.obj-type  = ""
      585                 and buf_gds-grp-obj.obj-code  = 0
      586           no-error .
      587         end.
      588         if v-range = 2 or not available buf_gds-grp-obj
      589         then do:
      590             if v-range <> 1 then do:
      591               find first buf_gds-grp-obj no-lock
      592                   where buf_gds-grp-obj.node-code = p-node-code
      593                   and buf_gds-grp-obj.host-code = 0
      594                   and buf_gds-grp-obj.obj-type  = ""
      595                   and buf_gds-grp-obj.obj-code  = 0
      596               no-error .
      597             end.
      598             if v-range = 1 or not available buf_gds-grp-obj
      599             then do:
      600                 assign
      601                     v-exists = no
      602                 .
      603             end.
      604             else do:
      605                 assign
      606                     v-exists = yes
      607                     v-range = 1
      608                 .
      609             end.
      610         end.
      611         else do:
      612             assign
      613                 v-exists = yes
      614                 v-range  = 2
      615             .
      616         end.
      617     end.
      618     else do:
      619         assign
      620             v-exists = yes
      621             v-range  = 3
      622         .
      623     end.
      624     if available buf_gds-grp-obj
      625     then do:
      626       find first buf_gds-grp-obj-attr no-lock
      627         where buf_gds-grp-obj-attr.node-code   = p-node-code
      628           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
      629           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
      630           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
      631           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
      632         no-error .
      633       if available buf_gds-grp-obj-attr then do:
      634         assign
      635           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
      636         .
      637       end.
      638       else do:
      639         assign
      640           v-notcorr-value = ?
      641         .
      642       end.
      643       assign
      644       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
      645                           then yes
      646                           else p-exists-notcorr)
      647       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
      648                         then v-range
      649                         else p-range-notcorr
      650       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
      651                         then v-notcorr-value
      652                         else p-notcorr
      653       v-found =  (p-exists-notcorr ) or (v-range <= 1)
      654       jj = jj + 1
      655       .
      656     end.
      657     else do:
      658       assign
      659       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
      660       jj = jj + 1
      661       .
      662     end.
      663   end.
      664   end.
      665   end procedure.
      666   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
