     1254   FIELD tax-rate-gds-rc  as recid
     1255   FIELD to-cashdesk like ub.tax.to-cashdesk
     1256   FIELD fact-date like ub.tax-rate-value.fact-date
     1257   FIELD fact-order like ub.tax-rate-value.fact-order
