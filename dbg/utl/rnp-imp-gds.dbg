     1247   field tax-code    like ub.tax.tax-code
     1248   FIELD individual  like ub.tax.individual
     1249   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     1250   field rate-code   like ub.tax-rate.rate-code
     1251   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     1252   FIELD tax-type    like ub.tax.tax-type
