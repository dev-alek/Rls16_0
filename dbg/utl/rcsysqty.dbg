        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define input parameter parrvs-code like ub.rvs-doc.rvs-code no-undo.
        7   define buffer bf_rvs-doc  for ub.rvs-doc.
        8   define buffer bf_rvs-line for ub.rvs-line.
        9   define buffer bf_goods    for ub.goods.
       10   define buffer bf-prev_doc-line for ub.doc-line.
       11   define buffer bf-prev_inv-line for ub.inv-line.
       12   define temp-table tt-goods no-undo like ub.goods
       13   field total-qnty-l as decimal.
       14   find first bf_rvs-doc where bf_rvs-doc.rvs-code = parrvs-code exclusive-lock.
       15   for each bf_rvs-line where bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code no-lock,
       16     first bf_goods where bf_goods.gds-code = bf_rvs-line.gds-code no-lock :
       17     find first tt-goods where tt-goods.gds-code = bf_rvs-line.gds-code no-error.
       18     if not available tt-goods then do:
       19       create tt-goods.
       20       assign
       21         tt-goods.artic     = bf_goods.artic
       22         tt-goods.prod-type = bf_goods.prod-type
       23         tt-goods.prod-code = bf_goods.prod-code
       24         tt-goods.gds-code  = bf_goods.gds-code
       25       .
       26     end.
       27     assign
       28       tt-goods.total-qnty-l = tt-goods.total-qnty-l + bf_rvs-line.system-qnty.
       29   end.
       30   for each bf_rvs-line where bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code exclusive-lock,
       31     first bf_goods where bf_goods.gds-code = bf_rvs-line.gds-code no-lock :
       32     find first tt-goods where tt-goods.gds-code = bf_rvs-line.gds-code.
       33     find last bf-prev_doc-line where bf-prev_doc-line.obj-type   = bf_rvs-line.obj-type and
       34                                      bf-prev_doc-line.obj-code   = bf_rvs-line.obj-code and
       35                                      bf-prev_doc-line.prod-type  = bf_goods.prod-type   and
       36                                      bf-prev_doc-line.prod-code  = bf_goods.prod-code   and
       37                                      bf-prev_doc-line.artic      = bf_goods.artic       and
       38                                      bf-prev_doc-line.status_    = 'факт':U              and
       39                                      bf-prev_doc-line.fact-order < bf_rvs-doc.fact-order use-index fact-order no-lock no-error.
       40     if available bf-prev_doc-line then do:
       41       find first bf-prev_inv-line where bf-prev_inv-line.doc-code  = bf-prev_doc-line.doc-code  and
       42                                         bf-prev_inv-line.artic     = bf-prev_doc-line.artic     and
       43                                         bf-prev_inv-line.prod-type = bf-prev_doc-line.prod-type and
       44                                         bf-prev_inv-line.prod-code = bf-prev_doc-line.prod-code no-lock no-error.
       45       if available bf-prev_inv-line then do:
       46         assign
       47           bf_rvs-line.system-cli-qnty = bf-prev_inv-line.after-cli-qnty * bf_rvs-line.system-qnty / tt-goods.total-qnty-l.
       48       end.
       49     end.
       50   end.
       51   message "Расчет закончен" view-as alert-box.
