      193      method public void ObjectToForm():
      194         def var vI as int64 no-undo.
      195         if valid-object(this-object:Condition) then
      196         do:
      197            do vI = 1 to num-entries(this-object:Condition:SupportOp):
      198               this-object:cbOp:Items:Add(entry(vI,this-object:Condition:SupportOp)).
      199            end.
      200            assign
      201               this-object:cbEnabled:Checked = this-object:Condition:Enabled
      202               this-object:tbName:Text       = this-object:Condition:FieldName
      203               this-object:mtbValue:Text     = this-object:Condition:Value
      204               this-object:cbOp:Text         = this-object:Condition:Operation
      205            .
      206            SetComponentsToEnabled().
      207            SetVisible().
      208            case this-object:Condition:FieldType:
      209               when "date" then
      210               do:
      211                  assign
      212                     this-object:dtPicker1:CustomFormat = "dd/MM/yyyy"
      213                     this-object:dtPicker2:CustomFormat = "dd/MM/yyyy"
      214                     this-object:dtPicker1:Text = this-object:Condition:value
      215                     this-object:dtPicker2:Text = this-object:Condition:value1
      216                  .
      217               end.
      218               when "datetime" then
      219               do:
      220                  assign
      221                     this-object:dtPicker1:CustomFormat = "dd/MM/yyyy HH:mm"
      222                     this-object:dtPicker2:CustomFormat = "dd/MM/yyyy HH:mm"
      223                     this-object:dtPicker1:Text = this-object:Condition:value
      224                     this-object:dtPicker2:Text = this-object:Condition:value1
      225                  .
      226               end.
      227            end case.
      228         end.
      229      end method.
      230      method private void SetVisible():
      231         if not valid-object(this-object:Condition) then return.
      232         case this-object:Condition:FieldType:
      233            when "date" then
      234            do:
      235               assign
      236                  this-object:mtbValue:Visible = no
      237                  this-object:dtPicker1:visible = yes
      238                  this-object:dtPicker2:visible = (this-object:cbOp:Text = "между")
      239               .
      240            end.
      241            when "datetime" then
      242            do:
      243               assign
      244                  this-object:mtbValue:Visible = no
      245                  this-object:dtPicker1:visible = yes
      246                  this-object:dtPicker2:visible = (this-object:cbOp:Text = "между")
      247               .
      248            end.
      249            otherwise
      250            do:
      251               assign
      252                  this-object:mtbValue:Visible = yes
      253                  this-object:dtPicker1:visible = no
      254                  this-object:dtPicker2:visible = no
      255               .
      256            end.
      257         end case.
      258      end method.
      259      method private void SetComponentsToEnabled():
      260         assign
      261            this-object:cbOp:enabled      = this-object:cbEnabled:Checked
      262            this-object:mtbValue:enabled  = this-object:cbEnabled:Checked and this-object:cbOp:Text <> ""
      263            this-object:dtPicker1:enabled = this-object:cbEnabled:Checked and this-object:cbOp:Text <> ""
      264            this-object:dtPicker2:enabled = this-object:cbEnabled:Checked and this-object:cbOp:Text <> ""
      265         .
      266      end method.
      267      method public void SetEnabledTo(iState as log):
      268         this-object:cbEnabled:Checked = iState.
      269      end method.
      270      method public void FormToObject():
      271         def var vIsDate as log no-undo.
      272         if valid-object(this-object:Condition) then
      273         do:
      274            assign
      275               this-object:Condition:enabled   = this-object:cbEnabled:Checked
      276               this-object:Condition:value     = this-object:mtbValue:Text
      277               this-object:Condition:Operation = this-object:cbOp:Text
      278            .
      279            if this-object:Condition:FieldType = "date" or
      280               this-object:Condition:FieldType = "datetime" then
      281            do:
      282               assign
      283                  this-object:Condition:value = this-object:dtPicker1:Text
      284                  this-object:Condition:value1 = this-object:dtPicker2:Text
      285               .
      286            end.
      287         end.
      288         return.
      289      end method.
      290      method public void SetValue(iValue as char):
      291         if cbEnabled:checked then
      292         do:
      293            if cbOp:text = "список" then
      294            do:
      295               assign
      296                  mtbValue:text = substitute("&1,&2",mtbValue:text,iValue)
      297                  mtbValue:text = trim(mtbValue:text,",")
      298               .
      299            end.
      300            else
      301            do:
      302               mtbValue:text = iValue.
      303            end.
      304         end.
      305      end method.
      306      method public void fReset():
      307         assign
      308            this-object:mtbValue:Text = ""
      309            this-object:cbOp:Text = ""
      310         .
      311      end method.
      312      method public void ResetAndDisable():
      313         this-object:fReset().
      314         this-object:SetEnabledTo(no).
      315      end method.
