     2301           .
     2302         end.
     2303       end.
     2304     end.
     2305   end procedure.
     2306   procedure ahrstutl-clear-ahsp :
     2307     define input  parameter p-obj-type         as character no-undo .
     2308     define input  parameter p-obj-code         as integer   no-undo .
     2309     define input  parameter p-fact-date        as date      no-undo .
     2310     define buffer buf_ot-supp-tot   for ub.ot-supp-tot .
     2311     define buffer buf_ot-supp-line  for ub.ot-supp-line .
     2312     define buffer buf_stk-supp-tot  for ub.stk-supp-tot .
     2313     define buffer buf_stk-supp-line for ub.stk-supp-line .
     2314     define variable v-shift-on                as logical   no-undo .
     2315     define variable v-shift-date              as date      no-undo .
     2316     define variable v-shift-num               as integer   no-undo .
     2317     define variable v-day-end-fact-order      as decimal   no-undo .
     2318     define variable v-shift-end-fact-order    as decimal   no-undo .
     2319     define variable v-ind as integer no-undo .
     2320     do
     2321     on error undo, return error return-value
     2322     :
     2323       run factord-cut-archive in this-procedure
     2324         (input  p-obj-type
     2325         ,input  p-obj-code
     2326         ,input  p-fact-date
     2327         ,output v-shift-on
     2328         ,output v-shift-date
     2329         ,output v-shift-num
     2330         ,output v-day-end-fact-order
     2331         ,output v-shift-end-fact-order
     2332         ) .
     2333       assign
     2334         v-day-end-fact-order   = v-day-end-fact-order   - 0.0000000001
     2335         v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     2336       .
     2337       run show-action in this-procedure
     2338         (input "Удаление оборота по документам"
     2339         ).
     2340       assign
     2341         v-ind = 0
     2342       .
     2343       for each buf_ot-supp-tot
     2344         where buf_ot-supp-tot.obj-type   = p-obj-type
     2345           and buf_ot-supp-tot.obj-code   = p-obj-code
     2346           and buf_ot-supp-tot.fact-order <= v-day-end-fact-order
     2347       on error undo, return error return-value
     2348       :
     2349         assign
     2350           v-ind = v-ind + 1
     2351         .
     2352         if v-ind modulo 10 = 0
     2353         then do:
     2354           run show-count in this-procedure
     2355             (input v-ind
     2356             ,input "Документ " + string(buf_ot-supp-tot.doc-code)
     2357             ).
     2358         end.
     2359         delete buf_ot-supp-tot .
     2360       end.
     2361       run show-action in this-procedure
     2362         (input "Удаление оборота по строкам документов"
     2363         ).
     2364       assign
     2365         v-ind = 0
     2366       .
     2367       for each buf_ot-supp-line
     2368         where buf_ot-supp-line.obj-type   = p-obj-type
     2369           and buf_ot-supp-line.obj-code   = p-obj-code
     2370           and buf_ot-supp-line.fact-order <= v-day-end-fact-order
     2371       on error undo, return error return-value
     2372       :
     2373         assign
     2374           v-ind = v-ind + 1
     2375         .
     2376         if v-ind modulo 10 = 0
     2377         then do:
     2378           run show-count in this-procedure
     2379             (input v-ind
     2380             ,input "Документ " + string(buf_ot-supp-line.doc-code)
     2381                     + " Артикул " + string(buf_ot-supp-line.artic)
     2382             ).
     2383         end.
     2384         delete buf_ot-supp-line .
     2385       end.
     2386       run show-action in this-procedure
     2387         (input "Удаление остатка по объекту"
     2388         ).
     2389       assign
     2390         v-ind = 0
     2391       .
     2392       for each buf_stk-supp-tot
     2393         where buf_stk-supp-tot.obj-type   = p-obj-type
     2394           and buf_stk-supp-tot.obj-code   = p-obj-code
     2395           and buf_stk-supp-tot.fact-order <= v-day-end-fact-order
     2396       on error undo, return error return-value
     2397       :
     2398         assign
     2399           v-ind = v-ind + 1
     2400         .
     2401         if v-ind modulo 10 = 0
     2402         then do:
     2403           run show-count in this-procedure
     2404             (input v-ind
     2405             ,input "Дата " + string(buf_stk-supp-tot.fact-date, '99/99/9999':U )
     2406             ).
     2407         end.
     2408         if buf_stk-supp-tot.shift-date = ?
     2409         or (buf_stk-supp-tot.shift-date <> ?
     2410             and
     2411             buf_stk-supp-tot.fact-order <= v-shift-end-fact-order
     2412            )
     2413         then do:
     2414           delete buf_stk-supp-tot .
     2415         end.
     2416       end.
     2417       run show-action in this-procedure
     2418         (input "Удаление остатка по товарам на объекте"
     2419         ).
     2420       assign
     2421         v-ind = 0
     2422       .
     2423       for each buf_stk-supp-line
     2424         where buf_stk-supp-line.obj-type   = p-obj-type
     2425           and buf_stk-supp-line.obj-code   = p-obj-code
     2426           and buf_stk-supp-line.fact-order <= v-day-end-fact-order
     2427       on error undo, return error return-value
     2428       :
     2429         assign
     2430           v-ind = v-ind + 1
     2431         .
     2432         if v-ind modulo 10 = 0
     2433         then do:
     2434           run show-count in this-procedure
     2435             (input v-ind
     2436             ,input "Артикул " + string(buf_stk-supp-line.artic)
     2437             ).
     2438         end.
     2439         if buf_stk-supp-line.shift-date = ?
     2440         or (buf_stk-supp-line.shift-date <> ?
     2441             and
     2442             buf_stk-supp-line.fact-order <= v-shift-end-fact-order
     2443            )
     2444         then do:
     2445           delete buf_stk-supp-line .
     2446         end.
     2447       end.
     2448     end.
     2449   end procedure.
     2450   procedure ahrstutl-supp-tot-sum-type-list :
     2451     define output parameter p-sum-type-list as character no-undo .
     2452     do
     2453     on error undo, return error return-value
     2454     :
     2455       define variable v-ind                    as integer   no-undo .
     2456       define variable v-num-entries-TDEDT_List as integer   no-undo .
     2457       assign
     2458         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2459       .
     2460       assign
     2461         p-sum-type-list = 'cost':U
     2462       .
     2463       do v-ind = 1 to v-num-entries-TDEDT_List
     2464       :
     2465         assign
     2466           p-sum-type-list = p-sum-type-list
     2467                           + chr(44)
     2468                           + 'sadt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2469         .
     2470       end.
     2471       do v-ind = 1 to v-num-entries-TDEDT_List
     2472       :
     2473         assign
     2474           p-sum-type-list = p-sum-type-list
     2475                           + chr(44)
     2476                           + 'csdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2477         .
     2478       end.
     2479     end.
     2480   end procedure.
     2481   procedure ahrstutl-supp-line-sum-type-list :
     2482     define output parameter p-sum-type-list as character no-undo .
     2483     do
     2484     on error undo, return error return-value
     2485     :
     2486       define variable v-ind                    as integer   no-undo .
     2487       define variable v-num-entries-TDEDT_List as integer   no-undo .
     2488       assign
     2489         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2490       .
     2491       assign
     2492         p-sum-type-list = 'cost':U
     2493       .
     2494       do v-ind = 1 to v-num-entries-TDEDT_List
     2495       :
     2496         assign
     2497           p-sum-type-list = p-sum-type-list
     2498                           + chr(44)
     2499                           + 'sadt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2500         .
     2501       end.
     2502       do v-ind = 1 to v-num-entries-TDEDT_List
     2503       :
     2504         assign
     2505           p-sum-type-list = p-sum-type-list
     2506                           + chr(44)
     2507                           + 'csdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2508         .
     2509       end.
     2510     end.
     2511   end procedure.
     2512   procedure create-log-err :
     2513     define input  parameter p-obj-type  as character no-undo .
     2514     define input  parameter p-obj-code  as integer   no-undo .
     2515     define input  parameter p-file-name as character no-undo .
     2516     define input  parameter p-err       as character no-undo .
     2517     do
     2518     on error undo, return error
     2519     :
     2520       output stream slog to value(p-file-name) .
     2521       export stream slog 'archive-log-version':u '2.1':u .
     2522       export stream slog 'obj-type':u            p-obj-type .
     2523       export stream slog 'obj-code':u            string(p-obj-code) .
     2524       export stream slog  string(p-err) .
     2525       output stream slog close .
     2526     end.
     2527   end procedure.
