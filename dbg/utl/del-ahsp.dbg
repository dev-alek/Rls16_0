      938   procedure thobjs :
      939      define input        parameter parparentproc     as widget-handle no-undo .
      940      define input        parameter i-bttns           as character     no-undo .
      941      define input        parameter i-list-mode       as character     no-undo.
      942      define input        parameter i-obj-type        as character     no-undo.
      943      define input        parameter i-db-num          as integer       no-undo.
      944      define input        parameter i-host-code       as integer       no-undo.
      945      define input-output parameter p-rid-list        as character     no-undo .
      946   run ref/thobjs.p
      947           ( input parparentproc
      948            ,input  this-procedure :handle
      949           , input i-bttns
      950           , input i-list-mode
      951           , input i-obj-type
      952           , input i-db-num
      953           , input i-host-code
      954           , input-output p-rid-list ) no-error .
