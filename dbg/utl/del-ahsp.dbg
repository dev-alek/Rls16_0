      973   define stream slog .
      974   define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
      975   define variable v-obj-type        like ub.gds-obj.obj-type no-undo .
      976   define variable v-obj-code        like ub.gds-obj.obj-code no-undo .
      977   define variable v-clear-archive   as logical   no-undo .
      978   define variable v-new-start-date  as date      no-undo .
      979   define variable v-new-detail-date as date      no-undo .
      980   define variable v-file-name       as character no-undo .
      981   define variable v-today           as date      no-undo .
      982   define variable v-ok              as logical   no-undo .
      983   do
      984   on error undo, return error
      985   :
      986     define variable v-user-select as logical   no-undo .
      987   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988     run mainmenu_getcntxt in parparentproc
      989       (output v-cntxt-db-num
      990       ,output v-cntxt-userid
      991       ,output v-cntxt-level
      992       ,output v-cntxt-host-code-obj
      993       ,output v-cntxt-obj-type
      994       ,output v-cntxt-obj-code
      995       ,output v-cntxt-db-num-obj
      996       ,output v-cntxt-is-admin
      997       ) .
      998   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      999   run userobjs_select-one in this-procedure
     1000     (input  parparentproc
     1001     ,input  v-cntxt-db-num
     1002     ,input  v-cntxt-userid
     1003     ,input  v-cntxt-host-code-obj
     1004     ,input  v-cntxt-obj-type
     1005     ,input  v-cntxt-obj-code
     1006     ,output v-user-select
     1007     ,output v-obj-type
     1008     ,output v-obj-code
     1009     )  .
     1010     if v-user-select <> true
     1011     then do:
     1012       message
     1013         "Объект не выбран"
     1014         view-as alert-box information .
     1015       return .
     1016     end.
     1017     define buffer restore-ahsp-lock_batchprocess for ub.batchprocess .
     1018     run gbl/lock-prc.p
     1019       (input 'rsas':U
     1020       ,input v-obj-code
     1021       ,input 0
     1022       ,input 0
     1023       ,input v-obj-type
     1024       ,input ""
     1025       ,input ""
     1026       ,input "Объект,,, ,,,Восстановление складского архива по товарам"
     1027       ,input true
     1028       ,buffer restore-ahsp-lock_batchprocess
     1029       ) no-error .
     1030     if error-status :error
     1031     then do:
     1032       if error-status :get-message(1) <> ""
     1033       then do:
     1034         message
     1035           vss-workfile vss-revision vss-description skip
     1036           "В данный момент восстанавливается складской архив по поставщикам" skip
     1037           "Невозможно произвести восстановление складского архива по поставщикам" skip
     1038           view-as alert-box error .
     1039       end.
     1040       undo, return error "В данный момент восстанавливается складской архив по поставщикам" .
     1041     end.
     1042     run gbl/lock-prc.p
     1043       (input 'ahsp':U
     1044       ,input v-obj-code
     1045       ,input 0
     1046       ,input 0
     1047       ,input v-obj-type
     1048       ,input ""
     1049       ,input ""
     1050       ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
     1051       ,input true
     1052       ,buffer calc-supp-arh-lock_batchprocess
     1053       ) no-error .
     1054     if error-status :error
     1055     then do:
     1056       if error-status :get-message(1) <> ""
     1057       then do:
     1058         message
     1059           vss-workfile vss-revision vss-description skip
     1060           "В данный момент рассчитывается складской архив по поставщикам" skip
     1061           "Невозможно произвести удаление складского архива по поставщикам" skip
     1062           view-as alert-box error .
     1063       end.
     1064       undo, return error "В данный момент рассчитывается складской архив по поставщикам" .
     1065     end.
     1066     define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1067     run gbl/lockrngd.p
     1068       (input  'grar':U
     1069       ,input  'disable':U
     1070       ,buffer buf_lock_gdsrenart_batchprocess
     1071       ) no-error .
     1072     if error-status :error
     1073     then do:
     1074       if error-status :get-message(1) <> ""
     1075       then do:
     1076         message
     1077           vss-workfile vss-revision vss-description skip
     1078           "Ошибка при блокировании функции переименования артикула товара" skip
     1079           error-status :get-message(1) skip
     1080           return-value skip
     1081           view-as alert-box error .
     1082       end.
     1083       undo, return error return-value .
     1084     end.
     1085     define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1086     run gbl/lockrngd.p
     1087       (input  'grgc':U
     1088       ,input  'disable':U
     1089       ,buffer buf_lock_gdsrengc_batchprocess
     1090       ) no-error .
     1091     if error-status :error
     1092     then do:
     1093       if error-status :get-message(1) <> ""
     1094       then do:
     1095         message
     1096           vss-workfile vss-revision vss-description skip
     1097           "Ошибка при блокировании функции переименования кода товара" skip
     1098           error-status :get-message(1) skip
     1099           return-value skip
     1100           view-as alert-box error .
     1101       end.
     1102       undo, return error return-value .
     1103     end.
     1104   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1106     (input  v-obj-type
     1107     ,input  v-obj-code
     1108     ,output v-today
     1109     )  .
     1110     define variable v-attr-value as character no-undo .
     1111     define variable v-attr-type  as character no-undo .
     1112     define variable v-ahsp-calc          as logical   no-undo .
     1113     define variable v-ahsp-del           as logical   no-undo .
     1114     define variable v-ahsp-start-date    as date      no-undo .
     1115     define variable v-ahsp-detail-date   as date      no-undo .
     1116     define variable v-ahsp-recalc-date   as date      no-undo .
     1117     run clntattr-value in this-procedure
     1118       (input  v-obj-type
     1119       ,input  v-obj-code
     1120       ,input  'ahsp-calc':U
     1121       ,output v-attr-value
     1122       ,output v-attr-type
     1123       ) .
     1124     assign
     1125       v-ahsp-calc = (lookup(v-attr-value, 'yes,true') > 0)
     1126     .
     1127     run clntattr-value in this-procedure
     1128       (input  v-obj-type
     1129       ,input  v-obj-code
     1130       ,input  'ahsp-del':U
     1131       ,output v-attr-value
     1132       ,output v-attr-type
     1133       ) .
     1134     assign
     1135       v-ahsp-del = (lookup(v-attr-value, 'yes,true') > 0)
     1136     .
     1137     run clntattr-value in this-procedure
     1138       (input  v-obj-type
     1139       ,input  v-obj-code
     1140       ,input  'ahsp-start':U
     1141       ,output v-attr-value
     1142       ,output v-attr-type
     1143       ) .
     1144     assign
     1145       v-ahsp-start-date = date(v-attr-value)
     1146     .
     1147     run clntattr-value in this-procedure
     1148       (input  v-obj-type
     1149       ,input  v-obj-code
     1150       ,input  'ahsp-detail':U
     1151       ,output v-attr-value
     1152       ,output v-attr-type
     1153       ) .
     1154     assign
     1155       v-ahsp-detail-date = date(v-attr-value)
     1156     .
     1157     run clntattr-value in this-procedure
     1158       (input  v-obj-type
     1159       ,input  v-obj-code
     1160       ,input  'ahsp-recalc':U
     1161       ,output v-attr-value
     1162       ,output v-attr-type
     1163       ) .
     1164     assign
     1165       v-ahsp-recalc-date = date(v-attr-value)
     1166     .
     1167     define variable v-month     as integer   no-undo .
     1168     define variable v-new-month as integer   no-undo .
     1169     define variable v-day       as integer   no-undo .
     1170     define variable v-year      as integer   no-undo .
     1171     assign
     1172       v-month = month(v-ahsp-detail-date)
     1173       v-year  = year(v-ahsp-detail-date)
     1174     .
     1175     assign
     1176       v-month = v-month + 1
     1177     .
     1178     if v-month > 12
     1179     then do:
     1180       assign
     1181         v-month = 1
     1182         v-year  = v-year + 1
     1183       .
     1184     end.
     1185     run gbl/d-inpmnt.w
     1186       (input        "Введите месяц и год"
     1187       ,input        ?
     1188       ,input-output v-month
     1189       ,input-output v-year
     1190       ,output       v-ok
     1191       ).
     1192     if v-ok <> true
     1193     then do:
     1194       message
     1195         "Дата очистки складского архива по поставщикам не задана" skip
     1196         view-as alert-box information .
     1197       undo, return error .
     1198     end.
     1199     assign
     1200       v-new-detail-date = date(v-month, 1, v-year)
     1201     .
     1202     define variable v-num as integer   no-undo .
     1203     run gbl/d-askw.w
     1204       (input "Вопрос"
     1205       ,input "Выберите способ удаления складского архива по поставщикам" + chr(10)
     1206             + "Новая дата начала подробного складского архива по поставщикам " + string(v-new-detail-date, '99/99/9999':u) + chr(10)
     1207             + "Сегодня " + string(v-today, '99/99/9999':u) + chr(10)
     1208       ,input "|^"
     1209       ,input "Удаление подробной информации" + '^confirm|':u
     1210           + "Полная очистка складского архива по поставщикам" + '^confirm|':u
     1211           + "Отказ"
     1212       ,input "" + '|':u
     1213           + "" + '|':u
     1214           + ""
     1215       ,input 1
     1216       ,input 3
     1217       ,output v-num
     1218       ).
     1219     case v-num :
     1220       when 1
     1221       then do:
     1222         assign
     1223           v-clear-archive = false
     1224         .
     1225       end.
     1226       when 2
     1227       then do:
     1228         assign
     1229           v-clear-archive = true
     1230         .
     1231       end.
     1232       when 3
     1233       then do:
     1234         return .
     1235       end.
     1236       otherwise do:
     1237         message
     1238           vss-workfile vss-revision vss-description skip
     1239           "Ошибка при выборе способа очистки складского архива по поставщикам" skip
     1240           view-as alert-box error .
     1241         undo, return error .
     1242       end.
     1243     end case .
     1244     if v-ahsp-calc = true
     1245     then do:
     1246       message
     1247         "Складской архив по поставщикам" skip
     1248         "Объект" v-obj-type v-obj-code skip
     1249         "Невозможно произвести удаление складского архива" skip
     1250         "Складской архив не рассчитан" skip
     1251         view-as alert-box error .
     1252       undo, return error return-value .
     1253     end.
     1254     if v-ahsp-del = true
     1255     then do:
     1256       message
     1257         "Складской архив по поставщикам" skip
     1258         "Объект" v-obj-type v-obj-code skip
     1259         "Невозможно произвести удаление складского архива" skip
     1260         "Остатки имеют неопределенное значение" skip
     1261         "Возможные пути решения: повторная инициализация складского архива поставщикам" skip
     1262         "или восстановление складского архива из файла в случае ошибки удаления" skip
     1263         view-as alert-box error .
     1264       undo, return error return-value .
     1265     end.
     1266     if (v-ahsp-start-date <> ?
     1267        and v-ahsp-detail-date = ?)
     1268     or (v-ahsp-start-date = ?
     1269        and v-ahsp-detail-date <> ?)
     1270     then do:
     1271       message
     1272         "Складской архив по поставщикам" skip
     1273         "Объект" v-obj-type v-obj-code skip
     1274         "Невозможно произвести удаление складского архива" skip
     1275         "Противоречивая информация в датах инициализации складского архива" skip
     1276         "Дата начала складского архива по поставщикам" string(v-ahsp-start-date, '99/99/9999':u) skip
     1277         "Дата начала подробного складского архива по поставщикам" string(v-ahsp-detail-date, '99/99/9999':u) skip
     1278         view-as alert-box error .
     1279       undo, return error return-value .
     1280     end.
     1281     if  v-ahsp-recalc-date <> ?
     1282     and v-ahsp-detail-date <> ?
     1283     and v-ahsp-recalc-date < v-ahsp-detail-date
     1284     then do:
     1285       message
     1286         "Складской архив по поставщикам" skip
     1287         "Объект" v-obj-type v-obj-code skip
     1288         "Невозможно произвести удаление складского архива" skip
     1289         "Дата перерасчета складского архива по поставщикам раньше, чем начало подробного складского архива" skip
     1290         "Возможные пути решения: повторная инициализация складского архива" skip
     1291         "Дата перерасчета складского архива по поставщикам" string(v-ahsp-recalc-date, '99/99/9999':u) skip
     1292         "Дата начала подробного складского архива по поставщикам" v-ahsp-detail-date skip
     1293         view-as alert-box error .
     1294       undo, return error return-value .
     1295     end.
     1296     if v-clear-archive = true
     1297     then do:
     1298       assign
     1299         v-new-start-date = v-new-detail-date
     1300       .
     1301     end.
     1302     else do:
     1303       if v-ahsp-start-date <> ?
     1304       then do:
     1305         assign
     1306           v-new-start-date = v-ahsp-start-date
     1307         .
     1308       end.
     1309       else do:
     1310         run find-ahsp-start-date in this-procedure
     1311           (input  v-obj-type
     1312           ,input  v-obj-code
     1313           ,input  v-new-detail-date
     1314           ,output v-new-start-date
     1315           ) .
     1316       end.
     1317     end.
     1318     run trg/bt_ahsp.p
     1319       (input v-obj-type
     1320       ,input v-obj-code
     1321       ,input v-new-detail-date
     1322       ,input true
     1323       ,input v-cntxt-db-num
     1324       ,input v-cntxt-userid
     1325       ) .
     1326     assign
     1327       v-year  = year(v-new-detail-date)
     1328       v-month = month(v-new-detail-date)
     1329       v-day   = day(v-new-detail-date)
     1330     .
     1331     assign
     1332       v-file-name = 'ahspdel':u
     1333                   + '_':u
     1334                   + (if v-obj-type = 'скл':U then 'stock':u else 'shop':u)
     1335                   + '_':u
     1336                   + string(v-obj-code)
     1337                   + '_':u
     1338                   + string(v-year, '9999':u)
     1339                   + string(v-month, '99':u)
     1340                   + string(v-day, '99':u)
     1341                   + '.txt'
     1342     .
     1343     assign
     1344       v-ok = false
     1345     .
     1346     message
     1347       "ВНИМАНИЕ!" skip
     1348       "Последнее предупреждение перед удалением складского архива по поставщикам" skip
     1349       "" (if v-clear-archive = true then "ПОЛНАЯ ОЧИСТКА АРХИВОВ" else "УДАЛЕНИЕ ПОДРОБНОЙ ИНФОРМАЦИИ" ) skip
     1350       "Старая дата начала складского архива по поставщикам" string(v-ahsp-start-date, '99/99/9999':u) skip
     1351       "Старая дата начала подробного складского архива по поставщикам" string(v-ahsp-detail-date, '99/99/9999':u) skip
     1352       "" skip
     1353       "Новая дата начала складского архива по поставщикам" string(v-new-start-date, '99/99/9999':u) skip
     1354       "Новая дата начала подробного складского архива по поставщикам" string(v-new-detail-date, '99/99/9999':u) skip
     1355       "Сегодня" string(v-today, '99/99/9999':u) skip
     1356       "Удаленные данные будут сохранены в файле" v-file-name skip
     1357       "Продолжить?" skip
     1358       view-as alert-box question buttons yes-no update v-ok .
     1359     if v-ok <> true
     1360     then do:
     1361       return .
     1362     end.
     1363     define variable v-start-time     as integer   no-undo .
     1364     define variable v-current-time   as character no-undo .
     1365     define variable v-current-action as character no-undo .
     1366     define variable v-count          as integer   no-undo .
     1367     define variable v-sub-action     as character no-undo .
     1368     def frame a
     1369       v-obj-type       label "Объект"
     1370       v-obj-code       no-label skip
     1371       v-current-action format "x(40)" no-label skip
     1372       v-current-time   format "x(8)"  label "Время очистки складского архива" skip
     1373       v-count          format ">>>,>>>,>>9" no-label skip
     1374       v-sub-action     format "x(40)" no-label skip
     1375       with view-as dialog-box side-labels three-d
     1376       title "Удаление складского архива по поставщикам"
     1377       .
     1378     assign
     1379       v-start-time = time
     1380     .
     1381     view frame a .
     1382     display
     1383       v-obj-type
     1384       v-obj-code
     1385       with frame a .
     1386     define variable v-fact-order           as decimal   no-undo .
     1387     define variable v-shift-end-fact-order as decimal   no-undo .
     1388     define variable v-day-end-fact-order   as decimal   no-undo .
     1389     define variable v-archive-date         as date      no-undo .
     1390     assign
     1391       v-archive-date = v-new-detail-date - 1
     1392     .
     1393     run factord in this-procedure
     1394       (input  v-archive-date
     1395       ,input  1
     1396       ,input  1
     1397       ,input  ?
     1398       ,input  0
     1399       ,input  false
     1400       ,output v-fact-order
     1401       ,output v-shift-end-fact-order
     1402       ,output v-day-end-fact-order
     1403       ) no-error .
     1404     if error-status :error
     1405     then do:
     1406       message
     1407         vss-workfile vss-revision vss-description skip
     1408         "Ошибка при вызове процедуры factord"
     1409         error-status :get-message(1) skip
     1410         return-value skip
     1411         view-as alert-box error .
     1412       undo, return error .
     1413     end.
     1414     run create-log-file in this-procedure
     1415       (input v-obj-type
     1416       ,input v-obj-code
     1417       ,input v-ahsp-start-date
     1418       ,input v-ahsp-detail-date
     1419       ,input v-new-start-date
     1420       ,input v-new-detail-date
     1421       ,input v-file-name
     1422       ) no-error .
     1423     if error-status :error
     1424     then do:
     1425       message
     1426         vss-workfile vss-revision vss-description skip
     1427         "Ошибка при создании файла архивации" skip
     1428         "Имя файла архивации" v-file-name skip
     1429         error-status :get-message(1) skip
     1430         return-value skip
     1431         view-as alert-box error .
     1432       undo, return error .
     1433     end.
     1434     run trg/ah-clicl.p
     1435       (input v-obj-type
     1436       ,input v-obj-code
     1437       ,input 0
     1438       ,input v-day-end-fact-order
     1439       ,input v-file-name
     1440       ) no-error .
     1441     if error-status :error
     1442     then do:
     1443       message
     1444         vss-workfile vss-revision vss-description skip
     1445         "Ошибка при cохранении складского архива по поставщикам"
     1446         error-status :get-message(1) skip
     1447         return-value skip
     1448         view-as alert-box error .
     1449       undo, return error .
     1450     end.
     1451     run close-log-file in this-procedure
     1452       (input v-obj-type
     1453       ,input v-obj-code
     1454       ,input v-ahsp-start-date
     1455       ,input v-ahsp-detail-date
     1456       ,input v-new-start-date
     1457       ,input v-new-detail-date
     1458       ,input v-file-name
     1459       ) no-error .
     1460     if error-status :error
     1461     then do:
     1462       message
     1463         vss-workfile vss-revision vss-description skip
     1464         "Ошибка при закрытии файла архивации" skip
     1465         "Имя файла архивации" v-file-name skip
     1466         error-status :get-message(1) skip
     1467         return-value skip
     1468         view-as alert-box error .
     1469       undo, return error .
     1470     end.
     1471     define variable v-md5-signature as character no-undo .
     1472     run gbl/md5.p
     1473       (input  v-file-name
     1474       ,output v-md5-signature
     1475       ) .
     1476     define variable v-create-chip-num as integer   no-undo .
     1477     define variable v-action-type     as character no-undo .
     1478     if v-clear-archive = true
     1479     then do:
     1480       assign
     1481         v-action-type = 'delall-start':U
     1482       .
     1483     end.
     1484     else do:
     1485       assign
     1486         v-action-type = 'deldet-start':U
     1487       .
     1488     end.
     1489     run utl/arhiscr.p
     1490       (input  v-obj-type
     1491       ,input  v-obj-code
     1492       ,input  'ahsp':U
     1493       ,input  v-action-type
     1494       ,input  v-file-name
     1495       ,input  v-md5-signature
     1496       ,input  0
     1497       ,input  ""
     1498       ,input  ""
     1499       ,input  v-new-detail-date
     1500       ,output v-create-chip-num
     1501       ) .
     1502     define buffer lock_shift-obj for ub.shift-obj .
     1503     run factord-lock-shift in this-procedure
     1504       (input  v-obj-type
     1505       ,input  v-obj-code
     1506       ,input  v-archive-date
     1507       ,buffer lock_shift-obj
     1508       ) no-error .
     1509     if error-status :error
     1510     then do:
     1511      define variable v-err as character no-undo .
     1512      v-err = substitute("Ошибка при блокировке смены на объекте &2&3 дата &1" , v-archive-date, v-obj-type , v-obj-code  ) .
     1513      run create-log-err in this-procedure (
     1514           v-obj-type,
     1515           v-obj-code,
     1516           v-file-name ,
     1517           v-err  ).
     1518       undo, return error v-err .
     1519     end.
     1520     run ahrstutl-init in this-procedure
     1521       (input v-obj-type
     1522       ,input v-obj-code
     1523       ,input v-archive-date
     1524       ) .
     1525     run ahrstutl-store in this-procedure
     1526       (input v-obj-type
     1527       ,input v-obj-code
     1528       ,input v-archive-date
     1529       ) .
     1530     do transaction
     1531     on error undo, return error return-value
     1532     :
     1533       run clntattr-write in this-procedure
     1534         (input v-obj-type
     1535         ,input v-obj-code
     1536         ,input 'ahsp-start':U
     1537         ,input string(v-new-start-date, '99/99/9999':u)
     1538         ) no-error .
     1539       if error-status :error
     1540       then do:
     1541         message
     1542           vss-workfile vss-revision vss-description skip
     1543           "Ошибка при записи даты инициализации складского архива" skip
     1544           error-status :get-message(1) skip
     1545           return-value skip
     1546           view-as alert-box error .
     1547         undo, return error .
     1548       end.
     1549       run clntattr-write in this-procedure
     1550         (input v-obj-type
     1551         ,input v-obj-code
     1552         ,input 'ahsp-detail':U
     1553         ,input string(v-new-detail-date, '99/99/9999':u)
     1554         ) no-error .
     1555       if error-status :error
     1556       then do:
     1557         message
     1558           vss-workfile vss-revision vss-description skip
     1559           "Ошибка при записи даты инициализации складского архива" skip
     1560           error-status :get-message(1) skip
     1561           return-value skip
     1562           view-as alert-box error .
     1563         undo, return error .
     1564       end.
     1565       run clntattr-write in this-procedure
     1566         (input v-obj-type
     1567         ,input v-obj-code
     1568         ,input 'ahsp-rest':U
     1569         ,input 'true':u
     1570         ) .
     1571     end.
     1572     find current calc-supp-arh-lock_batchprocess no-lock .
     1573     if v-clear-archive = true
     1574     then do:
     1575       run ahrstutl-clear-ahsp in this-procedure
     1576         (input  v-obj-type
     1577         ,input  v-obj-code
     1578         ,input  v-archive-date
     1579         ) .
     1580     end.
     1581     else do:
     1582       run utl/cmprahsp.p
     1583         (input v-obj-type
     1584         ,input v-obj-code
     1585         ,input 0
     1586         ,input v-day-end-fact-order
     1587         )  no-error .
     1588       if error-status :error
     1589       then do:
     1590         message
     1591           vss-workfile vss-revision vss-description skip
     1592           "Ошибка при удалении подробного складского архива по поставщикам" skip
     1593           error-status :get-message(1) skip
     1594           return-value skip
     1595           view-as alert-box error .
     1596         undo, return error .
     1597       end.
     1598     end.
     1599     define variable v-delete-attr-ahsp-del as logical   no-undo .
     1600     run clntattr-delete in this-procedure
     1601       (input v-obj-type
     1602       ,input v-obj-code
     1603       ,input 'ahsp-rest':U
     1604       ,output v-delete-attr-ahsp-del
     1605       ) .
     1606     if v-clear-archive = true
     1607     then do:
     1608       assign
     1609         v-action-type = 'delall-stop':U
     1610       .
     1611     end.
     1612     else do:
     1613       assign
     1614         v-action-type = 'deldet-stop':U
     1615       .
     1616     end.
     1617     run utl/arhiscr.p
     1618       (input  v-obj-type
     1619       ,input  v-obj-code
     1620       ,input  'ahsp':U
     1621       ,input  v-action-type
     1622       ,input  ""
     1623       ,input  ""
     1624       ,input  0
     1625       ,input  ""
     1626       ,input  ""
     1627       ,input  v-new-detail-date
     1628       ,output v-create-chip-num
     1629       ) .
     1630     message
     1631       "Удаление складского архива по поставщикам успешно закончилось" skip
     1632       "Сохраните файл" v-file-name "в надёжном месте" skip
     1633       "Затем вы можете восстановить складской архив по поставщикам на основании файла" skip
     1634       "На объекте существует складской архив по поставщикам с даты" string(v-new-start-date, '99/99/9999':u) skip
     1635       "На объекте существуют подробный складской архив по поставщикам с даты" string(v-new-detail-date, '99/99/9999':u) skip
     1636       view-as alert-box information .
     1637   end.
     1638   procedure create-log-file :
     1639     define input  parameter p-obj-type        as character no-undo .
     1640     define input  parameter p-obj-code        as integer   no-undo .
     1641     define input  parameter p-ahsp-start-date  as date      no-undo .
     1642     define input  parameter p-ahsp-detail-date as date      no-undo .
     1643     define input  parameter p-new-start-date  as date      no-undo .
     1644     define input  parameter p-new-detail-date as date      no-undo .
     1645     define input  parameter p-file-name       as character no-undo .
     1646     do
     1647     on error undo, return error
     1648     :
     1649       output stream slog to value(p-file-name) .
     1650       export stream slog 'archive-log-version':u '2.1':u .
     1651       export stream slog 'obj-type':u            p-obj-type .
     1652       export stream slog 'obj-code':u            string(p-obj-code) .
     1653       export stream slog 'old-start-date':u      string(p-ahsp-start-date, '99/99/9999':u ) .
     1654       export stream slog 'old-detail-date':u     string(p-ahsp-detail-date, '99/99/9999':u ) .
     1655       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     1656       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     1657       output stream slog close .
     1658     end.
     1659   end procedure.
     1660   procedure close-log-file :
     1661     define input  parameter p-obj-type        as character no-undo .
     1662     define input  parameter p-obj-code        as integer   no-undo .
     1663     define input  parameter p-ahsp-start-date  as date      no-undo .
     1664     define input  parameter p-ahsp-detail-date as date      no-undo .
     1665     define input  parameter p-new-start-date  as date      no-undo .
     1666     define input  parameter p-new-detail-date as date      no-undo .
     1667     define input  parameter p-file-name       as character no-undo .
     1668     do
     1669     on error undo, return error
     1670     :
     1671       output stream slog to value(p-file-name) append .
     1672       export stream slog 'end-of-log':u .
     1673       export stream slog 'archive-log-version':u '2.1':u .
     1674       export stream slog 'obj-type':u            p-obj-type .
     1675       export stream slog 'obj-code':u            string(p-obj-code) .
     1676       export stream slog 'old-start-date':u      string(p-ahsp-start-date, '99/99/9999':u ) .
     1677       export stream slog 'old-detail-date':u     string(p-ahsp-detail-date, '99/99/9999':u ) .
     1678       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     1679       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     1680       export stream slog '.':u                   .
     1681       output stream slog close .
     1682     end.
     1683   end procedure.
     1684   procedure find-ahsp-start-date :
     1685     define input  parameter p-obj-type        as character no-undo .
     1686     define input  parameter p-obj-code        as integer   no-undo .
     1687     define input  parameter p-new-detail-date as date      no-undo .
     1688     define output parameter p-new-start-date  as date      no-undo .
     1689     do
     1690     on error undo, return error return-value
     1691     :
     1692       define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     1693       find first buf_stk-supp-tot no-lock
     1694         where buf_stk-supp-tot.obj-type  = p-obj-type
     1695           and buf_stk-supp-tot.obj-code  = p-obj-code
     1696         use-index fact-order
     1697         no-error .
     1698       if  available buf_stk-supp-tot
     1699       and buf_stk-supp-tot.fact-date <= p-new-detail-date
     1700       then do:
     1701         assign
     1702           p-new-start-date = buf_stk-supp-tot.fact-date
     1703         .
     1704       end.
     1705       else do:
     1706         assign
     1707           p-new-start-date = p-new-detail-date
     1708         .
     1709       end.
     1710     end.
     1711   end procedure.
     1712   procedure show-action :
     1713     do
     1714     on error undo, return error
     1715     :
     1716       define input parameter p-action as character no-undo .
     1717       assign
     1718         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1719         v-current-action = p-action
     1720       .
     1721       display
     1722         v-current-time
     1723         v-current-action
     1724         with frame a.
     1725     end.
     1726   end procedure.
     1727   procedure show-count :
     1728     define input  parameter p-count      as integer   no-undo .
     1729     define input  parameter p-sub-action as character no-undo .
     1730     do
     1731     on error undo, return error
     1732     :
     1733       assign
     1734         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1735         v-count        = p-count
     1736         v-sub-action   = p-sub-action
     1737       .
     1738       display
     1739         v-current-time
     1740         v-count
     1741         v-sub-action
     1742         with frame a.
     1743     end.
     1744   end procedure.
     1745   procedure temp-supp-create :
     1746     define input  parameter p-cli-type                  like ub.stk-supp-line.cli-type  no-undo .
     1747     define input  parameter p-cli-code                  like ub.stk-supp-line.cli-code  no-undo .
     1748     define buffer buf_temp-supp for temp-supp .
     1749     do
     1750     on error undo, return error return-value
     1751     :
     1752       find first buf_temp-supp
     1753         where buf_temp-supp.cli-type  = p-cli-type
     1754           and buf_temp-supp.cli-code  = p-cli-code
     1755         no-error .
     1756       if not available buf_temp-supp then do:
     1757         create buf_temp-supp .
     1758         assign
     1759           buf_temp-supp.cli-type  = p-cli-type
     1760           buf_temp-supp.cli-code  = p-cli-code
     1761         .
     1762       end.
     1763     end.
     1764   end procedure.
     1765   procedure temp-supp-fill :
     1766     define input  parameter p-obj-type   as character no-undo .
     1767     define input  parameter p-obj-code   as integer   no-undo .
     1768     define input  parameter p-fact-order as decimal   no-undo .
     1769     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     1770     do
     1771     on error undo, return error return-value
     1772     :
     1773       for each buf_stk-supp-tot no-lock
     1774         where buf_stk-supp-tot.obj-type   = p-obj-type
     1775           and buf_stk-supp-tot.obj-code   = p-obj-code
     1776           and buf_stk-supp-tot.fact-order <= p-fact-order
     1777       on error undo, return error
     1778       :
     1779         run temp-supp-create in this-procedure
     1780           (input buf_stk-supp-tot.cli-type
     1781           ,input buf_stk-supp-tot.cli-code
     1782           ) .
     1783       end.
     1784     end.
     1785   end procedure.
     1786   procedure temp-supp-gds-create :
     1787     define input  parameter p-cli-type                  like ub.stk-supp-line.cli-type  no-undo .
     1788     define input  parameter p-cli-code                  like ub.stk-supp-line.cli-code  no-undo .
     1789     define input  parameter p-artic                     like ub.stk-supp-line.artic     no-undo .
     1790     define input  parameter p-prod-type                 like ub.stk-supp-line.prod-type no-undo .
     1791     define input  parameter p-prod-code                 like ub.stk-supp-line.prod-code no-undo .
     1792     define buffer buf_temp-supp-gds for temp-supp-gds .
     1793     do
     1794     on error undo, return error return-value
     1795     :
     1796       find first buf_temp-supp-gds
     1797         where buf_temp-supp-gds.cli-type  = p-cli-type
     1798           and buf_temp-supp-gds.cli-code  = p-cli-code
     1799           and buf_temp-supp-gds.artic     = p-artic
     1800           and buf_temp-supp-gds.prod-type = p-prod-type
     1801           and buf_temp-supp-gds.prod-code = p-prod-code
     1802         no-error .
     1803       if not available buf_temp-supp-gds then do:
     1804         create buf_temp-supp-gds .
     1805         assign
     1806           buf_temp-supp-gds.cli-type  = p-cli-type
     1807           buf_temp-supp-gds.cli-code  = p-cli-code
     1808           buf_temp-supp-gds.artic     = p-artic
     1809           buf_temp-supp-gds.prod-type = p-prod-type
     1810           buf_temp-supp-gds.prod-code = p-prod-code
     1811         .
     1812       end.
     1813     end.
     1814   end procedure.
     1815   procedure temp-supp-gds-fill :
     1816     define input  parameter p-obj-type   as character no-undo .
     1817     define input  parameter p-obj-code   as integer   no-undo .
     1818     define input  parameter p-fact-order as decimal   no-undo .
     1819     define buffer buf_stk-supp-line for ub.stk-supp-line .
     1820     do
     1821     on error undo, return error return-value
     1822     :
     1823       for each buf_stk-supp-line no-lock
     1824         where buf_stk-supp-line.obj-type   = p-obj-type
     1825           and buf_stk-supp-line.obj-code   = p-obj-code
     1826           and buf_stk-supp-line.fact-order <= p-fact-order
     1827       on error undo, return error
     1828       :
     1829         run temp-supp-gds-create in this-procedure
     1830           (input buf_stk-supp-line.cli-type
     1831           ,input buf_stk-supp-line.cli-code
     1832           ,input buf_stk-supp-line.artic
     1833           ,input buf_stk-supp-line.prod-type
     1834           ,input buf_stk-supp-line.prod-code
     1835           ) .
     1836       end.
     1837     end.
     1838   end procedure.
     1839   procedure ahrstutl-init :
     1840     define input  parameter p-obj-type           as character no-undo .
     1841     define input  parameter p-obj-code           as integer   no-undo .
     1842     define input  parameter p-fact-date          as date      no-undo .
     1843     define buffer buf_gds-obj for ub.gds-obj .
     1844     define buffer buf_goods   for ub.goods .
     1845     define buffer buf_temp-supp for temp-supp .
     1846     define buffer buf_temp-supp-gds for temp-supp-gds .
     1847     define variable v-shift-on             as logical   no-undo .
     1848     define variable v-shift-date           as date      no-undo .
     1849     define variable v-shift-num            as integer   no-undo .
     1850     define variable v-day-end-fact-order   as decimal   no-undo .
     1851     define variable v-shift-end-fact-order as decimal   no-undo .
     1852     define variable v-sum-type-list as character no-undo .
     1853     do
     1854     on error undo, return error
     1855     :
     1856       run factord-cut-archive in this-procedure
     1857         (input  p-obj-type
     1858         ,input  p-obj-code
     1859         ,input  p-fact-date
     1860         ,output v-shift-on
     1861         ,output v-shift-date
     1862         ,output v-shift-num
     1863         ,output v-day-end-fact-order
     1864         ,output v-shift-end-fact-order
     1865         ) .
     1866       define variable v-ind as integer   no-undo .
     1867       run show-action in this-procedure
     1868         (input "Остаток по поставщикам. Анализ"
     1869         ).
     1870       run temp-supp-fill in this-procedure
     1871         (input p-obj-type
     1872         ,input p-obj-code
     1873         ,input v-day-end-fact-order
     1874         ) .
     1875       run ahrstutl-supp-tot-sum-type-list in this-procedure
     1876         (output v-sum-type-list
     1877         ) .
     1878       run show-action in this-procedure
     1879         (input "Остаток по поставщикам. Считывание"
     1880         ).
     1881       do v-ind = 1 to num-entries(v-sum-type-list)
     1882       :
     1883         for each buf_temp-supp
     1884         on error undo, return error
     1885         :
     1886           run ahrstutl-init-supp-tot in this-procedure
     1887             (input p-obj-type
     1888             ,input p-obj-code
     1889             ,input buf_temp-supp.cli-type
     1890             ,input buf_temp-supp.cli-code
     1891             ,input entry(v-ind, v-sum-type-list)
     1892             ,input p-fact-date
     1893             ,input v-day-end-fact-order
     1894             ,input v-shift-on
     1895             ,input v-shift-date
     1896             ,input v-shift-num
     1897             ,input v-shift-end-fact-order
     1898             ) .
     1899         end.
     1900       end.
     1901       run show-action in this-procedure
     1902         (input "Остаток по поставщикам и товарам. Анализ"
     1903         ).
     1904       run ahrstutl-supp-line-sum-type-list in this-procedure
     1905         (output v-sum-type-list
     1906         ) .
     1907       run temp-supp-gds-fill in this-procedure
     1908         (input p-obj-type
     1909         ,input p-obj-code
     1910         ,input v-day-end-fact-order
     1911         ) .
     1912       run show-action in this-procedure
     1913         (input "Остаток по поставщикам и товарам. Считывание"
     1914         ).
     1915       define variable v-total-count as integer   no-undo .
     1916       for each buf_temp-supp-gds
     1917       on error undo, return error
     1918       :
     1919         assign
     1920           v-total-count = v-total-count + 1
     1921         .
     1922         if v-total-count mod 10 = 0 then do:
     1923           run show-count in this-procedure
     1924             (input v-total-count
     1925             ,input "Артикул " + string(buf_temp-supp-gds.artic)
     1926             ).
     1927         end.
     1928         do v-ind = 1 to num-entries(v-sum-type-list)
     1929         :
     1930           run ahrstutl-init-supp-line in this-procedure
     1931             (input p-obj-type
     1932             ,input p-obj-code
     1933             ,input buf_temp-supp-gds.cli-type
     1934             ,input buf_temp-supp-gds.cli-code
     1935             ,input buf_temp-supp-gds.artic
     1936             ,input buf_temp-supp-gds.prod-type
     1937             ,input buf_temp-supp-gds.prod-code
     1938             ,input entry(v-ind, v-sum-type-list)
     1939             ,input p-fact-date
     1940             ,input v-day-end-fact-order
     1941             ,input v-shift-on
     1942             ,input v-shift-date
     1943             ,input v-shift-num
     1944             ,input v-shift-end-fact-order
     1945             ) .
     1946         end.
     1947       end.
     1948     end.
     1949   end procedure.
     1950   procedure ahrstutl-init-supp-tot :
     1951     define input  parameter p-obj-type                      as character no-undo .
     1952     define input  parameter p-obj-code                      as integer   no-undo .
     1953     define input  parameter p-cli-type                      as character no-undo .
     1954     define input  parameter p-cli-code                      as integer   no-undo .
     1955     define input  parameter p-root-sum-type                 as character no-undo .
     1956     define input  parameter p-fact-date                     as date      no-undo .
     1957     define input  parameter p-stk-supp-tot-fact-order       as decimal   no-undo .
     1958     define input  parameter p-shift-on                      as logical   no-undo .
     1959     define input  parameter p-shift-date                    as date      no-undo .
     1960     define input  parameter p-shift-num                     as integer   no-undo .
     1961     define input  parameter p-shift-stk-supp-tot-fact-order as decimal   no-undo .
     1962     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     1963     define buffer buf_shift-stk-supp-tot for ub.stk-supp-tot .
     1964     define buffer buf_temp-stk-supp-tot for temp-stk-supp-tot .
     1965     define buffer buf_temp-shift-stk-supp-tot for temp-shift-stk-supp-tot .
     1966     define variable v-prev-stk-supp-tot-fact-order as decimal   no-undo .
     1967     define variable v-prev-shift-stk-supp-tot-f-o  as decimal   no-undo .
     1968     do
     1969     on error undo, return error return-value
     1970     :
     1971       find last buf_stk-supp-tot no-lock
     1972         where buf_stk-supp-tot.obj-type   = p-obj-type
     1973           and buf_stk-supp-tot.obj-code   = p-obj-code
     1974           and buf_stk-supp-tot.cli-type   = p-cli-type
     1975           and buf_stk-supp-tot.cli-code   = p-cli-code
     1976           and buf_stk-supp-tot.sum-type   = p-root-sum-type
     1977           and buf_stk-supp-tot.cat-id     = '##,##':U
     1978           and buf_stk-supp-tot.fact-order <= p-stk-supp-tot-fact-order
     1979         use-index category
     1980         no-error .
     1981       if available buf_stk-supp-tot
     1982       and buf_stk-supp-tot.fact-order <> p-stk-supp-tot-fact-order
     1983       then do:
     1984         assign
     1985           v-prev-stk-supp-tot-fact-order = buf_stk-supp-tot.fact-order
     1986         .
     1987         for each buf_stk-supp-tot no-lock
     1988           where buf_stk-supp-tot.obj-type   = p-obj-type
     1989             and buf_stk-supp-tot.obj-code   = p-obj-code
     1990             and buf_stk-supp-tot.cli-type   = p-cli-type
     1991             and buf_stk-supp-tot.cli-code   = p-cli-code
     1992             and buf_stk-supp-tot.fact-order = v-prev-stk-supp-tot-fact-order
     1993             and buf_stk-supp-tot.sum-type   begins p-root-sum-type
     1994         on error undo, return error
     1995         :
     1996           find first buf_temp-stk-supp-tot
     1997             where buf_temp-stk-supp-tot.obj-type   = buf_stk-supp-tot.obj-type
     1998               and buf_temp-stk-supp-tot.obj-code   = buf_stk-supp-tot.obj-code
     1999               and buf_temp-stk-supp-tot.cli-type   = buf_stk-supp-tot.cli-type
     2000               and buf_temp-stk-supp-tot.cli-code   = buf_stk-supp-tot.cli-code
     2001               and buf_temp-stk-supp-tot.fact-order = p-stk-supp-tot-fact-order
     2002               and buf_temp-stk-supp-tot.sum-type   = buf_stk-supp-tot.sum-type
     2003               and buf_temp-stk-supp-tot.cat-id     = buf_stk-supp-tot.cat-id
     2004             no-error .
     2005           if not available buf_temp-stk-supp-tot then do:
     2006             create buf_temp-stk-supp-tot .
     2007             assign
     2008                                       buf_temp-stk-supp-tot.obj-type     = buf_stk-supp-tot.obj-type     buf_temp-stk-supp-tot.obj-code     = buf_stk-supp-tot.obj-code     buf_temp-stk-supp-tot.cli-type     = buf_stk-supp-tot.cli-type     buf_temp-stk-supp-tot.cli-code     = buf_stk-supp-tot.cli-code     buf_temp-stk-supp-tot.fact-order   = buf_stk-supp-tot.fact-order   buf_temp-stk-supp-tot.sum-type     = buf_stk-supp-tot.sum-type     buf_temp-stk-supp-tot.cat-id       = buf_stk-supp-tot.cat-id       buf_temp-stk-supp-tot.fact-date    = buf_stk-supp-tot.fact-date    buf_temp-stk-supp-tot.shift-num    = buf_stk-supp-tot.shift-num    buf_temp-stk-supp-tot.shift-date   = buf_stk-supp-tot.shift-date
     2009               buf_temp-stk-supp-tot.fact-order = p-stk-supp-tot-fact-order
     2010               buf_temp-stk-supp-tot.fact-date  = p-fact-date
     2011               buf_temp-stk-supp-tot.shift-num  = 0
     2012               buf_temp-stk-supp-tot.shift-date = ?
     2013             .
     2014           end.
     2015           assign
     2016                                                                         buf_temp-stk-supp-tot.fact-qnty      = buf_stk-supp-tot.fact-qnty            buf_temp-stk-supp-tot.sum-base       = buf_stk-supp-tot.sum-base             buf_temp-stk-supp-tot.sum-rubl       = buf_stk-supp-tot.sum-rubl             buf_temp-stk-supp-tot.vat-base       = buf_stk-supp-tot.vat-base             buf_temp-stk-supp-tot.vat-rubl       = buf_stk-supp-tot.vat-rubl             buf_temp-stk-supp-tot.slt-base       = buf_stk-supp-tot.slt-base             buf_temp-stk-supp-tot.slt-rubl       = buf_stk-supp-tot.slt-rubl             buf_temp-stk-supp-tot.road-tax-base  = buf_stk-supp-tot.road-tax-base        buf_temp-stk-supp-tot.road-tax-rubl  = buf_stk-supp-tot.road-tax-rubl        buf_temp-stk-supp-tot.excise-base    = buf_stk-supp-tot.excise-base          buf_temp-stk-supp-tot.excise-rubl    = buf_stk-supp-tot.excise-rubl          buf_temp-stk-supp-tot.transport-base = buf_stk-supp-tot.transport-base       buf_temp-stk-supp-tot.transport-rubl = buf_stk-supp-tot.transport-rubl       buf_temp-stk-supp-tot.other-base     = buf_stk-supp-tot.other-base           buf_temp-stk-supp-tot.other-rubl     = buf_stk-supp-tot.other-rubl
     2017           .
     2018         end.
     2019       end.
     2020       if p-shift-on then do:
     2021         find last buf_shift-stk-supp-tot no-lock
     2022           where buf_shift-stk-supp-tot.obj-type   = p-obj-type
     2023             and buf_shift-stk-supp-tot.obj-code   = p-obj-code
     2024             and buf_shift-stk-supp-tot.cli-type   = p-cli-type
     2025             and buf_shift-stk-supp-tot.cli-code   = p-cli-code
     2026             and buf_shift-stk-supp-tot.sum-type   = p-root-sum-type
     2027             and buf_shift-stk-supp-tot.cat-id     = '##,##':U
     2028             and buf_shift-stk-supp-tot.fact-order <= p-shift-stk-supp-tot-fact-order
     2029             and buf_shift-stk-supp-tot.shift-date <> ?
     2030           use-index category
     2031           no-error .
     2032         if available buf_shift-stk-supp-tot
     2033         and buf_shift-stk-supp-tot.fact-order <> p-shift-stk-supp-tot-fact-order
     2034         then do:
     2035           assign
     2036             v-prev-shift-stk-supp-tot-f-o = buf_shift-stk-supp-tot.fact-order
     2037           .
     2038           for each buf_shift-stk-supp-tot no-lock
     2039             where buf_shift-stk-supp-tot.obj-type   = p-obj-type
     2040               and buf_shift-stk-supp-tot.obj-code   = p-obj-code
     2041               and buf_shift-stk-supp-tot.cli-type   = p-cli-type
     2042               and buf_shift-stk-supp-tot.cli-code   = p-cli-code
     2043               and buf_shift-stk-supp-tot.fact-order = v-prev-shift-stk-supp-tot-f-o
     2044               and buf_shift-stk-supp-tot.sum-type   begins p-root-sum-type
     2045           on error undo, return error
     2046           :
     2047             find first buf_temp-shift-stk-supp-tot
     2048               where buf_temp-shift-stk-supp-tot.obj-type   = buf_shift-stk-supp-tot.obj-type
     2049                 and buf_temp-shift-stk-supp-tot.obj-code   = buf_shift-stk-supp-tot.obj-code
     2050                 and buf_temp-shift-stk-supp-tot.cli-type   = buf_shift-stk-supp-tot.cli-type
     2051                 and buf_temp-shift-stk-supp-tot.cli-code   = buf_shift-stk-supp-tot.cli-code
     2052                 and buf_temp-shift-stk-supp-tot.fact-order = p-shift-stk-supp-tot-fact-order
     2053                 and buf_temp-shift-stk-supp-tot.sum-type   = buf_shift-stk-supp-tot.sum-type
     2054                 and buf_temp-shift-stk-supp-tot.cat-id     = buf_shift-stk-supp-tot.cat-id
     2055               no-error .
     2056             if not available buf_temp-shift-stk-supp-tot then do:
     2057               create buf_temp-shift-stk-supp-tot .
     2058               assign
     2059                                             buf_temp-shift-stk-supp-tot.obj-type     = buf_shift-stk-supp-tot.obj-type     buf_temp-shift-stk-supp-tot.obj-code     = buf_shift-stk-supp-tot.obj-code     buf_temp-shift-stk-supp-tot.cli-type     = buf_shift-stk-supp-tot.cli-type     buf_temp-shift-stk-supp-tot.cli-code     = buf_shift-stk-supp-tot.cli-code     buf_temp-shift-stk-supp-tot.fact-order   = buf_shift-stk-supp-tot.fact-order   buf_temp-shift-stk-supp-tot.sum-type     = buf_shift-stk-supp-tot.sum-type     buf_temp-shift-stk-supp-tot.cat-id       = buf_shift-stk-supp-tot.cat-id       buf_temp-shift-stk-supp-tot.fact-date    = buf_shift-stk-supp-tot.fact-date    buf_temp-shift-stk-supp-tot.shift-num    = buf_shift-stk-supp-tot.shift-num    buf_temp-shift-stk-supp-tot.shift-date   = buf_shift-stk-supp-tot.shift-date
     2060                 buf_temp-shift-stk-supp-tot.fact-order = p-shift-stk-supp-tot-fact-order
     2061                 buf_temp-shift-stk-supp-tot.fact-date  = p-fact-date
     2062                 buf_temp-shift-stk-supp-tot.shift-date = p-shift-date
     2063                 buf_temp-shift-stk-supp-tot.shift-num  = p-shift-num
     2064               .
     2065             end.
     2066             assign
     2067                                                                                       buf_temp-shift-stk-supp-tot.fact-qnty      = buf_shift-stk-supp-tot.fact-qnty            buf_temp-shift-stk-supp-tot.sum-base       = buf_shift-stk-supp-tot.sum-base             buf_temp-shift-stk-supp-tot.sum-rubl       = buf_shift-stk-supp-tot.sum-rubl             buf_temp-shift-stk-supp-tot.vat-base       = buf_shift-stk-supp-tot.vat-base             buf_temp-shift-stk-supp-tot.vat-rubl       = buf_shift-stk-supp-tot.vat-rubl             buf_temp-shift-stk-supp-tot.slt-base       = buf_shift-stk-supp-tot.slt-base             buf_temp-shift-stk-supp-tot.slt-rubl       = buf_shift-stk-supp-tot.slt-rubl             buf_temp-shift-stk-supp-tot.road-tax-base  = buf_shift-stk-supp-tot.road-tax-base        buf_temp-shift-stk-supp-tot.road-tax-rubl  = buf_shift-stk-supp-tot.road-tax-rubl        buf_temp-shift-stk-supp-tot.excise-base    = buf_shift-stk-supp-tot.excise-base          buf_temp-shift-stk-supp-tot.excise-rubl    = buf_shift-stk-supp-tot.excise-rubl          buf_temp-shift-stk-supp-tot.transport-base = buf_shift-stk-supp-tot.transport-base       buf_temp-shift-stk-supp-tot.transport-rubl = buf_shift-stk-supp-tot.transport-rubl       buf_temp-shift-stk-supp-tot.other-base     = buf_shift-stk-supp-tot.other-base           buf_temp-shift-stk-supp-tot.other-rubl     = buf_shift-stk-supp-tot.other-rubl
     2068             .
     2069           end.
     2070         end.
     2071       end.
     2072     end.
     2073   end procedure.
     2074   procedure ahrstutl-init-supp-line :
     2075     define input  parameter p-obj-type                  like ub.stk-supp-line.obj-type  no-undo .
     2076     define input  parameter p-obj-code                  like ub.stk-supp-line.obj-code  no-undo .
     2077     define input  parameter p-cli-type                  like ub.stk-supp-line.cli-type  no-undo .
     2078     define input  parameter p-cli-code                  like ub.stk-supp-line.cli-code  no-undo .
     2079     define input  parameter p-artic                     like ub.stk-supp-line.artic     no-undo .
     2080     define input  parameter p-prod-type                 like ub.stk-supp-line.prod-type no-undo .
     2081     define input  parameter p-prod-code                 like ub.stk-supp-line.prod-code no-undo .
     2082     define input  parameter p-root-sum-type             as character no-undo .
     2083     define input  parameter p-fact-date                 as date      no-undo .
     2084     define input  parameter p-stk-supp-line-fact-order       as decimal   no-undo .
     2085     define input  parameter p-shift-on                  as logical   no-undo .
     2086     define input  parameter p-shift-date                as date      no-undo .
     2087     define input  parameter p-shift-num                 as integer   no-undo .
     2088     define input  parameter p-shift-stk-supp-line-fact-order as decimal   no-undo .
     2089     define buffer buf_stk-supp-line for ub.stk-supp-line .
     2090     define buffer buf_shift-stk-supp-line for ub.stk-supp-line .
     2091     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     2092     define buffer buf_temp-shift-stk-supp-line for temp-shift-stk-supp-line .
     2093     define variable v-prev-stk-supp-line-fact-order as decimal   no-undo .
     2094     define variable v-prev-shift-stk-supp-line-f-o  as decimal   no-undo .
     2095     do
     2096     on error undo, return error return-value
     2097     :
     2098       find last buf_stk-supp-line no-lock
     2099         where buf_stk-supp-line.obj-type   = p-obj-type
     2100           and buf_stk-supp-line.obj-code   = p-obj-code
     2101           and buf_stk-supp-line.cli-type   = p-cli-type
     2102           and buf_stk-supp-line.cli-code   = p-cli-code
     2103           and buf_stk-supp-line.artic      = p-artic
     2104           and buf_stk-supp-line.prod-type  = p-prod-type
     2105           and buf_stk-supp-line.prod-code  = p-prod-code
     2106           and buf_stk-supp-line.sum-type   = p-root-sum-type
     2107           and buf_stk-supp-line.fact-order <= p-stk-supp-line-fact-order
     2108         use-index category
     2109         no-error .
     2110       if available buf_stk-supp-line
     2111       and buf_stk-supp-line.fact-order <> p-stk-supp-line-fact-order
     2112       then do:
     2113         assign
     2114           v-prev-stk-supp-line-fact-order = buf_stk-supp-line.fact-order
     2115         .
     2116         for each buf_stk-supp-line no-lock
     2117           where buf_stk-supp-line.obj-type   = p-obj-type
     2118             and buf_stk-supp-line.obj-code   = p-obj-code
     2119             and buf_stk-supp-line.cli-type   = p-cli-type
     2120             and buf_stk-supp-line.cli-code   = p-cli-code
     2121             and buf_stk-supp-line.artic      = p-artic
     2122             and buf_stk-supp-line.prod-type  = p-prod-type
     2123             and buf_stk-supp-line.prod-code  = p-prod-code
     2124             and buf_stk-supp-line.fact-order = v-prev-stk-supp-line-fact-order
     2125             and buf_stk-supp-line.sum-type   begins p-root-sum-type
     2126         on error undo, return error
     2127         :
     2128           find first buf_temp-stk-supp-line
     2129             where buf_temp-stk-supp-line.obj-type   = buf_stk-supp-line.obj-type
     2130               and buf_temp-stk-supp-line.obj-code   = buf_stk-supp-line.obj-code
     2131               and buf_temp-stk-supp-line.cli-type   = buf_stk-supp-line.cli-type
     2132               and buf_temp-stk-supp-line.cli-code   = buf_stk-supp-line.cli-code
     2133               and buf_temp-stk-supp-line.artic      = buf_stk-supp-line.artic
     2134               and buf_temp-stk-supp-line.prod-type  = buf_stk-supp-line.prod-type
     2135               and buf_temp-stk-supp-line.prod-code  = buf_stk-supp-line.prod-code
     2136               and buf_temp-stk-supp-line.fact-order = p-stk-supp-line-fact-order
     2137               and buf_temp-stk-supp-line.sum-type   = buf_stk-supp-line.sum-type
     2138               and buf_temp-stk-supp-line.cat-id     = buf_stk-supp-line.cat-id
     2139             no-error .
     2140           if not available buf_temp-stk-supp-line
     2141           then do:
     2142             create buf_temp-stk-supp-line .
     2143             assign
