        1   block-level on error undo, throw.
        2   do
        3   on error undo, return error
        4   :
        5       define buffer buf_fbr-line      for fbr-line.
        6       for each buf_fbr-line exclusive-lock
        7       on error undo, return error
        8       :
        9           if buf_fbr-line.price-sum-rubl = 0
       10           and buf_fbr-line.price-sum-base = 0
       11           then do:
       12               assign
       13                   buf_fbr-line.price-sum-rubl = buf_fbr-line.price-rubl * buf_fbr-line.fact-qnty
       14                   buf_fbr-line.price-sum-base = buf_fbr-line.price-base * buf_fbr-line.fact-qnty
       15               .
       16           end.
       17           if buf_fbr-line.price-rubl = ?
       18           then do:
       19               assign
       20                   buf_fbr-line.price-rubl = 0
       21               .
       22           end.
       23           if buf_fbr-line.price-base = ?
       24           then do:
       25               assign
       26                   buf_fbr-line.price-base = 0
       27               .
       28           end.
       29           if buf_fbr-line.price-sum-rubl = ?
       30           then do:
       31               assign
       32                   buf_fbr-line.price-sum-rubl = 0
       33               .
       34           end.
       35           if buf_fbr-line.price-sum-base = ?
       36           then do:
       37               assign
       38                   buf_fbr-line.price-sum-base = 0
       39               .
       40           end.
       41           if buf_fbr-line.price-sum-vat-rubl = ?
       42           then do:
       43               assign
       44                   buf_fbr-line.price-sum-vat-rubl = 0
       45               .
       46           end.
       47           if buf_fbr-line.price-sum-vat-base = ?
       48           then do:
       49               assign
       50                   buf_fbr-line.price-sum-vat-base = 0
       51               .
       52           end.
       53       end.
       54   end.
