      774       p-obj-code       no-label skip
      775       v-current-action format "x(40)" no-label skip
      776       v-current-time   format "x(8)"  label "Время очистки складского архива" skip
      777       v-count          format ">>>,>>>,>>9" no-label skip
      778       v-sub-action     format "x(40)" no-label skip
      779       with view-as dialog-box side-labels three-d
      780       title "Очистка складского архива по товарам"
      781       .
