      937       message
      938         vss-workfile vss-revision vss-description skip
      939         "Ошибка при вызове процедуры" 'delete-stk-line':u skip
      940         error-status :get-message(1) skip
      941         return-value skip
      942         view-as alert-box error .
      943       undo, return error return-value .
      944     end.
      945   end.
      946   procedure delete-ot-line :
      947     define buffer buf_ot-line for ot-line .
      948     do
      949     on error undo, return error return-value
      950     :
      951       for each buf_ot-line
      952         where buf_ot-line.obj-type   = p-obj-type
      953           and buf_ot-line.obj-code   = p-obj-code
      954           and buf_ot-line.fact-order > p-last-fact-order
      955           and buf_ot-line.fact-order <= p-cut-fact-order
      956       on error undo, return error
      957       :
      958         assign
      959           v-ind = v-ind + 1
      960         .
      961         if v-ind modulo 10 = 0
      962         then do:
      963           run show-count in this-procedure
      964             (input v-ind
      965             ,input "Артикул " + string(buf_ot-line.artic)
      966             ).
      967         end.
      968         delete buf_ot-line .
      969       end.
      970     end.
      971   end procedure.
      972   procedure clear-temp-fact-order :
      973     do
      974     on error undo, return error
      975     :
      976       define buffer buf_temp-fact-order for temp-fact-order .
      977       for each buf_temp-fact-order
      978       on error undo, return error
      979       :
      980         delete buf_temp-fact-order .
      981       end.
      982     end.
      983   end procedure.
      984   procedure accum-temp-fact-order :
      985     define input parameter p-artic      as character no-undo .
      986     define input parameter p-prod-type  as character no-undo .
      987     define input parameter p-prod-code  as integer   no-undo .
      988     define input parameter p-sum-type   as character no-undo .
      989     define input parameter p-fact-order as decimal   no-undo .
      990     define input parameter p-fact-date  as date      no-undo .
      991     define input parameter p-shift-date as date      no-undo .
      992     define input parameter p-shift-num  as integer   no-undo .
      993     do
      994     on error undo, return error
      995     :
      996       define buffer buf_temp-fact-order for temp-fact-order .
      997       find first buf_temp-fact-order
      998         where buf_temp-fact-order.temp-artic      = p-artic
      999           and buf_temp-fact-order.temp-prod-type  = p-prod-type
     1000           and buf_temp-fact-order.temp-prod-code  = p-prod-code
     1001           and buf_temp-fact-order.temp-sum-type   = p-sum-type
     1002           and buf_temp-fact-order.temp-fact-order = p-fact-order
     1003         no-error .
     1004       if not available buf_temp-fact-order
     1005       then do:
     1006         create buf_temp-fact-order .
     1007         assign
     1008           buf_temp-fact-order.temp-artic      = p-artic
     1009           buf_temp-fact-order.temp-prod-type  = p-prod-type
     1010           buf_temp-fact-order.temp-prod-code  = p-prod-code
     1011           buf_temp-fact-order.temp-sum-type   = p-sum-type
     1012           buf_temp-fact-order.temp-fact-order = p-fact-order
     1013         .
     1014         assign
     1015           buf_temp-fact-order.temp-fact-date   = p-fact-date
     1016           buf_temp-fact-order.temp-shift-date  = p-shift-date
     1017           buf_temp-fact-order.temp-shift-num   = p-shift-num
     1018           buf_temp-fact-order.temp-break-value = year(p-fact-date) * 10000
     1019                                                + month(p-fact-date) * 100
     1020           buf_temp-fact-order.temp-need-delete = true
     1021         .
     1022       end.
     1023     end.
     1024   end procedure.
     1025   procedure fill-temp-fact-order :
     1026     define buffer buf_stk-line for ub.stk-line .
     1027     do
     1028     on error undo, return error return-value
     1029     :
     1030       for each buf_stk-line no-lock
     1031         where buf_stk-line.obj-type   = p-obj-type
     1032           and buf_stk-line.obj-code   = p-obj-code
     1033           and buf_stk-line.fact-order > p-last-fact-order
     1034           and buf_stk-line.fact-order <= p-cut-fact-order
     1035       on error undo, return error
     1036       :
     1037         assign
     1038           v-ind = v-ind + 1
     1039         .
     1040         if v-ind modulo 10 = 0
     1041         then do:
     1042           run show-count in this-procedure
     1043             (input v-ind
     1044             ,input "Артикул " + string(buf_stk-line.artic)
     1045             ).
     1046         end.
     1047         if (buf_stk-line.sum-type begins 'crsa':U
     1048             and buf_stk-line.sum-type <>  'crsa':U
     1049             )
     1050         or (buf_stk-line.sum-type begins 'cost':U
     1051             and buf_stk-line.sum-type <>  'cost':U
     1052             )
     1053         or (buf_stk-line.sum-type begins 'cgsr':U
     1054             and buf_stk-line.sum-type <>  'cgsr':U
     1055             )
     1056         or (buf_stk-line.sum-type begins 'cssr':U
     1057             and buf_stk-line.sum-type <>  'cssr':U
     1058             )
     1059         then do:
     1060           next .
     1061         end.
     1062         run accum-temp-fact-order in this-procedure
     1063           (input  buf_stk-line.artic
     1064           ,input  buf_stk-line.prod-type
     1065           ,input  buf_stk-line.prod-code
     1066           ,input  buf_stk-line.sum-type
     1067           ,input  buf_stk-line.fact-order
     1068           ,input  buf_stk-line.fact-date
     1069           ,input  buf_stk-line.shift-date
     1070           ,input  buf_stk-line.shift-num
     1071           ) no-error .
     1072         if error-status :error
     1073         then do:
     1074           message
     1075             vss-workfile vss-revision vss-description skip
     1076             "Ошибка при вызове процедуры" 'accum-temp-fact-order':u skip
     1077             error-status :get-message(1) skip
     1078             return-value skip
     1079             view-as alert-box error .
     1080           undo, return error .
     1081         end.
     1082       end.
     1083     end.
     1084   end procedure.
     1085   procedure select-temp-fact-order :
     1086     do
     1087     on error undo, return error
     1088     :
     1089       define buffer buf_temp-fact-order for temp-fact-order .
     1090       define buffer buf_temp-last-fact-order for temp-last-fact-order .
     1091       for each buf_temp-last-fact-order
     1092       on error undo, return error return-value
     1093       :
     1094         delete buf_temp-last-fact-order .
     1095       end.
     1096       for each buf_temp-fact-order
     1097       on error undo, return error
     1098       :
     1099         find first buf_temp-last-fact-order
     1100           where buf_temp-last-fact-order.temp-artic       = buf_temp-fact-order.temp-artic
     1101             and buf_temp-last-fact-order.temp-prod-type   = buf_temp-fact-order.temp-prod-type
     1102             and buf_temp-last-fact-order.temp-prod-code   = buf_temp-fact-order.temp-prod-code
     1103             and buf_temp-last-fact-order.temp-sum-type    = buf_temp-fact-order.temp-sum-type
     1104             and buf_temp-last-fact-order.temp-break-value = buf_temp-fact-order.temp-break-value
     1105           no-error .
     1106         if not available buf_temp-last-fact-order
     1107         then do:
     1108           create buf_temp-last-fact-order .
     1109           assign
     1110             buf_temp-last-fact-order.temp-artic       = buf_temp-fact-order.temp-artic
     1111             buf_temp-last-fact-order.temp-prod-type   = buf_temp-fact-order.temp-prod-type
     1112             buf_temp-last-fact-order.temp-prod-code   = buf_temp-fact-order.temp-prod-code
     1113             buf_temp-last-fact-order.temp-sum-type    = buf_temp-fact-order.temp-sum-type
     1114             buf_temp-last-fact-order.temp-break-value = buf_temp-fact-order.temp-break-value
     1115             buf_temp-last-fact-order.temp-fact-order  = buf_temp-fact-order.temp-fact-order
     1116           .
     1117         end.
     1118         if buf_temp-last-fact-order.temp-fact-order < buf_temp-fact-order.temp-fact-order
     1119         then do:
     1120           assign
     1121             buf_temp-last-fact-order.temp-fact-order = buf_temp-fact-order.temp-fact-order
     1122           .
     1123         end.
     1124       end.
     1125       for each buf_temp-last-fact-order
     1126       on error undo, return error return-value
     1127       :
     1128         find first buf_temp-fact-order
     1129           where buf_temp-fact-order.temp-artic      = buf_temp-last-fact-order.temp-artic
     1130             and buf_temp-fact-order.temp-prod-type  = buf_temp-last-fact-order.temp-prod-type
     1131             and buf_temp-fact-order.temp-prod-code  = buf_temp-last-fact-order.temp-prod-code
     1132             and buf_temp-fact-order.temp-sum-type   = buf_temp-last-fact-order.temp-sum-type
     1133             and buf_temp-fact-order.temp-fact-order = buf_temp-last-fact-order.temp-fact-order
     1134           .
     1135         assign
     1136           buf_temp-fact-order.temp-need-delete = false
     1137         .
     1138       end.
     1139     end.
     1140   end procedure.
     1141   procedure store-temp-fact-order :
     1142     define buffer buf_temp-fact-order for temp-fact-order .
     1143     do
     1144     on error undo, return error return-value
     1145     :
     1146       output stream sout to cmprarh.txt .
     1147       export stream sout
     1148         "obj-type"        p-obj-type
     1149         "obj-code"        p-obj-code
     1150         "last-fact-order" p-last-fact-order
     1151         "cut-fact-order"  p-cut-fact-order
     1152         .
     1153       for each buf_temp-fact-order
     1154       on error undo, return error return-value
     1155       :
     1156         export stream sout
     1157           "temp-artic"       buf_temp-fact-order.temp-artic
     1158           "temp-prod-type"   buf_temp-fact-order.temp-prod-type
     1159           "temp-prod-code"   buf_temp-fact-order.temp-prod-code
     1160           "temp-sum-type"    buf_temp-fact-order.temp-sum-type
     1161           "temp-fact-order"  buf_temp-fact-order.temp-fact-order
     1162           "temp-fact-date"   buf_temp-fact-order.temp-fact-date
     1163           "temp-shift-date"  buf_temp-fact-order.temp-shift-date
     1164           "temp-shift-num"   buf_temp-fact-order.temp-shift-num
     1165           "temp-break-value" buf_temp-fact-order.temp-break-value
     1166           "temp-need-delete" buf_temp-fact-order.temp-need-delete
     1167           .
     1168       end.
     1169       output stream sout close .
     1170     end.
     1171   end procedure.
     1172   procedure show-action :
     1173     do
     1174     on error undo, return error
     1175     :
     1176       define input parameter p-action as character no-undo .
     1177       assign
     1178         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1179         v-current-action = p-action
     1180       .
     1181       display
     1182         v-current-time
     1183         v-current-action
     1184         with frame a.
     1185     end.
     1186   end procedure.
     1187   procedure show-count :
     1188     define input  parameter p-count      as integer   no-undo .
     1189     define input  parameter p-sub-action as character no-undo .
     1190     do
     1191     on error undo, return error
     1192     :
     1193       assign
     1194         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1195         v-count        = p-count
     1196         v-sub-action   = p-sub-action
     1197       .
     1198       display
     1199         v-current-time
     1200         v-count
     1201         v-sub-action
     1202         with frame a.
     1203     end.
     1204   end procedure.
     1205   procedure delete-stk-line :
     1206     define buffer buf_temp-fact-order for temp-fact-order .
     1207     define buffer buf_stk-line for ub.stk-line .
     1208     do
     1209     on error undo, return error return-value
     1210     :
     1211       for each buf_temp-fact-order
     1212         where buf_temp-fact-order.temp-need-delete = true
     1213       on error undo, return error
     1214       :
     1215         for each buf_stk-line
     1216           where buf_stk-line.obj-type   = p-obj-type
     1217             and buf_stk-line.obj-code   = p-obj-code
     1218             and buf_stk-line.artic      = buf_temp-fact-order.temp-artic
     1219             and buf_stk-line.prod-type  = buf_temp-fact-order.temp-prod-type
     1220             and buf_stk-line.prod-code  = buf_temp-fact-order.temp-prod-code
     1221             and buf_stk-line.fact-order = buf_temp-fact-order.temp-fact-order
     1222             and buf_stk-line.sum-type   begins buf_temp-fact-order.temp-sum-type
     1223         on error undo, return error
     1224         :
     1225           assign
     1226             v-ind = v-ind + 1
     1227           .
     1228           if v-ind modulo 10 = 0
     1229           then do:
     1230             run show-count in this-procedure
     1231               (input v-ind
     1232               ,input "Артикул " + string(buf_stk-line.artic)
     1233               ).
     1234           end.
     1235           delete buf_stk-line .
     1236         end.
     1237       end.
     1238     end.
     1239   end procedure.
