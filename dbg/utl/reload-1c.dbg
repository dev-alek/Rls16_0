        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Ручной режим работы OpenXML".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define new shared stream vProtTest.
       78   define new shared variable testId as rowid no-undo.
       79   define temp-table ttMess
       80     field fCheck as logical init no
       81     field fMess  as character
       82     field fCount as integer
       83   .
       84   define temp-table ttLoaded no-undo
       85     field fMess as character
       86     field fKey as character
       87     index pi fMess fKey
       88   .
       89   output stream vProtTest to terminal.
       90   DEFINE BUTTON b-exit AUTO-END-KEY
       91        LABEL "Выход"
       92        SIZE 13 BY 1.14.
       93   DEFINE BUTTON b-load
       94        LABEL "Перевыгрузить"
       95        SIZE 18 BY 1.14.
       96   DEFINE BUTTON b-mark
       97        LABEL "*"
       98        SIZE 4 BY 1.19.
       99   DEFINE BUTTON b-mark-all
      100        LABEL "Все *"
      101        SIZE 8 BY 1.19.
      102   DEFINE QUERY BROWSE-mess FOR
      103         ttMess SCROLLING.
      104   DEFINE BROWSE BROWSE-mess
      105     QUERY BROWSE-mess DISPLAY
      106         ttMess.fCheck column-label "*" format "*/"
      107   ttMess.fMess  column-label "Сообщение"  format "X(20)" width 40
      108   ttMess.fCount column-label "Количество" format ">>>,>>9"
      109       WITH SEPARATORS SIZE 66 BY 10.48 ROW-HEIGHT-CHARS .57 FIT-LAST-COLUMN.
      110   DEFINE FRAME Dialog-Frame
      111        b-mark AT ROW 1.43 COL 16.8 WIDGET-ID 2
      112        b-mark-all AT ROW 1.43 COL 21.6 WIDGET-ID 4
      113        b-exit AT ROW 1.48 COL 3.2 WIDGET-ID 8
      114        b-load AT ROW 1.48 COL 51 WIDGET-ID 6
      115        BROWSE-mess AT ROW 3.38 COL 3 WIDGET-ID 200
      116        SPACE(2.19) SKIP(1.13)
      117       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      118            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      119            TITLE "Перевыгрузка в 1С" WIDGET-ID 100.
      120   ASSIGN
      121          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      122          FRAME Dialog-Frame:HIDDEN           = TRUE.
      123   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      124   DO:
      125     APPLY "END-ERROR":U TO SELF.
      126   END.
      127   ON CHOOSE OF b-load IN FRAME Dialog-Frame
      128   DO:
      129     define variable vCnt  as int64     no-undo.
      130     define variable vMess as character no-undo.
      131     define buffer b-ttMess for ttMess.
      132     for each b-ttMess where b-ttMess.fCheck:
      133       vMess = substitute("&1,&2", vMess, b-ttMess.fMess).
      134     end.
      135     if vMess = "" then
      136     do:
      137       message "Не выбраны сообщения для перевыгрузки." view-as alert-box.
      138       return no-apply.
      139     end.
      140     vMess = substring(vMess,2).
      141     message
      142       "Сейчас из не подтвержденных пакетов будут удалены сообщения "
      143       vMess " и перевыгружены в 1С." skip
      144       "Вы уверены?"
      145       view-as alert-box question buttons yes-no update vLog as logical.
      146     if not vLog then
      147       return no-apply.
      148     run reLoad in this-procedure (output vCnt).
      149     if vCnt > 0 then
      150     do:
      151       message "Перевыгружено" vCnt "сообщений." view-as alert-box.
      152       run reopen in this-procedure.
      153     end.
      154   END.
      155   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      156   DO:
      157     if available ttMess then
      158     do:
      159       ttMess.fCheck = not ttMess.fCheck.
      160       reposition BROWSE-mess forwards 0.
      161       BROWSE-mess:refresh() .
      162       apply "entry" to BROWSE-mess in frame Dialog-Frame.
      163     end.
      164   END.
      165   ON CHOOSE OF b-mark-all IN FRAME Dialog-Frame
      166   DO:
      167     define buffer b-ttMess for ttMess.
      168     if not can-find(first b-ttMess where not ttMess.fCheck) then
      169     do:
      170       for each b-ttMess:
      171         b-ttMess.fCheck = no.
      172       end.
      173     end.
      174     else
      175     do:
      176       for each b-ttMess:
      177         b-ttMess.fCheck = yes.
      178       end.
      179     end.
      180     BROWSE-mess:refresh().
      181     reposition BROWSE-mess to row 1.
      182     apply "entry" to BROWSE-mess in frame Dialog-Frame.
      183   END.
      184   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      185   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      186   MAIN-BLOCK:
      187   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      188      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      189     run createTT in this-procedure.
      190     RUN enable_UI.
      191     WAIT-FOR GO OF FRAME Dialog-Frame.
      192   END.
      193   RUN disable_UI.
      194   PROCEDURE CreateTT :
      195   define buffer buf_esys-pck-sent   for ub.esys-pck-sent.
      196   define buffer buf_esys-route      for ub.esys-route.
      197   define buffer buf_esys-route-dump for ub.esys-route-dump.
      198   for each buf_esys-pck-sent where
      199            buf_esys-pck-sent.esps-rcvd = no
      200       no-lock,
      201       each buf_esys-route where
      202            buf_esys-route.esys-id       = buf_esys-pck-sent.esys-id
      203        and buf_esys-route.db-num        = buf_esys-pck-sent.db-num
      204        and buf_esys-route.esr-last-pack = buf_esys-pck-sent.esps-pack-num
      205       no-lock,
      206       first buf_esys-route-dump where
      207             buf_esys-route-dump.esrd-dump-ord = buf_esys-route.esr-dump-ord
      208         and buf_esys-route-dump.esrd-dump-name <> "sales-p-shifts"
      209         and buf_esys-route-dump.esrd-uniq-key-rec <> ""
      210         and num-entries(buf_esys-route-dump.esrd-uniq-key-rec,chr(3)) > 1
      211       no-lock
      212       break by buf_esys-route-dump.esrd-dump-name:
      213     accum esys-route-dump.esrd-dump-ord (count by buf_esys-route-dump.esrd-dump-name).
      214     if last-of(buf_esys-route-dump.esrd-dump-name) then
      215     do:
      216       create ttMess.
      217       assign
      218         ttMess.fMess  = buf_esys-route-dump.esrd-dump-name
      219         ttMess.fCount = accum count by buf_esys-route-dump.esrd-dump-name esys-route-dump.esrd-dump-ord
      220       .
      221     end.
      222   end.
      223   END PROCEDURE.
      224   PROCEDURE disable_UI :
      225     HIDE FRAME Dialog-Frame.
      226   END PROCEDURE.
      227   PROCEDURE enable_UI :
      228     ENABLE b-mark b-mark-all b-exit b-load BROWSE-mess
      229         WITH FRAME Dialog-Frame.
      230     VIEW FRAME Dialog-Frame.
      231     OPEN QUERY BROWSE-mess FOR EACH ttMess.
      232   END PROCEDURE.
      233   PROCEDURE reLoad :
      234     define output parameter oCnt as int64 no-undo.
      235     define variable vTable   as character no-undo.
      236     define variable vUtil    as character no-undo.
      237     define variable vMess    as character no-undo.
      238     define variable vBuf     as handle    no-undo.
      239     define variable vLoad    as logical   no-undo.
      240     define buffer buf_esys-pck-sent    for ub.esys-pck-sent.
      241     define buffer buf_esys-route       for ub.esys-route.
      242     define buffer buf1_esys-route      for ub.esys-route.
      243     define buffer buf_esys-route-dump  for ub.esys-route-dump.
      244     define buffer buf1_esys-route-dump for ub.esys-route-dump.
      245     define buffer b-ttMess for ttMess.
      246     empty temp-table ttLoaded.
      247     for each buf_esys-pck-sent where
      248            buf_esys-pck-sent.esps-rcvd = no
      249       exclusive-lock,
      250       each buf_esys-route where
      251            buf_esys-route.esys-id       = buf_esys-pck-sent.esys-id
      252        and buf_esys-route.db-num        = buf_esys-pck-sent.db-num
      253        and buf_esys-route.esr-last-pack = buf_esys-pck-sent.esps-pack-num
      254       exclusive-lock,
      255       first buf_esys-route-dump where
      256             buf_esys-route-dump.esrd-dump-ord = buf_esys-route.esr-dump-ord
      257         and buf_esys-route-dump.esrd-uniq-key-rec  <> ""
      258         and num-entries(buf_esys-route-dump.esrd-uniq-key-rec,chr(3)) > 1
      259       exclusive-lock:
      260       vLoad = false.
      261       if can-find(first b-ttMess where
      262                         b-ttMess.fMess = buf_esys-route-dump.esrd-dump-name
      263                     and b-ttMess.fCheck) then
      264       do:
      265         find first ttLoaded no-lock where
      266                    ttLoaded.fMess = buf_esys-route-dump.esrd-dump-name
      267                and ttLoaded.fKey  = buf_esys-route-dump.esrd-uniq-key-rec
      268              no-error.
      269         if not avail ttLoaded then
      270         do:
      271             assign
      272               vTable    = entry(1,buf_esys-route-dump.esrd-uniq-key-rec,chr(3))
      273               testId = to-rowid(entry(2,buf_esys-route-dump.esrd-uniq-key-rec,chr(3)))
      274               vUtil = ""
      275               vMess = ""
      276               vLoad = true.
      277             .
      278             case buf_esys-route-dump.esrd-dump-name:
      279             when "trn-gd-docs" or
      280             when "trn-fuel-docs" or
      281             when "inv-gd-docs" or
      282             when "peres-gd-docs" then
      283               if vTable = "fbr-doc" then
      284                 vUtil = "send6c.p".
      285               else
      286                 vUtil = "send1c.p".
      287             when "shifts" or
      288             when "sales-p-shifts" then
      289               vUtil = "send2c.p".
      290             when "check-fuel-docs" then
      291               vUtil = "send3c.p".
      292             when "price-docs" then
      293               vUtil = "send4c.p".
      294             when "cash" then
      295               vUtil = "send5c.p".
      296             when "edi-docs" then
      297               vUtil = "send7c.p".
      298             when "tanks" then
      299               vUtil = "send9c.p".
      300             when "shift-periods" then
      301               vUtil = "send10c.p".
      302             end case.
      303             if vUtil <> "" then
      304             do:
      305               run value("utl/" + vUtil) no-error.
      306             end.
      307             else
      308             do:
      309               case buf_esys-route-dump.esrd-dump-name:
      310               when "DT-seasons" then
      311                 vMess = "DTSeasons".
      312               end case.
      313               if vMess <> "" then do:
      314                   create buffer vBuf for table vTable.
      315                   vBuf:find-by-rowid(testId,no-lock).
      316                   run bge\send1cerp.p (?,
      317                     this-procedure,
      318                     this-procedure,
      319                     vMess,
      320                     vBuf,
      321                     ?,
      322                     ?) no-error.
      323               end.
      324               else
      325                 message "Сообщение" buf_esys-route-dump.esrd-dump-name "не может быть отправлено повторно" skip
      326                         "Не определена процедура отправки." view-as alert-box.
      327             end.
      328         end.
      329         if not error-status:error then
      330         do:
      331           if not avail ttLoaded then
      332           do:
      333             create ttLoaded.
      334             assign
      335               ttLoaded.fMess = buf_esys-route-dump.esrd-dump-name
      336               ttLoaded.fKey  = buf_esys-route-dump.esrd-uniq-key-rec
      337             .
      338           end.
      339           if buf_esys-route-dump.esrd-dump-name = "shifts" then do:
      340             for each buf1_esys-route where
      341                      buf1_esys-route.esys-id       = buf_esys-pck-sent.esys-id
      342                  and buf1_esys-route.db-num        = buf_esys-pck-sent.db-num
      343                  and buf1_esys-route.esr-last-pack = buf_esys-pck-sent.esps-pack-num
      344                 exclusive-lock,
      345                 first buf1_esys-route-dump where
      346                       buf1_esys-route-dump.esrd-dump-ord = buf1_esys-route.esr-dump-ord
      347                   and buf1_esys-route-dump.esrd-dump-name = "sales-p-shifts"
      348                   and buf1_esys-route-dump.esrd-uniq-key-rec = buf_esys-route-dump.esrd-uniq-key-rec
      349                 exclusive-lock:
      350               oCnt = oCnt + if vLoad then 1 else 0.
      351               delete buf1_esys-route-dump.
      352               delete buf1_esys-route.
      353               buf_esys-pck-sent.esps-total-recs = buf_esys-pck-sent.esps-total-recs - 1.
      354             end.
      355           end.
      356           oCnt = oCnt + if vLoad then 1 else 0.
      357           delete buf_esys-route-dump.
      358           delete buf_esys-route.
      359           assign
      360             buf_esys-pck-sent.esps-total-recs = buf_esys-pck-sent.esps-total-recs - 1
      361             buf_esys-pck-sent.esps-SendTxtDate = ?
      362             buf_esys-pck-sent.esps-SendTxtTime = ""
      363             buf_esys-pck-sent.esps-SendTxtTimeInt = 0
      364           .
      365           if not can-find (first buf1_esys-route where
      366                                  buf1_esys-route.esys-id       = buf_esys-pck-sent.esys-id
      367                              and buf1_esys-route.db-num        = buf_esys-pck-sent.db-num
      368                              and buf1_esys-route.esr-last-pack = buf_esys-pck-sent.esps-pack-num
      369                           ) then
      370           do:
      371             delete buf_esys-pck-sent.
      372           end.
      373         end.
      374         else do:
      375           message "Ошибка при отправке сообщения" buf_esys-route-dump.esrd-dump-name " процедурой " vUtil skip
      376                    error-status:get-message(1) view-as alert-box.
      377         end.
      378       end.
      379     end.
      380   END PROCEDURE.
      381   PROCEDURE reopen :
      382   close query BROWSE-mess.
      383   empty temp-table ttMess.
      384   run createTT in this-procedure.
      385   OPEN QUERY BROWSE-mess FOR EACH ttMess.
      386   reposition BROWSE-mess to row 1.
      387   apply "entry" to BROWSE-mess in frame Dialog-Frame.
      388   END PROCEDURE.
