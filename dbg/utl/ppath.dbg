        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: ppath.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/ppath.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   DEFINE VARIABLE c_it AS CHARACTER NO-UNDO FORMAT "x(60)":U.
       63   DEFINE VARIABLE cwd  AS CHARACTER NO-UNDO INITIAL ?.
       64   DEFINE VARIABLE ctd  AS CHARACTER NO-UNDO INITIAL ?.
       65   DEFINE VARIABLE cc   AS CHARACTER NO-UNDO.
       66   DEFINE VARIABLE rr   AS RECID     NO-UNDO.
       67   DEFINE VARIABLE jj   AS INTEGER   NO-UNDO.
       68   DEFINE VARIABLE ll   AS LOGICAL   NO-UNDO.
       69   DEFINE TEMP-TABLE tt_ppth NO-UNDO
       70     FIELD number  AS INTEGER   FORMAT ">>9":U   COLUMN-LABEL "Н-р"
       71     FIELD it-name AS CHARACTER FORMAT "x(40)":U COLUMN-LABEL "Каталог"
       72     INDEX tt_pi   IS PRIMARY   UNIQUE number    ASCENDING.
       73   DEFINE BUTTON Btn_Up     LABEL "&Up"     SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       74   DEFINE BUTTON Btn_Down   LABEL "Do&wn"   SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       75   DEFINE BUTTON Btn_Top    LABEL "&Top"    SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       76   DEFINE BUTTON Btn_Bottom LABEL "&Bottom" SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       77   DEFINE BUTTON Btn_Exit   LABEL "E&xit"   SIZE-CHARS 7.50 BY 1.00 DEFAULT AUTO-END-KEY.
       78   DEFINE BUTTON Btn_Add    LABEL "&Add"    SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       79   DEFINE BUTTON Btn_Edit   LABEL "&Edit"   SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       80   DEFINE BUTTON Btn_Delete LABEL "&Del"    SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       81   DEFINE BUTTON Btn_Save   LABEL "&Save"   SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       82   DEFINE BUTTON Btn_Help   LABEL "&Help"   SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       83   DEFINE BUTTON Btn_Info   LABEL "&Info"   SIZE-CHARS 7.50 BY 1.00 DEFAULT.
       84   DEFINE BUTTON Btn_OK     LABEL "&OK"     SIZE-CHARS 7.50 BY 1.00 DEFAULT AUTO-GO.
       85   DEFINE RECTANGLE r-rect-0 EDGE-PIXELS 3 GRAPHIC-EDGE NO-FILL SIZE-CHARS 56.38 BY  1.50.
       86   DEFINE RECTANGLE r-rect-1 EDGE-PIXELS 3 GRAPHIC-EDGE NO-FILL SIZE-CHARS 60.00 BY  1.50.
       87   DEFINE RECTANGLE r-rect-2 EDGE-PIXELS 3 GRAPHIC-EDGE NO-FILL SIZE-CHARS  9.25 BY 13.75.
       88   DEFINE QUERY br-tt FOR tt_ppth SCROLLING.
       89   DEFINE BROWSE br-tt QUERY br-tt NO-LOCK DISPLAY
       90     tt_ppth.number
       91     tt_ppth.it-name
       92   WITH SEPARATORS SIZE-CHARS 46.50 BY 13.75.
       93   DEFINE FRAME ff
       94     br-tt      AT ROW  1.25 COL  1.50
       95     r-rect-2   AT ROW  1.25 COL 48.50
       96     Btn_Up     AT ROW  1.50 COL 49.38
       97     Btn_Down   AT ROW  3.00 COL 49.38
       98     Btn_Top    AT ROW  6.00 COL 49.38
       99     Btn_Bottom AT ROW  7.50 COL 49.38
      100     Btn_Help   AT ROW 12.04 COL 49.38
      101     Btn_Info   AT ROW 13.58 COL 49.38
      102     r-rect-0   AT ROW 15.25 COL  1.50
      103     Btn_Exit   AT ROW 15.50 COL  2.50
      104     Btn_Add    AT ROW 15.50 COL 24.25
      105     Btn_Edit   AT ROW 15.50 COL 32.25
      106     Btn_Delete AT ROW 15.50 COL 40.25
      107     Btn_Save   AT ROW 15.50 COL 49.38
      108   WITH VIEW-AS DIALOG-BOX NO-LABEL TITLE "Propath" THREE-D DEFAULT-BUTTON Btn_Edit CANCEL-BUTTON Btn_Exit.
      109   DEFINE FRAME ff-upd
      110     c_it     AT ROW 1.50 COL  1.50 NO-LABEL VIEW-AS FILL-IN SIZE-CHARS 60.00 BY 1.00
      111     r-rect-1 AT ROW 3.00 COL  1.50
      112     Btn_Exit AT ROW 3.25 COL  2.50
      113     Btn_OK   AT ROW 3.25 COL 53.50
      114   WITH VIEW-AS DIALOG-BOX SIDE-LABELS TITLE "Propath" THREE-D SCROLLABLE KEEP-TAB-ORDER
      115        DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Exit.
      116   ON CHOOSE OF Btn_Add IN FRAME ff DO:
      117     ASSIGN FRAME ff-upd :TITLE = "Propath: Adding...".
      118     IF AVAILABLE tt_ppth THEN DO:
      119       ASSIGN c_it = tt_ppth.it-name
      120              jj   = tt_ppth.number
      121              rr   = RECID( tt_ppth ).
      122     END.
      123     IF c_it = cwd + " | <Рабочий каталог>" THEN DO: ASSIGN c_it = ".". END.
      124     DO ON ENDKEY UNDO, LEAVE
      125        ON ERROR  UNDO, LEAVE :
      126       DISPLAY  c_it WITH FRAME ff-upd.
      127       ENABLE   ALL  WITH FRAME ff-upd.
      128       WAIT-FOR GO     OF FRAME ff-upd.
      129       ASSIGN c_it.
      130       FIND FIRST tt_ppth NO-LOCK WHERE tt_ppth.it-name = c_it NO-ERROR.
      131       IF AVAILABLE tt_ppth THEN DO:
      132         MESSAGE 'Повторно указан путь "' + c_it + '"!' SKIP "( см.п." tt_ppth.number ")." VIEW-AS ALERT-BOX ERROR.
      133         UNDO, RETRY.
      134       END.
      135       CREATE tt_ppth.
      136       ASSIGN tt_ppth.number  = jj
      137              tt_ppth.it-name = c_it
      138              rr              = RECID( tt_ppth ).
      139       IF tt_ppth.it-name = "." THEN DO: ASSIGN tt_ppth.it-name = cwd + " | <Рабочий каталог>". END.
      140       FOR EACH tt_ppth WHERE tt_ppth.number >= jj AND RECID( tt_ppth ) <> rr BY tt_ppth.number DESCENDING :
      141         ASSIGN tt_ppth.number = tt_ppth.number + 1.
      142       END.
      143     END.
      144     HIDE FRAME ff-upd NO-PAUSE.
      145     RUN UI-On IN THIS-PROCEDURE.
      146   END.
      147   ON CHOOSE OF Btn_Edit IN FRAME ff DO:
      148     IF NOT AVAILABLE tt_ppth THEN DO: RETURN NO-APPLY. END.
      149     ASSIGN FRAME ff-upd :TITLE = "Propath: Updating...".
      150     ASSIGN c_it = tt_ppth.it-name
      151            rr   = RECID( tt_ppth ).
      152     IF c_it = cwd + " | <Рабочий каталог>" THEN DO: ASSIGN c_it = ".". END.
      153     DO ON ENDKEY UNDO, LEAVE
      154        ON ERROR  UNDO, LEAVE :
      155       DISPLAY  c_it WITH FRAME ff-upd.
      156       ENABLE   ALL  WITH FRAME ff-upd.
      157       WAIT-FOR GO     OF FRAME ff-upd.
      158       ASSIGN c_it.
      159       ASSIGN tt_ppth.it-name = c_it
      160              rr              = RECID( tt_ppth ).
      161       IF tt_ppth.it-name = "." THEN DO: ASSIGN tt_ppth.it-name = cwd + " | <Рабочий каталог>". END.
      162     END.
      163     HIDE FRAME ff-upd NO-PAUSE.
      164     RUN UI-On IN THIS-PROCEDURE.
      165   END.
      166   ON CHOOSE OF Btn_Delete IN FRAME ff DO:
      167     IF NOT AVAILABLE tt_ppth THEN DO: RETURN NO-APPLY. END.
      168     IF tt_ppth.it-name = cwd + " | <Рабочий каталог>" THEN DO:
      169       ASSIGN ll = NO.
      170       MESSAGE "Вы уверены, что хотите удалить рабочую директорию?" VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ll.
      171     END.
      172     ASSIGN jj = tt_ppth.number.
      173     DELETE tt_ppth.
      174     FIND FIRST tt_ppth NO-LOCK WHERE tt_ppth.number = jj + 1 NO-ERROR.
      175     IF NOT AVAILABLE tt_ppth THEN DO: FIND FIRST tt_ppth NO-LOCK WHERE tt_ppth.number = jj - 1 NO-ERROR. END.
      176     IF AVAILABLE tt_ppth THEN DO: ASSIGN rr = RECID( tt_ppth ). END.
      177     FOR EACH tt_ppth WHERE tt_ppth.number > jj :
      178       ASSIGN tt_ppth.number = tt_ppth.number - 1.
      179     END.
      180     RUN UI-On IN THIS-PROCEDURE.
      181   END.
      182   ON CHOOSE OF Btn_Down IN FRAME ff DO:
      183     IF NOT AVAILABLE tt_ppth THEN DO: RETURN NO-APPLY. END.
      184     ASSIGN jj = tt_ppth.number
      185            rr = RECID( tt_ppth ).
      186     FIND LAST tt_ppth NO-LOCK USE-INDEX tt_pi.
      187     IF tt_ppth.number = jj THEN DO: RETURN NO-APPLY. END.
      188     DO TRANSACTION ON ERROR UNDO, LEAVE :
      189       FIND FIRST tt_ppth WHERE tt_ppth.number = jj + 1 NO-ERROR.
      190       ASSIGN tt_ppth.number = jj.
      191       FIND tt_ppth WHERE RECID( tt_ppth ) = rr.
      192       ASSIGN tt_ppth.number = jj + 1.
      193     END.
      194     RUN UI-On IN THIS-PROCEDURE.
      195   END.
      196   ON CHOOSE OF Btn_Up IN FRAME ff DO:
      197     IF NOT AVAILABLE tt_ppth THEN DO: RETURN NO-APPLY. END.
      198     ASSIGN jj = tt_ppth.number
      199            rr = RECID( tt_ppth ).
      200     FIND FIRST tt_ppth NO-LOCK USE-INDEX tt_pi.
      201     IF tt_ppth.number = jj THEN DO: RETURN NO-APPLY. END.
      202     DO TRANSACTION ON ERROR UNDO, LEAVE :
      203       FIND FIRST tt_ppth WHERE tt_ppth.number = jj - 1 NO-ERROR.
      204       ASSIGN tt_ppth.number = jj.
      205       FIND tt_ppth WHERE RECID( tt_ppth ) = rr.
      206       ASSIGN tt_ppth.number = jj - 1.
      207     END.
      208     RUN UI-On IN THIS-PROCEDURE.
      209   END.
      210   ON CHOOSE OF Btn_Top IN FRAME ff DO:
      211     IF NOT AVAILABLE tt_ppth THEN DO: RETURN NO-APPLY. END.
      212     ASSIGN jj = tt_ppth.number
      213            rr = RECID( tt_ppth ).
      214     ASSIGN tt_ppth.number = 0.
      215     FOR EACH tt_ppth WHERE tt_ppth.number < jj BY tt_ppth.number DESCENDING :
      216       ASSIGN tt_ppth.number = tt_ppth.number + 1.
      217     END.
      218     RUN UI-On IN THIS-PROCEDURE.
      219   END.
      220   ON CHOOSE OF Btn_Bottom IN FRAME ff DO:
      221     IF NOT AVAILABLE tt_ppth THEN DO: RETURN NO-APPLY. END.
      222     ASSIGN jj = tt_ppth.number
      223            rr = RECID( tt_ppth ).
      224     FIND LAST tt_ppth NO-LOCK USE-INDEX tt_pi.
      225     IF jj = tt_ppth.number THEN DO: RETURN NO-APPLY. END.
      226     ASSIGN c_it = STRING( tt_ppth.number ).
      227     FOR EACH tt_ppth WHERE tt_ppth.number > jj BY tt_ppth.number :
      228       ASSIGN tt_ppth.number = tt_ppth.number - 1.
      229     END.
      230     FIND tt_ppth WHERE RECID( tt_ppth ) = rr.
      231     ASSIGN tt_ppth.number = INT( c_it ).
      232     RUN UI-On IN THIS-PROCEDURE.
      233   END.
      234   ON RETURN, MOUSE-SELECT-DBLCLICK OF br-tt DO:
      235     APPLY "CHOOSE":U TO Btn_Edit IN FRAME ff.
      236   END.
      237   ON CHOOSE OF Btn_Info IN FRAME ff DO:
      238     ASSIGN rr = ( IF AVAIL tt_ppth THEN RECID( tt_ppth ) ELSE ? )
      239            jj = 0.
      240     FOR EACH tt_ppth NO-LOCK :
      241       ASSIGN jj = jj + 1.
      242     END.
      243     FIND tt_ppth WHERE RECID( tt_ppth ) = rr NO-ERROR.
      244     IF cwd = ? OR cwd = "":U OR ctd = ? OR ctd = "":U THEN DO: RUN GetWorkingDirectory IN THIS-PROCEDURE. END.
      245     MESSAGE
      246       "Текущий рабочий каталог:"   cwd SKIP
      247       "Текущий временный каталог:" ctd SKIP
      248       "Элементов списка PROPATH:"  jj  SKIP
      249     VIEW-AS ALERT-BOX INFORMATION.
      250   END.
      251   ON CHOOSE OF Btn_Save IN FRAME ff DO:
      252     RUN MakeListFromBrowse IN THIS-PROCEDURE.
      253     IF cc <> PROPATH THEN DO:
      254       ASSIGN ll = NO.
      255       MESSAGE "Записать PROPATH в PROGRESS.INI ?" VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ll.
      256       IF NOT ll THEN DO: RETURN NO-APPLY. END.
      257       ASSIGN cc = PROPATH.
      258       IF LENGTH( cc ) > 128 THEN DO:
      259         MESSAGE "Слишком длинный PROPATH, не могу записать в PROGRESS.INI !" VIEW-AS ALERT-BOX INFORMATION.
      260         RETURN NO-APPLY.
      261       END.
      262       PUT-KEY-VALUE SECTION "Startup" KEY "PROPATH" VALUE cc NO-ERROR.
      263       IF ERROR-STATUS :ERROR THEN DO:
      264         MESSAGE "Не удается сохранить PROPATH !" VIEW-AS ALERT-BOX ERROR.
      265         RETURN NO-APPLY.
      266       END.
      267     END.
      268   END.
      269   IF CURRENT-WINDOW :WINDOW-STATE = WINDOW-MINIMIZED THEN DO: CURRENT-WINDOW :WINDOW-STATE = WINDOW-NORMAL. END.
      270   ON WINDOW-CLOSE OF FRAME ff APPLY "END-ERROR":U TO SELF.
      271   DO ON END-KEY UNDO, LEAVE
      272      ON ERROR   UNDO, LEAVE :
      273     RUN GetWorkingDirectory IN THIS-PROCEDURE.
      274     RUN MakeBrowseFromList  IN THIS-PROCEDURE.
      275     RUN UI-On               IN THIS-PROCEDURE.
      276     WAIT-FOR GO OF FRAME ff.
      277   END.
      278   RUN MakeListFromBrowse IN THIS-PROCEDURE.
      279   HIDE FRAME ff NO-PAUSE.
      280   PROCEDURE UI-On :
      281     OPEN QUERY br-tt FOR EACH tt_ppth NO-LOCK USE-INDEX tt_pi.
      282     ENABLE ALL WITH FRAME ff.
      283     FIND tt_ppth NO-LOCK WHERE RECID( tt_ppth ) = rr NO-ERROR.
      284     IF AVAILABLE tt_ppth THEN REPOSITION br-tt TO RECID RECID( tt_ppth ) NO-ERROR.
      285     IF NOT AVAIL tt_ppth OR ERROR-STATUS :ERROR THEN DO: REPOSITION br-tt TO ROW 1 NO-ERROR. END.
      286     APPLY "ENTRY":U TO br-tt IN FRAME ff.
      287   END PROCEDURE.
      288   PROCEDURE MakeBrowseFromList :
      289     REPEAT jj = 1 TO NUM-ENTRIES( PROPATH ) :
      290       CREATE tt_ppth.
      291       ASSIGN tt_ppth.number  = jj
      292              tt_ppth.it-name = ENTRY( jj, PROPATH ).
      293       IF tt_ppth.it-name = "." THEN DO: ASSIGN tt_ppth.it-name = cwd + " | <Рабочий каталог>". END.
      294     END.
      295   END PROCEDURE.
      296   PROCEDURE MakeListFromBrowse :
      297     ASSIGN cc = "":U.
      298     FOR EACH tt_ppth :
      299       ASSIGN c_it = tt_ppth.it-name.
      300       IF c_it = cwd + " | <Рабочий каталог>" THEN DO: ASSIGN c_it = ".". END.
      301       ASSIGN cc = cc + ( IF cc = "":U THEN "":U ELSE ",":U ) + c_it.
      302     END.
      303     IF cc <> PROPATH THEN DO:
      304       ASSIGN ll = NO.
      305       MESSAGE "Изменить PROPATH?" VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ll.
      306       IF ll THEN DO: PROPATH = cc. END.
      307     END.
      308   END PROCEDURE.
      309   PROCEDURE GetWorkingDirectory :
      310     ASSIGN FILE-INFO :FILE-NAME = ".".
      311     ASSIGN ctd = CAPS( SESSION :TEMP-DIRECTORY )
      312            cwd = FILE-INFO :FULL-PATHNAME.
      313   END PROCEDURE.
