        1   block-level on error undo, throw.
        2   DEFINE TEMP-TABLE tt_obj-list NO-UNDO LIKE ub.clients.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-from-version   as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: 1f78fe327cdf, 1091, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        7   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:52 2017 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: ththrepr.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/ththrepr.p $":U .
       10   define variable vss-description as character no-undo init "Выбор объектов для запуска отчета по ИМПОРТу ПН из старой версии TH в 16.0 ( перенос остатков )".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   def
       71   new shared
       72   temp-table  obj-list no-undo
       73     field obj-type like ub.clients.obj-type
       74     field obj-code like ub.clients.obj-code
       75     field obj-name like ub.clients.obj-name
       76     field obj-id   as integer
       77     field db-num   as integer
       78     index pi is primary unique obj-id
       79     index ie1 obj-type obj-code
       80     index ie2 obj-name
       81   .
       82   procedure create_obj-list :
       83      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       84      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       85      do
       86      on error undo, return error return-value
       87      :
       88         define buffer cli-obj for ub.clients .
       89         define variable p-var as integer no-undo .
       90         define buffer buf_obj-list for obj-list .
       91         find last buf_obj-list  use-index pi no-error .
       92         if available buf_obj-list
       93         then
       94            p-var = buf_obj-list.obj-id + 1.
       95         else
       96            p-var = 1.
       97         find first cli-obj where
       98                   cli-obj.obj-type = p-obj-type
       99               and cli-obj.obj-code = p-obj-code
      100         no-lock no-error.
      101         if available cli-obj
      102         then do:
      103            create buf_obj-list.
      104            assign
      105               buf_obj-list.obj-id   = p-var
      106               buf_obj-list.obj-code = cli-obj.obj-code
      107               buf_obj-list.obj-type = cli-obj.obj-type
      108               buf_obj-list.obj-name = cli-obj.obj-name
      109               buf_obj-list.db-num   = cli-obj.db-num
      110            .
      111         end.
      112      end.
      113   end.
      114   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   procedure gen-key-rec :
      117     define input  parameter p-tbl-name    as character no-undo.
      118     define input  parameter p-bh_tbl-name as handle    no-undo.
      119     define output parameter p-key-rec     as character no-undo.
      120     do
      121     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      122     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      123     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      124     :
      125       define variable fh               as handle    no-undo .
      126       define variable v-ok             as logical   no-undo .
      127       define variable v-inform         as character no-undo .
      128       define variable v-ind            as integer   no-undo .
      129       define variable v-idx-field-qnty as integer   no-undo .
      130       if p-tbl-name = ?
      131         or p-tbl-name = "":U
      132       then do:
      133         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      134       end.
      135       if not p-bh_tbl-name:available then do:
      136         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      137       end.
      138       assign
      139         p-key-rec = p-tbl-name
      140         v-inform  = p-bh_tbl-name:index-information(1)
      141         v-ind     = 2
      142       .
      143       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      144       on error undo, return error
      145       :
      146         assign
      147           v-inform = p-bh_tbl-name:index-information( v-ind )
      148           v-ind    = v-ind + 1
      149         .
      150       end.
      151       if v-inform = ?
      152         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      153         or entry( 3, v-inform, ",":U ) <> "1":U
      154       then do:
      155         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      156       end.
      157       else do:
      158         assign
      159           v-idx-field-qnty = num-entries( v-inform ) - 4
      160         .
      161         if v-idx-field-qnty < 2 then do:
      162           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      163         end.
      164         do v-ind = 1 to v-idx-field-qnty by 2
      165         on error undo, return error
      166         :
      167           assign
      168             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      169             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      170           .
      171         end.
      172       end.
      173       if p-key-rec = ? then do:
      174         assign
      175           p-key-rec = "":U
      176         .
      177         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      178       end.
      179     end.
      180     return.
      181   end procedure.
      182   procedure gen-where-keyr-tab :
      183     define input  parameter i-tableSerach as character no-undo.
      184     define input  parameter i-tablekey   as character  no-undo.
      185     define input  parameter p-key-rec    as character  no-undo.
      186     define input  parameter p-key-handle as handle     no-undo .
      187     define input  parameter p-db-name    as character  no-undo .
      188     define input  parameter p-tt-handle  as handle     no-undo .
      189     define output parameter o-Where      as character  no-undo.
      190     do
      191     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      192     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      193     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      194     :
      195       define variable v-full-tbl-name  as character no-undo .
      196       define variable bh_tbl-name      as handle    no-undo .
      197       define variable fh_key           as handle    no-undo .
      198       define variable fh_search        as handle    no-undo .
      199       define variable v-field-num      as integer   no-undo .
      200       define variable v-count-fld      as integer   no-undo .
      201       define variable v-inform         as character no-undo .
      202       define variable v-ind            as integer   no-undo .
      203       define variable v-idx-field-qnty as integer   no-undo .
      204       define variable v-field-name     as character no-undo .
      205       define variable v-field-val      as character no-undo .
      206       define variable v-word-link      as character no-undo .
      207       define variable vTable           as character no-undo.
      208       define variable bh_tbl-key       as handle    no-undo .
      209       assign
      210         p-key-rec = trim( p-key-rec )
      211       .
      212       if p-key-handle <> ? then do:
      213         if not valid-handle(p-key-handle)
      214            or p-key-handle:type <> "buffer"
      215         then do:
      216           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      217         end.
      218         if num-entries( p-key-rec, chr(3) ) > 1
      219           or p-key-rec = ?
      220           or p-key-rec = "":U
      221         then do:
      222           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      223         end.
      224       end.
      225       else do:
      226         if p-key-rec = ?
      227           or p-key-rec = "":U
      228         then do:
      229           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      230         end.
      231       end.
      232       assign
      233         vTable = entry( 1 , p-key-rec, chr(3) )
      234       .
      235       if p-tt-handle <> ?
      236         and ( not valid-handle(p-tt-handle)
      237               or p-tt-handle:type <> "buffer"
      238             )
      239       then do:
      240         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      241       end.
      242       if p-tt-handle = ? then do:
      243         assign
      244           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      245         .
      246         create buffer bh_tbl-name for table v-full-tbl-name .
      247       end.
      248       else do:
      249         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      250       end.
      251       assign
      252         v-inform = bh_tbl-name:index-information(1)
      253         v-ind    = 2
      254       .
      255       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      256       on error undo, return error
      257       :
      258         assign
      259           v-inform = bh_tbl-name:index-information( v-ind )
      260           v-ind    = v-ind + 1
      261         .
      262       end.
      263       if v-inform = ?
      264         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      265         or entry( 3, v-inform, ",":U ) <> "1":U
      266       then do:
      267         delete object bh_tbl-name no-error.
      268         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      269       end.
      270       assign
      271         v-idx-field-qnty = num-entries( v-inform ) - 4
      272       .
      273       if v-idx-field-qnty < 2 then do:
      274         delete object bh_tbl-name no-error.
      275         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      276       end.
      277       assign
      278         o-where     = "where":U
      279         v-word-link = "":U
      280         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      281         v-count-fld = 0
      282       .
      283       if i-tablekey ne "" and i-tablekey ne ?
      284       then do:
      285         assign
      286           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      287         .
      288         create buffer bh_tbl-key for table v-full-tbl-name .
      289       end.
      290       if i-tableSerach ne "" and i-tableSerach ne ?
      291       then do:
      292         delete object bh_tbl-name no-error.
      293         assign
      294           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      295         .
      296         create buffer bh_tbl-name for table v-full-tbl-name .
      297       end.
      298       block_where:
      299       do v-ind = 1 to v-idx-field-qnty by 2
      300       on error undo, return error
      301       :
      302         assign
      303           v-count-fld = v-count-fld + 1
      304         .
      305         if p-key-handle = ?
      306           and v-count-fld > v-field-num
      307         then do:
      308           leave block_where.
      309         end.
      310         define variable VfieldKeyTable as handle no-undo.
      311         assign
      312           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      313           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      314         .
      315         if     bh_tbl-key ne ?
      316         then do:
      317            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      318            if VfieldKeyTable eq ?
      319            then next block_where.
      320         end.
      321         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      322         then
      323            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      324         else
      325            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      326         if p-key-handle = ? then do:
      327           assign
      328             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      329           .
      330         end.
      331         else do:
      332           assign
      333             fh_key = p-key-handle:buffer-field( v-field-name )
      334           .
      335           if fh_key = ?
      336             or not valid-handle( fh_key )
      337           then do:
      338             delete object bh_tbl-name.
      339             if     bh_tbl-key ne ?
      340             then
      341                delete object bh_tbl-key.
      342             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      343           end.
      344           assign
      345             v-field-val = fh_key:buffer-value
      346           .
      347         end.
      348         if fh_search:data-type ="character":U then do:
      349           assign
      350             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      351             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      352             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      353             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      354             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      355             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      356             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      357             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      358             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      359             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      360             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      361             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      362             v-field-val = substitute( '"&1"', v-field-val )
      363           .
      364         end.
      365         assign
      366           o-where = substitute( "&1 &2", o-where, v-field-val )
      367         .
      368         if v-word-link = "":U then do:
      369           assign
      370             v-word-link = "and":U
      371           .
      372         end.
      373       end.
      374       delete object bh_tbl-name.
      375       if     bh_tbl-key ne ?
      376       then
      377          delete object bh_tbl-key.
      378       if p-key-handle = ?
      379         and v-count-fld <> v-field-num
      380       then do:
      381         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      382       end.
      383     end.
      384   end procedure.
      385   procedure gen-hn-keyr-tab :
      386     define input  parameter i-tableSerach as character no-undo.
      387     define input  parameter i-tablekey   as character no-undo.
      388     define input  parameter p-key-rec    as character no-undo.
      389     define input  parameter p-key-handle as handle    no-undo .
      390     define input  parameter p-db-name    as character no-undo .
      391     define input  parameter p-tt-handle  as handle    no-undo .
      392     define input  parameter p-stts-lock  as integer   no-undo .
      393     define output parameter o-hn         as handle    no-undo.
      394     define variable v-full-tbl-name as character no-undo.
      395     define variable v-where         as character no-undo.
      396     define variable bh_tbl-name     as handle    no-undo.
      397     define variable vTable          as character no-undo.
      398     do
      399     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      400     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      401     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      402         run gen-where-keyr-tab(i-tableSerach,
      403                                i-tablekey,
      404                                p-key-rec,
      405                                p-key-handle,
      406                                p-db-name,
      407                                p-tt-handle,
      408                                output v-where).
      409         if i-tableSerach ne "" and i-tableSerach ne ?
      410         then do:
      411            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      412            create buffer bh_tbl-name for table v-full-tbl-name .
      413         end.
      414         else do:
      415            if p-tt-handle = ? then do:
      416               assign
      417                  vTable = entry( 1 , p-key-rec, chr(3) )
      418               .
      419               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      420               create buffer bh_tbl-name for table v-full-tbl-name .
      421            end.
      422            else do:
      423               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      424            end.
      425         end.
      426         if p-tt-handle = ? then do:
      427            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      428         end.
      429         else do:
      430            bh_tbl-name:find-first( v-where ) no-error .
      431         end.
      432         o-hn = bh_tbl-name.
      433      end.
      434   end procedure.
      435   procedure gen-hn-keyr :
      436     define input  parameter p-key-rec    as character no-undo.
      437     define input  parameter p-key-handle as handle    no-undo .
      438     define input  parameter p-db-name    as character no-undo .
      439     define input  parameter p-tt-handle  as handle    no-undo .
      440     define input  parameter p-stts-lock  as integer   no-undo .
      441     define output parameter o-hn         as handle    no-undo.
      442     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      443   end.
      444   procedure gen-row-keyr :
      445     define input  parameter p-key-rec    as character no-undo.
      446     define input  parameter p-key-handle as handle    no-undo .
      447     define input  parameter p-db-name    as character no-undo .
      448     define input  parameter p-tt-handle  as handle    no-undo .
      449     define input  parameter p-stts-lock  as integer   no-undo .
      450     define output parameter p-tbl-row    as rowid     no-undo.
      451     define output parameter p-tbl-name   as character no-undo.
      452     define variable vHn as handle no-undo.
      453       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      454       p-tbl-row = if vHn:available then vHn:rowid else ?.
      455       p-tbl-name =  vHn:table.
      456       delete object vHn no-error.
      457     if p-tbl-row = ? then do:
      458       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      459     end.
      460     else do:
      461       return.
      462     end.
      463   end procedure.
      464   procedure gen-key-fv :
      465     define input  parameter p-key-rec    as character no-undo .
      466     define output parameter p-field-list as character no-undo .
      467     define output parameter p-value-list as character no-undo.
      468     do
      469     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      470     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      471     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      472     :
      473       define variable v-full-tbl-name  as character no-undo .
      474       define variable bh_tbl-name      as handle    no-undo .
      475       define variable v-tbl-name       as character no-undo .
      476       define variable v-field-num      as integer   no-undo .
      477       define variable v-count-fld      as integer   no-undo .
      478       define variable v-inform         as character no-undo .
      479       define variable v-ind            as integer   no-undo .
      480       define variable v-idx-field-qnty as integer   no-undo .
      481       define variable v-delim-key      as character no-undo .
      482       if p-key-rec = ?
      483         or p-key-rec = "":U
      484       then do:
      485         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      486       end.
      487       assign
      488         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      489         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      490       .
      491       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      492       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      493       assign
      494         v-inform = bh_tbl-name:index-information(1)
      495         v-ind    = 2
      496       .
      497       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      498       on error undo, return error
      499       :
      500         assign
      501           v-inform = bh_tbl-name:index-information( v-ind )
      502           v-ind    = v-ind + 1
      503         .
      504       end.
      505       if v-inform = ?
      506         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      507         or entry( 3, v-inform, ",":U ) <> "1":U
      508       then do:
      509         delete object bh_tbl-name no-error.
      510         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      511       end.
      512       assign
      513         v-idx-field-qnty = num-entries( v-inform ) - 4
      514       .
      515       if v-idx-field-qnty < 2 then do:
      516         delete object bh_tbl-name no-error.
      517         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      518       end.
      519       assign
      520         p-field-list = "":U
      521         p-value-list = "":U
      522         v-delim-key  = "":U
      523         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      524         v-count-fld  = 0
      525       .
      526       block_where:
      527       do v-ind = 1 to v-idx-field-qnty by 2
      528       on error undo, return error
      529       :
      530         assign
      531           v-count-fld = v-count-fld + 1
      532         .
      533         if v-count-fld > v-field-num then do:
      534           leave block_where.
      535         end.
      536         assign
      537           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      538           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      539         .
      540         if v-ind = 1 then do:
      541           assign
      542             v-delim-key = chr(3)
      543           .
      544         end.
      545       end.
      546       delete object bh_tbl-name.
      547       if v-count-fld <> v-field-num then do:
      548         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      549       end.
      550     end.
      551   end procedure.
      552   procedure gen-key-field :
      553     define input  parameter p-table      as character no-undo .
      554     define output parameter p-field-list as character no-undo .
      555     do
      556     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      557     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      558     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      559     :
      560       define variable v-full-tbl-name  as character no-undo .
      561       define variable bh_tbl-name      as handle    no-undo .
      562       define variable v-tbl-name       as character no-undo .
      563       define variable v-field-num      as integer   no-undo .
      564       define variable v-count-fld      as integer   no-undo .
      565       define variable v-inform         as character no-undo .
      566       define variable v-ind            as integer   no-undo .
      567       define variable v-idx-field-qnty as integer   no-undo .
      568       define variable v-delim-key      as character no-undo .
      569       if p-table = ?
      570         or p-table = "":U
      571       then do:
      572         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      573       end.
      574       assign
      575         v-tbl-name      = p-table
      576         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      577       .
      578       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      579       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      580       assign
      581         v-inform = bh_tbl-name:index-information(1)
      582         v-ind    = 2
      583       .
      584       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      585       on error undo, return error
      586       :
      587         assign
      588           v-inform = bh_tbl-name:index-information( v-ind )
      589           v-ind    = v-ind + 1
      590         .
      591       end.
      592       if v-inform = ?
      593         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      594         or entry( 3, v-inform, ",":U ) <> "1":U
      595       then do:
      596         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      597       end.
      598       assign
      599         v-idx-field-qnty = num-entries( v-inform ) - 4
      600       .
      601       if v-idx-field-qnty < 2 then do:
      602         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      603       end.
      604       assign
      605         p-field-list = "":U
      606         v-delim-key  = "":U
      607         v-count-fld  = 0
      608       .
      609       block_where:
      610       do v-ind = 1 to v-idx-field-qnty by 2
      611       on error undo, return error
      612       :
      613         assign
      614           v-count-fld = v-count-fld + 1
      615         .
      616         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      617         if v-ind = 1 then do:
      618           assign
      619             v-delim-key = chr(3)
      620           .
      621         end.
      622       end.
      623       delete object bh_tbl-name.
      624     end.
      625   end procedure.
      626   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      627   procedure thth150-db-attr-code :
      628     do
      629     on error undo, return error
      630     :
      631       define input  parameter p-code           as character no-undo .
      632       define output parameter p-type           as character no-undo .
      633       define output parameter p-format         as character no-undo .
      634       define output parameter p-label          as character no-undo .
      635       define output parameter p-user-can-edit  as logical   no-undo .
      636       define output parameter p-output-display as logical   no-undo .
      637       define output parameter p-other          as character no-undo .
      638       case p-code :
      639               when 'thth150-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      640               when 'thth150-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      641               when 'thth150-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      642               when 'thth150-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      643               when 'thth150-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      644               when 'thth150-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      645               when 'thth150-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      646               when 'thth150-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      647               when 'thth150-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      648               when 'thth150-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      649         otherwise do:
      650           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      651         end.
      652       end.
      653     end.
      654   end procedure.
      655   procedure thth150-db-attr-tooltip :
      656     do
      657     on error undo, return error
      658     :
      659       define input  parameter p-code    as character no-undo .
      660       define output parameter p-tooltip as character no-undo .
      661       define output parameter p-label   as character no-undo .
      662       case p-code :
      663               when 'thth150-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
      664               when 'thth150-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
      665               when 'thth150-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
      666               when 'thth150-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
      667               when 'thth150-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
      668               when 'thth150-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
      669               when 'thth150-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
      670               when 'thth150-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
      671               when 'thth150-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
      672               when 'thth150-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
      673         otherwise do:
      674           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      675         end.
      676       end.
      677     end.
      678   end procedure.
      679   procedure thth150-db-attr-value :
      680     do
      681     on error undo, return error
      682     :
      683       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      684       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      685       define output parameter p-value     like ub.db-attr.attr-value no-undo .
      686       define output parameter p-type      as character no-undo .
      687       define buffer buf_db-attr for ub.db-attr .
      688       define variable v-format         as character no-undo .
      689       define variable v-label          as character no-undo .
      690       define variable v-user-can-edit  as logical   no-undo .
      691       define variable v-output-display as logical   no-undo .
      692       define variable v-other          as character no-undo .
      693       run thth150-db-attr-code in this-procedure
      694         (input  p-code
      695         ,output p-type
      696         ,output v-format
      697         ,output v-label
      698         ,output v-user-can-edit
      699         ,output v-output-display
      700         ,output v-other
      701         ) no-error .
      702       if error-status :error then do:
      703         undo, return error return-value .
      704       end.
      705       find first buf_db-attr no-lock
      706         where buf_db-attr.db-num    = p-db-num
      707           and buf_db-attr.attr-code = p-code
      708         no-error .
      709       if avail buf_db-attr then do:
      710         assign
      711           p-value =  buf_db-attr.attr-value
      712         .
      713       end.
      714       else do:
      715         assign
      716           p-value = if p-type = 'L':U then "no":U else ""
      717         .
      718       end.
      719     end.
      720   end procedure.
      721   procedure thth150-db-attr-write :
      722     do
      723     on error undo, return error
      724     :
      725       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      726       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      727       define input parameter p-value     like ub.db-attr.attr-value no-undo .
      728       define buffer buf_db-attr for ub.db-attr .
      729       define variable v-type           as character no-undo .
      730       define variable v-format         as character no-undo .
      731       define variable v-label          as character no-undo .
      732       define variable v-user-can-edit  as logical   no-undo .
      733       define variable v-output-display as logical   no-undo .
      734       define variable v-other          as character no-undo .
      735       run thth150-db-attr-code in this-procedure
      736         (input  p-code
      737         ,output v-type
      738         ,output v-format
      739         ,output v-label
      740         ,output v-user-can-edit
      741         ,output v-output-display
      742         ,output v-other
      743         ) no-error .
      744       if error-status :error then do:
      745         undo, return error return-value .
      746       end.
      747       find first buf_db-attr exclusive-lock
      748         where buf_db-attr.db-num    = p-db-num
      749           and buf_db-attr.attr-code = p-code
      750         no-error .
      751       if not available buf_db-attr then do:
      752         create buf_db-attr .
      753         assign
      754           buf_db-attr.db-num    = p-db-num
      755           buf_db-attr.attr-code = p-code
      756         .
      757       end.
      758       assign
      759         buf_db-attr.attr-value = p-value
      760       .
      761     end.
      762   end procedure.
      763   procedure thth150-db-attr-exist :
      764     do
      765     on error undo, return error
      766     :
      767       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      768       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      769       define output parameter p-exist    as logical  no-undo .
      770       define buffer buf_db-attr for ub.db-attr .
      771       define variable v-type           as character no-undo .
      772       define variable v-format         as character no-undo .
      773       define variable v-label          as character no-undo .
      774       define variable v-user-can-edit  as logical   no-undo .
      775       define variable v-output-display as logical   no-undo .
      776       define variable v-other          as character no-undo .
      777       run thth150-db-attr-code in this-procedure
      778         (input  p-code
      779         ,output v-type
      780         ,output v-format
      781         ,output v-label
      782         ,output v-user-can-edit
      783         ,output v-output-display
      784         ,output v-other
      785         ) no-error .
      786       if error-status :error then do:
      787         undo, return error return-value .
      788       end.
      789       find first buf_db-attr no-lock
      790         where buf_db-attr.db-num    = p-db-num
      791           and buf_db-attr.attr-code = p-code
      792         no-error .
      793       if  available buf_db-attr then do:
      794         p-exist = yes.
      795       end.
      796     end.
      797   end procedure.
      798   procedure thth150-db-attr-delete :
      799     do
      800     on error undo, return error
      801     :
      802       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
      803       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
      804       define output parameter p-deleted  as logical no-undo.
      805       define buffer buf_db-attr for ub.db-attr .
      806       define variable v-type           as character no-undo .
      807       define variable v-format         as character no-undo .
      808       define variable v-label          as character no-undo .
      809       define variable v-user-can-edit  as logical   no-undo .
      810       define variable v-output-display as logical   no-undo .
      811       define variable v-other          as character no-undo .
      812       run thth150-db-attr-code in this-procedure
      813         (input  p-code
      814         ,output v-type
      815         ,output v-format
      816         ,output v-label
      817         ,output v-user-can-edit
      818         ,output v-output-display
      819         ,output v-other
      820         ) no-error .
      821       if error-status :error then do:
      822         undo, return error return-value .
      823       end.
      824       find first buf_db-attr exclusive-lock
      825         where buf_db-attr.db-num    = p-db-num
      826           and buf_db-attr.attr-code = p-code
      827         no-error NO-WAIT.
      828       if not available buf_db-attr then do:
      829         p-deleted = no.
      830       end.
      831       else do:
      832         delete buf_db-attr.
      833         p-deleted = yes.
      834       end.
      835     end.
      836   end procedure.
      837   procedure thth150-db-attr-news :
      838     do
      839     on error undo, return error
      840     :
      841       define input  parameter p-code           as character no-undo .
      842       define output parameter p-news           as logical   no-undo .
      843       case p-code :
      844               when 'thth150-cli-grp':U then do:     assign     p-news = no.   end.
      845               when 'thth150-gds-grp':U then do:     assign     p-news = no.   end.
      846               when 'thth150-clients':U then do:     assign     p-news = no.   end.
      847               when 'thth150-goods':U then do:     assign     p-news = no.   end.
      848               when 'thth150-dis-card':U then do:     assign     p-news = no.   end.
      849               when 'thth150-qnty-dis-card':U then do:     assign     p-news = no.   end.
      850               when 'thth150-shop':U then do:     assign     p-news = no.   end.
      851               when 'thth150-contract':U then do:     assign     p-news = no.   end.
      852               when 'thth150-price-doc':U then do:     assign     p-news = no.   end.
      853               when 'thth150-trn-doc':U then do:     assign     p-news = no.   end.
      854         otherwise do:
      855           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      856         end.
      857       end.
      858     end.
      859   end procedure.
      860   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   procedure thth14-db-attr-code :
      862     do
      863     on error undo, return error
      864     :
      865       define input  parameter p-code           as character no-undo .
      866       define output parameter p-type           as character no-undo .
      867       define output parameter p-format         as character no-undo .
      868       define output parameter p-label          as character no-undo .
      869       define output parameter p-user-can-edit  as logical   no-undo .
      870       define output parameter p-output-display as logical   no-undo .
      871       define output parameter p-other          as character no-undo .
      872       case p-code :
      873               when 'thth14-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      874               when 'thth14-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      875               when 'thth14-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      876               when 'thth14-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      877               when 'thth14-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      878               when 'thth14-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      879               when 'thth14-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      880               when 'thth14-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      881               when 'thth14-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      882               when 'thth14-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      883         otherwise do:
      884           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      885         end.
      886       end.
      887     end.
      888   end procedure.
      889   procedure thth14-db-attr-tooltip :
      890     do
      891     on error undo, return error
      892     :
      893       define input  parameter p-code    as character no-undo .
      894       define output parameter p-tooltip as character no-undo .
      895       define output parameter p-label   as character no-undo .
      896       case p-code :
      897               when 'thth14-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
      898               when 'thth14-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
      899               when 'thth14-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
      900               when 'thth14-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
      901               when 'thth14-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
      902               when 'thth14-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
      903               when 'thth14-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
      904               when 'thth14-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
      905               when 'thth14-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
      906               when 'thth14-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
      907         otherwise do:
      908           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      909         end.
      910       end.
      911     end.
      912   end procedure.
      913   procedure thth14-db-attr-value :
      914     do
      915     on error undo, return error
      916     :
      917       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      918       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      919       define output parameter p-value     like ub.db-attr.attr-value no-undo .
      920       define output parameter p-type      as character no-undo .
      921       define buffer buf_db-attr for ub.db-attr .
      922       define variable v-format         as character no-undo .
      923       define variable v-label          as character no-undo .
      924       define variable v-user-can-edit  as logical   no-undo .
      925       define variable v-output-display as logical   no-undo .
      926       define variable v-other          as character no-undo .
      927       run thth14-db-attr-code in this-procedure
      928         (input  p-code
      929         ,output p-type
      930         ,output v-format
      931         ,output v-label
      932         ,output v-user-can-edit
      933         ,output v-output-display
      934         ,output v-other
      935         ) no-error .
      936       if error-status :error then do:
      937         undo, return error return-value .
      938       end.
      939       find first buf_db-attr no-lock
      940         where buf_db-attr.db-num    = p-db-num
      941           and buf_db-attr.attr-code = p-code
      942         no-error .
      943       if avail buf_db-attr then do:
      944         assign
      945           p-value =  buf_db-attr.attr-value
      946         .
      947       end.
      948       else do:
      949         assign
      950           p-value = if p-type = 'L':U then "no":U else ""
      951         .
      952       end.
      953     end.
      954   end procedure.
      955   procedure thth14-db-attr-write :
      956     do
      957     on error undo, return error
      958     :
      959       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      960       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      961       define input parameter p-value     like ub.db-attr.attr-value no-undo .
      962       define buffer buf_db-attr for ub.db-attr .
      963       define variable v-type           as character no-undo .
      964       define variable v-format         as character no-undo .
      965       define variable v-label          as character no-undo .
      966       define variable v-user-can-edit  as logical   no-undo .
      967       define variable v-output-display as logical   no-undo .
      968       define variable v-other          as character no-undo .
      969       run thth14-db-attr-code in this-procedure
      970         (input  p-code
      971         ,output v-type
      972         ,output v-format
      973         ,output v-label
      974         ,output v-user-can-edit
      975         ,output v-output-display
      976         ,output v-other
      977         ) no-error .
      978       if error-status :error then do:
      979         undo, return error return-value .
      980       end.
      981       find first buf_db-attr exclusive-lock
      982         where buf_db-attr.db-num    = p-db-num
      983           and buf_db-attr.attr-code = p-code
      984         no-error .
      985       if not available buf_db-attr then do:
      986         create buf_db-attr .
      987         assign
      988           buf_db-attr.db-num    = p-db-num
      989           buf_db-attr.attr-code = p-code
      990         .
      991       end.
      992       assign
      993         buf_db-attr.attr-value = p-value
      994       .
      995     end.
      996   end procedure.
      997   procedure thth14-db-attr-exist :
      998     do
      999     on error undo, return error
     1000     :
     1001       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     1002       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     1003       define output parameter p-exist    as logical  no-undo .
     1004       define buffer buf_db-attr for ub.db-attr .
     1005       define variable v-type           as character no-undo .
     1006       define variable v-format         as character no-undo .
     1007       define variable v-label          as character no-undo .
     1008       define variable v-user-can-edit  as logical   no-undo .
     1009       define variable v-output-display as logical   no-undo .
     1010       define variable v-other          as character no-undo .
     1011       run thth14-db-attr-code in this-procedure
     1012         (input  p-code
     1013         ,output v-type
     1014         ,output v-format
     1015         ,output v-label
     1016         ,output v-user-can-edit
     1017         ,output v-output-display
     1018         ,output v-other
     1019         ) no-error .
     1020       if error-status :error then do:
     1021         undo, return error return-value .
     1022       end.
     1023       find first buf_db-attr no-lock
     1024         where buf_db-attr.db-num    = p-db-num
     1025           and buf_db-attr.attr-code = p-code
     1026         no-error .
     1027       if  available buf_db-attr then do:
     1028         p-exist = yes.
     1029       end.
     1030     end.
     1031   end procedure.
     1032   procedure thth14-db-attr-delete :
     1033     do
     1034     on error undo, return error
     1035     :
     1036       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
     1037       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     1038       define output parameter p-deleted  as logical no-undo.
     1039       define buffer buf_db-attr for ub.db-attr .
     1040       define variable v-type           as character no-undo .
     1041       define variable v-format         as character no-undo .
     1042       define variable v-label          as character no-undo .
     1043       define variable v-user-can-edit  as logical   no-undo .
     1044       define variable v-output-display as logical   no-undo .
     1045       define variable v-other          as character no-undo .
     1046       run thth14-db-attr-code in this-procedure
     1047         (input  p-code
     1048         ,output v-type
     1049         ,output v-format
     1050         ,output v-label
     1051         ,output v-user-can-edit
     1052         ,output v-output-display
     1053         ,output v-other
     1054         ) no-error .
     1055       if error-status :error then do:
     1056         undo, return error return-value .
     1057       end.
     1058       find first buf_db-attr exclusive-lock
     1059         where buf_db-attr.db-num    = p-db-num
     1060           and buf_db-attr.attr-code = p-code
     1061         no-error NO-WAIT.
     1062       if not available buf_db-attr then do:
     1063         p-deleted = no.
     1064       end.
     1065       else do:
     1066         delete buf_db-attr.
     1067         p-deleted = yes.
     1068       end.
     1069     end.
     1070   end procedure.
     1071   procedure thth14-db-attr-news :
     1072     do
     1073     on error undo, return error
     1074     :
     1075       define input  parameter p-code           as character no-undo .
     1076       define output parameter p-news           as logical   no-undo .
     1077       case p-code :
     1078               when 'thth14-cli-grp':U then do:     assign     p-news = no.   end.
     1079               when 'thth14-gds-grp':U then do:     assign     p-news = no.   end.
     1080               when 'thth14-clients':U then do:     assign     p-news = no.   end.
     1081               when 'thth14-goods':U then do:     assign     p-news = no.   end.
     1082               when 'thth14-dis-card':U then do:     assign     p-news = no.   end.
     1083               when 'thth14-qnty-dis-card':U then do:     assign     p-news = no.   end.
     1084               when 'thth14-shop':U then do:     assign     p-news = no.   end.
     1085               when 'thth14-contract':U then do:     assign     p-news = no.   end.
     1086               when 'thth14-price-doc':U then do:     assign     p-news = no.   end.
     1087               when 'thth14-trn-doc':U then do:     assign     p-news = no.   end.
     1088         otherwise do:
     1089           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     1090         end.
     1091       end.
     1092     end.
     1093   end procedure.
     1094    define variable v-log as logical   no-undo .
     1095    define variable p-var as integer   no-undo .
     1096    define variable v-cli-classif-name as character no-undo .
     1097   DEFINE BUTTON B-Cancel AUTO-END-KEY
     1098        LABEL "Вы&ход"
     1099        SIZE 10 BY 1
     1100        BGCOLOR 8 .
     1101   DEFINE BUTTON B-Help
     1102        LABEL "&Help"
     1103        SIZE 3.25 BY 1.13
     1104        BGCOLOR 8 .
     1105   DEFINE BUTTON B-mark
     1106        LABEL "&*"
     1107        SIZE 3 BY 1
     1108        BGCOLOR 8 .
     1109   DEFINE BUTTON B-OK AUTO-GO
     1110        LABEL "&Создать"
     1111        SIZE 10 BY 1
     1112        BGCOLOR 8 .
     1113   DEFINE QUERY br-obj FOR
     1114         tt_obj-list SCROLLING.
     1115   DEFINE BROWSE br-obj
     1116     QUERY br-obj NO-LOCK DISPLAY
     1117         tt_obj-list.buy-cons FORMAT "*/ ":U column-label "*"
     1118         tt_obj-list.obj-type FORMAT "X(3)":U
     1119         tt_obj-list.obj-code FORMAT ">>>>>>>>9":U
     1120         tt_obj-list.db-num FORMAT ">>>>9":U    column-label "БД"
     1121         tt_obj-list.obj-name FORMAT "X(30)":U  column-label "Наименование"
     1122         tt_obj-list.grp-name FORMAT "X(40)":U  column-label "Наименование16.0"
     1123       WITH NO-ROW-MARKERS SEPARATORS SIZE 87 BY 16.83 FIT-LAST-COLUMN.
     1124   DEFINE FRAME Dialog-Frame
     1125        B-Cancel AT ROW 1 COL 2
     1126        B-mark AT ROW 1 COL 16 WIDGET-ID 2
     1127        B-OK AT ROW 1 COL 19.13
     1128        B-Help AT ROW 1 COL 85
     1129        br-obj AT ROW 2.17 COL 1.75 WIDGET-ID 200
     1130        SPACE(0.49) SKIP(0.03)
     1131       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1132            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1133            TITLE "Отчет по объектам"
     1134            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
     1135   ASSIGN
     1136          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1137          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1138   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1139   DO:
     1140     APPLY "END-ERROR":U TO SELF.
     1141   END.
     1142   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
     1143   OR HELP OF FRAME Dialog-Frame
     1144   DO:
     1145   END.
     1146   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1147   DO:
     1148   if   tt_obj-list.buy-cons then  tt_obj-list.buy-cons = no.
     1149        else  tt_obj-list.buy-cons = yes.
     1150        v-log = br-obj:refresh() .
     1151        v-log = br-obj:select-next-row() .
     1152        apply "VALUE-CHANGED" to br-obj in frame Dialog-Frame.
     1153   END.
     1154   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
     1155   DO:
     1156     run proc-exec in this-procedure no-error .
     1157     if error-status :error then return no-apply .
     1158   END.
     1159   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1160   on help of frame Dialog-Frame
     1161   do:
     1162     run gbl/app_help.p
     1163       (input this-procedure :file-name
     1164       ,input ''
     1165       ,input ?
     1166       ) no-error.
     1167     if error-status :error then do:
     1168       message
     1169         "Ошибка при вызове помощи"
     1170         error-status :get-message(1)
     1171         view-as alert-box .
     1172     end.
     1173   end.
     1174   run minbtn-set in this-procedure .
     1175   on choose of b-help in frame Dialog-Frame
     1176   do:
     1177     apply "help":u to frame Dialog-Frame .
     1178   end.
     1179   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   procedure minbtn-set :
     1181       do
     1182           on error undo, return error return-value
     1183           :
     1184           define variable ii              as integer       no-undo .
     1185           define variable fh              as widget-handle no-undo .
     1186           define variable hh              as widget-handle no-undo .
     1187           define variable v-h             as handle        extent 4 no-undo .
     1188           define variable v-name-button   as character     no-undo .
     1189           define variable v-help-old-x    as decimal       no-undo .
     1190           define variable v-help-old-y    as decimal       no-undo .
     1191           define variable v-help-old-size as decimal       no-undo .
     1192           define variable v-frame-width   as decimal       no-undo .
     1193           define variable jj              as integer       no-undo .
     1194           do
     1195               on error undo, return error
     1196               :
     1197               assign
     1198                   v-frame-width = frame Dialog-Frame:width - 0.3
     1199                   fh            = frame Dialog-Frame:first-child
     1200                   hh            = fh:first-child
     1201                   ii            = 1
     1202                   .
     1203               do while valid-handle(hh):
     1204                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1205                   do:
     1206                       case lc(hh:name) :
     1207                           when "b-help" then
     1208                               do:
     1209                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1210                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1211                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1212                                   hh:TOOLTIP = "Помощь" .
     1213                                   v-help-old-x = hh:column .
     1214                                   v-help-old-y = hh:row    .
     1215                                   v-help-old-size = hh:width .
     1216                                   hh:width-chars = 2.5 .
     1217                               end.
     1218                           when "b-print" then
     1219                               do:
     1220                                   hh:load-image("cmp/b-print.bmp":u) .
     1221                                   hh:TOOLTIP = "Печать" .
     1222                                   v-h[ii] = hh:handle .
     1223                                   ii = ii + 1 .
     1224                                   hh:width-chars = 3 .
     1225                               end.
     1226                           when "b-history" or
     1227                           when "b-hist" then
     1228                               do:
     1229                                   hh:load-image("cmp/b-hist.bmp":u) .
     1230                                   hh:TOOLTIP = "История" .
     1231                                   v-h[ii] = hh:handle .
     1232                                   ii = ii + 1 .
     1233                                   hh:width-chars = 3 .
     1234                               end.
     1235                           when "b-sch" then
     1236                               do:
     1237                                   hh:load-image("cmp/b-sch.bmp":u) .
     1238                                   hh:TOOLTIP = "Установка Фильтра" .
     1239                                   v-h[ii] = hh:handle .
     1240                                   ii = ii + 1 .
     1241                                   hh:width-chars = 3 .
     1242                               end.
     1243                           when "b-hist-user" then
     1244                               do:
     1245                                   hh:load-image("cmp/b-hist.bmp":u) .
     1246                                   hh:TOOLTIP = "История пользователя" .
     1247                                   ii = ii + 1 .
     1248                               end.
     1249                       end case.
     1250                   end.
     1251                   hh = hh:next-sibling.
     1252               end.
     1253               b-help:column = v-frame-width - b-help:width-chars.
     1254               jj = 0.
     1255               repeat ii = 4 to 1 by -1 :
     1256                   if valid-handle (v-h[ii] ) then
     1257                   do:
     1258                       jj  = jj + 1 .
     1259                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1260                       v-h[ii]:row    = v-help-old-y .
     1261                   end.
     1262               end.
     1263           end.
     1264       end.
     1265   end procedure.
     1266   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1267   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1268   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1269   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1270   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1271   define variable v-diasize-current-frame-height as decimal   no-undo .
     1272   define variable v-diasize-change-size          as logical   no-undo .
     1273   define variable v-diasize-resize-button        as handle    no-undo .
     1274   define variable v-diasize-wndmax               as logical   no-undo .
     1275   define variable v-diasize-wndstore             as logical   no-undo .
     1276   define variable v-diasize-proc-name            as character no-undo .
     1277   define variable v-diasize-browse-handle        as handle    no-undo .
     1278   define variable v-diasize-browse-number        as integer   no-undo .
     1279   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1280   define temp-table temp-diasize-handle no-undo
     1281     field handle-value  as handle
     1282     field save-position as decimal
     1283     index xpk is primary unique handle-value
     1284     .
     1285   define temp-table temp-browse-handle no-undo
     1286     field browse-type   as character
     1287     field browse-number as integer
     1288     field browse-handle as handle
     1289     field original-size as decimal
     1290     index xpk is primary unique browse-type browse-number
     1291     index xie browse-type browse-handle
     1292   .
     1293   procedure diasize_change-height :
     1294     define input  parameter p-change-value  as decimal   no-undo .
     1295     define input  parameter p-move-resize   as logical   no-undo .
     1296     define variable v-field-group-handle    as handle    no-undo .
     1297     define variable v-object-handle         as handle    no-undo .
     1298     define variable v-frame-height          as decimal   no-undo .
     1299     define variable v-frame-virtual-height  as decimal   no-undo .
     1300     define variable v-browse-height         as decimal   no-undo .
     1301     define variable v-window-height         as decimal   no-undo .
     1302     define variable v-window-virtual-height as decimal   no-undo .
     1303     define variable v-change-sign           as integer   no-undo .
     1304     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1305     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1306     if p-change-value > 0
     1307     then do:
     1308       if frame Dialog-Frame :height + p-change-value
     1309           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1310       then do:
     1311         assign
     1312           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1313                           - (frame Dialog-Frame :height-chars)
     1314         .
     1315         if p-change-value <= 0
     1316         then do:
     1317           run diasize_position-resize-button in this-procedure .
     1318           return .
     1319         end.
     1320       end.
     1321     end.
     1322     if p-change-value < 0
     1323     then do:
     1324       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1325       then do:
     1326         assign
     1327           p-change-value = v-diasize-orig-frame-height
     1328                          - (frame Dialog-Frame :height-chars)
     1329         .
     1330         if p-change-value >= 0
     1331         then do:
     1332           run diasize_position-resize-button in this-procedure .
     1333           return .
     1334         end.
     1335       end.
     1336     end.
     1337     if p-change-value >= 0
     1338     then do:
     1339       assign
     1340         v-change-sign = 1
     1341       .
     1342     end.
     1343     else do:
     1344       assign
     1345         v-change-sign = -1
     1346       .
     1347     end.
     1348     assign
     1349       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1350     .
     1351     if p-change-value = 0
     1352     then do:
     1353       run diasize_position-resize-button in this-procedure .
     1354       return .
     1355     end.
     1356     move_block:
     1357     do
     1358     on error undo move_block, retry move_block
     1359     :
     1360       if retry
     1361       then do:
     1362         do
     1363         on error undo move_block, leave move_block
     1364         :
     1365           if p-change-value > 0
     1366           then do:
     1367             for each buf_temp-diasize-handle
     1368             on error undo, next
     1369             :
     1370               assign
     1371                 v-object-handle = buf_temp-diasize-handle.handle-value
     1372               .
     1373               if v-object-handle <> v-diasize-resize-button
     1374               then do:
     1375                 assign
     1376                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1377                 .
     1378               end.
     1379             end.
     1380             assign
     1381               v-diasize-browse-handle :height = v-browse-height
     1382             .
     1383             for each buf_temp-browse-handle
     1384               where buf_temp-browse-handle.browse-type = 'height':u
     1385             on error undo, next
     1386             :
     1387               assign
     1388                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1389               .
     1390             end.
     1391             assign
     1392               frame Dialog-Frame :height = v-frame-height
     1393             .
     1394             if frame Dialog-Frame :scrollable = true
     1395             then do:
     1396               assign
     1397                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1398               .
     1399             end.
     1400             run diasize_position-resize-button in this-procedure .
     1401           end.
     1402           else do:
     1403             if frame Dialog-Frame :scrollable = true
     1404             then do:
     1405               assign
     1406                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1407               .
     1408             end.
     1409             assign
     1410               frame Dialog-Frame :height = v-frame-height
     1411             .
     1412             assign
     1413               v-diasize-browse-handle :height = v-browse-height
     1414             .
     1415             for each buf_temp-browse-handle
     1416               where buf_temp-browse-handle.browse-type = 'height':u
     1417             on error undo, next
     1418             :
     1419               assign
     1420                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1421               .
     1422             end.
     1423             for each buf_temp-diasize-handle
     1424             on error undo, next
     1425             :
     1426               assign
     1427                 v-object-handle = buf_temp-diasize-handle.handle-value
     1428               .
     1429               if v-object-handle <> v-diasize-resize-button
     1430               then do:
     1431                 assign
     1432                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1433                 .
     1434               end.
     1435             end.
     1436             run diasize_position-resize-button in this-procedure .
     1437           end.
     1438           assign
     1439             v-diasize-change-size = false
     1440           .
     1441           leave move_block .
     1442         end.
     1443       end.
     1444       assign
     1445         v-diasize-need-full-display = true
     1446       .
     1447       if v-diasize-change-size = false
     1448       then do:
     1449         assign
     1450           v-diasize-change-size = true
     1451         .
     1452       end.
     1453       else do:
     1454         return .
     1455       end.
     1456       assign
     1457         v-frame-height = frame Dialog-Frame :height
     1458         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1459         v-browse-height = v-diasize-browse-handle :height
     1460       .
     1461       for each buf_temp-browse-handle
     1462         where buf_temp-browse-handle.browse-type = 'height':u
     1463       :
     1464         assign
     1465           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1466         .
     1467       end.
     1468       for each buf_temp-diasize-handle
     1469       :
     1470         delete buf_temp-diasize-handle .
     1471       end.
     1472       assign
     1473         v-field-group-handle = frame Dialog-Frame :first-child
     1474       .
     1475       do while valid-handle(v-field-group-handle)
     1476       :
     1477         assign
     1478           v-object-handle = v-field-group-handle :first-child
     1479         .
     1480         do while valid-handle(v-object-handle)
     1481         :
     1482           if  v-object-handle <> v-diasize-browse-handle :handle
     1483           and can-query(v-object-handle, "row")
     1484           and can-query(v-object-handle, "height")
     1485           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1486           then do:
     1487             find first buf_temp-browse-handle
     1488               where buf_temp-browse-handle.browse-type   = 'height':u
     1489                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1490               no-error .
     1491             if available buf_temp-browse-handle
     1492             then do:
     1493             end.
     1494             else do:
     1495               create buf_temp-diasize-handle .
     1496               assign
     1497                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1498                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1499               .
     1500             end.
     1501           end.
     1502           assign
     1503             v-object-handle = v-object-handle :next-sibling
     1504           .
     1505         end.
     1506         assign
     1507           v-field-group-handle = v-field-group-handle :next-sibling
     1508         .
     1509       end.
     1510       do with frame Dialog-Frame
     1511       :
     1512         hide v-diasize-resize-button .
     1513         assign
     1514           v-diasize-resize-button :row    = 1
     1515           v-diasize-resize-button :column = 1
     1516         .
     1517       end.
     1518       if p-change-value > 0
     1519       then do:
     1520         if frame Dialog-Frame :scrollable = true
     1521         then do:
     1522           assign
     1523             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1524             no-error .
     1525           if error-status :error
     1526           or error-status :get-message(1) <> ""
     1527           then do:
     1528             undo move_block, retry move_block .
     1529           end.
     1530         end.
     1531         assign
     1532           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1533           no-error .
     1534         if error-status :error
     1535         or error-status :get-message(1) <> ""
     1536         then do:
     1537           undo move_block, retry move_block .
     1538         end.
     1539         assign
     1540           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1541           no-error .
     1542         if error-status :error
     1543         or error-status :get-message(1) <> ""
     1544         then do:
     1545           undo move_block, retry move_block .
     1546         end.
     1547         for each buf_temp-browse-handle
     1548           where buf_temp-browse-handle.browse-type = 'height':u
     1549         on error undo move_block, retry move_block
     1550         :
     1551           assign
     1552             buf_temp-browse-handle.browse-handle :height
     1553               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1554             no-error .
     1555           if error-status :error
     1556           or error-status :get-message(1) <> ""
     1557           then do:
     1558             undo move_block, retry move_block .
     1559           end.
     1560         end.
     1561         for each buf_temp-diasize-handle
     1562         on error undo move_block, retry move_block
     1563         :
     1564           assign
     1565             v-object-handle = buf_temp-diasize-handle.handle-value
     1566           .
     1567           if v-object-handle <> v-diasize-resize-button
     1568           then do:
     1569             assign
     1570               v-object-handle :row = v-object-handle :row + p-change-value
     1571               no-error .
     1572             if error-status :error
     1573             or error-status :get-message(1) <> ""
     1574             then do:
     1575               undo move_block, retry move_block .
     1576             end.
     1577           end.
     1578         end.
     1579       end.
     1580       else do:
     1581         for each buf_temp-diasize-handle
     1582         on error undo move_block, retry move_block
     1583         :
     1584           assign
     1585             v-object-handle = buf_temp-diasize-handle.handle-value
     1586           .
     1587           if v-object-handle <> v-diasize-resize-button
     1588           then do:
     1589             assign
     1590               v-object-handle :row = v-object-handle :row + p-change-value
     1591               no-error .
     1592             if error-status :error
     1593             or error-status :get-message(1) <> ""
     1594             then do:
     1595               undo move_block, retry move_block .
     1596             end.
     1597           end.
     1598         end.
     1599         assign
     1600           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1601           no-error .
     1602         if error-status :error
     1603         or error-status :get-message(1) <> ""
     1604         then do:
     1605           undo move_block, retry move_block .
     1606         end.
     1607         for each buf_temp-browse-handle
     1608           where buf_temp-browse-handle.browse-type = 'height':u
     1609         on error undo move_block, retry move_block
     1610         :
     1611           assign
     1612             buf_temp-browse-handle.browse-handle :height
     1613               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1614             no-error .
     1615           if error-status :error
     1616           or error-status :get-message(1) <> ""
     1617           then do:
     1618             undo move_block, retry move_block .
     1619           end.
     1620         end.
     1621         assign
     1622           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1623           no-error .
     1624         if error-status :error
     1625         or error-status :get-message(1) <> ""
     1626         then do:
     1627           undo move_block, retry move_block .
     1628         end.
     1629         if frame Dialog-Frame :scrollable = true
     1630         then do:
     1631           assign
     1632             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1633             no-error .
     1634           if error-status :error
     1635           or error-status :get-message(1) <> ""
     1636           then do:
     1637             undo move_block, retry move_block .
     1638           end.
     1639         end.
     1640       end.
     1641       if p-move-resize = true
     1642       then do:
     1643         run diasize_position-resize-button in this-procedure .
     1644       end.
     1645       if v-diasize-wndstore = true
     1646       then do:
     1647         if connected("ub") = true
     1648         then do:
     1649           define variable v-cntxt-db-num        as integer   no-undo .
     1650           define variable v-cntxt-userid        as character no-undo .
     1651           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1652                                             , OUTPUT v-cntxt-userid
     1653                                             ) .
     1654           run gbl/wndsizew.p
     1655             (input  v-cntxt-db-num
     1656             ,input  v-cntxt-userid
     1657             ,input  v-diasize-proc-name
     1658             ,input  'height':u
     1659             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1660             ) .
     1661         end.
     1662       end.
     1663     end.
     1664     assign
     1665       v-diasize-change-size = false
     1666     .
     1667   end procedure.
     1668   procedure diasize_set-height :
     1669     define input  parameter p-new-height  as decimal   no-undo .
     1670     define input  parameter p-move-resize as logical   no-undo .
     1671     do
     1672     on error undo, return error return-value
     1673     :
     1674       run diasize_change-height in this-procedure
     1675         (input  (p-new-height - frame Dialog-Frame :height)
     1676         ,input  p-move-resize
     1677         ) .
     1678     end.
     1679   end procedure.
     1680   procedure diasize_change-width :
     1681     define input  parameter p-change-value as decimal   no-undo .
     1682     define input  parameter p-move-resize  as logical   no-undo .
     1683     define variable v-field-group-handle   as handle    no-undo .
     1684     define variable v-object-handle        as handle    no-undo .
     1685     define variable v-frame-width          as decimal   no-undo .
     1686     define variable v-frame-virtual-width  as decimal   no-undo .
     1687     define variable v-browse-width         as decimal   no-undo .
     1688     define variable v-window-width         as decimal   no-undo .
     1689     define variable v-window-virtual-width as decimal   no-undo .
     1690     define variable v-change-sign          as integer   no-undo .
     1691     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1692     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1693     if p-change-value > 0
     1694     then do:
     1695       if frame Dialog-Frame :width + p-change-value >
     1696           session :width-chars
     1697       then do:
     1698         assign
     1699           p-change-value = session :width-chars - frame Dialog-Frame :width
     1700         .
     1701         if p-change-value <= 0
     1702         then do:
     1703           run diasize_position-resize-button in this-procedure .
     1704           return .
     1705         end.
     1706       end.
     1707     end.
     1708     if p-change-value < 0
     1709     then do:
     1710       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1711       then do:
     1712         assign
     1713           p-change-value = v-diasize-orig-frame-width
     1714                          - frame Dialog-Frame :width
     1715         .
     1716         if p-change-value >= 0
     1717         then do:
     1718           run diasize_position-resize-button in this-procedure .
     1719           return .
     1720         end.
     1721       end.
     1722     end.
     1723     if p-change-value >= 0
     1724     then do:
     1725       assign
     1726         v-change-sign = 1
     1727       .
     1728     end.
     1729     else do:
     1730       assign
     1731         v-change-sign = -1
     1732       .
     1733     end.
     1734     assign
     1735       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1736     .
     1737     if p-change-value = 0
     1738     then do:
     1739       run diasize_position-resize-button in this-procedure .
     1740       return .
     1741     end.
     1742     move_block:
     1743     do
     1744     on error undo move_block, leave move_block
     1745     :
     1746       if retry
     1747       then do:
     1748         do
     1749         on error undo move_block, leave move_block
     1750         :
     1751           if p-change-value > 0
     1752           then do:
     1753             for each buf_temp-diasize-handle
     1754             on error undo, next
     1755             :
     1756               assign
     1757                 v-object-handle = buf_temp-diasize-handle.handle-value
     1758               .
     1759               if v-object-handle <> v-diasize-resize-button
     1760               then do:
     1761                 assign
     1762                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1763                 .
     1764               end.
     1765             end.
     1766             assign
     1767               v-diasize-browse-handle :width = v-browse-width
     1768             .
     1769             for each buf_temp-browse-handle
     1770               where buf_temp-browse-handle.browse-type = 'width':u
     1771             on error undo, next
     1772             :
     1773               assign
     1774                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1775               .
     1776             end.
     1777             assign
     1778               frame Dialog-Frame :width = v-frame-width
     1779             .
     1780             if frame Dialog-Frame :scrollable = true
     1781             then do:
     1782               assign
     1783                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1784               .
     1785             end.
     1786             run diasize_position-resize-button in this-procedure .
     1787           end.
     1788           else do:
     1789             if frame Dialog-Frame :scrollable = true
     1790             then do:
     1791               assign
     1792                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1793               .
     1794             end.
     1795             assign
     1796               frame Dialog-Frame :width = v-frame-width
     1797             .
     1798             for each buf_temp-browse-handle
     1799               where buf_temp-browse-handle.browse-type = 'width':u
     1800             on error undo, next
     1801             :
     1802               assign
     1803                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1804               .
     1805             end.
     1806             assign
     1807               v-diasize-browse-handle :width = v-browse-width
     1808             .
     1809             for each buf_temp-diasize-handle
     1810             on error undo, next
     1811             :
     1812               assign
     1813                 v-object-handle = buf_temp-diasize-handle.handle-value
     1814               .
     1815               if v-object-handle <> v-diasize-resize-button
     1816               then do:
     1817                 assign
     1818                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1819                 .
     1820               end.
     1821             end.
     1822             run diasize_position-resize-button in this-procedure .
     1823           end.
     1824           assign
     1825             v-diasize-change-size = false
     1826           .
     1827           leave move_block .
     1828         end.
     1829       end.
     1830       assign
     1831         v-diasize-need-full-display = true
     1832       .
     1833       if v-diasize-change-size = false
     1834       then do:
     1835         assign
     1836           v-diasize-change-size = true
     1837         .
     1838       end.
     1839       else do:
     1840         return .
     1841       end.
     1842       assign
     1843         v-frame-width = frame Dialog-Frame :width
     1844         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1845         v-browse-width = v-diasize-browse-handle :width
     1846       .
     1847       for each buf_temp-browse-handle
     1848         where buf_temp-browse-handle.browse-type = 'width':u
     1849       :
     1850         assign
     1851           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1852         .
     1853       end.
     1854       for each buf_temp-diasize-handle
     1855       :
     1856         delete buf_temp-diasize-handle .
     1857       end.
     1858       assign
     1859         v-field-group-handle = frame Dialog-Frame :first-child
     1860       .
     1861       do while valid-handle(v-field-group-handle)
     1862       :
     1863         assign
     1864           v-object-handle = v-field-group-handle :first-child
     1865         .
     1866         do while valid-handle(v-object-handle)
     1867         :
     1868           if  v-object-handle <> v-diasize-browse-handle :handle
     1869           and v-object-handle <> v-diasize-resize-button
     1870           and can-query(v-object-handle, "row")
     1871           and can-query(v-object-handle, "height")
     1872           and ( v-object-handle :col + v-object-handle :width
     1873                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1874               )
     1875           then do:
     1876             find first buf_temp-browse-handle
     1877               where buf_temp-browse-handle.browse-type   = 'width':u
     1878                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1879               no-error .
     1880             if available buf_temp-browse-handle
     1881             then do:
     1882             end.
     1883             else do:
     1884               create buf_temp-diasize-handle .
     1885               assign
     1886                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1887                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1888               .
     1889             end.
     1890           end.
     1891           assign
     1892             v-object-handle = v-object-handle :next-sibling
     1893           .
     1894         end.
     1895         assign
     1896           v-field-group-handle = v-field-group-handle :next-sibling
     1897         .
     1898       end.
     1899       do with frame Dialog-Frame
     1900       :
     1901         hide v-diasize-resize-button .
     1902         v-diasize-resize-button :row = 1.
     1903         v-diasize-resize-button :column = 1.
     1904       end.
     1905       if p-change-value > 0
     1906       then do:
     1907         if frame Dialog-Frame :scrollable = true
     1908         then do:
     1909           assign
     1910             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1911             no-error .
     1912           if error-status :error
     1913           or error-status :get-message(1) <> ""
     1914           then do:
     1915             undo move_block, retry move_block.
     1916           end.
     1917         end.
     1918         assign
     1919           frame Dialog-Frame :width = v-frame-width + p-change-value
     1920           no-error .
     1921         if error-status :error
     1922         or error-status :get-message(1) <> ""
     1923         then do:
     1924           undo move_block, retry move_block.
     1925         end.
     1926         assign
     1927           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1928         no-error .
     1929         if error-status :error
     1930         or error-status :get-message(1) <> ""
     1931         then do:
     1932           undo move_block, retry move_block.
     1933         end.
     1934         for each buf_temp-browse-handle
     1935           where buf_temp-browse-handle.browse-type = 'width':u
     1936         on error undo move_block, retry move_block
     1937         :
     1938           assign
     1939             buf_temp-browse-handle.browse-handle :width
     1940               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1941             no-error .
     1942           if error-status :error
     1943           or error-status :get-message(1) <> ""
     1944           then do:
     1945             undo move_block, retry move_block .
     1946           end.
     1947         end.
     1948         for each buf_temp-diasize-handle
     1949         on error undo move_block, retry move_block
     1950         :
     1951           assign
     1952             v-object-handle = buf_temp-diasize-handle.handle-value
     1953           .
     1954           if v-object-handle <> v-diasize-resize-button
     1955           then do:
     1956             assign
     1957               v-object-handle :col = v-object-handle :col + p-change-value
     1958               no-error .
     1959             if error-status :error
     1960             or error-status :get-message(1) <> ""
     1961             then do:
     1962               undo move_block, retry move_block .
     1963             end.
     1964           end.
     1965         end.
     1966       end.
     1967       else do:
     1968         for each buf_temp-diasize-handle
     1969         on error undo move_block, retry move_block
     1970         :
     1971           assign
     1972             v-object-handle = buf_temp-diasize-handle.handle-value
     1973           .
     1974           if v-object-handle <> v-diasize-resize-button
     1975           then do:
     1976             assign
     1977               v-object-handle :col = v-object-handle :col + p-change-value
     1978               no-error .
     1979             if error-status :error
     1980             or error-status :get-message(1) <> ""
     1981             then do:
     1982               undo move_block, retry move_block .
     1983             end.
     1984           end.
     1985         end.
     1986         for each buf_temp-browse-handle
     1987           where buf_temp-browse-handle.browse-type = 'width':u
     1988         on error undo move_block, retry move_block
     1989         :
     1990           assign
     1991             buf_temp-browse-handle.browse-handle :width
     1992               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1993             no-error .
     1994           if error-status :error
     1995           or error-status :get-message(1) <> ""
     1996           then do:
     1997             undo move_block, retry move_block .
     1998           end.
     1999         end.
     2000         assign
     2001           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2002           no-error .
     2003         if error-status :error
     2004         or error-status :get-message(1) <> ""
     2005         then do:
     2006           undo move_block, retry move_block.
     2007         end.
     2008         assign
     2009           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2010         no-error .
     2011         if error-status :error
     2012         or error-status :get-message(1) <> ""
     2013         then do:
     2014           undo move_block, retry move_block.
     2015         end.
     2016         if frame Dialog-Frame :scrollable = true
     2017         then do:
     2018           assign
     2019             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2020           no-error .
     2021           if error-status :error
     2022           or error-status :get-message(1) <> ""
     2023           then do:
     2024             undo move_block, retry move_block.
     2025           end.
     2026         end.
     2027       end.
     2028       if p-move-resize
     2029       then do:
     2030         run diasize_position-resize-button in this-procedure .
     2031       end.
     2032       if v-diasize-wndstore = true
     2033       then do:
     2034         if connected("ub") = true
     2035         then do:
     2036           define variable v-cntxt-db-num        as integer   no-undo .
     2037           define variable v-cntxt-userid        as character no-undo .
     2038           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2039                                             , OUTPUT v-cntxt-userid
     2040                                             ) .
     2041           run gbl/wndsizew.p
     2042             (input  v-cntxt-db-num
     2043             ,input  v-cntxt-userid
     2044             ,input  v-diasize-proc-name
     2045             ,input  'width':u
     2046             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2047             ) .
     2048         end.
     2049       end.
     2050     end.
     2051     assign
     2052       v-diasize-change-size = false
     2053     .
     2054   end procedure.
     2055   procedure diasize_set-width :
     2056     define input  parameter p-new-width  as decimal   no-undo .
     2057     define input  parameter p-move-resize as logical   no-undo .
     2058     do
     2059     on error undo, return error return-value
     2060     :
     2061       run diasize_change-width in this-procedure
     2062         (input  (p-new-width - frame Dialog-Frame :width)
     2063         ,input  p-move-resize
     2064         ) .
     2065     end.
     2066   end procedure.
     2067   procedure diasize_position-resize-button :
     2068     do with frame Dialog-Frame
     2069     :
     2070       hide v-diasize-resize-button .
     2071       assign
     2072         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2073                     - 1
     2074                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2075         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2076                     - 1
     2077                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2078       .
     2079       view v-diasize-resize-button .
     2080     end.
     2081   end procedure.
     2082   on alt-right anywhere
     2083   do:
     2084     run diasize_change-width in this-procedure
     2085       (input 1
     2086       ,input true
     2087       ) .
     2088     return no-apply .
     2089   end.
     2090   on alt-left anywhere
     2091   do:
     2092     run diasize_change-width in this-procedure
     2093       (input -1
     2094       ,input true
     2095       ) .
     2096     return no-apply .
     2097   end.
     2098   on alt-down anywhere
     2099   do:
     2100     run diasize_change-height in this-procedure
     2101       (input 1
     2102       ,input true
     2103       ) .
     2104     return no-apply .
     2105   end.
     2106   on alt-up anywhere
     2107   do:
     2108     run diasize_change-height in this-procedure
     2109       (input -1
     2110       ,input true
     2111       ) .
     2112     return no-apply .
     2113   end.
     2114   on alt-enter of frame Dialog-Frame
     2115   do:
     2116     run diasize_maximize in this-procedure
     2117       (input  ?
     2118       ).
     2119     return no-apply .
     2120   end.
     2121   procedure diasize_end-move :
     2122     do
     2123     on error undo, return error return-value
     2124     :
     2125       define variable v-row-delta as decimal   no-undo .
     2126       define variable v-col-delta as decimal   no-undo .
     2127       define variable v-new-row as decimal   no-undo .
     2128       define variable v-new-col as decimal   no-undo .
     2129       assign
     2130         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2131         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2132       .
     2133       assign
     2134         v-row-delta = v-new-row - frame Dialog-Frame :height
     2135         v-col-delta = v-new-col - frame Dialog-Frame :width
     2136       .
     2137       run diasize_change-height in this-procedure
     2138         (input v-row-delta
     2139         ,input true
     2140         ) .
     2141       run diasize_change-width in this-procedure
     2142         (input v-col-delta
     2143         ,input true
     2144         ) .
     2145     end.
     2146   end procedure.
     2147   procedure diasize_maximize :
     2148     define input  parameter p-action as logical   no-undo .
     2149     do
     2150     on error undo, return error return-value
     2151     :
     2152       if p-action = ?
     2153       then do:
     2154         if v-diasize-need-maximize = true
     2155         then do:
     2156           assign
     2157             p-action = true
     2158           .
     2159         end.
     2160         else do:
     2161           assign
     2162             p-action = false
     2163           .
     2164         end.
     2165       end.
     2166       if p-action = true
     2167       then do:
     2168         run diasize_change-height in this-procedure
     2169           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2170               - frame Dialog-Frame :height-chars
     2171           ,input true
     2172           ) .
     2173         run diasize_change-width in this-procedure
     2174           (input session :width-chars
     2175               - frame Dialog-Frame :width-chars
     2176           ,input true
     2177           ) .
     2178         assign
     2179           v-diasize-need-maximize = false
     2180         .
     2181       end.
     2182       else do:
     2183         run diasize_change-width in this-procedure
     2184           (input v-diasize-orig-frame-width
     2185               - frame Dialog-Frame :width-chars
     2186           ,input true
     2187           ) .
     2188         run diasize_change-height in this-procedure
     2189           (input v-diasize-orig-frame-height
     2190               - frame Dialog-Frame :height-chars
     2191           ,input true
     2192           ) .
     2193         assign
     2194           v-diasize-need-maximize = true
     2195         .
     2196       end.
     2197     end.
     2198   end procedure.
     2199   procedure diasize_restore-orig-size :
     2200     do
     2201     on error undo, return error return-value
     2202     :
     2203       assign
     2204         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2205         v-diasize-current-frame-height = frame Dialog-Frame :height
     2206       .
     2207       run diasize_set-height in this-procedure
     2208         (input  v-diasize-orig-frame-height
     2209         ,input  true
     2210         ) .
     2211       run diasize_set-width in this-procedure
     2212         (input  v-diasize-orig-frame-width
     2213         ,input  true
     2214         ) .
     2215     end.
     2216   end procedure.
     2217   procedure diasize_restore-current-size :
     2218     do
     2219     on error undo, return error return-value
     2220     :
     2221       run diasize_set-height in this-procedure
     2222         (input  v-diasize-current-frame-height
     2223         ,input  true
     2224         ) .
     2225       run diasize_set-width in this-procedure
     2226         (input  v-diasize-current-frame-width
     2227         ,input  true
     2228         ) .
     2229     end.
     2230   end procedure.
     2231   procedure diasize_set-browse-handle :
     2232     define input  parameter p-browse-handle as handle   no-undo .
     2233     define buffer buf_temp-browse-handle for temp-browse-handle .
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       assign
     2238         v-diasize-browse-handle = p-browse-handle
     2239       .
     2240       for each buf_temp-browse-handle
     2241       on error undo, return error return-value
     2242       :
     2243         delete buf_temp-browse-handle .
     2244       end.
     2245     end.
     2246   end procedure.
     2247   procedure diasize_add_browse :
     2248     define input  parameter p-browse-type   as character no-undo .
     2249     define input  parameter p-browse-handle as handle    no-undo .
     2250     define buffer buf_temp-browse-handle for temp-browse-handle .
     2251     do
     2252     on error undo, return error return-value
     2253     :
     2254       assign
     2255         v-diasize-browse-number = v-diasize-browse-number + 1
     2256       .
     2257       create buf_temp-browse-handle .
     2258       assign
     2259         buf_temp-browse-handle.browse-type   = p-browse-type
     2260         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2261         buf_temp-browse-handle.browse-handle = p-browse-handle
     2262       .
     2263     end.
     2264   end procedure.
     2265   procedure diasize_init :
     2266     define variable v-default-value    as logical   no-undo .
     2267     define variable v-restore-saved    as logical   no-undo .
     2268     define variable v-resize-value-str as character no-undo .
     2269     do
     2270     on error undo, return error return-value
     2271     :
     2272       do with frame Dialog-Frame
     2273       :
     2274         assign
     2275           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2276           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2277           v-diasize-browse-handle     = browse br-obj :handle
     2278         .
     2279         create button v-diasize-resize-button
     2280         assign
     2281           parent        = frame Dialog-Frame :first-child
     2282           label         = "s"
     2283           height-pixels = 16
     2284           width-pixels  = 16
     2285           visible       = true
     2286           sensitive     = true
     2287           movable       = true
     2288           triggers:
     2289             on end-move persistent run diasize_end-move in this-procedure .
     2290           end triggers.
     2291         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2292         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2293         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2294         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2295         assign
     2296           v-diasize-wndmax = false
     2297         .
     2298         if connected("ub") = true
     2299         then do:
     2300           define variable v-cntxt-db-num        as integer   no-undo .
     2301           define variable v-cntxt-userid        as character no-undo .
     2302           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2303                                             , OUTPUT v-cntxt-userid
     2304                                             ) .
     2305           run gbl/wndpar_r.p
     2306             (input  v-cntxt-db-num
     2307             ,input  v-cntxt-userid
     2308             ,input  'wndmax':U
     2309             ,output v-diasize-wndmax
     2310             ,output v-default-value
     2311             ) .
     2312         end.
     2313         assign
     2314           v-diasize-wndstore = false
     2315         .
     2316         if connected("ub") = true
     2317         then do:
     2318           run gbl/wndpar_r.p
     2319             (input  v-cntxt-db-num
     2320             ,input  v-cntxt-userid
     2321             ,input  'wndstore':U
     2322             ,output v-diasize-wndstore
     2323             ,output v-default-value
     2324             ) .
     2325         end.
     2326         assign
     2327           v-diasize-proc-name = entry(1, program-name(2), '.')
     2328         .
     2329         if v-diasize-wndstore = true
     2330         then do:
     2331           assign
     2332             v-restore-saved = false
     2333           .
     2334           if connected("ub") = true
     2335           then do:
     2336             run gbl/wndsizer.p
     2337               (input  v-cntxt-db-num
     2338               ,input  v-cntxt-userid
     2339               ,input  v-diasize-proc-name
     2340               ,input  'height':u
     2341               ,output v-resize-value-str
     2342               ) .
     2343             if v-resize-value-str <> '':U
     2344             then do:
     2345               run diasize_change-height in this-procedure
     2346                 (input  integer(v-resize-value-str)
     2347                 ,input  true
     2348                 ) .
     2349               assign
     2350                 v-restore-saved = true
     2351               .
     2352             end.
     2353           end.
     2354           if connected("ub") = true
     2355           then do:
     2356             run gbl/wndsizer.p
     2357               (input  v-cntxt-db-num
     2358               ,input  v-cntxt-userid
     2359               ,input  v-diasize-proc-name
     2360               ,input  'width':u
     2361               ,output v-resize-value-str
     2362               ) .
     2363             if v-resize-value-str <> '':U
     2364             then do:
     2365               run diasize_change-width in this-procedure
     2366                 (input  integer(v-resize-value-str)
     2367                 ,input  true
     2368                 ) .
     2369               assign
     2370                 v-restore-saved = true
     2371               .
     2372             end.
     2373           end.
     2374           if v-restore-saved <> true
     2375           then do:
     2376             if v-diasize-wndmax = true
     2377             then do:
     2378               run diasize_maximize in this-procedure
     2379                 (input  true
     2380                 ) .
     2381             end.
     2382           end.
     2383         end.
     2384         else do:
     2385           if v-diasize-wndmax = true
     2386           then do:
     2387             run diasize_maximize in this-procedure
     2388               (input  true
     2389               ) .
     2390           end.
     2391         end.
     2392       end.
     2393     end.
     2394   end procedure.
     2395   procedure diasize_need-full-display :
     2396     define output parameter p-need-full-display as logical   no-undo .
     2397     do
     2398     on error undo, return error return-value
     2399     :
     2400       assign
     2401         p-need-full-display = v-diasize-need-full-display
     2402       .
     2403       assign
     2404         v-diasize-need-full-display = false
     2405       .
     2406     end.
     2407   end procedure.
     2408   procedure get-context :
     2409      define output parameter p-db-num as integer          no-undo.
     2410      define output parameter p-user-id as character        no-undo.
     2411      define variable v-login               as character    no-undo.
     2412      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2413      define buffer buf_user-login  for ub.user-login .
     2414      do
     2415      on error undo, return error
     2416      :
     2417            FIND FIRST buf_sys-ctrl no-lock.
     2418            ASSIGN
     2419               v-login = USERID("ub")
     2420               p-db-num = buf_sys-ctrl.db-num
     2421            .
     2422            FIND FIRST buf_user-login
     2423                 WHERE buf_user-login.db-num = p-db-num
     2424                   AND buf_user-login.user-login = v-login
     2425                 no-lock
     2426                 no-error
     2427                 .
     2428            IF AVAILABLE buf_user-login
     2429            THEN DO:
     2430               assign
     2431                  p-user-id = buf_user-login.user-id
     2432               .
     2433            END.
     2434      end.
     2435   end procedure.
     2436       run diasize_init in this-procedure .
     2437   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2438   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2439   MAIN-BLOCK:
     2440   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2441      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2442     case p-from-version:
     2443       when 'v15_0000':U then do:
     2444       end.
     2445       when 'v14_0':U then do:
     2446       end.
     2447       otherwise do:
     2448         message
     2449         substitute("Неверное значение параметра p-from-version=&1", p-from-version)
     2450         view-as alert-box error .
     2451         undo main-block, return error .
     2452       end.
     2453     end case.
     2454     run init-proc in this-procedure .
     2455     RUN enable_UI in this-procedure .
     2456     assign
     2457     tt_obj-list.obj-name:column-label in browse br-obj = substitute("& &2"
     2458                                                                     , tt_obj-list.obj-name:column-label in browse br-obj
     2459                                                                     , p-from-version).
     2460     WAIT-FOR GO OF FRAME Dialog-Frame.
     2461   END.
     2462   RUN disable_UI.
     2463   PROCEDURE disable_UI :
     2464     HIDE FRAME Dialog-Frame.
     2465   END PROCEDURE.
     2466   PROCEDURE enable_UI :
     2467     ENABLE B-Cancel B-mark B-OK B-Help br-obj
     2468         WITH FRAME Dialog-Frame.
     2469     VIEW FRAME Dialog-Frame.
     2470     OPEN QUERY br-obj FOR EACH tt_obj-list NO-LOCK INDEXED-REPOSITION.
     2471   END PROCEDURE.
     2472   PROCEDURE init-proc :
     2473   empty temp-table tt_obj-list.
     2474   define buffer new_clients for ub.clients  .
     2475   for each new_clients no-lock where
     2476            new_clients.obj-type = 'маг':U or
     2477            new_clients.obj-type = 'скл':U
     2478            :
     2479        if new_clients.stts <> 0 then next.
     2480        create  tt_obj-list.
     2481        buffer-copy new_clients  to tt_obj-list
     2482        assign
     2483          tt_obj-list.grp-name = ""
     2484          tt_obj-list.buy-cons = false
     2485        .
     2486   end.
     2487   define buffer new_ext-classif for ub.ext-classif  .
     2488   define buffer buf_clients for ub.clients  .
     2489   define variable v-key-rec as character no-undo .
     2490   for each tt_obj-list  :
     2491     find first buf_clients no-lock where
     2492                buf_clients.obj-type = tt_obj-list.obj-type and
     2493                buf_clients.obj-code = tt_obj-list.obj-code no-error .
     2494     if error-status :error then next.
     2495     run gen-key-rec in this-procedure (  input 'clients':U
     2496                                        , input (buffer buf_clients:handle)
     2497                                        , output v-key-rec).
     2498     find first new_ext-classif no-lock where
     2499                 new_ext-classif.classif-subject = 'clients':U
     2500             and new_ext-classif.classif-name    = v-cli-classif-name
     2501             and new_ext-classif.db-num          = - 1
     2502             and new_ext-classif.uniq-key-rec    = v-key-rec use-index irec no-error .
     2503     if available new_ext-classif then do:
     2504       tt_obj-list.grp-name =
     2505       substitute("БД&4  &1&2 - &3" , buf_clients.obj-type , buf_clients.obj-code, buf_clients.obj-name , buf_clients.db-num)
     2506       .
     2507     end.
     2508   end.
     2509   END PROCEDURE.
     2510   PROCEDURE proc-exec :
     2511   define variable v-ok as logical   no-undo .
     2512   define buffer new_ext-classif for ub.ext-classif  .
     2513   define buffer buf_clients for ub.clients  .
     2514   define variable v-key-rec as character no-undo .
     2515   define variable v-parameter as character no-undo .
     2516   for each tt_obj-list where
     2517            tt_obj-list.buy-cons = true :
     2518     find first buf_clients no-lock where
     2519                buf_clients.obj-type = tt_obj-list.obj-type and
     2520                buf_clients.obj-code = tt_obj-list.obj-code no-error .
     2521     if error-status :error then next.
     2522     run gen-key-rec in this-procedure (  input 'clients':U
     2523                                        , input (buffer buf_clients:handle)
     2524                                        , output v-key-rec).
     2525     find first new_ext-classif no-lock where
     2526                 new_ext-classif.classif-subject = 'clients':U
     2527           and  new_ext-classif.classif-name    = v-cli-classif-name
     2528           and  new_ext-classif.db-num          = - 1
     2529           and  new_ext-classif.uniq-key-rec    = v-key-rec no-error .
     2530     if available new_ext-classif then do:
     2531       define buffer buf_obj-list for obj-list .
     2532       find last buf_obj-list  use-index pi no-error .
     2533       if available buf_obj-list then do:
     2534         p-var = buf_obj-list.obj-id + 1.
     2535       end.
     2536       else do:
     2537         p-var = 1.
     2538       end.
     2539       create obj-list .
     2540       assign
     2541       obj-list.obj-id   = p-var
     2542       obj-list.obj-type = new_ext-classif.charkey_one
     2543       obj-list.obj-code = new_ext-classif.Key#_One
     2544       .
     2545     end.
     2546   end.
     2547   define variable v-okk as logical   no-undo .
     2548   if  can-find( first obj-list)  = false  then do:
     2549     message
     2550     "Не выбрано ни одного объекта !"
     2551     view-as alert-box error .
     2552     return error.
     2553   end.
     2554   define variable choice as integer no-undo .
     2555   run gbl/d-askw.w (input "Показывать данные:"
     2556                           ,input  ""
     2557                           ,input "|"
     2558                           ,input "Все|Проблемы|Итоги|Отменить"
     2559                           ,input "Все|Несхождения и слияния|Итоги|Отменить"
     2560                           ,input 2
     2561                           ,input 4
     2562                           ,output choice).
     2563   if choice = 4 then return.
     2564   v-parameter = string(choice).
     2565   run cmp/upg-conn.p ( input "connect"
     2566                       ,input p-from-version
     2567                       ,output v-ok )
     2568                       no-error.
     2569   if not v-ok then do:
     2570     message
     2571     substitute("Ошибка при подключении к ЧУЖОЙ БД TH&1&2&1&3"
     2572                , chr(10)
     2573                , error-status:get-message(1)
     2574                , return-value )
     2575     view-as alert-box error .
     2576     return error .
     2577   end.
     2578   v-okk = false  .
     2579   run str/diallog.w ( input parparentproc
     2580             , input this-procedure
     2581             , input 'cmp/ththrep.p':U
     2582             , input v-parameter + chr(4) + p-from-version
     2583             , input no
     2584             , input ''
     2585             , input substitute('Отчет по утилите переноса из &1 БД в 16.0', p-from-version)) no-error .
     2586   if not error-status :error then do:
     2587     v-okk = true .
     2588   end.
     2589   else do:
     2590     v-okk = false .
     2591   end.
     2592   if connected ("src") then do:
     2593     disconnect src.
     2594   end.
     2595   END PROCEDURE.
