      533   procedure thobjs :
      534      define input        parameter parparentproc     as widget-handle no-undo .
      535      define input        parameter i-bttns           as character     no-undo .
      536      define input        parameter i-list-mode       as character     no-undo.
      537      define input        parameter i-obj-type        as character     no-undo.
      538      define input        parameter i-db-num          as integer       no-undo.
      539      define input        parameter i-host-code       as integer       no-undo.
      540      define input-output parameter p-rid-list        as character     no-undo .
      541   run ref/thobjs.p
      542           ( input parparentproc
      543            ,input  this-procedure :handle
      544           , input i-bttns
      545           , input i-list-mode
      546           , input i-obj-type
      547           , input i-db-num
