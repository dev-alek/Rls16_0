      363   define temp-table userobjs_temp-user-obj no-undo
      364     field obj-type as character
      365     field obj-code as integer
      366     index xpk is primary unique obj-type obj-code
      367     .
      368   procedure userobjs_clear :
      369     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      370     do
      371     on error undo, return error return-value
      372     :
      373       for each buf_userobjs_temp-user-obj
      374       on error undo, return error return-value
      375       :
      376         delete buf_userobjs_temp-user-obj .
      377       end.
      378     end.
      379   end .
      380   procedure userobjs_object-count :
      381     define output parameter p-total-count as integer   no-undo .
      382     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      383     do
      384     on error undo, return error return-value
      385     :
      386       assign
      387         p-total-count = 0
      388       .
      389       for each buf_userobjs_temp-user-obj
      390       on error undo, return error return-value
      391       :
      392         assign
      393           p-total-count = p-total-count + 1
      394         .
      395       end.
      396     end.
      397   end.
      398   procedure userobjs_append :
      399      define input  parameter p-obj-type as character no-undo .
      400      define input  parameter p-obj-code as integer   no-undo .
      401     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      402     do
      403     on error undo, return error return-value
      404     :
      405       find first buf_userobjs_temp-user-obj
      406         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      407           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      408         no-error .
      409       if not available buf_userobjs_temp-user-obj
      410       then do:
      411         create buf_userobjs_temp-user-obj .
      412         assign
      413           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      414           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      415         .
      416       end.
      417     end.
      418   end.
      419   procedure userobjs_object-exist :
      420     define output parameter p-object-exist as logical   no-undo .
      421     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      422     do
      423     on error undo, return error return-value
      424     :
      425       find first buf_userobjs_temp-user-obj
      426         no-error .
      427       if not available buf_userobjs_temp-user-obj
      428       then do:
      429         assign
      430           p-object-exist = false
      431         .
      432       end.
      433       else do:
      434         assign
      435           p-object-exist = true
      436         .
      437       end.
      438     end.
      439   end.
      440   procedure userobjs_transfer :
      441     define input  parameter p-callback-handle as handle no-undo .
      442     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      443     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      444     do
      445     on error undo, return error return-value
      446     :
      447       if valid-handle(p-callback-handle) <> true
      448       then do:
      449         message
      450           vss-workfile vss-revision vss-description skip
      451           "Ошибка задания входных параметров" skip
      452           "Неизвестный указатель на процедуру" skip
      453           view-as alert-box error .
      454         undo, return error return-value .
      455       end.
      456       if p-callback-handle :get-signature("userobjs_append") = ""
      457       then do:
      458         message
      459           vss-workfile vss-revision vss-description skip
      460           "Ошибка задания входных параметров" skip
      461           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      462                     ,p-callback-handle :file-name
      463                     ) skip
      464           view-as alert-box error .
      465         undo, return error return-value .
      466       end.
      467       for each buf_userobjs_temp-user-obj
      468       on error undo, return error return-value
      469       :
      470         run userobjs_append in p-callback-handle
      471           (input  buf_userobjs_temp-user-obj.obj-type
      472           ,input  buf_userobjs_temp-user-obj.obj-code
      473           ) .
      474       end.
      475     end.
      476   end procedure.
      477   procedure userobjs_select-one :
