      550   end.
      551   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   procedure factord :
      553     define input  parameter p-fact-date            as date    no-undo .
      554     define input  parameter p-fact-time            as integer no-undo .
      555     define input  parameter p-fact-num             as integer no-undo .
      556     define input  parameter p-shift-date           as date    no-undo .
      557     define input  parameter p-shift-num            as integer no-undo .
      558     define input  parameter p-shift-on             as logical no-undo .
      559     define output parameter p-fact-order           as decimal no-undo .
      560     define output parameter p-shift-end-fact-order as decimal no-undo .
      561     define output parameter p-day-end-fact-order   as decimal no-undo .
      562     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      563     if p-fact-date = ?
      564     then do:
      565       return error "Не указана фактическая дата" .
      566     end.
      567     define variable v-fact-date-num as integer no-undo .
      568     assign
      569       v-fact-date-num = integer(p-fact-date)
      570     .
      571     if p-fact-num = ?
      572     or p-fact-num = 0
      573     then do:
      574       return error "Не задан p-fact-num " + string(p-fact-num) .
      575     end.
      576     if p-fact-num < 0
      577     then do:
      578       return error "Отрицательный fact-num " + string(p-fact-num) .
      579     end.
      580     if p-fact-num >= 100000000
      581     then do:
      582       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      583     end.
      584     if p-shift-on = true
      585     then do:
      586       if p-shift-date = ?
      587       then do:
      588         return error "Не задана дата смены" .
      589       end.
      590       if p-shift-num = ?
      591       or p-shift-num = 0
      592       then do:
      593         return error "Не задан номер смены" .
      594       end.
      595     end.
      596     else do:
      597       assign
      598         p-shift-date = p-fact-date
      599         p-shift-num  = 24
      600       .
      601     end.
      602     define variable v-shift-offset as integer no-undo .
      603     if p-shift-date = p-fact-date
      604     then do:
      605       assign
      606         v-shift-offset = 1
      607       .
      608     end.
      609     if p-shift-date < p-fact-date
      610     then do:
      611       assign
      612         v-shift-offset = 0
      613       .
      614     end.
      615     if p-shift-date > p-fact-date
      616     then do:
      617       message
      618         vss-workfile vss-revision vss-description skip
      619         "Неправильная дата закрытия смены" skip
      620         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      621         view-as alert-box error .
      622       undo, return error
      623         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      624           ,string(p-fact-date, '99/99/9999':U)
      625           ,string(p-shift-date, '99/99/9999':U)
      626           )
      627       .
      628     end.
      629     if p-shift-num < 1
      630     or p-shift-num > 24
      631     then do:
      632       message
      633         vss-workfile vss-revision vss-description skip
      634         "Неправильный номер смены" skip
      635         "p-shift-num" p-shift-num skip
      636         view-as alert-box error .
      637       undo, return error return-value .
      638     end.
      639     assign
      640       p-fact-order           = v-fact-date-num
      641                              + v-shift-offset * 0.5
      642                              + p-shift-num    * 0.02 - 0.01
      643                              + p-fact-num     * 0.0000000001
      644       p-shift-end-fact-order = v-fact-date-num
      645                              + v-shift-offset * 0.5
      646                              + p-shift-num    * 0.02
      647       p-day-end-fact-order   = v-fact-date-num
      648                              + 0.99
      649     .
      650     if p-fact-order           <= v-fact-date-num
      651     or p-shift-end-fact-order <= v-fact-date-num
      652     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      653     or p-shift-end-fact-order >= p-day-end-fact-order
      654     then do:
      655       message
      656         vss-workfile vss-revision vss-description skip
      657         "Внутренняя ошибка при генерации фактического номера" skip
      658         "p-fact-date"            p-fact-date            skip
      659         "p-fact-time"            p-fact-time            skip
      660         "p-fact-num"             p-fact-num             skip
      661         "p-shift-date"           p-shift-date           skip
      662         "p-shift-num"            p-shift-num            skip
      663         "p-shift-on"             p-shift-on             skip
      664         "p-shift-end-fact-order" p-shift-end-fact-order skip
      665         "p-day-end-fact-order"   p-day-end-fact-order   skip
      666         "v-fact-date-num"        v-fact-date-num        skip
      667         view-as alert-box error .
      668       undo, return error return-value .
      669     end.
      670   end procedure.
      671   procedure day-begin-fact-order :
      672     define input  parameter p-fact-date            as date    no-undo .
      673     define output parameter p-day-begin-fact-order as decimal no-undo .
      674     do
      675     on error undo, return error return-value
      676     :
      677       if p-fact-date = ?
      678       then do:
      679         assign
      680           p-day-begin-fact-order = 0
      681         .
      682       end.
      683       else do:
      684         assign
      685           p-day-begin-fact-order = integer(p-fact-date)
      686         .
      687       end.
      688     end.
      689   end procedure.
      690   procedure factord-max-fact-order :
      691     define output parameter p-max-fact-order as decimal   no-undo .
      692     do
      693     on error undo, return error return-value
      694     :
      695       run day-begin-fact-order in this-procedure
      696         (input  date(1, 1, 5000)
      697         ,output p-max-fact-order
      698         ) .
      699     end.
      700   end procedure.
      701   procedure factord-cut-archive :
      702     define input  parameter p-obj-type             as character no-undo .
      703     define input  parameter p-obj-code             as integer   no-undo .
      704     define input  parameter p-fact-date            as date      no-undo .
      705     define output parameter p-shift-on             as logical   no-undo .
      706     define output parameter p-shift-date           as date      no-undo .
      707     define output parameter p-shift-num            as integer   no-undo .
      708     define output parameter p-day-end-fact-order   as decimal   no-undo .
      709     define output parameter p-shift-end-fact-order as decimal   no-undo .
      710     define variable v-fact-order as decimal   no-undo .
      711     define buffer buf_shift-obj for ub.shift-obj .
      712     do
      713     on error undo, return error return-value
      714     :
      715   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      717     (input  p-obj-type
      718     ,input  p-obj-code
      719     ,input  'shift-on=request'
      720     ,output p-shift-on
      721     ) no-error .
      722       if error-status :error
      723       then do:
      724         message
      725           vss-workfile vss-revision vss-description skip
      726           "Ошибка при определении атрибута объекта" skip
      727           "Объект" p-obj-type p-obj-code skip
      728           error-status :get-message(1) skip
      729           return-value skip
      730           view-as alert-box error .
      731         undo, return error return-value .
      732       end.
      733       if p-shift-on = false
      734       then do:
      735         assign
      736           p-shift-date               = ?
      737           p-shift-num                = 0
      738         .
      739       end.
      740       else do:
      741         find first buf_shift-obj share-lock
      742           where buf_shift-obj.obj-type   = p-obj-type
      743             and buf_shift-obj.obj-code   = p-obj-code
      744             and buf_shift-obj.shift-date > p-fact-date
      745           use-index pi
      746           no-error .
      747         if not available buf_shift-obj
      748         or buf_shift-obj.status_ <> 'зкр':U
      749         then do:
      750           message
      751             vss-workfile vss-revision vss-description skip
      752             "Невозможно вычислить последнюю смену" skip
      753             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      754             "Объект" p-obj-type p-obj-code skip
      755             "Дата" p-fact-date skip
      756             view-as alert-box error .
      757           undo, return error return-value .
      758         end.
      759         find last buf_shift-obj share-lock
      760           where buf_shift-obj.obj-type = p-obj-type
      761             and buf_shift-obj.obj-code = p-obj-code
      762             and buf_shift-obj.shift-date <= p-fact-date
      763           use-index pi
      764           no-error .
      765         if available buf_shift-obj
      766         then do:
      767           if  buf_shift-obj.status_ = 'зкр':U
      768           then do:
      769             assign
      770               p-shift-date = buf_shift-obj.shift-date
      771               p-shift-num  = buf_shift-obj.shift-num
      772             .
      773           end.
      774           else do:
      775             message
      776               vss-workfile vss-revision vss-description skip
      777               "Невозможно вычислить последнюю смену" skip
      778               "Статус смены отличен от статуса" 'зкр':U skip
      779               "Объект" p-obj-type p-obj-code skip
      780               "Дата" p-fact-date skip
      781               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      782               view-as alert-box error .
      783             undo, return error return-value .
      784           end.
      785         end.
      786         else do:
      787           assign
      788             p-shift-date = p-fact-date - 1
      789             p-shift-num  = 1
      790           .
      791         end.
      792       end.
      793       run factord in this-procedure
      794         (input  p-fact-date
      795         ,input  1
      796         ,input  1
      797         ,input  p-shift-date
      798         ,input  p-shift-num
      799         ,input  p-shift-on
      800         ,output v-fact-order
      801         ,output p-shift-end-fact-order
      802         ,output p-day-end-fact-order
      803         ) no-error .
      804       if error-status :error
      805       then do:
      806         message
      807           vss-workfile vss-revision vss-description skip
      808           "Ошибка при вызове процедуры factord"
      809           error-status :get-message(1) skip
      810           return-value skip
      811           view-as alert-box error .
      812         undo, return error return-value .
      813       end.
      814     end.
      815   end procedure.
      816   procedure factord-lock-shift :
      817     define input  parameter p-obj-type  as character no-undo .
      818     define input  parameter p-obj-code  as integer   no-undo .
      819     define input  parameter p-fact-date as date      no-undo .
      820     define parameter buffer buf_shift-obj for ub.shift-obj .
      821     define variable v-shift-on      as logical   no-undo .
      822     define variable v-extra-message as character no-undo .
      823     define variable v-error as character no-undo .
      824     do
      825     on error undo, return error return-value
      826     :
      827   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      829     (input  p-obj-type
      830     ,input  p-obj-code
      831     ,input  'shift-on=request'
      832     ,output v-shift-on
      833     ) no-error .
      834       if error-status :error
      835       then do:
      836         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      837         undo, return error v-error .
      838       end.
      839       if v-shift-on = true
      840       then do:
      841         find first buf_shift-obj share-lock
      842           where buf_shift-obj.obj-type   = p-obj-type
      843             and buf_shift-obj.obj-code   = p-obj-code
      844             and buf_shift-obj.shift-date > p-fact-date
      845           use-index pi
      846           no-error .
      847         if not available buf_shift-obj
      848         or buf_shift-obj.status_ <> 'зкр':U
      849         then do:
      850           find last buf_shift-obj
      851             where buf_shift-obj.obj-type = p-obj-type
      852               and buf_shift-obj.obj-code = p-obj-code
      853               and buf_shift-obj.status_  = 'зкр':U
      854             use-index stts
      855             no-error .
      856           if available buf_shift-obj
      857           then do:
      858             assign
      859               v-extra-message =
      860                     substitute("Дата начала последеней закрытой смены на объекте &1"
      861                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      862                               )
      863             .
      864           end.
      865           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      866           undo, return error v-error .
      867         end.
      868       end.
      869     end.
      870   end procedure.
      871   procedure factord-end-day :
      872     define input  parameter p-fact-date            as date    no-undo .
      873     define output parameter p-day-end-fact-order   as decimal no-undo .
      874     do
      875     on error undo, return error return-value
      876     :
      877       if p-fact-date = ?
      878       then do:
      879         return error "Не указана фактическая дата" .
      880       end.
      881       assign
      882         p-day-end-fact-order = integer(p-fact-date) + 0.99
      883       .
      884     end.
      885   end procedure.
      886   procedure factord-to-date :
      887     define input  parameter p-fact-order as decimal no-undo .
      888     define output parameter p-fact-date  as date    no-undo .
      889     define variable v-ref-date  as date      no-undo .
      890     define variable v-ref-delta as integer   no-undo .
      891     do
      892     on error undo, return error return-value
      893     :
      894       if p-fact-order = ?
      895       or p-fact-order = 0
      896       then do:
      897         return error "Не указан fact-order" .
      898       end.
      899       assign
      900         v-ref-date  = date(1, 1, 2000)
      901       .
      902       assign
      903         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      904       .
      905       assign
      906         p-fact-date = v-ref-date + v-ref-delta
      907       .
      908     end.
      909   end procedure.
      910   procedure factord-to-fact-num :
      911     define input  parameter p-fact-order as decimal no-undo .
      912     define output parameter p-fact-num   as integer no-undo .
      913     define variable v-fact-order-trunc as decimal no-undo .
      914     do
      915     on error undo, return error return-value
      916     :
      917       if p-fact-order = ?
      918       or p-fact-order = 0
      919       then do:
      920         return error "Не указан fact-order" .
      921       end.
      922       assign
      923        v-fact-order-trunc = truncate(p-fact-order, 2)
      924       .
      925       assign
      926         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      927       .
      928     end.
      929   end procedure.
      930   procedure factord-to-shift-num :
      931     define input  parameter p-fact-order as decimal no-undo .
      932     define output parameter p-shift-num   as integer no-undo .
      933     define variable  p-shift-numd  as decimal   no-undo .
      934     define variable v-fact-order-trunc as decimal no-undo .
      935     do
      936     on error undo, return error return-value
      937     :
      938       if p-fact-order = ?
      939       or p-fact-order = 0
      940       then do:
      941         return error "Не указан fact-order" .
      942       end.
      943       assign
      944        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      945       .
      946       if v-fact-order-trunc < 0.5 then do:
      947         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      948       end.
      949       assign
      950         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      951         .
      952        assign
      953         p-shift-num = truncate (p-shift-numd , 0)
      954       .
      955     end.
      956   end procedure.
      957   define buffer buf_db                     for ub.db .
      958   define buffer buf_clients                for ub.clients .
      959   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      960   do
      961   on error undo, return error
      962   :
      963     define variable v-num as integer no-undo .
      964   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      965     run mainmenu_getcntxt in parparentproc
      966       (output v-cntxt-db-num
      967       ,output v-cntxt-userid
      968       ,output v-cntxt-level
      969       ,output v-cntxt-host-code-obj
      970       ,output v-cntxt-obj-type
      971       ,output v-cntxt-obj-code
      972       ,output v-cntxt-db-num-obj
      973       ,output v-cntxt-is-admin
      974       ) .
      975     if p-install <> true
      976     then do:
      977       define variable v-ok                 as logical   no-undo .
      978       define variable v-recalc-date        as date      no-undo .
      979       define variable v-recalc-date-string as character no-undo .
      980       message
      981         "Задать единую дату перерасчета для выбранных объектов?" skip
      982         view-as alert-box question buttons yes-no update v-ok .
      983       assign
      984         v-recalc-date = ?
      985       .
      986       if v-ok = true
      987       then do:
      988         run gbl/d-prompt.w
      989           ( 'title=':u + "Введите дату" + '\':u
      990           + 'text1=':u + "Введите дату, начиная с которой надо перерассчитать" + '\':u
      991           + 'text2=':u + "складской архив по поставщикам" + '\':u
      992           + 'type=date\':u
      993           ,input-output v-recalc-date-string
      994           ).
      995         if return-value = 'false':u
      996         then do:
      997           undo, return error .
      998         end.
      999         assign
     1000           v-recalc-date = date(v-recalc-date-string)
     1001         .
     1002         if v-recalc-date = ?
     1003         then do:
     1004           message
     1005             "Неправильна задана дата" v-recalc-date-string skip
     1006             view-as alert-box error .
     1007           undo, return error .
     1008         end.
     1009         assign
     1010           v-ok = true
     1011         .
     1012         message
     1013           "Перерассчитать объекты с даты" v-recalc-date "?" skip
     1014           "Вы должны быть уверены, что для всех объектов, которые вы затем выберете" skip
     1015           "складской архив по поставщикам должен быть рассчитан до указанной даты включительно" skip
     1016           "или за более позднюю дату." skip
     1017           "Продолжить?" skip
     1018           view-as alert-box question buttons yes-no update v-ok .
     1019         if v-ok <> true
     1020         then do:
     1021           undo, return error .
     1022         end.
     1023       end.
     1024     end.
     1025     if p-install = true
     1026     then do:
     1027       assign
     1028         v-num = 1
     1029       .
     1030     end.
     1031     else do:
     1032       run gbl/d-askw.w
     1033         (input "Вопрос"
     1034         ,input "Рассчитать складской архив по поставщикам" + chr(10)
     1035         + "На сменных объектах смена должна быть открыта, иначе эти объекты не будут обработаны"
     1036         ,input "|^"
     1037         ,input "Все объекты^confirm|Выбрать объекты|Отмена"
     1038         ,input "|"
     1039             + "|"
     1040             + ""
     1041         ,input 1
     1042         ,input 3
     1043         ,output v-num
     1044         ).
     1045     end.
     1046     case v-num :
     1047       when 1
     1048       then do:
     1049         define variable v-db-num as integer   no-undo .
     1050   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1051   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1052     (output v-db-num
     1053     )  .
     1054         for each buf_db no-lock
     1055           where v-db-num = 0
     1056              or (v-db-num <> 0
     1057                  and buf_db.db-num = v-db-num
     1058                 )
     1059         on error undo, return error
     1060         :
     1061           for each buf_clients no-lock
     1062             where buf_clients.db-num = buf_db.db-num
     1063           on error undo, return error
     1064           :
     1065             define buffer lock_shift-obj for ub.shift-obj .
     1066             run factord-lock-shift in this-procedure
     1067               (input  buf_clients.obj-type
     1068               ,input  buf_clients.obj-code
     1069               ,input  0
     1070               ,buffer lock_shift-obj
     1071               ) no-error .
     1072             if error-status :error  then do:
     1073               next.
     1074             end.
     1075             define variable v-attr-ahsp-del-chr  as character no-undo .
     1076             define variable v-attr-ahsp-del-type as character no-undo .
     1077             define variable v-attr-ahsp-del      as logical   no-undo .
     1078             run clntattr-value in this-procedure
     1079               (input  buf_clients.obj-type
     1080               ,input  buf_clients.obj-code
     1081               ,input  'ahsp-del':U
     1082               ,output v-attr-ahsp-del-chr
     1083               ,output v-attr-ahsp-del-type
     1084               ).
     1085             assign
     1086               v-attr-ahsp-del = lookup(v-attr-ahsp-del-chr, 'yes,true':u) > 0
     1087             .
     1088             if  v-attr-ahsp-del <> true
     1089             and buf_clients.stts = 0
     1090             then do:
     1091               run trg/calcahsp.p
     1092                 (input buf_clients.obj-type
     1093                 ,input buf_clients.obj-code
     1094                 ,input false
     1095                 ,input false
     1096                 ,input v-recalc-date
     1097                 ,input true
     1098                 ,input v-cntxt-db-num
     1099                 ,input v-cntxt-userid
     1100                 ) no-error .
     1101               if error-status :error
     1102               then do:
     1103                 message
     1104                   vss-workfile vss-revision vss-description skip
     1105                   "Ошибка при расчете складского архива по поставщикам" skip
     1106                   "Объект" buf_clients.obj-type buf_clients.obj-code skip
     1107                   "Информацию о рассчитанных объектах можно посмотреть в файле"
     1108                   "objahsp.log" skip
     1109                   "или в АРМ Администратор" skip
     1110                   "Утилиты/Работа с архивами/Информация о складских архивах" skip
     1111                   error-status :get-message(1) skip
     1112                   return-value skip
     1113                   view-as alert-box error .
     1114                 undo, return error .
     1115               end.
     1116             end.
     1117           end.
     1118         end.
     1119       end.
     1120       when 2
     1121       then do:
     1122         define variable v-user-select as logical   no-undo .
     1123   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   run userobjs_select-many in this-procedure
     1125     (input  parparentproc
     1126     ,input  v-cntxt-db-num
     1127     ,input  v-cntxt-userid
     1128     ,input  v-cntxt-host-code-obj
     1129     ,input  v-cntxt-obj-type
     1130     ,input  v-cntxt-obj-code
     1131     ,output v-user-select
     1132     )  .
     1133         if v-user-select <> true
     1134         then do:
     1135           message
     1136             "Объект не выбран"
     1137             view-as alert-box information .
     1138           return .
     1139         end.
     1140         v-str-obj = "" .
     1141         for each buf_userobjs_temp-user-obj
     1142         on error undo, return error return-value
     1143         :
     1144           find first buf_clients no-lock
     1145             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     1146               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     1147             .
     1148             define buffer lock2_shift-obj for ub.shift-obj .
     1149             run factord-lock-shift in this-procedure
     1150               (input  buf_clients.obj-type
     1151               ,input  buf_clients.obj-code
     1152               ,input  0
     1153               ,buffer lock2_shift-obj
     1154               ) no-error .
     1155             if error-status :error  then do:
     1156               v-str-obj = v-str-obj + substitute ( "&1&2," , buf_clients.obj-type, buf_clients.obj-code ) .
     1157               next.
     1158             end.
     1159           run clntattr-value in this-procedure
     1160             (input  buf_clients.obj-type
     1161             ,input  buf_clients.obj-code
     1162             ,input  'ahsp-del':U
     1163             ,output v-attr-ahsp-del-chr
     1164             ,output v-attr-ahsp-del-type
     1165             ).
     1166           assign
     1167             v-attr-ahsp-del = lookup(v-attr-ahsp-del-chr, "yes,true") > 0
     1168           .
     1169           if  v-attr-ahsp-del <> true
     1170           and buf_clients.stts = 0
     1171           then do:
     1172             run trg/calcahsp.p
     1173               (input buf_clients.obj-type
     1174               ,input buf_clients.obj-code
     1175               ,input false
     1176               ,input (p-install <> true)
     1177               ,input v-recalc-date
     1178               ,input true
     1179               ,input v-cntxt-db-num
     1180               ,input v-cntxt-userid
     1181               ) no-error .
     1182             if error-status :error
     1183             then do:
     1184               message
     1185                 vss-workfile vss-revision vss-description skip
     1186                 "Ошибка при расчете складского архива по поставщикам" skip
     1187                 "Объект" buf_clients.obj-type buf_clients.obj-code skip
     1188                 "Информацию о рассчитанных объектах можно посмотреть в файле"
     1189                 "objahsp.log" skip
     1190                 "или в АРМ Администратор" skip
     1191                 "Утилиты/Работа с архивами/Информация о складских архивах" skip
     1192                 error-status :get-message(1) skip
     1193                 return-value skip
     1194                 view-as alert-box error .
     1195               undo, return error .
     1196             end.
     1197           end.
     1198         end.
     1199       end.
     1200       when 3
     1201       then do:
     1202         return .
     1203       end.
     1204     end.
     1205      v-str-obj =   if v-str-obj <> "" then
     1206        substitute( "Некорректные объекты без смены: &1" , trim(v-str-obj, ',') )
     1207        else " " .
     1208     if p-install = false
     1209     then do:
     1210       message
     1211         "Расчет складского архива по поставщикам закончен" skip
     1212         v-str-obj skip
     1213         view-as alert-box information .
     1214     end.
     1215     return .
     1216   end.
