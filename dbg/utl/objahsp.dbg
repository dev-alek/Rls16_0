        3   define input parameter p-install as logical no-undo init no .
        4   define variable v-str-obj as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: dcb7008c86be, 1900, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: druban $":U .
        7   define variable vss-date        as character no-undo init "$Date: Fri Jun 07 16:26:46 2019 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: objahsp.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/objahsp.p $":U .
