        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   define variable mError as logical no-undo.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable mAsyncProc as class ibs.th.file.AsyncProc.
       68   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       69   define variable mstopAsunc as logical no-undo.
       70   function StopCheck returns logical:
       71      define variable oFlag as logical no-undo.
       72      run StopCheckAsync (output oFlag).
       73      return oFlag.
       74   end.
       75   procedure StopCheckAsync:
       76       define output  parameter oFlag as logical no-undo.
       77       if mstopAsunc
       78       then
       79          oFlag = mstopAsunc.
       80       else do:
       81          oFlag = mAsyncProc:CheckStop().
       82          mstopAsunc = oFlag.
       83       end.
       84   end.
       85   function GetParamAsunc returns character
       86   (input iNumPar as integer  ):
       87      return mAsyncProc:GetPARAM(iNumPar).
       88   end.
       89   function GetParamAsuncStr returns ibs.th.file.asyncparam
       90   (input iParamName as character ):
       91      return mAsyncProc:GetPARAM(iParamName).
       92   end.
       93   procedure PutMesAsunc:
       94       define input  parameter Itext as character no-undo.
       95       define variable vflag as logical no-undo.
       96       Publish "WriteLogAsunc" (Itext, yes)  .
       97   end.
       98   procedure PutMesAsuncNoTime:
       99       define input  parameter Itext as character no-undo.
      100       define variable vflag as logical no-undo.
      101       Publish "WriteLogAsunc" (Itext,no)  .
      102   end.
      103   procedure PutStatAsunc:
      104       define input  parameter Itext as character no-undo.
      105       Publish "PutStatAsunc" (Itext,no) .
      106        run
      107       PutMesAsunc (itext).
      108   end.
      109   procedure PutStatAsuncNoTime:
      110       define input  parameter Itext as character no-undo.
      111       Publish "PutStatAsunc" (Itext,no)  .
      112        run
      113       PutMesAsuncNoTime (itext).
      114   end.
      115   procedure PutStatAsuncAdd:
      116       define input  parameter Itext as character no-undo.
      117       Publish "PutStatAsunc" (Itext,yes)  .
      118   end.
      119   procedure PutFileLogAsunc:
      120       define input  parameter IFile as character no-undo.
      121       Publish "PutFileLogAsunc" (ifile)  .
      122   end.
      123          mAsyncProc:mProcPublish = this-procedure.
      124   define variable mProcedure as character no-undo.
      125   mProcedure = GetPARAMAsunc(1).
      126   if mProcedure eq ? then do:
      127      run SetErr( "error   Получение данных было преврвано пользователем." ).
      128   end.
      129   else do:
      130      run RUN_IO_Params  (mProcedure) no-error.
      131      if     return-value ne ""
      132         and return-value ne ?
      133      then
      134         run PutMesAsunc(return-value).
      135      if    StopCheck()
      136      then do:
      137         run PutMesAsunc( "error   Процесс прерван." ).
      138      end.
      139   end.
      140   procedure RUN_IO_Params.
      141      define input        parameter iProcedure as character no-undo.
      142      define variable vNumParams   as integer   no-undo init 1.
      143      define variable vParam       as character no-undo .
      144      define variable vType        as character no-undo init "i" .
      145      define variable vParVal      as character no-undo extent 100.
      146      define variable vParType     as character no-undo extent 100.
      147      define variable vResult      as character no-undo.
      148      define variable vCallObjHand as handle    no-undo.
      149      define variable vi           as integer   no-undo.
      150      define variable vIsError     as logical   no-undo.
      151      Block-Par:
      152      do while true:
      153         vParam = GetPARAMAsunc( vNumParams + 1).
      154         if vParam eq ?
      155         then
      156            leave Block-Par.
      157         else if vParam eq "#?#"
      158         then
      159            vParam = ?.
      160         vParVal  [vNumParams] = vParam.
      161         vParType [vNumParams] = if vType eq "o" then "OUTPUT" else if vType eq "io" then "INPUT-OUTPUT" else "INPUT".
      162         vNumParams = vNumParams + 1.
      163      end.
      164      vNumParams = vNumParams - 1.
      165      create call vCallObjHand.
      166      vCallObjHand:call-name = iProcedure.
      167      vCallObjHand:num-parameters = vNumParams.
      168      do vi = 1 to vNumParams:
      169         vCallObjHand:set-parameter (vi,
      170                                     "CHAR",
      171                                     vParType [vi],
      172                                     vParVal  [vi]).
      173      end.
      174      vCallObjHand:invoke() no-error.
      175      if error-status:error then
      176         assign
      177            vresult  = if error-status:num-messages gt 0
      178                       then error-status:get-message (1)
      179                       else return-value
      180            vIsError = yes
      181         .
      182      else do:
      183         if     return-value ne ""
      184            and return-value ne ?
      185         then do:
      186            do vi = 1 to vNumParams:
      187               vresult = vresult + "," + vParType [vi] + " " + vParVal  [vi].
      188            end.
      189            vresult = "return-value " + return-value + vresult.
      190         end.
      191      end.
      192      delete object vCallObjHand no-error.
      193      if vIsError
      194      then return error vresult.
      195      else return       vresult.
      196   end procedure.
