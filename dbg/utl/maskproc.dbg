        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo.
        3   define input  parameter iMask         as character no-undo.
        4   define input  parameter iFile-name    as character no-undo.
        5   define input  parameter iKey          as character no-undo.
        6   define output parameter oValue        as character no-undo.
        7   define new global shared variable g#library  as handle no-undo .
        8   define new global shared variable g#library2 as handle no-undo .
        9   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       10     define variable v-cntxt-db-num        as integer   no-undo .
       11     define variable v-cntxt-userid        as character no-undo .
       12     define variable v-cntxt-level         as character no-undo .
       13     define variable v-cntxt-host-code-obj as integer   no-undo .
       14     define variable v-cntxt-obj-type      as character no-undo .
       15     define variable v-cntxt-obj-code      as integer   no-undo .
       16     define variable v-cntxt-db-num-obj    as integer   no-undo .
       17     define variable v-cntxt-is-admin      as logical   no-undo .
       18   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       19     run mainmenu_getcntxt in parparentproc
       20       (output v-cntxt-db-num
       21       ,output v-cntxt-userid
       22       ,output v-cntxt-level
       23       ,output v-cntxt-host-code-obj
       24       ,output v-cntxt-obj-type
       25       ,output v-cntxt-obj-code
       26       ,output v-cntxt-db-num-obj
       27       ,output v-cntxt-is-admin
       28       ) .
       29   function ApplyFormatDec returns character ( input iValue as decimal, input iFormat as character ):
       30      define variable oValue as character no-undo.
       31      if iFormat eq ""
       32      then
       33         oValue = string(iValue).
       34      else do:
       35         oValue = string(iValue,iformat) no-error.
       36         if    error-status:error
       37            or oValue eq ?
       38            or oValue eq "?"
       39         then do:
       40            oValue = string(iValue).
       41            message "Ошибка приведения значения тега " iVAlue " к формату " iformat skip
       42                         error-status:get-message (1) skip "Формат проигнорирован."
       43                 view-as alert-box.
       44         end.
       45      end.
       46      return oValue.
       47   end.
       48   function ApplyFormatChar returns character ( input iValue as character , input iFormat as character ):
       49      define variable oValue as character no-undo.
       50      if iFormat eq ""
       51      then
       52         oValue = iValue.
       53      else do:
       54         oValue = string(iValue,iformat) no-error.
       55         if error-status:error
       56         then do:
       57            oValue = iValue.
       58            message "Ошибка приведения значения тега " iVAlue " к формату " iformat skip
       59                         error-status:get-message (1) skip "Формат проигнорирован."
       60                 view-as alert-box.
       61         end.
       62      end.
       63      return oValue.
       64   end.
       65   procedure getTegValue :
       66      define input  parameter iteg as character no-undo.
       67      define input  parameter iParam as character no-undo.
       68      define input  parameter iformat as character no-undo.
       69      define output parameter oValueRet as character no-undo.
       70      define variable vValueInt as integer no-undo.
       71      define variable vLength as integer no-undo.
       72      define variable vFileName as character no-undo.
       73      define variable vKey      as character no-undo.
       74      if iTeg eq "obj-code"
       75      then oValueRet =  ApplyFormatDec(v-cntxt-obj-code,iformat).
       76      else if iTeg eq "obj-type"
       77      then oValueRet = ApplyFormatChar(v-cntxt-obj-type,iformat).
       78      else if iTeg eq "obj-altcode" then
       79         do:
       80            find first ub.clients-attr no-lock where ub.clients-attr.attr-code = "alter-code" and
       81                                                     ub.clients-attr.obj-code = v-cntxt-obj-code and
       82                                                     ub.clients-attr.obj-type = v-cntxt-obj-type no-error .
       83            if available (ub.clients-attr) then oValueRet = ub.clients-attr.attr-value .
       84         end.
       85      else if iTeg eq "obj-altcode or obj-code" then
       86         do:
       87            find first ub.clients-attr no-lock where ub.clients-attr.attr-code = "alter-code" and
       88                                                     ub.clients-attr.obj-code = v-cntxt-obj-code and
       89                                                     ub.clients-attr.obj-type = v-cntxt-obj-type no-error .
       90            if available (ub.clients-attr) then oValueRet = ub.clients-attr.attr-value .
       91            else oValueRet =  ApplyFormatDec(v-cntxt-obj-code,iformat).
       92         end.
       93      else if iTeg eq "obj-name"
       94      then do:
       95         find first ub.clients where ub.clients.obj-type = v-cntxt-obj-type
       96                                 and ub.clients.obj-code = v-cntxt-obj-code
       97         no-lock no-error.
       98         if available ub.clients
       99         then
      100            oValueRet = ApplyFormatChar(ub.clients.obj-name,iformat).
      101      end.
      102      else if iTeg eq "firm-code"
      103      then do:
      104   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      106     (input  v-cntxt-obj-type
      107     ,input  v-cntxt-obj-code
      108     ,output oValueRet
      109     )  .
      110         oValueRet = ApplyFormatChar(oValueRet,iFormat).
      111      end.
      112      else if     length (iTeg) > 0
      113              and trim(caps(iTeg),"N") eq ""
      114      then do:
      115           if num-entries (iparam,";") > 2
      116           then
      117              assign
      118                 vFilename  = entry(1,iParam,";")
      119                 vKey       = entry(2,iParam,";")
      120                 iParam     = entry(3,iParam,";")
      121              .
      122           else if num-entries (iparam,";") > 1
      123           then do:
      124              if caps(entry(1,iParam,";")) eq "CURRENT"
      125              then
      126                 assign
      127                    vFilename  = iFile-name
      128                    vKey       = iKey
      129              iParam     = entry(2,iParam,";").
      130           end.
      131           vValueInt = ?.
      132           publish "getCounter" (vFilename,vKey,iparam,output vValueInt).
      133           if vValueInt = ?
      134           then
      135              run utl/getnextcount.p (vFilename,vKey,if iparam ne "" and iparam ne ? then iparam else "counter", "" ,output vValueInt).
      136           if iformat ne ""
      137           then
      138              oValueRet = ApplyFormatDec (vValueInt,iFormat).
      139           else do:
      140              vLength = length (iTeg).
      141              oValueRet = string (vValueInt).
      142              if vLength > 1
      143              then do:
      144                 oValueRet = string (vValueInt,fill("9",vLength)) no-error.
      145                 if error-status:error
      146                 then
      147                    message "Ошибка приведения тега " iteg " c Параметрами " iParam " к формату " fill("9",vLength) skip
      148                         error-status:get-message (1) "Формат проигнорирован."
      149                       view-as alert-box.
      150              end.
      151           end.
      152      end.
      153   end.
      154   define variable mi      as integer   no-undo.
      155   define variable mPosBeg as integer   no-undo.
      156   define variable mPosEnd as integer   no-undo.
      157   define variable mLenBeg as integer   no-undo.
      158   define variable mLenEnd as integer   no-undo.
      159   define variable mTeg    as character no-undo.
      160   define variable mValue  as character no-undo.
      161   assign
      162      mLenBeg = length("[")
      163      mLenEnd = length("]")
      164   .
      165      run gettegbegend in this-procedure (iMask, output mPosBeg, output mPosEnd).
      166   block-teg:
      167   do while mPosBeg > 0 or mPosEnd > 0:
      168      mi = mi + 1 .
      169      if mi > 20  then leave.
      170      if mPosBeg eq 0 or mPosEnd eq 0 or mPosBeg >= mPosEnd
      171      then do:
      172         message "Тег раньше закрыт чем открыт"
      173            view-as alert-box.
      174         leave block-teg.
      175      end.
      176      if mPosBeg eq 0 then leave block-teg.
      177      if mPosEnd - mPosBeg - mLenBeg > 0
      178      then do:
      179         mTeg = substring(iMask, mPosBeg + mLenBeg , mPosEnd - mPosBeg - mLenBeg  ).
      180         run ParsTeg in this-procedure (mTeg,output mValue).
      181      end.
      182      else
      183         assign
      184            mTeg = ""
      185            mValue  = ""
      186         .
      187      iMask = replace (iMask,"[" + mteg + "]",mValue).
      188      run gettegbegend in this-procedure (iMask, output mPosBeg, output mPosEnd).
      189   end.
      190   procedure gettegbegend:
      191      define input  parameter iMask    as character no-undo.
      192      define output parameter iTegBeg  as integer   no-undo.
      193      define output parameter iTegEnd  as integer   no-undo.
      194      define variable vttt as character no-undo.
      195      assign
      196         iTegBeg = index (iMask,"[")
      197         iTegEnd = index (iMask,"]")
      198      .
      199      vttt = substring(imask, iTegEnd - 2,2) no-error.
      200      if     iTegEnd > 2
      201         and substring(imask, iTegEnd - 2,2) eq "|" + '"'
      202      then
      203         iTegEnd = index (iMask,'"' + "]",iTegEnd) + 1.
      204   end.
      205   define variable ii as integer no-undo.
      206   procedure parsTeg:
      207      define input  parameter iTeg   as character no-undo.
      208      define output parameter oValue as character no-undo.
      209      define variable vFormat  as character no-undo.
      210      define variable vParam   as character no-undo.
      211      define variable vTeg     as character no-undo.
      212      define variable vPosForm as integer   no-undo.
      213      define variable vValue   as character no-undo.
      214      vPosForm = num-entries(iTeg,"|").
      215      if vPosForm > 2
      216      then
      217         assign
      218            vformat = trim(entry(vPosForm,iTeg,"|"),'"')
      219            vParam  =      entry(2,iTeg,"|")
      220            vTeg    =      entry(1,iTeg,"|")
      221         .
      222      else if vPosForm > 1
      223      then
      224         assign
      225            vParam  =      entry(2,iTeg,"|")
      226            vTeg    =      entry(1,iTeg,"|")
      227         .
      228      else
      229         vTeg    = entry(vPosForm,iTeg,"|").
      230      run getTegValue (vTeg,vParam,vformat, output ovalue).
      231      if oValue eq ?
      232      then
      233         oValue = "?".
      234      else
      235         oValue = trim(oValue).
      236   end.
      237   oValue =  imask.
