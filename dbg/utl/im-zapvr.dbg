        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: im-zapvr.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/im-zapvr.p $":U .
        8   define variable vss-description as character no-undo init "Импорт накладных ЗАПР+ из заданной директории".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "X(65)" no-undo
       79   initial "@(#)$Workfile$ $Revision$".
       80   define variable v-filelist-total-file-num           as integer      no-undo .
       81   define variable v-filelist-total-dir-num            as integer      no-undo .
       82   define variable v-filelist-main-procedure-handle    as handle       no-undo .
       83   define variable v-filelist-main-procedure-name      as character    no-undo .
       84   define temp-table temp-dirlist no-undo
       85       field dir-full-name     as character
       86       field dir-short-name    as character
       87       field need-process      as logical
       88       index xpk is primary unique dir-full-name
       89   .
       90   define temp-table temp-filelist no-undo
       91     field file-name        as character
       92     field file-name-no-ext as character
       93     field file-extension   as character
       94     field directory-name   as character
       95     field full-name        as character
       96     field dir-short-name   as character
       97     field need-process     as logical
       98     index xpk is unique primary full-name
       99     index xie1 directory-name file-name
      100     index xie2 directory-name file-name-no-ext
      101     index xie3 file-name
      102     index xie4 file-name-no-ext
      103     index xie5 need-process file-name
      104     .
      105   define stream dir-list .
      106   procedure filelist-get-file-num :
      107     define output parameter p-file-num as integer   no-undo .
      108     do
      109     on error undo, return error return-value
      110     :
      111       assign
      112         p-file-num = v-filelist-total-file-num
      113       .
      114     end.
      115   end procedure.
      116   procedure filelist-clear :
      117     do
      118     on error undo, return error return-value
      119     :
      120       define buffer buf_filelist for temp-filelist .
      121       assign
      122         v-filelist-total-file-num = 0
      123       .
      124       for each buf_filelist
      125       on error undo, return error
      126       :
      127         delete buf_filelist .
      128       end.
      129     end.
      130   end procedure.
      131   procedure filelist-init :
      132     do
      133     on error undo, return error
      134     :
      135       define input parameter p-dir-name       as character no-undo .
      136       define input parameter p-filter-ext     as logical   no-undo .
      137       define input parameter p-ext-list       as character no-undo .
      138       define input parameter p-dir-short-name as character no-undo .
      139       define buffer buf_temp-filelist for temp-filelist .
      140       if p-filter-ext = true
      141          and p-ext-list = ?
      142       or (p-filter-ext = false
      143          and p-ext-list <> ?
      144          and p-ext-list <> "":U
      145          )
      146       then do:
      147         message
      148           vss-workfile vss-revision vss-description skip
      149           "Ошибка задания входных параметров" skip
      150           "p-filter-ext" p-filter-ext skip
      151           "p-ext-list"   p-ext-list   skip
      152           view-as alert-box error .
      153         undo, return error .
      154       end.
      155       for each buf_temp-filelist
      156         where buf_temp-filelist.directory-name = p-dir-name
      157       on error undo, return error return-value
      158       :
      159         delete buf_temp-filelist .
      160       end.
      161       input stream dir-list from os-dir( p-dir-name ).
      162       define variable v-file                  as character no-undo .
      163       define variable v-path                  as character no-undo .
      164       define variable v-mask                  as character no-undo .
      165       define variable v-extension             as character no-undo .
      166       define variable v-file-name-without-ext as character no-undo .
      167       repeat
      168       on error undo, return error
      169       :
      170         import stream dir-list v-file v-path v-mask .
      171         if  v-mask <> ?
      172         and v-mask begins 'F':u
      173         then do:
      174         end.
      175         else do:
      176           next .
      177         end.
      178         if num-entries(v-file, '.':u) > 1
      179         then do:
      180           assign
      181             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      182             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      183           .
      184         end.
      185         else do:
      186           assign
      187             v-extension = ''
      188             v-file-name-without-ext = v-file
      189           .
      190         end.
      191         if p-filter-ext = true
      192         then do:
      193           if lookup(v-extension, p-ext-list) = 0
      194           then do:
      195             next .
      196           end.
      197         end.
      198         create buf_temp-filelist .
      199         assign
      200           buf_temp-filelist.file-name        = v-file
      201           buf_temp-filelist.directory-name   = p-dir-name
      202           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      203           buf_temp-filelist.file-extension   = v-extension
      204           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      205           buf_temp-filelist.dir-short-name   = p-dir-short-name
      206         .
      207         assign
      208           v-filelist-total-file-num = v-filelist-total-file-num + 1
      209         .
      210         if v-filelist-main-procedure-handle <> ?
      211         then do:
      212           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      213             (input "file":U
      214             , input v-filelist-total-file-num
      215             , input buf_temp-filelist.full-name
      216             , input buf_temp-filelist.file-name
      217             ) no-error.
      218           if error-status :error
      219           then do:
      220             message
      221               vss-workfile vss-revision vss-description skip
      222               "filelist-dirlist-subdir-init" skip(1)
      223               skip "Ошибка при вызове процедуры вывода"
      224               skip "результатов сканирования каталогов."
      225               skip return-value
      226               skip trim(error-status :get-message(1))
      227                       trim(error-status :get-message(2))
      228                       trim(error-status :get-message(3))
      229               view-as alert-box error.
      230             undo, return error .
      231           end.
      232         end.
      233       end.
      234       input stream dir-list close .
      235       return.
      236     end.
      237   end procedure.
      238   procedure filelist-dirlist-init-by-list :
      239     do
      240     on error undo, return error
      241     :
      242       define input parameter p-root-dir   as character no-undo .
      243       define input parameter p-dir-list   as character no-undo .
      244       define input parameter p-filter-ext as logical   no-undo .
      245       define input parameter p-ext-list   as character no-undo .
      246       define variable v-num-appdir as integer   no-undo .
      247       do v-num-appdir = 1 to num-entries(p-dir-list)
      248       :
      249         define variable v-curr-dir  as character no-undo .
      250         assign
      251           v-curr-dir = entry(v-num-appdir, p-dir-list)
      252         .
      253         run filelist-init in this-procedure
      254           (input p-root-dir + '/':u + v-curr-dir
      255           ,input p-filter-ext
      256           ,input p-ext-list
      257           ,input v-curr-dir
      258           ) .
      259       end.
      260     end.
      261   end procedure.
      262   procedure filelist-dirlist-clear :
      263     do
      264     on error undo, return error
      265     :
      266       define buffer buf_temp-dirlist for temp-dirlist .
      267       assign
      268           v-filelist-total-dir-num = 0
      269       .
      270       for each buf_temp-dirlist
      271       on error undo, return error
      272       :
      273         delete buf_temp-dirlist .
      274       end.
      275     end.
      276   end procedure.
      277   procedure filelist-dirlist-subdir-init :
      278   define input parameter p-dir-name   as character no-undo .
      279       define buffer buf_temp-dirlist for temp-dirlist .
      280   do
      281   for buf_temp-dirlist
      282   on error undo, return error
      283   :
      284       assign
      285           file-info :file-name = p-dir-name
      286       .
      287       if file-info :full-pathname = ?
      288       or index( file-info :file-type, "D" ) = 0
      289       then do:
      290           message
      291               vss-workfile vss-revision vss-description skip
      292               "filelist-dirlist-init: Заданного каталога не существует."
      293               skip (1)
      294               skip "Задан каталог:"
      295               skip substitute( "'&1'", p-dir-name )
      296           view-as alert-box error .
      297           undo, return error .
      298       end.
      299       input stream dir-list from os-dir( p-dir-name ).
      300       define variable v-file                  as character no-undo .
      301       define variable v-path                  as character no-undo .
      302       define variable v-mask                  as character no-undo .
      303       file-in-directory:
      304       repeat
      305       on error undo, return error
      306       :
      307           import stream dir-list
      308               v-file
      309               v-path
      310               v-mask
      311           .
      312           if  v-mask = ?
      313           or index( v-mask, 'D':u ) = 0
      314           or v-file = ".":U
      315           or v-file = "..":U
      316           then do:
      317               next file-in-directory.
      318           end.
      319           else do:
      320               find first buf_temp-dirlist
      321                    where buf_temp-dirlist.dir-full-name    = v-path
      322               no-error.
      323               if not available buf_temp-dirlist
      324               then do:
      325                   create buf_temp-dirlist .
      326                   assign
      327                       buf_temp-dirlist.dir-full-name    = v-path
      328                       buf_temp-dirlist.dir-short-name   = v-file
      329                       buf_temp-dirlist.need-process     = yes
      330                   .
      331               end.
      332               assign
      333                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      334               .
      335               if v-filelist-main-procedure-handle <> ?
      336               then do:
      337                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      338                         input "dir":U
      339                       , input v-filelist-total-dir-num
      340                       , input buf_temp-dirlist.dir-full-name
      341                       , input buf_temp-dirlist.dir-short-name
      342                   ) no-error.
      343                   if error-status :error
      344                   then do:
      345                       message
      346                           vss-workfile vss-revision vss-description skip
      347                           "filelist-dirlist-subdir-init"
      348                           skip(1)
      349                           skip "Ошибка при вызове процедуры вывода"
      350                           skip "результатов сканирования каталогов."
      351                           skip return-value
      352                           skip trim(error-status :get-message(1))
      353                                trim(error-status :get-message(2))
      354                                trim(error-status :get-message(3))
      355                       view-as alert-box error.
      356                       undo, return error .
      357                   end.
      358               end.
      359           end.
      360       end.
      361       input stream dir-list close .
      362   end.
      363   end procedure.
      364   procedure filelist-dirlist-init :
      365   define input parameter p-dir-name   as character no-undo .
      366       define variable v-file  as character no-undo.
      367       define variable v-path  as character no-undo.
      368       define variable v-mask  as character no-undo.
      369       define buffer buf_temp-dirlist for temp-dirlist .
      370   do
      371   for buf_temp-dirlist
      372   on error undo, return error
      373   :
      374       assign
      375           file-info :file-name = p-dir-name
      376       .
      377       if file-info :full-pathname = ?
      378       or index( file-info :file-type, "D" ) = 0
      379       then do:
      380           message
      381               vss-workfile vss-revision vss-description skip
      382               "filelist-dirlist-init: Заданного каталога не существует."
      383               skip (1)
      384               skip "Задан каталог:"
      385               skip substitute( "'&1'", p-dir-name )
      386           view-as alert-box error .
      387           undo, return error .
      388       end.
      389       for each buf_temp-dirlist
      390          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      391       on error undo, return error return-value
      392       :
      393           delete buf_temp-dirlist .
      394       end.
      395       create buf_temp-dirlist .
      396       assign
      397           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      398           buf_temp-dirlist.dir-short-name   = file-info :file-name
      399           buf_temp-dirlist.need-process     = yes
      400       .
      401       do
      402       while available buf_temp-dirlist
      403       on error undo, return error
      404       :
      405           run filelist-dirlist-subdir-init in this-procedure (
      406               input buf_temp-dirlist.dir-full-name
      407           ).
      408           assign
      409               buf_temp-dirlist.need-process = no
      410           .
      411           find first buf_temp-dirlist
      412                where buf_temp-dirlist.need-process = yes
      413           no-error.
      414       end.
      415   end.
      416   end procedure.
      417   procedure filelist-set-procedure-handle :
      418   define input parameter p-proc-handle    as handle           no-undo.
      419   define input parameter p-proc-name      as character        no-undo.
      420       define variable v-signature    as character    no-undo.
      421   do
      422   on error undo, return error
      423   :
      424       if p-proc-handle = ?
      425       or not valid-handle( p-proc-handle )
      426       or p-proc-handle :get-signature( p-proc-name ) = ""
      427       then do:
      428           assign
      429               v-filelist-main-procedure-handle = ?
      430               v-filelist-main-procedure-name   = ""
      431           .
      432           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      433       end.
      434       else do:
      435           assign
      436               v-signature = p-proc-handle :get-signature( p-proc-name )
      437           .
      438           if entry(   1, v-signature )    = "PROCEDURE":U
      439           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      440           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      441           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      442           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      443           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      444           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      445           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      446           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      447           then do:
      448               assign
      449                   v-filelist-main-procedure-handle = p-proc-handle
      450                   v-filelist-main-procedure-name   = p-proc-name
      451               .
      452           end.
      453           else do:
      454               assign
      455                   v-filelist-main-procedure-handle = ?
      456                   v-filelist-main-procedure-name   = ""
      457               .
      458               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      459           end.
      460       end.
      461   end.
      462   end procedure.
      463   procedure filelist-clear-procedure-handle :
      464   do
      465   on error undo, return error
      466   :
      467       assign
      468           v-filelist-main-procedure-handle = ?
      469           v-filelist-main-procedure-name   = ?
      470       .
      471   end.
      472   end procedure.
      473   procedure filelist-build-by-dirlist :
      474       define buffer buf_temp-dirlist      for temp-dirlist.
      475   do
      476   for buf_temp-dirlist
      477   on error undo, return error
      478   :
      479       for each buf_temp-dirlist
      480       on error undo, return error
      481       :
      482           run filelist-init in this-procedure (
      483                 input buf_temp-dirlist.dir-full-name
      484               , input no
      485               , input "":U
      486               , input buf_temp-dirlist.dir-short-name
      487           ).
      488       end.
      489   end.
      490   end procedure.
      491   procedure filelist-check-dir-exists :
      492   define input parameter p-dir-name   as character        no-undo.
      493   define output parameter p-exists    as logical          no-undo.
      494   do
      495   on error undo, return error
      496   :
      497       assign
      498           file-info :file-name = p-dir-name
      499       .
      500       if file-info :file-type <> ?
      501       and substring( file-info :file-type, 1, 1 ) = "D":U
      502       then do:
      503           assign
      504               p-exists = yes
      505           .
      506       end.
      507       else do:
      508           assign
      509               p-exists = no
      510           .
      511       end.
      512   end.
      513   end procedure.
      514   define variable v-source-dir  as character no-undo .
      515   define variable v-archive-dir as character no-undo .
      516   define variable v-ok as logical   no-undo .
      517   define variable v-err as logical   no-undo .
      518   define variable v-os-error as integer   no-undo .
      519   define variable v-kol as integer   no-undo .
      520   define variable v-file-arh as character no-undo .
      521   define variable v-trn-doc as character no-undo .
      522   define variable i as integer   no-undo .
      523   v-err = false .
      524   v-kol = 0 .
      525   define stream err .
      526   output stream err to value("ExpenseExternal.err" )  .
      527   run utl/dir-izp.w (
      528       output v-source-dir  ,
      529       output v-archive-dir ).
      530   if v-source-dir  = ? or v-archive-dir = ? then do:
      531      put stream err unformatted  "Не заданы директроии Источника и Архива" skip .
      532      output stream err close .
      533      return .
      534   end.
      535   define variable g#log as logical no-undo .
      536   g#log =  session:SET-WAIT-STATE("GENERAL") .
      537       run filelist-init
      538           ( v-source-dir ,
      539             true         ,
      540             "xml"        ,
      541             v-source-dir
      542             )  no-error .
      543               if error-status :error then do:
      544               put stream err unformatted  substitute("&3 &4 &5 - не верно заданы директории. Ошибка:  &1 &2" , return-value , error-status :get-message(1) , string(today , "99/99/9999") , string( time, "hh:mm:ss") ) skip .
      545               output stream err close .
      546               return error  .
      547             end.
      548         for each temp-filelist
      549             on error undo, return error :
      550             v-file-arh =  substitute("&1\&2" , v-archive-dir , temp-filelist.file-name ) .
      551             run utl/im-zaptt.p (
      552                 input parparentproc ,
      553                 input temp-filelist.full-name ,
      554                 output  v-ok  ,
      555                 output  v-trn-doc )
      556                 no-error .
      557                 if error-status :error then do:
      558                    put stream err unformatted
      559                       substitute("&3 &4 &5 - не принят Ошибка:  &1 &2" , return-value , error-status :get-message(1) , string(today , "99/99/9999") , string( time, "hh:mm:ss") , temp-filelist.file-name )
      560                       chr(10) .
      561                 .
      562                 end.
      563                 if v-ok then do:
      564                     v-kol = v-kol + 1.
      565                     os-rename value(temp-filelist.full-name) value(v-file-arh)  .
      566                     v-os-error = os-error .
      567                     run make-error (v-os-error) .
      568                 end.
      569                 else do:
      570                    v-err = true .
      571                    run make-error (v-os-error) .
      572                 end.
      573         end.
      574   output stream err close .
      575   g#log =  session:SET-WAIT-STATE("") .
      576   if v-err = true then do:
      577     message "НЕ все файлы закачались !"  skip
      578     "Закачалось файлов: " v-kol skip
      579     "Ошибки в файле ExpenseExternal.err"
      580      view-as alert-box information .
      581   end.
      582   else do:
      583     message "ВСЕ!"  skip
      584      "Закачалось файлов: " v-kol view-as alert-box information .
      585   end.
      586   procedure make-error :
      587   define input  parameter p-error as integer   no-undo .
      588     do
      589     on error undo, return error return-value
      590     :
      591   define variable v-temp-name as character no-undo .
      592   define variable v-err-txt as character no-undo .
      593   define variable varchip-num as integer no-undo .
      594   define buffer buf_trn-doc for ub.trn-doc  .
      595      case p-error:
      596        when 0 then do:
      597        end.
      598        when 10 then do:
      599           message "Такой файл уже есть в архиве, будет перенесен с другим именем" view-as alert-box information .
      600           v-temp-name =  substitute("&1\&2_&3&4.&5" , v-archive-dir , temp-filelist.file-name-no-ext, integer(today), time ,temp-filelist.file-extension) .
      601           message v-temp-name.
      602           os-rename value(temp-filelist.full-name) value(v-temp-name)  .
      603        end.
      604        otherwise do:
      605          v-err = false .
      606          run adm/os-err.p ( output v-err-txt ) .
      607           if v-ok = false then do:
      608             repeat i = 1 to num-entries(v-trn-doc) :
      609               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = entry(i,v-trn-doc) no-error .
      610               if available buf_trn-doc then do:
      611                     run str/del-doc.p
      612                     ( input  parparentproc,
      613                       input  v-trn-doc,
      614                       input  g#db-num,
      615                       input  "del-doc.err",
      616                       input  ?,
      617                       input  ?,
      618                       input  g#userid,
      619                       input  "",
      620                       input  "",
      621                       output varchip-num ) no-error .
      622               end.
      623             end.
      624           end.
      625           if v-err-txt <> ""  then  put stream err unformatted v-err-txt skip.
      626        end.
      627      end case.
      628     end.
      629   end procedure.
