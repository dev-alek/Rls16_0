        1   DEFINE TEMP-TABLE temp-attr-prop NO-UNDO LIKE ub.attr-prop
        2          field upper-prop-label as character
        3          field prop-label as character
        4          field full-prop-name as character.
        5   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        6   define input parameter p-table-name as character no-undo .
        7   DEFINE OUTPUT PARAMETER p-upper-prop-code AS character NO-UNDO.
        8   DEFINE OUTPUT PARAMETER p-upper-node-code AS integer NO-UNDO.
        9   DEFINE OUTPUT PARAMETER p-upper-prop-label AS character NO-UNDO.
       10   DEFINE OUTPUT PARAMETER p-upper-full-prop-name AS character NO-UNDO.
       11   DEFINE OUTPUT PARAMETER p-prop-code AS character NO-UNDO.
       12   DEFINE OUTPUT PARAMETER p-node-code AS integer NO-UNDO.
       13   DEFINE OUTPUT PARAMETER p-prop-label AS character NO-UNDO.
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Редактирование свойств атрибута".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define variable v-waitfram-action01         as character   no-undo .
       76   define variable v-waitfram-action02         as character   no-undo .
       77   define variable v-waitfram-action03         as character   no-undo .
       78   define variable mWaitFramTextBeg            as character   no-undo.
       79   define variable mWaitFramTextEnd            as character   no-undo.
       80   define variable mWaitFramView               as logical     no-undo.
       81   define variable mWaitProcEvent              as logical     no-undo init yes.
       82   define variable mWaitFramInterval           as integer     no-undo init 1 .
       83   define variable mWaitFramStop               as logical     no-undo.
       84   define variable mWaitFramStopUser           as logical     no-undo.
       85   define variable mWaitFramStopTimeOut        as logical     no-undo.
       86   define variable mWaitFramStartProc          as datetime-tz no-undo.
       87   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       88   define button B-WaitFramStop auto-end-key
       89        label "Стоп"
       90        size 10 by 1 tooltip "Остоновить процесс".
       91   define button B-viewProcInfo
       92        label "Информация"
       93        size 15 by 1 tooltip "Информация о процесс".
       94   define frame waitfram
       95     v-waitfram-action01 format "x(72)" no-label skip
       96     v-waitfram-action02 format "x(72)" no-label skip
       97     v-waitfram-action03 format "x(72)" no-label skip
       98     B-viewProcInfo
       99     B-WaitFramStop at row 4 col 30
      100     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      101     .
      102   define new global shared variable mBatchMode as logical no-undo init ?.
      103   define variable mFramBachModHandle as handle no-undo.
      104   mFramBachModHandle = frame waitfram:handle.
      105   define variable mFameOldVis as logical no-undo.
      106   define variable mVisCUrentVin as logical no-undo.
      107   if session:batch-mode
      108   then
      109      mBatchMode = yes.
      110   if mBatchMode = ? then do:
      111     mVisCUrentVin = current-window:visible.
      112     mFameOldVis = mFramBachModHandle:visible.
      113     mFramBachModHandle:visible  = yes.
      114     mBatchMode = mFramBachModHandle:visible ne yes.
      115     mFramBachModHandle:visible = mFameOldVis.
      116     current-window:visible = mVisCUrentVin.
      117   end.
      118    if  log-manager:logfile-name ne ?
      119     then DO:
      120         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      121         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      122         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      123     end.
      124   on choose of B-WaitFramStop in frame waitfram
      125   do:
      126     mWaitFramStop = yes.
      127     mWaitFramStopUser = yes.
      128   end.
      129   function waitfram-check-timeout returns logical():
      130      define variable vtime as int64 no-undo.
      131      if mWaitFramStopTimeOut
      132      then
      133         return yes.
      134      vtime = ( now - mWaitFramStartProc ) / 1000 .
      135      if     mWaitFramTimeOut ne ?
      136         and mWaitFramTimeOut ne 0
      137         and mWaitFramTimeOut lt vtime
      138      then do:
      139         mWaitFramStopTimeOut = yes.
      140      end.
      141      return mWaitFramStopTimeOut.
      142   end.
      143   procedure waitfram-hide :
      144     if not session:batch-mode
      145     then do
      146     on error undo, return error return-value
      147     :
      148       pause 0 before-hide .
      149       if not mBatchMode then
      150         hide frame waitfram .
      151     if     not mWaitFramView
      152        and mWaitProcEvent
      153     then
      154       process events .
      155     end.
      156   end procedure.
      157   procedure waitfram-show :
      158     define input  parameter p-message as character no-undo .
      159     define variable v-left-margin as integer   no-undo .
      160     if not session:batch-mode
      161     then do
      162     on error undo, return error return-value
      163     :
      164       if length(p-message) <= 70 then do:
      165         assign
      166           v-left-margin = integer((70 - length(p-message)) / 2)
      167         .
      168         assign
      169           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      170         .
      171         assign
      172           v-waitfram-action01 = " "
      173           v-waitfram-action02 = " "
      174                                    + fill(" ", v-left-margin)
      175                                    + p-message
      176           v-waitfram-action03 = " "
      177         .
      178       end.
      179       else do:
      180         define variable vRindex1 as integer no-undo.
      181         define variable vRindex2 as integer no-undo.
      182         vRindex1 = r-index(p-message," ",70).
      183         if vRindex1 = 0
      184         then
      185            vRindex1 = 70.
      186         if length(p-message)  <= vRindex1 + 70 then do:
      187           assign
      188             v-waitfram-action01 = " "
      189             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      191           .
      192         end.
      193         else do:
      194           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      195           if vRindex2 <= vRindex1
      196           then
      197              vRindex2 = vRindex1 + 70.
      198           assign
      199             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      200             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      202           .
      203         end.
      204       end.
      205       B-viewProcInfo:visible   in frame waitfram = no.
      206       B-viewProcInfo:sensitive in frame waitfram = no.
      207       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      209       if  (   mWaitFramView
      210          or  mWaitProcEvent)
      211          and not mBatchMode
      212       then
      213          display
      214             v-waitfram-action01 skip
      215             v-waitfram-action02 skip
      216             v-waitfram-action03 skip
      217          with frame waitfram .
      218       if     mWaitFramView
      219          then do:
      220             if     mWaitFramInterval ne ?
      221                and not mBatchMode
      222             then
      223                wait-for go of frame waitfram pause mWaitFramInterval.
      224          end.
      225          else
      226             if     mWaitProcEvent
      227                and not mBatchMode
      228             then
      229                process events .
      230     end.
      231   end procedure.
      232      procedure waitfram-show-this:
      233         define input  parameter iInterval as int64 no-undo.
      234         define variable vtime as int64 no-undo.
      235         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      236         mWaitFramInterval = iInterval.
      237         run waitfram-show (substitute("&1&2 &3&4" ,
      238                                       mWaitFramTextBeg ,
      239                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      240                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      241                                       mWaitFramTextEnd
      242                                      )
      243                           ).
      244      end.
      245      procedure WaitFramRunPause:
      246         define input  parameter iInterval as dec no-undo.
      247         define variable vStart  as datetime-tz no-undo.
      248         define variable vend    as datetime-tz no-undo.
      249         define variable vint as int64 no-undo.
      250         define variable vOk as logical no-undo.
      251         vStart = now.
      252         vend   = vStart.
      253         publish "WaitFramPause" (iInterval,output vOk).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and (   vint > 0
      259                 or (    not vOk
      260                     and iInterval eq ?
      261                     )
      262                 )
      263         then
      264            run waitfram-show-this (iInterval).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and vint > 0
      270         then do:
      271            run gbl/pause.p (vint * 1000).
      272         end.
      273         if iInterval ne ?
      274         then
      275            publish "WaitFramStop".
      276         waitfram-check-timeout().
      277      end.
      278      procedure WaitFramWaitFor:
      279         define input  parameter iInterval as dec no-undo.
      280         assign
      281            mWaitFramStartProc   = now
      282            mWaitFramStopUser    = no
      283            mWaitFramStopTimeOut = no
      284         .
      285         block-wait:
      286         do while not mWaitFramStop:
      287            run WaitFramRunPause (iInterval).
      288            if  waitfram-check-timeout()
      289            then do:
      290               leave block-wait.
      291            end.
      292         end.
      293         run waitfram-hide.
      294      end.
      295   procedure waitfram-join :
      296     define input  parameter p-line-1  as character no-undo .
      297     define input  parameter p-line-2  as character no-undo .
      298     define input  parameter p-line-3  as character no-undo .
      299     define output parameter p-message as character no-undo .
      300     do
      301     on error undo, return error return-value
      302     :
      303       assign
      304         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      307       .
      308     end.
      309   end procedure.
      310   function waitfram-join-function returns character
      311     (input p-line-1 as character
      312     ,input p-line-2 as character
      313     ,input p-line-3 as character
      314     ).
      315     define variable v-message as character no-undo .
      316     run waitfram-join in this-procedure
      317       (input  p-line-1
      318       ,input  p-line-2
      319       ,input  p-line-3
      320       ,output v-message
      321       ) .
      322     return v-message .
      323   end function .
      324   define new global shared variable g#language as character no-undo .
      325   if g#language <> '' and g#language <> 'rus':U then do:
      326     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      327   end.
      328   procedure proc-alt-shift-f2:
      329     if not ibs.th.gbl.gbl-var:rcode
      330   then
      331     run gbl\inidebug.p .
      332   end.
      333   procedure proc-alt-shift-f3:
      334     run gbl/prvssinf.p
      335       ( input this-procedure
      336       ) .
      337   end.
      338   define variable v-inform-launched as logical no-undo initial false .
      339   procedure proc-alt-shift-f4:
      340     define variable v-action as character no-undo .
      341     if v-inform-launched = false then do:
      342       assign
      343         v-inform-launched = true
      344       .
      345       run gbl/d-inform.w
      346         (  input self
      347         ,  input this-procedure
      348         , output v-action
      349         ) no-error .
      350       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      351       assign
      352         v-inform-launched = false
      353       .
      354     end.
      355   end.
      356   procedure proc-alt-f1:
      357     run gbl/corrhelp.p
      358       (input this-procedure
      359       ) .
      360   end .
      361   on alt-shift-f2 anywhere do:
      362     run proc-alt-shift-f2.
      363   end.
      364   on alt-shift-f3 anywhere do:
      365     run proc-alt-shift-f3 in this-procedure .
      366   end.
      367   on alt-shift-f4 anywhere do:
      368     run proc-alt-shift-f4 in this-procedure.
      369   end.
      370   on alt-f1 anywhere do:
      371     run proc-alt-f1 in this-procedure .
      372   end.
      373   DEFINE STREAM instream.
      374   DEFINE BUTTON B-exit AUTO-GO
      375        LABEL "&Ввод"
      376        SIZE 10 BY 1
      377        BGCOLOR 8 .
      378   DEFINE BUTTON B-Help
      379        LABEL "Помо&щь"
      380        SIZE 3 BY 1
      381        BGCOLOR 8 .
      382   DEFINE BUTTON b-quit AUTO-END-KEY
      383        LABEL "&Отмена"
      384        SIZE 10 BY 1
      385        BGCOLOR 8 .
      386   DEFINE VARIABLE f-prop-code AS CHARACTER FORMAT "X(256)":U
      387        LABEL "Название  пар-ра"
      388        VIEW-AS FILL-IN NATIVE
      389        SIZE 28.5 BY 1 NO-UNDO.
      390   DEFINE VARIABLE f-prop-label AS CHARACTER FORMAT "X(256)":U
      391        LABEL "Лейбл  пар-ра"
      392        VIEW-AS FILL-IN NATIVE
      393        SIZE 28.5 BY 1 NO-UNDO.
      394   DEFINE VARIABLE f-upper-prop-code AS CHARACTER FORMAT "X(256)":U
      395        LABEL "Название  секции"
      396        VIEW-AS FILL-IN NATIVE
      397        SIZE 28.5 BY 1 NO-UNDO.
      398   DEFINE VARIABLE f-upper-prop-label AS CHARACTER FORMAT "X(256)":U
      399        LABEL "Лейбл секции"
      400        VIEW-AS FILL-IN NATIVE
      401        SIZE 28.5 BY 1 NO-UNDO.
      402   DEFINE VARIABLE rs-add AS CHARACTER INITIAL "sel"
      403        VIEW-AS RADIO-SET HORIZONTAL
      404        RADIO-BUTTONS
      405             "Существующий", "sel",
      406   "Новый", "add"
      407        SIZE 23.5 BY 1 NO-UNDO.
      408   DEFINE QUERY BR-attr-prop FOR
      409         temp-attr-prop SCROLLING.
      410   DEFINE BROWSE BR-attr-prop
      411     QUERY BR-attr-prop NO-LOCK DISPLAY
      412         temp-attr-prop.upper-prop-code COLUMN-LABEL "Назв.секции" FORMAT "X(255)" WIDTH 12
      413         temp-attr-prop.upper-node-code COLUMN-LABEL "Код выше.!узла" FORMAT ">>>>9"
      414   temp-attr-prop.upper-prop-label COLUMN-LABEL "Лейбл секции" FORMAT "X(255)" WIDTH 30
      415   temp-attr-prop.node-code COLUMN-LABEL "Код!узла" FORMAT ">>>>9"
      416   temp-attr-prop.prop-code  COLUMN-LABEL "Назв.пар-ра" FORMAT "X(255)" WIDTH 12
      417   temp-attr-prop.prop-label COLUMN-LABEL "Лейбл пар-ра" FORMAT "X(255)" WIDTH 30
      418       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.5 FIT-LAST-COLUMN.
      419   DEFINE FRAME Dialog-Frame
      420        B-exit AT ROW 1 COL 1
      421        b-quit AT ROW 1 COL 11
      422        rs-add AT ROW 1 COL 39 NO-LABEL WIDGET-ID 50
      423        B-Help AT ROW 1 COL 95
      424        f-upper-prop-code AT ROW 2 COL 17 COLON-ALIGNED WIDGET-ID 42
      425        f-upper-prop-label AT ROW 2 COL 66.5 COLON-ALIGNED WIDGET-ID 46
      426        f-prop-label AT ROW 3 COL 66.5 COLON-ALIGNED WIDGET-ID 48
      427        f-prop-code AT ROW 3.27 COL 17 COLON-ALIGNED WIDGET-ID 44
      428        BR-attr-prop AT ROW 4.77 COL 1 WIDGET-ID 100
      429       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      430            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      431            TITLE ""
      432            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      433   ASSIGN
      434          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      435          FRAME Dialog-Frame:HIDDEN           = TRUE.
      436   ASSIGN
      437          f-upper-prop-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      438   ASSIGN
      439          f-upper-prop-label:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      440   ON GO OF FRAME Dialog-Frame
      441   DO:
      442     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      443   END.
      444   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      445   DO:
      446     APPLY "END-ERROR":U TO SELF.
      447   END.
      448   ON MOUSE-SELECT-DBLCLICK OF BR-attr-prop IN FRAME Dialog-Frame
      449   DO:
      450     if not available temp-attr-prop then return no-apply.
      451     apply "go":u to frame Dialog-Frame.
      452   END.
      453   ON VALUE-CHANGED OF BR-attr-prop IN FRAME Dialog-Frame
      454   DO:
      455     IF rs-add = "add" THEN DO:
      456       rs-add = "sel".
      457       DISPLAY
      458       rs-add
      459       WITH FRAME Dialog-Frame.
      460     END.
      461     DISPLAY
      462     temp-attr-prop.upper-prop-code @ f-upper-prop-code
      463     temp-attr-prop.upper-prop-label @ f-upper-prop-label
      464     temp-attr-prop.prop-code @ f-prop-code
      465     temp-attr-prop.prop-label @ f-prop-label
      466     WITH FRAME Dialog-Frame
      467     .
      468   END.
      469   ON VALUE-CHANGED OF rs-add IN FRAME Dialog-Frame
      470   DO:
      471     DEFINE BUFFER buf_temp-attr-prop FOR temp-attr-prop.
      472     ASSIGN
      473      rs-add.
      474     CASE rs-add:
      475       WHEN "add" THEN DO:
      476         IF NOT AVAILABLE temp-attr-prop THEN DO:
      477           MESSAGE
      478           "Не к чему привязать"
      479           VIEW-AS ALERT-BOX ERROR.
      480           ASSIGN
      481           rs-add = "sel".
      482           DISPLAY
      483           rs-add
      484           WITH FRAME Dialog-Frame.
      485           UNDO, RETURN NO-APPLY.
      486         END.
      487           ASSIGN
      488           f-prop-code = '':U
      489           f-prop-label = '':U
      490           f-upper-prop-code = temp-attr-prop.prop-code
      491           f-upper-prop-label = temp-attr-prop.prop-label
      492           .
      493           DISPLAY
      494           f-prop-code
      495           f-prop-label
      496           f-upper-prop-code
      497           f-upper-prop-label
      498           WITH frame Dialog-Frame.
      499       ENd.
      500     END CASE.
      501   END.
      502   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      503   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      504   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   on help of frame Dialog-Frame
      506   do:
      507     run gbl/app_help.p
      508       (input this-procedure :file-name
      509       ,input ''
      510       ,input ?
      511       ) no-error.
      512     if error-status :error then do:
      513       message
      514         "Ошибка при вызове помощи"
      515         error-status :get-message(1)
      516         view-as alert-box .
      517     end.
      518   end.
      519   run minbtn-set in this-procedure .
      520   on choose of b-help in frame Dialog-Frame
      521   do:
      522     apply "help":u to frame Dialog-Frame .
      523   end.
      524   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      525   procedure minbtn-set :
      526       do
      527           on error undo, return error return-value
      528           :
      529           define variable ii              as integer       no-undo .
      530           define variable fh              as widget-handle no-undo .
      531           define variable hh              as widget-handle no-undo .
      532           define variable v-h             as handle        extent 4 no-undo .
      533           define variable v-name-button   as character     no-undo .
      534           define variable v-help-old-x    as decimal       no-undo .
      535           define variable v-help-old-y    as decimal       no-undo .
      536           define variable v-help-old-size as decimal       no-undo .
      537           define variable v-frame-width   as decimal       no-undo .
      538           define variable jj              as integer       no-undo .
      539           do
      540               on error undo, return error
      541               :
      542               assign
      543                   v-frame-width = frame Dialog-Frame:width - 0.3
      544                   fh            = frame Dialog-Frame:first-child
      545                   hh            = fh:first-child
      546                   ii            = 1
      547                   .
      548               do while valid-handle(hh):
      549                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      550                   do:
      551                       case lc(hh:name) :
      552                           when "b-help" then
      553                               do:
      554                                   hh:load-image-up("cmp/b-help.bmp":u) .
      555                                   hh:load-image-down("cmp/b-help.bmp":u) .
      556                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      557                                   hh:TOOLTIP = "Помощь" .
      558                                   v-help-old-x = hh:column .
      559                                   v-help-old-y = hh:row    .
      560                                   v-help-old-size = hh:width .
      561                                   hh:width-chars = 2.5 .
      562                               end.
      563                           when "b-print" then
      564                               do:
      565                                   hh:load-image("cmp/b-print.bmp":u) .
      566                                   hh:TOOLTIP = "Печать" .
      567                                   v-h[ii] = hh:handle .
      568                                   ii = ii + 1 .
      569                                   hh:width-chars = 3 .
      570                               end.
      571                           when "b-history" or
      572                           when "b-hist" then
      573                               do:
      574                                   hh:load-image("cmp/b-hist.bmp":u) .
      575                                   hh:TOOLTIP = "История" .
      576                                   v-h[ii] = hh:handle .
      577                                   ii = ii + 1 .
      578                                   hh:width-chars = 3 .
      579                               end.
      580                           when "b-sch" then
      581                               do:
      582                                   hh:load-image("cmp/b-sch.bmp":u) .
      583                                   hh:TOOLTIP = "Установка Фильтра" .
      584                                   v-h[ii] = hh:handle .
      585                                   ii = ii + 1 .
      586                                   hh:width-chars = 3 .
      587                               end.
      588                           when "b-hist-user" then
      589                               do:
      590                                   hh:load-image("cmp/b-hist.bmp":u) .
      591                                   hh:TOOLTIP = "История пользователя" .
      592                                   ii = ii + 1 .
      593                               end.
      594                       end case.
      595                   end.
      596                   hh = hh:next-sibling.
      597               end.
      598               b-help:column = v-frame-width - b-help:width-chars.
      599               jj = 0.
      600               repeat ii = 4 to 1 by -1 :
      601                   if valid-handle (v-h[ii] ) then
      602                   do:
      603                       jj  = jj + 1 .
      604                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      605                       v-h[ii]:row    = v-help-old-y .
      606                   end.
      607               end.
      608           end.
      609       end.
      610   end procedure.
      611   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      612   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      613   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      614   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      615   define variable v-diasize-current-frame-width  as decimal   no-undo .
      616   define variable v-diasize-current-frame-height as decimal   no-undo .
      617   define variable v-diasize-change-size          as logical   no-undo .
      618   define variable v-diasize-resize-button        as handle    no-undo .
      619   define variable v-diasize-wndmax               as logical   no-undo .
      620   define variable v-diasize-wndstore             as logical   no-undo .
      621   define variable v-diasize-proc-name            as character no-undo .
      622   define variable v-diasize-browse-handle        as handle    no-undo .
      623   define variable v-diasize-browse-number        as integer   no-undo .
      624   define variable v-diasize-need-full-display    as logical   no-undo init false .
      625   define temp-table temp-diasize-handle no-undo
      626     field handle-value  as handle
      627     field save-position as decimal
      628     index xpk is primary unique handle-value
      629     .
      630   define temp-table temp-browse-handle no-undo
      631     field browse-type   as character
      632     field browse-number as integer
      633     field browse-handle as handle
      634     field original-size as decimal
      635     index xpk is primary unique browse-type browse-number
      636     index xie browse-type browse-handle
      637   .
      638   procedure diasize_change-height :
      639     define input  parameter p-change-value  as decimal   no-undo .
      640     define input  parameter p-move-resize   as logical   no-undo .
      641     define variable v-field-group-handle    as handle    no-undo .
      642     define variable v-object-handle         as handle    no-undo .
      643     define variable v-frame-height          as decimal   no-undo .
      644     define variable v-frame-virtual-height  as decimal   no-undo .
      645     define variable v-browse-height         as decimal   no-undo .
      646     define variable v-window-height         as decimal   no-undo .
      647     define variable v-window-virtual-height as decimal   no-undo .
      648     define variable v-change-sign           as integer   no-undo .
      649     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      650     define buffer buf_temp-browse-handle  for temp-browse-handle .
      651     if p-change-value > 0
      652     then do:
      653       if frame Dialog-Frame :height + p-change-value
      654           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      655       then do:
      656         assign
      657           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      658                           - (frame Dialog-Frame :height-chars)
      659         .
      660         if p-change-value <= 0
      661         then do:
      662           run diasize_position-resize-button in this-procedure .
      663           return .
      664         end.
      665       end.
      666     end.
      667     if p-change-value < 0
      668     then do:
      669       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      670       then do:
      671         assign
      672           p-change-value = v-diasize-orig-frame-height
      673                          - (frame Dialog-Frame :height-chars)
      674         .
      675         if p-change-value >= 0
      676         then do:
      677           run diasize_position-resize-button in this-procedure .
      678           return .
      679         end.
      680       end.
      681     end.
      682     if p-change-value >= 0
      683     then do:
      684       assign
      685         v-change-sign = 1
      686       .
      687     end.
      688     else do:
      689       assign
      690         v-change-sign = -1
      691       .
      692     end.
      693     assign
      694       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      695     .
      696     if p-change-value = 0
      697     then do:
      698       run diasize_position-resize-button in this-procedure .
      699       return .
      700     end.
      701     move_block:
      702     do
      703     on error undo move_block, retry move_block
      704     :
      705       if retry
      706       then do:
      707         do
      708         on error undo move_block, leave move_block
      709         :
      710           if p-change-value > 0
      711           then do:
      712             for each buf_temp-diasize-handle
      713             on error undo, next
      714             :
      715               assign
      716                 v-object-handle = buf_temp-diasize-handle.handle-value
      717               .
      718               if v-object-handle <> v-diasize-resize-button
      719               then do:
      720                 assign
      721                   v-object-handle :row = buf_temp-diasize-handle.save-position
      722                 .
      723               end.
      724             end.
      725             assign
      726               v-diasize-browse-handle :height = v-browse-height
      727             .
      728             for each buf_temp-browse-handle
      729               where buf_temp-browse-handle.browse-type = 'height':u
      730             on error undo, next
      731             :
      732               assign
      733                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      734               .
      735             end.
      736             assign
      737               frame Dialog-Frame :height = v-frame-height
      738             .
      739             if frame Dialog-Frame :scrollable = true
      740             then do:
      741               assign
      742                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      743               .
      744             end.
      745             run diasize_position-resize-button in this-procedure .
      746           end.
      747           else do:
      748             if frame Dialog-Frame :scrollable = true
      749             then do:
      750               assign
      751                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      752               .
      753             end.
      754             assign
      755               frame Dialog-Frame :height = v-frame-height
      756             .
      757             assign
      758               v-diasize-browse-handle :height = v-browse-height
      759             .
      760             for each buf_temp-browse-handle
      761               where buf_temp-browse-handle.browse-type = 'height':u
      762             on error undo, next
      763             :
      764               assign
      765                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      766               .
      767             end.
      768             for each buf_temp-diasize-handle
      769             on error undo, next
      770             :
      771               assign
      772                 v-object-handle = buf_temp-diasize-handle.handle-value
      773               .
      774               if v-object-handle <> v-diasize-resize-button
      775               then do:
      776                 assign
      777                   v-object-handle :row = buf_temp-diasize-handle.save-position
      778                 .
      779               end.
      780             end.
      781             run diasize_position-resize-button in this-procedure .
      782           end.
      783           assign
      784             v-diasize-change-size = false
      785           .
      786           leave move_block .
      787         end.
      788       end.
      789       assign
      790         v-diasize-need-full-display = true
      791       .
      792       if v-diasize-change-size = false
      793       then do:
      794         assign
      795           v-diasize-change-size = true
      796         .
      797       end.
      798       else do:
      799         return .
      800       end.
      801       assign
      802         v-frame-height = frame Dialog-Frame :height
      803         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      804         v-browse-height = v-diasize-browse-handle :height
      805       .
      806       for each buf_temp-browse-handle
      807         where buf_temp-browse-handle.browse-type = 'height':u
      808       :
      809         assign
      810           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      811         .
      812       end.
      813       for each buf_temp-diasize-handle
      814       :
      815         delete buf_temp-diasize-handle .
      816       end.
      817       assign
      818         v-field-group-handle = frame Dialog-Frame :first-child
      819       .
      820       do while valid-handle(v-field-group-handle)
      821       :
      822         assign
      823           v-object-handle = v-field-group-handle :first-child
      824         .
      825         do while valid-handle(v-object-handle)
      826         :
      827           if  v-object-handle <> v-diasize-browse-handle :handle
      828           and can-query(v-object-handle, "row")
      829           and can-query(v-object-handle, "height")
      830           and ( v-object-handle :row > v-diasize-browse-handle :row )
      831           then do:
      832             find first buf_temp-browse-handle
      833               where buf_temp-browse-handle.browse-type   = 'height':u
      834                 and buf_temp-browse-handle.browse-handle = v-object-handle
      835               no-error .
      836             if available buf_temp-browse-handle
      837             then do:
      838             end.
      839             else do:
      840               create buf_temp-diasize-handle .
      841               assign
      842                 buf_temp-diasize-handle.handle-value  = v-object-handle
      843                 buf_temp-diasize-handle.save-position = v-object-handle :row
      844               .
      845             end.
      846           end.
      847           assign
      848             v-object-handle = v-object-handle :next-sibling
      849           .
      850         end.
      851         assign
      852           v-field-group-handle = v-field-group-handle :next-sibling
      853         .
      854       end.
      855       do with frame Dialog-Frame
      856       :
      857         hide v-diasize-resize-button .
      858         assign
      859           v-diasize-resize-button :row    = 1
      860           v-diasize-resize-button :column = 1
      861         .
      862       end.
      863       if p-change-value > 0
      864       then do:
      865         if frame Dialog-Frame :scrollable = true
      866         then do:
      867           assign
      868             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      869             no-error .
      870           if error-status :error
      871           or error-status :get-message(1) <> ""
      872           then do:
      873             undo move_block, retry move_block .
      874           end.
      875         end.
      876         assign
      877           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      878           no-error .
      879         if error-status :error
      880         or error-status :get-message(1) <> ""
      881         then do:
      882           undo move_block, retry move_block .
      883         end.
      884         assign
      885           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      886           no-error .
      887         if error-status :error
      888         or error-status :get-message(1) <> ""
      889         then do:
      890           undo move_block, retry move_block .
      891         end.
      892         for each buf_temp-browse-handle
      893           where buf_temp-browse-handle.browse-type = 'height':u
      894         on error undo move_block, retry move_block
      895         :
      896           assign
      897             buf_temp-browse-handle.browse-handle :height
      898               = buf_temp-browse-handle.browse-handle :height + p-change-value
      899             no-error .
      900           if error-status :error
      901           or error-status :get-message(1) <> ""
      902           then do:
      903             undo move_block, retry move_block .
      904           end.
      905         end.
      906         for each buf_temp-diasize-handle
      907         on error undo move_block, retry move_block
      908         :
      909           assign
      910             v-object-handle = buf_temp-diasize-handle.handle-value
      911           .
      912           if v-object-handle <> v-diasize-resize-button
      913           then do:
      914             assign
      915               v-object-handle :row = v-object-handle :row + p-change-value
      916               no-error .
      917             if error-status :error
      918             or error-status :get-message(1) <> ""
      919             then do:
      920               undo move_block, retry move_block .
      921             end.
      922           end.
      923         end.
      924       end.
      925       else do:
      926         for each buf_temp-diasize-handle
      927         on error undo move_block, retry move_block
      928         :
      929           assign
      930             v-object-handle = buf_temp-diasize-handle.handle-value
      931           .
      932           if v-object-handle <> v-diasize-resize-button
      933           then do:
      934             assign
      935               v-object-handle :row = v-object-handle :row + p-change-value
      936               no-error .
      937             if error-status :error
      938             or error-status :get-message(1) <> ""
      939             then do:
      940               undo move_block, retry move_block .
      941             end.
      942           end.
      943         end.
      944         assign
      945           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      946           no-error .
      947         if error-status :error
      948         or error-status :get-message(1) <> ""
      949         then do:
      950           undo move_block, retry move_block .
      951         end.
      952         for each buf_temp-browse-handle
      953           where buf_temp-browse-handle.browse-type = 'height':u
      954         on error undo move_block, retry move_block
      955         :
      956           assign
      957             buf_temp-browse-handle.browse-handle :height
      958               = buf_temp-browse-handle.browse-handle :height + p-change-value
      959             no-error .
      960           if error-status :error
      961           or error-status :get-message(1) <> ""
      962           then do:
      963             undo move_block, retry move_block .
      964           end.
      965         end.
      966         assign
      967           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      968           no-error .
      969         if error-status :error
      970         or error-status :get-message(1) <> ""
      971         then do:
      972           undo move_block, retry move_block .
      973         end.
      974         if frame Dialog-Frame :scrollable = true
      975         then do:
      976           assign
      977             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      978             no-error .
      979           if error-status :error
      980           or error-status :get-message(1) <> ""
      981           then do:
      982             undo move_block, retry move_block .
      983           end.
      984         end.
      985       end.
      986       if p-move-resize = true
      987       then do:
      988         run diasize_position-resize-button in this-procedure .
      989       end.
      990       if v-diasize-wndstore = true
      991       then do:
      992         if connected("ub") = true
      993         then do:
      994           define variable v-cntxt-db-num        as integer   no-undo .
      995           define variable v-cntxt-userid        as character no-undo .
      996           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      997                                             , OUTPUT v-cntxt-userid
      998                                             ) .
      999           run gbl/wndsizew.p
     1000             (input  v-cntxt-db-num
     1001             ,input  v-cntxt-userid
     1002             ,input  v-diasize-proc-name
     1003             ,input  'height':u
     1004             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1005             ) .
     1006         end.
     1007       end.
     1008     end.
     1009     assign
     1010       v-diasize-change-size = false
     1011     .
     1012   end procedure.
     1013   procedure diasize_set-height :
     1014     define input  parameter p-new-height  as decimal   no-undo .
     1015     define input  parameter p-move-resize as logical   no-undo .
     1016     do
     1017     on error undo, return error return-value
     1018     :
     1019       run diasize_change-height in this-procedure
     1020         (input  (p-new-height - frame Dialog-Frame :height)
     1021         ,input  p-move-resize
     1022         ) .
     1023     end.
     1024   end procedure.
     1025   procedure diasize_change-width :
     1026     define input  parameter p-change-value as decimal   no-undo .
     1027     define input  parameter p-move-resize  as logical   no-undo .
     1028     define variable v-field-group-handle   as handle    no-undo .
     1029     define variable v-object-handle        as handle    no-undo .
     1030     define variable v-frame-width          as decimal   no-undo .
     1031     define variable v-frame-virtual-width  as decimal   no-undo .
     1032     define variable v-browse-width         as decimal   no-undo .
     1033     define variable v-window-width         as decimal   no-undo .
     1034     define variable v-window-virtual-width as decimal   no-undo .
     1035     define variable v-change-sign          as integer   no-undo .
     1036     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1037     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1038     if p-change-value > 0
     1039     then do:
     1040       if frame Dialog-Frame :width + p-change-value >
     1041           session :width-chars
     1042       then do:
     1043         assign
     1044           p-change-value = session :width-chars - frame Dialog-Frame :width
     1045         .
     1046         if p-change-value <= 0
     1047         then do:
     1048           run diasize_position-resize-button in this-procedure .
     1049           return .
     1050         end.
     1051       end.
     1052     end.
     1053     if p-change-value < 0
     1054     then do:
     1055       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1056       then do:
     1057         assign
     1058           p-change-value = v-diasize-orig-frame-width
     1059                          - frame Dialog-Frame :width
     1060         .
     1061         if p-change-value >= 0
     1062         then do:
     1063           run diasize_position-resize-button in this-procedure .
     1064           return .
     1065         end.
     1066       end.
     1067     end.
     1068     if p-change-value >= 0
     1069     then do:
     1070       assign
     1071         v-change-sign = 1
     1072       .
     1073     end.
     1074     else do:
     1075       assign
     1076         v-change-sign = -1
     1077       .
     1078     end.
     1079     assign
     1080       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1081     .
     1082     if p-change-value = 0
     1083     then do:
     1084       run diasize_position-resize-button in this-procedure .
     1085       return .
     1086     end.
     1087     move_block:
     1088     do
     1089     on error undo move_block, leave move_block
     1090     :
     1091       if retry
     1092       then do:
     1093         do
     1094         on error undo move_block, leave move_block
     1095         :
     1096           if p-change-value > 0
     1097           then do:
     1098             for each buf_temp-diasize-handle
     1099             on error undo, next
     1100             :
     1101               assign
     1102                 v-object-handle = buf_temp-diasize-handle.handle-value
     1103               .
     1104               if v-object-handle <> v-diasize-resize-button
     1105               then do:
     1106                 assign
     1107                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1108                 .
     1109               end.
     1110             end.
     1111             assign
     1112               v-diasize-browse-handle :width = v-browse-width
     1113             .
     1114             for each buf_temp-browse-handle
     1115               where buf_temp-browse-handle.browse-type = 'width':u
     1116             on error undo, next
     1117             :
     1118               assign
     1119                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1120               .
     1121             end.
     1122             assign
     1123               frame Dialog-Frame :width = v-frame-width
     1124             .
     1125             if frame Dialog-Frame :scrollable = true
     1126             then do:
     1127               assign
     1128                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1129               .
     1130             end.
     1131             run diasize_position-resize-button in this-procedure .
     1132           end.
     1133           else do:
     1134             if frame Dialog-Frame :scrollable = true
     1135             then do:
     1136               assign
     1137                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1138               .
     1139             end.
     1140             assign
     1141               frame Dialog-Frame :width = v-frame-width
     1142             .
     1143             for each buf_temp-browse-handle
     1144               where buf_temp-browse-handle.browse-type = 'width':u
     1145             on error undo, next
     1146             :
     1147               assign
     1148                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1149               .
     1150             end.
     1151             assign
     1152               v-diasize-browse-handle :width = v-browse-width
     1153             .
     1154             for each buf_temp-diasize-handle
     1155             on error undo, next
     1156             :
     1157               assign
     1158                 v-object-handle = buf_temp-diasize-handle.handle-value
     1159               .
     1160               if v-object-handle <> v-diasize-resize-button
     1161               then do:
     1162                 assign
     1163                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1164                 .
     1165               end.
     1166             end.
     1167             run diasize_position-resize-button in this-procedure .
     1168           end.
     1169           assign
     1170             v-diasize-change-size = false
     1171           .
     1172           leave move_block .
     1173         end.
     1174       end.
     1175       assign
     1176         v-diasize-need-full-display = true
     1177       .
     1178       if v-diasize-change-size = false
     1179       then do:
     1180         assign
     1181           v-diasize-change-size = true
     1182         .
     1183       end.
     1184       else do:
     1185         return .
     1186       end.
     1187       assign
     1188         v-frame-width = frame Dialog-Frame :width
     1189         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1190         v-browse-width = v-diasize-browse-handle :width
     1191       .
     1192       for each buf_temp-browse-handle
     1193         where buf_temp-browse-handle.browse-type = 'width':u
     1194       :
     1195         assign
     1196           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1197         .
     1198       end.
     1199       for each buf_temp-diasize-handle
     1200       :
     1201         delete buf_temp-diasize-handle .
     1202       end.
     1203       assign
     1204         v-field-group-handle = frame Dialog-Frame :first-child
     1205       .
     1206       do while valid-handle(v-field-group-handle)
     1207       :
     1208         assign
     1209           v-object-handle = v-field-group-handle :first-child
     1210         .
     1211         do while valid-handle(v-object-handle)
     1212         :
     1213           if  v-object-handle <> v-diasize-browse-handle :handle
     1214           and v-object-handle <> v-diasize-resize-button
     1215           and can-query(v-object-handle, "row")
     1216           and can-query(v-object-handle, "height")
     1217           and ( v-object-handle :col + v-object-handle :width
     1218                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1219               )
     1220           then do:
     1221             find first buf_temp-browse-handle
     1222               where buf_temp-browse-handle.browse-type   = 'width':u
     1223                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1224               no-error .
     1225             if available buf_temp-browse-handle
     1226             then do:
     1227             end.
     1228             else do:
     1229               create buf_temp-diasize-handle .
     1230               assign
     1231                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1232                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1233               .
     1234             end.
     1235           end.
     1236           assign
     1237             v-object-handle = v-object-handle :next-sibling
     1238           .
     1239         end.
     1240         assign
     1241           v-field-group-handle = v-field-group-handle :next-sibling
     1242         .
     1243       end.
     1244       do with frame Dialog-Frame
     1245       :
     1246         hide v-diasize-resize-button .
     1247         v-diasize-resize-button :row = 1.
     1248         v-diasize-resize-button :column = 1.
     1249       end.
     1250       if p-change-value > 0
     1251       then do:
     1252         if frame Dialog-Frame :scrollable = true
     1253         then do:
     1254           assign
     1255             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1256             no-error .
     1257           if error-status :error
     1258           or error-status :get-message(1) <> ""
     1259           then do:
     1260             undo move_block, retry move_block.
     1261           end.
     1262         end.
     1263         assign
     1264           frame Dialog-Frame :width = v-frame-width + p-change-value
     1265           no-error .
     1266         if error-status :error
     1267         or error-status :get-message(1) <> ""
     1268         then do:
     1269           undo move_block, retry move_block.
     1270         end.
     1271         assign
     1272           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1273         no-error .
     1274         if error-status :error
     1275         or error-status :get-message(1) <> ""
     1276         then do:
     1277           undo move_block, retry move_block.
     1278         end.
     1279         for each buf_temp-browse-handle
     1280           where buf_temp-browse-handle.browse-type = 'width':u
     1281         on error undo move_block, retry move_block
     1282         :
     1283           assign
     1284             buf_temp-browse-handle.browse-handle :width
     1285               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1286             no-error .
     1287           if error-status :error
     1288           or error-status :get-message(1) <> ""
     1289           then do:
     1290             undo move_block, retry move_block .
     1291           end.
     1292         end.
     1293         for each buf_temp-diasize-handle
     1294         on error undo move_block, retry move_block
     1295         :
     1296           assign
     1297             v-object-handle = buf_temp-diasize-handle.handle-value
     1298           .
     1299           if v-object-handle <> v-diasize-resize-button
     1300           then do:
     1301             assign
     1302               v-object-handle :col = v-object-handle :col + p-change-value
     1303               no-error .
     1304             if error-status :error
     1305             or error-status :get-message(1) <> ""
     1306             then do:
     1307               undo move_block, retry move_block .
     1308             end.
     1309           end.
     1310         end.
     1311       end.
     1312       else do:
     1313         for each buf_temp-diasize-handle
     1314         on error undo move_block, retry move_block
     1315         :
     1316           assign
     1317             v-object-handle = buf_temp-diasize-handle.handle-value
     1318           .
     1319           if v-object-handle <> v-diasize-resize-button
     1320           then do:
     1321             assign
     1322               v-object-handle :col = v-object-handle :col + p-change-value
     1323               no-error .
     1324             if error-status :error
     1325             or error-status :get-message(1) <> ""
     1326             then do:
     1327               undo move_block, retry move_block .
     1328             end.
     1329           end.
     1330         end.
     1331         for each buf_temp-browse-handle
     1332           where buf_temp-browse-handle.browse-type = 'width':u
     1333         on error undo move_block, retry move_block
     1334         :
     1335           assign
     1336             buf_temp-browse-handle.browse-handle :width
     1337               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1338             no-error .
     1339           if error-status :error
     1340           or error-status :get-message(1) <> ""
     1341           then do:
     1342             undo move_block, retry move_block .
     1343           end.
     1344         end.
     1345         assign
     1346           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1347           no-error .
     1348         if error-status :error
     1349         or error-status :get-message(1) <> ""
     1350         then do:
     1351           undo move_block, retry move_block.
     1352         end.
     1353         assign
     1354           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1355         no-error .
     1356         if error-status :error
     1357         or error-status :get-message(1) <> ""
     1358         then do:
     1359           undo move_block, retry move_block.
     1360         end.
     1361         if frame Dialog-Frame :scrollable = true
     1362         then do:
     1363           assign
     1364             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1365           no-error .
     1366           if error-status :error
     1367           or error-status :get-message(1) <> ""
     1368           then do:
     1369             undo move_block, retry move_block.
     1370           end.
     1371         end.
     1372       end.
     1373       if p-move-resize
     1374       then do:
     1375         run diasize_position-resize-button in this-procedure .
     1376       end.
     1377       if v-diasize-wndstore = true
     1378       then do:
     1379         if connected("ub") = true
     1380         then do:
     1381           define variable v-cntxt-db-num        as integer   no-undo .
     1382           define variable v-cntxt-userid        as character no-undo .
     1383           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1384                                             , OUTPUT v-cntxt-userid
     1385                                             ) .
     1386           run gbl/wndsizew.p
     1387             (input  v-cntxt-db-num
     1388             ,input  v-cntxt-userid
     1389             ,input  v-diasize-proc-name
     1390             ,input  'width':u
     1391             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1392             ) .
     1393         end.
     1394       end.
     1395     end.
     1396     assign
     1397       v-diasize-change-size = false
     1398     .
     1399   end procedure.
     1400   procedure diasize_set-width :
     1401     define input  parameter p-new-width  as decimal   no-undo .
     1402     define input  parameter p-move-resize as logical   no-undo .
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       run diasize_change-width in this-procedure
     1407         (input  (p-new-width - frame Dialog-Frame :width)
     1408         ,input  p-move-resize
     1409         ) .
     1410     end.
     1411   end procedure.
     1412   procedure diasize_position-resize-button :
     1413     do with frame Dialog-Frame
     1414     :
     1415       hide v-diasize-resize-button .
     1416       assign
     1417         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1418                     - 1
     1419                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1420         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1421                     - 1
     1422                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1423       .
     1424       view v-diasize-resize-button .
     1425     end.
     1426   end procedure.
     1427   on alt-right anywhere
     1428   do:
     1429     run diasize_change-width in this-procedure
     1430       (input 1
     1431       ,input true
     1432       ) .
     1433     return no-apply .
     1434   end.
     1435   on alt-left anywhere
     1436   do:
     1437     run diasize_change-width in this-procedure
     1438       (input -1
     1439       ,input true
     1440       ) .
     1441     return no-apply .
     1442   end.
     1443   on alt-down anywhere
     1444   do:
     1445     run diasize_change-height in this-procedure
     1446       (input 1
     1447       ,input true
     1448       ) .
     1449     return no-apply .
     1450   end.
     1451   on alt-up anywhere
     1452   do:
     1453     run diasize_change-height in this-procedure
     1454       (input -1
     1455       ,input true
     1456       ) .
     1457     return no-apply .
     1458   end.
     1459   on alt-enter of frame Dialog-Frame
     1460   do:
     1461     run diasize_maximize in this-procedure
     1462       (input  ?
     1463       ).
     1464     return no-apply .
     1465   end.
     1466   procedure diasize_end-move :
     1467     do
     1468     on error undo, return error return-value
     1469     :
     1470       define variable v-row-delta as decimal   no-undo .
     1471       define variable v-col-delta as decimal   no-undo .
     1472       define variable v-new-row as decimal   no-undo .
     1473       define variable v-new-col as decimal   no-undo .
     1474       assign
     1475         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1476         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1477       .
     1478       assign
     1479         v-row-delta = v-new-row - frame Dialog-Frame :height
     1480         v-col-delta = v-new-col - frame Dialog-Frame :width
     1481       .
     1482       run diasize_change-height in this-procedure
     1483         (input v-row-delta
     1484         ,input true
     1485         ) .
     1486       run diasize_change-width in this-procedure
     1487         (input v-col-delta
     1488         ,input true
     1489         ) .
     1490     end.
     1491   end procedure.
     1492   procedure diasize_maximize :
     1493     define input  parameter p-action as logical   no-undo .
     1494     do
     1495     on error undo, return error return-value
     1496     :
     1497       if p-action = ?
     1498       then do:
     1499         if v-diasize-need-maximize = true
     1500         then do:
     1501           assign
     1502             p-action = true
     1503           .
     1504         end.
     1505         else do:
     1506           assign
     1507             p-action = false
     1508           .
     1509         end.
     1510       end.
     1511       if p-action = true
     1512       then do:
     1513         run diasize_change-height in this-procedure
     1514           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1515               - frame Dialog-Frame :height-chars
     1516           ,input true
     1517           ) .
     1518         run diasize_change-width in this-procedure
     1519           (input session :width-chars
     1520               - frame Dialog-Frame :width-chars
     1521           ,input true
     1522           ) .
     1523         assign
     1524           v-diasize-need-maximize = false
     1525         .
     1526       end.
     1527       else do:
     1528         run diasize_change-width in this-procedure
     1529           (input v-diasize-orig-frame-width
     1530               - frame Dialog-Frame :width-chars
     1531           ,input true
     1532           ) .
     1533         run diasize_change-height in this-procedure
     1534           (input v-diasize-orig-frame-height
     1535               - frame Dialog-Frame :height-chars
     1536           ,input true
     1537           ) .
     1538         assign
     1539           v-diasize-need-maximize = true
     1540         .
     1541       end.
     1542     end.
     1543   end procedure.
     1544   procedure diasize_restore-orig-size :
     1545     do
     1546     on error undo, return error return-value
     1547     :
     1548       assign
     1549         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1550         v-diasize-current-frame-height = frame Dialog-Frame :height
     1551       .
     1552       run diasize_set-height in this-procedure
     1553         (input  v-diasize-orig-frame-height
     1554         ,input  true
     1555         ) .
     1556       run diasize_set-width in this-procedure
     1557         (input  v-diasize-orig-frame-width
     1558         ,input  true
     1559         ) .
     1560     end.
     1561   end procedure.
     1562   procedure diasize_restore-current-size :
     1563     do
     1564     on error undo, return error return-value
     1565     :
     1566       run diasize_set-height in this-procedure
     1567         (input  v-diasize-current-frame-height
     1568         ,input  true
     1569         ) .
     1570       run diasize_set-width in this-procedure
     1571         (input  v-diasize-current-frame-width
     1572         ,input  true
     1573         ) .
     1574     end.
     1575   end procedure.
     1576   procedure diasize_set-browse-handle :
     1577     define input  parameter p-browse-handle as handle   no-undo .
     1578     define buffer buf_temp-browse-handle for temp-browse-handle .
     1579     do
     1580     on error undo, return error return-value
     1581     :
     1582       assign
     1583         v-diasize-browse-handle = p-browse-handle
     1584       .
     1585       for each buf_temp-browse-handle
     1586       on error undo, return error return-value
     1587       :
     1588         delete buf_temp-browse-handle .
     1589       end.
     1590     end.
     1591   end procedure.
     1592   procedure diasize_add_browse :
     1593     define input  parameter p-browse-type   as character no-undo .
     1594     define input  parameter p-browse-handle as handle    no-undo .
     1595     define buffer buf_temp-browse-handle for temp-browse-handle .
     1596     do
     1597     on error undo, return error return-value
     1598     :
     1599       assign
     1600         v-diasize-browse-number = v-diasize-browse-number + 1
     1601       .
     1602       create buf_temp-browse-handle .
     1603       assign
     1604         buf_temp-browse-handle.browse-type   = p-browse-type
     1605         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1606         buf_temp-browse-handle.browse-handle = p-browse-handle
     1607       .
     1608     end.
     1609   end procedure.
     1610   procedure diasize_init :
     1611     define variable v-default-value    as logical   no-undo .
     1612     define variable v-restore-saved    as logical   no-undo .
     1613     define variable v-resize-value-str as character no-undo .
     1614     do
     1615     on error undo, return error return-value
     1616     :
     1617       do with frame Dialog-Frame
     1618       :
     1619         assign
     1620           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1621           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1622           v-diasize-browse-handle     = browse BR-attr-prop :handle
     1623         .
     1624         create button v-diasize-resize-button
     1625         assign
     1626           parent        = frame Dialog-Frame :first-child
     1627           label         = "s"
     1628           height-pixels = 16
     1629           width-pixels  = 16
     1630           visible       = true
     1631           sensitive     = true
     1632           movable       = true
     1633           triggers:
     1634             on end-move persistent run diasize_end-move in this-procedure .
     1635           end triggers.
     1636         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1637         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1638         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1639         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1640         assign
     1641           v-diasize-wndmax = false
     1642         .
     1643         if connected("ub") = true
     1644         then do:
     1645           define variable v-cntxt-db-num        as integer   no-undo .
     1646           define variable v-cntxt-userid        as character no-undo .
     1647           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1648                                             , OUTPUT v-cntxt-userid
     1649                                             ) .
     1650           run gbl/wndpar_r.p
     1651             (input  v-cntxt-db-num
     1652             ,input  v-cntxt-userid
     1653             ,input  'wndmax':U
     1654             ,output v-diasize-wndmax
     1655             ,output v-default-value
     1656             ) .
     1657         end.
     1658         assign
     1659           v-diasize-wndstore = false
     1660         .
     1661         if connected("ub") = true
     1662         then do:
     1663           run gbl/wndpar_r.p
     1664             (input  v-cntxt-db-num
     1665             ,input  v-cntxt-userid
     1666             ,input  'wndstore':U
     1667             ,output v-diasize-wndstore
     1668             ,output v-default-value
     1669             ) .
     1670         end.
     1671         assign
     1672           v-diasize-proc-name = entry(1, program-name(2), '.')
     1673         .
     1674         if v-diasize-wndstore = true
     1675         then do:
     1676           assign
     1677             v-restore-saved = false
     1678           .
     1679           if connected("ub") = true
     1680           then do:
     1681             run gbl/wndsizer.p
     1682               (input  v-cntxt-db-num
     1683               ,input  v-cntxt-userid
     1684               ,input  v-diasize-proc-name
     1685               ,input  'height':u
     1686               ,output v-resize-value-str
     1687               ) .
     1688             if v-resize-value-str <> '':U
     1689             then do:
     1690               run diasize_change-height in this-procedure
     1691                 (input  integer(v-resize-value-str)
     1692                 ,input  true
     1693                 ) .
     1694               assign
     1695                 v-restore-saved = true
     1696               .
     1697             end.
     1698           end.
     1699           if connected("ub") = true
     1700           then do:
     1701             run gbl/wndsizer.p
     1702               (input  v-cntxt-db-num
     1703               ,input  v-cntxt-userid
     1704               ,input  v-diasize-proc-name
     1705               ,input  'width':u
     1706               ,output v-resize-value-str
     1707               ) .
     1708             if v-resize-value-str <> '':U
     1709             then do:
     1710               run diasize_change-width in this-procedure
     1711                 (input  integer(v-resize-value-str)
     1712                 ,input  true
     1713                 ) .
     1714               assign
     1715                 v-restore-saved = true
     1716               .
     1717             end.
     1718           end.
     1719           if v-restore-saved <> true
     1720           then do:
     1721             if v-diasize-wndmax = true
     1722             then do:
     1723               run diasize_maximize in this-procedure
     1724                 (input  true
     1725                 ) .
     1726             end.
     1727           end.
     1728         end.
     1729         else do:
     1730           if v-diasize-wndmax = true
     1731           then do:
     1732             run diasize_maximize in this-procedure
     1733               (input  true
     1734               ) .
     1735           end.
     1736         end.
     1737       end.
     1738     end.
     1739   end procedure.
     1740   procedure diasize_need-full-display :
     1741     define output parameter p-need-full-display as logical   no-undo .
     1742     do
     1743     on error undo, return error return-value
     1744     :
     1745       assign
     1746         p-need-full-display = v-diasize-need-full-display
     1747       .
     1748       assign
     1749         v-diasize-need-full-display = false
     1750       .
     1751     end.
     1752   end procedure.
     1753   procedure get-context :
     1754      define output parameter p-db-num as integer          no-undo.
     1755      define output parameter p-user-id as character        no-undo.
     1756      define variable v-login               as character    no-undo.
     1757      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1758      define buffer buf_user-login  for ub.user-login .
     1759      do
     1760      on error undo, return error
     1761      :
     1762            FIND FIRST buf_sys-ctrl no-lock.
     1763            ASSIGN
     1764               v-login = USERID("ub")
     1765               p-db-num = buf_sys-ctrl.db-num
     1766            .
     1767            FIND FIRST buf_user-login
     1768                 WHERE buf_user-login.db-num = p-db-num
     1769                   AND buf_user-login.user-login = v-login
     1770                 no-lock
     1771                 no-error
     1772                 .
     1773            IF AVAILABLE buf_user-login
     1774            THEN DO:
     1775               assign
     1776                  p-user-id = buf_user-login.user-id
     1777               .
     1778            END.
     1779      end.
     1780   end procedure.
     1781       run diasize_init in this-procedure .
     1782   MAIN-BLOCK:
     1783   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1784      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1785     run fill-temp-attr-prop in this-procedure .
     1786     RUN Myenable.
     1787     WAIT-FOR GO OF FRAME Dialog-Frame.
     1788   END.
     1789   RUN disable_UI.
     1790   PROCEDURE disable_UI :
     1791     HIDE FRAME Dialog-Frame.
     1792   END PROCEDURE.
     1793   PROCEDURE enable_UI :
     1794     DISPLAY rs-add f-upper-prop-code f-upper-prop-label f-prop-label f-prop-code
     1795         WITH FRAME Dialog-Frame.
     1796     ENABLE B-exit b-quit rs-add B-Help f-prop-label f-prop-code BR-attr-prop
     1797         WITH FRAME Dialog-Frame.
     1798     VIEW FRAME Dialog-Frame.
     1799     OPEN QUERY BR-attr-prop FOR EACH temp-attr-prop NO-LOCK WHERE temp-attr-prop.table-name = p-table-name BY temp-attr-prop.upper-prop-code BY temp-attr-prop.prop-code INDEXED-REPOSITION.
     1800   END PROCEDURE.
     1801   PROCEDURE fill-temp-attr-prop :
     1802   define variable v-path                    as character                no-undo .
     1803   DEFINE VARIABLE v-full-path               as character                no-undo .
     1804   DEFINE VARIABLE v-file-name               as character                no-undo .
     1805   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1806   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1807   DEFINE VARIABLE v-start                   AS LOGICAL no-UNDO.
     1808   DEFINE VARIABLE v-node-code AS integer NO-UNDO.
     1809   DEFINE BUFFER UPPER_attr-prop FOR temp-attr-prop.
     1810   run gbl/filename.p (
     1811                   input 'cmp/attrprop.new'
     1812                 ,output v-full-path
     1813                 ,output v-path
     1814                 ,output v-file-name
     1815                 ,output v-file-name-no-ext
     1816                 ,output v-file-name-ext
     1817                 ) no-error .
     1818   if error-status:error then do:
     1819     run gbl/filename.p (
     1820                     input 'cmp/attrprop.txt'
     1821                   ,output v-full-path
     1822                   ,output v-path
     1823                   ,output v-file-name
     1824                   ,output v-file-name-no-ext
     1825                   ,output v-file-name-ext
     1826                   ) no-error .
     1827     if error-status:error then do:
     1828       message
     1829       return-value
     1830       view-as alert-box ERROR.
     1831       return.
     1832     end.
     1833   end.
     1834   INPUT STREAM instream FROM value(v-full-path).
     1835   REPEAT:
     1836     CREATE temp-attr-prop.
     1837     IMPORT STREAM instream temp-attr-prop no-error.
     1838   END.
     1839   INPUT STREAM instream CLOSE.
     1840   FOR EACH temp-attr-prop:
     1841     if temp-attr-prop.node-code = 0
     1842     then do:
     1843       DELETE temp-attr-prop.
     1844     end.
     1845   END.
     1846   _temp-attr-prop:
     1847   FOR EACH temp-attr-prop:
     1848     FIND FIRST UPPER_attr-prop NO-LOCK WHERE
     1849               UPPER_attr-prop.table-name = p-table-name
     1850           AND UPPER_attr-prop.upper-node-code = temp-attr-prop.upper-node-code
     1851           AND UPPER_attr-prop.node-code = temp-attr-prop.node-code
     1852           AND UPPER_attr-prop.templ-rl-root = temp-attr-prop.templ-rl-root.
     1853     v-start = yes.
     1854     DO WHILE v-start OR temp-attr-prop.upper-node-code <> 0:
     1855       v-start = NO.
     1856       IF AVAILABLE UPPER_attr-prop THEN DO:
     1857         ASSIGN
     1858         temp-attr-prop.full-prop-name = UPPER_attr-prop.prop-code +
     1859                                             chr(47) +
     1860                                         temp-attr-prop.full-prop-name.
     1861       END.
     1862       v-node-code = UPPER_attr-prop.upper-node-code.
     1863       FIND FIRST UPPER_attr-prop NO-LOCK WHERE
     1864                  UPPER_attr-prop.table-name = p-table-name
     1865               and UPPER_attr-prop.node-code = v-node-code
     1866               and UPPER_attr-prop.templ-rl-root = temp-attr-prop.templ-rl-root
     1867                  NO-ERROR.
     1868      IF NOT AVAILABLE UPPER_attr-prop THEN NEXT _temp-attr-prop.
     1869      temp-attr-prop.upper-prop-label = upper_attr-prop.prop-label.
     1870     END.
     1871   END.
     1872   FOR EACH temp-attr-prop NO-LOCK WHERE
     1873           temp-attr-prop.node-code = 0 :
     1874     DELETE temp-attr-prop.
     1875   END.
     1876   CREATE temp-attr-prop.
     1877   ASSIGN
     1878   temp-attr-prop.table-name = p-table-name
     1879   temp-attr-prop.prop-code = '':U
     1880   temp-attr-prop.node-code = 0
     1881   temp-attr-prop.prop-label = '':U
     1882   temp-attr-prop.upper-prop-code = '':U
     1883   temp-attr-prop.upper-node-code = 0
     1884   temp-attr-prop.upper-prop-label = '':U
     1885   temp-attr-prop.templ-rl-root = 0
     1886   .
     1887   RELEASE temp-attr-prop.
     1888   END PROCEDURE.
     1889   PROCEDURE MyEnable :
     1890   ASSIGN
     1891   temp-attr-prop.upper-prop-code:RESIZABLE IN BROWSE br-attr-prop = YES
     1892   temp-attr-prop.upper-prop-label:RESIZABLE IN BROWSE br-attr-prop = YES
     1893   temp-attr-prop.prop-code:RESIZABLE IN BROWSE br-attr-prop = YES
     1894   temp-attr-prop.prop-label:RESIZABLE IN BROWSE br-attr-prop = YES
     1895   .
     1896   DISPLAY
     1897   f-upper-prop-code
     1898   f-upper-prop-label
     1899   f-prop-label
     1900   f-prop-code
     1901   rs-add
     1902   WITH FRAME Dialog-Frame.
     1903   ENABLE
     1904   rs-add
     1905   B-exit
     1906   b-quit
     1907   B-Help
     1908   f-upper-prop-code
     1909   f-upper-prop-label
     1910   f-prop-label
     1911   f-prop-code
     1912   br-attr-prop
     1913   WITH FRAME Dialog-Frame.
     1914   VIEW FRAME Dialog-Frame.
     1915   Open query br-attr-prop for each temp-attr-prop.
     1916   APPLY "ENTRY" to br-attr-prop.
     1917   APPLY "VALUE-CHANGED" to br-attr-prop.
     1918   END PROCEDURE.
     1919   PROCEDURE proc-save :
     1920   define variable v-node-code as integer no-undo .
     1921   define variable v-upper-node-code as integer no-undo .
     1922   DEFINE BUFFER buf_temp-attr-prop FOR temp-attr-prop.
     1923   ASSIGN
     1924   FRAME Dialog-Frame
     1925   f-prop-code
     1926   f-prop-label
     1927   f-upper-prop-code
     1928   f-upper-prop-label
     1929   .
     1930   IF rs-add = "add" THEN DO:
     1931     FIND FIRST buf_temp-attr-prop WHERE
     1932               buf_temp-attr-prop.table-name = p-table-name
     1933           and buf_temp-attr-prop.prop-code = f-prop-code
     1934           AND buf_temp-attr-prop.upper-node-code = temp-attr-prop.node-code NO-ERROR.
     1935     IF AVAILABLE buf_temp-attr-prop THEN DO:
     1936       MESSAGE
     1937       "Уже есть такое свойство в такой секции"
     1938       VIEW-AS ALERT-BOX ERROR.
     1939       UNDO, RETURN ERROR.
     1940     END.
     1941   END.
     1942   IF rs-add = "add" THEN DO:
     1943     find last buf_temp-attr-prop where
     1944             buf_temp-attr-prop.table-name = p-table-name
     1945          and buf_temp-attr-prop.templ-rl-root = 0 no-error .
     1946     v-node-code = (if available buf_temp-attr-prop
     1947                   then buf_temp-attr-prop.node-code + 1
     1948                   else 1).
     1949     v-upper-node-code = (if available temp-attr-prop
     1950                         then temp-attr-prop.node-code
     1951                         else 0).
     1952      CREATE buf_temp-attr-prop.
     1953      ASSIGN
     1954      buf_temp-attr-prop.table-name = p-table-name
     1955      buf_temp-attr-prop.prop-code = f-prop-code
     1956      buf_temp-attr-prop.node-code =  v-node-code
     1957      buf_temp-attr-prop.prop-label = f-prop-label
     1958      buf_temp-attr-prop.upper-prop-code = f-upper-prop-code
     1959      buf_temp-attr-prop.upper-prop-label = f-upper-prop-label
     1960      buf_temp-attr-prop.upper-node-code =  v-upper-node-code
     1961      buf_temp-attr-prop.full-prop-name = temp-attr-prop.full-prop-name + f-prop-code + chr(47)
     1962      .
     1963   END.
     1964   else do:
     1965     assign
     1966     v-node-code = temp-attr-prop.node-code
     1967     v-upper-node-code = temp-attr-prop.upper-node-code
     1968     .
     1969   end.
     1970   ASSIGN
     1971   p-prop-code = f-prop-code
     1972   p-node-code = v-node-code
     1973   p-upper-node-code = v-upper-node-code
     1974   p-prop-label = f-prop-label
     1975   p-upper-prop-code = f-upper-prop-code
     1976   p-upper-prop-label = f-upper-prop-label
     1977   p-upper-full-prop-name = (if rs-add = "add"
     1978                             then buf_temp-attr-prop.full-prop-name
     1979                             else temp-attr-prop.full-prop-name)
     1980   .
     1981   if rs-add = "add" then do:
     1982     OUTPUT STREAM instream TO value("cmp/attrprop.NEW").
     1983     FOR EACH buf_temp-attr-prop:
     1984       if buf_temp-attr-prop.node-code > 0 then
     1985       EXPORT STREAM instream buf_temp-attr-prop EXCEPT buf_temp-attr-prop.full-prop-name.
     1986     END.
     1987     OUTPUT stream instream CLOSE.
     1988   end.
     1989   END PROCEDURE.
