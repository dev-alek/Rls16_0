        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: addpr1.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/addpr1.p $":U .
        7   define variable vss-description as character no-undo init "Пересчет документов по продажным ценам по партиям".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable p-gds-code as character no-undo .
       78   define variable p-doc-code as character no-undo .
       79   define variable v-vat-pc as decimal   no-undo .
       80     run gbl/d-prompt.w
       81       ( 'title=Введите Основной код товара\'
       82       + 'format=>>>>>>>>>>9\'
       83       + 'type=integer\'
       84       ,input-output p-gds-code
       85       ).
       86     if return-value = 'false':u
       87     then do:
       88       return .
       89     end.
       90     run gbl/d-prompt.w
       91       ( 'title=Введите Номер переоценки обрезания\'
       92       + 'format=x(20)\'
       93       + 'type=char\'
       94       ,input-output p-doc-code
       95       ).
       96     if return-value = 'false':u
       97     then do:
       98       return .
       99     end.
      100   find first ub.goods no-lock where
      101              ub.goods.gds-code = integer(p-gds-code) no-error .
      102   if error-status :error then do:
      103     message 'Не верно ввведен код, товар не найден' view-as alert-box information .
      104     return .
      105   end.
      106   find first ub.price-doc no-lock where
      107              ub.price-doc.doc-num = p-doc-code no-error .
      108   if error-status :error then do:
      109     message 'Не верно ввведен номер переоценки' view-as alert-box information .
      110     return .
      111   end.
      112   find first  ub.gds-obj no-lock where
      113               ub.gds-obj.gds-code = ub.goods.gds-code  and
      114               ub.gds-obj.obj-code =  ub.price-doc.obj-code  and
      115               ub.gds-obj.obj-type =  ub.price-doc.obj-type  no-error .
      116   if not available ub.gds-obj then do:
      117     message 'Нет товара на объекте' view-as alert-box information .
      118     return .
      119   end.
      120   find first ub.price-list no-lock where
      121              ub.price-list.doc-num = ub.price-doc.doc-num and
      122              ub.price-list.price-type = ""   and
      123              ub.price-list.b-code  = ub.goods.gds-code    no-error .
      124   if not available ub.price-list then do:
      125   v-vat-pc = 0 .
      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      128     (input  ub.goods.gds-code
      129     ,input  '1':U
      130     ,input  ?
      131     ,input  ub.price-doc.host-code
      132     ,input  ub.price-doc.obj-type
      133     ,input  ub.price-doc.obj-code
      134     ,output v-vat-pc
      135     ) no-error .
      136       create  ub.price-list.
      137       assign
      138         ub.price-list.doc-num = ub.price-doc.doc-num
      139         ub.price-list.price-type = ""
      140         ub.price-list.artic = ub.goods.artic
      141         ub.price-list.b-code  = ub.goods.gds-code
      142         ub.price-list.doc-qnty = 0
      143         ub.price-list.fact-order = ub.price-doc.fact-order
      144         ub.price-list.line-num   = 1
      145         ub.price-list.main-price = yes
      146         ub.price-list.obj-code   = ub.price-doc.obj-code
      147         ub.price-list.obj-type   = ub.price-doc.obj-type
      148         ub.price-list.price-sale = ub.gds-obj.price-sale
      149         ub.price-list.prod-code   = ub.goods.prod-code
      150         ub.price-list.prod-type   = ub.goods.prod-type
      151         ub.price-list.SLT-pc      = 0
      152         ub.price-list.VAT-pc      = v-vat-pc
      153       .
      154   end.
      155     message "Все" view-as alert-box information .
