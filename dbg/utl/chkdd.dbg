     2879   ':U .
     2880   procedure nws-tabs_get-variable-names :
     2881   define output parameter p-variable-names as character no-undo .
     2882     do
     2883     on error undo, return error
     2884     :
     2885      assign
     2886        p-variable-names = '~
     2887   attach-list~
     2888   ,news-list~
     2889   ,oth-list1~
     2890   ,oth-list2~
     2891   ':U
     2892   .
     2893     end.
     2894   end procedure.
     2895   procedure nws-tabs_get-variable-value :
     2896   define input parameter p-variable-name as character no-undo .
     2897   define output parameter p-variable-value as character no-undo .
     2898     do
     2899     on error undo, return error
     2900     :
     2901       case p-variable-name:
     2902         when 'attach-list':U then do:
     2903           assign
     2904           p-variable-value = attach-list.
     2905         end.
     2906         when 'news-list':U then do:
     2907           assign
     2908           p-variable-value = news-list.
     2909         end.
     2910         when 'oth-list1':U then do:
     2911           assign
     2912           p-variable-value = oth-list1.
     2913         end.
     2914         when 'oth-list2':U then do:
     2915           assign
     2916           p-variable-value = oth-list2.
     2917         end.
     2918       end case.
     2919     end.
     2920   end procedure.
     2921   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2922   procedure valid-ren-art-tbl-list :
     2923     do
     2924     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2925     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2926     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2927     :
     2928       define variable v-std-list        as character no-undo .
     2929       define variable v-ignore-list     as character no-undo .
     2930       define variable v-special-list    as character no-undo .
     2931       assign
     2932         v-std-list     = "cli-gds,cli-gds-attr,cli-art,cli-art-attr,contract-specif,c-contract-specif,doc-line,c-doc-line,fbr-line,c-fbr-line,fbr-recipe,fbr-recipe-gds,fbr-pln-line,c-fbr-pln-line,gds-dtl,c-gds-dtl,gds-dtl-attr,c-gds-dtl-attr,gds-obj,inv-line,inv-line-attr,c-inv-line,ot-supp-line,ot-supp-line-attr,ot-line-attr,ord-line,c-ord-line,ord-line-rcv,ord-dtl,c-ord-dtl,ord-dtl-attr,ord-dtl-rcv,ord-dtl-cons,ord-gds-cons,prt-obj,prt-obj-attr,parts,c-parts,parts-supp,parts-supp-attr,price-list,c-price-list,price-doc-forming-gds,c-price-doc-forming-gds,price-doc-forming-gds-qnty,c-price-doc-forming-gds-qnty,price-doc-forming-gds-sum,c-price-doc-forming-gds-sum,price-doc-forming-gds-tnv,c-price-doc-forming-gds-tnv,recipe,recipe-gds,c-recipe,c-recipe-gds,c-recipe-hist,stk-supp-line,stk-supp-line-attr,stk-line-attr,tmp-sale-dtl,tmp-sale-dtl-attr,tmp-sale-gds,tmp-sale-gds-attr":U
     2933         v-ignore-list  = "c-goods,c-order-line":U
     2934         v-special-list = "goods,ot-line,stk-line,order-line":U
     2935       .
     2936   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2937       define variable v-ind         as integer   no-undo .
     2938       define variable v-num-entries as integer   no-undo .
     2939       define variable v-inform      as character no-undo .
     2940       define variable bh_tbl-name   as handle    no-undo .
     2941       define variable v-tbl-not-idx as character no-undo .
