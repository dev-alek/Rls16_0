     4318     end.
     4319     run waitfram-show in this-procedure
     4320       (input substitute("Проверка на изменение первичного ключа у таблиц с uniq-key-rec и подобными полями.")
     4321       ) .
     4322     run valid-rename-pi-uniq-key-rec in this-procedure
     4323       no-error .
     4324     if error-status :error then do:
     4325       run write-log in this-procedure
     4326         (input substitute( "&1&2", chr(10), return-value )
     4327         ) .
     4328     end.
     4329     output stream IdxStream to value( v-df-file-name ) append.
     4330     assign
     4331       v-file-length = seek( IdxStream )
     4332     .
     4333     put stream IdxStream unformatted
     4334       substitute( '.') skip
     4335       substitute( 'PSC') skip
     4336       substitute( 'cpstream=&1', session :stream ) skip
     4337       substitute( '.') skip
     4338       substitute( '&1', string(v-file-length, "9999999999")) skip
     4339       .
     4340     output stream IdxStream close.
     4341   run waitfram-show in this-procedure
     4342       (input substitute("Проверка сохранности динамически используемых полей.")
     4343       ) .
     4344     if v-error-db = true
     4345       or v-error-utl = true
     4346     then do:
     4347       run gbl/open_url.p
     4348         (input search('.':u + '/':u + v-log-file-name)
     4349         ) .
     4350       undo, return error return-value .
     4351     end.
     4352   end.
     4353   procedure validate-name :
     4354     define input  parameter p-obj-name   as character no-undo .
     4355     define input  parameter p-obj-type   as character no-undo .
     4356     define input  parameter p-check-name as character no-undo .
     4357     define input  parameter p-valid-char as character no-undo .
     4358     define variable v-ind          as integer   no-undo .
     4359     define variable v-check-symbol as character no-undo .
     4360     do
     4361     on error undo, return error return-value
     4362     :
     4363       define variable v-str-length as integer   no-undo .
     4364       assign
     4365         v-str-length = length(p-check-name)
     4366       .
     4367       do v-ind = 1 to v-str-length
     4368       :
     4369         assign
     4370           v-check-symbol = substring (p-check-name, v-ind, 1)
     4371         .
     4372         if index (p-valid-char, v-check-symbol) = 0
     4373         then do:
     4374           run write-log-item in this-procedure
     4375             (input p-obj-name ,
     4376              input substitute("Неверный символ: &1 в имени &2 &3", v-check-symbol,p-obj-type,p-check-name )
     4377             ) .
     4378         end.
     4379       end.
     4380     end.
     4381   end procedure.
     4382   procedure validate-filename :
     4383     define input  parameter p-object-head as character no-undo .
     4384     define input  parameter p-object-name as character no-undo .
     4385     define input  parameter p-file-name   as character no-undo .
     4386     do
     4387     on error undo, return error return-value
     4388     :
     4389       if p-file-name = ""
     4390       or p-file-name = ?
     4391       then do:
     4392         run write-log-item in this-procedure
     4393           (input p-object-head,
     4394            input p-object-name
     4395                + substitute(" Имя файла &1 ", p-file-name)
     4396                + "Не задано имя файла"
     4397           ) .
     4398         return .
     4399       end.
     4400       if num-entries(dictdb._file-trig._proc-name, '/':u) <> 2
     4401       or entry(1, dictdb._file-trig._proc-name, '/':u) <> 'trg':u
     4402       then do:
     4403         run write-log-item in this-procedure
     4404           (input p-object-head,
     4405            input substitute("Триггер &1 ", dictdb._file-trig._proc-name)
     4406                + substitute("Имя триггера должно быть задано в виде trg/<имя_файла>.p)")
     4407           ) .
     4408         return .
     4409       end.
     4410       define variable v-search-file-name as character no-undo .
     4411       assign
     4412         v-search-file-name = search(p-file-name)
     4413       .
     4414       if v-search-file-name = ""
     4415       or v-search-file-name = ?
     4416       then do:
     4417         run write-log-item in this-procedure
     4418           (input p-object-head,
     4419            input p-object-name
     4420                + substitute(" Не найден файл &1", p-file-name)
     4421           ) .
     4422       end.
     4423       if num-entries(p-file-name, '.':u) <> 2
     4424       then do:
     4425         run write-log-item in this-procedure
     4426           (input p-object-head,
     4427            input p-object-name
     4428                + substitute(" Имя файла &1", p-file-name)
     4429                + " Имя файла должно содержать ровно одну точку"
     4430           ) .
     4431         return .
     4432       end.
     4433       define variable v-file-name-no-ext as character no-undo .
     4434       define variable v-file-name-ext    as character no-undo .
     4435       assign
     4436         v-file-name-no-ext = entry(1, entry(2, p-file-name, '/':u), '.':u)
     4437         v-file-name-ext    = entry(2, entry(2, p-file-name, '/':u), '.':u)
     4438       .
     4439       if v-file-name-ext <> "p"
     4440       then do:
     4441         run write-log-item in this-procedure
     4442           (input p-object-head,
     4443            input p-object-name
     4444                + substitute(" Имя файла &1", p-file-name)
     4445                + substitute(" Расширение файла должно равняться символу &1", "p")
     4446           ) .
     4447       end.
     4448       if length(v-file-name-no-ext) > 8
     4449       then do:
     4450         run write-log-item in this-procedure
     4451           (input p-object-head,
     4452            input p-object-name
     4453                + substitute(" Имя файла &1", p-file-name)
     4454                + substitute(" Количество символов не может быть больше 8")
     4455           ) .
     4456       end.
     4457       run validate-name in this-procedure
     4458         (input p-object-head
     4459         ,input p-object-name
     4460              + substitute(" Имя файла &1", p-file-name) + chr(10)
     4461         ,input v-file-name-no-ext
     4462         ,input vartrigger-name
     4463         ) .
     4464     end.
     4465   end procedure.
     4466   procedure validate-pi-idx :
     4467     define input parameter i-head     as character no-undo.
     4468     define input parameter p-tbl-name as character no-undo .
     4469     do
     4470     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4471     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4472     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4473     :
     4474       define variable v-inform              as character no-undo .
     4475       define variable v-ind                 as integer   no-undo .
     4476       define variable v-idx-field-qnty      as integer   no-undo .
     4477       define variable v-th                  as handle    no-undo .
     4478       define variable v-fh                  as handle    no-undo .
     4479       create buffer v-th for table p-tbl-name .
     4480       assign
     4481         v-inform = v-th:index-information(1)
     4482         v-ind    = 2
     4483       .
     4484       do while v-inform <> ?
     4485         and entry( 3, v-inform, ",":U ) <> "1":U
     4486       on error undo, return error
     4487       :
     4488         assign
     4489           v-inform = v-th:index-information( v-ind )
     4490           v-ind    = v-ind + 1
     4491         .
     4492       end.
     4493       if v-inform = ?
     4494         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4495         or entry( 3, v-inform, ",":U ) <> "1":U
     4496       then do:
     4497         run write-log-item in this-procedure
     4498           (input i-head,
     4499            input substitute("Не имеет первичного ключа в БД"
     4500                             ,v-th:name
     4501                            )
     4502           ) .
     4503         return .
     4504       end.
     4505       assign
     4506         v-idx-field-qnty = num-entries( v-inform ) - 4
     4507       .
     4508       if v-idx-field-qnty < 2 then do:
     4509         run write-log-item in this-procedure
     4510           (input i-head,
     4511            input substitute("Первичный индекс (&1) не содержит списка полей."
     4512                             ,v-inform
     4513                            )
     4514           ) .
     4515         return .
     4516       end.
     4517       if entry( 2, v-inform, ",":U ) <> "1":U
     4518       then do:
     4519         run write-log-item in this-procedure
     4520           (input i-head,
     4521            input substitute("Имеет неуникальный первичный ключ &1 в БД"
     4522                             ,entry( 1, v-inform, ",":U )
     4523                            )
     4524           ) .
     4525       end.
     4526       do v-ind = 1 to v-idx-field-qnty by 2
     4527       on error undo, return error
     4528       :
     4529         assign
     4530           v-fh = v-th:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) )
     4531         .
     4532         if v-fh:mandatory = false then do:
     4533           run write-log-item in this-procedure
     4534             (input i-head,
     4535              input substitute("Поле &1 входящее в состав первичного индекса не mandatory."
     4536                               ,v-fh:name
     4537                             )
     4538             ) .
     4539         end.
     4540       end.
     4541       delete object v-th .
     4542       assign
     4543         v-th = ?
     4544         v-fh = ?
     4545       .
     4546     end.
     4547     return.
     4548   end procedure.
     4549   define temp-table tt_field-check no-undo
     4550     field field-list as character
     4551     field idx-av     as logical
     4552     field idx-name   as character
     4553     index pi is primary unique field-list idx-name
     4554     index i-av idx-av
     4555     .
     4556   procedure validate-other-idx :
     4557     define input parameter p-df-file-name  as character no-undo .
     4558     define input parameter p-pro-file-name as character no-undo .
     4559     define input parameter p-tbl-name      as character no-undo .
     4560     do
     4561     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4562     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4563     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4564     :
     4565       define variable v-th                  as handle    no-undo .
     4566       define variable v-fh                  as handle    no-undo .
     4567       define variable v-ind-fld             as integer   no-undo .
     4568       define variable v-fld-name            as character no-undo .
     4569       define variable v-tmp-name            as character no-undo .
     4570       define variable v-inform              as character no-undo .
     4571       define variable v-ind                 as integer   no-undo .
     4572       define variable v-num-entries         as integer   no-undo .
     4573       define variable v-field-qnty          as integer   no-undo .
     4574       define variable v-idx-name-list       as character no-undo .
     4575       define variable v-first-pro           as logical   no-undo .
     4576       for each tt_field-check
     4577       :
     4578         delete tt_field-check .
     4579       end.
     4580       assign
     4581         v-first-pro = true
     4582       .
     4583       create buffer v-th for table p-tbl-name .
     4584       do v-ind-fld = 1 to v-th:num-fields
     4585       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4586       :
     4587         assign
     4588           v-fh       = v-th :buffer-field( v-ind-fld )
     4589           v-fld-name = v-fh :name
     4590         .
     4591         if v-fld-name matches "*obj-type*":U
     4592           or v-fld-name matches "*obj-code*":U
     4593         then do:
     4594           assign
     4595             v-tmp-name = replace ( v-fld-name, "obj-code":U, "obj-type":U )
     4596           .
     4597           if v-fld-name = v-tmp-name then do:
     4598             assign
     4599               v-tmp-name = replace ( v-fld-name, "obj-type":U, "obj-code":U )
     4600             .
     4601           end.
     4602           find first tt_field-check
     4603             where tt_field-check.field-list = v-tmp-name
     4604             no-error .
     4605           if not available tt_field-check then do:
     4606             create tt_field-check .
     4607             assign
     4608               tt_field-check.field-list = v-fld-name
     4609               tt_field-check.idx-av     = false
     4610               tt_field-check.idx-name   = "auto_":U + replace ( replace ( replace ( v-fld-name, "obj-code":U, "object":U ), "obj-type":U, "object":U ), "object":U, "obj":U )
     4611             .
     4612           end.
     4613           else do:
     4614             assign
     4615               tt_field-check.field-list = tt_field-check.field-list + chr(44) + v-fld-name
     4616             .
     4617             if entry( 1, tt_field-check.field-list, chr(44) ) matches "*obj-code*":U
     4618               and entry( 2, tt_field-check.field-list, chr(44) ) matches "*obj-type*":U
     4619             then do:
     4620               assign
     4621                 tt_field-check.field-list = entry( 2, tt_field-check.field-list, chr(44) ) + chr(44) + entry( 1, tt_field-check.field-list, chr(44) )
     4622               .
     4623             end.
     4624           end.
     4625         end.
     4626         if v-fld-name matches "*host-code*":U then do:
     4627           find first tt_field-check
     4628             where tt_field-check.field-list = v-fld-name
     4629             no-error .
     4630           if not available tt_field-check then do:
     4631             create tt_field-check .
     4632             assign
     4633               tt_field-check.field-list = v-fld-name
     4634               tt_field-check.idx-av     = false
     4635               tt_field-check.idx-name   = "auto_":U + replace ( v-fld-name, "host-code":U, "host":U )
     4636             .
     4637           end.
     4638         end.
     4639         if v-fld-name matches "*db-num*":U then do:
     4640           find first tt_field-check
     4641             where tt_field-check.field-list = v-fld-name
     4642             no-error .
     4643           if not available tt_field-check then do:
     4644             create tt_field-check .
     4645             assign
     4646               tt_field-check.field-list = v-fld-name
     4647               tt_field-check.idx-av     = false
     4648               tt_field-check.idx-name   = "auto_":U + replace ( v-fld-name, "db-num":U, "db":U )
     4649             .
     4650           end.
     4651         end.
     4652         if v-th:name begins "c-":U
     4653           and ( v-fld-name = "corr-user-name":U
     4654                 or v-fld-name = "corr-user-db-num":U
     4655               )
     4656         then do:
     4657           assign
     4658             v-tmp-name = replace ( v-fld-name, "corr-user-name":U, "corr-user-db-num":U )
     4659           .
     4660           if v-fld-name = v-tmp-name then do:
     4661             assign
     4662               v-tmp-name = replace ( v-fld-name, "corr-user-db-num":U, "corr-user-name":U )
     4663             .
     4664           end.
     4665           find first tt_field-check
     4666             where tt_field-check.field-list = v-tmp-name
     4667             no-error .
     4668           if not available tt_field-check then do:
     4669             create tt_field-check .
     4670             assign
     4671               tt_field-check.field-list = v-fld-name
     4672               tt_field-check.idx-av     = false
     4673               tt_field-check.idx-name   = "auto_corr-user":U
     4674             .
     4675           end.
     4676           else do:
     4677             assign
     4678               tt_field-check.field-list = tt_field-check.field-list + chr(44) + v-fld-name
     4679             .
     4680             if entry( 1, tt_field-check.field-list, chr(44) ) = "corr-user-db-num":U
     4681               and entry( 2, tt_field-check.field-list, chr(44) ) = "corr-user-name":U
     4682             then do:
     4683               assign
     4684                 tt_field-check.field-list = "corr-user-name":U + chr(44) + "corr-user-db-num":U
     4685               .
     4686             end.
     4687           end.
     4688         end.
     4689       end.
     4690       for each tt_field-check
     4691         where tt_field-check.idx-name = "auto_corr-user":U
     4692       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4693       :
     4694         if num-entries( tt_field-check.field-list ) = 1
     4695           and tt_field-check.field-list = "corr-user-db-num":U
     4696         then do:
     4697           delete tt_field-check .
     4698         end.
     4699       end.
     4700       for each tt_field-check
     4701       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4702       :
     4703         assign
     4704           v-field-qnty    = num-entries( tt_field-check.field-list )
     4705           v-inform        = v-th:index-information(1)
     4706           v-idx-name-list = entry( 1, v-inform, ",":U )
     4707           v-ind           = 2
     4708         .
     4709         block_chk-idx:
     4710         do while v-inform <> ?
     4711         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4712         :
     4713           if v-inform <> ?
     4714             and ( ( v-field-qnty = 1
     4715                     and lookup( entry( 5, v-inform, ",":U ), tt_field-check.field-list ) > 0
     4716                   )
     4717                   or
     4718                   ( v-field-qnty = 2
     4719                     and ( ( lookup( "corr-user-name":U, tt_field-check.field-list ) = 0
     4720                             and num-entries( v-inform, ",":U ) >= 7
     4721                             and lookup( entry( 5, v-inform, ",":U ), tt_field-check.field-list ) > 0
     4722                             and lookup( entry( 7, v-inform, ",":U ), tt_field-check.field-list ) > 0
     4723                           )
     4724                           or
     4725                           ( lookup( "corr-user-name":U, tt_field-check.field-list ) > 0
     4726                             and num-entries( v-inform, ",":U ) >= 7
     4727                             and entry( 5, v-inform, ",":U ) = "corr-user-name":U
     4728                             and entry( 7, v-inform, ",":U ) = "corr-user-db-num":U
     4729                           )
     4730                        )
     4731                   )
     4732                   or
     4733                   ( v-field-qnty = 3
     4734                     and num-entries( v-inform, ",":U ) >= 9
     4735                     and lookup( entry( 5, v-inform, ",":U ), tt_field-check.field-list ) > 0
     4736                     and lookup( entry( 7, v-inform, ",":U ), tt_field-check.field-list ) > 0
     4737                     and lookup( entry( 9, v-inform, ",":U ), tt_field-check.field-list ) > 0
     4738                   )
     4739                 )
     4740           then do:
     4741             assign
     4742               tt_field-check.idx-av   = true
     4743               tt_field-check.idx-name = entry( 1, v-inform, ",":U )
     4744             .
     4745             leave block_chk-idx.
     4746           end.
     4747           assign
     4748             v-inform        = v-th:index-information( v-ind )
     4749             v-idx-name-list = v-idx-name-list + chr(44) + entry( 1, v-inform, ",":U )
     4750             v-ind           = v-ind + 1
     4751           .
     4752         end.
     4753         if tt_field-check.idx-av = true
     4754           or num-entries( tt_field-check.field-list, chr(44) ) <= 0
     4755         then do:
     4756           delete tt_field-check .
     4757         end.
     4758       end.
     4759       find first tt_field-check
     4760         no-error .
     4761       if available tt_field-check then do:
     4762         run write-log in this-procedure
     4763           ( input substitute("Таблица &2 &1", chr(10) , v-th:name )
     4764           ) .
     4765         for each tt_field-check
     4766           where tt_field-check.idx-av <> true
     4767         :
     4768           run write-log in this-procedure
     4769             ( input substitute("--- не имеет ключа по полю(-ям) &2 в БД&1", chr(10) , tt_field-check.field-list )
     4770             ) .
     4771           if lookup( v-idx-name-list , tt_field-check.idx-name, chr(44) ) > 0 then do:
     4772             message
     4773               substitute( "такое имя индекса (&1) уже есть в таблице &2", tt_field-check.idx-name, v-th:name )
     4774               view-as alert-box.
     4775           end.
     4776           assign
     4777             v-num-entries = num-entries( tt_field-check.field-list, chr(44) )
     4778           .
     4779           if v-num-entries > 0 then do:
     4780             output stream IdxStream to value( p-df-file-name ) append.
     4781             put stream IdxStream unformatted
     4782               substitute( 'ADD INDEX "&1" ON "&2"', tt_field-check.idx-name, v-th:name ) skip
     4783               substitute( 'AREA "Schema Area"') skip
     4784               substitute( 'INACTIVE') skip
     4785               .
     4786             do v-ind = 1 to v-num-entries
     4787             on error undo, return error return-value
     4788             :
     4789               put stream IdxStream unformatted
     4790                 substitute( 'INDEX-FIELD "&1" ASCENDING', entry( v-ind, tt_field-check.field-list, chr(44) ) ) skip
     4791                 .
     4792             end.
     4793             put stream IdxStream unformatted
     4794               skip(1)
     4795               .
     4796             output stream IdxStream close.
     4797             output stream IdxStream to value( p-pro-file-name ) append.
     4798             if v-first-pro = true then do:
     4799               if seek( IdxStream ) > 0 then do:
     4800                 put stream IdxStream unformatted
     4801                   skip(1)
     4802                   .
     4803               end.
     4804               put stream IdxStream unformatted
     4805                 substitute( 'idxbuild|&1:&2', v-th:name, tt_field-check.idx-name )
     4806                 .
     4807               assign
     4808                 v-first-pro = false
     4809               .
     4810             end.
     4811             else do:
     4812               put stream IdxStream unformatted
     4813                 substitute( ',&1', tt_field-check.idx-name )
     4814                 .
     4815             end.
     4816             output stream IdxStream close.
     4817           end.
     4818           delete tt_field-check .
     4819         end.
     4820       end.
     4821       delete object v-th .
     4822       assign
     4823         v-th = ?
     4824         v-fh = ?
     4825       .
     4826     end.
     4827     return.
     4828   end procedure.
     4829   procedure validate-pi-idx-hist :
     4830     define input parameter p-tbl-name-hist as character no-undo .
     4831     define input parameter p-tbl-name-main as character no-undo .
     4832     do
     4833     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4834     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4835     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4836     :
     4837       define variable v-inform-hist         as character no-undo .
     4838       define variable v-inform-main         as character no-undo .
     4839       define variable v-ind                 as integer   no-undo .
     4840       define variable v-idx-field-qnty-hist as integer   no-undo .
     4841       define variable v-idx-field-qnty-main as integer   no-undo .
     4842       define variable v-th-hist             as handle    no-undo .
     4843       define variable v-fh-hist             as handle    no-undo .
     4844       define variable v-th-main             as handle    no-undo .
     4845       define variable v-fh-main             as handle    no-undo .
     4846       define variable v-valid               as logical   no-undo .
     4847       define variable v-flst-hist           as character no-undo .
     4848       define variable v-flst-main           as character no-undo .
     4849       create buffer v-th-main for table p-tbl-name-main .
     4850       create buffer v-th-hist for table p-tbl-name-hist .
     4851       assign
     4852         v-flst-hist   = "":U
     4853         v-flst-main   = "":U
     4854         v-inform-main = v-th-main:index-information(1)
     4855         v-inform-hist = v-th-hist:index-information(1)
     4856         v-ind         = 2
     4857       .
     4858       do while v-inform-main <> ?
     4859         and entry( 3, v-inform-main, ",":U ) <> "1":U
     4860       on error undo, return error
     4861       :
     4862         assign
     4863           v-inform-main = v-th-main:index-information( v-ind )
     4864           v-ind         = v-ind + 1
     4865         .
     4866       end.
     4867       assign
     4868         v-ind = 2
     4869       .
     4870       do while v-inform-hist <> ?
     4871         and entry( 3, v-inform-hist, ",":U ) <> "1":U
     4872       on error undo, return error
     4873       :
     4874         assign
     4875           v-inform-hist = v-th-hist:index-information( v-ind )
     4876           v-ind         = v-ind + 1
     4877         .
     4878       end.
     4879       if v-inform-main = ?
     4880         or LC( entry( 1, v-inform-main, ",":U ) ) = "default":U
     4881         or entry( 3, v-inform-main, ",":U ) <> "1":U
     4882         or v-inform-hist = ?
     4883         or LC( entry( 1, v-inform-hist, ",":U ) ) = "default":U
     4884         or entry( 3, v-inform-hist, ",":U ) <> "1":U
     4885       then do:
     4886         return .
     4887       end.
     4888       assign
     4889         v-idx-field-qnty-main = num-entries( v-inform-main ) - 4
     4890         v-idx-field-qnty-hist = num-entries( v-inform-hist ) - 4
     4891       .
     4892       if v-idx-field-qnty-main < 2
     4893         or v-idx-field-qnty-hist < 2
     4894       then do:
     4895         return .
     4896       end.
     4897       do v-ind = 1 to v-idx-field-qnty-hist by 2
     4898       on error undo, return error
     4899       :
     4900         assign
     4901           v-flst-hist = v-flst-hist + chr(32) + entry( 4 + v-ind, v-inform-hist, ",":U )
     4902         .
     4903         if entry( 4 + v-ind, v-inform-hist, ",":U ) <> "corr-user-db-num":U
     4904           and entry( 4 + v-ind, v-inform-hist, ",":U ) <> "chip-num":U
     4905         then do:
     4906           assign
     4907             v-flst-hist = v-flst-hist + substitute( "(&1)", (if entry( 4 + v-ind + 1, v-inform-hist, ",":U ) = "0" then "ASC" else "DESC" ) )
     4908           .
     4909         end.
     4910       end.
     4911       do v-ind = 1 to v-idx-field-qnty-main by 2
     4912       on error undo, return error
     4913       :
     4914         assign
     4915           v-flst-main = v-flst-main + chr(32) + substitute( "&1(&2)"
     4916                                                                   ,entry( 4 + v-ind, v-inform-main, ",":U )
     4917                                                                   ,(if entry( 4 + v-ind + 1, v-inform-main, ",":U ) = "0" then "ASC" else "DESC")
     4918                                                                  )
     4919         .
     4920       end.
     4921       assign
     4922         v-flst-main = v-flst-main + chr(32) + "corr-user-db-num":U + chr(32) + "chip-num":U
     4923         v-valid = true
     4924       .
     4925       if v-idx-field-qnty-main > v-idx-field-qnty-hist then do:
     4926         assign
     4927           v-valid = false
     4928         .
     4929       end.
     4930       else do:
     4931         do v-ind = 1 to v-idx-field-qnty-main by 2
     4932         on error undo, return error
     4933         :
     4934           assign
     4935             v-fh-main   = v-th-main:buffer-field( entry( 4 + v-ind, v-inform-main, ",":U ) )
     4936             v-fh-hist   = v-th-hist:buffer-field( entry( 4 + v-ind, v-inform-hist, ",":U ) )
     4937           .
     4938           if v-fh-hist:name <> v-fh-main:name
     4939             or entry( 4 + v-ind + 1, v-inform-main, ",":U ) <> entry( 4 + v-ind + 1, v-inform-hist, ",":U )
     4940           then do:
     4941             assign
     4942               v-valid = false
     4943             .
     4944           end.
     4945         end.
     4946         if v-idx-field-qnty-hist >= v-idx-field-qnty-main + 2 then do:
     4947           if v-th-hist:buffer-field( entry( 4 + v-ind, v-inform-hist, ",":U ) ):name <> "corr-user-db-num":U
     4948           then do:
     4949             assign
     4950               v-valid = false
     4951             .
     4952           end.
     4953           else do:
     4954             if v-idx-field-qnty-hist >= v-idx-field-qnty-main + 4 then do:
     4955               if v-th-hist:buffer-field( entry( 4 + v-ind + 2, v-inform-hist, ",":U ) ):name <> "chip-num":U
     4956               then do:
     4957                 assign
     4958                   v-valid = false
     4959                 .
     4960               end.
     4961             end.
     4962             else do:
     4963               assign
     4964                 v-valid = false
     4965               .
     4966             end.
     4967           end.
     4968         end.
     4969         else do:
     4970           assign
     4971             v-valid = false
     4972           .
     4973         end.
     4974         if v-idx-field-qnty-hist > v-idx-field-qnty-main + 4 then do:
     4975           assign
     4976             v-valid = false
     4977           .
     4978         end.
     4979       end.
     4980       if v-valid = false then do:
     4981         run write-log in this-procedure
     4982           (input substitute("Таблица &1, неверный первичный индекс &2.&3Существующий:&4&3Должен быть:&5&3&3"
     4983                             ,v-th-hist:name
     4984                             ,entry( 1, v-inform-hist, ",":U )
     4985                             ,chr(10)
     4986                             ,v-flst-hist
     4987                             ,v-flst-main
     4988                            )
     4989           ) .
     4990       end.
     4991       delete object v-th-hist .
     4992       delete object v-th-main .
     4993       assign
     4994         v-th-main = ?
     4995         v-fh-main = ?
     4996         v-th-hist = ?
     4997         v-fh-hist = ?
     4998       .
     4999     end.
     5000     return.
     5001   end procedure.
     5002   procedure valid-rename-pi-uniq-key-rec :
     5003   define variable v-list as character no-undo .
     5004   define variable v-uniq-key-rec-tables as character no-undo .
     5005   define variable v-uniq-key-rec-tables-2 as character no-undo .
     5006   define variable v-call_id-tables as character no-undo .
     5007   define variable v-resource_id-tables as character no-undo .
     5008   define variable v-jj as integer no-undo .
     5009   define variable v-ii as integer no-undo .
     5010   define variable v-tbl-name as character no-undo .
     5011   define variable v-holder-tbl-name as character no-undo .
     5012   define variable v-dop as character no-undo .
     5013   define variable v-dop-2 as character no-undo .
     5014   define variable v-field-name as character no-undo .
     5015   define variable v-bh as handle no-undo .
     5016   define variable v-keys as character no-undo .
     5017   assign
     5018   v-uniq-key-rec-tables =
     5019   'dis-card-type=emitent-host-code,type,host-code,obj-type,obj-code' + ";" +
     5020   'ext-classif=classif-subject,classif-name,db-num,Key#_One,Key#_Two,Key#_Three,CharKey_One,CharKey_Two,CharKey_Three,nonunique'  + ';' +
     5021   'prop-head=dtm-code' + ';' +
     5022   'prop-map=dtm-code,node-code' + ';' +
     5023   'prop-ref=dt-code' + ';' +
     5024   'prop-script=dtm-code,language,script-name,revis_id' + ';' +
     5025   'rule=rule_id' + ';' +
     5026   'rule-by-call=call#_id,codex_id,ruleset_id,order_id' + ';' +
     5027   'ruledict=entry-id' + ';'+
     5028   'layout-elem-rule=layout-id,mode-id,widget-id' + ';'+
     5029   'layout-elem-rule-attr=layout-id,mode-id,widget-id,attr-code'
     5030   v-uniq-key-rec-tables-2 =
     5031   'blob-bind=uniq-key-rec/trn-doc/doc-code' + ";" +
     5032   'clob-bind=uniq-key-rec' + ";" +
     5033   'c-user-log=uniq-key-rec/c-fbr-doc/doc-code,corr-user-db-num,chip-num' + ";" +
     5034   'c-user-log=uniq-key-rec/c-trn-doc/doc-code,corr-user-db-num,chip-num' + ";" +
     5035   'ruledict=entry-id/prop-head/dtm-code' + ";" +
     5036   'ruledict=entry-id/prop-map/dtm-code,node-code' + ";" +
     5037   'ruledict=entry-id/prop-ref/dt-code' + ";" +
     5038   'ruledict=entry-id/prop-script/dtm-code,language,script-name,revis_id' + ";" +
     5039   'ruledict=entry-id/rule/rule_id' + ";" +
     5040   'ruledict=entry-id/rule-profile/profile_id' + ";" +
     5041   'ruledict=entry-id/ruledict/entry-id'
     5042   v-call_id-tables =
     5043   'prop-ref-call=call_id/dis-card-type/emitent-host-code,type,host-code,obj-type,obj-code' + ';' +
     5044   'rp-by-call=call_id/dis-card-type/emitent-host-code,type,host-code,obj-type,obj-code' + ';' +
     5045   'rp-by-call=call_id/thbj-attr/obj-type,obj-code,upper-prop-code,prop-code' + ';' +
     5046   'rp-by-call=call_id/schedule/cre-db-num,task-type,task-num' + ';' +
     5047   'rule-by-call=call_id/dis-card-type/emitent-host-code,type,host-code,obj-type,obj-code' + ';' +
     5048   'rule-by-call=call_id/thbj-attr/obj-type,obj-code,upper-prop-code,prop-code' + ';' +
     5049   'rule-by-call=call_id/schedule/cre-db-num,task-type,task-num' + ';' +
     5050   'rule-call-param=call_id/dis-card-type/emitent-host-code,type,host-code,obj-type,obj-code' + ';' +
     5051   'rule-call-param=call_id/thbj-attr/obj-type,obj-code,upper-prop-code,prop-code' + ';' +
     5052   'rule-call-param=call_id/schedule/cre-db-num,task-type,task-num' + ';' +
     5053   'rule-trans-memo=call_id/dis-card-type/emitent-host-code,type,host-code,obj-type,obj-code' + ';' +
     5054   'who-lk=call_id/dis-card-type/emitent-host-code,type,host-code,obj-type,obj-code'
     5055   v-resource_id-tables =
     5056   'dis-some-rule=' + ';' +
     5057   'some-lk=resource_id/ext-system/esys-id,db-num' + ';' +
     5058   'stop-list-line=resource_id/clients/obj-type,obj-code' +  ';' +
     5059   'stop-list-line=resource_id/dis-card/d-card' +  ';' +
     5060   'who-lk=resource_id/ext-system/esys-id,db-num'
     5061   .
     5062     do
     5063     on error undo, return error
     5064     :
     5065       do v-ii = 1 to num-entries(v-uniq-key-rec-tables, ';'):
     5066          assign
     5067          v-dop = entry(v-ii, v-uniq-key-rec-tables, ';')
     5068          v-tbl-name = entry(1, v-dop, '=')
     5069          v-keys = entry(2, v-dop, '=')
     5070          .
     5071          create buffer v-bh for table v-tbl-name.
     5072          if v-bh:keys <> v-keys then do:
     5073             run write-log in this-procedure
     5074               (input substitute("Таблица &1, изменился первичный ключ:&2раньше был &3&2сейчас &4&2необходимо перезаполнить UNIQ-KEY-REC"
     5075                                 ,v-tbl-name
     5076                                 ,chr(10)
     5077                                 ,v-keys
     5078                                 ,v-bh:keys
     5079                               )
     5080               ) .
     5081         end.
     5082         delete object v-bh.
     5083       end.
     5084       do v-jj = 1 to 3:
     5085          if v-jj = 1 then do:
     5086            v-list = v-uniq-key-rec-tables-2.
     5087          end.
     5088          if v-jj = 2 then do:
     5089            v-list = v-call_id-tables.
     5090          end.
     5091          if v-jj = 3 then do:
     5092            v-list = v-resource_id-tables.
     5093          end.
     5094          do v-ii = 1 to num-entries(v-list, ';'):
     5095           assign
     5096           v-tbl-name = ''
     5097           v-keys = ''
     5098           .
     5099           assign
     5100           v-dop = entry(v-ii, v-list, ';')
     5101           v-holder-tbl-name = entry(1, v-dop, '=')
     5102           v-dop-2 = entry(2, v-dop, '=')
     5103           v-field-name = entry(1, v-dop-2, chr(47))
     5104           v-tbl-name = (if num-entries(v-dop-2, chr(47)) > 1
     5105                         then entry(2, v-dop-2, chr(47))
     5106                         else '')
     5107           v-keys = (if num-entries(v-dop-2, chr(47)) > 1
     5108                     then entry(3, v-dop-2, chr(47))
     5109                     else '')
     5110           .
     5111           if v-tbl-name  <> '':U then do:
     5112             create buffer v-bh for table v-tbl-name.
     5113             if v-bh:keys <> v-keys then do:
     5114                 run write-log in this-procedure
     5115                   (input substitute("Таблица &1, изменился первичный ключ:&2раньше был &3&2сейчас &4&2необходимо перезаполнить &5 в &6"
     5116                                     ,v-tbl-name
     5117                                     ,chr(10)
     5118                                     ,v-keys
     5119                                     ,v-bh:keys
     5120                                     ,v-field-name
     5121                                     ,v-holder-tbl-name
     5122                                   )
     5123                   ) .
     5124             end.
     5125             delete object v-bh.
     5126           end.
     5127         end.
     5128       end.
     5129     end.
     5130   end procedure.
