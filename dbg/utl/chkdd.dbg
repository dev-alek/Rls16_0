     5258   "goods,alpha1,character;" +
     5259   "goods,gds-code,integer;" +
     5260   "goods,gds-name,character;" +
     5261   "goods,unit-base,character;" +
     5262   "ord-doc,obj-type,character;" +
     5263   "ord-doc,obj-code,integer;" +
     5264   "ord-doc-rcv,obj-type,character;" +
     5265   "ord-doc-rcv,obj-code,integer;" +
     5266   "person,psn-code,integer;" +
     5267   "price-list,b-code,integer;" +
     5268   "price-list,price-sale,decimal;" +
     5269   "prod-bc,b-code,integer;" +
     5270   "prod-bc,bc-on,logical;" +
     5271   "prod-bc,b-str,character;" +
     5272   "route-dump,dump-name,character;" +
     5273   "route-dump,dump-ord,int64;" +
     5274   "route-dump,rec-ord,integer;"  +
     5275   "route-dump,uniq-key-rec,character;" +
     5276   "route-dump,value-rec,raw;" +
     5277   "thbj-attr,property-value-character,character;" +
     5278   "thbj-attr,property-value-date,date;" +
     5279   "thbj-attr,property-value-decimal,decimal;" +
     5280   "thbj-attr,property-value-integer,integer;" +
     5281   "thbj-attr,property-value-logical,logical;" +
     5282   "trn-doc,cli-type,character;" +
     5283   "trn-doc,ext-doc-type,character;" +
     5284   "trn-doc,flag_,logical;" +
     5285   "trn-doc,obj-type,character;" +
     5286   "trn-doc,obj-code,integer;" +
     5287   "trn-doc,status_,character;"
     5288   .
     5289   define variable v-ii as integer no-undo .
     5290   define variable v-table as character no-undo .
     5291   define variable v-field as character no-undo .
     5292   define variable v-dt as character no-undo .
     5293   define variable v-entry as character no-undo .
     5294   define variable v-ok as logical no-undo .
     5295   define buffer buf_field for ub._field.
     5296   define buffer buf_file for ub._file.
     5297   do v-ii = 1 to num-entries(v-field-list, ";"):
     5298     v-entry = entry(v-ii, v-field-list, ";").
     5299     if v-entry = '' then leave.
     5300     v-table = entrY(1, v-entry).
     5301     v-field = entrY(2, v-entry).
     5302     v-dt = entrY(3, v-entry).
     5303     v-ok = no.
     5304     find first buf_file no-lock where
     5305               buf_file._file-name = v-table no-error.
     5306     if available buf_file then do:
     5307       find first buf_field no-lock where
     5308             buf_field._field-name = v-field
     5309         and buf_field._file-recid = recid(buf_file) no-error.
     5310      if available buf_field then do:
     5311        if buf_field._data-type = v-dt then do:
     5312          v-ok = yes.
     5313        end.
     5314      end.
     5315     end.
     5316     if not v-ok then do:
     5317       run write-log in this-procedure
     5318         (input substitute("Таблица &1, изменилось поле &2 используемое динамически (раньше был тип &3)&4" +
     5319                            "&5 &6 &7"
     5320                           ,v-table
     5321                           ,v-field
     5322                           ,v-dt
     5323                           ,chr(10)
     5324                           ,(if available buf_file then "Таблица есть" else "Таблицы нет")
     5325                           ,(if available buf_field then "Поле есть" else "Поля нет")
     5326                           , (if available buf_field then substitute("Тип поля: &1", buf_field._data-type) else "Тип неизсвестен")
     5327                         )
     5328         ) .
     5329     end.
     5330   end.
     5331   end procedure.
     5332   procedure clear-log :
     5333     do
     5334     on error undo, return error return-value
     5335     :
     5336       output stream sout to value(v-log-file-name) .
     5337       output stream sout close .
     5338     end.
     5339   end procedure.
     5340   define variable molditem as character no-undo.
     5341   define variable mError   as integer no-undo.
     5342   procedure write-log-item :
     5343     define input  parameter i-item as character no-undo .
     5344     define input  parameter i-mes  as character no-undo .
     5345     if molditem eq i-item
     5346     then
     5347        if i-mes eq ""
     5348        then
     5349           run write-log in this-procedure (i-mes).
     5350        else do:
     5351           mError = mError + 1.
     5352           run write-log in this-procedure (substitute ("&1) &2",mError, i-mes)).
     5353        end.
     5354     else do:
     5355        if i-mes ne ""
     5356        then do:
     5357           molditem =i-item.
     5358           mError = 1.
     5359           run write-log in this-procedure (substitute ("&1&2&3) &4" ,i-item, chr(10), mError, i-mes)).
     5360        end.
     5361     end.
     5362   end.
     5363   procedure write-log :
     5364     define input  parameter p-msg as character no-undo .
     5365     do
     5366     on error undo, return error return-value
     5367     :
     5368       output stream sout to value(v-log-file-name) append .
     5369       if v-db-utl = "db":U then do:
     5370         if v-error-db <> true
     5371         then do:
     5372           put stream sout unformatted "Обнаружены ошибки в структуре БД" + chr(10) .
     5373         end.
     5374         assign
     5375           v-error-db  = true
     5376         .
     5377       end.
     5378       else do:
     5379         if v-error-utl <> true
     5380         then do:
     5381           put stream sout unformatted "Обнаружены ошибки в утилитах" + chr(10) .
     5382         end.
     5383         assign
     5384           v-error-utl = true
     5385         .
     5386       end.
     5387       put stream sout unformatted p-msg + chr(10) .
     5388       output stream sout close .
     5389     end.
     5390   end procedure.
