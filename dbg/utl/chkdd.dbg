        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: d3f7ea4aa09e, 3307, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        4   define variable vss-date        as character no-undo init "$Date: 2023/05/19 13:37:07 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: chkdd.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/chkdd.p $":U .
        7   define variable vss-description as character no-undo init "Проверка словаря БД".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable v-waitfram-action01         as character   no-undo .
       68   define variable v-waitfram-action02         as character   no-undo .
       69   define variable v-waitfram-action03         as character   no-undo .
       70   define variable mWaitFramTextBeg            as character   no-undo.
       71   define variable mWaitFramTextEnd            as character   no-undo.
       72   define variable mWaitFramView               as logical     no-undo.
       73   define variable mWaitProcEvent              as logical     no-undo init yes.
       74   define variable mWaitFramInterval           as integer     no-undo init 1 .
       75   define variable mWaitFramStop               as logical     no-undo.
       76   define variable mWaitFramStopUser           as logical     no-undo.
       77   define variable mWaitFramStopTimeOut        as logical     no-undo.
       78   define variable mWaitFramStartProc          as datetime-tz no-undo.
       79   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       80   define button B-WaitFramStop auto-end-key
       81        label "Стоп"
       82        size 10 by 1 tooltip "Остоновить процесс".
       83   define button B-viewProcInfo
       84        label "Информация"
       85        size 15 by 1 tooltip "Информация о процесс".
       86   define frame waitfram
       87     v-waitfram-action01 format "x(72)" no-label skip
       88     v-waitfram-action02 format "x(72)" no-label skip
       89     v-waitfram-action03 format "x(72)" no-label skip
       90     B-viewProcInfo
       91     B-WaitFramStop at row 4 col 30
       92     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       93     .
       94   define new global shared variable mBatchMode as logical no-undo init ?.
       95   define variable mFramBachModHandle as handle no-undo.
       96   mFramBachModHandle = frame waitfram:handle.
       97   define variable mFameOldVis as logical no-undo.
       98   define variable mVisCUrentVin as logical no-undo.
       99   if session:batch-mode
      100   then
      101      mBatchMode = yes.
      102   if mBatchMode = ? then do:
      103     mVisCUrentVin = current-window:visible.
      104     mFameOldVis = mFramBachModHandle:visible.
      105     mFramBachModHandle:visible  = yes.
      106     mBatchMode = mFramBachModHandle:visible ne yes.
      107     mFramBachModHandle:visible = mFameOldVis.
      108     current-window:visible = mVisCUrentVin.
      109   end.
      110    if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      115     end.
      116   on choose of B-WaitFramStop in frame waitfram
      117   do:
      118     mWaitFramStop = yes.
      119     mWaitFramStopUser = yes.
      120   end.
      121   function waitfram-check-timeout returns logical():
      122      define variable vtime as int64 no-undo.
      123      if mWaitFramStopTimeOut
      124      then
      125         return yes.
      126      vtime = ( now - mWaitFramStartProc ) / 1000 .
      127      if     mWaitFramTimeOut ne ?
      128         and mWaitFramTimeOut ne 0
      129         and mWaitFramTimeOut lt vtime
      130      then do:
      131         mWaitFramStopTimeOut = yes.
      132      end.
      133      return mWaitFramStopTimeOut.
      134   end.
      135   procedure waitfram-hide :
      136     if not session:batch-mode
      137     then do
      138     on error undo, return error return-value
      139     :
      140       pause 0 before-hide .
      141       if not mBatchMode then
      142         hide frame waitfram .
      143     if     not mWaitFramView
      144        and mWaitProcEvent
      145     then
      146       process events .
      147     end.
      148   end procedure.
      149   procedure waitfram-show :
      150     define input  parameter p-message as character no-undo .
      151     define variable v-left-margin as integer   no-undo .
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       if length(p-message) <= 70 then do:
      157         assign
      158           v-left-margin = integer((70 - length(p-message)) / 2)
      159         .
      160         assign
      161           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      162         .
      163         assign
      164           v-waitfram-action01 = " "
      165           v-waitfram-action02 = " "
      166                                    + fill(" ", v-left-margin)
      167                                    + p-message
      168           v-waitfram-action03 = " "
      169         .
      170       end.
      171       else do:
      172         define variable vRindex1 as integer no-undo.
      173         define variable vRindex2 as integer no-undo.
      174         vRindex1 = r-index(p-message," ",70).
      175         if vRindex1 = 0
      176         then
      177            vRindex1 = 70.
      178         if length(p-message)  <= vRindex1 + 70 then do:
      179           assign
      180             v-waitfram-action01 = " "
      181             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      182             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      183           .
      184         end.
      185         else do:
      186           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      187           if vRindex2 <= vRindex1
      188           then
      189              vRindex2 = vRindex1 + 70.
      190           assign
      191             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      194           .
      195         end.
      196       end.
      197       B-viewProcInfo:visible   in frame waitfram = no.
      198       B-viewProcInfo:sensitive in frame waitfram = no.
      199       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       if  (   mWaitFramView
      202          or  mWaitProcEvent)
      203          and not mBatchMode
      204       then
      205          display
      206             v-waitfram-action01 skip
      207             v-waitfram-action02 skip
      208             v-waitfram-action03 skip
      209          with frame waitfram .
      210       if     mWaitFramView
      211          then do:
      212             if     mWaitFramInterval ne ?
      213                and not mBatchMode
      214             then
      215                wait-for go of frame waitfram pause mWaitFramInterval.
      216          end.
      217          else
      218             if     mWaitProcEvent
      219                and not mBatchMode
      220             then
      221                process events .
      222     end.
      223   end procedure.
      224      procedure waitfram-show-this:
      225         define input  parameter iInterval as int64 no-undo.
      226         define variable vtime as int64 no-undo.
      227         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      228         mWaitFramInterval = iInterval.
      229         run waitfram-show (substitute("&1&2 &3&4" ,
      230                                       mWaitFramTextBeg ,
      231                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      232                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      233                                       mWaitFramTextEnd
      234                                      )
      235                           ).
      236      end.
      237      procedure WaitFramRunPause:
      238         define input  parameter iInterval as dec no-undo.
      239         define variable vStart  as datetime-tz no-undo.
      240         define variable vend    as datetime-tz no-undo.
      241         define variable vint as int64 no-undo.
      242         define variable vOk as logical no-undo.
      243         vStart = now.
      244         vend   = vStart.
      245         publish "WaitFramPause" (iInterval,output vOk).
      246         vend   =  now.
      247         vint = vend - vStart.
      248         vint = iInterval - vint / 1000.
      249         if     not mWaitFramStop
      250            and (   vint > 0
      251                 or (    not vOk
      252                     and iInterval eq ?
      253                     )
      254                 )
      255         then
      256            run waitfram-show-this (iInterval).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and vint > 0
      262         then do:
      263            run gbl/pause.p (vint * 1000).
      264         end.
      265         if iInterval ne ?
      266         then
      267            publish "WaitFramStop".
      268         waitfram-check-timeout().
      269      end.
      270      procedure WaitFramWaitFor:
      271         define input  parameter iInterval as dec no-undo.
      272         assign
      273            mWaitFramStartProc   = now
      274            mWaitFramStopUser    = no
      275            mWaitFramStopTimeOut = no
      276         .
      277         block-wait:
      278         do while not mWaitFramStop:
      279            run WaitFramRunPause (iInterval).
      280            if  waitfram-check-timeout()
      281            then do:
      282               leave block-wait.
      283            end.
      284         end.
      285         run waitfram-hide.
      286      end.
      287   procedure waitfram-join :
      288     define input  parameter p-line-1  as character no-undo .
      289     define input  parameter p-line-2  as character no-undo .
      290     define input  parameter p-line-3  as character no-undo .
      291     define output parameter p-message as character no-undo .
      292     do
      293     on error undo, return error return-value
      294     :
      295       assign
      296         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      299       .
      300     end.
      301   end procedure.
      302   function waitfram-join-function returns character
      303     (input p-line-1 as character
      304     ,input p-line-2 as character
      305     ,input p-line-3 as character
      306     ).
      307     define variable v-message as character no-undo .
      308     run waitfram-join in this-procedure
      309       (input  p-line-1
      310       ,input  p-line-2
      311       ,input  p-line-3
      312       ,output v-message
      313       ) .
      314     return v-message .
      315   end function .
