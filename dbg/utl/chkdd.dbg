     3458   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3459       define variable v-ind         as integer   no-undo .
     3460       define variable v-num-entries as integer   no-undo .
     3461       define variable v-inform      as character no-undo .
     3462       define variable bh_tbl-name   as handle    no-undo .
     3463       define variable v-tbl-not-idx as character no-undo .
     3464       define variable v-idx-avail   as logical   no-undo .
     3465       define variable new-tbl-list  as character no-undo .
     3466       define variable old-tbl-list  as character no-undo .
     3467       define variable old-tbl-avail as logical   no-undo .
     3468       define variable v-double-tbl  as character no-undo .
     3469       define variable v-tbl-name    as character no-undo .
     3470       define variable v-msg         as character no-undo .
     3471       assign
     3472         v-msg         = "":U
     3473         v-tbl-not-idx = "":U
     3474         new-tbl-list  = "":U
     3475       .
     3476       for each ub._Field no-lock
     3477         where ub._Field._Field-Name = 'gds-code':U
     3478       ,first ub._File of ub._Field
     3479       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3480       :
     3481         if  lookup( ub._File._File-Name, v-std-list     ) = 0
     3482         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
     3483         and lookup( ub._File._File-Name, v-special-list ) = 0
     3484         then do:
     3485           assign
     3486             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
     3487           .
     3488         end.
     3489         if lookup( ub._File._File-Name, v-std-list ) <> 0
     3490           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
     3491         then do:
     3492           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
     3493           assign
     3494             v-idx-avail = false
     3495             v-inform    = bh_tbl-name:index-information(1)
     3496             v-ind       = 2
     3497           .
     3498           block_chk-idx:
     3499           do while v-inform <> ?
     3500           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3501           :
     3502             if v-inform <> ?
     3503                 and lookup( entry( 5, v-inform, ",":U ), 'gds-code':U ) > 0
     3504             then do:
     3505               assign
     3506                 v-idx-avail = true
     3507               .
     3508               leave block_chk-idx.
     3509             end.
     3510             assign
     3511               v-inform = bh_tbl-name:index-information( v-ind )
     3512               v-ind    = v-ind + 1
     3513             .
     3514           end.
     3515           if v-idx-avail = false then do:
     3516             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
     3517               assign
     3518                 new-tbl-list = new-tbl-list + " (индекса нет)"
     3519               .
     3520             end.
     3521             else do:
     3522               assign
     3523                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
     3524               .
     3525             end.
     3526           end.
     3527           delete object bh_tbl-name.
     3528         end.
     3529       end.
     3530       assign
     3531         old-tbl-list  = "":U
     3532         v-double-tbl  = "":U
     3533         v-num-entries = num-entries( v-std-list )
     3534       .
     3535       do v-ind = 1 to v-num-entries
     3536       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3537       :
     3538         assign
     3539           v-tbl-name    = entry( v-ind, v-std-list )
     3540           old-tbl-avail = false
     3541         .
     3542         find first ub._File no-lock
     3543           where ub._File._File-Name = v-tbl-name
     3544           no-error .
     3545         if not available ub._File then do:
     3546           assign
     3547             old-tbl-avail = true
     3548           .
     3549         end.
     3550         else do:
     3551           find first ub._Field no-lock
     3552             where ub._Field._File-recid = recid( ub._File )
     3553               and ub._Field._Field-Name = 'gds-code':U
     3554             no-error .
     3555           if not available ub._Field then do:
     3556             assign
     3557               old-tbl-avail = true
     3558             .
     3559           end.
     3560         end.
     3561         if old-tbl-avail = true then do:
     3562           assign
     3563             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     3564           .
     3565         end.
     3566         if ( lookup( v-tbl-name, v-std-list ) > v-ind
     3567              or lookup( v-tbl-name, v-ignore-list ) > 0
     3568              or lookup( v-tbl-name, v-special-list ) > 0
     3569            )
     3570           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     3571         then do:
     3572           assign
     3573             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     3574           .
     3575         end.
     3576       end.
     3577       assign
     3578         v-num-entries = num-entries( v-ignore-list )
     3579       .
     3580       do v-ind = 1 to v-num-entries
     3581       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3582       :
     3583         assign
     3584           v-tbl-name = entry( v-ind, v-ignore-list )
     3585           old-tbl-avail = false
     3586         .
     3587         find first ub._File no-lock
     3588           where ub._File._File-Name = v-tbl-name
     3589           no-error .
     3590         if not available ub._File then do:
     3591           assign
     3592             old-tbl-avail = true
     3593           .
     3594         end.
     3595         else do:
     3596           find first ub._Field no-lock
     3597             where ub._Field._File-recid = recid( ub._File )
     3598               and ub._Field._Field-Name = 'gds-code':U
     3599             no-error .
     3600           if not available ub._Field then do:
     3601             assign
     3602               old-tbl-avail = true
     3603             .
     3604           end.
     3605         end.
     3606         if old-tbl-avail = true then do:
     3607           assign
     3608             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     3609           .
     3610         end.
     3611         if ( lookup( v-tbl-name, v-std-list ) > 0
     3612              or lookup( v-tbl-name, v-ignore-list ) > v-ind
     3613              or lookup( v-tbl-name, v-special-list ) > 0
     3614            )
     3615           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     3616         then do:
     3617           assign
     3618             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     3619           .
     3620         end.
     3621       end.
     3622       assign
     3623         v-num-entries = num-entries( v-special-list )
     3624       .
     3625       do v-ind = 1 to v-num-entries
     3626       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3627       :
     3628         assign
     3629           v-tbl-name = entry( v-ind, v-special-list )
     3630         .
     3631         find first ub._File no-lock
     3632           where ub._File._File-Name = v-tbl-name
     3633           no-error .
     3634         if available ub._File then do:
     3635           find first ub._Field no-lock
     3636             where ub._Field._File-recid = recid( ub._File )
     3637               and ub._Field._Field-Name = 'gds-code':U
     3638             no-error .
     3639         end.
     3640         if not available ub._File
     3641           or ( available ub._File
     3642                and not available ub._Field
     3643              )
     3644         then do:
     3645           assign
     3646             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     3647           .
     3648         end.
     3649         if ( lookup( v-tbl-name, v-std-list ) > 0
     3650              or lookup( v-tbl-name, v-ignore-list ) > 0
     3651              or lookup( v-tbl-name, v-special-list ) > v-ind
     3652            )
     3653           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     3654         then do:
     3655           assign
     3656             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     3657           .
     3658         end.
     3659       end.
     3660       if v-tbl-not-idx <> "" then do:
     3661         assign
     3662           v-msg = v-msg + substitute( "Таблицы не имеют индекса с полями &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'gds-code':U )
     3663         .
     3664       end.
     3665       if new-tbl-list <> "":U then do:
     3666         assign
     3667           v-msg = v-msg + substitute( "Нет обработки таблиц: &2&1&1", chr(10), new-tbl-list )
     3668         .
     3669       end.
     3670       if v-double-tbl <> "":U then do:
     3671         assign
     3672           v-msg = v-msg + substitute( "В списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
     3673         .
     3674       end.
     3675       if old-tbl-list <> "":U then do:
     3676         assign
     3677           v-msg = v-msg + substitute( "В списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые поля: &2&1&1", chr(10), old-tbl-list )
     3678         .
     3679       end.
     3680       if v-msg <> "":U then do:
     3681         return error substitute( "Утилита переименования &3 не корректна.&1&1&2", chr(10), v-msg, 'gds-code':U ) .
     3682       end.
     3683     end.
     3684   end procedure.
     3685   define variable v-db-utl        as character no-undo .
     3686   define variable v-error-db      as logical   no-undo .
     3687   define variable v-error-utl     as logical   no-undo .
     3688   define variable v-log-file-name as character no-undo .
     3689   define variable vartable-name   as character no-undo
