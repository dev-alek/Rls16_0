     3939                   + "Уже была определена процедура-триггер с таким же именем файла:" + chr(10)
     3940                   + substitute("Таблица &1", buf_temp-trigger-proc.file-name_) + chr(10)
     3941                   + substitute("Триггер &1", buf_temp-trigger-proc.trigger-proc_) + chr(10)
     3942                   + substitute("Тип триггера &1", buf_temp-trigger-proc.trigger-event_) + chr(10)
     3943               ) .
     3944         end.
     3945         create buf_temp-trigger-proc .
     3946         assign
     3947         buf_temp-trigger-proc.file-name_  = dictdb._file._file-name
     3948         buf_temp-trigger-proc.trigger-event_ = dictdb._file-trig._event
     3949         buf_temp-trigger-proc.trigger-proc_ = dictdb._file-trig._proc-name
     3950         .
