     3697   define stream sout .
     3698   assign
     3699     v-log-file-name = 'chkdd.txt':u
     3700   .
     3701   define variable v-variable-names as character no-undo .
     3702   define variable v-variable-value as character no-undo .
     3703   define variable v-ii as integer no-undo .
     3704   define variable v-jj as integer no-undo .
     3705   define temp-table temp-description no-undo
     3706     field field-description as character
     3707     field field-name        as character
     3708     index xpk is primary unique field-description .
     3709   define temp-table temp-trigger-proc no-undo
