     3742     end.
     3743     define variable mTextHead as character no-undo.
     3744     for each dictdb._file no-lock
     3745       where dictdb._file._hidden = false
     3746     on error undo, return error return-value
     3747     :
     3748       run waitfram-show in this-procedure
     3749         (input substitute("Проверка словаря БД. Таблица &1", dictdb._file._file-name)
     3750         ) .
     3751       mTextHead = substitute ("Таблица &1",dictdb._file._file-name).
     3752       run validate-name in this-procedure
     3753         (input mTextHead
     3754         ,input "таблицы"
     3755         ,input dictdb._file._file-name
     3756         ,input vartable-name
     3757         ) .
     3758       if length(dictdb._file._file-name) > 28
     3759       then do:
     3760         run write-log-item in this-procedure
     3761           (input mTextHead,
     3762            input "Длина имени таблицы превышает 28 символов"
     3763           ) .
     3764       end.
     3765       if dictdb._file._CAN-CREATE ne "!,!odbc,*"
     3766       then do:
     3767         run write-log-item in this-procedure
     3768           (input mTextHead ,
     3769            input 'Права на создание должны быть "!,!odbc,*" сейчас права "' + dictdb._file._CAN-CREATE + '"'
     3770           ) .
     3771       end.
     3772       if dictdb._file._CAN-DELETE ne "!,!odbc,*"
     3773       then do:
     3774         run write-log-item in this-procedure
     3775           (input mTextHead ,
     3776            input 'Права на удаление должны быть "!,!odbc,*" сейчас права "' + dictdb._file._CAN-DELETE + '"'
     3777           ) .
     3778       end.
     3779       if dictdb._file._CAN-READ ne "!,*"
     3780       then do:
     3781         run write-log-item in this-procedure
     3782           (input mTextHead ,
     3783            input 'Права на чтение должны быть "!,*" сейчас права "' + dictdb._file._CAN-READ + '"'
     3784           ) .
     3785       end.
     3786       if dictdb._file._CAN-WRITE ne "!,!odbc,*"
     3787       then do:
     3788         run write-log-item in this-procedure
     3789           (input mTextHead,
     3790            input 'Права на запись должны быть "!,!odbc,*" сейчас права "' + dictdb._file._CAN-WRITE + '"'
     3791           ) .
     3792       end.
     3793       if     dictdb._file._CAN-DUMP ne "!,!odbc,*"
     3794          and dictdb._file._CAN-DUMP ne   "!odbc,*"
     3795       then do:
     3796         run write-log-item in this-procedure
     3797           (input mTextHead ,
     3798            input 'Права на выгрузку должны быть "!,!odbc,*" сейчас права "' + dictdb._file._CAN-DUMP + '"'
     3799           ) .
     3800       end.
     3801       if     dictdb._file._CAN-LOAD ne "!,!odbc,*"
     3802          and dictdb._file._CAN-LOAD ne   "!odbc,*"
     3803       then do:
     3804         run write-log-item in this-procedure
     3805           (input mTextHead ,
     3806            input 'Права на загрузку должны быть "!,!odbc,*" сейчас права "' + dictdb._file._CAN-LOAD + '"'
     3807           ) .
     3808       end.
     3809       run validate-pi-idx in this-procedure
     3810         (  input mTextHead,
     3811            input dictdb._file._file-name
     3812         ).
     3813       run validate-other-idx in this-procedure
     3814         ( input v-df-file-name
     3815         , input v-pro-file-name
     3816         , input dictdb._file._file-name
     3817         ).
     3818       for each temp-description
     3819       on error undo, return error return-value
     3820       :
     3821         delete temp-description .
     3822       end.
     3823       define variable v-description as character no-undo .
     3824       for each dictdb._field of dictdb._file no-lock
     3825       on error undo, return error return-value
     3826       :
     3827         assign
     3828           v-description = substring(dictdb._field._desc, 1, 100)
     3829         .
     3830         define variable v-check-description as logical   no-undo .
     3831         assign
     3832           v-check-description = false
     3833         .
     3834         if v-check-description = true
     3835         then do:
     3836           if v-description = ""
     3837           or v-description = ?
     3838           then do:
     3839             run write-log-item in this-procedure
     3840               (  input mTextHead,
     3841                  input "Поле " + dictdb._field._field-name    + "Не задано описание поля"
     3842               ) .
     3843           end.
     3844           else do:
     3845             find first temp-description
