     3718   .
     3719   define buffer buf_temp-trigger-proc for temp-trigger-proc.
     3720   define stream IdxStream .
     3721   do
     3722   on error undo, return error return-value
     3723   :
     3724     define variable v-df-file-name        as character no-undo .
