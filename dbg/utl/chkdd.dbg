     3906           when 'create':u
     3907           then do:
     3908             assign
     3909               v-create-trigger = dictdb._file-trig._proc-name
     3910             .
     3911           end.
     3912           when 'write':u
     3913           then do:
     3914             assign
     3915               v-write-trigger = dictdb._file-trig._proc-name
     3916             .
     3917           end.
     3918           when 'delete':u
