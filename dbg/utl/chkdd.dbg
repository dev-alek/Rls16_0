     3733       v-pro-file-name      = file-info :full-pathname + chr(92) + v-pro-file-name
     3734     .
     3735     os-delete value( v-df-file-name ) .
     3736     os-delete value( v-pro-file-name ) .
     3737     assign
     3738       v-db-utl = "db":U
     3739     .
     3740     for each buf_temp-trigger-proc:
