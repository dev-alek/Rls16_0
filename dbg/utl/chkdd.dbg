     3981       and v-write-trigger  = v-delete-trigger
     3982       then do:
     3983         run write-log-item in this-procedure
     3984           (input mTextHead,
     3985                  substitute("Триггеры ссылаются на один файл ")
     3986                + substitute("Триггер на запись &1 ", v-write-trigger)
     3987                + substitute("Триггер на удаление &1 ", v-delete-trigger)
     3988           ) .
     3989       end.
     3990       if  v-create-trigger <> ''
     3991       and v-delete-trigger <> ''
     3992       and v-create-trigger = v-delete-trigger
