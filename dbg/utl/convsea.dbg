        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 2a79bf27b012, 291, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Dec 01 19:11:26 2015 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: convsea.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/convsea.p $":U .
        7   define variable vss-description as character no-undo init "Конвертация сезонов в новый формат.".
        8   define variable v-year  as integer no-undo.
        9   define variable v-ok    as logical no-undo.
       10   define variable ii      as integer no-undo.
       11   message
       12     "Конвертировать сезоны в новый формат?"
       13     view-as alert-box question buttons yes-no update v-ok .
       14   if not v-ok then return.
       15   for each ub.season exclusive-lock where ub.season.sea-month-1 > 0 and ub.season.sea-month-2 <= 12 :
       16     assign
       17       v-year = year (today)
       18       ub.season.sea-month-1 = integer (date (ub.season.sea-month-1, 01, v-year))
       19       ub.season.sea-month-2 = integer (date (if ub.season.sea-month-2 <> 12 then ub.season.sea-month-2 + 1 else 01, 01, if ub.season.sea-month-2 = 12 then v-year + 1 else v-year)) - 1
       20       ii = ii + 1
       21       .
       22   end.
       23   message substitute ("Готово. Удачно конвертировано сезон(а/ов) &1", ii) view-as alert-box information .
