       53   function covchar returns character   (input iText as character):
       54     define variable oldchar as character no-undo
       55     init "йцукенгшщзхъфывапролджэ€чсмитьбюЄ…÷” ≈Ќ√Ўў«’Џ‘џ¬јѕ–ќЋƒ∆я„—ћ»“№Ѕё®Ё"
       56     .
       57     define variable newchar as character no-undo
       58     init "qwertyuiop[]asdfghjkl;'zxcvbnm,.tQWERTYUIOPASDFGHJKL:ZXCVBNM<>T"
       59     .
       60     newchar = newchar + '"'.
       61     define variable vi as integer no-undo.
       62     do vi = 1 to length(oldchar):
       63        iText = replace(itext,substring(oldchar,vi,1),substring(newchar,vi,1)).
       64     end.
       65     return iText.
       66   end.
       67   function crpas returns integer  (input iText as character):
       68   put unformatted  "create pasSysadm." skip .
       69   put unformatted  "assign" skip.
       70    mMaxNumPas     = mMaxNumPas + 1.
       71   put unformatted  '     pasSysadm.Flogin  = "' + mLogin + '"'         skip .
       72   put unformatted  "     pasSysadm.num     = " mMaxNumPas              skip .
       73   put unformatted  '                      /* "' + itext + '" */'       skip .
       74   put unformatted  '     pasSysadm.pasw    = "' + covchar(itext) + '"' skip .
       75   put unformatted  "  .  " skip(1) .
       76   end.
