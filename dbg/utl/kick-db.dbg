        1   block-level on error undo, throw.
        2   define input parameter p-sys-key  as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: f0ae80db3135, 3548, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        5   define variable vss-date        as character no-undo init "$Date: 2023/11/27 08:31:17 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: kick-db.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/kick-db.p $":U .
        8   define variable vss-description as character no-undo init "Закачка валют, едизм, стран, налогов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure factord :
       71     define input  parameter p-fact-date            as date    no-undo .
       72     define input  parameter p-fact-time            as integer no-undo .
       73     define input  parameter p-fact-num             as integer no-undo .
       74     define input  parameter p-shift-date           as date    no-undo .
       75     define input  parameter p-shift-num            as integer no-undo .
       76     define input  parameter p-shift-on             as logical no-undo .
       77     define output parameter p-fact-order           as decimal no-undo .
       78     define output parameter p-shift-end-fact-order as decimal no-undo .
       79     define output parameter p-day-end-fact-order   as decimal no-undo .
       80     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       81     if p-fact-date = ?
       82     then do:
       83       return error "Не указана фактическая дата" .
       84     end.
       85     define variable v-fact-date-num as integer no-undo .
       86     assign
       87       v-fact-date-num = integer(p-fact-date)
       88     .
       89     if p-fact-num = ?
       90     or p-fact-num = 0
       91     then do:
       92       return error "Не задан p-fact-num " + string(p-fact-num) .
       93     end.
       94     if p-fact-num < 0
       95     then do:
       96       return error "Отрицательный fact-num " + string(p-fact-num) .
       97     end.
       98     if p-fact-num >= 100000000
       99     then do:
      100       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      101     end.
      102     if p-shift-on = true
      103     then do:
      104       if p-shift-date = ?
      105       then do:
      106         return error "Не задана дата смены" .
      107       end.
      108       if p-shift-num = ?
      109       or p-shift-num = 0
      110       then do:
      111         return error "Не задан номер смены" .
      112       end.
      113     end.
      114     else do:
      115       assign
      116         p-shift-date = p-fact-date
      117         p-shift-num  = 24
      118       .
      119     end.
      120     define variable v-shift-offset as integer no-undo .
      121     if p-shift-date = p-fact-date
      122     then do:
      123       assign
      124         v-shift-offset = 1
      125       .
      126     end.
      127     if p-shift-date < p-fact-date
      128     then do:
      129       assign
      130         v-shift-offset = 0
      131       .
      132     end.
      133     if p-shift-date > p-fact-date
      134     then do:
      135       message
      136         vss-workfile vss-revision vss-description skip
      137         "Неправильная дата закрытия смены" skip
      138         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      139         view-as alert-box error .
      140       undo, return error
      141         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      142           ,string(p-fact-date, '99/99/9999':U)
      143           ,string(p-shift-date, '99/99/9999':U)
      144           )
      145       .
      146     end.
      147     if p-shift-num < 1
      148     or p-shift-num > 24
      149     then do:
      150       message
      151         vss-workfile vss-revision vss-description skip
      152         "Неправильный номер смены" skip
      153         "p-shift-num" p-shift-num skip
      154         view-as alert-box error .
      155       undo, return error return-value .
      156     end.
      157     assign
      158       p-fact-order           = v-fact-date-num
      159                              + v-shift-offset * 0.5
      160                              + p-shift-num    * 0.02 - 0.01
      161                              + p-fact-num     * 0.0000000001
      162       p-shift-end-fact-order = v-fact-date-num
      163                              + v-shift-offset * 0.5
      164                              + p-shift-num    * 0.02
      165       p-day-end-fact-order   = v-fact-date-num
      166                              + 0.99
      167     .
      168     if p-fact-order           <= v-fact-date-num
      169     or p-shift-end-fact-order <= v-fact-date-num
      170     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      171     or p-shift-end-fact-order >= p-day-end-fact-order
      172     then do:
      173       message
      174         vss-workfile vss-revision vss-description skip
      175         "Внутренняя ошибка при генерации фактического номера" skip
      176         "p-fact-date"            p-fact-date            skip
      177         "p-fact-time"            p-fact-time            skip
      178         "p-fact-num"             p-fact-num             skip
      179         "p-shift-date"           p-shift-date           skip
      180         "p-shift-num"            p-shift-num            skip
      181         "p-shift-on"             p-shift-on             skip
      182         "p-shift-end-fact-order" p-shift-end-fact-order skip
      183         "p-day-end-fact-order"   p-day-end-fact-order   skip
      184         "v-fact-date-num"        v-fact-date-num        skip
      185         view-as alert-box error .
      186       undo, return error return-value .
      187     end.
      188   end procedure.
      189   procedure day-begin-fact-order :
      190     define input  parameter p-fact-date            as date    no-undo .
      191     define output parameter p-day-begin-fact-order as decimal no-undo .
      192     do
      193     on error undo, return error return-value
      194     :
      195       if p-fact-date = ?
      196       then do:
      197         assign
      198           p-day-begin-fact-order = 0
      199         .
      200       end.
      201       else do:
      202         assign
      203           p-day-begin-fact-order = integer(p-fact-date)
      204         .
      205       end.
      206     end.
      207   end procedure.
      208   procedure factord-max-fact-order :
      209     define output parameter p-max-fact-order as decimal   no-undo .
      210     do
      211     on error undo, return error return-value
      212     :
      213       run day-begin-fact-order in this-procedure
      214         (input  date(1, 1, 5000)
      215         ,output p-max-fact-order
      216         ) .
      217     end.
      218   end procedure.
      219   procedure factord-cut-archive :
      220     define input  parameter p-obj-type             as character no-undo .
      221     define input  parameter p-obj-code             as integer   no-undo .
      222     define input  parameter p-fact-date            as date      no-undo .
      223     define output parameter p-shift-on             as logical   no-undo .
      224     define output parameter p-shift-date           as date      no-undo .
      225     define output parameter p-shift-num            as integer   no-undo .
      226     define output parameter p-day-end-fact-order   as decimal   no-undo .
      227     define output parameter p-shift-end-fact-order as decimal   no-undo .
      228     define variable v-fact-order as decimal   no-undo .
      229     define buffer buf_shift-obj for ub.shift-obj .
      230     do
      231     on error undo, return error return-value
      232     :
      233   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      234   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      235     (input  p-obj-type
      236     ,input  p-obj-code
      237     ,input  'shift-on=request'
      238     ,output p-shift-on
      239     ) no-error .
      240       if error-status :error
      241       then do:
      242         message
      243           vss-workfile vss-revision vss-description skip
      244           "Ошибка при определении атрибута объекта" skip
      245           "Объект" p-obj-type p-obj-code skip
      246           error-status :get-message(1) skip
      247           return-value skip
      248           view-as alert-box error .
      249         undo, return error return-value .
      250       end.
      251       if p-shift-on = false
      252       then do:
      253         assign
      254           p-shift-date               = ?
      255           p-shift-num                = 0
      256         .
      257       end.
      258       else do:
      259         find first buf_shift-obj share-lock
      260           where buf_shift-obj.obj-type   = p-obj-type
      261             and buf_shift-obj.obj-code   = p-obj-code
      262             and buf_shift-obj.shift-date > p-fact-date
      263           use-index pi
      264           no-error .
      265         if not available buf_shift-obj
      266         or buf_shift-obj.status_ <> 'зкр':U
      267         then do:
      268           message
      269             vss-workfile vss-revision vss-description skip
      270             "Невозможно вычислить последнюю смену" skip
      271             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      272             "Объект" p-obj-type p-obj-code skip
      273             "Дата" p-fact-date skip
      274             view-as alert-box error .
      275           undo, return error return-value .
      276         end.
      277         find last buf_shift-obj share-lock
      278           where buf_shift-obj.obj-type = p-obj-type
      279             and buf_shift-obj.obj-code = p-obj-code
      280             and buf_shift-obj.shift-date <= p-fact-date
      281           use-index pi
      282           no-error .
      283         if available buf_shift-obj
      284         then do:
      285           if  buf_shift-obj.status_ = 'зкр':U
      286           then do:
      287             assign
      288               p-shift-date = buf_shift-obj.shift-date
      289               p-shift-num  = buf_shift-obj.shift-num
      290             .
      291           end.
      292           else do:
      293             message
      294               vss-workfile vss-revision vss-description skip
      295               "Невозможно вычислить последнюю смену" skip
      296               "Статус смены отличен от статуса" 'зкр':U skip
      297               "Объект" p-obj-type p-obj-code skip
      298               "Дата" p-fact-date skip
      299               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      300               view-as alert-box error .
      301             undo, return error return-value .
      302           end.
      303         end.
      304         else do:
      305           assign
      306             p-shift-date = p-fact-date - 1
      307             p-shift-num  = 1
      308           .
      309         end.
      310       end.
      311       run factord in this-procedure
      312         (input  p-fact-date
      313         ,input  1
      314         ,input  1
      315         ,input  p-shift-date
      316         ,input  p-shift-num
      317         ,input  p-shift-on
      318         ,output v-fact-order
      319         ,output p-shift-end-fact-order
      320         ,output p-day-end-fact-order
      321         ) no-error .
      322       if error-status :error
      323       then do:
      324         message
      325           vss-workfile vss-revision vss-description skip
      326           "Ошибка при вызове процедуры factord"
      327           error-status :get-message(1) skip
      328           return-value skip
      329           view-as alert-box error .
      330         undo, return error return-value .
      331       end.
      332     end.
      333   end procedure.
      334   procedure factord-lock-shift :
      335     define input  parameter p-obj-type  as character no-undo .
      336     define input  parameter p-obj-code  as integer   no-undo .
      337     define input  parameter p-fact-date as date      no-undo .
      338     define parameter buffer buf_shift-obj for ub.shift-obj .
      339     define variable v-shift-on      as logical   no-undo .
      340     define variable v-extra-message as character no-undo .
      341     define variable v-error as character no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      347     (input  p-obj-type
      348     ,input  p-obj-code
      349     ,input  'shift-on=request'
      350     ,output v-shift-on
      351     ) no-error .
      352       if error-status :error
      353       then do:
      354         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      355         undo, return error v-error .
      356       end.
      357       if v-shift-on = true
      358       then do:
      359         find first buf_shift-obj share-lock
      360           where buf_shift-obj.obj-type   = p-obj-type
      361             and buf_shift-obj.obj-code   = p-obj-code
      362             and buf_shift-obj.shift-date > p-fact-date
      363           use-index pi
      364           no-error .
      365         if not available buf_shift-obj
      366         or buf_shift-obj.status_ <> 'зкр':U
      367         then do:
      368           find last buf_shift-obj
      369             where buf_shift-obj.obj-type = p-obj-type
      370               and buf_shift-obj.obj-code = p-obj-code
      371               and buf_shift-obj.status_  = 'зкр':U
      372             use-index stts
      373             no-error .
      374           if available buf_shift-obj
      375           then do:
      376             assign
      377               v-extra-message =
      378                     substitute("Дата начала последеней закрытой смены на объекте &1"
      379                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      380                               )
      381             .
      382           end.
      383           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      384           undo, return error v-error .
      385         end.
      386       end.
      387     end.
      388   end procedure.
      389   procedure factord-end-day :
      390     define input  parameter p-fact-date            as date    no-undo .
      391     define output parameter p-day-end-fact-order   as decimal no-undo .
      392     do
      393     on error undo, return error return-value
      394     :
      395       if p-fact-date = ?
      396       then do:
      397         return error "Не указана фактическая дата" .
      398       end.
      399       assign
      400         p-day-end-fact-order = integer(p-fact-date) + 0.99
      401       .
      402     end.
      403   end procedure.
      404   procedure factord-to-date :
      405     define input  parameter p-fact-order as decimal no-undo .
      406     define output parameter p-fact-date  as date    no-undo .
      407     define variable v-ref-date  as date      no-undo .
      408     define variable v-ref-delta as integer   no-undo .
      409     do
      410     on error undo, return error return-value
      411     :
      412       if p-fact-order = ?
      413       or p-fact-order = 0
      414       then do:
      415         return error "Не указан fact-order" .
      416       end.
      417       assign
      418         v-ref-date  = date(1, 1, 2000)
      419       .
      420       assign
      421         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      422       .
      423       assign
      424         p-fact-date = v-ref-date + v-ref-delta
      425       .
      426     end.
      427   end procedure.
      428   procedure factord-to-fact-num :
      429     define input  parameter p-fact-order as decimal no-undo .
      430     define output parameter p-fact-num   as integer no-undo .
      431     define variable v-fact-order-trunc as decimal no-undo .
      432     do
      433     on error undo, return error return-value
      434     :
      435       if p-fact-order = ?
      436       or p-fact-order = 0
      437       then do:
      438         return error "Не указан fact-order" .
      439       end.
      440       assign
      441        v-fact-order-trunc = truncate(p-fact-order, 2)
      442       .
      443       assign
      444         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      445       .
      446     end.
      447   end procedure.
      448   procedure factord-to-shift-num :
      449     define input  parameter p-fact-order as decimal no-undo .
      450     define output parameter p-shift-num   as integer no-undo .
      451     define variable  p-shift-numd  as decimal   no-undo .
      452     define variable v-fact-order-trunc as decimal no-undo .
      453     do
      454     on error undo, return error return-value
      455     :
      456       if p-fact-order = ?
      457       or p-fact-order = 0
      458       then do:
      459         return error "Не указан fact-order" .
      460       end.
      461       assign
      462        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      463       .
      464       if v-fact-order-trunc < 0.5 then do:
      465         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      466       end.
      467       assign
      468         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      469         .
      470        assign
      471         p-shift-num = truncate (p-shift-numd , 0)
      472       .
      473     end.
      474   end procedure.
      475   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   procedure cur-time :
      477      define output parameter p-today as date      no-undo .
      478      define output parameter p-time  as integer   no-undo .
      479     do
      480     on error undo, return error
      481     :
      482       define variable v-date1 as date      no-undo .
      483       define variable v-date2 as date      no-undo .
      484       define variable v-time  as integer   no-undo .
      485       assign
      486         v-date1 = today
      487         v-time  = time
      488         v-date2 = today
      489       .
      490       if v-date1 <> v-date2
      491       then do:
      492         assign
      493           v-date1 = today
      494           v-time  = v-time
      495         .
      496       end.
      497       assign
      498         p-today = v-date1
      499         p-time  = v-time
      500       .
      501     end.
      502   end.
      503   function cur-time-date returns character
      504   :
      505     return string(today, '99/99/9999':U) .
      506   end.
      507   function cur-time-mjd returns decimal
      508   :
      509     define variable v-date as date      no-undo .
      510     define variable v-time as integer   no-undo .
      511     run cur-time in this-procedure
      512       (output v-date
      513       ,output v-time
      514       ) .
      515     return integer(v-date) - 2400002 + (v-time / 86400) .
      516   end.
      517   function cur-time-get-ending-index returns integer
      518   (input p-number as integer
      519   )
      520   :
      521     if p-number < 0
      522     or p-number = ?
      523     then do:
      524       return 1 .
      525     end.
      526     define variable v-rest as integer   no-undo .
      527     assign
      528       p-number = p-number modulo 100
      529     .
      530     if p-number < 20
      531     then do:
      532       assign
      533         v-rest = p-number
      534       .
      535     end.
      536     else do:
      537       assign
      538         v-rest = p-number modulo 10
      539       .
      540     end.
      541     case v-rest :
      542       when 1
      543       then do:
      544         return 2 .
      545       end.
      546       when 2 or
      547       when 3 or
      548       when 4
      549       then do:
      550         return 3 .
      551       end.
      552       otherwise do:
      553         return 1 .
      554       end.
      555     end case .
      556   end.
      557   procedure cur-time-mjd-to-date :
      558      define input  parameter i-mjd-diff as decimal no-undo.
      559      define output parameter o-Date     as date    no-undo.
      560      define output parameter o-Time     as integer no-undo.
      561      define variable v-day-number as integer   no-undo .
      562      if    i-mjd-diff < 0
      563         or i-mjd-diff = ?
      564      then do:
      565         return "?" .
      566      end.
      567      assign
      568         v-day-number = truncate(i-mjd-diff,0).
      569         o-Date = date(v-day-number + 2400002).
      570         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      571     .
      572   end.
      573   function cur-time-mjd-to-string returns character
      574   (input p-mjd-diff as decimal
      575   )
      576   :
      577     define variable v-day-number as integer   no-undo .
      578     define variable v-seconds    as integer   no-undo .
      579     define variable v-hour       as integer   no-undo .
      580     define variable v-min        as integer   no-undo .
      581     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      582     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      583     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      584     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      585     if p-mjd-diff < 0
      586     or p-mjd-diff = ?
      587     then do:
      588       return "?" .
      589     end.
      590     assign
      591       v-day-number = integer(truncate(p-mjd-diff,0))
      592       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      593     .
      594     if v-seconds > 86400
      595     then do:
      596       assign
      597         v-seconds = 86400 - 1
      598       .
      599     end.
      600     if v-seconds < 0
      601     then do:
      602       assign
      603         v-seconds = 0
      604       .
      605     end.
      606     assign
      607       v-hour = truncate(v-seconds / 3600, 0)
      608     .
      609     assign
      610       v-seconds = v-seconds modulo 3600
      611     .
      612     assign
      613       v-min = truncate(v-seconds / 60, 0)
      614     .
      615     assign
      616       v-seconds = v-seconds modulo 60
      617     .
      618     return
      619         (if v-day-number <> 0
      620           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      621           else ""
      622         )
      623       + (if v-day-number <> 0 or v-hour <> 0
      624           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      625           else ""
      626         )
      627       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      628           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      629           else ""
      630         )
      631       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      632       .
      633   end.
      634   function cur-time-string returns character
      635   :
      636     define variable v-date as date      no-undo .
      637     define variable v-time as integer   no-undo .
      638     run cur-time in this-procedure
      639       (output v-date
      640       ,output v-time
      641       ) .
      642     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      643   end.
      644   function cur-time-string-sec returns character
      645   :
      646     define variable v-date as date      no-undo .
      647     define variable v-time as integer   no-undo .
      648     run cur-time in this-procedure
      649       (output v-date
      650       ,output v-time
      651       ) .
      652     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      653   end.
      654   function cur-time-custom  returns character
      655   (input p-prefix as character
      656   ,input p-date-format as character
      657   ,input p-delimiter as character
      658   ,input p-time-format as character
      659   ,input p-suffix as character
      660   )
      661   :
      662     define variable v-date as date      no-undo .
      663     define variable v-time as integer   no-undo .
      664     run cur-time in this-procedure
      665       (output v-date
      666       ,output v-time
      667       ) .
      668     return
      669       p-prefix
      670       + string(v-date, p-date-format)
      671       + p-delimiter
      672       + string(v-time, p-time-format)
      673       + p-suffix
      674       .
      675   end.
      676   function cur-time-print  returns character
      677   :
      678     define variable v-date as date      no-undo .
      679     define variable v-time as integer   no-undo .
      680     run cur-time in this-procedure
      681       (output v-date
      682       ,output v-time
      683       ) .
      684     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      685   end.
      686   function cur-time-datetime returns datetime
      687   :
      688     define variable v-char as character no-undo .
      689     define variable v-datetime as datetime no-undo .
      690     v-char = cur-time-string().
      691     v-datetime = datetime(v-char).
      692     return  v-datetime.
      693   end.
      694   function cur-time-string-msec returns character
      695   :
      696     define variable v-date as datetime  no-undo .
      697     v-date = now.
      698     return string(v-date) .
      699   end.
      700   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      701   define variable v-waitfram-action01         as character   no-undo .
      702   define variable v-waitfram-action02         as character   no-undo .
      703   define variable v-waitfram-action03         as character   no-undo .
      704   define variable mWaitFramTextBeg            as character   no-undo.
      705   define variable mWaitFramTextEnd            as character   no-undo.
      706   define variable mWaitFramView               as logical     no-undo.
      707   define variable mWaitProcEvent              as logical     no-undo init yes.
      708   define variable mWaitFramInterval           as integer     no-undo init 1 .
      709   define variable mWaitFramStop               as logical     no-undo.
      710   define variable mWaitFramStopUser           as logical     no-undo.
      711   define variable mWaitFramStopTimeOut        as logical     no-undo.
      712   define variable mWaitFramStartProc          as datetime-tz no-undo.
      713   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      714   define button B-WaitFramStop auto-end-key
      715        label "Стоп"
      716        size 10 by 1 tooltip "Остоновить процесс".
      717   define button B-viewProcInfo
      718        label "Информация"
      719        size 15 by 1 tooltip "Информация о процесс".
      720   define frame waitfram
      721     v-waitfram-action01 format "x(72)" no-label skip
      722     v-waitfram-action02 format "x(72)" no-label skip
      723     v-waitfram-action03 format "x(72)" no-label skip
      724     B-viewProcInfo
      725     B-WaitFramStop at row 4 col 30
      726     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      727     .
      728   define new global shared variable mBatchMode as logical no-undo init ?.
      729   define variable mFramBachModHandle as handle no-undo.
      730   mFramBachModHandle = frame waitfram:handle.
      731   define variable mFameOldVis as logical no-undo.
      732   define variable mVisCUrentVin as logical no-undo.
      733   if session:batch-mode
      734   then
      735      mBatchMode = yes.
      736   if mBatchMode = ? then do:
      737     mVisCUrentVin = current-window:visible.
      738     mFameOldVis = mFramBachModHandle:visible.
      739     mFramBachModHandle:visible  = yes.
      740     mBatchMode = mFramBachModHandle:visible ne yes.
      741     mFramBachModHandle:visible = mFameOldVis.
      742     current-window:visible = mVisCUrentVin.
      743   end.
      744    if  log-manager:logfile-name ne ?
      745     then DO:
      746         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      747         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      748         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      749     end.
      750   on choose of B-WaitFramStop in frame waitfram
      751   do:
      752     mWaitFramStop = yes.
      753     mWaitFramStopUser = yes.
      754   end.
      755   function waitfram-check-timeout returns logical():
      756      define variable vtime as int64 no-undo.
      757      if mWaitFramStopTimeOut
      758      then
      759         return yes.
      760      vtime = ( now - mWaitFramStartProc ) / 1000 .
      761      if     mWaitFramTimeOut ne ?
      762         and mWaitFramTimeOut ne 0
      763         and mWaitFramTimeOut lt vtime
      764      then do:
      765         mWaitFramStopTimeOut = yes.
      766      end.
      767      return mWaitFramStopTimeOut.
      768   end.
      769   procedure waitfram-hide :
      770     if not session:batch-mode
      771     then do
      772     on error undo, return error return-value
      773     :
      774       pause 0 before-hide .
      775       if not mBatchMode then
      776         hide frame waitfram .
      777     if     not mWaitFramView
      778        and mWaitProcEvent
      779     then
      780       process events .
      781     end.
      782   end procedure.
      783   procedure waitfram-show :
      784     define input  parameter p-message as character no-undo .
      785     define variable v-left-margin as integer   no-undo .
      786     if not session:batch-mode
      787     then do
      788     on error undo, return error return-value
      789     :
      790       if length(p-message) <= 70 then do:
      791         assign
      792           v-left-margin = integer((70 - length(p-message)) / 2)
      793         .
      794         assign
      795           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      796         .
      797         assign
      798           v-waitfram-action01 = " "
      799           v-waitfram-action02 = " "
      800                                    + fill(" ", v-left-margin)
      801                                    + p-message
      802           v-waitfram-action03 = " "
      803         .
      804       end.
      805       else do:
      806         define variable vRindex1 as integer no-undo.
      807         define variable vRindex2 as integer no-undo.
      808         vRindex1 = r-index(p-message," ",70).
      809         if vRindex1 = 0
      810         then
      811            vRindex1 = 70.
      812         if length(p-message)  <= vRindex1 + 70 then do:
      813           assign
      814             v-waitfram-action01 = " "
      815             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      816             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      817           .
      818         end.
      819         else do:
      820           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      821           if vRindex2 <= vRindex1
      822           then
      823              vRindex2 = vRindex1 + 70.
      824           assign
      825             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      826             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      827             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      828           .
      829         end.
      830       end.
      831       B-viewProcInfo:visible   in frame waitfram = no.
      832       B-viewProcInfo:sensitive in frame waitfram = no.
      833       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      834       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      835       if  (   mWaitFramView
      836          or  mWaitProcEvent)
      837          and not mBatchMode
      838       then
      839          display
      840             v-waitfram-action01 skip
      841             v-waitfram-action02 skip
      842             v-waitfram-action03 skip
      843          with frame waitfram .
      844       if     mWaitFramView
      845          then do:
      846             if     mWaitFramInterval ne ?
      847                and not mBatchMode
      848             then
      849                wait-for go of frame waitfram pause mWaitFramInterval.
      850          end.
      851          else
      852             if     mWaitProcEvent
      853                and not mBatchMode
      854             then
      855                process events .
      856     end.
      857   end procedure.
      858      procedure waitfram-show-this:
      859         define input  parameter iInterval as int64 no-undo.
      860         define variable vtime as int64 no-undo.
      861         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      862         mWaitFramInterval = iInterval.
      863         run waitfram-show (substitute("&1&2 &3&4" ,
      864                                       mWaitFramTextBeg ,
      865                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      866                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      867                                       mWaitFramTextEnd
      868                                      )
      869                           ).
      870      end.
      871      procedure WaitFramRunPause:
      872         define input  parameter iInterval as dec no-undo.
      873         define variable vStart  as datetime-tz no-undo.
      874         define variable vend    as datetime-tz no-undo.
      875         define variable vint as int64 no-undo.
      876         define variable vOk as logical no-undo.
      877         vStart = now.
      878         vend   = vStart.
      879         publish "WaitFramPause" (iInterval,output vOk).
      880         vend   =  now.
      881         vint = vend - vStart.
      882         vint = iInterval - vint / 1000.
      883         if     not mWaitFramStop
      884            and (   vint > 0
      885                 or (    not vOk
      886                     and iInterval eq ?
      887                     )
      888                 )
      889         then
      890            run waitfram-show-this (iInterval).
      891         vend   =  now.
      892         vint = vend - vStart.
      893         vint = iInterval - vint / 1000.
      894         if     not mWaitFramStop
      895            and vint > 0
      896         then do:
      897            run gbl/pause.p (vint * 1000).
      898         end.
      899         if iInterval ne ?
      900         then
      901            publish "WaitFramStop".
      902         waitfram-check-timeout().
      903      end.
      904      procedure WaitFramWaitFor:
      905         define input  parameter iInterval as dec no-undo.
      906         assign
      907            mWaitFramStartProc   = now
      908            mWaitFramStopUser    = no
      909            mWaitFramStopTimeOut = no
      910         .
      911         block-wait:
      912         do while not mWaitFramStop:
      913            run WaitFramRunPause (iInterval).
      914            if  waitfram-check-timeout()
      915            then do:
      916               leave block-wait.
      917            end.
      918         end.
      919         run waitfram-hide.
      920      end.
      921   procedure waitfram-join :
      922     define input  parameter p-line-1  as character no-undo .
      923     define input  parameter p-line-2  as character no-undo .
      924     define input  parameter p-line-3  as character no-undo .
      925     define output parameter p-message as character no-undo .
      926     do
      927     on error undo, return error return-value
      928     :
      929       assign
      930         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      931                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      932                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      933       .
      934     end.
      935   end procedure.
      936   function waitfram-join-function returns character
      937     (input p-line-1 as character
      938     ,input p-line-2 as character
      939     ,input p-line-3 as character
      940     ).
      941     define variable v-message as character no-undo .
      942     run waitfram-join in this-procedure
      943       (input  p-line-1
      944       ,input  p-line-2
      945       ,input  p-line-3
      946       ,output v-message
      947       ) .
      948     return v-message .
      949   end function .
      950   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   procedure cli-grplib-get-full-name :
      952      define input parameter  p-node-code  as integer      no-undo.
      953      define output parameter p-full-name as character    no-undo.
      954   do
      955   on error undo, return error
      956   :
      957       define variable v-upper-code    as integer           no-undo.
      958       define buffer buf_cli-grp       for ub.cli-grp.
      959       define buffer buf_upper_cli-grp for ub.cli-grp.
      960       find first buf_cli-grp no-lock
      961            where buf_cli-grp.node-code = p-node-code
      962       no-error.
      963       if not available buf_cli-grp
      964       then do:
      965           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      966       end.
      967       assign
      968           p-full-name  = ""
      969           v-upper-code = 1
      970       .
      971       do while buf_cli-grp.upper-code <> 0
      972       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      973       :
      974           assign
      975               p-full-name  = buf_cli-grp.node-name
      976                            + (if p-full-name <> "" then chr(47) else "")
      977                            + p-full-name
      978               v-upper-code = buf_cli-grp.upper-code
      979           .
      980           find first buf_cli-grp no-lock
      981                where buf_cli-grp.node-code = v-upper-code
      982           no-error.
      983           if not available buf_cli-grp
      984           then do:
      985               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      986                                   + string( v-upper-code )
      987                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      988           end.
      989       end.
      990       assign
      991       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      992       .
      993   end.
      994   end .
      995   procedure cgrplib-get-node-from-full-name :
      996   define input parameter p-full-name as character no-undo .
      997   define output parameter p-node-code as integer no-undo .
      998   define variable v-ii as integer no-undo .
      999   define variable v-upper-code as integer no-undo .
     1000   define variable v-root-code as integer no-undo .
     1001   define variable v-entry as character no-undo .
     1002   define buffer buf_cli-grp       for ub.cli-grp.
     1003   do
     1004   on error undo, return error
     1005   :
     1006     find first buf_cli-grp no-lock
     1007         where buf_cli-grp.upper-code = 0
     1008     no-error .
     1009     if not available buf_cli-grp
     1010     then do:
     1011         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     1012     end.
     1013     else do:
     1014       assign
     1015       v-root-code = buf_cli-grp.node-code
     1016       .
     1017     end.
     1018     v-upper-code = v-root-code.
     1019     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1020       assign
     1021       v-entry = entry(v-ii, p-full-name, chr(47)).
     1022       if v-entry = '' then leave.
     1023       find first buf_cli-grp no-lock where
     1024                 buf_cli-grp.node-name = v-entry
     1025             and buf_cli-grp.upper-code = v-upper-code
     1026             no-error.
     1027       if not available buf_cli-grp then do:
     1028         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1029       end.
     1030       else do:
     1031         p-node-code = buf_cli-grp.node-code.
     1032         v-upper-code = buf_cli-grp.node-code.
     1033       end.
     1034     end.
     1035   end.
     1036   end .
     1037   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1038   procedure gen-b-code :
     1039     define input  parameter type-code like ub.code-range.range-type no-undo .
     1040     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     1041     do
     1042     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1043     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     1044     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     1045     :
     1046       define buffer buf_thbj-attr     for ub.thbj-attr .
     1047       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     1048       define buffer buf_code-range for ub.code-range .
     1049       define variable l-code         as   integer              no-undo .
     1050       define variable v-db-num       like ub.db.db-num         no-undo .
     1051       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1052       if type-code = 'sslc':U
     1053       or type-code = 'ssgb':U
     1054       then do:
     1055         message
     1056           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     1057           "Обратитесь к администратору системы."
     1058           view-as alert-box error .
     1059         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     1060       end.
     1061       run trg/getpcode.p ( input  type-code
     1062                      ,output cfg-param-code
     1063                     ).
     1064       run get-next-seq( input  type-code,
     1065                         output l-code
     1066                       ).
     1067       find first buf_sys-ctrl no-lock.
     1068       if type-code = 'sclc':U
     1069       or type-code = 'pglc':U
     1070       then do:
     1071         assign
     1072           v-db-num = 0
     1073         .
     1074       end.
     1075       else do:
     1076         assign
     1077           v-db-num = buf_sys-ctrl.db-num
     1078         .
     1079       end.
     1080       find first buf_code-range no-lock
     1081         where buf_code-range.db-num     = v-db-num
     1082           and buf_code-range.range-type = type-code
     1083           and buf_code-range.stts       = "a"
     1084         use-index stts
     1085         no-error .
     1086       if available buf_code-range
     1087          and l-code <= buf_code-range.last-code
     1088          and l-code >= buf_code-range.first-code then do:
     1089         assign
     1090           p-b-code = l-code
     1091         .
     1092       end.
     1093       else do:
     1094         if available buf_code-range
     1095            and l-code < buf_code-range.last-code then do:
     1096           message
     1097             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     1098             "Обратитесь к администратору системы."
     1099             view-as alert-box error .
     1100           undo, return error "sequence":U .
     1101         end.
     1102         do transaction
     1103         on error undo, return error
     1104         :
     1105           find first buf_thbj-attr exclusive-lock
     1106             where buf_thbj-attr.upper-prop-code = 'code-range':U
     1107               and buf_thbj-attr.prop-code = cfg-param-code
     1108               and buf_thbj-attr.obj-type   = 'БД':U
     1109               and buf_thbj-attr.obj-code   = v-db-num
     1110             no-error .
     1111           if not available buf_thbj-attr then do:
     1112             find first buf_thbj-attr exclusive-lock
     1113               where buf_thbj-attr.upper-prop-code = 'code-range':U
     1114                 and buf_thbj-attr.prop-code = cfg-param-code
     1115                 and buf_thbj-attr.obj-type   = ''
     1116                 and buf_thbj-attr.obj-code   = 0
     1117               no-error .
     1118             if not available buf_thbj-attr then do:
     1119               if not locked buf_thbj-attr then do:
     1120                 message
     1121                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     1122                   "Обратитесь к администратору системы."
     1123                   view-as alert-box error .
     1124               end.
     1125               undo, return error "config":U .
     1126             end.
     1127           end.
     1128           run get-next-seq( input type-code,
     1129                             output l-code
     1130                           ).
     1131           find first buf_code-range
     1132             where buf_code-range.db-num     = v-db-num
     1133               and buf_code-range.range-type = type-code
     1134               and buf_code-range.stts       = "a"
     1135             use-index stts
     1136             no-error .
     1137           if available buf_code-range
     1138           and l-code <= buf_code-range.last-code
     1139           and l-code >= buf_code-range.first-code
     1140           then do:
     1141             assign
     1142               p-b-code = l-code
     1143             .
     1144           end.
     1145           else do:
     1146             if available buf_code-range then do:
     1147               assign
     1148                 buf_code-range.stts = "u"
     1149               .
     1150             end.
     1151             find first buf_code-range
     1152               where buf_code-range.db-num     = v-db-num
     1153                 and buf_code-range.range-type = type-code
     1154                 and buf_code-range.stts       = "f"
     1155               use-index stts
     1156               no-error .
     1157             if not available buf_code-range then do:
     1158               message
     1159                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     1160                 "Обратитесь к администратору системы"
     1161                 view-as alert-box error .
     1162               undo, return error "code-range":U .
     1163             end.
     1164             assign
     1165               buf_code-range.stts           = "a"
     1166             .
     1167             if buf_code-range.first-code = 1 then do:
     1168               run set-seq-cr( input type-code,
     1169                               input buf_code-range.first-code
     1170                             ).
     1171               assign
     1172                 p-b-code = 1
     1173               .
     1174             end.
     1175             else do:
     1176               run set-seq-cr( input type-code,
     1177                               input ( buf_code-range.first-code - 1 )
     1178                             ).
     1179               run get-next-seq( input type-code,
     1180                                 output p-b-code
     1181                               ).
     1182             end.
     1183           end.
     1184         end.
     1185       end.
     1186     end.
     1187   end procedure.
     1188   procedure get-next-seq :
     1189     define input  parameter type-code like ub.code-range.range-type no-undo .
     1190     define output parameter next-seq  as   integer                  no-undo .
     1191     do
     1192     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1193     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     1194     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     1195     :
     1196       case type-code:
     1197         when 'bcgb':U then do:
     1198           assign
     1199             next-seq = next-value(s-bcgb-code, ub)
     1200           .
     1201         end.
     1202         when 'scgb':U then do:
     1203           assign
     1204             next-seq = next-value(s-scgb-code, ub)
     1205           .
     1206         end.
     1207         when 'sclc':U then do:
     1208           assign
     1209             next-seq = next-value(s-sclc-code, ub)
     1210           .
     1211         end.
     1212         when 'pglc':U then do:
     1213           assign
     1214             next-seq = next-value(s-pglc-code, ub)
     1215           .
     1216         end.
     1217         when 'dcgb':U then do:
     1218           assign
     1219             next-seq = next-value(s-dcgb-code, ub)
     1220           .
     1221         end.
     1222         when 'ctgb':U then do:
     1223           assign
     1224             next-seq = next-value(s-ctgb-code, ub)
     1225           .
     1226         end.
     1227         when 'drgb':U then do:
     1228           assign
     1229             next-seq = next-value(s-drgb-code, ub)
     1230           .
     1231         end.
     1232         when 'fmgb':U then do:
     1233           assign
     1234             next-seq = next-value(s-fmgb-code, ub)
     1235           .
     1236         end.
     1237         when 'pngb':U then do:
     1238           assign
     1239             next-seq = next-value(s-pngb-code, ub)
     1240           .
     1241         end.
     1242         when 'cagb':U then do:
     1243           assign
     1244             next-seq = next-value(s-cagb-code, ub)
     1245           .
     1246         end.
     1247         when 'fdgb':U then do:
     1248           assign
     1249             next-seq = next-value(s-fin-doc, ub)
     1250           .
     1251         end.
     1252       end case.
     1253     end.
     1254   end procedure.
     1255   procedure set-seq-cr :
     1256     define input parameter type-code like ub.code-range.range-type no-undo .
     1257     define input parameter set-val   like ub.code-range.first-code no-undo .
     1258     do
     1259     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1260     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     1261     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     1262     :
     1263       case type-code:
     1264         when 'bcgb':U then do:
     1265           assign
     1266             current-value(s-bcgb-code, ub) = set-val
     1267           .
     1268         end.
     1269         when 'scgb':U then do:
     1270           assign
     1271             current-value(s-scgb-code, ub) = set-val
     1272           .
     1273         end.
     1274         when 'sclc':U then do:
     1275           assign
     1276             current-value(s-sclc-code, ub) = set-val
     1277           .
     1278         end.
     1279         when 'pglc':U then do:
     1280           assign
     1281             current-value(s-pglc-code, ub) = set-val
     1282           .
     1283         end.
     1284         when 'dcgb':U then do:
     1285           assign
     1286             current-value(s-dcgb-code, ub) = set-val
     1287           .
     1288         end.
     1289         when 'ctgb':U then do:
     1290           assign
     1291             current-value(s-ctgb-code, ub) = set-val
     1292           .
     1293         end.
     1294         when 'drgb':U then do:
     1295           assign
     1296             current-value(s-drgb-code, ub) = set-val
     1297           .
     1298         end.
     1299         when 'fmgb':U then do:
     1300           assign
     1301             current-value(s-fmgb-code, ub) = set-val
     1302           .
     1303         end.
     1304         when 'pngb':U then do:
     1305           assign
     1306             current-value(s-pngb-code, ub) = set-val
     1307           .
     1308         end.
     1309         when 'cagb':U then do:
     1310           assign
     1311             current-value(s-cagb-code, ub) = set-val
     1312           .
     1313         end.
     1314         when 'fdgb':U then do:
     1315           assign
     1316             current-value(s-fin-doc, ub) = set-val
     1317           .
     1318         end.
     1319       end case.
     1320     end.
     1321   end procedure.
     1322   procedure new-bcod-gen-code-range :
     1323     do
     1324     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1325     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1326     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1327     :
     1328       define input parameter p-db-num  like ub.db.db-num             no-undo .
     1329       define input parameter type-code like ub.code-range.range-type no-undo .
     1330       define buffer buf_code-range      for ub.code-range .
     1331       define buffer last_code-range     for ub.code-range .
     1332       define buffer last-1_code-range   for ub.code-range .
     1333       define buffer last-2_code-range   for ub.code-range .
     1334       define buffer last-3_code-range   for ub.code-range .
     1335       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     1336       define variable conf-par       as character no-undo .
     1337       define variable par-type       as character no-undo .
     1338       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1339       define variable v-cre-cdrg as logical   no-undo .
     1340       define variable v-cre-str  as character no-undo .
     1341       define variable v-cr1      as integer no-undo .
     1342       define variable v-cr2      as integer no-undo .
     1343       define variable v-cr3      as integer no-undo .
     1344       define variable v-cmax     as integer no-undo .
     1345       find first buf_sys-ctrl no-lock .
     1346       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     1347         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     1348                                       ,vss-workfile
     1349                                       ,vss-revision
     1350                                       ,vss-description
     1351                                       ,chr(10)
     1352                                       , p-db-num
     1353                                      ).
     1354       end.
     1355       run trg/getpcode.p ( input  type-code
     1356                      ,output cfg-param-code
     1357                     ).
     1358       for each buf_code-range
     1359         where buf_code-range.db-num     = -1
     1360           and buf_code-range.range-type = type-code
     1361           and buf_code-range.stts       = "f"
     1362       by buf_code-range.first-code
     1363       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1364       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1365       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1366       :
     1367         assign
     1368           buf_code-range.db-num = p-db-num
     1369         .
     1370         return .
     1371       end.
     1372       assign
     1373         v-cre-cdrg = TRUE
     1374       .
     1375       case type-code:
     1376         when 'sclc':U
     1377         or when 'scgb':U
     1378         or when 'pglc':U
     1379         then do:
     1380           find last last-1_code-range no-lock
     1381             where last-1_code-range.range-type = 'sclc':U
     1382             no-error .
     1383           if available last-1_code-range then do:
     1384             v-cr1 = last-1_code-range.last-code.
     1385           end.
     1386           find last last-2_code-range no-lock
     1387             where last-2_code-range.range-type = 'scgb':U
     1388             no-error .
     1389           if available last-2_code-range then do:
     1390             v-cr2 = last-2_code-range.last-code.
     1391             end.
     1392           find last last-3_code-range no-lock
     1393             where last-3_code-range.range-type = 'pglc':U
     1394             no-error .
     1395           if available last-3_code-range then do:
     1396             v-cr3 = last-3_code-range.last-code.
     1397           end.
     1398           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1399           .
     1400           if v-cmax = v-cr1  then do:
     1401               find last last_code-range no-lock
     1402                 where recid( last_code-range ) = recid( last-1_code-range )
     1403                 .
     1404             end.
     1405           if v-cmax = v-cr2  then do:
     1406               find last last_code-range no-lock
     1407                 where recid( last_code-range ) = recid( last-2_code-range )
     1408                 .
     1409             end.
     1410           if v-cmax = v-cr3  then do:
     1411             find last last_code-range no-lock
     1412               where recid( last_code-range ) = recid( last-3_code-range )
     1413               .
     1414           end.
     1415           if last_code-range.last-code + 1 > 99999 then do:
     1416             assign
     1417               v-cre-cdrg = FALSE
     1418             .
     1419           end.
     1420         end.
     1421         when 'bcgb':U
     1422         or when 'sslc':U
     1423         or when 'ssgb':U
     1424         then do:
     1425           find last last-1_code-range no-lock
     1426             where last-1_code-range.range-type = 'sslc':U
     1427             no-error .
     1428           if available last-1_code-range then do:
     1429             v-cr1 = last-1_code-range.last-code.
     1430           end.
     1431           find last last-2_code-range no-lock
     1432             where last-2_code-range.range-type = 'bcgb':U
     1433             no-error .
     1434           if available last-2_code-range then do:
     1435             v-cr2 = last-2_code-range.last-code.
     1436             end.
     1437           find last last-3_code-range no-lock
     1438             where last-3_code-range.range-type = 'ssgb':U
     1439             no-error .
     1440           if available last-3_code-range then do:
     1441             v-cr3 = last-3_code-range.last-code.
     1442           end.
     1443           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1444           .
     1445           if v-cmax = v-cr1  then do:
     1446               find last last_code-range no-lock
     1447                 where recid( last_code-range ) = recid( last-1_code-range )
     1448                 .
     1449             end.
     1450           if v-cmax = v-cr2  then do:
     1451               find last last_code-range no-lock
     1452                 where recid( last_code-range ) = recid( last-2_code-range )
     1453                 .
     1454             end.
     1455           if v-cmax = v-cr3  then do:
     1456             find last last_code-range no-lock
     1457               where recid( last_code-range ) = recid( last-3_code-range )
     1458               .
     1459           end.
     1460         end.
     1461         otherwise do:
     1462           find last last_code-range no-lock
     1463             where last_code-range.range-type = type-code
     1464             no-error .
     1465         end.
     1466       end case.
     1467       if not available last_code-range then do:
     1468         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     1469                                       ,vss-workfile
     1470                                       ,vss-revision
     1471                                       ,vss-description
     1472                                       , chr(10)
     1473                                       , type-code
     1474                                      ) .
     1475       end.
     1476       define variable v-mes6 as character no-undo .
     1477       define variable v-param-type6 as character no-undo .
     1478       define variable v-value-character6 as INTEGER no-undo .
     1479       define variable v-value-date6 as date no-undo .
     1480       define variable v-value-decimal6 as decimal no-undo .
     1481       define variable v-value-integer6 AS integer no-undo .
     1482       define variable v-value-logical6 AS LOGICAL no-undo .
     1483       define variable v-tth6 as handle no-undo .
     1484       run adm/shattri.p (
     1485           input "get":U
     1486           ,input  'БД':U
     1487           ,input  p-db-num
     1488           ,input  'code-range':U
     1489           ,input  cfg-param-code
     1490           ,output v-value-character6
     1491           ,output v-value-date6
     1492           ,output v-value-decimal6
     1493           ,output v-value-integer6
     1494           ,output v-value-logical6
     1495           ,output v-param-type6
     1496           ,INPUT-OUTPUT table-handle v-tth6
     1497           ) no-error .
     1498       if error-status :error then do:
     1499         delete object v-tth6.
     1500         v-mes6 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     1501                            , error-status:get-message(1)
     1502                            , chr(10)
     1503                            , return-value ).
     1504         undo, return error v-mes6.
     1505       end.
     1506       delete object v-tth6.
     1507       if v-cre-cdrg = TRUE then do:
     1508         create buf_code-range .
     1509         assign
     1510           buf_code-range.db-num     = p-db-num
     1511           buf_code-range.range-type = type-code
     1512           buf_code-range.stts       = "f"
     1513           buf_code-range.first-code = last_code-range.last-code + 1
     1514           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer6)
     1515           v-cre-str = "Свободный диапазон успешно создан"
     1516         .
     1517       end.
     1518       else do:
     1519         assign
     1520           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     1521                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     1522         .
     1523       end.
     1524     end.
     1525     return v-cre-str .
     1526   end procedure.
     1527   procedure gen-new-code-range-if-neces :
     1528     define input parameter v-db-num           like ub.db.db-num             no-undo .
     1529     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     1530     define input parameter v-cur-code         as   integer                  no-undo .
     1531     define input parameter v-g#news           as   logical                  no-undo .
     1532     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     1533     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     1534     do
     1535     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1536     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     1537     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     1538     :
     1539       define variable l-code-range-exist as logical   no-undo init false .
     1540       define variable v-db-for-send      as character no-undo .
     1541       define buffer buf_code-range  for ub.code-range .
     1542       define buffer buf1_code-range for ub.code-range .
     1543       define buffer buf_db          for ub.db .
     1544       find first buf_code-range
     1545         where buf_code-range.range-type = v-range-type
     1546           and buf_code-range.last-code >= v-cur-code
     1547         use-index last-codei
     1548         no-error .
     1549       if
     1550       (
     1551          available buf_code-range
     1552          and
     1553         (buf_code-range.db-num = v-db-num
     1554           and
     1555         buf_code-range.first-code <= v-cur-code
     1556         )
     1557       or
     1558         (
     1559           v-range-type = 'drgb':U
     1560           AND
     1561           v-cur-code = 0
     1562         )
     1563      )
     1564      then do:
     1565         assign
     1566           l-code-range-exist = true
     1567         .
     1568         if v-g#news
     1569         and buf_code-range.stts = "f" then do:
     1570           assign
     1571             buf_code-range.stts = "u"
     1572           .
     1573         end.
     1574       end.
     1575       if not l-code-range-exist
     1576          and v-g#news-source-db <> 0
     1577       then do:
     1578         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1579                                       ,vss-workfile
     1580                                       ,vss-revision
     1581                                       ,vss-description
     1582                                       ,chr(10)
     1583                                       ,v-db-num
     1584                                       ,v-range-type
     1585                                       ,v-cur-code
     1586                                      ).
     1587       end.
     1588       if (not l-code-range-exist
     1589           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1590          )
     1591       and ( not can-find (first buf1_code-range no-lock
     1592                           where buf1_code-range.db-num = v-db-num
     1593                             and buf1_code-range.range-type = v-range-type
     1594                             and buf1_code-range.stts = "f"
     1595                          )
     1596           )
     1597       then do:
     1598         if v-g#db-num = 0 then do:
     1599           run new-bcod-gen-code-range in this-procedure
     1600             (input v-db-num,
     1601              input v-range-type
     1602             ) no-error .
     1603           if error-status :error then do:
     1604             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1605                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1606                                           ,v-db-num
     1607                                           ,v-range-type
     1608                                           ,v-cur-code
     1609                                           ,chr(10)
     1610                                           ,error-status:get-message(1)
     1611                                           ,return-value
     1612                                          ).
     1613           end.
     1614         end.
     1615         else do:
     1616           if v-range-type = 'sclc':U
     1617           or v-range-type = 'pglc':U
     1618           then do:
     1619             assign
     1620               v-db-for-send = "":U
     1621             .
     1622             if v-g#db-num = 0 then do:
     1623               for each buf_db no-lock
     1624                 where buf_db.db-num > 0
     1625                   and buf_db.db-num <> v-g#news-source-db
     1626               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1627               :
     1628                 assign
     1629                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1630                 .
     1631               end.
     1632               assign
     1633                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1634               .
     1635             end.
     1636             else do:
     1637               if not v-g#news then do:
     1638                 assign
     1639                   v-db-for-send = "0":U
     1640                 .
     1641               end.
     1642             end.
     1643             run nws/cr-route.p ( input 'send-cmd':U
     1644                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1645                                  "code-range":U + chr(1) +
     1646                                  (if v-range-type = 'sclc':U
     1647                                   then string( current-value(s-sclc-code, ub))
     1648                                   else string( current-value(s-pglc-code, ub))
     1649                                   ) + chr(1) +
     1650                                   v-range-type)
     1651                           ,input ?
     1652                           ,input v-db-for-send
     1653                           ) no-error .
     1654             if error-status :error then do:
     1655               undo, return error return-value.
     1656             end.
     1657           end.
     1658         end.
     1659       end.
     1660     end.
     1661   end procedure.
     1662   procedure cre-loc-sc-code-range :
     1663     define input parameter v-cur-code as integer no-undo .
     1664   define input parameter p-cdrg-type as character no-undo .
     1665     do
     1666     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1667     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1668     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1669     :
     1670       define buffer buf_code-range for ub.code-range .
     1671       find first buf_code-range
     1672            where buf_code-range.range-type = p-cdrg-type
     1673              and buf_code-range.first-code >= v-cur-code
     1674            no-error .
     1675       if not available buf_code-range then do:
     1676         run new-bcod-gen-code-range in this-procedure
     1677           ( input 0,
     1678             input p-cdrg-type
     1679           ) no-error .
     1680         if error-status :error then do:
     1681           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1682                                          + "Код &2&1&3 &4"
     1683                                         , chr(10)
     1684                                         , v-cur-code
     1685                                         , error-status:get-message(1)
     1686                                         , return-value
     1687                                        ) .
     1688         end.
     1689       end.
     1690     end.
     1691   end procedure.
     1692   procedure mark-used-if-need :
     1693   define input parameter p-cur-code as integer no-undo .
     1694   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1695   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1696     do
     1697     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1698     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1699     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1700     :
     1701       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1702       define buffer buf_code-range for ub.code-range .
     1703       assign
     1704       v-db-num = if p-range-type = 'sclc':U
     1705                  then 0
     1706                  else p-db-num
     1707       .
     1708   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1709   define buffer locK-batchprocess7 for ub.batchprocess.
     1710   run gbl/lock-prc.p
     1711       (input 'lscc':U
     1712       ,input 0
     1713       ,input 0
     1714       ,input 0
     1715       ,input ""
     1716       ,input ""
     1717       ,input ""
     1718       ,input (
     1719               ",,,Вкл/выкл лок. вес. кодов"
     1720              )
     1721       ,input true
     1722       ,buffer lock-batchprocess7
     1723       ) no-error .
     1724     if error-status :error then do:
     1725       message
     1726         vss-workfile vss-revision vss-description skip
     1727         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1728         view-as alert-box error .
     1729       undo, return error .
     1730     end.
     1731       find first buf_code-range
     1732            where buf_code-range.range-type = p-range-type
     1733              and buf_code-range.first-code >= p-cur-code
     1734              and buf_code-range.last-code <= p-cur-code
     1735              and buf_code-range.db-num = v-db-num
     1736            no-error .
     1737       if not available buf_code-range then do:
     1738         message
     1739           vss-workfile vss-revision vss-description skip
     1740           "Ошибка при создании поиске диапазона" skip
     1741           "База данных" p-db-num skip
     1742           "Код" p-cur-code skip
     1743           "Тип" p-range-type
     1744           error-status :get-message(1) skip
     1745           return-value skip
     1746           view-as alert-box error .
     1747         undo, return error .
     1748       end.
     1749       if buf_code-range.stts = "f":U then do:
     1750         assign
     1751         buf_code-range.stts = "u":U
     1752         .
     1753       end.
     1754     end.
     1755   end procedure.
     1756   define new global shared variable g#attr-lib  as handle no-undo .
     1757   define variable v-attr-lib-variable as handle no-undo .
     1758   define  variable p-extra-to as integer no-undo .
     1759   define variable v-call-proc as handle no-undo.
     1760   define variable v-func-list as character no-undo.
     1761   v-call-proc = this-procedure:instantiating-procedure.
     1762   if valid-handle(v-call-proc) then do:
     1763     v-func-list = v-call-proc:INTERNAL-ENTRIES.
     1764     if can-do(v-func-list, "get-param") then do:
     1765       run value("get-param") in v-call-proc (output p-extra-to).
     1766     end.
     1767   end.
     1768   define variable v-today as date      no-undo.
     1769   define variable v-time  as integer   no-undo.
     1770   define variable glog as logical no-undo .
