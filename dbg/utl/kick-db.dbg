     1939     run cre-cli-grp in this-procedure ( "Свои объекты, фирмы" ) .
     1940     run cre-cli-grp in this-procedure ( "Производители и поставщики" ) .
     1941     run cre-cli-grp in this-procedure ( "Покупатели" ) .
     1942     run cre-cli-grp in this-procedure ( "Персонал" ) .
     1943     end.
     1944     run waitfram-show in this-procedure ("Инициализация клиентов").
     1945     if v-is-1c-erp then do:
     1946       run cre-cli2 in this-procedure .
     1947     end.
     1948     else do:
