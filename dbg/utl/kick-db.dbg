     1873      assign
     1874        buf_curr-bank.curr-code = 0
     1875        buf_curr-bank.exch-date = v-today
     1876      .
     1877   end.
     1878   assign
     1879     buf_curr-bank.exch-rate = 1
     1880     buf_curr-bank.exch-scale = 1
     1881   no-error.
