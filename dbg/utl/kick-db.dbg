     1954     run waitfram-show in this-procedure ("Инициализация групп клиентов" ) .
     1955     run cre-cli-grp in this-procedure ( "Группа по умолчанию" ) .
     1956     end.
     1957   end.
     1958   if v-is-1c-erp then do:
     1959     run waitfram-show in this-procedure ("Инициализация видов оплаты").
     1960     run cre-pay-type in this-procedure ( 1, "Наличные" ) .
     1961     run cre-pay-type in this-procedure ( 2, "Безналичные" ) .
     1962     run cre-pay-type in this-procedure ( 3, "Возврат поставщику" ) .
     1963     run cre-pay-type in this-procedure ( 4, "Оплата по консигнации" ) .
     1964   end .
     1965   else do :
     1966     if p-sys-key <> "raimbek":U then do:
     1967     run waitfram-show in this-procedure ("Инициализация видов оплаты").
     1968     run cre-pay-type in this-procedure ( 1, "Наличные" ) .
     1969     run cre-pay-type in this-procedure ( 2, "Безналичные" ) .
     1970     run cre-pay-type in this-procedure ( 3, "Возврат поставщику" ) .
     1971     run cre-pay-type in this-procedure ( 4, "Кредит" ) .
     1972     run waitfram-show in this-procedure ("Инициализация МЦ").
     1973     run cre-wth in this-procedure ( 1, 0, YES, "Наличные", '=sum':U ) .
     1974     run waitfram-show in this-procedure ("Инициализация типов кассовых платежей").
     1975     run cre-cash-pay in this-procedure (  1, 0, 1, 1, "Наличные",          TRUE, FALSE ) .
     1976     run cre-cash-pay in this-procedure ( 20, 0, 1, 0, "Оплата по кредиту", FALSE, TRUE ).
     1977     end.
     1978     else do:
     1979     run waitfram-show in this-procedure ("Инициализация видов оплаты").
     1980     run cre-pay-type in this-procedure ( 4, "Наличные" ) .
     1981     run cre-pay-type in this-procedure ( 5, "Безналичные" ) .
     1982     end.
     1983   end .
     1984   if v-is-1c-erp then do:
     1985     run waitfram-show in this-procedure ("Причины создания документов").
     1986     run cre-trn-reason in this-procedure (19, "Истечение срока годности (кафе)") .
     1987     run cre-trn-reason in this-procedure (20, "Потеря товарного вида актуальности (товары)") .
     1988     run cre-trn-reason in this-procedure (22, "Зачистка резервуара (топлива)") .
     1989     run cre-trn-reason in this-procedure (23, "Возврат товара поставщику") .
     1990     run cre-trn-reason in this-procedure (24, "Ввод первоначальных остатков") .
     1991     dynamic-current-value( "s-trn-reason":U, LDBNAME("DICTDB":U) ) = 24 .
     1992   end .
     1993   run waitfram-show in this-procedure ("Инициализация критериев анализа ABC и XYZ").
     1994     run utl/abc-utl.p  .
     1995   run waitfram-show in this-procedure ("Инициализация глобальных настроек ценообразования").
     1996   for each buf_global-state exclusive-lock :
     1997       delete buf_global-state.
     1998   end.
     1999       create buf_global-state.
     2000       assign
     2001         buf_global-state.db-num-chg = 1
     2002       .
     2003   run waitfram-show in this-procedure ("Инициализация настроек опций истории и маршрутизации").
     2004   do:
     2005   define variable v-codes1 as character no-undo .
     2006   define variable v-labels1 as character no-undo .
     2007   define variable v-groups1 as character no-undo .
     2008   assign
     2009   v-codes1 = 'goods':U + chr(4) + 'gds-obj-attr':U + chr(4) +
     2010             'gds-host-attr':U + chr(4) + 'goods-attr':U + chr(4) +
     2011             'fbr-gds-obj':U + chr(4) + 's-coeff':U + chr(4) +
     2012             'prod-bc':U + chr(4) + 'bar-code':U + chr(4) +
     2013             'varianty-delivery-gds-obj':U + chr(4) + 'gds-season':U + chr(4) +
     2014             'dis-gds-rule':U + chr(4) + 'assortment-matrix-goods':U + chr(4) +
     2015             'gds-obj-prop':U + chr(4) + 'ext-artic':U
     2016   v-labels1 = 'Товар':U + chr(4) + 'Атр-т тов. на объекте':U + chr(4) +
     2017           'Атр-т тов. на фирме':U + chr(4) + 'Атр-т товара':U + chr(4) +
     2018           'Атрибут РЕСТОРАНа':U + chr(4) + 'Сезонный коэфф':U + chr(4) +
     2019           'ДопБК':U + chr(4) + 'Бар-код':U + chr(4) +
     2020           'Варианты доставки':U + chr(4) + 'Сезон товара':U + chr(4) +
     2021           'Скидка Товара на объ.':U + chr(4) + 'Содержимое ассортиментных матр':U + chr(4) +
     2022           'Индикаторы':U + chr(4) + 'Внешний артикул товара':U
     2023   v-groups1 = fill(('goods':U + chr(4)), num-entries(v-codes1, chr(4) ) )
     2024   .
     2025   run create-hist-nws-option in this-procedure ( input v-codes1
     2026                                                 ,input v-labels1
     2027                                                 ,input v-groups1) .
     2028   assign
     2029   v-codes1 = 'cash-pay':U + chr(4) + 'cash-pay-attr':U + chr(4) + 'dis-cp-rule':U
     2030   v-labels1 = 'Касс.платеж':U + chr(4) + 'Аттр.касс.пл-жа':U + chr(4) + 'Скидки на платеж':U
     2031   v-groups1 = fill(('cash-pay':U + chr(4)), num-entries(v-codes1, chr(4) ) )
     2032   v-groups1 = right-trim(v-groups1, chr(4) )
     2033   .
     2034   run create-hist-nws-option in this-procedure ( input v-codes1
     2035                                                 ,input v-labels1
     2036                                                 ,input v-groups1) .
     2037   assign
     2038   v-codes1 = 'cash-desk':U + chr(4) + 'cash-desk-attr':U
     2039   v-labels1 = 'Касса':U + chr(4) + 'Аттр.кассы':U
     2040   v-groups1 = fill(('cash-desk':U + chr(4)), num-entries(v-codes1, chr(4) ) )
     2041   v-groups1 = right-trim(v-groups1, chr(4) )
     2042   .
     2043   run create-hist-nws-option in this-procedure ( input v-codes1
     2044                                                 ,input v-labels1
     2045                                                 ,input v-groups1) .
     2046   assign
     2047   v-codes1 = 'ext-classif':U
     2048   v-labels1 = 'Внешний классификатор':U
     2049   v-groups1 = fill(('ext-classif':U + chr(4)), num-entries(v-codes1, chr(4) ) )
     2050   v-groups1 = right-trim(v-groups1, chr(4) )
     2051   .
     2052   run create-hist-nws-option in this-procedure ( input v-codes1
     2053                                                 ,input v-labels1
     2054                                                 ,input v-groups1) .
     2055   assign
     2056   v-codes1 = 'contract-specif':U
     2057   v-labels1 = 'Спецификация к дог-ру':U
     2058   v-groups1 = fill(('contract-specif':U + chr(4)), num-entries(v-codes1, chr(4) ) )
     2059   v-groups1 = right-trim(v-groups1, chr(4) )
     2060   .
     2061   run create-hist-nws-option in this-procedure ( input v-codes1
     2062                                                 ,input v-labels1
     2063                                                 ,input v-groups1) .
     2064   end.
     2065   if not v-is-1c-erp then do:
     2066   run waitfram-show in this-procedure ("Заполнение справочника регионов РФ").
     2067   run utl/reg-cre.p.
     2068   run waitfram-show in this-procedure ("Создание кассовой книги по основному виду деятельности.").
     2069   run cre-CashBook in this-procedure .
     2070   end.
     2071   run waitfram-hide in this-procedure .
     2072   message "Инициализация закончена.".
     2073   procedure cre-unit:
     2074   def input param u-n as char no-undo.
     2075   def input param l-n as char no-undo.
     2076   def input param tp as char no-undo.
     2077     find buf_units where buf_units.unit-name = u-n no-error.
     2078     if not avail buf_units then do:
     2079         find buf_units where buf_units.unit-name = (u-n + ".") no-error.
     2080     end.
     2081     if available buf_units then do:
     2082       if buf_units.type = "" then do:
     2083         message
     2084         "Для единицы измерения:" buf_units.unit-name "тип не задан." "Подставляем:" tp skip (2)
     2085         "Внимание!!! Проверьте все остальные единицы измерения. Возможно, Вы забыли запустить утилиту:"
     2086         "Администратор / Утилиты / Смена версии / Типы единиц измерения. Это может привести к серьезным ошибкам в работе системы!".
     2087         buf_units.type = tp.
     2088       end.
     2089       if buf_units.type <> tp then do:
     2090         message
     2091         "Для единицы измерения:" buf_units.unit-name "тип:" buf_units.type "не совпадает с рекомендуемым:" tp skip (2)
     2092         "Это может привести к серьезным ошибкам в работе системы! Тип заменяется на рекомендуемый"
     2093         view-as alert-box WARNING.
     2094         buf_units.type = tp.
     2095       end.
     2096     end.
     2097     else do:
     2098       create buf_units.
     2099       assign
     2100         buf_units.unit-name = u-n
     2101         buf_units.long-name = l-n
     2102         buf_units.type = tp
     2103         buf_units.stts = 0.
     2104     end.
     2105   end procedure.
     2106   procedure import-countries private:
     2107   define input parameter p-country-path as character no-undo .
     2108   define buffer buf_country for DICTDB.country .
     2109     input from value(p-country-path).
     2110     empty temp-table for-country.
     2111     _repeat:
     2112     REPEAT:
     2113         CREATE for-country.
     2114         IMPORT for-country NO-ERROR.
     2115         if error-status:error then next _repeat.
     2116         if for-country.alpha1 = '':U then do:
     2117           delete for-country.
     2118           next _repeat.
     2119         end.
     2120         IF NOT (CAN-FIND(FIRST DICTDB.country where DICTDB.country.num-code = for-country.num-code) OR
     2121                 CAN-FIND(FIRST DICTDB.country where DICTDB.country.alpha1   = for-country.alpha1))
     2122                     and for-country.num-code > 0
     2123         then do:
     2124             create buf_country.
     2125             ASSIGN
     2126               buf_country.alpha1     = for-country.alpha1
     2127               buf_country.alpha2     = for-country.alpha2
     2128               buf_country.long-name  = for-country.long-name
     2129               buf_country.num-code   = for-country.num-code
     2130               buf_country.short-name = for-country.short-name
     2131             .
     2132         end.
     2133         delete for-country.
     2134     END.
     2135     empty temp-table for-country.
     2136     INPUT CLOSE.
     2137   end procedure.
     2138   procedure cre-tax:
     2139   def input param taxcode like DICTDB.tax.tax-code no-undo.
     2140   def input param l-n as char no-undo.
     2141   def input param tp as char no-undo.
     2142   def input param tocashdesk as logical no-undo.
     2143   def input param unittypes as char no-undo.
     2144   def input param individ like DICTDB.tax.individual no-undo.
     2145   DEFINE VARIABLE jj         as integer no-undo .
     2146   DEFINE VARIABLE vunit-type like DICTDB.units.type no-undo .
     2147   DEFINE VARIABLE p1         as logical no-undo .
     2148   DEFINE VARIABLE p2         as logical no-undo .
     2149   define buffer buf_tax               for DICTDB.tax .
     2150   define buffer b_tax-unit for DICTDB.tax-units.
     2151     find buf_tax where buf_tax.tax-code = taxcode no-error.
     2152     if available buf_tax then do:
     2153       if buf_tax.tax-type = "" then do:
     2154         message "Для налога:" buf_tax.tax-name "тип не задан." "Подставляем:" tp
     2155                         .
     2156         buf_tax.tax-type = tp.
     2157       end.
     2158       if buf_tax.tax-type <> tp then do:
     2159         message
     2160         "Для налога:" buf_tax.tax-name "тип:" buf_tax.tax-type "не совпадает с рекомендуемым:" tp skip (2)
     2161         "Это может привести к серьезным ошибкам в работе системы! Тип заменяется на рекомендуемый"
     2162         view-as alert-box WARNING.
     2163         buf_tax.tax-type = tp.
     2164       end.
     2165       if buf_tax.to-cashdesk <> tocashdesk then do:
     2166         message
     2167         "Для налога:" buf_tax.tax-name "флаг ~"отправлять на кассу~":" buf_tax.to-cashdesk "не совпадает с рекомендуемым:" tocashdesk skip (2)
     2168         "Значение флага ~"отправлять на кассу~" заменено на:" tocashdesk
     2169         view-as alert-box WARNING.
     2170         buf_tax.to-cashdesk = tocashdesk .
     2171       end.
     2172       do jj = 1 to num-entries(unittypes):
     2173         assign
     2174         vunit-type =entry(jj, unittypes)
     2175         p1 = no
     2176         p2 = no
     2177         .
     2178         find first b_tax-unit No-LOCK WHERE
     2179                             b_tax-unit.tax-code = taxcode AND
     2180                             b_tax-unit.type = vunit-type AND
     2181                             unittypes <> 'сте':U no-error.
     2182         if not avail b_tax-unit then p1 = yes.
     2183         IF can-find(first b_tax-unit No-LOCK WHERE
     2184                           b_tax-unit.tax-code = taxcode AND
     2185                           LOOKUP(b_tax-unit.type, unittypes) = 0 )
     2186                     AND
     2187         unittypes <> 'сте':U then do:
     2188           p2 = yes.
     2189         end.
     2190        glog = yes.
     2191        if p1 or p2 then do:
     2192           message
     2193           "Для налога:" buf_tax.tax-name "типы единиц измерения: не совпадают с рекомендуемыми:" unittypes skip (2)
     2194           "Это может привести к серьезным ошибкам в работе системы! Тип заменяется на рекомендуемый"
     2195           view-as alert-box WARNING.
     2196           if p1 then do:
     2197               run add-tax-units in this-procedure (taxcode, vunit-type).
     2198           end.
     2199           if p2 then do:
     2200             FOr each b_tax-unit where
     2201                     b_tax-unit.tax-code = taxcode AND
     2202                     LOOKUP(b_tax-unit.type, unittypes) = 0:
     2203               delete b_tax-unit.
     2204             end.
     2205           end.
     2206         end.
     2207       end.
     2208     end.
     2209     else do:
     2210       create buf_tax.
     2211       assign
     2212         buf_tax.tax-code = taxcode
     2213         buf_tax.tax-name = l-n
     2214         buf_tax.tax-type = tp
     2215         buf_tax.to-cashdesk = tocashdesk
     2216         buf_tax.individual = individ
     2217         buf_tax.status_ = 'тек':U
     2218         .
     2219       _jj:
     2220       do jj = 1 to num-entries(unittypes):
     2221         vunit-type =entry(jj, unittypes).
     2222         if not (vunit-type = 'шту':U  OR
     2223                 vunit-type = 'дро':U OR
     2224                 vunit-type = 'сер':U OR
     2225                 vunit-type = 'вес':U OR
     2226                 vunit-type = 'топ':U
     2227                     )  then do:
     2228             NEXT _JJ.
     2229           end.
     2230         run add-tax-units in this-procedure (taxcode, vunit-type).
     2231       END.
     2232     end.
     2233   end procedure.
     2234   procedure cre-tax-rate:
     2235   def input param taxcode  like DICTDB.tax.tax-code       no-undo.
     2236   def input param ratecode like DICTDB.tax-rate.rate-code no-undo.
     2237   def input param ratename like DICTDB.tax-rate.rate-name no-undo.
     2238   define buffer buf_tax-rate          for DICTDB.tax-rate .
     2239     find buf_tax-rate where buf_tax-rate.rate-code = ratecode no-error.
     2240     if available buf_tax-rate then do:
     2241       if NOT buf_tax-rate.tax-code = taxcode then do:
     2242         message "Для ставки налога с кодом " buf_tax-rate.rate-code "код категории налога не совпадает с рекомендуемым." skip
     2243         "Подставляем:" taxcode
     2244         view-as alert-box.
     2245                         .
     2246         buf_tax-rate.tax-code = taxcode.
     2247       end.
     2248     end.
     2249     else do:
     2250       create buf_tax-rate.
     2251       assign
     2252         buf_tax-rate.tax-code = taxcode
     2253         buf_tax-rate.rate-code = ratecode
     2254         buf_tax-rate.rate-name = ratename
     2255         buf_tax-rate.status_ = 'тек':U
     2256         .
     2257     end.
     2258   end procedure.
     2259   procedure cre-tax-rate-value:
     2260   def input param taxcode   like DICTDB.tax.tax-code              no-undo.
     2261   def input param ratecode  like DICTDB.tax-rate.rate-code        no-undo.
     2262   def input param ratevalue like DICTDB.tax-rate-value.rate-value no-undo.
     2263   def input param p-today   as date no-undo .
     2264   def input param p-time    as integer no-undo .
     2265   DEFINE VARIABLE var-day-end-fact-order as decimal no-undo .
     2266   define buffer buf_tax-rate-value    for DICTDB.tax-rate-value .
     2267     run factord-end-day in this-procedure (input p-today, output var-day-end-fact-order).
     2268     find LAST  buf_tax-rate-value where
     2269                buf_tax-rate-value.rate-code   = ratecode  AND
     2270                buf_tax-rate-value.tax-code    = taxcode AND
     2271                buf_tax-rate-value.host-code   = 0 AND
     2272                buf_tax-rate-value.obj-type    = "" AND
     2273                buf_tax-rate-value.obj-code    = 0 AND
     2274                buf_tax-rate-value.fact-order <= var-day-end-fact-order
     2275                no-error.
     2276     if not avail buf_tax-rate-value then do:
     2277       create buf_tax-rate-value.
     2278       assign
     2279         buf_tax-rate-value.tax-code = taxcode
     2280         buf_tax-rate-value.rate-code = ratecode
     2281         buf_tax-rate-value.rate-value = ratevalue
     2282         buf_tax-rate-value.fact-date  = p-today
     2283         buf_tax-rate-value.fact-order = var-day-end-fact-order
     2284         buf_tax-rate-value.status_ = 'тек':U
     2285         buf_tax-rate-value.host-code = 0
     2286         buf_tax-rate-value.obj-type = "":U
     2287         buf_tax-rate-value.obj-code = 0
     2288         buf_tax-rate-value.corr-date = p-today
     2289         buf_tax-rate-value.corr-time = p-time
     2290         buf_tax-rate-value.corr-user-db-num = v-cntxt-db-num
     2291         buf_tax-rate-value.corr-user-name = v-cntxt-userid
     2292         .
     2293     end.
     2294   end procedure.
     2295   procedure cre-tax-rate-attr:
     2296   def input param taxcode  like DICTDB.tax.tax-code       no-undo.
     2297   def input param ratecode like DICTDB.tax-rate.rate-code no-undo.
     2298   define buffer buf_tax-rate-attr          for DICTDB.tax-rate-attr .
     2299     find buf_tax-rate-attr where buf_tax-rate-attr.rate-code = ratecode no-error.
     2300     if available buf_tax-rate-attr then do:
     2301       if NOT buf_tax-rate-attr.tax-code = taxcode then do:
     2302         message "Для ставки налога с кодом " buf_tax-rate-attr.rate-code "уже есть атрибут ЕНВД." skip
     2303         "Подставляем:" taxcode
     2304         view-as alert-box.
     2305                         .
     2306         buf_tax-rate-attr.tax-code = taxcode.
     2307       end.
     2308     end.
     2309     else do:
     2310       create buf_tax-rate-attr.
     2311       assign
     2312         buf_tax-rate-attr.tax-code = taxcode
     2313         buf_tax-rate-attr.rate-code = ratecode
     2314         buf_tax-rate-attr.attr-code = "envd"
     2315         .
     2316     end.
     2317   end procedure.
     2318   PROCEDURE add-tax-units:
     2319   define input parameter partax-code  like DICTDB.tax.tax-code no-undo .
     2320   define input parameter parunit-type like DICTDB.units.type   no-undo .
     2321   define buffer buf_tax-units         for DICTDB.tax-units .
     2322     if not can-find(first buf_tax-units No-LOCK WHERE
     2323                           buf_tax-units.tax-code = partax-code AND
     2324                           buf_tax-units.type = parunit-type) then do:
     2325       create buf_tax-units.
     2326       assign
     2327         buf_tax-units.tax-code = partax-code
     2328         buf_tax-units.type = parunit-type
     2329       .
     2330     END.
     2331   END PROCEDURE.
     2332   procedure add-tax-gds-grp :
     2333   DEFINE VARIABLE var-vat-code as character no-undo .
     2334   DEFINE VARIABLE var-SLT-code as character no-undo .
     2335   DEFINE VARIABLE vattr-labels as character no-undo .
     2336   DEFINE VARIABLE vattr-codes as character no-undo .
     2337   DEFINE VARIABLE vartax-value like DICTDB.tax-rate-value.rate-value no-undo .
     2338   define variable VATtaxcd as integer no-undo.
     2339   define variable SLTtaxcd as integer no-undo.
     2340   define buffer buf_tax-rate-gds-grp  for DICTDB.tax-rate-gds-grp .
     2341   vattaxcd = integer('1':U).
     2342   slttaxcd = integer('2':U).
     2343   if p-sys-key <> "raimbek":U then do:
     2344     assign
     2345     vattr-codes = "":U
     2346     vattr-labels = "":U
     2347     .
     2348     for each DICTDB.tax-rate no-lock where
     2349              DICTDB.tax-rate.tax-code = vattaxcd:
     2350   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2351   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     2352     (input  recid(DICTDB.tax-rate)
     2353     ,input  DICTDB.tax-rate.tax-code
     2354     ,input  DICTDB.tax-rate.rate-code
     2355     ,input  ?
     2356     ,input  0
     2357     ,input  '':U
     2358     ,input  0
     2359     ,output vartax-value
     2360     ) no-error .
     2361       if error-status:error then do:
     2362         message return-value view-as alert-box error .
     2363         return error return-value.
     2364       end.
     2365       if vartax-value = ? then NEXT.
     2366       if v-is-1c-erp then do:
     2367         var-vat-code = string(tax-rate.rate-code) .
     2368         leave .
     2369       end.
     2370       else assign
     2371       vattr-labels = vattr-labels +
     2372                     (if vattr-labels = "":U then "" else chr(44)) +
     2373                     string(string(tax-rate.rate-code) + " - " + replace(tax-rate.rate-name, chr(44), "":U), "X(25)") +
     2374                     fill(chr(32), 5) + string(vartax-value, "99.99%":U)
     2375       vattr-codes = vattr-codes +
     2376                     (if vattr-codes = "":U then "" else chr(44)) +
     2377                     string(tax-rate.rate-code)
     2378       .
     2379     end.
     2380     if not v-is-1c-erp then do:
     2381       run gbl/d-list.w (
     2382                   INPUT "b-sel":U
     2383                   ,INPUT "Выберите ставку НДС для групп (по умолчанию)"
     2384                   ,INPUT vattr-codes
     2385                   ,INPUT vattr-labels
     2386                   ,INPUT chr(44)
     2387                   ,INPUT "":U
     2388                   ,output var-vat-code).
     2389       IF var-vat-code = "":u THEN do:
     2390       message
     2391       "Вы не выбрали ставку НДС для групп!" skip
     2392       "Это может привести к непредсказуемым результатам"
     2393       view-as alert-box error .
     2394       RETURN ERROR.
     2395       end.
     2396     end.
     2397   end.
     2398   assign
     2399   vattr-codes = "":U
     2400   vattr-labels = "":U
     2401   .
     2402   for each tax-rate no-lock where
     2403            tax-rate.tax-code = slttaxcd:
     2404   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     2406     (input  recid(tax-rate)
     2407     ,input  tax-rate.tax-code
     2408     ,input  tax-rate.rate-code
     2409     ,input  ?
     2410     ,input  0
     2411     ,input  '':U
     2412     ,input  0
     2413     ,output vartax-value
     2414     ) no-error .
     2415     if error-status:error then do:
     2416       message
     2417       return-value view-as alert-box error .
     2418       return error.
     2419     end.
     2420     if vartax-value = ? then NEXT.
     2421     if v-is-1c-erp then do:
     2422       var-slt-code = string(tax-rate.rate-code) .
     2423       leave .
     2424     end.
     2425     else assign
     2426     vattr-labels = vattr-labels +
     2427                   (if vattr-labels = "":U then "" else chr(44)) +
     2428                   string(string(tax-rate.rate-code) + " - " + replace(tax-rate.rate-name, chr(44), "":U), "X(25)") +
     2429                   fill(chr(32), 5) + string(vartax-value, "99.99%":U)
     2430     vattr-codes = vattr-codes +
     2431                   (if vattr-codes = "":U then "" else chr(44)) +
     2432                   string(tax-rate.rate-code)
     2433     .
     2434   end.
     2435   if not v-is-1c-erp then do:
     2436     run gbl/d-list.w (
     2437                 INPUT "b-sel":U
     2438                 ,INPUT "Выберите ставку НП для групп (по умолчанию)(если НП не действует, выберите знач=0)"
     2439                 ,INPUT vattr-codes
     2440                 ,INPUT vattr-labels
     2441                 ,INPUT chr(44)
     2442                 ,INPUT "":U
     2443                 ,output var-slt-code).
     2444     IF var-slt-code = "":u THEN do:
     2445     message
     2446     "Вы не выбрали ставку НП для групп!" skip
     2447     "Это может привести к непредсказуемым результатам"
     2448     view-as alert-box error .
     2449     RETURN ERROR.
     2450     end.
     2451   end .
     2452   do on error undo, return error :
     2453     FOR EACH DICTDB.gds-grp No-LOCK:
     2454       if p-sys-key <> "raimbek":U then do:
     2455         if not can-find(first buf_tax-rate-gds-grp where
     2456                               buf_tax-rate-gds-grp.tax-code = vattaxcd AND
     2457                               buf_tax-rate-gds-grp.node-code = DICTDB.gds-grp.node-code AND
     2458                               buf_tax-rate-gds-grp.host-code = 0 AND
     2459                               buf_tax-rate-gds-grp.obj-type = "":U AND
     2460                               buf_tax-rate-gds-grp.obj-code = 0
     2461                               ) then do:
     2462           create buf_tax-rate-gds-grp.
     2463           assign
     2464             buf_tax-rate-gds-grp.node-code = DICTDB.gds-grp.node-code
     2465             buf_tax-rate-gds-grp.tax-code = vattaxcd
     2466             buf_tax-rate-gds-grp.rate-code = integer(var-vat-code)
     2467          .
     2468         end.
     2469       end.
     2470       if not can-find(first buf_tax-rate-gds-grp where
     2471                             buf_tax-rate-gds-grp.tax-code = slttaxcd AND
     2472                             buf_tax-rate-gds-grp.node-code = DICTDB.gds-grp.node-code AND
     2473                             buf_tax-rate-gds-grp.host-code = 0 AND
     2474                             buf_tax-rate-gds-grp.obj-type = "":U AND
     2475                             buf_tax-rate-gds-grp.obj-code = 0
     2476                             ) then do:
     2477         create buf_tax-rate-gds-grp.
     2478         assign
     2479            buf_tax-rate-gds-grp.node-code = DICTDB.gds-grp.node-code
     2480            buf_tax-rate-gds-grp.tax-code = slttaxcd
     2481            buf_tax-rate-gds-grp.rate-code = integer(var-slt-code)
     2482         .
     2483       end.
     2484     end.
     2485   end.
     2486   END PROCEDURE.
     2487   PROCEDURE get-rate-value:
     2488   define input parameter partax-code like DICTDB.tax.tax-code no-undo .
     2489   define input parameter parrate-code like DICTDB.tax-rate.rate-code no-undo .
     2490   define output parameter parrate-value like DICTDB.tax-rate-value.rate-value no-undo .
     2491   DEFINE VARIABLE var-fact-order as decimal no-undo .
     2492   define buffer buf_tax-rate-value    for DICTDB.tax-rate-value .
     2493      var-fact-order = integer(today) + 0.99.
     2494      FIND LAST buf_tax-rate-value No-LOCK WHERE
     2495               buf_tax-rate-value.tax-code = partax-code AND
     2496               buf_tax-rate-value.rate-code = parrate-code AND
     2497               buf_tax-rate-value.host-code = 0 AND
     2498               buf_tax-rate-value.obj-type = "" AND
     2499               buf_tax-rate-value.host-code = 0 AND
     2500               buf_tax-rate-value.fact-order <= var-fact-order No-ERROR.
     2501      if available buf_tax-rate-value then do:
     2502         assign
     2503            parrate-value = buf_tax-rate-value.rate-value
     2504         .
     2505      end.
     2506   END PROCEDURE.
     2507   procedure import-menu-grps :
     2508   define variable v-shift-node-code like DICTDB.fbr-gds-grp.node-code no-undo .
     2509   define buffer buf_fbr-gds-grp for DICTDB.fbr-gds-grp.
     2510     do
     2511     on error undo, return error
     2512     :
     2513       for each buf_fbr-gds-grp  where buf_fbr-gds-grp.node-code <> 1 no-lock:
     2514         assign
     2515         v-shift-node-code =  buf_fbr-gds-grp.node-code
     2516         .
     2517       end.
     2518       input from value(menu-grp-path).
     2519       for each temp_fbr-gds-grp:
     2520         delete temp_fbr-gds-grp.
     2521       end.
     2522       _repeat2:
     2523       REPEAT:
     2524           CREATE temp_fbr-gds-grp.
     2525           IMPORT temp_fbr-gds-grp.node-name temp_fbr-gds-grp.node-code temp_fbr-gds-grp.upper-code temp_fbr-gds-grp.lvl-num NO-ERROR.
     2526           if error-status:error then do:
     2527             delete temP_fbr-gds-grp.
     2528             next  _repeat2.
     2529           end.
     2530           if not error-status:error then do:
     2531             IF NOT CAN-FIND(FIRST buf_fbr-gds-grp where buf_fbr-gds-grp.node-code = (temp_fbr-gds-grp.node-code + v-shift-node-code)
     2532                                 and buF_fbr-gds-grp.obj-type      = "":U
     2533                                 AND buF_fbr-gds-grp.obj-code      = 0        )
     2534               AND ( temp_fbr-gds-grp.upper-code  = 1
     2535                   or
     2536                   CAN-FIND(FIRST buf_fbr-gds-grp where buf_fbr-gds-grp.NODE-code = temp_fbr-gds-grp.upper-code +  v-shift-node-code
     2537                                 and buF_fbr-gds-grp.obj-type      = "":U
     2538                                 AND buF_fbr-gds-grp.obj-code      = 0           )
     2539                     )
     2540             and not can-find(first buf_fbr-gds-grp where
     2541                                    buF_fbr-gds-grp.obj-type = "":U
     2542                                AND buF_fbr-gds-grp.obj-code      = 0
     2543                                and buF_fbr-gds-grp.upper-code = (if temp_fbr-gds-grp.upper-code  = 1
     2544                                                                 then 1
     2545                                                                 else  (temp_fbr-gds-grp.upper-code +  v-shift-node-code))
     2546                              and buf_fbr-gds-grp.node-name = temp_fbr-gds-grp.node-name)
     2547             then do:
     2548                 create buf_Fbr-gds-grp.
     2549                 ASSIGN
     2550                 buF_fbr-gds-grp.node-code     = temp_fbr-gds-grp.node-code  +  v-shift-node-code
     2551                 buf_fbr-gds-grp.upper-code    = (if temp_fbr-gds-grp.upper-code  = 1 then 1 else  (temp_fbr-gds-grp.upper-code +  v-shift-node-code))
     2552                 buF_fbr-gds-grp.node-name     = temp_fbr-gds-grp.node-name
     2553                 buF_fbr-gds-grp.obj-type      = "":U
     2554                 buF_fbr-gds-grp.obj-code      = 0
     2555                 buF_fbr-gds-grp.out-code      = temp_fbr-gds-grp.node-code
     2556                 buF_fbr-gds-grp.global-code   = temp_fbr-gds-grp.node-code
     2557                 buF_fbr-gds-grp.lvl-num       = temp_fbr-gds-grp.lvl-num
     2558                 .
     2559             end.
     2560           end.
     2561           delete temp_fbr-gds-grp.
     2562       END.
     2563       for each temp_fbr-gds-grp:
     2564         delete temp_fbr-gds-grp.
     2565       end.
     2566       INPUT CLOSE.
     2567     end.
     2568   end procedure.
     2569   define temp-table tt-db-hn like DICTDB.db
     2570   field hn-id as integer
     2571   index pi is unique primary
     2572   db-num
     2573   hn-id
     2574   .
     2575   procedure create-hist-nws-option :
     2576   define input parameter p-codes as character no-undo .
     2577   define input parameter p-labels as character no-undo .
     2578   define input parameter p-groups as character no-undo .
     2579   define variable v-ii as integer no-undo .
     2580   define buffer buf_hist-nws-option for DICTDB.hist-nws-option.
     2581   do
     2582   on error undo, return error
     2583   :
     2584     do v-ii = 1 to num-entries(p-codes, chr(4) ):
     2585       find first buf_hist-nws-option where
     2586             buf_hist-nws-option.db-num = buf_sys-ctrl.db-num
     2587         and buf_hist-nws-option.table-name = entry(v-ii, p-codes, chr(4) )  no-error.
     2588       if not available buf_hist-nws-option
     2589       then do:
     2590         find last tt-db-hn  where
     2591                 tt-db-hn.db-num = buf_sys-ctrl.db-num no-error.
     2592         create buf_hist-nws-option.
     2593         assign
     2594         buf_hist-nws-option.db-num =  buf_sys-ctrl.db-num
     2595         buf_hist-nws-option.hn-id  =  (if available tt-db-hn then tt-db-hn.hn-id + 1 else 1)
     2596         buf_hist-nws-option.table-name =  entry(v-ii, p-codes, chr(4) )
     2597         buf_hist-nws-option.option-descr = entry(v-ii, p-labels, chr(4) )
     2598         buf_hist-nws-option.subject-group = entry( v-ii, p-groups, chr(4))
     2599         buf_hist-nws-option.host-code = 0
     2600         buf_hist-nws-option.obj-type = '':U
     2601         buf_hist-nws-option.obj-code = 0
     2602         buf_hist-nws-option.hist-to-nws = 0
     2603         buf_hist-nws-option.nws-to-hist = 0
     2604         buf_hist-nws-option.hist-from-prim = 0
     2605         buf_hist-nws-option.get-hist-from-nws = 0
     2606         .
     2607         if current-value(s-hn-id, ub) < buf_hist-nws-option.hn-id
     2608         then do:
     2609           current-value(s-hn-id, ub) = buf_hist-nws-option.hn-id.
     2610         end.
     2611         create tt-db-hn.
     2612         assign
     2613         tt-db-hn.db-num = buf_hist-nws-option.db-num
     2614         tt-db-hn.hn-id = buf_hist-nws-option.hn-id
     2615         .
     2616         release tt-db-hn.
     2617       end.
     2618     end.
     2619   end.
     2620   end procedure.
     2621   procedure cre-cli-grp :
     2622   define input parameter p-grp-name as character        no-undo.
     2623   do
     2624   on error undo, return error
     2625   :
     2626     if not can-find(first buf_cli-grp No-LOCK
     2627                     WHERE buf_cli-grp.node-name = p-grp-name
     2628                     )
     2629     then do:
     2630         create buf_cli-grp.
     2631         ASSIGN
     2632            buf_cli-grp.node-code  = dynamic-next-value( "s-cli-grp":U, LDBNAME("DICTDB":U) )
     2633            buf_cli-grp.lvl-num    = 1
     2634            buf_cli-grp.node-name  = p-grp-name
     2635            buf_cli-grp.upper-code = 1
     2636            buf_cli-grp.is-term    = TRUE
     2637         .
     2638     end.
     2639   end.
     2640   end procedure.
     2641   procedure cre-cli :
     2642   define input parameter p-obj-name as character        no-undo.
     2643   define input parameter p-grp-name as character        no-undo.
     2644   define variable v-name    as character    no-undo.
     2645   define variable v-obj-code    as integer      no-undo.
     2646   do
     2647   on error undo, return error
     2648   :
     2649     find first buf_cli-grp
     2650          WHERE buf_cli-grp.node-name = p-grp-name
     2651          NO-LOCK
     2652          NO-ERROR
     2653          .
     2654      if NOT AVAILABLE buf_cli-grp
     2655      then do:
     2656         undo, return error SUBSTITUTE("cre-cli: Ошибка клиента. Не найдена группа клиентов &1", p-grp-name).
     2657      end.
     2658      if not can-find(first buf_clients
     2659                        WHERE buf_clients.obj-name = p-obj-name
     2660                        NO-LOCK
     2661                        )
     2662      then do:
     2663         assign
     2664            v-name = ""
     2665         .
     2666         run cli-grplib-get-full-name in this-procedure
     2667            (input  buf_cli-grp.node-code
     2668            ,output v-name
     2669            ).
     2670         run gen-b-code in this-procedure ( input 'fmgb':U, output v-obj-code) no-error .
     2671         if error-status :error
     2672         then do:
     2673            undo, return error "cre-cli: Ошибка генерации уникального кода для фирмы поставщика." + chr(10) + return-value.
     2674         end.
     2675         create buf_firm.
     2676         assign
     2677            buf_firm.firm-code      = v-obj-code
     2678         .
     2679         create buf_clients.
     2680         ASSIGN
     2681            buf_clients.obj-type    = 'орг':U
     2682            buf_clients.obj-code    = v-obj-code
     2683            buf_clients.obj-name    = p-obj-name
     2684            buf_clients.grp-code    = buf_cli-grp.node-code
     2685            buf_clients.grp-name    = v-name
     2686         .
     2687     end.
     2688   end.
     2689   end procedure.
