     1814   disable triggers for load of DICTDB.trn-reason .
     1815   disable triggers for load of DICTDB.CashBook .
     1816   define stream errstream.
     1817   find first buf_sys-ctrl.
     1818   if buf_sys-ctrl.db-num <> 0 then do:
     1819     message "Данная утилита может работать только в ГБД.".
     1820     return.
