     1887                       "Справочник стран не будет заполнен!"
     1888                       view-as alert-box.
     1889     end.
     1890     else do:
     1891       run import-countries in this-procedure (input country-path) .
     1892     end.
     1893   end.
     1894   menu-grp-PATH = search("cmp/menu-grp.txt").
     1895   if menu-grp-path = ? then do:
     1896       message
     1897       "Отсутствует файл для импорта справочника глобальных групп меню menu-grp.txt" skip
     1898       "Справочник глобальных групп меню не будет заполнен."
     1899       view-as alert-box.
     1900   end.
     1901   else do:
     1902     run waitfram-show in this-procedure ("Инициализация справочника глобальных групп меню").
     1903     run import-menu-grps in this-procedure .
     1904   end.
     1905   if not v-is-1c-erp then do:
     1906     if p-sys-key <> "raimbek":U then do:
     1907     run waitfram-show in this-procedure ("Инициализация единиц измерения").
     1908     run cre-unit in this-procedure ("шт", "штука", 'шту':U).
     1909     run cre-unit in this-procedure ("пар", "пара", 'шту':U).
     1910     run cre-unit in this-procedure ("кг", "килограмм", 'вес':U).
     1911     run cre-unit in this-procedure ("м", "метр", 'дро':U).
     1912     run cre-unit in this-procedure ("уп", "упаковка", 'шту':U).
     1913     end.
     1914   end.
     1915   run waitfram-show in this-procedure ("Инициализация категорий налогов").
     1916   run cre-tax in this-procedure (1, "НДС", '%':U, yes, ('шту':U + chr(44) + 'вес':U + chr(44) + 'сер':U + chr(44) + 'дро':U + chr(44) + 'топ':U), no).
     1917   run cre-tax in this-procedure (2, "НП", '%':U, no, ('шту':U + chr(44) + 'вес':U + chr(44) + 'сер':U + chr(44) + 'дро':U + chr(44) + 'топ':U), no).
     1918   run cre-tax in this-procedure (3, "Доп.компонента", 'abs':U, no, 'сте':U, yes).
     1919   run cre-tax in this-procedure (4, "Акциз", 'abs':U, no, 'топ':U, yes).
     1920   run waitfram-show in this-procedure ("Инициализация ставок налогов").
     1921   if p-sys-key <> "raimbek":U then do:
     1922     run cre-tax-rate in this-procedure (1, 1, "НДС 1").
     1923     run cre-tax-rate in this-procedure (1, 2, "НДС 2").
     1924     run cre-tax-rate in this-procedure (1, 3, "НДС 3").
     1925     run cre-tax-rate in this-procedure (1, 4, "НДС 4").
     1926     run cre-tax-rate-value in this-procedure (1, 1, 20, v-today, v-time).
     1927     run cre-tax-rate-value in this-procedure (1, 2, 10, v-today, v-time).
     1928     run cre-tax-rate-value in this-procedure (1, 3, 0,  v-today, v-time).
     1929     run cre-tax-rate-value in this-procedure (1, 4, 0,  v-today, v-time).
     1930   end.
     1931   run cre-tax-rate in this-procedure (2, 22, "НП 22").
     1932   run cre-tax-rate-value in this-procedure (2, 22, 0, v-today, v-time).
     1933   run cre-tax-rate-attr in this-procedure (1, 4).
     1934   run waitfram-show in this-procedure ("Заполнение налогов на группу товаров").
     1935   run add-tax-gds-grp in this-procedure  no-error .
