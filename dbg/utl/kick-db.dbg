     2830   procedure cre-pay-type :
     2831   define input parameter p-code as integer        no-undo.
     2832   define input parameter p-name as character        no-undo.
     2833   do
     2834   on error undo, return error
     2835   :
     2836      if not can-find(first buf_pay-type
     2837                      WHERE buf_pay-type.obj-code = p-code
     2838                      NO-LOCK
     2839                     )
     2840      then do:
     2841         create buf_pay-type.
     2842         ASSIGN
     2843            buf_pay-type.obj-code = p-code
     2844            buf_pay-type.obj-name = p-name
     2845         .
     2846      END.
     2847   end.
     2848   end procedure.
     2849   procedure cre-wth :
     2850   define input parameter p-code as integer          no-undo.
     2851   define input parameter p-curr-code as integer          no-undo.
     2852   define input parameter p-is-money as logical          no-undo.
     2853   define input parameter p-name as character        no-undo.
     2854   define input parameter p-get-qnty-method as character        no-undo.
     2855   do
     2856   on error undo, return error
     2857   :
     2858      FIND FIRST buf_currency
     2859           WHERE buf_currency.curr-code = p-curr-code
     2860           NO-LOCK
     2861           NO-ERROR
     2862           .
     2863      if NOT AVAILABLE buf_currency
     2864      then do:
     2865         undo, return error SUBSTITUTE("cre-wth: Ошибка создания МЦ. Не найдена валюта &1", p-curr-code).
     2866      end.
     2867      if not can-find(first buf_wealth
     2868                      WHERE buf_wealth.wth-code = p-code
     2869                      NO-LOCK
     2870                     )
     2871      then do:
     2872         CREATE buf_wealth.
     2873         ASSIGN
     2874            buf_wealth.wth-code  = p-code
     2875            buf_wealth.wth-name  = p-name
     2876            buf_wealth.is-money  = p-is-money
     2877            buf_wealth.curr-code = p-curr-code
     2878            buf_wealth.get-qnty-method = p-get-qnty-method
     2879         .
     2880      END.
     2881   end.
     2882   end procedure.
     2883   procedure cre-cash-pay :
     2884   define input parameter p-code       as integer          no-undo.
     2885   define input parameter p-curr-code  as integer          no-undo.
     2886   define input parameter p-type       as integer          no-undo.
     2887   define input parameter p-wth        as integer          no-undo.
     2888   define input parameter p-name       as character        no-undo.
     2889   define input parameter p-is-cash    as logical          no-undo.
     2890   define input parameter p-is-credit  as logical          no-undo.
     2891   do
     2892   on error undo, return error
     2893   :
     2894      FIND FIRST buf_currency
     2895           WHERE buf_currency.curr-code = p-curr-code
     2896           NO-LOCK
     2897           NO-ERROR
     2898           .
     2899      if NOT AVAILABLE buf_currency
     2900      then do:
     2901         undo, return error SUBSTITUTE("cre-cash-pay: Ошибка создания типа кассового платежа. Не найдена валюта &1", p-curr-code).
     2902      end.
     2903      FIND FIRST buf_pay-type
     2904           WHERE buf_pay-type.obj-code = p-type
     2905           NO-LOCK
     2906           NO-ERROR
     2907           .
     2908      if NOT AVAILABLE buf_pay-type
     2909      then do:
     2910         undo, return error SUBSTITUTE("cre-cash-pay: Ошибка создания типа кассового платежа. Не найден тип платежа &1", p-type).
     2911      end.
     2912      IF p-wth <> 0
     2913      THEN DO:
     2914         FIND FIRST buf_wealth
     2915            WHERE buf_wealth.wth-code   = p-wth
     2916            NO-LOCK
     2917            NO-ERROR
     2918            .
     2919         if NOT AVAILABLE buf_wealth
     2920         then do:
     2921            undo, return error SUBSTITUTE("cre-cash-pay: Ошибка создания типа кассового платежа. Не найдена МЦ &1", p-wth).
     2922         end.
     2923      end.
     2924      if not can-find(first buf_cash-pay
     2925                      WHERE buf_cash-pay.cdpay-code = p-code
     2926                        AND buf_cash-pay.curr-code  = p-curr-code
     2927                      NO-LOCK
     2928                     )
     2929      then do:
     2930         CREATE buf_cash-pay.
     2931         ASSIGN
     2932            buf_cash-pay.cdpay-code  = p-code
     2933            buf_cash-pay.curr-code   = p-curr-code
     2934            buf_cash-pay.pay-code    = p-type
     2935            buf_cash-pay.wth-code    = p-wth
     2936            buf_cash-pay.is-credit   = p-is-credit
     2937            buf_cash-pay.is-cash     = p-is-cash
     2938            buf_cash-pay.atr1        = TRUE
     2939            buf_cash-pay.atr2        = TRUE
     2940            buf_cash-pay.status_     = 'тек':U
     2941            buf_cash-pay.is-all-pay  = p-is-cash
     2942            buf_cash-pay.can-mix     = INTEGER(p-is-cash)
     2943            buf_cash-pay.has-overpay = INTEGER(p-is-credit)
     2944         .
     2945      END.
     2946   end.
     2947   end procedure.
     2948   procedure cre-trn-reason private :
     2949   define input parameter p-reason-code as integer no-undo .
     2950   define input parameter p-reason-name as character no-undo .
     2951   define variable v-rid as recid initial ? no-undo .
     2952     run ref/trn-rsn1.p
     2953       ( input-output v-rid
     2954       , input 'ДОБАВЛЕНИЕ':U
     2955       , input true
     2956       , input p-reason-code
     2957       , input p-reason-name
     2958       , input ""
     2959     ) .
     2960     return .
     2961   end procedure .
     2962   procedure cre-CashBook private :
     2963   define buffer buf_CashBook     for DICTDB.CashBook .
     2964   define buffer buf_CashBookRule for DICTDB.CashBookRule .
     2965     create buf_CashBook .
     2966     assign
     2967       buf_CashBook.id           = 0
     2968       buf_CashBook.ext-code     = "0"
     2969       buf_CashBook.CashBookName = "Основная деятельность"
     2970       buf_CashBook.RuleOsnPko   = "0"
     2971       buf_CashBook.RulePril     = "0"
     2972       buf_CashBook.FlagSepCash  = true
     2973       buf_CashBook.FlagSepFull  = true
     2974       buf_CashBook.CorrPko      = "90.01"
     2975       buf_CashBook.OsnAcct      = "50.02"
     2976     .
     2977   end procedure .
