        1   block-level on error undo, throw.
        2   using ibs.th.bge.execlimpexp.
        3   define variable vss-revision    as character no-undo init "$Revision:$":U .
        4   define variable vss-author      as character no-undo init "$Author:$":U .
        5   define variable vss-date        as character no-undo init "$Date:$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        7   define variable vss-archive     as character no-undo init "$Archive:$":U .
        8   define variable vss-description as character no-undo init "".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable vfileLog as character no-undo init "Log_THIPImp.log".
       64   define variable mFileName as character no-undo init "THIPImp.xslx".
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   function objExists return character
       70   (input  ifolder as character,
       71    input  iType   as character  ):
       72       define variable vFileType as character no-undo init "D,F".
       73       define variable vi        as integer no-undo.
       74       define variable vtype as character no-undo.
       75       if iType ne ?
       76       then
       77          vFileType = iType.
       78       do vi = 1 to num-entries(vFileType):
       79          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       80          vtype = file-information:file-type.
       81          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       82             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       83             index(vtype , entry(vi,vFileType )) > 0
       84          then return file-information:full-pathname .
       85          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       86          vtype = file-information:file-type.
       87          if file-information:file-name <> "" and
       88             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       89             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       90             index( vtype, entry(vi,vFileType )) > 0
       91          then return file-information:full-pathname .
       92       end.
       93       return ? .
       94   end.
       95   function SearchFile return character
       96   (input  ifile as character):
       97      return objExists(ifile,?).
       98   end.
       99   function SearchPFile return character
      100   (input inFile as char):
      101        define variable oFile       as character no-undo.
      102        define variable vFileSearch as character no-undo.
      103        define variable vNumEntry   as integer no-undo.
      104        if inFile = "" then return ?.
      105        vNumEntry = num-entries(inFile,".").
      106        vFileSearch = inFile.
      107        if    vNumEntry > 0
      108           and (   entry(vNumEntry,inFile,".") eq "p"
      109                or entry(vNumEntry,inFile,".") eq "w")
      110        then do:
      111           entry(vNumEntry,vFileSearch, ".") = "r".
      112           oFile = search(vFileSearch ).
      113           if oFile eq ?
      114           then
      115              oFile = search(inFile).
      116        end.
      117        else
      118           oFile = search(vFileSearch).
      119        return oFile.
      120     end.
      121   define new global shared variable g#library  as handle no-undo .
      122   define new global shared variable g#library2 as handle no-undo .
      123   define   shared variable g#auto as logical no-undo.
      124   define   shared variable g#news as logical no-undo.
      125   define   shared variable g#oxml as logical no-undo.
      126   define   shared variable g#esys as logical no-undo.
      127   define   shared variable g#news-source-db as integer no-undo.
      128   define   shared variable g#esys-source-esys as integer no-undo.
      129   define   shared variable g#db-num as integer   no-undo .
      130   define   shared variable g#userid as character no-undo .
      131   define   shared variable g#passwd as character no-undo .
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   function is-numeral return logical
      134     (input p-string   as character ,
      135      input char-avail as character) :
      136     define variable p-replace-string as character no-undo .
      137     define variable log-result       as logical  no-undo .
      138     if p-string = ? then
      139       return false .
      140     p-replace-string = p-string.
      141     if lookup ("*", char-avail) > 0 then
      142         p-replace-string = replace (p-replace-string, '*', '9').
      143     if lookup ("digit", char-avail) > 0 then
      144       assign
      145         p-replace-string = replace (p-replace-string, '0', '9')
      146         p-replace-string = replace (p-replace-string, '1', '9')
      147         p-replace-string = replace (p-replace-string, '2', '9')
      148         p-replace-string = replace (p-replace-string, '3', '9')
      149         p-replace-string = replace (p-replace-string, '4', '9')
      150         p-replace-string = replace (p-replace-string, '5', '9')
      151         p-replace-string = replace (p-replace-string, '6', '9')
      152         p-replace-string = replace (p-replace-string, '7', '9')
      153         p-replace-string = replace (p-replace-string, '8', '9')
      154         .
      155     else
      156        p-replace-string = replace (p-replace-string, '9', chr(15))
      157         .
      158     if lookup ("letter", char-avail) > 0 then
      159       assign
      160         p-replace-string = replace (p-replace-string, 'A', '9')
      161         p-replace-string = replace (p-replace-string, 'B', '9')
      162         p-replace-string = replace (p-replace-string, 'C', '9')
      163         p-replace-string = replace (p-replace-string, 'D', '9')
      164         p-replace-string = replace (p-replace-string, 'E', '9')
      165         p-replace-string = replace (p-replace-string, 'F', '9')
      166         p-replace-string = replace (p-replace-string, 'G', '9')
      167         p-replace-string = replace (p-replace-string, 'H', '9')
      168         p-replace-string = replace (p-replace-string, 'I', '9')
      169         p-replace-string = replace (p-replace-string, 'J', '9')
      170         p-replace-string = replace (p-replace-string, 'K', '9')
      171         p-replace-string = replace (p-replace-string, 'L', '9')
      172         p-replace-string = replace (p-replace-string, 'M', '9')
      173         p-replace-string = replace (p-replace-string, 'N', '9')
      174         p-replace-string = replace (p-replace-string, 'O', '9')
      175         p-replace-string = replace (p-replace-string, 'P', '9')
      176         p-replace-string = replace (p-replace-string, 'Q', '9')
      177         p-replace-string = replace (p-replace-string, 'R', '9')
      178         p-replace-string = replace (p-replace-string, 'S', '9')
      179         p-replace-string = replace (p-replace-string, 'T', '9')
      180         p-replace-string = replace (p-replace-string, 'U', '9')
      181         p-replace-string = replace (p-replace-string, 'V', '9')
      182         p-replace-string = replace (p-replace-string, 'W', '9')
      183         p-replace-string = replace (p-replace-string, 'X', '9')
      184         p-replace-string = replace (p-replace-string, 'Y', '9')
      185         p-replace-string = replace (p-replace-string, 'Z', '9')
      186         p-replace-string = replace (p-replace-string, '_', '9')
      187         .
      188     return p-replace-string = fill ('9', length (p-string)).
      189   end.
      190   define temp-table tt-th_ip no-undo
      191       field th_obj  as character label "Объект"
      192       field th_ip   as character label "IP адрес"
      193       index th_obj th_obj.
      194   if g#db-num ne 0
      195   then do:
      196      message "Импорт возможен только на ГБД" view-as alert-box.
      197      return error.
      198   end.
      199   define variable varlog as logical no-undo.
      200   define variable mFileFullPath as character no-undo.
      201   system-dialog get-file mFileName title "Выберите файл для загрузки ip станций"
      202       filters "MS Excel (*.xls,*.xlsx)" "*.xls,*.xlsx",
      203               "Все файлы" "*.*"
      204       initial-filter 1
      205       must-exist
      206       update varlog.
      207   if not varlog then return error "Отказ от импорта" .
      208   assign
      209      file-info:file-name = mFileName
      210      mFileFullPath           = file-info:full-pathname
      211   .
      212   if length(mFileFullPath) > 0 then .
      213   else return error substitute("Не найден файл &1", mFileName).
      214   define variable exlim as class ibs.th.bge.execlimpexp no-undo.
      215   do:
      216      exlim = new ibs.th.bge.execlimpexp (this-procedure).
      217      subscribe "WriteLogExel" anywhere run-procedure "WriteLog".
      218      subscribe "WorkLineExel" anywhere.
      219      exlim:impExcel(mFileFullPath, temp-table tt-th_ip:handle).
      220      delete object exlim.
      221      unsubscribe "WorkLineExel".
      222      unsubscribe "WriteLogExel".
      223   end.
      224   define variable mStrLoad as integer no-undo.
      225   define variable mStrAll  as integer no-undo.
      226   if searchfile(vfileLog) ne ?
      227   then
      228      message "Сформирован лог " searchfile(vfileLog) skip
      229              "Обработано строк: " mStrAll - 1 skip
      230              "Изменено записей: " mStrLoad
      231      view-as alert-box.
      232   else
      233      message "Нет данных для обработки."
      234      view-as alert-box.
      235   define stream Slog.
      236   define variable mfirst as logical no-undo init true.
      237   procedure WriteLog:
      238      define input  parameter itext as character no-undo.
      239      if mfirst
      240      then do:
      241         mFirst = false.
      242         output stream Slog to value(vfileLog).
      243      end.
      244      else
      245         output stream Slog to value(vfileLog) append.
      246      put stream Slog unformatted itext skip.
      247      output stream Slog close.
      248   end.
      249   procedure WorkLineExel:
      250      define input  parameter iBuffer as handle no-undo.
      251      define output parameter oDelRec as logical no-undo.
      252      define variable vdb-num as integer   no-undo.
      253      oDelRec = yes.
      254      mStrAll = mStrAll + 1.
      255      if not iBuffer:available then return.
      256      if mStrAll = 1 then return .
      257      vdb-num = int(iBuffer::th_obj) no-error.
      258      if vdb-num <> 0 then do:
      259          find first thbj-attr where thbj-attr.upper-prop-code        eq 'gisMT':U
      260                                        and thbj-attr.obj-type        eq 'БД':U
      261                                        and thbj-attr.obj-code        eq vdb-num
      262                                        and thbj-attr.prop-code       eq 'TH_IP':U
      263                   exclusive-lock no-wait no-error.
      264          if available thbj-attr then do:
      265             thbj-attr.property-value-character =  iBuffer::th_ip.
      266             mStrLoad = mStrLoad + 1.
      267             run WriteLog(substitute ("БД &1 IP &2 - загружено успешно",vdb-num,iBuffer::th_ip)
      268                          ).
      269          end.
      270          else do:
      271             run WriteLog(substitute ("БД &1 IP &2 - пропущено, отсутствует секция для данной БД",vdb-num,iBuffer::th_ip)
      272                          ).
      273          end.
      274      end.
      275   end.
