        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   procedure sys-time_get-sys :
        4     define output parameter p-year         as integer   no-undo .
        5     define output parameter p-month        as integer   no-undo .
        6     define output parameter p-day          as integer   no-undo .
        7     define output parameter p-hour         as integer   no-undo .
        8     define output parameter p-minute       as integer   no-undo .
        9     define output parameter p-second       as integer   no-undo .
       10     define output parameter p-milliseconds as integer   no-undo .
       11     define variable v-system-time-structure as memptr    no-undo.
       12     do
       13     on error undo, return error return-value
       14     :
       15       assign
       16         set-size(v-system-time-structure) = 16
       17       .
       18       run GetSystemTime
       19         (input  get-pointer-value(v-system-time-structure)
       20         ) .
       21       assign
       22         p-year         = get-short(v-system-time-structure,  1)
       23         p-month        = get-short(v-system-time-structure,  3)
       24         p-day          = get-short(v-system-time-structure,  7)
       25         p-hour         = get-short(v-system-time-structure,  9)
       26         p-minute       = get-short(v-system-time-structure, 11)
       27         p-second       = get-short(v-system-time-structure, 13)
       28         p-milliseconds = get-short(v-system-time-structure, 15)
       29       .
       30       assign
       31         set-size(v-system-time-structure) = 0
       32       .
       33     end.
       34   end procedure.
       35   procedure sys-time_get-comp-user-name :
       36     define output parameter p-computer-name as character no-undo .
       37     define output parameter p-user-name     as character no-undo .
       38     define output parameter p-process-pid   as integer   no-undo .
       39     define variable v-return-value  as integer   no-undo .
       40     define variable v-buffer-length as integer   no-undo .
       41     define variable v-buffer-memptr as memptr    no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       assign
       46         v-buffer-length = 1024
       47         set-size(v-buffer-memptr) = v-buffer-length + 4
       48       .
       49       assign
       50         put-long(v-buffer-memptr, 1) = v-buffer-length
       51       .
       52       run GetComputerNameA
       53         (input  get-pointer-value(v-buffer-memptr) + 4
       54         ,input  get-pointer-value(v-buffer-memptr)
       55         ,output v-return-value
       56         ) .
       57       if v-return-value <> 0
       58       then do:
       59         assign
       60           p-computer-name = get-string(v-buffer-memptr, 5)
       61         .
       62       end.
       63       assign
       64         put-long(v-buffer-memptr, 1) = v-buffer-length
       65       .
       66       run GetUserNameA
       67         (input  get-pointer-value(v-buffer-memptr) + 4
       68         ,input  get-pointer-value(v-buffer-memptr)
       69         ,output v-return-value
       70         ) .
       71       if v-return-value <> 0
       72       then do:
       73         assign
       74           p-user-name = get-string(v-buffer-memptr, 5)
       75         .
       76       end.
       77       run GetCurrentProcessId
       78         (output p-process-pid
       79         ) .
       80       assign
       81         set-size(v-buffer-memptr) = 0
       82       .
       83     end.
       84   end procedure.
       85   procedure sys-time_get-http :
       86     define output parameter p-http-time as character no-undo .
       87     define variable v-year         as integer   no-undo .
       88     define variable v-month        as integer   no-undo .
       89     define variable v-day-of-week  as integer   no-undo .
       90     define variable v-day          as integer   no-undo .
       91     define variable v-hour         as integer   no-undo .
       92     define variable v-minute       as integer   no-undo .
       93     define variable v-second       as integer   no-undo .
       94     define variable v-milliseconds as integer   no-undo .
       95     do
       96     on error undo, return error return-value
       97     :
       98       run sys-time_get-sys in this-procedure
       99         (output v-year
      100         ,output v-month
      101         ,output v-day
      102         ,output v-hour
      103         ,output v-minute
      104         ,output v-second
      105         ,output v-milliseconds
      106         ) .
      107       assign
      108         v-day-of-week = weekday(date(v-month, v-day, v-year))
      109         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      110                     + ', ':u
      111                     + string(v-day, '99':u)
      112                     + ' ':u
      113                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      114                     + ' ':u
      115                     + string(v-year, '9999':u)
      116                     + ' ':u
      117                     + string(v-hour, '99':u)
      118                     + ':':u
      119                     + string(v-minute, '99':u)
      120                     + ':':u
      121                     + string(v-second, '99':u)
      122                     + ' ':u
      123                     + 'GMT':u
      124       .
      125     end.
      126   end procedure.
      127   procedure sys-time_set-sys :
      128     define input  parameter p-year         as integer   no-undo .
      129     define input  parameter p-month        as integer   no-undo .
      130     define input  parameter p-day          as integer   no-undo .
      131     define input  parameter p-hour         as integer   no-undo .
      132     define input  parameter p-minute       as integer   no-undo .
      133     define input  parameter p-second       as integer   no-undo .
      134     define input  parameter p-milliseconds as integer   no-undo .
      135     define variable v-system-time-structure as memptr    no-undo.
      136     define variable v-return-value as integer   no-undo .
      137     define variable v-day-of-week  as integer   no-undo .
      138     do
      139     on error undo, return error return-value
      140     :
      141       assign
      142         v-day-of-week = weekday(date(p-month, p-day, p-year))
      143       .
      144       assign
      145         set-size(v-system-time-structure) = 16
      146       .
      147       assign
      148         put-short(v-system-time-structure,  1) = p-year
      149         put-short(v-system-time-structure,  3) = p-month
      150         put-short(v-system-time-structure,  5) = v-day-of-week
      151         put-short(v-system-time-structure,  7) = p-day
      152         put-short(v-system-time-structure,  9) = p-hour
      153         put-short(v-system-time-structure, 11) = p-minute
      154         put-short(v-system-time-structure, 13) = p-second
      155         put-short(v-system-time-structure, 15) = p-milliseconds
      156       .
      157       run SetSystemTime
      158         (input  get-pointer-value(v-system-time-structure)
      159         ,output v-return-value
      160         ) .
      161       assign
      162         set-size(v-system-time-structure) = 0
      163       .
      164       if v-return-value = 0
      165       then do:
      166         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      167       end.
      168     end.
      169   end procedure.
      170   procedure sys-time_sys-to-mjd :
      171     define input  parameter p-year         as integer   no-undo .
      172     define input  parameter p-month        as integer   no-undo .
      173     define input  parameter p-day          as integer   no-undo .
      174     define input  parameter p-hour         as integer   no-undo .
      175     define input  parameter p-minute       as integer   no-undo .
      176     define input  parameter p-second       as integer   no-undo .
      177     define input  parameter p-milliseconds as integer   no-undo .
      178     define output parameter p-mjd          as decimal   no-undo .
      179     define variable v-year-correction as decimal   no-undo .
      180     define variable v-shift-year as decimal   no-undo .
      181     do
      182     on error undo, return error return-value
      183     :
      184       assign
      185         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      186         v-shift-year      = decimal(p-year) + v-year-correction
      187         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      188               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      189               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      190               + decimal(p-day) - 2432076.0
      191               + p-hour / 24.0
      192               + p-minute / 1440.0
      193               + p-second / 86400.0
      194               + p-milliseconds / 86400000.0
      195       .
      196     end.
      197   end procedure.
      198   procedure sys-time_sys-to-loc :
      199     define input  parameter p-sys-year         as integer   no-undo .
      200     define input  parameter p-sys-month        as integer   no-undo .
      201     define input  parameter p-sys-day          as integer   no-undo .
      202     define input  parameter p-sys-hour         as integer   no-undo .
      203     define input  parameter p-sys-minute       as integer   no-undo .
      204     define input  parameter p-sys-second       as integer   no-undo .
      205     define input  parameter p-sys-milliseconds as integer   no-undo .
      206     define output parameter p-loc-year         as integer   no-undo .
      207     define output parameter p-loc-month        as integer   no-undo .
      208     define output parameter p-loc-day          as integer   no-undo .
      209     define output parameter p-loc-hour         as integer   no-undo .
      210     define output parameter p-loc-minute       as integer   no-undo .
      211     define output parameter p-loc-second       as integer   no-undo .
      212     define output parameter p-loc-milliseconds as integer   no-undo .
      213     define variable v-system-time-structure as memptr    no-undo.
      214     define variable v-return-value          as integer   no-undo .
      215     define variable v-sys-day-of-week       as integer   no-undo .
      216     do
      217     on error undo, return error return-value
      218     :
      219       assign
      220         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      221       .
      222       assign
      223         set-size(v-system-time-structure) = 32
      224       .
      225       assign
      226         put-short(v-system-time-structure,  1) = p-sys-year
      227         put-short(v-system-time-structure,  3) = p-sys-month
      228         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      229         put-short(v-system-time-structure,  7) = p-sys-day
      230         put-short(v-system-time-structure,  9) = p-sys-hour
      231         put-short(v-system-time-structure, 11) = p-sys-minute
      232         put-short(v-system-time-structure, 13) = p-sys-second
      233         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      234       .
      235       run SystemTimeToTzSpecificLocalTime
      236         (input  0
      237         ,input  get-pointer-value(v-system-time-structure)
      238         ,input  get-pointer-value(v-system-time-structure) + 16
      239         ,output v-return-value
      240         ) .
      241       assign
      242         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      243         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      244         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      245         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      246         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      247         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      248         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      249       .
      250       assign
      251         set-size(v-system-time-structure) = 0
      252       .
      253       if v-return-value = 0
      254       then do:
      255         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      256       end.
      257     end.
      258   end procedure.
      259   procedure sys-time_mjd-to-sys :
      260     define input  parameter p-mjd          as decimal   no-undo .
      261     define output parameter p-year         as integer   no-undo .
      262     define output parameter p-month        as integer   no-undo .
      263     define output parameter p-day          as integer   no-undo .
      264     define output parameter p-hour         as integer   no-undo .
      265     define output parameter p-minute       as integer   no-undo .
      266     define output parameter p-second       as integer   no-undo .
      267     define output parameter p-milliseconds as integer   no-undo .
      268     define variable v-year-correction as decimal   no-undo .
      269     define variable v-shift-year      as decimal   no-undo .
      270     define variable v-conv-date     as date      no-undo .
      271     define variable v-int-part      as integer   no-undo .
      272     define variable v-fraction-part as decimal   no-undo .
      273     do
      274     on error undo, return error return-value
      275     :
      276       assign
      277         v-int-part      = integer(truncate(p-mjd, 0))
      278         v-fraction-part = p-mjd - v-int-part
      279         v-conv-date     = date(11, 17, 1858) + v-int-part
      280         p-year          = year(v-conv-date)
      281         p-month         = month(v-conv-date)
      282         p-day           = day(v-conv-date)
      283         v-fraction-part = v-fraction-part * 24.0
      284         p-hour          = integer(truncate(v-fraction-part, 0))
      285         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      286         p-minute        = integer(truncate(v-fraction-part, 0))
      287         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      288         p-second        = integer(truncate(v-fraction-part, 0))
      289         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      290         p-milliseconds  = integer(v-fraction-part)
      291       .
      292     end.
      293   end procedure.
      294   procedure sys-time_mjd-to-loc :
      295     define input  parameter p-mjd              as decimal   no-undo .
      296     define output parameter p-loc-year         as integer   no-undo .
      297     define output parameter p-loc-month        as integer   no-undo .
      298     define output parameter p-loc-day          as integer   no-undo .
      299     define output parameter p-loc-hour         as integer   no-undo .
      300     define output parameter p-loc-minute       as integer   no-undo .
      301     define output parameter p-loc-second       as integer   no-undo .
      302     define output parameter p-loc-milliseconds as integer   no-undo .
      303     define variable v-sys-year         as integer   no-undo .
      304     define variable v-sys-month        as integer   no-undo .
      305     define variable v-sys-day          as integer   no-undo .
      306     define variable v-sys-hour         as integer   no-undo .
      307     define variable v-sys-minute       as integer   no-undo .
      308     define variable v-sys-second       as integer   no-undo .
      309     define variable v-sys-milliseconds as integer   no-undo .
      310     do
      311     on error undo, return error return-value
      312     :
      313       run sys-time_mjd-to-sys
      314         (input  p-mjd
      315         ,output v-sys-year
      316         ,output v-sys-month
      317         ,output v-sys-day
      318         ,output v-sys-hour
      319         ,output v-sys-minute
      320         ,output v-sys-second
      321         ,output v-sys-milliseconds
      322         ) .
      323       run sys-time_sys-to-loc
      324         (input  v-sys-year
      325         ,input  v-sys-month
      326         ,input  v-sys-day
      327         ,input  v-sys-hour
      328         ,input  v-sys-minute
      329         ,input  v-sys-second
      330         ,input  v-sys-milliseconds
      331         ,output p-loc-year
      332         ,output p-loc-month
      333         ,output p-loc-day
      334         ,output p-loc-hour
      335         ,output p-loc-minute
      336         ,output p-loc-second
      337         ,output p-loc-milliseconds
      338         ) .
      339     end.
      340   end procedure.
      341   function sys-time_get-mjd-func returns decimal
      342   :
      343     define variable v-year         as integer   no-undo .
      344     define variable v-month        as integer   no-undo .
      345     define variable v-day          as integer   no-undo .
      346     define variable v-hour         as integer   no-undo .
      347     define variable v-minute       as integer   no-undo .
      348     define variable v-second       as integer   no-undo .
      349     define variable v-milliseconds as integer   no-undo .
      350     define variable v-mjd          as decimal   no-undo .
      351     run sys-time_get-sys in this-procedure
      352       (output v-year
      353       ,output v-month
      354       ,output v-day
      355       ,output v-hour
      356       ,output v-minute
      357       ,output v-second
      358       ,output v-milliseconds
      359       ) .
      360     run sys-time_sys-to-mjd in this-procedure
      361       (input  v-year
      362       ,input  v-month
      363       ,input  v-day
      364       ,input  v-hour
      365       ,input  v-minute
      366       ,input  v-second
      367       ,input  v-milliseconds
      368       ,output v-mjd
      369       ) .
      370     return v-mjd .
      371   end function .
      372   function sys-time_get-sys-str-func returns character
      373   :
      374     define variable v-utc-time as character no-undo .
      375     define variable v-year         as integer   no-undo .
      376     define variable v-month        as integer   no-undo .
      377     define variable v-day          as integer   no-undo .
      378     define variable v-hour         as integer   no-undo .
      379     define variable v-minute       as integer   no-undo .
      380     define variable v-second       as integer   no-undo .
      381     define variable v-milliseconds as integer   no-undo .
      382     run sys-time_get-sys in this-procedure
      383       (output v-year
      384       ,output v-month
      385       ,output v-day
      386       ,output v-hour
      387       ,output v-minute
      388       ,output v-second
      389       ,output v-milliseconds
      390       ) .
      391     assign
      392       v-utc-time  = 'UTC ':u
      393                   + string(v-year,         '9999':u)
      394                   + '/':u
      395                   + string(v-month,        '99':u)
      396                   + '/':u
      397                   + string(v-day,          '99':u)
      398                   + ' ':u
      399                   + string(v-hour,         '99':u)
      400                   + ':':u
      401                   + string(v-minute,       '99':u)
      402                   + ':':u
      403                   + string(v-second,       '99':u)
      404                   + ' ':u
      405                   + string(v-milliseconds, '999':u)
      406     .
      407     return v-utc-time.
      408   end function .
      409   function sys-time_mjd-to-loc-str-func returns character
      410     (v-sys-mjd as decimal)
      411   :
      412     define variable v-loc-str          as character no-undo .
      413     define variable v-loc-year         as integer   no-undo .
      414     define variable v-loc-month        as integer   no-undo .
      415     define variable v-loc-day          as integer   no-undo .
      416     define variable v-loc-hour         as integer   no-undo .
      417     define variable v-loc-minute       as integer   no-undo .
      418     define variable v-loc-second       as integer   no-undo .
      419     define variable v-loc-milliseconds as integer   no-undo .
      420     run sys-time_mjd-to-loc in this-procedure
      421       (input  v-sys-mjd
      422       ,output v-loc-year
      423       ,output v-loc-month
      424       ,output v-loc-day
      425       ,output v-loc-hour
      426       ,output v-loc-minute
      427       ,output v-loc-second
      428       ,output v-loc-milliseconds
      429       ) .
      430     assign
      431       v-loc-str = substitute('&1/&2/&3 &4:&5'
      432                             ,string(v-loc-day,    '99':U)
      433                             ,string(v-loc-month,  '99':U)
      434                             ,string(v-loc-year,   '9999':U)
      435                             ,string(v-loc-hour,   '99':U)
      436                             ,string(v-loc-minute, '99':U)
      437                             )
      438     .
      439     return v-loc-str .
      440   end function .
      441   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
      442   :
      443     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      444   END PROCEDURE.
      445   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
      446   :
      447     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      448     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
      449   END PROCEDURE.
      450   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
      451   :
      452     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
      453     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
      454   END PROCEDURE.
      455   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
      456   :
      457     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
      458     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
      459     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
      460     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
      461   END PROCEDURE.
      462   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
      463   :
      464     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      465     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      466     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      467   END PROCEDURE.
      468   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
      469   :
      470     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      471     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      472     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      473   END PROCEDURE.
      474   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
      475   :
      476     DEFINE RETURN PARAMETER RetVal          AS LONG.
      477   END PROCEDURE.
      478   define output parameter OPID               as int64 no-undo.
      479   define output parameter oComputerName      as character no-undo.
      480   define output parameter oComputerLoginName as character no-undo.
      481   run sys-time_get-comp-user-name in this-procedure
      482       (output oComputerName
      483       ,output oComputerLoginName
      484       ,output OPID
      485       ) .
