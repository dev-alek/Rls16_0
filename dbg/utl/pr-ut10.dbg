        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       18   define variable v-waitfram-action01         as character   no-undo .
       19   define variable v-waitfram-action02         as character   no-undo .
       20   define variable v-waitfram-action03         as character   no-undo .
       21   define variable mWaitFramTextBeg            as character   no-undo.
       22   define variable mWaitFramTextEnd            as character   no-undo.
       23   define variable mWaitFramView               as logical     no-undo.
       24   define variable mWaitProcEvent              as logical     no-undo init yes.
       25   define variable mWaitFramInterval           as integer     no-undo init 1 .
       26   define variable mWaitFramStop               as logical     no-undo.
       27   define variable mWaitFramStopUser           as logical     no-undo.
       28   define variable mWaitFramStopTimeOut        as logical     no-undo.
       29   define variable mWaitFramStartProc          as datetime-tz no-undo.
       30   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       31   define button B-WaitFramStop auto-end-key
       32        label "Стоп"
       33        size 10 by 1 tooltip "Остоновить процесс".
       34   define button B-viewProcInfo
       35        label "Информация"
       36        size 15 by 1 tooltip "Информация о процесс".
       37   define frame waitfram
       38     v-waitfram-action01 format "x(72)" no-label skip
       39     v-waitfram-action02 format "x(72)" no-label skip
       40     v-waitfram-action03 format "x(72)" no-label skip
       41     B-viewProcInfo
       42     B-WaitFramStop at row 4 col 30
       43     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       44     .
       45   define new global shared variable mBatchMode as logical no-undo init ?.
       46   define variable mFramBachModHandle as handle no-undo.
       47   mFramBachModHandle = frame waitfram:handle.
       48   define variable mFameOldVis as logical no-undo.
       49   define variable mVisCUrentVin as logical no-undo.
       50   if session:batch-mode
       51   then
       52      mBatchMode = yes.
       53   if mBatchMode = ? then do:
       54     mVisCUrentVin = current-window:visible.
       55     mFameOldVis = mFramBachModHandle:visible.
       56     mFramBachModHandle:visible  = yes.
       57     mBatchMode = mFramBachModHandle:visible ne yes.
       58     mFramBachModHandle:visible = mFameOldVis.
       59     current-window:visible = mVisCUrentVin.
       60   end.
       61    if  log-manager:logfile-name ne ?
       62     then DO:
       63         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
       64         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
       65         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
       66     end.
       67   on choose of B-WaitFramStop in frame waitfram
       68   do:
       69     mWaitFramStop = yes.
       70     mWaitFramStopUser = yes.
       71   end.
       72   function waitfram-check-timeout returns logical():
       73      define variable vtime as int64 no-undo.
       74      if mWaitFramStopTimeOut
       75      then
       76         return yes.
       77      vtime = ( now - mWaitFramStartProc ) / 1000 .
       78      if     mWaitFramTimeOut ne ?
       79         and mWaitFramTimeOut ne 0
       80         and mWaitFramTimeOut lt vtime
       81      then do:
       82         mWaitFramStopTimeOut = yes.
       83      end.
       84      return mWaitFramStopTimeOut.
       85   end.
       86   procedure waitfram-hide :
       87     if not session:batch-mode
       88     then do
       89     on error undo, return error return-value
       90     :
       91       pause 0 before-hide .
       92       if not mBatchMode then
       93         hide frame waitfram .
       94     if     not mWaitFramView
       95        and mWaitProcEvent
       96     then
       97       process events .
       98     end.
       99   end procedure.
      100   procedure waitfram-show :
      101     define input  parameter p-message as character no-undo .
      102     define variable v-left-margin as integer   no-undo .
      103     if not session:batch-mode
      104     then do
      105     on error undo, return error return-value
      106     :
      107       if length(p-message) <= 70 then do:
      108         assign
      109           v-left-margin = integer((70 - length(p-message)) / 2)
      110         .
      111         assign
      112           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      113         .
      114         assign
      115           v-waitfram-action01 = " "
      116           v-waitfram-action02 = " "
      117                                    + fill(" ", v-left-margin)
      118                                    + p-message
      119           v-waitfram-action03 = " "
      120         .
      121       end.
      122       else do:
      123         define variable vRindex1 as integer no-undo.
      124         define variable vRindex2 as integer no-undo.
      125         vRindex1 = r-index(p-message," ",70).
      126         if vRindex1 = 0
      127         then
      128            vRindex1 = 70.
      129         if length(p-message)  <= vRindex1 + 70 then do:
      130           assign
      131             v-waitfram-action01 = " "
      132             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      133             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      134           .
      135         end.
      136         else do:
      137           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      138           if vRindex2 <= vRindex1
      139           then
      140              vRindex2 = vRindex1 + 70.
      141           assign
      142             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      143             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      144             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      145           .
      146         end.
      147       end.
      148       B-viewProcInfo:visible   in frame waitfram = no.
      149       B-viewProcInfo:sensitive in frame waitfram = no.
      150       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      151       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      152       if  (   mWaitFramView
      153          or  mWaitProcEvent)
      154          and not mBatchMode
      155       then
      156          display
      157             v-waitfram-action01 skip
      158             v-waitfram-action02 skip
      159             v-waitfram-action03 skip
      160          with frame waitfram .
      161       if     mWaitFramView
      162          then do:
      163             if     mWaitFramInterval ne ?
      164                and not mBatchMode
      165             then
      166                wait-for go of frame waitfram pause mWaitFramInterval.
      167          end.
      168          else
      169             if     mWaitProcEvent
      170                and not mBatchMode
      171             then
      172                process events .
      173     end.
      174   end procedure.
      175      procedure waitfram-show-this:
      176         define input  parameter iInterval as int64 no-undo.
      177         define variable vtime as int64 no-undo.
      178         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      179         mWaitFramInterval = iInterval.
      180         run waitfram-show (substitute("&1&2 &3&4" ,
      181                                       mWaitFramTextBeg ,
      182                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      183                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      184                                       mWaitFramTextEnd
      185                                      )
      186                           ).
      187      end.
      188      procedure WaitFramRunPause:
      189         define input  parameter iInterval as dec no-undo.
      190         define variable vStart  as datetime-tz no-undo.
      191         define variable vend    as datetime-tz no-undo.
      192         define variable vint as int64 no-undo.
      193         define variable vOk as logical no-undo.
      194         vStart = now.
      195         vend   = vStart.
      196         publish "WaitFramPause" (iInterval,output vOk).
      197         vend   =  now.
      198         vint = vend - vStart.
      199         vint = iInterval - vint / 1000.
      200         if     not mWaitFramStop
      201            and (   vint > 0
      202                 or (    not vOk
      203                     and iInterval eq ?
      204                     )
      205                 )
      206         then
      207            run waitfram-show-this (iInterval).
      208         vend   =  now.
      209         vint = vend - vStart.
      210         vint = iInterval - vint / 1000.
      211         if     not mWaitFramStop
      212            and vint > 0
      213         then do:
      214            run gbl/pause.p (vint * 1000).
      215         end.
      216         if iInterval ne ?
      217         then
      218            publish "WaitFramStop".
      219         waitfram-check-timeout().
      220      end.
      221      procedure WaitFramWaitFor:
      222         define input  parameter iInterval as dec no-undo.
      223         assign
      224            mWaitFramStartProc   = now
      225            mWaitFramStopUser    = no
      226            mWaitFramStopTimeOut = no
      227         .
      228         block-wait:
      229         do while not mWaitFramStop:
      230            run WaitFramRunPause (iInterval).
      231            if  waitfram-check-timeout()
      232            then do:
      233               leave block-wait.
      234            end.
      235         end.
      236         run waitfram-hide.
      237      end.
      238   procedure waitfram-join :
      239     define input  parameter p-line-1  as character no-undo .
      240     define input  parameter p-line-2  as character no-undo .
      241     define input  parameter p-line-3  as character no-undo .
      242     define output parameter p-message as character no-undo .
      243     do
      244     on error undo, return error return-value
      245     :
      246       assign
      247         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      248                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      249                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      250       .
      251     end.
      252   end procedure.
      253   function waitfram-join-function returns character
      254     (input p-line-1 as character
      255     ,input p-line-2 as character
      256     ,input p-line-3 as character
      257     ).
      258     define variable v-message as character no-undo .
      259     run waitfram-join in this-procedure
      260       (input  p-line-1
      261       ,input  p-line-2
      262       ,input  p-line-3
      263       ,output v-message
      264       ) .
      265     return v-message .
      266   end function .
      267   define buffer buf_price-doc  for price-doc  .
      268   define buffer buf_price-list for price-list .
      269   define variable col-part as integer no-undo .
      270   define variable temp1 as integer init 10 no-undo .
      271   define variable v-all as integer init 0 no-undo .
      272   define variable v-nun as character no-undo .
      273     run gbl/d-prompt.w
      274       ( 'title=Введите Номер переоценки\'
      275       + 'format=x(15)\'
      276       + 'type=char\'
      277       ,input-output v-nun
      278       ).
      279     if return-value = 'false':u
      280     then do:
      281       return .
      282     end.
      283   find first price-doc no-lock where price-doc.doc-num =  v-nun no-error .
      284   if error-status :error then do:
      285      message "Не верно введен номер переоценки!!" view-as alert-box error .
      286      return error return-value .
      287   end.
      288   if price-doc.status_ <> 'акт':U then do:
      289      message "Переоценка не закрыта на АКТ!!" view-as alert-box error .
      290      return error return-value .
      291   end.
      292    run str/pr-oldd.p (price-doc.doc-num )  no-error .
      293    if error-status :error then do:
      294      message
      295      "Ошибка процедуры pr-oldd.p"
      296      error-status :get-message(1) view-as alert-box error .
      297      return error return-value .
      298   end.
