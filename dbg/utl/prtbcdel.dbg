       99   index isdone
      100   done
      101   .
      102   define new global shared variable g#language as character no-undo .
      103   if g#language <> '' and g#language <> 'rus':U then do:
      104     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      105   end.
      106   define new global shared variable g#library  as handle no-undo .
      107   define new global shared variable g#library2 as handle no-undo .
      108   define   shared variable g#auto as logical no-undo.
      109   define   shared variable g#news as logical no-undo.
      110   define   shared variable g#oxml as logical no-undo.
      111   define   shared variable g#esys as logical no-undo.
      112   define   shared variable g#news-source-db as integer no-undo.
      113   define   shared variable g#esys-source-esys as integer no-undo.
