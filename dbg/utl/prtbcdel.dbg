       76     index code is         unique gds-code
       77     index oi order-num
       78     index isel to-sel
       79     .
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define  shared  temp-table gds-list-hist no-undo
       82   field list-table as character
       83   field id as integer
       84   field line as integer
       85   field hist-mode as character
       86   field des as character
       87   field num-recs as integer
       88   field option_ as character
       89   field item_ as character
       90   field status_ as character
       91   field num-add as integer
       92   field num-ignored as integer
       93   field done as logical
       94   field err_ as logical
       95   field err-mes as character
       96   index pi is primary
