        1   block-level on error undo, throw.
        2   define input  parameter iUtil as class ibs.th.utl.method-for-draw-utility no-undo.
        3   define input  parameter itext as character no-undo.
        4   define input  parameter iobjcode as char no-undo.
        5   define variable mAnswer as character  no-undo.
        6   define new global shared variable g#language as character no-undo .
        7   if g#language <> '' and g#language <> 'rus':U then do:
        8     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        9   end.
       10   subscribe   to "ResponseToQuestion" anywhere run-procedure "SendAnswer".
       11   if itext <> ""
       12   then do:
       13     mAnswer = "4".
       14     run str/sendcash_num.p(iUtil:parparentproc,this-procedure,this-procedure,string(iobjcode) + chr(4) + itext).
       15   end.
       16   unsubscribe to "ResponseToQuestion".
       17   procedure SendAnswer:
       18      define output parameter oAnswer as character  no-undo.
       19      oAnswer = mAnswer.
       20   end procedure.
       21   procedure write-log-and-file :
       22   define input parameter p-tabs as integer no-undo .
       23   define input parameter p-log-file as character no-undo .
       24   define input parameter p-int2 as integer no-undo .
       25   define input parameter p-mess as character no-undo .
       26   iUtil:put-log(p-mess).
       27   end procedure.
       28   procedure show-counter :
       29   end procedure.
