     1536   define temp-table userobjs_temp-user-obj no-undo
     1537     field obj-type as character
     1538     field obj-code as integer
     1539     index xpk is primary unique obj-type obj-code
     1540     .
     1541   procedure userobjs_clear :
     1542     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1543     do
     1544     on error undo, return error return-value
     1545     :
     1546       for each buf_userobjs_temp-user-obj
     1547       on error undo, return error return-value
     1548       :
     1549         delete buf_userobjs_temp-user-obj .
     1550       end.
     1551     end.
     1552   end .
     1553   procedure userobjs_object-count :
     1554     define output parameter p-total-count as integer   no-undo .
     1555     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1556     do
     1557     on error undo, return error return-value
     1558     :
     1559       assign
     1560         p-total-count = 0
     1561       .
     1562       for each buf_userobjs_temp-user-obj
     1563       on error undo, return error return-value
     1564       :
     1565         assign
     1566           p-total-count = p-total-count + 1
     1567         .
     1568       end.
     1569     end.
     1570   end.
     1571   procedure userobjs_append :
     1572      define input  parameter p-obj-type as character no-undo .
     1573      define input  parameter p-obj-code as integer   no-undo .
     1574     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1575     do
     1576     on error undo, return error return-value
     1577     :
     1578       find first buf_userobjs_temp-user-obj
     1579         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1580           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1581         no-error .
     1582       if not available buf_userobjs_temp-user-obj
     1583       then do:
     1584         create buf_userobjs_temp-user-obj .
     1585         assign
     1586           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1587           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1588         .
     1589       end.
     1590     end.
     1591   end.
     1592   procedure userobjs_object-exist :
     1593     define output parameter p-object-exist as logical   no-undo .
     1594     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1595     do
     1596     on error undo, return error return-value
     1597     :
     1598       find first buf_userobjs_temp-user-obj
     1599         no-error .
     1600       if not available buf_userobjs_temp-user-obj
     1601       then do:
     1602         assign
     1603           p-object-exist = false
     1604         .
     1605       end.
     1606       else do:
     1607         assign
     1608           p-object-exist = true
     1609         .
     1610       end.
     1611     end.
     1612   end.
     1613   procedure userobjs_transfer :
     1614     define input  parameter p-callback-handle as handle no-undo .
     1615     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1616     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1617     do
     1618     on error undo, return error return-value
     1619     :
     1620       if valid-handle(p-callback-handle) <> true
     1621       then do:
     1622         message
     1623           vss-workfile vss-revision vss-description skip
     1624           "Ошибка задания входных параметров" skip
     1625           "Неизвестный указатель на процедуру" skip
     1626           view-as alert-box error .
     1627         undo, return error return-value .
     1628       end.
     1629       if p-callback-handle :get-signature("userobjs_append") = ""
     1630       then do:
     1631         message
     1632           vss-workfile vss-revision vss-description skip
     1633           "Ошибка задания входных параметров" skip
     1634           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1635                     ,p-callback-handle :file-name
     1636                     ) skip
     1637           view-as alert-box error .
     1638         undo, return error return-value .
     1639       end.
     1640       for each buf_userobjs_temp-user-obj
     1641       on error undo, return error return-value
     1642       :
     1643         run userobjs_append in p-callback-handle
     1644           (input  buf_userobjs_temp-user-obj.obj-type
     1645           ,input  buf_userobjs_temp-user-obj.obj-code
     1646           ) .
     1647       end.
     1648     end.
     1649   end procedure.
