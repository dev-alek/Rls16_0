      361   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   procedure factord :
      363     define input  parameter p-fact-date            as date    no-undo .
      364     define input  parameter p-fact-time            as integer no-undo .
      365     define input  parameter p-fact-num             as integer no-undo .
      366     define input  parameter p-shift-date           as date    no-undo .
      367     define input  parameter p-shift-num            as integer no-undo .
      368     define input  parameter p-shift-on             as logical no-undo .
      369     define output parameter p-fact-order           as decimal no-undo .
      370     define output parameter p-shift-end-fact-order as decimal no-undo .
      371     define output parameter p-day-end-fact-order   as decimal no-undo .
      372     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      373     if p-fact-date = ?
      374     then do:
      375       return error "Не указана фактическая дата" .
      376     end.
      377     define variable v-fact-date-num as integer no-undo .
      378     assign
      379       v-fact-date-num = integer(p-fact-date)
      380     .
      381     if p-fact-num = ?
      382     or p-fact-num = 0
      383     then do:
      384       return error "Не задан p-fact-num " + string(p-fact-num) .
      385     end.
      386     if p-fact-num < 0
      387     then do:
      388       return error "Отрицательный fact-num " + string(p-fact-num) .
      389     end.
      390     if p-fact-num >= 100000000
      391     then do:
      392       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      393     end.
      394     if p-shift-on = true
      395     then do:
      396       if p-shift-date = ?
      397       then do:
      398         return error "Не задана дата смены" .
      399       end.
      400       if p-shift-num = ?
      401       or p-shift-num = 0
      402       then do:
      403         return error "Не задан номер смены" .
      404       end.
      405     end.
      406     else do:
      407       assign
      408         p-shift-date = p-fact-date
      409         p-shift-num  = 24
      410       .
      411     end.
      412     define variable v-shift-offset as integer no-undo .
      413     if p-shift-date = p-fact-date
      414     then do:
      415       assign
      416         v-shift-offset = 1
      417       .
      418     end.
      419     if p-shift-date < p-fact-date
      420     then do:
      421       assign
      422         v-shift-offset = 0
      423       .
      424     end.
      425     if p-shift-date > p-fact-date
      426     then do:
      427       message
      428         vss-workfile vss-revision vss-description skip
      429         "Неправильная дата закрытия смены" skip
      430         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      431         view-as alert-box error .
      432       undo, return error
      433         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      434           ,string(p-fact-date, '99/99/9999':U)
      435           ,string(p-shift-date, '99/99/9999':U)
      436           )
      437       .
      438     end.
      439     if p-shift-num < 1
      440     or p-shift-num > 24
      441     then do:
      442       message
      443         vss-workfile vss-revision vss-description skip
      444         "Неправильный номер смены" skip
      445         "p-shift-num" p-shift-num skip
      446         view-as alert-box error .
      447       undo, return error return-value .
      448     end.
      449     assign
      450       p-fact-order           = v-fact-date-num
      451                              + v-shift-offset * 0.5
      452                              + p-shift-num    * 0.02 - 0.01
      453                              + p-fact-num     * 0.0000000001
      454       p-shift-end-fact-order = v-fact-date-num
      455                              + v-shift-offset * 0.5
      456                              + p-shift-num    * 0.02
      457       p-day-end-fact-order   = v-fact-date-num
      458                              + 0.99
      459     .
      460     if p-fact-order           <= v-fact-date-num
      461     or p-shift-end-fact-order <= v-fact-date-num
      462     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      463     or p-shift-end-fact-order >= p-day-end-fact-order
      464     then do:
      465       message
      466         vss-workfile vss-revision vss-description skip
      467         "Внутренняя ошибка при генерации фактического номера" skip
      468         "p-fact-date"            p-fact-date            skip
      469         "p-fact-time"            p-fact-time            skip
      470         "p-fact-num"             p-fact-num             skip
      471         "p-shift-date"           p-shift-date           skip
      472         "p-shift-num"            p-shift-num            skip
      473         "p-shift-on"             p-shift-on             skip
      474         "p-shift-end-fact-order" p-shift-end-fact-order skip
      475         "p-day-end-fact-order"   p-day-end-fact-order   skip
      476         "v-fact-date-num"        v-fact-date-num        skip
      477         view-as alert-box error .
      478       undo, return error return-value .
      479     end.
      480   end procedure.
      481   procedure day-begin-fact-order :
      482     define input  parameter p-fact-date            as date    no-undo .
      483     define output parameter p-day-begin-fact-order as decimal no-undo .
      484     do
      485     on error undo, return error return-value
      486     :
      487       if p-fact-date = ?
      488       then do:
      489         assign
      490           p-day-begin-fact-order = 0
      491         .
      492       end.
      493       else do:
      494         assign
      495           p-day-begin-fact-order = integer(p-fact-date)
      496         .
      497       end.
      498     end.
      499   end procedure.
      500   procedure factord-max-fact-order :
      501     define output parameter p-max-fact-order as decimal   no-undo .
      502     do
      503     on error undo, return error return-value
      504     :
      505       run day-begin-fact-order in this-procedure
      506         (input  date(1, 1, 5000)
      507         ,output p-max-fact-order
      508         ) .
      509     end.
      510   end procedure.
      511   procedure factord-cut-archive :
      512     define input  parameter p-obj-type             as character no-undo .
      513     define input  parameter p-obj-code             as integer   no-undo .
      514     define input  parameter p-fact-date            as date      no-undo .
      515     define output parameter p-shift-on             as logical   no-undo .
      516     define output parameter p-shift-date           as date      no-undo .
      517     define output parameter p-shift-num            as integer   no-undo .
      518     define output parameter p-day-end-fact-order   as decimal   no-undo .
      519     define output parameter p-shift-end-fact-order as decimal   no-undo .
      520     define variable v-fact-order as decimal   no-undo .
      521     define buffer buf_shift-obj for ub.shift-obj .
      522     do
      523     on error undo, return error return-value
      524     :
      525   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      527     (input  p-obj-type
      528     ,input  p-obj-code
      529     ,input  'shift-on=request'
      530     ,output p-shift-on
      531     ) no-error .
      532       if error-status :error
      533       then do:
      534         message
      535           vss-workfile vss-revision vss-description skip
      536           "Ошибка при определении атрибута объекта" skip
      537           "Объект" p-obj-type p-obj-code skip
      538           error-status :get-message(1) skip
      539           return-value skip
      540           view-as alert-box error .
      541         undo, return error return-value .
      542       end.
      543       if p-shift-on = false
      544       then do:
      545         assign
      546           p-shift-date               = ?
      547           p-shift-num                = 0
      548         .
      549       end.
      550       else do:
      551         find first buf_shift-obj share-lock
      552           where buf_shift-obj.obj-type   = p-obj-type
      553             and buf_shift-obj.obj-code   = p-obj-code
      554             and buf_shift-obj.shift-date > p-fact-date
      555           use-index pi
      556           no-error .
      557         if not available buf_shift-obj
      558         or buf_shift-obj.status_ <> 'зкр':U
      559         then do:
      560           message
      561             vss-workfile vss-revision vss-description skip
      562             "Невозможно вычислить последнюю смену" skip
      563             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      564             "Объект" p-obj-type p-obj-code skip
      565             "Дата" p-fact-date skip
      566             view-as alert-box error .
      567           undo, return error return-value .
      568         end.
      569         find last buf_shift-obj share-lock
      570           where buf_shift-obj.obj-type = p-obj-type
      571             and buf_shift-obj.obj-code = p-obj-code
      572             and buf_shift-obj.shift-date <= p-fact-date
      573           use-index pi
      574           no-error .
      575         if available buf_shift-obj
      576         then do:
      577           if  buf_shift-obj.status_ = 'зкр':U
      578           then do:
      579             assign
      580               p-shift-date = buf_shift-obj.shift-date
      581               p-shift-num  = buf_shift-obj.shift-num
      582             .
      583           end.
      584           else do:
      585             message
      586               vss-workfile vss-revision vss-description skip
      587               "Невозможно вычислить последнюю смену" skip
      588               "Статус смены отличен от статуса" 'зкр':U skip
      589               "Объект" p-obj-type p-obj-code skip
      590               "Дата" p-fact-date skip
      591               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      592               view-as alert-box error .
      593             undo, return error return-value .
      594           end.
      595         end.
      596         else do:
      597           assign
      598             p-shift-date = p-fact-date - 1
      599             p-shift-num  = 1
      600           .
      601         end.
      602       end.
      603       run factord in this-procedure
      604         (input  p-fact-date
      605         ,input  1
      606         ,input  1
      607         ,input  p-shift-date
      608         ,input  p-shift-num
      609         ,input  p-shift-on
      610         ,output v-fact-order
      611         ,output p-shift-end-fact-order
      612         ,output p-day-end-fact-order
      613         ) no-error .
      614       if error-status :error
      615       then do:
      616         message
      617           vss-workfile vss-revision vss-description skip
      618           "Ошибка при вызове процедуры factord"
      619           error-status :get-message(1) skip
      620           return-value skip
      621           view-as alert-box error .
      622         undo, return error return-value .
      623       end.
      624     end.
      625   end procedure.
      626   procedure factord-lock-shift :
      627     define input  parameter p-obj-type  as character no-undo .
      628     define input  parameter p-obj-code  as integer   no-undo .
      629     define input  parameter p-fact-date as date      no-undo .
      630     define parameter buffer buf_shift-obj for ub.shift-obj .
      631     define variable v-shift-on      as logical   no-undo .
      632     define variable v-extra-message as character no-undo .
      633     define variable v-error as character no-undo .
      634     do
      635     on error undo, return error return-value
      636     :
      637   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      638   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      639     (input  p-obj-type
      640     ,input  p-obj-code
      641     ,input  'shift-on=request'
      642     ,output v-shift-on
      643     ) no-error .
      644       if error-status :error
      645       then do:
      646         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      647         undo, return error v-error .
      648       end.
      649       if v-shift-on = true
      650       then do:
      651         find first buf_shift-obj share-lock
      652           where buf_shift-obj.obj-type   = p-obj-type
      653             and buf_shift-obj.obj-code   = p-obj-code
      654             and buf_shift-obj.shift-date > p-fact-date
      655           use-index pi
      656           no-error .
      657         if not available buf_shift-obj
      658         or buf_shift-obj.status_ <> 'зкр':U
      659         then do:
      660           find last buf_shift-obj
      661             where buf_shift-obj.obj-type = p-obj-type
      662               and buf_shift-obj.obj-code = p-obj-code
      663               and buf_shift-obj.status_  = 'зкр':U
      664             use-index stts
      665             no-error .
      666           if available buf_shift-obj
      667           then do:
      668             assign
      669               v-extra-message =
      670                     substitute("Дата начала последеней закрытой смены на объекте &1"
      671                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      672                               )
      673             .
      674           end.
      675           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      676           undo, return error v-error .
      677         end.
      678       end.
      679     end.
      680   end procedure.
      681   procedure factord-end-day :
      682     define input  parameter p-fact-date            as date    no-undo .
      683     define output parameter p-day-end-fact-order   as decimal no-undo .
      684     do
      685     on error undo, return error return-value
      686     :
      687       if p-fact-date = ?
      688       then do:
      689         return error "Не указана фактическая дата" .
      690       end.
      691       assign
      692         p-day-end-fact-order = integer(p-fact-date) + 0.99
      693       .
      694     end.
      695   end procedure.
      696   procedure factord-to-date :
      697     define input  parameter p-fact-order as decimal no-undo .
      698     define output parameter p-fact-date  as date    no-undo .
      699     define variable v-ref-date  as date      no-undo .
      700     define variable v-ref-delta as integer   no-undo .
      701     do
      702     on error undo, return error return-value
      703     :
      704       if p-fact-order = ?
      705       or p-fact-order = 0
      706       then do:
      707         return error "Не указан fact-order" .
      708       end.
      709       assign
      710         v-ref-date  = date(1, 1, 2000)
      711       .
      712       assign
      713         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      714       .
      715       assign
      716         p-fact-date = v-ref-date + v-ref-delta
      717       .
      718     end.
      719   end procedure.
      720   procedure factord-to-fact-num :
      721     define input  parameter p-fact-order as decimal no-undo .
      722     define output parameter p-fact-num   as integer no-undo .
      723     define variable v-fact-order-trunc as decimal no-undo .
      724     do
      725     on error undo, return error return-value
      726     :
      727       if p-fact-order = ?
      728       or p-fact-order = 0
      729       then do:
      730         return error "Не указан fact-order" .
      731       end.
      732       assign
      733        v-fact-order-trunc = truncate(p-fact-order, 2)
      734       .
      735       assign
      736         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      737       .
      738     end.
      739   end procedure.
      740   procedure factord-to-shift-num :
      741     define input  parameter p-fact-order as decimal no-undo .
      742     define output parameter p-shift-num   as integer no-undo .
      743     define variable  p-shift-numd  as decimal   no-undo .
      744     define variable v-fact-order-trunc as decimal no-undo .
      745     do
      746     on error undo, return error return-value
      747     :
      748       if p-fact-order = ?
      749       or p-fact-order = 0
      750       then do:
      751         return error "Не указан fact-order" .
      752       end.
      753       assign
      754        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      755       .
      756       if v-fact-order-trunc < 0.5 then do:
      757         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      758       end.
      759       assign
      760         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      761         .
      762        assign
      763         p-shift-num = truncate (p-shift-numd , 0)
      764       .
      765     end.
      766   end procedure.
      767   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      769   procedure partslib-clear-temp-parts :
      770     define buffer buf_temp-parts for temp-parts .
      771     do
      772     on error undo, return error
      773     :
      774       for each buf_temp-parts
      775       on error undo, return error
      776       :
      777         delete buf_temp-parts .
      778       end.
      779     end.
      780   end procedure.
      781   procedure partslib-create-temp-parts :
      782     define parameter buffer buf_parts       for ub.parts .
      783     define parameter buffer buf_temp-parts  for temp-parts .
      784     define input  parameter p-goods-twounit as logical   no-undo .
      785     define variable v-base-part-code as character no-undo .
      786     do
      787     on error undo, return error
      788     :
      789       if p-goods-twounit = true
      790       then do:
      791         assign
      792           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      793         .
      794       end.
      795       else do:
      796         assign
      797           v-base-part-code = buf_parts.part-code
      798         .
      799       end.
      800       find first buf_temp-parts exclusive-lock
      801         where buf_temp-parts.obj-type  = buf_parts.obj-type
      802           and buf_temp-parts.obj-code  = buf_parts.obj-code
      803           and buf_temp-parts.artic     = buf_parts.artic
      804           and buf_temp-parts.prod-type = buf_parts.prod-type
      805           and buf_temp-parts.prod-code = buf_parts.prod-code
      806           and buf_temp-parts.in-code   = buf_parts.in-code
      807           and buf_temp-parts.out-code  = 'free-zone':U
      808           and buf_temp-parts.part-code = v-base-part-code
      809         no-error.
      810       if not available buf_temp-parts
      811       then do:
      812         create buf_temp-parts .
      813         buffer-copy buf_parts to buf_temp-parts
      814         assign
      815           buf_temp-parts.out-code  = 'free-zone':U
      816           buf_temp-parts.part-code = v-base-part-code
      817           buf_temp-parts.rsrv-free = yes
      818           buf_temp-parts.status_   = no
      819           buf_temp-parts.qnty      = 0
      820           buf_temp-parts.fact-qnty = 0
      821           buf_temp-parts.real-qnty = 0
      822           buf_temp-parts.cli-qnty  = 0
      823         .
      824       end.
      825     end.
      826   end procedure.
      827   procedure partslib-init-temp-parts :
      828     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      829     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      830     define input parameter p-artic           like ub.parts.artic     no-undo .
      831     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      832     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      833     define buffer buf_parts      for ub.parts .
      834     define buffer buf_temp-parts for temp-parts .
      835     define variable v-goods-twounit    as logical   no-undo .
      836     do
      837     on error undo, return error
      838     :
      839   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      840   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      841     (input  p-artic
      842     ,input  p-prod-type
      843     ,input  p-prod-code
      844     ,input  'twounit=request':u
      845     ,output v-goods-twounit
      846     ) no-error .
      847       if error-status :error
      848       then do:
      849         message
      850           vss-workfile vss-revision vss-description skip
      851           vss-include-info4 skip
      852           "Ошибка при определении атрибута товара" skip
      853           "Артикул" p-artic p-prod-type p-prod-code skip
      854           "twounit=request" skip
      855           error-status :get-message(1) skip
      856           return-value skip
      857           view-as alert-box error .
      858         undo, return error return-value .
      859       end.
      860       run partslib-clear-temp-parts in this-procedure .
      861       for each buf_parts
      862         where buf_parts.obj-type  = p-obj-type
      863           and buf_parts.obj-code  = p-obj-code
      864           and buf_parts.artic     = p-artic
      865           and buf_parts.prod-type = p-prod-type
      866           and buf_parts.prod-code = p-prod-code
      867           and buf_parts.rsrv-free = yes
      868           and buf_parts.status_   = no
      869           and buf_parts.in-code   <> buf_parts.out-code
      870       on error undo, return error
      871       :
      872         run partslib-create-temp-parts in this-procedure
      873           (buffer buf_parts
      874           ,buffer buf_temp-parts
      875           ,input  v-goods-twounit
      876           ) .
      877         define variable v-parts-qnty          as decimal   no-undo .
      878         define variable v-parts-cli-qnty      as decimal   no-undo .
      879         define variable v-parts-free-qnty     as decimal   no-undo .
      880         define variable v-parts-free-cli-qnty as decimal   no-undo .
      881         if buf_parts.out-code = 'free-zone':U
      882         then do:
      883           assign
      884             v-parts-qnty          = buf_parts.qnty
      885             v-parts-cli-qnty      = buf_parts.cli-qnty
      886             v-parts-free-qnty     = buf_parts.qnty
      887             v-parts-free-cli-qnty = buf_parts.cli-qnty
      888           .
      889         end.
      890         else do:
      891           assign
      892             v-parts-qnty          = abs(buf_parts.qnty)
      893             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      894             v-parts-free-qnty     = 0
      895             v-parts-free-cli-qnty = 0
      896           .
      897         end.
      898         assign
      899           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      900           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      901           buf_temp-parts.real-qnty     = 0
      902           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      903           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      904           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      905         .
      906       end.
      907     end.
      908   end procedure.
      909   procedure partslib-init-temp-parts-by-factord :
      910     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      911     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      912     define input parameter p-artic              like ub.parts.artic     no-undo .
      913     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      914     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      915     define input parameter p-fact-order         as decimal   no-undo .
      916     define input parameter p-include-fact-order as logical   no-undo .
      917     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      918     define buffer buf_gds-obj  for ub.gds-obj .
      919     do
      920     on error undo, return error
      921     :
      922       do transaction
      923       on error undo, return error
      924       :
      925   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      926   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      927     (input  p-obj-type
      928     ,input  p-obj-code
      929     ,input  p-artic
      930     ,input  p-prod-type
      931     ,input  p-prod-code
      932     ,buffer buf_gds-obj
      933     ) no-error .
      934         if error-status :error
      935         then do:
      936           message
      937             vss-workfile vss-revision vss-description skip
      938             vss-include-info4 skip
      939             "Невозможно найти товар на объекте" skip
      940             "Объект" p-obj-type p-obj-code skip
      941             "Артикул" p-artic p-prod-type p-prod-code skip
      942             error-status :get-message(1) skip
      943             return-value skip
      944             view-as alert-box error .
      945           undo, return error .
      946         end.
      947         find current buf_gds-obj exclusive-lock .
      948       end.
      949       run partslib-init-temp-parts in this-procedure
      950         (input p-obj-type
      951         ,input p-obj-code
      952         ,input p-artic
      953         ,input p-prod-type
      954         ,input p-prod-code
      955         ) no-error .
      956       if error-status :error
      957       then do:
      958         message
      959           vss-workfile vss-revision vss-description skip
      960           vss-include-info4 skip
      961           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      962           "Объект" p-obj-type p-obj-code skip
      963           "Артикул" p-artic p-prod-type p-prod-code skip
      964           "p-fact-order" p-fact-order skip
      965           view-as alert-box error .
      966         undo, return error .
      967       end.
      968       if p-include-fact-order = true
      969       then do:
      970         assign
      971           p-fact-order = p-fact-order - 0.0000000001
      972         .
      973       end.
      974       define variable v-max-fact-order as character no-undo .
      975       run factord-max-fact-order in this-procedure
      976         (output v-max-fact-order
      977         ) no-error .
      978       if error-status :error
      979       then do:
      980         message
      981           vss-workfile vss-revision vss-description skip
      982           vss-include-info4 skip
      983           "Ошибка при вызове процедуры factord-max-fact-order" skip
      984           "Объект" p-obj-type p-obj-code skip
      985           "Артикул" p-artic p-prod-type p-prod-code skip
      986           "p-fact-order" p-fact-order skip
      987           view-as alert-box error .
      988         undo, return error .
      989       end.
      990       run partslib-update-by-factord in this-procedure
      991         (input p-obj-type
      992         ,input p-obj-code
      993         ,input p-artic
      994         ,input p-prod-type
      995         ,input p-prod-code
      996         ,input p-fact-order
      997         ,input v-max-fact-order
      998         ,input false
      999         ) no-error .
     1000       if error-status :error
     1001       then do:
     1002         message
     1003           vss-workfile vss-revision vss-description skip
     1004           vss-include-info4 skip
     1005           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1006           "Объект" p-obj-type p-obj-code skip
     1007           "Артикул" p-artic p-prod-type p-prod-code skip
     1008           "p-fact-order" p-fact-order skip
     1009           "v-max-fact-order" v-max-fact-order skip
     1010           view-as alert-box error .
     1011         undo, return error .
     1012       end.
     1013     end.
     1014   end procedure.
     1015   procedure partslib-update-by-factord :
     1016     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1017     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1018     define input parameter p-artic              like ub.parts.artic     no-undo .
     1019     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1020     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1021     define input parameter p-start-fact-order   as decimal   no-undo .
     1022     define input parameter p-end-fact-order     as decimal   no-undo .
     1023     define input parameter p-lock-gds-obj       as logical   no-undo .
     1024     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1025     define buffer buf_gds-obj  for ub.gds-obj .
     1026     define buffer buf_doc-line for ub.doc-line .
     1027     define variable v-total-parts-qnty as decimal   no-undo .
     1028     define variable v-goods-gds-goods  as logical   no-undo .
     1029     define variable v-goods-twounit    as logical   no-undo .
     1030     do
     1031     on error undo, return error
     1032     :
     1033       if p-start-fact-order > p-end-fact-order
     1034       then do:
     1035         message
     1036           vss-workfile vss-revision vss-description skip
     1037           vss-include-info4 skip
     1038           "Ошибка задания входных параметров" skip
     1039           "Начало интервала превышает конец интервала" skip
     1040           "Объект" p-obj-type p-obj-code skip
     1041           "Артикул" p-artic p-prod-type p-prod-code skip
     1042           "p-start-fact-order" p-start-fact-order skip
     1043           "p-end-fact-order"   p-end-fact-order skip
     1044           view-as alert-box error .
     1045         undo, return error .
     1046       end.
     1047       if p-lock-gds-obj = true
     1048       then do:
     1049         do transaction
     1050         on error undo, return error
     1051         :
     1052   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1054     (input  p-obj-type
     1055     ,input  p-obj-code
     1056     ,input  p-artic
     1057     ,input  p-prod-type
     1058     ,input  p-prod-code
     1059     ,buffer buf_gds-obj
     1060     ) no-error .
     1061           if error-status :error
     1062           then do:
     1063             message
     1064               vss-workfile vss-revision vss-description skip
     1065               vss-include-info4 skip
     1066               "Невозможно найти gds-obj" skip
     1067               error-status :get-message(1) skip
     1068               return-value skip
     1069               view-as alert-box error .
     1070             undo, return error .
     1071           end.
     1072           find current buf_gds-obj exclusive-lock .
     1073         end.
     1074       end.
     1075   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1077     (input  p-artic
     1078     ,input  p-prod-type
     1079     ,input  p-prod-code
     1080     ,input  'gds-goods=request':u
     1081     ,output v-goods-gds-goods
     1082     ) no-error .
     1083       if error-status :error
     1084       then do:
     1085         message
     1086           vss-workfile vss-revision vss-description skip
     1087           vss-include-info4 skip
     1088           "Ошибка при определении атрибута товара" skip
     1089           "Артикул" p-artic p-prod-type p-prod-code skip
     1090           "gds-goods=request" skip
     1091           error-status :get-message(1) skip
     1092           return-value skip
     1093           view-as alert-box error .
     1094         undo, return error return-value .
     1095       end.
     1096   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1097   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1098     (input  p-artic
     1099     ,input  p-prod-type
     1100     ,input  p-prod-code
     1101     ,input  'twounit=request':u
     1102     ,output v-goods-twounit
     1103     ) no-error .
     1104       if error-status :error
     1105       then do:
     1106         message
     1107           vss-workfile vss-revision vss-description skip
     1108           vss-include-info4 skip
     1109           "Ошибка при определении атрибута товара" skip
     1110           "Артикул" p-artic p-prod-type p-prod-code skip
     1111           "twounit=request" skip
     1112           error-status :get-message(1) skip
     1113           return-value skip
     1114           view-as alert-box error .
     1115         undo, return error return-value .
     1116       end.
     1117       for each buf_doc-line no-lock
     1118         where buf_doc-line.obj-type   = p-obj-type
     1119           and buf_doc-line.obj-code   = p-obj-code
     1120           and buf_doc-line.artic      = p-artic
     1121           and buf_doc-line.prod-type  = p-prod-type
     1122           and buf_doc-line.prod-code  = p-prod-code
     1123           and buf_doc-line.status_    = 'факт':U
     1124           and buf_doc-line.fact-order > p-start-fact-order
     1125           and buf_doc-line.fact-order <= p-end-fact-order
     1126       on error undo, return error
     1127       :
     1128         run partslib-process-document in this-procedure
     1129           (input  buf_doc-line.doc-code
     1130           ,input  p-obj-type
     1131           ,input  p-obj-code
     1132           ,input  p-artic
     1133           ,input  p-prod-type
     1134           ,input  p-prod-code
     1135           ,input  v-goods-gds-goods
     1136           ,input  v-goods-twounit
     1137           ,output v-total-parts-qnty
     1138           ) no-error .
     1139         if error-status :error
     1140         then do:
     1141           message
     1142             vss-workfile vss-revision vss-description skip
     1143             vss-include-info4 skip
     1144             "Ошибка при вызове процедуры partslib-process-document" skip
     1145             "Документ" buf_doc-line.doc-code skip
     1146             "Объект" p-obj-type p-obj-code skip
     1147             "Артикул" p-artic p-prod-type p-prod-code skip
     1148             "p-start-fact-order" p-start-fact-order skip
     1149             "p-end-fact-order" p-end-fact-order skip
     1150             error-status :get-message(1) skip
     1151             return-value skip
     1152             view-as alert-box error .
     1153           undo, return error return-value .
     1154         end.
     1155       end.
     1156     end.
     1157   end procedure.
     1158   procedure partslib-process-document :
     1159     define input  parameter p-doc-code         as character no-undo .
     1160     define input  parameter p-obj-type         as character no-undo .
     1161     define input  parameter p-obj-code         as integer   no-undo .
     1162     define input  parameter p-artic            as character no-undo .
     1163     define input  parameter p-prod-type        as character no-undo .
     1164     define input  parameter p-prod-code        as integer   no-undo .
     1165     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1166     define input  parameter p-goods-twounit    as logical   no-undo .
     1167     define output parameter p-total-parts-qnty as decimal   no-undo .
     1168     define variable v-parts-sign as integer   no-undo .
     1169     define buffer buf_trn-doc    for ub.trn-doc .
     1170     define buffer buf_doc-line   for ub.doc-line .
     1171     define buffer buf_parts      for ub.parts .
     1172     define buffer buf_temp-parts for temp-parts .
     1173     do
     1174     on error undo, return error return-value
     1175     :
     1176       find first buf_trn-doc no-lock
     1177         where buf_trn-doc.doc-code = p-doc-code
     1178         no-error .
     1179       if not available buf_trn-doc
     1180       then do:
     1181         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1182                                      ,p-doc-code
     1183                                      ) .
     1184       end.
     1185       case buf_trn-doc.doc-type
     1186       :
     1187         when 'при':U or
     1188         when 'возврат':U or
     1189         when 'инв':U
     1190         then do:
     1191           assign
     1192             v-parts-sign = -1
     1193           .
     1194         end.
     1195         when 'рас':U or
     1196         when 'спи':U
     1197         then do:
     1198           assign
     1199             v-parts-sign = 1
     1200           .
     1201         end.
     1202         otherwise do:
     1203           undo, return error substitute("Неизвестный тип документа &1"
     1204                                       ,buf_trn-doc.doc-type
     1205                                       ) .
     1206         end.
     1207       end.
     1208       find first buf_doc-line no-lock
     1209         where buf_doc-line.doc-code  = p-doc-code
     1210           and buf_doc-line.artic     = p-artic
     1211           and buf_doc-line.prod-type = p-prod-type
     1212           and buf_doc-line.prod-code = p-prod-code
     1213         no-error .
     1214       if not available buf_doc-line
     1215       then do:
     1216         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1217                                      ,p-doc-code
     1218                                      ,artic
     1219                                      ,prod-type
     1220                                      ,prod-code
     1221                                      ) .
     1222       end.
     1223       assign
     1224         p-total-parts-qnty = 0
     1225       .
     1226       if p-goods-gds-goods = true
     1227       then do:
     1228         for each buf_parts no-lock
     1229           where buf_parts.out-code  = p-doc-code
     1230             and buf_parts.obj-type  = p-obj-type
     1231             and buf_parts.obj-code  = p-obj-code
     1232             and buf_parts.artic     = p-artic
     1233             and buf_parts.prod-type = p-prod-type
     1234             and buf_parts.prod-code = p-prod-code
     1235         on error undo, return error
     1236         :
     1237           run partslib-create-temp-parts in this-procedure
     1238             (buffer buf_parts
     1239             ,buffer buf_temp-parts
     1240             ,input  p-goods-twounit
     1241             ) .
     1242           assign
     1243             p-total-parts-qnty        = p-total-parts-qnty
     1244                                       + v-parts-sign * buf_parts.fact-qnty
     1245             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1246                                       + v-parts-sign * buf_parts.fact-qnty
     1247             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1248                                       + v-parts-sign * buf_parts.fact-qnty
     1249             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1250                                       + v-parts-sign * buf_parts.cli-qnty
     1251           .
     1252           if buf_temp-parts.qnty = 0
     1253           then do:
     1254             delete buf_temp-parts .
     1255           end.
     1256         end.
     1257       end.
     1258       else do:
     1259         assign
     1260           p-total-parts-qnty = p-total-parts-qnty
     1261                              + v-parts-sign * buf_doc-line.fact-qnty
     1262         .
     1263       end.
     1264     end.
     1265   end procedure.
     1266   procedure partslib-init-temp-parts-by-date :
     1267     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1268     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1269     define input parameter p-artic           like ub.parts.artic     no-undo .
     1270     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1271     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1272     define input parameter p-fact-date       as date      no-undo .
     1273     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1274     do
     1275     on error undo, return error
     1276     :
     1277       define variable v-fact-order                as decimal   no-undo .
     1278       define variable v-shift-end-fact-order      as decimal   no-undo .
     1279       define variable v-day-end-fact-order        as decimal   no-undo .
     1280       run factord in this-procedure
     1281         (input  p-fact-date
     1282         ,input  1
     1283         ,input  1
     1284         ,input  ?
     1285         ,input  0
     1286         ,input  false
     1287         ,output v-fact-order
     1288         ,output v-shift-end-fact-order
     1289         ,output v-day-end-fact-order
     1290         ) no-error .
     1291       if error-status :error
     1292       then do:
     1293         message
     1294           vss-workfile vss-revision vss-description skip
     1295           vss-include-info4 skip
     1296           "Ошибка при определении момента времени, на который требуется остаток" skip
     1297           "Объект" p-obj-type p-obj-code skip
     1298           "Артикул" p-artic p-prod-type p-prod-code skip
     1299           "Дата" p-fact-date skip
     1300           view-as alert-box error .
     1301         undo, return error .
     1302       end.
     1303       run partslib-init-temp-parts-by-factord in this-procedure
     1304         (input p-obj-type
     1305         ,input p-obj-code
     1306         ,input p-artic
     1307         ,input p-prod-type
     1308         ,input p-prod-code
     1309         ,input v-day-end-fact-order
     1310         ,input false
     1311         ) no-error .
     1312       if error-status :error
     1313       then do:
     1314         message
     1315           vss-workfile vss-revision vss-description skip
     1316           vss-include-info4 skip
     1317           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1318           "Объект" p-obj-type p-obj-code skip
     1319           "Артикул" p-artic p-prod-type p-prod-code skip
     1320           "Дата" p-fact-date skip
     1321           view-as alert-box error .
     1322         undo, return error .
     1323       end.
     1324     end.
     1325   end procedure.
     1326   procedure partslib-calc-cost :
     1327     define output parameter p-fact-qnty      as decimal   no-undo .
     1328     define output parameter p-vat-pc         as decimal   no-undo .
     1329     define output parameter p-slt-pc         as decimal   no-undo .
     1330     define output parameter p-sum-base       as decimal   no-undo .
     1331     define output parameter p-sum-rubl       as decimal   no-undo .
     1332     define output parameter p-vat-base       as decimal   no-undo .
     1333     define output parameter p-vat-rubl       as decimal   no-undo .
     1334     define output parameter p-slt-base       as decimal   no-undo .
     1335     define output parameter p-slt-rubl       as decimal   no-undo .
     1336     define output parameter p-road-tax-base  as decimal   no-undo .
     1337     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1338     define output parameter p-transport-base as decimal   no-undo .
     1339     define output parameter p-transport-rubl as decimal   no-undo .
     1340     define output parameter p-other-base     as decimal   no-undo .
     1341     define output parameter p-other-rubl     as decimal   no-undo .
     1342     define output parameter p-excise-base    as decimal   no-undo .
     1343     define output parameter p-excise-rubl    as decimal   no-undo .
     1344     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1345     do
     1346     on error undo, return error return-value
     1347     :
     1348       define buffer buf_temp-parts for temp-parts .
     1349       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1350       define buffer   in-vatp-parts    for ub.parts   .
     1351       define buffer   in-vatp-doc      for ub.trn-doc .
     1352       define buffer   in-vatp-goods    for ub.goods   .
     1353       define buffer   in-vatp-sysconf  for ub.sysconf .
     1354       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1355       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1356       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1357       define variable varinvprb                  as   character              no-undo.
     1358       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1359       define variable cli-base-rate              as   decimal                no-undo.
     1360       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1361       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1362       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1363       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1364       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1365       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1366       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1367       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1368       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1369       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1370       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1371       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1372       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1373       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1374       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1375       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1376       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1377       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1378       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1379       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1380       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1381       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1382       define variable varinvatp-envd             as   character              no-undo.
     1383       define variable varinvatp-type             as   character              no-undo.
     1384       for each buf_temp-parts
     1385       on error undo, return error
     1386       :
     1387   assign
     1388     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1389     price-base-with-tax-loc = buf_temp-parts.price-base
     1390   .
     1391   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1392   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1393     (output varinvprb
     1394     )  .
     1395     if buf_temp-parts.out-code = 'free-zone':U     or
     1396        buf_temp-parts.out-code = 'out-zone':U   or
     1397        buf_temp-parts.doc-type = 'акт':U then do:
     1398       assign
     1399         in-vatp-have-vat-slt = yes.
     1400     end.
     1401     else do:
     1402       find first in-vatp_doc-attr no-lock
     1403         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1404           and in-vatp_doc-attr.attr-code = 'envd':U
     1405         no-error .
     1406       if not available in-vatp_doc-attr then do:
     1407         assign
     1408           in-vatp-have-vat-slt = yes.
     1409       end.
     1410       else do:
     1411            in-vatp-have-vat-slt = no.
     1412       end.
     1413     end.
     1414     assign
     1415      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1416      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1417     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1418              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1419     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1420             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1421             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1422             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1423             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1424             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1425             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1426       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1427     assign
     1428       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1429     assign
     1430       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1431       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1432       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1433       transport-cli-loc  = 0
     1434       other-cli-loc      = 0
     1435     .
     1436   ASSIGN
     1437             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1438       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1439   .
     1440         assign
     1441           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1442           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1443           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1444           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1445           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1446           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1447           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1448           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1449           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1450           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1451           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1452           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1453           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1454           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1455           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1456           p-excise-base    = p-excise-base    + 0
     1457           p-excise-rubl    = p-excise-rubl    + 0
     1458         .
     1459       end.
     1460       if p-fact-qnty      = ?
     1461       or p-sum-base       = ?
     1462       or p-sum-rubl       = ?
     1463       or p-vat-base       = ?
     1464       or p-vat-rubl       = ?
     1465       or p-slt-base       = ?
     1466       or p-slt-rubl       = ?
     1467       or p-road-tax-base  = ?
     1468       or p-road-tax-rubl  = ?
     1469       or p-transport-base = ?
     1470       or p-transport-rubl = ?
     1471       or p-other-base     = ?
     1472       or p-other-rubl     = ?
     1473       or p-excise-base    = ?
     1474       or p-excise-rubl    = ?
     1475       then do:
     1476         message
     1477           vss-workfile vss-revision vss-description skip
     1478           vss-include-info4 skip
     1479           "Программа in-vatp.i вернула неопределенные значения" skip
     1480           "p-fact-qnty"      p-fact-qnty      skip
     1481           "p-sum-base"       p-sum-base       skip
     1482           "p-sum-rubl"       p-sum-rubl       skip
     1483           "p-vat-base"       p-vat-base       skip
     1484           "p-vat-rubl"       p-vat-rubl       skip
     1485           "p-slt-base"       p-slt-base       skip
     1486           "p-slt-rubl"       p-slt-rubl       skip
     1487           "p-road-tax-base"  p-road-tax-base  skip
     1488           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1489           "p-transport-base" p-transport-base skip
     1490           "p-transport-rubl" p-transport-rubl skip
     1491           "p-other-base"     p-other-base     skip
     1492           "p-other-rubl"     p-other-rubl     skip
     1493           "p-excise-base"    p-excise-base    skip
     1494           "p-excise-rubl"    p-excise-rubl    skip
     1495           view-as alert-box error .
     1496         undo, return error .
     1497       end.
     1498     end.
     1499   end procedure.
