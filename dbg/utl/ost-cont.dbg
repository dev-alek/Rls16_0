     1753   define variable v-fact-order   as decimal   no-undo .
     1754   define buffer buf_gds-obj for gds-obj.
     1755   define buffer buf_arh-trn-doc-contract for arh-trn-doc-contract.
     1756   define temp-table temp-contr no-undo
     1757     field host-code as integer
     1758     field contract-code as integer
     1759     field cli-code      as integer
     1760     field cli-type      as character
     1761     field sum-base       as decimal
     1762     field sum-rubl       as decimal
     1763     field sum-vat-base   as decimal
     1764     field sum-vat-rubl   as decimal
     1765     field sum-slt-base   as decimal
     1766     field sum-slt-rubl   as decimal
     1767     field sum-rdt-base   as decimal
     1768     field sum-rdt-rubl   as decimal
     1769     field sum-transp-base as decimal
     1770     field sum-transp-rubl as decimal
     1771     field sum-other-base  as decimal
     1772     field sum-other-rubl  as decimal
     1773     INDEX pi  IS PRIMARY  host-code contract-code cli-type cli-code
     1774   .
     1775     define variable v-num as integer   no-undo .
     1776     run gbl/d-askw.w
     1777       (input "Вопрос"
     1778       ,input "Создание записи остатков финансового архива arh-trn-doc-contract" + chr(10)
     1779       ,input "|^"
     1780       ,input "Все объекты^confirm|Выбрать объекты|Отмена"
     1781       ,input "|"
     1782            + "|"
     1783            + ""
     1784       ,input 1
     1785       ,input 3
     1786       ,output v-num
     1787       ).
     1788   define variable v-account as integer init 0 no-undo .
     1789   define variable v-account-lavel as character no-undo .
     1790   define variable v-button-stop as logical no-undo .
     1791   define variable v-kol-spice as integer no-undo .
     1792   define variable v-kol-spice2 as integer no-undo .
     1793   define variable v-kol-spice3 as integer no-undo .
     1794   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1795   DEFINE BUTTON StopBtn AUTO-END-KEY
     1796        LABEL "Стоп"
     1797        SIZE 10 BY 1.
     1798   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1799        LABEL "Обработано записей"
     1800         VIEW-AS TEXT
     1801        SIZE 14 BY .67 NO-UNDO.
     1802   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1803         VIEW-AS TEXT
     1804        SIZE 53.25 BY .67
     1805        FGCOLOR 1  NO-UNDO.
     1806   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1807         VIEW-AS TEXT
     1808        SIZE 53.25 BY .67
     1809        FGCOLOR 1  NO-UNDO.
     1810   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1811         VIEW-AS TEXT
     1812        SIZE 53.25 BY .67
     1813        FGCOLOR 1  NO-UNDO.
     1814   DEFINE RECTANGLE RECT-1
     1815        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1816        SIZE 55.13 BY 4.46.
     1817   DEFINE FRAME InfoFrame
     1818        StopBtn AT ROW 4.25 COL 21.75
     1819        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1820        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1821        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1822        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1823        RECT-1 AT ROW 1 COL 1
     1824       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1825            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1826            TITLE "Процесс"
     1827            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1828   define variable mFrameView      as logical   no-undo init yes.
     1829     define variable mFramHandle as handle no-undo.
     1830     mFramHandle = frame InfoFrame:handle.
     1831     if  log-manager:logfile-name ne ?
     1832     then DO:
     1833         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1834         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1835         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1836     end.
     1837     mFrameView = not session:batch-mode and mFramHandle:visible.
     1838     if mFrameView
     1839     then do:
     1840       ASSIGN
     1841          FRAME InfoFrame:HIDDEN                           = TRUE
     1842          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1843     end.
     1844   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1845   DO:
     1846     IF not StopProcessing THEN
     1847       Message "Вы действительно хотите прервать" SKIP
     1848               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1849                 UPDATE StopProcessing.
     1850     IF StopProcessing THEN do:
     1851        if mFrameView
     1852        then do:
     1853           HIDE FRAME InfoFrame.
     1854        end.
     1855     End.
     1856   END.
     1857   assign v-account = ( if integer( 5 ) = 0 then 100 else integer( 5 ) ).
     1858     if  log-manager:logfile-name ne ?
     1859     then DO:
     1860         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1861     end.
     1862     if not session:batch-mode then
     1863     do:
     1864       VIEW FRAME InfoFrame.
     1865       mFrameView = true.
     1866     end.
     1867      v-button-stop = false .
     1868         if mFrameView
     1869         then do:
     1870         if v-button-stop then view STOPBTN in frame InfoFrame.
     1871                          else Hide STOPBTN in frame InfoFrame.
     1872         end.
     1873     case v-num :
     1874       when 1
     1875       then do:
     1876         define buffer buf_db for ub.db .
     1877         define buffer buf_clients for ub.clients .
     1878         for each buf_db no-lock
     1879         ,each buf_clients no-lock where buf_clients.db-num = buf_db.db-num
     1880         on error undo, return error return-value :
     1881           if buf_clients.stts = 0  then do:
     1882             run calc-archive in this-procedure ( input buf_clients.obj-type, input buf_clients.obj-code ).
     1883           end.
     1884         end.
     1885       end.
     1886       when 2
     1887       then do:
     1888         define variable v-user-select as logical   no-undo .
     1889   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1890   run userobjs_select-many in this-procedure
     1891     (input  parparentproc
     1892     ,input  v-cntxt-db-num
     1893     ,input  v-cntxt-userid
     1894     ,input  v-cntxt-host-code-obj
     1895     ,input  v-cntxt-obj-type
     1896     ,input  v-cntxt-obj-code
     1897     ,output v-user-select
     1898     )  .
     1899         if v-user-select <> true then do:
     1900           message "Объект не выбран" view-as alert-box information .
     1901           return .
     1902         end.
     1903         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1904         for each buf_userobjs_temp-user-obj on error undo, return error return-value :
     1905           run calc-archive in this-procedure (input buf_userobjs_temp-user-obj.obj-type, input buf_userobjs_temp-user-obj.obj-code ).
     1906         end.
     1907       end.
     1908       otherwise do:
     1909         return .
     1910       end.
     1911     end.
     1912   if mFrameView
     1913   then do:
     1914      HIDE FRAME InfoFrame.
     1915   end.
     1916     message   "Работа утилиты завершена"   view-as alert-box.
     1917   procedure calc-archive :
     1918     do on error undo, return error return-value :
     1919       define input  parameter p-obj-type like clients.obj-type .
     1920       define input  parameter p-obj-code like clients.obj-code .
     1921       find first clients no-lock where clients.obj-type = p-obj-type and clients.obj-code = p-obj-code .
     1922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cutd-obj in g#library
     1923     (input  p-obj-type
     1924     ,input  p-obj-code
     1925     ,output p-status
     1926     ,output p-cut-date
     1927     ,output p-cut-fin-date
     1928     )  .
     1929       if p-status = 2 or  p-status = 4 then do:
     1930         run factord-end-day in this-procedure ( input p-cut-date - 1, output v-fact-order ).
     1931         for each temp-contr : delete temp-contr . end.
     1932         for each buf_gds-obj no-lock where buf_gds-obj.obj-type = p-obj-type and buf_gds-obj.obj-code = p-obj-code :
     1933           for each temp-parts : delete temp-parts . end.
     1934           run partslib-init-temp-parts-by-factord (input p-obj-type,
     1935                                                input p-obj-code,
     1936                                                input buf_gds-obj.artic,
     1937                                                input buf_gds-obj.prod-type,
     1938                                                input buf_gds-obj.prod-code,
     1939                                                input v-fact-order,
     1940                                                false) .
     1941           for each temp-parts use-index contr break by temp-parts.contract-code :
     1942             find first temp-contr
     1943               where temp-contr.contract-code = temp-parts.contract-code
     1944                 and temp-contr.host-code     = temp-parts.host-code
     1945                 and temp-contr.cli-code      = temp-parts.supp-code
     1946                 and temp-contr.cli-type      = temp-parts.supp-type
     1947             no-error .
     1948             if not available temp-contr then do:
     1949               create temp-contr .
     1950               assign
     1951                 temp-contr.host-code     = temp-parts.host-code
     1952                 temp-contr.contract-code = temp-parts.contract-code
     1953                 temp-contr.cli-code      = temp-parts.supp-code
     1954                 temp-contr.cli-type      = temp-parts.supp-type
     1955               .
     1956             end.
     1957   assign
     1958     price-rubl-with-tax-loc = temp-parts.price-rubl
     1959     price-base-with-tax-loc = temp-parts.price-base
     1960   .
     1961   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1962   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1963     (output varinvprb
     1964     )  .
     1965     if temp-parts.out-code = 'free-zone':U     or
     1966        temp-parts.out-code = 'out-zone':U   or
     1967        temp-parts.doc-type = 'акт':U then do:
     1968       assign
     1969         in-vatp-have-vat-slt = yes.
     1970     end.
     1971     else do:
     1972       find first in-vatp_doc-attr no-lock
     1973         where in-vatp_doc-attr.doc-code  = temp-parts.out-code
     1974           and in-vatp_doc-attr.attr-code = 'envd':U
     1975         no-error .
     1976       if not available in-vatp_doc-attr then do:
     1977         assign
     1978           in-vatp-have-vat-slt = yes.
     1979       end.
     1980       else do:
     1981            in-vatp-have-vat-slt = no.
     1982       end.
     1983     end.
     1984     assign
     1985      price-cli-with-tax-loc = temp-parts.price-cli
     1986      cli-base-rate          = temp-parts.cli-base-rate.
     1987     ASSIGN   road-tax-base-loc  = (if temp-parts.road-tax-base  = ? then 0 else temp-parts.road-tax-base)
     1988              road-tax-rubl-loc  = (if temp-parts.road-tax-rubl  = ? then 0 else temp-parts.road-tax-rubl).
     1989     ASSIGN  transport-base-loc = (if temp-parts.transport-base = ? then 0 else temp-parts.transport-base)
     1990             transport-rubl-loc = (if temp-parts.transport-rubl = ? then 0 else temp-parts.transport-rubl)
     1991             other-base-loc     = (if temp-parts.other-base     = ? then 0 else temp-parts.other-base)
     1992             other-rubl-loc     = (if temp-parts.other-rubl     = ? then 0 else temp-parts.other-rubl)
     1993             vat-pc-loc         = (if temp-parts.vat-pc         = ? then 0 else temp-parts.vat-pc)
     1994             slt-pc-loc         = (if temp-parts.slt-pc         = ? then 0 else temp-parts.slt-pc).
     1995             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1996       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1997     assign
     1998       exch-rate-cli-loc = (temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / temp-parts.price-cli .
     1999     assign
     2000       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2001       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2002       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2003       transport-cli-loc  = 0
     2004       other-cli-loc      = 0
     2005     .
     2006   ASSIGN
     2007             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2008       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2009   .
     2010             assign
     2011               temp-contr.sum-base        = temp-contr.sum-base        + price-base-with-tax-loc * temp-parts.fact-qnty
     2012               temp-contr.sum-rubl        = temp-contr.sum-rubl        + price-rubl-with-tax-loc * temp-parts.fact-qnty
     2013               temp-contr.sum-vat-base    = temp-contr.sum-vat-base    + vat-base-loc            * temp-parts.fact-qnty
     2014               temp-contr.sum-vat-rubl    = temp-contr.sum-vat-rubl    + vat-rubl-loc            * temp-parts.fact-qnty
     2015               temp-contr.sum-slt-base    = temp-contr.sum-slt-base    + slt-base-loc            * temp-parts.fact-qnty
     2016               temp-contr.sum-slt-rubl    = temp-contr.sum-slt-rubl    + slt-rubl-loc            * temp-parts.fact-qnty
     2017               temp-contr.sum-rdt-base    = temp-contr.sum-rdt-base    + road-tax-base-loc       * temp-parts.fact-qnty
     2018               temp-contr.sum-rdt-rubl    = temp-contr.sum-rdt-rubl    + road-tax-rubl-loc       * temp-parts.fact-qnty
     2019               temp-contr.sum-transp-base = temp-contr.sum-transp-base + transport-base-loc      * temp-parts.fact-qnty
     2020               temp-contr.sum-transp-rubl = temp-contr.sum-transp-rubl + transport-rubl-loc      * temp-parts.fact-qnty
     2021               temp-contr.sum-other-base  = temp-contr.sum-other-base  + other-base-loc          * temp-parts.fact-qnty
     2022               temp-contr.sum-other-rubl  = temp-contr.sum-other-rubl  + other-rubl-loc          * temp-parts.fact-qnty
     2023             .
     2024           end.
     2025         end.
     2026         for each temp-contr :
     2027           if temp-contr.sum-base = 0 and temp-contr.sum-rubl = 0 then next .
     2028           create buf_arh-trn-doc-contract .
     2029           assign
     2030             buf_arh-trn-doc-contract.cli-code          = temp-contr.cli-code
     2031             buf_arh-trn-doc-contract.cli-type          = temp-contr.cli-type
     2032             buf_arh-trn-doc-contract.contract-code     = temp-contr.contract-code
     2033             buf_arh-trn-doc-contract.host-code         = temp-contr.host-code
     2034             buf_arh-trn-doc-contract.doc-code          = "остаток"
     2035             buf_arh-trn-doc-contract.doc-date          = p-cut-date
     2036             buf_arh-trn-doc-contract.ext-doc-type      = 'ie':U
     2037             buf_arh-trn-doc-contract.fact-date         = p-cut-date
     2038             buf_arh-trn-doc-contract.fact-order        = v-fact-order
     2039             buf_arh-trn-doc-contract.obj-code          = p-obj-code
     2040             buf_arh-trn-doc-contract.obj-type          = p-obj-type
     2041             buf_arh-trn-doc-contract.shift-date        = p-cut-date
     2042             buf_arh-trn-doc-contract.shift-num         = 0
     2043             buf_arh-trn-doc-contract.sum-type          = "":u
     2044             buf_arh-trn-doc-contract.inc-sum-base        = temp-contr.sum-base
     2045             buf_arh-trn-doc-contract.inc-sum-rubl        = temp-contr.sum-rubl
     2046             buf_arh-trn-doc-contract.inc-sum-vat-base    = temp-contr.sum-vat-base
     2047             buf_arh-trn-doc-contract.inc-sum-vat-rubl    = temp-contr.sum-vat-rubl
     2048             buf_arh-trn-doc-contract.inc-sum-slt-base    = temp-contr.sum-slt-base
     2049             buf_arh-trn-doc-contract.inc-sum-slt-rubl    = temp-contr.sum-slt-rubl
     2050             buf_arh-trn-doc-contract.inc-sum-rdt-base    = temp-contr.sum-rdt-base
     2051             buf_arh-trn-doc-contract.inc-sum-rdt-rubl    = temp-contr.sum-rdt-rubl
     2052             buf_arh-trn-doc-contract.inc-sum-transp-base = temp-contr.sum-transp-base
     2053             buf_arh-trn-doc-contract.inc-sum-transp-rubl = temp-contr.sum-transp-rubl
     2054             buf_arh-trn-doc-contract.inc-sum-other-base  = temp-contr.sum-other-base
     2055             buf_arh-trn-doc-contract.inc-sum-other-rubl  = temp-contr.sum-other-rubl
     2056           .
     2057         end.
     2058       end.
     2059     end.
     2060   end procedure.
