     4197   function WghProdVariable return logical
     4198       (input p-obj-type as char,
     4199        input p-obj-code as integer,
     4200        input p-gds-code as integer) :
     4201      define variable v-wgh-val  as character no-undo.
     4202      define variable v-par-val  as character no-undo.
     4203      define variable v-par-type as character no-undo.
     4204      define variable vMarking        as logical no-undo.
     4205      define variable vArtic          as logical no-undo.
     4206      define variable vTransitional   as logical no-undo.
     4207      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4208         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4209           ( p-gds-code,
     4210             'weighed-gds':U,
     4211              output v-wgh-val,
     4212              output v-par-type
     4213           ).
     4214       if logical(v-wgh-val) = yes then do:
     4215           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4216               ( p-gds-code,
     4217                 'mark-type':U,
     4218                  output v-par-val,
     4219                  output v-par-type
     4220               ).
     4221           if v-par-val <> "" then do:
     4222               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     4223               assign
     4224                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     4225                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     4226                  .
     4227           end.
     4228      end.
     4229      if v-wgh-val > "" and (vMarking or vArtic)
     4230      then return yes.
     4231      else return no.
     4232   end.
     4233   function MarkWeight return decimal
     4234      ( input p-mark as character) :
     4235      define buffer  buf_marking-attr for  ub.marking-attr.
     4236      define variable vMarkWeight as decimal no-undo.
     4237      vMarkWeight = 0.
     4238      if p-mark <> "" and p-mark <> ?
     4239      then do:
     4240          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     4241                                        and buf_marking-attr.attr-code eq "weight"
     4242             no-lock no-error.
     4243          if not available buf_marking-attr
     4244          then do :
     4245            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     4246                                          and buf_marking-attr.attr-code eq "weight"
     4247               no-lock no-error.
     4248          end .
     4249          if avail buf_marking-attr
     4250          then vMarkWeight = dec(buf_marking-attr.attr-value).
     4251      end.
     4252      return vMarkWeight.
     4253   end.
     4254   define variable v-today as date      no-undo.
     4255   define variable v-host-code like ub.trn-doc.host no-undo .
     4256   define variable v-base-rate like ub.trn-doc.base-rate no-undo .
     4257   define variable v-base-scale like ub.trn-doc.base-scale no-undo .
     4258   define variable v-userid as character no-undo .
     4259   define variable v-print-rubl as logical   no-undo .
     4260   define variable v-curr-r-b as character no-undo .
