     4626           undo, return error v-end-message .
     4627         end.
     4628         if TempDocPart.fact-qnty > TempDocPart.doc-qnty then do:
     4629           v-end-message =  substitute("Ошибка в документе внутреннего перемещения &1 . фактическое количество в партии не может превышать количество в партии по документу." ,
     4630                   TempTrnDoc.out-code ).
     4631           run pcall-log-file in parparentproc (input v-end-message) .
     4632           undo, return error v-end-message .
     4633         end.
     4634         if TempTrnDoc.ext-doc-type = 'iv':U
     4635         and TempDocPart.fact-qnty  <> 0
     4636         then do:
     4637           assign
     4638             v-part-chg-qnty = TempDocPart.fact-qnty
     4639           .
     4640         end.
     4641         if TempTrnDoc.ext-doc-type = 'rv':U
     4642         and TempDocPart.fact-qnty < TempDocPart.doc-qnty then do:
     4643           assign
     4644             v-part-chg-qnty = TempDocPart.doc-qnty - TempDocPart.fact-qnty
     4645           .
     4646         end.
     4647         if v-part-chg-qnty = 0 then do:
     4648           next.
     4649         end.
     4650         if TempDocPart.price-rubl = ?
     4651         or TempDocPart.price-rubl = 0
     4652         then do :
     4653           find first orig_parts no-lock where orig_parts.in-code  = TempDocPart.in-doc-id
     4654                                           and orig_parts.part-code = TempDocPart.part-id
     4655                                           and orig_parts.obj-type  = buf_trn-doc.obj-type
     4656                                           and orig_parts.obj-code  = buf_trn-doc.obj-code
     4657                                           and orig_parts.artic     = buf_doc-line.artic
     4658                                           and orig_parts.prod-type = buf_doc-line.prod-type
     4659                                           and orig_parts.prod-code = buf_doc-line.prod-code
     4660                                           no-error .
     4661           if not available orig_parts
     4662           then do :
     4663             if index(buf_trn-doc.doc-code, "*") > 0
     4664             then
     4665             find first orig_parts no-lock where orig_parts.out-code  = replace(buf_trn-doc.doc-code, "*", "-")
     4666                                             and orig_parts.part-code = TempDocPart.part-id
     4667                                             and orig_parts.obj-type  = buf_trn-doc.obj-type
     4668                                             and orig_parts.obj-code  = buf_trn-doc.obj-code
     4669                                             and orig_parts.artic     = buf_doc-line.artic
     4670                                             and orig_parts.prod-type = buf_doc-line.prod-type
     4671                                             and orig_parts.prod-code = buf_doc-line.prod-code
     4672                                             no-error .
     4673             if available orig_parts
     4674             then do :
     4675               TempDocPart.in-doc-id = orig_parts.in-code .
     4676             end .
     4677           end .
     4678           if not available orig_parts
     4679           then do :
     4680             if index(buf_trn-doc.doc-code, "*") > 0
     4681             then
     4682             find first orig_parts no-lock where orig_parts.out-code = replace(buf_trn-doc.doc-code, "*", "-")
     4683                                             and orig_parts.obj-type  = buf_trn-doc.obj-type
     4684                                             and orig_parts.obj-code  = buf_trn-doc.obj-code
     4685                                             and orig_parts.artic     = buf_doc-line.artic
     4686                                             and orig_parts.prod-type = buf_doc-line.prod-type
     4687                                             and orig_parts.prod-code = buf_doc-line.prod-code
     4688                                             no-error .
     4689             if available orig_parts
     4690             then do :
     4691               TempDocPart.part-id = orig_parts.part-code .
     4692               TempDocPart.in-doc-id = orig_parts.in-code .
     4693             end .
     4694           end .
     4695           if available orig_parts
     4696           then do :
     4697             TempDocPart.price-rubl = orig_parts.price-rubl .
     4698           end .
     4699         end .
     4700         if TempDocPart.price-rubl = ?
     4701         or TempDocPart.price-rubl = 0
     4702         then do :
     4703           TempDocPart.price-rubl = buf_doc-line.price-rubl .
     4704         end .
     4705         create buf_parts .
     4706         buffer-copy buf_doc-line to buf_parts
     4707         assign
     4708           buf_parts.in-code   = TempDocPart.in-doc-id
     4709           buf_parts.out-code  = buf_trn-doc.doc-code
     4710           buf_parts.obj-type  = buf_trn-doc.obj-type
     4711           buf_parts.obj-code  = buf_trn-doc.obj-code
     4712           buf_parts.host-code = buf_trn-doc.host-code
     4713           buf_parts.supp-type  = buf_trn-doc.cli-type
     4714           buf_parts.supp-code  = buf_trn-doc.cli-code
     4715           buf_parts.status_   = no
     4716           buf_parts.rsrv-free = ?
     4717           buf_parts.pl-code   = 0
     4718           buf_parts.qnty      = v-part-chg-qnty
     4719           buf_parts.fact-qnty = if buf_trn-doc.ext-doc-type = 'rv':U
     4720                                 then v-part-chg-qnty
     4721                                 else 0
     4722           buf_parts.cli-qnty  = 0
     4723           buf_parts.part-code = TempDocPart.part-id
     4724           buf_parts.price-rubl = TempDocPart.price-rubl
     4725           buf_parts.price-base = TempDocPart.price-rubl
     4726           buf_parts.price-cli  = TempDocPart.price-rubl
     4727           buf_parts.VAT-pc     = buf_doc-line.vat-pc
     4728           buf_parts.purch-code = buf_trn-doc.purch-code
     4729           buf_parts.exch-code      = 0
     4730           buf_parts.pay-code       = buf_trn-doc.pay-code
     4731           buf_parts.is-supp        = yes
     4732           buf_parts.VAT-type       = buf_trn-doc.vat-type
     4733           buf_parts.SLT-type       = 'без':U
     4734           buf_parts.cst-code       = ""
     4735           buf_parts.last-date      = ?
     4736           buf_parts.road-tax-base  = 0
     4737           buf_parts.road-tax-rubl  = 0
     4738           buf_parts.transport-base = 0
     4739           buf_parts.transport-rubl = 0
     4740           buf_parts.other-base     = 0
     4741           buf_parts.other-rubl     = 0
     4742         .
     4743         if num-entries(buf_parts.part-code, "_") = 2
     4744         then do :
     4745           vGtin = entry(1, buf_parts.part-code, "_") .
     4746           if length(vGtin) = 8
     4747           or length(vGtin) = 12
     4748           or length(vGtin) = 13
     4749           or length(vGtin) = 14
     4750           then do :
     4751             find first TempDocMark where TempDocMark.gds-code = TempDocLine.gds-code
     4752                                      and (TempDocMark.prt-id = ? or TempDocMark.prt-id = buf_parts.part-code)
     4753                                      and (TempDocMark.in-doc-id = ? or TempDocMark.in-doc-id = buf_parts.in-code)
     4754                                      and TempDocMark.gtin = vGtin
     4755                                      and TempDocMark.gtin_qnt = abs(buf_parts.fact-qnty)
     4756                                      no-error .
     4757             if available TempDocMark
     4758             then do :
     4759               if can-find(first ub.marking-lines where
     4760                                 ub.marking-lines.mark = "02" + vGtin + "37" + string(abs(buf_parts.fact-qnty))
     4761                             and ub.marking-lines.obj-type = buf_parts.obj-type
     4762                             and ub.marking-lines.obj-code = buf_parts.obj-code
     4763                             and ub.marking-lines.gds-code = TempDocLine.gds-code
     4764                             and ub.marking-lines.in-code = buf_parts.in-code
     4765                             and ub.marking-lines.out-code = buf_parts.out-code
     4766                             and ub.marking-lines.part-code = buf_parts.part-code) then
     4767               do:
     4768                 v-end-message = substitute(
     4769                   "Ошибка повторной привязки марки &1 в документ &2 партия &3",
     4770                   "02" + vGtin + "37" + string(abs(buf_parts.fact-qnty)),
     4771                   buf_parts.in-code,
     4772                   buf_parts.part-code).
     4773                 run pcall-log-file in parparentproc (input v-end-message) .
     4774                 undo, return error v-end-message .
     4775               end.
     4776               create ub.marking-lines.
     4777               assign
     4778                 ub.marking-lines.obj-type = buf_parts.obj-type
     4779                 ub.marking-lines.obj-code = buf_parts.obj-code
     4780                 ub.marking-lines.in-code = buf_parts.in-code
     4781                 ub.marking-lines.out-code = buf_parts.out-code
     4782                 ub.marking-lines.part-code = buf_parts.part-code
     4783                 ub.marking-lines.gds-code = TempDocLine.gds-code
     4784                 ub.marking-lines.mark = "02" + vGtin + "37" + string(abs(buf_parts.fact-qnty))
     4785                 ub.marking-lines.sts = objSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB
     4786               .
     4787             end .
     4788           end .
     4789         end .
     4790         for each TempDocMark where TempDocMark.gds-code = TempDocLine.gds-code
     4791                                and (TempDocMark.prt-id = ? or TempDocMark.prt-id = buf_parts.part-code)
     4792                                and (TempDocMark.in-doc-id = ? or TempDocMark.in-doc-id = buf_parts.in-code)
     4793         :
     4794           if TempDocMark.gtin > "" and TempDocMark.gtin_qnt > 0 then next .
     4795           assign
     4796             buf_parts.PS =  TempDocMark.upd_id when TempDocMark.upd_id <> ""
     4797           .
     4798           if TempDocMark.prt-id = ? then TempDocMark.prt-id = buf_parts.part-code .
     4799           if TempDocMark.in-doc-id = ? then TempDocMark.in-doc-id = buf_parts.in-code .
     4800           run addChildMarkingLines in this-procedure (TempDocMark.mark, 1) no-error.
     4801           if error-status:error then
     4802           do:
     4803             v-end-message = substitute(
     4804               "Ошибка повторной привязки марки &1 в документ &2 партия &3" + " &4",
     4805               TempDocMark.mark,
     4806               buf_parts.in-code,
     4807               buf_parts.part-code,
     4808               return-value).
     4809             run pcall-log-file in parparentproc (input v-end-message) .
     4810             undo, return error v-end-message .
     4811           end.
     4812         end.
     4813         if buf_trn-doc.ext-doc-type = 'rv':U then
     4814         do:
     4815           buf_doc-line.fact-qnty = buf_doc-line.fact-qnty + buf_parts.fact-qnty.
     4816         end.
     4817       end.
     4818       define variable v-total-parts-qnty as decimal no-undo .
     4819       define variable v-total-price-base as decimal no-undo .
     4820       define variable v-total-price-rubl as decimal no-undo .
     4821       assign
     4822         v-total-parts-qnty = 0
     4823         v-total-price-base = 0
     4824         v-total-price-rubl = 0
     4825       .
     4826       for each ub.parts
     4827         where ub.parts.obj-type  = buf_doc-line.obj-type
     4828           and ub.parts.obj-code  = buf_doc-line.obj-code
     4829           and ub.parts.artic     = buf_doc-line.artic
     4830           and ub.parts.prod-type = buf_doc-line.prod-type
     4831           and ub.parts.prod-code = buf_doc-line.prod-code
     4832           and ub.parts.out-code  = buf_doc-line.doc-code
     4833       on error undo, return error
     4834       :
     4835         assign
     4836           v-total-parts-qnty = v-total-parts-qnty + parts.qnty
     4837           v-total-price-base = v-total-price-base + parts.qnty * parts.price-base
     4838           v-total-price-rubl = v-total-price-rubl + parts.qnty * parts.price-rubl
     4839         .
     4840       end.
     4841       if v-doc-line-chg-qnty <> v-total-parts-qnty then do:
     4842         v-end-message =  substitute("Ошибка в документе внутреннего перемещения &1 . Количество в партиях (&2) не совпадает с количеством (&3) в строке документа." ,
     4843                 TempTrnDoc.out-code,
     4844                 v-total-parts-qnty,
     4845                 v-doc-line-chg-qnty ).
     4846         run pcall-log-file in parparentproc (input v-end-message) .
     4847         undo, return error v-end-message.
     4848       end.
     4849       if v-total-parts-qnty <> 0 then do:
     4850         assign
     4851           buf_doc-line.price-rubl = v-total-price-rubl / v-total-parts-qnty
     4852           buf_doc-line.price-base = v-total-price-base / v-total-parts-qnty
     4853           buf_doc-line.price-cli  = v-total-price-base / v-total-parts-qnty
     4854         .
     4855       end.
     4856   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4858     (input  buf_doc-line.artic
     4859     ,input  buf_doc-line.prod-type
     4860     ,input  buf_doc-line.prod-code
     4861     ,output v-root-node
     4862     )  .
     4863       find first buf_gds-dtl
     4864         where buf_gds-dtl.doc-code    = buf_trn-doc.doc-code
     4865           and buf_gds-dtl.artic       = ub.goods.artic
     4866           and buf_gds-dtl.prod-type   = ub.goods.prod-type
     4867           and buf_gds-dtl.prod-code   = ub.goods.prod-code
     4868         no-error .
     4869       if not available buf_gds-dtl
     4870       then do:
     4871         create buf_gds-dtl.
     4872         assign
     4873           buf_gds-dtl.doc-code    = buf_trn-doc.doc-code
     4874           buf_gds-dtl.artic       = ub.goods.artic
     4875           buf_gds-dtl.prod-type   = ub.goods.prod-type
     4876           buf_gds-dtl.prod-code   = ub.goods.prod-code
     4877           buf_gds-dtl.prt-code    = v-root-node
     4878           buf_gds-dtl.obj-type    = buf_trn-doc.obj-type
     4879           buf_gds-dtl.obj-code    = buf_trn-doc.obj-code
     4880         .
     4881         assign
     4882           buf_gds-dtl.discnt-base = 0
     4883           buf_gds-dtl.discnt-rubl = 0
     4884           buf_gds-dtl.discnt-pc   = 0
     4885           buf_gds-dtl.discnt-type = ?
     4886         .
     4887       end.
     4888       assign
     4889         buf_gds-dtl.price-base     = TempDocLine.price-rubl
     4890         buf_gds-dtl.price-rubl     = TempDocLine.price-rubl
     4891         buf_gds-dtl.ov             = yes
     4892         buf_gds-dtl.fact-qnty      = buf_doc-line.fact-qnty
     4893         buf_gds-dtl.doc-qnty       = buf_doc-line.doc-qnty
     4894       .
     4895       if TempTrnDoc.ext-doc-type = 'rv':U
     4896       then do :
     4897         assign
     4898           buf_gds-dtl.price-base     = buf_doc-line.price-base
     4899           buf_gds-dtl.price-rubl     = buf_doc-line.price-rubl
     4900         .
     4901       end .
     4902     end .
     4903     if not can-find(first ub.doc-line
     4904       where ub.doc-line.doc-code = buf_trn-doc.doc-code)
     4905     then do:
     4906       delete buf_trn-doc.
     4907       return .
     4908     end.
     4909     assign
     4910       buf_trn-doc.PS          = '@  Строк в документе : ' + string(n_str)
     4911       buf_trn-doc.fact-base   = ?
     4912       buf_trn-doc.fact-rubl   = ?
     4913     .
     4914     run gbl/calc-trn.p (input ? , INPUT RECID(buf_trn-doc)).
     4915     assign
     4916       buf_trn-doc.flag_ = yes
     4917     .
     4918     validate buf_trn-doc no-error.
     4919     if error-status:error then
     4920       return error return-value.
     4921   end.
     4922   procedure add-nn :
     4923   define input  parameter p-doc-code as character no-undo .
     4924   define input  parameter p-doc-out as character no-undo .
     4925     do
     4926     on error undo, return error return-value
     4927     :
     4928   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     4929                          input 'nids':U ,
     4930                          input p-doc-out ) no-error .
     4931      end.
     4932   end procedure.
     4933   procedure get-country-code :
     4934     define input  parameter p-trn-doc      as character no-undo .
     4935     define input  parameter p-ext-doc-type as character no-undo .
     4936     define input  parameter p-gds-code     as integer   no-undo .
     4937     define output parameter p-country-code as integer   no-undo .
     4938     define buffer buf_goods   for ub.goods .
     4939     define buffer buf_country for ub.country .
     4940     define variable v-read-default-code as logical   no-undo .
     4941     define variable v-attr-value        as character no-undo .
     4942     define variable v-attr-type         as character no-undo .
     4943     do
     4944     on error undo, return error return-value
     4945     :
     4946       assign
     4947         v-read-default-code = true
     4948       .
     4949       if p-ext-doc-type = 'ie':U
     4950       then do:
     4951         run lineattr-value in this-procedure
     4952           (input  p-trn-doc
     4953           ,input  p-gds-code
     4954           ,input  'country-code':U
     4955           ,output v-attr-value
     4956           ,output v-attr-type
     4957           ) .
     4958         if v-attr-value <> ""
     4959         then do:
     4960           assign
     4961             v-read-default-code = false
     4962             p-country-code      = integer(v-attr-value)
     4963           .
     4964         end.
     4965       end.
     4966       if v-read-default-code = true
     4967       then do:
     4968         find first buf_goods no-lock
     4969           where buf_goods.gds-code = p-gds-code
     4970           no-error .
     4971         find first buf_country no-lock
     4972           where buf_country.alpha1 = buf_goods.alpha1
     4973           no-error .
     4974         if available buf_country
     4975         then do:
     4976           assign
     4977             p-country-code = buf_country.num-code
     4978           .
     4979         end.
     4980         else do:
     4981           assign
     4982             p-country-code = 0
     4983           .
     4984         end.
     4985       end.
     4986     end.
     4987   end procedure.
     4988   procedure addChildMarkingLines:
     4989     define input parameter iMark  as character no-undo.
     4990     define input parameter iLevel as integer   no-undo.
     4991     define buffer chi_marking       for ub.marking  .
     4992     define buffer buf_marking-lines for ub.marking-lines  .
     4993     if can-find(first buf_marking-lines where
     4994                       buf_marking-lines.mark      = iMark
     4995                   and buf_marking-lines.obj-type  = buf_parts.obj-type
     4996                   and buf_marking-lines.obj-code  = buf_parts.obj-code
     4997                   and buf_marking-lines.gds-code  = TempDocLine.gds-code
     4998                   and buf_marking-lines.in-code   = buf_parts.in-code
     4999                   and buf_marking-lines.out-code  = buf_parts.out-code
     5000                   and buf_marking-lines.part-code = buf_parts.part-code) then
     5001     do:
     5002       return error.
     5003     end.
     5004     create buf_marking-lines.
     5005     assign
     5006       buf_marking-lines.obj-type = buf_parts.obj-type
     5007       buf_marking-lines.obj-code = buf_parts.obj-code
     5008       buf_marking-lines.in-code = buf_parts.in-code
     5009       buf_marking-lines.out-code = buf_parts.out-code
     5010       buf_marking-lines.part-code = buf_parts.part-code
     5011       buf_marking-lines.prt-code  = buf_parts.prt-code
     5012       buf_marking-lines.gds-code = TempDocLine.gds-code
     5013       buf_marking-lines.mark = iMark
     5014       buf_marking-lines.sts = objSrv:Env:Marking:Sts:Mark:DeliveryControl:KeyIntDB
     5015       buf_marking-lines.doc-level = iLevel
     5016     no-error.
     5017     if error-status:error then
     5018       return error error-status:get-message(1).
     5019     for first ub.marking exclusive-lock where
     5020               ub.marking.mark begins buf_marking-lines.mark
     5021     :
     5022       ub.marking.obj-type = buf_marking-lines.obj-type.
     5023       ub.marking.obj-code = buf_marking-lines.obj-code.
     5024       if iLevel = 1 and buf_trn-doc.ext-doc-type = 'iv':U then
     5025       do:
     5026         if ub.marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     5027            can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(ub.marking.sts)) or
     5028            can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(ub.marking.sts)) then
     5029         do:
     5030           if v-isweighed
     5031           then do :
     5032             v-mark-weight = MarkWeight(ub.marking.mark).
     5033             buf_doc-line.fact-qnty = buf_doc-line.fact-qnty + v-mark-weight .
     5034             buf_parts.fact-qnty = buf_parts.fact-qnty + v-mark-weight .
     5035           end .
     5036           else do :
     5037             buf_doc-line.fact-qnty = buf_doc-line.fact-qnty + ub.marking.box-qnty.
     5038             buf_parts.fact-qnty = buf_parts.fact-qnty + ub.marking.box-qnty.
     5039           end .
     5040         end.
     5041       end.
     5042       buf_marking-lines.sts = if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(ub.marking.sts)) or
     5043                                 can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(ub.marking.sts)) or
     5044                                 ub.marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     5045                                 ub.marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     5046                              then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5047                               else ub.marking.sts.
     5048       validate buf_marking-lines no-error.
     5049       if error-status:error then
     5050         return error error-status:get-message(1).
     5051       for each chi_marking where chi_marking.mark-parent = ub.marking.mark:
     5052           run addChildMarkingLines in this-procedure (chi_marking.mark, iLevel + 1) no-error.
     5053       end.
     5054     end.
     5055   end procedure.
