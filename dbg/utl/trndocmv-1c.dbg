        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.gbl.sys.*.
        5     define temp-table TempTrnDoc no-undo
        6       field line-num      as integer
        7       field ext-doc-code  as character
        8       field doc-date      as date
        9       field ext-doc-type  as character
       10       field cli-type      as character
       11       field cli-code      as integer
       12       field obj-type      as character
       13       field obj-code      as integer
       14       field ps            as character
       15       field doc-id        as character
       16       field dog-code      as character
       17       field source-doc    as character
       18       field out-code      as character
       19       index pi line-num ext-doc-code
       20     .
       21     define temp-table TempDocLine no-undo
       22       field line-num     as integer
       23       field gds-code     as integer
       24       field doc-qnty     as decimal
       25       field fact-qnty    as decimal
       26       field price-rubl   as decimal
       27       field RowSum       as decimal
       28       field vat-pc       as decimal
       29       field fact-dnsty   as decimal
       30       field cli-qnty     as decimal
       31       field koef         as decimal
       32       field unit-code    as character
       33       field b-code       as character
       34       field is-tsd-qnty  as logical init no
       35       field vsd-uuid     as character
       36       field part-id      as character
       37       field aclMarksList as character
       38       field PartIDTH     as character
       39       index pi
       40       line-num
       41       gds-code
       42     .
       43     define temp-table TempDocPart no-undo
       44       field gds-code     as integer
       45       field doc-qnty     as decimal
       46       field fact-qnty    as decimal
       47       field price-rubl   as decimal
       48       field vat-pc       as decimal
       49       field fact-dnsty   as decimal
       50       field vsd-uuid     as character
       51       field part-id      as character
       52       field in-doc-id    as character
       53       field edoc-id      as character
       54       index pi
       55       in-doc-id
       56       part-id
       57       gds-code
       58     .
       59     define temp-table TempDocMark no-undo
       60       field gtin as character
       61       field gtin_qnt as integer
       62       field upd_id as character
       63       field prt-id as character
       64       field in-doc-id as character
       65       field mark as character
       66       field gds-code as integer
       67       index pi mark
       68     .
       69   define input  parameter parparentproc as widget-handle no-undo .
       70   define input  parameter table for  TempTrnDoc.
       71   define input  parameter table for  TempDocLine.
       72   define input  parameter table for  TempDocPart.
       73   define input  parameter table for  TempDocMark.
       74   define variable vss-revision    as character no-undo initial "$Revision$":U .
       75   define variable vss-author      as character no-undo initial "$Author$":U .
       76   define variable vss-date        as character no-undo initial "$Date$":U .
       77   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       78   define variable vss-archive     as character no-undo initial "$Archive$":U .
       79   define variable vss-description as character no-undo initial "Создание документов внутреннего перемещения":U .
       80   procedure vss-get-info :
       81     define output parameter p-vss-revision    like vss-revision    no-undo .
       82     define output parameter p-vss-author      like vss-author      no-undo .
       83     define output parameter p-vss-date        like vss-date        no-undo .
       84     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       85     define output parameter p-vss-archive     like vss-archive     no-undo .
       86     define output parameter p-vss-description like vss-description no-undo .
       87     assign
       88       p-vss-revision    = vss-revision
       89       p-vss-author      = vss-author
       90       p-vss-date        = vss-date
       91       p-vss-workfile    = vss-workfile
       92       p-vss-archive     = vss-archive
       93       p-vss-description = vss-description
       94     .
       95   end procedure.
       96   procedure vss-get-parameters :
       97     define output parameter p-vss-parameters as character no-undo .
       98   end procedure.
       99   define new global shared variable g#vssrevis-logger as handle    no-undo .
      100   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      101   define variable v-vssrevis-logger                   as handle    no-undo .
      102   procedure vss-logevent :
      103     define input  parameter p-extra-paramters as character no-undo .
      104     define variable v-vssrevis-parameters as character no-undo .
      105     do
      106     on error undo, return error return-value
      107     :
      108       if  valid-handle(v-vssrevis-logger)
      109       and v-vssrevis-logger :get-signature("logevent") <> ""
      110       then do:
      111         run vss-get-parameters in this-procedure
      112           (output v-vssrevis-parameters
      113           ).
      114         run logevent in v-vssrevis-logger
      115           (input vss-workfile
      116           ,input vss-revision
      117           ,input v-vssrevis-parameters
      118           ,input p-extra-paramters
      119           ).
      120       end.
      121     end.
      122   end procedure.
      123   assign
      124     v-vssrevis-logger = g#vssrevis-logger
      125   .
      126   if  valid-handle(v-vssrevis-logger)
      127   and v-vssrevis-logger :get-signature("logevent") <> ""
      128   then do:
      129     assign
      130       v-vssrevis-logevent = true
      131     .
      132     run vss-logevent in this-procedure (input vss-description) .
      133   end.
      134   define new global shared variable g#language as character no-undo .
      135   if g#language <> '' and g#language <> 'rus':U then do:
      136     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      137   end.
      138   define new global shared variable g#library  as handle no-undo .
      139   define new global shared variable g#library2 as handle no-undo .
      140   define   shared variable g#auto as logical no-undo.
      141   define   shared variable g#news as logical no-undo.
      142   define   shared variable g#oxml as logical no-undo.
      143   define   shared variable g#esys as logical no-undo.
      144   define   shared variable g#news-source-db as integer no-undo.
      145   define   shared variable g#esys-source-esys as integer no-undo.
      146   define   shared variable g#db-num as integer   no-undo .
      147   define   shared variable g#userid as character no-undo .
      148   define   shared variable g#passwd as character no-undo .
      149   define new global shared variable g#lib-trn  as handle no-undo .
      150   define new global shared variable g#lib-trn2 as handle no-undo .
      151   define new global shared variable g#lib-trn3 as handle no-undo .
      152   define new global shared variable g#lib-trn4 as handle no-undo .
      153   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   procedure doc-code:
      155   define input  parameter parmode          as   character           no-undo.
      156   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      157   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      158   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      159   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      160   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      161   define variable vardb-remote     as   logical             no-undo.
      162   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      163   define variable v-delimiter as character no-undo .
      164   do
      165   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      166   :
      167   find first buf_sys-ctrl no-lock .
      168   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      169     CASE parmode:
      170       when "main":u then do:
      171         if vardb-remote then do:
      172           assign
      173             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      174         end.
      175         else do:
      176           assign
      177             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      178         end.
      179       end.
      180       when "trio" then do:
      181         assign
      182           pardoc-code = replace (parroot-doc-code, "=", "*").
      183       end.
      184       otherwise do:
      185         assign
      186         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      187         no-error
      188         .
      189         if error-status:error  then do:
      190           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      191                                         ,chr(10)
      192                                         ,parmode
      193                                         ).
      194         end.
      195         if num-entries(parmode) = 1
      196         and parmode <> "chip":U
      197         and parmode <> "chip_s":U
      198         then do:
      199           assign
      200           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      201         end.
      202         else if (lookup("chip":U, parmode) > 0
      203                  or
      204                  lookup("chip_s":U, parmode) > 0) then do:
      205           assign
      206             vartemp-doc-code = parroot-doc-code.
      207           do while true:
      208             if index (vartemp-doc-code , ".") = 0 then
      209               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      210             else
      211               vartemp-doc-code  =
      212               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      213               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      214               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      215             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      216           end.
      217           assign
      218             pardoc-code = vartemp-doc-code.
      219         end.
      220       end.
      221     end CASE.
      222     if pardoc-code = '':U
      223     or (parroot-doc-code <> '':U
      224     and pardoc-code = parroot-doc-code) then do:
      225       undo, return error substitute("Ошибка при генерации номера документа&1"
      226                                     ,chr(10)).
      227     end.
      228   end.
      229   end. // procedure/method
      230   function get-doc-code-int64 returns int64
      231     ( input p-doc-code as character ) :
      232     define variable v-ind              as integer   no-undo .
      233     define variable v-num-entries      as integer   no-undo .
      234     define variable v-doc-code-int64   as int64     no-undo .
      235     define variable v-canonic-doc-code as character no-undo .
      236     assign
      237       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      238       v-canonic-doc-code = p-doc-code
      239     .
      240     do v-ind = 1 to v-num-entries
      241     :
      242       assign
      243         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      244       .
      245     end.
      246     assign
      247       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      248     .
      249     return v-doc-code-int64 .
      250   end. // function/method
      251   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      252   define new global shared variable g#trdcalib as handle no-undo.
      253   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      254   procedure lineattr-value :
      255     do
      256     on error undo, return error return-value
      257     :
      258       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      259       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      260       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      261       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      262       define output parameter p-type     as character no-undo .
      263       define buffer buf_doc-line-attr for ub.doc-line-attr .
      264       def var v-format         as character no-undo .
      265       def var v-fillin_width   as integer   no-undo .
      266       def var v-fillin_height  as integer   no-undo .
      267       def var v-label          as character no-undo .
      268       def var v-user-can-edit  as logical   no-undo .
      269       def var v-output-display as logical   no-undo .
      270       def var v-other          as character no-undo .
      271       run lineattr-code in this-procedure
      272         (input  p-code
      273         ,output p-type
      274         ,output v-format
      275         ,output v-fillin_width
      276         ,output v-fillin_height
      277         ,output v-label
      278         ,output v-user-can-edit
      279         ,output v-output-display
      280         ,output v-other
      281         ) no-error .
      282       if error-status :error then do:
      283         undo, return error return-value .
      284       end.
      285       find first buf_doc-line-attr no-lock
      286         where buf_doc-line-attr.doc-code  = p-doc-code
      287           and buf_doc-line-attr.gds-code  = p-gds-code
      288           and buf_doc-line-attr.attr-code = p-code
      289         no-error .
      290       if avail buf_doc-line-attr then do:
      291         assign
      292           p-value =  buf_doc-line-attr.attr-value
      293         .
      294       end.
      295       else do:
      296         assign
      297           p-value = if p-type = 'L':U then "no":U else ""
      298         .
      299       end.
      300     end.
      301   end procedure.
      302   procedure lineattr-write :
      303     do
      304     on error undo, return error return-value
      305     :
      306       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      307       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      308       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      309       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      310       define buffer buf_doc-line-attr for ub.doc-line-attr .
      311       def var v-type           as character no-undo .
      312       def var v-format         as character no-undo .
      313       def var v-fillin_width   as integer   no-undo .
      314       def var v-fillin_height  as integer   no-undo .
      315       def var v-label          as character no-undo .
      316       def var v-user-can-edit  as logical   no-undo .
      317       def var v-output-display as logical   no-undo .
      318       def var v-other          as character no-undo .
      319       run lineattr-code in this-procedure
      320         (input  p-code
      321         ,output v-type
      322         ,output v-format
      323         ,output v-fillin_width
      324         ,output v-fillin_height
      325         ,output v-label
      326         ,output v-user-can-edit
      327         ,output v-output-display
      328         ,output v-other
      329         ) no-error .
      330       if error-status :error then do:
      331         undo, return error return-value .
      332       end.
      333       find first buf_doc-line-attr exclusive-lock
      334         where buf_doc-line-attr.doc-code  = p-doc-code
      335           and buf_doc-line-attr.gds-code  = p-gds-code
      336           and buf_doc-line-attr.attr-code = p-code
      337         no-error .
      338       if not available buf_doc-line-attr then do:
      339         create buf_doc-line-attr .
      340         assign
      341           buf_doc-line-attr.doc-code  = p-doc-code
      342           buf_doc-line-attr.gds-code = p-gds-code
      343           buf_doc-line-attr.attr-code = p-code
      344         .
      345       end.
      346       assign
      347         buf_doc-line-attr.attr-value = p-value
      348       .
      349        release buf_doc-line-attr.
      350     end.
      351   end procedure.
      352   procedure lineattr-exist :
      353     do
      354     on error undo, return error return-value
      355     :
      356       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      357       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      358       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      359       define output parameter p-exist   as logical  no-undo .
      360       define buffer buf_doc-line-attr for ub.doc-line-attr .
      361       def var v-type           as character no-undo .
      362       def var v-format         as character no-undo .
      363       def var v-fillin_width   as integer   no-undo .
      364       def var v-fillin_height  as integer   no-undo .
      365       def var v-label          as character no-undo .
      366       def var v-user-can-edit  as logical   no-undo .
      367       def var v-output-display as logical   no-undo .
      368       def var v-other          as character no-undo .
      369       run lineattr-code in this-procedure
      370         (input  p-code
      371         ,output v-type
      372         ,output v-format
      373         ,output v-fillin_width
      374         ,output v-fillin_height
      375         ,output v-label
      376         ,output v-user-can-edit
      377         ,output v-output-display
      378         ,output v-other
      379         ) no-error .
      380       if error-status :error then do:
      381         undo, return error return-value .
      382       end.
      383       find first buf_doc-line-attr no-lock
      384         where buf_doc-line-attr.doc-code  = p-doc-code
      385           and buf_doc-line-attr.gds-code = p-gds-code
      386           and buf_doc-line-attr.attr-code = p-code
      387         no-error .
      388       if  available buf_doc-line-attr then do:
      389         p-exist = yes.
      390       end.
      391     end.
      392   end procedure.
      393   procedure lineattr-delete :
      394     do
      395     on error undo, return error return-value
      396     :
      397       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      398       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      399       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      400       define output parameter p-deleted  as logical no-undo.
      401       define buffer buf_doc-line-attr for ub.doc-line-attr .
      402       def var v-type           as character no-undo .
      403       def var v-format         as character no-undo .
      404       def var v-fillin_width   as integer   no-undo .
      405       def var v-fillin_height  as integer   no-undo .
      406       def var v-label          as character no-undo .
      407       def var v-user-can-edit  as logical   no-undo .
      408       def var v-output-display as logical   no-undo .
      409       def var v-other          as character no-undo .
      410       run lineattr-code in this-procedure
      411         (input  p-code
      412         ,output v-type
      413         ,output v-format
      414         ,output v-fillin_width
      415         ,output v-fillin_height
      416         ,output v-label
      417         ,output v-user-can-edit
      418         ,output v-output-display
      419         ,output v-other
      420         ) no-error .
      421       if error-status :error then do:
      422         undo, return error return-value .
      423       end.
      424       find first buf_doc-line-attr exclusive-lock
      425         where buf_doc-line-attr.doc-code  = p-doc-code
      426           and buf_doc-line-attr.gds-code  = p-gds-code
      427           and buf_doc-line-attr.attr-code = p-code
      428         no-error NO-WAIT.
      429       if not available buf_doc-line-attr then do:
      430         p-deleted = no.
      431       end.
      432       else do:
      433         delete buf_doc-line-attr.
      434         p-deleted = yes.
      435       end.
      436     end.
      437   end procedure.
      438   procedure lineattr-code :
      439     do on error undo, return error return-value
      440     :
      441       define input  parameter p-code           as character no-undo .
      442       define output parameter p-type           as character no-undo .
      443       define output parameter p-format         as character no-undo .
      444       define output parameter p-fillin_width   as integer   no-undo .
      445       define output parameter p-fillin_height  as integer   no-undo .
      446       define output parameter p-label          as character no-undo .
      447       define output parameter p-user-can-edit  as logical   no-undo .
      448       define output parameter p-output-display as logical   no-undo .
      449       define output parameter p-other          as character no-undo .
      450       case p-code :
      451               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      452               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      453               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      454               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      455               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      456               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      457               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      458               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      459               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      460               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      461               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      462         otherwise do:
      463           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      464         end.
      465       end.
      466     end.
      467   end procedure.
      468   procedure lineattr-value-flora-gds :
      469     do
      470     on error undo, return error return-value
      471     :
      472       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      473       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      474       define input  parameter p-prt-code    as integer   no-undo .
      475       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      476       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      477       define output parameter p-value       as    decimal   no-undo .
      478       define buffer buf_doc-line-attr for ub.doc-line-attr .
      479       find first buf_doc-line-attr no-lock
      480         where buf_doc-line-attr.doc-code  = p-doc-code
      481           and buf_doc-line-attr.gds-code  = p-gds-code
      482           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      483         no-error .
      484       if avail buf_doc-line-attr then do:
      485         assign
      486           p-value = decimal( buf_doc-line-attr.attr-value)
      487         .
      488       end.
      489       else do:
      490         assign
      491           p-value = 0
      492         .
      493       end.
      494     end.
      495   end procedure.
      496   procedure lineattr-write-flora-gds :
      497     do
      498     on error undo, return error return-value
      499     :
      500       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      501       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      502       define input parameter p-prt-code    as integer   no-undo .
      503       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      504       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      505       define input parameter p-value    as decimal   no-undo .
      506       define buffer buf_doc-line-attr for ub.doc-line-attr .
      507       find first buf_doc-line-attr exclusive-lock
      508         where buf_doc-line-attr.doc-code  = p-doc-code
      509           and buf_doc-line-attr.gds-code  = p-gds-code
      510           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      511         no-error .
      512       if not available buf_doc-line-attr then do:
      513         create buf_doc-line-attr .
      514         assign
      515           buf_doc-line-attr.doc-code  = p-doc-code
      516           buf_doc-line-attr.gds-code  = p-gds-code
      517           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      518         .
      519       end.
      520       assign
      521         buf_doc-line-attr.attr-value = string( p-value )
      522       .
      523     end.
      524   end procedure.
      525   procedure lineattr-delete-flora-gds :
      526     do
      527     on error undo, return error return-value
      528     :
      529       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      530       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      531       define input  parameter p-prt-code    as integer   no-undo .
      532       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      533       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      534       define output parameter p-deleted  as logical no-undo.
      535       define buffer buf_doc-line-attr for ub.doc-line-attr .
      536       find first buf_doc-line-attr exclusive-lock
      537         where buf_doc-line-attr.doc-code  = p-doc-code
      538           and buf_doc-line-attr.gds-code  = p-gds-code
      539           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      540         no-error NO-WAIT.
      541       if not available buf_doc-line-attr then do:
      542         p-deleted = no.
      543       end.
      544       else do:
      545         delete buf_doc-line-attr.
      546         p-deleted = yes.
      547       end.
      548     end.
      549   end procedure.
      550   procedure lineattr-delete-flora-all :
      551     do
      552     on error undo, return error return-value
      553     :
      554       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      555       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      556       define input  parameter p-prt-code    as integer   no-undo .
      557       define buffer buf_doc-line-attr for ub.doc-line-attr .
      558       for each buf_doc-line-attr exclusive-lock
      559         where buf_doc-line-attr.doc-code  = p-doc-code
      560           and buf_doc-line-attr.gds-code  = p-gds-code
      561           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      562        :
      563         delete buf_doc-line-attr.
      564       end.
      565    end.
      566   end procedure.
      567   procedure lineattr-exist-flora-gds :
