     1348   function getattrUtdex returns char
     1349   (idb-num   as integer,
     1350    idoc-id   as integer,
     1351    iattrcode as character,
     1352    iExValue  as character  ):
     1353      define buffer utd-attr for utd-attr.
     1354      find first utd-attr where utd-attr.db-num eq idb-num
     1355                            and utd-attr.doc-id eq idoc-id
     1356                            and utd-attr.attr-code eq iattrcode
     1357      no-lock no-error.
     1358      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     1359   end.
     1360   function getattrUtd returns char
     1361   (idb-num   as integer,
     1362    idoc-id   as integer,
     1363    iattrcode as character ):
     1364     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     1365   end.
     1366   function setattrUtd returns logical
     1367   (idb-num   as integer,
     1368    idoc-id   as integer,
     1369    iattrcode as character,
     1370    iattrval  as character ):
     1371      define buffer utd-attr for utd-attr.
     1372      find first utd-attr where utd-attr.db-num eq idb-num
     1373                            and utd-attr.doc-id eq idoc-id
     1374                            and utd-attr.attr-code eq iattrcode
     1375      no-lock no-error.
     1376      if not available utd-attr
     1377      then do:
     1378         create utd-attr.
     1379         assign
     1380            utd-attr.db-num    = idb-num
     1381            utd-attr.doc-id    = idoc-id
     1382            utd-attr.attr-code = iattrcode
     1383            utd-attr.attr-value = iattrval
     1384         .
     1385      end.
     1386      else do:
     1387         if utd-attr.attr-value ne iattrval
     1388         then do:
     1389            find current utd-attr exclusive-lock no-error.
     1390            if available utd-attr
     1391            then
     1392               utd-attr.attr-value = iattrval.
     1393         end.
     1394      end.
     1395      release utd-attr.
     1396   end.
     1397   function GetAttrUtdlinesEx returns char
     1398   (idb-num   as integer,
     1399    idoc-id   as integer,
     1400    ilinenum  as integer,
     1401    iattrcode as character,
     1402    iExValue  as character  ):
     1403      define buffer utd-lines-attr for utd-lines-attr.
     1404      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1405                                  and utd-lines-attr.doc-id    eq idoc-id
     1406                                  and utd-lines-attr.lineNum   eq ilineNum
     1407                                  and utd-lines-attr.attr-code eq iattrcode
     1408      no-lock no-error.
     1409      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     1410   end.
     1411   function GetAttrUtdlines returns char
     1412   (idb-num   as integer,
     1413    idoc-id   as integer,
     1414    ilinenum  as integer,
     1415    iattrcode as character ):
     1416      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     1417   end.
     1418   function setattrUtdlines returns logical
     1419   (idb-num   as integer,
     1420    idoc-id   as integer,
     1421    ilinenum  as integer,
     1422    iattrcode as character,
     1423    iattrval  as character ):
     1424      define buffer utd-lines-attr for utd-lines-attr.
     1425      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1426                                  and utd-lines-attr.doc-id    eq idoc-id
     1427                                  and utd-lines-attr.lineNum   eq ilineNum
     1428                                  and utd-lines-attr.attr-code eq iattrcode
     1429      no-lock no-error.
     1430      if not available utd-lines-attr
     1431      then do:
     1432         if iattrval ne ?
     1433            and iattrval ne ""
     1434         then do:
     1435            create utd-lines-attr.
     1436            assign
     1437               utd-lines-attr.db-num    = idb-num
     1438               utd-lines-attr.doc-id    = idoc-id
     1439               utd-lines-attr.lineNum   = ilineNum
     1440               utd-lines-attr.attr-code = iattrcode
     1441               utd-lines-attr.attr-value = iattrval
     1442            .
     1443         end.
     1444      end.
     1445      else do:
     1446         if utd-lines-attr.attr-value ne iattrval
     1447         then do:
     1448            find current utd-lines-attr exclusive-lock no-error.
     1449            if available utd-lines-attr
     1450            then do:
     1451               if    iattrval eq ?
     1452                  or iattrval eq ""
     1453               then do:
     1454                  delete utd-lines-attr.
     1455               end.
     1456               else do:
     1457                  utd-lines-attr.attr-value = iattrval.
     1458               end.
     1459            end.
     1460         end.
     1461      end.
     1462      release utd-lines-attr.
     1463   end.
