      590   procedure lineattr-write-add-line-cli :
      591   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      592   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      593   define input  parameter p-cli-type      as character no-undo .
      594   define input  parameter p-cli-code      as integer   no-undo .
      595   define input  parameter p-contract-code as integer   no-undo .
      596   define input  parameter p-host-code     as integer   no-undo .
      597   define input  parameter p-exch-code     as integer   no-undo .
      598   define input  parameter p-exch-rate     as decimal   no-undo .
      599   define input  parameter p-exch-scale    as integer   no-undo .
      600   define input  parameter p-sum-cli       as decimal   no-undo .
      601   define input  parameter p-sum-vat       as decimal   no-undo .
      602   define buffer buf_doc-line-attr for ub.doc-line-attr .
      603     do
      604     on error undo, return error return-value
      605     :
      606       find first buf_doc-line-attr exclusive-lock
      607         where buf_doc-line-attr.doc-code  = p-doc-code
      608           and buf_doc-line-attr.gds-code  = p-gds-code
      609           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      610                                             chr(4) + p-cli-type +
      611                                             chr(4) + string(p-cli-code) +
      612                                             chr(4) + string(p-contract-code) +
      613                                             chr(4) + string(p-host-code)
      614         no-error .
      615       if not available buf_doc-line-attr then do:
      616         create buf_doc-line-attr .
      617         assign
      618           buf_doc-line-attr.doc-code  = p-doc-code
      619           buf_doc-line-attr.gds-code  = p-gds-code
      620           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      621                                         chr(4) + p-cli-type +
      622                                         chr(4) + string(p-cli-code) +
      623                                         chr(4) + string(p-contract-code) +
      624                                         chr(4) + string(p-host-code)
      625         .
      626       end.
      627       assign
      628         buf_doc-line-attr.attr-value =
      629         string(p-exch-code)  + chr(4) +
      630         string(p-exch-rate)  + chr(4) +
      631         string(p-exch-scale) + chr(4) +
      632         string(p-sum-cli)    + chr(4) +
      633         string(p-sum-vat)
      634         .
      635     end.
      636   end procedure.
      637   procedure lineattr-value-add-line-cli :
      638   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      639   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      640   define input   parameter p-cli-type      as character no-undo .
      641   define input   parameter p-cli-code      as integer   no-undo .
      642   define input   parameter p-contract-code as integer   no-undo .
      643   define input   parameter p-host-code     as integer   no-undo .
      644   define output  parameter p-exch-code     as integer   no-undo .
      645   define output  parameter p-exch-rate     as decimal   no-undo .
      646   define output  parameter p-exch-scale    as integer   no-undo .
      647   define output  parameter p-sum-cli       as decimal   no-undo .
      648   define output  parameter p-sum-vat       as decimal   no-undo .
      649   define buffer buf_doc-line-attr for ub.doc-line-attr .
      650     do
      651     on error undo, return error return-value
      652     :
      653       find first buf_doc-line-attr exclusive-lock
      654         where buf_doc-line-attr.doc-code  = p-doc-code
      655           and buf_doc-line-attr.gds-code  = p-gds-code
      656           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      657                                             chr(4) + p-cli-type +
      658                                             chr(4) + string(p-cli-code) +
      659                                             chr(4) + string(p-contract-code) +
      660                                             chr(4) + string(p-host-code)
      661         no-error .
      662       if available buf_doc-line-attr then do:
      663        assign
      664           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      665           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      666           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      667           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      668           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      669          .
      670        end.
      671     end.
      672   end procedure.
      673   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      674     define variable v-code as character no-undo .
      675     define variable v-type as character no-undo .
      676     define variable v-gds-code as integer   no-undo .
      677   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      679     (input  local-doc-line.artic
      680     ,input  local-doc-line.prod-type
      681     ,input  local-doc-line.prod-code
      682     ,output v-gds-code
      683     )  .
      684     run lineattr-value (
      685         input   local-doc-line.doc-code ,
      686         input   v-gds-code              ,
      687         input   'reason-code':U ,
      688         output  v-code                  ,
      689         output  v-type ) .
      690     find first ub.trn-reason no-lock where
      691                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      692     if not available ub.trn-reason then do:
      693        return "" .
      694     end.
      695     else do:
      696        return ub.trn-reason.reason-name .
      697     end.
      698   end function.
