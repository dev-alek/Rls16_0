     1787                       then do:
     1788                           assign
     1789                               p-out-string = p-out-string + " ":U
     1790                           .
     1791                       end.
     1792                       when chr(10)
     1793                       then do:
     1794                           assign
     1795                               p-out-string = p-out-string + " ":U
     1796                           .
     1797                       end.
     1798                       when chr(13)
     1799                       then do:
     1800                           assign
     1801                               p-out-string = p-out-string + " ":U
     1802                           .
     1803                       end.
     1804                       otherwise do:
     1805                           assign
     1806                               p-out-string = p-out-string + v-current-char
     1807                           .
     1808                       end.
     1809                   end case.
     1810               end.
     1811           end.
     1812       end case.
     1813   end.
     1814   end .
     1815   procedure xmlchar-decode :
     1816   define input parameter p-in-string      as character        no-undo.
     1817   define output parameter p-out-string    as character        no-undo.
     1818       define variable v-position      as integer      no-undo.
     1819       define variable v-last-position as integer      no-undo.
     1820       define variable v-temp-integer  as integer      no-undo.
     1821       define variable v-current-char  as character    no-undo.
     1822       define variable v-next-char     as character    no-undo.
     1823       define variable v-success       as logical      no-undo.
     1824   do
     1825   on error undo, return error
     1826   :
     1827       assign
     1828           p-out-string = "":U
     1829           v-position   = 0
     1830       .
     1831       replace-cycle:
     1832       do while yes
     1833       on error undo, return error
     1834       :
     1835           assign
     1836               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1837           .
     1838           if v-last-position <= v-position
     1839           then do:
     1840               if v-position = 0
     1841               then do:
     1842                   assign
     1843                       p-out-string = p-in-string
     1844                   .
     1845               end.
     1846               else do:
     1847                   assign
     1848                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1849                   .
     1850               end.
     1851               leave replace-cycle.
     1852           end.
     1853           else do:
     1854               assign
     1855                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1856                   v-position      = v-last-position
     1857                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1858               .
     1859               if v-current-char = "#":U
     1860               then do:
     1861                   assign
     1862                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1863                   .
     1864                   if v-last-position > 0
     1865                   then do:
     1866                       run xmlchar-read-integer in this-procedure
     1867                        (
     1868                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1869                           , output v-temp-integer
     1870                           , output v-success
     1871                       ).
     1872                       if v-success = yes
     1873                       and v-temp-integer >= 1
     1874                       and v-temp-integer <= 255
     1875                       then do:
     1876                           assign
     1877                               p-out-string = p-out-string + chr( v-temp-integer )
     1878                               v-position   = v-last-position + 1
     1879                           .
     1880                       end.
     1881                       else do:
     1882                           assign
     1883                               p-out-string = p-out-string + "&":U
     1884                               v-position   = v-position   + 1
     1885                           .
     1886                       end.
     1887                   end.
     1888                   else do:
     1889                       assign
     1890                           p-out-string = p-out-string + "&":U
     1891                           v-position   = v-position   + 1
     1892                       .
     1893                   end.
     1894               end.
     1895               else do:
     1896                   case substring( p-in-string, v-position + 1, 3 )
     1897                   :
     1898                       when "lt;":U
     1899                       then do:
     1900                           assign
     1901                               p-out-string = p-out-string + "<":U
     1902                               v-position   = v-position   + 3
     1903                           .
     1904                       end.
     1905                       when "gt;":U
     1906                       then do:
     1907                           assign
     1908                               p-out-string = p-out-string + ">":U
     1909                               v-position   = v-position   + 3
     1910                           .
     1911                       end.
     1912                       otherwise do:
     1913                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1914                           then do:
     1915                               assign
     1916                                   p-out-string = p-out-string + "&":U
     1917                                   v-position   = v-position   + 4
     1918                               .
     1919                           end.
     1920                           else do:
     1921                               case substring( p-in-string, v-position + 1, 5 )
     1922                               :
     1923                                   when "quot;":U
     1924                                   then do:
     1925                                       assign
     1926                                           p-out-string = p-out-string + '"':U
     1927                                           v-position   = v-position   + 5
     1928                                       .
     1929                                   end.
     1930                                   when "apos;":U
     1931                                   then do:
     1932                                       assign
     1933                                           p-out-string = p-out-string + "'":U
     1934                                           v-position   = v-position   + 5
     1935                                       .
     1936                                   end.
     1937                                   otherwise do:
     1938                                       assign
     1939                                           p-out-string = p-out-string + "&":U
     1940                                       .
     1941                                   end.
     1942                               end case.
     1943                           end.
     1944                       end.
     1945                   end case.
     1946               end.
     1947           end.
     1948       end.
     1949   end.
     1950   end .
     1951   procedure xmlchar-read-integer :
     1952   define input parameter p-input-string      as character        no-undo.
     1953   define output parameter p-output-integer   as integer          no-undo.
     1954   define output parameter p-success       as logical          no-undo.
     1955   do
     1956   on error undo, return error
     1957   :
     1958       assign
     1959           p-output-integer = integer( p-input-string )
     1960       no-error.
     1961       if error-status :error
     1962       then do:
     1963           assign
     1964               p-success           = no
     1965               p-output-integer    = 0
     1966           .
     1967       end.
     1968       else do:
     1969           assign
     1970               p-success           = yes
     1971           .
     1972       end.
     1973   end.
     1974   end.
     1975   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1976   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1977   define variable mMRCCode  as logical    no-undo.
     1978   define variable mTypeMark as character  no-undo.
     1979   function IS-NeedMark returns logical
     1980   ( input ib-code as integer  ,
     1981     input ib-str as character ):
     1982      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1983      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1984                                    and buf_prod-bc-attr.b-str  eq ib-str
     1985                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1986        no-lock no-error.
     1987      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1988   end.
     1989   function repTegforDm return char
     1990   (iDM as char ):
     1991       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1992       define variable vteg as character no-undo.
     1993       define variable oDM as character no-undo.
     1994       define variable vi as integer no-undo.
     1995       oDM = iDm.
     1996       do vi = 1 to num-entries(vTeglist):
     1997          vTeg = entry(vi,vTeglist).
     1998          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1999       end.
     2000       return oDM.
     2001   end.
     2002   function repSpecSimbforDm return char
     2003   (iDM as char ):
     2004       define variable oDM as character no-undo.
     2005     run
     2006       xmlchar-decode(iDM, output oDM).
     2007     return repTegforDm (oDM).
     2008   end.
     2009   function CheckGtin return logical
     2010   (iGtin as char):
     2011      define variable bar_code as character no-undo.
     2012      define variable vGtin as logical no-undo init "yes".
     2013      if length(iGtin) eq 14
     2014      then do:
     2015         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2016         run str/chk-sum.p
     2017          (input-output bar_code ) no-error .
     2018         if iGtin ne  bar_code
     2019         then
     2020            vGtin = no.
     2021      end.
     2022      else
     2023         vGtin = no.
     2024      return vgtin.
     2025   end.
     2026   function repSpecSimbforXlm return char
     2027   (iDM as char ):
     2028       iDM = replace(iDM,chr(29),"").
     2029       return iDM.
     2030   end.
     2031   function getGtinByDM return char
     2032   (IDM as char):
     2033      define variable VTXT as char no-undo.
     2034      define variable vGtin as char no-undo.
     2035      vTXt = IdM.
     2036      vGtin = IDM.
     2037      if    length(vtxt) > 14
     2038      then do:
     2039         if   vtxt begins "(01)"
     2040                or vtxt begins "(02)"
     2041         then
     2042            vGtin = substring(vtxt,5,14).
     2043         else if   (vtxt begins "01"
     2044                or vtxt begins "02" )
     2045                and (   (    substring(iDm,17,2) eq "21"
     2046                         and length(vtxt) >= 21)
     2047                     or substring(iDm,17,2) eq "37"
     2048                     or substring(iDm,17,4) eq "(37)" )
     2049         then do:
     2050            vGtin = substring(vtxt,3,14).
     2051            if not checkGtin(vGtin)
     2052            then
     2053               vGtin = substring(vtxt,1,14).
     2054         end.
     2055         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2056             or length(vtxt) eq 14 + 7 + 4
     2057             or length(vtxt) eq 14 + 7
     2058         then
     2059            vGtin = substring(vtxt,1,14).
     2060      end.
     2061      if not checkGtin(vGtin)
     2062      then
     2063         vGtin = "".
     2064      return vgtin.
     2065   end.
     2066   function getGdsCodeByGtin return int
     2067   (iGtin as char):
     2068      define buffer prod-bc  for ub.prod-bc.
     2069      define buffer bar-code for ub.bar-code.
     2070      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2071      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2072      return if avail bar-code then bar-code.gds-code else ?.
     2073   end.
     2074   function getQntyCodeByGtin return decimal
     2075   (iGtin as char):
     2076      define buffer prod-bc  for ub.prod-bc.
     2077      define buffer bar-code for ub.bar-code.
     2078      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2079      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2080      return if avail bar-code then bar-code.cli-base-rate else ?.
     2081   end.
     2082   function getGdsCodeByDM return int
     2083   (iDm as char):
     2084      define variable vGtin as char no-undo.
     2085      define buffer prod-bc for ub.prod-bc.
     2086      vGtin  = getGtinByDM (IDM ).
     2087      return getGdsCodeByGtin (vGtin).
     2088   end.
     2089   function ChekTypeMarkByGds return logical
     2090   (iGds-code as integer ):
     2091      define buffer goods-attr for ub.goods-attr.
     2092      find first goods-attr where goods-attr.gds-code   = iGds-code
     2093                              and goods-attr.attr-code  = 'mark-type':U
     2094      no-lock no-error.
     2095      if available goods-attr
     2096      then do:
     2097         mTypeMark = goods-attr.attr-value.
     2098         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2099           .
     2100      end.
     2101      else
     2102         return no.
     2103   end.
     2104   function ChekTypeMarkByDm return logical
     2105   (iDM as char ):
     2106      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2107   end.
     2108   function ChekTypeMarkByGtin return logical
     2109   (iGtin as char ):
     2110      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2111   end.
     2112   function GetNextElement return character
     2113     (input iAllTeg        as logical
     2114     ,output oteg          as character
     2115     ,output otegval       as character
     2116     ,input-output pstr    as character
     2117      ):
     2118        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2119        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2120        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2121        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2122        define variable vTeg as character no-undo.
     2123        define variable vLength as integer no-undo.
     2124        define variable vi as integer no-undo.
     2125        define variable vj as integer no-undo.
     2126        define buffer code for ub.code.
     2127        find first code where Code.parent eq "MarkType"
     2128                          and Code.CodeValue   eq mTypeMark
     2129                          no-lock no-error.
     2130        if     available code
     2131           and Code.misc1 ne ""
     2132           and Code.misc1 ne ?
     2133        then do:
     2134           integer (Code.misc1) no-error.
     2135           if not error-status:error
     2136           then
     2137             entry (4,vlistleng) = Code.misc1.
     2138        end.
     2139        if iAllTeg
     2140        then
     2141           assign
     2142              vlistElem     = vlistElem    + vlistElemDop
     2143              vlistleng     = vlistleng    + vlistlengDop
     2144           .
     2145        else if mMRCCode
     2146        then
     2147           assign
     2148              vlistElem     = vlistElem    + ",(8005),8005"
     2149              vlistleng     = vlistleng    + ",000006,0006"
     2150           .
     2151       block-elem:
     2152       do vi = 1 to num-entries(vlistElem):
     2153          vTeg = entry(vi,vlistElem).
     2154          if pstr begins vTeg
     2155          then do:
     2156             if    vTeg eq "21"
     2157             then
     2158                vLength = index(pstr,chr(29)) - 2 no-error.
     2159             if vLength  <= 0
     2160             then
     2161                vLength = int(entry(vi,vlistleng)).
     2162             otegval = substring (pstr,length(vteg) + 1, vLength).
     2163             oteg = replace(replace(vteg,")",""),"(","").
     2164             vTeg = vteg + otegval.
     2165             otegval = replace(otegval,chr(29),"").
     2166             oteg = replace(replace(oteg,")",""),"(","").
     2167             pstr = substring (pstr,length(vTeg)+ 1).
     2168             vTeg = replace(vTeg,chr(29),"").
     2169             leave block-elem.
     2170          end.
     2171          else
     2172             vTeg = "".
     2173       end.
     2174       return vteg.
     2175   end.
     2176   function GetCodeIdent return character
     2177   (iDm as char):
     2178      define variable Velement   as character no-undo init "first".
     2179      define variable oCodeIdent as character no-undo.
     2180      define variable vteg as character no-undo.
     2181      define variable vtegval as character no-undo.
     2182      define variable vGtin as character no-undo.
     2183      define buffer marking for ub.marking.
     2184      for first marking no-lock where
     2185                marking.mark eq iDm
     2186            and marking.unit-ext = "LEVEL2"
     2187      :
     2188        return iDm.
     2189      end.
     2190      vGtin  = getGtinByDM (iDm ).
     2191      ChekTypeMarkByDm(idm).
     2192      if iDm begins 'tech_':U
     2193      then
     2194         oCodeIdent = iDm.
     2195      else if length(iDm) < 21
     2196      then do:
     2197         find first marking where marking.mark eq idm
     2198         no-lock no-error.
     2199         oCodeIdent = if available marking then marking.mark else  ?.
     2200      end.
     2201      else if     length(iDm) eq 29
     2202         and not iDm begins "01"
     2203         and not iDm begins "02"
     2204      then
     2205         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2206      else  if     length(iDm) >= 24
     2207               and (  iDm begins "01"
     2208                   or iDm begins "02")
     2209               and  substring(iDm,17,2) ne "21"
     2210      then do:
     2211         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2212                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2213         then
     2214            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2215         else
     2216            oCodeIdent = iDM.
     2217      end.
     2218      else  if     (   length(iDm) eq 25
     2219                    or length(iDm) eq 21)
     2220               and (not iDm begins "01"
     2221               and  not iDm begins "02")
     2222      then
     2223         oCodeIdent = substring(iDm,1,21).
     2224      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2225      then
     2226         oCodeIdent = substring(iDm,1,21).
     2227      else do while Velement ne "" and idm ne "":
     2228         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2229         oCodeIdent = oCodeIdent + Velement.
     2230      end.
     2231      return oCodeIdent.
     2232   end.
     2233   function GetTegCod return character
     2234   (icodeIdent as char, iTeg as char):
     2235      define variable Velement   as character no-undo init "first".
     2236      define variable oTeg as character no-undo init ?.
     2237      define variable vteg as character no-undo.
     2238      define variable vtegval as character no-undo.
     2239      if     ((length(icodeIdent) eq 21
     2240         and not icodeIdent begins "01"
     2241         and not icodeIdent begins "02")
     2242         or
     2243             ( length(icodeIdent) eq 25
     2244               and not icodeIdent begins "01"
     2245               and not icodeIdent begins "02"))
     2246      then do:
     2247         if iTeg eq "01" or iTeg eq "02"
     2248         then
     2249            oTeg = substring(icodeIdent,1,21).
     2250         else  if  iTeg eq "21"
     2251         then
     2252            oTeg = substring(icodeIdent,15,7).
     2253      end.
     2254      else do:
     2255         ChekTypeMarkByDm(icodeIdent).
     2256         block-teg:
     2257            do while Velement ne "" and icodeIdent ne "":
     2258            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2259            if    Velement begins iTeg
     2260               or Velement begins "(" + iTeg + ")"
     2261            then do:
     2262               oTeg = vtegval.
     2263               leave block-teg.
     2264            end.
     2265         end.
     2266      end.
     2267      return oTeg.
     2268   end.
     2269   function isOAD return logical
     2270   (icodeIdent as character):
     2271      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2272   end.
     2273   function isMark return logical
     2274   (icodeIdent as character):
     2275      define buffer buf_marking for ub.marking.
     2276      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2277             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2278   end.
     2279   function addBracketForCode return character
     2280   (icodeIdent as char):
     2281      define variable Velement   as character no-undo init "first".
     2282      define variable oTeg as character no-undo.
     2283      define variable vteg as character no-undo.
     2284      define variable vtegval as character no-undo.
     2285      define buffer marking for ub.marking.
     2286      find first marking no-lock where
     2287                 marking.mark begins icodeIdent no-error.
     2288      if    not ChekTypeMarkByDm(icodeIdent)
     2289         or length(icodeIdent) le 24
     2290         or (avail marking and marking.unit-ext = "LEVEL2")
     2291      then
     2292         oTeg = icodeIdent.
     2293      else do:
     2294         if (  icodeIdent begins "01"
     2295            or icodeIdent begins "02"
     2296            ) and CheckGtin(substring (icodeIdent,3,14))
     2297            and substring (icodeIdent,17,2) eq "21"
     2298         then do:
     2299            mMRCCode = yes.
     2300            ChekTypeMarkByDm(icodeIdent).
     2301            block-teg:
     2302            do while Velement ne "" and icodeIdent ne "":
     2303               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2304               if vteg ne ""
     2305               then
     2306                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2307            end.
     2308            mMRCCode = no.
     2309         end.
     2310         else do:
     2311            oTeg = icodeIdent.
     2312         end.
     2313      end.
     2314      return oTeg.
     2315   end.
     2316   function getlevelByCodId return int
     2317   (iCode as char):
     2318      define variable vLength as int no-undo.
     2319      define variable vLevel  as int no-undo.
     2320      if not ChekTypeMarkByDM (icode) then return ?.
     2321      vLength = length(iCode).
     2322      if    vLength eq 18
     2323         or vLength eq 20
     2324      then
     2325         Vlevel = 4.
     2326      else if vLength eq 21
     2327      then
     2328         Vlevel = 1.
     2329      else if vLength eq 25
     2330      then do:
     2331         if  iCode begins "01"
     2332         then
     2333            Vlevel = 3.
     2334         else
     2335            Vlevel = 1.
     2336      end.
     2337      else if     vLength >= 26
     2338              and vLength <= 46
     2339      then do:
     2340         if    substring(iCode,17,2) eq "11"
     2341            or substring(iCode,17,2) eq "13"
     2342            or (    substring(iCode,17,2) eq "21"
     2343                and vLength >= 33
     2344                and substring(iCode,26,4) ne "8005")
     2345         then
     2346            Vlevel = 4.
     2347         else if    vLength eq 31
     2348                 or vLength eq 38
     2349                 or vLength eq 39
     2350                 or vLength eq 45
     2351         then
     2352            Vlevel = 1.
     2353         else if    vLength eq 35
     2354                 or vLength eq 43
     2355         then
     2356            Vlevel = 3.
     2357         else
     2358            Vlevel = ?.
     2359      end.
     2360      else
     2361         Vlevel = ?.
     2362      return Vlevel.
     2363   end.
     2364   function getLevelMotpBycodid return character
     2365   (iDm as char):
     2366      define variable vLevel as integer no-undo.
     2367      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2368      vLevel = getlevelByCodId(iDm).
     2369      if    vLevel eq ?
     2370         or vLevel < 1
     2371         or vLevel > 6
     2372      then
     2373         return ?.
     2374      else
     2375         return entry(vlevel,vList).
     2376   end.
     2377   function getLevelUTDByLevelMotp return character
     2378   (iUnit as char):
     2379      define variable vLevel as integer no-undo.
     2380      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2381      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2382      vLevel = lookup(iUnit,vListMOTP).
     2383      if    vLevel eq ?
     2384         or vLevel < 1
     2385         or vLevel > 4
     2386      then
     2387         return ?.
     2388      else
     2389         return entry(vlevel,vListutd).
     2390   end.
     2391   function getLevelMotpByDM return character
     2392   (iDm as char):
     2393      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2394   end.
     2395   function getLevelUTDByCodId return character
     2396   (iDm as char):
     2397      define variable vLevel as integer no-undo.
     2398      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2399      vLevel = getlevelByCodId(iDm).
     2400      if    vLevel eq ?
     2401         or vLevel < 1
     2402         or vLevel > 4
     2403      then
     2404         return ?.
     2405      else
     2406         return entry(vlevel,vList).
     2407   end.
     2408   function getLevelUTDByDM return character
     2409   (iDm as char):
     2410      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2411   end.
     2412   define variable mNotMarkQnty as logical no-undo.
     2413   function getQntyUTDByCodId return decimal
     2414   (iDM as char):
     2415      define variable vLevel as integer no-undo.
     2416      define variable vList as character no-undo init "1,5,10,500".
     2417      define variable vGtin as character no-undo.
     2418      define variable vqnty as decimal no-undo init ?.
     2419      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2420      if vqnty eq ?
     2421      then do:
     2422         if not mNotMarkQnty
     2423         then do:
     2424            define buffer marking for ub.marking.
     2425            define variable vCodident as character no-undo.
     2426            vCodident = GetCodeIdent(idm).
     2427            find first marking where marking.mark begins vCodident no-lock no-error.
     2428            if     available marking
     2429               and marking.box-qnty ne ?
     2430            then
     2431               return marking.box-qnty.
     2432         end.
     2433         vGtin = getGtinByDm(iDM).
     2434         if ChekTypeMarkByGtin (vGtin)
     2435         then do:
     2436            vLevel = getlevelByCodId(iDM).
     2437            if     vLevel >= 1
     2438               and vLevel <= 4
     2439            then
     2440               vqnty = int(entry(vlevel,vList)).
     2441         end.
     2442         else
     2443            vqnty = getQntyCodeByGtin(vgtin).
     2444      end.
     2445      return vqnty.
     2446   end.
     2447   function getQntyUTDByDM return decimal
     2448   (iDm as char):
     2449      define variable vDM as character no-undo.
     2450      if     length (iDm) ne 25
     2451         and length (iDm) ne 29
     2452         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2453      then
     2454         vDM = substring (iDm,1,length (iDm) - 6 ).
     2455      else
     2456         vDM = substring (iDm,1,length (iDm) - 4 ).
     2457      return getQntyUTDByCodId(vDM).
     2458   end.
     2459   function getMRC4 return decimal
     2460   (iMRC as char):
     2461      define variable oMrc     as decimal no-undo init ?.
     2462      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2463      define variable vi       as integer no-undo.
     2464      define variable vfound   as integer no-undo.
     2465      define variable vposStart   as integer no-undo.
     2466      do:
     2467      OMRc = 0.
     2468      do vi = 1 to 4:
     2469         define variable vsimb as character no-undo.
     2470         vsimb = substring(iMRC,vi,1).
     2471         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2472         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2473         if vfound > 0
     2474         then
     2475            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2476         end.
     2477         OMRc = OMRc / 100.
     2478      end.
     2479      return OMRc.
     2480   end.
     2481   function getMRCByDM return decimal
     2482   (iDm as char):
     2483      define variable vMRC     as character no-undo.
     2484      define variable oMrc     as decimal no-undo init ?.
     2485      define variable Velement as character no-undo init "empty".
     2486      define variable vteg as character no-undo.
     2487      define variable vtegval as character no-undo.
     2488      if    length(idm) eq 14 + 7 + 4 + 4
     2489         or length(idm) eq 14 + 7 + 4
     2490      then do:
     2491         vMRC = substring(idm,22,4).
     2492         omrc = getMRC4(vMRC).
     2493      end.
     2494      else do:
     2495          ChekTypeMarkByDm(iDm).
     2496          block-mrc:
     2497          do while Velement ne "" and idm ne "":
     2498             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2499             if Velement begins "8005"
     2500             then do:
     2501                vMRC = substring(Velement,5,6).
     2502                leave block-mrc.
     2503             end.
     2504             else if Velement begins "(8005)"
     2505             then do:
     2506                vMRC = substring(Velement,7,6).
     2507                leave block-mrc.
     2508             end.
     2509          end.
     2510          if vMRC ne ""
     2511          then
     2512             OMRc = dec(vmrc) / 100 no-error.
     2513      end.
     2514      return OMRc.
     2515   end.
     2516   function MoveDate return Date
     2517   (idate as date,
     2518    iMonth as int64):
     2519      define variable vMonth   as int64 no-undo.
     2520      define variable vYear    as int64 no-undo.
     2521      define variable vDateNew as date  no-undo.
     2522       define variable vDay     as int64 no-undo.
     2523       vMonth = month(iDate) + iMonth.
     2524       vYear =  year(iDate).
     2525       if vMonth <= 0
     2526       then assign
     2527          vMonth = vMonth + 12
     2528           vYear  = vYear - 1
     2529       .
     2530       else if vMonth > 12
     2531       then assign
     2532          vMonth = vMonth - 12
     2533           vYear  = vYear + 1
     2534       .
     2535       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2536       do while error-status:error eq yes:
     2537          VDay = vDay + 1.
     2538          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2539       end.
     2540       if VDay > 0
     2541       then
     2542          vDateNew + 1.
     2543       return vDateNew.
     2544   end.
     2545   procedure checkEMRC:
     2546   define input  parameter iDm as character no-undo.
     2547   define output parameter vok as logical   no-undo init yes.
     2548      define variable v-value-emrc as character no-undo.
     2549      define variable v-type-emrc  as character no-undo.
     2550      define variable vDateIso     as character no-undo.
     2551      define variable vMRC         as decimal no-undo.
     2552      define variable vqnty        as decimal no-undo.
     2553      define variable vPrice       as decimal no-undo.
     2554      define variable vparent      as character no-undo.
     2555      define variable vgds-code    as integer no-undo.
     2556      define buffer code for ub.code.
     2557      vMRC = getMRCByDM(iDm).
     2558      if vMRC > 0
     2559      then do:
     2560         vgds-code = getGdsCodeByDM(iDm).
     2561         vqnty     = getQntyUTDByDM(iDm).
     2562               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2563            (
     2564             input   vgds-code
     2565            ,input   'emrc-type':U
     2566            ,output   v-value-emrc
     2567            ,output   v-type-emrc
     2568          ) no-error.
     2569          if     v-value-emrc ne ""
     2570             and v-value-emrc ne ?
     2571          then do:
     2572             vDateIso = iso-date(today).
     2573             vPrice = vMRC / vqnty.
     2574             vparent ="emc" + chr(4) + v-value-emrc.
     2575             find last code where Code.parent      eq vparent
     2576                              and Code.code        le vDateIso
     2577                              and code.status_  eq 0
     2578             no-lock no-error.
     2579             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2580             then
     2581                vOk = true .
     2582             else do:
     2583                 define variable vText      as character no-undo.
     2584                 define variable vDate      as date no-undo.
     2585                 define variable vDateLast  as character no-undo.
     2586                 define variable vDateFirst as character no-undo.
     2587                 define variable vDate3     as date no-undo.
     2588                 vdate = date(code.misc1).
     2589                 vDateLast = code.misc1.
     2590                 vDate3 = MoveDate(today, - 3 ).
     2591                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2592                                      string(vDate3  , "99/99/9999"),
     2593                                      string(vDate   , "99/99/9999")
     2594                                      ).
     2595                 vdateIso = iso-date(vdate3).
     2596                 find last code  where Code.parent      eq vparent
     2597                                   and Code.code        le vDateIso
     2598                                   and code.status_  eq 0 no-lock no-error.
     2599                 if available code
     2600                 then
     2601                    vDateIso = code.code.
     2602                 vDateFirst = vDateIso.
     2603                 vDateLast = iso-date(vdate).
     2604                 define variable vGood as logical no-undo.
     2605                 define variable vDateSale as date no-undo.
     2606                 define buffer bcode for code.
     2607                 for last code where Code.parent   eq vparent
     2608                                 and code.status_  eq 0
     2609                                 and code.code     < vDateLast
     2610                                 and code.code     >= vDateFirst
     2611                 no-lock:
     2612                    find first bcode where bCode.parent   eq vparent
     2613                                       and bcode.status_  eq 0
     2614                                       and bcode.code     > code.code no-lock no-error.
     2615                    if available bcode
     2616                    then do:
     2617                       if vPrice < dec(Code.CodeValue)
     2618                       then
     2619                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2620                                                     chr(10),
     2621                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2622                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2623                                                     ).
     2624                       else do:
     2625                          vGood = yes.
     2626                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2627                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2628                                                     chr(10),
     2629                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2630                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2631                                                     string(         vDateSale            ,"99/99/9999"),
     2632                                                     string(vDateSale - today)
     2633                                                     ).
     2634                       end.
     2635                    end.
     2636                 end.
     2637                 if vgood
     2638                 then do:
     2639                    define variable choice as integer no-undo .
     2640                    run gbl/d-askw.w (input "Уточнение"
     2641                           ,input  vText
     2642                           ,input "|"
     2643                           ,input "Принять|Вернуть"
     2644                           ,input "Принять данный товар|Вернуть товар постащику"
     2645                           ,input 1
     2646                           ,input 2
     2647                           ,output choice) no-error.
     2648                    vok = choice eq 1.
     2649                 end.
     2650                 else
     2651                    vok =false.
     2652             end.
     2653          end.
     2654      end.
     2655   end.
     2656   function addGs2Mark return character
     2657   (iMark as char):
     2658      define variable vDM   as character no-undo.
     2659      define variable vIdx  as integer   no-undo.
     2660      if index(iMark,chr(29),1) > 0
     2661      then return iMark.
     2662      if substring(iMark,26,4) = "8005" then
     2663      do:
     2664        vIdx = index(iMark,"93",26 + 4 + 5).
     2665        if vIdx > 1 then do:
     2666          vDM = substitute("&1&4&2&4&3",
     2667                           substring(iMark,1,25),
     2668                           substring(iMark,26,vIdx - 25 - 1),
     2669                           substring(iMark,vIdx),
     2670                           chr(29)) no-error.
     2671          vIdx = index(vDm,"240",vIdx + 4).
     2672          if vIdx > 0 then
     2673          do:
     2674            vDM = substitute("&1&3&2",
     2675                             substring(vDm,1,vIdx - 1),
     2676                             substring(vDm,vIdx),
     2677                             chr(29)) no-error.
     2678          end.
     2679        end.
     2680        else
     2681          vDM = substitute("&1&3&2",
     2682                           substring(iMark,1,25),
     2683                           substring(iMark,26),
     2684                           chr(29)) no-error.
     2685      end.
     2686      else if substring(iMark,32,2) = "91" then
     2687      do:
     2688        vIdx = index(iMark,"92",32).
     2689        if vIdx > 1 then
     2690          vDM = substitute("&1&4&2&4&3",
     2691                           substring(iMark,1,31),
     2692                           substring(iMark,32,vIdx - 31 - 1),
     2693                           substring(iMark,vIdx),
     2694                           chr(29)) no-error.
     2695        else
     2696          vDM = substitute("&1&3&2",
     2697                           substring(iMark,1,31),
     2698                           substring(iMark,32),
     2699                           chr(29)) no-error.
     2700      end.
     2701      else if substring(iMark,39,2) = "91" then
     2702      do:
     2703        vIdx = index(iMark,"92",38).
     2704        if vIdx > 1 then
     2705          vDM = substitute("&1&4&2&4&3",
     2706                           substring(iMark,1,38),
     2707                           substring(iMark,39,vIdx - 38 - 1),
     2708                           substring(iMark,vIdx),
     2709                           chr(29)) no-error.
     2710        else
     2711          vDM = substitute("&1&3&2",
     2712                           substring(iMark,1,38),
     2713                           substring(iMark,39),
     2714                           chr(29)) no-error.
     2715      end.
     2716      else if substring(iMark,25,2) = "93" then
     2717      do:
     2718        vIdx = index(iMark,"92",25).
     2719        if vIdx > 1 then
     2720          vDM = substitute("&1&4&2&4&3",
     2721                           substring(iMark,1,24),
     2722                           substring(iMark,25,vIdx - 24 - 1),
     2723                           substring(iMark,vIdx),
     2724                           chr(29)) no-error.
     2725        else
     2726          vIdx = index(iMark,"3103",25).
     2727          if vIdx > 0 then
     2728          vDM = substitute("&1&4&2&4&3",
     2729                           substring(iMark,1,24),
     2730                           substring(iMark,25,vIdx - 24 - 1),
     2731                           substring(iMark,vIdx),
     2732                           chr(29)) no-error.
     2733          else
     2734            vDM = substitute("&1&3&2",
     2735                             substring(iMark,1,24),
     2736                             substring(iMark,25),
     2737                             chr(29)) no-error.
     2738      end.
     2739      else if substring(iMark,32,2) = "93" then
     2740      do:
     2741        vDM = substitute("&1&3&2",
     2742              substring(iMark,1,31),
     2743              substring(iMark,32),
     2744              chr(29)) no-error.
     2745      end.
     2746      return if vDM <> "" then vDm else iMark.
     2747   end.
     2748   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2749   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2750   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2751   procedure gen-key-rec :
     2752     define input  parameter p-tbl-name    as character no-undo.
     2753     define input  parameter p-bh_tbl-name as handle    no-undo.
     2754     define output parameter p-key-rec     as character no-undo.
     2755     do
     2756     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2757     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2758     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2759     :
     2760       define variable fh               as handle    no-undo .
     2761       define variable v-ok             as logical   no-undo .
     2762       define variable v-inform         as character no-undo .
     2763       define variable v-ind            as integer   no-undo .
     2764       define variable v-idx-field-qnty as integer   no-undo .
     2765       if p-tbl-name = ?
     2766         or p-tbl-name = "":U
     2767       then do:
     2768         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info12 ).
     2769       end.
     2770       if not p-bh_tbl-name:available then do:
     2771         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info12, p-tbl-name ).
     2772       end.
     2773       assign
     2774         p-key-rec = p-tbl-name
     2775         v-inform  = p-bh_tbl-name:index-information(1)
     2776         v-ind     = 2
     2777       .
     2778       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2779       on error undo, return error
     2780       :
     2781         assign
     2782           v-inform = p-bh_tbl-name:index-information( v-ind )
     2783           v-ind    = v-ind + 1
     2784         .
     2785       end.
     2786       if v-inform = ?
     2787         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2788         or entry( 3, v-inform, ",":U ) <> "1":U
     2789       then do:
     2790         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, p-tbl-name ).
     2791       end.
     2792       else do:
     2793         assign
     2794           v-idx-field-qnty = num-entries( v-inform ) - 4
     2795         .
     2796         if v-idx-field-qnty < 2 then do:
     2797           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, p-tbl-name ).
     2798         end.
     2799         do v-ind = 1 to v-idx-field-qnty by 2
     2800         on error undo, return error
     2801         :
     2802           assign
     2803             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2804             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2805           .
     2806         end.
     2807       end.
     2808       if p-key-rec = ? then do:
     2809         assign
     2810           p-key-rec = "":U
     2811         .
     2812         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info12, p-tbl-name ).
     2813       end.
     2814     end.
     2815     return.
     2816   end procedure.
     2817   procedure gen-where-keyr-tab :
     2818     define input  parameter i-tableSerach as character no-undo.
     2819     define input  parameter i-tablekey   as character  no-undo.
     2820     define input  parameter p-key-rec    as character  no-undo.
     2821     define input  parameter p-key-handle as handle     no-undo .
     2822     define input  parameter p-db-name    as character  no-undo .
     2823     define input  parameter p-tt-handle  as handle     no-undo .
     2824     define output parameter o-Where      as character  no-undo.
     2825     do
     2826     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2827     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2828     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2829     :
     2830       define variable v-full-tbl-name  as character no-undo .
     2831       define variable bh_tbl-name      as handle    no-undo .
     2832       define variable fh_key           as handle    no-undo .
     2833       define variable fh_search        as handle    no-undo .
     2834       define variable v-field-num      as integer   no-undo .
     2835       define variable v-count-fld      as integer   no-undo .
     2836       define variable v-inform         as character no-undo .
     2837       define variable v-ind            as integer   no-undo .
     2838       define variable v-idx-field-qnty as integer   no-undo .
     2839       define variable v-field-name     as character no-undo .
     2840       define variable v-field-val      as character no-undo .
     2841       define variable v-word-link      as character no-undo .
     2842       define variable vTable           as character no-undo.
     2843       define variable bh_tbl-key       as handle    no-undo .
     2844       assign
     2845         p-key-rec = trim( p-key-rec )
     2846       .
     2847       if p-key-handle <> ? then do:
     2848         if not valid-handle(p-key-handle)
     2849            or p-key-handle:type <> "buffer"
     2850         then do:
     2851           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info12 ).
     2852         end.
     2853         if num-entries( p-key-rec, chr(3) ) > 1
     2854           or p-key-rec = ?
     2855           or p-key-rec = "":U
     2856         then do:
     2857           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info12, p-key-rec ).
     2858         end.
     2859       end.
     2860       else do:
     2861         if p-key-rec = ?
     2862           or p-key-rec = "":U
     2863         then do:
     2864           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     2865         end.
     2866       end.
     2867       assign
     2868         vTable = entry( 1 , p-key-rec, chr(3) )
     2869       .
     2870       if p-tt-handle <> ?
     2871         and ( not valid-handle(p-tt-handle)
     2872               or p-tt-handle:type <> "buffer"
     2873             )
     2874       then do:
     2875         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info12, vTable, chr(10) ).
     2876       end.
     2877       if p-tt-handle = ? then do:
     2878         assign
     2879           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2880         .
     2881         create buffer bh_tbl-name for table v-full-tbl-name .
     2882       end.
     2883       else do:
     2884         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2885       end.
     2886       assign
     2887         v-inform = bh_tbl-name:index-information(1)
     2888         v-ind    = 2
     2889       .
     2890       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2891       on error undo, return error
     2892       :
     2893         assign
     2894           v-inform = bh_tbl-name:index-information( v-ind )
     2895           v-ind    = v-ind + 1
     2896         .
     2897       end.
     2898       if v-inform = ?
     2899         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2900         or entry( 3, v-inform, ",":U ) <> "1":U
     2901       then do:
     2902         delete object bh_tbl-name no-error.
     2903         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info12, vTable ).
     2904       end.
     2905       assign
     2906         v-idx-field-qnty = num-entries( v-inform ) - 4
     2907       .
     2908       if v-idx-field-qnty < 2 then do:
     2909         delete object bh_tbl-name no-error.
     2910         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, vTable ).
     2911       end.
     2912       assign
     2913         o-where     = "where":U
     2914         v-word-link = "":U
     2915         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2916         v-count-fld = 0
     2917       .
     2918       if i-tablekey ne "" and i-tablekey ne ?
     2919       then do:
     2920         assign
     2921           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2922         .
     2923         create buffer bh_tbl-key for table v-full-tbl-name .
     2924       end.
     2925       if i-tableSerach ne "" and i-tableSerach ne ?
     2926       then do:
     2927         delete object bh_tbl-name no-error.
     2928         assign
     2929           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2930         .
     2931         create buffer bh_tbl-name for table v-full-tbl-name .
     2932       end.
     2933       block_where:
     2934       do v-ind = 1 to v-idx-field-qnty by 2
     2935       on error undo, return error
     2936       :
     2937         assign
     2938           v-count-fld = v-count-fld + 1
     2939         .
     2940         if p-key-handle = ?
     2941           and v-count-fld > v-field-num
     2942         then do:
     2943           leave block_where.
     2944         end.
     2945         define variable VfieldKeyTable as handle no-undo.
     2946         assign
     2947           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2948           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2949         .
     2950         if     bh_tbl-key ne ?
     2951         then do:
     2952            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2953            if VfieldKeyTable eq ?
     2954            then next block_where.
     2955         end.
     2956         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2957         then
     2958            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2959         else
     2960            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2961         if p-key-handle = ? then do:
     2962           assign
     2963             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2964           .
     2965         end.
     2966         else do:
     2967           assign
     2968             fh_key = p-key-handle:buffer-field( v-field-name )
     2969           .
     2970           if fh_key = ?
     2971             or not valid-handle( fh_key )
     2972           then do:
     2973             delete object bh_tbl-name.
     2974             if     bh_tbl-key ne ?
     2975             then
     2976                delete object bh_tbl-key.
     2977             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info12, p-key-handle:name, v-field-name ).
     2978           end.
     2979           assign
     2980             v-field-val = fh_key:buffer-value
     2981           .
     2982         end.
     2983         if fh_search:data-type ="character":U then do:
     2984           assign
     2985             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2986             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2987             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2988             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2989             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2990             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2991             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2992             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2993             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2994             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2995             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2996             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2997             v-field-val = substitute( '"&1"', v-field-val )
     2998           .
     2999         end.
     3000         assign
     3001           o-where = substitute( "&1 &2", o-where, v-field-val )
     3002         .
     3003         if v-word-link = "":U then do:
     3004           assign
     3005             v-word-link = "and":U
     3006           .
     3007         end.
     3008       end.
     3009       delete object bh_tbl-name.
     3010       if     bh_tbl-key ne ?
     3011       then
     3012          delete object bh_tbl-key.
     3013       if p-key-handle = ?
     3014         and v-count-fld <> v-field-num
     3015       then do:
     3016         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info12, vTable ).
     3017       end.
     3018     end.
     3019   end procedure.
     3020   procedure gen-hn-keyr-tab :
     3021     define input  parameter i-tableSerach as character no-undo.
     3022     define input  parameter i-tablekey   as character no-undo.
     3023     define input  parameter p-key-rec    as character no-undo.
     3024     define input  parameter p-key-handle as handle    no-undo .
     3025     define input  parameter p-db-name    as character no-undo .
     3026     define input  parameter p-tt-handle  as handle    no-undo .
     3027     define input  parameter p-stts-lock  as integer   no-undo .
     3028     define output parameter o-hn         as handle    no-undo.
     3029     define variable v-full-tbl-name as character no-undo.
     3030     define variable v-where         as character no-undo.
     3031     define variable bh_tbl-name     as handle    no-undo.
     3032     define variable vTable          as character no-undo.
     3033     do
     3034     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3035     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3036     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3037         run gen-where-keyr-tab(i-tableSerach,
     3038                                i-tablekey,
     3039                                p-key-rec,
     3040                                p-key-handle,
     3041                                p-db-name,
     3042                                p-tt-handle,
     3043                                output v-where).
     3044         if i-tableSerach ne "" and i-tableSerach ne ?
     3045         then do:
     3046            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3047            create buffer bh_tbl-name for table v-full-tbl-name .
     3048         end.
     3049         else do:
     3050            if p-tt-handle = ? then do:
     3051               assign
     3052                  vTable = entry( 1 , p-key-rec, chr(3) )
     3053               .
     3054               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3055               create buffer bh_tbl-name for table v-full-tbl-name .
     3056            end.
     3057            else do:
     3058               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3059            end.
     3060         end.
     3061         if p-tt-handle = ? then do:
     3062            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3063         end.
     3064         else do:
     3065            bh_tbl-name:find-first( v-where ) no-error .
     3066         end.
     3067         o-hn = bh_tbl-name.
     3068      end.
     3069   end procedure.
     3070   procedure gen-hn-keyr :
     3071     define input  parameter p-key-rec    as character no-undo.
     3072     define input  parameter p-key-handle as handle    no-undo .
     3073     define input  parameter p-db-name    as character no-undo .
     3074     define input  parameter p-tt-handle  as handle    no-undo .
     3075     define input  parameter p-stts-lock  as integer   no-undo .
     3076     define output parameter o-hn         as handle    no-undo.
     3077     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3078   end.
     3079   procedure gen-row-keyr :
     3080     define input  parameter p-key-rec    as character no-undo.
     3081     define input  parameter p-key-handle as handle    no-undo .
     3082     define input  parameter p-db-name    as character no-undo .
     3083     define input  parameter p-tt-handle  as handle    no-undo .
     3084     define input  parameter p-stts-lock  as integer   no-undo .
     3085     define output parameter p-tbl-row    as rowid     no-undo.
     3086     define output parameter p-tbl-name   as character no-undo.
     3087     define variable vHn as handle no-undo.
     3088       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3089       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3090       p-tbl-name =  vHn:table.
     3091       delete object vHn no-error.
     3092     if p-tbl-row = ? then do:
     3093       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info12, p-tbl-name, p-key-rec ).
     3094     end.
     3095     else do:
     3096       return.
     3097     end.
     3098   end procedure.
     3099   procedure gen-key-fv :
     3100     define input  parameter p-key-rec    as character no-undo .
     3101     define output parameter p-field-list as character no-undo .
     3102     define output parameter p-value-list as character no-undo.
     3103     do
     3104     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3105     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3106     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3107     :
     3108       define variable v-full-tbl-name  as character no-undo .
     3109       define variable bh_tbl-name      as handle    no-undo .
     3110       define variable v-tbl-name       as character no-undo .
     3111       define variable v-field-num      as integer   no-undo .
     3112       define variable v-count-fld      as integer   no-undo .
     3113       define variable v-inform         as character no-undo .
     3114       define variable v-ind            as integer   no-undo .
     3115       define variable v-idx-field-qnty as integer   no-undo .
     3116       define variable v-delim-key      as character no-undo .
     3117       if p-key-rec = ?
     3118         or p-key-rec = "":U
     3119       then do:
     3120         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     3121       end.
     3122       assign
     3123         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3124         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3125       .
     3126       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3127       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info12 ).
     3128       assign
     3129         v-inform = bh_tbl-name:index-information(1)
     3130         v-ind    = 2
     3131       .
     3132       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3133       on error undo, return error
     3134       :
     3135         assign
     3136           v-inform = bh_tbl-name:index-information( v-ind )
     3137           v-ind    = v-ind + 1
     3138         .
     3139       end.
     3140       if v-inform = ?
     3141         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3142         or entry( 3, v-inform, ",":U ) <> "1":U
     3143       then do:
     3144         delete object bh_tbl-name no-error.
     3145         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     3146       end.
     3147       assign
     3148         v-idx-field-qnty = num-entries( v-inform ) - 4
     3149       .
     3150       if v-idx-field-qnty < 2 then do:
     3151         delete object bh_tbl-name no-error.
     3152         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     3153       end.
     3154       assign
     3155         p-field-list = "":U
     3156         p-value-list = "":U
     3157         v-delim-key  = "":U
     3158         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3159         v-count-fld  = 0
     3160       .
     3161       block_where:
     3162       do v-ind = 1 to v-idx-field-qnty by 2
     3163       on error undo, return error
     3164       :
     3165         assign
     3166           v-count-fld = v-count-fld + 1
     3167         .
     3168         if v-count-fld > v-field-num then do:
     3169           leave block_where.
     3170         end.
     3171         assign
     3172           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3173           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3174         .
     3175         if v-ind = 1 then do:
     3176           assign
     3177             v-delim-key = chr(3)
     3178           .
     3179         end.
     3180       end.
     3181       delete object bh_tbl-name.
     3182       if v-count-fld <> v-field-num then do:
     3183         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info12, v-tbl-name ).
     3184       end.
     3185     end.
     3186   end procedure.
     3187   procedure gen-key-field :
     3188     define input  parameter p-table      as character no-undo .
     3189     define output parameter p-field-list as character no-undo .
     3190     do
     3191     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3192     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3193     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3194     :
     3195       define variable v-full-tbl-name  as character no-undo .
     3196       define variable bh_tbl-name      as handle    no-undo .
     3197       define variable v-tbl-name       as character no-undo .
     3198       define variable v-field-num      as integer   no-undo .
     3199       define variable v-count-fld      as integer   no-undo .
     3200       define variable v-inform         as character no-undo .
     3201       define variable v-ind            as integer   no-undo .
     3202       define variable v-idx-field-qnty as integer   no-undo .
     3203       define variable v-delim-key      as character no-undo .
     3204       if p-table = ?
     3205         or p-table = "":U
     3206       then do:
     3207         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info12 ).
     3208       end.
     3209       assign
     3210         v-tbl-name      = p-table
     3211         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3212       .
     3213       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3214       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info12 ).
     3215       assign
     3216         v-inform = bh_tbl-name:index-information(1)
     3217         v-ind    = 2
     3218       .
     3219       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3220       on error undo, return error
     3221       :
     3222         assign
     3223           v-inform = bh_tbl-name:index-information( v-ind )
     3224           v-ind    = v-ind + 1
     3225         .
     3226       end.
     3227       if v-inform = ?
     3228         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3229         or entry( 3, v-inform, ",":U ) <> "1":U
     3230       then do:
     3231         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     3232       end.
     3233       assign
     3234         v-idx-field-qnty = num-entries( v-inform ) - 4
     3235       .
     3236       if v-idx-field-qnty < 2 then do:
     3237         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     3238       end.
     3239       assign
     3240         p-field-list = "":U
     3241         v-delim-key  = "":U
     3242         v-count-fld  = 0
     3243       .
     3244       block_where:
     3245       do v-ind = 1 to v-idx-field-qnty by 2
     3246       on error undo, return error
     3247       :
     3248         assign
     3249           v-count-fld = v-count-fld + 1
     3250         .
     3251         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3252         if v-ind = 1 then do:
     3253           assign
     3254             v-delim-key = chr(3)
     3255           .
     3256         end.
     3257       end.
     3258       delete object bh_tbl-name.
     3259     end.
     3260   end procedure.
     3261   function AddUtdErrForTab returns logical
     3262   (idb-num         as integer ,
     3263    idoc-id         as integer ,
     3264    iTab            as character,
     3265    iObj            as handle ,
     3266    iCheckType      as character,
     3267    iCodeErr        as character,
     3268    iCheckObj       as character ):
     3269      define buffer utd-err for utd-err.
     3270      define buffer utd for utd.
     3271      find first utd where utd.db-num     eq idb-num
     3272                       and utd.doc-id     eq idoc-id
     3273                       and utd.Direction  eq 'Outbound'
     3274      no-lock no-error.
     3275      if available utd
     3276      then
     3277         return no.
     3278      define variable vRecKey as character no-undo.
     3279            run gen-key-rec (input iTab,
     3280                             input  iObj,
     3281                             output vRecKey).
     3282      find first utd-err where utd-err.db-num     eq idb-num
     3283                           and utd-err.doc-id     eq idoc-id
     3284                           and utd-err.CheckType  eq iCheckType
     3285                           and utd-err.CodeErr    eq iCodeErr
     3286                           and utd-err.CheckObj   eq iCheckObj
     3287      exclusive-lock no-error.
     3288      if not available utd-err
     3289      then do:
     3290         create utd-err.
     3291         assign
     3292            utd-err.db-num         = idb-num
     3293            utd-err.doc-id         = idoc-id
     3294            utd-err.CheckType      = iCheckType
     3295            utd-err.CodeErr        = iCodeErr
     3296            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3297            utd-err.reckey         = vRecKey
     3298            utd-err.qnty           = 1
     3299         .
     3300      end.
     3301      else
     3302         utd-err.qnty = utd-err.qnty + 1.
     3303      return utd-err.qnty eq 1.
     3304   end.
     3305   function AddUtdErr returns logical
     3306   (idb-num         as integer ,
     3307    idoc-id         as integer ,
     3308    iObj            as handle ,
     3309    iCheckType      as character,
     3310    iCodeErr        as character,
     3311    iCheckObj       as character ):
     3312      AddUtdErrForTab
     3313         (idb-num,
     3314          idoc-id,
     3315          iObj:table,
     3316          iObj,
     3317          iCheckType,
     3318          iCodeErr,
     3319          iCheckObj).
     3320   end.
     3321   function ClearUtdErrTypeCode returns logical
     3322   (idb-num         as integer,
     3323    idoc-id         as integer ,
     3324    iCheckType      as character,
     3325    iCodeErr        as character
     3326    ):
     3327      define buffer utd-err for utd-err.
     3328      if    iCheckType eq "*"
     3329         or iCheckType eq ?
     3330      then do:
     3331         if     iCodeErr ne ?
     3332            and iCodeErr ne "*"
     3333         then
     3334            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3335            view-as alert-box.
     3336         else
     3337         for each utd-err where utd-err.db-num  eq idb-num
     3338                            and utd-err.doc-id  eq idoc-id
     3339         exclusive-lock:
     3340            delete utd-err.
     3341         end.
     3342      end.
     3343      else do:
     3344         if    iCodeErr eq ?
     3345            or iCodeErr eq "*"
     3346         then do:
     3347            for each utd-err where utd-err.db-num     eq idb-num
     3348                               and utd-err.doc-id     eq idoc-id
     3349                               and utd-err.CheckType  eq iCheckType
     3350            exclusive-lock:
     3351               delete utd-err.
     3352            end.
     3353         end.
     3354         else do:
     3355            for each utd-err where utd-err.db-num     eq idb-num
     3356                               and utd-err.doc-id     eq idoc-id
     3357                               and utd-err.CheckType  eq iCheckType
     3358                               and ub.utd-err.CodeErr eq iCodeErr
     3359            exclusive-lock:
     3360               delete utd-err.
     3361            end.
     3362         end.
     3363      end.
     3364   end.
     3365   function ClearUtdErr returns logical
     3366   (idb-num         as integer,
     3367    idoc-id         as integer ,
     3368    iCheckType      as character
     3369    ):
     3370      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3371   end.
     3372   function GetMesError returns character
     3373   (itxt as character,
     3374    iobj as character ):
     3375    define variable vi as integer no-undo.
     3376    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3377       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3378    end.
     3379    return itxt.
     3380   end.
     3381   function GetTextErrorType returns character
     3382   (iCheckType as character,
     3383    iCodeErr   as character,
     3384    iChechObj  as character,
     3385    iType      as character  ):
     3386      define buffer code    for code.
     3387      define variable vError as character no-undo.
     3388      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3389                        and code.code   eq iCodeErr
     3390      no-lock no-error.
     3391      if available code
     3392      then do:
     3393         define variable vType as integer no-undo.
     3394         if code.misc3 eq "error"
     3395         then
     3396            vType = 0.
     3397         else if code.misc3 eq "warning"
     3398         then
     3399            vType = 1.
     3400         else if code.misc3 eq "Hiden"
     3401         then
     3402            vType = 2.
     3403         else
     3404            vtype = int(code.misc3) no-error.
     3405         case itype:
     3406            when "error"
     3407            then do:
     3408               if vtype eq 0
     3409               then
     3410                  vError = GetMesError(Code.CodeValue,iChechObj).
     3411            end.
     3412            when "warning"
     3413            then do:
     3414               if vtype <= 1
     3415               then
     3416                  vError = GetMesError(Code.CodeValue,iChechObj).
     3417            end.
     3418            otherwise do:
     3419               vError = GetMesError(Code.CodeValue,iChechObj).
     3420            end.
     3421         end.
     3422      end.
     3423      else
     3424         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3425      return vError.
     3426   end.
     3427   function GetTypeError returns integer
     3428   (iCheckType as character,
     3429    iCodeErr   as character):
     3430      define buffer code    for code.
     3431      define variable vType as integer no-undo.
     3432      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3433                        and code.code   eq iCodeErr
     3434      no-lock no-error.
     3435      if     not available code
     3436         and code.misc3 eq "error"
     3437      then
     3438         vType = 0.
     3439      else if code.misc3 eq "warning"
     3440      then
     3441         vType = 1.
     3442      else if code.misc3 eq "Hiden"
     3443      then
     3444         vType = 2.
     3445      else
     3446         vtype = int(code.misc3) no-error.
     3447      return vtype.
     3448   end.
     3449   function GetTextError returns character
     3450   (iCheckType as character,
     3451    iCodeErr   as character,
     3452    iChechObj  as character ):
     3453      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3454   end.
     3455   function GetErrForUtdStr returns character
     3456   (idb-num     as integer ,
     3457    idoc-id     as integer ,
     3458    iCheckType  as character
     3459    ):
     3460      define buffer utd-err for utd-err.
     3461      define buffer code    for code.
     3462      define variable vHQry as handle no-undo.
     3463      define variable vError as longchar no-undo.
     3464      define variable vErrorOne as longchar  no-undo.
     3465      define variable oError as character no-undo.
     3466      create query vHQry.
     3467      vHQry:set-buffers(buffer utd-err:handle).
     3468      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3469                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3470                               + if    iCheckType eq "*"
     3471                                    or iCheckType eq ?
     3472                                 then       ""
     3473                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3474      vHQry:query-open().
     3475      vHQry:get-first().
     3476      QRY-BLOCK:
     3477      repeat while not vHQry:query-off-end:
     3478         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3479         if     vErrorOne ne ""
     3480            and vErrorOne ne ?
     3481         then
     3482            vError = vError + ", " + vErrorOne.
     3483         vHQry:get-next().
     3484      end.
     3485      oError = substring(vError,3,4002).
     3486      return oError.
     3487   end.
     3488   function GetErrJsonForUtd returns character
     3489   (idb-num         as integer ,
     3490    idoc-id         as integer ,
     3491    iCheckType      as character
     3492    ):
     3493      define buffer utd-err for utd-err.
     3494      define variable vHQry as handle no-undo.
     3495      define variable vError as longchar no-undo.
     3496      define variable oError as character no-undo.
     3497      create query vHQry.
     3498      define variable vi as integer no-undo.
     3499      vHQry:set-buffers(buffer utd-err:handle).
     3500      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3501                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3502                               + if    iCheckType eq "*"
     3503                                    or iCheckType eq ?
     3504                                 then       ""
     3505                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3506      vHQry:query-open().
     3507      vHQry:get-first().
     3508      QRY-BLOCK:
     3509      repeat while not vHQry:query-off-end:
     3510         define variable vErrorOne as character no-undo.
     3511         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3512         if     vErrorOne ne ?
     3513            and vErrorOne ne ""
     3514         then do:
     3515            vi = vi + 1.
     3516            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3517                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3518                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3519         end.
     3520         vHQry:get-next().
     3521      end.
     3522      for first utd where utd.db-num eq idb-num
     3523                      and utd.doc-id eq idoc-id
     3524                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3525      no-lock,
     3526         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3527                                  and utd-marking-lines.doc-id eq idoc-id
     3528                                  and utd-marking-lines.doc-level eq 1
     3529      no-lock,
     3530         first marking where marking.mark eq utd-marking-lines.mark
     3531                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3532      no-lock:
     3533         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3534         if     vErrorOne ne ?
     3535            and vErrorOne ne ""
     3536         then do:
     3537            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3538                            + '","ОбъектОш":"' + marking.mark
     3539                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3540         end.
     3541      end.
     3542      if vError ne ""
     3543      then
     3544         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3545      return oError.
     3546   end.
     3547   function GetErrJsonForUtdReturn returns character
     3548   (idb-num         as integer ,
     3549    idoc-id         as integer ,
     3550    iCheckType      as character
     3551    ):
     3552      define buffer utd-err for utd-err.
     3553      define variable vHQry as handle no-undo.
     3554      define variable vError as longchar no-undo.
     3555      define variable oError as character no-undo.
     3556      define variable vi as integer no-undo.
     3557      create query vHQry.
     3558      vHQry:set-buffers(buffer utd-err:handle).
     3559      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3560                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3561                               + if    iCheckType eq "*"
     3562                                    or iCheckType eq ?
     3563                                 then       ""
     3564                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3565      vHQry:query-open().
     3566      vHQry:get-first().
     3567      QRY-BLOCK:
     3568      repeat while not vHQry:query-off-end:
     3569         define variable vErrorOne as character no-undo.
     3570         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3571         if     vErrorOne ne ?
     3572            and vErrorOne ne ""
     3573         then do:
     3574            vi = vi + 1.
     3575            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3576                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3577                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3578         end.
     3579         vHQry:get-next().
     3580      end.
     3581      if vError ne ""
     3582      then
     3583         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3584      return oError.
     3585   end.
     3586   function GetCodeTextError returns character
     3587   (iCheckType as character,
     3588    iCodeErr   as character,
     3589    iChechObj  as character,
     3590    output oCode as character,
     3591    output ovalue as character ):
     3592      define buffer code    for code.
     3593      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3594                        and code.code   eq iCodeErr
     3595      no-lock no-error.
     3596      if     available code
     3597      then do:
     3598         define variable vi as integer no-undo init ?.
     3599         vi = int(Code.misc3) no-error.
     3600         if    code.misc3 ne "error"
     3601            and vi ne 0
     3602         then
     3603            oCode = ?.
     3604         else if     Code.misc1 ne ?
     3605                 and Code.misc1 ne ""
     3606         then
     3607            assign
     3608               oCode  = GetMesError(Code.misc1,iChechObj)
     3609               ovalue = GetMesError(Code.misc2,iChechObj)
     3610            .
     3611      end.
     3612      return if oCode eq ""
     3613             then ""
     3614             else (oCode + "_" + ovalue).
     3615   end.
     3616   define temp-table TT-err no-undo
     3617     field code_ as character
     3618     field text_ as character
     3619   index code_ code_.
     3620   function GetErrTxtForUtd returns character
     3621   (idb-num         as integer ,
     3622    idoc-id         as integer ,
     3623    iCheckType      as character
     3624    ):
     3625      define buffer utd-err for utd-err.
     3626      define variable vHQry as handle no-undo.
     3627      define variable oError as character no-undo.
     3628      create query vHQry.
     3629      define variable vi as integer no-undo.
     3630      for each tt-err :
     3631         delete tt-err.
     3632      end.
     3633      vHQry:set-buffers(buffer utd-err:handle).
     3634      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3635                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3636                               + if    iCheckType eq "*"
     3637                                    or iCheckType eq ?
     3638                                 then       ""
     3639                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3640      vHQry:query-open().
     3641      vHQry:get-first().
     3642      define variable vcode as character no-undo.
     3643      define variable vvalue as character no-undo.
     3644      QRY-BLOCK:
     3645      repeat while not vHQry:query-off-end:
     3646         vi = vi + 1.
     3647         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3648         if vcode ne ?
     3649         then do:
     3650            find first tt-err where tt-err.code eq vcode
     3651            no-error.
     3652            if not available tt-err
     3653            then do:
     3654               create tt-err.
     3655               assign
     3656                  tt-err.code_ = vcode
     3657                  tt-err.text_ = vvalue
     3658               .
     3659            end.
     3660            else
     3661               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3662         end.
     3663         vHQry:get-next().
     3664      end.
     3665     find first utd where utd.db-num eq idb-num
     3666                         and utd.doc-id eq idoc-id
     3667         no-lock.
     3668      define buffer cancel_utd-lines for utd-lines.
     3669      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3670                                  and cancel_utd-lines.doc-id eq idoc-id
     3671      no-lock:
     3672         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3673         then do:
     3674            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3675                                        and utd-marking-lines.doc-id eq idoc-id
     3676                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3677            no-lock,
     3678               first marking where marking.mark eq utd-marking-lines.mark
     3679                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3680            no-lock:
     3681               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3682               find first tt-err where tt-err.code eq vcode
     3683               no-error.
     3684               if not available tt-err
     3685               then do:
     3686                  create tt-err.
     3687                  assign
     3688                     tt-err.code_ = vcode
     3689                     tt-err.text_ = vvalue
     3690                  .
     3691               end.
     3692               else
     3693                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3694            end.
     3695         end.
     3696         else do:
     3697            define variable vqnty as decimal no-undo.
     3698            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3699            if vqnty eq ? then vqnty = 0.
     3700            if vqnty ne cancel_utd-lines.Quantity
     3701            then do:
     3702               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3703               find first tt-err where tt-err.code eq vcode
     3704               no-error.
     3705               if not available tt-err
     3706               then do:
     3707                  create tt-err.
     3708                  assign
     3709                     tt-err.code_ = vcode
     3710                     tt-err.text_ = vvalue
     3711                  .
     3712               end.
     3713               else
     3714                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3715            end.
     3716         end.
     3717      end.
     3718      for each tt-err:
     3719         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3720      end.
     3721      return oError.
     3722   end.
     3723   define variable mFormatErr as character no-undo init "text".
     3724   function GetErrForUtd returns character
     3725   (idb-num         as integer ,
     3726    idoc-id         as integer ,
     3727    iType           as character
     3728    ):
     3729      if mFormatErr eq "text"
     3730      then
     3731         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3732      else do:
     3733         if itype eq "return"
     3734         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3735         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3736      end.
     3737   end.
     3738   function GetErrComText returns longchar
     3739   (icomment as character,
     3740    itext    as longchar ):
     3741       define variable vText as longchar no-undo.
     3742      if mFormatErr eq "text"
     3743      then do:
     3744         if icomment ne ""
     3745         then
     3746            icomment = substitute("comment:|&1|",icomment).
     3747         vText = icomment + itext.
     3748      end.
     3749      else do:
     3750         icomment = if icomment begins  '"'
     3751                    then icomment
     3752                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3753         vText = icomment + "," + itext.
     3754         vText = "~{" + trim(vText,",") + "~}".
     3755      end.
     3756      return vText.
     3757   end.
     3758   function CheckTypeForMarkLineType returns logical
     3759   (iObj            as handle,
     3760    iCheckType      as character,
     3761    iCodeErr        as character ,
     3762    iTypeErr        as character ):
     3763      define variable vRecKey-markLine as character no-undo.
     3764      define variable vGoodMark        as logical no-undo.
     3765      define variable vdb-num          as integer no-undo.
     3766      define variable vdoc-id          as integer no-undo.
     3767      define variable vlinenum         as integer no-undo.
     3768      define variable vErrorOne as character no-undo.
     3769      define buffer buf_utd-err for utd-err.
     3770      run gen-key-rec (input "utd-marking-lines",
     3771                       input  iObj,
     3772                       output vRecKey-markLine).
     3773      vGoodMark = yes.
     3774      vdb-num = iObj::db-num.
     3775      vdoc-id = iObj::doc-id.
     3776      vlinenum = iObj::linenum.
     3777      block-mark-err:
     3778      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3779                               and buf_utd-err.db-num = vdb-num
     3780                               and buf_utd-err.reckey = vRecKey-markLine
     3781                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3782                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3783      no-lock:
     3784         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3785         if     vErrorOne ne ?
     3786            and vErrorOne ne ""
     3787         then do:
     3788            vGoodMark = no.
     3789            leave block-mark-err.
     3790         end.
     3791      end.
     3792      return not vGoodMark.
     3793   end.
     3794   function CheckErrForMarkLineType returns logical
     3795   (iObj            as handle,
     3796    iType           as character  ):
     3797      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3798   end.
     3799   function CheckErrForMarkLine returns logical
     3800   (iObj            as handle):
     3801      return CheckErrForMarkLineType(iObj,"*").
     3802   end.
     3803   function CheckErrForLineTypeCode returns logical
     3804   (iObj                 as handle,
     3805    iCheckType           as character,
     3806    iCodeErr             as character,
     3807    iTypeErr             as character,
     3808    iOneErr              as logical):
     3809      define variable vRecKey-line     as character no-undo.
     3810      define buffer buf_utd-err for utd-err.
     3811      define variable vUtdlineError as logical no-undo.
     3812      define variable vErrorOne as character no-undo.
     3813            run gen-key-rec (input "utd-lines",
     3814                             input  iObj,
     3815                             output vRecKey-line).
     3816         define variable vdb-num as integer no-undo.
     3817         define variable vdoc-id as integer no-undo.
     3818         define variable vlinenum as integer no-undo.
     3819         vdb-num = iObj::db-num.
     3820         vdoc-id = iObj::doc-id.
     3821         vlinenum = iObj::linenum.
     3822         block-err:
     3823         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3824                                  and buf_utd-err.db-num = vdb-num
     3825                                  and buf_utd-err.reckey = vRecKey-line
     3826                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3827                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3828         no-lock:
     3829            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3830            if     vErrorOne ne ?
     3831               and vErrorOne ne ""
     3832            then do:
     3833               vUtdlineError = yes.
     3834               leave block-err.
     3835            end.
     3836         end.
     3837         if  not vUtdlineError
     3838         then do:
     3839            define variable vGoodMark as logical no-undo.
     3840            vGoodMark = yes.
     3841            block-line-err:
     3842            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3843                                         and utd-marking-lines.doc-id  eq vdoc-id
     3844                                         and utd-marking-lines.LineNum eq vLineNum
     3845            no-lock:
     3846               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3847               if     vGoodMark
     3848                  and iOneErr eq no
     3849               then
     3850                  leave block-line-err.
     3851               if     iOneErr = yes
     3852                  and not vGoodMark
     3853               then
     3854                  leave block-line-err.
     3855            end.
     3856            vUtdlineError = not vGoodMark.
     3857         end.
     3858      return vUtdlineError.
     3859   end.
     3860   function getErrForLineType returns character
     3861   (iObj            as handle,
     3862    iType           as character  ):
     3863      define variable vRecKey-line     as character no-undo.
     3864      define buffer buf_utd-err for utd-err.
     3865      define variable vUtdlineError as logical no-undo.
     3866      define variable vErrorOne as character no-undo.
     3867      define variable oError as character no-undo.
     3868            run gen-key-rec (input "utd-lines",
     3869                             input  iObj,
     3870                             output vRecKey-line).
     3871         define variable vdb-num as integer no-undo.
     3872         define variable vdoc-id as integer no-undo.
     3873         define variable vlinenum as integer no-undo.
     3874         vdb-num = iObj::db-num.
     3875         vdoc-id = iObj::doc-id.
     3876         vlinenum = iObj::linenum.
     3877         block-err:
     3878         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3879                                  and buf_utd-err.db-num = vdb-num
     3880                                  and buf_utd-err.reckey = vRecKey-line
     3881                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3882         no-lock:
     3883            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3884            if     vErrorOne ne ?
     3885               and vErrorOne ne ""
     3886            then do:
     3887               oError = oError + vErrorOne + " ".
     3888            end.
     3889         end.
     3890      return oError.
     3891   end.
     3892   function CheckErrForLineType returns logical
     3893   (iObj            as handle,
     3894    iType           as character  ):
     3895       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3896   end.
     3897   function CheckErrForLine returns logical
     3898   (iObj            as handle):
     3899      return CheckErrForLineType(iobj,"*").
     3900   end.
     3901   function CheckErrForUtd returns logical
     3902   (idb-num         as integer ,
     3903    idoc-id         as integer ):
     3904      for each utd-lines where utd-lines.db-num eq idb-num
     3905                           and utd-lines.doc-id eq idoc-id
     3906      no-lock :
     3907         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3908         then
     3909            return no.
     3910      end.
     3911      return yes.
     3912   end.
     3913   function CheckMarkUtd-28rel return logical
     3914    (input idb-num as integer,
     3915    input idoc-id as integer):
     3916    define buffer utd                   for utd.
     3917    define buffer utd-lines             for utd-lines.
     3918    define buffer utd-marking-lines     for utd-marking-lines.
     3919    define variable v-par-type as character no-undo.
     3920    define variable vgdsNoMark as logical no-undo.
     3921    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3922      define variable v-par-val  as character no-undo.
     3923      find first utd where utd.db-num eq idb-num
     3924                       and utd.doc-id eq idoc-id
     3925      no-lock no-error.
     3926      if available utd
     3927      then do:
     3928         if     utd.obj-code ne ?
     3929            and utd.obj-type ne ?
     3930         then do:
     3931            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3932            Block-utd-lines:
     3933            for each utd-lines where utd-lines.db-num eq idb-num
     3934                                 and utd-lines.doc-id eq idoc-id
     3935            no-lock:
     3936               if     utd-lines.gds-code ne ?
     3937                  and utd-lines.gds-code ne 0
     3938               then do:
     3939                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3940                       ( utd-lines.gds-code,
     3941                         'mark-type':U,
     3942                          output v-par-val,
     3943                          output v-par-type
     3944                       ).
     3945                  if     EDOParSec:IsEdo
     3946                     and EDOParSec:GetIsEDOForType(v-par-val)
     3947                  then do:
     3948                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3949                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3950                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3951                                                    and length(utd-marking-lines.mark) > 13
     3952                     no-lock no-error.
     3953                     if     avail utd-marking-lines
     3954                        and not CheckErrForLine(buffer utd-lines:handle)
     3955                     then
     3956                        leave Block-utd-lines.
     3957                  end.
     3958                  else
     3959                     vgdsNoMark = yes.
     3960               end.
     3961            end.
     3962            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3963            if vgdsNoMark then return available utd-lines . else return yes .
     3964         end.
     3965      end.
     3966      return yes.
     3967   end.
     3968   function CheckMarkUtd return logical
     3969    (input idb-num  as integer,
     3970     input idoc-id  as integer):
     3971     define buffer utd-lines             for ub.utd-lines.
     3972     block-line:
     3973     for each utd-lines where utd-lines.db-num eq idb-num
     3974                          and utd-lines.doc-id eq idoc-id
     3975     no-lock:
     3976        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3977        then
     3978           leave block-line.
     3979     end.
     3980     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3981     return available utd-lines.
     3982   end.
     3983   function CheckNotMarkUtd return logical
     3984    (input idb-num  as integer,
     3985     input idoc-id  as integer):
     3986     define buffer utd-lines             for ub.utd-lines.
     3987     for each utd-lines where utd-lines.db-num eq idb-num
     3988                          and utd-lines.doc-id eq idoc-id
     3989     no-lock:
     3990        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3991        then
     3992           return yes.
     3993     end.
     3994     return no.
     3995   end.
     3996   function CheckMarkUtdLine return logical
     3997    (input idb-num  as integer,
     3998     input idoc-id  as integer,
     3999     input iLineNum as integer):
     4000    define buffer utd                   for utd.
     4001    define buffer utd-lines             for utd-lines.
     4002    define buffer utd-marking-lines     for utd-marking-lines.
     4003    define variable v-par-type as character no-undo.
     4004    define variable vMarking        as logical no-undo.
     4005    define variable vArtic          as logical no-undo.
     4006    define variable vTransitional   as logical no-undo.
     4007    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4008      define variable v-par-val  as character no-undo.
     4009      find first utd where utd.db-num eq idb-num
     4010                       and utd.doc-id eq idoc-id
     4011      no-lock no-error.
     4012      if available utd
     4013      then do:
     4014         if     utd.obj-code ne ?
     4015            and utd.obj-type ne ?
     4016         then do:
     4017            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     4018            Block-utd-lines:
     4019            for each utd-lines where utd-lines.db-num   eq idb-num
     4020                                 and utd-lines.doc-id   eq idoc-id
     4021                                 and utd-lines.LineNum  eq iLineNum
     4022            no-lock:
     4023               if     utd-lines.gds-code ne ?
     4024                  and utd-lines.gds-code ne 0
     4025               then do:
     4026                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4027                       ( utd-lines.gds-code,
     4028                         'mark-type':U,
     4029                          output v-par-val,
     4030                          output v-par-type
     4031                       ).
     4032                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     4033                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     4034                  if vMarking
     4035                  then do:
     4036                     block-marking:
     4037                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     4038                                                    and utd-marking-lines.doc-id   eq idoc-id
     4039                                                    and utd-marking-lines.LineNum  eq iLineNum
     4040                                                    and length(utd-marking-lines.mark) > 13
     4041                     no-lock:
     4042                        if isOAD(utd-marking-lines.mark)
     4043                        then do:
     4044                           assign
     4045                              vArtic   = yes
     4046                              vMarking = no
     4047                           .
     4048                           leave block-marking.
     4049                        end.
     4050                     end.
     4051                  end.
     4052                  if vArtic
     4053                  then do:
     4054                     block-artic:
     4055                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     4056                                                    and utd-marking-lines.doc-id   eq idoc-id
     4057                                                    and utd-marking-lines.LineNum  eq iLineNum
     4058                                                    and length(utd-marking-lines.mark) > 13
     4059                     no-lock:
     4060                        if isMark(utd-marking-lines.mark)
     4061                        then do:
     4062                           assign
     4063                              vArtic   = no
     4064                              vMarking = yes
     4065                           .
     4066                           leave block-artic.
     4067                        end.
     4068                     end.
     4069                  end.
     4070                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     4071                  if vTransitional
     4072                  then do:
     4073                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     4074                                                    and utd-marking-lines.doc-id   eq idoc-id
     4075                                                    and utd-marking-lines.LineNum  eq iLineNum
     4076                                                    and length(utd-marking-lines.mark) > 13
     4077                     no-lock no-error.
     4078                     if not available utd-marking-lines
     4079                     then assign
     4080                        vMarking = no
     4081                        vArtic   = no
     4082                     .
     4083                  end.
     4084               end.
     4085               else
     4086                  assign
     4087                     vMarking      = yes
     4088                     vArtic        = no
     4089                     vTransitional = no
     4090                  .
     4091               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     4092               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     4093               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     4094            end.
     4095         end.
     4096      end.
     4097      return vMarking or vArtic.
     4098   end.
     4099   function getMarkUtdLine return logical
     4100    (input  idb-num  as integer,
     4101     input  idoc-id  as integer,
     4102     input  iLineNum as integer,
     4103     output oMarking        as logical,
     4104     output oArtic          as logical,
     4105     output oTransitional   as logical):
     4106     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     4107     oArtic        = not oMarking
     4108            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     4109     oTransitional = (oMarking or oArtic)
     4110            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     4111   end.
     4112   function CheckMarking return logical
     4113    (input idb-num as integer,
     4114    input idoc-id as integer,
     4115    input iTypeErr as character ):
     4116     define variable vMarkutd as logical no-undo.
     4117     define variable vCrErr   as logical no-undo.
     4118     define buffer utd-lines         for utd-lines.
     4119     define buffer utd-marking-lines for utd-marking-lines.
     4120     define buffer marking           for marking.
     4121     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     4122      block-line:
     4123      for each utd-lines where utd-lines.db-num eq idb-num
     4124                           and utd-lines.doc-id eq idoc-id
     4125      no-lock:
     4126         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     4127         then do:
     4128            for each utd-marking-lines
     4129                     where utd-marking-lines.db-num  = utd-lines.db-num
     4130                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     4131                       and utd-marking-lines.LineNum = utd-lines.LineNum
     4132            no-lock:
     4133               if isMark(utd-marking-lines.mark)
     4134               then do:
     4135                  find first marking where marking.mark eq utd-marking-lines.mark
     4136                  no-lock no-error.
     4137                  if not available marking
     4138                  then do:
     4139                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     4140                     vCrErr = yes.
     4141                     next block-line.
     4142                  end.
     4143               end.
     4144            end.
     4145         end.
     4146      end.
     4147      return vCrErr.
     4148   end.
     4149   function CheckMarkForType return logical
     4150    (input idb-num   as integer,
     4151     input idoc-id   as integer):
     4152      define variable vMarking        as logical no-undo.
     4153      define variable vArtic          as logical no-undo.
     4154      define variable vTransitional   as logical no-undo.
     4155      define buffer utd-lines         for utd-lines.
     4156      define buffer utd-marking-lines for utd-marking-lines.
     4157      block-line:
     4158      for each utd-lines where utd-lines.db-num eq idb-num
     4159                           and utd-lines.doc-id eq idoc-id
     4160      no-lock:
     4161         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     4162                          output vMarking         , output vArtic          , output vTransitional).
     4163         for each utd-marking-lines
     4164                     where utd-marking-lines.db-num  = utd-lines.db-num
     4165                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     4166                       and utd-marking-lines.LineNum = utd-lines.LineNum
     4167         no-lock:
     4168            if length(utd-marking-lines.mark) < 14
     4169            then do:
     4170               if (vMarking or vArtic) and not vTransitional
     4171               then
     4172                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     4173            end.
     4174            else if not isMark(utd-marking-lines.mark)
     4175            then do:
     4176               if vMarking
     4177               then
     4178                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     4179            end.
     4180            else do:
     4181            end.
     4182         end.
     4183      end.
     4184   end.
     4185   function WeighedProd return logical
     4186      ( input p-gds-code as integer) :
     4187      define variable v-par-val  as character no-undo.
     4188      define variable v-par-type as character no-undo.
     4189              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4190               ( p-gds-code,
     4191                 'weighed-gds':U,
     4192                  output v-par-val,
     4193                  output v-par-type
     4194               ).
