     1540   procedure xmlchar-test :
     1541   define input parameter p-in-string          as character        no-undo.
     1542   define output parameter p-out-string-enc    as character        no-undo.
     1543   define output parameter p-out-string-dec    as character        no-undo.
     1544   do
     1545   on error undo, return error
     1546   :
     1547          run xmlchar-encode in this-procedure
     1548       (
     1549             input p-in-string
     1550           , output p-out-string-enc
     1551       ).
     1552          run xmlchar-decode in this-procedure
     1553       (
     1554             input p-out-string-enc
     1555           , output p-out-string-dec
     1556       ).
     1557   end.
     1558   end .
     1559   procedure xmlchar-encode :
     1560   define input parameter p-in-string      as character        no-undo.
     1561   define output parameter p-out-string    as character        no-undo.
     1562       define variable v-position      as integer      no-undo.
     1563       define variable v-current-char  as character    no-undo.
     1564   do
     1565   on error undo, return error
     1566   :
     1567       assign
     1568           p-out-string = "":U
     1569       .
     1570       case p-in-string
     1571       :
     1572           when ?
     1573           then do:
     1574               assign
     1575                   p-out-string = "?":U
     1576               .
     1577           end.
     1578           when "?":U
     1579           then do:
     1580               assign
     1581                   p-out-string = "&#63;":U
     1582               .
     1583           end.
     1584           otherwise do:
     1585               do v-position = 1 to length( p-in-string )
     1586               :
     1587                   assign
     1588                       v-current-char = substring( p-in-string, v-position, 1 )
     1589                   .
     1590                   case v-current-char
     1591                   :
     1592                       when "&":U
     1593                       then do:
     1594                           assign
     1595                               p-out-string = p-out-string + "&amp;":U
     1596                           .
     1597                       end.
     1598                       when ">":U
     1599                       then do:
     1600                           assign
     1601                               p-out-string = p-out-string + "&gt;":U
     1602                           .
     1603                       end.
     1604                       when "<":U
     1605                       then do:
     1606                           assign
     1607                               p-out-string = p-out-string + "&lt;":U
     1608                           .
     1609                       end.
     1610                       when "'":U
     1611                       then do:
     1612                           assign
     1613                               p-out-string = p-out-string + "&apos;":U
     1614                           .
     1615                       end.
     1616                       when '"':U
     1617                       then do:
     1618                           assign
     1619                               p-out-string = p-out-string + "&quot;":U
     1620                           .
     1621                       end.
     1622                       when chr(1)
     1623                       then do:
     1624                           assign
     1625                               p-out-string = p-out-string + "":U
     1626                           .
     1627                       end.
     1628                       when chr(2)
     1629                       then do:
     1630                           assign
     1631                               p-out-string = p-out-string + "":U
     1632                           .
     1633                       end.
     1634                       when chr(3)
     1635                       then do:
     1636                           assign
     1637                               p-out-string = p-out-string + "":U
     1638                           .
     1639                       end.
     1640                       when chr(4)
     1641                       then do:
     1642                           assign
     1643                               p-out-string = p-out-string + "":U
     1644                           .
     1645                       end.
     1646                       when chr(5)
     1647                       then do:
     1648                           assign
     1649                               p-out-string = p-out-string + "":U
     1650                           .
     1651                       end.
     1652                       when chr(6)
     1653                       then do:
     1654                           assign
     1655                               p-out-string = p-out-string + "":U
     1656                           .
     1657                       end.
     1658                       when chr(7)
     1659                       then do:
     1660                           assign
     1661                               p-out-string = p-out-string + "":U
     1662                           .
     1663                       end.
     1664                       when chr(8)
     1665                       then do:
     1666                           assign
     1667                               p-out-string = p-out-string + "":U
     1668                           .
     1669                       end.
     1670                       when chr(9)
     1671                       then do:
     1672                           assign
     1673                               p-out-string = p-out-string + "":U
     1674                           .
     1675                       end.
     1676                       when chr(29)
     1677                       then do:
     1678                           assign
     1679                               p-out-string = p-out-string + "":U
     1680                           .
     1681                       end.
     1682                       when chr(10)
     1683                       then do:
     1684                           assign
     1685                               p-out-string = p-out-string + "&#10;":U
     1686                           .
     1687                       end.
     1688                       when chr(13)
     1689                       then do:
     1690                           assign
     1691                               p-out-string = p-out-string + "&#13;":U
     1692                           .
     1693                       end.
     1694                       otherwise do:
     1695                           assign
     1696                               p-out-string = p-out-string + v-current-char
     1697                           .
     1698                       end.
     1699                   end case.
     1700               end.
     1701           end.
     1702       end case.
     1703   end.
     1704   end .
     1705   procedure xmlchar-encode-1c :
