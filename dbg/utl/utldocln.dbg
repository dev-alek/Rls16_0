      629                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      630                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      631                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      632                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      633                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      634                         .
      635         end.
      636         ASSIGN
      637           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      638           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      639           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      640           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      641           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      642           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      643                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
      644           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
      645                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
      646           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
      647           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
      648           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
      649         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
      650         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
      651         if transport-base-loc = ? then transport-base-loc = 0.
      652         if transport-rubl-loc = ? then transport-rubl-loc = 0.
      653         if other-base-loc     = ? then other-base-loc     = 0.
      654         if other-rubl-loc     = ? then other-rubl-loc     = 0.
      655         assign
      656           transport-cli-loc      = 0
      657           other-cli-loc          = 0
      658           road-tax-cli-loc       = ?
      659           vat-cli-loc            = ?
      660           slt-cli-loc            = ?
      661           price-cli-with-tax-loc = ?.
      662      end.
      663   ASSIGN
      664             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      665       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      666   .
      667       message
      668         "НДС поставщика изменен." skip
      669         "Новый процент НДС" buf_doc-line.VAT-pc  skip
      670         "Новая сумма НДС в БВ"  vat-base-loc * buf_doc-line.fact-qnty skip
      671         "Новая сумма НДС в руб" vat-rubl-loc * buf_doc-line.fact-qnty skip
      672         "После изменения НДС в документах необходимо запустить утилиту" skip
      673         "Выполнить отложенные задания (BatchProcess), run-btpr.p" skip
      674         view-as alert-box information .
      675     end.
      676   end procedure.
      677   procedure change-cst-code :
      678     define buffer buf_parts for ub.parts .
      679     define variable ind               as integer no-undo .
      680     define variable v-total-parts     as integer no-undo .
      681     define variable v-change-ind      as integer no-undo .
      682     define variable v-parts-cst-code  like buf_parts.cst-code no-undo .
      683     define variable v-cst-code-format as character no-undo .
      684     do
      685     on error undo, return error
      686     :
      687       run gbl/fldfrmt.p
      688         (input  "parts":U
      689         ,input  "cst-code":U
      690         ,output v-cst-code-format
      691         ) .
      692       find first trn-doc exclusive-lock
      693         where trn-doc.doc-code = buf_doc-line.doc-code
      694         .
      695       for each buf_parts no-lock
      696         where buf_parts.out-code  = buf_doc-line.doc-code
      697           and buf_parts.obj-type  = buf_doc-line.obj-type
      698           and buf_parts.obj-code  = buf_doc-line.obj-code
      699           and buf_parts.artic     = buf_doc-line.artic
      700           and buf_parts.prod-type = buf_doc-line.prod-type
      701           and buf_parts.prod-code = buf_doc-line.prod-code
      702       :
      703         assign
      704           v-total-parts = v-total-parts + 1
      705         .
      706       end.
      707       if v-total-parts = 0
      708       then do:
      709         message
      710           "В строке документа отсутствуют партии"
      711           "Документ" buf_doc-line.doc-code skip
      712           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      713           view-as alert-box information .
      714         return .
      715       end.
      716       for each buf_parts no-lock
      717         where buf_parts.out-code  = buf_doc-line.doc-code
      718           and buf_parts.obj-type  = buf_doc-line.obj-type
      719           and buf_parts.obj-code  = buf_doc-line.obj-code
      720           and buf_parts.artic     = buf_doc-line.artic
      721           and buf_parts.prod-type = buf_doc-line.prod-type
      722           and buf_parts.prod-code = buf_doc-line.prod-code
      723       :
      724         assign
      725           ind              = ind + 1
      726           v-parts-cst-code = buf_parts.cst-code
      727         .
      728         run gbl/d-prompt.w
      729           ( 'title=':U + "Введите новый ГТД" + '\':U
      730           + 'text1=':U + "Партия " + str-encode(buf_parts.in-code, "", '\=':U )
      731             + chr(32) + str-encode(buf_parts.part-code, "", '\=':U )
      732             + chr(32) + string(ind) + " из " + string(v-total-parts) + '\':U
      733           + 'text2=' + "Артикул " + str-encode(buf_parts.artic, "", '\=':U )
      734             + chr(32) + string(buf_parts.prod-type)
      735             + chr(32) + string(buf_parts.prod-code) + '\':U
      736           + 'format=' + v-cst-code-format + '\':U
      737           + 'type=character':U
      738           ,input-output v-parts-cst-code
      739           ).
      740         if return-value = 'false':U
      741         then do:
      742           return .
      743         end.
      744         if v-parts-cst-code <> buf_parts.cst-code
      745         then do:
      746           assign
      747             v-change-ind = v-change-ind + 1
      748           .
      749         end.
      750         run trg/partcst.p
      751           (input v-parts-cst-code
      752           ,input buf_parts.in-code
      753           ,input buf_parts.artic
      754           ,input buf_parts.prod-type
      755           ,input buf_parts.prod-code
      756           ,input buf_parts.part-code
      757           ) no-error .
      758         if error-status :error
      759         then do:
      760           message
      761             vss-workfile vss-revision vss-description skip
      762             "Ошибка при вызове процедуры partcst.p" skip
      763             error-status :get-message(1) skip
      764             return-value skip
      765             view-as alert-box error .
      766           undo, return error .
      767         end.
      768       end.
      769       message
      770         "Изменение ГТД завершено" skip
      771         "Изменено" v-change-ind "партий из" v-total-parts skip
      772         ""  ( if  l-single-db <> true
      773               and v-change-ind <> 0
      774               then "Внимание! Существуют удалённые базы данных." + chr(10)
      775                  + "ГТД будет изменено только в текущей базе данных." + chr(10)
      776               else ""
      777             ) skip
      778         view-as alert-box information .
      779     end.
      780   end procedure.
      781   procedure change-last-date :
      782     define buffer buf_parts for ub.parts .
      783     define variable v-ind             as integer   no-undo .
      784     define variable v-change-ind      as integer   no-undo .
      785     define variable v-total-parts     as integer   no-undo .
      786     define variable v-parts-last-date as character no-undo .
      787     do
      788     on error undo, return error return-value
      789     :
      790       find first trn-doc exclusive-lock
      791         where trn-doc.doc-code = buf_doc-line.doc-code
      792         .
      793       for each buf_parts no-lock
      794         where buf_parts.out-code  = buf_doc-line.doc-code
      795           and buf_parts.obj-type  = buf_doc-line.obj-type
      796           and buf_parts.obj-code  = buf_doc-line.obj-code
      797           and buf_parts.artic     = buf_doc-line.artic
      798           and buf_parts.prod-type = buf_doc-line.prod-type
      799           and buf_parts.prod-code = buf_doc-line.prod-code
      800       :
      801         assign
      802           v-total-parts = v-total-parts + 1
      803         .
      804       end.
      805       if v-total-parts = 0
      806       then do:
      807         message
      808           "В строке документа отсутствуют партии"
      809           "Документ" buf_doc-line.doc-code skip
      810           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      811           view-as alert-box information .
      812         return .
      813       end.
      814       for each buf_parts no-lock
      815         where buf_parts.out-code  = buf_doc-line.doc-code
      816           and buf_parts.obj-type  = buf_doc-line.obj-type
      817           and buf_parts.obj-code  = buf_doc-line.obj-code
      818           and buf_parts.artic     = buf_doc-line.artic
      819           and buf_parts.prod-type = buf_doc-line.prod-type
      820           and buf_parts.prod-code = buf_doc-line.prod-code
      821       :
      822         assign
      823           v-ind             = v-ind + 1
      824           v-parts-last-date = string(buf_parts.last-date, '99/99/9999':u)
      825         .
      826         run gbl/d-prompt.w
      827           ( 'title=':U + "Введите срок годности" + '\':U
      828           + 'text1=':U + "Партия " + str-encode(buf_parts.in-code, "", '\=':U )
      829             + chr(32) + str-encode(buf_parts.part-code, "", '\=':U )
      830             + chr(32) + string(v-ind) + " из " + string(v-total-parts) + '\':U
      831           + 'text2=' + "Артикул " + str-encode(buf_parts.artic, "", '\=':U )
      832             + chr(32) + string(buf_parts.prod-type)
      833             + chr(32) + string(buf_parts.prod-code) + '\':U
      834           + 'format=99/99/9999\':U
      835           + 'type=date':U
      836           ,input-output v-parts-last-date
      837           ).
      838         if return-value = 'false':U
      839         then do:
      840           return .
      841         end.
      842         if v-parts-last-date <> string(buf_parts.cst-code)
      843         then do:
      844           assign
      845             v-change-ind = v-change-ind + 1
      846           .
      847         end.
      848         define variable v-gds-code as integer   no-undo .
      849   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      851     (input  buf_doc-line.artic
      852     ,input  buf_doc-line.prod-type
      853     ,input  buf_doc-line.prod-code
      854     ,output v-gds-code
      855     )  .
      856         run trg/partlast.p
      857           (input  buf_parts.in-code
      858           ,input  v-gds-code
      859           ,input  buf_parts.part-code
      860           ,input  date(v-parts-last-date)
      861           ) no-error .
      862         if error-status :error
      863         then do:
      864           message
      865             vss-workfile vss-revision vss-description skip
      866             "Ошибка при вызове процедуры partlast.p" skip
      867             error-status :get-message(1) skip
      868             return-value skip
      869             view-as alert-box error .
      870           undo, return error .
      871         end.
      872       end.
      873       message
      874         "Изменение срока годности завершено" skip
      875         "Изменено" v-change-ind "партий из" v-total-parts skip
      876         ""  ( if  l-single-db <> true
      877               and v-change-ind <> 0
      878               then "Внимание! Существуют удалённые базы данных." + chr(10)
      879                  + "Срок годности будет изменено только в данной базе данных." + chr(10)
      880               else ""
      881             ) skip
      882         view-as alert-box information .
      883     end.
      884   end procedure.
      885   procedure change-alc-attr :
      886     define variable v-part-recid as recid no-undo.
      887     define buffer buf_goods for ub.goods.
      888     do on error undo, return :
      889       find first buf_goods no-lock
      890         where buf_goods.artic     = buf_doc-line.artic
      891           and buf_goods.prod-type = buf_doc-line.prod-type
      892           and buf_goods.prod-code = buf_doc-line.prod-code
      893         .
      894       run str/parts-l.w
      895         (input parparentproc
      896         ,input buf_doc-line.obj-type
      897         ,input buf_doc-line.obj-code
      898         ,input buf_goods.gds-code
      899         ,input buf_doc-line.doc-code
      900         ,input 'update-alc-attr':u
      901         ,input 'документ':U
      902         ,input 'текущий':U
      903         ,input 'документ':U
      904         ,output v-part-recid
      905         ) no-error.
      906       if error-status :error
      907       then do:
      908         message
      909           vss-workfile vss-revision vss-description skip
      910           "Ошибка при вызове процедуры parts-l.w" skip
      911           error-status :get-message(1) skip
      912           return-value skip
      913           view-as alert-box error .
      914         undo, return error .
      915       end.
      916     end.
      917   end procedure.
      918   procedure check-single-db :
      919     define output parameter p-single-db as logical no-undo .
      920     do
      921     on error undo, return error
      922     :
      923       assign
      924         p-single-db = true
      925       .
      926       find first ub.db no-lock
      927         where ub.db.db-num <> 0
      928         no-error .
      929       if available ub.db
      930       then do:
      931         assign
      932           p-single-db = false
      933         .
      934       end.
      935     end.
      936   end procedure.
