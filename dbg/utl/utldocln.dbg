      503         s-doc-line-VAT-pc = string(decimal(s-vat-rubl)
      504                                   / ( buf_doc-line.fact-qnty
      505                                       *
      506                                       (price-rubl-without-tax-loc + vat-rubl-loc )
      507                                       - decimal(s-vat-rubl)
      508                                     )
      509                                     * 100
      510                                 )
      511       .
