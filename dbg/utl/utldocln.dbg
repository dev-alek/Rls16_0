        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle    no-undo .
        3   define parameter buffer buf_doc-line for ub.doc-line .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: utldocln.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/utldocln.p $":U .
        9   define variable vss-description as character no-undo init "Утилита изменения параметров строки документа, закрытого по факту".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   function octal-to-char return character
       70   ( p-string as character ) :
       71     def var v-asc     as integer no-undo .
       72     def var v-new-asc as integer no-undo .
       73     def var ind       as integer no-undo .
       74     if length(p-string) <> 3 then do:
       75       return ? .
       76     end.
       77     assign
       78       v-asc = 0
       79     .
       80     do ind = 1 to length(p-string)
       81     :
       82       assign
       83         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
       84       .
       85       if v-new-asc < 0 or v-new-asc >= 8 then do:
       86         return ? .
       87       end.
       88       assign
       89         v-asc = v-asc * 8 + v-new-asc
       90       .
       91     end.
       92     return chr(v-asc) .
       93   end function .
       94   function char-to-octal return character
       95   ( p-chr as character ) :
       96     def var v-asc    as integer   no-undo .
       97     def var ind      as integer   no-undo .
       98     def var v-string as character no-undo .
       99     if length(p-chr) <> 1 then do:
      100       return ? .
      101     end.
      102     assign
      103       v-asc    = asc(p-chr)
      104       v-string = ""
      105     .
      106     do ind = 1 to 3
      107     :
      108       assign
      109         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      110       .
      111       assign
      112         v-asc = truncate(v-asc / 8, 0)
      113       .
      114     end.
      115     return v-string .
      116   end.
      117   function str-encode return character
      118   (   p-init-string       as character
      119     , p-encode-char       as character
      120     , p-special-char-list as character
      121   ) :
      122     def var p-encode-string as character no-undo .
      123     def var ind                as integer no-undo .
      124     def var v-num-special-char as integer no-undo .
      125     def var v-special-char     as character no-undo .
      126     if p-encode-char = ?
      127     or p-encode-char = "" then do:
      128       assign
      129         p-encode-char = "~~"
      130       .
      131     end.
      132     if p-init-string = ? then do:
      133       return "?" .
      134     end.
      135     if p-init-string = "?" then do:
      136       return p-encode-char + char-to-octal("?") .
      137     end.
      138     assign
      139       v-num-special-char = length(p-special-char-list)
      140       p-encode-string    = replace(p-init-string
      141                                   ,p-encode-char
      142                                   ,p-encode-char + char-to-octal(p-encode-char)
      143                                   )
      144     .
      145     do ind = 1 to v-num-special-char
      146     :
      147       assign
      148         v-special-char = substring(p-special-char-list, ind, 1)
      149       .
      150       if v-special-char <> p-encode-char then do:
      151         assign
      152           p-encode-string = replace (p-encode-string
      153                                     ,v-special-char
      154                                     ,p-encode-char + char-to-octal(v-special-char)
      155                                     )
      156         .
      157       end.
      158     end.
      159     return p-encode-string .
      160   end.
      161   function str-decode returns character
      162     (p-init-string   as character
      163     ,p-encode-char   as character
      164     ) :
      165     def var p-decode-string as character no-undo .
      166     def var ind                       as integer no-undo .
      167     def var v-num-entries-init-string as integer no-undo .
      168     def var v-sub-phrase              as character no-undo .
      169     def var v-special-char            as character no-undo .
      170     if p-encode-char = ?
      171     or p-encode-char = "" then do:
      172       assign
      173         p-encode-char = "~~"
      174       .
      175     end.
      176     if p-init-string = "?" then do:
      177       return ? .
      178     end.
      179     assign
      180       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      181     .
      182     if v-num-entries-init-string > 1 then do:
      183       assign
      184         p-decode-string = entry(1, p-init-string, p-encode-char)
      185       .
      186       do ind = 2 to v-num-entries-init-string
      187       :
      188         assign
      189           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      190         .
      191         assign
      192           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      193         .
      194         if v-special-char <> ? then do:
      195           assign
      196             p-decode-string = p-decode-string
      197                             + v-special-char
      198                             + substring(v-sub-phrase, 4)
      199           .
      200         end.
      201         else do:
      202           assign
      203             p-decode-string = p-decode-string
      204                             + p-encode-char
      205                             + v-sub-phrase
      206           .
      207         end.
      208       end.
      209     end.
      210     else do:
      211       assign
      212         p-decode-string = p-init-string
      213       .
      214     end.
      215     return p-decode-string .
      216   end.
      217   define new global shared variable g#library  as handle no-undo .
      218   define new global shared variable g#library2 as handle no-undo .
      219   define variable l-single-db     as logical no-undo .
      220   define variable v-alcohol-prod  as logical no-undo.
      221   define variable v-alcohol-value as character no-undo.
      222   define variable v-alcohol-type  as character no-undo.
      223   run check-single-db in this-procedure
      224     (output l-single-db
      225     ).
      226   if not available buf_doc-line
      227   then do:
      228     message
      229       vss-workfile vss-revision vss-description skip
      230       "Не задана строка документа."
      231       view-as alert-box error .
      232     undo, return error .
      233   end.
      234   v-alcohol-prod = no.
      235   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      236     (input  'alcohol':u
      237     ,input  0
      238     ,input  ''
      239     ,input  0
      240     ,input  ''
      241     ,input  ''
      242     ,input  ''
      243     ,input  no
      244     ,output v-alcohol-value
      245     ,output v-alcohol-type
      246     ) no-error .
      247   if (not error-status:error) and lookup(v-alcohol-value, 'true,yes':u) > 0 then do:
      248   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      249   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      250     (input  buf_doc-line.artic
      251     ,input  buf_doc-line.prod-type
      252     ,input  buf_doc-line.prod-code
      253     ,input  'alcohol-prod=request':u
      254     ,output v-alcohol-prod
      255     )  .
      256   end.
      257   def var v-num as integer no-undo .
      258   do on error undo, return return-value :
      259     run str/d-askpar.w (input  recid(buf_doc-line)
      260                    ,input  l-single-db
      261                    ,input  v-alcohol-prod
      262                    ,output v-num
      263                    ) no-error.
      264     if error-status :error
      265     then do:
      266       message
      267         vss-workfile vss-revision vss-description skip
      268         error-status :get-message(1) skip
      269         return-value skip
      270         view-as alert-box error .
      271       undo, return error .
      272     end.
      273   end.
      274   case v-num :
      275     when 0
      276     then do:
      277       return .
      278     end.
      279     when 1
      280     then do:
      281       run change-VAT-pc in this-procedure .
      282     end.
      283     when 2
      284     then do:
      285       run change-cst-code in this-procedure .
      286     end.
      287     when 3
      288     then do:
      289       run change-last-date in this-procedure .
      290     end.
      291     when 4
      292     then do:
      293       run change-alc-attr in this-procedure .
      294     end.
      295     otherwise do:
      296       message "Нет процедуры для редактирования выбранного атрибута" +
      297               substitute (" (параметр &1 )", v-num)
      298         view-as alert-box error.
      299       return.
      300     end.
      301   end.
      302   procedure change-VAT-pc :
      303     define buffer buf_trn-doc for ub.trn-doc .
      304     do
      305     on error undo, return error
      306     :
      307       find first buf_trn-doc no-lock
      308         where buf_trn-doc.doc-code = buf_doc-line.doc-code
      309         .
      310       if buf_trn-doc.VAT-type = 'без':U
      311       or buf_trn-doc.VAT-type = 'нет':U
      312       then do:
      313         message
      314           "Накладная" buf_trn-doc.doc-code skip
      315           "Приходная накладная имеет тип заведения НДС" buf_trn-doc.VAT-type skip
      316           "Для накладной такого типа заведения НДС нельзя менять процент НДС" skip
      317           view-as alert-box information .
      318         return .
      319       end.
      320       define variable v-doc-line-VAT-pc as decimal no-undo .
      321       assign
      322         v-doc-line-VAT-pc = buf_doc-line.VAT-pc
      323       .
      324       find first trn-doc exclusive-lock
      325         where trn-doc.doc-code = buf_doc-line.doc-code
      326         .
      327       if l-single-db <> true
      328       then do:
      329         message
      330           "Существуют удаленные базы данных" skip
      331           "Изменение НДС поставщика невозможно" skip
      332           view-as alert-box information .
      333         return .
      334       end.
      335       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      336       define buffer   in-vatp-parts    for ub.parts   .
      337       define buffer   in-vatp-doc      for ub.trn-doc .
      338       define buffer   in-vatp-goods    for ub.goods   .
      339       define buffer   in-vatp-sysconf  for ub.sysconf .
      340       define buffer   in-vatp_doc-attr for ub.doc-attr.
      341       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      342       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      343       define variable varinvprb                  as   character              no-undo.
      344       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      345       define variable cli-base-rate              as   decimal                no-undo.
      346       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      347       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      348       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      349       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      350       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      351       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      352       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      353       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      354       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      355       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      356       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      357       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      358       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      359       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      360       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      361       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      362       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      363       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      364       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      365       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      366       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      367       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      368       define variable varinvatp-envd             as   character              no-undo.
      369       define variable varinvatp-type             as   character              no-undo.
      370   assign
      371     price-rubl-with-tax-loc = buf_doc-line.price-rubl
      372     price-base-with-tax-loc = buf_doc-line.price-base
      373   .
      374   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      376     (output varinvprb
      377     )  .
      378      find first in-vatp_doc-attr no-lock
      379       where in-vatp_doc-attr.doc-code  = trn-doc.doc-code
      380         and in-vatp_doc-attr.attr-code = 'envd':U
      381       no-error .
      382       if available in-vatp_doc-attr
      383          then do:
      384          assign
      385            in-vatp-have-vat-slt = no.
      386      end.
      387      else do:
      388        assign
      389          in-vatp-have-vat-slt = yes.
      390      end.
      391      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
      392                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
      393                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
      394      if (not trn-doc.internal and
      395              trn-doc.doc-type = 'при':U) or
      396         in-vatp-goods.gds-type = 'у':U then do:
      397         if varinvprb = "base":u then do:
      398           assign
      399             road-tax-base-loc = buf_doc-line.road-tax
      400             road-tax-rubl-loc = buf_doc-line.road-tax * trn-doc.base-rate / trn-doc.base-scale.
      401         end.
      402         else do:
      403           ASSIGN
      404             road-tax-rubl-loc = buf_doc-line.road-tax
      405             road-tax-base-loc = buf_doc-line.road-tax / trn-doc.base-rate * trn-doc.base-scale.
      406         end.
      407         if road-tax-base-loc = ? then road-tax-base-loc = 0.
      408         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
      409         assign
      410           road-tax-cli-loc = ?.
      411         ASSIGN
      412           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
      413           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
      414           transport-cli-loc  = 0
      415           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
      416           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
      417           other-cli-loc      = 0
      418           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
      419           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
      420                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      421               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      422         assign
      423           vat-cli-loc            = ?
      424           slt-cli-loc            = ?
      425           price-cli-with-tax-loc = ?.
      426      end.
      427      else do:
      428                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
      429                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
      430                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
      431                                         in-vatp-parts.artic     = buf_doc-line.artic     and
      432                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
      433                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
      434                            use-index out-code no-lock:
      435             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
      436                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
      437                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
      438                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
      439                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
      440                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
      441                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      442                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
