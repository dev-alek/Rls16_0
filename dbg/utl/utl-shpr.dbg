        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: utl-shpr.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/utl-shpr.p $":U .
        7   define variable vss-description as character no-undo init "Утилита пересчета  переоценок на сменном объекте после обрезания.".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure factord :
       70     define input  parameter p-fact-date            as date    no-undo .
       71     define input  parameter p-fact-time            as integer no-undo .
       72     define input  parameter p-fact-num             as integer no-undo .
       73     define input  parameter p-shift-date           as date    no-undo .
       74     define input  parameter p-shift-num            as integer no-undo .
       75     define input  parameter p-shift-on             as logical no-undo .
       76     define output parameter p-fact-order           as decimal no-undo .
       77     define output parameter p-shift-end-fact-order as decimal no-undo .
       78     define output parameter p-day-end-fact-order   as decimal no-undo .
       79     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       80     if p-fact-date = ?
       81     then do:
       82       return error "Не указана фактическая дата" .
       83     end.
       84     define variable v-fact-date-num as integer no-undo .
       85     assign
       86       v-fact-date-num = integer(p-fact-date)
       87     .
       88     if p-fact-num = ?
       89     or p-fact-num = 0
       90     then do:
       91       return error "Не задан p-fact-num " + string(p-fact-num) .
       92     end.
       93     if p-fact-num < 0
       94     then do:
       95       return error "Отрицательный fact-num " + string(p-fact-num) .
       96     end.
       97     if p-fact-num >= 100000000
       98     then do:
       99       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      100     end.
      101     if p-shift-on = true
      102     then do:
      103       if p-shift-date = ?
      104       then do:
      105         return error "Не задана дата смены" .
      106       end.
      107       if p-shift-num = ?
      108       or p-shift-num = 0
      109       then do:
      110         return error "Не задан номер смены" .
      111       end.
      112     end.
      113     else do:
      114       assign
      115         p-shift-date = p-fact-date
      116         p-shift-num  = 24
      117       .
      118     end.
      119     define variable v-shift-offset as integer no-undo .
      120     if p-shift-date = p-fact-date
      121     then do:
      122       assign
      123         v-shift-offset = 1
      124       .
      125     end.
      126     if p-shift-date < p-fact-date
      127     then do:
      128       assign
      129         v-shift-offset = 0
      130       .
      131     end.
      132     if p-shift-date > p-fact-date
      133     then do:
      134       message
      135         vss-workfile vss-revision vss-description skip
      136         "Неправильная дата закрытия смены" skip
      137         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      138         view-as alert-box error .
      139       undo, return error
      140         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      141           ,string(p-fact-date, '99/99/9999':U)
      142           ,string(p-shift-date, '99/99/9999':U)
      143           )
      144       .
      145     end.
      146     if p-shift-num < 1
      147     or p-shift-num > 24
      148     then do:
      149       message
      150         vss-workfile vss-revision vss-description skip
      151         "Неправильный номер смены" skip
      152         "p-shift-num" p-shift-num skip
      153         view-as alert-box error .
      154       undo, return error return-value .
      155     end.
      156     assign
      157       p-fact-order           = v-fact-date-num
      158                              + v-shift-offset * 0.5
      159                              + p-shift-num    * 0.02 - 0.01
      160                              + p-fact-num     * 0.0000000001
      161       p-shift-end-fact-order = v-fact-date-num
      162                              + v-shift-offset * 0.5
      163                              + p-shift-num    * 0.02
      164       p-day-end-fact-order   = v-fact-date-num
      165                              + 0.99
      166     .
      167     if p-fact-order           <= v-fact-date-num
      168     or p-shift-end-fact-order <= v-fact-date-num
      169     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      170     or p-shift-end-fact-order >= p-day-end-fact-order
      171     then do:
      172       message
      173         vss-workfile vss-revision vss-description skip
      174         "Внутренняя ошибка при генерации фактического номера" skip
      175         "p-fact-date"            p-fact-date            skip
      176         "p-fact-time"            p-fact-time            skip
      177         "p-fact-num"             p-fact-num             skip
      178         "p-shift-date"           p-shift-date           skip
      179         "p-shift-num"            p-shift-num            skip
      180         "p-shift-on"             p-shift-on             skip
      181         "p-shift-end-fact-order" p-shift-end-fact-order skip
      182         "p-day-end-fact-order"   p-day-end-fact-order   skip
      183         "v-fact-date-num"        v-fact-date-num        skip
      184         view-as alert-box error .
      185       undo, return error return-value .
      186     end.
      187   end procedure.
      188   procedure day-begin-fact-order :
      189     define input  parameter p-fact-date            as date    no-undo .
      190     define output parameter p-day-begin-fact-order as decimal no-undo .
      191     do
      192     on error undo, return error return-value
      193     :
      194       if p-fact-date = ?
      195       then do:
      196         assign
      197           p-day-begin-fact-order = 0
      198         .
      199       end.
      200       else do:
      201         assign
      202           p-day-begin-fact-order = integer(p-fact-date)
      203         .
      204       end.
      205     end.
      206   end procedure.
      207   procedure factord-max-fact-order :
      208     define output parameter p-max-fact-order as decimal   no-undo .
      209     do
      210     on error undo, return error return-value
      211     :
      212       run day-begin-fact-order in this-procedure
      213         (input  date(1, 1, 5000)
      214         ,output p-max-fact-order
      215         ) .
      216     end.
      217   end procedure.
      218   procedure factord-cut-archive :
      219     define input  parameter p-obj-type             as character no-undo .
      220     define input  parameter p-obj-code             as integer   no-undo .
      221     define input  parameter p-fact-date            as date      no-undo .
      222     define output parameter p-shift-on             as logical   no-undo .
      223     define output parameter p-shift-date           as date      no-undo .
      224     define output parameter p-shift-num            as integer   no-undo .
      225     define output parameter p-day-end-fact-order   as decimal   no-undo .
      226     define output parameter p-shift-end-fact-order as decimal   no-undo .
      227     define variable v-fact-order as decimal   no-undo .
      228     define buffer buf_shift-obj for ub.shift-obj .
      229     do
      230     on error undo, return error return-value
      231     :
      232   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      234     (input  p-obj-type
      235     ,input  p-obj-code
      236     ,input  'shift-on=request'
      237     ,output p-shift-on
      238     ) no-error .
      239       if error-status :error
      240       then do:
      241         message
      242           vss-workfile vss-revision vss-description skip
      243           "Ошибка при определении атрибута объекта" skip
      244           "Объект" p-obj-type p-obj-code skip
      245           error-status :get-message(1) skip
      246           return-value skip
      247           view-as alert-box error .
      248         undo, return error return-value .
      249       end.
      250       if p-shift-on = false
      251       then do:
      252         assign
      253           p-shift-date               = ?
      254           p-shift-num                = 0
      255         .
      256       end.
      257       else do:
      258         find first buf_shift-obj share-lock
      259           where buf_shift-obj.obj-type   = p-obj-type
      260             and buf_shift-obj.obj-code   = p-obj-code
      261             and buf_shift-obj.shift-date > p-fact-date
      262           use-index pi
      263           no-error .
      264         if not available buf_shift-obj
      265         or buf_shift-obj.status_ <> 'зкр':U
      266         then do:
      267           message
      268             vss-workfile vss-revision vss-description skip
      269             "Невозможно вычислить последнюю смену" skip
      270             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      271             "Объект" p-obj-type p-obj-code skip
      272             "Дата" p-fact-date skip
      273             view-as alert-box error .
      274           undo, return error return-value .
      275         end.
      276         find last buf_shift-obj share-lock
      277           where buf_shift-obj.obj-type = p-obj-type
      278             and buf_shift-obj.obj-code = p-obj-code
      279             and buf_shift-obj.shift-date <= p-fact-date
      280           use-index pi
      281           no-error .
      282         if available buf_shift-obj
      283         then do:
      284           if  buf_shift-obj.status_ = 'зкр':U
      285           then do:
      286             assign
      287               p-shift-date = buf_shift-obj.shift-date
      288               p-shift-num  = buf_shift-obj.shift-num
      289             .
      290           end.
      291           else do:
      292             message
      293               vss-workfile vss-revision vss-description skip
      294               "Невозможно вычислить последнюю смену" skip
      295               "Статус смены отличен от статуса" 'зкр':U skip
      296               "Объект" p-obj-type p-obj-code skip
      297               "Дата" p-fact-date skip
      298               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      299               view-as alert-box error .
      300             undo, return error return-value .
      301           end.
      302         end.
      303         else do:
      304           assign
      305             p-shift-date = p-fact-date - 1
      306             p-shift-num  = 1
      307           .
      308         end.
      309       end.
      310       run factord in this-procedure
      311         (input  p-fact-date
      312         ,input  1
      313         ,input  1
      314         ,input  p-shift-date
      315         ,input  p-shift-num
      316         ,input  p-shift-on
      317         ,output v-fact-order
      318         ,output p-shift-end-fact-order
      319         ,output p-day-end-fact-order
      320         ) no-error .
      321       if error-status :error
      322       then do:
      323         message
      324           vss-workfile vss-revision vss-description skip
      325           "Ошибка при вызове процедуры factord"
      326           error-status :get-message(1) skip
      327           return-value skip
      328           view-as alert-box error .
      329         undo, return error return-value .
      330       end.
      331     end.
      332   end procedure.
      333   procedure factord-lock-shift :
      334     define input  parameter p-obj-type  as character no-undo .
      335     define input  parameter p-obj-code  as integer   no-undo .
      336     define input  parameter p-fact-date as date      no-undo .
      337     define parameter buffer buf_shift-obj for ub.shift-obj .
      338     define variable v-shift-on      as logical   no-undo .
      339     define variable v-extra-message as character no-undo .
      340     define variable v-error as character no-undo .
      341     do
      342     on error undo, return error return-value
      343     :
      344   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      345   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      346     (input  p-obj-type
      347     ,input  p-obj-code
      348     ,input  'shift-on=request'
      349     ,output v-shift-on
      350     ) no-error .
      351       if error-status :error
      352       then do:
      353         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      354         undo, return error v-error .
      355       end.
      356       if v-shift-on = true
      357       then do:
      358         find first buf_shift-obj share-lock
      359           where buf_shift-obj.obj-type   = p-obj-type
      360             and buf_shift-obj.obj-code   = p-obj-code
      361             and buf_shift-obj.shift-date > p-fact-date
      362           use-index pi
      363           no-error .
      364         if not available buf_shift-obj
      365         or buf_shift-obj.status_ <> 'зкр':U
      366         then do:
      367           find last buf_shift-obj
      368             where buf_shift-obj.obj-type = p-obj-type
      369               and buf_shift-obj.obj-code = p-obj-code
      370               and buf_shift-obj.status_  = 'зкр':U
      371             use-index stts
      372             no-error .
      373           if available buf_shift-obj
      374           then do:
      375             assign
      376               v-extra-message =
      377                     substitute("Дата начала последеней закрытой смены на объекте &1"
      378                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      379                               )
      380             .
      381           end.
      382           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      383           undo, return error v-error .
      384         end.
      385       end.
      386     end.
      387   end procedure.
      388   procedure factord-end-day :
      389     define input  parameter p-fact-date            as date    no-undo .
      390     define output parameter p-day-end-fact-order   as decimal no-undo .
      391     do
      392     on error undo, return error return-value
      393     :
      394       if p-fact-date = ?
      395       then do:
      396         return error "Не указана фактическая дата" .
      397       end.
      398       assign
      399         p-day-end-fact-order = integer(p-fact-date) + 0.99
      400       .
      401     end.
      402   end procedure.
      403   procedure factord-to-date :
      404     define input  parameter p-fact-order as decimal no-undo .
      405     define output parameter p-fact-date  as date    no-undo .
      406     define variable v-ref-date  as date      no-undo .
      407     define variable v-ref-delta as integer   no-undo .
      408     do
      409     on error undo, return error return-value
      410     :
      411       if p-fact-order = ?
      412       or p-fact-order = 0
      413       then do:
      414         return error "Не указан fact-order" .
      415       end.
      416       assign
      417         v-ref-date  = date(1, 1, 2000)
      418       .
      419       assign
      420         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      421       .
      422       assign
      423         p-fact-date = v-ref-date + v-ref-delta
      424       .
      425     end.
      426   end procedure.
      427   procedure factord-to-fact-num :
      428     define input  parameter p-fact-order as decimal no-undo .
      429     define output parameter p-fact-num   as integer no-undo .
      430     define variable v-fact-order-trunc as decimal no-undo .
      431     do
      432     on error undo, return error return-value
      433     :
      434       if p-fact-order = ?
      435       or p-fact-order = 0
      436       then do:
      437         return error "Не указан fact-order" .
      438       end.
      439       assign
      440        v-fact-order-trunc = truncate(p-fact-order, 2)
      441       .
      442       assign
      443         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      444       .
      445     end.
      446   end procedure.
      447   procedure factord-to-shift-num :
      448     define input  parameter p-fact-order as decimal no-undo .
      449     define output parameter p-shift-num   as integer no-undo .
      450     define variable  p-shift-numd  as decimal   no-undo .
      451     define variable v-fact-order-trunc as decimal no-undo .
      452     do
      453     on error undo, return error return-value
      454     :
      455       if p-fact-order = ?
      456       or p-fact-order = 0
      457       then do:
      458         return error "Не указан fact-order" .
      459       end.
      460       assign
      461        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      462       .
      463       if v-fact-order-trunc < 0.5 then do:
      464         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      465       end.
      466       assign
      467         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      468         .
      469        assign
      470         p-shift-num = truncate (p-shift-numd , 0)
      471       .
      472     end.
      473   end procedure.
      474   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      475   define variable v-waitfram-action01         as character   no-undo .
      476   define variable v-waitfram-action02         as character   no-undo .
      477   define variable v-waitfram-action03         as character   no-undo .
      478   define variable mWaitFramTextBeg            as character   no-undo.
      479   define variable mWaitFramTextEnd            as character   no-undo.
      480   define variable mWaitFramView               as logical     no-undo.
      481   define variable mWaitProcEvent              as logical     no-undo init yes.
      482   define variable mWaitFramInterval           as integer     no-undo init 1 .
      483   define variable mWaitFramStop               as logical     no-undo.
      484   define variable mWaitFramStopUser           as logical     no-undo.
      485   define variable mWaitFramStopTimeOut        as logical     no-undo.
      486   define variable mWaitFramStartProc          as datetime-tz no-undo.
      487   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      488   define button B-WaitFramStop auto-end-key
      489        label "Стоп"
      490        size 10 by 1 tooltip "Остоновить процесс".
      491   define button B-viewProcInfo
      492        label "Информация"
      493        size 15 by 1 tooltip "Информация о процесс".
      494   define frame waitfram
      495     v-waitfram-action01 format "x(72)" no-label skip
      496     v-waitfram-action02 format "x(72)" no-label skip
      497     v-waitfram-action03 format "x(72)" no-label skip
      498     B-viewProcInfo
      499     B-WaitFramStop at row 4 col 30
      500     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      501     .
      502   define new global shared variable mBatchMode as logical no-undo init ?.
      503   define variable mFramBachModHandle as handle no-undo.
      504   mFramBachModHandle = frame waitfram:handle.
      505   define variable mFameOldVis as logical no-undo.
      506   define variable mVisCUrentVin as logical no-undo.
      507   if session:batch-mode
      508   then
      509      mBatchMode = yes.
      510   if mBatchMode = ? then do:
      511     mVisCUrentVin = current-window:visible.
      512     mFameOldVis = mFramBachModHandle:visible.
      513     mFramBachModHandle:visible  = yes.
      514     mBatchMode = mFramBachModHandle:visible ne yes.
      515     mFramBachModHandle:visible = mFameOldVis.
      516     current-window:visible = mVisCUrentVin.
      517   end.
      518    if  log-manager:logfile-name ne ?
      519     then DO:
      520         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      521         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      522         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      523     end.
      524   on choose of B-WaitFramStop in frame waitfram
      525   do:
      526     mWaitFramStop = yes.
      527     mWaitFramStopUser = yes.
      528   end.
      529   function waitfram-check-timeout returns logical():
      530      define variable vtime as int64 no-undo.
      531      if mWaitFramStopTimeOut
      532      then
      533         return yes.
      534      vtime = ( now - mWaitFramStartProc ) / 1000 .
      535      if     mWaitFramTimeOut ne ?
      536         and mWaitFramTimeOut ne 0
      537         and mWaitFramTimeOut lt vtime
      538      then do:
      539         mWaitFramStopTimeOut = yes.
      540      end.
      541      return mWaitFramStopTimeOut.
      542   end.
      543   procedure waitfram-hide :
      544     if not session:batch-mode
      545     then do
      546     on error undo, return error return-value
      547     :
      548       pause 0 before-hide .
      549       if not mBatchMode then
      550         hide frame waitfram .
      551     if     not mWaitFramView
      552        and mWaitProcEvent
      553     then
      554       process events .
      555     end.
      556   end procedure.
      557   procedure waitfram-show :
      558     define input  parameter p-message as character no-undo .
      559     define variable v-left-margin as integer   no-undo .
      560     if not session:batch-mode
      561     then do
      562     on error undo, return error return-value
      563     :
      564       if length(p-message) <= 70 then do:
      565         assign
      566           v-left-margin = integer((70 - length(p-message)) / 2)
      567         .
      568         assign
      569           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      570         .
      571         assign
      572           v-waitfram-action01 = " "
      573           v-waitfram-action02 = " "
      574                                    + fill(" ", v-left-margin)
      575                                    + p-message
      576           v-waitfram-action03 = " "
      577         .
      578       end.
      579       else do:
      580         define variable vRindex1 as integer no-undo.
      581         define variable vRindex2 as integer no-undo.
      582         vRindex1 = r-index(p-message," ",70).
      583         if vRindex1 = 0
      584         then
      585            vRindex1 = 70.
      586         if length(p-message)  <= vRindex1 + 70 then do:
      587           assign
      588             v-waitfram-action01 = " "
      589             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      590             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      591           .
      592         end.
      593         else do:
      594           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      595           if vRindex2 <= vRindex1
      596           then
      597              vRindex2 = vRindex1 + 70.
      598           assign
      599             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      600             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      601             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      602           .
      603         end.
      604       end.
      605       B-viewProcInfo:visible   in frame waitfram = no.
      606       B-viewProcInfo:sensitive in frame waitfram = no.
      607       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      608       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      609       if  (   mWaitFramView
      610          or  mWaitProcEvent)
      611          and not mBatchMode
      612       then
      613          display
      614             v-waitfram-action01 skip
      615             v-waitfram-action02 skip
      616             v-waitfram-action03 skip
      617          with frame waitfram .
      618       if     mWaitFramView
      619          then do:
      620             if     mWaitFramInterval ne ?
      621                and not mBatchMode
      622             then
      623                wait-for go of frame waitfram pause mWaitFramInterval.
      624          end.
      625          else
      626             if     mWaitProcEvent
      627                and not mBatchMode
      628             then
      629                process events .
      630     end.
      631   end procedure.
      632      procedure waitfram-show-this:
      633         define input  parameter iInterval as int64 no-undo.
      634         define variable vtime as int64 no-undo.
      635         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      636         mWaitFramInterval = iInterval.
      637         run waitfram-show (substitute("&1&2 &3&4" ,
      638                                       mWaitFramTextBeg ,
      639                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      640                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      641                                       mWaitFramTextEnd
      642                                      )
      643                           ).
      644      end.
      645      procedure WaitFramRunPause:
      646         define input  parameter iInterval as dec no-undo.
      647         define variable vStart  as datetime-tz no-undo.
      648         define variable vend    as datetime-tz no-undo.
      649         define variable vint as int64 no-undo.
      650         define variable vOk as logical no-undo.
      651         vStart = now.
      652         vend   = vStart.
      653         publish "WaitFramPause" (iInterval,output vOk).
      654         vend   =  now.
      655         vint = vend - vStart.
      656         vint = iInterval - vint / 1000.
      657         if     not mWaitFramStop
      658            and (   vint > 0
      659                 or (    not vOk
      660                     and iInterval eq ?
      661                     )
      662                 )
      663         then
      664            run waitfram-show-this (iInterval).
      665         vend   =  now.
      666         vint = vend - vStart.
      667         vint = iInterval - vint / 1000.
      668         if     not mWaitFramStop
      669            and vint > 0
      670         then do:
      671            run gbl/pause.p (vint * 1000).
      672         end.
      673         if iInterval ne ?
      674         then
      675            publish "WaitFramStop".
      676         waitfram-check-timeout().
      677      end.
      678      procedure WaitFramWaitFor:
      679         define input  parameter iInterval as dec no-undo.
      680         assign
      681            mWaitFramStartProc   = now
      682            mWaitFramStopUser    = no
      683            mWaitFramStopTimeOut = no
      684         .
      685         block-wait:
      686         do while not mWaitFramStop:
      687            run WaitFramRunPause (iInterval).
      688            if  waitfram-check-timeout()
      689            then do:
      690               leave block-wait.
      691            end.
      692         end.
      693         run waitfram-hide.
      694      end.
      695   procedure waitfram-join :
      696     define input  parameter p-line-1  as character no-undo .
      697     define input  parameter p-line-2  as character no-undo .
      698     define input  parameter p-line-3  as character no-undo .
      699     define output parameter p-message as character no-undo .
      700     do
      701     on error undo, return error return-value
      702     :
      703       assign
      704         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      705                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      706                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      707       .
      708     end.
      709   end procedure.
      710   function waitfram-join-function returns character
      711     (input p-line-1 as character
      712     ,input p-line-2 as character
      713     ,input p-line-3 as character
      714     ).
      715     define variable v-message as character no-undo .
      716     run waitfram-join in this-procedure
      717       (input  p-line-1
      718       ,input  p-line-2
      719       ,input  p-line-3
      720       ,output v-message
      721       ) .
      722     return v-message .
      723   end function .
      724   define variable v-shift-end-fact-order as decimal no-undo .
      725   define variable v-day-end-fact-order   as decimal no-undo .
      726   for each ub.shop no-lock ,
      727      first  ub.shift-obj no-lock where
      728             ub.shift-obj.obj-type = 'маг':U and
      729             ub.shift-obj.obj-code = ub.shop.obj-code :
      730       run waitfram-show in this-procedure ( " Пересчет переоценок по сменам маг " + string (ub.shift-obj.obj-code) ) .
      731       run p1 ( input ub.shift-obj.obj-type,
      732                input ub.shift-obj.obj-code ) .
      733   end.
      734   for each ub.store no-lock ,
      735      first  ub.shift-obj no-lock where
      736             ub.shift-obj.obj-type = 'скл':U and
      737             ub.shift-obj.obj-code = ub.store.obj-code :
      738       run waitfram-show in this-procedure ( " Пересчет переоценок по сменам скл " + string (ub.shift-obj.obj-code) ) .
      739       run p1 ( input ub.shift-obj.obj-type,
      740                input ub.shift-obj.obj-code ) .
      741   end.
      742   run waitfram-hide in this-procedure  .
      743   return.
      744   procedure p1 :
      745   define input  parameter p-obj-type as character no-undo .
      746   define input  parameter p-obj-code as integer no-undo .
      747      do
      748      on error undo, return error return-value
      749      :
      750   for each ub.price-doc exclusive-lock where
      751            ub.price-doc.obj-type = p-obj-type and
      752            ub.price-doc.obj-code = p-obj-code and
      753            ub.price-doc.status_ = 'акт':U and
      754            ub.price-doc.shift-num  = ? and
      755            ub.price-doc.shift-date = ? and
      756            ub.price-doc.fact-num < 3  :
      757         assign
      758               ub.price-doc.shift-num  = ub.price-doc.fact-num
      759               ub.price-doc.shift-date = ub.price-doc.fact-date
      760         .
      761         run factord in this-procedure  (
      762                input  ub.price-doc.fact-date
      763               ,input  time
      764               ,input  ub.price-doc.fact-num
      765               ,input  ub.price-doc.shift-date
      766               ,input  ub.price-doc.shift-num
      767               ,input  true
      768               ,output ub.price-doc.fact-order
      769               ,output v-shift-end-fact-order
      770               ,output v-day-end-fact-order
      771               ).
      772      end.
      773      end.
      774    end procedure.
