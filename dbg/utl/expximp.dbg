      374               when 'thth14-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      375               when 'thth14-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      376               when 'thth14-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      377               when 'thth14-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      378               when 'thth14-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      379               when 'thth14-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      380         otherwise do:
      381           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      382         end.
      383       end.
      384     end.
      385   end procedure.
      386   procedure thth14-db-attr-tooltip :
      387     do
      388     on error undo, return error
      389     :
      390       define input  parameter p-code    as character no-undo .
      391       define output parameter p-tooltip as character no-undo .
      392       define output parameter p-label   as character no-undo .
      393       case p-code :
      394               when 'thth14-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
      395               when 'thth14-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
      396               when 'thth14-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
      397               when 'thth14-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
      398               when 'thth14-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
      399               when 'thth14-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
      400               when 'thth14-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
      401               when 'thth14-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
      402               when 'thth14-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
      403               when 'thth14-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
      404         otherwise do:
      405           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      406         end.
      407       end.
      408     end.
      409   end procedure.
      410   procedure thth14-db-attr-value :
      411     do
      412     on error undo, return error
      413     :
      414       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      415       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      416       define output parameter p-value     like ub.db-attr.attr-value no-undo .
      417       define output parameter p-type      as character no-undo .
      418       define buffer buf_db-attr for ub.db-attr .
      419       define variable v-format         as character no-undo .
      420       define variable v-label          as character no-undo .
      421       define variable v-user-can-edit  as logical   no-undo .
      422       define variable v-output-display as logical   no-undo .
      423       define variable v-other          as character no-undo .
      424       run thth14-db-attr-code in this-procedure
      425         (input  p-code
      426         ,output p-type
      427         ,output v-format
      428         ,output v-label
      429         ,output v-user-can-edit
      430         ,output v-output-display
      431         ,output v-other
      432         ) no-error .
      433       if error-status :error then do:
      434         undo, return error return-value .
      435       end.
      436       find first buf_db-attr no-lock
      437         where buf_db-attr.db-num    = p-db-num
      438           and buf_db-attr.attr-code = p-code
      439         no-error .
      440       if avail buf_db-attr then do:
      441         assign
      442           p-value =  buf_db-attr.attr-value
      443         .
      444       end.
      445       else do:
      446         assign
      447           p-value = if p-type = 'L':U then "no":U else ""
      448         .
      449       end.
      450     end.
      451   end procedure.
      452   procedure thth14-db-attr-write :
      453     do
      454     on error undo, return error
      455     :
      456       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      457       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      458       define input parameter p-value     like ub.db-attr.attr-value no-undo .
      459       define buffer buf_db-attr for ub.db-attr .
      460       define variable v-type           as character no-undo .
      461       define variable v-format         as character no-undo .
      462       define variable v-label          as character no-undo .
      463       define variable v-user-can-edit  as logical   no-undo .
      464       define variable v-output-display as logical   no-undo .
      465       define variable v-other          as character no-undo .
      466       run thth14-db-attr-code in this-procedure
      467         (input  p-code
      468         ,output v-type
      469         ,output v-format
      470         ,output v-label
      471         ,output v-user-can-edit
      472         ,output v-output-display
      473         ,output v-other
      474         ) no-error .
      475       if error-status :error then do:
      476         undo, return error return-value .
      477       end.
      478       find first buf_db-attr exclusive-lock
      479         where buf_db-attr.db-num    = p-db-num
      480           and buf_db-attr.attr-code = p-code
      481         no-error .
      482       if not available buf_db-attr then do:
      483         create buf_db-attr .
      484         assign
      485           buf_db-attr.db-num    = p-db-num
      486           buf_db-attr.attr-code = p-code
      487         .
      488       end.
      489       assign
      490         buf_db-attr.attr-value = p-value
      491       .
      492     end.
      493   end procedure.
      494   procedure thth14-db-attr-exist :
      495     do
      496     on error undo, return error
      497     :
      498       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      499       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      500       define output parameter p-exist    as logical  no-undo .
      501       define buffer buf_db-attr for ub.db-attr .
      502       define variable v-type           as character no-undo .
      503       define variable v-format         as character no-undo .
      504       define variable v-label          as character no-undo .
      505       define variable v-user-can-edit  as logical   no-undo .
      506       define variable v-output-display as logical   no-undo .
      507       define variable v-other          as character no-undo .
      508       run thth14-db-attr-code in this-procedure
      509         (input  p-code
      510         ,output v-type
      511         ,output v-format
      512         ,output v-label
      513         ,output v-user-can-edit
      514         ,output v-output-display
      515         ,output v-other
      516         ) no-error .
      517       if error-status :error then do:
      518         undo, return error return-value .
      519       end.
      520       find first buf_db-attr no-lock
      521         where buf_db-attr.db-num    = p-db-num
      522           and buf_db-attr.attr-code = p-code
      523         no-error .
      524       if  available buf_db-attr then do:
      525         p-exist = yes.
      526       end.
      527     end.
      528   end procedure.
      529   procedure thth14-db-attr-delete :
      530     do
      531     on error undo, return error
      532     :
      533       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
      534       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
      535       define output parameter p-deleted  as logical no-undo.
      536       define buffer buf_db-attr for ub.db-attr .
      537       define variable v-type           as character no-undo .
      538       define variable v-format         as character no-undo .
      539       define variable v-label          as character no-undo .
      540       define variable v-user-can-edit  as logical   no-undo .
      541       define variable v-output-display as logical   no-undo .
      542       define variable v-other          as character no-undo .
      543       run thth14-db-attr-code in this-procedure
      544         (input  p-code
      545         ,output v-type
      546         ,output v-format
      547         ,output v-label
      548         ,output v-user-can-edit
      549         ,output v-output-display
      550         ,output v-other
      551         ) no-error .
      552       if error-status :error then do:
      553         undo, return error return-value .
      554       end.
      555       find first buf_db-attr exclusive-lock
      556         where buf_db-attr.db-num    = p-db-num
      557           and buf_db-attr.attr-code = p-code
      558         no-error NO-WAIT.
      559       if not available buf_db-attr then do:
      560         p-deleted = no.
      561       end.
      562       else do:
      563         delete buf_db-attr.
      564         p-deleted = yes.
      565       end.
      566     end.
      567   end procedure.
      568   procedure thth14-db-attr-news :
      569     do
      570     on error undo, return error
      571     :
      572       define input  parameter p-code           as character no-undo .
      573       define output parameter p-news           as logical   no-undo .
      574       case p-code :
      575               when 'thth14-cli-grp':U then do:     assign     p-news = no.   end.
      576               when 'thth14-gds-grp':U then do:     assign     p-news = no.   end.
      577               when 'thth14-clients':U then do:     assign     p-news = no.   end.
      578               when 'thth14-goods':U then do:     assign     p-news = no.   end.
      579               when 'thth14-dis-card':U then do:     assign     p-news = no.   end.
      580               when 'thth14-qnty-dis-card':U then do:     assign     p-news = no.   end.
      581               when 'thth14-shop':U then do:     assign     p-news = no.   end.
      582               when 'thth14-contract':U then do:     assign     p-news = no.   end.
      583               when 'thth14-price-doc':U then do:     assign     p-news = no.   end.
      584               when 'thth14-trn-doc':U then do:     assign     p-news = no.   end.
      585         otherwise do:
      586           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      587         end.
      588       end.
      589     end.
      590   end procedure.
      591   define variable v_os-dir   AS CHAR NO-UNDO INIT "".
      592   define variable v_os-dir-type   AS CHAR NO-UNDO INIT "".
      593   define variable v_can-write as logical no-undo.
      594   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   define variable v-waitfram-action01         as character   no-undo .
      596   define variable v-waitfram-action02         as character   no-undo .
      597   define variable v-waitfram-action03         as character   no-undo .
      598   define variable mWaitFramTextBeg            as character   no-undo.
      599   define variable mWaitFramTextEnd            as character   no-undo.
      600   define variable mWaitFramView               as logical     no-undo.
      601   define variable mWaitProcEvent              as logical     no-undo init yes.
      602   define variable mWaitFramInterval           as integer     no-undo init 1 .
      603   define variable mWaitFramStop               as logical     no-undo.
      604   define variable mWaitFramStopUser           as logical     no-undo.
      605   define variable mWaitFramStopTimeOut        as logical     no-undo.
      606   define variable mWaitFramStartProc          as datetime-tz no-undo.
      607   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      608   define button B-WaitFramStop auto-end-key
      609        label "Стоп"
      610        size 10 by 1 tooltip "Остоновить процесс".
      611   define button B-viewProcInfo
      612        label "Информация"
      613        size 15 by 1 tooltip "Информация о процесс".
      614   define frame waitfram
      615     v-waitfram-action01 format "x(72)" no-label skip
      616     v-waitfram-action02 format "x(72)" no-label skip
      617     v-waitfram-action03 format "x(72)" no-label skip
      618     B-viewProcInfo
      619     B-WaitFramStop at row 4 col 30
      620     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      621     .
      622   define new global shared variable mBatchMode as logical no-undo init ?.
      623   define variable mFramBachModHandle as handle no-undo.
      624   mFramBachModHandle = frame waitfram:handle.
      625   define variable mFameOldVis as logical no-undo.
      626   define variable mVisCUrentVin as logical no-undo.
      627   if session:batch-mode
      628   then
      629      mBatchMode = yes.
      630   if mBatchMode = ? then do:
      631     mVisCUrentVin = current-window:visible.
      632     mFameOldVis = mFramBachModHandle:visible.
      633     mFramBachModHandle:visible  = yes.
      634     mBatchMode = mFramBachModHandle:visible ne yes.
      635     mFramBachModHandle:visible = mFameOldVis.
      636     current-window:visible = mVisCUrentVin.
      637   end.
      638    if  log-manager:logfile-name ne ?
      639     then DO:
      640         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      641         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      642         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      643     end.
      644   on choose of B-WaitFramStop in frame waitfram
      645   do:
      646     mWaitFramStop = yes.
      647     mWaitFramStopUser = yes.
      648   end.
      649   function waitfram-check-timeout returns logical():
      650      define variable vtime as int64 no-undo.
      651      if mWaitFramStopTimeOut
      652      then
      653         return yes.
      654      vtime = ( now - mWaitFramStartProc ) / 1000 .
      655      if     mWaitFramTimeOut ne ?
      656         and mWaitFramTimeOut ne 0
      657         and mWaitFramTimeOut lt vtime
      658      then do:
      659         mWaitFramStopTimeOut = yes.
      660      end.
      661      return mWaitFramStopTimeOut.
      662   end.
      663   procedure waitfram-hide :
      664     if not session:batch-mode
      665     then do
      666     on error undo, return error return-value
      667     :
      668       pause 0 before-hide .
      669       if not mBatchMode then
      670         hide frame waitfram .
      671     if     not mWaitFramView
      672        and mWaitProcEvent
      673     then
      674       process events .
      675     end.
      676   end procedure.
      677   procedure waitfram-show :
      678     define input  parameter p-message as character no-undo .
      679     define variable v-left-margin as integer   no-undo .
      680     if not session:batch-mode
      681     then do
      682     on error undo, return error return-value
      683     :
      684       if length(p-message) <= 70 then do:
      685         assign
      686           v-left-margin = integer((70 - length(p-message)) / 2)
      687         .
      688         assign
      689           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      690         .
      691         assign
      692           v-waitfram-action01 = " "
      693           v-waitfram-action02 = " "
      694                                    + fill(" ", v-left-margin)
      695                                    + p-message
      696           v-waitfram-action03 = " "
      697         .
      698       end.
      699       else do:
      700         define variable vRindex1 as integer no-undo.
      701         define variable vRindex2 as integer no-undo.
      702         vRindex1 = r-index(p-message," ",70).
      703         if vRindex1 = 0
      704         then
      705            vRindex1 = 70.
      706         if length(p-message)  <= vRindex1 + 70 then do:
      707           assign
      708             v-waitfram-action01 = " "
      709             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      710             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      711           .
      712         end.
      713         else do:
      714           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      715           if vRindex2 <= vRindex1
      716           then
      717              vRindex2 = vRindex1 + 70.
      718           assign
      719             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      720             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      721             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      722           .
      723         end.
      724       end.
      725       B-viewProcInfo:visible   in frame waitfram = no.
      726       B-viewProcInfo:sensitive in frame waitfram = no.
      727       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      728       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      729       if  (   mWaitFramView
      730          or  mWaitProcEvent)
      731          and not mBatchMode
      732       then
      733          display
      734             v-waitfram-action01 skip
      735             v-waitfram-action02 skip
      736             v-waitfram-action03 skip
      737          with frame waitfram .
      738       if     mWaitFramView
      739          then do:
      740             if     mWaitFramInterval ne ?
      741                and not mBatchMode
      742             then
      743                wait-for go of frame waitfram pause mWaitFramInterval.
      744          end.
      745          else
      746             if     mWaitProcEvent
      747                and not mBatchMode
      748             then
      749                process events .
      750     end.
      751   end procedure.
      752      procedure waitfram-show-this:
      753         define input  parameter iInterval as int64 no-undo.
      754         define variable vtime as int64 no-undo.
      755         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      756         mWaitFramInterval = iInterval.
      757         run waitfram-show (substitute("&1&2 &3&4" ,
      758                                       mWaitFramTextBeg ,
      759                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      760                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      761                                       mWaitFramTextEnd
      762                                      )
      763                           ).
      764      end.
      765      procedure WaitFramRunPause:
      766         define input  parameter iInterval as dec no-undo.
      767         define variable vStart  as datetime-tz no-undo.
      768         define variable vend    as datetime-tz no-undo.
      769         define variable vint as int64 no-undo.
      770         define variable vOk as logical no-undo.
      771         vStart = now.
      772         vend   = vStart.
      773         publish "WaitFramPause" (iInterval,output vOk).
      774         vend   =  now.
      775         vint = vend - vStart.
      776         vint = iInterval - vint / 1000.
      777         if     not mWaitFramStop
      778            and (   vint > 0
      779                 or (    not vOk
      780                     and iInterval eq ?
      781                     )
      782                 )
      783         then
      784            run waitfram-show-this (iInterval).
      785         vend   =  now.
      786         vint = vend - vStart.
      787         vint = iInterval - vint / 1000.
      788         if     not mWaitFramStop
      789            and vint > 0
      790         then do:
      791            run gbl/pause.p (vint * 1000).
      792         end.
      793         if iInterval ne ?
      794         then
      795            publish "WaitFramStop".
      796         waitfram-check-timeout().
      797      end.
      798      procedure WaitFramWaitFor:
      799         define input  parameter iInterval as dec no-undo.
      800         assign
      801            mWaitFramStartProc   = now
      802            mWaitFramStopUser    = no
      803            mWaitFramStopTimeOut = no
      804         .
      805         block-wait:
      806         do while not mWaitFramStop:
      807            run WaitFramRunPause (iInterval).
      808            if  waitfram-check-timeout()
      809            then do:
      810               leave block-wait.
      811            end.
      812         end.
      813         run waitfram-hide.
      814      end.
      815   procedure waitfram-join :
      816     define input  parameter p-line-1  as character no-undo .
      817     define input  parameter p-line-2  as character no-undo .
      818     define input  parameter p-line-3  as character no-undo .
      819     define output parameter p-message as character no-undo .
      820     do
      821     on error undo, return error return-value
      822     :
      823       assign
      824         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      825                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      826                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      827       .
      828     end.
      829   end procedure.
      830   function waitfram-join-function returns character
      831     (input p-line-1 as character
      832     ,input p-line-2 as character
      833     ,input p-line-3 as character
      834     ).
      835     define variable v-message as character no-undo .
      836     run waitfram-join in this-procedure
      837       (input  p-line-1
      838       ,input  p-line-2
      839       ,input  p-line-3
      840       ,output v-message
      841       ) .
      842     return v-message .
      843   end function .
      844   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   function corr-file-name returns character (
      846    input p-file-name as character)
      847    .
      848   DEFINE variable v-corr-file-name as character no-undo.
      849   DEFINE VARIABLE ii as integer no-undo .
      850   DEFINE VARIABLE v-char-name-list as character no-undo .
      851   assign
      852   v-corr-file-name = p-file-name
      853   .
      854   do ii = 1 to length('\/:*?"<>|':U):
      855     assign
      856     v-corr-file-name = replace(
      857                                   v-corr-file-name
      858                                  , substr('\/:*?"<>|':U, ii, 1 )
      859                                  , entry(ii, 'b-slash,slash,colon,star,question,d-quote,d-quote,less-t,great-t,pipe':U)
      860                              )
      861     .
      862   end.
      863   return v-corr-file-name.
      864   end function.
      865   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   define variable v-log-gap as logical no-undo .
      867   define variable v-user-name    as character    no-undo.
      868   define variable v-grp-name    as character    no-undo.
      869   define variable v-arm-code    as character    no-undo.
      870   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      871   procedure gen-key-rec :
      872     define input  parameter p-tbl-name    as character no-undo.
      873     define input  parameter p-bh_tbl-name as handle    no-undo.
      874     define output parameter p-key-rec     as character no-undo.
      875     do
      876     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      877     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      878     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      879     :
      880       define variable fh               as handle    no-undo .
      881       define variable v-ok             as logical   no-undo .
      882       define variable v-inform         as character no-undo .
      883       define variable v-ind            as integer   no-undo .
      884       define variable v-idx-field-qnty as integer   no-undo .
      885       if p-tbl-name = ?
      886         or p-tbl-name = "":U
      887       then do:
      888         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      889       end.
      890       if not p-bh_tbl-name:available then do:
      891         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      892       end.
      893       assign
      894         p-key-rec = p-tbl-name
      895         v-inform  = p-bh_tbl-name:index-information(1)
      896         v-ind     = 2
      897       .
      898       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      899       on error undo, return error
      900       :
      901         assign
      902           v-inform = p-bh_tbl-name:index-information( v-ind )
      903           v-ind    = v-ind + 1
      904         .
      905       end.
      906       if v-inform = ?
      907         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      908         or entry( 3, v-inform, ",":U ) <> "1":U
      909       then do:
      910         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      911       end.
      912       else do:
      913         assign
      914           v-idx-field-qnty = num-entries( v-inform ) - 4
      915         .
      916         if v-idx-field-qnty < 2 then do:
      917           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      918         end.
      919         do v-ind = 1 to v-idx-field-qnty by 2
      920         on error undo, return error
      921         :
      922           assign
      923             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      924             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      925           .
      926         end.
      927       end.
      928       if p-key-rec = ? then do:
      929         assign
      930           p-key-rec = "":U
      931         .
      932         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      933       end.
      934     end.
      935     return.
      936   end procedure.
      937   procedure gen-where-keyr-tab :
      938     define input  parameter i-tableSerach as character no-undo.
      939     define input  parameter i-tablekey   as character  no-undo.
      940     define input  parameter p-key-rec    as character  no-undo.
      941     define input  parameter p-key-handle as handle     no-undo .
      942     define input  parameter p-db-name    as character  no-undo .
      943     define input  parameter p-tt-handle  as handle     no-undo .
      944     define output parameter o-Where      as character  no-undo.
      945     do
      946     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      947     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      948     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      949     :
      950       define variable v-full-tbl-name  as character no-undo .
      951       define variable bh_tbl-name      as handle    no-undo .
      952       define variable fh_key           as handle    no-undo .
      953       define variable fh_search        as handle    no-undo .
      954       define variable v-field-num      as integer   no-undo .
      955       define variable v-count-fld      as integer   no-undo .
      956       define variable v-inform         as character no-undo .
      957       define variable v-ind            as integer   no-undo .
      958       define variable v-idx-field-qnty as integer   no-undo .
      959       define variable v-field-name     as character no-undo .
      960       define variable v-field-val      as character no-undo .
      961       define variable v-word-link      as character no-undo .
      962       define variable vTable           as character no-undo.
      963       define variable bh_tbl-key       as handle    no-undo .
      964       assign
      965         p-key-rec = trim( p-key-rec )
      966       .
      967       if p-key-handle <> ? then do:
      968         if not valid-handle(p-key-handle)
      969            or p-key-handle:type <> "buffer"
      970         then do:
      971           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      972         end.
      973         if num-entries( p-key-rec, chr(3) ) > 1
      974           or p-key-rec = ?
      975           or p-key-rec = "":U
      976         then do:
      977           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      978         end.
      979       end.
      980       else do:
      981         if p-key-rec = ?
      982           or p-key-rec = "":U
      983         then do:
      984           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      985         end.
      986       end.
      987       assign
      988         vTable = entry( 1 , p-key-rec, chr(3) )
      989       .
      990       if p-tt-handle <> ?
      991         and ( not valid-handle(p-tt-handle)
      992               or p-tt-handle:type <> "buffer"
      993             )
      994       then do:
      995         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      996       end.
      997       if p-tt-handle = ? then do:
      998         assign
      999           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1000         .
     1001         create buffer bh_tbl-name for table v-full-tbl-name .
     1002       end.
     1003       else do:
     1004         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1005       end.
     1006       assign
     1007         v-inform = bh_tbl-name:index-information(1)
     1008         v-ind    = 2
     1009       .
     1010       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1011       on error undo, return error
     1012       :
     1013         assign
     1014           v-inform = bh_tbl-name:index-information( v-ind )
     1015           v-ind    = v-ind + 1
     1016         .
     1017       end.
     1018       if v-inform = ?
     1019         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1020         or entry( 3, v-inform, ",":U ) <> "1":U
     1021       then do:
     1022         delete object bh_tbl-name no-error.
     1023         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
     1024       end.
     1025       assign
     1026         v-idx-field-qnty = num-entries( v-inform ) - 4
     1027       .
     1028       if v-idx-field-qnty < 2 then do:
     1029         delete object bh_tbl-name no-error.
     1030         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
     1031       end.
     1032       assign
     1033         o-where     = "where":U
     1034         v-word-link = "":U
     1035         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1036         v-count-fld = 0
     1037       .
     1038       if i-tablekey ne "" and i-tablekey ne ?
     1039       then do:
     1040         assign
     1041           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1042         .
     1043         create buffer bh_tbl-key for table v-full-tbl-name .
     1044       end.
     1045       if i-tableSerach ne "" and i-tableSerach ne ?
     1046       then do:
     1047         delete object bh_tbl-name no-error.
     1048         assign
     1049           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1050         .
     1051         create buffer bh_tbl-name for table v-full-tbl-name .
     1052       end.
     1053       block_where:
     1054       do v-ind = 1 to v-idx-field-qnty by 2
     1055       on error undo, return error
     1056       :
     1057         assign
     1058           v-count-fld = v-count-fld + 1
     1059         .
     1060         if p-key-handle = ?
     1061           and v-count-fld > v-field-num
     1062         then do:
     1063           leave block_where.
     1064         end.
     1065         define variable VfieldKeyTable as handle no-undo.
     1066         assign
     1067           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1068           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1069         .
     1070         if     bh_tbl-key ne ?
     1071         then do:
     1072            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1073            if VfieldKeyTable eq ?
     1074            then next block_where.
     1075         end.
     1076         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1077         then
     1078            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1079         else
     1080            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1081         if p-key-handle = ? then do:
     1082           assign
     1083             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1084           .
     1085         end.
     1086         else do:
     1087           assign
     1088             fh_key = p-key-handle:buffer-field( v-field-name )
     1089           .
     1090           if fh_key = ?
     1091             or not valid-handle( fh_key )
     1092           then do:
     1093             delete object bh_tbl-name.
     1094             if     bh_tbl-key ne ?
     1095             then
     1096                delete object bh_tbl-key.
     1097             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1098           end.
     1099           assign
     1100             v-field-val = fh_key:buffer-value
     1101           .
     1102         end.
     1103         if fh_search:data-type ="character":U then do:
     1104           assign
     1105             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1106             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1107             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1108             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1109             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1110             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1111             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1112             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1113             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1114             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1115             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1116             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1117             v-field-val = substitute( '"&1"', v-field-val )
     1118           .
     1119         end.
     1120         assign
     1121           o-where = substitute( "&1 &2", o-where, v-field-val )
     1122         .
     1123         if v-word-link = "":U then do:
     1124           assign
     1125             v-word-link = "and":U
     1126           .
     1127         end.
     1128       end.
     1129       delete object bh_tbl-name.
     1130       if     bh_tbl-key ne ?
     1131       then
     1132          delete object bh_tbl-key.
     1133       if p-key-handle = ?
     1134         and v-count-fld <> v-field-num
     1135       then do:
     1136         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1137       end.
     1138     end.
     1139   end procedure.
     1140   procedure gen-hn-keyr-tab :
     1141     define input  parameter i-tableSerach as character no-undo.
     1142     define input  parameter i-tablekey   as character no-undo.
     1143     define input  parameter p-key-rec    as character no-undo.
     1144     define input  parameter p-key-handle as handle    no-undo .
     1145     define input  parameter p-db-name    as character no-undo .
     1146     define input  parameter p-tt-handle  as handle    no-undo .
     1147     define input  parameter p-stts-lock  as integer   no-undo .
     1148     define output parameter o-hn         as handle    no-undo.
     1149     define variable v-full-tbl-name as character no-undo.
     1150     define variable v-where         as character no-undo.
     1151     define variable bh_tbl-name     as handle    no-undo.
     1152     define variable vTable          as character no-undo.
     1153     do
     1154     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1155     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1156     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1157         run gen-where-keyr-tab(i-tableSerach,
     1158                                i-tablekey,
     1159                                p-key-rec,
     1160                                p-key-handle,
     1161                                p-db-name,
     1162                                p-tt-handle,
     1163                                output v-where).
     1164         if i-tableSerach ne "" and i-tableSerach ne ?
     1165         then do:
     1166            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1167            create buffer bh_tbl-name for table v-full-tbl-name .
     1168         end.
     1169         else do:
     1170            if p-tt-handle = ? then do:
     1171               assign
     1172                  vTable = entry( 1 , p-key-rec, chr(3) )
     1173               .
     1174               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1175               create buffer bh_tbl-name for table v-full-tbl-name .
     1176            end.
     1177            else do:
     1178               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1179            end.
     1180         end.
     1181         if p-tt-handle = ? then do:
     1182            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1183         end.
     1184         else do:
     1185            bh_tbl-name:find-first( v-where ) no-error .
     1186         end.
     1187         o-hn = bh_tbl-name.
     1188      end.
     1189   end procedure.
     1190   procedure gen-hn-keyr :
     1191     define input  parameter p-key-rec    as character no-undo.
     1192     define input  parameter p-key-handle as handle    no-undo .
     1193     define input  parameter p-db-name    as character no-undo .
     1194     define input  parameter p-tt-handle  as handle    no-undo .
     1195     define input  parameter p-stts-lock  as integer   no-undo .
     1196     define output parameter o-hn         as handle    no-undo.
     1197     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1198   end.
     1199   procedure gen-row-keyr :
     1200     define input  parameter p-key-rec    as character no-undo.
     1201     define input  parameter p-key-handle as handle    no-undo .
     1202     define input  parameter p-db-name    as character no-undo .
     1203     define input  parameter p-tt-handle  as handle    no-undo .
     1204     define input  parameter p-stts-lock  as integer   no-undo .
     1205     define output parameter p-tbl-row    as rowid     no-undo.
     1206     define output parameter p-tbl-name   as character no-undo.
     1207     define variable vHn as handle no-undo.
     1208       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1209       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1210       p-tbl-name =  vHn:table.
     1211       delete object vHn no-error.
     1212     if p-tbl-row = ? then do:
     1213       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1214     end.
     1215     else do:
     1216       return.
     1217     end.
     1218   end procedure.
     1219   procedure gen-key-fv :
     1220     define input  parameter p-key-rec    as character no-undo .
     1221     define output parameter p-field-list as character no-undo .
     1222     define output parameter p-value-list as character no-undo.
     1223     do
     1224     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1225     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1226     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1227     :
     1228       define variable v-full-tbl-name  as character no-undo .
     1229       define variable bh_tbl-name      as handle    no-undo .
     1230       define variable v-tbl-name       as character no-undo .
     1231       define variable v-field-num      as integer   no-undo .
     1232       define variable v-count-fld      as integer   no-undo .
     1233       define variable v-inform         as character no-undo .
     1234       define variable v-ind            as integer   no-undo .
     1235       define variable v-idx-field-qnty as integer   no-undo .
     1236       define variable v-delim-key      as character no-undo .
     1237       if p-key-rec = ?
     1238         or p-key-rec = "":U
     1239       then do:
     1240         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1241       end.
     1242       assign
     1243         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1244         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1245       .
     1246       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1247       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1248       assign
     1249         v-inform = bh_tbl-name:index-information(1)
     1250         v-ind    = 2
     1251       .
     1252       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1253       on error undo, return error
     1254       :
     1255         assign
     1256           v-inform = bh_tbl-name:index-information( v-ind )
     1257           v-ind    = v-ind + 1
     1258         .
     1259       end.
     1260       if v-inform = ?
     1261         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1262         or entry( 3, v-inform, ",":U ) <> "1":U
     1263       then do:
     1264         delete object bh_tbl-name no-error.
     1265         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1266       end.
     1267       assign
     1268         v-idx-field-qnty = num-entries( v-inform ) - 4
     1269       .
     1270       if v-idx-field-qnty < 2 then do:
     1271         delete object bh_tbl-name no-error.
     1272         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1273       end.
     1274       assign
     1275         p-field-list = "":U
     1276         p-value-list = "":U
     1277         v-delim-key  = "":U
     1278         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1279         v-count-fld  = 0
     1280       .
     1281       block_where:
     1282       do v-ind = 1 to v-idx-field-qnty by 2
     1283       on error undo, return error
     1284       :
     1285         assign
     1286           v-count-fld = v-count-fld + 1
     1287         .
     1288         if v-count-fld > v-field-num then do:
     1289           leave block_where.
     1290         end.
     1291         assign
     1292           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1293           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1294         .
     1295         if v-ind = 1 then do:
     1296           assign
     1297             v-delim-key = chr(3)
     1298           .
     1299         end.
     1300       end.
     1301       delete object bh_tbl-name.
     1302       if v-count-fld <> v-field-num then do:
     1303         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1304       end.
     1305     end.
     1306   end procedure.
     1307   procedure gen-key-field :
     1308     define input  parameter p-table      as character no-undo .
     1309     define output parameter p-field-list as character no-undo .
     1310     do
     1311     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1312     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1313     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1314     :
     1315       define variable v-full-tbl-name  as character no-undo .
     1316       define variable bh_tbl-name      as handle    no-undo .
     1317       define variable v-tbl-name       as character no-undo .
     1318       define variable v-field-num      as integer   no-undo .
     1319       define variable v-count-fld      as integer   no-undo .
     1320       define variable v-inform         as character no-undo .
     1321       define variable v-ind            as integer   no-undo .
     1322       define variable v-idx-field-qnty as integer   no-undo .
     1323       define variable v-delim-key      as character no-undo .
     1324       if p-table = ?
     1325         or p-table = "":U
     1326       then do:
     1327         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1328       end.
     1329       assign
     1330         v-tbl-name      = p-table
     1331         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1332       .
     1333       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1334       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1335       assign
     1336         v-inform = bh_tbl-name:index-information(1)
     1337         v-ind    = 2
     1338       .
     1339       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1340       on error undo, return error
     1341       :
     1342         assign
     1343           v-inform = bh_tbl-name:index-information( v-ind )
     1344           v-ind    = v-ind + 1
     1345         .
     1346       end.
     1347       if v-inform = ?
     1348         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1349         or entry( 3, v-inform, ",":U ) <> "1":U
     1350       then do:
     1351         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1352       end.
     1353       assign
     1354         v-idx-field-qnty = num-entries( v-inform ) - 4
     1355       .
     1356       if v-idx-field-qnty < 2 then do:
     1357         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1358       end.
     1359       assign
     1360         p-field-list = "":U
     1361         v-delim-key  = "":U
     1362         v-count-fld  = 0
     1363       .
     1364       block_where:
     1365       do v-ind = 1 to v-idx-field-qnty by 2
     1366       on error undo, return error
     1367       :
     1368         assign
     1369           v-count-fld = v-count-fld + 1
     1370         .
     1371         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1372         if v-ind = 1 then do:
     1373           assign
     1374             v-delim-key = chr(3)
     1375           .
     1376         end.
     1377       end.
     1378       delete object bh_tbl-name.
     1379     end.
     1380   end procedure.
     1381   DEFINE BUTTON B-dir
     1382        IMAGE-UP FILE "btn-down-arrow":U
     1383        IMAGE-DOWN FILE "btn-down-arrow":U
     1384        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1385        LABEL ""
     1386        SIZE 3 BY 1.
