     1459   DEFINE VARIABLE Rs-new-obj-type AS CHARACTER
     1460        VIEW-AS RADIO-SET HORIZONTAL
     1461        RADIO-BUTTONS
     1462             "Item 1", "1"
     1463        SIZE 12.5 BY .8 NO-UNDO.
     1464   DEFINE VARIABLE Rs-old-obj-type AS CHARACTER
     1465        VIEW-AS RADIO-SET HORIZONTAL
     1466        RADIO-BUTTONS
     1467             "Item 1", "1"
     1468        SIZE 12.5 BY .8 NO-UNDO.
     1469   DEFINE RECTANGLE RECT-groups
     1470        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1471        SIZE 86.8 BY 13.67.
     1472   DEFINE VARIABLE T-cdk AS LOGICAL INITIAL yes
     1473        LABEL "Кассы"
     1474        VIEW-AS TOGGLE-BOX
     1475        SIZE 18.8 BY .8 NO-UNDO.
     1476   DEFINE VARIABLE T-cdrg AS LOGICAL INITIAL no
     1477        LABEL "Диапазоны весовых кодов"
