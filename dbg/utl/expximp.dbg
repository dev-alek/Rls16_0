     1443        SIZE 29.4 BY .8 NO-UNDO.
     1444   DEFINE VARIABLE F-rht AS CHARACTER FORMAT "X(256)":U
     1445         VIEW-AS TEXT
     1446        SIZE 29.4 BY .8 NO-UNDO.
     1447   DEFINE VARIABLE F-scl AS CHARACTER FORMAT "X(256)":U
     1448         VIEW-AS TEXT
     1449        SIZE 29.4 BY .8 NO-UNDO.
     1450   DEFINE VARIABLE F-seq AS CHARACTER FORMAT "X(256)":U
     1451         VIEW-AS TEXT
     1452        SIZE 29.4 BY .8 NO-UNDO.
     1453   DEFINE VARIABLE F-thb AS CHARACTER FORMAT "X(256)":U
     1454         VIEW-AS TEXT
     1455        SIZE 29.4 BY .8 NO-UNDO.
     1456   DEFINE VARIABLE F-usr AS CHARACTER FORMAT "X(256)":U
