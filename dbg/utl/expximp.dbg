     1418        SIZE 29.4 BY .8 NO-UNDO.
     1419   DEFINE VARIABLE F-gen AS CHARACTER FORMAT "X(256)":U
     1420         VIEW-AS TEXT
     1421        SIZE 29.4 BY .8 NO-UNDO.
     1422   DEFINE VARIABLE f-new-host-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1423        LABEL "Новый код фирмы"
     1424        VIEW-AS FILL-IN
     1425        SIZE 6 BY 1 NO-UNDO.
