     1431        LABEL "Старый код фирмы"
     1432        VIEW-AS FILL-IN
     1433        SIZE 6 BY 1 NO-UNDO.
     1434   DEFINE VARIABLE f-old-obj-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
