        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-from-version as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":u .
        4   define variable vss-author      as character no-undo init "$Author$":u .
        5   define variable vss-date        as character no-undo init "$Date$":u .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        7   define variable vss-archive     as character no-undo init "$Archive$":u .
        8   define variable vss-description as character no-undo init "Экспорт-импорт локальных таблиц УБД из старой версии TH - запуск" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   procedure thth150-db-attr-code :
      125     do
      126     on error undo, return error
      127     :
      128       define input  parameter p-code           as character no-undo .
      129       define output parameter p-type           as character no-undo .
      130       define output parameter p-format         as character no-undo .
      131       define output parameter p-label          as character no-undo .
      132       define output parameter p-user-can-edit  as logical   no-undo .
      133       define output parameter p-output-display as logical   no-undo .
      134       define output parameter p-other          as character no-undo .
      135       case p-code :
      136               when 'thth150-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      137               when 'thth150-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      138               when 'thth150-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      139               when 'thth150-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      140               when 'thth150-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      141               when 'thth150-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      142               when 'thth150-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      143               when 'thth150-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      144               when 'thth150-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      145               when 'thth150-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      146         otherwise do:
      147           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      148         end.
      149       end.
      150     end.
      151   end procedure.
      152   procedure thth150-db-attr-tooltip :
      153     do
      154     on error undo, return error
      155     :
      156       define input  parameter p-code    as character no-undo .
      157       define output parameter p-tooltip as character no-undo .
      158       define output parameter p-label   as character no-undo .
      159       case p-code :
      160               when 'thth150-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
      161               when 'thth150-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
      162               when 'thth150-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
      163               when 'thth150-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
      164               when 'thth150-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
      165               when 'thth150-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
      166               when 'thth150-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
      167               when 'thth150-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
      168               when 'thth150-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
      169               when 'thth150-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
      170         otherwise do:
      171           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      172         end.
      173       end.
      174     end.
      175   end procedure.
      176   procedure thth150-db-attr-value :
      177     do
      178     on error undo, return error
      179     :
      180       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      181       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      182       define output parameter p-value     like ub.db-attr.attr-value no-undo .
      183       define output parameter p-type      as character no-undo .
      184       define buffer buf_db-attr for ub.db-attr .
      185       define variable v-format         as character no-undo .
      186       define variable v-label          as character no-undo .
      187       define variable v-user-can-edit  as logical   no-undo .
      188       define variable v-output-display as logical   no-undo .
      189       define variable v-other          as character no-undo .
      190       run thth150-db-attr-code in this-procedure
      191         (input  p-code
      192         ,output p-type
      193         ,output v-format
      194         ,output v-label
      195         ,output v-user-can-edit
      196         ,output v-output-display
      197         ,output v-other
      198         ) no-error .
      199       if error-status :error then do:
      200         undo, return error return-value .
      201       end.
      202       find first buf_db-attr no-lock
      203         where buf_db-attr.db-num    = p-db-num
      204           and buf_db-attr.attr-code = p-code
      205         no-error .
      206       if avail buf_db-attr then do:
      207         assign
      208           p-value =  buf_db-attr.attr-value
      209         .
      210       end.
      211       else do:
      212         assign
      213           p-value = if p-type = 'L':U then "no":U else ""
      214         .
      215       end.
      216     end.
      217   end procedure.
      218   procedure thth150-db-attr-write :
      219     do
      220     on error undo, return error
      221     :
      222       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      223       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      224       define input parameter p-value     like ub.db-attr.attr-value no-undo .
      225       define buffer buf_db-attr for ub.db-attr .
      226       define variable v-type           as character no-undo .
      227       define variable v-format         as character no-undo .
      228       define variable v-label          as character no-undo .
      229       define variable v-user-can-edit  as logical   no-undo .
      230       define variable v-output-display as logical   no-undo .
      231       define variable v-other          as character no-undo .
      232       run thth150-db-attr-code in this-procedure
      233         (input  p-code
      234         ,output v-type
      235         ,output v-format
      236         ,output v-label
      237         ,output v-user-can-edit
      238         ,output v-output-display
      239         ,output v-other
      240         ) no-error .
      241       if error-status :error then do:
      242         undo, return error return-value .
      243       end.
      244       find first buf_db-attr exclusive-lock
      245         where buf_db-attr.db-num    = p-db-num
      246           and buf_db-attr.attr-code = p-code
      247         no-error .
      248       if not available buf_db-attr then do:
      249         create buf_db-attr .
      250         assign
      251           buf_db-attr.db-num    = p-db-num
      252           buf_db-attr.attr-code = p-code
      253         .
      254       end.
      255       assign
      256         buf_db-attr.attr-value = p-value
      257       .
      258     end.
      259   end procedure.
      260   procedure thth150-db-attr-exist :
      261     do
      262     on error undo, return error
      263     :
      264       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      265       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      266       define output parameter p-exist    as logical  no-undo .
      267       define buffer buf_db-attr for ub.db-attr .
      268       define variable v-type           as character no-undo .
      269       define variable v-format         as character no-undo .
      270       define variable v-label          as character no-undo .
      271       define variable v-user-can-edit  as logical   no-undo .
      272       define variable v-output-display as logical   no-undo .
      273       define variable v-other          as character no-undo .
      274       run thth150-db-attr-code in this-procedure
      275         (input  p-code
      276         ,output v-type
      277         ,output v-format
      278         ,output v-label
      279         ,output v-user-can-edit
      280         ,output v-output-display
      281         ,output v-other
      282         ) no-error .
      283       if error-status :error then do:
      284         undo, return error return-value .
      285       end.
      286       find first buf_db-attr no-lock
      287         where buf_db-attr.db-num    = p-db-num
      288           and buf_db-attr.attr-code = p-code
      289         no-error .
      290       if  available buf_db-attr then do:
      291         p-exist = yes.
      292       end.
      293     end.
      294   end procedure.
      295   procedure thth150-db-attr-delete :
      296     do
      297     on error undo, return error
      298     :
      299       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
      300       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
      301       define output parameter p-deleted  as logical no-undo.
      302       define buffer buf_db-attr for ub.db-attr .
      303       define variable v-type           as character no-undo .
      304       define variable v-format         as character no-undo .
      305       define variable v-label          as character no-undo .
      306       define variable v-user-can-edit  as logical   no-undo .
      307       define variable v-output-display as logical   no-undo .
      308       define variable v-other          as character no-undo .
      309       run thth150-db-attr-code in this-procedure
      310         (input  p-code
      311         ,output v-type
      312         ,output v-format
      313         ,output v-label
      314         ,output v-user-can-edit
      315         ,output v-output-display
      316         ,output v-other
      317         ) no-error .
      318       if error-status :error then do:
      319         undo, return error return-value .
      320       end.
      321       find first buf_db-attr exclusive-lock
      322         where buf_db-attr.db-num    = p-db-num
      323           and buf_db-attr.attr-code = p-code
      324         no-error NO-WAIT.
      325       if not available buf_db-attr then do:
      326         p-deleted = no.
      327       end.
      328       else do:
      329         delete buf_db-attr.
      330         p-deleted = yes.
      331       end.
      332     end.
      333   end procedure.
      334   procedure thth150-db-attr-news :
      335     do
      336     on error undo, return error
      337     :
      338       define input  parameter p-code           as character no-undo .
      339       define output parameter p-news           as logical   no-undo .
      340       case p-code :
      341               when 'thth150-cli-grp':U then do:     assign     p-news = no.   end.
      342               when 'thth150-gds-grp':U then do:     assign     p-news = no.   end.
      343               when 'thth150-clients':U then do:     assign     p-news = no.   end.
      344               when 'thth150-goods':U then do:     assign     p-news = no.   end.
      345               when 'thth150-dis-card':U then do:     assign     p-news = no.   end.
      346               when 'thth150-qnty-dis-card':U then do:     assign     p-news = no.   end.
      347               when 'thth150-shop':U then do:     assign     p-news = no.   end.
      348               when 'thth150-contract':U then do:     assign     p-news = no.   end.
      349               when 'thth150-price-doc':U then do:     assign     p-news = no.   end.
      350               when 'thth150-trn-doc':U then do:     assign     p-news = no.   end.
      351         otherwise do:
      352           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      353         end.
      354       end.
      355     end.
      356   end procedure.
      357   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
