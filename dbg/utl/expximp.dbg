     1515        SIZE 18.8 BY .8 NO-UNDO.
     1516   DEFINE VARIABLE T-usr AS LOGICAL INITIAL yes
     1517        LABEL "Пользователи"
     1518        VIEW-AS TOGGLE-BOX
     1519        SIZE 18.8 BY .8 NO-UNDO.
     1520   DEFINE FRAME Dialog-Frame
     1521        B-exit AT ROW 1 COL 1.1
     1522        B-export AT ROW 1 COL 21
     1523        B-import AT ROW 1 COL 31
     1524        B-Help AT ROW 1 COL 82
     1525        B-dir AT ROW 2 COL 81.3
     1526        T-rht AT ROW 5 COL 3
     1527        T-gen AT ROW 6 COL 3
     1528        T-thb AT ROW 7 COL 3 WIDGET-ID 30
     1529        T-cdrg AT ROW 8 COL 3 WIDGET-ID 22
     1530        T-pbc AT ROW 9 COL 3
     1531        T-glb AT ROW 9 COL 64.5 WIDGET-ID 2
     1532        T-scl AT ROW 10 COL 3
     1533        T-cdk AT ROW 11 COL 3 WIDGET-ID 26
     1534        T-seq AT ROW 12 COL 3
     1535        T-usr AT ROW 13 COL 3
     1536        T-flt AT ROW 14 COL 3
     1537        T-pet AT ROW 15 COL 3 WIDGET-ID 34
     1538        B-obj AT ROW 17.27 COL 1 WIDGET-ID 38
     1539        f-old-host-code AT ROW 17.27 COL 19.5 COLON-ALIGNED WIDGET-ID 4
     1540        f-new-host-code AT ROW 17.27 COL 49 COLON-ALIGNED WIDGET-ID 6
     1541        Rs-old-obj-type AT ROW 18.33 COL 21 NO-LABEL WIDGET-ID 16
     1542        Rs-new-obj-type AT ROW 18.33 COL 51 NO-LABEL WIDGET-ID 18
     1543        f-old-obj-code AT ROW 19.27 COL 19.5 COLON-ALIGNED WIDGET-ID 8
     1544        f-new-obj-code AT ROW 19.27 COL 49 COLON-ALIGNED WIDGET-ID 10
     1545        dir-name AT ROW 2 COL 28.6 COLON-ALIGNED NO-LABEL
     1546        F-rht AT ROW 5 COL 30.5 COLON-ALIGNED NO-LABEL
     1547        F-gen AT ROW 6 COL 30.5 COLON-ALIGNED NO-LABEL
     1548        F-thb AT ROW 7 COL 30.5 COLON-ALIGNED NO-LABEL WIDGET-ID 32
     1549        F-cdrg AT ROW 8 COL 30.5 COLON-ALIGNED NO-LABEL WIDGET-ID 24
     1550        F-pbc AT ROW 9 COL 30.5 COLON-ALIGNED NO-LABEL
     1551        F-scl AT ROW 10 COL 30.5 COLON-ALIGNED NO-LABEL
     1552        F-cdk AT ROW 11 COL 30.5 COLON-ALIGNED NO-LABEL WIDGET-ID 28
     1553        F-seq AT ROW 12 COL 30.5 COLON-ALIGNED NO-LABEL
     1554        F-usr AT ROW 13 COL 30.5 COLON-ALIGNED NO-LABEL
     1555        F-flt AT ROW 14 COL 30.5 COLON-ALIGNED NO-LABEL
     1556        F-pet AT ROW 15 COL 30.5 COLON-ALIGNED NO-LABEL WIDGET-ID 36
     1557        "Группы данных" VIEW-AS TEXT
     1558             SIZE 20.1 BY .8 AT ROW 4 COL 3.4
     1559             FGCOLOR 4
     1560        "Название файла экспорта-импорта" VIEW-AS TEXT
     1561             SIZE 33.5 BY .8 AT ROW 4 COL 33.1
     1562             FGCOLOR 4
     1563        "ПРИ ИМПОРТЕ" VIEW-AS TEXT
     1564             SIZE 22 BY 1.07 AT ROW 17.27 COL 65.5 WIDGET-ID 20
     1565             FGCOLOR 4
     1566        "Директория экспорта/импорта" VIEW-AS TEXT
     1567             SIZE 27.9 BY 1 AT ROW 2 COL 2
     1568             FGCOLOR 4
     1569        RECT-groups AT ROW 3.4 COL 1.8
     1570        SPACE(0.39) SKIP(3.85)
     1571       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1572            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1573            TITLE "Экспорт-импорт локальных таблиц для РАСТЯНУТОГО upgrade"
     1574            DEFAULT-BUTTON B-exit.
     1575   ASSIGN
     1576          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1577          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1578   ASSIGN
     1579          B-export:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1580   ASSIGN
     1581          F-cdrg:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1582   ASSIGN
     1583          F-gen:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1584   ASSIGN
     1585          F-rht:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1586   ASSIGN
     1587          F-seq:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1588   ASSIGN
     1589          F-thb:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1590   ASSIGN
     1591          T-cdrg:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1592   ASSIGN
     1593          T-gen:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1594   ASSIGN
     1595          T-rht:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1596   ASSIGN
     1597          T-seq:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1598   ASSIGN
     1599          T-thb:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1600   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1601   DO:
     1602     APPLY "END-ERROR":U TO SELF.
     1603   END.
     1604   ON CHOOSE OF B-dir IN FRAME Dialog-Frame
     1605   DO:
     1606       run gbl/dir-sel.p (output v_os-dir,
     1607                   output v_os-dir-type,
     1608                   output v_can-write) no-error.
     1609       if error-status:error then return no-apply.
     1610       dir-name = v_os-dir.
     1611       display
     1612       dir-name
     1613       with frame Dialog-Frame.
     1614   END.
     1615   ON CHOOSE OF B-export IN FRAME Dialog-Frame
     1616   DO:
     1617     if NOT v_can-write then do:
     1618       message "Данная директория доступна только для чтения"
     1619       view-as alert-box ERROR.
     1620       return no-apply.
     1621     end.
     1622     run waitfram-show in this-procedure ( input "Ждите..." ).
     1623     run proc-b-ie in this-procedure ( input "export":U).
     1624     run waitfram-hide in this-procedure .
     1625   END.
     1626   ON CHOOSE OF B-import IN FRAME Dialog-Frame
     1627   DO:
     1628    DEFINE buffer buf_sysconf FOR ub.sysconf.
     1629    DEFINE BUFFER buf_clients FOR ub.clients.
     1630    ASSIGN
     1631    f-old-host-code
     1632    f-new-host-code
     1633    rs-old-obj-type
     1634    rs-new-obj-type
     1635    f-old-obj-code
     1636    f-new-obj-code
     1637    .
     1638    FIND FIRST buf_sysconf NO-LOCK WHERE
     1639               buf_sysconf.host-code = f-new-host-code NO-ERROR.
     1640    IF NOT AVAILABLE buf_sysconf THEN DO:
     1641      MESSAGE
     1642      substitute("Не найдена фирма с кодом (НОВОЙ) фирмы &1"
     1643                 , f-new-host-code)
     1644      VIEW-AS ALERT-BOX ERROR.
     1645      UNDO, RETURN NO-APPLY.
     1646    END.
     1647    FIND FIRST buf_clients NO-LOCK WHERE
     1648                buf_clients.obj-type = rs-new-obj-type
     1649           AND  buf_clients.obj-code = f-new-obj-code
     1650        NO-ERROR.
     1651     IF NOT AVAILABLE buf_clients THEN DO:
     1652       MESSAGE
     1653       substitute("Не найден объект с кодом/типом (НОВЫМ) &1&2"
     1654                  , rs-new-obj-type
     1655                  , f-new-obj-code)
     1656       VIEW-AS ALERT-BOX ERROR.
     1657       UNDO, RETURN NO-APPLY.
     1658    END.
     1659   if buf_clients.host-code <> buf_sysconf.host-code then do:
     1660       MESSAGE
     1661       substitute("Объект с кодом/типом (НОВЫМ) &1&2 НЕ принадлежит фирме &3"
     1662                  , rs-new-obj-type
     1663                  , f-new-obj-code
     1664                  , f-new-host-code
     1665                  )
     1666       VIEW-AS ALERT-BOX ERROR.
     1667       UNDO, RETURN NO-APPLY.
     1668   end.
     1669   IF f-old-host-code = 0  THEN DO:
     1670      MESSAGE
     1671      "Не заполнен СТАРЫЙ код фирмы"
     1672      VIEW-AS ALERT-BOX ERROR.
     1673       UNDO, RETURN NO-APPLY.
     1674   END.
     1675   IF f-old-obj-code = 0  THEN DO:
     1676       MESSAGE
     1677       "Не заполнен СТАРЫЙ код объекта"
     1678       VIEW-AS ALERT-BOX ERROR.
     1679        UNDO, RETURN NO-APPLY.
     1680   END.
     1681     if sys-ctrl.db-num <> 0
     1682       and T-cdrg <> no
     1683     then do:
     1684       MESSAGE
     1685       "Импортировать ДИАПАЗОНЫ ВЕСОВЫХ КОДОВ можно только в ГБД"
     1686       VIEW-AS ALERT-BOX ERROR.
     1687        UNDO, RETURN NO-APPLY.
     1688     end.
     1689     run waitfram-show in this-procedure ( input "Ждите..." ).
     1690     run proc-b-ie in this-procedure ( input "import":U).
     1691     run waitfram-hide in this-procedure .
     1692   END.
     1693   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     1694   DO:
     1695     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1696     DEFINE VARIABLE v-rowid AS rowid NO-UNDO.
     1697     DEFINE VARIABLE v-tbl-name AS CHARACTER NO-UNDO.
     1698     DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     1699     DEFINE BUFFER buf_clients FOR ub.clients.
     1700     run utl/thth-cli.w ( input parparentproc
     1701                         ,input "b-sel"
     1702                         ,input 'объект':U
     1703                         ,input-output v-rid-list) no-error.
     1704     IF v-rid-list <> '' THEN DO:
     1705         FIND FIRST buf_ext-classif NO-LOCK WHERE
     1706               RECID(buf_ext-classif) = INTEGER(v-rid-list) NO-ERROR.
     1707         IF buf_ext-classif.uniq-key-rec = '' THEN DO:
     1708            MESSAGE
     1709            "Еще не установлено соответствие для этого объекта"
     1710            VIEW-AS ALERT-BOX ERROR.
     1711            RETURN NO-APPLY.
     1712         END.
     1713         ASSIGN
     1714         f-old-host-code = buf_ext-classif.key#_two
     1715         rs-old-obj-type = buf_ext-classif.charkey_one
     1716         f-old-obj-code = buf_ext-classif.key#_one
     1717         .
     1718           RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT buf_ext-classif.uniq-key-rec
     1719                                         ,input ?
     1720                                         ,INPUT "ub"
     1721                                         ,INPUT ?
     1722                                         ,INPUT NO-LOCK
     1723                                         ,OUTPUT v-rowid
     1724                                         ,OUTPUT v-tbl-name) no-error.
     1725        FIND FIRST buf_clients NO-LOCK WHERE
     1726                   ROWID(buf_clients) = v-rowid.
     1727        ASSIGN
     1728        f-new-host-code = buf_clients.host-code
     1729        rs-new-obj-type = buf_clients.obj-type
     1730        f-new-obj-code = buf_clients.obj-code
     1731        .
     1732        DISPLAY
     1733        f-old-host-code
     1734        rs-old-obj-type
     1735        f-old-obj-code
     1736        f-new-host-code
     1737        rs-new-obj-type
     1738        f-new-obj-code
     1739        WITH FRAME Dialog-Frame.
     1740     END.
     1741   END.
     1742   ON VALUE-CHANGED OF T-usr IN FRAME Dialog-Frame
     1743   DO:
     1744     ASSIGN
     1745     t-usr.
     1746   END.
     1747   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1748   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1749   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1750   on help of frame Dialog-Frame
     1751   do:
     1752     run gbl/app_help.p
     1753       (input this-procedure :file-name
     1754       ,input ''
     1755       ,input ?
     1756       ) no-error.
     1757     if error-status :error then do:
     1758       message
     1759         "Ошибка при вызове помощи"
     1760         error-status :get-message(1)
     1761         view-as alert-box .
     1762     end.
     1763   end.
     1764   run minbtn-set in this-procedure .
     1765   on choose of b-help in frame Dialog-Frame
     1766   do:
     1767     apply "help":u to frame Dialog-Frame .
     1768   end.
     1769   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1770   procedure minbtn-set :
     1771       do
     1772           on error undo, return error return-value
     1773           :
     1774           define variable ii              as integer       no-undo .
     1775           define variable fh              as widget-handle no-undo .
     1776           define variable hh              as widget-handle no-undo .
     1777           define variable v-h             as handle        extent 4 no-undo .
     1778           define variable v-name-button   as character     no-undo .
     1779           define variable v-help-old-x    as decimal       no-undo .
     1780           define variable v-help-old-y    as decimal       no-undo .
     1781           define variable v-help-old-size as decimal       no-undo .
     1782           define variable v-frame-width   as decimal       no-undo .
     1783           define variable jj              as integer       no-undo .
     1784           do
     1785               on error undo, return error
     1786               :
     1787               assign
     1788                   v-frame-width = frame Dialog-Frame:width - 0.3
     1789                   fh            = frame Dialog-Frame:first-child
     1790                   hh            = fh:first-child
     1791                   ii            = 1
     1792                   .
     1793               do while valid-handle(hh):
     1794                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1795                   do:
     1796                       case lc(hh:name) :
     1797                           when "b-help" then
     1798                               do:
     1799                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1800                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1801                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1802                                   hh:TOOLTIP = "Помощь" .
     1803                                   v-help-old-x = hh:column .
     1804                                   v-help-old-y = hh:row    .
     1805                                   v-help-old-size = hh:width .
     1806                                   hh:width-chars = 2.5 .
     1807                               end.
     1808                           when "b-print" then
     1809                               do:
     1810                                   hh:load-image("cmp/b-print.bmp":u) .
     1811                                   hh:TOOLTIP = "Печать" .
     1812                                   v-h[ii] = hh:handle .
     1813                                   ii = ii + 1 .
     1814                                   hh:width-chars = 3 .
     1815                               end.
     1816                           when "b-history" or
     1817                           when "b-hist" then
     1818                               do:
     1819                                   hh:load-image("cmp/b-hist.bmp":u) .
     1820                                   hh:TOOLTIP = "История" .
     1821                                   v-h[ii] = hh:handle .
     1822                                   ii = ii + 1 .
     1823                                   hh:width-chars = 3 .
     1824                               end.
     1825                           when "b-sch" then
     1826                               do:
     1827                                   hh:load-image("cmp/b-sch.bmp":u) .
     1828                                   hh:TOOLTIP = "Установка Фильтра" .
     1829                                   v-h[ii] = hh:handle .
     1830                                   ii = ii + 1 .
     1831                                   hh:width-chars = 3 .
     1832                               end.
     1833                           when "b-hist-user" then
     1834                               do:
     1835                                   hh:load-image("cmp/b-hist.bmp":u) .
     1836                                   hh:TOOLTIP = "История пользователя" .
     1837                                   ii = ii + 1 .
     1838                               end.
     1839                       end case.
     1840                   end.
     1841                   hh = hh:next-sibling.
     1842               end.
     1843               b-help:column = v-frame-width - b-help:width-chars.
     1844               jj = 0.
     1845               repeat ii = 4 to 1 by -1 :
     1846                   if valid-handle (v-h[ii] ) then
     1847                   do:
     1848                       jj  = jj + 1 .
     1849                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1850                       v-h[ii]:row    = v-help-old-y .
     1851                   end.
     1852               end.
     1853           end.
     1854       end.
     1855   end procedure.
     1856   MAIN-BLOCK:
     1857   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1858      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1859       file-info:file-name = ".".
     1860       assign
     1861       dir-name = file-info:full-pathname
     1862       v_os-dir-type = file-info :file-type
     1863       v_can-write = (index(v_os-dir-type, "W") > 0)
     1864      .
     1865     FIND FIRST sys-ctrl No-LOCK.
     1866     FIND FIRST db no-LOCK where
     1867                db.db-num = sys-ctrl.db-num.
     1868     assign
     1869       f-rht  = corr-file-name(db.db-key) + ".":U +   "rht"
     1870       F-flt  = corr-file-name(db.db-key) + ".":U +   "flt"
     1871       F-thb  = corr-file-name(db.db-key) + ".":U +   "thb"
     1872       F-pbc  = corr-file-name(db.db-key) + ".":U +   "pbc"
     1873       F-scl  = corr-file-name(db.db-key) + ".":U +   "scl"
     1874       F-usr  = corr-file-name(db.db-key) + ".":U +   "usr"
     1875       F-gen  = corr-file-name(db.db-key) + ".":U +   "gen"
     1876       F-seq  = corr-file-name(db.db-key) + ".":U +   "seq"
     1877       F-cdrg = corr-file-name(db.db-key) + ".":U +   "cdr"
     1878       F-cdk  = corr-file-name(db.db-key) + ".":U +   "cdk"
     1879       F-pet  = corr-file-name(db.db-key) + ".":U +   "pet"
     1880       .
     1881     rs-old-obj-type:RADIO-BUTTONS IN FRAME Dialog-Frame =
     1882         'маг':U + chr(44) + 'маг':U + chr(44) +
     1883         'скл':U + chr(44) + 'скл':U
     1884         .
     1885     rs-new-obj-type:RADIO-BUTTONS IN FRAME Dialog-Frame =
     1886         'маг':U + chr(44) + 'маг':U + chr(44) +
     1887   'скл':U + chr(44) + 'скл':U .
     1888     rs-old-obj-type = 'маг':U.
     1889     rs-new-obj-type = 'маг':U.
     1890     RUN enable_UI.
     1891     WAIT-FOR GO OF FRAME Dialog-Frame.
     1892   END.
     1893   RUN disable_UI.
     1894   PROCEDURE check-iefile :
     1895   DEFINE INPUT PARAMETER p-dir-name as character no-undo.
     1896   DEFINE INPUT PARAMETER p-file-extension as character no-undo.
     1897   DEFINE INPUT PARAMETER p-mode as character no-undo.
     1898   define output parameter p-ok as logical no-undo.
     1899   define variable full_name as character no-undo.
     1900   FIND FIRST sys-ctrl No-LOCK.
     1901   FIND FIRST db no-LOCK where
     1902               db.db-num = sys-ctrl.db-num.
     1903   if not avail db then do:
     1904       message "Отсутствует информация в таблице db"
     1905       view-as alert-box ERROR.
     1906       return error.
     1907   end.
     1908   full_name = dir-name + "\":U + corr-file-name(db.db-key) + "." + p-file-extension.
     1909   if p-mode = "import":U then do:
     1910       if search(full_name) = ? then do:
     1911       message "Не найден файл данных" full_name  skip
     1912                           "для импорта"
     1913           view-as alert-box ERROR.
     1914           p-ok = no.
     1915           return.
     1916       end.
     1917       p-ok = yes.
     1918       return.
     1919   end.
     1920   if p-mode = "export":U then do:
     1921       if search(full_name) <> ? then do:
     1922       message "Уже имеется в выбранной директории файл с именем" full_name  skip
     1923               "совпадающим с именем одного из файлов экспорта" skip
     1924               "Перезаписывать?"
     1925       view-as alert-box QUESTION buttons YES-NO update p-ok.
     1926       return.
     1927     end.
     1928     p-ok = yes.
     1929     return.
     1930   end.
     1931   END PROCEDURE.
     1932   PROCEDURE disable_UI :
     1933     HIDE FRAME Dialog-Frame.
     1934   END PROCEDURE.
     1935   PROCEDURE enable_UI :
     1936     DISPLAY T-pbc T-glb T-scl T-cdk T-usr T-flt T-pet f-old-host-code
     1937             f-new-host-code Rs-old-obj-type Rs-new-obj-type f-old-obj-code
     1938             f-new-obj-code dir-name F-pbc F-scl F-cdk F-usr F-flt F-pet
     1939         WITH FRAME Dialog-Frame.
     1940     ENABLE B-exit B-import B-Help RECT-groups B-dir T-pbc T-glb T-scl T-cdk T-usr
     1941            T-flt T-pet B-obj dir-name F-pbc F-scl F-cdk F-usr F-flt F-pet
     1942         WITH FRAME Dialog-Frame.
     1943     VIEW FRAME Dialog-Frame.
     1944   END PROCEDURE.
     1945   PROCEDURE proc-b-ie :
     1946   define input parameter p-mode as character no-undo.
     1947    define variable ii as integer no-undo.
     1948    define variable loc#log as logical no-undo.
     1949    define variable file-extensions as char format "X(3)" no-undo init "rht,gen,flt,pbc,scl,usr,seq,cdr,cdk,thb,pet":U.
     1950    define variable t-vals as logical no-undo extent 11.
     1951    define variable v-proc-name as character no-undo .
     1952    define variable v-proc-title as character no-undo .
     1953    define variable v-param as character no-undo .
     1954    define variable v-choice as integer no-undo .
     1955    define variable glog as logical no-undo .
     1956    assign
     1957    dir-name
     1958    frame Dialog-Frame
     1959    T-flt
     1960    t-pbc
     1961    T-scl
     1962    T-usr
     1963    T-seq  = no
     1964    t-glb
     1965    t-cdk
     1966    t-thb
     1967    t-pet
     1968    .
     1969    if (t-cdk
     1970    or t-pet
     1971    or t-thb)
     1972    and p-mode = "export"  then do:
     1973      message
     1974      "Данные о кассах и/или конфигурации АЗК и/или ПАРАМЕТРАХ доступны только для ИМПОРТА"
     1975      view-as alert-box error .
     1976      run waitfram-hide in this-procedure .
     1977      undo, return error .
     1978    end.
     1979    assign
     1980    t-vals[2]  = no
     1981    t-vals[3]  = t-flt
     1982    t-vals[1]  = no
     1983    t-vals[4]  = t-pbc
     1984    t-vals[5]  = t-scl
     1985    t-vals[6]  = t-usr
     1986    t-vals[7]  = t-seq
     1987    t-vals[8] = no
     1988    t-vals[9]  = t-cdk
     1989    t-vals[10]  = t-thb
     1990    t-vals[11]  = t-pet
     1991    .
     1992    if dir-name = "" then do:
     1993       message "Не задана директория для файлов экспорта/импорат"
     1994       view-as alert-box ERROR.
     1995       return error.
     1996    end.
     1997    DO ii = 1 to num-entries(file-extensions):
     1998       if t-vals[ii] then do:
     1999           run check-iefile in this-procedure (
     2000                                              input dir-name
     2001                                              ,input entry(ii, file-extensions)
     2002                                              ,input p-mode
     2003                                              ,output loc#log).
     2004           if not loc#log then  return no-apply.
     2005       end.
     2006     end.
     2007     assign
     2008     v-param = string(T-vals[1])  + chr(4) +
     2009               string(T-vals[2])  + chr(4) +
     2010               string(T-vals[3])  + chr(4) +
     2011               string(T-vals[4])  + chr(4) +
     2012               string(T-vals[5])  + chr(4) +
     2013               string(T-vals[6])  + chr(4) +
     2014               string(T-vals[7])  + chr(4) +
     2015               string(T-vals[8]) + chr(4) +
     2016               string(T-vals[9]) + chr(4) +
     2017               string(T-vals[10]) + chr(4) +
     2018               (if p-mode = "import"
     2019               then (string(T-vals[11]) + chr(4))
     2020               else '') +
     2021               corr-file-name(db.db-key)  + chr(4) +
     2022               dir-name                   + chr(4) +
     2023               string(T-glb)
     2024               .
     2025     if p-mode = "export":U then do:
     2026       assign
     2027       v-proc-name = "utl/impxexpe.p"
     2028       v-proc-title = "Экспорт локальных таблиц БД"
     2029       .
     2030     end.
     2031     else do:
     2032       MESSAGE
     2033       "ПРОВЕРЬТЕ ЕЩЕ РАЗ ЗНАЧЕНИЯ СТАРЫХ И НОВЫХ КОДОВ ФИРМ И ОБЪЕКТОВ!" SKIP
     2034       "ПРОДОЛЖИТЬ?"
     2035       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     2036       IF NOT glog  THEN RETURN.
     2037       assign
     2038       v-param = v-param + chr(4) +
     2039               replace(p-from-version, "v", "") + chr(4) +
     2040               STRING(f-old-host-code) + chr(4) +
     2041               STRING(f-new-host-code) + chr(4) +
     2042               rs-old-obj-type + chr(4) +
     2043               rs-new-obj-type + chr(4) +
     2044               STRING(f-old-obj-code) + chr(4) +
     2045               STRING(f-new-obj-code) + chr(4) +
     2046               p-from-version
     2047       v-proc-name = "utl/impxexpi.p"
     2048       v-proc-title = "Импорт локальных таблиц БД"
     2049       .
     2050     end.
     2051     run str/diallog.w (
     2052             input parparentproc
     2053           , input this-procedure
     2054           , input v-proc-name
     2055           , input v-param
     2056           , input no
     2057           , input "":U
     2058           , input v-proc-title
     2059       ) no-error.
     2060     if error-status:error then do:
     2061       message
     2062       error-status:get-message(1) skip
     2063       return-value
     2064       view-as alert-box error.
     2065     end.
     2066   END PROCEDURE.
