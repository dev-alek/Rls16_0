        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":u .
        3   define variable vss-author      as character no-undo init "$Author$":u .
        4   define variable vss-date        as character no-undo init "$Date$":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        6   define variable vss-archive     as character no-undo init "$Archive$":u .
        7   define variable vss-description as character no-undo init "тест корректности отчета о продаже - накладные- чеки" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable c-point  as character no-undo .
       70   define variable tbl      as character no-undo .
       71   define variable join-tbl as character no-undo .
       72   define variable fld      as character no-undo .
       73   define variable lab      as character no-undo .
       74   define variable spr      as character no-undo .
       75   define variable dim      as character no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define variable v-waitfram-action01         as character   no-undo .
       78   define variable v-waitfram-action02         as character   no-undo .
       79   define variable v-waitfram-action03         as character   no-undo .
       80   define variable mWaitFramTextBeg            as character   no-undo.
       81   define variable mWaitFramTextEnd            as character   no-undo.
       82   define variable mWaitFramView               as logical     no-undo.
       83   define variable mWaitProcEvent              as logical     no-undo init yes.
       84   define variable mWaitFramInterval           as integer     no-undo init 1 .
       85   define variable mWaitFramStop               as logical     no-undo.
       86   define variable mWaitFramStopUser           as logical     no-undo.
       87   define variable mWaitFramStopTimeOut        as logical     no-undo.
       88   define variable mWaitFramStartProc          as datetime-tz no-undo.
       89   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       90   define button B-WaitFramStop auto-end-key
       91        label "Стоп"
       92        size 10 by 1 tooltip "Остоновить процесс".
       93   define button B-viewProcInfo
       94        label "Информация"
       95        size 15 by 1 tooltip "Информация о процесс".
       96   define frame waitfram
       97     v-waitfram-action01 format "x(72)" no-label skip
       98     v-waitfram-action02 format "x(72)" no-label skip
       99     v-waitfram-action03 format "x(72)" no-label skip
      100     B-viewProcInfo
      101     B-WaitFramStop at row 4 col 30
      102     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      103     .
      104   define new global shared variable mBatchMode as logical no-undo init ?.
      105   define variable mFramBachModHandle as handle no-undo.
      106   mFramBachModHandle = frame waitfram:handle.
      107   define variable mFameOldVis as logical no-undo.
      108   define variable mVisCUrentVin as logical no-undo.
      109   if session:batch-mode
      110   then
      111      mBatchMode = yes.
      112   if mBatchMode = ? then do:
      113     mVisCUrentVin = current-window:visible.
      114     mFameOldVis = mFramBachModHandle:visible.
      115     mFramBachModHandle:visible  = yes.
      116     mBatchMode = mFramBachModHandle:visible ne yes.
      117     mFramBachModHandle:visible = mFameOldVis.
      118     current-window:visible = mVisCUrentVin.
      119   end.
      120    if  log-manager:logfile-name ne ?
      121     then DO:
      122         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      123         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      124         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      125     end.
      126   on choose of B-WaitFramStop in frame waitfram
      127   do:
      128     mWaitFramStop = yes.
      129     mWaitFramStopUser = yes.
      130   end.
      131   function waitfram-check-timeout returns logical():
      132      define variable vtime as int64 no-undo.
      133      if mWaitFramStopTimeOut
      134      then
      135         return yes.
      136      vtime = ( now - mWaitFramStartProc ) / 1000 .
      137      if     mWaitFramTimeOut ne ?
      138         and mWaitFramTimeOut ne 0
      139         and mWaitFramTimeOut lt vtime
      140      then do:
      141         mWaitFramStopTimeOut = yes.
      142      end.
      143      return mWaitFramStopTimeOut.
      144   end.
      145   procedure waitfram-hide :
      146     if not session:batch-mode
      147     then do
      148     on error undo, return error return-value
      149     :
      150       pause 0 before-hide .
      151       if not mBatchMode then
      152         hide frame waitfram .
      153     if     not mWaitFramView
      154        and mWaitProcEvent
      155     then
      156       process events .
      157     end.
      158   end procedure.
      159   procedure waitfram-show :
      160     define input  parameter p-message as character no-undo .
      161     define variable v-left-margin as integer   no-undo .
      162     if not session:batch-mode
      163     then do
      164     on error undo, return error return-value
      165     :
      166       if length(p-message) <= 70 then do:
      167         assign
      168           v-left-margin = integer((70 - length(p-message)) / 2)
      169         .
      170         assign
      171           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      172         .
      173         assign
      174           v-waitfram-action01 = " "
      175           v-waitfram-action02 = " "
      176                                    + fill(" ", v-left-margin)
      177                                    + p-message
      178           v-waitfram-action03 = " "
      179         .
      180       end.
      181       else do:
      182         define variable vRindex1 as integer no-undo.
      183         define variable vRindex2 as integer no-undo.
      184         vRindex1 = r-index(p-message," ",70).
      185         if vRindex1 = 0
      186         then
      187            vRindex1 = 70.
      188         if length(p-message)  <= vRindex1 + 70 then do:
      189           assign
      190             v-waitfram-action01 = " "
      191             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      193           .
      194         end.
      195         else do:
      196           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      197           if vRindex2 <= vRindex1
      198           then
      199              vRindex2 = vRindex1 + 70.
      200           assign
      201             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      202             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      203             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      204           .
      205         end.
      206       end.
      207       B-viewProcInfo:visible   in frame waitfram = no.
      208       B-viewProcInfo:sensitive in frame waitfram = no.
      209       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      210       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      211       if  (   mWaitFramView
      212          or  mWaitProcEvent)
      213          and not mBatchMode
      214       then
      215          display
      216             v-waitfram-action01 skip
      217             v-waitfram-action02 skip
      218             v-waitfram-action03 skip
      219          with frame waitfram .
      220       if     mWaitFramView
      221          then do:
      222             if     mWaitFramInterval ne ?
      223                and not mBatchMode
      224             then
      225                wait-for go of frame waitfram pause mWaitFramInterval.
      226          end.
      227          else
      228             if     mWaitProcEvent
      229                and not mBatchMode
      230             then
      231                process events .
      232     end.
      233   end procedure.
      234      procedure waitfram-show-this:
      235         define input  parameter iInterval as int64 no-undo.
      236         define variable vtime as int64 no-undo.
      237         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      238         mWaitFramInterval = iInterval.
      239         run waitfram-show (substitute("&1&2 &3&4" ,
      240                                       mWaitFramTextBeg ,
      241                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      242                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      243                                       mWaitFramTextEnd
      244                                      )
      245                           ).
      246      end.
      247      procedure WaitFramRunPause:
      248         define input  parameter iInterval as dec no-undo.
      249         define variable vStart  as datetime-tz no-undo.
      250         define variable vend    as datetime-tz no-undo.
      251         define variable vint as int64 no-undo.
      252         define variable vOk as logical no-undo.
      253         vStart = now.
      254         vend   = vStart.
      255         publish "WaitFramPause" (iInterval,output vOk).
      256         vend   =  now.
      257         vint = vend - vStart.
      258         vint = iInterval - vint / 1000.
      259         if     not mWaitFramStop
      260            and (   vint > 0
      261                 or (    not vOk
      262                     and iInterval eq ?
      263                     )
      264                 )
      265         then
      266            run waitfram-show-this (iInterval).
      267         vend   =  now.
      268         vint = vend - vStart.
      269         vint = iInterval - vint / 1000.
      270         if     not mWaitFramStop
      271            and vint > 0
      272         then do:
      273            run gbl/pause.p (vint * 1000).
      274         end.
      275         if iInterval ne ?
      276         then
      277            publish "WaitFramStop".
      278         waitfram-check-timeout().
      279      end.
      280      procedure WaitFramWaitFor:
      281         define input  parameter iInterval as dec no-undo.
      282         assign
      283            mWaitFramStartProc   = now
      284            mWaitFramStopUser    = no
      285            mWaitFramStopTimeOut = no
      286         .
      287         block-wait:
      288         do while not mWaitFramStop:
      289            run WaitFramRunPause (iInterval).
      290            if  waitfram-check-timeout()
      291            then do:
      292               leave block-wait.
      293            end.
      294         end.
      295         run waitfram-hide.
      296      end.
      297   procedure waitfram-join :
      298     define input  parameter p-line-1  as character no-undo .
      299     define input  parameter p-line-2  as character no-undo .
      300     define input  parameter p-line-3  as character no-undo .
      301     define output parameter p-message as character no-undo .
      302     do
      303     on error undo, return error return-value
      304     :
      305       assign
      306         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      307                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      308                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      309       .
      310     end.
      311   end procedure.
      312   function waitfram-join-function returns character
      313     (input p-line-1 as character
      314     ,input p-line-2 as character
      315     ,input p-line-3 as character
      316     ).
      317     define variable v-message as character no-undo .
      318     run waitfram-join in this-procedure
      319       (input  p-line-1
      320       ,input  p-line-2
      321       ,input  p-line-3
      322       ,output v-message
      323       ) .
      324     return v-message .
      325   end function .
      326   procedure proc-alt-shift-f2:
      327     if not ibs.th.gbl.gbl-var:rcode
      328   then
      329     run gbl\inidebug.p .
      330   end.
      331   procedure proc-alt-shift-f3:
      332     run gbl/prvssinf.p
      333       ( input this-procedure
      334       ) .
      335   end.
      336   define variable v-inform-launched as logical no-undo initial false .
      337   procedure proc-alt-shift-f4:
      338     define variable v-action as character no-undo .
      339     if v-inform-launched = false then do:
      340       assign
      341         v-inform-launched = true
      342       .
      343       run gbl/d-inform.w
      344         (  input self
      345         ,  input this-procedure
      346         , output v-action
      347         ) no-error .
      348       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      349       assign
      350         v-inform-launched = false
      351       .
      352     end.
      353   end.
      354   procedure proc-alt-f1:
      355     run gbl/corrhelp.p
      356       (input this-procedure
      357       ) .
      358   end .
      359   on alt-shift-f2 anywhere do:
      360     run proc-alt-shift-f2.
      361   end.
      362   on alt-shift-f3 anywhere do:
      363     run proc-alt-shift-f3 in this-procedure .
      364   end.
      365   on alt-shift-f4 anywhere do:
      366     run proc-alt-shift-f4 in this-procedure.
      367   end.
      368   on alt-f1 anywhere do:
      369     run proc-alt-f1 in this-procedure .
      370   end.
      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372     define variable v-cntxt-db-num        as integer   no-undo .
      373     define variable v-cntxt-userid        as character no-undo .
      374     define variable v-cntxt-level         as character no-undo .
      375     define variable v-cntxt-host-code-obj as integer   no-undo .
      376     define variable v-cntxt-obj-type      as character no-undo .
      377     define variable v-cntxt-obj-code      as integer   no-undo .
      378     define variable v-cntxt-db-num-obj    as integer   no-undo .
      379     define variable v-cntxt-is-admin      as logical   no-undo .
      380   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   define new global shared variable g#trdcalib as handle no-undo.
      382   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   FUNCTION set-inkas-PS returns character(    input p-ps as character,
      384                                               input p-chk-amount as integer,
      385                                               input p-gds-amount as integer,
      386                                               input p-line-out as integer,
      387                                               input p-dtl-out as integer,
      388                                               input p-line-ret as integer,
      389                                               input p-dtl-ret as integer,
      390                                               input p-nf-chk-amount as integer,
      391                                               input p-nf-gds-amount as integer,
      392                                               input p-ps-where-rus as character
      393                                               ):
      394   define variable v-ps as character no-undo .
      395   define variable v-other as character no-undo .
      396   v-other = p-ps.
      397   entry(1, v-other, "@") = ''.
      398   v-other = trim(v-other, "@").
      399   v-PS = substitute('Кол-во_чеков &2&1строк_чеков &3&1товаров_расход &4&1признаков_расход &5&1товаров_возврат &6&1признаков_возврат &7&1'
      400                       , chr(4)
      401                       , p-chk-amount
      402                       , p-gds-amount
      403                       , p-line-out
      404                       , p-dtl-out
      405                       , p-line-ret
      406                       , p-dtl-ret).
      407   v-ps = v-ps +  substitute("без_докум_чеков &1&2без_докум_строк_чеков &3&2&4@&5"
      408                               , p-nf-chk-amount
      409                               , chr(4)
      410                               , p-nf-gds-amount
      411                               , p-ps-where-rus
      412                               , v-other)
      413                       .
      414   return v-ps.
      415   END FUNCTION.
      416   FUNCTION set-inkas-PS-simple returns character(
      417                                               input p-chk-amount as integer,
      418                                               input p-gds-amount as integer,
      419                                               input p-line-out as integer,
      420                                               input p-dtl-out as integer,
      421                                               input p-line-ret as integer,
      422                                               input p-dtl-ret as integer,
      423                                               input p-nf-chk-amount as integer,
      424                                               input p-nf-gds-amount as integer
      425                                               ):
      426   define variable v-ps as character no-undo .
      427   define variable v-str1 as character no-undo .
      428   assign
      429     v-ps = fill( chr(32) +  chr(4), 9).
      430     v-str1 = ENTRY(1, v-PS, chr(4)).
      431     entry(2, v-str1, chr(32))  = string(p-chk-amount).
      432     ENTRY(1, v-PS, chr(4)) = v-str1.
      433     v-str1 = ENTRY(2, v-PS, chr(4)).
      434     entry(2, v-str1, chr(32))  = string(p-gds-amount).
      435     ENTRY(2, v-PS, chr(4)) = v-str1.
      436     v-str1 = ENTRY(3, v-PS, chr(4)).
      437     entry(2, v-str1, chr(32))  = string(p-line-out).
      438     ENTRY(3, v-PS, chr(4)) = v-str1.
      439     v-str1 = ENTRY(4, v-PS, chr(4)).
      440     entry(2, v-str1, chr(32))  = string(p-dtl-out).
      441     ENTRY(4, v-PS, chr(4)) = v-str1.
      442     v-str1 = ENTRY(5, v-PS, chr(4)).
      443     entry(2, v-str1, chr(32))  = string(p-line-ret).
      444     ENTRY(5, v-PS, chr(4)) = v-str1.
      445     v-str1 = ENTRY(6, v-PS, chr(4)).
      446     entry(2, v-str1, chr(32))  = string(p-dtl-ret).
      447     ENTRY(5, v-PS, chr(4)) = v-str1.
      448     v-str1 = ENTRY(7, v-PS, chr(4)).
      449     entry(2, v-str1, chr(32))  = string(p-nf-chk-amount).
      450     ENTRY(5, v-PS, chr(4)) = v-str1.
      451     v-str1 = ENTRY(8, v-PS, chr(4)).
      452     entry(2, v-str1, chr(32))  = string(p-nf-gds-amount).
      453     ENTRY(5, v-PS, chr(4)) = v-str1.
      454   return v-ps.
      455   END FUNCTION.
      456   FUNCTION get-inkas-nf-PS-simple returns logical (
      457                                                input p-ps as character
      458                                               ,output p-gds-amount as integer
      459                                               ,output p-nf-gds-amount as integer
      460                                               ):
      461   if num-entries(p-ps, chr(4)) >= 8 then do:
      462     assign
      463     p-gds-amount = integer(entry(2, ENTRY(2, p-PS, chr(4)), chr(32)))
      464     p-nf-gds-amount = integer(entry(2, ENTRY(8, p-PS, chr(4)), chr(32)))
      465     no-error .
      466   end.
      467   return not error-status:error .
      468   END FUNCTION.
      469   PROCEDURE get-inkas-PS:
      470   define parameter buffer buf_inkas for ub.inkas.
      471   define output parameter p-chk-amount as integer no-undo .
      472   define output parameter p-gds-amount as integer no-undo .
      473   define output parameter p-line-out as integer no-undo .
      474   define output parameter p-dtl-out as integer no-undo .
      475   define output parameter p-line-ret as integer no-undo .
      476   define output parameter p-dtl-ret as integer no-undo .
      477   define output parameter p-nf-chk-amount as integer no-undo .
      478   define output parameter p-nf-gds-amount as integer no-undo .
      479   define output parameter p-ps-where-rus as character no-undo .
      480   define variable v-gds-amount as integer no-undo .
      481   define variable v-nf-gds-amount as integer no-undo .
      482   define buffer buf_sale-doc for ub.sale-doc.
      483   for each buf_sale-doc no-lock where
      484           buf_sale-doc.inkas-code = buf_inkas.inkas-code
      485       and buf_sale-doc.order > 0:
      486     assign
      487     p-gds-amount = p-gds-amount + (if buf_sale-doc.in-inkas = yes
      488                                    or buf_sale-doc.doc-kind = 'trf':U
      489                                    then buf_sale-doc.gds-amount
      490                                    else 0)
      491     p-line-out = p-line-out  + (if buf_sale-doc.in-inkas = yes
      492                                 and buf_sale-doc.dir = 1
      493                                 then buf_sale-doc.tot-lines
      494                                 else 0)
      495     p-dtl-out = p-dtl-out + (if buf_sale-doc.in-inkas = yes
      496                             and buf_sale-doc.dir = 1
      497                             then buf_sale-doc.tot-dtl
      498                             else 0)
      499     p-line-ret = p-line-ret  + (if buf_sale-doc.in-inkas = yes
      500                                 and buf_sale-doc.dir = -1
      501                                 then buf_sale-doc.tot-lines
      502                                 else 0)
      503     p-dtl-ret = p-dtl-ret + (if buf_sale-doc.in-inkas = yes
      504                              and buf_sale-doc.dir = -1
      505                             then buf_sale-doc.tot-dtl
      506                             else 0)
      507     .
      508   end.
      509   if get-inkas-nf-PS-simple( input buf_inkas.ps
      510                             ,output v-gds-amount
      511                             ,output v-nf-gds-amount) then do:
      512     assign
      513     p-gds-amount = v-gds-amount
      514     p-nf-gds-amount = v-nf-gds-amount
      515     .
      516   end.
      517   assign
      518   p-ps-where-rus = buf_inkas.sale-filter-rus
      519   p-nf-chk-amount = buf_inkas.num-chk-nf
      520   p-chk-amount = buf_inkas.num-chk
      521   .
      522   END PROCEDURE.
      523   DEFINE NEW SHARED STREAM test.
