      701   ON CHOOSE OF r-sale IN FRAME Dialog-Frame
      702   DO:
      703     DEFINE VARIABLE rid-list as character no-undo .
      704       if v-cntxt-obj-type = 'маг':U then
      705       run str/salelist.w (
      706                           input parparentproc
      707                         ,input "b-sel":U
      708                         ,input "object-all"
      709                         ,input v-cntxt-host-code-obj
      710                         ,input v-cntxt-obj-type
      711                         ,input v-cntxt-obj-code
      712                         ,input-output rid-list) no-error.
      713       else do:
      714         BELL.
      715         message "Не могу вызвать справочник отчетов о продаж, если текущий объект не МАГАЗИН!"
      716         view-as alert-box ERROR.
      717         return no-apply.
      718       end.
      719       if rid-list  <> '':U then do:
      720           find first ub.inkas NO-LOCK WHERE recid(ub.inkas) = integer(rid-list) NO-ERROR.
      721           assign
      722           my-inkas = ub.inkas.inkas-code.
      723           display
      724           my-inkas
      725           WITH FRAME Dialog-Frame.
      726       end.
      727   END.
      728   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      729   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      730   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      731   on help of frame Dialog-Frame
      732   do:
      733     run gbl/app_help.p
      734       (input this-procedure :file-name
      735       ,input ''
      736       ,input ?
      737       ) no-error.
      738     if error-status :error then do:
      739       message
      740         "Ошибка при вызове помощи"
      741         error-status :get-message(1)
      742         view-as alert-box .
      743     end.
      744   end.
      745   run minbtn-set in this-procedure .
      746   on choose of b-help in frame Dialog-Frame
      747   do:
      748     apply "help":u to frame Dialog-Frame .
      749   end.
      750   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      751   procedure minbtn-set :
      752       do
      753           on error undo, return error return-value
      754           :
      755           define variable ii              as integer       no-undo .
      756           define variable fh              as widget-handle no-undo .
      757           define variable hh              as widget-handle no-undo .
      758           define variable v-h             as handle        extent 4 no-undo .
      759           define variable v-name-button   as character     no-undo .
      760           define variable v-help-old-x    as decimal       no-undo .
      761           define variable v-help-old-y    as decimal       no-undo .
      762           define variable v-help-old-size as decimal       no-undo .
      763           define variable v-frame-width   as decimal       no-undo .
      764           define variable jj              as integer       no-undo .
      765           do
      766               on error undo, return error
      767               :
      768               assign
      769                   v-frame-width = frame Dialog-Frame:width - 0.3
      770                   fh            = frame Dialog-Frame:first-child
      771                   hh            = fh:first-child
      772                   ii            = 1
      773                   .
      774               do while valid-handle(hh):
      775                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      776                   do:
      777                       case lc(hh:name) :
      778                           when "b-help" then
      779                               do:
      780                                   hh:load-image-up("cmp/b-help.bmp":u) .
      781                                   hh:load-image-down("cmp/b-help.bmp":u) .
      782                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      783                                   hh:TOOLTIP = "Помощь" .
      784                                   v-help-old-x = hh:column .
      785                                   v-help-old-y = hh:row    .
      786                                   v-help-old-size = hh:width .
      787                                   hh:width-chars = 2.5 .
      788                               end.
      789                           when "b-print" then
      790                               do:
      791                                   hh:load-image("cmp/b-print.bmp":u) .
      792                                   hh:TOOLTIP = "Печать" .
      793                                   v-h[ii] = hh:handle .
      794                                   ii = ii + 1 .
      795                                   hh:width-chars = 3 .
      796                               end.
      797                           when "b-history" or
      798                           when "b-hist" then
      799                               do:
      800                                   hh:load-image("cmp/b-hist.bmp":u) .
      801                                   hh:TOOLTIP = "История" .
      802                                   v-h[ii] = hh:handle .
      803                                   ii = ii + 1 .
      804                                   hh:width-chars = 3 .
      805                               end.
      806                           when "b-sch" then
      807                               do:
      808                                   hh:load-image("cmp/b-sch.bmp":u) .
      809                                   hh:TOOLTIP = "Установка Фильтра" .
      810                                   v-h[ii] = hh:handle .
      811                                   ii = ii + 1 .
      812                                   hh:width-chars = 3 .
      813                               end.
      814                           when "b-hist-user" then
      815                               do:
      816                                   hh:load-image("cmp/b-hist.bmp":u) .
      817                                   hh:TOOLTIP = "История пользователя" .
      818                                   ii = ii + 1 .
      819                               end.
      820                       end case.
      821                   end.
      822                   hh = hh:next-sibling.
      823               end.
      824               b-help:column = v-frame-width - b-help:width-chars.
      825               jj = 0.
      826               repeat ii = 4 to 1 by -1 :
      827                   if valid-handle (v-h[ii] ) then
      828                   do:
      829                       jj  = jj + 1 .
      830                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      831                       v-h[ii]:row    = v-help-old-y .
      832                   end.
      833               end.
      834           end.
      835       end.
      836   end procedure.
      837   MAIN-BLOCK:
      838   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      839      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      840   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841     run mainmenu_getcntxt in parparentproc
      842       (output v-cntxt-db-num
      843       ,output v-cntxt-userid
      844       ,output v-cntxt-level
      845       ,output v-cntxt-host-code-obj
      846       ,output v-cntxt-obj-type
      847       ,output v-cntxt-obj-code
      848       ,output v-cntxt-db-num-obj
      849       ,output v-cntxt-is-admin
      850       ) .
      851   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      853     (output v-curr-r-b
      854     )  .
      855      RUN enable_UI in this-procedure .
      856     WAIT-FOR GO OF FRAME Dialog-Frame.
      857   END.
      858   RUN disable_UI in this-procedure .
      859   PROCEDURE disable_UI :
      860     HIDE FRAME Dialog-Frame.
      861   END PROCEDURE.
      862   PROCEDURE enable_UI :
      863     DISPLAY my-inkas
      864         WITH FRAME Dialog-Frame.
      865     ENABLE b-quit B-Help r-sale my-inkas BUTTON-1 BUTTON-2 BUTTON-3 BUTTON-4
      866            BUTTON-5 BUTTON-6 BUTTON-7
      867         WITH FRAME Dialog-Frame.
      868     VIEW FRAME Dialog-Frame.
      869   END PROCEDURE.
      870   PROCEDURE test0 :
      871   FIND FIRST ub.inkas no-lock where ub.inkas.inkas-code = my-inkas NO-ERROR.
      872   if not avail ub.inkas then do:
      873       message "Нет такой продажи!" view-as alert-box ERROR.
      874       return error.
      875   END.
      876   if ub.inkas.status_ = 'запрос':U then do:
      877     disable
      878     button-2
      879     button-3
      880     with frame Dialog-Frame.
      881   end.
      882   else do:
      883     enable
      884     button-2
      885     button-3
      886     with frame Dialog-Frame .
      887   end.
      888   run value("test" + string(test-number)) IN THIS-PROCEDURE ( INPUT my-inkas) no-error.
      889   run waitfram-hide in this-procedure .
      890   OUTPUT STREAM test close.
      891   END PROCEDURE.
      892   PROCEDURE test1 :
      893   DEFINE INPUT PARAMETER my-inkas LIKE ub.inkas.inkas-code no-undo.
      894   define variable for-num-chk-nf as integer no-undo .
      895   define variable accumq as decimal no-undo.                                  define variable accumc as decimal no-undo.                                  define variable accumall as decimal no-undo.                                define variable accumall1 as decimal no-undo.                               define variable for-netto as decimal no-undo.                               define variable for-discnt as decimal no-undo.                              define variable for-sub-disc as decimal no-undo.                            define variable for-num-chk as integer no-undo.                             define variable for-brutto as decimal no-undo.                              define variable for-netto-r as decimal no-undo.                             define variable for-discnt-r as decimal no-undo.                            define variable for-brutto-r as decimal no-undo.                            define variable for-netto-v as decimal no-undo.                             define variable for-discnt-v as decimal no-undo.                            define variable for-brutto-v as decimal no-undo.                            define variable for-sum as decimal no-undo.                                 define variable for-base as decimal no-undo.                                define variable for-rubl as decimal no-undo.                                define variable newprice as decimal no-undo.                                define variable flag as logical.                                            define variable current-netto as  decimal no-undo.                          define variable current-brutto as  decimal no-undo.                         define variable current-discnt as  decimal no-undo.                         define variable current-write-off as  decimal no-undo.                      define variable for-write-off as  decimal no-undo.                                                                                                      def buffer ret-doc for ub.trn-doc.                                             define buffer buf_sale-doc for ub.sale-doc.                          define buffer locked_trn-doc for ub.trn-doc.
      896   OUTPUT STREAM TEST TO testi1.txt.
      897   _chk-doc:
      898   FOR EACH ub.chk-doc NO-LOCK where ub.chk-doc.out-code = my-inkas :
      899     run waitfram-show in this-procedure ( input "Ждите - идет обработка -  чек " + chk-doc.doc-code).
      900       if lookup(string(chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then do:
      901         for-num-chk-nf = for-num-chk-nf + 1.
      902         for-num-chk = for-num-chk + 1.
      903         NEXT _chk-doc.
      904       end.
      905       assign
      906       for-brutto = for-brutto + chk-doc.tot-doc
      907       for-netto = for-netto + chk-doc.netto
      908       for-discnt = for-discnt + chk-doc.discnt
      909       for-sub-disc = for-sub-disc + chk-doc.sub-discnt
      910       for-num-chk = for-num-chk + 1
      911       .
      912   END.
      913   PUT stream TEST UNFORMATTED
      914   ("СРАВНЕНИЕ ОБЩИХ СУММ ПО ОТЧЕТУ ПРОДАЖЕ " + my-inkas + " И ЧЕКАМ") skip(1)
      915   "Брутто" format "X(22)" space(1)
      916   "Нетто" format "X(22)" space(1)
      917   "Скидка" format "X(22)" space(1)
      918   "Сумма списанного" format "X(22)" space(1)
      919   "Кол-во чеков Общее" format "X(18)" space(1)
      920   "из них вне док-тов" format "X(18)" space(1)
      921   skip
      922   "ОТЧЕТ ПО ПРОДАЖЕ"
      923   skip
      924   ub.inkas.tot-doc format "-999,999,999.999999999" space(1)
      925   ub.inkas.netto format "-999,999,999.999999999" space(1)
      926   ub.inkas.discnt format "-999,999,999.999999999" space(1)
      927   ub.inkas.sub-discnt format "-999,999,999.999999999" space(1)
      928   ub.inkas.num-chk FORMAT "-999,999" space(10)
      929   ub.inkas.num-chk-nf FORMAT "-999,999" space(1)
      930   skip
      931   "ЧЕКИ"
      932   skip
      933   for-brutto format "-999,999,999.999999999" space(1)
      934   for-netto format "-999,999,999.999999999" space(1)
      935   for-discnt format "-999,999,999.999999999" space(1)
      936   for-sub-disc format "-999,999,999.999999999" space(1)
      937   for-num-chk format "-999,999" space(10)
      938   for-num-chk-nf format "-999,999" space(1)
      939   skip
      940   .
      941   run waitfram-hide in this-procedure .
      942   END PROCEDURE.
      943   PROCEDURE test2 :
      944   DEFINE INPUT PARAMETER my-inkas LIKE ub.inkas.inkas-code no-undo.
      945   define variable accumq as decimal no-undo.                                  define variable accumc as decimal no-undo.                                  define variable accumall as decimal no-undo.                                define variable accumall1 as decimal no-undo.                               define variable for-netto as decimal no-undo.                               define variable for-discnt as decimal no-undo.                              define variable for-sub-disc as decimal no-undo.                            define variable for-num-chk as integer no-undo.                             define variable for-brutto as decimal no-undo.                              define variable for-netto-r as decimal no-undo.                             define variable for-discnt-r as decimal no-undo.                            define variable for-brutto-r as decimal no-undo.                            define variable for-netto-v as decimal no-undo.                             define variable for-discnt-v as decimal no-undo.                            define variable for-brutto-v as decimal no-undo.                            define variable for-sum as decimal no-undo.                                 define variable for-base as decimal no-undo.                                define variable for-rubl as decimal no-undo.                                define variable newprice as decimal no-undo.                                define variable flag as logical.                                            define variable current-netto as  decimal no-undo.                          define variable current-brutto as  decimal no-undo.                         define variable current-discnt as  decimal no-undo.                         define variable current-write-off as  decimal no-undo.                      define variable for-write-off as  decimal no-undo.                                                                                                      def buffer ret-doc for ub.trn-doc.                                             define buffer buf_sale-doc for ub.sale-doc.                          define buffer locked_trn-doc for ub.trn-doc.
      946   OUTPUT STREAM TEST TO testi2.txt.
      947   PUT stream TEST UNFORMATTED
      948   ("СРАВНЕНИЕ СУММ ПЛАТЕЖЕЙ ПО ОТЧЕТУ ПО ПРОДАЖЕ " + my-inkas + " И ЧЕКАМ") skip(1)
      949   space(16)
      950   "Код платежа" format "X(11)" space(1)
      951   "Код валюты " format "X(11)" space(1)
      952   "Баз.вал." format "X(15)" space(1)
      953   "Рубли" format "X(15)" space(1)
      954   "Валюта платежа" format "X(15)" space(1)
      955   "Ошибка кода оплаты" format "X(20)"
      956   skip
      957   .
      958   _chk-pay:
      959   FOR EACH ub.chk-pay No-LOCK WHERE
      960           ub.chk-pay.out-code = my-inkas use-index out-sale,
      961       first ub.chk-doc no-lock where
      962            ub.chk-doc.doc-code = ub.chk-pay.doc-code
      963   break
      964   by ub.chk-pay.pay-code
      965   by ub.chk-pay.curr-code:
      966     run waitfram-show in this-procedure ( input "Ждите - идет обработка -  чек " + chk-pay.doc-code).
      967     if first-of(chk-pay.curr-code) then do:
      968       assign
      969       for-base = 0
      970       for-rubl = 0
      971       for-sum = 0
      972       flag = no
      973       .
      974       FIND FIRST ub.inkas-pay NO-LOCK WHERE
      975                 ub.inkas-pay.inkas-code = my-inkas
      976            AND  ub.inkas-pay.pay-code = chk-pay.pay-code
      977            AND  ub.inkas-pay.curr-code = chk-pay.curr-code No-ERROR.
      978       if not avail ub.inkas-pay then flag = yes.
      979       else flag = no.
      980     end.
      981     if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then NEXT _chk-pay.
      982     assign
      983     for-base = for-base + ub.chk-pay.tot-base
      984     for-rubl = for-rubl + ub.chk-pay.tot-rubl
      985     for-sum = for-sum + ub.chk-pay.tot-sum
      986     .
      987     if last-of(ub.chk-pay.curr-code) then do:
      988         PUT stream TEST UNFORMATTED
      989         space(16)
      990         chk-pay.pay-code format "9999" space(8)
      991         chk-pay.curr-code format "99999" space(7)
      992         skip(0)
      993         "ОПЛАТЫ ПО ПРОДАЖЕ" format "X(15)" space(1)
      994         space(12)
      995         space(10)
      996         (if avail inkas-pay then inkas-pay.tot-base else 0) format "-999,999,999.99" space(1)
      997         (if avail inkas-pay then inkas-pay.tot-rubl else 0) format "-999,999,999.99" space(1)
      998         (if avail inkas-pay then inkas-pay.tot-sum else 0) format "-999,999,999.99" space(1)
      999         string(flag, "yes/no") format "X(20)"
     1000         skip
     1001         "ОПЛАТЫ ПО ЧЕКАМ" format "X(15)" space(1)
     1002         space(12)
     1003         space(10)
     1004         for-base format "-999,999,999.99" space(1)
     1005         for-rubl format "-999,999,999.99" space(1)
     1006         for-sum format "-999,999,999.99" space(1)
     1007         skip
     1008         .
     1009     end.
     1010   end.
     1011   FOR EACH inkas-pay NO-LOCK WHERE inkas-pay.inkas-code = my-inkas :
     1012     IF not can-find(FIRST chk-pay NO-LOCK WHERE
     1013                          chk-pay.out-code = my-inkas
     1014                    AND   chk-pay.pay-code = inkas-pay.pay-code
     1015                    AND   chk-pay.curr-code = inkas-pay.curr-code) then do:
     1016       PUT stream TEST UNFORMATTED
     1017       space(16)
     1018       inkas-pay.pay-code  format "X(20)" space(1)
     1019       inkas-pay.curr-code  format "99999" space(1)
     1020       "ОПЛАТЫ ПО ПРОДАЖЕ" format "X(15)" space(1)
     1021       space(12)
     1022       space(10)
     1023       inkas-pay.tot-base format "-999,999,999.99" space(1)
     1024       inkas-pay.tot-rubl format "-999,999,999.99" space(1)
     1025       inkas-pay.tot-sum format "-999,999,999.99" space(1)
     1026       string(yes, "yes/no") format "X(20)"
     1027       skip
     1028       "ОПЛАТЫ ПО ЧЕКАМ" format "X(15)" space(1)
     1029       space(12)
     1030       space(10)
     1031       0 format "-999,999,999.99" space(1)
     1032       0 format "-999,999,999.99" space(1)
     1033       0 format "-999,999,999.99" space(1)
     1034       skip
     1035       .
     1036     end.
     1037   END.
     1038   run waitfram-hide in this-procedure .
     1039   END PROCEDURE.
     1040   PROCEDURE test3 :
     1041   DEFINE INPUT PARAMETER my-inkas LIKE ub.inkas.inkas-code no-undo.
     1042   define variable accumq as decimal no-undo.                                  define variable accumc as decimal no-undo.                                  define variable accumall as decimal no-undo.                                define variable accumall1 as decimal no-undo.                               define variable for-netto as decimal no-undo.                               define variable for-discnt as decimal no-undo.                              define variable for-sub-disc as decimal no-undo.                            define variable for-num-chk as integer no-undo.                             define variable for-brutto as decimal no-undo.                              define variable for-netto-r as decimal no-undo.                             define variable for-discnt-r as decimal no-undo.                            define variable for-brutto-r as decimal no-undo.                            define variable for-netto-v as decimal no-undo.                             define variable for-discnt-v as decimal no-undo.                            define variable for-brutto-v as decimal no-undo.                            define variable for-sum as decimal no-undo.                                 define variable for-base as decimal no-undo.                                define variable for-rubl as decimal no-undo.                                define variable newprice as decimal no-undo.                                define variable flag as logical.                                            define variable current-netto as  decimal no-undo.                          define variable current-brutto as  decimal no-undo.                         define variable current-discnt as  decimal no-undo.                         define variable current-write-off as  decimal no-undo.                      define variable for-write-off as  decimal no-undo.                                                                                                      def buffer ret-doc for ub.trn-doc.                                             define buffer buf_sale-doc for ub.sale-doc.                          define buffer locked_trn-doc for ub.trn-doc.
     1043   define variable delta as decimal no-undo .
     1044   define buffer dop_trn-doc for ub.trn-doc.
     1045   OUTPUT STREAM TEST TO testi3.txt.
     1046   run waitfram-show in this-procedure ( input "Ждите ...").
     1047   PUT STREAM test unformatted
     1048   "СРАВНЕНИЕ ТОВАРНЫХ СУММ ПО ДОКУМЕНТАМ ПРОДАЖИ И ПРОДАЖЕ В ЦЕЛОМ" SKIP(0)
     1049   "ПРОДАЖА"  chr(32) my-inkas skip(1)
     1050   string('':U, "X(25)")  chr(32)
     1051   string('':U, "X(16)") +  chr(32)
     1052   string('Брутто', "X(19)")  chr(32)
     1053   string('Скидка товарная', "X(19)")  chr(32)
     1054   string('Нетто', "X(19)")  chr(32)
     1055   skip(0)
     1056   .
     1057   for each buf_sale-doc where
     1058          buf_sale-doc.inkas-code = my-inkas
     1059       and buf_sale-doc.order > 0:
     1060     if lookup(buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) = 0 then NEXT.
     1061     if ub.inkas.status_ <> 'факт':U then do:
     1062       find first dop_trn-doc no-lock where
     1063                 dop_trn-doc.doc-code = buf_sale-doc.doc-code.
     1064       run gbl/calc-trn.p ( input parparentproc
     1065                          , input recid(dop_trn-doc)).
     1066     end.
     1067     find first locked_trn-doc where locked_trn-doc.doc-code = buf_sale-doc.doc-code.
     1068     if buf_sale-doc.doc-kind = 'trf':U then do:
     1069     end.
     1070     else do:
     1071       assign
     1072       current-brutto = if v-curr-r-b = 'rubl':U
     1073                         then locked_trn-doc.tot-sale
     1074                         else locked_trn-doc.tot-fact
     1075       current-netto = if v-curr-r-b = 'rubl':U
     1076                   then locked_trn-doc.tot-sale - (if locked_trn-doc.discnt-rubl = ? then 0 else locked_trn-doc.discnt-rubl)
     1077                   else locked_trn-doc.tot-fact - (if locked_trn-doc.tot-calc = ? then 0 else locked_trn-doc.tot-calc)
     1078       current-discnt = if v-curr-r-b = 'rubl':U
     1079                       then locked_trn-doc.discnt-rubl
     1080                       else locked_trn-doc.tot-calc
     1081       .
     1082       if buf_sale-doc.in-inkas then
     1083       assign
     1084       for-netto = for-netto + current-netto * buf_sale-doc.dir
     1085       for-brutto = for-brutto + current-brutto * buf_sale-doc.dir
     1086       for-discnt = for-discnt + (if current-discnt = ? then 0 else current-discnt) * buf_sale-doc.dir
     1087       .
     1088       if buf_sale-doc.doc-type = 'спи':U then
     1089       assign
     1090       current-write-off = if v-curr-r-b = 'rubl':U
     1091                   then locked_trn-doc.tot-sale - locked_trn-doc.discnt-rubl
     1092                   else locked_trn-doc.tot-fact - locked_trn-doc.tot-calc
     1093       for-write-off = for-write-off + current-write-off
     1094       .
     1095       PUT STREAM test unformatted
     1096       string(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), "X(25)")  chr(32)
     1097       string(buf_sale-doc.doc-code, "X(16)") +  chr(32)
     1098       string(current-brutto * buf_sale-doc.dir, "-999,999,999.99999")  chr(32)
     1099       (if current-discnt = ?
     1100       then string(chr(63), "X(18)")
     1101       else
     1102       string(current-discnt * buf_sale-doc.dir, "-999,999,999.99999")
     1103       )                                                    chr(32)
     1104       string(current-netto * buf_sale-doc.dir, "-999,999,999.99999")  chr(32)
     1105       skip(0).
     1106     end.
     1107   end.
     1108   delta = inkas.netto - (for-netto  - (inkas.sub-discnt - for-write-off)).
     1109   PUT STREAM test unformatted
     1110   skip(1)
     1111   string("Итого по документам", "X(25)")  chr(32)
     1112   string('':U, "X(16)")  chr(32)
     1113   string(for-brutto, "-999,999,999.99999")  chr(32)
     1114   string(for-discnt, "-999,999,999.99999")   chr(32)
     1115   string(for-netto, "-999,999,999.99999")  skip(0)
     1116   string("Сумма списаний", "X(25)") chr(32)
     1117   string('':U, "X(16)")  chr(32)
     1118   string(for-write-off, "-999,999,999.99999")  chr(32)
     1119   string(0, "-999,999,999.99999")  chr(32)
     1120   string(0, "-999,999,999.99999") skip.
     1121   PUT STREAM test unformatted
     1122   skip(1)
     1123   string("Продажа в общем", "X(25)")  chr(32)
     1124   string('':U, "X(16)") +  chr(32)
     1125   string(inkas.tot-doc, "-999,999,999.99999")  chr(32)
     1126   string(inkas.discnt, "-999,999,999.99999")   chr(32)
     1127   string(inkas.netto, "-999,999,999.99999")  chr(32)
     1128   skip(0)
     1129   string("Сумма списаний", "X(25)") chr(32)
     1130   string('':U, "X(16)")  chr(32)
     1131   string(inkas.sub-discnt, "-999,999,999.99999")  chr(32)
     1132   string(0, "-999,999,999.99999")  chr(32)
     1133   string(0, "-999,999,999.99999") skip(0).
     1134   PUT STREAM test unformatted
     1135   skip(1)
     1136   string("Нетто по продаже", "X(25)")  chr(32)
     1137   string(inkas.netto, "-999,999,999.99999")  chr(32)
     1138   skip(0)
     1139   string(" - (", "X(25)") skip(0)
     1140   string("    нетто по документам", "X(25)")  chr(32)
     1141   string(for-netto, "-999,999,999.99999")  chr(32)
     1142   skip(0)
     1143   string("     - (", "X(25)") skip(0)
     1144   string("        спис. по продаже", "X(25)")  chr(32)
     1145   string(inkas.sub-discnt, "-999,999,999.99999")  chr(32)
     1146   skip(0)
     1147   string("     - ", "X(25)") skip(0)
     1148   string("        спис. по документ", "X(25)")  chr(32)
     1149   string(for-write-off, "-999,999,999.99999")  chr(32)
     1150   skip(0)
     1151   string("     - )", "X(25)")  chr(32)
     1152   skip(0)
     1153   string(" - )", "X(25)")  chr(32)
     1154   skip(0)
     1155   string(" = ", "X(25)")  chr(32)
     1156   string(delta, "-999,999,999.99999")  chr(32)
     1157   skip(0)
     1158   string("Погрешность=", "X(25)") chr(32)
     1159   string(abs(delta), "-999,999,999.99999") skip(0)
     1160   (if abs(delta) < 0.015
     1161   then "В пределах нормы"
     1162   else "Больше допустимой")
     1163   skip(0).
     1164   run waitfram-hide in this-procedure .
     1165   END PROCEDURE.
     1166   PROCEDURE test4 :
     1167   DEFINE INPUT PARAMETER my-inkas LIKE ub.inkas.inkas-code no-undo.
     1168   define variable accumq as decimal no-undo.                                  define variable accumc as decimal no-undo.                                  define variable accumall as decimal no-undo.                                define variable accumall1 as decimal no-undo.                               define variable for-netto as decimal no-undo.                               define variable for-discnt as decimal no-undo.                              define variable for-sub-disc as decimal no-undo.                            define variable for-num-chk as integer no-undo.                             define variable for-brutto as decimal no-undo.                              define variable for-netto-r as decimal no-undo.                             define variable for-discnt-r as decimal no-undo.                            define variable for-brutto-r as decimal no-undo.                            define variable for-netto-v as decimal no-undo.                             define variable for-discnt-v as decimal no-undo.                            define variable for-brutto-v as decimal no-undo.                            define variable for-sum as decimal no-undo.                                 define variable for-base as decimal no-undo.                                define variable for-rubl as decimal no-undo.                                define variable newprice as decimal no-undo.                                define variable flag as logical.                                            define variable current-netto as  decimal no-undo.                          define variable current-brutto as  decimal no-undo.                         define variable current-discnt as  decimal no-undo.                         define variable current-write-off as  decimal no-undo.                      define variable for-write-off as  decimal no-undo.                                                                                                      def buffer ret-doc for ub.trn-doc.                                             define buffer buf_sale-doc for ub.sale-doc.                          define buffer locked_trn-doc for ub.trn-doc.
     1169   define buffer buf_temp-sale-gds for temp-sale-gds.
     1170   define buffer buf_temp-sale-delta for temp-sale-delta.
     1171   define variable v-doc-kinds as character no-undo .
     1172   define variable ii as integer no-undo .
     1173   define variable v-dopi as integer no-undo .
     1174   define buffer buf_chk-doc for ub.chk-doc.
     1175   for each buf_temp-sale-delta:
     1176     delete buf_temp-sale-delta.
     1177   end.
     1178   OUTPUT STREAM TEST TO testi4.txt.
     1179   run waitfram-show in this-procedure ( input "Ждите ...").
     1180   PUT STREAM TEST UNFORMATTED
     1181   substitute("РАЗЛИЧИЕ ТОВАРНЫХ СУММ ПО СТРОКАМ НАКЛАДНЫХ ПО ПРОДАЖЕ И ЧЕКАМ&1" +
     1182                "ПО ПРОДАЖЕ &2&1&3"
     1183                ,chr(10)
     1184                ,my-inkas
     1185                ,(if index(ub.inkas.PS, "компенс")  > 0 then "БЫЛА ПРОВЕДЕНА КОМПЕНСАЦИЯ" else "")
     1186                ) skip(1)
     1187   string("Бар-код", "X(9)") chr(32)
     1188   string("Артикул", "X(16)") chr(32)
     1189   string("Про", "X(3)") chr(32)
     1190   string("изводитель", "X(9)") chr(32)
     1191   string("Вид документа", "X(20)") chr(32)
     1192   string("Кол-во док-ты", "X(12)") chr(32)
     1193   string("Сумма док-ты", "X(18)")
     1194   skip(0)
     1195   fill( chr(32) , 9 ) chr(32)
     1196   fill( chr(32) , 16 ) chr(32)
     1197   fill( chr(32) , 3 ) chr(32)
     1198   fill( chr(32) , 9 ) chr(32)
     1199   fill( chr(32) , 20 ) chr(32)
     1200   string("Кол-во чеки", "X(12)") chr(32)
     1201   string("Сумма чеки", "X(18)")
     1202   skip.
     1203   FOR EACH ub.chk-gds No-LOCK WHERE ub.chk-gds.out-code = my-inkas,
     1204       FIRST ub.chk-doc NO-LOCK where ub.chk-doc.doc-code = ub.chk-gds.doc-code,
     1205       FIRST ub.bar-code No-LOCK WHERE ub.bar-code.b-code = ub.chk-gds.b-code,
     1206       FIRST ub.goods NO-LOCK WHERE ub.goods.gds-code = ub.bar-code.gds-code
     1207   BREAK
     1208   BY ub.goods.gds-code:
     1209     run waitfram-show in this-procedure ( input substitute("Ждите ... Обработка баркода &1", chk-gds.b-code)).
     1210     IF FIRST-OF(ub.goods.gds-code) then do:
     1211       for each buf_temp-sale-gds:
     1212         delete buf_temp-sale-gds.
     1213       end.
     1214       for each buf_sale-doc where
     1215               buf_sale-doc.inkas-code = my-inkas
     1216           and buf_sale-doc.order > 0 :
     1217         FOR EACH ub.gds-dtl No-LOCK WHERE
     1218               ub.gds-dtl.doc-code = buf_sale-doc.doc-code
     1219           AND ub.gds-dtl.artic = ub.goods.artic
     1220           AND ub.gds-dtl.prod-type = ub.goods.prod-type
     1221           AND ub.gds-dtl.prod-code = ub.goods.prod-code
     1222           AND ub.gds-dtl.prt-code = ub.bar-code.node-code:
     1223           create buf_temp-sale-gds.
     1224           assign
     1225           buf_temp-sale-gds.doc-type = buf_sale-doc.doc-type
     1226           buf_temp-sale-gds.doc-kind = buf_sale-doc.doc-kind
     1227           buf_temp-sale-gds.doc-label = entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1228           buf_temp-sale-gds.qnty-trn = gds-dtl.fact-qnty * buf_sale-doc.msign
     1229           buf_temp-sale-gds.sum-r-b-trn = gds-dtl.fact-qnty *
     1230                                           (if v-curr-r-b = 'rubl':U
     1231                                           then (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     1232                                           else (gds-dtl.price-base - gds-dtl.discnt-base)
     1233                                           ) * buf_sale-doc.msign
     1234           .
     1235         END.
     1236       end.
     1237     END.
     1238     if lookup(string(chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) = 0 then do:
     1239       assign
     1240       v-dopi = num-entries(chk-gds.line-type, chr(4))
     1241       no-error .
     1242       if not error-status:error
     1243       and v-dopi > 1 then do:
     1244         v-doc-kinds = entry(2, chk-gds.line-type, chr(4)).
     1245       end.
     1246       else do:
     1247         if chk-gds.doc-qnty = 0 then v-doc-kinds = '':U.
     1248         else do:
     1249           find first buf_chk-doc no-lock where
     1250                   buf_chk-doc.doc-code = chk-gds.doc-code .
     1251           v-doc-kinds = (if buf_chk-doc.netto >= 0
     1252                               then 'es':U
     1253                               else 'rs':U)
     1254           .
     1255         end.
     1256       end.
     1257       do ii = 1 to num-entries(v-doc-kinds):
     1258         find first buf_temp-sale-gds where
     1259                 buf_temp-sale-gds.doc-kind = entry(ii, v-doc-kinds) no-error .
     1260         if not available buf_temp-sale-gds then do:
     1261           create buf_temp-sale-gds.
     1262           assign
     1263           buf_temp-sale-gds.doc-kind = entry(ii, v-doc-kinds)
     1264           .
     1265         end.
     1266         assign
     1267         buf_temp-sale-gds.qnty-check = buf_temp-sale-gds.qnty-check + chk-gds.doc-qnty
     1268         buf_temp-sale-gds.sum-r-b-check = buf_temp-sale-gds.sum-r-b-check +
     1269                                           chk-gds.doc-qnty * (chk-gds.price-base -
     1270                                                              (if buf_temp-sale-gds.doc-type = 'спи':U
     1271                                                              then 0
     1272                                                              else chk-gds.discnt))
     1273         .
     1274       end.
     1275     end.
     1276     IF LAST-OF(goods.gds-code) then do:
     1277       for each buf_temp-sale-gds:
     1278         if buf_temp-sale-gds.qnty-trn <> buf_temp-sale-gds.qnty-check
     1279         or abs(buf_temp-sale-gds.sum-r-b-trn - buf_temp-sale-gds.sum-r-b-check) > 0.0001
     1280         then do:
     1281           find first buf_temp-sale-delta where
     1282                     buf_temp-sale-delta.doc-kind = buf_temp-sale-gds.doc-kind no-error .
     1283           if not available buf_temp-sale-delta then do:
     1284             CREATE BUF_TEMP-SALE-DELTA.
     1285             ASSIGN
     1286             buf_temp-sale-delta.doc-kind = buf_temp-sale-gds.doc-kind
     1287             buf_temp-sale-delta.doc-label = buf_temp-sale-gds.doc-label
     1288             .
     1289           end.
     1290           assign
     1291           buf_temp-sale-delta.qnty-delta = buf_temp-sale-delta.qnty-delta + (buf_temp-sale-gds.qnty-trn - buf_temp-sale-gds.qnty-check)
     1292           buf_temp-sale-delta.sum-r-b-delta = buf_temp-sale-delta.sum-r-b-delta + (buf_temp-sale-gds.sum-r-b-trn - buf_temp-sale-gds.sum-r-b-check)
     1293           .
     1294           PUT STREAM TEST UNFORMATTED
     1295           chk-gds.b-code format ">>>>>>>>9" chr(32)
     1296           goods.artic format "X(16)" chr(32)
     1297           goods.prod-type format "X(3)" chr(32)
     1298           goods.prod-code format "999999999" chr(32)
     1299           buf_temp-sale-gds.doc-label format "X(20)" chr(32)
     1300           buf_temp-sale-gds.qnty-trn  format "-99,999.999" chr(32)
     1301           buf_temp-sale-gds.sum-r-b-trn format   "-99,999.999999999"
     1302           skip(0)
     1303           fill( chr(32) , 9 ) chr(32)
     1304           fill( chr(32) , 16 ) chr(32)
     1305           fill( chr(32) , 3 ) chr(32)
     1306           fill( chr(32) , 9 ) chr(32)
     1307           fill( chr(32) , 20 ) chr(32)
     1308           buf_temp-sale-gds.qnty-check  format "-99,999.999" chr(32)
     1309           buf_temp-sale-gds.sum-r-b-check format "-99,999.999999999"
     1310           skip.
     1311         end.
     1312       end.
     1313     END.
     1314   END.
     1315   PUT STREAM TEST UNFORMATTED
     1316   "ИТОГО ПОГРЕШНОСТИ ПО ВИДАМ ДОКУМЕНТОВ:" skip(0).
     1317   for each buf_temp-sale-delta:
     1318     PUT STREAM TEST UNFORMATTED
     1319     buf_temp-sale-delta.doc-label format "X(20)" chr(32)
     1320     buf_temp-sale-delta.qnty-delta  format "-99,999.999" chr(32)
     1321     buf_temp-sale-delta.sum-r-b-delta format "-99,999.999999999"
     1322     skip(0).
     1323   end.
     1324   END PROCEDURE.
     1325   PROCEDURE test5 :
     1326   DEFINE INPUT PARAMETER my-inkas LIKE ub.inkas.inkas-code no-undo.
     1327   define variable accumq as decimal no-undo.                                  define variable accumc as decimal no-undo.                                  define variable accumall as decimal no-undo.                                define variable accumall1 as decimal no-undo.                               define variable for-netto as decimal no-undo.                               define variable for-discnt as decimal no-undo.                              define variable for-sub-disc as decimal no-undo.                            define variable for-num-chk as integer no-undo.                             define variable for-brutto as decimal no-undo.                              define variable for-netto-r as decimal no-undo.                             define variable for-discnt-r as decimal no-undo.                            define variable for-brutto-r as decimal no-undo.                            define variable for-netto-v as decimal no-undo.                             define variable for-discnt-v as decimal no-undo.                            define variable for-brutto-v as decimal no-undo.                            define variable for-sum as decimal no-undo.                                 define variable for-base as decimal no-undo.                                define variable for-rubl as decimal no-undo.                                define variable newprice as decimal no-undo.                                define variable flag as logical.                                            define variable current-netto as  decimal no-undo.                          define variable current-brutto as  decimal no-undo.                         define variable current-discnt as  decimal no-undo.                         define variable current-write-off as  decimal no-undo.                      define variable for-write-off as  decimal no-undo.                                                                                                      def buffer ret-doc for ub.trn-doc.                                             define buffer buf_sale-doc for ub.sale-doc.                          define buffer locked_trn-doc for ub.trn-doc.
     1328   OUTPUT STREAM TEST TO testi5.txt.
     1329   run waitfram-show in this-procedure ( input "Ждите ...").
     1330   PUT STREAM TEST UNFORMATTED
     1331   ("НЕКОРРЕКТНЫЕ СТРОКИ НАКЛАДНЫХ ПО ПРОДАЖЕ " + my-inkas) skip(1)
     1332   "Артикул" format "X(16)" space(1)
     1333   "Про изводитель" format "X(14)" space(1)
     1334   "Кол-во-накл" format "X(11)" space(1)
     1335   "Скидка" format "X(15)" space(1)
     1336   "Вид докум" format "X(20)"
     1337   skip
     1338   .
     1339   IF error-status:ERROR THEN do:
     1340     MESSAGE ERROR-STATUS:GET-MESSAGE(1) RETURN-VALUE.
     1341     return error.
     1342   end.
     1343   for each buf_sale-doc where
     1344           buf_sale-doc.inkas-code = my-inkas
     1345       and  buf_sale-doc.order > 0
     1346           :
     1347     FOR EACH ub.gds-dtl No-LOCK WHERE
     1348           ub.gds-dtl.doc-code = buf_sale-doc.doc-code,
     1349       FIRST ub.goods No-LOCK WHERE
     1350           ub.goods.artic = ub.gds-dtl.artic AND
     1351           ub.goods.prod-type = ub.gds-dtl.prod-type AND
     1352           ub.goods.prod-code = ub.gds-dtl.prod-code:
     1353     run waitfram-show in this-procedure ( input string("Ждите ... Обработка товара " +
     1354                               string(gds-dtl.artic, "9999999999") + gds-dtl.prod-type + string(gds-dtl.prod-code)
     1355                     )         ).
     1356     IF (gds-dtl.fact-qnty = 0 or (gds-dtl.doc-qnty = 0 and  buf_sale-doc.status_ = 'факт':U)) and
     1357        (gds-dtl.discnt-rubl <> 0 or gds-dtl.discnt-base <>  0)  then
     1358       PUT STREAM TEST UNFORMATTED
     1359       goods.artic format "X(16)" space(1)
     1360       goods.prod-type format "X(3)" space(1)
     1361       goods.prod-code format "9999999999" space(1)
     1362       gds-dtl.fact-qnty  format "-99,999.999" space(1)
     1363       (if v-curr-r-b = 'base':U
     1364       then gds-dtl.discnt-base
     1365       else gds-dtl.discnt-rubl) format "-99,999.999999999" space(1)
     1366       entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ) format "X(20)"
     1367       skip.
     1368     END.
     1369   end.
     1370   END PROCEDURE.
     1371   PROCEDURE test6 :
     1372   DEFINE INPUT PARAMETER my-inkas LIKE ub.inkas.inkas-code no-undo.
     1373   define variable accumq as decimal no-undo.                                  define variable accumc as decimal no-undo.                                  define variable accumall as decimal no-undo.                                define variable accumall1 as decimal no-undo.                               define variable for-netto as decimal no-undo.                               define variable for-discnt as decimal no-undo.                              define variable for-sub-disc as decimal no-undo.                            define variable for-num-chk as integer no-undo.                             define variable for-brutto as decimal no-undo.                              define variable for-netto-r as decimal no-undo.                             define variable for-discnt-r as decimal no-undo.                            define variable for-brutto-r as decimal no-undo.                            define variable for-netto-v as decimal no-undo.                             define variable for-discnt-v as decimal no-undo.                            define variable for-brutto-v as decimal no-undo.                            define variable for-sum as decimal no-undo.                                 define variable for-base as decimal no-undo.                                define variable for-rubl as decimal no-undo.                                define variable newprice as decimal no-undo.                                define variable flag as logical.                                            define variable current-netto as  decimal no-undo.                          define variable current-brutto as  decimal no-undo.                         define variable current-discnt as  decimal no-undo.                         define variable current-write-off as  decimal no-undo.                      define variable for-write-off as  decimal no-undo.                                                                                                      def buffer ret-doc for ub.trn-doc.                                             define buffer buf_sale-doc for ub.sale-doc.                          define buffer locked_trn-doc for ub.trn-doc.
     1374   OUTPUT STREAM TEST TO testi6.txt.
     1375   PUT stream TEST UNFORMATTED
     1376   ("СРАВНЕНИЕ СУММ ПЛАТЕЖЕЙ ПО ОТЧЕТУ ПО ПРОДАЖЕ В ЦЕЛОМ " + my-inkas + " И ПО КАССАМ") skip(1)
     1377   space(16)
     1378   "Код платежа" format "X(11)" space(1)
     1379   "Код валюты " format "X(11)" space(1)
     1380   "Баз.вал." format "X(15)" space(1)
     1381   "Рубли" format "X(15)" space(1)
     1382   "Валюта платежа" format "X(15)" space(1)
     1383   "Ошибка кода оплаты" format "X(20)"
     1384   skip
     1385   .
     1386   FOR EACH ub.inkas-pay-desk No-LOCK WHERE
     1387           ub.inkas-pay-desk.inkas-code = my-inkas
     1388   break
     1389   by ub.inkas-pay-desk.pay-code
     1390   by ub.inkas-pay-desk.curr-code:
     1391     run waitfram-show in this-procedure ( input "Ждите - идет обработка -  оплата по кассе " + string(inkas-pay-desk.pay-desk)).
     1392     if first-of(ub.inkas-pay-desk.curr-code) then do:
     1393         assign
     1394         for-base = 0
     1395         for-rubl = 0
     1396         for-sum = 0
     1397         flag = no
     1398         .
     1399         FIND FIRST ub.inkas-pay NO-LOCK WHERE
     1400                     ub.inkas-pay.inkas-code = my-inkas AND
     1401                     ub.inkas-pay.pay-code = ub.inkas-pay-desk.pay-code AND
     1402                     ub.inkas-pay.curr-code = ub.inkas-pay-desk.curr-code No-ERROR.
     1403         if not avail ub.inkas-pay then flag = yes.
     1404         else flag = no.
     1405     end.
     1406     assign
     1407     for-base = for-base + ub.inkas-pay-desk.tot-base
     1408     for-rubl = for-rubl + ub.inkas-pay-desk.tot-rubl
     1409     for-sum = for-sum + ub.inkas-pay-desk.tot-sum
     1410     .
     1411     if last-of(inkas-pay-desk.curr-code) then do:
     1412       PUT stream TEST UNFORMATTED
     1413       space(16)
     1414       inkas-pay-desk.pay-code format "9999" space(8)
     1415       inkas-pay-desk.curr-code format "99999" space(7)
     1416       skip(0)
     1417       "ОПЛАТЫ ПО ПРОДАЖЕ" format "X(15)" space(1)
     1418       space(12)
     1419       space(10)
     1420       (if avail inkas-pay then inkas-pay.tot-base else 0) format "-999,999,999.99" space(1)
     1421       (if avail inkas-pay then inkas-pay.tot-rubl else 0) format "-999,999,999.99" space(1)
     1422       (if avail inkas-pay then inkas-pay.tot-sum else 0) format "-999,999,999.99" space(1)
     1423       string(flag, "yes/no") format "X(20)"
     1424       skip
     1425       "ОПЛАТЫ ПО КАССАМ" format "X(15)" space(1)
     1426       space(12)
     1427       space(10)
     1428       for-base format "-999,999,999.99" space(1)
     1429       for-rubl format "-999,999,999.99" space(1)
     1430       for-sum format "-999,999,999.99" space(1)
     1431       skip
     1432       .
     1433     end.
     1434   end.
     1435   FOR EACH inkas-pay NO-LOCK WHERE
     1436           inkas-pay.inkas-code = my-inkas :
     1437     IF not can-find(FIRST inkas-pay-desk NO-LOCK WHERE
     1438                           inkas-pay-desk.inkas-code = my-inkas AND
     1439                         inkas-pay-desk.pay-code = inkas-pay.pay-code AND
     1440                         inkas-pay-desk.curr-code = inkas-pay.curr-code) then do:
     1441       PUT stream TEST UNFORMATTED
     1442       space(16)
     1443       inkas-pay.pay-code  format "X(20)" space(1)
     1444       inkas-pay.curr-code  format "99999" space(1)
     1445       "ОПЛАТЫ ПО ПРОДАЖЕ" format "X(15)" space(1)
     1446       space(12)
     1447       space(10)
     1448       inkas-pay.tot-base format "-999,999,999.99" space(1)
     1449       inkas-pay.tot-rubl format "-999,999,999.99" space(1)
     1450       inkas-pay.tot-sum format "-999,999,999.99" space(1)
     1451       string(yes, "yes/no") format "X(20)"
     1452       skip
     1453       "ОПЛАТЫ ПО КАССАМ" format "X(15)" space(1)
     1454       space(12)
     1455       space(10)
     1456       0 format "-999,999,999.99" space(1)
     1457       0 format "-999,999,999.99" space(1)
     1458       0 format "-999,999,999.99" space(1)
     1459       skip
     1460       .
     1461     end.
     1462   END.
     1463   run waitfram-hide in this-procedure .
     1464   END PROCEDURE.
     1465   PROCEDURE test7 :
     1466   DEFINE INPUT PARAMETER my-inkas LIKE ub.inkas.inkas-code no-undo.
     1467   define VARIABLE chk-amount as integer no-undo .
     1468   define VARIABLE gds-amount as integer no-undo .
     1469   define VARIABLE line-out as integer no-undo .
     1470   define VARIABLE dtl-out as integer no-undo .
     1471   define VARIABLE line-ret as integer no-undo .
     1472   define VARIABLE dtl-ret as integer no-undo .
     1473   define VARIABLE nf-chk-amount as integer no-undo .
     1474   define VARIABLE nf-gds-amount as integer no-undo .
     1475   define VARIABLE ps-where-rus as character no-undo .
     1476   define VARIABLE v-ps as character no-undo .
     1477   define buffer buf_inkas for ub.inkas.
     1478   OUTPUT STREAM TEST TO testi7.txt.
     1479   find first buf_inkas no-lock where buf_inkas.inkas-code = my-inkas.
     1480   run get-inkas-ps in this-procedure (
     1481                                       buffer buf_inkas
     1482                                     , output chk-amount
     1483                                     , output gds-amount
     1484                                     , output line-out
     1485                                     , output dtl-out
     1486                                     , output line-ret
     1487                                     , output dtl-ret
     1488                                     , output nf-chk-amount
     1489                                     , output nf-gds-amount
     1490                                     , output ps-where-rus
     1491                                     ).
     1492   if ub.inkas.status_ <> 'факт':U then do:
     1493     v-PS = substitute("Кол-во_чеков &1&3строк_чеков &2"
     1494                         , chk-amount
     1495                         , gds-amount
     1496                         , chr(10))
     1497                   + chr(10).
     1498   end.
     1499   v-ps = v-ps +
     1500          SUBSTITUTE("товаров_расход &1&3признаков_расход &2"
     1501                       , line-out
     1502                       , dtl-out
     1503                       , chr(10)
     1504                       )
     1505          + chr(10) +
     1506          SUBSTITUTE("товаров_возврат &1&3признаков_возврат &2"
     1507                       , line-ret
     1508                       , dtl-ret
     1509                       , chr(10)
     1510                       ).
     1511   if inkas.status_ <> 'факт':U then do:
     1512     v-ps = v-ps + chr(10) +
     1513                  substitute("без_докум_чеков &1&3без_докум_строк_чеков &2"
     1514                            , nf-chk-amount
     1515                            , nf-gds-amount
     1516                            , chr(10)
     1517                            ).
     1518   end.
     1519   PUT stream TEST UNFORMATTED
     1520   substitute("КОЛИЧЕСТВО СТРОК ЧЕКОВ И ЧЕКОВ ПО ПРОДАЖЕ &1", my-inkas)
     1521   skip(0)
     1522   "По подсчету:" SKIP(1)
     1523   v-ps skip(1)
     1524   "В примечаниях к продаже" SKIP(1)
     1525   replace(inkas.ps, chr(4), chr(10))
     1526   SKIP.
     1527   END PROCEDURE.
     1528   PROCEDURE testi :
     1529   DEFINE INPUT PARAMETER test-number as integer.
     1530   DEFINE INPUT PARAMETER my-inkas as char.
     1531   define variable accumq as decimal no-undo.
     1532   define variable accumc as decimal no-undo.
     1533   define variable accumall as decimal no-undo.
     1534   define variable accumall1 as decimal no-undo.
     1535   define variable for-netto as decimal no-undo.
     1536   define variable for-discnt as decimal no-undo.
     1537   define variable for-sub-disc as decimal no-undo.
     1538   define variable for-num-chk as integer no-undo.
     1539   define variable for-brutto as decimal no-undo.
     1540   define variable for-netto-r as decimal no-undo.
     1541   define variable for-discnt-r as decimal no-undo.
     1542   define variable for-brutto-r as decimal no-undo.
     1543   define variable for-netto-v as decimal no-undo.
     1544   define variable for-discnt-v as decimal no-undo.
     1545   define variable for-brutto-v as decimal no-undo.
     1546   define variable for-sum as decimal no-undo.
     1547   define variable for-base as decimal no-undo.
     1548   define variable for-rubl as decimal no-undo.
     1549   define variable newprice as decimal no-undo.
     1550   define variable flag as logical.
     1551   define variable current-netto as  decimal no-undo.
     1552   define variable current-brutto as  decimal no-undo.
     1553   define variable current-discnt as  decimal no-undo.
     1554   define variable current-write-off as  decimal no-undo.
     1555   define variable for-write-off as  decimal no-undo.
     1556   def buffer ret-doc for ub.trn-doc.
     1557   define buffer buf_sale-doc for ub.sale-doc.
     1558   define buffer locked_trn-doc for ub.trn-doc.
     1559   END PROCEDURE.
