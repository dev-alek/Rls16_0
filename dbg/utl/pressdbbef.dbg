        1   block-level on error undo, throw.
        2   define input parameter iWrkDir as character no-undo.
        3   define input parameter iTables as character no-undo.
        4   define input parameter p-handle-callback     as handle    no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        7   define variable vss-date        as character no-undo init "$Date: 20/01/2026 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: pressdbbef.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/pressdbbef.p $":U .
       10   define variable vss-description as character no-undo init "Сжатие БД. Выгрузка списка таблиц базы.".
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   define stream LogStream .
       16   define variable ttd        as character no-undo .
       17   define variable v-old-time as int64     no-undo .
       18   PROCEDURE write-to-log :
       19     define input parameter p-msg-str   as character no-undo .
       20     define input parameter p-call-back as handle    no-undo .
       21     do
       22     on error undo, return error
       23     :
       24       output stream LogStream to "press_db.log" page-size 0 append.
       25       put stream LogStream unformatted p-msg-str .
       26       output stream LogStream close.
       27       if  valid-handle(p-call-back)
       28       and lookup('callback-write-to-log', p-call-back :internal-entries) > 0
       29       then do:
       30         run callback-write-to-log in p-call-back
       31           (input p-msg-str
       32           ) no-error .
       33       end.
       34     end.
       35   END PROCEDURE.
       36   FUNCTION format-etime RETURNS CHARACTER
       37   (INPUT p-etime AS INT64  )
       38   :
       39     if p-etime = ?
       40     then do:
       41       return "?????????????" .
       42     end.
       43     assign
       44       p-etime = p-etime / 1000
       45     .
       46     return
       47       string( p-etime, '->>>>>>>9')
       48       + ' '
       49       + string( p-etime, 'HH:MM:SS')
       50     .
       51   END FUNCTION.
       52   find first dst.sys-ctrl no-lock no-error.
       53   if avail dst.sys-ctrl then
       54     return error 'Сжатие БД невозможно, т.к. база-приемник уже имеет данные.'.
       55   define variable vFullTables as character no-undo.
       56   define buffer old-user for ub._user.
       57   define buffer new-user for dst._user.
       58   define stream sToFile.
       59   os-create-dir value(iWrkDir).
       60   vFullTables = substitute("&1\&2",iWrkDir,iTables).
       61   output stream sToFile to value(vFullTables).
       62   if search(vFullTables) = ? then
       63     return error substitute("Не удалось открыть файл &1", vFullTables).
       64   run write-to-log in this-procedure
       65      ( string(today, '99/99/9999') + " " + string(time, 'HH:MM') +
       66        chr(10) + "Формируем список таблиц для выгрузки." + chr(10)
       67      ,p-handle-callback
       68   ).
       69   for each dst._file no-lock where
       70            not dst._file._file-name begins "_"
       71   :
       72     put stream sToFile unformatted dst._file._file-name skip.
       73   end.
       74   output stream sToFile close.
       75   run write-to-log in this-procedure
       76      ( string(today, '99/99/9999') + " " + string(time, 'HH:MM') +
       77        chr(10) + "Переносим пользователей." + chr(10)
       78      ,p-handle-callback
       79   ).
       80   do
       81   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       82     for each old-user no-lock
       83     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       84     :
       85       find first new-user no-lock
       86         where new-user._userid = old-user._userid
       87         no-error .
       88       if not available new-user then do:
       89         create new-user.
       90         buffer-copy old-user except _TenantId to new-user.
       91       end.
       92     end.
       93   end.
