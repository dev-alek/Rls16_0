        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "Обновление болванки".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   function objExists return character
       67   (input  ifolder as character,
       68    input  iType   as character  ):
       69       define variable vFileType as character no-undo init "D,F".
       70       define variable vi        as integer no-undo.
       71       define variable vtype as character no-undo.
       72       if iType ne ?
       73       then
       74          vFileType = iType.
       75       do vi = 1 to num-entries(vFileType):
       76          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       77          vtype = file-information:file-type.
       78          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       79             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       80             index(vtype , entry(vi,vFileType )) > 0
       81          then return file-information:full-pathname .
       82          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       83          vtype = file-information:file-type.
       84          if file-information:file-name <> "" and
       85             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       86             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       87             index( vtype, entry(vi,vFileType )) > 0
       88          then return file-information:full-pathname .
       89       end.
       90       return ? .
       91   end.
       92   function SearchFile return character
       93   (input  ifile as character):
       94      return objExists(ifile,?).
       95   end.
       96   function SearchPFile return character
       97   (input inFile as char):
       98        define variable oFile       as character no-undo.
       99        define variable vFileSearch as character no-undo.
      100        define variable vNumEntry   as integer no-undo.
      101        if inFile = "" then return ?.
      102        vNumEntry = num-entries(inFile,".").
      103        vFileSearch = inFile.
      104        if    vNumEntry > 0
      105           and (   entry(vNumEntry,inFile,".") eq "p"
      106                or entry(vNumEntry,inFile,".") eq "w")
      107        then do:
      108           entry(vNumEntry,vFileSearch, ".") = "r".
      109           oFile = search(vFileSearch ).
      110           if oFile eq ?
      111           then
      112              oFile = search(inFile).
      113        end.
      114        else
      115           oFile = search(vFileSearch).
      116        return oFile.
      117     end.
      118   define variable masynchelper as class ibs.th.file.asynchelperTh no-undo.
      119   mAsyncHelper = new ibs.th.file.AsyncHelperth().
      120   mAsyncHelper:mProcPublish = this-procedure.
      121   mAsyncHelper:conpar = "".
      122   mAsyncHelper:MyBachMode = session:batch-mode.
      123   mAsyncHelper:DbConnect = no.
      124   if session:system-alert-boxes
      125   then
      126      mAsyncHelper:SaveFile = yes.
      127   mAsyncHelper:AsyncProc("utl/proc-ubexeupd", "",1).
      128   run ibs\th\file\waithelper.p (mAsyncHelper,?, 1,"Обновление болванки.").
      129   define variable mlogfile as character no-undo.
      130   define stream  sReadfile.
      131   define variable mText as character no-undo.
      132   define variable mError as logical no-undo.
      133   mlogfile = mAsyncHelper:getLog("proc-ubexeupd").
      134   if SearchFile(mlogfile) ne ?
      135   then do:
      136      input stream sReadfile FROM  VALUE(SearchFile(mlogfile)).
      137      output to "ubblack.txt".
      138      repeat:
      139         import stream sReadfile unformatted mText.
      140         put unformatted mText skip.
      141             if mtext begins "error" then mError = yes.
      142      end.
      143      output close.
      144      input stream sReadfile close  .
      145      os-delete value(SearchFile(mlogfile)).
      146      if mError
      147      then
      148         message "Произошла ошибка при обновление БД":U
      149         view-as alert-box.
      150   end.
      151   if session:system-alert-boxes
      152   then
      153      message "Результаты выполнения находятся в " mAsyncHelper:SaveArh() skip
      154              "Лог выполнения сохранен в " SearchFile("ubblack.txt")
      155         view-as alert-box.
      156   else
      157      message "Лог выполнения сохранен в " SearchFile("ubblack.txt")
      158      view-as alert-box.
      159   delete object mAsyncHelper.
