        1   using Progress.Lang.*.
        2   using utl.*.
        3   block-level on error undo, throw.
        4   class utl.gpwdfrm-data2:
        5      method public "System.Collections.Generic.List<System.Object>" GetList(iSuppParent as char):
        6         def buffer code for ub.code.
        7         def var vItem as class net-item no-undo.
        8         def var vList as class "System.Collections.Generic.List<System.Object>" no-undo.
        9         vList = new "System.Collections.Generic.List<System.Object>"().
       10         vItem = new net-item("",
       11                                 "",
       12                                 "").
       13         vList:Add(vItem).
       14         if iSuppParent eq ""
       15         then
       16            return vList.
       17         if(num-entries (iSuppParent,chr(4)) > 1 )
       18         then
       19            for each code where Code.parent = iSuppParent  no-lock by int(code.code):
       20               vItem = new net-item(Code.code,
       21                                    substitute ("&2&1&3",chr(4),iSuppParent,Code.code),
       22                                    Code.CodeName).
       23               vList:Add(vItem).
       24            end.
       25         else
       26            for each code where Code.parent = iSuppParent  no-lock :
       27               vItem = new net-item(Code.code,
       28                                    substitute ("&2&1&3",chr(4),iSuppParent,Code.code),
       29                                    Code.CodeName).
       30               vList:Add(vItem).
       31            end.
       32         return vList.
       33      end method.
       34      method public "System.Collections.Generic.List<System.Object>" GetUserList():
       35         def var vItem as class net-item no-undo.
       36         def var vItems as class "System.Collections.Generic.List<System.Object>" no-undo.
       37         vItems = new "System.Collections.Generic.List<System.Object>"().
       38         return vItems.
       39      end method.
       40      method public net-item GetObj(iSurr as char):
       41         def buffer code for ub.code.
       42         define variable vNetItem as class net-item no-undo.
       43         vNetItem = new net-item().
       44         define variable vPos    as integer   no-undo.
       45         define variable vParent as character no-undo.
       46         define variable vCode   as character no-undo.
       47         vPos = r-index (isurr,chr(4)).
       48         if( vPos eq  0)
       49         then assign
       50            vParent = "cashobj"
       51            vCode   = iSurr.
       52         else assign
       53            vParent = substring (iSurr,1,vpos - 1)
       54            vCode   = substring (iSurr,vpos + 1).
       55         find first code where Code.parent eq vParent
       56                           and Code.code   eq vcode
       57         no-lock no-error.
       58         if avail code then
       59         do:
       60            assign
       61               vNetItem:DisplayName = code.code
       62               vNetItem:Value = iSurr
       63               vNetItem:Desctiption = Code.CodeName
       64            .
       65         end.
       66         else assign
       67               vNetItem:DisplayName = vcode
       68               vNetItem:Value       = vcode
       69            .
       70         return vNetItem.
       71      end.
       72      method public char GetUserLogin():
       73         define variable vUserLogin as char no-undo.
       74         define buffer buf_user-account for ub.user-account .
       75         vUserLogin = ibs.th.gbl.gbl-var:g#userid.
       76         return vUserLogin.
       77      end method.
       78      method public void ValidateForm(
       79         iComboBoxRegion as System.Windows.Forms.ComboBox,
       80         iComboBoxShop   as System.Windows.Forms.ComboBox,
       81         iComboBoxCash   as System.Windows.Forms.ComboBox):
       82         def buffer code for code.
       83         define variable vParent as character no-undo init "CashObj".
       84         define variable vCode as character no-undo.
       85         vCode = iComboBoxRegion:text.
       86         if not can-find(code where
       87                         Code.parent = vParent
       88                     and Code.code   = vCode
       89                     no-lock) then
       90         do:
       91            iComboBoxRegion:Focus().
       92            undo, throw new ValidateError("Регион не найден в базе",-1).
       93         end.
       94         vParent = vParent + chr(4) + vCode.
       95         vCode = iComboBoxShop:text.
       96         if not can-find(code where
       97                         Code.parent = vParent
       98                     and Code.code   = vCode
       99                     no-lock) then
      100         do:
      101            iComboBoxShop:Focus().
      102            undo, throw new ValidateError("Код магазина не найден в базе",-1).
      103         end.
      104         vParent = vParent + chr(4) + vCode.
      105         vCode = iComboBoxCash:text.
      106         if not can-find(code where
      107                         Code.parent = vParent
      108                     and Code.code   = vCode
      109                     no-lock) then
      110         do:
      111            iComboBoxCash:Focus().
      112            undo, throw new ValidateError("Код кассы не найден в базе",-1).
      113         end.
      114      end method.
      115      method public char GetCli():
      116         def buffer bclients for clients.
      117         def var v-rid-list as char no-undo.
      118         def var vCli       as char no-undo.
      119         run ref/cli-all.w (gpwdbrw:parParentProc
      120                     ,input "b-sel"
      121                     ,input 'чел':U
      122                     ,input 'все':U
      123                     ,input 'текущие':U
      124                     ,input ?
      125                     ,input ",,,,,,NO,,"
      126                     ,input "":U
      127                     ,output v-rid-list) no-error.
      128         if (v-rid-list <> "" or v-rid-list <> ?) and num-entries(v-rid-list) = 1 then
      129         do:
      130            for first bclients where
      131                recid(bclients) = int64(v-rid-list)
      132            no-lock:
      133               vCli = bclients.obj-name.
      134            end.
      135         end.
      136         return vCli.
      137      end method.
      138   end class.
