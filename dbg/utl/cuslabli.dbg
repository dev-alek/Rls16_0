      491   ON VALUE-CHANGED OF tt-custom-labels.tbl-name IN FRAME Dialog-Frame
      492   DO:
      493   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
      494   DEFINE BUFFER buf_field FOR ub._field.
      495   DEFINE BUFFER buf_file FOR ub._file.
      496   ASSIGN
      497   tt-custom-labels.tbl-name.
      498   DO v-ii = 1 TO tt-custom-labels.fld-name:NUM-ITEMS IN FRAME Dialog-Frame:
      499     tt-custom-labels.fld-name:DELETE(tt-custom-labels.fld-name:ENTRY(v-ii)).
      500   END.
      501   FIND FIRST buf_file NO-LOCK WHERE
      502           buf_file._HIDDEN  = NO
      503        AND buf_file._file-name = tt-custom-labels.tbl-name NO-ERROR.
      504   IF AVAILABLE buf_file THEN DO:
      505   FOR EACH buf_field NO-LOCK WHERE
      506           buf_field._file-recid = RECID(buf_file):
      507     tt-custom-labels.fld-name:ADD-LAST( buf_field._field-name) IN FRAME Dialog-Frame.
      508   END.
      509   END.
      510   END.
      511   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      512   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      513   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   on help of frame Dialog-Frame
      515   do:
      516     run gbl/app_help.p
      517       (input this-procedure :file-name
      518       ,input ''
      519       ,input ?
      520       ) no-error.
      521     if error-status :error then do:
      522       message
      523         "Œ¯Ë·Í‡ ÔË ‚˚ÁÓ‚Â ÔÓÏÓ˘Ë"
      524         error-status :get-message(1)
      525         view-as alert-box .
      526     end.
      527   end.
      528   run minbtn-set in this-procedure .
      529   on choose of b-help in frame Dialog-Frame
      530   do:
      531     apply "help":u to frame Dialog-Frame .
      532   end.
      533   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      534   procedure minbtn-set :
      535       do
      536           on error undo, return error return-value
      537           :
      538           define variable ii              as integer       no-undo .
      539           define variable fh              as widget-handle no-undo .
      540           define variable hh              as widget-handle no-undo .
      541           define variable v-h             as handle        extent 4 no-undo .
      542           define variable v-name-button   as character     no-undo .
      543           define variable v-help-old-x    as decimal       no-undo .
      544           define variable v-help-old-y    as decimal       no-undo .
      545           define variable v-help-old-size as decimal       no-undo .
      546           define variable v-frame-width   as decimal       no-undo .
      547           define variable jj              as integer       no-undo .
      548           do
      549               on error undo, return error
      550               :
      551               assign
      552                   v-frame-width = frame Dialog-Frame:width - 0.3
      553                   fh            = frame Dialog-Frame:first-child
      554                   hh            = fh:first-child
      555                   ii            = 1
      556                   .
      557               do while valid-handle(hh):
      558                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      559                   do:
      560                       case lc(hh:name) :
      561                           when "b-help" then
      562                               do:
      563                                   hh:load-image-up("cmp/b-help.bmp":u) .
      564                                   hh:load-image-down("cmp/b-help.bmp":u) .
      565                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      566                                   hh:TOOLTIP = "œÓÏÓ˘¸" .
      567                                   v-help-old-x = hh:column .
      568                                   v-help-old-y = hh:row    .
      569                                   v-help-old-size = hh:width .
      570                                   hh:width-chars = 2.5 .
      571                               end.
      572                           when "b-print" then
      573                               do:
      574                                   hh:load-image("cmp/b-print.bmp":u) .
      575                                   hh:TOOLTIP = "œÂ˜‡Ú¸" .
      576                                   v-h[ii] = hh:handle .
      577                                   ii = ii + 1 .
      578                                   hh:width-chars = 3 .
      579                               end.
      580                           when "b-history" or
      581                           when "b-hist" then
      582                               do:
      583                                   hh:load-image("cmp/b-hist.bmp":u) .
      584                                   hh:TOOLTIP = "»ÒÚÓËˇ" .
      585                                   v-h[ii] = hh:handle .
      586                                   ii = ii + 1 .
      587                                   hh:width-chars = 3 .
      588                               end.
      589                           when "b-sch" then
      590                               do:
      591                                   hh:load-image("cmp/b-sch.bmp":u) .
      592                                   hh:TOOLTIP = "”ÒÚ‡ÌÓ‚Í‡ ‘ËÎ¸Ú‡" .
      593                                   v-h[ii] = hh:handle .
      594                                   ii = ii + 1 .
      595                                   hh:width-chars = 3 .
      596                               end.
      597                           when "b-hist-user" then
      598                               do:
      599                                   hh:load-image("cmp/b-hist.bmp":u) .
      600                                   hh:TOOLTIP = "»ÒÚÓËˇ ÔÓÎ¸ÁÓ‚‡ÚÂÎˇ" .
      601                                   ii = ii + 1 .
      602                               end.
      603                       end case.
      604                   end.
      605                   hh = hh:next-sibling.
      606               end.
      607               b-help:column = v-frame-width - b-help:width-chars.
      608               jj = 0.
      609               repeat ii = 4 to 1 by -1 :
      610                   if valid-handle (v-h[ii] ) then
      611                   do:
      612                       jj  = jj + 1 .
      613                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      614                       v-h[ii]:row    = v-help-old-y .
      615                   end.
      616               end.
      617           end.
      618       end.
      619   end procedure.
      620   MAIN-BLOCK:
      621   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      622      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      623     IF p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U THEN DO:
      624       CREATE tt-custom-labels.
      625     END.
      626     ELSE DO:
      627        IF p-mode = '»«Ã≈Õ≈Õ»≈':U THEN DO:
      628            FIND FIRST LOCKED_custom-labels EXCLUSIVE-LOCK WHERE
      629                      LOCKED_custom-labels.tbl-name = p-tbl-name
      630                  AND LOCKED_custom-labels.fld-name = p-field-name
      631                  AND LOCKED_custom-labels.call-type = p-call-type
      632                  AND LOCKED_custom-labels.call-point = p-call-point
      633                  AND LOCKED_custom-labels.language = p-language NO-ERROR.
      634        END.
      635        IF p-mode = 'œ–Œ—ÃŒ“–':U
      636        or p-mode = ' Œœ»–Œ¬¿Õ»≈':U
      637        THEN DO:
      638            FIND FIRST LOCKED_custom-labels no-LOCK WHERE
      639                      LOCKED_custom-labels.tbl-name = p-tbl-name
      640                  AND LOCKED_custom-labels.fld-name = p-field-name
      641                  AND LOCKED_custom-labels.call-type = p-call-type
      642                  AND LOCKED_custom-labels.call-point = p-call-point
      643                  AND LOCKED_custom-labels.language = p-language NO-ERROR.
      644        END.
      645        IF NOT AVAILABLE LOCKED_custom-labels THEN DO:
      646            MESSAGE
      647            "ÕÂ Ì‡È‰ÂÌ‡ Á‡ÔËÒ¸"
      648            VIEW-AS ALERT-BOX ERROR.
      649          return error.
      650        END.
      651        CREATE tt-custom-labels.
      652        BUFFER-COPY LOCKED_custom-labels TO tt-custom-labels.
      653        if p-mode = ' Œœ»–Œ¬¿Õ»≈':U then do:
      654          assign
      655          v-is-copy = yes
      656          p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U.
      657        end.
      658     END.
      659     RUN Myenable.
      660     WAIT-FOR GO OF FRAME Dialog-Frame.
      661   END.
      662   RUN disable_UI.
      663   PROCEDURE disable_UI :
      664     HIDE FRAME Dialog-Frame.
      665   END PROCEDURE.
      666   PROCEDURE enable_UI :
      667     IF AVAILABLE tt-custom-labels THEN
      668       DISPLAY tt-custom-labels.call-point tt-custom-labels.call-type
      669             tt-custom-labels.tbl-name tt-custom-labels.language
      670             tt-custom-labels.fld-name tt-custom-labels.fld-data-type
      671             tt-custom-labels.custom-label tt-custom-labels.custom-format
      672             tt-custom-labels.widget-width tt-custom-labels.widget-type
      673             tt-custom-labels.widget-list-items tt-custom-labels.custom-view-func
      674             tt-custom-labels.reference-proc tt-custom-labels.custom-tooltip
      675             tt-custom-labels.init-value-character tt-custom-labels.init-value-date
      676             tt-custom-labels.init-value-integer
      677             tt-custom-labels.init-value-decimal
      678             tt-custom-labels.init-value-logical
      679         WITH FRAME Dialog-Frame.
      680     ENABLE B-exit b-quit B-Help tt-custom-labels.call-point
      681            tt-custom-labels.call-type tt-custom-labels.tbl-name
      682            tt-custom-labels.language tt-custom-labels.fld-name
      683            tt-custom-labels.fld-data-type tt-custom-labels.custom-label
      684            tt-custom-labels.custom-format tt-custom-labels.widget-width
      685            tt-custom-labels.widget-type tt-custom-labels.widget-list-items
      686            tt-custom-labels.custom-view-func tt-custom-labels.reference-proc
      687            tt-custom-labels.custom-tooltip tt-custom-labels.init-value-character
      688            tt-custom-labels.init-value-date tt-custom-labels.init-value-integer
      689            tt-custom-labels.init-value-decimal
      690            tt-custom-labels.init-value-logical
      691         WITH FRAME Dialog-Frame.
      692     VIEW FRAME Dialog-Frame.
      693   END PROCEDURE.
      694   PROCEDURE MyEnable :
      695   DEFINE BUFFER buf_file FOR _file.
      696   FOR EACH buf_file NO-LOCK WHERE
      697           buf_file._HIDDEN  = NO:
      698     tt-custom-labels.tbl-name:ADD-LAST( buf_file._file-name) IN FRAME Dialog-Frame.
      699   END.
      700   tt-custom-labels.fld-data-type:LIST-ITEMS IN FRAME Dialog-Frame = 'character,date,decimal,integer,logical':U.
      701   tt-custom-labels.widget-type:LIST-ITEMS IN FRAME Dialog-Frame = "fill-in,toggle-box,combo-box".
      702   IF AVAILABLE tt-custom-labels THEN
      703   DISPLAY
      704   tt-custom-labels.call-type
      705   tt-custom-labels.call-point
      706   tt-custom-labels.custom-format
      707   tt-custom-labels.custom-label
      708   tt-custom-labels.custom-view-func
      709   tt-custom-labels.reference-proc
      710   tt-custom-labels.language
      711   tt-custom-labels.tbl-name
      712   tt-custom-labels.fld-name
      713   tt-custom-labels.fld-data-type
      714   tt-custom-labels.custom-tooltip
      715   tt-custom-labels.init-value-character
      716   tt-custom-labels.init-value-date
      717   tt-custom-labels.init-value-decimal
      718   tt-custom-labels.init-value-integer
      719   tt-custom-labels.init-value-logical
      720   tt-custom-labels.widget-type
      721   tt-custom-labels.widget-width
      722   WITH FRAME Dialog-Frame.
      723   tt-custom-labels.widget-list-items:screen-value = tt-custom-labels.widget-list-items.
      724   ENABLE
      725   B-exit WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      726   b-quit
      727   B-Help
      728   tt-custom-labels.call-type WHEN p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      729   tt-custom-labels.call-point WHEN p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      730   tt-custom-labels.custom-format WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      731   tt-custom-labels.custom-label WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      732   tt-custom-labels.custom-view-func WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      733   tt-custom-labels.reference-proc WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      734   tt-custom-labels.language WHEN p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      735   tt-custom-labels.tbl-name WHEN p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      736   tt-custom-labels.fld-name WHEN p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      737   tt-custom-labels.custom-tooltip WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      738   tt-custom-labels.init-value-character WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      739   tt-custom-labels.init-value-date WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      740   tt-custom-labels.init-value-decimal WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      741   tt-custom-labels.init-value-integer WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      742   tt-custom-labels.init-value-logical WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      743   tt-custom-labels.fld-data-type WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      744   tt-custom-labels.widget-type WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      745   tt-custom-labels.widget-width WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      746   tt-custom-labels.widget-list-items
      747   WITH FRAME Dialog-Frame.
      748   VIEW FRAME Dialog-Frame.
      749   IF p-mode = 'œ–Œ—ÃŒ“–':U THEN DO:
      750      HIDE
      751      b-exit IN FRAME Dialog-Frame.
      752      ASSIGN
      753      b-quit:LABEL = "&¬˚ıÓ‰"
      754      b-quit:COLUMN = 1
      755      tt-custom-labels.widget-list-items:read-only = yes
      756      .
      757   END.
      758   APPLY "value-changed" TO tt-custom-labels.tbl-name.
      759   END PROCEDURE.
      760   PROCEDURE proc-save :
      761   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      762   IF p-mode = 'œ–Œ—ÃŒ“–':U THEN RETURN ERROR.
      763   ASSIGN
      764   FRAME Dialog-Frame
      765   tt-custom-labels.call-type
      766   tt-custom-labels.call-point
      767   tt-custom-labels.custom-format
      768   tt-custom-labels.custom-label
      769   tt-custom-labels.custom-view-func
      770   tt-custom-labels.language
      771   tt-custom-labels.tbl-name
      772   tt-custom-labels.fld-name
      773   tt-custom-labels.fld-data-type
      774   tt-custom-labels.custom-tooltip
      775   tt-custom-labels.init-value-character
      776   tt-custom-labels.init-value-date
      777   tt-custom-labels.init-value-decimal
      778   tt-custom-labels.init-value-integer
      779   tt-custom-labels.init-value-logical
      780   tt-custom-labels.reference-proc
      781   tt-custom-labels.widget-type
      782   tt-custom-labels.widget-width
      783   .
      784   IF p-mode = '»«Ã≈Õ≈Õ»≈':U THEN DO:
      785     v-rec = p-rec.
      786   END.
      787   if tt-custom-labels.tbl-name = ? then do:
      788     tt-custom-labels.tbl-name = '':U.
      789   end.
      790   if tt-custom-labels.fld-name = ? then do:
      791     tt-custom-labels.fld-name = '':U.
      792   end.
      793   run utl/cuslabl1.p ( INPUT p-mode
      794                       ,INPUT NO
      795                        ,INPUT-OUTPUT v-rec
      796                        ,INPUT tt-custom-labels.tbl-name
      797                        ,INPUT tt-custom-labels.fld-name
      798                        ,INPUT tt-custom-labels.call-type
      799                        ,INPUT tt-custom-labels.call-point
      800                        ,INPUT tt-custom-labels.LANGUAGE
      801                        ,INPUT tt-custom-labels.fld-data-type
      802                        ,INPUT tt-custom-labels.custom-label
      803                        ,INPUT tt-custom-labels.custom-view-func
      804                        ,INPUT tt-custom-labels.reference-proc
      805                        ,INPUT tt-custom-labels.custom-format
      806                        ,INPUT tt-custom-labels.custom-tooltip
      807                         ,INPUT tt-custom-labels.init-value-character
      808                         ,INPUT tt-custom-labels.init-value-date
      809                         ,INPUT tt-custom-labels.init-value-decimal
      810                         ,INPUT tt-custom-labels.init-value-integer
      811                         ,INPUT tt-custom-labels.init-value-logical
      812                         ,INPUT tt-custom-labels.widget-type
      813                         ,INPUT tt-custom-labels.widget-width
      814                        ,INPUT tt-custom-labels.widget-LIST-ITEMS:SCREEN-VALUE
      815                        ) NO-ERROR.
      816   if error-status:error then do:
      817   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      818   define variable fh as widget-handle no-undo .
      819   define variable hh as widget-handle no-undo .
      820   define variable rv as character no-undo .
      821   assign
      822   rv = entry(1, return-value , chr(4)).
      823   if rv <> "":U then do:
      824     assign
      825     fh = frame Dialog-Frame:first-child
      826     hh = fh:first-child
      827     .
      828     do while valid-handle(hh):
      829       if hh:name = rv then do:
      830         APPLY "ENTRY" to hh.
      831         undo ,
      832         return error.
      833       end.
      834       hh = hh:next-sibling.
      835     end.
      836   end.
      837     undo, return error.
      838   end.
      839   p-rec = v-rec.
      840   END PROCEDURE.
