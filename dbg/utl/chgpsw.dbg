      206   function pascur returns handle ():
      207   define buffer  Buf_user for  _user.
      208    find first gPasSysAdm no-error.
      209    if not available gPasSysAdm then crpas().
      210    define variable vReturn as handle no-undo.
      211    find first Buf_user
      212              where Buf_user._userid    = mloginsysadm
      213              no-error
      214              .
      215      if available Buf_user
      216      then do:
      217          block-pas:
      218          for each gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-lock:
      219             if Buf_user._password eq encode(gpasSysadm.pasw)
      220             then
      221                leave block-pas.
      222          end.
      223      end.
      224      release Buf_user.
      225      if not available gPasSysAdm
      226      then
      227         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      228      vReturn = buffer gPasSysAdm:handle.
      229      return vReturn.
      230   end.
      231   function pasNew returns handle ():
      232      define buffer  sys-ctrl for ub.sys-ctrl.
      233      define buffer  upgrade for ub.upgrade.
      234      define buffer  upgrade-attr for ub.upgrade-attr.
      235      find first gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-error.
      236      if not available gPasSysAdm then crpas().
      237      define variable vReturn as handle no-undo.
      238      find first sys-ctrl no-lock .
      239      block-upg:
      240      for each  upgrade  where upgrade.db-num = sys-ctrl.db-num
      241      no-lock
      242       by upgrade.db-num descending by upgrade.step-num descending
      243          :
      244        leave block-upg.
      245      end.
      246      find first upgrade-attr no-lock where
      247                 upgrade-attr.db-num      = upgrade.db-num and
      248                 upgrade-attr.version-num = upgrade.version-num and
      249                 upgrade-attr.attr-code   = "releace" no-error .
      250      find first  gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm and
      251                                   gPasSysAdm.num eq integer (upgrade-attr.attr-value) no-lock no-error.
      252      release sys-ctrl.
      253      release upgrade.
      254      release upgrade-attr.
      255      if not available gPasSysAdm
      256      then
      257         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      258      vReturn = buffer gPasSysAdm:handle.
      259      return vReturn.
      260   end.
      261   define input  parameter ichgpsw as logical no-undo.
      262   define variable vss-revision    as character no-undo init "$Revision: e9d5d9294a87, 3458, rls $":U .
      263   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
      264   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:33 $":U .
      265   define variable vss-workfile    as character no-undo init "$Workfile: chgpsw.p $":U .
      266   define variable vss-archive     as character no-undo init "$Archive: utl/chgpsw.p $":U .
      267   define variable vss-description as character no-undo init "Процедура установки паролей при запуске TH".
      268   procedure vss-get-info :
      269     define output parameter p-vss-revision    like vss-revision    no-undo .
      270     define output parameter p-vss-author      like vss-author      no-undo .
      271     define output parameter p-vss-date        like vss-date        no-undo .
      272     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      273     define output parameter p-vss-archive     like vss-archive     no-undo .
      274     define output parameter p-vss-description like vss-description no-undo .
      275     assign
      276       p-vss-revision    = vss-revision
      277       p-vss-author      = vss-author
      278       p-vss-date        = vss-date
      279       p-vss-workfile    = vss-workfile
      280       p-vss-archive     = vss-archive
      281       p-vss-description = vss-description
      282     .
      283   end procedure.
      284   procedure vss-get-parameters :
      285     define output parameter p-vss-parameters as character no-undo .
      286   end procedure.
      287   define new global shared variable g#vssrevis-logger as handle    no-undo .
      288   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      289   define variable v-vssrevis-logger                   as handle    no-undo .
      290   procedure vss-logevent :
      291     define input  parameter p-extra-paramters as character no-undo .
      292     define variable v-vssrevis-parameters as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       if  valid-handle(v-vssrevis-logger)
      297       and v-vssrevis-logger :get-signature("logevent") <> ""
      298       then do:
      299         run vss-get-parameters in this-procedure
      300           (output v-vssrevis-parameters
      301           ).
      302         run logevent in v-vssrevis-logger
      303           (input vss-workfile
      304           ,input vss-revision
      305           ,input v-vssrevis-parameters
      306           ,input p-extra-paramters
      307           ).
      308       end.
      309     end.
      310   end procedure.
      311   assign
      312     v-vssrevis-logger = g#vssrevis-logger
      313   .
      314   if  valid-handle(v-vssrevis-logger)
      315   and v-vssrevis-logger :get-signature("logevent") <> ""
      316   then do:
      317     assign
      318       v-vssrevis-logevent = true
      319     .
      320     run vss-logevent in this-procedure (input vss-description) .
      321   end.
      322   define new global shared variable g#language as character no-undo .
      323   if g#language <> '' and g#language <> 'rus':U then do:
      324     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      325   end.
      326   define new global shared variable g#library  as handle no-undo .
      327   define new global shared variable g#library2 as handle no-undo .
      328   define   shared variable g#auto as logical no-undo.
      329   define   shared variable g#news as logical no-undo.
      330   define   shared variable g#oxml as logical no-undo.
      331   define   shared variable g#esys as logical no-undo.
      332   define   shared variable g#news-source-db as integer no-undo.
      333   define   shared variable g#esys-source-esys as integer no-undo.
      334   define   shared variable g#db-num as integer   no-undo .
      335   define   shared variable g#userid as character no-undo .
      336   define   shared variable g#passwd as character no-undo .
      337   define temp-table UserDbAdm
      338   field db-num as integer
      339   field db-adm as logical
      340   field db-usr as logical
      341   field db-block as logical
      342   index pi is unique db-num
      343   index adm db-adm db-usr
      344   .
      345   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   procedure cur-time :
      347      define output parameter p-today as date      no-undo .
      348      define output parameter p-time  as integer   no-undo .
      349     do
      350     on error undo, return error
      351     :
      352       define variable v-date1 as date      no-undo .
      353       define variable v-date2 as date      no-undo .
      354       define variable v-time  as integer   no-undo .
      355       assign
      356         v-date1 = today
      357         v-time  = time
      358         v-date2 = today
      359       .
      360       if v-date1 <> v-date2
      361       then do:
      362         assign
      363           v-date1 = today
      364           v-time  = v-time
      365         .
      366       end.
      367       assign
      368         p-today = v-date1
      369         p-time  = v-time
      370       .
      371     end.
      372   end.
      373   function cur-time-date returns character
      374   :
      375     return string(today, '99/99/9999':U) .
      376   end.
      377   function cur-time-mjd returns decimal
      378   :
      379     define variable v-date as date      no-undo .
      380     define variable v-time as integer   no-undo .
      381     run cur-time in this-procedure
      382       (output v-date
      383       ,output v-time
      384       ) .
      385     return integer(v-date) - 2400002 + (v-time / 86400) .
      386   end.
      387   function cur-time-get-ending-index returns integer
      388   (input p-number as integer
      389   )
      390   :
      391     if p-number < 0
      392     or p-number = ?
      393     then do:
      394       return 1 .
      395     end.
      396     define variable v-rest as integer   no-undo .
      397     assign
      398       p-number = p-number modulo 100
      399     .
      400     if p-number < 20
      401     then do:
      402       assign
      403         v-rest = p-number
      404       .
      405     end.
      406     else do:
      407       assign
      408         v-rest = p-number modulo 10
      409       .
      410     end.
      411     case v-rest :
      412       when 1
      413       then do:
      414         return 2 .
      415       end.
      416       when 2 or
      417       when 3 or
      418       when 4
      419       then do:
      420         return 3 .
      421       end.
      422       otherwise do:
      423         return 1 .
      424       end.
      425     end case .
      426   end.
      427   procedure cur-time-mjd-to-date :
      428      define input  parameter i-mjd-diff as decimal no-undo.
      429      define output parameter o-Date     as date    no-undo.
      430      define output parameter o-Time     as integer no-undo.
      431      define variable v-day-number as integer   no-undo .
      432      if    i-mjd-diff < 0
      433         or i-mjd-diff = ?
      434      then do:
      435         return "?" .
      436      end.
      437      assign
      438         v-day-number = truncate(i-mjd-diff,0).
      439         o-Date = date(v-day-number + 2400002).
      440         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      441     .
      442   end.
      443   function cur-time-mjd-to-string returns character
      444   (input p-mjd-diff as decimal
      445   )
      446   :
      447     define variable v-day-number as integer   no-undo .
      448     define variable v-seconds    as integer   no-undo .
      449     define variable v-hour       as integer   no-undo .
      450     define variable v-min        as integer   no-undo .
      451     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      452     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      453     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      454     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      455     if p-mjd-diff < 0
      456     or p-mjd-diff = ?
      457     then do:
      458       return "?" .
      459     end.
      460     assign
      461       v-day-number = integer(truncate(p-mjd-diff,0))
      462       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      463     .
      464     if v-seconds > 86400
      465     then do:
      466       assign
      467         v-seconds = 86400 - 1
      468       .
      469     end.
      470     if v-seconds < 0
      471     then do:
      472       assign
      473         v-seconds = 0
      474       .
      475     end.
      476     assign
      477       v-hour = truncate(v-seconds / 3600, 0)
      478     .
      479     assign
      480       v-seconds = v-seconds modulo 3600
      481     .
      482     assign
      483       v-min = truncate(v-seconds / 60, 0)
      484     .
      485     assign
      486       v-seconds = v-seconds modulo 60
      487     .
      488     return
      489         (if v-day-number <> 0
      490           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      491           else ""
      492         )
      493       + (if v-day-number <> 0 or v-hour <> 0
      494           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      495           else ""
      496         )
      497       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      498           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      499           else ""
      500         )
      501       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      502       .
      503   end.
      504   function cur-time-string returns character
      505   :
      506     define variable v-date as date      no-undo .
      507     define variable v-time as integer   no-undo .
      508     run cur-time in this-procedure
      509       (output v-date
      510       ,output v-time
      511       ) .
      512     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      513   end.
      514   function cur-time-string-sec returns character
      515   :
      516     define variable v-date as date      no-undo .
      517     define variable v-time as integer   no-undo .
      518     run cur-time in this-procedure
      519       (output v-date
      520       ,output v-time
      521       ) .
      522     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      523   end.
      524   function cur-time-custom  returns character
      525   (input p-prefix as character
      526   ,input p-date-format as character
      527   ,input p-delimiter as character
      528   ,input p-time-format as character
      529   ,input p-suffix as character
      530   )
      531   :
      532     define variable v-date as date      no-undo .
      533     define variable v-time as integer   no-undo .
      534     run cur-time in this-procedure
      535       (output v-date
      536       ,output v-time
      537       ) .
      538     return
      539       p-prefix
      540       + string(v-date, p-date-format)
      541       + p-delimiter
      542       + string(v-time, p-time-format)
      543       + p-suffix
      544       .
      545   end.
      546   function cur-time-print  returns character
      547   :
      548     define variable v-date as date      no-undo .
      549     define variable v-time as integer   no-undo .
      550     run cur-time in this-procedure
      551       (output v-date
      552       ,output v-time
      553       ) .
      554     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      555   end.
      556   function cur-time-datetime returns datetime
      557   :
      558     define variable v-char as character no-undo .
      559     define variable v-datetime as datetime no-undo .
      560     v-char = cur-time-string().
      561     v-datetime = datetime(v-char).
      562     return  v-datetime.
      563   end.
      564   function cur-time-string-msec returns character
      565   :
      566     define variable v-date as datetime  no-undo .
      567     v-date = now.
      568     return string(v-date) .
      569   end.
      570   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   procedure sys-time_get-sys :
      572     define output parameter p-year         as integer   no-undo .
      573     define output parameter p-month        as integer   no-undo .
      574     define output parameter p-day          as integer   no-undo .
      575     define output parameter p-hour         as integer   no-undo .
      576     define output parameter p-minute       as integer   no-undo .
      577     define output parameter p-second       as integer   no-undo .
      578     define output parameter p-milliseconds as integer   no-undo .
      579     define variable v-system-time-structure as memptr    no-undo.
      580     do
      581     on error undo, return error return-value
      582     :
      583       assign
      584         set-size(v-system-time-structure) = 16
      585       .
      586       run GetSystemTime
      587         (input  get-pointer-value(v-system-time-structure)
      588         ) .
      589       assign
      590         p-year         = get-short(v-system-time-structure,  1)
      591         p-month        = get-short(v-system-time-structure,  3)
      592         p-day          = get-short(v-system-time-structure,  7)
      593         p-hour         = get-short(v-system-time-structure,  9)
      594         p-minute       = get-short(v-system-time-structure, 11)
      595         p-second       = get-short(v-system-time-structure, 13)
      596         p-milliseconds = get-short(v-system-time-structure, 15)
      597       .
      598       assign
      599         set-size(v-system-time-structure) = 0
      600       .
      601     end.
      602   end procedure.
      603   procedure sys-time_get-comp-user-name :
      604     define output parameter p-computer-name as character no-undo .
      605     define output parameter p-user-name     as character no-undo .
      606     define output parameter p-process-pid   as integer   no-undo .
      607     define variable v-return-value  as integer   no-undo .
      608     define variable v-buffer-length as integer   no-undo .
      609     define variable v-buffer-memptr as memptr    no-undo .
      610     do
      611     on error undo, return error return-value
      612     :
      613       assign
      614         v-buffer-length = 1024
      615         set-size(v-buffer-memptr) = v-buffer-length + 4
      616       .
      617       assign
      618         put-long(v-buffer-memptr, 1) = v-buffer-length
      619       .
      620       run GetComputerNameA
      621         (input  get-pointer-value(v-buffer-memptr) + 4
      622         ,input  get-pointer-value(v-buffer-memptr)
      623         ,output v-return-value
      624         ) .
      625       if v-return-value <> 0
      626       then do:
      627         assign
      628           p-computer-name = get-string(v-buffer-memptr, 5)
      629         .
      630       end.
      631       assign
      632         put-long(v-buffer-memptr, 1) = v-buffer-length
      633       .
      634       run GetUserNameA
      635         (input  get-pointer-value(v-buffer-memptr) + 4
      636         ,input  get-pointer-value(v-buffer-memptr)
      637         ,output v-return-value
      638         ) .
      639       if v-return-value <> 0
      640       then do:
      641         assign
      642           p-user-name = get-string(v-buffer-memptr, 5)
      643         .
      644       end.
      645       run GetCurrentProcessId
      646         (output p-process-pid
      647         ) .
      648       assign
      649         set-size(v-buffer-memptr) = 0
      650       .
      651     end.
      652   end procedure.
      653   procedure sys-time_get-http :
      654     define output parameter p-http-time as character no-undo .
      655     define variable v-year         as integer   no-undo .
      656     define variable v-month        as integer   no-undo .
      657     define variable v-day-of-week  as integer   no-undo .
      658     define variable v-day          as integer   no-undo .
      659     define variable v-hour         as integer   no-undo .
      660     define variable v-minute       as integer   no-undo .
      661     define variable v-second       as integer   no-undo .
      662     define variable v-milliseconds as integer   no-undo .
      663     do
      664     on error undo, return error return-value
      665     :
      666       run sys-time_get-sys in this-procedure
      667         (output v-year
      668         ,output v-month
      669         ,output v-day
      670         ,output v-hour
      671         ,output v-minute
      672         ,output v-second
      673         ,output v-milliseconds
      674         ) .
      675       assign
      676         v-day-of-week = weekday(date(v-month, v-day, v-year))
      677         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      678                     + ', ':u
      679                     + string(v-day, '99':u)
      680                     + ' ':u
      681                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      682                     + ' ':u
      683                     + string(v-year, '9999':u)
      684                     + ' ':u
      685                     + string(v-hour, '99':u)
      686                     + ':':u
      687                     + string(v-minute, '99':u)
      688                     + ':':u
      689                     + string(v-second, '99':u)
      690                     + ' ':u
      691                     + 'GMT':u
      692       .
      693     end.
      694   end procedure.
      695   procedure sys-time_set-sys :
      696     define input  parameter p-year         as integer   no-undo .
      697     define input  parameter p-month        as integer   no-undo .
      698     define input  parameter p-day          as integer   no-undo .
      699     define input  parameter p-hour         as integer   no-undo .
      700     define input  parameter p-minute       as integer   no-undo .
      701     define input  parameter p-second       as integer   no-undo .
      702     define input  parameter p-milliseconds as integer   no-undo .
      703     define variable v-system-time-structure as memptr    no-undo.
      704     define variable v-return-value as integer   no-undo .
      705     define variable v-day-of-week  as integer   no-undo .
      706     do
      707     on error undo, return error return-value
      708     :
      709       assign
      710         v-day-of-week = weekday(date(p-month, p-day, p-year))
      711       .
      712       assign
      713         set-size(v-system-time-structure) = 16
      714       .
      715       assign
      716         put-short(v-system-time-structure,  1) = p-year
      717         put-short(v-system-time-structure,  3) = p-month
      718         put-short(v-system-time-structure,  5) = v-day-of-week
      719         put-short(v-system-time-structure,  7) = p-day
      720         put-short(v-system-time-structure,  9) = p-hour
      721         put-short(v-system-time-structure, 11) = p-minute
      722         put-short(v-system-time-structure, 13) = p-second
      723         put-short(v-system-time-structure, 15) = p-milliseconds
      724       .
      725       run SetSystemTime
      726         (input  get-pointer-value(v-system-time-structure)
      727         ,output v-return-value
      728         ) .
      729       assign
      730         set-size(v-system-time-structure) = 0
      731       .
      732       if v-return-value = 0
      733       then do:
      734         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      735       end.
      736     end.
      737   end procedure.
      738   procedure sys-time_sys-to-mjd :
      739     define input  parameter p-year         as integer   no-undo .
      740     define input  parameter p-month        as integer   no-undo .
      741     define input  parameter p-day          as integer   no-undo .
      742     define input  parameter p-hour         as integer   no-undo .
      743     define input  parameter p-minute       as integer   no-undo .
      744     define input  parameter p-second       as integer   no-undo .
      745     define input  parameter p-milliseconds as integer   no-undo .
      746     define output parameter p-mjd          as decimal   no-undo .
      747     define variable v-year-correction as decimal   no-undo .
      748     define variable v-shift-year as decimal   no-undo .
      749     do
      750     on error undo, return error return-value
      751     :
      752       assign
      753         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      754         v-shift-year      = decimal(p-year) + v-year-correction
      755         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      756               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      757               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      758               + decimal(p-day) - 2432076.0
      759               + p-hour / 24.0
      760               + p-minute / 1440.0
      761               + p-second / 86400.0
      762               + p-milliseconds / 86400000.0
      763       .
      764     end.
      765   end procedure.
      766   procedure sys-time_sys-to-loc :
      767     define input  parameter p-sys-year         as integer   no-undo .
      768     define input  parameter p-sys-month        as integer   no-undo .
      769     define input  parameter p-sys-day          as integer   no-undo .
      770     define input  parameter p-sys-hour         as integer   no-undo .
      771     define input  parameter p-sys-minute       as integer   no-undo .
      772     define input  parameter p-sys-second       as integer   no-undo .
      773     define input  parameter p-sys-milliseconds as integer   no-undo .
      774     define output parameter p-loc-year         as integer   no-undo .
      775     define output parameter p-loc-month        as integer   no-undo .
      776     define output parameter p-loc-day          as integer   no-undo .
      777     define output parameter p-loc-hour         as integer   no-undo .
      778     define output parameter p-loc-minute       as integer   no-undo .
      779     define output parameter p-loc-second       as integer   no-undo .
      780     define output parameter p-loc-milliseconds as integer   no-undo .
      781     define variable v-system-time-structure as memptr    no-undo.
      782     define variable v-return-value          as integer   no-undo .
      783     define variable v-sys-day-of-week       as integer   no-undo .
      784     do
      785     on error undo, return error return-value
      786     :
      787       assign
      788         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      789       .
      790       assign
      791         set-size(v-system-time-structure) = 32
      792       .
      793       assign
      794         put-short(v-system-time-structure,  1) = p-sys-year
      795         put-short(v-system-time-structure,  3) = p-sys-month
      796         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      797         put-short(v-system-time-structure,  7) = p-sys-day
      798         put-short(v-system-time-structure,  9) = p-sys-hour
      799         put-short(v-system-time-structure, 11) = p-sys-minute
      800         put-short(v-system-time-structure, 13) = p-sys-second
      801         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      802       .
      803       run SystemTimeToTzSpecificLocalTime
      804         (input  0
      805         ,input  get-pointer-value(v-system-time-structure)
      806         ,input  get-pointer-value(v-system-time-structure) + 16
      807         ,output v-return-value
      808         ) .
      809       assign
      810         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      811         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      812         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      813         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      814         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      815         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      816         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      817       .
      818       assign
      819         set-size(v-system-time-structure) = 0
      820       .
      821       if v-return-value = 0
      822       then do:
      823         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      824       end.
      825     end.
      826   end procedure.
      827   procedure sys-time_mjd-to-sys :
      828     define input  parameter p-mjd          as decimal   no-undo .
      829     define output parameter p-year         as integer   no-undo .
      830     define output parameter p-month        as integer   no-undo .
      831     define output parameter p-day          as integer   no-undo .
      832     define output parameter p-hour         as integer   no-undo .
      833     define output parameter p-minute       as integer   no-undo .
      834     define output parameter p-second       as integer   no-undo .
      835     define output parameter p-milliseconds as integer   no-undo .
      836     define variable v-year-correction as decimal   no-undo .
      837     define variable v-shift-year      as decimal   no-undo .
      838     define variable v-conv-date     as date      no-undo .
      839     define variable v-int-part      as integer   no-undo .
      840     define variable v-fraction-part as decimal   no-undo .
      841     do
      842     on error undo, return error return-value
      843     :
      844       assign
      845         v-int-part      = integer(truncate(p-mjd, 0))
      846         v-fraction-part = p-mjd - v-int-part
      847         v-conv-date     = date(11, 17, 1858) + v-int-part
      848         p-year          = year(v-conv-date)
      849         p-month         = month(v-conv-date)
      850         p-day           = day(v-conv-date)
      851         v-fraction-part = v-fraction-part * 24.0
      852         p-hour          = integer(truncate(v-fraction-part, 0))
      853         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      854         p-minute        = integer(truncate(v-fraction-part, 0))
      855         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      856         p-second        = integer(truncate(v-fraction-part, 0))
      857         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      858         p-milliseconds  = integer(v-fraction-part)
      859       .
      860     end.
      861   end procedure.
      862   procedure sys-time_mjd-to-loc :
      863     define input  parameter p-mjd              as decimal   no-undo .
      864     define output parameter p-loc-year         as integer   no-undo .
      865     define output parameter p-loc-month        as integer   no-undo .
      866     define output parameter p-loc-day          as integer   no-undo .
      867     define output parameter p-loc-hour         as integer   no-undo .
      868     define output parameter p-loc-minute       as integer   no-undo .
      869     define output parameter p-loc-second       as integer   no-undo .
      870     define output parameter p-loc-milliseconds as integer   no-undo .
      871     define variable v-sys-year         as integer   no-undo .
      872     define variable v-sys-month        as integer   no-undo .
      873     define variable v-sys-day          as integer   no-undo .
      874     define variable v-sys-hour         as integer   no-undo .
      875     define variable v-sys-minute       as integer   no-undo .
      876     define variable v-sys-second       as integer   no-undo .
      877     define variable v-sys-milliseconds as integer   no-undo .
      878     do
      879     on error undo, return error return-value
      880     :
      881       run sys-time_mjd-to-sys
      882         (input  p-mjd
      883         ,output v-sys-year
      884         ,output v-sys-month
      885         ,output v-sys-day
      886         ,output v-sys-hour
      887         ,output v-sys-minute
      888         ,output v-sys-second
      889         ,output v-sys-milliseconds
      890         ) .
      891       run sys-time_sys-to-loc
      892         (input  v-sys-year
      893         ,input  v-sys-month
      894         ,input  v-sys-day
      895         ,input  v-sys-hour
      896         ,input  v-sys-minute
      897         ,input  v-sys-second
      898         ,input  v-sys-milliseconds
      899         ,output p-loc-year
      900         ,output p-loc-month
      901         ,output p-loc-day
      902         ,output p-loc-hour
      903         ,output p-loc-minute
      904         ,output p-loc-second
      905         ,output p-loc-milliseconds
      906         ) .
      907     end.
      908   end procedure.
      909   function sys-time_get-mjd-func returns decimal
      910   :
      911     define variable v-year         as integer   no-undo .
      912     define variable v-month        as integer   no-undo .
      913     define variable v-day          as integer   no-undo .
      914     define variable v-hour         as integer   no-undo .
      915     define variable v-minute       as integer   no-undo .
      916     define variable v-second       as integer   no-undo .
      917     define variable v-milliseconds as integer   no-undo .
      918     define variable v-mjd          as decimal   no-undo .
      919     run sys-time_get-sys in this-procedure
      920       (output v-year
      921       ,output v-month
      922       ,output v-day
      923       ,output v-hour
      924       ,output v-minute
      925       ,output v-second
      926       ,output v-milliseconds
      927       ) .
      928     run sys-time_sys-to-mjd in this-procedure
      929       (input  v-year
      930       ,input  v-month
      931       ,input  v-day
      932       ,input  v-hour
      933       ,input  v-minute
      934       ,input  v-second
      935       ,input  v-milliseconds
      936       ,output v-mjd
      937       ) .
      938     return v-mjd .
      939   end function .
      940   function sys-time_get-sys-str-func returns character
      941   :
      942     define variable v-utc-time as character no-undo .
      943     define variable v-year         as integer   no-undo .
      944     define variable v-month        as integer   no-undo .
      945     define variable v-day          as integer   no-undo .
      946     define variable v-hour         as integer   no-undo .
      947     define variable v-minute       as integer   no-undo .
      948     define variable v-second       as integer   no-undo .
      949     define variable v-milliseconds as integer   no-undo .
      950     run sys-time_get-sys in this-procedure
      951       (output v-year
      952       ,output v-month
      953       ,output v-day
      954       ,output v-hour
      955       ,output v-minute
      956       ,output v-second
      957       ,output v-milliseconds
      958       ) .
      959     assign
      960       v-utc-time  = 'UTC ':u
      961                   + string(v-year,         '9999':u)
      962                   + '/':u
      963                   + string(v-month,        '99':u)
      964                   + '/':u
      965                   + string(v-day,          '99':u)
      966                   + ' ':u
      967                   + string(v-hour,         '99':u)
      968                   + ':':u
      969                   + string(v-minute,       '99':u)
      970                   + ':':u
      971                   + string(v-second,       '99':u)
      972                   + ' ':u
      973                   + string(v-milliseconds, '999':u)
      974     .
      975     return v-utc-time.
      976   end function .
      977   function sys-time_mjd-to-loc-str-func returns character
      978     (v-sys-mjd as decimal)
      979   :
      980     define variable v-loc-str          as character no-undo .
      981     define variable v-loc-year         as integer   no-undo .
      982     define variable v-loc-month        as integer   no-undo .
      983     define variable v-loc-day          as integer   no-undo .
      984     define variable v-loc-hour         as integer   no-undo .
      985     define variable v-loc-minute       as integer   no-undo .
      986     define variable v-loc-second       as integer   no-undo .
      987     define variable v-loc-milliseconds as integer   no-undo .
      988     run sys-time_mjd-to-loc in this-procedure
      989       (input  v-sys-mjd
      990       ,output v-loc-year
      991       ,output v-loc-month
      992       ,output v-loc-day
      993       ,output v-loc-hour
      994       ,output v-loc-minute
      995       ,output v-loc-second
      996       ,output v-loc-milliseconds
      997       ) .
      998     assign
      999       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1000                             ,string(v-loc-day,    '99':U)
     1001                             ,string(v-loc-month,  '99':U)
     1002                             ,string(v-loc-year,   '9999':U)
     1003                             ,string(v-loc-hour,   '99':U)
     1004                             ,string(v-loc-minute, '99':U)
     1005                             )
     1006     .
     1007     return v-loc-str .
     1008   end function .
     1009   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
     1010   :
     1011     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
     1012   END PROCEDURE.
     1013   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
     1014   :
     1015     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
     1016     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
     1017   END PROCEDURE.
     1018   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
     1019   :
     1020     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
     1021     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
     1022   END PROCEDURE.
     1023   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
     1024   :
     1025     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
     1026     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
     1027     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
     1028     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
     1029   END PROCEDURE.
     1030   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
     1031   :
     1032     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
     1033     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
     1034     DEFINE RETURN PARAMETER ReturnValue AS LONG .
     1035   END PROCEDURE.
     1036   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
     1037   :
     1038     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
     1039     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
     1040     DEFINE RETURN PARAMETER ReturnValue AS LONG .
     1041   END PROCEDURE.
     1042   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
     1043   :
     1044     DEFINE RETURN PARAMETER RetVal          AS LONG.
     1045   END PROCEDURE.
     1046   function get-user-login returns character
     1047     ( p-user-id as character ) :
     1048     define variable v-user-login as character no-undo .
     1049     run procedure-get-user-login in this-procedure (
     1050         input p-user-id
     1051       , output v-user-login
     1052     ) .
     1053     return v-user-login .
     1054   end function.
     1055   procedure procedure-get-user-login :
     1056   define input  parameter p-user-id    as character no-undo .
     1057   define output parameter p-user-login as character no-undo .
     1058       define buffer buf_user-login for ub.user-login .
     1059   do
     1060   for buf_user-login
     1061   on error undo, return error return-value
     1062   :
     1063       assign
     1064           p-user-login = "":U
     1065       .
     1066       for each buf_user-login no-lock
     1067          where buf_user-login.user-id = p-user-id
     1068       by buf_user-login.db-num
     1069       :
     1070           assign
     1071               p-user-login = substitute( "&1&2&3"
     1072                                   , p-user-login
     1073                                   , ( if p-user-login = "":U then "":U else ",":U )
     1074                                   , buf_user-login.db-num )
     1075           .
     1076       end.
     1077   end.
     1078   end procedure.
     1079   procedure SetAttrUserId:
     1080      define input  parameter iDb-num      as integer   no-undo.
     1081      define input  parameter iUserId      as character no-undo.
     1082      define input  parameter iAttrCode    as character no-undo.
     1083      define input  parameter iAttrValue   as character no-undo.
     1084      define buffer user-login-attr  for ub.user-login-attr .
     1085      find first user-login-attr where user-login-attr.db-num    eq idb-num
     1086                                   and user-login-attr.user-id   eq iuserid
     1087                                   and user-login-attr.attr-code eq iAttrCode
     1088      exclusive-lock no-error.
     1089      if     not available user-login-attr
     1090         and iAttrValue ne ?
     1091      then do:
     1092         create user-login-attr.
     1093         assign
     1094            user-login-attr.db-num     = idb-num
     1095            user-login-attr.user-id    = iuserid
     1096            user-login-attr.attr-code  = iAttrCode
     1097         .
     1098      end.
     1099      if iAttrValue eq ?
     1100      then do:
     1101         if available ub.user-login-attr
     1102         then
     1103            delete ub.user-login-attr.
     1104      end.
     1105      else
     1106         user-login-attr.attr-value = iAttrValue.
     1107   end procedure.
     1108   function GetAttrUserId returns character (
     1109      input iDb-num      as integer  ,
     1110      input iUserId      as character,
     1111      input iAttrCode    as character):
     1112      define buffer user-login-attr  for ub.user-login-attr .
     1113      find first user-login-attr where user-login-attr.db-num    eq idb-num
     1114                                   and user-login-attr.user-id   eq iuserid
     1115                                   and user-login-attr.attr-code eq iAttrCode
     1116      no-lock no-error.
     1117      return if not available ub.user-login-attr then ? else ub.user-login-attr.attr-value.
     1118   end function.
     1119   procedure getAccountSetting :
     1120      define input  parameter i-user-id  as character no-undo.
     1121      define output parameter o-adm-Ubd  as logical no-undo init ?.
     1122      define output parameter v-adm-GBD  as logical no-undo.
     1123      define output parameter o-superAdm as logical no-undo.
     1124      define input-output parameter table for UserDbAdm .
     1125      define variable v-adm-Ubd-int as integer no-undo.
     1126      define buffer user-login for ub.user-login.
     1127      define buffer db         for ub.db.
     1128      define buffer user-account-attr for ub.user-account-attr.
     1129      find first user-login where user-login.db-num  eq 0
     1130                              and user-login.user-id eq i-user-id
     1131      no-lock no-error.
     1132      if available user-login
     1133      then
     1134         v-adm-gbd = user-login.user-administrator.
     1135      else
     1136         v-adm-gbd = ?.
     1137      for each userDbAdm:
     1138         delete userDbAdm.
     1139      end.
     1140      block-db:
     1141      for each db where db.db-num ne 0 no-lock:
     1142         if G#db-num ne 0
     1143            and G#db-num ne db.db-num
     1144         then
     1145            next block-db.
     1146         create UserDbAdm.
     1147         UserDbAdm.db-num = ub.db.db-num.
     1148         find first user-login where user-login.db-num  eq db.db-num
     1149                                 and user-login.user-id eq i-user-id
     1150         no-lock no-error.
     1151         if not available user-login
     1152         then
     1153            v-adm-Ubd-int = 2.
     1154         else if user-login.status_ eq 1
     1155         then do:
     1156            v-adm-Ubd-int = 2.
     1157             UserDbAdm.db-block = yes.
     1158             UserDbAdm.db-usr   = yes.
     1159         end.
     1160         else if user-login.user-administrator
     1161         then do:
     1162            UserDbAdm.db-adm = yes.
     1163            UserDbAdm.db-usr = yes.
     1164            if v-adm-Ubd-int eq 0
     1165            then
     1166               v-adm-Ubd-int = 1.
     1167            else if v-adm-Ubd-int eq 3
     1168            then do:
     1169               v-adm-Ubd-int = 2.
     1170            end.
     1171         end.
     1172         else do:
     1173            if available ub.user-login
     1174            then
     1175               UserDbAdm.db-usr = yes.
     1176            if v-adm-Ubd-int eq 0
     1177            then
     1178               v-adm-Ubd-int = 3.
     1179            else if v-adm-Ubd-int eq 1
     1180            then do:
     1181               v-adm-Ubd-int = 2.
     1182            end.
     1183         end.
     1184      end.
     1185      if  v-adm-Ubd-int eq 1
     1186      then
     1187         o-adm-Ubd = true.
     1188      else if v-adm-Ubd-int eq 3
     1189      then
     1190         o-adm-Ubd = false.
     1191      find first user-account-attr where user-account-attr.user-id  eq i-user-id
     1192                                     and user-account-attr.attr-code  eq "superADm"
     1193      no-lock no-error.
     1194      o-superAdm =  available user-account-attr and logical (user-account-attr.attr-value ) no-error.
     1195   end.
     1196   function check_alphanumeric returns character (
     1197   input ipwd as character ,
     1198   input itype as character ):
     1199      define variable vCharEng as character no-undo
     1200      init "abcdefghijklmnopqrstuvwxyz".
     1201      define variable vCharRus as character no-undo
     1202      init "йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЯЧСМИТЬБЮЁЭ".
     1203      define variable vi as integer no-undo.
     1204      define variable vdigitFl as logical no-undo.
     1205      define variable vCharEngFl as logical no-undo.
     1206      define variable vCharRusFl as logical no-undo.
     1207      define variable vCharSpeFl as logical no-undo.
     1208      define variable vTextNew as character no-undo.
     1209      define variable vTextOld as character no-undo.
     1210      vTextNew = ipwd.
     1211      vTextOld = vTextNew.
     1212      do vi = 0 to 9:
     1213         vTextNew = replace(vTextNew,string (vi),"").
     1214      end.
     1215      if length(vTextOld) ne length(vTextNew)
     1216      then
     1217         vdigitFL = yes.
     1218      vTextOld = vTextNew.
     1219      do vi = 1 to length(vCharEng):
     1220         vTextNew = replace(vtextNew,substring(vCharEng,vi,1),"").
     1221      end.
     1222      if length(vTextOld) ne length(vTextNew)
     1223      then
     1224         vCharEngFl = yes.
     1225      vTextOld = vTextNew.
     1226      do vi = 1 to length(vCharRus):
     1227         vTextNew = replace(vtextNew,substring(vCharRus,vi,1),"").
     1228      end.
     1229      if length(vTextOld) ne length(vTextNew)
     1230      then
     1231         vCharEngFl = yes.
     1232      if length(vTextNew) > 0
     1233      then
     1234         vCharSpeFl = yes.
     1235      define variable vReturn as character no-undo.
     1236      assign
     1237         vReturn = vReturn + ", " + "не содержит цифр"           when lookup ("digit",   itype) > 0 and not vdigitFl
     1238         vReturn = vReturn + ", " + "не содержит латинских букв" when lookup ("CharEng", itype) > 0 and not vCharEngFl
     1239         vReturn = vReturn + ", " + "не содержит русских букв"   when lookup ("CharRus", itype) > 0 and not vCharRusFl
     1240         vReturn = vReturn + ", " + "не содержит спец символов"  when lookup ("CharSpe", itype) > 0 and not vCharSpeFl
     1241         vReturn = vReturn + ", " + "не содержит символов"       when lookup ("Char",    itype) > 0 and not (vCharEngFl or vCharRusFl or vCharSpeFl)
     1242      .
     1243      vReturn = substring (vReturn,3) no-error.
     1244      return vReturn.
     1245   end.
     1246   procedure SaveLastPWD:
     1247      define input  parameter iDb-num as integer   no-undo.
     1248      define input  parameter iUserId as character no-undo.
     1249      define input  parameter IPWD    as character no-undo.
     1250      define buffer user-login-attr  for ub.user-login-attr .
     1251      find first user-login-attr where user-login-attr.db-num    eq idb-num
     1252                                   and user-login-attr.user-id   eq iuserid
     1253                                   and user-login-attr.attr-code eq "LastPWD"
     1254      exclusive-lock no-error.
     1255      if not available user-login-attr
     1256      then do:
     1257         create user-login-attr.
     1258         assign
     1259            user-login-attr.db-num     = idb-num
     1260            user-login-attr.user-id    = iuserid
     1261            user-login-attr.attr-code  = "LastPWD"
     1262            user-login-attr.attr-value = ipwd
     1263         .
     1264      end.
     1265      else do:
     1266         user-login-attr.attr-value = user-login.user-password-encoded + chr(5) + user-login-attr.attr-value .
     1267         if num-entries (user-login-attr.attr-value , chr(5)) > 50
     1268         then
     1269            user-login-attr.attr-value = substring (user-login-attr.attr-value,1,r-index(user-login-attr.attr-value, chr(5)) - 1).
     1270      end.
     1271   end procedure.
     1272   function  CheckLastPWD returns character  (
     1273      input  iDb-num    as integer  ,
     1274      input  iUserId    as character,
     1275      input  IPWD       as character,
     1276      input  Iadm       as logical ) :
     1277      define buffer user-login       for ub.user-login .
     1278      define buffer user-login-attr  for ub.user-login-attr .
     1279      define variable vError as character  no-undo.
     1280      define variable v-obyznumbukv as logical no-undo .
     1281      define variable v-minparol as integer no-undo .
     1282      define variable v-tth as handle no-undo .
     1283      define variable VadmSuff as character no-undo.
     1284      define variable v-param-type as character no-undo .
     1285      define variable v-value-character as character no-undo .
     1286      define variable v-value-date as date no-undo .
     1287      define variable v-value-decimal as decimal no-undo .
     1288      define variable v-value-integer as integer no-undo .
     1289      define variable v-value-logical as logical no-undo .
     1290      find first user-login where user-login.db-num    eq idb-num
     1291                              and user-login.user-id   eq iUserId
     1292      no-lock no-error.
     1293      if Iadm
     1294      then
     1295         VadmSuff = 'Adm':U.
     1296      run adm/shattri.p (
     1297           input "get":U
     1298           ,input  '':U
     1299           ,input  0
     1300           ,input  'staff':U
     1301           ,input  'minparol':U + VadmSuff
     1302           ,output v-value-character
     1303           ,output v-value-date
     1304           ,output v-value-decimal
     1305           ,output v-minparol
     1306           ,output v-value-logical
     1307           ,output v-param-type
     1308           ,input-output table-handle v-tth
     1309           )  .
     1310       if v-minparol <> 0  then do:
     1311          if length(ipwd) < v-minparol
     1312           then do:
     1313              vError = substitute ("Длина поля должна быть не менее &1" , v-minparol).
     1314           end.
     1315       end.
     1316       run adm/shattri.p (
     1317           input "get":U
     1318           ,input  '':U
     1319           ,input  0
     1320           ,input  'staff':U
     1321           ,input  'obyznumbukv':U + VadmSuff
     1322           ,output v-value-character
     1323           ,output v-value-date
     1324           ,output v-value-decimal
     1325           ,output v-value-integer
     1326           ,output v-obyznumbukv
     1327           ,output v-param-type
     1328           ,input-output table-handle v-tth
     1329           )  .
     1330      if v-obyznumbukv = true
     1331      then do:
     1332         if check_alphanumeric(ipwd,"Digit,Char") ne ""
     1333         then do:
     1334            vError = vError + (if vError eq "" then "" else ", " )
     1335                   + "В пароле должны содержаться буквы и цифры".
     1336         end.
     1337      end.
     1338      define variable v-encode-value as character no-undo.
     1339      define variable v-Lastpaswd    as integer no-undo.
     1340      run adm/pswd-enc.p
     1341         (input  encode(ipwd)
     1342         ,output v-encode-value
     1343         ).
     1344      v-encode-value = encode(v-encode-value).
     1345      run adm/shattri.p (
     1346           input "get":U
     1347           ,input  '':U
     1348           ,input  0
     1349           ,input  'staff':U
     1350           ,input  'LastPaswd':U + VadmSuff
     1351           ,output v-value-character
     1352           ,output v-value-date
     1353           ,output v-value-decimal
     1354           ,output v-Lastpaswd
     1355           ,output v-value-logical
     1356           ,output v-param-type
     1357           ,input-output table-handle v-tth
     1358           )  .
     1359      if v-Lastpaswd ne 0
     1360      then do:
     1361         define variable vLastPwd as character no-undo.
     1362         vLastPwd = GetAttrUserId(iDb-num, iUserId, "LastPWD").
     1363         if vLastPwd ne ?
     1364         then do:
     1365            define variable Vi as integer no-undo.
     1366            vi = lookup (v-encode-value,vLastPwd,chr(5)).
     1367            if     vi ne 0
     1368               and vi le v-Lastpaswd
     1369            then
     1370               vError = vError + (if vError eq "" then "" else ", " )
     1371                      + substitute ("пароль не должен совпадать с последими &1 паролями",v-Lastpaswd).
     1372         end.
     1373      end.
     1374      delete object v-tth.
     1375      return vError.
     1376   end function.
     1377   procedure availOneAdm:
     1378      define input-output parameter table for UserDbAdm.
     1379      define output parameter oAdm as logical no-undo.
     1380      find first UserDbAdm where UserDbAdm.db-adm no-lock no-error.
     1381      oadm = available UserDbAdm.
     1382   end.
     1383   procedure update-user-login:
     1384      define input  parameter i-db-num     as integer          no-undo.
     1385      define input  parameter i-user-id    as character        no-undo.
     1386      define input  parameter i-user-login as character no-undo.
     1387      define input  parameter i-max-discnt as decimal no-undo.
     1388      define input  parameter i-quest-print as logical no-undo.
     1389      define input  parameter i-encoded-pass as character no-undo.
     1390      define input  parameter i-nextcon as logical no-undo.
     1391      define input  parameter i-user-administrator as logical no-undo.
     1392      define input  parameter i-Manual     as logical no-undo.
     1393      define input  parameter i-adm-gbd as logical no-undo.
     1394      define input  parameter i-adm-ubd as logical no-undo.
     1395      define input-output parameter table for UserDbAdm.
     1396      define buffer buf_user-login        for user-login.
     1397      do
     1398   for buf_user-login
     1399   on error undo, return error
     1400   :
     1401           if     i-Manual
     1402              and G#db-num eq 0
     1403           then do:
     1404              if     i-adm-gbd ne ?
     1405              then do:
     1406                 do transaction
     1407                 on error undo, return error return-value
     1408                 :
     1409                     find first buf_user-login where buf_user-login.db-num             eq 0
     1410                                                 and buf_user-login.user-login         eq i-user-login
     1411                                                 and buf_user-login.status_            eq 0
     1412                                                 and buf_user-login.user-id            ne i-user-id
     1413                     no-lock no-error.
     1414                     if available buf_user-login
     1415                     then
     1416                        undo, return error "Уже есть такой логин в ГБД".
     1417                     find first buf_user-login where buf_user-login.db-num             = 0
     1418                                                 and buf_user-login.user-id            = i-user-id
     1419                     exclusive-lock no-error.
     1420                     if not available buf_user-login
     1421                     then do:
     1422                        create buf_user-login .
     1423                        assign
     1424                            buf_user-login.db-num             = 0
     1425                            buf_user-login.user-id            = i-user-id
     1426                            buf_user-login.status_            = 0
     1427                        .
     1428                     end.
     1429                     assign
     1430                         buf_user-login.user-login         = i-user-login
     1431                         buf_user-login.user-administrator = i-adm-gbd
     1432                         buf_user-login.max-discnt         = i-max-discnt
     1433                         buf_user-login.quest-print        = i-quest-print
     1434                         buf_user-login.user-password-encoded = i-encoded-pass
     1435                     .
     1436                     if i-nextcon ne ?
     1437                     then do:
     1438                        run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1439                     end.
     1440                     run addobj(buf_user-login.db-num,buf_user-login.user-id) no-error.
     1441                     if error-status:error
     1442                     then
     1443                        return error return-value.
     1444                 end.
     1445              end.
     1446              else do transaction on error undo, return error return-value:
     1447                  find first buf_user-login where buf_user-login.db-num             = 0
     1448                                              and buf_user-login.user-id            = i-user-id
     1449                  exclusive-lock no-error.
     1450                  if available buf_user-login
     1451                  then
     1452                     delete buf_user-login.
     1453              end.
     1454              if     i-adm-ubd ne ?
     1455              then do:
     1456                 do transaction
     1457                 on error undo, return error return-value
     1458                 :
     1459                     define variable vDbError as character no-undo.
     1460                     block-db:
     1461                     for each db where db.db-num ne 0
     1462                     no-lock:
     1463                        find first buf_user-login where buf_user-login.db-num             eq db.db-num
     1464                                                    and buf_user-login.user-login         eq i-user-login
     1465                                                    and buf_user-login.status_            eq 0
     1466                                                    and buf_user-login.user-id            ne i-user-id
     1467                        no-lock no-error.
     1468                        if available buf_user-login
     1469                        then do:
     1470                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1471                           next block-db.
     1472                        end.
     1473                        find first buf_user-login where buf_user-login.db-num             = db.db-num
     1474                                                    and buf_user-login.user-id            = i-user-id
     1475                        exclusive-lock no-error.
     1476                        if not available buf_user-login
     1477                        then do:
     1478                           create buf_user-login .
     1479                           assign
     1480                               buf_user-login.db-num             = db.db-num
     1481                               buf_user-login.user-id            = i-user-id
     1482                               buf_user-login.status_            = 0
     1483                               buf_user-login.user-password-encoded = i-encoded-pass
     1484                           .
     1485                        end.
     1486                        assign
     1487                            buf_user-login.status_            = 0 when i-db-num ne G#db-num
     1488                            buf_user-login.user-login         = i-user-login
     1489                            buf_user-login.user-administrator = i-adm-ubd
     1490                            buf_user-login.max-discnt         = i-max-discnt
     1491                            buf_user-login.quest-print        = i-quest-print
     1492                        .
     1493                        if i-nextcon ne ?
     1494                        then do:
     1495                           run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1496                        end.
     1497                        run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1498                        if error-status:error
     1499                        then
     1500                           return error return-value.
     1501                    end.
     1502                    if vDbError ne ""
     1503                    then
     1504                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1505                 end.
     1506              end.
     1507              else do:
     1508                 do transaction
     1509                 on error undo, return error return-value
     1510                 :
     1511                     block-UserDb:
     1512                     for each UserDbAdm where UserDbAdm.db-num ne 0
     1513                     no-lock:
     1514                        find first buf_user-login where buf_user-login.db-num             eq UserDbAdm.db-num
     1515                                                    and buf_user-login.user-login         eq i-user-login
     1516                                                    and buf_user-login.status_            eq 0
     1517                                                    and buf_user-login.user-id            ne i-user-id
     1518                        no-lock no-error.
     1519                        if available buf_user-login and UserDbAdm.db-usr
     1520                        then do:
     1521                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1522                           next block-UserDb.
     1523                        end.
     1524                        find first buf_user-login where buf_user-login.db-num             = UserDbAdm.db-num
     1525                                                    and buf_user-login.user-id            = i-user-id
     1526                        exclusive-lock no-error.
     1527                        if UserDbAdm.db-usr
     1528                        then do:
     1529                           if not available buf_user-login
     1530                           then do:
     1531                              create buf_user-login .
     1532                              assign
     1533                                  buf_user-login.db-num             = UserDbAdm.db-num
     1534                                  buf_user-login.user-id            = i-user-id
     1535                                  buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0
     1536                                  buf_user-login.user-password-encoded = i-encoded-pass
     1537                              .
     1538                           end.
     1539                           assign
     1540                               buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0 when i-db-num ne G#db-num or G#db-num = 0
     1541                               buf_user-login.user-login         = i-user-login
     1542                               buf_user-login.user-administrator = UserDbAdm.db-adm
     1543                               buf_user-login.max-discnt         = i-max-discnt
     1544                               buf_user-login.quest-print        = i-quest-print
     1545                           .
     1546                           if i-nextcon ne ?
     1547                           then do:
     1548                              run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1549                           end.
     1550                           if UserDbAdm.db-adm
     1551                           then do:
     1552                              run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1553                              if error-status:error
     1554                              then
     1555                                 undo, return error return-value.
     1556                           end.
     1557                       end.
     1558                       else do:
     1559                          if available buf_user-login
     1560                          then do:
     1561                             define variable vok as logical no-undo.
     1562                             run procedure-user-login-delete-question (UserDbAdm.db-num,i-user-id, no, output vok).
     1563                             if not vok
     1564                             then
     1565                                undo, return error return-value.
     1566                          end.
     1567                       end.
     1568                    end.
     1569                     if vDbError ne ""
     1570                     then
     1571                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1572                 end.
     1573              end.
     1574           end.
     1575           else do transaction
     1576           on error undo, return error return-value
     1577           :
     1578              find first buf_user-login where buf_user-login.db-num             = i-db-num
     1579                                          and buf_user-login.user-id            = i-user-id
     1580              exclusive-lock no-error.
     1581              if not available buf_user-login
     1582              then do:
     1583                 create buf_user-login .
     1584                 assign
     1585                    buf_user-login.db-num             = i-db-num
     1586                    buf_user-login.user-id            = i-user-id
     1587                    buf_user-login.status_            = 0
     1588                 .
     1589              end.
     1590              assign
     1591                   buf_user-login.user-login         = i-user-login
     1592                   buf_user-login.user-administrator = i-user-administrator
     1593                   buf_user-login.max-discnt         = i-max-discnt
     1594                   buf_user-login.quest-print        = i-quest-print
     1595                   buf_user-login.user-password-encoded = i-encoded-pass
     1596               .
     1597               if i-user-administrator
     1598               then
     1599                  run addobj(buf_user-login.db-num,buf_user-login.user-id).
     1600               if i-nextcon ne ?
     1601               then do:
     1602                  run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1603               end.
     1604           end.
     1605       end.
     1606   end procedure.
     1607   procedure addobj:
     1608      define input  parameter i-db-num as integer no-undo.
     1609      define input  parameter i-user-id as character no-undo.
     1610      define buffer buf_user-obj     for ub.user-obj.
     1611      define buffer buf_clients      for ub.clients.
     1612      if i-db-num <> 0 then do:
     1613          for each buf_clients
     1614              where buf_clients.db-num = i-db-num
     1615              and ( buf_clients.obj-type = 'маг':U
     1616                 or buf_clients.obj-type = 'скл':U
     1617                  )
     1618              no-lock:
     1619             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1620                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1621                                     and buf_user-obj.user-id      = i-user-id
     1622                                     and buf_user-obj.db-num       = i-db-num
     1623                                   no-lock)
     1624                                   then next.
     1625             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1626          end.
     1627       end.
     1628       else do:
     1629          for each buf_clients
     1630              where
     1631                  ( buf_clients.obj-type = 'маг':U
     1632                 or buf_clients.obj-type = 'скл':U
     1633                  )
     1634              no-lock:
     1635             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1636                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1637                                     and buf_user-obj.user-id      = i-user-id
     1638                                     and buf_user-obj.db-num       = i-db-num
     1639                                   no-lock)
     1640                                   then next.
     1641             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1642          end.
     1643       end.
     1644   end.
     1645   procedure enbl-obj :
     1646      define input  parameter i-db-num  as integer   no-undo.
     1647      define input  parameter i-user-id as character no-undo.
     1648      define input  parameter i-type    as character no-undo.
     1649      define input  parameter i-code    as integer   no-undo.
     1650       define variable v-host-code    as integer      no-undo.
     1651       define variable v-host-name    as character    no-undo.
     1652       define variable v-base-code    as integer      no-undo.
     1653       define buffer buf_user-obj      for ub.user-obj.
     1654       define buffer buf_user-host     for ub.user-host.
     1655       define buffer buf_clients       for ub.clients.
     1656   do
     1657   for buf_user-obj
     1658     , buf_user-host
     1659     , buf_clients
     1660   on error undo, return error
     1661   :
     1662       find first buf_user-obj exclusive-lock
     1663            where buf_user-obj.db-num    = i-db-num
     1664              and buf_user-obj.user-id   = i-user-id
     1665              and buf_user-obj.obj-type  = i-type
     1666              and buf_user-obj.obj-code  = i-code
     1667       no-error.
     1668       if not available buf_user-obj
     1669       then do:
     1670           find first buf_clients no-lock
     1671                where buf_clients.obj-type = i-type
     1672                  and buf_clients.obj-code = i-code
     1673           .
     1674   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1676     (input  i-type
     1677     ,input  i-code
     1678     ,output v-host-code
     1679     ,output v-host-name
     1680     )  .
     1681   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1683     (input  v-host-code
     1684     ,output v-base-code
     1685     )  .
     1686           create buf_user-obj.
     1687           assign
     1688               buf_user-obj.db-num    = i-db-num
     1689               buf_user-obj.user-id   = i-user-id
     1690               buf_user-obj.obj-type  = i-type
     1691               buf_user-obj.obj-code  = i-code
     1692               buf_user-obj.host-code = v-host-code
     1693           .
     1694           find first buf_user-host exclusive-lock
     1695                where buf_user-host.db-num    = i-db-num
     1696                  and buf_user-host.user-id   = i-user-id
     1697                  and buf_user-host.host-code = v-host-code
     1698           no-error.
     1699           if not available buf_user-host
     1700           then do:
     1701               create buf_user-host.
     1702               assign
     1703                   buf_user-host.db-num    = i-db-num
     1704                   buf_user-host.user-id   = i-user-id
     1705                   buf_user-host.host-code = v-host-code
     1706               .
     1707           end.
     1708      end.
     1709   end.
     1710   end procedure.
     1711   procedure procedure-user-login-change-password :
     1712      define input  parameter p-db-num         as integer          no-undo.
     1713      define input  parameter p-user-id        as character        no-undo.
     1714      define input  parameter iChange          as logical          no-undo.
     1715      define variable v-can-edit         as logical   no-undo .
     1716      define variable v-encoded-pass     as character no-undo .
     1717      define variable v-encoded-pass-old as character no-undo .
     1718      define variable v-nextcon          as logical   no-undo .
     1719      define variable VadmSuff           as character no-undo.
     1720      define variable vChange as logical no-undo.
     1721      define variable v-param-type as character no-undo .
     1722      define variable v-value-character as character no-undo .
     1723      define variable v-value-date as date no-undo .
     1724      define variable v-value-decimal as decimal no-undo .
     1725      define variable v-value-integer as integer no-undo .
     1726      define variable v-value-logical as logical no-undo .
     1727      define variable v-tth           as handle  no-undo .
     1728      define buffer buf_lock_user-login for user-login.
     1729      define buffer buf_init_user-account for user-account.
     1730      do:
     1731         find first buf_lock_user-login no-lock
     1732                 where buf_lock_user-login.db-num  = p-db-num
     1733                   and buf_lock_user-login.user-id = p-user-id
     1734         no-error.
     1735         if not available buf_lock_user-login then do:
     1736            message
     1737               "Нельзя редактировать пароль пока не заведен логин для пользователя" skip
     1738               view-as alert-box error .
     1739               undo, return error "Нельзя редактировать пароль пока не заведен логин для пользователя" .
     1740         end.
     1741         vChange = buf_lock_user-login.user-login eq userid ("ub") or iChange.
     1742         if     available buf_lock_user-login
     1743            and buf_lock_user-login.user-administrator
     1744         then
     1745            VadmSuff = 'Adm':U.
     1746         define variable v-TimeAvail as integer no-undo.
     1747         define variable v-DateChg   as date    no-undo.
     1748         define variable v-Time      as integer no-undo.
     1749         run cur-time-mjd-to-date (buf_lock_user-login.user-password-set-mjd, output v-DateChg, output v-Time).
     1750         run adm/shattri.p (
     1751              input "get":U
     1752              ,input  '':U
     1753              ,input  0
     1754              ,input  'staff':U
     1755              ,input  'TimeBlock':U + VadmSuff
     1756              ,output v-value-character
     1757              ,output v-value-date
     1758              ,output v-value-decimal
     1759              ,output v-TimeAvail
     1760              ,output v-value-logical
     1761              ,output v-param-type
     1762              ,input-output table-handle v-tth
     1763              )  .
     1764         if     not iChange
     1765            and v-TimeAvail ne 0
     1766            and v-DateChg + v-TimeAvail < today
     1767         then do:
     1768            do trans:
     1769               find current buf_lock_user-login exclusive-lock.
     1770               buf_lock_user-login.status_ = 1.
     1771            end.
     1772            return error "Ваша учетная запись заблокирована." .
     1773         end.
     1774         run adm/shattri.p (
     1775              input "get":U
     1776              ,input  '':U
     1777              ,input  0
     1778              ,input  'staff':U
     1779              ,input  'TimeAvail':U + VadmSuff
     1780              ,output v-value-character
     1781              ,output v-value-date
     1782              ,output v-value-decimal
     1783              ,output v-TimeAvail
     1784              ,output v-value-logical
     1785              ,output v-param-type
     1786              ,input-output table-handle v-tth
     1787              )  .
     1788         delete object v-tth.
     1789         define variable vfl as logical no-undo.
     1790         vfl = logical(GetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect")) no-error.
     1791         if    vfl eq yes
     1792            or (     v-TimeAvail ne 0
     1793                 and v-DateChg + v-TimeAvail < today)
     1794            or iChange
     1795         then do:
     1796             find first buf_init_user-account where buf_init_user-account.user-id = buf_lock_user-login.user-id
     1797             no-lock.
     1798             assign
     1799             v-encoded-pass-old = buf_lock_user-login.user-password-encoded
     1800             v-encoded-pass     = buf_lock_user-login.user-password-encoded.
     1801             do while v-encoded-pass = v-encoded-pass-old or v-encoded-pass eq ?:
     1802                v-encoded-pass = v-encoded-pass-old.
     1803                run adm/chg-pswd.w ( input  this-procedure
     1804                                   , input  p-db-num
     1805                                   , input  buf_lock_user-login.user-id
     1806                                   , input  buf_lock_user-login.user-login
     1807                                   , input  substitute('&1 &2 &3':U, buf_init_user-account.last-name
     1808                                                                   , buf_init_user-account.first-name
     1809                                                                   , buf_init_user-account.second-name
     1810                                          )
     1811                                   , input  iChange
     1812                                   , input  yes
     1813                                   , input  buf_lock_user-login.user-password-encoded
     1814                                   , input  yes
     1815                                   , input  buf_lock_user-login.user-administrator
     1816                                   , output v-encoded-pass
     1817                                   , output v-nextcon
     1818                                   ) no-error .
     1819               if error-status :error
     1820               then do:
     1821                 message
     1822                    vss-workfile vss-revision vss-description skip
     1823                    "Ошибка при вызове процедуры" 'adm/chg-pswd.w':U skip
     1824                    error-status :get-message(1) skip
     1825                    return-value skip
     1826                    view-as alert-box error .
     1827                 undo, return error return-value .
     1828                end.
     1829                if    v-encoded-pass = v-encoded-pass-old
     1830                then do:
     1831                    message
     1832                       vss-workfile vss-revision vss-description skip
     1833                       "Старый пароль и новый равны. Смените пароль.":U skip
     1834                       error-status :get-message(1) skip
     1835                       return-value skip
     1836                       view-as alert-box error .
     1837                end.
     1838                else if v-encoded-pass eq ?
     1839                then do:
     1840                   message  "Отказ от смены пароля. Работа дальше не возможна"
     1841                   view-as alert-box error.
     1842                   return error "Отказ от смены пароля. Работа дальше не возможна".
     1843                end.
     1844             end.
     1845             if v-encoded-pass <> ? then
     1846             do trans:
     1847                find current buf_lock_user-login
     1848                      exclusive-lock
     1849                   .
     1850                assign
     1851                   buf_lock_user-login.user-password-encoded = v-encoded-pass
     1852                .
     1853                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect", if vChange then v-nextcon else ?).
     1854                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdUserId", string(g#userid)).
     1855                release buf_lock_user-login .
     1856                message
     1857                   "Пароль успешно изменен"
     1858                   view-as alert-box information
     1859                .
     1860             end.
     1861          end.
     1862      end.
     1863   end procedure.
     1864   procedure procedure-user-login-delete :
     1865      define input  parameter i-db-num     as integer          no-undo.
     1866      define input  parameter i-user-id    as character        no-undo.
     1867      define output parameter o-deleted   as logical          no-undo.
     1868      run procedure-user-login-delete-question (i-db-num,i-user-id,yes,output o-deleted).
     1869   end.
     1870   procedure procedure-user-login-delete-question :
     1871   define input  parameter i-db-num     as integer          no-undo.
     1872   define input  parameter i-user-id    as character        no-undo.
     1873   define input  parameter i-question as logical no-undo.
     1874   define output parameter o-deleted   as logical          no-undo.
     1875     define variable v-can-edit as logical   no-undo .
     1876       define buffer buf_user-login         for user-login .
     1877       define buffer buf_user-account       for user-account.
     1878       define buffer buf_init_user-account  for user-account.
     1879   do
     1880   for buf_user-login
     1881     , buf_user-account
     1882   on error undo, return error return-value
     1883   :
     1884       assign
     1885           o-deleted = no
     1886       .
     1887       find first buf_init_user-account no-lock
     1888            where buf_init_user-account.user-id = i-user-id
     1889           .
     1890       if available buf_init_user-account
     1891       then do:
     1892         do transaction
     1893         on error undo, return error return-value
     1894         :
     1895           run can-edit-login in this-procedure (
     1896                 input  i-db-num
     1897               , output v-can-edit
     1898           ).
     1899           if v-can-edit <> true
     1900           then do:
     1901             message
     1902               "Нельзя удалять логин пользователя для базы" i-db-num
     1903             view-as alert-box error .
     1904             undo, return error return-value .
     1905           end.
     1906           find first buf_user-login exclusive-lock
     1907                where buf_user-login.db-num  = i-db-num
     1908                  and buf_user-login.user-id = i-user-id
     1909           no-error no-wait.
     1910           if not available buf_user-login
     1911           then do:
     1912             if locked( buf_user-login )
     1913             then do:
     1914               find first buf_user-login no-lock
     1915                    where buf_user-login.db-num  = i-db-num
     1916                      and buf_user-login.user-id = i-user-id
     1917               .
     1918               message
     1919                 "Удаление логина невозможно" skip
     1920                 "Пользователь в данный момент работает в системе" skip
     1921                 "БД" i-db-num skip
     1922                 "Идентификатор" i-user-id skip
     1923                 "Псевдоним"                    buf_init_user-account.nik skip
     1924                 "Имя пользователя"             buf_init_user-account.last-name buf_init_user-account.first-name buf_init_user-account.second-name skip
     1925                 "Компьютер"                    buf_user-login.last-login-computer-name skip
     1926                 "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     1927                 "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     1928                 "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     1929                 "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     1930                 "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     1931                 "Дата и время входа в систему" sys-time_mjd-to-loc-str-func( buf_user-login.last-login-mjd ) skip
     1932                 view-as alert-box error .
     1933             end.
     1934             else do:
     1935               message
     1936                 "У пользователя нет логина" skip
     1937                 "БД" i-db-num skip
     1938                 "Идентификатор" i-user-id skip
     1939                 "Удаление невозможно" skip
     1940                 view-as alert-box error .
     1941             end.
     1942             undo, return error return-value .
     1943           end.
     1944           define variable v-ok as logical   no-undo .
     1945           if not i-question
     1946           then
     1947              v-ok = yes.
     1948           else do:
     1949              find first buf_user-account no-lock
     1950                   where buf_user-account.user-id = buf_user-login.user-id
     1951              .
     1952              message
     1953                "Удаление логина пользователя"
     1954                skip "Идентификатор" buf_user-account.user-id
     1955                skip "Псевдоним"    buf_user-account.nik
     1956                skip "Пользователь" buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name
     1957                skip "Логин для базы данных" buf_user-login.db-num
     1958                skip "Логин" buf_user-login.user-login
     1959                skip (1)
     1960                "После удаления пользователь не сможет работать в базе данных" buf_user-login.db-num skip
     1961                skip (1)
     1962                "Продолжить?"
     1963              view-as alert-box question
     1964              buttons yes-no
     1965              update v-ok .
     1966           end.
     1967           if v-ok = yes
     1968           then do:
     1969               run str/usrlog03.p (
     1970                     input buf_user-login.db-num
     1971                   , input buf_user-login.user-id
     1972               ).
     1973               assign
     1974                   o-deleted = yes
     1975               .
     1976           end.
     1977         end.
     1978       end.
     1979     end.
     1980   end procedure.
     1981   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1982   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1983   define variable mProwin32FileName as character no-undo.
     1984   define variable mRunProcFile as character no-undo.
     1985   define variable isRcode as logical no-undo.
     1986   define variable mCmd as character no-undo.
     1987   define variable mConPar as character no-undo.
     1988   define variable logdir as character no-undo.
     1989   define variable v-sys-key   as character         no-undo.
     1990   define variable varpar-type as character no-undo.
     1991   function put-log returns character (input itext as character ) forward.
     1992   define temp-table tempUserCopy no-undo like _User.
     1993   procedure SetPwdsysadm :
     1994         get-key-value section "rep-sets" key "logDir"    value logDir .
     1995         if logDir = ?
     1996         then do :
     1997            logDir = ".\" .
     1998         end .
     1999         else do :
     2000            logDir = right-trim(logDir, "\") .
     2001            logDir = right-trim(logDir, "/") .
     2002            logDir = logDir + "\" .
     2003         end.
     2004         define variable mnewpas as character no-undo.
     2005         define variable mcurpas as character no-undo.
     2006         mnewpas = pasNew()::pasw.
     2007         mcurpas = pasCur()::pasw.
     2008         find first _user no-lock
     2009                       where _user._userid    = mloginsysadm
     2010                       no-error
     2011                       .
     2012         if not available _user
     2013         then do trans:
     2014            create _user .
     2015            assign
     2016               _user._userid    = mloginsysadm
     2017               _user._password  = encode(mnewpas)
     2018            .
     2019         end.
     2020         else do:
     2021            if _User._Password eq encode(mnewpas)
     2022            then do:
     2023               put-log("Cмена пароля пользователя " + mloginsysadm + " не требуется.").
     2024               return.
     2025            end.
     2026            else do:
     2027               put-log("Начинаем смену пароля " + mloginsysadm + ".").
     2028            end.
     2029            if _User._Password eq encode(mcurpas)
     2030            then do:
     2031               put-log("Подключаемся пользователем " + mloginsysadm + " и меняем свой пароль.").
     2032               mProwin32FileName =  search ("bin/prowin32.exe").
     2033               mRunProcFile = search ("utl/setmypwd.r").
     2034               if mRunProcFile <> ?
     2035               then
     2036                  isRcode = true.
     2037               else
     2038                  mRunProcFile = search ("utl/setmypwd.p").
     2039               get-key-value section "REP-SETS" key "ConPar" value mConPar.
     2040               release _User.
     2041               mConPar = substitute(mConPar, "-U ":U + mloginsysadm + " -P " + mcurpas).
     2042               if isRcode
     2043               then mCMD = substitute ("&1 &2  -rx -p &3 -b -param &4",mprowin32FileName, mConPar, mRunProcFile, mnewpas).
     2044               else mCMD = substitute ("&1 &2      -p &3 -b -param &4",mprowin32FileName, mConPar, mRunProcFile, mnewpas).
     2045               os-command silent value (mcmd).
     2046            end.
     2047            find first _user no-lock
     2048                       where _user._userid    = mloginsysadm
     2049                       no-error
     2050                       .
     2051            if _User._Password eq encode(mnewpas)
     2052            then do:
     2053               run trg/userlog.p (
     2054                     input 'sysadm-pwd'
     2055                   , input ("Изменен пароль пользователя " + mloginsysadm + chr(3) + _user._userid )
     2056                   , input ?
     2057                   , input ?
     2058                   , input "") no-error.
     2059               put-log("У пользователя mloginsysadm Установлен новый пароль.").
     2060            end.
     2061            else do trans:
     2062               find first _user exclusive-lock
     2063                    where _user._userid    = mloginsysadm
     2064               no-error.
     2065               buffer-copy _User except _User._TenantId _User._Password to tempUserCopy
     2066               assign tempUserCopy._Password = encode(mnewpas).
     2067               delete _User.
     2068               create _User.
     2069               buffer-copy tempUserCopy except tempUserCopy._TenantId to _User.
     2070               run trg/userlog.p (
     2071                     input 'sysadm-pwd'
     2072                   , input ("Изменен пароль пользователя " + mloginsysadm + chr(3) + _user._userid )
     2073                   , input ?
     2074                   , input ?
     2075                   , input "") no-error.
     2076               put-log("У пользователя " + mloginsysadm + " установлен новый пароль.").
     2077            end.
     2078         end.
     2079   end.
     2080   if ichgpsw
     2081   then do:
     2082   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2083   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2084     (output v-sys-key
     2085     ) no-error .
     2086      if v-sys-key begins "Rosneft-" or v-sys-key eq "yukos" or v-sys-key eq "ibs" or v-sys-key eq   'ExpertekIBS':U
     2087      then do:
     2088         run SetPwdsysadm .
     2089         mloginsysadm = "odbc".
     2090         run SetPwdsysadm .
     2091         find first _file where _file._file-name eq "_user"
     2092         no-lock.
     2093         if    can-do(_file._Can-Create,"odbc")
     2094            or can-do(_file._Can-delete,"odbc")
     2095         then do trans:
     2096            find first _file where _file._file-name eq "_user"
     2097            exclusive-lock.
     2098            if can-do(_file._Can-Create,"odbc")
     2099            then
     2100               _file._Can-Create = "!odbc," + _file._Can-Create.
     2101            if can-do(_file._Can-delete,"odbc")
     2102            then
     2103               _file._Can-delete = "!odbc," + _file._Can-delete.
     2104         end.
     2105         do trans:
     2106            find first _user exclusive-lock
     2107                             where _user._userid    = "usr-flt"
     2108                        no-error.
     2109            if available _user
     2110            then
     2111               delete _user.
     2112         end.
     2113      end.
     2114      find first sys-ctrl  no-lock no-error.
     2115      find first _user no-lock
     2116           where _user._userid    =userid ("ub")
     2117           no-error
     2118           .
     2119      if available  _User
     2120      then do:
     2121         find first user-login where user-login.user-login eq userid ("ub")
     2122                                 and user-login.db-num     eq sys-ctrl.db-num
     2123         no-lock no-error.
     2124         if available user-login
     2125         then do:
     2126            run  procedure-user-login-change-password in this-procedure (sys-ctrl.db-num,user-login.user-id,no) no-error.
     2127            if error-status:error
     2128            then
     2129               return error return-value.
     2130         end.
     2131      end.
     2132   end.
     2133   else
     2134      run mylogin.
     2135   DEFINE TEMP-TABLE tempUser NO-UNDO LIKE
     2136   ub._User
     2137   .
     2138   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2139   procedure mylogin:
     2140      define variable vlogin as character no-undo.
     2141      define variable vPSwd  as character no-undo.
     2142      vlogin = objsrv:SystemSetting:CrLogin.
     2143      vPswd = objsrv:SystemSetting:CrPSWD.
     2144      if vlogin ne ""
     2145      then
     2146      MAIN-BLOCK:
     2147      do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2148         on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2149         find first sys-ctrl  no-lock.
     2150         define variable v-encode-value as character no-undo .
     2151         define variable v-user-id      as character no-undo .
     2152         run adm/pswd-enc.p ( input  encode( if vPswd ne ""
     2153                                             then vPswd
     2154                                             else vLogin
     2155                                             )
     2156                            , output v-encode-value
     2157                            ) .
     2158         v-encode-value = encode( v-encode-value ).
     2159         disable triggers for  load   of user-login .
     2160         disable triggers for  load   of user-account .
     2161         find first user-login
     2162              where user-login.db-num     = sys-ctrl.db-num
     2163                and user-login.user-login = vLogin
     2164         exclusive-lock no-wait no-error.
     2165         if not available user-login and not locked user-login
     2166         then do:
     2167            define variable v-count    as integer      no-undo.
     2168            for each  user-account
     2169                where user-account.user-id begins ( substitute ( '&1-':U
     2170                                                               ,  sys-ctrl.db-num
     2171                                                               )
     2172                                                  )
     2173            no-lock:
     2174               if v-count < INTEGER(entry(2, user-account.user-id, "-"))
     2175               then
     2176                  v-count = integer(entry(2, user-account.user-id, "-")).
     2177            end.
     2178            if v-count <= current-value(s-user-id, ub)
     2179            then do:
     2180               v-count = next-value(s-user-id, ub).
     2181            end.
     2182            else do:
     2183               current-value(s-user-id, ub) = v-count.
     2184            end.
     2185            v-user-id = substitute ( '&1-&2':U
     2186                                    , sys-ctrl.db-num
     2187                                    , v-count
     2188                                    ) .
     2189            create user-account .
     2190            assign
     2191               user-account.user-id      = v-user-id
     2192               user-account.last-name    = vlogin + " sysadm":U
     2193               user-account.nik          = vlogin + " sysadm":U
     2194               user-account.check-parent = false
     2195            .
     2196            create user-login.
     2197            assign
     2198               user-login.db-num                = sys-ctrl.db-num
     2199               user-login.user-id               = v-user-id
     2200            .
     2201            assign
     2202               user-login.user-login              = vlogin
     2203               user-login.user-password-encoded   = v-encode-value
     2204               user-login.user-administrator      = true
     2205               user-login.status_                 = 0
     2206               user-account.status_               = 0
     2207            .
     2208   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2209       if ub.user-login.status_ = 0
     2210       then do:
     2211         find first ub.user-account
     2212              where ub.user-account.user-id = ub.user-login.user-id
     2213              no-lock
     2214              no-error .
     2215         if not available ub.user-account
     2216         then do:
     2217           create ub.user-account.
     2218           assign
     2219               ub.user-account.user-id               = ub.user-login.user-id
     2220               ub.user-account.status_               = 0
     2221               ub.user-account.first-name            = '':U
     2222               ub.user-account.second-name           = '':U
     2223               ub.user-account.last-name             = ub.user-login.user-login
     2224               ub.user-account.nik                   = ub.user-login.user-login
     2225               ub.user-account.company               = '':U
     2226               ub.user-account.department            = '':U
     2227               ub.user-account.e-mail                = '':U
     2228               ub.user-account.internal-phone-number = '':U
     2229               ub.user-account.mobile-phone-number   = '':U
     2230               ub.user-account.phone-number          = '':U
     2231               ub.user-account.position              = '':U
     2232               ub.user-account.PS                    = '':U
     2233               ub.user-account.room                  = '':U
     2234               ub.user-account.parent-user-id        = '':U
     2235               ub.user-account.check-parent          = false
     2236           .
     2237         end.
     2238         else
     2239            ub.user-login.status_ = ub.user-account.status_.
     2240      end.
     2241      if ub.user-login.status_ = 0
     2242      then do:
     2243         find first ub._user
     2244              where ub._user._userid    = ub.user-login.user-login
     2245              no-error
     2246              .
     2247         if not available ub._user then do:
     2248            create ub._user .
     2249            assign
     2250               ub._user._userid    = ub.user-login.user-login
     2251               ub._user._password  = ub.user-login.user-password-encoded
     2252            .
     2253         end.
     2254         ELSE DO:
     2255            BUFFER-COPY ub._User EXCEPT ub._User._Password ub._User._TenantId TO tempUser ASSIGN tempUser._Password = ub.user-login.user-password-encoded
     2256            .
     2257            DELETE ub._User.
     2258            CREATE ub._User.
     2259            BUFFER-COPY tempUser EXCEPT tempUser._TenantId TO _User.
     2260         END.
     2261         assign
     2262           ub._user._user-name = substitute('&1 &2 &3'
     2263                                           ,ub.user-account.last-name
     2264                                           ,ub.user-account.first-name
     2265                                           ,ub.user-account.second-name
     2266                                           )
     2267         .
     2268         release _user.
     2269       end.
     2270         end.
     2271         else do:
     2272            find first  user-account
     2273                where user-account.user-id eq user-login.user-id
     2274                  and user-account.status_ ne 0
     2275            exclusive-lock no-error.
     2276            if avail user-account
     2277            then do:
     2278               assign
     2279                  user-login.status_                 = 0
     2280                  user-account.status_               = 0
     2281               .
     2282   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2283       if ub.user-login.status_ = 0
     2284       then do:
     2285         find first ub.user-account
     2286              where ub.user-account.user-id = ub.user-login.user-id
     2287              no-lock
     2288              no-error .
     2289         if not available ub.user-account
     2290         then do:
     2291           create ub.user-account.
     2292           assign
     2293               ub.user-account.user-id               = ub.user-login.user-id
     2294               ub.user-account.status_               = 0
     2295               ub.user-account.first-name            = '':U
     2296               ub.user-account.second-name           = '':U
     2297               ub.user-account.last-name             = ub.user-login.user-login
     2298               ub.user-account.nik                   = ub.user-login.user-login
     2299               ub.user-account.company               = '':U
     2300               ub.user-account.department            = '':U
     2301               ub.user-account.e-mail                = '':U
     2302               ub.user-account.internal-phone-number = '':U
     2303               ub.user-account.mobile-phone-number   = '':U
     2304               ub.user-account.phone-number          = '':U
     2305               ub.user-account.position              = '':U
     2306               ub.user-account.PS                    = '':U
     2307               ub.user-account.room                  = '':U
     2308               ub.user-account.parent-user-id        = '':U
     2309               ub.user-account.check-parent          = false
     2310           .
     2311         end.
     2312         else
     2313            ub.user-login.status_ = ub.user-account.status_.
     2314      end.
     2315      if ub.user-login.status_ = 0
     2316      then do:
     2317         find first ub._user
     2318              where ub._user._userid    = ub.user-login.user-login
     2319              no-error
     2320              .
     2321         if not available ub._user then do:
     2322            create ub._user .
     2323            assign
     2324               ub._user._userid    = ub.user-login.user-login
     2325               ub._user._password  = ub.user-login.user-password-encoded
     2326            .
     2327         end.
     2328         ELSE DO:
     2329            BUFFER-COPY ub._User EXCEPT ub._User._Password ub._User._TenantId TO tempUser ASSIGN tempUser._Password = ub.user-login.user-password-encoded
     2330            .
     2331            DELETE ub._User.
     2332            CREATE ub._User.
     2333            BUFFER-COPY tempUser EXCEPT tempUser._TenantId TO _User.
     2334         END.
     2335         assign
     2336           ub._user._user-name = substitute('&1 &2 &3'
     2337                                           ,ub.user-account.last-name
     2338                                           ,ub.user-account.first-name
     2339                                           ,ub.user-account.second-name
     2340                                           )
     2341         .
     2342         release _user.
     2343       end.
     2344            end.
     2345         end.
     2346         if locked user-login
     2347         then
     2348            find first user-login
     2349              where user-login.db-num     = sys-ctrl.db-num
     2350                and user-login.user-login = vlogin
     2351            no-lock no-error.
     2352         g#db-num = sys-ctrl.db-num.
     2353         run addobj (sys-ctrl.db-num, user-login.user-id).
     2354      end.
     2355   end.
     2356   function put-log returns character (input itext as character ):
     2357       run gbl/fileapnd.p
     2358             ( logDir + "setpwd.txt"
     2359             ,input substitute ("&1 &2", now, itext)
     2360             ,input 10
     2361             ) no-error .
     2362   end.
