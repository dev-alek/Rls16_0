        1   define input  parameter p-ah-infov-handle as handle    no-undo .
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Просмотр истории операций с архивами объекта".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   procedure arhisatr_encode-attr :
      124     define input  parameter p-attr-calc        as logical   no-undo .
      125     define input  parameter p-attr-del         as logical   no-undo .
      126     define input  parameter p-attr-disable     as logical   no-undo .
      127     define input  parameter p-attr-rest        as logical   no-undo .
      128     define output parameter p-attr-encode-calc as logical   no-undo .
      129     define output parameter p-attr-encode-del  as logical   no-undo .
      130     define output parameter p-attr-encode-ps   as character no-undo .
      131     do
      132     on error undo, return error return-value
      133     :
      134       if p-attr-calc = ?
      135       then do:
      136         message
      137           vss-workfile vss-revision vss-description skip
      138           "Внутренняя ошибка" skip
      139           "Атрибут 'Рассчёт архива' имеет неопределённое значение" skip
      140           view-as alert-box error .
      141         undo, return error return-value .
      142       end.
      143       if p-attr-del = ?
      144       then do:
      145         message
      146           vss-workfile vss-revision vss-description skip
      147           "Внутренняя ошибка" skip
      148           "Атрибут 'Требуется первоначальный расчёт архива' имеет неопределённое значение" skip
      149           view-as alert-box error .
      150         undo, return error return-value .
      151       end.
      152       if p-attr-disable = ?
      153       then do:
      154         message
      155           vss-workfile vss-revision vss-description skip
      156           "Внутренняя ошибка" skip
      157           "Атрибут 'Расчет архива выключен' имеет неопределённое значение" skip
      158           view-as alert-box error .
      159         undo, return error return-value .
      160       end.
      161       if p-attr-rest = ?
      162       then do:
      163         message
      164           vss-workfile vss-revision vss-description skip
      165           "Внутренняя ошибка" skip
      166           "Атрибут 'Удаление восстановление архива' имеет неопределённое значение" skip
      167           view-as alert-box error .
      168         undo, return error return-value .
      169       end.
      170       define variable v-total-value    as integer   no-undo .
      171       define variable v-encode-value-1 as integer   no-undo .
      172       define variable v-encode-value-2 as integer   no-undo .
      173       assign
      174         v-total-value = (if p-attr-calc
      175                          then 1
      176                          else 0
      177                         )
      178                         +
      179                         (if p-attr-del
      180                          then 2
      181                          else 0
      182                         )
      183                         +
      184                         (if p-attr-rest
      185                          then 4
      186                          else 0
      187                         )
      188       .
      189       assign
      190         v-encode-value-1 = truncate(v-total-value / 3, 0)
      191         v-encode-value-2 = v-total-value modulo 3
      192       .
      193       case v-encode-value-1
      194       :
      195         when 0
      196         then do:
      197           assign
      198             p-attr-encode-calc = false
      199           .
      200         end.
      201         when 1
      202         then do:
      203           assign
      204             p-attr-encode-calc = true
      205           .
      206         end.
      207         when 2
      208         then do:
      209           assign
      210             p-attr-encode-calc = ?
      211           .
      212         end.
      213         otherwise do:
      214           message
      215             vss-workfile vss-revision vss-description skip
      216             "Внутренняя ошибка" skip
      217             "Неизвестное значение v-encode-value-1" v-encode-value-1 skip
      218             view-as alert-box error .
      219           undo, return error return-value .
      220         end.
      221       end case .
      222       case v-encode-value-2
      223       :
      224         when 0
      225         then do:
      226           assign
      227             p-attr-encode-del = false
      228           .
      229         end.
      230         when 1
      231         then do:
      232           assign
      233             p-attr-encode-del = true
      234           .
      235         end.
      236         when 2
      237         then do:
      238           assign
      239             p-attr-encode-del = ?
      240           .
      241         end.
      242         otherwise do:
      243           message
      244             vss-workfile vss-revision vss-description skip
      245             "Внутренняя ошибка" skip
      246             "Неизвестное значение v-encode-value-2" v-encode-value-2 skip
      247             view-as alert-box error .
      248           undo, return error return-value .
      249         end.
      250       end case .
      251       assign
      252         p-attr-encode-ps = string(p-attr-disable)
      253       .
      254       define variable v-check-p-attr-calc    as logical   no-undo .
      255       define variable v-check-p-attr-del     as logical   no-undo .
      256       define variable v-check-p-attr-disable as logical   no-undo .
      257       define variable v-check-p-attr-rest    as logical   no-undo .
      258       run arhisatr_decode-attr in this-procedure
      259         (input  p-attr-encode-calc
      260         ,input  p-attr-encode-del
      261         ,input  p-attr-encode-ps
      262         ,output v-check-p-attr-calc
      263         ,output v-check-p-attr-del
      264         ,output v-check-p-attr-disable
      265         ,output v-check-p-attr-rest
      266         ) .
      267       if p-attr-calc    <> v-check-p-attr-calc
      268       or p-attr-del     <> v-check-p-attr-del
      269       or p-attr-disable <> v-check-p-attr-disable
      270       or p-attr-rest    <> v-check-p-attr-rest
      271       then do:
      272         message
      273           vss-workfile vss-revision vss-description skip
      274           "Внутренняя ошибка" skip
      275           "Не совпадают раскодированные значения" skip
      276           "p-attr-calc"    p-attr-calc    skip
      277           "p-attr-del"     p-attr-del     skip
      278           "p-attr-disable" p-attr-disable skip
      279           "p-attr-rest"    p-attr-rest    skip
      280           "v-check-p-attr-calc"    v-check-p-attr-calc    skip
      281           "v-check-p-attr-del"     v-check-p-attr-del     skip
      282           "v-check-p-attr-disable" v-check-p-attr-disable skip
      283           "v-check-p-attr-rest"    v-check-p-attr-rest    skip
      284           view-as alert-box error .
      285         undo, return error return-value .
      286       end.
      287     end.
      288   end procedure.
      289   procedure arhisatr_decode-attr :
      290     define input  parameter p-attr-decode-calc as logical   no-undo .
      291     define input  parameter p-attr-decode-del  as logical   no-undo .
      292     define input  parameter p-attr-decode-ps   as character no-undo .
      293     define output parameter p-attr-calc        as logical   no-undo .
      294     define output parameter p-attr-del         as logical   no-undo .
      295     define output parameter p-attr-disable     as logical   no-undo .
      296     define output parameter p-attr-rest        as logical   no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       define variable v-total-value    as integer   no-undo .
      301       define variable v-encode-value-1 as integer   no-undo .
      302       define variable v-encode-value-2 as integer   no-undo .
      303       case p-attr-decode-calc
      304       :
      305         when false
      306         then do:
      307           assign
      308             v-encode-value-1 = 0
      309           .
      310         end.
      311         when true
      312         then do:
      313           assign
      314             v-encode-value-1 = 1
      315           .
      316         end.
      317         when ?
      318         then do:
      319           assign
      320             v-encode-value-1 = 2
      321           .
      322         end.
      323         otherwise do:
      324           message
      325             vss-workfile vss-revision vss-description skip
      326             "Внутренняя ошибка" skip
      327             "Неизвестное значение p-attr-decode-calc" p-attr-decode-calc skip
      328             view-as alert-box error .
      329           undo, return error return-value .
      330         end.
      331       end case .
      332       case p-attr-decode-del
      333       :
      334         when false
      335         then do:
      336           assign
      337             v-encode-value-2 = 0
      338           .
      339         end.
      340         when true
      341         then do:
      342           assign
      343             v-encode-value-2 = 1
      344           .
      345         end.
      346         when ?
      347         then do:
      348           assign
      349             v-encode-value-2 = 2
      350           .
      351         end.
      352         otherwise do:
      353           message
      354             vss-workfile vss-revision vss-description skip
      355             "Внутренняя ошибка" skip
      356             "Неизвестное значение p-attr-decode-del" p-attr-decode-del skip
      357             view-as alert-box error .
      358           undo, return error return-value .
      359         end.
      360       end case .
      361       assign
      362         v-total-value = v-encode-value-1 * 3
      363                       + v-encode-value-2
      364       .
      365       define variable v-decode-value-1 as integer   no-undo .
      366       define variable v-decode-value-2 as integer   no-undo .
      367       define variable v-decode-value-3 as integer   no-undo .
      368       assign
      369         v-decode-value-1 = v-total-value modulo 2
      370       .
      371       assign
      372         v-total-value = truncate(v-total-value / 2, 0)
      373       .
      374       assign
      375         v-decode-value-2 = v-total-value modulo 2
      376       .
      377       assign
      378         v-total-value = truncate(v-total-value / 2, 0)
      379       .
      380       assign
      381         v-decode-value-3 = v-total-value
      382       .
      383       case v-decode-value-1
      384       :
      385         when 0
      386         then do:
      387           assign
      388             p-attr-calc = false
      389           .
      390         end.
      391         when 1
      392         then do:
      393           assign
      394             p-attr-calc = true
      395           .
      396         end.
      397         otherwise do:
      398           message
      399             vss-workfile vss-revision vss-description skip
      400             "Внутренняя ошибка" skip
      401             "Неизвестное значение v-decode-value-1" v-decode-value-1 skip
      402             view-as alert-box error .
      403           undo, return error return-value .
      404         end.
      405       end case .
      406       case v-decode-value-2
      407       :
      408         when 0
      409         then do:
      410           assign
      411             p-attr-del = false
      412           .
      413         end.
      414         when 1
      415         then do:
      416           assign
      417             p-attr-del = true
      418           .
      419         end.
      420         otherwise do:
      421           message
      422             vss-workfile vss-revision vss-description skip
      423             "Внутренняя ошибка" skip
      424             "Неизвестное значение v-decode-value-2" v-decode-value-2 skip
      425             view-as alert-box error .
      426           undo, return error return-value .
      427         end.
      428       end case .
      429       case v-decode-value-3
      430       :
      431         when 0
      432         then do:
      433           assign
      434             p-attr-rest = false
      435           .
      436         end.
      437         when 1
      438         then do:
      439           assign
      440             p-attr-rest = true
      441           .
      442         end.
      443         otherwise do:
      444           message
      445             vss-workfile vss-revision vss-description skip
      446             "Внутренняя ошибка" skip
      447             "Неизвестное значение v-decode-value-3" v-decode-value-3 skip
      448             view-as alert-box error .
      449           undo, return error return-value .
      450         end.
      451       end case .
      452       assign
      453         p-attr-disable = lookup(p-attr-decode-ps, 'true,yes':u) > 0
      454       .
      455     end.
      456   end procedure.
      457   function arhisatr_get-calc returns logical
      458   (input p-attr-decode-calc as logical
      459   ,input p-attr-decode-del  as logical
      460   ,input p-attr-decode-ps   as character
      461   )
      462   :
      463     define variable v-attr-calc    as logical   no-undo .
      464     define variable v-attr-del     as logical   no-undo .
      465     define variable v-attr-disable as logical   no-undo .
      466     define variable v-attr-rest    as logical   no-undo .
      467     run arhisatr_decode-attr in this-procedure
      468       (input  p-attr-decode-calc
      469       ,input  p-attr-decode-del
      470       ,input  p-attr-decode-ps
      471       ,output v-attr-calc
      472       ,output v-attr-del
      473       ,output v-attr-disable
      474       ,output v-attr-rest
      475       ) .
      476     return v-attr-calc .
      477   end function .
      478   function arhisatr_get-del returns logical
      479   (input p-attr-decode-calc as logical
      480   ,input p-attr-decode-del  as logical
      481   ,input p-attr-decode-ps   as character
      482   )
      483   :
      484     define variable v-attr-calc    as logical   no-undo .
      485     define variable v-attr-del     as logical   no-undo .
      486     define variable v-attr-disable as logical   no-undo .
      487     define variable v-attr-rest    as logical   no-undo .
      488     run arhisatr_decode-attr in this-procedure
      489       (input  p-attr-decode-calc
      490       ,input  p-attr-decode-del
      491       ,input  p-attr-decode-ps
      492       ,output v-attr-calc
      493       ,output v-attr-del
      494       ,output v-attr-disable
      495       ,output v-attr-rest
      496       ) .
      497     return v-attr-del .
      498   end function .
      499   function arhisatr_get-disable returns logical
      500   (input p-attr-decode-calc as logical
      501   ,input p-attr-decode-del  as logical
      502   ,input p-attr-decode-ps   as character
      503   )
      504   :
      505     define variable v-attr-calc    as logical   no-undo .
      506     define variable v-attr-del     as logical   no-undo .
      507     define variable v-attr-disable as logical   no-undo .
      508     define variable v-attr-rest    as logical   no-undo .
      509     run arhisatr_decode-attr in this-procedure
      510       (input  p-attr-decode-calc
      511       ,input  p-attr-decode-del
      512       ,input  p-attr-decode-ps
      513       ,output v-attr-calc
      514       ,output v-attr-del
      515       ,output v-attr-disable
      516       ,output v-attr-rest
      517       ) .
      518     return v-attr-disable .
      519   end function .
      520   function arhisatr_get-rest returns logical
      521   (input p-attr-decode-calc as logical
      522   ,input p-attr-decode-del  as logical
      523   ,input p-attr-decode-ps   as character
      524   )
      525   :
      526     define variable v-attr-calc    as logical   no-undo .
      527     define variable v-attr-del     as logical   no-undo .
      528     define variable v-attr-disable as logical   no-undo .
      529     define variable v-attr-rest    as logical   no-undo .
      530     run arhisatr_decode-attr in this-procedure
      531       (input  p-attr-decode-calc
      532       ,input  p-attr-decode-del
      533       ,input  p-attr-decode-ps
      534       ,output v-attr-calc
      535       ,output v-attr-del
      536       ,output v-attr-disable
      537       ,output v-attr-rest
      538       ) .
      539     return v-attr-rest .
      540   end function .
      541   define variable v-hist-time as character no-undo format "x(8)" .
      542   define variable v-available                as logical   no-undo .
      543   define variable v-db-num                   as integer   no-undo .
      544   define variable v-obj-type                 as character no-undo .
      545   define variable v-obj-code                 as integer   no-undo .
      546   define variable v-archive-type             as character no-undo .
      547   define variable v-deleted                  as logical   no-undo .
      548   define variable v-archive-calc             as logical   no-undo .
      549   define variable v-archive-del              as logical   no-undo .
      550   define variable v-archive-disable          as logical   no-undo .
      551   define variable v-archive-rest             as logical   no-undo .
      552   define variable v-archive-bpexist          as logical   no-undo .
      553   define variable v-archive-detail-date      as date      no-undo .
      554   define variable v-archive-start-date       as date      no-undo .
      555   define variable v-archive-date-recalc      as date      no-undo .
      556   define variable v-archive-lock-prc         as logical   no-undo .
      557   define variable v-archive-execuser         as character no-undo .
      558   define variable v-archive-execsysdate      as date      no-undo .
      559   define variable v-archive-execsystime      as character no-undo .
      560   define variable v-archive-rest-lock-prc    as logical   no-undo .
      561   define variable v-archive-rest-execuser    as character no-undo .
      562   define variable v-archive-rest-execsysdate as date      no-undo .
      563   define variable v-archive-rest-execsystime as character no-undo .
      564   define variable v-archive-type-name     as character no-undo .
      565   define variable v-attr-calc    as logical   no-undo .
      566   define variable v-attr-del     as logical   no-undo .
      567   define variable v-attr-disable as logical   no-undo .
      568   define variable v-attr-rest    as logical   no-undo .
      569   FUNCTION fill-up RETURNS CHARACTER
      570     ( input p-message as character, input p-length as integer )  FORWARD.
      571   FUNCTION history-description RETURNS CHARACTER
      572     ( input p-history-type as character )  FORWARD.
      573   DEFINE BUTTON b-check-file
      574        LABEL "П&роверить"
      575        SIZE 10 BY 1.
      576   DEFINE BUTTON b-exit AUTO-GO
      577        LABEL "Выход"
      578        SIZE 10 BY 1
      579        BGCOLOR 8 .
      580   DEFINE BUTTON b-help
      581        LABEL "Помо&щь"
      582        SIZE 10 BY 1
      583        BGCOLOR 8 .
      584   DEFINE BUTTON b-next
      585        LABEL "&>>"
      586        SIZE 4 BY 1.
      587   DEFINE BUTTON b-prev
      588        LABEL "&<<"
      589        SIZE 4 BY 1.
      590   DEFINE BUTTON b-reason
      591        LABEL "&Причина"
      592        SIZE 10 BY 1.
      593   DEFINE VARIABLE editor-description AS CHARACTER
      594        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      595        SIZE 97.5 BY 6.88
      596        FGCOLOR 4  NO-UNDO.
      597   DEFINE VARIABLE fi-archive AS CHARACTER FORMAT "X(256)":U
      598        LABEL "Архив"
      599         VIEW-AS TEXT
      600        SIZE 33.88 BY .67
      601        FGCOLOR 4  NO-UNDO.
      602   DEFINE VARIABLE fi-object AS CHARACTER FORMAT "X(256)":U
      603        LABEL "Объект"
      604         VIEW-AS TEXT
      605        SIZE 47.75 BY .67
      606        FGCOLOR 4  NO-UNDO.
      607   DEFINE VARIABLE toggle-file AS LOGICAL INITIAL no
      608        LABEL "Только с файлами"
      609        VIEW-AS TOGGLE-BOX
      610        SIZE 28.5 BY .83
      611        FGCOLOR 4  NO-UNDO.
      612   DEFINE QUERY BROWSE-1 FOR
      613         archive-history SCROLLING.
      614   DEFINE BROWSE BROWSE-1
      615     QUERY BROWSE-1 DISPLAY
      616         history-description(archive-history.action-type) format "x(18)" column-label "Действие"
      617         archive-history.corr-user-db-num      column-label "БД"
      618         archive-history.corr-user-name
      619         archive-history.corr-date             format '99/99/9999':u column-label "Дата"
      620         archive-history.corr-time-str         format "x(8)" column-label "Время"
      621         archive-history.archive-detail-date   column-label "Подробный"
      622         archive-history.archive-start-date    column-label "Сжатый"
      623         archive-history.archive-recalc-date   column-label "Перерасчёт"
      624         arhisatr_get-calc(archive-history.archive-calc, archive-history.archive-del, archive-history.ps)    @ v-attr-calc    format "+/ " column-label "Не рассчитан оборот"
      625         arhisatr_get-del(archive-history.archive-calc, archive-history.archive-del, archive-history.ps)     @ v-attr-del     format "+/ " column-label "Не рассчитан нач.остаток"
      626         arhisatr_get-disable(archive-history.archive-calc, archive-history.archive-del, archive-history.ps) @ v-attr-disable format "+/ " column-label "Расчет запрещен"
      627         arhisatr_get-rest(archive-history.archive-calc, archive-history.archive-del, archive-history.ps)    @ v-attr-rest    format "+/ " column-label "Сбой удал./восст."
      628         archive-history.file-name             column-label "Файл"
      629         archive-history.file-valid            format "+/ " column-label "Правильный"
      630         archive-history.file-md5              column-label "Контрольная сумма"
      631         archive-history.chip-num              column-label "Номер"
      632         archive-history.file-invalid-chip-num column-label "Причина"
      633       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.6 ROW-HEIGHT-CHARS .67.
      634   DEFINE FRAME Dialog-Frame
      635        b-exit AT ROW 1 COL 1
      636        b-prev AT ROW 1 COL 11
      637        b-next AT ROW 1 COL 15
      638        b-reason AT ROW 1 COL 19
      639        b-check-file AT ROW 1 COL 29
      640        b-help AT ROW 1 COL 39
      641        toggle-file AT ROW 3 COL 59
      642        BROWSE-1 AT ROW 4 COL 1.5
      643        editor-description AT ROW 16.75 COL 2 NO-LABEL
      644        fi-object AT ROW 2.25 COL 8 COLON-ALIGNED
      645        fi-archive AT ROW 3.25 COL 8 COLON-ALIGNED
      646        SPACE(56.00) SKIP(19.71)
      647       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      648            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      649            TITLE "История архива"
      650            DEFAULT-BUTTON b-exit.
      651   ASSIGN
      652          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      653          FRAME Dialog-Frame:HIDDEN           = TRUE.
      654   ASSIGN
      655          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 5.
      656   ASSIGN
      657          editor-description:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      658   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      659   DO:
      660     APPLY "END-ERROR":U TO SELF.
      661   END.
      662   ON CHOOSE OF b-check-file IN FRAME Dialog-Frame
      663   DO:
      664     run check-file in this-procedure .
      665   END.
      666   ON CHOOSE OF b-next IN FRAME Dialog-Frame
      667   DO:
      668     define variable v-temp-obj-arh-available as logical   no-undo .
      669     run ah-infov_get-next in p-ah-infov-handle .
      670     run ah-infov_is-available in p-ah-infov-handle
      671       (output v-temp-obj-arh-available
      672       ) .
      673     if v-temp-obj-arh-available <> true
      674     then do:
      675       message
      676         "Текущая запись является последней записью" skip
      677         "Невозможно перейти на последующую запись" skip
      678         view-as alert-box information .
      679       run ah-infov_get-last in p-ah-infov-handle .
      680     end.
      681     run ah-infov_reposition-to-current in p-ah-infov-handle .
      682     run display-history in this-procedure .
      683   END.
      684   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
      685   DO:
      686     define variable v-temp-obj-arh-available as logical   no-undo .
      687     run ah-infov_get-prev in p-ah-infov-handle .
      688     run ah-infov_is-available in p-ah-infov-handle
      689       (output v-temp-obj-arh-available
      690       ) .
      691     if v-temp-obj-arh-available <> true
      692     then do:
      693       message
      694         "Текущая запись является первой записью" skip
      695         "Невозможно перейти на предыдущую запись" skip
      696         view-as alert-box information .
      697       run ah-infov_get-first in p-ah-infov-handle .
      698     end.
      699     run ah-infov_reposition-to-current in p-ah-infov-handle .
      700     run display-history in this-procedure .
      701   END.
      702   ON CHOOSE OF b-reason IN FRAME Dialog-Frame
      703   DO:
      704     run show-reason in this-procedure .
      705   END.
      706   ON VALUE-CHANGED OF BROWSE-1 IN FRAME Dialog-Frame
      707   DO:
      708     run display-description in this-procedure .
      709   END.
      710   ON VALUE-CHANGED OF toggle-file IN FRAME Dialog-Frame
      711   DO:
      712     assign
      713       toggle-file
      714       .
      715     run open-hist-query in this-procedure .
      716   END.
      717   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      718   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      719   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      720   on help of frame Dialog-Frame
      721   do:
      722     run gbl/app_help.p
      723       (input this-procedure :file-name
      724       ,input ''
      725       ,input ?
      726       ) no-error.
      727     if error-status :error then do:
      728       message
      729         "Ошибка при вызове помощи"
      730         error-status :get-message(1)
      731         view-as alert-box .
      732     end.
      733   end.
      734   run minbtn-set in this-procedure .
      735   on choose of b-help in frame Dialog-Frame
      736   do:
      737     apply "help":u to frame Dialog-Frame .
      738   end.
      739   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      740   procedure minbtn-set :
      741       do
      742           on error undo, return error return-value
      743           :
      744           define variable ii              as integer       no-undo .
      745           define variable fh              as widget-handle no-undo .
      746           define variable hh              as widget-handle no-undo .
      747           define variable v-h             as handle        extent 4 no-undo .
      748           define variable v-name-button   as character     no-undo .
      749           define variable v-help-old-x    as decimal       no-undo .
      750           define variable v-help-old-y    as decimal       no-undo .
      751           define variable v-help-old-size as decimal       no-undo .
      752           define variable v-frame-width   as decimal       no-undo .
      753           define variable jj              as integer       no-undo .
      754           do
      755               on error undo, return error
      756               :
      757               assign
      758                   v-frame-width = frame Dialog-Frame:width - 0.3
      759                   fh            = frame Dialog-Frame:first-child
      760                   hh            = fh:first-child
      761                   ii            = 1
      762                   .
      763               do while valid-handle(hh):
      764                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      765                   do:
      766                       case lc(hh:name) :
      767                           when "b-help" then
      768                               do:
      769                                   hh:load-image-up("cmp/b-help.bmp":u) .
      770                                   hh:load-image-down("cmp/b-help.bmp":u) .
      771                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      772                                   hh:TOOLTIP = "Помощь" .
      773                                   v-help-old-x = hh:column .
      774                                   v-help-old-y = hh:row    .
      775                                   v-help-old-size = hh:width .
      776                                   hh:width-chars = 2.5 .
      777                               end.
      778                           when "b-print" then
      779                               do:
      780                                   hh:load-image("cmp/b-print.bmp":u) .
      781                                   hh:TOOLTIP = "Печать" .
      782                                   v-h[ii] = hh:handle .
      783                                   ii = ii + 1 .
      784                                   hh:width-chars = 3 .
      785                               end.
      786                           when "b-history" or
      787                           when "b-hist" then
      788                               do:
      789                                   hh:load-image("cmp/b-hist.bmp":u) .
      790                                   hh:TOOLTIP = "История" .
      791                                   v-h[ii] = hh:handle .
      792                                   ii = ii + 1 .
      793                                   hh:width-chars = 3 .
      794                               end.
      795                           when "b-sch" then
      796                               do:
      797                                   hh:load-image("cmp/b-sch.bmp":u) .
      798                                   hh:TOOLTIP = "Установка Фильтра" .
      799                                   v-h[ii] = hh:handle .
      800                                   ii = ii + 1 .
      801                                   hh:width-chars = 3 .
      802                               end.
      803                           when "b-hist-user" then
      804                               do:
      805                                   hh:load-image("cmp/b-hist.bmp":u) .
      806                                   hh:TOOLTIP = "История пользователя" .
      807                                   ii = ii + 1 .
      808                               end.
      809                       end case.
      810                   end.
      811                   hh = hh:next-sibling.
      812               end.
      813               b-help:column = v-frame-width - b-help:width-chars.
      814               jj = 0.
      815               repeat ii = 4 to 1 by -1 :
      816                   if valid-handle (v-h[ii] ) then
      817                   do:
      818                       jj  = jj + 1 .
      819                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      820                       v-h[ii]:row    = v-help-old-y .
      821                   end.
      822               end.
      823           end.
      824       end.
      825   end procedure.
      826   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      827   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      828   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      829   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      830   define variable v-diasize-current-frame-width  as decimal   no-undo .
      831   define variable v-diasize-current-frame-height as decimal   no-undo .
      832   define variable v-diasize-change-size          as logical   no-undo .
      833   define variable v-diasize-resize-button        as handle    no-undo .
      834   define variable v-diasize-wndmax               as logical   no-undo .
      835   define variable v-diasize-wndstore             as logical   no-undo .
      836   define variable v-diasize-proc-name            as character no-undo .
      837   define variable v-diasize-browse-handle        as handle    no-undo .
      838   define variable v-diasize-browse-number        as integer   no-undo .
      839   define variable v-diasize-need-full-display    as logical   no-undo init false .
      840   define temp-table temp-diasize-handle no-undo
      841     field handle-value  as handle
      842     field save-position as decimal
      843     index xpk is primary unique handle-value
      844     .
      845   define temp-table temp-browse-handle no-undo
      846     field browse-type   as character
      847     field browse-number as integer
      848     field browse-handle as handle
      849     field original-size as decimal
      850     index xpk is primary unique browse-type browse-number
      851     index xie browse-type browse-handle
      852   .
      853   procedure diasize_change-height :
      854     define input  parameter p-change-value  as decimal   no-undo .
      855     define input  parameter p-move-resize   as logical   no-undo .
      856     define variable v-field-group-handle    as handle    no-undo .
      857     define variable v-object-handle         as handle    no-undo .
      858     define variable v-frame-height          as decimal   no-undo .
      859     define variable v-frame-virtual-height  as decimal   no-undo .
      860     define variable v-browse-height         as decimal   no-undo .
      861     define variable v-window-height         as decimal   no-undo .
      862     define variable v-window-virtual-height as decimal   no-undo .
      863     define variable v-change-sign           as integer   no-undo .
      864     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      865     define buffer buf_temp-browse-handle  for temp-browse-handle .
      866     if p-change-value > 0
      867     then do:
      868       if frame Dialog-Frame :height + p-change-value
      869           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      870       then do:
      871         assign
      872           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      873                           - (frame Dialog-Frame :height-chars)
      874         .
      875         if p-change-value <= 0
      876         then do:
      877           run diasize_position-resize-button in this-procedure .
      878           return .
      879         end.
      880       end.
      881     end.
      882     if p-change-value < 0
      883     then do:
      884       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      885       then do:
      886         assign
      887           p-change-value = v-diasize-orig-frame-height
      888                          - (frame Dialog-Frame :height-chars)
      889         .
      890         if p-change-value >= 0
      891         then do:
      892           run diasize_position-resize-button in this-procedure .
      893           return .
      894         end.
      895       end.
      896     end.
      897     if p-change-value >= 0
      898     then do:
      899       assign
      900         v-change-sign = 1
      901       .
      902     end.
      903     else do:
      904       assign
      905         v-change-sign = -1
      906       .
      907     end.
      908     assign
      909       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      910     .
      911     if p-change-value = 0
      912     then do:
      913       run diasize_position-resize-button in this-procedure .
      914       return .
      915     end.
      916     move_block:
      917     do
      918     on error undo move_block, retry move_block
      919     :
      920       if retry
      921       then do:
      922         do
      923         on error undo move_block, leave move_block
      924         :
      925           if p-change-value > 0
      926           then do:
      927             for each buf_temp-diasize-handle
      928             on error undo, next
      929             :
      930               assign
      931                 v-object-handle = buf_temp-diasize-handle.handle-value
      932               .
      933               if v-object-handle <> v-diasize-resize-button
      934               then do:
      935                 assign
      936                   v-object-handle :row = buf_temp-diasize-handle.save-position
      937                 .
      938               end.
      939             end.
      940             assign
      941               v-diasize-browse-handle :height = v-browse-height
      942             .
      943             for each buf_temp-browse-handle
      944               where buf_temp-browse-handle.browse-type = 'height':u
      945             on error undo, next
      946             :
      947               assign
      948                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      949               .
      950             end.
      951             assign
      952               frame Dialog-Frame :height = v-frame-height
      953             .
      954             if frame Dialog-Frame :scrollable = true
      955             then do:
      956               assign
      957                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      958               .
      959             end.
      960             run diasize_position-resize-button in this-procedure .
      961           end.
      962           else do:
      963             if frame Dialog-Frame :scrollable = true
      964             then do:
      965               assign
      966                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      967               .
      968             end.
      969             assign
      970               frame Dialog-Frame :height = v-frame-height
      971             .
      972             assign
      973               v-diasize-browse-handle :height = v-browse-height
      974             .
      975             for each buf_temp-browse-handle
      976               where buf_temp-browse-handle.browse-type = 'height':u
      977             on error undo, next
      978             :
      979               assign
      980                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      981               .
      982             end.
      983             for each buf_temp-diasize-handle
      984             on error undo, next
      985             :
      986               assign
      987                 v-object-handle = buf_temp-diasize-handle.handle-value
      988               .
      989               if v-object-handle <> v-diasize-resize-button
      990               then do:
      991                 assign
      992                   v-object-handle :row = buf_temp-diasize-handle.save-position
      993                 .
      994               end.
      995             end.
      996             run diasize_position-resize-button in this-procedure .
      997           end.
      998           assign
      999             v-diasize-change-size = false
     1000           .
     1001           leave move_block .
     1002         end.
     1003       end.
     1004       assign
     1005         v-diasize-need-full-display = true
     1006       .
     1007       if v-diasize-change-size = false
     1008       then do:
     1009         assign
     1010           v-diasize-change-size = true
     1011         .
     1012       end.
     1013       else do:
     1014         return .
     1015       end.
     1016       assign
     1017         v-frame-height = frame Dialog-Frame :height
     1018         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1019         v-browse-height = v-diasize-browse-handle :height
     1020       .
     1021       for each buf_temp-browse-handle
     1022         where buf_temp-browse-handle.browse-type = 'height':u
     1023       :
     1024         assign
     1025           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1026         .
     1027       end.
     1028       for each buf_temp-diasize-handle
     1029       :
     1030         delete buf_temp-diasize-handle .
     1031       end.
     1032       assign
     1033         v-field-group-handle = frame Dialog-Frame :first-child
     1034       .
     1035       do while valid-handle(v-field-group-handle)
     1036       :
     1037         assign
     1038           v-object-handle = v-field-group-handle :first-child
     1039         .
     1040         do while valid-handle(v-object-handle)
     1041         :
     1042           if  v-object-handle <> v-diasize-browse-handle :handle
     1043           and can-query(v-object-handle, "row")
     1044           and can-query(v-object-handle, "height")
     1045           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1046           then do:
     1047             find first buf_temp-browse-handle
     1048               where buf_temp-browse-handle.browse-type   = 'height':u
     1049                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1050               no-error .
     1051             if available buf_temp-browse-handle
     1052             then do:
     1053             end.
     1054             else do:
     1055               create buf_temp-diasize-handle .
     1056               assign
     1057                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1058                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1059               .
     1060             end.
     1061           end.
     1062           assign
     1063             v-object-handle = v-object-handle :next-sibling
     1064           .
     1065         end.
     1066         assign
     1067           v-field-group-handle = v-field-group-handle :next-sibling
     1068         .
     1069       end.
     1070       do with frame Dialog-Frame
     1071       :
     1072         hide v-diasize-resize-button .
     1073         assign
     1074           v-diasize-resize-button :row    = 1
     1075           v-diasize-resize-button :column = 1
     1076         .
     1077       end.
     1078       if p-change-value > 0
     1079       then do:
     1080         if frame Dialog-Frame :scrollable = true
     1081         then do:
     1082           assign
     1083             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1084             no-error .
     1085           if error-status :error
     1086           or error-status :get-message(1) <> ""
     1087           then do:
     1088             undo move_block, retry move_block .
     1089           end.
     1090         end.
     1091         assign
     1092           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1093           no-error .
     1094         if error-status :error
     1095         or error-status :get-message(1) <> ""
     1096         then do:
     1097           undo move_block, retry move_block .
     1098         end.
     1099         assign
     1100           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1101           no-error .
     1102         if error-status :error
     1103         or error-status :get-message(1) <> ""
     1104         then do:
     1105           undo move_block, retry move_block .
     1106         end.
     1107         for each buf_temp-browse-handle
     1108           where buf_temp-browse-handle.browse-type = 'height':u
     1109         on error undo move_block, retry move_block
     1110         :
     1111           assign
     1112             buf_temp-browse-handle.browse-handle :height
     1113               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1114             no-error .
     1115           if error-status :error
     1116           or error-status :get-message(1) <> ""
     1117           then do:
     1118             undo move_block, retry move_block .
     1119           end.
     1120         end.
     1121         for each buf_temp-diasize-handle
     1122         on error undo move_block, retry move_block
     1123         :
     1124           assign
     1125             v-object-handle = buf_temp-diasize-handle.handle-value
     1126           .
     1127           if v-object-handle <> v-diasize-resize-button
     1128           then do:
     1129             assign
     1130               v-object-handle :row = v-object-handle :row + p-change-value
     1131               no-error .
     1132             if error-status :error
     1133             or error-status :get-message(1) <> ""
     1134             then do:
     1135               undo move_block, retry move_block .
     1136             end.
     1137           end.
     1138         end.
     1139       end.
     1140       else do:
     1141         for each buf_temp-diasize-handle
     1142         on error undo move_block, retry move_block
     1143         :
     1144           assign
     1145             v-object-handle = buf_temp-diasize-handle.handle-value
     1146           .
     1147           if v-object-handle <> v-diasize-resize-button
     1148           then do:
     1149             assign
     1150               v-object-handle :row = v-object-handle :row + p-change-value
     1151               no-error .
     1152             if error-status :error
     1153             or error-status :get-message(1) <> ""
     1154             then do:
     1155               undo move_block, retry move_block .
     1156             end.
     1157           end.
     1158         end.
     1159         assign
     1160           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1161           no-error .
     1162         if error-status :error
     1163         or error-status :get-message(1) <> ""
     1164         then do:
     1165           undo move_block, retry move_block .
     1166         end.
     1167         for each buf_temp-browse-handle
     1168           where buf_temp-browse-handle.browse-type = 'height':u
     1169         on error undo move_block, retry move_block
     1170         :
     1171           assign
     1172             buf_temp-browse-handle.browse-handle :height
     1173               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1174             no-error .
     1175           if error-status :error
     1176           or error-status :get-message(1) <> ""
     1177           then do:
     1178             undo move_block, retry move_block .
     1179           end.
     1180         end.
     1181         assign
     1182           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1183           no-error .
     1184         if error-status :error
     1185         or error-status :get-message(1) <> ""
     1186         then do:
     1187           undo move_block, retry move_block .
     1188         end.
     1189         if frame Dialog-Frame :scrollable = true
     1190         then do:
     1191           assign
     1192             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1193             no-error .
     1194           if error-status :error
     1195           or error-status :get-message(1) <> ""
     1196           then do:
     1197             undo move_block, retry move_block .
     1198           end.
     1199         end.
     1200       end.
     1201       if p-move-resize = true
     1202       then do:
     1203         run diasize_position-resize-button in this-procedure .
     1204       end.
     1205       if v-diasize-wndstore = true
     1206       then do:
     1207         if connected("ub") = true
     1208         then do:
     1209           define variable v-cntxt-db-num        as integer   no-undo .
     1210           define variable v-cntxt-userid        as character no-undo .
     1211           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1212                                             , OUTPUT v-cntxt-userid
     1213                                             ) .
     1214           run gbl/wndsizew.p
     1215             (input  v-cntxt-db-num
     1216             ,input  v-cntxt-userid
     1217             ,input  v-diasize-proc-name
     1218             ,input  'height':u
     1219             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1220             ) .
     1221         end.
     1222       end.
     1223     end.
     1224     assign
     1225       v-diasize-change-size = false
     1226     .
     1227   end procedure.
     1228   procedure diasize_set-height :
     1229     define input  parameter p-new-height  as decimal   no-undo .
     1230     define input  parameter p-move-resize as logical   no-undo .
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       run diasize_change-height in this-procedure
     1235         (input  (p-new-height - frame Dialog-Frame :height)
     1236         ,input  p-move-resize
     1237         ) .
     1238     end.
     1239   end procedure.
     1240   procedure diasize_change-width :
     1241     define input  parameter p-change-value as decimal   no-undo .
     1242     define input  parameter p-move-resize  as logical   no-undo .
     1243     define variable v-field-group-handle   as handle    no-undo .
     1244     define variable v-object-handle        as handle    no-undo .
     1245     define variable v-frame-width          as decimal   no-undo .
     1246     define variable v-frame-virtual-width  as decimal   no-undo .
     1247     define variable v-browse-width         as decimal   no-undo .
     1248     define variable v-window-width         as decimal   no-undo .
     1249     define variable v-window-virtual-width as decimal   no-undo .
     1250     define variable v-change-sign          as integer   no-undo .
     1251     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1252     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1253     if p-change-value > 0
     1254     then do:
     1255       if frame Dialog-Frame :width + p-change-value >
     1256           session :width-chars
     1257       then do:
     1258         assign
     1259           p-change-value = session :width-chars - frame Dialog-Frame :width
     1260         .
     1261         if p-change-value <= 0
     1262         then do:
     1263           run diasize_position-resize-button in this-procedure .
     1264           return .
     1265         end.
     1266       end.
     1267     end.
     1268     if p-change-value < 0
     1269     then do:
     1270       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1271       then do:
     1272         assign
     1273           p-change-value = v-diasize-orig-frame-width
     1274                          - frame Dialog-Frame :width
     1275         .
     1276         if p-change-value >= 0
     1277         then do:
     1278           run diasize_position-resize-button in this-procedure .
     1279           return .
     1280         end.
     1281       end.
     1282     end.
     1283     if p-change-value >= 0
     1284     then do:
     1285       assign
     1286         v-change-sign = 1
     1287       .
     1288     end.
     1289     else do:
     1290       assign
     1291         v-change-sign = -1
     1292       .
     1293     end.
     1294     assign
     1295       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1296     .
     1297     if p-change-value = 0
     1298     then do:
     1299       run diasize_position-resize-button in this-procedure .
     1300       return .
     1301     end.
     1302     move_block:
     1303     do
     1304     on error undo move_block, leave move_block
     1305     :
     1306       if retry
     1307       then do:
     1308         do
     1309         on error undo move_block, leave move_block
     1310         :
     1311           if p-change-value > 0
     1312           then do:
     1313             for each buf_temp-diasize-handle
     1314             on error undo, next
     1315             :
     1316               assign
     1317                 v-object-handle = buf_temp-diasize-handle.handle-value
     1318               .
     1319               if v-object-handle <> v-diasize-resize-button
     1320               then do:
     1321                 assign
     1322                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1323                 .
     1324               end.
     1325             end.
     1326             assign
     1327               v-diasize-browse-handle :width = v-browse-width
     1328             .
     1329             for each buf_temp-browse-handle
     1330               where buf_temp-browse-handle.browse-type = 'width':u
     1331             on error undo, next
     1332             :
     1333               assign
     1334                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1335               .
     1336             end.
     1337             assign
     1338               frame Dialog-Frame :width = v-frame-width
     1339             .
     1340             if frame Dialog-Frame :scrollable = true
     1341             then do:
     1342               assign
     1343                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1344               .
     1345             end.
     1346             run diasize_position-resize-button in this-procedure .
     1347           end.
     1348           else do:
     1349             if frame Dialog-Frame :scrollable = true
     1350             then do:
     1351               assign
     1352                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1353               .
     1354             end.
     1355             assign
     1356               frame Dialog-Frame :width = v-frame-width
     1357             .
     1358             for each buf_temp-browse-handle
     1359               where buf_temp-browse-handle.browse-type = 'width':u
     1360             on error undo, next
     1361             :
     1362               assign
     1363                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1364               .
     1365             end.
     1366             assign
     1367               v-diasize-browse-handle :width = v-browse-width
     1368             .
     1369             for each buf_temp-diasize-handle
     1370             on error undo, next
     1371             :
     1372               assign
     1373                 v-object-handle = buf_temp-diasize-handle.handle-value
     1374               .
     1375               if v-object-handle <> v-diasize-resize-button
     1376               then do:
     1377                 assign
     1378                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1379                 .
     1380               end.
     1381             end.
     1382             run diasize_position-resize-button in this-procedure .
     1383           end.
     1384           assign
     1385             v-diasize-change-size = false
     1386           .
     1387           leave move_block .
     1388         end.
     1389       end.
     1390       assign
     1391         v-diasize-need-full-display = true
     1392       .
     1393       if v-diasize-change-size = false
     1394       then do:
     1395         assign
     1396           v-diasize-change-size = true
     1397         .
     1398       end.
     1399       else do:
     1400         return .
     1401       end.
     1402       assign
     1403         v-frame-width = frame Dialog-Frame :width
     1404         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1405         v-browse-width = v-diasize-browse-handle :width
     1406       .
     1407       for each buf_temp-browse-handle
     1408         where buf_temp-browse-handle.browse-type = 'width':u
     1409       :
     1410         assign
     1411           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1412         .
     1413       end.
     1414       for each buf_temp-diasize-handle
     1415       :
     1416         delete buf_temp-diasize-handle .
     1417       end.
     1418       assign
     1419         v-field-group-handle = frame Dialog-Frame :first-child
     1420       .
     1421       do while valid-handle(v-field-group-handle)
     1422       :
     1423         assign
     1424           v-object-handle = v-field-group-handle :first-child
     1425         .
     1426         do while valid-handle(v-object-handle)
     1427         :
     1428           if  v-object-handle <> v-diasize-browse-handle :handle
     1429           and v-object-handle <> v-diasize-resize-button
     1430           and can-query(v-object-handle, "row")
     1431           and can-query(v-object-handle, "height")
     1432           and ( v-object-handle :col + v-object-handle :width
     1433                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1434               )
     1435           then do:
     1436             find first buf_temp-browse-handle
     1437               where buf_temp-browse-handle.browse-type   = 'width':u
     1438                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1439               no-error .
     1440             if available buf_temp-browse-handle
     1441             then do:
     1442             end.
     1443             else do:
     1444               create buf_temp-diasize-handle .
     1445               assign
     1446                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1447                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1448               .
     1449             end.
     1450           end.
     1451           assign
     1452             v-object-handle = v-object-handle :next-sibling
     1453           .
     1454         end.
     1455         assign
     1456           v-field-group-handle = v-field-group-handle :next-sibling
     1457         .
     1458       end.
     1459       do with frame Dialog-Frame
     1460       :
     1461         hide v-diasize-resize-button .
     1462         v-diasize-resize-button :row = 1.
     1463         v-diasize-resize-button :column = 1.
     1464       end.
     1465       if p-change-value > 0
     1466       then do:
     1467         if frame Dialog-Frame :scrollable = true
     1468         then do:
     1469           assign
     1470             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1471             no-error .
     1472           if error-status :error
     1473           or error-status :get-message(1) <> ""
     1474           then do:
     1475             undo move_block, retry move_block.
     1476           end.
     1477         end.
     1478         assign
     1479           frame Dialog-Frame :width = v-frame-width + p-change-value
     1480           no-error .
     1481         if error-status :error
     1482         or error-status :get-message(1) <> ""
     1483         then do:
     1484           undo move_block, retry move_block.
     1485         end.
     1486         assign
     1487           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1488         no-error .
     1489         if error-status :error
     1490         or error-status :get-message(1) <> ""
     1491         then do:
     1492           undo move_block, retry move_block.
     1493         end.
     1494         for each buf_temp-browse-handle
     1495           where buf_temp-browse-handle.browse-type = 'width':u
     1496         on error undo move_block, retry move_block
     1497         :
     1498           assign
     1499             buf_temp-browse-handle.browse-handle :width
     1500               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1501             no-error .
     1502           if error-status :error
     1503           or error-status :get-message(1) <> ""
     1504           then do:
     1505             undo move_block, retry move_block .
     1506           end.
     1507         end.
     1508         for each buf_temp-diasize-handle
     1509         on error undo move_block, retry move_block
     1510         :
     1511           assign
     1512             v-object-handle = buf_temp-diasize-handle.handle-value
     1513           .
     1514           if v-object-handle <> v-diasize-resize-button
     1515           then do:
     1516             assign
     1517               v-object-handle :col = v-object-handle :col + p-change-value
     1518               no-error .
     1519             if error-status :error
     1520             or error-status :get-message(1) <> ""
     1521             then do:
     1522               undo move_block, retry move_block .
     1523             end.
     1524           end.
     1525         end.
     1526       end.
     1527       else do:
     1528         for each buf_temp-diasize-handle
     1529         on error undo move_block, retry move_block
     1530         :
     1531           assign
     1532             v-object-handle = buf_temp-diasize-handle.handle-value
     1533           .
     1534           if v-object-handle <> v-diasize-resize-button
     1535           then do:
     1536             assign
     1537               v-object-handle :col = v-object-handle :col + p-change-value
     1538               no-error .
     1539             if error-status :error
     1540             or error-status :get-message(1) <> ""
     1541             then do:
     1542               undo move_block, retry move_block .
     1543             end.
     1544           end.
     1545         end.
     1546         for each buf_temp-browse-handle
     1547           where buf_temp-browse-handle.browse-type = 'width':u
     1548         on error undo move_block, retry move_block
     1549         :
     1550           assign
     1551             buf_temp-browse-handle.browse-handle :width
     1552               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1553             no-error .
     1554           if error-status :error
     1555           or error-status :get-message(1) <> ""
     1556           then do:
     1557             undo move_block, retry move_block .
     1558           end.
     1559         end.
     1560         assign
     1561           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1562           no-error .
     1563         if error-status :error
     1564         or error-status :get-message(1) <> ""
     1565         then do:
     1566           undo move_block, retry move_block.
     1567         end.
     1568         assign
     1569           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1570         no-error .
     1571         if error-status :error
     1572         or error-status :get-message(1) <> ""
     1573         then do:
     1574           undo move_block, retry move_block.
     1575         end.
     1576         if frame Dialog-Frame :scrollable = true
     1577         then do:
     1578           assign
     1579             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1580           no-error .
     1581           if error-status :error
     1582           or error-status :get-message(1) <> ""
     1583           then do:
     1584             undo move_block, retry move_block.
     1585           end.
     1586         end.
     1587       end.
     1588       if p-move-resize
     1589       then do:
     1590         run diasize_position-resize-button in this-procedure .
     1591       end.
     1592       if v-diasize-wndstore = true
     1593       then do:
     1594         if connected("ub") = true
     1595         then do:
     1596           define variable v-cntxt-db-num        as integer   no-undo .
     1597           define variable v-cntxt-userid        as character no-undo .
     1598           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1599                                             , OUTPUT v-cntxt-userid
     1600                                             ) .
     1601           run gbl/wndsizew.p
     1602             (input  v-cntxt-db-num
     1603             ,input  v-cntxt-userid
     1604             ,input  v-diasize-proc-name
     1605             ,input  'width':u
     1606             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1607             ) .
     1608         end.
     1609       end.
     1610     end.
     1611     assign
     1612       v-diasize-change-size = false
     1613     .
     1614   end procedure.
     1615   procedure diasize_set-width :
     1616     define input  parameter p-new-width  as decimal   no-undo .
     1617     define input  parameter p-move-resize as logical   no-undo .
     1618     do
     1619     on error undo, return error return-value
     1620     :
     1621       run diasize_change-width in this-procedure
     1622         (input  (p-new-width - frame Dialog-Frame :width)
     1623         ,input  p-move-resize
     1624         ) .
     1625     end.
     1626   end procedure.
     1627   procedure diasize_position-resize-button :
     1628     do with frame Dialog-Frame
     1629     :
     1630       hide v-diasize-resize-button .
     1631       assign
     1632         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1633                     - 1
     1634                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1635         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1636                     - 1
     1637                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1638       .
     1639       view v-diasize-resize-button .
     1640     end.
     1641   end procedure.
     1642   on alt-right anywhere
     1643   do:
     1644     run diasize_change-width in this-procedure
     1645       (input 1
     1646       ,input true
     1647       ) .
     1648     return no-apply .
     1649   end.
     1650   on alt-left anywhere
     1651   do:
     1652     run diasize_change-width in this-procedure
     1653       (input -1
     1654       ,input true
     1655       ) .
     1656     return no-apply .
     1657   end.
     1658   on alt-down anywhere
     1659   do:
     1660     run diasize_change-height in this-procedure
     1661       (input 1
     1662       ,input true
     1663       ) .
     1664     return no-apply .
     1665   end.
     1666   on alt-up anywhere
     1667   do:
     1668     run diasize_change-height in this-procedure
     1669       (input -1
     1670       ,input true
     1671       ) .
     1672     return no-apply .
     1673   end.
     1674   on alt-enter of frame Dialog-Frame
     1675   do:
     1676     run diasize_maximize in this-procedure
     1677       (input  ?
     1678       ).
     1679     return no-apply .
     1680   end.
     1681   procedure diasize_end-move :
     1682     do
     1683     on error undo, return error return-value
     1684     :
     1685       define variable v-row-delta as decimal   no-undo .
     1686       define variable v-col-delta as decimal   no-undo .
     1687       define variable v-new-row as decimal   no-undo .
     1688       define variable v-new-col as decimal   no-undo .
     1689       assign
     1690         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1691         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1692       .
     1693       assign
     1694         v-row-delta = v-new-row - frame Dialog-Frame :height
     1695         v-col-delta = v-new-col - frame Dialog-Frame :width
     1696       .
     1697       run diasize_change-height in this-procedure
     1698         (input v-row-delta
     1699         ,input true
     1700         ) .
     1701       run diasize_change-width in this-procedure
     1702         (input v-col-delta
     1703         ,input true
     1704         ) .
     1705     end.
     1706   end procedure.
     1707   procedure diasize_maximize :
     1708     define input  parameter p-action as logical   no-undo .
     1709     do
     1710     on error undo, return error return-value
     1711     :
     1712       if p-action = ?
     1713       then do:
     1714         if v-diasize-need-maximize = true
     1715         then do:
     1716           assign
     1717             p-action = true
     1718           .
     1719         end.
     1720         else do:
     1721           assign
     1722             p-action = false
     1723           .
     1724         end.
     1725       end.
     1726       if p-action = true
     1727       then do:
     1728         run diasize_change-height in this-procedure
     1729           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1730               - frame Dialog-Frame :height-chars
     1731           ,input true
     1732           ) .
     1733         run diasize_change-width in this-procedure
     1734           (input session :width-chars
     1735               - frame Dialog-Frame :width-chars
     1736           ,input true
     1737           ) .
     1738         assign
     1739           v-diasize-need-maximize = false
     1740         .
     1741       end.
     1742       else do:
     1743         run diasize_change-width in this-procedure
     1744           (input v-diasize-orig-frame-width
     1745               - frame Dialog-Frame :width-chars
     1746           ,input true
     1747           ) .
     1748         run diasize_change-height in this-procedure
     1749           (input v-diasize-orig-frame-height
     1750               - frame Dialog-Frame :height-chars
     1751           ,input true
     1752           ) .
     1753         assign
     1754           v-diasize-need-maximize = true
     1755         .
     1756       end.
     1757     end.
     1758   end procedure.
     1759   procedure diasize_restore-orig-size :
     1760     do
     1761     on error undo, return error return-value
     1762     :
     1763       assign
     1764         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1765         v-diasize-current-frame-height = frame Dialog-Frame :height
     1766       .
     1767       run diasize_set-height in this-procedure
     1768         (input  v-diasize-orig-frame-height
     1769         ,input  true
     1770         ) .
     1771       run diasize_set-width in this-procedure
     1772         (input  v-diasize-orig-frame-width
     1773         ,input  true
     1774         ) .
     1775     end.
     1776   end procedure.
     1777   procedure diasize_restore-current-size :
     1778     do
     1779     on error undo, return error return-value
     1780     :
     1781       run diasize_set-height in this-procedure
     1782         (input  v-diasize-current-frame-height
     1783         ,input  true
     1784         ) .
     1785       run diasize_set-width in this-procedure
     1786         (input  v-diasize-current-frame-width
     1787         ,input  true
     1788         ) .
     1789     end.
     1790   end procedure.
     1791   procedure diasize_set-browse-handle :
     1792     define input  parameter p-browse-handle as handle   no-undo .
     1793     define buffer buf_temp-browse-handle for temp-browse-handle .
     1794     do
     1795     on error undo, return error return-value
     1796     :
     1797       assign
     1798         v-diasize-browse-handle = p-browse-handle
     1799       .
     1800       for each buf_temp-browse-handle
     1801       on error undo, return error return-value
     1802       :
     1803         delete buf_temp-browse-handle .
     1804       end.
     1805     end.
     1806   end procedure.
     1807   procedure diasize_add_browse :
     1808     define input  parameter p-browse-type   as character no-undo .
     1809     define input  parameter p-browse-handle as handle    no-undo .
     1810     define buffer buf_temp-browse-handle for temp-browse-handle .
     1811     do
     1812     on error undo, return error return-value
     1813     :
     1814       assign
     1815         v-diasize-browse-number = v-diasize-browse-number + 1
     1816       .
     1817       create buf_temp-browse-handle .
     1818       assign
     1819         buf_temp-browse-handle.browse-type   = p-browse-type
     1820         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1821         buf_temp-browse-handle.browse-handle = p-browse-handle
     1822       .
     1823     end.
     1824   end procedure.
     1825   procedure diasize_init :
     1826     define variable v-default-value    as logical   no-undo .
     1827     define variable v-restore-saved    as logical   no-undo .
     1828     define variable v-resize-value-str as character no-undo .
     1829     do
     1830     on error undo, return error return-value
     1831     :
     1832       do with frame Dialog-Frame
     1833       :
     1834         assign
     1835           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1836           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1837           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1838         .
     1839         create button v-diasize-resize-button
     1840         assign
     1841           parent        = frame Dialog-Frame :first-child
     1842           label         = "s"
     1843           height-pixels = 16
     1844           width-pixels  = 16
     1845           visible       = true
     1846           sensitive     = true
     1847           movable       = true
     1848           triggers:
     1849             on end-move persistent run diasize_end-move in this-procedure .
     1850           end triggers.
     1851         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1852         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1853         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1854         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1855         assign
     1856           v-diasize-wndmax = false
     1857         .
     1858         if connected("ub") = true
     1859         then do:
     1860           define variable v-cntxt-db-num        as integer   no-undo .
     1861           define variable v-cntxt-userid        as character no-undo .
     1862           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1863                                             , OUTPUT v-cntxt-userid
     1864                                             ) .
     1865           run gbl/wndpar_r.p
     1866             (input  v-cntxt-db-num
     1867             ,input  v-cntxt-userid
     1868             ,input  'wndmax':U
     1869             ,output v-diasize-wndmax
     1870             ,output v-default-value
     1871             ) .
     1872         end.
     1873         assign
     1874           v-diasize-wndstore = false
     1875         .
     1876         if connected("ub") = true
     1877         then do:
     1878           run gbl/wndpar_r.p
     1879             (input  v-cntxt-db-num
     1880             ,input  v-cntxt-userid
     1881             ,input  'wndstore':U
     1882             ,output v-diasize-wndstore
     1883             ,output v-default-value
     1884             ) .
     1885         end.
     1886         assign
     1887           v-diasize-proc-name = entry(1, program-name(2), '.')
     1888         .
     1889         if v-diasize-wndstore = true
     1890         then do:
     1891           assign
     1892             v-restore-saved = false
     1893           .
     1894           if connected("ub") = true
     1895           then do:
     1896             run gbl/wndsizer.p
     1897               (input  v-cntxt-db-num
     1898               ,input  v-cntxt-userid
     1899               ,input  v-diasize-proc-name
     1900               ,input  'height':u
     1901               ,output v-resize-value-str
     1902               ) .
     1903             if v-resize-value-str <> '':U
     1904             then do:
     1905               run diasize_change-height in this-procedure
     1906                 (input  integer(v-resize-value-str)
     1907                 ,input  true
     1908                 ) .
     1909               assign
     1910                 v-restore-saved = true
     1911               .
     1912             end.
     1913           end.
     1914           if connected("ub") = true
     1915           then do:
     1916             run gbl/wndsizer.p
     1917               (input  v-cntxt-db-num
     1918               ,input  v-cntxt-userid
     1919               ,input  v-diasize-proc-name
     1920               ,input  'width':u
     1921               ,output v-resize-value-str
     1922               ) .
     1923             if v-resize-value-str <> '':U
     1924             then do:
     1925               run diasize_change-width in this-procedure
     1926                 (input  integer(v-resize-value-str)
     1927                 ,input  true
     1928                 ) .
     1929               assign
     1930                 v-restore-saved = true
     1931               .
     1932             end.
     1933           end.
     1934           if v-restore-saved <> true
     1935           then do:
     1936             if v-diasize-wndmax = true
     1937             then do:
     1938               run diasize_maximize in this-procedure
     1939                 (input  true
     1940                 ) .
     1941             end.
     1942           end.
     1943         end.
     1944         else do:
     1945           if v-diasize-wndmax = true
     1946           then do:
     1947             run diasize_maximize in this-procedure
     1948               (input  true
     1949               ) .
     1950           end.
     1951         end.
     1952       end.
     1953     end.
     1954   end procedure.
     1955   procedure diasize_need-full-display :
     1956     define output parameter p-need-full-display as logical   no-undo .
     1957     do
     1958     on error undo, return error return-value
     1959     :
     1960       assign
     1961         p-need-full-display = v-diasize-need-full-display
     1962       .
     1963       assign
     1964         v-diasize-need-full-display = false
     1965       .
     1966     end.
     1967   end procedure.
     1968   procedure get-context :
     1969      define output parameter p-db-num as integer          no-undo.
     1970      define output parameter p-user-id as character        no-undo.
     1971      define variable v-login               as character    no-undo.
     1972      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1973      define buffer buf_user-login  for ub.user-login .
     1974      do
     1975      on error undo, return error
     1976      :
     1977            FIND FIRST buf_sys-ctrl no-lock.
     1978            ASSIGN
     1979               v-login = USERID("ub")
     1980               p-db-num = buf_sys-ctrl.db-num
     1981            .
     1982            FIND FIRST buf_user-login
     1983                 WHERE buf_user-login.db-num = p-db-num
     1984                   AND buf_user-login.user-login = v-login
     1985                 no-lock
     1986                 no-error
     1987                 .
     1988            IF AVAILABLE buf_user-login
     1989            THEN DO:
     1990               assign
     1991                  p-user-id = buf_user-login.user-id
     1992               .
     1993            END.
     1994      end.
     1995   end procedure.
     1996       run diasize_init in this-procedure .
     1997   do with frame Dialog-Frame
     1998   :
     1999     if valid-handle(p-ah-infov-handle) <> true
     2000     then do:
     2001       message
     2002         vss-workfile vss-revision vss-description skip
     2003         "Ошибка задания входных параметров" skip
     2004         "Неизвестное значение указателя процедуры p-ah-infov-handle" skip
     2005         p-ah-infov-handle string(p-ah-infov-handle) skip
     2006         view-as alert-box error .
     2007       undo, return error return-value .
     2008     end.
     2009     run ah-infov_get-current in p-ah-infov-handle
     2010       (output v-available
     2011       ,output v-db-num
     2012       ,output v-obj-type
     2013       ,output v-obj-code
     2014       ,output v-archive-type
     2015       ,output v-deleted
     2016       ,output v-archive-calc
     2017       ,output v-archive-del
     2018       ,output v-archive-disable
     2019       ,output v-archive-rest
     2020       ,output v-archive-bpexist
     2021       ,output v-archive-detail-date
     2022       ,output v-archive-start-date
     2023       ,output v-archive-date-recalc
     2024       ,output v-archive-lock-prc
     2025       ,output v-archive-execuser
     2026       ,output v-archive-execsysdate
     2027       ,output v-archive-execsystime
     2028       ,output v-archive-rest-lock-prc
     2029       ,output v-archive-rest-execuser
     2030       ,output v-archive-rest-execsysdate
     2031       ,output v-archive-rest-execsystime
     2032       ) .
     2033     if v-available <> true
     2034     then do:
     2035       message
     2036         vss-workfile vss-revision vss-description skip
     2037         "Ошибка задания входных параметров" skip
     2038         "Недоступна исходная запись информации об архиве" skip
     2039         view-as alert-box error .
     2040       undo, return error return-value .
     2041     end.
     2042     run ah-infov_archive-type-name-proc in p-ah-infov-handle
     2043       (input  v-archive-type
     2044       ,output v-archive-type-name
     2045       ) .
     2046     define buffer buf_clients for ub.clients .
     2047     find first buf_clients no-lock
     2048       where buf_clients.obj-type = v-obj-type
     2049         and buf_clients.obj-code = v-obj-code
     2050       no-error .
     2051     if not available buf_clients
     2052     then do:
     2053       message
     2054         vss-workfile vss-revision vss-description skip
     2055         "Ошибка задания входных параметров" skip
     2056         "Не найден объект" v-obj-type v-obj-code skip
     2057         view-as alert-box error .
     2058       undo, return error return-value .
     2059     end.
     2060     assign
     2061       fi-object = substitute('&1 &2 &3':u
     2062                             ,v-obj-type
     2063                             ,v-obj-code
     2064                             ,buf_clients.obj-name
     2065                             )
     2066       fi-archive = v-archive-type-name
     2067     .
     2068   end.
     2069   MAIN-BLOCK:
     2070   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2071      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2072     RUN enable_UI.
     2073     WAIT-FOR GO OF FRAME Dialog-Frame.
     2074   END.
     2075   RUN disable_UI.
     2076   PROCEDURE check-file :
     2077     do
     2078     on error undo, return error return-value
     2079     :
     2080       if available archive-history
     2081       then do:
     2082         if archive-history.file-name = ""
     2083         then do:
     2084           message
     2085             "Проверить файл можно только для записей об удалении архивов" skip
     2086             "для которых была произведена выгрузка в файл" skip
     2087             view-as alert-box information .
     2088           return .
     2089         end.
     2090         if archive-history.file-valid <> true
     2091         then do:
     2092           if archive-history.file-invalid-chip-num <> 0
     2093           then do:
     2094             message
     2095               "Файл помечен как недоступный для загрузки" skip
     2096               "Для получения более подробной информации можно использовать кнопку 'Причина'" skip
     2097               view-as alert-box information .
     2098           end.
     2099           else do:
     2100             message
     2101               "Файл помечен как недоступный для загрузки" skip
     2102               view-as alert-box information .
     2103           end.
     2104           return .
     2105         end.
     2106         if search(archive-history.file-name) = ""
     2107         or search(archive-history.file-name) = ?
     2108         then do:
     2109           message
     2110             "Не найден файл" archive-history.file-name skip
     2111             view-as alert-box error .
     2112           return .
     2113         end.
     2114         define variable v-md5-signature as character no-undo .
     2115         run gbl/md5.p
     2116           (input  archive-history.file-name
     2117           ,output v-md5-signature
     2118           ) .
     2119         if v-md5-signature <> archive-history.file-md5
     2120         then do:
     2121           message
     2122             "Складской архив" v-archive-type-name skip
     2123             "Объект" v-obj-type v-obj-code skip
     2124             "Контрольная сумма файла не совпадает с информацией о выгрузке файла" skip
     2125             "Файл" archive-history.file-name skip
     2126             "Контрольная сумма" v-md5-signature skip
     2127             "Информация о выгрузке файла" archive-history.file-md5 skip
     2128             "" skip
     2129             "Архивы не могут быть восстановлены на основании данных файла" skip
     2130             view-as alert-box error .
     2131           return .
     2132         end.
     2133         else do:
     2134           message
     2135             "Складской архив" v-archive-type-name skip
     2136             "Объект" v-obj-type v-obj-code skip
     2137             "Контрольная сумма файла совпадает с информацией о выгрузке файла" skip
     2138             "Файл" archive-history.file-name skip
     2139             "Контрольная сумма" v-md5-signature skip
     2140             "Информация о выгрузке файла" archive-history.file-md5 skip
     2141             "" skip
     2142             "Архивы могут быть восстановлены на основании данных файла" skip
     2143             view-as alert-box information .
     2144           return .
     2145         end.
     2146       end.
     2147     end.
     2148   END PROCEDURE.
     2149   PROCEDURE disable_UI :
     2150     HIDE FRAME Dialog-Frame.
     2151   END PROCEDURE.
     2152   PROCEDURE display-description :
     2153     do with frame Dialog-Frame
     2154     :
     2155       if available archive-history
     2156       then do:
     2157         assign
     2158           editor-description :screen-value =
     2159               fill-up(substitute("Действие:        &1", history-description(archive-history.action-type))  , 50)  + substitute("Не рассчитан нач.ост.: &1", string(arhisatr_get-del(archive-history.archive-calc, archive-history.archive-del, archive-history.ps),  "да/нет")) + chr(10)
     2160             + fill-up(substitute("БД:              &1", archive-history.corr-user-db-num)                  , 50)  + substitute("Запрещен расчет:       &1", string(arhisatr_get-disable(archive-history.archive-calc, archive-history.archive-del, archive-history.ps),  "да/нет")) + chr(10)
     2161             + fill-up(substitute("Пользователь:    &1", archive-history.corr-user-name)                    , 50)  + substitute("Сбой удал./восст.:     &1", string(arhisatr_get-rest(archive-history.archive-calc, archive-history.archive-del, archive-history.ps), "да/нет")) + chr(10)
     2162             + fill-up(substitute("Дата:            &1", string(archive-history.corr-date, '99/99/9999':u)) , 50)  + substitute("Файл:                  &1", archive-history.file-name) + chr(10)
     2163             + fill-up(substitute("Время:           &1", archive-history.corr-time-str)                     , 50)  + substitute("Правильный:            &1", string(archive-history.file-valid, "да/нет")) + chr(10)
     2164             + fill-up(substitute("Подробный:       &1", archive-history.archive-detail-date)               , 50)  + substitute("Контрольная сумма:     &1", archive-history.file-md5) + chr(10)
     2165             + fill-up(substitute("Сжатый:          &1", archive-history.archive-start-date)                , 50)  + substitute("Номер:                 &1", archive-history.chip-num) + chr(10)
     2166             + fill-up(substitute("Перерасчёт:      &1", archive-history.archive-recalc-date)               , 50)  + substitute("Причина:               &1", archive-history.file-invalid-chip-num) + chr(10)
     2167             + fill-up(substitute("Не рассч.оборот: &1", string(arhisatr_get-calc(archive-history.archive-calc, archive-history.archive-del, archive-history.ps), "да/нет")), 50)
     2168         .
     2169       end.
     2170       else do:
     2171         assign
     2172           editor-description :screen-value = ""
     2173         .
     2174       end.
     2175     end.
     2176   END PROCEDURE.
     2177   PROCEDURE display-history :
     2178     do with frame Dialog-Frame
     2179     :
     2180       run ah-infov_get-current in p-ah-infov-handle
     2181         (output v-available
     2182         ,output v-db-num
     2183         ,output v-obj-type
     2184         ,output v-obj-code
     2185         ,output v-archive-type
     2186         ,output v-deleted
     2187         ,output v-archive-calc
     2188         ,output v-archive-del
     2189         ,output v-archive-disable
     2190         ,output v-archive-rest
     2191         ,output v-archive-bpexist
     2192         ,output v-archive-detail-date
     2193         ,output v-archive-start-date
     2194         ,output v-archive-date-recalc
     2195         ,output v-archive-lock-prc
     2196         ,output v-archive-execuser
     2197         ,output v-archive-execsysdate
     2198         ,output v-archive-execsystime
     2199         ,output v-archive-rest-lock-prc
     2200         ,output v-archive-rest-execuser
     2201         ,output v-archive-rest-execsysdate
     2202         ,output v-archive-rest-execsystime
     2203         ) .
     2204       if v-available <> true
     2205       then do:
     2206         message
     2207           vss-workfile vss-revision vss-description skip
     2208           "Ошибка задания входных параметров" skip
     2209           "Недоступна исходная запись информации об архиве" skip
     2210           view-as alert-box error .
     2211         undo, return error return-value .
     2212       end.
     2213       run ah-infov_archive-type-name-proc in p-ah-infov-handle
     2214         (input  v-archive-type
     2215         ,output v-archive-type-name
     2216         ) .
     2217       define buffer buf_clients for ub.clients .
     2218       find first buf_clients no-lock
     2219         where buf_clients.obj-type = v-obj-type
     2220           and buf_clients.obj-code = v-obj-code
     2221         no-error .
     2222       if not available buf_clients
     2223       then do:
     2224         message
     2225           vss-workfile vss-revision vss-description skip
     2226           "Ошибка задания входных параметров" skip
     2227           "Не найден объект" v-obj-type v-obj-code skip
     2228           view-as alert-box error .
     2229         undo, return error return-value .
     2230       end.
     2231       assign
     2232         fi-object = substitute('&1 &2 &3':u
     2233                               ,v-obj-type
     2234                               ,v-obj-code
     2235                               ,buf_clients.obj-name
     2236                               )
     2237         fi-archive = v-archive-type-name
     2238       .
     2239       display
     2240         fi-object
     2241         fi-archive
     2242         with frame Dialog-Frame .
     2243       run open-hist-query in this-procedure .
     2244     end.
     2245   END PROCEDURE.
     2246   PROCEDURE enable_UI :
     2247     DISPLAY toggle-file editor-description fi-object fi-archive
     2248         WITH FRAME Dialog-Frame.
     2249     ENABLE b-exit b-prev b-next b-reason b-check-file b-help toggle-file BROWSE-1
     2250            editor-description fi-object fi-archive
     2251         WITH FRAME Dialog-Frame.
     2252     VIEW FRAME Dialog-Frame.
     2253     run open-hist-query in this-procedure .
     2254   END PROCEDURE.
     2255   PROCEDURE open-hist-query :
     2256     do
     2257     on error undo, return error return-value
     2258     :
     2259       open query BROWSE-1 FOR EACH archive-history NO-LOCK
     2260         where archive-history.archive-type  = v-archive-type
     2261           and archive-history.obj-type      = v-obj-type
     2262           and archive-history.obj-code      = v-obj-code
     2263           and (toggle-file = false
     2264                or
     2265                (toggle-file = true
     2266                 and
     2267                 archive-history.file-name <> ''
     2268                )
     2269               )
     2270         use-index ishow
     2271         by archive-history.chip-num descending
     2272         .
     2273       run display-description in this-procedure .
     2274     end.
     2275   END PROCEDURE.
     2276   PROCEDURE show-reason :
     2277     do
     2278     on error undo, return error return-value
     2279     :
     2280       define buffer buf_archive-history for ub.archive-history .
     2281       if available archive-history
     2282       then do:
     2283         if archive-history.file-invalid-chip-num = 0
     2284         or archive-history.file-name = ""
     2285         then do:
     2286           message
     2287             "Причину можно показать только для записи истории" skip
     2288             "выгрузки файла" skip
     2289             "с кодом причины, отличным от нуля" skip
     2290             view-as alert-box information .
     2291         end.
     2292         else do:
     2293           find first buf_archive-history no-lock
     2294             where buf_archive-history.chip-num = archive-history.file-invalid-chip-num
     2295             no-error .
     2296           if not available buf_archive-history
     2297           then do:
     2298             message
     2299               "Запись истории с номером"
     2300               archive-history.file-invalid-chip-num
     2301               "не найдена" skip
     2302               view-as alert-box information .
     2303           end.
     2304           else do:
     2305             if archive-history.file-valid = false
     2306             then do:
     2307               define variable v-reason as character no-undo .
     2308               assign
     2309                 v-reason  = "Причина того, что файл с архивными данными не может быть загружен" + chr(10)
     2310                           + chr(10)
     2311                           + substitute("Действие:              &1", history-description(buf_archive-history.action-type)) + chr(10)
     2312                           + substitute("БД:                    &1", buf_archive-history.corr-user-db-num) + chr(10)
     2313                           + substitute("Пользователь:          &1", buf_archive-history.corr-user-name) + chr(10)
     2314                           + substitute("Дата:                  &1", string(buf_archive-history.corr-date, '99/99/9999':u)) + chr(10)
     2315                           + substitute("Время:                 &1", buf_archive-history.corr-time-str) + chr(10)
     2316                           + substitute("Подробный:             &1", buf_archive-history.archive-detail-date) + chr(10)
     2317                           + substitute("Сжатый:                &1", buf_archive-history.archive-start-date) + chr(10)
     2318                           + substitute("Перерасчёт:            &1", buf_archive-history.archive-recalc-date) + chr(10)
     2319                           + substitute("Не рассчитан оборот:   &1", string(arhisatr_get-calc(buf_archive-history.archive-calc, buf_archive-history.archive-del, buf_archive-history.ps)   ,"да/нет")) + chr(10)
     2320                           + substitute("Не рассчитан нач.ост.: &1", string(arhisatr_get-del(buf_archive-history.archive-calc, buf_archive-history.archive-del, buf_archive-history.ps)    ,"да/нет")) + chr(10)
     2321                           + substitute("Выключен расчет:      &1", string(arhisatr_get-disable(buf_archive-history.archive-calc, buf_archive-history.archive-del, buf_archive-history.ps),"да/нет")) + chr(10)
     2322                           + substitute("Сбой удал./восст.:     &1", string(arhisatr_get-rest(buf_archive-history.archive-calc, buf_archive-history.archive-del, buf_archive-history.ps)   ,"да/нет")) + chr(10)
     2323                           + substitute("Файл:                  &1", buf_archive-history.file-name) + chr(10)
     2324                           + substitute("Правильный:            &1", string(buf_archive-history.file-valid,"да/нет")) + chr(10)
     2325                           + substitute("Контрольная сумма:     &1", buf_archive-history.file-md5) + chr(10)
     2326                           + substitute("Номер:                 &1", buf_archive-history.chip-num) + chr(10)
     2327               .
     2328               run gbl/d-prompt.w
     2329                 (input  'title=\'
     2330                         + 'type=editor\'
     2331                         + 'fillin_width=96\'
     2332                         + 'fillin_height=15\'
     2333                         + 'readonly=yes\'
     2334                 , input-output v-reason
     2335                 ).
     2336             end.
     2337           end.
     2338         end.
     2339       end.
     2340     end.
     2341   END PROCEDURE.
     2342   FUNCTION fill-up RETURNS CHARACTER
     2343     ( input p-message as character, input p-length as integer ) :
     2344     define variable v-new-message as character no-undo .
     2345     assign
     2346       v-new-message = substitute('&1', p-message)
     2347     .
     2348     if length(v-new-message) < p-length
     2349     then do:
     2350       assign
     2351         v-new-message = v-new-message + fill(' ', p-length - length(v-new-message))
     2352       .
     2353     end.
     2354     return v-new-message .
     2355   END FUNCTION.
     2356   FUNCTION history-description RETURNS CHARACTER
     2357     ( input p-history-type as character ) :
     2358     define variable v-history-description as character no-undo .
     2359     run ah-infov_history-description in p-ah-infov-handle
     2360       (input  p-history-type
     2361       ,output v-history-description
     2362       ) .
     2363     return v-history-description .
     2364   END FUNCTION.
