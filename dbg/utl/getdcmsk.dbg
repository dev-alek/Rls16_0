      338         ).
      339   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      341     (input  v-report-name
      342     ,input  2
      343     ,output v-exist
      344     )  .
      345       if NOT v-exist then
      346       DO:
      347         Message
      348           "Нет заданий на печать ! "
      349           view-as alert-box .
      350         Return  .
      351       End.
      352       run gbl/prnfilen.w
      353         (input  ""
      354         ,input  p-DisabledOptions
      355         ,input  string(v-report-name )
      356         ,input  7
      357         ,output v-user-action
      358         ,output v-printed
      359         ) .
      360       if v-printed then
      361       do:
      362         return "YES" .
      363       end.
      364       else
      365       do:
      366         return "NO" .
      367       end.
      368     end.
      369   end procedure.
      370   procedure prn-lib-open-stream :
      371     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      372     define input parameter p-page-size    as integer no-undo .
      373     define input parameter p-is-stream    as logical no-undo .
      374     define input parameter p-append       as logical no-undo .
      375     define variable v-report-name as character no-undo .
      376     do
      377       on error undo, return error
      378       :
      379       run prn-lib-get-report-name  in this-procedure (
      380         input parParentProc
      381         ,output v-report-name
      382         ).
      383       if p-is-stream then
      384       do:
      385         if p-append then
      386         do:
      387           output stream PrnLibStream to value( v-report-name )
      388             page-size value(p-page-size) append .
      389         end.
      390         if not p-append then
      391         do:
      392           output stream PrnLibStream to value( v-report-name )
      393             page-size value(p-page-size) .
      394         end.
      395       end.
      396       if not p-is-stream then
      397       do:
      398         if p-append then
      399         do:
      400           output to value( v-report-name )
      401             page-size value(p-page-size) append .
      402         end.
      403         if not p-append then
      404         do:
      405           output to value( v-report-name )
      406             page-size value(p-page-size) .
      407         end.
      408       end.
      409     end.
      410   end procedure.
      411   procedure prn-lib-open-exp :
      412     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      413     define input parameter p-is-stream    as logical no-undo .
      414     define input parameter p-is-append    as logical no-undo .
      415     define output parameter p-ReportFileName as char init "report" no-undo.
      416     define output parameter p-process as logical no-undo .
      417     define variable glog as logical no-undo .
      418     do
      419       on error undo, return error
      420       :
      421       SYSTEM-DIALOG GET-FILE p-ReportFileName
      422         TITLE      "Укажите путь"
      423         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      424         ASK-OVERWRITE
      425         CREATE-TEST-FILE
      426         SAVE-AS
      427         USE-FILENAME
      428         DEFAULT-EXTENSION "txt"
      429         UPDATE glog
      430         .
      431       if not glog then  return.
      432       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      433       if p-is-stream then
      434       do:
      435         if p-is-append then
      436         do:
      437           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      438         end.
      439         else
      440         do:
      441           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      442         end.
      443       end.
      444       else
      445       do:
      446         if p-is-append then
      447         do:
      448           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      449         end.
      450         else
      451         do:
      452           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      453         end.
      454       end.
      455       p-process = yes.
      456     end.
      457   end procedure.
      458   procedure prn-lib-get-report-name :
      459     define input parameter parParentProc  as widget-handle no-undo.
      460     define output parameter p-report-name as character no-undo .
      461     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      462   end procedure.
      463   procedure prn-lib-reportviewer-report-name :
      464     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      465     define input parameter p-report-name-html as character no-undo .
      466     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      467   end procedure.
      468   procedure prn-lib-reportviewer :
      469     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      470     define input parameter p-report-name-html as character no-undo .
      471     define input parameter p-param        as character no-undo .
      472     define variable v-excel           as character no-undo init 'TRUE' .
      473     define variable v-value-character as character no-undo .
      474     define variable v-value-integer   as character no-undo .
      475     define variable v-value-date      as date      no-undo .
      476     define variable v-value-decimal   as decimal   no-undo .
      477     define variable rep-excel         as logical   no-undo .
      478     define variable excel-string      as character no-undo .
      479     define variable v-param-type      as character no-undo .
      480     define variable v-tth             as handle    no-undo .
      481     run adm/shattri.p (
      482       input "get":U
      483       ,input  ""
      484       ,input  0
      485       ,input  'report-glob':U
      486       ,input  'rep-excel':U
      487       ,output v-value-character
      488       ,output v-value-date
      489       ,output v-value-decimal
      490       ,output v-value-integer
      491       ,output rep-excel
      492       ,output v-param-type
      493       ,INPUT-OUTPUT table-handle v-tth
      494       )  .
      495     if rep-excel then v-excel = "TRUE" .
      496     else v-excel = "FALSE" .
      497     if p-param eq ""
      498     then
      499        p-param = "EXCEL:" + v-excel.
      500     else
      501        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      502     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      503   end procedure.
      504   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   procedure cur-time :
      506      define output parameter p-today as date      no-undo .
      507      define output parameter p-time  as integer   no-undo .
      508     do
      509     on error undo, return error
      510     :
      511       define variable v-date1 as date      no-undo .
      512       define variable v-date2 as date      no-undo .
      513       define variable v-time  as integer   no-undo .
      514       assign
      515         v-date1 = today
      516         v-time  = time
      517         v-date2 = today
      518       .
      519       if v-date1 <> v-date2
      520       then do:
      521         assign
      522           v-date1 = today
      523           v-time  = v-time
      524         .
      525       end.
      526       assign
      527         p-today = v-date1
      528         p-time  = v-time
      529       .
      530     end.
      531   end.
      532   function cur-time-date returns character
      533   :
      534     return string(today, '99/99/9999':U) .
      535   end.
      536   function cur-time-mjd returns decimal
      537   :
      538     define variable v-date as date      no-undo .
      539     define variable v-time as integer   no-undo .
      540     run cur-time in this-procedure
      541       (output v-date
      542       ,output v-time
      543       ) .
      544     return integer(v-date) - 2400002 + (v-time / 86400) .
      545   end.
      546   function cur-time-get-ending-index returns integer
      547   (input p-number as integer
      548   )
      549   :
      550     if p-number < 0
      551     or p-number = ?
      552     then do:
      553       return 1 .
      554     end.
      555     define variable v-rest as integer   no-undo .
      556     assign
      557       p-number = p-number modulo 100
      558     .
      559     if p-number < 20
      560     then do:
      561       assign
      562         v-rest = p-number
      563       .
      564     end.
      565     else do:
      566       assign
      567         v-rest = p-number modulo 10
      568       .
      569     end.
      570     case v-rest :
      571       when 1
      572       then do:
      573         return 2 .
      574       end.
      575       when 2 or
      576       when 3 or
      577       when 4
      578       then do:
      579         return 3 .
      580       end.
      581       otherwise do:
      582         return 1 .
      583       end.
      584     end case .
      585   end.
      586   procedure cur-time-mjd-to-date :
      587      define input  parameter i-mjd-diff as decimal no-undo.
      588      define output parameter o-Date     as date    no-undo.
      589      define output parameter o-Time     as integer no-undo.
      590      define variable v-day-number as integer   no-undo .
      591      if    i-mjd-diff < 0
      592         or i-mjd-diff = ?
      593      then do:
      594         return "?" .
      595      end.
      596      assign
      597         v-day-number = truncate(i-mjd-diff,0).
      598         o-Date = date(v-day-number + 2400002).
      599         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      600     .
      601   end.
      602   function cur-time-mjd-to-string returns character
      603   (input p-mjd-diff as decimal
      604   )
      605   :
      606     define variable v-day-number as integer   no-undo .
      607     define variable v-seconds    as integer   no-undo .
      608     define variable v-hour       as integer   no-undo .
      609     define variable v-min        as integer   no-undo .
      610     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      611     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      612     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      613     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      614     if p-mjd-diff < 0
      615     or p-mjd-diff = ?
      616     then do:
      617       return "?" .
      618     end.
      619     assign
      620       v-day-number = integer(truncate(p-mjd-diff,0))
      621       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      622     .
      623     if v-seconds > 86400
      624     then do:
      625       assign
      626         v-seconds = 86400 - 1
      627       .
      628     end.
      629     if v-seconds < 0
      630     then do:
      631       assign
      632         v-seconds = 0
      633       .
      634     end.
      635     assign
      636       v-hour = truncate(v-seconds / 3600, 0)
      637     .
      638     assign
      639       v-seconds = v-seconds modulo 3600
      640     .
      641     assign
      642       v-min = truncate(v-seconds / 60, 0)
      643     .
      644     assign
      645       v-seconds = v-seconds modulo 60
      646     .
      647     return
      648         (if v-day-number <> 0
      649           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      650           else ""
      651         )
      652       + (if v-day-number <> 0 or v-hour <> 0
      653           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      654           else ""
      655         )
      656       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      657           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      658           else ""
      659         )
      660       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      661       .
      662   end.
      663   function cur-time-string returns character
      664   :
      665     define variable v-date as date      no-undo .
      666     define variable v-time as integer   no-undo .
      667     run cur-time in this-procedure
      668       (output v-date
      669       ,output v-time
      670       ) .
      671     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      672   end.
      673   function cur-time-string-sec returns character
      674   :
      675     define variable v-date as date      no-undo .
      676     define variable v-time as integer   no-undo .
      677     run cur-time in this-procedure
      678       (output v-date
      679       ,output v-time
      680       ) .
      681     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      682   end.
      683   function cur-time-custom  returns character
      684   (input p-prefix as character
      685   ,input p-date-format as character
      686   ,input p-delimiter as character
      687   ,input p-time-format as character
      688   ,input p-suffix as character
      689   )
      690   :
      691     define variable v-date as date      no-undo .
      692     define variable v-time as integer   no-undo .
      693     run cur-time in this-procedure
      694       (output v-date
      695       ,output v-time
      696       ) .
      697     return
      698       p-prefix
      699       + string(v-date, p-date-format)
      700       + p-delimiter
      701       + string(v-time, p-time-format)
      702       + p-suffix
      703       .
      704   end.
      705   function cur-time-print  returns character
      706   :
      707     define variable v-date as date      no-undo .
      708     define variable v-time as integer   no-undo .
      709     run cur-time in this-procedure
      710       (output v-date
      711       ,output v-time
      712       ) .
      713     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      714   end.
      715   function cur-time-datetime returns datetime
      716   :
      717     define variable v-char as character no-undo .
      718     define variable v-datetime as datetime no-undo .
      719     v-char = cur-time-string().
      720     v-datetime = datetime(v-char).
      721     return  v-datetime.
      722   end.
      723   function cur-time-string-msec returns character
      724   :
      725     define variable v-date as datetime  no-undo .
      726     v-date = now.
      727     return string(v-date) .
      728   end.
      729   define temp-table tt-dis-card no-undo
      730   like ub.dis-card
      731   field d-card-u like ub.dis-card.d-card
      732   index pi is unique primary
      733   d-card.
      734   define temp-table temp-dc-mask no-undo
      735   field d-card-start like ub.dis-card.d-card
      736   field d-card-end   like ub.dis-card.d-card
      737   field bis-d-card-start like ub.dis-card.d-card
      738   field bis-d-card-end   like ub.dis-card.d-card
      739   field type         like ub.dis-card-type.type
      740   field num-recs     as integer
      741   field num-recs-calc as decimal
      742   field maska        as character
      743   field maska-save   as character
      744   field length_      as integer
      745   field node-code    as integer
      746   field upper-code   as integer
      747   field high-code    as decimal
      748   field to-decompose as logical
      749   field cut-down     as logical
      750   field cut-up       as logical
      751   index pi is unique primary
      752   node-code
      753   index iupper upper-code
      754   index i1 d-card-start maska
      755   index isave
      756   length_ maska-save
      757   index isort1
      758   length_ bis-d-card-start
      759   index isort2
      760   length_ bis-d-card-end
      761   index ishow
      762   length_
      763   d-card-start
      764   index id
      765   to-decompose
      766   .
      767   define variable v-get-data  as character no-undo .
      768   define variable ii as integer no-undo .
      769   define variable v-not-number as logical no-undo .
      770   define variable v-type like ub.dis-card-type.type no-undo .
      771   define variable v-length as integer no-undo .
      772   define variable v-dopi as decimal no-undo .
      773   define variable v-print as logical no-undo .
      774   define variable v-d-card like ub.dis-card.d-card no-undo .
      775   define variable v-count as integer no-undo .
      776   define variable v-flag as logical no-undo init yes.
      777   define variable v-dop1 as character no-undo .
      778   define variable v-dop2 as character no-undo .
      779   define variable v-seq as integer no-undo .
      780   define variable v-found as logical no-undo .
      781   define variable v-file-name as character no-undo .
      782   define variable v-file-directory as character no-undo .
      783   define variable v-choose as logical no-undo .
      784   define variable v-dopd as decimal no-undo .
      785   define variable v-choice as integer no-undo .
      786   define buffer buf_dis-card for ub.dis-card.
      787   define buffer buf_dis-card-type for ub.dis-card-type.
      788   define buffer buf_clients for ub.clients.
      789   define buffer buf_temp-dc-mask for temp-dc-mask.
      790   define stream InStream.
      791     run gbl/d-askw.w (  input "Сбор данных по диапазонам ДК"
      792                   ,input "получаем информацию по непересекающимся диапазонам карт"
      793                   ,input "|"
      794                   ,input ("Из БД|" +
      795                          "Из файла|" +
      796                          "Отказ")
      797                   ,input "||"
      798                   ,input 1
      799                   ,input 3
      800                   ,output v-choice).
      801   if v-choice = 3 then return.
      802   if v-choice = 1 then v-get-data = 'db'.
      803   if v-choice = 2 then v-get-data = 'file'.
      804   if v-get-data = 'db':U then do:
      805     for each tt-dis-card:
      806       delete tt-dis-card.
      807     end.
      808     for each buf_dis-card no-lock
      809     by buf_dis-card.d-card   :
      810       assign
      811       ii = ii + 1
      812       .
      813       if ii modulo 100 = 0 then do:
      814         run waitfram-show in this-procedure (string(ii)).
      815       end.
      816         create tt-dis-card.
      817       buffer-copy buf_dis-card
      818       to tt-dis-card
      819       assign
      820       tt-dis-card.d-card-u = fill('#':U , 19 - length(buf_dis-card.d-card)) + buf_dis-card.d-card.
      821     end.
      822     ii = 0.
      823     for each tt-dis-card no-lock
      824     by tt-dis-card.d-card-u   :
      825       assign
      826       ii = ii + 1
      827       v-print = no
      828       .
      829       if ii modulo 100 = 0 then do:
      830         run waitfram-show in this-procedure (string(ii)).
      831       end.
      832       if  length(tt-dis-card.d-card) <> v-length
      833       or tt-dis-card.type <> v-type then do:
      834         if v-type <> '':U then do:
      835           if available temp-dc-mask then
      836           assign
      837           temp-dc-mask.d-card-end = v-d-card
      838           temp-dc-mask.num-recs = v-count
      839           .
      840         end.
      841         v-count = 0.
      842         find first temp-dc-mask no-lock where
      843                   temp-dc-mask.d-card-start = tt-dis-card.d-card no-error .
      844         if not available temp-dc-mask then do:
      845           create temp-dc-mask.
      846           assign
      847           temp-dc-mask.upper-code   = 0
      848           temp-dc-mask.node-code    = v-seq + 1
      849           v-seq                     = v-seq + 1
      850           temp-dc-mask.high-code    = temp-dc-mask.node-code
      851           temp-dc-mask.d-card-start = tt-dis-card.d-card
      852           temp-dc-mask.type = tt-dis-card.type
      853           temp-dc-mask.length_ = length(tt-dis-card.d-card)
      854           .
      855         end.
      856       end.
      857       assign
      858       v-length = length(tt-dis-card.d-card)
      859       v-type = tt-dis-card.type
      860       v-count = v-count + 1
      861       v-d-card = tt-dis-card.d-card
      862       .
      863       process events.
      864     end.
      865     find first temp-dc-mask where
      866               temp-dc-mask.node-code = v-seq - 1 no-error .
      867     if available temp-dc-mask then
      868     assign
      869     temp-dc-mask.d-card-end = v-d-card
      870     temp-dc-mask.num-recs = v-count
      871     .
      872   end.
      873   if v-get-data = 'file' then do:
      874     run gbl/d-file.p (
      875     input-output v-file-name
      876     ,input-output v-file-directory
      877     ,input        "Текстовые файлы,Все файлы"
      878     ,input        "*.txt,*.*":U
      879     ,input        ","
      880     ,input        "txt,all":U
      881     ,input        yes
      882     ,input        no
      883     ,input        yes
      884     ,input        "Введите имя файла, содержащего данные по диапазонам карт"
      885     ,output       v-choose
      886     ).
      887     if not v-choose then return.
      888     input stream Instream from value(v-file-name).
      889     _repeat:
      890     repeat:
      891       create temp-dc-mask.
      892       temp-dc-mask.num-recs = ?.
      893       import stream Instream temp-dc-mask.type temp-dc-mask.d-card-start temp-dc-mask.d-card-end temp-dc-mask.num-recs no-error .
      894       if error-status:error then do:
      895         message
      896         substitute("Строка &1&2Ошибка при импорте&2&3&2&4"
      897                   , v-seq + 1
      898                   , chr(10)
      899                   , error-status:get-message(1)
      900                   , return-value )
      901        view-as alert-box error .
      902        next _repeat.
      903       end.
      904       if length(temp-dc-mask.d-card-start) <> length(temp-dc-mask.d-card-end) then do:
      905         message
      906         substitute("Строка &1&2Разная длина номера карты для карты начала и конца диапазона"
      907                   , v-seq + 1
      908                   , chr(10))
      909         view-as alert-box error .
      910         next _repeat.
      911       end.
      912       assign
      913       v-dopd = decimal(temp-dc-mask.d-card-start) no-error.
      914       if ( error-status:error ) OR
      915           index( temp-dc-mask.d-card-start , "." ) > 0 OR
      916           index( temp-dc-mask.d-card-start , chr(44) ) > 0 OR
      917           index( temp-dc-mask.d-card-start , "-" ) > 0 OR
      918           index( temp-dc-mask.d-card-start , "+" ) > 0 then do:
      919         message
      920         substitute("Строка&1&2Возможно только цифровое значение номера дисконтной карты"
      921                    , v-seq + 1
      922                    , chr(10))
      923         view-as alert-box error .
      924       end.
      925       assign
      926       v-dopd = decimal(temp-dc-mask.d-card-end) no-error.
      927       if ( error-status:error ) OR
      928           index( temp-dc-mask.d-card-start , "." ) > 0 OR
      929           index( temp-dc-mask.d-card-start , chr(44) ) > 0 OR
      930           index( temp-dc-mask.d-card-start , "-" ) > 0 OR
      931           index( temp-dc-mask.d-card-start , "+" ) > 0 then do:
      932         message
      933         substitute("Строка&1&2Возможно только цифровое значение номера дисконтной карты"
      934                    , v-seq + 1
      935                    , chr(10))
      936         view-as alert-box error .
      937       end.
      938       assign
      939       temp-dc-mask.upper-code   = 0
      940       temp-dc-mask.node-code    = v-seq + 1
      941       v-seq                     = v-seq + 1
      942       temp-dc-mask.high-code    = temp-dc-mask.node-code
      943       temp-dc-mask.length_ = length(temp-dc-mask.d-card-start)
      944       temp-dc-mask.num-recs = (if temp-dc-mask.num-recs = ?
      945                                then decimal(temp-dc-mask.d-card-end) - decimal(temp-dc-mask.d-card-start) + 1
      946                                else temp-dc-mask.num-recs)
      947       .
      948     end.
      949     input stream Instream close.
      950     find first temp-dc-mask where
      951     temp-dc-mask.type = '':U no-error .
      952     if available temp-dc-mask then delete temp-dc-mask.
      953   end.
      954   _temp-dc-mask:
      955   for each temp-dc-mask:
      956    v-flag = yes.
      957     do ii = 1 to temp-dc-mask.length_:
      958       assign
      959       v-dop1 = substring(temp-dc-mask.d-card-start, ii, 1)
      960       v-dop2 = substring(temp-dc-mask.d-card-end, ii, 1)
      961       v-flag = v-flag and (v-dop1 = v-dop2 )
      962       .
      963       assign
      964       temp-dc-mask.maska =  temp-dc-mask.maska +
      965                            (if v-dop1 = v-dop2
      966                            and v-flag
      967                            then v-dop1
      968                            else chr(63))
      969       temp-dc-mask.maska-save =  temp-dc-mask.maska
      970       .
      971     end.
      972     if temp-dc-mask.num-recs = 1
      973     or index(temp-dc-mask.maska, chr(63)) = temp-dc-mask.length_  then do:
      974       temp-dc-mask.maska = "".
      975     end.
      976     assign
      977     temp-dc-mask.bis-d-card-start = replace(temp-dc-mask.maska-save, chr(63), '0':U)
      978     temp-dc-mask.bis-d-card-end   = replace(temp-dc-mask.maska-save, chr(63), '9':U)
      979     .
      980   end.
      981   for each temp-dc-mask
      982   by temp-dc-mask.length_
      983   by temp-dc-mask.d-card-start:
      984     if temp-dc-mask.maska <> '':U then
      985     run decompose-mask in this-procedure (buffer temp-dc-mask) .
      986   end.
      987   for each temp-dc-mask:
      988     if temp-dc-mask.maska <> '':U
      989     and temp-dc-mask.to-decompose = yes
      990     then
      991     run decompose-mask in this-procedure (buffer temp-dc-mask) .
      992   end.
      993   for each temp-dc-mask:
      994     assign
      995     temp-dc-mask.bis-d-card-start   = (if (temp-dc-mask.d-card-start >= temp-dc-mask.bis-d-card-start
      996                                       and temp-dc-mask.d-card-start <= temp-dc-mask.bis-d-card-end)
      997                                       and temp-dc-mask.cut-down
      998                                       then temp-dc-mask.d-card-start
      999                                       else temp-dc-mask.bis-d-card-start)
     1000     temp-dc-mask.bis-d-card-end     = (if (temp-dc-mask.d-card-end >= temp-dc-mask.bis-d-card-start
     1001                                       and temp-dc-mask.d-card-end <= temp-dc-mask.bis-d-card-end)
     1002                                       and temp-dc-mask.cut-up
     1003                                       then temp-dc-mask.d-card-end
     1004                                       else temp-dc-mask.bis-d-card-end)
     1005     temp-dc-mask.num-recs-calc      = decimal(temp-dc-mask.bis-d-card-end) - decimal(temp-dc-mask.bis-d-card-start) + 1
     1006     .
     1007   end.
     1008   run prn-lib-open-stream  in this-procedure (
     1009                                                input parParentProc
     1010                                               ,input 62
     1011                                               ,input yes
     1012                                               ,input no
     1013                                               ).
     1014   put stream PrnLibStream unformatted
     1015   "Имеющиеся номера дисконтных карт" skip(0)
     1016    cur-time-print() AT 5 format "x(35)" skip(0)
     1017   "Диапазоны дисконтных карт разложением на поддиапазоны" AT 5 skip(0)
     1018   "Рекоменд. маска"
     1019   "Тип карты"    at 21
     1020   "Начало диап." at 30
     1021   "Конец диап."  at 50
     1022   "Кол-во карт"  at 70
     1023   skip(0)
     1024   "Факт/возможн" at 30
     1025   "Факт/возможн" at 50
     1026   "Факт/возможн" at 70
     1027   skip(0)
     1028   fill('-', 80) skip(0).
     1029   for each temp-dc-mask where temp-dc-mask.upper-code = 0
     1030   by temp-dc-mask.length_
     1031   by temp-dc-mask.d-card-start
     1032   :
     1033     put stream PrnLibStream unformatted
     1034     temp-dc-mask.maska
     1035     temp-dc-mask.type at 21
     1036     temp-dc-mask.d-card-start at 30
     1037     temp-dc-mask.d-card-end   at 50
     1038     temp-dc-mask.num-recs     at 70
     1039     skip.
     1040     put stream PrnLibStream unformatted
     1041     fill('-', 80) skip(0).
     1042     v-found = no.
     1043     for each buf_temp-dc-mask no-lock where
     1044             buf_temp-dc-mask.upper-code = temp-dc-mask.node-code :
     1045       put stream PrnLibStream unformatted
     1046       buf_temp-dc-mask.maska
     1047       buf_temp-dc-mask.bis-d-card-start at 30
     1048       buf_temp-dc-mask.bis-d-card-end   at 50
     1049       buf_temp-dc-mask.num-recs-calc    at 70
     1050       skip.
     1051       v-found = yes.
     1052     end.
     1053     if not v-found then do:
     1054       put stream PrnLibStream unformatted
     1055       temp-dc-mask.maska
     1056       temp-dc-mask.bis-d-card-start at 30
     1057       temp-dc-mask.bis-d-card-end   at 50
     1058       temp-dc-mask.num-recs-calc    at 70
     1059       skip.
     1060     end.
     1061     put stream PrnLibStream unformatted
     1062     skip(2).
     1063   end.
     1064   put stream PrnLibStream unformatted
     1065   skip(0)
     1066   "В порядке номеров карт" AT 5 skip(0)
     1067   fill('-', 80) skip(1)
     1068   .
     1069   for each temp-dc-mask
     1070   by temp-dc-mask.length_
     1071   by temp-dc-mask.bis-d-card-start:
     1072     find first buf_temp-dc-mask no-lock where
     1073               buf_temp-dc-mask.upper-code = temp-dc-mask.node-code no-error .
     1074     if not available buf_temp-dc-mask then do:
     1075       put stream PrnLibStream unformatted
     1076       temp-dc-mask.maska
     1077       temp-dc-mask.type at 21
     1078       temp-dc-mask.bis-d-card-start at 30
     1079       temp-dc-mask.bis-d-card-end   at 50
     1080       temp-dc-mask.num-recs-calc    at 70
     1081       skip.
     1082     end.
     1083   end.
     1084   output stream PrnLibStream close.
     1085   run waitfram-hide in this-procedure .
     1086   run prn-lib-prn-file in this-procedure (
     1087                                             input parParentProc
     1088                                             ,input 0
     1089                                             ).
     1090   procedure decompose-mask :
     1091   define parameter buffer buf_temp-dc-mask for temp-dc-mask.
     1092   define variable v-mask as character no-undo .
     1093   define variable v-first-ques as integer no-undo .
     1094   define variable v-start as integer no-undo .
     1095   define variable v-end as integer no-undo .
     1096   define variable v-found as logical no-undo .
     1097   define variable v-new-maska as character no-undo .
     1098   define buffer buf1_temp-dc-mask for temp-dc-mask .
     1099   define buffer buf2_temp-dc-mask for temp-dc-mask .
     1100   do
     1101   on error undo, return error
     1102   :
     1103     _buf2:
     1104     for each buf2_temp-dc-mask where
     1105               buf2_temp-dc-mask.length_ = buf_temp-dc-mask.length_
     1106          and  buf2_temp-dc-mask.maska > '':U
     1107          AND  (
     1108                (buf2_temp-dc-mask.bis-d-card-start >= buf_temp-dc-mask.bis-d-card-start
     1109                 AND  buf2_temp-dc-mask.bis-d-card-start   <= buf_temp-dc-mask.bis-d-card-end)
     1110                 or
     1111                (buf2_temp-dc-mask.bis-d-card-end >= buf_temp-dc-mask.bis-d-card-start
     1112                 AND  buf2_temp-dc-mask.bis-d-card-end   <= buf_temp-dc-mask.bis-d-card-end)
     1113               ):
     1114       if buf2_temp-dc-mask.high-code = buf_temp-dc-mask.high-code then next.
     1115       assign
     1116       v-mask = buf_temp-dc-mask.maska
     1117       v-first-ques = index(v-mask, chr(63))
     1118       .
     1119       buf2_temp-dc-mask.to-decompose = yes.
     1120       if v-first-ques = 0 then do:
     1121         next _buf2.
     1122       end.
     1123       if
     1124       (buf2_temp-dc-mask.bis-d-card-start >= buf_temp-dc-mask.bis-d-card-start
     1125       AND  buf2_temp-dc-mask.bis-d-card-start   <= buf_temp-dc-mask.bis-d-card-end)  then do:
     1126         assign
     1127         buf_temp-dc-mask.cut-down = yes.
     1128       end.
     1129       if (buf2_temp-dc-mask.bis-d-card-end >= buf_temp-dc-mask.bis-d-card-start
     1130       AND  buf2_temp-dc-mask.bis-d-card-end   <= buf_temp-dc-mask.bis-d-card-end) then do:
     1131         assign
     1132         buf_temp-dc-mask.cut-up = yes.
     1133       end.
     1134       assign
     1135       v-start = integer(substring(buf_temp-dc-mask.d-card-start, v-first-ques , 1))
     1136       v-end   = integer(substring(buf_temp-dc-mask.d-card-end, v-first-ques , 1))
     1137       buf_temp-dc-mask.maska = '':U
     1138       .
     1139       do ii = v-start to v-end:
     1140         v-new-maska                          = v-mask.
     1141         substring(v-new-maska, v-first-ques, 1) = string(ii).
     1142         create buf1_temp-dc-mask.
     1143         buffer-copy buf_temp-dc-mask
     1144         except cut-down cut-up
     1145         to buf1_temp-dc-mask
     1146         assign
     1147         buf1_temp-dc-mask.upper-code         = buf_temp-dc-mask.node-code
     1148         buf1_temp-dc-mask.node-code          = v-seq + 1
     1149         v-seq                                = v-seq + 1
     1150         buf1_temp-dc-mask.maska              = v-new-maska
     1151         buf1_temp-dc-mask.bis-d-card-start   = replace(buf1_temp-dc-mask.maska, chr(63), '0':U)
     1152         buf1_temp-dc-mask.bis-d-card-end     = replace(buf1_temp-dc-mask.maska, chr(63), '9':U)
     1153         .
     1154       end.
     1155       for each buf1_temp-dc-mask where
     1156       buf1_temp-dc-mask.upper-code = buf_temp-dc-mask.node-code:
     1157         run decompose-mask in this-procedure (buffer buf1_temp-dc-mask).
     1158       end.
     1159       buf_temp-dc-mask.to-decompose = no.
     1160     end.
     1161   end.
     1162   end procedure.
