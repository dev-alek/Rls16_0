      239      method public static utl.gpwdbrw_flt GetObject(iFilter as class utl.gpwdbrw-filter):
      240         def var vForm as class utl.gpwdbrw_flt.
      241         assign
      242            vForm = new utl.gpwdbrw_flt()
      243            vForm:Filter = iFilter
      244         .
      245         vForm:SetCondition("User",    vForm:Filter:User).
      246         vForm:SetCondition("HostName",vForm:Filter:HostName).
      247         vForm:SetCondition("DateGen", vForm:Filter:DateGen).
      248         vForm:SetCondition("Fio",     vForm:Filter:Fio).
      249         vForm:SetCondition("Object",  vForm:Filter:ObjectNum).
      250         vForm:SetCondition("CashNum", vForm:Filter:CashNum).
      251         vForm:SetCondition("DateProl", vForm:Filter:DateProl).
      252         vForm:ObjectToForm().
      253         return vForm.
      254      end method.
      255           @VisualDesigner.
