      259      method public void SetCondition(iControlName as char, iCond as utl.flt-condition):
      260         case iControlName:
      261            when "User"     then ucUser:Condition = iCond.
      262            when "HostName" then ucHostName:Condition = iCond.
      263            when "DateGen"  then ucDateGen:Condition = iCond.
      264            when "Fio"      then ucFio:Condition = iCond.
      265            when "Object"   then ucObject:Condition = iCond.
      266            when "CashNum" then ucCashNum:Condition = iCond.
      267            when "DateProl" then ucDateProl:Condition = iCond.
      268         end case.
      269      end method.
      270      method public void FormToObject():
      271         this-object:ucUser:FormToObject().
      272         this-object:ucFio:FormToObject().
      273         this-object:ucDateGen:FormToObject().
      274         this-object:ucObject:FormToObject().
      275         this-object:ucHostName:FormToObject().
      276         this-object:ucCashNum:FormToObject().
      277         this-object:ucDateProl:FormToObject().
      278         if this-object:rbAnd:Checked then
      279            this-object:Filter:Modifier = "and".
      280         if this-object:rbOr:Checked then
      281            this-object:Filter:Modifier = "or".
      282      end method.
      283      method public void ObjectToForm():
      284         this-object:ucUser:ObjectToForm().
      285         this-object:ucFio:ObjectToForm().
      286         this-object:ucDateGen:ObjectToForm().
      287         this-object:ucObject:ObjectToForm().
      288         this-object:ucHostName:ObjectToForm().
      289         this-object:ucCashNum:ObjectToForm().
      290         this-object:ucDateProl:ObjectToForm().
      291         if this-object:Filter:Modifier = "and" then
      292            this-object:rbAnd:Checked = yes.
      293         if this-object:Filter:Modifier = "or" then
      294            this-object:rbOr:Checked = yes.
      295      end method.
      296      method private char GetCli():
      297         def buffer bclients for clients.
      298         def var v-rid-list as char  no-undo.
      299         def var vCli       as char  no-undo.
      300         def var vI         as int64 no-undo.
      301         def var vParam     as char  no-undo.
      302         if this-object:ucFio:SelectedOp() = "список" then
      303            vParam = "b-sel,b-mark".
      304         else
      305            vParam = "b-sel".
      306         run ref/cli-all.w (utl.gpwdbrw:parParentProc
      307                     ,input vParam
      308                     ,input 'чел':U
      309                     ,input 'все':U
      310                     ,input 'текущие':U
      311                     ,input ?
      312                     ,input ",,,,,,NO,,"
      313                     ,input "":U
      314                     ,output v-rid-list).
      315         if v-rid-list <> "" or v-rid-list <> ? then
      316         do:
      317            do vI = 1 to num-entries(v-rid-list):
      318               find first bclients where
      319                    recid(bclients) = int64(entry(vI,v-rid-list))
      320               no-lock no-error.
      321               if avail bclients then
      322               do:
      323                  vCli = substitute("&1,&2",
      324                                    vCli,
      325                                    string(bclients.obj-name)).
      326               end.
      327            end.
      328            vCli = trim(vCli,",").
      329         end.
      330         return vCli.
      331      end method.
      332      method private char GetShop():
      333         def buffer bclients for clients.
      334         def var v-rid-list as char  no-undo.
      335         def var vShopNum   as char  no-undo.
      336         def var vI         as int64 no-undo.
      337         def var vParam     as char  no-undo.
      338         if ucObject:SelectedOp() = "список" then
      339            vParam = "b-sel,b-mark".
      340         else
      341            vParam = "b-sel".
      342         run ref/cli-all.w (utl.gpwdbrw:parParentProc
      343                     ,input vParam
      344                     ,input 'маг':U
      345                     ,input 'все':U
      346                     ,input 'текущие':U
      347                     ,input ?
      348                     ,input ",,,,,,NO,,"
      349                     ,input "":U
      350                     ,output v-rid-list) no-error.
      351         if (v-rid-list <> "" or v-rid-list <> ?) then
      352         do:
      353            do vI = 1 to num-entries(v-rid-list):
      354               find first bclients where
      355                    recid(bclients) = int64(entry(vI,v-rid-list))
      356               no-lock no-error.
      357               if avail bclients then
      358               do:
      359                  vShopNum = substitute("&1,&2",
      360                                        vShopNum,
      361                                        string(bclients.obj-code)).
      362               end.
      363            end.
      364            vShopNum = trim(vShopNum,",").
      365         end.
      366         return vShopNum.
      367      end method.
      368      method private char GetUser():
      369         def var v-cntxt-userid    as char no-undo.
      370         def var v-selected-userid as char no-undo.
      371         def var v-old-userid      as char no-undo.
      372         def var v-mode            as integer no-undo.
      373         def var v-accepted        as log no-undo.
      374         if ucUser:SelectedOp() = "список" then
      375            v-mode = 1.
      376         else
      377            v-mode = 2.
      378         run str/usersel2.p ( input utl.gpwdbrw:parParentProc
      379                            , input ""
      380                            , v-mode
      381                            , output v-selected-userid
      382                            , output v-old-userid
      383                            , output v-accepted
      384                           ).
      385         return v-selected-userid.
      386      end method.
      387      destructor public gpwdbrw_flt ( ):
      388      end destructor.
      389   end class.
