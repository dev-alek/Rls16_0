        1   define input        parameter parparentproc as handle    no-undo .
        2   define variable v-pl-code as integer no-undo .
        3   define variable pl-recid-list as character no-undo .
        4   define buffer buf_user-login        for ub.user-login .
        5   define new global shared variable g#language as character no-undo .
        6   if g#language <> '' and g#language <> 'rus':U then do:
        7     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        8   end.
        9   define new global shared variable g#library  as handle no-undo .
       10   define new global shared variable g#library2 as handle no-undo .
       11   define   shared variable g#auto as logical no-undo.
       12   define   shared variable g#news as logical no-undo.
       13   define   shared variable g#oxml as logical no-undo.
       14   define   shared variable g#esys as logical no-undo.
       15   define   shared variable g#news-source-db as integer no-undo.
       16   define   shared variable g#esys-source-esys as integer no-undo.
       17   define   shared variable g#db-num as integer   no-undo .
       18   define   shared variable g#userid as character no-undo .
       19   define   shared variable g#passwd as character no-undo .
       20   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       21     define variable v-cntxt-db-num        as integer   no-undo .
       22     define variable v-cntxt-userid        as character no-undo .
       23     define variable v-cntxt-level         as character no-undo .
       24     define variable v-cntxt-host-code-obj as integer   no-undo .
       25     define variable v-cntxt-obj-type      as character no-undo .
       26     define variable v-cntxt-obj-code      as integer   no-undo .
       27     define variable v-cntxt-db-num-obj    as integer   no-undo .
       28     define variable v-cntxt-is-admin      as logical   no-undo .
       29   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       30     run mainmenu_getcntxt in parparentproc
       31       (output v-cntxt-db-num
       32       ,output v-cntxt-userid
       33       ,output v-cntxt-level
       34       ,output v-cntxt-host-code-obj
       35       ,output v-cntxt-obj-type
       36       ,output v-cntxt-obj-code
       37       ,output v-cntxt-db-num-obj
       38       ,output v-cntxt-is-admin
       39       ) .
       40   DEFINE BUTTON b-place
       41        IMAGE-UP FILE "btn-down-arrow":U
       42        IMAGE-DOWN FILE "btn-down-arrow":U
       43        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       44        LABEL "b-place"
       45        SIZE 3 BY .86.
       46   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
       47        LABEL "Выход"
       48        SIZE 15 BY 1.14
       49        BGCOLOR 8 .
       50   DEFINE BUTTON Btn_OK
       51        LABEL "Применить"
       52        SIZE 15 BY 1.14
       53        BGCOLOR 8 .
       54   DEFINE VARIABLE f-pl-num AS CHARACTER FORMAT "X(256)":U
       55        VIEW-AS FILL-IN
       56        SIZE 14 BY 1 NO-UNDO.
       57   DEFINE QUERY br-place-imp FOR
       58         place-imp SCROLLING.
       59   DEFINE BROWSE br-place-imp
       60     QUERY br-place-imp NO-LOCK DISPLAY
       61         place-imp.table-version column-label "Номер версии" FORMAT ">>>>>>>>>9":U
       62         place-imp.corr-date column-label 'Дата получения статуса!"Ожидает применения"' FORMAT "99/99/9999":U
       63         string(place-imp.corr-time, "hh:mm:ss") column-label 'Время получения статуса!"Ожидает применения"' FORMAT "X(8)":U
       64       WITH NO-ROW-MARKERS SEPARATORS SIZE 75 BY 6.19 FIT-LAST-COLUMN.
       65   DEFINE FRAME Dialog-Frame
       66        Btn_Cancel AT ROW 1.24 COL 2
       67        Btn_OK AT ROW 1.24 COL 17
       68        f-pl-num AT ROW 3.3 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 4
       69        b-place AT ROW 3.3 COL 18.4 WIDGET-ID 38
       70        br-place-imp AT ROW 4.9 COL 3 WIDGET-ID 200
       71        "Выбор резервуара:" VIEW-AS TEXT
       72             SIZE 20 BY .86 AT ROW 2.38 COL 2 WIDGET-ID 2
       73        SPACE(56.99) SKIP(7.99)
       74       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       75            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       76            TITLE "Утилита применения новых градуировочных таблиц"
       77            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
       78   ASSIGN
       79          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       80          FRAME Dialog-Frame:HIDDEN           = TRUE.
       81   ASSIGN
       82          f-pl-num:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       83   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       84   DO:
       85     APPLY "END-ERROR":U TO SELF.
       86   END.
       87   ON CHOOSE OF b-place IN FRAME Dialog-Frame
       88   DO:
       89     define buffer buf_place for ub.place .
       90     run ref/pl-list.w (
       91        input parparentproc
       92       ,input "b-sel"
       93       ,input v-cntxt-obj-type
       94       ,input v-cntxt-obj-code
       95       ,input 'объект':U
       96       ,input-output pl-recid-list).
       97     if pl-recid-list = "cancel"
       98     then do :
       99       return no-apply .
      100     end .
      101     find first buf_place no-lock where recid(buf_place) = integer(pl-recid-list) no-error .
      102     if available buf_place
      103     then do :
      104       assign
      105         v-pl-code = buf_place.pl-code
      106         f-pl-num = buf_place.loc1
      107       .
      108       display f-pl-num with frame Dialog-Frame .
      109     end .
      110     else do :
      111       assign
      112         v-pl-code = ?
      113         f-pl-num = "?"
      114       .
      115       display f-pl-num with frame Dialog-Frame .
      116     end .
      117     OPEN QUERY br-place-imp FOR EACH place-imp       WHERE place-imp.status_ = 0 and place-imp.obj-type = v-cntxt-obj-type and place-imp.obj-code = v-cntxt-obj-code and place-imp.pl-code = v-pl-code NO-LOCK INDEXED-REPOSITION.
      118   END.
      119   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      120   DO:
      121     define buffer buf_place-imp for ub.place-imp .
      122     define buffer buf_place-attr for ub.place-attr .
      123     if available place-imp
      124     then do :
      125       for each buf_place-imp no-lock where buf_place-imp.obj-type = v-cntxt-obj-type
      126                                        and buf_place-imp.obj-code = v-cntxt-obj-code
      127                                        and buf_place-imp.pl-code  = v-pl-code
      128                                        and buf_place-imp.status_  = 0
      129                                        by buf_place-imp.table-version
      130       :
      131         run str/apply_place-imp.p (input buf_place-imp.obj-type,
      132                                    input buf_place-imp.obj-code,
      133                                    input buf_place-imp.pl-code,
      134                                    input buf_place-imp.table-version)
      135                                    no-error .
      136       end .
      137       find first buf_place-attr exclusive-lock where buf_place-attr.obj-type = v-cntxt-obj-type
      138                                                  and buf_place-attr.obj-code = v-cntxt-obj-code
      139                                                  and buf_place-attr.pl-code  = v-pl-code
      140                                                  and buf_place-attr.attr-code = "pending-table-version"
      141                                                  no-error .
      142       if available buf_place-attr
      143       then do :
      144         delete buf_place-attr .
      145       end .
      146       message "Новые данные успешно применены!" view-as alert-box .
      147       OPEN QUERY br-place-imp FOR EACH place-imp       WHERE place-imp.status_ = 0 and place-imp.obj-type = v-cntxt-obj-type and place-imp.obj-code = v-cntxt-obj-code and place-imp.pl-code = v-pl-code NO-LOCK INDEXED-REPOSITION.
      148     end .
      149   END.
      150   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      151   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      152   MAIN-BLOCK:
      153   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      154      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      155     find first buf_user-login no-lock
      156         where buf_user-login.db-num  = g#db-num
      157           and buf_user-login.user-id = g#userid
      158         no-error .
      159     if not available buf_user-login
      160     then do :
      161       message "Неизвестный пользователь!" view-as alert-box error .
      162       return .
      163     end .
      164     if not buf_user-login.user-administrator
      165     then do :
      166       message "Данный функционал доступен только для администратора!" view-as alert-box .
      167       return .
      168     end .
      169     RUN enable_UI.
      170     WAIT-FOR GO OF FRAME Dialog-Frame.
      171   END.
      172   RUN disable_UI.
      173   PROCEDURE disable_UI :
      174     HIDE FRAME Dialog-Frame.
      175   END PROCEDURE.
      176   PROCEDURE enable_UI :
      177     DISPLAY f-pl-num
      178         WITH FRAME Dialog-Frame.
      179     ENABLE Btn_Cancel Btn_OK f-pl-num b-place br-place-imp
      180         WITH FRAME Dialog-Frame.
      181     VIEW FRAME Dialog-Frame.
      182     OPEN QUERY br-place-imp FOR EACH place-imp       WHERE place-imp.status_ = 0 and place-imp.obj-type = v-cntxt-obj-type and place-imp.obj-code = v-cntxt-obj-code and place-imp.pl-code = v-pl-code NO-LOCK INDEXED-REPOSITION.
      183   END PROCEDURE.
