      706   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      707   PROCEDURE verify-ini-entry:
      708   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      709   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      710   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      711   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      712   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      713   define variable v-mess as character no-undo .
      714   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      715   if ini-entry-value = ? and ini-key-name begins "spl"
      716   then
      717   get-key-value section ini-section-name key "splall" value ini-entry-value.
      718   if ini-entry-value = ? and ini-key-name begins "sav"
      719   then
      720   get-key-value section ini-section-name key "savall" value ini-entry-value.
      721   if ini-entry-value = ? then do:
      722     assign
      723     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      724                       , chr(10)
      725                       , ini-section-name
      726                       , ini-key-name
      727                       , error-msg-text).
      728       if not silence then do:
      729         message
      730         v-mess
      731         view-as alert-box ERROR  .
      732         return error.
      733       end.
      734       else do:
      735         return error v-mess.
      736       end.
      737   end.
      738   END PROCEDURE.
      739   PROCEDURE verify-file:
      740   DEFINE INPUT  PARAMETER filename       as character no-undo.
      741   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      742   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      743   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      744   file-info:file-name = filename.
      745   found = NOT (file-info:full-pathname = ?).
      746   if NOT found  then do:
      747     if not silence then do:
      748       message error-msg-text
      749       view-as alert-box ERROR.
      750       return error.
      751     end.
      752     else return error error-msg-text.
      753   end.
      754   END PROCEDURE.
      755   DEFINE VARIABLE mLogical       AS LOGICAL     NO-UNDO.
      756   DEFINE VARIABLE mLogFile       AS CHARACTER   NO-UNDO.
      757   DEFINE STREAM mLogStr.
      758   DEFINE STREAM mDirStr.
      759   DEFINE STREAM mPrevDirStr.
      760   DEFINE STREAM mGdsDirStr.
      761   DEFINE VARIABLE mF_select_photo AS LOGICAL     NO-UNDO.
      762   DEFINE VARIABLE vPhotoPath       AS CHARACTER   NO-UNDO.
      763   define buffer buf_goods-attr for ub.goods-attr .
      764   define buffer bf_goods-attr  for ub.goods-attr .
      765   message
      766   "Проверка или удаление некорректных ссылок" skip
      767   skip
      768   "Для удаления ссылок - нажмите  ДА" skip
      769   "Для проверки ссылок - нажмите НЕТ" skip
      770   view-as alert-box question button yes-no update v-ask .
      771   define variable v-attr-value      as character no-undo .
      772   define variable ii                as integer   no-undo .
      773   define variable v-full-path-image as character no-undo FORMAT "X(155)".
      774   define variable fullname          as character no-undo .
      775   define variable v-value           as character no-undo .
      776   define variable v-delete          as character no-undo .
      777   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
      778   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
      779   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
      780   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
      781   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
      782   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
      783   define variable v-param-types   as character  no-undo.
      784   define variable v-value-char    as character  no-undo.
      785   define variable v-val-date      as date       no-undo.
      786   define variable v-val-decimal   as decimal    no-undo.
      787   define variable v-val-integer   as integer    no-undo.
      788   define variable v-val-logical   as logical    no-undo.
      789   define variable v-tthd          as handle     no-undo.
      790   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
      791   PROCEDURE imagelist_loaddef:
      792       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
      793       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
      794       ASSIGN
      795           vPar-val  = "":U
      796           vPar-type = "":U
      797           .
      798   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      799     (input  'photo':u
      800     ,input  '':u
      801     ,input  '':u
      802     ,input  0
      803     ,input  '':u
      804     ,input  '':u
      805     ,input  '':u
      806     ,input  no
      807     ,output vPar-val
      808     ,output vPar-type
      809     ) no-error .
      810           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
      811       IF mImagePh THEN .
      812       ELSE RETURN.
      813       ASSIGN
      814           vPar-val  = "":U
      815           vPar-type = "":U
      816           .
      817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      818     (input  'ph-dir':u
      819     ,input  '':u
      820     ,input  '':u
      821     ,input  0
      822     ,input  '':u
      823     ,input  '':u
      824     ,input  '':u
      825     ,input  NO
      826     ,output vPar-val
      827     ,output vPar-type
      828     ) no-error .
      829       IF LENGTH (vPar-val) = 0 THEN
      830           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
      831       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
      832       ASSIGN
      833           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
      834           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
      835           mImagePreDir = mImagePath
      836           mImageDir    = mImagePreDir
      837           mImageTrash  = mImagePath + "trash\":U
      838           .
      839       ASSIGN
      840           vPar-val  = "":U
      841           vPar-type = "":U
      842           .
      843               run adm/shattri.p (
      844           input "get":U
      845           ,input  '':U
      846           ,input  0
      847           ,input  'gds-ref':U
      848           ,input  'shema-foto':U
      849           ,output v-value-char
      850           ,output v-val-date
      851           ,output v-val-decimal
      852           ,output v-val-integer
      853           ,output v-val-logical
      854           ,output v-param-types
      855           ,INPUT-OUTPUT table-handle v-tthd
      856           ) no-error.
      857           delete object v-tthd.
      858           mPhotomgd = IF v-val-integer = 2 then yes else no.
      859   END PROCEDURE.
      860   PROCEDURE imagelist_decode:
      861       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      862       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
      863       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      864       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      865       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      866       ASSIGN
      867           oImageList = iImageList
      868           .
      869       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      870           vCh =ENTRY (vInt, iImageList, ",":U).
      871           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
      872           ELSE
      873           DO:
      874               ASSIGN
      875                   vCh = REPLACE (vCh, "~/":U, "\":U)
      876                   vCh = REPLACE (vCh, "~\":U, "\":U)
      877                   .
      878               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
      879               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
      880               ENTRY (vInt, oImageList, ",":U) = vCh.
      881           END.
      882       END.
      883   END PROCEDURE.
      884   PROCEDURE imagelist_encode:
      885       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      886       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      887       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      888       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      889       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
      890       ASSIGN
      891           oImageList = iImageList
      892           vLen       = LENGTH (mImageDir)
      893           .
      894       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      895           vCh =ENTRY (vInt, iImageList, ",":U).
      896           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
      897               ENTRY (vInt, oImageList, ",":U) =
      898                   SUBSTRING (vCh, vLen + 1).
      899       END.
      900   END PROCEDURE.
      901   IF mImagePh THEN .
      902   ELSE RETURN.
      903   output to image-check.txt.
      904   for each buf_goods-attr where buf_goods-attr.attr-code = "image-list"
      905     and buf_goods-attr.attr-value <> "":
      906     v-value = "".
      907     v-attr-value = trim (buf_goods-attr.attr-value).
      908     do ii = 1 to num-entries(v-attr-value):
      909       IF v-val-integer = 2 then vPhotoPath =  mImagePreDir + string(buf_goods-attr.gds-code) .
      910       ELSE vPhotoPath =  mImagePreDir .
      911       v-full-path-image = vPhotoPath + "\" + entry(ii, v-attr-value).
      912       fullname = search (v-full-path-image).
      913       if fullname =? then
      914       do:
      915           put
      916             buf_goods-attr.gds-code
      917             ';'
      918             v-full-path-image
      919             skip.
      920       end.
      921       else
      922       do:
      923         if v-ask = yes then
      924         do:
      925           if v-value = "" then v-value = entry(ii, v-attr-value).
      926           else v-value = v-value + "," + entry(ii, v-attr-value).
      927         end.
      928       end.
      929     end.
      930     if v-ask = yes then
      931     do:
      932       if v-value = "" then do:
      933                         RUN gds-attr-delete IN THIS-PROCEDURE (
      934                                                           input buf_goods-attr.gds-code
      935                                                           ,INPUT "image-list"
      936                                                           ,output v-delete ) NO-ERROR.
      937       end.
      938       else
      939       RUN gds-attr-write (buf_goods-attr.gds-code, "image-list":U, v-value).
      940     end.
      941   end.
      942   output close .
      943   if v-ask = yes then do:
      944     message "Удаление некорректных ссылок завершено, вся информация в image-check.txt"
      945     view-as alert-box.
      946   end.
      947   else   message "Проверка некорректных ссылок завершена, вся информация в image-check.txt"
      948     view-as alert-box.
