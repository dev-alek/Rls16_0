        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Настройка конфигурации атрибутов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63   define variable v-waitfram-action01         as character   no-undo .
       64   define variable v-waitfram-action02         as character   no-undo .
       65   define variable v-waitfram-action03         as character   no-undo .
       66   define variable mWaitFramTextBeg            as character   no-undo.
       67   define variable mWaitFramTextEnd            as character   no-undo.
       68   define variable mWaitFramView               as logical     no-undo.
       69   define variable mWaitProcEvent              as logical     no-undo init yes.
       70   define variable mWaitFramInterval           as integer     no-undo init 1 .
       71   define variable mWaitFramStop               as logical     no-undo.
       72   define variable mWaitFramStopUser           as logical     no-undo.
       73   define variable mWaitFramStopTimeOut        as logical     no-undo.
       74   define variable mWaitFramStartProc          as datetime-tz no-undo.
       75   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       76   define button B-WaitFramStop auto-end-key
       77        label "Стоп"
       78        size 10 by 1 tooltip "Остоновить процесс".
       79   define button B-viewProcInfo
       80        label "Информация"
       81        size 15 by 1 tooltip "Информация о процесс".
       82   define frame waitfram
       83     v-waitfram-action01 format "x(72)" no-label skip
       84     v-waitfram-action02 format "x(72)" no-label skip
       85     v-waitfram-action03 format "x(72)" no-label skip
       86     B-viewProcInfo
       87     B-WaitFramStop at row 4 col 30
       88     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       89     .
       90   define new global shared variable mBatchMode as logical no-undo init ?.
       91   define variable mFramBachModHandle as handle no-undo.
       92   mFramBachModHandle = frame waitfram:handle.
       93   define variable mFameOldVis as logical no-undo.
       94   define variable mVisCUrentVin as logical no-undo.
       95   if session:batch-mode
       96   then
       97      mBatchMode = yes.
       98   if mBatchMode = ? then do:
       99     mVisCUrentVin = current-window:visible.
      100     mFameOldVis = mFramBachModHandle:visible.
      101     mFramBachModHandle:visible  = yes.
      102     mBatchMode = mFramBachModHandle:visible ne yes.
      103     mFramBachModHandle:visible = mFameOldVis.
      104     current-window:visible = mVisCUrentVin.
      105   end.
      106    if  log-manager:logfile-name ne ?
      107     then DO:
      108         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      109         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      110         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      111     end.
      112   on choose of B-WaitFramStop in frame waitfram
      113   do:
      114     mWaitFramStop = yes.
      115     mWaitFramStopUser = yes.
      116   end.
      117   function waitfram-check-timeout returns logical():
      118      define variable vtime as int64 no-undo.
      119      if mWaitFramStopTimeOut
      120      then
      121         return yes.
      122      vtime = ( now - mWaitFramStartProc ) / 1000 .
      123      if     mWaitFramTimeOut ne ?
      124         and mWaitFramTimeOut ne 0
      125         and mWaitFramTimeOut lt vtime
      126      then do:
      127         mWaitFramStopTimeOut = yes.
      128      end.
      129      return mWaitFramStopTimeOut.
      130   end.
      131   procedure waitfram-hide :
      132     if not session:batch-mode
      133     then do
      134     on error undo, return error return-value
      135     :
      136       pause 0 before-hide .
      137       if not mBatchMode then
      138         hide frame waitfram .
      139     if     not mWaitFramView
      140        and mWaitProcEvent
      141     then
      142       process events .
      143     end.
      144   end procedure.
      145   procedure waitfram-show :
      146     define input  parameter p-message as character no-undo .
      147     define variable v-left-margin as integer   no-undo .
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       if length(p-message) <= 70 then do:
      153         assign
      154           v-left-margin = integer((70 - length(p-message)) / 2)
      155         .
      156         assign
      157           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      158         .
      159         assign
      160           v-waitfram-action01 = " "
      161           v-waitfram-action02 = " "
      162                                    + fill(" ", v-left-margin)
      163                                    + p-message
      164           v-waitfram-action03 = " "
      165         .
      166       end.
      167       else do:
      168         define variable vRindex1 as integer no-undo.
      169         define variable vRindex2 as integer no-undo.
      170         vRindex1 = r-index(p-message," ",70).
      171         if vRindex1 = 0
      172         then
      173            vRindex1 = 70.
      174         if length(p-message)  <= vRindex1 + 70 then do:
      175           assign
      176             v-waitfram-action01 = " "
      177             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      178             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      179           .
      180         end.
      181         else do:
      182           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      183           if vRindex2 <= vRindex1
      184           then
      185              vRindex2 = vRindex1 + 70.
      186           assign
      187             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      190           .
      191         end.
      192       end.
      193       B-viewProcInfo:visible   in frame waitfram = no.
      194       B-viewProcInfo:sensitive in frame waitfram = no.
      195       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      196       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       if  (   mWaitFramView
      198          or  mWaitProcEvent)
      199          and not mBatchMode
      200       then
      201          display
      202             v-waitfram-action01 skip
      203             v-waitfram-action02 skip
      204             v-waitfram-action03 skip
      205          with frame waitfram .
      206       if     mWaitFramView
      207          then do:
      208             if     mWaitFramInterval ne ?
      209                and not mBatchMode
      210             then
      211                wait-for go of frame waitfram pause mWaitFramInterval.
      212          end.
      213          else
      214             if     mWaitProcEvent
      215                and not mBatchMode
      216             then
      217                process events .
      218     end.
      219   end procedure.
      220      procedure waitfram-show-this:
      221         define input  parameter iInterval as int64 no-undo.
      222         define variable vtime as int64 no-undo.
      223         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      224         mWaitFramInterval = iInterval.
      225         run waitfram-show (substitute("&1&2 &3&4" ,
      226                                       mWaitFramTextBeg ,
      227                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      228                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      229                                       mWaitFramTextEnd
      230                                      )
      231                           ).
      232      end.
      233      procedure WaitFramRunPause:
      234         define input  parameter iInterval as dec no-undo.
      235         define variable vStart  as datetime-tz no-undo.
      236         define variable vend    as datetime-tz no-undo.
      237         define variable vint as int64 no-undo.
      238         define variable vOk as logical no-undo.
      239         vStart = now.
      240         vend   = vStart.
      241         publish "WaitFramPause" (iInterval,output vOk).
      242         vend   =  now.
      243         vint = vend - vStart.
      244         vint = iInterval - vint / 1000.
      245         if     not mWaitFramStop
      246            and (   vint > 0
      247                 or (    not vOk
      248                     and iInterval eq ?
      249                     )
      250                 )
      251         then
      252            run waitfram-show-this (iInterval).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and vint > 0
      258         then do:
      259            run gbl/pause.p (vint * 1000).
      260         end.
      261         if iInterval ne ?
      262         then
      263            publish "WaitFramStop".
      264         waitfram-check-timeout().
      265      end.
      266      procedure WaitFramWaitFor:
      267         define input  parameter iInterval as dec no-undo.
      268         assign
      269            mWaitFramStartProc   = now
      270            mWaitFramStopUser    = no
      271            mWaitFramStopTimeOut = no
      272         .
      273         block-wait:
      274         do while not mWaitFramStop:
      275            run WaitFramRunPause (iInterval).
      276            if  waitfram-check-timeout()
      277            then do:
      278               leave block-wait.
      279            end.
      280         end.
      281         run waitfram-hide.
      282      end.
      283   procedure waitfram-join :
      284     define input  parameter p-line-1  as character no-undo .
      285     define input  parameter p-line-2  as character no-undo .
      286     define input  parameter p-line-3  as character no-undo .
      287     define output parameter p-message as character no-undo .
      288     do
      289     on error undo, return error return-value
      290     :
      291       assign
      292         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      293                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      294                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      295       .
      296     end.
      297   end procedure.
      298   function waitfram-join-function returns character
      299     (input p-line-1 as character
      300     ,input p-line-2 as character
      301     ,input p-line-3 as character
      302     ).
      303     define variable v-message as character no-undo .
      304     run waitfram-join in this-procedure
      305       (input  p-line-1
      306       ,input  p-line-2
      307       ,input  p-line-3
      308       ,output v-message
      309       ) .
      310     return v-message .
      311   end function .
      312   define new global shared variable g#language as character no-undo .
      313   if g#language <> '' and g#language <> 'rus':U then do:
      314     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      315   end.
      316   procedure proc-alt-shift-f2:
      317     if not ibs.th.gbl.gbl-var:rcode
      318   then
      319     run gbl\inidebug.p .
      320   end.
      321   procedure proc-alt-shift-f3:
      322     run gbl/prvssinf.p
      323       ( input this-procedure
      324       ) .
      325   end.
      326   define variable v-inform-launched as logical no-undo initial false .
      327   procedure proc-alt-shift-f4:
      328     define variable v-action as character no-undo .
      329     if v-inform-launched = false then do:
      330       assign
      331         v-inform-launched = true
      332       .
      333       run gbl/d-inform.w
      334         (  input self
      335         ,  input this-procedure
      336         , output v-action
      337         ) no-error .
      338       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      339       assign
      340         v-inform-launched = false
      341       .
      342     end.
      343   end.
      344   procedure proc-alt-f1:
      345     run gbl/corrhelp.p
      346       (input this-procedure
      347       ) .
      348   end .
      349   on alt-shift-f2 anywhere do:
      350     run proc-alt-shift-f2.
      351   end.
      352   on alt-shift-f3 anywhere do:
      353     run proc-alt-shift-f3 in this-procedure .
      354   end.
      355   on alt-shift-f4 anywhere do:
      356     run proc-alt-shift-f4 in this-procedure.
      357   end.
      358   on alt-f1 anywhere do:
      359     run proc-alt-f1 in this-procedure .
      360   end.
      361   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362     define variable v-cntxt-db-num        as integer   no-undo .
      363     define variable v-cntxt-userid        as character no-undo .
      364     define variable v-cntxt-level         as character no-undo .
      365     define variable v-cntxt-host-code-obj as integer   no-undo .
      366     define variable v-cntxt-obj-type      as character no-undo .
      367     define variable v-cntxt-obj-code      as integer   no-undo .
      368     define variable v-cntxt-db-num-obj    as integer   no-undo .
      369     define variable v-cntxt-is-admin      as logical   no-undo .
      370   DEFINE BUTTON b-export
      371        LABEL "Экспорт"
      372        SIZE 10 BY 1.
      373   DEFINE BUTTON B-Help
      374        LABEL "Помо&щь"
      375        SIZE 3 BY 1
      376        BGCOLOR 8 .
      377   DEFINE BUTTON b-quit AUTO-END-KEY
      378        LABEL "&Выход"
      379        SIZE 10 BY 1
      380        BGCOLOR 8 .
      381   DEFINE BUTTON B-revis
      382        LABEL "Версия конфиг.атрибутов"
      383        SIZE 30 BY 1.
      384   DEFINE FRAME Dialog-Frame
      385        b-quit AT ROW 1 COL 1
      386        b-export AT ROW 1 COL 39 WIDGET-ID 2
      387        B-revis AT ROW 1 COL 49 WIDGET-ID 4
      388        B-Help AT ROW 1 COL 95
      389        SPACE(1.70) SKIP(21.22)
      390       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      391            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      392            TITLE "Настройка конфигурации атрибутов"
      393            CANCEL-BUTTON b-quit.
      394   ASSIGN
      395          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      396          FRAME Dialog-Frame:HIDDEN           = TRUE.
      397   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      398   DO:
      399     APPLY "END-ERROR":U TO SELF.
      400   END.
      401   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      402   DO:
      403   define variable v-file-name as character no-undo .
      404   define variable v-old-file-name as character no-undo .
      405   define variable v-dir-name as character no-undo .
      406   define variable v-yesno as logical no-undo .
      407   define variable v-mode-log as logical no-undo .
      408   define variable v-mode as character no-undo .
      409   message
      410   "Хотите экспортировать уникальное имя каждой записи (uniq-key-rec)?"
      411   view-as alert-box question buttons yes-no-cancel update v-mode-log.
      412   if v-mode-log = ? then return no-apply.
      413   if v-mode-log then do:
      414     v-mode = "full".
      415   end.
      416   message
      417   "Хотите экспортировать ПОЛНУЮ конфигурацию атрибутов" skip
      418   "или только измененные записи?"
      419   view-as alert-box question buttons yes-no-cancel update v-yesno.
      420   if v-yesno = ? then return no-apply.
      421   if v-yesno = no then do:
      422     run gbl/d-file.p (
      423           input-output v-old-file-name
      424         , input-output v-dir-name
      425         , input  (" Все файлы txt (*.txt) ")
      426         , input  ("*.txt":U)
      427         , input  chr(44)
      428         , input  (".txt":U)
      429         , input  yes
      430         , input  no
      431         , input  yes
      432         , input  "Введите имя старого файла (для сравнения)"
      433         , output v-yesno
      434     ) no-error.
      435     if error-status:error
      436     or v-yesno = no then return no-apply.
      437   end.
      438   v-yesno = no.
      439     run gbl/d-file.p (
      440           input-output v-file-name
      441         , input-output v-dir-name
      442         , input  (" Все файлы txt (*.txt) ")
      443         , input  ("*.txt":U)
      444         , input  chr(44)
      445         , input  (".txt":U)
      446         , input  no
      447         , input  yes
      448         , input  yes
      449         , input  "Введите имя файла для экспорта"
      450         , output v-yesno
      451     ) no-error.
      452     if error-status:error
      453     or v-yesno = no then return no-apply.
      454     run utl/exattrp.p (
      455                                    input v-file-name
      456                                   ,input v-old-file-name
      457                                   ,input v-mode
      458                                  ) NO-ERROR.
      459     IF ERROR-STATUS:ERROR THEN DO:
      460        MESSAGE
      461        ERROR-STATUS:GET-MESSAGE(1) SKIP
      462        RETURN-VALUE
      463        VIEW-AS ALERT-BOX.
      464        RETURN NO-APPLY.
      465     END.
      466     define variable v-md5-signature as character no-undo .
      467     define variable v-full-file-name          as character                no-undo .
      468     define variable v-path                    as character                no-undo .
      469     DEFINE VARIABLE v-full-path               as character                no-undo .
      470     DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      471     DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      472     run gbl/md5.p ( input v-file-name
      473                    ,output v-md5-signature ) .
      474     run gbl/filename.p (
      475                    input v-file-name
      476                   ,output v-full-path
      477                   ,output v-path
      478                   ,output v-full-file-name
      479                   ,output v-file-name-no-ext
      480                   ,output v-file-name-ext
      481                   ) no-error .
      482     if error-status:error then do:
      483       message
      484       return-value
      485       view-as alert-box ERROR.
      486       return.
      487     end.
      488     output to value(v-path + chr(47) + v-file-name-no-ext + ".md5").
      489     put unformatted v-md5-signature skip.
      490     output close.
      491   END.
      492   ON CHOOSE OF B-revis IN FRAME Dialog-Frame
      493   DO:
      494   DEFINE VARIABLE v-value-character AS CHARACTER NO-UNDO.
      495   DEFINE VARIABLE v-ok AS logical NO-UNDO.
      496   DEFINE BUFFER buf_attr-prop FOR ub.attr-prop.
      497   FIND FIRST buf_attr-prop EXCLUSIVE-LOCK WHERE
      498             buf_attr-prop.table-name = '':U
      499       AND   buf_attr-prop.templ-rl-root = 0
      500       AND buf_attr-prop.node-code  = 0 NO-ERROR.
      501   IF AVAILABLE buf_attr-prop THEN DO:
      502       ASSIGN
      503       v-value-character = buf_attr-prop.property-value.
      504   END.
      505   ELSE DO:
      506       v-value-character = "v15_0.0".
      507   END.
      508             run gbl/d-character.w (
      509                  input ?
      510                 ,input (
      511                 'title=':u + "Изменение версии конфигурации атрибутов" + '\':u
      512               + 'text1=':u + "Версия" + '\':u
      513               + 'format=' + "X(8)" + '\':u
      514               + 'fillin_row=2\':u
      515               + 'fillin_col=8\':u
      516               + 'fillin_width=20\':u
      517               + 'fillin_height=1\':u
      518               + 'max-chars=70\':u
      519               + 'readonly=no\')
      520               , input-output v-value-character
      521               , output v-ok
      522                   ).
      523               if not v-ok then return NO-apply.
      524   IF NOT AVAILABLE buf_attr-prop THEN DO:
      525     CREATE buf_attr-prop.
      526     assign
      527     buf_attr-prop.table-name = '':U
      528     buf_attr-prop.templ-rl-root = 0
      529     buf_attr-prop.node-code  = 0
      530     .
      531   END.
      532   ASSIGN
      533   buf_attr-prop.property-value = v-value-character.
      534   END.
      535   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      536   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      537   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   on help of frame Dialog-Frame
      539   do:
      540     run gbl/app_help.p
      541       (input this-procedure :file-name
      542       ,input ''
      543       ,input ?
      544       ) no-error.
      545     if error-status :error then do:
      546       message
      547         "Ошибка при вызове помощи"
      548         error-status :get-message(1)
      549         view-as alert-box .
      550     end.
      551   end.
      552   run minbtn-set in this-procedure .
      553   on choose of b-help in frame Dialog-Frame
      554   do:
      555     apply "help":u to frame Dialog-Frame .
      556   end.
      557   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   procedure minbtn-set :
      559       do
      560           on error undo, return error return-value
      561           :
      562           define variable ii              as integer       no-undo .
      563           define variable fh              as widget-handle no-undo .
      564           define variable hh              as widget-handle no-undo .
      565           define variable v-h             as handle        extent 4 no-undo .
      566           define variable v-name-button   as character     no-undo .
      567           define variable v-help-old-x    as decimal       no-undo .
      568           define variable v-help-old-y    as decimal       no-undo .
      569           define variable v-help-old-size as decimal       no-undo .
      570           define variable v-frame-width   as decimal       no-undo .
      571           define variable jj              as integer       no-undo .
      572           do
      573               on error undo, return error
      574               :
      575               assign
      576                   v-frame-width = frame Dialog-Frame:width - 0.3
      577                   fh            = frame Dialog-Frame:first-child
      578                   hh            = fh:first-child
      579                   ii            = 1
      580                   .
      581               do while valid-handle(hh):
      582                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      583                   do:
      584                       case lc(hh:name) :
      585                           when "b-help" then
      586                               do:
      587                                   hh:load-image-up("cmp/b-help.bmp":u) .
      588                                   hh:load-image-down("cmp/b-help.bmp":u) .
      589                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      590                                   hh:TOOLTIP = "Помощь" .
      591                                   v-help-old-x = hh:column .
      592                                   v-help-old-y = hh:row    .
      593                                   v-help-old-size = hh:width .
      594                                   hh:width-chars = 2.5 .
      595                               end.
      596                           when "b-print" then
      597                               do:
      598                                   hh:load-image("cmp/b-print.bmp":u) .
      599                                   hh:TOOLTIP = "Печать" .
      600                                   v-h[ii] = hh:handle .
      601                                   ii = ii + 1 .
      602                                   hh:width-chars = 3 .
      603                               end.
      604                           when "b-history" or
      605                           when "b-hist" then
      606                               do:
      607                                   hh:load-image("cmp/b-hist.bmp":u) .
      608                                   hh:TOOLTIP = "История" .
      609                                   v-h[ii] = hh:handle .
      610                                   ii = ii + 1 .
      611                                   hh:width-chars = 3 .
      612                               end.
      613                           when "b-sch" then
      614                               do:
      615                                   hh:load-image("cmp/b-sch.bmp":u) .
      616                                   hh:TOOLTIP = "Установка Фильтра" .
      617                                   v-h[ii] = hh:handle .
      618                                   ii = ii + 1 .
      619                                   hh:width-chars = 3 .
      620                               end.
      621                           when "b-hist-user" then
      622                               do:
      623                                   hh:load-image("cmp/b-hist.bmp":u) .
      624                                   hh:TOOLTIP = "История пользователя" .
      625                                   ii = ii + 1 .
      626                               end.
      627                       end case.
      628                   end.
      629                   hh = hh:next-sibling.
      630               end.
      631               b-help:column = v-frame-width - b-help:width-chars.
      632               jj = 0.
      633               repeat ii = 4 to 1 by -1 :
      634                   if valid-handle (v-h[ii] ) then
      635                   do:
      636                       jj  = jj + 1 .
      637                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      638                       v-h[ii]:row    = v-help-old-y .
      639                   end.
      640               end.
      641           end.
      642       end.
      643   end procedure.
      644   MAIN-BLOCK:
      645   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      646      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      647   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648     run mainmenu_getcntxt in parparentproc
      649       (output v-cntxt-db-num
      650       ,output v-cntxt-userid
      651       ,output v-cntxt-level
      652       ,output v-cntxt-host-code-obj
      653       ,output v-cntxt-obj-type
      654       ,output v-cntxt-obj-code
      655       ,output v-cntxt-db-num-obj
      656       ,output v-cntxt-is-admin
      657       ) .
      658     RUN Myenable.
      659     WAIT-FOR GO OF FRAME Dialog-Frame.
      660   END.
      661   RUN disable_UI.
      662   PROCEDURE disable_UI :
      663     HIDE FRAME Dialog-Frame.
      664   END PROCEDURE.
      665   PROCEDURE enable_UI :
      666     ENABLE b-quit b-export B-revis B-Help
      667         WITH FRAME Dialog-Frame.
      668     VIEW FRAME Dialog-Frame.
      669   END PROCEDURE.
      670   PROCEDURE MyEnable :
      671   ENABLE
      672   b-quit
      673   b-export
      674   B-revis WHEN v-cntxt-db-num = 0
      675   B-Help
      676   WITH FRAME Dialog-Frame.
      677   VIEW FRAME Dialog-Frame.
      678   END PROCEDURE.
