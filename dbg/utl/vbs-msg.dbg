        1   block-level on error undo, throw.
        2   define input parameter p-msg   as character no-undo.
        3   define input parameter p-title as character no-undo.
        4   define variable m-file-name      as character no-undo.
        5   define variable m-full-proc-name as character no-undo.
        6   define variable m-msg            as character no-undo.
        7   m-msg = replace(p-msg, "~"", "'").
        8   m-msg = replace(m-msg, "~n", " ").
        9   m-msg = substitute('MsgBox "&1", ,"&2"', m-msg, p-title).
       10   m-file-name = string(guid(generate-uuid)) + ".vbs".
       11   output to value (m-file-name).
       12   put unformatted m-msg.
       13   output close.
       14   file-info:file-name = (m-file-name).
       15   os-command no-wait value (file-info:full-pathname).
