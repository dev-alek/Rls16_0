        1   block-level on error undo, throw.
        2   define input  parameter p-artic       as character no-undo .
        3   define input  parameter p-prod-type   as character no-undo .
        4   define input  parameter p-prod-code   as integer   no-undo .
        5   define input  parameter p-obj-type    as character no-undo .
        6   define input  parameter p-obj-code    as integer   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: par2gds.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: utl/par2gds.p $":U .
       12   define variable vss-description as character no-undo init "Выравнивание остатков по партиям св зоны".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define buffer buf_parts   for ub.parts  .
       72   define buffer buf_gds-obj for ub.gds-obj  .
       73   define variable v-parts-fact-qnty     as decimal no-undo .
       74   define variable v-parts-free-qnty     as decimal no-undo .
       75   define variable v-parts-cli-qnty      as decimal no-undo .
       76   define variable v-parts-add-fact-qnty as decimal no-undo .
       77   define variable v-parts-add-free-qnty as decimal no-undo .
       78   define variable ppr as integer   no-undo .
       79   for each buf_gds-obj  exclusive-lock  where
       80            buf_gds-obj.artic     = p-artic          and
       81            buf_gds-obj.prod-type = p-prod-type and
       82            buf_gds-obj.prod-code = p-prod-code and
       83            buf_gds-obj.obj-type  = p-obj-type  and
       84            buf_gds-obj.obj-code  = p-obj-code
       85            :
       86       assign
       87         v-parts-fact-qnty = 0
       88         v-parts-free-qnty = 0
       89         v-parts-cli-qnty  = 0
       90       .
       91       for each buf_parts share-lock
       92         where buf_parts.obj-type  = buf_gds-obj.obj-type
       93           and buf_parts.obj-code  = buf_gds-obj.obj-code
       94           and buf_parts.artic     = buf_gds-obj.artic
       95           and buf_parts.prod-type = buf_gds-obj.prod-type
       96           and buf_parts.prod-code = buf_gds-obj.prod-code
       97           and buf_parts.status_   = no
       98           and buf_parts.rsrv-free = yes
       99       on error undo , leave
      100       :
      101         assign
      102           v-parts-add-fact-qnty = 0
      103           v-parts-add-free-qnty = 0
      104         .
      105         if buf_parts.out-code = 'out-zone':U
      106         then do:
      107           leave .
      108         end.
      109         if buf_parts.out-code = 'free-zone':U
      110         then do:
      111           assign
      112             v-parts-add-fact-qnty = v-parts-add-fact-qnty + buf_parts.fact-qnty
      113             v-parts-add-free-qnty = v-parts-add-free-qnty + buf_parts.qnty
      114           .
      115         end.
      116         else do:
      117           define buffer buf_trn-doc for ub.trn-doc .
      118           find first buf_trn-doc no-lock
      119             where buf_trn-doc.doc-code = buf_parts.out-code
      120             no-error .
      121           if not available buf_trn-doc
      122           then do:
      123             leave .
      124           end.
      125           if buf_parts.in-code <> buf_parts.out-code
      126           then do:
      127             assign
      128               v-parts-add-fact-qnty = v-parts-add-fact-qnty + abs(buf_parts.fact-qnty)
      129             .
      130           end.
      131           if buf_trn-doc.doc-type = 'инв':U
      132           then do:
      133             if buf_parts.qnty > 0
      134             then do:
      135               leave .
      136             end.
      137             if buf_parts.in-code <> buf_parts.out-code
      138             then do:
      139               assign
      140                 v-parts-add-free-qnty = v-parts-add-free-qnty + abs(buf_parts.qnty)
      141               .
      142             end.
      143           end.
      144           else do:
      145             if buf_parts.qnty < 0
      146             then do:
      147               leave .
      148             end.
      149             if buf_parts.in-code = buf_parts.out-code
      150             then do:
      151               assign
      152                 v-parts-add-free-qnty = v-parts-add-free-qnty - abs(buf_parts.qnty)
      153               .
      154             end.
      155           end.
      156         end.
      157         assign
      158           v-parts-fact-qnty = v-parts-fact-qnty + v-parts-add-fact-qnty
      159           v-parts-free-qnty = v-parts-free-qnty + v-parts-add-free-qnty
      160         .
      161         end.
      162       assign
      163         buf_gds-obj.fact-qnty = v-parts-fact-qnty
      164         buf_gds-obj.free-qnty = v-parts-free-qnty
      165       .
      166       find first ub.prt-obj  exclusive-lock
      167            where ub.prt-obj.artic     = buf_gds-obj.artic and
      168                  ub.prt-obj.prod-type = buf_gds-obj.prod-type and
      169                  ub.prt-obj.prod-code = buf_gds-obj.prod-code and
      170                  ub.prt-obj.obj-type  = buf_gds-obj.obj-type and
      171                  ub.prt-obj.obj-code  = buf_gds-obj.obj-code
      172                  no-error .
      173       if available ub.prt-obj then do:
      174       assign
      175         ub.prt-obj.fact-qnty = v-parts-fact-qnty
      176         ub.prt-obj.free-qnty = v-parts-free-qnty
      177       .
      178       end.
      179   end.
