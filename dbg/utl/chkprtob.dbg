        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $".
        4   define variable vss-author      as character no-undo init "$Author: expertek $".
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $".
        6   define variable vss-workfile    as character no-undo init "$Workfile: chkprtob.p $".
        7   define variable vss-archive     as character no-undo init "$Archive: utl/chkprtob.p $".
        8   define variable vss-description as character no-undo init "Проверка целостности всех товаров".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable v-ind as integer no-undo init 0 .
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define  temp-table temp-host no-undo
       81     field host-code like ub.store.host-code
       82     index xpk host-code
       83   .
       84   define  temp-table temp-obj no-undo
       85     field obj-type  like ub.clients.obj-type
       86     field obj-code  like ub.clients.obj-code
       87     field host-code like ub.store.host-code
       88     field db-num    like ub.clients.db-num
       89     index xpk  obj-type obj-code
       90     index xie1 host-code
       91     index xie2 db-num host-code
       92   .
       93   procedure init-temphost:
       94     define buffer buf_store   for ub.store .
       95     define buffer buf_shop    for ub.shop .
       96     define buffer buf_clients for ub.clients .
       97     define buffer buf_db for ub.db .
       98     define buffer buf_temp-host for temp-host .
       99     define buffer buf_temp-obj for temp-obj .
      100     do
      101     on error undo, return error return-value
      102     :
      103       for each buf_store
      104       on error undo, return error
      105       :
      106         find first buf_temp-host
      107           where buf_temp-host.host-code = buf_store.host-code
      108           no-error .
      109         if not available buf_temp-host
      110         then do:
      111           create buf_temp-host .
      112           assign
      113             buf_temp-host.host-code = buf_store.host-code
      114           .
      115         end.
      116         find first buf_clients no-lock
      117           where buf_clients.obj-type = 'скл':U
      118             and buf_clients.obj-code = buf_store.obj-code
      119           no-error .
      120         if not available buf_clients
      121         then do:
      122           message
      123             "Ошибка при поиске клиента" skip
      124             "Клиент" 'скл':U buf_store.obj-code skip
      125             view-as alert-box error .
      126           undo, return error .
      127         end.
      128         create buf_temp-obj .
      129         assign
      130           buf_temp-obj.obj-type  = 'скл':U
      131           buf_temp-obj.obj-code  = buf_store.obj-code
      132           buf_temp-obj.host-code = buf_store.host-code
      133           buf_temp-obj.db-num    = buf_clients.db-num
      134         .
      135       end.
      136       for each buf_shop
      137       on error undo, return error
      138       :
      139         find first buf_temp-host
      140           where buf_temp-host.host-code = buf_shop.host-code
      141           no-error .
      142         if not available buf_temp-host
      143         then do:
      144           create buf_temp-host .
      145           assign
      146             buf_temp-host.host-code = buf_shop.host-code
      147           .
      148         end.
      149         find first buf_clients no-lock
      150           where buf_clients.obj-type = 'маг':U
      151             and buf_clients.obj-code = buf_shop.obj-code
      152           no-error .
      153         if not available buf_clients then do:
      154           message
      155             "Ошибка при поиске клиента" skip
      156             "Клиент" 'маг':U buf_shop.obj-code skip
      157             view-as alert-box error .
      158           undo, return error .
      159         end.
      160         create buf_temp-obj .
      161         assign
      162           buf_temp-obj.obj-type  = 'маг':U
      163           buf_temp-obj.obj-code  = buf_shop.obj-code
      164           buf_temp-obj.host-code = buf_shop.host-code
      165           buf_temp-obj.db-num    = buf_clients.db-num
      166         .
      167       end.
      168     end.
      169   end.
      170   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   define temp-table userobjs_temp-user-obj no-undo
      172     field obj-type as character
      173     field obj-code as integer
      174     index xpk is primary unique obj-type obj-code
      175     .
      176   procedure userobjs_clear :
      177     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      178     do
      179     on error undo, return error return-value
      180     :
      181       for each buf_userobjs_temp-user-obj
      182       on error undo, return error return-value
      183       :
      184         delete buf_userobjs_temp-user-obj .
      185       end.
      186     end.
      187   end .
      188   procedure userobjs_object-count :
      189     define output parameter p-total-count as integer   no-undo .
      190     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      191     do
      192     on error undo, return error return-value
      193     :
      194       assign
      195         p-total-count = 0
      196       .
      197       for each buf_userobjs_temp-user-obj
      198       on error undo, return error return-value
      199       :
      200         assign
      201           p-total-count = p-total-count + 1
      202         .
      203       end.
      204     end.
      205   end.
      206   procedure userobjs_append :
      207      define input  parameter p-obj-type as character no-undo .
      208      define input  parameter p-obj-code as integer   no-undo .
      209     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      210     do
      211     on error undo, return error return-value
      212     :
      213       find first buf_userobjs_temp-user-obj
      214         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      215           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      216         no-error .
      217       if not available buf_userobjs_temp-user-obj
      218       then do:
      219         create buf_userobjs_temp-user-obj .
      220         assign
      221           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      222           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      223         .
      224       end.
      225     end.
      226   end.
      227   procedure userobjs_object-exist :
      228     define output parameter p-object-exist as logical   no-undo .
      229     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      230     do
      231     on error undo, return error return-value
      232     :
      233       find first buf_userobjs_temp-user-obj
      234         no-error .
      235       if not available buf_userobjs_temp-user-obj
      236       then do:
      237         assign
      238           p-object-exist = false
      239         .
      240       end.
      241       else do:
      242         assign
      243           p-object-exist = true
      244         .
      245       end.
      246     end.
      247   end.
      248   procedure userobjs_transfer :
      249     define input  parameter p-callback-handle as handle no-undo .
      250     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      251     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      252     do
      253     on error undo, return error return-value
      254     :
      255       if valid-handle(p-callback-handle) <> true
      256       then do:
      257         message
      258           vss-workfile vss-revision vss-description skip
      259           "Ошибка задания входных параметров" skip
      260           "Неизвестный указатель на процедуру" skip
      261           view-as alert-box error .
      262         undo, return error return-value .
      263       end.
      264       if p-callback-handle :get-signature("userobjs_append") = ""
      265       then do:
      266         message
      267           vss-workfile vss-revision vss-description skip
      268           "Ошибка задания входных параметров" skip
      269           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      270                     ,p-callback-handle :file-name
      271                     ) skip
      272           view-as alert-box error .
      273         undo, return error return-value .
      274       end.
      275       for each buf_userobjs_temp-user-obj
      276       on error undo, return error return-value
      277       :
      278         run userobjs_append in p-callback-handle
      279           (input  buf_userobjs_temp-user-obj.obj-type
      280           ,input  buf_userobjs_temp-user-obj.obj-code
      281           ) .
      282       end.
      283     end.
      284   end procedure.
      285   procedure userobjs_select-one :
      286      define input  parameter parparentproc     as widget-handle no-undo .
      287      define input  parameter p-db-num          as integer   no-undo .
      288      define input  parameter p-user-id         as character no-undo .
      289      define input  parameter p-host-code-obj   as integer   no-undo .
      290      define input  parameter p-obj-type        as character no-undo .
      291      define input  parameter p-obj-code        as integer   no-undo .
      292      define output parameter p-user-select     as logical   no-undo .
      293      define output parameter p-select-obj-type as character no-undo .
      294      define output parameter p-select-obj-code as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       run gbl/userobjs.w
      299         (input  parparentproc
      300         ,input  this-procedure :handle
      301         ,input  p-db-num
      302         ,input  p-user-id
      303         ,input  p-host-code-obj
      304         ,input  p-obj-type
      305         ,input  p-obj-code
      306         ,INPUT  "b-sel"
      307         ,output p-user-select
      308         ,output p-select-obj-type
      309         ,output p-select-obj-code
      310         ) .
      311     end.
      312   end.
      313   procedure userobjs_select-many :
      314     define input  parameter parparentproc   as widget-handle no-undo .
      315     define input  parameter p-db-num        as integer   no-undo .
      316     define input  parameter p-user-id       as character no-undo .
      317     define input  parameter p-host-code-obj as integer   no-undo .
      318     define input  parameter p-obj-type      as character no-undo .
      319     define input  parameter p-obj-code      as integer   no-undo .
      320     define output parameter p-user-select   as logical   no-undo .
      321     define variable v-select-obj-type as character no-undo .
      322     define variable v-select-obj-code as integer   no-undo .
      323     do
      324     on error undo, return error return-value
      325     :
      326       run gbl/userobjs.w
      327         (input  parparentproc
      328         ,input  this-procedure :handle
      329         ,input  p-db-num
      330         ,input  p-user-id
      331         ,input  p-host-code-obj
      332         ,input  p-obj-type
      333         ,input  p-obj-code
      334         ,INPUT  "b-sel,b-mark"
      335         ,output p-user-select
      336         ,output v-select-obj-type
      337         ,output v-select-obj-code
      338         ) .
      339     end.
      340   end.
      341   procedure thobjs :
      342      define input        parameter parparentproc     as widget-handle no-undo .
      343      define input        parameter i-bttns           as character     no-undo .
      344      define input        parameter i-list-mode       as character     no-undo.
      345      define input        parameter i-obj-type        as character     no-undo.
      346      define input        parameter i-db-num          as integer       no-undo.
      347      define input        parameter i-host-code       as integer       no-undo.
      348      define input-output parameter p-rid-list        as character     no-undo .
      349   run ref/thobjs.p
      350           ( input parparentproc
      351            ,input  this-procedure :handle
      352           , input i-bttns
      353           , input i-list-mode
      354           , input i-obj-type
      355           , input i-db-num
      356           , input i-host-code
      357           , input-output p-rid-list ) no-error .
      358   end.
      359   run init-temphost .
      360   define variable lok as logical no-undo init false .
      361   message
      362     "Удалить лишние записи prt-obj." skip
      363     "ВНИМАНИЕ! ВСЕМ ПОЛЬЗОВАТЕЛЯМ НЕОБХОДИМО ВЫЙТИ ИЗ СИСТЕМЫ!" skip
      364     "Да - все объекты" skip
      365     "Нет - выбрать объекты" skip
      366     "Отмена - отказаться от запуска утилиты"
      367     "Удаленные записи prt-obj записываются в текстовый файл chkprtob.txt." skip
      368     view-as alert-box question buttons yes-no-cancel update lok
      369     .
      370   if lok = ? then do:
      371     return .
      372   end.
      373   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374     run mainmenu_getcntxt in parparentproc
      375       (output v-cntxt-db-num
      376       ,output v-cntxt-userid
      377       ,output v-cntxt-level
      378       ,output v-cntxt-host-code-obj
      379       ,output v-cntxt-obj-type
      380       ,output v-cntxt-obj-code
      381       ,output v-cntxt-db-num-obj
      382       ,output v-cntxt-is-admin
      383       ) .
      384   if lok = true then do:
      385     for each temp-obj
      386     :
      387       run object-check-prt-obj
      388         (input temp-obj.obj-type
      389         ,input temp-obj.obj-code
      390         ).
      391     end.
      392   end.
      393   if lok = false then do:
      394     define variable v-user-select as logical   no-undo .
      395   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   run userobjs_select-many in this-procedure
      397     (input  parparentproc
      398     ,input  v-cntxt-db-num
      399     ,input  v-cntxt-userid
      400     ,input  v-cntxt-host-code-obj
      401     ,input  v-cntxt-obj-type
      402     ,input  v-cntxt-obj-code
      403     ,output v-user-select
      404     )  .
      405     if v-user-select <> true
      406     then do:
      407       message
      408         "Объект не выбран"
      409         view-as alert-box information .
      410       return .
      411     end.
      412     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      413     for each buf_userobjs_temp-user-obj
      414     on error undo, return error return-value
      415     :
      416       run object-check-prt-obj
      417         (input buf_userobjs_temp-user-obj.obj-type
      418         ,input buf_userobjs_temp-user-obj.obj-code
      419         ).
      420     end.
      421   end.
      422   if v-ind = 0
      423   then do:
      424     message
      425       "Просмотр выбранных объектов закончен." skip
      426       "Ошибок не найдено." skip
      427       view-as alert-box information.
      428   end.
      429   else do:
      430     message
      431       "Просмотр выбранных объектов закончен." skip
      432       "Найдено" v-ind "ошибок." skip
      433       view-as alert-box error .
      434   end.
      435   procedure object-check-prt-obj :
      436     define input parameter p-obj-type like prt-obj.obj-type no-undo .
      437     define input parameter p-obj-code like prt-obj.obj-code no-undo .
      438     for each prt-obj
      439       where prt-obj.obj-type = p-obj-type
      440         and prt-obj.obj-code = p-obj-code
      441     :
      442       find first gds-obj no-lock
      443         where gds-obj.obj-type  = p-obj-type
      444           and gds-obj.obj-code  = p-obj-code
      445           and gds-obj.artic     = prt-obj.artic
      446           and gds-obj.prod-type = prt-obj.prod-type
      447           and gds-obj.prod-code = prt-obj.prod-code
      448         no-error .
      449       if not available gds-obj then do:
      450         output to chkprtobj.txt append .
      451         export prt-obj .
      452         output close .
      453         delete prt-obj .
      454         assign
      455           v-ind = v-ind + 1
      456         .
      457       end.
      458     end.
      459   end procedure.
