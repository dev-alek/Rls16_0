        1   block-level on error undo, throw.
        2   DEF VAR num AS INT NO-UNDO.
        3   DEF VAR v-ind-1 AS INT NO-UNDO.
        4   define variable v-ind as integer   no-undo .
        5   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        6   define variable v-waitfram-action01         as character   no-undo .
        7   define variable v-waitfram-action02         as character   no-undo .
        8   define variable v-waitfram-action03         as character   no-undo .
        9   define variable mWaitFramTextBeg            as character   no-undo.
       10   define variable mWaitFramTextEnd            as character   no-undo.
       11   define variable mWaitFramView               as logical     no-undo.
       12   define variable mWaitProcEvent              as logical     no-undo init yes.
       13   define variable mWaitFramInterval           as integer     no-undo init 1 .
       14   define variable mWaitFramStop               as logical     no-undo.
       15   define variable mWaitFramStopUser           as logical     no-undo.
       16   define variable mWaitFramStopTimeOut        as logical     no-undo.
       17   define variable mWaitFramStartProc          as datetime-tz no-undo.
       18   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       19   define button B-WaitFramStop auto-end-key
       20        label "Стоп"
       21        size 10 by 1 tooltip "Остоновить процесс".
       22   define button B-viewProcInfo
       23        label "Информация"
       24        size 15 by 1 tooltip "Информация о процесс".
       25   define frame waitfram
       26     v-waitfram-action01 format "x(72)" no-label skip
       27     v-waitfram-action02 format "x(72)" no-label skip
       28     v-waitfram-action03 format "x(72)" no-label skip
       29     B-viewProcInfo
       30     B-WaitFramStop at row 4 col 30
       31     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       32     .
       33   define new global shared variable mBatchMode as logical no-undo init ?.
       34   define variable mFramBachModHandle as handle no-undo.
       35   mFramBachModHandle = frame waitfram:handle.
       36   define variable mFameOldVis as logical no-undo.
       37   define variable mVisCUrentVin as logical no-undo.
       38   if session:batch-mode
       39   then
       40      mBatchMode = yes.
       41   if mBatchMode = ? then do:
       42     mVisCUrentVin = current-window:visible.
       43     mFameOldVis = mFramBachModHandle:visible.
       44     mFramBachModHandle:visible  = yes.
       45     mBatchMode = mFramBachModHandle:visible ne yes.
       46     mFramBachModHandle:visible = mFameOldVis.
       47     current-window:visible = mVisCUrentVin.
       48   end.
       49    if  log-manager:logfile-name ne ?
       50     then DO:
       51         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
       52         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
       53         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
       54     end.
       55   on choose of B-WaitFramStop in frame waitfram
       56   do:
       57     mWaitFramStop = yes.
       58     mWaitFramStopUser = yes.
       59   end.
       60   function waitfram-check-timeout returns logical():
       61      define variable vtime as int64 no-undo.
       62      if mWaitFramStopTimeOut
       63      then
       64         return yes.
       65      vtime = ( now - mWaitFramStartProc ) / 1000 .
       66      if     mWaitFramTimeOut ne ?
       67         and mWaitFramTimeOut ne 0
       68         and mWaitFramTimeOut lt vtime
       69      then do:
       70         mWaitFramStopTimeOut = yes.
       71      end.
       72      return mWaitFramStopTimeOut.
       73   end.
       74   procedure waitfram-hide :
       75     if not session:batch-mode
       76     then do
       77     on error undo, return error return-value
       78     :
       79       pause 0 before-hide .
       80       if not mBatchMode then
       81         hide frame waitfram .
       82     if     not mWaitFramView
       83        and mWaitProcEvent
       84     then
       85       process events .
       86     end.
       87   end procedure.
       88   procedure waitfram-show :
       89     define input  parameter p-message as character no-undo .
       90     define variable v-left-margin as integer   no-undo .
       91     if not session:batch-mode
       92     then do
       93     on error undo, return error return-value
       94     :
       95       if length(p-message) <= 70 then do:
       96         assign
       97           v-left-margin = integer((70 - length(p-message)) / 2)
       98         .
       99         assign
      100           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      101         .
      102         assign
      103           v-waitfram-action01 = " "
      104           v-waitfram-action02 = " "
      105                                    + fill(" ", v-left-margin)
      106                                    + p-message
      107           v-waitfram-action03 = " "
      108         .
      109       end.
      110       else do:
      111         define variable vRindex1 as integer no-undo.
      112         define variable vRindex2 as integer no-undo.
      113         vRindex1 = r-index(p-message," ",70).
      114         if vRindex1 = 0
      115         then
      116            vRindex1 = 70.
      117         if length(p-message)  <= vRindex1 + 70 then do:
      118           assign
      119             v-waitfram-action01 = " "
      120             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      121             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      122           .
      123         end.
      124         else do:
      125           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      126           if vRindex2 <= vRindex1
      127           then
      128              vRindex2 = vRindex1 + 70.
      129           assign
      130             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      131             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      132             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      133           .
      134         end.
      135       end.
      136       B-viewProcInfo:visible   in frame waitfram = no.
      137       B-viewProcInfo:sensitive in frame waitfram = no.
      138       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      139       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      140       if  (   mWaitFramView
      141          or  mWaitProcEvent)
      142          and not mBatchMode
      143       then
      144          display
      145             v-waitfram-action01 skip
      146             v-waitfram-action02 skip
      147             v-waitfram-action03 skip
      148          with frame waitfram .
      149       if     mWaitFramView
      150          then do:
      151             if     mWaitFramInterval ne ?
      152                and not mBatchMode
      153             then
      154                wait-for go of frame waitfram pause mWaitFramInterval.
      155          end.
      156          else
      157             if     mWaitProcEvent
      158                and not mBatchMode
      159             then
      160                process events .
      161     end.
      162   end procedure.
      163      procedure waitfram-show-this:
      164         define input  parameter iInterval as int64 no-undo.
      165         define variable vtime as int64 no-undo.
      166         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      167         mWaitFramInterval = iInterval.
      168         run waitfram-show (substitute("&1&2 &3&4" ,
      169                                       mWaitFramTextBeg ,
      170                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      171                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      172                                       mWaitFramTextEnd
      173                                      )
      174                           ).
      175      end.
      176      procedure WaitFramRunPause:
      177         define input  parameter iInterval as dec no-undo.
      178         define variable vStart  as datetime-tz no-undo.
      179         define variable vend    as datetime-tz no-undo.
      180         define variable vint as int64 no-undo.
      181         define variable vOk as logical no-undo.
      182         vStart = now.
      183         vend   = vStart.
      184         publish "WaitFramPause" (iInterval,output vOk).
      185         vend   =  now.
      186         vint = vend - vStart.
      187         vint = iInterval - vint / 1000.
      188         if     not mWaitFramStop
      189            and (   vint > 0
      190                 or (    not vOk
      191                     and iInterval eq ?
      192                     )
      193                 )
      194         then
      195            run waitfram-show-this (iInterval).
      196         vend   =  now.
      197         vint = vend - vStart.
      198         vint = iInterval - vint / 1000.
      199         if     not mWaitFramStop
      200            and vint > 0
      201         then do:
      202            run gbl/pause.p (vint * 1000).
      203         end.
      204         if iInterval ne ?
      205         then
      206            publish "WaitFramStop".
      207         waitfram-check-timeout().
      208      end.
      209      procedure WaitFramWaitFor:
      210         define input  parameter iInterval as dec no-undo.
      211         assign
      212            mWaitFramStartProc   = now
      213            mWaitFramStopUser    = no
      214            mWaitFramStopTimeOut = no
      215         .
      216         block-wait:
      217         do while not mWaitFramStop:
      218            run WaitFramRunPause (iInterval).
      219            if  waitfram-check-timeout()
      220            then do:
      221               leave block-wait.
      222            end.
      223         end.
      224         run waitfram-hide.
      225      end.
      226   procedure waitfram-join :
      227     define input  parameter p-line-1  as character no-undo .
      228     define input  parameter p-line-2  as character no-undo .
      229     define input  parameter p-line-3  as character no-undo .
      230     define output parameter p-message as character no-undo .
      231     do
      232     on error undo, return error return-value
      233     :
      234       assign
      235         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      236                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      237                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      238       .
      239     end.
      240   end procedure.
      241   function waitfram-join-function returns character
      242     (input p-line-1 as character
      243     ,input p-line-2 as character
      244     ,input p-line-3 as character
      245     ).
      246     define variable v-message as character no-undo .
      247     run waitfram-join in this-procedure
      248       (input  p-line-1
      249       ,input  p-line-2
      250       ,input  p-line-3
      251       ,output v-message
      252       ) .
      253     return v-message .
      254   end function .
      255   DEFINE VARIABLE chExcelApplication      AS COM-HANDLE.
      256   DEFINE VARIABLE chWorkbook              AS COM-HANDLE.
      257   DEFINE VARIABLE chWorksheet             AS COM-HANDLE.
      258   def var cColumn       as character no-undo .
      259   def var cRange        as character no-undo .
      260   define TEMP-TABLE tt-db-info  no-undo
      261           field db-num                    as int
      262           field area-id                   as int
      263           field area-name                 as char
      264           field date-info                 as date
      265   index pi IS PRIMARY db-num area-id area-name date-info.
      266   .
      267   CREATE "Excel.Application" chExcelApplication no-error.
      268       if error-status :error then do:
      269           message
      270           "Ошибка при запуске Excel" skip
      271           error-status :get-message(1) skip
      272           view-as alert-box error .
      273           undo, return error .
      274       end.
      275   assign
      276     chExcelApplication:Visible = false
      277     chWorkbook = chExcelApplication:Workbooks:Add ()
      278   .
      279   assign
      280     chWorkSheet = chExcelApplication:Sheets:Item (1)
      281     chExcelApplication:Interactive = false
      282     chExcelApplication:ScreenUpdating = false
      283     chWorkSheet:Name = "Партии"
      284     chWorkSheet:Range ("A1"):Value           = "№ БД"
      285     chWorkSheet:Columns ("A":U):ColumnWidth  = 5
      286     chWorkSheet:Columns ("A":U):NumberFormat = fill ("#", 5) + "0"
      287     chWorkSheet:Range ("B1"):Value           = "№ области"
      288     chWorkSheet:Columns ("B":U):ColumnWidth  = 5
      289     chWorkSheet:Columns ("B":U):NumberFormat = "@"
      290     chWorkSheet:Range ("C1"):Value           = "Имя области"
      291     chWorkSheet:Columns ("C":U):ColumnWidth  = 15
      292     chWorkSheet:Columns ("C":U):NumberFormat = fill ("0", 9)
      293     chWorkSheet:Range ("D1"):Value           = "Имя тома"
      294     chWorkSheet:Columns ("D":U):ColumnWidth  = 28
      295     chWorkSheet:Columns ("D":U):NumberFormat = fill ("0", 7)
      296     chWorkSheet:Range ("E1"):Value           = "Посл. том заполнен на %"
      297     chWorkSheet:Columns ("E":U):ColumnWidth  = 20
      298     chWorkSheet:Columns ("E":U):NumberFormat = "@"
      299     chWorkSheet:Range ("F1"):Value           = "На дату"
      300     chWorkSheet:Columns ("F":U):ColumnWidth  = 10
      301     chWorkSheet:Columns ("F":U):NumberFormat = "@"
      302     chWorkSheet:Range ("A1:F1"):Font:Bold = TRUE
      303     chWorkSheet:Range ("A1:F1"):Interior:ColorIndex = 35
      304     chWorkSheet:Range ("G1"):Value           = "Время "
      305     chWorkSheet:Columns ("G":U):ColumnWidth  = 10
      306     chWorkSheet:Columns ("G":U):NumberFormat = "@"
      307     chWorkSheet:Range ("A1:G1"):Font:Bold = TRUE
      308     chWorkSheet:Range ("A1:G1"):Interior:ColorIndex = 35
      309     .
      310   run waitfram-show
      311     (input "Экспорт в EXCEL. Ждите ..."
      312     ).
      313   v-ind = 1.
      314   FOR EACH db WHERE db.db-num > 0 NO-LOCK:
      315       num = ?.
      316       srch_first:
      317       DO v-ind-1 = 1 TO 365:
      318         FIND FIRST  db-info  WHERE
      319                  db-info.db-num = db.db-num
      320             AND db-info.date-info =  TODAY - v-ind-1
      321             AND  db-info.volume-hiwater <> 0
      322         NO-LOCK NO-ERROR.
      323         IF AVAIL db-info THEN DO:
      324             num = v-ind-1.
      325             LEAVE srch_first.
      326         END.
      327       END.
      328       IF num <> ?  THEN DO:
      329         FOR EACH    db-info   WHERE
      330                db-info.db-num = db.db-num
      331           AND  db-info.date-info =  TODAY - v-ind-1
      332           AND  db-info.volume-hiwater <> 0
      333         NO-LOCK:
      334           find first tt-db-info  WHERE
      335                tt-db-info.db-num    = db-info.db-num
      336           AND  tt-db-info.area-id   = db-info.area-id
      337           AND  tt-db-info.area-name = db-info.area-name
      338           AND  tt-db-info.date-info = db-info.date-info no-error.
      339           if not available (tt-db-info) then     do:
      340            create tt-db-info .
      341            assign
      342                tt-db-info.db-num    = db-info.db-num
      343                tt-db-info.area-id   = db-info.area-id
      344                tt-db-info.area-name = db-info.area-name
      345                tt-db-info.date-info = db-info.date-info .
      346            .
      347            end.
      348         END.
      349       END.
      350   END.
      351   FOR EACH tt-db-info  NO-LOCK:
      352   find last    ub.db-info  WHERE
      353                tt-db-info.db-num    = db-info.db-num
      354           AND  tt-db-info.area-id   = db-info.area-id
      355           AND  tt-db-info.area-name = db-info.area-name
      356           AND  tt-db-info.date-info = db-info.date-info no-error.
      357            assign
      358               ccolumn = string (v-ind + 1)
      359               cRange = "A":U + cColumn
      360               chWorkSheet:Range (cRange):Value = db-info.db-num
      361               cRange = "B":U + cColumn
      362               chWorkSheet:Range (cRange):Value = db-info.area-id
      363               cRange = "C":U + cColumn
      364               chWorkSheet:Range (cRange):Value = db-info.area-name
      365               cRange = "D":U + cColumn
      366               chWorkSheet:Range (cRange):Value = db-info.volume-name
      367               cRange = "E":U + cColumn
      368               chWorkSheet:Range (cRange):Value = db-info.volume-percent-hiwater
      369               cRange = "F":U + cColumn
      370               chWorkSheet:Range (cRange):Value = ub.db-info.date-info
      371               cRange = "G":U + cColumn
      372               chWorkSheet:Range (cRange):Value =  string(ub.db-info.time-info, "HH:MM:SS")
      373               v-ind = v-ind + 1
      374               .
      375            IF db-info.volume-percent-hiwater > 50 AND db-info.volume-percent-hiwater < 80 THEN DO:
      376                ASSIGN
      377                   cRange = "E":U + cColumn
      378                   chWorkSheet:Range (cRange):Interior:ColorIndex = 6
      379                .
      380            END.
      381            ELSE IF db-info.volume-percent-hiwater > 80 THEN DO:
      382                ASSIGN
      383                   cRange = "E":U + cColumn
      384                   chWorkSheet:Range (cRange):Interior:ColorIndex = 3
      385                .
      386            END.
      387   end.
      388   empty temp-table tt-db-info .
      389   run waitfram-hide in this-procedure .
      390   assign
      391     chExcelApplication:Interactive = true
      392     chExcelApplication:ScreenUpdating = true
      393     chExcelApplication:Visible = true
      394   .
      395   RELEASE OBJECT chWorksheet.
      396   RELEASE OBJECT chExcelApplication.
      397   RELEASE OBJECT chWorkbook.
