        1   block-level on error undo, throw.
        2   define input parameter p-install as logical no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: frcnwsdr.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/frcnwsdr.p $":U .
        8   define variable vss-description as character no-undo init "Форсированная передача правил скидок, созданных в процессе upgrade".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define variable v-waitfram-action01         as character   no-undo .
       80   define variable v-waitfram-action02         as character   no-undo .
       81   define variable v-waitfram-action03         as character   no-undo .
       82   define variable mWaitFramTextBeg            as character   no-undo.
       83   define variable mWaitFramTextEnd            as character   no-undo.
       84   define variable mWaitFramView               as logical     no-undo.
       85   define variable mWaitProcEvent              as logical     no-undo init yes.
       86   define variable mWaitFramInterval           as integer     no-undo init 1 .
       87   define variable mWaitFramStop               as logical     no-undo.
       88   define variable mWaitFramStopUser           as logical     no-undo.
       89   define variable mWaitFramStopTimeOut        as logical     no-undo.
       90   define variable mWaitFramStartProc          as datetime-tz no-undo.
       91   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       92   define button B-WaitFramStop auto-end-key
       93        label "Стоп"
       94        size 10 by 1 tooltip "Остоновить процесс".
       95   define button B-viewProcInfo
       96        label "Информация"
       97        size 15 by 1 tooltip "Информация о процесс".
       98   define frame waitfram
       99     v-waitfram-action01 format "x(72)" no-label skip
      100     v-waitfram-action02 format "x(72)" no-label skip
      101     v-waitfram-action03 format "x(72)" no-label skip
      102     B-viewProcInfo
      103     B-WaitFramStop at row 4 col 30
      104     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      105     .
      106   define new global shared variable mBatchMode as logical no-undo init ?.
      107   define variable mFramBachModHandle as handle no-undo.
      108   mFramBachModHandle = frame waitfram:handle.
      109   define variable mFameOldVis as logical no-undo.
      110   define variable mVisCUrentVin as logical no-undo.
      111   if session:batch-mode
      112   then
      113      mBatchMode = yes.
      114   if mBatchMode = ? then do:
      115     mVisCUrentVin = current-window:visible.
      116     mFameOldVis = mFramBachModHandle:visible.
      117     mFramBachModHandle:visible  = yes.
      118     mBatchMode = mFramBachModHandle:visible ne yes.
      119     mFramBachModHandle:visible = mFameOldVis.
      120     current-window:visible = mVisCUrentVin.
      121   end.
      122    if  log-manager:logfile-name ne ?
      123     then DO:
      124         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      125         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      126         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      127     end.
      128   on choose of B-WaitFramStop in frame waitfram
      129   do:
      130     mWaitFramStop = yes.
      131     mWaitFramStopUser = yes.
      132   end.
      133   function waitfram-check-timeout returns logical():
      134      define variable vtime as int64 no-undo.
      135      if mWaitFramStopTimeOut
      136      then
      137         return yes.
      138      vtime = ( now - mWaitFramStartProc ) / 1000 .
      139      if     mWaitFramTimeOut ne ?
      140         and mWaitFramTimeOut ne 0
      141         and mWaitFramTimeOut lt vtime
      142      then do:
      143         mWaitFramStopTimeOut = yes.
      144      end.
      145      return mWaitFramStopTimeOut.
      146   end.
      147   procedure waitfram-hide :
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       pause 0 before-hide .
      153       if not mBatchMode then
      154         hide frame waitfram .
      155     if     not mWaitFramView
      156        and mWaitProcEvent
      157     then
      158       process events .
      159     end.
      160   end procedure.
      161   procedure waitfram-show :
      162     define input  parameter p-message as character no-undo .
      163     define variable v-left-margin as integer   no-undo .
      164     if not session:batch-mode
      165     then do
      166     on error undo, return error return-value
      167     :
      168       if length(p-message) <= 70 then do:
      169         assign
      170           v-left-margin = integer((70 - length(p-message)) / 2)
      171         .
      172         assign
      173           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      174         .
      175         assign
      176           v-waitfram-action01 = " "
      177           v-waitfram-action02 = " "
      178                                    + fill(" ", v-left-margin)
      179                                    + p-message
      180           v-waitfram-action03 = " "
      181         .
      182       end.
      183       else do:
      184         define variable vRindex1 as integer no-undo.
      185         define variable vRindex2 as integer no-undo.
      186         vRindex1 = r-index(p-message," ",70).
      187         if vRindex1 = 0
      188         then
      189            vRindex1 = 70.
      190         if length(p-message)  <= vRindex1 + 70 then do:
      191           assign
      192             v-waitfram-action01 = " "
      193             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      195           .
      196         end.
      197         else do:
      198           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      199           if vRindex2 <= vRindex1
      200           then
      201              vRindex2 = vRindex1 + 70.
      202           assign
      203             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      204             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      205             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      206           .
      207         end.
      208       end.
      209       B-viewProcInfo:visible   in frame waitfram = no.
      210       B-viewProcInfo:sensitive in frame waitfram = no.
      211       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      212       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       if  (   mWaitFramView
      214          or  mWaitProcEvent)
      215          and not mBatchMode
      216       then
      217          display
      218             v-waitfram-action01 skip
      219             v-waitfram-action02 skip
      220             v-waitfram-action03 skip
      221          with frame waitfram .
      222       if     mWaitFramView
      223          then do:
      224             if     mWaitFramInterval ne ?
      225                and not mBatchMode
      226             then
      227                wait-for go of frame waitfram pause mWaitFramInterval.
      228          end.
      229          else
      230             if     mWaitProcEvent
      231                and not mBatchMode
      232             then
      233                process events .
      234     end.
      235   end procedure.
      236      procedure waitfram-show-this:
      237         define input  parameter iInterval as int64 no-undo.
      238         define variable vtime as int64 no-undo.
      239         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      240         mWaitFramInterval = iInterval.
      241         run waitfram-show (substitute("&1&2 &3&4" ,
      242                                       mWaitFramTextBeg ,
      243                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      244                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      245                                       mWaitFramTextEnd
      246                                      )
      247                           ).
      248      end.
      249      procedure WaitFramRunPause:
      250         define input  parameter iInterval as dec no-undo.
      251         define variable vStart  as datetime-tz no-undo.
      252         define variable vend    as datetime-tz no-undo.
      253         define variable vint as int64 no-undo.
      254         define variable vOk as logical no-undo.
      255         vStart = now.
      256         vend   = vStart.
      257         publish "WaitFramPause" (iInterval,output vOk).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and (   vint > 0
      263                 or (    not vOk
      264                     and iInterval eq ?
      265                     )
      266                 )
      267         then
      268            run waitfram-show-this (iInterval).
      269         vend   =  now.
      270         vint = vend - vStart.
      271         vint = iInterval - vint / 1000.
      272         if     not mWaitFramStop
      273            and vint > 0
      274         then do:
      275            run gbl/pause.p (vint * 1000).
      276         end.
      277         if iInterval ne ?
      278         then
      279            publish "WaitFramStop".
      280         waitfram-check-timeout().
      281      end.
      282      procedure WaitFramWaitFor:
      283         define input  parameter iInterval as dec no-undo.
      284         assign
      285            mWaitFramStartProc   = now
      286            mWaitFramStopUser    = no
      287            mWaitFramStopTimeOut = no
      288         .
      289         block-wait:
      290         do while not mWaitFramStop:
      291            run WaitFramRunPause (iInterval).
      292            if  waitfram-check-timeout()
      293            then do:
      294               leave block-wait.
      295            end.
      296         end.
      297         run waitfram-hide.
      298      end.
      299   procedure waitfram-join :
      300     define input  parameter p-line-1  as character no-undo .
      301     define input  parameter p-line-2  as character no-undo .
      302     define input  parameter p-line-3  as character no-undo .
      303     define output parameter p-message as character no-undo .
      304     do
      305     on error undo, return error return-value
      306     :
      307       assign
      308         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      309                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      311       .
      312     end.
      313   end procedure.
      314   function waitfram-join-function returns character
      315     (input p-line-1 as character
      316     ,input p-line-2 as character
      317     ,input p-line-3 as character
      318     ).
      319     define variable v-message as character no-undo .
      320     run waitfram-join in this-procedure
      321       (input  p-line-1
      322       ,input  p-line-2
      323       ,input  p-line-3
      324       ,output v-message
      325       ) .
      326     return v-message .
      327   end function .
      328   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      330   procedure disrules-fill-properties:
      331   define input  parameter p-templ-rl-root as integer   no-undo .
      332   define buffer buf_drt-prop for ub.drt-prop.
      333   define buffer buf_temp-drt-prop for temp-drt-prop.
      334   do
      335   on error undo, return error return-value
      336   :
      337     for each buf_temp-drt-prop:
      338       delete buf_temp-drt-prop.
      339     end.
      340     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      341       create buf_temp-drt-prop.
      342       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      343     end.
      344   end.
      345   end procedure.
      346   ~
      347   run utl/startrun.w ( input this-procedure:handle
      348                      , input "main-proc"
      349                      , input "no"
      350                      , input "Форсированная передача правил скидок, созданных в процессе upgrade").
      351   procedure main-proc :
      352   define input parameter p-handle-callback    as handle    no-undo .
      353   define input parameter p-parameters as character no-undo .
      354   define buffer buf_code-range for ub.code-range.
      355   define buffer buf_dis-rule for ub.dis-rule.
      356   define buffer buf_c-dis-rule for ub.c-dis-rule.
      357   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
      358   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
      359   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      360   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
      361   define buffer buf_Dis-card-type for ub.dis-card-type.
      362   define buffer buf_rule-by-call for ub.rule-by-call.
      363   define buffer buf_rule-call-param for ub.rule-call-param.
      364   define variable v-start-rule-num as integer no-undo extent 5.
      365   define variable v-end-rule-num as integer no-undo extent 5.
      366   define variable v-stop-run  as logical   no-undo .
      367   define variable v-pause-run as logical   no-undo .
      368   define variable v-error-ind  as integer   no-undo .
      369   define variable v-warn-ind   as integer   no-undo .
      370   define variable kk as integer no-undo .
      371   define variable v-rule-address as integer no-undo .
      372   define variable p-install as logical no-undo .
      373   define variable acc as integer no-undo .
      374   define variable need-acc as integer no-undo .
      375   define variable v-attr-code as character no-undo extent 4.
      376   define variable v-attr-code2 as character no-undo extent 4.
      377   define buffer buf_rep-start for ub.rep.
      378   define buffer buf_rep-end for ub.rep.
      379   define buffer buf_clients for ub.clients.
      380     main-block:
      381     do
      382     on error undo, return error
      383     :
      384     assign
      385     p-install = if entry(1, p-parameters, chr(4)) = "yes" then yes else no
      386     .
      387     if not p-install then do:
      388       message
      389       "Вы уверены, что хотите запустить пересылку данных по правилам скидок по новостям"
      390       view-as alert-box question buttons yes-no update loc#log as logical  .
      391       if not loc#log then return.
      392     end.
      393     if valid-handle(p-handle-callback)
      394     and p-handle-callback :get-signature('callback-set-start-run-time') <> ""
      395     then do:
      396       run callback-set-start-run-time in p-handle-callback .
      397     end.
      398     do kk = 1 to 4 :
      399       CASE kk:
      400         when 1 then do:
      401           assign
      402           v-rule-address = 061112030
      403           .
      404         end.
      405         when 2 then do:
      406           assign
      407           v-rule-address = 060811070
      408           .
      409         end.
      410         when 3 then do:
      411           assign
      412           v-rule-address = 061211050
      413           .
      414         end.
      415         when 4 then do:
      416           assign
      417           v-rule-address = 061213060
      418           .
      419         end.
      420        END CASE.
      421       run read-rule-num in this-procedure (input v-rule-address, 0, output v-start-rule-num[kk], buffer buf_rep-start).
      422       run read-rule-num in this-procedure (input v-rule-address + 1, 1, output v-end-rule-num[kk],  buffer buf_rep-end).
      423       assign
      424       need-acc = need-acc + v-end-rule-num[kk] - v-start-rule-num[kk]
      425       .
      426     end.
      427     do kk = 1 to 4 :
      428       _buf_dis-rule:
      429       for each buf_dis-rule no-lock
      430       :
      431         if buf_dis-rule.rule-num <= v-start-rule-num[kk]
      432         OR buf_dis-rule.rule-num >  v-end-rule-num[kk]
      433         or buf_dis-rule.upper-rule-num > 99999
      434         then next _buf_dis-rule.
      435         find first buf_code-range no-lock where
      436                   buf_code-range.range-type = 'drgb':U
      437              and  buf_code-range.first-code >= buf_Dis-rule.rule-num
      438              and  buf_code-range.last-code <= buf_Dis-rule.rule-num
      439              and  buf_code-range.db-num = g#db-num no-error.
      440         if not available buf_Code-range then next _buf_dis-rule.
      441         process events.
      442         if valid-handle(p-handle-callback)
      443         and p-handle-callback :get-signature('callback-check-stop-run') <> ""
      444         then do:
      445           run callback-check-stop-run in p-handle-callback
      446             (output v-stop-run
      447             ,output v-pause-run
      448             ) .
      449           if v-stop-run = true
      450           then do:
      451             define variable v-ok as logical   no-undo .
      452             message
      453               "Завершить процесс пересылки?"
      454               view-as alert-box question buttons yes-no update v-ok .
      455             if v-ok = true
      456             then do:
      457               leave _buf_dis-rule .
      458             end.
      459           end.
      460           if v-pause-run = true
      461           then do:
      462             message
      463               "Нажмите ОК, чтобы продолжить процесс пересылки" skip
      464               view-as alert-box information .
      465           end.
      466         end.
      467         assign
      468         acc = acc + 1.
      469         if valid-handle(p-handle-callback)
      470         and p-handle-callback :get-signature('callback-display-run') <> ""
      471         then do:
      472           run callback-display-run in p-handle-callback
      473             (input acc
      474             ,input need-acc - acc
      475             ,input v-error-ind + v-warn-ind
      476             ) .
      477         end.
      478         run str/callnews.p
      479             (input 'dis-rule':U
      480             ,input (buffer buf_dis-rule:handle)
      481             )  no-error .
      482         if error-status:error then do:
      483           run write-log in this-procedure (
      484                                             input substitute("Ошибка при пересылке по СПН записи правила скидок: " + chr(10) +
      485                                                             "номер правила &1", buf_dis-rule.rule-num)
      486                                           ,input p-handle-callback).
      487           assign
      488             v-error-ind = v-error-ind + 1
      489           .
      490           undo _buf_dis-rule, next  _buf_dis-rule .
      491         end.
      492         if (buf_dis-rule.templ-rl-root >= 57
      493         and buf_dis-rule.templ-rl-root <= 66)
      494         or  (buf_dis-rule.templ-rl-root >= 69
      495         and buf_dis-rule.templ-rl-root <= 71)
      496         then do:
      497           for each buf_dis-dct-rule no-lock where
      498                   buf_dis-dct-rule.rule-num = buf_dis-rule.rule-num,
      499               first buf_dis-card-type no-lock where
      500                   buf_dis-card-type.type = buf_dis-dct-rule.type
      501               and buf_dis-card-type.emitent-host-code = buf_dis-dct-rule.emitent-host-code
      502            on error undo, next:
      503               run str/callnews.p
      504                   (input 'dis-dct-rule':U
      505                   ,input (buffer buf_dis-dct-rule:handle)
      506                   )  no-error .
      507               if error-status:error then do:
      508                 run write-log in this-procedure (
      509                                                   input substitute("Ошибка при пересылке по СПН записи скидки на тип ДК: " + chr(10) +
      510                                                                   "тип ДК &1 эмитент &2 номер правила &3"
      511                                                                   , buf_dis-dct-rule.type
      512                                                                   , buf_dis-dct-rule.emitent-host-code
      513                                                                   , buf_dis-dct-rule.rule-num)
      514                                                 ,input p-handle-callback).
      515                 assign
      516                   v-error-ind = v-error-ind + 1
      517                 .
      518                 undo _buf_dis-rule, next  _buf_dis-rule .
      519               end.
      520              for each buf_rule-by-call no-lock where
      521                      buf_rule-by-call.call_id = buf_dis-card-type.uniq-key-rec,
      522                  each  buf_rule-call-param no-lock where
      523                     buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
      524                 and  buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
      525                 and buf_rule-call-param.call_id = buf_rule-by-call.call_id
      526                    :
      527                if  (buf_rule-call-param.param-name = "p-rule-num"
      528                      or
      529                    buf_rule-call-param.param-name = "p-prev-rule-num")
      530                 and buf_rule-call-param.param-value-int = buf_dis-dct-rule.rule-num then do:
      531                 run str/callnews.p
      532                     (input 'rule-call-param':U
      533                     ,input (buffer buf_rule-call-param:handle)
      534                     )  no-error .
      535                 if error-status:error then do:
      536                   run write-log in this-procedure (
      537                                                     input substitute("Ошибка при пересылке по СПН записи параметра вызова правла расетча алгоритма по ДК: " + chr(10) +
      538                                                                     "тип ДК &1 эмитент &2 параметр &3&4место вызова: кодекс &5 набор правил &6 порядок &7"
      539                                                                     , buf_dis-dct-rule.type
      540                                                                     , buf_dis-dct-rule.emitent-host-code
      541                                                                     , buf_rule-call-param.param-name
      542                                                                     , chr(10)
      543                                                                     , buf_rule-by-call.codex_id
      544                                                                     , buf_rule-by-call.ruleset_id
      545                                                                     , buf_rule-by-call.order_id
      546                                                                     )
      547                                                   ,input p-handle-callback).
      548                   assign
      549                     v-error-ind = v-error-ind + 1
      550                   .
      551                   undo _buf_dis-rule, next  _buf_dis-rule .
      552                 end.
      553                end.
      554              end.
      555           end.
      556         end.
      557         if g#db-num = 0
      558         and kk = 1 then do:
      559           _dis-gds-rule:
      560           for each buf_dis-gds-rule no-lock where
      561                   buf_dis-gds-rule.rule-num = buf_dis-rule.rule-num:
      562             run str/callnews.p
      563                 (input 'dis-gds-rule':U
      564                 ,input (buffer buf_dis-gds-rule:handle)
      565                 )  no-error .
      566             if error-status:error then do:
      567               run write-log in this-procedure (
      568                                                 input substitute("Ошибка при пересылке по СПН записи скидки товара на объекте: " + chr(10) +
      569                                                                 "товар &1 объект &2&3 номер правила &4"
      570                                                                 , buf_dis-gds-rule.gds-code
      571                                                                 , buf_dis-gds-rule.obj-type
      572                                                                 , buf_dis-gds-rule.obj-code
      573                                                                 , buf_dis-gds-rule.rule-num
      574                                                                 )
      575                                               ,input p-handle-callback).
      576               assign
      577                 v-error-ind = v-error-ind + 1
      578               .
      579               undo _buf_dis-rule, next  _buf_dis-rule .
      580             end.
      581           end.
      582         end.
      583         if g#db-num = 0
      584         and kk = 1 then do:
      585           _dis-dct-rule:
      586           for each buf_dis-dct-rule no-lock where
      587                   buf_dis-dct-rule.rule-num = buf_dis-rule.rule-num:
      588             run str/callnews.p
      589                 (input 'dis-dct-rule':U
      590                 ,input (buffer buf_dis-dct-rule:handle)
      591                 )  no-error .
      592             if error-status:error then do:
      593               run write-log in this-procedure (
      594                                                 input substitute("Ошибка при пересылке по СПН записи скидки по типам ДК: " + chr(10) +
      595                                                                 "тип карты &1 эмитент &2 правило скидки &3"
      596                                                                 , buf_dis-dct-rule.type
      597                                                                 , buf_dis-dct-rule.emitent-host-code
      598                                                                 , buf_dis-dct-rule.rule-num
      599                                                                 )
      600                                               ,input p-handle-callback).
      601               assign
      602                 v-error-ind = v-error-ind + 1
      603               .
      604               undo _buf_dis-rule, next  _buf_dis-rule .
      605             end.
      606           end.
      607         end.
      608         if g#db-num = 0
      609         and kk = 3 then do:
      610           _dis-grp-rule:
      611           for each buf_dis-grp-rule no-lock where
      612                   buf_dis-grp-rule.rule-num = buf_dis-rule.rule-num:
      613             run str/callnews.p
      614                 (input 'dis-grp-rule':U
      615                 ,input (buffer buf_dis-grp-rule:handle)
      616                 )  no-error .
      617             if error-status:error then do:
      618               run write-log in this-procedure (
      619                                                 input substitute("Ошибка при пересылке по СПН записи скидки по группам: " + chr(10) +
      620                                                                 "классификатор &1 код группы &2 правило скидки &3"
      621                                                                 , buf_dis-grp-rule.classif-type
      622                                                                 , buf_dis-grp-rule.node-code
      623                                                                 , buf_dis-grp-rule.rule-num
      624                                                                 )
      625                                               ,input p-handle-callback).
      626               assign
      627                 v-error-ind = v-error-ind + 1
      628               .
      629               undo _buf_dis-rule, next  _buf_dis-rule .
      630             end.
      631           end.
      632         end.
      633         if g#db-num = 0
      634         and kk = 4 then do:
      635           _dis-cp-rule:
      636           for each buf_dis-cp-rule no-lock where
      637                   buf_dis-cp-rule.rule-num = buf_dis-rule.rule-num:
      638             run str/callnews.p
      639                 (input 'dis-cp-rule':U
      640                 ,input (buffer buf_dis-cp-rule:handle)
      641                 )  no-error .
      642             if error-status:error then do:
      643               run write-log in this-procedure (
      644                                                 input substitute("Ошибка при пересылке по СПН записи скидки по типам касс. платежей: " + chr(10) +
      645                                                                 "тип касс платежа &1 код валюты 2 правило скидки &3"
      646                                                                 , buf_dis-cp-rule.cdpay-code
      647                                                                 , buf_dis-cp-rule.curr-code
      648                                                                 , buf_dis-cp-rule.rule-num
      649                                                                 )
      650                                               ,input p-handle-callback).
      651               assign
      652                 v-error-ind = v-error-ind + 1
      653               .
      654               undo _buf_dis-rule, next  _buf_dis-rule .
      655             end.
      656           end.
      657         end.
      658         for each buf_c-dis-rule no-lock where
      659                 buf_c-dis-rule.rule-num = buf_dis-rule.rule-num
      660             AND buf_c-dis-rule.corr-user-db-num   = g#db-num:
      661           if buf_c-dis-rule.corr-user-name = 'upgrade':U then do:
      662             run str/callnews.p
      663                 (input 'c-dis-rule':U
      664                 ,input (buffer buf_c-dis-rule:handle)
      665                 )  no-error .
      666             if error-status:error then do:
      667               run write-log in this-procedure (
      668                                                 input substitute("Ошибка при пересылке по СПН записи истории правила скидок: " + chr(10) +
      669                                                                 "номер правила &1", buf_dis-rule.rule-num)
      670                                               ,input p-handle-callback).
      671               assign
      672                 v-error-ind = v-error-ind + 1
      673               .
      674               undo _buf_dis-rule, next  _buf_dis-rule .
      675             end.
      676             else do:
      677             if available buf_rep-start then do:
      678               buf_rep-start.name1 = string(buf_dis-rule.rule-num).
      679               .
      680             end.
      681             end.
      682           end.
      683         end.
      684       end.
      685     end.
      686     FOR EACH buf_rule-call-param NO-LOCK
      687     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      688     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      689     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      690       :
      691       if  not (buf_rule-call-param.param-name = "p-rule-num"
      692             or
      693           buf_rule-call-param.param-name = "p-prev-rule-num")
      694       and buf_rule-call-param.param-value-int = buf_dis-dct-rule.rule-num then do:
      695         run str/callnews.p ( input 'rule-call-param':U
      696                             ,input buffer buf_rule-call-param:handle).
      697       end.
      698     END.
      699     if valid-handle(p-handle-callback)
      700     and p-handle-callback :get-signature('callback-display-run') <> ""
      701     then do:
      702       run callback-display-run in p-handle-callback
      703         (input acc
      704         ,input need-acc - acc
      705         ,input v-error-ind + v-warn-ind
      706         ) .
      707     end.
      708   end.
      709   if not p-install then do:
      710     message "Завершилась утилита пересылки правил скидок"
      711     view-as alert-box .
      712   end.
      713   end procedure.
      714   procedure read-rule-num :
      715     define input parameter p-repnum as integer no-undo .
      716     define input parameter p-start-end as integer no-undo .
      717     define output parameter p-rule-num as integer no-undo .
      718     define parameter buffer buf_rep for ub.rep.
      719     do
      720     on error undo, return error
      721     :
      722       find buf_rep
      723         where buf_rep.rep-num = p-repnum
      724         no-error
      725       .
      726       if not available buf_rep then do:
      727         assign
      728         p-rule-num = (if p-start-end = 0 then 0 else current-value(s-drgb-code, ub))
      729         .
      730         return .
      731       end.
      732       assign
      733       p-rule-num = integer(buf_rep.name1) no-error.
      734       if error-status:error then do:
      735         assign
      736         p-rule-num = (if p-start-end = 0 then 0 else current-value(s-drgb-code, ub))
      737         .
      738         release buf_rep.
      739       end.
      740       if p-start-end = 1 then release buf_rep.
      741     end.
      742   end procedure.
      743   procedure write-log :
      744     do
      745     on error undo, return error
      746     :
      747       define input parameter p-message   as character no-undo .
      748       define input parameter p-call-back as handle    no-undo .
      749       if  valid-handle(p-call-back)
      750       and lookup('callback-write-to-log', p-call-back :internal-entries) > 0
      751       and p-call-back <> this-procedure :handle
      752       then do:
      753         run callback-write-to-log in p-call-back
      754           (input p-message
      755           ) no-error .
      756       end.
      757     end.
      758   end procedure.
