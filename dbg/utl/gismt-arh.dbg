        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63   define  shared variable g#auto-pid           as integer   no-undo .
       64   define  shared variable conn-par             as character no-undo .
       65   define  shared variable g#auto-user-id       as character no-undo .
       66   define  shared variable g#auto-user-login    as character no-undo .
       67   define  shared variable g#auto-user-password as character no-undo .
       68   define  shared variable v-socket             as logical   no-undo .
       69   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define  shared variable auto-window-h     as handle    no-undo .
       71   define  shared variable auto-log-msg-h    as handle    no-undo .
       72   define  shared variable hand-log-msg-h    as handle    no-undo .
       73   define  shared variable log-file-name     as character no-undo initial ? .
       74   define  shared variable add-log-file-name as character no-undo initial ? .
       75   define  shared variable writelogvalue     as character no-undo initial ? .
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   define stream LogStream .
      306   define variable mNoTime as logical no-undo.
      307   procedure write-to-log-notime :
      308     define input param i-str as character no-undo .
      309     mNoTime = yes.
      310     run write-to-log (i-str).
      311     mNoTime = no.
      312   end.
      313   procedure write-to-log :
      314     define input param p-str as character no-undo .
      315     do
      316     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      317     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      318     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      319     :
      320       define variable log-res        as logical   no-undo .
      321       define variable v-jj           as integer   no-undo .
      322       if    mNoTime
      323          or writelogvalue eq "AsyncProc"
      324       then
      325          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      326       else
      327          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      328       if auto-log-msg-h <> ? then do:
      329         log-res = auto-log-msg-h:move-to-eof( ) .
      330         log-res = auto-log-msg-h:insert-string( p-str ).
      331       end.
      332       if hand-log-msg-h <> ? then do:
      333         log-res = hand-log-msg-h:move-to-eof( ) .
      334         log-res = hand-log-msg-h:insert-string( p-str ).
      335       end.
      336       assign
      337         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      338         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      339         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      340       .
      341       if add-log-file-name <> ? then do:
      342         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      343           run gbl/fileapnd.p
      344             ( input entry(v-jj, add-log-file-name, chr(1) )
      345             ,input p-str
      346             ,input 20
      347             ) no-error .
      348           if error-status:error then do:
      349             return error return-value .
      350           end.
      351         end.
      352       end.
      353       if writelogvalue eq "AsyncProc"
      354       then do:
      355          p-str = trim(p-str, (chr(13) + chr(10)) )
      356       .
      357          Publish "WriteLogAsunc" (p-str,yes).
      358       end.
      359       else if writelogvalue <> "yes" then do:
      360         run gbl/fileapnd.p
      361           ( input log-file-name
      362           ,input p-str
      363           ,input 20
      364           ) no-error .
      365         if error-status:error then do:
      366           return error return-value .
      367         end.
      368       end.
      369     end.
      370   end procedure.
      371   procedure write-to-screen :
      372     define input param p-str as character no-undo .
      373     do
      374     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      375     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      376     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      377     :
      378       define variable log-res as logical no-undo.
      379       assign
      380         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      381       .
      382       if auto-log-msg-h <> ?
      383       then do:
      384         log-res = auto-log-msg-h:move-to-eof( ) .
      385         log-res = auto-log-msg-h:insert-string( p-str ).
      386       end.
      387       if hand-log-msg-h <> ?
      388       then do:
      389         log-res = hand-log-msg-h:move-to-eof( ) .
      390         log-res = hand-log-msg-h:insert-string( p-str ).
      391       end.
      392     end.
      393   end procedure.
      394   procedure send-msg-to-email :
      395     define input  parameter p-subject      as character no-undo .
      396     define input  parameter p-text-err     as character no-undo .
      397     define input  parameter p-attach-files as character no-undo .
      398     do
      399     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      400     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      401     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      402     :
      403       define variable v-tth             as handle    no-undo .
      404       define variable v-value-character as character no-undo .
      405       define variable v-value-date      as date      no-undo .
      406       define variable v-value-decimal   as decimal   no-undo .
      407       define variable v-value-integer   as integer   no-undo .
      408       define variable v-value-logical   as logical   no-undo .
      409       define variable v-param-type      as character no-undo .
      410       define variable v-email       as character no-undo .
      411       define variable v-tmp-str     as character no-undo .
      412       define variable v-tmp1-str    as character no-undo .
      413       define variable v-ind         as integer   no-undo .
      414       define variable v-num-entries as integer   no-undo .
      415       delete object v-tth no-error.
      416       run adm/shattri.p
      417         ( input "get":U
      418          ,input  "":U
      419          ,input  0
      420          ,input  'auto-task':U
      421          ,input  'send-msg-to-email':U
      422          ,output v-value-character
      423          ,output v-value-date
      424          ,output v-value-decimal
      425          ,output v-value-integer
      426          ,output v-value-logical
      427          ,output v-param-type
      428          ,input-output table-handle v-tth
      429         ) no-error .
      430       if not error-status :error  then do:
      431         assign
      432           v-tmp-str = v-value-character
      433         .
      434       end.
      435       delete object v-tth no-error.
      436       assign
      437         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      438         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      439         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      440         v-num-entries = num-entries( v-tmp-str, chr(44) )
      441         v-email       = "":U
      442       .
      443       do v-ind = 1 to v-num-entries
      444       :
      445         assign
      446           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      447         .
      448         if trim( v-tmp1-str ) <> "":U then do:
      449           if v-email = "":U then do:
      450             assign
      451               v-email = v-tmp1-str
      452             .
      453           end.
      454           else do:
      455             assign
      456               v-email = v-email + chr(44) + v-tmp1-str
      457             .
      458           end.
      459         end.
      460       end.
      461       if v-email <> "":U then do:
      462         run gbl/sendmail.p
      463           ( input v-email
      464           , input p-subject
      465           , input p-text-err
      466           , input p-attach-files
      467           ) no-error .
      468         if error-status :error
      469           or return-value <> "":U
      470         then do:
      471           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      472         end.
      473       end.
      474     end.
      475   end procedure.
      476   define  shared variable nws-exch-dir as character no-undo .
      477   define  shared variable nws-heap-dir as character no-undo .
      478   define variable err-mess as character no-undo .
      479   define temp-table t-pck-conf no-undo
      480     field db-num-dst      as integer
      481     field db-num-src      as integer
      482     field pack-num        as integer
      483     field total-recs      as integer
      484     field sys-key         as character
      485     field src_db-key      as character
      486     field dst_db-key      as character
      487     field ver-num         as character
      488     field prev-crc        as character
      489     field actual-date     as date
      490     field actual-time-int as integer
      491   .
      492   function objExists return character
      493   (input  ifolder as character,
      494    input  iType   as character  ):
      495       define variable vFileType as character no-undo init "D,F".
      496       define variable vi        as integer no-undo.
      497       define variable vtype as character no-undo.
      498       if iType ne ?
      499       then
      500          vFileType = iType.
      501       do vi = 1 to num-entries(vFileType):
      502          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      503          vtype = file-information:file-type.
      504          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      505             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      506             index(vtype , entry(vi,vFileType )) > 0
      507          then return file-information:full-pathname .
      508          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      509          vtype = file-information:file-type.
      510          if file-information:file-name <> "" and
      511             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      512             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      513             index( vtype, entry(vi,vFileType )) > 0
      514          then return file-information:full-pathname .
      515       end.
      516       return ? .
      517   end.
      518   function SearchFile return character
      519   (input  ifile as character):
      520      return objExists(ifile,?).
      521   end.
      522   function SearchPFile return character
      523   (input inFile as char):
      524        define variable oFile       as character no-undo.
      525        define variable vFileSearch as character no-undo.
      526        define variable vNumEntry   as integer no-undo.
      527        if inFile = "" then return ?.
      528        vNumEntry = num-entries(inFile,".").
      529        vFileSearch = inFile.
      530        if    vNumEntry > 0
      531           and (   entry(vNumEntry,inFile,".") eq "p"
      532                or entry(vNumEntry,inFile,".") eq "w")
      533        then do:
      534           entry(vNumEntry,vFileSearch, ".") = "r".
      535           oFile = search(vFileSearch ).
      536           if oFile eq ?
      537           then
      538              oFile = search(inFile).
      539        end.
      540        else
      541           oFile = search(vFileSearch).
      542        return oFile.
      543     end.
      544   define new global shared variable g#library  as handle no-undo .
      545   define new global shared variable g#library2 as handle no-undo .
      546   define   shared variable g#auto as logical no-undo.
      547   define   shared variable g#news as logical no-undo.
      548   define   shared variable g#oxml as logical no-undo.
      549   define   shared variable g#esys as logical no-undo.
      550   define   shared variable g#news-source-db as integer no-undo.
      551   define   shared variable g#esys-source-esys as integer no-undo.
      552   define   shared variable g#db-num as integer   no-undo .
      553   define   shared variable g#userid as character no-undo .
      554   define   shared variable g#passwd as character no-undo .
      555   define variable vFileReq1     as character no-undo.
      556   define variable vFileReq2     as character no-undo.
      557   define variable vFileReq3     as character no-undo.
      558   define variable vFileReq4     as character no-undo.
      559   define variable vFileReqPathArh1 as character no-undo.
      560   define variable vFileReqPathArh2 as character no-undo.
      561   define variable vFileReqPathArh3 as character no-undo.
      562   define variable vFileReqPathArh4 as character no-undo.
      563   define variable vFileReqPath1 as character no-undo.
      564   define variable vFileReqPath2 as character no-undo.
      565   define variable vFileReqPath3 as character no-undo.
      566   define variable vFileReqPath4 as character no-undo.
      567   define variable vFileArh     as character no-undo.
      568   define variable vFolderPath  as character no-undo.
      569   define variable vArchPath    as character no-undo.
      570   define variable vFileArhPath as character no-undo.
      571   define variable vArhName     as character no-undo.
      572   define variable vMyWorkDir   as character no-undo.
      573   define variable vFolder      as character no-undo.
      574   define variable vPathFolder  as character no-undo.
      575   define variable vDirDelim    as character no-undo init "\":u.
      576   define variable vPref        as character no-undo.
      577   define stream FLStream.
      578   define variable vDelFileName as character no-undo.
      579   define variable vDelFullName as character no-undo.
      580   define variable vDelFileType as character no-undo.
      581   define variable vZipName     as character no-undo.
      582   define variable vZipDate     as date      no-undo.
      583   define variable vNumDate     as integer   no-undo.
      584   define variable vZipDateChar as character no-undo.
      585   define variable vFolderCash  as character no-undo.
      586   define variable vDate as date no-undo.
      587   define buffer for-cash-desk for ub.cash-desk.
      588   assign
      589      vDate     = today - 1
      590      vFileReq1 = "GisMtReq-" + replace(string(vDate),"/","-") + ".log"
      591      vFileReq2 = "GisMtCDN-" + replace(string(vDate),"/","-") + ".log"
      592      vFileReq3 = "sktsrv-" + replace(string(vDate),"/","-") + ".log"
      593      vFileReq4 = "GisMtOffLine-" + replace(string(vDate),"/","-") + ".log"
      594      vFolder   = "Архивы взаимодействия с ГИС МТ"
      595      vPref  = "Архив взаимодействия с ГИС МТ - "
      596      vArhName = vPref + replace(string(vDate),"/","-")
      597      vNumDate  = 93
      598      .
      599   vFileReqPath1 = searchFile(vFileReq1).
      600   vFileReqPath2 = searchFile(vFileReq2).
      601   vFileReqPath3 = searchFile(vFileReq3).
      602   vFileReqPath4 = searchFile(vFileReq4).
      603   if vFileReqPath1 <> ? then do:
      604       assign
      605          vMyWorkDir = substring(vFileReqPath1,1,index(vFileReqPath1,vFileReq1) - 1)
      606          vFolderPath  = vMyWorkDir + vFolder
      607          vArchPath    = vFolderPath + vDirDelim + vArhName
      608          .
      609       entry(num-entries(vMyWorkDir,vDirDelim),vMyWorkDir,vDirDelim) = "".
      610       if objExists(vFolderPath,"D") eq ?
      611          then os-create-dir VALUE(vFolderPath).
      612       if objExists(vArchPath,"D") eq ?
      613          then os-create-dir VALUE(vArchPath).
      614       assign
      615          vFileReqPathArh1 = vArchPath + vDirDelim + vFileReq1
      616          vFileReqPathArh2 = vArchPath + vDirDelim + vFileReq2
      617          vFileReqPathArh3 = vArchPath + vDirDelim + vFileReq3
      618          vFileReqPathArh4 = vArchPath + vDirDelim + vFileReq4
      619          vFileArh         = vArchPath + ".zip"
      620          .
      621       copy-lob from file(vFileReqPath1) to file(vFileReqPathArh1) no-error.
      622       run write-to-log( substitute("Архивирование лога &1.log",
      623                                    entry(1,vFileReqPath1,"."))).
      624       if vFileReqPath2 <> ? then do:
      625          copy-lob from file(vFileReqPath2) to file(vFileReqPathArh2) no-error.
      626          run write-to-log( substitute("Архивирование лога &1.log",
      627                                       entry(1,vFileReqPath2,"."))).
      628       end.
      629       if vFileReqPath3 <> ? then do:
      630          copy-lob from file(vFileReqPath3) to file(vFileReqPathArh3) no-error.
      631          run write-to-log( substitute("Архивирование лога &1.log",
      632                                       entry(1,vFileReqPath3,"."))).
      633       end.
      634       if vFileReqPath4 <> ? then do:
      635          copy-lob from file(vFileReqPath4) to file(vFileReqPathArh4) no-error.
      636          run write-to-log( substitute("Архивирование лога &1.log",
      637                                       entry(1,vFileReqPath4,"."))).
      638       end.
      639       run utl\arh7z.p(quoter(vFileArh),quoter(vArchPath)).
      640       vFileArhPath = searchFile(vFileArh).
      641       if vFileArhPath <> ?
      642       then do:
      643          run write-to-log( substitute("Создан временный каталог для архивирования &1", vArchPath)) .
      644          run write-to-log( substitute("Создан архив &1.zip", entry(1,vFileArhPath,"."))) .
      645          os-delete value(vArchPath) recursive.
      646          if objExists(vArchPath,"D") = ?
      647          then  run write-to-log( "Временный каталог для архивирования удален" ) .
      648          else  run write-to-log( "Не удалось удалить временный каталог для архивирования" ) .
      649          os-delete value (vFileReqPath1) no-error .
      650          if searchFile(vFileReq1) = ?
      651          then  run write-to-log( "Лог проверки марок успешно удален" ) .
      652          else  run write-to-log( "Не удалось удалить лог проверки марок" ) .
      653          if vFileReqPath2 <> ? then do:
      654              os-delete value (vFileReqPath2) no-error .
      655              if searchFile(vFileReq2) = ?
      656              then  run write-to-log( "Лог опроса CDN площадок успешно удален" ) .
      657              else  run write-to-log( "Не удалось удалить лог опроса CDN площадок" ) .
      658          end.
      659          if vFileReqPath3 <> ? then do:
      660              os-delete value (vFileReqPath3) no-error .
      661              if searchFile(vFileReq3) = ?
      662              then  run write-to-log( "Лог сокет-сервера успешно удален" ) .
      663              else  run write-to-log( "Не удалось удалить лог сокет-сервера" ) .
      664          end.
      665          if vFileReqPath4 <> ? then do:
      666              os-delete value (vFileReqPath4) no-error .
      667              if searchFile(vFileReq4) = ?
      668              then  run write-to-log( "Лог проверки статуса ЛМ ЧЗ удален" ) .
      669          end.
      670       end.
      671       else run write-to-log( "Произошла ошибка при архивировании логов").
      672   end.
      673   vPathFolder = objExists(vFolder,"D").
      674   if vPathFolder <> ? then do:
      675       run DelOldArch (vPathFolder, vPref).
      676       for each for-cash-desk no-lock where
      677                for-cash-desk.db-num   eq g#db-num:
      678          assign
      679             vFolderCash = substitute("&1/&2",vFolder,for-cash-desk.cash-num).
      680             vPathFolder = objExists(vFolderCash,"D").
      681          if vPathFolder <> ? then
      682             run DelOldArch (vPathFolder,"GisMTreq").
      683       end.
      684   end.
      685   else run write-to-log( substitute("Не найден каталог архивов проверки марок &1", vFolder) ).
      686   procedure DelOldArch:
      687       define input param iPathFolder as character no-undo.
      688       define input param iPref as character no-undo.
      689       define variable vFileEx as char no-undo.
      690       input stream FLStream from os-dir (iPathFolder).
      691       repeat
      692          on error  undo, return
      693          on stop   undo, return
      694          :
      695          import stream FLStream vDelFileName vDelFullName vDelFileType.
      696          vFileEx = if num-entries(vDelFileName, ".") >= 2 then entry(num-entries(vDelFileName, "."),vDelFileName, ".") else "".
      697          if vDelFileType begins "F"
      698            and vDelFileName begins iPref
      699            and num-entries( vDelFileName, "." ) > 1
      700            and (vFileEx = "zip" or vFileEx = "gz")
      701          then do:
      702            assign
      703               vZipName = entry(1, vDelFileName, "." )
      704               vZipDate = ?
      705               .
      706            if num-entries(vZipName,"-") = 4 then
      707                vZipDate = date(entry(2,vZipName,"-") + "/" + entry(3,vZipName,"-") + "/" + entry(4,vZipName,"-")) no-error.
      708            else if num-entries(vZipName,"-") >= 2 then do:
      709                vZipDateChar = entry(2,vZipName,"-").
      710                vZipDate = date(substitute("&1/&2/&3",substring(vZipDateChar,7,2),substring(vZipDateChar,5,2),substring(vZipDateChar,1,4))) no-error.
      711            end.
      712            if vZipDate <> ? and (vDate - vZipDate + 1) >= vNumDate
      713            then do:
      714               run write-to-log( substitute("Удаление архива &1.&2", entry(1,vDelFullName,"."),vFileEx)) .
      715               os-delete value (vDelFullName) no-error .
      716               if searchFile(vDelFullName) = ?
      717               then  run write-to-log(substitute("Архив &1.&2 успешно удален", entry(1,vDelFullName,"."),vFileEx)) .
      718               else  run write-to-log( substitute("Не удалось удалить архив &1.&2", entry(1,vDelFullName,"."),vFileEx)) .
      719            end.
      720          end.
      721       end.
      722       input stream FLStream close.
      723   end procedure.
