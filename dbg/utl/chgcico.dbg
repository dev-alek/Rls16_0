        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":u .
        3   define variable vss-author      as character no-undo init "$Author$":u .
        4   define variable vss-date        as character no-undo init "$Date$":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        6   define variable vss-archive     as character no-undo init "$Archive$":u .
        7   define variable vss-description as character no-undo init "Подстановка поля clients.city в goods.alpha1" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define variable v-waitfram-action01         as character   no-undo .
      115   define variable v-waitfram-action02         as character   no-undo .
      116   define variable v-waitfram-action03         as character   no-undo .
      117   define variable mWaitFramTextBeg            as character   no-undo.
      118   define variable mWaitFramTextEnd            as character   no-undo.
      119   define variable mWaitFramView               as logical     no-undo.
      120   define variable mWaitProcEvent              as logical     no-undo init yes.
      121   define variable mWaitFramInterval           as integer     no-undo init 1 .
      122   define variable mWaitFramStop               as logical     no-undo.
      123   define variable mWaitFramStopUser           as logical     no-undo.
      124   define variable mWaitFramStopTimeOut        as logical     no-undo.
      125   define variable mWaitFramStartProc          as datetime-tz no-undo.
      126   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      127   define button B-WaitFramStop auto-end-key
      128        label "Стоп"
      129        size 10 by 1 tooltip "Остоновить процесс".
      130   define button B-viewProcInfo
      131        label "Информация"
      132        size 15 by 1 tooltip "Информация о процесс".
      133   define frame waitfram
      134     v-waitfram-action01 format "x(72)" no-label skip
      135     v-waitfram-action02 format "x(72)" no-label skip
      136     v-waitfram-action03 format "x(72)" no-label skip
      137     B-viewProcInfo
      138     B-WaitFramStop at row 4 col 30
      139     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      140     .
      141   define new global shared variable mBatchMode as logical no-undo init ?.
      142   define variable mFramBachModHandle as handle no-undo.
      143   mFramBachModHandle = frame waitfram:handle.
      144   define variable mFameOldVis as logical no-undo.
      145   define variable mVisCUrentVin as logical no-undo.
      146   if session:batch-mode
      147   then
      148      mBatchMode = yes.
      149   if mBatchMode = ? then do:
      150     mVisCUrentVin = current-window:visible.
      151     mFameOldVis = mFramBachModHandle:visible.
      152     mFramBachModHandle:visible  = yes.
      153     mBatchMode = mFramBachModHandle:visible ne yes.
      154     mFramBachModHandle:visible = mFameOldVis.
      155     current-window:visible = mVisCUrentVin.
      156   end.
      157    if  log-manager:logfile-name ne ?
      158     then DO:
      159         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      160         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      161         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      162     end.
      163   on choose of B-WaitFramStop in frame waitfram
      164   do:
      165     mWaitFramStop = yes.
      166     mWaitFramStopUser = yes.
      167   end.
      168   function waitfram-check-timeout returns logical():
      169      define variable vtime as int64 no-undo.
      170      if mWaitFramStopTimeOut
      171      then
      172         return yes.
      173      vtime = ( now - mWaitFramStartProc ) / 1000 .
      174      if     mWaitFramTimeOut ne ?
      175         and mWaitFramTimeOut ne 0
      176         and mWaitFramTimeOut lt vtime
      177      then do:
      178         mWaitFramStopTimeOut = yes.
      179      end.
      180      return mWaitFramStopTimeOut.
      181   end.
      182   procedure waitfram-hide :
      183     if not session:batch-mode
      184     then do
      185     on error undo, return error return-value
      186     :
      187       pause 0 before-hide .
      188       if not mBatchMode then
      189         hide frame waitfram .
      190     if     not mWaitFramView
      191        and mWaitProcEvent
      192     then
      193       process events .
      194     end.
      195   end procedure.
      196   procedure waitfram-show :
      197     define input  parameter p-message as character no-undo .
      198     define variable v-left-margin as integer   no-undo .
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       if length(p-message) <= 70 then do:
      204         assign
      205           v-left-margin = integer((70 - length(p-message)) / 2)
      206         .
      207         assign
      208           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      209         .
      210         assign
      211           v-waitfram-action01 = " "
      212           v-waitfram-action02 = " "
      213                                    + fill(" ", v-left-margin)
      214                                    + p-message
      215           v-waitfram-action03 = " "
      216         .
      217       end.
      218       else do:
      219         define variable vRindex1 as integer no-undo.
      220         define variable vRindex2 as integer no-undo.
      221         vRindex1 = r-index(p-message," ",70).
      222         if vRindex1 = 0
      223         then
      224            vRindex1 = 70.
      225         if length(p-message)  <= vRindex1 + 70 then do:
      226           assign
      227             v-waitfram-action01 = " "
      228             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      229             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      230           .
      231         end.
      232         else do:
      233           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      234           if vRindex2 <= vRindex1
      235           then
      236              vRindex2 = vRindex1 + 70.
      237           assign
      238             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      239             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      241           .
      242         end.
      243       end.
      244       B-viewProcInfo:visible   in frame waitfram = no.
      245       B-viewProcInfo:sensitive in frame waitfram = no.
      246       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      247       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      248       if  (   mWaitFramView
      249          or  mWaitProcEvent)
      250          and not mBatchMode
      251       then
      252          display
      253             v-waitfram-action01 skip
      254             v-waitfram-action02 skip
      255             v-waitfram-action03 skip
      256          with frame waitfram .
      257       if     mWaitFramView
      258          then do:
      259             if     mWaitFramInterval ne ?
      260                and not mBatchMode
      261             then
      262                wait-for go of frame waitfram pause mWaitFramInterval.
      263          end.
      264          else
      265             if     mWaitProcEvent
      266                and not mBatchMode
      267             then
      268                process events .
      269     end.
      270   end procedure.
      271      procedure waitfram-show-this:
      272         define input  parameter iInterval as int64 no-undo.
      273         define variable vtime as int64 no-undo.
      274         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      275         mWaitFramInterval = iInterval.
      276         run waitfram-show (substitute("&1&2 &3&4" ,
      277                                       mWaitFramTextBeg ,
      278                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      279                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      280                                       mWaitFramTextEnd
      281                                      )
      282                           ).
      283      end.
      284      procedure WaitFramRunPause:
      285         define input  parameter iInterval as dec no-undo.
      286         define variable vStart  as datetime-tz no-undo.
      287         define variable vend    as datetime-tz no-undo.
      288         define variable vint as int64 no-undo.
      289         define variable vOk as logical no-undo.
      290         vStart = now.
      291         vend   = vStart.
      292         publish "WaitFramPause" (iInterval,output vOk).
      293         vend   =  now.
      294         vint = vend - vStart.
      295         vint = iInterval - vint / 1000.
      296         if     not mWaitFramStop
      297            and (   vint > 0
      298                 or (    not vOk
      299                     and iInterval eq ?
      300                     )
      301                 )
      302         then
      303            run waitfram-show-this (iInterval).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and vint > 0
      309         then do:
      310            run gbl/pause.p (vint * 1000).
      311         end.
      312         if iInterval ne ?
      313         then
      314            publish "WaitFramStop".
      315         waitfram-check-timeout().
      316      end.
      317      procedure WaitFramWaitFor:
      318         define input  parameter iInterval as dec no-undo.
      319         assign
      320            mWaitFramStartProc   = now
      321            mWaitFramStopUser    = no
      322            mWaitFramStopTimeOut = no
      323         .
      324         block-wait:
      325         do while not mWaitFramStop:
      326            run WaitFramRunPause (iInterval).
      327            if  waitfram-check-timeout()
      328            then do:
      329               leave block-wait.
      330            end.
      331         end.
      332         run waitfram-hide.
      333      end.
      334   procedure waitfram-join :
      335     define input  parameter p-line-1  as character no-undo .
      336     define input  parameter p-line-2  as character no-undo .
      337     define input  parameter p-line-3  as character no-undo .
      338     define output parameter p-message as character no-undo .
      339     do
      340     on error undo, return error return-value
      341     :
      342       assign
      343         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      344                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      345                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      346       .
      347     end.
      348   end procedure.
      349   function waitfram-join-function returns character
      350     (input p-line-1 as character
      351     ,input p-line-2 as character
      352     ,input p-line-3 as character
      353     ).
      354     define variable v-message as character no-undo .
      355     run waitfram-join in this-procedure
      356       (input  p-line-1
      357       ,input  p-line-2
      358       ,input  p-line-3
      359       ,output v-message
      360       ) .
      361     return v-message .
      362   end function .
      363   define variable glog as logical no-undo .
      364   define variable v-curr-db-num like ub.db.db-num no-undo .
      365   DEFINE BUTTON B-Help
      366        LABEL "Помо&щь"
      367        SIZE 10 BY 1
      368        BGCOLOR 8 .
      369   DEFINE BUTTON b-quit AUTO-END-KEY
      370        LABEL "&Выход"
      371        SIZE 10 BY 1
      372        BGCOLOR 8 .
      373   DEFINE BUTTON B-sel
      374        LABEL "Обновить товары производителя"
      375        SIZE 30 BY 1.
      376   DEFINE VARIABLE RS-client-type AS CHARACTER INITIAL 'орг':U
      377        VIEW-AS RADIO-SET VERTICAL
      378        RADIO-BUTTONS
      379             "Организация", 'орг':U,
      380   "Физическое лицо", 'чел':U
      381        SIZE 19.13 BY 2.04 NO-UNDO.
      382   DEFINE QUERY BROWSE-1 FOR
      383         ub.clients,
      384         ub.firm SCROLLING.
      385   DEFINE QUERY BROWSE-2 FOR
      386         ub.clients,
      387         ub.person SCROLLING.
      388   DEFINE BROWSE BROWSE-1
      389     QUERY BROWSE-1 NO-LOCK DISPLAY
      390         ub.clients.obj-type
      391         ub.clients.obj-code
      392         ub.clients.obj-name
      393         ub.firm.city
      394       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10.25.
      395   DEFINE BROWSE BROWSE-2
      396     QUERY BROWSE-2 NO-LOCK DISPLAY
      397         clients.obj-type
      398         clients.obj-code
      399         clients.obj-name
      400         person.city
      401       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10.25.
      402   DEFINE FRAME Dialog-Frame
      403        b-quit AT ROW 1 COL 1
      404        B-sel AT ROW 1 COL 11
      405        B-Help AT ROW 1 COL 71
      406        RS-client-type AT ROW 3.29 COL 2.25 NO-LABEL
      407        BROWSE-1 AT ROW 6.33 COL 1.5
      408        BROWSE-2 AT ROW 6.33 COL 1.5
      409        "Тип производителя" VIEW-AS TEXT
      410             SIZE 17.75 BY .75 AT ROW 2.38 COL 2.5
      411             FGCOLOR 4
      412        SPACE(80.12) SKIP(13.74)
      413       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      414            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      415            TITLE "Подстановка поля clients.city в goods.alpha1"
      416            CANCEL-BUTTON b-quit.
      417   ASSIGN
      418          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      419          FRAME Dialog-Frame:HIDDEN           = TRUE.
      420   ASSIGN
      421          BROWSE-2:HIDDEN  IN FRAME Dialog-Frame            = TRUE.
      422   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      423   DO:
      424     APPLY "END-ERROR":U TO SELF.
      425   END.
      426   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      427   DO:
      428    define variable v-rid-list as character no-undo.
      429    define variable choice as integer no-undo.
      430    define variable num-rec as integer no-undo.
      431    define variable num-rec-ok as integer no-undo.
      432    def buffer b-goods for ub.goods.
      433    if not avail ub.clients then return no-apply.
      434    message "Выберите страну, которую выхотите подставить во все товары данного поставщика"
      435    view-as alert-box.
      436    run ref/countris.w ( input parparentproc
      437                  , input "b-sel"
      438                  , input-output v-rid-list ).
      439    if v-rid-list = '' then do:
      440           return no-apply.
      441    end.
      442    FIND FIRST ub.country WHERE recid (ub.country) = integer(v-rid-list) NO-LOCK.
      443    run gbl/d-askw.w (input "УТИЛИТА",
      444                 input ("Подстановка страны << " + ub.country.short-name +
      445                        ">>  во все товары производителя " +
      446                        ub.clients.obj-type + string(ub.clients.obj-code) + " " + ub.clients.obj-name),
      447                 input "|",
      448                 input "Подставить|Отказ",
      449                 input "|",
      450                 input 1,
      451                 input 2,
      452                 output choice).
      453    if choice = 2 then return no-apply.
      454    FOR EACH ub.goods NO-LOCK WHERE
      455             ub.goods.prod-type = ub.clients.obj-type AND
      456             ub.goods.prod-code = ub.clients.obj-code :
      457       num-rec = num-rec + 1.
      458       FIND FIRST b-goods where recid(b-goods) = recid(ub.goods) NO-ERROR.
      459       IF AVAIL b-goods then
      460       DO TRANSACTION:
      461       assign
      462       b-goods.alpha1 = ub.country.alpha1 no-error.
      463       END.
      464       IF error-status:error then do:
      465           run waitfram-hide in this-procedure .
      466           message "Не удалось изменить товар " ub.goods.artic "Поставщик" ub.goods.prod-type ub.goods.prod-code
      467           "Продолжить изменение товаров производителя"
      468           view-as alert-box ERROR buttons YES-NO update glog.
      469           if not glog then do:
      470               IF num-rec > num-rec-ok then
      471               message "Из выбранных " num-rec "товаров удалось отредактировать " num-rec-ok.
      472               return.
      473           end.
      474       end.
      475       else num-rec-ok = num-rec-ok + 1.
      476       if num-rec modulo 10 = 0 then do:
      477           run waitfram-show in this-procedure
      478             (input "Обработано " + string(num-rec) + " из них удачно " + string(num-rec-ok)
      479             ).
      480       end.
      481    end.
      482    run waitfram-hide in this-procedure .
      483    IF num-rec > num-rec-ok then
      484    message "Из выбранных " num-rec
      485           "товаров удалось отредактировать " num-rec-ok.
      486    else
      487    message "Пакетное изменение страны производителя для товаров производителя "
      488            ub.clients.obj-type ub.clients.obj-code ub.clients.obj-name
      489            " прошло успешно".
      490   END.
      491   ON VALUE-CHANGED OF RS-client-type IN FRAME Dialog-Frame
      492   DO:
      493     assign RS-client-type.
      494     CASE RS-client-type:
      495       WHEN 'орг':U then do:
      496         HIDE browse-2 IN FRAME Dialog-Frame.
      497         DISPLAY BROWSE-1 WITH FRAME Dialog-Frame.
      498       END.
      499       WHEN 'чел':U then do:
      500         HIDE browse-1 IN FRAME Dialog-Frame.
      501         DISPLAY BROWSE-2 WITH FRAME Dialog-Frame.
      502       END.
      503     END CASE.
      504   END.
      505   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      506   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      507   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   on help of frame Dialog-Frame
      509   do:
      510     run gbl/app_help.p
      511       (input this-procedure :file-name
      512       ,input ''
      513       ,input ?
      514       ) no-error.
      515     if error-status :error then do:
      516       message
      517         "Ошибка при вызове помощи"
      518         error-status :get-message(1)
      519         view-as alert-box .
      520     end.
      521   end.
      522   run minbtn-set in this-procedure .
      523   on choose of b-help in frame Dialog-Frame
      524   do:
      525     apply "help":u to frame Dialog-Frame .
      526   end.
      527   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528   procedure minbtn-set :
      529       do
      530           on error undo, return error return-value
      531           :
      532           define variable ii              as integer       no-undo .
      533           define variable fh              as widget-handle no-undo .
      534           define variable hh              as widget-handle no-undo .
      535           define variable v-h             as handle        extent 4 no-undo .
      536           define variable v-name-button   as character     no-undo .
      537           define variable v-help-old-x    as decimal       no-undo .
      538           define variable v-help-old-y    as decimal       no-undo .
      539           define variable v-help-old-size as decimal       no-undo .
      540           define variable v-frame-width   as decimal       no-undo .
      541           define variable jj              as integer       no-undo .
      542           do
      543               on error undo, return error
      544               :
      545               assign
      546                   v-frame-width = frame Dialog-Frame:width - 0.3
      547                   fh            = frame Dialog-Frame:first-child
      548                   hh            = fh:first-child
      549                   ii            = 1
      550                   .
      551               do while valid-handle(hh):
      552                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      553                   do:
      554                       case lc(hh:name) :
      555                           when "b-help" then
      556                               do:
      557                                   hh:load-image-up("cmp/b-help.bmp":u) .
      558                                   hh:load-image-down("cmp/b-help.bmp":u) .
      559                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      560                                   hh:TOOLTIP = "Помощь" .
      561                                   v-help-old-x = hh:column .
      562                                   v-help-old-y = hh:row    .
      563                                   v-help-old-size = hh:width .
      564                                   hh:width-chars = 2.5 .
      565                               end.
      566                           when "b-print" then
      567                               do:
      568                                   hh:load-image("cmp/b-print.bmp":u) .
      569                                   hh:TOOLTIP = "Печать" .
      570                                   v-h[ii] = hh:handle .
      571                                   ii = ii + 1 .
      572                                   hh:width-chars = 3 .
      573                               end.
      574                           when "b-history" or
      575                           when "b-hist" then
      576                               do:
      577                                   hh:load-image("cmp/b-hist.bmp":u) .
      578                                   hh:TOOLTIP = "История" .
      579                                   v-h[ii] = hh:handle .
      580                                   ii = ii + 1 .
      581                                   hh:width-chars = 3 .
      582                               end.
      583                           when "b-sch" then
      584                               do:
      585                                   hh:load-image("cmp/b-sch.bmp":u) .
      586                                   hh:TOOLTIP = "Установка Фильтра" .
      587                                   v-h[ii] = hh:handle .
      588                                   ii = ii + 1 .
      589                                   hh:width-chars = 3 .
      590                               end.
      591                           when "b-hist-user" then
      592                               do:
      593                                   hh:load-image("cmp/b-hist.bmp":u) .
      594                                   hh:TOOLTIP = "История пользователя" .
      595                                   ii = ii + 1 .
      596                               end.
      597                       end case.
      598                   end.
      599                   hh = hh:next-sibling.
      600               end.
      601               b-help:column = v-frame-width - b-help:width-chars.
      602               jj = 0.
      603               repeat ii = 4 to 1 by -1 :
      604                   if valid-handle (v-h[ii] ) then
      605                   do:
      606                       jj  = jj + 1 .
      607                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      608                       v-h[ii]:row    = v-help-old-y .
      609                   end.
      610               end.
      611           end.
      612       end.
      613   end procedure.
      614   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      615   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      616   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      617   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      618   define variable v-diasize-current-frame-width  as decimal   no-undo .
      619   define variable v-diasize-current-frame-height as decimal   no-undo .
      620   define variable v-diasize-change-size          as logical   no-undo .
      621   define variable v-diasize-resize-button        as handle    no-undo .
      622   define variable v-diasize-wndmax               as logical   no-undo .
      623   define variable v-diasize-wndstore             as logical   no-undo .
      624   define variable v-diasize-proc-name            as character no-undo .
      625   define variable v-diasize-browse-handle        as handle    no-undo .
      626   define variable v-diasize-browse-number        as integer   no-undo .
      627   define variable v-diasize-need-full-display    as logical   no-undo init false .
      628   define temp-table temp-diasize-handle no-undo
      629     field handle-value  as handle
      630     field save-position as decimal
      631     index xpk is primary unique handle-value
      632     .
      633   define temp-table temp-browse-handle no-undo
      634     field browse-type   as character
      635     field browse-number as integer
      636     field browse-handle as handle
      637     field original-size as decimal
      638     index xpk is primary unique browse-type browse-number
      639     index xie browse-type browse-handle
      640   .
      641   procedure diasize_change-height :
      642     define input  parameter p-change-value  as decimal   no-undo .
      643     define input  parameter p-move-resize   as logical   no-undo .
      644     define variable v-field-group-handle    as handle    no-undo .
      645     define variable v-object-handle         as handle    no-undo .
      646     define variable v-frame-height          as decimal   no-undo .
      647     define variable v-frame-virtual-height  as decimal   no-undo .
      648     define variable v-browse-height         as decimal   no-undo .
      649     define variable v-window-height         as decimal   no-undo .
      650     define variable v-window-virtual-height as decimal   no-undo .
      651     define variable v-change-sign           as integer   no-undo .
      652     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      653     define buffer buf_temp-browse-handle  for temp-browse-handle .
      654     if p-change-value > 0
      655     then do:
      656       if frame Dialog-Frame :height + p-change-value
      657           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      658       then do:
      659         assign
      660           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      661                           - (frame Dialog-Frame :height-chars)
      662         .
      663         if p-change-value <= 0
      664         then do:
      665           run diasize_position-resize-button in this-procedure .
      666           return .
      667         end.
      668       end.
      669     end.
      670     if p-change-value < 0
      671     then do:
      672       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      673       then do:
      674         assign
      675           p-change-value = v-diasize-orig-frame-height
      676                          - (frame Dialog-Frame :height-chars)
      677         .
      678         if p-change-value >= 0
      679         then do:
      680           run diasize_position-resize-button in this-procedure .
      681           return .
      682         end.
      683       end.
      684     end.
      685     if p-change-value >= 0
      686     then do:
      687       assign
      688         v-change-sign = 1
      689       .
      690     end.
      691     else do:
      692       assign
      693         v-change-sign = -1
      694       .
      695     end.
      696     assign
      697       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      698     .
      699     if p-change-value = 0
      700     then do:
      701       run diasize_position-resize-button in this-procedure .
      702       return .
      703     end.
      704     move_block:
      705     do
      706     on error undo move_block, retry move_block
      707     :
      708       if retry
      709       then do:
      710         do
      711         on error undo move_block, leave move_block
      712         :
      713           if p-change-value > 0
      714           then do:
      715             for each buf_temp-diasize-handle
      716             on error undo, next
      717             :
      718               assign
      719                 v-object-handle = buf_temp-diasize-handle.handle-value
      720               .
      721               if v-object-handle <> v-diasize-resize-button
      722               then do:
      723                 assign
      724                   v-object-handle :row = buf_temp-diasize-handle.save-position
      725                 .
      726               end.
      727             end.
      728             assign
      729               v-diasize-browse-handle :height = v-browse-height
      730             .
      731             for each buf_temp-browse-handle
      732               where buf_temp-browse-handle.browse-type = 'height':u
      733             on error undo, next
      734             :
      735               assign
      736                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      737               .
      738             end.
      739             assign
      740               frame Dialog-Frame :height = v-frame-height
      741             .
      742             if frame Dialog-Frame :scrollable = true
      743             then do:
      744               assign
      745                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      746               .
      747             end.
      748             run diasize_position-resize-button in this-procedure .
      749           end.
      750           else do:
      751             if frame Dialog-Frame :scrollable = true
      752             then do:
      753               assign
      754                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      755               .
      756             end.
      757             assign
      758               frame Dialog-Frame :height = v-frame-height
      759             .
      760             assign
      761               v-diasize-browse-handle :height = v-browse-height
      762             .
      763             for each buf_temp-browse-handle
      764               where buf_temp-browse-handle.browse-type = 'height':u
      765             on error undo, next
      766             :
      767               assign
      768                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      769               .
      770             end.
      771             for each buf_temp-diasize-handle
      772             on error undo, next
      773             :
      774               assign
      775                 v-object-handle = buf_temp-diasize-handle.handle-value
      776               .
      777               if v-object-handle <> v-diasize-resize-button
      778               then do:
      779                 assign
      780                   v-object-handle :row = buf_temp-diasize-handle.save-position
      781                 .
      782               end.
      783             end.
      784             run diasize_position-resize-button in this-procedure .
      785           end.
      786           assign
      787             v-diasize-change-size = false
      788           .
      789           leave move_block .
      790         end.
      791       end.
      792       assign
      793         v-diasize-need-full-display = true
      794       .
      795       if v-diasize-change-size = false
      796       then do:
      797         assign
      798           v-diasize-change-size = true
      799         .
      800       end.
      801       else do:
      802         return .
      803       end.
      804       assign
      805         v-frame-height = frame Dialog-Frame :height
      806         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      807         v-browse-height = v-diasize-browse-handle :height
      808       .
      809       for each buf_temp-browse-handle
      810         where buf_temp-browse-handle.browse-type = 'height':u
      811       :
      812         assign
      813           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      814         .
      815       end.
      816       for each buf_temp-diasize-handle
      817       :
      818         delete buf_temp-diasize-handle .
      819       end.
      820       assign
      821         v-field-group-handle = frame Dialog-Frame :first-child
      822       .
      823       do while valid-handle(v-field-group-handle)
      824       :
      825         assign
      826           v-object-handle = v-field-group-handle :first-child
      827         .
      828         do while valid-handle(v-object-handle)
      829         :
      830           if  v-object-handle <> v-diasize-browse-handle :handle
      831           and can-query(v-object-handle, "row")
      832           and can-query(v-object-handle, "height")
      833           and ( v-object-handle :row > v-diasize-browse-handle :row )
      834           then do:
      835             find first buf_temp-browse-handle
      836               where buf_temp-browse-handle.browse-type   = 'height':u
      837                 and buf_temp-browse-handle.browse-handle = v-object-handle
      838               no-error .
      839             if available buf_temp-browse-handle
      840             then do:
      841             end.
      842             else do:
      843               create buf_temp-diasize-handle .
      844               assign
      845                 buf_temp-diasize-handle.handle-value  = v-object-handle
      846                 buf_temp-diasize-handle.save-position = v-object-handle :row
      847               .
      848             end.
      849           end.
      850           assign
      851             v-object-handle = v-object-handle :next-sibling
      852           .
      853         end.
      854         assign
      855           v-field-group-handle = v-field-group-handle :next-sibling
      856         .
      857       end.
      858       do with frame Dialog-Frame
      859       :
      860         hide v-diasize-resize-button .
      861         assign
      862           v-diasize-resize-button :row    = 1
      863           v-diasize-resize-button :column = 1
      864         .
      865       end.
      866       if p-change-value > 0
      867       then do:
      868         if frame Dialog-Frame :scrollable = true
      869         then do:
      870           assign
      871             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      872             no-error .
      873           if error-status :error
      874           or error-status :get-message(1) <> ""
      875           then do:
      876             undo move_block, retry move_block .
      877           end.
      878         end.
      879         assign
      880           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      881           no-error .
      882         if error-status :error
      883         or error-status :get-message(1) <> ""
      884         then do:
      885           undo move_block, retry move_block .
      886         end.
      887         assign
      888           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      889           no-error .
      890         if error-status :error
      891         or error-status :get-message(1) <> ""
      892         then do:
      893           undo move_block, retry move_block .
      894         end.
      895         for each buf_temp-browse-handle
      896           where buf_temp-browse-handle.browse-type = 'height':u
      897         on error undo move_block, retry move_block
      898         :
      899           assign
      900             buf_temp-browse-handle.browse-handle :height
      901               = buf_temp-browse-handle.browse-handle :height + p-change-value
      902             no-error .
      903           if error-status :error
      904           or error-status :get-message(1) <> ""
      905           then do:
      906             undo move_block, retry move_block .
      907           end.
      908         end.
      909         for each buf_temp-diasize-handle
      910         on error undo move_block, retry move_block
      911         :
      912           assign
      913             v-object-handle = buf_temp-diasize-handle.handle-value
      914           .
      915           if v-object-handle <> v-diasize-resize-button
      916           then do:
      917             assign
      918               v-object-handle :row = v-object-handle :row + p-change-value
      919               no-error .
      920             if error-status :error
      921             or error-status :get-message(1) <> ""
      922             then do:
      923               undo move_block, retry move_block .
      924             end.
      925           end.
      926         end.
      927       end.
      928       else do:
      929         for each buf_temp-diasize-handle
      930         on error undo move_block, retry move_block
      931         :
      932           assign
      933             v-object-handle = buf_temp-diasize-handle.handle-value
      934           .
      935           if v-object-handle <> v-diasize-resize-button
      936           then do:
      937             assign
      938               v-object-handle :row = v-object-handle :row + p-change-value
      939               no-error .
      940             if error-status :error
      941             or error-status :get-message(1) <> ""
      942             then do:
      943               undo move_block, retry move_block .
      944             end.
      945           end.
      946         end.
      947         assign
      948           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      949           no-error .
      950         if error-status :error
      951         or error-status :get-message(1) <> ""
      952         then do:
      953           undo move_block, retry move_block .
      954         end.
      955         for each buf_temp-browse-handle
      956           where buf_temp-browse-handle.browse-type = 'height':u
      957         on error undo move_block, retry move_block
      958         :
      959           assign
      960             buf_temp-browse-handle.browse-handle :height
      961               = buf_temp-browse-handle.browse-handle :height + p-change-value
      962             no-error .
      963           if error-status :error
      964           or error-status :get-message(1) <> ""
      965           then do:
      966             undo move_block, retry move_block .
      967           end.
      968         end.
      969         assign
      970           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      971           no-error .
      972         if error-status :error
      973         or error-status :get-message(1) <> ""
      974         then do:
      975           undo move_block, retry move_block .
      976         end.
      977         if frame Dialog-Frame :scrollable = true
      978         then do:
      979           assign
      980             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      981             no-error .
      982           if error-status :error
      983           or error-status :get-message(1) <> ""
      984           then do:
      985             undo move_block, retry move_block .
      986           end.
      987         end.
      988       end.
      989       if p-move-resize = true
      990       then do:
      991         run diasize_position-resize-button in this-procedure .
      992       end.
      993       if v-diasize-wndstore = true
      994       then do:
      995         if connected("ub") = true
      996         then do:
      997           define variable v-cntxt-db-num        as integer   no-undo .
      998           define variable v-cntxt-userid        as character no-undo .
      999           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1000                                             , OUTPUT v-cntxt-userid
     1001                                             ) .
     1002           run gbl/wndsizew.p
     1003             (input  v-cntxt-db-num
     1004             ,input  v-cntxt-userid
     1005             ,input  v-diasize-proc-name
     1006             ,input  'height':u
     1007             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1008             ) .
     1009         end.
     1010       end.
     1011     end.
     1012     assign
     1013       v-diasize-change-size = false
     1014     .
     1015   end procedure.
     1016   procedure diasize_set-height :
     1017     define input  parameter p-new-height  as decimal   no-undo .
     1018     define input  parameter p-move-resize as logical   no-undo .
     1019     do
     1020     on error undo, return error return-value
     1021     :
     1022       run diasize_change-height in this-procedure
     1023         (input  (p-new-height - frame Dialog-Frame :height)
     1024         ,input  p-move-resize
     1025         ) .
     1026     end.
     1027   end procedure.
     1028   procedure diasize_change-width :
     1029     define input  parameter p-change-value as decimal   no-undo .
     1030     define input  parameter p-move-resize  as logical   no-undo .
     1031     define variable v-field-group-handle   as handle    no-undo .
     1032     define variable v-object-handle        as handle    no-undo .
     1033     define variable v-frame-width          as decimal   no-undo .
     1034     define variable v-frame-virtual-width  as decimal   no-undo .
     1035     define variable v-browse-width         as decimal   no-undo .
     1036     define variable v-window-width         as decimal   no-undo .
     1037     define variable v-window-virtual-width as decimal   no-undo .
     1038     define variable v-change-sign          as integer   no-undo .
     1039     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1040     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1041     if p-change-value > 0
     1042     then do:
     1043       if frame Dialog-Frame :width + p-change-value >
     1044           session :width-chars
     1045       then do:
     1046         assign
     1047           p-change-value = session :width-chars - frame Dialog-Frame :width
     1048         .
     1049         if p-change-value <= 0
     1050         then do:
     1051           run diasize_position-resize-button in this-procedure .
     1052           return .
     1053         end.
     1054       end.
     1055     end.
     1056     if p-change-value < 0
     1057     then do:
     1058       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1059       then do:
     1060         assign
     1061           p-change-value = v-diasize-orig-frame-width
     1062                          - frame Dialog-Frame :width
     1063         .
     1064         if p-change-value >= 0
     1065         then do:
     1066           run diasize_position-resize-button in this-procedure .
     1067           return .
     1068         end.
     1069       end.
     1070     end.
     1071     if p-change-value >= 0
     1072     then do:
     1073       assign
     1074         v-change-sign = 1
     1075       .
     1076     end.
     1077     else do:
     1078       assign
     1079         v-change-sign = -1
     1080       .
     1081     end.
     1082     assign
     1083       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1084     .
     1085     if p-change-value = 0
     1086     then do:
     1087       run diasize_position-resize-button in this-procedure .
     1088       return .
     1089     end.
     1090     move_block:
     1091     do
     1092     on error undo move_block, leave move_block
     1093     :
     1094       if retry
     1095       then do:
     1096         do
     1097         on error undo move_block, leave move_block
     1098         :
     1099           if p-change-value > 0
     1100           then do:
     1101             for each buf_temp-diasize-handle
     1102             on error undo, next
     1103             :
     1104               assign
     1105                 v-object-handle = buf_temp-diasize-handle.handle-value
     1106               .
     1107               if v-object-handle <> v-diasize-resize-button
     1108               then do:
     1109                 assign
     1110                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1111                 .
     1112               end.
     1113             end.
     1114             assign
     1115               v-diasize-browse-handle :width = v-browse-width
     1116             .
     1117             for each buf_temp-browse-handle
     1118               where buf_temp-browse-handle.browse-type = 'width':u
     1119             on error undo, next
     1120             :
     1121               assign
     1122                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1123               .
     1124             end.
     1125             assign
     1126               frame Dialog-Frame :width = v-frame-width
     1127             .
     1128             if frame Dialog-Frame :scrollable = true
     1129             then do:
     1130               assign
     1131                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1132               .
     1133             end.
     1134             run diasize_position-resize-button in this-procedure .
     1135           end.
     1136           else do:
     1137             if frame Dialog-Frame :scrollable = true
     1138             then do:
     1139               assign
     1140                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1141               .
     1142             end.
     1143             assign
     1144               frame Dialog-Frame :width = v-frame-width
     1145             .
     1146             for each buf_temp-browse-handle
     1147               where buf_temp-browse-handle.browse-type = 'width':u
     1148             on error undo, next
     1149             :
     1150               assign
     1151                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1152               .
     1153             end.
     1154             assign
     1155               v-diasize-browse-handle :width = v-browse-width
     1156             .
     1157             for each buf_temp-diasize-handle
     1158             on error undo, next
     1159             :
     1160               assign
     1161                 v-object-handle = buf_temp-diasize-handle.handle-value
     1162               .
     1163               if v-object-handle <> v-diasize-resize-button
     1164               then do:
     1165                 assign
     1166                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1167                 .
     1168               end.
     1169             end.
     1170             run diasize_position-resize-button in this-procedure .
     1171           end.
     1172           assign
     1173             v-diasize-change-size = false
     1174           .
     1175           leave move_block .
     1176         end.
     1177       end.
     1178       assign
     1179         v-diasize-need-full-display = true
     1180       .
     1181       if v-diasize-change-size = false
     1182       then do:
     1183         assign
     1184           v-diasize-change-size = true
     1185         .
     1186       end.
     1187       else do:
     1188         return .
     1189       end.
     1190       assign
     1191         v-frame-width = frame Dialog-Frame :width
     1192         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1193         v-browse-width = v-diasize-browse-handle :width
     1194       .
     1195       for each buf_temp-browse-handle
     1196         where buf_temp-browse-handle.browse-type = 'width':u
     1197       :
     1198         assign
     1199           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1200         .
     1201       end.
     1202       for each buf_temp-diasize-handle
     1203       :
     1204         delete buf_temp-diasize-handle .
     1205       end.
     1206       assign
     1207         v-field-group-handle = frame Dialog-Frame :first-child
     1208       .
     1209       do while valid-handle(v-field-group-handle)
     1210       :
     1211         assign
     1212           v-object-handle = v-field-group-handle :first-child
     1213         .
     1214         do while valid-handle(v-object-handle)
     1215         :
     1216           if  v-object-handle <> v-diasize-browse-handle :handle
     1217           and v-object-handle <> v-diasize-resize-button
     1218           and can-query(v-object-handle, "row")
     1219           and can-query(v-object-handle, "height")
     1220           and ( v-object-handle :col + v-object-handle :width
     1221                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1222               )
     1223           then do:
     1224             find first buf_temp-browse-handle
     1225               where buf_temp-browse-handle.browse-type   = 'width':u
     1226                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1227               no-error .
     1228             if available buf_temp-browse-handle
     1229             then do:
     1230             end.
     1231             else do:
     1232               create buf_temp-diasize-handle .
     1233               assign
     1234                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1235                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1236               .
     1237             end.
     1238           end.
     1239           assign
     1240             v-object-handle = v-object-handle :next-sibling
     1241           .
     1242         end.
     1243         assign
     1244           v-field-group-handle = v-field-group-handle :next-sibling
     1245         .
     1246       end.
     1247       do with frame Dialog-Frame
     1248       :
     1249         hide v-diasize-resize-button .
     1250         v-diasize-resize-button :row = 1.
     1251         v-diasize-resize-button :column = 1.
     1252       end.
     1253       if p-change-value > 0
     1254       then do:
     1255         if frame Dialog-Frame :scrollable = true
     1256         then do:
     1257           assign
     1258             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1259             no-error .
     1260           if error-status :error
     1261           or error-status :get-message(1) <> ""
     1262           then do:
     1263             undo move_block, retry move_block.
     1264           end.
     1265         end.
     1266         assign
     1267           frame Dialog-Frame :width = v-frame-width + p-change-value
     1268           no-error .
     1269         if error-status :error
     1270         or error-status :get-message(1) <> ""
     1271         then do:
     1272           undo move_block, retry move_block.
     1273         end.
     1274         assign
     1275           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1276         no-error .
     1277         if error-status :error
     1278         or error-status :get-message(1) <> ""
     1279         then do:
     1280           undo move_block, retry move_block.
     1281         end.
     1282         for each buf_temp-browse-handle
     1283           where buf_temp-browse-handle.browse-type = 'width':u
     1284         on error undo move_block, retry move_block
     1285         :
     1286           assign
     1287             buf_temp-browse-handle.browse-handle :width
     1288               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1289             no-error .
     1290           if error-status :error
     1291           or error-status :get-message(1) <> ""
     1292           then do:
     1293             undo move_block, retry move_block .
     1294           end.
     1295         end.
     1296         for each buf_temp-diasize-handle
     1297         on error undo move_block, retry move_block
     1298         :
     1299           assign
     1300             v-object-handle = buf_temp-diasize-handle.handle-value
     1301           .
     1302           if v-object-handle <> v-diasize-resize-button
     1303           then do:
     1304             assign
     1305               v-object-handle :col = v-object-handle :col + p-change-value
     1306               no-error .
     1307             if error-status :error
     1308             or error-status :get-message(1) <> ""
     1309             then do:
     1310               undo move_block, retry move_block .
     1311             end.
     1312           end.
     1313         end.
     1314       end.
     1315       else do:
     1316         for each buf_temp-diasize-handle
     1317         on error undo move_block, retry move_block
     1318         :
     1319           assign
     1320             v-object-handle = buf_temp-diasize-handle.handle-value
     1321           .
     1322           if v-object-handle <> v-diasize-resize-button
     1323           then do:
     1324             assign
     1325               v-object-handle :col = v-object-handle :col + p-change-value
     1326               no-error .
     1327             if error-status :error
     1328             or error-status :get-message(1) <> ""
     1329             then do:
     1330               undo move_block, retry move_block .
     1331             end.
     1332           end.
     1333         end.
     1334         for each buf_temp-browse-handle
     1335           where buf_temp-browse-handle.browse-type = 'width':u
     1336         on error undo move_block, retry move_block
     1337         :
     1338           assign
     1339             buf_temp-browse-handle.browse-handle :width
     1340               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1341             no-error .
     1342           if error-status :error
     1343           or error-status :get-message(1) <> ""
     1344           then do:
     1345             undo move_block, retry move_block .
     1346           end.
     1347         end.
     1348         assign
     1349           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1350           no-error .
     1351         if error-status :error
     1352         or error-status :get-message(1) <> ""
     1353         then do:
     1354           undo move_block, retry move_block.
     1355         end.
     1356         assign
     1357           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1358         no-error .
     1359         if error-status :error
     1360         or error-status :get-message(1) <> ""
     1361         then do:
     1362           undo move_block, retry move_block.
     1363         end.
     1364         if frame Dialog-Frame :scrollable = true
     1365         then do:
     1366           assign
     1367             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1368           no-error .
     1369           if error-status :error
     1370           or error-status :get-message(1) <> ""
     1371           then do:
     1372             undo move_block, retry move_block.
     1373           end.
     1374         end.
     1375       end.
     1376       if p-move-resize
     1377       then do:
     1378         run diasize_position-resize-button in this-procedure .
     1379       end.
     1380       if v-diasize-wndstore = true
     1381       then do:
     1382         if connected("ub") = true
     1383         then do:
     1384           define variable v-cntxt-db-num        as integer   no-undo .
     1385           define variable v-cntxt-userid        as character no-undo .
     1386           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1387                                             , OUTPUT v-cntxt-userid
     1388                                             ) .
     1389           run gbl/wndsizew.p
     1390             (input  v-cntxt-db-num
     1391             ,input  v-cntxt-userid
     1392             ,input  v-diasize-proc-name
     1393             ,input  'width':u
     1394             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1395             ) .
     1396         end.
     1397       end.
     1398     end.
     1399     assign
     1400       v-diasize-change-size = false
     1401     .
     1402   end procedure.
     1403   procedure diasize_set-width :
     1404     define input  parameter p-new-width  as decimal   no-undo .
     1405     define input  parameter p-move-resize as logical   no-undo .
     1406     do
     1407     on error undo, return error return-value
     1408     :
     1409       run diasize_change-width in this-procedure
     1410         (input  (p-new-width - frame Dialog-Frame :width)
     1411         ,input  p-move-resize
     1412         ) .
     1413     end.
     1414   end procedure.
     1415   procedure diasize_position-resize-button :
     1416     do with frame Dialog-Frame
     1417     :
     1418       hide v-diasize-resize-button .
     1419       assign
     1420         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1421                     - 1
     1422                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1423         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1424                     - 1
     1425                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1426       .
     1427       view v-diasize-resize-button .
     1428     end.
     1429   end procedure.
     1430   on alt-right anywhere
     1431   do:
     1432     run diasize_change-width in this-procedure
     1433       (input 1
     1434       ,input true
     1435       ) .
     1436     return no-apply .
     1437   end.
     1438   on alt-left anywhere
     1439   do:
     1440     run diasize_change-width in this-procedure
     1441       (input -1
     1442       ,input true
     1443       ) .
     1444     return no-apply .
     1445   end.
     1446   on alt-down anywhere
     1447   do:
     1448     run diasize_change-height in this-procedure
     1449       (input 1
     1450       ,input true
     1451       ) .
     1452     return no-apply .
     1453   end.
     1454   on alt-up anywhere
     1455   do:
     1456     run diasize_change-height in this-procedure
     1457       (input -1
     1458       ,input true
     1459       ) .
     1460     return no-apply .
     1461   end.
     1462   on alt-enter of frame Dialog-Frame
     1463   do:
     1464     run diasize_maximize in this-procedure
     1465       (input  ?
     1466       ).
     1467     return no-apply .
     1468   end.
     1469   procedure diasize_end-move :
     1470     do
     1471     on error undo, return error return-value
     1472     :
     1473       define variable v-row-delta as decimal   no-undo .
     1474       define variable v-col-delta as decimal   no-undo .
     1475       define variable v-new-row as decimal   no-undo .
     1476       define variable v-new-col as decimal   no-undo .
     1477       assign
     1478         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1479         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1480       .
     1481       assign
     1482         v-row-delta = v-new-row - frame Dialog-Frame :height
     1483         v-col-delta = v-new-col - frame Dialog-Frame :width
     1484       .
     1485       run diasize_change-height in this-procedure
     1486         (input v-row-delta
     1487         ,input true
     1488         ) .
     1489       run diasize_change-width in this-procedure
     1490         (input v-col-delta
     1491         ,input true
     1492         ) .
     1493     end.
     1494   end procedure.
     1495   procedure diasize_maximize :
     1496     define input  parameter p-action as logical   no-undo .
     1497     do
     1498     on error undo, return error return-value
     1499     :
     1500       if p-action = ?
     1501       then do:
     1502         if v-diasize-need-maximize = true
     1503         then do:
     1504           assign
     1505             p-action = true
     1506           .
     1507         end.
     1508         else do:
     1509           assign
     1510             p-action = false
     1511           .
     1512         end.
     1513       end.
     1514       if p-action = true
     1515       then do:
     1516         run diasize_change-height in this-procedure
     1517           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1518               - frame Dialog-Frame :height-chars
     1519           ,input true
     1520           ) .
     1521         run diasize_change-width in this-procedure
     1522           (input session :width-chars
     1523               - frame Dialog-Frame :width-chars
     1524           ,input true
     1525           ) .
     1526         assign
     1527           v-diasize-need-maximize = false
     1528         .
     1529       end.
     1530       else do:
     1531         run diasize_change-width in this-procedure
     1532           (input v-diasize-orig-frame-width
     1533               - frame Dialog-Frame :width-chars
     1534           ,input true
     1535           ) .
     1536         run diasize_change-height in this-procedure
     1537           (input v-diasize-orig-frame-height
     1538               - frame Dialog-Frame :height-chars
     1539           ,input true
     1540           ) .
     1541         assign
     1542           v-diasize-need-maximize = true
     1543         .
     1544       end.
     1545     end.
     1546   end procedure.
     1547   procedure diasize_restore-orig-size :
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551       assign
     1552         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1553         v-diasize-current-frame-height = frame Dialog-Frame :height
     1554       .
     1555       run diasize_set-height in this-procedure
     1556         (input  v-diasize-orig-frame-height
     1557         ,input  true
     1558         ) .
     1559       run diasize_set-width in this-procedure
     1560         (input  v-diasize-orig-frame-width
     1561         ,input  true
     1562         ) .
     1563     end.
     1564   end procedure.
     1565   procedure diasize_restore-current-size :
     1566     do
     1567     on error undo, return error return-value
     1568     :
     1569       run diasize_set-height in this-procedure
     1570         (input  v-diasize-current-frame-height
     1571         ,input  true
     1572         ) .
     1573       run diasize_set-width in this-procedure
     1574         (input  v-diasize-current-frame-width
     1575         ,input  true
     1576         ) .
     1577     end.
     1578   end procedure.
     1579   procedure diasize_set-browse-handle :
     1580     define input  parameter p-browse-handle as handle   no-undo .
     1581     define buffer buf_temp-browse-handle for temp-browse-handle .
     1582     do
     1583     on error undo, return error return-value
     1584     :
     1585       assign
     1586         v-diasize-browse-handle = p-browse-handle
     1587       .
     1588       for each buf_temp-browse-handle
     1589       on error undo, return error return-value
     1590       :
     1591         delete buf_temp-browse-handle .
     1592       end.
     1593     end.
     1594   end procedure.
     1595   procedure diasize_add_browse :
     1596     define input  parameter p-browse-type   as character no-undo .
     1597     define input  parameter p-browse-handle as handle    no-undo .
     1598     define buffer buf_temp-browse-handle for temp-browse-handle .
     1599     do
     1600     on error undo, return error return-value
     1601     :
     1602       assign
     1603         v-diasize-browse-number = v-diasize-browse-number + 1
     1604       .
     1605       create buf_temp-browse-handle .
     1606       assign
     1607         buf_temp-browse-handle.browse-type   = p-browse-type
     1608         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1609         buf_temp-browse-handle.browse-handle = p-browse-handle
     1610       .
     1611     end.
     1612   end procedure.
     1613   procedure diasize_init :
     1614     define variable v-default-value    as logical   no-undo .
     1615     define variable v-restore-saved    as logical   no-undo .
     1616     define variable v-resize-value-str as character no-undo .
     1617     do
     1618     on error undo, return error return-value
     1619     :
     1620       do with frame Dialog-Frame
     1621       :
     1622         assign
     1623           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1624           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1625           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1626         .
     1627         create button v-diasize-resize-button
     1628         assign
     1629           parent        = frame Dialog-Frame :first-child
     1630           label         = "s"
     1631           height-pixels = 16
     1632           width-pixels  = 16
     1633           visible       = true
     1634           sensitive     = true
     1635           movable       = true
     1636           triggers:
     1637             on end-move persistent run diasize_end-move in this-procedure .
     1638           end triggers.
     1639         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1640         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1641         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1642         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1643         assign
     1644           v-diasize-wndmax = false
     1645         .
     1646         if connected("ub") = true
     1647         then do:
     1648           define variable v-cntxt-db-num        as integer   no-undo .
     1649           define variable v-cntxt-userid        as character no-undo .
     1650           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1651                                             , OUTPUT v-cntxt-userid
     1652                                             ) .
     1653           run gbl/wndpar_r.p
     1654             (input  v-cntxt-db-num
     1655             ,input  v-cntxt-userid
     1656             ,input  'wndmax':U
     1657             ,output v-diasize-wndmax
     1658             ,output v-default-value
     1659             ) .
     1660         end.
     1661         assign
     1662           v-diasize-wndstore = false
     1663         .
     1664         if connected("ub") = true
     1665         then do:
     1666           run gbl/wndpar_r.p
     1667             (input  v-cntxt-db-num
     1668             ,input  v-cntxt-userid
     1669             ,input  'wndstore':U
     1670             ,output v-diasize-wndstore
     1671             ,output v-default-value
     1672             ) .
     1673         end.
     1674         assign
     1675           v-diasize-proc-name = entry(1, program-name(2), '.')
     1676         .
     1677         if v-diasize-wndstore = true
     1678         then do:
     1679           assign
     1680             v-restore-saved = false
     1681           .
     1682           if connected("ub") = true
     1683           then do:
     1684             run gbl/wndsizer.p
     1685               (input  v-cntxt-db-num
     1686               ,input  v-cntxt-userid
     1687               ,input  v-diasize-proc-name
     1688               ,input  'height':u
     1689               ,output v-resize-value-str
     1690               ) .
     1691             if v-resize-value-str <> '':U
     1692             then do:
     1693               run diasize_change-height in this-procedure
     1694                 (input  integer(v-resize-value-str)
     1695                 ,input  true
     1696                 ) .
     1697               assign
     1698                 v-restore-saved = true
     1699               .
     1700             end.
     1701           end.
     1702           if connected("ub") = true
     1703           then do:
     1704             run gbl/wndsizer.p
     1705               (input  v-cntxt-db-num
     1706               ,input  v-cntxt-userid
     1707               ,input  v-diasize-proc-name
     1708               ,input  'width':u
     1709               ,output v-resize-value-str
     1710               ) .
     1711             if v-resize-value-str <> '':U
     1712             then do:
     1713               run diasize_change-width in this-procedure
     1714                 (input  integer(v-resize-value-str)
     1715                 ,input  true
     1716                 ) .
     1717               assign
     1718                 v-restore-saved = true
     1719               .
     1720             end.
     1721           end.
     1722           if v-restore-saved <> true
     1723           then do:
     1724             if v-diasize-wndmax = true
     1725             then do:
     1726               run diasize_maximize in this-procedure
     1727                 (input  true
     1728                 ) .
     1729             end.
     1730           end.
     1731         end.
     1732         else do:
     1733           if v-diasize-wndmax = true
     1734           then do:
     1735             run diasize_maximize in this-procedure
     1736               (input  true
     1737               ) .
     1738           end.
     1739         end.
     1740       end.
     1741     end.
     1742   end procedure.
     1743   procedure diasize_need-full-display :
     1744     define output parameter p-need-full-display as logical   no-undo .
     1745     do
     1746     on error undo, return error return-value
     1747     :
     1748       assign
     1749         p-need-full-display = v-diasize-need-full-display
     1750       .
     1751       assign
     1752         v-diasize-need-full-display = false
     1753       .
     1754     end.
     1755   end procedure.
     1756   procedure get-context :
     1757      define output parameter p-db-num as integer          no-undo.
     1758      define output parameter p-user-id as character        no-undo.
     1759      define variable v-login               as character    no-undo.
     1760      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1761      define buffer buf_user-login  for ub.user-login .
     1762      do
     1763      on error undo, return error
     1764      :
     1765            FIND FIRST buf_sys-ctrl no-lock.
     1766            ASSIGN
     1767               v-login = USERID("ub")
     1768               p-db-num = buf_sys-ctrl.db-num
     1769            .
     1770            FIND FIRST buf_user-login
     1771                 WHERE buf_user-login.db-num = p-db-num
     1772                   AND buf_user-login.user-login = v-login
     1773                 no-lock
     1774                 no-error
     1775                 .
     1776            IF AVAILABLE buf_user-login
     1777            THEN DO:
     1778               assign
     1779                  p-user-id = buf_user-login.user-id
     1780               .
     1781            END.
     1782      end.
     1783   end procedure.
     1784       run diasize_init in this-procedure .
     1785   MAIN-BLOCK:
     1786   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1787      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1788   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1790     (output v-curr-db-num
     1791     )  .
     1792      FIND ub.db WHERE ub.db.db-num = v-curr-db-num NO-LOCK .
     1793      IF NOT ub.db.add-goods then do:
     1794           message "В данной БД не разрешено изменять товары!" view-as alert-box ERROR.
     1795           return.
     1796      end.
     1797     RUN enable_UI.
     1798     APPLY "VALUE-CHANGED" to RS-client-type.
     1799     WAIT-FOR GO OF FRAME Dialog-Frame.
     1800   END.
     1801   RUN disable_UI.
     1802   PROCEDURE disable_UI :
     1803     HIDE FRAME Dialog-Frame.
     1804   END PROCEDURE.
     1805   PROCEDURE enable_UI :
     1806     DISPLAY RS-client-type
     1807         WITH FRAME Dialog-Frame.
     1808     ENABLE b-quit B-sel B-Help RS-client-type BROWSE-1 BROWSE-2
     1809         WITH FRAME Dialog-Frame.
     1810     VIEW FRAME Dialog-Frame.
     1811     OPEN QUERY BROWSE-1 FOR EACH ub.clients       WHERE ub.clients.is-prod = TRUE  AND ub.clients.obj-type = 'орг':U NO-LOCK,       EACH ub.firm WHERE  ub.firm.firm-code = ub.clients.obj-code       AND ub.firm.city <> "" NO-LOCK.    OPEN QUERY BROWSE-2 FOR EACH ub.clients       WHERE ub.clients.is-prod = TRUE  AND ub.clients.obj-type = 'чел':U NO-LOCK,       EACH ub.person WHERE ub.person.psn-code = ub.clients.obj-code       AND ub.person.city <> "" NO-LOCK.
     1812   END PROCEDURE.
