        1   define input  parameter parparentproc as handle    no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Утилита коррекции даты на объекте".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#library  as handle no-undo .
      112   define new global shared variable g#library2 as handle no-undo .
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   function usrfulnf returns character ( input p-user-id as character):
      115   define variable v-user-name as character no-undo .
      116   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      118     (input  p-user-id
      119     ,output v-user-name
      120     ) no-error .
      121   if error-status:error
      122   or v-user-name = ""
      123   then do:
      124     return p-user-id.
      125   end.
      126   else do:
      127     return v-user-name.
      128   end.
      129   end function.
      130   DEFINE BUTTON b-exit AUTO-GO
      131        LABEL "&Выход"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON b-help
      135        LABEL "Помо&щь"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE BUTTON b-rollback
      139        LABEL "Запустить"
      140        SIZE 10 BY 1.
      141   DEFINE VARIABLE cb_status AS CHARACTER FORMAT "X(256)":U
      142        LABEL "Статус, на который поменять"
      143        VIEW-AS COMBO-BOX INNER-LINES 5
      144        LIST-ITEMS "факт","нередакт","разрешен"
      145        DROP-DOWN-LIST
      146        SIZE 21.5 BY 1 NO-UNDO.
      147   DEFINE VARIABLE p-rvs-num AS CHARACTER FORMAT "X(256)":U
      148        LABEL "Номер сверки"
      149        VIEW-AS FILL-IN
      150        SIZE 21.5 BY 1 NO-UNDO.
      151   DEFINE FRAME Dialog-Frame
      152        b-exit AT ROW 1 COL 1
      153        b-rollback AT ROW 1 COL 11
      154        b-help AT ROW 1 COL 61
      155        p-rvs-num AT ROW 3 COL 32.5 COLON-ALIGNED WIDGET-ID 2
      156        cb_status AT ROW 5 COL 32.5 COLON-ALIGNED WIDGET-ID 6
      157        SPACE(16.99) SKIP(6.62)
      158       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      159            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      160            TITLE "Изменение статуса сверки"
      161            DEFAULT-BUTTON b-exit.
      162   ASSIGN
      163          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      164          FRAME Dialog-Frame:HIDDEN           = TRUE.
      165   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      166   DO:
      167     APPLY "END-ERROR":U TO SELF.
      168   END.
      169   ON CHOOSE OF b-rollback IN FRAME Dialog-Frame
      170   DO:
      171   assign
      172   cb_status
      173   p-rvs-num
      174   .
      175   if p-rvs-num = "" then do :
      176       message ("Не заполнен номер сверки") view-as alert-box .
      177       return .
      178   end.
      179   if cb_status = "" then do :
      180       message ("Выберите статус, на который нужно перевести сверку") view-as alert-box .
      181       return .
      182   end.
      183   disable triggers for load of rvs-doc .
      184   find first rvs-doc exclusive-lock where rvs-doc.rvs-code = p-rvs-num no-error .
      185   if not available rvs-doc
      186   then do :
      187       message ("Не найдена сверка " + p-rvs-num) view-as alert-box .
      188   end.
      189   else do :
      190       rvs-doc.status_ = cb_status .
      191       message "Готово" view-as alert-box .
      192   end.
      193   END.
      194   ON VALUE-CHANGED OF cb_status IN FRAME Dialog-Frame
      195   DO:
      196     assign cb_status .
      197   END.
      198   ON LEAVE OF p-rvs-num IN FRAME Dialog-Frame
      199   DO:
      200     assign p-rvs-num .
      201   END.
      202   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      203   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      204   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   on help of frame Dialog-Frame
      206   do:
      207     run gbl/app_help.p
      208       (input this-procedure :file-name
      209       ,input ''
      210       ,input ?
      211       ) no-error.
      212     if error-status :error then do:
      213       message
      214         "Ошибка при вызове помощи"
      215         error-status :get-message(1)
      216         view-as alert-box .
      217     end.
      218   end.
      219   run minbtn-set in this-procedure .
      220   on choose of b-help in frame Dialog-Frame
      221   do:
      222     apply "help":u to frame Dialog-Frame .
      223   end.
      224   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   procedure minbtn-set :
      226       do
      227           on error undo, return error return-value
      228           :
      229           define variable ii              as integer       no-undo .
      230           define variable fh              as widget-handle no-undo .
      231           define variable hh              as widget-handle no-undo .
      232           define variable v-h             as handle        extent 4 no-undo .
      233           define variable v-name-button   as character     no-undo .
      234           define variable v-help-old-x    as decimal       no-undo .
      235           define variable v-help-old-y    as decimal       no-undo .
      236           define variable v-help-old-size as decimal       no-undo .
      237           define variable v-frame-width   as decimal       no-undo .
      238           define variable jj              as integer       no-undo .
      239           do
      240               on error undo, return error
      241               :
      242               assign
      243                   v-frame-width = frame Dialog-Frame:width - 0.3
      244                   fh            = frame Dialog-Frame:first-child
      245                   hh            = fh:first-child
      246                   ii            = 1
      247                   .
      248               do while valid-handle(hh):
      249                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      250                   do:
      251                       case lc(hh:name) :
      252                           when "b-help" then
      253                               do:
      254                                   hh:load-image-up("cmp/b-help.bmp":u) .
      255                                   hh:load-image-down("cmp/b-help.bmp":u) .
      256                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      257                                   hh:TOOLTIP = "Помощь" .
      258                                   v-help-old-x = hh:column .
      259                                   v-help-old-y = hh:row    .
      260                                   v-help-old-size = hh:width .
      261                                   hh:width-chars = 2.5 .
      262                               end.
      263                           when "b-print" then
      264                               do:
      265                                   hh:load-image("cmp/b-print.bmp":u) .
      266                                   hh:TOOLTIP = "Печать" .
      267                                   v-h[ii] = hh:handle .
      268                                   ii = ii + 1 .
      269                                   hh:width-chars = 3 .
      270                               end.
      271                           when "b-history" or
      272                           when "b-hist" then
      273                               do:
      274                                   hh:load-image("cmp/b-hist.bmp":u) .
      275                                   hh:TOOLTIP = "История" .
      276                                   v-h[ii] = hh:handle .
      277                                   ii = ii + 1 .
      278                                   hh:width-chars = 3 .
      279                               end.
      280                           when "b-sch" then
      281                               do:
      282                                   hh:load-image("cmp/b-sch.bmp":u) .
      283                                   hh:TOOLTIP = "Установка Фильтра" .
      284                                   v-h[ii] = hh:handle .
      285                                   ii = ii + 1 .
      286                                   hh:width-chars = 3 .
      287                               end.
      288                           when "b-hist-user" then
      289                               do:
      290                                   hh:load-image("cmp/b-hist.bmp":u) .
      291                                   hh:TOOLTIP = "История пользователя" .
      292                                   ii = ii + 1 .
      293                               end.
      294                       end case.
      295                   end.
      296                   hh = hh:next-sibling.
      297               end.
      298               b-help:column = v-frame-width - b-help:width-chars.
      299               jj = 0.
      300               repeat ii = 4 to 1 by -1 :
      301                   if valid-handle (v-h[ii] ) then
      302                   do:
      303                       jj  = jj + 1 .
      304                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      305                       v-h[ii]:row    = v-help-old-y .
      306                   end.
      307               end.
      308           end.
      309       end.
      310   end procedure.
      311   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   on F2 of frame Dialog-Frame anywhere do:
      313     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
      314     return no-apply.
      315   end.
      316   MAIN-BLOCK:
      317   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      318      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      319     RUN my-enable in this-procedure .
      320     WAIT-FOR GO OF FRAME Dialog-Frame.
      321   END.
      322   RUN disable_UI.
      323   PROCEDURE disable_UI :
      324     HIDE FRAME Dialog-Frame.
      325   END PROCEDURE.
      326   PROCEDURE enable_UI :
      327     DISPLAY p-rvs-num cb_status
      328         WITH FRAME Dialog-Frame.
      329     ENABLE b-exit b-help p-rvs-num cb_status
      330         WITH FRAME Dialog-Frame.
      331     VIEW FRAME Dialog-Frame.
      332   END PROCEDURE.
      333   PROCEDURE my-disable :
      334   END PROCEDURE.
      335   PROCEDURE my-enable :
      336     enable
      337       b-exit
      338       b-help
      339       cb_status
      340       p-rvs-num
      341       b-rollback
      342     with frame Dialog-Frame.
      343     view frame Dialog-Frame.
      344   END PROCEDURE.
