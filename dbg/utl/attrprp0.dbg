        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input parameter        p-table-name as character no-undo .
        5   define input parameter        p-templ-rl-root as integer no-undo .
        6   define temp-table tt-attr-prop no-undo like ub.attr-prop
        7   field full-prop-name as character
        8   .
        9   DEFINE INPUT PARAMETER TABLE FOR tt-attr-prop.
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: attrprp0.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: utl/attrprp0.p $":U .
       15   define variable vss-description as character no-undo init "Сохранение свойств для атрибута".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable v-mess as character no-undo .
       86   define variable v-ii as integer no-undo .
       87   define buffer buf_file  for ub._file.
       88   define buffer buf_field  for ub._field.
       89   define buffer buf_attr-prop for ub.attr-prop.
       90   if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       91     message vss-workfile vss-revision vss-description skip
       92             "Неверный параметр p-mode - " p-mode
       93     view-as alert-box error .
       94     return error '':u.
       95   end.
       96   if g#db-num <> 0 then do:
       97     message vss-workfile vss-revision vss-description skip
       98             "Запрещено вызывать процедуру в УБД"
       99     view-as alert-box error .
      100     return error '':u.
      101   end.
      102   _main:
      103   do
      104   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      105   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      106   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      107   :
      108     for each tt-attr-prop
      109     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      110     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      111     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      112     :
      113       if tt-attr-prop.prop-code = '':u then next.
      114       find first buf_attr-prop where
      115                 buf_attr-prop.table-name = p-table-name
      116             and buf_attr-prop.templ-rl-root = tt-attr-prop.templ-rl-root
      117             and buf_attr-prop.node-code = tt-attr-prop.node-code no-error .
      118       if not available buf_attr-prop then do:
      119          create buf_attr-prop.
      120          assign
      121          buf_attr-prop.table-name = 'dis-card-property':U
      122          buf_attr-prop.templ-rl-root = tt-attr-prop.templ-rl-root
      123          buf_attr-prop.prop-code = tt-attr-prop.prop-code
      124          buf_attr-prop.upper-prop-code = tt-attr-prop.upper-prop-code
      125          buf_attr-prop.node-code = tt-attr-prop.node-code
      126          buf_attr-prop.upper-node-code = tt-attr-prop.upper-node-code no-error .
      127          .
      128       end.
      129       assign
      130       buf_attr-prop.property-value = tt-attr-prop.property-value.
      131     end.
      132     for each buf_attr-prop
      133     where buf_attr-prop.templ-rl-root = p-templ-rl-root
      134       and buf_attr-prop.table-name = 'dis-card-property':U
      135     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      136     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      137     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      138     :
      139       find first tt-attr-prop where
      140                 tt-attr-prop.templ-rl-root = buf_attr-prop.templ-rl-root
      141             and tt-attr-prop.table-name = p-table-name
      142             and tt-attr-prop.node-code = buf_attr-prop.node-code  no-error .
      143       if not available tt-attr-prop then do:
      144         delete buf_attr-prop.
      145       end.
      146     end.
      147   end.
      148   PROCEDURE err-mess:
      149     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      150     CASE p-silent:
      151       when yes then do:
      152         assign
      153         p-mess = substitute("Запись свойств таблицы атриубтов &1&2" +
      154                             "код &3&2&4"
      155                             ,p-table-name
      156                             ,chr(10)
      157                             ,p-templ-rl-root
      158                             ,p-mess).
      159       end.
      160       when no then do:
      161         message
      162         p-mess
      163         view-as alert-box error .
      164       end.
      165     end.
      166   END PROCEDURE.
