        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO .
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define new global shared variable g#library  as handle no-undo .
        8   define new global shared variable g#library2 as handle no-undo .
        9   define   shared variable g#auto as logical no-undo.
       10   define   shared variable g#news as logical no-undo.
       11   define   shared variable g#oxml as logical no-undo.
       12   define   shared variable g#esys as logical no-undo.
       13   define   shared variable g#news-source-db as integer no-undo.
       14   define   shared variable g#esys-source-esys as integer no-undo.
       15   define   shared variable g#db-num as integer   no-undo .
       16   define   shared variable g#userid as character no-undo .
       17   define   shared variable g#passwd as character no-undo .
       18   define  shared stream vProtTest.
       19   define  shared variable testId as rowid no-undo.
       20   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
       21       then run str/lib-trn.p persistent no-error .
       22   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn2)
       23       then run str/lib-trn2.p persistent no-error .
       24   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
       25       then run str/lib-trn3.p persistent no-error .
       26   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn4)
       27       then run str/lib-trn4.p persistent no-error .
       28   // define temp-table tt-trn like ub.shift-obj .
       29   define buffer buf_shift-obj for ub.shift-obj .
       30   define variable v-obj-type as character no-undo .
       31   define variable v-obj-code as integer no-undo .
       32   define variable v-sht-date as date no-undo .
       33   define variable v-sht-num  as integer no-undo .
       34   define button btnOk auto-go label "Ok" .
       35   define button btnCancel auto-endkey label "Cancel".
       36   if testId ne ? then
       37   do:
       38     find first buf_shift-obj where rowid(buf_shift-obj) = testId no-lock no-error.
       39     if not avail buf_shift-obj then return.
       40   end.
       41   else
       42   do:
       43   DEFINE FRAME frame1
       44     skip
       45                      v-obj-code format ">>>>>>>>9"  label "Код магазина"
       46     skip    space(2) v-sht-date format "99/99/9999" label "Дата смены"
       47             space(2) v-sht-num                      label "Порядок смены"
       48     skip(1) space(2) btnOk
       49             space(2) btnCancel
       50     with
       51       side-labels
       52       default-button btnOk
       53       cancel-button btnCancel
       54       view-as dialog-box
       55       title "Введите номер код магазина, дату и номер смены"
       56   .
       57   update v-obj-code v-sht-date v-sht-num btnOk btnCancel with frame frame1.
       58   find first buf_shift-obj no-lock
       59        where buf_shift-obj.obj-type = 'маг'
       60          and buf_shift-obj.obj-code = v-obj-code
       61          and buf_shift-obj.shift-date = v-sht-date
       62          and buf_shift-obj.shift-num  = v-sht-num no-error .
       63   end.
       64   if not available (buf_shift-obj) then do:
       65       message substitute("Отсутствует смена №&1 от &2 в магазине &3",
       66                          v-sht-num, v-sht-date, v-obj-code) view-as alert-box.
       67       return.
       68   end.
       69   // buffer-copy trn-doc except trn-doc.status_ to tt-trn  assign tt-trn.status_ = "накл".
       70   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
       71     (input ?
       72     ,input this-procedure:handle
       73     ,input ?
       74     ,input 'event_shift':U
       75     ,input  buffer buf_shift-obj:handle
       76     ,input  buffer buf_shift-obj:handle
       77     ,input ''
       78     ,input ''
       79     ) no-error .
       80   if error-status:error then do :
       81     message "Ошибка маршрутизации записи в машину правил" skip return-value skip error-status:get-message(1) view-as alert-box.
       82   end.
       83   else do:
       84       define buffer buf_reportShift for ub.reportShift .
       85       find first buf_reportShift exclusive-lock where buf_reportShift.shift-date = buf_shift-obj.shift-date and
       86           buf_reportShift.shift-num = buf_shift-obj.shift-num and buf_reportShift.obj-code = buf_shift-obj.obj-code and
       87           buf_reportShift.obj-type = buf_shift-obj.obj-type and buf_reportShift.report-type = 1 no-error .
       88       if available (buf_reportShift) then
       89       do:
       90           run bge\send1cerp.p (parparentproc,
       91               this-procedure,
       92               this-procedure,
       93               "reportShift",
       94               (buffer buf_reportShift:handle),
       95               ?,
       96               ?) no-error.
       97           if  error-status:error then
       98           do:
       99               message return-value
      100                   view-as alert-box.
      101               return .
      102           end.
      103       end.
      104     if testId <> ? then
      105       put stream vProtTest unformatted
      106         substitute("Cмена №&1 от &2 в магазине &3 отправлена",
      107                    buf_shift-obj.shift-num, buf_shift-obj.shift-date, buf_shift-obj.obj-code)
      108         skip.
      109     else
      110       message substitute("Cмена №&1 от &2 в магазине &3 отправлена",
      111                        v-sht-num, v-sht-date, v-obj-code) view-as alert-box.
      112   end.
