        1   define input parameter parparentproc as widget-handle no-undo .
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   procedure proc-alt-shift-f2:
        7     if not ibs.th.gbl.gbl-var:rcode
        8   then
        9     run gbl\inidebug.p .
       10   end.
       11   procedure proc-alt-shift-f3:
       12     run gbl/prvssinf.p
       13       ( input this-procedure
       14       ) .
       15   end.
       16   define variable v-inform-launched as logical no-undo initial false .
       17   procedure proc-alt-shift-f4:
       18     define variable v-action as character no-undo .
       19     if v-inform-launched = false then do:
       20       assign
       21         v-inform-launched = true
       22       .
       23       run gbl/d-inform.w
       24         (  input self
       25         ,  input this-procedure
       26         , output v-action
       27         ) no-error .
       28       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       29       assign
       30         v-inform-launched = false
       31       .
       32     end.
       33   end.
       34   procedure proc-alt-f1:
       35     run gbl/corrhelp.p
       36       (input this-procedure
       37       ) .
       38   end .
       39   on alt-shift-f2 anywhere do:
       40     run proc-alt-shift-f2.
       41   end.
       42   on alt-shift-f3 anywhere do:
       43     run proc-alt-shift-f3 in this-procedure .
       44   end.
       45   on alt-shift-f4 anywhere do:
       46     run proc-alt-shift-f4 in this-procedure.
       47   end.
       48   on alt-f1 anywhere do:
       49     run proc-alt-f1 in this-procedure .
       50   end.
       51   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       52     define variable v-cntxt-db-num        as integer   no-undo .
       53     define variable v-cntxt-userid        as character no-undo .
       54     define variable v-cntxt-level         as character no-undo .
       55     define variable v-cntxt-host-code-obj as integer   no-undo .
       56     define variable v-cntxt-obj-type      as character no-undo .
       57     define variable v-cntxt-obj-code      as integer   no-undo .
       58     define variable v-cntxt-db-num-obj    as integer   no-undo .
       59     define variable v-cntxt-is-admin      as logical   no-undo .
       60   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       61     run mainmenu_getcntxt in parparentproc
       62       (output v-cntxt-db-num
       63       ,output v-cntxt-userid
       64       ,output v-cntxt-level
       65       ,output v-cntxt-host-code-obj
       66       ,output v-cntxt-obj-type
       67       ,output v-cntxt-obj-code
       68       ,output v-cntxt-db-num-obj
       69       ,output v-cntxt-is-admin
       70       ) .
       71   define stream imp-str.
       72   define variable v-list        as character no-undo .
       73   DEFINE VARIABLE v-ok          AS logical   no-undo .
       74   define variable char-gds-code as character no-undo .
       75   define variable unit-rec      as recid     no-undo .
       76   define variable v-rid         as recid     no-undo .
       77   define variable agnt-list     as character no-undo .
       78   define variable v-host-code as integer no-undo .
       79   define buffer buf_goods    for ub.goods .
       80   define buffer buf_bar-code for ub.bar-code .
       81   define buffer buf_gds-prt  for ub.gds-prt .
       82   DEFINE BUTTON b-goods
       83        IMAGE-UP FILE "btn-down-arrow":U
       84        IMAGE-DOWN FILE "btn-down-arrow":U
       85        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       86        LABEL ""
       87        SIZE 3 BY .88.
       88   DEFINE BUTTON b-goods-contract
       89        IMAGE-UP FILE "btn-down-arrow":U
       90        IMAGE-DOWN FILE "btn-down-arrow":U
       91        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       92        LABEL ""
       93        SIZE 3 BY .88 TOOLTIP "Выбор договора".
       94   DEFINE BUTTON b-help
       95        LABEL "Помо&щь"
       96        SIZE 11 BY 1.
       97   DEFINE BUTTON b-unit
       98        IMAGE-UP FILE "btn-down-arrow":U
       99        IMAGE-DOWN FILE "btn-down-arrow":U
      100        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      101        LABEL ""
      102        SIZE 3 BY .88.
      103   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      104        LABEL "Отмена"
      105        SIZE 11 BY 1
      106        BGCOLOR 8 .
      107   DEFINE BUTTON Btn_OK AUTO-GO
      108        LABEL "&Привязать"
      109        SIZE 11 BY 1
      110        BGCOLOR 8 .
      111   DEFINE VARIABLE f-goods AS CHARACTER
      112        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      113        SIZE 30 BY 4 NO-UNDO.
      114   DEFINE VARIABLE f-index AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
      115        LABEL "Коэффициент"
      116        VIEW-AS FILL-IN
      117        SIZE 14 BY 1 NO-UNDO.
      118   DEFINE VARIABLE f-unit AS CHARACTER FORMAT "X(256)":U
      119        LABEL "Единица измерения"
      120        VIEW-AS FILL-IN
      121        SIZE 14 BY 1
      122        BGCOLOR 15  NO-UNDO.
      123   DEFINE FRAME Dialog-Frame
      124        Btn_OK AT ROW 1 COL 1
      125        Btn_Cancel AT ROW 1 COL 12
      126        b-help AT ROW 1 COL 52 WIDGET-ID 2
      127        f-unit AT ROW 4 COL 24 COLON-ALIGNED WIDGET-ID 4
      128        b-unit AT ROW 4.08 COL 40.25 WIDGET-ID 60
      129        f-goods AT ROW 5.25 COL 26 NO-LABEL WIDGET-ID 70
      130        b-goods AT ROW 5.25 COL 56.5 WIDGET-ID 64
      131        b-goods-contract AT ROW 6.25 COL 56.5 WIDGET-ID 72
      132        f-index AT ROW 9.54 COL 24 COLON-ALIGNED WIDGET-ID 14
      133        "Список товаров:" VIEW-AS TEXT
      134             SIZE 15.5 BY .67 AT ROW 5.46 COL 9.88 WIDGET-ID 68
      135        SPACE(38.36) SKIP(7.15)
      136       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      137            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      138            TITLE "Привязать ед.изм. к товарам"
      139            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      140   ASSIGN
      141          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      142          FRAME Dialog-Frame:HIDDEN           = TRUE.
      143   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      144   DO:
      145         APPLY "END-ERROR":U TO SELF.
      146      END.
      147   ON CHOOSE OF b-goods IN FRAME Dialog-Frame
      148   DO:
      149         define variable i as integer no-undo .
      150         assign f-goods .
      151         run ref/gds-ref.p (parparentproc, 'b-sel,b-mark', ?, ?, ?, ?, ?, ?, ?, v-cntxt-obj-type, v-cntxt-obj-code, ?, output v-list) no-error.
      152         if error-status:error or v-list = ? or v-list = "" then
      153         do:
      154            message "Ошибка при выборе товара для добавления в справочник." view-as alert-box.
      155            return no-apply.
      156         end.
      157         v-ok = false.
      158         repeat i = 1 to num-entries (v-list) :
      159            for first ub.goods no-lock where recid(ub.goods) =  integer (entry (i, v-list))
      160               :
      161            if lookup(string(ub.goods.gds-code),char-gds-code) = 0 then do:
      162               f-goods = f-goods + "," + chr(10) + string(ub.goods.gds-name).
      163               char-gds-code = char-gds-code + "," + string(ub.goods.gds-code).
      164            end.
      165            end.
      166            f-goods = trim(f-goods, "," + chr(10)) .
      167            char-gds-code = trim(char-gds-code,",") .
      168         end.
      169         display f-goods with frame Dialog-Frame .
      170      end.
      171   ON CHOOSE OF b-goods-contract IN FRAME Dialog-Frame
      172   DO:
      173         define variable i as integer no-undo .
      174         define buffer buf_contract for ub.contract .
      175         define buffer buf_contract-specif for ub.contract-specif .
      176         assign f-goods .
      177         run str/cont-all.w ( input  parParentProc,
      178                              input v-cntxt-host-code-obj,
      179                              input "b-sel,b-mark":U,
      180                              input 'все':U,
      181                              input ?,
      182                              input ?,
      183                              input  ?,
      184                              input  ?,
      185                              input  "current",
      186                              input "all" ,
      187                              input-output agnt-list   ) no-error .
      188         if error-status:error or agnt-list = ? or agnt-list = "" then
      189         do:
      190            message "Ошибка при выборе договора для добавления в справочник." view-as alert-box.
      191            return no-apply.
      192         end.
      193         v-ok = false.
      194         repeat i = 1 to num-entries (agnt-list) :
      195            for first buf_contract no-lock where recid(buf_contract) = integer (entry (i, agnt-list)):
      196               for each buf_contract-specif no-lock where buf_contract-specif.host-code = buf_contract.host-code and
      197                                                          buf_contract-specif.contract-num = buf_contract.contract-code,
      198                  first buf_goods no-lock where buf_goods.gds-code = buf_contract-specif.gds-code:
      199               if lookup(string(buf_goods.gds-code),char-gds-code) = 0 then do:
      200               f-goods = f-goods + "," + chr(10) + string(buf_goods.gds-name).
      201               char-gds-code = char-gds-code + "," + string(buf_goods.gds-code).
      202               end .
      203            end.
      204            end.
      205            f-goods = trim(f-goods, "," + chr(10)) .
      206            char-gds-code = trim(char-gds-code,",") .
      207         end.
      208         display f-goods with frame Dialog-Frame .
      209      end.
      210   ON CHOOSE OF b-unit IN FRAME Dialog-Frame
      211   DO:
      212         assign f-unit .
      213         run ref/units.w ( input parparentproc
      214            , input yes
      215            , output unit-rec ).
      216         for first ub.units no-lock where recid(ub.units) = unit-rec:
      217            f-unit:screen-value = ub.units.unit-name .
      218         end.
      219         assign f-unit .
      220      END.
      221   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      222   DO:
      223         if f-unit = "" or f-goods = "" or f-index = 0 then
      224         do:
      225            message "Не все данные заполнены"
      226               view-as alert-box.
      227            return no-apply .
      228         end.
      229         run proc-create no-error .
      230         if error-status:error then
      231         do:
      232            message "Ошибка привязки"
      233               view-as alert-box.
      234         end.
      235      END.
      236   ON LEAVE OF f-index IN FRAME Dialog-Frame
      237   DO:
      238         assign f-index .
      239      END.
      240   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      241      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      242   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      243   on help of frame Dialog-Frame
      244   do:
      245     run gbl/app_help.p
      246       (input this-procedure :file-name
      247       ,input ''
      248       ,input ?
      249       ) no-error.
      250     if error-status :error then do:
      251       message
      252         "Ошибка при вызове помощи"
      253         error-status :get-message(1)
      254         view-as alert-box .
      255     end.
      256   end.
      257   run minbtn-set in this-procedure .
      258   on choose of b-help in frame Dialog-Frame
      259   do:
      260     apply "help":u to frame Dialog-Frame .
      261   end.
      262   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263   procedure minbtn-set :
      264       do
      265           on error undo, return error return-value
      266           :
      267           define variable ii              as integer       no-undo .
      268           define variable fh              as widget-handle no-undo .
      269           define variable hh              as widget-handle no-undo .
      270           define variable v-h             as handle        extent 4 no-undo .
      271           define variable v-name-button   as character     no-undo .
      272           define variable v-help-old-x    as decimal       no-undo .
      273           define variable v-help-old-y    as decimal       no-undo .
      274           define variable v-help-old-size as decimal       no-undo .
      275           define variable v-frame-width   as decimal       no-undo .
      276           define variable jj              as integer       no-undo .
      277           do
      278               on error undo, return error
      279               :
      280               assign
      281                   v-frame-width = frame Dialog-Frame:width - 0.3
      282                   fh            = frame Dialog-Frame:first-child
      283                   hh            = fh:first-child
      284                   ii            = 1
      285                   .
      286               do while valid-handle(hh):
      287                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      288                   do:
      289                       case lc(hh:name) :
      290                           when "b-help" then
      291                               do:
      292                                   hh:load-image-up("cmp/b-help.bmp":u) .
      293                                   hh:load-image-down("cmp/b-help.bmp":u) .
      294                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      295                                   hh:TOOLTIP = "Помощь" .
      296                                   v-help-old-x = hh:column .
      297                                   v-help-old-y = hh:row    .
      298                                   v-help-old-size = hh:width .
      299                                   hh:width-chars = 2.5 .
      300                               end.
      301                           when "b-print" then
      302                               do:
      303                                   hh:load-image("cmp/b-print.bmp":u) .
      304                                   hh:TOOLTIP = "Печать" .
      305                                   v-h[ii] = hh:handle .
      306                                   ii = ii + 1 .
      307                                   hh:width-chars = 3 .
      308                               end.
      309                           when "b-history" or
      310                           when "b-hist" then
      311                               do:
      312                                   hh:load-image("cmp/b-hist.bmp":u) .
      313                                   hh:TOOLTIP = "История" .
      314                                   v-h[ii] = hh:handle .
      315                                   ii = ii + 1 .
      316                                   hh:width-chars = 3 .
      317                               end.
      318                           when "b-sch" then
      319                               do:
      320                                   hh:load-image("cmp/b-sch.bmp":u) .
      321                                   hh:TOOLTIP = "Установка Фильтра" .
      322                                   v-h[ii] = hh:handle .
      323                                   ii = ii + 1 .
      324                                   hh:width-chars = 3 .
      325                               end.
      326                           when "b-hist-user" then
      327                               do:
      328                                   hh:load-image("cmp/b-hist.bmp":u) .
      329                                   hh:TOOLTIP = "История пользователя" .
      330                                   ii = ii + 1 .
      331                               end.
      332                       end case.
      333                   end.
      334                   hh = hh:next-sibling.
      335               end.
      336               b-help:column = v-frame-width - b-help:width-chars.
      337               jj = 0.
      338               repeat ii = 4 to 1 by -1 :
      339                   if valid-handle (v-h[ii] ) then
      340                   do:
      341                       jj  = jj + 1 .
      342                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      343                       v-h[ii]:row    = v-help-old-y .
      344                   end.
      345               end.
      346           end.
      347       end.
      348   end procedure.
      349   MAIN-BLOCK:
      350   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      351      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      352      RUN enable_UI.
      353      WAIT-FOR GO OF FRAME Dialog-Frame.
      354   END.
      355   RUN disable_UI.
      356   PROCEDURE disable_UI :
      357     HIDE FRAME Dialog-Frame.
      358   END PROCEDURE.
      359   PROCEDURE enable_UI :
      360     DISPLAY f-unit f-goods f-index
      361         WITH FRAME Dialog-Frame.
      362     ENABLE Btn_OK Btn_Cancel b-help b-unit f-goods b-goods b-goods-contract
      363            f-index
      364         WITH FRAME Dialog-Frame.
      365     VIEW FRAME Dialog-Frame.
      366   END PROCEDURE.
      367   PROCEDURE proc-create :
      368      define variable ii   as integer no-undo .
      369      define variable v-ok as logical no-undo .
      370      do ii = 1 to num-entries (char-gds-code) :
      371         for first buf_goods no-lock where buf_goods.gds-code =  integer (entry (ii, char-gds-code)):
      372            find first buf_bar-code exclusive-lock where buf_bar-code.gds-code = buf_goods.gds-code and
      373               buf_bar-code.unit-cli = f-unit no-error .
      374            if available (buf_bar-code) then
      375            do:
      376               message "К товару " + buf_goods.gds-name + " уже привязана единица измерения " + f-unit skip
      377                  "с коэффициентом пересчета " + string(buf_bar-code.cli-base-rate) skip
      378                  "Установить коэффициент " + string(f-index) skip
      379                  view-as alert-box question buttons yes-no update v-ok .
      380               if v-ok then
      381               do:
      382                  buf_bar-code.cli-base-rate = f-index .
      383               end.
      384               end.
      385               else
      386               do:
      387                  for first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code:
      388                     run ref/barcode1.p (
      389                        input 'ДОБАВЛЕНИЕ':U
      390                        ,input no
      391                        ,input 0
      392                        ,input buf_goods.gds-code
      393                        ,input buf_bar-code.node-code
      394                        ,input buf_bar-code.part-code
      395                        ,input buf_bar-code.in-code
      396                        ,input f-unit
      397                        ,input f-index
      398                        ,output v-rid) no-error.
      399                  end.
      400               end.
      401            end.
      402      end.
      403   END PROCEDURE.
