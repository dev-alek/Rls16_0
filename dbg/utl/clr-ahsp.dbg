      361   do
      362   on error undo, return error return-value
      363   :
      364     define variable v-message-on as logical   no-undo .
      365     assign
      366       v-message-on = true
      367     .
      368     define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
      369     run gbl/lock-prc.p
      370       (input 'ahsp':U
      371       ,input p-obj-code
      372       ,input 0
      373       ,input 0
      374       ,input p-obj-type
      375       ,input ""
      376       ,input ""
      377       ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
      378       ,input v-message-on
      379       ,buffer calc-supp-arh-lock_batchprocess
      380       ) no-error .
      381     if error-status :error
      382     then do:
      383       if v-message-on = true
      384       or error-status :get-message(1) <> ""
      385       then do:
      386         message
      387           vss-workfile vss-revision vss-description skip
      388           "В данный момент рассчитывается складской архив по поставщикам" skip
      389           "Невозможно произвести очистку складского архива по поставщикам" skip
      390           view-as alert-box error .
      391       end.
      392       undo, return error "В данный момент рассчитывается складской архив по поставщикам" .
      393     end.
      394     define variable v-ok as logical no-undo .
      395     run clntattr-delete in this-procedure
      396       (input p-obj-type
      397       ,input p-obj-code
      398       ,input 'ahsp-detail':U
      399       ,output v-ok
      400       ) .
      401     run clntattr-delete in this-procedure
      402       (input p-obj-type
      403       ,input p-obj-code
      404       ,input 'ahsp-start':U
      405       ,output v-ok
      406       ) .
      407     run clntattr-delete in this-procedure
      408       (input p-obj-type
      409       ,input p-obj-code
      410       ,input 'ahsp-recalc':U
      411       ,output v-ok
      412       ) .
      413     run clntattr-write in this-procedure
      414       (input p-obj-type
      415       ,input p-obj-code
      416       ,input 'ahsp-del':U
      417       ,input true
      418       ) .
      419     run clntattr-write in this-procedure
      420       (input p-obj-type
      421       ,input p-obj-code
      422       ,input 'ahsp-calc':U
      423       ,input true
      424       ) .
      425     run trg/ah-clicl.p
      426       (input p-obj-type
      427       ,input p-obj-code
      428       ,input 0
      429       ,input 0
      430       ,input ""
      431       ) .
      432   end.
