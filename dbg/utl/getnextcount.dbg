        1   block-level on error undo, throw.
        2   define input  parameter iFileName as character no-undo.
        3   define input  parameter ikey      as character no-undo.
        4   define input  parameter icode     as character no-undo.
        5   define input  parameter iParam    as character no-undo.
        6   define output parameter oCount    as int64 no-undo.
        7   define new global shared variable g#language as character no-undo .
        8   if g#language <> '' and g#language <> 'rus':U then do:
        9     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       10   end.
       11    define stream sReadfile.
       12   procedure GetAsuncNextcount:
       13      define input  parameter iFileName as character no-undo.
       14      define input  parameter ikey      as character no-undo.
       15      define input  parameter iCode     as character no-undo.
       16      define input  parameter iParam     as character no-undo.
       17      define output parameter oCount    as int64     no-undo init ?.
       18         define variable vAsyncHelper as class ibs.th.file.AsyncHelperth no-undo.
       19         define variable vText as character no-undo.
       20         define variable vlogfile as character no-undo.
       21         define variable vError as logical no-undo.
       22         if trans
       23         then do:
       24            vAsyncHelper = new ibs.th.file.AsyncHelperth().
       25            vAsyncHelper:setCurrentUserPasswd().
       26            vAsyncHelper:myTimeOut = 300.
       27            vAsyncHelper:AsyncProc("utl/proc-getnextcount", substitute("&1":U  +  chr(4)  + "&2":U + chr(4) + "&3":U , iFileName ,ikey, icode ),1).
       28            run ibs\th\file\waithelper.p (vAsyncHelper,"proc-getnextcount", 1,"Получаем значение счетчика.").
       29            vlogfile = vAsyncHelper:getlog(?).
       30            if vAsyncHelper:FileExists(vlogfile)
       31            then do:
       32               input stream sReadfile FROM  VALUE(vlogfile).
       33               repeat:
       34                  import stream sReadfile unformatted vText.
       35                  if vtext begins "error" then vError = yes.
       36                  else do:
       37                     Ocount = int64(vText) no-error.
       38                     if error-status:error
       39                     then
       40                        vError = yes.
       41                  end.
       42               end.
       43               input stream sReadfile close  .
       44               os-delete value(vlogfile).
       45             end.
       46             else
       47                vError = yes.
       48             vAsyncHelper:delworkdir().
       49             delete object vAsyncHelper.
       50          end.
       51          else
       52             vError = yes.
       53          if    vError
       54             or Ocount eq ?
       55             then do:
       56                define variable vCounterStor as class ibs.th.ref.counter.counterstorage.
       57                vCounterStor = new ibs.th.ref.counter.counterstorage().
       58                Ocount = vCounterStor:GetNextcount(iFileName , iKey,icode, iparam ).
       59                delete object vCounterStor.
       60             end.
       61      end.
       62    run GetAsuncNextcount(iFileName, ikey, icode,iParam, output oCount ).
