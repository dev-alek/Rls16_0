        1   block-level on error undo, throw.
        2   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INITIAL "$Revision$":U.
        3   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INITIAL "$Author$":U.
        4   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INITIAL "$Date$":U.
        5   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INITIAL "$Workfile$":U.
        6   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INITIAL "$Archive$":U.
        7   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INITIAL "экспорт справочников":U.
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   DEFINE TEMP-TABLE tt_clients NO-UNDO LIKE ub.clients.
       69     DEFINE TEMP-TABLE tt_cli-grp    NO-UNDO LIKE ub.cli-grp.
       70     DEFINE TEMP-TABLE tt_firm       NO-UNDO LIKE ub.firm.
       71     DEFINE TEMP-TABLE tt_shop       NO-UNDO LIKE ub.shop.
       72     DEFINE TEMP-TABLE tt_store      NO-UNDO LIKE ub.store.
       73     DEFINE TEMP-TABLE tt_person     NO-UNDO LIKE ub.person.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define variable v-waitfram-action01         as character   no-undo .
       76   define variable v-waitfram-action02         as character   no-undo .
       77   define variable v-waitfram-action03         as character   no-undo .
       78   define variable mWaitFramTextBeg            as character   no-undo.
       79   define variable mWaitFramTextEnd            as character   no-undo.
       80   define variable mWaitFramView               as logical     no-undo.
       81   define variable mWaitProcEvent              as logical     no-undo init yes.
       82   define variable mWaitFramInterval           as integer     no-undo init 1 .
       83   define variable mWaitFramStop               as logical     no-undo.
       84   define variable mWaitFramStopUser           as logical     no-undo.
       85   define variable mWaitFramStopTimeOut        as logical     no-undo.
       86   define variable mWaitFramStartProc          as datetime-tz no-undo.
       87   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       88   define button B-WaitFramStop auto-end-key
       89        label "Стоп"
       90        size 10 by 1 tooltip "Остоновить процесс".
       91   define button B-viewProcInfo
       92        label "Информация"
       93        size 15 by 1 tooltip "Информация о процесс".
       94   define frame waitfram
       95     v-waitfram-action01 format "x(72)" no-label skip
       96     v-waitfram-action02 format "x(72)" no-label skip
       97     v-waitfram-action03 format "x(72)" no-label skip
       98     B-viewProcInfo
       99     B-WaitFramStop at row 4 col 30
      100     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      101     .
      102   define new global shared variable mBatchMode as logical no-undo init ?.
      103   define variable mFramBachModHandle as handle no-undo.
      104   mFramBachModHandle = frame waitfram:handle.
      105   define variable mFameOldVis as logical no-undo.
      106   define variable mVisCUrentVin as logical no-undo.
      107   if session:batch-mode
      108   then
      109      mBatchMode = yes.
      110   if mBatchMode = ? then do:
      111     mVisCUrentVin = current-window:visible.
      112     mFameOldVis = mFramBachModHandle:visible.
      113     mFramBachModHandle:visible  = yes.
      114     mBatchMode = mFramBachModHandle:visible ne yes.
      115     mFramBachModHandle:visible = mFameOldVis.
      116     current-window:visible = mVisCUrentVin.
      117   end.
      118    if  log-manager:logfile-name ne ?
      119     then DO:
      120         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      121         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      122         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      123     end.
      124   on choose of B-WaitFramStop in frame waitfram
      125   do:
      126     mWaitFramStop = yes.
      127     mWaitFramStopUser = yes.
      128   end.
      129   function waitfram-check-timeout returns logical():
      130      define variable vtime as int64 no-undo.
      131      if mWaitFramStopTimeOut
      132      then
      133         return yes.
      134      vtime = ( now - mWaitFramStartProc ) / 1000 .
      135      if     mWaitFramTimeOut ne ?
      136         and mWaitFramTimeOut ne 0
      137         and mWaitFramTimeOut lt vtime
      138      then do:
      139         mWaitFramStopTimeOut = yes.
      140      end.
      141      return mWaitFramStopTimeOut.
      142   end.
      143   procedure waitfram-hide :
      144     if not session:batch-mode
      145     then do
      146     on error undo, return error return-value
      147     :
      148       pause 0 before-hide .
      149       if not mBatchMode then
      150         hide frame waitfram .
      151     if     not mWaitFramView
      152        and mWaitProcEvent
      153     then
      154       process events .
      155     end.
      156   end procedure.
      157   procedure waitfram-show :
      158     define input  parameter p-message as character no-undo .
      159     define variable v-left-margin as integer   no-undo .
      160     if not session:batch-mode
      161     then do
      162     on error undo, return error return-value
      163     :
      164       if length(p-message) <= 70 then do:
      165         assign
      166           v-left-margin = integer((70 - length(p-message)) / 2)
      167         .
      168         assign
      169           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      170         .
      171         assign
      172           v-waitfram-action01 = " "
      173           v-waitfram-action02 = " "
      174                                    + fill(" ", v-left-margin)
      175                                    + p-message
      176           v-waitfram-action03 = " "
      177         .
      178       end.
      179       else do:
      180         define variable vRindex1 as integer no-undo.
      181         define variable vRindex2 as integer no-undo.
      182         vRindex1 = r-index(p-message," ",70).
      183         if vRindex1 = 0
      184         then
      185            vRindex1 = 70.
      186         if length(p-message)  <= vRindex1 + 70 then do:
      187           assign
      188             v-waitfram-action01 = " "
      189             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      191           .
      192         end.
      193         else do:
      194           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      195           if vRindex2 <= vRindex1
      196           then
      197              vRindex2 = vRindex1 + 70.
      198           assign
      199             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      200             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      202           .
      203         end.
      204       end.
      205       B-viewProcInfo:visible   in frame waitfram = no.
      206       B-viewProcInfo:sensitive in frame waitfram = no.
      207       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      209       if  (   mWaitFramView
      210          or  mWaitProcEvent)
      211          and not mBatchMode
      212       then
      213          display
      214             v-waitfram-action01 skip
      215             v-waitfram-action02 skip
      216             v-waitfram-action03 skip
      217          with frame waitfram .
      218       if     mWaitFramView
      219          then do:
      220             if     mWaitFramInterval ne ?
      221                and not mBatchMode
      222             then
      223                wait-for go of frame waitfram pause mWaitFramInterval.
      224          end.
      225          else
      226             if     mWaitProcEvent
      227                and not mBatchMode
      228             then
      229                process events .
      230     end.
      231   end procedure.
      232      procedure waitfram-show-this:
      233         define input  parameter iInterval as int64 no-undo.
      234         define variable vtime as int64 no-undo.
      235         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      236         mWaitFramInterval = iInterval.
      237         run waitfram-show (substitute("&1&2 &3&4" ,
      238                                       mWaitFramTextBeg ,
      239                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      240                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      241                                       mWaitFramTextEnd
      242                                      )
      243                           ).
      244      end.
      245      procedure WaitFramRunPause:
      246         define input  parameter iInterval as dec no-undo.
      247         define variable vStart  as datetime-tz no-undo.
      248         define variable vend    as datetime-tz no-undo.
      249         define variable vint as int64 no-undo.
      250         define variable vOk as logical no-undo.
      251         vStart = now.
      252         vend   = vStart.
      253         publish "WaitFramPause" (iInterval,output vOk).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and (   vint > 0
      259                 or (    not vOk
      260                     and iInterval eq ?
      261                     )
      262                 )
      263         then
      264            run waitfram-show-this (iInterval).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and vint > 0
      270         then do:
      271            run gbl/pause.p (vint * 1000).
      272         end.
      273         if iInterval ne ?
      274         then
      275            publish "WaitFramStop".
      276         waitfram-check-timeout().
      277      end.
      278      procedure WaitFramWaitFor:
      279         define input  parameter iInterval as dec no-undo.
      280         assign
      281            mWaitFramStartProc   = now
      282            mWaitFramStopUser    = no
      283            mWaitFramStopTimeOut = no
      284         .
      285         block-wait:
      286         do while not mWaitFramStop:
      287            run WaitFramRunPause (iInterval).
      288            if  waitfram-check-timeout()
      289            then do:
      290               leave block-wait.
      291            end.
      292         end.
      293         run waitfram-hide.
      294      end.
      295   procedure waitfram-join :
      296     define input  parameter p-line-1  as character no-undo .
      297     define input  parameter p-line-2  as character no-undo .
      298     define input  parameter p-line-3  as character no-undo .
      299     define output parameter p-message as character no-undo .
      300     do
      301     on error undo, return error return-value
      302     :
      303       assign
      304         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      307       .
      308     end.
      309   end procedure.
      310   function waitfram-join-function returns character
      311     (input p-line-1 as character
      312     ,input p-line-2 as character
      313     ,input p-line-3 as character
      314     ).
      315     define variable v-message as character no-undo .
      316     run waitfram-join in this-procedure
      317       (input  p-line-1
      318       ,input  p-line-2
      319       ,input  p-line-3
      320       ,output v-message
      321       ) .
      322     return v-message .
      323   end function .
      324   DEFINE VARIABLE v_dmp-dir AS CHARACTER NO-UNDO.
      325   DEFINE VARIABLE v_type    AS CHARACTER NO-UNDO.
      326   DEFINE VARIABLE j_docs    AS INTEGER   NO-UNDO.
      327   DEFINE STREAM out-str.
      328   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      329     (input  'dmp-dir':U
      330     ,input  0
      331     ,input  '':U
      332     ,input  0
      333     ,input  '':U
      334     ,input  '':U
      335     ,input  '':U
      336     ,input  NO
      337     ,output v_dmp-dir
      338     ,output v_type
      339     ) NO-ERROR .
      340   IF ERROR-STATUS :ERROR OR v_type <> "C":U OR v_dmp-dir = ? OR v_dmp-dir = "":U THEN DO: ASSIGN v_dmp-dir = "./". END.
      341   IF SUBSTRING( v_dmp-dir, LENGTH( v_dmp-dir ), 1 ) <> "/" THEN DO: ASSIGN v_dmp-dir = v_dmp-dir + "/". END.
      342   MESSAGE "Вы уверены, что хотите начать экспорт"
      343           "справочников клиентов" + "?"
      344   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO TITLE "Экспорт справочников" UPDATE l_start-export AS LOGICAL.
      345   RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников клиентов" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ).
      346   SESSION :SET-WAIT-STATE( "COMPILER":U ).
      347   Prepare-Block:
      348   DO ON ERROR  UNDO Prepare-Block, RETURN ERROR
      349      ON ENDKEY UNDO Prepare-Block, RETURN ERROR :
      350     FOR EACH ub.clients NO-LOCK :
      351       PROCESS EVENTS.
      352       ASSIGN j_docs = j_docs + 1.
      353       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников клиентов" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      354       CREATE tt_clients.
      355       BUFFER-COPY ub.clients
      356                TO tt_clients.
      357       CASE ub.clients.obj-type :
      358         WHEN 'орг':U   THEN DO:
      359           FIND FIRST ub.firm   NO-LOCK WHERE ub.firm.firm-code  = ub.clients.obj-code NO-ERROR.
      360           IF NOT AVAILABLE ub.firm   THEN DO:
      361             DELETE tt_clients.
      362             NEXT.
      363           END.
      364           CREATE tt_firm.
      365           BUFFER-COPY ub.firm TO tt_firm.
      366         END.
      367         WHEN 'маг':U  THEN DO:
      368           FIND FIRST ub.shop   NO-LOCK WHERE ub.shop.obj-code   = ub.clients.obj-code NO-ERROR.
      369           IF NOT AVAILABLE ub.shop   THEN DO:
      370             DELETE tt_clients.
      371             NEXT.
      372           END.
      373           CREATE tt_shop.
      374           BUFFER-COPY ub.shop
      375                EXCEPT doc-prt goods-man store-man store-boss work-hours inout-price no-eq in-perm unit-cli-perm out-rate
      376                       out-line-discnt in-ov in-pay out-pay ret-pay down-pay inv-pay chk-pay ret-sup-pay rsrv-time price-calc
      377                       dst-price load-time holidays day-only buy-goods with-serv all-prt no-short-code pr-cash discaloc
      378                       cd-loc-base cd-bc-base cd-loc-alt cd-bc-alt cd-pb-base cd-sc-base cd-pb-alt cd-parts-ser
      379                       cd-parts-not-blank cd-parts-all shift-on sub-store-type sub-store-code sub-store-on
      380                    TO tt_shop.
      381         END.
      382         WHEN 'скл':U THEN DO:
      383           FIND FIRST ub.store  NO-LOCK WHERE ub.store.obj-code  = ub.clients.obj-code NO-ERROR.
      384           IF NOT AVAILABLE ub.store  THEN DO:
      385             DELETE tt_clients.
      386             NEXT.
      387           END.
      388           CREATE tt_store.
      389           BUFFER-COPY ub.store
      390                EXCEPT price-calc active doc-prt store-man store-boss work-hours inout-price no-eq in-perm unit-cli-perm
      391                       out-rate out-line-discnt in-ov in-pay out-pay ret-pay down-pay inv-pay chk-pay ret-sup-pay rsrv-time
      392                       dst-price load-time holidays shift-on
      393                    TO tt_store.
      394         END.
      395         WHEN 'чел':U   THEN DO:
      396           FIND FIRST ub.person NO-LOCK WHERE ub.person.psn-code = ub.clients.obj-code NO-ERROR.
      397           IF NOT AVAILABLE ub.person THEN DO:
      398             DELETE tt_clients.
      399             NEXT.
      400           END.
      401           CREATE tt_person.
      402           BUFFER-COPY ub.person EXCEPT cashier seller TO tt_person.
      403         END.
      404       END CASE.
      405     END.
      406     FOR EACH ub.cli-grp NO-LOCK :
      407       CREATE tt_cli-grp.
      408       BUFFER-COPY ub.cli-grp TO tt_cli-grp.
      409     END.
      410   END.
      411   ASSIGN j_docs = 0.
      412   BlockTransaction:
      413   DO TRANSACTION ON ERROR  UNDO BlockTransaction, RETURN ERROR
      414                  ON ENDKEY UNDO BlockTransaction, RETURN ERROR :
      415     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-" + SUBSTRING( "clients", 1, 3 ) + ".txt" ).
      416     FOR EACH tt_clients :
      417       PROCESS EVENTS.
      418       ASSIGN j_docs = j_docs + 1.
      419       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников клиентов" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      420       EXPORT STREAM out-str tt_clients.
      421     END.
      422     OUTPUT STREAM out-str CLOSE.
      423     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-cmp.txt" ).
      424     FOR EACH tt_firm :
      425       PROCESS EVENTS.
      426       ASSIGN j_docs = j_docs + 1.
      427       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников клиентов" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      428       EXPORT STREAM out-str tt_firm.
      429     END.
      430     OUTPUT STREAM out-str CLOSE.
      431     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-shp.txt" ).
      432     FOR EACH tt_shop :
      433       PROCESS EVENTS.
      434       ASSIGN j_docs = j_docs + 1.
      435       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников клиентов" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      436       EXPORT STREAM out-str tt_shop
      437       EXCEPT doc-prt goods-man store-man store-boss work-hours inout-price no-eq in-perm unit-cli-perm out-rate
      438              out-line-discnt in-ov in-pay out-pay ret-pay down-pay inv-pay chk-pay ret-sup-pay rsrv-time price-calc dst-price
      439              load-time holidays day-only buy-goods with-serv all-prt no-short-code pr-cash discaloc cd-loc-base cd-bc-base
      440              cd-loc-alt cd-bc-alt cd-pb-base cd-sc-base cd-pb-alt cd-parts-ser cd-parts-not-blank cd-parts-all shift-on
      441              sub-store-type sub-store-code sub-store-on.
      442     END.
      443     OUTPUT STREAM out-str CLOSE.
      444     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-str.txt" ).
      445     FOR EACH tt_store :
      446       PROCESS EVENTS.
      447       ASSIGN j_docs = j_docs + 1.
      448       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников клиентов" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      449       EXPORT STREAM out-str tt_store
      450       EXCEPT price-calc active doc-prt store-man store-boss work-hours inout-price no-eq in-perm unit-cli-perm out-rate
      451              out-line-discnt in-ov in-pay out-pay ret-pay down-pay inv-pay chk-pay ret-sup-pay rsrv-time dst-price load-time
      452              holidays shift-on.
      453     END.
      454     OUTPUT STREAM out-str CLOSE.
      455     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-prs.txt" ).
      456     FOR EACH tt_person :
      457       PROCESS EVENTS.
      458       ASSIGN j_docs = j_docs + 1.
      459       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников клиентов" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      460       EXPORT STREAM out-str tt_person
      461       EXCEPT cashier seller.
      462     END.
      463     OUTPUT STREAM out-str CLOSE.
      464     OUTPUT STREAM out-str TO VALUE( v_dmp-dir + "ref-cgrp.txt" ).
      465     FOR EACH tt_cli-grp :
      466       PROCESS EVENTS.
      467       ASSIGN j_docs = j_docs + 1.
      468       IF ( j_docs MODULO 100 ) = 0 THEN DO: RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Идет экспорт " + "справочников клиентов" + ", ждите..." + TRIM( STRING( j_docs, "->,>>>,>>>,>>9":U ) ) ). END.
      469       EXPORT STREAM out-str tt_cli-grp
      470       .
      471     END.
      472     OUTPUT STREAM out-str CLOSE.
      473   END.
      474   IF SESSION :SET-WAIT-STATE( "":U ) THEN DO: END.
      475   RUN WaitFram-Hide IN THIS-PROCEDURE.
      476   MESSAGE "Экспорт" "справочников клиентов" "закончен" SKIP
      477           "Выгружено записей:" j_docs
      478   VIEW-AS ALERT-BOX INFORMATION TITLE "Экспорт справочников".
