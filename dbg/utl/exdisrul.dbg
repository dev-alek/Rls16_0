        1   block-level on error undo, throw.
        2   define input parameter p-file-name as character no-undo .
        3   define input parameter p-old-file-name as character no-undo .
        4   define input parameter p-mode as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: exdisrul.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/exdisrul.p $":U .
       10   define variable vss-description as character no-undo init "Экспорт конфигурации rule-машины в формате СПН".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure check-dr-version :
       71   define output parameter p-check as logical no-undo .
       72   define variable v-dopi1 as integer no-undo .
       73   define variable v-dopi2 as integer no-undo .
       74   define variable v-dopi3 as integer no-undo .
       75   define variable v-dopi4 as integer no-undo .
       76   define buffer buf_dis-rule for ub.dis-rule .
       77     do
       78     on error undo, return error
       79     :
       80       find first buf_dis-rule no-lock where
       81                 buf_dis-rule.rule-num = 0 no-error .
       82       if (not available buf_dis-rule
       83       or buf_dis-rule.des <> "v16_0.1" )
       84       then do:
       85         assign
       86         v-dopi1 = integer(entry(2, buf_Dis-rule.des, "."))
       87         v-dopi2 = integer(entry(2, "v16_0.1", "."))
       88         v-dopi3 = integer(entry(2, entry(1, buf_Dis-rule.des, "."), "_"))
       89         v-dopi4 = integer(entry(2, entry(1, "v16_0.1", "."), "_"))
       90         no-error .
       91         if error-status:error
       92         or v-dopi2 > v-dopi1
       93         or v-dopi4 > v-dopi3
       94         or left-trim(entry(1, buf_Dis-rule.des, "."), "v":U) < "15"
       95         then do:
       96           assign
       97           p-check = yes.
       98         end.
       99       end.
      100     end.
      101   end procedure.
      102   procedure get-dr-version :
      103   define output parameter p-dr-version as character no-undo init ?.
      104   define buffer buf_dis-rule for ub.dis-rule .
      105   do
      106   on error undo, return error
      107   :
      108     find first buf_dis-rule no-lock where
      109               buf_dis-rule.rule-num = 0 no-error .
      110     if available buf_dis-rule then do:
      111         p-dr-version = buf_dis-rule.des.
      112     end.
      113   end.
      114   end procedure.
      115   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      116   procedure disrules-fill-properties:
      117   define input  parameter p-templ-rl-root as integer   no-undo .
      118   define buffer buf_drt-prop for ub.drt-prop.
      119   define buffer buf_temp-drt-prop for temp-drt-prop.
      120   do
      121   on error undo, return error return-value
      122   :
      123     for each buf_temp-drt-prop:
      124       delete buf_temp-drt-prop.
      125     end.
      126     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      127       create buf_temp-drt-prop.
      128       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      129     end.
      130   end.
      131   end procedure.
      132   ~
      133   define variable v-dis-exp-tables as character no-undo .
      134   define variable v-dis-exp-table-names as character no-undo .
      135   define variable err-count as integer no-undo .
      136   define variable rec-count as integer no-undo .
      137   define variable v-ii as integer no-undo .
      138   define variable v-prepare-phrase as character no-undo .
      139   define variable num-rec as integer no-undo .
      140   define variable num-err as integer no-undo .
      141   assign
      142   v-dis-exp-tables =  'dis-rule':U +
      143                       chr(44) + 'dis-cfg-rule':U +
      144                       chr(44) + 'dis-time-rule':U +
      145                       chr(44) + 'drt-prop':U
      146                       .
      147   assign
      148   v-dis-exp-table-names = 'правила скидок':U +
      149                           chr(44) + 'Связи dis-rule':U +
      150                           chr(44) + 'расписания':U +
      151                           chr(44) + 'Св-ва правил скижок и распис.':U
      152                           .
      153   do v-ii = 1 to num-entries( v-dis-exp-tables):
      154     CASE entry(v-ii, v-dis-exp-tables):
      155       when 'dis-rule':U
      156       then do:
      157         v-prepare-phrase = substitute(" for each &1 where &1.rule-num <= &2 "
      158                                       , entry(v-ii, v-dis-exp-tables)
      159                                       , 99999
      160                                       ).
      161       end.
      162       when 'dis-time-rule':U then do:
      163         v-prepare-phrase = substitute(" for each &1 where &1.time-rule-num <= &2 "
      164                                       , entry(v-ii, v-dis-exp-tables)
      165                                       , 99999
      166                                       ).
      167       end.
      168       otherwise do:
      169         v-prepare-phrase = substitute(" for each &1 ", entry(v-ii, v-dis-exp-tables)).
      170       end.
      171     end case.
      172     rec-count = num-rec.
      173     err-count = num-err.
      174     run utl/upg-exp.p ( input p-file-name
      175                        ,input p-old-file-name
      176                        ,input p-mode
      177                        ,input (if v-ii = 1 then no else yes)
      178                        ,input (if v-ii = 1 then yes else no)
      179                        ,input ( if v-ii = num-entries(v-dis-exp-tables) then yes else no)
      180                        ,input entry(v-ii, v-dis-exp-tables)
      181                        ,input 1
      182                        ,input v-prepare-phrase
      183                        ,input-output rec-count
      184                        ,input-output err-count
      185                        ) no-error.
      186     if not error-status:error then do:
      187       num-rec = rec-count.
      188       num-err = err-count.
      189     end.
      190   end.
