      361   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   procedure factord :
      363     define input  parameter p-fact-date            as date    no-undo .
      364     define input  parameter p-fact-time            as integer no-undo .
      365     define input  parameter p-fact-num             as integer no-undo .
      366     define input  parameter p-shift-date           as date    no-undo .
      367     define input  parameter p-shift-num            as integer no-undo .
      368     define input  parameter p-shift-on             as logical no-undo .
      369     define output parameter p-fact-order           as decimal no-undo .
      370     define output parameter p-shift-end-fact-order as decimal no-undo .
      371     define output parameter p-day-end-fact-order   as decimal no-undo .
      372     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      373     if p-fact-date = ?
      374     then do:
      375       return error "Не указана фактическая дата" .
      376     end.
      377     define variable v-fact-date-num as integer no-undo .
      378     assign
      379       v-fact-date-num = integer(p-fact-date)
      380     .
      381     if p-fact-num = ?
      382     or p-fact-num = 0
      383     then do:
      384       return error "Не задан p-fact-num " + string(p-fact-num) .
      385     end.
      386     if p-fact-num < 0
      387     then do:
      388       return error "Отрицательный fact-num " + string(p-fact-num) .
      389     end.
      390     if p-fact-num >= 100000000
      391     then do:
      392       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      393     end.
      394     if p-shift-on = true
      395     then do:
      396       if p-shift-date = ?
      397       then do:
      398         return error "Не задана дата смены" .
      399       end.
      400       if p-shift-num = ?
      401       or p-shift-num = 0
      402       then do:
      403         return error "Не задан номер смены" .
      404       end.
      405     end.
      406     else do:
      407       assign
      408         p-shift-date = p-fact-date
      409         p-shift-num  = 24
      410       .
      411     end.
      412     define variable v-shift-offset as integer no-undo .
      413     if p-shift-date = p-fact-date
      414     then do:
      415       assign
      416         v-shift-offset = 1
      417       .
      418     end.
      419     if p-shift-date < p-fact-date
      420     then do:
      421       assign
      422         v-shift-offset = 0
      423       .
      424     end.
      425     if p-shift-date > p-fact-date
      426     then do:
      427       message
      428         vss-workfile vss-revision vss-description skip
      429         "Неправильная дата закрытия смены" skip
      430         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      431         view-as alert-box error .
      432       undo, return error
      433         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      434           ,string(p-fact-date, '99/99/9999':U)
      435           ,string(p-shift-date, '99/99/9999':U)
      436           )
      437       .
      438     end.
      439     if p-shift-num < 1
      440     or p-shift-num > 24
      441     then do:
      442       message
      443         vss-workfile vss-revision vss-description skip
      444         "Неправильный номер смены" skip
      445         "p-shift-num" p-shift-num skip
      446         view-as alert-box error .
      447       undo, return error return-value .
      448     end.
      449     assign
      450       p-fact-order           = v-fact-date-num
      451                              + v-shift-offset * 0.5
      452                              + p-shift-num    * 0.02 - 0.01
      453                              + p-fact-num     * 0.0000000001
      454       p-shift-end-fact-order = v-fact-date-num
      455                              + v-shift-offset * 0.5
      456                              + p-shift-num    * 0.02
      457       p-day-end-fact-order   = v-fact-date-num
      458                              + 0.99
      459     .
      460     if p-fact-order           <= v-fact-date-num
      461     or p-shift-end-fact-order <= v-fact-date-num
      462     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      463     or p-shift-end-fact-order >= p-day-end-fact-order
      464     then do:
      465       message
      466         vss-workfile vss-revision vss-description skip
      467         "Внутренняя ошибка при генерации фактического номера" skip
      468         "p-fact-date"            p-fact-date            skip
      469         "p-fact-time"            p-fact-time            skip
      470         "p-fact-num"             p-fact-num             skip
      471         "p-shift-date"           p-shift-date           skip
      472         "p-shift-num"            p-shift-num            skip
      473         "p-shift-on"             p-shift-on             skip
      474         "p-shift-end-fact-order" p-shift-end-fact-order skip
      475         "p-day-end-fact-order"   p-day-end-fact-order   skip
      476         "v-fact-date-num"        v-fact-date-num        skip
      477         view-as alert-box error .
      478       undo, return error return-value .
      479     end.
      480   end procedure.
      481   procedure day-begin-fact-order :
      482     define input  parameter p-fact-date            as date    no-undo .
      483     define output parameter p-day-begin-fact-order as decimal no-undo .
      484     do
      485     on error undo, return error return-value
      486     :
      487       if p-fact-date = ?
      488       then do:
      489         assign
      490           p-day-begin-fact-order = 0
      491         .
      492       end.
      493       else do:
      494         assign
      495           p-day-begin-fact-order = integer(p-fact-date)
      496         .
      497       end.
      498     end.
      499   end procedure.
      500   procedure factord-max-fact-order :
      501     define output parameter p-max-fact-order as decimal   no-undo .
      502     do
      503     on error undo, return error return-value
      504     :
      505       run day-begin-fact-order in this-procedure
      506         (input  date(1, 1, 5000)
      507         ,output p-max-fact-order
      508         ) .
      509     end.
      510   end procedure.
      511   procedure factord-cut-archive :
      512     define input  parameter p-obj-type             as character no-undo .
      513     define input  parameter p-obj-code             as integer   no-undo .
      514     define input  parameter p-fact-date            as date      no-undo .
      515     define output parameter p-shift-on             as logical   no-undo .
      516     define output parameter p-shift-date           as date      no-undo .
      517     define output parameter p-shift-num            as integer   no-undo .
      518     define output parameter p-day-end-fact-order   as decimal   no-undo .
      519     define output parameter p-shift-end-fact-order as decimal   no-undo .
      520     define variable v-fact-order as decimal   no-undo .
      521     define buffer buf_shift-obj for ub.shift-obj .
      522     do
      523     on error undo, return error return-value
      524     :
      525   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      527     (input  p-obj-type
      528     ,input  p-obj-code
      529     ,input  'shift-on=request'
      530     ,output p-shift-on
      531     ) no-error .
      532       if error-status :error
      533       then do:
      534         message
      535           vss-workfile vss-revision vss-description skip
      536           "Ошибка при определении атрибута объекта" skip
      537           "Объект" p-obj-type p-obj-code skip
      538           error-status :get-message(1) skip
      539           return-value skip
      540           view-as alert-box error .
      541         undo, return error return-value .
      542       end.
      543       if p-shift-on = false
      544       then do:
      545         assign
      546           p-shift-date               = ?
      547           p-shift-num                = 0
      548         .
      549       end.
      550       else do:
      551         find first buf_shift-obj share-lock
      552           where buf_shift-obj.obj-type   = p-obj-type
      553             and buf_shift-obj.obj-code   = p-obj-code
      554             and buf_shift-obj.shift-date > p-fact-date
      555           use-index pi
      556           no-error .
      557         if not available buf_shift-obj
      558         or buf_shift-obj.status_ <> 'зкр':U
      559         then do:
      560           message
      561             vss-workfile vss-revision vss-description skip
      562             "Невозможно вычислить последнюю смену" skip
      563             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      564             "Объект" p-obj-type p-obj-code skip
      565             "Дата" p-fact-date skip
      566             view-as alert-box error .
      567           undo, return error return-value .
      568         end.
      569         find last buf_shift-obj share-lock
      570           where buf_shift-obj.obj-type = p-obj-type
      571             and buf_shift-obj.obj-code = p-obj-code
      572             and buf_shift-obj.shift-date <= p-fact-date
      573           use-index pi
      574           no-error .
      575         if available buf_shift-obj
      576         then do:
      577           if  buf_shift-obj.status_ = 'зкр':U
      578           then do:
      579             assign
      580               p-shift-date = buf_shift-obj.shift-date
      581               p-shift-num  = buf_shift-obj.shift-num
      582             .
      583           end.
      584           else do:
      585             message
      586               vss-workfile vss-revision vss-description skip
      587               "Невозможно вычислить последнюю смену" skip
      588               "Статус смены отличен от статуса" 'зкр':U skip
      589               "Объект" p-obj-type p-obj-code skip
      590               "Дата" p-fact-date skip
      591               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      592               view-as alert-box error .
      593             undo, return error return-value .
      594           end.
      595         end.
      596         else do:
      597           assign
      598             p-shift-date = p-fact-date - 1
      599             p-shift-num  = 1
      600           .
      601         end.
      602       end.
      603       run factord in this-procedure
      604         (input  p-fact-date
      605         ,input  1
      606         ,input  1
      607         ,input  p-shift-date
      608         ,input  p-shift-num
      609         ,input  p-shift-on
      610         ,output v-fact-order
      611         ,output p-shift-end-fact-order
      612         ,output p-day-end-fact-order
      613         ) no-error .
      614       if error-status :error
      615       then do:
      616         message
      617           vss-workfile vss-revision vss-description skip
      618           "Ошибка при вызове процедуры factord"
      619           error-status :get-message(1) skip
      620           return-value skip
      621           view-as alert-box error .
      622         undo, return error return-value .
      623       end.
      624     end.
      625   end procedure.
      626   procedure factord-lock-shift :
      627     define input  parameter p-obj-type  as character no-undo .
      628     define input  parameter p-obj-code  as integer   no-undo .
      629     define input  parameter p-fact-date as date      no-undo .
      630     define parameter buffer buf_shift-obj for ub.shift-obj .
      631     define variable v-shift-on      as logical   no-undo .
      632     define variable v-extra-message as character no-undo .
      633     define variable v-error as character no-undo .
      634     do
      635     on error undo, return error return-value
      636     :
      637   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      638   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      639     (input  p-obj-type
      640     ,input  p-obj-code
      641     ,input  'shift-on=request'
      642     ,output v-shift-on
      643     ) no-error .
      644       if error-status :error
      645       then do:
      646         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      647         undo, return error v-error .
      648       end.
      649       if v-shift-on = true
      650       then do:
      651         find first buf_shift-obj share-lock
      652           where buf_shift-obj.obj-type   = p-obj-type
      653             and buf_shift-obj.obj-code   = p-obj-code
      654             and buf_shift-obj.shift-date > p-fact-date
      655           use-index pi
      656           no-error .
      657         if not available buf_shift-obj
      658         or buf_shift-obj.status_ <> 'зкр':U
      659         then do:
      660           find last buf_shift-obj
      661             where buf_shift-obj.obj-type = p-obj-type
      662               and buf_shift-obj.obj-code = p-obj-code
      663               and buf_shift-obj.status_  = 'зкр':U
      664             use-index stts
      665             no-error .
      666           if available buf_shift-obj
      667           then do:
      668             assign
      669               v-extra-message =
      670                     substitute("Дата начала последеней закрытой смены на объекте &1"
      671                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      672                               )
      673             .
      674           end.
      675           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      676           undo, return error v-error .
      677         end.
      678       end.
      679     end.
      680   end procedure.
      681   procedure factord-end-day :
      682     define input  parameter p-fact-date            as date    no-undo .
      683     define output parameter p-day-end-fact-order   as decimal no-undo .
      684     do
      685     on error undo, return error return-value
      686     :
      687       if p-fact-date = ?
      688       then do:
      689         return error "Не указана фактическая дата" .
      690       end.
      691       assign
      692         p-day-end-fact-order = integer(p-fact-date) + 0.99
      693       .
      694     end.
      695   end procedure.
      696   procedure factord-to-date :
      697     define input  parameter p-fact-order as decimal no-undo .
      698     define output parameter p-fact-date  as date    no-undo .
      699     define variable v-ref-date  as date      no-undo .
      700     define variable v-ref-delta as integer   no-undo .
      701     do
      702     on error undo, return error return-value
      703     :
      704       if p-fact-order = ?
      705       or p-fact-order = 0
      706       then do:
      707         return error "Не указан fact-order" .
      708       end.
      709       assign
      710         v-ref-date  = date(1, 1, 2000)
      711       .
      712       assign
      713         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      714       .
      715       assign
      716         p-fact-date = v-ref-date + v-ref-delta
      717       .
      718     end.
      719   end procedure.
      720   procedure factord-to-fact-num :
      721     define input  parameter p-fact-order as decimal no-undo .
      722     define output parameter p-fact-num   as integer no-undo .
      723     define variable v-fact-order-trunc as decimal no-undo .
      724     do
      725     on error undo, return error return-value
      726     :
      727       if p-fact-order = ?
      728       or p-fact-order = 0
      729       then do:
      730         return error "Не указан fact-order" .
      731       end.
      732       assign
      733        v-fact-order-trunc = truncate(p-fact-order, 2)
      734       .
      735       assign
      736         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      737       .
      738     end.
      739   end procedure.
      740   procedure factord-to-shift-num :
      741     define input  parameter p-fact-order as decimal no-undo .
      742     define output parameter p-shift-num   as integer no-undo .
      743     define variable  p-shift-numd  as decimal   no-undo .
      744     define variable v-fact-order-trunc as decimal no-undo .
      745     do
      746     on error undo, return error return-value
      747     :
      748       if p-fact-order = ?
      749       or p-fact-order = 0
      750       then do:
      751         return error "Не указан fact-order" .
      752       end.
      753       assign
      754        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      755       .
      756       if v-fact-order-trunc < 0.5 then do:
      757         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      758       end.
      759       assign
      760         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      761         .
      762        assign
      763         p-shift-num = truncate (p-shift-numd , 0)
      764       .
      765     end.
      766   end procedure.
