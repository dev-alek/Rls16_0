      840   procedure create_obj-list :
      841      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      842      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      843      do
      844      on error undo, return error return-value
      845      :
      846         define buffer cli-obj for ub.clients .
      847         define variable p-var as integer no-undo .
      848         define buffer buf_obj-list for obj-list .
      849         find last buf_obj-list  use-index pi no-error .
      850         if available buf_obj-list
      851         then
      852            p-var = buf_obj-list.obj-id + 1.
      853         else
      854            p-var = 1.
      855         find first cli-obj where
      856                   cli-obj.obj-type = p-obj-type
      857               and cli-obj.obj-code = p-obj-code
      858         no-lock no-error.
      859         if available cli-obj
      860         then do:
      861            create buf_obj-list.
      862            assign
      863               buf_obj-list.obj-id   = p-var
      864               buf_obj-list.obj-code = cli-obj.obj-code
      865               buf_obj-list.obj-type = cli-obj.obj-type
      866               buf_obj-list.obj-name = cli-obj.obj-name
      867               buf_obj-list.db-num   = cli-obj.db-num
      868            .
      869         end.
      870      end.
      871   end.
