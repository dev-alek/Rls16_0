     1264   define variable var-report-r-b as character no-undo .
     1265   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1266   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1267     (output var-report-r-b
     1268     )  .
     1269   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1270   define temp-table userobjs_temp-user-obj no-undo
     1271     field obj-type as character
     1272     field obj-code as integer
     1273     index xpk is primary unique obj-type obj-code
     1274     .
     1275   procedure userobjs_clear :
     1276     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1277     do
     1278     on error undo, return error return-value
     1279     :
     1280       for each buf_userobjs_temp-user-obj
     1281       on error undo, return error return-value
     1282       :
     1283         delete buf_userobjs_temp-user-obj .
     1284       end.
     1285     end.
     1286   end .
     1287   procedure userobjs_object-count :
     1288     define output parameter p-total-count as integer   no-undo .
     1289     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1290     do
     1291     on error undo, return error return-value
     1292     :
     1293       assign
     1294         p-total-count = 0
     1295       .
     1296       for each buf_userobjs_temp-user-obj
     1297       on error undo, return error return-value
     1298       :
     1299         assign
     1300           p-total-count = p-total-count + 1
     1301         .
     1302       end.
     1303     end.
     1304   end.
     1305   procedure userobjs_append :
     1306      define input  parameter p-obj-type as character no-undo .
     1307      define input  parameter p-obj-code as integer   no-undo .
     1308     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1309     do
     1310     on error undo, return error return-value
     1311     :
     1312       find first buf_userobjs_temp-user-obj
     1313         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1314           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1315         no-error .
     1316       if not available buf_userobjs_temp-user-obj
     1317       then do:
     1318         create buf_userobjs_temp-user-obj .
     1319         assign
     1320           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1321           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1322         .
     1323       end.
     1324     end.
     1325   end.
     1326   procedure userobjs_object-exist :
     1327     define output parameter p-object-exist as logical   no-undo .
     1328     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1329     do
     1330     on error undo, return error return-value
     1331     :
     1332       find first buf_userobjs_temp-user-obj
     1333         no-error .
     1334       if not available buf_userobjs_temp-user-obj
     1335       then do:
     1336         assign
     1337           p-object-exist = false
     1338         .
     1339       end.
     1340       else do:
     1341         assign
     1342           p-object-exist = true
     1343         .
     1344       end.
     1345     end.
     1346   end.
     1347   procedure userobjs_transfer :
     1348     define input  parameter p-callback-handle as handle no-undo .
     1349     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1350     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354       if valid-handle(p-callback-handle) <> true
     1355       then do:
     1356         message
     1357           vss-workfile vss-revision vss-description skip
     1358           "Ошибка задания входных параметров" skip
     1359           "Неизвестный указатель на процедуру" skip
     1360           view-as alert-box error .
     1361         undo, return error return-value .
     1362       end.
     1363       if p-callback-handle :get-signature("userobjs_append") = ""
     1364       then do:
     1365         message
     1366           vss-workfile vss-revision vss-description skip
     1367           "Ошибка задания входных параметров" skip
     1368           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1369                     ,p-callback-handle :file-name
     1370                     ) skip
     1371           view-as alert-box error .
     1372         undo, return error return-value .
     1373       end.
     1374       for each buf_userobjs_temp-user-obj
     1375       on error undo, return error return-value
     1376       :
     1377         run userobjs_append in p-callback-handle
     1378           (input  buf_userobjs_temp-user-obj.obj-type
     1379           ,input  buf_userobjs_temp-user-obj.obj-code
     1380           ) .
     1381       end.
     1382     end.
     1383   end procedure.
     1384   procedure userobjs_select-one :
     1385      define input  parameter parparentproc     as widget-handle no-undo .
     1386      define input  parameter p-db-num          as integer   no-undo .
     1387      define input  parameter p-user-id         as character no-undo .
     1388      define input  parameter p-host-code-obj   as integer   no-undo .
     1389      define input  parameter p-obj-type        as character no-undo .
     1390      define input  parameter p-obj-code        as integer   no-undo .
     1391      define output parameter p-user-select     as logical   no-undo .
     1392      define output parameter p-select-obj-type as character no-undo .
     1393      define output parameter p-select-obj-code as character no-undo .
     1394     do
     1395     on error undo, return error return-value
     1396     :
     1397       run gbl/userobjs.w
     1398         (input  parparentproc
     1399         ,input  this-procedure :handle
     1400         ,input  p-db-num
     1401         ,input  p-user-id
     1402         ,input  p-host-code-obj
     1403         ,input  p-obj-type
     1404         ,input  p-obj-code
     1405         ,INPUT  "b-sel"
     1406         ,output p-user-select
     1407         ,output p-select-obj-type
     1408         ,output p-select-obj-code
     1409         ) .
     1410     end.
     1411   end.
     1412   procedure userobjs_select-many :
     1413     define input  parameter parparentproc   as widget-handle no-undo .
     1414     define input  parameter p-db-num        as integer   no-undo .
     1415     define input  parameter p-user-id       as character no-undo .
     1416     define input  parameter p-host-code-obj as integer   no-undo .
     1417     define input  parameter p-obj-type      as character no-undo .
     1418     define input  parameter p-obj-code      as integer   no-undo .
     1419     define output parameter p-user-select   as logical   no-undo .
     1420     define variable v-select-obj-type as character no-undo .
     1421     define variable v-select-obj-code as integer   no-undo .
     1422     do
     1423     on error undo, return error return-value
     1424     :
     1425       run gbl/userobjs.w
     1426         (input  parparentproc
     1427         ,input  this-procedure :handle
     1428         ,input  p-db-num
     1429         ,input  p-user-id
     1430         ,input  p-host-code-obj
     1431         ,input  p-obj-type
     1432         ,input  p-obj-code
     1433         ,INPUT  "b-sel,b-mark"
     1434         ,output p-user-select
     1435         ,output v-select-obj-type
     1436         ,output v-select-obj-code
     1437         ) .
     1438     end.
     1439   end.
     1440   procedure thobjs :
     1441      define input        parameter parparentproc     as widget-handle no-undo .
     1442      define input        parameter i-bttns           as character     no-undo .
     1443      define input        parameter i-list-mode       as character     no-undo.
     1444      define input        parameter i-obj-type        as character     no-undo.
     1445      define input        parameter i-db-num          as integer       no-undo.
     1446      define input        parameter i-host-code       as integer       no-undo.
     1447      define input-output parameter p-rid-list        as character     no-undo .
     1448   run ref/thobjs.p
     1449           ( input parparentproc
     1450            ,input  this-procedure :handle
     1451           , input i-bttns
     1452           , input i-list-mode
     1453           , input i-obj-type
     1454           , input i-db-num
     1455           , input i-host-code
     1456           , input-output p-rid-list ) no-error .
     1457   end.
     1458   on write of ub.arh-trn-doc-contract override do:  end.
     1459   on delete of ub.arh-trn-doc-contract override do:  end.
     1460   define variable v-str          as CHAR    no-undo .
     1461   define variable par-type       as CHAR    no-undo .
     1462   define variable p-status       as integer no-undo .
     1463   define variable p-cut-date     as date    no-undo .
     1464   define variable p-cut-fin-date as date    no-undo.
     1465   define variable Counter1       as integer   no-undo .
     1466   define variable g-log          as logical   no-undo .
     1467   define variable v-fact-order     as decimal   no-undo .
     1468   define variable v-cut-fact-order as decimal   no-undo .
     1469   define buffer buf_arh-trn-doc-contract for ub.arh-trn-doc-contract.
     1470     run day-begin-fact-order in this-procedure ( input x-date-alone, output v-fact-order ).
     1471     for each obj-list on error undo, return error :
     1472   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cutd-obj in g#library
     1473     (input  obj-list.obj-type
     1474     ,input  obj-list.obj-code
     1475     ,output p-status
     1476     ,output p-cut-date
     1477     ,output p-cut-fin-date
     1478     )  .
     1479       if p-status = 2 or
     1480          p-status = 4 then do:
     1481         run factord-end-day in this-procedure ( input p-cut-date - 1, output v-cut-fact-order ).
     1482         if v-fact-order <= v-cut-fact-order then do:
     1483           message "Пересчет архивов должен начинаться с даты большей или равной дате обрезания." skip
     1484                   "Объект: " obj-list.obj-code " " obj-list.obj-type skip
     1485                   "Дата обрезания:" p-cut-date skip
     1486                   "Запрошенная дата пересчета архивов: " x-date-alone skip
     1487                   view-as alert-box error.
     1488           return error.
     1489         end.
     1490       end.
     1491     end.
     1492   define variable v-account as integer init 0 no-undo .
     1493   define variable v-account-lavel as character no-undo .
     1494   define variable v-button-stop as logical no-undo .
     1495   define variable v-kol-spice as integer no-undo .
     1496   define variable v-kol-spice2 as integer no-undo .
     1497   define variable v-kol-spice3 as integer no-undo .
     1498   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1499   DEFINE BUTTON StopBtn AUTO-END-KEY
     1500        LABEL "Стоп"
     1501        SIZE 10 BY 1.
     1502   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1503        LABEL "Обработано записей"
     1504         VIEW-AS TEXT
     1505        SIZE 14 BY .67 NO-UNDO.
     1506   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1507         VIEW-AS TEXT
     1508        SIZE 53.25 BY .67
     1509        FGCOLOR 1  NO-UNDO.
     1510   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1511         VIEW-AS TEXT
     1512        SIZE 53.25 BY .67
     1513        FGCOLOR 1  NO-UNDO.
     1514   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1515         VIEW-AS TEXT
     1516        SIZE 53.25 BY .67
     1517        FGCOLOR 1  NO-UNDO.
     1518   DEFINE RECTANGLE RECT-1
     1519        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1520        SIZE 55.13 BY 4.46.
     1521   DEFINE FRAME InfoFrame
     1522        StopBtn AT ROW 4.25 COL 21.75
     1523        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1524        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1525        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1526        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1527        RECT-1 AT ROW 1 COL 1
     1528       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1529            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1530            TITLE "Процесс"
     1531            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1532   define variable mFrameView      as logical   no-undo init yes.
     1533     define variable mFramHandle as handle no-undo.
     1534     mFramHandle = frame InfoFrame:handle.
     1535     if  log-manager:logfile-name ne ?
     1536     then DO:
     1537         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1538         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1539         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1540     end.
     1541     mFrameView = not session:batch-mode and mFramHandle:visible.
     1542     if mFrameView
     1543     then do:
     1544       ASSIGN
     1545          FRAME InfoFrame:HIDDEN                           = TRUE
     1546          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1547     end.
     1548   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1549   DO:
     1550     IF not StopProcessing THEN
     1551       Message "Вы действительно хотите прервать" SKIP
     1552               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1553                 UPDATE StopProcessing.
     1554     IF StopProcessing THEN do:
     1555        if mFrameView
     1556        then do:
     1557           HIDE FRAME InfoFrame.
     1558        end.
     1559     End.
     1560   END.
     1561   assign v-account = ( if integer( 5 ) = 0 then 100 else integer( 5 ) ).
     1562     if  log-manager:logfile-name ne ?
     1563     then DO:
     1564         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1565     end.
     1566     if not session:batch-mode then
     1567     do:
     1568       VIEW FRAME InfoFrame.
     1569       mFrameView = true.
     1570     end.
     1571      v-button-stop = false .
     1572         if mFrameView
     1573         then do:
     1574         if v-button-stop then view STOPBTN in frame InfoFrame.
     1575                          else Hide STOPBTN in frame InfoFrame.
     1576         end.
     1577     for each obj-list :
     1578       run calc-archive in this-procedure ( input obj-list.obj-type, input obj-list.obj-code ).
     1579     end.
     1580   if mFrameView
     1581   then do:
     1582      HIDE FRAME InfoFrame.
     1583   end.
     1584     message  "Работа утилиты завершена"   view-as alert-box.
     1585   procedure calc-archive :
     1586     do on error undo, return error return-value :
     1587       define input  parameter p-obj-type like ub.clients.obj-type .
     1588       define input  parameter p-obj-code like ub.clients.obj-code .
     1589       for each ub.arh-trn-doc-contract exclusive-lock
     1590         where ub.arh-trn-doc-contract.obj-type = p-obj-type
     1591           and ub.arh-trn-doc-contract.obj-code = p-obj-code
     1592         on error undo, return error return-value :
     1593         if ub.arh-trn-doc-contract.fact-order >= v-fact-order then  delete ub.arh-trn-doc-contract .
     1594       end.
     1595         for each trn-doc no-lock
     1596           where trn-doc.obj-type = obj-list.obj-type
     1597             and trn-doc.obj-code = obj-list.obj-code
     1598             and trn-doc.status_  = 'факт':U
     1599             and trn-doc.fact-order >= v-fact-order
     1600           :
     1601           assign Counter1 = Counter1 + 1.
     1602   IF ( Counter1 modulo v-account = 0 )  then DO:
     1603             if  log-manager:logfile-name ne ?
     1604             then DO:
     1605                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1606             end.
     1607              if mFrameView
     1608              then do:
     1609               DISPLAY
     1610                 Counter1 @ RecordsDone
     1611                 WITH FRAME InfoFrame.
     1612              end.
     1613   End.
     1614      if v-button-stop then  DO:
     1615            if mFrameView
     1616            then
     1617               PROCESS EVENTS.
     1618            IF StopProcessing THEN DO:
     1619            RETURN error.
     1620            End.
     1621      end.
     1622   if (valid-handle(g#libtfarh) <> true) then do:   run str/libtfarh.p persistent no-error .   if error-status :error or (valid-handle(g#libtfarh) <> true) then do:     message       "Error starting libtfarh.p" skip       g#libtfarh skip       g#libtfarh :type skip       g#libtfarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libtfarh_latrncnt in g#libtfarh
     1623   (input  ub.trn-doc.doc-code
     1624   ) no-error.
     1625           if error-status :error then message return-value error-status:get-message(1) view-as alert-box.
     1626   if (valid-handle(g#libtfarh) <> true) then do:   run str/libtfarh.p persistent no-error .   if error-status :error or (valid-handle(g#libtfarh) <> true) then do:     message       "Error starting libtfarh.p" skip       g#libtfarh skip       g#libtfarh :type skip       g#libtfarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libtfarh_catrncnt in g#libtfarh
     1627   (input  ub.trn-doc.doc-code
     1628   ) no-error.
     1629           if error-status :error then message return-value error-status:get-message(1) view-as alert-box.
     1630         end.
     1631         run clntattr-delete in this-procedure ( input obj-list.obj-type,input obj-list.obj-code, input 'arh-trn-doc-contract':U, output v-str) .
     1632     end.
     1633   end procedure.
