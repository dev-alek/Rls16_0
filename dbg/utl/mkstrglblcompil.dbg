        1   block-level on error undo, throw.
        2   block-level on error undo, throw.
        3   function objExists return character
        4   (input  ifolder as character,
        5    input  iType   as character  ):
        6       define variable vFileType as character no-undo init "D,F".
        7       define variable vi        as integer no-undo.
        8       define variable vtype as character no-undo.
        9       if iType ne ?
       10       then
       11          vFileType = iType.
       12       do vi = 1 to num-entries(vFileType):
       13          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       14          vtype = file-information:file-type.
       15          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       16             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       17             index(vtype , entry(vi,vFileType )) > 0
       18          then return file-information:full-pathname .
       19          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       20          vtype = file-information:file-type.
       21          if file-information:file-name <> "" and
       22             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       23             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       24             index( vtype, entry(vi,vFileType )) > 0
       25          then return file-information:full-pathname .
       26       end.
       27       return ? .
       28   end.
       29   function SearchFile return character
       30   (input  ifile as character):
       31      return objExists(ifile,?).
       32   end.
       33   function SearchPFile return character
       34   (input inFile as char):
       35        define variable oFile       as character no-undo.
       36        define variable vFileSearch as character no-undo.
       37        define variable vNumEntry   as integer no-undo.
       38        if inFile = "" then return ?.
       39        vNumEntry = num-entries(inFile,".").
       40        vFileSearch = inFile.
       41        if    vNumEntry > 0
       42           and (   entry(vNumEntry,inFile,".") eq "p"
       43                or entry(vNumEntry,inFile,".") eq "w")
       44        then do:
       45           entry(vNumEntry,vFileSearch, ".") = "r".
       46           oFile = search(vFileSearch ).
       47           if oFile eq ?
       48           then
       49              oFile = search(inFile).
       50        end.
       51        else
       52           oFile = search(vFileSearch).
       53        return oFile.
       54     end.
       55      function SavePARAM returns logical ( input iName as character, input iValue as character ):
       56         put unformatted SUBSTITUTE("<PARAM name='&1'>", iName).
       57         put unformatted iValue.
       58         put unformatted SUBSTITUTE("</PARAM name='&1'>", iName) skip.
       59      end .
       60      function GetPARAM returns character  ( input iFile as character, input iName as character ):
       61         define variable vLob  as longchar no-undo.
       62         define variable vFrom as int64    no-undo.
       63         define variable vTo   as int64    no-undo.
       64         iFile = SearchFile (iFile).
       65         if iFile eq ? then return ?.
       66         copy-lob file iFile to vLob no-error.
       67         vFrom = index(vLob, SUBSTITUTE("<PARAM name='&1'>", iName)).
       68         if vFrom <= 0 then return ?.
       69         assign
       70            vTo = index(vLob, SUBSTITUTE("</PARAM name='&1'>", iName))
       71            vFrom = vFrom + LENGTH(SUBSTITUTE("<PARAM name='&1'>", iName)).
       72         if vTo < vFrom then return ?.
       73         return string(substring(vLob, vFrom, vTo - vFrom)).
       74      end.
       75   define variable vFileParam as character no-undo.
       76   define variable mliststrfile as character no-undo.
       77   define variable mi           as integer   no-undo.
       78   define variable changstr     as logical   no-undo.
       79   define variable chancript    as logical   no-undo.
       80   define variable chancriptone as logical   no-undo.
       81   define variable changmd5     as logical   no-undo.
       82   define variable mfilesize    as integer   no-undo.
       83   define variable msizeinfile  as integer   no-undo.
       84   define variable mverinfile   as integer   no-undo.
       85   define variable v-md5-signature  as character no-undo.
       86   define variable mfile        as character no-undo.
       87   define variable mfilename    as character no-undo.
       88   define variable mfileNew     as character no-undo.
       89   define variable mFileRes     as character no-undo.
       90   define variable mDirUpdCk    as character no-undo.
       91   define stream sOut.
       92   define stream dir-stream.
       93   define temp-table tt-file-ver
       94   field  filename as character
       95   field  filesize as integer
       96   field  filever as integer init ?
       97   .
       98   if search("adm/l-i.r") eq ?
       99   then do:
      100      vFileParam = SearchFile ("filesize.txt").
      101      mFileRes = search("utl/mkstrglb.p").
      102      mFileRes = replace(mFileRes,"mkstrglb.p","mkstrres.txt").
      103      output stream sOut to value( mFileRes ).
      104      output stream sOut close.
      105      mliststrfile = "cmp/str-glb2.p,cmp/str-glb3.p,cmp/str-glb4.p,cmp/str-glb5.p,cmp/str-glbl.p,cmp/str-glbt.p".
      106      block-file:
      107      do mi = 1 to num-entries(mliststrfile):
      108         changstr = yes.
      109         run SaveFileList(entry(mi,mliststrfile),"cmp/str-glbl.i").
      110      end.
      111      if    changstr
      112         or search ("cmp/str-glbl.i") eq ?
      113      then do:
      114         if search("str-glbl.new") ne ?
      115         then do:
      116            message "Уже начато формирвание str-glbl.i в другой сесссии" skip
      117               search("str-glbl.new")
      118            view-as alert-box.
      119            return.
      120         end.
      121         if search("cmp/str-glbl.i") ne ?
      122         then do:
      123            output stream sOut to value( search("cmp/str-glbl.i")).
      124            put stream sOut "удален" skip.
      125            output stream sOut close.
      126         end.
      127         changstr = yes.
      128   define variable vss-revision    as character no-undo init "$Revision: 6cc672b19ae2, 2597, rls $":U .
      129   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
      130   define variable vss-date        as character no-undo init "$Date: Ср сен 23 11:55:30 2020 +0300 $":U .
      131   define variable vss-workfile    as character no-undo init "$Workfile: mkstrglb.p $":U .
      132   define variable vss-archive     as character no-undo init "$Archive: utl/mkstrglb.p $":U .
      133   define variable vss-description as character no-undo init "Создание файла препроцессингов для системы".
      134   procedure vss-get-info :
      135     define output parameter p-vss-revision    like vss-revision    no-undo .
      136     define output parameter p-vss-author      like vss-author      no-undo .
      137     define output parameter p-vss-date        like vss-date        no-undo .
      138     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      139     define output parameter p-vss-archive     like vss-archive     no-undo .
      140     define output parameter p-vss-description like vss-description no-undo .
      141     assign
      142       p-vss-revision    = vss-revision
      143       p-vss-author      = vss-author
      144       p-vss-date        = vss-date
      145       p-vss-workfile    = vss-workfile
      146       p-vss-archive     = vss-archive
      147       p-vss-description = vss-description
      148     .
      149   end procedure.
      150   procedure vss-get-parameters :
      151     define output parameter p-vss-parameters as character no-undo .
      152   end procedure.
      153   define new global shared variable g#vssrevis-logger as handle    no-undo .
      154   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      155   define variable v-vssrevis-logger                   as handle    no-undo .
      156   procedure vss-logevent :
      157     define input  parameter p-extra-paramters as character no-undo .
      158     define variable v-vssrevis-parameters as character no-undo .
      159     do
      160     on error undo, return error return-value
      161     :
      162       if  valid-handle(v-vssrevis-logger)
      163       and v-vssrevis-logger :get-signature("logevent") <> ""
      164       then do:
      165         run vss-get-parameters in this-procedure
      166           (output v-vssrevis-parameters
      167           ).
      168         run logevent in v-vssrevis-logger
      169           (input vss-workfile
      170           ,input vss-revision
      171           ,input v-vssrevis-parameters
      172           ,input p-extra-paramters
      173           ).
      174       end.
      175     end.
      176   end procedure.
      177   assign
      178     v-vssrevis-logger = g#vssrevis-logger
      179   .
      180   if  valid-handle(v-vssrevis-logger)
      181   and v-vssrevis-logger :get-signature("logevent") <> ""
      182   then do:
      183     assign
      184       v-vssrevis-logevent = true
      185     .
      186     run vss-logevent in this-procedure (input vss-description) .
      187   end.
      188   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      189   define variable v-waitfram-action01         as character   no-undo .
      190   define variable v-waitfram-action02         as character   no-undo .
      191   define variable v-waitfram-action03         as character   no-undo .
      192   define variable mWaitFramTextBeg            as character   no-undo.
      193   define variable mWaitFramTextEnd            as character   no-undo.
      194   define variable mWaitFramView               as logical     no-undo.
      195   define variable mWaitProcEvent              as logical     no-undo init yes.
      196   define variable mWaitFramInterval           as integer     no-undo init 1 .
      197   define variable mWaitFramStop               as logical     no-undo.
      198   define variable mWaitFramStopUser           as logical     no-undo.
      199   define variable mWaitFramStopTimeOut        as logical     no-undo.
      200   define variable mWaitFramStartProc          as datetime-tz no-undo.
      201   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      202   define button B-WaitFramStop auto-end-key
      203        label "Стоп"
      204        size 10 by 1 tooltip "Остоновить процесс".
      205   define button B-viewProcInfo
      206        label "Информация"
      207        size 15 by 1 tooltip "Информация о процесс".
      208   define frame waitfram
      209     v-waitfram-action01 format "x(72)" no-label skip
      210     v-waitfram-action02 format "x(72)" no-label skip
      211     v-waitfram-action03 format "x(72)" no-label skip
      212     B-viewProcInfo
      213     B-WaitFramStop at row 4 col 30
      214     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      215     .
      216   define new global shared variable mBatchMode as logical no-undo init ?.
      217   define variable mFramBachModHandle as handle no-undo.
      218   mFramBachModHandle = frame waitfram:handle.
      219   define variable mFameOldVis as logical no-undo.
      220   define variable mVisCUrentVin as logical no-undo.
      221   if session:batch-mode
      222   then
      223      mBatchMode = yes.
      224   if mBatchMode = ? then do:
      225     mVisCUrentVin = current-window:visible.
      226     mFameOldVis = mFramBachModHandle:visible.
      227     mFramBachModHandle:visible  = yes.
      228     mBatchMode = mFramBachModHandle:visible ne yes.
      229     mFramBachModHandle:visible = mFameOldVis.
      230     current-window:visible = mVisCUrentVin.
      231   end.
      232    if  log-manager:logfile-name ne ?
      233     then DO:
      234         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      235         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      236         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      237     end.
      238   on choose of B-WaitFramStop in frame waitfram
      239   do:
      240     mWaitFramStop = yes.
      241     mWaitFramStopUser = yes.
      242   end.
      243   function waitfram-check-timeout returns logical():
      244      define variable vtime as int64 no-undo.
      245      if mWaitFramStopTimeOut
      246      then
      247         return yes.
      248      vtime = ( now - mWaitFramStartProc ) / 1000 .
      249      if     mWaitFramTimeOut ne ?
      250         and mWaitFramTimeOut ne 0
      251         and mWaitFramTimeOut lt vtime
      252      then do:
      253         mWaitFramStopTimeOut = yes.
      254      end.
      255      return mWaitFramStopTimeOut.
      256   end.
      257   procedure waitfram-hide :
      258     if not session:batch-mode
      259     then do
      260     on error undo, return error return-value
      261     :
      262       pause 0 before-hide .
      263       if not mBatchMode then
      264         hide frame waitfram .
      265     if     not mWaitFramView
      266        and mWaitProcEvent
      267     then
      268       process events .
      269     end.
      270   end procedure.
      271   procedure waitfram-show :
      272     define input  parameter p-message as character no-undo .
      273     define variable v-left-margin as integer   no-undo .
      274     if not session:batch-mode
      275     then do
      276     on error undo, return error return-value
      277     :
      278       if length(p-message) <= 70 then do:
      279         assign
      280           v-left-margin = integer((70 - length(p-message)) / 2)
      281         .
      282         assign
      283           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      284         .
      285         assign
      286           v-waitfram-action01 = " "
      287           v-waitfram-action02 = " "
      288                                    + fill(" ", v-left-margin)
      289                                    + p-message
      290           v-waitfram-action03 = " "
      291         .
      292       end.
      293       else do:
      294         define variable vRindex1 as integer no-undo.
      295         define variable vRindex2 as integer no-undo.
      296         vRindex1 = r-index(p-message," ",70).
      297         if vRindex1 = 0
      298         then
      299            vRindex1 = 70.
      300         if length(p-message)  <= vRindex1 + 70 then do:
      301           assign
      302             v-waitfram-action01 = " "
      303             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      304             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      305           .
      306         end.
      307         else do:
      308           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      309           if vRindex2 <= vRindex1
      310           then
      311              vRindex2 = vRindex1 + 70.
      312           assign
      313             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      314             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      315             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      316           .
      317         end.
      318       end.
      319       B-viewProcInfo:visible   in frame waitfram = no.
      320       B-viewProcInfo:sensitive in frame waitfram = no.
      321       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      322       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      323       if  (   mWaitFramView
      324          or  mWaitProcEvent)
      325          and not mBatchMode
      326       then
      327          display
      328             v-waitfram-action01 skip
      329             v-waitfram-action02 skip
      330             v-waitfram-action03 skip
      331          with frame waitfram .
      332       if     mWaitFramView
      333          then do:
      334             if     mWaitFramInterval ne ?
      335                and not mBatchMode
      336             then
      337                wait-for go of frame waitfram pause mWaitFramInterval.
      338          end.
      339          else
      340             if     mWaitProcEvent
      341                and not mBatchMode
      342             then
      343                process events .
      344     end.
      345   end procedure.
      346      procedure waitfram-show-this:
      347         define input  parameter iInterval as int64 no-undo.
      348         define variable vtime as int64 no-undo.
      349         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      350         mWaitFramInterval = iInterval.
      351         run waitfram-show (substitute("&1&2 &3&4" ,
      352                                       mWaitFramTextBeg ,
      353                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      354                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      355                                       mWaitFramTextEnd
      356                                      )
      357                           ).
      358      end.
      359      procedure WaitFramRunPause:
      360         define input  parameter iInterval as dec no-undo.
      361         define variable vStart  as datetime-tz no-undo.
      362         define variable vend    as datetime-tz no-undo.
      363         define variable vint as int64 no-undo.
      364         define variable vOk as logical no-undo.
      365         vStart = now.
      366         vend   = vStart.
      367         publish "WaitFramPause" (iInterval,output vOk).
      368         vend   =  now.
      369         vint = vend - vStart.
      370         vint = iInterval - vint / 1000.
      371         if     not mWaitFramStop
      372            and (   vint > 0
      373                 or (    not vOk
      374                     and iInterval eq ?
      375                     )
      376                 )
      377         then
      378            run waitfram-show-this (iInterval).
      379         vend   =  now.
      380         vint = vend - vStart.
      381         vint = iInterval - vint / 1000.
      382         if     not mWaitFramStop
      383            and vint > 0
      384         then do:
      385            run gbl/pause.p (vint * 1000).
      386         end.
      387         if iInterval ne ?
      388         then
      389            publish "WaitFramStop".
      390         waitfram-check-timeout().
      391      end.
      392      procedure WaitFramWaitFor:
      393         define input  parameter iInterval as dec no-undo.
      394         assign
      395            mWaitFramStartProc   = now
      396            mWaitFramStopUser    = no
      397            mWaitFramStopTimeOut = no
      398         .
      399         block-wait:
      400         do while not mWaitFramStop:
      401            run WaitFramRunPause (iInterval).
      402            if  waitfram-check-timeout()
      403            then do:
      404               leave block-wait.
      405            end.
      406         end.
      407         run waitfram-hide.
      408      end.
      409   procedure waitfram-join :
      410     define input  parameter p-line-1  as character no-undo .
      411     define input  parameter p-line-2  as character no-undo .
      412     define input  parameter p-line-3  as character no-undo .
      413     define output parameter p-message as character no-undo .
      414     do
      415     on error undo, return error return-value
      416     :
      417       assign
      418         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      419                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      420                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      421       .
      422     end.
      423   end procedure.
      424   function waitfram-join-function returns character
      425     (input p-line-1 as character
      426     ,input p-line-2 as character
      427     ,input p-line-3 as character
      428     ).
      429     define variable v-message as character no-undo .
      430     run waitfram-join in this-procedure
      431       (input  p-line-1
      432       ,input  p-line-2
      433       ,input  p-line-3
      434       ,output v-message
      435       ) .
      436     return v-message .
      437   end function .
      438   define variable v-rus-num-lines as integer   no-undo .
      439   define variable v-eng-num-lines as integer   no-undo .
      440   define temp-table temp-definitions no-undo
      441     field temp-name as character
      442     field temp-rus-line as integer
      443     field temp-eng-line as integer
      444     index xpk is primary unique temp-name .
      445   define stream sinp .
      446   define stream sout .
      447   do
      448   on error undo, leave
      449   on stop  undo, leave
      450   :
      451     define variable v-ok as logical   no-undo .
      452     run waitfram-show in this-procedure
      453       (input "Создание файла определений cmp/str-glbl.i"
      454       ) .
      455     define variable mFileStr as character no-undo.
      456     define variable mdir as character no-undo.
      457     define variable vi as integer no-undo.
      458     mFileStr = replace (search ("cmp/str-glbl.p"), "\","/").
      459     do vi = 1 to num-entries(mFileStr,"/") - 2:
      460        mdir = mdir + entry(vi,mFileStr,"/") + "/".
      461     end.
      462     run cmp/str-glbl.p
      463       (input mdir + 'cmp'
      464       ,output v-rus-num-lines
      465       ) 'rus':U .
      466     run waitfram-show in this-procedure
      467       (input "Создание файла определений int/cmp/str-glbl.i"
      468       ) .
      469     run cmp/str-glbl.p
      470       (input mdir + 'int/cmp':U
      471       ,output v-eng-num-lines
      472       ) 'eng':U .
      473     run waitfram-show in this-procedure
      474       (input "Проверка файлов определений cmp/str-glbl.i, int/cmp/str-glbl.i"
      475       ) .
      476     define variable v-line     as character no-undo .
      477     define variable v-line-num as integer   no-undo .
      478     assign
      479       v-line-num = 0
      480     .
      481     input stream sinp from value(search('cmp/str-glbl.i':U)) .
      482     repeat
      483     :
      484       assign
      485         v-line     = '':U
      486         v-line-num = v-line-num + 1
      487       .
      488       import stream sinp unformatted
      489         v-line
      490         .
      491       if v-line begins '&glob'
      492       then do:
      493         find first temp-definitions
      494           where temp-definitions.temp-name = entry(2, v-line, ' ':U)
      495           no-error .
      496         if not available temp-definitions
      497         then do:
      498           create temp-definitions .
      499           assign
      500             temp-definitions.temp-name     = entry(2, v-line, ' ':U)
      501           .
      502         end.
      503         assign
      504           temp-definitions.temp-rus-line = v-line-num
      505         .
      506       end.
      507     end.
      508     input stream sinp close .
      509     v-rus-num-lines = v-line-num.
      510     assign
      511       v-line-num = 0
      512     .
      513     if search("int/cmp/str-glbl.i") ne ?
      514     then do:
      515        input stream sinp from value(search('int/cmp/str-glbl.i':U)) .
      516        repeat
      517        :
      518          assign
      519            v-line     = '':U
      520            v-line-num = v-line-num + 1
      521          .
      522          import stream sinp unformatted
      523            v-line
      524            .
      525          if v-line begins '&glob'
      526          then do:
      527            find first temp-definitions
      528              where temp-definitions.temp-name = entry(2, v-line, ' ':U)
      529              no-error .
      530            if not available temp-definitions
      531            then do:
      532              create temp-definitions .
      533              assign
      534                temp-definitions.temp-name     = entry(2, v-line, ' ':U)
      535              .
      536            end.
      537            assign
      538              temp-definitions.temp-eng-line = v-line-num
      539            .
      540          end.
      541        end.
      542        input stream sinp close .
      543     end.
      544     v-eng-num-lines = v-line-num.
      545     define variable v-clear-file  as logical   no-undo .
      546     define variable v-error-exist as logical   no-undo .
      547     assign
      548       v-clear-file = true
      549     .
      550     for each temp-definitions
      551       where temp-definitions.temp-rus-line = 0
      552          or temp-definitions.temp-eng-line = 0
      553     on error undo, return error return-value
      554     :
      555       assign
      556         v-error-exist = true
      557       .
      558       if v-clear-file = true
      559       then do:
      560         assign
      561           v-clear-file = false
      562         .
      563         output stream sout to value('str-glbl_err.txt':U) .
      564         output stream sout close .
      565       end.
      566       output stream sout to value('str-glbl_err.txt':U) append .
      567       export stream sout temp-definitions .
      568       output stream sout close .
      569     end.
      570     run waitfram-hide in this-procedure .
      571     output to "error.log".
      572     if v-error-exist = true
      573     then do:
      574        put unformatted
      575         "Были обнаружены ошибки при создании файлов" skip
      576         "" skip
      577         "Создание файлов определений str-glbl.i завершено" skip
      578         "Файл" 'cmp/str-glbl.i':U skip
      579         "Строк в файле " v-rus-num-lines skip
      580         "Файл" 'int/cmp/str-glbl.i':U skip
      581         "Строк в файле " v-eng-num-lines skip
      582       .
      583     end.
      584     else do:
      585        put unformatted
      586         "OK" skip
      587         "" skip
      588         "Создание файлов определений str-glbl.i завершено" skip
      589         "Файл" 'cmp/str-glbl.i':U skip
      590         "Строк в файле " v-rus-num-lines skip
      591         "Файл" 'int/cmp/str-glbl.i':U skip
      592         "Строк в файле " v-eng-num-lines skip
      593        .
      594     end.
      595     output close.
      596   end.
      597      end.
      598      mliststrfile = "upd/code.xml,cmp/procasunc.xml".
      599      block-md5:
      600      do mi = 1 to num-entries(mliststrfile):
      601         mfile = entry(mi,mliststrfile).
      602         mfileNew = mFile.
      603         entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      604         if search (mfile) eq ?
      605         then
      606            next block-md5.
      607         run SaveFileList (mfile,mfileNew).
      608         do:
      609            mfileNew = search (mfile).
      610            entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      611            run gbl/md5.p(mfile,output v-md5-signature).
      612            output stream sOut to value(mfileNew).
      613            put stream sOut unformatted string(encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      614    )  skip.
      615            output stream sOut close.
      616         end.
      617      end.
      618      define variable mdbver as integer no-undo.
      619      block-upd:
      620      do mdbver = 1 to 999999999:
      621         mfile    = substitute("upd/&1.xml",string(mdbver ,"999999999")).
      622         if    search(mfile)    eq ?
      623         then
      624            leave block-upd.
      625         mfileNew = mFile.
      626         entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      627         run SaveFileList (mfile,mfileNew).
      628         mfile = search(mfile).
      629         mfileNew = mFile.
      630         entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      631         run gbl/md5.p(mfile,output v-md5-signature).
      632         output stream sOut to value(mfileNew).
      633         put stream sOut unformatted encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      634      skip.
      635         output stream sOut close.
      636      end.
      637      mDirUpdCk = objExists("updck","D").
      638      if mDirUpdCk <> ? then do:
      639          input stream dir-stream from os-dir( mDirUpdCk ) no-attr-list no-echo .
      640          block-updck:
      641          repeat:
      642             import stream dir-stream mfilename mfile .
      643             file-info :file-name = mfile.
      644             if caps( file-info :file-type ) begins "F":U and
      645                entry(2, file-info:file-name, ".") = "xml" then
      646             do:
      647                mfileNew = mFile.
      648                entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      649                run SaveFileList (mfile,mfileNew).
      650                mfile = search(mfile).
      651                mfileNew = mFile.
      652                entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      653                run gbl/md5.p(mfile,output v-md5-signature).
      654                output stream sOut to value(mfileNew).
      655                put stream sOut unformatted encode(v-md5-signature + "updck" ) + string(index(encode(string(v-md5-signature)), "k"))
      656      skip.
      657                output stream sOut close.
      658             end.
      659          end.
      660          input stream dir-stream close.
      661      end.
      662      mliststrfile = "cmp/actn.txt,cmp/menu.txt".
      663      do mi = 1 to num-entries(mliststrfile):
      664         mfile = entry(mi,mliststrfile).
      665         mfilenew = replace (mfile,".txt",".enc").
      666         run SaveFileList (mfile,mfileNew).
      667         mfile = search(mfile).
      668         chancriptone = yes.
      669         mfilenew = replace (mfile,".txt",".enc").
      670         if    chancriptone
      671            or search(mfilenew) eq ?
      672         then do:
      673             chancript = yes.
      674             run utl/filecrypnodb.p ( input mfile
      675                                  , input "sysadm"
      676                                  , input yes
      677                                  , input mfileNew
      678                                 ) .
      679         end.
      680      end.
      681      run utlcomp/crpwd.p(yes).
      682      run utlcomp/crkey.p(yes).
      683      run SaveFileList ("utlcomp/crpwd.p","utlcomp/crpwd.i").
      684      run SaveFileList ("utlcomp/crkey.p","utlcomp/keypub.i").
      685      run SaveFileList ("utlcomp/crkey.p","utlcomp/keypriv.i").
      686      run SaveFileList ("utlcomp/crkey.p","utlcomp/keyset.i").
      687   end.
      688   procedure SaveFileList:
      689      define input  parameter iFileNameOld as character no-undo.
      690      define input  parameter iFileNameNew as character no-undo.
      691      output stream sOut to value( mFileRes ) append.
      692      put stream sOut unformatted iFileNameOld  " " iFileNameNew skip.
      693      put stream sOut unformatted "utl/chkstrgbl.p " iFileNameNew skip.
      694      output stream sOut close.
      695   end.
      696   define stream sinp .
      697   procedure getverfile:
      698      define input  parameter iFileName as character no-undo.
      699      define output parameter oFilesize as integer   no-undo.
      700      define output parameter oFilever  as integer   no-undo.
      701      define variable vTXt as character no-undo.
      702      if iFileName eq ?
      703      then do:
      704         ofilesize = 0.
      705         return.
      706      end.
      707      else do:
      708         file-info:file-name = iFileName.
      709         ofilesize = file-info:file-size.
      710      end.
      711      input stream sinp from value(iFileName) .
      712      import stream sinp unformatted vTXt .
      713      oFilever = integer (trim(vtxt,'"')) no-error.
      714      input stream sinp close .
      715   end.
