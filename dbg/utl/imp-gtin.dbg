      426     field koef as decimal
      427   .
      428   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   define variable v-waitfram-action01         as character   no-undo .
      430   define variable v-waitfram-action02         as character   no-undo .
      431   define variable v-waitfram-action03         as character   no-undo .
      432   define variable mWaitFramTextBeg            as character   no-undo.
      433   define variable mWaitFramTextEnd            as character   no-undo.
      434   define variable mWaitFramView               as logical     no-undo.
      435   define variable mWaitProcEvent              as logical     no-undo init yes.
      436   define variable mWaitFramInterval           as integer     no-undo init 1 .
      437   define variable mWaitFramStop               as logical     no-undo.
      438   define variable mWaitFramStopUser           as logical     no-undo.
      439   define variable mWaitFramStopTimeOut        as logical     no-undo.
      440   define variable mWaitFramStartProc          as datetime-tz no-undo.
      441   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      442   define button B-WaitFramStop auto-end-key
      443        label "Стоп"
      444        size 10 by 1 tooltip "Остоновить процесс".
      445   define button B-viewProcInfo
      446        label "Информация"
      447        size 15 by 1 tooltip "Информация о процесс".
      448   define frame waitfram
      449     v-waitfram-action01 format "x(72)" no-label skip
      450     v-waitfram-action02 format "x(72)" no-label skip
      451     v-waitfram-action03 format "x(72)" no-label skip
      452     B-viewProcInfo
      453     B-WaitFramStop at row 4 col 30
      454     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      455     .
      456   define new global shared variable mBatchMode as logical no-undo init ?.
      457   define variable mFramBachModHandle as handle no-undo.
      458   mFramBachModHandle = frame waitfram:handle.
      459   define variable mFameOldVis as logical no-undo.
      460   define variable mVisCUrentVin as logical no-undo.
      461   if session:batch-mode
      462   then
      463      mBatchMode = yes.
      464   if mBatchMode = ? then do:
      465     mVisCUrentVin = current-window:visible.
      466     mFameOldVis = mFramBachModHandle:visible.
      467     mFramBachModHandle:visible  = yes.
      468     mBatchMode = mFramBachModHandle:visible ne yes.
      469     mFramBachModHandle:visible = mFameOldVis.
      470     current-window:visible = mVisCUrentVin.
      471   end.
      472    if  log-manager:logfile-name ne ?
      473     then DO:
      474         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      475         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      476         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      477     end.
      478   on choose of B-WaitFramStop in frame waitfram
      479   do:
      480     mWaitFramStop = yes.
      481     mWaitFramStopUser = yes.
      482   end.
      483   function waitfram-check-timeout returns logical():
      484      define variable vtime as int64 no-undo.
      485      if mWaitFramStopTimeOut
      486      then
      487         return yes.
      488      vtime = ( now - mWaitFramStartProc ) / 1000 .
      489      if     mWaitFramTimeOut ne ?
      490         and mWaitFramTimeOut ne 0
      491         and mWaitFramTimeOut lt vtime
      492      then do:
      493         mWaitFramStopTimeOut = yes.
      494      end.
      495      return mWaitFramStopTimeOut.
      496   end.
      497   procedure waitfram-hide :
      498     if not session:batch-mode
      499     then do
      500     on error undo, return error return-value
      501     :
      502       pause 0 before-hide .
      503       if not mBatchMode then
      504         hide frame waitfram .
      505     if     not mWaitFramView
      506        and mWaitProcEvent
      507     then
      508       process events .
      509     end.
      510   end procedure.
      511   procedure waitfram-show :
      512     define input  parameter p-message as character no-undo .
      513     define variable v-left-margin as integer   no-undo .
      514     if not session:batch-mode
      515     then do
      516     on error undo, return error return-value
      517     :
      518       if length(p-message) <= 70 then do:
      519         assign
      520           v-left-margin = integer((70 - length(p-message)) / 2)
      521         .
      522         assign
      523           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      524         .
      525         assign
      526           v-waitfram-action01 = " "
      527           v-waitfram-action02 = " "
      528                                    + fill(" ", v-left-margin)
      529                                    + p-message
      530           v-waitfram-action03 = " "
      531         .
      532       end.
      533       else do:
      534         define variable vRindex1 as integer no-undo.
      535         define variable vRindex2 as integer no-undo.
      536         vRindex1 = r-index(p-message," ",70).
      537         if vRindex1 = 0
      538         then
      539            vRindex1 = 70.
      540         if length(p-message)  <= vRindex1 + 70 then do:
      541           assign
      542             v-waitfram-action01 = " "
      543             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      544             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      545           .
      546         end.
      547         else do:
      548           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      549           if vRindex2 <= vRindex1
      550           then
      551              vRindex2 = vRindex1 + 70.
      552           assign
      553             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      554             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      555             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      556           .
      557         end.
      558       end.
      559       B-viewProcInfo:visible   in frame waitfram = no.
      560       B-viewProcInfo:sensitive in frame waitfram = no.
      561       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      562       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      563       if  (   mWaitFramView
      564          or  mWaitProcEvent)
      565          and not mBatchMode
      566       then
      567          display
      568             v-waitfram-action01 skip
      569             v-waitfram-action02 skip
      570             v-waitfram-action03 skip
      571          with frame waitfram .
      572       if     mWaitFramView
      573          then do:
      574             if     mWaitFramInterval ne ?
      575                and not mBatchMode
      576             then
      577                wait-for go of frame waitfram pause mWaitFramInterval.
      578          end.
      579          else
      580             if     mWaitProcEvent
      581                and not mBatchMode
      582             then
      583                process events .
      584     end.
      585   end procedure.
      586      procedure waitfram-show-this:
      587         define input  parameter iInterval as int64 no-undo.
      588         define variable vtime as int64 no-undo.
      589         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      590         mWaitFramInterval = iInterval.
      591         run waitfram-show (substitute("&1&2 &3&4" ,
      592                                       mWaitFramTextBeg ,
      593                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      594                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      595                                       mWaitFramTextEnd
      596                                      )
      597                           ).
      598      end.
      599      procedure WaitFramRunPause:
      600         define input  parameter iInterval as dec no-undo.
      601         define variable vStart  as datetime-tz no-undo.
      602         define variable vend    as datetime-tz no-undo.
      603         define variable vint as int64 no-undo.
      604         define variable vOk as logical no-undo.
      605         vStart = now.
      606         vend   = vStart.
      607         publish "WaitFramPause" (iInterval,output vOk).
      608         vend   =  now.
      609         vint = vend - vStart.
      610         vint = iInterval - vint / 1000.
      611         if     not mWaitFramStop
      612            and (   vint > 0
      613                 or (    not vOk
      614                     and iInterval eq ?
      615                     )
      616                 )
      617         then
      618            run waitfram-show-this (iInterval).
      619         vend   =  now.
      620         vint = vend - vStart.
      621         vint = iInterval - vint / 1000.
      622         if     not mWaitFramStop
      623            and vint > 0
      624         then do:
      625            run gbl/pause.p (vint * 1000).
      626         end.
      627         if iInterval ne ?
      628         then
      629            publish "WaitFramStop".
      630         waitfram-check-timeout().
      631      end.
      632      procedure WaitFramWaitFor:
      633         define input  parameter iInterval as dec no-undo.
      634         assign
      635            mWaitFramStartProc   = now
      636            mWaitFramStopUser    = no
      637            mWaitFramStopTimeOut = no
      638         .
      639         block-wait:
      640         do while not mWaitFramStop:
      641            run WaitFramRunPause (iInterval).
      642            if  waitfram-check-timeout()
      643            then do:
      644               leave block-wait.
      645            end.
      646         end.
      647         run waitfram-hide.
      648      end.
      649   procedure waitfram-join :
      650     define input  parameter p-line-1  as character no-undo .
      651     define input  parameter p-line-2  as character no-undo .
      652     define input  parameter p-line-3  as character no-undo .
      653     define output parameter p-message as character no-undo .
      654     do
      655     on error undo, return error return-value
      656     :
      657       assign
      658         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      659                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      660                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      661       .
      662     end.
      663   end procedure.
      664   function waitfram-join-function returns character
      665     (input p-line-1 as character
      666     ,input p-line-2 as character
      667     ,input p-line-3 as character
      668     ).
      669     define variable v-message as character no-undo .
      670     run waitfram-join in this-procedure
      671       (input  p-line-1
      672       ,input  p-line-2
      673       ,input  p-line-3
      674       ,output v-message
      675       ) .
      676     return v-message .
      677   end function .
      678   find first buf_units no-lock where buf_units.unit-name = "блок" no-error.
      679   if not available buf_units
      680   then do :
      681     find first buf_units no-lock where buf_units.long-name = "блок" no-error.
      682   end.
      683   if not available buf_units
      684   then do :
      685     message "В системе не найдена единица измерения 'блок'!" view-as alert-box error .
      686     return .
      687   end.
      688   do:
      689   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      690     run mainmenu_getcntxt in parparentproc
      691       (output v-cntxt-db-num
      692       ,output v-cntxt-userid
      693       ,output v-cntxt-level
      694       ,output v-cntxt-host-code-obj
      695       ,output v-cntxt-obj-type
      696       ,output v-cntxt-obj-code
      697       ,output v-cntxt-db-num-obj
      698       ,output v-cntxt-is-admin
      699       ) .
      700     define variable v-tth as handle no-undo.
      701     define variable v-chg-bcod as logical no-undo.
      702     define variable v-value-character as character no-undo.
      703     define variable v-value-date as date no-undo.
      704     define variable v-value-decimal as decimal no-undo.
      705     define variable v-value-integer as INTEGER no-undo.
      706     define variable v-value-logical AS LOGICAL no-undo.
      707     define variable v-param-type as character no-undo.
      708     define buffer buf_goods-attr for goods-attr.
      709     assign v-tth = buffer thbjattr_thbj-attr:table-handle.
      710     FOR EACH thbjattr_thbj-attr:
      711         delete thbjattr_thbj-attr.
      712     end.
      713     run adm/shattri.p (
      714               input "get":U
      715             , input v-cntxt-obj-type
      716             , input v-cntxt-obj-code
      717             , input 'gds-ref_obj':U
      718             , input 'chg-bcod':U
      719             , output v-value-character
      720             , output v-value-date
      721             , output v-value-decimal
      722             , output v-value-integer
      723             , output v-value-logical
      724             , output v-param-type
      725             , INPUT-OUTPUT table-handle v-tth
      726             ) no-error .
      727      v-chg-bcod = v-value-logical.
      728      if v-cntxt-db-num = 0 then v-chg-bcod = no .
      729   end.
      730   if v-chg-bcod
      731   then do :
      732     message "Запрещена работа с доп. БК. Импорт невозможен." view-as alert-box .
      733     return .
      734   end .
      735   SYSTEM-DIALOG GET-FILE
      736     v-imp-file
      737     FILTERS "Файлы Excel *.xlsx,*.xls" "*.xlsx,*.xls",
      738             "Все файлы"  "*.*"
      739     MUST-EXIST
      740     TITLE "Выберите файл для импорта"
      741     USE-FILENAME
      742     UPDATE v-log.
      743   if v-log <> true then do:
      744     return .
      745   end.
      746   run waitfram-show in this-procedure ( "ЖДИТЕ...") .
      747   CREATE "Excel.Application":U mExcelApplication no-error.
      748       if error-status :error then do:
      749           message
      750           "Ошибка при запуске Excel" skip
      751           error-status :get-message(1) skip
      752           view-as alert-box error .
      753           undo, return error .
      754       end.
      755   ASSIGN
      756       mExcelApplication:DisplayAlerts = NO
      757       mWorkbook                       = mExcelApplication:WorkBooks:Add(v-imp-file)
      758       mWorkSheet                      = mWorkbook:Sheets:Item(1)
      759   .
      760   loopbl:
      761   do vLine = 1 to 1000000:
      762     ASSIGN
      763       vChLine = STRING(vLine)
      764       v-gds-name    = ''
      765       v-b-code      = ''
      766       v-pack-gtin   = ''
      767       v-mark-code   = ''
      768       v-blok-b-code = ''
      769       v-blok-gtin   = ''
      770       v-blok-mark-code  = ''
      771       v-koef        = ''
      772     .
      773     v-num = mWorkSheet:Range("A" + vChLine):FORMULA NO-ERROR.
      774     if v-num = ? then v-num = mWorkSheet:Range("A" + vChLine):VALUE NO-ERROR.
      775     integer(v-num) no-error .
      776     if error-status:error then next loopbl .
      777     v-gds-name = mWorkSheet:Range("B" + vChLine):FORMULA NO-ERROR.
      778     if v-gds-name = ? then v-gds-name = mWorkSheet:Range("B" + vChLine):VALUE NO-ERROR.
      779     v-b-code = mWorkSheet:Range("C" + vChLine):FORMULA NO-ERROR.
      780     if v-b-code = ? then v-b-code = mWorkSheet:Range("C" + vChLine):VALUE NO-ERROR.
      781     v-pack-gtin = mWorkSheet:Range("D" + vChLine):FORMULA NO-ERROR.
      782     if v-pack-gtin = ? then v-pack-gtin = mWorkSheet:Range("D" + vChLine):VALUE NO-ERROR.
      783     v-mark-code = mWorkSheet:Range("E" + vChLine):FORMULA NO-ERROR.
      784     if v-mark-code = ? then v-mark-code = mWorkSheet:Range("E" + vChLine):VALUE NO-ERROR.
      785     v-blok-b-code = mWorkSheet:Range("F" + vChLine):FORMULA NO-ERROR.
      786     if v-blok-b-code = ? then v-blok-b-code = mWorkSheet:Range("F" + vChLine):VALUE NO-ERROR.
      787     v-blok-gtin = mWorkSheet:Range("G" + vChLine):FORMULA NO-ERROR.
      788     if v-blok-gtin = ? then v-blok-gtin = mWorkSheet:Range("G" + vChLine):VALUE NO-ERROR.
      789     v-blok-mark-code = mWorkSheet:Range("H" + vChLine):FORMULA NO-ERROR.
      790     if v-blok-mark-code = ? then v-blok-mark-code = mWorkSheet:Range("H" + vChLine):VALUE NO-ERROR.
      791     v-koef = mWorkSheet:Range("I" + vChLine):FORMULA NO-ERROR.
      792     if v-koef = ? then v-koef = mWorkSheet:Range("I" + vChLine):VALUE NO-ERROR.
      793     if length(v-gds-name) > 0
      794     or length(v-b-code) > 0
      795     or length(v-pack-gtin) > 0
      796     or length(v-mark-code) > 0
      797     or length(v-blok-b-code) > 0
      798     or length(v-blok-gtin) > 0
      799     or length(v-blok-mark-code) > 0
      800     or length(v-koef) > 0
      801     then do :
      802       vNoLine = 0 .
      803     end.
      804     else do :
      805       vNoLine = vNoLine + 1.
      806       IF vNoLine > mMaxNoLine THEN LEAVE loopbl.
      807       ELSE NEXT loopbl.
      808     end.
      809     create tt-gds-gtin .
      810     tt-gds-gtin.gds-name    = v-gds-name .
      811     tt-gds-gtin.b-code      = v-b-code no-error .
      812     tt-gds-gtin.pack-gtin   = v-pack-gtin .
      813     tt-gds-gtin.mark-code   = v-mark-code .
      814     tt-gds-gtin.blok-b-code = v-blok-b-code no-error .
      815     tt-gds-gtin.blok-gtin   = v-blok-gtin .
      816     tt-gds-gtin.blok-mark-code = v-blok-mark-code .
      817     tt-gds-gtin.koef        = decimal(v-koef) no-error .
      818     release tt-gds-gtin .
      819   end.
      820   v-lines = 0 .
      821   v-ok-lines = 0 .
      822   v-err-file = v-imp-file + ".err" .
      823   v-log-file = v-imp-file + ".log" .
      824   output stream s-err to value(v-err-file).
      825   output stream s-log to value(v-log-file).
      826   for each tt-gds-gtin no-lock :
      827     v-lines = v-lines + 1 .
      828     do trans :
      829       find first buf_prod-bc no-lock where buf_prod-bc.b-str = tt-gds-gtin.b-code no-error.
      830       if not available buf_prod-bc
      831       then do :
      832         export stream s-err delimiter ";" tt-gds-gtin .
      833         put stream s-log unformatted "Не найден доп. код " tt-gds-gtin.b-code skip skip .
      834         next .
      835       end.
      836       find first buf_bar-code no-lock where buf_bar-code.b-code = buf_prod-bc.b-code no-error .
      837       if not available buf_bar-code
      838       then do :
      839         export stream s-err delimiter ";" tt-gds-gtin .
      840         put stream s-log unformatted "Не найден собственный бар-код для штрих-кода " tt-gds-gtin.b-code skip skip .
      841         next .
      842       end.
      843       find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error.
      844       if not available buf_goods
      845       then do :
      846         export stream s-err delimiter ";" tt-gds-gtin .
      847         put stream s-log unformatted "Не найден товар с бар-кодом " string(buf_bar-code.b-code) " . Штрих-код - " tt-gds-gtin.b-code skip skip .
      848         next .
      849       end.
      850       find first goods-attr exclusive-lock where goods-attr.gds-code = buf_goods.gds-code
      851                                             and goods-attr.attr-code = 'mark-type':U
      852                                             no-error.
      853       if not available goods-attr
      854       then do :
      855         create goods-attr .
      856         assign
      857           goods-attr.gds-code = buf_goods.gds-code
      858           goods-attr.attr-code = 'mark-type':U
      859         .
      860       end.
      861       assign goods-attr.attr-value =  MarkType:tabak:nameprop.
      862       v-bar-code = buf_bar-code.b-code .
      863       v-b-str = tt-gds-gtin.pack-gtin .
      864       if trim(v-b-str) > ""
      865       then do :
      866         run trg/prod-bc2.p (
      867                             input parparentproc
      868                           ,input yes
      869                           ,input no
      870                           ,input yes
      871                           ,input no
      872                           ,input 'GTIN':U
      873                           ,input ''
      874                           ,buffer buf_goods
      875                           ,input v-bar-code
      876                           ,input no
      877                           ,input-output v-b-str
      878                           ,output v-bc-rid
      879                       ) no-error .
      880         if error-status :error
      881         or v-bc-rid = ?
      882         then do :
      883           export stream s-err delimiter ";" tt-gds-gtin .
      884           put stream s-log unformatted return-value skip skip .
      885           undo, next .
      886         end.
      887       end.
      888       v-b-str = tt-gds-gtin.mark-code .
      889       if trim(v-b-str) > ""
      890       then do :
      891         find first buf_prod-bc no-lock where buf_prod-bc.b-code = v-bar-code
      892                                          and buf_prod-bc.b-str = v-b-str
      893                                          no-error.
      894         if available buf_prod-bc
      895         then do :
      896           if buf_prod-bc.bc-on-type = 'GTIN':U
      897           then do :
      898             export stream s-err delimiter ";" tt-gds-gtin .
      899             put stream s-log unformatted "В системе уже есть код " v-b-str ", который является GTIN'ом. Его нельзя сделать маркированным." skip skip .
      900             undo, next .
      901           end.
      902           find first buf_prod-bc-attr exclusive-lock where buf_prod-bc-attr.b-str = buf_prod-bc.b-str
      903                                                        and buf_prod-bc-attr.b-code = buf_prod-bc.b-code
      904                                                        and buf_prod-bc-attr.attr-code = 'mark':U
      905                                                        no-error .
      906           if not available buf_prod-bc-attr
      907           then do :
      908             create buf_prod-bc-attr.
      909             assign
      910               buf_prod-bc-attr.b-str  = buf_prod-bc.b-str
      911               buf_prod-bc-attr.b-code = buf_prod-bc.b-code
      912               buf_prod-bc-attr.attr-code = 'mark':U
      913             .
      914           end.
      915           buf_prod-bc-attr.attr-value = "yes" .
      916         end.
      917         else do :
      918           run trg/prod-bc2.p (
      919                               input parparentproc
      920                             ,input yes
      921                             ,input no
      922                             ,input yes
      923                             ,input no
      924                             ,input ''
      925                             ,input ''
      926                             ,buffer buf_goods
      927                             ,input v-bar-code
      928                             ,input yes
      929                             ,input-output v-b-str
      930                             ,output v-bc-rid
      931                         ) no-error .
      932           if error-status :error
      933           or v-bc-rid = ?
      934           then do :
      935             export stream s-err delimiter ";" tt-gds-gtin .
      936             put stream s-log unformatted return-value skip skip .
      937             undo, next .
      938           end.
      939         end.
      940       end.
      941       if trim(tt-gds-gtin.blok-b-code) > ""
      942       or trim(tt-gds-gtin.blok-gtin) > ""
      943       or trim(tt-gds-gtin.blok-mark-code) > ""
      944       then do :
      945         integer(tt-gds-gtin.blok-b-code) no-error .
      946         if not error-status:error
      947         then do :
      948           find first bar-code no-lock where bar-code.b-code = integer(tt-gds-gtin.blok-b-code) no-error.
      949           if available bar-code
      950           then do :
      951             if bar-code.gds-code <> buf_goods.gds-code
      952             then do :
      953               export stream s-err delimiter ";" tt-gds-gtin .
      954               put stream s-log unformatted "Уже есть бар-код " string(tt-gds-gtin.blok-b-code) " для товара с кодом " string(bar-code.gds-code) skip skip .
      955               undo, next .
      956             end.
      957             if  bar-code.unit-cli = buf_units.unit-name
      958             and bar-code.cli-base-rate = tt-gds-gtin.koef
      959             then do :
      960               find first blok_bar-code no-lock where recid(blok_bar-code) = recid(bar-code) no-error .
      961             end.
      962           end.
      963         end.
      964         if not available blok_bar-code
      965         then do :
      966           find first prod-bc no-lock where prod-bc.b-str = tt-gds-gtin.blok-b-code no-error.
      967           if available prod-bc
      968           then do :
      969             find first blok_bar-code no-lock where blok_bar-code.b-code = prod-bc.b-code
      970                                                and blok_bar-code.gds-code = buf_goods.gds-code
      971                                                and blok_bar-code.unit-cli = buf_units.unit-name
      972                                                and blok_bar-code.cli-base-rate = tt-gds-gtin.koef
      973                                                no-error .
      974           end.
      975         end.
      976         if not available blok_bar-code
      977         then do :
      978           find first blok_bar-code no-lock where blok_bar-code.gds-code = buf_goods.gds-code
      979                                              and blok_bar-code.unit-cli = buf_units.unit-name
      980                                              and blok_bar-code.cli-base-rate = tt-gds-gtin.koef
      981                                              no-error .
      982         end.
      983         if not available blok_bar-code
      984         then do :
      985           find first blok_bar-code no-lock where blok_bar-code.gds-code = buf_goods.gds-code
      986                                              and blok_bar-code.unit-cli = buf_units.unit-name
      987                                              no-error .
      988           if available blok_bar-code and blok_bar-code.cli-base-rate <> tt-gds-gtin.koef
      989           then do :
      990             export stream s-err delimiter ";" tt-gds-gtin .
      991             put stream s-log unformatted "Товар " string(buf_goods.gds-code) "  " buf_goods.gds-name " . Коэффициент для блока в файле не равен коэффициенту в TH." skip skip .
      992             undo, next .
      993           end.
      994         end.
      995         if not available blok_bar-code
      996         then do :
      997           find gds-prt no-lock where gds-prt.node-code = buf_bar-code.node-code .
      998           run ref/barcode1.p (
      999                              input 'ДОБАВЛЕНИЕ':U
     1000                             ,input yes
     1001                             ,input 0
     1002                             ,input buf_goods.gds-code
     1003                             ,input gds-prt.node-code
     1004                             ,input buf_bar-code.part-code
     1005                             ,input buf_bar-code.in-code
     1006                             ,input buf_units.unit-name
     1007                             ,input tt-gds-gtin.koef
     1008                             ,output v-bc-rid) no-error.
     1009           if error-status :error
     1010           then do :
     1011             export stream s-err delimiter ";" tt-gds-gtin .
     1012             put stream s-log unformatted return-value skip skip .
     1013             undo, next .
     1014           end.
     1015           find first blok_bar-code no-lock where recid(blok_bar-code) = v-bc-rid no-error .
     1016           if not available blok_bar-code
     1017           then do :
     1018             export stream s-err delimiter ";" tt-gds-gtin .
     1019             put stream s-log unformatted return-value skip skip .
     1020             undo, next .
     1021           end.
     1022         end.
     1023         v-bar-code = blok_bar-code.b-code .
     1024         v-b-str = tt-gds-gtin.blok-b-code .
     1025         if trim(v-b-str) > ""
     1026         then do :
     1027           run trg/prod-bc2.p (
     1028                               input parparentproc
     1029                             ,input yes
     1030                             ,input no
     1031                             ,input yes
     1032                             ,input no
     1033                             ,input ''
     1034                             ,input ''
     1035                             ,buffer buf_goods
     1036                             ,input v-bar-code
     1037                             ,input no
     1038                             ,input-output v-b-str
     1039                             ,output v-bc-rid
     1040                         ) no-error .
     1041           if error-status :error
     1042           or v-bc-rid = ?
     1043           then do :
     1044             export stream s-err delimiter ";" tt-gds-gtin .
     1045             put stream s-log unformatted return-value skip skip .
     1046             undo, next .
     1047           end.
     1048         end.
     1049         v-b-str = tt-gds-gtin.blok-gtin .
     1050         if trim(v-b-str) > ""
     1051         then do :
     1052           find first prod-bc no-lock where prod-bc.b-str = v-b-str no-error .
     1053           if available prod-bc
     1054           then do :
     1055             find first bar-code no-lock where bar-code.b-code = prod-bc.b-code no-error.
     1056             if not available bar-code
     1057             then do :
     1058               export stream s-err delimiter ";" tt-gds-gtin .
     1059               put stream s-log unformatted return-value skip skip .
     1060               undo, next .
     1061             end.
     1062             if bar-code.gds-code <> buf_goods.gds-code
     1063             then do :
     1064               export stream s-err delimiter ";" tt-gds-gtin .
     1065               put stream s-log unformatted "Товар " string(buf_goods.gds-code) "  " buf_goods.gds-name " уже есть доп. код " v-b-str " и он относится к другому товару - " string(bar-code.gds-code) skip skip .
     1066               undo, next .
     1067             end.
     1068             if prod-bc.bc-on-type <> 'GTIN':U
     1069             then do :
     1070               export stream s-err delimiter ";" tt-gds-gtin .
     1071               put stream s-log unformatted "Товар " string(buf_goods.gds-code) "  " buf_goods.gds-name " уже есть доп. код " v-b-str " и его тип не GTIN" skip skip .
     1072               undo, next .
     1073             end.
     1074           end.
     1075           else do :
     1076             run trg/prod-bc2.p (
     1077                                 input parparentproc
     1078                               ,input yes
     1079                               ,input no
     1080                               ,input yes
     1081                               ,input no
     1082                               ,input 'GTIN':U
     1083                               ,input ''
     1084                               ,buffer buf_goods
     1085                               ,input v-bar-code
     1086                               ,input no
     1087                               ,input-output v-b-str
     1088                               ,output v-bc-rid
     1089                           ) no-error .
     1090             if error-status :error
     1091             or v-bc-rid = ?
     1092             then do :
     1093               export stream s-err delimiter ";" tt-gds-gtin .
     1094               put stream s-log unformatted return-value skip skip .
     1095               undo, next .
     1096             end.
     1097           end.
     1098         end.
     1099         v-b-str = tt-gds-gtin.blok-mark-code .
     1100         if trim(v-b-str) > ""
     1101         then do :
     1102           find first buf_prod-bc no-lock where buf_prod-bc.b-code = v-bar-code
     1103                                            and buf_prod-bc.b-str = v-b-str
     1104                                            no-error.
     1105           if available buf_prod-bc
     1106           then do :
     1107             find first buf_prod-bc-attr exclusive-lock where buf_prod-bc-attr.b-str = buf_prod-bc.b-str
     1108                                                          and buf_prod-bc-attr.b-code = buf_prod-bc.b-code
     1109                                                          and buf_prod-bc-attr.attr-code = 'mark':U
     1110                                                          no-error .
     1111             if not available buf_prod-bc-attr
     1112             then do :
     1113               create buf_prod-bc-attr.
     1114               assign
     1115                 buf_prod-bc-attr.b-str  = buf_prod-bc.b-str
     1116                 buf_prod-bc-attr.b-code = buf_prod-bc.b-code
     1117                 buf_prod-bc-attr.attr-code = 'mark':U
     1118               .
     1119             end.
     1120             buf_prod-bc-attr.attr-value = "yes" .
     1121           end.
     1122           else do :
     1123             run trg/prod-bc2.p (
     1124                                 input parparentproc
     1125                               ,input yes
     1126                               ,input no
     1127                               ,input yes
     1128                               ,input no
     1129                               ,input ''
     1130                               ,input ''
     1131                               ,buffer buf_goods
     1132                               ,input v-bar-code
     1133                               ,input yes
     1134                               ,input-output v-b-str
     1135                               ,output v-bc-rid
     1136                           ) no-error .
     1137             if error-status :error
     1138             or v-bc-rid = ?
     1139             then do :
     1140               export stream s-err delimiter ";" tt-gds-gtin .
     1141               put stream s-log unformatted return-value skip skip .
     1142               undo, next .
     1143             end.
     1144           end.
     1145         end.
     1146       end.
     1147       v-ok-lines = v-ok-lines + 1 .
     1148     end.
     1149   end.
     1150   output stream s-err close .
     1151   output stream s-log close .
     1152   run waitfram-hide in this-procedure .
     1153   message "Готово. Обработано " string(v-lines) " строк. Загружено " string(v-ok-lines) "." skip
     1154           "Незагруженные коды в файле " v-err-file skip
     1155           "Ошибки в файле " v-log-file view-as alert-box information .
