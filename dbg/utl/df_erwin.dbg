        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: df_erwin.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/df_erwin.p $":U .
        7   define variable vss-description as character no-undo init "Создания файла прав доступа, описаний и форматов полей для пакета смены версии".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure cur-time :
       68      define output parameter p-today as date      no-undo .
       69      define output parameter p-time  as integer   no-undo .
       70     do
       71     on error undo, return error
       72     :
       73       define variable v-date1 as date      no-undo .
       74       define variable v-date2 as date      no-undo .
       75       define variable v-time  as integer   no-undo .
       76       assign
       77         v-date1 = today
       78         v-time  = time
       79         v-date2 = today
       80       .
       81       if v-date1 <> v-date2
       82       then do:
       83         assign
       84           v-date1 = today
       85           v-time  = v-time
       86         .
       87       end.
       88       assign
       89         p-today = v-date1
       90         p-time  = v-time
       91       .
       92     end.
       93   end.
       94   function cur-time-date returns character
       95   :
       96     return string(today, '99/99/9999':U) .
       97   end.
       98   function cur-time-mjd returns decimal
       99   :
      100     define variable v-date as date      no-undo .
      101     define variable v-time as integer   no-undo .
      102     run cur-time in this-procedure
      103       (output v-date
      104       ,output v-time
      105       ) .
      106     return integer(v-date) - 2400002 + (v-time / 86400) .
      107   end.
      108   function cur-time-get-ending-index returns integer
      109   (input p-number as integer
      110   )
      111   :
      112     if p-number < 0
      113     or p-number = ?
      114     then do:
      115       return 1 .
      116     end.
      117     define variable v-rest as integer   no-undo .
      118     assign
      119       p-number = p-number modulo 100
      120     .
      121     if p-number < 20
      122     then do:
      123       assign
      124         v-rest = p-number
      125       .
      126     end.
      127     else do:
      128       assign
      129         v-rest = p-number modulo 10
      130       .
      131     end.
      132     case v-rest :
      133       when 1
      134       then do:
      135         return 2 .
      136       end.
      137       when 2 or
      138       when 3 or
      139       when 4
      140       then do:
      141         return 3 .
      142       end.
      143       otherwise do:
      144         return 1 .
      145       end.
      146     end case .
      147   end.
      148   procedure cur-time-mjd-to-date :
      149      define input  parameter i-mjd-diff as decimal no-undo.
      150      define output parameter o-Date     as date    no-undo.
      151      define output parameter o-Time     as integer no-undo.
      152      define variable v-day-number as integer   no-undo .
      153      if    i-mjd-diff < 0
      154         or i-mjd-diff = ?
      155      then do:
      156         return "?" .
      157      end.
      158      assign
      159         v-day-number = truncate(i-mjd-diff,0).
      160         o-Date = date(v-day-number + 2400002).
      161         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      162     .
      163   end.
      164   function cur-time-mjd-to-string returns character
      165   (input p-mjd-diff as decimal
      166   )
      167   :
      168     define variable v-day-number as integer   no-undo .
      169     define variable v-seconds    as integer   no-undo .
      170     define variable v-hour       as integer   no-undo .
      171     define variable v-min        as integer   no-undo .
      172     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      173     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      174     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      175     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      176     if p-mjd-diff < 0
      177     or p-mjd-diff = ?
      178     then do:
      179       return "?" .
      180     end.
      181     assign
      182       v-day-number = integer(truncate(p-mjd-diff,0))
      183       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185     if v-seconds > 86400
      186     then do:
      187       assign
      188         v-seconds = 86400 - 1
      189       .
      190     end.
      191     if v-seconds < 0
      192     then do:
      193       assign
      194         v-seconds = 0
      195       .
      196     end.
      197     assign
      198       v-hour = truncate(v-seconds / 3600, 0)
      199     .
      200     assign
      201       v-seconds = v-seconds modulo 3600
      202     .
      203     assign
      204       v-min = truncate(v-seconds / 60, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 60
      208     .
      209     return
      210         (if v-day-number <> 0
      211           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      212           else ""
      213         )
      214       + (if v-day-number <> 0 or v-hour <> 0
      215           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      219           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      220           else ""
      221         )
      222       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      223       .
      224   end.
      225   function cur-time-string returns character
      226   :
      227     define variable v-date as date      no-undo .
      228     define variable v-time as integer   no-undo .
      229     run cur-time in this-procedure
      230       (output v-date
      231       ,output v-time
      232       ) .
      233     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      234   end.
      235   function cur-time-string-sec returns character
      236   :
      237     define variable v-date as date      no-undo .
      238     define variable v-time as integer   no-undo .
      239     run cur-time in this-procedure
      240       (output v-date
      241       ,output v-time
      242       ) .
      243     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      244   end.
      245   function cur-time-custom  returns character
      246   (input p-prefix as character
      247   ,input p-date-format as character
      248   ,input p-delimiter as character
      249   ,input p-time-format as character
      250   ,input p-suffix as character
      251   )
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return
      260       p-prefix
      261       + string(v-date, p-date-format)
      262       + p-delimiter
      263       + string(v-time, p-time-format)
      264       + p-suffix
      265       .
      266   end.
      267   function cur-time-print  returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      276   end.
      277   function cur-time-datetime returns datetime
      278   :
      279     define variable v-char as character no-undo .
      280     define variable v-datetime as datetime no-undo .
      281     v-char = cur-time-string().
      282     v-datetime = datetime(v-char).
      283     return  v-datetime.
      284   end.
      285   function cur-time-string-msec returns character
      286   :
      287     define variable v-date as datetime  no-undo .
      288     v-date = now.
      289     return string(v-date) .
      290   end.
      291   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   define variable v-waitfram-action01         as character   no-undo .
      293   define variable v-waitfram-action02         as character   no-undo .
      294   define variable v-waitfram-action03         as character   no-undo .
      295   define variable mWaitFramTextBeg            as character   no-undo.
      296   define variable mWaitFramTextEnd            as character   no-undo.
      297   define variable mWaitFramView               as logical     no-undo.
      298   define variable mWaitProcEvent              as logical     no-undo init yes.
      299   define variable mWaitFramInterval           as integer     no-undo init 1 .
      300   define variable mWaitFramStop               as logical     no-undo.
      301   define variable mWaitFramStopUser           as logical     no-undo.
      302   define variable mWaitFramStopTimeOut        as logical     no-undo.
      303   define variable mWaitFramStartProc          as datetime-tz no-undo.
      304   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      305   define button B-WaitFramStop auto-end-key
      306        label "Стоп"
      307        size 10 by 1 tooltip "Остоновить процесс".
      308   define button B-viewProcInfo
      309        label "Информация"
      310        size 15 by 1 tooltip "Информация о процесс".
      311   define frame waitfram
      312     v-waitfram-action01 format "x(72)" no-label skip
      313     v-waitfram-action02 format "x(72)" no-label skip
      314     v-waitfram-action03 format "x(72)" no-label skip
      315     B-viewProcInfo
      316     B-WaitFramStop at row 4 col 30
      317     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      318     .
      319   define new global shared variable mBatchMode as logical no-undo init ?.
      320   define variable mFramBachModHandle as handle no-undo.
      321   mFramBachModHandle = frame waitfram:handle.
      322   define variable mFameOldVis as logical no-undo.
      323   define variable mVisCUrentVin as logical no-undo.
      324   if session:batch-mode
      325   then
      326      mBatchMode = yes.
      327   if mBatchMode = ? then do:
      328     mVisCUrentVin = current-window:visible.
      329     mFameOldVis = mFramBachModHandle:visible.
      330     mFramBachModHandle:visible  = yes.
      331     mBatchMode = mFramBachModHandle:visible ne yes.
      332     mFramBachModHandle:visible = mFameOldVis.
      333     current-window:visible = mVisCUrentVin.
      334   end.
      335    if  log-manager:logfile-name ne ?
      336     then DO:
      337         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      338         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      339         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      340     end.
      341   on choose of B-WaitFramStop in frame waitfram
      342   do:
      343     mWaitFramStop = yes.
      344     mWaitFramStopUser = yes.
      345   end.
      346   function waitfram-check-timeout returns logical():
      347      define variable vtime as int64 no-undo.
      348      if mWaitFramStopTimeOut
      349      then
      350         return yes.
      351      vtime = ( now - mWaitFramStartProc ) / 1000 .
      352      if     mWaitFramTimeOut ne ?
      353         and mWaitFramTimeOut ne 0
      354         and mWaitFramTimeOut lt vtime
      355      then do:
      356         mWaitFramStopTimeOut = yes.
      357      end.
      358      return mWaitFramStopTimeOut.
      359   end.
      360   procedure waitfram-hide :
      361     if not session:batch-mode
      362     then do
      363     on error undo, return error return-value
      364     :
      365       pause 0 before-hide .
      366       if not mBatchMode then
      367         hide frame waitfram .
      368     if     not mWaitFramView
      369        and mWaitProcEvent
      370     then
      371       process events .
      372     end.
      373   end procedure.
      374   procedure waitfram-show :
      375     define input  parameter p-message as character no-undo .
      376     define variable v-left-margin as integer   no-undo .
      377     if not session:batch-mode
      378     then do
      379     on error undo, return error return-value
      380     :
      381       if length(p-message) <= 70 then do:
      382         assign
      383           v-left-margin = integer((70 - length(p-message)) / 2)
      384         .
      385         assign
      386           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      387         .
      388         assign
      389           v-waitfram-action01 = " "
      390           v-waitfram-action02 = " "
      391                                    + fill(" ", v-left-margin)
      392                                    + p-message
      393           v-waitfram-action03 = " "
      394         .
      395       end.
      396       else do:
      397         define variable vRindex1 as integer no-undo.
      398         define variable vRindex2 as integer no-undo.
      399         vRindex1 = r-index(p-message," ",70).
      400         if vRindex1 = 0
      401         then
      402            vRindex1 = 70.
      403         if length(p-message)  <= vRindex1 + 70 then do:
      404           assign
      405             v-waitfram-action01 = " "
      406             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      407             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      408           .
      409         end.
      410         else do:
      411           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      412           if vRindex2 <= vRindex1
      413           then
      414              vRindex2 = vRindex1 + 70.
      415           assign
      416             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      417             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      418             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      419           .
      420         end.
      421       end.
      422       B-viewProcInfo:visible   in frame waitfram = no.
      423       B-viewProcInfo:sensitive in frame waitfram = no.
      424       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      425       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      426       if  (   mWaitFramView
      427          or  mWaitProcEvent)
      428          and not mBatchMode
      429       then
      430          display
      431             v-waitfram-action01 skip
      432             v-waitfram-action02 skip
      433             v-waitfram-action03 skip
      434          with frame waitfram .
      435       if     mWaitFramView
      436          then do:
      437             if     mWaitFramInterval ne ?
      438                and not mBatchMode
      439             then
      440                wait-for go of frame waitfram pause mWaitFramInterval.
      441          end.
      442          else
      443             if     mWaitProcEvent
      444                and not mBatchMode
      445             then
      446                process events .
      447     end.
      448   end procedure.
      449      procedure waitfram-show-this:
      450         define input  parameter iInterval as int64 no-undo.
      451         define variable vtime as int64 no-undo.
      452         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      453         mWaitFramInterval = iInterval.
      454         run waitfram-show (substitute("&1&2 &3&4" ,
      455                                       mWaitFramTextBeg ,
      456                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      457                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      458                                       mWaitFramTextEnd
      459                                      )
      460                           ).
      461      end.
      462      procedure WaitFramRunPause:
      463         define input  parameter iInterval as dec no-undo.
      464         define variable vStart  as datetime-tz no-undo.
      465         define variable vend    as datetime-tz no-undo.
      466         define variable vint as int64 no-undo.
      467         define variable vOk as logical no-undo.
      468         vStart = now.
      469         vend   = vStart.
      470         publish "WaitFramPause" (iInterval,output vOk).
      471         vend   =  now.
      472         vint = vend - vStart.
      473         vint = iInterval - vint / 1000.
      474         if     not mWaitFramStop
      475            and (   vint > 0
      476                 or (    not vOk
      477                     and iInterval eq ?
      478                     )
      479                 )
      480         then
      481            run waitfram-show-this (iInterval).
      482         vend   =  now.
      483         vint = vend - vStart.
      484         vint = iInterval - vint / 1000.
      485         if     not mWaitFramStop
      486            and vint > 0
      487         then do:
      488            run gbl/pause.p (vint * 1000).
      489         end.
      490         if iInterval ne ?
      491         then
      492            publish "WaitFramStop".
      493         waitfram-check-timeout().
      494      end.
      495      procedure WaitFramWaitFor:
      496         define input  parameter iInterval as dec no-undo.
      497         assign
      498            mWaitFramStartProc   = now
      499            mWaitFramStopUser    = no
      500            mWaitFramStopTimeOut = no
      501         .
      502         block-wait:
      503         do while not mWaitFramStop:
      504            run WaitFramRunPause (iInterval).
      505            if  waitfram-check-timeout()
      506            then do:
      507               leave block-wait.
      508            end.
      509         end.
      510         run waitfram-hide.
      511      end.
      512   procedure waitfram-join :
      513     define input  parameter p-line-1  as character no-undo .
      514     define input  parameter p-line-2  as character no-undo .
      515     define input  parameter p-line-3  as character no-undo .
      516     define output parameter p-message as character no-undo .
      517     do
      518     on error undo, return error return-value
      519     :
      520       assign
      521         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      522                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      523                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      524       .
      525     end.
      526   end procedure.
      527   function waitfram-join-function returns character
      528     (input p-line-1 as character
      529     ,input p-line-2 as character
      530     ,input p-line-3 as character
      531     ).
      532     define variable v-message as character no-undo .
      533     run waitfram-join in this-procedure
      534       (input  p-line-1
      535       ,input  p-line-2
      536       ,input  p-line-3
      537       ,output v-message
      538       ) .
      539     return v-message .
      540   end function .
      541   define variable v-new-format as character no-undo .
      542   define variable v-ok  as logical no-undo .
      543   define variable v-today as date      no-undo.
      544   define variable v-time  as integer   no-undo.
      545   define stream slog .
      546   FUNCTION escape-description RETURNS CHARACTER
      547   ( p-description as character )
      548   :
      549     define variable v-new-description as character no-undo .
      550     assign
      551       v-new-description = replace(p-description, 'я', 'Я')
      552       v-new-description = replace(v-new-description, '"', '')
      553       v-new-description = replace(v-new-description, chr(10), ' ')
      554     .
      555     return v-new-description .
      556   END FUNCTION.
      557   do
      558   on error undo, return error
      559   :
      560     message
      561       "Создание файла описания базы для синхронизации с ERWin" skip
      562       "Продолжить?" skip
      563       view-as alert-box question buttons yes-no update v-ok .
      564     if v-ok <> true
      565     then do:
      566       return .
      567     end.
      568     define variable v-file-name as character no-undo .
      569     assign
      570       v-file-name = 'df_erwin.df':U
      571     .
      572     output stream slog to value(v-file-name) .
      573     define variable v-ind               as integer   no-undo .
      574     define variable v-table-description as character no-undo .
      575     define variable v-field-format      as character no-undo .
      576     define variable v-field-initial     as character no-undo .
      577     for each _File no-lock
      578       where _File._Hidden = false
      579     by _file._file-name
      580     on error undo, return error
      581     :
      582       assign
      583         v-table-description = _file._Desc
      584       .
      585       if v-table-description = ?
      586       or v-table-description = '':U
      587       then do:
      588         assign
      589           v-table-description = 'table_':U + _file._File-name
      590         .
      591       end.
      592       assign
      593         v-ind = v-ind + 1
      594       .
      595       if v-ind modulo 10 = 0
      596       then do:
      597         run waitfram-show in this-procedure
      598           (input "Анализ таблицы " + _File._File-Name
      599           ).
      600       end.
      601       put stream slog unformatted
      602         'ADD TABLE "' + _File._File-Name + '"' + chr(10)
      603         .
      604       put stream slog unformatted
      605         '  DESCRIPTION ' .
      606       export stream slog
      607           escape-description(v-table-description)
      608         .
      609       put stream slog unformatted
      610         chr(10)
      611         .
      612       field-block:
      613       for each _Field of _File no-lock
      614         by _field._field-rpos
      615       on error undo, return error
      616       :
      617         define variable ind as integer no-undo .
      618         put stream slog unformatted
      619           'ADD FIELD "' + _Field._Field-Name + '" OF "' + _File._File-Name + '" AS '
      620           + _Field._Data-type
      621           + chr(10)
      622           .
      623         if  _Field._Desc <> ?
      624         and _Field._Desc <> '':U
      625         then do:
      626           put stream slog unformatted
      627             '  DESCRIPTION ' .
      628           export stream slog
      629               escape-description(_Field._Desc)
      630             .
      631         end.
      632         assign
      633           v-field-format  = _Field._Format
      634           v-field-initial = _Field._Initial
      635         .
      636         if  _Field._Data-type = 'logical':U
      637         and v-field-format    <> ?
      638         and v-field-format    <> '':U
      639         and v-field-initial   <> ?
      640         and v-field-initial   <> '':U
      641         then do:
      642           if lookup(v-field-initial, 'yes,no':U) = 0
      643           then do:
      644             assign
      645               v-field-initial = (if lookup(v-field-initial, v-field-format) = 1
      646                                  then 'yes':U
      647                                  else 'no':U
      648                                 )
      649             .
      650           end.
      651           if v-field-format <> 'yes/no':U
      652           then do:
      653             assign
      654               v-field-format = 'yes/no':U
      655             .
      656           end.
      657         end.
      658         if  _Field._Data-type = 'character':U
      659         then do:
      660           if v-field-initial = '*'
      661           then do:
      662             assign
      663               v-field-initial = '':U
      664             .
      665           end.
      666         end.
      667         if _Field._Data-type = 'integer'
      668         or _Field._Data-type = 'decimal'
      669         then do:
      670           if index(_field._field-name, "db-num") > 0
      671           and _field._format = ">>>>9" then do:
      672             v-field-format = _field._format.
      673           end.
      674           else do:
      675             assign
      676               v-field-format = replace(v-field-format, chr(44), '':U)
      677             .
      678             define variable v-format-sign-part   as character no-undo .
      679             define variable v-format-first-part  as character no-undo .
      680             define variable v-format-second-part as character no-undo .
      681             if substring(v-field-format, 1, 1) = '-':U
      682             then do:
      683               assign
      684                 v-format-sign-part = substring(v-field-format, 1, 1)
      685                 v-field-format     = substring(v-field-format, 2)
      686               .
      687             end.
      688             else do:
      689               assign
      690                 v-format-sign-part = '':U
      691               .
      692             end.
      693             if num-entries(v-field-format, '.') > 1
      694             then do:
      695               assign
      696                 v-format-first-part  = entry(1, v-field-format, '.')
      697                 v-format-second-part = entry(2, v-field-format, '.')
      698               .
      699               assign
      700                 v-format-first-part  = replace(v-format-first-part,  'z':U, '>':U)
      701                 v-format-second-part = replace(v-format-second-part, 'z':U, '<':U)
      702               .
      703             end.
      704             else do:
      705               assign
      706                 v-format-first-part  = v-field-format
      707                 v-format-second-part = '':U
      708               .
      709             end.
      710             if length(v-format-first-part) > 0
      711             then do:
      712               define variable v-add-symbol            as integer   no-undo .
      713               define variable v-cycle-index           as integer   no-undo .
      714               define variable v-new-format-first-part as character no-undo .
      715               assign
      716                 v-add-symbol = (3 - length(v-format-first-part) modulo 3) modulo 3
      717               .
      718               assign
      719                 v-format-first-part = fill('_':U, v-add-symbol) + v-format-first-part
      720               .
      721               assign
      722                 v-new-format-first-part = '':U
      723               .
      724               do v-cycle-index = 1 to (length(v-format-first-part) / 3)
      725               :
      726                 assign
      727                   v-new-format-first-part = v-new-format-first-part
      728                                           + (if v-new-format-first-part <> '':U
      729                                             then chr(44)
      730                                             else '':U
      731                                             )
      732                                           + substring(v-format-first-part
      733                                                     ,(v-cycle-index - 1) * 3 + 1
      734                                                     ,3
      735                                                     )
      736                 .
      737               end.
      738               assign
      739                 v-format-first-part = substring(v-new-format-first-part, v-add-symbol + 1)
      740               .
      741               assign
      742                 v-field-format = v-format-sign-part
      743                               + v-format-first-part
      744                               + (if v-format-second-part <> '':U
      745                                   then '.':U
      746                                   else '':U
      747                                 )
      748                               + v-format-second-part
      749               .
      750             end.
      751           end.
      752         end.
      753         if  v-field-format <> ?
      754         and v-field-format <> '':U
      755         then do:
      756           put stream slog unformatted
      757             '  FORMAT ' .
      758           export stream slog
      759               escape-description(v-field-format)
      760             .
      761         end.
      762         if v-field-initial <> ?
      763         then do:
      764           put stream slog unformatted
      765             '  INITIAL ' .
      766           export stream slog
      767               escape-description(v-field-initial)
      768             .
      769         end.
      770         else do:
      771           put stream slog unformatted
      772             '  INITIAL ?' + chr(10) .
      773         end.
      774         define variable v-field-label        as character no-undo .
      775         define variable v-field-column-label as character no-undo .
      776         assign
      777           v-field-label        = _Field._Label
      778           v-field-column-label = _Field._Col-Label
      779         .
      780         if v-field-label = ?
      781         or v-field-label = '':U
      782         or v-field-label = _Field._Field-Name
      783         then do:
      784           assign
      785             v-field-label = 'label_':U + _Field._Field-Name
      786           .
      787         end.
      788         if v-field-column-label = ?
      789         or v-field-column-label = '':U
      790         then do:
      791           assign
      792             v-field-column-label = v-field-label
      793           .
      794         end.
      795         put stream slog unformatted
      796           '  LABEL ' .
      797         export stream slog
      798             escape-description(v-field-label)
      799           .
      800         put stream slog unformatted
      801           '  COLUMN-LABEL ' .
      802         export stream slog
      803             escape-description(v-field-column-label)
      804           .
      805         if _Field._Decimals <> ?
      806         then do:
      807           put stream slog unformatted
      808             '  DECIMALS ' + string(_Field._Decimals) + chr(10).
      809         end.
      810         if _Field._Order <> ?
      811         then do:
      812           put stream slog unformatted
      813             '  ORDER ' + string(_Field._Order) + chr(10).
      814         end.
      815         if _Field._Mandatory = true
      816         then do:
      817           put stream slog unformatted
      818             '  MANDATORY' + chr(10)
      819             .
      820         end.
      821         put stream slog unformatted
      822           chr(10)
      823         .
      824       end.
      825       find first _index of _file no-lock
      826         where recid(_index) = _File._Prime-index
      827         no-error .
      828       if available _index
      829       then do:
      830         run export_index in this-procedure .
      831       end.
      832       for each _index of _file no-lock
      833       on error undo, return error return-value
      834       :
      835         if recid(_index) <> _File._Prime-index
      836         then do:
      837           run export_index in this-procedure .
      838         end.
      839       end.
      840     end.
      841     run waitfram-hide in this-procedure .
      842     define variable v-file-length as integer   no-undo .
      843     assign
      844       v-file-length = seek(slog)
      845     .
      846     put stream slog unformatted
      847       '.' + chr(10)
      848       'PSC' + chr(10)
      849       'codepage=' + session :stream chr(10)
      850       '.' + chr(10)
      851       STRING(v-file-length, "9999999999") + chr(10)
      852     .
      853     output stream slog close .
      854     message
      855       "Завершено создание файла определений для синхронизации с ERWin" skip
      856       "Имя файла" v-file-name skip
      857       view-as alert-box information .
      858   end.
      859   procedure export_index :
      860     do
      861     on error undo, return error return-value
      862     :
      863         put stream slog unformatted
      864           'ADD INDEX "' + _Index._Index-name  + '" ON "' + _File._File-Name + '"' + chr(10)
      865           .
      866         if _index._unique = true
      867         then do:
      868           put stream slog unformatted
      869             '  UNIQUE' + chr(10)
      870             .
      871         end.
      872         if recid(_index) = _File._Prime-index
      873         then do:
      874           put stream slog unformatted
      875             '  PRIMARY' + chr(10)
      876             .
      877         end.
      878         if _index._Wordidx <> ?
      879         then do:
      880           if _index._Wordidx = 1
      881           then do:
      882             put stream slog unformatted
      883               '  WORD' + chr(10)
      884               .
      885           end.
      886           else do:
      887             message
      888               "Таблица" _File._File-Name skip
      889               "Индекс" _Index._Index-name skip
      890               "Неизвестное значение _index._Wordidx" _index._Wordidx skip
      891               view-as alert-box error .
      892           end.
      893         end.
      894         define buffer buf_field for _field .
      895         for each _index-field of _index
      896         ,first buf_field of _index-field
      897         :
      898           put stream slog unformatted
      899             '  INDEX-FIELD "' + buf_field._field-name + '" '
      900             + (IF _index-field._Ascending then 'ASCENDING' else 'DESCENDING')
      901             + chr(10)
      902             .
      903         end.
      904         put stream slog unformatted
      905           chr(10)
      906           .
      907     end.
      908   end procedure.
