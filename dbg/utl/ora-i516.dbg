     2145       find first buf_contract no-lock where
     2146                  not (is-egais or is-tsd) and
     2147                  temp_trn-doc.ext-doc-type = 'ie':U and
     2148                  buf_contract.contract-code =  temp_trn-doc.cli-code and
     2149                  buf_contract.host-code     =  temp_trn-doc.host-code
     2150                  no-error .
     2151      if not available  buf_contract then do:
     2152         temp_trn-doc.contract-code =  0 .
     2153      end.
     2154      else do:
     2155         temp_trn-doc.contract-code =  buf_contract.contract-code .
     2156      end.
     2157       def var ii as int no-undo.
     2158       for each buf_contract no-lock where
     2159              is-egais and
     2160              temp_trn-doc.ext-doc-type = 'ie':U and
     2161              buf_contract.cli-code =  temp_trn-doc.cli-code and
     2162              buf_contract.cli-code =  temp_trn-doc.cli-code and
     2163              buf_contract.host-code =  temp_trn-doc.host-code
     2164              :
     2165         ii = ii + 1.
     2166         temp_trn-doc.contract-code =  buf_contract.contract-code .
     2167         if ii > 1 then do:
     2168           temp_trn-doc.contract-code =  0 .
     2169           leave.
     2170         end.
     2171       end.
     2172      v-specif = false .
     2173      if temp_trn-doc.contract-code  > 0 then do:
     2174         find first  ub.contract-specif no-lock where
     2175                     ub.contract-specif.contract-num = temp_trn-doc.contract-code and
     2176                     ub.contract-specif.host-code    = temp_trn-doc.host-code
     2177                     no-error .
     2178         if available ub.contract-specif then
     2179         assign
     2180           v-specif = true
     2181           temp_trn-doc.vat-type = ub.contract-specif.VAT-type
     2182         .
     2183      end.
     2184      if temp_trn-doc.ext-doc-type = 'ie':U then do:
     2185         if available buf_contract then do:
     2186            if buf_contract.curr-code <> temp_trn-doc.exch-code then do:
     2187                       v-end-message =  substitute("По договору &3   ожидалась валюта &1  пришла &2 " ,
     2188                       buf_contract.curr-code,
     2189                       temp_trn-doc.exch-code,
     2190                       temp_trn-doc.contract-code ) .
     2191                       run pcall-log-file in p-log-handle (input v-end-message) .
     2192                       undo, return error v-end-message.
     2193         end.
     2194         end.
     2195      end.
     2196      if not (temp_trn-doc.cli-type = 'орг':U or temp_trn-doc.cli-type = 'чел':U or temp_trn-doc.cli-type = 'скл':U or temp_trn-doc.cli-type = 'маг':U)
     2197      then do:
     2198        run who-cli-ora in this-procedure (
     2199          input  temp_trn-doc.cli-code ,
     2200          output temp_trn-doc.cli-type ,
     2201          output temp_trn-doc.cli-code
     2202          ) no-error .
     2203        if error-status :error then return error return-value .
     2204      end.
     2205      else do:
     2206        if not is-egais then is-tsd = true.
     2207      end.
     2208     if temp_trn-doc.ext-doc-type <> 'ie':U then do:
     2209        temp_trn-doc.exch-code = 0 .
     2210        temp_trn-doc.exch-rate  = 1.
     2211        temp_trn-doc.exch-scale = 1.
     2212     end.
     2213     if temp_trn-doc.exch-code = ? then do:
     2214         assign
     2215           temp_trn-doc.exch-code = 0
     2216           temp_trn-doc.exch-rate  = 1
     2217           temp_trn-doc.exch-scale = 1
     2218         .
     2219         v-end-message =  substitute("Предупреждение !!! Не верно введена валюта ПОСТВЩИКА код &1 , меняю на национальную " ,              temp_trn-doc.exch-code   ) .
     2220         run pcall-log-file in p-log-handle (input v-end-message) .
     2221     end.
     2222     if temp_trn-doc.exch-rate  = 0 or
     2223        temp_trn-doc.exch-rate  = ? then do:
