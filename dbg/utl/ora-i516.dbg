     3289   procedure clos-trn :
     3290     do
     3291     on error undo, return error return-value
     3292     :
     3293   define input parameter p-trn-code as character no-undo .
     3294   define buffer buf_s-trn-doc for ub.trn-doc.
     3295   define variable varmode            as   character           no-undo.
     3296   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3297   define variable varflag            like ub.trn-doc.flag     no-undo.
     3298   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3299   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3300   define variable varcheck-return as logical no-undo .
     3301   define variable varchg-inv      as logical no-undo .
     3302   assign
     3303     varmode         = '<закрытие документа>':U
     3304     varstatus       = 'запрос':U
     3305     varflag         = true
     3306     varcopystatus   = 'новый':U
     3307     varcopyflag     = false
     3308     varcheck-return = true
     3309     varchg-inv      = true
     3310     .
     3311   for each tt2-doc-line where is-tsd and doc-code = p-trn-code no-lock:
     3312     run unitqnty1 (
     3313         input tt2-doc-line.unit-cli,
     3314         input "",
     3315         input "",
     3316         input 0,
     3317         input "",
     3318         input tt2-doc-line.doc-qnty)
     3319     no-error.
     3320     if error-status:error then do:
     3321       run pcall-log-file in p-log-handle (input return-value) .
     3322       is-unit-error  = true.
     3323     end.
     3324     run unitqnty1 (
     3325         input tt2-doc-line.unit-cli,
     3326         input "",
     3327         input "",
     3328         input 0,
     3329         input "",
     3330         input tt2-doc-line.fact-qnty)
     3331     no-error.
     3332     if error-status:error then do:
     3333       run pcall-log-file in p-log-handle (input return-value) .
     3334       is-unit-error  = true.
     3335     end.
     3336   end.
     3337   if is-unit-error then do:
     3338     run pcall-log-file in p-log-handle (input "Невозможно перевести накладную в статус накл") .
     3339     return.
     3340   end.
     3341   run str/trn-graf.p
     3342     ( input  p-trn-code ,
     3343       input  v-cntxt-db-num ,
     3344       input  varmode ,
     3345       output varstatus ,
     3346       output varflag ,
     3347       output varcopystatus ,
     3348       output varcopyflag
     3349     ) no-error .
     3350       if error-status:error then do :
     3351           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3352           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3353           undo, return error v-end-message.
     3354       end.
     3355   run str/trn-stat.p (
     3356       input  parparentproc ,
     3357       input  this-procedure ,
     3358       input  varmode,
     3359       input  p-trn-code,
     3360       input  varcheck-return,
     3361       input  v-cntxt-db-num,
     3362       input  v-cntxt-in-ov,
     3363       input  v-cntxt-rsrv-time,
     3364       input  v-cntxt-load-time,
     3365       input  v-cntxt-holidays,
     3366       input  NO,
     3367       output varchg-inv,
     3368       output table gds-list)
     3369       no-error.
     3370       if error-status:error then do :
     3371           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3372           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3373           undo, return error v-end-message.
     3374       end.
     3375     end.
     3376     if is-tsd then do:
     3377       for each ub.doc-line exclusive-lock where new_trn-doc.doc-code = ub.doc-line.doc-code:
     3378         find first buf_goods where ub.doc-line.artic = buf_goods.artic and
     3379           ub.doc-line.prod-type = buf_goods.prod-type  and
     3380           ub.doc-line.prod-code = buf_goods.prod-code
     3381           no-lock no-error .
     3382         find first ub.gds-dtl exclusive-lock where ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     3383           ub.gds-dtl.artic = buf_goods.artic and
     3384           ub.gds-dtl.prod-type = buf_goods.prod-type  and
     3385           ub.gds-dtl.prod-code = buf_goods.prod-code.
     3386         find first temp_doc-line where temp_doc-line.gds-code = buf_goods.gds-code.
     3387         ub.gds-dtl.doc-qnty  = temp_doc-line.doc-qnty.
     3388         ub.gds-dtl.fact-qnty = temp_doc-line.fact-qnty.
     3389         ub.doc-line.fact-qnty = temp_doc-line.fact-qnty.
     3390         ub.doc-line.doc-qnty = temp_doc-line.doc-qnty.
     3391         ub.doc-line.cli-qnty = temp_doc-line.cli-qnty.
     3392       end.
     3393     end.
     3394   end procedure.
     3395   procedure clos-trn2 :
     3396   define input parameter p-trn-code as character no-undo .
     3397     do
     3398     on error undo, return error return-value
     3399     :
     3400   define buffer buf_s-trn-doc for ub.trn-doc.
     3401   define variable varmode            as   character           no-undo.
     3402   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3403   define variable varflag            like ub.trn-doc.flag     no-undo.
     3404   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3405   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3406   define variable varcheck-return as logical no-undo .
     3407   define variable varchg-inv as logical no-undo .
     3408   if is-tsd or (is-egais and not v-ext-doc-type = 're':U)
     3409     then return.
     3410   run str/trn-stat.p (
     3411       input  parparentproc ,
     3412       input  this-procedure ,
     3413       input  '<закрытие документа>':U ,
     3414       input  p-trn-code,
     3415       input  false  ,
     3416       input  v-cntxt-db-num,
     3417       input  false ,
     3418       input  v-cntxt-rsrv-time,
     3419       input  v-cntxt-load-time,
     3420       input  v-cntxt-holidays,
     3421       input  false ,
     3422       output varchg-inv ,
     3423       output table gds-list)
     3424       no-error.
     3425       if error-status:error then do :
     3426           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3427           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3428           undo, return error v-end-message.
     3429       end.
     3430     end.
     3431   end procedure.
     3432   procedure mainmenu_getcntxt :
     3433   define output parameter p-cntxt-db-num                as integer   no-undo .
     3434   define output parameter p-cntxt-userid                as character no-undo .
     3435   define output parameter p-cntxt-level                 as character no-undo .
     3436   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
     3437   define output parameter p-cntxt-obj-type              as character no-undo .
     3438   define output parameter p-cntxt-obj-code              as integer   no-undo .
     3439   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
     3440   define output parameter p-cntxt-is-admin              as logical   no-undo .
     3441     do
     3442     on error undo, return error return-value
     3443     :
     3444   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3446     (input  vt-obj-type
     3447     ,input  vt-obj-code
     3448     ,output p-cntxt-db-num-obj
     3449     )  .
     3450     assign
     3451       p-cntxt-db-num          =  v-cntxt-db-num
     3452       p-cntxt-userid          =  v-cntxt-userid
     3453       p-cntxt-level           =  v-cntxt-level
     3454       p-cntxt-host-code-obj   =  vt-host-code
     3455       p-cntxt-obj-type        =  vt-obj-type
     3456       p-cntxt-obj-code        =  vt-obj-code
     3457       p-cntxt-is-admin        =  v-cntxt-is-admin
     3458     .
     3459     end.
     3460    end procedure.
     3461    procedure get-report-num :
     3462     define output parameter p-report-num as integer no-undo .
     3463      do
     3464      on error undo, return error return-value
     3465      :
     3466       assign
     3467         p-report-num = 1
     3468       .
     3469      end.
     3470    end procedure.
     3471   procedure clear-tt :
     3472     do
     3473     on error undo, return error return-value
     3474     :
     3475      for each tt-trn-doc:
     3476       delete tt-trn-doc.
     3477      end.
     3478       for each tt2-doc-line :
     3479           delete tt2-doc-line .
     3480       end.
     3481       for each tt-doc-line :
     3482           delete tt-doc-line .
     3483       end.
     3484       for each tt-gds-dtl :
     3485           delete tt-gds-dtl .
     3486       end.
     3487       for each tt-parts:
     3488           delete tt-parts .
     3489       end.
     3490       for each lib-trn_ret-doc :
     3491         delete lib-trn_ret-doc.
     3492       end.
     3493       for each lib-trn_ret-line :
     3494         delete lib-trn_ret-line      .
     3495       end.
     3496       for each lib-trn_ret-line-attr :
     3497         delete lib-trn_ret-line.
     3498       end.
     3499       for each lib-trn_ret-dtl :
     3500         delete lib-trn_ret-dtl.
     3501       end.
     3502       for each lib-trn_ret-parts :
     3503         delete lib-trn_ret-parts .
     3504       end.
     3505    end.
     3506   end procedure.
     3507   procedure add-nn :
     3508   define input  parameter p-doc-code as character no-undo .
     3509   define input  parameter p-doc-out as character no-undo .
     3510     do
     3511     on error undo, return error return-value
     3512     :
     3513     if not is-egais
     3514     then do:
     3515       find first ub.doc-attr exclusive-lock where
     3516                ub.doc-attr.doc-code = p-doc-code and
     3517                ub.doc-attr.attr-code = 'nids':U no-error .
     3518       if not available ub.doc-attr then create ub.doc-attr.
     3519       assign
     3520         ub.doc-attr.doc-code = p-doc-code
     3521         ub.doc-attr.attr-code = 'nids':U
     3522         ub.doc-attr.attr-value = p-doc-out
     3523       .
     3524     end.
     3525     else do:
     3526   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     3527                          input 'negais':U ,
     3528                          input p-doc-out ) no-error .
     3529   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     3530                          input 'nids':U ,
     3531                          input entry(2,p-doc-out,chr(6)) ) no-error .
     3532   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     3533                          input 'dids':U ,
     3534                          input entry(3,p-doc-out,chr(6)) ) no-error .
     3535     end.
     3536     end.
     3537   end procedure.
     3538   procedure calc-cost-price :
     3539   define input  parameter p-doc-code as character no-undo .
     3540   define buffer cur-doc-line  for ub.doc-line.
     3541   define buffer cur-goods     for ub.goods.
     3542   define buffer cur-gds-dtl   for ub.gds-dtl.
     3543   define buffer t-doc         for ub.trn-doc  .
     3544   define variable varnew-price like ub.doc-line.price-base no-undo.
     3545     do
     3546     on error undo, return error return-value
     3547     :
     3548     v-end-message = substitute("Просчет учетной цены для расходной накладной &1" , p-doc-code) .
     3549     run pcall-log-file in p-log-handle ( input v-end-message ) .
     3550     find first t-doc no-lock where t-doc.doc-code = p-doc-code .
     3551      for each  cur-doc-line where cur-doc-line.doc-code   = t-doc.doc-code         ,
     3552          first cur-goods    where cur-goods.artic         = cur-doc-line.artic     and
     3553                                   cur-goods.prod-type     = cur-doc-line.prod-type and
     3554                                   cur-goods.prod-code     = cur-doc-line.prod-code no-lock,
     3555          each  cur-gds-dtl  where cur-gds-dtl.doc-code    = cur-doc-line.doc-code  and
     3556                                   cur-gds-dtl.artic       = cur-doc-line.artic     and
     3557                                   cur-gds-dtl.prod-type   = cur-doc-line.prod-type and
     3558                                   cur-gds-dtl.prod-code   = cur-doc-line.prod-code no-lock :
     3559          assign
     3560            line-rec = recid(cur-doc-line)
     3561          .
     3562   assign
     3563     price-rubl-with-tax-loc = cur-doc-line.price-rubl
     3564     price-base-with-tax-loc = cur-doc-line.price-base
     3565   .
     3566   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3568     (output varinvprb
     3569     )  .
     3570      find first in-vatp_doc-attr no-lock
     3571       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     3572         and in-vatp_doc-attr.attr-code = 'envd':U
     3573       no-error .
     3574       if available in-vatp_doc-attr
     3575          then do:
     3576          assign
     3577            in-vatp-have-vat-slt = no.
     3578      end.
     3579      else do:
     3580        assign
     3581          in-vatp-have-vat-slt = yes.
     3582      end.
     3583      find first in-vatp-goods where in-vatp-goods.artic     = cur-doc-line.artic     and
     3584                                        in-vatp-goods.prod-type = cur-doc-line.prod-type and
     3585                                        in-vatp-goods.prod-code = cur-doc-line.prod-code no-lock.
     3586      if (not t-doc.internal and
     3587              t-doc.doc-type = 'при':U) or
     3588         in-vatp-goods.gds-type = 'у':U then do:
     3589         if varinvprb = "base":u then do:
     3590           assign
     3591             road-tax-base-loc = cur-doc-line.road-tax
     3592             road-tax-rubl-loc = cur-doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     3593         end.
     3594         else do:
     3595           ASSIGN
     3596             road-tax-rubl-loc = cur-doc-line.road-tax
     3597             road-tax-base-loc = cur-doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     3598         end.
     3599         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     3600         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     3601         assign
     3602           road-tax-cli-loc = ?.
     3603         ASSIGN
     3604           transport-base-loc = (if cur-doc-line.transport-base = ? then 0 else cur-doc-line.transport-base)
     3605           transport-rubl-loc = (if cur-doc-line.transport-rubl = ? then 0 else cur-doc-line.transport-rubl)
     3606           transport-cli-loc  = 0
     3607           other-base-loc     = (if cur-doc-line.other-base     = ? then 0 else cur-doc-line.other-base)
     3608           other-rubl-loc     = (if cur-doc-line.other-rubl     = ? then 0 else cur-doc-line.other-rubl)
     3609           other-cli-loc      = 0
     3610           vat-pc-loc         = (if cur-doc-line.vat-pc         = ? then 0 else cur-doc-line.vat-pc)
     3611           slt-pc-loc         = (if cur-doc-line.slt-pc         = ? then 0 else cur-doc-line.slt-pc).
     3612                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3613               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3614         assign
     3615           vat-cli-loc            = ?
     3616           slt-cli-loc            = ?
     3617           price-cli-with-tax-loc = ?.
     3618      end.
     3619      else do:
     3620                                                   for each in-vatp-parts where in-vatp-parts.out-code  = cur-doc-line.doc-code  and
     3621                                         in-vatp-parts.obj-type  = cur-doc-line.obj-type  and
     3622                                         in-vatp-parts.obj-code  = cur-doc-line.obj-code  and
     3623                                         in-vatp-parts.artic     = cur-doc-line.artic     and
     3624                                         in-vatp-parts.prod-type = cur-doc-line.prod-type and
     3625                                         in-vatp-parts.prod-code = cur-doc-line.prod-code
     3626                            use-index out-code no-lock:
     3627             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     3628                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     3629                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     3630                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     3631                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     3632                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     3633                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3634                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3635                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3636                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3637                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3638                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3639                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3640                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3641                         .
     3642         end.
     3643         ASSIGN
     3644           road-tax-base-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3645           road-tax-rubl-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3646           transport-base-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3647           transport-rubl-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3648           other-base-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3649           other-rubl-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3650                                           vat-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     3651           slt-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     3652                   vat-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     3653           slt-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     3654           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     3655           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     3656         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     3657         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     3658         if transport-base-loc = ? then transport-base-loc = 0.
     3659         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     3660         if other-base-loc     = ? then other-base-loc     = 0.
     3661         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     3662         assign
     3663           transport-cli-loc      = 0
     3664           other-cli-loc          = 0
     3665           road-tax-cli-loc       = ?
     3666           vat-cli-loc            = ?
     3667           slt-cli-loc            = ?
     3668           price-cli-with-tax-loc = ?.
     3669      end.
     3670   ASSIGN
     3671             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3672       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3673   .
     3674       assign
     3675         varnew-price = (if t-doc.print-rubl then price-rubl-with-tax-loc
     3676                                             else price-base-with-tax-loc ) .
     3677          run str/out-add.p ( this-procedure ,
     3678                         recid (t-doc),
     3679                         recid (cur-doc-line),
     3680                         recid (cur-gds-dtl),
     3681                         recid (cur-goods),
     3682                         "update-sale-price",
     3683                         string(varnew-price)) no-error.
     3684          if error-status :error then do:
     3685           v-end-message = substitute(" Ошибка при вызове программы out-add &1 &2" , error-status :get-message(1)  , return-value) .
     3686           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3687           undo, return error v-end-message.
     3688          end.
     3689      end.
     3690       if not is-tsd then do:
     3691         run gbl/calc-trn.p (  this-procedure , recid(new_trn-doc)) no-error .
     3692         if error-status :error then do:
     3693           v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     3694           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3695           undo, return error v-end-message.
     3696         end.
     3697       end.
     3698     end.
     3699   end procedure.
     3700   procedure cb_cloce-quest-neg :
     3701   define output parameter p-is-negostmess as logical   no-undo .
     3702     do
     3703     on error undo, return error return-value
     3704     :
     3705      p-is-negostmess = false .
     3706     end.
     3707   end procedure.
     3708   procedure unitqnty1 :
     3709     define input parameter  p-unit-name        like ub.units.unit-name no-undo .
     3710     define input parameter  p-artic            like ub.goods.artic     no-undo .
     3711     define input parameter  p-prod-type        like ub.goods.prod-type no-undo .
     3712     define input parameter  p-prod-code        like ub.goods.prod-code no-undo .
     3713     define input parameter  p-unit-description as character            no-undo .
     3714     define input parameter  p-qnty             as decimal              no-undo .
     3715     define buffer buf_units for ub.units .
     3716     define buffer buf_goods for ub.goods .
     3717     define variable v-artic as character no-undo .
     3718     define variable v-msg   as character no-undo .
     3719     if p-unit-description = ''
     3720     or p-unit-description = ?
     3721     then do:
     3722       assign
     3723         p-unit-description = "Единица измерения "
     3724       .
     3725     end.
     3726     if  p-unit-name <> ''
     3727     and p-unit-name <> ?
     3728     then do:
     3729       find first buf_units no-lock
     3730         where buf_units.unit-name = p-unit-name
     3731         no-error .
     3732       if not available buf_units
     3733       then do:
     3734         v-msg =
     3735           "Не найдена единица измерения " + chr(10) +
     3736           "p-unit-name" +   p-unit-name + chr(10) +
     3737           "p-artic" +       p-artic +  chr(10) +
     3738           "p-prod-type" +   p-prod-type + chr(10) +
     3739           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3740           "p-qnty" +        string (p-qnty) + chr(10)
     3741            .
     3742         undo, return error v-msg .
     3743       end.
     3744     end.
     3745     else do:
     3746       find first buf_goods no-lock
     3747         where buf_goods.artic     = p-artic
     3748           and buf_goods.prod-type = p-prod-type
     3749           and buf_goods.prod-code = p-prod-code
     3750         no-error .
     3751       if not available buf_goods
     3752       then do:
     3753         v-msg =
     3754           "Не найден товар" + chr(10) +
     3755           "p-unit-name" +   p-unit-name + chr(10) +
     3756           "p-artic" +       p-artic +  chr(10) +
     3757           "p-prod-type" +   p-prod-type + chr(10) +
     3758           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3759           "p-qnty" +        string (p-qnty) + chr(10)
     3760           .
     3761         undo, return error v-msg .
     3762       end.
     3763       find first buf_units no-lock
     3764         where buf_units.unit-name = buf_goods.unit-base
     3765         no-error .
     3766       if not available buf_units
     3767       then do:
     3768         v-msg =
     3769           "Не найдена единица измерения " + chr(10) +
     3770           "p-unit-name" +   p-unit-name + chr(10) +
     3771           "p-artic" +       p-artic +  chr(10) +
     3772           "p-prod-type" +   p-prod-type + chr(10) +
     3773           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3774           "p-qnty" +        string (p-qnty) + chr(10)
     3775           .
     3776         undo, return error v-msg .
     3777       end.
     3778       assign
     3779         v-artic = "Артикул " + string(p-artic) + " " + string(p-prod-type)
     3780                 + " " + string(p-prod-code)
     3781         p-unit-description = "Базовая единица измерения"
     3782       .
     3783     end.
     3784     if lookup('шту':U, buf_units.type) > 0
     3785     or lookup('сер':U, buf_units.type) > 0
     3786     then do:
     3787       if p-qnty <> truncate(p-qnty, 0)
     3788       then do:
     3789         v-msg =
     3790           "Для штучного и серийного товаров резервируемое количество должно быть целым" + chr(10) +
     3791           v-artic + chr(10) +
     3792           p-unit-description + buf_units.unit-name + chr(10) +
     3793           "Запрошено количество " + string (p-qnty) + chr(10).
     3794         undo, return error v-msg .
     3795       end.
     3796     end.
     3797   end procedure.
     3798   procedure create-line:
     3799       define input parameter p-doc-code as character no-undo.
     3800       define input-output parameter table for tt2-doc-line.
     3801       def var gds-code as int no-undo.
     3802       def var cli-qnty as dec no-undo.
     3803       def var v-root-node as int no-undo.
     3804       def var vat-pc as dec no-undo.
     3805       find first ub.trn-doc no-lock
     3806           where ub.trn-doc.doc-code = p-doc-code
     3807           no-error.
     3808       if error-status:error then
     3809           return error subst("Не найден документ с кодом &1", p-doc-code).
     3810   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3811   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3812     (input  ub.goods.gds-code
     3813     ,input  '1':U
     3814     ,input  today
     3815     ,input  ub.trn-doc.host-code
     3816     ,input  ub.trn-doc.obj-type
     3817     ,input  ub.trn-doc.obj-code
     3818     ,output vat-pc
     3819     ) no-error .
     3820   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclin in g#lib-trn
     3821   (input ub.trn-doc.doc-code
     3822   ,input tt2-doc-line.artic
     3823   ,input tt2-doc-line.prod-type
     3824   ,input tt2-doc-line.prod-code
     3825   ,input ub.trn-doc.obj-type
     3826   ,input ub.trn-doc.obj-code
     3827   ,input ''
     3828   ,input trn-doc.ext-doc-type
     3829   ,input tt2-doc-line.prt-root
     3830   ,input tt2-doc-line.vat-pc
     3831   ,input 0
     3832   ,input 0
     3833   ) no-error
     3834   .
     3835       if error-status:error then
     3836           return error substitute("Ошибка при создании линии накладной &1, &2", ub.trn-doc.doc-code, return-value).
     3837       find first ub.doc-line
     3838           where ub.doc-line.doc-code = ub.trn-doc.doc-code
     3839           and ub.doc-line.artic = tt2-doc-line.artic
     3840           and ub.doc-line.prod-type = tt2-doc-line.prod-type
     3841           and ub.doc-line.prod-code = tt2-doc-line.prod-code
     3842           share-lock.
     3843       buffer-copy tt2-doc-line to ub.doc-line.
     3844   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3846     (input  ub.doc-line.artic
     3847     ,input  ub.doc-line.prod-type
     3848     ,input  ub.doc-line.prod-code
     3849     ,output v-root-node
     3850     )  .
     3851   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     3852     ( input ub.trn-doc.obj-code
     3853      ,input ub.trn-doc.obj-type
     3854      ,input ub.trn-doc.doc-code
     3855      ,input ub.doc-line.artic
     3856      ,input ub.doc-line.prod-code
     3857      ,input ub.doc-line.prod-type
     3858      ,input v-root-node
     3859      ,input true
     3860     )  .
     3861       find first ub.gds-dtl share-lock
     3862           where ub.gds-dtl.doc-code = ub.trn-doc.doc-code
     3863           and ub.gds-dtl.artic = tt2-doc-line.artic
     3864           and ub.gds-dtl.prod-type = tt2-doc-line.prod-type
     3865           and ub.gds-dtl.prod-code = tt2-doc-line.prod-code
     3866           and ub.gds-dtl.prt-code = v-root-node.
     3867       buffer-copy ub.doc-line to ub.gds-dtl.
     3868       for each tt-parts
     3869         where tt-parts.artic = tt2-doc-line.artic
     3870           and tt-parts.prod-type = tt2-doc-line.prod-type
     3871           and tt-parts.prod-code = tt2-doc-line.prod-code:
     3872         create ub.parts.
     3873           buffer-copy tt-parts except tt-parts.supp-type tt-parts.supp-code to ub.parts
     3874             assign ub.parts.pl-code = 0.
     3875       end.
     3876   end.
