     1348     define variable v-cntxt-obj-code      as integer   no-undo .
     1349     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1350     define variable v-cntxt-is-admin      as logical   no-undo .
     1351   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1352     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     1353     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     1354     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
