     1358     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     1359     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     1360     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     1361     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     1362     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     1363     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     1364     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     1365     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     1366     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     1367     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     1368     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     1369     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     1370     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     1371     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     1372     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     1373     define variable v-cntxp-conf-par        as   character                no-undo.
     1374     define variable v-cntxp-par-type        as   character                no-undo.
     1375     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     1376     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     1377     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     1378     define variable v-cntxp-db-num          as integer   no-undo .
     1379     define variable v-cntxp-userid          as character no-undo .
     1380     define variable v-cntxp-level           as character no-undo .
     1381     define variable v-cntxp-db-num-obj      as integer   no-undo .
     1382     define variable v-cntxp-is-admin        as logical   no-undo .
     1383     define buffer bf-cntxp_store for ub.store.
     1384     define buffer bf-cntxp_shop  for ub.shop.
     1385     define buffer bf-cntxp_sysconf for ub.sysconf.
     1386   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
     1387   procedure who-cli-ora :
     1388   define input  parameter p-cli-code-ora as integer   no-undo .
     1389   define output parameter p-cli-type as character no-undo .
     1390   define output parameter p-cli-code as integer   no-undo .
     1391     do
     1392     on error undo, return error return-value
     1393     :
     1394     if length (string(p-cli-code-ora))  <> 9 then do:
     1395        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
     1396     end.
     1397     if string(p-cli-code-ora) begins "1" or
     1398        string(p-cli-code-ora) begins "2" or
     1399        string(p-cli-code-ora) begins "4" then do:
     1400         p-cli-type = 'орг':U .
     1401         p-cli-code = p-cli-code-ora  .
     1402     end.
     1403     else do:
     1404       if string(p-cli-code-ora) begins "3" then do:
     1405         p-cli-type = 'чел':U .
     1406         p-cli-code = p-cli-code-ora  .
     1407       end.
     1408       else do:
     1409          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
     1410       end.
     1411     end.
     1412     define buffer buf_clients for ub.clients  .
     1413     find first buf_clients no-lock where
     1414                buf_clients.obj-type = p-cli-type and
     1415                buf_clients.obj-code = p-cli-code
     1416                no-error .
     1417         if error-status :error then do:
     1418             return error substitute
     1419             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
     1420                 p-cli-code-ora ,
     1421                 p-cli-type ,
     1422                 p-cli-code ) .
     1423         end.
     1424         if ora-icli_ver-stts-client then do:
     1425             if buf_clients.stts > 0 then do:
     1426                 return error substitute
     1427                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
     1428                     p-cli-code-ora ,
     1429                     p-cli-type ,
     1430                     p-cli-code ) .
     1431             end.
     1432         end.
     1433     end.
     1434   end procedure.
     1435   procedure ora-ver-goods :
     1436   define input  parameter p-gds-code as integer   no-undo .
     1437   define buffer buf_goods for ub.goods  .
     1438   define variable my-message as character no-undo .
     1439     do
     1440     on error undo, return error return-value
     1441     :
     1442           find first buf_goods no-lock where
     1443                      buf_goods.gds-code = p-gds-code no-error .
     1444               if error-status :error then do:
     1445                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
     1446                   undo, return error my-message.
     1447               end.
     1448             if buf_goods.stts > 0 then do:
     1449               assign
     1450                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
     1451                 undo, return error my-message.
     1452             end.
     1453     end.
     1454   end procedure.
     1455   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1456   procedure factord :
     1457     define input  parameter p-fact-date            as date    no-undo .
     1458     define input  parameter p-fact-time            as integer no-undo .
     1459     define input  parameter p-fact-num             as integer no-undo .
     1460     define input  parameter p-shift-date           as date    no-undo .
     1461     define input  parameter p-shift-num            as integer no-undo .
     1462     define input  parameter p-shift-on             as logical no-undo .
     1463     define output parameter p-fact-order           as decimal no-undo .
     1464     define output parameter p-shift-end-fact-order as decimal no-undo .
     1465     define output parameter p-day-end-fact-order   as decimal no-undo .
     1466     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1467     if p-fact-date = ?
     1468     then do:
     1469       return error "Не указана фактическая дата" .
     1470     end.
     1471     define variable v-fact-date-num as integer no-undo .
     1472     assign
     1473       v-fact-date-num = integer(p-fact-date)
     1474     .
     1475     if p-fact-num = ?
     1476     or p-fact-num = 0
     1477     then do:
     1478       return error "Не задан p-fact-num " + string(p-fact-num) .
     1479     end.
     1480     if p-fact-num < 0
     1481     then do:
     1482       return error "Отрицательный fact-num " + string(p-fact-num) .
     1483     end.
     1484     if p-fact-num >= 100000000
     1485     then do:
     1486       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1487     end.
     1488     if p-shift-on = true
     1489     then do:
     1490       if p-shift-date = ?
     1491       then do:
     1492         return error "Не задана дата смены" .
     1493       end.
     1494       if p-shift-num = ?
     1495       or p-shift-num = 0
     1496       then do:
     1497         return error "Не задан номер смены" .
     1498       end.
     1499     end.
     1500     else do:
     1501       assign
     1502         p-shift-date = p-fact-date
     1503         p-shift-num  = 24
     1504       .
     1505     end.
     1506     define variable v-shift-offset as integer no-undo .
     1507     if p-shift-date = p-fact-date
     1508     then do:
     1509       assign
     1510         v-shift-offset = 1
     1511       .
     1512     end.
     1513     if p-shift-date < p-fact-date
     1514     then do:
     1515       assign
     1516         v-shift-offset = 0
     1517       .
     1518     end.
     1519     if p-shift-date > p-fact-date
     1520     then do:
     1521       message
     1522         vss-workfile vss-revision vss-description skip
     1523         "Неправильная дата закрытия смены" skip
     1524         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1525         view-as alert-box error .
     1526       undo, return error
     1527         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1528           ,string(p-fact-date, '99/99/9999':U)
     1529           ,string(p-shift-date, '99/99/9999':U)
     1530           )
     1531       .
     1532     end.
     1533     if p-shift-num < 1
     1534     or p-shift-num > 24
     1535     then do:
     1536       message
     1537         vss-workfile vss-revision vss-description skip
     1538         "Неправильный номер смены" skip
     1539         "p-shift-num" p-shift-num skip
     1540         view-as alert-box error .
     1541       undo, return error return-value .
     1542     end.
     1543     assign
     1544       p-fact-order           = v-fact-date-num
     1545                              + v-shift-offset * 0.5
     1546                              + p-shift-num    * 0.02 - 0.01
     1547                              + p-fact-num     * 0.0000000001
     1548       p-shift-end-fact-order = v-fact-date-num
     1549                              + v-shift-offset * 0.5
     1550                              + p-shift-num    * 0.02
     1551       p-day-end-fact-order   = v-fact-date-num
     1552                              + 0.99
     1553     .
     1554     if p-fact-order           <= v-fact-date-num
     1555     or p-shift-end-fact-order <= v-fact-date-num
     1556     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1557     or p-shift-end-fact-order >= p-day-end-fact-order
     1558     then do:
     1559       message
     1560         vss-workfile vss-revision vss-description skip
     1561         "Внутренняя ошибка при генерации фактического номера" skip
     1562         "p-fact-date"            p-fact-date            skip
     1563         "p-fact-time"            p-fact-time            skip
     1564         "p-fact-num"             p-fact-num             skip
     1565         "p-shift-date"           p-shift-date           skip
     1566         "p-shift-num"            p-shift-num            skip
     1567         "p-shift-on"             p-shift-on             skip
     1568         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1569         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1570         "v-fact-date-num"        v-fact-date-num        skip
     1571         view-as alert-box error .
     1572       undo, return error return-value .
     1573     end.
     1574   end procedure.
     1575   procedure day-begin-fact-order :
     1576     define input  parameter p-fact-date            as date    no-undo .
     1577     define output parameter p-day-begin-fact-order as decimal no-undo .
     1578     do
     1579     on error undo, return error return-value
     1580     :
     1581       if p-fact-date = ?
     1582       then do:
     1583         assign
     1584           p-day-begin-fact-order = 0
     1585         .
     1586       end.
     1587       else do:
     1588         assign
     1589           p-day-begin-fact-order = integer(p-fact-date)
     1590         .
     1591       end.
     1592     end.
     1593   end procedure.
     1594   procedure factord-max-fact-order :
     1595     define output parameter p-max-fact-order as decimal   no-undo .
     1596     do
     1597     on error undo, return error return-value
     1598     :
     1599       run day-begin-fact-order in this-procedure
     1600         (input  date(1, 1, 5000)
     1601         ,output p-max-fact-order
     1602         ) .
     1603     end.
     1604   end procedure.
     1605   procedure factord-cut-archive :
     1606     define input  parameter p-obj-type             as character no-undo .
     1607     define input  parameter p-obj-code             as integer   no-undo .
     1608     define input  parameter p-fact-date            as date      no-undo .
     1609     define output parameter p-shift-on             as logical   no-undo .
     1610     define output parameter p-shift-date           as date      no-undo .
     1611     define output parameter p-shift-num            as integer   no-undo .
     1612     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1613     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1614     define variable v-fact-order as decimal   no-undo .
     1615     define buffer buf_shift-obj for ub.shift-obj .
     1616     do
     1617     on error undo, return error return-value
     1618     :
     1619   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1621     (input  p-obj-type
     1622     ,input  p-obj-code
     1623     ,input  'shift-on=request'
     1624     ,output p-shift-on
     1625     ) no-error .
     1626       if error-status :error
     1627       then do:
     1628         message
     1629           vss-workfile vss-revision vss-description skip
     1630           "Ошибка при определении атрибута объекта" skip
     1631           "Объект" p-obj-type p-obj-code skip
     1632           error-status :get-message(1) skip
     1633           return-value skip
     1634           view-as alert-box error .
     1635         undo, return error return-value .
     1636       end.
     1637       if p-shift-on = false
     1638       then do:
     1639         assign
     1640           p-shift-date               = ?
     1641           p-shift-num                = 0
     1642         .
     1643       end.
     1644       else do:
     1645         find first buf_shift-obj share-lock
     1646           where buf_shift-obj.obj-type   = p-obj-type
     1647             and buf_shift-obj.obj-code   = p-obj-code
     1648             and buf_shift-obj.shift-date > p-fact-date
     1649           use-index pi
     1650           no-error .
     1651         if not available buf_shift-obj
     1652         or buf_shift-obj.status_ <> 'зкр':U
     1653         then do:
     1654           message
     1655             vss-workfile vss-revision vss-description skip
     1656             "Невозможно вычислить последнюю смену" skip
     1657             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1658             "Объект" p-obj-type p-obj-code skip
     1659             "Дата" p-fact-date skip
     1660             view-as alert-box error .
     1661           undo, return error return-value .
     1662         end.
     1663         find last buf_shift-obj share-lock
     1664           where buf_shift-obj.obj-type = p-obj-type
     1665             and buf_shift-obj.obj-code = p-obj-code
     1666             and buf_shift-obj.shift-date <= p-fact-date
     1667           use-index pi
     1668           no-error .
     1669         if available buf_shift-obj
     1670         then do:
     1671           if  buf_shift-obj.status_ = 'зкр':U
     1672           then do:
     1673             assign
     1674               p-shift-date = buf_shift-obj.shift-date
     1675               p-shift-num  = buf_shift-obj.shift-num
     1676             .
     1677           end.
     1678           else do:
     1679             message
     1680               vss-workfile vss-revision vss-description skip
     1681               "Невозможно вычислить последнюю смену" skip
     1682               "Статус смены отличен от статуса" 'зкр':U skip
     1683               "Объект" p-obj-type p-obj-code skip
     1684               "Дата" p-fact-date skip
     1685               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1686               view-as alert-box error .
     1687             undo, return error return-value .
     1688           end.
     1689         end.
     1690         else do:
     1691           assign
     1692             p-shift-date = p-fact-date - 1
     1693             p-shift-num  = 1
     1694           .
     1695         end.
     1696       end.
     1697       run factord in this-procedure
     1698         (input  p-fact-date
     1699         ,input  1
     1700         ,input  1
     1701         ,input  p-shift-date
     1702         ,input  p-shift-num
     1703         ,input  p-shift-on
     1704         ,output v-fact-order
     1705         ,output p-shift-end-fact-order
     1706         ,output p-day-end-fact-order
     1707         ) no-error .
     1708       if error-status :error
     1709       then do:
     1710         message
     1711           vss-workfile vss-revision vss-description skip
     1712           "Ошибка при вызове процедуры factord"
     1713           error-status :get-message(1) skip
     1714           return-value skip
     1715           view-as alert-box error .
     1716         undo, return error return-value .
     1717       end.
     1718     end.
     1719   end procedure.
     1720   procedure factord-lock-shift :
     1721     define input  parameter p-obj-type  as character no-undo .
     1722     define input  parameter p-obj-code  as integer   no-undo .
     1723     define input  parameter p-fact-date as date      no-undo .
     1724     define parameter buffer buf_shift-obj for ub.shift-obj .
     1725     define variable v-shift-on      as logical   no-undo .
     1726     define variable v-extra-message as character no-undo .
     1727     define variable v-error as character no-undo .
     1728     do
     1729     on error undo, return error return-value
     1730     :
     1731   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1732   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1733     (input  p-obj-type
     1734     ,input  p-obj-code
     1735     ,input  'shift-on=request'
     1736     ,output v-shift-on
     1737     ) no-error .
     1738       if error-status :error
     1739       then do:
     1740         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1741         undo, return error v-error .
     1742       end.
     1743       if v-shift-on = true
     1744       then do:
     1745         find first buf_shift-obj share-lock
     1746           where buf_shift-obj.obj-type   = p-obj-type
     1747             and buf_shift-obj.obj-code   = p-obj-code
     1748             and buf_shift-obj.shift-date > p-fact-date
     1749           use-index pi
     1750           no-error .
     1751         if not available buf_shift-obj
     1752         or buf_shift-obj.status_ <> 'зкр':U
     1753         then do:
     1754           find last buf_shift-obj
     1755             where buf_shift-obj.obj-type = p-obj-type
     1756               and buf_shift-obj.obj-code = p-obj-code
     1757               and buf_shift-obj.status_  = 'зкр':U
     1758             use-index stts
     1759             no-error .
     1760           if available buf_shift-obj
     1761           then do:
     1762             assign
     1763               v-extra-message =
     1764                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1765                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1766                               )
     1767             .
     1768           end.
     1769           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1770           undo, return error v-error .
     1771         end.
     1772       end.
     1773     end.
     1774   end procedure.
     1775   procedure factord-end-day :
     1776     define input  parameter p-fact-date            as date    no-undo .
     1777     define output parameter p-day-end-fact-order   as decimal no-undo .
     1778     do
     1779     on error undo, return error return-value
     1780     :
     1781       if p-fact-date = ?
     1782       then do:
     1783         return error "Не указана фактическая дата" .
     1784       end.
     1785       assign
     1786         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1787       .
     1788     end.
     1789   end procedure.
     1790   procedure factord-to-date :
     1791     define input  parameter p-fact-order as decimal no-undo .
     1792     define output parameter p-fact-date  as date    no-undo .
     1793     define variable v-ref-date  as date      no-undo .
     1794     define variable v-ref-delta as integer   no-undo .
     1795     do
     1796     on error undo, return error return-value
     1797     :
     1798       if p-fact-order = ?
     1799       or p-fact-order = 0
     1800       then do:
     1801         return error "Не указан fact-order" .
     1802       end.
     1803       assign
     1804         v-ref-date  = date(1, 1, 2000)
     1805       .
     1806       assign
     1807         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1808       .
     1809       assign
     1810         p-fact-date = v-ref-date + v-ref-delta
     1811       .
     1812     end.
     1813   end procedure.
     1814   procedure factord-to-fact-num :
     1815     define input  parameter p-fact-order as decimal no-undo .
     1816     define output parameter p-fact-num   as integer no-undo .
     1817     define variable v-fact-order-trunc as decimal no-undo .
     1818     do
     1819     on error undo, return error return-value
     1820     :
     1821       if p-fact-order = ?
     1822       or p-fact-order = 0
     1823       then do:
     1824         return error "Не указан fact-order" .
     1825       end.
     1826       assign
     1827        v-fact-order-trunc = truncate(p-fact-order, 2)
     1828       .
     1829       assign
     1830         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1831       .
     1832     end.
     1833   end procedure.
     1834   procedure factord-to-shift-num :
     1835     define input  parameter p-fact-order as decimal no-undo .
     1836     define output parameter p-shift-num   as integer no-undo .
     1837     define variable  p-shift-numd  as decimal   no-undo .
     1838     define variable v-fact-order-trunc as decimal no-undo .
     1839     do
     1840     on error undo, return error return-value
     1841     :
     1842       if p-fact-order = ?
     1843       or p-fact-order = 0
     1844       then do:
     1845         return error "Не указан fact-order" .
     1846       end.
     1847       assign
     1848        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1849       .
     1850       if v-fact-order-trunc < 0.5 then do:
     1851         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1852       end.
     1853       assign
     1854         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1855         .
     1856        assign
     1857         p-shift-num = truncate (p-shift-numd , 0)
     1858       .
     1859     end.
     1860   end procedure.
