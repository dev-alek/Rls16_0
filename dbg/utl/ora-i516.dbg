      814   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      815   function octal-to-char return character
      816   ( p-string as character ) :
      817     def var v-asc     as integer no-undo .
      818     def var v-new-asc as integer no-undo .
      819     def var ind       as integer no-undo .
      820     if length(p-string) <> 3 then do:
      821       return ? .
      822     end.
      823     assign
      824       v-asc = 0
      825     .
      826     do ind = 1 to length(p-string)
      827     :
      828       assign
      829         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      830       .
      831       if v-new-asc < 0 or v-new-asc >= 8 then do:
      832         return ? .
      833       end.
      834       assign
      835         v-asc = v-asc * 8 + v-new-asc
      836       .
      837     end.
      838     return chr(v-asc) .
      839   end function .
      840   function char-to-octal return character
      841   ( p-chr as character ) :
      842     def var v-asc    as integer   no-undo .
      843     def var ind      as integer   no-undo .
      844     def var v-string as character no-undo .
      845     if length(p-chr) <> 1 then do:
      846       return ? .
      847     end.
      848     assign
      849       v-asc    = asc(p-chr)
      850       v-string = ""
      851     .
      852     do ind = 1 to 3
      853     :
      854       assign
      855         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      856       .
      857       assign
      858         v-asc = truncate(v-asc / 8, 0)
      859       .
      860     end.
      861     return v-string .
      862   end.
      863   function str-encode return character
      864   (   p-init-string       as character
      865     , p-encode-char       as character
      866     , p-special-char-list as character
      867   ) :
      868     def var p-encode-string as character no-undo .
      869     def var ind                as integer no-undo .
      870     def var v-num-special-char as integer no-undo .
      871     def var v-special-char     as character no-undo .
      872     if p-encode-char = ?
      873     or p-encode-char = "" then do:
      874       assign
      875         p-encode-char = "~~"
      876       .
      877     end.
      878     if p-init-string = ? then do:
      879       return "?" .
      880     end.
      881     if p-init-string = "?" then do:
      882       return p-encode-char + char-to-octal("?") .
      883     end.
      884     assign
      885       v-num-special-char = length(p-special-char-list)
      886       p-encode-string    = replace(p-init-string
      887                                   ,p-encode-char
      888                                   ,p-encode-char + char-to-octal(p-encode-char)
      889                                   )
      890     .
      891     do ind = 1 to v-num-special-char
      892     :
      893       assign
      894         v-special-char = substring(p-special-char-list, ind, 1)
      895       .
      896       if v-special-char <> p-encode-char then do:
      897         assign
      898           p-encode-string = replace (p-encode-string
      899                                     ,v-special-char
      900                                     ,p-encode-char + char-to-octal(v-special-char)
      901                                     )
      902         .
      903       end.
      904     end.
      905     return p-encode-string .
      906   end.
      907   function str-decode returns character
      908     (p-init-string   as character
      909     ,p-encode-char   as character
      910     ) :
      911     def var p-decode-string as character no-undo .
      912     def var ind                       as integer no-undo .
      913     def var v-num-entries-init-string as integer no-undo .
      914     def var v-sub-phrase              as character no-undo .
      915     def var v-special-char            as character no-undo .
      916     if p-encode-char = ?
      917     or p-encode-char = "" then do:
      918       assign
      919         p-encode-char = "~~"
      920       .
      921     end.
      922     if p-init-string = "?" then do:
      923       return ? .
      924     end.
      925     assign
      926       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      927     .
      928     if v-num-entries-init-string > 1 then do:
      929       assign
      930         p-decode-string = entry(1, p-init-string, p-encode-char)
      931       .
      932       do ind = 2 to v-num-entries-init-string
      933       :
      934         assign
      935           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      936         .
      937         assign
      938           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      939         .
      940         if v-special-char <> ? then do:
      941           assign
      942             p-decode-string = p-decode-string
      943                             + v-special-char
      944                             + substring(v-sub-phrase, 4)
      945           .
      946         end.
      947         else do:
      948           assign
      949             p-decode-string = p-decode-string
      950                             + p-encode-char
      951                             + v-sub-phrase
      952           .
      953         end.
      954       end.
      955     end.
      956     else do:
      957       assign
      958         p-decode-string = p-init-string
      959       .
      960     end.
      961     return p-decode-string .
      962   end.
      963   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      964   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      965   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      966     field cst-code                like ub.trn-doc.cst-code
      967     field part-code               like ub.parts.part-code
      968     .
      969   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      970   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      971   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      972   function hvrdtax return logical (input parrecid as recid):
      973   define variable varresult as logical no-undo.
      974   run hvrdtax-proc (input parrecid, output varresult).
      975   return varresult.
      976   end function.
      977   procedure hvrdtax-proc:
      978   define input  parameter parrecid  as recid   no-undo.
      979   define output parameter parresult as logical no-undo.
      980   define buffer bf_goods for ub.goods.
      981   define buffer bf_units for ub.units.
      982   define buffer rt_tax   for ub.tax.
      983   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      984   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      985   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      986   if available rt_tax and
      987       can-find(first ub.tax-units No-LOCK WHERE
      988                      ub.tax-units.tax-code = rt_tax.tax-code AND
      989                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      990                                                       else assign parresult = no.
      991   end procedure.
      992   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   define new global shared variable g#lib-calc as handle no-undo .
      994   procedure plgdsfnd :
      995     define input  parameter p-chk-and-chs    as logical               no-undo .
      996     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      997     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      998     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      999     define output parameter p-reserv-pl-code as   logical             no-undo .
     1000     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1001     define buffer buf_goods         for ub.goods .
     1002     define buffer buf_pl-gds        for ub.pl-gds .
     1003     define buffer buf_second_pl-gds for ub.pl-gds .
     1004     find first buf_goods no-lock where
     1005                buf_goods.gds-code = p-gds-code no-error .
     1006     if not available buf_goods
     1007     then do:
     1008       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1009     end.
     1010   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1012     (input  p-obj-type
     1013     ,input  p-obj-code
     1014     ,input  buf_goods.artic
     1015     ,input  buf_goods.prod-type
     1016     ,input  buf_goods.prod-code
     1017     ,input  'place-rsrv=request'
     1018     ,output p-reserv-pl-code
     1019     ) no-error .
     1020     if error-status :error
     1021     then do:
     1022       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1023     end.
     1024     if p-reserv-pl-code = no
     1025     then do:
     1026       return .
     1027     end.
     1028     if p-chk-and-chs <> yes
     1029     then do:
     1030       return .
     1031     end.
     1032     find first buf_pl-gds no-lock where
     1033                buf_pl-gds.obj-type = p-obj-type and
     1034                buf_pl-gds.obj-code = p-obj-code and
     1035                buf_pl-gds.gds-code = p-gds-code no-error .
     1036     if not available buf_pl-gds
     1037     then do:
     1038       return error "К товару не привязано ни одного места хранения" .
     1039     end.
     1040     find first buf_second_pl-gds no-lock where
     1041                buf_second_pl-gds.obj-type  = p-obj-type          and
     1042                buf_second_pl-gds.obj-code  = p-obj-code          and
     1043                buf_second_pl-gds.gds-code  = p-gds-code          and
     1044                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1045     if not available buf_second_pl-gds
     1046     then do:
     1047       assign
     1048         p-pl-code = buf_pl-gds.pl-code
     1049       .
     1050     end.
     1051     else do:
     1052       if not valid-handle( parparentproc )
     1053       then do:
     1054         return error "Не выбрано место хранения " + chr(10) .
     1055       end.
     1056       run str/plgdssel.p
     1057         (
     1058            input parparentproc
     1059         ,  input p-obj-type
     1060         ,  input p-obj-code
     1061         ,  input p-gds-code
     1062         , output p-pl-code
     1063         ) no-error .
     1064       if error-status :error
     1065       then do:
     1066         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1067                                , 'plgdssel.p':U
     1068                                , chr(10)
     1069                                , error-status :get-message( 1 )
     1070                                , return-value
     1071                                ) .
     1072       end.
     1073       if p-pl-code = ? or
     1074          p-pl-code = 0
     1075       then do:
     1076         return error "Не выбрано место хранения " + chr(10) .
     1077       end.
     1078     end.
     1079   end procedure.
     1080   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1082   define temp-table tt-doc-line no-undo like ub.doc-line
     1083   field cst-code like ub.trn-doc.cst-code
     1084   .
     1085   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1086   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1087   define temp-table tt-parts    no-undo like ub.parts.
     1088   procedure lib-trn_copy-inqu :
     1089   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1090   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1091   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1092   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1093   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1094   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1095   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1096   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1097   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1098   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1099   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1100   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1101   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1102   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1103   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1104   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1105   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1106   define input parameter parinp-discnt-type as   logical                no-undo.
     1107   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1108   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1109   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1110   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1111   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1112   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1113   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1114   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1115   define input parameter table for tt-doc-line.
     1116   define input parameter table for tt-gds-dtl.
     1117   define input parameter table for tt-parts.
     1118   define input parameter paruse-parts       as   logical                no-undo.
     1119   define input parameter parall-qnty        as   logical                no-undo.
     1120   define input parameter parfix-price       as   logical                no-undo.
     1121   define buffer crt_trn-doc  for ub.trn-doc.
     1122   define buffer crt_goods    for ub.goods.
     1123   define buffer crt_doc-line for ub.doc-line.
     1124   define buffer crt_gds-dtl  for ub.gds-dtl.
     1125   define variable end-price    as   logical              no-undo.
     1126   define variable real-type    like ub.goods.gds-type    no-undo.
     1127   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1128   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1129   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1130   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1131   define variable g-log        as   logical              no-undo.
     1132   define variable mem-qnty like chg-qnty no-undo.
     1133   define variable dflt-cd as character no-undo .
     1134   c-l:
     1135   do on error undo, return error return-value :
     1136   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1137   assign
     1138       paruse-parts = false
     1139       .
     1140   assign
     1141     end-price = no.
     1142   if parinp-discnt-type = yes and
     1143      parinp-discnt-pc   = 0   and
     1144      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1145      then do:
     1146     assign
     1147       crt_trn-doc.tot-calc    = partot-calc
     1148       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1149       crt_trn-doc.discnt-type = pardiscnt-type.
     1150   end.
     1151   if parinp-agnt = ? then do:
     1152     assign
     1153       crt_trn-doc.agnt = paragnt.
     1154   end.
     1155   if parinp-boss = ? then do:
     1156     assign
     1157       crt_trn-doc.boss = parboss.
     1158   end.
     1159   if parinp-wrkr = ? then do:
     1160     assign
     1161       crt_trn-doc.wrkr = parwrkr.
     1162   end.
     1163   if parinp-base-rate  = ? then do:
     1164     assign
     1165       crt_trn-doc.base-rate  = parbase-rate.
     1166   end.
     1167   if parinp-base-scale = ? then do:
     1168     assign
     1169       crt_trn-doc.base-scale = parbase-scale.
     1170   end.
     1171   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1172   if available tt-doc-line then do:
     1173     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1174                      and crt_goods.prod-type = tt-doc-line.prod-type
     1175                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1176     if crt_goods.gds-type = 'у':U and
     1177        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1178       return error "В данный документ нельзя копировать услуги.".
     1179     end.
     1180     assign
     1181       real-type = crt_goods.gds-type.
     1182     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1183     if available crt_doc-line then do:
     1184       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1185                        and crt_goods.prod-type = crt_doc-line.prod-type
     1186                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1187       if crt_goods.gds-type <> real-type then do:
     1188         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1189       end.
     1190     end.
     1191     else do:
     1192       assign
     1193         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1194     end.
     1195   end.
     1196   r-l:
     1197   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1198     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1199                      and crt_goods.prod-type = tt-doc-line.prod-type
     1200                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1201   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1202      (
     1203       input crt_trn-doc.doc-code
     1204      ,input crt_trn-doc.obj-type
     1205      ,input crt_trn-doc.obj-code
     1206      ,input crt_goods.artic
     1207      ,input crt_goods.prod-type
     1208      ,input crt_goods.prod-code
     1209      ,input crt_goods.gds-name
     1210      ,input crt_goods.prt-root
     1211      ,input ?
     1212      ,input ?
     1213      ,input parcash-pay      ) no-error.
     1214     if error-status:error then do:
     1215       undo c-l, return error return-value.
     1216     end.
     1217     if return-value = "next" then do:
     1218       next r-l.
     1219     end.
     1220     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1221                                   crt_doc-line.artic     = crt_goods.artic      and
     1222                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1223                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1224     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1225                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1226                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1227                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1228                               break by tt-gds-dtl.artic
     1229                                     by tt-gds-dtl.prod-type
     1230                                     by tt-gds-dtl.prod-code
     1231                               :
     1232   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1233     ( input  tt-gds-dtl.artic
     1234      ,input  tt-gds-dtl.prod-type
     1235      ,input  tt-gds-dtl.prod-code
     1236      ,input  tt-gds-dtl.prt-code
     1237      ,input  tt-doc-line.obj-type
     1238      ,input  tt-doc-line.obj-code
     1239      ,output legal-node
     1240     ) no-error .
     1241       if error-status:error then do:
     1242          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1243       end.
     1244   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1245     ( input crt_trn-doc.obj-code
     1246      ,input crt_trn-doc.obj-type
     1247      ,input crt_trn-doc.doc-code
     1248      ,input crt_goods.artic
     1249      ,input crt_goods.prod-code
     1250      ,input crt_goods.prod-type
     1251      ,input legal-node
     1252      ,input yes
     1253     ) no-error .
     1254        if error-status:error then do:
     1255           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1256        end.
     1257        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1258                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1259                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1260                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1261                                     crt_gds-dtl.prt-code  = legal-node.
     1262       assign
     1263         crt_gds-dtl.ov             = parfix-price
     1264         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1265         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1266         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1267         .
     1268       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1269         assign
     1270           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1271           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1272           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1273           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1274       end.
     1275       if end-price then do:
     1276         assign
     1277           crt_gds-dtl.ov             = yes
     1278           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1279           crt_gds-dtl.discnt-base    = 0
     1280           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1281           crt_gds-dtl.discnt-rubl    = 0
     1282           crt_gds-dtl.discnt-pc      = 0
     1283           crt_gds-dtl.discnt-type    = yes.
     1284       end.
     1285   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1287     ( input recid(crt_gds-dtl)
     1288     , input no
     1289     , input ?
     1290     ) no-error.
     1291           if error-status:error then do:
     1292             undo c-l, return error return-value.
     1293           end.
     1294       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1295          crt_gds-dtl.ov then do:
     1296         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1297       end.
     1298       if paruse-parts then do:
     1299          if first-of (tt-gds-dtl.prod-code) then do:
     1300            for each tt-parts :
     1301              assign
     1302                chg-qnty = tt-parts.fact-qnty
     1303                mem-qnty = chg-qnty.
     1304              assign
     1305              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1306              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1307            end.
     1308            assign
     1309              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1310              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1311            assign
     1312              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1313              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1314            if crt_gds-dtl.doc-qnty = 0 then do:
     1315              delete crt_gds-dtl.
     1316            end.
     1317          end.
     1318       end.
     1319       else do:
     1320         assign
     1321           chg-qnty = tt-gds-dtl.fact-qnty
     1322           mem-qnty = chg-qnty.
     1323         assign
     1324           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1325           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1326           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1327           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1328         assign
     1329         varchg-qnty  = varchg-qnty  + chg-qnty
     1330         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1331         if crt_gds-dtl.doc-qnty = 0 then do:
     1332           delete crt_gds-dtl.
     1333         end.
     1334       end.
     1335     end.
     1336     if crt_doc-line.doc-qnty = 0 then do:
     1337       delete crt_doc-line.
     1338     end.
     1339   end.
     1340   end.
     1341   end procedure.
     1342   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1343     define variable v-cntxt-db-num        as integer   no-undo .
     1344     define variable v-cntxt-userid        as character no-undo .
     1345     define variable v-cntxt-level         as character no-undo .
     1346     define variable v-cntxt-host-code-obj as integer   no-undo .
