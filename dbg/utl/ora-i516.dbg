      100   procedure vss-get-parameters :
      101     define output parameter p-vss-parameters as character no-undo .
      102   end procedure.
      103   define new global shared variable g#vssrevis-logger as handle    no-undo .
      104   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      105   define variable v-vssrevis-logger                   as handle    no-undo .
      106   procedure vss-logevent :
      107     define input  parameter p-extra-paramters as character no-undo .
      108     define variable v-vssrevis-parameters as character no-undo .
      109     do
      110     on error undo, return error return-value
      111     :
      112       if  valid-handle(v-vssrevis-logger)
      113       and v-vssrevis-logger :get-signature("logevent") <> ""
      114       then do:
      115         run vss-get-parameters in this-procedure
      116           (output v-vssrevis-parameters
      117           ).
      118         run logevent in v-vssrevis-logger
      119           (input vss-workfile
      120           ,input vss-revision
      121           ,input v-vssrevis-parameters
      122           ,input p-extra-paramters
      123           ).
      124       end.
      125     end.
      126   end procedure.
      127   assign
      128     v-vssrevis-logger = g#vssrevis-logger
      129   .
      130   if  valid-handle(v-vssrevis-logger)
      131   and v-vssrevis-logger :get-signature("logevent") <> ""
      132   then do:
      133     assign
      134       v-vssrevis-logevent = true
      135     .
      136     run vss-logevent in this-procedure (input vss-description) .
      137   end.
      138   define new global shared variable g#language as character no-undo .
      139   if g#language <> '' and g#language <> 'rus':U then do:
      140     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      141   end.
      142   define new global shared variable g#library  as handle no-undo .
      143   define new global shared variable g#library2 as handle no-undo .
      144   define new global shared variable g#lib-trn  as handle no-undo .
      145   define new global shared variable g#lib-trn2 as handle no-undo .
      146   define new global shared variable g#lib-trn3 as handle no-undo .
      147   define new global shared variable g#lib-trn4 as handle no-undo .
      148   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149   define variable to-day       as date no-undo .
      150   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   procedure doc-code:
      152   define input  parameter parmode          as   character           no-undo.
      153   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      154   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      155   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      156   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      157   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      158   define variable vardb-remote     as   logical             no-undo.
      159   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      160   define variable v-delimiter as character no-undo .
      161   do
      162   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      163   :
      164   find first buf_sys-ctrl no-lock .
      165   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      166     CASE parmode:
      167       when "main":u then do:
      168         if vardb-remote then do:
      169           assign
      170             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      171         end.
      172         else do:
      173           assign
      174             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      175         end.
      176       end.
      177       when "trio" then do:
      178         assign
      179           pardoc-code = replace (parroot-doc-code, "=", "*").
      180       end.
      181       otherwise do:
      182         assign
      183         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      184         no-error
      185         .
      186         if error-status:error  then do:
      187           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      188                                         ,chr(10)
      189                                         ,parmode
      190                                         ).
      191         end.
      192         if num-entries(parmode) = 1
      193         and parmode <> "chip":U
      194         and parmode <> "chip_s":U
      195         then do:
      196           assign
      197           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      198         end.
      199         else if (lookup("chip":U, parmode) > 0
      200                  or
      201                  lookup("chip_s":U, parmode) > 0) then do:
      202           assign
      203             vartemp-doc-code = parroot-doc-code.
      204           do while true:
      205             if index (vartemp-doc-code , ".") = 0 then
      206               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      207             else
      208               vartemp-doc-code  =
      209               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      210               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      211               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      212             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      213           end.
      214           assign
      215             pardoc-code = vartemp-doc-code.
      216         end.
      217       end.
      218     end CASE.
      219     if pardoc-code = '':U
      220     or (parroot-doc-code <> '':U
      221     and pardoc-code = parroot-doc-code) then do:
      222       undo, return error substitute("Ошибка при генерации номера документа&1"
      223                                     ,chr(10)).
      224     end.
      225   end.
      226   end. // procedure/method
      227   function get-doc-code-int64 returns int64
      228     ( input p-doc-code as character ) :
      229     define variable v-ind              as integer   no-undo .
      230     define variable v-num-entries      as integer   no-undo .
      231     define variable v-doc-code-int64   as int64     no-undo .
      232     define variable v-canonic-doc-code as character no-undo .
      233     assign
      234       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      235       v-canonic-doc-code = p-doc-code
      236     .
      237     do v-ind = 1 to v-num-entries
      238     :
      239       assign
      240         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      241       .
      242     end.
      243     assign
      244       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      245     .
      246     return v-doc-code-int64 .
      247   end. // function/method
      248   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      249   define variable v-waitfram-action01         as character   no-undo .
      250   define variable v-waitfram-action02         as character   no-undo .
      251   define variable v-waitfram-action03         as character   no-undo .
      252   define variable mWaitFramTextBeg            as character   no-undo.
      253   define variable mWaitFramTextEnd            as character   no-undo.
      254   define variable mWaitFramView               as logical     no-undo.
      255   define variable mWaitProcEvent              as logical     no-undo init yes.
      256   define variable mWaitFramInterval           as integer     no-undo init 1 .
      257   define variable mWaitFramStop               as logical     no-undo.
      258   define variable mWaitFramStopUser           as logical     no-undo.
      259   define variable mWaitFramStopTimeOut        as logical     no-undo.
      260   define variable mWaitFramStartProc          as datetime-tz no-undo.
      261   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      262   define button B-WaitFramStop auto-end-key
      263        label "Стоп"
      264        size 10 by 1 tooltip "Остоновить процесс".
      265   define button B-viewProcInfo
      266        label "Информация"
      267        size 15 by 1 tooltip "Информация о процесс".
      268   define frame waitfram
      269     v-waitfram-action01 format "x(72)" no-label skip
      270     v-waitfram-action02 format "x(72)" no-label skip
      271     v-waitfram-action03 format "x(72)" no-label skip
      272     B-viewProcInfo
      273     B-WaitFramStop at row 4 col 30
      274     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      275     .
      276   define new global shared variable mBatchMode as logical no-undo init ?.
      277   define variable mFramBachModHandle as handle no-undo.
      278   mFramBachModHandle = frame waitfram:handle.
      279   define variable mFameOldVis as logical no-undo.
      280   define variable mVisCUrentVin as logical no-undo.
      281   if session:batch-mode
      282   then
      283      mBatchMode = yes.
      284   if mBatchMode = ? then do:
      285     mVisCUrentVin = current-window:visible.
      286     mFameOldVis = mFramBachModHandle:visible.
      287     mFramBachModHandle:visible  = yes.
      288     mBatchMode = mFramBachModHandle:visible ne yes.
      289     mFramBachModHandle:visible = mFameOldVis.
      290     current-window:visible = mVisCUrentVin.
      291   end.
      292    if  log-manager:logfile-name ne ?
      293     then DO:
      294         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      295         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      296         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      297     end.
      298   on choose of B-WaitFramStop in frame waitfram
      299   do:
      300     mWaitFramStop = yes.
      301     mWaitFramStopUser = yes.
      302   end.
      303   function waitfram-check-timeout returns logical():
      304      define variable vtime as int64 no-undo.
      305      if mWaitFramStopTimeOut
      306      then
      307         return yes.
      308      vtime = ( now - mWaitFramStartProc ) / 1000 .
      309      if     mWaitFramTimeOut ne ?
      310         and mWaitFramTimeOut ne 0
      311         and mWaitFramTimeOut lt vtime
      312      then do:
      313         mWaitFramStopTimeOut = yes.
      314      end.
      315      return mWaitFramStopTimeOut.
      316   end.
      317   procedure waitfram-hide :
      318     if not session:batch-mode
      319     then do
      320     on error undo, return error return-value
      321     :
      322       pause 0 before-hide .
      323       if not mBatchMode then
      324         hide frame waitfram .
      325     if     not mWaitFramView
      326        and mWaitProcEvent
      327     then
      328       process events .
      329     end.
      330   end procedure.
      331   procedure waitfram-show :
      332     define input  parameter p-message as character no-undo .
      333     define variable v-left-margin as integer   no-undo .
      334     if not session:batch-mode
      335     then do
      336     on error undo, return error return-value
      337     :
      338       if length(p-message) <= 70 then do:
      339         assign
      340           v-left-margin = integer((70 - length(p-message)) / 2)
      341         .
      342         assign
      343           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      344         .
      345         assign
      346           v-waitfram-action01 = " "
      347           v-waitfram-action02 = " "
      348                                    + fill(" ", v-left-margin)
      349                                    + p-message
      350           v-waitfram-action03 = " "
      351         .
      352       end.
      353       else do:
      354         define variable vRindex1 as integer no-undo.
      355         define variable vRindex2 as integer no-undo.
      356         vRindex1 = r-index(p-message," ",70).
      357         if vRindex1 = 0
      358         then
      359            vRindex1 = 70.
      360         if length(p-message)  <= vRindex1 + 70 then do:
      361           assign
      362             v-waitfram-action01 = " "
      363             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      364             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      365           .
      366         end.
      367         else do:
      368           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      369           if vRindex2 <= vRindex1
      370           then
      371              vRindex2 = vRindex1 + 70.
      372           assign
      373             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      374             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      375             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      376           .
      377         end.
      378       end.
      379       B-viewProcInfo:visible   in frame waitfram = no.
      380       B-viewProcInfo:sensitive in frame waitfram = no.
      381       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      382       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      383       if  (   mWaitFramView
      384          or  mWaitProcEvent)
      385          and not mBatchMode
      386       then
      387          display
      388             v-waitfram-action01 skip
      389             v-waitfram-action02 skip
      390             v-waitfram-action03 skip
      391          with frame waitfram .
      392       if     mWaitFramView
      393          then do:
      394             if     mWaitFramInterval ne ?
      395                and not mBatchMode
      396             then
      397                wait-for go of frame waitfram pause mWaitFramInterval.
      398          end.
      399          else
      400             if     mWaitProcEvent
      401                and not mBatchMode
      402             then
      403                process events .
      404     end.
      405   end procedure.
      406      procedure waitfram-show-this:
      407         define input  parameter iInterval as int64 no-undo.
      408         define variable vtime as int64 no-undo.
      409         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      410         mWaitFramInterval = iInterval.
      411         run waitfram-show (substitute("&1&2 &3&4" ,
      412                                       mWaitFramTextBeg ,
      413                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      414                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      415                                       mWaitFramTextEnd
      416                                      )
      417                           ).
      418      end.
      419      procedure WaitFramRunPause:
      420         define input  parameter iInterval as dec no-undo.
      421         define variable vStart  as datetime-tz no-undo.
      422         define variable vend    as datetime-tz no-undo.
      423         define variable vint as int64 no-undo.
      424         define variable vOk as logical no-undo.
      425         vStart = now.
      426         vend   = vStart.
      427         publish "WaitFramPause" (iInterval,output vOk).
      428         vend   =  now.
      429         vint = vend - vStart.
      430         vint = iInterval - vint / 1000.
      431         if     not mWaitFramStop
      432            and (   vint > 0
      433                 or (    not vOk
      434                     and iInterval eq ?
      435                     )
      436                 )
      437         then
      438            run waitfram-show-this (iInterval).
      439         vend   =  now.
      440         vint = vend - vStart.
      441         vint = iInterval - vint / 1000.
      442         if     not mWaitFramStop
      443            and vint > 0
      444         then do:
      445            run gbl/pause.p (vint * 1000).
      446         end.
      447         if iInterval ne ?
      448         then
      449            publish "WaitFramStop".
      450         waitfram-check-timeout().
      451      end.
      452      procedure WaitFramWaitFor:
      453         define input  parameter iInterval as dec no-undo.
      454         assign
      455            mWaitFramStartProc   = now
      456            mWaitFramStopUser    = no
      457            mWaitFramStopTimeOut = no
      458         .
      459         block-wait:
      460         do while not mWaitFramStop:
      461            run WaitFramRunPause (iInterval).
      462            if  waitfram-check-timeout()
      463            then do:
      464               leave block-wait.
      465            end.
      466         end.
      467         run waitfram-hide.
      468      end.
      469   procedure waitfram-join :
      470     define input  parameter p-line-1  as character no-undo .
      471     define input  parameter p-line-2  as character no-undo .
      472     define input  parameter p-line-3  as character no-undo .
      473     define output parameter p-message as character no-undo .
      474     do
      475     on error undo, return error return-value
      476     :
      477       assign
      478         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      479                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      480                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      481       .
      482     end.
      483   end procedure.
      484   function waitfram-join-function returns character
      485     (input p-line-1 as character
      486     ,input p-line-2 as character
      487     ,input p-line-3 as character
      488     ).
      489     define variable v-message as character no-undo .
      490     run waitfram-join in this-procedure
      491       (input  p-line-1
      492       ,input  p-line-2
      493       ,input  p-line-3
      494       ,output v-message
      495       ) .
      496     return v-message .
      497   end function .
      498   function cross-list returns logical (
      499     input parfirst-stream  as character,
      500     input parsecond-stream as character,
      501     input pardelim         as character).
      502     if pardelim = ""
      503     or pardelim = ?
      504     then do:
      505       assign
      506         pardelim = ","
      507       .
      508     end.
      509     define variable vari            as integer no-undo .
      510     define variable varresult-cross as logical no-undo .
      511     assign
      512       varresult-cross = no
      513     .
      514     def var v-num-parfirst-stream as integer no-undo .
      515     assign
      516       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      517     .
      518     do vari = 1 to v-num-parfirst-stream
      519     :
      520       if lookup(entry(vari, parfirst-stream, pardelim)
      521                ,parsecond-stream
      522                ,pardelim
      523                ) > 0 then do:
      524         assign
      525           varresult-cross = yes
      526         .
      527         leave.
      528       end.
      529     end.
      530     return varresult-cross .
      531   end function.
      532   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533   define new global shared variable g#attr-lib  as handle no-undo .
      534   define variable v-attr-lib-variable as handle no-undo .
