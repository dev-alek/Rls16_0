        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Утилита - Список документов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   RUN set-attribute-list (
      108       'Keys-Accepted = ,
      109        Keys-Supplied = "obj-code,doc-code,host-code"':U).
      110   RUN set-attribute-list (
      111       'SortBy-Options = ""':U).
      112   DEFINE VARIABLE vardoc-code AS CHARACTER FORMAT "X(256)":U
      113        VIEW-AS FILL-IN
      114        SIZE 19.75 BY 1.08 NO-UNDO.
      115   DEFINE QUERY br_table FOR
      116         trn-doc SCROLLING.
      117   DEFINE BROWSE br_table
      118     QUERY br_table NO-LOCK DISPLAY
      119         trn-doc.doc-code FORMAT "X(14)":U
      120         trn-doc.doc-type FORMAT "X(8)":U
      121         trn-doc.flag_ FORMAT "yes/no":U
      122         trn-doc.status_ FORMAT "X(8)":U
      123         trn-doc.doc-date FORMAT "99/99/99":U
      124         trn-doc.fact-date FORMAT "99/99/99":U
      125         trn-doc.obj-code FORMAT "99999":U
      126         trn-doc.obj-type FORMAT "X(3)":U
      127         trn-doc.cli-code FORMAT ">>>>>>>>9":U
      128         trn-doc.cli-name FORMAT "X(40)":U
      129         trn-doc.cli-type FORMAT "X(3)":U
      130       WITH NO-ASSIGN SEPARATORS SIZE 76.88 BY 6.71.
      131   DEFINE FRAME F-Main
      132        br_table AT ROW 1 COL 1
      133        vardoc-code AT ROW 1.21 COL 76.38 COLON-ALIGNED NO-LABEL
      134       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      135            SIDE-LABELS NO-UNDERLINE THREE-D
      136            AT COL 1 ROW 1 SCROLLABLE
      137            BGCOLOR 8 FGCOLOR 0 .
      138   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      139   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      140   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      141   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      142   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      143   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      144   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      145   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      146   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      147   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      148   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      149         adm-object-hdl = FRAME F-Main:HANDLE.
      150   RUN ensure-broker.
      151   THIS-PROCEDURE:ADM-DATA =
      152        'ADM1.1~`':U +
      153        'SmartObject~`':U +
      154        '~`':U +
      155        'YES~`':U +
      156        '~`':U +
      157        'trn-doc~`':U +
      158        '~`':U +
      159        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      160           + "~`":U +
      161        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      162        'Record-Source,Record-Target,TableIO-Target~`':U +
      163        '~`':U +
      164        '~`~`~`~`~`~`~`~`~`~`~`':U +
      165        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      166            THEN "^^":U
      167        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      168             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      169   PROCEDURE adm-apply-entry :
      170     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      171   END PROCEDURE.
      172   PROCEDURE adm-destroy :
      173    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      174   END PROCEDURE.
      175   PROCEDURE adm-disable :
      176       DISABLE br_table vardoc-code WITH FRAME F-Main.
      177       RUN dispatch ('disable-fields':U).
      178       RUN set-attribute-list ('ENABLED=no':U).
      179       RETURN.
      180   END PROCEDURE.
      181   PROCEDURE adm-edit-attribute-list :
      182         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      183         RETURN.
      184   END PROCEDURE.
      185   PROCEDURE adm-enable :
      186       ENABLE UNLESS-HIDDEN br_table vardoc-code WITH FRAME F-Main.
      187       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      188       RUN set-attribute-list ('ENABLED=yes':U).
      189       RETURN.
      190   END PROCEDURE.
      191   PROCEDURE adm-exit :
      192        RUN notify ('exit':U).
      193     RETURN.
      194   END PROCEDURE.
      195   PROCEDURE adm-hide :
      196     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      197   END PROCEDURE.
      198   PROCEDURE adm-initialize :
      199     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      200   END PROCEDURE.
      201   PROCEDURE adm-show-errors :
      202       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      203       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      204           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      205       END.
      206       RETURN.
      207   END PROCEDURE.
      208   PROCEDURE adm-UIB-mode :
      209     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      210   END PROCEDURE.
      211   PROCEDURE adm-view :
      212     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      213   END PROCEDURE.
      214   PROCEDURE dispatch :
      215       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      216       RUN broker-dispatch IN adm-broker-hdl
      217           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      218       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      219   END PROCEDURE.
      220   PROCEDURE ensure-broker :
      221   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      222   IF RETURN-VALUE NE "ADM-Broker":U THEN
      223   DO:
      224       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      225       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      226   END.
      227   END PROCEDURE.
      228   PROCEDURE get-attribute :
      229     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      230     RUN broker-get-attribute IN adm-broker-hdl
      231         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      232     RETURN RETURN-VALUE.
      233   END PROCEDURE.
      234   PROCEDURE get-attribute-list :
      235     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      236     RUN broker-get-attribute-list IN adm-broker-hdl
      237         (INPUT THIS-PROCEDURE,
      238          INPUT ?,
      239          OUTPUT p-attr-list) NO-ERROR.
      240     RETURN.
      241   END PROCEDURE.
      242   PROCEDURE new-state :
      243     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      244     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      245     RETURN.
      246   END PROCEDURE.
      247   PROCEDURE notify :
      248     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      249     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      250     IF RETURN-VALUE = "ADM-ERROR":U THEN
      251         RETURN "ADM-ERROR":U.
      252     RETURN.
      253   END PROCEDURE.
      254   PROCEDURE set-attribute-list :
      255     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      256     RUN ensure-broker.
      257     RUN broker-set-attribute-list IN adm-broker-hdl
      258         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      259     RETURN.
      260   END PROCEDURE.
      261   PROCEDURE set-position :
      262       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      263       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      264       IF VALID-HANDLE(adm-object-hdl) THEN
      265       DO:
      266         ASSIGN adm-object-hdl:ROW    =   p-row
      267                adm-object-hdl:COLUMN =   p-col.
      268       END.
      269       RETURN.
      270   END PROCEDURE.
      271     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      272     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      273     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      274     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      275     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      276     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      277     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      278     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      279     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      280     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      281     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      282     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      283     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      284     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      285     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      286     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      287     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      288     IF "":U = "":U THEN
      289       RUN modify-list-attribute IN adm-broker-hdl
      290         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      291     RUN use-create-on-add(?).
      292   PROCEDURE adm-add-record :
      293       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      294          "must have at least one Enabled Table to perform Add.":U
      295          VIEW-AS ALERT-BOX ERROR.
      296       RETURN.
      297   END PROCEDURE.
      298   PROCEDURE adm-assign-record :
      299    MESSAGE
      300          "Object ":U THIS-PROCEDURE:FILE-NAME
      301            "must have at least one Enabled Table to perform Assign.":U
      302              VIEW-AS ALERT-BOX ERROR.
      303      RETURN.
      304     END PROCEDURE.
      305   PROCEDURE adm-assign-statement :
      306     RETURN.
      307   END PROCEDURE.
      308   PROCEDURE adm-cancel-record :
      309      RETURN.
      310     END PROCEDURE.
      311   PROCEDURE adm-copy-record :
      312       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      313        "must have at least one Enabled Table to perform Copy.":U
      314          VIEW-AS ALERT-BOX ERROR.
      315       RETURN.
      316   END PROCEDURE.
      317   PROCEDURE adm-create-record :
      318      RETURN.
      319   END PROCEDURE.
      320   PROCEDURE adm-current-changed :
      321     RETURN.
      322   END PROCEDURE.
      323   PROCEDURE adm-delete-record :
      324    MESSAGE
      325          "Object ":U THIS-PROCEDURE:FILE-NAME
      326            "must have at least one Enabled Table to perform Delete.":U
      327              VIEW-AS ALERT-BOX ERROR.
      328       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      329       RETURN.
      330   END PROCEDURE.
      331   PROCEDURE adm-disable-fields :
      332         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      333       RETURN.
      334   END PROCEDURE.
      335   PROCEDURE adm-enable-fields :
      336       RETURN.
      337   END PROCEDURE.
      338   PROCEDURE adm-end-update :
      339     RETURN.
      340   END PROCEDURE.
      341   PROCEDURE adm-reset-record :
      342       RETURN.
      343   END PROCEDURE.
      344   PROCEDURE adm-update-record :
      345       MESSAGE
      346         "Object ":U THIS-PROCEDURE:FILE-NAME
      347           "must have at least one Enabled Table to perform Update.":U
      348             VIEW-AS ALERT-BOX ERROR.
      349      RETURN.
      350   END PROCEDURE.
      351   PROCEDURE check-modified :
      352   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      353   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      354   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      355   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      356     IF check-state = "check":U THEN
      357     DO:
      358       RUN get-link-handle IN adm-broker-hdl
      359         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      360            OUTPUT group-target-list).
      361       IF group-target-list NE "":U THEN
      362       DO i = 1 TO NUM-ENTRIES(group-target-list):
      363         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      364         RUN check-modified IN curr-widget ('group-check':U).
      365         IF RETURN-VALUE NE "":U THEN
      366         DO:
      367           RUN check-modified-message(RETURN-VALUE).
      368           RETURN "":U.
      369         END.
      370       END.
      371     END.
      372     RETURN "":U.
      373   END PROCEDURE.
      374   PROCEDURE check-modified-message :
      375     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      376        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      377           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      378        IF RETURN-VALUE = "YES":U THEN
      379           RUN notify ('view,CONTAINER-SOURCE':U).
      380        MESSAGE IF p-changed-table NE ? THEN
      381           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      382           ELSE "Current values have been changed."
      383           SKIP "  Do you wish to save those changes?"
      384           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      385        IF ANS THEN
      386        DO:
      387           IF group-assign-target THEN
      388             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      389           ELSE RUN dispatch('update-record':U).
      390           IF RETURN-VALUE = "ADM-ERROR":U THEN
      391           DO:
      392               MESSAGE "Changes to the previous record were not saved."
      393                 VIEW-AS ALERT-BOX ERROR.
      394               IF group-assign-target THEN
      395                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      396               ELSE RUN dispatch ('cancel-record':U).
      397           END.
      398        END.
      399        ELSE DO:
      400          IF group-assign-target THEN
      401             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      402          ELSE RUN dispatch('cancel-record':U).
      403        END.
      404        RETURN.
      405   END PROCEDURE.
      406   PROCEDURE get-rowid :
      407       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      408       ASSIGN
      409       p-table   =   adm-first-table.
      410       RETURN.
      411   END PROCEDURE.
      412   PROCEDURE init-group-assign :
      413       RUN request-attribute IN adm-broker-hdl
      414         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      415       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      416         group-assign-target = yes.
      417       ELSE group-assign-target = no.
      418       RETURN.
      419   END PROCEDURE.
      420   PROCEDURE set-editors :
      421       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      422       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      423       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      424       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      425       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      426       DO WHILE VALID-HANDLE (curr-widget):
      427           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      428              curr-widget:HIDDEN = no THEN DO:
      429             CASE p-field-setting:
      430               WHEN "INITIALIZE":U THEN
      431               DO:
      432                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      433                     read-only-list +
      434                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      435                        STRING(curr-widget).
      436               END.
      437               WHEN "DISABLE":U OR
      438               WHEN "ENABLE":U THEN
      439               DO:
      440                   curr-widget:SENSITIVE = yes.
      441                   RUN get-attribute ('Read-Only-Editors':U).
      442                   IF RETURN-VALUE = ? OR
      443                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      444                       curr-widget:READ-ONLY =
      445                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      446               END.
      447               WHEN "CLEAR":U THEN
      448                   curr-widget:SCREEN-VALUE = "":U.
      449             END CASE.
      450           END.
      451           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      452       END.
      453       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      454         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      455           + '"':U).
      456       RETURN.
      457   END PROCEDURE.
      458   PROCEDURE use-check-modified-all :
      459    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      460     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      461     RETURN.
      462   END PROCEDURE.
      463   PROCEDURE use-create-on-add :
      464   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      465      RETURN.
      466   END PROCEDURE.
      467   PROCEDURE use-initial-lock :
      468     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      469     ASSIGN adm-initial-lock = p-attr-value.
      470     RETURN.
      471   END PROCEDURE.
      472   PROCEDURE adm-display-fields :
      473         IF AVAILABLE trn-doc THEN
      474             DISPLAY trn-doc.doc-code trn-doc.doc-type trn-doc.flag_ trn-doc.status_ trn-doc.doc-date trn-doc.fact-date trn-doc.obj-code trn-doc.obj-type trn-doc.cli-code trn-doc.cli-name trn-doc.cli-type WITH BROWSE br_table
      475               NO-ERROR.
      476         DISPLAY UNLESS-HIDDEN vardoc-code
      477             WITH FRAME F-Main NO-ERROR.
      478       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      479       RETURN.
      480   END PROCEDURE.
      481   PROCEDURE adm-open-query :
      482               RUN dispatch ('open-query-cases':U).
      483           adm-query-opened = yes.
      484           IF NUM-RESULTS("br_table":U) = 0 THEN
      485               RUN new-state ('no-record-available,SELF':U).
      486           ELSE DO:
      487               RUN new-state ('record-available,SELF':U).
      488               RUN new-state ('first-record,SELF':U).
      489           END.
      490           IF NOT adm-updating-record THEN
      491               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      492     RETURN.
      493   END PROCEDURE.
      494   PROCEDURE adm-row-changed :
      495         IF VALID-HANDLE(adm-object-hdl) THEN
      496           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      497         RUN notify ('row-available':U).
      498         RETURN.
      499   END PROCEDURE.
      500   PROCEDURE reposition-query :
      501       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      502       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      503       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      504       IF table-name <> ? THEN
      505           REPOSITION br_table TO ROWID table-name NO-ERROR.
      506       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      507       RETURN.
      508   END PROCEDURE.
      509     adm-sts = br_table:SET-REPOSITIONED-ROW
      510       (br_table:DOWN,"CONDITIONAL":U).
      511     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      512   PROCEDURE set-size :
      513     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      514     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      515     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      516     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      517     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      518     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      519     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      520     ASSIGN pd_height = MAX(pd_height, 2.0)
      521            pd_width  = MAX(pd_width, 2.0)
      522            hBrowse     = br_table:HANDLE IN FRAME F-Main
      523            hFieldGroup = hBrowse:PARENT
      524            htmpWidget  = hFieldGroup:FIRST-CHILD
      525            hFrame      = hFieldGroup:PARENT.
      526     Search-For-Siblings:
      527     REPEAT WHILE VALID-HANDLE(htmpWidget):
      528       IF htmpWidget NE hBrowse THEN DO:
      529         IF htmpWidget:TYPE NE "BUTTON" OR
      530            htmpWidget:X    NE 4 OR
      531            htmpWidget:Y    NE 4 THEN DO:
      532           RETURN.
      533         END.
      534       END.
      535       htmpWidget = htmpWidget:NEXT-SIBLING.
      536     END.
      537     IF pd_width < hBrowse:WIDTH THEN
      538       ASSIGN hBrowse:WIDTH = pd_width
      539              hFrame:WIDTH  = pd_width     NO-ERROR.
      540     ELSE
      541       ASSIGN hFrame:WIDTH  = pd_width
      542              hBrowse:WIDTH = pd_width     NO-ERROR.
      543     IF pd_height < hBrowse:HEIGHT THEN
      544       ASSIGN hBrowse:HEIGHT = pd_height
      545              hFrame:HEIGHT  = pd_height     NO-ERROR.
      546     ELSE
      547       ASSIGN hFrame:HEIGHT  = pd_height
      548              hBrowse:HEIGHT = pd_height     NO-ERROR.
      549   END PROCEDURE.
      550   ASSIGN
      551          FRAME F-Main:SCROLLABLE       = FALSE
      552          FRAME F-Main:HIDDEN           = TRUE.
      553   ON ROW-ENTRY OF br_table IN FRAME F-Main
      554   DO:
      555   END.
      556   ON ROW-LEAVE OF br_table IN FRAME F-Main
      557   DO:
      558   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      559   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      560   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      561     widget-enter = last-event:widget-enter.
      562     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      563     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      564       THEN widget-frame = widget-enter:FRAME.
      565     IF ((NOT VALID-HANDLE(widget-enter)) OR
      566         (widget-parent:TYPE = "BROWSE":U) OR
      567         (NOT VALID-HANDLE(widget-frame)) OR
      568         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      569     THEN DO:
      570         IF adm-brs-in-update THEN
      571         DO:
      572           MESSAGE
      573           "You must complete or cancel the update before leaving the current row."
      574               VIEW-AS ALERT-BOX WARNING.
      575           RETURN NO-APPLY.
      576         END.
      577         IF br_table:CURRENT-ROW-MODIFIED  OR
      578           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      579         DO:
      580           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      581           THEN DO:
      582             MESSAGE
      583             "Current record has been changed. " SKIP
      584             "Do you wish to save those changes?"
      585               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      586             IF l-save THEN
      587             DO:
      588                RUN dispatch('update-record':U).
      589                IF RETURN-VALUE = "ADM-ERROR":U THEN
      590                    RETURN NO-APPLY.
      591             END.
      592             ELSE RUN dispatch ('cancel-record':U).
      593           END.
      594           ELSE DO:
      595             RUN dispatch('update-record':U).
      596             IF RETURN-VALUE = "ADM-ERROR":U THEN
      597                 RETURN NO-APPLY.
      598           END.
      599         END.
      600     END.
      601   END.
      602   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      603   DO:
      604   RUN get-attribute('ADM-NEW-RECORD':U).
      605   IF RETURN-VALUE NE "YES":U THEN
      606     RUN notify ('row-available':U).
      607   END.
      608   ON return OF vardoc-code IN FRAME F-Main
      609   DO:
      610     find trn-doc where trn-doc.doc-code = input frame F-Main vardoc-code no-lock no-error.
      611     if available trn-doc then do:
      612        reposition br_table to recid recid(trn-doc).
      613        apply "value-changed" to browse br_table.
      614     end.
      615     else message "Нет такого документа" view-as alert-box.
      616   END.
      617   if not this-procedure :persistent
      618   then do:
      619     message
      620       vss-workfile vss-revision vss-description skip
      621       "Ошибка при запуске процедуры" skip
      622       "Данную процедуру следует запускать только с параметром persistent" skip
      623       view-as alert-box error .
      624     undo, return error .
      625   end.
      626   PROCEDURE adm-open-query-cases :
      627     OPEN QUERY br_table FOR EACH trn-doc WHERE TRUE NO-LOCK     BY trn-doc.fact-num DESCENDING INDEXED-REPOSITION.
      628   END PROCEDURE.
      629   PROCEDURE adm-row-available :
      630     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      631     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      632     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      633     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      634     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      635     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      636     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      637     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      638     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      639     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      640     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      641     IF adm-updating-record THEN RETURN.
      642     RUN get-attribute ('FIELDS-ENABLED':U).
      643     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      644     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      645         OUTPUT link-handle) NO-ERROR.
      646     IF link-handle = "":U THEN
      647         RETURN.
      648     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      649     IF NUM-ENTRIES(link-handle) > 1 THEN
      650         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      651             "encountered more than one RECORD-SOURCE.":U SKIP
      652             "The first - ":U record-source-hdl:file-name " - will be used.":U
      653                VIEW-AS ALERT-BOX ERROR.
      654     RUN get-attribute ('Key-Name':U).
      655     key-name = RETURN-VALUE.
      656     IF key-name = "":U THEN key-name = ?.
      657     IF key-name NE ? THEN DO:
      658       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      659         NO-ERROR.
      660       IF key-value NE ? THEN
      661         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      662     END.
      663   IF VALID-HANDLE (adm-object-hdl) THEN
      664       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      665     IF key-name ne ? OR different-row
      666     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      667     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
      668   END PROCEDURE.
      669   PROCEDURE disable_UI :
      670     HIDE FRAME F-Main.
      671     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      672   END PROCEDURE.
      673   PROCEDURE send-key :
      674     DEFINE INPUT  PARAMETER pc_key-name   AS CHARACTER NO-UNDO.
      675     DEFINE OUTPUT PARAMETER pc_key-value  AS CHARACTER NO-UNDO INITIAL ?.
      676     CASE pc_key-name:
      677       WHEN "obj-code" THEN
      678         pc_key-value = IF AVAILABLE trn-doc THEN STRING(trn-doc.obj-code) ELSE ?.
      679       WHEN "doc-code" THEN
      680         pc_key-value = IF AVAILABLE trn-doc THEN STRING(trn-doc.doc-code) ELSE ?.
      681       WHEN "host-code" THEN
      682         pc_key-value = IF AVAILABLE trn-doc THEN STRING(trn-doc.host-code) ELSE ?.
      683         WHEN "":U THEN .
      684         OTHERWISE MESSAGE "Entry ":U pc_key-name
      685                           " was not found in the send-key cases in ":U
      686                           THIS-PROCEDURE:FILE-NAME
      687                         VIEW-AS ALERT-BOX ERROR.
      688     END CASE.
      689   END PROCEDURE.
      690   PROCEDURE send-records :
      691     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
      692     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
      693     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
      694     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
      695     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
      696     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
      697         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
      698         CASE ENTRY(i, p-tbl-list):
      699       WHEN "trn-doc":U THEN p-rowid-list = p-rowid-list +
      700           IF AVAILABLE trn-doc THEN STRING(ROWID(trn-doc))
      701           ELSE "?":U.
      702           OTHERWISE
      703           DO:
      704               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      705                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
      706               IF link-handle NE "":U THEN
      707               DO:
      708                   IF NUM-ENTRIES(link-handle) > 1 THEN
      709                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
      710                               "encountered more than one RECORD-SOURCE.":U SKIP
      711                               "The first will be used.":U
      712                               VIEW-AS ALERT-BOX ERROR.
      713                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
      714                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
      715                   p-rowid-list = p-rowid-list + rowid-string.
      716               END.
      717               ELSE
      718               DO:
      719                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
      720                           "does not match tables in send-records":U
      721                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
      722                           "Check that objects are linked properly and that":U
      723                           "database qualification is consistent.":U
      724                       VIEW-AS ALERT-BOX ERROR.
      725                   RETURN ERROR.
      726               END.
      727           END.
      728           END CASE.
      729       END.
      730   END PROCEDURE.
      731   PROCEDURE state-changed :
      732     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      733     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      734     CASE p-state:
      735       WHEN "update-begin":U THEN
      736       DO:
      737           adm-brs-in-update = yes.
      738           RUN dispatch ('enable-fields':U).
      739           IF RETURN-VALUE = "ADM-ERROR":U THEN
      740           DO:
      741             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      742             RUN new-state('update-complete':U).
      743           END.
      744           ELSE DO:
      745             RUN dispatch ('apply-entry':U).
      746             RUN new-state('update':U).
      747           END.
      748       END.
      749       WHEN "update":U THEN
      750         DO:
      751           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
      752           RUN get-link-handle IN adm-broker-hdl
      753               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
      754                   NO-ERROR.
      755           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
      756             br_table:SENSITIVE IN FRAME F-Main = no.
      757         END.
      758       WHEN "update-complete":U THEN DO:
      759           br_table:SENSITIVE IN FRAME F-Main = yes.
      760           adm-brs-in-update = no.
      761           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
      762           IF RETURN-VALUE NE "YES":U THEN
      763           DO:
      764             IF NUM-RESULTS("br_table":U) NE ? AND
      765                NUM-RESULTS("br_table":U) NE 0
      766             THEN DO:
      767               GET CURRENT br_table.
      768               RUN dispatch ('row-changed':U).
      769             END.
      770           END.
      771           RUN new-state ('update-complete':U).
      772       END.
      773       WHEN "delete-complete":U THEN DO:
      774          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
      775          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
      776          IF NUM-RESULTS("br_table":U) = 0 THEN
      777            RUN notify('row-available':U).
      778       END.
      779       WHEN   'first-record':U        OR
      780         WHEN 'last-record':U         OR
      781         WHEN 'only-record':U         OR
      782         WHEN 'not-first-or-last':U   OR
      783         WHEN 'no-record-available':U OR
      784         WHEN 'no-external-record-available':U THEN
      785           RUN set-attribute-list('Query-Position=':U + p-state).
      786     END CASE.
      787   END PROCEDURE.
