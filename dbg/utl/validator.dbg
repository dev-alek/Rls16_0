        1   using utl.*.
        2   block-level on error undo, throw.
        3   class utl.validator:
        4      method public void Validate(iPwd as class tech-prol-pwd ):
        5         if iPwd:f-date = ? then
        6            undo, throw new ValidateError("Не заполнена дата").
        7         if iPwd:f-time = ? then
        8            undo, throw new ValidateError("Не заполнено время").
        9         if not
       10   (iPwd:f-host <> ? and iPwd:f-host <> "")
       11     then
       12            undo, throw new ValidateError("Не заполнен хост").
       13         if not
       14   (iPwd:f-user <> ? and iPwd:f-user <> "")
       15     then
       16            undo, throw new ValidateError("Не заполнен пользователь").
       17         if not
       18   (iPwd:shop-surr <> ? and iPwd:shop-surr <> "")
       19     then
       20            undo, throw new ValidateError("Не указан магазин").
       21         if not
       22   (iPwd:cash-desk-surr <> ? and iPwd:cash-desk-surr <> "")
       23     then
       24            undo, throw new ValidateError("Не указана касса").
       25         if not can-do("И,Р",iPwd:f-pwd-type) then
       26            undo, throw new ValidateError(substitute("Неправильный тип пароля - []",iPwd:f-pwd-type)).
       27         return.
       28      end method.
       29   end class.
